#{[{:activity/course {:db/id #edb/ref 17592186046669} :activity/first-step {:db/id #edb/ref 17592186558649} :activity/id #uuid "098d9a63-ea28-5f85-a2ce-c0960fd5ddad" :activity/scope {:db/id #edb/ref 17592186048786 :topic/id #uuid "bea5c820-dd0e-5c3b-936d-578694b34907" :topic/math-academy-id 4171} :activity/steps [{:db/id #edb/ref 17592186558613 :step/content {:db/id #edb/ref 17592186281599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12776ee4-bf66-52be-b94e-6da855692143" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186278760} {:answer/id #uuid "2992873e-5c72-56af-9b65-d007f9624836" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186278958} {:answer/id #uuid "3d837bf8-64a8-5ba8-b11f-d1e54f4538d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186279133} {:answer/id #uuid "b756c24d-21f1-5fd7-825b-a181399c4bcd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186280201} {:answer/id #uuid "d732b216-6686-5d3d-b266-b392c5e5f514" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186280493}] :answer-field/correct {:db/id #edb/ref 17592186280201} :answer-field/id #uuid "9241f691-955a-5b21-a8a2-fb377b58fa65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281096}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f950d98b-8d67-594b-b76b-e7454ed0e566" :question/math-academy-id "q-163095" :question/problem "For the function of two variables \n$f(x,y)={e}^{{x}^{2}+{y}^{2}},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=a+b{x}^{2}+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =2x{e}^{{x}^{2}+{y}^{2}}, & \\,{f}_{y}(x,y) & =2y{e}^{{x}^{2}+{y}^{2}} \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =2(1+2{x}^{2}){e}^{{x}^{2}+{y}^{2}}, & \\,{f}_{xx}(0,0) & =2 \\\\ {f}_{xy}(x,y) & =4xy{e}^{{x}^{2}+{y}^{2}}, & \\,{f}_{xy}(0,0) & =0 \\\\ {f}_{yy}(x,y) & =2(1+2{y}^{2}){e}^{{x}^{2}+{y}^{2}}, & \\,{f}_{yy}(0,0) & =2\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+0\\cdot x+0\\cdot y+\\frac{1}{2}(2\\cdot {x}^{2}+2(0)\\cdot xy+2\\cdot {y}^{2}) \\\\  & =1+1{x}^{2}+1{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1+1+1=3.\n$$"} :step/id #uuid "3a11e84f-b2e6-5b96-aebc-d33a601e7124" :step/next {:db/id #edb/ref 17592186558674}} {:db/id #edb/ref 17592186558643 :step/content {:db/id #edb/ref 17592186281594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c1228e-2050-56a2-b557-e042a94e13ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186278617} {:answer/id #uuid "65bcf28f-9665-53c8-ad9d-52494b8f71a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186279517} {:answer/id #uuid "867433f2-e62a-5149-8f65-89ea1338e1a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186279791} {:answer/id #uuid "b0ef3ec5-904b-5bac-aaf1-4b133a5204b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186280159} {:answer/id #uuid "f8c774d0-0b8d-5b1a-aac1-8ea3a6aa6f9a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186280777}] :answer-field/correct {:db/id #edb/ref 17592186279791} :answer-field/id #uuid "2b371790-c15b-5ab7-8f10-3eae5d762331" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280912}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "40019177-315b-5f8c-afeb-29b9f1c22ad3" :question/math-academy-id "q-163088" :question/problem "For the function of two variables \n$f(x,y)={e}^{xy},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=a+bxy.\n$$\n\nFind the value of $a+b.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =y{e}^{xy}, & \\,{f}_{y}(x,y) & =x{e}^{xy} \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & ={y}^{2}{e}^{xy}, & \\,{f}_{xx}(0,0) & =0 \\\\ {f}_{xy}(x,y) & =(1+xy){e}^{xy}, & \\,{f}_{xy}(0,0) & =1 \\\\ {f}_{yy}(x,y) & ={x}^{2}{e}^{xy}, & \\,{f}_{yy}(0,0) & =0\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+0\\cdot x+0\\cdot y+\\frac{1}{2}(0\\cdot {x}^{2}+2(1)\\cdot xy+0\\cdot {y}^{2}) \\\\  & =1+1xy.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=1+1=2.\n$$"} :step/id #uuid "73dacf11-d610-510f-9f2a-ac96a061e45f" :step/next {:db/id #edb/ref 17592186558613}} {:db/id #edb/ref 17592186558649 :step/content {:db/id #edb/ref 17592186198645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e54e1c9-205f-5069-a26e-144f61699b11" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186278873} {:answer/id #uuid "53a1bca1-f8d6-5bc4-914c-05bf62ee4e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186279353} {:answer/id #uuid "5ae60956-68d4-52a5-a560-be8be1ee1d39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186279431} {:answer/id #uuid "ea4c4625-0875-5288-88dc-8eec11112601" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-8" :db/id #edb/ref 17592186280648} {:answer/id #uuid "fd2d11b4-8aaf-5097-aa76-39368cc3df6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186280808}] :answer-field/correct {:db/id #edb/ref 17592186278873} :answer-field/id #uuid "b152db49-e069-50cf-bae6-a47ce8602ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281146}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a23d317-8ce9-5c6e-8d7d-b18f5386617b" :question/math-academy-id "q-162992" :question/problem "For the function of two variables \n$f(x,y)={e}^{x-2y},$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+x+a\\,y+\\frac{1}{2}{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & ={e}^{x-2y}, & \\,{f}_{y}(x,y) & =-2{e}^{x-2y} \\\\ {f}_{x}(0,0) & =1, & \\,{f}_{y}(0,0) & =-2\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & ={e}^{x-2y}, & \\,{f}_{xx}(0,0) & =1 \\\\ {f}_{xy}(x,y) & =-2{e}^{x-2y}, & \\,{f}_{xy}(0,0) & =-2 \\\\ {f}_{yy}(x,y) & =4{e}^{x-2y}, & \\,{f}_{yy}(0,0) & =4\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+1\\cdot x+(-2)\\cdot y+\\frac{1}{2}(1\\cdot {x}^{2}+2(-2)\\cdot xy+4\\cdot {y}^{2}) \\\\  & =1+x+(-2)y+\\frac{1}{2}{x}^{2}+(-2)xy+2{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=(-2)+(-2)+2=-2.\n$$"} :step/id #uuid "7de9f41d-a324-5443-81f5-c5e92f51bfc5" :step/next {:db/id #edb/ref 17592186558643}} {:db/id #edb/ref 17592186558670 :step/content {:db/id #edb/ref 17592186198655 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02574b50-c710-5a8f-8229-9eaa00044a04" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186278603} {:answer/id #uuid "10420ffa-1165-5942-a0ff-b3580c576eab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186278737} {:answer/id #uuid "3c91efce-0927-5416-b18a-4ba2ceaf7a3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186279126} {:answer/id #uuid "908df91a-4453-5800-be38-08e07668caab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186279879} {:answer/id #uuid "e37ae8eb-1e3b-558b-bcf1-ab48ef85e453" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280599}] :answer-field/correct {:db/id #edb/ref 17592186279879} :answer-field/id #uuid "71592c6a-fdb5-5942-ae34-39eaef90dabf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6e6d1ba4-7501-5c84-a8cd-0bbe2d40c544" :question/math-academy-id "q-163113" :question/problem "For the function of two variables \n$f(x,y)=\\operatorname{cos}⁡(x-2y),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=1+a{x}^{2}+bxy+c{y}^{2}.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =-\\operatorname{sin}⁡(x-2y), & \\,{f}_{y}(x,y) & =2\\operatorname{sin}⁡(x-2y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-\\operatorname{cos}⁡(x-2y), & \\,{f}_{xx}(0,0) & =-1 \\\\ {f}_{xy}(x,y) & =2\\operatorname{cos}⁡(x-2y), & \\,{f}_{xy}(0,0) & =2 \\\\ {f}_{yy}(x,y) & =-4\\operatorname{cos}⁡(x-2y), & \\,{f}_{yy}(0,0) & =-4\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈1+0\\cdot x+0\\cdot y+\\frac{1}{2}(-1\\cdot {x}^{2}+2(2)\\cdot xy+(-4)\\cdot {y}^{2}) \\\\  & =1+(-\\frac{1}{2}){x}^{2}+2xy+(-2){y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=(-\\frac{1}{2})+2+(-2)=-\\frac{1}{2}.\n$$"} :step/id #uuid "a43c867a-54d3-5da5-aa81-a0fc72465bfa"} {:db/id #edb/ref 17592186558674 :step/content {:db/id #edb/ref 17592186558485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56d62606-600b-56ec-a3fd-a47d37a5ff2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186558030} {:answer/id #uuid "6e8b2bf8-b3b8-512a-a46d-88c0558b5fd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186558086} {:answer/id #uuid "70c7791e-868a-52d8-ae41-1d3e92d6e599" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186558089} {:answer/id #uuid "ad64393f-6d2d-5220-9e5f-52726b3743a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186558210} {:answer/id #uuid "d7f6dbe2-f389-5865-a28c-083f626a394d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186558292}] :answer-field/correct {:db/id #edb/ref 17592186558089} :answer-field/id #uuid "9e40607e-9b99-5e38-8f0d-dd955650b71c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186558437}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0ce9fe2d-58e8-5131-a802-985ae9f0bd60" :question/math-academy-id "q-163103" :question/problem "For the function of two variables \n$f(x,y)=y\\operatorname{sin}⁡(x+y),$\nthe quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\nf(x,y)=axy+b{y}^{2}.\n$$\n\nFind the value of $a+b.$" :question/worked-solution "If the function $f(x,y)$ is twice differentiable at $(x,y)=(0,0),$ then the quadratic Taylor polynomial of $f$ about $(0,0)$ is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈\\overset{\\text{Linear approximation}}{\\overset{⏞}{f(0,0)+{f}_{x}(0,0)\\cdot x+{f}_{y}(0,0)\\cdot y}} \\\\  & \\,\\,+{{\\frac{1}{2}({f}_{xx}(0,0)\\cdot {x}^{2}+2{f}_{xy}(0,0)\\cdot xy+{f}_{yy}(0,0)\\cdot {y}^{2})}_{⏟}}_{\\text{Quadratic part}}.\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial.\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =0.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =y\\operatorname{cos}⁡(x+y), & \\,{f}_{y}(x,y) & =\\operatorname{sin}⁡(x+y)+y\\operatorname{cos}⁡(x+y) \\\\ {f}_{x}(0,0) & =0, & \\,{f}_{y}(0,0) & =0\\end{aligned}\n$$\n\n- Calculating the second derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =-y\\operatorname{sin}⁡(x+y), & \\,{f}_{xx}(0,0) & =0 \\\\ {f}_{xy}(x,y) & =\\operatorname{cos}⁡(x+y)-y\\operatorname{sin}⁡(x+y), & \\,{f}_{xy}(0,0) & =1 \\\\ {f}_{yy}(x,y) & =2\\operatorname{cos}⁡(x+y)-y\\operatorname{sin}⁡(x+y), & \\,{f}_{yy}(0,0) & =2\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\n\\begin{aligned}f(x,y) & ≈0+0\\cdot x+0\\cdot y+\\frac{1}{2}(0\\cdot {x}^{2}+2(1)\\cdot xy+2\\cdot {y}^{2}) \\\\  & =1xy+1{y}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=1+1=2.\n$$"} :step/id #uuid "ade9a65c-1253-5204-b397-d6b1e27859d0" :step/next {:db/id #edb/ref 17592186558670}}] :activity/title "Second-Degree Taylor Polynomials of Multivariable Functions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186557851}]}
