name{sin}⁡\\theta $ gives a circle of radius $|\\frac{1}{2}|=0.5$ centered at the point $(0,0.5),$ as shown below.\n\n![](images/c4/c41b20869064a366a1b62d6189d87c540e96196891a8abe1cf9b5c240b52a881.png)"}] [{:db/id #edb/ref 17592186543589 :knowledge-point/_questions [{:db/id #edb/ref 17592186105758 :knowledge-point/id #uuid "92b54d77-fce2-53bf-aaad-4c7db8285162" :knowledge-point/title "The Polar Equation of a Circle Centered on the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09435bec-5f11-5b98-a734-568c384865a4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fd8d1cd66e266b310649b350f5017c74045c97ab75cadfc890b629fbcdf7e978.png" :db/id #edb/ref 17592186542657} {:answer/id #uuid "4076ef1c-0960-5e2a-82ad-b8260c11e092" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/4101bb57e9f233e2e6675f95aef74c93202461cefce1a2ad3c3684f5d8cb7bfb.png" :db/id #edb/ref 17592186542813} {:answer/id #uuid "719615fc-9a82-5a68-8f07-ff9af320fdc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ea1e0a1a8023bf55dd10b87f5651a805ebf4dd66a23c0542cf4dff57b43b81a9.png" :db/id #edb/ref 17592186542939} {:answer/id #uuid "baac2ba2-abd8-565d-923d-53fe1512e71f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/53/534913669f13cf39b6dc36dfdb33b66908c7c42b7fe2f8349436d20a93a6ea12.png" :db/id #edb/ref 17592186543130} {:answer/id #uuid "efc2f225-0f75-5fbb-9565-6217ec443fca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0abd4d70dc13f28e6d6dee7be12eb8bef82d1449e0cd6ed9886d8f6de17ff7bc.png" :db/id #edb/ref 17592186543252}] :answer-field/correct {:answer/id #uuid "4076ef1c-0960-5e2a-82ad-b8260c11e092" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/41/4101bb57e9f233e2e6675f95aef74c9