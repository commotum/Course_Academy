      "raw_html": "<div class=\"question\" id=\"question-17277\"><div class=\"questionHeader\"><span class=\"questionNumber\">12.</span><span class=\"helpButton\" questionid=\"17277\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-17277\"/></div><div class=\"questionText\"><p>What is the polar equation of the curve shown above?</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Thu, Oct 15th @ 12:22 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:18</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
