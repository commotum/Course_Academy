te(2022,0)\">\n <use xlink:href=\"#E10-MJMAIN-63\"></use>\n <use xlink:href=\"#E10-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n</g>\n<g transform=\"translate(3361,0)\">\n <use xlink:href=\"#E10-MJSZ3-28\"></use>\n<g transform=\"translate(736,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1194\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,676)\">\n <use xlink:href=\"#E10-MJMAIN-33\" x=\"0\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-3C0\" x=\"500\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E10-MJMAIN-34\" x=\"346\" y=\"-698\"></use>\n</g>\n</g>\n <use xlink:href=\"#E10-MJSZ3-29\" x=\"2170\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-1732)\">\n <use xlink:href=\"#E10-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMATHI-6B\" x=\"1334\" y=\"0\"></use>\n<g transform=\"translate(2022,0)\">\n <use xlink:href=\"#E10-MJSZ3-28\"></use>\n <use xlink:href=\"#E10-MJMAIN-2212\" x=\"736\" y=\"0\"></use>\n<g transform=\"translate(1515,0)\">\n<g transform=\"translate(120,0)\">\n<rect stroke=\"none\" width=\"1454\" height=\"60\" x=\"0\" y=\"220\"></rect>\n<g transform=\"translate(60,681)\">\n <use xlink:href=\"#E10-MJMAIN-221A\" x=\"0\" y=\"39\"></use>\n<rect stroke=\"none\" width=\"500\" height=\"60\" x=\"833\" y=\"780\"></rect>\n <use xlink:href=\"#E10-MJMAIN-32\" x=\"833\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E10-MJMAIN-32\" x=\"476\" y=\"-687\"></use>\n</g>\n</g>\n <use xlink:href=\"#E10-MJSZ3-29\" x=\"3209\" y=\"-1\"></use>\n</g>\n</g>\n<g transform=\"translate(0,-4282)\">\n <use xlink:href=\"#E10-MJMAIN-3D\" x=\"277\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-2212\" x=\"1334\" y=\"0\"></use>\n <use xlink:href=\"#E10-MJMAIN-37\" x=\"2112\" y=\"0\"></use>\n</g>\n</g>\n</g>\n</g>\n</svg></span></p>\n<p>Therefore, the equation of the curve is <span class=\"mjpage\"><svg xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"12.74ex\" height=\"2.509ex\" style=\"vertical-align: -0.671ex;\" viewBox=\"0 -791.3 5485.4 1080.4\" role=\"img\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\" aria-labelledby=\"MathJax-SVG-11-Title\">\n<title id=\"MathJax-SVG-11-Title\">r=-7\\cos\\theta,</title>\n<defs aria-hidden=\"true\">\n<path stroke-width=\"1\" id=\"E11-MJMATHI-72\" d=\"M21 287Q22 290 23 295T28 317T38 348T53 381T73 411T99 433T132 442Q161 442 183 430T214 408T225 388Q227 382 228 382T236 389Q284 441 347 441H350Q398 441 422 400Q430 381 430 363Q430 333 417 315T391 292T366 288Q346 288 334 299T322 328Q322 376 378 392Q356 405 342 405Q286 405 239 331Q229 315 224 298T190 165Q156 25 151 16Q138 -11 108 -11Q95 -11 87 -5T76 7T74 17Q74 30 114 189T154 366Q154 405 128 405Q107 405 92 377T68 316T57 280Q55 278 41 278H27Q21 284 21 287Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-3D\" d=\"M56 347Q56 360 70 367H707Q722 359 722 347Q722 336 708 328L390 327H72Q56 332 56 347ZM56 153Q56 168 72 173H708Q722 163 722 153Q722 140 707 133H70Q56 140 56 153Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-2212\" d=\"M84 237T84 250T98 270H679Q694 262 694 250T679 230H98Q84 237 84 250Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-37\" d=\"M55 458Q56 460 72 567L88 674Q88 676 108 676H128V672Q128 662 143 655T195 646T364 644H485V605L417 512Q408 500 387 472T360 435T339 403T319 367T305 330T292 284T284 230T278 162T275 80Q275 66 275 52T274 28V19Q270 2 255 -10T221 -22Q210 -22 200 -19T179 0T168 40Q168 198 265 368Q285 400 349 489L395 552H302Q128 552 119 546Q113 543 108 522T98 479L95 458V455H55V458Z\"></path>\n<path stroke-width=\"1\" id=\"E11-MJMAIN-63\" d=\"M370 305T349 305T313 320T297 358Q297 381 312 396Q317 401 317 402T307 404Q281 408 258 408Q209 408 178 376Q131 329 131 219Q131 137 162 90Q203 29 272 29Q313 29 338 55T374 117Q376 125 379 127T395 129H409Q415 123 415 120Q415 116 411 104T395 71T366 33T318 2T249 -11Q163 -11 99 53T34 214Q34 318 99 383T250 448T370 421T404 357Q404 334 387 320Z\"></path>\n<path stroke-width=\"1\"