      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/observations/lesson-step-19880-e4db27c58818067f0812.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/observations/lesson-step-19880-e4db27c58818067f0812.png",
      "source_url": "https://mathacademy.com/topics/1270",
      "captured_at": 1792049277.2727263,
      "math_academy_id": 3510,
      "topic_id": "1270",
