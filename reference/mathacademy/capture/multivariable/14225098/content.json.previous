              "input_html": "<div id=\"freeResponseTextbox-1\" class=\"matheditor-wrapper-answer\" ;=\"\" style=\"min-width:80px;\n                                        margin-left:6px;\n                                        margin-right:1px;\n                                        background:;\"><div class=\"mq-editable-field mq-math-mode\" style=\"border: none; outline: none;\"><span class=\"mq-textarea\"><textarea autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\" x-palm-disable-ste-all=\"true\" style=\"\" disabled=\"\"></textarea></span><span class=\"mq-root-block\" mathquill-block-id=\"14\"><span mathquill-command-id=\"16\" class=\"\">−</span><span mathquill-command-id=\"18\">3</span><var mathquill-command-id=\"21\" class=\"mq-operator-name mq-first\">s</var><var mathquill-command-id=\"22\" class=\"mq-operator-name\">i</var><var mathquill-command-id=\"23\" class=\"mq-operator-name mq-last\">n</var><var mathquill-command-id=\"25\">θ</var></span></div></div>",
              "rendered_text": "−3sinθ",
