0Q113 0 96 17Z\" id=\"E8-MJMAIN-2C\" stroke-width=\"1\"></path>\n<path d=\"M96 585Q152 666 249 666Q297 666 345 640T423 548Q460 465 460 320Q460 165 417 83Q397 41 362 16T301 -15T250 -22Q224 -22 198 -16T137 16T82 83Q39 165 39 320Q39 494 96 585ZM321 597Q291 629 250 629Q208 629 178 597Q153 571 145 525T137 333Q137 175 145 125T181 46Q209 16 250 16Q290 16 318 46Q347 76 354 130T362 333Q362 478 354 524T321 597Z\" id=\"E8-MJMAIN-30\" stroke-width=\"1\"></path>\n<path d=\"M60 749L64 750Q69 750 74 750H86L114 726Q208 641 251 514T294 250Q294 182 284 119T261 12T224 -76T186 -143T145 -194T113 -227T90 -246Q87 -249 86 -250H74Q66 -250 63 -250T58 -247T55 -238Q56 -237 66 -225Q221 -64 221 250T66 725Q56 737 55 738Q55 746 60 749Z\" id=\"E8-MJMAIN-29\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E8-MJMAIN-28\" y=\"0\"></use>\n<use x=\"389\" xlink:href=\"#E8-MJMAIN-31\" y=\"0\"></use>\n<use x=\"890\" xlink:href=\"#E8-MJMAIN-2C\" y=\"0\"></use>\n<use x=\"1335\" xlink:href=\"#E8-MJMAIN-30\" y=\"0\"></use>\n<use x=\"1835\" xlink:href=\"#E8-MJMAIN-29\" y=\"0\"></use>\n<use x=\"2225\" xlink:href=\"#E8-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> as shown below.</p>\n<div class=\"graphic\" id=\"graphic-2e6df678ab94762c53cf7b08e8718c7a\"><img src=\"/graphics/2e6df678ab94762c53cf7b08e8718c7a\"/></div>\n</div>\n</div>"
