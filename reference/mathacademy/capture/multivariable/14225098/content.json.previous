      "sequence_position": 14,
      "difficulty": "easy",
      "grade": "Correct",
      "source_grade": "Correct",
      "raw_html": "<div class=\"question\" id=\"question-16470\"><div class=\"questionHeader\"><span class=\"questionNumber\">14.</span><span class=\"helpButton\" questionid=\"16470\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-16470\"/></div><div class=\"questionText\"><p>What is the polar equation of the curve shown above?</p>\n</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyEasy\">E</div><span class=\"answerCreated\">Thu, Oct 15th @ 12:23 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:18</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>",
      "answer_validation": {
        "status": "supported",
