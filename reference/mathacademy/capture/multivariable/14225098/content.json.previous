        "solution_evidence": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/observations/history-solution-q-281499-842c20f5baef1a5e9675.html",
        "difficulty": "moderate",
        "knowledge_point_source_id": null,
        "kp_href": "",
        "source_grade": "Correct",
        "raw_html": "<div class=\"question\" id=\"question-281499\"><div class=\"questionHeader\"><span class=\"questionNumber\">15.</span><span class=\"helpButton\" questionid=\"281499\">?</span></div><div class=\"questionGraphicFrame\"><img class=\"questionGraphic\" src=\"/graphics/q-281499\"/></div><div class=\"questionText\">The polar equation of the given curve is <mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"107\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo></math></mjx-assistive-mml></mjx-container><div ;=\"\" class=\"freeResponseTextbox\" id=\"freeResponseTextbox-1\" style=\"min-width:76px;\n                                        margin-left:6px;\n                                        margin-right:1px;\n                                        background:;\"><mjx-container class=\"MathJax CtxtMenu_Attached_0\" ctxtmenu_counter=\"108\" jax=\"CHTML\" style=\"font-size: 119.4%; position: relative;\" tabindex=\"0\"><mjx-math aria-hidden=\"true\" class=\"MJX-TEX\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn><mjx-mi class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c73\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2061\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml display=\"inline\" unselectable=\"on\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass=\"NONE\">⁡</mo><mi>θ</mi></math></mjx-assistive-mml></mjx-container></div>.</div><div class=\"answerDetails\"><div class=\"questionDifficulty difficultyModerate\">M</div><span class=\"answerCreated\">Thu, Oct 15th @ 12:24 AM</span><span class=\"answerDetailsSeparator\">|</span><span class=\"timeElpased\">Elapsed: 0:17</span><span class=\"answerResult\"><span style=\"color: green;\">Correct</span></span></div></div>"
      },
