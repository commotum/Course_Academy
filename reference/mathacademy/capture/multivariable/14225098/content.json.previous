      "solution": {
        "status": "ambiguous",
        "reasoning": "Multiplying r=k\\cos\\theta by r gives x^2+y^2=kx. Here x^2+y^2=81/4+27/4=27, so k=27/(-9/2)=-6, option e. No Math Academy answer or grade for the current question is captured.",
        "confidence": 1,
        "answers": [
          {
            "key": "selection",
            "correct_value": "-6",
            "correct_option": "e",
            "value_type": "math",
            "wrong_value": "-3",
            "correct_keys": [],
            "wrong_keys": [],
            "ma_value": null,
            "ma_basis": "none",
            "ma_evidence": "",
