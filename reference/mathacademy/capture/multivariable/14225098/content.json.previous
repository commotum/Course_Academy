      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/observations/step-t3509-9499da0c03ee5b6e3c4a.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/observations/step-t3509-9499da0c03ee5b6e3c4a.png",
