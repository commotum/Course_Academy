 414 128 401Q98 382 98 349Q97 344 98 336T114 312T157 287Q175 282 201 278T245 269T277 256Q294 248 310 236T342 195T359 133Q359 71 321 31T198 -10H190Q138 -10 94 26L86 19L77 10Q71 4 65 -1L54 -11H46H42Q39 -11 33 -5V74V132Q33 153 35 157T45 162H54Q66 162 70 158T75 146T82 119T101 77Q136 26 198 26Q295 26 295 104Q295 133 277 151Q257 175 194 187T111 210Q75 227 54 256T33 318Q33 357 50 384T93 424T143 442T187 447H198Q238 447 268 432L283 424L292 431Q302 440 314 448H322H326Q329 448 335 442V310L329 304H301Q295 310 295 316Z\" id=\"E11-MJMAIN-73\" stroke-width=\"1\"></path>\n<path d=\"M35 200Q35 302 74 415T180 610T319 704Q320 704 327 704T339 705Q393 701 423 656Q462 596 462 495Q462 380 417 261T302 66T168 -10H161Q125 -10 99 10T60 63T41 130T35 200ZM383 566Q383 668 330 668Q294 668 260 623T204 521T170 421T157 371Q206 370 254 370L351 371Q352 372 359 404T375 484T383 566ZM113 132Q113 26 166 26Q181 26 198 36T239 74T287 161T335 307L340 324H145Q145 321 136 286T120 208T113 132Z\" id=\"E11-MJMATHI-3B8\" stroke-width=\"1\"></path>\n<path d=\"M78 35T78 60T94 103T137 121Q165 121 187 96T210 8Q210 -27 201 -60T180 -117T154 -158T130 -185T117 -194Q113 -194 104 -185T95 -172Q95 -168 106 -156T131 -126T157 -76T173 -3V9L172 8Q170 7 167 6T161 3T152 1T140 0Q113 0 96 17Z\" id=\"E11-MJMAIN-2C\" stroke-width=\"1\"></path>\n</defs>\n<g aria-hidden=\"true\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0\" transform=\"matrix(1 0 0 -1 0 0)\">\n<use x=\"0\" xlink:href=\"#E11-MJMATHI-72\" y=\"0\"></use>\n<use x=\"729\" xlink:href=\"#E11-MJMAIN-3D\" y=\"0\"></use>\n<use x=\"1785\" xlink:href=\"#E11-MJMAIN-2212\" y=\"0\"></use>\n<use x=\"2564\" xlink:href=\"#E11-MJMAIN-37\" y=\"0\"></use>\n<g transform=\"translate(3231,0)\">\n<use xlink:href=\"#E11-MJMAIN-63\"></use>\n<use x=\"444\" xlink:href=\"#E11-MJMAIN-6F\" y=\"0\"></use>\n<use x=\"945\" xlink:href=\"#E11-MJMAIN-73\" y=\"0\"></use>\n</g>\n<use x=\"4737\" xlink:href=\"#E11-MJMATHI-3B8\" y=\"0\"></use>\n<use x=\"5206\" xlink:href=\"#E11-MJMAIN-2C\" y=\"0\"></use>\n</g>\n</svg></span> as shown below.</p>\n<div class=\"graphic\" id=\"graphic-99695ad164fced23c816d5d18f52c0c8\"><img src=\"/graphics/99695ad164fced23c816d5d18f52c0c8\"/></div>\n</div>\n</div>"
