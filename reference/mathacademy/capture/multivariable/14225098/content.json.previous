7\" x=\"2564\" y=\"0\"></use>\n<g transform=\"translate(3231,0)\">\n <use xlink:href=\"#E11-MJMAIN-63\"></use>\n <use xlink:href=\"#E11-MJMAIN-6F\" x=\"444\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-73\" x=\"945\" y=\"0\"></use>\n</g>\n <use xlink:href=\"#E11-MJMATHI-3B8\" x=\"4737\" y=\"0\"></use>\n <use xlink:href=\"#E11-MJMAIN-2C\" x=\"5206\" y=\"0\"></use>\n</g>\n</svg></span> as shown below.</p>\n<div id=\"graphic-99695ad164fced23c816d5d18f52c0c8\" class=\"graphic\"><img src=\"/graphics/99695ad164fced23c816d5d18f52c0c8\"></div>\n            </div>           \n        </div>",
