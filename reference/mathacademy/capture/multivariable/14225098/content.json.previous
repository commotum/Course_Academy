            "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14225098/assets/4632ae0baaced6ba3699fddf859b71226b5fcebe4700bbbdf4774d1d701e53ad.png",
            "sha256": "4632ae0baaced6ba3699fddf859b71226b5fcebe4700bbbdf4774d1d701e53ad",
            "content_type": "image/png",
