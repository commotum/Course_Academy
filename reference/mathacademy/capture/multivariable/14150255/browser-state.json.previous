w></msup></mtd><mtd><mi>t</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>t</mi></mrow></msup></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>t</mi></mrow></msup></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi></mi><mo>=</mo><mrow data-mjx-texclass=\"INNER\"><mo data-mjx-texclass=\"OPEN\">[</mo><mtable columnalign=\"center\" columnspacing=\"1em\" rowspacing=\"4pt\"><mtr><mtd><mn>5</mn><mi>t</mi><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>t</mi></mrow></msup></mtd></mtr><mtr><mtd><mn>5</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>8</mn><mi>t</mi></mrow></msup></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
