      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14150255/observations/step-q335269-65a34b1b76c6b0b87c6c.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14150255/observations/step-q335269-65a34b1b76c6b0b87c6c.png",
