\">(</mo><mo>−</mo><mn>2</mn><mi>t</mi><mo>−</mo><mn>6</mn><mo stretchy=\"false\">)</mo><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>7</mn><mo stretchy=\"false\">(</mo><mi>t</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></msup></mpadded></mstyle><mspace width=\"2pt\"></mspace></mtd></mtr><mtr><mtd><mspace width=\"2pt\"></mspace><mstyle style=\"border: solid 1pt lightgray\"><mpadded height=\"+4pt\" depth=\"+4pt\" lspace=\"4pt\" width=\"+8pt\"><mo>−</mo><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass=\"ORD\"><mn>7</mn><mo stretchy=\"false\">(</mo><mi>t</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></msup></mpadded></mstyle><mspace width=\"2pt\"></mspace></mtd></mtr></mtable><mo data-mjx-texclass=\"CLOSE\">]</mo></mrow><mo>.</mo></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n</div></div>",
