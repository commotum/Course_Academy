s}⁡(6t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"}] [{:db/id #edb/ref 17592186229677 :knowledge-point/_questions [{:db/id #edb/ref 17592186229142 :knowledge-point/id #uuid "e5bc609b-dc5b-52e9-9f0e-206f32bb829b" :knowledge-point/title "Finding the General Solution of a Homogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5392cdab-374c-5ae2-97a2-f4228e352881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186305962} {:answer/id #uuid "7a6f36b6-4121-5cab-9216-833c7c62083f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186306320} {:answer/id #uuid "d1e11b73-c7d1-59c9-abf2-19d051435206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]{e}^{-3t}" :db/id #edb/ref 17592186307100} {:answer/id #uuid "f3ca31cf-3864-5198-b515-c7ff18c474da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186307408} {:answer/id #uuid "f507092b-2755-5654-9fcc-edf25726ea51" :answer/type 