in}⁡(6t) & \\operatorname{cos}⁡(6t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -6 \\\\ 6 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"170px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186372701 :answer-field/correct "answer-fbe8a58e-1762-5927-ad7d-8c11b3a901ef" :answer-field/choices ["answer-fbe8a58e-1762-5927-ad7d-8c11b3a901ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-fbe8a58e-1762-5927-ad7d-8c11b3a901ef" :answer/id #uuid "fbe8a58e-1762-5927-ad7d-8c11b3a901ef" :answer/type :answer.type/math :answer/value "-2\\cos(6t)-3\\sin(6t)" :db/ensure [:answer/validate]} {:db/id 17592186372699 :answer-field/correct "answer-4dc4a82a-36ee-5426-99eb-e3ffcb7ab6b8" :answer-field/choices ["answer-4dc4a82a-36ee-5426-99eb-e3ffcb7ab6b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-4dc4a82a-36ee-5426-99eb-e3ffcb7ab6b8" :answer/id #uuid "4dc4a82a-36ee-5426-99eb-e3ffcb7ab6b8" :answer/type :answer.type/math :answer/value "-2\\sin(6t)+3\\cos(6t)" :db/ensure [:answer/validate]} {:db/id 17592186311563 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-5x(t)+y(t) \\\\ {y}^{′}(t)=-5y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}],$ where $A=[\\begin{aligned}-5 & 1 \\\\ 0 & -5\\end{aligned}].$*" :db/ensure [:question/validate]} {:db/id "question-32d4b06d-f6f3-5351-bf77-6d5871dae39c" :question/id #uuid "32d4b06d-f6f3-5351-bf77-6d5871dae39c" :question/math-academy-id "q-335272" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4x(t)+y(t) \\\\ {y}^{′}(t)=4y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 6\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}],$ where $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{4t} & t{e}^{4t} \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}0 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}6t{e}^{4t} \\\\ 6{e}^{4t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0dd78d2a-f5d6-5fd4-9c13-2afeb7726bac"] :db/ensure [:question/validate]} {:db/id "answer-field-0dd78d2a-f5d6-5fd4-9c13-2afeb7726bac" :answer-field/id #uuid "0dd78d2a-f5d6-5fd4-9c13-2afeb7726bac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d83c7199-3871-536a-9c4a-4a138d67aa0f" :answer-field/choices ["