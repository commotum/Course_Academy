#{[{:activity/expected-seconds 660.0 :activity/first-step {:db/id #edb/ref 17592186097649} :activity/id #uuid "4cd6220f-a1da-5c6a-a7a0-23660985536a" :activity/scope {:db/id #edb/ref 17592186048946 :topic/id #uuid "ce149b11-6082-5d50-b257-556e8d27a08c" :topic/math-academy-id 1040} :activity/steps [{:db/id #edb/ref 17592186097649 :step/content {:db/id #edb/ref 17592186097808 :tutorial/content "To calculate the area $A$ bounded by a curve $y=y(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b,$ as shown below, we compute the integral\n\n$$\nA = \\int_{a}^{b} y(x) \\:\\textrm{d}x.\n$$\n\n![](images/95/956691527ccecdd55ca4475553b5dedba6d10104196b86ae6f03c4b6eda1d6ad.png)" :tutorial/id #uuid "4b95d76b-7bbb-5e81-b038-04207903ffde" :tutorial/math-academy-id 1339 :tutorial/title "Introduction"} :step/id #uuid "5e4fbdf9-4b40-59b7-99a8-f322e11946dd" :step/math-academy-id 2672 :step/next {:db/id #edb/ref 17592186097650}} {:db/id #edb/ref 17592186097650 :step/content {:db/id #edb/ref 17592186096756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096581 :question/id #uuid "dc29cf6e-4f68-552e-ae7a-f9834eec1bd7" :question/math-academy-id "e-781"} :knowledge-point/id #uuid "96967f25-565a-5338-878e-00fd30055772" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049533} {:db/id #edb/ref 17592186050571} {:db/id #edb/ref 17592186050819}] :knowledge-point/questions [{:db/id #edb/ref 17592186096948} {:db/id #edb/ref 17592186097406} {:db/id #edb/ref 17592186247047} {:db/id #edb/ref 17592186247079} {:db/id #edb/ref 17592186247097} {:db/id #edb/ref 17592186297442} {:db/id #edb/ref 17592186319002} {:db/id #edb/ref 17592186319003} {:db/id #edb/ref 17592186319004} {:db/id #edb/ref 17592186319005} {:db/id #edb/ref 17592186332670} {:db/id #edb/ref 17592186332916} {:db/id #edb/ref 17592186332917} {:db/id #edb/ref 17592186362388}] :knowledge-point/title "Calculating the Area Bounded Below a Curve and Above the X-Axis"} :step/id #uuid "43eecc3f-a307-50fd-b1b4-8aa1dfcaac3c" :step/math-academy-id 2673 :step/next {:db/id #edb/ref 17592186097651}} {:db/id #edb/ref 17592186097651 :step/content {:db/id #edb/ref 17592186097809 :tutorial/content "When we compute the area under a curve using integration, we must bear the following in mind:\n\n- definite integrals that correspond to areas above the $x$-axis are positive, while\n\n- definite integrals that correspond to areas below the $x$-axis are negative.\n\n![](images/bb/bbaeff68bc8c25284349e36abcceb1afa0f289b2420754466d0434e7ee7427fd.png)\n\nLet's see an example where the area comes out to be negative." :tutorial/id #uuid "ff7fe805-0fce-58be-9b77-78adfa57263f" :tutorial/math-academy-id 1340 :tutorial/title "Signed Areas Bounded by a Curve and the x-Axis"} :step/id #uuid "cd3ff0d7-b27c-5c32-85fe-18b16c09bcd8" :step/math-academy-id 2677 :step/next {:db/id #edb/ref 17592186097652}} {:db/id #edb/ref 17592186097652 :step/content {:db/id #edb/ref 17592186096757 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096582 :question/id #uuid "5893a692-573a-5e1a-81aa-db34fa6059ed" :question/math-academy-id "e-782"} :knowledge-point/id #uuid "6ad216da-1bcf-5b87-9436-918ef1e5015a" :knowledge-point/questions [{:db/id #edb/ref 17592186097278} {:db/id #edb/ref 17592186097405} {:db/id #edb/ref 17592186238060} {:db/id #edb/ref 17592186247099} {:db/id #edb/ref 17592186297444} {:db/id #edb/ref 17592186297455} {:db/id #edb/ref 17592186319009} {:db/id #edb/ref 17592186319011} {:db/id #edb/ref 17592186319013} {:db/id #edb/ref 17592186326872} {:db/id #edb/ref 17592186332915} {:db/id #edb/ref 17592186341940} {:db/id #edb/ref 17592186341941} {:db/id #edb/ref 17592186341942} {:db/id #edb/ref 17592186341943} {:db/id #edb/ref 17592186379848} {:db/id #edb/ref 17592186382929}] :knowledge-point/title "Calculating the Area Bounded Above a Curve and Below the X-Axis"} :step/id #uuid "5e0d19a9-6d1c-5f39-b7b1-333c65eb1e17" :step/math-academy-id 2678}] :activity/title "The Area Bounded by a Curve and the X-Axis" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096848}] [{:activity/expected-seconds 1260.0 :activity/first-step {:db/id #edb/ref 17592186185006} :activity/id #uuid "af91633b-288c-52bd-a641-7172621608f6" :activity/scope {:db/id #edb/ref 17592186049327 :topic/id #uuid "ec1d59b5-66a8-5507-9862-10567e3ce6ab" :topic/math-academy-id 3834} :activity/steps [{:db/id #edb/ref 17592186184944 :step/content {:db/id #edb/ref 17592186184177 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184078 :question/id #uuid "7dbb258d-fe71-5e7b-9501-c88ffdb6fe86" :question/math-academy-id "e-629"} :knowledge-point/id #uuid "2216cdfc-7f2a-5c53-b10b-2d66f35fbf32" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050162} {:db/id #edb/ref 17592186050277}] :knowledge-point/questions [{:db/id #edb/ref 17592186184535} {:db/id #edb/ref 17592186184796} {:db/id #edb/ref 17592186527917} {:db/id #edb/ref 17592186542115} {:db/id #edb/ref 17592186542198} {:db/id #edb/ref 17592186542202} {:db/id #edb/ref 17592186542215} {:db/id #edb/ref 17592186542229}] :knowledge-point/title "Finding Tangent Lines to Polar Curves"} :step/id #uuid "a0ead2f8-7726-5a22-ad4d-582c7b4b8968" :step/math-academy-id 642669 :step/next {:db/id #edb/ref 17592186185001}} {:db/id #edb/ref 17592186185001 :step/content {:db/id #edb/ref 17592186184215 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184120 :question/id #uuid "59156f24-72a1-5642-ac66-f84002c87d0b" :question/math-academy-id "e-9955"} :knowledge-point/id #uuid "3e95ede7-306b-55e1-9245-7493f0afb514" :knowledge-point/questions [{:db/id #edb/ref 17592186184437} {:db/id #edb/ref 17592186184536} {:db/id #edb/ref 17592186542143} {:db/id #edb/ref 17592186542144} {:db/id #edb/ref 17592186542205} {:db/id #edb/ref 17592186542206}] :knowledge-point/title "Finding Normal Lines to Polar Curves"} :step/id #uuid "e6c2d34a-6683-50c4-a82e-b71e985d4ed8" :step/math-academy-id 642672} {:db/id #edb/ref 17592186185006 :step/content {:db/id #edb/ref 17592186185342 :tutorial/content "![](images/a0/a0b4ad67ea80f6d6eec3a15b3df18d551d84263c7424405588bd15162ef4e7c2.png)\n\nThe polar curve shown above is defined as\n\n$$\nr(\\theta) = 4 - 3\\cos \\theta, \\qquad 0\\leq \\theta < 2\\pi.\n$$\n\nWe have $\\theta = \\dfrac{\\pi}{2}$ at the point $P.$ The tangent to the curve at $P$ is shown in the diagram. \n\nTo find the equation of the tangent line to the curve at $P,$ we follow four steps.\n\n**Step 1**: Calculate the derivative $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$\n\nUsing techniques that we've previously discussed, we can show that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta )=4\\operatorname{cos}⁡\\theta -3\\operatorname{cos}⁡2\\theta ,\\,{x}^{′}(\\theta )=3\\operatorname{sin}⁡2\\theta -4\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we can find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & =\\frac{4\\operatorname{cos}⁡\\theta -3\\operatorname{cos}⁡2\\theta }{3\\operatorname{sin}⁡2\\theta -4\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\n**Step 2**: Find the slope of the tangent at $P.$\n\nThe slope of the tangent line is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2} \\\\  & =\\frac{4\\operatorname{cos}⁡(\\frac{\\pi }{2})-3\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})}{3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-4\\operatorname{sin}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{4\\operatorname{cos}⁡(\\frac{\\pi }{2})-3\\operatorname{cos}⁡(\\pi )}{3\\operatorname{sin}⁡(\\pi )-4\\operatorname{sin}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{0+3}{0-4} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\n**Step 3**: Find the Cartesian coordinates of $P.$\n\nWe compute the $xy$-coordinates of $P$ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =r\\operatorname{cos}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0 \\\\ {y}_{1} & =r\\operatorname{sin}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =(4-3\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $\\left( 0, 4 \\right).$\n\n**Step 4**: Using point-slope form, find the equation of the tangent.\n\nWe find the equation of the tangent as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{3}{4}\\cdot (x-0) \\\\ y & =-\\frac{3}{4}x+4\\end{aligned}\n$$" :tutorial/id #uuid "febc7b49-9662-5e78-a7a5-cbe9b1f596ba" :tutorial/math-academy-id 6186 :tutorial/title "Introduction"} :step/id #uuid "a1e51e4b-71cf-5749-aae1-c001b3a5a59b" :step/math-academy-id 642668 :step/next {:db/id #edb/ref 17592186184944}}] :activity/title "Tangent and Normal Lines to Polar Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186184419}] [{:activity/expected-seconds 1140.0 :activity/first-step {:db/id #edb/ref 17592186097751} :activity/id #uuid "f055ed71-ae5b-569a-8cbe-acd4850a5cce" :activity/scope {:db/id #edb/ref 17592186049507 :topic/id #uuid "fa777873-dae5-503a-8b8d-d333b158b938" :topic/math-academy-id 1080} :activity/steps [{:db/id #edb/ref 17592186097751 :step/content {:db/id #edb/ref 17592186097803 :tutorial/content "Suppose that we want to *approximate* $f(x) = e^x$ for some value of $x.$ We can do this using the second-degree Taylor polynomial about a point $x=a.$ For example, the second-degree Taylor polynomial for $e^x$ about the point $x=1$ is shown below:\n\n$$\ne^x \\approx P_2(x) = e + e(x-1) + \\dfrac 1 2 e(x-1)^2\n$$\n\nIn general, the polynomial $P_2(x)$ is only an approximation to the function $f(x),$ which means that there will usually be some error whenever we use $P_2$ to approximate $f.$ We want to know how bad this error can get. Can we find an upper bound for the error? \n\nLet $R_2(x)$ be the **error** (or **remainder**) that we get when we use $P_2$ to approximate $f(x)=e^x,$ so \n\n$$\nR_2(x) = e^x  - P_2(x).\n$$\n\nThe **Lagrange error bound** states that an upper bound for $R_2$ is given by,\n\n$$\n|R_2| \\leq \\dfrac{M}{3!}|x-a|^{3},\n$$\n\nwhere $M$ the maximum value of $|f^{(3)}(x)|$ on the interval between $a$ and $x.$ \n\nIn our case, since our Taylor polynomial is taken about the point $a=1,$ the Lagrange error bound becomes\n\n$$\n|R_2| \\leq \\dfrac{M}{3!}|x-1|^{3}.\n$$\n\nNotice that the Lagrange error bound looks a lot like the last term of the *next* Taylor polynomial, $P_3(x).$\n\nThe tricky part is finding the value of $M.$ We'll learn how to do that in the following example." :tutorial/id #uuid "fcb4053a-c61a-538b-8b44-5a92f73f053f" :tutorial/math-academy-id 1292 :tutorial/title "Introduction"} :step/id #uuid "c93a74b3-e513-5fb9-9595-6bf177ec940a" :step/math-academy-id 4844 :step/next {:db/id #edb/ref 17592186097752}} {:db/id #edb/ref 17592186097752 :step/content {:db/id #edb/ref 17592186096820 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096562 :question/id #uuid "c946c1c9-f3d2-5d9d-9390-8ee542ca15a5" :question/math-academy-id "e-745"} :knowledge-point/id #uuid "360b8076-1b27-5630-a07e-221a0e53011d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048515} {:db/id #edb/ref 17592186050718} {:db/id #edb/ref 17592186050866} {:db/id #edb/ref 17592186050955}] :knowledge-point/questions [{:db/id #edb/ref 17592186096971} {:db/id #edb/ref 17592186097317} {:db/id #edb/ref 17592186530446} {:db/id #edb/ref 17592186530492} {:db/id #edb/ref 17592186530512} {:db/id #edb/ref 17592186530524}] :knowledge-point/title "Finding an Upper Bound for the Error Using the Second-Degree Taylor Polynomial"} :step/id #uuid "82542d7a-3ec1-5979-8dd2-13a732ad5eb1" :step/math-academy-id 4845 :step/next {:db/id #edb/ref 17592186097753}} {:db/id #edb/ref 17592186097753 :step/content {:db/id #edb/ref 17592186097804 :tutorial/content "The Lagrange error bound that we've discussed so far is valid only for the error associated with a second-degree Taylor polynomial. But we can generalize the result to higher-order Taylor polynomials.\n\nLet $R_n(x)$ be the error involved in approximating a function $f(x)$ by its $n$th-degree Taylor polynomial $P_n(x)$ about $x=a.$ So, we have\n\n$$\nR_n(x) = f(x) - P_n(x).\n$$\n\nThen the Lagrange error bound for $R_n$ is given by\n\n$$\n|R_n(x)| \\leq \\dfrac{M}{(n+1)!}|x-a|^{n+1},\n$$\n\nwhere $M$ is the maximum value of $|f^{(n+1)}|$ on the interval between $a$ and $x.$" :tutorial/id #uuid "07b10e6a-1673-5d6e-8572-8b4505579f44" :tutorial/math-academy-id 1294 :tutorial/title "The General Result of the Lagrange Error Bound"} :step/id #uuid "13415159-b315-5389-bc81-61ef044820e2" :step/math-academy-id 4849 :step/next {:db/id #edb/ref 17592186097754}} {:db/id #edb/ref 17592186097754 :step/content {:db/id #edb/ref 17592186096821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096563 :question/id #uuid "3f5e5945-cdaa-55b9-b360-9e68249480b7" :question/math-academy-id "e-746"} :knowledge-point/id #uuid "79a10073-8798-597e-821c-691b0dad5ae7" :knowledge-point/questions [{:db/id #edb/ref 17592186096961} {:db/id #edb/ref 17592186096980} {:db/id #edb/ref 17592186527920} {:db/id #edb/ref 17592186530415} {:db/id #edb/ref 17592186530503} {:db/id #edb/ref 17592186530534} {:db/id #edb/ref 17592186530544} {:db/id #edb/ref 17592186534044}] :knowledge-point/title "Finding an Upper Bound for the Error Using the Third-Degree Taylor Polynomial"} :step/id #uuid "b70fcb39-7efc-50ad-a28c-73509579c61d" :step/math-academy-id 4850}] :activity/title "The Lagrange Error Bound" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096869}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186189089} :activity/id #uuid "4886bded-bc52-550f-be94-ef03345f5d14" :activity/scope {:db/id #edb/ref 17592186049835 :topic/id #uuid "1799affe-81a7-5a7c-a4ab-d18a27e25076" :topic/math-academy-id 3854} :activity/steps [{:db/id #edb/ref 17592186189061 :step/content {:db/id #edb/ref 17592186189360 :tutorial/content "To find the first derivative of a parametric curve, we use the formula\n\n$$\n\\dfrac{\\textrm dy}{\\textrm dx} = \\dfrac{y'(\\theta)}{x'(\\theta)}.\n$$\n\nA formula for the second derivative of a parametric curve can be found by applying the chain rule:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{d}{dx}(\\frac{dy}{dx}) \\\\  & =\\frac{d}{d\\theta }(\\frac{dy}{dx})\\cdot \\frac{d\\theta }{dx} \\\\  & =\\frac{\\frac{d}{d\\theta }(\\frac{dy}{dx})}{(\\frac{dx}{d\\theta })}\\end{aligned}\n$$\n\nLet's see an example of how to apply this." :tutorial/id #uuid "16aecece-e4cd-56e7-bdd9-a19c15eb3136" :tutorial/math-academy-id 1124 :tutorial/title "Calculating Second Derivatives of Polar Curves"} :step/id #uuid "1bec56da-aad1-51b3-af70-e54f081bf7c0" :step/math-academy-id 2211 :step/next {:db/id #edb/ref 17592186189062}} {:db/id #edb/ref 17592186189062 :step/content {:db/id #edb/ref 17592186188262 :knowledge-point/canonical-example {:db/id #edb/ref 17592186188205 :question/id #uuid "366bcb1d-3fe4-5047-8306-bd28935b5431" :question/math-academy-id "e-631"} :knowledge-point/id #uuid "14b618a5-02d2-5564-a288-3423a873a746" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048727} {:db/id #edb/ref 17592186048867}] :knowledge-point/questions [{:db/id #edb/ref 17592186188927} {:db/id #edb/ref 17592186188973} {:db/id #edb/ref 17592186275254} {:db/id #edb/ref 17592186275255} {:db/id #edb/ref 17592186319232} {:db/id #edb/ref 17592186320990} {:db/id #edb/ref 17592186345062} {:db/id #edb/ref 17592186373195}] :knowledge-point/title "Finding the Second Derivative of a Polar Curve"} :step/id #uuid "b2ee3a4d-b10f-5633-a0b0-9087e7785ae4" :step/math-academy-id 2212} {:db/id #edb/ref 17592186189089 :step/content {:db/id #edb/ref 17592186189368 :tutorial/content "It's often helpful to use the double-angle formula for sine when computing the slope of the tangent to a polar curve, as this often makes the differentiation easier.\n\nLet's consider the polar curve $r = 1-2\\cos\\theta,$ whose graph is shown below \n\n![](images/53/53c660d25a8bec2346cacd95d70fb3f4ee27afe039bd23cbe7affa3cf04eb09a.png)\n\nRecall that the slope of the tangent (in terms of $\\theta$) is given by\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\dfrac{y'(\\theta)}{x'(\\theta)}.\n$$\n\nFirst, to convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx = r \\cos \\theta, \\qquad y = r \\sin \\theta.\n$$\n\nUsing the fact that $r = 1-2\\cos\\theta,$ we get\n\n$$\n\\begin{aligned}x & =(1-2\\operatorname{cos}\\theta )\\operatorname{cos}\\theta  \\\\  & =\\operatorname{cos}\\theta -2{cos}^{2}\\theta , \\\\ y & =(1-2\\operatorname{cos}\\theta )\\operatorname{sin}\\theta  \\\\  & =\\operatorname{sin}\\theta -2\\operatorname{sin}\\theta \\operatorname{cos}\\theta  \\\\  & =\\operatorname{sin}\\theta -\\operatorname{sin}2\\theta .\\end{aligned}\n$$\n\nNotice that we used the double-angle formula $\\color{black}\\sin2\\theta = 2\\sin\\theta\\cos\\theta$ to simplify our expression for $y.$\n\nTo compute our derivative, we need to calculate $x'(\\theta)$ and $y'(\\theta).$ \n\n- First, we compute the derivative of $x$ with respect to $\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{'}(\\theta ) & =(\\operatorname{cos}\\theta -2{cos}^{2}\\theta )^{'} \\\\  & =(\\operatorname{cos}\\theta )^{'}-(2{cos}^{2}\\theta )^{'} \\\\  & =(-\\operatorname{sin}\\theta )-(2\\cdot 2\\operatorname{cos}\\theta \\cdot (-\\operatorname{sin}\\theta )) \\\\  & =-\\operatorname{sin}\\theta +2\\cdot 2\\operatorname{sin}\\theta \\operatorname{cos}\\theta  \\\\  & =-\\operatorname{sin}\\theta +2\\cdot \\operatorname{sin}2\\theta  \\\\  & =2\\operatorname{sin}2\\theta -\\operatorname{sin}\\theta \\end{aligned}\n$$\n\n- Then, we compute the derivative of $y$ with respect to $\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{y}^{'}(\\theta ) & ={(\\operatorname{sin}\\theta -\\operatorname{sin}2\\theta )}^{'} \\\\  & ={(\\operatorname{sin}\\theta )}^{'}-{(\\operatorname{sin}2\\theta )}^{'} \\\\  & =\\operatorname{cos}\\theta -2\\operatorname{cos}2\\theta \\end{aligned}\n$$\n\nFinally, the slope of the tangent is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{'}(\\theta )}{{x}^{'}(\\theta )} \\\\  & =\\frac{\\operatorname{cos}\\theta -2\\text{ }\\,\\operatorname{cos}2\\theta }{2\\text{ }\\,\\operatorname{sin}2\\theta -\\operatorname{sin}\\theta }.\\end{aligned}\n$$" :tutorial/id #uuid "adced1fe-4c40-50d1-a9b4-12fcf213b6e7" :tutorial/math-academy-id 6236 :tutorial/title "Introduction"} :step/id #uuid "43d1c988-b5bd-5711-8f19-90e40ffc0bcf" :step/math-academy-id 37856 :step/next {:db/id #edb/ref 17592186189090}} {:db/id #edb/ref 17592186189090 :step/content {:db/id #edb/ref 17592186188282 :knowledge-point/canonical-example {:db/id #edb/ref 17592186187986 :question/id #uuid "deaef5cc-99fb-57e5-a6f2-22f17a7f00af" :question/math-academy-id "e-10033"} :knowledge-point/id #uuid "111da4c7-612b-5e1f-a105-2dbaaea4e5a5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048362} {:db/id #edb/ref 17592186050277}] :knowledge-point/questions [{:db/id #edb/ref 17592186188983} {:db/id #edb/ref 17592186188984} {:db/id #edb/ref 17592186272195} {:db/id #edb/ref 17592186272343} {:db/id #edb/ref 17592186272344} {:db/id #edb/ref 17592186320987}] :knowledge-point/title "Differentiating Polar Curves Using the Double-Angle Formula for Sine"} :step/id #uuid "96db70eb-88bd-53e8-beda-04d15d1f59e8" :step/math-academy-id 37857 :step/next {:db/id #edb/ref 17592186189061}}] :activity/title "Further Differentiation of Curves Given in Polar Form" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186188449}] [{:activity/expected-seconds 780.0 :activity/first-step {:db/id #edb/ref 17592186093050} :activity/id #uuid "da06c60c-1fc7-5aba-a97b-e4a96f42914c" :activity/scope {:db/id #edb/ref 17592186049940 :topic/id #uuid "200becd7-0209-5fb0-a1a1-783a2c655123" :topic/math-academy-id 936} :activity/steps [{:db/id #edb/ref 17592186093050 :step/content {:db/id #edb/ref 17592186093428 :tutorial/content "Suppose we know the position of a point $P(r, \\theta)$ in polar coordinates, and we want to convert it into Cartesian coordinates.\n\nTo do this, we can draw a right triangle with legs $x$ and $y$ and hypotenuse $r.$\n\n![](images/20/205b3684042b0ab0261a4d56800cd89a10a7816f8022befcf6c664337f834380.png)\n\nComputing the trigonometric ratios for the triangle above and solving for $x$ and $y,$ we get the following formulas:\n\n$$\n\\begin{aligned}\\operatorname{cos}\\theta  & =\\frac{x}{r}\\, & \\Rightarrow  & \\, & x & =r\\operatorname{cos}\\theta , \\\\ \\operatorname{sin}\\theta  & =\\frac{y}{r}\\, & \\Rightarrow  & \\, & y & =r\\operatorname{sin}\\theta .\\end{aligned}\n$$\n\nLet's use these formulas to write the point $P(2, 60^\\circ)$ in Cartesian coordinates. Here, we have $r=2$ and $\\theta =60^\\circ.$ So, we get\n\n$$\n\\begin{aligned}x & =2\\operatorname{cos}{60}^{∘}=2\\cdot \\frac{1}{2}=1, \\\\ y & =2\\operatorname{sin}{60}^{∘}=2\\cdot \\frac{\\sqrt{3}}{2}=\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, $P$ can be written in Cartesian coordinates as $P(1, \\sqrt{3}).$" :tutorial/id #uuid "0c11e98f-8b92-5ed1-bfd7-cca35a6dd373" :tutorial/math-academy-id 3505 :tutorial/title "Introduction"} :step/id #uuid "f4430b4e-cd63-5050-96ee-77d773bfc9a8" :step/math-academy-id 19864 :step/next {:db/id #edb/ref 17592186093051}} {:db/id #edb/ref 17592186093051 :step/content {:db/id #edb/ref 17592186092217 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092059 :question/id #uuid "bc48e845-b2a7-5e30-9c73-b7d842f4090c" :question/math-academy-id "e-5383"} :knowledge-point/id #uuid "7f65d032-9acc-5fe