}\\frac{1}{2n-1}\\cdot (-1)^{n+1}-2{\\sum }_{n=1}^{\\infty }\\frac{1}{2n}\\cdot 0 \\\\ \\frac{\\pi }{4} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186522863 #edb/ref 1058 #edb/ref 17592186522866 #edb/ref 17592186045417] [17592186522863 #edb/ref 1062 #uuid "969437fc-e95c-5d51-94cd-743a35a21d1e" #edb/ref 17592186045417] [17592186522863 #edb/ref 1063 #edb/ref 17592186317392 #edb/ref 17592186045417] [17592186522866 #edb/ref 1058 #edb/ref 17592186522887 #edb/ref 17592186045417] [17592186522866 #edb/ref 1062 #uuid "ac2c3dcb-6fb5-5ec6-9675-b0b01ae17d71" #edb/ref 17592186045417] [17592186522866 #edb/ref 1063 #edb/ref 17592186317394 #edb/ref 17592186045417] [17592186522870 #edb/ref 1062 #uuid "b254bd23-4ba4-5a8e-8cca-2c56ed85728f" #edb/ref 17592186045417] [17592186522870 #edb/ref 1063 #edb/ref 17592186522770 #edb/ref 17592186045417] [17592186522887 #edb/ref 1058 #edb/ref 17592186522870 #edb/ref 17592186045417] [17592186522887 #edb/ref 1062 #uuid "e12ea09f-0e8e-59a7-8217-baaa83d63cda" #edb/ref 17592186045417] [17592186522887 #edb/ref 1063 #edb/ref 17592186402284 #edb/ref 17592186045417]}
