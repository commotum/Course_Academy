 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186402296} {:answer/id #uuid "4ff2de29-17f1-5bf9-b1b1-74047f493c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186402297} {:answer/id #uuid "c2980206-7d39-5dc7-9dd7-4a889845d7cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402298}] :answer-field/correct {:answer/id #uuid "c2980206-7d39-5dc7-9dd7-4a889845d7cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402298} :answer-field/id #uuid "9ab80b53-c5e0-529a-8043-c52969416199" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402295} {:answer-field/choices [{:answer/id #uuid "35eec229-a765-5483-a12b-af96b02f02b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186402300} {:answer/id #uuid "c73e9609-34d2-5881-aad7-336bd7907eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186402301}] :answer-field/correct {:answer/id #uuid "35eec229-a765-5483-a12b-af96b02f02b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186402300} :answer-field/id #uuid "2793680d-49bf-5c9e-8ee3-c5e0e9eb684c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186402299}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e361d1a0-a782-5eed-a0dc-4cde0324cd70" :question/math-academy-id "q-343395" :question/problem "Consider the function $F(x)=|x|$ defined on $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼1-{\\sum }_{n=1}^{\\infty }\\frac{8}{{\\pi }^{2}(2n-1)^{2}}\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}x).\n$$\n\nSelect the correct options in the reasoning below.\n\nAt $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}x).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0) \\\\ 0 & =1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot 1 \\\\ -1 & =-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} & =\\frac{{\\pi }^{2}}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186522770 :knowledge-point/_questions [{:db/id #edb/ref 17592186166961 :knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e5a6f2-9272-5161-919b-04845a8c04cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186522016} {:answer/id #uuid "227a5d12-1270-57e4-a81e-b7bae3293ff2" :answer/