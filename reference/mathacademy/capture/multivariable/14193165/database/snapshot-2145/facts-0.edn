5f" #edb/ref 17592186045417] [17592186507398 #edb/ref 1075 #edb/ref 17592186506913 #edb/ref 17592186045417] [17592186507398 #edb/ref 1076 #edb/ref 17592186045492 #edb/ref 17592186045417] [17592186507398 #edb/ref 1077 "field-1" #edb/ref 17592186045417] [17592186507398 #edb/ref 1078 #edb/ref 17592186506913 #edb/ref 17592186045417] [17592186507398 #edb/ref 1079 #uuid "fd1d6034-d9bb-50d2-ab93-d34b4b0eeb0b" #edb/ref 17592186045417] [17592186507418 #edb/ref 1068 #edb/ref 17592186507339 #edb/ref 17592186045417] [17592186507418 #edb/ref 1069 "q-48026" #edb/ref 17592186045417] [17592186507418 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507418 #edb/ref 1071 "What is the tangent line approximation of $\\sqrt[3]{x}$ at $x=8?$" #edb/ref 17592186045417] [17592186507418 #edb/ref 1072 #uuid "37b97735-c2a7-51cf-8f02-b676a9408bdf" #edb/ref 17592186045417] [17592186507418 #edb/ref 1074 "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=8,$ which gives\n\n$$\nL(x)=f(8)+{f}^{′}(8)(x-8).\n$$\n\nLet's compute $f(8)$ and ${f}^{′}(8)$ in the expression above. Evaluating the function, we get\n\n$$\nf(8)=\\sqrt[3]{8}=2,\n$$\n\nand computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[3]{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{1/3}) \\\\  & =\\frac{1}{3\\sqrt[3]{{x}^{2}}},\\end{aligned}\n$$\n\nwhich in turn gives\n\n$$\n{f}^{′}(8)=\\frac{1}{3{(\\sqrt[3]{8})}^{2}}=\\frac{1}{12}.\n$$\n\nSo, the tangent line approximation is\n\n$$\n\\begin{aligned}L(x) & =f(8)+{f}^{′}(8)(x-8) \\\\  & =2+\\frac{1}{12}(x-8) \\\\  & =2+\\frac{1}{12}x-\\frac{8}{12} \\\\  & =2-\\frac{2}{3}+\\frac{1}{12}x \\\\  & =\\frac{4}{3}+\\frac{1}{12}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186507436 #edb/ref 1068 #edb/ref 17592186507335 #edb/ref 17592186045417] [17592186507436 #edb/ref 1069 "q-348190" #edb/ref 17592186045417] [17592186507436 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507436 #edb/ref 1071 "Approximate the value of $\\sqrt{2}$ using the tangent line approximation of $f(x)=\\sqrt{x}$ at $x=1.$ Do not round the answer.\n\n$\\sqrt{2}≈$ \n{{field-1}}" #edb/ref 17592186045417] [17592186507436 #edb/ref 1072 #uuid "4db89f44-88ed-5c90-a196-4f35357b51b1" #edb/ref 17592186045417] [17592186507436 #edb/ref 1074 "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=1,$ which gives\n\n$$\nL(x)=f(1)+{f}^{′}(1)(x-1).\n$$\n\nLet's compute $f(1)$ and ${f}^{′}(1)$ in the expression above. Evaluating the function, we get\n\n$$\nf(1)=\\sqrt{1}=1,\n$$\n\nand computing the derivative, we get\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})=\\frac{1}{2\\sqrt{x}},\n$$\n\nwhich in turn gives\n\n$$\n{f}^{′}(1)=\\frac{1}{2\\sqrt{1}}=\\frac{1}{2}.\n$$\n\nSo, the tangent line approximation is\n\n$$\nL(x)=1+\\frac{1}{2}(x-1).\n$$\n\nWe can approximate $\\sqrt{2}$ by evaluating the tangent line approximation at $x=2.$ We get\n\n$$\n\\begin{aligned}\\sqrt{2} & ≈L(2) \\\\  & =1+\\frac{1}{2}(2-1) \\\\  & =1+\\frac{1}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186507449 #edb/ref 1068 #edb/ref 17592186507312 #edb/ref 17592186045417] [17592186507449 #edb/ref 1069 "q-86438" #edb/ref 17592186045417] [17592186507449 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186507449 #edb/ref 1071 "Approximate the value of $\\,2\\sqrt[3]{8.9}\\,$ using the tangent line approximation of $f(x)=2\\sqrt[3]{x}\\,$ at $\\,x=8.$" #edb/ref 17592186045417] [17592186507449 #edb/ref 1072 #uuid "73785757-6df7-5674-90c2-d6eaa9a04258" #edb/ref 17592186045417] [17592186507449 #edb/ref 1074 "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=8,$ which gives\n\n$$\n\\begin{aligned}L(x)=f(8)+{f}^{′}(8)(x-8).\\end{aligned}\n$$\n\nLet's compute $f(8)$ and ${f}^{′}(8)$ in the expression above. Evaluating the function, we get\n\n$$\nf(8)=2\\sqrt[3]{8}=4,\n$$\n\nand computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt[3]{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{1/3}) \\\\  & =\\frac{2}{3\\sqrt[3]{{x}^{2}}},\\end{aligned}\n$$\n\nwhich in turn, gives\n\n$$\n{f}^{′}(8)=\\frac{2}{3{(\\sqrt[3]{8})}^{2}}=\\frac{1}{6}.\n$$\n\nSo the tangent line approximation is\n\n$$\nL(x)=4+\\frac{1}{6}(x-8).\n$$\n\nWe can approximate $2\\sqrt[3]{8.9}$ by evaluating the tangent line approximation at $x=8.9.$ We get\n\n$$\n\\begin{aligned}2\\sqrt[3]{8.9} & ≈L(8.9) \\\\  & =4+\\frac{1}{6}(8.9-8) \\\\  & =4+\\frac{1}{6}(0.9) \\\\  & =4+0.15 \\\\  & =4.15\\,.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186507461 #edb/ref 1068 #edb/ref 17592186507398 #edb/ref 17592186045417] [17592186507461 #edb/ref 1069 "q-348182" #edb/ref 17592186045417] [17592186507461 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507461 #edb/ref 1071 "Determine the tangent line approximation $L(x)$ of $\\sqrt{x}$ at $x=36.$\n\n$L(x)=$\n{{field-1}}" #edb/ref 17592186045417] [17592186507461 #edb/ref 1072 #uuid "9928af49-cfd1-5831-93d9-b7e47b2c04f9" #edb/ref 17592186045417] [17592186507461 #edb/ref 1074 "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=36,$ which gives\n\n$$\nL(x)=f(36)+{f}^{′}(36)(x-36).\n$$\n\nLet's compute $f(36)$ and ${f}^{′}(36)$ in the expression above. Evaluating the function, we get\n\n$$\nf(36)=\\sqrt{36}=6,\n$$\n\nand computing the derivative, we get\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})=\\frac{1}{2\\sqrt{x}},\n$$\n\nwhich in turn gives\n\n$$\n{f}^{′}(36)=\\frac{1}{2\\sqrt{36}}=\\frac{1}{2\\cdot 6}=\\frac{1}{12}.\n$$\n\nSo, the tangent line approximation is\n\n$$\n\\begin{aligned}L(x) & =f(36)+{f}^{′}(36)(x-36) \\\\  & =6+\\frac{1}{12}(x-36) \\\\  & =6+\\frac{1}{12}x-3 \\\\  & =6-3+\\frac{1}{12}x \\\\  & =3+\\frac{1}{12}x.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186507504 #edb/ref 1068 #edb/ref 17592186507256 #edb/ref 17592186045417] [17592186507504 #edb/ref 1069 "q-48022" #edb/ref 17592186045417] [17592186507504 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186507504 #edb/ref 1071 "Using the tangent line approximation of $f(x)=\\sqrt[3]{x}$ at $x=27$, approximate the value of $\\sqrt[3]{28}.$" #edb/ref 17592186045417] [17592186507504 #edb/ref 1072 #uuid "d0a9d3c2-a748-522d-b588-6439a04ab73d" #edb/ref 17592186045417] [17592186507504 #edb/ref 1074 "The tangent line approximation of $f(x)$ at the point $x=a$ is\n\n$$\nL(x)=f(a)+{f}^{′}(a)(x-a).\n$$\n\nIn our case, we have $a=27,$ which gives\n\n$$\nL(x)=f(27)+{f}^{′}(27)(x-27).\n$$\n\nLet's compute $f(27)$ and ${f}^{′}(27)$ in the expression above. Evaluating the function, we get\n\n$$\nf(27)=\\sqrt[3]{27}=3,\n$$\n\nand computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[3]{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{1/3}) \\\\  & =\\frac{1}{3\\sqrt[3]{{x}^{2}}},\\end{aligned}\n$$\n\nwhich in turn gives\n\n$$\n{f}^{′}(27)=\\frac{1}{3\\sqrt[3]{{27}^{2}}}=\\frac{1}{27}.\n$$\n\nSo, the tangent line approximation is\n\n$$\nL(x)=3+\\frac{1}{27}(x-27).\n$$\n\nWe can approximate $\\sqrt[3]{28}$ by evaluating the tangent line approximation at $x=28.$ We get\n\n$$\n\\begin{aligned}\\sqrt[3]{28} & ≈L(28) \\\\  & =3+\\frac{1}{27}(28-27) \\\\  & =3+\\frac{1}{27}(1) \\\\  & =\\frac{82}{27}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186507530 #edb/ref 1058 #edb/ref 17592186507566 #edb/ref 17592186045417] [17592186507530 #edb/ref 1062 #uuid "0140152d-193f-5b53-8cfc-eda1beda003a" #edb/ref 17592186045417] [17592186507530 #edb/ref 1063 #edb/ref 17592186507461 #edb/ref 17592186045417] [17592186507551 #edb/ref 1058 #edb/ref 17592186507573 #edb/ref 17592186045417] [1759