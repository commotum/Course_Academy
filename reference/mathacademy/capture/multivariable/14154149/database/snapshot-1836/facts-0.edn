 & -1 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 0 & -1 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}-4{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 4 & -9 & 5 \\\\ 0 & 0 & 0 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}-4{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & -5 & 9 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, since $T$ has $3$ pivot columns, we have that \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=3.\n$$" #edb/ref 17592186045417] [17592186324454 #edb/ref 1080 "-5" #edb/ref 17592186045417] [17592186324454 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324454 #edb/ref 1083 #uuid "3bcf98a3-43f3-5c33-abdd-b8d026c7a6b7" #edb/ref 17592186045417] [17592186324774 #edb/ref 1080 "-12" #edb/ref 17592186045417] [17592186324774 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324774 #edb/ref 1083 #uuid "5ff62de4-85a2-5c35-aaf4-9b765d05dd69" #edb/ref 17592186045417] [17592186324785 #edb/ref 1080 "22" #edb/ref 17592186045417] [17592186324785 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324785 #edb/ref 1083 #uuid "6183d2d1-9a6e-519b-90ed-7e04299a8044" #edb/ref 17592186045417] [17592186324787 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186324787 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186324787 #edb/ref 1083 #uuid "618a014c-5312-57e8-bd68-f7ee954e2a04" #edb/ref 17592186045417] [17592186325164 #edb/ref 1080 "2" #edb/ref 17592186045417] [17592186325164 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325164 #edb/ref 1083 #uuid "8c805c44-90a4-5f57-8f03-50f9d3dbc059" #edb/ref 17592186045417] [17592186325185 #edb/ref 1080 "-2" #edb/ref 17592186045417] [17592186325185 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186325185 #edb/ref 1083 #uuid "8f3d74ff-8b9e-5837-9590-93c8742df1d9" #edb