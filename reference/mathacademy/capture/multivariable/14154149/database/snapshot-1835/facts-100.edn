x}_{1}-{x}_{3} \\\\ 4{x}_{2}+{x}_{4}+5{x}_{3}+2{x}_{1} \\\\ -7{x}_{3}-{x}_{1}-{x}_{2}-{x}_{4}\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -8 \\\\ -9 \\\\ 10\\end{aligned}]\n$$" #edb/ref 17592186045417] [17592186395885 #edb/ref 1072 #uuid "4809e77f-c615-585e-bbe9-4304896c33b4" #edb/ref 17592186045417] [17592186395885 #edb/ref 1074 "First, we write down the standard matrix of $T:$\n\n$$\nT=[\\begin{aligned}1 & -1 & 2 & 2 \\\\ -3 & 5 & -1 & -7 \\\\ 2 & 4 & 5 & 1 \\\\ -1 & -1 & -7 & -1\\end{aligned}]\n$$\n\nSince $T$ is the standard matix of $T,$ we have $\\text{Im}(T)=\\text{Col}(T).$ In order to determine whether $b$ lies in $\\text{Im}(T),$ we need to check if the equation $Tx=b$ is consistent. \n\nSo, let's find the row echelon form of the augmented matrix $[T\\,|\\,b]$ as follows: \n\n$$\n\\begin{aligned}[T\\,|\\,b] & =[\\begin{aligned}1 & -1 & 2 & 2 & 3 \\\\ -3 & 5 & -1 & -7 & -8 \\\\ 2 & 4 & 5 & 1 & -9 \\\\ -1 & -1 & -7 & -1 & 10\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\ {R}_{4}:={R}_{4}+{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 & 3 \\\\ 0 & 2 & 5 & -1 & 1 \\\\ 0 & 6 & 1 & -3 & -15 \\\\ 0 & -2 & -5 & 1 & 13\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}-3{R}_{2} \\\\ {R}_{4}:={R}_{4}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 & 3 \\\\ 0 & 2 & 5 & -1 & 1 \\\\ 0 & 0 & -14 & 0 & -18 \\\\ 0 & 0 & 0 & 0 & 14\\end{aligned}]\\end{aligned}\n$$\n\nFrom the foruth equation, we get the false statement $0=14.$ Therefore, the system is inconsistent, and we conclude that  $b\\notin \\text{Im}(T).$" #edb/ref 17592186045417] [17592186395886 #edb/ref 1075 #edb/ref 17592186395887 #edb/ref 17592186045417] [17592186395886 #edb/ref 1075 #edb/ref 17592186395888 #edb/ref 17592186045417] [17592186395886 #edb/ref 1075 #edb/ref 17592186395889 #edb/ref 17592186045417] [17592186395886 #edb/ref 1075 #edb/ref 17592186395890 #edb/ref 17592186045417] [17592186395886 #edb/ref 1075 #edb/ref 1