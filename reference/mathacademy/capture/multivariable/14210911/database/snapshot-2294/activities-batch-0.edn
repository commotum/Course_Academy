#{[{:activity/expected-seconds 1080.0 :activity/first-step {:db/id #edb/ref 17592186199269} :activity/id #uuid "9c0cd1dd-d41d-511e-aa18-44cf1df53bbc" :activity/scope {:db/id #edb/ref 17592186049639 :topic/id #uuid "077676ad-6f2b-5e36-b6e9-f37bfd844a79" :topic/math-academy-id 4151} :activity/steps [{:db/id #edb/ref 17592186199269 :step/content {:db/id #edb/ref 17592186199461 :tutorial/content "Suppose that the transformation $\\mathbf T,$ given by\n\n$$\n\\mathbf T: (u,v,w) \\longrightarrow \\left(x(u,v,w), \\, y(u,v,w), \\, z(u,v,w) \\right)\n$$\n\nis a $C^1$ transformation that has no critical points (i.e., it is invertible) inside some region $\\Delta\\subset \\mathbb R^3,$ and that $\\mathbf T(\\Delta) = R,$ as shown below.\n\n![](images/d7/d7875753545cba8babd08fccaf55236c6b32bfc56f43f496343174acc198f1d9.png)\n\n \n\nTo compute the integral of a function $f(x,y,z)$ over $R,$ we use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\ \\mathrm{d}V = \\iiint\\limits_{\\Delta} \\ f(x(u,v,w), y(u,v,w), z(u,v,w)) \\: \\left| \\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)} \\right|  \\: \\textrm{d}u \\textrm{d}v \\textrm{d}w\n$$\n\nwhere $\\dfrac{\\partial (x, y, z)}{\\partial (u, v, w)}$ is the Jacobian determinant corresponding to $\\mathbf{T}.$\n\nNote the similarity with the change of variables formula for double integrals." :tutorial/id #uuid "a43397ab-8a32-5928-ba64-90ad84532ab1" :tutorial/math-academy-id 7217 :tutorial/title "Introduction"} :step/id #uuid "c8fb7bf0-e270-5a21-96df-05f4bb90a104" :step/math-academy-id 42964 :step/next {:db/id #edb/ref 17592186199311}} {:db/id #edb/ref 17592186199311 :step/content {:db/id #edb/ref 17592186198397 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198039 :question/id #uuid "d123b7fd-5a13-50c0-aa8c-dc196f4b1bcd" :question/math-academy-id "e-12406"} :knowledge-point/id #uuid "a898f345-9210-5976-9a42-f415a0e7eaf5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048839} {:db/id #edb/ref 17592186049530} {:db/id #edb/ref 17592186050482}] :knowledge-point/questions [{:db/id #edb/ref 17592186198959} {:db/id #edb/ref 17592186198963} {:db/id #edb/ref 17592186374083} {:db/id #edb/ref 17592186375123} {:db/id #edb/ref 17592186401302} {:db/id #edb/ref 17592186482511} {:db/id #edb/ref 17592186482515} {:db/id #edb/ref 17592186482534} {:db/id #edb/ref 17592186482540} {:db/id #edb/ref 17592186499449} {:db/id #edb/ref 17592186522753} {:db/id #edb/ref 17592186522809}] :knowledge-point/title "Performing a Change of Variables in a Triple Integral"} :step/id #uuid "9ff6a5f7-0ed3-5407-9add-6b4b8b9f9576" :step/math-academy-id 44576 :step/next {:db/id #edb/ref 17592186199312}} {:db/id #edb/ref 17592186199312 :step/content {:db/id #edb/ref 17592186198398 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198040 :question/id #uuid "3fccb151-d67f-525b-8804-62589913084a" :question/math-academy-id "e-12407"} :knowledge-point/id #uuid "832dc2b8-873f-56c6-bd87-5e886a586fb1" :knowledge-point/questions [{:db/id #edb/ref 17592186198623} {:db/id #edb/ref 17592186198964} {:db/id #edb/ref 17592186374090} {:db/id #edb/ref 17592186374097} {:db/id #edb/ref 17592186374125} {:db/id #edb/ref 17592186374132} {:db/id #edb/ref 17592186374139} {:db/id #edb/ref 17592186482530} {:db/id #edb/ref 17592186482599} {:db/id #edb/ref 17592186482606} {:db/id #edb/ref 17592186499491} {:db/id #edb/ref 17592186522780}] :knowledge-point/title "Evaluating a Triple Integral Using a Change of Variables"} :step/id #uuid "72db4d82-680c-5663-9ec8-49034717bf11" :step/math-academy-id 44578 :step/next {:db/id #edb/ref 17592186199313}} {:db/id #edb/ref 17592186199313 :step/content {:db/id #edb/ref 17592186198399 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198041 :question/id #uuid "e00a8e15-e738-5fee-80f7-405844fa1422" :question/math-academy-id "e-12408"} :knowledge-point/id #uuid "a8a79d4e-f9e0-583e-8e52-aa60c14fd4a3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048997}] :knowledge-point/questions [{:db/id #edb/ref 17592186198624} {:db/id #edb/ref 17592186198965} {:db/id #edb/ref 17592186374152} {:db/id #edb/ref 17592186374159} {:db/id #edb/ref 17592186374166} {:db/id #edb/ref 17592186374173} {:db/id #edb/ref 17592186482547} {:db/id #edb/ref 17592186482580} {:db/id #edb/ref 17592186482615} {:db/id #edb/ref 17592186482616} {:db/id #edb/ref 17592186499512} {:db/id #edb/ref 17592186499523}] :knowledge-point/title "Computing the Volume of a Region Using a Change of Variables"} :step/id #uuid "63e21bf5-1c47-551b-9e3f-4385831c5ab7" :step/math-academy-id 44583}] :activity/title "Computing Triple Integrals Using a Change of Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198490}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186499586} :activity/id #uuid "70e5a969-4930-5f59-a691-24b99f9f02ca" :activity/scope {:db/id #edb/ref 17592186049639 :topic/id #uuid "077676ad-6f2b-5e36-b6e9-f37bfd844a79" :topic/math-academy-id 4151} :activity/steps [{:db/id #edb/ref 17592186499586 :step/content {:db/id #edb/ref 17592186198959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04edc689-9e29-5c9b-8da2-da4420287986" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3{w}^{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186498740} {:answer/id #uuid "314e6482-a456-5bda-8904-887833458d85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}3\\sqrt{w}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186498844} {:answer/id #uuid "57cc1828-6342-5346-b05d-7d143db10ddf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3\\sqrt{w}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186498931} {:answer/id #uuid "9156d344-2302-5c4e-b0e7-6f7c95dca531" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}3{w}^{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186499047} {:answer/id #uuid "cd799ece-9c4a-56a0-b053-cc390590f85c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{u+v}3w\\,dw\\,dv\\,du" :db/id #edb/ref 17592186499183}] :answer-field/correct {:db/id #edb/ref 17592186498740} :answer-field/id #uuid "fbe99af2-8c2c-533c-80a0-ca42ec737c5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186197624}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96fa59d6-c144-5393-a4a7-7b8198eb987c" :question/math-academy-id "q-38941" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x+y\\le 2,\\,1\\le x-y\\le 2,\\,1\\le z\\le (x-y)(x+y)\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu=x+y,\\,v=x-y,\\,w=\\sqrt{z},\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}3\\sqrt{z}\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=x-y,\\,w=\\sqrt{z}\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,1\\le {w}^{2}\\le uv\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & \\frac{1}{2\\sqrt{z}}\\end{vmatrix} \\\\  & =\\frac{1}{2\\sqrt{z}}(-1)^{3+3}\\begin{vmatrix}1 & 1 \\\\ 1 & -1\\end{vmatrix} \\\\  & =\\frac{1}{2\\sqrt{z}}(-1-1) \\\\  & =-\\frac{1}{\\sqrt{z}} \\\\  & =-\\frac{1}{w}\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-w.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}3\\sqrt{z}\\,dV & ={∭}_{Δ}3w\\cdot |-w|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}3{w}^{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3{w}^{2}\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "4e424c3d-338b-5df6-aae5-f03d2886355c" :step/next {:db/id #edb/ref 17592186499626}} {:db/id #edb/ref 17592186499605 :step/content {:db/id #edb/ref 17592186499523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040577a1-f488-586f-a244-5ac52452a051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186498738} {:answer/id #uuid "134f7fbf-b645-5f5e-a680-2cf1d5fc853c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186498772} {:answer/id #uuid "7649b34b-2218-533c-b3c5-146847fddc3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186498997} {:answer/id #uuid "a4d46a27-dd36-5701-8dd1-b3331e4e3270" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186499086} {:answer/id #uuid "e83877aa-f978-5e05-a20d-0069c96a2685" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12" :db/id #edb/ref 17592186499258}] :answer-field/correct {:db/id #edb/ref 17592186499086} :answer-field/id #uuid "612abc3f-006a-54a9-ba2c-ed70e2955dbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499358}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ad40770e-3352-5877-ade7-ccfd965beccc" :question/math-academy-id "q-162185" :question/problem "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,-1\\le {x}^{2}-y\\le 1,\\,1\\le \\,x\\le 2,\\,0\\le z\\le 3\\}.\n$$" :question/worked-solution "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nThe inequalities that define the region $R,$\n\n$$\n-1\\le {x}^{2}-y\\le 1,\\,1\\le \\,x\\le 2,\\,0\\le z\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu={x}^{2}-y,\\,v=x,\\,w=z.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,-1\\le u\\le 1,\\,1\\le v\\le 2,\\,0\\le w\\le 3\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}2x & -1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =1(-1)^{2+1}\\begin{vmatrix}-1 & 0 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{-1}^{1}{\\int }_{1}^{2}{\\int }_{0}^{3}\\,dw\\,dv\\,du \\\\  & ={\\int }_{-1}^{1}du\\cdot {\\int }_{1}^{2}dv\\cdot {\\int }_{0}^{3}dw \\\\  & =[u]_{u=-1}^{u=1}\\cdot [v]_{v=1}^{v=2}\\cdot [w]_{w=0}^{w=3} \\\\  & =(1-(-1))\\cdot (2-1)\\cdot (3-0) \\\\  & =6.\\end{aligned}\n$$"} :step/id #uuid "997f14cb-37bb-5df1-8d09-16e21f99f0e8" :step/next {:db/id #edb/ref 17592186499620}} {:db/id #edb/ref 17592186499617 :step/content {:db/id #edb/ref 17592186499491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1784c964-2bd8-551a-9e62-6cb6f2560ce3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e" :db/id #edb/ref 17592186498780} {:answer/id #uuid "255b1548-0862-5d3a-8e4b-d22ea5aa0f02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e-1}{3}" :db/id #edb/ref 17592186498812} {:answer/id #uuid "4f74f069-41cb-54fc-8a9a-08d22d7c1865" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3e}{2}" :db/id #edb/ref 17592186498916} {:answer/id #uuid "7d9780c4-afc1-59e7-ac65-84b80ad23ee1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}(e-1)" :db/id #edb/ref 17592186499011} {:answer/id #uuid "903bd708-b320-50fc-b991-e52faae4df28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3e+2" :db/id #edb/ref 17592186499042}] :answer-field/correct {:db/id #edb/ref 17592186499011} :answer-field/id #uuid "2030cf44-2880-55da-b8da-7f5dffbc7894" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499324}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "787730fc-5924-57cd-ac3a-f6e87e085583" :question/math-academy-id "q-161893" :question/problem "Use the change of variables \n\n$$\nu=x+y,\\,v=y-x,\\,w=z,\n$$\n\nto evaluate the triple integral\n\n$$\n∭(x+y){e}^{y-x}\\,dV,\n$$\n\n \nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x+y\\le 2,\\,0\\le y-x\\le 1,\\,0\\le z\\le 3\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=y-x,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,0\\le v\\le 1,\\,0\\le w\\le 3\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =1(-1)^{3+3}\\begin{vmatrix}1 & 1 \\\\ -1 & 1\\end{vmatrix} \\\\  & =1-(-1) \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+y){e}^{y-x}\\,dV & ={∭}_{Δ}u{e}^{v}\\cdot |-\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{u{e}^{v}}{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{0}^{3}\\frac{u{e}^{v}}{2}\\,dw\\,dv\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}u\\,du\\cdot {\\int }_{0}^{1}{e}^{v}\\,dv\\cdot {\\int }_{0}^{3}dw \\\\  & =\\frac{1}{2}\\cdot [\\frac{{u}^{2}}{2}]_{u=1}^{u=2}\\cdot {[{e}^{v}]}_{v=0}^{v=1}\\cdot [w]_{w=0}^{w=3} \\\\  & =\\frac{1}{2}(2-\\frac{1}{2})\\cdot (e-1)\\cdot (3-0) \\\\  & =\\frac{9}{4}(e-1)\\end{aligned}\n$$"} :step/id #uuid "c04691e5-85fd-5cb5-b13a-fc0b06ac55dd" :step/next {:db/id #edb/ref 17592186499605}} {:db/id #edb/ref 17592186499620 :step/content {:db/id #edb/ref 17592186499512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12666955-acda-50b1-a759-415719031788" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186498766} {:answer/id #uuid "33260567-19af-5f87-8391-f7b7b20532c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e" :db/id #edb/ref 17592186498847} {:answer/id #uuid "a6520622-46f1-5688-af38-61a3ff107da8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186499095} {:answer/id #uuid "c17ed11d-1615-505b-9ee3-f62b086faf02" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186499157} {:answer/id #uuid "faf10f5c-fe15-5f32-843c-38243f61e787" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e}{2}" :db/id #edb/ref 17592186499294}] :answer-field/correct {:db/id #edb/ref 17592186499095} :answer-field/id #uuid "772a5b09-0846-503c-9495-bc958a42c8ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499375}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "92990ecc-5ba0-56e3-944d-6e84f299eb57" :question/math-academy-id "q-162210" :question/problem "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y-{e}^{x}\\le 1,\\,1\\le y\\le 2,\\,0\\le z{e}^{-x}\\le 1\\}.\n$$" :question/worked-solution "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nThe inequalities that define the region $R,$\n\n$$\n0\\le y-{e}^{x}\\le 1,\\,1\\le y\\le 2,\\,0\\le z{e}^{-x}\\le 1,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=y-{e}^{x},\\,v=y,\\,w=z{e}^{-x}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,1\\le v\\le 2,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-{e}^{x} & 1 & 0 \\\\ 0 & 1 & 0 \\\\ -z{e}^{-x} & 0 & {e}^{-x}\\end{vmatrix} \\\\  & =1(-1)^{2+2}\\begin{vmatrix}-{e}^{x} & 0 \\\\ -z{e}^{-x} & {e}^{-x}\\end{vmatrix} \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |-1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{0}^{1}dw\\,dv\\,du \\\\  & ={\\int }_{0}^{1}du\\cdot {\\int }_{1}^{2}dv\\cdot {\\int }_{0}^{1}dw \\\\  & =[u]_{u=0}^{u=1}\\cdot [v]_{v=1}^{v=2}\\cdot [w]_{w=0}^{w=1} \\\\  & =(1-0)\\cdot (2-1)\\cdot (1-0) \\\\  & =1.\\end{aligned}\n$$"} :step/id #uuid "d3034e3f-9bca-5084-a008-31d00f87ec29"} {:db/id #edb/ref 17592186499626 :step/content {:db/id #edb/ref 17592186499449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c97c988-3336-5cff-9def-ec7413102202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(u+w)" :db/id #edb/ref 17592186498757} {:answer/id #uuid "1c002a85-7881-5d55-b3a3-c0858f2a52d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}(u+v-w)" :db/id #edb/ref 17592186498789} {:answer/id #uuid "449afe6a-6893-523f-8969-4d9facf23e7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6(v-w)" :db/id #edb/ref 17592186498886} {:answer/id #uuid "5760564c-6d75-5aa4-a9ab-7873348de3bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(u-w-v)" :db/id #edb/ref 17592186498930} {:answer/id #uuid "9cc9fd42-c83a-5ec5-bb24-9d73b0ba363e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}(v-w)" :db/id #edb/ref 17592186499061}] :answer-field/correct {:db/id #edb/ref 17592186498757} :answer-field/id #uuid "219a7147-3bde-5244-974f-5c2639b194f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186499325}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "21557ab9-79b3-55a0-a104-51c3d273599e" :question/math-academy-id "q-161868" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le \\frac{2x-y}{2}\\le 1,\\,0\\le \\frac{y}{2}\\le 2,\\,0\\le z\\le 3\\}.\n$$\n\nGiven the change of variables\n\n$$\nu=\\frac{2x-y}{2},\\,v=\\frac{y}{2},\\,w=\\frac{z}{3},\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}(\\frac{2x-y}{2}+\\frac{z}{3})\\,dV={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{1}\\bbox[3pt,border:1pt solid black]{\\phantom{AAAAAA}}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{2x-y}{2},\\,v=\\frac{y}{2},\\,w=\\frac{z}{3},\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 2,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & -\\frac{1}{2} & 0 \\\\ 0 & \\,\\,\\,\\frac{1}{2} & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{vmatrix} \\\\  & =\\frac{1}{3}\\begin{vmatrix}1 & -\\frac{1}{2} \\\\ 0 & \\,\\,\\,\\frac{1}{2}\\end{vmatrix} \\\\  & =\\frac{1}{3}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=6.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(\\frac{2x-y}{2}+\\frac{z}{3})\\,dV & ={∭}_{Δ}(u+w)\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}(u+w)\\cdot |6|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{1}\\,6(u+w)\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "e20f59c5-7952-5312-97e3-4d44495b61dc" :step/next {:db/id #edb/ref 17592186499617}}] :activity/title "Computing Triple Integrals Using a Change of Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186498724}] [{:activity/course {:db/id #edb/ref 17592186046644} :activity/first-step {:db/id #edb/ref 17592186522843} :activity/id #uuid "79fca1d8-1475-5d69-8c31-46253855b8a4" :activity/scope {:db/id #edb/ref 17592186049639 :topic/id #uuid "077676ad-6f2b-5e36-b6e9-f37bfd844a79" :topic/math-academy-id 4151} :activity/steps [{:db/id #edb/ref 17592186522824 :step/content {:db/id #edb/ref 17592186374083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19590723-9dbc-594f-9f4e-6ca0160553fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{u}}{2}" :db/id #edb/ref 17592186374085} {:answer/id #uuid "e319ca87-b89a-5147-977c-a329bf0ff49e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "u{e}^{v}" :db/id #edb/ref 17592186374086} {:answer/id #uuid "e89988d6-d0a3-55a0-b505-58a6138e15f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{v{e}^{u}}{2}" :db/id #edb/ref 17592186374087} {:answer/id #uuid "26fa2b15-0257-541e-aadc-bc6d9526fdc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{e}^{v}}{2}" :db/id #edb/ref 17592186374088} {:answer/id #uuid "fbfe48d4-fab5-5337-a025-f32c4db8dd7f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2u{e}^{v}" :db/id #edb/ref 17592186374089}] :answer-field/correct {:db/id #edb/ref 17592186374086} :answer-field/id #uuid "9448f758-7aaf-5272-b5f6-88f1b32ee8d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186374084}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2efc4cf1-75d6-520b-94c1-d854f8fd8b64" :question/math-academy-id "q-161880" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR={(x,y,z)\\,:\\,1\\le x+y\\le 2,\\,0\\le y-x\\le 1,\\,0\\le z\\le 3}.\n$$\n\nGiven the change of variables\n\n$$\nu=x+y,\\,v=y-x,\\,w=z,\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}2(x+y){e}^{y-x}\\,dV={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{0}^{3}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=y-x,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & ={(u,v,w)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1,\\,0\\le w\\le 3}.\\end{aligned}\n$$\n\n   \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}1 & 1 \\\\ -1 & 1\\end{vmatrix} \\\\  & =1(1+1) \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}2(x+y){e}^{y-x}\\,dV & ={∭}_{Δ}2u{e}^{v}\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}2u{e}^{v}\\cdot |\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{0}^{3}\\,u{e}^{v}\\,\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "1da0db94-3628-5190-a1fe-f76eb1f4550b" :step/next {:db/id #edb/ref 17592186522892}} {:db/id #edb/ref 17592186522843 :step/content {:db/id #edb/ref 17592186522809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167c9635-d107-553c-80f2-728998f64f44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522065} {:answer/id #uuid "208798f3-1213-54c2-9110-17dc3e4b81b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡u\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522093} {:answer/id #uuid "41084583-9221-587e-a746-0339cfa254c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522161} {:answer/id #uuid "8c6d471a-064f-5e70-bfd7-077a3c169ff3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡uv\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522305} {:answer/id #uuid "f6cc9b29-5be4-54fe-8424-7c6e39a3e9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{u\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522542}] :answer-field/correct {:db/id #edb/ref 17592186522161} :answer-field/id #uuid "4072ebe9-e356-5a8b-bdd6-bdedd4bc5d7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522591}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f849acac-b165-56ce-af0c-ee1d4893cc84" :question/math-academy-id "q-39056" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le {x}^{2}-{y}^{2}\\le 2,\\,2\\le x+y\\le 4,\\,0\\le z\\le 1\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps: \n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,2\\le v\\le 4,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & -2y & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2x & -2y \\\\ 1 & 1\\end{aligned}| \\\\  & =2x+2y \\\\  & =2(x+y) \\\\  & =2v\\end{aligned}\n$$\n\n \n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$ \n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV & ={∭}_{Δ}v\\operatorname{sinh}⁡u\\cdot |\\frac{1}{2v}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{\\operatorname{sinh}⁡u}{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "5e5891c8-8277-54c3-9c11-9481ab910bf8" :step/next {:db/id #edb/ref 17592186522865}} {:db/id #edb/ref 17592186522862 :step/content {:db/id #edb/ref 17592186401302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e70215a-59ba-5fc4-8869-08fd079debf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401304} {:answer/id #uuid "2e6baa46-2362-5360-8c5f-7031d62e1411" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{cos}^{2}⁡v\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401305} {:answer/id #uuid "7adad8b8-d3ef-52ef-b487-e4018ac1507b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}{cos}^{2}⁡(u-v)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401306} {:answer/id #uuid "06bed278-63d1-5662-b5c3-13bc65e1ffc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}{cos}^{2}⁡(u)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401307} {:answer/id #uuid "03678aa6-e1ae-5bec-8d2a-faf8e1de8ec2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}{cos}^{2}⁡(uv)\\operatorname{cos}⁡v-u" :db/id #edb/ref 17592186401308}] :answer-field/correct {:db/id #edb/ref 17592186401304} :answer-field/id #uuid "6b627816-1293-53a9-a8e8-93bf2fb0fcef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186401303}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4004275e-59e4-54d2-bbaa-29203ac29308" :question/math-academy-id "q-161879" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x+3y\\le \\frac{\\pi }{2},\\,0\\le z-3y\\le \\frac{\\pi }{2},\\,0\\le z\\le 2}.\n$$\n\nGiven the change of variables\n\n$$\nu=x+3y,\\,v=z-3y,\\,w=z,\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}{cos}^{2}⁡(x+z)\\operatorname{cos}⁡(z-3y)\\,dV={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+3y,\\,v=z-3y,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}\\to \\begin{bmatrix}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{bmatrix}.\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & ={(x,y,z)\\,:\\,0\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le \\frac{\\pi }{2},\\,0\\le w\\le 2}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{vmatrix} \\\\  & =\\begin{vmatrix}1 & 3 & 0 \\\\ 0 & -3 & 1 \\\\ 0 & 0 & 1\\end{vmatrix} \\\\  & =1\\begin{vmatrix}-3 & 1 \\\\ 0 & 1\\end{vmatrix} \\\\  & =1(-3-0) \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}{cos}^{2}⁡(x+z)\\operatorname{cos}⁡(z-3y)\\,dV & ={∭}_{Δ}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\cdot |-\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}\\,\\frac{1}{3}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\,\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "9415b5d7-f308-5c17-9e90-f8ba5c185823" :step/next {:db/id #edb/ref 17592186522824}} {:db/id #edb/ref 17592186522865 :step/content {:db/id #edb/ref 17592186522753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f1a2079-1fc1-5955-bbfb-db810024db1a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{u}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522088} {:answer/id #uuid "7e097b3d-1787-51eb-8d0e-f6ddc058f730" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{u}{\\int }_{1}^{2}\\frac{{e}^{w}}{v}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522267} {:answer/id #uuid "9096297c-682f-58dc-8315-adc51907dab4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{v}{\\int }_{1}^{2}\\frac{{e}^{w}}{v}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522314} {:answer/id #uuid "942264b3-d374-50be-87f0-6ee36149aa06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522323} {:answer/id #uuid "b31ba118-b4ec-54ec-bb50-628c0cc67dda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}uv{e}^{w}\\,dw\\,dv\\,du" :db/id #edb/ref 17592186522386}] :answer-field/correct {:db/id #edb/ref 17592186522323} :answer-field/id #uuid "fd889248-045c-5336-9e14-01871b41eb76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522688}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a7a1582-d778-5af4-af63-1b6090d14c6e" :question/math-academy-id "q-39062" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x\\le 2,\\,\\frac{1}{x}\\le y\\le \\frac{2}{x},\\,\\frac{1}{xy}\\le z\\le \\frac{2}{xy}\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu=x,\\,v=xy,\\,w=xyz,\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}\\,{e}^{xyz}\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu=x,\\,v=xy,\\,w=xyz\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is \n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,1\\le w\\le 2\\}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 & 0 \\\\ y & x & 0 \\\\ yz & xz & xy\\end{aligned}| \\\\  & =xy|\\begin{aligned}1 & 0 \\\\ y & x\\end{aligned}| \\\\  & =xy(x-0) \\\\  & ={x}^{2}y \\\\  & =uv\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{uv}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}{e}^{xyz}\\,dV & ={∭}_{Δ}{e}^{w}\\cdot |\\frac{1}{uv}|\\,\\,dw\\,dv\\,du \\\\  & ={∭}_{Δ}\\frac{{e}^{w}}{uv}\\,\\,dw\\,dv\\,du \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du\\end{aligned}\n$$"} :step/id #uuid "a536b006-715c-59a4-84d0-400b886bdd56" :step/next {:db/id #edb/ref 17592186522862}} {:db/id #edb/ref 17592186522892 :step/content {:db/id #edb/ref 17592186522780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbc4c08-f008-5e72-b85a-8f2b4179ee34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186522152} {:answer/id #uuid "4cfefb36-0c70-50b6-aa6a-4945530149e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186522185} {:answer/id #uuid "97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186522330} {:answer/id #uuid "c921974f-fc45-5558-acc3-f2310130ec21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186522438} {:answer/id #uuid "ec8b09ec-156b-5830-8ce7-eac0fbd892c6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186522524}] :answer-field/correct {:db/id #edb/ref 17592186522330} :answer-field/id #uuid "e00110c2-7288-57e8-9508-75b52e302e96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186522666}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c40cfd48-e992-514e-93b1-f5d1aa09838d" :question/math-academy-id "q-162128" :question/problem "Use the change of variables \n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\nto evaluate the triple integral\n\n$$\n{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV,\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,\\frac{1}{\\pi }\\le 2x+y\\le \\frac{2}{\\pi },\\,\\,0\\le 3x+2z\\le 1,\\,\\,0\\le z\\le 2\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,\\frac{1}{\\pi }\\le u\\le \\frac{2}{\\pi },\\,0\\le v\\le 1,\\,0\\le w\\le 2\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 0 \\\\ 3 & 0 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}| \\\\  & =0-3 \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV & ={∭}_{Δ}\\frac{12}{1+{v}^{2}}\\cdot |-\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{4}{(1+{v}^{2})}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }{\\int }_{0}^{1}{\\int }_{0}^{2}\\frac{4}{(1+{v}^{2})}\\,dw\\,dv\\,du \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }\\,du\\cdot {\\int }_{0}^{1}\\frac{4}{(1+{v}^{2})}\\,dv\\cdot {\\int }_{0}^{2}dw \\\\  & =[u]_{1/\\pi }^{2/\\pi }\\cdot {[4\\operatorname{arctan}⁡v]}_{v=0}^{v=1}\\cdot [w]_{w=0}^{w=2} \\\\  & =(\\frac{2}{\\pi }-\\frac{1}{\\pi })\\cdot (4\\cdot \\frac{\\pi }{4}-0)\\cdot (2-0) \\\\  & =2\\end{aligned}\n$$"} :step/id #uuid "efac3413-9dbb-5cde-aece-e1eded4d33e5"}] :activity/title "Computing Triple Integrals Using a Change of Variables" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186522005}]}
