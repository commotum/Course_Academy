      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14250891/observations/step-q337102-06d6c49f96c8e2dd6fa6.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14250891/observations/step-q337102-06d6c49f96c8e2dd6fa6.png",
