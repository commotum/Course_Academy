      "html_path": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14250891/observations/step-q329817-4124fe894e6916ebaaf5.html",
      "screenshot": "/home/jake/Developer/Course_Academy/reference/mathacademy/capture/multivariable/14250891/observations/step-q329817-4124fe894e6916ebaaf5.png",
      "source_url": "https://mathacademy.com/tasks/14250891/topics/3187/review",
