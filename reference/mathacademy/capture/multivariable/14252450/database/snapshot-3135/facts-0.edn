-ddb970802b55" #edb/ref 17592186045417] [17592186184516 #edb/ref 1068 #edb/ref 17592186274932 #edb/ref 17592186045417] [17592186184516 #edb/ref 1069 "q-149955" #edb/ref 17592186045417] [17592186184516 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186184516 #edb/ref 1071 "What is the value of ${lim}_{x\\to \\,-\\infty }\\operatorname{arcsin}⁡(2x-1)?$" #edb/ref 17592186045417] [17592186184516 #edb/ref 1072 #uuid "81deaa75-bb15-5048-ab19-c54290c068b0" #edb/ref 17592186045417] [17592186184516 #edb/ref 1074 "First, let's sketch the graph of $y=\\operatorname{arcsin}⁡(2x-1):$\n\n![](images/9e/9e2e705cf17a5dca362c23a23e4d10067ff4390a3f9464dddb6745d78986c02a.png)\n\nThe domain of $\\operatorname{arcsin}⁡(2x-1)$ is $x\\in [0,1].$ This means that $\\operatorname{arcsin}⁡(2x-1)$ is undefined outside this interval.\n\nTherefore, ${lim}_{x\\to \\,-\\infty }\\operatorname{arcsin}⁡(2x-1)$ is undefined." #edb/ref 17592186045417] [17592186185041 #edb/ref 1058 #edb/ref 17592186185052 #edb/ref 17592186045417] [17592186185041 #edb/ref 1061 39810 #edb/ref 17592186045417] [17592186185041 #edb/ref 1062 #uuid "003ba853-1e82-584c-b1f2-becf3ff9c30c" #edb/ref 17592186045417] [17592186185041 #edb/ref 1063 #edb/ref 17592186185359 #edb/ref 17592186045417] [17592186185042 #edb/ref 1058 #edb/ref 17592186185044 #edb/ref 17592186045417] [17592186185042 #edb/ref 1061 39811 #edb/ref 17592186045417] [17592186185042 #edb/ref 1062 #uuid "e4ed7c3e-7162-558c-a918-39f63652e0c0" #edb/ref 17592186045417] [17592186185042 #edb/ref 1063 #edb/ref 17592186184238 #edb/ref 17592186045417] [17592186185043 #edb/ref 1058 #edb/ref 17592186185045 #edb/ref 17592186045417] [17592186185043 #edb/ref 1061 39814 #edb/ref 17592186045417] [17592186185043 #edb/ref 1062 #uuid "9666a609-3291-5b2c-a5f1-4c905924ddd1" #edb/ref 17592186045417] [17592186185043 #edb/ref 1063 #edb/ref 17592186184239 #edb/ref 17592186045417] [17592186185044 #edb/ref 1058 #edb/ref 17592186185043 #edb/ref 17592186045417] [17592186185044 #edb/ref 1061 39815 #edb/ref 17592186045417] [17592186185044 #edb/ref 1062 #uuid "66882814-9d8d-500a-b199-d60870f60cec" #edb/ref 17592186045417] [17592186185044 #edb/ref 1063 #edb/ref 17592186185360 #edb/ref 17592186045417] [17592186185045 #edb/ref 1061 39823 #edb/ref 17592186045417] [17592186185045 #edb/ref 1062 #uuid "f8205256-4d92-59b5-babd-ec4ae58b06b8" #edb/ref 17592186045417] [17592186185045 #edb/ref 1063 #edb/ref 17592186184240 #edb/ref 17592186045417] [17592186185051 #edb/ref 1058 #edb/ref 17592186185042 #edb/ref 17592186045417] [17592186185051 #edb/ref 1061 40843 #edb/ref 17592186045417] [17592186185051 #edb/ref 1062 #uuid "338537ec-9b29-534a-bc92-7f0375a54a6d" #edb/ref 17592186045417] [17592186185051 #edb/ref 1063 #edb/ref 17592186185362 #edb/ref 17592186045417] [17592186185052 #edb/ref 1058 #edb/ref 17592186185051 #edb/ref 17592186045417] [17592186185052 #edb/ref 1061 40844 #edb/ref 17592186045417] [17592186185052 #edb/ref 1062 #uuid "13c5d606-b95e-5a64-ba04-2a68fbf50e14" #edb/ref 17592186045417] [17592186185052 #edb/ref 1063 #edb/ref 17592186185363 #edb/ref 17592186045417] [17592186185359 #edb/ref 1064 "In this lesson, we will learn how to deal with limits involving inverse trigonometric functions. \n\nLet's begin by recalling the graph of $y=\\arcsin(x).$\n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nUsing the graph, we note the following:\n\n- The domain of $\\arcsin(x)$ is $x \\in [-1,1].$\n\n- For every value $a \\in (-1,1),$ we have\n\n$$\n\\lim_\\limits{x\\to a} \\arcsin(x) = \\arcsin(a).\n$$\n\n \nIn other words, we can evaluate the limit using direct substitution. For example,\n\n$$\n\\begin{aligned}{lim}_{x\\to 1/2}\\operatorname{arcsin}⁡(x) & =\\operatorname{arcsin}⁡(\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\n- For any value $a$ that does *not* lie in the domain of $\\arcsin(x),$ the limit\n\n$$\n\\lim_\\limits{x\\to a} \\arcsin(x)\n$$\n\n \ndoes *not* exist.\n\n- At the point $x=-1,$ the limit does *not* exist because the left-sided limit does not exist. However, the right-sided limit *does* exist and is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{+}}\\operatorname{arcsin}⁡(x) & =\\operatorname{arcsin}⁡(-1) \\\\  & =-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\n- Similarly, at the point $x=1,$ the limit does *not* exist because the right-sided limit does not exist. However, the left-sided limit *does* exist and is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}\\operatorname{arcsin}⁡(x) & =\\operatorname{arcsin}⁡(1) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThe limit properties of $y=\\arccos(x)$ are similar. Let's discuss them briefly." #edb/ref 17592186045417] [17592186185359 #edb/ref 1065 6599 #edb/ref 17592186045417] [17592186185359 #edb/ref 1066 #uuid "f1bc1975-006b-5be4-ad5c-88888abb00d5" #edb/ref 17592186045417] [17592186185359 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186185360 #edb/ref 1064 "We can deduce limits at infinity of transformed inverse trigonometric functions by sketching their graphs.\n\nFor example, let's consider the following limit:\n\n$$\n\\lim_\\limits{x \\to \\, \\infty} \\dfrac{2}{\\pi}\\arctan \\left(x-\\pi\\right)\n$$\n\nTo evaluate this limit, we first sketch the graph of  $y =\\arctan \\left(x-\\pi\\right){:}$  \n\n![](images/51/51a0b9a210147b3791ce20a2f65320e20618826671ea6c7c31a27f8647595079.png)\n\nThe domain of   $\\arctan \\left(x-\\pi\\right)$ is $(-\\infty,\\infty).$   Moreover, from the graph, we see that \n\n$$\n\\lim\\limits_{x\\to \\infty} \\arctan \\left(x-\\pi\\right)=\\color{blue}{\\dfrac{\\pi}{2} }  .\n$$\n\nTherefore, by the algebra of limits, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\infty }\\frac{2}{\\pi }\\operatorname{arctan}⁡(x-\\pi ) & =\\frac{2}{\\pi }\\cdot {lim}_{x\\to \\,\\infty }\\operatorname{arctan}⁡(x-\\pi ) \\\\  & =\\frac{2}{\\pi }\\cdot (\\frac{\\pi }{2}) \\\\  & =1.\\end{aligned}\n$$\n\nLimits at infinity involving the inverse sine and cosine functions usually do not exist. Let's see an example." #edb/ref 17592186045417] [17592186185360 #edb/ref 1065 6600 #edb/ref 17592186045417] [17592186185360 #edb/ref 1066 #uuid "24cdcba9-d6c5-5719-a086-34fe417cc42f" #edb/ref 17592186045417] [17592186185360 #edb/ref 1067 "Limits of Inverse Trigonometric Function at Infinity" #edb/ref 17592186045417] [17592186185362 #edb/ref 1064 "The graph of $y=\\arctan x$ is shown below.\n\n![](images/fc/fc06a4e63f38a315dd3944f65f871cca2dbdddee26ec268e857f79e5f4ab8848.png)\n\nFrom the graph, we note the following:\n\n- The domain is $x \\in (-\\infty, \\infty).$\n\n- For every value $a,$ we have\n\n$$\n\\lim_\\limits{x\\to a} \\arctan(x) = \\arctan(a).\n$$\n\n- The limit as $x\\to-\\infty$ is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\operatorname{arctan}⁡(x) & =-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\n- The limit as $x\\to\\infty$ is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\operatorname{arctan}⁡(x) & =\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nWe can use the algebra of limits to evaluate expressions involving inverse trigonometric functions. Let's see some examples." #edb/ref 17592186045417] [17592186185362 #edb/ref 1065 6741 #edb/ref 17592186045417] [17592186185362 #edb/ref 1066 #uuid "926b00b5-d0b1-559a-9b04-c0c0636824d6" #edb/ref 17592186045417] [17592186185362 #edb/ref 1067 "Limits of Inverse Tangent" #edb/ref 17592186045417] [17592186185363 #edb/ref 1064 "Let's recall the graph of $y=\\arccos(x).$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nFrom the graph, we note the following:\n\n- The domain is $x \\in [-1,1].$\n\n- For every value $a \\in (-1,1),$ we have\n\n$$\n\\lim_\\limits{x\\to a} \\arccos(x) = \\arccos(a).\n$$\n\n- For any value $a$ that does *not* lie in the domain of $\\arccos(x),$ the limit\n\n$$\n\\lim_\\limits{x\\to a} \\arccos(x)\n$$\n\n \ndoes *not* exist.\n\n- The right-sided limit at $x=-1$ is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{+}}\\operatorname{arccos}⁡(x) & =\\operatorname{arccos}⁡(-1) \\\\  & =\\pi .\\end{aligned}\n$$\n\n- Similarly, the left-sided limit at $x=1$ is given by\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}\\operatorname{arccos}⁡(x) & =\\operatorname{arccos}⁡(1) \\\\  & =0.\\end{aligned}\n$$\n\nFinally, let's deduce the limit properties of $y = \\arctan x.$" #edb/ref 17592186045417] [17592186185363 #edb/ref 1065 6742 #edb/ref 17592186045417] [17592186185363 #edb/ref 1066 #uuid "eea2d2ac-ea9c-551a-91c6-4ee85ab05907" #edb/ref 17592186045417] [17592186185363 #edb/ref 1067 "Limits of Inverse Cosine" #edb/ref 17592186045417] [17592186272678 #edb/ref 1080 "Undefined" #edb/ref 17592186045417] [17592186272678 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186272678 #edb/ref 1083 #uuid "20d9ec78-8e28-521d-942f-9298b56ba664" #edb/ref 17592186045417] [17592186272877 #edb/ref 1080 "1" #edb/ref 17592186045417] [17592186272877 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186272877 #edb/ref 1083 #uuid "37ff1036-5a0e-58b1-9825-df07520b3d82" #edb/ref 17592186045417] [17592186273602 #edb/ref 1080 "-\\infty " #edb/ref 17592186045417] [17592186273602 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273602 #edb/ref 1083 #uuid "8cabb11a-cc05-5405-8952-4408c4076c2e" #edb/ref 17592186045417] [17592186273915 #edb/ref 1080 "\\infty " #edb/ref 17592186045417] [17592186273915 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186273915 #edb/ref 1083 #uuid "b0ac53fc-a437-5933-a0ee-8ea304f15e5d" #edb/ref 17592186045417] [17592186274520 #edb/ref 1080 "-1" #edb/ref 17592186045417] [17592186274520 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186274520 #edb/ref 1083 #uuid "f117b36f-681e-570c-bee9-72f13571afe5" #edb/ref 17592186045417] [17592186274932 #edb/ref 1075 #edb/ref 17592186272678 #edb/ref 17592186045417] [17592186274932 #edb/ref 1075 #edb/ref 17592186272877 #edb/ref 17592186045417] 