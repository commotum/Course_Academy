b36-f0e92966feb6" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186304475} {:answer-field/choices [{:answer/id #uuid "0d813493-43b7-5abc-9c6e-eebce057cbdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}-9" :db/id #edb/ref 17592186302546} {:answer/id #uuid "85c306d3-e46b-5ed9-a2ef-51b1eeedd1a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186303287} {:answer/id #uuid "dabedf8c-de8d-51ba-aae6-ea177e4aa201" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s>{s}_{0}+9" :db/id #edb/ref 17592186303816}] :answer-field/correct {:db/id #edb/ref 17592186302546} :answer-field/id #uuid "c66ea00f-ab02-54a7-8591-f30db0c5b86b" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186304618}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d4d9c5d8-fd8f-53ad-985b-edcda3948d5a" :question/math-academy-id "q-331808" :question/problem "Consider a function $d(t)$ such that its Laplace transform is $L\\{d(t)\\}=D(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{-9t}d(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{-9t}d(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,d(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{-9t}d(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-9t}\\,d(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+9)t}\\,d(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $D(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,d(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+9)t}\\,d(t)\\,\\text{d}t=D(s+9),\n$$\n\nwhere \n\n$$\ns+9>{s}_{0}\\,⇒\\,s>{s}_{0}-9.\n$$"} :step/id #uuid "d471051a-4a59-5227-9393-1b386051ee7b" :step/next {:db/id #edb/ref 17592186481696}} {:db/id #edb/ref 17592186481742 :step/content {:db/id #edb/ref 17592186402100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbeddd1b-c3dd-54cd-a00c-bfa7f8bb9029" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $9$ horizontally." :db/id #edb/ref 17592186402102} {:answer/id #uuid "20dad633-ddf9-5439-b4ea-d46bf03e30dd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $9$ units to the right." :db/id #edb/ref 17592186402103} {:answer/id #uuid "502d4257-08f1-572c-b4f7-44ca7819cd6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Shift the graph of $F(s)$ by $9$ units to the left." :db/id #edb/ref 17592186402104} {:answer/id #uuid "6d2964df-d6ec-5d47-adc1-edddefca6e19" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The Laplace transform is unchanged." :db/id #edb/ref 17592186402105} {:answer/id #uuid "e92b73b6-6083-5681-b869-7b2bec74f5ce" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Scale the graph of $F(s)$ by a scale factor of $9$ vertically." :db/id #edb/ref 17592186402106}] :answer-field/correct {:db/id #edb/ref 17592186402104} :answer-field/id #uuid "8decbbab-7268-5304-9585-788574a6793b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186402101}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f8dd5186-15e7-5cde-a17c-1b124d1cef2b" :question/math-academy-id "q-332064" :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L\\{f(t)\\}=F(s).$ How can we obtain the graph of $L\\{{e}^{-9t}f(t)\\}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L\\{f(t)\\}=F(s),$\nthen\n$L\\{{e}^{at}f(t)\\}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L\\{{e}^{-9t}f(t)\\},$ we must shift the graph of $F(s)$ by $9$ units to the left."} :step/id #uuid "e19c971d-0087-5320-ade5-7561c8259640" :step/next {:db/id #edb/ref 17592186481699}} {:db/id #edb/ref 17592186481743 :step/content {:db/id #edb/ref 17592186222044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aca0833-9adf-5c73-a1ab-d07568183f99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{(s+2)^{2}}+\\frac{2}{s-2}" :db/id #edb/ref 17592186355332} {:answer/id #uuid "8290279a-5ab8-57ac-9792-73f13640f201" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{(s+2)^{2}}+\\frac{1}{s-2}" :db/id #edb/ref 17592186355812} {:answer/id #uuid "8f0198a4-4fab-5362-bb17-7ad99d588499" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{(s+2)(s-2)^{2}}" :db/id #edb/ref 17592186355926} {:answer/id #uuid "91c23727-f24d-5c74-bf75-ea326ecfa263" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{(s+2)^{2}(s-2)}" :db/id #edb/ref 17592186355953} {:answer/id #uuid "d05463d4-fa4b-567c-9712-d946fd6321f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{s+2}+\\frac{2}{(s-2)^{2}}" :db/id #edb/ref 17592186356485}] :answer-field/correct {:db/id #edb/ref 17592186356485} :answer-field/id #uuid "1e1a231c-22ee-57a9-969d-ae5213d3dae3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186356969}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94d7e94a-1d17-5470-a293-1353d69fb49f" :question/math-academy-id "q-89592" :question/problem "Given that\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)={e}^{-2t}+2t{e}^{2t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{{e}^{-2t}+2t{e}^{2t}\\} \\\\  & =L\\{{e}^{-2t}\\}+L\\{2t{e}^{2t}\\} \\\\  & =L\\{{e}^{-2t}\\}+2L\\{t{e}^{2t}\\}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L\\{{t}^{n}\\} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L\\{t\\} & =\\frac{1}{{s}^{2}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L\\{f(t)\\}=F(s),$ then $L\\{{e}^{at}f(t)\\}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L\\{t{e}^{2t}\\} & =\\frac{1}{(s-2)^{2}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L\\{f(t)\\} & =L\\{{e}^{-2t}\\}+2L\\{t{e}^{2t}\\} \\\\  & =\\frac{1}{s+2}+2\\cdot \\frac{1}{(s-2)^{2}} \\\\  & =\\frac{1}{s+2}+\\frac{2}{(s-2)^{2}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$"} :step/id #uuid "eb252da1-42be-5946-a2d3-d509b332da4e" :step/next {:db/id #edb/ref 17592186481735}}] :activity/title "The First Shifting Theorem of Laplace Transforms" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186481570}]}
