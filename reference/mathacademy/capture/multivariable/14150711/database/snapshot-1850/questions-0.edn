#{[{:db/id #edb/ref 17592186476890 :knowledge-point/_questions [{:db/id #edb/ref 17592186166887 :knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf064ce-c159-595c-8864-65435884c010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9185" :db/id #edb/ref 17592186476261} {:answer/id #uuid "760f7951-d885-5ba9-872c-a2c135eaf8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0005" :db/id #edb/ref 17592186476468} {:answer/id #uuid "7bb1c4e2-84a1-57b0-97fe-9fca070b3e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.3281" :db/id #edb/ref 17592186476477} {:answer/id #uuid "a519c917-a3eb-5164-ab3c-8bf07e204fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.4095" :db/id #edb/ref 17592186476564} {:answer/id #uuid "b03f57d9-1d84-5268-90cc-111f6b4e6a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9914" :db/id #edb/ref 17592186476596}] :answer-field/correct {:answer/id #uuid "1bf064ce-c159-595c-8864-65435884c010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.9185" :db/id #edb/ref 17592186476261} :answer-field/id #uuid "61f796ce-0f6b-55fd-91c6-7aff5f0205ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476794}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4157f375-bd26-529e-b418-be6228478f9b" :question/math-academy-id "q-129856" :question/problem "Given that $X∼B(5,0.1),$ compute $P(X\\le 1).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,0.1),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x})(0.1)^{x}(0.9)^{5-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 1) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0})(0.1)^{0}(0.9)^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1})(0.1)^{1}(0.9)^{5-1} \\\\  & =1(0.1)^{0}(0.9)^{5}+5(0.1)(0.9)^{4} \\\\  & ≈0.9185\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186265793 :knowledge-point/_questions [{:db/id #edb/ref 17592186166887 :knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4879d9-6205-5c3e-94e2-345d32f9bb65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186263124} {:answer/id #uuid "1fb4e03d-474f-5887-8f27-c908a061ad15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186263291} {:answer/id #uuid "4ba2368b-f5a3-5378-8bc6-6b7ddf0dd2f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{243}" :db/id #edb/ref 17592186263652} {:answer/id #uuid "66ad7f63-b3d8-5c17-bd92-a48eb9d8c999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186263888} {:answer/id #uuid "d85db2a7-c7b1-56c0-8c12-5c87f1f638ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{81}" :db/id #edb/ref 17592186264887}] :answer-field/correct {:answer/id #uuid "1fb4e03d-474f-5887-8f27-c908a061ad15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186263291} :answer-field/id #uuid "f3af6c4a-5163-5b84-8a2a-a422d73546a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68512d61-c123-5b4f-bd6e-2abe384cfbfb" :question/math-academy-id "q-129971" :question/problem "Given that $X∼B(4,\\frac{1}{3}),$ compute $P(X<3).$" :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(4,\\frac{1}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){(\\frac{1}{3})}^{x}{(\\frac{2}{3})}^{4-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{0,1,2\\}) \\\\  & =f(0)+f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{4}{0}){(\\frac{1}{3})}^{0}{(\\frac{2}{3})}^{4-0}+(\\genfrac{}{}{0pt}{}{4}{1}){(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{4-1}+(\\genfrac{}{}{0pt}{}{4}{2}){(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{4-2} \\\\  & =1{(\\frac{1}{3})}^{0}{(\\frac{2}{3})}^{4}+4{(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{3}+6{(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{2} \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186476887 :knowledge-point/_questions [{:db/id #edb/ref 17592186166888 :knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042255ab-25dc-5829-9b81-a1aefaa90134" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.288" :db/id #edb/ref 17592186476210} {:answer/id #uuid "23740136-a3d1-5c0a-ac92-73fd64ee82cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.28" :db/id #edb/ref 17592186476285} {:answer/id #uuid "767fd8a8-2ccf-5174-b7e4-83be8f16a837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.648" :db/id #edb/ref 17592186476469} {:answer/id #uuid "c161a87d-343b-5ed4-8b40-cf09ae4b20a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.432" :db/id #edb/ref 17592186476639} {:answer/id #uuid "c4c89732-c888-5fcf-a696-6ea0995cc62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186476646}] :answer-field/correct {:answer/id #uuid "c4c89732-c888-5fcf-a696-6ea0995cc62f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186476646} :answer-field/id #uuid "32f5da6a-13af-5c80-9201-ff83ea80e457" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186476780}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38967822-7f15-5d1e-ac8e-75e5d9abdd66" :question/math-academy-id "q-129978" :question/problem "Given $X∼B(3,0.4),$ compute $P(0<X\\le 2).$" :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(3,0.4),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{3}{x})(0.4)^{x}(0.6)^{3-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(0<X\\le 2) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{3}{1})(0.4)^{1}(0.6)^{3-1}+(\\genfrac{}{}{0pt}{}{3}{2})(0.4)^{2}(0.6)^{3-2} \\\\  & =3(0.4)^{1}(0.6)^{2}+3(0.4)^{2}(0.6)^{1} \\\\  & =0.72.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295114 :knowledge-point/_questions [{:db/id #edb/ref 17592186166889 :knowledge-point/id #uuid "b4844e17-9365-5a6f-a5f4-b9fa83fd81e1" :knowledge-point/title "Computing a Probability Over an Interval Using the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1882e22f-edeb-58a1-a73e-a5b295cb9ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.114" :db/id #edb/ref 17592186293030}] :answer-field/correct {:answer/id #uuid "1882e22f-edeb-58a1-a73e-a5b295cb9ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.114" :db/id #edb/ref 17592186293030} :answer-field/id #uuid "3ee4bd34-7a14-524f-aa57-4ed60dbfe284" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294147}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "974e2ad3-54a9-51be-bbda-c3b480d74b8b" :question/math-academy-id "q-279981" :question/problem "If $X∼B(6,0.9),$ then, **rounded to $3$ decimal places**, $P(X<5)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.9),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.9)^{x}(0.1)^{6-x}.\n$$\n\nComputing $P(X<5)$ will require us to compute $f(x)$ at $x=0,1,2,3,4.$ However, if we compute the complement $P(X\\ge 5)$ instead, then we will only have to compute $f(x)$ at $x=5,6,$ which will result in a much faster computation.\n\nComputing $P(X\\ge 5),$ we get\n\n$$\n\\begin{aligned}P(X\\ge 5) & =P(X\\in \\{5,6\\}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{5})(0.9)^{5}(0.1)^{6-5}+(\\genfrac{}{}{0pt}{}{6}{6})(0.9)^{6}(0.1)^{6-6} \\\\  & =6(0.9)^{5}(0.1)+(0.9)^{6} \\\\  & ≈0.886\\end{aligned}\n$$\n\nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X<5) & =1-P(X\\ge 5) \\\\  & ≈1-0.886 \\\\  & ≈0.114\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186476891 :knowledge-point/_questions [{:db/id #edb/ref 17592186166889 :knowledge-point/id #uuid "b4844e17-9365-5a6f-a5f4-b9fa83fd81e1" :knowledge-point/title "Computing a Probability Over an Interval Using the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5e4cd73-1696-50ba-b7e2-b37f2c770158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.984" :db/id #edb/ref 17592186476683}] :answer-field/correct {:answer/id #uuid "d5e4cd73-1696-50ba-b7e2-b37f2c770158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.984" :db/id #edb/ref 17592186476683} :answer-field/id #uuid "a4978f40-bebd-578d-85cc-869a73ccc7d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186476831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44a2778d-cb26-5214-93cd-d8b54ec0c296" :question/math-academy-id "q-286839" :question/problem "If $X∼B(5,\\frac{3}{4}),$  then, **rounded to $3$ decimal places**, $P(X\\ge 2)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(5,\\frac{3}{4}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{5}{x}){(\\frac{3}{4})}^{x}{(\\frac{1}{4})}^{5-x}.\n$$\n\nComputing $P(X\\ge 2)$ will require us to compute $f(x)$ at $x=2,3,4,5.$ However, if we compute the complement $P(X<2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,$ which will result in a much faster computation.\n\nComputing $P(X<2),$ we get\n\n$$\n\\begin{aligned}P(X<2) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{5}{0}){(\\frac{3}{4})}^{0}{(\\frac{1}{4})}^{5-0}+(\\genfrac{}{}{0pt}{}{5}{1}){(\\frac{3}{4})}^{1}{(\\frac{1}{4})}^{5-1} \\\\  & =1{(\\frac{3}{4})}^{0}{(\\frac{1}{4})}^{5}+5{(\\frac{3}{4})}^{1}{(\\frac{1}{4})}^{4} \\\\  & ≈0.016\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =1-P(X<2) \\\\  & ≈1-0.016 \\\\  & =0.984\\end{aligned}\n$$\n\nrounded to $3$ decimal places."}]}
