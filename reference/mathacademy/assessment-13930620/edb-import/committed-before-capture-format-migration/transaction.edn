[{:db/id "q-82938/selection/306e4ba4669d817aff8c0d5031e820def0e9e7943b961532aff2c0ea859a5331" :answer/id #uuid "c2ff1f9f-a136-5022-82e0-ed599d3d8865" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-2.png" :db/ensure [:answer/validate]} {:db/id "q-82938/selection/ea8ab16abc0728e9561bc25d999f13755f4fe1131a79549aa579c7ab8f352d7b" :answer/id #uuid "b7078933-d8af-5ff6-91a3-c345bcfa9afc" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-3.png" :db/ensure [:answer/validate]} {:db/id "q-82938/selection/4ece8a803c3f458f7c138c98515f950681354443b4a31613c2a29d24dad27588" :answer/id #uuid "5fd557be-a3db-5b00-ba31-e199cad38f9f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-1.png" :db/ensure [:answer/validate]} {:db/id "q-82938/selection/a954f77b6142c9c897b91456f9adc7d754891d2b19a7f3d1a55311e109678b8e" :answer/id #uuid "c906ae27-b4a6-577f-a9a1-f4e606d325fb" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-4.png" :db/ensure [:answer/validate]} {:db/id "q-82938/selection/5fdad06c8449d5919e4a5b7114565ad7fb35179cf24159e7c94c903857ea718f" :answer/id #uuid "9129d971-de3e-53ad-ba29-f6537cd39e23" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-5.png" :db/ensure [:answer/validate]} {:db/id "q-82938/selection" :answer-field/id #uuid "b93523a3-0a58-5ba2-9618-0b6eda673103" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82938/selection/4ece8a803c3f458f7c138c98515f950681354443b4a31613c2a29d24dad27588" :answer-field/choices ["q-82938/selection/306e4ba4669d817aff8c0d5031e820def0e9e7943b961532aff2c0ea859a5331" "q-82938/selection/ea8ab16abc0728e9561bc25d999f13755f4fe1131a79549aa579c7ab8f352d7b" "q-82938/selection/4ece8a803c3f458f7c138c98515f950681354443b4a31613c2a29d24dad27588" "q-82938/selection/a954f77b6142c9c897b91456f9adc7d754891d2b19a7f3d1a55311e109678b8e" "q-82938/selection/5fdad06c8449d5919e4a5b7114565ad7fb35179cf24159e7c94c903857ea718f"] :db/ensure [:answer-field/validate]} {:db/id "q-82938" :question/id #uuid "6116f5ea-2ce3-56bf-80e5-593c2a7aeab6" :question/math-academy-id "q-82938" :question/is-example false :question/problem "Which of the following diagrams shows a unit circle in the coordinate plane with a central angle of $-{53}^{\\circ }$ in the standard position?" :question/worked-solution "Recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n\n- An angle in the standard position has its initial side on the positive $x$-axis, its vertex is at the origin.\n\n- It rotates such that a positive angle is measured counter-clockwise, and a negative angle is measured clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-82938-a-1.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-82938/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8594bbfe-b098-5aad-9b9e-29997798c73b"] :knowledge-point/questions ["q-82938"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41570/selection/c773696c520abf5bc1edecc443e83278eec8b0868856616de5e7b6053fbfbd87" :answer/id #uuid "18d35cd2-123c-544a-8765-260ef74a7b42" :answer/type :answer.type/math :answer/value "\\frac{8a+3}{a-7}" :db/ensure [:answer/validate]} {:db/id "q-41570/selection/394ba05cc110664e99babbe858e401a97d2547587160438283c9363b2695fe01" :answer/id #uuid "63dcfe6a-62a8-5e44-af92-920d65146c97" :answer/type :answer.type/math :answer/value "\\frac{2a-7}{a-7}" :db/ensure [:answer/validate]} {:db/id "q-41570/selection/126041b719a73331345be8fd0856021ce1fbda4e11f8e60804cb11ac5826b553" :answer/id #uuid "8ad55c21-9223-5a4b-ac5d-5130e8248d20" :answer/type :answer.type/math :answer/value "\\frac{8a-7}{a-7}" :db/ensure [:answer/validate]} {:db/id "q-41570/selection/90a166d56dd9279771848720155d8d56a54fea306d18b602617c206d8444af2a" :answer/id #uuid "fca1bd70-4f9f-5c21-a999-6e7d7b1a4c44" :answer/type :answer.type/math :answer/value "\\frac{8a+7}{a-7}" :db/ensure [:answer/validate]} {:db/id "q-41570/selection/f38765d05f5e7ac41f45fb1f4d131491a0366d2e1864023c5ff875b0087de558" :answer/id #uuid "f356baed-6fb4-5c7e-ad77-3beb19dc5ac6" :answer/type :answer.type/math :answer/value "\\frac{2a+3}{a-7}" :db/ensure [:answer/validate]} {:db/id "q-41570/selection" :answer-field/id #uuid "8d2200f0-f3d6-5626-aef5-3afff9c0de6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41570/selection/c773696c520abf5bc1edecc443e83278eec8b0868856616de5e7b6053fbfbd87" :answer-field/choices ["q-41570/selection/c773696c520abf5bc1edecc443e83278eec8b0868856616de5e7b6053fbfbd87" "q-41570/selection/394ba05cc110664e99babbe858e401a97d2547587160438283c9363b2695fe01" "q-41570/selection/126041b719a73331345be8fd0856021ce1fbda4e11f8e60804cb11ac5826b553" "q-41570/selection/90a166d56dd9279771848720155d8d56a54fea306d18b602617c206d8444af2a" "q-41570/selection/f38765d05f5e7ac41f45fb1f4d131491a0366d2e1864023c5ff875b0087de558"] :db/ensure [:answer-field/validate]} {:db/id "q-41570" :question/id #uuid "b9db0d51-60e0-519e-a859-b977ba7429f8" :question/math-academy-id "q-41570" :question/is-example false :question/problem "Simplify $\\frac{5a-2}{a-7}-\\frac{3a+5}{7-a}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $a-7$ if we multiply the top and bottom of the second fraction by $-1:$\n\n$$\n\\begin{aligned}\\frac{5a-2}{a-7}-\\frac{3a+5}{7-a} & = \\\\ \\frac{5a-2}{a-7}-\\frac{(-1)}{(-1)}\\cdot \\frac{3a+5}{7-a} & = \\\\ \\frac{5a-2}{a-7}+\\frac{3a+5}{a-7} & = \\\\ \\frac{(5a-2)+(3a+5)}{a-7} & = \\\\ \\frac{5a-2+3a+5}{a-7} & = \\\\ \\frac{8a+3}{a-7} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-41570/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31"] :knowledge-point/questions ["q-41570"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98107/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "a855376f-8ea0-5de5-aea5-40355f06d321" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-98107/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "f727672d-cda5-5acc-bca1-c2a127efe835" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-98107/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1ef4b72e-ebae-5a1c-8a0f-e24e74a4d06e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-98107/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "6ec9e72c-bd7f-579f-9238-8206476d7f30" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-98107/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "3d63294b-af29-5c27-a5fa-08a981e72a78" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-98107/selection" :answer-field/id #uuid "893b87d9-d065-5777-84a8-1b32df3a7c6c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98107/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-98107/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-98107/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-98107/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-98107/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-98107/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-98107" :question/id #uuid "603b28ad-abe0-56b9-9792-0364b2d44663" :question/math-academy-id "q-98107" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-98107.png)\n\nWhat is the length of $\\overset{―}{PQ}$ in the diagram above?" :question/worked-solution "The length of $\\overset{―}{PQ}$ is equal to the distance between $P$ and $Q.$\n\nThe distance $d$ between two points $P({x}_{1},{y}_{1},{z}_{1})$ and $Q({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nSince $P$ and $Q$ have coordinates ${{(-2,\\,-3,\\,-1)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(2,1,1)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}},$ respectively, we have\n\n$$\n\\begin{aligned}PQ & =\\sqrt{(2-(-2){)}^{2}+(1-(-3){)}^{2}+(1-(-1){)}^{2}} \\\\  & =\\sqrt{{4}^{2}+{4}^{2}+{2}^{2}} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98107/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f88bd4db-8477-5822-9cda-a608e78039e5"] :knowledge-point/questions ["q-98107"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288831/field-1/a8ba4798dc94d63db69be43e725233f0f5332b78500b87eef01ad050ab128919" :answer/id #uuid "5741475c-487a-5222-9fcb-362425da2dad" :answer/type :answer.type/math :answer/value "7x^2-63x+105" :db/ensure [:answer/validate]} {:db/id "q-288831/field-1" :answer-field/id #uuid "0a098b23-9d0e-5164-984c-50233969cbd7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288831/field-1/a8ba4798dc94d63db69be43e725233f0f5332b78500b87eef01ad050ab128919" :answer-field/choices ["q-288831/field-1/a8ba4798dc94d63db69be43e725233f0f5332b78500b87eef01ad050ab128919"] :db/ensure [:answer-field/validate]} {:db/id "q-288831" :question/id #uuid "ac82d650-d498-5c2d-b6c5-f429a5e6935c" :question/math-academy-id "q-288831" :question/is-example false :question/problem "The quadratic coefficient of a particular quadratic equation equals $7.$ The sum of the solutions equals $9,$ and the product of the solutions equals $15.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $7.$ Therefore, we have\n\n$$\na=7.\n$$\n\n- We're told that the sum of the roots equals $9.$ Therefore, we have\n\n$$\n\\begin{aligned}9 & =-\\frac{b}{a} \\\\ 9 & =-\\frac{b}{7} \\\\ -63 & =b \\\\ b & =-63.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $15.$ Therefore, we have\n\n$$\n\\begin{aligned}15 & =\\frac{c}{a} \\\\ 15 & =\\frac{c}{7} \\\\ 105 & =c \\\\ c & =105.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=7,\\,b=-63,\\,c=105\n$$\n\nand the equation is\n\n$$\n7{x}^{2}-63x+105=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288831/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3"] :knowledge-point/questions ["q-288831"] :db/ensure [:knowledge-point/validate]} {:db/id "q-323219/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "6b96f9dd-34fd-544e-bb7f-e0f24b713bf0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-323219/field-1" :answer-field/id #uuid "fbdd7886-766c-568e-92c6-936e08ae1370" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323219/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-323219/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-323219" :question/id #uuid "fa1a6f51-b1cf-50d7-b101-ca935fbe5b81" :question/math-academy-id "q-323219" :question/is-example false :question/problem "According to the rational root theorem, the polynomial $f(x)=-23{x}^{4}+6{x}^{3}-8x+23$ has{{field-1}} *potential* rational roots." :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $23,$ and its factors are $\\pm 1$ and $\\pm 23.$\n\n- The leading coefficient is $-23,$ and its factors are $\\pm 1$ and $\\pm 23.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{23}, \\\\ \\pm \\frac{23}{1}, & \\pm \\frac{23}{23}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{23}, \\\\ \\pm 23, & \\pm 1.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{23},\\,\\pm 1,\\,\\pm 23.\n$$\n\nThis makes a total of $6$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 3=6.$)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-323219/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a"] :knowledge-point/questions ["q-323219"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74721/selection/390a057aab4ff928869e287dd27def5e0b317f10b84e391f0a09bc7e70ff74fb" :answer/id #uuid "c2055bb3-cf46-5d8a-b8ca-46cac2194590" :answer/type :answer.type/math :answer/value "0.42" :db/ensure [:answer/validate]} {:db/id "q-74721/selection/4c3d4c84303d90b2e4e4a90b672feaef6340aafb15915302d816bafce1e14de0" :answer/id #uuid "f35f225f-00ba-5e03-ad2e-ae5b4f6dedca" :answer/type :answer.type/math :answer/value "4.02" :db/ensure [:answer/validate]} {:db/id "q-74721/selection/8474d5eec42901986cc9242ae1174d377e87e7f18c1faadb9f61108ca8d5a604" :answer/id #uuid "b2aa1a1e-e67d-52ef-a1d2-b0d082fb9bcd" :answer/type :answer.type/math :answer/value "2.04" :db/ensure [:answer/validate]} {:db/id "q-74721/selection/1622dd6d278dd7ab394e36598becb9d622279094ff64112b4a110af4740463a0" :answer/id #uuid "a297a75a-733b-5dba-b974-9ef20f006e25" :answer/type :answer.type/math :answer/value "2.40" :db/ensure [:answer/validate]} {:db/id "q-74721/selection/4df7ffa4b6e78ad68e9a59afd7ce50c0d2e4a2f9ded1b3036d161281a4e84cbb" :answer/id #uuid "eccba0b4-a6a4-5015-9447-37e5af0060fa" :answer/type :answer.type/math :answer/value "4.20" :db/ensure [:answer/validate]} {:db/id "q-74721/selection" :answer-field/id #uuid "810e2725-192f-548b-ab0c-fb0a56f98ad5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74721/selection/4c3d4c84303d90b2e4e4a90b672feaef6340aafb15915302d816bafce1e14de0" :answer-field/choices ["q-74721/selection/390a057aab4ff928869e287dd27def5e0b317f10b84e391f0a09bc7e70ff74fb" "q-74721/selection/4c3d4c84303d90b2e4e4a90b672feaef6340aafb15915302d816bafce1e14de0" "q-74721/selection/8474d5eec42901986cc9242ae1174d377e87e7f18c1faadb9f61108ca8d5a604" "q-74721/selection/1622dd6d278dd7ab394e36598becb9d622279094ff64112b4a110af4740463a0" "q-74721/selection/4df7ffa4b6e78ad68e9a59afd7ce50c0d2e4a2f9ded1b3036d161281a4e84cbb"] :db/ensure [:answer-field/validate]} {:db/id "q-74721" :question/id #uuid "7b9c4974-b912-58ae-8763-c4d9a8b6f790" :question/math-academy-id "q-74721" :question/is-example false :question/problem "Find, in radians to two decimal places, the argument of $z=-5-6\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/assessment-13930620/assets/q-74721-e-0.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <arg(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =arctan(\\frac{6}{5})\\approx 0.876\\,06.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =arg(z)\\approx \\pi +0.876\\,06\\approx 4.02\n$$\n\nto two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74721/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a560db4d-e9d3-5d89-b2cd-c886f32db9df"] :knowledge-point/questions ["q-74721"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66438"] :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n3{x}^{2}-6x+4=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=3,\\,b=-6,$ and $c=4.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-6)\\pm \\sqrt{(-6{)}^{2}-4(3)(4)}}{2(3)} \\\\  & =\\frac{6\\pm \\sqrt{36-48}}{6} \\\\  & =\\frac{6\\pm \\sqrt{-12}}{6} \\\\  & =\\frac{6\\pm 2\\sqrt{-3}}{6} \\\\  & =\\frac{6\\pm 2\\sqrt{3}\\,\\text{i}}{6} \\\\  & =1\\pm \\frac{\\sqrt{3}}{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+\\frac{\\sqrt{3}}{3}\\,\\text{i}$ and $x=1-\\frac{\\sqrt{3}}{3}\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-148499/selection/a8f5cae9811ede18fc21cc4e3cd80a7ac1922309c0499ce7c5b4d00953fb853c" :answer/id #uuid "593c60d5-c90c-5383-8421-33b53b130d16" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{3x+4}{x-1}" :db/ensure [:answer/validate]} {:db/id "q-148499/selection/28c79cad2a2c81ebfc5159967a2bb9c4e483baba0859bea95d2f905918c7caf3" :answer/id #uuid "ebee1fca-7700-5f76-84e3-76f02471e513" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{4x+3}{x-1}" :db/ensure [:answer/validate]} {:db/id "q-148499/selection/80f5ba0e139ba7da7e86ece9abd78bd398a2a265a679dcdd8621cde048d0555c" :answer/id #uuid "5dcf625f-0587-5cff-8876-293e9175ff61" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{x+3}{4x-1}" :db/ensure [:answer/validate]} {:db/id "q-148499/selection/d160c34ef13588b89f3c0cafcc70a7d6aa130d04d0ab13f6b8ecce132e5d9075" :answer/id #uuid "1e966ec0-c646-548f-8299-d6348ce45289" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{x+1}{x-3}" :db/ensure [:answer/validate]} {:db/id "q-148499/selection/353bdc5a54e4b64588b1bbc64b87ace452f370ea77cc112df46a0761f5b6009e" :answer/id #uuid "99d09ff5-f710-59af-b3df-bbb614071ce4" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{4x+1}{x-3}" :db/ensure [:answer/validate]} {:db/id "q-148499/selection" :answer-field/id #uuid "51772b94-4ac5-5441-ba79-17a300fdbe73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-148499/selection/353bdc5a54e4b64588b1bbc64b87ace452f370ea77cc112df46a0761f5b6009e" :answer-field/choices ["q-148499/selection/a8f5cae9811ede18fc21cc4e3cd80a7ac1922309c0499ce7c5b4d00953fb853c" "q-148499/selection/28c79cad2a2c81ebfc5159967a2bb9c4e483baba0859bea95d2f905918c7caf3" "q-148499/selection/80f5ba0e139ba7da7e86ece9abd78bd398a2a265a679dcdd8621cde048d0555c" "q-148499/selection/d160c34ef13588b89f3c0cafcc70a7d6aa130d04d0ab13f6b8ecce132e5d9075" "q-148499/selection/353bdc5a54e4b64588b1bbc64b87ace452f370ea77cc112df46a0761f5b6009e"] :db/ensure [:answer-field/validate]} {:db/id "q-148499" :question/id #uuid "14eca034-3075-5295-bbf9-c2a9d6845c19" :question/math-academy-id "q-148499" :question/is-example false :question/problem "Find the inverse of the function $f(x)=\\frac{3x+1}{x-4}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{3x+1}{x-4}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{3y+1}{y-4}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{3y+1}{y-4} \\\\ x(y-4) & =3y+1 \\\\ xy-4x & =3y+1 \\\\ xy-3y & =4x+1 \\\\ y(x-3) & =4x+1 \\\\ y & =\\frac{4x+1}{x-3}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{4x+1}{x-3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-148499/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7266d5c7-67b9-59db-b994-07dcb143af1f"] :knowledge-point/questions ["q-148499"] :db/ensure [:knowledge-point/validate]}]
