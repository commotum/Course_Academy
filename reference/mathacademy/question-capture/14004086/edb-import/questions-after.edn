#{[{:db/id #edb/ref 17592186114946 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/id #uuid "4036785f-d99b-5c01-81e9-edfb93cc1f0d" :question/math-academy-id "e-413" :question/problem "Calculate $\\displaystyle \\int_{-1}^{2} 9 x^2 \\, \\textrm d x .$" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{2}9{x}^{2}\\,\\text{d}x & =9{\\int }_{-1}^{2}{x}^{2}\\,\\text{d}x \\\\  & =9\\cdot \\frac{{x}^{3}}{3}\\,{|}_{-1}^{2} \\\\  & =3{x}^{3}\\,{|}_{-1}^{2} \\\\  & =3({2}^{3}-(-1)^{3}) \\\\  & =3(8-(-1)) \\\\  & =3\\cdot 9 \\\\  & =27.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114953 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/id #uuid "6ecec0d3-1714-550b-bce2-88ead5abf2f4" :question/math-academy-id "e-414" :question/problem "Evaluate $\\displaystyle \\int_{0}^{\\pi/4} (\\sec x \\tan x - \\cos x)\\, \\textrm d x.$" :question/worked-solution "Splitting up the integral into the difference of two integrals and evaluating each integral separately, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}(\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\operatorname{cos}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x-{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4}-\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =(\\operatorname{sec}⁡\\frac{\\pi }{4}-\\operatorname{sec}⁡0)-(\\operatorname{sin}⁡\\frac{\\pi }{4}-\\operatorname{sin}⁡0) \\\\  & =(\\sqrt{2}-1)-(\\frac{\\sqrt{2}}{2}-0) \\\\  & =\\sqrt{2}-\\frac{\\sqrt{2}}{2}-1 \\\\  & =\\frac{2\\sqrt{2}-\\sqrt{2}}{2}-1 \\\\  & =\\frac{\\sqrt{2}}{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114958 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/id #uuid "d5d4992c-4c68-5d30-b7b7-a5a89e4cc3e4" :question/math-academy-id "e-415" :question/problem "Evaluate $\\displaystyle \\int_{-2}^2(2x^3 - 5)\\, \\textrm d x.$" :question/worked-solution "Splitting up the sum and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-2}^{2}(2{x}^{3}-5)\\,\\text{d}x & =2{\\int }_{-2}^{2}{x}^{3}\\,\\text{d}x-5{\\int }_{-2}^{2}1\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{4}}{4}{|}_{-2}^{2}-5x{|}_{-2}^{2} \\\\  & =\\frac{1}{2}{x}^{4}\\,{|}_{-2}^{2}-5x\\,{|}_{-2}^{2} \\\\  & =\\frac{1}{2}({2}^{4}-(-2)^{4})-5(2-(-2)) \\\\  & =\\frac{1}{2}(16-16)-5\\cdot 4 \\\\  & =-20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114964 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/id #uuid "0347b53a-4f7c-587e-9232-aa9be2065576" :question/math-academy-id "e-416" :question/problem "Calculate $\\displaystyle \\int_{1}^{4} \\left(\\sqrt x - \\dfrac 2 {x^2}\\right) \\, \\textrm d x .$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int_1^4 \\left( \\sqrt x - \\dfrac 2 {x^2} \\right) \\, \\textrm dx = \\int_1^4 \\left( x^{1/2}-2x^{-2} \\right) \\, \\textrm dx.\n$$\n\n \n\nThen, we split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(\\sqrt{x}-\\frac{2}{{x}^{2}})\\,\\text{d}x & ={\\int }_{1}^{4}{x}^{1/2}\\,\\text{d}x-2{\\int }_{1}^{4}{x}^{-2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3/2}\\,{|}_{1}^{4}+2{x}^{-1}\\,{|}_{1}^{4} \\\\  & =\\frac{2}{3}({4}^{3/2}-{1}^{3/2})+2({4}^{-1}-{1}^{-1}) \\\\  & =\\frac{2}{3}(8-1)+2(\\frac{1}{4}-1) \\\\  & =\\frac{14}{3}+2\\cdot (-\\frac{3}{4}) \\\\  & =\\frac{14}{3}-\\frac{3}{2} \\\\  & =\\frac{19}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286578 :knowledge-point/_questions [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb9c8f54-761c-5ede-8e65-73e255eb9411" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286580} {:answer/id #uuid "d4b33af1-f77c-5586-9227-cfcaeb76a3da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186286581} {:answer/id #uuid "4479dcac-ff1a-5710-8191-e0b1c7c53276" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286582} {:answer/id #uuid "13a1829c-0e23-50a9-946a-e0d34de818a5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286583} {:answer/id #uuid "1a9ea578-4841-52b0-b735-d62a149e8c4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186286584}] :answer-field/correct {:answer/id #uuid "13a1829c-0e23-50a9-946a-e0d34de818a5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286583} :answer-field/id #uuid "9a1a3e64-8155-52b6-9416-3b5333f40451" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286579}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b6fd042a-ba9e-5baa-b53c-650b162950c7" :question/math-academy-id "q-114168" :question/problem "${\\int }_{0}^{\\pi /2}(-3\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(-3\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  & =-3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-3(-\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /2} \\\\  & =3(\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /2} \\\\  & =3[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0] \\\\  & =3(0-1) \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286585 :knowledge-point/_questions [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74987153-72e7-57f6-b2cc-7dffa894a532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186286587} {:answer/id #uuid "febe008f-35e5-545a-a6a4-0d236fbda91c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286588} {:answer/id #uuid "765b4b0e-223f-5c0a-a4e4-02fae0853100" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186286589} {:answer/id #uuid "3b048425-043d-5b0a-90f9-4b19a9a5a6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186286590} {:answer/id #uuid "265cdb0c-3ad4-53f0-a64f-6991ffc189ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186286591}] :answer-field/correct {:answer/id #uuid "74987153-72e7-57f6-b2cc-7dffa894a532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186286587} :answer-field/id #uuid "3f62dbf0-0f0c-5fd0-93d7-5e089bf06bd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286586}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb1fc86c-4e8e-5620-862e-cb1b72ff3de6" :question/math-academy-id "q-114173" :question/problem "${\\int }_{2}^{3}\\frac{t}{8}\\,\\text{d}t=$" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}\\frac{t}{8}\\,\\text{d}t & =\\frac{1}{8}{\\int }_{2}^{3}t\\,\\text{d}t \\\\  & =\\frac{1}{8}\\cdot \\frac{1}{2}{t}^{2}\\,{|}_{2}^{3} \\\\  & =\\frac{1}{16}\\cdot {t}^{2}\\,{|}_{2}^{3} \\\\  & =\\frac{1}{16}({3}^{2}-{2}^{2}) \\\\  & =\\frac{1}{16}(9-4) \\\\  & =\\frac{5}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286592 :knowledge-point/_questions [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c131c892-9942-5b0f-8512-e91bd4c2c9d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186286594} {:answer/id #uuid "60e7ad9e-2a44-5943-9464-ddc5a112c968" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186286595} {:answer/id #uuid "d7cb7372-2cd2-5b43-9222-7ec57217f478" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286596} {:answer/id #uuid "1d110047-6e34-529c-91e8-fa0f5c4feb2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186286597} {:answer/id #uuid "1fd69054-5d70-5361-9f31-9e69745cdc4a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286598}] :answer-field/correct {:answer/id #uuid "1fd69054-5d70-5361-9f31-9e69745cdc4a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286598} :answer-field/id #uuid "1dacc5fe-8fca-53b5-a7f3-c18fe0d5a190" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286593}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ba944e5b-f9e5-5ccd-9941-fdc2ec3b128f" :question/math-academy-id "q-114175" :question/problem "${\\int }_{1}^{2}(y-\\frac{1}{{y}^{2}})\\text{d}y=$" :question/worked-solution "Splitting up the integral into the difference of two integrals and evaluating each integral separately, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}(y-\\frac{1}{{y}^{2}})\\text{d}y & ={\\int }_{1}^{2}y\\,\\text{d}y-{\\int }_{1}^{2}\\frac{1}{{y}^{2}}\\,\\text{d}y \\\\  & =\\frac{1}{2}{y}^{2}\\,{|}_{1}^{2}+\\frac{1}{y}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{2}({2}^{2}-{1}^{2})+(\\frac{1}{2}-\\frac{1}{1}) \\\\  & =\\frac{1}{2}(3)+(\\frac{1}{2}-1) \\\\  & =\\frac{3}{2}-\\frac{1}{2} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286599 :knowledge-point/_questions [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6c3326a-dccb-588d-bc08-c5fcbeba6d27" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186286601} {:answer/id #uuid "97a853f6-cfd3-5ee8-9920-9b13cba8b594" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186286602} {:answer/id #uuid "f7e768b5-1531-580c-a286-9b327d4e5834" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186286603} {:answer/id #uuid "bc74a890-fd52-5784-ba5e-b50ceb12f003" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186286604} {:answer/id #uuid "71aa59b2-1257-5ca9-a2a7-a9f891b08f33" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186286605}] :answer-field/correct {:answer/id #uuid "a6c3326a-dccb-588d-bc08-c5fcbeba6d27" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186286601} :answer-field/id #uuid "02ced581-3e37-5e8f-aee4-0972f6287925" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286600}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bd730065-41da-5c0c-aec2-46f10a0e9998" :question/math-academy-id "q-114190" :question/problem "${\\int }_{-2}^{1}(6{z}^{2}-5{z}^{4})\\,\\text{d}z=$" :question/worked-solution "Splitting up the difference and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-2}^{1}(6{z}^{2}-5{z}^{4})\\,\\text{d}z & =6{\\int }_{-2}^{1}{z}^{2}\\,\\text{d}z-5{\\int }_{-2}^{1}{z}^{4}\\,\\text{d}z \\\\  & =6\\cdot \\frac{1}{3}{z}^{3}\\,{|}_{-2}^{1}-5\\cdot \\frac{1}{5}{z}^{5}\\,{|}_{-2}^{1} \\\\  & =2{z}^{3}\\,{|}_{-2}^{1}-{z}^{5}\\,{|}_{-2}^{1} \\\\  & =2({1}^{3}-(-2)^{3})-({1}^{5}-(-2)^{5}) \\\\  & =2(1+8)-(1+32) \\\\  & =18-33 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286606 :knowledge-point/_questions [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a2f3060-91ea-5032-9697-1bb98e8d6f37" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{52}{9}" :db/id #edb/ref 17592186286608} {:answer/id #uuid "8a0ee6db-40a3-5e89-9324-ae47f462e7c9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{39}{16}" :db/id #edb/ref 17592186286609} {:answer/id #uuid "f5433046-7731-5657-9e25-efecabebfc4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{41}{10}" :db/id #edb/ref 17592186286610} {:answer/id #uuid "6baab0d7-02e2-5d9d-b6d3-168db67ef707" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{43}{18}" :db/id #edb/ref 17592186286611} {:answer/id #uuid "bd66bcfa-f23e-59a3-9fd0-de69fe253753" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{64}{27}" :db/id #edb/ref 17592186286612}] :answer-field/correct {:answer/id #uuid "5a2f3060-91ea-5032-9697-1bb98e8d6f37" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{52}{9}" :db/id #edb/ref 17592186286608} :answer-field/id #uuid "052a7a14-d5b9-5875-bd83-b3b86e343cf8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286607}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f3dd7fd6-f4b1-5f7f-b293-8127a09c4096" :question/math-academy-id "q-114194" :question/problem "${\\int }_{-1}^{1}({t}^{8}-3)\\,\\text{d}t=$" :question/worked-solution "Splitting up the difference and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}({t}^{8}-3)\\,\\text{d}t & ={\\int }_{-1}^{1}{t}^{8}\\,\\text{d}t-3{\\int }_{-1}^{1}\\text{d}t \\\\  & =\\frac{1}{9}{t}^{9}\\,{|}_{-1}^{1}-3t\\,{|}_{-1}^{1} \\\\  & =\\frac{1}{9}({1}^{9}-(-1)^{9})-3(1-(-1)) \\\\  & =\\frac{1}{9}(1+1)-3(1+1) \\\\  & =\\frac{2}{9}-6 \\\\  & =-\\frac{52}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286613 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe594599-0391-5db0-84ff-353902340da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186286615} {:answer/id #uuid "898de4b3-c82c-53a1-8016-7956840003db" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186286616} {:answer/id #uuid "5e8766b1-e366-53ec-b594-cd095c49e418" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286617} {:answer/id #uuid "65b75263-2b96-5a7f-9c80-0eafd9bda05f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286618} {:answer/id #uuid "02efb375-762a-56e1-98d3-1e7e7db6c486" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186286619}] :answer-field/correct {:answer/id #uuid "5e8766b1-e366-53ec-b594-cd095c49e418" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286617} :answer-field/id #uuid "bd2b102a-1bfe-5923-ad7c-be1146ccc146" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286614}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8137abdc-2255-5881-94a0-a8d5a007c39f" :question/math-academy-id "q-114202" :question/problem "${\\int }_{-2}^{-1}(2-\\frac{3}{{y}^{2}})\\text{d}y=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{-2}^{-1}(2-\\frac{3}{{y}^{2}})\\text{d}y={\\int }_{-2}^{-1}(2-3{y}^{-2})\\text{d}y\n$$\n\nThen, we split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{-1}(2-3{y}^{-2})\\text{d}y & =2{\\int }_{-2}^{-1}\\text{d}y-3{\\int }_{-2}^{-1}{y}^{-2}\\,\\text{d}y \\\\  & =2y\\,{|}_{-2}^{-1}-3(-{y}^{-1}){|}_{-2}^{-1} \\\\  & =2y\\,{|}_{-2}^{-1}+3\\cdot \\frac{1}{y}{|}_{-2}^{-1} \\\\  & =2(-1-(-2))+3(\\frac{1}{(-1)}-\\frac{1}{(-2)}) \\\\  & =2(-1+2)+3(-1+\\frac{1}{2}) \\\\  & =2(1)+3(-\\frac{1}{2}) \\\\  & =2-\\frac{3}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286620 :knowledge-point/_questions [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59df12a1-3ba2-562f-aab2-0e290a9367b5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186286622} {:answer/id #uuid "8b759d2e-27d2-5ab6-91aa-aebafda2208a" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186286623} {:answer/id #uuid "0d3a62e1-1cac-5a3e-b46b-6e830f0a3121" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186286624} {:answer/id #uuid "f9b4c290-655e-571c-a3d7-c3b39b0164a1" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186286625} {:answer/id #uuid "3e378f53-f32d-5698-bf90-6c13e1d8a168" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286626}] :answer-field/correct {:answer/id #uuid "8b759d2e-27d2-5ab6-91aa-aebafda2208a" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186286623} :answer-field/id #uuid "50806280-4805-52c6-9276-da4e1de0b6c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286621}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b090d8a3-c891-5f13-a47d-5e18f9ff5a4a" :question/math-academy-id "q-2008" :question/problem "Evaluate ${\\int }_{-2}^{2}(3z+2)\\,\\text{d}z.$" :question/worked-solution "Splitting up the sum and factoring out the constants, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{-2}^{2}(3z+2)\\,\\text{d}z & =3{\\int }_{-2}^{2}z\\,\\text{d}z+2{\\int }_{-2}^{2}\\,\\text{d}z \\\\  & =3\\cdot \\frac{{z}^{2}}{2}{|}_{-2}^{2}+2z\\,{|}_{-2}^{2} \\\\  & =3(\\frac{{2}^{2}}{2}-\\frac{(-2)^{2}}{2})+2(2-(-2)) \\\\  & =3\\cdot 0+2\\cdot 4 \\\\  & =8.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286627 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008e7f97-da30-5bfd-add9-79b71ea596a1" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186286629} {:answer/id #uuid "e8b9c125-251e-540d-8f5f-8fe48ae0e2c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{268}" :db/id #edb/ref 17592186286630} {:answer/id #uuid "9555a1d8-da43-5047-9796-5d7a044b385a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186286631} {:answer/id #uuid "5c7dad7b-999e-5312-b0ca-76ff25e03518" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{128}{5}" :db/id #edb/ref 17592186286632} {:answer/id #uuid "c2671372-531b-57f0-9221-a421745084bc" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186286633}] :answer-field/correct {:answer/id #uuid "9555a1d8-da43-5047-9796-5d7a044b385a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186286631} :answer-field/id #uuid "ccdd81b6-af23-5496-97c3-2cc1202e9b45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286628}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b3f6be86-c5d2-5227-9291-de4f0cca72e0" :question/math-academy-id "q-29780" :question/problem "Evaluate ${\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x={\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x.\n$$\n\nThen, we split the integral into the difference of three integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x & =2{\\int }_{0}^{4}{x}^{3/2}\\,\\text{d}x+3{\\int }_{0}^{4}x\\,\\text{d}x+{\\int }_{0}^{4}1\\,\\text{d}x \\\\  & =2\\cdot \\frac{2}{5}{x}^{5/2}{|}_{0}^{4}+3\\cdot \\frac{{x}^{2}}{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}{x}^{5/2}{|}_{0}^{4}+\\frac{3}{2}{x}^{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}({4}^{5/2}-{0}^{5/2})+\\frac{3}{2}({4}^{2}-{0}^{2})+(4-0) \\\\  & =\\frac{4}{5}\\cdot 32+\\frac{3}{2}\\cdot 16+4 \\\\  & =\\frac{128}{5}+28 \\\\  & =\\frac{268}{5}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115638 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e151a9-ebb0-50d6-94b7-e00972d1639d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{2}" :db/id #edb/ref 17592186113229} {:answer/id #uuid "8d59dc5f-ea34-5a53-8373-8652c81a9e3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{20}" :db/id #edb/ref 17592186113230} {:answer/id #uuid "c2d7f713-2771-5d07-9f96-7a990493c7b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{5}" :db/id #edb/ref 17592186113231} {:answer/id #uuid "379cc5db-7ce4-5419-ae0b-cf69dd935dff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{10}" :db/id #edb/ref 17592186113232} {:answer/id #uuid "66696cb0-7005-505e-a066-dd3ea7d9f23b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{4}" :db/id #edb/ref 17592186113233}] :answer-field/correct {:answer/id #uuid "66696cb0-7005-505e-a066-dd3ea7d9f23b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{4}" :db/id #edb/ref 17592186113233} :answer-field/id #uuid "d7d658c8-af0f-5950-986b-bfb1c8afa44d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113228}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "00be2488-9ecc-5429-aabc-0015493fbd7f" :question/math-academy-id "q-29784" :question/problem "${\\int }_{1}^{16}(\\frac{10}{\\sqrt[4]{{x}^{3}}}+\\frac{x}{10})\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{1}^{16}(\\frac{10}{\\sqrt[4]{{x}^{3}}}+\\frac{x}{10})\\,\\text{d}x={\\int }_{1}^{16}(10{x}^{-3/4}+\\frac{1}{10}x)\\,\\text{d}x.\n$$\n\nThen, we split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}(10{x}^{-3/4}+\\frac{1}{10}x)\\,\\text{d}x & =10{\\int }_{1}^{16}{x}^{-3/4}\\,\\text{d}x+\\frac{1}{10}{\\int }_{1}^{16}x\\,\\text{d}x \\\\  & =10\\cdot 4{x}^{1/4}\\,{|}_{1}^{16}+\\frac{1}{10}\\cdot \\frac{{x}^{2}}{2}\\,{|}_{1}^{16} \\\\  & =40{x}^{1/4}\\,{|}_{1}^{16}+\\frac{1}{20}{x}^{2}\\,{|}_{1}^{16} \\\\  & =40({16}^{1/4}-{1}^{1/4})+\\frac{1}{20}({16}^{2}-{1}^{2}) \\\\  & =40(2-1)+\\frac{1}{20}(256-1) \\\\  & =40+\\frac{51}{4} \\\\  & =\\frac{211}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286634 :knowledge-point/_questions [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0f63f2-372c-5bb4-930d-9e28cbeb563f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^6}{3}-\\frac{7}{3}" :db/id #edb/ref 17592186286636} {:answer/id #uuid "63718244-51fb-5c44-ada3-22fa43e49983" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^6}{3}-\\frac{1}{3}" :db/id #edb/ref 17592186286637}] :answer-field/correct {:answer/id #uuid "4d0f63f2-372c-5bb4-930d-9e28cbeb563f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^6}{3}-\\frac{7}{3}" :db/id #edb/ref 17592186286636} :answer-field/id #uuid "6321674e-79f6-521b-bf19-4842d2ab0514" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286635}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a6085e15-350b-5cb1-829a-fef0a3c79d9a" :question/math-academy-id "q-316004" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}({x}^{2}-\\frac{1}{x})\\text{d}x=$\n{{field-1}}" :question/worked-solution "Splitting up the integral into the difference of two integrals and evaluating each integral separately, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}({x}^{2}-\\frac{1}{x})\\text{d}x & ={\\int }_{1}^{{e}^{2}}{x}^{2}\\,\\text{d}x-{\\int }_{1}^{{e}^{2}}\\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{3}\\,{|}_{1}^{{e}^{2}}-\\operatorname{ln}⁡|x|\\,{|}_{1}^{{e}^{2}} \\\\  & =\\frac{1}{3}(({e}^{2})^{3}-{1}^{3})-(\\operatorname{ln}⁡({e}^{2})-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{1}{3}({e}^{6}-1)-(2-0) \\\\  & =\\frac{{e}^{6}-1}{3}-2 \\\\  & =\\frac{{e}^{6}-7}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286638 :knowledge-point/_questions [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "868b90bc-bee8-5a29-9cd4-98ac56fd55bd" :answer/type {:db/ident :answer.type/math} :answer/value "5e^3" :db/id #edb/ref 17592186286640} {:answer/id #uuid "564fda66-f2b1-5ff4-bda5-893a343b98f0" :answer/type {:db/ident :answer.type/math} :answer/value "5e^3-5" :db/id #edb/ref 17592186286641}] :answer-field/correct {:answer/id #uuid "564fda66-f2b1-5ff4-bda5-893a343b98f0" :answer/type {:db/ident :answer.type/math} :answer/value "5e^3-5" :db/id #edb/ref 17592186286641} :answer-field/id #uuid "ef02414c-ce0e-5db8-ac27-8ebd8b03bc2b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286639}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2ff7bae5-7712-59a8-879f-d4636f26eb11" :question/math-academy-id "q-339791" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{3}5{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}5{e}^{x}\\,\\text{d}x & =5{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x \\\\  & =5\\cdot {e}^{x}\\,{|}_{0}^{3} \\\\  & =5({e}^{3}-{e}^{0}) \\\\  & =5({e}^{3}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286642 :knowledge-point/_questions [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2ad388-2312-5aff-a5c2-771161926f6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{12}" :db/id #edb/ref 17592186286644}] :answer-field/correct {:answer/id #uuid "2f2ad388-2312-5aff-a5c2-771161926f6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{12}" :db/id #edb/ref 17592186286644} :answer-field/id #uuid "d2dad9a3-6416-5c15-850c-d6d92ed4ff2f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286643}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cf67060d-9554-54e5-936f-4853cd101ead" :question/math-academy-id "q-339842" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\sqrt{3}}\\frac{5}{1+{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt{3}}\\frac{5}{1+{x}^{2}}\\,\\text{d}x & =5{\\int }_{1}^{\\sqrt{3}}\\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\cdot \\text{arctan}\\,x\\,{|}_{1}^{\\sqrt{3}} \\\\  & =5(\\text{arctan}(\\sqrt{3})-\\text{arctan}(1)) \\\\  & =5(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =5(\\frac{\\pi }{12}) \\\\  & =\\frac{5\\pi }{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286645 :knowledge-point/_questions [{:knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f322193-ccd5-5c65-b6bf-798b88e40acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186286647}] :answer-field/correct {:answer/id #uuid "4f322193-ccd5-5c65-b6bf-798b88e40acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186286647} :answer-field/id #uuid "aed63570-3f17-5e5c-9516-5db5c21ac11e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286646}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4409ed7c-d54a-5289-8a7b-c20401053cf7" :question/math-academy-id "q-339843" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/2}\\frac{3}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}\\frac{3}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =3{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =3\\cdot \\operatorname{arcsin}⁡x\\,{|}_{0}^{1/2} \\\\  & =3(arcsin\\,(\\frac{1}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =3(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286648 :knowledge-point/_questions [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23a37482-dcad-5db4-a7bd-ca36e1a5b3cb" :answer/type {:db/ident :answer.type/math} :answer/value "e^e-e" :db/id #edb/ref 17592186286650} {:answer/id #uuid "1d7ecd86-c12a-5de8-9887-789aef229f6f" :answer/type {:db/ident :answer.type/math} :answer/value "e^e-e-1" :db/id #edb/ref 17592186286651}] :answer-field/correct {:answer/id #uuid "1d7ecd86-c12a-5de8-9887-789aef229f6f" :answer/type {:db/ident :answer.type/math} :answer/value "e^e-e-1" :db/id #edb/ref 17592186286651} :answer-field/id #uuid "c4f0c4a3-85da-5dc0-ab73-ed9d7a00b1d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286649}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f05900e5-f085-5682-ba37-4d30dca771f9" :question/math-academy-id "q-339850" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}({e}^{x}-\\frac{1}{x})\\text{d}x=$\n{{field-1}}" :question/worked-solution "Splitting up the integral into the difference of two integrals and evaluating each integral separately, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}({e}^{x}-\\frac{1}{x})\\text{d}x & ={\\int }_{1}^{e}{e}^{x}\\,\\text{d}x-{\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x \\\\  & ={e}^{x}\\,{|}_{1}^{e}-\\operatorname{ln}⁡|x|\\,{|}_{1}^{e} \\\\  & =({e}^{e}-{e}^{1})-(\\operatorname{ln}⁡(e)-\\operatorname{ln}⁡(1)) \\\\  & =({e}^{e}-e)-(1-0) \\\\  & ={e}^{e}-e-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286652 :knowledge-point/_questions [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb838813-670b-5ef9-87aa-aabb08cccb9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\ln(3)}+\\frac{1}{2}" :db/id #edb/ref 17592186286654}] :answer-field/correct {:answer/id #uuid "fb838813-670b-5ef9-87aa-aabb08cccb9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\ln(3)}+\\frac{1}{2}" :db/id #edb/ref 17592186286654} :answer-field/id #uuid "6b291bc0-b27a-53ea-b7a9-7f9cb74ac833" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286653}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0f24793-23aa-5485-88e4-03801a404f8d" :question/math-academy-id "q-340324" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}(2\\cdot {3}^{x}+x)\\text{d}x=$\n{{field-1}}" :question/worked-solution "Splitting up the integral into the sum of two integrals and evaluating each integral separately, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(2\\cdot {3}^{x}+x)\\text{d}x & ={\\int }_{0}^{1}2\\cdot {3}^{x}\\,\\text{d}x+{\\int }_{0}^{1}x\\,\\text{d}x \\\\  & =2\\cdot \\frac{{3}^{x}}{\\operatorname{ln}⁡3}\\,{|}_{0}^{1}+\\frac{1}{2}{x}^{2}\\,{|}_{0}^{1} \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}({3}^{1}-{3}^{0})+\\frac{1}{2}({1}^{2}-{0}^{2}) \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}(3-1)+\\frac{1}{2} \\\\  & =\\frac{4}{\\operatorname{ln}⁡3}+\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286655 :knowledge-point/_questions [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e58d1518-9cc7-588b-a463-e39b3d8b9457" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186286657} {:answer/id #uuid "2a525e00-bdc3-5f76-9541-4e5f274bf655" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186286658}] :answer-field/correct {:answer/id #uuid "2a525e00-bdc3-5f76-9541-4e5f274bf655" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186286658} :answer-field/id #uuid "a334f7c5-eb47-552e-ae82-127f79462a69" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286656}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dc6a9fc1-a9cd-5241-b63e-602378f19ee3" :question/math-academy-id "q-340354" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{3}({x}^{3}+4x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Splitting up the sum and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}({x}^{3}+4x)\\,\\text{d}x & ={\\int }_{-1}^{3}{x}^{3}\\,\\text{d}x+4{\\int }_{-1}^{3}x\\,\\text{d}x \\\\  & =\\frac{1}{4}{x}^{4}\\,{|}_{-1}^{3}+4\\cdot \\frac{1}{2}{x}^{2}\\,{|}_{-1}^{3} \\\\  & =\\frac{1}{4}({3}^{4}-(-1)^{4})+2({3}^{2}-(-1)^{2}) \\\\  & =\\frac{1}{4}(81-1)+2(9-1) \\\\  & =20+16 \\\\  & =36.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286659 :knowledge-point/_questions [{:knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629c7767-ce3f-5852-950e-dd8723c3835f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186286661}] :answer-field/correct {:answer/id #uuid "629c7767-ce3f-5852-950e-dd8723c3835f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186286661} :answer-field/id #uuid "990b0f56-8338-517f-a47c-a7c873defaa5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286660}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9a0b9bf6-42cc-514b-8522-6caa9467a854" :question/math-academy-id "q-340395" :question/problem "Evaluate the following integral.\n\n${\\int }_{-1}^{2}(4{x}^{2}-6)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Splitting up the difference and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-1}^{2}(4{x}^{2}-6)\\,\\text{d}x & =4{\\int }_{-1}^{2}{x}^{2}\\,\\text{d}x-6{\\int }_{-1}^{2}1\\,\\text{d}x \\\\  & =4\\cdot \\frac{1}{3}{x}^{3}\\,{|}_{-1}^{2}-6x\\,{|}_{-1}^{2} \\\\  & =\\frac{4}{3}({2}^{3}-(-1)^{3})-6(2-(-1)) \\\\  & =\\frac{4}{3}(8-(-1))-6(3) \\\\  & =12-18 \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286662 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255e5729-cb4d-5916-be00-5686891e8b75" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186286664}] :answer-field/correct {:answer/id #uuid "255e5729-cb4d-5916-be00-5686891e8b75" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186286664} :answer-field/id #uuid "9e658822-55f6-5f11-961d-2fcf2480db60" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286663}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6049764c-e182-5ce2-9423-ff875b11af26" :question/math-academy-id "q-340422" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{4}(\\frac{6}{\\sqrt{x}}+{x}^{2})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{1}^{4}(\\frac{6}{\\sqrt{x}}+{x}^{2})\\,\\text{d}x={\\int }_{1}^{4}(6{x}^{-1/2}+{x}^{2})\\,\\text{d}x.\n$$\n\nThen, we split the integral into the sum of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(6{x}^{-1/2}+{x}^{2})\\,\\text{d}x & =6{\\int }_{1}^{4}{x}^{-1/2}\\,\\text{d}x+{\\int }_{1}^{4}{x}^{2}\\,\\text{d}x \\\\  & =6\\cdot 2{x}^{1/2}\\,{|}_{1}^{4}+\\frac{1}{3}{x}^{3}\\,{|}_{1}^{4} \\\\  & =12{x}^{1/2}\\,{|}_{1}^{4}+\\frac{1}{3}{x}^{3}\\,{|}_{1}^{4} \\\\  & =12({4}^{1/2}-{1}^{1/2})+\\frac{1}{3}({4}^{3}-{1}^{3}) \\\\  & =12(2-1)+\\frac{1}{3}(64-1) \\\\  & =12+21 \\\\  & =33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286665 :knowledge-point/_questions [{:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd1684aa-528f-5076-aafc-12890747170b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286667} {:answer/id #uuid "d4fdfe07-65bf-5751-a7cb-0d5b2ebe8705" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286668}] :answer-field/correct {:answer/id #uuid "d4fdfe07-65bf-5751-a7cb-0d5b2ebe8705" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286668} :answer-field/id #uuid "ff369e19-2d53-5754-8604-da96cd1feba6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286666}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0f1bdb56-1641-5eaa-b552-2869444ec6fa" :question/math-academy-id "q-340437" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi }(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We split the integral into the sum of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)\\,\\text{d}x & =2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡x\\,\\text{d}x+{\\int }_{0}^{\\pi }\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2(-\\operatorname{cos}⁡x){|}_{0}^{\\pi }+\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi } \\\\  & =2[(-\\operatorname{cos}⁡\\pi )-(-\\operatorname{cos}⁡0)]+(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡0) \\\\  & =2(1-(-1))+(0-0) \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286669 :knowledge-point/_questions [{:knowledge-point/id #uuid "f236feb9-761b-544b-b34a-19eb46c28988" :knowledge-point/title "Evaluating the Integral of the Sum of Two Functions Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8fa357b-5512-5517-9a93-85bf1fcddd5b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{14}({x}^{2}-{e}^{x})\\,\\text{d}x-{\\int }_{-2}^{14}({x}^{2}-{e}^{x})\\text{d}x" :db/id #edb/ref 17592186286671} {:answer/id #uuid "ac5807bb-2c03-537d-af8e-03b0a368bb02" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{7}{x}^{2}\\,\\text{d}x+{\\int }_{-1}^{7}{e}^{x}\\text{d}x" :db/id #edb/ref 17592186286672} {:answer/id #uuid "7455a749-c5f5-5d69-bd9d-3b60d410aa28" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{7}x\\,\\text{d}x-{\\int }_{-1}^{7}{e}^{x}\\text{d}x" :db/id #edb/ref 17592186286673} {:answer/id #uuid "75bdc4a6-3bca-5c42-9407-a877a331c873" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{7/2}({x}^{2}-{e}^{x})\\,\\text{d}x-{\\int }_{-1}^{7/2}({x}^{2}-{e}^{x})\\text{d}x" :db/id #edb/ref 17592186286674} {:answer/id #uuid "d6c00dc1-597a-54af-8b2f-18e401e7221f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{7}{x}^{2}\\,\\text{d}x-{\\int }_{-1}^{7}{e}^{x}\\text{d}x" :db/id #edb/ref 17592186286675}] :answer-field/correct {:answer/id #uuid "d6c00dc1-597a-54af-8b2f-18e401e7221f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{7}{x}^{2}\\,\\text{d}x-{\\int }_{-1}^{7}{e}^{x}\\text{d}x" :db/id #edb/ref 17592186286675} :answer-field/id #uuid "b19094d1-2501-553f-856a-5a2bc6402d15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286670}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f1dceaa8-c464-57ff-aad7-d905e8c07184" :question/math-academy-id "q-73343" :question/problem "${\\int }_{-1}^{7}({x}^{2}-{e}^{x})\\,\\text{d}x=$" :question/worked-solution "Splitting up the integral into the difference of two integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{7}({x}^{2}-{e}^{x})\\,\\text{d}x & ={\\int }_{-1}^{7}{x}^{2}\\,\\text{d}x+{\\int }_{-1}^{7}(-{e}^{x})\\,\\text{d}x \\\\  & ={\\int }_{-1}^{7}{x}^{2}\\,\\text{d}x-{\\int }_{-1}^{7}{e}^{x}\\text{d}x.\\end{aligned}\n$$"}]}
