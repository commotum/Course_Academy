[{:db/id "q-2355/selection/10443852c766785156fee8e7a0dbbf2c159c5c34b3cd966f657a742e27a20eb1" :answer/id #uuid "8841e453-14d2-5cac-9fbc-00db111a57dd" :answer/type :answer.type/math :answer/value "21\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "q-2355/selection/c401cc9e5f5302ecbc06f6ea73ee67cdffaffdf1234120b0f5dc40d29d4b67a6" :answer/id #uuid "d17faf2c-932d-5b71-838c-07f9cb4cdd99" :answer/type :answer.type/math :answer/value "27\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "q-2355/selection/b1b610a90d5ab65369c8533ba48f047ff9c30df28c7711c5eaad928a826756da" :answer/id #uuid "c668d751-13fc-53b6-b162-5861350f8ab7" :answer/type :answer.type/math :answer/value "14\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "q-2355/selection/36b5f29c41a3e4c05548cafde6b2d92e2bfeca59315548320be018d54169a93f" :answer/id #uuid "6b020559-c908-552c-afc9-48f7d78db5ba" :answer/type :answer.type/math :answer/value "3\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "q-2355/selection/abf5e1bc930c2d71791467087ca50f020dbaa4e3c9d9d7ade53270b5153177bd" :answer/id #uuid "d82ad59d-066d-56ba-b7cb-8804951691c4" :answer/type :answer.type/math :answer/value "19\\,\\text{m/s}" :db/ensure [:answer/validate]} {:db/id "q-2355/selection" :answer-field/id #uuid "df605953-16a2-5a27-9732-d5236ffecc02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2355/selection/10443852c766785156fee8e7a0dbbf2c159c5c34b3cd966f657a742e27a20eb1" :answer-field/choices ["q-2355/selection/10443852c766785156fee8e7a0dbbf2c159c5c34b3cd966f657a742e27a20eb1" "q-2355/selection/c401cc9e5f5302ecbc06f6ea73ee67cdffaffdf1234120b0f5dc40d29d4b67a6" "q-2355/selection/b1b610a90d5ab65369c8533ba48f047ff9c30df28c7711c5eaad928a826756da" "q-2355/selection/36b5f29c41a3e4c05548cafde6b2d92e2bfeca59315548320be018d54169a93f" "q-2355/selection/abf5e1bc930c2d71791467087ca50f020dbaa4e3c9d9d7ade53270b5153177bd"] :db/ensure [:answer-field/validate]} {:db/id "q-2355" :question/id #uuid "a35c600c-2a9c-5614-9593-1a6e8005af53" :question/math-academy-id "q-2355" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by the equation $s(t)={t}^{3}-{t}^{2}-15$ where $t$ is measured in seconds.  Find the velocity after $t=3\\,\\text{s}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2}-15) \\\\  & =3{t}^{2}-2t\\end{aligned}\n$$\n\nTo calculate the velocity at $t=3\\,\\text{s},$ we substitute $t=3$ into the velocity function above:\n\n$$\n\\begin{aligned}v(3) & =3(3)^{2}-2(3) \\\\  & =27-6 \\\\  & =21\\,\\text{m/s}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/requires-calculator true :question/answer-fields ["q-2355/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9"] :knowledge-point/questions ["q-2355"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72450/selection/32c52b86803cb9d22007b3ddd879f2c0054960d632583acedd21aa0af73fd9cc" :answer/id #uuid "f2d0c68a-c850-569e-a733-32f932a25ac8" :answer/type :answer.type/math :answer/value "5\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)" :db/ensure [:answer/validate]} {:db/id "q-72450/selection/7e8486e946b7b4413374a41607c0147c380b3a371e960efabc59bc79d485c80e" :answer/id #uuid "ceda6317-8baf-551c-946b-46ae06be5c21" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/ensure [:answer/validate]} {:db/id "q-72450/selection/bf41871d633536989fbb367715998dc6e4970a007420355183db8e47c3c686bb" :answer/id #uuid "7d76f508-4f55-5208-8ac6-ca8accf35a1d" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/ensure [:answer/validate]} {:db/id "q-72450/selection/ccc19278415e7c335d60f268e86229cbf2a3f5209ab626680c692e16c354e398" :answer/id #uuid "87bb3c8d-8a47-5438-9e70-f82ca2fafcff" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)" :db/ensure [:answer/validate]} {:db/id "q-72450/selection/030bc1772221b5e6339dd175e8c34530f08ab2a8ea84837e06900bee065d0dde" :answer/id #uuid "c125a5a5-8271-59c3-9800-80ad4d2843fc" :answer/type :answer.type/math :answer/value "5\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/ensure [:answer/validate]} {:db/id "q-72450/selection" :answer-field/id #uuid "bd9694e0-d3c3-51b8-90eb-92f7591fe930" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72450/selection/ccc19278415e7c335d60f268e86229cbf2a3f5209ab626680c692e16c354e398" :answer-field/choices ["q-72450/selection/32c52b86803cb9d22007b3ddd879f2c0054960d632583acedd21aa0af73fd9cc" "q-72450/selection/7e8486e946b7b4413374a41607c0147c380b3a371e960efabc59bc79d485c80e" "q-72450/selection/bf41871d633536989fbb367715998dc6e4970a007420355183db8e47c3c686bb" "q-72450/selection/ccc19278415e7c335d60f268e86229cbf2a3f5209ab626680c692e16c354e398" "q-72450/selection/030bc1772221b5e6339dd175e8c34530f08ab2a8ea84837e06900bee065d0dde"] :db/ensure [:answer-field/validate]} {:db/id "q-72450" :question/id #uuid "cf0f2822-a0a9-5330-824d-28888a01fcc3" :question/math-academy-id "q-72450" :question/problem "Calculate $\\int (\\frac{1}{5x+2}+\\frac{1}{5x-2})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{5x+2}+\\frac{1}{5x-2})\\,\\text{d}x & =\\int \\frac{1}{5x+2}\\,\\text{d}x+\\int \\frac{1}{5x-2}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|5x+2|+\\frac{1}{5}\\operatorname{ln}⁡|5x-2|+C \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|(5x+2)(5x-2)|+\\frac{1}{5}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef"] :knowledge-point/questions ["q-72450"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326300/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer/id #uuid "56e79aae-7c07-515c-bede-4125eac8b9d9" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "q-326300/field-1" :answer-field/id #uuid "9681bfab-c84a-5526-a7bd-30f413bbf72e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326300/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer-field/choices ["q-326300/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0"] :db/ensure [:answer-field/validate]} {:db/id "q-326300/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "03d470ef-fe39-5944-a4ff-0e6bbcc1d23e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-326300/field-2" :answer-field/id #uuid "b02ac64b-d19e-5e59-822c-62ac17724d61" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326300/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-326300/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-326300/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "1f597396-180c-5146-b5da-67a094e27c13" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-326300/field-3" :answer-field/id #uuid "dca77ee2-01cd-5e52-87e5-98e22fa5040c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326300/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-326300/field-3/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-326300/field-4/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6fbd109a-9208-53e3-9213-27fdebcfe7fb" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-326300/field-4" :answer-field/id #uuid "51544716-cf91-56a1-8585-42a84f439e2e" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326300/field-4/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-326300/field-4/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-326300" :question/id #uuid "aeeb52fb-999e-570f-bb95-972c0c9756ab" :question/math-academy-id "q-326300" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3-\\frac{1}{2}t,\\,y=\\frac{3}{4}{t}^{2}-1,\\,t\\ge 2.\n$$\n\nDetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $3-\\frac{1}{2}t\\le 2$ for all $t\\ge 2.$ Consequently, the range of $x$ is\n\n$$\nx\\le 2.\n$$\n\n- To find the range of $y,$ note that $\\frac{3}{4}{t}^{2}-1\\ge 2$ for all $t\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-326300/field-1" "q-326300/field-2" "q-326300/field-3" "q-326300/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef"] :knowledge-point/questions ["q-326300"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275807/field-1/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "00fc0b66-1d6e-5667-a136-ffd88df0a21c" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-275807/field-1" :answer-field/id #uuid "1956ad66-c9e6-5518-b274-33a853a6de8e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275807/field-1/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer-field/choices ["q-275807/field-1/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d"] :db/ensure [:answer-field/validate]} {:db/id "q-275807/field-2/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0" :answer/id #uuid "231f62ad-0b8a-5bcb-a26c-214329941c2b" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-275807/field-2" :answer-field/id #uuid "aa4d13ed-e148-5e95-b307-e95427e73ecc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275807/field-2/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0" :answer-field/choices ["q-275807/field-2/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0"] :db/ensure [:answer-field/validate]} {:db/id "q-275807" :question/id #uuid "87be17c2-32bc-57f0-80a6-2537d5aa413b" :question/math-academy-id "q-275807" :question/problem "A point $P$ has Cartesian coordinates $(-1,-1).$ Find the polar coordinates of $P.$ Give the polar angle in radians and do not round the answer.\n\nThe polar coordinates of $P$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we determine $r:$\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nFor the reference angle, we get\n\n$$\n\\begin{aligned}{\\theta }_{R} & =|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =|\\operatorname{arctan}⁡(\\frac{-1}{-1})| \\\\  & =|\\operatorname{arctan}⁡(1)| \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nSince the point $P$ lies in the third quadrant, we add the reference angle to $\\pi ,$ and we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the polar coordinates of $P$ are  $(\\sqrt{2},\\frac{5\\pi }{4}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275807/field-1" "q-275807/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b04084c-8e69-5f53-a95d-664aba54aec9"] :knowledge-point/questions ["q-275807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51143/selection/a451a70c3d9b7037186a8227039cb10ab3ffa23cc0612786d0104b83b55abf88" :answer/id #uuid "2af4b394-baf1-59f3-8616-574c2e3526c1" :answer/type :answer.type/math :answer/value "-70" :db/ensure [:answer/validate]} {:db/id "q-51143/selection/95f0217cc1a787fa427ae3652ee08f6e7e92976368d3018500a5edad740eb418" :answer/id #uuid "b3ed7003-c364-5fcc-9889-cc2e0375634f" :answer/type :answer.type/math :answer/value "-56" :db/ensure [:answer/validate]} {:db/id "q-51143/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer/id #uuid "1b587f92-8674-5571-b45c-e2df71c02ae3" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "q-51143/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "10824ecc-6409-5de5-a34c-fc83b34d2292" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-51143/selection/25b335c1798b7b6a4cb13a35c15bf802d740cecd154b47b5e805a756e83b1528" :answer/id #uuid "e1a53c54-5066-5ff8-8a99-c359bc0d171f" :answer/type :answer.type/math :answer/value "-42" :db/ensure [:answer/validate]} {:db/id "q-51143/selection" :answer-field/id #uuid "88d8e430-d5a3-572a-9807-7705d10cd994" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51143/selection/a451a70c3d9b7037186a8227039cb10ab3ffa23cc0612786d0104b83b55abf88" :answer-field/choices ["q-51143/selection/a451a70c3d9b7037186a8227039cb10ab3ffa23cc0612786d0104b83b55abf88" "q-51143/selection/95f0217cc1a787fa427ae3652ee08f6e7e92976368d3018500a5edad740eb418" "q-51143/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" "q-51143/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" "q-51143/selection/25b335c1798b7b6a4cb13a35c15bf802d740cecd154b47b5e805a756e83b1528"] :db/ensure [:answer-field/validate]} {:db/id "q-51143" :question/id #uuid "83d87495-9a05-50e5-8fdd-f9cab6c7f065" :question/math-academy-id "q-51143" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}+31}{(x-2)^{2}(2x+1)}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}+\\frac{C}{2x+1},\n$$\n\nwhere $A$, $B$, and $C$ are real constants, determine the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-2)^{2}(2x+1)$ gives\n\n$$\n\\begin{aligned}{x}^{2}+31 & =A(x-2)(2x+1)+B(2x+1)+C(x-2)^{2}.\\end{aligned}\n$$\n\nLetting $x=-\\frac{1}{2}$  gives\n\n$$\n\\begin{aligned}{(-\\frac{1}{2})}^{2}+31 & =A(-\\frac{1}{2}-2)(2[-\\frac{1}{2}]+1)+B(2[-\\frac{1}{2}]+1)+C{(-\\frac{1}{2}-2)}^{2} \\\\ \\frac{1}{4}+31 & =A(-\\frac{5}{2})(-1+1)+B(-1+1)+C(\\frac{25}{4}) \\\\ \\frac{125}{4} & =\\frac{25C}{4} \\\\ C & =5.\\end{aligned}\n$$\n\nLetting $x=2$  gives\n\n$$\n\\begin{aligned}{2}^{2}+31 & =A(2-2)(2\\cdot 2+1)+B(2\\cdot 2+1)+C(2-2)^{2} \\\\ 35 & =5B \\\\ B & =7.\\end{aligned}\n$$\n\nFinally, letting $x=0$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}{0}^{2}+31 & =A(0-2)(2\\cdot 0+1)+7(2\\cdot 0+1)+5(0-2)^{2} \\\\ 31 & =-2A+7+20 \\\\ 31 & =-2A+27 \\\\ 2A & =-4 \\\\ A & =-2.\\end{aligned}\n$$\n\n  \n\nHence,\n\n$$\nA\\cdot B\\cdot C=(-2)\\cdot 7\\cdot 5=-70.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-51143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221"] :knowledge-point/questions ["q-51143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84945/selection/662c277f350ac1a8ffcfa5efcf73a8a540e2cf3e387c66c7db66386198588dd2" :answer/id #uuid "8c136325-690d-5b2c-a6ff-5ec0ea27289a" :answer/type :answer.type/math :answer/value "(4,4)" :db/ensure [:answer/validate]} {:db/id "q-84945/selection/c7d7f5865a04f287adfbc7ccac92458329d02c053e1fa27cc0df187ff8f49c48" :answer/id #uuid "2f1f0d7f-f055-5f02-834c-121b439d7787" :answer/type :answer.type/math :answer/value "(0,-4)" :db/ensure [:answer/validate]} {:db/id "q-84945/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :answer/id #uuid "d877753f-ce20-5bca-b819-7c271f4b3957" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "q-84945/selection/a8788fd8e34948fc62a48231115f6871c4669aeea6791478c777440a3acb8fd7" :answer/id #uuid "4dd78298-47df-5924-95e2-6b935ce9ef37" :answer/type :answer.type/math :answer/value "(4,-4)" :db/ensure [:answer/validate]} {:db/id "q-84945/selection/566c033cc670f2eeb576d333926890b0dcdb71cae9a92ce2d64ad76e8173074e" :answer/id #uuid "b4cb9a67-bc7a-56e2-a540-0f3233180042" :answer/type :answer.type/math :answer/value "(4,0)" :db/ensure [:answer/validate]} {:db/id "q-84945/selection" :answer-field/id #uuid "9260d972-91af-50bc-920e-14cb4d09fd14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84945/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :answer-field/choices ["q-84945/selection/662c277f350ac1a8ffcfa5efcf73a8a540e2cf3e387c66c7db66386198588dd2" "q-84945/selection/c7d7f5865a04f287adfbc7ccac92458329d02c053e1fa27cc0df187ff8f49c48" "q-84945/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" "q-84945/selection/a8788fd8e34948fc62a48231115f6871c4669aeea6791478c777440a3acb8fd7" "q-84945/selection/566c033cc670f2eeb576d333926890b0dcdb71cae9a92ce2d64ad76e8173074e"]