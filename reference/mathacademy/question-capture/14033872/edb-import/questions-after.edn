#{[{:db/id #edb/ref 17592186295626 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8841e453-14d2-5cac-9fbc-00db111a57dd" :answer/type {:db/ident :answer.type/math} :answer/value "21\\,\\text{m/s}" :db/id #edb/ref 17592186295628} {:answer/id #uuid "6b020559-c908-552c-afc9-48f7d78db5ba" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{m/s}" :db/id #edb/ref 17592186295629} {:answer/id #uuid "d82ad59d-066d-56ba-b7cb-8804951691c4" :answer/type {:db/ident :answer.type/math} :answer/value "19\\,\\text{m/s}" :db/id #edb/ref 17592186295630} {:answer/id #uuid "c668d751-13fc-53b6-b162-5861350f8ab7" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,\\text{m/s}" :db/id #edb/ref 17592186295631} {:answer/id #uuid "d17faf2c-932d-5b71-838c-07f9cb4cdd99" :answer/type {:db/ident :answer.type/math} :answer/value "27\\,\\text{m/s}" :db/id #edb/ref 17592186295632}] :answer-field/correct {:answer/id #uuid "8841e453-14d2-5cac-9fbc-00db111a57dd" :answer/type {:db/ident :answer.type/math} :answer/value "21\\,\\text{m/s}" :db/id #edb/ref 17592186295628} :answer-field/id #uuid "df605953-16a2-5a27-9732-d5236ffecc02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295627}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a35c600c-2a9c-5614-9593-1a6e8005af53" :question/math-academy-id "q-2355" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by the equation $s(t)={t}^{3}-{t}^{2}-15$ where $t$ is measured in seconds.  Find the velocity after $t=3\\,\\text{s}.$" :question/requires-calculator true :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2}-15) \\\\  & =3{t}^{2}-2t\\end{aligned}\n$$\n\nTo calculate the velocity at $t=3\\,\\text{s},$ we substitute $t=3$ into the velocity function above:\n\n$$\n\\begin{aligned}v(3) & =3(3)^{2}-2(3) \\\\  & =27-6 \\\\  & =21\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295633 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b04084c-8e69-5f53-a95d-664aba54aec9" :knowledge-point/title "Converting from Cartesian Coordinates to Polar Coordinates: Second or Third Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00fc0b66-1d6e-5667-a136-ffd88df0a21c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186295635}] :answer-field/correct {:answer/id #uuid "00fc0b66-1d6e-5667-a136-ffd88df0a21c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186295635} :answer-field/id #uuid "1956ad66-c9e6-5518-b274-33a853a6de8e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295634} {:answer-field/choices [{:answer/id #uuid "231f62ad-0b8a-5bcb-a26c-214329941c2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{4}" :db/id #edb/ref 17592186295637}] :answer-field/correct {:answer/id #uuid "231f62ad-0b8a-5bcb-a26c-214329941c2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{4}" :db/id #edb/ref 17592186295637} :answer-field/id #uuid "aa4d13ed-e148-5e95-b307-e95427e73ecc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295636}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87be17c2-32bc-57f0-80a6-2537d5aa413b" :question/math-academy-id "q-275807" :question/problem "A point $P$ has Cartesian coordinates $(-1,-1).$ Find the polar coordinates of $P.$ Give the polar angle in radians and do not round the answer.\n\nThe polar coordinates of $P$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we determine $r:$\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nFor the reference angle, we get\n\n$$\n\\begin{aligned}{\\theta }_{R} & =|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =|\\operatorname{arctan}⁡(\\frac{-1}{-1})| \\\\  & =|\\operatorname{arctan}⁡(1)| \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nSince the point $P$ lies in the third quadrant, we add the reference angle to $\\pi ,$ and we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the polar coordinates of $P$ are  $(\\sqrt{2},\\frac{5\\pi }{4}).$"}] [{:db/id #edb/ref 17592186295638 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e79aae-7c07-515c-bede-4125eac8b9d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186295640}] :answer-field/correct {:answer/id #uuid "56e79aae-7c07-515c-bede-4125eac8b9d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186295640} :answer-field/id #uuid "9681bfab-c84a-5526-a7bd-30f413bbf72e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295639} {:answer-field/choices [{:answer/id #uuid "03d470ef-fe39-5944-a4ff-0e6bbcc1d23e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295642}] :answer-field/correct {:answer/id #uuid "03d470ef-fe39-5944-a4ff-0e6bbcc1d23e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295642} :answer-field/id #uuid "b02ac64b-d19e-5e59-822c-62ac17724d61" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295641} {:answer-field/choices [{:answer/id #uuid "1f597396-180c-5146-b5da-67a094e27c13" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295644}] :answer-field/correct {:answer/id #uuid "1f597396-180c-5146-b5da-67a094e27c13" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295644} :answer-field/id #uuid "dca77ee2-01cd-5e52-87e5-98e22fa5040c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295643} {:answer-field/choices [{:answer/id #uuid "6fbd109a-9208-53e3-9213-27fdebcfe7fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295646}] :answer-field/correct {:answer/id #uuid "6fbd109a-9208-53e3-9213-27fdebcfe7fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295646} :answer-field/id #uuid "51544716-cf91-56a1-8585-42a84f439e2e" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295645}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aeeb52fb-999e-570f-bb95-972c0c9756ab" :question/math-academy-id "q-326300" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3-\\frac{1}{2}t,\\,y=\\frac{3}{4}{t}^{2}-1,\\,t\\ge 2.\n$$\n\nDetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $3-\\frac{1}{2}t\\le 2$ for all $t\\ge 2.$ Consequently, the range of $x$ is\n\n$$\nx\\le 2.\n$$\n\n- To find the range of $y,$ note that $\\frac{3}{4}{t}^{2}-1\\ge 2$ for all $t\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$"}] [{:db/id #edb/ref 17592186295647 :knowledge-point/_questions [{:knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49bb5a2f-4855-5f1e-9bc6-ff3ad87887e4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186295649} {:answer/id #uuid "c7e5d511-7fb4-55b8-b12d-74caedaebb60" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186295650} {:answer/id #uuid "4cac7b5a-4994-57aa-a769-e16c81994a99" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5\\pi }{2}" :db/id #edb/ref 17592186295651} {:answer/id #uuid "59e5f508-e91d-5a55-b9f5-58de45027098" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186295652} {:answer/id #uuid "ee3143ce-d9c3-586f-b1bb-96a91734bd3b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295653}] :answer-field/correct {:answer/id #uuid "ee3143ce-d9c3-586f-b1bb-96a91734bd3b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295653} :answer-field/id #uuid "3a736c53-127e-5c29-a3cb-31729a82f496" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295648}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "85756dae-26e9-50b7-9d78-b26ca79ca09b" :question/math-academy-id "q-42432" :question/problem "The minimum value of $y=\\operatorname{arccos}⁡x$ is" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033872/assets/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nFrom the graph, we see that the minimum value is $0.$"}] [{:db/id #edb/ref 17592186295654 :knowledge-point/_questions [{:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10824ecc-6409-5de5-a34c-fc83b34d2292" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186295656} {:answer/id #uuid "e1a53c54-5066-5ff8-8a99-c359bc0d171f" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186295657} {:answer/id #uuid "1b587f92-8674-5571-b45c-e2df71c02ae3" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186295658} {:answer/id #uuid "b3ed7003-c364-5fcc-9889-cc2e0375634f" :answer/type {:db/ident :answer.type/math} :answer/value "-56" :db/id #edb/ref 17592186295659} {:answer/id #uuid "2af4b394-baf1-59f3-8616-574c2e3526c1" :answer/type {:db/ident :answer.type/math} :answer/value "-70" :db/id #edb/ref 17592186295660}] :answer-field/correct {:answer/id #uuid "2af4b394-baf1-59f3-8616-574c2e3526c1" :answer/type {:db/ident :answer.type/math} :answer/value "-70" :db/id #edb/ref 17592186295660} :answer-field/id #uuid "88d8e430-d5a3-572a-9807-7705d10cd994" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295655}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "83d87495-9a05-50e5-8fdd-f9cab6c7f065" :question/math-academy-id "q-51143" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}+31}{(x-2)^{2}(2x+1)}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}+\\frac{C}{2x+1},\n$$\n\nwhere $A$, $B$, and $C$ are real constants, determine the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-2)^{2}(2x+1)$ gives\n\n$$\n\\begin{aligned}{x}^{2}+31 & =A(x-2)(2x+1)+B(2x+1)+C(x-2)^{2}.\\end{aligned}\n$$\n\nLetting $x=-\\frac{1}{2}$  gives\n\n$$\n\\begin{aligned}{(-\\frac{1}{2})}^{2}+31 & =A(-\\frac{1}{2}-2)(2[-\\frac{1}{2}]+1)+B(2[-\\frac{1}{2}]+1)+C{(-\\frac{1}{2}-2)}^{2} \\\\ \\frac{1}{4}+31 & =A(-\\frac{5}{2})(-1+1)+B(-1+1)+C(\\frac{25}{4}) \\\\ \\frac{125}{4} & =\\frac{25C}{4} \\\\ C & =5.\\end{aligned}\n$$\n\nLetting $x=2$  gives\n\n$$\n\\begin{aligned}{2}^{2}+31 & =A(2-2)(2\\cdot 2+1)+B(2\\cdot 2+1)+C(2-2)^{2} \\\\ 35 & =5B \\\\ B & =7.\\end{aligned}\n$$\n\nFinally, letting $x=0$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}{0}^{2}+31 & =A(0-2)(2\\cdot 0+1)+7(2\\cdot 0+1)+5(0-2)^{2} \\\\ 31 & =-2A+7+20 \\\\ 31 & =-2A+27 \\\\ 2A & =-4 \\\\ A & =-2.\\end{aligned}\n$$\n\n  \n\nHence,\n\n$$\nA\\cdot B\\cdot C=(-2)\\cdot 7\\cdot 5=-70.\n$$"}] [{:db/id #edb/ref 17592186295661 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c125a5a5-8271-59c3-9800-80ad4d2843fc" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/id #edb/ref 17592186295663} {:answer/id #uuid "f2d0c68a-c850-569e-a733-32f932a25ac8" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)" :db/id #edb/ref 17592186295664} {:answer/id #uuid "ceda6317-8baf-551c-946b-46ae06be5c21" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/id #edb/ref 17592186295665} {:answer/id #uuid "7d76f508-4f55-5208-8ac6-ca8accf35a1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{5x+2}{5x-2}|)" :db/id #edb/ref 17592186295666} {:answer/id #uuid "87bb3c8d-8a47-5438-9e70-f82ca2fafcff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)" :db/id #edb/ref 17592186295667}] :answer-field/correct {:answer/id #uuid "87bb3c8d-8a47-5438-9e70-f82ca2fafcff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)" :db/id #edb/ref 17592186295667} :answer-field/id #uuid "bd9694e0-d3c3-51b8-90eb-92f7591fe930" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295662}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "cf0f2822-a0a9-5330-824d-28888a01fcc3" :question/math-academy-id "q-72450" :question/problem "Calculate $\\int (\\frac{1}{5x+2}+\\frac{1}{5x-2})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{5x+2}+\\frac{1}{5x-2})\\,\\text{d}x & =\\int \\frac{1}{5x+2}\\,\\text{d}x+\\int \\frac{1}{5x-2}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|5x+2|+\\frac{1}{5}\\operatorname{ln}⁡|5x-2|+C \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|(5x+2)(5x-2)|+\\frac{1}{5}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡(K|(5x+2)(5x-2)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186295668 :knowledge-point/_questions [{:knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d877753f-ce20-5bca-b819-7c271f4b3957" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186295670} {:answer/id #uuid "b4cb9a67-bc7a-56e2-a540-0f3233180042" :answer/type {:db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186295671} {:answer/id #uuid "8c136325-690d-5b2c-a6ff-5ec0ea27289a" :answer/type {:db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186295672} {:answer/id #uuid "4dd78298-47df-5924-95e2-6b935ce9ef37" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186295673} {:answer/id #uuid "2f1f0d7f-f055-5f02-834c-121b439d7787" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186295674}] :answer-field/correct {:answer/id #uuid "d877753f-ce20-5bca-b819-7c271f4b3957" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186295670} :answer-field/id #uuid "9260d972-91af-50bc-920e-14cb4d09fd14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295669}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1af08287-9090-5d1a-b49e-7e59f6b11f30" :question/math-academy-id "q-84945" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033872/assets/af70455b167391a2fec7d0169f578c26079efcd002c2bea501b9460bc0c124f0.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a right-opening parabola is the left-most point of the parabola.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033872/assets/41347b34b0680bdfcab2d1e002c6c41580eaef0b05901d4fc69ab508f786d1b5.png)\n\nTherefore, the coordinates of the vertex are $(0,0).$"}]}
