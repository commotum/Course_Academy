{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nFor the reference angle, we get\n\n$$\n\\begin{aligned}{\\theta }_{R} & =|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =|\\operatorname{arctan}⁡(\\frac{-1}{-1})| \\\\  & =|\\operatorname{arctan}⁡(1)| \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nSince the point $P$ lies in the third quadrant, we add the reference angle to $\\pi ,$ and we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the polar coordinates of $P$ are  $(\\sqrt{2},\\frac{5\\pi }{4}).$" 13194139534563 true] [17592186295634 1000 #edb/ref 17592186295635 13194139534563 true] [17592186295634 1040 #edb/ref 17592186045449 13194139534563 true] [17592186295634 1041 "field-1" 13194139534563 true] [17592186295634 1104 #edb/ref 17592186295635 13194139534563 true] [17592186295634 1110 #uuid "1956ad66-c9e6-5518-b274-33a853a6de8e" 13194139534563 true] [17592186295635 1034 "\\sqrt{2}" 13194139534563 true] [17592186295635 1103 #edb/ref 17592186045453 13194139534563 true] [17592186295635 1111 #uuid "00fc0b66-1d6e-5667-a136-ffd88df0a21c" 13194139534563 true] [17592186295636 1000 #edb/ref 17592186295637 13194139534563 true] [17592186295636 1040 #edb/ref 17592186045449 13194139534563 true] [17592186295636 1041 "field-2" 13194139534563 true] [17592186295636 1104 #edb/ref 17592186295637 13194139534563 true] [17592186295636 1110 #uuid "aa4d13ed-e148-5e95-b307-e95427e73ecc" 13194139534563 true] [17592186295637 1034 "\\frac{5\\pi}{4}" 13194139534563 true] [17592186295637 1103 #edb/ref 17592186045453 13194139534563 true] [17592186295637 1111 #uuid "231f62ad-0b8a-5bcb-a26c-214329941c2b" 13194139534563 true] [17592186295638 1017 #edb/ref 17592186295639 13194139534563 true] [17592186295638 1017 #edb/ref 17592186295641 13194139534563 true] [17592186295638 1017 #edb/ref 17592186295643 13194139534563 true] [17592186