 | $x>0$ |"}] [{:db/id #edb/ref 17592186296075 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d" :knowledge-point/title "Identifying Regions Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea4b9e9-58db-57f3-a47b-39940a5dbe45" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186296077} {:answer/id #uuid "aa0871e5-92b1-5f7b-ac96-12cd81cf7ffa" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186296078}] :answer-field/correct {:answer/id #uuid "aa0871e5-92b1-5f7b-ac96-12cd81cf7ffa" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186296078} :answer-field/id #uuid "86c93f16-fb90-58ba-88e3-dc6789963dd9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186296076} {:answer-field/choices [{:answer/id #uuid "62218f2c-d861-5664-baa2-b53e63a953ce" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186296080} {:answer/id #uuid "45c4b0e4-8361-5ad6-b6d8-ea822de8524f" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186296081}] :answer-field/correct {:answer/id #uuid "45c4b0e4-8361-5ad6-b6d8-ea822de8524f" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186296081} :answer-field/id #uuid "35fbffde-411d-568a-a82d-0dcb710fda1a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186296079} {:answer-field/choices [{:answer/id #uuid "53b7d749-0678-582e-b04b-a3f0e5bd3cd5" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186296083} {:answer/id #uuid "06e5dc90-1f2f-5b2d-8433-f7b684203e67" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186296084}] :answer-field/correct {:answer/id #uuid "53b7d749