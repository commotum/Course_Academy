e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-120971" "field" nil "attribute" "question/problem" "value" "Consider the expression $f(x,y)=(x-2)(y+1)^{2}.$  What are the missing entries in the sign table of $f(x,y),$ shown below?\n\n| $y>-1$ |  |  |\n| --- | --- | --- |\n| $y<-1$ |  |  |\n|  | $x<2$ | $x>2$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-120971" "field" nil "attribute" "question/worked-solution" "value" "Notice that $f(x,y)$ equals zero when $x=2$ and $y=-1.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/a66a57932dbc935b5ed6f74b4f0faa0047c4b7ef58ded46be088dad30fa5eee4.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/52efe97fcffa3da05151b3ffef5305e0c3ec0d567d3f62b964a30740c08a3981.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x-2)$ | $(y+1)^{2}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-left | $(-2,1)$ | $-$ | $+$ | $-$ |\n| Top-Right | $(4,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-2,-3)$ | $-$ | $+$ | $-$ |\n| Bottom-Right | $(4,-3)$ | $+$ | $+$ | $+$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/aa100568c18b31507c775e77ed3201a5aed6f708b541e48046617a43fe9a8304.png)\n\nFinally, we fill in the required sign table.\n\n| $y>-1$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $+$ |\n|  | $x<2$ | $x>2$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-120971" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/activity-metadata.json" "file_sha256" "7411d52c7bd30ff865d94a19d5eafd0f7c62f4ed05a70bb40cc33d87ccff4fc1"} {"question" "q-120971" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-120971" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |"] ["text" "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |"] ["text" "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |"] ["text" "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |"] ["text" "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-120971" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-149553" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x,y)=x(2-y).$ Which of the following shaded areas gives the solution to the inequality $f(x,y)>0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-149553" "field" nil "attribute" "question/worked-solution" "value" "Notice that $f(x,y)$ equals zero when $x=0$ and $y=2.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have a strict inequality, we use dashed lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/41f10e527834d0767709b965150054a564eaee9c174204381ed94b0e43077fe0.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/994e35e23e56191ef06a155912a326d28d857f236308655265d18d17bb48531b.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $x$ | $(2-y)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,3)$ | $-$ | $-$ | $+$ |\n| Top-Right | $(1,3)$ | $+$ | $-$ | $-$ |\n| Bottom-Left | $(-1,1)$ | $-$ | $+$ | $-$ |\n| Bottom-Right | $(1,1)$ | $+$ | $+$ | $+$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y)>0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/9710358526e0e14fbf7263ba5d1496cdcb2941f9cb32a1d07b2ea37865163ab2.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-149553" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/activity-metadata.json" "file_sha256" "7411d52c7bd30ff865d94a19d5eafd0f7c62f4ed05a70bb40cc33d87ccff4fc1"} {"question" "q-149553" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-149553" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/02a01c1a57b61374e7f9c44b7609f7c0b48c9f91a44ffd0d4a86afeb0909ed68.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/330f6080a3640f193e3d1650405030c049f059aaa9e3c6f280d2355382ed2e69.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/ba2d7fbeb1a79d32f499e3c3ae81595e4a58fdd4486c6e558fc129fe0e5b3385.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/d1958e53fc544743a537eccab139fa33716823e3b57b4aeac90c3b17ec7e8e48.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/ff554d3264fe5aeb9cca37a143888c8eb7a7e31f9bcdb3f8512309e45397aeb2.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-149553" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/ba2d7fbeb1a79d32f499e3c3ae81595e4a58fdd4486c6e558fc129fe0e5b3385.png"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-121267" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x,y)=(x+2)(y-1).$ Which of the following shaded areas gives the solution to the inequality $f(x,y)\\le 0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-121267" "field" nil "attribute" "question/worked-solution" "value" "Notice that $f(x,y)$ equals zero when $x=-2$ and $y=1.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have an \"or equal to\" inequality, we use solid lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/ce8f784a51d18fd9ea97672b6642b643947845e87b0a4d4c7dd291fcb18f50ed.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/c53a92d71b292288e566db12011c13569ebee65e879598e10b6a14e3acd4f189.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x+2)$ | $(y-1)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-left | $(-3,2)$ | $-$ | $+$ | $-$ |\n| Top-Right | $(-1,2)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-3,0)$ | $-$ | $-$ | $+$ |\n| Bottom-Right | $(-1,0)$ | $+$ | $-$ | $-$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y)\\le 0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/assets/4d65d4c9829b7161152722b7cf6e8605c1cace8078e53430f3480d5d16d74ec4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037232/state.json" "file_sha256" "c3566fde9b24eb1f95424406e0207ebca91dc14d0f2400140e3162e126723c74"} {"question" "q-121267" "field" nil "attribu