Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "514beb07-75c5-5147-895e-b5c2ea8287db" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=4x+4" :db/id #edb/ref 17592186245315} {:answer/id #uuid "cae5cdab-9cd4-5caa-89d6-e129e85e3f2f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-4x+1" :db/id #edb/ref 17592186245316} {:answer/id #uuid "5c217281-2115-5d36-821e-9cab4043140e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-2x+4" :db/id #edb/ref 17592186245317} {:answer/id #uuid "ae6d4836-48c1-589e-80ce-ea141874e38b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=x-\\frac{1}{4}" :db/id #edb/ref 17592186245318} {:answer/id #uuid "57186b05-2ab8-552b-a265-1963c714c682" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+1}{4}" :db/id #edb/ref 17592186245319}] :answer-field/correct {:answer/id #uuid "514beb07-75c5-5147-895e-b5c2ea8287db" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=4x+4" :db/id #edb/ref 17592186245315} :answer-field/id #uuid "6e9d85c7-6bfb-59ec-b26b-503715132795" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245314}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c52666cc-5406-50c8-942e-f5363c466d39" :question/is-example false :question/math-academy-id "q-109454" :question/problem "What is the inverse of $f(x)=\\frac{1}{4}x-1?$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=\\frac{1}{4}x-1\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=\\frac{1}{4}y-1\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =\\frac{1}{4}y-1 \\\\ x+1 & =\\frac{1}{4}y \\\\ 4(x+1) & =y \\\\ 4x+4 & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=4x+4\n$$"}] [{:db/id #edb/ref 17592186245320 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2886f6dd-206b-571d-bc2b-72f33c5393de" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-\\frac{x+2a}{3}" :db/id #edb/ref 17592186245322} {:answer/id #uuid "f9aeb75d-0a7b-5cb3-a183-2705b9e16e99" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-\\frac{x+3}{2a}" :db/id #edb/ref 17592186245323} {:answer/id #uuid "805d6f6d-ca16-557a-b1ea-7000b3a6f161" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{2x+3}{a}" :db/id #edb/ref 17592186245324} {:answer/id #uuid "30e2542e-d2b2-54a4-bfd0-98b33e409e43" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-3ax+2" :db/id #edb/ref 17592186245325} {:answer/id #uuid "643d23ff-869d-5845-9ee7-ee2158bbe94e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=3x+2a" :db/id #edb/ref 17592186245326}] :answer-field/correct {:answer/id #uuid "f9aeb75d-0a7b-5cb3-a183-2705b9e16e99" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-\\frac{x+3}{2a}" :db/id #edb/ref 17592186245323} :answer-field/id #uuid "4e80b794-551c-52c4-ab96-696e8d3748ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245321}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d509e5bd-e880-5b25-ab3e-cc16ea098595" :question/is-example false :question/math-academy-id "q-109477" :question/problem "Find the inverse of the function $f(x)=-2ax-3$, where $a$ is a constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-2ax-3\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-2ay-3\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-2ay-3 \\\\ x+3 & =-2ay \\\\ \\frac{x+3}{2a} & =-y \\\\ -\\frac{x+3}{2a} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=-\\frac{x+3}{2a}\n$$"}] [{:db/id #edb/ref 17592186245327 :knowledge-point/_questions [{:knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e1e967-66d2-5274-b9f5-d36d7111f80e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-6}{4}" :db/id #edb/ref 17592186245329} {:answer/id #uuid "c0dddb18-c7a7-543f-80a0-326642b07334" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+4}{6}" :db/id #edb/ref 17592186245330} {:answer/id #uuid "43b141f9-6946-5d56-b544-1ea5007a8fb2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=6x-4" :db/id #edb/ref 17592186245331} {:answer/id #uuid "3ea4a59f-ebca-522f-906d-50ea7624c48e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-4}{6}" :db/id #edb/ref 17592186245332} {:answer/id #uuid "57678d5f-b695-5f27-9081-4270cfb0d7a9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+6}{4}" :db/id #edb/ref 17592186245333}] :answer-field/correct {:answer/id #uuid "57678d5f-b695-5f27-9081-4270cfb0d7a9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+6}{4}" :db/id #edb/ref 17592186245333} :answer-field/id #uuid "a7ad0ecb-f4af-57ed-b713-a901e8e863d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245328}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e7e0c209-34f9-526f-a606-d6bbce41fb96" :question/is-example false :question/math-academy-id "q-19229" :question/problem "For the function $f(x)$ defined by $f(x)=4x-6,$ find ${f}^{-1}(x).$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=4x-6\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=4y-6\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =4y-6 \\\\ x+6 & =4y \\\\ \\frac{x+6}{4} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+6}{4}\n$$"}] [{:db/id #edb/ref 17592186245334 :knowledge-point/_questions [{:knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747f95c7-7cab-512c-8073-ce45ec92471a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7-x}{3}" :db/id #edb/ref 17592186245336} {:answer/id #uuid "d491d318-12a3-5e31-b12a-0bf5dc4be652" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-7}{3}" :db/id #edb/ref 17592186245337}] :answer-field/correct {:answer/id #uuid "747f95c7-7cab-512c-8073-ce45ec92471a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7-x}{3}" :db/id #edb/ref 17592186245336} :answer-field/id #uuid "83eb4797-53cd-5f5d-8151-2c9221c7e2e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245335}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fc9e0952-a01a-5729-b7fc-30222788484f" :question/is-example false :question/math-academy-id "q-218691" :question/problem "If $f(x)=-3x+7$, then ${f}^{-1}(x)=${{field-1}}." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-3x+7\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-3y+7\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-3y+7 \\\\ 3y & =7-x \\\\ y & =\\frac{7-x}{3}\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{7-x}{3}\n$$"}] [{:db/id #edb/ref 17592186245338 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "948e2739-6542-50ba-86d7-52000a790b11" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-a}{7}" :db/id #edb/ref 17592186245340} {:answer/id #uuid "413bcc69-3575-56dd-bb08-30639bd256d0" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=7x-a" :db/id #edb/ref 17592186245341} {:answer/id #uuid "cf548679-8b2a-58cb-98ad-12d6b4fed971" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+a}{7}" :db/id #edb/ref 17592186245342} {:answer/id #uuid "d7b699cc-8656-5fd8-8449-b81d2f9a833c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+7}{a}" :db/id #edb/ref 17592186245343} {:answer/id #uuid "28ac7ff7-38ef-5c48-9ac2-665850728f64" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-7}{a}" :db/id #edb/ref 17592186245344}] :answer-field/correct {:answer/id #uuid "d7b699cc-8656-5fd8-8449-b81d2f9a833c" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+7}{a}" :db/id #edb/ref 17592186245343} :answer-field/id #uuid "628b5316-2c86-5781-988c-46c188a37fe5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245339}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8e10b964-3192-563c-831f-b2d2c1769415" :question/is-example false :question/math-academy-id "q-35217" :question/problem "Find the inverse of the function $f(x)=ax-7$, where $a$ is a non-zero constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=ax-7\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=ay-7\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =ay-7 \\\\ x+7 & =ay \\\\ \\frac{x+7}{a} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+7}{a}\n$$"}] [{:db/id #edb/ref 17592186078795 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a879ba4e-6c50-5667-a17a-be6032bc3392" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11" :db/id #edb/ref 17592186075982} {:answer/id #uuid "b0843259-1ea2-58d5-9eeb-2f189db80f9b" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11a" :db/id #edb/ref 17592186075983} {:answer/id #uuid "c768557c-9f45-51e8-a776-665284a6decd" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax + 11a" :db/id #edb/ref 17592186075984} {:answer/id #uuid "dc80b464-cb36-502a-8b9b-ce05ec3b5764" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = x + 11a" :db/id #edb/ref 17592186075985} {:answer/id #uuid "765d0c1f-af2b-5328-b161-f0037ec4e4e0" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax + 11" :db/id #edb/ref 17592186075986}] :answer-field/correct {:answer/id #uuid "b0843259-1ea2-58d5-9eeb-2f189db80f9b" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11a" :db/id #edb/ref 17592186075983} :answer-field/id #uuid "0007c7b3-fe23-5c25-81c2-866612751d0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186075981}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "40530ca3-e238-5640-94b0-1433afa01d34" :question/is-example false :question/math-academy-id "q-35310" :question/problem "Find the inverse of the function $f(x) = \\frac{x}{a} + 11$, where $a$ is a non-zero constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=\\frac{x}{a}+11\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=\\frac{y}{a}+11\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =\\frac{y}{a}+11 \\\\ x-11 & =\\frac{y}{a} \\\\ a(x-11) & =y \\\\ ax-11a & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=ax-11a\n$$"}] [{:db/id #edb/ref 17592186245345 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e950bb7-fee4-5318-9686-d4e9957614fd" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-4b}{3}" :db/id #edb/ref 17592186245347} {:answer/id #uuid "70004b5c-5a1b-5446-8c29-e01339112e76" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+3b}{4}" :db/id #edb/ref 17592186245348} {:answer/id #uuid "3900e3fe-dd2e-5c77-b181-fad29c847944" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+4}{3b}" :db/id #edb/ref 17592186245349} {:answer/id #uuid "c0f26eb9-fa6d-5cba-8110-64d97bdc42c7" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-3b}{4}" :db/id #edb/ref 17592186245350} {:answer/id #uuid "c8b6a2bc-8b27-5edb-b3e9-25385eb39192" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=3x-4b" :db/id #edb/ref 17592186245351}] :answer-field/correct {:answer/id #uuid "c0f26eb9-fa6d-5cba-8110-64d97bdc42c7" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-3b}{4}" :db/id #edb/ref 17592186245350} :answer-field/id #uuid "cb701f48-5747-5925-9d65-374338f1d4f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245346}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "422ca3c0-35fa-555b-99f6-696ddea7b92e" :question/is-example false :question/math-academy-id "q-35323" :question/problem "Find the inverse of the function $f(x)=4x+3b$, where $b$ is a constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=4x+3b\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=4y+3b\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =4y+3b \\\\ x-3b & =4y \\\\ \\frac{x-3b}{4} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x-3b}{4}\n$$"}] [{:db/id #edb/ref 17592186245352 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9e98841-bf86-5cd2-9cee-4765fb8e898b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=2(x+b)" :db/id #edb/ref 17592186245354} {:answer/id #uuid "7231edb9-accc-54c7-9bc5-47507b554bc7" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=2(x-b)" :db/id #edb/ref 17592186245355} {:answer/id #uuid "f81730df-48c7-5686-bd26-c7d2a7335c4b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-\\frac{x+b}{2}" :db/id #edb/ref 17592186245356} {:answer/id #uuid "668f2e07-70d8-5349-adb1-55c9063d0482" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-b}{2}" :db/id #edb/ref 17592186245357} {:answer/id #uuid "fea40a3e-0087-5130-9872-79b893c1f26f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+b}{2}" :db/id #edb/ref 17592186245358}] :answer-field/correct {:answer/id #uuid "fea40a3e-0087-5130-9872-79b893c1f26f" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+b}{2}" :db/id #edb/ref 17592186245358} :answer-field/id #uuid "1f76c334-6d20-59ae-948b-7faf7c09e797" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245353}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5a481124-f294-5b5c-9445-2f90ea3685fb" :question/is-example false :question/math-academy-id "q-66876" :question/problem "Find the inverse of the function $f(x)=2x-b$, where $b$ is a constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=2x-b\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=2y-b\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =2y-b \\\\ x+b & =2y \\\\ \\frac{x+b}{2} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+b}{2}\n$$"}] [{:db/id #edb/ref 17592186245359 :knowledge-point/_questions [{:knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "330fb31f-6fa1-531c-b0eb-01d10f24b5b5" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=5x-4" :db/id #edb/ref 17592186245361} {:answer/id #uuid "3b622755-7962-5131-87b8-e35683ee1675" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-5}{4}" :db/id #edb/ref 17592186245362} {:answer/id #uuid "4613cc1b-018f-5d26-b989-2011d1571a28" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=-5x+4" :db/id #edb/ref 17592186245363} {:answer/id #uuid "94734ed3-596e-578c-9c3d-6ea2669921e2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+5}{4}" :db/id #edb/ref 17592186245364} {:answer/id #uuid "8990a417-e513-54fa-af25-a3ca6d1d3d3e" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+3}{2}" :db/id #edb/ref 17592186245365}] :answer-field/correct {:answer/id #uuid "94734ed3-596e-578c-9c3d-6ea2669921e2" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{-x+5}{4}" :db/id #edb/ref 17592186245364} :answer-field/id #uuid "0b178d96-919f-557a-a96b-2b6896dff137" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245360}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8cbf7aea-3141-5c94-a26f-5d2ecaa8695b" :question/is-example false :question/math-academy-id "q-7026" :question/problem "For the function $f(x)$ defined by $f(x)=-4x+5,$ find ${f}^{-1}(x).$" :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-4x+5\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-4y+5\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-4y+5 \\\\ 4y & =-x+5 \\\\ y & =\\frac{-x+5}{4}\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{-x+5}{4}\n$$"}]}
