#{[{:db/id #edb/ref 17592186078208 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "15cd299b-c720-5bf6-814c-2bef2c839e48" :knowledge-point/title "Finding the Inverse of a Linear Function"}] :question/id #uuid "2fd3c4ba-850d-5d6d-872b-1e05386855e2" :question/is-example true :question/math-academy-id "e-3968" :question/problem "Find the inverse of $f(x) = 3x - 4$." :question/worked-solution "To find the inverse of a function, we follow the four steps below.\n\n**Step 1:** Replace $f(x)$ with $y$.\n$y = 3x-4$\n\n**Step 2:** Swap $x$ and $y$.\n$x = 3y-4$\n\n**Step 3:** Solve for $y$.\n\n$$\n\\begin{aligned}\nx &= 3y - 4 \\\\\nx + 4 &= 3y \\\\\n\\frac{x + 4}{3} &= y\n\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with $f^{-1}(x)$.\n\n$$\nf^{-1}(x) = \\dfrac {x + 4} {3}\n$$"}] [{:db/id #edb/ref 17592186078209 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/id #uuid "096eb672-5a54-565f-91d7-1072e4ce7136" :question/is-example true :question/math-academy-id "e-3970" :question/problem "Find the inverse of the function $f(x) = bx-5$, where $b$ is a constant." :question/worked-solution "To find the inverse of a function, we follow the four steps below.\n\n**Step 1:** Replace $f(x)$ with $y$.\n$y = bx- 5$\n\n**Step 2:** Swap $x$ and $y$.\n$x = by- 5$\n\n**Step 3:** Solve for $y$.\n\n$$\n\\begin{aligned}\nx &= by - 5 \\\\\nx + 5 &= by \\\\\n\\frac{x + 5}{b} &= y\n\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with $f^{-1}(x)$.\n\n$$\nf^{-1}(x) = \\dfrac{x + 5}{b}\n$$"}] [{:db/id #edb/ref 17592186078795 :knowledge-point/_questions [{:knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a879ba4e-6c50-5667-a17a-be6032bc3392" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11" :db/id #edb/ref 17592186075982} {:answer/id #uuid "b0843259-1ea2-58d5-9eeb-2f189db80f9b" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11a" :db/id #edb/ref 17592186075983} {:answer/id #uuid "c768557c-9f45-51e8-a776-665284a6decd" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax + 11a" :db/id #edb/ref 17592186075984} {:answer/id #uuid "dc80b464-cb36-502a-8b9b-ce05ec3b5764" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = x + 11a" :db/id #edb/ref 17592186075985} {:answer/id #uuid "765d0c1f-af2b-5328-b161-f0037ec4e4e0" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax + 11" :db/id #edb/ref 17592186075986}] :answer-field/correct {:answer/id #uuid "b0843259-1ea2-58d5-9eeb-2f189db80f9b" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = ax - 11a" :db/id #edb/ref 17592186075983} :answer-field/id #uuid "0007c7b3-fe23-5c25-81c2-866612751d0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186075981}] :question/id #uuid "40530ca3-e238-5640-94b0-1433afa01d34" :question/is-example false :question/math-academy-id "q-35310" :question/problem "Find the inverse of the function $f(x) = \\frac{x}{a} + 11$, where $a$ is a non-zero constant."}]}
