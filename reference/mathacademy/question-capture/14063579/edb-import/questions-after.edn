#{[{:db/id #edb/ref 17592186346005 :knowledge-point/_questions [{:knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d" :knowledge-point/title "Solving for Unknowns By Computing a Product and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af0ec6e-cf10-54ad-bd9d-13286f48e6c1" :answer/type {:db/ident :answer.type/text} :answer/value "$p=2$, $q=3$" :db/id #edb/ref 17592186346007} {:answer/id #uuid "68905735-e7ea-524a-b463-19e9757e92fa" :answer/type {:db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186346008} {:answer/id #uuid "3aa5fa2f-dd5b-584a-96a6-00fb7cb11a82" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-4$, $q=2$" :db/id #edb/ref 17592186346009} {:answer/id #uuid "1fabfeaf-bd4a-5896-91fd-d539db0f332f" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-3$, $q=2$" :db/id #edb/ref 17592186346010} {:answer/id #uuid "c95cc182-074c-5f4f-b186-0e8524d514f5" :answer/type {:db/ident :answer.type/text} :answer/value "$p=2$, $q=1$" :db/id #edb/ref 17592186346011}] :answer-field/correct {:answer/id #uuid "68905735-e7ea-524a-b463-19e9757e92fa" :answer/type {:db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186346008} :answer-field/id #uuid "2cba7e6f-7f8d-58f1-929c-d17b74ffe346" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346006}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2bd6d81b-eb1e-5f54-9fb0-b04584c1dccf" :question/math-academy-id "q-160037" :question/problem "Given that $3+5\\text{i}=\\frac{p+\\text{i}q}{1-\\text{i}},$ calculate $p$ and $q.$" :question/worked-solution "First, we multiply both sides of the equation by $1-\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}3+5\\text{i} & =\\frac{p+\\text{i}q}{1-\\text{i}} \\\\ (3+5\\text{i})(1-\\text{i}) & =p+\\text{i}q \\\\ 3-3\\text{i}+5\\text{i}-5{\\text{i}}^{2} & =p+\\text{i}q \\\\ 3+5+2\\text{i} & =p+\\text{i}q \\\\ 8+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n8=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}2 & =q.\\end{aligned}\n$$\n\nTherefore, $p=8$ and $q=2.$"}] [{:db/id #edb/ref 17592186346012 :knowledge-point/_questions [{:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc" :knowledge-point/title "Solving for Unknowns By Computing a Quotient and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0edc6a2-5686-52ed-b2d7-633c7aba7b96" :answer/type {:db/ident :answer.type/math} :answer/value "p=-2,q=2." :db/id #edb/ref 17592186346014} {:answer/id #uuid "0163662d-0bf7-5d92-9860-42ec091d2983" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{2},q=-\\frac{1}{2}." :db/id #edb/ref 17592186346015} {:answer/id #uuid "928b8f54-f349-59cf-9d86-de8d5c60211c" :answer/type {:db/ident :answer.type/math} :answer/value "p=-2,q=-2." :db/id #edb/ref 17592186346016} {:answer/id #uuid "a6b0b0ce-5ea4-5395-b82b-ecfabdd9a7ec" :answer/type {:db/ident :answer.type/math} :answer/value "p=2,q=-2." :db/id #edb/ref 17592186346017} {:answer/id #uuid "e60c2ba6-c688-597d-9401-f9bf451694aa" :answer/type {:db/ident :answer.type/math} :answer/value "p=2,q=2." :db/id #edb/ref 17592186346018}] :answer-field/correct {:answer/id #uuid "e60c2ba6-c688-597d-9401-f9bf451694aa" :answer/type {:db/ident :answer.type/math} :answer/value "p=2,q=2." :db/id #edb/ref 17592186346018} :answer-field/id #uuid "8eb04e97-4df9-5493-972b-93de3b744c81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346013}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1375dd24-f841-5355-82d9-cb6b560b27da" :question/math-academy-id "q-160046" :question/problem "Given that $8\\text{i}=(p+\\text{i}q)(2+2\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $2+2\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}8\\text{i} & =(p+\\text{i}q)(2+2\\text{i}) \\\\ \\frac{8\\text{i}}{2+2\\text{i}} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{8\\text{i}(2-2\\text{i})}{(2+2\\text{i})(2-2\\text{i})} & =p+\\text{i}q \\\\ \\frac{16\\text{i}-16{\\text{i}}^{2}}{{2}^{2}-(2\\text{i})^{2}} & =p+\\text{i}q \\\\ \\frac{16+16\\text{i}}{8} & =p+\\text{i}q \\\\ 2+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $2=p.$\n\n- Equating the imaginary parts, we get $2=q.$\n\nTherefore, $p=2$ and $q=2.$"}] [{:db/id #edb/ref 17592186346019 :knowledge-point/_questions [{:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc" :knowledge-point/title "Solving for Unknowns By Computing a Quotient and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9305fb72-7559-587b-9809-adad7241c32a" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-\\frac{1}{4}$, $q=\\frac{4}{3}$" :db/id #edb/ref 17592186346021} {:answer/id #uuid "7b47d49a-458e-5f58-87c0-3b613d260a41" :answer/type {:db/ident :answer.type/text} :answer/value "$p=\\frac{1}{4}$, $q=-\\frac{4}{3}$" :db/id #edb/ref 17592186346022} {:answer/id #uuid "8016c0a6-aeb5-5658-af15-95b82d5bfa0b" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-1$, $q=4$" :db/id #edb/ref 17592186346023} {:answer/id #uuid "e478750c-84ab-5ec4-85eb-adc29fd33ba7" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-4$, $q=3$" :db/id #edb/ref 17592186346024} {:answer/id #uuid "c4a41523-0311-5821-8bf5-91684700e8f9" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-\\frac{3}{4}$, $q=\\frac{5}{3}$" :db/id #edb/ref 17592186346025}] :answer-field/correct {:answer/id #uuid "9305fb72-7559-587b-9809-adad7241c32a" :answer/type {:db/ident :answer.type/text} :answer/value "$p=-\\frac{1}{4}$, $q=\\frac{4}{3}$" :db/id #edb/ref 17592186346021} :answer-field/id #uuid "d2cd6a2f-0e48-530e-892b-88d2800c10ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346020}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5ae6b72e-4f3a-5360-b3ad-6c86f1d1d672" :question/math-academy-id "q-16556" :question/problem "Given that $7-6\\text{i}=(4p-3q\\text{i})(1+2\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $1+2\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}7-6\\text{i} & =(4p-3q\\text{i})(1+2\\text{i}) \\\\ \\frac{7-6\\text{i}}{1+2\\text{i}} & =4p-3q\\text{i}\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{(7-6\\text{i})(1-2\\text{i})}{(1+2\\text{i})(1-2\\text{i})} & =4p-3q\\text{i}q \\\\ \\frac{7-14\\text{i}-6\\text{i}+12{\\text{i}}^{2}}{{1}^{2}-(2\\text{i})^{2}} & =4p-3q\\text{i} \\\\ \\frac{-5-20\\text{i}}{1+4} & =4p-3q\\text{i} \\\\ \\frac{-5-20\\text{i}}{5} & =4p-3q\\text{i} \\\\ -1-4\\text{i} & =4p-3q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $-1=4p.$\n\n- Equating the imaginary parts, we get $-4=-3q.$\n\nTherefore, $p=-\\frac{1}{4}$ and $q=\\frac{4}{3}.$"}] [{:db/id #edb/ref 17592186346026 :knowledge-point/_questions [{:knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d" :knowledge-point/title "Solving for Unknowns By Computing a Product and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09671d05-66a5-522c-93c0-6a26d313c00c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186346028} {:answer/id #uuid "8842ff50-a609-5e8c-9e0c-b0f6c9cbb56b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186346029}] :answer-field/correct {:answer/id #uuid "8842ff50-a609-5e8c-9e0c-b0f6c9cbb56b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186346029} :answer-field/id #uuid "5ef898cc-4bd9-5164-a3e9-b8d30ae9e922" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346027} {:answer-field/choices [{:answer/id #uuid "e38838bb-bee8-50b7-ae71-30baf9e4bee5" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186346031}] :answer-field/correct {:answer/id #uuid "e38838bb-bee8-50b7-ae71-30baf9e4bee5" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186346031} :answer-field/id #uuid "8f082297-6779-5b0a-87dc-70b8d16ae601" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346030}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1044a1d0-98e7-5450-9e35-d185a0aa30ac" :question/math-academy-id "q-280441" :question/problem "If  $-3+2\\text{i}=\\frac{p+q\\text{i}}{1-4\\text{i}},$ then$\\,p=$\n{{field-1}}\nand\n$q=$\n{{field-2}}." :question/worked-solution "First, we multiply both sides of the equation by $1-4\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}-3+2\\text{i}=\\frac{p+q\\text{i}}{1-4\\text{i}} \\\\ (-3+2\\text{i})(1-4\\text{i}) & =p+q\\text{i} \\\\ -3+12\\text{i}+2\\text{i}-8{\\text{i}}^{2} & =p+q\\text{i} \\\\ -3+8+14\\text{i} & =p+q\\text{i} \\\\ 5+14\\text{i} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n5=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}14 & =q.\\end{aligned}\n$$\n\nTherefore, $p=5$ and $q=14.$"}] [{:db/id #edb/ref 17592186346032 :knowledge-point/_questions [{:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc" :knowledge-point/title "Solving for Unknowns By Computing a Quotient and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe43f3da-ca8a-5737-9697-c2555ca096cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{3}" :db/id #edb/ref 17592186346034}] :answer-field/correct {:answer/id #uuid "fe43f3da-ca8a-5737-9697-c2555ca096cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{3}" :db/id #edb/ref 17592186346034} :answer-field/id #uuid "0d11e284-8c88-54c1-ba1d-dd2b876e788e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346033} {:answer-field/choices [{:answer/id #uuid "dd6630b2-ee66-53a2-9d72-29e6bdd99771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186346036}] :answer-field/correct {:answer/id #uuid "dd6630b2-ee66-53a2-9d72-29e6bdd99771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186346036} :answer-field/id #uuid "f819065f-bc67-5e45-a9a6-a3cf88a2557f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346035}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ebe88860-d242-5f5f-8ef9-d5441f44ff45" :question/math-academy-id "q-281168" :question/problem "If  $\\frac{5}{\\sqrt{2}-\\text{i}}=p+\\text{i}q,$ then$\\,p=$\n{{field-1}}\nand\n$q=$\n{{field-2}}." :question/worked-solution "First, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{2}-\\text{i}} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{(\\sqrt{2}-\\text{i})(\\sqrt{2}+\\text{i})} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{(\\sqrt{2})^{2}-(\\text{i})^{2}} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{2+1} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{3} & =p+\\text{i}q \\\\ \\frac{5\\sqrt{2}}{3}+\\frac{5}{3}\\text{i} & =p+\\text{i}q.\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $\\frac{5\\sqrt{2}}{3}=p.$\n\n- Equating the imaginary parts, we get $\\frac{5}{3}=q.$\n\nTherefore, $p=\\frac{5\\sqrt{2}}{3}$ and $q=\\frac{5}{3}.$"}]}
