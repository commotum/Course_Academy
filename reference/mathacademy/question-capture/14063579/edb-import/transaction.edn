[{:db/id "q-16556/selection/b36eb615e1dddb3caf5546c9e9e0203030d173dd1998f03f407df504b614f6c8" :answer/id #uuid "e478750c-84ab-5ec4-85eb-adc29fd33ba7" :answer/type :answer.type/text :answer/value "$p=-4$, $q=3$" :db/ensure [:answer/validate]} {:db/id "q-16556/selection/cf4ca65843208376d15ce7b9c437022f13a04776ddbf173b862ff146bf0f5019" :answer/id #uuid "c4a41523-0311-5821-8bf5-91684700e8f9" :answer/type :answer.type/text :answer/value "$p=-\\frac{3}{4}$, $q=\\frac{5}{3}$" :db/ensure [:answer/validate]} {:db/id "q-16556/selection/57b072c8f30ae3faeac6d06e47838fa0011fa13220b9adfc0dff32baa8e7f350" :answer/id #uuid "7b47d49a-458e-5f58-87c0-3b613d260a41" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{4}$, $q=-\\frac{4}{3}$" :db/ensure [:answer/validate]} {:db/id "q-16556/selection/59caeab8f957bc8e918978a5ea63b8b402bf6b42aeaf46f217c4f76999e0e04d" :answer/id #uuid "8016c0a6-aeb5-5658-af15-95b82d5bfa0b" :answer/type :answer.type/text :answer/value "$p=-1$, $q=4$" :db/ensure [:answer/validate]} {:db/id "q-16556/selection/0be2ea2f23031122e57087099f540628b9c147e2af495685fb85564620478077" :answer/id #uuid "9305fb72-7559-587b-9809-adad7241c32a" :answer/type :answer.type/text :answer/value "$p=-\\frac{1}{4}$, $q=\\frac{4}{3}$" :db/ensure [:answer/validate]} {:db/id "q-16556/selection" :answer-field/id #uuid "d2cd6a2f-0e48-530e-892b-88d2800c10ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16556/selection/0be2ea2f23031122e57087099f540628b9c147e2af495685fb85564620478077" :answer-field/choices ["q-16556/selection/b36eb615e1dddb3caf5546c9e9e0203030d173dd1998f03f407df504b614f6c8" "q-16556/selection/cf4ca65843208376d15ce7b9c437022f13a04776ddbf173b862ff146bf0f5019" "q-16556/selection/57b072c8f30ae3faeac6d06e47838fa0011fa13220b9adfc0dff32baa8e7f350" "q-16556/selection/59caeab8f957bc8e918978a5ea63b8b402bf6b42aeaf46f217c4f76999e0e04d" "q-16556/selection/0be2ea2f23031122e57087099f540628b9c147e2af495685fb85564620478077"] :db/ensure [:answer-field/validate]} {:db/id "q-16556" :question/id #uuid "5ae6b72e-4f3a-5360-b3ad-6c86f1d1d672" :question/math-academy-id "q-16556" :question/problem "Given that $7-6\\text{i}=(4p-3q\\text{i})(1+2\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $1+2\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}7-6\\text{i} & =(4p-3q\\text{i})(1+2\\text{i}) \\\\ \\frac{7-6\\text{i}}{1+2\\text{i}} & =4p-3q\\text{i}\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{(7-6\\text{i})(1-2\\text{i})}{(1+2\\text{i})(1-2\\text{i})} & =4p-3q\\text{i}q \\\\ \\frac{7-14\\text{i}-6\\text{i}+12{\\text{i}}^{2}}{{1}^{2}-(2\\text{i})^{2}} & =4p-3q\\text{i} \\\\ \\frac{-5-20\\text{i}}{1+4} & =4p-3q\\text{i} \\\\ \\frac{-5-20\\text{i}}{5} & =4p-3q\\text{i} \\\\ -1-4\\text{i} & =4p-3q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $-1=4p.$\n\n- Equating the imaginary parts, we get $-4=-3q.$\n\nTherefore, $p=-\\frac{1}{4}$ and $q=\\frac{4}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16556/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc"] :knowledge-point/questions ["q-16556"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160037/selection/60ca15572cde553c2de412433b450153dffed5503428a6c98bc2b555e494c12f" :answer/id #uuid "3aa5fa2f-dd5b-584a-96a6-00fb7cb11a82" :answer/type :answer.type/text :answer/value "$p=-4$, $q=2$" :db/ensure [:answer/validate]} {:db/id "q-160037/selection/63aaf86ad8f5cd0b94ea5112446ed4553c83a266d1592a1fb0444b7e4a6dd274" :answer/id #uuid "1fabfeaf-bd4a-5896-91fd-d539db0f332f" :answer/type :answer.type/text :answer/value "$p=-3$, $q=2$" :db/ensure [:answer/validate]} {:db/id "q-160037/selection/ff0564eab38449fb139f439d15761fc305e2bde30c1b9356aacadcedc48360de" :answer/id #uuid "c95cc182-074c-5f4f-b186-0e8524d514f5" :answer/type :answer.type/text :answer/value "$p=2$, $q=1$" :db/ensure [:answer/validate]} {:db/id "q-160037/selection/48ce8c66a5ba354f270bc21752192d5b49dface1ade297eba04076517e0dc574" :answer/id #uuid "68905735-e7ea-524a-b463-19e9757e92fa" :answer/type :answer.type/text :answer/value "$p=8$, $q=2$" :db/ensure [:answer/validate]} {:db/id "q-160037/selection/2b970d25b917835b4824eb9d85564f0c0e32049ebb5f83c9af07657a47b38acb" :answer/id #uuid "1af0ec6e-cf10-54ad-bd9d-13286f48e6c1" :answer/type :answer.type/text :answer/value "$p=2$, $q=3$" :db/ensure [:answer/validate]} {:db/id "q-160037/selection" :answer-field/id #uuid "2cba7e6f-7f8d-58f1-929c-d17b74ffe346" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160037/selection/48ce8c66a5ba354f270bc21752192d5b49dface1ade297eba04076517e0dc574" :answer-field/choices ["q-160037/selection/60ca15572cde553c2de412433b450153dffed5503428a6c98bc2b555e494c12f" "q-160037/selection/63aaf86ad8f5cd0b94ea5112446ed4553c83a266d1592a1fb0444b7e4a6dd274" "q-160037/selection/ff0564eab38449fb139f439d15761fc305e2bde30c1b9356aacadcedc48360de" "q-160037/selection/48ce8c66a5ba354f270bc21752192d5b49dface1ade297eba04076517e0dc574" "q-160037/selection/2b970d25b917835b4824eb9d85564f0c0e32049ebb5f83c9af07657a47b38acb"] :db/ensure [:answer-field/validate]} {:db/id "q-160037" :question/id #uuid "2bd6d81b-eb1e-5f54-9fb0-b04584c1dccf" :question/math-academy-id "q-160037" :question/problem "Given that $3+5\\text{i}=\\frac{p+\\text{i}q}{1-\\text{i}},$ calculate $p$ and $q.$" :question/worked-solution "First, we multiply both sides of the equation by $1-\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}3+5\\text{i} & =\\frac{p+\\text{i}q}{1-\\text{i}} \\\\ (3+5\\text{i})(1-\\text{i}) & =p+\\text{i}q \\\\ 3-3\\text{i}+5\\text{i}-5{\\text{i}}^{2} & =p+\\text{i}q \\\\ 3+5+2\\text{i} & =p+\\text{i}q \\\\ 8+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n8=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}2 & =q.\\end{aligned}\n$$\n\nTherefore, $p=8$ and $q=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-160037/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d"] :knowledge-point/questions ["q-160037"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160046/selection/d30a9678e3ab7f551174bc19d267ee986977f5a246d7746830e1e2f00a96cbc1" :answer/id #uuid "e60c2ba6-c688-597d-9401-f9bf451694aa" :answer/type :answer.type/math :answer/value "p=2,q=2." :db/ensure [:answer/validate]} {:db/id "q-160046/selection/94235792c67d4785439a08df5726d1eb0c186626a4c0c77f583589efe47ca637" :answer/id #uuid "a6b0b0ce-5ea4-5395-b82b-ecfabdd9a7ec" :answer/type :answer.type/math :answer/value "p=2,q=-2." :db/ensure [:answer/validate]} {:db/id "q-160046/selection/3d0ba01973fa40ac558f0a9e93d24025d6435bb3bb01e0cb49c010042f0faea1" :answer/id #uuid "d0edc6a2-5686-52ed-b2d7-633c7aba7b96" :answer/type :answer.type/math :answer/value "p=-2,q=2." :db/ensure [:answer/validate]} {:db/id "q-160046/selection/4af1c27fb5c68cf3a77811bc6e31f6c118a016cc08c7f82d0958ab54859252e3" :answer/id #uuid "0163662d-0bf7-5d92-9860-42ec091d2983" :answer/type :answer.type/math :answer/value "p=\\frac{1}{2},q=-\\frac{1}{2}." :db/ensure [:answer/validate]} {:db/id "q-160046/selection/4de5e85e474b63aef219e423a4bda96c1bf09ce17a5aed1eb4d42b9ccfa05184" :answer/id #uuid "928b8f54-f349-59cf-9d86-de8d5c60211c" :answer/type :answer.type/math :answer/value "p=-2,q=-2." :db/ensure [:answer/validate]} {:db/id "q-160046/selection" :answer-field/id #uuid "8eb04e97-4df9-5493-972b-93de3b744c81" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160046/selection/d30a9678e3ab7f551174bc19d267ee986977f5a246d7746830e1e2f00a96cbc1" :answer-field/choices ["q-160046/selection/d30a9678e3ab7f551174bc19d267ee986977f5a246d7746830e1e2f00a96cbc1" "q-160046/selection/94235792c67d4785439a08df5726d1eb0c186626a4c0c77f583589efe47ca637" "q-160046/selection/3d0ba01973fa40ac558f0a9e93d24025d6435bb3bb01e0cb49c010042f0faea1" "q-160046/selection/4af1c27fb5c68cf3a77811bc6e31f6c118a016cc08c7f82d0958ab54859252e3" "q-160046/selection/4de5e85e474b63aef219e423a4bda96c1bf09ce17a5aed1eb4d42b9ccfa05184"] :db/ensure [:answer-field/validate]} {:db/id "q-160046" :question/id #uuid "1375dd24-f841-5355-82d9-cb6b560b27da" :question/math-academy-id "q-160046" :question/problem "Given that $8\\text{i}=(p+\\text{i}q)(2+2\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $2+2\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}8\\text{i} & =(p+\\text{i}q)(2+2\\text{i}) \\\\ \\frac{8\\text{i}}{2+2\\text{i}} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{8\\text{i}(2-2\\text{i})}{(2+2\\text{i})(2-2\\text{i})} & =p+\\text{i}q \\\\ \\frac{16\\text{i}-16{\\text{i}}^{2}}{{2}^{2}-(2\\text{i})^{2}} & =p+\\text{i}q \\\\ \\frac{16+16\\text{i}}{8} & =p+\\text{i}q \\\\ 2+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $2=p.$\n\n- Equating the imaginary parts, we get $2=q.$\n\nTherefore, $p=2$ and $q=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc"] :knowledge-point/questions ["q-160046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280441/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "8842ff50-a609-5e8c-9e0c-b0f6c9cbb56b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-280441/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "09671d05-66a5-522c-93c0-6a26d313c00c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-280441/field-1" :answer-field/id #uuid "5ef898cc-4bd9-5164-a3e9-b8d30ae9e922" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280441/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-280441/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-280441/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-280441/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "e38838bb-bee8-50b7-ae71-30baf9e4bee5" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-280441/field-2" :answer-field/id #uuid "8f082297-6779-5b0a-87dc-70b8d16ae601" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280441/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-280441/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-280441" :question/id #uuid "1044a1d0-98e7-5450-9e35-d185a0aa30ac" :question/math-academy-id "q-280441" :question/problem "If  $-3+2\\text{i}=\\frac{p+q\\text{i}}{1-4\\text{i}},$ then$\\,p=$\n{{field-1}}\nand\n$q=$\n{{field-2}}." :question/worked-solution "First, we multiply both sides of the equation by $1-4\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}-3+2\\text{i}=\\frac{p+q\\text{i}}{1-4\\text{i}} \\\\ (-3+2\\text{i})(1-4\\text{i}) & =p+q\\text{i} \\\\ -3+12\\text{i}+2\\text{i}-8{\\text{i}}^{2} & =p+q\\text{i} \\\\ -3+8+14\\text{i} & =p+q\\text{i} \\\\ 5+14\\text{i} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n5=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}14 & =q.\\end{aligned}\n$$\n\nTherefore, $p=5$ and $q=14.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280441/field-1" "q-280441/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d"] :knowledge-point/questions ["q-280441"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281168/field-1/203b49b7b469de644cfb40d3f6ed7fb390b35ba840093328562248454314c875" :answer/id #uuid "fe43f3da-ca8a-5737-9697-c2555ca096cb" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-281168/field-1" :answer-field/id #uuid "0d11e284-8c88-54c1-ba1d-dd2b876e788e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281168/field-1/203b49b7b469de644cfb40d3f6ed7fb390b35ba840093328562248454314c875" :answer-field/choices ["q-281168/field-1/203b49b7b469de644cfb40d3f6ed7fb390b35ba840093328562248454314c875"] :db/ensure [:answer-field/validate]} {:db/id "q-281168/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer/id #uuid "dd6630b2-ee66-53a2-9d72-29e6bdd99771" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-281168/field-2" :answer-field/id #uuid "f819065f-bc67-5e45-a9a6-a3cf88a2557f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281168/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer-field/choices ["q-281168/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818"] :db/ensure [:answer-field/validate]} {:db/id "q-281168" :question/id #uuid "ebe88860-d242-5f5f-8ef9-d5441f44ff45" :question/math-academy-id "q-281168" :question/problem "If  $\\frac{5}{\\sqrt{2}-\\text{i}}=p+\\text{i}q,$ then$\\,p=$\n{{field-1}}\nand\n$q=$\n{{field-2}}." :question/worked-solution "First, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{5}{\\sqrt{2}-\\text{i}} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{(\\sqrt{2}-\\text{i})(\\sqrt{2}+\\text{i})} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{(\\sqrt{2})^{2}-(\\text{i})^{2}} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{2+1} & =p+\\text{i}q \\\\ \\frac{5(\\sqrt{2}+\\text{i})}{3} & =p+\\text{i}q \\\\ \\frac{5\\sqrt{2}}{3}+\\frac{5}{3}\\text{i} & =p+\\text{i}q.\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $\\frac{5\\sqrt{2}}{3}=p.$\n\n- Equating the imaginary parts, we get $\\frac{5}{3}=q.$\n\nTherefore, $p=\\frac{5\\sqrt{2}}{3}$ and $q=\\frac{5}{3}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-281168/field-1" "q-281168/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc"] :knowledge-point/questions ["q-281168"] :db/ensure [:knowledge-point/validate]}]
