              "value": "{a}_{1}+{a}_{2}=1,\\,b=⟨5,1,-3⟩"
            },
            {
              "type": "math",
              "value": "{a}_{1}+{a}_{2}=-1,\\,b=⟨5,-1,-3⟩"
            },
            {
