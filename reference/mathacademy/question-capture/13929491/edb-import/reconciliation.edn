ure/13929491/edb-import/verification.json"} {"question" "q-74233" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-74233" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-74233" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-112815" "field" nil "attribute" "question/problem" "value" "Which root(s) of the polynomial $p(x)=7{x}^{3}+42{x}^{2}$ have multiplicity $2?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-112815" "field" nil "attribute" "question/worked-solution" "value" "First, we need to factor the polynomial. \n\nFor this polynomial, we can factor by noting that the greatest common factor of $7{x}^{3}$ and $42{x}^{2}$ is $7{x}^{2}:$\n\n$$\n\\begin{aligned}p(x) & =7{x}^{3}+42{x}^{2} \\\\  & =7{x}^{2}(x+6)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $x$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=0$ has multiplicity $2.$\n\n- The factor $(x+6)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-6$ has multiplicity $1.$\n\nIn conclusion, only the root $x=0$ has multiplicity $2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-112815" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/activity-metadata.json" "file_sha256" "4801635bfbb5ee30a4382305fa41763e5af67e3d2ccc33354922d9e5ae6f64e2" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-112815" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/state.json" "file_sha256" "8476230ac85df9c2708290a113e9fb2314cecbd071c678d2ff07c05abb3cf722" "basis" 314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13929491/edb-import/verification.json"} {"question" "q-112815" "field" "selection" "attribute" "answer/value" "value" [:answe