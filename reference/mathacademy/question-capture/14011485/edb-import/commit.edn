igned}\n$$\n\nrounded to two decimal places. Therefore, the polar coordinates of $P$ are  $(17,4.22).$" 13194139534465 true] [17592186289740 1000 #edb/ref 17592186289741 13194139534465 true] [17592186289740 1000 #edb/ref 17592186289742 13194139534465 true] [17592186289740 1000 #edb/ref 17592186289743 13194139534465 true] [17592186289740 1000 #edb/ref 17592186289744 13194139534465 true] [17592186289740 1000 #edb/ref 17592186289745 13194139534465 true] [17592186289740 1040 #edb/ref 17592186045450 13194139534465 true] [17592186289740 1041 "selection" 13194139534465 true] [17592186289740 1104 #edb/ref 17592186289743 13194139534465 true] [17592186289740 1110 #uuid "45e4850f-6935-5893-9683-eb7498e3a4e0" 13194139534465 true] [17592186289741 1034 "(17,4.83)" 13194139534465 true] [17592186289741 1103 #edb/ref 17592186045453 13194139534465 true] [17592186289741 1111 #uuid "a29cd924-3229-5548-a6b6-5be340f39e0a" 13194139534465 true] [17592186289742 1034 "(17,1.08)" 13194139534465 true] [17592186289742 1103 #edb/ref 17592186045453 13194139534465 true] [17592186289742 1111 #uuid "05bc9bad-2150-594b-bfff-5020ba51fe43" 13194139534465 true] [17592186289743 1034 "(17,4.22)" 13194139534465 true] [17592186289743 1103 #edb/ref 17592186045453 13194139534465 true] [17592186289743 1111 #uuid "379db828-6064-580a-9964-4902f87c7cb1" 13194139534465 true] [17592186289744 1034 "(15,4.22)" 13194139534465 true] [17592186289744 1103 #edb/ref 17592186045453 13194139534465 true] [17592186289744 1111 #uuid "3369a72a-dc3d-59ab-a5a2-13f8340ae26b" 13194139534465 true] [17592186289745 1034 "(15,4.83)" 13194139534465 true] [17592186289745 1103 #edb/ref 17592186045453 13194139534465 true] [17592186289745 1111 #uuid "62754e23-72c3-532d-b0e4-b6b888a94592" 13194139534465 true]] :edb/tempids {"q-16947" 17592186289713 "q-16947/selection" 17592186289714 "q-16947/selection/5befddedb48c635a645a02efdc5a9efcb78c949a1f0952e532cd396ebdca5120" 17592186289715 "q-16947/selection/7b824242ecc65879f356d40d0d640569064f1f773fb