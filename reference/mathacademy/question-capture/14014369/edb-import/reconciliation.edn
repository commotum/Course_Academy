\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the original vector is\n\n$$\n\\begin{aligned}v & ={T}^{-1}\\cdot [\\begin{aligned}-7 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{17}[\\begin{aligned}1 & 5 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}-7 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{17}[\\begin{aligned}3 \\\\ 25\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{17} \\\\ \\frac{25}{17}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014369/state.json" "file_sha256" "9f0a3007555286951023e9ecba7934ecb3eff43ad1a0189a53feb7b91a9d8c65"} {"question" "q-317431" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014369/activity-metadata.json" "file_sha256" "dd45c604be785a4cb8d791de7709ff54f6180db9c87ae17f485093ed2549b51a"} {"question" "q-317431" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014369/state.json" "file_sha256" "9f0a3007555286951023e9ecba7934ecb3eff43ad1a0189a53feb7b91a9d8c65"} {"question" "q-317431" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{17}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014369/state.json" "file_sha256" "9f0a3007555286951023e9ecba7934ecb3eff43ad1a0189a53feb7b91a9d8c65"} {"question" "q-317431" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014369/state.json" "file_sha256" "9f0a3007555286951023e9ecba7934ecb3eff43ad1a0189a53feb7b91a9d8c65"} {"question" "q-317431" "field" "field-2" "attribute" "answer-field/