f554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-162746" :question/id #uuid "db7ff2bd-ad8f-5f53-98fe-f7bf18596cef" :question/math-academy-id "q-162746" :question/problem "| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.06$ | $0.04$ |\n| $X=2$ | $0.5$ | $0.24$ | $0.06$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $0.2$ | $0.8$ | |  | | $y$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.6$ | $0.3$ | $0.1$ | |  |\n| --- | --- | --- | --- |\n| $x$ | $1$ | $2$ |  |\n| ${f}_{X}(x)$ | $0.2$ | $0.8$ |  |\n| $y$ | $0$ | $1$ | $2$ |\n| ${f}_{Y}(y)$ | $0.6$ | $0.3$ | $0.1$ |\n\nWhich of the following statements are true?\n\n- $P(X=1,Y=1)=P(X=1)\\cdot P(Y=1)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.06.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.2\\cdot 0.3=0.06.\\,✓\n$$\n\n- Statement II is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,0) & =0.1\\ne 0.2\\cdot 0.6={f}_{X}(1)\\cdot {f}_{Y}(0) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-162746/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3"] :knowledge-point/questions ["q-162746"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163605/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "fd574fbd-ef47-5705-acce-70b1c840546f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-163605/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "1df92081-cbd8-550f-a2a5-44e2bf8d816d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-163605/selection/dc3d6e88f285245720144c933701a53a6c09453bd7fd717547c56533a1a23339" :answer/id #uuid "8a03441b-8699-50ae-a513-730107fa88a2" :answer/type :answer.type/text :answer/value "None of the statements" :db/ensure [:answer/validate]} {:db/id "q-163605/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ca9b0e1c-e4e6-560e-be2c-bf446024134a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-163605/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ffb74ec0-5ae1-528c-a2df-83520cfee88e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-163605/selection" :answer-field/id #uuid "37369e50-ee96-592c-8beb-e18c62d08f1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163605/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-163605/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-163605/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-163605/selection/dc3d6e88f285245720144c933701a53a6c09453bd7fd717547c56533a1a23339" "q-163605/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-163605/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-163605" :question/id #uuid "54cab6ac-9169-51f6-a0e0-b782401a693c" :question/math-academy-id "q-163605" :question/problem "| $f$ | $Y=-2$ | $Y=2$ |\n| --- | --- | --- |\n| $X=0$ | $\\frac{1}{4}$ | $\\frac{5}{12}$ |\n| $X=3$ | $\\frac{1}{8}$ | $\\frac{5}{24}$ |\n\nThe joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given above, while the marginal mass functions for these variables are shown below.\n\n| | $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| ${f}_{X}(x)$ | $\\frac{2}{3}$ | $\\frac{1}{3}$ | |  | | $y$ | $-2$ | $2$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $\\frac{3}{8}$ | $\\frac{5}{8}$ | |\n| --- | --- | --- |\n| $x$ | $0$ | $3$ |\n| ${f}_{X}(x)$ | $\\frac{2}{3}$ | $\\frac{1}{3}$ |\n| $y$ | $-2$ | $2$ |\n| ${f}_{Y}(y)$ | $\\frac{3}{8}$ | $\\frac{5}{8}$ |\n\nWhich of the following statements are true?\n\n- $P(X=0,Y=-2)=P(X=0)\\cdot P(Y=-2)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=0,Y=-2)=f(0,-2)=\\frac{1}{4}.$ On the other hand, \n\n$$\nP(X=0)\\cdot P(Y=-2)={f}_{X}(0)\\cdot {f}_{Y}(-2)=\\frac{2}{3}\\cdot \\frac{3}{8}=\\frac{1}{4}.\\,✓\n$$\n\n- Statement II is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,2) & =\\frac{5}{12}=\\frac{2}{3}\\cdot \\frac{5}{8}={f}_{X}(0)\\cdot {f}_{Y}(2) & ✓ \\\\ f(3,-2) & =\\frac{1}{8}=\\frac{1}{3}\\cdot \\frac{3}{8}={f}_{X}(3)\\cdot {f}_{Y}(-2) & ✓ \\\\ f(3,2) & =\\frac{5}{24}=\\frac{1}{3}\\cdot \\frac{5}{8}={f}_{X}(3)\\cdot {f}_{Y}(2) & ✓\\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163605/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35de7257-8d35-5f81-89be-c7faa73d6bc3"] :knowledge-point/questions ["q-163605"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163617/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "ecd761ab-a337-54fd-a5a0-40a936cb7edb" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-163617/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "d6b3efea-7493-5858-a065-fb0d2093db98" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-163617/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1bb81eb6-9010-5fb3-9812-8d67dba6312a" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-163617/selection/03b99debc8e9534f2364927a2cf1eba83bddd906503dea5d13395ce906a45ab9" :answer/id #uuid "b469d35c-6b6a-580d-ae7b-585d23054d7c" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "q-163617/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "73319800-d48a-53c7-8826-f00f47835ef2" :answer/type