#{[{:db/id #edb/ref 17592186309117 :knowledge-point/_questions [{:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d92a77-26d9-5f4b-8a06-af9599e0c6fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{21}+C" :db/id #edb/ref 17592186309119} {:answer/id #uuid "0b5291b8-6c61-518c-af10-aee9d2c45ecf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7(2+{x}^{7})^{3}}{3}+C" :db/id #edb/ref 17592186309120} {:answer/id #uuid "76dac32d-2727-5f1b-94cd-d1ac350a3564" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{3}+C" :db/id #edb/ref 17592186309121} {:answer/id #uuid "4bb08241-100c-51ee-a490-6f2fe0ae4c70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{7}+C" :db/id #edb/ref 17592186309122} {:answer/id #uuid "0d364f12-b550-5d51-9f70-253dbfc50abe" :answer/type {:db/ident :answer.type/math} :answer/value "21(2+{x}^{7})^{3}+C" :db/id #edb/ref 17592186309123}] :answer-field/correct {:answer/id #uuid "08d92a77-26d9-5f4b-8a06-af9599e0c6fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{21}+C" :db/id #edb/ref 17592186309119} :answer-field/id #uuid "24affd62-b178-5ea5-8dec-3fc9a9a16cf8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309118}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "434e8e50-5d62-5620-9685-e3a443ffb3fd" :question/math-academy-id "q-113711" :question/problem "Calculate $\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x.$" :question/worked-solution "In this case, the term ${x}^{6}$ outside the parentheses isn't quite the derivative of $2+{x}^{7}.$ But the derivative is $7{x}^{6},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=2+{x}^{7}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =7{x}^{6}\\,⟹\\,\\frac{1}{7}\\text{d}u={x}^{6}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x & =\\int (2+{x}^{7})^{2}\\cdot {x}^{6}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\frac{1}{7}\\text{d}u \\\\  & =\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u & =\\frac{1}{7}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{21}{u}^{3}+C \\\\  & =\\frac{1}{21}(2+{x}^{7})^{3}+C \\\\  & =\\frac{(2+{x}^{7})^{3}}{21}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309124 :knowledge-point/_questions [{:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd3cb28-c1a8-5322-a4c6-b78331ea4a98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{5}}{5}+C" :db/id #edb/ref 17592186309126} {:answer/id #uuid "d8238967-73e1-54be-8880-188f9fc6c38d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186309127} {:answer/id #uuid "1c578af3-e34c-50b7-84ee-0e2b78fdda53" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186309128} {:answer/id #uuid "b952b60b-aa27-5df2-9e8a-c566c81e3857" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{4}+C" :db/id #edb/ref 17592186309129} {:answer/id #uuid "d3e4b362-972a-5bff-9d60-ea18c5ea6a5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186309130}] :answer-field/correct {:answer/id #uuid "1c578af3-e34c-50b7-84ee-0e2b78fdda53" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186309128} :answer-field/id #uuid "60dd005e-b681-5f17-83eb-b24cbfd0713a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309125}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "deee0fb4-37d5-5821-a632-dfe38d0d54b0" :question/math-academy-id "q-2379" :question/problem "$\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $(3-{x}^{2}).$ But the derivative is $-2x,$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=3-{x}^{2}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-2x\\,⟹\\,(-\\frac{1}{2})\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x & =\\int {(3-{x}^{2})}^{5}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot (-\\frac{1}{2})\\text{d}u \\\\  & =-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u & =-\\frac{1}{2}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{1}{12}{u}^{6}+C \\\\  & =-\\frac{1}{12}{(3-{x}^{2})}^{6}+C \\\\  & =-\\frac{{(3-{x}^{2})}^{6}}{12}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069097 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a89ef0e7-8236-5559-a6e5-9c6fb749c0db" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{x^{3} + 7} + C" :db/id #edb/ref 17592186066173} {:answer/id #uuid "e314e323-7cfa-57d3-965c-56be22b179f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x^{3} + 7}} + C" :db/id #edb/ref 17592186066174} {:answer/id #uuid "f26ed3c3-13d7-5fec-89d8-f609e0d3560c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x^{3} + 7} + C" :db/id #edb/ref 17592186066175} {:answer/id #uuid "4688a54e-b1de-57c4-a0f8-afa172b29a57" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3} + 7} + C" :db/id #edb/ref 17592186066176} {:answer/id #uuid "542472e2-618b-5050-abfe-21bf5780d621" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x}}{\\sqrt{x^{3} + 7}} + C" :db/id #edb/ref 17592186066177}] :answer-field/correct {:answer/id #uuid "4688a54e-b1de-57c4-a0f8-afa172b29a57" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{x^{3} + 7} + C" :db/id #edb/ref 17592186066176} :answer-field/id #uuid "2abb7352-b45f-5074-97f7-357e4a1a0b7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066172}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "87181cd2-9356-511c-8a55-f0b3b8086037" :question/math-academy-id "q-2389" :question/problem "Calculate the integral $\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{3}+7.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{{x}^{3}+7}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{3}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\sqrt{u}+C \\\\  & =2\\sqrt{{x}^{3}+7}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309131 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b05b8200-3963-59c8-ae5b-3377899cbf5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id #edb/ref 17592186309133} {:answer/id #uuid "be2294d7-60ec-5467-8770-82ae29384579" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id #edb/ref 17592186309134} {:answer/id #uuid "9955ec48-1f7a-595b-9f2c-eb9a9935d456" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id #edb/ref 17592186309135} {:answer/id #uuid "f00739b0-9d82-5ce6-b068-c592a6c5721c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{({x}^{10}+9)}^{2}}+C" :db/id #edb/ref 17592186309136} {:answer/id #uuid "5872dd07-e399-50a4-84b6-1c4dbee06ddd" :answer/type {:db/ident :answer.type/math} :answer/value "10\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id #edb/ref 17592186309137}] :answer-field/correct {:answer/id #uuid "b05b8200-3963-59c8-ae5b-3377899cbf5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id #edb/ref 17592186309133} :answer-field/id #uuid "59c4317d-5f9d-5b4a-8492-b9887d20f077" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309132}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5b5bc133-fcec-57c5-879e-a40a74f5f869" :question/math-academy-id "q-49572" :question/problem "Calculate $\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{10}+9.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10{x}^{9}\\,⟹\\,\\frac{1}{10}\\text{d}u={x}^{9}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x & =\\int \\frac{1}{{x}^{10}+9}\\cdot {x}^{9}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{10}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069436 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f0e11fd-904f-5c15-b734-dc98e99ffa24" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x^{3} - x \\mid + C" :db/id #edb/ref 17592186068148} {:answer/id #uuid "d73b1f4e-7557-5b1a-858e-81c098c306da" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid 3x^{2} - 1 \\mid + C" :db/id #edb/ref 17592186068149} {:answer/id #uuid "da0132d4-3bf3-5644-9046-cc3604306f54" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid \\frac{1}{x^{3} - 1} \\mid + C" :db/id #edb/ref 17592186068150} {:answer/id #uuid "ebf50197-6acb-568a-b5fc-8adbfe7e78ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x^{3} - 1 \\mid + C" :db/id #edb/ref 17592186068151} {:answer/id #uuid "faa4f6fc-6266-5c95-add8-8977babf48cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid 3x^{2} - x \\mid + C" :db/id #edb/ref 17592186068152}] :answer-field/correct {:answer/id #uuid "9f0e11fd-904f-5c15-b734-dc98e99ffa24" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x^{3} - x \\mid + C" :db/id #edb/ref 17592186068148} :answer-field/id #uuid "556c56a5-b354-5d24-aa3a-519fc781acde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068147}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "604f6b09-192e-50e6-8477-dce586313508" :question/math-academy-id "q-72566" :question/problem "$\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-1\\,⟹\\,\\text{d}u=(3{x}^{2}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}-x}\\cdot (3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{3}-x|+C\\end{aligned}\n$$"}]}
