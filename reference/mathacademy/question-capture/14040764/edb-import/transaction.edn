[{:db/id "q-2379/selection/a0c412775ae6df0e418851ed820a11c10d7428df7fe3bdfdb92f3a0ec67f8451" :answer/id #uuid "b952b60b-aa27-5df2-9e8a-c566c81e3857" :answer/type :answer.type/math :answer/value "\\frac{{(3-{x}^{2})}^{6}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-2379/selection/1169555a26786277b99158345e3190a06ec168a172b00aa221121f002a373578" :answer/id #uuid "0fd3cb28-c1a8-5322-a4c6-b78331ea4a98" :answer/type :answer.type/math :answer/value "-\\frac{{(3-{x}^{2})}^{5}}{5}+C" :db/ensure [:answer/validate]} {:db/id "q-2379/selection/4351521498807dbe1c484a407391f2c413d52479f347492b198c42b3d34a3fee" :answer/id #uuid "d8238967-73e1-54be-8880-188f9fc6c38d" :answer/type :answer.type/math :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-2379/selection/b1a128f9deb711f0c841224007a5453b97a3708178cc6632b52f22a77f8c7c57" :answer/id #uuid "d3e4b362-972a-5bff-9d60-ea18c5ea6a5f" :answer/type :answer.type/math :answer/value "\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-2379/selection/962f86f9f5abf2fa0dbe1d5f51812983c90dbe48b9ca67535bfb12759fa5bd5c" :answer/id #uuid "1c578af3-e34c-50b7-84ee-0e2b78fdda53" :answer/type :answer.type/math :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/ensure [:answer/validate]} {:db/id "q-2379/selection" :answer-field/id #uuid "60dd005e-b681-5f17-83eb-b24cbfd0713a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2379/selection/962f86f9f5abf2fa0dbe1d5f51812983c90dbe48b9ca67535bfb12759fa5bd5c" :answer-field/choices ["q-2379/selection/a0c412775ae6df0e418851ed820a11c10d7428df7fe3bdfdb92f3a0ec67f8451" "q-2379/selection/1169555a26786277b99158345e3190a06ec168a172b00aa221121f002a373578" "q-2379/selection/4351521498807dbe1c484a407391f2c413d52479f347492b198c42b3d34a3fee" "q-2379/selection/b1a128f9deb711f0c841224007a5453b97a3708178cc6632b52f22a77f8c7c57" "q-2379/selection/962f86f9f5abf2fa0dbe1d5f51812983c90dbe48b9ca67535bfb12759fa5bd5c"] :db/ensure [:answer-field/validate]} {:db/id "q-2379" :question/id #uuid "deee0fb4-37d5-5821-a632-dfe38d0d54b0" :question/math-academy-id "q-2379" :question/problem "$\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $(3-{x}^{2}).$ But the derivative is $-2x,$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=3-{x}^{2}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-2x\\,⟹\\,(-\\frac{1}{2})\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x & =\\int {(3-{x}^{2})}^{5}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot (-\\frac{1}{2})\\text{d}u \\\\  & =-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u & =-\\frac{1}{2}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{1}{12}{u}^{6}+C \\\\  & =-\\frac{1}{12}{(3-{x}^{2})}^{6}+C \\\\  & =-\\frac{{(3-{x}^{2})}^{6}}{12}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2379/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-2379"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-2389"] :question/problem "Calculate the integral $\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{3}+7.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{{x}^{3}+7}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{3}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\sqrt{u}+C \\\\  & =2\\sqrt{{x}^{3}+7}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-49572/selection/7b4aa33c9a4304f2fd84c8b3d7972a846e8b92f7a82cbac36088f95000309266" :answer/id #uuid "9955ec48-1f7a-595b-9f2c-eb9a9935d456" :answer/type :answer.type/math :answer/value "9\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/ensure [:answer/validate]} {:db/id "q-49572/selection/13f3b36f4eb6486cd12e6322eba409d89f812b04eaad93e9cfb142e9d8326cfe" :answer/id #uuid "be2294d7-60ec-5467-8770-82ae29384579" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/ensure [:answer/validate]} {:db/id "q-49572/selection/af9f0cd0cdbddd074e51acf1e6583d90e8801282a39564c537aeb7ccaff8705f" :answer/id #uuid "5872dd07-e399-50a4-84b6-1c4dbee06ddd" :answer/type :answer.type/math :answer/value "10\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/ensure [:answer/validate]} {:db/id "q-49572/selection/045deb39d35a065e2cb29ae3a2abb796055fbfb7b345f813a5dd45cdbfa63aa8" :answer/id #uuid "b05b8200-3963-59c8-ae5b-3377899cbf5d" :answer/type :answer.type/math :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/ensure [:answer/validate]} {:db/id "q-49572/selection/98a411e3b201ad7eca55e380671e5bdf1338f503bac440bf3f5c72c15f06b8bf" :answer/id #uuid "f00739b0-9d82-5ce6-b068-c592a6c5721c" :answer/type :answer.type/math :answer/value "\\frac{1}{{({x}^{10}+9)}^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-49572/selection" :answer-field/id #uuid "59c4317d-5f9d-5b4a-8492-b9887d20f077" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49572/selection/045deb39d35a065e2cb29ae3a2abb796055fbfb7b345f813a5dd45cdbfa63aa8" :answer-field/choices ["q-49572/selection/7b4aa33c9a4304f2fd84c8b3d7972a846e8b92f7a82cbac36088f95000309266" "q-49572/selection/13f3b36f4eb6486cd12e6322eba409d89f812b04eaad93e9cfb142e9d8326cfe" "q-49572/selection/af9f0cd0cdbddd074e51acf1e6583d90e8801282a39564c537aeb7ccaff8705f" "q-49572/selection/045deb39d35a065e2cb29ae3a2abb796055fbfb7b345f813a5dd45cdbfa63aa8" "q-49572/selection/98a411e3b201ad7eca55e380671e5bdf1338f503bac440bf3f5c72c15f06b8bf"] :db/ensure [:answer-field/validate]} {:db/id "q-49572" :question/id #uuid "5b5bc133-fcec-57c5-879e-a40a74f5f869" :question/math-academy-id "q-49572" :question/problem "Calculate $\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{10}+9.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10{x}^{9}\\,⟹\\,\\frac{1}{10}\\text{d}u={x}^{9}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x & =\\int \\frac{1}{{x}^{10}+9}\\cdot {x}^{9}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{10}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49572/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8"] :knowledge-point/questions ["q-49572"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-72566"] :question/problem "$\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-1\\,⟹\\,\\text{d}u=(3{x}^{2}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}-x}\\cdot (3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{3}-x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-113711/selection/f2f36a3bd39fb3a35c3361a138cfec90d3ba9a5c69d8ef4be7ffbce9a415cd66" :answer/id #uuid "0d364f12-b550-5d51-9f70-253dbfc50abe" :answer/type :answer.type/math :answer/value "21(2+{x}^{7})^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113711/selection/7d903f93a5d9bb51bc3967a3c906216f7aeb2b40bd5388e8ce3998da8660836f" :answer/id #uuid "0b5291b8-6c61-518c-af10-aee9d2c45ecf" :answer/type :answer.type/math :answer/value "\\frac{7(2+{x}^{7})^{3}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113711/selection/433d74dd488832b65fa607335d0dbd9767a8fb284fcccc9070c1597147830f5e" :answer/id #uuid "08d92a77-26d9-5f4b-8a06-af9599e0c6fc" :answer/type :answer.type/math :answer/value "\\frac{(2+{x}^{7})^{3}}{21}+C" :db/ensure [:answer/validate]} {:db/id "q-113711/selection/870d16c6c344797305cc0ade635b754390d20b2eb0fc1a2acfad116b44e2c021" :answer/id #uuid "76dac32d-2727-5f1b-94cd-d1ac350a3564" :answer/type :answer.type/math :answer/value "\\frac{(2+{x}^{7})^{3}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113711/selection/a02fb50aed95a13ce8482d50ddaf0576c0c8bf980c7478efe079fb92cc1b2abe" :answer/id #uuid "4bb08241-100c-51ee-a490-6f2fe0ae4c70" :answer/type :answer.type/math :answer/value "\\frac{(2+{x}^{7})^{3}}{7}+C" :db/ensure [:answer/validate]} {:db/id "q-113711/selection" :answer-field/id #uuid "24affd62-b178-5ea5-8dec-3fc9a9a16cf8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113711/selection/433d74dd488832b65fa607335d0dbd9767a8fb284fcccc9070c1597147830f5e" :answer-field/choices ["q-113711/selection/f2f36a3bd39fb3a35c3361a138cfec90d3ba9a5c69d8ef4be7ffbce9a415cd66" "q-113711/selection/7d903f93a5d9bb51bc3967a3c906216f7aeb2b40bd5388e8ce3998da8660836f" "q-113711/selection/433d74dd488832b65fa607335d0dbd9767a8fb284fcccc9070c1597147830f5e" "q-113711/selection/870d16c6c344797305cc0ade635b754390d20b2eb0fc1a2acfad116b44e2c021" "q-113711/selection/a02fb50aed95a13ce8482d50ddaf0576c0c8bf980c7478efe079fb92cc1b2abe"] :db/ensure [:answer-field/validate]} {:db/id "q-113711" :question/id #uuid "434e8e50-5d62-5620-9685-e3a443ffb3fd" :question/math-academy-id "q-113711" :question/problem "Calculate $\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x.$" :question/worked-solution "In this case, the term ${x}^{6}$ outside the parentheses isn't quite the derivative of $2+{x}^{7}.$ But the derivative is $7{x}^{6},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=2+{x}^{7}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =7{x}^{6}\\,⟹\\,\\frac{1}{7}\\text{d}u={x}^{6}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x & =\\int (2+{x}^{7})^{2}\\cdot {x}^{6}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\frac{1}{7}\\text{d}u \\\\  & =\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u & =\\frac{1}{7}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{21}{u}^{3}+C \\\\  & =\\frac{1}{21}(2+{x}^{7})^{3}+C \\\\  & =\\frac{(2+{x}^{7})^{3}}{21}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113711/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-113711"] :db/ensure [:knowledge-point/validate]}]
