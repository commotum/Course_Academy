#{[{:db/id #edb/ref 17592186298038 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ec5ead7-2e79-516f-bbd1-c56be8af7d37" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186298040} {:answer/id #uuid "b5895de7-9dbb-5907-86d6-cfaec6b2e7f5" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{2}+3n\\pi " :db/id #edb/ref 17592186298041} {:answer/id #uuid "f93d8d3b-58b3-577d-ba79-6b60fca7f7fa" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186298042} {:answer/id #uuid "1a9f0f03-7496-5161-957e-ca0e9a62ff62" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186298043} {:answer/id #uuid "3a0aea6e-0958-5daa-9559-7a371257aea0" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186298044}] :answer-field/correct {:answer/id #uuid "f93d8d3b-58b3-577d-ba79-6b60fca7f7fa" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186298042} :answer-field/id #uuid "c6af22e5-17b7-5690-9973-a9c4b07974e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298039}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "39111b2a-0750-5a6c-9e79-aeb0c723d198" :question/math-academy-id "q-10399" :question/problem "What is the domain of the function $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{4})+1?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{cot}⁡x$ is given by\n\n$$\nx\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $2\\operatorname{cot}⁡(x-\\frac{\\pi }{4})+1,$ we replace the $x$ on the left-hand side of the above with $(x-\\frac{\\pi }{4}).$ This gives\n\n$$\nx-\\frac{\\pi }{4}\\ne n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{4} & \\ne n\\pi  \\\\ x & \\ne n\\pi +\\frac{\\pi }{4} \\\\ x & \\ne \\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{4}+n\\pi ,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186298045 :knowledge-point/_questions [{:knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c304d38a-90f7-55a2-a2b3-33d7f56dff5b" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {20}^{∘}" :db/id #edb/ref 17592186298047} {:answer/id #uuid "84b3de38-e256-5be9-9141-50e39363e94a" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {90}^{∘}" :db/id #edb/ref 17592186298048} {:answer/id #uuid "5510104d-4aa9-58bd-8ec4-82ffead66336" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {120}^{∘}" :db/id #edb/ref 17592186298049} {:answer/id #uuid "d2ecf322-9542-5259-ab3b-3fc70cc9f12e" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {60}^{∘}" :db/id #edb/ref 17592186298050} {:answer/id #uuid "98db39fa-2e60-5af1-ad86-6856200634d1" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {30}^{∘}" :db/id #edb/ref 17592186298051}] :answer-field/correct {:answer/id #uuid "d2ecf322-9542-5259-ab3b-3fc70cc9f12e" :answer/type {:db/ident :answer.type/math} :answer/value "x=n\\cdot {60}^{∘}" :db/id #edb/ref 17592186298050} :answer-field/id #uuid "326f65af-853f-53ab-b946-691e77e8e9c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298046}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3c8031d3-e758-5a39-8d6d-ad3b203dd41a" :question/math-academy-id "q-117692" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function  $f(x)=2\\operatorname{cot}⁡(3x)-5,$  where \n$x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{cot}⁡x$ are given by the expression\n\n$$\nx=n\\cdot {180}^{∘},\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $2\\operatorname{cot}⁡(3x)-5,$ we replace the $x$ on the left-hand side of the above with $(3x).$ This gives\n\n$$\n3x=n\\cdot {180}^{∘}.\n$$\n\nSolving for $x,$ we get \n\n$$\n\\begin{aligned}3x & =n\\cdot {180}^{∘} \\\\ x & =\\frac{n\\cdot {180}^{∘}}{3} \\\\ x & =n\\cdot {60}^{∘}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=n\\cdot {60}^{∘},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186298052 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7bc465-11bc-5673-9be5-989957aa1bc8" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{3}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186298054} {:answer/id #uuid "da14f7f6-8029-5bdc-a306-d737b776c842" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186298055} {:answer/id #uuid "dad4c51d-e246-5e07-bbeb-a0a6d4194d3a" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{3}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186298056} {:answer/id #uuid "53d9a5e4-630b-5b85-aae8-7a3766347929" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{12}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186298057} {:answer/id #uuid "dbda2a72-ef8f-5988-9b68-64c69a7df8b8" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{12}+\\frac{n\\pi }{12}" :db/id #edb/ref 17592186298058}] :answer-field/correct {:answer/id #uuid "53d9a5e4-630b-5b85-aae8-7a3766347929" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{12}+\\frac{n\\pi }{4}" :db/id #edb/ref 17592186298057} :answer-field/id #uuid "90001df6-669f-5679-9792-d8d30e55c7fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298053}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a3215fc2-d43b-5894-97a3-d258a0fdf783" :question/math-academy-id "q-117706" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(4x+\\frac{\\pi }{6})?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by the expression\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(4x+\\frac{\\pi }{6}),$ we replace the $x$ on the left-hand side of the above with $(4x+\\frac{\\pi }{6}).$ This gives\n\n$$\n4x+\\frac{\\pi }{6}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}4x+\\frac{\\pi }{6} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ 4x & \\ne \\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{6} \\\\ 4x & \\ne \\frac{\\pi }{3}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{3\\cdot 4}+\\frac{n\\pi }{4} \\\\ x & \\ne \\frac{\\pi }{12}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{12}+\\frac{n\\pi }{4},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186298059 :knowledge-point/_questions [{:knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee558439-dd31-5c9b-9fd3-bcea006d6804" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+n\\pi " :db/id #edb/ref 17592186298061} {:answer/id #uuid "060cefe7-2b6a-5ca0-8c43-67072bae608e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186298062} {:answer/id #uuid "fd793fbf-6600-5951-855b-739aeef69ac8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186298063} {:answer/id #uuid "b6cdcd2f-9dac-5fd3-9b0b-e40b0fa070d9" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186298064} {:answer/id #uuid "3d9ce92d-8c70-5d71-ad1c-8fec7910b8bd" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{3}+n\\pi " :db/id #edb/ref 17592186298065}] :answer-field/correct {:answer/id #uuid "060cefe7-2b6a-5ca0-8c43-67072bae608e" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186298062} :answer-field/id #uuid "7d7a2cd2-13d4-5711-93ed-f8e07d4f6efe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298060}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b5b2aea7-ee08-51df-a95a-a0f287208c30" :question/math-academy-id "q-29438" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{cot}⁡x$ are given by\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3}),$ we replace the $x$ on the left-hand side of the above with $(x-\\frac{\\pi }{3}).$ This gives\n\n$$\nx-\\frac{\\pi }{3}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{3} & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{2}+n\\pi +\\frac{\\pi }{3} \\\\ x & =\\frac{5\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{5\\pi }{6}+n\\pi ,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186298066 :knowledge-point/_questions [{:knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e12faa6-5516-572f-94d1-76ad65c65121" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+n\\pi " :db/id #edb/ref 17592186298068} {:answer/id #uuid "f13ce29d-3eaa-5381-81da-3d37561e9f9b" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+4n\\pi " :db/id #edb/ref 17592186298069} {:answer/id #uuid "c496cb3b-d190-50b4-a703-37885888742c" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{8}" :db/id #edb/ref 17592186298070} {:answer/id #uuid "9a1549b3-7c0c-5c28-8ec5-71414f7e2d34" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186298071} {:answer/id #uuid "44fedee3-225f-5257-b784-650a5fcab92a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186298072}] :answer-field/correct {:answer/id #uuid "44fedee3-225f-5257-b784-650a5fcab92a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186298072} :answer-field/id #uuid "6a404a93-a543-5b25-bd5a-884b929f3af2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298067}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92cb6cc4-3f75-59ef-814f-15d4bfd684a9" :question/math-academy-id "q-81553" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function  $f(x)=\\operatorname{cot}⁡(2x-\\frac{\\pi }{4})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{cot}⁡x$ are given by the expression\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{cot}⁡(2x-\\frac{\\pi }{4}),$ we replace the $x$ on the left-hand side of the above with $(2x-\\frac{\\pi }{4}).$ This gives\n\n$$\n2x-\\frac{\\pi }{4}=n\\pi .\n$$\n\nSolving for $x,$ we get \n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{4} & =n\\pi  \\\\ 2x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{8}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{8}+\\frac{n\\pi }{2},$ where $n$ is an integer."}]}
