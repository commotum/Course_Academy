2}+n\\pi +\\frac{\\pi }{3} \\\\ x & =\\frac{5\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{5\\pi }{6}+n\\pi ,$ where $n$ is an integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-29438/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4"] :knowledge-point/questions ["q-29438"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81553/selection/774ddd8a004a03992aec8b69988c26d393b2b3d23d0a4a1a719a38e046741591" :answer/id #uuid "9a1549b3-7c0c-5c28-8ec5-71414f7e2d34" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{6}+2n\\pi " :db/ensure [:answer/validate]} {:db/id "q-81553/selection/104040cb7378771ff4df8537ce0f44268e0f890f5a4d7c640d6d9cf907bc2e26" :answer/id #uuid "f13ce29d-3eaa-5381-81da-3d37561e9f9b" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2}+4n\\pi " :db/ensure [:answer/validate]} {:db/id "q-81553/selection/a7d8dfd45c80e35296c7616660e799acb27172b3851ce8aa3f95bd1f06c95fe7" :answer/id #uuid "44fedee3-225f-5257-b784-650a5fcab92a" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81553/selection/2b9bf91c39e2e67d3ab5ee9792408f29bcff0ebca515c6af4b54b56a63c80007" :answer/id #uuid "c496cb3b-d190-50b4-a703-37885888742c" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "q-81553/selection/0a5795b52d51f941d4d2fa5bb1b917c39acfe0ae427694fd5a5692e71d7f3e88" :answer/id #uuid "0e12faa6-5516-572f-94d1-76ad65c65121" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{3}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-81553/selection" :answer-field/id #uuid "6a404a93-a543-5b25-bd5a-884b929f3af2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81553/selection/a7d8dfd45c80e35296c7616660e799acb27172b3851ce8aa3f95bd1f06c95fe7" :answer-field/choices ["q-81553/selection/774ddd8a004a03992aec8b69988c26d393b2b3d23d0a4a1a719a38e046741591" "q-81553/selection/104040cb7378771ff4df8537ce0f44268e0f890f5a4d7c640d6d9cf907bc2e26" "q-81553/selection/a7d8dfd45c80e35296c7616660e799acb27172b3851ce8aa3f95bd1f06c95fe7" "q-81553/selection/2b9bf91c39e2e67d3ab5ee9792408f29bcff0ebca515c6af4b54b56a63c80007" "q-81553/selection/0a5795b52d51f941d4d2fa5bb1b917c39acfe0ae427694fd5a5692e71d7f3e88"] :db/ensure [:answer-field/validate]} {:db/id "q-81553" :question/id #uuid "92cb6cc4-3f75-59ef-814f-15d4bfd684a9" :question/math-academy-id "q-81553" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function  $f(x)=\\operatorname{cot}⁡(2x-\\frac{\\pi }{4})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{cot}⁡x$ are given by the expression\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{cot}⁡(2x-\\frac{\\pi }{4}),$ we replace the $x$ on the left-hand side of the above with $(2x-\\frac{\\pi }{4}).$ This gives\n\n$$\n2x-\\frac{\\pi }{4}=n\\pi .\n$$\n\nSolving for $x,$ we get \n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{4} & =n\\pi  \\\\ 2x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{\\pi }{8}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{8}+\\frac{n\\pi }{2},$ where $n$ is an integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81553/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943"] :knowledge-point/questions ["q-81553"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117692/selection/2bac7ca394e94e3fada78379b4805f94b5df3437b4ffbccaa6b8ebba9320be46" :answer/id #uuid "c304d38a-90f7-55a2-a2b3-33d7f56dff5b" :answer/type :answer.type/math :answer/value "x=n\\cdot {20}^{∘}" 