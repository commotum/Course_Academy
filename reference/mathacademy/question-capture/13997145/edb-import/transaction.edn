f482d7f5b516755f072a1d1869545f3f8f07a"] :db/ensure [:answer-field/validate]} {:db/id "q-19211" :question/id #uuid "06e573d1-988c-580b-8411-4633e9b41f74" :question/math-academy-id "q-19211" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 8 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}7 \\\\ -2 \\\\ 1\\end{aligned}].$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 7+8\\cdot (-2)+3\\cdot 1}{{7}^{2}+(-2)^{2}+{1}^{2}}b \\\\  & =-\\frac{6}{54}⟨7,-2,1⟩ \\\\  & =-\\frac{1}{9}⟨7,-2,1⟩ \\\\  & =⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19211/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-19211"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71662/selection/b5a3e12c687839d3c1f1c9f897806388f49a93f403c7fe7dc80429acdfb73770" :answer/id #uuid "70a00386-cdfc-5b3d-aeca-f146868abc17" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{5},\\frac{2}{5},-\\frac{1}{5}⟩" :db/ensure [:answer/validate]} {:db/id "q-71662/selection/c7ba5e4d2f3d5275b9531fe4d0e85ebfc57654e62e3679f5af9de84871a4da36" :answer/id #uuid "af5e97d1-b817-5a9b-bb9b-98fa02240c89" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{17},\\frac{1}{17},\\frac{1}{17}⟩" :db/ensure [:answer/validate]} {:db/id "q-71662/selection/26d414dba0f3a54f5d881781140ce17166116de6325e16b2cf5e623a26394179" :answer/id #uuid "1341c97a-c5bc-5ee4-a0fc-6a76eab5be11" :answer/type :answer.type/math :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/ensure [:answer/validate]} {:db/id "q-71662/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea