#{[{:db/id #edb/ref 17592186285221 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c11326f-5909-58ab-8ac9-a2e6eac5d144" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285223} {:answer/id #uuid "012048d7-8f85-51ed-a130-8530ce2575cc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285224} {:answer/id #uuid "2183e8b9-c1ec-59aa-86ca-a75255ee33c8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{54},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186285225} {:answer/id #uuid "e9782f45-163f-53f2-b62b-0bb67425f1b0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{54},\\frac{2}{9},-\\frac{1}{54}⟩" :db/id #edb/ref 17592186285226} {:answer/id #uuid "7e664081-7f20-570b-8217-9fab34b88008" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{9},-\\frac{7}{9},\\frac{1}{9}⟩" :db/id #edb/ref 17592186285227}] :answer-field/correct {:answer/id #uuid "2c11326f-5909-58ab-8ac9-a2e6eac5d144" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩" :db/id #edb/ref 17592186285223} :answer-field/id #uuid "e63f8760-8604-5eea-a72f-ab9fa16b5226" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285222}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06e573d1-988c-580b-8411-4633e9b41f74" :question/math-academy-id "q-19211" :question/problem "Let $a=[\\begin{aligned}1 \\\\ 8 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}7 \\\\ -2 \\\\ 1\\end{aligned}].$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 7+8\\cdot (-2)+3\\cdot 1}{{7}^{2}+(-2)^{2}+{1}^{2}}b \\\\  & =-\\frac{6}{54}⟨7,-2,1⟩ \\\\  & =-\\frac{1}{9}⟨7,-2,1⟩ \\\\  & =⟨-\\frac{7}{9},\\frac{2}{9},-\\frac{1}{9}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285228 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641ae6bc-94ce-5aeb-b227-ee864750d739" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285230} {:answer/id #uuid "bd44175d-c9f4-566b-8b89-bd0e1d550a5a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285231}] :answer-field/correct {:answer/id #uuid "bd44175d-c9f4-566b-8b89-bd0e1d550a5a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285231} :answer-field/id #uuid "30c7df2b-3e31-5391-bdd7-dd4d189640f0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285229} {:answer-field/choices [{:answer/id #uuid "58582c46-fd53-54ed-b029-de4b96b6a50b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285233}] :answer-field/correct {:answer/id #uuid "58582c46-fd53-54ed-b029-de4b96b6a50b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285233} :answer-field/id #uuid "c7890097-9735-5da7-aeea-19fc8e6055ae" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285232} {:answer-field/choices [{:answer/id #uuid "c050f669-87c7-50ee-ac1e-c7345084589b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285235}] :answer-field/correct {:answer/id #uuid "c050f669-87c7-50ee-ac1e-c7345084589b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285235} :answer-field/id #uuid "ee367f34-13c2-5ea3-8d3f-94a976b588fa" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285234}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7306a3a5-6825-5458-9f4f-bf8cfc014a8a" :question/math-academy-id "q-275234" :question/problem "Let $a=⟨1,-2,3⟩$ and $b=⟨1,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$\n\n${\\text{proj}}_{b}\\,a=⟨$\n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+(-2)\\cdot (-1)+3\\cdot (-1)}{{1}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{3}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285236 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186004dc-bf21-5c75-b207-17957a75b7fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186285238}] :answer-field/correct {:answer/id #uuid "186004dc-bf21-5c75-b207-17957a75b7fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{7}" :db/id #edb/ref 17592186285238} :answer-field/id #uuid "abd6d5ff-1ca2-55ee-acc2-18bef11b2c95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285237} {:answer-field/choices [{:answer/id #uuid "7cfd0ec2-830c-5d05-8552-70979895ea7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186285240}] :answer-field/correct {:answer/id #uuid "7cfd0ec2-830c-5d05-8552-70979895ea7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{14}" :db/id #edb/ref 17592186285240} :answer-field/id #uuid "2f2c4f95-c386-5cbe-a4cb-d57daff10d19" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285239} {:answer-field/choices [{:answer/id #uuid "cd413e8a-1fe6-58ab-9f30-b8d9bd54768b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{14}" :db/id #edb/ref 17592186285242}] :answer-field/correct {:answer/id #uuid "cd413e8a-1fe6-58ab-9f30-b8d9bd54768b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{14}" :db/id #edb/ref 17592186285242} :answer-field/id #uuid "377cbe47-3630-58e4-9527-6bb2800fd04a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285241}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "045d61b4-60dc-5b8e-a5ef-7c171a479374" :question/math-academy-id "q-317656" :question/problem "Let $r=⟨2,-1,3⟩$ and $s=⟨5,1,-4⟩.$ Find the vector projection of $s$ onto $r.$\n\n${\\text{proj}}_{r}\\,s=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{r}\\,s & =\\frac{r\\cdot s}{r\\cdot r}r \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{{r}_{x}^{2}+{r}_{y}^{2}+{r}_{z}^{2}}r \\\\  & =\\frac{2\\cdot 5+(-1)\\cdot 1+3\\cdot (-4)}{{2}^{2}+(-1)^{2}+{3}^{2}}r \\\\  & =\\frac{10-1-12}{4+1+9}⟨2,-1,3⟩ \\\\  & =\\frac{-3}{14}⟨2,-1,3⟩ \\\\  & =⟨\\,-\\frac{3}{7},\\frac{3}{14},-\\frac{9}{14}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285243 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5084666e-985c-5e0b-ab48-faf7af819dcc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285245} {:answer/id #uuid "1341c97a-c5bc-5ee4-a0fc-6a76eab5be11" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186285246} {:answer/id #uuid "70a00386-cdfc-5b3d-aeca-f146868abc17" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{5},\\frac{2}{5},-\\frac{1}{5}⟩" :db/id #edb/ref 17592186285247} {:answer/id #uuid "cff3505c-68f2-5a12-8c24-61dc8a0f27ba" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285248} {:answer/id #uuid "af5e97d1-b817-5a9b-bb9b-98fa02240c89" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{17},\\frac{1}{17},\\frac{1}{17}⟩" :db/id #edb/ref 17592186285249}] :answer-field/correct {:answer/id #uuid "1341c97a-c5bc-5ee4-a0fc-6a76eab5be11" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186285246} :answer-field/id #uuid "49efe57d-3c9a-5d50-b3ac-a4f5fd009178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285244}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a5f805d-9915-543e-b3c6-5d61cd49da57" :question/math-academy-id "q-71662" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]$ and $d=[\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 1+2\\cdot 3+1\\cdot (-3)}{{1}^{2}+{3}^{2}+(-3)^{2}}d \\\\  & =\\frac{4}{19}⟨1,3,-3⟩ \\\\  & =⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285250 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3affae1c-b528-5515-b431-b5d95272d870" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285252} {:answer/id #uuid "48e2358b-f37b-59d4-a314-cb2e1a7571b0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{2},\\frac{3}{2},0⟩" :db/id #edb/ref 17592186285253} {:answer/id #uuid "efeb4ccd-fd1e-5ed7-8f91-31863c779481" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{4},-\\frac{3}{4},0⟩" :db/id #edb/ref 17592186285254} {:answer/id #uuid "4793d0ea-fe72-518e-a4ee-593826244216" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,-6,0⟩" :db/id #edb/ref 17592186285255} {:answer/id #uuid "6a885921-f72e-513f-a9ec-0c4e89789028" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285256}] :answer-field/correct {:answer/id #uuid "3affae1c-b528-5515-b431-b5d95272d870" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186285252} :answer-field/id #uuid "ebc3f014-8a08-5ac2-b1ec-7b9357216b49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285251}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "25906b29-0945-551e-9d4c-1d3b9dbe8ab2" :question/math-academy-id "q-71847" :question/problem "Let $a=-2i-2j+4k$ and $b=2i-2j.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 2+(-2)\\cdot (-2)+4\\cdot 0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =\\frac{0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}]}
