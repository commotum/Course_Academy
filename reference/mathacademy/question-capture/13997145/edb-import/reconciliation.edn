}}{{r}_{x}^{2}+{r}_{y}^{2}+{r}_{z}^{2}}r \\\\  & =\\frac{2\\cdot 5+(-1)\\cdot 1+3\\cdot (-4)}{{2}^{2}+(-1)^{2}+{3}^{2}}r \\\\  & =\\frac{10-1-12}{4+1+9}⟨2,-1,3⟩ \\\\  & =\\frac{-3}{14}⟨2,-1,3⟩ \\\\  & =⟨\\,-\\frac{3}{7},\\frac{3}{14},-\\frac{9}{14}\\,⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-317656" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/activity-metadata.json" "file_sha256" "039778bf2f5ee01a44af21322b5e60a576f8c0c679b276bc6f566e7bede11cce"} {"question" "q-317656" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-317656" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{3}{7}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-317656" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-317656" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{14}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/