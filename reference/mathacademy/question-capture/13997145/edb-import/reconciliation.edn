\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 2+(-2)\\cdot (-2)+4\\cdot 0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =\\frac{0}{{2}^{2}+(-2)^{2}+{0}^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-71847" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/activity-metadata.json" "file_sha256" "039778bf2f5ee01a44af21322b5e60a576f8c0c679b276bc6f566e7bede11cce"} {"question" "q-71847" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-71847" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "⟨-\\frac{3}{2},\\frac{3}{2},0⟩"] ["math" "⟨0,0,0⟩"] ["math" "⟨6,-6,0⟩"] ["math" "⟨\\frac{3}{4},-\\frac{3}{4},0⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-71847" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨0,0,0⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-275234" "field" nil "attribute" "question/problem" "value" "Let $a=⟨1,-2,3⟩$ and $b=⟨1,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$\n\n${\\text{proj}}_{b}\\,a=⟨$\n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-275234" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+(-2)\\cdot (-1)+3\\cdot (-1)}{{1}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{3}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-275234" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/activity-metadata.json" "file_sha256" "039778bf2f5ee01a44af21322b5e60a576f8c0c679b276bc6f566e7bede11cce"} {"question" "q-275234" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"question" "q-275234" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13997145/state.json" "file_sha256" "d2912e29ccd68bbeb05a88e2186f5b10a892775ae0888f1a24520a9b2d0eff6c"} {"questi