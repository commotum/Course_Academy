f1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121250" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "| $+$ | $+$ |\n| --- | --- |\n| $+$ | $+$ |"] ["text" "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |"] ["text" "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |"] ["text" "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |"] ["text" "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/state.json" "file_sha256" "d99c7956ea2ef1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121250" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/state.json" "file_sha256" "d99c7956ea2ef1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121260" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x,y)=-7xy.$ Which of the following shaded areas gives the solution to the inequality $f(x,y)\\le 0?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/state.json" "file_sha256" "d99c7956ea2ef1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121260" "field" nil "attribute" "question/worked-solution" "value" "Notice that $f(x,y)$ equals zero when $x=0$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have an \"or equal to\" inequality, we use solid lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/c44c38febc908fe5e941978bf44bab2e2cb4bd250765950d84f9294c9c4c9c4b.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/209576cd78e9beb1c0f7a9bce8267163df1668a830ffc5c06918f8a726600fbe.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $-7x$ | $y$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-left | $(-1,1)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(1,1)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(-1,-1)$ | $+$ | $-$ | $-$ |\n| Bottom-Right | $(1,-1)$ | $-$ | $-$ | $+$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y)\\le 0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/cf7fdbafdf968d3e6adfe9544a3b9e5e1736ce22fc808567f1d66fc80916534e.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/state.json" "file_sha256" "d99c7956ea2ef1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121260" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/activity-metadata.json" "file_sha256" "8e58b44acdd9457c30fb264ff56c01c22fa69b4c1cd838665ce26ae9a216c301"} {"question" "q-121260" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/state.json" "file_sha256" "d99c7956ea2ef1d67882e6e61d2d1178dfff2e667b5e1611b92fefa1688362ff"} {"question" "q-121260" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/03b7fe2ba61cbe2608c37a78c82001f6a1fdebdb59f0be0785d55ee119ba8ff4.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/37000a15f2b6164932