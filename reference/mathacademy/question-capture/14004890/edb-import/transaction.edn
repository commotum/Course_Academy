the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/ff354ce9051d24e6f0adc4e0def143de86b36418b0b9846fdac1b4a63ca630f3.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $-$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $+$ |\n|  | $x<0$ | $x>0$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317187/field-1" "q-317187/field-2" "q-317187/field-3" "q-317187/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5"] :knowledge-point/questions ["q-317187"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121242/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" :answer/id #uuid "2ba810d4-2286-5118-bc6c-d0ff57ca25b1" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121242/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" :answer/id #uuid "8f45e7e3-1c06-56ae-b79b-fac878407e66" :answer/type :answer.type/text :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121242/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" :answer/id #uuid "6ad027d7-b9b1-5505-b671-a96dfc6cf952" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121242/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" :answer/id #uuid "316ea1d2-e530-52ca-ae91-ac5c4b9e5d60" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121242/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "1dcb4709-8ef9-59d6-ab20-c1875f83a81b" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121242/selection" :answer-field/id #uuid "66ec8207-f71a-5515-b588-28e91be1edec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121242/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer-field/choices ["q-121242/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" "q-121242/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" "q-121242/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" "q-121242/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" "q-121242/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f"] :db/ensure [:answer-field/validate]} {:db/id "q-121242" :question/id #uuid "9c438b33-3425-556a-afd9-37441982ae3b" :question/math-academy-id "q-121242" :question/problem "Consider the expression $f(x,y)=-5x{y}^{2}.$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>0$ |  |  |\n| --- | --- | --- |\n| $y<0$ |  |  |\n|  | $x<0$ | $x>0$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=0$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/c35c98904d2a0d0d6d49c582cd9f9dba9d96e91ae0da5deb2d329f38f77532e3.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/9340582eaad37c4ce1e0c8cbcdce48faec1e36c3c05adbedd61aa2de7168fd2f.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $-5x$ | ${y}^{2}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,1)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(1,1)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(-1,-1)$ | $+$ | $+$ | $+$ |\n| Bottom-Right | $(1,-1)$ | $-$ | $+$ | $-$ |\n\n \nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004890/assets/743df5f5c9232346866a01aed9afa3d41fff0f61bf7812b7ae5db9a43efe59f4.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<0$ | $x>0$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121242/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5"] :knowledge-point/questions ["q-121242"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121248/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" :answer/id #uuid "af942f4c-63cc-5ca3-9e21-45b18701a9f1" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121248/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "f987f1f1-d91f-5282-9438-29d66c2b713d" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121248/selection/8aeecd39a62f0e7e086a13b8dc6247818469757a2ad4c68d10219db33e06a8ac" :answer/id #uuid "22715b47-d30b-5f5b-9742-69b38d8d76a8" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $-$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121248/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" :answer/id #uuid "74c6a1b8-cffa-53f0-89a4-7b6a4b711eee" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121248/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" :answer/id #uuid "3c578e03-2a06-5e48-a1d8-13c654b10b6b" :answer/type :answer.type/text :answer/val