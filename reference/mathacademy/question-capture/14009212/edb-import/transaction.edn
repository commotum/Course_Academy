 {:db/id "q-113847" :question/id #uuid "b6b01770-2fab-59e5-955c-87bb4f949434" :question/math-academy-id "q-113847" :question/problem "$\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=4-{x}^{4}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4{x}^{3}\\,⟹\\,-2\\text{d}u=8{x}^{3}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x & =\\int {e}^{4-{x}^{4}}\\cdot 8{x}^{3}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot (-2)\\,\\text{d}u \\\\  & =-2\\int {e}^{u}\\,\\text{d}u \\\\  & =-2{e}^{u}+C \\\\  & =-2{e}^{4-{x}^{4}}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113847/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c"] :knowledge-point/questions ["q-113847"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73662/selection/5f133ab931cfae9d9ae8af9911b6a8415330c491ca480c5097fc0063bdbccb14" :answer/id #uuid "0fbef993-6bb4-57ba-8310-faf8d469108c" :answer/type :answer.type/math :answer/value "{e}^{2{x}^{2}-x}+C" :db/ensure [:answer/validate]} {:db/id "q-73662/selection/99dda1ccfb950bb9bd9a24be14761704c9f73312fa9e726053d5a008b42b800f" :answer/id #uuid "d708ece7-2ee5-5957-b1da-6d11544767c9" :answer/type :answer.type/math :answer/value "{e}^{2{x}^{2}-x}+2{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-73662/selection/e44df06775076c854da7a1ba0e94594e7dd00ef7cbdbdb83bfb06abba5c5e880" :answer/id #uuid "9086fe80-c0df-5a16-b3ea-7566deb23afc" :answer/type :answer.type/math :answer/value "4{e}^{2{x}^{2}-x}+C" :db/ensure [:answer/validate]} {:db/id "q-73662/selection/1ab94075e9218801f8a91f66d8de567324084bb654c7fb6d306cd5daab018bcc" :answer/id #uuid "90718391-0708-56a8-ad3e-c8e0d4ca58d4" :answer/type :answer.type/math :answer/value "(2{x}^{2}-x){e}^{2{x}^{2}-x}+C" :db/ensure [:answer/validate]} {:db/id "q-73662/selection/7878deed096c03955ce07f7b9ec1