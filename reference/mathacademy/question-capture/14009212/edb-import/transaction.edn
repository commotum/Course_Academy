ge-point/questions ["q-211989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31478/selection/2e5c621c62589059c7ec4fe9a25f8d096a5011774b0326c77430a6d87bd401e7" :answer/id #uuid "634f9c1e-195a-5291-a381-1a25df1c873e" :answer/type :answer.type/math :answer/value "\\frac{5x}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31478/selection/041710c657711320d1cf4f0a4d73e0bd8fb13410acef6236a59bef26a83af4e8" :answer/id #uuid "4a09703d-db93-5b41-bc16-e2125fed2af7" :answer/type :answer.type/math :answer/value "\\frac{1}{{5}^{x}\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31478/selection/7e01228060621065e6a2aa80c85c9a55df4f54645310d4307ef52ed966000f27" :answer/id #uuid "ef8fe0f4-ee45-5fa9-bece-f4def7b5b39b" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{5\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31478/selection/4eb1d091421fe3a392d44c9c772878e13a3b84ca313c1440b6c98182612b9d39" :answer/id #uuid "61ca044c-52c9-528c-a814-b0ae9a974bd9" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31478/selection/805007b6a3481630ef2687fab909f318a34a9c2b942346d47c5efcaef8088165" :answer/id #uuid "9d8ad716-9611-54ff-ae7d-94fa2eb98624" :answer/type :answer.type/math :answer/value "\\frac{5\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31478/selection" :answer-field/id #uuid "97859bd5-9f67-5fda-81af-db2410d31c30" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31478/selection/4eb1d091421fe3a392d44c9c772878e13a3b84ca313c1440b6c98182612b9d39" :answer-field/choices ["q-31478/selection/2e5c621c62589059c7ec4fe9a25f8d096a5011774b0326c77430a6d87bd401e7" "q-31478/selection/041710c657711320d1cf4f0a4d73e0bd8fb13410acef6236a59bef26a83af4e8" "q-31478/selection/7e01228060621065e6a2aa80c85c9a55df4f54645310d4307ef52ed966000f27" "q-31478/selection/4eb1d091421fe3a392d44c9c772878e13a3b84ca313c1440b6c98182612b9d39" "q-31478/selection/805007b6a3481630ef2687fab909f318a34a9c2b942346d47c5efcaef8088165"] :db/ensure [:answer-field/validate]} {:db/id "q-31478" :question/id #uuid "3b273e42-4e7d-543c-9946-fc5691a84c11" :question/math-academy-id "q-31478" :question/problem "Calculate the integral $\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={5}^{x}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={5}^{x}\\operatorname{ln}⁡5\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u={5}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x & =\\int \\frac{1}{{5}^{x}+1}\\cdot {5}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|{5}^{x}+1|+C \\\\  & =\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-31478/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3"] :knowledge-point/questions ["q-31478"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-113852"] :question/problem "Calculate the integral $\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{3x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,⟹\\,\\frac{2}{3}\\text{d}u=2{e}^{3x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x & =\\int {({e}^{3x}+2)}^{3}\\cdot 2{e}^{3x}\\,\\text{d}x \\\\  & =\\int {u}^{3}\\,\\frac{2}{3}\\text{d}u \\\\  & =\\frac{2}{3}\\int {u}^{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}\\frac{{u}^{4}}{4}+C \\\\  & =\\frac{{({e}^{3x}+2)}^{4}}{6}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-31480/selection/e311a01eb5073ce25a96ac2a6e57b4e8ef72b31bf785a60d7585002f46045ebd" :answer/id #uuid "329a0e08-4a9a-584f-bb7b-8f2f2a6638f3" :answer/type :answer.type/math :answer/value "\\frac{4\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31480/selection/dea6a93ecea914ba4ccfde9844b70a5ff37beabea95e0672ecbff16c0e5706de" :answer/id #uuid "daeaede7-21bd-5064-96a6-480999a96fb7" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31480/selection/e5a38c0ff9b9b649f05aa6ce157aea5ef0a8325380fc94fc5582e821de10da6d" :answer/id #uuid "ca2fdf77-99b0-5693-969a-d0c90c07f2e0" :answer/type :answer.type/math :answer/value "\\frac{1}{{4}^{x}\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31480/selection/685c3d543fa7fc239cdae6b63ed67220410fa9832ab6adbcce9f71c85b29fbf0" :answer/id #uuid "65d98815-74b8-51c3-8984-4c38e1d8b597" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x})}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31480/selection/ccbf2fae50b7f6eac4d707c3e0809c95e5f017b08c5dc4546943eab4a29d1a2c" :answer/id #uuid "808a0072-89c0-5907-9870-dd48be361779" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{4\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31480/selection" :answer-field/id #uuid "dceef912-caaa-55b6-8261-80e03aa0e31d" :answer-field/key "selection" :answer-field/type :answer-field.