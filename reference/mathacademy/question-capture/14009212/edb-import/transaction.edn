the new variable $u={z}^{2}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2z\\,⟹\\,\\frac{1}{2}\\text{d}u=z\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int z{e}^{{z}^{2}}\\,\\text{d}z & =\\int {e}^{{z}^{2}}\\cdot z\\,\\text{d}z \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{{z}^{2}}}{2}+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2382/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c"] :knowledge-point/questions ["q-2382"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31426/selection/f0a75e2269ff48a2afdce124502d7f0cc58f4e733c1c2d37b0e16bcac438bfe5" :answer/id #uuid "6a7de3b9-6309-5a34-9698-91d8b33e1430" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x/3}}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31426/selection/fbd6adb6332663f8617be55cd062d3eb723420fd5468577067a60facc13b235e" :answer/id #uuid "1f7805e1-1163-511e-9695-57dda9206c4e" :answer/type :answer.type/math :answer/value "\\frac{3\\cdot {5}^{{x}^{2}/3}}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31426/selection/8d0ddf7b31b8bdb5006d96da6c7cb4238a3cbef704f0e98bfe209570055bc768" :answer/id #uuid "adfc7e8e-408e-5bc6-9197-8a914e0e32eb" :answer/type :answer.type/math :answer/value "\\frac{{5}^{{x}^{2}/3}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31426/selection/155ecb6a5fcdb3e19ec434dcad92b0840dc070decc3b30b02a043698b32eb671" :answer/id #uuid "d7709caf-8fea-5d86-801c-4e7563031207" :answer/type :answer.type/math :answer/value "\\frac{{5}^{{x}^{2}/3}}{\\operatorname{ln}⁡5}+C" :db/ensure [:answer/validate]} {:db/id "q-31426/selection/fd6f23f2cbded707515e23d4eb304584f44a764a8f90e23501294ae7b1e1c5b4" :answer/id #uuid "d8683fc0-4e03-59a4-8dcd-4dfb995fd6c1" :answ