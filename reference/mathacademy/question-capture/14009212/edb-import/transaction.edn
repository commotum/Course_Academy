1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{20}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{20}{e}^{u}\\,{|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{20}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{20}(25-1) \\\\  & =\\frac{24}{20} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-30953/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-30953"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30978/selection/afb4c0d8b106fe24cb8d55ae3113cc22203bdefd133c9d508c8d492ca7eccaff" :answer/id #uuid "fb2860e2-c4fc-5e87-b6ec-58424a12f930" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{ln}⁡2}{4}" :db/ensure [:answer/validate]} {:db/id "q-30978/selection/3c4346494ea6963178a51ac6730ae3c93025c6c9895d1cb93b94d7dd70873774" :answer/id #uuid "f9fd1daf-65ac-5c3b-a00c-c7aa76db9069" :answer/type :answer.type/math :answer/value "\\frac{3}{\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-30978/selection/d69ae239348622fc7329ec6f27a5d25ecde706ab55513a1b58902aa2de8de1ba" :answer/id #uuid "ff93049f-117f-5f48-9070-b85674fc7dcf" :answer/type :answer.type/math :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-30978/selection/83b7c8ec0b10b4e5c38db65e33e4a18a2e9a2ae82f2fe6e254759b7407adc7f6" :answer/id #uuid "bceb1551-8b24-5a34-838f-53aa66d18deb" :answer/type :answer.type/math :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-30978/selection/52e0c5f2c31741804e4083a198ffbebf6c7b16481b9a7c018cf96221bb7464d6" :answer/id #uuid "745fd39e-9c8d-5c28-95e5-60f77c5c343f" :answer/type :answer.type/math :answer/value "\\frac{4\\operatorname{ln}⁡2}{3}" :db/ensure [:answer/validate]} {:db/id "q-30978/selection" :answer-field/id #uuid "fda2342c-99c0-5552-bd3c-ad611b2fe663" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30978/selection/83b7c8ec0b10b4e5c38db65e33e4a18a2e9a2ae82f2fe6e254759b7407adc7f6" :answer-field/choices ["q-30978/selection/afb4c0d8b106fe24cb8d55ae3113cc22203bdefd133c9d508c8d492ca7eccaff" "q-30978/selection/3c4346494ea6963178a51ac6730ae3c93025c6c9895d1cb93b94d7dd70873774" "q-30978/selection/d69ae239348622fc7329ec6f27a5d25ecde706ab55513a1b58902aa2de8de1ba" "q-30978/selection/83b7c8ec0b10b4e5c38db65e33e4a18a2e9a2ae82f2fe6e254759b7407adc7f6" "q-30978/selection/52e0c5f2c31741804e4083a198ffbebf6c7b16481b9a7c018cf96221bb7464d6"] :db/ensure [:answer-field/validate]} {:db/id "q-30978" :question/id #uuid "15b50c80-e89e-578d-bbe2-f84d4dc56be6" :question/math-academy-id "q-30978" :question/problem "Evaluate the integral ${\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{4}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2\\operatorname{ln}⁡4}(4-1) \\\\  & =\\frac{3}{2\\operatorname{ln}⁡4} \\\\  & =\\frac{3}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-30978"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-14402"] :question/problem "Calculate  $\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14403"] :question/problem "Calculate  $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14404"] :question/problem "Calculate  $\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad\n\\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}+1}\\cdot {e}^{2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({e}^{2x}+1)+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14407"] :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
