0651e8871ae295e7d1788" "q-73669/selection/719647d7414ad2df3d07065a2951615aef3321b01d84469df303682613ab131f"] :db/ensure [:answer-field/validate]} {:db/id "q-73669" :question/id #uuid "6e85ab7a-4e7d-54fa-9beb-bc74fc283a55" :question/math-academy-id "q-73669" :question/problem "Calculate the integral $\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3"] :knowledge-point/questions ["q-73669"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49577/selection/210a5203cbd6ca689d1683dbcb2c640e2ced1f111f2d29e74f46c295e9e3beaa" :answer/id #uuid "ca040f52-f167-5be3-af93-6b9ffe5ec51f" :answer/type :answer.type/math :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-49577/selection/1d305a5a0517b82725f990da215672309e7cc9d08794c111963acb1481a8fb69" :answer/id #uuid "8080bb2b-bb23-5bb8-9a74-37d55fabde67" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\sqrt{({e}^{x}+4)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-49577/selection/94f44cb8690583680f4be91234efa111bf660fc6036845310f9ee05cf8244fd0" :answer/id #uuid "11b2fe16-30a6-557b-b007-a6914a20bce0" :answer/type :answer.type/math :answer/value "10\\sqrt[3]{({e}^{x}+4)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-49577/selection/b857e0ed844d821a3420b35a4462635d3c346afc4dfab0f2c6e10eaac2e01ab5" :answer/id #uuid "e2ec5beb-9ab3-5714-881c-d33388c7af2f" :answer/type :answer.type/math :answer/value "5\\sqrt{({e}^{x}+4)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-49577/selection/6a8319b2eb8273c4e5309874e54476f5bcc49caca549caaf5b782370d74b1f9b" :answer/id #uuid "cf4e63bc-e081-5a29-96e2-8401b0e4d970" :answer/type :answer.type/math :answer/value "3\\sqrt{({e}^{x}+4)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-49577/selection" :answer-field/id #uuid "841f8929-4054-5bcd-a921-096fa04fc9a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49577/selection/210a5203cbd6ca689d1683dbcb2c640e2ced1f111f2d29e74f46c295e9e3beaa" :answer-field/choices ["q-49577/selection/210a5203cbd6ca689d1683dbcb2c640e2ced1f111f2d29e74f46c295e9e3beaa" "q-49577/selection/1d305a5a0517b82725f990da215672309e7cc9d08794c111963acb1481a8fb69" "q-49577/selection/94f44cb8690583680f4be91234efa111bf660fc6036845310f9ee05cf8244fd0" "q-49577/selection/b857e0ed844d821a3420b35a4462635d3c346afc4dfab0f2c6e10eaac2e01ab5" "q-49577/selection/6a8319b2eb8273c4e5309874e54476f5bcc49caca549caaf5b782370d74b1f9b"] :db/ensure [:answer-field/validate]} {:db/id "q-49577" :question/id #uuid "ef8991f5-d3c9-501b-9b92-01dcff44efa7" :question/math-academy-id "q-49577" :question/problem "Calculate the integral $\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{x}+4.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,⟹\\,\\text{d}u={e}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x & =5\\int \\sqrt{{e}^{x}+4}\\cdot {e}^{x}\\,\\text{d}x \\\\  & =5\\int \\sqrt{u}\\,\\text{d}u \\\\  & =5\\int {u}^{1/2}\\,\\text{d}u \\\\  & =5\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{10}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49577/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3"] :knowledge-point/questions ["q-49577"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350743/field-1/0878a332206b794c9a0b7ad4f520f126991f4c5040bfddcf0d384d3c1fdab2ae" :answer/id #uuid "c21e7f7c-fe79-51e3-b539-3efb1cfd4b79" :answer/type :answer.type/math :answer/value "\\frac{24}{\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-350743/field-1/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "c99634b7-db4d-5e9f-a9b1-3c08c2de6a3a" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-350743/field-1" :answer-field/id #uuid "eeff1d0a-7280-5f66-b3d6-7208c2cbe509" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350743/field-1/0878a332206b794c9a0b7ad4f520f126991f4c5040bfddcf0d384d3c1fdab2ae" :answer-field/choices ["q-350743/field-1/0878a332206b794c9a0b7ad4f520f126991f4c5040bfddcf0d384d3c1fdab2ae" "q-350743/field-1/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-350743" :question/id #uuid "7f67eb53-1da7-5fde-b905-7043552c9612" :question/math-academy-id "q-350743" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=2x+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x & ={\\int }_{1}^{3}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{1}^{3} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{3}-{3}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(27-3) \\\\  & =\\frac{24}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350743/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-350743"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350751/field-1/cc5a9557b8ca50c8811318b3ba5d58bec98cccaafe40bf288f824e81b75029d6" :answer/id #uuid "816ff4d4-ab6c-554b-aacc-b47d5d35bbcb" :answer/type :answer.type/math :answer/value "4\\ln(\\frac{16}{7})" :db/ensure [:answer/validate]} {:db/id "q-350751/field-1" :answer-field/id #uuid "764ee92c-721d-5092-84ad-bc082fda6618" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350751/field-1/cc5a9557b8ca50c8811318b3ba5d58bec98cccaafe40bf288f824e81b75029d6" :answer-field/choices ["q-350751/field-1/cc5a9557b8ca50c8811318b3ba5d58bec98cccaafe40bf288f824e81b75029d6"] :db/ensure [:answer-field/validate]} {:db/id "q-350751" :question/id #uuid "5258fcac-3d52-5d66-b492-897317f2df61" :question/math-academy-id "q-350751" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{e}^{x}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{x}\\,⟹\\,\\text{d}u=3{e}^{x}\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $7$ | $16$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{4}{3{e}^{x}+1}\\cdot 3{e}^{x}\\,\\text{d}x \\\\  & ={\\int }_{7}^{16}\\frac{4}{u}\\cdot \\,\\text{d}u \\\\  & =4{\\int }_{7}^{16}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡|u|\\,{|}_{7}^{16} \\\\  & =4(\\operatorname{ln}⁡(16)-\\operatorname{ln}⁡(7)) \\\\  & =4\\operatorname{ln}⁡(\\frac{16}{7}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350751/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-350751"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346400/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" :answer/id #uuid "24bbe951-b80c-56bc-8455-531d79c7ea01" :answer/type :answer.type/math :answer/value "\\frac{2}{\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-346400/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0d409aae-2b2e-5948-b744-9aa88a73e463" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-346400/field-1" :answer-field/id #uuid "bdf5b0c4-c037-50d0-a65e-348e1ec3231d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346400/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" :answer-field/choices ["q-346400/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" "q-346400/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-346400" :question/id #uuid "abb8a09a-9fe8-576e-a177-b79651a7d468" :question/math-academy-id "q-346400" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{0}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{1}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(3-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346400/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-346400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30953/selection/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b" :answer/id #uuid "c5226886-2dd4-56b6-a235-11e571cc3ad9" :answer/type :answer.type/math :answer/value "\\frac{1}{20}" :db/ensure [:answer/validate]} {:db/id "q-30953/selection/22fca34662ca753b2c0b71a15c560fb8eaa8d3a83bd3710f7b20dbe2ba22c0d4" :answer/id #uuid "476736d0-b3f7-52e4-953a-75b569c5d22c" :answer/type :answer.type/math :answer/value "\\frac{3}{20}" :db/ensure [:answer/validate]} {:db/id "q-30953/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "8f157af3-8ec6-59cc-bec6-3b764fdb8cc7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-30953/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "64e61e4f-e923-54ab-a6