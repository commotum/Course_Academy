97e0513"] :knowledge-point/questions ["q-73665"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31420"] :question/problem "Calculate the integral $\\int x{8}^{3{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{8}^{3{x}^{2}}\\,\\text{d}x & =\\int {8}^{3{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\int {8}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int {8}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\frac{{8}^{u}}{\\operatorname{ln}⁡8}+C \\\\  & =\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-211989/selection/cf29266d010f70b831eaf7d66ada0bad3e0db74d317fe5bc3eba430e69d475b2" :answer/id #uuid "f9dc64c0-93ac-5c52-8d47-9bb80a6d0cff" :answer/type :answer.type/math :answer/value "\\frac{5\\cdot {4}^{{x}^{3}}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-211989/selection/8e01cddff74257d4328c3d56778d44d2f5e73a7df1638f731d888483a07607a7" :answer/id #uuid "8976fbd5-d328-57bb-9857-643645fa3006" :answer/type :answer.type/math :answer/value "\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-211989/selection/803208dae254d5de946c9349dfe3729d56259dd602186cfb0efde1bff5b2bba3" :answer/id #uuid "b19c27ce-bfb8-5f29-8e89-fee08909a596" :answer/type :answer.type/math :answer/value "\\frac{{4}^{{x}^{3}/5}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-211989/selection/bdb27d9f9159972c135b8406e7c4b5928cfe5f2c5003acecf3f9584ad0f16e17" :answer/id #uuid "5ec43df5-ac12-53e9-be5e-5000547acd9c" :answer/type :answer.type/math :answer/value "\\frac{3\\cdot {4}^{{x}^{3}/5}}{5\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-211989/selection/bf9b75a7b28e3507774a52b