validate]} {:db/id "q-73801" :question/id #uuid "26102d53-ee02-5cbb-a2ec-6cc44cead40a" :question/math-academy-id "q-73801" :question/problem "Calculate the integral $\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x & =\\int {6}^{{x}^{2}+1}\\cdot 2x\\,\\text{d}x \\\\  & =\\int {6}^{u}\\cdot \\,\\text{d}u \\\\  & =\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73801/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513"] :knowledge-point/questions ["q-73801"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73665/selection/d35a2bfc02233a408d775b434a9814b409d903b9f11ea83681ad10210407eb51" :answer/id #uuid "b349473f-02e8-5091-81d4-cae6cae9b5d7" :answer/type :answer.type/math :answer/value "{4}^{4{x}^{2}-3}\\,\\operatorname{ln}⁡4+C" :db/ensure [:answer/validate]} {:db/id "q-73665/selection/54c21337ebb4e0ce0395b50680e416d5d60cae33fc4e07a526c5c70b400272e7" :answer/id #uuid "1339c3a4-944e-5fdf-8c75-71b4aef77003" :answer/type :answer.type/math :answer/value "\\frac{2\\cdot {4}^{4{x}^{2}-3}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-73665/selection/3f21ac8ec0abec7edc6f79a8acd4d51628a4fb3f1342dcad1b4e7c75626207ee" :answer/id #uuid "d77ecfd9-5c25-595e-94c0-56f77d02b680" :answer/type :answer.type/math :answer/value "\\frac{{4}^{4{x}^{2}-3}}{4\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-73665/selection/e6c47a30d013f991be39dd899fef80d8c66b67d8a5065803acfce7a3e96f99e4" :answer/id #uuid "7773e0c5-68a0-52b6-bc26-f2e4c3a9c900" :answer/type :answer.type/math :answer/value "{4}^{4{x}^{2}-3}+C" :db