#{[{:db/id #edb/ref 17592186183892 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate $\\displaystyle{\\displaystyle \\int x^2 e^{x^3+1}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable\n\n$$\nu = x^3+1\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\intx^{2}e^{x^{3} + 1}dx &= \\inte^{x^{3} + 1} \\cdot x^{2}dx \\\\\n&= \\inte^{u} \\cdot \\frac{1}{3}du \\\\\n&= \\frac{1}{3}\\inte^{u}du \\\\\n&= \\frac{1}{3}e^{u} + C \\\\\n&= \\frac{1}{3}e^{x^{3} + 1} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186183893 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x$." :question/worked-solution "Let's introduce the new variable $u= 1-x^4$. Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u\n$$\n\nTherefore,\n\n$$\n\\begin{aligned} \\int {x^3\\,{3^{1-x^4}}}\\, \\textrm{d}x &=\\int {{3^{1-x^4}}\\cdot x^3}\\, \\textrm{d}x \\\\[5pt] &= \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u \\\\[5pt] &= -\\dfrac{1}{4}\\int {3^{u}} \\textrm{d}u \\\\[5pt] &= -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C \\\\[5pt] &= -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186183894 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/id #uuid "70fd3433-e905-5643-8e55-0bdf774d781e" :question/math-academy-id "e-14404" :question/problem "Calculate $\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x$." :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable\n\n$$\nu = e^{2x}+1\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad \\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\int\\frac{e^{2x}}{e^{2x} + 1}dx &= \\int\\frac{1}{e^{2x} + 1} \\cdot e^{2x}dx \\\\\n&= \\int\\frac{1}{u} \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2}\\int\\frac{1}{u}du \\\\\n&= \\frac{1}{2}\\ln\\begin{vmatrix}u & + C \\\\ = \\frac{1}{2}\\ln & e^{2x} + 1\\end{vmatrix}+ C \\\\\n&= \\frac{1}{2}\\ln (e^{2x} + 1) + C\n\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x$."}] [{:db/id #edb/ref 17592186183895 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\displaystyle \\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2$. Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x \\qquad\\Longrightarrow\\qquad -4 \\, \\textrm{d}u=16x \\, \\textrm{d}x\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | ---: | ---: |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{\\sqrt{\\ln 4}}16xe^{-2x^{2}}dx &= \\int_{0}^{\\sqrt{\\ln 4}}e^{-2x^{2}} \\cdot 16xdx \\\\\n&= \\int_{0}^{-2\\ln 4}e^{u} \\cdot (-4du) \\\\\n&=-4\\int_{0}^{-2\\ln 4}e^{u}du \\\\\n&= \\left.- 4e^{u}\\right|_{0}^{-2\\ln 4} \\\\\n&=-4(e^{-2\\ln 4} - e^{0}) \\\\\n&=-4(\\frac{1}{16} - 1) \\\\\n&= 4(\\frac{15}{16}) \\\\\n&= \\frac{15}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184394 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8f5d105-8055-5ea5-9926-a138e72c3edf" :answer/type {:db/ident :answer.type/math} :answer/value "(2(e^{3x} + 2)^{4})/(3) + C" :db/id #edb/ref 17592186180814} {:answer/id #uuid "c760b1cd-4a34-5cb7-aed9-e32b57a57a0b" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{3})/(6) + C" :db/id #edb/ref 17592186180815} {:answer/id #uuid "eace7b80-5e7f-5fb9-b7f3-1519a4d426f8" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(6) + C" :db/id #edb/ref 17592186180816} {:answer/id #uuid "305b151c-9904-5449-a37f-e354ba7637d3" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(4) + C" :db/id #edb/ref 17592186180817} {:answer/id #uuid "64164f8a-81a6-5280-900d-d1421e3abc35" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{3})/(3) + C" :db/id #edb/ref 17592186180818}] :answer-field/correct {:answer/id #uuid "eace7b80-5e7f-5fb9-b7f3-1519a4d426f8" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(6) + C" :db/id #edb/ref 17592186180816} :answer-field/id #uuid "91a049d8-617b-56dd-8aca-08f0eb38c85c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180813}] :question/id #uuid "2445485f-2474-5b96-9886-76e2b061635a" :question/math-academy-id "q-113852" :question/problem "Calculate the integral $\\displaystyle \\int2e^{3x}(e^{3x} + 2)^{3}dx$."}] [{:db/id #edb/ref 17592186184688 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9450755e-6a3f-58b8-85a5-f1d41eaa9e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183018} {:answer/id #uuid "eea871d3-f105-56a1-8603-765b4091ada7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183019} {:answer/id #uuid "f6a192b7-1536-5d74-a3d9-d1f6ecda0f13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{\\ln 8} + C" :db/id #edb/ref 17592186183020} {:answer/id #uuid "fadbf7f5-e45e-588d-b86a-e4f6a27dc852" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x}}{2\\ln 8} + C" :db/id #edb/ref 17592186183021} {:answer/id #uuid "45df17b7-9658-59ad-a46d-eac1d063622a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{3\\ln 8} + C" :db/id #edb/ref 17592186183022}] :answer-field/correct {:answer/id #uuid "9450755e-6a3f-58b8-85a5-f1d41eaa9e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183018} :answer-field/id #uuid "69400551-555e-53c7-92d2-d54f0bec8c32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183017}] :question/id #uuid "a383a3e5-774c-580f-ac7a-6d64870e5f9c" :question/math-academy-id "q-31420" :question/problem "Calculate the integral $\\intx8^{3x^{2}}dx$."}]}
