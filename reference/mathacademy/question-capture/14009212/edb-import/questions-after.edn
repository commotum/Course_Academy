#{[{:db/id #edb/ref 17592186183892 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate  $\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186183893 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate  $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n}\n$$"}] [{:db/id #edb/ref 17592186183894 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/id #uuid "70fd3433-e905-5643-8e55-0bdf774d781e" :question/math-academy-id "e-14404" :question/problem "Calculate  $\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad\n\\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}+1}\\cdot {e}^{2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({e}^{2x}+1)+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$"}] [{:db/id #edb/ref 17592186183895 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288958 :knowledge-point/_questions [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0508167c-38da-59ca-ac83-2f4271c872ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{4-{x}^{4}}}{2}+C" :db/id #edb/ref 17592186288960} {:answer/id #uuid "2f426f3b-67fa-50d9-8f09-2a2d0c42f884" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186288961} {:answer/id #uuid "aaa14d0a-fa18-5739-8f25-e0bf0e7fa7ce" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186288962} {:answer/id #uuid "99aff8f1-0dd5-5b48-b779-330b6b9cdbec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{4-{x}^{4}}}{2}+C" :db/id #edb/ref 17592186288963} {:answer/id #uuid "fa1b8fd5-dcea-5949-a283-5349694f86d5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186288964}] :answer-field/correct {:answer/id #uuid "2f426f3b-67fa-50d9-8f09-2a2d0c42f884" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186288961} :answer-field/id #uuid "8aa52fef-d760-55ea-99ad-1ae192a4e070" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288959}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b6b01770-2fab-59e5-955c-87bb4f949434" :question/math-academy-id "q-113847" :question/problem "$\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=4-{x}^{4}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4{x}^{3}\\,⟹\\,-2\\text{d}u=8{x}^{3}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x & =\\int {e}^{4-{x}^{4}}\\cdot 8{x}^{3}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot (-2)\\,\\text{d}u \\\\  & =-2\\int {e}^{u}\\,\\text{d}u \\\\  & =-2{e}^{u}+C \\\\  & =-2{e}^{4-{x}^{4}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184394 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8f5d105-8055-5ea5-9926-a138e72c3edf" :answer/type {:db/ident :answer.type/math} :answer/value "(2(e^{3x} + 2)^{4})/(3) + C" :db/id #edb/ref 17592186180814} {:answer/id #uuid "c760b1cd-4a34-5cb7-aed9-e32b57a57a0b" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{3})/(6) + C" :db/id #edb/ref 17592186180815} {:answer/id #uuid "eace7b80-5e7f-5fb9-b7f3-1519a4d426f8" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(6) + C" :db/id #edb/ref 17592186180816} {:answer/id #uuid "305b151c-9904-5449-a37f-e354ba7637d3" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(4) + C" :db/id #edb/ref 17592186180817} {:answer/id #uuid "64164f8a-81a6-5280-900d-d1421e3abc35" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{3})/(3) + C" :db/id #edb/ref 17592186180818}] :answer-field/correct {:answer/id #uuid "eace7b80-5e7f-5fb9-b7f3-1519a4d426f8" :answer/type {:db/ident :answer.type/math} :answer/value "((e^{3x} + 2)^{4})/(6) + C" :db/id #edb/ref 17592186180816} :answer-field/id #uuid "91a049d8-617b-56dd-8aca-08f0eb38c85c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180813}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2445485f-2474-5b96-9886-76e2b061635a" :question/math-academy-id "q-113852" :question/problem "Calculate the integral $\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{3x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,⟹\\,\\frac{2}{3}\\text{d}u=2{e}^{3x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x & =\\int {({e}^{3x}+2)}^{3}\\cdot 2{e}^{3x}\\,\\text{d}x \\\\  & =\\int {u}^{3}\\,\\frac{2}{3}\\text{d}u \\\\  & =\\frac{2}{3}\\int {u}^{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}\\frac{{u}^{4}}{4}+C \\\\  & =\\frac{{({e}^{3x}+2)}^{4}}{6}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288965 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b19c27ce-bfb8-5f29-8e89-fee08909a596" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{3}/5}}{3}+C" :db/id #edb/ref 17592186288967} {:answer/id #uuid "8976fbd5-d328-57bb-9857-643645fa3006" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288968} {:answer/id #uuid "5ec43df5-ac12-53e9-be5e-5000547acd9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {4}^{{x}^{3}/5}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288969} {:answer/id #uuid "6861e02b-f0ed-5c35-b817-f540a8a56afa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{3}}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288970} {:answer/id #uuid "f9dc64c0-93ac-5c52-8d47-9bb80a6d0cff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\cdot {4}^{{x}^{3}}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288971}] :answer-field/correct {:answer/id #uuid "8976fbd5-d328-57bb-9857-643645fa3006" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288968} :answer-field/id #uuid "f1fb677b-afd5-587a-bba3-97a779c0a8b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288966}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1f634921-ba81-58b3-914f-15ce34bfdfa1" :question/math-academy-id "q-211989" :question/problem "Calculate the integral $\\int {x}^{2}{4}^{{x}^{3}/5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=\\frac{{x}^{3}}{5}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{5}{x}^{2}\\,⟹\\,\\frac{5}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{4}^{{x}^{3}/5}\\,\\text{d}x & =\\int {4}^{{x}^{3}/5}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int {4}^{u}\\cdot \\frac{5}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{5\\cdot {4}^{u}}{3\\operatorname{ln}⁡4}+C \\\\  & =\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288972 :knowledge-point/_questions [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68e4ca05-57a1-517c-bcb7-6f4bf544219f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186288974} {:answer/id #uuid "306edbd1-1009-5311-9961-90d5caf554db" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186288975} {:answer/id #uuid "8f70681a-4033-5db9-9702-6da36705db42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186288976} {:answer/id #uuid "d875c4bf-b292-53fc-948e-c0366fa73cd9" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{{z}^{2}}+C" :db/id #edb/ref 17592186288977} {:answer/id #uuid "d1e8a2cf-9c50-518c-a406-6fa89f738b8d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{{z}^{2}}+C" :db/id #edb/ref 17592186288978}] :answer-field/correct {:answer/id #uuid "68e4ca05-57a1-517c-bcb7-6f4bf544219f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186288974} :answer-field/id #uuid "4f33f4c2-0743-5af1-8c87-5fdeba6e0b4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288973}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4cb0eeb5-a3c3-5f61-b507-b316ccd8d22d" :question/math-academy-id "q-2382" :question/problem "$\\int z{e}^{{z}^{2}}\\,\\text{d}z=$" :question/worked-solution "Let's introduce the new variable $u={z}^{2}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2z\\,⟹\\,\\frac{1}{2}\\text{d}u=z\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int z{e}^{{z}^{2}}\\,\\text{d}z & =\\int {e}^{{z}^{2}}\\cdot z\\,\\text{d}z \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{{z}^{2}}}{2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288979 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "476736d0-b3f7-52e4-953a-75b569c5d22c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186288981} {:answer/id #uuid "ead74a85-851b-5a6f-bb0d-6e9fbf4f7f2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186288982} {:answer/id #uuid "8f157af3-8ec6-59cc-bec6-3b764fdb8cc7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288983} {:answer/id #uuid "64e61e4f-e923-54ab-a6ce-268bc2763182" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186288984} {:answer/id #uuid "c5226886-2dd4-56b6-a235-11e571cc3ad9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186288985}] :answer-field/correct {:answer/id #uuid "ead74a85-851b-5a6f-bb0d-6e9fbf4f7f2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186288982} :answer-field/id #uuid "bc520a7c-e478-5a89-af7d-7944023b1429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288980}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d4f67d94-46b0-5d5b-916e-d356908134fc" :question/math-academy-id "q-30953" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=2{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\operatorname{ln}⁡5$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}{e}^{2{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{20}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{20}{e}^{u}\\,{|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{20}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{20}(25-1) \\\\  & =\\frac{24}{20} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288986 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9fd1daf-65ac-5c3b-a00c-c7aa76db9069" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186288988} {:answer/id #uuid "745fd39e-9c8d-5c28-95e5-60f77c5c343f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186288989} {:answer/id #uuid "bceb1551-8b24-5a34-838f-53aa66d18deb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186288990} {:answer/id #uuid "fb2860e2-c4fc-5e87-b6ec-58424a12f930" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{4}" :db/id #edb/ref 17592186288991} {:answer/id #uuid "ff93049f-117f-5f48-9070-b85674fc7dcf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186288992}] :answer-field/correct {:answer/id #uuid "bceb1551-8b24-5a34-838f-53aa66d18deb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186288990} :answer-field/id #uuid "fda2342c-99c0-5552-bd3c-ad611b2fe663" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288987}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "15b50c80-e89e-578d-bbe2-f84d4dc56be6" :question/math-academy-id "q-30978" :question/problem "Evaluate the integral ${\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{4}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2\\operatorname{ln}⁡4}(4-1) \\\\  & =\\frac{3}{2\\operatorname{ln}⁡4} \\\\  & =\\frac{3}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184688 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9450755e-6a3f-58b8-85a5-f1d41eaa9e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183018} {:answer/id #uuid "eea871d3-f105-56a1-8603-765b4091ada7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183019} {:answer/id #uuid "f6a192b7-1536-5d74-a3d9-d1f6ecda0f13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{\\ln 8} + C" :db/id #edb/ref 17592186183020} {:answer/id #uuid "fadbf7f5-e45e-588d-b86a-e4f6a27dc852" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x}}{2\\ln 8} + C" :db/id #edb/ref 17592186183021} {:answer/id #uuid "45df17b7-9658-59ad-a46d-eac1d063622a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{3\\ln 8} + C" :db/id #edb/ref 17592186183022}] :answer-field/correct {:answer/id #uuid "9450755e-6a3f-58b8-85a5-f1d41eaa9e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8^{3x^{2}}}{6\\ln 8} + C" :db/id #edb/ref 17592186183018} :answer-field/id #uuid "69400551-555e-53c7-92d2-d54f0bec8c32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183017}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a383a3e5-774c-580f-ac7a-6d64870e5f9c" :question/math-academy-id "q-31420" :question/problem "Calculate the integral $\\int x{8}^{3{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{8}^{3{x}^{2}}\\,\\text{d}x & =\\int {8}^{3{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\int {8}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int {8}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\frac{{8}^{u}}{\\operatorname{ln}⁡8}+C \\\\  & =\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288993 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7709caf-8fea-5d86-801c-4e7563031207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{{x}^{2}/3}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186288995} {:answer/id #uuid "adfc7e8e-408e-5bc6-9197-8a914e0e32eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{{x}^{2}/3}}{2}+C" :db/id #edb/ref 17592186288996} {:answer/id #uuid "6a7de3b9-6309-5a34-9698-91d8b33e1430" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x/3}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186288997} {:answer/id #uuid "1f7805e1-1163-511e-9695-57dda9206c4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {5}^{{x}^{2}/3}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186288998} {:answer/id #uuid "d8683fc0-4e03-59a4-8dcd-4dfb995fd6c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {5}^{{x}^{2}/3}}{2\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186288999}] :answer-field/correct {:answer/id #uuid "d8683fc0-4e03-59a4-8dcd-4dfb995fd6c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {5}^{{x}^{2}/3}}{2\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186288999} :answer-field/id #uuid "60dd1551-65bb-5076-9684-bc49de5f545c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288994}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "abbb9311-d0ca-5340-8c92-d4e361b2560f" :question/math-academy-id "q-31426" :question/problem "Calculate the integral $\\int x{5}^{{x}^{2}/3}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=\\frac{{x}^{2}}{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{3}x\\,⟹\\,\\frac{3}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{5}^{{x}^{2}/3}\\,\\text{d}x & =\\int {5}^{{x}^{2}/3}\\cdot x\\,\\text{d}x \\\\  & =\\int {5}^{u}\\cdot \\frac{3}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\int {5}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{3\\cdot {5}^{{x}^{2}/3}}{2\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289000 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a09703d-db93-5b41-bc16-e2125fed2af7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{5}^{x}\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289002} {:answer/id #uuid "634f9c1e-195a-5291-a381-1a25df1c873e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289003} {:answer/id #uuid "61ca044c-52c9-528c-a814-b0ae9a974bd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289004} {:answer/id #uuid "ef8fe0f4-ee45-5fa9-bece-f4def7b5b39b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{5\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289005} {:answer/id #uuid "9d8ad716-9611-54ff-ae7d-94fa2eb98624" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289006}] :answer-field/correct {:answer/id #uuid "61ca044c-52c9-528c-a814-b0ae9a974bd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186289004} :answer-field/id #uuid "97859bd5-9f67-5fda-81af-db2410d31c30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289001}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3b273e42-4e7d-543c-9946-fc5691a84c11" :question/math-academy-id "q-31478" :question/problem "Calculate the integral $\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={5}^{x}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={5}^{x}\\operatorname{ln}⁡5\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u={5}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x & =\\int \\frac{1}{{5}^{x}+1}\\cdot {5}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|{5}^{x}+1|+C \\\\  & =\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$"}] [{:db/id #edb/ref 17592186289007 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65d98815-74b8-51c3-8984-4c38e1d8b597" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x})}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289009} {:answer/id #uuid "808a0072-89c0-5907-9870-dd48be361779" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{4\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289010} {:answer/id #uuid "daeaede7-21bd-5064-96a6-480999a96fb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289011} {:answer/id #uuid "329a0e08-4a9a-584f-bb7b-8f2f2a6638f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289012} {:answer/id #uuid "ca2fdf77-99b0-5693-969a-d0c90c07f2e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{4}^{x}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289013}] :answer-field/correct {:answer/id #uuid "daeaede7-21bd-5064-96a6-480999a96fb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289011} :answer-field/id #uuid "dceef912-caaa-55b6-8261-80e03aa0e31d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289008}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a31b517d-05e6-542b-b9c4-9623212a7745" :question/math-academy-id "q-31480" :question/problem "Calculate the integral $\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={4}^{x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={4}^{x}\\operatorname{ln}⁡4\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u={4}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x & =\\int \\frac{1}{{4}^{x}+2}\\cdot {4}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|{4}^{x}+2|+C \\\\  & =\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${4}^{x}+2>0$ for all $x.$"}] [{:db/id #edb/ref 17592186289014 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d409aae-2b2e-5948-b744-9aa88a73e463" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289016} {:answer/id #uuid "24bbe951-b80c-56bc-8455-531d79c7ea01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln(3)}" :db/id #edb/ref 17592186289017}] :answer-field/correct {:answer/id #uuid "24bbe951-b80c-56bc-8455-531d79c7ea01" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln(3)}" :db/id #edb/ref 17592186289017} :answer-field/id #uuid "bdf5b0c4-c037-50d0-a65e-348e1ec3231d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289015}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "abb8a09a-9fe8-576e-a177-b79651a7d468" :question/math-academy-id "q-346400" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{0}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{1}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(3-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289018 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c21e7f7c-fe79-51e3-b539-3efb1cfd4b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\ln(3)}" :db/id #edb/ref 17592186289020} {:answer/id #uuid "c99634b7-db4d-5e9f-a9b1-3c08c2de6a3a" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186289021}] :answer-field/correct {:answer/id #uuid "c21e7f7c-fe79-51e3-b539-3efb1cfd4b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\ln(3)}" :db/id #edb/ref 17592186289020} :answer-field/id #uuid "eeff1d0a-7280-5f66-b3d6-7208c2cbe509" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289019}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7f67eb53-1da7-5fde-b905-7043552c9612" :question/math-academy-id "q-350743" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=2x+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x & ={\\int }_{1}^{3}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{1}^{3} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{3}-{3}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(27-3) \\\\  & =\\frac{24}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289022 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "816ff4d4-ab6c-554b-aacc-b47d5d35bbcb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln(\\frac{16}{7})" :db/id #edb/ref 17592186289024}] :answer-field/correct {:answer/id #uuid "816ff4d4-ab6c-554b-aacc-b47d5d35bbcb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln(\\frac{16}{7})" :db/id #edb/ref 17592186289024} :answer-field/id #uuid "764ee92c-721d-5092-84ad-bc082fda6618" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289023}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5258fcac-3d52-5d66-b492-897317f2df61" :question/math-academy-id "q-350751" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{e}^{x}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{x}\\,⟹\\,\\text{d}u=3{e}^{x}\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $7$ | $16$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{4}{3{e}^{x}+1}\\cdot 3{e}^{x}\\,\\text{d}x \\\\  & ={\\int }_{7}^{16}\\frac{4}{u}\\cdot \\,\\text{d}u \\\\  & =4{\\int }_{7}^{16}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡|u|\\,{|}_{7}^{16} \\\\  & =4(\\operatorname{ln}⁡(16)-\\operatorname{ln}⁡(7)) \\\\  & =4\\operatorname{ln}⁡(\\frac{16}{7}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289025 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8080bb2b-bb23-5bb8-9a74-37d55fabde67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186289027} {:answer/id #uuid "ca040f52-f167-5be3-af93-6b9ffe5ec51f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186289028} {:answer/id #uuid "cf4e63bc-e081-5a29-96e2-8401b0e4d970" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{({e}^{x}+4)^{5}}+C" :db/id #edb/ref 17592186289029} {:answer/id #uuid "11b2fe16-30a6-557b-b007-a6914a20bce0" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt[3]{({e}^{x}+4)^{2}}+C" :db/id #edb/ref 17592186289030} {:answer/id #uuid "e2ec5beb-9ab3-5714-881c-d33388c7af2f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186289031}] :answer-field/correct {:answer/id #uuid "ca040f52-f167-5be3-af93-6b9ffe5ec51f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186289028} :answer-field/id #uuid "841f8929-4054-5bcd-a921-096fa04fc9a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289026}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ef8991f5-d3c9-501b-9b92-01dcff44efa7" :question/math-academy-id "q-49577" :question/problem "Calculate the integral $\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{x}+4.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,⟹\\,\\text{d}u={e}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x & =5\\int \\sqrt{{e}^{x}+4}\\cdot {e}^{x}\\,\\text{d}x \\\\  & =5\\int \\sqrt{u}\\,\\text{d}u \\\\  & =5\\int {u}^{1/2}\\,\\text{d}u \\\\  & =5\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{10}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289032 :knowledge-point/_questions [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90718391-0708-56a8-ad3e-c8e0d4ca58d4" :answer/type {:db/ident :answer.type/math} :answer/value "(2{x}^{2}-x){e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186289034} {:answer/id #uuid "0fbef993-6bb4-57ba-8310-faf8d469108c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186289035} {:answer/id #uuid "b8f1c3ee-cfed-5f37-b4b3-a1e157bdcb47" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186289036} {:answer/id #uuid "d708ece7-2ee5-5957-b1da-6d11544767c9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}-x}+2{x}^{2}+C" :db/id #edb/ref 17592186289037} {:answer/id #uuid "9086fe80-c0df-5a16-b3ea-7566deb23afc" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186289038}] :answer-field/correct {:answer/id #uuid "0fbef993-6bb4-57ba-8310-faf8d469108c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186289035} :answer-field/id #uuid "1b0e0a55-5a97-5da8-97a8-37b683a35681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289033}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "289b5582-fea4-5182-b880-938b3b4657a4" :question/math-academy-id "q-73662" :question/problem "$\\int (4x-1){e}^{2{x}^{2}-x}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=2{x}^{2}-x.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x-1\\,⟹\\,\\text{d}u=(4x-1)\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int (4x-1){e}^{2{x}^{2}-x}\\,\\text{d}x & =\\int {e}^{2{x}^{2}-x}\\cdot (4x-1)\\text{d}x \\\\  & =\\int {e}^{u}\\,\\text{d}u \\\\  & ={e}^{2{x}^{2}-x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289039 :knowledge-point/_questions [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f90e6493-960e-5674-927d-5b696ebee9b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289041} {:answer/id #uuid "213937da-e23a-5ef7-9027-b4aca53a0363" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289042} {:answer/id #uuid "400b7d84-8553-5dda-98be-6e4a905a0e63" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289043} {:answer/id #uuid "f58e7a8a-3692-53d7-8f28-980aadb003c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289044} {:answer/id #uuid "1a07e95c-15c6-5085-91b1-13e7c25a68f2" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289045}] :answer-field/correct {:answer/id #uuid "400b7d84-8553-5dda-98be-6e4a905a0e63" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186289043} :answer-field/id #uuid "a16d464a-53ec-5743-a761-943048c55e13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289040}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "537a8150-a70c-57ac-830f-77457ae5ba43" :question/math-academy-id "q-73664" :question/problem "$\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=5-2{x}^{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}\\,⟹\\,-\\text{d}u=6{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x & =\\int {e}^{5-2{x}^{3}}\\cdot 6{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\,(-\\text{d}u) \\\\  & =-\\int {e}^{u}\\,\\text{d}u \\\\  & =-{e}^{u}+C \\\\  & =-{e}^{5-2{x}^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289046 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d77ecfd9-5c25-595e-94c0-56f77d02b680" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{4{x}^{2}-3}}{4\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289048} {:answer/id #uuid "1339c3a4-944e-5fdf-8c75-71b4aef77003" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\cdot {4}^{4{x}^{2}-3}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289049} {:answer/id #uuid "1e26e252-6430-5c72-97b4-df27de4456a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{4{x}^{2}-3}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289050} {:answer/id #uuid "b349473f-02e8-5091-81d4-cae6cae9b5d7" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{4{x}^{2}-3}\\,\\operatorname{ln}⁡4+C" :db/id #edb/ref 17592186289051} {:answer/id #uuid "7773e0c5-68a0-52b6-bc26-f2e4c3a9c900" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{4{x}^{2}-3}+C" :db/id #edb/ref 17592186289052}] :answer-field/correct {:answer/id #uuid "1e26e252-6430-5c72-97b4-df27de4456a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{4{x}^{2}-3}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186289050} :answer-field/id #uuid "bea9ec5f-8e5a-565e-baa9-d6dec25e793f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289047}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "370c76f8-0f52-5929-828d-f3320d649575" :question/math-academy-id "q-73665" :question/problem "Calculate the integral $\\int 4x\\,{4}^{4{x}^{2}-3}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=4{x}^{2}-3.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8x\\,⟹\\,\\frac{1}{8}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 4x\\,{4}^{4{x}^{2}-3}\\,\\text{d}x & =4\\int {4}^{4{x}^{2}-3}\\cdot x\\,\\text{d}x \\\\  & =4\\int {4}^{u}\\cdot \\frac{1}{8}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{{4}^{u}}{2\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{4{x}^{2}-3}}{2\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289053 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d3b8987-7e6f-55ed-b31a-07204894a857" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\operatorname{ln}⁡2}\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186289055} {:answer/id #uuid "7b420b0d-680c-58a0-8421-8824cdc3476f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186289056} {:answer/id #uuid "1d71d7f6-9e0d-5b6c-90ec-299700c57bd4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186289057} {:answer/id #uuid "faedf89d-31c0-5406-9c67-73367c348d79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186289058} {:answer/id #uuid "d1a1f9ce-c5ef-5b63-bff9-0d34bd0c3c1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186289059}] :answer-field/correct {:answer/id #uuid "7b420b0d-680c-58a0-8421-8824cdc3476f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186289056} :answer-field/id #uuid "afbf4500-82bd-547d-8478-9d3a04b4b205" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289054}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6e85ab7a-4e7d-54fa-9beb-bc74fc283a55" :question/math-academy-id "q-73669" :question/problem "Calculate the integral $\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289060 :knowledge-point/_questions [{:knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c3a80b2-9023-55ea-9ac6-a2dba1c842e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289062} {:answer/id #uuid "7da44408-45f7-5e9c-8afd-1f739f4c310a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289063} {:answer/id #uuid "eff494a9-7cd4-5850-9a9e-f87ae048f01a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289064} {:answer/id #uuid "2d5e0ed8-d739-5f44-9c45-0a262a686b00" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289065} {:answer/id #uuid "49ef52f0-8a91-5596-ab40-d9c459834a0e" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289066}] :answer-field/correct {:answer/id #uuid "eff494a9-7cd4-5850-9a9e-f87ae048f01a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186289064} :answer-field/id #uuid "94ec25d6-2471-5b65-9372-5efbb132829a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289061}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c2d9e852-974b-54d0-b122-d8cc4d1c12d5" :question/math-academy-id "q-73798" :question/problem "$\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{3}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u=3{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{3{x}^{3}+1}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{3{x}^{3}+1}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289067 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b5f5d3-50aa-5ee2-9eeb-a5474791dc59" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{{x}^{2}+1}+C" :db/id #edb/ref 17592186289069} {:answer/id #uuid "1590bcc9-e940-5a11-9f8d-0eb2235e60ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}\\operatorname{ln}⁡6}{3}+C" :db/id #edb/ref 17592186289070} {:answer/id #uuid "fe4c1e69-1780-5ed2-895c-aba64bddee71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186289071} {:answer/id #uuid "31525c70-e13d-54dc-99ed-ff60dde67453" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{6}+C" :db/id #edb/ref 17592186289072} {:answer/id #uuid "dccd9b69-eca4-52d3-afd7-74f1b4c8e180" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{{x}^{2}+1}\\operatorname{ln}⁡3+C" :db/id #edb/ref 17592186289073}] :answer-field/correct {:answer/id #uuid "fe4c1e69-1780-5ed2-895c-aba64bddee71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186289071} :answer-field/id #uuid "b2aacf6b-a185-5108-b393-bc9cff1726f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289068}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26102d53-ee02-5cbb-a2ec-6cc44cead40a" :question/math-academy-id "q-73801" :question/problem "Calculate the integral $\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x & =\\int {6}^{{x}^{2}+1}\\cdot 2x\\,\\text{d}x \\\\  & =\\int {6}^{u}\\cdot \\,\\text{d}u \\\\  & =\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C.\\end{aligned}\n$$"}]}
