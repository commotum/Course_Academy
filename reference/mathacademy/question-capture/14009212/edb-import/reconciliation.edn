essful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-2382" "field" nil "attribute" "question/problem" "value" "$\\int z{e}^{{z}^{2}}\\,\\text{d}z=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-2382" "field" nil "attribute" "question/worked-solution" "value" "Let's introduce the new variable $u={z}^{2}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2z\\,⟹\\,\\frac{1}{2}\\text{d}u=z\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int z{e}^{{z}^{2}}\\,\\text{d}z & =\\int {e}^{{z}^{2}}\\cdot z\\,\\text{d}z \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{{z}^{2}}}{2}+C.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-2382" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/activity-metadata.json" "file_sha256" "c03415efc1a91baf90ef6ea0bb44e8676f8d098a08fbb4519f1076eb900f372d"} {"question" "q-2382" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-2382" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{{e}^{{z}^{2}}}{2}+C"] ["math" "2{e}^{{z}^{2}}+C"] ["math" "\\frac{{e}^{z}}{2}+C"] ["math" "\\frac{{e}^{{z}^{2}}}{2}+C"] ["math" "{e}^{{z}^{2}}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-2382" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{e}^{{z}^{2}}}{2}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-31426" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int x{5}^{{x}^{2}/3}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-31426" "field" nil "attribute" "question/worked-solution" "value" "Let's introduce the new variable $u=\\frac{{x}^{2}}{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{3}x\\,⟹\\,\\frac{3}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{5}^{{x}^{2}/3}\\,\\text{d}x & =\\int {5}^{{x}^{2}/3}\\cdot x\\,\\text{d}x \\\\  & =\\int {5}^{u}\\cdot \\frac{3}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\int {5}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{3\\cdot {5}^{{x}^{2}/3}}{2\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-31426" "field" nil "attri