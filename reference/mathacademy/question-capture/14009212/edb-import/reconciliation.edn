\\  & =-2{e}^{u}+C \\\\  & =-2{e}^{4-{x}^{4}}+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-113847" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/activity-metadata.json" "file_sha256" "c03415efc1a91baf90ef6ea0bb44e8676f8d098a08fbb4519f1076eb900f372d"} {"question" "q-113847" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-113847" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{e}^{4-{x}^{4}}+C"] ["math" "-\\frac{{e}^{4-{x}^{4}}}{2}+C"] ["math" "2{e}^{4-{x}^{4}}+C"] ["math" "\\frac{{e}^{4-{x}^{4}}}{2}+C"] ["math" "{e}^{4-{x}^{4}}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-113847" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2{e}^{4-{x}^{4}}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_sha256" "5a46d6dffd12e126b6cbbbfc5cbffd581d8051987cd494674ed63b44ae7ebbe5"} {"question" "q-73662" "field" nil "attribute" "question/problem" "value" "$\\int (4x-1){e}^{2{x}^{2}-x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009212/state.json" "file_