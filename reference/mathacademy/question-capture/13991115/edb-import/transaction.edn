stion-capture/13991115/assets/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/b4ded02707568b62cfa06f53ffe79b564986b4ddd4ceb7709e8aded7f1a2106b.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81827/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-81827"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160643/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "533fe1e0-736f-56d4-808f-c1d14b2743d8" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160643/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "c7eb0977-8a2d-5218-b250-3fa7d83eb3ba" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160643/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "1dceeb35-0cb2-5a43-8e49-86d4583f28b7" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-160643/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3d16dded-e01f-512b-b59e-d410e6956f17" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-160643/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "d5c0cc42-8a0b-5c9c-ac44-596917ab7319" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-160643/selection" :answer-field/id #uuid "bd86fb08-e9a6-50ff-89b2-48d975d8101e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160643/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-160643/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-160643/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-160643/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-160643/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-160643/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-160643" :question/id #uuid "37ce60a1-7ee2-5ebe-8858-c59ff464ba06" :question/math-academy-id "q-160643" :question/problem "A triangle $S$ has vertices at $(0,1),(-1,0),(-1,-2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,0)$\n- $(0,-1)$\n- $(-2,1)$" :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,0),(0,1),(-2,1).$\n\nSo, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160643/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-160643"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8415/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "5cf129fd-01ba-5ecb-9507-be8bc80c2833" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-8415/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "0319001a-a4ca-5f66-9f00-efcc422e77cb" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-8415/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d4844348-5fc7-56df-8ecd-cf02b2043e5c" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-8415/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ec65ac30-f825-5e63-85fb-9eb2cd5f178e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-8415/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "bb4bc0bc-b390-5fb8-b56b-077fc0085f1c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-8415/selection" :answer-field/id #uuid "4844665a-04bb-55ba-bc7a-96113a3dbead" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8415/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-8415/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-8415/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-8415/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-8415/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-8415/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-8415" :question/id #uuid "bde2685a-ae0c-5b7b-99fb-315ac6218ef3" :question/math-academy-id "q-8415" :question/problem "A triangle $S$ has vertices at $(0,0),(2,0),(2,2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(0,0)$\n- $(2,-2)$\n- $(-2,0)$" :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & 2 & 2 \\\\ 0 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 & 2 & 2 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 2 \\\\ 0 & -2 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(0,0),(0,-2),(2,-2).$\n\nSo, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-8415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12133/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "5c64b183-f6b