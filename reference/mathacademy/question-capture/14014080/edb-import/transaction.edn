d353935e32e9b23d96e9bf93de825928559f7" "q-32033/selection/12907db512a71f82a03a2dea181a35bb97b0053b7e440bd08dab432b572ea0a4" "q-32033/selection/22a2442321535ed246e92c7dae57c7072c2231873591b9c39790fe717086d577" "q-32033/selection/fbc9ce1bb2319ff142a47e71bed155aa942f974785a75f3b4cbe5a58f286848d" "q-32033/selection/a92f5fa191a916d602816644dfe463b54a27796cd32b66bbb6131b19f5275fe5"] :db/ensure [:answer-field/validate]} {:db/id "q-32033" :question/id #uuid "4330c109-1f4a-587b-b6ac-d3c48b67916a" :question/math-academy-id "q-32033" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}x-3y=0 \\\\ -3x+6y=2\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}1 & -3 \\\\ -3 & 6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & -3 \\\\ -3 & 6\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 6-(-3)\\cdot (-3)}[\\begin{aligned}6 & 3 \\\\ 3 & 1\\end{aligned}] \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32033/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32033"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102799/selection/066808efb35d2b069a42656e740d810fc07e7711bc3c34b2b7f0bb8b4b5eca38" :answer/id #uuid "cd5464c3-57fd-5a2c-9a84-afac2b14f2eb" :answer/type :answer.type/math :answer/value "x=\\frac{1}{6}[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102799/selection/54a02e38314743ffe117a32e4de8b18437b3729d54bb4783ae82e81ffb26edcc" :answer/id #uuid "63dc607c-cf41-51a5-a94e-62efbc2b157c" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102799/selection/e005ecbebfbab338df1c0c045cf3fb857f0681bc2d50755cae036d8c472493f0" :answer/id #uuid "5b0bd01f-3396-5cfa-9752-a13677eaaff8" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102799/selection/3c3015a76510353a8d6f93952aa24887e1cb2c9354604e15510eea4d4307c6f5" :answer/id #uuid "42bcef1a-8023-5194-b0a5-69fadb2e4808" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102799/selection/18c7e87a996178046a42027a0a4d4d49850947b884867e3a79521bbf50bbd749" :answer/id #uuid "57237e18-6867-5e6f-8422-9eef93243cd9" :answer/type :answer.type/math :answer/value "x=2[\\begin{aligned}1 & -3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102799/selection" :answer-field/id #uuid "9f049f9b-3f8f-53af-801a-1c9505f14d7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102799/selection/54a02e38314743ffe117a32e4de8b18437b3729d54bb4783ae82e81ffb26edcc" :answer-field/choices ["q-102799/selection/066808efb35d2b069a42656e740d810fc07e7711bc3c34b2b7f0bb8b4b5eca38" "q-102799/selection/54a02e38314743ffe117a32e4de8b18437b3729d54bb4783ae82e81ffb26edcc" "q-102799/selection/e005ecbebfbab338df1c0c045cf3fb857f0681bc2d50755cae036d8c472493f0" "q-102799/selection/3c3015a76510353a8d6f93952aa24887e1cb2c9354604e15510eea4d4307c6f5" "q-102799/selection/18c7e87a996178046a42027a0a4d4d49850947b884867e3a79521bbf50bbd749"] :db/ensure [:answer-field/validate]} {:db/id "q-102799" :question/id #uuid "0f36e193-cfb7-556d-862d-7ca0f147ebca" :question/math-academy-id "q-102799" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}3y=-x \\\\ 2y=1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}x+3y=0 \\\\ 2y=1.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102799/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-102799"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102806/selection/9a4c415e5de3a7f7fac4b17f73571ac33562865161942ecf8d7496cd4d1ca03b" :answer/id #uuid "590404f5-f3f8-532b-aeb2-8ac76e440df8" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & 3 \\\\ -4 & -1\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102806/selection/f6f71fdf4585554bce9cc79d3f6530f7cf7d43f8563fa2c021b62f9032b24d5b" :answer/id #uuid "796acc5c-1913-5743-9dd1-c48bcd03d333" :answer/type :answer.type/math :answer/value "x=\\frac{1}{10}[\\begin{aligned}-1 & 3 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102806/selection/905112512a15c9960f20d6e4c1c37098f7e908ca5b1db86ba33412859502f21d" :answer/id #uuid "c6c36bc2-4930-5d0c-9a5f-14d8dcb8f959" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -3 \\\\ 4 & -1\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102806/selection/8b605ca597ddb828dc6b84aa080b06ecbdea23a6c4e41e8346eea2a4f62266e3" :answer/id #uuid "05c963c1-98e9-5a2d-a5c7-0f6d04dbda30" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{10}[\\begin{aligned}-1 & -3 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102806/selection/fa93f938946e5d3f00c5e086cd8fe0c79e0c2717e16ae094f68ff61da627139a" :answer/id #uuid "850318a6-1a4d-5307-b80c-b8e0f486b5e2" :answer/type :answer.type/math :answer/value "x=\\frac{1}{10}[\\begin{aligned}-1 & -3 \\\\ -4 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102806/selection" :answer-field/id #uuid "ca356f0b-e266-5dae-b876-0c22bbf0bfe8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102806/selection/f6f71fdf4585554bce9cc79d3f6530f7cf7d43f8563fa2c021b62f9032b24d5b" :answer-field/choices ["q-102806/selection/9a4c415e5de3a7f7fac4b17f73571ac33562865161942ecf8d7496cd4d1ca03b" "q-102806/selection/f6f71fdf4585554bce9cc79d3f6530f7cf7d43f8563fa2c021b62f9032b24d5b" "q-102806/selection/905112512a15c9960f20d6e4c1c37098f7e908ca5b1db86ba33412859502f21d" "q-102806/selection/8b605ca597ddb828dc6b84aa080b06ecbdea23a6c4e41e8346eea2a4f62266e3" "q-102806/selection/fa93f938946e5d3f00c5e086cd8fe0c79e0c2717e16ae094f68ff61da627139a"] :db/ensure [:answer-field/validate]} {:db/id "q-102806" :question/id #uuid "95af1977-8d23-5d4e-89a9-245a921e273b" :question/math-academy-id "q-102806" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}5=2x-3y \\\\ 4x=y-2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-3y=5 \\\\ 4x-y=-2.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -3 \\\\ 4 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -3 \\\\ 4 & -1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-1)-4\\cdot (-3)}[\\begin{aligned}-1 & 3 \\\\ -4 & 2\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}-1 & 3 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{10}[\\begin{aligned}-1 & 3 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}5 \\\\ -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-102806/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-102806"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320797/field-1/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer/id #uuid "a7c1bb03-9d37-5f48-99ff-12e2a2d7854d" :answer/type :answer.type/math :answer/value "\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "q-320797/field-1/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "a27f9476-02bb-5947-a1d3-d4be7c516d0e" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-320797/field-1" :answer-field/id #uuid "388ef544-5eeb-55c5-9a22-928e4567de62" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320797/field-1/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer-field/choices ["q-320797/field-1/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" "q-320797/field-1/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c"] :db/ensure [:answer-field/validate]} {:db/id "q-320797/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "1601cf07-a954-57ab-98a1-051fb4994be5" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-320797/field-2" :answer-field/id #uuid "f74f45d8-5bc3-53bc-ae02-38dce86cd828" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320797/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-320797/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-320797/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "270d2cb9-79c0-58ec-983d-1cf82a3c65b4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-320797/field-3" :answer-field/id #uuid "48a3ed5d-e8b3-5b70-9759-e7d84e60a072" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320797/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-320797/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-320797" :question/id #uuid "0e9ef9f0-59b2-578f-bbc7-31473b0fed57" :question/math-academy-id "q-320797" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}4x-6y=9 \\\\ 3y=-3\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $3$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $4$ |  | |  |  |  | |  | $9$ |  |\n| --- | --- | --- |\n|  | $-3$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $3$ | {{field-2}} |  |  |  |\n|  | {{field-3}} | $4$ |  |  |  |\n|  | $9$ |  |  |  |  |\n|  | $-3$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}4 & -6 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 \\\\ -3\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n\n$$\nA=[\\begin{aligned}4 & -6 \\\\ 0 & 3\\end{aligned}].\n$$\n\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 3-0\\cdot (-6)}[\\begin{aligned}3 & 6 \\\\ 0 & 4\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 6 \\\\ 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{12}[\\begin{aligned}3 & 6 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}9 \\\\ -3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320797/field-1" "q-320797/field-2" "q-320797/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-320797"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320803/field-1/acc1ee172ece246ca6aaed261576c2595cedee31387711f14fcefbe5a8e0fb90" :answer/id #uuid "e9e4281b-45b9-5850-b450-663e551b37c9" :answer/type :answer.type