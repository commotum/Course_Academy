13e4ca05d1ed1248353d64b9b1700d226dcc"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-76311"] :question/answer-fields ["q-76311/selection/ma-v1/6446dc780e1557c8bd77bfd714ba886e3200fdcb499ffcf6df82db72c2981e4d"] :db/ensure [:question/validate]} {:db/id "q-142950/selection/3ee1735f7585ee45090f0928f2bd5cb21d845344013a25e5ed1f64b6db4a4ef8" :answer/id #uuid "db04c68b-84c4-511c-b823-9ce336d4fe30" :answer/type :answer.type/text :answer/value "| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ |" :db/ensure [:answer/validate]} {:db/id "q-142950/selection/327885b126e4a3f4dd81465198a33642faac8367afe57e6439e51ef0f0366143" :answer/id #uuid "146f68a5-1a68-5b5d-8ab0-255c85500ce3" :answer/type :answer.type/text :answer/value "| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{2}{5}$ | $\\frac{3}{5}$ |" :db/ensure [:answer/validate]} {:db/id "q-142950/selection/eea9654103be59f56fda6352120943af80701a2b7a0f8da2bc7cb9c248cc1b41" :answer/id #uuid "4b9eddca-daa4-5c9e-bb95-4c3f11a05f59" :answer/type :answer.type/text :answer/value "| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{1}{6}$ | $\\frac{5}{6}$ |" :db/ensure [:answer/validate]} {:db/id "q-142950/selection/62e2f4d8d44ba13feca4bc7611ae2a8937fc36dc4fe9c69546004b5456b1e5db" :answer/id #uuid "e9419260-4654-5f71-93a5-e67574458ee0" :answer/type :answer.type/text :answer/value "| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ |" :db/ensure [:answer/validate]} {:db/id "q-142950/selection/0f4dcc34847f3be1b12fe38f9103f0ee9df79f59cb5183540054a3d48123fcaa" :answer/id #uuid "8aaf1d1d-d612-5e7f-b448-1ea7a1662e0a" :answer/type :answer.type/text :answer/value "| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{1}{4}$ | $\\frac{3}{4}$ |" :db/ensure [:answer/validate]} {:db/id "q-142950/selection" :answer-field/id #uuid "ac904a16-7fa1-5eaf-8cdc-55f1811a3a9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-142950/selection/62e2f4d8d44ba13feca4bc7611ae2a8937fc36dc4fe9c69546004b5456b1e5db" :answer-field/choices ["q-142950/selection/3ee1735f7585ee45090f0928f2bd5cb21d845344013a25e5ed1f64b6db4a4ef8" "q-142950/selection/327885b126e4a3f4dd81465198a33642faac8367afe57e6439e51ef0f0366143" "q-142950/selection/eea9654103be59f56fda6352120943af80701a2b7a0f8da2bc7cb9c248cc1b41" "q-142950/selection/62e2f4d8d44ba13feca4bc7611ae2a8937fc36dc4fe9c69546004b5456b1e5db" "q-142950/selection/0f4dcc34847f3be1b12fe38f9103f0ee9df79f59cb5183540054a3d48123fcaa"] :db/ensure [:answer-field/validate]} {:db/id "q-142950" :question/id #uuid "3f49365e-ca6f-5ad4-88ef-c7c6b1f87da0" :question/math-academy-id "q-142950" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ |\n| $X=2$ | $0.2$ | $0.4$ |\n\nFind the conditional probability mass function ${f}_{Y|X}(y\\,|\\,2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "The conditional probability mass function ${f}_{X|Y}(x\\,|\\,y)$ is defined as\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=P(Y=y\\,|\\,X=x).\n$$\n\nTherefore, we're required to compute the following set of conditional probabilities:\n\n$$\n{f}_{Y|X}(y\\,|\\,2)=P(Y=y\\,|\\,X=2)\n$$\n\nBy the multiplication law for conditional probability, we have\n\n$$\nP(Y=y\\,|\\,X=2)=\\frac{P(X=2,Y=y)}{P(X=2)}=\\frac{f(2,y)}{{f}_{X}(2)}\n$$\n\nwhere $f(x,y)$ is the joint probability mass function of $X$ and $Y,$ and ${f}_{X}(x)$ is the marginal distribution of $X.$\n\nRecall that the marginal distributions for $X$ and $Y$ correspond to the row and column totals, respectively. So, let's compute these:\n\n| $f$ | $Y=2$ | $Y=4$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $0.4$ |\n| $X=2$ | $0.2$ | $0.4$ | $0.6$ |\n| ${f}_{Y}(y)$ | $0.3$ | $0.7$ | $1$ |\n\nTherefore, for $y\\in {2,4},$ we obtain:\n\n$$\n\\begin{aligned}P(X=2\\,|\\,Y=2) & =\\frac{f(2,2)}{{f}_{X}(2)}=\\frac{0.2}{0.6}=\\frac{1}{3} \\\\ P(X=2\\,|\\,Y=4) & =\\frac{f(2,4)}{{f}_{X}(2)}=\\frac{0.4}{0.6}=\\frac{2}{3}\\end{aligned}\n$$\n\nFinally, the conditional probability mass function can be represented by the following table:   \n\n| $y$ | $2$ | $4$ |\n| --- | --- | --- |\n| ${f}_{Y|X}(y\\,|\\,2)$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ |" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-142950/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebabf742-2b8d-5392-a077-f34e8f4bd034"] :knowledge-point/questions ["q-142950"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-118552"] :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =1.2y-0.002{y}^{2} \\\\  & =0.002y(600-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=600.$ Hence, the carrying capacity is $600,$ and we conclude that the number of seals cannot exceed $600.$" :db/ensure [:question/validate]} {:db/id "q-109300/selection/8bffdc1b32c9f4f925939fda09279b6ea2bd000320874d5d11bf6a816745c581" :answer/id #uuid "410e5548-9b24-5ea7-a9c1-6de1e750e89f" :answer/type :answer.type/math :answer/value "t=2,\\,v=-2e" :db/ensure [:answer/validate]} {:db/id "q-109300/selection/50214f09c29f8e2a1bdbb2daf34ffdb2b95516092171f1bbf92af2a7b8e4e42c" :answer/id #uuid "d92da157-68d7-55bf-8328-5b10a9b0aa0a" :answer/type :answer.type/math :answer/value "t=2,\\,v=e" :db/ensure [:answer/validate]} {:db/id "q-109300/selection/59d551a571d36696751102edc7f3b0b69d24b3c6b1eeb4b51da53cc6c1d4773b" :answer/id #uuid "7dfb1148-6305-5521-8083-d138dd951d57" :answer/type :answer.type/math :answer/value "t=1,\\,v=-e" :db/ensure [:answer/validate]} {:db/id "q-109300/selection/6965dc3f52cc36d73ad11689ba6673a755f6ee23cae58b95ef74bbb871aa72ae" :answer/id #uuid "2dd47334-da5d-5f67-978c-a393c3e8558f" :answer/type :answer.type/math :answer/value "t=1,\\,v=-3e" :db/ensure [:answer/validate]} {:db/id "q-109300/selection/46348d94fd3611793ad7fdce20df3faebd23d122d57233a0ab3fd3ab2fd90697" :answer/id #uuid "5b3feadf-fa55-58de-932c-d43cbea4211a" :answer/type :answer.type/math :answer/value "t=1,\\,v=2e" :db/ensure [:answer/validate]} {:db/id "q-109300/selection" :answer-field/id #uuid "28812e42-d53e-58ae-8579-3bcb1c2b8067" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-109300/selection/59d551a571d36696751102edc7f3b0b69d24b3c6b1eeb4b51da53cc6c1d4773b" :answer-field/choices ["q-109300/selection/8bffdc1b32c9f4f925939fda09279b6ea2bd000320874d5d11bf6a816745c581" "q-109300/selection/50214f09c29f8e2a1bdbb2daf34ffdb2b95516092171f1bbf92af2a7b8e4e42c" "q-109300/selection/59d551a571d36696751102edc7f3b0b69d24b3c6b1eeb4b51da53cc6c1d4773b" "q-109300/selection/6965dc3f52cc36d73ad11689ba6673a755f6ee23cae58b95ef74bbb871aa72ae" "q-109300/selection/46348d94fd3611793ad7fdce20df3faebd23d122d57233a0ab3fd3ab2fd90697"] :db/ensure [:answer-field/validate]} {:db/id "q-109300" :question/id #uuid "75be4e88-95fc-5848-8db3-3c1dc9ffc66c" :question/math-academy-id "q-109300" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=(t-3){e}^{t},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((t-3){e}^{t}) \\\\  & ={e}^{t}+(t-3){e}^{t} \\\\  & =(t-2){e}^{t}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((t-2){e}^{t}) \\\\  & ={e}^{t}+(t-2){e}^{t} \\\\  & =(t-1){e}^{t}\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}(t-1){e}^{t} & =0 \\\\ t-1 & =0 \\\\ t & =1\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=1.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\nv(1)=(1-2){e}^{1}=-e.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-109300/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd"] :knowledge-point/questions ["q-109300"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-163548"] :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/d4e5b78932f8ff6155ac81e12538eb31ac211c9d27d6a2b0c67542527ccd3b2a.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(4-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4-x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}4-x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=4-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (4-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=4x-\\frac{1}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =4(0)-\\frac{1}{2}(0)^{2}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+18 \\\\ {v}^{2} & =8x-{x}^{2}+36 \\\\ v & =\\pm \\sqrt{-{x}^{2}+8x+36}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+8x+36}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-(4)^{2}+8(4)+36}=2\\sqrt{13}\\,m/s\n$$" :db/ensure [:question/validate]} [:db/retract 17592186259101 :question/answer-fields 17592186274598] {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/0625ffd24f97db55ab63b06623443fd9aa48ff10cd303280756af80e1e05c731" :answer/id #uuid "405e4901-4b8e-5349-a8a4-45d4ee93beaf" :answer/type :answer.type/math :answer/value "\\frac{1}{2-{log}_{9}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/1cf5691a7a00f0451c586f1b6fece791aa2aedfb489d27b9fe481333f249be5d" :answer/id #uuid "48e1be2d-ae61-5b97-9725-cce466d23595" :answer/type :answer.type/math :answer/value "-\\frac{1}{2+{log}_{9}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/061db14f1fa5264c3722b04847a0cf02cab684e485996c47c78ebd6f872f1778" :answer/id #uuid "b269c941-9f42-555c-b91a-eb6bff43fcdd" :answer/type :answer.type/math :answer/value "2+{log}_{9}⁡(5)" :db/ensure [:answer/validate]} {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/edc411839c63e905a98e8788c3f792a316b028e7d5416e1b75df35bf3e25cfcf" :answer/id #uuid "4b1d56cc-80f9-570c-80b7-6fbbb94cf74a" :answer/type :answer.type/math :answer/value "\\frac{1}{{log}_{9}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/6e0257df034584fdf1ae5638fea09d9577c57badf261166b3dfb6063cbffee99" :answer/id #uuid "8a348509-813b-522d-8ba8-1239e7e5ad75" :answer/type :answer.type/math :answer/value "{log}_{9}⁡(5)" :db/ensure [:answer/validate]} {:db/id "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150" :answer-field/id #uuid "74184496-69c4-5dcc-aa0f-5b7592e9c806" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/1cf5691a7a00f0451c586f1b6fece791aa2aedfb489d27b9fe481333f249be5d" :answer-field/choices ["q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/0625ffd24f97db55ab63b06623443fd9aa48ff10cd303280756af80e1e05c731" "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/1cf5691a7a00f0451c586f1b6fece791aa2aedfb489d27b9fe481333f249be5d" "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/061db14f1fa5264c3722b04847a0cf02cab684e485996c47c78ebd6f872f1778" "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/edc411839c63e905a98e8788c3f792a316b028e7d5416e1b75df35bf3e25cfcf" "q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150/6e0257df034584fdf1ae5638fea09d9577c57badf261166b3dfb6063cbffee99"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-26387"] :question/worked-solution "First, we take ${log}_{9}$ of both sides of the equation:\n\n$$\n\\begin{aligned}{9}^{2y+1} & ={5}^{-y} \\\\ {log}_{9}⁡({9}^{2y+1}) & ={log}_{9}⁡({5}^{-y})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\n2y+1={log}_{9}⁡({5}^{-y})\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n2y+1=-y{log}_{9}⁡(5)\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}2y+1 & =-y{log}_{9}⁡(5) \\\\ 2y+y{log}_{9}⁡(5) & =-1 \\\\ y(2+{log}_{9}⁡(5)) & =-1 \\\\ y & =-\\frac{1}{2+{log}_{9}⁡(5)}\\end{aligned}\n$$" :question/answer-fields ["q-26387/selection/ma-v1/1ffa5a61252889d630bb82d025f71e56d099acd9a5584356944754535877f150"] :db/ensure [:question/validate]} {:db/id "q-157213/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "c63e12a6-4703-5ada-abbf-19a4f989ffdb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-157213/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "950b71dd-052f-5679-a749-dacb9f4bc1d8" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-157213/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "00be453c-bf66-5eeb-9f10-53819fc0610e" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-157213/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "da21aa11-9e29-5dd5-84f5-4ef9c80a32fc" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-157213/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "b7f27ed4-38f6-55b2-9826-3011918fc845" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-157213/selection" :answer-field/id #uuid "84a3cd7d-5568-506a-9757-768e163906f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-157213/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-157213/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-157213/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-157213/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-157213/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-157213/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-157213" :question/id #uuid "de4a72dc-5997-53bc-8d7e-03a96c24c883" :question/math-academy-id "q-157213" :question/problem "Consider the section of the  parabola $3{y}^{2}-4y-16x=0$ that lies in the first quadrant. Given that $x=x(t),$ $y=y(t),$  and that $\\frac{\\text{d}y}{\\text{d}t}=8$ on the parabola at the point where $x=2,$ find the value of $\\frac{\\text{d}x}{\\text{d}t}$ at that point." :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}3{y}^{2}-4y-16x & =0 \\\\ \\frac{\\text{d}}{\\text{d}t}(3{y}^{2}-4y-16x) & =\\frac{\\text{d}}{\\text{d}t}(0) \\\\ \\frac{\\text{d}}{\\text{d}t}(3{y}^{2}-4y)-\\frac{\\text{d}}{\\text{d}t}(16x) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(3{y}^{2}-4y)-\\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}(16x) & =0 \\\\ \\frac{\\text{d}y}{\\text{d}t}\\cdot (6y-4)-\\frac{\\text{d}x}{\\text{d}t}\\cdot 16 & =0.\\end{aligned}\n$$\n\n \n\nNow, we substitute the given information $\\frac{\\text{d}y}{\\text{d}t}=8$ and $x=2.$ We get \n\n$$\n\\begin{aligned}8\\cdot (6y-4)-\\frac{\\text{d}x}{\\text{d}t}\\cdot 16 & =0.\\end{aligned}\n$$\n\n \n\nWe also want to substitute for $y,$ but we are not given this value. However, we can find it by substituting $x=2$ into the equation of the  parabola. \n\nAt the point where $x=2,$ we have\n\n$$\n\\begin{aligned}3{y}^{2}-4y-16x & =0 \\\\ 3{y}^{2}-4y-16\\cdot (2) & =0 \\\\ 3{y}^{2}-4y-32 & =0 \\\\ (y-4)(3y+8) & =0 \\\\ y & =4.\\end{aligned}\n$$\n\nNote that we used $y>0$ since we're only interested in the first quadrant. \n\nFinally, substituting $y=4,$ we get\n\n$$\n\\begin{aligned}8\\cdot (6\\cdot (4)-4)-\\frac{\\text{d}x}{\\text{d}t}\\cdot 16 & =0. \\\\ 160-\\frac{\\text{d}x}{\\text{d}t}\\cdot 16 & =0. \\\\ \\frac{\\text{d}x}{\\text{d}t} & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-157213/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05dd2261-9fbc-5f6c-8c75-357e656b6e6d"] :knowledge-point/questions ["q-157213"] :db/ensure [:knowledge-point/validate]} {:db/id "q-313939/field-1/00c1effbf2a2b6bd93fd834dcac0e6afdfb7d213b4e143382a3f4d38d799e1dc" :answer/id #uuid "4ae8d126-af0a-5587-9d29-96afbbe02046" :answer/type :answer.type/math :answer/value "\\frac{16}{7}" :db/ensure [:answer/validate]} {:db/id "q-313939/field-1" :answer-field/id #uuid "e80e4388-8aab-5db8-a7ca-1f7ad0a6f7ec" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-313939/field-1/00c1effbf2a2b6bd93fd834dcac0e6afdfb7d213b4e143382a3f4d38d799e1dc" :answer-field/choices ["q-313939/field-1/00c1effbf2a2b6bd93fd834dcac0e6afdfb7d213b4e143382a3f4d38d799e1dc"] :db/ensure [:answer-field/validate]} {:db/id "q-313939" :question/id #uuid "d94f32f2-a057-5622-b1f5-23f8c4b4d4a0" :question/math-academy-id "q-313939" :question/problem "Consider the section of the parabola ${x}^{2}-4y=5$ that lies in the first quadrant.  Given that $x=x(t),$ $y=y(t),$  and that $\\frac{\\text{d}y}{\\text{d}t}=8$ on the parabola at the point where $y=11,$ find the value of $\\frac{\\text{d}x}{\\text{d}t}$ at that point. Do not round the answer.\n\n$\\frac{\\text{d}x}{\\text{d}t}=$\n{{field-1}}" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{x}^{2}-4y & =5 \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2}-4y) & =\\frac{\\text{d}}{\\text{d}t}(5) \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2})-\\frac{\\text{d}}{\\text{d}t}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-\\frac{\\text{d}y}{\\text{d}t}\\cdot 4 & =0.\\end{aligned}\n$$\n\n \n\nNow, substituting the given information $\\frac{\\text{d}y}{\\text{d}t}=8$ and $y=11,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-8\\cdot 4 & =0 \\\\ 2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $x,$ but we are not given this value. However, we can find it by substituting $y=11$ into the equation of the parabola.  \n\nAt the point where $y=11,$ we have \n\n$$\n\\begin{aligned}{x}^{2}-4y & =5 \\\\ {x}^{2}-4(11) & =5 \\\\ {x}^{2}-44 & =5 \\\\ {x}^{2} & =49 \\\\ x & =7.\\end{aligned}\n$$\n\nNote that we used $x>0$ since we're only interested in the first quadrant. \n\nFinally, substituting $x=7,$ we get \n\n$$\n\\begin{aligned}2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0 \\\\ 2(7)\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0 \\\\ 14\\cdot \\frac{\\text{d}x}{\\text{d}t} & =32 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{32}{14} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{16}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-313939/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05dd2261-9fbc-5f6c-8c75-357e656b6e6d"] :knowledge-point/questions ["q-313939"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161651/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c3346293-ff33-58e7-af95-c78afe331557" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-161651/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "364998de-1b33-59e8-8e87-1eacea9408c5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-161651/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "0da0c582-7df0-51a7-9b1f-8c160d6a5c35" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-161651/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "71e5273a-22fe-5437-b052-53f3ca444e98" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-161651/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "feedb588-a2b7-5701-8b34-90c63ed3a7ec" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-161651/selection" :answer-field/id #uuid "fec4bcbc-4d0f-5f8c-ba81-7332f3f03847" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161651/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-161651/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-161651/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-161651/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-161651/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-161651/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-161651" :question/id #uuid "b95418a1-1dbc-53a9-8483-916fb7717c78" :question/math-academy-id "q-161651" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,1<{x}^{2}+{y}^{2}\\le 4}.\n$$\n\nWhich of the following statements are true? \n\n- $A=∂A\\cup \\text{int}A$\n- $A-∂A=\\text{int}\\,A$\n- $∂A⊂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A={C}_{1}\\cup {C}_{2}$ are shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/a39ecae41a88e873fa9eecb30a5b554be9ec98cf630851715ab35f2f873710f2.png)\n\n   \n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/5e473584ef5193b434ff6c138b08c4fbd9111a37252019143b1afb2d48c913c6.png)\n\nWith that in mind, let's examine each statement:\n\n- Statements I and III are false. Since ${C}_{1}⊂∂A-A,$ we must have that $∂A⊄A$ and also that $A\\ne ∂A\\cup \\text{int}A.$\n\n- Statement II is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-∂A=\\text{int}\\,A.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161651/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97"] :knowledge-point/questions ["q-161651"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127861/selection/92325e6c1e4feda33d9a36221bd5d578bd7454c813b75dec7802c51ffe210a6f" :answer/id #uuid "79eafa07-6627-5731-bf94-e74f8de80c9f" :answer/type :answer.type/math :answer/value "⟨-5,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127861/selection/d0a382d2d4a5c44cb6220c97e3a492b6139d8d060dfda0568fcd9609d62eaa8e" :answer/id #uuid "797e2652-2d0f-5b2e-b108-76f9b554f035" :answer/type :answer.type/math :answer/value "⟨0,5,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127861/selection/47bc325097f6446aa7595619897fde8f10f349b3fcb6849ad8de72aa3e7d4a2e" :answer/id #uuid "a7bf9514-a01c-538f-9a5c-051b28008bb3" :answer/type :answer.type/math :answer/value "⟨0,5,10⟩" :db/ensure [:answer/validate]} {:db/id "q-127861/selection/4eb308037eb2f26bc93b25026d2913aa915bde04620e9e6518c44f1624beff7c" :answer/id #uuid "b0408e09-ad71-5824-9d18-3e797029eb71" :answer/type :answer.type/math :answer/value "⟨-5,0,10⟩" :db/ensure [:answer/validate]} {:db/id "q-127861/selection/16002aacfb098672f64f7e3c4d56d0f694abd96953758208e883ce6c256d4d6c" :answer/id #uuid "56e53634-9539-5a98-9e07-16fefaf84621" :answer/type :answer.type/math :answer/value "⟨0,-5,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127861/selection" :answer-field/id #uuid "370c8336-471e-5ee0-978e-6983bfe78b67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127861/selection/16002aacfb098672f64f7e3c4d56d0f694abd96953758208e883ce6c256d4d6c" :answer-field/choices ["q-127861/selection/92325e6c1e4feda33d9a36221bd5d578bd7454c813b75dec7802c51ffe210a6f" "q-127861/selection/d0a382d2d4a5c44cb6220c97e3a492b6139d8d060dfda0568fcd9609d62eaa8e" "q-127861/selection/47bc325097f6446aa7595619897fde8f10f349b3fcb6849ad8de72aa3e7d4a2e" "q-127861/selection/4eb308037eb2f26bc93b25026d2913aa915bde04620e9e6518c44f1624beff7c" "q-127861/selection/16002aacfb098672f64f7e3c4d56d0f694abd96953758208e883ce6c256d4d6c"] :db/ensure [:answer-field/validate]} {:db/id "q-127861" :question/id #uuid "bc7c2dc3-154a-52f1-9fa7-977adfe13b41" :question/math-academy-id "q-127861" :question/problem "Find $(3b-c)\\times (9a-2b)$, if $a\\times b=⟨0,0,1⟩$, $a\\times c=⟨0,-1,3⟩$ and $c\\times b=⟨0,2,0⟩.$" :question/worked-solution "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) & = \\\\ ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) & = \\\\ ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b)) & = \\\\ (3\\cdot 9)(b\\times a)-(3\\cdot 2)(b\\times b)-9(c\\times a)+2(c\\times b) & = \\\\ 27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $b\\times b=0:$\n\n$$\n\\begin{aligned}27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b) & = \\\\ -27(a\\times b)-6(0)+9(a\\times c)+2(c\\times b) & = \\\\ -27(a\\times b)+9(a\\times c)+2(c\\times b)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}-27(a\\times b)+9(a\\times c)+2(c\\times b) & = \\\\ -27⟨0,0,1⟩+9⟨0,-1,3⟩+2⟨0,2,0⟩ & = \\\\ ⟨0,0,-27⟩+⟨0,-9,27⟩+⟨0,4,0⟩ & = \\\\ ⟨0,-5,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-127861/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "88c81beb-9b15-56ae-bb46-ce5cbc1d0ea5"] :knowledge-point/questions ["q-127861"] :db/ensure [:knowledge-point/validate]}]
