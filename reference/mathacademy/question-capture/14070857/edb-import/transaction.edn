v1/9bccbb6f8d492a6b9c5c3e1cd0ee2297a14900562287e146964305ddcee4569e/b7df10fe1c63e03128cd52e816ecb1e269036480dc48972089a6f1ae5d14432f" "q-120300/selection/ma-v1/9bccbb6f8d492a6b9c5c3e1cd0ee2297a14900562287e146964305ddcee4569e/84386ba8ee86bf6288e60f05a05ba6e3f3ba3b9b5b9bc65defced0dca1f24d61" "q-120300/selection/ma-v1/9bccbb6f8d492a6b9c5c3e1cd0ee2297a14900562287e146964305ddcee4569e/fcb0d16a76355a9942894670628ec2c8fa9d9adc9fd6588056d0bc1a98e45df1" "q-120300/selection/ma-v1/9bccbb6f8d492a6b9c5c3e1cd0ee2297a14900562287e146964305ddcee4569e/954555b75dcaef4bd7b70f4e3f980bdff6d3523978b9ab30a1404df9c2bc766d"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-120300"] :question/answer-fields ["q-120300/selection/ma-v1/9bccbb6f8d492a6b9c5c3e1cd0ee2297a14900562287e146964305ddcee4569e"] :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-15664"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/e4b9bd92b63d85b0336974285b6aa7a8a7beb8348cf368f65d805f7b4b70ffa2.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(1)$ where $h(x)=\\frac{f(x)}{g(x)}.$" :db/ensure [:question/validate]} {:db/id "q-18597/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "718f7021-24d7-5c2c-9bcc-548be09c798f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-18597/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e9eb3a60-f3b6-5354-8d43-28f31901f2ec" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-18597/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3213f82d-5ddc-5e57-a15a-c362996fe1c5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-18597/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e0adfc40-00d1-5a92-a1c9-4aa82d596289" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-18597/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "f5925460-9843-5439-87d4-c04b3a13d445" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-18597/selection" :answer-field/id #uuid "91197116-fe6c-53fe-a05c-9b2e813e4a71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18597/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-18597/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-18597/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-18597/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-18597/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-18597/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-18597" :question/id #uuid "4815bb3c-3f22-53cc-823f-4b0b7b75e12e" :question/math-academy-id "q-18597" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/7a650dd6ba3afd925a8a5672435244d454dcc06d3ac72da811f3cc2867e15023.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(0)$ where $h(x)=\\frac{f(x)}{g(x)}.$" :question/worked-solution "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(0)=\\frac{{f}^{′}(0)\\cdot g(0)-f(0)\\cdot {g}^{′}(0)}{(g(0))^{2}}.\n$$\n\nFrom the graph above, we obtain that $f(0)=1$ and $g(0)=1.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (-1,2)$ equals $0.$ So, ${f}^{′}(0)=0.$\n\n- The slope of $g(x)$ on $x\\in (-2,1)$ equals $1.$ So, ${g}^{′}(0)=1.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(0) & =\\frac{{f}^{′}(0)\\cdot g(0)-f(0)\\cdot {g}^{′}(0)}{(g(0))^{2}} \\\\  & =\\frac{0\\cdot 1-1\\cdot 1}{{1}^{2}} \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-18597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e274fe1-7242-5a6c-8351-eeff9877d2bf"] :knowledge-point/questions ["q-18597"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-77159"] :question/worked-solution "Note that the position vectors of the points $P,$ $Q$ and $R$ are\n\n$$\n\\begin{aligned}p=⟨2,4,1⟩,\\,q=⟨3,4,2⟩,\\,r=⟨3,3,1⟩.\\end{aligned}\n$$\n\nThe triangle $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨3,4,2⟩-⟨2,4,1⟩ \\\\  & =⟨1,0,1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨3,3,1⟩-⟨2,4,1⟩ \\\\  & =⟨1,-1,0⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{1\\cdot 1+0\\cdot (-1)+1\\cdot 0}{\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}\\cdot \\sqrt{{1}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{2}\\cdot \\sqrt{2}} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-101506"] :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨1,5,-1⟩,\\,q=⟨5,1,1⟩,\\,r=⟨2,5,0⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨5,1,1⟩-⟨1,5,-1⟩ \\\\  & =⟨4,-4,2⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨2,5,0⟩-⟨1,5,-1⟩ \\\\  & =⟨1,0,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{4\\cdot 1+(-4)\\cdot 0+2\\cdot 1}{\\sqrt{{4}^{2}+(-4)^{2}+{2}^{2}}\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}}} \\\\  & =\\frac{6}{\\sqrt{36}\\cdot \\sqrt{2}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{2}})={45}^{∘}.\n$$" :db/ensure [:question/validate]} {:db/id "q-131502/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "c33ac748-14a7-5f21-904a-e15f3ae5a44c" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-131502/selection/f79ac21d46fa8bcfd2ba366c2c2de99f3d6af3ad3487f811b149b2df20b45b0d" :answer/id #uuid "a6acc012-d782-5f85-8952-1217ee796119" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3y-2z-1 \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-131502/selection/56f4562a554d695040ea37df1ae7d9292a0158637458b2e7a5d5bdeaf826ac44" :answer/id #uuid "6e81cea7-9301-5f5e-acd1-f773d3aa1398" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-3y-2z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-131502/selection/f405637e0e2bb0bcd60f9d4c22a0ca9bd9f4c44807e8c11e878451cdef43b8a9" :answer/id #uuid "fc71e42b-e4ea-5505-ada6-b870ccf8cfd3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}y-2z-3 \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-131502/selection/8bbd393c62e58f498113d1514e0023da9ab0e3912ac5983fb1fe4f02228c3baa" :answer/id #uuid "0b0e6670-867d-5d48-8aa8-48ab6ebe8ca9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1-3y+2z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-131502/selection" :answer-field/id #uuid "3585bf89-95f0-53a1-98b3-ada8aefa7ab7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131502/selection/f79ac21d46fa8bcfd2ba366c2c2de99f3d6af3ad3487f811b149b2df20b45b0d" :answer-field/choices ["q-131502/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" "q-131502/selection/f79ac21d46fa8bcfd2ba366c2c2de99f3d6af3ad3487f811b149b2df20b45b0d" "q-131502/selection/56f4562a554d695040ea37df1ae7d9292a0158637458b2e7a5d5bdeaf826ac44" "q-131502/selection/f405637e0e2bb0bcd60f9d4c22a0ca9bd9f4c44807e8c11e878451cdef43b8a9" "q-131502/selection/8bbd393c62e58f498113d1514e0023da9ab0e3912ac5983fb1fe4f02228c3baa"] :db/ensure [:answer-field/validate]} {:db/id "q-131502" :question/id #uuid "cd76a088-2631-55dd-b133-6b775b2a304e" :question/math-academy-id "q-131502" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}-1 & 3 & -2 & 1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 3 & -2 & 1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & -1 \\\\ 2 & -6 & 4 & -2 \\\\ -3 & 9 & -6 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ -3 & 9 & -6 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-3y+2z=-1 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx-3y+2z=-1\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=3y-2z-1.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=3y-2z-1 \\\\ y=y \\\\ z=z\\end{aligned}\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}3y-2z-1 \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65f742e7-89c6-543b-b43a-f41c27f35abf"] :knowledge-point/questions ["q-131502"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186261938 :question/answer-fields 17592186261939] {:db/id "q-87562/selection/ma-layout-v1/2d40f0174a1534a5449c60e51dfd7adf05ad0a3b1cdf5502427341ca12984854/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "214b9899-9a67-5665-a950-226b3