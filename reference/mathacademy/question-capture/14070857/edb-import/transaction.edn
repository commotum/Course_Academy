9477a32c18831d97e12392f60f99db3ce3d27e85/9f31d84203f50ea5851ce50dd39e00d23395834b6989578076d12a8265cf7285"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-110799"] :question/problem "Solve the equation $\\operatorname{log}⁡({x}^{2}+4)=\\operatorname{log}⁡(2x+4).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡({x}^{2}+4) & =\\operatorname{log}⁡(2x+4) \\\\ {x}^{2}+4 & =2x+4 \\\\ {x}^{2}-2x & =0 \\\\ x(x-2) & =0 \\\\ x & =0,2.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $x=0$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡({x}^{2}+4) & \\overset{?}{=}\\operatorname{log}⁡(2x+4) \\\\ \\operatorname{log}⁡({0}^{2}+4) & \\overset{?}{=}\\operatorname{log}⁡(2(0)+4) \\\\ \\operatorname{log}⁡(4) & =\\operatorname{log}⁡(4).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=0$ is a valid solution.\n\n- Substituting $x=2$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡({x}^{2}+4) & \\overset{?}{=}\\operatorname{log}⁡(2x+4) \\\\ \\operatorname{log}⁡({2}^{2}+4) & \\overset{?}{=}\\operatorname{log}⁡(2(2)+4) \\\\ \\operatorname{log}⁡(8) & =\\operatorname{log}⁡(8).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=2$ is a valid solution.\n\nTherefore, the correct answer is $x=0,2.$" :question/answer-fields ["q-110799/selection/ma-v1/bef4a56445ddef23caa309569477a32c18831d97e12392f60f99db3ce3d27e85"] :db/ensure [:question/validate]} [:db/retract 17592186257073 :question/answer-fields 17592186274305] {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/63e88d719feaba349448fd3e8cb1c087e31020360c19aff8effd190d40bda8b9" :answer/id #uuid "c08a172a-dba6-5f75-b632-340e16000ed0" :answer/type :answer.type/math :answer/value "\\frac{3\\pi +2}{6}" :db/ensure [:answer/validate]} {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/6ebfca0807eec2c9bf9527dbb9cbbffa5ec3b0f7c37e1226e6bf12c05928915c" :answer/id #uuid "d3d20891-4ff1-5dbb-8fed-8238776351fc" :answer/type :answer.type/math :answer/value "12(3\\pi +2)" :db/ensure [:answer/validate]} {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/d530baba2af90c667b1de303b9e1f3ad1a9456443372f66d0c69aed52540ca70" :answer/id #uuid "05f76aca-c2bc-561a-bddc-34ff0a542704" :answer/type :answer.type/math :answer/value "\\frac{9\\pi +4}{12}" :db/ensure [:answer/validate]} {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/7dac849d99ea758cb6c4c1216745f3e41128e6c23a3bc91a9487b33f1fa28cec" :answer/id #uuid "c71ff623-0e12-5ce6-9ccb-307f4c7e77a9" :answer/type :answer.type/math :answer/value "6(3\\pi -2)" :db/ensure [:answer/validate]} {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/1a8e98810605d3bbb752831a471969e1c4754df8c53f2678e1e2c7b43c2aad44" :answer/id #uuid "ff93445a-899d-5e23-9bc7-8c9dfc268d20" :answer/type :answer.type/math :answer/value "\\frac{9\\pi -4}{6}" :db/ensure [:answer/validate]} {:db/id "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0" :answer-field/id #uuid "adca6c1d-62f4-5505-8bec-83689788d6e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/d530baba2af90c667b1de303b9e1f3ad1a9456443372f66d0c69aed52540ca70" :answer-field/choices ["q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/63e88d719feaba349448fd3e8cb1c087e31020360c19aff8effd190d40bda8b9" "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/6ebfca0807eec2c9bf9527dbb9cbbffa5ec3b0f7c37e1226e6bf12c05928915c" "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/d530baba2af90c667b1de303b9e1f3ad1a9456443372f66d0c69aed52540ca70" "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/7dac849d99ea758cb6c4c1216745f3e41128e6c23a3bc91a9487b33f1fa28cec" "q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0/1a8e98810605d3bbb752831a471969e1c4754df8c53f2678e1e2c7b43c2aad44"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-114209"] :question/worked-solution "We split the integral into the sum of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(\\frac{3}{1+{t}^{2}}+{t}^{2})\\text{d}t & =3{\\int }_{0}^{1}\\frac{1}{1+{t}^{2}}\\,\\text{d}t+{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t \\\\  & =3\\operatorname{arctan}⁡t\\,{|}_{0}^{1}+\\frac{1}{3}{t}^{3}\\,{|}_{0}^{1} \\\\  & =3(\\operatorname{arctan}⁡1-\\operatorname{arctan}⁡0)+\\frac{1}{3}({1}^{3}-{0}^{1}) \\\\  & =3(\\frac{\\pi }{4}-0)+\\frac{1}{3}(1-0) \\\\  & =\\frac{3\\pi }{4}+\\frac{1}{3} \\\\  & =\\frac{9\\pi +4}{12}.\\end{aligned}\n$$" :question/answer-fields ["q-114209/selection/ma-v1/db10bd4e269fad1ec41ea767d606c1b92c017b206eb7beb61c20a3ecc97c25f0"] :db/ensure [:question/validate]} {:db/id "q-340441/field-1/464f5022aa3e67ee0d9c103f3d4b9d7a4d26d603163206b53381d1b3cc4f99ae" :answer/id #uuid "a7b9e555-f3aa-5cd6-950f-08c43822e85f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}-\\frac{\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-340441/field-1" :answer-field/id #uuid "06b13a24-cce8-5852-a4c9-981577d640b9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340441/field-1/464f5022aa3e67ee0d9c103f3d4b9d7a4d26d603163206b53381d1b3cc4f99ae" :answer-field/choices ["q-340441/field-1/464f5022aa3e67ee0d9c103f3d4b9d7a4d26d603163206b53381d1b3cc4f99ae"] :db/ensure [:answer-field/validate]} {:db/id "q-340441" :question/id #uuid "a9f56d16-69e2-5e42-9927-40d2d6f7ebe6" :question/math-academy-id "q-340441" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}(x-\\frac{2}{1+{x}^{2}})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(x-\\frac{2}{1+{x}^{2}})\\,\\text{d}x & ={\\int }_{0}^{1}x\\,\\text{d}x-2{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{x}^{2}\\,{|}_{0}^{1}+2\\,\\text{arccot}\\,x\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2}({1}^{2}-{0}^{2})+2(\\text{arccot}(1)-\\text{arccot}(0)) \\\\  & =\\frac{1}{2}+2(\\frac{\\pi }{4}-\\frac{\\pi }{2}) \\\\  & =-\\frac{\\pi }{2}+\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340441/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115"] :knowledge-point/questions ["q-340441"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42956/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b70e0ccf-90bf-5e54-8e26-5aa7fdaf6e51" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-42956/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "0941b4ab-ca51-5bb3-8d66-7735b452d7d4" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-42956/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "6ec78026-e387-5aa3-a5b0-6e51b959cfed" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-42956/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "2dcdd090-c5fd-58e3-87c2-47359f2fe5ed" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-42956/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "14795d1c-804a-5b65-841f-f9237a38c557" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-42956/selection" :answer-field/id #uuid "d420995f-d37c-558c-8647-13230320ed20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42956/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-42956/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-42956/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-42956/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-42956/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-42956/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-42956" :question/id #uuid "2429ecaa-33bb-5f48-9f8e-417f40d5663d" :question/math-academy-id "q-42956" :question/problem "Find the determinant of the matrix \n$K=[\\begin{aligned}2 & 1 & 4 & 0 \\\\ -2 & \\,-1 & 0 & 0 \\\\ 0 & -1 & 0 & 0 \\\\ 0 & 0 & 8 & 1\\end{aligned}].$" :question/worked-solution "Notice that the $4$th column contains three zeros. So, using Laplace expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}\\text{det}(K) & =|\\begin{aligned}2 & 1 & 4 & 0 \\\\ -2 & \\,-1 & 0 & 0 \\\\ 0 & -1 & 0 & 0 \\\\ 0 & 0 & 8 & 1\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+4}|\\begin{aligned}2 & 1 & 4 \\\\ -2 & -1 & 0 \\\\ 0 & -1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 4 \\\\ -2 & -1 & 0 \\\\ 0 & -1 & 0\\end{aligned}|\\end{aligned}\n$$\n\nNow, notice that the $3$rd column of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}det(K) & =|\\begin{aligned}2 & 1 & 4 \\\\ -2 & -1 & 0 \\\\ 0 & -1 & 0\\end{aligned}| \\\\  & =4\\cdot (-1)^{1+3}|\\begin{aligned}-2 & -1 \\\\ 0 & -1\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & -1 \\\\ 0 & -1\\end{aligned}| \\\\  & =4(2-0) \\\\  & =4\\cdot 2 \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42956/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02e65c73-8c02-5403-8c5c-b1e81f81a7b6"] :knowledge-point/questions ["q-42956"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32649/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "8cde103c-caa3-555c-8085-80eaeb6f2041" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-32649/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "272cb7b4-f6f4-5d5a-be90-cb51891fa27d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-32649/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "66222c50-6b1c-5673-8b8e-4c873603ca3d" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-32649/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "bb2de307-015f-564b-b281-2f737087000e" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-32649/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7e6052eb-16a0-515a-874a-38d4a1a2edb7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-32649/selection" :answer-field/id #uuid "9e082d52-0fcc-5abf-9c8b-deb5c808384d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32649/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-32649/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-32649/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-32649/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-32649/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-32649/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-32649" :question/id #uuid "fa3bb828-f15f-5f20-bb47-185a836bef02" :question/math-academy-id "q-32649" :question/problem "$$\nC=[\\begin{aligned}3 & 1 & -2 \\\\ 3 & -2 & 1 \\\\ 0 & 3 & 4\\end{aligned}]\n$$\n\nIf $C=LU$ is the LU decomposition of the matrix $C$ given above, what is the value of ${l}_{32}\\cdot {u}_{33}?$" :question/worked-solution "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $C$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}3 & 1 & -2 \\\\ 3 & -2 & 1 \\\\ 0 & 3 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 1 & -2 \\\\ \\,\\,1\\,\\, & -3 & 3 \\\\ 0 & 3 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+1{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 1 & -2 \\\\ \\,\\,1\\,\\, & -3 & 3 \\\\ \\,\\,0\\,\\, & -1 & 7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}],\\,U=[\\begin{aligned}3 & 1 & -2 \\\\ 0 & -3 & 3 \\\\ 0 & 0 & 7\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=-1$ and ${u}_{33}=7,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{33}=(-1)\\cdot 7=-7.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32649/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e28bd3d9-649d-5cc3-a12e-e1f821caaf24"] :knowledge-point/questions ["q-32649"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-337570"] :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by $xy=C.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}(xy) & =\\frac{d}{dx}(C) \\\\ y+x{y}^{′} & =0 \\\\ x{y}^{′} & =-y \\\\ {y}^{′} & =-\\frac{y}{x}\\end{aligned}\n$$\n\nNote that the parameter $C$ has already been eliminated.\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{(-\\frac{y}{x})}=\\frac{x}{y}.\n$$\n\nHence, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{x}{y}.\n$$\n\nTo find the general solution, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}y\\cdot \\frac{dy}{dx} & =x \\\\ \\int y\\cdot \\frac{dy}{dx}\\,dx & =\\int x\\,dx \\\\ \\int y\\,dy & =\\int x\\,dx \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+{K}_{1} \\\\ {y}^{2} & ={x}^{2}+K\\end{aligned}\n$$\n\nNote that $K=2{K}_{1}$ is a constant of integration.\n\nTherefore, the orthogonal trajectories of the family of curves $xy=C,$ where $C$ is a parameter, are given by\n\n$$\n{y}^{2}={x}^{2}+K,\n$$\n\nwhere $K$ is a parameter. Some curves from each family for specific parameter values are given in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/98159dfb60fd280468ad8165475b5ba58e41658174a932b4c9555ef1153a577c.png)\n\n**Note**: For the slopes ${y}^{′}$ and ${y}_{⊥}^{′},$ we divide by $x$ and $y,$ respectively. So, the orthogonal trajectories are only defined on the region $x,y\\ne 0.$" :db/ensure [:question/validate]} {:db/id "q-105109/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "31f34921-2748-5e05-93cc-f63c7df697d3" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-105109/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "869cfeac-e1d4-547b-9ab7-2ae304f3699a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-105109/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f138b3bf-a6cc-57c1-8407-dcb40f354d8a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105109/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "89d5dccd-f562-5a5c-b239-3fd672d4d12a" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-105109/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "79ed1760-d864-511a-be88-badfbdee2f46" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105109/selection" :answer-field/id #uuid "2870a3c6-8b28-569e-a545-5ac2be61173b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105109/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-105109/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-105109/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-105109/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-105109/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-105109/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-105109" :question/id #uuid "179d4a3d-2144-50fb-92a8-d9be91bfc307" :question/math-academy-id "q-105109" :question/problem "Let\n$a=[\\begin{aligned}x \\\\ 2 \\\\ 1 \\\\ -1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ 9 \\\\ 7\\end{aligned}].$\nIf $a\\cdot b=-3$, find the value of $x.$" :question/worked-solution "Starting from the equation $a\\cdot b=-3,$ we compute the dot product in terms of $x$ and then solve for $x$ in the resulting equation:\n\n$$\n\\begin{aligned}a\\cdot b & =-3 \\\\ x\\cdot 3+2\\cdot x+1\\cdot 9+(-1)\\cdot 7 & =-3 \\\\ 3x+2x+9-7 & =-3 \\\\ 5x & =-5 \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, we conclude that $x=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105109/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94f8e0e5-8d8a-516a-8f46-d76e94305df4"] :knowledge-point/questions ["q-105109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80657/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "87151d9b-b153-54c9-b16b-44cc6acc1ad7" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-80657/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "c9b894be-c637-5875-be71-b0d47dfe4877" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-80657/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer/id #uuid "679c2f12-a7da-5fbe-b5b7-bacb290e148b" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "q-80657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b7aa41dd-b183-5c75-ad07-f2e107ed1486" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-80657/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "1e42bb6e-6c10-5629-a714-40e62d509e55" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-80657/selection" :answer-field/id #uuid "f80a6bbf-0ee6-5c6f-8cbd-b09c66efd675" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-80657/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-80657/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-80657/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" "q-80657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-80657/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458"] :db/ensure [:answer-field/validate]} {:db/id "q-80657" :question/id #uuid "8141415e-7022-5c96-b27f-f8bbe2f3b828" :question/math-academy-id "q-80657" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=7,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A & =4{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =4({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =4(-5+7) \\\\  & =8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80657/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd"] :knowledge-point/questions ["q-80657"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-98525"] :question/worked-solution "To draw the phase line of the differential equation, we proceed using the following three steps:\n\n**Step 1**: Find the equilibrium solutions of the differential equation. \n\nIn this case, we have \n\n$$\n\\begin{aligned}{y}^{2}+y-2 & =0 \\\\ (y-1)(y+2) & =0 \\\\ y & =-2,1.\\end{aligned}\n$$\n\nTherefore, the equilibrium solutions are $y=-2$ and $y=1.$\n\n**Step 2**: Find the intervals of $y$ for which $f(y)>0$ and $f(y)<0.$ \n\nConstructing a sign table, we get the following:\n\n|  | $(-\\infty ,-2)$ | $(-2,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $y+2$ | $-$ | $+$ | $+$ |\n| $y-1$ | $-$ | $-$ | $+$ |\n| $f(y)$ | $+$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is positive for $y\\in (-\\infty ,-2)\\cup (1,\\infty ),$ and negative for $y\\in (-2,1).$\n\n**Step 3**: Draw the phase line using the following recipe:\n\n- Draw a vertical $y$-axis\n\n- Mark the equilibrium solutions\n\n- Draw arrows pointing up in the intervals where $f(y)>0$\n\n- Draw arrows pointing down in the intervals where $f(y)<0$\n\nApplying the above recipe, we get the following phase line for our differential equation.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/assets/39ab4bfad5e05067d9e50979deb2a7699eb41aa87037fdf6e3a6d14a98dcfa19.png)" :db/ensure [:question/validate]} [:db/retract 17592186261611 :question/answer-fields 17592186274998] {:db/id "q-76311/selection/ma-v1/6446dc780e1557c8bd77bfd714ba886e3200fdcb499ffcf6df82db72c2981e4d/40559b4cd27cffc356d47056f18ffb3ffe5300602370122869ba937983d94b66" :answer/id #uuid "101828db-1b09-50de-8277-524f90dfe027" :answer/type :answer.type/math :answer/value "12{w}^{3}" :db/ensure [:answer/validate]} {:db/id "q-76311/selection/ma-v1/6446dc780e1557c8bd77bfd714ba886e3200fdcb499ffcf6df82db72c2981e4d/057253446abf7602969bce6785068a91053a0cb03021e432fd432a8119bdff76" :answer/id #uuid "53bc6414-c2a3-5702-8f04-3e1a08470b0e" :answer/type :answer.type/math :answer/value "36{w}^{6}" :db/ensure [:answer/validate]} {:db/id "q-76311/selection/ma-v1/6446dc780e1557c8bd77bfd714ba886e3200fdcb499ffcf6df82db72c2981e4d/1511