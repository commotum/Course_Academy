370369 1113 #uuid "8141415e-7022-5c96-b27f-f8bbe2f3b828" 13194139535852 true] [17592186370369 1145 "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A & =4{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =4({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =4(-5+7) \\\\  & =8\\end{aligned}\n$$" 13194139535852 true] [17592186370370 1000 #edb/ref 17592186370371 13194139535852 true] [17592186370370 1000 #edb/ref 17592186370372 13194139535852 true] [17592186370370 1000 #edb/ref 17592186370373 13194139535852 true] [17592186370370 1000 #edb/ref 17592186370374 13194139535852 true] [17592186370370 1000 #edb/ref 17592186370375 13194139535852 true] [17592186370370 1040 #edb/ref 17592186045450 13194139535852 true] [17592186370370 1041 "selection" 13194139535852 true] [17592186370370 1104 #edb/ref 17592186370374 13194139535852 true] [17592186370370 1110 #uuid "f80a6bbf-0ee6-5c6f-8cbd-b09c66efd675" 13194139535852 true] [17592186370371 1034 "28" 13194139535852 true] [17592186370371 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370371 1111 #uuid "1e42bb6e-6c10-5629-a714-40e62d509e55" 13194139535852 true] [17592186370372 1034 "-8" 13194139535852 true] [17592186370372 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370372 1111 #uuid "87151d9b-b153-54c9-b16b-44cc6acc1ad7" 13194139535852 true] [17592186370373 1034 "40" 13194139535852 true] [17592186370373 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370373 1111 #uuid "679c2f12-a7da-5fbe-b5b7-bacb290e148b" 13194139535852 true] [17592186370374 1034 "8" 13194139535852 true] [17592186370374 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370374 1111 #uuid "b7aa41dd-b183-5c75-ad07-f2e107ed1486" 13194139535852 true] [17592186370375 1034 "48" 13194139535852 true] [17592186370375 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370375 1111 #uuid "c9b894be-c637-5875-be71-b