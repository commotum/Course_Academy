4139535852 true] [17592186370306 1034 "-\\frac{1}{2+{log}_{9}⁡(5)}" 13194139535852 true] [17592186370306 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370306 1111 #uuid "48e1be2d-ae61-5b97-9725-cce466d23595" 13194139535852 true] [17592186370307 1034 "{log}_{9}⁡(5)" 13194139535852 true] [17592186370307 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370307 1111 #uuid "8a348509-813b-522d-8ba8-1239e7e5ad75" 13194139535852 true] [17592186370308 1034 "\\frac{1}{{log}_{9}⁡(5)}" 13194139535852 true] [17592186370308 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370308 1111 #uuid "4b1d56cc-80f9-570c-80b7-6fbbb94cf74a" 13194139535852 true] [17592186370309 1017 #edb/ref 17592186370310 13194139535852 true] [17592186370309 1089 "q-313939" 13194139535852 true] [17592186370309 1091 #edb/ref 17592186045464 13194139535852 true] [17592186370309 1100 "Consider the section of the parabola ${x}^{2}-4y=5$ that lies in the first quadrant.  Given that $x=x(t),$ $y=y(t),$  and that $\\frac{\\text{d}y}{\\text{d}t}=8$ on the parabola at the point where $y=11,$ find the value of $\\frac{\\text{d}x}{\\text{d}t}$ at that point. Do not round the answer.\n\n$\\frac{\\text{d}x}{\\text{d}t}=$\n{{field-1}}" 13194139535852 true] [17592186370309 1113 #uuid "d94f32f2-a057-5622-b1f5-23f8c4b4d4a0" 13194139535852 true] [17592186370309 1145 "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}{x}^{2}-4y & =5 \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2}-4y) & =\\frac{\\text{d}}{\\text{d}t}(5) \\\\ \\frac{\\text{d}}{\\text{d}t}({x}^{2})-\\frac{\\text{d}}{\\text{d}t}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}y}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}y}(4y) & =0 \\\\ \\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-\\frac{\\text{d}y}{\\text{d}t}\\cdot 4 & =0.\\end{aligned}\n$$\n\n \n\nNow, substituting the given information $\\frac{\\text{d}y}{\\text{d}t}=8$ and $y=11,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}\\cdot (2x)-8\\cdot 4 & =0 \\\\ 2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0.\\end{aligned}\n$$\n\nWe also want to substitute for $x,$ but we are not given this value. However, we can find it by substituting $y=11$ into the equation of the parabola.  \n\nAt the point where $y=11,$ we have \n\n$$\n\\begin{aligned}{x}^{2}-4y & =5 \\\\ {x}^{2}-4(11) & =5 \\\\ {x}^{2}-44 & =5 \\\\ {x}^{2} & =49 \\\\ x & =7.\\end{aligned}\n$$\n\nNote that we used $x>0$ since we're only interested in the first quadrant. \n\nFinally, substituting $x=7,$ we get \n\n$$\n\\begin{aligned}2x\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0 \\\\ 2(7)\\cdot \\frac{\\text{d}x}{\\text{d}t}-32 & =0 \\\\ 14\\cdot \\frac{\\text{d}x}{\\text{d}t} & =32 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{32}{14} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{16}{7}.\\end{aligned}\n$$" 13194139535852 true] [17592186370310 1000 #edb/ref 17592186370311 13194139535852 true] [17592186370310 1040 #edb/ref 17592186045449 13194139535852 true] [17592186370310 1041 "field-1" 13194139535852 true] [17592186370310 1104 #edb/ref 17592186370311 13194139535852 true] [17592186370310 1110 #uuid "e80e4388-8aab-5db8-a7ca-1f7ad0a6f7ec" 13194139535852 true] [17592186370311 1034 "\\frac{16}{7}" 13194139535852 true] [17592186370311 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370311 1111 #uuid "4ae8d126-af0a-5587-9d29-96afbbe02046" 13194139535852 true] [17592186370312 1017 #edb/ref 17592186370313 13194139535852 true] [17592186370312 1089 "q-32649" 13194139535852 true] [17592186370312 1091 #edb/ref 17592186045465 13194139535852 true] [17592186370312 1100 "$$\nC=[\\begin{aligned}3 & 1 & -2 \\\\ 3 & -2 & 1 \\\\ 0 & 3 & 4\\end{aligned}]\n$$\n\nIf $C=LU$ is the LU decomposition of the matrix $C$ given above, what is the value of ${l}_{32}\\cdot {u}_{33}?$" 13194139535852 true] [17592186370312 1113 #uuid "fa3bb828-f15f-5f20-bb47-185a836bef02" 13194139535852 true] [17592186370312 1145 "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $C$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}3 & 1 & -2 \\\\ 3 & -2 & 1 \\\\ 0 & 3 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 1 & -2 \\\\ \\,\\,1\\,\\, & -3 & 3 \\\\ 0 & 3 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+1{R}_{2} \\\\  & ∼[\\begin{aligned}3 & 1 & -2 \\\\ \\,\\,1\\,\\, & -3 & 3 \\\\ \\,\\,0\\,\\, & -1 & 7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}],\\,U=[\\begin{aligned}3 & 1 & -2 \\\\ 0 & -3 & 3 \\\\ 0 & 0 & 7\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=-1$ and ${u}_{33}=7,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{33}=(-1)\\cdot 7=-7.\n$$" 13194139535852 true] [17592186370313 1000 #edb/ref 17592186370314 13194139535852 true] [17592186370313 1000 #edb/ref 17592186370315 13194139535852 true] [17592186370313 1000 #edb/ref 17592186370316 13194139535852 true] [17592186370313 1000 #edb/ref 17592186370317 13194139535852 true] [17592186370313 1000 #edb/ref 17592186370318 13194139535852 true] [17592186370313 1040 #edb/ref 17592186045450 13194139535852 true] [17592186370313 1041 "selection" 13194139535852 true] [17592186370313 1104 #edb/ref 17592186370314 13194139535852 true] [17592186370313 1110 #uuid "9e082d52-0fcc-5abf-9c8b-deb5c808384d" 13194139535852 true] [17592186370314 1034 "-7" 13194139535852 true] [17592186370314 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370314 1111 #uuid "bb2de307-015f-564b-b281-2f737087000e" 13194139535852 true] [17592186370315 1034 "3" 13194139535852 true] [17592186370315 1103 #edb/ref 17592186045453 13194139535852 true] [17592186370315 1111 #uuid "272cb7b4-f6f4-5d5a-be90-cb51891fa27d" 13194139535852 true