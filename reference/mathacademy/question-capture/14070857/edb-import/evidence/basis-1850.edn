#{[{:db/id #edb/ref 17592186334718 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c8ee97e-f2b0-587e-9171-8008f1e0c4aa" :knowledge-point/title "Applying the Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e1a8bd-192a-5d8c-911a-e177dfb7ce9d" :answer/type {:db/ident :answer.type/math} :answer/value "-2i-2j+4k" :db/id #edb/ref 17592186334720} {:answer/id #uuid "8574fde5-fb29-5ac6-8416-2de97bb2fc76" :answer/type {:db/ident :answer.type/math} :answer/value "4i-6j+2k" :db/id #edb/ref 17592186334721} {:answer/id #uuid "b11c2512-97aa-5321-8629-5246aea9bddd" :answer/type {:db/ident :answer.type/math} :answer/value "2i+2j-4k" :db/id #edb/ref 17592186334722} {:answer/id #uuid "a7df66a0-c3b2-540a-abf1-e56481e17e6a" :answer/type {:db/ident :answer.type/math} :answer/value "i+6j+2k" :db/id #edb/ref 17592186334723} {:answer/id #uuid "ccaa5a2b-a015-56c6-ac37-5031c36333b2" :answer/type {:db/ident :answer.type/math} :answer/value "2i-6j-4k" :db/id #edb/ref 17592186334724}] :answer-field/correct {:answer/id #uuid "ccaa5a2b-a015-56c6-ac37-5031c36333b2" :answer/type {:db/ident :answer.type/math} :answer/value "2i-6j-4k" :db/id #edb/ref 17592186334724} :answer-field/id #uuid "dc6eede9-d55d-59ed-8257-0f817d1476ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186334719}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b190b78e-5c96-53ca-a8be-8f4dce1bb987" :question/math-academy-id "q-32522" :question/problem "Find ${\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t=4\\,i+2\\,k$ \nand \n$c=i+j-k.$" :question/worked-solution "The cross-product rule states that\n\n$$\n{\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t \\\\  & =(i+j-k)\\times (4\\,i+2\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & -1 \\\\ 4 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}1 & -1 \\\\ 4 & 2\\end{aligned}|j+|\\begin{aligned}1 & 1 \\\\ 4 & 0\\end{aligned}|k \\\\  & =(2-0)i-(2+4)j+(0-4)k \\\\  & =2i-6j-4k.\\end{aligned}\n$$"}]}
