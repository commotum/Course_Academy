#{[{:db/id #edb/ref 17592186294213 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ed7bf75-527f-5614-b21a-8bb91ca67023" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cot}⁡(4x+3)+C" :db/id #edb/ref 17592186294215} {:answer/id #uuid "829abec4-a7a3-56c9-9cce-9d5b74d86141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{tan}⁡(4x+3)+C" :db/id #edb/ref 17592186294216} {:answer/id #uuid "5d9eb423-01a3-5a7a-89c8-2c40be7e5979" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡(4x+3)+C" :db/id #edb/ref 17592186294217} {:answer/id #uuid "54cfdbe3-cccb-5d5f-95af-07b8a4c9fb1f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}\\operatorname{cot}⁡(4x+3)+C" :db/id #edb/ref 17592186294218} {:answer/id #uuid "77e0143d-3c0c-55f3-a8a9-6591264d34a3" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\operatorname{tan}⁡(4x+3)+C" :db/id #edb/ref 17592186294219}] :answer-field/correct {:answer/id #uuid "5d9eb423-01a3-5a7a-89c8-2c40be7e5979" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡(4x+3)+C" :db/id #edb/ref 17592186294217} :answer-field/id #uuid "2d3dc11a-e19c-57fc-851b-1872ab159010" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294214}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7e85b0db-5e58-5d04-ba1f-e556cc78eeff" :question/math-academy-id "q-114473" :question/problem "$\\int (8+8{cot}^{2}⁡(4x+3))\\text{d}x=$" :question/worked-solution "From the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ with $\\theta =4x+3,$ we get \n\n$$\n\\begin{aligned}1+{cot}^{2}⁡(4x+3)={csc}^{2}⁡(4x+3).\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8+8{cot}^{2}⁡(4x+3))\\text{d}x & =8\\int (1+{cot}^{2}⁡(4x+3))\\text{d}x \\\\  & =8\\int {csc}^{2}⁡(4x+3)\\,\\text{d}x \\\\  & =8[-\\frac{1}{4}\\operatorname{cot}⁡(4x+3)]+C \\\\  & =-2\\operatorname{cot}⁡(4x+3)+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257116 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fed1761-ceeb-5033-afa2-cb735e6bb96c" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fff4a42a-1044-511f-a09b-090c1f1833ab" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186294221} {:answer/id #uuid "aa0cb6f7-7fd4-579a-9bcd-c11391187965" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186294222} {:answer/id #uuid "301fd970-136e-53c6-98e5-15f739d97651" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186294223} {:answer/id #uuid "7752c85f-3405-5a76-a9e2-c4f837460361" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186294224} {:answer/id #uuid "6f3f1780-e729-5653-8d50-90305dcf183e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186294225}] :answer-field/correct {:answer/id #uuid "aa0cb6f7-7fd4-579a-9bcd-c11391187965" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186294222} :answer-field/id #uuid "cf0a2e6e-f807-509f-aaad-0b1f33c9e9e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294220}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1bd10278-9b76-5fcf-980b-136026be1670" :question/math-academy-id "q-114961" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/assets/d624edaffd8c90de40041d419cf65bcf8f3af5d31c8d88d1123bd8f3d7555166.png)\n\nWhat is the length of the major axis of the ellipse given above?" :question/worked-solution "The major axis is the longest diameter of the ellipse, which is the line segment bounded by the points $(-3,1)$ and $(5,1).$ So, the length of the major axis is $5-(-3)=8.$"}] [{:db/id #edb/ref 17592186257134 :knowledge-point/_questions [{:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be8d1c5e-e358-58c6-a688-f0180865145a" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}=-\\frac{1}{3}(y+4)" :db/id #edb/ref 17592186294227} {:answer/id #uuid "1abadc92-842b-58eb-a6a7-9ab692f36d77" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}=-\\frac{1}{3}(y-4)" :db/id #edb/ref 17592186294228} {:answer/id #uuid "b366c2c0-0315-56d9-bb66-b41e7e9793e9" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=4(y-2)" :db/id #edb/ref 17592186294229} {:answer/id #uuid "b1ce34fa-6acb-5ae0-8905-f4e016ed1567" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}=-\\frac{4}{3}(y-4)" :db/id #edb/ref 17592186294230} {:answer/id #uuid "26d66dc3-79c7-5ea4-bd7e-c8e05de330f2" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}=3(y+4)" :db/id #edb/ref 17592186294231}] :answer-field/correct {:answer/id #uuid "b1ce34fa-6acb-5ae0-8905-f4e016ed1567" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}=-\\frac{4}{3}(y-4)" :db/id #edb/ref 17592186294230} :answer-field/id #uuid "9c49152a-535a-5c02-bc12-65fe628a29f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294226}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6c976869-dd96-5219-84a7-962a7edc295e" :question/math-academy-id "q-115511" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(2,4)$ and which passes through the point $(4,1).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,4).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,1),$ so we can substitute $x=4$ and $y=1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (4-2)^{2} & =4p(1-4) \\\\ 4 & =-12p \\\\ p & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-4) \\\\ (x-2)^{2} & =4(-\\frac{1}{3})(y-4) \\\\ (x-2)^{2} & =-\\frac{4}{3}(y-4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186257386 :knowledge-point/_questions [{:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a350c9-d02e-57cd-8aac-1637a092b1fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186294233} {:answer/id #uuid "532f4450-bd24-56fc-9836-8c1508ff9172" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186294234} {:answer/id #uuid "442fc634-b9f7-5e5d-ac0a-5387321dbc50" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186294235} {:answer/id #uuid "65e589fa-49c8-5f91-88d6-354f06544c08" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186294236} {:answer/id #uuid "6fccf9f5-4397-57c4-9c73-690a092a3669" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186294237}] :answer-field/correct {:answer/id #uuid "6fccf9f5-4397-57c4-9c73-690a092a3669" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186294237} :answer-field/id #uuid "c3a9d216-68e8-5934-83cd-fee5c57faee5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294232}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a918518-91f1-50bb-bef6-5c2c5dd04e5a" :question/math-academy-id "q-119865" :question/problem "Simplify $\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1$" :question/worked-solution "First, we rewrite the numerator of the first term using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{{sin}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1=\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1\n$$\n\nNext, we factor the numerator of the first term as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡x}{1-\\operatorname{cos}⁡x}-1 & =\\frac{(1-\\operatorname{cos}⁡x)(1+\\operatorname{cos}⁡x)}{1-\\operatorname{cos}⁡x}-1 \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡x)}(1+\\operatorname{cos}⁡x)}{\\cancel{1-\\operatorname{cos}⁡x}}-1 \\\\  & =\\frac{1+\\operatorname{cos}⁡x}{1}-1 \\\\  & =1+\\operatorname{cos}⁡x-1 \\\\  & =\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294258 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fb6c44-5d1c-548d-b12a-c2d42c762c26" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 6 & 49\\end{aligned}]" :db/id #edb/ref 17592186294260} {:answer/id #uuid "7bee1c28-a017-513f-aec8-d20f4a003bf7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 6 & 9\\end{aligned}]" :db/id #edb/ref 17592186294261} {:answer/id #uuid "0388cfc5-c8d1-5fc5-9831-f028d3cb6239" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-49 & -8 \\\\ 6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294262} {:answer/id #uuid "50b87d23-088b-577f-87fa-71e62dd568a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294263} {:answer/id #uuid "1ff4399e-ed7b-55f3-a569-294cd45859c7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -8 \\\\ -6 & 49\\end{aligned}]" :db/id #edb/ref 17592186294264}] :answer-field/correct {:answer/id #uuid "50b87d23-088b-577f-87fa-71e62dd568a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294263} :answer-field/id #uuid "6c833db1-4dfe-5b56-8c61-d74f13993f47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294259}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4a1381b5-29b5-5930-b404-a382cf590fc1" :question/math-academy-id "q-130807" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =[\\begin{aligned}1 & 8 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+(-8){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -8 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=[\\begin{aligned}1 & -8 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=[\\begin{aligned}1 & -8 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}]=[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186258090 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c800bf1-db0e-5a4f-b1f7-79de46c24ed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186294266} {:answer/id #uuid "7bdc1a32-3ddc-5b62-b443-798708784e12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186294267} {:answer/id #uuid "8fbfce8f-1539-5097-be10-dbae597cac5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186294268} {:answer/id #uuid "2ee8162a-22a0-5c9e-b9db-f9b656661d56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186294269} {:answer/id #uuid "976eda39-25fa-5c0c-ada1-63cab5aa0334" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186294270}] :answer-field/correct {:answer/id #uuid "8fbfce8f-1539-5097-be10-dbae597cac5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186294268} :answer-field/id #uuid "f9a0acda-284b-5a31-8855-d2a8a1ff7df1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294265}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4878f13e-2679-5b9e-8cae-9094f9bb2d55" :question/math-academy-id "q-141281" :question/problem "$\\operatorname{sin}⁡(x+\\frac{2\\pi }{3})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{2\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{2\\pi }{3}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{2\\pi }{3})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294278 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad21350b-2e3b-57ee-a28c-32a7bd1b2513" :knowledge-point/title "Defining a Set Conditionally Using the Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91dcc00f-f2c8-5426-abf6-ea1bd962502f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186294280}] :answer-field/correct {:answer/id #uuid "91dcc00f-f2c8-5426-abf6-ea1bd962502f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186294280} :answer-field/id #uuid "6dc9ed36-2e28-53d3-b481-63ba06aab151" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294279} {:answer-field/choices [{:answer/id #uuid "c7b45060-96c6-56b3-8a7a-8c9256323089" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186294282}] :answer-field/correct {:answer/id #uuid "c7b45060-96c6-56b3-8a7a-8c9256323089" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186294282} :answer-field/id #uuid "2197653f-5856-51b3-ae3c-3a6c052c22e4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294281} {:answer-field/choices [{:answer/id #uuid "813b7692-a886-5db2-af35-a22870db92f5" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186294284}] :answer-field/correct {:answer/id #uuid "813b7692-a886-5db2-af35-a22870db92f5" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186294284} :answer-field/id #uuid "5af16cba-3ced-5c9a-b277-4dd0c6700f60" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294283}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "926edf84-42b1-556a-b7aa-63fc4baac279" :question/math-academy-id "q-181704" :question/problem "Find the missing coefficients in the conditional definition of the set ${2,3-\\text{i},3+\\text{i}}$ given below.\n\n${2,3-\\text{i},3+\\text{i}}={z\\in C\\,:\\,{z}^{3}\\,-$\n{{field-1}}\n${z}^{2}\\,+$\n{{field-2}}\n$z\\,-$\n{{field-3}}\n$=0}$" :question/worked-solution "The given set contains the roots $z\\in C$ of some cubic polynomial $p(z).$\n\nSince the cubic polynomial has roots ${z}_{1}=2,$ ${z}_{2}=3-\\text{i},$ and ${z}_{3}=3+\\text{i},$ and the coefficient of the cubic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(z) & =a(z-{z}_{1})(z-{z}_{2})(z-{z}_{3}) \\\\  & =(1)(z-2)(z-(3-\\text{i}))(z-(3+\\text{i})) \\\\  & =(z-2)({z}^{2}-z(3+\\text{i})-z(3-\\text{i})+(3-\\text{i})(3+\\text{i})) \\\\  & =(z-2)({z}^{2}-6z+10) \\\\  & ={z}^{3}-6{z}^{2}+10z-2{z}^{2}+12z-20 \\\\  & ={z}^{3}-8{z}^{2}+22z-20\\end{aligned}\n$$\n\nTherefore, we can express the given set as\n\n$$\n{2,3-\\text{i},3+\\text{i}}={z\\in C\\,:\\,{z}^{3}-8{z}^{2}+22z-20=0}.\n$$"}] [{:db/id #edb/ref 17592186294285 :knowledge-point/_questions [{:knowledge-point/id #uuid "88c81beb-9b15-56ae-bb46-ce5cbc1d0ea5" :knowledge-point/title "Calculating Cross Product Expressions Using Anticommutativity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b3624ea-5bda-5907-aac1-9ee497758727" :answer/type {:db/ident :answer.type/math} :answer/value "6j-3k" :db/id #edb/ref 17592186294287} {:answer/id #uuid "ae133177-1618-5d14-b6e2-296ab61003ff" :answer/type {:db/ident :answer.type/math} :answer/value "6i-2j" :db/id #edb/ref 17592186294288} {:answer/id #uuid "f18e7b53-2d26-5157-82ee-56b87f8dd998" :answer/type {:db/ident :answer.type/math} :answer/value "9j-6k" :db/id #edb/ref 17592186294289} {:answer/id #uuid "f6877b03-36f1-5530-b6f7-2a05f7f903e1" :answer/type {:db/ident :answer.type/math} :answer/value "9j+2k" :db/id #edb/ref 17592186294290} {:answer/id #uuid "5f5ff3f5-9d6a-5c60-ad94-17325fbe13b1" :answer/type {:db/ident :answer.type/math} :answer/value "-9j+6k" :db/id #edb/ref 17592186294291}] :answer-field/correct {:answer/id #uuid "f18e7b53-2d26-5157-82ee-56b87f8dd998" :answer/type {:db/ident :answer.type/math} :answer/value "9j-6k" :db/id #edb/ref 17592186294289} :answer-field/id #uuid "a74272dc-ecf7-5b7f-8a1c-c37d16d42024" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294286}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "67fdf3c0-7b47-568c-a0de-0f280923b37c" :question/math-academy-id "q-19777" :question/problem "Find $(2a+3c)\\times (b+2c)$, if $a\\times b=3i-2j+k$, $a\\times c=j-2k$ and $b\\times c=2i-3j.$" :question/worked-solution "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(2a+3c)\\times (b+2c) & = \\\\ ((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}((2a)\\times b)+((2a)\\times (2c))+((3c)\\times b)+((3c)\\times (2c)) & = \\\\ 2(a\\times b)+(2\\cdot 2)(a\\times c)+3(c\\times b)+(3\\cdot 2)(c\\times c) & = \\\\ 2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $c\\times c=0:$\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)+3(c\\times b)+6(c\\times c) & = \\\\ 2(a\\times b)+4(a\\times c)-3(b\\times c)+6(0) & = \\\\ 2(a\\times b)+4(a\\times c)-3(b\\times c)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}2(a\\times b)+4(a\\times c)-3(b\\times c) & = \\\\ 2(3i-2j+k)+4(j-2k)-3(2i-3j) & = \\\\ (6i-4j+2k)+(4j-8k)-(6i-9j) & = \\\\ (6i-6i)+(-4j+4j+9j)+(2k-8k) & = \\\\ 9j-6k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294334 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5481ebe6-7afc-5959-b9ff-3ac4af78b201" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186294336} {:answer/id #uuid "30ebfb58-3bc7-569d-95bf-f02e3b8ca8a5" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186294337} {:answer/id #uuid "5d7679e4-a83a-5caf-a580-1ef94cc88f1a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186294338} {:answer/id #uuid "f9c9dce6-e0bc-52df-a671-6796ea08e690" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186294339} {:answer/id #uuid "2a4dd53b-c48e-5dad-815f-a941a41f4766" :answer/type {:db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186294340}] :answer-field/correct {:answer/id #uuid "5481ebe6-7afc-5959-b9ff-3ac4af78b201" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186294336} :answer-field/id #uuid "506d02c0-5619-5a27-a023-c555e254176f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294335}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "549da073-b722-5fcb-9360-923ddd086ff3" :question/math-academy-id "q-43780" :question/problem "Consider the vector space $C[-1,1]$ of all continuous functions $f:[-1,1]\\to R$ and its subset $A={f\\in C[-1,1]\\,|\\,f(1)\\le 0}.$ \n\nWhich of the following statements are true?\n\n- $A$ is closed under function addition\n- $A$ is closed under scalar multiplication\n- $A$ is a subspace of $C[-1,1]$\n- $A$ is **not** a subspace of $C[-1,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in A,$ then\n\n$$\n\\begin{aligned}(f+g)(1) & =f(1)+g(1)\\le 0\\end{aligned}\n$$\n\nSo, $A$ is closed under addition.\n\n- Statement II is false. For example, if $f(x)\\in A$ and $k=-1\\in R,$ then \n\n$$\n\\begin{aligned}f(1) & \\le 0 \\\\ kf(1) & \\ge k\\cdot 0 \\\\ (kf) & \\ge 0\\end{aligned}\n$$\n\nSo, $A$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $A$ is *not* a subspace because it's not closed under scalar multiplication.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186260869 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f10507d-8411-501b-bf2a-099f1599108a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294349} {:answer/id #uuid "6b40c74f-5636-54fa-8e48-1cc8dc48453b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294350} {:answer/id #uuid "a8890cb1-796d-5e73-9f8e-477954728915" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294351} {:answer/id #uuid "f886e3e2-bc69-5e9f-8cd6-9f9f6b4e1c40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294352} {:answer/id #uuid "ef9f71ba-6aae-578e-ae86-a1f2d811e951" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294353}] :answer-field/correct {:answer/id #uuid "6b40c74f-5636-54fa-8e48-1cc8dc48453b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186294350} :answer-field/id #uuid "0028443c-1e65-58fd-b318-c517c386e7d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294348}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8bb03c0c-2bf3-5dda-8102-58698d5cc17e" :question/math-academy-id "q-65502" :question/problem "$\\operatorname{cos}⁡(x+\\frac{2\\pi }{3})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{2\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{2\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{2\\pi }{3})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294354 :knowledge-point/_questions [{:knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf463b44-c338-5d2b-89e0-a6a466d2f78e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186294356} {:answer/id #uuid "f6e11bca-7e2b-5108-a443-68916723834e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186294357} {:answer/id #uuid "5b0196c7-8e6e-5b19-b105-23b10d835fb7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186294358} {:answer/id #uuid "8e897539-7b0f-5059-85f1-c18f0166caa0" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186294359} {:answer/id #uuid "96574573-9d53-57dc-b486-bd82c12e94f1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186294360}] :answer-field/correct {:answer/id #uuid "bf463b44-c338-5d2b-89e0-a6a466d2f78e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186294356} :answer-field/id #uuid "e101af72-681a-5404-804d-9c959a6f14f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294355}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b9625dd0-98eb-5747-8995-333316814407" :question/math-academy-id "q-71876" :question/problem "Consider the matrices\n\n$$\nC=[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,D=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,E=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & -2\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $CD=DC={I}_{3}$\n- $CE=EC={I}_{3}$\n- $D={C}^{-1}$" :question/worked-solution "- First, we check whether $CD=DC={I}_{3}.$ Computing $CD$, we get\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DC$, we get\n\n$$\n\\begin{aligned}DC & =[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -2 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}2 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true. As a result, $D={C}^{-1}$ and statement III is true too.\n\n- Now, we check whether $CE=EC={I}_{3}.$ Computing $CE$, we get\n\n$$\n\\begin{aligned}CE & =[\\begin{aligned}2 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & 3 & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186294386 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed317ee4-e207-50c2-ad9b-2c2bfc3ab6aa" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294388} {:answer/id #uuid "6bc81b8c-e28b-5f55-9962-a7fef63345d5" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294389} {:answer/id #uuid "7c725089-0910-595b-8d08-433b4fe7d09c" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294390} {:answer/id #uuid "81ed89c9-f756-51c7-889b-63626d2d16e1" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}4 \\\\ 0 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294391} {:answer/id #uuid "86c44b91-9a74-5cc5-9aaa-75da5bdf6946" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294392}] :answer-field/correct {:answer/id #uuid "6bc81b8c-e28b-5f55-9962-a7fef63345d5" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186294389} :answer-field/id #uuid "0b2f988c-6068-5c9e-b181-6bd27aa3a81a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294387}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e77266e3-e110-5646-9023-0f09c4f4c827" :question/math-academy-id "q-77433" :question/problem "Find a vector equation of the line that passes through the points $A(1,1,0)$ and $B(3,-1,2).$" :question/worked-solution "The vector equation of the straight line passing through $A$ and parallel to $v$ is given by\n\n$$\nr=a+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $a$ is the position vector of $A.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $A(1,1,0)$ and $B(3,-1,2)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{AB} \\\\  & =⟨3,-1,2⟩-⟨1,1,0⟩ \\\\  & =⟨2,-2,2⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261704 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f783fe8-8f52-5f93-adef-bf4bd030fea0" :knowledge-point/title "Writing the Equation of a Vertical Hyperbola in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3937a4c-857f-56da-93a2-afc158d08b89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{5}=1" :db/id #edb/ref 17592186294394} {:answer/id #uuid "10ee06aa-4179-587e-a705-928a9db9a24e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{10}-\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186294395} {:answer/id #uuid "788849cc-4ada-561e-bb97-b676702087d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{5}=1" :db/id #edb/ref 17592186294396} {:answer/id #uuid "b4be13f8-f674-5ab7-b854-f5fed230d0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{10}-\\frac{{x}^{2}}{8}=1" :db/id #edb/ref 17592186294397} {:answer/id #uuid "fc8d4d70-f021-5f45-a6e8-13c498e94d26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{12}=1" :db/id #edb/ref 17592186294398}] :answer-field/correct {:answer/id #uuid "b4be13f8-f674-5ab7-b854-f5fed230d0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{10}-\\frac{{x}^{2}}{8}=1" :db/id #edb/ref 17592186294397} :answer-field/id #uuid "07cffcbd-520f-501a-a932-dd6270e020d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294393}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fa7228ce-645a-52a8-9a40-e535c79572db" :question/math-academy-id "q-78257" :question/problem "Write the equation of the hyperbola $4{y}^{2}-5{x}^{2}=40$ in standard form." :question/worked-solution "The Cartesian equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $40$ and then simplify, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-5{x}^{2} & =40 \\\\ \\frac{4{y}^{2}}{40}-\\frac{5{x}^{2}}{40} & =\\frac{40}{40} \\\\ \\frac{{y}^{2}}{10}-\\frac{{x}^{2}}{8} & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294413 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c394f980-ab99-540e-bbbf-6ee9e03438a2" :answer/type {:db/ident :answer.type/math} :answer/value "{4,8}" :db/id #edb/ref 17592186294415} {:answer/id #uuid "ce5c09b4-4d46-5559-b9ec-ec713538fe22" :answer/type {:db/ident :answer.type/math} :answer/value "{4,12}" :db/id #edb/ref 17592186294416} {:answer/id #uuid "722c1b51-99fc-5a0f-9c45-026ba6f2e0ff" :answer/type {:db/ident :answer.type/math} :answer/value "{2,4,8,12}" :db/id #edb/ref 17592186294417} {:answer/id #uuid "064cf5f7-3c6f-5a67-8ace-d0b029af5d6e" :answer/type {:db/ident :answer.type/math} :answer/value "{4,8,12}" :db/id #edb/ref 17592186294418} {:answer/id #uuid "d6964215-98b3-59b2-9c5f-b58ada618e90" :answer/type {:db/ident :answer.type/math} :answer/value "{4,8,10,12}" :db/id #edb/ref 17592186294419}] :answer-field/correct {:answer/id #uuid "064cf5f7-3c6f-5a67-8ace-d0b029af5d6e" :answer/type {:db/ident :answer.type/math} :answer/value "{4,8,12}" :db/id #edb/ref 17592186294418} :answer-field/id #uuid "9849dc9d-cdf7-5cd6-9b8f-d1714b2f7f69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294414}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a0c292a3-44f7-5419-b7a7-a7561f0dc7c5" :question/math-academy-id "q-86590" :question/problem "If $U={2,4,6,8,10,12}$ is the universal set and $B={2,6,10},$ then the complement of $B$ is" :question/worked-solution "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $4,$ $8,$   and $12.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}={4,8,12}.\n$$"}]}
