#{[{:db/id #edb/ref 17592186357828 :knowledge-point/_questions [{:knowledge-point/id #uuid "164c56ea-afbb-5ce4-800a-19002695db76" :knowledge-point/title "Calculating the Determinant of the Inverse of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0937a2b-c2c9-5851-95f8-98906380fb1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{13}" :db/id #edb/ref 17592186357830} {:answer/id #uuid "6ef1e9d3-d0ca-5136-bfc7-7818d2922e72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186357831} {:answer/id #uuid "3af95393-2575-5229-bc05-c6f36fb0b54d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186357832} {:answer/id #uuid "8ce046a4-1ded-5ee3-8d1b-d7366349cab1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186357833} {:answer/id #uuid "62b29e01-141e-5f84-9c47-b2cfbf282d19" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{21}" :db/id #edb/ref 17592186357834}] :answer-field/correct {:answer/id #uuid "6ef1e9d3-d0ca-5136-bfc7-7818d2922e72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186357831} :answer-field/id #uuid "a8d9f240-e780-5c74-b003-2aa3f0d7d460" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357829}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87beaefa-a44a-5f78-b5fb-0779a6230df3" :question/math-academy-id "q-42579" :question/problem "Find $|{A}^{-1}|,$ if $A=[\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}.\n$$\n\nFirst, we find $|A|$ using a Laplace expansion across the $3$rd row:\n\n$$\n\\begin{aligned}|A| & =|\\begin{aligned}0 & 6 & -3 \\\\ -12 & -2 & 0 \\\\ 1 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}6 & -3 \\\\ -2 & 0\\end{aligned}| \\\\  & =1\\cdot (-6) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\n|{A}^{-1}|=\\frac{1}{|A|}=-\\frac{1}{6}.\n$$"}]}
