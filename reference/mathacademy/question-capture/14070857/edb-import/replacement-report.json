      "source": [
        {
          "question": "q-107499",
          "field": null,
          "attribute": "question/problem",
          "value": "Express $z=\\frac{6}{-1+\\text{i}}$ in the form $r(\\operatorname{cos}\u2061\\theta +\\text{i}\\operatorname{sin}\u2061\\theta ).$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070857/state.json",
          "file_sha256": "5ebff0ae9f8c47623e4802f97ee1132bab07a5e5ce80e5d3222ec19159d45b0c"
