#{[{:db/id #edb/ref 17592186286179 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b970a993-4dd7-5077-bd40-f3eea7ab77d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{\\sqrt{17}}" :db/id #edb/ref 17592186286181} {:answer/id #uuid "f79b299a-a62c-5734-b123-50d5b0a19877" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186286182} {:answer/id #uuid "94a9b2da-00bb-5415-a7f1-81a27d82e2ce" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186286183} {:answer/id #uuid "f64bfadb-f201-50df-99d5-50743d561f4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286184} {:answer/id #uuid "1e33324c-a04d-5d59-b54e-4c7a6c3fb8e6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286185}] :answer-field/correct {:answer/id #uuid "b970a993-4dd7-5077-bd40-f3eea7ab77d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{\\sqrt{17}}" :db/id #edb/ref 17592186286181} :answer-field/id #uuid "056fdb8b-3157-59bf-b774-31510302a367" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286180}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a3d78170-5413-5d4e-a05e-ea790601aa25" :question/math-academy-id "q-18372" :question/problem "Let $c=⟨-2,0,0⟩$ and $d=⟨4,-1,0⟩.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{-2\\cdot 4+0\\cdot (-1)+0\\cdot 0}{\\sqrt{{4}^{2}+(-1)^{2}+{0}^{2}}} \\\\  & =-\\frac{8}{\\sqrt{17}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286186 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c699610-261c-5695-b196-3999bf781137" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286188} {:answer/id #uuid "3f11c720-e046-523b-8dc7-c52f825eba0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186286189} {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} {:answer/id #uuid "ba533aff-71f4-54f1-a488-8e6bd6e66a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186286191} {:answer/id #uuid "08f2859a-5d24-534f-82e7-b3fbf2ac9ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186286192}] :answer-field/correct {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} :answer-field/id #uuid "c23d68cf-4f67-573a-91f0-15f4e696233a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286187}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26907092-d115-5133-80f7-1ed5a1bdc6ed" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106134 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c57ffadb-4b3c-5e37-a582-3db44c3f5be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186103037} {:answer/id #uuid "23135d70-addc-5580-aa35-c02c68832632" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186103038} {:answer/id #uuid "244f5799-8646-5b1f-b0d3-d3c608b45930" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186103039} {:answer/id #uuid "39e1f26d-f1c5-542c-a6da-ca05957526a6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186103040} {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041}] :answer-field/correct {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041} :answer-field/id #uuid "857c8ca0-e5aa-56ce-af4b-fdf9bb998e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106135 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9143160-2934-5cef-ac11-7c62b42f39c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103043} {:answer/id #uuid "119c5313-7f5d-5ae2-a4ac-505bbca01a8a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186103044} {:answer/id #uuid "182dbc78-8b38-5541-a6b1-c86433558d39" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186103045} {:answer/id #uuid "1d7bb2f4-47a5-5548-9222-efbe900113e4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186103046} {:answer/id #uuid "535b2f97-6cae-5cb3-81e4-441a18ee8a37" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186103047}] :answer-field/correct {:answer/id #uuid "b9143160-2934-5cef-ac11-7c62b42f39c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103043} :answer-field/id #uuid "1efc1294-ac3c-52e5-b063-84e288ec0e97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103042}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f961e7bf-40d0-5b4f-86c7-b36ac1e85bd7" :question/math-academy-id "q-236735" :question/problem "Let $p=[\\begin{aligned}6 \\\\ 1 \\\\ 4\\end{aligned}]$ and $q=[\\begin{aligned}x \\\\ 4 \\\\ -4\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =6\\cdot x+1\\cdot 4+4\\cdot (-4) \\\\  & =6x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 6x-12 & =0 \\\\ 6x & =12 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286193 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9598539e-b54f-5c35-85a9-860683f593e1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286195}] :answer-field/correct {:answer/id #uuid "9598539e-b54f-5c35-85a9-860683f593e1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286195} :answer-field/id #uuid "7c5e5c8a-f0ab-52e4-a5aa-56854d500dd5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286194}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b038fbb-5dcb-597f-a35d-5322f573b512" :question/math-academy-id "q-319254" :question/problem "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$"}]}
