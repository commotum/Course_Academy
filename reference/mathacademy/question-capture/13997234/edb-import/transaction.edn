48a493527f1d2597d9806fc1"] :db/ensure [:answer-field/validate]} {:db/id "q-7695" :question/id #uuid "6189d5b2-e730-510f-8ff2-a299b9f00af2" :question/math-academy-id "q-7695" :question/problem "Express $2{cos}^{2}⁡{45}^{∘}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={45}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡{45}^{∘}-1 & =\\operatorname{cos}⁡2\\cdot {45}^{∘} \\\\  & =\\operatorname{cos}⁡{90}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7695/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a"] :knowledge-point/questions ["q-7695"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-24490"] :question/problem "Express $2{cos}^{2}⁡(\\frac{5\\pi }{3})-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{5\\pi }{3}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡(\\frac{5\\pi }{3})-1 & =\\operatorname{cos}⁡(2\\cdot \\frac{5\\pi }{3}) \\\\  & =\\operatorname{cos}⁡(\\frac{10\\pi }{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-120368/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "545c32f4-aa0d-5a58-ad03-8edffa13c2fb" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120368/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "7aac7d05-6434-5150-a886-5b81ca843ca1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120368/selection/4bd87ad5cdff0b2