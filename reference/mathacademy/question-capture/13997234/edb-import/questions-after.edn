#{[{:db/id #edb/ref 17592186285525 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078182a3-5b36-5f05-ba4d-d66685f99765" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186285527} {:answer/id #uuid "23339694-d9dd-583b-8e5f-e748ee848d75" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186285528} {:answer/id #uuid "51a68f01-b318-50ea-9337-920c5fb17fb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186285529} {:answer/id #uuid "545c32f4-aa0d-5a58-ad03-8edffa13c2fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285530} {:answer/id #uuid "7aac7d05-6434-5150-a886-5b81ca843ca1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285531}] :answer-field/correct {:answer/id #uuid "7aac7d05-6434-5150-a886-5b81ca843ca1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285531} :answer-field/id #uuid "421c9066-75cb-54dd-a87f-93679d69e2b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285526}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f9bd09a0-a911-50dc-ada5-7f99cf3ac934" :question/math-academy-id "q-120368" :question/problem "Find the exact value of ${cos}^{2}⁡{165}^{∘}-{sin}^{2}⁡{165}^{∘}.$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={165}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡{165}^{∘}-{sin}^{2}⁡{165}^{∘} & =\\operatorname{cos}⁡(2\\cdot {165}^{∘}) \\\\  & =\\operatorname{cos}⁡{330}^{∘} \\\\  & =\\operatorname{cos}⁡{30}^{∘} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088040 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b97889f6-ed51-5871-91d6-48f9e7cbb724" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{7π}{3})" :db/id #edb/ref 17592186085178} {:answer/id #uuid "c818f6c8-1f1e-5cde-9803-c3c99d3fcdfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{3π}{2})" :db/id #edb/ref 17592186085179} {:answer/id #uuid "0c6e05e3-b592-5ffb-b4f6-35ca97355c89" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{5π}{3})" :db/id #edb/ref 17592186085180} {:answer/id #uuid "63544bc1-d0cb-57e9-9f34-e141a1929386" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{5π}{2})" :db/id #edb/ref 17592186085181} {:answer/id #uuid "6ff98027-7514-52ce-b5ff-ae6ffa11918a" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{10π}{3})" :db/id #edb/ref 17592186085182}] :answer-field/correct {:answer/id #uuid "6ff98027-7514-52ce-b5ff-ae6ffa11918a" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{10π}{3})" :db/id #edb/ref 17592186085182} :answer-field/id #uuid "14797725-71e3-5c1e-9c96-d9d241d60871" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085177}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a18ec028-af86-5940-bde5-98a13535f55f" :question/math-academy-id "q-24490" :question/problem "Express $2{cos}^{2}⁡(\\frac{5\\pi }{3})-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{5\\pi }{3}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡(\\frac{5\\pi }{3})-1 & =\\operatorname{cos}⁡(2\\cdot \\frac{5\\pi }{3}) \\\\  & =\\operatorname{cos}⁡(\\frac{10\\pi }{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285532 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cab7834-6e8f-57ef-bacd-8e43fd0320e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186285534} {:answer/id #uuid "46fb4a9c-5873-545c-a34d-b7e796bb3956" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186285535}] :answer-field/correct {:answer/id #uuid "46fb4a9c-5873-545c-a34d-b7e796bb3956" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186285535} :answer-field/id #uuid "06816d7f-60c7-52ec-bcb9-c62d20edf5e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285533}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "db3cb6f0-7b3b-594b-92f6-3d97fd7b37dc" :question/math-academy-id "q-275706" :question/problem "Find the **exact** value of the expression below.\n\n${cos}^{4}⁡({15}^{∘})-2{cos}^{2}⁡({15}^{∘}){sin}^{2}⁡({15}^{∘})+{sin}^{4}⁡({15}^{∘})=$\n{{field-1}}" :question/worked-solution "First, notice that our expression is a perfect square that can be rewritten as follows:\n\n$$\n\\begin{aligned}{cos}^{4}⁡({15}^{∘})-2{cos}^{2}⁡({15}^{∘}){sin}^{2}⁡({15}^{∘})+{sin}^{4}⁡({15}^{∘}) & ={({cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}))}^{2}\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={15}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {15}^{∘}) \\\\  & =\\operatorname{cos}⁡({30}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{({cos}^{2}⁡({15}^{∘})-{sin}^{2}⁡({15}^{∘}))}^{2} & ={(\\frac{\\sqrt{3}}{2})}^{2}=\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285536 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c397dc45-d133-5b1d-9f07-3a73216de451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186285538}] :answer-field/correct {:answer/id #uuid "c397dc45-d133-5b1d-9f07-3a73216de451" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186285538} :answer-field/id #uuid "7ffa1b88-eae6-5a01-a4be-ccf6bf9aca8e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285537}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "24f718af-64bf-56f7-87f4-05511c65897e" :question/math-academy-id "q-332148" :question/problem "Find the **exact** value of the expression below.\n\n${cos}^{4}⁡({67.5}^{∘})-2{cos}^{2}⁡({67.5}^{∘}){sin}^{2}⁡({67.5}^{∘})+{sin}^{4}⁡({67.5}^{∘})=$\n{{field-1}}" :question/worked-solution "First, notice that our expression is a perfect square that can be rewritten as follows:\n\n$$\n\\begin{aligned}{cos}^{4}⁡({67.5}^{∘})-2{cos}^{2}⁡({67.5}^{∘}){sin}^{2}⁡({67.5}^{∘})+{sin}^{4}⁡({67.5}^{∘}) & ={({cos}^{2}⁡({67.5}^{∘})-{sin}^{2}⁡({67.5}^{∘}))}^{2}\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={67.5}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡({67.5}^{∘})-{sin}^{2}⁡({67.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {67.5}^{∘}) \\\\  & =\\operatorname{cos}⁡({135}^{∘}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{({cos}^{2}⁡({67.5}^{∘})-{sin}^{2}⁡({67.5}^{∘}))}^{2} & ={(-\\frac{\\sqrt{2}}{2})}^{2}=\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285539 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d82bbf7-1632-565b-937f-4a7d0f7a5200" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{45}^{∘}\\operatorname{cos}⁡{45}^{∘}" :db/id #edb/ref 17592186285541} {:answer/id #uuid "8e5bf442-899d-57d7-895f-daa985ff1dc3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{45}^{∘}\\operatorname{cos}⁡{45}^{∘}" :db/id #edb/ref 17592186285542} {:answer/id #uuid "989cf1c2-7cf6-5356-a607-dc9711760275" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{90}^{∘}" :db/id #edb/ref 17592186285543} {:answer/id #uuid "d4dcb664-9921-5f3e-b41c-832475188909" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{90}^{∘}" :db/id #edb/ref 17592186285544} {:answer/id #uuid "deac0960-4116-5dc4-9d98-06fe0ff33121" :answer/type {:db/ident :answer.type/math} :answer/value "2{cos}^{2}⁡{90}^{∘}" :db/id #edb/ref 17592186285545}] :answer-field/correct {:answer/id #uuid "d4dcb664-9921-5f3e-b41c-832475188909" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{90}^{∘}" :db/id #edb/ref 17592186285544} :answer-field/id #uuid "d36ce37b-947f-568e-b45b-718ea07a6a64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285540}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6189d5b2-e730-510f-8ff2-a299b9f00af2" :question/math-academy-id "q-7695" :question/problem "Express $2{cos}^{2}⁡{45}^{∘}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={45}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡{45}^{∘}-1 & =\\operatorname{cos}⁡2\\cdot {45}^{∘} \\\\  & =\\operatorname{cos}⁡{90}^{∘}.\\end{aligned}\n$$"}]}
