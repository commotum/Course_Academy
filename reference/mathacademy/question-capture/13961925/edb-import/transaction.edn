ame{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{sec}⁡\\theta \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119906/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35fe6748-f040-5318-84e0-f3f76c9c7250"] :knowledge-point/questions ["q-119906"] :db/ensure [:knowledge-point/validate]} {:db/id "q-23849/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "64c35499-929c-5cdd-8109-9f707a5fc9ae" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-23849/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "25002b55-54e3-5aa6-9e2c-9ae47756afd0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-23849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3c88912e-fce0-5f78-944c-1bcab295d106" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-23849/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "f84606ba-e376-5b29-b2eb-c55c4596dc67" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-23849/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9ce47549-1158-5b52-b608-a338c01e5b15" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-23849/selection" :answer-field/id #uuid "6cd3b6c2-b555-5aab-80db-6caaa2665929" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-23849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-23849/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-23849/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-23849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-23849/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-23849/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-23849" :question/id #uuid "3af4bdea-2cb0-5697-9158-3118d7b94c96" :question/math-academy-id "q-23849" :question/problem "Simplify $\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x$" :question/worked-solution "First, we operate the first two terms, as follows:\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x & =\\frac{({cot}^{2}⁡x-{csc}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡x-{cot}^{2}⁡x=1,$ we get\n\n$$\n\\begin{aligned}\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x & =\\frac{-1}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =-{sin}^{2}⁡x+{sin}^{2}⁡x \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-23849/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77"] :knowledge-point/questions ["q-23849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65445/selection/b45554d519f71ea942fbcdd4a6aa18d9f7584a6d06e3b0f800b4277d93abc2f0" :answer/id #uuid "4bcff514-fa8c-58b7-bc6a-3b0a9652d628" :answer/type :answer.type/math :answer/value "3{sin}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65445/selection/961e6c26a3930850ad6ac8329a88a3928f75499547a7df98c65a4cdca366e99a" :answer/id #uuid "d1e4a2cb-249d-509e-aac8-5f06749b1506" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡2\\theta " :db/ensure [:answer/validate]} {:db/id "q-65445/selection/b965b4e33dd4914cb5b8abf92b9e540d2ee02203e76a859b1e352066326ec60b" :answer/id #uuid "9233093c-de2f-5a90-8ef4