[{:db/id [:question/math-academy-id "q-23602"] :question/worked-solution "Using the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ we rewrite and simplify the expression as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{csc}⁡\\theta \\cdot \\operatorname{cot}⁡\\theta }{1+{cot}^{2}⁡\\theta } & =\\frac{\\operatorname{csc}⁡\\theta \\cdot \\operatorname{cot}⁡\\theta }{{csc}^{2}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{csc}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-119914"] :question/worked-solution "Using the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}\\frac{{csc}^{2}⁡\\theta }{\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta  & =\\frac{{csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{cot}⁡\\theta } \\\\  & =\\frac{1+{cot}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{cot}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{cot}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-119904/selection/76815587d2b008780a444f9bb43c61b4d006ccc341ed597837ad3075cd26bb8e" :answer/id #uuid "e7f6294f-5cf5-5e00-b0e9-674d048ec756" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡z" :db/ensure [:answer/validate]} {:db/id "q-119904/selection/51557fdf9ab16863815b76fcbe467deaf47a2d24fca47a71b1922f916ba03b62" :answer/id #uuid "ce114f73-29a6-54f2-b25f-12e0bd655a58" :answer/type :answer.type/math :answer/value "-{cot}^{2}⁡z" :db/ensure [:answer/validate]} {:db/id "q-119904/selection/aae5d3ab216a2a006b85642dd8545ce26457b27a8128efe841a91ff415d23b26" :answer/id #uuid "ffd304f0-487d-545e-ac7e-35fef5375b5c" :answer/type :answer.type/ma