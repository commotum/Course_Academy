n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74579/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85555bce-debf-5165-ba6a-3c232deeeb0a"] :knowledge-point/questions ["q-74579"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65446/selection/8df822cbd4727d56fa250923586bf2f014b97e619074daebdec15a57d04c2fdb" :answer/id #uuid "ab690828-8f48-56a0-a5cb-8f6961a7714f" :answer/type :answer.type/math :answer/value "3{cot}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65446/selection/75692e2af5f10c8a5a9cd964ba7987d08d791913525c7c2f6c47e226c666ec46" :answer/id #uuid "5baa68ad-b209-5095-ba8b-9095a58fca5a" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65446/selection/82c45f4df2439620e53b221a8cd624df48d9a9a6f528bc089ec82dd3f3a9dba5" :answer/id #uuid "5f5ddaa7-989e-5f37-8dcb-5d6bddc8b781" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-65446/selection/2fdfa21eb6897b5f6f45ecbe5bf4df20f452c919de4ced82596fb560f2bb2963" :answer/id #uuid "44477460-07ab-5750-bfe7-1054d151d9f6" :answer/type :answer.type/math :answer/value "2\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65446/selection/0ecd8130b3138cc0d0b6f7dcff937e8b23344457055155bb5dd25cda061cdc23" :answer/id #uuid "c694f929-31f0-5cf9-bcec-ce8d98f88416" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65446/selection" :answer-field/id #uuid "88d4cb5c-8188-5525-8314-b4b929de9e82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65446/selection/0ecd8130b3138cc0d0b6f7dcff937e8b23344457055155bb5dd25cda061cdc23" :answer-field/choices ["q-65446/selection/8df822cbd4727d56fa250923586bf2f014b97e619074daebdec15a57d04c2fdb" "q-65446/selection/75692e2af5f10c8a5a9cd964ba7987d08d791913525c7c2f6c47e226c666ec46" "q-65446/selection/82c45f4df2439620e53b221a8cd624df48d9a9a6f528bc089ec82dd3f3a9dba5" "q-65446/selection/2fdfa21eb6897b5f6f45ecbe5bf4df20f452c919de4ced82596fb560f2bb2963" "q-65446/selection/0ecd8130b3138cc0d0b6f7dcff937e8b23344457055155bb5dd25cda061cdc23"] :db/ensure [:answer-field/validate]} {:db/id "q-65446" :question/id #uuid "918e6995-ee59-5fed-9571-6d5d741aef1e" :question/math-academy-id "q-65446" :question/problem "Simplify $\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta .$" :question/worked-solution "First, let's recall the following identity: \n\n$$\n1={csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  & =\\frac{{csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )\\,(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{csc}⁡\\theta  \\\\  & =\\frac{\\cancel{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )}\\,(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )}{\\cancel{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }}-\\operatorname{csc}⁡\\theta  \\\\  & =\\cancel{\\operatorname{csc}⁡\\theta }+\\operatorname{cot}⁡\\theta -\\cancel{\\operatorname{csc}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65446/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85555bce-debf-5165-ba6a-3c232deeeb0a"] :knowledge-point/questions ["q-65446"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74578/sel