eta } \\\\  & =\\cancel{{cos}^{2}⁡\\theta }\\cdot \\frac{{sin}^{2}⁡\\theta }{\\cancel{{cos}^{2}⁡\\theta }} \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65445/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77"] :knowledge-point/questions ["q-65445"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65518/selection/30b0ea1e04fd80e15224ff2c947861bdee85317bf4fde3595fa57223b09f7c30" :answer/id #uuid "69b27719-ff44-59ff-9ac0-d64dcd71aa79" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65518/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" :answer/id #uuid "f9db9f1e-9cf5-59a5-b0a9-7bee506d42b1" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65518/selection/fbec4adffb32635c006c882e5ddfbea882226e90411fcf93403e2867b52e366b" :answer/id #uuid "7e95a24e-ba01-580f-a2e5-6b3a93e905ac" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta -1" :db/ensure [:answer/validate]} {:db/id "q-65518/selection/beadb06c20d282e2d21fa83dbc2edfd09ae5888b2e7dcdce84c986f43d29ee97" :answer/id #uuid "9b6ea390-db10-5c1f-abd8-3fe5e13ff539" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65518/selection/56d3e2d9ecc1f1d072e47e1255f2e8d81eeb08431138076d82a992b5467a6dcf" :answer/id #uuid "0f579bdb-b9f4-578b-871d-f7bd553664ca" :answer/type :answer.type/math :answer/value "1+\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65518/selection" :answer-field/id #uuid "f5398ef7-22cf-5fc8-b8e4-5485f18d4005" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65518/selection/56d3e2d9ecc1f1d072e47e1255f2e8d81eeb08431138076d82a992b5467a6dcf" :answer-field/choices ["q-65518/selection/30b0ea1e04fd80e15224ff2c947861bdee85317bf4fde3595fa57223b09f7c30" "q-65518/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" "q-65518/selection/fbec4adffb32635c006c882e5ddfbea882226e90411fcf93403e2867b52e366b" "q-65518/selection/beadb06c20d282e2d21fa83dbc2edfd09ae5888b2e7dcdce84c986f43d29ee97" "q-65518/selection/56d3e2d9ecc1f1d072e47e1255f2e8d81eeb08431138076d82a992b5467a6dcf"] :db/ensure [:answer-field/validate]} {:db/id "q-65518" :question/id #uuid "64b79972-307d-573c-b12c-d167479196b5" :question/math-academy-id "q-65518" :question/problem "Simplify $\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}.$" :question/worked-solution "First, we multiply the numerator and the denominator of our expression by $\\operatorname{csc}⁡\\theta +1.$ This gives:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1} & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}\\cdot \\frac{\\operatorname{csc}⁡\\theta +1}{\\operatorname{csc}⁡\\theta +1} \\\\  & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{csc}^{2}⁡\\theta -1}\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta $, we have\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{csc}^{2}⁡\\theta -1} & =\\frac{\\operatorname{cos}⁡\\theta \\,\\operatorname{cot}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1)}{{cot}^{2}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta \\,\\cancel{\\operatorname{cot}⁡\\theta }\\,(\\operatorname{csc}⁡\\theta +1)}{\\cancel{\\operatorname{cot}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\,\\operatorname{tan}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\cancel{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }}\\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\operatorname{sin}⁡\\theta \\,(\\operatorname{csc}⁡\\theta +1) \\\\  & =\\operatorname{sin}⁡\\theta \\,\\operatorname{csc}⁡\\theta +\\operatorname{sin}⁡\\theta  \\\\  & =\\cancel{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{\\cancel{\\operatorname{sin}⁡\\theta }}+\\operatorname{sin}⁡\\theta  \\\\  & =1+\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65518/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77"] :knowledge-point/questions ["q-65518"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-65444"] :question/worked-solution "First, let's recall the following identity:\n\n$$\n{csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cot}⁡\\theta }{{csc}^{2}⁡\\theta -1} & =\\frac{\\operatorname{cot}⁡\\theta }{{cot}^{2}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{cot}⁡x} \\\\  & =\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-43295/selection/2fdfa21eb6897b5f6f45ecbe5bf4df20f452c919de4ced82596fb560f2bb2963" :answer/id #uuid "5d4e075b-fa47-572a-8a32-905cb34f3778" :answer/type :answer.type/math :answer/value "2\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-43295/selection/75692e2af5f10c8a5a9cd964ba7987d08d791913525c7c2f6c47e226c666ec46" :answer/id #uuid "3b4e1f71-65b4-565e-aa40-263a9644922b" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-43295/selection/c05b01cfb3dac37af09abbc6363e7eaf120dafb4773526011cce4ce3c014eec2" :answer/id #uuid "a1014752-47fe-57cf-a324-9a8ebbb6288e" :answer/type :answer.type/math :answer/value "1+\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-43295/selection/1af7e13befc2d99c990cb25ccaed11b73211adacccdeb3d96a12ee4830dd54b2" :answer/id #uuid "ac91297b-638d-581a-bdca-96a2e2ce33c9" :answer/type :answer.type/math :answer/value "2{tan}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-43295/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6fe00325-39e6-5225-830b-87ce3bc5ac77" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-43295/selection" :answer-field/id #uuid "98aa8544-a7bd-53de-87cb-280e74bf5fbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-43295/selection/1af7e13befc2d99c990cb25ccaed11b73211adacccdeb3d96a12ee4830dd54b2" :answer-field/choices ["q-43295/selection/2fdfa21eb6897b5f6f45ecbe5bf4df20f452c919de4ced82596fb560f2bb2963" "q-43295/selection/75692e2af5f10c8a5a9cd964ba7987d08d791913525c7c2f6c47e226c666ec46" "q-43295/selection/c05b01cfb3dac37af09abbc6363e7eaf120dafb4773526011cce4ce3c014eec2" "q-43295/selection/1af7e13befc2d99c990cb25ccaed11b73211adacccdeb3d96a12ee4830dd54b2" "q-43295/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-43295" :question/id #uuid "aad44bd9-8533-589f-aaf2-4a6104582560" :question/math-academy-id "q-43295" :question/problem "Simplify $\\frac{1}{\\operatorname{csc}⁡\\theta -1}-\\frac{1}{\\operatorname{csc}⁡\\theta +1}.$" :question/worked-solution "First, we put both fractions over a common denominator and then subtract, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{csc}⁡\\theta -1}-\\frac{1}{\\operatorname{csc}⁡\\theta +1} & =\\frac{1\\cdot (\\operatorname{csc}⁡\\theta +1)}{(\\operatorname{csc}⁡\\theta -1)(\\operatorname{csc}⁡\\theta +1)}-\\frac{1\\cdot (\\operatorname{csc}⁡\\theta -1)}{(\\operatorname{csc}⁡\\theta -1)(\\operatorname{csc}⁡\\theta +1)} \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +1)-(\\operatorname{csc}⁡\\theta -1)}{(\\operatorname{csc}⁡\\theta -1)(\\operatorname{csc}⁡\\theta +1)} \\\\  & =\\frac{\\operatorname{csc}⁡\\theta +1-\\operatorname{csc}⁡\\theta +1}{{csc}^{2}⁡\\theta -1} \\\\  & =\\frac{2}{{csc}^{2}⁡\\theta -1}\\end{aligned}\n$$\n\nUsing the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta ,$ we get\n\n$$\n\\begin{aligned}\\frac{2}{{csc}^{2}⁡\\theta -1} & =\\frac{2}{{cot}^{2}⁡\\theta } \\\\  & =2{tan}^{2}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{\\operatorname{csc}⁡\\theta -1}-\\frac{1}{\\operatorname{csc}⁡\\theta +1}=2{tan}^{2}⁡\\theta .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-43295/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77"] :knowledge-point/questions ["q-43295"] :db/ensure [:knowledge-point/validate]} {:db/id "q-23640/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "4bf5c794-c5a3-55b4-9ab3-851f8f5751b1" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-23640/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b4079ee3-160b-56c6-9c33-ec99badfdcc9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-23640/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "d6bfb860-ebb4-536b-afaa-18f66ddf6ec2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-23640/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "102d98fd-beb8-5901-870e-cbad5c9e5770" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-23640/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "6049