nswer-field/validate]} {:db/id "q-74578" :question/id #uuid "28ab0bc2-3182-58ae-9697-0d8f59949971" :question/math-academy-id "q-74578" :question/problem "Simplify $\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta .$" :question/worked-solution "First, let's recall the following identity: \n\n$$\n1={csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta  & =\\frac{{csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )\\,\\cancel{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )}}{\\cancel{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }}-\\operatorname{cot}⁡\\theta  \\\\  & =(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74578/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85555bce-debf-5165-ba6a-3c232deeeb0a"] :knowledge-point/questions ["q-74578"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74580/selection/7b81ce0473ebb61bc14d5edf328c6224ac91aadce4be353e903488828ed6b7a4" :answer/id #uuid "020ef4a0-3672-52b7-81af-1346c378c87d" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\operatorname{csc}⁡\\theta +1}" :db/ensure [:answer/validate]} {:db/id "q-74580/selection/df05b8d27d9c0a7a645f37230da65c178cb17ed438d417ca806b382f5b6910bc" :answer/id #uuid "868a0761-f4bf-59ba-891b-4e0d723b4dcb" :answer/type :answer.type/math :answer/value "-\\frac{1}{\\operatorname{csc}⁡\\theta +2}" :db/ensure [:answer/validate]} {:db/id "q-7