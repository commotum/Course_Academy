\\theta -\\frac{1}{{cot}^{2}⁡\\theta } & ={tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nNow, we factor out ${tan}^{2}⁡\\theta $ and use the identity \n${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta .$\nThis gives\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta  & ={tan}^{2}⁡\\theta \\,({csc}^{2}⁡\\theta -1) \\\\  & ={tan}^{2}⁡\\theta \\,{cot}^{2}⁡\\theta  \\\\  & ={tan}^{2}⁡\\theta \\cdot \\frac{1}{{tan}^{2}⁡\\theta } \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-23898/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d012a04e-f802-5a26-b900-0801427073d8"] :knowledge-point/questions ["q-23898"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65457/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "044bb353-1f2a-5ac8-bb34-5b66c6f71314" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-65457/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "81db3669-de89-5a1e-890b-409e69134b4d" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-65457/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "2d36e5ff-cd6a-5b5c-8ae4-983ca50fbd7f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-65457/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "548474f7-d9c6-5c86-8950-91f6db6e9dea" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-65457/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "02ffc45f-d319-5078-9d34-f03f958c9b80" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-65457/selection" :answer