#{[{:db/id #edb/ref 17592186303850 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84d78aa0-b6ec-553b-82a1-412fa0407777" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186303852} {:answer/id #uuid "a0355a81-9cb0-5381-8817-9e61f963e94a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186303853} {:answer/id #uuid "c8517b9d-cb03-5233-bae1-ddec7f803455" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186303854} {:answer/id #uuid "ad8c0bfb-c570-56df-abe4-7d63bcedb5b7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186303855} {:answer/id #uuid "9de1b6e4-ab5f-5e3f-bffa-3c85aa9ec6b7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186303856}] :answer-field/correct {:answer/id #uuid "ad8c0bfb-c570-56df-abe4-7d63bcedb5b7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186303855} :answer-field/id #uuid "92d1386b-d3db-590b-801c-7530ed893c12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303851}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "69a37f15-9ffb-5f60-8272-1cb813acb27b" :question/math-academy-id "q-10830" :question/problem "Find where the tangent to the curve $y=4\\sqrt{x}-4x$ at  $(1,0)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=4\\sqrt{x}-4x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}-4x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{1/2}-4x) \\\\  & =2{x}^{-1/2}-4\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(1)=2(1)^{-1/2}-4=-2.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(0) & =-2(x-1) \\\\ y & =-2x+2-0 \\\\ y & =-2x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =-2(0)+2=2.\\end{aligned}\n$$\n\nTherefore, the intersection point is $(0,2).$"}] [{:db/id #edb/ref 17592186092453 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b182a43f-8039-5e2e-884d-25553f97a21a" :answer/type {:db/ident :answer.type/math} :answer/value "y =-13x + 16" :db/id #edb/ref 17592186089155} {:answer/id #uuid "b392a0a1-c4df-5191-bc29-8821739aef3f" :answer/type {:db/ident :answer.type/math} :answer/value "y = 13x" :db/id #edb/ref 17592186089156} {:answer/id #uuid "ee940d3b-f3f7-5cac-8d8d-896284117e47" :answer/type {:db/ident :answer.type/math} :answer/value "y =-13x" :db/id #edb/ref 17592186089157} {:answer/id #uuid "038180f2-df92-524f-bd88-801184e00ca4" :answer/type {:db/ident :answer.type/math} :answer/value "y =-13x - 16" :db/id #edb/ref 17592186089158} {:answer/id #uuid "311cf5ee-3800-5273-84ff-042b3508078f" :answer/type {:db/ident :answer.type/math} :answer/value "y = 13x + 16" :db/id #edb/ref 17592186089159}] :answer-field/correct {:answer/id #uuid "b182a43f-8039-5e2e-884d-25553f97a21a" :answer/type {:db/ident :answer.type/math} :answer/value "y =-13x + 16" :db/id #edb/ref 17592186089155} :answer-field/id #uuid "11386249-c579-5667-9c32-d3c5b004a4c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089154}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6a853078-a18d-5836-8fe8-22fab4093858" :question/math-academy-id "q-10832" :question/problem "Find the equation of the tangent to the curve $y=\\frac{4}{{x}^{3}}-x$ at the point $(1,3).$" :question/requires-calculator false :question/worked-solution "Let $f(x)=\\frac{4}{{x}^{3}}-x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-12{x}^{-4}-1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-12(1)^{-4}-1=-13.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-13$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =-13(x-1) \\\\ y & =-13x+13+3 \\\\ y & =-13x+16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303857 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "603c4794-acf6-5532-8946-c429a61b215f" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186303859}] :answer-field/correct {:answer/id #uuid "603c4794-acf6-5532-8946-c429a61b215f" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186303859} :answer-field/id #uuid "80e66cda-021b-5e9c-8a7c-557c0808ab21" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303858}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53f492bb-7406-5e44-8b31-b4ebc75fe4ea" :question/math-academy-id "q-304068" :question/problem "Find the equation of the tangent to the curve $y=\\frac{3x+2}{{x}^{2}}$ at the point $(-1,-1).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{3x+2}{{x}^{2}}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3x+2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x}+\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{x})+\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2}) \\\\  & =-3{x}^{-2}-4{x}^{-3} \\\\  & =-\\frac{3}{{x}^{2}}-\\frac{4}{{x}^{3}}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-\\frac{3}{(-1)^{2}}-\\frac{4}{(-1)^{3}} \\\\  & =-3+4 \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=1$ and the coordinates of our point $(-1,-1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =1\\cdot (x-(-1)) \\\\ y+1 & =x+1 \\\\ y & =x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303860 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb0c79ba-e8ce-57c8-b48e-156e9659f61e" :answer/type {:db/ident :answer.type/math} :answer/value "-x+2" :db/id #edb/ref 17592186303862} {:answer/id #uuid "c5f596cf-8d6b-5f5d-8b56-584603f8a7e2" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186303863}] :answer-field/correct {:answer/id #uuid "cb0c79ba-e8ce-57c8-b48e-156e9659f61e" :answer/type {:db/ident :answer.type/math} :answer/value "-x+2" :db/id #edb/ref 17592186303862} :answer-field/id #uuid "cacdcdca-e5f1-5aac-b5df-1c81368c6246" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303861}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cc861208-317d-5f52-876e-9120cd395379" :question/math-academy-id "q-342350" :question/problem "Find the equation of the tangent to the curve $y=2x-{x}^{3}$ at the point  $(1,1).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2x-{x}^{3}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-{x}^{3}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\  & =2-3{x}^{2}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n{f}^{′}(1)=2-3({1}^{2})=-1.\n$$\n\nFinally, we use the point-slope form with $m=-1$ and the coordinates of our point $(1,1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =(-1)(x-1) \\\\ y & =-x+1+1 \\\\ y & =-x+2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303864 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e4e9bd3-e3d7-5a1f-b061-65486a1909de" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186303866}] :answer-field/correct {:answer/id #uuid "2e4e9bd3-e3d7-5a1f-b061-65486a1909de" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186303866} :answer-field/id #uuid "334e1ada-a5bf-5543-9127-2d44edd54566" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303865} {:answer-field/choices [{:answer/id #uuid "cee10ea5-03a7-5e90-8e4e-1928cf60a28b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186303868}] :answer-field/correct {:answer/id #uuid "cee10ea5-03a7-5e90-8e4e-1928cf60a28b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186303868} :answer-field/id #uuid "96d62782-6a12-5def-8080-7694a83e3d13" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303867}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "98faba34-f4b8-5f9c-951f-5cba695daf64" :question/math-academy-id "q-342380" :question/problem "Find where the tangent to the curve $y=-2\\sqrt{x}$ at the point  $(4,-4)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=-2\\sqrt{x}.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2\\sqrt{x}) \\\\  & =-2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}) \\\\  & =-2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =-2\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =-\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(4) \\\\  & =-\\frac{1}{\\sqrt{4}} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-4) & =-\\frac{1}{2}(x-4) \\\\ y+4 & =-\\frac{1}{2}x+2 \\\\ y & =-\\frac{1}{2}x+2-4 \\\\ y & =-\\frac{1}{2}x-2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}(0)-2 \\\\ y & =-2\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,-2).$"}]}
