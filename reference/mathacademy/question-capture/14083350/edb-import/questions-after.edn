ed}5 \\\\ 2 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387775} {:answer/id #uuid "29148bc5-eb99-54e3-8c10-3ea2fc56865a" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186387776} {:answer/id #uuid "5e41430e-b405-5398-8527-1397da1f8de7" :answer/type {:db/ident :answer.type/math} :answer/value "r=t[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387777} {:answer/id #uuid "1d12443a-18ab-5a99-ad50-eedd0171bb54" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387778} {:answer/id #uuid "cb16ef5d-ed39-531c-8d05-b16403f861bf" :answer/type {:db/ident :answer.type/math} :answer/value "r=t[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387779}] :answer-field/correct {:answer/id #uuid "1d12443a-18ab-5a99-ad50-eedd0171bb54" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387778} :answer-field/id #uuid "301c524d-16a8-503a-a003-0dbaa3730c7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387774}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3dacafdb-011f-54f0-a298-6898aeb88caa" :question/math-academy-id "q-22288" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=5 \\\\ y=2+3t \\\\ z=-t\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" :question/worked-solution "These parametric equations are equivalent to\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 2+3t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+[\\begin{aligned}0 \\\\ 3t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ r & =[\\begin{aligned}5 \\\\ 2 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186314807 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de" :knowledge-point/title "Finding a Vector Parallel To a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329c241f-0d93-5f7f-8960-fd8b6d634cf1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314809} {:answer/id #uuid "156453ff-6483-5567-8cba-b2845dd6a48d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314810} {:answer/id #uuid "e29dbda6-f364-588c-9e00-f11da1bf3f40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314811} {:answer/id #uuid "5b12767e-c18b-54c4-a4ba-cb0bacd89255" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314812} {:answer/id #uuid "8b2472f9-1cff-5da2-877c-22cf92446010" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186314813}] :answer-field/correct {:answer/id #uuid "e29dbda6-f364-588c-9e00-f11da1bf3f40" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186314811} :answer-field/id #uuid "d429ff55-de2b-5d12-a616-8527bdc051ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314808}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ff24dde6-0a9a-5793-9f5c-5477e633ad31" :question/math-academy-id "q-22301" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=1+3t \\\\ y=2-4t \\\\ z=2+t\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1+3t \\\\ 2-4t \\\\ 2+t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ -4t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}] \\\\ r & =[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the line passes through the point $(1,2,2)$ and is parallel to the vector $v=[\\begin{aligned}3 \\\\ -4 \\\\ 1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186387780 :knowledge-point/_questions [{:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb736d5-4ee6-54f6-92e0-1136ec9ff04b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+4t \\\\ y=1-3t \\\\ z=4-2t\\end{aligned}" :db/id #edb/ref 17592186387782} {:answer/id #uuid "a07b7d01-5d3a-532c-a6d6-b9281bd12c46" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3-t \\\\ y=-2+t \\\\ z=2+4t\\end{aligned}" :db/id #edb/ref 17592186387783} {:answer/id #uuid "128d5034-e0c2-5845-ae18-217aab8c5d37" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=4t \\\\ y=-3t \\\\ z=-2t\\end{aligned}" :db/id #edb/ref 17592186387784} {:answer/id #uuid "1cf71475-10ef-58d9-a904-3efaf21c6342" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=4-t \\\\ y=-3+t \\\\ z=-2+4t\\end{aligned}" :db/id #edb/ref 17592186387785} {:answer/id #uuid "e67ef017-43ed-50d0-8648-9039c2e58a87" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-t \\\\ y=t \\\\ z=4t\\end{aligned}" :db/id #edb/ref 17592186387786}] :answer-field/correct {:answer/id #uuid "7bb736d5-4ee6-54f6-92e0-1136ec9ff04b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+4t \\\\ y=1-3t \\\\ z=4-2t\\end{aligned}" :db/id #edb/ref 17592186387782} :answer-field/id #uuid "0bafd216-e43d-5548-ad04-f497cd97ef6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387781}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9348a1-38e3-553c-a088-0bd9bfbd914c" :question/math-academy-id "q-22318" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/58076d96d149ff4521103fd15c7187bc1a58595ab20f28be92be0f79385aee61.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,1,4)$ and $Q(3,-2,2).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$,  as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ -3 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}]+[\\begin{aligned}4t \\\\ -3t \\\\ -2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+4t \\\\ 1-3t \\\\ 4-2t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=-1+4t \\\\ y=1-3t \\\\ z=4-2t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314828 :knowledge-point/_questions [{:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/title "Finding the Parametric Equations of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0987641c-7f73-5003-941d-7fe503310468" :answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186314830}] :answer-field/correct {:answer/id #uuid "0987641c-7f73-5003-941d-7fe503310468" :answer/type {:db/ident :answer.type/math} :answer/value "-4+4t" :db/id #edb/ref 17592186314830} :answer-field/id #uuid "a18e49a9-1921-5eab-b6c4-24acf04b56ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314829} {:answer-field/choices [{:answer/id #uuid "816b6bec-0b6a-5b61-9553-99760ba5cd46" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314832}] :answer-field/correct {:answer/id #uuid "816b6bec-0b6a-5b61-9553-99760ba5cd46" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186314832} :answer-field/id #uuid "2280d646-8b5f-5bb4-a129-7d8436245450" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314831} {:answer-field/choices [{:answer/id #uuid "0b0ad7a4-e070-58df-b6bb-ed9592dd31cb" :answer/type {:db/ident :answer.type/math} :answer/value "4-t" :db/id #edb/ref 17592186314834}] :answer-field/correct {:answer/id #uuid "0b0ad7a4-e070-58df-b6bb-ed9592dd31cb" :answer/type {:db/ident :answer.type/math} :answer/value "4-t" :db/id #edb/ref 17592186314834} :answer-field/id #uuid "7481a238-1235-5bf9-ba0f-01c8cc89f42e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314833}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c29e7b23-e914-5d7e-8ead-87a0c88d3626" :question/math-academy-id "q-236982" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(-4,-2,4)$ and $Q(0,8,3).$\n\n| $x=$ | {{field-1}} | $t\\in [$ {{field-2}} $,1]$ |\n| --- | --- | --- |\n| $y=$ | $-2+10t$ |  |\n| $z=$ | {{field-3}} |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}0 \\\\ 8 \\\\ 3\\end{aligned}]-[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 10 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ 10 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-4 \\\\ -2 \\\\ 4\\end{aligned}]+[\\begin{aligned}4t \\\\ 10t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-4+4t \\\\ -2+10t \\\\ 4-t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=-4+4t \\\\ y=-2+10t \\\\ z=4-t\\end{aligned}\\,\\,t\\in [0,1]\n$$"}] [{:db/id #edb/ref 17592186387787 :knowledge-point/_questions [{:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f" :knowledge-point/title "Finding the Parametric Equations of a Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c0d844e-3002-5654-b452-82e82c9ecb5e" :answer/type {:db/ident :answer.type/math} :answer/value "4+10t" :db/id #edb/ref 17592186387789} {:answer/id #uuid "df6efcda-6ade-5b9d-b2d7-67cd9ddad7dc" :answer/type {:db/ident :answer.type/math} :answer/value "4-10t" :db/id #edb/ref 17592186387790}] :answer-field/correct {:answer/id #uuid "df6efcda-6ade-5b9d-b2d7-67cd9ddad7dc" :answer/type {:db/ident :answer.type/math} :answer/value "4-10t" :db/id #edb/ref 17592186387790} :answer-field/id #uuid "972fddde-e04a-509f-9690-14e4c1781376" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186387788} {:answer-field/choices [{:answer/id #uuid "fb8aabd0-2293-59ac-8349-165ae059e857" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186387792}] :answer-field/correct {:answer/id #uuid "fb8aabd0-2293-59ac-8349-165ae059e857" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186387792} :answer-field/id #uuid "12c170be-d58b-5b9a-acf1-3ceb5eaa1bfb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186387791} {:answer-field/choices [{:answer/id #uuid "544a794c-a04f-5e71-a860-dca80039ddf0" :answer/type {:db/ident :ans