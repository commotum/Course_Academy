c{1}{2}\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}3t-3 \\\\ 7-9t \\\\ \\frac{3}{2}t-\\frac{1}{2}\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 7 \\\\ -\\frac{1}{2}\\end{aligned}]+[\\begin{aligned}3t \\\\ -9t \\\\ \\frac{3}{2}t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-3 \\\\ 7 \\\\ -\\frac{1}{2}\\end{aligned}]+t[\\begin{aligned}3 \\\\ -9 \\\\ \\frac{3}{2}\\end{aligned}] \\\\ r & =[\\begin{aligned}-3 \\\\ 7 \\\\ -\\frac{1}{2}\\end{aligned}]+t[\\begin{aligned}3 \\\\ -9 \\\\ \\frac{3}{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nThis implies that the straight line passes through the point $(-3,7,-\\frac{1}{2})$ and is parallel to the vector $v=[\\begin{aligned}3 \\\\ -9 \\\\ \\frac{3}{2}\\end{aligned}].$"}] [{:db/id #edb/ref 17592186387800 :knowledge-point/_questions [{:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233e8511-39eb-5fe4-bd69-b751703ab2a1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=2-t \\\\ y=4+3t \\\\ z=5+2t\\end{aligned}" :db/id #edb/ref 17592186387802} {:answer/id #uuid "4da1b74e-e5f1-5d5d-bf2f-0e60843d9190" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186387803} {:answer/id #uuid "f4b2c20a-8426-5d75-a8fd-1b2072ececa9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3t \\\\ y=t \\\\ z=3t\\end{aligned}" :db/id #edb/ref 17592186387804} {:answer/id #uuid "d039497c-c6af-5c68-a4c0-5d04fcc2442a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3-t \\\\ y=1+3t \\\\ z=3+2t\\end{aligned}" :db/id #edb/ref 17592186387805} {:answer/id #uuid "c0069153-f1f0-5278-94fd-9458761d3d15" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-t \\\\ y=3t \\\\ z=2t\\end{aligned}" :db/id #edb/ref 17592186387806}] :answer-field/correct {:answer/id #uuid "4da1b74e-e5f1-5d5d-bf2f-0e60843d9190" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186387803} :answer-field/id #uuid "e4ee4ccc-fa21-55ed-bbc2-6465ec027521" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387801}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "db8bcc12-1372-547d-9bea-8d38186c69b6" :question/math-academy-id "q-32817" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/1ffc0945ea74b1bd467a0b9935ee28b88be004c18b11492d67ecdfec56e1bb09.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,2)$ and $Q(2,4,5).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 5\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+3t \\\\ 3+t \\\\ 2+3t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124865 :knowledge-point/_questions [{:knowledge-point/id #uuid "f232aed9-1584-5e57-a881-226a6876384a" :knowledge-point/title "Finding the Vector Equation of a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0460222-55be-5e17-bca3-a68e07e5f95d" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186387808} {:answer/id #uuid "7c78fe12-39b9-554b-8505-f13cbb3600ec" :answer/type {:db/ident :answer.type/math} :answer/value "r=t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387809} {:answer/id #uuid "ef7091a1-ecd3-58ae-8eeb-de888f684ed9" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}]+t[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387810} {:answer/id #uuid "2ddce540-b7bb-5e2c-8824-1e733595c6e9" :answer/type {:db/ident :answer.type/math} :answer/value "r=t[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387811} {:answer/id #uuid "8de4a1f2-e8f4-5e2a-9c88-60386e94adf5" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186387812}] :answer-field/correct {:answer/id #uuid "8de4a1f2-e8f4-5e2a-9c88-60386e94adf5" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 0 \\\\ 7\\end{aligned}]+t[\\begin{aligned}0 \\\\ 4 \\\\ 0\\end