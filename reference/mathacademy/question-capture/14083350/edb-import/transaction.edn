/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70721/selection/0afd32488a3c0c75d9c4f62f4f6413a74e24b23000577307c1af2d708b6dc6c1" :answer/id #uuid "e3a773c6-5be2-56e8-bb56-4ecc7d8d3bda" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70721/selection/a53de154f9a57651ca733c8ce4763325f64bb6f6daf5e958fa0bb260e5cb0a88" :answer/id #uuid "bdd3e558-ef7c-526c-90d4-9450a49dc721" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70721/selection" :answer-field/id #uuid "58a9fdb3-e40a-5d2e-86c5-c2dac7c00c95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70721/selection/a53de154f9a57651ca733c8ce4763325f64bb6f6daf5e958fa0bb260e5cb0a88" :answer-field/choices ["q-70721/selection/c2cecf6fe493f27e7d7f91817674b4c1268d9d45914814cd267fd24c81e3ec35" "q-70721/selection/f979b69bf5331b985452aee65d71166c00d7d8b5db8f50d586578f1564053658" "q-70721/selection/074db705e16e1e57f8a2aff94b5fe57d6f39b7233e5e76f422f3f665da482360" "q-70721/selection/0afd32488a3c0c75d9c4f62f4f6413a74e24b23000577307c1af2d708b6dc6c1" "q-70721/selection/a53de154f9a57651ca733c8ce4763325f64bb6f6daf5e958fa0bb260e5cb0a88"] :db/ensure [:answer-field/validate]} {:db/id "q-70721" :question/id #uuid "0b35cb98-4ef1-509b-b779-5ff2e485c987" :question/math-academy-id "q-70721" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=t-1 \\\\ y=-t+1 \\\\ z=-t-1\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}t-1 \\\\ -t+1 \\\\ -t-1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]+[\\begin{aligned}t \\\\ -t \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]+t[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] \\\\ r & =[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]+t[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$  \n\nThis implies that the straight line passes through the point $(-1,1,-1)$   and is parallel to the vector $v=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70721/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de"] :knowledge-point/questions ["q-70721"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70716/selection/c1c5d48e3260d0e62008129a386a1425cbb4a0b18d91fba9227fc551bb3a4b39" :answer/id #uuid "4fe72ae3-39a9-5cc2-86b7-f79794ad112d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 4 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70716/selection/4d0f3d1792e5b538cea3a008af41f4567d058d2f553ffca031a47dcbfcabe7ca" :answer/id #uuid "192132d9-79fb-549d-8347-4aa0e57fa7cb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70716/selection/0518bd170ae4aae460d736ff822537cd09066fbde8a5136ff0b9c1d8d95f1f28" :answer/id #uuid "af13daa6-8282-50d0-96db-5f6997cac18a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70716/selection/52f983c1e261e63eba86b7942f4547a0839137300af95672e2f7c0c445edd5a9" :answer/id #uuid "285755ae-67db-51a3-b559-4cadb6e6e2c7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70716/selection/1f26ec7b79fc79e0240fc10a9bfb1674574cc34874399ae8065df91af0d10427" :answer/id #uuid "af858222-d63f-5d13-a3a3-1b9b5c0ec7f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70716/selection" :answer-field/id #uuid "51759681-959a-5123-88be-afd698623649" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70716/selection/1f26ec7b79fc79e0240fc10a9bfb1674574cc34874399ae8065df91af0d10427" :answer-field/choices ["q-70716/selection/c1c5d48e3260d0e62008129a386a1425cbb4a0b18d91fba9227fc551bb3a4b39" "q-70716/selection/4d0f3d1792e5b538cea3a008af41f4567d058d2f553ffca031a47dcbfcabe7ca" "q-70716/selection/0518bd170ae4aae460d736ff822537cd09066fbde8a5136ff0b9c1d8d95f1f28" "q-70716/selection/52f983c1e261e63eba86b7942f4547a0839137300af95672e2f7c0c445edd5a9" "q-70716/selection/1f26ec7b79fc79e0240fc10a9bfb1674574cc34874399ae8065df91af0d10427"] :db/ensure [:answer-field/validate]} {:db/id "q-70716" :question/id #uuid "b1a4efcc-8584-528a-9f17-a5e1e08f2760" :question/math-academy-id "q-70716" :question/problem "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=2t+1 \\\\ y=3-t \\\\ z=t+2\\end{aligned}\n$$\n\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2t+1 \\\\ 3-t \\\\ t+2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}2t \\\\ -t \\\\ t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}] \\\\ r & =[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$  \n\nThis implies that the straight line passes through the point $(1,3,2)$  and is parallel to the vector $v=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70716/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3699391-68e8-5c59-8ca2-83fded9f22de"] :knowledge-point/questions ["q-70716"] :db/ensure [:knowledge-point/validate]} {:db/id "q-22318/selection/863a82c2d79c705f33e3beef57eeebedf741fa67a50f89580aee8db1bb5ccd8e" :answer/id #uuid "1cf71475-10ef-58d9-a904-3efaf21c6342" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=4-t \\\\ y=-3+t \\\\ z=-2+4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-22318/selection/60ead78c8fd5b5fddca81ace1df8b31f3408fbf58d93ccf812eb2150c0ee95a4" :answer/id #uuid "a07b7d01-5d3a-532c-a6d6-b9281bd12c46" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3-t \\\\ y=-2+t \\\\ z=2+4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-22318/selection/6ce3b8fc7b1f6ad3186936298f9bfcca4c074f5351c505cd4c1c81907adda60e" :answer/id #uuid "128d5034-e0c2-5845-ae18-217aab8c5d37" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=4t \\\\ y=-3t \\\\ z=-2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-22318/selection/02dad06b0202711bb491d89215b43d07ae5c8aeb94de7d732199d1b005dec82b" :answer/id #uuid "7bb736d5-4ee6-54f6-92e0-1136ec9ff04b" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=-1+4t \\\\ y=1-3t \\\\ z=4-2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-22318/selection/a699e3a7560464ef31687d1d97e85ef1bcbf6112ba55fb46fdd585c419675a2a" :answer/id #uuid "e67ef017-43ed-50d0-8648-9039c2e58a87" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=-t \\\\ y=t \\\\ z=4t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-22318/selection" :answer-field/id #uuid "0bafd216-e43d-5548-ad04-f497cd97ef6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-22318/selection/02dad06b0202711bb491d89215b43d07ae5c8aeb94de7d732199d1b005dec82b" :answer-field/choices ["q-22318/selection/863a82c2d79c705f33e3beef57eeebedf741fa67a50f89580aee8db1bb5ccd8e" "q-22318/selection/60ead78c8fd5b5fddca81ace1df8b31f3408fbf58d93ccf812eb2150c0ee95a4" "q-22318/selection/6ce3b8fc7b1f6ad3186936298f9bfcca4c074f5351c505cd4c1c81907adda60e" "q-22318/selection/02dad06b0202711bb491d89215b43d07ae5c8aeb94de7d732199d1b005dec82b" "q-22318/selection/a699e3a7560464ef31687d1d97e85ef1bcbf6112ba55fb46fdd585c419675a2a"] :db/ensure [:answer-field/validate]} {:db/id "q-22318" :question/id #uuid "9b9348a1-38e3-553c-a088-0bd9bfbd914c" :question/math-academy-id "q-22318" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/58076d96d149ff4521103fd15c7187bc1a58595ab20f28be92be0f79385aee61.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,1,4)$ and $Q(3,-2,2).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$,  as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}]-[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ -3 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 1 \\\\ 4\\end{aligned}]+[\\begin{aligned}4t \\\\ -3t \\\\ -2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+4t \\\\ 1-3t \\\\ 4-2t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=-1+4t \\\\ y=1-3t \\\\ z=4-2t\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-22318/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"] :knowledge-point/questions ["q-22318"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32817/selection/9a689d2c6f3d605aa7f7e755293bc773886b3cdf150b0391a6b2cc4e7b6c677f" :answer/id #uuid "c0069153-f1f0-5278-94fd-9458761d3d15" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=-t \\\\ y=3t \\\\ z=2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-32817/selection/7b7017a9fc6519228fe69750d32c2c2f3229287563526588685b2d3516c351eb" :answer/id #uuid "f4b2c20a-8426-5d75-a8fd-1b2072ececa9" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3t \\\\ y=t \\\\ z=3t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-32817/selection/5f61759cd3b6634c6b74fc8b78e9446fb64cc6f41b8dc7f34e3eecf9b4926304" :answer/id #uuid "4da1b74e-e5f1-5d5d-bf2f-0e60843d9190" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-32817/selection/558eba0ccf5f0c38d3f27d5faa7cf21bee3f389bdffbf4c8926307d319dbd654" :answer/id #uuid "233e8511-39eb-5fe4-bd69-b751703ab2a1" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2-t \\\\ y=4+3t \\\\ z=5+2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-32817/selection/99191b82593f2e5ff18877ef3380d77cd708670f82be8f3a92518bac0fe2d1b5" :answer/id #uuid "d039497c-c6af-5c68-a4c0-5d04fcc2442a" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3-t \\\\ y=1+3t \\\\ z=3+2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-32817/selection" :answer-field/id #uuid "e4ee4ccc-fa21-55ed-bbc2-6465ec027521" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32817/selection/5f61759cd3b6634c6b74fc8b78e9446fb64cc6f41b8dc7f34e3eecf9b4926304" :answer-field/choices ["q-32817/selection/9a689d2c6f3d605aa7f7e755293bc773886b3cdf150b0391a6b2cc4e7b6c677f" "q-32817/selection/7b7017a9fc6519228fe69750d32c2c2f3229287563526588685b2d3516c351eb" "q-32817/selection/5f61759cd3b6634c6b74fc8b78e9446fb64cc6f41b8dc7f34e3eecf9b4926304" "q-32817/selection/558eba0ccf5f0c38d3f27d5faa7cf21bee3f389bdffbf4c8926307d319dbd654" "q-32817/selection/99191b82593f2e5ff18877ef3380d77cd708670f82be8f3a92518bac0fe2d1b5"] :db/ensure [:answer-field/validate]} {:db/id "q-32817" :question/id #uuid "db8bcc12-1372-547d-9bea-8d38186c69b6" :question/math-academy-id "q-32817" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/1ffc0945ea74b1bd467a0b9935ee28b88be004c18b11492d67ecdfec56e1bb09.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,2)$ and $Q(2,4,5).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 5\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+3t \\\\ 3+t \\\\ 2+3t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32817/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"] :knowledge-point/questions ["q-32817"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127046/selection/33d93683d5d5abb720769d8f00065399a706457b42d93b3d161fe400b543c0de" :answer/id #uuid "bb231cec-4e63-5ff7-8207-763b171ae0c2" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2+t \\\\ y=-5+3t \\\\ z=4-2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127046/selection/794dff9d10a082d4ed5719407e49d00bef40602bc368572c2a2028611a2fcef4" :answer/id #uuid "e87a1dd0-1e22-5b27-9312-97289bb0037b" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2-3t \\\\ y=5-2t \\\\ z=-4-2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127046/selection/b6fd71aa7123f14b1c1b3bcf345f0ff79aa92ccdad5f74e199fa0159e336daaa" :answer/id #uuid "aad1915d-54db-591d-a400-e033fe1da95d" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=4-2t \\\\ y=-5-2t \\\\ z=2+3t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127046/selection/2e58050249b248adeaace244c1eeaeee9004a3f0367b5afcc178ea22abb18cb2" :answer/id #uuid "d1ddd0e3-169d-5e9b-8f17-a7d714cb10d1" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=2-3t \\\\ y=-5+2t \\\\ z=-4+2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127046/selection/2a0964c732b5d1f9c2d864a77addfef9f5b034eabccede3f2bd76e6e02f13ec5" :answer/id #uuid "fe4f0806-0fc7-5f51-ab81-33fd4d32ccfb" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=-4+3t \\\\ y=-3-2t \\\\ z=4-2t\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-127046/selection" :answer-field/id #uuid "a66bd7bc-2429-563d-bbe0-27f9dd15047b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127046/selection/33d93683d5d5abb720769d8f00065399a706457b42d93b3d161fe400b543c0de" :answer-field/choices ["q-127046/selection/33d93683d5d5abb720769d8f00065399a706457b42d93b3d161fe400b543c0de" "q-127046/selection/794dff9d10a082d4ed5719407e49d00bef40602bc368572c2a2028611a2fcef4" "q-127046/selection/b6fd71aa7123f14b1c1b3bcf345f0ff79aa92ccdad5f74e199fa0159e336daaa" "q-127046/selection/2e58050249b248adeaace244c1eeaeee9004a3f0367b5afcc178ea22abb18cb2" "q-127046/selection/2a0964c732b5d1f9c2d864a77addfef9f5b034eabccede3f2bd76e6e02f13ec5"] :db/ensure [:answer-field/validate]} {:db/id "q-127046" :question/id #uuid "453b8dde-1343-580a-bb17-743f24caa02f" :question/math-academy-id "q-127046" :question/problem "Find the parametric equations of the line that passes through the points $P(2,-5,4)$ and $Q(3,-2,2).$" :question/worked-solution "We need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}]-[\\begin{aligned}2 \\\\ -5 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}2 \\\\ -5 \\\\ 4\\end{aligned}]+t[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5 \\\\ 4\\end{aligned}]+[\\begin{aligned}t \\\\ 3t \\\\ -2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2+t \\\\ -5+3t \\\\ 4-2t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=2+t \\\\ y=-5+3t \\\\ z=4-2t\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1"] :knowledge-point/questions ["q-127046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236984/field-1/dea7ef2ccd35f2b267471cdcaf960c08fc83fed90b00619cd6b4e12d94c34af2" :answer/id #uuid "df6efcda-6ade-5b9d-b2d7-67cd9ddad7dc" :answer/type :answer.type/math :answer/value "4-10t" :db/ensure [:answer/validate]} {:db/id "q-236984/field-1/3c78c380cf6b50f9054abaa7311757776e52a444773e13c3abd5be9795428ce4" :answer/id #uuid "3c0d844e-3002-5654-b452-82e82c9ecb5e" :answer/type :answer.type/math :answer/value "4+10t" :db/ensure [:answer/validate]} {:db/id "q-236984/field-1" :answer-field/id #uuid "972fddde-e04a-509f-9690-14e4c1781376" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236984/field-1/dea7ef2ccd35f2b267471cdcaf960c08fc83fed90b00619cd6b4e12d94c34af2" :answer-field/choices ["q-236984/field-1/dea7ef2ccd35f2b267471cdcaf960c08fc83fed90b00619cd6b4e12d94c34af2" "q-236984/field-1/3c78c380cf6b50f9054abaa7311757776e52a444773e13c3abd5be9795428ce4"] :db/ensure [:answer-field/validate]} {:db/id "q-236984/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "fb8aabd0-2293-59ac-8349-165ae059e857" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-236984/field-2" :answer-field/id #uuid "12c170be-d58b-5b9a-acf1-3ceb5eaa1bfb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236984/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-236984/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-236984/field-3/edda5fbe176f5b264be888a904f4ac3f521837ea780cbd38e0c2e0ca5019d73f" :answer/id #uuid "544a794c-a04f-5e71-a860-dca80039ddf0" :answer/type :answer.type/math :answer/value "-1+6t" :db/ensure [:answer/validate]} {:db/id "q-236984/field-3" :answer-field/id #uuid "fe848625-8986-51f5-8b38-a149e58da0bb" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236984/field-3/edda5fbe176f5b264be888a904f4ac3f521837ea780cbd38e0c2e0ca5019d73f" :answer-field/choices ["q-236984/field-3/edda5fbe176f5b264be888a904f4ac3f521837ea780cbd38e0c2e0ca5019d73f"] :db/ensure [:answer-field/validate]} {:db/id "q-236984" :question/id #uuid "b8070f7a-3d38-5d87-a90e-8a52347ad9c9" :question/math-academy-id "q-236984" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(4,-1,7)$ and $Q(-6,5,0).$\n\n| $x=$ | {{field-1}} | $t\\in [0,$ {{field-2}} $]$ |\n| --- | --- | --- |\n| $y=$ | {{field-3}} |  |\n| $z=$ | $7-7t$ |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}-6 \\\\ 5 \\\\ 0\\end{aligned}]-[\\begin{aligned}4 \\\\ -1 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}-10 \\\\ 6 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}4 \\\\ -1 \\\\ 7\\end{aligned}]+t[\\begin{aligned}-10 \\\\ 6 \\\\ -7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ 7\\end{aligned}]+[\\begin{aligned}-10t \\\\ 6t \\\\ -7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4-10t \\\\ -1+6t \\\\ 7-7t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=4-10t \\\\ y=-1+6t \\\\ z=7-7t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-236984/field-1" "q-236984/field-2" "q-236984/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236984"] :db/ensure [:knowledge-point/validate]} {:db/id "q-236992/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "65ea7488-aec6-530d-94e8-28417a32783e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-236992/field-1" :answer-field/id #uuid "14557b6f-6ac5-5c2d-a908-48cc36af65e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236992/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-236992/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-236992/field-2/fdf38652bc74a425c218b455e466f9ddc8ba178ed22909d2c2a6a6dc18831ae5" :answer/id #uuid "15fe2776-ccee-5159-99c1-dd5299d18850" :answer/type :answer.type/math :answer/value "-1+2t" :db/ensure [:answer/validate]} {:db/id "q-236992/field-2" :answer-field/id #uuid "a828ce99-6cec-5360-a06c-4b56cca23969" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-236992/field-2/fdf38652bc74a425c218b455e466f9ddc8ba178ed22909d2c2a6a6dc18831ae5" :answer-field/choices ["q-236992/field-2/fdf38652bc74a425c218b455e466f9ddc8ba178ed22909d2c2a6a6dc18831ae5"] :db/ensure [:answer-field/validate]} {:db/id "q-236992" :question/id #uuid "f1169269-03fd-50a6-b745-72b26940d1b6" :question/math-academy-id "q-236992" :question/problem "Fill in the missing parts in the parametric equations below that describe all the points on the line segment $\\overset{―}{PQ},$ where $P(4,1,-1)$ and $Q(6,5,1).$\n\n| $x=$ | $4+2t$ | $t\\in [0,$ {{field-1}} $]$ |\n| --- | --- | --- |\n| $y=$ | $1+4t$ |  |\n| $z=$ | {{field-2}} |  |" :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}6 \\\\ 5 \\\\ 1\\end{aligned}]-[\\begin{aligned}4 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}4 \\\\ 1 \\\\ -1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4 \\\\ 1 \\\\ -1\\end{aligned}]+[\\begin{aligned}2t \\\\ 4t \\\\ 2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4+2t \\\\ 1+4t \\\\ -1+2t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=4+2t \\\\ y=1+4t \\\\ z=-1+2t\\end{aligned}\\,\\,t\\in [0,1]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-236992/field-1" "q-236992/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d275a218-aa12-54bd-a4ff-4be892226f4f"] :knowledge-point/questions ["q-236992"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-15602"] :question/problem "Consider the straight line given by the following parametric equations: \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/a664a3af1ba466491d209dadd32a3be026a5179ac2d0281b55f30917f9ab016b.png)\nWhat would be the vector equation of the line?" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15603"] :question/problem "Consider the straight line given by the following parametric equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/f161e07945eb3fe2350a56ab5cb96fa0ae2d055eb3b4cc633abfae30839ec76f.png)\nFind a vector that is parallel to the line." :question/worked-solution "First, let's find the corresponding vector equation:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5-t \\\\ 3 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+[\\begin{aligned}-t \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ r & =[\\begin{aligned}5 \\\\ 3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$\n\nThis implies that the line passes through the point $(5,3,1)$ and is parallel to the vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/11701a2d63851a3f241d8bd905693abaaa6eda6fe4ba0c5710c92d8189595ffd.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15604"] :question/problem "Find the parametric equations of the line shown in the figure below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/53386f04f4025fda6ab579113a8ecb53a19f4dc0a77903adc05bac3a71429717.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-15605"] :question/worked-solution "First, we need to find a direction vector that is parallel to the line passing through the given points. We can use the vector $\\overrightarrow{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}0 \\\\ 4 \\\\ -4\\end{aligned}]-[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 9 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 9 \\\\ -7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ -5 \\\\ 3\\end{aligned}]+[\\begin{aligned}-t \\\\ 9t \\\\ -7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1-t \\\\ -5+9t \\\\ 3-7t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t \\in (-\\infty,\\infty).$ \n\nTo get the equations for the line segment, we take only $t \\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overline{PQ}$ are the following:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/assets/c3747cbb9a88a419d6808959c490089c79041cc8773651fac1953f4846839c14.png)" :db/ensure [:question/validate]}]
