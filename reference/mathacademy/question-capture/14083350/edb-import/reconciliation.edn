igned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7-3t \\\\ -11+2t \\\\ 3+7t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/state.json" "file_sha256" "2aef1fad50ee8c569cbfa51288a76516d58d4b185ea82ae78cbdc5a034a77741" "basis" 1538 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/edb-import/verification.json"} {"question" "q-127065" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/activity-metadata.json" "file_sha256" "04193a0fd5e3f8f0e92397cd0d61924f8c1f3a77c107660b594317d63d54a1a8" "basis" 1538 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/edb-import/verification.json"} {"question" "q-127065" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/state.json" "file_sha256" "2aef1fad50ee8c569cbfa51288a76516d58d4b185ea82ae78cbdc5a034a77741" "basis" 1538 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/edb-import/verification.json"} {"question" "q-127065" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{\\begin{aligned}x=7+3t \\\\ y=-11+2t \\\\ z=3-7t\\end{aligned}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041770/state.json" "file_sha256" "2aef1fad5