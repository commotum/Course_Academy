d}-10 \\\\ 6 \\\\ -7\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}4 \\\\ -1 \\\\ 7\\end{aligned}]+t[\\begin{aligned}-10 \\\\ 6 \\\\ -7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4 \\\\ -1 \\\\ 7\\end{aligned}]+[\\begin{aligned}-10t \\\\ 6t \\\\ -7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}4-10t \\\\ -1+6t \\\\ 7-7t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ \n\nTo get the equations for the line segment, we take only $t\\in [0,1].$ Notice that substitution of $t=0$ in the above equation gives the coordinates of $P$ and substitution of $t=1$ gives the coordinates of $Q.$\n\nTherefore, the parametric equations of the line segment $\\overset{―}{PQ}$ are the following:\n\n$$\n{\\begin{aligned}x=4-10t \\\\ y=-1+6t \\\\ z=7-7t\\end{aligned}\\,\\,t\\in [0,1]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/state.json" "file_sha256" "8699f9215a70017c858b7baf13de3401e0afd6f3ccd047721dec71d3ce6c7fcf"} {"question" "q-236984" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/activity-metadata.json" "file_sha256" "4d7b16ddaac7c6a0f615f35b49c381df7fb4526c819aeb36121b03237aeaca04"} {"question" "q-236984" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/state.json" "file_sha256" "8699f9215a70017c858b7baf13de3401e0afd6f3ccd047721dec71d3ce6c7fcf"} {"question" "q-236984" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4-10t"] "category" "model_interpretation" "file" "/home/jake/Deve