$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]+t[\\begin{aligned}4 \\\\ -1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]+[\\begin{aligned}4t \\\\ -t \\\\ 2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1+4t \\\\ 4-t \\\\ -2+2t\\end{aligned}]\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=1+4t \\\\ y=4-t \\\\ z=-2+2t\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/state.json" "file_sha256" "8699f9215a70017c858b7baf13de3401e0afd6f3ccd047721dec71d3ce6c7fcf"} {"question" "q-36026" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/activity-metadata.json" "file_sha256" "4d7b16ddaac7c6a0f615f35b49c381df7fb4526c819aeb36121b03237aeaca04"} {"question" "q-36026" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/state.json" "file_sha256" "8699f9215a70017c858b7baf13de3401e0afd6f3ccd047721dec71d3ce6c7fcf"} {"question" "q-36026" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\begin{aligned}x=1+4t \\\\ y=4-t \\\\ z=-2+2t\\end{aligned}"] ["math" "{\\begin{aligned}x=4+t \\\\ y=-1+4t \\\\ z=2-2t\\end{aligned}"] ["math" "{\\begin{aligned}x=4t \\\\ y=-t \\\\ z=2t\\end{aligned}"] ["math" "{\\begin{aligned}x=5+t \\\\ y=3+4t \\\\ z=-2t\\end{aligned}"] ["math" "{\\begin{aligned}x=t \\\\ y=4t \\\\ z=-2t\\end{aligned}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083350/state.