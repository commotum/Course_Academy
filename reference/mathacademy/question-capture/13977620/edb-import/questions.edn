#{[{:db/id #edb/ref 17592186100601 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/id #uuid "f31d614e-a00c-5502-8b23-e9214bc2ae5c" :question/math-academy-id "e-4397" :question/problem "Find $A\\mathbf{x}$ if\n$\\begin{bmatrix}1 & 3 \\\\ 7 & -2\\end{bmatrix}$\nand\n$\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}1 & 3 \\\\ 7 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 5\\end{bmatrix} &= \\begin{bmatrix}1 \\cdot 2 + 3 \\cdot 5 \\\\ ∗\\end{bmatrix} = \\begin{bmatrix}17 \\\\ ∗\\end{bmatrix}\n\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}1 & 3 \\\\ 7 & -2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 5\\end{bmatrix} &= \\begin{bmatrix}17 \\\\ 7 \\cdot 2 + (-2) \\cdot 5\\end{bmatrix} = \\begin{bmatrix}17 \\\\ 4\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore,\n$\\begin{bmatrix}17 \\\\ 4\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186100602 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/id #uuid "63f6d2d5-0654-569f-bd71-437c835a49d3" :question/math-academy-id "e-4398" :question/problem "Find $A\\mathbf{x}$ if\n$\\begin{bmatrix}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{bmatrix}$\nand\n$\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}\nAx &= \\begin{bmatrix}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{bmatrix}\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}(-3) \\cdot 1 + 1 \\cdot (-2) + 1 \\cdot 0 \\\\ 2 \\cdot 1 + 0 \\cdot (-2) + 0 \\cdot 0 \\\\ (-1) \\cdot 1 + (-2) \\cdot (-2) + 5 \\cdot 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-3 - 2 + 0 \\\\ 2 + 0 + 0 \\\\ -1 + 4 + 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-5 \\\\ 2 \\\\ 3\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100603 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/id #uuid "c154ead3-0974-5e0d-9653-38c20756921e" :question/math-academy-id "e-4399" :question/problem "Find $A\\mathbf{x}$ if\n$\\begin{bmatrix}a & c \\\\ b & d\\end{bmatrix}$\nand\n$\\begin{bmatrix}3 \\\\ 2\\end{bmatrix}$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}\nAx &= \\begin{bmatrix}a & c \\\\ b & d\\end{bmatrix}\\begin{bmatrix}3 \\\\ 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}a \\cdot 3 + c \\cdot 2 \\\\ b \\cdot 3 + d \\cdot 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}3a + 2c \\\\ 3b + 2d\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101028 :knowledge-point/_questions [{:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0edb77a-e317-5792-a376-1d26da49e215" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}a \\\\ a - b \\\\ a + b\\end{bmatrix}" :db/id #edb/ref 17592186097939} {:answer/id #uuid "b4e03b11-9e67-5bb9-9dad-15bfc10dcbd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a \\\\ a + b \\\\ 2a + b\\end{bmatrix}" :db/id #edb/ref 17592186097940} {:answer/id #uuid "e72bd770-e689-5741-a2c4-be6cc7ac4df5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3a \\\\ a - b \\\\ a + b\\end{bmatrix}" :db/id #edb/ref 17592186097941} {:answer/id #uuid "2e8a2a38-3dec-5644-ad68-