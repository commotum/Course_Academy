#{[{:db/id #edb/ref 17592186100601 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/id #uuid "f31d614e-a00c-5502-8b23-e9214bc2ae5c" :question/math-academy-id "e-4397" :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}]$\nand\n$[\\begin{aligned}2 \\\\ 5\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}1\\cdot 2+3\\cdot 5 \\\\ ∗\\end{aligned}]=[\\begin{aligned}17 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}17 \\\\ 7\\cdot 2+(-2)\\cdot 5\\end{aligned}]=[\\begin{aligned}17 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n$[\\begin{aligned}17 \\\\ 4\\end{aligned}]$"}] [{:db/id #edb/ref 17592186100602 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/id #uuid "63f6d2d5-0654-569f-bd71-437c835a49d3" :question/math-academy-id "e-4398" :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}(-3)\\cdot 1+1\\cdot (-2)+1\\cdot 0 \\\\ 2\\cdot 1+0\\cdot (-2)+0\\cdot 0 \\\\ (-1)\\cdot 1+(-2)\\cdot (-2)+5\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3-2+0 \\\\ 2+0+0 \\\\ -1+4+0\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100603 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/id #uuid "c154ead3-0974-5e0d-9653-38c20756921e" :question/math-academy-id "e-4399" :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}a & c \\\\ b & d\\end{aligned}]$\nand\n$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}a & c \\\\ b & d\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}a\\cdot 3+c\\cdot 2 \\\\ b\\cdot 3+d\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}3a+2c \\\\ 3b+2d\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278009 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cdc4cb0-1385-528e-b5d3-4ef783be778d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186278011} {:answer/id #uuid "779fc855-2841-529c-8d4f-1357b4831fd8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186278012} {:answer/id #uuid "d4b921d1-27fa-5345-9433-0de31e7fdd22" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186278013} {:answer/id #uuid "d3aaa1e3-7ef8-5164-8a83-e0fd88945a3f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\be