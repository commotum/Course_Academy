51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-13556"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-127270"] :question/problem "Find $By$ if \n$B=[\\begin{aligned}a & -a & a \\\\ a & -2b & b \\\\ 2a & -b & a\\end{aligned}]$\nand\n$y=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}By & =[\\begin{aligned}a & -a & a \\\\ a & -2b & b \\\\ 2a & -b & a\\end{aligned}][\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}a\\cdot 1+(-a)\\cdot (-1)+a\\cdot (-1) \\\\ a\\cdot 1+(-2b)\\cdot (-1)+b\\cdot (-1) \\\\ 2a\\cdot 1+(-b)\\cdot (-1)+a\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}a+a-a \\\\ a+2b-b \\\\ 2a+b-a\\end{aligned}] \\\\  & =[\\begin{aligned}a \\\\ a+b \\\\ a+b\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-318595/field-1/b31f39820517ad4b56fbd1cadf80bc910e9e60024f663af4f5d0b635f77f6418" :answer/id #uuid "1dc51361-593f-5165-a59b-9c8356b9c975" :answer/type :answer.type/math :answer/value "6p^2-4q^2" :db/ensure [:answer/validate]} {:db/id "q-318595/field-1/ead5e267fa2e7588d0b6600ad0444464946b58e647e98453e6da22f9e2143e3e" :answer/id #uuid "992bbf49-50dd-57e7-954a-4837271fa23f" :answer/type :answer.type/math :answer/value "6p^2+4q^2" :db/ensure [:answer/validate]} {:db/id "q-318595/field-1" :answer-field/id #uuid "889d4ac4-be63-5e84-8191-78c0d8217e8a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318595/field-1/b31f39820517ad4b56fbd1cadf80bc910e9e60024f663af4f5d0b635f77f6418" :answer-field/choices ["q-318595/field-1/b31f39820517ad4b56fbd1cadf80bc910e9e60024f663af4f5d0b635f77f6418" "q-318595/field-1/ead5e267fa2e7588d0b6600ad0444464946b58e647e98453e6da22f9e2143e3e"] :db/ensure [:answer-field/validate]} {:db/id "q-318595/field-2/37d4dce8b72543c2f9f4a66973def9c297729183adf31dbccf75670bda7fdb70" :answer/id #uuid "46ae37fb-9462-5a02-81a3-0f6c0276e127" :answer/type :answer.type/math :answer/value "-5p^2+2q^2" :db/ensure [:answer/validate]} {:db/id "q-318595/field-2" :answer-field/id #uuid "4c4934a8-a8f7-5402-adcb-2f9bf7ac556d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318595/field-2/37d4dce8b72543c2f9f4a66973def9c297729183adf31dbccf75670bda7fdb70" :answer-field/choices ["q-318595/field-2/37d4dce8b72543c2f9f4a66973def9c297729183adf31dbccf75670bda7fdb70"] :db/ensure [:answer-field/validate]} {:db/id "q-318595" :question/id #uuid "7df4b766-ea46-5249-817c-ccfd3f210bd5" :question/math-academy-id "q-318595" :question/problem "Find $By$  if \n$B=[\\begin{aligned}6p & -4q \\\\ -5p & 2q\\end{aligned}]$\nand\n$y=[\\begin{aligned}p \\\\ q\\end{aligned}].$\n\n| $By=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}By & =[\\begin{aligned}6p & -4q \\\\ -5p & 2q\\end{aligned}][\\begin{aligned}p \\\\ q\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}6p\\cdot p & + & (-4q)\\cdot q \\\\ -5p\\cdot p & + & \\,\\,\\,\\,\\,\\,\\,2q\\cdot q\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}6{p}^{2}-4{q}^{2} \\\\ -5{p}^{2}+2{q}^{2}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318595/field-1" "q-318595/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-318595"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318589/field-1/c934e76b344ed67dcd08c533b7adec931bfb927400ed267d9ea2d5aef2948c43" :answer/id #uuid "cf72b580-b0d2-5eac-ab13-e9df0807c1fc" :answer/type :answer.type/math :answer/value "-2b^2" :db/ensure [:answer/validate]} {:db/id "q-318589/field-1" :answer-field/id #uuid "4ba4a682-95e5-56af-9d99-0653f421f8fe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318589/field-1/c934e76b344ed67dcd08c533b7adec931bfb927400ed267d9ea2d5aef2948c43" :answer-field/choices ["q-318589/field-1/c934e76b344ed67dcd08c533b7adec931bfb927400ed267d9ea2d5aef2948c43"] :db/ensure [:answer-field/validate]} {:db/id "q-318589/field-2/c73e12d6ed48df59606ea7efa1242b6fded369864b90cf0deaefb0e346935e5d" :answer/id #uuid "d5c3605e-e561-5349-ae8c-7b4a571a8e5a" :answer/type :answer.type/math :answer/value "2b^2" :db/ensure [:answer/validate]} {:db/id "q-318589/field-2" :answer-field/id #uuid "279f29d9-795b-53d4-98b3-899b5b85a620" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318589/field-2/c73e12d6ed48df59606ea7efa1242b6fded369864b90cf0deaefb0e346935e5d" :answer-field/choices ["q-318589/field-2/c73e12d6ed48df59606ea7efa1242b6fded369864b90cf0deaefb0e346935e5d"] :db/ensure [:answer-field/validate]} {:db/id "q-318589/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2b3796ff-b8c9-5507-8561-4f446e7db7c4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-318589/field-3" :answer-field/id #uuid "a3482e49-0ca4-5257-b9ef-38b3849cd275" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318589/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-318589/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-318589" :question/id #uuid "43a69a91-d435-56b9-9ff1-320aedc8a688" :question/math-academy-id "q-318589" :question/problem "If \n$A=[\\begin{aligned}b & a & -b \\\\ -b & a & b \\\\ -b & 0 & -b\\end{aligned}]$\nand\n$x=[\\begin{aligned}-b \\\\ 0 \\\\ b\\end{aligned}],$\nfind $Ax.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $Ax=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}b & a & -b \\\\ -b & a & b \\\\ -b & 0 & -b\\end{aligned}][\\begin{aligned}-b \\\\ 0 \\\\ b\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}b\\cdot (-b) & + & a\\cdot 0 & + & (-b)\\cdot b \\\\ (-b)\\cdot (-b) & + & a\\cdot 0 & + & \\,\\,\\,\\,\\,\\,b\\cdot b \\\\ (-b)\\cdot (-b) & + & 0\\cdot 0 & + & (-b)\\cdot b\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}\\begin{aligned}-{b}^{2} & + & 0 & + & (-{b}^{2}) \\\\ {b}^{2} & + & 0 & + & {b}^{2} \\\\ {b}^{2} & + & 0 & + & (-{b}^{2})\\end{aligned}\\end{aligned}] \\\\  & =[\\begin{aligned}-2{b}^{2} \\\\ 2{b}^{2} \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-318589/field-1" "q-318589/field-2" "q-318589/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-318589"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127277/selection/e52e3671beb720412a8bdab81b804a603375dc648a21b8c620bd64ea231a4ffa" :answer/id #uuid "2da1c5b7-6693-5765-9fba-70f99acdd85b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4m \\\\ m+n\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127277/selection/806d39401feec5c09e248c8083aedcb79c834f690e27025aeebdb689239d3bf6" :answer/id #uuid "f00e850a-8f65-5719-916e-9b70852b2f04" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2m \\\\ 2m+n\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127277/selection/b725391456493c25bd0c4cb19feed7e89ac5cd5f32738d6428f5f38b260d0ede" :answer/id #uuid "cba26798-bb0d-57bc-b7c7-5820cf428317" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4m \\\\ 2m+n\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127277/selection/f742929e1f45b74ea0385b398dc9000abe8a0b41f9e58088038b937c9814bacb" :answer/id #uuid "cd086fd5-3523-5bcf-b117-46b3ecad8c8e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4m \\\\ 2m+3n\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127277/selection/97e6ee811f02aa99cbe8cd17b8241ec968cacc4dbf367689cd2141a0f7235280" :answer/id #uuid "7595f01c-388f-5416-b9ed-2bfe0fd10f67" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2m \\\\ 2m+3n\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127277/selection" :answer-field/id #uuid "1358fcd3-3754-51ff-acbd-162cae14de76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127277/selection/f742929e1f45b74ea0385b398dc9000abe8a0b41f9e58088038b937c9814bacb" :answer-field/choices ["q-127277/selection/e52e3671beb720412a8bdab81b804a603375dc648a21b8c620bd64ea231a4ffa" "q-127277/selection/806d39401feec5c09e248c8083aedcb79c834f690e27025aeebdb689239d3bf6" "q-127277/selection/b725391456493c25bd0c4cb19feed7e89ac5cd5f32738d6428f5f38b260d0ede" "q-127277/selection/f742929e1f45b74ea0385b398dc9000abe8a0b41f9e58088038b937c9814bacb" "q-127277/selection/97e6ee811f02aa99cbe8cd17b8241ec968cacc4dbf367689cd2141a0f7235280"] :db/ensure [:answer-field/validate]} {:db/id "q-127277" :question/id #uuid "d76247e4-8d78-58d0-96a8-81f3c917a6ed" :question/math-academy-id "q-127277" :question/problem "Find $Qg$ if \n$Q=[\\begin{aligned}m & 2m \\\\ -m & n\\end{aligned}]$\nand\n$g=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Qg & =[\\begin{aligned}m & 2m \\\\ -m & n\\end{aligned}][\\begin{aligned}-2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}m\\cdot (-2)+2m\\cdot 3 \\\\ -m\\cdot (-2)+n\\cdot 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2m+6m \\\\ 2m+3n\\end{aligned}] \\\\  & =[\\begin{aligned}4m \\\\ 2m+3n\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127277/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65"] :knowledge-point/questions ["q-127277"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4397"] :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}]$\nand\n$[\\begin{aligned}2 \\\\ 5\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}1\\cdot 2+3\\cdot 5 \\\\ ∗\\end{aligned}]=[\\begin{aligned}17 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 3 \\\\ 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 5\\end{aligned}] & =[\\begin{aligned}17 \\\\ 7\\cdot 2+(-2)\\cdot 5\\end{aligned}]=[\\begin{aligned}17 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n$[\\begin{aligned}17 \\\\ 4\\end{aligned}]$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4398"] :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}-3 & 1 & 1 \\\\ 2 & 0 & 0 \\\\ -1 & -2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}(-3)\\cdot 1+1\\cdot (-2)+1\\cdot 0 \\\\ 2\\cdot 1+0\\cdot (-2)+0\\cdot 0 \\\\ (-1)\\cdot 1+(-2)\\cdot (-2)+5\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3-2+0 \\\\ 2+0+0 \\\\ -1+4+0\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4399"] :question/problem "Find $A\\mathbf{x}$ if \n$[\\begin{aligned}a & c \\\\ b & d\\end{aligned}]$\nand\n$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}a & c \\\\ b & d\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}a\\cdot 3+c\\cdot 2 \\\\ b\\cdot 3+d\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}3a+2c \\\\ 3b+2d\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
