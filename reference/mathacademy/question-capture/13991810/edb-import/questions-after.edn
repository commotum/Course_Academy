#{[{:db/id #edb/ref 17592186283893 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bcd65ac-ca70-50e6-ace4-5cc5be9a6832" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186283895} {:answer/id #uuid "05a07b99-fcd4-5f21-a7fd-72b4ec7fba57" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186283896} {:answer/id #uuid "9685cef0-73d1-5215-856b-8cf3e29eaa51" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\sqrt{3}" :db/id #edb/ref 17592186283897} {:answer/id #uuid "c359b8c4-ea44-5193-8249-806c6ad615a1" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186283898} {:answer/id #uuid "670134f8-d12c-52da-8173-305575d7fd18" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{3}" :db/id #edb/ref 17592186283899}] :answer-field/correct {:answer/id #uuid "6bcd65ac-ca70-50e6-ace4-5cc5be9a6832" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186283895} :answer-field/id #uuid "74dbb894-3ce4-58c9-9dbd-67aa52d1e8a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283894}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ed5c021d-75c0-5eb0-8447-cc8817c3eb31" :question/math-academy-id "q-170558" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola ${x}^{2}-\\frac{{y}^{2}}{16}=1$ intersects the line $y=8x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=8x,$ we first replace $y$ with $8x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{{y}^{2}}{16} & =1 \\\\ {x}^{2}-\\frac{(8x)^{2}}{16} & =1 \\\\ {x}^{2}-\\frac{64{x}^{2}}{16} & =1 \\\\ {x}^{2}-4{x}^{2} & =1 \\\\ -3{x}^{2} & =1 \\\\ {x}^{2} & =-\\frac{1}{3}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, the hyperbola does not intersect the line $y=8x.$"}] [{:db/id #edb/ref 17592186283900 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdf9991-54c0-5907-b4c4-386c77f27b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283902}] :answer-field/correct {:answer/id #uuid "3cdf9991-54c0-5907-b4c4-386c77f27b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283902} :answer-field/id #uuid "6d4c7cc2-2d02-5c8a-a77e-2125403b00b7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283901} {:answer-field/choices [{:answer/id #uuid "cc988383-1e89-5565-9753-3d079cedb0fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283904}] :answer-field/correct {:answer/id #uuid "cc988383-1e89-5565-9753-3d079cedb0fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283904} :answer-field/id #uuid "84db0e4a-cac2-5576-81dd-9da53bef1cd8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283903}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "51629e1f-11aa-5026-a109-70d1b9705db2" :question/math-academy-id "q-277805" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $3{x}^{2}-{y}^{2}=8$ intersects the line $y=x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-{y}^{2} & =8 \\\\ 3{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186283905 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "327d555d-be85-5e47-a482-c1ccaab50031" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283907} {:answer/id #uuid "f671af5b-c88c-5184-9667-77abe37f494b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283908}] :answer-field/correct {:answer/id #uuid "f671af5b-c88c-5184-9667-77abe37f494b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283908} :answer-field/id #uuid "65adb29f-0546-5cc4-a0cb-ded906e2c674" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283906} {:answer-field/choices [{:answer/id #uuid "b562017c-fc0e-5a21-b378-774a1f9b6801" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283910}] :answer-field/correct {:answer/id #uuid "b562017c-fc0e-5a21-b378-774a1f9b6801" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283910} :answer-field/id #uuid "c2a6977f-cfb2-5fe7-a638-47ef91018e92" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283909}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7eb5a312-9e17-5376-b02f-6c5d94a3e099" :question/math-academy-id "q-278367" :question/problem "The $y$-intercept of the hyperbola $\\frac{(x-4)^{2}}{16}-(y-2)^{2}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{16}-(y-2)^{2} & =1 \\\\ \\frac{(0-4)^{2}}{16}-(y-2)^{2} & =1 \\\\ 1-(y-2)^{2} & =1 \\\\ -(y-2)^{2} & =0 \\\\ (y-2)^{2} & =0 \\\\ y-2 & =0 \\\\ y & =2\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $(0,2).$"}] [{:db/id #edb/ref 17592186283911 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "489c0159-c147-5c45-b6ba-1526e857a640" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283913}] :answer-field/correct {:answer/id #uuid "489c0159-c147-5c45-b6ba-1526e857a640" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283913} :answer-field/id #uuid "5f2f91c4-160d-59fc-bfbb-58a1b85c6b30" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283912} {:answer-field/choices [{:answer/id #uuid "c6c96545-d7a5-52c1-9192-98a70711e282" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186283915}] :answer-field/correct {:answer/id #uuid "c6c96545-d7a5-52c1-9192-98a70711e282" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186283915} :answer-field/id #uuid "9844d9c3-fe87-50ae-a3f3-bcc590a114eb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283914} {:answer-field/choices [{:answer/id #uuid "9fa0692c-2190-57f2-9658-952ea4bb7ddc" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283917}] :answer-field/correct {:answer/id #uuid "9fa0692c-2190-57f2-9658-952ea4bb7ddc" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283917} :answer-field/id #uuid "a9a92ed0-63c1-5615-96bb-82f6a0a20b11" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283916} {:answer-field/choices [{:answer/id #uuid "679e02a9-a0bf-5fd3-9cea-a0ae1824276f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186283919}] :answer-field/correct {:answer/id #uuid "679e02a9-a0bf-5fd3-9cea-a0ae1824276f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186283919} :answer-field/id #uuid "8b109513-6e6d-5359-80e0-475856c5e8ea" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283918}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0ae6351e-00df-5331-8db9-fd4755bafd57" :question/math-academy-id "q-278373" :question/problem "From **top to bottom**, the points where the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{4}=1$ intersects the line $x=-5$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-5,$ we substitute $x=-5$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(-5)^{2}}{16}-\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{25}{16}-\\frac{{y}^{2}}{4} & =1 \\\\ -\\frac{{y}^{2}}{4} & =1-\\frac{25}{16} \\\\ -\\frac{{y}^{2}}{4} & =-\\frac{9}{16} \\\\ {y}^{2} & =\\frac{9}{4} \\\\ y & =\\pm \\frac{3}{2} \\\\ y & =\\pm 1.5\\end{aligned}\n$$\n\nTherefore, from top to bottom, the hyperbola intersects the vertical line $x=-5$  at the points $(-5,1.5)$ and $(-5,-1.5).$"}] [{:db/id #edb/ref 17592186283920 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0f82e03-42ab-5e97-93ec-60faac9d712c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm \\sqrt{3})" :db/id #edb/ref 17592186283922} {:answer/id #uuid "16c03873-2ba6-5063-ade2-371c2f8d33d2" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186283923} {:answer/id #uuid "ca3434e1-4878-5580-8142-fd2f32e37ff7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 4)" :db/id #edb/ref 17592186283924} {:answer/id #uuid "f4ea7d23-df7e-513c-a31a-30666f20348d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186283925} {:answer/id #uuid "22e8cb44-876f-5c9b-aa19-1542bcda5d05" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\sqrt{3})" :db/id #edb/ref 17592186283926}] :answer-field/correct {:answer/id #uuid "f4ea7d23-df7e-513c-a31a-30666f20348d" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186283925} :answer-field/id #uuid "b7965586-7df4-541e-a243-13c64cc6e16c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283921}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ebcf9a7e-cc8c-5b47-b689-c3ad817ae440" :question/math-academy-id "q-84039" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{16}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{16} & =1 \\\\ \\frac{(0)^{2}}{3}-\\frac{{y}^{2}}{16} & =1 \\\\ -\\frac{{y}^{2}}{16} & =1 \\\\ {y}^{2} & =-16\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions.\nSo, there are no $y$-intercepts."}]}
