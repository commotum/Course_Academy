ad3c-074576b47ad0" :question/math-academy-id "q-1399" :question/problem "Let $a=8i-2j+4k$ and $b=6i+4j-\\frac{1}{2}k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 8 & -2 & 4 \\\\ 6 & 4 & -\\frac{1}{2}\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 4 \\\\ 4 & -\\frac{1}{2}\\end{aligned}|i-|\\begin{aligned}8 & 4 \\\\ 6 & -\\frac{1}{2}\\end{aligned}|j+|\\begin{aligned}8 & -2 \\\\ 6 & 4\\end{aligned}|k \\\\  & =(1-16)i-(-4-24)j+(32+12)k \\\\  & =-15i+28j+44k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1399/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-1399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103547/selection/27673acb31982aad326083ed45d0482b3851682151ac9cd81818ee558c618ef2" :answer/id #uuid "5898ca27-7795-55c5-846e-651f32800090" :answer/type :answer.type/math :answer/value "x=-4,\\,5" :db/ensure [:answer/validate]} {:db/id "q-103547/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" :answer/id #uuid "e2d8f49a-ac79-5aa8-9637-61fba5e4b214" :answer/type :answer.type/math :answer/value "x=\\pm 2" :db/ensure [:answer/validate]} {:db/id "q-103547/selection/51eec184e4fd9fe5abe3746fe3bdfa508fa7659b193787c475da37e087d79bab" :answer/id #uuid "25775d08-2f25-53de-a6f2-028500aa7b98" :answer/type :answer.type/math :answer/value "x=-10,\\,-2" :db/ensure [:answer/validate]} {:db/id "q-103547/selection/dd6494e721d8f4fadbbdc278eb193c4b58fb725140f02509f190953b790cf551" :answer/id #uuid "3d3c4a9a-0557-5dd1-9672-84ca7e477e92" :answer/type :answer.type/math :answer/value "x=4,\\,10" :db/ensure [:answer/validate]} {:db/id "q-103547/selection/2b1cad474aea051f1110a0a522cc0e4f8033b952cfe87b0ed4c763c05b17cc27" :answer/id #uuid "5a946484-d586-5a18-bc3c-1328150dcbf0" :answer/type :answer.type/math :answer/value "x=-5,\\,4" :db/ensure [:answer/validate]} {:db/id "q-103547/selection" :answer-field/id #uuid "d340f1c0-c943-51d1-b94b-5d26117cf02a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103547/selection/51eec184e4fd9fe5abe3746fe3bdfa508fa7659b193787c475da37e087d79bab" :answer-field/choices ["q-103547/selection/27673acb31982aad326083ed45d0482b3851682151ac9cd81818ee558c618ef2" "q-103547/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" "q-103547/selection/51eec184e4fd9fe5abe3746fe3bdfa508fa7659b193787c475da37e087d79bab" "q-103547/selection/dd6494e721d8f4fadbbdc278eb193c4b58fb725140f02509f190953b790cf551" "q-103547/selection/2b1cad474aea051f1110a0a522cc0e4f8033b952cfe87b0ed4c763c05b17cc27"] :db/ensure [:answer-field/validate]} {:db/id "q-103547" :question/id #uuid "fec673f5-a44e-512e-bccb-25dc535fa5f3" :question/math-academy-id "q-103547" :question/problem "Let $a=⟨4,x,3⟩,$ $b=⟨-2,3,0⟩$ and $|\\,a\\times b\\,|=\\sqrt{181}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & x & 3 \\\\ -2 & 3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}x & 3 \\\\ 3 & 0\\end{aligned}|i-|\\begin{aligned}4 & 3 \\\\ -2 & 0\\end{aligned}|j+|\\begin{aligned}4 & x \\\\ -2 & 3\\end{aligned}|k \\\\  & =(0-9)i-(0+6)j+(12+2x)k \\\\  & =⟨-9,-6,12+2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-9)^{2}+(-6)^{2}+(12+2x)^{2}} \\\\  & =\\sqrt{81+36+144+48x+4{x}^{2}} \\\\  & =\\sqrt{261+48x+4{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{181} \\\\ \\sqrt{261+48x+4{x}^{2}} & =\\sqrt{181} \\\\ 261+48x+4{x}^{2} & =181 \\\\ 4{x}^{2}+48x+80 & =0 \\\\ {x}^{2}+12x+20 & =0 \\\\ (x+10)(x+2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-10,\\,-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103547/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-103547"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103552/selection/29d37980bea6d7b86a377f991452e33534f252cbadacead342b0b34fbcaa9d60" :answer/id #uuid "4f0cb6b0-78c4-5cee-ab00-3caf9cadda54" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2},\\,2" :db/ensure [:answer/validate]} {:db/id "q-103552/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" :answer/id #uuid "c31e2fb8-44e8-5c3b-ade2-76d683db5509" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "q-103552/selection/1c93b39cdb1a0c666ed0cb6fd5b649313cace22d0d1fd6b4ce40388fe7947cd3" :answer/id #uuid "60440a4c-439d-5119-905c-67561e30bf29" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2},\\,1" :db/ensure [:answer/validate]} {:db/id "q-103552/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" :answer/id #uuid "5a5a3a32-3ec7-5c09-8e70-b9cf5a31ac91" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "q-103552/selection/145c255ad7254d325dd21b7760a9aa39978dc9797aa24c756460dd0d4ec02826" :answer/id #uuid "f787e2a1-a108-57d6-a197-91332c4c5fd5" :answer/type :answer.type/math :answer/value "x=-1,\\,2" :db/ensure [:answer/validate]} {:db/id "q-103552/selection" :answer-field/id #uuid "ef892121-e7d4-5b3e-aa02-ae932bf62f5b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103552/selection/1c93b39cdb1a0c666ed0cb6fd5b649313cace22d0d1fd6b4ce40388fe7947cd3" :answer-field/choices ["q-103552/selection/29d37980bea6d7b86a377f991452e33534f252cbadacead342b0b34fbcaa9d60" "q-103552/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" "q-103552/selection/1c93b39cdb1a0c666ed0cb6fd5b649313cace22d0d1fd6b4ce40388fe7947cd3" "q-103552/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" "q-103552/selection/145c255ad7254d325dd21b7760a9aa39978dc9797aa24c756460dd0d4ec02826"] :db/ensure [:answer-field/validate]} {:db/id "q-103552" :question/id #uuid "02a5a42a-3364-5f22-881f-c1eb596575d7" :question/math-academy-id "q-103552" :question/problem "Let $a=⟨0,-2,3⟩,$ $b=⟨-2,1,-2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{53}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & -2 & 3 \\\\ -2 & 1 & -2x\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & -2x\\end{aligned}|i-|\\begin{aligned}0 & 3 \\\\ -2 & -2x\\end{aligned}|j+|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(4x-3)i-(0+6)j+(0-4)k \\\\  & =⟨4x-3,-6,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x-3)^{2}+(-6)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16{x}^{2}-24x+9+36+16} \\\\  & =\\sqrt{16{x}^{2}-24x+61}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{53} \\\\ \\sqrt{16{x}^{2}-24x+61} & =\\sqrt{53} \\\\ 16{x}^{2}-24x+61 & =53 \\\\ 16{x}^{2}-24x+8 & =0 \\\\ 2{x}^{2}-3x+1 & =0 \\\\ (2x-1)(x-1) & =0 \\\\ x & =\\frac{1}{2},\\,1.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{1}{2},\\,1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103552/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-103552"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275275/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "903ce392-3de4-5cf7-9024-f6e05e35117c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-275275/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f