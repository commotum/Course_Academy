\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] & =[\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] \\\\ r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] & =-11.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161"] :knowledge-point/questions ["q-70647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127632/selection/640f0a3ba507900aee74ee3ce6e51d7f5259c6b1380ad5374d50d1da67e99e7f" :answer/id #uuid "1b2b0286-66e8-516f-a8b7-1ca48dcba398" :answer/type :answer.type/math :answer/value "r\\cdot (\\sqrt{5}i-3j+2k)=6" :db/ensure [:answer/validate]} {:db/id "q-127632/selection/fb2902b772081154631487c5eff3fb62f56fc1ac2feac33a0eaa718844e9c5d5" :answer/id #uuid "2afa7e37-9476-5a37-a9ae-586bd4f465d8" :answer/type :answer.type/math :answer/value "r\\cdot (\\sqrt{5}i-j-2k)=12" :db/ensure [:answer/validate]} {:db/id "q-127632/selection/26bd1799c67b8a837e005eb90e02489eccef40214a975f6b83d0600266ae4630" :answer/id #uuid "90838ea8-74d7-56bf-9ac7-24deb39925d9" :answer/type :answer.type/math :answer/value "r\\cdot (5i-3j+2k)=1" :db/ensure [:answer/validate]} {:db/id "q-127632/selection/7791d321a88356fc84ba4ecd031a4e2e1b986ce863cc58583a2bb322ed511e0d" :answer/id #uuid "5578b1ed-02f4-511b-9cf9-f71ebee10f3b" :answer/type :answer.type/math :answer/value "r\\cdot (\\sqrt{5}i-3j+2k)=12" :db/ensure [:answer/validate]} {:db/id "q-127632/selection/46e6f2a6a4156c80ff381ec29cf6e2ca4c703a6778d97e6ab2be1d4d52c14e30" :answer/id #uuid "22299f7d-aef2-5792-a599-5b7cdbd54798" :answer/type :answer.type/math :answer/value "r\\cdot (\\sqrt{5}i+2j-3k)=6" :db/ensure [:answer/validate]} {:db/id "q-127632/selection" :answer-field/id #uuid "7bc7438a-c90e-5587-a424-da9ae19cc227" :answer-field/key "selection" :answer-fie