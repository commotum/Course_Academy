417] [17592186069802 #edb/ref 1062 #uuid "902d72dc-3d73-5330-9c00-fadbefe5a559" #edb/ref 17592186045417] [17592186069802 #edb/ref 1063 #edb/ref 17592186070030 #edb/ref 17592186045417] [17592186069803 #edb/ref 1058 #edb/ref 17592186069804 #edb/ref 17592186045417] [17592186069803 #edb/ref 1061 442845 #edb/ref 17592186045417] [17592186069803 #edb/ref 1062 #uuid "cb1059e4-1e66-5fbd-b127-18f2fa4cf7eb" #edb/ref 17592186045417] [17592186069803 #edb/ref 1063 #edb/ref 17592186068853 #edb/ref 17592186045417] [17592186069804 #edb/ref 1058 #edb/ref 17592186069805 #edb/ref 17592186045417] [17592186069804 #edb/ref 1061 442849 #edb/ref 17592186045417] [17592186069804 #edb/ref 1062 #uuid "cd1fd0e6-a7e9-5fa2-8560-798eef76b3dd" #edb/ref 17592186045417] [17592186069804 #edb/ref 1063 #edb/ref 17592186068854 #edb/ref 17592186045417] [17592186069805 #edb/ref 1058 #edb/ref 17592186069806 #edb/ref 17592186045417] [17592186069805 #edb/ref 1061 442852 #edb/ref 17592186045417] [17592186069805 #edb/ref 1062 #uuid "ffc36223-0640-50b6-bde4-0b7af3bf0642" #edb/ref 17592186045417] [17592186069805 #edb/ref 1063 #edb/ref 17592186068855 #edb/ref 17592186045417] [17592186069806 #edb/ref 1061 442855 #edb/ref 17592186045417] [17592186069806 #edb/ref 1062 #uuid "3f8c6957-fb74-5c1d-9110-0699559d48a4" #edb/ref 17592186045417] [17592186069806 #edb/ref 1063 #edb/ref 17592186068856 #edb/ref 17592186045417] [17592186070030 #edb/ref 1064 "Consider the following integral:\n\n$$\n\\int \\dfrac{1}{x^2+2x+5}\\, \\textrm{d}x\n$$\n\nThis integral doesn't resemble any of the standard integrals we have encountered so far.\n\nHowever, notice that we can complete the square in the denominator as follows:\n\n$$\n\\begin{aligned}{x}^{2}+2x+5 & ={x}^{2}+2\\cdot 1\\cdot x+5 \\\\  & ={x}^{2}+2\\cdot 1\\cdot x+({1}^{2}-{1}^{2})+5 \\\\  & =({x}^{2}+2\\cdot 1\\cdot x+{1}^{2})-{1}^{2}+5 \\\\  & =(x+1)^{2}+4\\end{aligned}\n$$\n\nIf we plug the above into our integral and collect a factor of ${\\color{red}{4}}$, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}+2x+5}\\,\\text{d}x & =\\int \\frac{1}{(x+1)^{2}+4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{4[(x+1)^{2}/4+1]}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{(x+1)^{2}/4+1}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+(x+1)^{2}/4}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+((x+1)/2)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nNotice that this now resembles the basic integral for inverse tangent:\n\n$$\n\\int \\dfrac{1}{1+u^2} \\, \\textrm{d}u = \\arctan u + C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\left(\\dfrac{x+1}{2}\\right).$\n\nSo, let's perform the substitution\n\n$$\nu=\\dfrac{x+1}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{2}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = 2\\,\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}+2x+5}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1+((x+1)/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}(\\frac{x+1}{2})+C\\end{aligned}\n$$\n\nAnd we're done!" #edb/ref 17592186045417] [17592186070030 #edb/ref 1065 9006 #edb/ref 17592186045417] [17592186070030 #edb/ref 1066 #uuid "fa12f0db-7152-56d9-b243-3e761f5f2786" #edb/ref 17592186045417] [17592186070030 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186247794 #edb/ref 1080 "\\frac{1}{2}\\text{arcsec}(2x-7)+C" #edb/ref 17592186045417] [17592186247794 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247794 #edb/ref 1083 #uuid "29dcd689-72bf-5686-8310-3f4ea4bcf96f" #edb/ref 17592186045417] [17592186248430 #edb/ref 1080 "2\\,\\text{arcsec}(2x-7)+C" #edb/ref 17592186045417] [17592186248430 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248430 #edb/ref 1083 #uuid "7314371c-12e4-5b55-aa71-8b0815acf1f3" #edb/ref 17592186045417] [17592186248633 #edb/ref 1080 "\\text{arcsec}(2x-7)+C" #edb/ref 17592186045417] [17592186248633 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248633 #edb/ref 1083 #uuid "87412b14-93b3-5355-a1a5-6ed1ad4a5e68" #edb/ref 17592186045417] [17592186248921 #edb/ref 1080 "4\\,\\text{arcsec}(2x-7)+C" #edb/ref 17592186045417] [17592186248921 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248921 #edb/ref 1083 #uuid "a875d9a9-1360-585e-bc17-f8dabea475cc" #edb/ref 17592186045417] [17592186249247 #edb/ref 1080 "\\frac{1}{4}\\text{arcsec}(2x-7)+C" #edb/ref 17592186045417] [17592186249247 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186249247 #edb/ref 1083 #uuid "cd50af5e-b746-5d70-8359-da9db445f575" #edb/ref 17592186045417] [17592186250083 #edb/ref 1075 #edb/ref 17592186247794 #edb/ref 17592186045417] [17592186250083 #edb/ref 1075 #edb/ref 17592186248430 #edb/ref 17592186045417] [17592186250083 #edb/ref 1075 #edb/ref 17592186248633 #edb/ref 17592186045417] [17592186250083 #edb/ref 1075 #edb/ref 17592186248921 #edb/ref 17592186045417] [17592186250083 #edb/ref 1075 #edb/ref 17592186249247 #edb/ref 17592186045417] [17592186250083 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186250083 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186250083 #edb/ref 1078 #edb/ref 17592186248633 #edb/ref 17592186045417] [17592186250083 #edb/ref 1079 #uuid "ecf1fad6-0be7-535a-8535-84a302eff6c9" #edb/ref 17592186045417] [17592186250323 #edb/ref 1068 #edb/ref 17592186250083 #edb/ref 17592186045417] [17592186250323 #edb/ref 1069 "q-114926" #edb/ref 17592186045417] [17592186250323 #edb/ref 1070 #edb/ref 17592186045486 #edb/ref 17592186045417] [17592186250323 #edb/ref 1071 "$\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x=$" #edb/ref 17592186045417] [17592186250323 #edb/ref 1072 #uuid "d6c81b22-316a-514d-b9b9-16489eee9df0" #edb/ref 17592186045417] [17592186250323 #edb/ref 1074 "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x-7).$\n\nSo, let's perform the substitution \n\n$$\nu=2x-7.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(2x-7)+C\\end{aligned}\n$$" #edb/ref 17592186045417]}
