#{[{:db/id #edb/ref 17592186250323 :knowledge-point/_questions [{:db/id #edb/ref 17592186068853 :knowledge-point/id #uuid "2fca8969-c914-5ed2-a492-0addc197ce72" :knowledge-point/title "Calculating Inverse Trigonometric Function Integrals Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29dcd689-72bf-5686-8310-3f4ea4bcf96f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186247794} {:answer/id #uuid "7314371c-12e4-5b55-aa71-8b0815acf1f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248430} {:answer/id #uuid "87412b14-93b3-5355-a1a5-6ed1ad4a5e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248633} {:answer/id #uuid "a875d9a9-1360-585e-bc17-f8dabea475cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248921} {:answer/id #uuid "cd50af5e-b746-5d70-8359-da9db445f575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186249247}] :answer-field/correct {:answer/id #uuid "87412b14-93b3-5355-a1a5-6ed1ad4a5e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(2x-7)+C" :db/id #edb/ref 17592186248633} :answer-field/id #uuid "ecf1fad6-0be7-535a-8535-84a302eff6c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250083}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d6c81b22-316a-514d-b9b9-16489eee9df0" :question/math-academy-id "q-114926" :question/problem "$\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x-7).$\n\nSo, let's perform the substitution \n\n$$\nu=2x-7.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(2x-7)+C\\end{aligned}\n$$"}]}
