2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-3).$\n\nSo, let's perform the substitution \n\n$$\nu=x-3.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x-3|\\sqrt{(x-3)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(x-3)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114923/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fca8969-c914-5ed2-a492-0addc197ce72"] :knowledge-point/questions ["q-114923"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114926/selection/4f9303020ff24071dac5442b70c72962ae9364895a16a1265ae138d78522be1c" :answer/id #uuid "83759bb4-35c2-5617-8baf-d53388173b10" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\text{arcsec}(2x-7)+C" :db/ensure [:answer/validate]} {:db/id "q-114926/selection/9b3aaffddad80b6bd2d07ad0388e7233eea4e210a63671f2ab616427cf84fd40" :answer/id #uuid "368f2d7e-ee9b-521f-8b8d-329f658f5aa6" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(2x-7)+C" :db/ensure [:answer/validate]} {:db/id "q-114926/selection/1d5afaade9f57dca80c0fca67f87ae7a8f7edf531e880dfd0f0b974c41e8e4ba" :answer/id #uuid "72d822e8-df7c-50e0-b8b4-b41079ddb825" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\text{arcsec}(2x-7)+C" :db/ensure [:answer/validate]} {:db/id "q-114926/selection/3e4dd3de220293893e31175577519f470913496e3db0a11c67c46553a24be9e6" :answer/id #uuid "e4cd1339-cdf6-5e40-a452-fda68c4390fe" :answer/type :answer.type/math :answer/value "\\text{arcsec}(2x-7)+C" :db/ensure [:answer/validate]} {:db/id "q-114926/selection/b96274d0eafd5fc630e56da9a3dda53c56c9520eae8cab40dba2d2e2034c8cb3" :answer/id #uuid "18478743-6d72-5aa3-8ba5-f1fb882e0b7f" :answer/type :answer.type/math :answer/value "4\\,\\text{arcsec}(2x-7)+C" :db/ensure [:answer/validate]} {:db/id "q-114926/selection" :answer-field/id #uuid "4fe87f52-1903-58ce-966a-ffa328dbd257" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114926/selection/9b3aaffddad80b6bd2d07ad0388e7233eea4e210a63671f2ab616427cf84fd40" :answer-field/choices ["q-114926/selection/4f9303020ff24071dac5442b70c72962ae9364895a16a1265ae138d78522be1c" "q-114926/selection/9b3aaffddad80b6bd2d07ad0388e7233eea4e210a63671f2ab616427cf84fd40" "q-114926/selection/1d5afaade9f57dca80c0fca67f87ae7a8f7edf531e880dfd0f0b974c41e8e4ba" "q-114926/selection/3e4dd3de220293893e31175577519f470913496e3db0a11c67c46553a24be9e6" "q-114926/selection/b96274d0eafd5fc630e56da9a3dda53c56c9520eae8cab40dba2d2e2034c8cb3"] :db/ensure [:answer-field/validate]} {:db/id "q-114926" :question/id #uuid "221832ca-e386-5d28-a4c3-7b381df79beb" :question/math-academy-id "q-114926" :question/problem "$\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x-7).$\n\nSo, let's perform the substitution \n\n$$\nu=2x-7.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{4}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x-7|\\sqrt{(2x-7)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(2x-7)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114926/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fca8969-c914-5ed2-a492-0addc197ce72"] :knowledge-point/questions ["q-114926"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-114906"] :question/problem "$\\int \\frac{1}{(2x-3)^{2}+4}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{(2x-3)^{2}+4}\\,\\text{d}x & =\\int \\frac{1}{4((2x-3)^{2}/4+1)}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+(2x-3)^{2}/4}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+((2x-3)/2)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{2x-3}{2}).$\n\nSo, let's perform the substitution \n\n$$\nu=\\frac{2x-3}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{(2x-3)^{2}+4}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1+((2x-3)/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{2x-3}{2})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-19527/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "8bb06adb-d268-5637-8dd8-4924aeb0ae21" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-19527/selection/94786ff5da18eca7b34968478ef0ca21ee840249e1ca4e89186df64931ae3be0" :answer/id #uuid "1a6a02c8-3b4c-5a99-98b0-0f18b251a08e" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-19527/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ce922632-a3c9-5efd-ba8c-332ae6262352" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-19527/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98" :answer/id #uuid "9bab1b50-1b32-578e-ba20-924ef4f520cb" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-19527/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0c87793f-9b74-52d8-9a3a-2c1313823f95" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-19527/selection" :answer-field/id #uuid "28ef12ff-d148-51b2-924b-8a963408fabb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19527/selection/94786ff5da18eca7b34968478ef0ca21ee840249e1ca4e89186df64931ae3be0" :answer-field/choices ["q-19527/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-19527/selection/94786ff5da18eca7b34968478ef0ca21ee840249e1ca4e89186df64931ae3be0" "q-19527/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-19527/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98" "q-19527/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-19527" :question/id #uuid "e78637ee-142d-5498-8358-000fe537dac0" :question/math-academy-id "q-19527" :question/problem "Evaluate the integral ${\\int }_{3}^{3+\\sqrt{3}}\\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-6x+10 & ={x}^{2}-2\\cdot 3x+({3}^{2}-{3}^{2})+10 \\\\  & =({x}^{2}+2\\cdot 3x+{3}^{2})-9+10 \\\\  & =(x-3)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x & =\\int \\frac{5}{(x-3)^{2}+1}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{1+(x-3)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-3).$\n\nSo, let's perform the substitution\n\n$$\nu=x-3.\n$$\n\n \nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $3$ | $3+\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{3}^{3+\\sqrt{3}}\\frac{5}{{x}^{2}-6x+10}\\,\\text{d}x & =5{\\int }_{3}^{3+\\sqrt{3}}\\frac{1}{1+(x-3)^{2}}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =5\\operatorname{arctan}⁡u\\,{|}_{0}^{\\sqrt{3}} \\\\  & =5(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡0) \\\\  & =5(\\frac{\\pi }{3}-0) \\\\  & =5(\\frac{\\pi }{3}) \\\\  & =\\frac{5\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19527/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff"] :knowledge-point/questions ["q-19527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348570/field-1/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0" :answer/id #uuid "5962bdf2-38a4-5364-bdcd-ce8c421c1bfd" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-348570/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203" :answer/id #uuid "2fbe6fe7-068e-5354-8619-a9249365a932" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-348570/field-1" :answer-field/id #uuid "03211610-2eaf-5d3c-a0c7-b3bfd62133db" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348570/field-1/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0" :answer-field/choices ["q-348570/field-1/7ef186fd8b5a1c52c90d35337c0050c3c2cd876fe199bd9866d5167b1165edd0" "q-348570/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203"] :db/ensure [:answer-field/validate]} {:db/id "q-348570" :question/id #uuid "300779b2-6c1e-5908-a102-8f06afbf164c" :question/math-academy-id "q-348570" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4-1/\\sqrt{3}}^{5}\\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-8x+17 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+17 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+17 \\\\  & =(x-4)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x & =\\int \\frac{3}{(x-4)^{2}+1}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{1+(x-4)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-4).$\n\nSo, let's perform the substitution\n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $4-\\frac{1}{\\sqrt{3}}$ | $5$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{\\sqrt{3}}$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{4-1/\\sqrt{3}}^{5}\\frac{3}{{x}^{2}-8x+17}\\,\\text{d}x & =3{\\int }_{-1/\\sqrt{3}}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =3\\operatorname{arctan}⁡u\\,{|}_{-1/\\sqrt{3}}^{1} \\\\  & =3(\\operatorname{arctan}⁡(1)-arctan\\,(-\\frac{1}{\\sqrt{3}})) \\\\  & =3(\\frac{\\pi }{4}-(-\\frac{\\pi }{6})) \\\\  & =3(\\frac{5\\pi }{12}) \\\\  & =\\frac{5\\pi }{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348570/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff"] :knowledge-point/questions ["q-348570"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348554/field-1/6568a7f527cbccabebc1d2e55fba33e6d92cc0555602b7b829eae080d006da93" :answer/id #uuid "7671c97c-2afb-50f1-8a52-8a5fdd530304" :answer/type :answer.type/math :answer/value "3\\pi" :db/ensure [:answer/validate]} {:db/id "q-348554/field-1" :answer-field/id #uuid "6018a901-83d4-586a-be85-47dd39a7b727" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348554/field-1/6568a7f527cbccabebc1d2e55fba33e6d92cc0555602b7b829eae080d006da93" :answer-field/choices ["q-348554/field-1/6568a7f527cbccabebc1d2e55fba33e6d92cc0555602b7b829eae080d006da93"] :db/ensure [:answer-field/validate]} {:db/id "q-348554" :question/id #uuid "49bc5d77-ad19-594f-a0c9-4b98d2248f7a" :question/math-academy-id "q-348554" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3}\\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+5 & ={x}^{2}-2\\cdot 2x+({2}^{2}-{2}^{2})+5 \\\\  & =({x}^{2}-2\\cdot 2x+{2}^{2})-4+5 \\\\  & =(x-2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x & =\\int \\frac{6}{(x-2)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x-2)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-2).$\n\nSo, let's perform the substitution\n\n$$\nu=x-2.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{6}{{x}^{2}-4x+5}\\,\\text{d}x & =6{\\int }_{-1}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{-1}^{1} \\\\  & =6(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(-1)) \\\\  & =6(\\frac{\\pi }{4}-(-\\frac{\\pi }{4})) \\\\  & =6(\\frac{\\pi }{2}) \\\\  & =3\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348554/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff"] :knowledge-point/questions ["q-348554"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114910/selection/b38c0d59b7527f34d3c26c056b03109f263e7eb293b089b7501d5d90c273c392" :answer/id #uuid "ce8eab86-4d58-553c-9802-19c20e12297e" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-114910/selection/c34a2b6072aafccddfb2997fe500c2294473e01b0408af60fe38b09d863e2b38" :answer/id #uuid "cd1843d0-e852-5c0f-95ee-8071b6b71345" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-114910/selection/7c0c6d46ea88f2ff065875257e5f65252ceb9bdbd924edd49e27e1f83a7b22d4" :answer/id #uuid "f90a7b86-a616-564b-b503-9ca68157feb0" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x-3)+C" :db/ensure [:answer/validate]} {:db/id "q-114910/selection/e1b686ab0cd29dcfdc7a27d66c14d72820adce0b66b52901f67cadeea832eb10" :answer/id #uuid "55d03b51-bcaa-5e9f-8ed8-6db0a96fdf74" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(x-3)+C" :db/ensure [:answer/validate]} {:db/id "q-114910/selection/1ee724039173e7c7b7d34b7e63d243c122da76b77653e41b8550fd1619f9ecf3" :answer/id #uuid "fc4e2844-9405-5fed-a29f-dab9b853f6b4" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-114910/selection" :answer-field/id #uuid "f8bed8b0-61d4-5251-8dbf-7d8696065cf1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114910/selection/b38c0d59b7527f34d3c26c056b03109f263e7eb293b089b7501d5d90c273c392" :answer-field/choices ["q-114910/selection/b38c0d59b7527f34d3c26c056b03109f263e7eb293b089b7501d5d90c273c392" "q-114910/selection/c34a2b6072aafccddfb2997fe500c2294473e01b0408af60fe38b09d863e2b38" "q-114910/selection/7c0c6d46ea88f2ff065875257e5f65252ceb9bdbd924edd49e27e1f83a7b22d4" "q-114910/selection/e1b686ab0cd29dcfdc7a27d66c14d72820adce0b66b52901f67cadeea832eb10" "q-114910/selection/1ee724039173e7c7b7d34b7e63d243c122da76b77653e41b8550fd1619f9ecf3"] :db/ensure [:answer-field/validate]} {:db/id "q-114910" :question/id #uuid "d6681a8c-31b6-5f48-9d3b-97034642ec2f" :question/math-academy-id "q-114910" :question/problem "$\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-6x+18 & ={x}^{2}-2\\cdot 3x+({3}^{2}-{3}^{2})+18 \\\\  & =({x}^{2}-2\\cdot 3x+{3}^{2})-9+18 \\\\  & =(x-3)^{2}+9\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x & =\\int \\frac{1}{(x-3)^{2}+9}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+((x-3)/3)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-3}{3}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-3}{3}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-6x+18}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+((x-3)/3)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot 3\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x-3}{3})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114910/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff"] :knowledge-point/questions ["q-114910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3588/selection/de1315c221e256841ffdfc5fd8eca9afa0b783498f7106f853f0461a1512e04f" :answer/id #uuid "75244f30-917f-55be-a4b3-7232ca8913af" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{cot}^{-1}⁡(\\frac{x-4}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-3588/selection/88c20a7407d71ffff6531949b431231851cf1467d20e4c962bd98ae328bb87ac" :answer/id #uuid "36a04d97-3a55-5e8f-9aaf-283c1cdb5feb" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x-4}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-3588/selection/d16b32c4ab3be26fb9367cc1475d8c26dc515a96e662b4406750bd96ac7434b0" :answer/id #uuid "23dd957e-6734-5a93-b8e0-c7889c95d246" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arccos}⁡(\\frac{x-4}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-3588/selection/f96be783a95e689a4874779ed11afb22cd5ee03c0c121d90e127ccebac15256a" :answer/id #uuid "9106dc59-2daa-5719-ad25-9a4451fc5d0e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x-4}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-3588/selection/956b3c9ab40077608b7951bbde2a2736232809ee4062739160765dbff8ba997e" :answer/id #uuid "2e5d42fb-c0d8-5f9d-9b1a-00771ab15317" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{cot}^{-1}⁡(\\frac{x-4}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-3588/selection" :answer-field/id #uuid "8111a402-de5b-5641-baca-fa89eca50b62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3588/selection/f96be783a95e689a4874779ed11afb22cd5ee03c0c121d90e127ccebac15256a" :answer-field/choices ["q-3588/selection/de1315c221e256841ffdfc5fd8eca9afa0b783498f7106f853f0461a1512e04f" "q-3588/selection/88c20a7407d71ffff6531949b431231851cf1467d20e4c962bd98ae328bb87ac" "q-3588/selection/d16b32c4ab3be26fb9367cc1475d8c26dc515a96e662b4406750bd96ac7434b0" "q-3588/selection/f96be783a95e689a4874779ed11afb22cd5ee03c0c121d90e127ccebac15256a" "q-3588/selection/956b3c9ab40077608b7951bbde2a2736232809ee4062739160765dbff8ba997e"] :db/ensure [:answer-field/validate]} {:db/id "q-3588" :question/id #uuid "5e3ad59e-5530-5f96-9f4b-8c2f8b5873d3" :question/math-academy-id "q-3588" :question/problem "$\\int \\frac{1}{{x}^{2}-8x+20}\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-8x+20 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+20 \\\\  & =({x}^{2}-2\\cdot 4x+{4}^{2})-16+20 \\\\  & =(x-4)^{2}+4\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-8x+20}\\,\\text{d}x & =\\int \\frac{1}{(x-4)^{2}+4}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+((x-4)/2)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-4}{2}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-4}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-8x+20}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1+((x-4)/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x-4}{2})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-3588/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6aa497df-853e-5e77-9d43-6183fa53ffff"] :knowledge-point/questions ["q-3588"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270105/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "ab49e003-e88e-51d6-93f1-472fcdd040d6" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-270105/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "e11312a4-c456-51e5-8a30-68446cc09a00" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-270105/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" :answer/id #uuid "b3b6d904-b1b7-5c8d-9e99-ebffdc67a8dd" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-270105/selection/26734acc4349599b013ff5890611204a590e31e398b69a9ba8c4c553e3de6e98" :answer/id #uuid "9fdebd8b-bdc1-5e45-80a5-9a3f66c963d7" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-270105/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "51331f52-9825-5234-b4f0-96c70ab174eb" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-270105/selection" :answer-field/id #uuid "64b15f1f-3ed7-58a8-bf44-c7b7b48bff3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-270105/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer-field/choices ["q-270105/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-270105/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-270105/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" "q-270105/selection/26734acc4349599b013ff5890611204a590e31e398b69a9ba8c4c553e3de6e98" "q-270105/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951"] :db/ensure [:answer-field/validate]} {:db/id "q-270105" :question/id #uuid "c4624471-57ca-5285-8ea0-5ae498ff1110" :question/math-academy-id "q-270105" :question/problem "Evaluate the integral ${\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-4x-3 & =-({x}^{2}+4x+3) \\\\  & =-({x}^{2}+2\\cdot 2x+[{2}^{2}-{2}^{2}]+3) \\\\  & =-((x+2)^{2}-1) \\\\  & =1-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x={\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x+2.$\n\nSo, let's perform the substitution\n\n$$\nu=x+2.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-5/2$ | $-3/2$ |\n| --- | --- | --- |\n| $u$ | $-1/2$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{-{x}^{2}-4x-3}}\\,\\text{d}x & ={\\int }_{-5/2}^{-3/2}\\frac{1}{\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-270105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a"] :knowledge-point/questions ["q-270105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270103/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "44cc03d4-d63e-5d74-b3c1-ccafcf64985c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-270103/selection/94786ff5da18eca7b34968478ef0ca21ee840249e1ca4e89186df64931ae3be0" :answer/id #uuid "2e4d6847-2ccf-59b0-8def-c166b0ac6c66" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-270103/selection/a996cecead059c2e05b8ded2ceb60e4e2170a4344e0c20625524ed13b23c6fbe" :answer/id #uuid "a2461bfe-66cf-50fe-a011-0cbc5ec1fb3f" :answer/type :answer.type/math :answer/value "3\\pi " :db/ensure [:answer/validate]} {:db/id "q-270103/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "a5635b89-a1ab-5a2b-9999-1f49cad0e3ff" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-270103/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a" :answer/id #uuid "ec8b8aaf-d204-5921-b8dc-46aa10be26f1" :answer/type :answer.type/math :answer/value "5\\pi " :db/ensure [:answer/validate]} {:db/id "q-270103/selection" :answer-field/id #uuid "556d78ea-74f4-5e0e-850e-f8b58048555d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-270103/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a" :answer-field/choices ["q-270103/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-270103/selection/94786ff5da18eca7b34968478ef0ca21ee840249e1ca4e89186df64931ae3be0" "q-270103/selection/a996cecead059c2e05b8ded2ceb60e4e2170a4344e0c20625524ed13b23c6fbe" "q-270103/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-270103/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a"] :db/ensure [:answer-field/validate]} {:db/id "q-270103" :question/id #uuid "badf1a99-06f8-53a3-a425-75f049c0400e" :question/math-academy-id "q-270103" :question/problem "Evaluate the integral ${\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-12-x(x+12) & =-12-({x}^{2}+12x) \\\\  & =-12-({x}^{2}+12x+36-36) \\\\  & =-12-((x+6)^{2}-36) \\\\  & =24-(x+6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24-(x+6)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24(1-(x+6)^{2}/24)}}\\,\\text{d}x \\\\  & ={\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{24}\\cdot \\sqrt{1-(x+6)^{2}/(2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x+6}{2\\sqrt{6}}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x+6}{2\\sqrt{6}}.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{6}}\\,⟹\\,\\text{d}x=2\\sqrt{6}\\,\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-6-\\sqrt{6}$ | $-6+\\sqrt{6}$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{15}{\\sqrt{-12-x(x+12)}}\\,\\text{d}x & =\\frac{15}{2\\sqrt{6}}{\\int }_{-6-\\sqrt{6}}^{-6+\\sqrt{6}}\\frac{1}{\\sqrt{1-((x+6)/2\\sqrt{6})^{2}}}\\,\\text{d}x \\\\  & =\\frac{15}{2\\sqrt{6}}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 2\\sqrt{6}\\,\\text{d}u. \\\\  & =15{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =15\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =15(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2})) \\\\  & =15(\\frac{\\pi }{6}-(-\\frac{\\pi }{6})) \\\\  & =5\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-270103/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a"] :knowledge-point/questions ["q-270103"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348547/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203" :answer/id #uuid "d3d8ff3d-494f-562c-a6a9-a22b56975923" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-348547/field-1" :answer-field/id #uuid "19e99c19-2e78-50ef-87a1-91d7d4d4005e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348547/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203" :answer-field/choices ["q-348547/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203"] :db/ensure [:answer-field/validate]} {:db/id "q-348547" :question/id #uuid "a75621e3-8feb-5c5d-968c-e25e78e132b8" :question/math-academy-id "q-348547" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-2x & =-({x}^{2}+2x) \\\\  & =-({x}^{2}+2\\cdot 1x+[{1}^{2}-{1}^{2}]) \\\\  & =-((x+1)^{2}-1) \\\\  & =1-(x+1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x={\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{1-(x+1)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+1).$\n\nSo, let's perform the substitution\n\n$$\nu=x+1.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-1$ | $-1+\\frac{\\sqrt{2}}{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{2}}{2}$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{-1+\\sqrt{2}/2}\\frac{1}{\\sqrt{-{x}^{2}-2x}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{2}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{0}^{\\sqrt{2}/2} \\\\  & =arcsin\\,(\\frac{\\sqrt{2}}{2})-\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{\\pi }{4}-0 \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348547/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a"] :knowledge-point/questions ["q-348547"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348550/field-1/29ec2dfefa1bd3742bf5ba922b9c261dd5f2325bd8484e9153eb979dbd6eced6" :answer/id #uuid "c53bc774-3c81-5053-b670-6f0a6b38fa06" :answer/type :answer.type/math :answer/value "\\pi" :db/ensure [:answer/validate]} {:db/id "q-348550/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" :answer/id #uuid "13927e05-86d6-5555-aa8f-9d072e2d31b0" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-348550/field-1" :answer-field/id #uuid "885a7a1b-e581-5da6-b923-85adbeef9fdc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348550/field-1/29ec2dfefa1bd3742bf5ba922b9c261dd5f2325bd8484e9153eb979dbd6eced6" :answer-field/choices ["q-348550/field-1/29ec2dfefa1bd3742bf5ba922b9c261dd5f2325bd8484e9153eb979dbd6eced6" "q-348550/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77"] :db/ensure [:answer-field/validate]} {:db/id "q-348550" :question/id #uuid "a8b055b7-b338-5782-a064-5a2d7bd3c0f3" :question/math-academy-id "q-348550" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-18x-80 & =-({x}^{2}+18x+80) \\\\  & =-({x}^{2}+2\\cdot 9x+[{9}^{2}-{9}^{2}]+80) \\\\  & =-((x+9)^{2}-1) \\\\  & =1-(x+9)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x={\\int }_{-10}^{-8}\\frac{1}{\\sqrt{1-(x+9)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+9).$\n\nSo, let's perform the substitution\n\n$$\nu=x+9.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-10$ | $-8$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-10}^{-8}\\frac{1}{\\sqrt{-{x}^{2}-18x-80}}\\,\\text{d}x & ={\\int }_{-1}^{1}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1}^{1} \\\\  & =\\operatorname{arcsin}⁡(1)-\\operatorname{arcsin}⁡(-1) \\\\  & =\\frac{\\pi }{2}-(-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348550/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db6e4cf3-803a-5942-9ce0-7047942e078a"] :knowledge-point/questions ["q-348550"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-238056"] :question/problem "Evaluate the integral ${\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-12x-35 & =-({x}^{2}+12x+35) \\\\  & =-({x}^{2}+2\\cdot 6x+[{6}^{2}-{6}^{2}]+35) \\\\  & =-((x+6)^{2}-1) \\\\  & =1-(x+6)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x={\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{1-(x+6)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x+6.$\n\nSo, let's perform the substitution\n\n$$\nu=x+6.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-13/2$ | $-11/2$ |\n| --- | --- | --- |\n| $u$ | $-1/2$ | $1/2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{-{x}^{2}-12x-35}}\\,\\text{d}x & ={\\int }_{-13/2}^{-11/2}\\frac{1}{\\sqrt{1-(x+6)^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u\\,{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}-(-\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-348530/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" :answer/id #uuid "4c14e7f4-9b4f-5294-b193-a55437cab9bf" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-348530/field-1" :answer-field/id #uuid "c39d2d0a-d133-5783-8bbb-1d1a172af46b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348530/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" :answer-field/choices ["q-348530/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77"] :db/ensure [:answer-field/validate]} {:db/id "q-348530" :question/id #uuid "a6ab7859-3821-57d4-a2e8-b5a880e14da0" :question/math-academy-id "q-348530" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+4x+3 & ={x}^{2}+2\\cdot 2x+({2}^{2}-{2}^{2})+3 \\\\  & =({x}^{2}+2\\cdot 2x+{2}^{2})-4+3 \\\\  & =(x+2)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x=3{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{1}{|x+2|\\sqrt{(x+2)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+2).$\n\nSo, let's perform the substitution\n\n$$\nu=x+2.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-2+\\frac{2}{\\sqrt{3}}$ | $0$ |\n| --- | --- | --- |\n| $u$ | $\\frac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2+2/\\sqrt{3}}^{0}\\frac{3}{|x+2|\\sqrt{{x}^{2}+4x+3}}\\,\\text{d}x & =3{\\int }_{2/\\sqrt{3}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =3\\,\\text{arcsec}\\,u\\,{|}_{2/\\sqrt{3}}^{2} \\\\  & =3(\\text{arcsec}(2)-\\text{arcsec}\\,(\\frac{2}{\\sqrt{3}})) \\\\  & =3(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348530/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c"] :knowledge-point/questions ["q-348530"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19532/selection/58585bccaaad97d4177544f19c0bf48c43692bed8a4b95d1b5fed70b162e23e1" :answer/id #uuid "42e134e2-af87-5230-82e7-d3fabe832e7b" :answer/type :answer.type/math :answer/value "10\\,\\text{arcsec}(x-6)+C" :db/ensure [:answer/validate]} {:db/id "q-19532/selection/eeace0cf1565e5e54c357d171c8389318381d77576c4b88105fc9e0ea5c0568c" :answer/id #uuid "528e7523-cb33-59eb-bf79-dcbb4c2e886f" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(\\frac{x+2}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-19532/selection/c1edb3d230e06b180e66076142b44e60de8f76e83700bb0ded5ad13d6f1f4ba0" :answer/id #uuid "c18839b2-829e-5943-a79d-cf78c138840f" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(\\frac{x-3}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-19532/selection/8f817863f27300a1386561da95fb67013ff74cd47b5443ad8567cb48f40a3f5c" :answer/id #uuid "fd1e2f24-c802-5d61-9e90-3f0ed160528a" :answer/type :answer.type/math :answer/value "10\\,\\text{arcsec}(x+6)+C" :db/ensure [:answer/validate]} {:db/id "q-19532/selection/badc7b9c9044f9b88917ac45a39845c28c7b96ec782231765e02933aca648338" :answer/id #uuid "3c76e52c-53b7-5820-99ca-19e8c345706b" :answer/type :answer.type/math :answer/value "10\\,\\text{arcsec}(x-4)+C" :db/ensure [:answer/validate]} {:db/id "q-19532/selection" :answer-field/id #uuid "435600ce-1f95-513f-94a5-ca9860e2f862" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19532/selection/58585bccaaad97d4177544f19c0bf48c43692bed8a4b95d1b5fed70b162e23e1" :answer-field/choices ["q-19532/selection/58585bccaaad97d4177544f19c0bf48c43692bed8a4b95d1b5fed70b162e23e1" "q-19532/selection/eeace0cf1565e5e54c357d171c8389318381d77576c4b88105fc9e0ea5c0568c" "q-19532/selection/c1edb3d230e06b180e66076142b44e60de8f76e83700bb0ded5ad13d6f1f4ba0" "q-19532/selection/8f817863f27300a1386561da95fb67013ff74cd47b5443ad8567cb48f40a3f5c" "q-19532/selection/badc7b9c9044f9b88917ac45a39845c28c7b96ec782231765e02933aca648338"] :db/ensure [:answer-field/validate]} {:db/id "q-19532" :question/id #uuid "db8ef128-2717-5091-8870-85aa35ff95e0" :question/math-academy-id "q-19532" :question/problem "Calculate $\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x.$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-12x+35 & ={x}^{2}-2\\cdot 6x+({6}^{2}-{6}^{2})+35 \\\\  & =({x}^{2}-12x+36)-36+35 \\\\  & =(x-6)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x=10\\int \\frac{1}{|x-6|\\sqrt{(x-6)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-6.$\n\nSo, let's perform the substitution \n\n$$\nu=x-6.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{10}{|x-6|\\sqrt{{x}^{2}-12x+35}}\\,\\text{d}x & =10\\int \\frac{1}{|x-6|\\sqrt{(x-6)^{2}-1}}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =10\\,\\text{arcsec }u+C \\\\  & =10\\,\\text{arcsec}(x-6)+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c"] :knowledge-point/questions ["q-19532"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348533/field-1/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a" :answer/id #uuid "c19f438e-258d-58c6-adaa-6d0fb1e160d7" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-348533/field-1" :answer-field/id #uuid "0e8f1a62-3343-5afe-8f7b-9bcd3b339e7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348533/field-1/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a" :answer-field/choices ["q-348533/field-1/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a"] :db/ensure [:answer-field/validate]} {:db/id "q-348533" :question/id #uuid "1f6f7fe5-e124-5c20-b6f5-4662a4de938e" :question/math-academy-id "q-348533" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+8x+15 & ={x}^{2}+2\\cdot 4x+({4}^{2}-{4}^{2})+15 \\\\  & =({x}^{2}+2\\cdot 4x+{4}^{2})-16+15 \\\\  & =(x+4)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x=5{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{1}{|x+4|\\sqrt{(x+4)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-4+\\frac{2}{\\sqrt{3}}$ | $-2$ |\n| --- | --- | --- |\n| $u$ | $\\frac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-4+2/\\sqrt{3}}^{-2}\\frac{5}{|x+4|\\sqrt{{x}^{2}+8x+15}}\\,\\text{d}x & =5{\\int }_{2/\\sqrt{3}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =5\\,\\text{arcsec}\\,u\\,{|}_{2/\\sqrt{3}}^{2} \\\\  & =5(\\text{arcsec}(2)-\\text{arcsec}\\,(\\frac{2}{\\sqrt{3}})) \\\\  & =5(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348533/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c"] :knowledge-point/questions ["q-348533"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114928/selection/a3e24dadc8b999e279b7d1fa870351c9d2d6e288042fbea4887250b5714d1c65" :answer/id #uuid "dddc2260-7f03-530e-a23b-29f44c68d2a7" :answer/type :answer.type/math :answer/value "\\text{arcsec}(\\frac{x+4}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114928/selection/59e9bd950b25edad1bc6deda61173d4a7a53e84bceb90c0afa9d9e42469b9fda" :answer/id #uuid "2be6aa11-5099-5871-a5e4-0a1127e30e71" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(x+4)+C" :db/ensure [:answer/validate]} {:db/id "q-114928/selection/2710b556c91bc90c347663e573d7b3695abe09fc8f84a6320a8de3a04f2a3156" :answer/id #uuid "affa2fa1-b65a-5547-94e5-ebe1c340d507" :answer/type :answer.type/math :answer/value "\\text{arcsec}(x-4)+C" :db/ensure [:answer/validate]} {:db/id "q-114928/selection/e6f6a1c3065fc223f125efe582756c963ba51272e57f8c5f67a02934ccbfebe4" :answer/id #uuid "a1eff953-de69-5a86-8d3c-aeda99affaeb" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(\\frac{x-4}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114928/selection/258a02bfd7f1bfda02ac92e65bce880f75ddf37705db69670662539c3e3597b1" :answer/id #uuid "a51075ec-18ad-5576-8319-4b595a19798c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\,\\text{arcsec}(x-4)+C" :db/ensure [:answer/validate]} {:db/id "q-114928/selection" :answer-field/id #uuid "bac18518-2867-5216-8a0c-5524d038b46b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114928/selection/2710b556c91bc90c347663e573d7b3695abe09fc8f84a6320a8de3a04f2a3156" :answer-field/choices ["q-114928/selection/a3e24dadc8b999e279b7d1fa870351c9d2d6e288042fbea4887250b5714d1c65" "q-114928/selection/59e9bd950b25edad1bc6deda61173d4a7a53e84bceb90c0afa9d9e42469b9fda" "q-114928/selection/2710b556c91bc90c347663e573d7b3695abe09fc8f84a6320a8de3a04f2a3156" "q-114928/selection/e6f6a1c3065fc223f125efe582756c963ba51272e57f8c5f67a02934ccbfebe4" "q-114928/selection/258a02bfd7f1bfda02ac92e65bce880f75ddf37705db69670662539c3e3597b1"] :db/ensure [:answer-field/validate]} {:db/id "q-114928" :question/id #uuid "ecf9beb7-988d-5771-b00a-91910c2e65e8" :question/math-academy-id "q-114928" :question/problem "$\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}-8x+15 & ={x}^{2}-2\\cdot 4x+({4}^{2}-{4}^{2})+15 \\\\  & =({x}^{2}-8x+16)-16+15 \\\\  & =(x-4)^{2}-1.\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x=\\int \\frac{1}{|x-4|\\sqrt{(x-4)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-4.$\n\nSo, let's perform the substitution \n\n$$\nu=x-4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{|x-4|\\sqrt{{x}^{2}-8x+15}}\\,\\text{d}x & =\\int \\frac{1}{|x-4|\\sqrt{(x-4)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{arcsec}\\,u+C \\\\  & =\\text{arcsec}(x-4)+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c"] :knowledge-point/questions ["q-114928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49689/selection/16fafe5662947852de7f09a69e8af62956ba3c1c73428fdf635a91f81dacfc50" :answer/id #uuid "30687a7e-c5ab-59fb-80b0-15e4948aa5be" :answer/type :answer.type/math :answer/value "15\\,\\text{arcsec}(x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-49689/selection/64678aef8d5f682b8fa5219d30d2d424f66771245309849232dd8db4648e3e33" :answer/id #uuid "632a160d-7ab1-5c53-9a1a-b9d01c4b6bf2" :answer/type :answer.type/math :answer/value "15\\,\\text{arcsec}(x+5)+C" :db/ensure [:answer/validate]} {:db/id "q-49689/selection/b1956a4f73454d4451cf33aa56728f22e945415031a677e79c48e0a6afb123dd" :answer/id #uuid "5ab97437-ccd1-51d8-95d9-8664bd307b99" :answer/type :answer.type/math :answer/value "10\\,\\text{arcsec}(\\frac{x+5}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-49689/selection/ab7a332494e9dd02ceb9e8947c00400a3581f0bab02a1d8b635b38bd8b42dbd5" :answer/id #uuid "1b9b1745-abfc-52ba-8666-a256bb52fd0a" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(\\frac{x+1}{5})+C" :db/ensure [:answer/validate]} {:db/id "q-49689/selection/1d6966c32e65c164bcfaa47bc44f15518cdbc60b835a9fc2a774026768554838" :answer/id #uuid "289c0919-0600-5792-958a-2c3b563c7a4f" :answer/type :answer.type/math :answer/value "15\\,\\text{arcsec}(\\frac{x+2}{5})+C" :db/ensure [:answer/validate]} {:db/id "q-49689/selection" :answer-field/id #uuid "282b3c49-9d67-5f6e-87e8-505bda1b70a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49689/selection/1d6966c32e65c164bcfaa47bc44f15518cdbc60b835a9fc2a774026768554838" :answer-field/choices ["q-49689/selection/16fafe5662947852de7f09a69e8af62956ba3c1c73428fdf635a91f81dacfc50" "q-49689/selection/64678aef8d5f682b8fa5219d30d2d424f66771245309849232dd8db4648e3e33" "q-49689/selection/b1956a4f73454d4451cf33aa56728f22e945415031a677e79c48e0a6afb123dd" "q-49689/selection/ab7a332494e9dd02ceb9e8947c00400a3581f0bab02a1d8b635b38bd8b42dbd5" "q-49689/selection/1d6966c32e65c164bcfaa47bc44f15518cdbc60b835a9fc2a774026768554838"] :db/ensure [:answer-field/validate]} {:db/id "q-49689" :question/id #uuid "589ac1f9-7e27-5253-a295-86acfab0073f" :question/math-academy-id "q-49689" :question/problem "$\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the expression inside the square root:\n\n$$\n\\begin{aligned}(x+2)^{2}-25 & =25[\\frac{(x+2)^{2}}{25}-1] \\\\  & =25[{(\\frac{x+2}{5})}^{2}-1]\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x & =\\int \\frac{75}{|x+2|\\sqrt{25[((x+2)/5)^{2}-1]}}\\,\\text{d}x \\\\  & =\\int \\frac{75}{|x+2|\\cdot \\sqrt{25}\\cdot \\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{75}{|x+2|\\cdot 5\\cdot \\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{15}{|x+2|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{|(x+2)/5|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\frac{x+2}{5}.$\n\nSo, let's perform the substitution \n\n$$\nu=\\frac{x+2}{5}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{75}{|x+2|\\sqrt{(x+2)^{2}-25}}\\,\\text{d}x & =3\\int \\frac{1}{|(x+2)/5|\\sqrt{((x+2)/5)^{2}-1}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot 5\\,\\text{d}u \\\\  & =15\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =15\\,\\text{arcsec }u+C \\\\  & =15\\,\\text{arcsec}(\\frac{x+2}{5})+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49689/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d1dc808-1ee6-5037-b53e-9e1e4686a11c"] :knowledge-point/questions ["q-49689"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-14577"] :question/problem "Calculate $\\displaystyle \\int \\dfrac{1}{\\sqrt{36 -(3x - 2)^2}} \\, \\textrm{d}x.$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{36-(3x-2)^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{36(1-(3x-2)^{2}/36)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{36}\\cdot \\sqrt{1-(3x-2)^{2}/36}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{6\\sqrt{1-(3x-2)^{2}/36}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-(3x-2)^{2}/36}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-((3x-2)/6)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\dfrac{1}{\\sqrt{1-u^2}}\\,\\textrm{d}u = \\arcsin u + C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\left(\\dfrac{3x-2}{6}\\right).$\n\nSo, let's perform the substitution \n\n$$\nu=\\dfrac{3x-2}{6}.\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x} = \\dfrac{1}{2} \\quad \\Longrightarrow \\quad \\textrm{d}x = 2\\,\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{36-(3x-2)^{2}}}\\,\\text{d}x & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-((3x-2)/6)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡(\\frac{3x-2}{6})+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14574"] :question/problem "Calculate $\\displaystyle \\int \\dfrac{1}{x^2-2x + 3}\\, \\textrm{d}x.$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\eqalign{\nx^2-2x + 3\n& = x^2 - 2 \\cdot x+ (1^2 - 1^2) + 3 \\[3pt]\n& = (x^2 - 2 \\cdot x+ 1^2) - 1 + 3 \\[3pt]\n& = (x-1)^2+2\n}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-2x+3}\\,\\text{d}x & =\\int \\frac{1}{(x-1)^{2}+2}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+((x-1)/\\sqrt{2})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\dfrac{1}{1+u^2} \\, \\textrm{d}u\n=\n\\arctan u + C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\left(\\dfrac{x-1}{\\sqrt{2}}\\right).$\n\nSo, let's perform the substitution\n\n$$\nu=\\dfrac{x-1}{\\sqrt{2}}.\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{\\sqrt{2}}\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\sqrt{2}\\,\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-2x+3}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+((x-1)/\\sqrt{2})^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{2}}{2}\\operatorname{arctan}⁡(\\frac{x-1}{\\sqrt{2}})+C\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14575"] :question/problem "Calculate ${\\displaystyle \\int \\dfrac{1}{\\sqrt{4x - 4x^2}} \\, \\textrm{d}x}.$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}4x-4{x}^{2} & =-(4{x}^{2}-4x) \\\\  & =-((2x)^{2}-2\\cdot 2x+1-1) \\\\  & =-((2x-1)^{2}-1) \\\\  & =1-(2x-1)^{2}\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4x-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x-1)^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\,\\textrm{d}u = \\arcsin u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x - 1).$  \n\nSo, let's perform the substitution\n\n$$\nu =2x - 1.\n$$\n\nDifferentiating, we get \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\dfrac12\\textrm{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4x-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x-1)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡(2x-1)+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14576"] :question/problem "Evaluate the integral $\\displaystyle{\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x}.$" :question/worked-solution "First, we complete the square for the expression inside the square root:\n\n$$\n\\eqalign{\n    x^2-2x&= x^2 -2x +(1-1)\\[3pt]\n              &= (x^2 -2x +1)-1\\[3pt]\n         &= (x-1)^2-1\n         \n  }\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n= \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\, \\textrm{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\, \\textrm{d}u = \\textrm{arcsec} \\, u +C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-1.$\n\nSo, let's perform the substitution\n\n$$\nu=x-1.\n$$\n\n \nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}x = \\textrm{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $1+\\dfrac{2}{\\sqrt{3}}$ | $3$ |\n| --- | --- | --- |\n| $u$ | $\\dfrac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\eqalign{\n    \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{|x-1|\\sqrt{x^2-2x}}\\, \\textrm{d}x \n&=  \\int_{1+2/\\sqrt{3}}^{3}\\dfrac{1}{|x-1|\\sqrt{(x-1)^2-1}}\\,\\textrm{d}x \\[5pt]\n&=\\int_{2/\\sqrt{3}}^{2} \\dfrac{1}{|u|\\sqrt{u^2-1}}\\, \\textrm{d}u\\[5pt]\n&=  \\textrm{arcsec}\\, {u}\\Big|_{2/\\sqrt{3}}^{2}\\[5pt]\n&= \\textrm{arcsec} \\left(2\\right)  - \\textrm{arcsec}\\left(\\dfrac{2}{\\sqrt{3}} \\right)\\[5pt]\n&=\\left(\\dfrac{\\pi}{3}-\\dfrac{\\pi}{6}\\right)\\[5pt]\n&=\\dfrac{\\pi}{6}.\n\n}\n$$" :db/ensure [:question/validate]}]
