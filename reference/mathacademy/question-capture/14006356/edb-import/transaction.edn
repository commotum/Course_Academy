[{:db/id "q-80312/selection/1fd4bff55c0316ef057d3bf8d20e053c56e54ec0a294c9764819d7ef6168aef8" :answer/id #uuid "2a1bf09e-7b3c-5923-a001-88f2b54347e3" :answer/type :answer.type/math :answer/value "\\text{arcsec}(x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-80312/selection/6f118d9c8cbeea16299f0f67b3a71a4cc92e6f1a08c43ac5a0d40a86b7140e4f" :answer/id #uuid "7f191337-b974-5575-a73d-cf7e29d01e62" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-80312/selection/63f9ba030dcb28a6361716ba68ce2304752c0882ceaf55f6e5e65db0b79138e1" :answer/id #uuid "69aaae0a-82af-5900-a2b2-ce958cd96ecc" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(\\frac{x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-80312/selection/b33c8790bd2c2df5f9bc6b69a16201ef7c3bf4d9043408bfae215c3f0d7764cb" :answer/id #uuid "47674c73-88a4-502c-88df-65e644a99c36" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-80312/selection/0aa4b28ba66cbe85e528634008ecab374f2994e7f5d56e91cc6c90fe72b97616" :answer/id #uuid "f7f228e6-97ae-5ca3-926c-072d0498b747" :answer/type :answer.type/math :answer/value "\\text{arcsec}(x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-80312/selection" :answer-field/id #uuid "f21707fa-6d7c-5098-9f16-ff9ba2374d71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80312/selection/6f118d9c8cbeea16299f0f67b3a71a4cc92e6f1a08c43ac5a0d40a86b7140e4f" :answer-field/choices ["q-80312/selection/1fd4bff55c0316ef057d3bf8d20e053c56e54ec0a294c9764819d7ef6168aef8" "q-80312/selection/6f118d9c8cbeea16299f0f67b3a71a4cc92e6f1a08c43ac5a0d40a86b7140e4f" "q-80312/selection/63f9ba030dcb28a6361716ba68ce2304752c0882ceaf55f6e5e65db0b79138e1" "q-80312/selection/b33c8790bd2c2df5f9bc6b69a16201ef7c3bf4d9043408bfae215c3f0d7764cb" "q-80312/selection/0aa4b28ba66cbe85e528634008ecab374f2994e7f5d56e91cc6c90fe72b97616"] :db/ensure [:answer-field/validate]} {:db/id "q-80312" :question/id #uuid "cd859552-b72d-56d1-8bd5-a359ca7b8880" :question/math-academy-id "q-80312" :question/problem "$\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}(u)+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+1).$\n\nSo, let's perform the substitution \n\n$$\nu=x+1.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x & =2\\int \\frac{1}{|x+1|\\sqrt{(x+1)^{2}-1}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =2\\,\\text{arcsec}(u)+C \\\\  & =2\\,\\text{arcsec}(x+1)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-80312/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fca8969-c914-5ed2-a492-0addc197ce72"] :knowledge-point/questions ["q-80312"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114918/selection/b6004b40b4b733a6fa6c543f69d18eb315ec62acf674456e81b4677fc1f42585" :answer/id #uuid "7f558a44-33cb-57aa-84bd-2db1dc9d066f" :answer/type :answer.type/math :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114918/selection/78659395740442572921833b7a01bedd0d74efe3eb17d502d291f455f51e4602" :answer/id #uuid "d0f1c9e6-1a7e-5d36-abdd-50f0f4371849" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcsin}⁡(\\frac{6x+1}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114918/selection/754bc2cf8b02bd076d159a88b25774efb7138b4dd58003607cdf4f9833b9d8ec" :answer/id #uuid "6bf97aba-2ded-5e96-bd6f-cdd8fa187770" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114918/selection/1070024b4894b4d0999fee1a009a8a6912dca5e0996915da9b694858e3aae59a" :answer/id #uuid "734090e9-27a6-5fbc-82dd-c3d1a0dff657" :answer/type :answer.type/math :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(\\frac{6x+1}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114918/selection/6fe8f1984bc2ad910ab13450a4e4b77bba1e2dc3b163c05249bb2853b58625e0" :answer/id #uuid "2f2bc090-ba43-5d12-ba31-888a29ae9e69" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114918/selection" :answer-field/id #uuid "e735d61e-420d-5df2-b60c-63df9371b943" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114918/selection/b6004b40b4b733a6fa6c543f69d18eb315ec62acf674456e81b4677fc1f42585" :answer-field/choices ["q-114918/selection/b6004b40b4b733a6fa6c543f69d18eb315ec62acf674456e81b4677fc1f42585" "q-114918/selection/78659395740442572921833b7a01bedd0d74efe3eb17d502d291f455f51e4602" "q-114918/selection/754bc2cf8b02bd076d159a88b25774efb7138b4dd58003607cdf4f9833b9d8ec" "q-114918/selection/1070024b4894b4d0999fee1a009a8a6912dca5e0996915da9b694858e3aae59a" "q-114918/selection/6fe8f1984bc2ad910ab13450a4e4b77bba1e2dc3b163c05249bb2853b58625e0"] :db/ensure [:answer-field/validate]} {:db/id "q-114918" :question/id #uuid "5659f7b5-791c-542b-a3d9-13c7b7bc51e1" :question/math-academy-id "q-114918" :question/problem "$\\int \\frac{1}{\\sqrt{4-{(6x+1)}^{2}}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4-(6x+1)^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{4(1-(6x+1)^{2}/4)}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{4}\\cdot \\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{2\\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-(6x+1)^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-((6x+1)/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{6x+1}{2}).$\n\nSo, let's perform the substitution \n\n$$\nu=\\frac{6x+1}{2}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{4-(6x+1)^{2}}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-((6x+1)/2)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{6}\\operatorname{arcsin}⁡(\\frac{6x+1}{2})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114918/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fca8969-c914-5ed2-a492-0addc197ce72"] :knowledge-point/questions ["q-114918"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114923/selection/48ce02cf0d6ff570b782abd46c196e926c783d0ee9b478b15c24c3d8d8df04f9" :answer/id #uuid "07a1c9e4-d47f-5d7b-b286-d0842049db8b" :answer/type :answer.type/math :answer/value "\\text{arcsec}(\\frac{x-3}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-114923/selection/44f90a7085920b471379a0018d520421a145f443d49cfd4e338c1f22f0a1a3b7" :answer/id #uuid "8ddd3e6c-cb17-5c93-8b6a-a47a8348b4f6" :answer/type :answer.type/math :answer/value "\\text{arcsec}(2(x-3))+C" :db/ensure [:answer/validate]} {:db/id "q-114923/selection/bcfb92a0e3