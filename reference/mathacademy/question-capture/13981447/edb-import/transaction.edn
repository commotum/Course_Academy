[{:db/id "q-65229/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" :answer/id #uuid "76cf6920-79ff-5cb3-b415-abc8a0c24f39" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65229/selection/fbec4adffb32635c006c882e5ddfbea882226e90411fcf93403e2867b52e366b" :answer/id #uuid "1c2935c6-419b-566a-845f-0be6a3148ba6" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta -1" :db/ensure [:answer/validate]} {:db/id "q-65229/selection/17f068ab922e13c653374e369e944fcec0fb8c0a596dd74294992baabbff23a2" :answer/id #uuid "8ecd9792-80bd-5c8c-b380-07d0ec5c37cd" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-65229/selection/ced7f0bb48d9b88153933bee8c894cdf825178dadf90f2d7fcd34f587d0a87e6" :answer/id #uuid "24b43494-04fe-5204-85b9-6b200873e89d" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65229/selection/beadb06c20d282e2d21fa83dbc2edfd09ae5888b2e7dcdce84c986f43d29ee97" :answer/id #uuid "e8cdfdbd-0405-5943-b759-acd289efe3d1" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65229/selection" :answer-field/id #uuid "08095a5c-9175-554f-8336-4d159562c7e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65229/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" :answer-field/choices ["q-65229/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" "q-65229/selection/fbec4adffb32635c006c882e5ddfbea882226e90411fcf93403e2867b52e366b" "q-65229/selection/17f068ab922e13c653374e369e944fcec0fb8c0a596dd74294992baabbff23a2" "q-65229/selection/ced7f0bb48d9b88153933bee8c894cdf825178dadf90f2d7fcd34f587d0a87e6" "q-65229/selection/beadb06c20d282e2d21fa83dbc2edfd09ae5888b2e7dcdce84c986f43d29ee97"] :db/ensure [:answer-field/validate]} {:db/id "q-65229" :question/id #uuid "b09d2ae6-b1b6-58ca-ab31-441a63f5a985" :question/math-academy-id "q-65229" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{3}⁡\\theta .$" :question/worked-solution "First, we factor $\\operatorname{sin}⁡\\theta $ from the expression:\n\n$$\n\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{3}⁡\\theta =\\operatorname{sin}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )\n$$\n\nThen, we use ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}) & =\\operatorname{sin}⁡\\theta \\cdot 1 \\\\  & =\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWe conclude that\n\n$$\n\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +{sin}^{3}⁡\\theta =\\operatorname{sin}⁡\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65229/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b"] :knowledge-point/questions ["q-65229"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119362/selection/67cc58862a5e43c8486567a80b8849cc594070745ae69045b7cc27b0660d7342" :answer/id #uuid "3cac7e64-8856-530f-ad04-b8f05d0976b6" :answer/type :answer.type/math :answer/value "2{cos}^{3}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119362/selection/9615198c83518a9a5f611bb276a05661ace4caab05b001c973216f6bb03f2cfe" :answer/id #uuid "3aacf20c-49eb-5d97-85d7-02c5809de07b" :answer/type :answer.type/math :answer/value "-{cos}^{3}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119362/selection/b4f476a87fbff3a335b3877a08b835c6dbd36cbb90672cd0a91e91e8aea51309" :answer/id #uuid "fa5358f0-529c-5291-9deb-29fcfaa25bba" :answer/type :answer.type/math :answer/value "{cos}^{3}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-119362/selection/dd37d0d5a0d4028008ec6245b86454579d8ee241723a490806c55ea0aedab4c3" :answer/id #uuid "dfceceb6-5e5e-5d74-88bd-20f864435641" :answer/type :answer.type/math :answer/value "{cos}^{3}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119362/selection/fbf7fb9ae7a51658b85f310f00707656df8644c4e053786a57f8969a1fd6cec6" :answer/id #uuid "ba7f0883-e6f7-57dd-8666-2d5285a24a61" :answer/type :answer.type/math :answer/value "2+{cos}^{3}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119362/selection" :answer-field/id #uuid "0013e078-0457-53a9-b74e-da21aab11759" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119362/selection/dd37d0d5a0d4028008ec6245b86454579d8ee241723a490806c55ea0aedab4c3" :answer-field/choices ["q-119362/selection/67cc58862a5e43c8486567a80b8849cc594070745ae69045b7cc27b0660d7342" "q-119362/selection/9615198c83518a9a5f611bb276a05661ace4caab05b001c973216f6bb03f2cfe" "q-119362/selection/b4f476a87fbff3a335b3877a08b835c6dbd36cbb90672cd0a91e91e8aea51309" "q-119362/selection/dd37d0d5a0d4028008ec6245b86454579d8ee241723a490806c55ea0aedab4c3" "q-119362/selection/fbf7fb9ae7a51658b85f310f00707656df8644c4e053786a57f8969a1fd6cec6"] :db/ensure [:answer-field/validate]} {:db/id "q-119362" :question/id #uuid "cf848531-47fc-5901-8c19-787e41fbe811" :question/math-academy-id "q-119362" :question/problem "Simplify the trigonometric expression ${cos}^{3}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{5}⁡\\theta .$" :question/worked-solution "First, we factor the expression:\n\n$$\n{cos}^{3}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{5}⁡\\theta ={cos}^{3}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )\n$$\n\nThen, we use ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}{cos}^{2}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta ) & ={cos}^{3}⁡\\theta \\cdot 1 \\\\  & ={cos}^{3}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n{cos}^{3}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{5}⁡\\theta ={cos}^{3}⁡\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119362/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b"] :knowledge-point/questions ["q-119362"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119392/selection/1efa265d6e9f8254e52a528cdb690dc0548c27447f71a0551fdab96de3ae5c0f" :answer/id #uuid "23693061-4348-5d12-a872-c23dd1b690ce" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡x+{sec}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119392/selection/fc08a441e61fa6c7f959e0aece4f199a6333f9036dfe59d78bf5089a1b64c578" :answer/id #uuid "3136784e-60b1-58b5-88ba-359b1dcb9502" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x+\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119392/selection/da4ec9bf549f00c9fe2d6327206c7141ef44e8481e4c2aadbf8ef222fa8cfe58" :answer/id #uuid "c7b87ff3-cbe6-56c5-b5ec-508ac0357f04" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡x+{csc}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119392/selection/26638654ffd46913e3d5dc5f8112307218ff7070bf7152ad18c18e68906f6e3f" :answer/id #uuid "de9126ab-85a6-5a6f-ba7f-3f2654294de7" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x+{sec}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119392/selection/2bbf1210ff1ee84c6108daa8419e1a7fd879b7acb89b366f9ac846395b4025a3" :answer/id #uuid "fcba337b-e599-54bc-957d-e517d1186379" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡x+\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119392/selection" :answer-field/id #uuid "8abbcd1c-0e5c-5939-af7e-9da6d799dd37" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119392/selection/da4ec9bf549f00c9fe2d6327206c7141ef44e8481e4c2aadbf8ef222fa8cfe58" :answer-field/choices ["q-119392/selection/1efa265d6e9f8254e52a528cdb690dc0548c27447f71a0551fdab96de3ae5c0f" "q-119392/selection/fc08a441e61fa6c7f959e0aece4f199a6333f9036dfe59d78bf5089a1b64c578" "q-119392/selection/da4ec9bf549f00c9fe2d6327206c7141ef44e8481e4c2aadbf8ef222fa8cfe58" "q-119392/selection/26638654ffd46913e3d5dc5f8112307218ff7070bf7152ad18c18e68906f6e3f" "q-119392/selection/2bbf1210ff1ee84c6108daa8419e1a7fd879b7acb89b366f9ac846395b4025a3"] :db/ensure [:answer-field/validate]} {:db/id "q-119392" :question/id #uuid "69124476-7712-5455-bad9-c2749d724009" :question/math-academy-id "q-119392" :question/problem "Simplify the trigonometric expression $\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}.$" :question/worked-solution "First, we factor $\\operatorname{cos}⁡x\\operatorname{sin}⁡x$ from the first two terms of the numerator:\n\n$$\n\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}=\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{{sin}^{2}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{{sin}^{2}⁡x} & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\cdot 1+1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x+1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}{{sin}^{2}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x\\cdot \\operatorname{sin}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x\\cancel{\\operatorname{sin}⁡x}}{\\cancel{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x}+\\frac{1}{{sin}^{2}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+{(\\frac{1}{\\operatorname{sin}⁡x})}^{2} \\\\  & =\\operatorname{cot}⁡x+{csc}^{2}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡x{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{3}⁡x+1}{{sin}^{2}⁡x}=\\operatorname{cot}⁡x+{csc}^{2}⁡x.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-119392/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689"] :knowledge-point/questions ["q-119392"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119767/selection/571fe09526b27895a791d927b8a0acc60b75d32204e5dfb154c0046c5c5d09df" :answer/id #uuid "46e0998c-4411-5790-99c7-390156555771" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta \\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119767/selection/4f6cbb96f26565e41d1fb37dfb3df3c2e3848d209179c6d66d724faf6f4a4bb5" :answer/id #uuid "84c29454-e450-5588-a5da-23b2c746ad69" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119767/selection/994563680f6fd7f66c023d39bb80bcc053690ae81b1f58c92d8e4905435d25e8" :answer/id #uuid "e4e05a9b-91bb-5d49-b6fb-6f758c4bbd8f" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sec}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119767/selection/e3269797825f45b365a0428c9612149797fe456b192c1b6a489985ced8bd257f" :answer/id #uuid "4d5dc51b-19f3-56d0-b6fc-8cabfae1688a" :answer/type :answer.type/math :answer/value "2\\operatorname{csc}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119767/selection/09be7ff8ab2c3ac32ba54f44073fedbc68c74f81a82a87751c1aa46ee2f2664f" :answer/id #uuid "0c310b27-dfc2-5fc4-b6bc-510f2bf63428" :answer/type :answer.type/math :answer/value "2\\operatorname{sec}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119767/selection" :answer-field/id #uuid "cfb7cacd-4023-5e4c-8544-379376522bdd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119767/selection/4f6cbb96f26565e41d1fb37dfb3df3c2e3848d209179c6d66d724faf6f4a4bb5" :answer-field/choices ["q-119767/selection/571fe09526b27895a791d927b8a0acc60b75d32204e5dfb154c0046c5c5d09df" "q-119767/selection/4f6cbb96f26565e41d1fb37dfb3df3c2e3848d209179c6d66d724faf6f4a4bb5" "q-119767/selection/994563680f6fd7f66c023d39bb80bcc053690ae81b1f58c92d8e4905435d25e8" "q-119767/selection/e3269797825f45b365a0428c9612149797fe456b192c1b6a489985ced8bd257f" "q-119767/selection/09be7ff8ab2c3ac32ba54f44073fedbc68c74f81a82a87751c1aa46ee2f2664f"] :db/ensure [:answer-field/validate]} {:db/id "q-119767" :question/id #uuid "53417fe7-aa74-52f7-8a7b-cac1bef3c1c8" :question/math-academy-id "q-119767" :question/problem "$\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{1}{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119767/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-119767"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119775/selection/19370c9253530adcb101aa7c26707d5ff9a04952be68f2880b0cc7cfca4a41a0" :answer/id #uuid "52143fd5-aec2-550d-b233-1326538720a2" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119775/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "4648cdf0-aa80-5732-810e-74e872d47f58" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-119775/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "2e56a16a-c924-57f6-a992-86c7ae04efc3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-119775/selection/aec903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4" :answer/id #uuid "a5156e51-cf96-5115-bf53-1b03c3e49c58" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119775/selection/56247185880420565171369da7cf460bfa7d363ceeed838a1573ecf9ca68415a" :answer/id #uuid "3bb41a19-b67b-5816-8a1f-237944556101" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+1" :db/ensure [:answer/validate]} {:db/id "q-119775/selection" :answer-field/id #uuid "81390f49-093c-5b1b-92c3-af824077e155" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119775/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-119775/selection/19370c9253530adcb101aa7c26707d5ff9a04952be68f2880b0cc7cfca4a41a0" "q-119775/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-119775/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-119775/selection/aec903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4" "q-119775/selection/56247185880420565171369da7cf460bfa7d363ceeed838a1573ecf9ca68415a"] :db/ensure [:answer-field/validate]} {:db/id "q-119775" :question/id #uuid "b1b11d95-94b5-51a5-999a-88076d2426a8" :question/math-academy-id "q-119775" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x}{1}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x-{sin}^{2}⁡x-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-({sin}^{2}⁡x+{cos}^{2}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-1}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{-(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}=-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119775/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-119775"] :db/ensure [:knowledge-point/validate]}]
