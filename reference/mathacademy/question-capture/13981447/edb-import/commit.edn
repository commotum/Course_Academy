in}⁡x-({sin}^{2}⁡x+{cos}^{2}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-1}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{-(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}=-1.\n$$" 13194139534202 true] [17592186282043 1000 #edb/ref 17592186282044 13194139534202 true] [17592186282043 1000 #edb/ref 17592186282045 13194139534202 true] [17592186282043 1000 #edb/ref 17592186282046 13194139534202 true] [17592186282043 1000 #edb/ref 17592186282047 13194139534202 true] [17592186282043 1000 #edb/ref 17592186282048 13194139534202 true] [17592186282043 1040 #edb/ref 17592186045450 13194139534202 true] [17592186282043 1041 "selection" 13194139534202 true] [17592186282043 1104 #edb/ref 17592186282048 13194139534202 true] [17592186282043 1110 #uuid "81390f49-093c-5b1b-92c3-af824077e155" 13194139534202 true] [17592186282044 1034 "\\operatorname{sin}⁡x" 13194139534202 true] [17592186282044 1103 #edb/ref 17592186045453 13194139534202 true] [17592186282044 1111 #uuid "52143fd5-aec2-550d-b233-1326538720a2" 13194139534202 true] [17592186282045 1034 "\\operatorname{sin}⁡x+1" 13194139534202 true] [17592186282045 1103 #edb/ref 17592186045453 13194139534202 true] [17592186282045 1111 #uuid "3bb41a19-b67b-5816-8a1f-237944556101" 13194139534202 true] [17592186282046 1034 "1" 13194139534202 true] [17592186282046 1103 #edb/ref 17592186045453 13194139534202 true] [17592186282046 1111 #uuid "2e56a16a-c924-57f6-a992-86c7ae04efc3" 13194139534202 true] [17592186282047 1034 "-\\operatorname{sin}⁡x" 13194139534202 true] [17592186282047 1103 #edb/ref 17592186045453 13194139534202 true] [17592186282047 1111 #uuid "a5156e51-cf96-5115-bf53-1b03c3e49c58" 13194139534202 true] [17592186282048 1034 "-1" 13194139534202 true] [17592186282048 1103 #edb/ref 17592186045453 13194139534202 true] [17592186282048 1111 #uuid "4648cdf0-aa80-5732-810e-74e872d47f58" 1