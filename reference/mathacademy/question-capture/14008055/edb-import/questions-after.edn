#{[{:db/id #edb/ref 17592186288579 :knowledge-point/_questions [{:knowledge-point/id #uuid "2dc967c7-840e-5717-98f2-330fcf0fe12d" :knowledge-point/title "Using the Definition of Left- and Right-Continuity to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65486cc-e0c3-5a89-92dc-2d75d3aa859d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186288581} {:answer/id #uuid "ce2cfb2f-8f73-55ca-8adb-97742afe648b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288582} {:answer/id #uuid "89bab611-0d16-58bb-b0be-cf573e5d6574" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288583} {:answer/id #uuid "718e3993-c1f9-5866-8400-096068f32d01" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288584} {:answer/id #uuid "845166f6-a170-5c4b-908e-9939aacf2aeb" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186288585}] :answer-field/correct {:answer/id #uuid "89bab611-0d16-58bb-b0be-cf573e5d6574" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288583} :answer-field/id #uuid "8ba629fe-0d3a-5090-b976-fb0118a14602" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288580}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dc9bf7e1-0415-5b1f-8191-59e7c1c2bbe7" :question/math-academy-id "q-104283" :question/problem "If $f(x)$ is right-continuous at $x=-5$ and ${lim}_{x\\to (-5)^{+}}f(x)=3,$ then what is ${lim}_{x\\to (-5)^{+}}(f(x)-2f(-5))?$" :question/worked-solution "Since $f(x)$ is right-continuous at $x=-5,$ we must have\n\n$$\n{lim}_{x\\to (-5)^{+}}f(x)=f(-5)=3.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to (-5)^{+}}(f(x)-2f(-5)) & ={lim}_{x\\to (-5)^{+}}f(x)-2f(-5) \\\\  & =3-2\\cdot 3 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288586 :knowledge-point/_questions [{:knowledge-point/id #uuid "2dc967c7-840e-5717-98f2-330fcf0fe12d" :knowledge-point/title "Using the Definition of Left- and Right-Continuity to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae3cd41f-5d0e-5518-bb89-97dd26501e9a" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186288588} {:answer/id #uuid "67dd1f81-0158-5467-adb0-c70a04ed6893" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288589} {:answer/id #uuid "9113f38d-b554-513a-8669-1078446d99a9" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186288590} {:answer/id #uuid "87661b25-acb2-55a3-b48a-8ce514d11000" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186288591} {:answer/id #uuid "1541d0bc-e016-5fb1-b4c1-1132dc8e52ae" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186288592}] :answer-field/correct {:answer/id #uuid "ae3cd41f-5d0e-5518-bb89-97dd26501e9a" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186288588} :answer-field/id #uuid "bf8e80ea-da20-5dd9-95c7-c6137e0da7c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288587}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "24c77bb9-9745-5fa3-b9aa-d41ed6504cbe" :question/math-academy-id "q-104286" :question/problem "If $f(x)$ is left-continuous at $x=-1$ and ${lim}_{x\\to (-1)^{-}}f(x)=-6,$ then what is \n${lim}_{x\\to (-1)^{-}}(2f(x)-xf(-1))?$" :question/worked-solution "Since $f(x)$ is left-continuous at $x=-1,$ we must have\n\n$$\n{lim}_{x\\to (-1)^{-}}f(x)=f(-1)=-6.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}(2f(x)-xf(-1)) & =2{lim}_{x\\to (-1)^{-}}f(x)-f(-1){lim}_{x\\to (-1)^{-}}x \\\\  & =2(-6)-(-6)(-1) \\\\  & =-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288593 :knowledge-point/_questions [{:knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41b56430-8074-5438-b795-fe06269f9f78" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186288595} {:answer/id #uuid "b39f98fe-83c1-53d2-a18d-edad8bd07656" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186288596} {:answer/id #uuid "4ca8e80d-23ef-5bfb-9e7e-ad23e6b8e586" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186288597} {:answer/id #uuid "113a1f39-b743-52e0-9718-ced5c396fd56" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186288598} {:answer/id #uuid "1544d18d-9dfd-583b-92c4-ffad8a4a57ea" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186288599}] :answer-field/correct {:answer/id #uuid "1544d18d-9dfd-583b-92c4-ffad8a4a57ea" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186288599} :answer-field/id #uuid "4b19ddfe-7042-54cd-9743-717ddf263bd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288594}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dcd491b3-785d-5af5-9d14-f794a09effb7" :question/math-academy-id "q-38355" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008055/assets/718dd1f38f7c790ab83639f69462b372de6b7e8501c0a4d6ff678340ab4154bd.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=0$\n- The function is right-continuous at $x=0$\n- The function is continuous at $x=0$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false.  The function is not left-continuous at $x=0,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{-}}f(x)=3\\ne 0=f(0)\n$$\n\n- Statement II is true. The function is right-continuous at $x=0,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=0=f(0)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186069234 :knowledge-point/_questions [{:knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a908dceb-8b83-5c9e-858b-5c1c0936a17f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186066936} {:answer/id #uuid "d1421ebb-6e5e-586a-b5e8-599b535bd927" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186066937} {:answer/id #uuid "e2b4c152-1fcf-52d3-9e7c-37bab566523c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186066938} {:answer/id #uuid "f50a8413-462f-5369-812a-fa6c8083da30" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186066939} {:answer/id #uuid "7429e3df-b601-5ea2-9642-f532001db709" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186066940}] :answer-field/correct {:answer/id #uuid "a908dceb-8b83-5c9e-858b-5c1c0936a17f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186066936} :answer-field/id #uuid "8a2696b9-29ec-5e2e-8d08-b15491265671" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066935}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f98bb945-e8b3-5349-97c2-0b4b023243ef" :question/math-academy-id "q-38547" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008055/assets/188e0169738a08b3d4580b4f5d3a3ab1aedef87a9d1b83f07c1b10686a38c321.png)\n\nWhich of the following statements are true in relation to the function $y=g(x)$ above?\n\n- The function is left-continuous at $x=0$\n- The function is right-continuous at $x=0$\n- The function is continuous at $x=0$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=0,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{-}}g(x)=0\\ne -2=g(0)\n$$\n\n- Statement II is true. The function is right-continuous at $x=0,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {0}^{+}}g(x)=-2=g(0)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=0,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186288600 :knowledge-point/_questions [{:knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef40162a-71c7-5198-b7b6-c17d99c73a24" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186288602} {:answer/id #uuid "18bedbb8-0cf6-50c8-80ce-f0fe2d9ee91f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186288603} {:answer/id #uuid "c09554b8-d00c-5e0d-a923-478cbbf96692" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186288604} {:answer/id #uuid "f858f097-4f4a-56aa-8af3-0c184edbf7f3" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186288605} {:answer/id #uuid "73ae6279-4b0f-5ec4-a115-2cee6676413d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186288606}] :answer-field/correct {:answer/id #uuid "ef40162a-71c7-5198-b7b6-c17d99c73a24" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186288602} :answer-field/id #uuid "52815081-128f-5fc3-8b49-40e19824f539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288601}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "084fa67b-0f7e-5ce8-9e5f-c46eae83ee05" :question/math-academy-id "q-73106" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008055/assets/89dca4b059ccbd1fe93d000acabcbd33b5fc10389de48ef3cbae65cb4455f29e.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=1$\n- The function is right-continuous at $x=1$\n- The function is continuous at $x=1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."}]}
