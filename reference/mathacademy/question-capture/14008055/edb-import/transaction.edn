tion"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4"] :knowledge-point/questions ["q-73106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104283/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "e65486cc-e0c3-5a89-92dc-2d75d3aa859d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-104283/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "718e3993-c1f9-5866-8400-096068f32d01" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-104283/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "845166f6-a170-5c4b-908e-9939aacf2aeb" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-104283/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "ce2cfb2f-8f73-55ca-8adb-97742afe648b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-104283/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "89bab611-0d16-58bb-b0be-cf573e5d6574" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-104283/selection" :answer-field/id #uuid "8ba629fe-0d3a-5090-b976-fb0118a14602" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104283/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-104283/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-104283/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-104283/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-104283/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-104283/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-104283" :question/id #uuid "dc9bf7e1-0415-5b1f-8191-59e7c1c2bbe7" :question/math-academy-id "q-104283" :question/problem "If $f(x)$ is right-continuous at $x=-5$ and ${lim}_{x\\to (-5)^{+}}f(x)=3,$ then what is ${lim}_{x\\to (-5)^{+}}(f(x)-2f(-5))?$" :question/worked-solution "Since $f(x)$ is right-continuous at $x=-5,$ we must have\n\n$$\n{lim}_{x\\to (-5)^{+}}f(x)=f(-5)=3.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to (-5)^{+}}(f(x)-2f(-5)) & ={lim}_{x\\to (-5)^{+}}f(x)-2f(-5) \\\\  & =3-2\\cdot 3 \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104283/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc967c7-840e-5717-98f2-330fcf0fe12d"] :knowledge-point/questions ["q-104283"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104286/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "67dd1f81-0158-5467-adb0-c70a04ed6893" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-104286/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "9113f38d-b554-513a-8669-1078446d99a9" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-104286/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "ae3cd41f-5d0e-5518-bb89-97dd26501e9a" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-104286/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "1541d0bc-e016-5fb1-b4c1-1132dc8e52ae" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-104286/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "87661b25-acb