e correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png)"}] [{:db/id #edb/ref 17592186172313 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa9e87f9-dbe3-55c6-8f71-d5ac64bf74b3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-5.png" :db/id #edb/ref 17592186169082} {:answer/id #uuid "b1c51fe3-1985-5b3f-892a-31f6551e2d76" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-4.png" :db/id #edb/ref 17592186169083} {:answer/id #uuid "c3eca9b8-76e2-5327-975c-f68be52e3ae1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-3.png" :db/id #edb/ref 17592186169084} {:answer/id #uuid "2786a5c3-7542-574e-9474-1b6cdf94e358" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-2.png" :db/id #edb/ref 17592186169085} {:answer/id #uuid "38df0ddd-f92d-5e7f-a88d-fd40c5e78f64" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-1.png" :db/id #edb/ref 17592186169086}] :answer-field/correct {:answer/id #uuid "38df0ddd-f92d-5e7f-a88d-fd40c5e78f64" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-162254-a-1.png" :db/id #edb/ref 17592186169086} :answer-field/id #uuid "bc00c1e2-7bc4-52ed-ac88-a378dad44093" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186169081}] :questi