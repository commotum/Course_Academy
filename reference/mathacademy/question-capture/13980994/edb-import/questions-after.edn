c20e86357894bc24683d.png" :db/id #edb/ref 17592186300840} :answer-field/id #uuid "b6bcd609-1ecf-51f4-b59f-a836e6471305" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300839}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "27be2411-f301-557e-8d57-1c4d09d92854" :question/math-academy-id "q-162313" :question/problem "Which of the following diagrams shows all the $6$th roots of unity?" :question/worked-solution "Geometrically, the $6$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular hexagon (regular $6$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png)"}] [{:db/id #edb/ref 17592186172358 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba26e37f-346f-5039-b9f3-0cc80afb603e" :answer/type {:db/ident :answer.type/math} :answer/value "e^{13π\\textrm{i}/12}" :db/id #edb/ref 17592186169631} {:answer/id #uuid "f7129cb5-c874-5bf4-b1a0-6351dd55b9a5" :answer/type {:db/ident :answer.type/math} :answer/value "e^{7π\\textrm{i}/6}" :db/id #edb/ref 17592186169632} {:answer/id #uuid "253f06cb-e4d4-5c15-926f-7f5d086d1535" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4π\\textrm{i}/3}" :db/id #edb/ref 17592186169633} {:answer/id #uuid "4364b4d7-1a0a-5108-a30a-15dbd17146b5" :answer/type {:db/ident :answer.type/math} :answer/value "e^{17π\\textrm{i}/12}" :db/id #edb/ref 17592186169634} {:answer/id #uuid "7198bd1b-3780-5f5b-842a-3f854b6af5d6" :answer/type {:db/ident :answer.type/math} :answer/value "e^{5π\\textrm{i}/4}" :db/id #edb/ref 17592186169635}] :answer-field/correct {:answer/id #uuid "253f06cb-e4d4-5c15-926f-7f5d086d1535" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4π\\textrm{i}/3}" :db/id #edb/ref 17592186169633} :answer-field/id #uuid "96e6a26f-f33c-54d9-83e4-0bea2352d5d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186169630}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "04057c82-eba4-5153-9f48-9972784b519b" :question/math-academy-id "q-211001" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/0c592ccfd6ea92e0f0181d5dfe4804cc0dba800f468d9fb4e9d96cef2be72be4.png)\n\nFind the $6$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/ff5d1682ca8d142ad4cf73b9a5c996164653d940157efd695d1da13d34900404.png)\n\n \n\nSo, the required root corresponds to $k=4.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{4}={e}^{(4)\\pi \\text{i}/3}={e}^{4\\pi \\text{i}/3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172359 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90468c09-7690-5b30-b452-78bdf8271232" :answer/type {:db/ident :answer.type/math} :answer/value "e^{9π\\textrm{i}/10}" :db/id #edb/ref 17592186169637} {:answer/id #uuid "964bfa6e-62f8-5963-99ec-0ad23e7ec111" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2π\\textrm{i}/3}" :db/id #edb/ref 17592186169638} {:answer/id #uuid "eb11943e-2aed-5daa-b4cb-4d6c38f7cb29" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4π\\textrm{i}/5}" :db/id #edb/ref 17592186169639} {:answer/id #uuid "2cb5eb62-191f-5310-9f70-1165ef7cd7e2" :answer/type {:db/ident :answer.type/math} :answer/value "e^{3π\\textrm{i}/5}" :db/id #edb/ref 17592186169640} {:answer/id #uuid "4c2f7191-b2ec-5418-95df-30b2c981efb7" :answer/type {:db/ident :answer.type/math} :answer/value "e^{7π\\textrm{i}/10}" :db/id #edb/ref 17592186169641}] :answer-field/correct {:answer/id #uuid "eb11943e-2aed-5daa-b4cb-4d6c38f7cb29" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4π\\textrm{i}/5}" :db/id #edb/ref 17592186169639} :answer-field/id #uuid "a9cc0197-f755-5b88-8665-c277bf40a934" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186169636}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5b704eec-7f79-50d8-9368-72a6abb32862" :question/math-academy-id "q-211004" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/0a23346ac28172521a3230a949607422efe77e2803973ac42e4255f321c3a1a0.png)\n\nFind the root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $5$ points in our diagram, we need to find a $5$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{5}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/5}={e}^{2k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/53c8822760ceb51c1d1bd685947dbfefa7dfdc3490027db62cbcaf5d9aa24335.png)\n\n \n\nSo, the required root corresponds to $k=2.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{2}={e}^{2(2)\\pi \\text{i}/5}={e}^{4\\pi \\text{i}/5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186300845 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d06b409b-4fef-5c88-b3e5-293325ee33d8" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186300847} {:answer/id #uuid "59f526c2-f262-5e1b-81d7-b6e3065ce0e1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{14\\pi \\text{i}/9}" :db/id #edb/ref 17592186300848} {:answer/id #uuid "f3b82cb2-d5ea-5632-91f7-cc8406391289" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{12\\pi \\text{i}/9}" :db/id #edb/ref 17592186300849} {:answer/id #uuid "2abddbcc-885f-500f-a58f-c73a3955f1d8" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{16\\pi \\text{i}/9}" :db/id #edb/ref 17592186300850} {:answer/id #uuid "e5bea1f8-e28c-51fd-9046-7ec9fee863ca" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186300851}] :answer-field/correct {:answer/id #uuid "59f526c2-f262-5e1b-81d7-b6e3065ce0e1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{14\\pi \\text{i}/9}" :db/id #edb/ref 17592186300848} :answer-field/id #uuid "8ff19d2a-38c0-55de-b798-c587f76a0f09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300846}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f52d2e5e-410c-538e-83f2-0b54c29688e7" :question/math-academy-id "q-216703" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/91eb6ed60e58b03732bdcea3e9858db452d2d998c6a6abed538bbcc76412ed4c.png)\n\nFind the $9$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{9}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/9}={e}^{2k\\pi \\text{i}/9}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/9b3977b8b51c54a1ef552cff48a3be5a269c92a96742cba5c87e618bb616e5a0.png)\n\n \n\nSo, the required root corresponds to $k=7.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{7}={e}^{2(7)\\pi \\text{i}/9}={e}^{14\\pi \\text{i}/9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186300852 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "952c75f1-6dfb-5040-9b45-6014db9a10d3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/7}" :db/id #edb/ref 17592186300854} {:answer/id #uuid "1ba16127-1861-56af-96cd-ca09ef0faf0c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/14}" :db/id #edb/ref 17592186300855} {:answer/id #uuid "552cf4c8-8f92-51db-a52a-073f35665fc3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/7}" :db/id #edb/ref 17592186300856} {:answer/id #uuid "757908a5-e769-5ce5-a54b-ba27d54f6092" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9\\pi \\text{i}/14}" :db/id #edb/ref 17592186300857} {:answer/id #uuid "997f72b7-1f3a-5705-b45c-6366dc36ed62" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6\\pi \\text{i}/7}" :db/id #edb/ref 17592186300858}] :answer-field/correct {:answer/id #uuid "997f72b7-1f3a-5705-b45c-6366dc36ed62" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6\\pi \\text{i}/7}" :db/id #edb/ref 17592186300858} :answer-field/id #uuid "e4162b83-4572-55a7-82f5-e571b089e8d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300853}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "23ae02b3-e88e-5a0a-9b61-10fa9eac66c9" :question/math-academy-id "q-216706" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/89d0606f11701cb59685e5ea1540b8ed98ce8cfe371951a675f01a1c6cc5a748.png)\n\nFind the $7$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{7}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/7}={e}^{2k\\pi \\text{i}/7}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/344d760f2cd08e5e1e1eccc2664e7182d01744ee9b0b15f985c6d7b4e0e5515d.png)\n\n \n\nSo, the required root corresponds to $k=3.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{3}={e}^{2(3)\\pi \\text{i}/7}={e}^{6\\pi \\text{i}/7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186300859 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a628c5b-050f-578d-828c-8ce8fb51ff50" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186300861} {:answer/id #uuid "f9b03ad3-520c-5373-8a86-dfd1c23b5e1f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186300862} {:answer/id #uuid "61393dfd-ae08-5cdf-88a1-dc87546a4065" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186300863} {:answer/id #uuid "ddcea307-b9f9-540f-97f8-215e8753df1e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{16\\pi \\text{i}/9}" :db/id #edb/ref 17592186300864} {:answer/id #uuid "fc236137-573f-52ba-8894-4de514452510" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186300865}] :answer-field/correct {:answer/id #uuid "fc236137-573f-52ba-8894-4de514452510" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186300865} :answer-field/id #uuid "4a05498f-53c0-58b5-89e6-8e1202192536" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300860}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "596537bc-7517-56c6-b0dc-d83adc1cdd57" :question/math-academy-id "q-216710" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/b575a8b3c4830aa48586b457b45f76ca8df49ecf8036df720f66aaddc857bdaf.png)\n\nFind the root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $6$ points in our diagram, we need to find a $6$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/34a3bb77a9765cd806a047ad42a7f0719201effdd46659efe7ffd1a94a051910.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/3}={e}^{5\\pi \\text{i}/3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172591 :knowledge-point/_questions [{:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "939af705-5c3c-5cf4-b92e-7c6423086206" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/4}" :db/id #edb/ref 17592186171512} {:answer/id #uuid "e23ae62d-81bb-58b0-9a4a-e3a355a5b982" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/8}" :db/id #edb/ref 17592186171513} {:answer/id #uuid "fa3341f9-97f4-53ec-94dc-c8d1b886e2c5" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/6}" :db/id #edb/ref 17592186171514} {:answer/id #uuid "05734bb9-28d9-5b3f-9319-308fae7e82ad" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/12}" :db/id #edb/ref 17592186171515} {:answer/id #uuid "430d60fa-fbd0-54c7-9601-558a9e95465e" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/24}" :db/id #edb/ref 17592186171516}] :answer-field/correct {:answer/id #uuid "fa3341f9-97f4-53ec-94dc-c8d1b886e2c5" :answer/type {:db/ident :answer.type/math} :answer/value "e^{π\\textrm{i}/6}" :db/id #edb/ref 17592186171514} :answer-field/id #uuid "a08603bd-1e45-5644-ab72-03fd00f618d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171511}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "80666ce1-1c2d-5744-b804-71b46653b414" :question/math-academy-id "q-97998" :question/problem "Find the principal $12$th root of unity." :question/worked-solution "Let $z$ be a $12$th root of unity. This means that \n\n$$\n{z}^{12}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{12}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/12}={e}^{k\\pi \\text{i}/6}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/6}.$"}] [{:db/id #edb/ref 17592186300866 :knowledge-point/_questions [{:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "390b7eca-7d55-510f-b9b1-0ce354c04633" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/2}" :db/id #edb/ref 17592186300868} {:answer/id #uuid "ce219233-a882-5560-a132-3922cf4ed2b1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186300869} {:answer/id #uuid "e5480b3c-feab-5e02-9903-dcf0317d1762" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/8}" :db/id #edb/ref 17592186300870} {:answer/id #uuid "b5fe97f3-39b3-5b74-9c31-e772183a63a4" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186300871} {:answer/id #uuid "9d152a50-d96b-5caf-8d2f-49bc941505ae" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/8}" :db/id #edb/ref 17592186300872}] :answer-field/correct {:answer/id #uuid "390b7eca-7d55-510f-b9b1-0ce354c04633" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/2}" :db/id #edb/ref 17592186300868} :answer-field/id #uuid "6b1a10d1-1681-56cf-ba00-63fffeac9581" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300867}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f1fa0b0c-dc52-5fef-b420-71c6684ba1c2" :question/math-academy-id "q-98160" :question/problem "Find the principal $4$th root of unity." :question/worked-solution "Let $z$ be a $4$th root of unity. This means that \n\n$$\n{z}^{4}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{4}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/4}={e}^{k\\pi \\text{i}/2}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/2}.$"}] [{:db/id #edb/ref 17592186300873 :knowledge-point/_questions [{:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e652c13-0ef1-5f40-9a86-53dfe17abd8a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/14}" :db/id #edb/ref 17592186300875} {:answer/id #uuid "5f39e310-8ef3-5caa-b554-ff6b3e4a48c9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/7}" :db/id #edb/ref 17592186300876} {:answer/id #uuid "31e1d617-ae33-5689-9936-61c42aa80e11" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\