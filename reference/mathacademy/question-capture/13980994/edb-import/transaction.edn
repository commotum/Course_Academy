/validate]} {:db/id "q-98164" :question/id #uuid "b4d4af6f-bac1-5cdd-a547-0504f2ada938" :question/math-academy-id "q-98164" :question/problem "Find the principal $9$th root of unity." :question/worked-solution "Let $z$ be a $9$th root of unity. This means that \n\n$$\n{z}^{9}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{9}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/9}={e}^{2k\\pi \\text{i}/9}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{2\\pi \\text{i}/9}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98164/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7"] :knowledge-point/questions ["q-98164"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98161/selection/4031a8f04c403c47807184f1d69f7b9d0955c7f89707d7aea54314bfb6f9babe" :answer/id #uuid "5f39e310-8ef3-5caa-b554-ff6b3e4a48c9" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/7}" :db/ensure [:answer/validate]} {:db/id "q-98161/selection/f6c94266174b562546b25ef0ae2fc2fa61e6a2e895eee6c831301006465036cb" :answer/id #uuid "b5a8d673-50f2-5453-8221-294b7541e4be" :answer/type :answer.type/math :answer/value "{e}^{2\\pi \\text{i}/7}" :db/ensure [:answer/validate]} {:db/id "q-98161/selection/0626af472f630902b7839e84e13f74b0efd4fbe4283011150cda599442f68f03" :answer/id #uuid "5e652c13-0ef1-5f40-9a86-53dfe17abd8a" :answer/type :answer.type/math :answer/value "{e}^{3\\pi \\text{i}/14}" :db/ensure [:answer/validate]} {:db/id "q-98161/selection/a1effcdc8b72075c7b10645de23808f77ecc21e6614b8b57dbe5e3e81a3cb8aa" :answer/id #uuid "31e1d617-ae33-5689-9936-61c42aa80e11" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-98161/selection/a43dc9aca229417f1d861970796ff0ddfc198abd5f556a686e1a180c79c207b1" :answer/id #uuid "3dd036dd-3cf0-5d00-9d76-a38a96622e2a" :answer/type :answer.type/math :answer/value "{e}^{7\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-98161/selection" :answer-field/id #uuid "24130b5b-c5d8-5259-83b6-40770dbd3f84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98161/selection/f6c94266174b562546b25ef0ae2fc2fa61e6a2e895eee6c831301006465036cb" :answer-field/choices ["q-98161/selection/4031a8f04c403c47807184f1d69f7b9d0955c7f89707d7aea54314bfb6f9babe" "q-98161/selection/f6c94266174b562546b25ef0ae2fc2fa61e6a2e895eee6c831301006465036cb" "q-98161/selection/0626af472f630902b7839e84e13f74b0efd4fbe4283011150cda599442f68f03" "q-98161/selection/a1effcdc8b72075c7b10645de23808f77ecc21e6614b8b57dbe5e3e81a3cb8aa" "q-98161/selection/a43dc9aca229417f1d861970796ff0ddfc198abd5f556a686e1a180c79c207b1"] :db/ensure [:answer-field/validate]} {:db/id "q-98161" :question/id #uuid "7a0bde8d-e87b-52fb-828a-038fb7a59a56" :question/math-academy-id "q-98161" :question/problem "Find the principal $7$th root of unity." :question/worked-solution "Let $z$ be a $7$th root of unity. This means that \n\n$$\n{z}^{7}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{7}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/7}={e}^{2k\\pi \\text{i}/7}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{2\\pi \\text{i}/7}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7"] :knowledge-point/questions ["q-98161"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-97998"] :question/worked-solution "Let $z$ be a $12$th root of unity. This means that \n\n$$\n{z}^{12}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{12}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/12}={e}^{k\\pi \\text{i}/6}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/6}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-107494/selection/85ee9e8701746aaeb99615893bf558b9c25b72035b60fd748dc8a77cc37fe59e" :answer/id #uuid "d473f327-3d7c-58fb-85b5-e49420846c48" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/22}" :db/ensure [:answer/validate]} {:db/id "q-107494/selection/19a975834832a23b15ea5d4c1eeb2822bf1099babfcf56d90c40e8d24c2e7dc5" :answer/id #uuid "39cd7132-5af1-5a64-8513-9e1678b507b7" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/11}" :db/ensure [:answer/validate]} {:db/id "q-107494/selection/110e4783a111674f8316c9b168522382ef5d940e809b5c31f7ca17e425c613d0" :answer/id #uuid "6ad495ac-8f9c-5c12-99d1-fee786d60f7f" :answer/type :answer.type/math :answer/value "{e}^{2\\pi \\text{i}/11}" :db/ensure [:answer/validate]} {:db/id "q-107494/selection/ddd37ce34cdc672448c1e2a2047aea2f3f62df5cb18163dc8cdcdc1e484899d7" :answer/id #uuid "a20bb287-12f3-52a8-b533-32485b9e4f90" :answer/type :answer.type/math :answer/value "{e}^{3\\pi \\text{i}/22}" :db/ensure [:answer/validate]} {:db/id "q-107494/selection/827fefc1228b203597765adaeff0d16c2e9ccb3ee271f18a02a509b2ab904118" :answer/id #uuid "0c6ffef5-ff6c-5e60-adcb-c4434d3b6763" :answer/type :answer.type/mat