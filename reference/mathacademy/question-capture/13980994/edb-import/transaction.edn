665ef0849591dd846dd959756ea6e41b6.png" :db/ensure [:answer/validate]} {:db/id "q-162313/selection" :answer-field/id #uuid "b6bcd609-1ecf-51f4-b59f-a836e6471305" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162313/selection/1a7f9d289841d41c53b56d8f4dae7069ef7179b1752da7c6e6b7aab0433c7940" :answer-field/choices ["q-162313/selection/9efcb8b5ef60c1bd8d7fd07f831aa861aefa0e09c6a20778709dc52a06d69781" "q-162313/selection/1a7f9d289841d41c53b56d8f4dae7069ef7179b1752da7c6e6b7aab0433c7940" "q-162313/selection/9b047de649e06580f3d1a215ab9431cf3afa68c8f925616ae1c5e0f618609493" "q-162313/selection/7f281967accfbfb2a1fd5effe9e34ba26851449c107b27c3d05d42de42b84d1f" "q-162313/selection/bc4a41b707863c7ac3dbcf5a7a781d96575d2b724da4f7d058745ee8f2320e27"] :db/ensure [:answer-field/validate]} {:db/id "q-162313" :question/id #uuid "27be2411-f301-557e-8d57-1c4d09d92854" :question/math-academy-id "q-162313" :question/problem "Which of the following diagrams shows all the $6$th roots of unity?" :question/worked-solution "Geometrically, the $6$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular hexagon (regular $6$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-162313/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441"] :knowledge-point/questions ["q-162313"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-162254"] :question/worked-solution "Geometrically, the $3$rd roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form an equilateral triangle (regular $3$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-216703/selection/e49ee6fda9c6edf413fc147ee5802fb99491af1c12ac81d9350762c4fa89b95e" :answer/id #uuid "e5bea1f8-e28c-51fd-9046-7ec9fee863ca" :answer/type :answer.type/math :answer/value "{e}^{5\\pi \\text{i}/3}" :db/ensure [:answer/validate]} {:db/id "q-216703/selection/b35298966e923840bac47f66922370ad8fff191273db67ca271fc42d7b243f5a" :answer/id #uuid "2abddbcc-885f-500f-a58f-c73a3955f1d8" :answer/type :answer.type/math :answer/value "{e}^{16\\pi \\text{i}/9}" :db/ensure [:answer/validate]} {:db/id "q-216703/selection/9523efc3f639b86825bcda652f1ccbbda0f2cfbe4b9a8d666ce2645e6da35d44" :answer/id #uuid "f3b82cb2-d5ea-5632-91f7-cc8406391289" :answer/type :answer.type/math :answer/value "{e}^{12\\pi \\text{i}/9}" :db/ensure [:answer/validate]} {:db/id "q-216703/selection/6cf555c6c77ecd408d7fe7a23aa845c2ce248421fbdfac4508d1769b28cba870" :answer/id #uuid "59f526c2-f262-5e1b-81d7-b6e3065ce0e1" :answer/type :answer.type/math :answer/value "{e}^{14\\pi \\text{i}/9}" :db/ensure [:answer/validate]} {:db/id "q-216703/selection/3db96dea095afc5f84c32ee210f7b4ee5c238f91215dea29cab0c7d90b9cf389" :answer/id #uuid "d06b409b-4fef-5c88-b3e5-293325ee33d8" :answer/type :answer.type/math :answer/value "{e}^{11\\pi \\text{i}/6}" :db/ensure [:answer/validate]} {:db/id "q-216703/selection" :answer-field/id #uuid "8ff19d2a-38c0-55de-b798-c587f76a0f09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-216703/selection/6cf555c6c77ecd408d7fe7a23aa845c2ce248421fbdfac4508d1769b28cba870" :answer-field/choices ["q-216703/selection/e49ee6fda9c6edf413fc147ee5802fb99491af1c12ac81d9350762c4fa89b95e" "q-216703/selection/b35298966e923840bac47f66922370ad8fff191273db67ca271fc42d7b243f5a" "q-216703/selection/9523efc3f639b86825bcda652f1ccbbda0f2cfbe4b9a8d666ce2645e6da35d44" "q-216703/selection/6cf555c6c77ecd408d7fe7a23aa845c2ce248421fbdfac4508d1769b28cba870" "q-216703/selection/3db96dea095afc5f84c32ee210f7b4ee5c238f91215dea29cab0c7d90b9cf389"] :db/ensure [:answer-field/validate]} {:db/id "q-216703" :question/id #uuid "f52d2e5e-410c-538e-83f2-0b54c29688e7" :question/math-academy-id "q-216703" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/91eb6ed60e58b03732bdcea3e9858db452d2d998c6a6abed538bbcc76412ed4c.png)\n\nFind the $9$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{9}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/9}={e}^{2k\\pi \\text{i}/9}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/9b3977b8b51c54a1ef552cff48a3be5a269c92a96742cba5c87e618bb616e5a0.png)\n\n \n\nSo, the required root corresponds to $k=7.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{7}={e}^{2(7)\\pi \\text{i}/9}={e}^{14\\pi \\text{i}/9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-216703/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c"] :knowledge-point/questions ["q-216703"] :db/ensure [:knowledge-point/validate]} {:db/id "q-216710/selection/b35298966e923840bac47f66922370ad8fff191273db67ca271fc42d7b243f5a" :answer/id #uuid "ddcea307-b9f9-540f-97f8-215e8753df1e" :answer/type :answer.type/math :answer/value "{e}^{16\\pi \\text{i}/9}" :db/ensure [:answer/validate]} {:db/id "q-216710/selection/3db96dea095afc5f84c32ee210f7b4ee5c238f91215dea29cab0c7d90b9cf389" :answer/id #uuid "f9b03ad3-520c-5373-8a86-dfd1c23b5e1f" :answer/type :answer.type/math :answer/value "{e}^{11\\pi \\text{i}/6}" :db/ensure [:answer/validate]} {:db/id "q-216710/selection/60672cd99428f2e0e99c1f7855ff7cf81cb8ef3b4892fbd51ed24837d936b2cf" :answer/id #uuid "61393dfd-ae08-5cdf-88a1-dc87546a4065" :answer/type :answer.type/math :answer/value "{e}^{7\\pi \\text{i}/6}" :db/ensure [:answer/validate]} {:db/id "q-216710/selection/20b5e2eac5536dea94e915aaa979d5d142d4cff7d8186446ea25272715937c5b" :answer/id #uuid "2a628c5b-050f-578d-828c-8ce8fb51ff50" :answer/type :answer.type/math :answer/value "{e}^{4\\pi \\text{i}/3}" :db/ensure [:answer/validate]} {:db/id "q-216710/selection/e49ee6fda9c6edf413fc147ee5802fb99491af1c12ac81d9350762c4fa89b95e" :answer/id #uuid "fc236137-573f-52ba-8894-4de514452510" :answer/type :answer.type/math :answer/value "{e}^{5\\pi \\text{i}/3}" :db/ensure [:answer/validate]} {:db/id "q-216710/selection" :answer-field/id #uuid "4a05498f-53c0-58b5-89e6-8e1202192536" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-216710/selection/e49ee6fda9c6edf413fc147ee5802fb99491af1c12ac81d9350762c4fa89b95e" :answer-field/choices ["q-216710/selection/b35298966e923840bac47f66922370ad8fff1912