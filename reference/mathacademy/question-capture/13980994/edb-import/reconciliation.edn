74c9be06dd909d7079c3a361157881bb5.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-162254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-162254" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-162254" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/9111f21143412d791b0195722da4f6d461444f386efd9baf609c70a4fe709fd8.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/d6aedcd00b87f3d407ad796b8456dda7aec47158bcc4a5193e8d3505255d65d1.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/f15f43e3663cfee8328135cb30894c4f268004f4bb74c838cb1bbf2c654c19f9.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/f46bc6f77ef68b417dfab14cc09d52e31b99364fe248d37d940ba08264fcbdba.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-162254" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216703" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/91eb6ed60e58b03732bdcea3e9858db452d2d998c6a6abed538bbcc76412ed4c.png)\n\nFind the $9$th root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216703" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{9}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/9}={e}^{2k\\pi \\text{i}/9}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/9b3977b8b51c54a1ef552cff48a3be5a269c92a96742cba5c87e618bb616e5a0.png)\n\n \n\nSo, the required root corresponds to $k=7.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{7}={e}^{2(7)\\pi \\text{i}/9}={e}^{14\\pi \\text{i}/9}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216703" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-216703" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216703" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{11\\pi \\text{i}/6}"] ["math" "{e}^{12\\pi \\text{i}/9}"] ["math" "{e}^{14\\pi \\text{i}/9}"] ["math" "{e}^{16\\pi \\text{i}/9}"] ["math" "{e}^{5\\pi \\text{i}/3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216703" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{14\\pi \\text{i}/9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216710" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/b575a8b3c4830aa48586b457b45f76ca8df49ecf8036df720f66aaddc857bdaf.png)\n\nFind the root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216710" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $6$ points in our diagram, we need to find a $6$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/34a3bb77a9765cd806a047ad42a7f0719201effdd46659efe7ffd1a94a051910.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/3}={e}^{5\\pi \\text{i}/3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216710" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-216710" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216710" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{11\\pi \\text{i}/6}"] ["math" "{e}^{16\\pi \\text{i}/9}"] ["math" "{e}^{4\\pi \\text{i}/3}"] ["math" "{e}^{5\\pi \\text{i}/3}"] ["math" "{e}^{7\\pi \\text{i}/6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216710" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{5\\pi \\text{i}/3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211004" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/0a23346ac28172521a3230a949607422efe77e2803973ac42e4255f321c3a1a0.png)\n\nFind the root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211004" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $5$ points in our diagram, we need to find a $5$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{5}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/5}={e}^{2k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/53c8822760ceb51c1d1bd685947dbfefa7dfdc3490027db62cbcaf5d9aa24335.png)\n\n \n\nSo, the required root corresponds to $k=2.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{2}={e}^{2(2)\\pi \\text{i}/5}={e}^{4\\pi \\text{i}/5}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211004" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-211004" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211004" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{2\\pi \\text{i}/3}"] ["math" "{e}^{3\\pi \\text{i}/5}"] ["math" "{e}^{4\\pi \\text{i}/5}"] ["math" "{e}^{7\\pi \\text{i}/10}"] ["math" "{e}^{9\\pi \\text{i}/10}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211004" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{4\\pi \\text{i}/5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216706" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/89d0606f11701cb59685e5ea1540b8ed98ce8cfe371951a675f01a1c6cc5a748.png)\n\nFind the $7$th root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216706" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{7}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/7}={e}^{2k\\pi \\text{i}/7}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/344d760f2cd08e5e1e1eccc2664e7182d01744ee9b0b15f985c6d7b4e0e5515d.png)\n\n \n\nSo, the required root corresponds to $k=3.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{3}={e}^{2(3)\\pi \\text{i}/7}={e}^{6\\pi \\text{i}/7}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216706" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-216706" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216706" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{11\\pi \\text{i}/14}"] ["math" "{e}^{3\\pi \\text{i}/7}"] ["math" "{e}^{5\\pi \\text{i}/7}"] ["math" "{e}^{6\\pi \\text{i}/7}"] ["math" "{e}^{9\\pi \\text{i}/14}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-216706" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{6\\pi \\text{i}/7}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211001" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/0c592ccfd6ea92e0f0181d5dfe4804cc0dba800f468d9fb4e9d96cef2be72be4.png)\n\nFind the $6$th root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211001" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/ff5d1682ca8d142ad4cf73b9a5c996164653d940157efd695d1da13d34900404.png)\n\n \n\nSo, the required root corresponds to $k=4.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{4}={e}^{(4)\\pi \\text{i}/3}={e}^{4\\pi \\text{i}/3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211001" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/activity-metadata.json" "file_sha256" "57dd46a5e6d8e99dbe0ad13a4025b3d790f12a0859dfc70e2b91b1069e04cd94"} {"question" "q-211001" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211001" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{13\\pi \\text{i}/12}"] ["math" "{e}^{17\\pi \\text{i}/12}"] ["math" "{e}^{4\\pi \\text{i}/3}"] ["math" "{e}^{5\\pi \\text{i}/4}"] ["math" "{e}^{7\\pi \\text{i}/6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "q-211001" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{4\\pi \\text{i}/3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/state.json" "file_sha256" "7f75c4c5c156d3c2358e1923507d25f5553beef6f8209a84d0e392a9f8598291"} {"question" "e-14557" "field" nil "attribute" "question/problem" "value" "Find the principal $6$th root of unity." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14557.json" "file_sha256" "5956c955c894b2387e54c0551951ee808f278c7af36b82df43ef12087c78cb2e"} {"question" "e-14557" "field" nil "attribute" "question/worked-solution" "value" "Let $z$ be a $6$th root of unity. This means that \n\n$$\nz^{6} = 1.\n$$\n\nFirst, we express the complex number $1$ in the form $re^{\\textrm{i}\\theta}.$ Notice that $|1| = 1$ and $\\arg(1) = 0.$ Hence, \n\n$$\n1 = e^{\\textrm{i}(0 + 2k\\pi)} = e^{2k\\pi \\textrm{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to $e^{\\pi \\textrm{i}/3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14557.json" "file_sha256" "5956c955c894b2387e54c0551951ee808f278c7af36b82df43ef12087c78cb2e"} {"question" "e-14558" "field" nil "attribute" "question/problem" "value" "Sketch a diagram showing all the $4$th roots of unity." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14558.json" "file_sha256" "f03708c8e7e9fd3452bc215cd6f5e3086e76d9a5e3a4c3140daa36ed916d6f1b"} {"question" "e-14558" "field" nil "attribute" "question/worked-solution" "value" "Geometrically, the $4$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a square (regular $4$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/9111f21143412d791b0195722da4f6d461444f386efd9baf609c70a4fe709fd8.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14558.json" "file_sha256" "f03708c8e7e9fd3452bc215cd6f5e3086e76d9a5e3a4c3140daa36ed916d6f1b"} {"question" "e-14559" "field" nil "attribute" "question/problem" "value" "Find the root of unity highlighted in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/7ae59d6d770f5cb0ef10a42c6bc9e5851fa48b1d122417ce78155a8dcf17be6a.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14559.json" "file_sha256" "cdd982c02af7240f655ed2f86b8661320c85a3fdf97d81442506e71ede7c94fa"} {"question" "e-14559" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $7$ points in our diagram, we need to find a $7$th root of unity.\n\nFirst, we express the complex number $1$ in the form $re^{\\textrm{i}\\theta}.$ Notice that $|1| = 1$ and $\\arg(1) = 0.$ Hence, \n\n$$\n1 = e^{\\textrm{i}(0 + 2k\\pi)} = e^{2k\\pi \\textrm{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{7}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/7}={e}^{2k\\pi \\text{i}/7}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/assets/730b0c3c63799b9101ce89d38e3d96c10bc0e217b967506393ea67757ecf48d7.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{2(5)\\pi \\text{i}/7}={e}^{10\\pi \\text{i}/7}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980994/example-14559.json" "file_sha256" "cdd982c02af7240f655ed2f86b8661320c85a3fdf97d81442506e71ede7c94fa"}] "usage" {"e-14557" [] "e-14558" [] "q-97998" [] "q-211004" [] "q-211001" [] "q-162254" [] "e-14559" []} "basis" 1330 "retractions" [[17592186172359 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-211004.png)\n\nFind the root of unity highlighted in the diagram above."] [17592186172358 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/q-211001.png)\n\nFind the $6$th root of unity highlighted in the diagram above."] [17592186171672 :question/worked-solution "Let $z$ be a $6$th root of unity. This means that\n\n$$\nz^{6} = 1\n$$\n\nFirst, we express the complex number $1$ in the form $re^{\\textrm{i}\\theta}$. Notice that\n\n$$\n\\mid 1 \\mid = 1\n$$\n\nand\n\n$$\n\\arg(1) = 0\n$$\n\nHence,\n\n$$\n1 = e^{\\textrm{i}(0 + 2k\\pi)} = e^{2k\\pi \\textrm{i}}\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\nz^{6} = e^{2kπ\\textrm{i}}⟹z = (e^{2kπ\\textrm{i}})^{1/6} = e^{kπ\\textrm{i}/3}\n$$\n\nThe principal root corresponds to $k=1$, and is therefore equal to $e^{\\pi \\textrm{i}/3}$."] [17592186171673 :question/worked-solution "Geometrically, the $4$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n- one of the roots is $1$, corresponding to the point $(1,0)$ on the complex plane,\n- the roots form a square (regular $4$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/28513be60912977c95ecf4ec773d3792.png)"] [17592186171674 :question/problem "Find the root of unity highlighted in the diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/98e9ea0ab66a999ba39a7d107f156d9f.png)"] [17592186171674 :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0)$.\n\nSince there are $7$ points in our diagram, we need to find a $7$th root of unity.\n\nFirst, we express the complex number $1$ in the form $re^{\\textrm{i}\\theta}$. Notice that\n\n$$\n\\mid 1 \\mid = 1\n$$\n\nand\n\n$$\n\\arg(1) = 0\n$$\n\nHence,\n\n$$\n1 = e^{\\textrm{i}(0 + 2k\\pi)} = e^{2k\\pi \\textrm{i}}\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\nz^{7} = e^{2kπ\\textrm{i}}⟹z = (e^{2kπ\\textrm{i}})^{1/7} = e^{2kπ\\textrm{i}/7}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3400/Source/Images/047d35f0458fccba0e9e329b3fa9f8c2.png)\n\nSo, the required root corresponds to $k=5$. Substituting this into the expression for roots, we obtain the following:\n\n$$\nz_{5} = e^{2(5)π\\textrm{i}/7} = e^{10π\\textrm{i}/7}\n$$"]] "immutable_answers" [17592186169082 17592186169083 17592186169084 17592186169085 17592186169086 17592186169631 17592186169632 17592186169633 17592186169634 17592186169635 17592186169637 17592186169638 17592186169639 17592186169640 17592186169641 17592186171512 17592186171513 17592186171514 17592186171515 17592186171516] "immutable_fields" [[17592186169081 :answer-field/correct] [17592186169081 :answer-field/id] [17592186169081 :answer-field/key] [17592186169081 :answer-field/type] [17592186169630 :answer-field/correct] [17592186169630 :answer-field/id] [17592186169630 :answer-field/key] [17592186169630 :answer-field/type] [17592186169636 :answer-field/correct] [17592186169636 :answer-field/id] [17592186169636 :answer-field/key] [17592186169636 :answer-field/type] [17592186171511 :answer-field