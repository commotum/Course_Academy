#{[{:db/id #edb/ref 17592186268627 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88bf71ee-fa81-5d22-b5f5-5a74fc2002ce" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268629} {:answer/id #uuid "3165f570-6cc4-5df4-b814-ccbc73d86ca7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186268630} {:answer/id #uuid "7117a876-7d2f-5165-a1cb-f2fb0d7d0b86" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268631} {:answer/id #uuid "64c0beba-87d2-58ef-bcc6-48efe382a7d9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268632} {:answer/id #uuid "8e626747-c129-5f3d-8e6f-4b95888355b2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268633}] :answer-field/correct {:answer/id #uuid "3165f570-6cc4-5df4-b814-ccbc73d86ca7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186268630} :answer-field/id #uuid "e5bb8337-3519-5fbe-9773-99d89970b63f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268628}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c4a36bb7-8dd8-5b88-bc75-29338c78ab00" :question/math-academy-id "q-134155" :question/problem "Consider the following data sets:\n\n$$\nx={4,\\,6,\\,8,\\,2},\\,y={2,\\,4,\\,10,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=5$ and $\\overset{―}{y}=6.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-5)(2-6)+(6-5)(4-6)+(8-5)(10-6)+(2-5)(8-6)] \\\\  & =\\frac{1}{4}[(-1)(-4)+(1)(-2)+(3)(4)+(-3)(2)] \\\\  & =\\frac{1}{4}[4-2+12-6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268634 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c266e4d-623b-5d7a-a532-bad180accf60" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268636} {:answer/id #uuid "2e60c538-e065-596f-b881-fef12275f200" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186268637} {:answer/id #uuid "c12559eb-573e-538b-95e8-7948944a67ab" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186268638} {:answer/id #uuid "485d43eb-672d-55f8-990b-f5916550522c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268639} {:answer/id #uuid "86028bed-82e4-5aed-9495-8c81ce366cda" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268640}] :answer-field/correct {:answer/id #uuid "86028bed-82e4-5aed-9495-8c81ce366cda" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268640} :answer-field/id #uuid "e9733944-17fd-59a6-8532-24aff31f0818" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268635}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4239a85d-3d2e-5612-a6fe-f58ad75138ff" :question/math-academy-id "q-134158" :question/problem "Consider the following data sets:\n\n$$\nx={2,\\,4,\\,6,\\,8},\\,y={1,\\,3,\\,5,\\,7}\n$$\n\nYou're given that $\\overset{―}{x}=5$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(2-5)(1-4)+(4-5)(3-4)+(6-5)(5-4)+(8-5)(7-4)] \\\\  & =\\frac{1}{4}[(-3)(-3)+(-1)(-1)+(1)(1)+(3)(3)] \\\\  & =\\frac{1}{4}[9+1+1+9] \\\\  & =\\frac{1}{4}\\cdot 20 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268641 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d690db8-3151-576e-8dfd-1333865a52f9" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268643} {:answer/id #uuid "70f40698-3d94-53c6-8a78-8ce906670f4e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186268644} {:answer/id #uuid "cfc3105a-0e57-52b5-b02a-e438d4084d6a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268645} {:answer/id #uuid "58fa9a4c-bd0d-5446-b2c8-7e5fc08f236a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268646} {:answer/id #uuid "4b960f66-acd1-5257-9af4-d24713c657c9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268647}] :answer-field/correct {:answer/id #uuid "70f40698-3d94-53c6-8a78-8ce906670f4e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186268644} :answer-field/id #uuid "a3253c9f-6b76-58fd-82f7-f598bc4d1dd7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268642}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a549867e-cfee-526b-8ddf-c9292b16b1ff" :question/math-academy-id "q-134170" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={4,\\,-2,\\,5,\\,1},\\,y={-7,\\,5,\\,4,\\,-2}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+(-2)+5+1) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-7)+5+4+(-2)) \\\\  & =\\frac{1}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268648 :knowledge-point/_questions [{:knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4aa5b26-9359-5b97-a92f-aaacb1ba6d88" :answer/type {:db/ident :answer.type/math} :answer/value "79" :db/id #edb/ref 17592186268650} {:answer/id #uuid "151f3716-4785-5945-82bc-dc846c9abf15" :answer/type {:db/ident :answer.type/math} :answer/value "73.5" :db/id #edb/ref 17592186268651} {:answer/id #uuid "b3edfaf6-28ff-53a8-af5f-d20bf3296c08" :answer/type {:db/ident :answer.type/math} :answer/value "78.5" :db/id #edb/ref 17592186268652} {:answer/id #uuid "9671a4ef-61e4-5e56-ad98-0efe2528b1e1" :answer/type {:db/ident :answer.type/math} :answer/value "77" :db/id #edb/ref 17592186268653} {:answer/id #uuid "ff5b7046-2ce4-580e-9d71-bcb651b42de5" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186268654}] :answer-field/correct {:answer/id #uuid "ff5b7046-2ce4-580e-9d71-bcb651b42de5" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186268654} :answer-field/id #uuid "1efa9c86-ac9a-558a-8d98-e3662be4e407" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268649}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b7d4a451-fcf2-5345-84ad-1c73c182082f" :question/math-academy-id "q-134207" :question/problem "| **Temperature,\nin  ${}^{∘}F\\,(x)$** | $60$ | $42$ | $80$ | $70$ |\n| --- | --- | --- | --- | --- |\n| **Humidity, in $%\\,(y)$** | $42$ | $24$ | $30$ | $60$ |\n\nThe table above shows data Tom collected about temperature and humidity in his city. \nCompute the covariance of the data sets given that the means are $\\overset{―}{x}=63$ and $\\overset{―}{y}=39.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(60\\,-\\,63)(42\\,-\\,39)+(42\\,-\\,63)(24\\,-\\,39)+(80\\,-\\,63)(30\\,-\\,39)+(70\\,-\\,63)(60\\,-\\,39)] \\\\  & =\\frac{1}{4}[(-3)(3)+(-21)(-15)+(17)(-9)+(7)(21)] \\\\  & =\\frac{1}{4}[-9+315-153+147] \\\\  & =\\frac{1}{4}\\cdot 300 \\\\  & =75.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268655 :knowledge-point/_questions [{:knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eebbef24-2fc7-5a85-9e73-bcaa4229890b" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268657} {:answer/id #uuid "b5d45b37-5be3-5a47-bbb2-7385fd9fa146" :answer/type {:db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186268658} {:answer/id #uuid "d6f44a9e-e04d-506d-a1ca-6be80653c601" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186268659} {:answer/id #uuid "978b809b-671d-5121-9640-90c165a68714" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268660} {:answer/id #uuid "d576dc7b-91db-5d2a-b58e-02bc93f99535" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268661}] :answer-field/correct {:answer/id #uuid "978b809b-671d-5121-9640-90c165a68714" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186268660} :answer-field/id #uuid "fa1304af-bf61-56ef-94df-43fa68746da6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268656}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "48151943-ed05-5584-881f-ba1cbfe16174" :question/math-academy-id "q-149572" :question/problem "| **Age, in years ($x$)** | $14$ | $16$ | $16$ | $18$ |\n| --- | --- | --- | --- | --- |\n| **Weight, in kg ($y$)** | $62$ | $63$ | $73$ | $78$ |\n\nThe table above shows the ages and corresponding weights of four members of a youth rock band. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=16$ and $\\overset{―}{y}=69.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(14-16)(62-69)+(16-16)(63-69)+(16-16)(73-69)+(18-16)(78-69)] \\\\  & =\\frac{1}{4}[(-2)(-7)+(0)(-6)+(0)(4)+(2)(9)] \\\\  & =\\frac{1}{4}[14+0+0+18] \\\\  & =\\frac{1}{4}\\cdot 32 \\\\  & =8.\\end{aligned}\n$$"}]}
