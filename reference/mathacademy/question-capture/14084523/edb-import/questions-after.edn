#{[{:db/id #edb/ref 17592186388390 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4600677b-34c1-5f95-a708-a7204e687a4b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186388392} {:answer/id #uuid "d7190931-4c0e-590a-a2ba-f077e43acacc" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186388393} {:answer/id #uuid "ff8e2536-bf19-5b70-9fbe-a56664072aa1" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186388394} {:answer/id #uuid "22baa6e7-6d0e-57f1-85a4-1e707b59f29b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186388395} {:answer/id #uuid "55eeaa67-d862-5f32-9f01-bbce2dbf41ef" :answer/type {:db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186388396}] :answer-field/correct {:answer/id #uuid "d7190931-4c0e-590a-a2ba-f077e43acacc" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186388393} :answer-field/id #uuid "430f4241-c4bb-5bd2-8be8-c059ab8ee3a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388391}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8f982d65-21d3-5ca8-afbe-be436c69b22a" :question/math-academy-id "q-129217" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{45}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}1 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -2 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 5 \\\\ 0 & 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}-5 & 0 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}0 & 2 & 0 & -1 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id #edb/ref 17592186388397 :knowledge-point/_questions [{:knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1381dee6-8e88-5e89-ada4-4145e933a531" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186388399} {:answer/id #uuid "e7039c8f-65e4-58d6-b3ea-5c6981c1f2e3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186388400} {:answer/id #uuid "21c4b37e-1d26-5481-a336-479731ea1aa2" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186388401} {:answer/id #uuid "8f8cc0ef-7151-50e6-ad16-8cddd843d2f4" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186388402} {:answer/id #uuid "774ff914-9194-5931-b811-dbae33dc2071" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186388403}] :answer-field/correct {:answer/id #uuid "e7039c8f-65e4-58d6-b3ea-5c6981c1f2e3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186388400} :answer-field/id #uuid "008b7ec1-052a-5115-8999-34407150f2d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388398}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "33776114-3c7b-5ab2-b309-52b0995d6a3c" :question/math-academy-id "q-129233" :question/problem "Which of the following augmented matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 & -3 \\\\ 0 & 5 & 0 & 9 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}],\\,B=[\\begin{aligned}9 & 0 & 6 \\\\ 0 & 2 & 5 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 3 & 6 \\\\ 0 & 2 & 0 & 1 \\\\ 0 & 0 & 3 & 4\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 & -3 \\\\ 0 & 5 & 0 & 9 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}9 & 0 & 6 \\\\ 0 & 2 & 5 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}1 & 0 & 3 & 6 \\\\ 0 & 2 & 0 & 1 \\\\ 0 & 0 & 3 & 4\\end{aligned}]\n$$\n\nTherefore, only $A$ is **not** in row echelon form."}] [{:db/id #edb/ref 17592186388404 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe0050b2-b5bc-54a6-aeaf-94cd5d7e5dfb" :knowledge-point/title "Identifying Operations That Would Transform a Matrix To Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a317c3-0343-5d97-965e-c80f19229a9b" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ and ${a}_{32}$ only" :db/id #edb/ref 17592186388406} {:answer/id #uuid "d2a961a1-6b50-52e0-a7c5-3756fd204415" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ only" :db/id #edb/ref 17592186388407} {:answer/id #uuid "5b351496-6413-552f-ae77-dbee4c0615b4" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$, ${a}_{32}$ and ${a}_{43}$ only" :db/id #edb/ref 17592186388408} {:answer/id #uuid "86440c5f-9c94-50a7-8a0a-f4828ab713e3" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$, ${a}_{32}$ and ${a}_{33}$ only" :db/id #edb/ref 17592186388409} {:answer/id #uuid "9a59d31e-4329-5d6b-b35f-be68c669e961" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$, ${a}_{43}$ and ${a}_{44}$ only" :db/id #edb/ref 17592186388410}] :answer-field/correct {:answer/id #uuid "5b351496-6413-552f-ae77-dbee4c0615b4" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$, ${a}_{32}$ and ${a}_{43}$ only" :db/id #edb/ref 17592186388408} :answer-field/id #uuid "6ff9665d-e78f-5c53-b571-7c3c14aad1c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388405}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5e7cfff2-0484-526e-89af-8a738e4fb6fa" :question/math-academy-id "q-129424" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=[\\begin{aligned}9 & 0 & 7 & 2 \\\\ 0 & 7 & -3 & 1 \\\\ -3 & 2 & 5 & -1 \\\\ 0 & 0 & 6 & -4\\end{aligned}]\n$$" :question/worked-solution "Notice that by replacing ${a}_{31}$, ${a}_{32}$ and ${a}_{43}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=[\\begin{aligned}9 & 0 & 7 & 2 \\\\ 0 & 7 & -3 & 1 \\\\ -3 & 2 & 5 & -1 \\\\ 0 & 0 & 6 & -4\\end{aligned}]\\,⟶\\,[\\begin{aligned}9 & 0 & 7 & 2 \\\\ 0 & 7 & -3 & 1 \\\\ 0 & 0 & 5 & -1 \\\\ 0 & 0 & 0 & -4\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form."}] [{:db/id #edb/ref 17592186388411 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e61ef65-ea2f-5b21-9c30-062444e2435f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186388413} {:answer/id #uuid "fe8923a8-e22d-5cc3-b73a-b3b99736bd42" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186388414} {:answer/id #uuid "f0e9fd47-8db3-567e-a983-78eeeaa950c3" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186388415} {:answer/id #uuid "af2d79fc-6465-5497-8866-2c2b0e24db4e" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186388416} {:answer/id #uuid "35018daf-fc31-5309-a6cc-74a379984e7e" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186388417}] :answer-field/correct {:answer/id #uuid "af2d79fc-6465-5497-8866-2c2b0e24db4e" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186388416} :answer-field/id #uuid "5708a00c-efa4-570f-9027-3f8859428126" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388412}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ba6bcd83-87df-5c0b-b121-63a0ff1205ca" :question/math-academy-id "q-72492" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{22}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, only $C$ is **not** in row echelon form."}] [{:db/id #edb/ref 17592186388418 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe0050b2-b5bc-54a6-aeaf-94cd5d7e5dfb" :knowledge-point/title "Identifying Operations That Would Transform a Matrix To Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c8f3259-24a0-5328-860d-fe565dfde679" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{42}$ only" :db/id #edb/ref 17592186388420} {:answer/id #uuid "5747150b-cd08-5342-9516-ae09e8b917d9" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{21}$ and ${a}_{31}$ only" :db/id #edb/ref 17592186388421} {:answer/id #uuid "741a0c93-3eaa-5514-bd19-bfd05ce64234" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ and ${a}_{34}$ only" :db/id #edb/ref 17592186388422} {:answer/id #uuid "6d7f6199-0bcc-5538-aa2b-4de4250eac68" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ and ${a}_{42}$ only" :db/id #edb/ref 17592186388423} {:answer/id #uuid "9443a9e0-448d-5c77-92b1-5d3ca7ab6c1c" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ only" :db/id #edb/ref 17592186388424}] :answer-field/correct {:answer/id #uuid "6d7f6199-0bcc-5538-aa2b-4de4250eac68" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{31}$ and ${a}_{42}$ only" :db/id #edb/ref 17592186388423} :answer-field/id #uuid "907c2cbd-9f04-586c-ba44-efd4dd0d061b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388419}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b8b65e47-769c-541b-a887-dd48d95ded40" :question/math-academy-id "q-73149" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=[\\begin{aligned}-1 & -2 & 0 & 1 \\\\ 0 & 2 & 0 & 1 \\\\ 1 & 0 & 1 & 6 \\\\ 0 & 1 & 0 & 3\\end{aligned}]\n$$" :question/worked-solution "Notice that by replacing ${a}_{31}$ and ${a}_{42}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=[\\begin{aligned}-1 & -2 & 0 & 1 \\\\ 0 & 2 & 0 & 1 \\\\ 1 & 0 & 1 & 6 \\\\ 0 & 1 & 0 & 3\\end{aligned}]\\,⟶\\,[\\begin{aligned}-1 & -2 & 0 & 1 \\\\ 0 & 2 & 0 & 1 \\\\ 0 & 0 & 1 & 6 \\\\ 0 & 0 & 0 & 3\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form."}]}
