#{[{:db/id #edb/ref 17592186355926 :knowledge-point/_questions [{:knowledge-point/id #uuid "a83d52a4-6f69-5607-8753-e96c13bd7209" :knowledge-point/title "Rewriting One of the Limits of an Improper Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e12430f-598d-549f-8ba2-333e916f9e4a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to -{2}^{+}}({\\int }_{a}^{1}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355928} {:answer/id #uuid "4ad89191-7c55-5236-bdb4-31b812d7776a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to {2}^{-}}({\\int }_{0}^{a}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355929} {:answer/id #uuid "606001fa-0aa0-58ae-9479-65c06e6d2446" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to \\infty }({\\int }_{0}^{a}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355930} {:answer/id #uuid "9cab00e4-7988-52c9-a06f-8f8443fd8ad5" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to -\\infty }({\\int }_{a}^{2}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355931} {:answer/id #uuid "0a1f1caf-eaba-5bea-9556-c8ff5176789b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to {0}^{+}}({\\int }_{a}^{2}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355932}] :answer-field/correct {:answer/id #uuid "0a1f1caf-eaba-5bea-9556-c8ff5176789b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{a\\to {0}^{+}}({\\int }_{a}^{2}\\frac{\\text{d}x}{x(x+1)}\\,)" :db/id #edb/ref 17592186355932} :answer-field/id #uuid "e62a0892-49f4-5bb1-892b-c8c10c1bb92e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355927}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a079196f-e35a-5154-9109-b1bb1de2534c" :question/math-academy-id "q-141132" :question/problem "Which of the following is equivalent to \n${\\int }_{0}^{2}\\frac{\\text{d}x}{x(x+1)}?$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded as we approach the *lower* integration limit from any point that lies in the interval $x\\in (0,2):$\n\n$$\nf(x)=\\frac{1}{x(x+1)}\\to \\infty \\,\\text{as}\\,x\\to {0}^{+}\n$$\n\nWe can attempt to evaluate this integral by integrating $f(x)$ over the interval $x\\in [a,2]$ and taking the limit as $a\\to {0}^{+}:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{x(x+1)}\\,\\text{d}x & ={lim}_{a\\to {0}^{+}}({\\int }_{a}^{2}\\frac{\\text{d}x}{x(x+1)}\\,)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355933 :knowledge-point/_questions [{:knowledge-point/id #uuid "a83d52a4-6f69-5607-8753-e96c13bd7209" :knowledge-point/title "Rewriting One of the Limits of an Improper Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c212401a-59e2-571c-a0c0-4503dcf60305" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to (-1)^{+}}({\\int }_{b}^{2}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355935} {:answer/id #uuid "e778e667-eb1f-5fa3-a3b5-1cd85b9a0e24" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to {2}^{-}}({\\int }_{-1}^{b}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355936} {:answer/id #uuid "15e6023a-8e0e-5ffa-94b3-f04ad7edf371" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to -\\infty }({\\int }_{b}^{2}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355937} {:answer/id #uuid "6d2c2e20-439d-5ae2-9250-0e2c43f8b615" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to {0}^{-}}({\\int }_{-1}^{b}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355938} {:answer/id #uuid "fc3fafb7-8cc6-5b76-91ad-c3965f7b361d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to \\infty }({\\int }_{-1}^{b}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355939}] :answer-field/correct {:answer/id #uuid "e778e667-eb1f-5fa3-a3b5-1cd85b9a0e24" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{b\\to {2}^{-}}({\\int }_{-1}^{b}\\frac{\\text{d}x}{4-{x}^{2}})" :db/id #edb/ref 17592186355936} :answer-field/id #uuid "da299c2a-74f2-5651-a68b-396f95b9aaa3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355934}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "209a9d09-c02e-5a6e-9a16-3ed75058c4fb" :question/math-academy-id "q-141181" :question/problem "Which of the following is equivalent to \n${\\int }_{-1}^{2}\\frac{\\text{d}x}{4-{x}^{2}}?$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded as we approach the *upper* integration limit from any point that lies in the interval $x\\in (-1,2):$\n\n$$\nf(x)=\\frac{1}{4-{x}^{2}}\\to \\infty \\,\\text{as}\\,x\\to {2}^{-}\n$$\n\nWe can attempt to evaluate this integral by integrating $f(x)$ over the interval $x\\in [-1,b]$ and taking the limit as $b\\to {2}^{-}:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{2}\\frac{\\text{d}x}{4-{x}^{2}} & ={lim}_{b\\to {2}^{-}}({\\int }_{-1}^{b}\\frac{\\text{d}x}{4-{x}^{2}})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355940 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf1d89ed-0d2a-5759-9e6e-354957f7dabc" :knowledge-point/title "Evaluating an Improper Integral of the Second Kind"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1112f33c-47af-5af5-8f01-0d44380dfd0b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186355942}] :answer-field/correct {:answer/id #uuid "1112f33c-47af-5af5-8f01-0d44380dfd0b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186355942} :answer-field/id #uuid "d6d60f24-43b0-54af-ae32-ca1142305e07" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355941}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "25720271-bafc-5b0a-9101-38d54bc0850a" :question/math-academy-id "q-347669" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{2/3}^{22}\\frac{1}{(3x-2)^{1/3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, let's rewrite the integral using a substitution. Let $u=3x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\,\\text{d}u.\n$$\n\nWe use the table below to change the limits:\n\n| $x$ | $\\frac{2}{3}$ | $22$ |\n| --- | --- | --- |\n| $u$ | $0$ | $64$ |\n\nCarrying out the change of variable, we have\n\n$$\n\\begin{aligned}{\\int }_{2/3}^{22}\\frac{1}{(3x-2)^{1/3}}\\,\\text{d}x & ={\\int }_{0}^{64}\\frac{\\text{d}u}{3{u}^{1/3}} \\\\  & =\\frac{1}{3}{\\int }_{0}^{64}\\frac{\\text{d}u}{{u}^{1/3}}.\\end{aligned}\n$$\n\nThis is an improper integral of the second kind because the function under the integral is unbounded at the *lower* limit of integration.\n\n$$\nf(u)=\\frac{1}{{u}^{1/3}}\\to \\infty \\,\\text{ as }\\,u\\to {0}^{+}.\n$$\n\nNonetheless, it is possible to calculate the integral by setting the *lower* bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to {0}^{+}.$\n\n$$\n\\begin{aligned}\\frac{1}{3}{\\int }_{0}^{64}\\frac{\\text{d}u}{{u}^{1/3}} & ={lim}_{a\\to {0}^{+}}\\frac{1}{3}{\\int }_{a}^{64}\\frac{\\text{d}u}{{u}^{1/3}} \\\\  & ={lim}_{a\\to {0}^{+}}\\frac{1}{3}{\\int }_{a}^{64}{u}^{-1/3}\\,\\text{d}u \\\\  & ={lim}_{a\\to {0}^{+}}\\frac{1}{3}\\cdot {\\frac{3}{2}\\,{u}^{2/3}|}_{a}^{64} \\\\  & ={lim}_{a\\to {0}^{+}}\\frac{1}{2}{\\sqrt[3]{{u}^{2}}|}_{a}^{64} \\\\  & ={lim}_{a\\to {0}^{+}}[\\frac{1}{2}\\sqrt[3]{{64}^{2}}-\\frac{1}{2}\\sqrt[3]{{a}^{2}}] \\\\  & =\\frac{1}{2}\\cdot 16-0 \\\\  & =8\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{\\int }_{2/3}^{22}\\frac{1}{(3x-2)^{1/3}}\\,\\text{d}x=8.\n$$"}] [{:db/id #edb/ref 17592186355943 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf1d89ed-0d2a-5759-9e6e-354957f7dabc" :knowledge-point/title "Evaluating an Improper Integral of the Second Kind"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193f6aaf-ba42-541a-97ea-0ba3d460e372" :answer/type {:db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186355945} {:answer/id #uuid "9f44aac1-827b-542f-a228-111cc594a9c9" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186355946} {:answer/id #uuid "eb71d1d9-5bfd-552a-991a-11a9d6f2ce4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186355947} {:answer/id #uuid "8444f3e9-f831-516b-aea8-f931f621c85c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186355948} {:answer/id #uuid "d6bc2e7c-c906-59e9-8784-cd1c56db77d3" :answer/type {:db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186355949}] :answer-field/correct {:answer/id #uuid "9f44aac1-827b-542f-a228-111cc594a9c9" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186355946} :answer-field/id #uuid "5664f359-c8e2-5a74-9ef6-4e7f710eb0c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355944}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0837aad5-e0ac-59a9-9ab7-56c2e1e9492f" :question/math-academy-id "q-49895" :question/problem "${\\int }_{0}^{1}\\frac{6}{\\sqrt[7]{x}}\\,\\text{d}x=$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded at the *lower* limit of integration. \n\n$$\nf(x)=\\frac{6}{\\sqrt[7]{x}}\\to \\infty \\,\\text{as}\\,x\\to {0}^{+}\n$$\n\nNonetheless, it is possible to calculate the integral by setting the *lower* bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to {0}^{+}.$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{\\sqrt[7]{x}}\\,\\text{d}x & ={lim}_{a\\to {0}^{+}}{\\int }_{a}^{1}\\frac{6}{\\sqrt[7]{x}}\\,\\text{d}x \\\\  & ={lim}_{a\\to {0}^{+}}{\\int }_{a}^{1}6{x}^{-1/7}\\,\\text{d}x \\\\  & ={lim}_{a\\to {0}^{+}}7{x}^{6/7}{|}_{a}^{1} \\\\  & ={lim}_{a\\to {0}^{+}}7\\sqrt[7]{{x}^{6}}{|}_{a}^{1} \\\\  & ={lim}_{a\\to {0}^{+}}[7\\cdot \\sqrt[7]{{1}^{6}}-7\\cdot \\sqrt[7]{{a}^{6}}] \\\\  & =7(1)-7(0) \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083852 :knowledge-point/_questions [{:knowledge-point/id #uuid "a83d52a4-6f69-5607-8753-e96c13bd7209" :knowledge-point/title "Rewriting One of the Limits of an Improper Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e384ad58-786e-5239-b520-36d9b5925cdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to (-6)^{+}}(\\int_{b}^{-3}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082479} {:answer/id #uuid "f92f81e4-85a1-59e6-88ea-c64b672efe72" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to \\infty}(\\int_{-6}^{b}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082480} {:answer/id #uuid "01da9d7a-ccc2-56e9-a643-34f94689a781" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to - \\infty}(\\int_{b}^{-3}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082481} {:answer/id #uuid "194f7a3a-9634-5621-93e5-c959f8b956c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to 3^{-}}(\\int_{-6}^{b}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082482} {:answer/id #uuid "568ec822-bdc1-55e6-ad31-aa9571b18c87" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to (-3)^{-}}(\\int_{-6}^{b}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082483}] :answer-field/correct {:answer/id #uuid "568ec822-bdc1-55e6-ad31-aa9571b18c87" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{b \\to (-3)^{-}}(\\int_{-6}^{b}\\frac{1}{\\sqrt{x^{2} - 9}}dx)" :db/id #edb/ref 17592186082483} :answer-field/id #uuid "f22f78f7-5c85-5f5b-8a7e-3a9ff4e67d8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082478}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d29116a1-5886-5193-a3da-549480287a4b" :question/math-academy-id "q-82704" :question/problem "Which of the following is equivalent to \n${\\int }_{-6}^{-3}\\frac{\\text{d}x}{\\sqrt{{x}^{2}-9}}?$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded as we approach the *upper* integration limit from any point that lies in the interval $x\\in (-6,-3):$\n\n$$\nf(x)=\\frac{1}{\\sqrt{{x}^{2}-9}}\\to \\infty \\,\\text{as}\\,x\\to (-3)^{-}\n$$\n\nWe can attempt to evaluate this integral by integrating $f(x)$ over the interval $x\\in [-6,b]$ and taking the limit as $b\\to (-3)^{-}:$\n\n$$\n\\begin{aligned}{\\int }_{-6}^{-3}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x & ={lim}_{b\\to (-3)^{-}}({\\int }_{-6}^{b}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)\\end{aligned}\n$$"}]}
