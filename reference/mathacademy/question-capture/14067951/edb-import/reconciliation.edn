gned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067951/state.json" "file_sha256" "84ae52e7a07df296b61c2fdb4097fe3c07b607c9cb28b3db06216439cdc10e33"} {"question" "q-82704" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067951/activity-metadata.json" "file_sha256" "9ea38ea54540e2604c350ac4bfd17b8d0f73d36a19c93ad772f2e6ecf27dc465"} {"question" "q-82704" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067951/state.json" "file_sha256" "84ae52e7a07df296b61c2fdb4097fe3c07b607c9cb28b3db06216439cdc10e33"} {"question" "q-82704" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{lim}_{b\\to (-3)^{-}}({\\int }_{-6}^{b}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"] ["math" "{lim}_{b\\to (-6)^{+}}({\\int }_{b}^{-3}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"] ["math" "{lim}_{b\\to -\\infty }({\\int }_{b}^{-3}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"] ["math" "{lim}_{b\\to \\infty }({\\int }_{-6}^{b}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"] ["math" "{lim}_{b\\to {3}^{-}}({\\int }_{-6}^{b}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067951/state.json" "file_sha256" "84ae52e7a07df296b61c2fdb4097fe3c07b607c9cb28b3db06216439cdc10e33"} {"question" "q-82704" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{lim}_{b\\to (-3)^{-}}({\\int }_{-6}^{b}\\frac{1}{\\sqrt{{x}^{2}-9}}\\,\\text{d}x)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067951/state.json" "file_sha256" "84ae52e7a07df296