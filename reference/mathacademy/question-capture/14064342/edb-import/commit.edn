\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\text{arcsec}\\,u+C \\\\  & =\\text{arcsec}(x+2)+C.\\end{aligned}\n$$" 13194139535419 true] [17592186348316 1000 #edb/ref 17592186348317 13194139535419 true] [17592186348316 1000 #edb/ref 17592186348318 13194139535419 true] [17592186348316 1000 #edb/ref 17592186348319 13194139535419 true] [17592186348316 1000 #edb/ref 17592186348320 13194139535419 true] [17592186348316 1000 #edb/ref 17592186348321 13194139535419 true] [17592186348316 1040 #edb/ref 17592186045450 13194139535419 true] [17592186348316 1041 "selection" 13194139535419 true] [17592186348316 1104 #edb/ref 17592186348317 13194139535419 true] [17592186348316 1110 #uuid "d2a3b181-ecac-5f9e-830e-fbde4956fc1b" 13194139535419 true] [17592186348317 1034 "\\text{arcsec}(x+2)+C" 13194139535419 true] [17592186348317 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348317 1111 #uuid "a5ea4255-4890-53fa-8093-78c3d5c90e20" 13194139535419 true] [17592186348318 1034 "2\\,\\text{arcsec}(\\frac{x-2}{2})+C" 13194139535419 true] [17592186348318 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348318 1111 #uuid "303e3a0c-27e8-5798-84d6-ec42d1c1dbd0" 13194139535419 true] [17592186348319 1034 "\\frac{1}{2}\\,\\text{arcsec}(2(x+2))+C" 13194139535419 true] [17592186348319 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348319 1111 #uuid "69459a5a-78bd-5a75-a710-151ba7bc7369" 13194139535419 true] [17592186348320 1034 "2\\,\\text{arcsec}(\\frac{x+2}{2})+C" 13194139535419 true] [17592186348320 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348320 1111 #uuid "5da2310b-5147-55e0-9fce-869491551d87" 13194139535419 true] [17592186348321 1034 "\\text{arcsec}(x-2)+C" 13194139535419 true] [17592186348321 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348321 1111 #uuid "ea6c089c-5a2d-5f98-b34a-4994f73412e7" 13194139535419 true] [17592186348322 1017 #edb/ref 17592186348323 13194139535419 true] [17592186348322 1089 "q-348528" 13194139535419 true] [17592186348322 1091 #edb/ref 17592186045465 13194139535419 true] [17592186348322 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x=$\n{{field-1}}" 13194139535419 true] [17592186348322 1113 #uuid "318a8320-1013-5c6f-87d1-585357c4540e" 13194139535419 true] [17592186348322 1145 "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned}{x}^{2}+6x+8 & ={x}^{2}+2\\cdot 3x+({3}^{2}-{3}^{2})+8 \\\\  & =({x}^{2}+2\\cdot 3x+{3}^{2})-9+8 \\\\  & =(x+3)^{2}-1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n{\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x=6{\\int }_{\\sqrt{2}-3}^{-1}\\frac{1}{|x+3|\\sqrt{(x+3)^{2}-1}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\text{arcsec}\\,u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+3).$\n\nSo, let's perform the substitution\n\n$$\nu=x+3.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $\\sqrt{2}-3$ | $-1$ |\n| --- | --- | --- |\n| $u$ | $\\sqrt{2}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{2}-3}^{-1}\\frac{6}{|x+3|\\sqrt{{x}^{2}+6x+8}}\\,\\text{d}x & =6{\\int }_{\\sqrt{2}}^{2}\\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =6\\,\\text{arcsec}\\,u\\,{|}_{\\sqrt{2}}^{2} \\\\  & =6(\\text{arcsec}(2)-\\text{arcsec}(\\sqrt{2})) \\\\  & =6(\\frac{\\pi }{3}-\\frac{\\pi }{4}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$" 13194139535419 true] [17592186348323 1000 #edb/ref 17592186348324 13194139535419 true] [17592186348323 1000 #edb/ref 17592186348325 13194139535419 true] [17592186348323 1040 #edb/ref 17592186045449 13194139535419 true] [17592186348323 1041 "field-1" 13194139535419 true] [17592186348323 1104 #edb/ref 17592186348325 13194139535419 true] [17592186348323 1110 #uuid "fb331360-19da-55a4-acd4-d5e2c70f1b7a" 13194139535419 true] [17592186348324 1034 "\\pi" 13194139535419 true] [17592186348324 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348324 1111 #uuid "b4e64174-5c3a-5877-a1d8-12099e9e6e96" 13194139535419 true] [17592186348325 1034 "\\frac{\\pi}{2}" 13194139535419 true] [17592186348325 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348325 1111 #uuid "18f57394-9cc8-5d07-93b8-8daa12845952" 13194139535419 true] [17592186348326 1017 #edb/ref 17592186348327 13194139535419 true] [17592186348326 1089 "q-348555" 13194139535419 true] [17592186348326 1091 #edb/ref 17592186045465 13194139535419 true] [17592186348326 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-4}^{-3}\\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x=$\n{{field-1}}" 13194139535419 true] [17592186348326 1113 #uuid "45bc44ce-a438-5f0a-9306-145d75ddb29f" 13194139535419 true] [17592186348326 1145 "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+8x+17 & ={x}^{2}+2\\cdot 4x+({4}^{2}-{4}^{2})+17 \\\\  & =({x}^{2}+2\\cdot 4x+{4}^{2})-16+17 \\\\  & =(x+4)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x & =\\int \\frac{6}{(x+4)^{2}+1}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{1+(x+4)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-4$ | $-3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-3}\\frac{6}{{x}^{2}+8x+17}\\,\\text{d}x & =6{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =6\\operatorname{arctan}⁡u\\,{|}_{0}^{1} \\\\  & =6(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =6(\\frac{\\pi }{4}-0) \\\\  & =\\frac{3\\pi }{2}\\end{aligned}\n$$" 13194139535419 true] [17592186348327 1000 #edb/ref 17592186348328 13194139535419 true] [17592186348327 1040 #edb/ref 17592186045449 13194139535419 true] [17592186348327 1041 "field-1" 13194139535419 true] [17592186348327 1104 #edb/ref 17592186348328 13194139535419 true] [17592186348327 1110 #uuid "85050299-9eba-534f-9d3b-a1b37edc9626" 13194139535419 true] [17592186348328 1034 "\\frac{3\\pi}{2}" 13194139535419 true] [17592186348328 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348328 1111 #uuid "716ae010-e0f1-5a5d-8b29-57097da9c2cf" 13194139535419 true] [17592186348329 1017 #edb/ref 17592186348330 13194139535419 true] [17592186348329 1089 "q-348571" 13194139535419 true] [17592186348329 1091 #edb/ref 17592186045465 13194139535419 true] [17592186348329 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{5+\\sqrt{3}}\\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x=$\n{{field-1}}" 13194139535419 true] [17592186348329 1113 #uuid "41d50ccc-6fda-5b39-8eea-3178955d6238" 13194139535419 true] [17592186348329 1145 "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-10x+26 & ={x}^{2}-2\\cdot 5x+({5}^{2}-{5}^{2})+26 \\\\  & =({x}^{2}-2\\cdot 5x+{5}^{2})-25+26 \\\\  & =(x-5)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x & =\\int \\frac{7}{(x-5)^{2}+1}\\,\\text{d}x \\\\  & =7\\int \\frac{1}{1+(x-5)^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x-5).$\n\nSo, let's perform the substitution\n\n$$\nu=x-5.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nLet's use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $5$ | $5+\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\sqrt{3}$ |\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{5}^{5+\\sqrt{3}}\\frac{7}{{x}^{2}-10x+26}\\,\\text{d}x & =7{\\int }_{0}^{\\sqrt{3}}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =7\\operatorname{arctan}⁡u\\,{|}_{0}^{\\sqrt{3}} \\\\  & =7(\\operatorname{arctan}⁡\\sqrt{3}-\\operatorname{arctan}⁡(0)) \\\\  & =7(\\frac{\\pi }{3}-0) \\\\  & =\\frac{7\\pi }{3}\\end{aligned}\n$$" 13194139535419 true] [17592186348330 1000 #edb/ref 17592186348331 13194139535419 true] [17592186348330 1040 #edb/ref 17592186045449 13194139535419 true] [17592186348330 1041 "field-1" 13194139535419 true] [17592186348330 1104 #edb/ref 17592186348331 13194139535419 true] [17592186348330 1110 #uuid "cefbaf5e-2df5-5659-8c31-ce88cbd9f39b" 13194139535419 true] [17592186348331 1034 "\\frac{7\\pi}{3}" 13194139535419 true] [17592186348331 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348331 1111 #uuid "a12ea5c9-2503-591d-b3a3-530a28b3ca34" 13194139535419 true] [17592186348332 1017 #edb/ref 17592186348333 13194139535419 true] [17592186348332 1089 "q-3594" 13194139535419 true] [17592186348332 1091 #edb/ref 17592186045463 13194139535419 true] [17592186348332 1100 "$\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x=$" 13194139535419 true] [17592186348332 1113 #uuid "e3fdf05c-295a-5e89-9088-f77e5fcdcab8" 13194139535419 true] [17592186348332 1145 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-8x-15 & =-({x}^{2}+8x+15) \\\\  & =-({x}^{2}+2\\cdot 4x+[{4}^{2}-{4}^{2}]+15) \\\\  & =-((x+4)^{2}-1) \\\\  & =1-(x+4)^{2}\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x=\\int \\frac{1}{\\sqrt{1-(x+4)^{2}}}\\,\\text{d}x.\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(x+4).$\n\nSo, let's perform the substitution\n\n$$\nu=x+4.\n$$\n\nDifferentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{-{x}^{2}-8x-15}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(x+4)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(x+4)+C.\\end{aligned}\\end{aligned}\n$$" 13194139535419 true] [17592186348333 1000 #edb/ref 17592186348334 13194139535419 true] [17592186348333 1000 #edb/ref 17592186348335 13194139535419 true] [17592186348333 1000 #edb/ref 17592186348336 13194139535419 true] [17592186348333 1000 #edb/ref 17592186348337 13194139535419 true] [17592186348333 1000 #edb/ref 17592186348338 13194139535419 true] [17592186348333 1040 #edb/ref 17592186045450 13194139535419 true] [17592186348333 1041 "selection" 13194139535419 true] [17592186348333 1104 #edb/ref 17592186348337 13194139535419 true] [17592186348333 1110 #uuid "470baffa-4a10-5421-986b-935a9babb4df" 13194139535419 true] [17592186348334 1034 "\\operatorname{arctan}⁡(x+4)+C" 13194139535419 true] [17592186348334 1103 #edb/ref 17592186045453 13194139535419 true] [17592186348334 1111 #uuid "f3069168-8472-5f18-8c58-88afe4d3a8c4" 13194139535419 true] [17592186348335 1034 "\\operatorname{arcsin}⁡(x-4)+C" 13194139535419 true] [17592186348335 1103 #edb/ref 17592186045453 13194139535419 true] [175921863