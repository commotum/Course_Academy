d{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $BA$, we get\n\n$$\n\\begin{aligned}BA & =[\\begin{aligned}-1 & 3 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true. As a result, $B={A}^{-1}$ and statement III is true.\n\n- Now, we check whether $AC=CA={I}_{2}.$ Computing $AC$, we get\n\n$$\n\\begin{aligned}AC & =[\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-1 & 2 \\\\ 1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & -5 \\\\ ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false.\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102674/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b9ef325-2358-5041-8a8d-b459e8ed9f09"] :knowledge-point/questions ["q-102674"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-11640"] :question/problem "Consider the matrices\n\n$$\nB=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}],\\,D=[\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $BC=CB={I}_{2}$\n- $BD=DB={I}_{2}$\n- $D={B}^{-1}$" :question/worked-solution "- First, we check whether $BC=CB={I}_{2}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & 4 \\\\ ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false.\n\n- Now, we check whether $BD=DB={I}_{2}.$ Computing $BD$, we get\n\n$$\n\\begin{aligned}BD & =[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $DB$, we get\n\n$$\n\\begin{aligned}DB & =[\\begin{aligned}-1 & 2 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $D={B}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-71879/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "b87195e1-1ac4-5663-9eed-3706eec3117c" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-71879/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "4798ce7b-1b8e-5e91-8b32-5da27d057e67" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-71879/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "00719820-a4d8-562c-b7a0-8ee76b20e2ae" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-71879/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "24785fe5-a710-5f5d-b203-260a385361e1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-71879/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "6f75eb35-a7bc-56ac-bc39-46ff9e9a8d9e" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-71879/selection" :answer-field/id #uuid "c60ccd95-eb9f-5cdc-a1d2-895f456b306b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71879/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6