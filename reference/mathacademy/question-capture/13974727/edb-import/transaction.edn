B & =[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71879/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2"] :knowledge-point/questions ["q-71879"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149818/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d46b60ad-2fec-5ffb-b008-2f4b9211d62e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-149818/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "780446e4-705b-5c07-93e0-55d616c25735" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-149818/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "d11b9bc1-7785-51c2-b194-5e7f2612c2b9" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-149818/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "8e82d5ab-4193-51a7-8823-ff4b15fa6f12" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-149818/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "993d4cf2-278c-514c-a5c6-dd2913cbfbfc" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-149818/selection" :answer-field/id #uuid "9e18ac0c-1cb3-5037-9915-e93fc7bf874f" :answer-field/key "selection" :answer-field/type :answe