#{[{:db/id #edb/ref 17592186286102 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "911977f9-4dd7-5952-a7d2-5e7840939b58" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186286104} {:answer/id #uuid "ffb95726-da34-5373-afcd-2fe81b267f91" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286105} {:answer/id #uuid "f7d4bc3d-a55e-5bbb-8cf3-be60cc08dce4" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286106} {:answer/id #uuid "7a7d6c0b-89d4-58f6-b838-87a105cabcb9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286107} {:answer/id #uuid "1595331b-914e-55d1-ad79-8a6281f2e79b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286108}] :answer-field/correct {:answer/id #uuid "911977f9-4dd7-5952-a7d2-5e7840939b58" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186286104} :answer-field/id #uuid "7765a4c1-9acf-5c4a-b959-40fe56dae2b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286103}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "18446b37-20cc-5e44-a427-24676c932277" :question/math-academy-id "q-12124" :question/problem "A triangle $S$ has vertices at  $(-2,-1),(1,3),(2,-3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(-3,1)$\n- $(-3,2)$\n- $(1,-2)$" :question/worked-solution "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 3 \\\\ -2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,-2),(-3,1),(3,2).$\n\nSo, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186286109 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c787d6-689a-5822-8a86-85ec0b629d8d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/90dcf60e19c9031927df68a1d0be6b85c47910e6ec92e9052c292f667971d7f1.png" :db/id #edb/ref 17592186286111} {:answer/id #uuid "e1439b53-eca2-5bbf-b769-42c54ff2d285" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/id #edb/ref 17592186286112} {:answer/id #uuid "0f707bbe-3259-5697-89af-24c9ef4e1be0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186286113} {:answer/id #uuid "d6c1d14d-be0f-5784-904b-646847e99b1d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/9dc6d9d844c382cc5a8499929dfe7d3a9ab8bf59fc5b73b2cd4dab44c51e135f.png" :db/id #edb/ref 17592186286114} {:answer/id #uuid "69d2f542-abdb-5ecf-8d1d-a682af96b739" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/c612d528e8fb432e4f63fdaae2649a4a41b0f3bed7751df5b5cc22074b57bb53.png" :db/id #edb/ref 17592186286115}] :answer-field/correct {:answer/id #uuid "d6c1d14d-be0f-5784-904b-646847e99b1d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/9dc6d9d844c382cc5a8499929dfe7d3a9ab8bf59fc5b73b2cd4dab44c51e135f.png" :db/id #edb/ref 17592186286114} :answer-field/id #uuid "566ece9b-df45-52fe-953c-549c09e7bf67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286110}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cec76be9-565e-5e8f-a9d4-8ee2ab561594" :question/math-academy-id "q-160624" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/c32886c161e347daa9bf6fa7215f8a09abc4334632c33020c31ade6dfc4e7315.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ed1a5e8a05ee0d9994d8ba90c02463fbf96525b1cd851bec685a005a34834f81.png)"}] [{:db/id #edb/ref 17592186286116 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af7361f-b172-571c-9a0c-eb8a5cf0e944" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186286118} {:answer/id #uuid "8e9f4a6f-c98a-5b8b-b475-dbb8ce8b7ea9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286119} {:answer/id #uuid "4771e21e-cd38-5610-8e3e-29db3d43a63e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286120} {:answer/id #uuid "3a35e855-f108-53bc-8651-fb1e28f858b5" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286121} {:answer/id #uuid "5034ad09-915d-54bc-a17c-b4c71cbdf70f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186286122}] :answer-field/correct {:answer/id #uuid "8e9f4a6f-c98a-5b8b-b475-dbb8ce8b7ea9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286119} :answer-field/id #uuid "bf293de0-0223-54aa-bbaa-23e0de8be281" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286117}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5ca0ac68-14b1-589e-965f-d2a01a29fa17" :question/math-academy-id "q-160647" :question/problem "A triangle $S$ has vertices at  $(5,-1),(2,0),(-2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians about the origin?\n\n- $(-1,-5)$\n- $(0,2)$\n- $(-1,-2)$" :question/worked-solution "The clockwise rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians is the same as counterclockwise rotation by an angle of $\\frac{3\\pi }{2}.$ It's given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 & -1 \\\\ -5 & -2 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-1,-5),(0,-2),(-1,2).$\n\nSo, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186286123 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id 