/assets/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ab6a3ec35954243105f9bb6c9f1f2cc21c02358f90855f9f36f0a590092eb93d.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81831/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-81831"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160624/selection/bfbabbca65f3869d13603beb0500b0292ce00ef1a54e8518b16b8403a34c7e3a" :answer/id #uuid "d6c1d14d-be0f-5784-904b-646847e99b1d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/9dc6d9d844c382cc5a8499929dfe7d3a9ab8bf59fc5b73b2cd4dab44c51e135f.png" :db/ensure [:answer/validate]} {:db/id "q-160624/selection/9d47b8639587fcfe5ad2ed0c7b224a570b91ebaa15f7ba5d8ebd3de1542fa92e" :answer/id #uuid "e1439b53-eca2-5bbf-b769-42c54ff2d285" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/ensure [:answer/validate]} {:db/id "q-160624/selection/466d37229a47560992a7612c667f314a6f89e0573a3cf26f2ce2a2058daf50ae" :answer/id #uuid "06c787d6-689a-5822-8a86-85ec0b629d8d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/90dcf60e19c9031927df68a1d0be6b85c47910e6ec92e9052c292f667971d7f1.png" :db/ensure [:answer/validate]} {:db/id "q-160624/selection/ea5fedad1e19207b099b9719450f4818a6ae341953cba80777f8bee62a67290f" :answer/id #uuid "69d2f542-abdb-5ecf-8d1d-a682af96b739" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/c612d528e8fb432e4f63fdaae2649a4a41b0f3bed7751df5b5cc22074b57bb53.png" :db/ensure [:answer/validate]} {:db/id "q-160624/selection/aae113b2a3192c5bfba9e1a2d26b8118969a8ef2794a79e08a25632a7bff0c70" :answer/id #uuid "0f707bbe-3259-5697-89af-24c9ef4e1be0" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/ensure [:answer/validate]} {:db/id "q-160624/selection" :answer-field/id #uuid "566ece9b-df45-52fe-953c-549c09e7bf67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160624/selection/bfbabbca65f3869d13603beb0500b0292ce00ef1a54e8518b16b8403a34c7e3a" :answer-field/choices ["q-160624/selection/bfbabbca65f3869d13603beb0500b0292ce00ef1a54e8518b16b8403a34c7e3a" "q-160624/selection/9d47b8639587fcfe5ad2ed0c7b224a570b91ebaa15f7ba5d8ebd3de1542fa92e" "q-160624/selection/466d37229a47560992a7612c667f314a6f89e0573a3cf26f2ce2a2058daf50ae" "q-160624/selection/ea5fedad1e19207b099b9719450f4818a6ae341953cba80777f8bee62a67290f" "q-160624/selection/aae113b2a3192c5bfba9e1a2d26b8118969a8ef2794a79e08a25632a7bff0c70"] :db/ensure [:answer-field/validate]} {:db/id "q-160624" :question/id #uuid "cec76be9-565e-5e8f-a9d4-8ee2ab561594" :question/math-academy-id "q-160624" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/c32886c161e347daa9bf6fa7215f8a09abc4334632c33020c31ade6dfc4e7315.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ed1a5e8a05ee0d9994d8ba90c02463fbf96525b1cd851bec685a005a34834f81.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-160624/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-160624"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160647/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "3a35e855-f108-53bc-8651-fb1e28f858b5" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-160647/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "5034ad09-915d-54bc-a17c-b4c71cbdf70f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-160647/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "8e9f4a6f-c98a-5b8b-b475-dbb8ce8b7ea9" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-160647/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "4771e21e-cd38-5610-8e3e-29db3d43a63e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160647/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "9af7361f-b172-571c-9a0c-eb8a5cf0e944" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160647/selection" :answer-field/id #uuid "bf293de0-0223-54aa-bbaa-23e0de8be281" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160647/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-160647/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-160647/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-160647/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-160647/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-160647/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-160647" :question/id #uuid "5ca0ac68-14b1-589e-965f-d2a01a29fa17" :question/math-academy-id "q-160647" :question/problem "A triangle $S$ has vertices at  $(5,-1),(2,0),(-2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians about the origin?\n\n- $(-1,-5)$\n- $(0,2)$\n- $(-1,-2)$" :question/worked-solution "The clockwise rotation ${R}_{-\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians is the same as counterclockwise rotation by an angle of $\\frac{3\\pi }{2}.$ It's given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}5 & 2 & -2 \\\\ -1 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 & -1 \\\\ -5 & -2 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-1,-5),(0,-2),(-1,2).$\n\nSo, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-160647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-160647"] :db/ensure [:knowledge-point/validate]}]
