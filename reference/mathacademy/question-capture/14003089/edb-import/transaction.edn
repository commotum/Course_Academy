3f2" "q-81829/selection/36962a07a80eabd81f1d04ce8210e17c5962e80d16e3af4481bad43f89bea416" "q-81829/selection/c67cef30db9083cf074e263ad31e219c271dbd7cbcebdf78ea922dcb2c10c48b" "q-81829/selection/b0915d87c9da1c3d4d7f8f1f53a5fb93567642ea407053f315ced579957bcee9"] :db/ensure [:answer-field/validate]} {:db/id "q-81829" :question/id #uuid "4b00d738-ec8e-51fc-8984-e5492d98724b" :question/math-academy-id "q-81829" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/df7a1eb6aaf75cc611826af00ce066ed05440bb048ad79d8c0532007b9a89c3a.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/e941207a92a2b688428c55be3bc17856ea47fa2e11db8e3dc571b88ebbe8e3b1.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81829/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-81829"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81831/selection/c67cef30db9083cf074e263ad31e219c271dbd7cbcebdf78ea922dcb2c10c48b" :answer/id #uuid "c3ab87b0-1024-5d8e-8ccd-4b4c43d6488d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/4bf42e3bdeb61feccd68cf4eeb9e3c4a40e8b903a5739df77c993e9aa4abc993.png" :db/ensure [:answer/validate]} {:db/id "q-81831/selection/b0915d87c9da1c3d4d7f8f1f53a5fb93567642ea407053f315ced579957bcee9" :answer/id #uuid "7b8e74b7-f6cd-5b7a-a08e-85bc2aeca52e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/979157d993a86617fabf4b2dfacc6d4c1d973885b42be081b4bcffb36058e091.png" :db/ensure [:answer/validate]} {:db/id "q-81831/selection/f43714b685ed18c021df42d899b387554a9299ddc0234418a8d4cfac9c0dfed9" :answer/id #uuid "adcd67c9-2bae-5a2f-88ce-cd3143fc6cad" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/f4d4d52cb24bd1e3dd4bc37736533693ff89e6b08f495f8541f23abde995a5b9.png" :db/ensure [:answer/validate]} {:db/id "q-81831/selection/36962a07a80eabd81f1d04ce8210e17c5962e80d16e3af4481bad43f89bea416" :answer/id #uuid "bae14332-1587-5084-970b-bde383f5e7ef" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/cf449d44237c85963bf4fbb134da290b39aac4ebd0b128313052cbd1970db67f.png" :db/ensure [:answer/validate]} {:db/id "q-81831/selection/acc531b1bbb55036620a5530ed6328e6dd8654e5fe18bfe931d93f3f862f2787" :answer/id #uuid "95dc36df-d626-56ea-bf9e-b872b342502b" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-ca