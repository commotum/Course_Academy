[{:db/id "q-12124/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "f7d4bc3d-a55e-5bbb-8cf3-be60cc08dce4" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-12124/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7a7d6c0b-89d4-58f6-b838-87a105cabcb9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-12124/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "911977f9-4dd7-5952-a7d2-5e7840939b58" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-12124/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "1595331b-914e-55d1-ad79-8a6281f2e79b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-12124/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ffb95726-da34-5373-afcd-2fe81b267f91" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-12124/selection" :answer-field/id #uuid "7765a4c1-9acf-5c4a-b959-40fe56dae2b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12124/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-12124/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-12124/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-12124/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-12124/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-12124/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-12124" :question/id #uuid "18446b37-20cc-5e44-a427-24676c932277" :question/math-academy-id "q-12124" :question/problem "A triangle $S$ has vertices at  $(-2,-1),(1,3),(2,-3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(-3,1)$\n- $(-3,2)$\n- $(1,-2)$" :question/worked-solution "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 3 \\\\ -2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,-2),(-3,1),(3,2).$\n\nSo, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-12124/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-12124"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81829/selection/f43714b685ed18c021df42d899b387554a9299ddc0234418a8d4cfac9c0dfed9" :answer/id #uuid "8ef96b34-9af2-541f-9f26-8660063b1119" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/f4d4d52cb24bd1e3dd4bc37736533693ff89e6b08f495f8541f23abde995a5b9.png" :db/ensure [:answer/validate]} {:db/id "q-