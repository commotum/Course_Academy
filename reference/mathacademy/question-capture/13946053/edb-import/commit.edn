86252421 13194139533804 true] [17592186252419 1000 #edb/ref 17592186252422 13194139533804 true] [17592186252419 1000 #edb/ref 17592186252423 13194139533804 true] [17592186252419 1000 #edb/ref 17592186252424 13194139533804 true] [17592186252419 1040 #edb/ref 17592186045450 13194139533804 true] [17592186252419 1041 "selection" 13194139533804 true] [17592186252419 1104 #edb/ref 17592186252422 13194139533804 true] [17592186252419 1110 #uuid "fe62cd9c-28b7-5c40-8f90-4c661dbee78c" 13194139533804 true] [17592186252420 1034 "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{\\operatorname{ln}⁡10}" 13194139533804 true] [17592186252420 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252420 1111 #uuid "eb948f4c-226b-5ea7-a821-33ea02616ed3" 13194139533804 true] [17592186252421 1034 "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x}" 13194139533804 true] [17592186252421 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252421 1111 #uuid "3bb68db7-9fc8-55c7-88f7-c4e242ecb4fc" 13194139533804 true] [17592186252422 1034 "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" 13194139533804 true] [17592186252422 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252422 1111 #uuid "9865c49e-c7e5-5f5e-b6b1-92b21129d9f8" 13194139533804 true] [17592186252423 1034 "{4}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" 13194139533804 true] [17592186252423 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252423 1111 #uuid "532fdf8e-6fcd-5316-9e31-db9e068bec60" 13194139533804 true] [17592186252424 1034 "{2}^{x}+\\frac{1}{x\\operatorname{ln}⁡10}" 13194139533804 true] [17592186252424 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252424 1111 #uuid "6e36f5c5-0ff0-564d-bf79-1c16ba9a65ff" 13194139533804 true] [17592186252425 1017 #edb/ref 17592186252426 13194139533804 true] [17592186252425 1089 "q-308866" 13194139533804 true] [17592186252425 1091 #edb/ref 17592186045464 13194139533804 true] [17592186252425 1100 "Given the function  $y=2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." 13194139533804 true] [17592186252425 1113 #uuid "531d8e85-8317-5361-86da-91c43ed3636f" 13194139533804 true] [17592186252425 1145 "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x}) \\\\  & =\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{2}{1\\cdot \\operatorname{ln}⁡3}-\\frac{4}{1}+5{e}^{1} \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}-4+5e\\,.\\end{aligned}\n$$" 13194139533804 true] [17592186252426 1000 #edb/ref 17592186252427 13194139533804 true] [17592186252426 1000 #edb/ref 17592186252428 13194139533804 true] [17592186252426 1040 #edb/ref 17592186045449 13194139533804 true] [17592186252426 1041 "field-1" 13194139533804 true] [17592186252426 1104 #edb/ref 17592186252428 13194139533804 true] [17592186252426 1110 #uuid "bbb76d22-f25a-55ba-bf2f-ebefcee93a03" 13194139533804 true] [17592186252427 1034 "\\frac{2}{\\ln(3)}-4+5" 13194139533804 true] [17592186252427 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252427 1111 #uuid "440a7ed4-7370-5a1b-9a74-32137e84be31" 13194139533804 true] [17592186252428 1034 "\\frac{2}{\\ln(3)}-4+5e" 13194139533804 true] [17592186252428 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252428 1111 #uuid "ea572cf1-2bf2-5945-b274-b03570edb943" 13194139533804 true] [17592186252429 1017 #edb/ref 17592186252430 13194139533804 true] [17592186252429 1089 "q-340100" 13194139533804 true] [17592186252429 1091 #edb/ref 17592186045463 13194139533804 true] [17592186252429 1100 "Given the function  $y=-3\\operatorname{ln}⁡x+2{e}^{x}+4$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." 13194139533804 true] [17592186252429 1113 #uuid "c2824715-156d-51a1-a808-adf63294ce4b" 13194139533804 true] [17592186252429 1145 "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+2{e}^{x}+4) \\\\  & =-\\frac{3}{x}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-\\frac{3}{x}+2{e}^{x})|}_{x=2} \\\\  & =-\\frac{3}{2}+2{e}^{2}\\,.\\end{aligned}\n$$" 13194139533804 true] [17592186252430 1000 #edb/ref 17592186252431 13194139533804 true] [17592186252430 1040 #edb/ref 17592186045449 13194139533804 true] [17592186252430 1041 "field-1" 13194139533804 true] [17592186252430 1104 #edb/ref 17592186252431 13194139533804 true] [17592186252430 1110 #uuid "08982ee9-e072-5447-b82c-7908a713f888" 13194139533804 true] [17592186252431 1034 "-\\frac{3}{2}+2e^2" 13194139533804 true] [17592186252431 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252431 1111 #uuid "cfc8dad3-40eb-54b0-b016-966e4c9d6784" 13194139533804 true] [17592186252432 1017 #edb/ref 17592186252433 13194139533804 true] [17592186252432 1089 "q-70903" 13194139533804 true] [17592186252432 1091 #edb/ref 17592186045463 13194139533804 true] [17592186252432 1100 "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" 13194139533804 true] [17592186252432 1113 #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" 13194139533804 true] [17592186252432 1145 "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$" 13194139533804 true] [17592186252433 1000 #edb/ref 17592186252434 13194139533804 true] [17592186252433 1000 #edb/ref 17592186252435 13194139533804 true] [17592186252433 1000 #edb/ref 17592186252436 13194139533804 true] [17592186252433 1000 #edb/ref 17592186252437 13194139533804 true] [17592186252433 1000 #edb/ref 17592186252438 13194139533804 true] [17592186252433 1040 #edb/ref 17592186045450 13194139533804 true] [17592186252433 1041 "selection" 13194139533804 true] [17592186252433 1104 #edb/ref 17592186252435 13194139533804 true] [17592186252433 1110 #uuid "e11489c8-6ed1-5498-916d-581767f7b0da" 13194139533804 true] [17592186252434 1034 "\\frac{9}{\\operatorname{ln}⁡10}-3" 13194139533804 true] [17592186252434 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252434 1111 #uuid "d017ca32-5a37-5143-8741-23b27314931e" 13194139533804 true] [17592186252435 1034 "\\frac{1}{\\operatorname{ln}⁡10}+27" 13194139533804 true] [17592186252435 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252435 1111 #uuid "926a0c3e-87a6-5710-9733-86e2582b129c" 13194139533804 true] [17592186252436 1034 "\\frac{1}{3\\operatorname{ln}⁡10}+3" 13194139533804 true] [17592186252436 1103 #edb/ref 17592186045453 13194139533804 true] [17592186252436 1111 #uuid "3a154233-0aa5-5ec2-b62c-ee77f0faef92" 13194139533804 true] [17