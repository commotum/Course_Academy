#{[{:db/id #edb/ref 17592186252411 :knowledge-point/_questions [{:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255228a3-a608-5e05-8126-68758f110cb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+10+21{x}^{3}" :db/id #edb/ref 17592186252413} {:answer/id #uuid "1746c521-3173-5658-abe8-62f1d2e5ea5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{x}+10+21{x}^{2}" :db/id #edb/ref 17592186252414} {:answer/id #uuid "2f186d95-3030-5d31-ba8c-524b839c35a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186252415} {:answer/id #uuid "c72343b1-78d9-57e7-bffc-1d2d202bb8b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+7{x}^{2}" :db/id #edb/ref 17592186252416} {:answer/id #uuid "829747b7-299c-50ed-b896-3c1e5bdaeead" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186252417}] :answer-field/correct {:answer/id #uuid "2f186d95-3030-5d31-ba8c-524b839c35a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186252415} :answer-field/id #uuid "9161b67f-7f2b-59c5-94c9-6ffb76557ab6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252412}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec72a2ad-a898-51ad-a07d-a7dda425c8d9" :question/math-academy-id "q-101716" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2\\operatorname{ln}⁡x-10x+7{x}^{3}-1.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x-10x+7{x}^{3}-1) \\\\  & =2(\\frac{1}{x})-10+21{x}^{2} \\\\  & =\\frac{2}{x}-10+21{x}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252418 :knowledge-point/_questions [{:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb948f4c-226b-5ea7-a821-33ea02616ed3" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186252420} {:answer/id #uuid "3bb68db7-9fc8-55c7-88f7-c4e242ecb4fc" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x}" :db/id #edb/ref 17592186252421} {:answer/id #uuid "9865c49e-c7e5-5f5e-b6b1-92b21129d9f8" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186252422} {:answer/id #uuid "532fdf8e-6fcd-5316-9e31-db9e068bec60" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186252423} {:answer/id #uuid "6e36f5c5-0ff0-564d-bf79-1c16ba9a65ff" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186252424}] :answer-field/correct {:answer/id #uuid "9865c49e-c7e5-5f5e-b6b1-92b21129d9f8" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186252422} :answer-field/id #uuid "fe62cd9c-28b7-5c40-8f90-4c661dbee78c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252419}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15126e7c-ab5e-5dcd-a698-7b6d8e732d06" :question/math-academy-id "q-1921" :question/problem "Find ${f}^{′}(x)$ for $f(x)={2}^{x}+\\operatorname{log}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({2}^{x}+\\operatorname{log}⁡x) \\\\  & ={2}^{x}\\cdot \\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10} \\\\  & ={2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252425 :knowledge-point/_questions [{:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "440a7ed4-7370-5a1b-9a74-32137e84be31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln(3)}-4+5" :db/id #edb/ref 17592186252427} {:answer/id #uuid "ea572cf1-2bf2-5945-b274-b03570edb943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln(3)}-4+5e" :db/id #edb/ref 17592186252428}] :answer-field/correct {:answer/id #uuid "ea572cf1-2bf2-5945-b274-b03570edb943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\ln(3)}-4+5e" :db/id #edb/ref 17592186252428} :answer-field/id #uuid "bbb76d22-f25a-55ba-bf2f-ebefcee93a03" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186252426}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "531d8e85-8317-5361-86da-91c43ed3636f" :question/math-academy-id "q-308866" :question/problem "Given the function  $y=2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x}) \\\\  & =\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{2}{1\\cdot \\operatorname{ln}⁡3}-\\frac{4}{1}+5{e}^{1} \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}-4+5e\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252429 :knowledge-point/_questions [{:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfc8dad3-40eb-54b0-b016-966e4c9d6784" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2e^2" :db/id #edb/ref 17592186252431}] :answer-field/correct {:answer/id #uuid "cfc8dad3-40eb-54b0-b016-966e4c9d6784" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2e^2" :db/id #edb/ref 17592186252431} :answer-field/id #uuid "08982ee9-e072-5447-b82c-7908a713f888" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186252430}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c2824715-156d-51a1-a808-adf63294ce4b" :question/math-academy-id "q-340100" :question/problem "Given the function  $y=-3\\operatorname{ln}⁡x+2{e}^{x}+4$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+2{e}^{x}+4) \\\\  & =-\\frac{3}{x}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-\\frac{3}{x}+2{e}^{x})|}_{x=2} \\\\  & =-\\frac{3}{2}+2{e}^{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252432 :knowledge-point/_questions [{:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d017ca32-5a37-5143-8741-23b27314931e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡10}-3" :db/id #edb/ref 17592186252434} {:answer/id #uuid "926a0c3e-87a6-5710-9733-86e2582b129c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186252435} {:answer/id #uuid "3a154233-0aa5-5ec2-b62c-ee77f0faef92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡10}+3" :db/id #edb/ref 17592186252436} {:answer/id #uuid "3480a48d-8da8-5672-b79d-367b79a303f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}-9" :db/id #edb/ref 17592186252437} {:answer/id #uuid "245cec00-3933-5db4-aa30-e88a6b191b7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡10}+9" :db/id #edb/ref 17592186252438}] :answer-field/correct {:answer/id #uuid "926a0c3e-87a6-5710-9733-86e2582b129c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186252435} :answer-field/id #uuid "e11489c8-6ed1-5498-916d-581767f7b0da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252433}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" :question/math-academy-id "q-70903" :question/problem "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$"}]}
