}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & 6 & -2 \\\\ 1 & 0 & 5 & -3 \\\\ -2 & 3 & -3 & 8 \\\\ -1 & 3 & -4 & 1\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-5{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -4 & -2 \\\\ 1 & 0 & 0 & -3 \\\\ -2 & 3 & 7 & 8 \\\\ -1 & 3 & 1 & 1\\end{aligned}] &  & \\,\\begin{aligned}{C}_{4}:={C}_{4}+3{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -4 & 4 \\\\ 1 & 0 & 0 & 0 \\\\ -2 & 3 & 7 & 2 \\\\ -1 & 3 & 1 & -2\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-4{C}_{1}\\,$ and $\\,{C}_{4}:={C}_{4}+3{C}_{1}.$"}] [{:db/id #edb/ref 17592186162482 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a941c4e1-5e36-53ce-bc6b-7d6663d0963c" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 4C_{3}$ and $C_{2}:=C_{2} - 3C_{3}$" :db/id #edb/ref 17592186160525} {:answer/id #uuid "f458abd4-da18-5702-90a4-330e62adc6c7" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 3C_{3}$ and $C_{2}:=C_{2} + C_{3}$" :db/id #edb/ref 17592186160526} {:answer/id #uuid "1dabc275-1f78-58e5-af0a-2f8732ba71e0" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 3C_{3}$ and $C_{2}:=C_{2} + 4C_{3}$" :db/id #edb/ref 17592186160527} {:answer/id #uuid "34741622-1ae3-5eb4-ab55-84a7650c2729" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 3C_{3}$ and $C_{2}:=C_{2} - 4C_{3}$" :db/id #edb/ref 17592186160528} {:answer/id #uuid "5536cf5f-999a-5c38-9842-8c8dc2cc8268" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 4C_{3}$ and $C_{2}:=C_{2} - 3C_{3}$" :db/id #edb/ref 17592186160529}] :answer-field/correct {:answer/id #uuid "34741622-1ae3-5eb4-ab