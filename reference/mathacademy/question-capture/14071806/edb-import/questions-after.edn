,\\begin{aligned}{R}_{4}:={R}_{4}-{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -7 & -27 \\\\ 2 & 0 & 7 & 18 \\\\ 0 & 2 & 6 & 9 \\\\ 0 & 0 & 3 & -1\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n  \n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}-3{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{3}.$"}] [{:db/id #edb/ref 17592186373399 :knowledge-point/_questions [{:knowledge-point/id #uuid "21f1ec99-e166-5986-a07d-f07be0dfeb31" :knowledge-point/title "Using Row Operations to Create a Column of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa07510c-6660-5c55-87d9-9513a9b2f792" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{4}$" :db/id #edb/ref 17592186373401} {:answer/id #uuid "7832027d-d3d6-58a2-bd59-52e41d8fc614" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}-4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{4}$" :db/id #edb/ref 17592186373402} {:answer/id #uuid "df84af41-4c4e-567b-82b6-cee08ff0ae3d" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+2{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+4{R}_{4}$" :db/id #edb/ref 17592186373403} {:answer/id #uuid "a07f5e42-6743-54f9-92f7-9f02c799e491" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}-2{R}_{4}$" :db/id #edb/ref 17592186373404} {:answer/id #uuid "436a98d7-6faf-566d-829b-389b9c88be1f" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{4}$" :db/id #edb/ref 17592186373405}] :answer-field/correct {:answer/id #uuid "436a98d7-6faf-566d-829b-389b9c88be1f" :answer/type {:db/ident :answer.type/text} :answer/value "${R}_{1}:={R}_{1}+4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{4}$" :db/id #edb/ref 17592186373405} :answer-field/id #uuid "87adfddb-ee40-5d26-a5d8-d4b45e7b7c0b" :answer-field/key 