 1 & -1 & 2 \\\\ -10 & -3 & -7 & 4\\end{aligned}],\\,B=[\\begin{aligned}-4 & 13 & 9 & 0 \\\\ 2 & 4 & 6 & -1 \\\\ 10 & 9 & 11 & 0 \\\\ -2 & 13 & 17 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations \n\n- ${R}_{1}:=…$\n- ${R}_{3}:=…$\n- ${R}_{4}:={R}_{4}+4{R}_{2}$\n\neach of the form ${R}_{i}:={R}_{i}+k{R}_{2},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary row operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries above and below ${a}_{24}=-1$ equal to $0.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-8 & 5 & -3 & 2 \\\\ 2 & 4 & 6 & -1 \\\\ 6 & 1 & -1 & 2 \\\\ -10 & -3 & -7 & 4\\end{aligned}] &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-4 & 13 & 9 & 0 \\\\ 2 & 4 & 6 & -1 \\\\ 6 & 1 & -1 & 2 \\\\ -10 & -3 & -7 & 4\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}+2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-4 & 13 & 9 & 0 \\\\ 2 & 4 & 6 & -1 \\\\ 10 & 9 & 11 & 0 \\\\ -10 & -3 & -7 & 4\\end{aligned}] &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}+4{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-4 & 13 & 9 & 0 \\\\ 2 & 4 & 6 & -1 \\\\ 10 & 9 & 11 & 0 \\\\ -2 & 13 & 17 & 0\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}+2{R}_{2}\\,$ and $\\,{R}_{3}:={R}_{3}+2{R}_{2}.$"}] [{:db/id #edb/ref 17592186373469 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c78e8104-193e-53f5-9794-d31ad1cedb25" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+6{C}_{1}$" :db/id #edb/ref 17592186373471} {:answer/id #uuid "b54fe6ff-361c-52aa-adaa-defc97f12e78" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-6{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{1}$" :db/id #edb/ref 17592186373472} {:answer/id #uuid "636235b0-1734-547f-8bf7-19d38658f54c" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-2{C}_{1}$" :db/id #edb/ref 17592186373473} {:answer/id #uuid "eb01d510-50ce-5561-be12-69e2d0f8893a" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-6{C}_{1}$" :db/id #edb/ref 17592186373474} {:answer/id #uuid "5d61265f-36a3-57f9-a22b-3773d4b1d2cb" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-6{C}_{1}$" :db/id #edb/ref 17592186373475}] :answer-field/correct {:answer/id #uuid "eb01d510-50ce-5561-be12-69e2d0f8893a" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-6{C}_{1}$" :db/id #edb/ref 17592186373474} :answer-field/id #uuid "3e60c925-513c-56f1-a723-195a35391705" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373470}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6dd71aa7-2526-5ec2-a9f6-b90282642c24" :question/math-academy-id "q-91186" :question/problem "$$\nA=[\\begin{aligned}1 & 1 & 6 \\\\ 2 & 9 & 0 \\\\ 1 & 1 & 9\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 7 & -12 \\\\ 1 & 0 & 3\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{1},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the right of ${a}_{11}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 1 & 6 \\\\ 2 & 9 & 0 \\\\ 1 & 1 & 9\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 6 \\\\ 2 & 7 & 0 \\\\ 1 & 0 & 9\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-6{C}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 7 & -12 \\\\ 1 & 0 & 3\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}-6{C}_{1}.$"}] [{:db/id #edb/ref 17592186162498 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ca3f431-ff5f-5b9f-b1d6-216e788ec8b0" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} - C_{2}$" :db/id #edb/ref 17592186160621} {:answer/id #uuid "d9d2d880-c243-5c71-a98d-a828bd2df88e" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160622} {:answer/id #uuid "ea628825-c2e2-507b-b077-975c5e52bcd7" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - C_{2}$ and $C_{3}:=C_{3} + 2C_{2}$" :db/id #edb/ref 17592186160623} {:answer/id #uuid "0eba1ced-7848-5d98-a2e9-14225785d7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160624} {:answer/id #uuid "5b28caa5-871b-5341-9e0b-add19b323bea" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160625}] :answer-field/correct {:answer/id #uuid "0eba1ced-7848-5d98-a2e9-14225785d7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160624} :answer-field/id #uuid "a32be203-ae70-5fba-b488-68efa9487d90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160620}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "63dc72f5-1b5e-509c-b30f-0a4ab5f385d0" :question/math-academy-id "q-91189" :question/problem "$$\nA=[\\begin{aligned}10 & 5 & -5 \\\\ -1 & 3 & -4 \\\\ 8 & 8 & 0\\end{aligned}],\\,B=[\\begin{aligned}0 & 5 & 0 \\\\ -7 & 3 & -1 \\\\ -8 & 8 & 8\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{2},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left and to the right of ${a}_{12}=5$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}10 & 5 & -5 \\\\ -1 & 3 & -4 \\\\ 8 & 8 & 0\\end{aligned}] &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}-2{C}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 5 & -5 \\\\ -7 & 3 & -4 \\\\ -8 & 8 & 0\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}+{C}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 5 & 0 \\\\ -7 & 3 & -1 \\\\ -8 & 8 & 8\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+{C}_{2}.$"}] [{:db/id #edb/ref 17592186373476 :knowledge-point/_questions [{:knowledge-point/id #uuid "958cdcf3-aaba-5275-85f8-9531f10b3d0e" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33e4c428-625f-593b-ab11-cc2697653d97" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-5{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}-3{C}_{4}$" :db/id #edb/ref 17592186373478} {:answer/id #uuid "c9c257fc-3e09-567f-b5bf-5d08ac4cf79d" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+3{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}+5{C}_{4}$" :db/id #edb/ref 17592186373479} {:answer/id #uuid "d875da1d-82ca-59ea-8d1a-e38b9bb731cd" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-5{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}+3{C}_{4}$" :db/id #edb/ref 17592186373480} {:answer/id #uuid "8d24529a-04f9-5506-a038-636730a42109" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+5{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}+3{C}_{4}$" :db/id #edb/ref 17592186373481} {:answer/id #uuid "3638a8fc-c053-56f3-a735-bfa8e079dcad" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-3{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}-5{C}_{4}$" :db/id #edb/ref 17592186373482}] :answer-field/correct {:answer/id #uuid "33e4c428-625f-593b-ab11-cc2697653d97" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-5{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}-3{C}_{4}$" :db/id #edb/ref 17592186373478} :answer-field/id #uuid "2a454c08-9e06-52f8-946d-2606ff908957" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373477}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "edd5432a-1843-5418-9458-ee6d7d63983e" :question/math-academy-id "q-91211" :question/problem "$$\nA=[\\begin{aligned}1 & 1 & 6 & 1 \\\\ 8 & 1 & 2 & 5 \\\\ 0 & 9 & -5 & 4 \\\\ 4 & 5 & 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}-3 & -4 & 3 & 1 \\\\ -12 & -24 & -13 & 5 \\\\ -16 & -11 & -17 & 4 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary column operations \n\n- ${C}_{1}:={C}_{1}-4{C}_{4}$\n- ${C}_{2}:=…$\n- ${C}_{3}:=…$\n\neach of the form ${C}_{i}:={C}_{i}+k{C}_{4},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left of ${a}_{44}=1$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 1 & 6 & 1 \\\\ 8 & 1 & 2 & 5 \\\\ 0 & 9 & -5 & 4 \\\\ 4 & 5 & 3 & 1\\end{aligned}] &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}-4{C}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & 1 & 6 & 1 \\\\ -12 & 1 & 2 & 5 \\\\ -16 & 9 & -5 & 4 \\\\ 0 & 5 & 3 & 1\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-5{C}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & -4 & 6 & 1 \\\\ -12 & -24 & 2 & 5 \\\\ -16 & -11 & -5 & 4 \\\\ 0 & 0 & 3 & 1\\end{aligned}] &  & \\,\\begin{aligned}{C}_{3}:={C}_{3}-3{C}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}-3 & -4 & 3 & 1 \\\\ -12 & -24 & -13 & 5 \\\\ -16 & -11 & -17 & 4 \\\\ 0 & 0 & 0 & 1\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-5{C}_{4}\\,$ and $\\,{C}_{3}:={C}_{3}-3{C}_{4}.$"}] [{:db/id #edb/ref 17592186373483 :knowledge-point/_questions [{:knowledge-point/id #uuid "958cdcf3-aaba-5275-85f8-9531f10b3d0e" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d3a7c3b-16fc-5438-8850-46549284efac" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-{C}_{2}$" :db/id #edb/ref 17592186373485} {:answer/id #uuid "be1c3f77-7656-5b15-b740-d0a8b9ed4bfb" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-3{C}_{2}$" :db/id #edb/ref 17592186373486} {:answer/id #uuid "15d23448-9097-5c91-9dda-434172e8f1c0" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3