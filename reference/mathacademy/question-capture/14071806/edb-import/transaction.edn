 & 5 \\\\ 5 & -4 & 5 & -2 \\\\ 6 & -2 & 1 & -1\\end{aligned}],\\,B=[\\begin{aligned}7 & 0 & 4 & 3 \\\\ 5 & 0 & 7 & 3 \\\\ -7 & 0 & 3 & 0 \\\\ 6 & -2 & 1 & -1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $B$ above. By applying three matrix elementary row operations \n\n- ${R}_{1}:=…$\n- ${R}_{2}:=…$\n- ${R}_{3}:={R}_{3}-2{R}_{4}$\n\neach of the form ${R}_{i}:={R}_{i}+k{R}_{4},$ the matrix $A$ can be transformed into the matrix $B.$ What are the missing elementary row operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries above ${a}_{42}=-2$ equal to $0.$\n\nTo do this, we can apply the following elementary row operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-17 & 8 & 0 & 7 \\\\ -7 & 4 & 5 & 5 \\\\ 5 & -4 & 5 & -2 \\\\ 6 & -2 & 1 & -1\\end{aligned}] &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}+4{R}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}7 & 0 & 4 & 3 \\\\ -7 & 4 & 5 & 5 \\\\ 5 & -4 & 5 & -2 \\\\ 6 & -2 & 1 & -1\\end{aligned}] &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}7 & 0 & 4 & 3 \\\\ 5 & 0 & 7 & 3 \\\\ 5 & -4 & 5 & -2 \\\\ 6 & -2 & 1 & -1\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}-2{R}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}7 & 0 & 4 & 3 \\\\ 5 & 0 & 7 & 3 \\\\ -7 & 0 & 3 & 0 \\\\ 6 & -2 & 1 & -1\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}+4{R}_{4}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130461/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21f1ec99-e166-5986-a07d-f07be0dfeb31"] :knowledge-point/questions ["q-130461"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130611/selection/50ec14a0c456a6d6c3aa213227ddc4aed9c91b11c7aa01072b145a6134760876" :answer/id #uuid "d03a3d9b-2b6a-5dd9-8bb5-44aa7848d798" :answer/type :answer.type/text :answer/value "${C}_{