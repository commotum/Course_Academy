ns:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 6 & 11 & 0 \\\\ 2 & -4 & -5 & 0 \\\\ 0 & 2 & 6 & 9 \\\\ 0 & 2 & 9 & 8\\end{aligned}] &  & \\,\\begin{aligned}{R}_{1}:={R}_{1}-3{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -7 & -27 \\\\ 2 & -4 & -5 & 0 \\\\ 0 & 2 & 6 & 9 \\\\ 0 & 2 & 9 & 8\\end{aligned}] &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -7 & -27 \\\\ 2 & 0 & 7 & 18 \\\\ 0 & 2 & 6 & 9 \\\\ 0 & 2 & 9 & 8\\end{aligned}] &  & \\,\\begin{aligned}{R}_{4}:={R}_{4}-{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 0 & -7 & -27 \\\\ 2 & 0 & 7 & 18 \\\\ 0 & 2 & 6 & 9 \\\\ 0 & 0 & 3 & -1\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n  \n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}-3{R}_{3}\\,$ and $\\,{R}_{2}:={R}_{2}+2{R}_{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130459/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21f1ec99-e166-5986-a07d-f07be0dfeb31"] :knowledge-point/questions ["q-130459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91179/selection/3556ec47e858486a79ced7797fde20b50d21fbccaac0ed233b8af104ff90fb56" :answer/id #uuid "4eb30540-c608-5526-b18c-62a11d640f95" :answer/type :answer.type/text :answer/value "${R}_{1}:={R}_{1}+{R}_{2}\\,$ and $\\,{R}_{3}:={R}_{3}+{R}_{2}$" :db/ensure [:answer/validate]} {:db/id "q-91179/selection/fdf15de5d27fcb01851abef26a52ce1008fc57d312d58d142b8d28aceeef53e5" :answer/id #uuid "c42907e0-9d68-5454-b3a9-6ca8cc8db7ca" :answer/type :answer.type/text :answer/value "${R}_{1}:={R}_{1}+2{R}_{2}\\,$ and $\\,{R}_{3}:={R}_{3}+2{R}_{2}$" :db/ensure [:answer/validate]} {:db/id "q-91179/selection/60543c3131fa4daea6a71fb5b0441c1505651106e79194c5638adc2de11b4bca" :answer/id #uuid "6db7ea29-f8af-56e5-8fe2-05dd4b37b930" :answer/type :answer.type/text :answer/value "${R}_{1}:={R}_{1}-2{R}_{2}\\,$ and $\\,{R}_{3}:={R}_{3}+2{R}_{2}$" :db/ensure [:answer/