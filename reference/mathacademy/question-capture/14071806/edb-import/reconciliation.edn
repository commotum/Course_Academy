3 & -5 & -2 & 8 \\\\ 11 & -1 & 2 & 8\\end{aligned}] &  & \\,\\begin{aligned}{R}_{3}:={R}_{3}-5{R}_{4}\\end{aligned} \\\\  & ∼[\\begin{aligned}-26 & 0 & -10 & -10 \\\\ 30 & 0 & 0 & 22 \\\\ -52 & 0 & -12 & -32 \\\\ 11 & -1 & 2 & 8\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the missing elementary row operations are\n\n$\\,$ ${R}_{1}:={R}_{1}-3{R}_{4}\\,$ and $\\,{R}_{3}:={R}_{3}-5{R}_{4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/state.json" "file_sha256" "39ca3612cc1476f345b5b0c22b9df36ae735185c4d19e174735bd47ec7b3faeb" "basis" 1412 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/edb-import/verification.json"} {"question" "q-91174" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/activity-metadata.json" "file_sha256" "9621d434515595164b9a7b82a0b62acb60abf05f431523c0f0f85bd07935f033" "basis" 1412 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/edb-import/verification.json"} {"question" "q-91174" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/state.json" "file_sha256" "39ca3612cc1476f345b5b0c22b9df36ae735185c4d19e174735bd47ec7b3faeb" "basis" 1412 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040091/edb-import/verification.json"} {"question" "q-91174" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "${R}_{1}:={R}_{1}+3{R}_{4}\\,$ and $\\,{R}_{3}:={R}_{3}+5{R}_{4}$"] "category" "ma_capture" "file" "/home/jake/Developer/Cou