n\n$\\,$ ${R}_{1}:={R}_{1}-3{R}_{4}\\,$ and $\\,{R}_{3}:={R}_{3}-5{R}_{4}.$"}] [{:db/id #edb/ref 17592186162498 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ca3f431-ff5f-5b9f-b1d6-216e788ec8b0" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} - C_{2}$" :db/id #edb/ref 17592186160621} {:answer/id #uuid "d9d2d880-c243-5c71-a98d-a828bd2df88e" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160622} {:answer/id #uuid "ea628825-c2e2-507b-b077-975c5e52bcd7" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - C_{2}$ and $C_{3}:=C_{3} + 2C_{2}$" :db/id #edb/ref 17592186160623} {:answer/id #uuid "0eba1ced-7848-5d98-a2e9-14225785d7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160624} {:answer/id #uuid "5b28caa5-871b-5341-9e0b-add19b323bea" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160625}] :answer-field/correct {:answer/id #uuid "0eba1ced-7848-5d98-a2e9-14225785d7bd" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 2C_{2}$ and $C_{3}:=C_{3} + C_{2}$" :db/id #edb/ref 17592186160624} :answer-field/id #uuid "a32be203-ae70-5fba-b488-68efa9487d90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160620}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "63dc72f5-1b5e-509c-b30f-0a4ab5f385d0" :question/math-academy-id "q-91189" :question/problem "$$\nA=[\\begin{aligned}10 & 5 & -5 \\\\ -1 & 3 & -4 