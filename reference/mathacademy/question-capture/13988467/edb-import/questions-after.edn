^{1}+(\\frac{5}{2}){(3)}^{5-2}{(x)}^{2}+… \\\\  & =1{(3)}^{5}+5{(3)}^{4}{(x)}^{1}+10{(3)}^{3}{(x)}^{2}+… \\\\  & =243+405x+270{x}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283141 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8" :knowledge-point/title "Finding the First Few Terms of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20fa6665-89a4-55fb-8f40-334aa0d32696" :answer/type {:db/ident :answer.type/math} :answer/value "125+25x+15{x}^{2}+⋯" :db/id #edb/ref 17592186283143} {:answer/id #uuid "9460228b-bbd6-5401-83f0-1c57d8061d8c" :answer/type {:db/ident :answer.type/math} :answer/value "125+75x+5{x}^{2}+⋯" :db/id #edb/ref 17592186283144} {:answer/id #uuid "02027145-1f94-5c65-8844-d5e9880828ad" :answer/type {:db/ident :answer.type/math} :answer/value "125+25x+5{x}^{2}+⋯" :db/id #edb/ref 17592186283145} {:answer/id #uuid "8ab47511-d557-5bc6-8e42-7c4fd800937b" :answer/type {:db/ident :answer.type/math} :answer/value "125+75x+15{x}^{2}+⋯" :db/id #edb/ref 17592186283146} {:answer/id #uuid "faded5b8-9537-5bb7-861b-0c6ac43ca56a" :answer/type {:db/ident :answer.type/math} :answer/value "25+75x+15{x}^{2}+⋯" :db/id #edb/ref 17592186283147}] :answer-field/correct {:answer/id #uuid "8ab47511-d557-5bc6-8e42-7c4fd800937b" :answer/type {:db/ident :answer.type/math} :answer/value "125+75x+15{x}^{2}+⋯" :db/id #edb/ref 17592186283146} :answer-field/id #uuid "bafc6bc5-ae26-5846-b0ef-b6b9ff7ffaf5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283142}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "72a5b2b9-6e99-5ee7-a6dc-48a0a7cc8ee0" :question/math-academy-id "q-136000" :question/problem "$(5+x)^{3}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(5+x)^{3},$ we have  $a=5,$ $b=x,$ $n=3.$ \n\nTherefore, the first three terms of $(5+x)^{3}$ are as follows:\n\n$$\n\\begin{aligned}{(5+x)}^{3} & =(\\frac{3}{0}){(5)}^{3}{(x)}^{0}+(\\frac{3}{1}){(5)}^{3-1}{(x)}^{1}+(\\frac{3}{2}){(5)}^{3-2}{(x)}^{2}+⋯ \\\\  & =1{(5)}^{3}+3{(5)}^{2}{(x)}^{1}+3{(5)}^{1}{(x)}^{2}+⋯ \\\\  & =125+75x+15{x}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283148 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8" :knowledge-point/title "Finding the First Few Terms of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117a98d8-e552-523f-85aa-e8c437f9cfa9" :answer/type {:db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186283150} {:answer/id #uuid "2c2a6759-fc13-52df-9b49-5a477cf71198" :answer/type {:db/ident :answer.type/math} :answer/value "81+108x+9{x}^{2}+⋯" :db/id #edb/ref 17592186283151} {:answer/id #uuid "b6c811ee-ee75-5783-af8b-fb7d71bde184" :answer/type {:db/ident :answer.type/math} :answer/value "27+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186283152} {:answer/id #uuid "b0123fbb-ba78-53d8-ba20-782efda60561" :answer/type {:db/ident :answer.type/math} :answer/value "81+27x+9{x}^{2}+⋯" :db/id #edb/ref 17592186283153} {:answer/id #uuid "e5967991-17ef-5fdb-a0b5-b0539ad6ca37" :answer/type {:db/ident :answer.type/math} :answer/value "81+27x+54{x}^{2}+⋯" :db/id #edb/ref 17592186283154}] :answer-field/correct {:answer/id #uuid "117a98d8-e552-523f-85aa-e8c437f9cfa9" :answer/type {:db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186283150} :answer-field/id #uuid "a7ff26ef-0b66-558c-bdb2-6bd4aef1fa9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283149}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident 