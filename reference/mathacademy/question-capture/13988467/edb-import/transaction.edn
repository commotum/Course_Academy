3aaa497a6a89aa0127bea1b1cc514d5e1d0cc17a73a782"] :db/ensure [:answer-field/validate]} {:db/id "q-12492" :question/id #uuid "90ad29ce-1bbd-5469-b775-23ffb6f6d922" :question/math-academy-id "q-12492" :question/problem "${(x+2y)}^{8}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(x+2y)}^{8},$ we have  $a=x,$ $b=2y,$ $n=8.$ \n\nTherefore, the first three terms of ${(x+2y)}^{8}$ are as follows:\n\n$$\n\\begin{aligned}(x+2y)^{8} & =(\\frac{8}{0}){(x)}^{8}{(2y)}^{0}+(\\frac{8}{1}){(x)}^{8-1}{(2y)}^{1}+(\\frac{8}{2}){(x)}^{8-2}{(2y)}^{2}+… \\\\  & =1(x)^{8}+8(x)^{7}(2y)^{1}+28(x)^{6}(2y)^{2}+… \\\\  & ={x}^{8}+16{x}^{7}{y}^{1}+28{x}^{6}(4{y}^{2})+… \\\\  & ={x}^{8}+16{x}^{7}y+112{x}^{6}{y}^{2}+…\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12492/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8"] :knowledge-point/questions ["q-12492"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136002/selection/d3cf6a7b8a9c7b640c0f9750524db04d82d32bf5e37ee477b01f1f25b31c7213" :answer/id #uuid "e5967991-17ef-5fdb-a0b5-b0539ad6ca37" :answer/type :answer.type/math :answer/value "81+27x+54{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136002/selection/8a842425779ca6ce738ac8b4f2378dfc62b040b7022e6d308b68a1051d5a0c42" :answer/id #uuid "b0123fbb-ba78-53d8-ba20-782efda60561" :answer/type :answer.type/math :answer/value "81+27x+9{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136002/selection/5b6721b375c48a28057e231d0f4d654d4f315f183ce3ab61e5093e6bfc265b91" :answer/id #uuid "b6c811ee-ee75-5783-af8b-fb7d71bde184" :answer/type :answer.type/math :answer/value "27+108x+54{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136002/selection/4bbe8ea