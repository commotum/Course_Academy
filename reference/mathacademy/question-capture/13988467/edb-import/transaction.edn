& ={x}^{10}+70{x}^{9}y+2\\,205{x}^{8}{y}^{2}+…\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12490/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8"] :knowledge-point/questions ["q-12490"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136000/selection/059ca6e91fe12de1c6a8f009edfc88c09c23e1dd4815dcbed0032296b03e7919" :answer/id #uuid "20fa6665-89a4-55fb-8f40-334aa0d32696" :answer/type :answer.type/math :answer/value "125+25x+15{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136000/selection/e21dff3a28f8bf12d7833849aa2e1eba28342a7880058d659b9ad9b13739da5c" :answer/id #uuid "faded5b8-9537-5bb7-861b-0c6ac43ca56a" :answer/type :answer.type/math :answer/value "25+75x+15{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136000/selection/b260700393169942e0f2e7e64c8edcac7b09882eee63a049836f716904419e45" :answer/id #uuid "02027145-1f94-5c65-8844-d5e9880828ad" :answer/type :answer.type/math :answer/value "125+25x+5{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136000/selection/b2fba2461c110e7635234a4a40ae8d8c8409639ebc9669d34a9f5790169ca3ab" :answer/id #uuid "8ab47511-d557-5bc6-8e42-7c4fd800937b" :answer/type :answer.type/math :answer/value "125+75x+15{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136000/selection/619ee95597919217f257582eaa2ad5dd66247a6e7c67f03e1eae5655d73a6ae4" :answer/id #uuid "9460228b-bbd6-5401-83f0-1c57d8061d8c" :answer/type :answer.type/math :answer/value "125+75x+5{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136000/selection" :answer-field/id #uuid "bafc6bc5-ae26-5846-b0ef-b6b9ff7ffaf5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136000/selection/b2fba2461c110e7635234a4a40ae8d8c8409639ebc9669d34a9f5790169ca3ab" :answer-field/choices ["q-136000/selection/059ca6e91fe12de1c6a8f009edfc88c09c23e1dd4815dcbed0032296b03e7919" "q-136000/selection/e21dff3a28f