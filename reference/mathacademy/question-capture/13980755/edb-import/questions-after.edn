#{[{:db/id #edb/ref 17592186281233 :knowledge-point/_questions [{:knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9b06de9-6fec-5f4a-904a-2f04e921219f" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,962\\,624" :db/id #edb/ref 17592186281235} {:answer/id #uuid "fbe8df6c-068d-5a63-87ac-56bce307f89d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,100\\,480" :db/id #edb/ref 17592186281236} {:answer/id #uuid "f0a0b70d-3288-52f0-839d-8783edb36bef" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281237} {:answer/id #uuid "905b5754-814c-5374-90f7-3f8fd831277d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,125" :db/id #edb/ref 17592186281238} {:answer/id #uuid "a8fcaa78-caf5-5447-99ac-4bbef3147078" :answer/type {:db/ident :answer.type/math} :answer/value "42\\,504" :db/id #edb/ref 17592186281239}] :answer-field/correct {:answer/id #uuid "a8fcaa78-caf5-5447-99ac-4bbef3147078" :answer/type {:db/ident :answer.type/math} :answer/value "42\\,504" :db/id #edb/ref 17592186281239} :answer-field/id #uuid "fe7c2b43-3dd8-5efe-925b-aff1b1a69519" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281234}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2c497cbf-e42c-5b88-8cde-4e1350af1955" :question/math-academy-id "q-122565" :question/problem "Stefany wants to draw a picture using $5$ colors from her $24$-color crayon box. In how many ways can she pick the $5$ colors?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $24$ colors, so $n=24.$ We want to select $5$ of those colors for Stefany to draw her picture, so we have $r=5.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{24}{C}_{5} & =\\frac{24!}{(24-5)!\\,5!} \\\\  & =\\frac{24!}{19!5!} \\\\  & =\\frac{24\\cdot 23\\cdot 22\\cdot 21\\cdot 20\\cdot \\cancel{19!}}{\\cancel{19!}5!} \\\\  & =\\frac{24\\cdot 23\\cdot 22\\cdot 21\\cdot 20}{5\\cdot 4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{5\\,100\\,480}{120} \\\\  & =42\\,504.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281240 :knowledge-point/_questions [{:knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66f776ad-dc76-571f-9fde-5bfc211b06e7" :answer/type {:db/ident :answer.type/math} :answer/value "604\\,800" :db/id #edb/ref 17592186281242} {:answer/id #uuid "d6b01038-7557-5fcb-96c4-39b1069df4fe" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186281243} {:answer/id #uuid "2179505d-ca3f-5415-b40f-e3854a8c18e2" :answer/type {:db/ident :answer.type/math} :answer/value "920" :db/id #edb/ref 17592186281244} {:answer/id #uuid "50c1a4c1-45c6-5538-96dd-9020d1e67ee3" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281245} {:answer/id #uuid "be9649d7-6604-5bd0-9d26-6463bf74792e" :answer/type {:db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186281246}] :answer-field/correct {:answer/id #uuid "50c1a4c1-45c6-5538-96dd-9020d1e67ee3" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281245} :answer-field/id #uuid "4ca03efc-e5aa-58c1-95ea-45ea8559657e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281241}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "aa12a98d-6c3e-5ae1-807d-141f830f3407" :question/math-academy-id "q-5569" :question/problem "Out of the ten contestants in an Olympic event, how many possible groups of $3$ medalists are there, regardless of which medal they win?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $10$ contestants, so $n=10.$ We want to select $3$ of those contestants for the medal positions, so we have $r=3.$\n\nTherefore, the number of different potential groups of medalists is\n\n$$\n\\begin{aligned}{}_{10}{C}_{3} & =\\frac{10!}{(10-3)!\\,3!} \\\\  & =\\frac{10!}{7!3!} \\\\  & =\\frac{10\\cdot 9\\cdot 8\\cdot \\cancel{7!}}{\\cancel{7!}3!} \\\\  & =\\frac{10\\cdot 9\\cdot 8}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{720}{6} \\\\  & =120.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281247 :knowledge-point/_questions [{:knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "412d424a-eee3-5e6b-9875-27c053c942c7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186281249} {:answer/id #uuid "f86f6632-e3b3-573b-bd4e-1af44e710e7f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186281250} {:answer/id #uuid "11aa48c7-f956-5c38-ac13-596e012f2064" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186281251} {:answer/id #uuid "130ffd1a-297a-5b04-8123-3f201bfc718b" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186281252} {:answer/id #uuid "56d90141-e561-5e1e-a612-04ee88be106d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186281253}] :answer-field/correct {:answer/id #uuid "f86f6632-e3b3-573b-bd4e-1af44e710e7f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186281250} :answer-field/id #uuid "11061a03-f613-5b52-b69f-6d33ab01b754" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281248}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "1131b9e8-079c-59fe-bb5c-f5a2e256cfe4" :question/math-academy-id "q-84964" :question/problem "Given any two points in a plane, there is a unique line that passes through both points. Given six points in a plane, what is the maximum number of unique  lines that can be made using these points?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $6$ points, so $n=6.$ We want to select $2$ of those points for each of the lines, so we have $r=2.$\n\nTherefore, the maximum number of unique lines is\n\n$$\n\\begin{aligned}{}_{6}{C}_{2} & =\\frac{6!}{(6-2)!\\,2!} \\\\  & =\\frac{6!}{4!2!} \\\\  & =\\frac{6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}2!} \\\\  & =\\frac{6\\cdot 5}{2\\cdot 1} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281254 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bc98428-b9e7-50be-a6c5-f1f6a36faafa" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186281256} {:answer/id #uuid "998aa5c8-dc10-5d7e-84d5-423849b458e4" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186281257} {:answer/id #uuid "514cc3dd-c6ce-52a9-a694-c9e9cd219644" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281258} {:answer/id #uuid "21b2213f-c7d2-5b73-bfd4-12cf39c2f13e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186281259} {:answer/id #uuid "0772aa4c-6758-5b8d-850e-92c9cb3c4d3d" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186281260}] :answer-field/correct {:answer/id #uuid "514cc3dd-c6ce-52a9-a694-c9e9cd219644" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281258} :answer-field/id #uuid "5fe796f8-ae3a-5ebf-bcf0-8529076d987b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281255}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "41565b4d-0c07-57fd-b5c2-148bbc70e440" :question/math-academy-id "q-84993" :question/problem "Evaluate $(\\frac{25}{0}).$" :question/worked-solution "First, note that $(\\frac{25}{0})$ means the same thing as ${}_{25}{C}_{0}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=25$ and $r=0,$ we get\n\n$$\n\\begin{aligned}{}_{25}{C}_{0} & =\\frac{25!}{(25-0)!0!} \\\\  & =\\frac{25!}{25!0!} \\\\  & =\\frac{\\cancel{25!}}{\\cancel{25!}\\cdot 1} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281261 :knowledge-point/_questions [{:knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756016cf-ce30-5a23-93e9-8a305346e57d" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186281263} {:answer/id #uuid "d2523b85-b7d9-5fb6-a66c-4adf8f1b05c0" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186281264} {:answer/id #uuid "cd205e5c-a931-517c-84fb-60f97f240d7c" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186281265} {:answer/id #uuid "476d2808-b4da-5d0b-8204-1cf87dd69eb5" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186281266} {:answer/id #uuid "47722f29-38e5-575f-86e9-fb9f10458e99" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186281267}] :answer-field/correct {:answer/id #uuid "d2523b85-b7d9-5fb6-a66c-4adf8f1b05c0" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186281264} :answer-field/id #uuid "c1553595-5f25-5b61-94d6-3996df994e8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281262}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87b1c27d-e9d7-59af-9d08-e33d51da2846" :question/math-academy-id "q-86823" :question/problem "There were $9$ chess players who took part in a chess tournament. How many games were played in the tournament if each player faced every other player exactly once?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ players, so $n=9.$ We want to select $2$ of those players for each of the matches, so we have $r=2.$\n\nTherefore, the number of games is\n\n$$\n\\begin{aligned}{}_{9}{C}_{2} & =\\frac{9!}{(9-2)!\\,2!} \\\\  & =\\frac{9!}{7!2!} \\\\  & =\\frac{9\\cdot 8\\cdot \\cancel{7!}}{\\cancel{7!}\\cdot 2!} \\\\  & =\\frac{9\\cdot 8}{2\\cdot 1} \\\\  & =\\frac{72}{2} \\\\  & =36.\\end{aligned}\n$$"}]}
