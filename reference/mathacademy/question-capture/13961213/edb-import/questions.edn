#{[{:db/id #edb/ref 17592186059372 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Special Angle"}] :question/id #uuid "30c02578-ab65-5cf0-9ec6-d57ab9264738" :question/math-academy-id "e-14743" :question/problem "The vector $\\mathbf{a}$ has magnitude $7$, the vector $\\mathbf{b}$ has magnitude $3$, and the angle between the vectors is $120^\\circ$ and $\\mathbf{n}$ is the unit vector that points in the direction of $\\mathbf{a} \\times \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$ in terms of $\\mathbf{n}$." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}a & \\cdot & b\\end{vmatrix}\\cdot \\sin θ \\cdot n \\\\\n&= 7 \\cdot 3 \\cdot \\sin 120^{∘} \\cdot n \\\\\n&= 7 \\cdot 3 \\cdot \\frac{\\sqrt{3}}{2} \\cdot n \\\\\n&= \\frac{21\\sqrt{3}}{2}n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059373 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/id #uuid "e62b1402-69c4-5773-9bbc-275643ee0d88" :question/math-academy-id "e-14744" :question/problem "The vector $\\mathbf{a}$ has magnitude $12$, the vector $\\mathbf{b}$ has magnitude $9$, the angle between the vectors is $105^\\circ$ and $\\mathbf{n}$ is the unit vector that points in the direction of $\\mathbf{a} \\times \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$ in terms of $\\mathbf{n}$. Give your answer to $2$ decimal places where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}a & \\cdot & b\\end{vmatrix}\\cdot \\sin θ \\cdot n \\\\\n&= 12 \\cdot 9 \\cdot \\sin 105^{∘} \\cdot n \\\\\n&\\approx 12 \\cdot 9 \\cdot 0.965926 \\cdot n \\\\\n&\\approx 104.32 \\cdot n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059374 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "82f31c6e-f9df-5e0a-88a4-a8ccfca00258" :knowledge-point/title "Calculating the Cross Product of Two Parallel Vectors"}] :question/id #uuid "06c10f42-c30a-599b-af86-8ae50dc4c500" :question/math-academy-id "e-14745" :question/problem "The vector $\\mathbf{a}$ has magnitude $4$, the vector $\\mathbf{b}$ has magnitude $6$, and $\\mathbf{a} \\parallel \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$." :question/worked-solution "Suppose $\\mathbf a$ and $\\mathbf b$ are nonzero vectors. Then,\n\n$$\n\\mathbf{a} \\times \\mathbf{b} = \\mathbf{0}\n$$\n\nif and only if $\\mathbf{a} \\parallel \\mathbf{b}$.\n\nTherefore,\n\n$$\n\\mathbf{a} \\times \\mathbf{b} = \\mathbf{0}\n$$"}] [{:db/id #edb/ref 17592186059966 :knowledge-point/_questions [{:knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d52716bb-01bc-5af1-974a-e19d940b6960" :answer/type {:db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186056516} {:answer/id #uuid "dcd52f19-9da8-5576-ac0c-74f6bdfabd46" :answer/type {:db/ident :answer.type/math} :answer/value "43n" :db/id #edb/ref 17592186056517} {:answer/id #uuid "fbbec658-7251-57c7-baee-0a9bdc2a1a88" :answer/type {:db/ident :answer.type/math} :answer/value "34n" :db/id #edb/ref 17592186056518} {:answer/id #uuid "456b75b4-63de-5aff-8f8a-7b893755f143" :answer/type {:db/ident :answer.type/math} :answer/value "36n" :db/id #edb/ref 17592186056519} {:answer/id #uuid "6badd128-9c5d-5afb-ad5e-4d353bfe7cca" :answer/type {:db/ident :answer.type/math} :answer/value "27n" :db/id #edb/ref 17592186056520}] :answer-field/correct {:answer/id #uuid "d52716bb-01bc-5af1-974a-e19d940b6960" :answer/type {:db/i