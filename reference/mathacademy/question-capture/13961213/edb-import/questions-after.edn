#{[{:db/id #edb/ref 17592186059372 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Special Angle"}] :question/id #uuid "30c02578-ab65-5cf0-9ec6-d57ab9264738" :question/math-academy-id "e-14743" :question/problem "The vector $\\mathbf{a}$ has magnitude $7$, the vector $\\mathbf{b}$ has magnitude $3$, and the angle between the vectors is $120^\\circ$ and $\\mathbf{n}$ is the unit vector that points in the direction of $\\mathbf{a} \\times \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$ in terms of $\\mathbf{n}$." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}a & \\cdot & b\\end{vmatrix}\\cdot \\sin θ \\cdot n \\\\\n&= 7 \\cdot 3 \\cdot \\sin 120^{∘} \\cdot n \\\\\n&= 7 \\cdot 3 \\cdot \\frac{\\sqrt{3}}{2} \\cdot n \\\\\n&= \\frac{21\\sqrt{3}}{2}n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059373 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/id #uuid "e62b1402-69c4-5773-9bbc-275643ee0d88" :question/math-academy-id "e-14744" :question/problem "The vector $\\mathbf{a}$ has magnitude $12$, the vector $\\mathbf{b}$ has magnitude $9$, the angle between the vectors is $105^\\circ$ and $\\mathbf{n}$ is the unit vector that points in the direction of $\\mathbf{a} \\times \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$ in terms of $\\mathbf{n}$. Give your answer to $2$ decimal places where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}a & \\cdot & b\\end{vmatrix}\\cdot \\sin θ \\cdot n \\\\\n&= 12 \\cdot 9 \\cdot \\sin 105^{∘} \\cdot n \\\\\n&\\approx 12 \\cdot 9 \\cdot 0.965926 \\cdot n \\\\\n&\\approx 104.32 \\cdot n\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059374 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "82f31c6e-f9df-5e0a-88a4-a8ccfca00258" :knowledge-point/title "Calculating the Cross Product of Two Parallel Vectors"}] :question/id #uuid "06c10f42-c30a-599b-af86-8ae50dc4c500" :question/math-academy-id "e-14745" :question/problem "The vector $\\mathbf{a}$ has magnitude $4$, the vector $\\mathbf{b}$ has magnitude $6$, and $\\mathbf{a} \\parallel \\mathbf{b}$. Find $\\mathbf{a} \\times \\mathbf{b}$." :question/worked-solution "Suppose $\\mathbf a$ and $\\mathbf b$ are nonzero vectors. Then,\n\n$$\n\\mathbf{a} \\times \\mathbf{b} = \\mathbf{0}\n$$\n\nif and only if $\\mathbf{a} \\parallel \\mathbf{b}$.\n\nTherefore,\n\n$$\n\\mathbf{a} \\times \\mathbf{b} = \\mathbf{0}\n$$"}] [{:db/id #edb/ref 17592186268097 :knowledge-point/_questions [{:knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30b83f41-8af3-5da2-b854-5ea7336224bc" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{2}n" :db/id #edb/ref 17592186268099} {:answer/id #uuid "5b026f9e-63d2-51ef-a0a0-bc5c2bcbd4c3" :answer/type {:db/ident :answer.type/math} :answer/value "18n" :db/id #edb/ref 17592186268100} {:answer/id #uuid "b20148cf-4ea7-526b-9ac8-b8d952eca6fd" :answer/type {:db/ident :answer.type/math} :answer/value "18\\sqrt{2}n" :db/id #edb/ref 17592186268101} {:answer/id #uuid "022577d3-fdd1-564a-b826-fc539f3cc0d1" :answer/type {:db/ident :answer.type/math} :answer/value "9n" :db/id #edb/ref 17592186268102} {:answer/id #uuid "9d4c55de-15f4-5366-85fb-353f2c766ff0" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{3}n" :db/id #edb/ref 17592186268103}] :answer-field/correct {:answer/id #uuid "30b83f41-8af3-5da2-b854-5ea7336224bc" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{2}n" :db/id #edb/ref 17592186268099} :answer-field/id #uuid "9ea0a8cc-3a5d-5477-a13f-1a1e32a8b81d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268098}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b962d585-84ff-56b9-8a99-552b0dc2f1ca" :question/math-academy-id "q-127834" :question/problem "The vector $a$ has magnitude $2$, the vector $b$ has magnitude $9$, the angle between $a$ and $b$ is ${45}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$" :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =2\\cdot 9\\cdot \\operatorname{sin}⁡{45}^{∘}\\cdot n \\\\  & =18\\cdot \\frac{\\sqrt{2}}{2}\\cdot n \\\\  & =9\\sqrt{2}n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268104 :knowledge-point/_questions [{:knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caad0e21-b914-5ce6-b160-7eedf7b23bc4" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{2}n" :db/id #edb/ref 17592186268106} {:answer/id #uuid "865122ac-d8bc-5fb1-a244-67516b6f5fb0" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{3}n" :db/id #edb/ref 17592186268107} {:answer/id #uuid "6ea16872-81a0-5997-8e46-f35d6e0909c3" :answer/type {:db/ident :answer.type/math} :answer/value "7n" :db/id #edb/ref 17592186268108} {:answer/id #uuid "05dde33e-7dbe-5184-851f-d6e82e573695" :answer/type {:db/ident :answer.type/math} :answer/value "14n" :db/id #edb/ref 17592186268109} {:answer/id #uuid "31846626-47f5-5cc2-8b93-ef1dc7cad74e" :answer/type {:db/ident :answer.type