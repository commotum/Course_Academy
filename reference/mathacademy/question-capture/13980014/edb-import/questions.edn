#{[{:db/id #edb/ref 17592186063981 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/id #uuid "e2c444fd-31b5-505f-844d-313f9efb7f45" :question/math-academy-id "e-409" :question/problem "Evaluate $\\displaystyle\\int_0^4 x \\, \\textrm d x$." :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{4}xdx &= \\left.\\frac{x^{1 + 1}}{1 + 1}\\right|_{0}^{4} \\\\\n&= \\left.\\frac{x^{2}}{2}\\right|_{0}^{4} \\\\\n&= \\frac{4^{2}}{2} - \\frac{0^{2}}{2} \\\\\n&= \\frac{16}{2} \\\\\n&= 8\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063982 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/id #uuid "e0bb9783-9d30-5139-a2c0-aae55ea18733" :question/math-academy-id "e-410" :question/problem "Evaluate $\\displaystyle \\int _{1}^2\\dfrac 1 {x^3}\\, \\textrm d x$." :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{1}^{2}\\frac{1}{x^{3}}dx &= \\int_{1}^{2}x^{-3}dx \\\\\n&= \\left.\\frac{x^{-3 + 1}}{-3 + 1}\\right|_{1}^{2} \\\\\n&= \\left.- \\frac{x^{-2}}{2}\\right|_{1}^{2} \\\\\n&=-\\frac{1}{2}(2^{-2} - 1^{-2}) \\\\\n&=-\\frac{1}{2}(\\frac{1}{4} - 1) \\\\\n&=-\\frac{1}{2}(-\\frac{3}{4}) \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063983 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/id #uuid "77d37915-81e0-5415-8377-a3aae532e1f2" :question/math-academy-id "e-411" :question/problem "Calculate $\\displaystyle\\int_1^4\\sqrt x\\, \\textrm d x$." :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{1}^{4}\\sqrt{x}dx &= \\int_{1}^{4}x^{1/2}dx \\\\\n&= \\left.\\frac{2}{3}x^{3/2}\\right|_{1}^{4} \\\\\n&= \\frac{2}{3}(4^{3/2} - 1^{3/2}) \\\\\n&= \\frac{2}{3}(\\sqrt{64} - 1) \\\\\n&= \\frac{2}{3}(8 - 1) \\\\\n&= \\frac{14}{3}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064632 :knowledge-point/_questions [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3ee6a85-8625-5e3d-a81d-d10ef7788c08" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186062304} {:answer/id #uuid "f692ac11-a1e7-50f6-8601-85cde9b11626" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186062305} {:answer/id #uuid "36c6e4df-28dd-533b-ab52-58dce2e04fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{189}{2}" :db/id #edb/ref 17592186062306} {:answer/id #uuid "40eef81b-0960-52f4-9886-384ec0dafade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186062307} {:answer/id #uuid "7ad1c004-4f33-5d8f-9480-7b16d02b54e5" :answer/type {:db/ident :answer.type/math} :answer/value "189" :db/id #edb/ref 17592186062308}] :answer-field/correct {:answer/id #uuid "b3ee6a85-8625-5e3d-a81d-d10ef7788c08" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186062304} :answer-field/id #uuid "601ec15c-1ad0-51ed-96bd-618a5b8ce1bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062303}] :question/id #uuid "1ea9ad4a-c4e1-5eef-bc95-8f5cd98ebf22" :question/math-academy-id "q-29744" :question/problem "Evaluate $\\displaystyle \\int_{-5}^{4}x^{2}dx$."}] [{:db/id #edb/ref 17592186064770 :knowledge-point