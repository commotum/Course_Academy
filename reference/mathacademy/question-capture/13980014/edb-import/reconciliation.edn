16}{x}^{-2/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-2/3+1}}{(-\\frac{2}{3}+1)}{|}_{1}^{16} \\\\  & =3\\,{x}^{1/3}{|}_{1}^{16} \\\\  & =3\\,\\sqrt[3]{x}{|}_{1}^{16} \\\\  & =3(\\sqrt[3]{16}-\\sqrt[3]{1}) \\\\  & =3(2\\sqrt[3]{2}-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344503" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-344503" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344503" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\cdot16^{1/3}-3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344299" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344299" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{16}{x}^{3/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/4+1}}{\\frac{3}{4}+1}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{x}^{7/4}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{(\\sqrt[4]{x})}^{7}{|}_{1}^{16} \\\\  & =\\frac{4}{7}({(\\sqrt[4]{16})}^{7}-{(\\sqrt[4]{1})}^{7}) \\\\  & =\\frac{4}{7}({2}^{7}-{1}^{7}) \\\\  & =\\frac{4}{7}(128-1) \\\\  & =\\frac{508}{7}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344299" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-344299" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344299" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{508}{7}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344298" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344298" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{32}{x}^{3/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/5+1}}{(\\frac{3}{5}+1)}{|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,{x}^{8/5}|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,(\\sqrt[5]{x})^{8}|}_{1}^{32} \\\\  & =\\frac{5}{8}\\,((\\sqrt[5]{32})^{8}-(\\sqrt[5]{1})^{8}) \\\\  & =\\frac{5}{8}\\,({2}^{8}-{1}^{8}) \\\\  & =\\frac{5}{8}(256-1) \\\\  & =\\frac{1275}{8}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344298" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-344298" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-344298" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1275}{8}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29673" "field" nil "attribute" "question/problem" "value" "${\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29673" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}{x}^{-3/2}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}\\cdot \\frac{1}{{(\\sqrt{x})}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}(\\frac{1}{(\\sqrt{2})^{3}}-\\frac{1}{(\\sqrt{1})^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}}{4}-1) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}-4}{4}) \\\\  & =\\frac{4-\\sqrt{2}}{6}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29673" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-29673" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29673" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{4+\\sqrt{2}}{6}"] ["math" "\\frac{2+\\sqrt{2}}{3}"] ["math" "\\frac{4+\\sqrt{2}}{6}"] ["ma