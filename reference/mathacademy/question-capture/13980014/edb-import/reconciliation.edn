uestion-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-29674" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29674" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3+\\sqrt[3]{3}"] ["math" "3+\\sqrt[3]{9}"] ["math" "3+\\sqrt{9}"] ["math" "3-\\sqrt[3]{9}"] ["math" "3-\\sqrt{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29674" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3-\\sqrt[3]{9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "e-409" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle\\int_0^4 x \\, \\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-409.json" "file_sha256" "19d519ad535bc9a8469cc390c9e942bfe1a86803d9ed5dd0726ffc9def450eca"} {"question" "e-409" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}x\\,\\text{d}x & =\\frac{{x}^{1+1}}{1+1}{|}_{0}^{4} \\\\  & =\\frac{{x}^{2}}{2}{|}_{0}^{4} \\\\  & =\\frac{{4}^{2}}{2}-\\frac{{0}^{2}}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-409.json" "file_sha256" "19d519ad535bc9a8469cc390c9e942bfe1a86803d9ed5dd0726ffc9def450eca"} {"question" "e-410" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int _{1}^2\\dfrac 1 {x^3}\\, \\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-410.json" "file_sha256" "0cad8e2e275402e287cac3738acf8d615102b8ee697e19e2be01bcf9319ae7f1"} {"question" "e-410" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{2} \\\\  & =-\\frac{{x}^{-2}}{2}{|}_{1}^{2} \\\\  & =-\\frac{1}{2}({2}^{-2}-{1}^{-2}) \\\\  & =-\\frac{1}{2}(\\frac{1}{4}-1) \\\\  & =-\\frac{1}{2}(-\\frac{3}{4}) \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-410.json" "file_sha256" "0cad8e2e275402e287cac3738acf8d615102b8ee697e19e2be01bcf9319ae7f1"} {"question" "e-411" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle\\int_1^4\\sqrt x\\, \\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-411.json" "file_sha256" "234a75eb07e62e9c95c4f2014741d3989c0f084731409c715266322677779304"} {"question" "e-411" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x & ={\\int }_{1}^{4}{x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3/2}{|}_{1}^{4} \\\\  & =\\frac{2}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{2}{3}(\\sqrt{64}-1) \\\\  & =\\frac{2}{3}(8-1) \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/example-411.json" "file_sha256" "234a75eb07e62e9c95c4f2014741d3989c0f084731409c715266322677779304"}] "usage" {"q-49224" [] "e-410" [] "e-409" [] "e-411" [] "q-29744" []} "basis" 861 "retractions" [[17592186064632 :question/problem "Evaluate $\\displaystyle \\int_{-5}^{4}x^{2}dx$."] [17592186064770 :question/problem "Evaluate $\\displaystyle \\int_{1/2}^{1}\\frac{1}{x^{6}}dx$."] [17592186063981 :question/problem "Evaluate $\\displaystyle\\int_0^4 x \\, \\textrm d x$."] [17592186063981 :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{4}xdx &= \\left.\\frac{x^{1 + 1}}{1 + 1}\\right|_{0}^{4} \\\\\n&= \\left.\\frac{x^{2}}{2}\\right|_{0}^{4} \\\\\n&= \\frac{4^{2}}{2} - \\frac{0^{2}}{2} \\\\\n&= \\frac{16}{2} \\\\\n&= 8\n\\end{aligned}\n$$"] [17592186063982 :question/problem "Evaluate $\\displaystyle \\int _{1}^2\\dfrac 1 {x^3}\\, \\textrm d x$."] [17592186063982 :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{1}^{2}\\frac{1}{x^{3}}dx &= \\int_{1}^{2}x^{-3}dx \\\\\n&= \\left.\\frac{x^{-3 + 1}}{-3 + 1}\\right|_{1}^{2} \\\\\n&= \\left.- \\frac{x^{-2}}{2}\\right|_{1}^{2} \\\\\n&=-\\frac{1}{2}(2^{-2} - 1^{-2}) \\\\\n&=-\\frac{1}{2}(\\frac{1}{4} - 1) \\\\\n&=-\\frac{1}{2}(-\\frac{3}{4}) \\\\\n&= \\frac{3}{8}\n\\end{aligned}\n$$"] [17592186063983 :question/problem "Calculate $\\displaystyle\\int_1^4\\sqrt x\\, \\textrm d x$."] [17592186063983 :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{1}^{4}\\sqrt{x}dx &= \\int_{1}^{4}x^{1/2}dx \\\\\n&= \\left.\\frac{2}{3}x^{3/2}\\right|_{1}^{4} \\\\\n&= \\frac{2}{3}(4^{3/2} - 1^{3/2}) \\\\\n&= \\frac{2}{3}(\\sqrt{64} - 1) \\\\\n&= \\frac{2}{3}(8 - 1) \\\\\n&= \\frac{14}{3}\n\\end{aligned}\n$$"]] "immutable_answers" [17592186062304 17592186062305 17592186062306 17592186062307 17592186062308 17592186063131 17592186063132 17592186063133 17592186063134 17592186063135] "immutable_fields" [[17592186062303 :answer-field/correct] [17592186062303 :answer-field/id] [17592186062303 :answer-field/key] [17592186062303 :answer-field/type] [17592186063130 :answer-field/correct] [17592186063130 :answer-field/id] [17592186063130 :answer-field/key] [17592186063130 :answer-field/type]] "no_history" []}
