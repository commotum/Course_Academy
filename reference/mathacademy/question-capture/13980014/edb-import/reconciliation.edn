ac{1}{4}(1-\\frac{1}{16}) \\\\  & =-\\frac{15}{64}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-49223" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-49223" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-49223" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{15}{16}"] ["math" "-\\frac{15}{64}"] ["math" "-\\frac{3}{64}"] ["math" "\\frac{15}{16}"] ["math" "\\frac{3}{16}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-49223" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{15}{64}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-315985" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-315985" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{3} \\\\  & =\\frac{{x}^{-2}}{-2}{|}_{1}^{3} \\\\  & =-\\frac{1}{2{x}^{2}}{|}_{1}^{3} \\\\  & =-(\\frac{1}{2\\cdot {3}^{2}}-\\frac{1}{2\\cdot {1}^{2}}) \\\\  & =-(\\frac{1}{18}-\\frac{1}{2}) \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-315985" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/activity-metadata.json" "file_sha256" "03dc4d175c441b1099af84749b5eb4d481e341a5319491c10156f1faeab456bf"} {"question" "q-315985" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-315985" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{9}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980014/state.json" "file_sha256" "8616e39dc450504236a8b37620d6606c4d4fe05df4f245732ece76f6d715ce83"} {"question" "q-29747" "field" nil "attribute" "question/problem" "value" "${\\int }_{1}^{2}{x}^{-4}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/matha