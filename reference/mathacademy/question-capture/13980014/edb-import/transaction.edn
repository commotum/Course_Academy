/value "-\\frac{15}{64}" :db/ensure [:answer/validate]} {:db/id "q-49223/selection/2acfecf2e47fbe5d32b2e28aa95c25e3f8f1cc2383d692418626a8d6141d5353" :answer/id #uuid "cc228a09-9b79-59e9-9181-a4b1b0756ceb" :answer/type :answer.type/math :answer/value "-\\frac{3}{64}" :db/ensure [:answer/validate]} {:db/id "q-49223/selection/98f791340c916b43a1328b669bca9d56282fc10a4e8dbe2b87582fcbae4cd6e9" :answer/id #uuid "51d3ecc8-39a5-5f99-b024-4461675cb5e5" :answer/type :answer.type/math :answer/value "-\\frac{15}{16}" :db/ensure [:answer/validate]} {:db/id "q-49223/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer/id #uuid "b4c3e3c5-5e07-53ea-bc2c-8fa9b6a87b39" :answer/type :answer.type/math :answer/value "\\frac{3}{16}" :db/ensure [:answer/validate]} {:db/id "q-49223/selection" :answer-field/id #uuid "c74d040a-cc18-564f-a6f5-03f59dc94f87" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49223/selection/253b1e944b386d92797a89ee8ac619d0fe37a9e9f3caaa6e7023a91ab6f99382" :answer-field/choices ["q-49223/selection/43b49f942053318d4da6be2ff054765229c5ed3de5448117844cfdcb87dc6392" "q-49223/selection/253b1e944b386d92797a89ee8ac619d0fe37a9e9f3caaa6e7023a91ab6f99382" "q-49223/selection/2acfecf2e47fbe5d32b2e28aa95c25e3f8f1cc2383d692418626a8d6141d5353" "q-49223/selection/98f791340c916b43a1328b669bca9d56282fc10a4e8dbe2b87582fcbae4cd6e9" "q-49223/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0"] :db/ensure [:answer-field/validate]} {:db/id "q-49223" :question/id #uuid "6dd64fec-bea3-5380-a5c0-a7e62cccb7af" :question/math-academy-id "q-49223" :question/problem "Evaluate ${\\int }_{-2}^{-1}\\frac{1}{{x}^{5}}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{-1}\\frac{1}{{x}^{5}}\\,\\text{d}x & ={\\int }_{-2}^{-1}{x}^{-5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5+1}}{-5+1}{|}_{-2}^{-1} \\\\  & =\\frac{{x}^{-4}}{(-4)}{|}_{-2}^{-1} \\\\  & =-\\frac{1}{4{x}^{4}}{|}_{-2}^{-1} \\\\  & =-\\frac{1}{4}(\\frac{1}{(-1)^{4}}-\\frac{1}{(-2)^{4}}) \\\\  & =-\\frac{1}{4}(1-\\frac{1}{16}) \\\\  & =-\\frac{15}{64}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66"] :knowledge-point/questions ["q-49223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315985/field-1/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" :answer/id #uuid "6b750098-4529-5688-a5d4-df506f01b8d7" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "q-315985/field-1/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" :answer/id #uuid "6e88268c-1303-5339-a088-73735e06f05a" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "q-315985/field-1" :answer-field/id #uuid "82aaa0f5-0246-5948-84c6-f378f0be024a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315985/field-1/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" :answer-field/choices ["q-315985/field-1/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" "q-315985/field-1/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0"] :db/ensure [:answer-field/validate]} {:db/id "q-315985" :question/id #uuid "cd35637b-29da-56f2-b1f6-a6ade037cf18" :question/math-academy-id "q-315985" :question/problem "Evaluate ${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{3} \\\\  & =\\frac{{x}^{-2}}{-2}{|}_{1}^{3} \\\\  & =-\\frac{1}{2{x}^{2}}{|}_{1}^{3} \\\\  & =-(\\frac{1}{2\\cdot {3}^{2}}-\\frac{1}{2\\cdot {1}^{2}}) \\\\  & =-(\\frac{1}{18}-\\frac{1}{2}) \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-315985/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66"] :knowledge-point/questions ["q-315985"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29747/selection/8e9f70c552776e9d1487da20a755f135a8ad337fc94e3958854abfc7a78f3bc1" :answer/id #uuid "826db9eb-c663-5c94-892c-d2fca1fbd5bf" :answer/type :answer.type/math :answer/value "\\frac{7}{24}" :db/ensure [:answer/validate]} {:db/id "q-29747/selection/afacdf28d6e51caaf3a1443cbc7316493b65fb09f9e96bbb3169794752a8fcf3" :answer/id #uuid "a28e64ff-8b4c-573a-8478-7bd4af45bf94" :answer/type :answer.type/math :answer/value "\\frac{9}{24}" :db/ensure [:answer/validate]} {:db/id "q-29747/selection/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5" :answer/id #uuid "80e9ad0a-766d-59e8-a37b-1efc2dd03dd4" :answer/type :answer.type/math :answer/value "\\frac{1}{24}" :db/ensure [:answer/validate]} {:db/id "q-29747/selection/d56ec3d64787a5a7936c12874c68bffd29d16b473edba19520b68cdb062ec5e4" :answer/id #uuid "0a767da6-8583-55b3-9464-7feec3a892fe" :answer/type :answer.type/math :answer/value "-\\frac{7}{24}" :db/ensure [:answer/validate]} {:db/id "q-29747/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "d5085563-7b9f-5cdb-af3b-0f48708b7de2" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-29747/selection" :answer-field/id #uuid "ed1dd774-7d8d-5e3c-bbfd-d1139c97209f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29747/selection/8e9f70c552776e9d1487da20a755f135a8ad337fc94e3958854abfc7a78f3bc1" :answer-field/choices ["q-29747/selection/8e9f7