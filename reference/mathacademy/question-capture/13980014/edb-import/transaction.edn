rac{125}{3} \\\\  & =63.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-73237/selection/dcaa8650da9bcf9c51712a8d7840b86177d42fd2543a577132e5c50078511fa2" :answer/id #uuid "a6b23832-fc6e-53cf-890c-ed27dea1dc0d" :answer/type :answer.type/math :answer/value "-\\frac{21}{2}" :db/ensure [:answer/validate]} {:db/id "q-73237/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "1dfb5705-bcc2-56ac-a128-24ee700f141b" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-73237/selection/f4f7e304b38327904d9fdebbac3479cccadb547b1c29d7b8e5938e7012f9d65b" :answer/id #uuid "19b1f8fd-70b9-5dad-9ae2-8716ec4f42fb" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "q-73237/selection/819af61dbc4adb63670a725bce6c01bf5e6b9342de5b40c6e52ffed1eeaa4967" :answer/id #uuid "131ca314-98fc-53d3-9a29-b621b6b0255a" :answer/type :answer.type/math :answer/value "\\frac{21}{3}" :db/ensure [:answer/validate]} {:db/id "q-73237/selection/9860c81dec2749ad7f4f01ebad244d76c4826b25ad839b2a08d0655209609a82" :answer/id #uuid "f189bbf9-1f5a-510b-99c7-3eb16bc857b3" :answer/type :answer.type/math :answer/value "-\\frac{21}{6}" :db/ensure [:answer/validate]} {:db/id "q-73237/selection" :answer-field/id #uuid "b9e40960-a5be-5c50-bc3a-a66d9a36f092" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73237/selection/dcaa8650da9bcf9c51712a8d7840b86177d42fd2543a577132e5c50078511fa2" :answer-field/choices ["q-73237/selection/dcaa8650da9bcf9c51712a8d7840b86177d42fd2543a577132e5c50078511fa2" "q-73237/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" "q-73237/selection/f4f7e304b38327904d9fdebbac3479cccadb547b1c29d7b8e5938e7012f9d65b" "q-73237/selection/819af61dbc4adb63670a725bce6c01bf5e6b9342de5b40c6e52ffed1eeaa4967" "q-73237/selection/9860c81dec2749ad7f4f01ebad244d76c4826