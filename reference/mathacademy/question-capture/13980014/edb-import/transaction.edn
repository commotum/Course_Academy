ion/answer-fields ["q-113989/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66"] :knowledge-point/questions ["q-113989"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49224"] :question/problem "Evaluate ${\\int }_{1/2}^{1}\\frac{1}{{x}^{6}}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{1}\\frac{1}{{x}^{6}}\\,\\text{d}x & ={\\int }_{1/2}^{1}{x}^{-6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6+1}}{-6+1}{|}_{1/2}^{1} \\\\  & =\\frac{{x}^{-5}}{(-5)}{|}_{1/2}^{1} \\\\  & =-\\frac{1}{5{x}^{5}}{|}_{1/2}^{1} \\\\  & =-\\frac{1}{5}(\\frac{1}{{1}^{5}}-\\frac{1}{{(1/2)}^{5}}) \\\\  & =-\\frac{1}{5}(1-{2}^{5}) \\\\  & =-\\frac{1}{5}(1-32) \\\\  & =\\frac{31}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-344503/field-1/e53df48a07180718d67872e2c9b658b473019794b06237fead4bd8f43679faf5" :answer/id #uuid "4af1a8ec-e89b-5b7f-b77b-a70374086376" :answer/type :answer.type/math :answer/value "3\\cdot16^{1/3}-3" :db/ensure [:answer/validate]} {:db/id "q-344503/field-1" :answer-field/id #uuid "9f1d98bb-779a-5073-b7b4-ea11e192176a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-344503/field-1/e53df48a07180718d67872e2c9b658b473019794b06237fead4bd8f43679faf5" :answer-field/choices ["q-344503/field-1/e53df48a07180718d67872e2c9b658b473019794b06237fead4bd8f43679faf5"] :db/ensure [:answer-field/validate]} {:db/id "q-344503" :question/id #uuid "bb4bd905-cb04-5684-9b8d-ccabcaa7be6a" :question/math-academy-id "q-344503" :question/problem "Evaluate ${\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x & ={\\int }_{1}^{16}{x}^{-2/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-2/3+1}}{(-\\frac{2}{3}+1)}{|}_{1}^{16} \\\\  & =3\\,{x}^{1/3}{|}_{1}^{16} \\\\  & =3\\,\\sqrt[3]{x}{|}_{1}^{16} \\\\  & =3(\\sqrt[3]{16}-\\sqrt[3]{1}) \\\\  & =3(2\\sqrt[3]{2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-344503/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5"] :knowledge-point/questions ["q-344503"] :db/ensure [:knowledge-point/validate]} {:db/id "q-344299/field-1/fb27f3251da7426c43c6d90d627a3e6f189ad8353684e98e7608c11d398b3221" :answer/id #uuid "71a1ebe6-bfa3-5c44-b8d3-88b7747b21af" :answer/type :answer.type/math :answer/value "\\frac{508}{7}" :db/ensure [:answer/validate]} {:db/id "q-344299/field-1/cef7878b02c6aaf56cb398e4d3d85795886d96eaffcc4ff58e08570db5f32762" :answer/id #uuid "c331ddf9-26b4-5d24-8b4f-ef03b754057a" :answer/type :answer.type/math :answer/value "\\frac{512}{7}" :db/ensure [:answer/validate]} {:db/id "q-344299/field-1" :answer-field/id #uuid "645959fe-e85a-5e93-839d-d186ce3518f8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-344299/field-1/fb27f3251da7426c43c6d90d627a3e6f189ad8353684e98e7608c11d398b3221" :answer-field/choices ["q-344299/field-1/fb27f3251da7426c43c6d90d627a3e6f189ad8353684e98e7608c11d398b3221" "q-344299/field-1/cef7878b02c6aaf56cb398e4d3d85795886d96eaffcc4ff58e08570db5f32762"] :db/ensure [:answer-field/validate]} {:db/id "q-344299" :question/id #uuid "2cfc140b-4f50-54bd-8766-4f51157714ea" :question/math-academy-id "q-344299" :question/problem "Evaluate ${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{16}{x}^{3/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/4+1}}{\\frac{3}{4}+1}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{x}^{7/4}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{(\\sqrt[4]{x})}^{7}{|}_{1}^{16} \\\\  & =\\frac{4}{7}({(\\sqrt[4]{16})}^{7}-{(\\sqrt[4]{1})}^{7}) \\\\  & =\\frac{4}{7}({2}^{7}-{1}^{7}) \\\\  & =\\frac{4}{7}(128-1) \\\\  & =\\frac{508}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-344299/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5"] :knowledge-point/questions ["q-344299"] :db/ensure [:knowledge-point/validate]} {:db/id "q-344298/field-1/854716f0bd623ea0cb3392565f4f7bbf1e7b81a3f7f273dcf99d1ae1f1c3ee7b" :answer/id #uuid "2bdd30cd-02b3-5525-805b-3bd08e26584d" :answer/type :answer.type/math :answer/value "\\frac{1275}{8}" :db/ensure [:answer/validate]} {:db/id "q-344298/field-1" :answer-field/id #uuid "5291488c-3a2f-5abf-8c0a-7646819ae182" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-344298/field-1/854716f0bd623ea0cb3392565f4f7bbf1e7b81a3f7f273dcf99d1ae1f1c3ee7b" :answer-field/choices ["q-344298/field-1/854716f0bd623ea0cb3392565f4f7bbf1e7b81a3f7f273dcf99d1ae1f1c3ee7b"] :db/ensure [:answer-field/validate]} {:db/id "q-344298" :question/id #uuid "ab106e83-f311-5981-aa43-2f775aae248c" :question/math-academy-id "q-344298" :question/problem "Evaluate ${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{32}{x}^{3/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/5+1}}{(\\frac{3}{5}+1)}{|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,{x}^{8/5}|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,(\\sqrt[5]{x})^{8}|}_{1}^{32} \\\\  & =\\frac{5}{8}\\,((\\sqrt[5]{32})^{8}-(\\sqrt[5]{1})^{8}) \\\\  & =\\frac{5}{8}\\,({2}^{8}-{1}^{8}) \\\\  & =\\frac{5}{8}(256-1) \\\\  & =\\frac{1275}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-344298/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5"] :knowledge-point/questions ["q-344298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29673/selection/98db73e861524f3c8bfe52dbd6091d6731110f5ea57a1405768a40237d1f115a" :answer/id #uuid "0998ef2d-1481-53c5-a4c2-a267e1a941a7" :answer/type :answer.type/math :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/ensure [:answer/validate]} {:db/id "q-29673/selection/76e818f66bb6eb3d34037efe89ddf55298e68233e7f134945f2df0accebfd6c1" :answer/id #uuid "ae2e8f94-10ea-5fb8-a84d-e393d82de9f6" :answer/type :answer.type/math :answer/value "\\frac{2+\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-29673/selection/c44f6fdbb73fb731319abf116150d4fcf885301b9da0d2a0350c9fec467bb706" :answer/id #uuid "44ac7df7-9772-5680-8da0-729ce2e395c4" :answer/type :answer.type/math :answer/value "\\frac{4+\\sqrt{2}}{6}" :db/ensure [:answer/validate]} {:db/id "q-29673/selection/b2193417f3116185817803a9d9d5e3e34a27a8b0bab5b5bc720e16bdd5747e9b" :answer/id #uuid "659a8985-d7a5-58ea-9309-f8b170cc1db9" :answer/type :answer.type/math :answer/value "-\\frac{4+\\sqrt{2}}{6}" :db/ensure [:answer/validate]} {:db/id "q-29673/selection/c843f3e0bef60f19365ffe0477b471196b08ba8ea4b52b44d29d1a810ca6fe9c" :answer/id #uuid "e854b7e0-f636-507e-8f2f-8a33501dbdb9" :answer/type :answer.type/math :answer/value "\\frac{4-\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-29673/selection" :answer-field/id #uuid "0bda045f-6630-5473-b67f-17a8da845142" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29673/selection/98db73e861524f3c8bfe52dbd6091d6731110f5ea57a1405768a40237d1f115a" :answer-field/choices ["q-29673/selection/98db73e861524f3c8bfe52dbd6091d6731110f5ea57a1405768a40237d1f115a" "q-29673/selection/76e818f66bb6eb3d34037efe89ddf55298e68233e7f134945f2df0accebfd6c1" "q-29673/selection/c44f6fdbb73fb731319abf116150d4fcf885301b9da0d2a0350c9fec467bb706" "q-29673/selection/b2193417f3116185817803a9d9d5e3e34a27a8b0bab5b5bc720e16bdd5747e9b" "q-29673/selection/c843f3e0bef60f19365ffe0477b471196b08ba8ea4b52b44d29d1a810ca6fe9c"] :db/ensure [:answer-field/validate]} {:db/id "q-29673" :question/id #uuid "09646823-4a24-5c27-91b9-a4004a9c6346" :question/math-academy-id "q-29673" :question/problem "${\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}{x}^{-3/2}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}\\cdot \\frac{1}{{(\\sqrt{x})}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}(\\frac{1}{(\\sqrt{2})^{3}}-\\frac{1}{(\\sqrt{1})^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}}{4}-1) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}-4}{4}) \\\\  & =\\frac{4-\\sqrt{2}}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-29673/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5"] :knowledge-point/questions ["q-29673"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29674/selection/ba0a3ea0fd666eea481073d63b15361f5418d1df236e6d8a0ebc6a74f2f228d8" :answer/id #uuid "cb16aa13-fda3-57af-aacb-43f6c3ec3aa8" :answer/type :answer.type/math :answer/value "3+\\sqrt[3]{3}" :db/ensure [:answer/validate]} {:db/id "q-29674/selection/409c5e2a477ec7c0d1a05c4ced3eacee4505d4b64fe3306d72b4676f01756e66" :answer/id #uuid "a100b12a-ee33-5650-85ef-5acab85d9417" :answer/type :answer.type/math :answer/value "3-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-29674/selection/2cd94be30ebd68316dd0717f1bbe5378566cf6336442a39feb9489eb5139f867" :answer/id #uuid "a1ddf5ee-5a21-5f48-aecf-d0ccb58eef60" :answer/type :answer.type/math :answer/value "3+\\sqrt{9}" :db/ensure [:answer/validate]} {:db/id "q-29674/selection/45774acae2d575efd723c81c41e1e105322085dd6479dba27a0f72f4b23257fb" :answer/id #uuid "bd7106b9-5695-5056-b579-31a745556e19" :answer/type :answer.type/math :answer/value "3-\\sqrt[3]{9}" :db/ensure [:answer/validate]} {:db/id "q-29674/selection/dfa9621944270264b17170ee917d7d534af487afe1db9757da8a34dbd568c2c4" :answer/id #uuid "8bd3f283-0b38-5094-98d4-cbf8b1b910ca" :answer/type :answer.type/math :answer/value "3+\\sqrt[3]{9}" :db/ensure [:answer/validate]} {:db/id "q-29674/selection" :answer-field/id #uuid "d50d707d-ffed-51e4-af16-09a47209dadf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29674/selection/45774acae2d575efd723c81c41e1e105322085dd6479dba27a0f72f4b23257fb" :answer-field/choices ["q-29674/selection/ba0a3ea0fd666eea481073d63b15361f5418d1df236e6d8a0ebc6a74f2f228d8" "q-29674/selection/409c5e2a477ec7c0d1a05c4ced3eacee4505d4b64fe3306d72b4676f01756e66" "q-29674/selection/2cd94be30ebd68316dd0717f1bbe5378566cf6336442a39feb9489eb5139f867" "q-29674/selection/45774acae2d575efd723c81c41e1e105322085dd6479dba27a0f72f4b23257fb" "q-29674/selection/dfa9621944270264b17170ee917d7d534af487afe1db9757da8a34dbd568c2c4"] :db/ensure [:answer-field/validate]} {:db/id "q-29674" :question/id #uuid "687d360e-6b55-5364-9883-46bab70fd288" :question/math-academy-id "q-29674" :question/problem "Evaluate ${\\int }_{1}^{3}\\frac{1}{\\sqrt[3]{{x}^{4}}}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{1}{\\sqrt[3]{{x}^{4}}}\\,\\text{d}x & ={\\int }_{1}^{3}{x}^{-4/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{-\\frac{4}{3}+1}{|}_{1}^{3} \\\\  & =-3{x}^{-1/3}{|}_{1}^{3} \\\\  & =-3\\cdot \\frac{1}{\\sqrt[3]{x}}{|}_{1}^{3} \\\\  & =-3(\\frac{1}{\\sqrt[3]{3}}-\\frac{1}{\\sqrt[3]{1}}) \\\\  & =3(1-\\frac{1}{\\sqrt[3]{3}}) \\\\  & =3-\\frac{3}{\\sqrt[3]{3}} \\\\  & =3-\\sqrt[3]{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-29674/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5"] :knowledge-point/questions ["q-29674"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-409"] :question/problem "Evaluate $\\displaystyle\\int_0^4 x \\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}x\\,\\text{d}x & =\\frac{{x}^{1+1}}{1+1}{|}_{0}^{4} \\\\  & =\\frac{{x}^{2}}{2}{|}_{0}^{4} \\\\  & =\\frac{{4}^{2}}{2}-\\frac{{0}^{2}}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-410"] :question/problem "Evaluate $\\displaystyle \\int _{1}^2\\dfrac 1 {x^3}\\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{2} \\\\  & =-\\frac{{x}^{-2}}{2}{|}_{1}^{2} \\\\  & =-\\frac{1}{2}({2}^{-2}-{1}^{-2}) \\\\  & =-\\frac{1}{2}(\\frac{1}{4}-1) \\\\  & =-\\frac{1}{2}(-\\frac{3}{4}) \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-411"] :question/problem "Calculate $\\displaystyle\\int_1^4\\sqrt x\\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x & ={\\int }_{1}^{4}{x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3/2}{|}_{1}^{4} \\\\  & =\\frac{2}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{2}{3}(\\sqrt{64}-1) \\\\  & =\\frac{2}{3}(8-1) \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
