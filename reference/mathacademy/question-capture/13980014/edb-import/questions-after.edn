#{[{:db/id #edb/ref 17592186063981 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/id #uuid "e2c444fd-31b5-505f-844d-313f9efb7f45" :question/math-academy-id "e-409" :question/problem "Evaluate $\\displaystyle\\int_0^4 x \\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}x\\,\\text{d}x & =\\frac{{x}^{1+1}}{1+1}{|}_{0}^{4} \\\\  & =\\frac{{x}^{2}}{2}{|}_{0}^{4} \\\\  & =\\frac{{4}^{2}}{2}-\\frac{{0}^{2}}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063982 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/id #uuid "e0bb9783-9d30-5139-a2c0-aae55ea18733" :question/math-academy-id "e-410" :question/problem "Evaluate $\\displaystyle \\int _{1}^2\\dfrac 1 {x^3}\\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{2} \\\\  & =-\\frac{{x}^{-2}}{2}{|}_{1}^{2} \\\\  & =-\\frac{1}{2}({2}^{-2}-{1}^{-2}) \\\\  & =-\\frac{1}{2}(\\frac{1}{4}-1) \\\\  & =-\\frac{1}{2}(-\\frac{3}{4}) \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063983 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/id #uuid "77d37915-81e0-5415-8377-a3aae532e1f2" :question/math-academy-id "e-411" :question/problem "Calculate $\\displaystyle\\int_1^4\\sqrt x\\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x & ={\\int }_{1}^{4}{x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3/2}{|}_{1}^{4} \\\\  & =\\frac{2}{3}({4}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{2}{3}(\\sqrt{64}-1) \\\\  & =\\frac{2}{3}(8-1) \\\\  & =\\frac{14}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280405 :knowledge-point/_questions [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba6cb246-5aed-54d7-8fc2-7972f54c5a7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186280407} {:answer/id #uuid "9ca4bef8-ca08-5819-bc8f-422ab4e385a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186280408} {:answer/id #uuid "94df8648-d0ca-5c63-85da-4a1ccfdc8f9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{81}" :db/id #edb/ref 17592186280409} {:answer/id #uuid "6e5445be-684a-5b8e-92a8-b80dee3a2639" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{27}" :db/id #edb/ref 17592186280410} {:answer/id #uuid "038187db-cd2d-533c-b400-39075aa18549" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{47}{243}" :db/id #edb/ref 17592186280411}] :answer-field/correct {:answer/id #uuid "ba6cb246-5aed-54d7-8fc2-7972f54c5a7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186280407} :answer-field/id #uuid "47e7cb41-c022-5f3f-a5f5-7e98564f9caf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280406}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "17990519-b339-5dcf-9117-eeed8893a75d" :question/math-academy-id "q-113989" :question/problem "${\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x & =\\frac{{x}^{-4+1}}{(-4+1)}{|}_{-3}^{-1} \\\\  & =\\frac{{x}^{-3}}{(-3)}{|}_{-3}^{-1} \\\\  & =-\\frac{1}{3{x}^{3}}{|}_{-3}^{-1} \\\\  & =-(\\frac{1}{3(-1)^{3}}-\\frac{1}{3(-3)^{3}}) \\\\  & =-(-\\frac{1}{3}+\\frac{1}{81}) \\\\  & =-(-\\frac{26}{81}) \\\\  & =\\frac{26}{81}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280412 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae2e8f94-10ea-5fb8-a84d-e393d82de9f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{2}}{3}" :db/id #edb/ref 17592186280414} {:answer/id #uuid "0998ef2d-1481-53c5-a4c2-a267e1a941a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186280415} {:answer/id #uuid "659a8985-d7a5-58ea-9309-f8b170cc1db9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186280416} {:answer/id #uuid "44ac7df7-9772-5680-8da0-729ce2e395c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186280417} {:answer/id #uuid "e854b7e0-f636-507e-8f2f-8a33501dbdb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{3}" :db/id #edb/ref 17592186280418}] :answer-field/correct {:answer/id #uuid "0998ef2d-1481-53c5-a4c2-a267e1a941a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186280415} :answer-field/id #uuid "0bda045f-6630-5473-b67f-17a8da845142" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280413}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "09646823-4a24-5c27-91b9-a4004a9c6346" :question/math-academy-id "q-29673" :question/problem "${\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}{x}^{-3/2}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}\\cdot \\frac{1}{{(\\sqrt{x})}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}(\\frac{1}{(\\sqrt{2})^{3}}-\\frac{1}{(\\sqrt{1})^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}}{4}-1) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}-4}{4}) \\\\  & =\\frac{4-\\sqrt{2}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280419 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1ddf5ee-5a21-5f48-aecf-d0ccb58eef60" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\sqrt{9}" :db/id #edb/ref 17592186280421} {:answer/id #uuid "a100b12a-ee33-5650-85ef-5acab85d9417" :answer/type {:db/ident :answer.type/math} :answer/value "3-\\sqrt{3}" :db/id #edb/ref 17592186280422} {:answer/id #uuid "bd7106b9-5695-5056-b579-31a745556e19" :answer/type {:db/ident :answer.type/math} :answer/value "3-\\sqrt[3]{9}" :db/id #edb/ref 17592186280423} {:answer/id #uuid "cb16aa13-fda3-57af-aacb-43f6c3ec3aa8" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\sqrt[3]{3}" :db/id #edb/ref 17592186280424} {:answer/id #uuid "8bd3f283-0b38-5094-98d4-cbf8b1b910ca" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\sqrt[3]{9}" :db/id #edb/ref 17592186280425}] :answer-field/correct {:answer/id #uuid "bd7106b9-5695-5056-b579-31a745556e19" :answer/type {:db/ident :answer.type/math} :answer/value "3-\\sqrt[3]{9}" :db/id #edb/ref 17592186280423} :answer-field/id #uuid "d50d707d-ffed-51e4-af16-09a47209dadf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280420}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "687d360e-6b55-5364-9883-46bab70fd288" :question/math-academy-id "q-29674" :question/problem "Evaluate ${\\int }_{1}^{3}\\frac{1}{\\sqrt[3]{{x}^{4}}}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{1}{\\sqrt[3]{{x}^{4}}}\\,\\text{d}x & ={\\int }_{1}^{3}{x}^{-4/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{-\\frac{4}{3}+1}{|}_{1}^{3} \\\\  & =-3{x}^{-1/3}{|}_{1}^{3} \\\\  & =-3\\cdot \\frac{1}{\\sqrt[3]{x}}{|}_{1}^{3} \\\\  & =-3(\\frac{1}{\\sqrt[3]{3}}-\\frac{1}{\\sqrt[3]{1}}) \\\\  & =3(1-\\frac{1}{\\sqrt[3]{3}}) \\\\  & =3-\\frac{3}{\\sqrt[3]{3}} \\\\  & =3-\\sqrt[3]{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064632 :knowledge-point/_questions [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3ee6a85-8625-5e3d-a81d-d10ef7788c08" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186062304} {:answer/id #uuid "f692ac11-a1e7-50f6-8601-85cde9b11626" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186062305} {:answer/id #uuid "36c6e4df-28dd-533b-ab52-58dce2e04fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{189}{2}" :db/id #edb/ref 17592186062306} {:answer/id #uuid "40eef81b-0960-52f4-9886-384ec0dafade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186062307} {:answer/id #uuid "7ad1c004-4f33-5d8f-9480-7b16d02b54e5" :answer/type {:db/ident :answer.type/math} :answer/value "189" :db/id #edb/ref 17592186062308}] :answer-field/correct {:answer/id #uuid "b3ee6a85-8625-5e3d-a81d-d10ef7788c08" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186062304} :answer-field/id #uuid "601ec15c-1ad0-51ed-96bd-618a5b8ce1bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062303}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1ea9ad4a-c4e1-5eef-bc95-8f5cd98ebf22" :question/math-academy-id "q-29744" :question/problem "Evaluate  ${\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x & =\\frac{{x}^{2+1}}{2+1}{|}_{-5}^{4} \\\\  & =\\frac{{x}^{3}}{3}{|}_{-5}^{4} \\\\  & =\\frac{{4}^{3}}{3}-\\frac{(-5)^{3}}{3} \\\\  & =\\frac{64}{3}+\\frac{125}{3} \\\\  & =63.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280426 :knowledge-point/_questions [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3000660c-cfa2-5d44-bee7-1ea7bd81467a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{31}{5}" :db/id #edb/ref 17592186280428} {:answer/id #uuid "08cd5257-d622-5879-95d4-fad478c75563" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186280429} {:answer/id #uuid "72e22547-ad5e-55a5-9224-50cbccd686a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186280430} {:answer/id #uuid "2e17f9e4-3ee3-5290-b468-c238c4b9ec73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186280431} {:answer/id #uuid "f323a9b8-6fb0-5bc0-861d-754f61af2b8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{5}" :db/id #edb/ref 17592186280432}] :answer-field/correct {:answer/id #uuid "72e22547-ad5e-55a5-9224-50cbccd686a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{5}" :db/id #edb/ref 17592186280430} :answer-field/id #uuid "f2fbe6ff-52e1-52b2-a0df-4a9b02a464e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280427}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ec793c7e-0a32-5b0f-989b-f20702db3a73" :question/math-academy-id "q-29746" :question/problem "${\\int }_{1}^{2}{x}^{4}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{4}\\,\\text{d}x & =\\frac{{x}^{4+1}}{4+1}{|}_{1}^{2} \\\\  & =\\frac{{x}^{5}}{5}{|}_{1}^{2} \\\\  & =\\frac{{2}^{5}}{5}-\\frac{{1}^{5}}{5} \\\\  & =\\frac{32}{5}-\\frac{1}{5} \\\\  & =\\frac{31}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280433 :knowledge-point/_questions [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80e9ad0a-766d-59e8-a37b-1efc2dd03dd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186280435} {:answer/id #uuid "d5085563-7b9f-5cdb-af3b-0f48708b7de2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186280436} {:answer/id #uuid "826db9eb-c663-5c94-892c-d2fca1fbd5bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186280437} {:answer/id #uuid "a28e64ff-8b4c-573a-8478-7bd4af45bf94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{24}" :db/id #edb/ref 17592186280438} {:answer/id #uuid "0a767da6-8583-55b3-9464-7feec3a892fe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{24}" :db/id #edb/ref 17592186280439}] :answer-field/correct {:answer/id #uuid "826db9eb-c663-5c94-892c-d2fca1fbd5bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186280437} :answer-field/id #uuid "ed1dd774-7d8d-5e3c-bbfd-d1139c97209f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280434}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c2bd8ca2-a0f2-5891-bd19-4a1efde99bf6" :question/math-academy-id "q-29747" :question/problem "${\\int }_{1}^{2}{x}^{-4}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{-4}\\,\\text{d}x & =\\frac{{x}^{-4+1}}{-4+1}{|}_{1}^{2} \\\\  & =\\frac{{x}^{-3}}{(-3)}{|}_{1}^{2} \\\\  & =-\\frac{1}{3{x}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{1}{3}(\\frac{1}{{2}^{3}}-\\frac{1}{{1}^{3}}) \\\\  & =-\\frac{1}{3}(\\frac{1}{8}-1) \\\\  & =\\frac{7}{24}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280440 :knowledge-point/_questions [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b70a46-3553-5c11-af4d-b05c4d2b66c2" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186280442}] :answer-field/correct {:answer/id #uuid "19b70a46-3553-5c11-af4d-b05c4d2b66c2" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186280442} :answer-field/id #uuid "b18de24c-5c93-5e24-b291-e2331bbd3006" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280441}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a8ee6457-d621-5c03-9bb9-7fec20f27838" :question/math-academy-id "q-315984" :question/problem "Evaluate ${\\int }_{1}^{3}{x}^{3}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{3}{x}^{3}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}{x}^{3}\\,\\text{d}x & =\\frac{{x}^{3+1}}{3+1}{|}_{1}^{3} \\\\  & =\\frac{{x}^{4}}{4}{|}_{1}^{3} \\\\  & =\\frac{{3}^{4}}{4}-\\frac{{1}^{4}}{4} \\\\  & =\\frac{81}{4}-\\frac{1}{4} \\\\  & =\\frac{80}{4} \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280443 :knowledge-point/_questions [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e88268c-1303-5339-a088-73735e06f05a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186280445} {:answer/id #uuid "6b750098-4529-5688-a5d4-df506f01b8d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186280446}] :answer-field/correct {:answer/id #uuid "6b750098-4529-5688-a5d4-df506f01b8d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186280446} :answer-field/id #uuid "82aaa0f5-0246-5948-84c6-f378f0be024a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280444}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cd35637b-29da-56f2-b1f6-a6ade037cf18" :question/math-academy-id "q-315985" :question/problem "Evaluate ${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}{x}^{-3}\\,\\text{d}x & =\\frac{{x}^{-3+1}}{-3+1}{|}_{1}^{3} \\\\  & =\\frac{{x}^{-2}}{-2}{|}_{1}^{3} \\\\  & =-\\frac{1}{2{x}^{2}}{|}_{1}^{3} \\\\  & =-(\\frac{1}{2\\cdot {3}^{2}}-\\frac{1}{2\\cdot {1}^{2}}) \\\\  & =-(\\frac{1}{18}-\\frac{1}{2}) \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280447 :knowledge-point/_questions [{:knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239853c4-7641-5e69-9880-331d1aef9ac9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186280449} {:answer/id #uuid "1ec95d72-babe-567a-a394-20fa816105a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186280450}] :answer-field/correct {:answer/id #uuid "1ec95d72-babe-567a-a394-20fa816105a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186280450} :answer-field/id #uuid "8300c0f5-054c-51dd-a4a2-1982781bb2d4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280448}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "24eae249-f203-5a6e-92cc-dc12f0e30478" :question/math-academy-id "q-344221" :question/problem "Evaluate ${\\int }_{-1}^{2}{x}^{3}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{-1}^{2}{x}^{3}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{2}{x}^{3}\\,\\text{d}x & =\\frac{{x}^{3+1}}{3+1}{|}_{-1}^{2} \\\\  & =\\frac{{x}^{4}}{4}{|}_{-1}^{2} \\\\  & =\\frac{{2}^{4}}{4}-\\frac{(-1)^{4}}{4} \\\\  & =\\frac{16}{4}-\\frac{1}{4} \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280451 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bdd30cd-02b3-5525-805b-3bd08e26584d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1275}{8}" :db/id #edb/ref 17592186280453}] :answer-field/correct {:answer/id #uuid "2bdd30cd-02b3-5525-805b-3bd08e26584d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1275}{8}" :db/id #edb/ref 17592186280453} :answer-field/id #uuid "5291488c-3a2f-5abf-8c0a-7646819ae182" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280452}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ab106e83-f311-5981-aa43-2f775aae248c" :question/math-academy-id "q-344298" :question/problem "Evaluate ${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{32}\\sqrt[5]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{32}{x}^{3/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/5+1}}{(\\frac{3}{5}+1)}{|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,{x}^{8/5}|}_{1}^{32} \\\\  & ={\\frac{5}{8}\\,(\\sqrt[5]{x})^{8}|}_{1}^{32} \\\\  & =\\frac{5}{8}\\,((\\sqrt[5]{32})^{8}-(\\sqrt[5]{1})^{8}) \\\\  & =\\frac{5}{8}\\,({2}^{8}-{1}^{8}) \\\\  & =\\frac{5}{8}(256-1) \\\\  & =\\frac{1275}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280454 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c331ddf9-26b4-5d24-8b4f-ef03b754057a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{512}{7}" :db/id #edb/ref 17592186280456} {:answer/id #uuid "71a1ebe6-bfa3-5c44-b8d3-88b7747b21af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{508}{7}" :db/id #edb/ref 17592186280457}] :answer-field/correct {:answer/id #uuid "71a1ebe6-bfa3-5c44-b8d3-88b7747b21af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{508}{7}" :db/id #edb/ref 17592186280457} :answer-field/id #uuid "645959fe-e85a-5e93-839d-d186ce3518f8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280455}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2cfc140b-4f50-54bd-8766-4f51157714ea" :question/math-academy-id "q-344299" :question/problem "Evaluate ${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}\\sqrt[4]{{x}^{3}}\\,\\text{d}x & ={\\int }_{1}^{16}{x}^{3/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{3/4+1}}{\\frac{3}{4}+1}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{x}^{7/4}{|}_{1}^{16} \\\\  & =\\frac{4}{7}{(\\sqrt[4]{x})}^{7}{|}_{1}^{16} \\\\  & =\\frac{4}{7}({(\\sqrt[4]{16})}^{7}-{(\\sqrt[4]{1})}^{7}) \\\\  & =\\frac{4}{7}({2}^{7}-{1}^{7}) \\\\  & =\\frac{4}{7}(128-1) \\\\  & =\\frac{508}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280458 :knowledge-point/_questions [{:knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4af1a8ec-e89b-5b7f-b77b-a70374086376" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot16^{1/3}-3" :db/id #edb/ref 17592186280460}] :answer-field/correct {:answer/id #uuid "4af1a8ec-e89b-5b7f-b77b-a70374086376" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot16^{1/3}-3" :db/id #edb/ref 17592186280460} :answer-field/id #uuid "9f1d98bb-779a-5073-b7b4-ea11e192176a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280459}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bb4bd905-cb04-5684-9b8d-ccabcaa7be6a" :question/math-academy-id "q-344503" :question/problem "Evaluate ${\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}\\frac{1}{\\sqrt[3]{{x}^{2}}}\\,\\text{d}x & ={\\int }_{1}^{16}{x}^{-2/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-2/3+1}}{(-\\frac{2}{3}+1)}{|}_{1}^{16} \\\\  & =3\\,{x}^{1/3}{|}_{1}^{16} \\\\  & =3\\,\\sqrt[3]{x}{|}_{1}^{16} \\\\  & =3(\\sqrt[3]{16}-\\sqrt[3]{1}) \\\\  & =3(2\\sqrt[3]{2}-1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280461 :knowledge-point/_questions [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311587cd-30ff-57ed-bbc6-5f5f44e11fd1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{64}" :db/id #edb/ref 17592186280463} {:answer/id #uuid "cc228a09-9b79-59e9-9181-a4b1b0756ceb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac