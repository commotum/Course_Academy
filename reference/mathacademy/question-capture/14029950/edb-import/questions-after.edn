#{[{:db/id #edb/ref 17592186292735 :knowledge-point/_questions [{:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070" :knowledge-point/title "Finding the General Solution of a Second Order Differential Equation by Integrating Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2710eb67-6841-5d5c-8e1e-039125c3b36d" :answer/type {:db/ident :answer.type/math} :answer/value "y={2}^{x}{ln}^{2}⁡2-\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186292737} {:answer/id #uuid "c4048121-3fb2-5bcf-982e-cf851d1c607c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186292738} {:answer/id #uuid "5af93b4d-1bd0-5e4d-ba64-e54d460cc6e3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186292739} {:answer/id #uuid "1ea0dc24-dc83-5857-a66e-00d0395664c5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}+\\operatorname{sin}⁡x+Cx+D" :db/id #edb/ref 17592186292740} {:answer/id #uuid "c3ac503d-86b3-5bac-83b1-5ecf8f92865d" :answer/type {:db/ident :answer.type/math} :answer/value "y={2}^{x}\\operatorname{ln}⁡2-\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186292741}] :answer-field/correct {:answer/id #uuid "c4048121-3fb2-5bcf-982e-cf851d1c607c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D" :db/id #edb/ref 17592186292738} :answer-field/id #uuid "e5356391-daef-5366-a605-c7b74b8f10e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292736}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "20cda5cd-39b4-5204-8a0d-778056eed590" :question/math-academy-id "q-119044" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-{2}^{x}=\\operatorname{cos}⁡x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\operatorname{cos}⁡x+{2}^{x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x+{2}^{x})\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C)\\text{d}x \\\\ y & =\\int \\operatorname{sin}⁡x\\,\\text{d}x+\\frac{1}{\\operatorname{ln}⁡2}\\int {2}^{x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =-\\operatorname{cos}⁡x+\\frac{1}{\\operatorname{ln}⁡2}(\\frac{{2}^{x}}{\\operatorname{ln}⁡2})+Cx+D \\\\  & =\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}] [{:db/id #edb/ref 17592186292742 :knowledge-point/_questions [{:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd7fb28d-d2af-5809-9602-c6c9c61aa684" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186292744} {:answer/id #uuid "476b9b70-6126-5f8b-b65b-3ddd79e11fcc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/8ede6d26a62570f4037ecc58c377e95389ab00dbee36b60c46e6fb2021e01cea.png" :db/id #edb/ref 17592186292745} {:answer/id #uuid "0252ec44-9753-55db-bbb2-be4dbfeaaa45" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/cece096a5b267821994e9b6d8142f0d7ea684bbe8e28da7cdb01b87a73f1db4c.png" :db/id #edb/ref 17592186292746} {:answer/id #uuid "ae440fff-25e4-5f3f-841f-9ccae733397a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/96359fe35288b866cbf9fd929e2515af04a4ec0dc565a4cd4af9d3a8fcd20f94.png" :db/id #edb/ref 17592186292747} {:answer/id #uuid "4ccca60c-7f65-5eec-8bf7-fb08e7594b1d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/7832a2110292cb364cf06c24eb51e9bb1ee42fe430ac8fcc381af047a09125e4.png" :db/id #edb/ref 17592186292748}] :answer-field/correct {:answer/id #uuid "fd7fb28d-d2af-5809-9602-c6c9c61aa684" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186292744} :answer-field/id #uuid "8d5b2ef1-c08b-50ea-a722-b5ebadbae937" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292743}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "370a4996-fe99-533f-b6a9-5042b61aa194" :question/math-academy-id "q-119132" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{-x/4}}{2}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)"}] [{:db/id #edb/ref 17592186292749 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be185d95-e478-5395-97f2-47a81ca133e5" :answer/type {:db/ident :answer.type/math} :answer/value "9-\\frac{8}{x-3}" :db/id #edb/ref 17592186292751}] :answer-field/correct {:answer/id #uuid "be185d95-e478-5395-97f2-47a81ca133e5" :answer/type {:db/ident :answer.type/math} :answer/value "9-\\frac{8}{x-3}" :db/id #edb/ref 17592186292751} :answer-field/id #uuid "fdaa6dac-352d-59d2-a0be-00d8b5580145" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292750}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d86030f5-75e2-57ba-94c6-7a636a2e8eeb" :question/math-academy-id "q-352066" :question/problem "Find the particular solution to the differential equation $(x-3)^{2}{y}^{′}=8$ that satisfies the condition $y(4)=1.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=\\frac{8}{(x-3)^{2}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int \\frac{8}{(x-3)^{2}}\\,\\text{d}x \\\\ y & =8\\int \\frac{1}{(x-3)^{2}}\\,\\text{d}x \\\\  & =8(-\\frac{1}{x-3})+C \\\\  & =-\\frac{8}{x-3}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-\\frac{8}{x-3}+C.$ To find a particular solution, we substitute the condition $y(4)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}1 & =-\\frac{8}{4-3}+C \\\\ 1 & =-8+C \\\\ C & =9.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-\\frac{8}{x-3}+9.\n$$"}] [{:db/id #edb/ref 17592186292752 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e2bbd1a-d147-5327-8498-387d60664636" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+2{x}^{2}-\\frac{4}{3}" :db/id #edb/ref 17592186292754} {:answer/id #uuid "51ab586d-13bb-5243-be67-501f24081fc4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}-{x}^{2}+\\frac{5}{3}" :db/id #edb/ref 17592186292755} {:answer/id #uuid "ca7a2592-1d2c-59e3-8481-e9ee58933ff7" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{3}+{x}^{2}-1" :db/id #edb/ref 17592186292756} {:answer/id #uuid "076235ce-3935-5859-be5a-d82dc729956d" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{3}+2{x}^{2}-2" :db/id #edb/ref 17592186292757} {:answer/id #uuid "ea384d87-4940-5a43-a794-e99857fed3ad" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186292758}] :answer-field/correct {:answer/id #uuid "ea384d87-4940-5a43-a794-e99857fed3ad" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186292758} :answer-field/id #uuid "4cc15847-4e8b-5777-a4fb-4e61736d2e6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292753}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ace322a0-7247-5b35-923e-e7ab39690f9e" :question/math-academy-id "q-50092" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $y(1)=1.$\n\n$$\n2x+\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+4x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+2x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int ({x}^{2}+2x)\\,\\text{d}x \\\\ y & =\\frac{{x}^{3}}{3}+2\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{3}}{3}+{x}^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=\\frac{{x}^{3}}{3}+{x}^{2}+C.$ To find a particular solution, we substitute the condition $y(1)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =\\frac{{x}^{3}}{3}+{x}^{2}+C \\\\ 1 & =\\frac{{1}^{3}}{3}+{1}^{2}+C \\\\ 1 & =\\frac{4}{3}+C \\\\ C & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186292759 :knowledge-point/_questions [{:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/title "Sketching the Solution Curves of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3b2036-4273-53bc-aa24-a885d6e03696" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186292761} {:answer/id #uuid "feb6948b-da9f-5926-9102-61f011a1fa4e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/bec2fa9f6c2673fe9bc71fbdadb8f2cbf4c37ef05a38dd2486be3fac7e2b98d2.png" :db/id #edb/ref 17592186292762} {:answer/id #uuid "295d0262-efca-5cce-bbd2-71fd6d150f1b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/4110727f4203228259f1ee4d95593e54c92731e986eb3bdcf9cc0692cf902aa4.png" :db/id #edb/ref 17592186292763} {:answer/id #uuid "7479c24c-f3e4-52f6-8efa-e7f5c4048c96" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/8ac5a8137dd22e9f7333315bc2f5e1120cdb46dc6fb84f938890c491563a86c7.png" :db/id #edb/ref 17592186292764} {:answer/id #uuid "40cdb413-f609-5e3e-bd02-115cfae2ddd4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/f59924b67013ab56263c9e58d283bd29b1869699488702fffc8f88d1de18e647.png" :db/id #edb/ref 17592186292765}] :answer-field/correct {:answer/id #uuid "8b3b2036-4273-53bc-aa24-a885d6e03696" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186292761} :answer-field/id #uuid "1d20e3bd-f87b-5831-89f9-73f7ec193dc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292760}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9720bec0-3da4-5217-8468-e4569ac0e63c" :question/math-academy-id "q-79563" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=3.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =3\\int \\,\\text{d}x \\\\ y & =3x+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/64b0962fbb38b2c64da68de01d1c6407174aa66f810b820ece7185866b7f8ff3.png)"}]}
