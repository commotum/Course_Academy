[{:db/id "q-50092/selection/565a95288cfe83347881aa5c528ca2a935630769221101d66528fb44ec9c215f" :answer/id #uuid "ca7a2592-1d2c-59e3-8481-e9ee58933ff7" :answer/type :answer.type/math :answer/value "y={x}^{3}+{x}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-50092/selection/6f112d5e8d670e5670460276784f97865450cbd5dc6ad8aa589821c43dc5c5e7" :answer/id #uuid "076235ce-3935-5859-be5a-d82dc729956d" :answer/type :answer.type/math :answer/value "y={x}^{3}+2{x}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-50092/selection/21fb11d674ef688b97ef9cf7d43f10b2ecb32b39e938f7c50b7ece735a63aa4b" :answer/id #uuid "51ab586d-13bb-5243-be67-501f24081fc4" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}-{x}^{2}+\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-50092/selection/0bc04d1d8a072340863578cd3002c3b857f920655e533a8828f09ad85b2435a2" :answer/id #uuid "8e2bbd1a-d147-5327-8498-387d60664636" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}+2{x}^{2}-\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-50092/selection/7279e1214af7e8879aa5fbd410ae3c3f8b13cd47c57972835ed3365ad8756f88" :answer/id #uuid "ea384d87-4940-5a43-a794-e99857fed3ad" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-50092/selection" :answer-field/id #uuid "4cc15847-4e8b-5777-a4fb-4e61736d2e6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50092/selection/7279e1214af7e8879aa5fbd410ae3c3f8b13cd47c57972835ed3365ad8756f88" :answer-field/choices ["q-50092/selection/565a95288cfe83347881aa5c528ca2a935630769221101d66528fb44ec9c215f" "q-50092/selection/6f112d5e8d670e5670460276784f97865450cbd5dc6ad8aa589821c43dc5c5e7" "q-50092/selection/21fb11d674ef688b97ef9cf7d43f10b2ecb32b39e938f7c50b7ece735a63aa4b" "q-50092/selection/0bc04d1d8a072340863578cd3002c3b857f920655e533a8828f09ad85b2435a2" "q-50092/selection/7279e1214af7e8879aa5fbd410ae3c3f8b13cd47c57972835ed3365ad8756f88"] :db/ensure [:answer-field/validate]} {:db/id "q-50092" :question/id #uuid "ace322a0-7247-5b35-923e-e7ab39690f9e" :question/math-academy-id "q-50092" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $y(1)=1.$\n\n$$\n2x+\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+4x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+2x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int ({x}^{2}+2x)\\,\\text{d}x \\\\ y & =\\frac{{x}^{3}}{3}+2\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{3}}{3}+{x}^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=\\frac{{x}^{3}}{3}+{x}^{2}+C.$ To find a particular solution, we substitute the condition $y(1)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =\\frac{{x}^{3}}{3}+{x}^{2}+C \\\\ 1 & =\\frac{{1}^{3}}{3}+{1}^{2}+C \\\\ 1 & =\\frac{4}{3}+C \\\\ C & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-50092/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-50092"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79563/selection/8366d132694fa1922ff4e2426065f304e78216708bfd29702a5401861f76b4f2" :answer/id #uuid "7479c24c-f3e4-52f6-8efa-e7f5c4048c96" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/8ac5a8137dd22e9f7333315bc2f5e1120cdb46dc6fb84f938890c491563a86c7.png" :db/ensure [:answer/validate]} {:db/id "q-79563/selection/10ee513d3c4ddf0390cd79954e6be0be78515295f00958cb7ab7a9446f31b67d" :answer/id #uuid "8b3b2036-42