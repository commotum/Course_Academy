75c40fb0d37190f6084d12616bc4f4927c9efb994e2504b59ab9ce3b9e4529" "q-79563/selection/97269e5b047f2848e7455bd9eec01ff0e7b1af263066bd6cc7392d9cb038c7c8"] :db/ensure [:answer-field/validate]} {:db/id "q-79563" :question/id #uuid "9720bec0-3da4-5217-8468-e4569ac0e63c" :question/math-academy-id "q-79563" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=3.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =3\\int \\,\\text{d}x \\\\ y & =3x+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/64b0962fbb38b2c64da68de01d1c6407174aa66f810b820ece7185866b7f8ff3.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79563/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-79563"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119044/selection/21b1c09c85326fb7dad2851e9fea6d322d6a1aa713c15829d9cbd3a8eb4cad27" :answer/id #uuid "2710eb67-6841-5d5c-8e1e-039125c3b36d" :answer/type :answer.type/math :answer/value "y={2}^{x}{ln}^{2}⁡2-\\operatorname{sin}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119044/selection/c522762a7f737b25cf78cfb472b4f59b02c605e039bf83ad3bc01fe9e34eff06" :answer/id #uuid "c3ac503d-86b3-5bac-83b1-5ecf8f92865d" :answer/type :answer.type/math :answer/value "y={2}^{x}\\operatorname{ln}⁡2-\\operatorname{cos}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119044/selection/441b845e5c63940e0a7e2dc2ca2ea8573a7c3f8edf0acae0085d0855387a2c88" :answer/id #uuid "5af93b4d-1bd0-5e4d-ba64-e54d460cc6e3" :answer/type :answer.type/math :answer/value "y=\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+\\operatorname{cos}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119044/selection/3d6a57349be6ed4c2a9bad562d24178e9c6b8d42987e29384033550c9cd7e422" :answer/id #uuid "c4048121-3fb2-5bcf-982e-cf851d1c607c" :answer/type :answer.type/math :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119044/selection/4beb409db93f06703cde5e894fdafa370db603e1ac9c9471b20329380f0f6ac0" :answer/id #uuid "1ea0dc24-dc83-5857-a66e-00d0395664c5" :answer/type :answer.type/math :answer/value "y=\\frac{{2}^{x}}{{ln}^{2}⁡2}+\\operatorname{sin}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119044/selection" :answer-field/id #uuid "e5356391-daef-5366-a605-c7b74b8f10e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119044/selection/3d6a57349be6ed4c2a9bad562d24178e9c6b8d42987e29384033550c9cd7e422" :answer-field/choices ["q-119044/selection/21b1c09c85326fb7dad2851e9fea6d322d6a1aa713c15829d9cbd3a8eb4cad27" "q-119044/selection/c522762a7f737b25cf78cfb472b4f59b02c605e039bf83ad3bc01fe9e34eff06" "q-119044/selection/441b845e5c63940e0a7e2dc2ca2ea8573a7c3f8edf0acae0085d0855387a2c88" "q-119044/selection/3d6a57349be6ed4c2a9bad562d24178e9c6b8d42987e29384033550c9cd7e422" "q-119044/selection/4beb409db93f06703cde5e894fdafa370db603e1ac9c9471b20329380f0f6ac0"] :db/ensure [:answer-field/validate]} {:db/id "q-119044" :question/id #uuid "20cda5cd-39b4-5204-8a0d-778056eed590" :question/math-academy-id "q-119044" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-{2}^{x}=\\operatorname{cos}⁡x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\operatorname{cos}⁡x+{2}^{x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x+{2}^{x})\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\operatorname{sin}⁡x+\\frac{{2}^{x}}{\\operatorname{ln}⁡2}+C)\\text{d}x \\\\ y & =\\int \\operatorname{sin}⁡x\\,\\text{d}x+\\frac{1}{\\operatorname{ln}⁡2}\\int {2}^{x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =-\\operatorname{cos}⁡x+\\frac{1}{\\operatorname{ln}⁡2}(\\frac{{2}^{x}}{\\operatorname{ln}⁡2})+Cx+D \\\\  & =\\frac{{2}^{x}}{{ln}^{2}⁡2}-\\operatorname{cos}⁡x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119044/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119044"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119132/selection/d3d0856e55584fd09802f3d02a7b37f2b5db29eb32fdca7b70f1754e6f80884f" :answer/id #uuid "4ccca60c-7f65-5eec-8bf7-fb08e7594b1d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/7832a2110292cb364cf06c24eb51e9bb1ee42fe430ac8fcc381af047a09125e4.png" :db/ensure [:answer/validate]} {:db/id "q-119132/selection/cf328e06e952dc9762e8fb9cd791e51f339f8623d52bdd00cc9cc85ceaba574c" :answer/id #uuid "ae440fff-25e4-5f3f-841f-9ccae733397a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/96359fe35288b866cbf9fd929e2515af04a4ec0dc565a4cd4af9d3a8fcd20f94.png" :db/ensure [:answer/validate]} {:db/id "q-119132/selection/503981ec7f4a1bed903c5576d751d41884c2e2ad42129023f576f230748499fc" :answer/id #uuid "fd7fb28d-d2af-5809-9602-c6c9c61aa684" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/ensure [:answer/validate]} {:db/id "q-119132/selection/c9b29f73360de694ed088d651c97740b7c3a5549b2516f19998a1370998077bd" :answer/id #uuid "0252ec44-9753-55db-bbb2-be4dbfeaaa45" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/cece096a5b267821994e9b6d8142f0d7ea684bbe8e28da7cdb01b87a73f1db4c.png" :db/ensure [:answer/validate]} {:db/id "q-119132/selection/c8c4b01601f80c978a4463c7693fa031449e58e01d8c6082718e8791f50878c3" :answer/id #uuid "476b9b70-6126-5f8b-b65b-3ddd79e11fcc" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/8ede6d26a62570f4037ecc58c377e95389ab00dbee36b60c46e6fb2021e01cea.png" :db/ensure [:answer/validate]} {:db/id "q-119132/selection" :answer-field/id #uuid "8d5b2ef1-c08b-50ea-a722-b5ebadbae937" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119132/selection/503981ec7f4a1bed903c5576d751d41884c2e2ad42129023f576f230748499fc" :answer-field/choices ["q-119132/selection/d3d0856e55584fd09802f3d02a7b37f2b5db29eb32fdca7b70f1754e6f80884f" "q-119132/selection/cf328e06e952dc9762e8fb9cd791e51f339f8623d52bdd00cc9cc85ceaba574c" "q-119132/selection/503981ec7f4a1bed903c5576d751d41884c2e2ad42129023f576f230748499fc" "q-119132/selection/c9b29f73360de694ed088d651c97740b7c3a5549b2516f19998a1370998077bd" "q-119132/selection/c8c4b01601f80c978a4463c7693fa031449e58e01d8c6082718e8791f50878c3"] :db/ensure [:answer-field/validate]} {:db/id "q-119132" :question/id #uuid "370a4996-fe99-533f-b6a9-5042b61aa194" :question/math-academy-id "q-119132" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{-x/4}}{2}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029950/assets/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119132/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-119132"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352066/field-1/5483f8885e4975dc9719e431fc20822cb5a2ea252c26f7dc21c732aec2fa8122" :answer/id #uuid "be185d95-e478-5395-97f2-47a81ca133e5" :answer/type :answer.type/math :answer/value "9-\\frac{8}{x-3}" :db/ensure [:answer/validate]} {:db/id "q-352066/field-1" :answer-field/id #uuid "fdaa6dac-352d-59d2-a0be-00d8b5580145" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352066/field-1/5483f8885e4975dc9719e431fc20822cb5a2ea252c26f7dc21c732aec2fa8122" :answer-field/choices ["q-352066/field-1/5483f8885e4975dc9719e431fc20822cb5a2ea252c26f7dc21c732aec2fa8122"] :db/ensure [:answer-field/validate]} {:db/id "q-352066" :question/id #uuid "d86030f5-75e2-57ba-94c6-7a636a2e8eeb" :question/math-academy-id "q-352066" :question/problem "Find the particular solution to the differential equation $(x-3)^{2}{y}^{′}=8$ that satisfies the condition $y(4)=1.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=\\frac{8}{(x-3)^{2}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int \\frac{8}{(x-3)^{2}}\\,\\text{d}x \\\\ y & =8\\int \\frac{1}{(x-3)^{2}}\\,\\text{d}x \\\\  & =8(-\\frac{1}{x-3})+C \\\\  & =-\\frac{8}{x-3}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-\\frac{8}{x-3}+C.$ To find a particular solution, we substitute the condition $y(4)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}1 & =-\\frac{8}{4-3}+C \\\\ 1 & =-8+C \\\\ C & =9.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-\\frac{8}{x-3}+9.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-352066/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-352066"] :db/ensure [:knowledge-point/validate]}]
