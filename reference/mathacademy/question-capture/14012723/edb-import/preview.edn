1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))+{C}_{1} \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}\\,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}(-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}) \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2}{9}x\\operatorname{cos}⁡(3x)-\\frac{2}{27}\\operatorname{sin}⁡(3x)-\\frac{2{C}_{1}}{3} \\\\  & =\\frac{1}{27}((9{x}^{2}-2)\\operatorname{sin}⁡(3x)+6x\\operatorname{cos}⁡(3x))+C,\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{2C_1}{3}.$" 13194139534472 true] [17592186068495 1145 "In this case, we define\n\n$$\n\\begin{bmatrix}u = x^{2} & ⟹\\frac{du}{dx} = 2x, \\\\ \\frac{dv}{dx} = \\cos (3x) & ⟹v = \\int\\cos (3x)dx = \\frac{1}{3}\\sin (3x)\\end{bmatrix}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\n\\intx^{2}\\cos (3x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (x^{2})(\\frac{1}{3}\\sin (3x)) - \\int(\\frac{1}{3}\\sin (3x))2xdx \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}\\intx\\sin (3x)dx\n\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\displaystyle \\int x\\sin(3x) \\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = x & ⟹\\frac{du}{dx} = 1, \\\\ \\frac{dv}{dx} = \\sin (3x) & ⟹v = \\int\\sin (3x)dx =-\\frac{1}{3}\\cos (3x)\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intx\\sin (3x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= x(-\\frac{1}{3}\\cos (3x)) - \\int(-\\frac{1}{3}\\cos (3x)) \\cdot 1dx \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{3}\\int\\cos (3x)dx \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{3}(\\frac{1}{3}\\sin (3x)) + C_{1} \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{9}\\sin (3x) + C_{1}\n\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\n\\intx^{2}\\cos (3x)dx &= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}\\intx\\sin (3x)dx \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}(-\\frac{1}{3}x\\cos (3x) + \\frac{1}{9}\\sin (3x) + C_{1}) \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) + \\frac{2}{9}x\\cos (3x) - \\frac{2}{27}\\sin (3x) - \\frac{2C_{1}}{3} \\\\\n&= \\frac{1}{27}((9x^{2} - 2)\\sin (3x) + 6x\\cos (3x)) + C\n\\end{aligned}\n$$\n\nwhere\n\n$$\nC = -\\dfrac{2C_1}{3}\n$$" 13194139534472 false] [17592186068496 1100 "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x$." 13194139534472 false] [17592186068496 1100 "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x.$" 13194139534472 true] [17592186068496 1145 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=32{x}^{3} & \\,⟹\\,v=\\int 32{x}^{3}\\text{d}x=8{x}^{4}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(8{x}^{4})-\\int (8{x}^{4})(\\frac{2\\operatorname{ln}⁡x}{x})\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{3} & \\,⟹\\,v=\\int {x}^{3}\\text{d}x=\\frac{{x}^{4}}{4}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(\\frac{{x}^{4}}{4})-\\int (\\frac{{x}^{4}}{4})(\\frac{1}{x})\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{1}{4}\\int {x}^{3}\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16(\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}) \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{4}\\operatorname{ln}⁡(x)+{x}^{4}-16{C}_{1} \\\\  & ={x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)+C\\,\\end{aligned}\n$$\n\nwhere $C = -4C_1.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}32{x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & ={{x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)|}_{1}^{e} \\\\  & =[(e)^{4}(8{(\\operatorname{ln}⁡(e))}^{2}-4\\operatorname{ln}⁡(e)+1)]-[(1)^{4}(8{(\\operatorname{ln}⁡(1))}^{2}-4\\operatorname{ln}⁡(1)+1)] \\\\  & =[{e}^{4}(8-4+1)]-1 \\\\  & =5{e}^{4}-1.\\end{aligned}\n$$" 13194139534472 true] [17592186068496 1145 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{bmatrix}u = (\\ln x)^{2} & ⟹\\frac{du}{dx} = \\frac{2\\ln x}{x}, \\\\ \\frac{dv}{dx} = 32x^{3} & ⟹v = \\int32x^{3}dx = 8x^{4}\\end{bmatrix}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\n\\int32x^{3}(\\ln x)^{2}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (\\ln x)^{2}(8x^{4}) - \\int(8x^{4})(\\frac{2\\ln x}{x})dx \\\\\n&= 8x^{4}(\\ln x)^{2} - 16\\intx^{3}\\ln (x)dx\n\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = \\ln (x) & ⟹\\frac{du}{dx} = \\frac{1}{x}, \\\\ \\frac{dv}{dx} = x^{3} & ⟹v = \\intx^{3}dx = \\frac{x^{4}}{4}\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intx^{3}\\ln (x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= \\ln (x)(\\frac{x^{4}}{4}) - \\int(\\frac{x^{4}}{4})(\\frac{1}{x})dx \\\\\n&= (x^{4}\\ln (x))/(4) - \\frac{1}{4}\\intx^{3}dx \\\\\n&= (x^{4}\\ln (x))/(4) - \\frac{x^{4}}{16} + C_{1}\n\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\n\\int32x^{3}(\\ln x)^{2}dx &= 8x^{4}(\\ln x)^{2} - 16\\intx^{3}\\ln (x)dx \\\\\n&= 8x^{4}(\\ln x)^{2} - 16((x^{4}\\ln (x))/(4) - \\frac{x^{4}}{16} + C_{1}) \\\\\n&= 8x^{4}(\\ln x)^{2} - 4x^{4}\\ln (x) + x^{4} - 16C_{1} \\\\\n&= x^{4}(8(\\ln x)^{2} - 4\\ln (x) + 1) + C\n\\end{aligned}\n$$\n\nwhere $C = -4C_1$. Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}\n\\int_{1}^{e}32x^{3}\\ln (x)dx &= \\left.x^{4}(8(\\ln x)^{2} - 4\\ln (x) + 1)\\right|_{1}^{e} \\\\\n&= [(e)^{4}(8(\\ln (e))^{2} - 4\\ln (e) + 1)] - [(1)^{4}(8(\\ln (1))^{2} - 4\\ln (1) + 1)] \\\\\n&= [e^{4}(8 - 4 + 1)] - 1 \\\\\n&= 5e^{4} - 1\n\\end{aligned}\n$$" 13194139534472 false] [17592186068560 1100 "Calculate $\\displaystyle \\int x^2e^{2x}\\, \\textrm{d}x$." 13194139534472 false] [17592186068560 1100 "Evaluate the integral $\\displaystyle \\int_0^1 (t^2+1)e^{2t+1} \\, \\textrm{d} t.$" 13194139534472 true] [17592186068560 1145 "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{bmatrix}u = x^{2} & ⟹\\frac{du}{dx} = 2x \\\\ \\frac{dv}{dx} = e^{2x} & ⟹v = \\int\\frac{dv}{dx}dx = \\inte^{2x}dx = \\frac{e^{2x}}{2}\\end{bmatrix}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\n\\intx^{2}e^{2x}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (x^{2})(\\frac{e^{2x}}{2}) - \\int(\\frac{e^{2x}}{2})(2x)dx \\\\\n&= \\frac{x^{2}e^{2x}}{2} - \\intxe^{2x}dx\n\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int xe^{2x}\\,\\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = x & ⟹\\frac{du}{dx} = 1 \\\\ \\frac{dv}{dx} = e^{2x} & ⟹v = \\int\\frac{dv}{dx}dx = \\inte^{2x}dx = \\frac{e^{2x}}{2}\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intxe^{2x}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= x(\\frac{e^{2x}}{2}) - \\int(\\frac{e^{2x}}{2})(1)dx \\\\\n&= \\frac{xe^{2x}}{2} - \\frac{1}{2}\\inte^{2x}dx \\\\\n&= \\frac{xe^{2x}}{2} - \\frac{e^{2x}}{4} + D\n\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\n\\intx^{2}e^{2x}dx &= \\frac{x^{2}e^{2x}}{2} - (\\frac{xe^{2x}}{2} - \\frac{e^{2x}}{4} + D) \\\\\n&= \\frac{x^{2}e^{2x}}{2} - \\frac{xe^{2x}}{2} + \\frac{e^{2x}}{4} + C \\\\\n&= \\frac{e^{2x}}{4}(2x^{2} - 2x + 1) + C\n\\end{aligned}\n$$\n\nwhere $C =-D$." 13194139534472 false] [17592186068560 1145 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of inte