73e388cc467" :answer/id #uuid "6224daa1-5612-55ca-9402-a871777c6579" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316995/field-4" :answer-field/id #uuid "b1bc8f55-70ad-5d35-aa95-f3f0ab99cbcc" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316995/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-316995/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-316995" :question/id #uuid "abda4c5f-4458-5997-8719-4388299d2382" :question/math-academy-id "q-316995" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}3x=6 \\\\ 2x+z=2 \\\\ 3x+4y-2z=0\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | {{field-1}} | $0$ | $0$ |  |  |  | $x$ |  |  |  | $6$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $2$ | {{field-2}} | $1$ |  |  |  | $y$ |  | $=$ |  | $2$ |  | . |\n|  |  | $3$ | {{field-3}} | $-2$ |  |  |  | $z$ |  |  |  | {{field-4}} |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}3x+0y+0z=6 \\\\ 2x+0y+z=2 \\\\ 3x+4y-2z=0\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & 0 & 0 \\\\ 2 & 0 & 1 \\\\ 3 & 4 & -2\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}6 \\\\ 2 \\\\ 0\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & 0 & 0 \\\\ 2 & 0 & 1 \\\\ 3 & 4 & -2\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}6 \\\\ 2 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316995/field-1" "q-316995/field-2" "q-316995/field-3" "q-316995/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-316995"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316988/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6472fec5-a27a-5951-84f8-172657856e85" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316988/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4aa810ac-4e37-5925-aa53-4ec238a4d087" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-316988/field-1" :answer-field/id #uuid "302ec528-7e27-52a3-96f8-7310e12bba6c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316988/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-316988/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-316988/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-316988/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fae26bc2-ceda-5e9d-8e43-6adc36d30557" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-316988/field-2" :answer-field/id #uuid "56667189-7105-5a89-bbc1-ebc527286ce2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316988/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-316988/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-316988/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7e3804e7-9f2d-515e-94ce-3ff65ba8ead8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-316988/field-3" :answer-field/id #uuid "4fbe0f0b-d5db-5dc4-b240-c301e635fd3c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316988/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-316988/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-316988/field-4/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7456e1a9-a308-5389-b5cd-2f4b1bec655d" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-316988/field-4" :answer-field/id #uuid "34e98f0a-72bd-5167-8153-c3c07aa558fb" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316988/field-4/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-316988/field-4/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-316988" :question/id #uuid "0d7c60ce-62ca-5e1c-b6e9-61994a92ea9e" :question/math-academy-id "q-316988" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}2x-y=14 \\\\ 3x+3y+z=3 \\\\ 5x-8y+4z=-7\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $2$ | $-1$ | {{field-1}} |  |  |  | $x$ |  |  |  | $14$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-2}} | $3$ | $1$ |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | {{field-4}} | $-8$ | $4$ |  |  |  | $z$ |  |  |  | $-7$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}2x-y+0z=14 \\\\ 3x+3y+z=3 \\\\ 5x-8y+4z=-7\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}2 & -1 & 0 \\\\ 3 & 3 & 1 \\\\ 5 & -8 & 4\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}14 \\\\ 3 \\\\ -7\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}2 & -1 & 0 \\\\ 3 & 3 & 1 \\\\ 5 & -8 & 4\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}14 \\\\ 3 \\\\ -7\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316988/field-1" "q-316988/field-2" "q-316988/field-3" "q-316988/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-316988"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36178/selection/9bb92f295f9d398972cee53e8979e0a4a8c85608e039937d688ba632107cae63" :answer/id #uuid "f44fe60c-2ef1-503f-8a23-4dd970502654" :answer/type :answer.type/math :answer/value "a=-4,\\,b=-5,\\,c=8" :db/ensure [:answer/validate]} {:db/id "q-36178/selection/116cf5517f38ea052147bcb3db94642fe4ef1c382c7f561d54deb255725e514b" :answer/id #uuid "4e552ae7-7bc1-5865-9d1b-324da8707b72" :answer/type :answer.type/math :answer/value "a=-4,\\,b=0,\\,c=4" :db/ensure [:answer/validate]} {:db/id "q-36178/selection/8b8fa67c7578f9cd457266f4750f172e16755b65e636e733964cf6ecb80cdbf9" :answer/id #uuid "227c079f-4f66-5d1a-b6b1-f92e10a96aee" :answer/type :answer.type/math :answer/value "a=8,\\,b=-5,\\,c=-4" :db/ensure [:answer/validate]} {:db/id "q-36178/selection/19a246f7348f179856ec3f1a7604624fd3db4fdd5caa79a9ed9c9b37ddba0f86" :answer/id #uuid "a0356dda-e531-5623-b8d9-80e07685872c" :answer/type :answer.type/math :answer/value "a=-2,\\,b=7,\\,c=-5" :db/ensure [:answer/validate]} {:db/id "q-36178/selection/a8404fa35ee205080a05102e464e5d902320f2279200b4e12083361aae03f2d0" :answer/id #uuid "b30cace5-a6a3-5cfc-b4ca-eabf2565610a" :answer/type :answer.type/math :answer/value "a=3,\\,b=4,\\,c=7" :db/ensure [:answer/validate]} {:db/id "q-36178/selection" :answer-field/id #uuid "6ca0e6c5-dbee-5cec-b15c-a80819a6b68e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36178/selection/8b8fa67c7578f9cd457266f4750f172e16755b65e636e733964cf6ecb80cdbf9" :answer-field/choices ["q-36178/selection/9bb92f295f9d398972cee53e8979e0a4a8c85608e039937d688ba632107cae63" "q-36178/selection/116cf5517f38ea052147bcb3db94642fe4ef1c382c7f561d54deb255725e514b" "q-36178/selection/8b8fa67c7578f9cd457266f4750f172e16755b65e636e733964cf6ecb80cdbf9" "q-36178/selection/19a246f7348f179856ec3f1a7604624fd3db4fdd5caa79a9ed9c9b37ddba0f86" "q-36178/selection/a8404fa35ee205080a05102e464e5d902320f2279200b4e12083361aae03f2d0"] :db/ensure [:answer-field/validate]} {:db/id "q-36178" :question/id #uuid "7453f1a6-06ff-5426-872e-583972ef69f7" :question/math-academy-id "q-36178" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}3x+2y+8z=0 \\\\ 2x-5y+4z=3 \\\\ 5x-4y+7z=-2\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}3 & 2 & a \\\\ 2 & b & 4 \\\\ 5 & c & 7\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "We can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & 2 & 8 \\\\ 2 & -5 & 4 \\\\ 5 & -4 & 7\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & 2 & 8 \\\\ 2 & -5 & 4 \\\\ 5 & -4 & 7\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}].\n$$\n\nTherefore, $a=8,\\,b=-5,\\,c=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36178/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-36178"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316996/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "211331a5-5bc2-53b2-a104-60cfd4109c0f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316996/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6ffbd0c6-7d03-5db1-969a-79c621dd2141" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-316996/field-1" :answer-field/id #uuid "bee265f2-a5c0-5dac-879f-cb97fc0316d7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316996/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-316996/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-316996/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-316996/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "26cfb14c-70ce-5dc9-807d-fe14c86275fa" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-316996/field-2" :answer-field/id #uuid "a56b554c-73f5-56f0-8559-85f126e7e9ae" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316996/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-316996/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-316996/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "bfbbbe57-ae60-5dbf-9730-71018a3508e3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-316996/field-3" :answer-field/id #uuid "33675dd4-e3f3-5061-bece-3d4171c9dcc8" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316996/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-316996/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-316996/field-4/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "9b7326ae-8da1-545f-b98f-8c0a0cb140d6" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-316996/field-4" :answer-field/id #uuid "2ed3d2d8-4f1c-594f-a23f-9c182a9b15fd" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316996/field-4/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-316996/field-4/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-316996" :question/id #uuid "0de4893d-7cb9-56f5-b35a-b2fd344e566c" :question/math-academy-id "q-316996" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}3x+2y-z=1 \\\\ y-3z=0 \\\\ 4z=12\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $3$ | $2$ | $-1$ |  |  |  | $x$ |  |  |  | $1$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-1}} | $1$ | {{field-2}} |  |  |  | $y$ |  | $=$ |  | $0$ |  | . |\n|  |  | $0$ | {{field-3}} | $4$ |  |  |  | $z$ |  |  |  | {{field-4}} |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}3x+2y-z=1 \\\\ 0x+y-3z=0 \\\\ 0x+0y+4z=12\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & 2 & -1 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 4\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}1 \\\\ 0 \\\\ 12\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & 2 & -1 \\\\ 0 & 1 & -3 \\\\ 0 & 0 & 4\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 12\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316996/field-1" "q-316996/field-2" "q-316996/field-3" "q-316996/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-316996"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10004/selection/9c6b1bd11a0b8c37f5c54dfacf7fafa1bb9b406d99687236a13270765eef8e6e" :answer/id #uuid "e8fcbeb0-9818-57ae-af33-404b048bd0d9" :answer/type :answer.type/math :answer/value "a=0,\\,b=1,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-10004/selection/60f0c6e540a97bb8727cb5a5023a57dccc19def0c8215cdf1811e2c3c816eabc" :answer/id #uuid "c0869953-cbba-5058-a785-8f07fc88b8c4" :answer/type :answer.type/math :answer/value "a=1,\\,b=1,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-10004/selection/5d05dcbc196884d6f814d71135f6c97da4b4d40a9f7fbe341798ea98e82332f2" :answer/id #uuid "1f19f323-2c60-5225-b5bf-e30b8b81cb26" :answer/type :answer.type/math :answer/value "a=1,\\,b=1,\\,c=-3" :db/ensure [:answer/validate]} {:db/id "q-10004/selection/d7b4a8cf9ddf797d572c267881cf85d0e081dbd89cd9c801627d52d8383ff8ac" :answer/id #uuid "deefe8ad-ad6c-5901-95a4-efaef5b11775" :answer/type :answer.type/math :answer/value "a=1,\\,b=2,\\,c=3" :db/ensure [:answer/validate]} {:db/id "q-10004/selection/91b447ea442c2016b94397bfe67ce6d93d8c7c06b0cb64175b8c39a52cfab386" :answer/id #uuid "9e92977c-2b81-57ae-a9a4-f8a2b5d243bc" :answer/type :answer.type/math :answer/value "a=-1,\\,b=2,\\,c=1" :db/ensure [:answer/validate]} {:db/id "q-10004/selection" :answer-field/id #uuid "06cc8617-dfef-5744-9ccf-335b53835e97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10004/selection/60f0c6e540a97bb8727cb5a5023a57dccc19def0c8215cdf1811e2c3c816eabc" :answer-field/choices ["q-10004/selection/9c6b1bd11a0b8c37f5c54dfacf7fafa1bb9b406d99687236a13270765eef8e6e" "q-10004/selection/60f0c6e540a97bb8727cb5a5023a57dccc19def0c8215cdf1811e2c3c816eabc" "q-10004/selection/5d05dcbc196884d6f814d71135f6c97da4b4d40a9f7fbe341798ea98e82332f2" "q-10004/selection/d7b4a8cf9ddf797d572c267881cf85d0e081dbd89cd9c801627d52d8383ff8ac" "q-10004/selection/91b447ea442c2016b94397bfe67ce6d93d8c7c06b0cb64175b8c39a52cfab386"] :db/ensure [:answer-field/validate]} {:db/id "q-10004" :question/id #uuid "179abcfd-05e6-5251-a446-9e3e25a18f82" :question/math-academy-id "q-10004" :question/problem "The system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}y+2z=0 \\\\ x+2y+3z=2 \\\\ 3x+y+z=-3\\end{aligned}\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}0 & a & 2 \\\\ b & 2 & 3 \\\\ 3 & 1 & c\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}0x+y+2z=0 \\\\ x+2y+3z=2 \\\\ 3x+y+z=-3\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}].\n$$\n\nTherefore, $a=1,\\,b=1,\\,c=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10004/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-10004"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317639/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "41e238cb-f29e-57d0-8f3e-d2f4c23ec496" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-317639/field-1" :answer-field/id #uuid "44e67f2e-05e5-546d-b9f3-b00d09404ed5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317639/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-317639/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-317639/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "d6712f2b-9f76-5866-a29b-5ecfb25f4fd3" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-317639/field-2" :answer-field/id #uuid "8c514bcc-c4f8-50db-8205-47b1488a212c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317639/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-317639/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-317639/field-3/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "91f69603-c19d-55f9-bf41-9772335b0388" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-317639/field-3" :answer-field/id #uuid "5cdf3b0d-cbb4-50b0-bd5c-4de2c6bd9187" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317639/field-3/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-317639/field-3/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-317639/field-4/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "9a78dbe9-fa60-538c-b28a-34c6f0a9252a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-317639/field-4" :answer-field/id #uuid "1ed400a0-0d97-56a8-b30f-2c3c810f7c1b" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317639/field-4/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-317639/field-4/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-317639" :question/id #uuid "b2eb1f65-7297-5a4d-ba62-8b921fc0f9d9" :question/math-academy-id "q-317639" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}4z+x-3=7 \\\\ 2x-5y+6=1 \\\\ 3y+7z-4x+5=10\\end{aligned}\n$$\n\n \n\ncan be represented using matrix notation as\n\n|  |  | $1$ | $0$ | {{field-1}} |  |  |  | $x$ |  |  |  | $10$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $2$ | {{field-2}} | $0$ |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | {{field-4}} | $3$ | $7$ |  |  |  | $z$ |  |  |  | $5$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n{\\begin{aligned}x+0y+4z=10 \\\\ 2x-5y+0z=-5 \\\\ -4x+3y+7z=5\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}1 & 0 & 4 \\\\ 2 & -5 & 0 \\\\ -4 & 3 & 7\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}10 \\\\ -5 \\\\ 5\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}1 & 0 & 4 \\\\ 2 & -5 & 0 \\\\ -4 & 3 & 7\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}10 \\\\ -5 \\\\ 5\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317639/field-1" "q-317639/field-2" "q-317639/field-3" "q-317639/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7958ef60-8041-535b-bff8-b35e84c54412"] :knowledge-point/questions ["q-317639"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75513/selection/bd4aaa419e0eb7523b8a232822e006ebf7f1b4035dbdd6544949870d5f0fe73b" :answer/id #uuid "82af9219-a8e9-5cea-9940-f524459bde79" :answer/type :answer.type/math :answer/value "a=-5,\\,b=0,\\,c=-2" :db/ensure [:answer/validate]} {:db/id "q-75513/selection/053498415a402cae5f4f63a31a118029f9aa4bb985008f17a5c1fa807b396e17" :answer/id #uuid "6316cd7a-b7ca-5257-9772-c93e04ee0bbd" :answer/type :answer.type/math :answer/value "a=2,\\,b=0,\\,c=-2" :db/ensure [:answer/validate]} {:db/id "q-75513/selection/576c7365c8feac4ec9d2cb89dc56fdbb7aa6b6f480d79b2ba7b9e020a4ac9626" :answer/id #uuid "2a267c76-7132-5236-8435-cae7b7130bb3" :answer/type :answer.type/math :answer/value "a=2,\\,b=1,\\,c=-2" :db/ensure [:answer/validate]} {:db/id "q-75513/selection/163d8a921d7b822c34085db2c7d1488458fc932cfc7a1821e59120eef9ec92f4" :answer/id #uuid "a12b088f-6702-50c5-913d-d07c9d0b86ca" :answer/type :answer.type/math :answer/value "a=2,\\,b=2,\\,c=-2" :db/ensure [:answer/validate]} {:db/id "q-75513/selection/ecced0e69f8daf2f7757e45708b055dbc9d7a9d31a18d61c7bf033c9c48f7ba1" :answer/id #uuid "87fd2364-748f-5168-81dd-d54c680896ef" :answer/type :answer.type/math :answer/value "a=-5,\\,b=-1,\\,c=-2" :db/ensure [:answer/validate]} {:db/id "q-75513/selection" :answer-field/id #uuid "76a9c91d-c0e8-553a-ae3f-a93815fbc272" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75513/selection/576c7365c8feac4ec9d2cb89dc56fdbb7aa6b6f480d79b2ba7b9e020a4ac9626" :answer-field/choices ["q-75513/selection/bd4aaa419e0eb7523b8a232822e006ebf7f1b4035dbdd6544949870d5f0fe73b" "q-75513/selection/053498415a402cae5f4f63a31a118029f9aa4bb985008f17a5c1fa807b396e17" "q-75513/selection/576c7365c8feac4ec9d2cb89dc56fdbb7aa6b6f480d79b2ba7b9e020a4ac9626" "q-75513/selection/163d8a921d7b822c34085db2c7d1488458fc932cfc7a1821e59120eef9ec92f4" "q-75513/selection/ecced0e69f8daf2f7757e45708b055dbc9d7a9d31a18d61c7bf033c9c48f7ba1"] :db/ensure [:answer-field/validate]} {:db/id "q-75513" :question/id #uuid "cfc39e76-47ed-504b-8526-73e06adc538f" :question/math-academy-id "q-75513" :question/problem "The system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}z-5x+2y=0 \\\\ z=1-2x \\\\ 7y-3x-2z=0\\end{aligned}\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}-5 & a & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & c\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ b \\\\ 0\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\begin{aligned}{\\begin{aligned}-5x+2y+z=0 \\\\ 2x+0y+z=1 \\\\ -3x+7y-2z=0\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}-5 & 2 & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & -2\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}-5 & 2 & 1 \\\\ 2 & 0 & 1 \\\\ -3 & 7 & -2\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, $a=2,\\,b=1,\\,c=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75513/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7958ef60-8041-535b-bff8-b35e84c54412"] :knowledge-point/questions ["q-75513"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316998/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "4fb8022d-f88c-51d5-bdbb-02139e04049f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-316998/field-1" :answer-field/id #uuid "425dc2c3-ac67-52cd-94e9-006ef29400bf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316998/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-316998/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-316998/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "0f79e892-a39c-53e8-89b9-1a786484e44c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-316998/field-2" :answer-field/id #uuid "7ba4bf4a-abd6-5f9e-9b8c-d2d0adde7a4d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316998/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-316998/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-316998/field-3/ad06fa8bb7e77edd