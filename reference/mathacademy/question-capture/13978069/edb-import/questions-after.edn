#{[{:db/id #edb/ref 17592186278425 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3ab40e4-681d-5fb5-a137-e0d3f1769ce6" :answer/type {:db/ident :answer.type/math} :answer/value "z=4(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278427} {:answer/id #uuid "0343d9f1-8adc-5264-8457-700aa44c4475" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186278428} {:answer/id #uuid "acf51d53-ebcf-50fc-9117-ce6f5d3dabaa" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186278429} {:answer/id #uuid "7ca20a91-0055-535e-bc15-9afa3af1e2e1" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278430} {:answer/id #uuid "4f77f758-81fb-5b97-9247-65c5dabac5a6" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278431}] :answer-field/correct {:answer/id #uuid "4f77f758-81fb-5b97-9247-65c5dabac5a6" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278431} :answer-field/id #uuid "e16ee0ba-b5a8-5f88-8376-d08aee32e493" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278426}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "663d89fa-6933-5875-9f60-94f2abd7d111" :question/math-academy-id "q-107478" :question/problem "Express $z=\\frac{4}{1-\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1+\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1-\\text{i}} \\\\  & =\\frac{4(1+\\text{i})}{(1-\\text{i})(1+\\text{i})} \\\\  & =\\frac{4(1+\\text{i})}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{4(1+\\text{i})}{1+1} \\\\  & =2(1+\\text{i}) \\\\  & =2+2\\text{i}\\end{aligned}\n$$\n\n \n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=2+2\\text{i},$ the magnitude is \n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=2$ and $y=2$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{2}{2}) \\\\  & =\\operatorname{arctan}⁡1 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))\n$$"}] [{:db/id #edb/ref 17592186278432 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ee7ebe-98fd-5a33-bee4-535eeb797b9c" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186278434} {:answer/id #uuid "e56afc50-f55b-59a0-8b5c-f99d8ff7ade3" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4})" :db/id #edb/ref 17592186278435} {:answer/id #uuid "da2ef5f6-f7af-550f-94f1-33b120c84acf" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278436} {:answer/id #uuid "94366a7b-6797-5da8-96b7-252988ed66ea" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186278437} {:answer/id #uuid "7a66290d-b014-5aba-87d1-a858e8bd306e" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{5\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{4}))" :db/id #edb/ref 17592186278438}] :answer-field/correct {:answer/id #uuid "da2ef5f6-f7af-550f-94f1-33b120c84acf" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186278436} :answer-field/id #uuid "09d9464c-98e9-5d2d-964c-3d811c212b40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278433}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f613da52-505f-5404-adc3-5208cbe64ea2" :question/math-academy-id "q-107550" :question/problem "Express $z=\\frac{2\\text{i}}{1+\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1-\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{2\\text{i}}{1+\\text{i}} \\\\  & =\\frac{2\\text{i}(1-\\text{i})}{(1+\\text{i})(1-\\text{i})} \\\\  & =\\frac{2\\text{i}-2{\\text{i}}^{2}}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{2\\text{i}+2}{1+1} \\\\  & =1+\\text{i}.\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=1+\\text{i},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=1$ and $y=1$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{1}) \\\\  & =\\operatorname{arctan}⁡1 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))\n$$"}] [{:db/id #edb/ref 17592186278439 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05924717-2a38-5c3d-98d3-5a905885ec0d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186278441} {:answer/id #uuid "4e24df62-4520-5841-8d72-a78d619e7427" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186278442} {:answer/id #uuid "6bcb0258-0370-5d2f-8e0b-8e263dc0645c" :answer/type {:db/ident :answer.type/math} :answer/value "-2+\\text{i}" :db/id #edb/ref 17592186278443} {:answer/id #uuid "03e0f20d-0908-595f-b8d1-8c042c3759fc" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\text{i}" :db/id #edb/ref 17592186278444} {:answer/id #uuid "1177ee83-d62c-59e8-bf22-bfadebb8b2a2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186278445}] :answer-field/correct {:answer/id #uuid "1177ee83-d62c-59e8-bf22-bfadebb8b2a2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186278445} :answer-field/id #uuid "ce0affd4-a330-5b8b-9b89-58ec85efa8f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278440}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef36d68b-69d2-5646-aacf-1d23597ce561" :question/math-academy-id "q-107567" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi ))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\pi )=-1$ and $\\operatorname{sin}⁡(\\pi )=0,$ we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi )) \\\\  & =2(-1+\\text{i}\\cdot 0) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278446 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11173924-f470-535e-af7a-a9d22f50b7b2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186278448}] :answer-field/correct {:answer/id #uuid "11173924-f470-535e-af7a-a9d22f50b7b2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186278448} :answer-field/id #uuid "c6d755c0-7f14-54a5-bbcc-e613bc2ec08d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278447} {:answer-field/choices [{:answer/id #uuid "a5597b49-a9aa-52b2-9160-dd4714df2f85" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186278450}] :answer-field/correct {:answer/id #uuid "a5597b49-a9aa-52b2-9160-dd4714df2f85" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186278450} :answer-field/id #uuid "57d82154-7d5b-5c7f-8c4f-5fd4bbe14d9e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278449}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "23ea12f8-9a24-5e0b-91e4-c1511d048c42" :question/math-academy-id "q-324344" :question/problem "Express $z=8(\\operatorname{cos}⁡(\\frac{5\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{4}))$ in the form $z=x+y\\,\\text{i},$ where $x$ and $y$ are real numbers. Give the **exact** values of $x$ and $y.$\n\n$z=$\n{{field-1}}\n$-$\n{{field-2}}\n$i$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{5\\pi }{4})$ and $\\operatorname{sin}⁡(\\frac{5\\pi }{4}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{5\\pi }{4}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{5\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =8(\\operatorname{cos}⁡(\\frac{5\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{4})) \\\\  & =8(-\\frac{\\sqrt{2}}{2}+\\text{i}\\,(-\\frac{\\sqrt{2}}{2})) \\\\  & =-\\frac{8\\sqrt{2}}{2}-\\text{i}\\,\\frac{8\\sqrt{2}}{2} \\\\  & =-4\\sqrt{2}-4\\sqrt{2}\\,\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278451 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3817dea-427e-5e53-bd52-90c48de3ed02" :answer/type {:db/ident :answer.type/math} :answer/value "5+5\\text{i}" :db/id #edb/ref 17592186278453} {:answer/id #uuid "e8ad4f28-97c0-5e99-b5f2-5d8b3ad46e3c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186278454} {:answer/id #uuid "43284900-457c-56ce-9bc6-8ab74bef0ad0" :answer/type {:db/ident :answer.type/math} :answer/value "-5+5\\text{i}" :db/id #edb/ref 17592186278455} {:answer/id #uuid "07ff1a0c-8c51-5b6c-aa75-cb4b76ff5e6e" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\text{i}" :db/id #edb/ref 17592186278456} {:answer/id #uuid "c40e5907-388b-5096-b456-eb41edc615d6" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186278457}] :answer-field/correct {:answer/id #uuid "e8ad4f28-97c0-5e99-b5f2-5d8b3ad46e3c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186278454} :answer-field/id #uuid "c92f4f53-f1f5-5d69-91f7-84a5925be615" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278452}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "27867e5f-503f-55f0-90fd-c63c9bbf31c4" :question/math-academy-id "q-86608" :question/problem "Express $z=5(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi ))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\pi )=-1$ and $\\operatorname{sin}⁡(\\pi )=0,$ we have\n\n$$\n\\begin{aligned}z & =5(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi )) \\\\  & =5(-1+\\text{i}\\cdot 0) \\\\  & =-5.\\end{aligned}\n$$"}]}
