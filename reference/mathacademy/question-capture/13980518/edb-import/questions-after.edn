#{[{:db/id #edb/ref 17592186281100 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "591788d1-f55f-5720-a917-a7d70d7b5c49" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{20}{3}" :db/id #edb/ref 17592186281102} {:answer/id #uuid "7f2fc541-889b-5126-a2e0-5eccf7ce18c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186281103} {:answer/id #uuid "f34da75e-efc6-5e18-a5dc-3f37489a6b13" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{23}" :db/id #edb/ref 17592186281104} {:answer/id #uuid "1c69502c-a2d2-5be5-87a6-841219cdbb9b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{3}" :db/id #edb/ref 17592186281105} {:answer/id #uuid "679e44f2-6f95-57aa-8ea8-ef6b97091896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{32}" :db/id #edb/ref 17592186281106}] :answer-field/correct {:answer/id #uuid "1c69502c-a2d2-5be5-87a6-841219cdbb9b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{3}" :db/id #edb/ref 17592186281105} :answer-field/id #uuid "b1550654-810d-5e1f-849f-6765df10bb45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281101}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "428d9b88-f269-5db0-b633-82fc3de5cd40" :question/math-academy-id "q-100462" :question/problem "Find the value of $d$ that satisfies the equation ${9}^{d-4}={243}^{d+3}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $9={3}^{2}$ and $243={3}^{5}$ as follows:\n\n$$\n{({3}^{2})}^{d-4}={({3}^{5})}^{d+3}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{2(d-4)}={3}^{5(d+3)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $d:$\n\n$$\n\\begin{aligned}2(d-4) & =5(d+3) \\\\ 2d-8 & =5d+15 \\\\ -3d & =23 \\\\ d & =-\\frac{23}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281107 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0094fe7a-2467-56c2-91e7-8ff8ac19e1b6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186281109} {:answer/id #uuid "2223165d-c8f4-5f7c-91e1-20151475dd06" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281110} {:answer/id #uuid "f9cf0673-0755-5110-a06e-2880b9a5a3fe" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186281111} {:answer/id #uuid "d5d3b65e-58f0-5d2f-ad11-3577ed9bf557" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186281112} {:answer/id #uuid "feb9199d-6913-5e67-9a46-d69235f601cc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186281113}] :answer-field/correct {:answer/id #uuid "feb9199d-6913-5e67-9a46-d69235f601cc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186281113} :answer-field/id #uuid "3f4345a0-a8a9-5108-a6f9-13c49a8fb52a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281108}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2fcf27aa-bd7f-5c4c-a133-df0a431c2288" :question/math-academy-id "q-103081" :question/problem "The derivative of $y=x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{4}$ is" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(x-\\operatorname{tan}⁡x) \\\\  & =1-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =1-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =1-(\\sqrt{2})^{2} \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281114 :knowledge-point/_questions [{:knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "066962bf-e4c3-5c83-8151-ef8714e5e95d" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$ and $x=0$" :db/id #edb/ref 17592186281116} {:answer/id #uuid "cf6718f4-b45b-5819-a3bc-95f484229d65" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186281117} {:answer/id #uuid "7f597759-46b5-530c-bcd9-fa9268686357" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186281118} {:answer/id #uuid "accb6e9c-83c3-578f-8890-d64898fedbd7" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186281119} {:answer/id #uuid "d267a02a-abe1-503c-ac35-002d18aa2dfb" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-7$ and $x=0$" :db/id #edb/ref 17592186281120}] :answer-field/correct {:answer/id #uuid "cf6718f4-b45b-5819-a3bc-95f484229d65" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186281117} :answer-field/id #uuid "dd217fc8-7bd7-5eb5-af5b-5d3429783636" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281115}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "005baec8-159c-5d30-8dfd-3282724abca2" :question/math-academy-id "q-113525" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{3}{{x}^{3}+{x}^{2}+7x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{3}{{x}^{3}+{x}^{2}+7x} \\\\  & =\\frac{3}{x({x}^{2}+x+7)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx({x}^{2}+x+7)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x=0$ gives the solution $x=0.$\n\n- The equation ${x}^{2}+x+7=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={1}^{2}-4(1)(7) \\\\  & =1-28 \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, the only vertical asymptote is $x=0.$"}] [{:db/id #edb/ref 17592186281121 :knowledge-point/_questions [{:knowledge-point/id #uuid "74d05ad6-7e4a-5c50-92d1-ca4b2f00cbb1" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fd1702c-6e01-5754-8271-ac7b89851be4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186281123} {:answer/id #uuid "cb9996e0-19a6-5d01-9fdb-764b260469e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186281124} {:answer/id #uuid "8646fe34-fa28-5a36-8697-5ea5f3e9e3a5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{7}" :db/id #edb/ref 17592186281125} {:answer/id #uuid "f1797d55-6f7d-5505-9f22-ec5217f35478" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{8}" :db/id #edb/ref 17592186281126} {:answer/id #uuid "bfd045df-22da-5b4b-9b1e-ae1f6df8aa46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186281127}] :answer-field/correct {:answer/id #uuid "8646fe34-fa28-5a36-8697-5ea5f3e9e3a5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{7}" :db/id #edb/ref 17592186281125} :answer-field/id #uuid "8595e1ea-eae2-597b-952f-73c46d410adb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281122}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "269edd72-a80e-50b6-ad68-325c29bb6c28" :question/math-academy-id "q-124796" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980518/assets/ee92f92a52d8ade2052a62a5c19906cd86027b47f22ec986a740b9379e66d8d1.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{1}{8},$ use the Pythagorean identity to find $\\operatorname{tan}⁡\\theta .$" :question/worked-solution "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{8}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{1}{8}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =\\frac{1}{8}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{8})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{64}} \\\\  & =\\pm \\sqrt{\\frac{63}{64}} \\\\  & =\\pm \\frac{3\\sqrt{7}}{8}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{3\\sqrt{7}}{8}.$\n\nFinally, knowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{3\\sqrt{7}}{8})}{(\\frac{1}{8})}=3\\sqrt{7}.\n$$"}] [{:db/id #edb/ref 17592186281128 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2312006-bc4d-5c9a-8246-adf5c376afe8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186281130} {:answer/id #uuid "d7e2c9c7-1515-59b8-ad41-78133f569d73" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281131} {:answer/id #uuid "cd91a775-b0d4-5514-84e8-5c3b2adf172c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186281132} {:answer/id #uuid "d09048b6-8347-51e8-9956-d65b882b9582" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186281133} {:answer/id #uuid "6bed8bc3-491b-58b1-be42-5753c2588a5f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186281134}] :answer-field/correct {:answer/id #uuid "c2312006-bc4d-5c9a-8246-adf5c376afe8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186281130} :answer-field/id #uuid "c45f84b6-2305-5889-ae7a-59f61cd00589" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281129}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a413ad4d-6933-5f9a-b496-2be070e4b6bb" :question/math-academy-id "q-27442" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980518/assets/56433bbb908fde0c0a46f68665b9ac22360c00978238124b6fac9022576b3620.png)\n\nThe graph above shows the curve $y={(\\frac{1}{6})}^{x}+c.$ What is the value of $c?$" :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{6})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{6})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=3.$ Therefore, $c=3.$"}] [{:db/id #edb/ref 17592186281135 :knowledge-point/_questions [{:knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69069361-8b76-5d0e-a609-f060be54f7e4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186281137} {:answer/id #uuid "796d9c03-8884-5e74-8644-7b99e96a92b8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281138} {:answer/id #uuid "ee1c10de-be68-546e-89d7-6c6bce31ea8e" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186281139} {:answer/id #uuid "7c9e3412-b868-5fc7-b130-0f0ea9e47531" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186281140} {:answer/id #uuid "8e519c07-f571-5923-ad0e-ac376c5fb550" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281141}] :answer-field/correct {:answer/id #uuid "ee1c10de-be68-546e-89d7-6c6bce31ea8e" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186281139} :answer-field/id #uuid "b8f1bc3a-e66f-59b6-80b4-d09515d80d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281136}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8cbc83e7-bc89-5609-b94a-0fe1dfb1bde0" :question/math-academy-id "q-36905" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980518/assets/91f073fa77aab423ee33902451e61ad9f033b61b2a875b66ff69708d4361e24f.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that in each of the four given graphs, some horizontal lines intersect the curve more than once. Therefore, these are not one-to-one functions. As a result, none of them correspond to an invertible function."}] [{:db/id #edb/ref 17592186069290 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9344a77-a09e-5ea3-a235-97ed9a3e8b4e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-3.png" :db/id #edb/ref 17592186067272} {:answer/id #uuid "c58c6c4b-96db-5732-86ef-c523dc80b43d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-5.png" :db/id #edb/ref 17592186067273} {:answer/id #uuid "c59109c0-aaf7-56bc-aca1-4414be1c07e1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-1.png" :db/id #edb/ref 17592186067274} {:answer/id #uuid "d5acd7b9-a039-5007-bdac-2e7762331223" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-2.png" :db/id #edb/ref 17592186067275} {:answer/id #uuid "50b2847a-5749-52b1-aa3f-9b5a761159e5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-4.png" :db/id #edb/ref 17592186067276}] :answer-field/correct {:answer/id #uuid "c59109c0-aaf7-56bc-aca1-4414be1c07e1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/462/Source/Images/q-48081-a-1.png" :db/id #edb/ref 17592186067274} :answer-field/id #uuid "0ef32967-a397-5a87-b722-ecdc4ce1e26a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067271}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c05827a9-fdcf-58d8-bfea-b9a09196b4ea" :question/math-academy-id "q-48081" :question/problem "Select the function that is continuous at $x=2.$" :question/worked-solution "The correct answer is shown below.  Indeed, the graph can be drawn in a neighborhood of $x=2$ without taking our pencil off of the paper.\n\nAll the other given graphs contain breaks at $x=2$ and it would be impossible to draw them in a neighborhood of $x=2$ without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186281142 :knowledge-point/_questions [{:knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efa38dfd-ab13-532c-94ba-d17a224e8a8e" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-23" :db/id #edb/ref 17592186281144} {:answer/id #uuid "39bf0eac-7c48-5d70-b79b-881d89f635e3" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-7" :db/id #edb/ref 17592186281145} {:answer/id #uuid "a07a9fc6-8f61-56c1-803e-40b619e646de" :answer/type {:db/ident :answer.type/math} :answer/value "y=-12x+25" :db/id #edb/ref 17592186281146} {:answer/id #uuid "7de81cd5-7fe1-516a-8402-9d92e9f9528b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3x+7" :db/id #edb/ref 17592186281147} {:answer/id #uuid "c746d33c-94c2-5309-8bfc-b21be2ee4d5a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x+9" :db/id #edb/ref 17592186281148}] :answer-field/correct {:answer/id #uuid "efa38dfd-ab13-532c-94ba-d17a224e8a8e" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-23" :db/id #edb/ref 17592186281144} :answer-field/id #uuid "57ecfdee-6185-5487-8e6c-57e620afee45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281143}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "621014ba-46d4-530d-b830-042ea418b752" :question/math-academy-id "q-48666" :question/problem "Given that $f(x)={(5-3x)}^{4},$ find the equation of the tangent at point $(2,1).$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nWe use the chain rule to find $\\frac{\\text{d}f}{\\text{d}x}.$\n\nFirst, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=5-3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-3.\n$$\n\nMultiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (-3) \\\\  & =-12(5-3x)^{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at the point where $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=2} & =-12{(5-3(2))}^{3} \\\\  & =12.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(2,1)$ is $m=12.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =12(x-2) \\\\ y-1 & =12x-24 \\\\ y & =12x-23\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281149 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff58b9c7-a5fc-54dd-b70e-3ac13c195484" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=2{e}^{x}$ and $b=\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281151} {:answer/id #uuid "f8fa9a38-512c-5c4c-957a-ef047727566b" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)={e}^{2x}$ and $b=\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281152} {:answer/id #uuid "8dc3b0ba-87a0-5382-bb0f-1ff8949702b0" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=2{e}^{x}$ and $b=2\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281153} {:answer/id #uuid "c3b262c3-7043-5137-816b-2d7d8e664f27" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)={e}^{x}$ and $b=\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281154} {:answer/id #uuid "911aa7e1-f472-5ecf-b0e7-39fa5704683b" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)={e}^{x}$ and $b=2\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281155}] :answer-field/correct {:answer/id #uuid "ff58b9c7-a5fc-54dd-b70e-3ac13c195484" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=2{e}^{x}$ and $b=\\operatorname{ln}⁡2$" :db/id #edb/ref 17592186281151} :answer-field/id #uuid "d09793db-6d16-5b05-800e-e42e52935eec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281150}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6a62fd18-f127-592a-8fe3-1cc5a47bb7fb" :question/math-academy-id "q-49234" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{0}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=0.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{\\operatorname{ln}⁡2}{n}.$ Therefore, \n\n$$\n\\frac{\\operatorname{ln}⁡2}{n}=\\frac{b-0}{n}\\,⟹\\,b=\\operatorname{ln}⁡2.\n$$\n\nConsequently,  ${x}_{k}=\\frac{k\\operatorname{ln}⁡2}{n}$ and $f({x}_{k})=2{e}^{{x}_{k}}.$\n\nHence,\n\n$$\n{\\int }_{0}^{\\operatorname{ln}⁡2}2{e}^{x}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=2{e}^{x}$ and $b=\\operatorname{ln}⁡2.$"}] [{:db/id #edb/ref 17592186281156 :knowledge-point/_questions [{:knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f200ed44-e31b-55ca-b48b-df62ee0b5fbe" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)^{3}(x-2)(x-5)" :db/id #edb/ref 17592186281158} {:answer/id #uuid "1f5825eb-75ea-5ecc-ae87-6169c61ed6e0" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)(x-2)^{5}(x-5)" :db/id #edb/ref 17592186281159} {:answer/id #uuid "0781d7a3-f88c-52f6-8f67-7d592213648d" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)(x-2)^{2}(x-5)" :db/id #edb/ref 17592186281160} {:answer/id #uuid "1ea79802-9fb6-57d4-bba4-1741810d8156" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)^{2}(x-2)(x-5)^{2}" :db/id #edb/ref 17592186281161} {:answer/id #uuid "a826a460-0c9e-546c-b126-249647d2a766" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)(x-2)^{3}(x-5)^{2}" :db/id #edb/ref 17592186281162}] :answer-field/correct {:answer/id #uuid "1f5825eb-75ea-5ecc-ae87-6169c61ed6e0" :answer/type {:db/ident :answer.type/math} :answer/value "y=(x+1)(x-2)^{5}(x-5)" :db/id #edb/ref 17592186281159} :answer-field/id #uuid "dedc033b-48ea-576d-b20d-d6a581532791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281157}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "57df23a6-895d-5827-9b2f-f73c89216f9f" :question/math-academy-id "q-80350" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980518/assets/5e350d9b4db36831eac3ff0708a2acbc903c07265d4c6709632fb8a854121747.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-1$, $x=2$ and $x=5.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-1,$ this root is also a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=5,$ this root is also a simple root (the multiplicity equals $1$).\n\nFrom the given options, the only possible equation is $y=(x+1)(x-2)^{5}(x-5).$"}] [{:db/id #edb/ref 17592186281163 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55cd0e8a-8b5b-5936-82cb-bfb498384dd2" :answer/type {:db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186281165} {:answer/id #uuid "a034711d-c9e5-518a-8b08-d9711e8dcdae" :answer/type {:db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186281166} {:answer/id #uuid "be05638c-e920-5db6-b935-1f21a14fd573" :answer/type {:db/ident :answer.type/math} :answer/value "440" :db/id #edb/ref 17592186281167} {:answer/id #uuid "2733daab-272d-57d3-b1de-ae1b70b47398" :answer/type {:db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186281168} {:answer/id #uuid "d67dc377-a514-503e-a466-b5325ebad8cc" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186281169}] :answer-field/correct {:answer/id #uuid "55cd0e8a-8b5b-5936-82cb-bfb498384dd2" :answer/type {:db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186281165} :answer-field/id #uuid "607f52a2-efea-5074-bd98-6df7a11e6def" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281164}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bf619512-84f8-531d-a664-f93573147140" :question/math-academy-id "q-84994" :question/problem "Evaluate $(\\begin{aligned}12 \\\\ 3\\end{aligned}).$" :question/requires-calculator true :question/worked-solution "First, note that $(\\frac{12}{3})$ means the same thing as ${}_{12}{C}_{3}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=12$ and $r=3,$ we get\n\n$$\n\\begin{aligned}{}_{12}{C}_{3} & =\\frac{12!}{(12-3)!3!} \\\\  & =\\frac{12!}{9!3!} \\\\  & =\\frac{12\\cdot 11\\cdot 10\\cdot \\cancel{9!}}{\\cancel{9!}\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{12\\cdot 11\\cdot 10}{6} \\\\  & =220.\\end{aligned}\n$$"}]}
