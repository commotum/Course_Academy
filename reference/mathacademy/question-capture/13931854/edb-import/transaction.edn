lect $2$ of those digits, so we have $r=2.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{4}{C}_{2} & =\\frac{4!}{(4-2)!\\,2!} \\\\  & =\\frac{4!}{2!2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{2!\\cancel{2!}} \\\\  & =\\frac{4\\cdot 3}{2\\cdot 1} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-122557/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696"] :knowledge-point/questions ["q-122557"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86824/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "61434aaf-653a-5681-8c70-3f7b07c9e4ec" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-86824/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "39e3e5e1-d6f0-5ec0-8f05-6be9313e712e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-86824/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "c449f26a-ec8b-5339-8ecf-dc1f3e436853" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-86824/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "2a16a976-9638-5320-adc1-a7ee5787dcc9" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-86824/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "5570a31d-9d77-518e-a3d9-cd84392d53e2" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-86824/selection" :answer-field/id #uuid "2f82d001-87e2-5d8c-95d5-f927cddbf39c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86824/selection/56019ff80d11d678dbd5eca83c729f420f1b6