oup, so we have $r=4.$\n\nTherefore, the number of different groups of four friends is\n\n$$\n\\begin{aligned}{}_{7}{C}_{4} & =\\frac{7!}{(7-4)!\\,4!} \\\\  & =\\frac{7!}{3!4!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot \\cancel{4!}}{3!\\cancel{4!}} \\\\  & =\\frac{7\\cdot \\cancel{6}\\cdot 5}{\\cancel{6}} \\\\  & =7\\cdot 5 \\\\  & =35.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-122551/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "f2a80207-0171-5da5-8350-5b09dd30ed99" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-122551/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer/id #uuid "9e79d6ae-6cfa-5bdf-8216-4eaa58e059b7" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "q-122551/selection/a4993814b66f3ac515fa80efac383e7a872aae7ac54939897e15062c0b689124" :answer/id #uuid "91c4dc3d-9367-58cd-a0d7-0f365df97dc8" :answer/type :answer.type/math :answer/value "16\\,807" :db/ensure [:answer/validate]} {:db/id "q-122551/selection/5ff05dd5709bdc4ed242f909db90ecd2a53cfd67ab9e8fb405259792724fedd5" :answer/id #uuid "22f2aed7-e5b0-5356-8cbd-8123be9fdb29" :answer/type :answer.type/math :answer/value "2\\,520" :db/ensure [:answer/validate]} {:db/id "q-122551/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "1c95db42-0364-5a46-bee8-fb3b22154c18" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-122551/selection" :answer-field/id #uuid "d95e3027-7ce7-55a5-8102-55760b37e356" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122551/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer-field/choices ["q-122551/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-122551/select