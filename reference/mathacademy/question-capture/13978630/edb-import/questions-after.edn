#{[{:db/id #edb/ref 17592186278704 :knowledge-point/_questions [{:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6" :knowledge-point/title "Calculating the y-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1d49740-85d7-58b9-a984-3d2ff93cddf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278706}] :answer-field/correct {:answer/id #uuid "c1d49740-85d7-58b9-a984-3d2ff93cddf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278706} :answer-field/id #uuid "3f24f6f2-3176-56f2-8b27-3e5c708287b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278705} {:answer-field/choices [{:answer/id #uuid "53fcda15-4075-5c59-a89e-6810b3779231" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186278708}] :answer-field/correct {:answer/id #uuid "53fcda15-4075-5c59-a89e-6810b3779231" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186278708} :answer-field/id #uuid "7a90a74a-f436-5416-953e-1108052f80f8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278707}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d3a32c1-0f58-55ed-9e73-52c95d0d5346" :question/math-academy-id "q-274495" :question/problem "Calculate the point where the ellipse ${x}^{2}+6{y}^{2}+2x-12\\sqrt{3}y+18=0$ intercepts the $y$-axis.\n\nThe $y$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+6{y}^{2}+2x-12\\sqrt{3}y+18 & =0 \\\\ (0)^{2}+6{y}^{2}+2(0)-12\\sqrt{3}y+18 & =0 \\\\ 6{y}^{2}-12\\sqrt{3}y+18 & =0 \\\\ 6[{y}^{2}-2\\sqrt{3}y]+18 & =0 \\\\ 6[(y-\\sqrt{3})^{2}-3]+18 & =0 \\\\ 6(y-\\sqrt{3})^{2}-18+18 & =0 \\\\ 6(y-\\sqrt{3})^{2} & =0 \\\\ y-\\sqrt{3} & =0 \\\\ y & =\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\sqrt{3}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978630/assets/2d833daa50a68c13799763685b4ed961bd3d76d7708b6acb105b9eba6eb39211.png)"}] [{:db/id #edb/ref 17592186278709 :knowledge-point/_questions [{:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb" :knowledge-point/title "Calculating the y-Intercepts of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c57d73-211f-5f9b-a24b-fecfdb7d9dec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278711}] :answer-field/correct {:answer/id #uuid "a7c57d73-211f-5f9b-a24b-fecfdb7d9dec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278711} :answer-field/id #uuid "bf59b56a-2201-57ba-a17d-debecf47d75a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278710} {:answer-field/choices [{:answer/id #uuid "780e62ad-1dca-5796-8f1f-810deffc292f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278713}] :answer-field/correct {:answer/id #uuid "780e62ad-1dca-5796-8f1f-810deffc292f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278713} :answer-field/id #uuid "9ccbcf92-e738-523a-a089-5d0d6a3d4ec6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278712} {:answer-field/choices [{:answer/id #uuid "a056d34a-5cc0-5334-a095-adcabdd8afe2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{14}{5}" :db/id #edb/ref 17592186278715}] :answer-field/correct {:answer/id #uuid "a056d34a-5cc0-5334-a095-adcabdd8afe2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{14}{5}" :db/id #edb/ref 17592186278715} :answer-field/id #uuid "fa30dc44-6a4e-50f3-99eb-40f86b2c59c2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278714}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5cf3595a-3dd1-5635-8b87-e3ce4b4ff3e4" :question/math-academy-id "q-328528" :question/problem "From **top to bottom**, the ellipse $\\frac{(x-8)^{2}}{100}+\\frac{(y+1)^{2}}{9}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,\\frac{4}{5})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-8)^{2}}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ \\frac{(0-8)^{2}}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ \\frac{64}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ 144+25(y+1)^{2} & =225 \\\\ 25(y+1)^{2} & =81 \\\\ (y+1)^{2} & =\\frac{81}{25} \\\\ y+1 & =\\pm \\frac{9}{5} \\\\ y & =-1\\pm \\frac{9}{5} \\\\ y & =-\\frac{14}{5},\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,\\frac{4}{5})\\,\\text{and}\\,B(0,-\\frac{14}{5}).\n$$"}] [{:db/id #edb/ref 17592186278716 :knowledge-point/_questions [{:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c05d5af-db75-591a-9db9-5fb2c5146301" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 6\\sqrt{2},0)" :db/id #edb/ref 17592186278718} {:answer/id #uuid "04baf3dc-6e53-5ec6-8d2c-22c66597ee1a" :answer/type {:db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186278719} {:answer/id #uuid "c08e83d6-fbe4-5a09-8951-df2361ce02a1" :answer/type {:db/ident :answer.type/math} :answer/value "(-2-6\\sqrt{2},0)" :db/id #edb/ref 17592186278720} {:answer/id #uuid "dbcd5731-54b5-5342-9eda-1fe1480af6b0" :answer/type {:db/ident :answer.type/math} :answer/value "(-6\\sqrt{2},0)" :db/id #edb/ref 17592186278721} {:answer/id #uuid "cddba439-588a-5715-98de-726c67ec0a74" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\pm 6\\sqrt{2},0)" :db/id #edb/ref 17592186278722}] :answer-field/correct {:answer/id #uuid "04baf3dc-6e53-5ec6-8d2c-22c66597ee1a" :answer/type {:db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186278719} :answer-field/id #uuid "94db5a3c-1a9f-515d-968e-4116203c1941" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278717}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59316311-32d9-5b38-a573-15e21c936803" :question/math-academy-id "q-70184" :question/problem "Calculate the points where the ellipse ${x}^{2}+9{y}^{2}+4x+54y+76=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+9{y}^{2}+4x+54y+76 & =0 \\\\ {x}^{2}+9\\cdot {0}^{2}+4x+54\\cdot 0+76 & =0 \\\\ {x}^{2}+4x+76 & =0 \\\\ (x+2)^{2}-4+76 & =0 \\\\ (x+2)^{2}+72 & =0 \\\\ (x+2)^{2} & =-72.\\end{aligned}\n$$\n\nSince $(x+2)^{2}\\ge 0$, there is no $x$ such that $(x+2)^{2}=-72.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point."}] [{:db/id #edb/ref 17592186278723 :knowledge-point/_questions [{:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94efc4a9-e39b-5e94-9b51-05a8e61edf42" :answer/type {:db/ident :answer.type/math} :answer/value "(1\\pm \\frac{\\sqrt{2}}{3},0)" :db/id #edb/ref 17592186278725} {:answer/id #uuid "57d38dcb-dbea-5376-ab54-51f870cefbc0" :answer/type {:db/ident :answer.type/math} :answer/value "(1\\pm \\frac{\\sqrt{5}}{3},0)" :db/id #edb/ref 17592186278726} {:answer/id #uuid "11e2cba1-9e5b-5231-94fd-5723be83b14b" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\pm 3\\sqrt{2},0)" :db/id #edb/ref 17592186278727} {:answer/id #uuid "ac949fd2-6615-5eb9-a12a-3846ac8bfd5d" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\pm \\frac{2\\sqrt{5}}{3},0)" :db/id #edb/ref 17592186278728} {:answer/id #uuid "9b2feb82-04c9-5066-a2f0-14b4c4076234" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\pm \\sqrt{5},0)" :db/id #edb/ref 17592186278729}] :answer-field/correct {:answer/id #uuid "ac949fd2-6615-5eb9-a12a-3846ac8bfd5d" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\pm \\frac{2\\sqrt{5}}{3},0)" :db/id #edb/ref 17592186278728} :answer-field/id #uuid "da3452b0-d0b6-5bf8-bd32-5a1d9231f9b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278724}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "82249adf-2c55-575e-90cb-7bba0c1d440e" :question/math-academy-id "q-7645" :question/problem "Calculate the points where the ellipse  $9{x}^{2}+4{y}^{2}-36x+16y=-16$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}9{x}^{2}+4{y}^{2}-36x+16y & =-16 \\\\ 9{x}^{2}+4(0)^{2}-36x+16(0) & =-16 \\\\ 9{x}^{2}-36x & =-16 \\\\ {x}^{2}-4x & =-\\frac{16}{9} \\\\ (x-2)^{2}-{2}^{2} & =-\\frac{16}{9} \\\\ (x-2)^{2} & =-\\frac{16}{9}+4 \\\\ (x-2)^{2} & =-\\frac{16}{9}+\\frac{36}{9} \\\\ (x-2)^{2} & =\\frac{20}{9} \\\\ x-2 & =\\pm \\frac{2\\sqrt{5}}{3} \\\\ x & =2\\pm \\frac{2\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\frac{2\\sqrt{5}}{3},0)$ and $(2+\\frac{2\\sqrt{5}}{3},0).$"}] [{:db/id #edb/ref 17592186278730 :knowledge-point/_questions [{:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb" :knowledge-point/title "Calculating the y-Intercepts of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6e39993-85b2-55b9-ae45-e5e28657c45d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1\\pm 3\\sqrt{2})" :db/id #edb/ref 17592186278732} {:answer/id #uuid "92902bb3-eac3-564a-b35f-a438e97b1ecc" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1\\pm 2\\sqrt{2})" :db/id #edb/ref 17592186278733} {:answer/id #uuid "1a34a1e0-91bc-5a43-8421-e3ea547cdac1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 3)" :db/id #edb/ref 17592186278734} {:answer/id #uuid "bb8ccd77-a72d-5347-87c3-4cb4211df4d1" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(0,5)$" :db/id #edb/ref 17592186278735} {:answer/id #uuid "b8d77f71-148a-53ba-b347-35b1fa5a3592" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-2)$ and $(0,4)$" :db/id #edb/ref 17592186278736}] :answer-field/correct {:answer/id #uuid "92902bb3-eac3-564a-b35f-a438e97b1ecc" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1\\pm 2\\sqrt{2})" :db/id #edb/ref 17592186278733} :answer-field/id #uuid "2a227b94-c541-5c26-a2d7-1c05d77e1175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278731}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0c416c8b-3c8f-530f-b355-f54317010186" :question/math-academy-id "q-9466" :question/problem "Calculate the points where the ellipse $\\frac{(x+1)^{2}}{5}+\\frac{(y-1)^{2}}{10}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ \\frac{(0+1)^{2}}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ \\frac{1}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ 2+(y-1)^{2} & =10 \\\\ (y-1)^{2} & =8 \\\\ y-1 & =\\pm 2\\sqrt{2} \\\\ y & =1\\pm 2\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,1-2\\sqrt{2})$ and $(0,1+2\\sqrt{2}).$"}]}
