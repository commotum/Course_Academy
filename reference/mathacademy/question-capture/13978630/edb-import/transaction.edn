[{:db/id "q-7645/selection/ac359202aa5e7ad5e2c3ab36bf6920bc4cadc30cbe3aed5ea0f06d85e15a4a7a" :answer/id #uuid "ac949fd2-6615-5eb9-a12a-3846ac8bfd5d" :answer/type :answer.type/math :answer/value "(2\\pm \\frac{2\\sqrt{5}}{3},0)" :db/ensure [:answer/validate]} {:db/id "q-7645/selection/860242241292f1f7229df7920a4467c91377d3beb5bce73c0d64a775061bd142" :answer/id #uuid "11e2cba1-9e5b-5231-94fd-5723be83b14b" :answer/type :answer.type/math :answer/value "(-2\\pm 3\\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-7645/selection/214ed286901f7cef6ed0467bfe5646861413482cc42c229f219c7685b1389a54" :answer/id #uuid "94efc4a9-e39b-5e94-9b51-05a8e61edf42" :answer/type :answer.type/math :answer/value "(1\\pm \\frac{\\sqrt{2}}{3},0)" :db/ensure [:answer/validate]} {:db/id "q-7645/selection/7102a9de40cb6a734c5f0c9b6e93ac3bf3c4d83968adb0681950eb2c8d8a6894" :answer/id #uuid "57d38dcb-dbea-5376-ab54-51f870cefbc0" :answer/type :answer.type/math :answer/value "(1\\pm \\frac{\\sqrt{5}}{3},0)" :db/ensure [:answer/validate]} {:db/id "q-7645/selection/eed107d7f3bf9d4d0443c4b629fda7c45e802a83bbad8e232c3ab14dd4cbe8b3" :answer/id #uuid "9b2feb82-04c9-5066-a2f0-14b4c4076234" :answer/type :answer.type/math :answer/value "(2\\pm \\sqrt{5},0)" :db/ensure [:answer/validate]} {:db/id "q-7645/selection" :answer-field/id #uuid "da3452b0-d0b6-5bf8-bd32-5a1d9231f9b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7645/selection/ac359202aa5e7ad5e2c3ab36bf6920bc4cadc30cbe3aed5ea0f06d85e15a4a7a" :answer-field/choices ["q-7645/selection/ac359202aa5e7ad5e2c3ab36bf6920bc4cadc30cbe3aed5ea0f06d85e15a4a7a" "q-7645/selection/860242241292f1f7229df7920a4467c91377d3beb5bce73c0d64a775061bd142" "q-7645/selection/214ed286901f7cef6ed0467bfe5646861413482cc42c229f219c7685b1389a54" "q-7645/selection/7102a9de40cb6a734c5f0c9b6e93ac3bf3c4d83968adb0681950eb2c8d8a6894" "q-7645/selection/eed107d7f3bf9d4d0443c4b629fda7c45e802a83bbad8e232c3ab14dd4cbe8b3"] :db/ensure [:answer-field/validate]} {:db/id "q-7645" :question/id #uuid "82249adf-2c55-575e-90cb-7bba0c1d440e" :question/math-academy-id "q-7645" :question/problem "Calculate the points where the ellipse  $9{x}^{2}+4{y}^{2}-36x+16y=-16$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}9{x}^{2}+4{y}^{2}-36x+16y & =-16 \\\\ 9{x}^{2}+4(0)^{2}-36x+16(0) & =-16 \\\\ 9{x}^{2}-36x & =-16 \\\\ {x}^{2}-4x & =-\\frac{16}{9} \\\\ (x-2)^{2}-{2}^{2} & =-\\frac{16}{9} \\\\ (x-2)^{2} & =-\\frac{16}{9}+4 \\\\ (x-2)^{2} & =-\\frac{16}{9}+\\frac{36}{9} \\\\ (x-2)^{2} & =\\frac{20}{9} \\\\ x-2 & =\\pm \\frac{2\\sqrt{5}}{3} \\\\ x & =2\\pm \\frac{2\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\frac{2\\sqrt{5}}{3},0)$ and $(2+\\frac{2\\sqrt{5}}{3},0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7645/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-7645"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9466/selection/22f0b9e232efee716be09f39ed9982a15e7b304d266586624a5c5feaf65b4a79" :answer/id #uuid "d6e39993-85b2-55b9-ae45-e5e28657c45d" :answer/type :answer.type/math :answer/value "(0,1\\pm 3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-9466/selection/ac3af717d5979e3a75b9044f25a5f3b02e4715376cbbb753b146faded1ea47b8" :answer/id #uuid "1a34a1e0-91bc-5a43-8421-e3ea547cdac1" :answer/type :answer.type/math :answer/value "(0,\\pm 3)" :db/ensure [:answer/validate]} {:db/id "q-9466/selection/edfa52a18ab67b962fef8f676171c28872d6e81aefbe1bd63c8dc2453d9e20a0" :answer/id #uuid "b8d77f71-148a-53ba-b347-35b1fa5a3592" :answer/type :answer.type/text :answer/value "$(0,-2)$ and $(0,4)$" :db/ensure [:answer/validate]} {:db/id "q-9466/selection/720c097e47d0992cf6aa69d07987d5e43e378c62178cbf2d21ed6470b44438b1" :answer/id #uuid "92902bb3-eac3-564a-b35f-a438e97b1ecc" :answer/type :answer.type/math :answer/value "(0,1\\pm 2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-9466/selection/d033ff04acbf99ce1836a29bcd9b357d316c4420ff8d69c8c7f7b485305d559d" :answer/id #uuid "bb8ccd77-a72d-5347-87c3-4cb4211df4d1" :answer/type :answer.type/text :answer/value "$(0,-1)$ and $(0,5)$" :db/ensure [:answer/validate]} {:db/id "q-9466/selection" :answer-field/id #uuid "2a227b94-c541-5c26-a2d7-1c05d77e1175" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9466/selection/720c097e47d0992cf6aa69d07987d5e43e378c62178cbf2d21ed6470b44438b1" :answer-field/choices ["q-9466/selection/22f0b9e232efee716be09f39ed9982a15e7b304d266586624a5c5feaf65b4a79" "q-9466/selection/ac3af717d5979e3a75b9044f25a5f3b02e4715376cbbb753b146faded1ea47b8" "q-9466/selection/edfa52a18ab67b962fef8f676171c28872d6e81aefbe1bd63c8dc2453d9e20a0" "q-9466/selection/720c097e47d0992cf6aa69d07987d5e43e378c62178cbf2d21ed6470b44438b1" "q-9466/selection/d033ff04acbf99ce1836a29bcd9b357d316c4420ff8d69c8c7f7b485305d559d"] :db/ensure [:answer-field/validate]} {:db/id "q-9466" :question/id #uuid "0c416c8b-3c8f-530f-b355-f54317010186" :question/math-academy-id "q-9466" :question/problem "Calculate the points where the ellipse $\\frac{(x+1)^{2}}{5}+\\frac{(y-1)^{2}}{10}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ \\frac{(0+1)^{2}}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ \\frac{1}{5}+\\frac{(y-1)^{2}}{10} & =1 \\\\ 2+(y-1)^{2} & =10 \\\\ (y-1)^{2} & =8 \\\\ y-1 & =\\pm 2\\sqrt{2} \\\\ y & =1\\pm 2\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,1-2\\sqrt{2})$ and $(0,1+2\\sqrt{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9466/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-9466"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70184/selection/556fc77a7eaeafe3ecdbd295442f69affb886cbff291ef19180d67f07d02a9d4" :answer/id #uuid "c08e83d6-fbe4-5a09-8951-df2361ce02a1" :answer/type :answer.type/math :answer/value "(-2-6\\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-70184/selection/69a2952f4f517c74e3a502e1efc6ee84adb2979ebafe8b4c2ecf748c0ddce22e" :answer/id #uuid "dbcd5731-54b5-5342-9eda-1fe1480af6b0" :answer/type :answer.type/math :answer/value "(-6\\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-70184/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" :answer/id #uuid "04baf3dc-6e53-5ec6-8d2c-22c66597ee1a" :answer/type :answer.type/text :answer/value "There is no $x$-intercept" :db/ensure [:answer/validate]} {:db/id "q-70184/selection/9af6eb3442feb18a2871dafe897bbefe7b5f9c35b5b0867ef6dccfddb6c5ab11" :answer/id #uuid "cddba439-588a-5715-98de-726c67ec0a74" :answer/type :answer.type/math :answer/value "(-2\\pm 6\\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-70184/selection/259c0b8b225670763aaf24d1f3a790a1fb59f4a8b9b1645c94efd42b1358c5b2" :answer/id #uuid "4c05d5af-db75-591a-9db9-5fb2c5146301" :answer/type :answer.type/math :answer/value "(\\pm 6\\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-70184/selection" :answer-field/id #uuid "94db5a3c-1a9f-515d-968e-4116203c1941" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70184/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" :answer-field/choices ["q-70184/selection/556fc77a7eaeafe3ecdbd295442f69affb886cbff291ef19180d67f07d02a9d4" "q-70184/selection/69a2952f4f517c74e3a502e1efc6ee84adb2979ebafe8b4c2ecf748c0ddce22e" "q-70184/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" "q-70184/selection/9af6eb3442feb18a2871dafe897bbefe7b5f9c35b5b0867ef6dccfddb6c5ab11" "q-70184/selection/259c0b8b225670763aaf24d1f3a790a1fb59f4a8b9b1645c94efd42b1358c5b2"] :db/ensure [:answer-field/validate]} {:db/id "q-70184" :question/id #uuid "59316311-32d9-5b38-a573-15e21c936803" :question/math-academy-id "q-70184" :question/problem "Calculate the points where the ellipse ${x}^{2}+9{y}^{2}+4x+54y+76=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+9{y}^{2}+4x+54y+76 & =0 \\\\ {x}^{2}+9\\cdot {0}^{2}+4x+54\\cdot 0+76 & =0 \\\\ {x}^{2}+4x+76 & =0 \\\\ (x+2)^{2}-4+76 & =0 \\\\ (x+2)^{2}+72 & =0 \\\\ (x+2)^{2} & =-72.\\end{aligned}\n$$\n\nSince $(x+2)^{2}\\ge 0$, there is no $x$ such that $(x+2)^{2}=-72.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70184/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-70184"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274495/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c1d49740-85d7-58b9-a984-3d2ff93cddf5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-274495/field-1" :answer-field/id #uuid "3f24f6f2-3176-56f2-8b27-3e5c708287b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274495/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-274495/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-274495/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "53fcda15-4075-5c59-a89e-6810b3779231" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-274495/field-2" :answer-field/id #uuid "7a90a74a-f436-5416-953e-1108052f80f8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274495/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-274495/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-274495" :question/id #uuid "9d3a32c1-0f58-55ed-9e73-52c95d0d5346" :question/math-academy-id "q-274495" :question/problem "Calculate the point where the ellipse ${x}^{2}+6{y}^{2}+2x-12\\sqrt{3}y+18=0$ intercepts the $y$-axis.\n\nThe $y$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+6{y}^{2}+2x-12\\sqrt{3}y+18 & =0 \\\\ (0)^{2}+6{y}^{2}+2(0)-12\\sqrt{3}y+18 & =0 \\\\ 6{y}^{2}-12\\sqrt{3}y+18 & =0 \\\\ 6[{y}^{2}-2\\sqrt{3}y]+18 & =0 \\\\ 6[(y-\\sqrt{3})^{2}-3]+18 & =0 \\\\ 6(y-\\sqrt{3})^{2}-18+18 & =0 \\\\ 6(y-\\sqrt{3})^{2} & =0 \\\\ y-\\sqrt{3} & =0 \\\\ y & =\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\sqrt{3}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978630/assets/2d833daa50a68c13799763685b4ed961bd3d76d7708b6acb105b9eba6eb39211.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-274495/field-1" "q-274495/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-274495"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328528/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a7c57d73-211f-5f9b-a24b-fecfdb7d9dec" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328528/field-1" :answer-field/id #uuid "bf59b56a-2201-57ba-a17d-debecf47d75a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328528/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328528/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "780e62ad-1dca-5796-8f1f-810deffc292f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328528/field-2" :answer-field/id #uuid "9ccbcf92-e738-523a-a089-5d0d6a3d4ec6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328528/field-3/64515838824fec853110cb047bb1ab1f3cc99b0b930047953ceb50a3d3d48891" :answer/id #uuid "a056d34a-5cc0-5334-a095-adcabdd8afe2" :answer/type :answer.type/math :answer/value "-\\frac{14}{5}" :db/ensure [:answer/validate]} {:db/id "q-328528/field-3" :answer-field/id #uuid "fa30dc44-6a4e-50f3-99eb-40f86b2c59c2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328528/field-3/64515838824fec853110cb047bb1ab1f3cc99b0b930047953ceb50a3d3d48891" :answer-field/choices ["q-328528/field-3/64515838824fec853110cb047bb1ab1f3cc99b0b930047953ceb50a3d3d48891"] :db/ensure [:answer-field/validate]} {:db/id "q-328528" :question/id #uuid "5cf3595a-3dd1-5635-8b87-e3ce4b4ff3e4" :question/math-academy-id "q-328528" :question/problem "From **top to bottom**, the ellipse $\\frac{(x-8)^{2}}{100}+\\frac{(y+1)^{2}}{9}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,\\frac{4}{5})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-8)^{2}}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ \\frac{(0-8)^{2}}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ \\frac{64}{100}+\\frac{(y+1)^{2}}{9} & =1 \\\\ 144+25(y+1)^{2} & =225 \\\\ 25(y+1)^{2} & =81 \\\\ (y+1)^{2} & =\\frac{81}{25} \\\\ y+1 & =\\pm \\frac{9}{5} \\\\ y & =-1\\pm \\frac{9}{5} \\\\ y & =-\\frac{14}{5},\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,\\frac{4}{5})\\,\\text{and}\\,B(0,-\\frac{14}{5}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328528/field-1" "q-328528/field-2" "q-328528/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-328528"] :db/ensure [:knowledge-point/validate]}]
