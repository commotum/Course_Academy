[{:db/id [:question/math-academy-id "q-92875"] :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[3]{5x+12}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{5x+12}-3 & =0 \\\\ \\sqrt[3]{5x+12} & =3 \\\\ (\\sqrt[3]{5x+12})^{3} & ={3}^{3} \\\\ 5x+12 & =27 \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-102545/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" :answer/id #uuid "7b604016-ce78-55c0-9e17-daa28e9dcfcd" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "q-102545/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" :answer/id #uuid "ad7a271d-8884-58ff-8ac6-3254560f07bd" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "q-102545/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "f1e54b55-47e0-54f4-b9e9-a394e5b79033" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-102545/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" :answer/id #uuid "4f9f321e-b535-58a1-a3d2-852f4bc9203e" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "q-102545/selection/264ed6922279f92bdc90c36a26ea47de8f6c6ab903ed9e63c8b8bb51a5a9d4f6" :answer/id #uuid "7517f8d7-e984-53f5-b2a3-15dcce0019b7" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "q-102545/selection" :answer-field/id #uuid "15596994-e494-53af-9506-04e001c418e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102545/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer-field/choices ["q-102545/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" "q-102545/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" "q-102545/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-102545/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" "q-102545/selection/264ed6922279f92bdc90c36a26ea47de8f6c6ab903ed9e63c8b8bb51a5a9d4f6"] :db/ensure [:answer-field/validate]} {:db/id "q-102545" :question/id #uuid "b9cc0cb6-3d12-5892-83af-6e3357774de8" :question/math-academy-id "q-102545" :question/is-example false :question/problem "Find the root of $f(x)=\\sqrt[6]{11-5x}-1.$" :question/worked-solution "To find the roots of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[6]{11-5x}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[6]{11-5x}-1 & =0 \\\\ \\sqrt[6]{11-5x} & =1 \\\\ (\\sqrt[6]{11-5x})^{6} & ={1}^{6} \\\\ 11-5x & =1 \\\\ -5x & =-10 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[6]{11-5\\cdot 2}-1 & =0 \\\\ \\sqrt[6]{1}-1 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102545/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876"] :knowledge-point/questions ["q-102545"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102548/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "62a84128-1bb5-537a-9ce8-0fa10ffdf5f4" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-102548/selection/264ed6922279f92bdc90c36a26ea47de8f6c6ab903ed9e63c8b8bb51a5a9d4f6" :answer/id #uuid "bdbccbf6-613e-5761-9743-fe417282b929" :answer/type :answer.type/math :answer/value "x=3" :db/ensure