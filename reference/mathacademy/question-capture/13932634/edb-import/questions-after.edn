end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[6]{11-5\\cdot 2}-1 & =0 \\\\ \\sqrt[6]{1}-1 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=2.$"}] [{:db/id #edb/ref 17592186245373 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a45f4b4-931e-5c89-b3c0-67d63d1b9ee2" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186245375} {:answer/id #uuid "bdbccbf6-613e-5761-9743-fe417282b929" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186245376} {:answer/id #uuid "453198ac-2c8d-5dfc-a269-d369ccf48f07" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186245377} {:answer/id #uuid "62a84128-1bb5-537a-9ce8-0fa10ffdf5f4" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186245378} {:answer/id #uuid "6e7cb52b-4cca-5421-adae-b40b04649688" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186245379}] :answer-field/correct {:answer/id #uuid "1a45f4b4-931e-5c89-b3c0-67d63d1b9ee2" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186245375} :answer-field/id #uuid "86eae393-34a5-5fcf-9210-ca7baac5405c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245374}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "21e6eb75-d6ca-5925-b747-58f532d52df9" :question/is-example false :question/math-academy-id "q-102548" :question/problem "Find the root of $f(x)=-3\\sqrt[6]{2x-5}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-3\\sqrt[6]{2x-5}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-3\\sqrt[6]{2x-5}-3 & =0 \\\\ -3\\sqrt[6]{2x-5} & =3 \\\\ \\sqrt[6]{2x-5} & =-1\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root."}] [{:db/id #edb/ref 17592186245380 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "743a8da6-f55f-5b34-b76c-20af9a5ef9da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186245382}] :answer-field/correct {:answer/id #uuid "743a8da6-f55f-5b34-b76c-20af9a5ef9da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186245382} :answer-field/id #uuid "7132cf43-4e78-52fc-af72-55cffcacd94c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245381}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "42d549bc-4fc3-5369-9de9-101c218700ad" :question/is-example false :question/math-academy-id "q-270607" :question/problem "Find the root of  $f(x)=\\sqrt[6]{24x+13}-1.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the roots of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[6]{24x+13}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[6]{24x+13}-1 & =0 \\\\ \\sqrt[6]{24x+13} & =1 \\\\ {(\\sqrt[6]{24x+13})}^{6} & ={1}^{6} \\\\ 24x+13 & =1 \\\\ 24x & =-12 \\\\ x & =-\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[6]{24\\cdot (-\\frac{1}{2})+13}-1 & =0 \\\\ \\sqrt[6]{1}-1 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186245383 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b7cebab-4370-58ab-a46b-14e5670e2c22" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186245385}] :answer-field/correct {:answer/id #uuid "6b7cebab-4370-58ab-a46b-14e5670e2c22" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186245385} :answer-field/id #uuid "316a0280-3f04-5ebb-9b33-35b0ffc43d8b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245384}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d26ae3f0-7bd0-505c-ac51-a94ff7ad74e3" :question/is-example false :question/math-academy-id "q-277229" :question/problem "Find the root of $f(x)=\\sqrt[3]{2x+10}-4.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[3]{2x+10}-4=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{2x+10}-4 & =0 \\\\ \\sqrt[3]{2x+10} & =4 \\\\ (\\sqrt[3]{2x+10})^{3} & ={4}^{3} \\\\ 2x+10 & =64 \\\\ 2x & =54 \\\\ x & =27\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=27.$"}] [{:db/id #edb/ref 17592186172535 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee105f5-10e6-5e87-8446-2e392e938687" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #e