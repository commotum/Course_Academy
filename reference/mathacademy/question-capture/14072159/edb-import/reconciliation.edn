ture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20782" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x-2y=-1 \\\\ -4x+8y=7.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" nil "attribute" "question/worked-solution" "value" "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & -2 & -1 \\\\ -4 & 8 & 7\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & -1 \\\\ -4 & 8 & 7\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-2y=-1 \\\\ 0x+0y=3.\\end{aligned}\n$$\n\nHowever, the final equation $0x+0y=3$ has no solution. It simplifies to $0=3,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/activity-metadata.json" "file_sha256" "bcec689ef0e7a2d099946511c921233b579bcaa37c05623c4d37f4a77f864b39" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2y-1 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2y-1 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "No solution"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-130923" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "No solution"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned}7x+14y=21 \\\\ 3x+6y=9.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" nil "attribute" "question/worked-solution" "value" "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}7 & 14 & 21 \\\\ 3 & 6 & 9\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}7 & 14 & 21 \\\\ 3 & 6 & 9\\end{aligned}] & {R}_{1} & :=\\frac{1}{7}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 \\\\ 3 & 6 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+2y=3 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+2y=3.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=3-2y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=3-2y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/activity-metadata.json" "file_sha256" "bcec689ef0e7a2d099946511c921233b579bcaa37c05623c4d37f4a77f864b39" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-42167" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "No solution"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" nil "attribute" "question/problem" "value" "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x+4y=2 \\\\ 2x+8y=4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" nil "attribute" "question/worked-solution" "value" "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & 4 & 2 \\\\ 2 & 8 & 4\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 4 & 2 \\\\ 2 & 8 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+4y=2 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+4y=2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=2-4y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=2-4y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/activity-metadata.json" "file_sha256" "bcec689ef0e7a2d099946511c921233b579bcaa37c05623c4d37f4a77f864b39" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865bdd2b51aa1" "basis" 1438 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/edb-import/verification.json"} {"question" "q-20783" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040382/state.json" "file_sha256" "c0b197e8d11a6415d81d6b1755946a3ae3f021e1f7909676de2865