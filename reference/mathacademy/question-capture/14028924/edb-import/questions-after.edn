#{[{:db/id #edb/ref 17592186292582 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d10003e-e238-561f-965d-ca8e8bc5bcaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{130}{3}" :db/id #edb/ref 17592186292584} {:answer/id #uuid "391ce9cb-d6aa-58e8-8ec5-2c77362af837" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186292585} {:answer/id #uuid "86f6d0e2-9cab-5335-b4f8-2498e858e7c7" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186292586} {:answer/id #uuid "9313ff00-554c-5bd0-bd90-1f0aa8babf78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{128}{3}" :db/id #edb/ref 17592186292587} {:answer/id #uuid "e818abdd-4715-5dea-8590-981eb4f9dd45" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186292588}] :answer-field/correct {:answer/id #uuid "86f6d0e2-9cab-5335-b4f8-2498e858e7c7" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186292586} :answer-field/id #uuid "3664306b-d653-5661-a66e-16eb430f0bf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292583}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5569eeb5-0bcc-5b4e-bf38-d2ef381ca646" :question/math-academy-id "q-13775" :question/problem "Evaluate ${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration,  we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{6x}\\,\\text{d}u \\\\  & =4{\\int }_{0}^{6\\operatorname{ln}⁡2}{e}^{u}\\frac{1}{6}\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{6})}{e}^{u}\\text{d}u \\\\  & =\\frac{2}{3}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({2}^{6})} \\\\  & =\\frac{2}{3}({e}^{\\operatorname{ln}⁡({2}^{6})}-{e}^{0}) \\\\  & =\\frac{2}{3}({2}^{6}-1) \\\\  & =\\frac{2}{3}(64-1) \\\\  & =\\frac{2}{3}\\cdot 63 \\\\  & =42\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292589 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "437b3d7a-ae7e-5f85-a530-f850f8a651de" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186292591} {:answer/id #uuid "eedfdebc-3c83-5df6-93ea-3bf49df49a43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186292592} {:answer/id #uuid "640b6cb3-9605-599c-b1b7-8c8ee960b8ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186292593} {:answer/id #uuid "3029f3f7-d872-5fc3-9bf6-008e899f8576" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}+C" :db/id #edb/ref 17592186292594} {:answer/id #uuid "037e7a04-4e66-5c2e-87aa-356bd7b351e0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186292595}] :answer-field/correct {:answer/id #uuid "437b3d7a-ae7e-5f85-a530-f850f8a651de" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186292591} :answer-field/id #uuid "0d8b1473-5ed1-5a30-9db3-f87ced55ff17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292590}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "42f9693c-f3ba-57a0-b42a-8ab479a6783c" :question/math-academy-id "q-31412" :question/problem "$\\int {5}^{-x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {5}^{-x}\\,\\text{d}x & =\\int {5}^{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int {5}^{u}\\,\\text{d}u \\\\  & =-\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292596 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d5ca77f-ced5-567f-a774-09b7f1253d3a" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186292598}] :answer-field/correct {:answer/id #uuid "8d5ca77f-ced5-567f-a774-09b7f1253d3a" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186292598} :answer-field/id #uuid "3563e3e1-b9e0-5459-b20f-d33ebd4b6fc9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292597}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c4da45de-a7c9-5198-ac6d-ba637b32d015" :question/math-academy-id "q-349596" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{3x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{3\\operatorname{ln}⁡4}{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{3})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({4}^{3})} \\\\  & =\\frac{5}{3}({e}^{\\operatorname{ln}⁡({4}^{3})}-{e}^{0}) \\\\  & =\\frac{5}{3}({4}^{3}-1) \\\\  & =\\frac{5}{3}(64-1) \\\\  & =\\frac{5}{3}(63) \\\\  & =105\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292599 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aecf8f96-8703-53e1-b6bd-2d98534e9eaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{108}{\\ln(3)}" :db/id #edb/ref 17592186292601} {:answer/id #uuid "d35d1ef7-73eb-5212-abe0-7bc93dc74070" :answer/type {:db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186292602}] :answer-field/correct {:answer/id #uuid "aecf8f96-8703-53e1-b6bd-2d98534e9eaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{108}{\\ln(3)}" :db/id #edb/ref 17592186292601} :answer-field/id #uuid "4d4507c3-9f97-55f8-8ea3-d63777320a84" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292600}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "37febfc8-3e86-5f74-b4fc-3fa33474c542" :question/math-academy-id "q-349625" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}{3}^{7-2x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=7-2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $5$ | $3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{3}^{7-2x}\\,\\text{d}x & ={\\int }_{5}^{3}{3}^{u}(-\\frac{1}{2})\\text{d}u \\\\  & =-\\frac{1}{2}{\\int }_{5}^{3}{3}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{5}^{3} \\\\  & =-\\frac{1}{2\\operatorname{ln}⁡3}({3}^{3}-{3}^{5}) \\\\  & =-\\frac{1}{2\\operatorname{ln}⁡3}(27-243) \\\\  & =\\frac{108}{\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292603 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d335044a-a496-5936-bb09-a75c2f805a10" :answer/type {:db/ident :answer.type/math} :answer/value "3e^4-3" :db/id #edb/ref 17592186292605}] :answer-field/correct {:answer/id #uuid "d335044a-a496-5936-bb09-a75c2f805a10" :answer/type {:db/ident :answer.type/math} :answer/value "3e^4-3" :db/id #edb/ref 17592186292605} :answer-field/id #uuid "bcedbd3b-845c-5da7-920e-dfa7313c8c28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292604}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "498b4143-7da9-545f-a34c-c53985a2df2b" :question/math-academy-id "q-362689" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=-4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $0$ |\n| --- | --- | --- |\n| $u$ | $4$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x & =12{\\int }_{-1}^{0}{e}^{-4x}\\,\\text{d}x \\\\  & =12{\\int }_{4}^{0}{e}^{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-3{\\int }_{4}^{0}{e}^{u}\\,\\text{d}u \\\\  & =-3\\cdot {e}^{u}\\,{|}_{4}^{0} \\\\  & =-3({e}^{0}-{e}^{4}) \\\\  & =-3(1-{e}^{4}) \\\\  & =3{e}^{4}-3\\end{aligned}\n$$"}]}
