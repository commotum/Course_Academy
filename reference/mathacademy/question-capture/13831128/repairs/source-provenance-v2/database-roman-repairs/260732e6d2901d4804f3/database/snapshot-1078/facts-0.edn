5417] [17592186329249 #edb/ref 1075 #edb/ref 17592186328811 #edb/ref 17592186045417] [17592186329249 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186329249 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186329249 #edb/ref 1078 #edb/ref 17592186328065 #edb/ref 17592186045417] [17592186329249 #edb/ref 1079 #uuid "23e84077-b88d-5119-bcf7-6c45cbfd0278" #edb/ref 17592186045417] [17592186329581 #edb/ref 1075 #edb/ref 17592186327063 #edb/ref 17592186045417] [17592186329581 #edb/ref 1075 #edb/ref 17592186327540 #edb/ref 17592186045417] [17592186329581 #edb/ref 1075 #edb/ref 17592186328364 #edb/ref 17592186045417] [17592186329581 #edb/ref 1075 #edb/ref 17592186328460 #edb/ref 17592186045417] [17592186329581 #edb/ref 1075 #edb/ref 17592186328677 #edb/ref 17592186045417] [17592186329581 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186329581 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186329581 #edb/ref 1078 #edb/ref 17592186327063 #edb/ref 17592186045417] [17592186329581 #edb/ref 1079 #uuid "e45de7c6-c5ce-5b9d-a7b8-ea5254d09158" #edb/ref 17592186045417] [17592186329854 #edb/ref 1068 #edb/ref 17592186329581 #edb/ref 17592186045417] [17592186329854 #edb/ref 1069 "q-48062" #edb/ref 17592186045417] [17592186329854 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186329854 #edb/ref 1071 "![](images/d9/d9db7f2a491ae3065dbe8434a71d378c4fed8fec16c82e2fd76dcb209c786809.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. $f(x)$ is defined at $x=1$\n\nII. ${lim}_{x\\to \\,1}f(x)$ exists\n\nIII. $f(x)$ is continuous at $x=1$" #edb/ref 17592186045417] [17592186329854 #edb/ref 1072 #uuid "96069899-bca3-51de-b64c-6e29072ea13e" #edb/ref 17592186045417] [17592186329854 #edb/ref 1074 "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. From the graph we can see that no value has been assigned to $f(x)$ at $x=1.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{1}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, \n${lim}_{x\\to \\,1}f(x)=1.$\n\n- Statement III is false. The function is not even defined at $x=1.$ The graph contains a break at $x=1.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper." #edb/ref 17592186045417] [17592186329855 #edb/ref 1068 #edb/ref 17592186329249 #edb/ref 17592186045417] [17592186329855 #edb/ref 1069 "q-48065" #edb/ref 17592186045417] [17592186329855 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186329855 #edb/ref 1071 "![](images/fa/fa15192923f9fd7370818fcb6b05b24b3bb6901dfbf90dd53539d71fd0f8b0bf.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\nI. $f(x)$ is defined at $x=2$\n\nII. ${lim}_{x\\to \\,2}f(x)=f(2)$\n\nIII. $f(x)$ is continuous at $x=2$" #edb/ref 17592186045417] [17592186329855 #edb/ref 1072 #uuid "1e01edc7-98f4-52fe-bf43-cb1e05ae0d4a" #edb/ref 17592186045417] [17592186329855 #edb/ref 1074 "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(x)$ is defined at $x=2$ and $f(2)=1.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,2}f(x)=1=f(2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=2.$" #edb/ref 17592186045417] [17592186345366 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186345366 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186345366 #edb/ref 1083 #uuid "01aeaace-3dee-5861-928d-6a23090d00f2" #edb/ref 17592186045417] [17592186345367 #edb/ref 1080 "I and II only" #edb/ref 17592186045417] [17592186345367 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186345367 #edb/ref 1083 #uuid "01c007c5-b958-5f05-bcdb-d16eb849a4b8" #edb/ref 17592186045417] [17592186345368 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186345368 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186345368 #edb/ref 1083 #uuid "02100b32-fbcc-582d-903e-bf23af1e8c8e" #edb/ref 17592186045417] [17592186347068 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186347068 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186347068 #edb/ref 1083 #uuid "c5a6767c-d2f1-526e-934e-fbbf34e09777" #edb/ref 17592186045417] [17592186347512 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186347512 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186347512 #edb/ref 1083 #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" #edb/ref 17592186045417] [17592186347609 #edb/ref 1075 #edb/ref 17592186345366 #edb/ref 17592186045417] [17592186347609 #edb/ref 1075 #edb/ref 17592186345367 #edb/ref 17592186045417] [17592186347609 #edb/ref 1075 #edb/ref 17592186345368 #edb/ref 17592186045417] [17592186347609 #edb/ref 1075 #edb/ref 17592186347068 #edb/ref 17592186045417] [17592186347609 #edb/ref 1075 #edb/ref 17592186347512 #edb/ref 17592186045417] [17592186347609 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186347609 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186347609 #edb/ref 1078 #edb/ref 17592186347512 #edb/ref 17592186045417] [17592186347609 #edb/ref 1079 #uuid "01de2c48-cbc5-5a34-8784-842c895031e0" #edb/ref 17592186045417] [17592186348066 #edb/ref 1068 #edb/ref 17592186347609 #edb/ref 17592186045417] [17592186348066 #edb/ref 1069 "q-78132" #edb/ref 17592186045417] [17592186348066 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186348066 #edb/ref 1071 "![](images/89/890e7eaf519a65ca19d4a90b604e7d7a8ab7054635296c4b08f000546f23b545.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\nI. $x=-2$\n\nII. $x=1$\n\nIII. $x=3$" #edb/ref 17592186045417] [17592186348066 #edb/ref 1072 #uuid "5c2c6cc4-6d0f-5ca4-bd69-989208f699b4" #edb/ref 17592186045417] [17592186348066 #edb/ref 1074 "Let's consider each point separately.\n\n- The function $f(x)$ is continuous at $-2.$ The graph can be drawn in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is not continuous at $x=1.$ Since there is a jump at $x=1,$ it is impossible to draw the function in the neighborhood of $x=1$ without taking our pencil off of the paper.\n\n- Therefore, the function $f(x)$ is continuous $x=3.$ The graph can be drawn in the neighborhood of  $x=3$ without taking our pencil off of the paper.\n\nHence, the correct answer is  \"I and III only\".\n\n![](images/7c/7c96c401ddae0049859fd5608cb08c6ce9ae8a2e6c3db69d7d4b379b3824094e.png)" #edb/ref 17592186045417]}
