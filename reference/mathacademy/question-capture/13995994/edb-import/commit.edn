gned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}3 & 3 & 3 \\\\ 1 & 4 & 7 \\\\ 1 & -5 & -2\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{9}[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}].\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{9}[\\begin{aligned}3 & 1 & 1 \\\\ 3 & 4 & -5 \\\\ 3 & 7 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =-\\frac{1}{9}[\\begin{aligned}9 \\\\ 9 \\\\ 18\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$" 13194139534377 true] [17592186284867 1000 #edb/ref 17592186284868 13194139534377 true] [17592186284867 1000 #edb/ref 17592186284869 13194139534377 true] [17592186284867 1040 #edb/ref 17592186045449 13194139534377 true] [17592186284867 1041 "field-1" 13194139534377 true] [17592186284867 1104 #edb/ref 17592186284869 13194139534377 true] [17592186284867 1110 #uuid "67debf65-e6b8-50eb-a982-2a4084d044d0" 13194139534377 true] [17592186284868 1034 "1" 13194139534377 true] [17592186284868 1103 #edb/ref 17592186045453 13194139534377 true] [17592186284868 1111 #uuid "716d1d1a-decc-5153-a5ca-c4bb3512cafb" 13194139534377 true] [17592186284869 1034 "-1" 13194139534377 true] [17592186284869 1103 #edb/ref 17592186045453 13194139534377 true] [17592186284869 1111 #uuid "bc761467-a3f5-54a8-83fe-e813e7574317" 13194139534377 true] [17592186284870 1000 #edb/ref 17592186284871 13194139534377 true] [17592186284870 1040 #edb/ref 17592186045449 13194139534377 true] [17592186284870 1041 "field-2" 13194139534377 true] [17592186284870 1104 #edb/ref 17592186284871 13194139534377 true] [17592186284870 1110 #uuid "39d6b377-ea9f-5025-a00c-bcac1c32bf93" 13194139534377 true] [17592186284871 1034 "-1" 13194139534377 true] [17592186284871 1103 #edb/ref 175