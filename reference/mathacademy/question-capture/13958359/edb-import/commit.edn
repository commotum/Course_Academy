33942 true] [17592186267542 1111 #uuid "34628de9-258f-5d53-909a-59d1d21e2165" 13194139533942 true] [17592186267543 1034 "(x+4)^{2}+\\frac{(y+2)^{2}}{9}=1" 13194139533942 true] [17592186267543 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267543 1111 #uuid "b581842c-4283-59cf-b828-367c0105818f" 13194139533942 true] [17592186267544 1034 "(x-4)^{2}+\\frac{(y+2)^{2}}{9}=1" 13194139533942 true] [17592186267544 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267544 1111 #uuid "6df25aa2-352c-5495-8216-5c1dbfaa84a1" 13194139533942 true] [17592186267545 1034 "(x-2)^{2}+\\frac{(y+4)^{2}}{9}=1" 13194139533942 true] [17592186267545 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267545 1111 #uuid "846fb119-bb52-5c4d-83be-e8bee1e23474" 13194139533942 true] [17592186267546 1034 "(x+4)^{2}+\\frac{(y-2)^{2}}{9}=1" 13194139533942 true] [17592186267546 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267546 1111 #uuid "47888f8c-586d-5488-99e1-8e5fc39b4493" 13194139533942 true] [17592186267547 1017 #edb/ref 17592186267548 13194139533942 true] [17592186267547 1017 #edb/ref 17592186267550 13194139533942 true] [17592186267547 1089 "q-277200" 13194139533942 true] [17592186267547 1091 #edb/ref 17592186045465 13194139533942 true] [17592186267547 1100 "For the ellipse $\\frac{(x+4)^{2}}{36}+\\frac{(y+3)^{2}}{12}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." 13194139533942 true] [17592186267547 1113 #uuid "411c201c-8678-5df1-8612-44d7e43ee539" 13194139533942 true] [17592186267547 1145 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-4$ and $k=-3,$ so the center is located at $(-4,-3).$\n\nIn the given equation, we also have ${a}^{2}=36$ and ${b}^{2}=12.$\n\n- Since ${a}^{2}=36,$ the length of the horizontal radius must be $a=\\sqrt{36}=6.$\n\n- Since ${b}^{2}=12,$ the length of the vertical radius must be $b=\\sqrt{12}=2\\sqrt{3}.$\n\nSo the semi-major axis has length $a=6,$ and the semi-minor axis has length $b=2\\sqrt{3}.$\n\nTherefore, the major axis has length $2a=2\\cdot 6=12,$ and the minor axis has length $2b=2\\cdot 2\\sqrt{3}=4\\sqrt{3}.$" 13194139533942 true] [17592186267548 1000 #edb/ref 17592186267549 13194139533942 true] [17592186267548 1040 #edb/ref 17592186045449 13194139533942 true] [17592186267548 1041 "field-1" 13194139533942 true] [17592186267548 1104 #edb/ref 17592186267549 13194139533942 true] [17592186267548 1110 #uuid "3d44e0a4-d650-50e4-bb0f-f1f701607920" 13194139533942 true] [17592186267549 1034 "12" 13194139533942 true] [17592186267549 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267549 1111 #uuid "d078fd87-3cca-57a7-9be9-d4bfea6c0de9" 13194139533942 true] [17592186267550 1000 #edb/ref 17592186267551 13194139533942 true] [17592186267550 1040 #edb/ref 17592186045449 13194139533942 true] [17592186267550 1041 "field-2" 13194139533942 true] [17592186267550 1104 #edb/ref 17592186267551 13194139533942 true] [17592186267550 1110 #uuid "aa9a0b25-e291-5708-805c-2a55b3815790" 13194139533942 true] [17592186267551 1034 "4\\sqrt{3}" 13194139533942 true] [17592186267551 1103 #edb/ref 17592186045453 13194139533942 true] [17592186267551 1111 #uuid "6a5e8a0e-126a-5e65-9f50-dc6f94589ea2" 13194139533942 true] [17592186267552 1017 #edb/ref 17592186267553 13194139533942 true] [17592186267552 1089 "q-278254" 13194139533942 true] [17592186267552 1091 #edb/ref 17592186045463 13194139533942 true] [17592186267552 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958359/assets/65a76a438b3459a92db0e00b0c9bd281b8a9c58fa68afd2d8e6468a1d99b1cf9.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" 13194139533942