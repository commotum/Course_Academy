#{[{:db/id #edb/ref 17592186281628 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9664965-cd34-5e03-868b-06c5c27ad884" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186281630} {:answer/id #uuid "07f14e45-7c1c-57cc-8020-af14ff0dbea4" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186281631} {:answer/id #uuid "c68016e9-9d30-5cec-9263-c17ef24425f2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281632} {:answer/id #uuid "e14d5fd8-9999-5eb3-9e8f-c7bb912e137d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281633} {:answer/id #uuid "77997707-519b-5964-881a-c168998ed4a0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186281634}] :answer-field/correct {:answer/id #uuid "07f14e45-7c1c-57cc-8020-af14ff0dbea4" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186281631} :answer-field/id #uuid "1ade2e65-2f89-544d-87f3-d97153ad71a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281629}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7b29d332-37dc-57b2-92da-0a898b30100b" :question/math-academy-id "q-212457" :question/problem "Let $a=⟨0,1,-5⟩$ and $b=⟨6,x,-2⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 6+1\\cdot x+(-5)\\cdot (-2) \\\\  & =x+10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x+10 & =0 \\\\ x & =-10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106097 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a80e6e6e-ee3c-50bb-a3ec-851c5ea3a7f6" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186102820} {:answer/id #uuid "bc43de78-08ab-5929-ae8b-d325af7a338b" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186102821} {:answer/id #uuid "c93fbc83-364b-5d1a-975c-b6cd6dd15fa1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102822} {:answer/id #uuid "24269cf5-8a22-5068-80ac-508fa2723359" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186102823} {:answer/id #uuid "7c1b15f6-1d77-5e66-8f0d-c2d782e5625a" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186102824}] :answer-field/correct {:answer/id #uuid "7c1b15f6-1d77-5e66-8f0d-c2d782e5625a" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186102824} :answer-field/id #uuid "1550b1f9-a6ba-526e-a655-641149206992" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102819}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "88b493a3-ac09-5d83-bae2-26aab369c0d4" :question/math-academy-id "q-212461" :question/problem "Let $a=[\\begin{aligned}-4 \\\\ 4 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}4 \\\\ -1 \\\\ x\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-4\\cdot 4+4\\cdot (-1)+1\\cdot x \\\\  & =x-20.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x-20 & =0 \\\\ x & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281635 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64798b2a-88ef-52fb-937a-1a6f37afa616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186281637} {:answer/id #uuid "a9fb9e77-1272-521f-83f7-d1e2092c5bb2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186281638}] :answer-field/correct {:answer/id #uuid "64798b2a-88ef-52fb-937a-1a6f37afa616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186281637} :answer-field/id #uuid "74ff6817-25d2-5d13-9dc5-9c1e38e63dcd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281636} {:answer-field/choices [{:answer/id #uuid "24c9692f-4dfe-546c-ad9a-bc7b3baa7e42" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186281640}] :answer-field/correct {:answer/id #uuid "24c9692f-4dfe-546c-ad9a-bc7b3baa7e42" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186281640} :answer-field/id #uuid "7fee79fc-b270-5b42-a63b-4d3dbad8cd33" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281639} {:answer-field/choices [{:answer/id #uuid "8655fadd-43ca-5a92-910e-3688532bda93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186281642}] :answer-field/correct {:answer/id #uuid "8655fadd-43ca-5a92-910e-3688532bda93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186281642} :answer-field/id #uuid "bf5752bf-ad94-54e4-a278-430d7498f42c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281641}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "39d40898-be81-5d74-b4fd-980d9d4c6f07" :question/math-academy-id "q-317653" :question/problem "Let $c=⟨2,1,-3⟩$ and $d=⟨4,-2,1⟩.$ Find the vector projection of $c$ onto $d.$\n\n${\\text{proj}}_{d}\\,c=⟨$  \n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}\\,d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}\\,d \\\\  & =\\frac{2\\cdot 4+1\\cdot (-2)+(-3)\\cdot 1}{{4}^{2}+(-2)^{2}+{1}^{2}}\\,d \\\\  & =\\frac{8-2-3}{16+4+1}\\,⟨4,-2,1⟩ \\\\  & =\\frac{3}{21}\\,⟨4,-2,1⟩ \\\\  & =\\frac{1}{7}\\,⟨4,-2,1⟩ \\\\  & =⟨\\,\\frac{4}{7},-\\frac{2}{7},\\frac{1}{7}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281643 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc2e7e10-178b-5cb8-8191-4b475eaab2df" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186281645}] :answer-field/correct {:answer/id #uuid "dc2e7e10-178b-5cb8-8191-4b475eaab2df" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186281645} :answer-field/id #uuid "0ee46747-f24d-5ce4-9c66-be8d58c20e9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281644} {:answer-field/choices [{:answer/id #uuid "fe6ef02b-d9f1-55e8-9896-89712b88bef5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186281647}] :answer-field/correct {:answer/id #uuid "fe6ef02b-d9f1-55e8-9896-89712b88bef5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186281647} :answer-field/id #uuid "df325216-38ee-51ca-b2df-81b449a4c7d2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281646} {:answer-field/choices [{:answer/id #uuid "ec4cc877-1868-59a5-b28b-095824dd34c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186281649}] :answer-field/correct {:answer/id #uuid "ec4cc877-1868-59a5-b28b-095824dd34c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186281649} :answer-field/id #uuid "ddd0206b-01a9-5a60-8a47-325c35458ea0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281648}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f53c4ccd-94af-5246-9570-8833f9bda16f" :question/math-academy-id "q-317654" :question/problem "Let $a=[\\begin{aligned}4 \\\\ -5 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}].$ Find the vector projection of $a$ onto $b.$\n\n${\\text{proj}}_{b}\\,a=⟨$ \n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{4\\cdot 2+(-5)\\cdot (-1)+2\\cdot 1}{{2}^{2}+(-1)^{2}+{1}^{2}}b \\\\  & =\\frac{15}{6}⟨2,-1,1⟩ \\\\  & =\\frac{5}{2}⟨2,-1,1⟩ \\\\  & =⟨\\,5,-\\frac{5}{2},\\frac{5}{2}\\,⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106408 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0b5d2f2-111b-5f36-9574-2bddbaa91b43" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}},-\\frac{1}{\\sqrt{30}}⟩" :db/id #edb/ref 17592186104958} {:answer/id #uuid "f4f58996-7c81-5e9f-ba8e-db6242aefc7d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{\\sqrt{5}},-\\frac{2}{\\sqrt{5}}, \\sqrt{5}⟩" :db/id #edb/ref 17592186104959} {:answer/id #uuid "35a3fa91-2877-5f05-a29d-c67415825e7c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 0, 0⟩" :db/id #edb/ref 17592186104960} {:answer/id #uuid "46105738-53e5-5544-b410-1c5c6a0dca2a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186104961} {:answer/id #uuid "4e7f5cbb-14b3-506f-adb0-22b07a0eede9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}},-\\frac{1}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186104962}] :answer-field/correct {:answer/id #uuid "35a3fa91-2877-5f05-a29d-c67415825e7c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 0, 0⟩" :db/id #edb/ref 17592186104960} :answer-field/id #uuid "c2b6ad5b-aaf4-500d-b96a-7b1a0906a3f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104957}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ab29d467-5294-537a-b48f-a1d1aefe0cab" :question/math-academy-id "q-71668" :question/problem "Let $a=⟨1,-2,5⟩$ and $b=⟨3,-1,-1⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 3+(-2)\\cdot (-1)+5\\cdot (-1)}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{3}^{2}+(-1)^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}]}
