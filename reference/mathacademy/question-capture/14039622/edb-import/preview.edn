}^{2}-\\frac{25}{2} & =-12 \\\\ 2{(x+\\frac{5}{2})}^{2} & =-12+\\frac{25}{2} \\\\ 2{(x+\\frac{5}{2})}^{2} & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{5}{2}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x+\\frac{5}{2})}^{2} & =\\frac{1}{2} \\\\ {(x+\\frac{5}{2})}^{2} & =\\frac{1}{4} \\\\ \\sqrt{{(x+\\frac{5}{2})}^{2}} & =\\sqrt{\\frac{1}{4}} \\\\ |x+\\frac{5}{2}| & =\\frac{1}{2} \\\\ x+\\frac{5}{2} & =\\pm \\frac{1}{2} \\\\ x & =-\\frac{5}{2}\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-\\frac{5}{2}-\\frac{1}{2}=-\\frac{6}{3}=-3 \\\\ x & =-\\frac{5}{2}+\\frac{1}{2}=-\\frac{4}{2}=-2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-3$ and $x=-2.$" 13194139534683 true] [17592186303243 1000 #edb/ref 17592186303244 13194139534683 true] [17592186303243 1000 #edb/ref 17592186303245 13194139534683 true] [17592186303243 1000 #edb/ref 17592186303246 13194139534683 true] [17592186303243 1000 #edb/ref 17592186303247 13194139534683 true] [17592186303243 1000 #edb/ref 17592186303248 13194139534683 true] [17592186303243 1040 #edb/ref 17592186045450 13194139534683 true] [17592186303243 1041 "selection" 13194139534683 true] [17592186303243 1104 #edb/ref 17592186303246 13194139534683 true] [17592186303243 1110 #uuid "b954e307-45be-5822-a44d-f7e71c03f643" 13194139534683 true] [17592186303244 1034 "$p=\\frac{5}{2},\\,x=-4$ and $-3$" 13194139534683 true] [17592186303244 1103 #edb/ref 17592186045454 13194139534683 true] [17592186303244 1111 #uuid "dfab003c-51bc-591f-b83d-0abe33e20351" 13194139534683 true] [17592186303245 1034 "$p=\\frac{5}{2},\\,x=3$ and $2$" 13194139534683 true] [17592186303245 1103 #edb/ref 17592186045454 13194139534683 true] [17592186303245 1111 #uuid "7df0fb01-7913-51ae-b53b-62a5ae8cf86c" 13194139534683 true] [17592186303246 1034 "$p=\\frac{5}{2},\\,x=-3$ and $-2$" 13194139534683 true] [17592186303246 1103 #edb/ref 17592186045454 13194139534683 true] [17592186