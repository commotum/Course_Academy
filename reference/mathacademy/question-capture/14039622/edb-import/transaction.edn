[{:db/id "q-12983/selection/106b717b723daf2b1dac0a7db32ee8c643b77df7fd0027c3a8620305c4fb5011" :answer/id #uuid "a7de09b9-ba83-5163-b242-21487c6d3d1f" :answer/type :answer.type/math :answer/value "p+q=\\frac{13}{4},\\,z=\\frac{-1\\pm \\sqrt{13}}{2}" :db/ensure [:answer/validate]} {:db/id "q-12983/selection/1aea667a02aa33aac2f06956dc0c5cc34fcb15398fc5a338c0485d44ec659283" :answer/id #uuid "1f5254a2-8960-573a-bb1b-6f648cb99780" :answer/type :answer.type/math :answer/value "p+q=\\frac{11}{4},\\,z=\\frac{3\\pm \\sqrt{11}}{2}" :db/ensure [:answer/validate]} {:db/id "q-12983/selection/36e9cb67004935bf08c09f5bd6fde5cdb03cf612d9b35e9dcc6165dc98af6242" :answer/id #uuid "4f6c464e-cd60-5074-a894-3564f3bd3f45" :answer/type :answer.type/math :answer/value "p+q=\\frac{15}{4},\\,z=\\frac{-1\\pm \\sqrt{13}}{2}" :db/ensure [:answer/validate]} {:db/id "q-12983/selection/15d2b13a750987908a44ac57247d7ea619def074e90ab75a22786efd658ddc54" :answer/id #uuid "0d0babd0-438d-5d8a-97dc-5e45254a578a" :answer/type :answer.type/math :answer/value "p+q=\\frac{15}{4},\\,z=\\frac{1\\pm \\sqrt{11}}{2}" :db/ensure [:answer/validate]} {:db/id "q-12983/selection/8d04e3bd9a5d23d67d0dd74f5ede837eb3b38071ee49e6d7582f225d0c94355f" :answer/id #uuid "45e1db14-6939-535b-8bcf-961c66aa6713" :answer/type :answer.type/math :answer/value "p+q=\\frac{17}{4},\\,z=\\frac{-3\\pm \\sqrt{11}}{2}" :db/ensure [:answer/validate]} {:db/id "q-12983/selection" :answer-field/id #uuid "83e7415a-c069-5e81-8871-350cc9cd5942" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12983/selection/36e9cb67004935bf08c09f5bd6fde5cdb03cf612d9b35e9dcc6165dc98af6242" :answer-field/choices ["q-12983/selection/106b717b723daf2b1dac0a7db32ee8c643b77df7fd0027c3a8620305c4fb5011" "q-12983/selection/1aea667a02aa33aac2f06956dc0c5cc34fcb15398fc5a338c0485d44ec659283" "q-12983/selection/36e9cb67004935bf08c09f5bd6fde5cdb03cf612d9b35e9dcc6165dc98af6242" "q-12983/selection/15d2b13a750987908a44ac57247d7ea619def074e90ab75a22786efd658ddc54" "q-12983/selection/8d04e3bd9a5d23d67d0dd74f5ede837eb3b38071ee49e6d7582f225d0c94355f"] :db/ensure [:answer-field/validate]} {:db/id "q-12983" :question/id #uuid "a4231bc3-a421-5e58-97bf-d04422396a22" :question/math-academy-id "q-12983" :question/problem "The equation $4{z}^{2}+4z=12$ can be written in the form $(z+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, divide it by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{z}^{2}+4z & =12 \\\\ 4({z}^{2}+z) & =12 \\\\ {z}^{2}+z & =3 \\\\ {z}^{2}+2\\cdot \\frac{1}{2}\\cdot z & =3 \\\\ {z}^{2}+2\\cdot (\\frac{1}{2})\\cdot z+{(\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3 \\\\ {(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(z+\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2} & =3 \\\\ {(z+\\frac{1}{2})}^{2}-\\frac{1}{4} & =\\frac{12}{4} \\\\ {(z+\\frac{1}{2})}^{2} & =\\frac{13}{4}\\end{aligned}\n$$\n\nSo, $p=\\frac{1}{2},q=\\frac{13}{4},$ and $p+q=\\frac{15}{4}.$ \n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}\\sqrt{{(z+\\frac{1}{2})}^{2}} & =\\sqrt{\\frac{13}{4}} \\\\ |z+\\frac{1}{2}| & =\\frac{\\sqrt{13}}{2} \\\\ z+\\frac{1}{2} & =\\pm \\frac{\\sqrt{13}}{2} \\\\ z & =-\\frac{1}{2}\\pm \\frac{\\sqrt{13}}{2} \\\\ z & =\\frac{-1\\pm \\sqrt{13}}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12983/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f"] :knowledge-point/questions ["q-12983"] :db/ensure [:knowledge-point/validate]} {:db/id "q-60145/selection/8f98cd1bbdebca2fed79e68708757dd2ea4d8eb6e3ad196faf2ee6d303395916" :answer/id #uuid "a8ed6895-168e-5646-b8e8-c82510044241" :answer/type :answer.type/math :answer/value "q=4,\\,x=\\frac{3}{2}\\pm \\frac{\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "q-60145/selection/1bd8a3cee5413dbafe68533819c90158730c7883a77502e3ac389e12d71d194e" :answer/id #uuid "557ad879-3fe7-5cb0-b8c1-b0f06a41a395" :answer/type :answer.type/math :answer/value "q=4,\\,x=2\\pm \\frac{\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-60145/selection/de478db8c5fb2172c39e9a3ab409e58a0c89c092ddf20af5b3cd0e22a91e62df" :answer/id #uuid "d48affac-9a1b-5cbb-b4f0-475db18529b1" :answer/type :answer.type/math :answer/value "q=2,\\,x=\\frac{3}{2}\\pm \\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-60145/selection/7b4356f5daa84935492a358e781e4713230a1d49dc4b2d878349d19ccd977007" :answer/id #uuid "4fc69f03-99aa-5193-9f5b-424558c8ce0b" :answer/type :answer.type/math :answer/value "q=4,\\,x=\\frac{3}{4}\\pm \\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "q-60145/selection/9bced114ccc5dd6df7404af3690be64ab5f25900a9bfe755493af5b723b0a451" :answer/id #uuid "3c7a2376-3542-5e29-9e3a-643872383d8c" :answer/type :answer.type/math :answer/value "q=2,\\,x=3\\pm \\frac{\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "q-60145/selection" :answer-field/id #uuid "04ca9809-ed2f-5683-825b-a4a7f232695a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-60145/selection/8f98cd1bbdebca2fed79e68708757dd2ea4d8eb6e3ad196faf2ee6d303395916" :answer-field/choices ["q-60145/selection/8f98cd1bbdebca2fed79e68708757dd2ea4d8eb6e3ad196faf2ee6d303395916" "q-60145/selection/1bd8a3cee5413dbafe68533819c90158730c7883a77502e3ac389e12d71d194e" "q-60145/selection/de478db8c5fb2172c39e9a3ab409e58a0c89c092ddf20af5b3cd0e22a91e62df" "q-60145/selection/7b4356f5daa84935492a358e781e4713230a1d49dc4b2d878349d19ccd977007" "q-60145/selection/9bced114ccc5dd6df7404af3690be64ab5f25900a9bfe755493af5b723b0a451"] :db/ensure [:answer-field/validate]} {:db/id "q-60145" :question/id #uuid "a1ac9dcc-ee5b-5438-8680-0a3c7af8b759" :question/math-academy-id "q-60145" :question/problem "The equation $-20{x}^{2}+60x-41=0$ can be written in the form $20(x+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-20{x}^{2}+60x-41) & =(-1)\\cdot 0 \\\\ 20{x}^{2}-60x+41 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}20{x}^{2}-60x+41 & =0 \\\\ 20{x}^{2}-60x & =-41 \\\\ 20({x}^{2}-3x) & =-41 \\\\ 20[{x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}] & =-41 \\\\ 20[{(x-\\frac{3}{2})}^{2}-\\frac{9}{4}] & =-41\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}20{(x-\\frac{3}{2})}^{2}-20\\cdot \\frac{9}{4} & =-41 \\\\ 20{(x-\\frac{3}{2})}^{2}-45 & =-41 \\\\ 20{(x-\\frac{3}{2})}^{2} & =45-41 \\\\ 20{(x-\\frac{3}{2})}^{2} & =4\\end{aligned}\n$$\n\nTherefore, $q=4.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}20{(x-\\frac{3}{2})}^{2} & =4 \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{4}{20} \\\\ {(x-\\frac{3}{2})}^{2} & =\\frac{1}{5} \\\\ \\sqrt{{(x-\\frac{3}{2})}^{2}} & =\\sqrt{\\frac{1}{5}} \\\\ |x-\\frac{3}{2}| & =\\sqrt{\\frac{1}{5}} \\\\ x-\\frac{3}{2} & =\\pm \\frac{1}{\\sqrt{5}} \\\\ x-\\frac{3}{2} & =\\pm \\frac{\\sqrt{5}}{5} \\\\ x & =\\frac{3}{2}\\pm \\frac{\\sqrt{5}}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-60145/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-60145"] :db/ensure [:knowledge-point/validate]} {:db/id "q-60359/selection/c5146780e5ad255b4c4088377ee0fc7eb4b397414a9f7f959519794dd7f64e63" :answer/id #uuid "a065e26e-a5bb-51d0-b546-46ddbd6633f2" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{2},\\,x=-3$ and $-2$" :db/ensure [:answer/validate]} {:db/id "q-60359/selection/0a6d4a7617f99e4dd517a8f770e6db5ed29e49070dd970854b93c83af62ad965" :answer/id #uuid "dfab003c-51bc-591f-b83d-0abe33e20351" :answer/type :answer.type/text :answer/value "$p=\\frac{5}{2},\\,x=-4$ and $-3$" :db/ensure [:answer/validate]} {:db/id "q-60359/selection/bb6ba7f8242d416462d747a3839f40144a4a4fd73aad9a4f69bd2a34f47ecd0f" :answer/id #uuid "64bee68b-1126-53b2-be5f-013a78f1c85f" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{2},\\,x=-2$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-60359/selection/364b735a428e2b3547c44fad64b881c477e356c1b2cce4f5c6899c3ed684602f" :answer/id #uuid "7df0fb01-7913-51ae-b53b-62a5ae8cf86c" :answer/type :answer.type/text :answer/value "$p=\\frac{5}{2},\\,x=3$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-60359/selection/a62225ac29a4f41b378e45f04ea38a61a71fc716f6a6c2579666ea50191e15d3" :answer/id #uuid "0bf883dc-6a9c-5172-916d-3ca92706db05" :answer/type :answer.type/text :answer/value "$p=\\frac{5}{2},\\,x=-3$ and $-2$" :db/ensure [:answer/validate]} {:db/id "q-60359/selection" :answer-field/id #uuid "b954e307-45be-5822-a44d-f7e71c03f643" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-60359/selection/a62225ac29a4f41b378e45f04ea38a61a71fc716f6a6c2579666ea50191e15d3" :answer-field/choices ["q-60359/selection/c5146780e5ad255b4c4088377ee0fc7eb4b397414a9f7f959519794dd7f64e63" "q-60359/selection/0a6d4a7617f99e4dd517a8f770e6db5ed29e49070dd970854b93c83af62ad965" "q-60359/selection/bb6ba7f8242d416462d747a3839f40144a4a4fd73aad9a4f69bd2a34f47ecd0f" "q-60359/selection/364b735a428e2b3547c44fad64b881c477e356c1b2cce4f5c6899c3ed684602f" "q-60359/selection/a62225ac29a4f41b378e45f04ea38a61a71fc716f6a6c2579666ea50191e15d3"] :db/ensure [:answer-field/validate]} {:db/id "q-60359" :question/id #uuid "d8168848-cdbb-52c4-8963-85f47577f4e7" :question/math-academy-id "q-60359" :question/problem "The equation $2{x}^{2}+10x+12=0$ can be written in the form $2(x+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side,  factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{x}^{2}+10x+12 & =0 \\\\ 2{x}^{2}+10x & =-12 \\\\ 2{x}^{2}+10x & =-12 \\\\ 2({x}^{2}+5x) & =-12 \\\\ 2[{x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}] & =-12 \\\\ 2[{(x+\\frac{5}{2})}^{2}-\\frac{25}{4}] & =-12\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}2{(x+\\frac{5}{2})}^{2}-2\\cdot \\frac{25}{4} & =-12 \\\\ 2{(x+\\frac{5}{2})}^{2}-\\frac{25}{2} & =-12 \\\\ 2{(x+\\frac{5}{2})}^{2} & =-12+\\frac{25}{2} \\\\ 2{(x+\\frac{5}{2})}^{2} & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{5}{2}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}2{(x+\\frac{5}{2})}^{2} & =\\frac{1}{2} \\\\ {(x+\\frac{5}{2})}^{2} & =\\frac{1}{4} \\\\ \\sqrt{{(x+\\frac{5}{2})}^{2}} & =\\sqrt{\\frac{1}{4}} \\\\ |x+\\frac{5}{2}| & =\\frac{1}{2} \\\\ x+\\frac{5}{2} & =\\pm \\frac{1}{2} \\\\ x & =-\\frac{5}{2}\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-\\frac{5}{2}-\\frac{1}{2}=-\\frac{6}{3}=-3 \\\\ x & =-\\frac{5}{2}+\\frac{1}{2}=-\\frac{4}{2}=-2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-3$ and $x=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-60359/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f"] :knowledge-point/questions ["q-60359"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86414/selection/2698e32fe25afe6a3e533e12fcb5d63047ec85b75a404b7eee179eaaa87c886a" :answer/id #uuid "549d31f5-ca88-580b-9c44-2812fbe84410" :answer/type :answer.type/math :answer/value "q-p=14" :db/ensure [:answer/validate]} {:db/id "q-86414/selection/88e911da8d2ecadc2e0f37faf3885058e52c003ddbb2d3c805438ce3b7871c15" :answer/id #uuid "7a73351b-1f83-5b49-ad37-84ee7a4ad7e2" :answer/type :answer.type/math :answer/value "q-p=20" :db/ensure [:answer/validate]} {:db/id "q-86414/selection/e9f59c6d264b187e7c28da820e5d24c9b98dc94c40314f3ed7eed7cb190596ca" :answer/id #uuid "e9d0845b-dc8d-54af-aff4-4017562a1274" :answer/type :answer.type/math :answer/value "q-p=15" :db/ensure [:answer/validate]} {:db/id "q-86414/selection/9d8cd462d2e5b8ffa2e430eab227260c27a2c391519c918e35e997a3f37b2a3f" :answer/id #uuid "a19c76c6-9ef9-57ca-a89b-cd747ca8be96" :answer/type :answer.type/math :answer/value "q-p=25" :db/ensure [:answer/validate]} {:db/id "q-86414/selection/c20a65bce07cef48f81ab72b9e1ade1a044a10b95f5e8446eadf52a8ae56da38" :answer/id #uuid "ed1e1623-02c1-55ab-86f4-c518f0da0ab1" :answer/type :answer.type/math :answer/value "q-p=6" :db/ensure [:answer/validate]} {:db/id "q-86414/selection" :answer-field/id #uuid "b8278d09-d133-5226-89d3-8d3724242bf0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86414/selection/88e911da8d2ecadc2e0f37faf3885058e52c003ddbb2d3c805438ce3b7871c15" :answer-field/choices ["q-86414/selection/2698e32fe25afe6a3e533e12fcb5d63047ec85b75a404b7eee179eaaa87c886a" "q-86414/selection/88e911da8d2ecadc2e0f37faf3885058e52c003ddbb2d3c805438ce3b7871c15" "q-86414/selection/e9f59c6d264b187e7c28da820e5d24c9b98dc94c40314f3ed7eed7cb190596ca" "q-86414/selection/9d8cd462d2e5b8ffa2e430eab227260c27a2c391519c918e35e997a3f37b2a3f" "q-86414/selection/c20a65bce07cef48f81ab72b9e1ade1a044a10b95f5e8446eadf52a8ae56da38"] :db/ensure [:answer-field/validate]} {:db/id "q-86414" :question/id #uuid "e1734459-a432-53d0-859c-83686d8f7d22" :question/math-academy-id "q-86414" :question/problem "The equation $-3{x}^{2}+36x-94=0$ can be written in the form $3(x+p)^{2}=q.$ Find $q-p.$" :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-3{x}^{2}+36x-94) & =(-1)\\cdot 0 \\\\ 3{x}^{2}-36x+94 & =0\\end{aligned}\n$$\n\nNow, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}3{x}^{2}-36x+94 & =0 \\\\ 3{x}^{2}-36x & =-94 \\\\ 3[{x}^{2}-12x] & =-94 \\\\ 3[{x}^{2}-2\\cdot 6x+{6}^{2}-{6}^{2}] & =-94 \\\\ 3[{(x-6)}^{2}-36] & =-94\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}3{(x-6)}^{2}-3\\cdot 36 & =-94 \\\\ 3{(x-6)}^{2}-108 & =-94 \\\\ 3{(x-6)}^{2} & =-94+108 \\\\ 3{(x-6)}^{2} & =14\\end{aligned}\n$$\n\nTherefore, $p=-6$, $q=14.$ Finally,\n\n$$\nq-p=14-(-6)=14+6=20.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86414/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-86414"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112625/selection/e56182c99aaaabc7adab8e684dcaac13655abe6f35bd223c0284e441785f50b3" :answer/id #uuid "5ff954d1-2a48-549d-bf7b-5c715ddf3c1e" :answer/type :answer.type/text :answer/value "$p=2,\\,w=-\\frac{9}{2}$ and $w=\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112625/selection/7dd8cdc7396278735a940f399543c08664666e89e474b6f3c70ce27786b6eed3" :answer/id #uuid "1c14e08a-d55a-58f3-98b9-30e648738da2" :answer/type :answer.type/text :answer/value "$p=1,\\,w=-\\frac{5}{2}$ and $w=\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112625/selection/910eda119c6bd6484522bee8a96eb436e2927d4a307349a350bc83d0f5b6ceef" :answer/id #uuid "2b1c8c06-9fb1-501a-8f08-cdd2363e9d25" :answer/type :answer.type/text :answer/value "$p=2,\\,w=-\\frac{3}{2}$ and $w=\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112625/selection/20097aed057b311d19f8c2114aa05c63779609430fc0ad2b2952cc00fc9e9a29" :answer/id #uuid "f87ad25e-6551-5ae9-bfb7-a51eb3a4b147" :answer/type :answer.type/text :answer/value "$p=2,\\,w=-\\frac{1}{2}$ and $w=\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112625/selection/111b22e8abf31e33acf2d1275f83db9654220d1ae709bb9e86c5571c6bf78cd9" :answer/id #uuid "94a0b787-6dd0-5672-9d6c-d9eeb327b09c" :answer/type :answer.type/text :answer/value "$p=1,\\,w=-\\frac{7}{2}$ and $w=1$" :db/ensure [:answer/validate]} {:db/id "q-112625/selection" :answer-field/id #uuid "bcc75e1d-788b-5862-9a3a-03638dd85835" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112625/selection/e56182c99aaaabc7adab8e684dcaac13655abe6f35bd223c0284e441785f50b3" :answer-field/choices ["q-112625/selection/e56182c99aaaabc7adab8e684dcaac13655abe6f35bd223c0284e441785f50b3" "q-112625/selection/7dd8cdc7396278735a940f399543c08664666e89e474b6f3c70ce27786b6eed3" "q-112625/selection/910eda119c6bd6484522bee8a96eb436e2927d4a307349a350bc83d0f5b6ceef" "q-112625/selection/20097aed057b311d19f8c2114aa05c63779609430fc0ad2b2952cc00fc9e9a29" "q-112625/selection/111b22e8abf31e33acf2d1275f83db9654220d1ae709bb9e86c5571c6bf78cd9"] :db/ensure [:answer-field/validate]} {:db/id "q-112625" :question/id #uuid "81d5e8dd-0fd3-5d41-bcce-bd1a45fe46d8" :question/math-academy-id "q-112625" :question/problem "The equation $-4{w}^{2}-16w+9=0$ can be written in the form $4(w+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1:$\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{w}^{2}-16w+9) & =(-1)\\cdot 0 \\\\ 4{w}^{2}+16w-9 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{w}^{2}+16w-9 & =0 \\\\ 4{w}^{2}+16w & =9 \\\\ 4({w}^{2}+4w) & =9 \\\\ 4[{w}^{2}+2\\cdot 2\\cdot w+{2}^{2}-{2}^{2}] & =9 \\\\ 4[{(w+2)}^{2}-4] & =9\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(w+2)}^{2}-4\\cdot 4 & =9 \\\\ 4{(w+2)}^{2}-16 & =9 \\\\ 4{(w+2)}^{2} & =9+16 \\\\ 4{(w+2)}^{2} & =25\\end{aligned}\n$$\n\nTherefore, $p=2.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(w+2)}^{2} & =25 \\\\ {(w+2)}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{(w+2)}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |w+2| & =\\frac{5}{2} \\\\ w+2 & =\\pm \\frac{5}{2} \\\\ w & =-2\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}w & =-2-\\frac{5}{2}=-\\frac{9}{2} \\\\ w & =-2+\\frac{5}{2}=\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the solutions are $w=-\\frac{9}{2}$ and $w=\\frac{1}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-112625/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-112625"] :db/ensure [:knowledge-point/validate]}]
