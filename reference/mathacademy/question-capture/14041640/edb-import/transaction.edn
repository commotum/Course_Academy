lpful to remember the mnemonic \"concave down like a frown.\"\n\nOf the points $x=b$ and $x=c,$ the graph is concave down ($⌢$) at $x=c$ only." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113899/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a67f347a-30a5-5169-af2c-9a800be84e46"] :knowledge-point/questions ["q-113899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141937/selection/381861802c56481f105f67f677c35703dd1f4e0654599d6959386246579f09af" :answer/id #uuid "c2cdd6ec-d9fd-503b-8106-0608ae55490d" :answer/type :answer.type/text :answer/value "$(-3,-2)$ only" :db/ensure [:answer/validate]} {:db/id "q-141937/selection/4cfb15e3ff7249c11cf668e0b4e688a89b773fe41e051bb999c9b847068b9bdd" :answer/id #uuid "2509630c-d4e3-566a-9fb6-448f121263c5" :answer/type :answer.type/text :answer/value "$(-2,-1)$ and $(-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-141937/selection/041b4b95d47d923ffd236cd03b072b8293560eb404de84b160e0226486362cb0" :answer/id #uuid "e3289f80-ff41-5e82-bea9-cf2888f39163" :answer/type :answer.type/text :answer/value "$(-1,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-141937/selection/5558a50599e8b0236cd0163edd109751b40bc18cbae8f394981261738682aeb1" :answer/id #uuid "4d6b1b58-d4b4-567b-aa8a-d6dfdc3f36b6" :answer/type :answer.type/text :answer/value "$(-2,-1)$ only" :db/ensure [:answer/validate]} {:db/id "q-141937/selection/dc3afbd87ca4158231f45aeeda821f7e7bf3364aafa5db50ae6307c0a3407403" :answer/id #uuid "71977f26-b2ed-5872-8a7c-5e294851b4a5" :answer/type :answer.type/text :answer/value "$(-3,-2)$ and $(-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-141937/selection" :answer-field/id #uuid "1e7e3c1e-8e37-595e-a5c5-9c8a55a0a48a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141937/selection/4cfb15e3ff7249c11cf668e0b4e688a89b773fe41e051bb999c9b847068b9bdd" :answer-field/choices ["q-141937/selection/381861802c56481f105f67f6