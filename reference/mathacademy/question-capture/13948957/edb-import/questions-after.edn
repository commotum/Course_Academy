ed}-9 \\\\ 15\\end{aligned}]=3[\\begin{aligned}-3 \\\\ 5\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}-9 \\\\ 15\\end{aligned}]) & =T(3[\\begin{aligned}-3 \\\\ 5\\end{aligned}])=3T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT([\\begin{aligned}-9 \\\\ 15\\end{aligned}])=[\\begin{aligned}12 \\\\ -18\\end{aligned}],\n$$\n\nwe must have\n\n$$\n\\begin{aligned}3T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]) & =[\\begin{aligned}12 \\\\ -18\\end{aligned}] \\\\ T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]) & =\\frac{1}{3}[\\begin{aligned}12 \\\\ -18\\end{aligned}] \\\\ T([\\begin{aligned}-3 \\\\ 5\\end{aligned}]) & =[\\begin{aligned}4 \\\\ -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262640 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8" :knowledge-point/title "Determining the Image of a Vector Under a Map Using the Scalar Multiplication Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "927a448d-04e5-5e16-8f50-555e451254f8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186262642} {:answer/id #uuid "15ca8c47-e151-568d-85b9-d58f1a5d5750" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186262643} {:answer/id #uuid "7ce7ee00-e9de-5a92-aaf0-3dbd41d4c5ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186262644} {:answer/id #uuid "385eecc7-4c2e-5eb3-86ae-9ef296f35f73" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186262645} {:answer/id #uuid "9903034c-cb2a-5903-a213-b748252a00a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186262646}] :an