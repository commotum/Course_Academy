d}-3 \\\\ 5\\end{aligned}] \\\\ -2T({v}_{1}) & =[\\begin{aligned}7 \\\\ 9\\end{aligned}]-[\\begin{aligned}-3 \\\\ 5\\end{aligned}] \\\\ -2T({v}_{1}) & =[\\begin{aligned}10 \\\\ 4\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{-2}[\\begin{aligned}10 \\\\ 4\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}-5 \\\\ -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262654 :knowledge-point/_questions [{:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "471db198-499e-53ab-bde4-7f405b035dbe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186262656} {:answer/id #uuid "d2bd33c6-19d7-5a88-a88c-c8f48e942d66" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186262657} {:answer/id #uuid "ebdff365-0d82-5773-b245-ec0f4c32b657" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186262658} {:answer/id #uuid "03eaa1f8-6908-539e-b1a9-5c16d08c6632" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186262659} {:answer/id #uuid "46d6be46-15b2-52b7-82ea-ba26b3040f35" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186262660}] :answer-field/correct {:answer/id #uuid "03eaa1f8-6908-539e-b1a9-5c16d08c6632" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186262659} :answer-field/id #uuid "e228ddcc-0ebd-586f-b279-9dad1b31844d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262655}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "57cbc13b-b004-59d3-9b49-913460c9f9b2" :question/math-academy-id "q-74775" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+7{v}_{2})=[\\begin{aligned}13 \\\\ 5\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+7{v}_{2}) & =3T({v}_{1})+7T({v}_{2}) \\\\ [\\begin{aligned}13 \\\\ 5\\end{aligned}] & =3T({v}_{1})+7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-[\\begin{aligned}7 \\\\ -7\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262661 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9da26caa-8b9d-55cc-af9f-7c8f5390d66e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}77 \\\\ 42 \\\\ -84\\end{aligned}]" :db/id #edb/ref 17592186262663} {:answer/id #uuid "45351c33-ee91-5d68-9b76-bc8001bbb095" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 \\\\ -12 \\\\ 24\\end{aligned}]" :db/id #edb/ref 17592186262664} {:answer/id #uuid "1bd90a9e-5a96-5d88-81b3-163838a94d0e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}55 \\\\ 30 \\\\ -60\\end{aligned}]" :db/id #edb/ref 17592186262665} {:answer/id #uuid "80f821ab-6bba-5f49-82a3-8d427a32e614" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}22 \\\\ 12 \\\\ -24\\end{aligned}]" :db/id #edb/ref 17592186262666} {:answer/id #uuid "1474a4a1-8fd0-57be-853a-24159bff77ec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 \\\\ 24 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186262667}] :answer-field/correct {:answer/id #uuid "1474a4a1-8fd0-57be-853a-24159bff77ec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 \\\\ 24 \\\\ -12\\end{aligned}]" :db/id #edb/ref 17592186262667} :answer-field/id #uuid "3bd9aca4-eb00-51dc-90be-21cfd3ac5f40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262662}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4758d66-599e-5025-8bd7-1995f522f3c5" :question/math-academy-id "q-74776" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{1})=[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]\\,$, find $\\,T(7{v}_{1}-5{v}_{2}).$" :question/worked-solution "First, since ${v}_{1}+{v}_{2}=0,$ we have that \n\n$$\n\\begin{aligned}7{v}_{1}-5{v}_{2} & =12{v}_{1}-5{v}_{1}-5{v}_{2} \\\\  & =12{v}_{1}-5({v}_{1}+{v}_{2}) \\\\  & =12{v}_{1}-5(0) \\\\  & =12{v}_{1}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(7{v}_{1}-5{v}_{2})=T(12{v}_{1}).\n$$\n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(12{v}_{1}) & =12T({v}_{1}) \\\\  & =12[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}12 \\\\ 24 \\\\ -12\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(7{v}_{1}-5{v}_{2})=[\\begin{aligned}12 \\\\ 24 \\\\ -12\\end{aligned}].$"}] [{:db/id #edb/ref 17592186262668 :knowledge-point/_questions [{:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d986028-ac6d-5b06-b566-1f3b0f3cd3bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}63 \\\\ 51 \\\\ -42\\end{aligned}]" :db/id #edb/ref 17592186262670} {:answer/id #uuid "38fb0140-96e7-576e-9d6b-7157d2521e48" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-42 \\\\ -34 \\\\ 28\\end{aligned}]" :db/id #edb/ref 17592186262671} {:answer/id #uuid "dc7a3f2b-9d36-515d-8a76-fe93dad3063f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-21 \\\\ -17 \\\\ 14\\end{aligned}]" :db/id #edb/ref 17592186262672} {:answer/id #uuid "91532772-71ec-5d1c-aa75-9956c87687bf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-63 \\\\ -51 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186262673} {:answer/id #uuid "a6b3bbc6-745e-520d-8b6c-18de2e369d91" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186262674}] :answer-field/correct {:answer/id #uuid "a6b3bbc6-745e-520d-8b6c-18de2e369d91" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186262674} :answer-field/id #uuid "dc932f18-67d2-5c09-b285-2730f89f85a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262669}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7e4e42a9-e81d-5610-8794-d5c4cdbe24ee" :question/math-academy-id "q-74781" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}]\\,$, find $\\,T(37{v}_{1}+39{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}37{v}_{1}+39{v}_{2} & =37{v}_{1}+37{v}_{2}+2{v}_{2} \\\\  & =37({v}_{1}+{v}_{2})+2{v}_{2} \\\\  & =37(0)+2{v}_{2} \\\\  & =2{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(37{v}_{1}+39{v}_{2})=T(2{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(2{v}_{2}) & =2T({v}_{2}) \\\\  & =2[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(37{v}_{1}+39{v}_{2})=[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].$"}] [{:db/id #edb/ref 17592186262675 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc4eb687-0c15-5818-b327-5ea654a7ad50" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262677} {:answer/id #uuid "432263bd-b8d8-5919-a4f8-418cfdabb528" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186262678} {:answer/id #uuid "08157322-6c86-5eda-9cbe-7225ae7ea582" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186262679} {:answer/id #uuid "8a53e924-0fdb-5843-9344-625eb012164b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186262680} {:answer/id #uuid "a471a691-3b7a-53e5-b5e1-9c233ebdbfa5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186262681}] :answer-field/correct {:answer/id #uuid "dc4eb687-0c15-5818-b327-5ea654a7ad50" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262677} :answer-field/id #uuid "bde6d67a-00cb-5f80-abb2-8b24849a27d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262676}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "953fcc8c-313e-5da7-9104-cf7636e9fd23" :question/math-academy-id "q-8296" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5x+2y \\\\ 3y\\end{aligned}].$\nWhich of the following statements are true?\n\n- $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}5(kx)+2(ky) \\\\ 3(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}k(5x+2y) \\\\ k(3y)\\end{aligned}] \\\\  & =k[\\begin{aligned}5x+2y \\\\ 3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}5({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2}) \\\\ 3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}5{x}_{1}+2{y}_{1} \\\\ 3{y}_{1}\\end{aligned}]+[\\begin{aligned}5{x}_{2}+2{y}_{2} \\\\ 3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186262682 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4295c50f-f640-540a-a2dc-97b5442319e9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262684} {:answer/id #uuid "786814a1-c5d9-528f-b248-06eb8742fd48" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186262685} {:answer/id #uuid "dfdde30a-eeef-54d3-9b1a-8b10680a03c2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262686} {:answer/id #uuid "7941cea8-77d1-5b7d-9cfe-e8249608fba6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186262687} {:answer/id #uuid "114f1c3c-ef33-530d-ae82-d223910a8968" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186262688}] :answer-field/correct {:answer/id #uuid "4295c50f-f640-540a-a2dc-97b5442319e9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186262684} :answer-field/id #uuid "cde7384a-9338-5e1d-b03c-f33c1d244093" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262683}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0394caee-e965-5b6f-91aa-7fb8f0bbd3b6" :question/math-academy-id "q-8297" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}3y \\\\ 2x\\end{aligned}].$\nWhich of the following statements are true?\n\n- $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}3ky \\\\ 2kx\\end{aligned}] \\\\  & =k[\\begin{aligned}3y \\\\ 2x\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}3({y}_{1}+{y}_{2}) \\\\ 2({x}_{1}+{x}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}3{y}_{1} \\\\ 2{x}_{1}\\end{aligned}]+[\\begin{aligned}3{y}_{2} \\\\ 2{x}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}]}
