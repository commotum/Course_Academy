v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}k(x+y) \\\\ 0\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 0\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}({x}_{1}+{x}_{2})+({y}_{1}+{y}_{2}) \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}({x}_{1}+{y}_{1})+({x}_{2}+{y}_{2}) \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 0\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 0\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170638/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a"] :knowledge-point/questions ["q-170638"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8296/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "432263bd-b8d8-5919-a4f8-418cfdabb528" :answer/type :answer.type/text :answer/value "III only" 