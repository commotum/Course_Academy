).$ So \n\n$$\n\\begin{aligned}T(5{v}_{1}) & =5T({v}_{1}) \\\\  & =5[\\begin{aligned}3 \\\\ -2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}15 \\\\ -10 \\\\ 25\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(9{v}_{1}+4{v}_{2})=[\\begin{aligned}15 \\\\ -10 \\\\ 25\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317822/field-1" "q-317822/field-2" "q-317822/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417"] :knowledge-point/questions ["q-317822"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317834/field-1/aa57a8d17f569b619e62bd602a6af7cff5d106888256da51f23b5b66e6987fe8" :answer/id #uuid "ca8b534d-67bc-533f-a6f7-38fe1b9a5044" :answer/type :answer.type/math :answer/value "-26" :db/ensure [:answer/validate]} {:db/id "q-317834/field-1/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" :answer/id #uuid "9c922d50-fa6a-55c7-85c9-f463db6c70a8" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "q-317834/field-1" :answer-field/id #uuid "3ead074a-21c7-5165-b6c6-b9e9b5d7b0c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317834/field-1/aa57a8d17f569b619e62bd602a6af7cff5d106888256da51f23b5b66e6987fe8" :answer-field/choices ["q-317834/field-1/aa57a8d17f569b619e62bd602a6af7cff5d106888256da51f23b5b66e6987fe8" "q-317834/field-1/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2"] :db/ensure [:answer-field/validate]} {:db/id "q-317834/field-2/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" :answer/id #uuid "b3a2069c-0622-59dc-9634-6497101cb528" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "q-317834/field-2" :answer-field/id #uuid "3a6837aa-da01-5466-bd72-ab9d87b482aa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317834/field-2/8