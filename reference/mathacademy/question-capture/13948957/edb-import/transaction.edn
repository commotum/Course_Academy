{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}(kx)^{2} \\\\ 7(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}{k}^{2}({x}^{2}) \\\\ k(7y)\\end{aligned}] \\\\  & =k[\\begin{aligned}k({x}^{2}) \\\\ 7y\\end{aligned}] \\\\  & \\ne kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}({x}_{1}+{x}_{2})^{2} \\\\ 7({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}^{2}+{x}_{2}^{2}+2{x}_{1}{x}_{2} \\\\ 7{y}_{1}+7{y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}^{2} \\\\ 7{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}^{2} \\\\ 7{y}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{1}{x}_{2} \\\\ 0\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{1}{x}_{2} \\\\ 0\\end{aligned}] \\\\  & \\ne T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nAs a result, only statement III is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-12012/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a"] :knowledge-point/questions ["q-12012"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170638/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "7dfcd828-06b4-5211-a97a-3dfa20875dd5" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-170638/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "023228f9-10c2-5966-9c94-62