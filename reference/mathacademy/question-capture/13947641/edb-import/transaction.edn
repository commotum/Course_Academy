on/math-academy-id "q-3498" :question/problem "$\\frac{8n}{2n-6}÷\\frac{4n}{10n-30}=$" :question/worked-solution "To compute\n\n$$\n\\frac{8n}{2n-6}÷\\frac{4n}{10n-30},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8n}{2n-6}÷\\frac{4n}{10n-30} & = \\\\ \\frac{8n}{2n-6}\\cdot \\frac{10n-30}{4n} & = \\\\ \\frac{4n\\cdot 2}{2n-6}\\cdot \\frac{5(2n-6)}{4n} & = \\\\ \\frac{\\cancel{4n}\\cdot 2}{\\cancel{2n-6}}\\cdot \\frac{5\\cancel{(2n-6)}}{\\cancel{4n}} & = \\\\ 2\\cdot 5 & = \\\\ 10\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-3498/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b"] :knowledge-point/questions ["q-3498"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29970/selection/3a352c656425a3697ff62653b57e4ff41f93fd4109cb3090aaa7bffd4b08338c" :answer/id #uuid "adc3f867-ba61-5171-91d3-7c92ad62b187" :answer/type :answer.type/math :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-29970/selection/75a982410a30f3dff817dd40df001648e5dfbe8bdfc548a82c17a1e09ead982e" :answer/id #uuid "d1eb18c6-10c1-54bf-9fe6-74822174e4d4" :answer/type :answer.type/math :answer/value "\\frac{k+4}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-29970/selection/665290edfacbbebe8a378b70a7ccb7f3aafe65ca084d28707fdc2cff647bac83" :answer/id #uuid "1737e0cb-64dc-5b1c-a07d-2c5033ec5015" :answer/type :answer.type/math :answer/value "\\frac{11{y}^{2}}{k+4}" :db/ensure [:answer/validate]} {:db/id "q-29970/selection/f19665c73d0e19e19643820a420226a0a09310845e7e4a7827fed30be5bf7a76" :answer/id #uuid "160395d8-73d1-5427-9afa-9234d1ca1ea3" :answer/type :answer.type/math :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-29970/selection/1e96747c7127ceedab9001be30cab1f5a368cbb1c28e8b190072e6448cf5c0bb" :answer/id #uuid "b674be09-6b07-5b5c-aae3-ec6e5970d092" :answer/type