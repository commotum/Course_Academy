#{[{:db/id #edb/ref 17592186255430 :knowledge-point/_questions [{:knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28bb1bfc-3e62-5ae1-ac77-e21ebd78b1dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5k}{2h}" :db/id #edb/ref 17592186255432} {:answer/id #uuid "86020f75-50d6-541b-b3f7-3c245d78a40a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{5h}" :db/id #edb/ref 17592186255433} {:answer/id #uuid "9a47b4b9-b114-5c64-88b2-4acfb1913709" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2hk}" :db/id #edb/ref 17592186255434} {:answer/id #uuid "71395f8b-06cf-50a3-8460-e3c3730790b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186255435} {:answer/id #uuid "2ee98be1-b0f6-5ed6-becd-34fac3d6cfc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{kh}{2}" :db/id #edb/ref 17592186255436}] :answer-field/correct {:answer/id #uuid "71395f8b-06cf-50a3-8460-e3c3730790b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186255435} :answer-field/id #uuid "77386fca-cfc9-584f-afb1-7687ecb85318" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255431}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bbbc6510-d903-52be-85ac-149e8a2508a6" :question/math-academy-id "q-113818" :question/problem "$\\frac{5}{h}÷\\frac{10}{k}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5}{h}÷\\frac{10}{k},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5}{h}÷\\frac{10}{k} & = \\\\ \\frac{5}{h}\\cdot \\frac{k}{10} & = \\\\ \\frac{5k}{10h} & = \\\\ \\frac{\\cancel{5}\\cdot k}{\\cancel{5}\\cdot 2h} & = \\\\ \\frac{k}{2h} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $5$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186255437 :knowledge-point/_questions [{:knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38fcdf6a-0a0b-5c1d-bc9e-91e781c26cfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7{y}^{2}}" :db/id #edb/ref 17592186255439} {:answer/id #uuid "21e34c09-d90b-59ec-8869-8ef482f7c633" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7{y}^{2}}" :db/id #edb/ref 17592186255440} {:answer/id #uuid "d824f84a-9751-549e-a224-0a23c5f3ba9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21{z}^{2}}{{y}^{2}}" :db/id #edb/ref 17592186255441} {:answer/id #uuid "2520818a-2029-55ba-9554-7a101154db3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7{z}^{2}}{3{y}^{2}}" :db/id #edb/ref 17592186255442} {:answer/id #uuid "c1df2477-f604-534f-8f7a-7b6bbf21a252" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7}" :db/id #edb/ref 17592186255443}] :answer-field/correct {:answer/id #uuid "21e34c09-d90b-59ec-8869-8ef482f7c633" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{z}^{2}}{7{y}^{2}}" :db/id #edb/ref 17592186255440} :answer-field/id #uuid "f0e1979e-9b8d-5dba-99be-fec18020084f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255438}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cccdc975-f676-5a12-a43a-65d0c1bf8dcc" :question/math-academy-id "q-113821" :question/problem "What is $\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}}?$" :question/worked-solution "To compute\n\n$$\n\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2{y}^{2}z}÷\\frac{7{x}^{2}}{6{z}^{3}} & = \\\\ \\frac{{x}^{2}}{2{y}^{2}z}\\cdot \\frac{6{z}^{3}}{7{x}^{2}} & = \\\\ \\frac{{x}^{2}}{{y}^{2}\\cdot 2z}\\cdot \\frac{3\\cdot 2z\\cdot {z}^{2}}{7\\cdot {x}^{2}} & = \\\\ \\frac{\\cancel{{x}^{2}}}{{y}^{2}\\cdot \\cancel{2z}}\\cdot \\frac{3\\cdot \\cancel{2z}\\cdot {z}^{2}}{7\\cdot \\cancel{{x}^{2}}} & = \\\\ \\frac{3{z}^{2}}{7{y}^{2}} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255444 :knowledge-point/_questions [{:knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b674be09-6b07-5b5c-aae3-ec6e5970d092" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186255446} {:answer/id #uuid "adc3f867-ba61-5171-91d3-7c92ad62b187" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186255447} {:answer/id #uuid "1737e0cb-64dc-5b1c-a07d-2c5033ec5015" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11{y}^{2}}{k+4}" :db/id #edb/ref 17592186255448} {:answer/id #uuid "d1eb18c6-10c1-54bf-9fe6-74822174e4d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k+4}{{y}^{2}}" :db/id #edb/ref 17592186255449} {:answer/id #uuid "160395d8-73d1-5427-9afa-9234d1ca1ea3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186255450}] :answer-field/correct {:answer/id #uuid "160395d8-73d1-5427-9afa-9234d1ca1ea3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186255450} :answer-field/id #uuid "de9116df-bcdd-527e-97ee-36be35494d84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255445}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d63e432a-dafe-59e7-b42e-659f5003a777" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} & = \\\\ \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} & = \\\\ \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} & = \\\\ \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} & = \\\\ \\frac{2(k+2)}{{y}^{2}}\\cdot 11 & = \\\\ \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255451 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bc27633-cfde-532e-a38a-28d195fd2a5b" :knowledge-point/title "Dividing Rational Expressions and Simplifying the Result by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac10d4a-c162-5be1-9c84-b25ef101b762" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255453} {:answer/id #uuid "6d5cc1a5-62dd-5acb-8976-c4e4b0672f67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5n}{2}" :db/id #edb/ref 17592186255454} {:answer/id #uuid "02a04dfa-2417-5a0c-b000-f329bf83c544" :answer/type {:db/ident :answer.type/math} :answer/value "2n" :db/id #edb/ref 17592186255455} {:answer/id #uuid "80e05a92-4c9a-5ce6-9c28-32cb14169b92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n}{4}" :db/id #edb/ref 17592186255456} {:answer/id #uuid "608973db-a50b-5d6b-83cc-661af6271ce0" :answer/type {:db/ident :answer.type/math} :answer/value "10n" :db/id #edb/ref 17592186255457}] :answer-field/correct {:answer/id #uuid "7ac10d4a-c162-5be1-9c84-b25ef101b762" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255453} :answer-field/id #uuid "026d9923-69bb-517c-95b6-c18b901daabd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255452}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "95d9e878-06a6-54fb-9468-3e24b1f6f1fc" :question/math-academy-id "q-3498" :question/problem "$\\frac{8n}{2n-6}÷\\frac{4n}{10n-30}=$" :question/worked-solution "To compute\n\n$$\n\\frac{8n}{2n-6}÷\\frac{4n}{10n-30},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{8n}{2n-6}÷\\frac{4n}{10n-30} & = \\\\ \\frac{8n}{2n-6}\\cdot \\frac{10n-30}{4n} & = \\\\ \\frac{4n\\cdot 2}{2n-6}\\cdot \\frac{5(2n-6)}{4n} & = \\\\ \\frac{\\cancel{4n}\\cdot 2}{\\cancel{2n-6}}\\cdot \\frac{5\\cancel{(2n-6)}}{\\cancel{4n}} & = \\\\ 2\\cdot 5 & = \\\\ 10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255458 :knowledge-point/_questions [{:knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e3d48de-c461-5ed0-b175-a76ec70948f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{t}" :db/id #edb/ref 17592186255460} {:answer/id #uuid "20e4d2b5-62bb-5d7e-8474-29194fe7f742" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2t}{9}" :db/id #edb/ref 17592186255461} {:answer/id #uuid "3dcacdfb-84bf-5c09-999f-061732539eea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{{t}^{2}}" :db/id #edb/ref 17592186255462} {:answer/id #uuid "90b93b0b-2182-5990-b233-045fa6b4c78b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2{t}^{2}}" :db/id #edb/ref 17592186255463} {:answer/id #uuid "42af9140-8407-5296-99e6-4ad1218a4992" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{2}}{9}" :db/id #edb/ref 17592186255464}] :answer-field/correct {:answer/id #uuid "90b93b0b-2182-5990-b233-045fa6b4c78b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2{t}^{2}}" :db/id #edb/ref 17592186255463} :answer-field/id #uuid "dbb5b2e7-6872-55a0-b18b-1c7d38a4fcda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255459}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c239dc2a-bf83-5cf6-aff3-ffc112d12adb" :question/math-academy-id "q-70353" :question/problem "What is the result of dividing $\\frac{9}{{t}^{3}}$ by $\\frac{2}{t}?$" :question/worked-solution "To compute\n\n$$\n\\frac{9}{{t}^{3}}÷\\frac{2}{t},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9}{{t}^{3}}÷\\frac{2}{t} & = \\\\ \\frac{9}{{t}^{3}}\\cdot \\frac{t}{2} & = \\\\ \\frac{9t}{2{t}^{3}} & = \\\\ \\frac{9\\cancel{t}}{2{t}^{2}\\cdot \\cancel{t}} & = \\\\ \\frac{9}{2{t}^{2}} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $t$ in the numerator and denominator."}]}
