#{[{:db/id #edb/ref 17592186355156 :knowledge-point/_questions [{:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7115cbf-2a8c-5a6d-a1df-c6009058ef87" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186355158} {:answer/id #uuid "f76f4e48-ebd3-579d-9229-3ccac8cd9767" :answer/type {:db/ident :answer.type/math} :answer/value "x<-3" :db/id #edb/ref 17592186355159} {:answer/id #uuid "de7119fd-f799-5cbe-b151-bfa1739403a3" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186355160} {:answer/id #uuid "6d05d526-5375-5fad-b04f-684af95ec459" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡3}{6}-1" :db/id #edb/ref 17592186355161} {:answer/id #uuid "f65836fa-88ac-5d7a-9690-5f048bfa84db" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡3}{2}+6" :db/id #edb/ref 17592186355162}] :answer-field/correct {:answer/id #uuid "de7119fd-f799-5cbe-b151-bfa1739403a3" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186355160} :answer-field/id #uuid "aec695a4-84bb-5965-af87-a569df499ba0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355157}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ee54207-e6ba-5f31-8fde-08e9c4938270" :question/math-academy-id "q-115233" :question/problem "Solve the inequality $2{(\\frac{1}{3})}^{2x+7}+1<-5.$" :question/worked-solution "First, we isolate the exponential term:\n\n$$\n\\begin{aligned}2{(\\frac{1}{3})}^{2x+7}+1 & <-5 \\\\ 2{(\\frac{1}{3})}^{2x+7} & <-6 \\\\ {(\\frac{1}{3})}^{2x+7} & <-3.\\end{aligned}\n$$\n\nNext, recall that a positive number raised to any real power is always positive. Since $\\frac{1}{3}>0,$ we have\n\n$$\n{(\\frac{1}{3})}^{2x+7}>0\n$$\n\nfor every real value of $x.$\n\nTherefore, ${(\\frac{1}{3})}^{2x+7}$ cannot be less than $-3.$ Hence, the inequality\n\n$$\n{(\\frac{1}{3})}^{2x+7}<-3\n$$\n\nhas no solutions."}] [{:db/id #edb/ref 17592186355163 :knowledge-point/_questions [{:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c5b0654-2f1c-5c56-8b77-615143ac5f47" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355165} {:answer/id #uuid "960d47f8-01d6-58e9-b271-4c3534a0c237" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186355166}] :answer-field/correct {:answer/id #uuid "960d47f8-01d6-58e9-b271-4c3534a0c237" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186355166} :answer-field/id #uuid "53dfce40-243d-54b5-972d-90d655ef4d3f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355164} {:answer-field/choices [{:answer/id #uuid "95d8b922-5e36-5aa7-954e-179c9f926e0c" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186355168}] :answer-field/correct {:answer/id #uuid "95d8b922-5e36-5aa7-954e-179c9f926e0c" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186355168} :answer-field/id #uuid "07f53230-a5e4-570f-b796-40bf2a8d54be" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355167} {:answer-field/choices [{:answer/id #uuid "93aebea1-8de4-5ef3-8d34-7b60b72c9583" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186355170}] :answer-field/correct {:answer/id #uuid "93aebea1-8de4-5ef3-8d34-7b60b72c9583" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186355170} :answer-field/id #uuid "2399b3cc-e427-5f6a-a14e-906d9d78fd44" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355169}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94b9c62a-0811-5dce-a2b5-16a90ad4772b" :question/math-academy-id "q-277887" :question/problem "Solve the inequality $-(0.75)^{2-3x}<(0.98)^{3x-1}.$\n\n{{field-1}}\n$<\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "Since $(0.98)^{3x-1}$ is always positive and $-(0.75)^{2-3x}$ is always negative, we always have\n\n$$\n-(0.75)^{2-3x}<(0.98)^{3x-1}.\n$$\n\nThis means that the given inequality is satisfied by all real values of $x.$\n\nTherefore,\n\n$$\n-\\infty <x<\\infty \n$$"}] [{:db/id #edb/ref 17592186355171 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cae78912-b81d-555d-8d98-6f257b499c47" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡(9\\sqrt{3})-\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186355173} {:answer/id #uuid "7c68af60-ec46-574b-82f2-e0664a4d68b9" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡(9\\sqrt{3})+\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186355174} {:answer/id #uuid "f958928b-8f25-5bd0-b4cb-5892c64e7e0d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡(9\\sqrt{3})}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186355175} {:answer/id #uuid "a78770ef-3fe3-56f7-9c05-e4d09d459051" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(9\\sqrt{3})}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186355176} {:answer/id #uuid "cc07a8a9-56ee-5707-a5b9-146513dfeeaa" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡(9\\sqrt{3})-\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186355177}] :answer-field/correct {:answer/id #uuid "a78770ef-3fe3-56f7-9c05-e4d09d459051" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(9\\sqrt{3})}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186355176} :answer-field/id #uuid "d60c77db-f966-5c7a-93a6-10618646dc03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355172}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b94169f1-377c-5964-ba3c-f879e9c9f359" :question/math-academy-id "q-365299" :question/problem "Solve the inequality $\\frac{1}{3}{(\\frac{3}{5})}^{x}\\le 3\\sqrt{3}.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{3}{(\\frac{3}{5})}^{x} & \\le 3\\sqrt{3} \\\\ {(\\frac{3}{5})}^{x} & \\le 3\\cdot 3\\sqrt{3} \\\\ {(\\frac{3}{5})}^{x} & \\le 9\\sqrt{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{3}{5})}^{x}] & \\le \\operatorname{ln}⁡(9\\sqrt{3}) \\\\ x\\operatorname{ln}⁡(\\frac{3}{5}) & \\le \\operatorname{ln}⁡(9\\sqrt{3}) \\\\ x(\\operatorname{ln}⁡3-\\operatorname{ln}⁡5) & \\le \\operatorname{ln}⁡(9\\sqrt{3}).\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡3-\\operatorname{ln}⁡5$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\ge \\frac{\\operatorname{ln}⁡(9\\sqrt{3})}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355178 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f802065-f50f-5f38-85ef-8058112b2f8b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -\\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡4}-4" :db/id #edb/ref 17592186355180} {:answer/id #uuid "f31cdbe2-ee53-53ef-8410-de2be45ddebe" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡4}+4" :db/id #edb/ref 17592186355181} {:answer/id #uuid "77428710-3263-5446-b53e-ad572945fd3c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}+4" :db/id #edb/ref 17592186355182} {:answer/id #uuid "a84c35e4-8b3a-50b9-b31f-d6b65903d516" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}-4" :db/id #edb/ref 17592186355183} {:answer/id #uuid "cd8fe6bd-dfc9-580d-8fa0-2958c88408fe" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3}-4" :db/id #edb/ref 17592186355184}] :answer-field/correct {:answer/id #uuid "a84c35e4-8b3a-50b9-b31f-d6b65903d516" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}-4" :db/id #edb/ref 17592186355183} :answer-field/id #uuid "b03ac8ac-3bb7-5420-a6d0-4435d75249c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b3c40d0-95c1-536f-a37b-d489b8751edb" :question/math-academy-id "q-87731" :question/problem "Solve the inequality ${(\\frac{1}{3})}^{x+4}-3\\le 1.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(\\frac{1}{3})}^{x+4}-3 & \\le 1 \\\\ {(\\frac{1}{3})}^{x+4} & \\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{1}{3})}^{x+4}] & \\le \\operatorname{ln}⁡4 \\\\ (x+4)\\operatorname{ln}⁡(\\frac{1}{3}) & \\le \\operatorname{ln}⁡4 \\\\ (x+4)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡3) & \\le \\operatorname{ln}⁡4 \\\\ -(x+4)\\operatorname{ln}⁡3 & \\le \\operatorname{ln}⁡4\\end{aligned}\n$$\n\nLastly, note that $-\\operatorname{ln}⁡3$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+4 & \\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3} \\\\ x & \\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}-4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355185 :knowledge-point/_questions [{:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b6be53-2ece-5241-a373-ed59c3703ba0" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186355187} {:answer/id #uuid "2e0ae556-8c69-5925-8a5e-98128707e241" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186355188} {:answer/id #uuid "672b98ad-b29f-556d-84bb-e8adb5210888" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡2}{12\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186355189} {:answer/id #uuid "86abc422-c988-51dd-bb35-59d14f94e836" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{2\\operatorname{ln}⁡6}{7\\operatorname{ln}⁡12}" :db/id #edb/ref 17592186355190} {:answer/id #uuid "91eb38bb-6f32-50ad-917e-8d5816f6f33f" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{2\\operatorname{ln}⁡6}{\\operatorname{ln}⁡12}" :db/id #edb/ref 17592186355191}] :answer-field/correct {:answer/id #uuid "39b6be53-2ece-5241-a373-ed59c3703ba0" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186355187} :answer-field/id #uuid "c9ba1ebf-2611-57f9-968c-e570139dcd8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355186}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "019afbc4-64db-5396-aa9e-b5972e6733b2" :question/math-academy-id "q-87862" :question/problem "Solve the inequality $-{2}^{6x-1}<{12}^{x}.$" :question/worked-solution "Since ${12}^{x}$ is always positive and $-{2}^{6x-1}$ is always negative, we always have\n\n$$\n-{2}^{6x-1}<{12}^{x}.\n$$\n\nThis means that the given inequality is satisfied by all real values of $x.$"}]}
