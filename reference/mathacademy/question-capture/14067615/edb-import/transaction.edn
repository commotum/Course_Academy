[{:db/id "q-87731/selection/573bef1d10bf91a31ea8321d4b57409c8832f2702e7b0d4ed7847de6a9257461" :answer/id #uuid "77428710-3263-5446-b53e-ad572945fd3c" :answer/type :answer.type/math :answer/value "x\\le -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}+4" :db/ensure [:answer/validate]} {:db/id "q-87731/selection/1204f559b0410fcad98597e9dc6fe941a521fe5771198fae38ccb071897264d7" :answer/id #uuid "f31cdbe2-ee53-53ef-8410-de2be45ddebe" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡4}+4" :db/ensure [:answer/validate]} {:db/id "q-87731/selection/c32562c1b72b2185757d45a5038b259027437afa3e864468a550c57d4e878b0a" :answer/id #uuid "cd8fe6bd-dfc9-580d-8fa0-2958c88408fe" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3}-4" :db/ensure [:answer/validate]} {:db/id "q-87731/selection/713c4b66726af3a362e9dce0bc18758b90a5f378e232f79a3e52ef775e7b949a" :answer/id #uuid "a84c35e4-8b3a-50b9-b31f-d6b65903d516" :answer/type :answer.type/math :answer/value "x\\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}-4" :db/ensure [:answer/validate]} {:db/id "q-87731/selection/10a9240d063bb9b5fcadc37da70a03a2a6a5f7c6af6f38d84efea6a75b3e1a2b" :answer/id #uuid "8f802065-f50f-5f38-85ef-8058112b2f8b" :answer/type :answer.type/math :answer/value "x\\le -\\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡4}-4" :db/ensure [:answer/validate]} {:db/id "q-87731/selection" :answer-field/id #uuid "b03ac8ac-3bb7-5420-a6d0-4435d75249c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87731/selection/713c4b66726af3a362e9dce0bc18758b90a5f378e232f79a3e52ef775e7b949a" :answer-field/choices ["q-87731/selection/573bef1d10bf91a31ea8321d4b57409c8832f2702e7b0d4ed7847de6a9257461" "q-87731/selection/1204f559b0410fcad98597e9dc6fe941a521fe5771198fae38ccb071897264d7" "q-87731/selection/c32562c1b72b2185757d45a5038b259027437afa3e864468a550c57d4e878b0a" "q-87731/selection/713c4b66726af3a362e9dce0bc18758b90a5f378e232f79a3e52ef775e7b949a" "q-87731/selection/10a9240d063bb9b5fcadc37da70a03a2a6a5f7c6af6f38d84efea6a75b3e1a2b"] :db/ensure [:answer-field/validate]} {:db/id "q-87731" :question/id #uuid "1b3c40d0-95c1-536f-a37b-d489b8751edb" :question/math-academy-id "q-87731" :question/problem "Solve the inequality ${(\\frac{1}{3})}^{x+4}-3\\le 1.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(\\frac{1}{3})}^{x+4}-3 & \\le 1 \\\\ {(\\frac{1}{3})}^{x+4} & \\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{1}{3})}^{x+4}] & \\le \\operatorname{ln}⁡4 \\\\ (x+4)\\operatorname{ln}⁡(\\frac{1}{3}) & \\le \\operatorname{ln}⁡4 \\\\ (x+4)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡3) & \\le \\operatorname{ln}⁡4 \\\\ -(x+4)\\operatorname{ln}⁡3 & \\le \\operatorname{ln}⁡4\\end{aligned}\n$$\n\nLastly, note that $-\\operatorname{ln}⁡3$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+4 & \\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3} \\\\ x & \\ge -\\frac{\\operatorname{ln}⁡4}{\\operatorname{ln}⁡3}-4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87731/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4"] :knowledge-point/questions ["q-87731"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87862/selection/cd64bf4c6055a81e0943501308273a76a87a779d3a8fec5c824c763b0a9dfa6b" :answer/id #uuid "86abc422-c988-51dd-bb35-59d14f94e836" :answer/type :answer.type/math :answer/value "x>\\frac{2\\operatorname{ln}⁡6}{7\\operatorname{ln}⁡12}" :db/ensure [:answer/validate]} {:db/id "q-87862/selection/ecb66f227dc45d6aecfb64a73892228cdebc6b2e0afaf65209401b77fc157c12" :answer/id #uuid "91eb38bb-6f32-50ad-917e-8d5816f