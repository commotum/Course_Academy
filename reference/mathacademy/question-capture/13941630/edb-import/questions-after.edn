#{[{:db/id #edb/ref 17592186249978 :knowledge-point/_questions [{:knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd61aa77-1866-549b-81ab-e873fa601dbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28}{5}" :db/id #edb/ref 17592186249980} {:answer/id #uuid "1b7e42b1-9d90-5fb1-9a1f-258b07c90f39" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186249981} {:answer/id #uuid "4ac7575e-0550-55af-a433-7b447bde60df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{4}" :db/id #edb/ref 17592186249982} {:answer/id #uuid "040a25f0-253a-5aed-876e-037399840c82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186249983} {:answer/id #uuid "2b672602-da10-5d3e-bbd5-4af5e71f3202" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{5}" :db/id #edb/ref 17592186249984}] :answer-field/correct {:answer/id #uuid "1b7e42b1-9d90-5fb1-9a1f-258b07c90f39" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186249981} :answer-field/id #uuid "d94f5858-bbd6-5b39-9230-8b2035d37f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249979}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8939a741-dcf0-52cf-a781-11f9336a3693" :question/math-academy-id "q-167338" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941630/assets/ec6deda5b2400258af6ad455cdfa0072deb754391feb4d916082568c248d95ee.png)\n\nThe graph above shows $y=k{(\\frac{4}{5})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{4}{5})}^{x}$ we take the graph of $y={(\\frac{4}{5})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,7)$ on the graph to $(0,k),$ we see that we must have $k=7.$"}] [{:db/id #edb/ref 17592186111036 :knowledge-point/_questions [{:knowledge-point/id #uuid "46b4837f-6ba5-5812-8dc7-4671fcd6b20d" :knowledge-point/title "Plotting a Vertically Scaled Exponential Decay Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80312b10-9be3-524d-bdd4-914c3cd80b14" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-5.png" :db/id #edb/ref 17592186108327} {:answer/id #uuid "b7596d57-ee41-5821-8400-838b7bf75c10" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-2.png" :db/id #edb/ref 17592186108328} {:answer/id #uuid "133140fd-869e-5c49-bc26-60b298262ff0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-1.png" :db/id #edb/ref 17592186108329} {:answer/id #uuid "67ec59ba-7dc8-50bf-92a8-c91810f0c7a3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-3.png" :db/id #edb/ref 17592186108330} {:answer/id #uuid "74c3b878-4967-5d12-8b03-455c3f76c1c2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-4.png" :db/id #edb/ref 17592186108331}] :answer-field/correct {:answer/id #uuid "133140fd-869e-5c49-bc26-60b298262ff0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-27528-a-1.png" :db/id #edb/ref 17592186108329} :answer-field/id #uuid "a534d624-6a42-5705-b332-7460849e50bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108326}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "295c5229-9445-576b-a9f6-1d0acb3e6aa1" :question/math-academy-id "q-27528" :question/problem "Which of the following is the graph of $y = 2(\\frac{1}{8})^{x}$?" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{8})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941630/assets/b23108c36c016f3022dd3650bbd8bb70ebea27c19f8b8f62d439a4eebe7187f4.png)\n\nThen, we scale this graph by a factor of $2.$ The $y$-intercept becomes $(0,2),$ and the resulting graph is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941630/assets/3dcd10cdeec52258b04705865196a1d59269c298b3821b87f7b0afe7727f740b.png)"}] [{:db/id #edb/ref 17592186249985 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14888b4c-a03a-5a91-b79f-1edee3a59218" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249987} {:answer/id #uuid "c8c363ef-2f3c-5f67-88ba-30824c194a81" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249988} {:answer/id #uuid "725afeb6-e3bb-5ca4-940a-eac455458a9c" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249989} {:answer/id #uuid "6f7ef81e-2059-543d-af83-dfffa4b44570" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249990} {:answer/id #uuid "f8b5e499-e673-54e4-81cf-24244582d966" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249991}] :answer-field/correct {:answer/id #uuid "c8c363ef-2f3c-5f67-88ba-30824c194a81" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249988} :answer-field/id #uuid "fe47b545-d0c9-53dd-a1b1-09cea81f1901" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249986}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dec52dca-c6e8-5d10-98b6-f6a6bc404648" :question/math-academy-id "q-28981" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.08)^{x}?$\n\n- Its range is $y>0$\n- It is an increasing function\n- $f(x)\\to 0$ as $x\\to \\infty $" :question/worked-solution "Let's start by recalling the graph of ${(0.08)}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941630/assets/b4e3b5119c92d02bbceb786fefd238182c7c84ca0f4abc85a19f2df86a6ba267.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The set of possible outputs of $f(x)={(0.08)}^{x}$ consists of all the positive numbers.\n\n- Statement II is false. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement III is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186249992 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaff22bf-6cfd-56c9-b196-6794367840c3" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249994} {:answer/id #uuid "88323acb-113b-5d92-9851-0de21f1a8446" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249995} {:answer/id #uuid "8f280868-28b0-5807-a0bc-bf255d95d371" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249996} {:answer/id #uuid "2370c36c-b2b6-52ac-ba2f-905cea931fdd" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249997} {:answer/id #uuid "cee47831-efc3-5955-9a5d-9a0763761256" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249998}] :answer-field/correct {:answer/id #uuid "2370c36c-b2b6-52ac-ba2f-905cea931fdd" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249997} :answer-field/id #uuid "56aa4da9-c9b0-598b-92b5-ccea76c3b639" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249993}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "25c049b0-d191-57a8-a5d5-4a1829c58e6e" :question/math-academy-id "q-47745" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.125)^{x}?$\n\n- Its domain is $x>0$\n- Its range is $-\\infty <y<\\infty $\n- It has a horizontal asymptote $y=0$" :question/worked-solution "Let's start by recalling the graph of $y=(0.125)^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941630/assets/20fae3a813e249a6423567b448a1f5515c3b9127e7c0b82aad541e720db03aca.png)\n\nLet's go through the statements one by one.\n\n- Statement I is false. The function $f(x)=(0.125)^{x}$ is defined for all input values $x,$ so the domain is $-\\infty <x<\\infty .$\n\n- Statement II is false. The set of possible outputs of $f(x)=(0.125)^{x}$ consists of all the positive numbers, so the range is $y>0.$\n\n- Statement III is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $y=0$ is a horizontal asymptote of $y=f(x).$\n\nIn conclusion, only statement III is true."}] [{:db/id #edb/ref 17592186111316 :knowledge-point/_questions [{:knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ce5ce5-34b4-5b64-837a-0e974e1e2550" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186109992} {:answer/id #uuid "9d58b991-2df9-5253-abdf-0627437c161d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186109993} {:answer/id #uuid "e42c6580-3e81-568f-99c6-b93ddc635574" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186109994} {:answer/id #uuid "35430956-49ef-5094-8688-2efb1b5c8a97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186109995} {:answer/id #uuid "4e0c043f-bb5a-5b34-a834-aeb2ad7876b3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186109996}] :answer-field/correct {:answer/id #uuid "85ce5ce5-34b4-5b64-837a-0e974e1e2550" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186109992} :answer-field/id #uuid "214bb77d-e0af-51af-b1ba-bb6e845492b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109991}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-7249.png)\n\nThe graph above shows $y = k(\\frac{1}{3})^{x}$. What is the value of $k$?" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"}]}
