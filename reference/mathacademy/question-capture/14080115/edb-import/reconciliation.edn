 -2\\end{aligned}][\\begin{aligned}1 \\\\ -2\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-32137" "field" nil "attribute" "question/problem" "value" "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}7x-y=0 \\\\ x+4y=1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-32137" "field" nil "attribute" "question/worked-solution" "value" "This system can be written as\n\n$$\n[\\begin{aligned}7 & -1 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}7 & -1 \\\\ 1 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot 4-(-1)\\cdot 1}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}] \\\\  & =\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-32137" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-32137" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-32137" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=-\\frac{1}{27}[\\begin{aligned}7 & 1 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["math" "x=-\\frac{1}{29}[\\begin{aligned}7 & 1 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["math" "x=\\frac{1}{27}[\\begin{aligned}4 & -1 \\\\ 1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["math" "x=\\frac{1}{29}[\\begin{aligned}4 & -1 \\\\ 1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["math" "x=\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-32137" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" nil "attribute" "question/problem" "value" "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}3y-2x=5 \\\\ x=-1-4y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-3$ |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $-2$ |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-3$ |  |  |  |\n|  | {{field-3}} | $-2$ |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}-2x+3y=5 \\\\ x+4y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -1\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-2)\\cdot 4-1\\cdot 3}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-320842" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{11}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320842" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" nil "attribute" "question/problem" "value" "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}2y=7-3x \\\\ x+1=-2y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-2$ |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $3$ |  | |  |  |  | |  | $7$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-2$ |  |  |  |\n|  | {{field-3}} | $3$ |  |  |  |\n|  | $7$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}3x+2y=7 \\\\ x+2y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}3 & 2 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}7 \\\\ -1\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}3 & 2 \\\\ 1 & 2\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-1\\cdot 2}[\\begin{aligned}2 & -2 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}2 & -2 \\\\ -1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{4}[\\begin{aligned}2 & -2 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}7 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-320811" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-320811" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" nil "attribute" "question/problem" "value" "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}2x=8 \\\\ 4y=5+3x\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $0$ |  |\n| --- | --- | --- | --- |\n|  | $3$ | {{field-3}} |  | |  |  |  | |  | $8$ |  |\n| --- | --- | --- |\n|  | $5$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $0$ |  |  |  |\n|  | $3$ | {{field-3}} |  |  |  |\n|  | $8$ |  |  |  |  |\n|  | $5$ |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}2x+0y=8 \\\\ -3x+4y=5.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & 0 \\\\ -3 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}8 \\\\ 5\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 0 \\\\ -3 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 4-(-3)\\cdot 0}[\\begin{aligned}4 & 0 \\\\ 3 & 2\\end{aligned}] \\\\  & =\\frac{1}{8}[\\begin{aligned}4 & 0 \\\\ 3\\text{ } & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{8}[\\begin{aligned}4 & 0 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}8 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-321437" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{8}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321437" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-72738" "field" nil "attribute" "question/problem" "value" "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}-x=3y \\\\ y=-x+1\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-72738" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}-x-3y=0 \\\\ x+y=1\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}-1 & -3 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}-1 & -3 \\\\ 1 & 1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 1-(-3)\\cdot 1}[\\begin{aligned}1 & 3 \\\\ -1 & -1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ -1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-72738" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-72738" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-72738" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=-\\frac{1}{2}[\\begin{aligned}1 & -3 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]"] ["math" "x=-\\frac{1}{4}[\\begin{aligned}3 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}]"] ["math" "x=\\frac{1}{2}[\\begin{aligned}1 & -3 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]"] ["math" "x=\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] ["math" "x=\\frac{1}{4}[\\begin{aligned}-1 & 3 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-72738" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=\\frac{1}{2}[\\begin{aligned}1 & 3 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" nil "attribute" "question/problem" "value" "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}7y=-14 \\\\ 2y=5x+9\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $2$ | $-7$ |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} | $0$ |  | |  |  |  | |  | $-14$ |  |\n| --- | --- | --- |\n|  | {{field-3}} |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $2$ | $-7$ |  |  |  |\n|  | {{field-2}} | $0$ |  |  |  |\n|  | $-14$ |  |  |  |  |\n|  | {{field-3}} |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}0x+7y=-14 \\\\ -5x+2y=9.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}0 & 7 \\\\ -5 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-14 \\\\ 9\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 7 \\\\ -5 & 2\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{0\\cdot 2-(-5)\\cdot 7}[\\begin{aligned}2 & -7 \\\\ 5 & 0\\end{aligned}] \\\\  & =\\frac{1}{35}[\\begin{aligned}2 & -7 \\\\ 5 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{35}[\\begin{aligned}2 & -7 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}-14 \\\\ 9\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/activity-metadata.json" "file_sha256" "15f72590c5cf47608f44567117fb98403cd91cd3d890e8a8cc9bb4533a172ab4"} {"question" "q-321438" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{35}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "q-321438" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/state.json" "file_sha256" "e6bd797f9673fb4836dab37b786a6f9342e5452016951a8c391a36fc451087a0"} {"question" "e-4508" "field" nil "attribute" "question/problem" "value" "Find a solution to the system of linear equations\n\n$$\n{\\begin{aligned}2x+y=2 \\\\ 4x+3y=6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/example-4508.json" "file_sha256" "d17131c8d7efe2d7ddddcf3abd868c7fa15f99d722afb8f17107a8fa70d3856d"} {"question" "e-4508" "field" nil "attribute" "question/worked-solution" "value" "This system can be written as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/assets/843dcd4359e4b61eb9715966fbbe6c26363ab5cfc57c55f94b6a41a73ec7feb1.png)\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/assets/b9ba240f93ee3ec8c02e9718d62342dca0e0855e24c7b34ed97758a6eb7c46b8.png) This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-4\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nSo the solution is $x=0$ and $y=2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/example-4508.json" "file_sha256" "d17131c8d7efe2d7ddddcf3abd868c7fa15f99d722afb8f17107a8fa70d3856d"} {"question" "e-4509" "field" nil "attribute" "question/problem" "value" "Solve the system of linear equations\n\n$$\n{\\begin{aligned}2x-3y=5 \\\\ 6y-5x=-8.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/example-4509.json" "file_sha256" "aaaffdf9720c7bb11f5ce587904d17c7f034518fd9c9c2628b9803c2edb17155"} {"question" "e-4509" "field" nil "attribute" "question/worked-solution" "value" "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}2x-3y=5 \\\\ -5x+6y=-8.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x} =\\mathbf{b}\\mathbin{:}$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/assets/240a1d2f7f93ec808127c9fa1791a77a43fcd7c0c84505540acc81c8b9fbc6e1.png)\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/assets/7850cbafc78f2cf2ce14ae7111064bf2f5a029f4d1b97b6d5ebfc09e7126f44e.png) This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-3\\cdot 5}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}] \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}5 \\\\ -8\\end{aligned}] \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 \\\\ 9\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution is $x=-2$ and $y=-3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080115/example-4509.json" "file_sha256" "aaaffdf9720c7bb11f5ce587904d17c7f034518fd9c9c2628b9803c2edb17155"}] "usage" {"e-4508" [] "q-32141" [] "q-102705" [] "e-4509" []} "basis" 2830 "retractions" [[17592186091970 :question/worked-solution "This system can be written as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14052845/assets/843dcd4359e4b61eb9715966fbbe6c26363ab5cfc57c55f94b6a41a73ec7feb1.png)\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14052845/assets/b9ba240f93ee3ec8c02e9718d62342dca0e0855e24c7b34ed97758a6eb7c46b8.png) This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-4\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nSo the solution is $x=0$ and $y=2.$"] [17592186091971 :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}2x-3y=5 \\\\ -5x+6y=-8.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x} =\\mathbf{b}\\mathbin{:}$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14052845/assets/240a1d2f7f93ec808127c9fa1791a77a43fcd7c0c