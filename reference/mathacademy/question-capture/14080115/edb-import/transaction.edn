79e6c559ff8e5871a56fda130230930d3b7fe5c4712af2fb1af5f9129b74" "q-32026/selection/09658719343a23a621ec06900c55923fa46dbe2a968ba53f5a6ed0cfdb540554"] :db/ensure [:answer-field/validate]} {:db/id "q-32026" :question/id #uuid "c60618eb-8102-5d29-9fef-37f3fce33d0e" :question/math-academy-id "q-32026" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}5x-2y=1 \\\\ 8x+3y=0\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}5 & -2 \\\\ 8 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}5 & -2 \\\\ 8 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 3-(-2)\\cdot 8}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}] \\\\  & =\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32026/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32026"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32137/selection/efe89d47fd0775e21a718b09b1c19d273662f7bc77c0292783f53d1e311126cf" :answer/id #uuid "2960159d-d867-5ef2-878c-9da141f36f6f" :answer/type :answer.type/math :answer/value "x=\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32137/selection/72bd0af65c29e309bbc12a40c19734e630b6cf570ecd14240c0c4b178aaed03a" :answer/id #uuid "414bd85d-eba7-543b-ba16-d01203a0c633" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{29}[\\begin{aligned}7 & 1 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32137/selection/5deeac39ecb72d7a7572384e4a9b64f324dae77c4b7e00e3aaf8b1d775a28b76" :answer/id #uuid "acd10ffd-9626-575b-89d8-35f52a04af9a" :answer/type :answer.type/math :answer/value "x=\\frac{1}{29}[\\begin{aligned}4 & -1 \\\\ 1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32137/selection/b89f24571be90c91d761b22e328678c2aaf5e0ba678a8b07bc14d7ac3d4e12e6" :answer/id #uuid "d6798493-7b23-505b-967d-d5f09651f9d7" :answer/type :answer.type/math :answer/value "x=\\frac{1}{27}[\\begin{aligned}4 & -1 \\\\ 1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32137/selection/b3c870f6aa639414401498201211c2f0aa6f9ea5799a5bdfa12eaa7b15477d93" :answer/id #uuid "9dc1ce44-d953-560b-a515-aa9bfdf59402" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{27}[\\begin{aligned}7 & 1 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-32137/selection" :answer-field/id #uuid "d3b50bf7-adf3-5437-ace3-c8daf837d449" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32137/selection/efe89d47fd0775e21a718b09b1c19d273662f7bc77c0292783f53d1e311126cf" :answer-field/choices ["q-32137/selection/efe89d47fd0775e21a718b09b1c19d273662f7bc77c0292783f53d1e311126cf" "q-32137/selection/72bd0af65c29e309bbc12a40c19734e630b6cf570ecd14240c0c4b178aaed03a" "q-32137/selection/5deeac39ecb72d7a7572384e4a9b64f324dae77c4b7e00e3aaf8b1d775a28b76" "q-32137/selection/b89f24571be90c91d761b22e328678c2aaf5e0ba678a8b07bc14d7ac3d4e12e6" "q-32137/selection/b3c870f6aa639414401498201211c2f0aa6f9ea5799a5bdfa12eaa7b15477d93"] :db/ensure [:answer-field/validate]} {:db/id "q-32137" :question/id #uuid "544cdcc8-f2c6-58e4-8bdc-ceb9a0817bf2" :question/math-academy-id "q-32137" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}7x-y=0 \\\\ x+4y=1\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}7 & -1 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}7 & -1 \\\\ 1 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot 4-(-1)\\cdot 1}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}] \\\\  & =\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{29}[\\begin{aligned}4 & 1 \\\\ -1 & 7\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32137/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32137"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320842/field-1/fc5c11d990f3318da393f8e6ca9ca48c0d82b2f6c13de974653c16fa7068aacd" :answer/id #uuid "6aec926b-5ad0-5237-b7ae-e2ded3d4c234" :answer/type :answer.type/math :answer/value "-\\frac{1}{11}" :db/ensure [:answer/validate]} {:db/id "q-320842/field-1/63560ca0ca7d09733261935dc2bd0c9c7c25e5c2ee469d189671be7ed67bf209" :answer/id #uuid "878aa596-081d-59f0-8f19-5fc123e56583" :answer/type :answer.type/math :answer/value "\\frac{1}{11}" :db/ensure [:answer/validate]} {:db/id "q-320842/field-1" :answer-field/id #uuid "36ced547-f29d-56ef-b6a3-9e22c9b711c2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320842/field-1/fc5c11d990f3318da393f8e6ca9ca48c0d82b2f6c13de974653c16fa7068aacd" :answer-field/choices ["q-320842/field-1/fc5c11d990f3318da393f8e6ca9ca48c0d82b2f6c13de974653c16fa7068aacd" "q-320842/field-1/63560ca0ca7d09733261935dc2bd0c9c7c25e5c2ee469d189671be7ed67bf209"] :db/ensure [:answer-field/validate]} {:db/id "q-320842/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d09df128-fc7f-5abc-86c0-1ee4741f8371" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-320842/field-2" :answer-field/id #uuid "62212952-7c08-55e7-857d-38d9d089a9b2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320842/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-320842/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-320842/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "babc715a-533c-57eb-a97e-3172f9858bf9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-320842/field-3" :answer-field/id #uuid "597393b7-fa38-5c17-a6bb-d805291741ef" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320842/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-320842/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-320842" :question/id #uuid "26873337-21a0-5d43-97a3-1553d4d179f9" :question/math-academy-id "q-320842" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}3y-2x=5 \\\\ x=-1-4y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-3$ |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $-2$ |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-3$ |  |  |  |\n|  | {{field-3}} | $-2$ |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}-2x+3y=5 \\\\ x+4y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -1\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-2)\\cdot 4-1\\cdot 3}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-320842/field-1" "q-320842/field-2" "q-320842/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-320842"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320811/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "7b6dfa8e-bb8e-524d-bd53-f63ba7e8b63a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-320811/field-1" :answer-field/id #uuid "8ce308bf-4827-5c2b-94f7-b50802e28569" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320811/field-1/99f48c1b72e8eeab33eba