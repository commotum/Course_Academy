937e2f7d059ff6e394605a28813f5f7a43d9eeb472" "q-32028/selection/b9a79c347fb8082cdd013dd811f3e2596717c8bf1af56da787d60de70b5990b3" "q-32028/selection/30c8f37cf156dd90d038907d32da9293745e55f5c8367121d5d0b58492258a8f" "q-32028/selection/9dcfa58d2622cfdd077c74788aa5a1399f9cab478214b727f13283e0893ac638" "q-32028/selection/1fbde180b391b45fd28b9436d4b0a28f6791b2a74ad0f44c16b4cdef812619b4"] :db/ensure [:answer-field/validate]} {:db/id "q-32028" :question/id #uuid "9d699ebf-34e8-5074-8ce0-17eae71b7321" :question/math-academy-id "q-32028" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}x-7y=0 \\\\ -3x+6y=2\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}1 & -7 \\\\ -3 & 6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & -7 \\\\ -3 & 6\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 6-(-7)\\cdot (-3)}[\\begin{aligned}6 & 7 \\\\ 3 & 1\\end{aligned}] \\\\  & =-\\frac{1}{15}[\\begin{aligned}6 & 7 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{15}[\\begin{aligned}6 & 7 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32028/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32028"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32026/selection/644a366e748332174641de3b2b6e6c97d190330681591bd8099adc1c74a5783e" :answer/id #uuid "650a70e8-e69f-5d62-a110-d20091d57eb5" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3