3)}({x}^{2}+3)} \\\\  & =\\frac{2}{{x}^{2}+3}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+3=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes." 13194139533655 true] [17592186244436 1000 #edb/ref 17592186244437 13194139533655 true] [17592186244436 1000 #edb/ref 17592186244438 13194139533655 true] [17592186244436 1000 #edb/ref 17592186244439 13194139533655 true] [17592186244436 1000 #edb/ref 17592186244440 13194139533655 true] [17592186244436 1000 #edb/ref 17592186244441 13194139533655 true] [17592186244436 1040 #edb/ref 17592186045450 13194139533655 true] [17592186244436 1041 "selection" 13194139533655 true] [17592186244436 1104 #edb/ref 17592186244441 13194139533655 true] [17592186244436 1110 #uuid "0cc2b385-a50a-5c79-bfee-a5205565d2d0" 13194139533655 true] [17592186244437 1034 "$x=0$ and $x=\\sqrt{3}$" 13194139533655 true] [17592186244437 1103 #edb/ref 17592186045454 13194139533655 true] [17592186244437 1111 #uuid "9483f33d-2de1-5f76-8fe8-e0fca53b7172" 13194139533655 true] [17592186244438 1034 "$x=-\\sqrt{3},x=0$ and $x=\\sqrt{3}$" 13194139533655 true] [17592186244438 1103 #edb/ref 17592186045454 13194139533655 true] [17592186244438 1111 #uuid "f4640ffd-657d-529c-8dbc-10f5e811b562" 13194139533655 true] [17592186244439 1034 "$x=\\sqrt{3}$ only" 13194139533655 true] [17592186244439 1103 #edb/ref 17592186045454 13194139533655 true] [17592186244439 1111 #uuid "7b29c80e-0081-5110-bde7-2ab508f0b0a1" 13194139533655 true] [17592186244440 1034 "$x=0$ and $x=-3$" 13194139533655 true] [17592186244440 1103 #edb/ref 17592186045454 13194139533655 true] [17592186244440 1111 #uuid "9d936e93-b5b8-59f1-91e9-c12a6e94cc65" 13194139533655 true] [17592186244441 1034 "The function has no vertical asymptotes" 13194139533655 true] [17592186244441 1103 #edb/ref 17592186045454 13194139533655 true] [17592186244441 1111 #uuid "7f554535-ede4-51cf-9470-9f28aab72341" 13194139533655 true] [17592186244442 1017 #edb/ref 17592186244443 13194139533655 true] [17592186244442 1017 #edb/ref 17592186244446 13194139533655 true] [17592186244442 1089 "q-269955" 13194139533655 true] [17592186244442 1091 #edb/ref 17592186045465 13194139533655 true] [17592186244442 1100 "In **ascending order**, the vertical asymptotes of $f(x)=\\frac{6{x}^{2}+9x}{{x}^{2}-4}$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." 13194139533655 true] [17592186244442 1113 #uuid "b9201242-1fd6-516c-b0f6-ef17add9a817" 13194139533655 true] [17592186244442 1138 false 13194139533655 true] [17592186244442 1145 "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{3x(2x+3)}{(x-2)(x+2)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+2)(x-2) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-2$ and $x=2.$ \n\nTherefore, in ascending order, the equations of the vertical asymptotes are $x=-2$ and $x=2.$" 13194139533655 true] [17592186244443 1000 #edb/ref 17592186244444 13194139533655 true] [17592186244443 1000 #edb/ref 17592186244445 13194139533655 true] [17592186244443 1040 #edb/ref 17592186045449 13194139533655 true] [17592186244443 1041 "field-1" 13194139533655 true] [17592186244443 1104 #edb/ref 17592186244445 13194139533655 true] [17592186244443 1110 #uuid "e0e6d57d-1413-5ef2-8457-acd868828b95" 13194139533655 true] [17592186244444 1034 "-3" 13194139533655 true] [17592186244444 1103 #edb/ref 17592186045453 13194139533655 true] [17592186244444 1111 #uuid "d1499fc5-b305-56cb-b1b7-34ddf36ad460" 13194139533655 true] [17592186244445 1034 "-2" 13194139533655 true] [17592186244445 1103 #edb/ref 17592186045453 13194139533655 true] [17592186244445 1111 #uuid "844e61c6-7a55-51f9-9cfd-e75d247c2818" 131941