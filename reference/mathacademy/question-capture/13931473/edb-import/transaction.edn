[{:db/id "q-80669/selection/8dd0139fe2bdff82a7de02af21e81b3fb0031e695d60709e4cec3b9cfa395bee" :answer/id #uuid "16ce1a08-4a57-5f73-91bb-f20f8d91e4cb" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "q-80669/selection/e5d103e2c07ae759d9eddce65c552ccfa6a5a00acf0aea2f18942b9a819f2577" :answer/id #uuid "8216ba9a-7ffd-521e-a6c3-f204b4d6123f" :answer/type :answer.type/text :answer/value "The function has no vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-80669/selection/ee36bfd5893f10f027de9348b0245cb3d9de76710fcbc6aa97df5c086b7f6b68" :answer/id #uuid "f2e33ed1-896d-5533-b219-4bd9aa16612c" :answer/type :answer.type/math :answer/value "x=-3,\\,x=0" :db/ensure [:answer/validate]} {:db/id "q-80669/selection/c00b423d38fc022695304b5623f8f16d80f952174b860c25dbbf7c6f3e0429ea" :answer/id #uuid "b7a175bc-8486-5624-9c0a-56fd144f31f0" :answer/type :answer.type/text :answer/value "$x=4$ only" :db/ensure [:answer/validate]} {:db/id "q-80669/selection/eb6eaf67e30a81bf80ce2d773894c8a55f3cd73ff14914a96f0813b876fc6e3d" :answer/id #uuid "6b8b8e31-ef62-59a2-a256-857fdfe6de1a" :answer/type :answer.type/math :answer/value "x=-1,\\,x=4" :db/ensure [:answer/validate]} {:db/id "q-80669/selection" :answer-field/id #uuid "6e533f30-f259-58a4-906a-25775d9771ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80669/selection/eb6eaf67e30a81bf80ce2d773894c8a55f3cd73ff14914a96f0813b876fc6e3d" :answer-field/choices ["q-80669/selection/8dd0139fe2bdff82a7de02af21e81b3fb0031e695d60709e4cec3b9cfa395bee" "q-80669/selection/e5d103e2c07ae759d9eddce65c552ccfa6a5a00acf0aea2f18942b9a819f2577" "q-80669/selection/ee36bfd5893f10f027de9348b0245cb3d9de76710fcbc6aa97df5c086b7f6b68" "q-80669/selection/c00b423d38fc022695304b5623f8f16d80f952174b860c25dbbf7c6f3e0429ea" "q-80669/selection/eb6eaf67e30a81bf80ce2d773894c8a55f3cd73ff14914a96f0813b876fc6e3d"] :db/ensure [:answer-field/validate]} {:db/id "q-80669" :question/id #uuid "b6966b01-ab60-53fc-b128-2d7e18ed9248" :question/math-academy-id "q-80669" :question/is-example false :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}+3x}{{x}^{2}-3x-4}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x(x+3)}{(x+1)(x-4)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)(x-4) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-1$ and $x=4.$ Therefore, the equations of the vertical asymptotes are $x=-1$ and $x=4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc"] :knowledge-point/questions ["q-80669"] :db/ensure [:knowledge-point/validate]} {:db/id "q-269955/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "844e61c6-7a55-51f9-9cfd-e75d247c2818" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-269955/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "d1499fc5-b305-56cb-b1b7-34ddf36ad460" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-269955/field-1" :answer-field/id #uuid "e0e6d57d-1413-5ef2-8457-acd868828b95" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-269955/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-269955/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-269955/field-1/b13ac151352392d38026eed875b91170