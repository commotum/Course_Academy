b5ea4a7-acc4-5825-b6c5-b6c87e6a1674"] :knowledge-point/questions ["q-73409"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103434/selection/7acd0d51c9140ac6c0ed13cd7dd135102a72fe71d22dab3e0d3975533745668a" :answer/id #uuid "d9f89571-144c-55ea-bf8a-4e07b6f1cc38" :answer/type :answer.type/math :answer/value "x\\in (2,4)" :db/ensure [:answer/validate]} {:db/id "q-103434/selection/1cef022a0d7aed26e79cd0f2766eecbaf11d312bd4f5c3bf935219a1fe60c3f4" :answer/id #uuid "692bcfab-a633-5b18-9ce0-ddabf9fc5e01" :answer/type :answer.type/math :answer/value "x\\in {-1,0}\\cup [2,4)" :db/ensure [:answer/validate]} {:db/id "q-103434/selection/9283872e76a2eb9ab48632b9c59c194135a527467dab74a2fbe2c498eb4093a5" :answer/id #uuid "e03e9ab1-4602-5166-aa1e-5d30756fe5af" :answer/type :answer.type/math :answer/value "x\\in {-3,-1,0,2}" :db/ensure [:answer/validate]} {:db/id "q-103434/selection/50a1d46d73d9a5b3c2e0f760844c67ef12578122a4d3120b3d3c645f62ed5d4c" :answer/id #uuid "820a4ea4-e49a-52db-872f-67598e3abb3f" :answer/type :answer.type/math :answer/value "x\\in {-3,-1}" :db/ensure [:answer/validate]} {:db/id "q-103434/selection/7735c0be7e74d976c78c6992176964518232378848d78375909c7bc55bfb2020" :answer/id #uuid "161b45b3-450d-5498-b630-360399b890ba" :answer/type :answer.type/math :answer/value "x\\in {-3,-1}\\cup (2,4)" :db/ensure [:answer/validate]} {:db/id "q-103434/selection" :answer-field/id #uuid "5124d7b7-38e7-515e-a83e-0f09948badb4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103434/selection/7735c0be7e74d976c78c6992176964518232378848d78375909c7bc55bfb2020" :answer-field/choices ["q-103434/selection/7acd0d51c9140ac6c0ed13cd7dd135102a72fe71d22dab3e0d3975533745668a" "q-103434/selection/1cef022a0d7aed26e79cd0f2766eecbaf11d312bd4f5c3bf935219a1fe60c3f4" "q-103434/selection/9283872e76a2eb9ab48632b9c59c194135a527467dab74a2fbe2c498eb4093a5" "q-103434/selection/50a1d46d73d9a5b3c2e0f760844c67ef12578122a4d3120b3d3c645f62ed5d4c" "q-103434/selection/7735c0be7e74d976c78c6992176964518232378848d78375909c7bc55bfb2020"] :db/ensure [:answer-field/validate]} {:db/id "q-103434" :question/id #uuid "7d36563a-6e2c-5e9e-9cc2-a7be86e291cf" :question/math-academy-id "q-103434" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/07c617933910b3d82ed397fd77754beb2b49fef9bfb498dea3f51a392f6c1d03.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that\n\n- at $x=-3$ the tangent to the graph is horizontal, so we have ${f}^{′}(-3)=0,$\n\n- at $x=-1$ the tangent to the graph is horizontal, so we have ${f}^{′}(-1)=0,$\n\n- at any point between $x=2$ and $x=4$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/d8a2a08999b45a256fc0458069e50771c2c4ee03ab4f2ed1166f3aa8a1c70c83.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$ are $x=-3,$ $x=-1,$ and all values in the open interval $(2,4).$\n\n**Note:** At $x=0$ and $x=2$ there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points, but they are not stationary points." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103434/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674"] :knowledge-point/questions ["q-103434"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103442/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "cd2cff82-160c-55aa-8462-3e6c2f821b39" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-103442/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "2cce352f-dc8a-5166-b606-bf2ad69140bc" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-103442/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "6f3a6672-cc58-591c-a3bf-893dfc77f294" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-103442/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "b8605e9e-e8d0-50ff-9d5a-9d56e6f5753d" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-103442/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "daafd825-db15-5209-817d-4a5efa1ed438" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-103442/selection" :answer-field/id #uuid "c2bbcaf3-e66e-5528-969d-a32a23b50308" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103442/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-103442/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-103442/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-103442/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-103442/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" "q-103442/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-103442" :question/id #uuid "bc25f65f-6157-58dc-8973-bfb8847f3624" :question/math-academy-id "q-103442" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/7dc7480c7ee27073ff7be7475161742e317b30bf0c3e35af33dc93a772e6034a.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\n- $f(x)$ has a critical point at $x=-1$\n- $f(x)$ has a stationary point at $x=1$\n- $f(x)$ has a local maximum at $x=3$" :question/worked-solution "Let's check our statements.\n\n- Statement I is true. The function has a critical point (a corner) at $x=-1.$ In this case,  ${f}^{′}(-1)$ does not exist.\n\n- Statement II is false. The function has a critical point (a corner) at $x=1.$ In this case,  ${f}^{′}(-1)$ does not exist.\n\n- Statement III is false. The function has a local minimum at $x=3$ since $f(3)\\le f(x)$ for all $x$ close enough to $x=3.$\n\nTherefore, statement I is true, while statements II and III are false." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103442/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d"] :knowledge-point/questions ["q-103442"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48737/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3ed100cd-2886-5b4c-8a2d-5cfbe8c75069" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-48737/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "7bfacec1-1bdf-5550-9d6c-13eb465aaf8c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-48737/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c0220f13-86a9-5209-ba9a-13e1418a7b22" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-48737/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "b8c2b907-1524-5970-b8e8-e077011d69ae" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-48737/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :answer/id #uuid "6ab56549-2e7c-5847-83cf-24e69d803d84" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "q-48737/selection" :answer-field/id #uuid "6b13adb5-9271-58df-a814-55e4bc278f28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48737/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :answer-field/choices ["q-48737/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-48737/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-48737/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-48737/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-48737/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5"] :db/ensure [:answer-field/validate]} {:db/id "q-48737" :question/id #uuid "e1648c41-f8a3-54c4-a6c4-08a83701a800" :question/math-academy-id "q-48737" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/4a2298a8255a86c803560793658593a22f7f77590ef350c1e0cebd974fce7750.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\n- $f(x)$ has  a stationary point at $x=0$\n- $f(x)$ has  a local maximum at $x=2$\n- $f(x)$ has a critical point at $x=2$" :question/worked-solution "Let's check our statements.\n\n- Statement I is true. Stationary points are points where ${f}^{′}(x)=0.$ In this case,  the graph of the function has a horizontal tangent line at $x=0$ and therefore, ${f}^{′}(0)=0.$\n\n- Statement II is true. The function has a local maximum at $x=2$ since $f(2)\\ge f(x)$ for all $x$ close enough to $x=2.$\n\n- Statement III is true. The graph of the function has a sharp edge (corner) at $x=2$ and therefore, ${f}^{′}(2)$ does not exist. Hence, $x=2$ is a critical point of $f(x).$\n\nTherefore, all statements are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48737/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d"] :knowledge-point/questions ["q-48737"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48734/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "65897179-1624-586f-83d7-cb1f04490553" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-48734/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "ef95798c-ff6e-534f-935a-e47b1e23d900" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-48734/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "ba56ec51-0bdd-5152-8945-39ae8bedd052" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-48734/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f83b5b45-6a2a-5f8c-9b5b-00c3448fa764" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-48734/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "3d5d1f4b-9b21-5ee4-8851-623ea3a7adda" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-48734/selection" :answer-field/id #uuid "46661a1d-3864-5a96-a5e2-b5253f52d20d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48734/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-48734/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-48734/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-48734/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-48734/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-48734/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-48734" :question/id #uuid "dce9cb91-9336-5a8f-9d65-459010bc2821" :question/math-academy-id "q-48734" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/14fdc374842064ad40ebbadf3dab16191ecfdeec8c416b4e7f17beffce44fb40.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\n- $f(x)$ has a critical point at $x=3$\n- $f(x)$ has a stationary point at $x=3$\n- $f(x)$ has a local maximum at $x=3$" :question/worked-solution "Let's check our statements.\n\n- Statement I is true. The function has a critical point (a corner) at $x=3.$ In this case,  ${f}^{′}(3)$ does not exist.\n\n- Statement II is false. Stationary points are points where ${f}^{′}(x)=0.$ In this case,  the derivative is undefined at $x=3$\n\n- Statement III is false. The function does not have a local maximum at $x=3$ since $f(3)\\le f(x)$ for $x$ close enough  to the point $x=3,$ so,  actually,  $f(x)$ has local minimum at $x=3.$\n\nTherefore, only statement I is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48734/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d"] :knowledge-point/questions ["q-48734"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47919/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "709e56e6-2610-5af0-a991-a0856ce8ac5f" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-47919/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "90a80798-1acb-5c8c-9c73-003aeeca8168" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-47919/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "8d31cb47-0e46-5186-8664-e1c5c23d3e53" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-47919/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "3c563599-2a2f-54e7-a9ec-1f2eda3b11b0" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-47919/selection/4b7249b279275187b39c38bb448e56c0526d0fb949a1a6f36d04fa708923fc3e" :answer/id #uuid "e7f7dc24-7f82-5eae-ab2f-0810d3845890" :answer/type :answer.type/text :answer/value "$B$ and $D$ only" :db/ensure [:answer/validate]} {:db/id "q-47919/selection" :answer-field/id #uuid "771a0a25-0693-5931-a5ce-28de845dbde3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47919/selection/4b7249b279275187b39c38bb448e56c0526d0fb949a1a6f36d04fa708923fc3e" :answer-field/choices ["q-47919/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" "q-47919/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-47919/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-47919/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-47919/selection/4b7249b279275187b39c38bb448e56c0526d0fb949a1a6f36d04fa708923fc3e"] :db/ensure [:answer-field/validate]} {:db/id "q-47919" :question/id #uuid "62b39803-cf8b-5f2a-91f9-b83f48f12d0e" :question/math-academy-id "q-47919" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/d9d8fb6d663d8dfd0cce24ae3817c936e2e97ab2df7aefeaa0c734caf0311b94.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-3,10]$, which points represent the global maximum of $f(x)?$" :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest points are $B$ and $D$, and so these points represents the global maximum of $f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-47919/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d"] :knowledge-point/questions ["q-47919"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-48689"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/bb17384f2313820f526f1ba4356f6f3c9e11fbb3791e4f7e2c6044cc604bf662.png)\n\nWhich of the following statements are true with respect to the function $y=f(x)$ plotted above?\n\n- $f(x)$ has a stationary point at $x=2$\n- $f(x)$ has a local maximum at $x=2$\n- $f(x)$ has a critical point at $x=2$" :question/worked-solution "Let's check our statements.\n\n- Statement I is false. Stationary points are points where ${f}^{′}(x)=0.$ In this case, the graph of $f(x)$ has a has a sharp edge (cusp) at $x=2.$  Therefore, ${f}^{′}(2)$ does not exist and hence it can't be equal to zero.\n\n- Statement II is true. The function has a local maximum at $x=2$ since $f(x)\\le f(2)$ for $x$ near the point $x=2.$\n\n- Statement III is true. The function has a critical point (a corner) at $x=2$ since the derivative does not exist at this point." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6169"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/50581635273c185b9ca3aefa907b2e2a4981ec1bf6be1c687bec47591e126a89.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the stationary points?" :question/worked-solution "A stationary point of $f(x)$ is the value of $x$ where $f'(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=0$ and $x=4,$ the tangent to the graph is horizontal, so we have $f'(x)=0$ at those points.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/56e798c0942ddcf0b1786afb054ab6dfbea7768c86751555808d86cc4cfa89f6.png)\n\n  \n\nSo, there are two stationary points, and their $x$-coordinates are $x=0$ and $x=4$.\n\n**Note:** At $x=2$, there is a sharp corner, so $f'(2)$ doesn't exist. This gives one more critical point. But this is not a stationary point." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3726"] :question/problem "Which of the following statements are true with respect to the function $y=f(x)$ plotted below?\n\n- $f(x)$ has a stationary point at $x=2$\n\n- $f(x)$ has a local maximum at $x=2$\n\n- $f(x)$ has a critical point at $x=2$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980112/assets/0811362e235ec7c6e93a8bf892a451f8c347d0f633f251b9ed955062a53dd6c3.png)" :question/worked-solution "Let's check our statements.\n\n- Statement I is true. Stationary points are points where $f'(x) = 0.$ In this case, the graph of the function has a horizontal tangent line at $x=2$ and therefore, $f'(2)=0.$\n\n- Statement II is true. The function has a local maximum at $x=2$ since it is the highest point of a peak in a graph.\n\n- Statement III is true. The function has a critical point at $x=2$ since each stationary point is a critical point.\n\nTherefore, all three statements are true." :db/ensure [:question/validate]}]
