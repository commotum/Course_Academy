[{:db/id "q-19143/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a873e214-dbb7-5b0f-be79-b474599ed015" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-19143/selection/f2dfb98f76e4e3b3bbfaad8f2fbdd3582fdecef8b120cffed8ea15ef7eed0a23" :answer/id #uuid "8453e5a3-143d-58d5-a710-15dc5de35f62" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/ensure [:answer/validate]} {:db/id "q-19143/selection/78d6793131f73919b977c458aabf88ea3d8940c1c649bf2ec4f93d30bd180b17" :answer/id #uuid "adab8053-35e7-5f94-9153-0dc1a78622c2" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/ensure [:answer/validate]} {:db/id "q-19143/selection/adb288a6b6512e9f09f57875a1ab885e46d2059712f9c1bbdb4bd84ab93dd421" :answer/id #uuid "6640f4c6-2063-5cf8-919a-3a3d478e690c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/ensure [:answer/validate]} {:db/id "q-19143/selection/c34e5488dd109ab74c022a0239c1c5ffb105d18d6e118cc0537836cdc3c229c8" :answer/id #uuid "bbcc2840-1da5-5280-bf2b-7d80be1e9b5a" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/ensure [:answer/validate]} {:db/id "q-19143/selection" :answer-field/id #uuid "817fa168-f266-595a-8fed-8751f93b35eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19143/selection/78d6793131f73919b977c458aabf88ea3d8940c1c649bf2ec4f93d30bd180b17" :answer-field/choices ["q-19143/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-19143/selection/f2dfb98f76e4e3b3bbfaad8f2fbdd3582fdecef8b120cffed8ea15ef7eed0a23" "q-19143/selection/78d6793131f73919b977c458aabf88ea3d8940c1c649bf2ec4f93d30bd180b17" "q-19143/selection/adb288a6b6512e9f09f57875a1ab885e46d2059712f9c1bbdb4bd84ab93dd421" "q-19143/selection/c34e5488dd109ab74c022a0239c1c5ffb105d18d6e118cc0537836cdc3c229c8"] :db/ensure [:answer-field/validate]} {:db/id "q-19143" :question/id #uuid "e0f67e59-1e4d-5445-bf84-9d4a95336aa8" :question/math-academy-id "q-19143" :question/problem "Let $a=⟨2,1,-1⟩$ and $b=⟨1,4,2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-19143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237022/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "59c83e31-a989-583e-b751-a94f9e0f08ef" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-237022/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6d3ed044-2d9f-544b-96bd-8d8bc48e307b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-237022/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1bf60032-7361-5f81-80e5-0e14edae76d2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-237022/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "94704014-c7b5-53c7-a0b5-59f9ccae8731" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-237022/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "a620bf78-5b4f-5242-ae39-0ccca39b7264" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-237022/selection" :answer-field/id #uuid "981a7813-9650-54b7-96d0-775ba762c617" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237022/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-237022/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-237022/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-237022/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-237022/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-237022/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-237022" :question/id #uuid "c09537c4-8b80-537a-94fb-0ffa6cba60b2" :question/math-academy-id "q-237022" :question/problem "Let $p=⟨3,5,x⟩$ and $q=⟨-3,1,2⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237022/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237022"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275253/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "dfbe27a5-a487-5996-934a-bd323956b225" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-275253/field-1" :answer-field/id #uuid "9e7588ff-f308-5a3b-bf24-28bf886d1c30" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275253/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-275253/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-275253" :question/id #uuid "8a2ee8ec-46e7-556d-a874-477bcf20b3fc" :question/math-academy-id "q-275253" :question/problem "Let $p=⟨-1,2,1⟩$ and $q=⟨2,x,0⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 2+2\\cdot x+1\\cdot 0 \\\\  & =-2+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -2+2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275253/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-275253"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318977/field-1/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "f9c496ea-5ebb-52d0-888d-ecde8ff1f0df" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-318977/field-1/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" :answer/id #uuid "c797f622-846b-50d3-8aab-b46623508312" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "q-318977/field-1" :answer-field/id #uuid "4a7a40be-b5ed-50ab-8682-9e35eac5912c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318977/field-1/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-318977/field-1/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-318977/field-1/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a"] :db/ensure [:answer-field/validate]} {:db/id "q-318977" :question/id #uuid "8a7ea4fa-d66a-5267-bba1-de217933410d" :question/math-academy-id "q-318977" :question/problem "Let $p=⟨4,-1,1⟩$ and $q=⟨1,2,2⟩.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(4)(1)+(-1)(2)+(1)(2)}{\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{4-2+2}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318977/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-318977"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319171/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "1bcf84f5-af7e-5e1c-b912-1c3500934064" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-319171/field-1" :answer-field/id #uuid "37da1b28-1191-5323-840a-68f8d18e3a4a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319171/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-319171/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-319171" :question/id #uuid "693153e1-7945-56bf-830b-01e6c2d76a16" :question/math-academy-id "q-319171" :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319171/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-319171"] :db/ensure [:knowledge-point/validate]}]
