#{[{:db/id #edb/ref 17592186284518 :knowledge-point/_questions [{:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2" :knowledge-point/title "Differentiating an Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0951ee14-6620-5139-b32a-5d87b6312a96" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{28{x}^{3}}{7{x}^{2}+1}" :db/id #edb/ref 17592186284520} {:answer/id #uuid "73ce4f26-865d-5d0d-ab39-196207ff4f40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{28{x}^{3}}{49{x}^{4}+1}" :db/id #edb/ref 17592186284521} {:answer/id #uuid "08907ada-73a4-564d-bbd9-8b00ffe6cc7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7{x}^{3}}{49{x}^{8}+1}" :db/id #edb/ref 17592186284522} {:answer/id #uuid "fb27d037-5e7e-5162-ba8b-4df673b08145" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28{x}^{3}}{49{x}^{8}+1}" :db/id #edb/ref 17592186284523} {:answer/id #uuid "d895e095-2bc5-5b1a-b4b4-edea5e0cfc34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28{x}^{4}}{7{x}^{8}+1}" :db/id #edb/ref 17592186284524}] :answer-field/correct {:answer/id #uuid "fb27d037-5e7e-5162-ba8b-4df673b08145" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28{x}^{3}}{49{x}^{8}+1}" :db/id #edb/ref 17592186284523} :answer-field/id #uuid "6b2a9d5d-b608-5972-ae6b-3493c85db6f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284519}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d862db76-cb1d-5f25-8e3a-75f25070dcdf" :question/math-academy-id "q-110627" :question/problem "Find ${y}^{′}$ for $y=\\operatorname{arctan}⁡(7{x}^{4}).$" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arctan}⁡(7{x}^{4})] \\\\  & =\\frac{1}{1+{(7{x}^{4})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(7{x}^{4}) \\\\  & =\\frac{1}{1+49{x}^{8}}\\cdot 28{x}^{3} \\\\  & =\\frac{28{x}^{3}}{49{x}^{8}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284525 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3d85ee9-70f3-5ded-9be5-112704718cd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{{x}^{2}+1}-\\frac{3{x}^{2}}{1+{x}^{6}}" :db/id #edb/ref 17592186284527} {:answer/id #uuid "00943ce5-3863-5187-9158-2d9b50815715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{arctan({x}^{3})}{{x}^{2}+1}-\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2}+1)}{1+{x}^{6}}" :db/id #edb/ref 17592186284528} {:answer/id #uuid "7cbaae8a-a739-51ad-a619-8a3dbff351d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2xarctan({x}^{3})}{{x}^{2}+1}+\\frac{3{x}^{2}\\operatorname{ln}⁡({x}^{2}+1)}{1+{x}^{6}}" :db/id #edb/ref 17592186284529} {:answer/id #uuid "de9b7cc8-dd4b-58e8-8010-a23d5a4899e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{{x}^{2}+1}+\\frac{3{x}^{2}}{1+{x}^{6}}" :db/id #edb/ref 17592186284530} {:answer/id #uuid "098bd745-4a5c-55aa-abd0-00d2f764b2fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2xarctan({x}^{3})}{{x}^{6}+1}+\\frac{3{x}^{2}\\operatorname{ln}⁡({x}^{2}+1)}{1+{x}^{2}}" :db/id #edb/ref 17592186284531}] :answer-field/correct {:answer/id #uuid "7cbaae8a-a739-51ad-a619-8a3dbff351d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2xarctan({x}^{3})}{{x}^{2}+1}+\\frac{3{x}^{2}\\operatorname{ln}⁡({x}^{2}+1)}{1+{x}^{6}}" :db/id #edb/ref 17592186284529} :answer-field/id #uuid "b55ddaba-5cbd-513d-955b-9baf4aad608c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284526}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "797e37b9-4e71-5180-99f5-45c6a49d3964" :question/math-academy-id "q-19067" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{ln}⁡({x}^{2}+1)arctan({x}^{3}).$" :question/worked-solution "Applying the product rule, using the formula for the derivative of $arctanx$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =arctan({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡({x}^{2}+1))+\\operatorname{ln}⁡({x}^{2}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(arctan({x}^{3})) \\\\  & =arctan({x}^{3})\\cdot \\frac{1}{{x}^{2}+1}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+1)+\\operatorname{ln}⁡({x}^{2}+1)\\cdot \\frac{1}{1+({x}^{3})^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\  & =arctan({x}^{3})\\cdot \\frac{1}{{x}^{2}+1}\\cdot 2x+\\operatorname{ln}⁡({x}^{2}+1)\\cdot \\frac{1}{1+({x}^{3})^{2}}\\cdot 3{x}^{2} \\\\  & =\\frac{2xarctan({x}^{3})}{{x}^{2}+1}+\\frac{3{x}^{2}\\operatorname{ln}⁡({x}^{2}+1)}{1+{x}^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284532 :knowledge-point/_questions [{:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2" :knowledge-point/title "Differentiating an Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f89def-6506-5b85-ae06-1f1cdd550bed" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186284534} {:answer/id #uuid "b1eae5cf-daef-5d1b-ba81-2f9eb2f5ffb7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186284535} {:answer/id #uuid "e4609aef-4ec7-59a3-b9c9-7e19ce1a62cf" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186284536} {:answer/id #uuid "ca8611eb-980e-52a4-a8ef-5bf123c47ad0" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186284537} {:answer/id #uuid "4caa0385-3df5-57f9-9175-eaa9924112d1" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186284538}] :answer-field/correct {:answer/id #uuid "89f89def-6506-5b85-ae06-1f1cdd550bed" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186284534} :answer-field/id #uuid "08637f5e-026b-5139-9789-b4351aab153c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284533}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ee97d5f5-6a9c-51cc-a159-6877c0bdbc98" :question/math-academy-id "q-31823" :question/problem "Find the slope of the tangent line to the curve $f(x)=6\\operatorname{arctan}⁡(3{x}^{2}-2x)$ at $x=1.$" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[6\\operatorname{arctan}⁡(3{x}^{2}-2x)] \\\\  & =6\\cdot \\frac{1}{1+(3{x}^{2}-2x)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-2x) \\\\  & =\\frac{6}{1+9{x}^{4}-12{x}^{3}+4{x}^{2}}\\cdot (6x-2) \\\\  & =\\frac{36x-12}{9{x}^{4}-12{x}^{3}+4{x}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line to the curve $y=f(x)$ at $x=1$ is\n\n$$\n\\begin{aligned}{f}^{′}(1) & =\\frac{36(1)-12}{9({1}^{4})-12({1}^{3})+4({1}^{2})+1} \\\\  & =\\frac{24}{2} \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284539 :knowledge-point/_questions [{:knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44368fd2-8fb5-51de-afaa-de8a0194a267" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186284541}] :answer-field/correct {:answer/id #uuid "44368fd2-8fb5-51de-afaa-de8a0194a267" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186284541} :answer-field/id #uuid "fab3d06a-c4b1-5aff-9f76-08957e539130" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284540}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "559d229f-97ae-5a41-9c31-16b2f78a406f" :question/math-academy-id "q-343215" :question/problem "Find the exact value of the slope $m$ of the tangent line to the curve $y=2\\operatorname{arccos}⁡(1+x)$ at $x=-1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}[2\\operatorname{arccos}⁡(1+x)] \\\\  & =2(-\\frac{1}{\\sqrt{1-(1+x)^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}(1+x) \\\\  & =-\\frac{2}{\\sqrt{1-(1+2x+{x}^{2})}} \\\\  & =-\\frac{2}{\\sqrt{-2x-{x}^{2}}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=-1$ is\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} \\\\  & =-\\frac{2}{\\sqrt{-2(-1)-(-1)^{2}}} \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284542 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1875ce0-4a63-5c80-9784-129032f7139e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186284544} {:answer/id #uuid "3406b3cc-91de-5879-9c9c-70dada693a3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186284545} {:answer/id #uuid "7cdf1319-c435-537c-85c4-6662dccec599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186284546} {:answer/id #uuid "1e5b35bc-a831-5a01-ab56-4fe27697cc26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(5-x)\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186284547} {:answer/id #uuid "d7816c7e-6a88-59c4-aa5f-79d7bd2c4090" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186284548}] :answer-field/correct {:answer/id #uuid "d7816c7e-6a88-59c4-aa5f-79d7bd2c4090" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186284548} :answer-field/id #uuid "87ba86f9-0cae-5ebc-aee3-764ba90fa8d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284543}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "53683620-aae1-5c2f-ad8b-d772436a9136" :question/math-academy-id "q-73510" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x).$" :question/worked-solution "Applying the product rule, using the formula for the derivative of $\\operatorname{arccos}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x)) & =\\operatorname{arccos}⁡(5-x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)+\\operatorname{cos}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡(5-x)) \\\\  & =\\operatorname{arccos}⁡(5-x)\\cdot (-\\operatorname{sin}⁡x)+\\operatorname{cos}⁡x\\cdot (-\\frac{1}{\\sqrt{1-{(5-x)}^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}(5-x) \\\\  & =-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)-\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}\\cdot (-1) \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x).\\end{aligned}\n$$"}]}
