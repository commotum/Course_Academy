            },
            {
              "type": "text",
              "value": "The critical points lie on the line $v=0$ and on the hyperbola ${v}^{2}-{u}^{2}.$"
            },
            {
              "type": "text",
              "value": "The critical points lie on the line $u=2v.$"
            }
          ],
          "correct_value": "The critical points lie on the line $v=0$ and on the parabola $v=2{u}^{2}.$",
