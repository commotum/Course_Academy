]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284784 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93d5301e-cdac-549c-8b27-594042eb57ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{30}" :db/id #edb/ref 17592186284786}] :answer-field/correct {:answer/id #uuid "93d5301e-cdac-549c-8b27-594042eb57ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{30}" :db/id #edb/ref 17592186284786} :answer-field/id #uuid "b41db4be-d748-5c7d-8931-5326da2c7d9a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284785} {:answer-field/choices [{:answer/id #uuid "ca77f706-eb7e-571a-bc3b-9e44b9fffd37" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186284788}] :answer-field/correct {:answer/id #uuid "ca77f706-eb7e-571a-bc3b-9e44b9fffd37" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186284788} :answer-field/id #uuid "4462897a-eb59-5abc-b1f3-121e26a7dc7f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284787} {:answer-field/choices [{:answer/id #uuid "d9f28575-101d-5daa-b849-50e5193c23df" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186284790}] :answer-field/correct {:answer/id #uuid "d9f28575-101d-5daa-b849-50e5193c23df" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186284790} :answer-field/id #uuid "4b5daf6a-5623-5507-8669-9845e20e3155" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284789}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "44824f47-f8c3-52d7-9631-687da781e31e" :question/math-academy-id "q-321439" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}6x=3+y \\\\ 5y=10\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $1$ |  |\n| --- | --- | --- | --- |\n|  | $0$ | {{field-3}} |  | |  |  |  | |  | $3$ |  |\n| --- | --- | --- |\n|  | $10$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1$ |  |  |  |\n|  | $0$ | {{field-3}} |  |  |  |\n|  | $3$ |  |  |  |  |\n|  | $10$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}6x-y=3 \\\\ 0x+5y=10.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}6 & -1 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3 \\\\ 10\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}6 & -1 \\\\ 0 & 5\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 5-0\\cdot (-1)}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}] \\\\  & =\\frac{1}{30}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{30}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}][\\begin{aligned}3 \\\\ 10\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284791 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac35b3e-b06d-587a-8ace-c7d53cb1dd51" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{7}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284793} {:answer/id #uuid "e398c5b0-36c6-5716-88f0-b1bcf48aaccd" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284794} {:answer/id #uuid "55c74eaf-fda6-5a04-b4cc-0a42988d6d65" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284795} {:answer/id #uuid "9b0c522c-0a45-57e5-b589-0e9d91a1397a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284796} {:answer/id #uuid "d0ca186a-81bb-5170-9593-9ffd9bc5b01a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}1 & 2 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284797}] :answer-field/correct {:answer/id #uuid "55c74eaf-fda6-5a04-b4cc-0a42988d6d65" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186284795} :answer-field/id #uuid "3af2bb39-2081-5140-8544-cbda9ba49d3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284792}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "cf30e2dd-fc54-551b-b230-ad61e11fe0db" :question/math-academy-id "q-72726" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x=-2y-1\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x+2y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284798 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa51bb5e-4196-5989-8dfc-650ca06df2e8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{6}[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284800} {:answer/id #uuid "2fa705e5-7852-552a-ae78-2c1f4f8a6204" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{6}[\\begin{aligned}0 & 3 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284801} {:answer/id #uuid "ac87d1fe-7ca9-5a15-a6ad-3642e24b965d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{6}[\\begin{aligned}1 & -3 \\\\ -2 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284802} {:answer/id #uuid "6bd879c2-22f0-5e8c-83fa-fb7885b08e1a" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284803} {:answer/id #uuid "e2212f62-f3b3-5084-bba1-134329c0e59f" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{6}[\\begin{aligned}-3 & 0 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284804}] :answer-field/correct {:answer/id #uuid "6bd879c2-22f0-5e8c-83fa-fb7885b08e1a" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186284803} :answer-field/id #uuid "519999a9-119f-55c6-8ea3-29d7561eb4f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284799}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1569e65c-796f-55d8-ac40-a3badb7ef3a2" :question/math-academy-id "q-72729" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}x=-3y \\\\ 2x=3\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}x+3y=0 \\\\ 2x=3.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 3\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 0-3\\cdot 2}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}] \\\\  & =-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"}]}
