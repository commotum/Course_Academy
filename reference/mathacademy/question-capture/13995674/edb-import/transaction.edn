\\\ 2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 3-(-1)\\cdot 2}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32136"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320801/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f" :answer/id #uuid "74c1eff3-848b-527e-b2eb-31a78b9cdc6c" :answer/type :answer.type/math :answer/value "-\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "q-320801/field-1" :answer-field/id #uuid "437fab2a-4840-5e57-84f0-a7ce5da5d04a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320801/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f" :answer-field/choices ["q-320801/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f"] :db/ensure [:answer-field/validate]} {:db/id "q-320801/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "05a70804-9022-598b-940a-594d43a6f796" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-320801/field-2" :answer-field/id #uuid "746c917a-1444-5ca7-83d2-e1c1beb5c450" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320801/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-320801/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-320801/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "1c8de09a-d10c-5c10-a00a-5f3e4740ddf8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-320801/field-3" :answer-field/id #uuid "7306ddb2-2b1a-5665-ac49-31d6f328b85a" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320801/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-320801/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-320801" :question/id #uuid "59bf55cf-b55e-56b7-b930-5cbe178314db" :question/math-academy-id "q-320801" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}5y=6 \\\\ 2x-y=-7\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-5$ |  |\n| --- | --- | --- | --- |\n|  | $-2$ | {{field-3}} |  | |  |  |  | |  | $6$ |  |\n| --- | --- | --- |\n|  | $-7$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-5$ |  |  |  |\n|  | $-2$ | {{field-3}} |  |  |  |\n|  | $6$ |  |  |  |  |\n|  | $-7$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}0 & 5 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6 \\\\ -7\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 5 \\\\ 2 & -1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{0\\cdot (-1)-2\\cdot 5}[\\begin{aligned}-1 & -5 \\\\ -2 & 0\\end{aligned}] \\\\  & =-\\frac{1}{10}[\\begin{aligned}-1 & -5 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{10}[\\begin{aligned}-1 & -5 \\\\ -2 & 0\\end{aligned}][\\begin{aligned}6 \\\\ -7\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320801/field-1" "q-320801/field-2" "q-320801/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-320801"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102809/selection/514c2c9ede0b70b6269355282e1a925c5b6eac78648c23e8d4ac284824f0a908" :answer/id #uuid "01755979-0354-5a8c-8358-06db0e668a7d" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{14}[\\begin{aligned}-4 & -3 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102809/selection/5ab062a31d30408085f8fb05ec6973a0a7689fe37f0274b83a7481025647f9dc" :answer/id #uuid "f3a1d318-b9c1-5dee-a68e-573efd3017fc" :answer/type :answer.type/math :answer/value "x=\\frac{1}{14}[\\begin{aligned}-4 & -3 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102809/selection/e2cc1333f0df0d9db23d9b25468cacaab25903836d3669d9a4dc1d72da7a34c7" :answer/id #uuid "58ddedb4-aea2-53f6-b4c4-c995257df447" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{14}[\\begin{aligned}-4 & 3 \\\\ -2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102809/selection/0a993b8f78010c5adac8ddd0813e5668ac4ed145575bc3cda1c1f966536ef9c8" :answer/id #uuid "efc9c5fb-366e-58cc-800c-cc96a8f541ac" :answer/type :answer.type/math :answer/value "x=\\frac{1}{20}[\\begin{aligned}5 & -3 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102809/selection/e00de4250dba5415abe4daab58f5b399f6b691d5f762d26094c770338af63d80" :answer/id #uuid "a4ecfbe4-3a59-5c01-b930-32e7ac659265" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{20}[\\begin{aligned}5 & -3 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102809/selection" :answer-field/id #uuid "24ac07c7-8f78-5bfe-8981-b98603a3d774" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102809/selection/514c2c9ede0b70b6269355282e1a925c5b6eac78648c23e8d4ac284824f0a908" :answer-field/choices ["q-102809/selection/514c2c9ede0b70b6269355282e1a925c5b6eac78648c23e8d4ac284824f0a908" "q-102809/selection/5ab062a31d30408085f8fb05ec6973a0a7689fe37f0274b83a7481025647f9dc" "q-102809/selection/e2cc1333f0df0d9db23d9b25468cacaab25903836d3669d9a4dc1d72da7a34c7" "q-102809/selection/0a993b8f78010c5adac8ddd0813e5668ac4ed145575bc3cda1c1f966536ef9c8" "q-102809/selection/e00de4250dba5415abe4daab58f5b399f6b691d5f762d26094c770338af63d80"] :db/ensure [:answer-field/validate]} {:db/id "q-102809" :question/id #uuid "174955d4-f9c8-5173-abe1-fa5e22029d62" :question/math-academy-id "q-102809" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}5x=1-3y \\\\ 3-4y=2x\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}5x+3y=1 \\\\ -2x-4y=-3.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}5 & 3 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -3\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}5 & 3 \\\\ -2 & -4\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot (-4)-(-2)\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ 2 & 5\\end{aligned}] \\\\  & =-\\frac{1}{14}[\\begin{aligned}-4 & -3 \\\\ 2 & 5\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}[\\begin{aligned}-4 & -3 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}1 \\\\ -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-102809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-102809"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72726/selection/e113bbef819e23e57a19f624dcc7da8e7783412509c066865d60451117bdcdf3" :answer/id #uuid "55c74eaf-fda6-5a04-b4cc-0a42988d6d65" :answer/type :answer.type/math :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72726/selection/4a73d6770a178f6e0c3156e71a8eb9c548d0591193025ab107d93b055c77d514" :answer/id #uuid "2ac35b3e-b06d-587a-8ace-c7d53cb1dd51" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{7}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72726/selection/fe3cafe822faa81f8a2d383793a5b7631a8ea8004052ef02de68ab0e0f3adf6f" :answer/id #uuid "d0ca186a-81bb-5170-9593-9ffd9bc5b01a" :answer/type :answer.type/math :answer/value "x=\\frac{1}{7}[\\begin{aligned}1 & 2 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72726/selection/af5d15d663c2249dcc1203bc42d455eaf949ba6b160c5c481f049b73e92e0777" :answer/id #uuid "e398c5b0-36c6-5716-88f0-b1bcf48aaccd" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72726/selection/f05158a731d05a0554374cbc10ec9db38b06c18421fb8375f53d08e1f0655076" :answer/id #uuid "9b0c522c-0a45-57e5-b589-0e9d91a1397a" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72726/selection" :answer-field/id #uuid "3af2bb39-2081-5140-8544-cbda9ba49d3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72726/selection/e113bbef819e23e57a19f624dcc7da8e7783412509c066865d60451117bdcdf3" :answer-field/choices ["q-72726/selection/e113bbef819e23e57a19f624dcc7da8e7783412509c066865d60451117bdcdf3" "q-72726/selection/4a73d6770a178f6e0c3156e71a8eb9c548d0591193025ab107d93b055c77d514" "q-72726/selection/fe3cafe822faa81f8a2d383793a5b7631a8ea8004052ef02de68ab0e0f3adf6f" "q-72726/selection/af5d15d663c2249dcc1203bc42d455eaf949ba6b160c5c481f049b73e92e0777" "q-72726/selection/f05158a731d05a0554374cbc10ec9db38b06c18421fb8375f53d08e1f0655076"] :db/ensure [:answer-field/validate]} {:db/id "q-72726" :question/id #uuid "cf30e2dd-fc54-551b-b230-ad61e11fe0db" :question/math-academy-id "q-72726" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x=-2y-1\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x+2y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-72726"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321439/field-1/10f20c3e057a7518239c240fe165961c3f23d318d2b73d9830ae84a9d5a6bb67" :answer/id #uuid "93d5301e-cdac-549c-8b27-594042eb57ed" :answer/type :answer.type/math :answer/value "\\frac{1}{30}" :db/ensure [:answer/validate]} {:db/id "q-321439/field-1" :answer-field/id #uuid "b41db4be-d748-5c7d-8931-5326da2c7d9a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321439/field-1/10f20c3e057a7518239c240fe165961c3f23d318d2b73d9830ae84a9d5a6bb67" :answer-field/choices ["q-321439/field-1/10f20c3e057a7518239c240fe165961c3f23d318d2b73d9830ae84a9d5a6bb67"] :db/ensure [:answer-field/validate]} {:db/id "q-321439/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "ca77f706-eb7e-571a-bc3b-9e44b9fffd37" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-321439/field-2" :answer-field/id #uuid "4462897a-eb59-5abc-b1f3-121e26a7dc7f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321439/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-321439/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-321439/field-3/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d9f28575-101d-5daa-b849-50e5193c23df" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-321439/field-3" :answer-field/id #uuid "4b5daf6a-5623-5507-8669-9845e20e3155" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321439/field-3/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-321439/field-3/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-321439" :question/id #uuid "44824f47-f8c3-52d7-9631-687da781e31e" :question/math-academy-id "q-321439" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}6x=3+y \\\\ 5y=10\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $1$ |  |\n| --- | --- | --- | --- |\n|  | $0$ | {{field-3}} |  | |  |  |  | |  | $3$ |  |\n| --- | --- | --- |\n|  | $10$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1$ |  |  |  |\n|  | $0$ | {{field-3}} |  |  |  |\n|  | $3$ |  |  |  |  |\n|  | $10$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}6x-y=3 \\\\ 0x+5y=10.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}6 & -1 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3 \\\\ 10\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}6 & -1 \\\\ 0 & 5\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 5-0\\cdot (-1)}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}] \\\\  & =\\frac{1}{30}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{30}[\\begin{aligned}5 & 1 \\\\ 0 & 6\\end{aligned}][\\begin{aligned}3 \\\\ 10\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321439/field-1" "q-321439/field-2" "q-321439/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-321439"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320810/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" :answer/id #uuid "8508e9dc-17f3-588c-a4d4-105e6e0627d8" :answer/type :answer.type/math :answer/value "\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "q-320810/field-1/fe408bb8584d9549e0a0c9ef3adf534b4545b6ad8bd71384d7efac8421910872" :answer/id #uuid "8ae6135f-e663-518e-9b85-293885d850e1" :answer/type :answer.type/math :answer/value "-\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "q-320810/field-1" :answer-field/id #uuid "ef8f884f-c987-58b7-9854-595ecd2e6d6f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320810/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" :answer-field/choices ["q-320810/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" "q-320810/field-1/fe408bb8584d9549e0a0c9ef3adf534b4545b6ad8bd71384d7efac8421910872"] :db/ensure [:answer-field/validate]} {:db/id "q-320810/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fc6811aa-b7e7-535a-a059-2ea74ea9916c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-320810/field-2" :answer-field/id #uuid "ce324489-3ef3-5fe5-aaa3-efcdc667656f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320810/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-320810/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-320810/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "9c3e9465-747b-5059-b706-27e70d9acba0" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-320810/field-3" :answer-field/id #uuid "07b2f3be-a17f-553b-b079-5ced5b25ff5a" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320810/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-320810/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-320810" :question/id #uuid "997c1f77-09fa-588b-926d-5dbc3c75e96d" :question/math-academy-id "q-320810" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}4x=y+5 \\\\ x-2=-3y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $1$ |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $4$ |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $2$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $1$ |  |  |  |\n|  | {{field-3}} | $4$ |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $2$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}4x-y=5 \\\\ x+3y=2.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}4 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ 2\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}4 & -1 \\\\ 1 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 3-1\\cdot (-1)}[\\begin{aligned}3 & 1 \\\\ -1 & 4\\end{aligned}] \\\\  & =\\frac{1}{13}[\\begin{aligned}3 & 1 \\\\ -1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{13}[\\begin{aligned}3 & 1 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}5 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-320810/field-1" "q-320810/field-2" "q-320810/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-320810"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72729/selection/535ebc225e5d0e18208e6bd6359abcde099b51454fac9ff49904a0223c139dfa" :answer/id #uuid "e2212f62-f3b3-5084-bba1-134329c0e59f" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{6}[\\begin{aligned}-3 & 0 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72729/selection/1dedfaad82744b1a94ab4ea77321f27675afb6e81fdb5004060dd5d11b583ad8" :answer/id #uuid "aa51bb5e-4196-5989-8dfc-650ca06df2e8" :answer/type :answer.type/math :answer/value "x=\\frac{1}{6}[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72729/selection/51208afb944dd0345ef470c10c3a47fe7e52fca9999bccd278f6ff6d77a55f1a" :answer/id #uuid "6bd879c2-22f0-5e8c-83fa-fb7885b08e1a" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72729/selection/3e3db2c4e0862c065ef7b2864069f3ce6f9a081df480f4a72ae6a858e4ec66f8" :answer/id #uuid "ac87d1fe-7ca9-5a15-a6ad-3642e24b965d" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{6}[\\begin{aligned}1 & -3 \\\\ -2 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72729/selection/3c73b3c4e2493e6d03eb0846172810fab1b7f159fcbd78b485d85360ff38fc64" :answer/id #uuid "2fa705e5-7852-552a-ae78-2c1f4f8a6204" :answer/type :answer.type/math :answer/value "x=\\frac{1}{6}[\\begin{aligned}0 & 3 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72729/selection" :answer-field/id #uuid "519999a9-119f-55c6-8ea3-29d7561eb4f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72729/selection/51208afb944dd0345ef470c10c3a47fe7e52fca9999bccd278f6ff6d77a55f1a" :answer-field/choices ["q-72729/selection/535ebc225e5d0e18208e6bd6359abcde099b51454fac9ff49904a0223c139dfa" "q-72729/selection/1dedfaad82744b1a94ab4ea77321f27675afb6e81fdb5004060dd5d11b583ad8" "q-72729/selection/51208afb944dd0345ef470c10c3a47fe7e52fca9999bccd278f6ff6d77a55f1a" "q-72729/selection/3e3db2c4e0862c065ef7b2864069f3ce6f9a081df480f4a72ae6a858e4ec66f8" "q-72729/selection/3c73b3c4e2493e6d03eb0846172810fab1b7f159fcbd78b485d85360ff38fc64"] :db/ensure [:answer-field/validate]} {:db/id "q-72729" :question/id #uuid "1569e65c-796f-55d8-ac40-a3badb7ef3a2" :question/math-academy-id "q-72729" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}x=-3y \\\\ 2x=3\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}x+3y=0 \\\\ 2x=3.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 3\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 0-3\\cdot 2}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}] \\\\  & =-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{6}[\\begin{aligned}0 & -3 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72729/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-72729"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4508"] :question/problem "Find a solution to the system of linear equations\n\n$$\n{\\begin{aligned}2x+y=2 \\\\ 4x+3y=6.\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $[\\begin{aligned}2 & 1 \\\\ 4 & 3\\end{aligned}]$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-4\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & -1 \\\\ -4 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nSo the solution is $x=0$ and $y=2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4509"] :question/problem "Solve the system of linear equations\n\n$$\n{\\begin{aligned}2x-3y=5 \\\\ 6y-5x=-8.\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}2x-3y=5 \\\\ -5x+6y=-8.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $A\\mathbf{x} =\\mathbf{b}\\mathbin{:}$\n\n$$\n[\\begin{aligned}2 & -3 \\\\ -5 & 6\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $[\\begin{aligned}2 & -3 \\\\ -5 & 6\\end{aligned}]$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-3\\cdot 5}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}] \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}5 \\\\ -8\\end{aligned}] \\\\  & =-\\frac{1}{3}[\\begin{aligned}6 \\\\ 9\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution is $x=-2$ and $y=-3.$" :db/ensure [:question/validate]}]
