4/selection/002a9e9c933cd5c1729a367641d7362ba20ea0123a8775aa97c828e08118f38e"] :db/ensure [:answer-field/validate]} {:db/id "q-12284" :question/id #uuid "33942b97-95c2-5a05-bee1-52e88505e10f" :question/math-academy-id "q-12284" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}5x-2y=3 \\\\ 2x-y=5\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}5 & -2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3 \\\\ 5\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}5 & -2 \\\\ 2 & -1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot (-1)-(-2)\\cdot 2}[\\begin{aligned}-1 & 2 \\\\ -2 & 5\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}-1 & 2 \\\\ -2 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 2 & -5\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & -2 \\\\ 2 & -5\\end{aligned}][\\begin{aligned}3 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12284/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-12284"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320804/field-1/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" :answer/id #uuid "9252e4f2-9674-582e-b891-6549efc0049c" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-320804/field-1" :answer-field/id #uuid "8778ba95-a77b-55e4-8a77-665b813168e6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320804/field-1/aa640bdf1bd5b2b15c3dbfe7