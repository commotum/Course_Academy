#{[{:db/id #edb/ref 17592186299306 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47e48db4-0320-539f-ac59-78e8a81457e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186299308} {:answer/id #uuid "54080fff-575e-5dff-a3bd-36de013061d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186299309} {:answer/id #uuid "b4255cd1-39f2-5bbf-9ea8-d022ad6b7101" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186299310} {:answer/id #uuid "320f6a1a-95e5-5650-885b-0a784da3b6ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186299311} {:answer/id #uuid "b3a74eae-48b1-5aae-b3de-7e8d20166984" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186299312}] :answer-field/correct {:answer/id #uuid "54080fff-575e-5dff-a3bd-36de013061d9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186299309} :answer-field/id #uuid "0c939838-e5dc-5068-b464-7934c877d842" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299307}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "98d0a68d-e0f6-5544-8c20-619f549f35d8" :question/math-academy-id "q-106697" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{7}-3{x}^{2}+4x}{{x}^{4}-3{x}^{3}+5}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{4}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{7}-3{x}^{2}+4x}{{x}^{4}-3{x}^{3}+5} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{{x}^{7}}{{x}^{4}}-\\frac{3{x}^{2}}{{x}^{4}}+\\frac{4x}{{x}^{4}})}{(\\frac{{x}^{4}}{{x}^{4}}-\\frac{3{x}^{3}}{{x}^{4}}+\\frac{5}{{x}^{4}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{({x}^{3}-\\frac{3}{{x}^{2}}+\\frac{4}{{x}^{3}})}{(1-\\frac{3}{x}+\\frac{5}{{x}^{4}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{({x}^{3}-0+0)}{(1-0+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299313 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "715476ba-2f90-5a7e-abb2-79247750fe75" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{3}{4}" :db/id #edb/ref 17592186299315} {:answer/id #uuid "6d718848-5388-57b0-982e-937ee7257b7b" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186299316} {:answer/id #uuid "01a1d2c9-b406-5812-810d-fca16afd3852" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186299317} {:answer/id #uuid "9094fa74-95ff-5779-9510-3afe955e7f58" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186299318} {:answer/id #uuid "8030b6ee-e877-52a3-b7f7-6acb625d3e82" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}" :db/id #edb/ref 17592186299319}] :answer-field/correct {:answer/id #uuid "715476ba-2f90-5a7e-abb2-79247750fe75" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{3}{4}" :db/id #edb/ref 17592186299315} :answer-field/id #uuid "efca0541-75de-501d-87ee-9accba130975" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299314}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7073f662-6d8f-515a-9efc-05f4295bef4c" :question/math-academy-id "q-35830" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{9{x}^{5}+3{x}^{2}+11}{12{x}^{5}}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9{x}^{5}+3{x}^{2}+11}{12{x}^{5}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9{x}^{5}}{{x}^{5}}+\\frac{3{x}^{2}}{{x}^{5}}+\\frac{11}{{x}^{5}})}{(\\frac{12{x}^{5}}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9+\\frac{3}{{x}^{3}}+\\frac{11}{{x}^{5}})}{(12)} \\\\  & =\\frac{9+0+0}{12} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\n \nTherefore, the horizontal asymptote of $f(x)$ is $y=\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186299320 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5252572c-2957-5e82-83cc-4b3d8d2783a4" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186299322} {:answer/id #uuid "66624a55-2c17-5137-80e6-da5bad973885" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186299323} {:answer/id #uuid "ec3de658-e3c8-5f19-bc91-6c9a8a4f58c3" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186299324} {:answer/id #uuid "fbcb9f55-b69a-532f-b9d7-a1036152dfe5" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186299325} {:answer/id #uuid "e0b8aa37-0a5d-57db-b6f5-a559978418fa" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186299326}] :answer-field/correct {:answer/id #uuid "fbcb9f55-b69a-532f-b9d7-a1036152dfe5" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186299325} :answer-field/id #uuid "02e99d2d-cb9d-5b7c-955a-b720ed5107f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299321}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dad5c74a-0050-5983-a7cc-29f3f30ed02f" :question/math-academy-id "q-35833" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{4{x}^{2}-9x+1}{x+4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{2}-9x+1}{x+4} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{2}}{x}-\\frac{9x}{x}+\\frac{1}{x})}{(\\frac{x}{x}+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+\\frac{1}{x})}{(1+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+0)}{(1+0)} \\\\  & ={lim}_{x\\to \\infty }(4x)-9 \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186299327 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577631be-9bc9-5c48-a744-9596a9a68f21" :answer/type {:db/ident :answer.type/math} :answer/value "1/4" :db/id #edb/ref 17592186299329} {:answer/id #uuid "73c32971-8e3a-528a-b8a4-d473f0bb5a5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186299330} {:answer/id #uuid "25a46913-ad20-5514-a0ba-bb33b0535080" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186299331} {:answer/id #uuid "29241699-b88c-58cf-a92e-ed8003c661f7" :answer/type {:db/ident :answer.type/text} :answer/value "Does not exist." :db/id #edb/ref 17592186299332} {:answer/id #uuid "61591f85-79f0-5ffe-acb3-a95e2357c468" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186299333}] :answer-field/correct {:answer/id #uuid "73c32971-8e3a-528a-b8a4-d473f0bb5a5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186299330} :answer-field/id #uuid "78df1bcd-0def-5c97-9099-6d7e2f08aac1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299328}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "34021da9-66a6-59ae-b29e-95714c2bc04c" :question/math-academy-id "q-68048" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{4{x}^{5}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}+\\frac{8x}{{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(4{x}^{2}-\\frac{9}{{x}^{3}})}{(1+\\frac{8}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{2}-0}{1+0} \\\\  & ={lim}_{x\\to -\\infty }4{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299334 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43c2b738-0d46-5a16-9633-7351c3182780" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186299336} {:answer/id #uuid "0b6de238-3ec5-5271-b544-cee5867233d8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{12}" :db/id #edb/ref 17592186299337} {:answer/id #uuid "3a563fbb-45e1-5d24-9c16-f2dad7cbf3c5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186299338} {:answer/id #uuid "1ddcedd0-bd4d-5d88-82ad-ce6477b3fc9f" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186299339} {:answer/id #uuid "f1a08e7d-c738-510c-ac41-12ec7df2be16" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186299340}] :answer-field/correct {:answer/id #uuid "1ddcedd0-bd4d-5d88-82ad-ce6477b3fc9f" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186299339} :answer-field/id #uuid "d20560ef-25c4-5201-8344-86f8308f287d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299335}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "01cafde1-0814-5131-aaba-8a99821bec89" :question/math-academy-id "q-68075" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{5+7{x}^{3}}{12x}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{5+7{x}^{3}}{12x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{5}{x}+\\frac{7{x}^{3}}{x})}{(\\frac{12x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{5}{x}+7{x}^{2})}{12} \\\\  & ={lim}_{x\\to \\infty }\\frac{(0+7{x}^{2})}{12} \\\\  & =\\frac{7}{12}{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}]}
