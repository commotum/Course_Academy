07 1000 #edb/ref 17592186299310 13194139534621 true] [17592186299307 1000 #edb/ref 17592186299311 13194139534621 true] [17592186299307 1000 #edb/ref 17592186299312 13194139534621 true] [17592186299307 1040 #edb/ref 17592186045450 13194139534621 true] [17592186299307 1041 "selection" 13194139534621 true] [17592186299307 1104 #edb/ref 17592186299309 13194139534621 true] [17592186299307 1110 #uuid "0c939838-e5dc-5068-b464-7934c877d842" 13194139534621 true] [17592186299308 1034 "\\infty " 13194139534621 true] [17592186299308 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299308 1111 #uuid "47e48db4-0320-539f-ac59-78e8a81457e9" 13194139534621 true] [17592186299309 1034 "-\\infty " 13194139534621 true] [17592186299309 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299309 1111 #uuid "54080fff-575e-5dff-a3bd-36de013061d9" 13194139534621 true] [17592186299310 1034 "1" 13194139534621 true] [17592186299310 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299310 1111 #uuid "b4255cd1-39f2-5bbf-9ea8-d022ad6b7101" 13194139534621 true] [17592186299311 1034 "\\text{DNE}" 13194139534621 true] [17592186299311 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299311 1111 #uuid "320f6a1a-95e5-5650-885b-0a784da3b6ec" 13194139534621 true] [17592186299312 1034 "-2" 13194139534621 true] [17592186299312 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299312 1111 #uuid "b3a74eae-48b1-5aae-b3de-7e8d20166984" 13194139534621 true] [17592186299313 1017 #edb/ref 17592186299314 13194139534621 true] [17592186299313 1089 "q-35830" 13194139534621 true] [17592186299313 1091 #edb/ref 17592186045463 13194139534621 true] [17592186299313 1100 "Find the horizontal asymptote of the function $f(x)=\\frac{9{x}^{5}+3{x}^{2}+11}{12{x}^{5}}.$" 13194139534621 true] [17592186299313 1113 #uuid "7073f662-6d8f-515a-9efc-05f4295bef4c" 13194139534621 true] [17592186299313 1145 "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{9{x}^{5}+3{x}^{2}+11}{12{x}^{5}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{9{x}^{5}}{{x}^{5}}+\\frac{3{x}^{2}}{{x}^{5}}+\\frac{11}{{x}^{5}})}{(\\frac{12{x}^{5}}{{x}^{5}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(9+\\frac{3}{{x}^{3}}+\\frac{11}{{x}^{5}})}{(12)} \\\\  & =\\frac{9+0+0}{12} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\n \nTherefore, the horizontal asymptote of $f(x)$ is $y=\\frac{3}{4}.$" 13194139534621 true] [17592186299314 1000 #edb/ref 17592186299315 13194139534621 true] [17592186299314 1000 #edb/ref 17592186299316 13194139534621 true] [17592186299314 1000 #edb/ref 17592186299317 13194139534621 true] [17592186299314 1000 #edb/ref 17592186299318 13194139534621 true] [17592186299314 1000 #edb/ref 17592186299319 13194139534621 true] [17592186299314 1040 #edb/ref 17592186045450 13194139534621 true] [17592186299314 1041 "selection" 13194139534621 true] [17592186299314 1104 #edb/ref 17592186299315 13194139534621 true] [17592186299314 1110 #uuid "efca0541-75de-501d-87ee-9accba130975" 13194139534621 true] [17592186299315 1034 "y=\\frac{3}{4}" 13194139534621 true] [17592186299315 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299315 1111 #uuid "715476ba-2f90-5a7e-abb2-79247750fe75" 13194139534621 true] [17592186299316 1034 "y=0" 13194139534621 true] [17592186299316 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299316 1111 #uuid "6d718848-5388-57b0-982e-937ee7257b7b" 13194139534621 true] [17592186299317 1034 "No horizontal asymptote" 13194139534621 true] [17592186299317 1103 #edb/ref 17592186045454 13194139534621 true] [17592186299317 1111 #uuid "01a1d2c9-b406-5812-810d-fca16afd3852" 13194139534621 true] [17592186299318 1034 "y=\\frac{1}{2}" 13194139534621 true] [17592186299318 1103 #edb/ref 17592186045453 1319413