5 13194139534621 true] [17592186299321 1110 #uuid "02e99d2d-cb9d-5b7c-955a-b720ed5107f4" 13194139534621 true] [17592186299322 1034 "y=-9" 13194139534621 true] [17592186299322 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299322 1111 #uuid "5252572c-2957-5e82-83cc-4b3d8d2783a4" 13194139534621 true] [17592186299323 1034 "y=4" 13194139534621 true] [17592186299323 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299323 1111 #uuid "66624a55-2c17-5137-80e6-da5bad973885" 13194139534621 true] [17592186299324 1034 "y=0" 13194139534621 true] [17592186299324 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299324 1111 #uuid "ec3de658-e3c8-5f19-bc91-6c9a8a4f58c3" 13194139534621 true] [17592186299325 1034 "No horizontal asymptote" 13194139534621 true] [17592186299325 1103 #edb/ref 17592186045454 13194139534621 true] [17592186299325 1111 #uuid "fbcb9f55-b69a-532f-b9d7-a1036152dfe5" 13194139534621 true] [17592186299326 1034 "y=1" 13194139534621 true] [17592186299326 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299326 1111 #uuid "e0b8aa37-0a5d-57db-b6f5-a559978418fa" 13194139534621 true] [17592186299327 1017 #edb/ref 17592186299328 13194139534621 true] [17592186299327 1089 "q-68048" 13194139534621 true] [17592186299327 1091 #edb/ref 17592186045463 13194139534621 true] [17592186299327 1100 "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x}.$" 13194139534621 true] [17592186299327 1113 #uuid "34021da9-66a6-59ae-b29e-95714c2bc04c" 13194139534621 true] [17592186299327 1145 "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{5}-9}{{x}^{3}+8x} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{4{x}^{5}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}+\\frac{8x}{{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(4{x}^{2}-\\frac{9}{{x}^{3}})}{(1+\\frac{8}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{4{x}^{2}-0}{1+0} \\\\  & ={lim}_{x\\to -\\infty }4{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$" 13194139534621 true] [17592186299328 1000 #edb/ref 17592186299329 13194139534621 true] [17592186299328 1000 #edb/ref 17592186299330 13194139534621 true] [17592186299328 1000 #edb/ref 17592186299331 13194139534621 true] [17592186299328 1000 #edb/ref 17592186299332 13194139534621 true] [17592186299328 1000 #edb/ref 17592186299333 13194139534621 true] [17592186299328 1040 #edb/ref 17592186045450 13194139534621 true] [17592186299328 1041 "selection" 13194139534621 true] [17592186299328 1104 #edb/ref 17592186299330 13194139534621 true] [17592186299328 1110 #uuid "78df1bcd-0def-5c97-9099-6d7e2f08aac1" 13194139534621 true] [17592186299329 1034 "1/4" 13194139534621 true] [17592186299329 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299329 1111 #uuid "577631be-9bc9-5c48-a744-9596a9a68f21" 13194139534621 true] [17592186299330 1034 "\\infty " 13194139534621 true] [17592186299330 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299330 1111 #uuid "73c32971-8e3a-528a-b8a4-d473f0bb5a5c" 13194139534621 true] [17592186299331 1034 "-\\infty " 13194139534621 true] [17592186299331 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299331 1111 #uuid "25a46913-ad20-5514-a0ba-bb33b0535080" 13194139534621 true] [17592186299332 1034 "Does not exist." 13194139534621 true] [17592186299332 1103 #edb/ref 17592186045454 13194139534621 true] [17592186299332 1111 #uuid "29241699-b88c-58cf-a92e-ed8003c661f7" 13194139534621 true] [17592186299333 1034 "0" 13194139534621 true] [17592186299333 1103 #edb/ref 17592186045453 13194139534621 true] [17592186299333 1111 #uuid "61591f85-79f0-5ffe-acb3-a95e2357c468" 13194139534621 true] [17592186299334 1017 #edb/ref 17592186299335 13194139534621 true] [17592186299334 1089 "q-68075" 131941395346