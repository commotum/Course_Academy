[{:db/id "q-15519/selection/3ab5a696a98e2a668cb9bc3791709cf3ec11c9fcecb450bd182e42a44de9c864" :answer/id #uuid "0517db9f-bbdc-5dcf-b086-db21f6afaebd" :answer/type :answer.type/math :answer/value "1-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15519/selection/90898bcb61b1f6a055b75b706beab1839e21dab0f3a4ce417a3bd2937264a817" :answer/id #uuid "48cb5ae2-0240-50fc-b00a-4e128e10719c" :answer/type :answer.type/math :answer/value "1-(x-2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15519/selection/eb7dda0a577b2af8452ea1704d6555744b1573386ef25a3a1f1608176658a18d" :answer/id #uuid "deaaf7b2-ca28-50e3-b9be-275aa28e9d51" :answer/type :answer.type/math :answer/value "1+(x-2)-{(x-2)}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15519/selection/187f8d0529feba294e747f2fb48da65b755b3bfe7fd1b7bb1de22a57323f41c8" :answer/id #uuid "25260566-424c-56b3-99bd-90a44452693e" :answer/type :answer.type/math :answer/value "1+(x-2)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15519/selection/db1ca590371165acf0a8aa7d95bd3bcbf70245c0e1122f82b9dc26bc9c35968e" :answer/id #uuid "d718e0a5-a0c5-5bcf-aa94-a92aa16e8a6a" :answer/type :answer.type/math :answer/value "2+(x-2)-{(x-2)}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15519/selection" :answer-field/id #uuid "821ac992-a5a1-5ec2-a880-570fb0418e8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15519/selection/187f8d0529feba294e747f2fb48da65b755b3bfe7fd1b7bb1de22a57323f41c8" :answer-field/choices ["q-15519/selection/3ab5a696a98e2a668cb9bc3791709cf3ec11c9fcecb450bd182e42a44de9c864" "q-15519/selection/90898bcb61b1f6a055b75b706beab1839e21dab0f3a4ce417a3bd2937264a817" "q-15519/selection/eb7dda0a577b2af8452ea1704d6555744b1573386ef25a3a1f1608176658a18d" "q-15519/selection/187f8d0529feba294e747f2fb48da65b755b3bfe7fd1b7bb1de22a57323f41c8" "q-15519/selection/db1ca590371165acf0a8aa7d95bd3bcbf70245c0e1122f82b9dc26bc9c35968e"] :db/ensure [:answer-field/validate]} {:db/id "q-15519" :question/id #uuid "d2528da7-7989-5718-98f8-9e34c6fc3006" :question/math-academy-id "q-15519" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053574/assets/b70f90738fc329a0d58527dc013a3e175b0954e0ccc27972d5abcde1708e1bca.png)\n\nThe figure above shows the graph of a function $y=f(x).$ Which of the following could be the second-degree Taylor polynomial for $f$ about $x=2?$" :question/worked-solution "The second-degree Taylor polynomial for $f(x)$ about $x=2$ is \n\n$$\n{P}_{2}(x)=f(2)+{f}^{′}(2)(x-2)+\\frac{{f}^{″}(2)}{2}(x-2)^{2}.\n$$\n\nFrom the graph, we observe:\n\n- $f(2)>0.$ Therefore, the first term of the Taylor polynomial must be positive.\n\n- ${f}^{′}(2)=0,$ because the slope of the tangent at $x=2$ is zero. Therefore, the coefficient of the second term in the Taylor polynomial must be zero.\n\n- ${f}^{″}(2)>0,$ because the graph is concave up at $x=2.$ Therefore, the coefficient of the third term in the Taylor polynomial must be positive.\n\nThe only option that meets the above criteria is\n\n$$\n{P}_{2}(x)=1+(x-2)^{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15519/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fce4cd5a-537a-5eb4-a610-59d2bad95a89"] :knowledge-point/questions ["q-15519"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-50974"] :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=-2$ is given by ${P}_{2}(x)=2+4(x+2)+16(x+2)^{2}.$ What is the value of ${f}^{″}(-2)?$" :question/worked-solution "This is an expansion about the point $x=-2,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(-2).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $16.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(-2)=16\\,⟹\\,{f}^{″}(-2)=32.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-81062/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "b12e1f62-4c7b-5147-b017-f88da94fb738" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-81062/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "675ef4a9-b374-5104-ade8-4fc9ebda7aa4" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-81062/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "18dfa965-fe8a-5b38-9d99-98a1c590e4d8" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-81062/selection/8bf9008bc778888b2d3f4240302b812727e0200209b4202da0461e41435934e6" :answer/id #uuid "f18a85a0-6d21-518c-bbb6-6d0e3ede348d" :answer/type :answer.type/math :answer/value "-72" :db/ensure [:answer/validate]} {:db/id "q-81062/selection/5cd5dc93f37c743976373ab57c37b5388ba149bd286c5b2139ed2c89c249424d" :answer/id #uuid "65efb53e-5e59-573e-bbc8-66fc305cd7af" :answer/type :answer.type/math :answer/value "-36" :db/ensure [:answer/validate]} {:db/id "q-81062/selection" :answer-field/id #uuid "9df7f574-f220-5cdd-b5b3-e23a8a279b59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81062/selection/5cd5dc93f37c743976373ab57c37b5388ba149bd286c5b2139ed2c89c249424d" :answer-field/choices ["q-81062/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" "q-81062/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-81062/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" "q-81062/selection/8bf9008bc778888b2d3f4240302b812727e0200209b4202da0461e41435934e6" "q-81062/selection/5cd5dc93f37c743976373ab57c37b5388ba149bd286c5b2139ed2c89c249424d"] :db/ensure [:answer-field/validate]} {:db/id "q-81062" :question/id #uuid "2c7eb72b-51e7-5594-a379-c3d96c8cc9aa" :question/math-academy-id "q-81062" :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=-3$ is given by ${P}_{2}(x)=-24+36(x+3)-18(x+3)^{2}.$ What is the value of ${f}^{″}(-3)?$" :question/worked-solution "This is an expansion about the point $x=-3,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(-3).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $-18.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(-3)=-18\\,⟹\\,{f}^{″}(-3)=-36.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81062/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "73571ff9-24a3-52b6-be57-3ef08652ebb7"] :knowledge-point/questions ["q-81062"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81064/selection/2b7391e01b73804fedff2a3f64cad1acfcdbe52db4bfa1b91ed29f28f1e5cff4" :answer/id #uuid "981ceae7-b446-5115-a342-9b34a14c0de4" :answer/type :answer.type/math :answer/value "6-4(x+1)+5(x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "q-81064/selection/81555c2d9b1c64f7fcd900009b24f37dbe47609ea7507413b1de78ab0f70e511" :answer/id #uuid "f9efc2c6-79cf-5f75-80fb-babccb0e4a6c" :answer/type :answer.type/math :answer/value "-6-4(x+1)-5(x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "q-81064/selection/2dd40d85a0d7eea398afd71898e0c97095612df4416481716f4a103572cf0c09" :answer/id #uuid "edd930cf-02eb-574c-a3b7-b59eb3a2f91a" :answer/type :answer.type/math :answer/value "-6+4(x+1)-5(x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "q-81064/selection/d7ad0aaea69ff9e7e096fff899a03a8fce739680b466beedbd6701a93d12868b" :answer/id #uuid "9d0566bd-43fd-519f-9c75-083d6c2f14d0" :answer/type :answer.type/math :answer/value "6+4(x+1)+5(x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "q-81064/selection/62df5ac0f606904a31958cbc74de76775cc75a9fbe424ef88a8aa7ff21ddfac9" :answer/id #uuid "63c09e50-2612-5081-be4e-42cd20376e7c" :answer/type :answer.type/math :answer/value "6+4(x+1)-5(x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "q-81064/selection" :answer-field/id #uuid "e97b183c-a712-5bd9-80bc-a1921934b8ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81064/selection/62df5ac0f606904a31958cbc74de76775cc75a9fbe424ef88a8aa7ff21ddfac9" :answer-field/choices ["q-81064/selection/2b7391e01b73804fedff2a3f64cad1acfcdbe52db4bfa1b91ed29f28f1e5cff4" "q-81064/selection/81555c2d9b1c64f7fcd900009b24f37dbe47609ea7507413b1de78ab0f70e511" "q-81064/selection/2dd40d85a0d7eea398afd71898e0c97095612df4416481716f4a103572cf0c09" "q-81064/selection/d7ad0aaea69ff9e7e096fff899a03a8fce739680b466beedbd6701a93d12868b" "q-81064/selection/62df5ac0f606904a31958cbc74de76775cc75a9fbe424ef88a8aa7ff21ddfac9"] :db/ensure [:answer-field/validate]} {:db/id "q-81064" :question/id #uuid "676584ae-8337-52da-aa8f-4d12ff4111d0" :question/math-academy-id "q-81064" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053574/assets/185b5924c542bb9f396fe826aac141256a13b967c45c47afc87ca07445df062f.png)\n\nThe figure above shows the graph of a function $y=f(x).$ Which of the following could be the second-degree Taylor polynomial for $f$ about $x=-1?$" :question/worked-solution "The second-degree Taylor polynomial for $f(x)$ about $x=-1$ is \n\n$$\n{P}_{2}(x)=f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}(x+1)^{2}.\n$$\n\nFrom the graph, we observe:\n\n- $f(-1)>0.$ Therefore, the first term of the Taylor polynomial must be positive.\n\n- ${f}^{′}(-1)>0,$ because the slope of the tangent at $x=-1$ is positive. Therefore, the coefficient of the second term in the Taylor polynomial must be positive.\n\n- ${f}^{″}(-1)<0,$ because the graph is concave down at $x=-1.$ Therefore, the coefficient of the third term in the Taylor polynomial must be negative.\n\nThe only option that meets the above criteria is\n\n$$\n{P}_{2}(x)=6+4(x+1)-5(x+1)^{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81064/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fce4cd5a-537a-5eb4-a610-59d2bad95a89"] :knowledge-point/questions ["q-81064"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83724/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "e6aa717d-1ae1-5ea3-90d2-2c78740f718c" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-83724/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "a3e9a907-f09c-5d7f-bafd-266a0aa34fbc" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-83724/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "18a2936b-3bf9-5dd8-bbe7-865f555da148" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-83724/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "d28bde05-2d7d-553f-87ff-43e428870443" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-83724/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "e250db17-77be-5c53-8f95-d53e70852115" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-83724/selection" :answer-field/id #uuid "1587c4c8-7d89-5ebd-8212-fbad60dc8aa4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83724/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-83724/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-83724/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-83724/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-83724/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-83724/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-83724" :question/id #uuid "4c3eeb7e-eaef-58c6-b62b-07de56152b81" :question/math-academy-id "q-83724" :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=6$ is given by ${P}_{2}(x)=-5+6(x-6)-4(x-6)^{2}.$ What is the value of ${f}^{″}(6)?$" :question/worked-solution "This is an expansion about the point $x=6,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(6).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $-4.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(6)=-4\\,⟹\\,{f}^{″}(6)=-8.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83724/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "73571ff9-24a3-52b6-be57-3ef08652ebb7"] :knowledge-point/questions ["q-83724"] :db/ensure [:knowledge-point/validate]}]
