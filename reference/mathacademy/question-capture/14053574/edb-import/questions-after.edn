#{[{:db/id #edb/ref 17592186331025 :knowledge-point/_questions [{:knowledge-point/id #uuid "fce4cd5a-537a-5eb4-a610-59d2bad95a89" :knowledge-point/title "Deducing the Second-Degree Taylor Polynomial Given the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25260566-424c-56b3-99bd-90a44452693e" :answer/type {:db/ident :answer.type/math} :answer/value "1+(x-2)^{2}" :db/id #edb/ref 17592186331027} {:answer/id #uuid "0517db9f-bbdc-5dcf-b086-db21f6afaebd" :answer/type {:db/ident :answer.type/math} :answer/value "1-{x}^{2}" :db/id #edb/ref 17592186331028} {:answer/id #uuid "48cb5ae2-0240-50fc-b00a-4e128e10719c" :answer/type {:db/ident :answer.type/math} :answer/value "1-(x-2)^{2}" :db/id #edb/ref 17592186331029} {:answer/id #uuid "d718e0a5-a0c5-5bcf-aa94-a92aa16e8a6a" :answer/type {:db/ident :answer.type/math} :answer/value "2+(x-2)-{(x-2)}^{2}" :db/id #edb/ref 17592186331030} {:answer/id #uuid "deaaf7b2-ca28-50e3-b9be-275aa28e9d51" :answer/type {:db/ident :answer.type/math} :answer/value "1+(x-2)-{(x-2)}^{2}" :db/id #edb/ref 17592186331031}] :answer-field/correct {:answer/id #uuid "25260566-424c-56b3-99bd-90a44452693e" :answer/type {:db/ident :answer.type/math} :answer/value "1+(x-2)^{2}" :db/id #edb/ref 17592186331027} :answer-field/id #uuid "821ac992-a5a1-5ec2-a880-570fb0418e8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331026}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d2528da7-7989-5718-98f8-9e34c6fc3006" :question/math-academy-id "q-15519" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053574/assets/b70f90738fc329a0d58527dc013a3e175b0954e0ccc27972d5abcde1708e1bca.png)\n\nThe figure above shows the graph of a function $y=f(x).$ Which of the following could be the second-degree Taylor polynomial for $f$ about $x=2?$" :question/worked-solution "The second-degree Taylor polynomial for $f(x)$ about $x=2$ is \n\n$$\n{P}_{2}(x)=f(2)+{f}^{′}(2)(x-2)+\\frac{{f}^{″}(2)}{2}(x-2)^{2}.\n$$\n\nFrom the graph, we observe:\n\n- $f(2)>0.$ Therefore, the first term of the Taylor polynomial must be positive.\n\n- ${f}^{′}(2)=0,$ because the slope of the tangent at $x=2$ is zero. Therefore, the coefficient of the second term in the Taylor polynomial must be zero.\n\n- ${f}^{″}(2)>0,$ because the graph is concave up at $x=2.$ Therefore, the coefficient of the third term in the Taylor polynomial must be positive.\n\nThe only option that meets the above criteria is\n\n$$\n{P}_{2}(x)=1+(x-2)^{2}.\n$$"}] [{:db/id #edb/ref 17592186184740 :knowledge-point/_questions [{:knowledge-point/id #uuid "73571ff9-24a3-52b6-be57-3ef08652ebb7" :knowledge-point/title "Finding the First or Second Derivative of a Function at a Point Given Its Second-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014084c7-774c-5874-8bfa-5e1500eb4b6a" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186183330} {:answer/id #uuid "1f85b179-80c7-563b-bdb8-f35c71451605" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186183331} {:answer/id #uuid "2b09dafc-9830-5dba-81d1-85b630c8d9cf" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186183332} {:answer/id #uuid "3d3a2300-0728-5c5c-9dfd-030ba41f7db6" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186183333} {:answer/id #uuid "4b315392-bbe7-51a8-999b-1088ff87c7a9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186183334}] :answer-field/correct {:answer/id #uuid "1f85b179-80c7-563b-bdb8-f35c71451605" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186183331} :answer-field/id #uuid "767f9534-52f4-52eb-b1aa-6a8a07f9cac4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183329}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0303799d-79d7-5a48-8d50-1f737895b680" :question/math-academy-id "q-50974" :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=-2$ is given by ${P}_{2}(x)=2+4(x+2)+16(x+2)^{2}.$ What is the value of ${f}^{″}(-2)?$" :question/worked-solution "This is an expansion about the point $x=-2,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(-2).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $16.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(-2)=16\\,⟹\\,{f}^{″}(-2)=32.\n$$"}] [{:db/id #edb/ref 17592186331032 :knowledge-point/_questions [{:knowledge-point/id #uuid "73571ff9-24a3-52b6-be57-3ef08652ebb7" :knowledge-point/title "Finding the First or Second Derivative of a Function at a Point Given Its Second-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65efb53e-5e59-573e-bbc8-66fc305cd7af" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186331034} {:answer/id #uuid "b12e1f62-4c7b-5147-b017-f88da94fb738" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186331035} {:answer/id #uuid "18dfa965-fe8a-5b38-9d99-98a1c590e4d8" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186331036} {:answer/id #uuid "f18a85a0-6d21-518c-bbb6-6d0e3ede348d" :answer/type {:db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186331037} {:answer/id #uuid "675ef4a9-b374-5104-ade8-4fc9ebda7aa4" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186331038}] :answer-field/correct {:answer/id #uuid "65efb53e-5e59-573e-bbc8-66fc305cd7af" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186331034} :answer-field/id #uuid "9df7f574-f220-5cdd-b5b3-e23a8a279b59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331033}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2c7eb72b-51e7-5594-a379-c3d96c8cc9aa" :question/math-academy-id "q-81062" :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=-3$ is given by ${P}_{2}(x)=-24+36(x+3)-18(x+3)^{2}.$ What is the value of ${f}^{″}(-3)?$" :question/worked-solution "This is an expansion about the point $x=-3,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(-3).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $-18.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(-3)=-18\\,⟹\\,{f}^{″}(-3)=-36.\n$$"}] [{:db/id #edb/ref 17592186331039 :knowledge-point/_questions [{:knowledge-point/id #uuid "fce4cd5a-537a-5eb4-a610-59d2bad95a89" :knowledge-point/title "Deducing the Second-Degree Taylor Polynomial Given the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "981ceae7-b446-5115-a342-9b34a14c0de4" :answer/type {:db/ident :answer.type/math} :answer/value "6-4(x+1)+5(x+1)^{2}" :db/id #edb/ref 17592186331041} {:answer/id #uuid "edd930cf-02eb-574c-a3b7-b59eb3a2f91a" :answer/type {:db/ident :answer.type/math} :answer/value "-6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186331042} {:answer/id #uuid "63c09e50-2612-5081-be4e-42cd20376e7c" :answer/type {:db/ident :answer.type/math} :answer/value "6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186331043} {:answer/id #uuid "f9efc2c6-79cf-5f75-80fb-babccb0e4a6c" :answer/type {:db/ident :answer.type/math} :answer/value "-6-4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186331044} {:answer/id #uuid "9d0566bd-43fd-519f-9c75-083d6c2f14d0" :answer/type {:db/ident :answer.type/math} :answer/value "6+4(x+1)+5(x+1)^{2}" :db/id #edb/ref 17592186331045}] :answer-field/correct {:answer/id #uuid "63c09e50-2612-5081-be4e-42cd20376e7c" :answer/type {:db/ident :answer.type/math} :answer/value "6+4(x+1)-5(x+1)^{2}" :db/id #edb/ref 17592186331043} :answer-field/id #uuid "e97b183c-a712-5bd9-80bc-a1921934b8ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331040}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "676584ae-8337-52da-aa8f-4d12ff4111d0" :question/math-academy-id "q-81064" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053574/assets/185b5924c542bb9f396fe826aac141256a13b967c45c47afc87ca07445df062f.png)\n\nThe figure above shows the graph of a function $y=f(x).$ Which of the following could be the second-degree Taylor polynomial for $f$ about $x=-1?$" :question/worked-solution "The second-degree Taylor polynomial for $f(x)$ about $x=-1$ is \n\n$$\n{P}_{2}(x)=f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}(x+1)^{2}.\n$$\n\nFrom the graph, we observe:\n\n- $f(-1)>0.$ Therefore, the first term of the Taylor polynomial must be positive.\n\n- ${f}^{′}(-1)>0,$ because the slope of the tangent at $x=-1$ is positive. Therefore, the coefficient of the second term in the Taylor polynomial must be positive.\n\n- ${f}^{″}(-1)<0,$ because the graph is concave down at $x=-1.$ Therefore, the coefficient of the third term in the Taylor polynomial must be negative.\n\nThe only option that meets the above criteria is\n\n$$\n{P}_{2}(x)=6+4(x+1)-5(x+1)^{2}.\n$$"}] [{:db/id #edb/ref 17592186331046 :knowledge-point/_questions [{:knowledge-point/id #uuid "73571ff9-24a3-52b6-be57-3ef08652ebb7" :knowledge-point/title "Finding the First or Second Derivative of a Function at a Point Given Its Second-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a2936b-3bf9-5dd8-bbe7-865f555da148" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186331048} {:answer/id #uuid "e250db17-77be-5c53-8f95-d53e70852115" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186331049} {:answer/id #uuid "d28bde05-2d7d-553f-87ff-43e428870443" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186331050} {:answer/id #uuid "a3e9a907-f09c-5d7f-bafd-266a0aa34fbc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186331051} {:answer/id #uuid "e6aa717d-1ae1-5ea3-90d2-2c78740f718c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186331052}] :answer-field/correct {:answer/id #uuid "e250db17-77be-5c53-8f95-d53e70852115" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186331049} :answer-field/id #uuid "1587c4c8-7d89-5ebd-8212-fbad60dc8aa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331047}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4c3eeb7e-eaef-58c6-b62b-07de56152b81" :question/math-academy-id "q-83724" :question/problem "The second-degree Taylor polynomial of a function $f(x)$ about $x=6$ is given by ${P}_{2}(x)=-5+6(x-6)-4(x-6)^{2}.$ What is the value of ${f}^{″}(6)?$" :question/worked-solution "This is an expansion about the point $x=6,$ so the coefficient of the second-degree term is $\\frac{1}{2}{f}^{″}(6).$ \n\nIn the given equation, we see that the coefficient of the second-degree term is $-4.$ So, we have\n\n$$\n\\frac{1}{2}{f}^{″}(6)=-4\\,⟹\\,{f}^{″}(6)=-8.\n$$"}]}
