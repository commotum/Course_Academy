7a91ec"] :db/ensure [:answer-field/validate]} {:db/id "q-127744" :question/id #uuid "08bebf42-aebf-5366-9eb7-e8795f6019b5" :question/math-academy-id "q-127744" :question/problem "Calculate ${C}^{-1}$, where\n$C=[\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nC=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $C$ can be found using the following formula:\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(C)=3\\cdot 0-1\\cdot 3=-3\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{(-3)}[\\begin{aligned}0 & -3 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}C{C}^{-1} & =[\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {C}^{-1}C & =\\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}][\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127744/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3"] :knowledge-point/questions ["q-127744"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127737/selection/fa68b1e15855a1eddf2ed00f6d50e68dce79d8213694896f51bdea24210f67d1" :answer/id #uuid "e77a7e5a-64db-5196-a83c-c3a82548436a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127737/selection/3c9f82e9df6d3eafc7e4e9877bd217eeeaacd9f8fe6cde854c1f75645bcaab49" :answer/id #uuid "cd07a42e-8f00-526c-8e6b-ac348c50983a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -3 \\\\ -5 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127737/selection/cbc66e6f12c03d7ed6d537bc7413e857a8f7dc5fcacc75fa6e83a8821f11f777" :answer/id #uuid "8450a5d0-125e-5fab-98cd-1f1693cc4ed6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127737/selection/99ccd5e18668f60ee5fc93a65992e0fb0d321b499100a580b2bfaa2b586b8f1f" :answer/id #uuid "ee94e148-2a0a-5c3f-82cd-3ffe92783a65" :answer/type :answer.type/math :answer/value "\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127737/selection/1110a0aee2f84348300c17e4bce014a3b34f79c1e60e93d115ab1ade2c1e7924" :answer/id #uuid "96df7422-ae24-5302-b122-de5d7da09f75" :answer/type :answer.type/math :answer/value "\\frac{1}{2}[\\begin{aligned}-2 & 3 \\\\ 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-127737/selection" :answer-field/id #uuid "3c816e28-8723-5565-9497-0c57705cfeba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127737/selection/cbc66e6f12c03d7ed6d537bc7413e857a8f7dc5fcacc75fa6e83a8821f11f777" :answer-field/choices ["q-127737/selection/fa68b1e15855a1eddf2ed00f6d50e68dce79d8213694896f51bdea24210f67d1" "q-127737/selection/3c9f82e9df6d3eafc7e4e9877bd217eeeaacd9f8fe6cde854c1f75645bcaab49" "q-127737/selection/cbc66e6f12c03d7ed6d537bc7413e857a8f7dc5fcacc75fa6e83a8821f11f777" "q-127737/selection/99ccd5e18668f60ee5fc93a65992e0fb0d321b499100a580b2bfaa2b586b8f1f" "q-127737/selection/1110a0aee2f84348300c17e4bce014a3b34f79c1e60e93d115ab1ade2c1e7924"] :db/ensure [:answer-field/validate]} {:db/id "q-127737" :question/id #uuid "e9cf7ac8-28c7-510c-8205-256a03a04ef2" :question/math-academy-id "q-127737" :question/problem "Calculate ${U}^{-1}$, where \n$U=[\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nU=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $U$ can be found using the following formula:\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(U)=-2\\cdot 7-(-5)\\cdot 3=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{1}[\\begin{aligned}7 & -3 \\\\ -(-5) & -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}U{U}^{-1} & =[\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}]\\cdot [\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {U}^{-1}U & =[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127737/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3"] :knowledge-point/questions ["q-127737"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316780/field-1/29f1bd004b0e742e8153de2e3a77945bac059aed56c8ead2bc0011a45597d328" :answer/id #uuid "2ce6153d-aa59-5359-b219-8c1c198d1afa" :answer/type :answer.type/math :answer/value "-\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "q-316780/field-1" :answer-field/id #uuid "641442f3-70be-5342-a3cc-667686c722f2" :answer-field/key "field-1" :answer-field/type :