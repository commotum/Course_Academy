ge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611}] :answer-field/correct {:answer/id #uuid "bcb2e8ff-3121-5196-92e6-d918492b6934" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186287611} :answer-field/id #uuid "35b4a8d7-1363-5534-b201-82e94429f588" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287610} {:answer-field/choices [{:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613}] :answer-field/correct {:answer/id #uuid "ea573bc7-d465-55d7-ad7a-1617138d218f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287613} :answer-field/id #uuid "5bb16bc3-2efd-5f17-8da0-ce52fa6d81cd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287612} {:answer-field/choices [{:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615}] :answer-field/correct {:answer/id #uuid "fe0f845f-ffa3-5015-aec7-5498cbc6b462" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186287615} :answer-field/id #uuid "5b4d98af-565c-5dd9-b636-823006d646f3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287614} {:answer-field/choices [{:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617}] :answer-field/correct {:answer/id #uuid "555d6b70-7f20-5fb3-8403-90a66073285f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186287617} :answer-field/id #uuid "258b6df0-7357-5812-b3c8-874cafe1e994" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287616}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6af6fab-87f4-501e-a8f1-9837b9d39287" :question/math-academy-id "q-317069" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 5y+9x\\end{aligned}].\n$$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}].\n$$"}]}
