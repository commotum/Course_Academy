fficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4b3d954a-970e-5df9-84d3-b38ba96cad0e" :question/math-academy-id "q-168105" :question/problem "What is the linear transformation $T$ whose standard matrix is \n$T=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]?$" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186287586 :knowledge-point/_questions [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6faaa5ec-47d0-5fe2-a867-e5e530b343aa" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y+4z" :db/id #edb/ref 17592186287588} {:answer/id #uuid "5bda35bf-da60-5912-8d7f-ad3bf4924b09" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y+4z" :db/id #edb/ref 17592186287589}] :answer-field/correct {:answer/id #uuid "5bda35bf-da60-5912-8d7f-ad3bf4924b09" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y+4z" :db/id #edb/ref 17592186287589} :answer-field/id #uuid "ecf75c2f-a8a4-5b6e-aff1-6e74c733db79" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287587} {:answer-field/choices [{:answer/id #uuid "80337915-05c7-5b5a-9351-76754280b60f" :answer/type {:db/ident :answer.type/math} :answer/value "5x+3y-2z" :db/id #edb/ref 17592186287591}] :answer-field/correct {:answer/id #uuid "80337915-05c7-5b5a-9351-76754280b60f" :answer/type {:db/ident :answer.type/math} :answer/value "5x+3y-2z" :db/id #edb/ref 17592186287591} :answer-field/id #uuid "6da96716-21dd-5696-9689-fdfbd2d819ea" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287590} {:answer-field/choices [{:answer/id #uuid "809da23f-ed52-57b1-b437-b6d9f70b34a1" :answer/type {:db/ident :answer.type/math} :answer/value "x-6y+7z" :db/id #edb/ref 17592186287593}] :answer-field/correct {:answer/id #uuid "809da23f-ed52-57b1-b437-b6d9f70b34a1" :answer/type {:db/ident :answer.type/math} :answer/value "x-6y+7z" :db/id #edb/ref 17592186287593} :answer-field/id #uuid "38a5ca4d-6f6a-5db3-be65-4264ad29a753" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287592}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2600860a-153e-525c-9281-815ea310935f" :question/math-academy-id "q-317044" :question/problem "What is the linear transformation $T$ whose standard matrix is $T=[\\begin{aligned}2 & -1 & 4 \\\\ 5 & 3 & -2 \\\\ 1 & -6 & 7\\end{aligned}]?$\n\n| $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 & -1 & 4 \\\\ 5 & 3 & -2 \\\\ 1 & -6 & 7\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}2x-y+4z \\\\ 5x+3y-2z \\\\ x-6y+7z\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2x-y+4z \\\\ 5x+3y-2z \\\\ x-6y+7z\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186287594 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "674d480d-cc3a-59d2-9586-605874f79fcd" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186287596}] :answer-field/correct {:answer/id #uuid "674d480d-cc3a-59d2-9586-605874f79fcd" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186287596} :answer-field/id #uuid "63cfcd97-f006-5cbd-8df9-101f0a1f52ff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287595} {:answer-field/choices [{:answer/id #uuid "0053ec6a-876a-5afe-8747-71a6b4686546" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186287598}] :answer-field/correct {:answer/id #uuid "0053ec6a-876a-5afe-8747-71a6b4686546" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186287598} :answer-field/id #uuid "3d0849b6-f263-53fb-862d-06a26f7fdb17" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287597} {:answer-field/choices [{:answer/id #uuid "1f3aebf1-86c5-5699-8e9a-351882ddb24e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186287600}] :answer-field/correct {:answer/id #uuid "1f3aebf1-86c5-5699-8e9a-351882ddb24e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186287600} :answer-field/id #uuid "5b67a10b-ec6d-5add-8dff-9e56b06475a8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287599}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8a88700f-52e3-57e4-8a47-e1ab463bef49" :question/math-academy-id "q-317057" :question/problem "Consider the matrix $T$ and the vector $v$ given below. \n\n$$\nT=[\\begin{aligned}-1 & 2 & 3 \\\\ 4 & 0 & -2 \\\\ 5 & 1 & 1\\end{aligned}],\\,v=[\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}]\n$$\n\nIf $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n| $T(v)=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-1 & 2 & 3 \\\\ 4 & 0 & -2 \\\\ 5 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 6 \\\\ 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287601 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65a66d39-1f21-5709-af89-cb1f38a51ea4" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186287603} {:answer/id #uuid "1caebdf4-dac0-5aa3-af37-e103324b199d" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186287604}] :answer-field/correct {:answer/id #uuid "65a66d39-1f21-5709-af89-cb1f38a51ea4" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186287603} :answer-field/id #uuid "29d9e34d-eeec-56cb-9bb6-ae4426bc0489" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287602} {:answer-field/choices [{:answer/id #uuid "56984b0d-75f2-54e7-9319-a4529f00e56c" :answer/type {:db/ident :answer.type/math} :answer/va