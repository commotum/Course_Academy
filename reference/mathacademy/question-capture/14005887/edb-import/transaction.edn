{aligned}-5 \\\\ 6 \\\\ 8\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317057/field-1" "q-317057/field-2" "q-317057/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d"] :knowledge-point/questions ["q-317057"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317059/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "65a66d39-1f21-5709-af89-cb1f38a51ea4" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-317059/field-1/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02" :answer/id #uuid "1caebdf4-dac0-5aa3-af37-e103324b199d" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "q-317059/field-1" :answer-field/id #uuid "29d9e34d-eeec-56cb-9bb6-ae4426bc0489" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317059/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-317059/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" "q-317059/field-1/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02"] :db/ensure [:answer-field/validate]} {:db/id "q-317059/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "56984b0d-75f2-54e7-9319-a4529f00e56c" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-317059/field-2" :answer-field/id #uuid "ed08e6fc-a62b-591f-b2b6-70b290dd85c4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317059/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-317059/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-317059/fiel