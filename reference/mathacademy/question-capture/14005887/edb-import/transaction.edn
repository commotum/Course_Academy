520f727193ce4829b63a0380211ed3ca1f9136c5676f" "q-168105/selection/0836df890af6db959e3eb7f897f8f541b0cfbd5c728ec4cd817c5a337e3d924b" "q-168105/selection/5e0008cc1b1f61847ced9a364b59f315e1abd09d67c3b1b289d68c98095d7f7b" "q-168105/selection/bfc5c0b00bb4ba1abe618988326aa99803d20de4d4519521934db6fd886e1e22" "q-168105/selection/577650c250537732fcab0b9891b60a187cd4ba5067b84c0379fcfc8268a15a73"] :db/ensure [:answer-field/validate]} {:db/id "q-168105" :question/id #uuid "4b3d954a-970e-5df9-84d3-b38ba96cad0e" :question/math-academy-id "q-168105" :question/problem "What is the linear transformation $T$ whose standard matrix is \n$T=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]?$" :question/worked-solution "Consider a general vector $\\,[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & -1 & 1 \\\\ 1 & -1 & 0\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+z \\\\ -y+z \\\\ x-y\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-168105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c"] :knowledge-point/questions ["q-168105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317044/field-1/bafcc9303e5bff9ee8c5c561c0e17ea191c89569d61f754cb7a0e6e8a0f88017" :answer/id #uuid "5bda35bf-da60-5912-8d7f-ad3bf4924b09" :answer/type :answer.type/math :answer/value "2x-y+4z" :db/ensure [:answer/validate]} {:db/id "q-317044/field-1/92e63e81a3be087b2ee17736fd226d79743db4451f394073f227a5c0c56c7871" :answer/id #uuid "6faaa5ec-47d0-5fe2-a867-e5e530b343aa" :answer