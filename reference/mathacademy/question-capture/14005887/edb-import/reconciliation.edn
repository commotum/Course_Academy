 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 6 \\\\ 8\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/activity-metadata.json" "file_sha256" "c3d9df000b8d04304601ba1ed0194385592924551b158acc1ccd751b48fece3e"} {"question" "q-317057" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317057" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" nil "attribute" "question/problem" "value" "Consider the matrix $T$ and the vector $v$ given below. \n\n$$\nT=[\\begin{aligned}0 & -2 & 5 \\\\ 3 & 0 & -1 \\\\ 4 & 6 & 2\\end{aligned}],\\,v=[\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}]\n$$\n\nIf $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n| $T(v)=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |\n|  | {{field-3}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" nil "attribute" "question/worked-solution" "value" "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}0 & -2 & 5 \\\\ 3 & 0 & -1 \\\\ 4 & 6 & 2\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}11 \\\\ -6 \\\\ 14\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/activity-metadata.json" "file_sha256" "c3d9df000b8d04304601ba1ed0194385592924551b158acc1ccd751b48fece3e"} {"question" "q-317059" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "11"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317059" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "14"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" nil "attribute" "question/problem" "value" "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 5y+9x\\end{aligned}].\n$$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" nil "attribute" "question/worked-solution" "value" "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-6x \\\\ 9x+5y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-6 & 0 \\\\ 9 & 5\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/activity-metadata.json" "file_sha256" "c3d9df000b8d04304601ba1ed0194385592924551b158acc1ccd751b48fece3e"} {"question" "q-317069" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005887/state.json" "file_sha256" "090e738f3f3eea9e0899b6b755238681a79e55e772ac00dfb3edc424fb6740e9"} {"question" "q-317069" "field" "field-4