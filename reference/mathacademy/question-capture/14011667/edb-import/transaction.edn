673be85d15e3c4" "q-49947/selection/77e6c0d8f5927069f5eee187b3a2e9b8afc7d676e4f8541223a309d8fe7df56c" "q-49947/selection/b4978704dff58b1aa5c768b7a8bc63d4705a9e3e800e85f2b9de9d6f9e5ac454" "q-49947/selection/86f19ddbd08375b70940bed5e3797811cd513efc623aec9d1254e701fcb733f7"] :db/ensure [:answer-field/validate]} {:db/id "q-49947" :question/id #uuid "0290b966-ea8a-5aaa-95c5-d4ed0c24c604" :question/math-academy-id "q-49947" :question/problem "Which of the following shows some of the solution curves of the differential equation $x\\cdot \\frac{\\text{d}y}{\\text{d}x}=1$ for $x>0?$" :question/worked-solution "Rearranging and Integrating the equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{x} \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ y & =\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x|+C \\\\  & =\\operatorname{ln}⁡x+C,\\,x>0.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/8e047c3c27a000af943f50499f8c7559acceeb78cc006e796c7d353729991517.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49947/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-49947"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119142/selection/e01eb5cf19da6fc451d21ef2dee485280ede8daafe9724453170748eb16e785a" :answer/id #uuid "53b0e08e-406e-5506-8b7d-bc2a778b94db" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/3e475d534a8f090caa9611d865e70a9717969ddc541c55d98200e19031bffe84.png" :db/ensure [:answer/validate]} {:db/id "q-119142/selection/f69fe265770ace90b0fb6988415b4600eb893a508d7766