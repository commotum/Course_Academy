ces ["q-119139/selection/2bfab0fad8df0078c4587d386bcac2e7c6bb83aa0647b6d5a3155e2cbedf4b65" "q-119139/selection/587f85aafe54b232be06e6e8f6f338e9e09750c85bb1b4e9dcaea57691acd211" "q-119139/selection/62cbc1ae3de666e02dc11ce365b48a504ccce820abb948d94487cec64139464a" "q-119139/selection/9a9a5ad53ed90cac5383357077b72aab840f5de13e51670114a538666df90b53" "q-119139/selection/4e8fbf868857a31d3b4256d4f161abaad2f9e3d0b5a01a7ce8b47bcb809b1f45"] :db/ensure [:answer-field/validate]} {:db/id "q-119139" :question/id #uuid "06acaa38-08e2-563c-a31d-7a927dbf62a2" :question/math-academy-id "q-119139" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{2x}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{2x})\\,\\text{d}x \\\\ y & =-4\\int {e}^{2x}\\,\\text{d}x \\\\  & =-4(\\frac{{e}^{2x}}{2}) \\\\  & =-2{e}^{2x}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/cc2ee25a85be3ffdb055853f7665bd53d34003a74b96a14bb947bed39b18e83f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119139/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-119139"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49947/selection/3622b7a57bcd549578c220464387d03b65fb351d21618f682c6ad992f5692ac4" :answer/id #uuid "27bafd7e-a0cd-5785-88a0-c17e11e4a36d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/5c933988eb335b7310387cfc532a6e144de3e43bfebde4c29d1e5fe76fa35027.png" :db/ensure [:answer/validate]} 