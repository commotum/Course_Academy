[{:db/id "q-119034/selection/88e7cb6701e261c5a36b48f12ee104b4db8480802d97a6b153cc1c1ebbdb8b43" :answer/id #uuid "40debac3-e06b-513d-a96c-22874472f6e6" :answer/type :answer.type/math :answer/value "f(x)=\\operatorname{ln}⁡|3x-1|+C" :db/ensure [:answer/validate]} {:db/id "q-119034/selection/63c0b05dbf84b764d2f239d489e139f908e9b27e8959dc451e694544bd468195" :answer/id #uuid "f582ebf3-cef1-57ae-8af2-3001deecf27b" :answer/type :answer.type/math :answer/value "f(x)=-\\frac{3}{(x-1)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-119034/selection/45837d1d4ee294f8703ed420cbc9a592017d9ea32b0dbf6d1e52d10222267fcc" :answer/id #uuid "578e6903-379c-5efb-aac9-852cc8534b99" :answer/type :answer.type/math :answer/value "f(x)=-\\frac{1}{(3x-1)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-119034/selection/ebaf5e0a444464b913617fecc813d82845c47355e13151bc14947f96772590c9" :answer/id #uuid "48ca5459-c7c2-5216-8d87-70f58dd6dcf8" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{3}\\operatorname{ln}⁡|x-1|+C" :db/ensure [:answer/validate]} {:db/id "q-119034/selection/97cc00ec78188f699a36fd8ce6661a9bc51dc539b8762b4259e51951d8284e88" :answer/id #uuid "7fcf3473-3770-5267-8bff-e44925e2c035" :answer/type :answer.type/math :answer/value "f(x)=3\\operatorname{ln}⁡|x-1|+C" :db/ensure [:answer/validate]} {:db/id "q-119034/selection" :answer-field/id #uuid "45707a41-bc4b-5405-b387-28496c1d2308" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119034/selection/97cc00ec78188f699a36fd8ce6661a9bc51dc539b8762b4259e51951d8284e88" :answer-field/choices ["q-119034/selection/88e7cb6701e261c5a36b48f12ee104b4db8480802d97a6b153cc1c1ebbdb8b43" "q-119034/selection/63c0b05dbf84b764d2f239d489e139f908e9b27e8959dc451e694544bd468195" "q-119034/selection/45837d1d4ee294f8703ed420cbc9a592017d9ea32b0dbf6d1e52d10222267fcc" "q-119034/selection/ebaf5e0a444464b913617fecc813d82845c47355e13151bc14947f96772590c9" "q-119034/selection/97cc00ec78188f699a36fd8ce6661a9bc51dc539b8762b4259e51951d8284e88"] :db/ensure [:answer-field/validate]} {:db/id "q-119034" :question/id #uuid "026bb192-a837-5fcc-8667-53e2260d5753" :question/math-academy-id "q-119034" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{3}{x-1}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{3}{x-1}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{x-1}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{x-1}\\,\\text{d}x \\\\  & =3\\operatorname{ln}⁡|x-1|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119034/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-119034"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-50136"] :question/problem "Solve the differential equation $\\frac{\\text{d}y}{\\text{d}x}+4{e}^{2x}=-2x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{2x}-2x.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\ y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\begin{aligned}y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\  & =-4\\int {e}^{2x}\\,\\text{d}x-2\\int x\\,\\text{d}x \\\\  & =-2{e}^{2x}-{x}^{2}+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-119032/selection/259d9486482ae02849f9d91d3e5b71ccf56d590b024165a729f4f7b1c983a635" :answer/id #uuid "5e89e576-486a-554f-a8e4-561e6e58ad62" :answer/type :answer.type/math :answer/value "f(x)=-\\frac{1}{8}\\operatorname{cos}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-119032/selection/9d24e0381316502aae48406e83de83e90d4f25c558cc500cebe6e9638b462b12" :answer/id #uuid "f7d5de22-29dc-571a-9a04-6e24438dc027" :answer/type :answer.type/math :answer/value "f(x)=-8\\operatorname{cos}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-119032/selection/1a89fc9bc3ab46627d9789c14ba73775408cab9f4bb54bcdf981458a7e434198" :answer/id #uuid "fe1ffa70-41ba-592d-9221-889fddb97a61" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{2}\\operatorname{cos}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-119032/selection/6d6fb566f9cc27338bc1891175da3034abaf6036f41adfcae1f6231efe1d2814" :answer/id #uuid "d68943c3-babc-5cca-bb4a-6060331890a9" :answer/type :answer.type/math :answer/value "f(x)=2\\operatorname{cos}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-119032/selection/5ce31df91e9ba1bb586a86d959e6a124c3bca23782b0bcd7f12ead379afdf45d" :answer/id #uuid "abe66a86-26ba-52ce-ae99-cda0b40a5423" :answer/type :answer.type/math :answer/value "f(x)=-\\frac{1}{4}\\operatorname{cos}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-119032/selection" :answer-field/id #uuid "7f4971da-77d9-5b10-9742-4958f510bb24" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119032/selection/259d9486482ae02849f9d91d3e5b71ccf56d590b024165a729f4f7b1c983a635" :answer-field/choices ["q-119032/selection/259d9486482ae02849f9d91d3e5b71ccf56d590b024165a729f4f7b1c983a635" "q-119032/selection/9d24e0381316502aae48406e83de83e90d4f25c558cc500cebe6e9638b462b12" "q-119032/selection/1a89fc9bc3ab46627d9789c14ba73775408cab9f4bb54bcdf981458a7e434198" "q-119032/selection/6d6fb566f9cc27338bc1891175da3034abaf6036f41adfcae1f6231efe1d2814" "q-119032/selection/5ce31df91e9ba1bb586a86d959e6a124c3bca23782b0bcd7f12ead379afdf45d"] :db/ensure [:answer-field/validate]} {:db/id "q-119032" :question/id #uuid "ae4d3203-76af-57e6-914e-e9a022b4a7ca" :question/math-academy-id "q-119032" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{1}{2}\\operatorname{sin}⁡4x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2}\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sin}⁡4x\\,\\text{d}x \\\\ f(x) & =\\frac{1}{2}\\int \\operatorname{sin}⁡4x\\,\\text{d}x \\\\  & =\\frac{1}{2}(-\\frac{1}{4}\\operatorname{cos}⁡4x) \\\\  & =-\\frac{1}{8}\\operatorname{cos}⁡4x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119032/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-119032"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119037/selection/6ed270831b1dc5e300274f23a049dafc9fcf22c18f6fd90779ee8f7469ebee47" :answer/id #uuid "3eb27748-2e8a-51fe-b114-fd69e9fbf3f4" :answer/type :answer.type/math :answer/value "f(x)=x-2{e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-119037/selection/71c611fc2ac47cde8dde6674fbc4261ec71816e439b7e54ebb4e2551ef74e700" :answer/id #uuid "480c3fa0-3814-569b-865a-4f09ecea8bbd" :answer/type :answer.type/math :answer/value "f(x)=x+{e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-119037/selection/91c70e4c07eefe100390b60fdbafb7da895eeb2d889d702f6bcea0b86faa545f" :answer/id #uuid "1a4f2e08-81d5-5c75-a13a-ea6f71eb90ea" :answer/type :answer.type/math :answer/value "f(x)=x-18{e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-119037/selection/6a7959e1feb33326ba5a31bbe6eb7cfe8f7607ff33af34ea32307c0a2ad8c89a" :answer/id #uuid "27334472-5810-5336-9487-b0301e071ae7" :answer/type :answer.type/math :answer/value "f(x)=2(x+9{e}^{-3x})+C" :db/ensure [:answer/validate]} {:db/id "q-119037/selection/db2483c57f31967fe71d9dba20850934fd559a98b0b246f3786b840c38b86ba3" :answer/id #uuid "af6db5b9-065f-579a-8c62-b840cd841d3d" :answer/type :answer.type/math :answer/value "f(x)=2(x-3{e}^{-3x})+C" :db/ensure [:answer/validate]} {:db/id "q-119037/selection" :answer-field/id #uuid "6b52d1da-f2b1-59c0-bf0b-cbabcae3fd2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119037/selection/6ed270831b1dc5e300274f23a049dafc9fcf22c18f6fd90779ee8f7469ebee47" :answer-field/choices ["q-119037/selection/6ed270831b1dc5e300274f23a049dafc9fcf22c18f6fd90779ee8f7469ebee47" "q-119037/selection/71c611fc2ac47cde8dde6674fbc4261ec71816e439b7e54ebb4e2551ef74e700" "q-119037/selection/91c70e4c07eefe100390b60fdbafb7da895eeb2d889d702f6bcea0b86faa545f" "q-119037/selection/6a7959e1feb33326ba5a31bbe6eb7cfe8f7607ff33af34ea32307c0a2ad8c89a" "q-119037/selection/db2483c57f31967fe71d9dba20850934fd559a98b0b246f3786b840c38b86ba3"] :db/ensure [:answer-field/validate]} {:db/id "q-119037" :question/id #uuid "8e422fe9-fc97-5df0-b6a5-ce1fd6f9f5cf" :question/math-academy-id "q-119037" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)-6{e}^{-3x}=1.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1+6{e}^{-3x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (1+6{e}^{-3x})\\text{d}x \\\\  & =\\int \\text{d}x+6\\int {e}^{-3x}\\,\\text{d}x \\\\  & =x+6(-\\frac{1}{3}{e}^{-3x}) \\\\  & =x-2{e}^{-3x}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119037/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-119037"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119035/selection/5d11d3553ed391bd02ab5c872c142af4dc553ff61c9a6bcae7a3e45478bcc971" :answer/id #uuid "5df53c4f-461b-58da-b708-fe15732e2635" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}({x}^{2}-1)+C" :db/ensure [:answer/validate]} {:db/id "q-119035/selection/bfaa92cf3a53a88b539b907cb81dc13dc084d15951293a7e0edd37a2cb6cc2df" :answer/id #uuid "2cf1bfe2-3b08-5429-a12d-2fdcda9de7c4" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}(1-x)+C" :db/ensure [:answer/validate]} {:db/id "q-119035/selection/bdb19801476ad5aad03e603db9546be005ad9241b6fa472bb201cebf34464e85" :answer/id #uuid "5d634642-3a2b-5db5-8bf9-7acfea5de072" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}(3-x)+C" :db/ensure [:answer/validate]} {:db/id "q-119035/selection/a74f55e43d137cb34819192843c1ea81e9c820f0a87c08bd877e480c47ecaffa" :answer/id #uuid "4ab4224b-f455-5ab1-8988-6720dea5f79b" :answer/type :answer.type/math :answer/value "f(x)={x}^{2}(2-x)+C" :db/ensure [:answer/validate]} {:db/id "q-119035/selection/82017ea47da5bbf7a84ded4ddd7d97bc22e1985431713d01122f35e7502e5a23" :answer/id #uuid "8adbc7d2-6f0c-5a4b-8810-f0c4038f4edd" :answer/type :answer.type/math :answer/value "f(x)={x}^{2}(2x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-119035/selection" :answer-field/id #uuid "1b665f02-3442-53c7-bbf5-d87277631ced" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119035/selection/bfaa92cf3a53a88b539b907cb81dc13dc084d15951293a7e0edd37a2cb6cc2df" :answer-field/choices ["q-119035/selection/5d11d3553ed391bd02ab5c872c142af4dc553ff61c9a6bcae7a3e45478bcc971" "q-119035/selection/bfaa92cf3a53a88b539b907cb81dc13dc084d15951293a7e0edd37a2cb6cc2df" "q-119035/selection/bdb19801476ad5aad03e603db9546be005ad9241b6fa472bb201cebf34464e85" "q-119035/selection/a74f55e43d137cb34819192843c1ea81e9c820f0a87c08bd877e480c47ecaffa" "q-119035/selection/82017ea47da5bbf7a84ded4ddd7d97bc22e1985431713d01122f35e7502e5a23"] :db/ensure [:answer-field/validate]} {:db/id "q-119035" :question/id #uuid "36c02825-1f2e-5058-9fc1-074753d8120c" :question/math-academy-id "q-119035" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)+6{x}^{2}=4x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =4x-6{x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x-6{x}^{2})\\text{d}x \\\\  & =4\\int x\\,\\text{d}x-6\\int {x}^{2}\\,\\text{d}x \\\\  & =4\\cdot \\frac{1}{2}{x}^{2}-6\\cdot \\frac{1}{3}{x}^{3} \\\\  & =2{x}^{2}-2{x}^{3}+C \\\\  & =2{x}^{2}(1-x)+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-119035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79554/selection/9118c33269d0e584ee2e0b3beb9d4395cd240221ba13a12325088556315ecc86" :answer/id #uuid "7377d739-2959-5629-a400-637f3e350a58" :answer/type :answer.type/math :answer/value "y=\\frac{4}{5}\\,{x}^{3/2}+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-79554/selection/0c32b3c42cccaa66b65beceb3f4cf1c8a0361990639d20e6bb1910f4a8ea087e" :answer/id #uuid "09c3fce9-4dba-553f-ac4e-8bfd541b9ab2" :answer/type :answer.type/math :answer/value "y=\\frac{2}{3}\\,{x}^{3/2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-79554/selection/b32d365bd5e8e6e423a72d72cc387bdd5f0a73cfc2725470615a443360ef1352" :answer/id #uuid "50d7837b-7f89-5a83-a114-cabd6f5e3bbf" :answer/type :answer.type/math :answer/value "y=\\frac{2}{15}\\,{x}^{5/2}+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-79554/selection/525202937fbfc72aad8c28ca449fb4846bb38335144bffcaa7a2eb0d902e1ea6" :answer/id #uuid "aedeec53-0f33-5a00-8f0d-b977e85a66c0" :answer/type :answer.type/math :answer/value "y=\\frac{2}{15}\\,{x}^{5/2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-79554/selection/68f313a3c78d781fb5c4f508bfaf80a01573ae0bca7082964a5c4525c18e4a1e" :answer/id #uuid "d53425a6-b517-5529-84f7-bdeb700529b9" :answer/type :answer.type/math :answer/value "y=\\frac{4}{15}\\,{x}^{5/2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-79554/selection" :answer-field/id #uuid "120b1a92-69b2-5d1e-8d09-cb723185099c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79554/selection/68f313a3c78d781fb5c4f508bfaf80a01573ae0bca7082964a5c4525c18e4a1e" :answer-field/choices ["q-79554/selection/9118c33269d0e584ee2e0b3beb9d4395cd240221ba13a12325088556315ecc86" "q-79554/selection/0c32b3c42cccaa66b65beceb3f4cf1c8a0361990639d20e6bb1910f4a8ea087e" "q-79554/selection/b32d365bd5e8e6e423a72d72cc387bdd5f0a73cfc2725470615a443360ef1352" "q-79554/selection/525202937fbfc72aad8c28ca449fb4846bb38335144bffcaa7a2eb0d902e1ea6" "q-79554/selection/68f313a3c78d781fb5c4f508bfaf80a01573ae0bca7082964a5c4525c18e4a1e"] :db/ensure [:answer-field/validate]} {:db/id "q-79554" :question/id #uuid "354406fe-0ae4-5318-84e4-271686e8ea87" :question/math-academy-id "q-79554" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\sqrt{x}=0.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\sqrt{x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3}{x}^{3/2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\frac{2}{3}{x}^{3/2}+C)\\text{d}x \\\\ y & =\\frac{2}{3}\\int {x}^{3/2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =\\frac{2}{3}(\\frac{2}{5}\\,{x}^{5/2})+Cx+D \\\\  & =\\frac{4}{15}\\,{x}^{5/2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79554/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-79554"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119043/selection/31a89d4b88c6adfb2a4f3e1e8b2b1bd211b3ecdf9f9f2045714817de57692249" :answer/id #uuid "f76c7bc8-5f0f-5691-b0f5-d5e342b0537e" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{4}+\\frac{5{x}^{2}}{4}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119043/selection/a9515ff2550ed5c2de850c6ad3c73c4e1b0fce7a95884c9de0711bbb29574d83" :answer/id #uuid "76c484bc-cbc4-5551-a1f8-91f030aab2ec" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119043/selection/b00f05c68eea296de8d7104284493e23f331d01a5d4abcb4ffa68c1fcf5b4085" :answer/id #uuid "dcc024df-0d20-5b15-bcc3-a94f7517d89f" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{2}-4{x}^{2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119043/selection/790b6572ed40db5cbe4f42fbe778fc62b7dd7fe136b015111a04067bb0ef7cdb" :answer/id #uuid "e0a27261-a5ca-518c-8c7b-d480e13742a7" :answer/type :answer.type/math :answer/value "y=3{x}^{4}+4{x}^{2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119043/selection/4f2437a610fd750684017fd0b43e7416ed56071cdaa539e32b72e840ee9ac1ee" :answer/id #uuid "38ff9b99-6f09-5946-b632-57cf62d75cdc" :answer/type :answer.type/math :answer/value "y=3{x}^{4}-5{x}^{2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119043/selection" :answer-field/id #uuid "15d4af72-1848-578c-907a-e3c3e65ecc24" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119043/selection/a9515ff2550ed5c2de850c6ad3c73c4e1b0fce7a95884c9de0711bbb29574d83" :answer-field/choices ["q-119043/selection/31a89d4b88c6adfb2a4f3e1e8b2b1bd211b3ecdf9f9f2045714817de57692249" "q-119043/selection/a9515ff2550ed5c2de850c6ad3c73c4e1b0fce7a95884c9de0711bbb29574d83" "q-119043/selection/b00f05c68eea296de8d7104284493e23f331d01a5d4abcb4ffa68c1fcf5b4085" "q-119043/selection/790b6572ed40db5cbe4f42fbe778fc62b7dd7fe136b015111a04067bb0ef7cdb" "q-119043/selection/4f2437a610fd750684017fd0b43e7416ed56071cdaa539e32b72e840ee9ac1ee"] :db/ensure [:answer-field/validate]} {:db/id "q-119043" :question/id #uuid "75c31897-52bd-540c-a546-ce6303ed7371" :question/math-academy-id "q-119043" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+5=6{x}^{2}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6{x}^{2}-5.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (6{x}^{2}-5)\\text{d}x \\\\  & =6\\int {x}^{2}\\,\\text{d}x-5\\int \\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6(\\frac{{x}^{3}}{3})-5x+C \\\\  & =2{x}^{3}-5x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2{x}^{3}-5x+C)\\text{d}x \\\\ y & =2\\int {x}^{3}\\,\\text{d}x-5\\int x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =2(\\frac{{x}^{4}}{4})-5(\\frac{{x}^{2}}{2})+Cx+D \\\\  & =\\frac{{x}^{4}}{2}-\\frac{5{x}^{2}}{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119043/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119041/selection/1b1d5c13b4ef0f8b6a26f1c9969111b2ae4161e254c119483f930c18d1e2b804" :answer/id #uuid "341ae6c4-1c86-5ec2-b2af-0ede991b9440" :answer/type :answer.type/math :answer/value "y=2\\operatorname{cos}⁡2x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119041/selection/53f094fa725d655a4df2a2e90374bc65aeabe13dc9d3435f50058e01b1e0cee3" :answer/id #uuid "572afa50-c153-5c64-a089-521ae475a9cc" :answer/type :answer.type/math :answer/value "y=-\\operatorname{cos}⁡2x+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-119041/selection/05943a0603257544fc2743b1896564281a35cc7374fdc7c991985203e90f1ab2" :answer/id #uuid "fc74e732-0426-58ed-8b06-8d2337394f67" :answer/type :answer.type/math :answer/value "y=\\operatorname{sin}⁡2x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119041/selection/cdfd87017d02f446fc4067e67c301660262823b04afa9686d87abcffc906d125" :answer/id #uuid "c6f9b4b4-38ac-5987-89d5-ae02e4fb3121" :answer/type :answer.type/math :answer/value "y=-2\\operatorname{sin}⁡2x+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-119041/selection/73222bea3a8b0c33bb63380ecb28e4cd376cd5aa0c4ef82b19516f7ac92f905f" :answer/id #uuid "b1b9e3f6-fb70-5efc-8893-be9f6e3062bd" :answer/type :answer.type/math :answer/value "y=2\\operatorname{sin}⁡2x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119041/selection" :answer-field/id #uuid "6d519aa3-8736-5012-8052-19588bd5ca8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119041/selection/73222bea3a8b0c33bb63380ecb28e4cd376cd5aa0c4ef82b19516f7ac92f905f" :answer-field/choices ["q-119041/selection/1b1d5c13b4ef0f8b6a26f1c9969111b2ae4161e254c119483f930c18d1e2b804" "q-119041/selection/53f094fa725d655a4df2a2e90374bc65aeabe13dc9d3435f50058e01b1e0cee3" "q-119041/selection/05943a0603257544fc2743b1896564281a35cc7374fdc7c991985203e90f1ab2" "q-119041/selection/cdfd87017d02f446fc4067e67c301660262823b04afa9686d87abcffc906d125" "q-119041/selection/73222bea3a8b0c33bb63380ecb28e4cd376cd5aa0c4ef82b19516f7ac92f905f"] :db/ensure [:answer-field/validate]} {:db/id "q-119041" :question/id #uuid "c3f71093-8817-517a-8348-8c70d7a0bd9b" :question/math-academy-id "q-119041" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=-8\\operatorname{sin}⁡2x.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =-8\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-8(-\\frac{1}{2}\\operatorname{cos}⁡2x) \\\\  & =4\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (4\\operatorname{cos}⁡2x+C)\\text{d}x \\\\ y & =4\\int \\operatorname{cos}⁡2x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =4(\\frac{1}{2}\\operatorname{sin}⁡2x)+Cx+D \\\\  & =2\\operatorname{sin}⁡2x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119041/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119041"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-50139"] :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=-10.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =-10\\int \\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-10x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-10x+C)\\text{d}x \\\\ y & =-10\\cdot \\frac{{x}^{2}}{2}+Cx+D \\\\  & =-5{x}^{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-50146/selection/78dc282bbb91cb96179d344a5678ffb77fb064c07372fb3826c8cf068290aa85" :answer/id #uuid "32d3c70f-8bd8-5ce8-b6f6-f8e361f906a5" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{{x}^{3}}{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50146/selection/a113de00d027b9c33d2bdc80e074fc2bf200ec0818b835f6f958ece7ca0fb1f8" :answer/id #uuid "3b8ba3ba-6fed-5713-a29b-e5a693af1a4e" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{4}-\\frac{{x}^{3}}{6}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50146/selection/dc35df346962740b878ffc50fa53d680d7226452a0bafbfbafe1b1e1f1c2fe79" :answer/id #uuid "73a3e9fd-1914-52e9-a145-05bd26f2d97d" :answer/type :answer.type/math :answer/value "y={x}^{4}-\\frac{{x}^{3}}{3}+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-50146/selection/9773e6ee3f822ec4ffb9fd99d990ed15792510be97d0b67112013c4247c677fa" :answer/id #uuid "a0491e6f-f72a-552c-a54d-7b7411e89373" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{4}}{2}-\\frac{2{x}^{3}}{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50146/selection/6aefb77d9fe47553a95033d6e3d92e7536ae116dcd6c691725ca4326294703af" :answer/id #uuid "113c25f7-34d8-597a-9d18-6e2a6ffa7ace" :answer/type :answer.type/math :answer/value "y={x}^{4}-\\frac{2{x}^{3}}{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50146/selection" :answer-field/id #uuid "53fdc3f8-2079-5b4a-b8fc-969e00cb264d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50146/selection/9773e6ee3f822ec4ffb9fd99d990ed15792510be97d0b67112013c4247c677fa" :answer-field/choices ["q-50146/selection/78dc282bbb91cb96179d344a5678ffb77fb064c07372fb3826c8cf068290aa85" "q-50146/selection/a113de00d027b9c33d2bdc80e074fc2bf200ec0818b835f6f958ece7ca0fb1f8" "q-50146/selection/dc35df346962740b878ffc50fa53d680d7226452a0bafbfbafe1b1e1f1c2fe79" "q-50146/selection/9773e6ee3f822ec4ffb9fd99d990ed15792510be97d0b67112013c4247c677fa" "q-50146/selection/6aefb77d9fe47553a95033d6e3d92e7536ae116dcd6c691725ca4326294703af"] :db/ensure [:answer-field/validate]} {:db/id "q-50146" :question/id #uuid "a6ab78bb-c8ea-5de6-abd1-a27ba2080dba" :question/math-academy-id "q-50146" :question/problem "Solve the differential equation $x\\cdot \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6{x}^{3}-4{x}^{2}.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=6{x}^{2}-4x.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (6{x}^{2}-4x)\\,\\text{d}x \\\\  & =6\\int {x}^{2}\\,\\text{d}x-4\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6(\\frac{{x}^{3}}{3})-4(\\frac{{x}^{2}}{2})+C \\\\  & =2{x}^{3}-2{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2{x}^{3}-2{x}^{2}+C)\\,\\text{d}x \\\\ y & =2\\int {x}^{3}\\,\\text{d}x-2\\int {x}^{2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =2(\\frac{{x}^{4}}{4})-2(\\frac{{x}^{3}}{3})+Cx+D \\\\  & =\\frac{{x}^{4}}{2}-\\frac{2{x}^{3}}{3}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-50146/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-50146"] :db/ensure [:knowledge-point/validate]} {:db/id "q-50197/selection/b4b1d577e954887fd1c92f1b8822d6ff3cb4c8e24448ca86a92083740dae8c47" :answer/id #uuid "8f2d28d6-668f-51ed-bc6c-0fd102ab483a" :a