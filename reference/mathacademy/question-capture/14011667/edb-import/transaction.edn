01eb0866ecfceb7a48c418de5ab2ab6fca" "q-119142/selection/ee67958e6315a6f891f12be30d943ee84b4ce20c4883bca0d50f62aba431f592" "q-119142/selection/c9d2c490377c66623378257203f258f612caa1fc8d6beebd674f26bbdddf1bb4"] :db/ensure [:answer-field/validate]} {:db/id "q-119142" :question/id #uuid "a05048db-be50-5d0c-8e66-1eb6eda34260" :question/math-academy-id "q-119142" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{3(x-1)^{2}}{4}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-\\frac{3(x-1)^{2}}{4})\\,\\text{d}x \\\\ y & =-\\frac{3}{4}\\int (x-1)^{2}\\,\\text{d}x \\\\  & =-\\frac{3}{4}(\\frac{(x-1)^{3}}{3}) \\\\  & =-\\frac{(x-1)^{3}}{4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/e0ff2e64925dcd8bdf298c47815f6e2982fe6091e1ff5dea042f585c67ef1721.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119142/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-119142"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-50196"] :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-3(x+1)^{2}.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-3\\int (x+1)^{2}\\,\\text{d}x \\\\ y & =-3\\int (x+1)^{2}\\,\\text{d}x \\\\  & =-(x+1)^{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/03a5bf5134dc7d551b2602145c4c25081a2ad274f02c95845e5789b288e618a1.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-119083/selection/a0fc3676839d1d63a11d6bdfbc22a10a6ae1bf809497c021270d8ed5a23c561d" :answer/id #uuid "e3b0ce7b-fb84-5ecf-8423-8c307d36227a" :answer/type :answer.type/math :answer/value "y={x}^{2}+\\frac{{e}^{x/2}}{2}+\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-119083/selection/8c781ce4c9f3ff5fec98f4ed3dcb091d40a9d2fb073e2d988131212cc28298d3" :answer/id #uuid "1f553902-9e9a-5efe-b0e1-8d16f790d45c" :answer/type :answer.type/math :answer/value "y={x}^{2}+2{e}^{x/2}" :db/ensure [:answer/validate]} {:db/id "q-119083/selection/23433ceb0809823641d7ceb9c873ea119d005db4a7da6876a0b633d42788e802" :answer/id #uuid "cc1d25b9-f7e3-57a0-a200-c248abd2cb33" :answer/type :answer.type/math :answer/value "y={x}^{2}+2{e}^{x/2}+2" :db/ensure [:answer/validate]} {:db/id "q-119083/selection/e6d61955a40d3484a357a99eb3fe2b9cd4a0cd02057470e6054e09959998d377" :answer/id #uuid "e415321f-c23f-526c-833a-532d2d8ad940" :answer/type :answer.type/math :answer/value "y=x-\\frac{{e}^{x/2}}{2}+\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-119083/selection/5a29c0f11d7c51c6db5310d2b749475c5d3042eecd7d3e71ec6078ce7ed9c713" :answer/id #uuid "b6811527-a888-5f7d-9068-c826b2d11450" :answer/type :answer.type/math :answer/value "y=2x+{e}^{x/2}+1" :db/ensure [:answer/validate]} {:db/id "q-119083/selection" :answer-field/id #uuid "5bee9e7d-b007-5273-96a3-5b6ec18e2c42" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119083/selection/8c781ce4c9f3ff5fec98f4ed3dcb091d40a9d2fb073e2d988131212cc28298d3" :answer-field/choices ["q-119083/selection/a0fc3676839d1d63a11d6bdfbc22a10a6ae1bf809497c021270d8ed5a23c561d" "q-119083/selection/8c781ce4c9f3ff5fec98f4ed3dcb091d40a9d2fb073e2d988131212cc28298d3" "q-119083/selection/23433ceb0809823641d7ceb9c873ea119d005db4a7da6876a0b633d42788e802" "q-119083/selection/e6d61955a40d3484a357a99eb3fe2b9cd4a0cd02057470e6054e09959998d377" "q-119083/selection/5a29c0f11d7c51c6db5310d2b749475c5d3042eecd7d3e71ec6078ce7ed9c713"] :db/ensure [:answer-field/validate]} {:db/id "q-119083" :question/id #uuid "038b8c53-512a-5090-8c56-bdb0d2e76789" :question/math-academy-id "q-119083" :question/problem "Find the particular solution to the differential equation ${y}^{′}-2x={e}^{x/2}$ that satisfies the condition $y(0)=2.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=2x+{e}^{x/2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (2x+{e}^{x/2})\\text{d}x \\\\ y & =2\\int x\\,\\text{d}x+\\int {e}^{x/2}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+2{e}^{x/2}+C \\\\  & ={x}^{2}+2{e}^{x/2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y={x}^{2}+2{e}^{x/2}+C.$ To find a particular solution, we substitute the condition $y(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & ={0}^{2}+2{e}^{0}+C \\\\ 2 & =0+2(1)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny={x}^{2}+2{e}^{x/2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119083/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-119083"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352068/field-1/cc90a3d4fe98ac064e5b9dbb2861bb4c1d8699bbe72afce6360d8e22e13077f4" :answer/id #uuid "4a772853-58d2-56db-991e-ec65fe8d0aa9" :answer/type :answer.type/math :answer/value "8\\sqrt{x+1}-6" :db/ensure [:answer/validate]} {:db/id "q-352068/field-1" :answer-field/id #uuid "27fbb802-818f-528e-a38b-34520e907660" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352068/field-1/cc90a3d4fe98ac064e5b9dbb2861bb4c1d8699bbe72afce6360d8e22e13077f4" :answer-field/choices ["q-352068/field-1/cc90a3d4fe98ac064e5b9dbb2861bb4c1d8699bbe72afce6360d8e22e13077f4"] :db/ensure [:answer-field/validate]} {:db/id "q-352068" :question/id #uuid "c774207f-e833-51f4-b6a4-47a8e4f76e5c" :question/math-academy-id "q-352068" :question/problem "Find the particular solution to the differential equation $\\sqrt{x+1}\\,{y}^{′}=4$ that satisfies the condition $y(3)=10.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=\\frac{4}{\\sqrt{x+1}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int \\frac{4}{\\sqrt{x+1}}\\,\\text{d}x \\\\ y & =4\\int (x+1)^{-1/2}\\,\\text{d}x \\\\  & =4(2(x+1)^{1/2})+C \\\\  & =8\\sqrt{x+1}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=8\\sqrt{x+1}+C.$ To find a particular solution, we substitute the condition $y(3)=10$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}10 & =8\\sqrt{3+1}+C \\\\ 10 & =8(2)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=8\\sqrt{x+1}-6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-352068/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-352068"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8311/selection/c5ca68cbee123d01e154f818d8b788d0822de451218a4acb17dd030e90e9b433" :answer/id #uuid "c839da2e-4863-51c2-8d8f-686bcf43ef5d" :answer/type :answer.type/math :answer/value "y=-4x" :db/ensure [:answer/validate]} {:db/id "q-8311/selection/162100556374eceee000bc751d8bdc1ebe6e5f9373418df766066cd9a8f7eb4d" :answer/id #uuid "14d8f248-ae63-510e-b122-9cc55b03b498" :answer/type :answer.type/math :answer/value "y=-4" :db/ensure [:answer/validate]} {:db/id "q-8311/selection/390007a9f760f145638837f04011620524307c886c1cf6c466f08e26e30239cc" :answer/id #uuid "bc8ca706-8cc9-584d-af55-bd7b1a5d58e4" :answer/type :answer.type/math :answer/value "y=-2x-2" :db/ensure [:answer/validate]} {:db/id "q-8311/selection/2e12ba8925bf524503f2444b8e9ba58bc68b822391e7a93f8ae4a9f7c858f0bb" :answer/id #uuid "3c5d5149-c7c9-5986-b904-15c30d057288" :answer/type :answer.type/math :answer/value "y=4" :db/ensure [:answer/validate]} {:db/id "q-8311/selection/846ffaecd330594ce75799e69036c8ee0cbd235b524c9a5439d598b353bd9549" :answer/id #uuid "e5b1d254-8ff3-512c-baa4-107f102cdb2f" :answer/type :answer.type/math :answer/value "y=4{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-8311/selection" :answer-field/id #uuid "c776fff4-3270-5ba6-96b2-d459273f208a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8311/selection/c5ca68cbee123d01e154f818d8b788d0822de451218a4acb17dd030e90e9b433" :answer-field/choices ["q-8311/selection/c5ca68cbee123d01e154f818d8b788d0822de451218a4acb17dd030e90e9b433" "q-8311/selection/162100556374eceee000bc751d8bdc1ebe6e5f9373418df766066cd9a8f7eb4d" "q-8311/selection/390007a9f760f145638837f04011620524307c886c1cf6c466f08e26e30239cc" "q-8311/selection/2e12ba8925bf524503f2444b8e9ba58bc68b822391e7a93f8ae4a9f7c858f0bb" "q-8311/selection/846ffaecd330594ce75799e69036c8ee0cbd235b524c9a5439d598b353bd9549"] :db/ensure [:answer-field/validate]} {:db/id "q-8311" :question/id #uuid "0dcbbed7-1234-55a1-9c74-3ded079b3151" :question/math-academy-id "q-8311" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}+4=0$ given that $y(-1)=4.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4)\\,\\text{d}x \\\\ \\int \\,\\text{d}y & =\\int (-4)\\,\\text{d}x \\\\ y & =-4x+C\\,.\\end{aligned}\n$$\n\nSo our general solution is $y=-4x+C.$ To find a particular solution, we substitute the condition $y(-1)=4$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}4 & =-4\\cdot (-1)+C \\\\ 4 & =4+C \\\\ 0 & =C\\,.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-4x\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8311/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-8311"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119045/selection/172f527b15e9d6a43489cb632af5fef3d115de62d7ba64edadc4a3581b27b238" :answer/id #uuid "d14e0df1-3bb8-5197-b25c-bc87e8eef3d3" :answer/type :answer.type/math :answer/value "f(x)=2\\operatorname{sin}⁡x-3" :db/ensure [:answer/validate]} {:db/id "q-119045/selection/ccafe5e135531a000091cf45a540355b0a4d2817002f7e4a0a59d3ebd8a198d3" :answer/id #uuid "7cb0664d-836b-5d5d-aeb4-68ec1251deba" :answer/type :answer.type/math :answer/value "f(x)=-2\\operatorname{cos}⁡x+1" :db/ensure [:answer/validate]} {:db/id "q-119045/selection/dd02bafd612248bcfbed24f799d4675568c654dde6f9e9bbc0f0120fb2edd12b" :answer/id #uuid "73d0e6bb-117a-5547-ad15-e6a24ca686e8" :answer/type :answer.type/math :answer/value "f(x)=2\\operatorname{cos}⁡x-3" :db/ensure [:answer/validate]} {:db/id "q-119045/selection/a586e56c095259b0c3ed5c5f46666281c3b7b1d05ec7744b0711c3f36d62ecb9" :answer/id #uuid "b25c8c97-b577-5dfa-9d6d-9b976fd446bd" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{2}\\operatorname{sin}⁡x-1" :db/ensure [:answer/validate]} {:db/id "q-119045/selection/32a6042075f9b97cddbf9f96885d8f2c554045efba06d9d5c97867c4de2f835b" :answer/id #uuid "4f766d19-73fe-5c00-851c-def3a95b1697" :answer/type :answer.type/math :answer/value "f(x)=-2\\operatorname{sin}⁡x-1" :db/ensure [:answer/validate]} {:db/id "q-119045/selection" :answer-field/id #uuid "f9fb5778-ba1b-563c-934c-4d2eafdbb97b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119045/selection/32a6042075f9b97cddbf9f96885d8f2c554045efba06d9d5c97867c4de2f835b" :answer-field/choices ["q-119045/selection/172f527b15e9d6a43489cb632af5fef3d115de62d7ba64edadc4a3581b27b238" "q-119045/selection/ccafe5e135531a000091cf45a540355b0a4d2817002f7e4a0a59d3ebd8a198d3" "q-119045/selection/dd02bafd612248bcfbed24f799d4675568c654dde6f9e9bbc0f0120fb2edd12b" "q-119045/selection/a586e56c095259b0c3ed5c5f46666281c3b7b1d05ec7744b0711c3f36d62ecb9" "q-119045/selection/32a6042075f9b97cddbf9f96885d8f2c554045efba06d9d5c97867c4de2f835b"] :db/ensure [:answer-field/validate]} {:db/id "q-119045" :question/id #uuid "a18f6dbb-80c9-5e0a-b091-fdf4e8634a66" :question/math-academy-id "q-119045" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)+2\\operatorname{cos}⁡x=0$ that satisfies the condition $f(0)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=-2\\operatorname{cos}⁡x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-2\\operatorname{cos}⁡x)\\,\\text{d}x \\\\ f(x) & =-2\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-2\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-2\\operatorname{sin}⁡x+C.$ To find a particular solution, we substitute the condition $f(0)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =-2\\operatorname{sin}⁡0+C \\\\ -1 & =-2(0)+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=-2\\operatorname{sin}⁡x-1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119045/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-119045"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119046/selection/20601c666f3dc23438aae0188b02fa20d51a76df7c948b6482aba4f900184db1" :answer/id #uuid "f06eafbb-f26e-5dee-8e2e-3259ad93187f" :answer/type :answer.type/math :answer/value "f(x)={x}^{2}+2x-4" :db/ensure [:answer/validate]} {:db/id "q-119046/selection/17819da9b8594de7b3a0f8ddad98f3b6cc3e2ed82eff93fc9e5d95d8e8c4be54" :answer/id #uuid "bc26178d-66e1-5cb6-bb45-849d2d988af9" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}+3x-6" :db/ensure [:answer/validate]} {:db/id "q-119046/selection/99755105a74a0439706ccc08ab0bba28cf2294c6fa483b54d01bd07715b777dd" :answer/id #uuid "1fd2de54-1f98-5c77-af73-45b76afbcf8c" :answer/type :answer.type/math :answer/value "f(x)={x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "q-119046/selection/fe04533c85d54a2a2e92687fd5c4bf90af946416c3fa81ad6c308c7ed5640ceb" :answer/id #uuid "0ab54013-ab23-5f19-99d7-88e171fd9ad8" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}+x-4" :db/ensure [:answer/validate]} {:db/id "q-119046/selection/7aaa17801d65d1afdc4bced31d83c85ec4d45218f77305425a9a83d039cc6d58" :answer/id #uuid "c9c1a9f8-df13-59fa-b6f7-c083b9c7a619" :answer/type :answer.type/math :answer/value "f(x)=2{x}^{2}+x-1" :db/ensure [:answer/validate]} {:db/id "q-119046/selection" :answer-field/id #uuid "1b32a5a9-2cdb-5a34-962d-d790d2f978b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119046/selection/fe04533c85d54a2a2e92687fd5c4bf90af946416c3fa81ad6c308c7ed5640ceb" :answer-field/choices ["q-119046/selection/20601c666f3dc23438aae0188b02fa20d51a76df7c948b6482aba4f900184db1" "q-119046/selection/17819da9b8594de7b3a0f8ddad98f3b6cc3e2ed82eff93fc9e5d95d8e8c4be54" "q-119046/selection/99755105a74a0439706ccc08ab0bba28cf2294c6fa483b54d01bd07715b777dd" "q-119046/selection/fe04533c85d54a2a2e92687fd5c4bf90af946416c3fa81ad6c308c7ed5640ceb" "q-119046/selection/7aaa17801d65d1afdc4bced31d83c85ec4d45218f77305425a9a83d039cc6d58"] :db/ensure [:answer-field/validate]} {:db/id "q-119046" :question/id #uuid "3b51e635-ecb6-5289-b3c9-ec6e11e4a7b8" :question/math-academy-id "q-119046" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)-4x=1$ that satisfies the condition $f(1)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=4x+1.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x+1)\\,\\text{d}x \\\\ f(x) & =4\\int x\\,\\text{d}x+\\int \\text{d}x \\\\  & =4(\\frac{1}{2}{x}^{2})+x+C \\\\  & =2{x}^{2}+x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=2{x}^{2}+x+C.$ To find a particular solution, we substitute the condition $f(1)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =2(1)^{2}+1+C \\\\ -1 & =2+1+C \\\\ C & =-4.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=2{x}^{2}+x-4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825"] :knowledge-point/questions ["q-119046"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-528"] :question/problem "Find the general solution to the differential equation $f'(x) - 3\\sin(2x) = 0.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\nf'(x) = 3\\sin{2x}.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int 3\\operatorname{sin}⁡2x\\,\\text{d}x \\\\ f(x) & =3\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-529"] :question/problem "Solve the differential equation\n\n$$\n\\dfrac{\\textrm d^2 y}{\\textrm d x^2} = x.\n$$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2}{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\frac{1}{2}{x}^{2}+C)\\,\\text{d}x \\\\ y & =\\frac{1}{6}{x}^{3}+Cx+D\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$ We cannot combine them, because $C$ is being multiplied by $x$ while $D$ is not." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-530"] :question/problem "Solve the differential equation $y'  = 2x,$ and sketch the solution curves of this equation." :question/worked-solution "Integrating the equation, we get\n\n$$\ny = x^2+C.\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14011667/assets/e37771799ef5fadc259e6ea0073042a83e0974b5a2619d1af3e87a7467e6d780.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-531"] :question/problem "Find the particular solution to the differential equation below that satisfies the condition $f(0)=2.$\n\n$$\nf'(x) - \\dfrac{3}{1+x^2} = 0\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\nf'(x) = \\dfrac{3}{1+x^2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{1+{x}^{2}}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =3\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x) = 3\\arctan{x} + C.$ To find a particular solution, we substitute the condition $f(0) = 2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}f(x) & =3\\operatorname{arctan}⁡(x)+C \\\\ 2 & =3\\operatorname{arctan}⁡(0)+C \\\\ 2 & =0+C \\\\ C & =2.\\end{aligned}\n$$\n\nTherefore, our particular solution is \n\n$$\nf(x)=3\\arctan x + 2.\n$$" :db/ensure [:question/validate]}]
