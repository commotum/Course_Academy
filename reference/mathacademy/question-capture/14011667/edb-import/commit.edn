-2cdb-5a34-962d-d790d2f978b0" 13194139534466 true] [17592186289797 1034 "f(x)=2{x}^{2}+3x-6" 13194139534466 true] [17592186289797 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289797 1111 #uuid "bc26178d-66e1-5cb6-bb45-849d2d988af9" 13194139534466 true] [17592186289798 1034 "f(x)={x}^{2}+2x-4" 13194139534466 true] [17592186289798 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289798 1111 #uuid "f06eafbb-f26e-5dee-8e2e-3259ad93187f" 13194139534466 true] [17592186289799 1034 "f(x)=2{x}^{2}+x-1" 13194139534466 true] [17592186289799 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289799 1111 #uuid "c9c1a9f8-df13-59fa-b6f7-c083b9c7a619" 13194139534466 true] [17592186289800 1034 "f(x)={x}^{2}-2x" 13194139534466 true] [17592186289800 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289800 1111 #uuid "1fd2de54-1f98-5c77-af73-45b76afbcf8c" 13194139534466 true] [17592186289801 1034 "f(x)=2{x}^{2}+x-4" 13194139534466 true] [17592186289801 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289801 1111 #uuid "0ab54013-ab23-5f19-99d7-88e171fd9ad8" 13194139534466 true] [17592186289802 1017 #edb/ref 17592186289803 13194139534466 true] [17592186289802 1089 "q-119083" 13194139534466 true] [17592186289802 1091 #edb/ref 17592186045465 13194139534466 true] [17592186289802 1100 "Find the particular solution to the differential equation ${y}^{′}-2x={e}^{x/2}$ that satisfies the condition $y(0)=2.$" 13194139534466 true] [17592186289802 1113 #uuid "038b8c53-512a-5090-8c56-bdb0d2e76789" 13194139534466 true] [17592186289802 1145 "First, we rearrange the equation to give\n\n$$\n{y}^{′}=2x+{e}^{x/2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (2x+{e}^{x/2})\\text{d}x \\\\ y & =2\\int x\\,\\text{d}x+\\int {e}^{x/2}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+2{e}^{x/2}+C \\\\  & ={x}^{2}+2{e}^{x/2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y={x}^{2}+2{e}^{x/2}+C.$ To find a particular solution, we substitute the condition $y(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & ={0}^{2}+2{e}^{0}+C \\\\ 2 & =0+2(1)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny={x}^{2}+2{e}^{x/2}.\n$$" 13194139534466 true] [17592186289803 1000 #edb/ref 17592186289804 13194139534466 true] [17592186289803 1000 #edb/ref 17592186289805 13194139534466 true] [17592186289803 1000 #edb/ref 17592186289806 13194139534466 true] [17592186289803 1000 #edb/ref 17592186289807 13194139534466 true] [17592186289803 1000 #edb/ref 17592186289808 13194139534466 true] [17592186289803 1040 #edb/ref 17592186045450 13194139534466 true] [17592186289803 1041 "selection" 13194139534466 true] [17592186289803 1104 #edb/ref 17592186289806 13194139534466 true] [17592186289803 1110 #uuid "5bee9e7d-b007-5273-96a3-5b6ec18e2c42" 13194139534466 true] [17592186289804 1034 "y={x}^{2}+2{e}^{x/2}+2" 13194139534466 true] [17592186289804 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289804 1111 #uuid "cc1d25b9-f7e3-57a0-a200-c248abd2cb33" 13194139534466 true] [17592186289805 1034 "y=2x+{e}^{x/2}+1" 13194139534466 true] [17592186289805 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289805 1111 #uuid "b6811527-a888-5f7d-9068-c826b2d11450" 13194139534466 true] [17592186289806 1034 "y={x}^{2}+2{e}^{x/2}" 13194139534466 true] [17592186289806 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289806 1111 #uuid "1f553902-9e9a-5efe-b0e1-8d16f790d45c" 13194139534466 true] [17592186289807 1034 "y={x}^{2}+\\frac{{e}^{x/2}}{2}+\\frac{3}{2}" 13194139534466 true] [17592186289807 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289807 1111 #uuid "e3b0ce7b-fb84-5ecf-8423-8c307d36227a" 13194139534466 true] [17592186289808 1034 "y=x-\\frac{{e}^{x/2}}{2}+\\frac{5}{2}" 13194139534466 true] [17592186289808 1103 #edb/ref 17592186045453 13194139534466 true] [17592186289808 111