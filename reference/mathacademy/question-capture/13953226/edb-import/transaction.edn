g}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+{2}^{2}} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nSince $z$ lies in the second quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\frac{1}{2})| \\\\  & ≈2.678.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{5}$ and $\\theta =2.678$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{5}\\,{\\text{e}}^{2.678\\,\\text{i}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17521/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff"] :knowledge-point/questions ["q-17521"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17523/selection/767657826fc30e962815bf720c8f1f29b70a35c6667d7a87daacf0a8b6bd2d06" :answer/id #uuid "aaa51c64-ec76-5069-8aa8-70ab4a996d77" :answer/type :answer.type/math :answer/value "z=3\\sqrt{3}\\,{\\text{e}}^{\\pi \\text{i}/2}" :db/ensure [:answer/validate]} {:db/id "q-17523/selection/c509ea38272aebdc5e03cb990e1be0623e984c56c9c9f5292e9a2f492187f629" :answer/id #uuid "e3b7df6a-1745-5274-892f-3ed28913d5e0" :answer/type :answer.type/math :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/2}" :db/ensure [:answer/validate]} {:db/id "q-17523/selection/8b5cfb6b6db9f64b6a3a7a451ea70551ae82a710b375ba50f670362fe5c3787d" :answer/id #uuid "2f572805-2e17-5000-b52c-9cbc56ef2476" :answer/type :answer.type/math :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/ensure [:answer/validate]} {:db/id "q-17523/selection/e58fc84c64a94eaa2ee2d04c3d1d9cc425350032fe8dd671ff17b954ce5f07e2" :answer/id #uuid "59576f99-c7e2-5c45-a386-3535945a48e4" :answer/type :answer.type/math :answer/value "z=5\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/ensure [:answer/validate]} {:db/id "q-17523/selection/d50395d544a83dd2540095f22424a7264ee1dd6f1e13e48b9ea3bc89d8af8354" :answer/id #uuid "c4312907-9b06-51a0-8298-475a6b0a3e26" :answer/type :answer.type/math :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/ensure [:answer/validate]} {:db/id "q-17523/selection" :answer-field/id #uuid "f30eda78-02c2-5957-a436-8bcb280f7bf3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17523/selection/8b5cfb6b6db9f64b6a3a7a451ea70551ae82a710b375ba50f670362fe5c3787d" :answer-field/choices ["q-17523/selection/767657826fc30e962815bf720c8f1f29b70a35c6667d7a87daacf0a8b6bd2d06" "q-17523/selection/c509ea38272aebdc5e03cb990e1be0623e984c56c9c9f5292e9a2f492187f629" "q-17523/selection/8b5cfb6b6db9f64b6a3a7a451ea70551ae82a710b375ba50f670362fe5c3787d" "q-17523/selection/e58fc84c64a94eaa2ee2d04c3d1d9cc425350032fe8dd671ff17b954ce5f07e2" "q-17523/selection/d50395d544a83dd2540095f22424a7264ee1dd6f1e13e48b9ea3bc89d8af8354"] :db/ensure [:answer-field/validate]} {:db/id "q-17523" :question/id #uuid "f23dfcc9-b6fc-590c-98c4-5afd18cc88c5" :question/math-academy-id "q-17523" :question/problem "Write the complex number $z=-3-3\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-3)^{2}} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-3}{-3})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(1)| \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=3\\sqrt{2}$ and $\\theta =\\frac{5\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=3\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17523/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff"] :knowledge-point/questions ["q-17523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8076/selection/669abbeb8e53ce119a94e0b9c3b16b732a19d9851fd0485ce2af3486e10eea0e" :answer/id #uuid "6b55a12f-e52a-5d98-84d6-20878083f7be" :answer/type :answer.type/math :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-8076/selection/5411b8d79ec4a1a31be2c858f0fb25b735d853bcd614b7e8a01d43abc67e8413" :answer/id #uuid "6c49e3d4-1141-5e86-9dc0-07a769f8d693" :answer/type :answer.type/math :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-8076/selection/fa7cfea217424f8b1c9d43e71a875f3eddbc32e78a44ebe1c12551f767b99931" :answer/id #uuid "f92c6ec2-5174-5770-b4fe-0716b26824e1" :answer/type :answer.type/math :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-8076/selection/aa193fc06fab963eb7fca871586740400c30bf1dd904c1bf3227dc1bbab44037" :answer/id #uuid "32aa2e4b-9f77-5cb7-8958-e69543136db6" :answer/type :answer.type/math :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{4.989\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-8076/selection/f9ff9232a865fb36093ca8fc10257f8ca416bfa4ca35cfc25775124cbb513583" :answer/id #uuid "4c394217-aa5e-5f73-8b5a-b6cc3654b8ac" :answer/type :answer.type/math :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-8076/selection" :answer-field/id #uuid "e293d670-8dd1-5590-974c-860db0453b5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8076/selection/5411b8d79ec4a1a31be2c858f0fb25b735d853bcd614b7e8a01d43abc67e8413" :answer-field/choices ["q-8076/selection/669abbeb8e53ce119a94e0b9c3b16b732a19d9851fd0485ce2af3486e10eea0e" "q-8076/selection/5411b8d79ec4a1a31be2c858f0fb25b735d853bcd614b7e8a01d43abc67e8413" "q-8076/selection/fa7cfea217424f8b1c9d43e71a875f3eddbc32e78a44ebe1c12551f767b99931" "q-8076/selection/aa193fc06fab963eb7fca871586740400c30bf1dd904c1bf3227dc1bbab44037" "q-8076/selection/f9ff9232a865fb36093ca8fc10257f8ca416bfa4ca35cfc25775124cbb513583"] :db/ensure [:answer-field/validate]} {:db/id "q-8076" :question/id #uuid "de095b2a-fbb0-51f2-b405-5336c443d2b4" :question/math-academy-id "q-8076" :question/problem "Write the complex number $z=5-\\text{i}$ in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to $3$ decimal places." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{5}^{2}+(-1)^{2}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(\\frac{-1}{5})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{1}{5})| \\\\  & ≈2\\pi -0.197\\,39… \\\\  & ≈6.086.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{26}$ and $\\theta =6.086$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8076/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff"] :knowledge-point/questions ["q-8076"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71981/selection/66f93fb75f5f9d1685a48f650f7f1b24863db6b345fd9ae0628f30c8f80c2e09" :answer/id #uuid "be0ae716-72fc-5a6c-8368-4065f6f09a15" :answer/type :answer.type/math :answe