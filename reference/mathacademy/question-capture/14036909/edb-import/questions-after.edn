#{[{:db/id #edb/ref 17592186295336 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/title "More Complex Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53bd91de-4eca-5a38-a382-b6ff340ad68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C" :db/id #edb/ref 17592186295338} {:answer/id #uuid "69c97d5b-039a-5b14-b7fc-546d1a6b37c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/id #edb/ref 17592186295339} {:answer/id #uuid "0badacbd-52bd-576f-9682-0ce41e5879db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2{e}^{2x}}+C" :db/id #edb/ref 17592186295340} {:answer/id #uuid "9a27c717-841b-5426-9bdc-8ed55e15c3fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{4}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "5818ad73-695c-59a9-99d2-32d88e7c0b6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/id #edb/ref 17592186295342}] :answer-field/correct {:answer/id #uuid "53bd91de-4eca-5a38-a382-b6ff340ad68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C" :db/id #edb/ref 17592186295338} :answer-field/id #uuid "d04580a8-0497-5115-8eff-e675387c84f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295337}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5f23ffa8-d0a8-52a4-a9f1-7e4b93545877" :question/math-academy-id "q-113873" :question/problem "Calculate the integral$\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={e}^{2x}-2x.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2{e}^{2x}-2=2({e}^{2x}-1)\\,⟹\\,\\frac{1}{2}\\text{d}u=({e}^{2x}-1)\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}-2x}\\cdot ({e}^{2x}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184414 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfecd05a-3957-59a2-8cda-64c8248a27b3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186180934} {:answer/id #uuid "e446e318-7c4d-517c-98fb-01ebff5d5f60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186180935} {:answer/id #uuid "12820d17-38e6-5d83-b01d-28634bb9534d" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3" :db/id #edb/ref 17592186180936} {:answer/id #uuid "308a5d20-73a9-5769-91cb-a1d5566f4a8f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186180937} {:answer/id #uuid "675b4522-3ffc-5093-b21e-00bdebe34495" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln 3" :db/id #edb/ref 17592186180938}] :answer-field/correct {:answer/id #uuid "308a5d20-73a9-5769-91cb-a1d5566f4a8f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186180937} :answer-field/id #uuid "6e36e3af-b8ae-5ab5-9ca6-29f228981010" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180933}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8b4cba33-ddfb-53fe-af87-4270187c1909" :question/math-academy-id "q-13751" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295343 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55634fbf-df15-574d-8322-e3197431fa7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295345} {:answer/id #uuid "0c4339f2-3346-5cea-ac72-04de755e9b6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295346} {:answer/id #uuid "dace85ee-6218-573f-af7e-77557008b168" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2}+C" :db/id #edb/ref 17592186295347} {:answer/id #uuid "2c68e913-b8cc-5e1c-bb89-44ef0728ff31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x-7}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295348} {:answer/id #uuid "457948df-3e9d-52d4-a070-40f2119f263d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295349}] :answer-field/correct {:answer/id #uuid "457948df-3e9d-52d4-a070-40f2119f263d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295349} :answer-field/id #uuid "e8158113-f2f4-56c0-9468-dc52d6963b4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295344}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5850fd72-c77e-5e13-8321-0cb0f89e7944" :question/math-academy-id "q-31419" :question/problem "Calculate the integral $\\int x{4}^{{x}^{2}-7}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{4}^{{x}^{2}-7}\\,\\text{d}x & =\\int {4}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295350 :knowledge-point/_questions [{:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4650bfd0-5fae-5a0a-aa31-d40db246d261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186295352}] :answer-field/correct {:answer/id #uuid "4650bfd0-5fae-5a0a-aa31-d40db246d261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186295352} :answer-field/id #uuid "387d027e-846e-512e-86a1-d903d71d9c4c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295351}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bbfd357b-9f0a-5066-8e6a-186afc8d1092" :question/math-academy-id "q-350740" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}+\\operatorname{ln}⁡2.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡2}$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡2$ | $4\\operatorname{ln}⁡2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}{e}^{u}\\,{|}_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{6}({e}^{4\\operatorname{ln}⁡2}-{e}^{\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{6}(16-2) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295353 :knowledge-point/_questions [{:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/title "Integrating Products Containing Other Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c682e32-46cd-58cc-a74a-2f605927b517" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\cdot {7}^{{x}^{2}-7}}{\\operatorname{ln}⁡7}+C" :db/id #edb/ref 17592186295355} {:answer/id #uuid "a5e18501-6770-5297-81ed-a63a885e75ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C" :db/id #edb/ref 17592186295356} {:answer/id #uuid "da68df04-6af9-55eb-b21f-3aa5c97332ae" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{{x}^{2}-7}+C" :db/id #edb/ref 17592186295357} {:answer/id #uuid "2b5c5326-2ee2-59fc-a3c7-d4c1bb958f0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2}+C" :db/id #edb/ref 17592186295358} {:answer/id #uuid "049b196d-3840-576f-b858-35f8550532e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}\\operatorname{ln}⁡7}{2}+C" :db/id #edb/ref 17592186295359}] :answer-field/correct {:answer/id #uuid "a5e18501-6770-5297-81ed-a63a885e75ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C" :db/id #edb/ref 17592186295356} :answer-field/id #uuid "4ef624e7-d811-558f-8f24-203435985976" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295354}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9f4889fd-f600-5c4d-a014-13ded0431d92" :question/math-academy-id "q-73802" :question/problem "Calculate the integral $\\int x{7}^{{x}^{2}-7}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{7}^{{x}^{2}-7}\\,\\text{d}x & =\\int {7}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {7}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {7}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{7}^{u}}{\\operatorname{ln}⁡7}+C \\\\  & =\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C.\\end{aligned}\n$$"}]}
