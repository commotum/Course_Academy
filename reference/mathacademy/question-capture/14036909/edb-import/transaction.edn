[{:db/id [:question/math-academy-id "q-13751"] :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-31419/selection/5eb7aba3d9e474ed811e7aced5fdb086fb09db6a0bf1ecc855549c2d27b76c9c" :answer/id #uuid "55634fbf-df15-574d-8322-e3197431fa7c" :answer/type :answer.type/math :answer/value "\\frac{{4}^{{x}^{2}-7}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31419/selection/b453d4579af73a86ba13a640b0f38abe558236b4a1aac94750be9502240e2ef7" :answer/id #uuid "457948df-3e9d-52d4-a070-40f2119f263d" :answer/type :answer.type/math :answer/value "\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31419/selection/a5b51820c7e9ce6e3ebc694d0fd42ecbd5c282b861c101075190fa9cd241de83" :answer/id #uuid "2c68e913-b8cc-5e1c-bb89-44ef0728ff31" :answer/type :answer.type/math :answer/value "\\frac{{4}^{x-7}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31419/selection/8eef56b4b08e81e32b0cc8ecda61637672dbe86d0b18bc4a8740e6fa5b91d925" :answer/id #uuid "0c4339f2-3346-5cea-ac72-04de755e9b6c" :answer/type :answer.type/math :answer/value "\\frac{{4}^{x}}{2\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31419/selection/a373f5fb432bf188cb656a98017b60a701adb1180bbc0bb88c988dda3b3662f7" :answer/id #uuid "dace85ee-6218-573f-af7e-77557008b168" :answer/type :answer.type/math :answer/value "\\frac{{4}^{{x}^{2}-7}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31419/selection" :answer-field/id #uuid "e8158113-f2f4-56c0-9468-dc52d6963b4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31419/selection/b453d4579af73a86ba13a640b0f38abe558236b4a1aac94750be9502240e2ef7" :answer-field/choices ["q-31419/selection/5eb7aba3d9e474ed811e7aced5fdb086fb09db6a0bf1ecc855549c2d27b76c9c" "q-31419/selection/b453d4579af73a86ba13a640b0f38abe558236b4a1aac94750be9502240e2ef7" "q-31419/selection/a5b51820c7e9ce6e3ebc694d0fd42ecbd5c282b861c101075190fa9cd241de83" "q-31419/selection/8eef56b4b08e81e32b0cc8ecda61637672dbe86d0b18bc4a8740e6fa5b91d925" "q-31419/selection/a373f5fb432bf188cb656a98017b60a701adb1180bbc0bb88c988dda3b3662f7"] :db/ensure [:answer-field/validate]} {:db/id "q-31419" :question/id #uuid "5850fd72-c77e-5e13-8321-0cb0f89e7944" :question/math-academy-id "q-31419" :question/problem "Calculate the integral $\\int x{4}^{{x}^{2}-7}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{4}^{{x}^{2}-7}\\,\\text{d}x & =\\int {4}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31419/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513"] :knowledge-point/questions ["q-31419"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73802/selection/3bf0a090f6b74f38105d0bf156d6867206efad2b507d3927089d79b2ffb0865b" :answer/id #uuid "0c682e32-46cd-58cc-a74a-2f605927b517" :answer/type :answer.type/math :answer/value "\\frac{2\\cdot {7}^{{x}^{2}-7}}{\\operatorname{ln}⁡7}+C" :db/ensure [:answer/validate]} {:db/id "q-73802/selection/5c06f3c090ae01c508f2ce36332b392e685adf35f5a69794537fb07e03dc771d" :answer/id #uuid "a5e18501-6770-5297-81ed-a63a885e75ba" :answer/type :answer.type/math :answer/value "\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C" :db/ensure [:answer/validate]} {:db/id "q-73802/selection/83671c682a1d7a00534dde1ff8a31b0c93a7b5f92378c03fc0cb5e7ca99a3a5b" :answer/id #uuid "da68df04-6af9-55eb-b21f-3aa5c97332ae" :answer/type :answer.type/math :answer/value "{7}^{{x}^{2}-7}+C" :db/ensure [:answer/validate]} {:db/id "q-73802/selection/9e4de7b4d8c3e62f2222a779b07ee33da4720dea50f291c9028e53e93aa32751" :answer/id #uuid "049b196d-3840-576f-b858-35f8550532e1" :answer/type :answer.type/math :answer/value "\\frac{{7}^{{x}^{2}-7}\\operatorname{ln}⁡7}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-73802/selection/9614dad8c7740ad22144b29722fe31d286fa741f595315b12313ecd0c98e9f6d" :answer/id #uuid "2b5c5326-2ee2-59fc-a3c7-d4c1bb958f0e" :answer/type :answer.type/math :answer/value "\\frac{{7}^{{x}^{2}-7}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-73802/selection" :answer-field/id #uuid "4ef624e7-d811-558f-8f24-203435985976" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73802/selection/5c06f3c090ae01c508f2ce36332b392e685adf35f5a69794537fb07e03dc771d" :answer-field/choices ["q-73802/selection/3bf0a090f6b74f38105d0bf156d6867206efad2b507d3927089d79b2ffb0865b" "q-73802/selection/5c06f3c090ae01c508f2ce36332b392e685adf35f5a69794537fb07e03dc771d" "q-73802/selection/83671c682a1d7a00534dde1ff8a31b0c93a7b5f92378c03fc0cb5e7ca99a3a5b" "q-73802/selection/9e4de7b4d8c3e62f2222a779b07ee33da4720dea50f291c9028e53e93aa32751" "q-73802/selection/9614dad8c7740ad22144b29722fe31d286fa741f595315b12313ecd0c98e9f6d"] :db/ensure [:answer-field/validate]} {:db/id "q-73802" :question/id #uuid "9f4889fd-f600-5c4d-a014-13ded0431d92" :question/math-academy-id "q-73802" :question/problem "Calculate the integral $\\int x{7}^{{x}^{2}-7}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{7}^{{x}^{2}-7}\\,\\text{d}x & =\\int {7}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {7}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {7}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{7}^{u}}{\\operatorname{ln}⁡7}+C \\\\  & =\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73802/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513"] :knowledge-point/questions ["q-73802"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113873/selection/d37b411e4f0d98273e830014c005c7408565c41b24b3a85936aa34fe6abfc8f3" :answer/id #uuid "5818ad73-695c-59a9-99d2-32d88e7c0b6c" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/ensure [:answer/validate]} {:db/id "q-113873/selection/b2597e7b64e871de5a69c7bdbf9fc2b3dc8f444832a4fd426bffd9a0b83606f4" :answer/id #uuid "0badacbd-52bd-576f-9682-0ce41e5879db" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2{e}^{2x}}+C" :db/ensure [:answer/validate]} {:db/id "q-113873/selection/3c5ce4d32373c41712163df4856df336e6c2957aa4617ad19d79bb258df67c83" :answer/id #uuid "53bd91de-4eca-5a38-a382-b6ff340ad68c" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113873/selection/69147bb656d438ae35ec4a17b29f3a636ba5359f87ca06093fde724d7ace142c" :answer/id #uuid "69c97d5b-039a-5b14-b7fc-546d1a6b37c4" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/ensure [:answer/validate]} {:db/id "q-113873/selection/c346a61f055d4ad32ce7a8047f135c716b8cd0ba9fcc6cfc2c9e74868dbabd82" :answer/id #uuid "9a27c717-841b-5426-9bdc-8ed55e15c3fc" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-113873/selection" :answer-field/id #uuid "d04580a8-0497-5115-8eff-e675387c84f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113873/selection/3c5ce4d32373c41712163df4856df336e6c2957aa4617ad19d79bb258df67c83" :answer-field/choices ["q-113873/selection/d37b411e4f0d98273e830014c005c7408565c41b24b3a85936aa34fe6abfc8f3" "q-113873/selection/b2597e7b64e871de5a69c7bdbf9fc2b3dc8f444832a4fd426bffd9a0b83606f4" "q-113873/selection/3c5ce4d32373c41712163df4856df336e6c2957aa4617ad19d79bb258df67c83" "q-113873/selection/69147bb656d438ae35ec4a17b29f3a636ba5359f87ca06093fde724d7ace142c" "q-113873/selection/c346a61f055d4ad32ce7a8047f135c716b8cd0ba9fcc6cfc2c9e74868dbabd82"] :db/ensure [:answer-field/validate]} {:db/id "q-113873" :question/id #uuid "5f23ffa8-d0a8-52a4-a9f1-7e4b93545877" :question/math-academy-id "q-113873" :question/problem "Calculate the integral$\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={e}^{2x}-2x.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2{e}^{2x}-2=2({e}^{2x}-1)\\,⟹\\,\\frac{1}{2}\\text{d}u=({e}^{2x}-1)\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}-2x}\\cdot ({e}^{2x}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113873/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3"] :knowledge-point/questions ["q-113873"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350740/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "4650bfd0-5fae-5a0a-aa31-d40db246d261" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-350740/field-1" :answer-field/id #uuid "387d027e-846e-512e-86a1-d903d71d9c4c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350740/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer-field/choices ["q-350740/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3"] :db/ensure [:answer-field/validate]} {:db/id "q-350740" :question/id #uuid "bbfd357b-9f0a-5066-8e6a-186afc8d1092" :question/math-academy-id "q-350740" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}+\\operatorname{ln}⁡2.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡2}$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡2$ | $4\\operatorname{ln}⁡2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}{e}^{u}\\,{|}_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{6}({e}^{4\\operatorname{ln}⁡2}-{e}^{\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{6}(16-2) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-350740/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5"] :knowledge-point/questions ["q-350740"] :db/ensure [:knowledge-point/validate]}]
