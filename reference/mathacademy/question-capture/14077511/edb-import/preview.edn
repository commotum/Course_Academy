c{dy}{dx} & =\\frac{2\\operatorname{cos}⁡0}{({0}^{3}+3\\cdot {0}^{2}-1){e}^{0}} \\\\  & =\\frac{2(1)}{(-1)\\cdot 1} \\\\  & =-2\\,.\\end{aligned}\n$$" 13194139536118 true] [17592186384436 1000 #edb/ref 17592186384437 13194139536118 true] [17592186384436 1000 #edb/ref 17592186384438 13194139536118 true] [17592186384436 1000 #edb/ref 17592186384439 13194139536118 true] [17592186384436 1000 #edb/ref 17592186384440 13194139536118 true] [17592186384436 1000 #edb/ref 17592186384441 13194139536118 true] [17592186384436 1040 #edb/ref 17592186045450 13194139536118 true] [17592186384436 1041 "selection" 13194139536118 true] [17592186384436 1104 #edb/ref 17592186384440 13194139536118 true] [17592186384436 1110 #uuid "6e1bc926-23da-52c0-ab31-2a7bc185cbe5" 13194139536118 true] [17592186384437 1034 "-\\,\\frac{1}{2}" 13194139536118 true] [17592186384437 1103 #edb/ref 17592186045453 13194139536118 true] [17592186384437 1111 #uuid "6af43bb8-304b-555c-8837-3a555d3102f0" 13194139536118 true] [17592186384438 1034 "-\\,\\frac{1}{2e}" 13194139536118 true] [17592186384438 1103 #edb/ref 17592186045453 13194139536118 true] [17592186384438 1111 #uuid "c4f2e2fa-6c8b-54c1-8637-42aaea152b46" 13194139536118 true] [17592186384439 1034 "-\\,\\frac{e}{2}" 13194139536118 true] [17592186384439 1103 #edb/ref 17592186045453 13194139536118 true] [17592186384439 1111 #uuid "d40e9b67-9257-5078-ab06-3a3c549e5c64" 13194139536118 true] [17592186384440 1034 "-2" 13194139536118 true] [17592186384440 1103 #edb/ref 17592186045453 13194139536118 true] [17592186384440 1111 #uuid "5bd0872e-e79a-54be-b6b9-64551ef91d8d" 13194139536118 true] [17592186384441 1034 "-\\,\\frac{1}{3e}" 13194139536118 true] [17592186384441 1103 #edb/ref 17592186045453 13194139536118 true] [17592186384441 1111 #uuid "fb48ffe7-49a9-57a8-811b-31c6ac3a78f6" 13194139536118 true] [17592186384442 1017 #edb/ref 17592186384443 13194139536118 true] [17592186384442 1089 "q-6848" 13194139536118 true] [17592186384442 1091 #edb/ref 17592186045463 13194