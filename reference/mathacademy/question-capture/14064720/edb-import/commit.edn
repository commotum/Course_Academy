^{2(0)}+{C}_{1},\\,(0)^{3}+(0)^{2}+{C}_{2}⟩ \\\\ ⟨1,2⟩ & =⟨1+{C}_{1},\\,{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=2.$ Therefore, the position vector at time $t$ is given by\n\n$$\nr(t)=⟨{e}^{2t},\\,{t}^{3}+{t}^{2}+2⟩.\n$$\n\nTo find the position vector at time $t=1,$ we substitute $t=1$ into the above, and we get\n\n$$\n\\begin{aligned}r(1) & =⟨{e}^{2(1)},\\,(1)^{3}+(1)^{2}+2⟩ \\\\  & =⟨{e}^{2},\\,4⟩.\\end{aligned}\n$$" 13194139535436 true] [17592186349129 1000 #edb/ref 17592186349130 13194139535436 true] [17592186349129 1000 #edb/ref 17592186349131 13194139535436 true] [17592186349129 1000 #edb/ref 17592186349132 13194139535436 true] [17592186349129 1000 #edb/ref 17592186349133 13194139535436 true] [17592186349129 1000 #edb/ref 17592186349134 13194139535436 true] [17592186349129 1040 #edb/ref 17592186045450 13194139535436 true] [17592186349129 1041 "selection" 13194139535436 true] [17592186349129 1104 #edb/ref 17592186349133 13194139535436 true] [17592186349129 1110 #uuid "05ca983e-e8a9-50b2-bf4f-353d14efeaf7" 13194139535436 true] [17592186349130 1034 "r(1)=⟨{e}^{2},\\,5⟩" 13194139535436 true] [17592186349130 1103 #edb/ref 17592186045453 13194139535436 true] [17592186349130 1111 #uuid "05ef279f-cf3f-50b6-a4d3-6c27875232dd" 13194139535436 true] [17592186349131 1034 "r(1)=⟨2{e}^{2},\\,5⟩" 13194139535436 true] [17592186349131 1103 #edb/ref 17592186045453 13194139535436 true] [17592186349131 1111 #uuid "5c7a51f6-688c-50dc-b86d-15a423241d4c" 13194139535436 true] [17592186349132 1034 "r(1)=⟨{e}^{2},\\,2⟩" 13194139535436 true] [17592186349132 1103 #edb/ref 17592186045453 13194139535436 true] [17592186349132 1111 #uuid "927ec01e-cfab-5948-a71f-fd31247c4ccf" 13194139535436 true] [17592186349133 1034 "r(1)=⟨{e}^{2},\\,4⟩" 13194139535436 true] [17592186349133 1103 #edb/ref 17592186045453 13194139535436 true] [17592186349133 1111 #uuid "e7ed84fe-5125-5c7e-baba-10cc912c9d08" 13194139535436 true] [17592186349134 1034 "r(1)=⟨2{e}^{2},\\,4⟩" 131941395