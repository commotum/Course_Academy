#{[{:db/id #edb/ref 17592186059479 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3" :knowledge-point/title "Multiplying 2x2 Square Matrices"}] :question/id #uuid "04e1822f-2da1-5b28-8967-7a0026c39319" :question/math-academy-id "e-4401" :question/problem "Find $AB$ and $BA$, if\n$\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}\nAB &= \\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 \\cdot 0 + 0 \\cdot (-1) & 1 \\cdot 1 + 0 \\cdot 2 \\\\ -5 \\cdot 0 + 1 \\cdot (-1) & -5 \\cdot 1 + 1 \\cdot 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 & 1 \\\\ -1 & -3\\end{bmatrix}\n\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\nBA &= \\begin{bmatrix}0 & 1 \\\\ -1 & 2\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\cdot 1 + 1 \\cdot (-5) & 0 \\cdot 0 + 1 \\cdot 1 \\\\ -1 \\cdot 1 + 2 \\cdot (-5) & -1 \\cdot 0 + 2 \\cdot 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-5 & 1 \\\\ -11 & 2\\end{bmatrix}\n\\end{aligned}\n$$\n\n**Watch out!** Notice that\n\n$$\nAB \\neq BA\n$$\n\nMatrix multiplication is not **commutative**, meaning that when we switch the order of multiplication, we often get a different result (like we did in this example)."}] [{:db/id #edb/ref 17592186059480 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-point/title "Multiplying 3x3 Square Matrices"}] :question/id #uuid "3b0c400c-89bd-504d-87c3-e0f24957d42b" :question/math-academy-id "e-4402" :question/problem "Find $AB$, if\n$\\begin{bmatrix}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{bmatrix}$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}\nAB &= \\begin{bmatrix}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{bmatrix}\\begin{bmatrix}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 + 0 - 9 & -6 + 0 - 3 & 4 + 0 + 6 \\\\ 0 - 1 + 6 & 9 + 2 + 2 & -6 - 4 - 4 \\\\ 0 + 0 + 3 & -6 + 0 + 1 & 4 + 0 - 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-9 & -9 & 10 \\\\ 5 & 13 & -14 \\\\ 3 & -5 & 2\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059523 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/id #uuid "4aaa04dd-1380-50c9-8118-52f6e414f830" :question/math-academy-id "e-5255" :question/problem "Let $Z=XY$. What is the value of $z_{32}$, if\n$\\begin{bmatrix}1 & 2 & 0 \\\\ -2 & 0 & -1 \\\\ 1 & 2 & 3\\end{bmatrix}$" :question/worked-solution "Multiplying the $3$rd row in $X$ by the $2$nd column in $Y$, we get\n\n$$\n\\begin{aligned}\nz_{32} &= \\begin{bmatrix}1 & 2 & 3\\end{bmatrix}\\begin{bmatrix}-1 \\\\ 4 \\\\ -2\\end{bmatrix} \\\\\n&= 1 \\cdot (-1) + 2 \\cdot 4 + 3 \\cdot (-2) \\\\\n&=-1 + 8 - 6 \\\\\n&= 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060309 :knowledge-point/_questions [{:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899d6dee-a4bb-5fbb-9d3c-613bf90ab5a4" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186058838} {:answer/id #uuid "98f44018-1ab5-510d-80ab-07baedb208fb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186058839} {:answer/id #uuid "a8a874eb-bad9-55e2-8261-6be07218a846" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058840} {:answer/id #uuid "fc2ad852-406c-5625-93c6-77064e7dc911" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186058841} {:answer/id #uuid "28b5ad3c-027a-5e0f-976b-34067c6f803e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186058842}] :answer-field/correct {:answer/id #uuid "a8a874eb-bad9-55e2-8261-6be07218a846" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058840} :answer-field/id #uuid "9ea01553-de9a-5dd3-a258-4efa560dc90a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058837}] :question/id #uuid "d291adcf-c714-501f-8b68-b0b7b6160e81" :question/math-academy-id "q-68290" :question/problem "Let $C = AB$. What is the value of $c_{21}$, if\n\n$A = \\begin{bmatrix}3 & 2 \\\\ 5 & -1\\end{bmatrix}, B = \\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}$?"}]}
