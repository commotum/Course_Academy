ntry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899d6dee-a4bb-5fbb-9d3c-613bf90ab5a4" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186058838} {:answer/id #uuid "98f44018-1ab5-510d-80ab-07baedb208fb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186058839} {:answer/id #uuid "a8a874eb-bad9-55e2-8261-6be07218a846" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058840} {:answer/id #uuid "fc2ad852-406c-5625-93c6-77064e7dc911" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186058841} {:answer/id #uuid "28b5ad3c-027a-5e0f-976b-34067c6f803e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186058842}] :answer-field/correct {:answer/id #uuid "a8a874eb-bad9-55e2-8261-6be07218a846" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058840} :answer-field/id #uuid "9ea01553-de9a-5dd3-a258-4efa560dc90a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058837}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d291adcf-c714-501f-8b68-b0b7b6160e81" :question/math-academy-id "q-68290" :question/problem "Let $C=AB.$ What is the value of ${c}_{21}$, if\n\n$$\nA=[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}],\\,B=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row in $A$ by the $1$st column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{21} & =[\\begin{aligned}5 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & =5\\cdot 1+(-1)\\cdot 3 \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276969 :knowledge-point/_questions [{:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title