+\\frac{4}{3}\\cdot 3\\, & \\,(-1)\\cdot 15+\\frac{4}{3}\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}6+6\\, & \\,9+12 \\\\ -10+4\\, & \\,-15+8\\end{aligned}] \\\\  & =[\\begin{aligned}12 & 21 \\\\ -6 & -7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276955 :knowledge-point/_questions [{:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51501b3d-01ad-5c10-9d34-3aa42776fe3b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276957}] :answer-field/correct {:answer/id #uuid "51501b3d-01ad-5c10-9d34-3aa42776fe3b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276957} :answer-field/id #uuid "d1545294-9c76-59a7-823e-235952c4c8e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276956}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "148cb8a0-eb6e-51da-b731-c39088dcd41e" :question/math-academy-id "q-318319" :question/problem "Let $G=HM.$ What is the value of ${g}_{31}$, if\n\n$$\nH=[\\begin{aligned}2 & -1 & 0 & 3 \\\\ 4 & 2 & -2 & 1 \\\\ -3 & 5 & 1 & 0 \\\\ 1 & -4 & 2 & 2\\end{aligned}],\\,M=[\\begin{aligned}1 & 2 & -1 & 0 \\\\ 3 & -2 & 4 & 1 \\\\ 0 & 5 & -3 & 2 \\\\ 2 & 1 & 0 & -2\\end{aligned}]?\n$$\n\n${g}_{31}=$ \n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $H$ by the $1$st column in $M$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =[\\begin{aligned}-3 & 5 & 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 3 \\\\ 0 \\\\ 2\\end{aligned}] \\\\  & =(-3)\\cdot 1+5\\cdot 3+1\\cdot 0+0\\cdot 2 \\\\  & =-3+15+0+0 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276958 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-poi