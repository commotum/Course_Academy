igned}1 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 2\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}MN & =[\\begin{aligned}2 & 0 & 2 \\\\ 0 & -1 & 2 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+0+4 & 4+0+2 & 6+0+4 \\\\ 0-0+4 & 0-1+2 & 0-0+4 \\\\ 1+0+4 & 2+0+2 & 3+0+4\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 & 10 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 7\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276893 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3" :knowledge-point/title "Multiplying 2x2 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629587d3-6e9b-569a-9abe-bc58b36e1888" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 9 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186276895} {:answer/id #uuid "f8d49ca0-fa54-5a10-a54b-9e3013e36ac3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186276896} {:answer/id #uuid "290cee6c-da3c-57b0-a519-7d537e5ae9da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ 9 & 4\\end{aligned}]" :db/id #edb/ref 17592186276897} {:answer/id #uuid "c61b5bea-9b62-5ca1-b60c-ef4b1dc4a7ec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 9 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186276898} {:answer/id #uuid "470ca556-2922-5d6b-aa54-3399f8cdf1e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186276899}] :answer-field/correct {:answer/id #uuid "629587d3-6e9b-569a-9abe-bc58b36e1888" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 9 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 175921862768