nswer-fields ["q-129367/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8"] :knowledge-point/questions ["q-129367"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11572/selection/f917a6bc59bff8db671d19c4244e3ae1a1a9e67897338e51fc75706e67d00315" :answer/id #uuid "a5ac5a76-267b-5428-9d5f-7a187e9ababb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 & 8 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11572/selection/fa4d7bd76ae1da312df3c264878decae93e89ab406c6da4a729fb9545c2dce8a" :answer/id #uuid "4c813bae-8069-5ece-aab9-e2922d6d880f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 & 10 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11572/selection/e2f26b2504996edb7f009887aa92ee91245d55b085241ec23fffae4f00fb8fd0" :answer/id #uuid "0b336bd2-3ea6-5466-9754-02564022da27" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 & 8 \\\\ 4 & -1 & 4 \\\\ 5 & 4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11572/selection/9a694c3397058276e4272a20b5b8e8b2fd1552d74247cf711b4f2ebc3ea2ff62" :answer/id #uuid "b30760ff-f54f-5087-b049-f3fce0b7af5a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 & 8 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11572/selection/de5a7da061305f9658c86f480858ca1b80a27f331db2da4b3bfb8a31635106ed" :answer/id #uuid "b2683756-c018-5d05-ac7e-2689a7a2831f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 & 4 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11572/selection" :answer-field/id #uuid "20e7ae34-ab7d-5744-817f-b21f329e20af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11572/selection/fa4d7bd76ae1da312df3c264878decae93e89ab406c6da4a729fb9545c2dce8a" :answer-field/choices ["q-11572/selection/f917a6bc59bff8db671d19c4244e3ae1a1a9e67897338e51fc75706e67d00315" "q-11572/selection/fa4d7bd76ae1da312df3c264878decae93e89ab406c6da4a729fb9545c2dce8a" "q-11572/selection/e2f26b2504996edb7f009887aa92ee91245d55b085241ec23fffae4f00fb8fd0" "q-11572/selection/9a694c3397058276e4272a20b5b8e8b2fd1552d74247cf711b4f2ebc3ea2ff62" "q-11572/selection/de5a7da061305f9658c86f480858ca1b80a27f331db2da4b3bfb8a31635106ed"] :db/ensure [:answer-field/validate]} {:db/id "q-11572" :question/id #uuid "9d5a52b0-4065-561d-8084-0413f5a95c66" :question/math-academy-id "q-11572" :question/problem "Find $MN$, if  $M=[\\begin{aligned}2 & 0 & 2 \\\\ 0 & -1 & 2 \\\\ 1 & 0 & 2\\end{aligned}]$ and $N=[\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 2\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}MN & =[\\begin{aligned}2 & 0 & 2 \\\\ 0 & -1 & 2 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 3 \\\\ 0 & 1 & 0 \\\\ 2 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+0+4 & 4+0+2 & 6+0+4 \\\\ 0-0+4 & 0-1+2 & 0-0+4 \\\\ 1+0+4 & 2+0+2 & 3+0+4\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 & 10 \\\\ 4 & 1 & 4 \\\\ 5 & 4 & 7\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11572/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8"] :knowledge-point/questions ["q-11572"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4401"] :question/problem "Find $AB$ and $BA,$ if \n$[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]$\nand\n$[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}]$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot 0+0\\cdot (-1) & 1\\cdot 1+0\\cdot 2 \\\\ -5\\cdot 0+1\\cdot (-1) & -5\\cdot 1+1\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & -3\\end{aligned}]\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}BA & =[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1+1\\cdot (-5) & 0\\cdot 0+1\\cdot 1 \\\\ -1\\cdot 1+2\\cdot (-5) & -1\\cdot 0+2\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 1 \\\\ -11 & 2\\end{aligned}].\\end{aligned}\n$$\n\n**Watch out!** Notice that \n\n$$\nAB \\neq BA.\n$$\n\nMatrix multiplication is not **commutative**, meaning that when we switch the order of multiplication, we often get a different result (like we did in this example)." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5255"] :question/problem "Let $Z=XY.$ What is the value of $z_{32}$, if\n\n$$\n[\\begin{aligned}1 & 2 & 0 \\\\ -2 & 0 & -1 \\\\ 1 & 2 & 3\\end{aligned}]\n$$" :question/worked-solution "Multiplying the $3$rd row in $X$ by the $2$nd column in $Y$, we get\n\n$$\n\\begin{aligned}{z}_{32} & =[\\begin{aligned}1 & 2 & 3\\end{aligned}][\\begin{aligned}-1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =1\\cdot (-1)+2\\cdot 4+3\\cdot (-2) \\\\  & =-1+8-6 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4402"] :question/problem "Find $AB$, if \n$[\\begin{aligned}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{aligned}]$\nand\n$[\\begin{aligned}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{aligned}]$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-2 & 0 & 3 \\\\ 3 & -1 & -2 \\\\ -2 & 0 & -1\\end{aligned}][\\begin{aligned}0 & 3 & -2 \\\\ 1 & -2 & 4 \\\\ -3 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0+0-9 & -6+0-3 & 4+0+6 \\\\ 0-1+6 & 9+2+2 & -6-4-4 \\\\ 0+0+3 & -6+0+1 & 4+0-2\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & -9 & 10 \\\\ 5 & 13 & -14 \\\\ 3 & -5 & 2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]}]
