r-field/id #uuid "56c7bbda-beeb-5240-ac83-cbcd5c8aa8a9" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318314/field-4/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-318314/field-4/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-318314" :question/id #uuid "8123f17d-b199-57a8-93f3-ff7609b8bd6d" :question/math-academy-id "q-318314" :question/problem "If $C=[\\begin{aligned}\\frac{3}{5} & 2 \\\\ -1 & \\frac{4}{3}\\end{aligned}]$\nand\n$D=[\\begin{aligned}10 & 15 \\\\ 3 & 6\\end{aligned}],$\nthen\n\n| $CD=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,.$ |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |  |" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}\\frac{3}{5} & 2 \\\\ -1 & \\frac{4}{3}\\end{aligned}][\\begin{aligned}10 & 15 \\\\ 3 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{5}\\cdot 10+2\\cdot 3\\, & \\,\\frac{3}{5}\\cdot 15+2\\cdot 6 \\\\ (-1)\\cdot 10+\\frac{4}{3}\\cdot 3\\, & \\,(-1)\\cdot 15+\\frac{4}{3}\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}6+6\\, & \\,9+12 \\\\ -10+4\\, & \\,-15+8\\end{aligned}] \\\\  & =[\\begin{aligned}12 & 21 \\\\ -6 & -7\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318314/field-1" "q-318314/field-2" "q-318314/field-3" "q-318314/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3"] :knowledge-point/questions ["q-318314"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-68290"] :question/problem "Let $C=AB.$ What is the value of ${c}_{21}$, if\n\n$$\nA=[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}],\\,B=[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row in $A$ by the $1$st column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{21} & =[\\begin{aligned}5 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & =5\\cdot 1+(-1)\\cdot 3 \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-70194/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "2b07e904-22b4-5e81-bd07-0640ed052217" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-70194/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" :answer/id #uuid "57166eff-96a5-55fb-86eb-04e19f65d8db" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "q-70194/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c0b685d4-257f-5803-8f85-e2de074f70c1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-70194/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "31fdd243-59fa-5134-b22a-2f3b1b57e0cd" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-70194/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "980676d1-f6ec-58a8-97d0-f6c675f2b3c8" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-70194/selection" :answer-field/id #uuid "26a5d9a3-087b-5aea-abb9-c2a8756bc0e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70194/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer-field/choices ["q-70194/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" "q-70194/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" "q-70194/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-70194/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-70194/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-70194" :question/id #uuid "f85fb038-2edb-5757-b4ca-98bd1791dba6" :question/math-academy-id "q-70194" :question/problem "Let $F=GH.$ What is the value of ${f}_{12}$, if\n\n$$\nG=[\\begin{aligned}2 & 3 \\\\ 4 & -2\\end{aligned}],\\,H=[\\begin{aligned}-1 & 3 \\\\ 6 & 5\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $1$st row in $G$ by the $2$nd column in $H$, we get\n\n$$\n\\begin{aligned}{f}_{12} & =[\\begin{aligned}2 & 3\\end{aligned}][\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\  & =2\\cdot 3+3\\cdot 5 \\\\  & =6+15 \\\\  & =21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00"] :knowledge-point/questions ["q-70194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318319/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "51501b3d-01ad-5c10-9d34-3aa42776fe3b" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-318319/field-1" :answer-field/id #uuid "d1545294-9c76-59a7-823e-235952c4c8e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318319/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-318319/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-318319" :question/id #uuid "148cb8a0-eb6e-51da-b731-c39088dcd41e" :question/math-academy-id "q-318319" :question/problem "Let $G=HM.$ What is the value of ${g}_{31}$, if\n\n$$\nH=[\\begin{aligned}2 & -1 & 0 & 3 \\\\ 4 & 2 & -2 & 1 \\\\ -3 & 5 & 1 & 0 \\\\ 1 & -4 & 2 & 2\\end{aligned}],\\,M=[\\begin{aligned}1 & 2 & -1 & 0 \\\\ 3 & -2 & 4 & 1 \\\\ 0 & 5 & -3 & 2 \\\\ 2 & 1 & 0 & -2\\end{aligned}]?\n$$\n\n${g}_{31}=$ \n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $H$ by the $1$st column in $M$, we get\n\n$$\n\\begin{aligned}{g}_{31} & =[\\begin{aligned}-3 & 5 & 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 3 \\\\ 0 \\\\ 2\\end{aligned}] \\\\  & =(-3)\\cdot 1+5\\cdot 3+1\\cdot 0+0\\cdot 2 \\\\  & =-3+15+0+0 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318319/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00"] :knowledge-point/questions ["q-318319"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77461/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "22df69cd-6db9-5181-8afd-220dd875b66f" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-77461/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "42e754e1-9256-5448-8ad0-a4e3bb06a115" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-77461/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "85d1bd6e-807a-5e2a-86ce-4e580c105a39" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-77461/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "bfc9e5a7-4187-5dfb-9c60-5f92ff4584b9" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-77461/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "84009322-8857-5117-af81-23b0b4fffdd1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-77461/sel