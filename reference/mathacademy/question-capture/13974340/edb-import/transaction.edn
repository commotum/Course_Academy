 [:answer-field/validate]} {:db/id "q-318308" :question/id #uuid "b35c72a5-5114-5c9c-8844-8b06b8ce3e5e" :question/math-academy-id "q-318308" :question/problem "If $A=[\\begin{aligned}3 & -2 \\\\ -1 & 4\\end{aligned}]$\nand\n$B=[\\begin{aligned}-3 & 2 \\\\ 5 & -1\\end{aligned}],$\nthen\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,.$ |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |  |" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}3 & -2 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 5 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3\\cdot (-3)+(-2)\\cdot 5 & 3\\cdot 2+(-2)\\cdot (-1) \\\\ (-1)\\cdot (-3)+4\\cdot 5 & (-1)\\cdot 2+4\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}-9+(-10) & 6+2 \\\\ 3+20 & -2+(-4)\\end{aligned}] \\\\  & =[\\begin{aligned}-19 & 8 \\\\ 23 & -6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318308/field-1" "q-318308/field-2" "q-318308/field-3" "q-318308/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3"] :knowledge-point/questions ["q-318308"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318311/field-1/82ec26c0001ae04b27cd2a63ab6318b183a710f05feb55d071b767b49c260b88" :answer/id #uuid "878646d4-0f41-5f8d-a6c9-c61afea854e7" :answer/type :answer.type/math :answer/value "-\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "q-318311/field-1/ed43d5224151224cedff9572a0bc31a320bd7a8ebd2aa526ca5884904c9d6cb4" :answer/id #uuid "0a7d3386-8aba-50bd-a68f-ddae41c6b5f4" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "q-318311/field-1" :answer-field/id #uuid "55cbf40b-7bd8-5d71-ac7f-d8e7c0999a24" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318311/field-1/82ec2