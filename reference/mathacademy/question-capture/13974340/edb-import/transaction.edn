worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}2 & 0 & 1 \\\\ 3 & -1 & 4 \\\\ 0 & 2 & 5\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 3 & 0 & 2 \\\\ 2 & 1 & 3\\end{aligned}] & =[\\begin{aligned}2+0+2 & 4+0+1 & 2+0+3 \\\\ 3-3+8 & 6+0+4 & 3-2+12 \\\\ 0+6+10 & 0+0+5 & 0+4+15\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 5 & 5 \\\\ 8 & 10 & 13 \\\\ 16 & 5 & 19\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318339/field-1" "q-318339/field-2" "q-318339/field-3" "q-318339/field-4" "q-318339/field-5"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8"] :knowledge-point/questions ["q-318339"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129367/selection/188714b6350a0057268896e2502a120c3b660a8d01ffe5e81d8f9643accef8e8" :answer/id #uuid "d4a51538-5679-5838-8b40-f0ef49c7314a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129367/selection/fa0e2cf0bb1de173abf604c2f4889eb26641303bf3fcf1eb49770883006e3cef" :answer/id #uuid "80723bc7-8f4f-51b0-a34b-7ec8a2f772f3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-14 & 4 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & 0 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129367/selection/ee7c6f397fef52224f74d35240b1b01e54ef7ffe0456af005b2a766b5ce5ba75" :answer/id #uuid "37cfa03f-13d5-546f-aa03-6a23ff67e239" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & 0 & 2 \\\\ 14 & 4 & -4 \\\\ 0 & -8 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129367/selection/f6e70e712fc05dedf1a3d91433786fcae61b9d04a982433163a365fe2a6b809e" :answer/id #uuid "2c44097e-adde-5678-aedf-a1e65689b0f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 &