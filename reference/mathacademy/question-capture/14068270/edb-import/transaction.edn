[{:db/id [:question/math-academy-id "q-84842"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14068270/assets/7cb71517fe60c9d15b6cacddbf5f91c2e4a60103b8917a4d9baa287517a5fd54.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :db/ensure [:question/validate]} {:db/id "q-84851/selection/1272f38a75842877bbc43f2f9f47092795bbda0da5b35cad26385e6fcf7d5982" :answer/id #uuid "17deb370-813d-50be-9716-9ae480c7204f" :answer/type :answer.type/math :answer/value "(x+3)^{2}=2(y-2)" :db/ensure [:answer/validate]} {:db/id "q-84851/selection/fac73efde0a26799f73b41e9b40c27a783972f33e4ef97b3909dcbb50e5ea8b5" :answer/id #uuid "2ef1d5fe-77b9-5ed1-a30c-8800c099b320" :answer/type :answer.type/math :answer/value "(x+3)^{2}=4(y-2)" :db/ensure [:answer/validate]} {:db/id "q-84851/selection/b6d28b0ca30173675e97e10091682885f0aabeca4426c7fdaedc539fff76e275" :answer/id #uuid "e3448d61-2644-5b83-99b5-283134c1f834" :answer/type :answer.type/math :answer/value "(x-3)^{2}=2(y+2)" :db/ensure [:answer/validate]} {:db/id "q-84851/selection/5a1c478c6a8aeda5e8d7d37ef77c49fe305ff395040266632259c338fcc5c7ed" :answer/id #uuid "8f148064-a42c-5efa-88b4-d1afc3b0c08a" :answer/type :answer.type/math :answer/value "(x-3)^{2}=4(y+2)" :db/ensure [:answer/validate]} {:db/id "q-84851/selection/436c6bdc831223332706395d6c5a2ecc032feef0d220d77cf6d98a1e2e767189" :answer/id #uuid "2ca7dcfb-c2d3-5599-86dc-6440da954b4f" :answer/type :answer.type/math :answer/value "(x+3)^{2}=8(y-2)" :db/ensure [:answer/validate]} {:db/id "q-84851/selection" :answer-field/id #uuid "01dc42f8-4165-5aab-a5d5-04c40b30a64f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84851/selection/fac73efde0a26799f73b41e9b40c27a783972f33e4ef97b3909dcbb50e5ea8b5" :answer-field/choices ["q-84851/selection/1272f38a75842877bbc43f2f9f47092795bbda0da5b35cad26385e6fcf7d5982" "q-84851/selection/fac73efde0a26799f73b41e9b40c27a783972f33e4ef97b3909dcbb50e5ea8b5" "q-84851/selection/b6d28b0ca30173675e97e10091682885f0aabeca4426c7fdaedc539fff76e275" "q-84851/selection/5a1c478c6a8aeda5e8d7d37ef77c49fe305ff395040266632259c338fcc5c7ed" "q-84851/selection/436c6bdc831223332706395d6c5a2ecc032feef0d220d77cf6d98a1e2e767189"] :db/ensure [:answer-field/validate]} {:db/id "q-84851" :question/id #uuid "20d8f158-c599-5a82-bf4d-bc71d1b096d5" :question/math-academy-id "q-84851" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx+3=2t,\\,y-2={t}^{2},\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =\\frac{x+3}{2},\\,{t}^{2}=y-2.\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(\\frac{x+3}{2})}^{2} \\\\  & =\\frac{(x+3)^{2}}{4}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=y-2$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{4} & =y-2 \\\\ (x+3)^{2} & =4(y-2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84851/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "14079b03-66c0-5657-8909-a7d5ea35bfc0"] :knowledge-point/questions ["q-84851"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84859/selection/24126838978c2736223e9304d36a784644d31cabf3598e8512bcb2957e6a3593" :answer/id #uuid "5dc5b44c-bfa3-5013-89d4-9d171b8da5ec" :answer/type :answer.type/math :answer/value "(y+1)^{2}=-5(x-1)" :db/ensure [:answer/validate]} {:db/id "q-84859/selection/f46d976f59a480cddf1ac3bf18f999bfb25c791702c2dc72abeead95718bc4f8" :answer/id #uuid "e8367f2a-1f38-5156-bfb9-8fa82ab9b0ae" :answer/type :answer.type/math :answer/value "(y-1)^{2}=\\frac{5}{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-84859/selection/d60a95f7d85d12b9afda5d269eb937e74f8d99a027ab3714cff8b0c6e6403869" :answer/id #uuid "7b677554-c650-5f66-87b7-f277e1f8341d" :answer/type :answer.type/math :answer/value "(y+1)^{2}=-\\frac{5}{2}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-84859/selection/b56017c8c14c9763643ed3408f23176aa8004d17fa8a69eeeeb8f22962110c97" :answer/id #uuid "8b2f06e1-c48d-5a6c-8c3c-a48f81a307d6" :answer/type :answer.type/math :answer/value "(y-1)^{2}=-\\frac{5}{2}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-84859/selection/67fdd01d53b47aef25e795f8c47dd133348479e881a814498656e8aab4515913" :answer/id #uuid "c6ac3a23-451c-51a3-b7f5-2d71382fff55" :answer/type :answer.type/math :answer/value "(y-1)^{2}=-5(x+1)" :db/ensure [:answer/validate]} {:db/id "q-84859/selection" :answer-field/id #uuid "23128741-098a-5682-8d60-27c3890fe51d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84859/selection/67fdd01d53b47aef25e795f8c47dd133348479e881a814498656e8aab4515913" :answer-field/choices ["q-84859/selection/24126838978c2736223e9304d36a784644d31cabf3598e8512bcb2957e6a3593" "q-84859/selection/f46d976f59a480cddf1ac3bf18f999bfb25c791702c2dc72abeead95718bc4f8" "q-84859/selection/d60a95f7d85d12b9afda5d269eb937e74f8d99a027ab3714cff8b0c6e6403869" "q-84859/selection/b56017c8c14c9763643ed3408f23176aa8004d17fa8a69eeeeb8f22962110c97" "q-84859/selection/67fdd01d53b47aef25e795f8c47dd133348479e881a814498656e8aab4515913"] :db/ensure [:answer-field/validate]} {:db/id "q-84859" :question/id #uuid "581a44da-b9bd-54cf-936c-6f38a54486c0" :question/math-academy-id "q-84859" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx+1=-\\frac{5}{4}{t}^{2},\\,y-1=-\\frac{5}{2}t,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =-\\frac{4(x+1)}{5},\\,t=-\\frac{2(y-1)}{5}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(-\\frac{2(y-1)}{5})}^{2} \\\\  & =\\frac{4(y-1)^{2}}{25}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-\\frac{4(x+1)}{5}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{4(y-1)^{2}}{25} & =-\\frac{4(x+1)}{5} \\\\ (y-1)^{2} & =\\frac{25}{4}\\cdot (-\\frac{4(x+1)}{5}) \\\\ (y-1)^{2} & =-5(x+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84859/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "14079b03-66c0-5657-8909-a7d5ea35bfc0"] :knowledge-point/questions ["q-84859"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-106461"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14068270/assets/e5c7f025b6f12599a4ecb5fa0cc9e657fd0b67deb1e50231673113f337ca7776.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :db/ensure [:question/validate]} {:db/id "q-323209/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "f0ce42e4-a7d5-57da-b3dd-eb27f70938d6" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-323209/field-1" :answer-field/id #uuid "767456eb-e8d8-5700-beb7-2079e41ff6b7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323209/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-323209/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-323209/field-2/710139f508336e26c7d33f221668ac059cca339a4d61dd912136c70e02c42e6c" :answer/id #uuid "40743546-cb8e-5497-97a4-a66504271cca" :answer/type :answer.type/math :answer/value "2-y" :db/ensure [:answer/validate]} {:db/id "q-323209/field-2" :answer-field/id #uuid "73ea54b2-2395-5bdf-9780-650ffe63c4ca" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323209/field-2/710139f508336e26c7d33f221668ac059cca339a4d61dd912136c70e02c42e6c" :answer-field/choices ["q-323209/field-2/710139f508336e26c7d33f221668ac059cca339a4d61dd912136c70e02c42e6c"] :db/ensure [:answer-field/validate]} {:db/id "q-323209" :question/id #uuid "f54dfea7-1ce0-53bf-b599-41fdc4b47216" :question/math-academy-id "q-323209" :question/problem "Consider the following parametric equation of the parabola\n\n$$\nx+7=-3t,\\,y-2=-9{t}^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this parabola is\n\n$(x\\,+$\n{{field-1}}$)^{2}=$\n{{field-2}}." :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =-\\frac{x+7}{3},\\,{t}^{2}=-\\frac{1}{9}(y-2).\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={(-\\frac{x+7}{3})}^{2} \\\\  & =\\frac{(x+7)^{2}}{9}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-\\frac{1}{9}(y-2)$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{(x+7)^{2}}{9} & =-\\frac{1}{9}(y-2) \\\\ {(x+7)}^{2} & =-(y-2)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-323209/field-1" "q-323209/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "14079b03-66c0-5657-8909-a7d5ea35bfc0"] :knowledge-point/questions ["q-323209"] :db/ensure [:knowledge-point/validate]}]
