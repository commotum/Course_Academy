ture/14055537/assets/cb247068f321f4cda099913d632e1d4a55679b98780a200394aa325f9a04235a.png" :db/id #edb/ref 17592186332596} :answer-field/id #uuid "a453be43-42e7-5e87-8f69-eace950be3b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332594}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d90f041c-edf1-58a7-aee4-ec1e2efc48d2" :question/math-academy-id "q-123785" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\nx=5-{t}^{2},\\,y={t}^{2}-3,\\,0\\le t\\le 3\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=5-{t}^{2}.$ This gives\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $x$ | $5$ | $4$ | $1$ | $-4$ |\n| $y$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y={t}^{2}-3.$ This gives\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $x$ | $5$ | $4$ | $1$ | $-4$ |\n| $y$ | $-3$ | $-2$ | $1$ | $6$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055537/assets/a39e8a0c4ed269e5cb73aaedf0655d85302f3a5c3c7e91d9f5e58ebf84a82423.png)"}] [{:db/id #edb/ref 17592186087970 :knowledge-point/_questions [{:knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ddccd06-4566-5e8a-a465-e79cdd3510d7" :answer/type {:db/ident :answer.type/math} :answer/value "-7 \\le x \\le 7,-3 \\le y \\le 3" :db/id #edb/ref 17592186084832} {:answer/id #uuid "cd8c55b0-5059-504d-91de-efd34bc62d10" :answer/type {:db/ident :answer.type/math} :answer/value "0 \\le x \\le 7, 0 \\le y \\le 3" :db/id #edb/ref 17592186084833} {:answer/id #uuid "3865ea55-56d0-5919-aa6d-cab258450d49" :answer/type {:db/ident :answer.type/math} :answer/value "1 \\le x \\le 1, 1 \\le y \\le 1" :db/id #edb/ref 17592186084834} {:answer/id #uuid "54e66ca9-1543-5320-a2f5-ff6c205b12c1" :answer/type {:db/ident :answer.type/math} :answer/value "0 \\le x \\le 3, 0 \\le y \\le 7" :db/id #edb/ref 17592186084835} {:answer/id #uuid "5df75c9f-ff9d-5234-a761-c7aef1991717" :answer/type {:db/ident :answer.type/math} :answer/value "-3 \\le x \\le 3,-7 \\le y \\le 7" :db/id #edb/ref 17592186084836}] :answer-field/correct {:answer/id #uuid "8ddccd06-4566-5e8a-a465-e79cdd3510d7" :answer/type {:db/ident :answer.type/math} :answer/value "-7 \\le x \\le 7,-3 \\le y \\le 3" :db/id #edb/ref 17592186084832} :answer-field/id #uuid "b4ee57ff-bd92-536c-9c0e-eafac67b9421" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084831}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "167fa292-246c-5f48-b5ed-5686c02c3004" :question/math-academy-id "q-16201" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,\\,\\,y=3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -7 & \\le 7\\operatorname{cos}⁡\\theta \\le 7 \\\\ -7 & \\le x\\le 7.\\end{aligned}\n$$\n\nSo, we can conclude that $-7\\le x\\le 7.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -3 & \\le 3\\operatorname{sin}⁡\\theta \\le 3 \\\\ -3 & \\le y\\le 3.\\end{aligned}\n$$\n\nSo, we can conclude that $-3\\le y\\le 3.$\n\nTherefore, the ranges are $-7\\le x\\le 7$ and $-3\\le y\\le 3.$"}] [{:db/id #edb/ref 17592186332600 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a71cb530-6dd7-5b5c-90e2-915ff23461c8" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186332602}] :answer-field/correct {:answer/id #uuid "a71cb530-6dd7-5b5c-90e2-915ff23461c8" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186332602} :answer-field/id #uuid "ebd7ec7f-f2e0-5f36-88fd-2348e0188648" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186332601} {:answer-field/choices [{:answer/id #uuid "23be339b-3436-53f7-b90e-29595b613554" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186332604}] :answer-field/correct {:answer/id #uuid "23be339b-3436-53f7-b90e-29595b613554" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186332604} :answer-field/id #uuid "fdd0b477-948c-5dfd-946d-d33f44838eb5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186332603} {:answer-field/choices [{:answer/id #uuid "c9ec8b11-4806-50ae-bd3a-89cc58fb90f2" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186332606}] :answer-field/correct {:answer/id #uuid "c9ec8b11-4806-50ae-bd3a-89cc58fb90f2" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186332606} :answer-field/id #uuid "7090f95e-11d0-5304-8a91-193a900af894" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186332605} {:answer-field/choices [{:answer/id #uuid "f8980643-1557-59df-a335-92b79128dd71" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186332608}] :answer-field/correct {:answer/id #uuid "f8980643-1557-59df-a335-92b79128dd71" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186332608} :answer-field/id #uuid "f9879ac2-67ff-5bd7-bc9f-7c8fdc99241a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186332607}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ba53dca3-371d-58bb-877f-f81b17840b8f" :question/math-academy-id "q-327852" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\sqrt{8-t},\\,y=\\sqrt{16-2t}+1,\\,t<8,\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $\\sqrt{8-t}>0$ for all $t<8.$ Consequently, the range of $x$ is\n\n$$\nx>0.\n$$\n\n- To find the range of $y,$ note that $\\sqrt{16-2t}+1>1$ for all $t<8.$ Consequently, the range of $y$ is\n\n$$\ny>1.\n$$"}] [{:db/id #edb/ref 17592186332609 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a57a0c4-73dc-5959-9e02-ce13094157bb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055537/assets/0e7f02989d53152d1f2d5247f7f42d579956e49743694229d409cd266ec33e46.png" :db/id #edb/ref 17592186332611} {:answer/id #uuid "ed1e63e6-7583-5fa7-8dd4-506031ede19f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/quest