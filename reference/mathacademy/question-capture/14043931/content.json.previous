              "value": "y=-\\,\\frac{9}{4}x+\\frac{8}{3}"
            }
          ],
          "correct_value": "y=-3x+2",
          "choices_complete": true,
          "correct_origin": "ma_successful_grade"
        }
      ],
      "difficulty": "moderate",
