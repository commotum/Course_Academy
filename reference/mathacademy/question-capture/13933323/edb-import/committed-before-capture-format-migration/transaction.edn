[:answer/validate]} {:db/id "q-48559/selection/9b472e0c888e43eda0482b990e3962034bff7b3be4dc6cc9bf5c0b1ee2cde7ae" :answer/id #uuid "64df5e4a-30c8-5cf7-850a-04a6baae6127" :answer/type :answer.type/math :answer/value "\\frac{1}{3xln⁡(2)}" :db/ensure [:answer/validate]} {:db/id "q-48559/selection/232a5dada091313e16984e74d3bb5db444374b46d43b46399f9b4745bb7bd053" :answer/id #uuid "f3f8ace2-1ea3-59ae-82b9-4f0fb69f53bf" :answer/type :answer.type/math :answer/value "\\frac{3}{x}" :db/ensure [:answer/validate]} {:db/id "q-48559/selection/3e9cd949bee333ba4a4648a183f4512d1216bf6041fd7a11dc9acb0bcb5800d1" :answer/id #uuid "9ca13ef7-7e2d-52ca-8ce1-bed749495ffe" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{3}ln⁡(2)}" :db/ensure [:answer/validate]} {:db/id "q-48559/selection/bd2afdc0108fa68b0150a94333e66a7ccb838698c026d45978df86d3c3300979" :answer/id #uuid "52fb39a7-10aa-5955-9b5d-6a43baf1cabb" :answer/type :answer.type/math :answer/value "\\frac{3}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-48559/selection" :answer-field/id #uuid "f1e4490d-fdde-5ce7-aa07-9123758e9284" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48559/selection/9feda5c5e98f05dcdbd1c0a3c8e10cf96a2b79dc7ee8559625b3c2bbc27dc5b9" :answer-field/choices ["q-48559/selection/9feda5c5e98f05dcdbd1c0a3c8e10cf96a2b79dc7ee8559625b3c2bbc27dc5b9" "q-48559/selection/9b472e0c888e43eda0482b990e3962034bff7b3be4dc6cc9bf5c0b1ee2cde7ae" "q-48559/selection/232a5dada091313e16984e74d3bb5db444374b46d43b46399f9b4745bb7bd053" "q-48559/selection/3e9cd949bee333ba4a4648a183f4512d1216bf6041fd7a11dc9acb0bcb5800d1" "q-48559/selection/bd2afdc0108fa68b0150a94333e66a7ccb838698c026d45978df86d3c3300979"] :db/ensure [:answer-field/validate]} {:db/id "q-48559" :question/id #uuid "d872aca0-9860-5508-b389-44ecee8a1a35" :question/math-academy-id "q-48559" :question/is-example false :question/problem "Given that $y={log}_{2}⁡({x}^{3}),$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={log}_{2}⁡(u),\\,u={x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(2)},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(2)}\\cdot 3{x}^{2} \\\\  & =\\frac{3{x}^{2}}{{x}^{3}ln⁡(2)} \\\\  & =\\frac{\\cancel{{x}^{2}}\\cdot 3}{\\cancel{{x}^{2}}\\cdot xln⁡(2)} \\\\  & =\\frac{3}{xln⁡(2)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48559/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846"] :knowledge-point/questions ["q-48559"] :db/ensure [:knowledge-point/validate]} {:db/id "q-310145/field-1/211df964d999491aa53ae66cef2ed932433e6868e52cc784dbab1ebd17d361c7" :answer/id #uuid "a389446e-6169-5e82-8df7-14b55703d5ce" :answer/type :answer.type/math :answer/value "\\frac{3}{2\\ln(4)}" :db/ensure [:answer/validate]} {:db/id "q-310145/field-1" :answer-field/id #uuid "fedb2062-2878-5cb4-970d-33e6a45be825" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-310145/field-1/211df964d999491aa53ae66cef2ed932433e6868e52cc784dbab1ebd17d361c7" :answer-field/choices ["q-310145/field-1/211df964d999491aa53ae66cef2ed932433e6868e52cc784dbab1ebd17d361c7"] :db/ensure [:answer-field/validate]} {:db/id "q-310145" :question/id #uuid "cf7bff88-8076-590c-9d6c-accf8b15a565" :question/math-academy-id "q-310145" :question/is-example false :question/problem "Find the slope $m$ of the tangent to the curve $y={log}_{4}⁡(6x-2)+7$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={log}_{4}⁡(u)+7,\\,u=6x-2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(4)},\\,\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(4)}\\cdot 6 \\\\  & =\\frac{1}{(6x-2)ln⁡(4)}\\cdot 6 \\\\  & =\\frac{6}{(6x-2)ln⁡(4)} \\\\  & =\\frac{3}{(3x-1)ln⁡(4)}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1} & =\\frac{3}{(3x-1)ln⁡(4)}{|}_{x=1} \\\\  & =\\frac{3}{(3(1)-1)ln⁡(4)} \\\\  & =\\frac{3}{2ln⁡(4)}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-310145/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846"] :knowledge-point/questions ["q-310145"] :db/ensure [:knowledge-point/validate]}]
