9446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319395" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "-9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" nil "attribute" "question/problem" "value" "Find the inverse of the matrix $A=[\\begin{aligned}-1 & -3 & 1 \\\\ 1 & 2 & -1 \\\\ -2 & 3 & -2\\end{aligned}]$\ngiven that $det(A)=-4.$\n\n|  |  | $-1$ | {{field-1}} | $1$ |  |\n| --- | --- | --- | --- | --- | --- |\n| ${A}^{-1}=-\\frac{1}{4}\\,\\,$ |  | $4$ | {{field-2}} | $0$ |  |\n|  |  | $7$ | {{field-3}} | $1$ |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" nil "attribute" "question/worked-solution" "value" "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=-4\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}2 & -1 \\\\ 3 & -2\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ -2 & -2\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ -2 & 3\\end{aligned}| \\\\ |\\begin{aligned}-3 & 1 \\\\ 3 & -2\\end{aligned}| & |\\begin{aligned}-1 & 1 \\\\ -2 & -2\\end{aligned}| & |\\begin{aligned}-1 & -3 \\\\ -2 & 3\\end{aligned}| \\\\ |\\begin{aligned}-3 & 1 \\\\ 2 & -1\\end{aligned}| & |\\begin{aligned}-1 & 1 \\\\ 1 & -1\\end{aligned}| & |\\begin{aligned}-1 & -3 \\\\ 1 & 2\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -4 & 7 \\\\ 3 & 4 & -9 \\\\ 1 & 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}-1 & 4 & 7 \\\\ -3 & 4 & 9 \\\\ 1 & 0 & 1\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}-1 & -3 & 1 \\\\ 4 & 4 & 0 \\\\ 7 & 9 & 1\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =-\\frac{1}{4}[\\begin{aligned}-1 & -3 & 1 \\\\ 4 & 4 & 0 \\\\ 7 & 9 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-319370" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319370" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18288" "field" nil "attribute" "question/problem" "value" "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix $A$ $=[\\begin{aligned}2 & 5 & -3 \\\\ -1 & 0 & 2 \\\\ 5 & -6 & 3\\end{aligned}]$ if its determinant is $71.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18288" "field" nil "attribute" "question/worked-solution" "value" "Since we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =-(-3-10) \\\\  & =13.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′}=\\frac{1}{\\text{det}(A)}{c}_{12}=\\frac{1}{71}\\cdot 13=\\frac{13}{71}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18288" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-18288" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18288" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{10}{71}"] ["math" "-\\frac{13}{71}"] ["math" "-\\frac{3}{71}"] ["math" "\\frac{13}{71}"] ["math" "\\frac{3}{71}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18288" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{13}{71}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319416" "field" nil "attribute" "question/problem" "value" "Determine the entry ${a}_{33}^{′}$ in the inverse of a matrix \n$A=[\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & -1 \\\\ 0 & 3 & 2\\end{aligned}].$\n\n${a}_{33}^{′}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319416" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}\\text{det}(A)=|\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & -1 \\\\ 0 & 3 & 2\\end{aligned}| & =1|\\begin{aligned}1 & -1 \\\\ 3 & 2\\end{aligned}|-(-2)|\\begin{aligned}2 & -1 \\\\ 0 & 2\\end{aligned}|+0|\\begin{aligned}2 & 1 \\\\ 0 & 3\\end{aligned}| \\\\  & =1(2-(-3))+2(4-0)+0(6-0) \\\\  & =13.\\end{aligned}\n$$\n\n \n\nSince we want the entry ${a}_{33}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{33}^{t}={c}_{33}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{33} & =(-1)^{3+3}|\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}| \\\\  & =+|\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}| \\\\  & =(1+4) \\\\  & =5.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{33}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{33}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{33} \\\\  & =\\frac{1}{13}\\cdot 5 \\\\  & =\\frac{5}{13}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319416" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-319416" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319416" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{13}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18286" "field" nil "attribute" "question/problem" "value" "Determine the entry ${a}_{32}^{′}$ in the inverse of the matrix $A$ $=[\\begin{aligned}1 & 4 & -1 \\\\ -3 & 2 & 0 \\\\ 0 & -1 & 3\\end{aligned}]$ if its determinant is $39.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18286" "field" nil "attribute" "question/worked-solution" "value" "Since we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}|\\begin{aligned}1 & 4 \\\\ 0 & -1\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & 4 \\\\ 0 & -1\\end{aligned}| \\\\  & =-(-1-0) \\\\  & =1.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′}=\\frac{1}{\\text{det}(A)}{c}_{23}=\\frac{1}{39}\\cdot 1=\\frac{1}{39}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18286" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-18286" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18286" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{11}{39}"] ["math" "-\\frac{1}{13}"] ["math" "-\\frac{1}{39}"] ["math" "\\frac{1}{13}"] ["math" "\\frac{1}{39}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18286" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{39}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319549" "field" nil "attribute" "question/problem" "value" "Determine the entry ${a}_{21}^{′}$ in the inverse of a matrix \n\n$$\nA=[\\begin{aligned}3 & 0 & 1 \\\\ 1 & 2 & 0 \\\\ 2 & 1 & 1\\end{aligned}]\n$$\n\nif its determinant is $3.$\n\n${a}_{21}^{′}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319549" "field" nil "attribute" "question/worked-solution" "value" "Since we want the entry ${a}_{21}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{12} & =(-1)^{1+2}|\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}| \\\\  & =-1|\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}| \\\\  & =-\\,(1\\cdot 1-0\\cdot 2) \\\\  & =-1.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{21}^{′} & =\\frac{1}{det(A)}\\,{c}_{12} \\\\  & =\\frac{1}{3}\\cdot (-1) \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319549" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-319549" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319549" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18283" "field" nil "attribute" "question/problem" "value" "Determine the entry ${a}_{13}^{′}$ in the inverse of a matrix $A$ $=[\\begin{aligned}0 & 5 & 1 \\\\ 2 & -1 & 3 \\\\ 2 & 2 & 4\\end{aligned}]$ if its determinant is $-4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18283" "field" nil "attribute" "question/worked-solution" "value" "Since we want the entry ${a}_{13}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{31}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{31} & =(-1)^{3+1}|\\begin{aligned}5 & 1 \\\\ -1 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}5 & 1 \\\\ -1 & 3\\end{aligned}| \\\\  & =15-(-1) \\\\  & =16.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{13}^{′}=\\frac{1}{\\text{det}(A)}{c}_{31}=\\frac{1}{-4}\\cdot 16=-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18283" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-18283" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18283" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-4"] ["math" "-8"] ["math" "4"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-18283" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73545" "field" nil "attribute" "question/problem" "value" "The entry ${a}_{11}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}2 & 1 & 0 \\\\ 0 & -1 & 3 \\\\ 1 & 2 & k\\end{aligned}]$\nequals $\\frac{4}{5}.$ Find the value of $k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73545" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=|\\begin{aligned}2 & 1 & 0 \\\\ 0 & -1 & 3 \\\\ 1 & 2 & k\\end{aligned}| & =2|\\begin{aligned}-1 & 3 \\\\ 2 & k\\end{aligned}|-1|\\begin{aligned}0 & 3 \\\\ 1 & k\\end{aligned}|+0|\\begin{aligned}0 & -1 \\\\ 1 & 2\\end{aligned}| \\\\  & =2(-k-6)-(0-3) \\\\  & =-2k-9.\\end{aligned}\n$$\n\nSince we want the entry ${a}_{11}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{11}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{11} & =(-1)^{1+1}|\\begin{aligned}-1 & 3 \\\\ 2 & k\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 3 \\\\ 2 & k\\end{aligned}| \\\\  & =-k-6.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{11}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{11} \\\\  & =\\frac{1}{-2k-9}\\cdot (-k-6) \\\\  & =\\frac{k+6}{2k+9}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{11}^{′}=\\frac{4}{5}$, we have\n\n$$\n\\begin{aligned}\\frac{k+6}{2k+9} & =\\frac{4}{5} \\\\ 5(k+6) & =4(2k+9) \\\\ 5k+30 & =8k+36 \\\\ 3k & =-6 \\\\ k & =-2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73545" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-73545" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73545" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-3"] ["math" "-9"] ["math" "2"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73545" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73535" "field" nil "attribute" "question/problem" "value" "The entry ${a}_{33}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}1 & 1 & k \\\\ -1 & 2 & 3 \\\\ 0 & -3 & -1\\end{aligned}]$\nequals $\\frac{1}{4}$ and $det(A)=6+3k.$ Find the value of $k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73535" "field" nil "attribute" "question/worked-solution" "value" "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=6+3k\n$$\n\nSince we want the entry ${a}_{33}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{33}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{33} & =(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =2-(-1) \\\\  & =3\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{33}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{33} \\\\  & =\\frac{1}{6+3k}\\cdot 3 \\\\  & =\\frac{1}{2+k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{33}^{′}=\\frac{1}{4}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{2+k} \\\\ 2+k & =4 \\\\ k & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73535" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-73535" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73535" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-4"] ["math" "2"] ["math" "4"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-73535" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-104428" "field" nil "attribute" "question/problem" "value" "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}0 & 0 & 1 \\\\ k & 1 & 1 \\\\ -2 & 2 & 1\\end{aligned}]$\nequals $\\frac{1}{2}$ and $det(A)=2k+2.$ Find the value of $k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-104428" "field" nil "attribute" "question/worked-solution" "value" "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=2k+2\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}|\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}| \\\\  & =-(0-2) \\\\  & =2\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{2k+2}\\cdot 2 \\\\  & =\\frac{1}{k+1}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{12}^{′}=\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k+1} & =\\frac{1}{2} \\\\ k+1 & =2 \\\\ k & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-104428" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-104428" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-104428" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-104428" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-275756" "field" nil "attribute" "question/problem" "value" "The entry ${a}_{12}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}1 & 0 & -1 \\\\ 1 & -1 & -1 \\\\ 0 & 1 & k\\end{aligned}]$\nequals $-\\frac{1}{2}$ and $det(A)=-k.$ Find the value of $k.$\n\n$k=${{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-275756" "field" nil "attribute" "question/worked-solution" "value" "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=-k\n$$\n\nSince we want the entry ${a}_{12}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{12}^{t}={c}_{21}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{21} & =(-1)^{2+1}|\\begin{aligned}0 & -1 \\\\ 1 & k\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & -1 \\\\ 1 & k\\end{aligned}| \\\\  & =-(0+1) \\\\  & =-1\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{12}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{12}^{t} \\\\  & =\\frac{1}{\\text{det}(A)}{c}_{21} \\\\  & =\\frac{1}{(-k)}\\cdot (-1) \\\\  & =\\frac{1}{k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{12}^{′}=-\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{k} & =-\\frac{1}{2} \\\\ k & =-2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-275756" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-275756" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-275756" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319944" "field" nil "attribute" "question/problem" "value" "The entry ${a}_{32}^{′}$ in the inverse of the matrix\n\n$$\nA=[\\begin{aligned}-2 & -2 & -2 \\\\ -2 & -1 & -2 \\\\ k & -2 & -1\\end{aligned}]\n$$\n\nequals $-2.$ Find the value of $k.$\n\n$k=${{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319944" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the determinant of $A:$\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-2 & -2 & -2 \\\\ -2 & -1 & -2 \\\\ k & -2 & -1\\end{aligned}| \\\\  & =(-2)|\\begin{aligned}-1 & -2 \\\\ -2 & -1\\end{aligned}|-(-2)|\\begin{aligned}-2 & -2 \\\\ k & -1\\end{aligned}|+(-2)|\\begin{aligned}-2 & -1 \\\\ k & -2\\end{aligned}| \\\\  & =(-2)((-1)(-1)-(-2)(-2))+2((-2)(-1)-(-2)k)+(-2)((-2)(-2)-(-1)k) \\\\  & =(-2)(1-4)+2(2+2k)+(-2)(4+k) \\\\  & =6+4+4k-8-2k \\\\  & =2k+2\\end{aligned}\n$$\n\nSince we want the entry ${a}_{32}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{32}^{t}={c}_{23}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{23} & =(-1)^{2+3}|\\begin{aligned}-2 & -2 \\\\ k & -2\\end{aligned}| \\\\  & =-((-2)(-2)-(-2)k) \\\\  & =-(4+2k) \\\\  & =-2k-4.\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{32}^{′} & =\\frac{1}{det(A)}{c}_{32}^{t} \\\\  & =\\frac{1}{det(A)}{c}_{23} \\\\  & =\\frac{-2k-4}{2k+2} \\\\  & =-\\frac{k+2}{k+1}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{32}^{′}=-2$, we have\n\n$$\n\\begin{aligned}-\\frac{k+2}{k+1} & =-2 \\\\ \\frac{k+2}{k+1} & =2 \\\\ k+2 & =2k+2 \\\\ k & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319944" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/activity-metadata.json" "file_sha256" "7b48a372790fc37c025de034462efbe04277ae345a801af901d5dcb0a718011b"} {"question" "q-319944" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "q-319944" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/state.json" "file_sha256" "61f3e0f7297cb165d4eae2a6765b99446c040f0b5658df70520a6e1fe8d34b83"} {"question" "e-4514" "field" nil "attribute" "question/problem" "value" "Find the inverse of $[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 4 & -3 & 8\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4514.json" "file_sha256" "ba410b9f602b76425b2ca4aad6e52ff839c3c87ec3f1f8c843054b1623826485"} {"question" "e-4514" "field" nil "attribute" "question/worked-solution" "value" "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A.$\n\n$$\n\\begin{aligned}det(A)=|\\begin{aligned}0 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 4 & -3 & 8\\end{aligned}| & =0|\\begin{aligned}0 & 3 \\\\ -3 & 8\\end{aligned}|-1|\\begin{aligned}1 & 3 \\\\ 4 & 8\\end{aligned}|+2|\\begin{aligned}1 & 0 \\\\ 4 & -3\\end{aligned}| \\\\  & =0-(8-12)+2(-3-0) \\\\  & =-2\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}0 & 3 \\\\ -3 & 8\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 4 & 8\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 4 & -3\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ -3 & 8\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 4 & 8\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 4 & -3\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ 0 & 3\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}9 & -4 & -3 \\\\ 14 & -8 & -4 \\\\ 3 & -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\n[\\begin{aligned}9 & -(-4) & -3 \\\\ -(14) & -8 & -(-4) \\\\ 3 & -(-2) & -1\\end{aligned}]\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n[\\begin{aligned}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{aligned}]\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{-2}[\\begin{aligned}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{aligned}] \\\\  & =-\\frac{1}{2}[\\begin{aligned}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{9}{2} & 7 & -\\frac{3}{2} \\\\ -2 & 4 & -1 \\\\ \\frac{3}{2} & -2 & \\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4514.json" "file_sha256" "ba410b9f602b76425b2ca4aad6e52ff839c3c87ec3f1f8c843054b1623826485"} {"question" "e-4516" "field" nil "attribute" "question/problem" "value" "Determine the entry $a'_{23}$ in the inverse of the matrix $[\\begin{aligned}-2 & 3 & -3 \\\\ 0 & 1 & 0 \\\\ 1 & -1 & 2\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4516.json" "file_sha256" "b1948ce779130df2cc885c1d39d88a5c3e8d3136b4e46ef64013d5f86ba5724d"} {"question" "e-4516" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the determinant of $A\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A)=|\\begin{aligned}-2 & 3 & -3 \\\\ 0 & 1 & 0 \\\\ 1 & -1 & 2\\end{aligned}| & =-2|\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}|-3|\\begin{aligned}0 & 0 \\\\ 1 & 2\\end{aligned}|+(-3)|\\begin{aligned}0 & 1 \\\\ 1 & -1\\end{aligned}| \\\\  & =-2(2-0)-3(0-0)-3(0-1) \\\\  & =-1\\end{aligned}\n$$\n\nSince we want the entry $a'_{23}$ in $A^{-1},$ we need to know the value of $c_{32}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{32} & =(-1)^{3+2}{M}_{32} \\\\  & =(-1)^{5}|\\begin{aligned}-2 & -3 \\\\ 0 & 0\\end{aligned}| \\\\  & =-1\\cdot (0) \\\\  & =0.\\end{aligned}\n$$\n\nThen, since $A^{-1}=\\dfrac{1}{\\det (A)}C^{T},$ we have\n\n$$\na'_{23} = \\dfrac{1}{-1}c_{32} = -1\\cdot 0 = 0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4516.json" "file_sha256" "b1948ce779130df2cc885c1d39d88a5c3e8d3136b4e46ef64013d5f86ba5724d"} {"question" "e-4515" "field" nil "attribute" "question/problem" "value" "The entry $a'_{31}$ in the inverse of the matrix\n$[\\begin{aligned}3 & 2 & -2 \\\\ -2 & k & 0 \\\\ -1 & -3 & 3\\end{aligned}]$ \nequals $1$. Find the value of $k$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4515.json" "file_sha256" "868190397d4bc15ef5332195462c8688812877ed15ebbb02c5cd1f81047ca533"} {"question" "e-4515" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find the determinant of $A\\mathbin{:}$\n\n$$\n\\begin{aligned}det(A)=|\\begin{aligned}3 & 2 & -2 \\\\ -2 & k & 0 \\\\ -1 & -3 & 3\\end{aligned}| & =3|\\begin{aligned}k & 0 \\\\ -3 & 3\\end{aligned}|-2|\\begin{aligned}-2 & 0 \\\\ -1 & 3\\end{aligned}|+(-2)|\\begin{aligned}-2 & k \\\\ -1 & -3\\end{aligned}| \\\\  & =3(3k-0)-2(-6-0)-2(6+k) \\\\  & =9k+12-12-2k \\\\  & =7k.\\end{aligned}\n$$\n\nSince we want the entry $a'_{31}$ in $A^{-1},$ we need to know the value of $c_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{13} & =(-1)^{1+3}|\\begin{aligned}-2 & k \\\\ -1 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & k \\\\ -1 & -3\\end{aligned}| \\\\  & =6+k.\\end{aligned}\n$$\n\nThen, since $A^{-1}=\\dfrac{1}{\\det (A)}C^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{31}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{13} \\\\  & =\\frac{1}{7k}\\cdot (6+k) \\\\  & =\\frac{6+k}{7k}.\\end{aligned}\n$$\n\nFinally, since we are told that $a'_{31}=1$, we have\n\n$$\n\\begin{aligned}\\frac{6+k}{7k} & =1 \\\\ 6+k & =7k \\\\ 6 & =6k \\\\ k & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975233/example-4515.json" "file_sha256" "868190397d4bc15ef5332195462c8688812877ed15ebbb02c5cd1f81047ca533"}] "usage" {"e-4516" [] "e-4514" [] "e-4515" []} "basis" 766 "retractions" [[17592186059487 :question/problem "Find the inverse of $\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 4 & -3 & 8\\end{bmatrix}$"] [17592186059487 :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** Find the determinant of $A$.\n\n$$\n\\begin{aligned}\ndet(A) =\\begin{vmatrix}0 & 1 & 2 \\\\ 1 & 0 & 3 \\\\ 4 & -3 & 8\\end{vmatrix} &= 0\\begin{vmatrix}0 & 3 \\\\ -3 & 8\\end{vmatrix}- 1\\begin{vmatrix}1 & 3 \\\\ 4 & 8\\end{vmatrix}+ 2\\begin{vmatrix}1 & 0 \\\\ 4 & -3\\end{vmatrix} \\\\\n&= 0 - (8 - 12) + 2(-3 - 0) \\\\\n&=-2\n\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A$.\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}\nM &= [\\begin{vmatrix}0 & 3 \\\\ -3 & 8\\end{vmatrix} \\mid \\mid 1\\begin{vmatrix}3 \\\\ 4\\end{vmatrix}8 \\mid \\mid \\mid 1\\begin{vmatrix}0 \\\\ 4\\end{vmatrix}- 3 \\mid \\\\\n&= \\begin{vmatrix}1 & 2 \\\\ -3 & 8\\end{vmatrix} \\mid \\mid 0\\begin{vmatrix}2 \\\\ 4\\end{vmatrix}8 \\mid \\mid \\mid 0\\begin{vmatrix}1 \\\\ 4\\end{vmatrix}- 3 \\mid \\\\\n&= \\begin{vmatrix}1 & 2 \\\\ 0 & 3\\end{vmatrix} \\mid \\mid 0\\begin{vmatrix}2 \\\\ 1\\end{vmatrix}3 \\mid \\mid \\mid 0\\begin{vmatrix}1 \\\\ 1\\end{vmatrix}0 \\mid ] \\\\\n&= \\begin{bmatrix}9 & -4 & -3 \\\\ 14 & -8 & -4 \\\\ 3 & -2 & -1\\end{bmatrix}\n\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\n\\begin{bmatrix}9 & - (-4) & -3 \\\\ - (14) & -8 & - (-4) \\\\ 3 & - (-2) & -1\\end{bmatrix}\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n\\begin{bmatrix}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{bmatrix}\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}\nA^{-1} &= (1)/(det(A))C^{T} \\\\\n&= \\frac{1}{-2}\\begin{bmatrix}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{bmatrix} \\\\\n&=-\\frac{1}{2}\\begin{bmatrix}9 & -14 & 3 \\\\ 4 & -8 & 2 \\\\ -3 & 4 & -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-\\frac{9}{2} & 7 & -\\frac{3}{2} \\\\ -2 & 4 & -1 \\\\ \\frac{3}{2} & -2 & \\frac{1}{2}\\end{bmatrix}\n\\end{aligned}\n$$"] [17592186059489 :question/problem "Determine the entry $a'_{23}$ in the inverse of the matrix $\\begin{bmatrix}-2 & 3 & -3 \\\\ 0 & 1 & 0 \\\\ 1 & -1 & 2\\end{bmatrix}$"] [17592186059489 :question/worked-solution "First, we need to find the determinant of $A$:\n\n$$\n\\begin{aligned}\ndet(A) =\\begin{vmatrix}-2 & 3 & -3 \\\\ 0 & 1 & 0 \\\\ 1 & -1 & 2\\end{vmatrix} &= -2\\begin{vmatrix}1 & 0 \\\\ -1 & 2\\end{vmatrix}- 3\\begin{vmatrix}0 & 0 \\\\ 1 & 2\\end{vmatrix}+ (-3)\\begin{vmatrix}0 & 1 \\\\ 1 & -1\\end{vmatrix} \\\\\n&=-2(2 - 0) - 3(0 - 0) - 3(0 - 1) \\\\\n&=-1\n\\end{aligned}\n$$\n\nSince we want the entry $a'_{23}$ in $A^{-1}$, we need to know the value of $c_{32}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}\nc_{32} &= (-1)^{3 + 2}M_{32} \\\\\n&= (-1)^{5}\\begin{vmatrix}-2 & -3 \\\\ 0 & 0\\end{vmatrix} \\\\\n&=-1 \\cdot (0) \\\\\n&= 0\n\\end{aligned}\n$$\n\nThen, since\n\n$$\nA^{-1}=\\dfrac{1}{\\det (A)}C^{T}\n$$\n\nwe have\n\n$$\na'_{23} = \\dfrac{1}{-1}c_{32} = -1\\cdot 0 = 0\n$$"] [17592186059488 :question/problem "The entry $a'_{31}$ in the inverse of the matrix\n$\\begin{bmatrix}3 & 2 & -2 \\\\ -2 & k & 0 \\\\ -1 & -3 & 3\\end{bmatrix}$\nequals $1$. Find the value of $k$."] [17592186059488 :question/worked-solution "First, we need to find the determinant of $A$:\n\n$$\n\\begin{aligned}\ndet(A) =\\begin{vmatrix}3 & 2 & -2 \\\\ -2 & k & 0 \\\\ -1 & -3 & 3\\end{vmatrix} &= 3\\begin{vmatrix}k & 0 \\\\ -3 & 3\\end{vmatrix}- 2\\begin{vmatrix}-2 & 0 \\\\ -1 & 3\\end{vmatrix}+ (-2)\\begin{vmatrix}-2 & k \\\\ -1 & -3\\end{vmatrix} \\\\\n&= 3(3k - 0) - 2(-6 - 0) - 2(6 + k) \\\\\n&= 9k + 12 - 12 - 2k \\\\\n&= 7k\n\\end{aligned}\n$$\n\nSince we want the entry $a'_{31}$ in $A^{-1}$, we need to know the value of $c_{13}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}\nc_{13} &= (-1)^{1 + 3}\\begin{vmatrix}-2 & k \\\\ -1 & -3\\end{vmatrix} \\\\\n&=\\begin{vmatrix}-2 & k \\\\ -1 & -3\\end{vmatrix} \\\\\n&= 6 + k\n\\end{aligned}\n$$\n\nThen, since\n\n$$\nA^{-1}=\\dfrac{1}{\\det (A)}C^{T}\n$$\n\nwe have\n\n$$\n\\begin{aligned}\na_{31}^{′} &= (1)/(det(A))c_{13} \\\\\n&= \\frac{1}{7k} \\cdot (6 + k) \\\\\n&= \\frac{6 + k}{7k}\n\\end{aligned}\n$$\n\nFinally, since we are told that $a'_{31}=1$, we have\n\n$$\n\\begin{aligned}\n\\frac{6 + k}{7k} &= 1 \\\\\n6 + k &= 7k \\\\\n6 &= 6k \\\\\nk &= 1\n\\end{aligned}\n$$"]] "immutable_answers" [] "immutable_fields" [] "no_history" []}
