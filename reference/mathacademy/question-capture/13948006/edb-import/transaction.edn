to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72333/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1"] :knowledge-point/questions ["q-72333"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115518/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "449e0cd6-3877-5ca5-8136-29257943bc39" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-115518/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "3d858df7-bf48-5787-a254-25eef37bd904" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-115518/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a691ab8a-ab38-57ad-b326-c9142195c3c5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-115518/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" :answer/id #uuid "3635b4b7-dbc1-50e2-9508-07653c5eae0d" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "q-115518/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "bab86782-d9bb-56c7-bad8-4ede4c44f9b1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-115518/selection" :answer-field/id #uuid "fbfb649e-94a5-5d22-bd25-8a9d0fc9807b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115518/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-115518/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-115518/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-115518/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-115518/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" "q-115518/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-115518" :question/id #uuid "7704ba1b-0c04-5988-a47b-f50e803b20fa" :question/math-academy-id "q-115518" :question/problem "Evaluate ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}{\\operatorname{ln}⁡(\\operatorname{tan}⁡x)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)=-\\infty $ and ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{ln}⁡(\\operatorname{tan}⁡x)=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}{\\operatorname{ln}⁡(\\operatorname{tan}⁡x)} & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{[\\operatorname{ln}⁡(\\operatorname{cos}⁡x)]^{′}}{{[\\operatorname{ln}⁡(\\operatorname{tan}⁡x)]}^{′}} \\\\  & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{(-\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})}{(\\frac{{sec}^{2}⁡x}{\\operatorname{tan}⁡x})} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{sin}⁡x\\operatorname{tan}⁡x}{{sec}^{2}⁡x\\operatorname{cos}⁡x} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{sin}⁡x(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})}{(\\frac{1}{{cos}^{2}⁡x})\\operatorname{cos}⁡x} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{{sin}^{2}⁡x}{(\\frac{1}{{cos}^{2}⁡x}){cos}^{2}⁡x} \\\\  & =-{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}{sin}^{2}⁡x \\\\  & =-{sin}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115518/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1"] :knowledge-point/questions ["q-115518"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72336/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "58beefc3-031f-5cd5-a1cb-88d181ca8560" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-72336/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "ad1ebf43-45cc-5265-af34-b7beb51b50f7" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-72336/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7d70b60a-66f3-5018-8388-0b5c424b7c01" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-72336/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "64cb2dc8-7204-5aca-bc9d-3cd91f16892c" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-72336/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "74263b53-7891-5221-9a88-5cdb3a71114a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-72336/selection" :answer-field/id #uuid "8317f879-b0d4-5e38-b202-437de1124e94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72336/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-72336/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-72336/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-72336/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-72336/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-72336/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-72336" :question/id #uuid "dc6b4e5b-14b3-521d-a29f-b6cecec742c1" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72336/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1"] :knowledge-point/questions ["q-72336"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336758/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "f84c8628-5fbb-5d13-b29a-d6c444b39cf5" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-336758/field-1" :answer-field/id #uuid "8636f221-317b-5f04-b70a-35d71fb0e0c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336758/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-336758/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-336758" :question/id #uuid "8411c106-d2f4-578b-8564-df4ec0ed1b0a" :question/math-academy-id "q-336758" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡({x}^{3})}=$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(5x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡({x}^{3})=-\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡({x}^{3})} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡(5x)]^{′}}{[\\operatorname{ln}⁡({x}^{3})]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{(\\frac{3}{x})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{3{x}^{-1}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{1}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336758/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1"] :knowledge-point/questions ["q-336758"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336798/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "90533308-3ecf-55cd-abff-87d11e9319a5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-336798/field-1" :answer-field/id #uuid "50f2985a-cac9-5db3-916b-e34e0ab57ca7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336798/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-336798/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-336798" :question/id #uuid "e36ca26f-ad8c-5e12-800b-7362e3a76a27" :question/math-academy-id "q-336798" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{cos}⁡(x))}{\\operatorname{sec}⁡(x)}=$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are  ${lim}_{x\\to (\\pi /2)^{-}}\\operatorname{ln}⁡(\\operatorname{cos}⁡x)=-\\infty $ and  ${lim}_{x\\to (\\pi /2)^{-}}\\operatorname{sec}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}{\\operatorname{sec}⁡x} & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{cos}⁡x)]}^{′}}{{[\\operatorname{sec}⁡x]}^{′}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{-\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x\\operatorname{tan}⁡x} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{\\cancel{-\\operatorname{tan}⁡x}}{\\operatorname{sec}⁡x\\cancel{\\operatorname{tan}⁡x}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}(-\\frac{1}{\\operatorname{sec}⁡x}) \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}\\operatorname{cos}⁡x \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336798/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e