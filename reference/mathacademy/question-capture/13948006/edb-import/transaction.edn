[{:db/id "q-31600/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "81f5109d-29b2-5253-a2f9-50b42c840bb3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-31600/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d676868b-83f4-55df-8f50-ba41a77b1a2f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-31600/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "82aeadd7-7668-5325-aee1-07791f347f6d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31600/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "d21a4d4d-4412-53e5-96a0-1ef04336a400" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-31600/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "219bc263-5c1a-5386-a7b2-76e8060b9e1a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-31600/selection" :answer-field/id #uuid "239fc2e8-f568-502a-a262-5043da11f00a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31600/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-31600/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-31600/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-31600/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-31600/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-31600/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-31600" :question/id #uuid "b71d8ef8-8478-5971-9e1b-9300d94d190a" :question/math-academy-id "q-31600" :question/problem "${lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2}=$" :question/worked-solution "Note that plugging in $x=-1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2} & ={lim}_{x\\to -1}\\frac{[x\\operatorname{ln}⁡(x+2)]^{′}}{[{x}^{2}+3x+2]^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\operatorname{ln}⁡(x+2)+\\frac{x}{x+2})}{2x+3} \\\\  & =\\frac{(\\operatorname{ln}⁡(-1+2)+\\frac{-1}{-1+2})}{2(-1)+3} \\\\  & =\\frac{\\operatorname{ln}⁡(1)-1}{1} \\\\  & =-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31600/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a"] :knowledge-point/questions ["q-31600"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31596"] :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x\\operatorname{cos}⁡x}{\\operatorname{ln}⁡(x+1)} & ={lim}_{x\\to 0}\\frac{[x\\operatorname{cos}⁡x]^{′}}{[\\operatorname{ln}⁡(x+1)]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x}{(\\frac{1}{x+1})} \\\\  & =\\frac{\\operatorname{cos}⁡0-0\\cdot \\operatorname{sin}⁡0}{(\\frac{1}{0+1})} \\\\  & =\\frac{1}{1} \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-336883/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "315d52c0-d1a2-5b6b-a646-e90d55b1759b" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-336883/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "19ae7e7b-421c-5005-a291-10461c8552c2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-336883/field-1" :answer-field/id #uuid "94a8f6a2-0cf7-5b7f-8cbb-88dc4ef14e43" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336883/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer-field/choices ["q-336883/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-336883/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-336883" :question/id #uuid "47c2f4a9-8658-5e42-99ca-a9c23bc8f50d" :question/math-academy-id "q-336883" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{e}^{2x}-1}{{x}^{2}+3x}=$\n{{field-1}}" :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{2x}-1}{{x}^{2}+3x} & ={lim}_{x\\to 0}\\frac{[{e}^{2x}-1]^{′}}{[{x}^{2}+3x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{2{e}^{2x}}{2x+3} \\\\  & =\\frac{2{e}^{2(0)}}{2(0)+3} \\\\  & =\\frac{2(1)}{0+3} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336883/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a"] :knowledge-point/questions ["q-336883"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31599/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c36e99e3-ed7c-5d00-8577-227a854bfd94" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-31599/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "be8889d9-c67e-5fd1-ab14-0e39d45ae81f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-31599/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "e91acd08-7285-5673-917a-8d232c5247b1" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-31599/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "da3b71ca-1326-51aa-8241-88b0e8a73db5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31599/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1ba81de5-6077-5f2c-b51e-759ffd25aab9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-31599/selection" :answer-field/id #uuid "d15c4033-23b7-5082-a9c1-42aa925529a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31599/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-31599/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-31599/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-31599/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-31599/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-31599/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-31599" :question/id #uuid "b111c6b4-8251-5718-bcbd-4e62b98ac06d" :question/math-academy-id "q-31599" :question/problem "${lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{{x}^{2}+x}=$" :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{{x}^{2}+x} & ={lim}_{x\\to 0}\\frac{[\\operatorname{sin}⁡x\\operatorname{cos}⁡x]^{′}}{[{x}^{2}+x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{2x+1} \\\\  & =\\frac{{cos}^{2}⁡0-{sin}^{2}⁡0}{2(0)+1} \\\\  & =\\frac{1-0}{1} \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31599/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a"] :knowledge-point/questions ["q-31599"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31602/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "37eebd4b-a06a-5c0a-9ecc-4d331b0b7425" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-31602/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3f1a6353-435e-5444-b15f-67f6fb61a382" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31602/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "1ecc71c5-0911-5a26-9042-66229f5633b6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-31602/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer/id #uuid "c831ca73-a9fc-5de1-992d-91c98d87a7c8" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-31602/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "034da7b8-c843-5eab-b670-c8c206abff01" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-31602/selection" :answer-field/id #uuid "d0592163-4499-5d7e-aa23-9febdcecf081" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31602/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer-field/choices ["q-31602/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-31602/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-31602/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" "q-31602/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" "q-31602/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-31602" :question/id #uuid "bbac401d-8c8d-5591-9b6a-f972608b1dea" :question/math-academy-id "q-31602" :question/problem "${lim}_{x\\to \\pi /4}\\frac{\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{\\operatorname{cos}⁡2x}=$" :question/worked-solution "Note that plugging in $x=\\frac{\\pi }{4}$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /4}\\frac{\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{\\operatorname{cos}⁡2x} & ={lim}_{x\\to \\pi /4}\\frac{[\\operatorname{sin}⁡x-\\operatorname{cos}⁡x]^{′}}{[\\operatorname{cos}⁡2x]^{′}} \\\\  & ={lim}_{x\\to \\pi /4}\\frac{\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{-2\\operatorname{sin}⁡2x} \\\\  & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{4})}{-2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})} \\\\  & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{4})}{-2\\operatorname{sin}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2}}{-2(1)} \\\\  & =-\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31602/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a"] :knowledge-point/questions ["q-31602"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336932/field-1/20a9716e6214643023afec8e5ea43f1227bda73b02028b48b8f0208261b3ae5a" :answer/id #uuid "04042993-3fef-5f55-95c5-115c760693bd" :answer/type :answer.type/math :answer/value "(\\ln(9))^2" :db/ensure [:answer/validate]} {:db/id "q-336932/field-1" :answer-field/id #uuid "f46dd4f2-d324-5542-a7e1-3429ab75b92c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336932/field-1/20a9716e6214643023afec8e5ea43f1227bda73b02028b48b8f0208261b3ae5a" :answer-field/choices ["q-336932/field-1/20a9716e6214643023afec8e5ea43f1227bda73b02028b48b8f0208261b3ae5a"] :db/ensure [:answer-field/validate]} {:db/id "q-336932" :question/id #uuid "9e0f7884-a830-5489-a8ed-a70ba5c64f35" :question/math-academy-id "q-336932" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)}=\\frac{1}{9}((\\operatorname{ln}⁡4)^{2}-$\n{{field-1}}\n$)$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)} & ={lim}_{x\\to 0}\\frac{{[{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x]}^{′}}{{[1-\\operatorname{cos}⁡(3x)]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{3\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{\\operatorname{sin}⁡(3x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)} & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{[{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)]}^{′}}{{[\\operatorname{sin}⁡(3x)]}^{′}} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}(\\operatorname{ln}⁡4)^{2}-{9}^{x}(\\operatorname{ln}⁡9)^{2}}{3\\operatorname{cos}⁡(3x)} \\\\  & =\\frac{1}{9}\\cdot \\frac{(\\operatorname{ln}⁡4)^{2}-(\\operatorname{ln}⁡9)^{2}}{1} \\\\  & =\\frac{1}{9}((\\operatorname{ln}⁡4)^{2}-(\\operatorname{ln}⁡9)^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336932/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1"] :knowledge-point/questions ["q-336932"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336943/field-1/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer/id #uuid "2a305fab-740e-5e18-8aca-2acded269fb7" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-336943/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "dfadd57c-05ac-533b-af96-66965a9b5919" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-336943/field-1" :answer-field/id #uuid "f0d131b6-cfe1-593b-a2e0-c9068697be76" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336943/field-1/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer-field/choices ["q-336943/field-1/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" "q-336943/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-336943" :question/id #uuid "6bab4c0c-7677-579a-8ee7-52df23ea6308" :question/math-academy-id "q-336943" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & ={lim}_{x\\to 0}\\frac{{[1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)]}^{′}}{{[1-\\operatorname{cos}⁡(3x)]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{4\\operatorname{sin}⁡(4x)+4\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{3\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{4}{3}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{\\operatorname{sin}⁡(3x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{1-\\operatorname{cos}⁡(4x)+{sin}^{2}⁡(2x)}{1-\\operatorname{cos}⁡(3x)} & =\\frac{4}{3}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)}{\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{4}{3}{lim}_{x\\to 0}\\frac{{[\\operatorname{sin}⁡(4x)+\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)]}^{′}}{[\\operatorname{sin}⁡(3x)]^{′}} \\\\  & =\\frac{4}{3}{lim}_{x\\to 0}\\frac{4\\operatorname{cos}⁡(4x)+2{cos}^{2}⁡(2x)-2{sin}^{2}⁡(2x)}{3\\operatorname{cos}⁡(3x)} \\\\  & =\\frac{4}{3}\\cdot \\frac{4+2}{3} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336943/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1"] :knowledge-point/questions ["q-336943"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114250/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer/id #uuid "bb598ad9-346b-57fd-86bc-464fad453a4b" :answer/type :answer.type/math :answer/value "{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-114250/selection/8edf36f0d0c04b8e0e3f881a66fab0f1901a06368d5ca1f6d437f77714de6bc5" :answer/id #uuid "f4eea8a1-99b2-5df2-8aa9-4b7be41bed25" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-114250/selection/befd90710524d6816cc6f9000f5fcbe3588260409ac32225f1f54a2401a94bd5" :answer/id #uuid "44381b3f-6776-56a0-9b39-7caf8acc8342" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-114250/selection/27b6b290159b137d6361e7e4a5864f4eb11e17e7cf948e4987251275b0b033b2" :answer/id #uuid "e2588752-2571-5af5-8f1c-40164f54d92f" :answer/type :answer.type/math :answer/value "-{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-114250/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" :answer/id #uuid "e6ea63fd-2ec6-533e-bc77-e0ee6d142100" :answer/type :answer.type/math :answer/value "2{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-114250/selection" :answer-field/id #uuid "dbf03e82-4adc-5a2b-a301-257c99585aae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114250/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer-field/choices ["q-114250/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" "q-114250/selection/8edf36f0d0c04b8e0e3f881a66fab0f1901a06368d5ca1f6d437f77714de6bc5" "q-114250/selection/befd90710524d6816cc6f9000f5fcbe3588260409ac32225f1f54a2401a94bd5" "q-114250/selection/27b6b290159b137d6361e7e4a5864f4eb11e17e7cf948e4987251275b0b033b2" "q-114250/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44"] :db/ensure [:answer-field/validate]} {:db/id "q-114250" :question/id #uuid "0910a0b7-374a-578c-b2a2-b95c0ef0d221" :question/math-academy-id "q-114250" :question/problem "${lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1}=$" :question/worked-solution "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{[2+2\\operatorname{cos}⁡(\\pi x)]^{′}}{[{x}^{2}-2x+1]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{-2\\pi \\operatorname{sin}⁡(\\pi x)}{2x-2} \\\\  & =-{lim}_{x\\to 1}\\frac{\\pi \\operatorname{sin}⁡(\\pi x)}{x-1}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1} & =-{lim}_{x\\to 1}\\frac{\\pi \\operatorname{sin}⁡(\\pi x)}{x-1} \\\\  & =-{lim}_{x\\to 1}\\frac{[\\pi \\operatorname{sin}⁡(\\pi x)]^{′}}{[x-1]^{′}} \\\\  & =-{lim}_{x\\to 1}\\frac{{\\pi }^{2}\\operatorname{cos}⁡(\\pi x)}{1} \\\\  & =-{\\pi }^{2}\\operatorname{cos}⁡\\pi  \\\\  & ={\\pi }^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114250/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1"] :knowledge-point/questions ["q-114250"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336901/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "45d0a167-8e89-5c29-89cc-a5c9423a3c3e" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-336901/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3619c18b-55a3-5516-b3fa-6e2be40076ac" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336901/field-1" :answer-field/id #uuid "b869acb6-d4c6-57ea-a8b6-b4c495631520" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336901/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-336901/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-336901/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336901" :question/id #uuid "a1ad199e-1393-5a2a-997a-7d759f8f08bb" :question/math-academy-id "q-336901" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 3}\\frac{{x}^{2}-6x+9}{16\\sqrt{x+1}-4x-20}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=3$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-6x+9}{16\\sqrt{x+1}-4x-20} & ={lim}_{x\\to 3}\\frac{{[{x}^{2}-6x+9]}^{′}}{[16\\sqrt{x+1}-4x-20]^{′}} \\\\  & ={lim}_{x\\to 3}\\frac{2x-6}{(\\frac{8}{\\sqrt{x+1}}-4)} \\\\  & ={lim}_{x\\to 3}\\frac{x-3}{4(x+1)^{-1/2}-2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-6x+9}{16\\sqrt{x+1}-4x-20} & ={lim}_{x\\to 3}\\frac{x-3}{4(x+1)^{-1/2}-2} \\\\  & ={lim}_{x\\to 3}\\frac{{[x-3]}^{′}}{{[4(x+1)^{-1/2}-2]}^{′}} \\\\  & ={lim}_{x\\to 3}\\frac{1}{-2(x+1)^{-3/2}} \\\\  & =-\\frac{1}{2}{lim}_{x\\to 3}(x+1)^{3/2} \\\\  & =-\\frac{1}{2}(3+1)^{3/2} \\\\  & =-\\frac{1}{2}\\cdot 8 \\\\  & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336901/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1"] :knowledge-point/questions ["q-336901"] :db/ensure [:knowledge-point/validate]} {:db/id "q-314154/field-1/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "9bb36c53-2c0c-5aad-a5a4-9ec26dc9c4f0" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-314154/field-1" :answer-field/id #uuid "fc4e6e79-8887-584d-9683-5e1c83d5229e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-314154/field-1/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer-field/choices ["q-314154/field-1/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45"] :db/ensure [:answer-field/validate]} {:db/id "q-314154" :question/id #uuid "8e87652e-4354-5168-9826-2b467c5af2d2" :question/math-academy-id "q-314154" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 8}\\frac{{x}^{2}-16x+64}{18\\sqrt{x+1}-3x-30}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=8$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 8}\\frac{{x}^{2}-16x+64}{18\\sqrt{x+1}-3x-30} & ={lim}_{x\\to 8}\\frac{{[{x}^{2}-16x+64]}^{′}}{[18\\sqrt{x+1}-3x-30]^{′}} \\\\  & ={lim}_{x\\to 8}\\frac{2x-16}{\\frac{9}{\\sqrt{x+1}}-3} \\\\  & ={lim}_{x\\to 8}\\frac{2x-16}{9(x+1)^{-1/2}-3}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 8}\\frac{{x}^{2}-16x+64}{18\\sqrt{x+1}-3x-30} & ={lim}_{x\\to 8}\\frac{2x-16}{9(x+1)^{-1/2}-3} \\\\  & ={lim}_{x\\to 8}\\frac{{[2x-16]}^{′}}{{[9(x+1)^{-1/2}-3]}^{′}} \\\\  & ={lim}_{x\\to 8}\\frac{2}{-\\frac{9}{2}(x+1)^{-3/2}} \\\\  & =-\\frac{4}{9}{lim}_{x\\to 8}(x+1)^{3/2} \\\\  & =-\\frac{4}{9}(8+1)^{3/2} \\\\  & =-\\frac{4}{9}\\cdot 27 \\\\  & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-314154/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1"] :knowledge-point/questions ["q-314154"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72333/selection/954f2b2ecf089f1c43903a74f4575cff67