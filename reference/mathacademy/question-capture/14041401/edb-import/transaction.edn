[{:db/id "q-47679/selection/95c6ba30ce3c7684f1197efda4e2524335aff88226953ff756ca6ac7dd99294e" :answer/id #uuid "b215d962-5791-5437-98a0-e524d0193852" :answer/type :answer.type/text :answer/value "II and  III only" :db/ensure [:answer/validate]} {:db/id "q-47679/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "dd83a898-96f9-523f-948e-e7db6ba6c270" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-47679/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1aa03c7e-e846-57c8-ab0c-d3f972808f73" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-47679/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "67b4f277-4b85-5a80-a9d1-40654b33c52b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-47679/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "d0dcf4d5-9f47-5ef3-8cca-8d6e4015fb5a" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-47679/selection" :answer-field/id #uuid "4a40f4f1-0f18-549a-bebf-abfe7f0c4dca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47679/selection/95c6ba30ce3c7684f1197efda4e2524335aff88226953ff756ca6ac7dd99294e" :answer-field/choices ["q-47679/selection/95c6ba30ce3c7684f1197efda4e2524335aff88226953ff756ca6ac7dd99294e" "q-47679/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-47679/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-47679/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-47679/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-47679" :question/id #uuid "ce79bb41-27b4-5b41-8558-5c87fd6419d0" :question/math-academy-id "q-47679" :question/problem "Given that that a function $f(x)$ is continuous at $x=1$, has a jump discontinuity at $x=2$, and  is differentiable at $x=3$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\n- It is differentiable at $x=1$\n- It  is **not** differentiable at $x=2$\n- It is continuous at $x=3$" :question/worked-solution "- Statement I is false. Continuity does not imply differentiability. For example, the function $y=|x-1|$ is continuous but it's not differentiable at $x=1.$\n\n- Statement II is true.  A function that is discontinuous at a point can't be differentiable at this point (because differentiability implies continuity).\n\n- Statement III is true. Indeed, differentiability implies continuity." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-47679/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7"] :knowledge-point/questions ["q-47679"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47686/selection/8ed6af7c552f6eb1cb5f1c0e2ea3c37e670b9775c33d93be9d981f01a96cf476" :answer/id #uuid "f8676dba-6d46-56c1-afa9-ab19df53e26a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/1f9ccdd0ab4829b8f5fe53660c8d7a48dd5f85b90f979bc7d927e4a141d2e6c2.png" :db/ensure [:answer/validate]} {:db/id "q-47686/selection/4be05adfb88c260129899cda7a5d99230d958172d0f08d895fec77a410fde484" :answer/id #uuid "728ca005-3873-541b-a9e1-018363568381" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/2733ec295867c20225f4b5d75f5cbe4bfbc91d9b8f3739520bcf4ce75c4d185c.png" :db/ensure [:answer/validate]} {:db/id "q-47686/selection/e3b6f36fdedb21c3021e5b77e3d74662a27e9d12ff7d1b321a4753c27029c3c4" :answer/id #uuid "1d723d76-f3af-5954-b786-cdf27bdced07" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/6d8c3bcf0d95b358b601f55746b256d1edf936c88e0dc4bd6c119fdb45327150.png" :db/ensure [:answer/validate]} {:db/id "q-47686/selection/3713d56b00d8e324ade921c56a6155d903e3fa8b6963f7060c0d58a1a2653fde" :answer/id #uuid "e0a642e4-3fc5-5ed1-8b02-6ffeba569d3f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/a8b5f35bec07979fc1e0d1eb4de3e6ad369bbce48ec4e1943380b9bac2e9feee.png" :db/ensure [:answer/validate]} {:db/id "q-47686/selection/46eaaef4810505c43abb2922ec43a35a449173f9c2e8fe0a7137738dbaad4f2e" :answer/id #uuid "d240a1c3-78f2-5554-b048-4e7efcdd19ea" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/3ec213a7183bd1a9ed039d185361581b4a687462a8bfd0e5f885090bf53bf09f.png" :db/ensure [:answer/validate]} {:db/id "q-47686/selection" :answer-field/id #uuid "12203f6f-7440-5b0c-9932-ecf631576a1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47686/selection/4be05adfb88c260129899cda7a5d99230d958172d0f08d895fec77a410fde484" :answer-field/choices ["q-47686/selection/8ed6af7c552f6eb1cb5f1c0e2ea3c37e670b9775c33d93be9d981f01a96cf476" "q-47686/selection/4be05adfb88c260129899cda7a5d99230d958172d0f08d895fec77a410fde484" "q-47686/selection/e3b6f36fdedb21c3021e5b77e3d74662a27e9d12ff7d1b321a4753c27029c3c4" "q-47686/selection/3713d56b00d8e324ade921c56a6155d903e3fa8b6963f7060c0d58a1a2653fde" "q-47686/selection/46eaaef4810505c43abb2922ec43a35a449173f9c2e8fe0a7137738dbaad4f2e"] :db/ensure [:answer-field/validate]} {:db/id "q-47686" :question/id #uuid "509c565e-90e4-5255-a4cc-bb56af4023be" :question/math-academy-id "q-47686" :question/problem "Which of the following functions is not differentiable over the interval $(-1,1)$ due to the existence of a vertical asymptote at a point in this interval?" :question/worked-solution "The function $y=g(x)$ has a vertical asymptote at $x=\\frac{1}{2}$ and is  therefore not differentiable at $x=\\frac{1}{2}.$ So $y=g(x)$ is the correct answer.\n\nThe other graphs do not have a a vertical asymptote inside the interval $(-1,1).$\n\n- The function $y=p(x)$ has a corner point at $x=-\\frac{1}{2}$ and is therefore not differentiable at $x=-\\frac{1}{2}.$\n\n- The function $y=h(x)$ has a vertical tangent at $x=0$ and is therefore not differentiable at $x=0.$\n\n- The function $y=q(x)$ is smooth and continuous over the entire interval $x\\in (-1,1)$ and is therefore differentiable at every point in the interval.\n\n- The function $y=f(x)$ has a removable discontinuity at $x=\\frac{1}{2}$ and is therefore not differentiable at $x=\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-47686/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7"] :knowledge-point/questions ["q-47686"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51072/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "82b3c270-7a40-5464-b310-b3a888f5b8c0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-51072/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "1e6dc404-d0ad-578a-a4c2-50e01302a340" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-51072/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "6b597046-23f4-523f-82ab-9d748f95e09d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-51072/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "1daee3c4-25c0-5a44-9f89-7812e62c84b2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-51072/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "b4ebe23f-544f-512b-86b1-feef130322cc" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-51072/selection" :answer-field/id #uuid "3e8d993c-a55e-5d01-8b95-bb9fbc6e9a58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51072/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-51072/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-51072/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-51072/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-51072/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-51072/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-51072" :question/id #uuid "ba6055fe-aa65-5082-af20-e73dcea7d739" :question/math-academy-id "q-51072" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)={\\begin{aligned}-x+4, & x<1 \\\\ 0, & x=1 \\\\ x+2, & x>1\\end{aligned}\\,\n$$\n\n- It is continuous and differentiable at $x=1$\n- It is differentiable on the interval $(-2,2)$\n- It is **not** differentiable at $x=1$" :question/worked-solution "- Statement I is false and statement III is true. Indeed,  let's investigate the continuity of $f(x).$ It is continuous everywhere except, possibly, $x=1.$ At this point, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}(-x+4)=-1+4=3 \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}(x+2)=1+2=3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)={lim}_{x\\to {1}^{-}}f(x)\\ne f(1)=0,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ (it has a removable discontinuity there). Hence, it is also not differentiable at this point.\n\n- Statement II is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-2,2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-51072/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3"] :knowledge-point/questions ["q-51072"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101990/selection/565f087efc172cc689d6ac7a38ae1818e245a6f8995ecba68bcdf0ac5950b2ea" :answer/id #uuid "73f114d7-6f5c-551e-8bb9-063ca85bf34a" :answer/type :answer.type/text :answer/value "$x=1$ only" :db/ensure [:answer/validate]} {:db/id "q-101990/selection/2f96dbaeaf6e46e973b4afa90677727f9651d853a258756a5801c8e4e629613f" :answer/id #uuid "65c067d7-f046-5d57-8d8c-34c22b8730c3" :answer/type :answer.type/text :answer/value "$x=0$  and $x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-101990/selection/71aee0d65a85ddc5df2866ab5713f6cda21d3dd2026baf85c670284fdd0138a9" :answer/id #uuid "f25ef42a-3674-5ff0-9989-3a58615b83f2" :answer/type :answer.type/text :answer/value "The function is differentiable at all points." :db/ensure [:answer/validate]} {:db/id "q-101990/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" :answer/id #uuid "8dcf170c-0133-5a16-8d5e-3c13adb9ff7f" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-101990/selection/14d639c1a3a6ec8787a167267f8ad7f344bd2ec3c5938a2119ba89055450c1a6" :answer/id #uuid "bf08b3cc-c355-587a-9fb1-db1f15dc0149" :answer/type :answer.type/text :answer/value "$x=1$  and $x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-101990/selection" :answer-field/id #uuid "736246ce-6e99-51c1-804e-fe61834a2d55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101990/selection/565f087efc172cc689d6ac7a38ae1818e245a6f8995ecba68bcdf0ac5950b2ea" :answer-field/choices ["q-101990/selection/565f087efc172cc689d6ac7a38ae1818e245a6f8995ecba68bcdf0ac5950b2ea" "q-101990/selection/2f96dbaeaf6e46e973b4afa90677727f9651d853a258756a5801c8e4e629613f" "q-101990/selection/71aee0d65a85ddc5df2866ab5713f6cda21d3dd2026baf85c670284fdd0138a9" "q-101990/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" "q-101990/selection/14d639c1a3a6ec8787a167267f8ad7f344bd2ec3c5938a2119ba89055450c1a6"] :db/ensure [:answer-field/validate]} {:db/id "q-101990" :question/id #uuid "2bc55083-5fe5-54dc-baa4-8db953d3f94f" :question/math-academy-id "q-101990" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041401/assets/e73fd08c7745ed049975a3a7c3af2f69e88bf0b374db741f96ce1812dc40f5f5.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. At which points is the function $f(x)$ **not** differentiable?" :question/worked-solution "The function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n- At $x=1$ the function has a removable discontinuity, so it's not differentiable there.\n\nTherefore, the correct answer is $x=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101990/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7"] :knowledge-point/questions ["q-101990"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101998/selection/b15ae6b9ff1364fba2406022eb818e5f1ca42a08682b970c744fd9be3ab2de8a" :answer/id #uuid "6f452688-dfec-5200-bde2-7a963ffe7b49" :answer/type :answer.type/math :answer/value "p(x)=\\sqrt[3]{x}" :db/ensure [:answer/validate]} {:db/id "q-101998/selection/1af5dabd7eefc84098d83892bcea3f6b2594c7779bfa5472cba902cc927eb810" :answer/id #uuid "462d0bb6-ff7f-5d0e-bff0-1c60d80acbbe" :answer/type :answer.type/math :answer/value "q(x)={\\begin{aligned}x-1 & x<1 \\\\ x+1, & x\\ge 1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-101998/selection/58192b88081020894d6a873eb6ea28cccd84868ef72f684e48cd579a46a60c1e" :answer/id #uuid "1fe2d17f-ff9a-5fe5-8348-82e9ecb1583c" :answer/type :answer.type/math :answer/value "g(x)=-|x|" :db/ensure [:answer/validate]} {:db/id "q-101998/selection/accb23463ea05590dc699b5d9f27db201527fe2403d5a3ae082ee8f0ab188e4c" :answer/id #uuid "e0223612-a2eb-5def-9410-713fbfb11683" :answer/type :answer.type/math :answer/value "h(x)=\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-101998/selection/f9f03adc80dbfa1c0bc5ac5fe1e2e8f36b22bf5442be225f9b672223b9183ec5" :answer/id #uuid "ebeecb9f-e3db-510e-a4f1-5338a2743059" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{x}" :db/ensure [:answer/validate]} {:db/id "q-101998/selection" :answer-field/id #uuid "16f147b0-9ddc-539f-b672-71f768b20b62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101998/selection/1af5dabd7eefc84098d83892bcea3f6b2594c7779bfa5472cba902cc927eb810" :answer-field/choices ["q-101998/selection/b15ae6b9ff1364fba2406022eb818e5f1ca42a08682b970c744fd9be3ab2de8a" "q-101998/selection/1af5dabd7eefc84098d83892bcea3f6b2594c7779bfa5472cba902cc927eb810" "q-101998/selection/58192b88081020894d6a873eb6ea28cccd84868ef72f684e48cd579a46a60c1e" "q-101998/selection/accb23463ea05590dc699b5d9f27db201527fe2403d5a3ae082ee8f0ab188e4c" "q-101998/selection/f9f03adc80dbfa1c0bc5ac5fe1e2e8f36b22bf5442be225f9b672223b9183ec5"] :db/ensure [:answer-field/validate]} {:db/id "q-101998" :question/id #uuid "ea975bc3-faa7-5d1a-ad93-133065ece130" :question/math-academy-id "q-101998" :question/problem "Which of the following functions is differentiable at the point $x=0?$" :question/worked-solution "Notice that the function $q(x)$ is differentiable for all $x\\ne 1.$ Therefore, the correct answer is $q(x)={\\begin{aligned}x-1 & x<1 \\\\ x+1, & x\\ge 1\\end{aligned}.$\n\nAll other functions are not differentiable at $x=0.$\n\n- The function $f(x)$ is not defined at $x=0$, so it is not differentiable there.\n\n- The function $g(x)$ has a corner point at $x=0$, so it is not differentiable there.\n\n- The function $p(x)$ has a vertical tangent at  $x=0$, so it is not differentiable there.\n\n- The function $h(x)$ is not defined at $x=0$, so it is not differentiable there." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-101998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3"] :knowledge-point/questions ["q-101998"] :db/ensure [:knowledge-point/validate]}]
