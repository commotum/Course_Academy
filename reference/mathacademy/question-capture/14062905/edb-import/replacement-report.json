      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-12539",
          "field": null,
          "attribute": "question/problem",
          "value": "Construct the matrix of the linear transformation that acts on a vector in $\\mathbb{R}^2$ as follows (in the order given):\n\n- it rotates the vector by $\\dfrac{\\pi}{2}$ radians counterclockwise about the origin, and then\n\n- stretches the result by a stretch factor of $2$ parallel to the $x$-axis.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062905/example-12539.json",
