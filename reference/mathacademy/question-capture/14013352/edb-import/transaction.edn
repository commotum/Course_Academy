[{:db/id "q-2281/selection/75080b27ead7f80a7910e53f751c399c49bcd9b92ac91f417a422f06b3924fa6" :answer/id #uuid "8eb598f4-aef5-5831-9035-65cb7926c515" :answer/type :answer.type/math :answer/value "\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2281/selection/f26fca4916e6a60acb2811cb843fa59b0dffff789323e976a76c5fccf777b2b3" :answer/id #uuid "6e1cc4b6-9bdc-537d-b468-0e8a81608623" :answer/type :answer.type/math :answer/value "\\frac{9}{\\operatorname{ln}⁡x}+{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-2281/selection/7855ed31020076062b70e16726dd8a80824f9e034a7e5e5ddd334e4669ff7137" :answer/id #uuid "743f3559-fd45-50aa-b268-6428f816ad57" :answer/type :answer.type/math :answer/value "\\frac{x}{\\operatorname{ln}⁡9}-3{e}^{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2281/selection/a03286cbff57df63f9e8273d87fbc0f91eb5ac910b0fd6e341d6c7bb1d1e468c" :answer/id #uuid "d2294ad2-4fda-5263-9605-89cc1cb44fd1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡9}{{9}^{x}}+{e}^{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2281/selection/17a6a6418b245a2f12c52b061d2a994f14eb325c7cb406408d61bc6e0e4cfed1" :answer/id #uuid "d877fa7e-da62-5607-8a68-7a6113b8b1f6" :answer/type :answer.type/math :answer/value "\\frac{{x}^{9}}{\\operatorname{ln}⁡9}-3{e}^{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2281/selection" :answer-field/id #uuid "48f6d1ae-18fd-535a-9588-2fec5296aec0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2281/selection/75080b27ead7f80a7910e53f751c399c49bcd9b92ac91f417a422f06b3924fa6" :answer-field/choices ["q-2281/selection/75080b27ead7f80a7910e53f751c399c49bcd9b92ac91f417a422f06b3924fa6" "q-2281/selection/f26fca4916e6a60acb2811cb843fa59b0dffff789323e976a76c5fccf777b2b3" "q-2281/selection/7855ed31020076062b70e16726dd8a80824f9e034a7e5e5ddd334e4669ff7137" "q-2281/selection/a03286cbff57df63f9e8273d87fbc0f91eb5ac910b0fd6e341d6c7bb1d1e468c" "q-2281/selection/17a6a6418b245a2f12c52b061d2a994f14eb325c7cb406408d61bc6e0e4cfed1"] :db/ensure [:answer-field/validate]} {:db/id "q-2281" :question/id #uuid "0ac5a63d-ba5d-5b91-87a0-a208698bb5b6" :question/math-academy-id "q-2281" :question/problem "$\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x & =\\int {9}^{x}\\,\\text{d}x+3\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2281/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013"] :knowledge-point/questions ["q-2281"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73084/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "ab0ef3c9-9503-5d85-bf7e-bbc0d320a329" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-73084/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "807bbff5-24cd-5cf6-a308-25aab9d0d846" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-73084/selection/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" :answer/id #uuid "590f7a82-534e-5881-a2a4-b60a0c9c5df8" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-73084/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "6d38fdfd-fe89-587f-bde9-cafd1e17f69b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-73084/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b86b3061-41b3-5095-9d00-e339d320775d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-73084/selection" :answer-field/id #uuid "63c3a0ae-7715-5855-a1ff-9efcb9e5816c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73084/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-73084/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-73084/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" "q-73084/selection/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" "q-73084/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-73084/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-73084" :question/id #uuid "7e4d9326-2ae7-55cb-8a17-5cc3ba49aafc" :question/math-academy-id "q-73084" :question/problem "If $f(x)$ is right-continuous at $x=-1$ and $f(-1)=-2,$ then what is \n${lim}_{x\\to (-1)^{+}}\\,\\frac{1}{3f(x)-10x}?$" :question/worked-solution "Since $f(x)$ is right-continuous at $x=-1,$ we must have\n\n$$\n{lim}_{x\\to (-1)^{+}}f(x)=f(-1)=-2.\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{+}}\\,\\frac{1}{3f(x)-10x} & =\\frac{1}{3{lim}_{x\\to (-1)^{+}}f(x)-10{lim}_{x\\to (-1)^{+}}x} \\\\  & =\\frac{1}{3(-2)-10(-1)} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73084/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc967c7-840e-5717-98f2-330fcf0fe12d"] :knowledge-point/questions ["q-73084"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87327/selection/27053d3fac5eef57d90faa12ba257415720d7d99094c3f3b0a478042c1ec1d03" :answer/id #uuid "171968fc-c276-590d-a500-80478856f419" :answer/type :answer.type/math :answer/value "(5{a}^{4}+1)(5{a}^{4}-1)" :db/ensure [:answer/validate]} {:db/id "q-87327/selection/c84fcf05fede6bd970d1a0c7e6a116fcadd3da0893a3328c06cc8a9ec2184c29" :answer/id #uuid "7ac9f49d-b86d-5612-88da-c4a925ff8389" :answer/type :answer.type/math :answer/value "{(5{a}^{2}-\\text{i})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-87327/selection/97a79ab27a7d6c60bd42897fa4c917136c2cb920d9d4040d99005e4cb1978ef2" :answer/id #uuid "d759732d-52a0-57f9-9327-a7aac712055d" :answer/type :answer.type/math :answer/value "25({a}^{4}+\\text{i})({a}^{4}-\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-87327/selection/756ad5233652733047d71193c63951dcc90ac1c2f460aea4a63608a116335669" :answer/id #uuid "c8680d22-29fe-5afa-9480-6389382ab266" :answer/type :answer.type/math :answer/value "{(5{a}^{4}+\\text{i})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-87327/selection/7b4872d1873c1d2dab57d0f5958987a5097b403658508e39604e42f449e37e85" :answer/id #uuid "78eb12da-f03f-575d-b0bf-9626c6094b39" :answer/type :answer.type/math :answer/value "(5{a}^{4}+\\text{i})(5{a}^{4}-\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-87327/selection" :answer-field/id #uuid "1c7de78e-3a06-5076-bd54-20425ccb2318" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87327/selection/7b4872d1873c1d2dab57d0f5958987a5097b403658508e39604e42f449e37e85" :answer-field/choices ["q-87327/selection/27053d3fac5eef57d90faa12ba257415720d7d99094c3f3b0a478042c1ec1d03" "q-87327/selection/c84fcf05fede6bd970d1a0c7e6a116fcadd3da0893a3328c06cc8a9ec2184c29" "q-87327/selection/97a79ab27a7d6c60bd42897fa4c917136c2cb920d9d4040d99005e4cb1978ef2" "q-87327/selection/756ad5233652733047d71193c63951dcc90ac1c2f460aea4a63608a116335669" "q-87327/selection/7b4872d1873c1d2dab57d0f5958987a5097b403658508e39604e42f449e37e85"] :db/ensure [:answer-field/validate]} {:db/id "q-87327" :question/id #uuid "e91ac095-0027-50ac-b8fd-5be518c91581" :question/math-academy-id "q-87327" :question/problem "Factor $25{a}^{8}+1.$" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n25{a}^{8}+1={(5{a}^{4})}^{2}+{1}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}25{a}^{8}+1 & =25{a}^{8}-(-1) \\\\  & =25{a}^{8}-({\\text{i}}^{2}) \\\\  & ={(5{a}^{4})}^{2}-{(\\text{i})}^{2} \\\\  & =(5{a}^{4}+\\text{i})(5{a}^{4}-\\text{i})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87327/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-87327"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-98719"] :question/problem "Solve the equation $\\frac{1}{S+1}+\\frac{2}{S-1}=\\frac{1}{{S}^{2}-1}.$" :question/worked-solution "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{1}{S+1}+\\frac{2}{S-1}=\\frac{1}{(S-1)(S+1)}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(S-1,\\,S+1,\\,(S-1)(S+1))=(S-1)(S+1).\n$$\n\n- The values $S=1$ and $S=-1$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{1}{S+1}+\\frac{2}{S-1} & =\\frac{1}{(S-1)(S+1)} \\\\ (S-1)(S+1)\\cdot (\\frac{1}{S+1}+\\frac{2}{S-1}) & =(S-1)(S+1)\\cdot \\frac{1}{(S-1)(S+1)} \\\\ \\frac{(S-1)(S+1)}{S+1}+\\frac{2(S-1)(S+1)}{S-1} & =\\frac{(S-1)(S+1)}{(S-1)(S+1)} \\\\ \\frac{(S-1)\\cdot \\cancel{(S+1)}}{\\cancel{S+1}}+\\frac{2(S+1)\\cdot \\cancel{(S-1)}}{\\cancel{S-1}} & =\\frac{\\cancel{(S-1)(S+1)}}{\\cancel{(S-1)(S+1)}} \\\\ S-1+2(S+1) & =1\\end{aligned}\n$$\n\nSolving this equation for $S,$ we get the following:\n\n$$\n\\begin{aligned}S-1+2(S+1) & =1 \\\\ S-1+2S+2 & =1 \\\\ 3S & =0 \\\\ S & =0\\end{aligned}\n$$\n\nSince $0\\ne 1$ and $0\\ne -1,$ we conclude that $S=0$ is a valid solution. \n\nTherefore, the solution to our original equation is $S=0.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-122298/selection/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" :answer/id #uuid "c16212fb-8f3a-52ce-83aa-03b289b43dbb" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "q-122298/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "748616c3-4625-57a9-b33a-1e6c83d856f1" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-122298/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "28822b93-4c9d-5cc5-aab7-f110c323de0a" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-122298/selection/cb306a06f5de702ef21bb3fad8dc2036383d9ef361dcdff738fa1380bf3caeaa" :answer/id #uuid "e1b19b9e-fb87-54ad-a6d2-fce696977322" :answer/type :answer.type/math :answer/value "\\frac{11}{20}" :db/ensure [:answer/validate]} {:db/id "q-122298/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "420d6e97-d13a-5227-b04d-1808fae2deae" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-122298/selection" :answer-field/id #uuid "edc192ef-45f1-53c0-98e5-8cc69d753029" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122298/selection/cb306a06f5de702ef21bb3fad8dc2036383d9ef361dcdff738fa1380bf3caeaa" :answer-field/choices ["q-122298/selection/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" "q-122298/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-122298/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-122298/selection/cb306a06f5de702ef21bb3fad8dc2036383d9ef361dcdff738fa1380bf3caeaa" "q-122298/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda"] :db/ensure [:answer-field/validate]} {:db/id "q-122298" :question/id #uuid "490c0980-5ac4-561f-af02-cd8ffe3a3650" :question/math-academy-id "q-122298" :question/problem "In box $A,$ there are $7$ red marbles and $3$ green marbles. In box $B,$ there are $2$ red marbles and $8$ green marbles. If we randomly select one of the boxes and then we randomly select one marble from that box, what is the probability that it’s a green marble?" :question/worked-solution "Let $G$ be the event that a green marble is selected, and let $A$ be the event that box $A$ is selected. Then ${A}^{′}$ is the event that box $B$ is selected. \n\nTo calculate the probability that a selected marble is green, we can use the law of total probability:\n\n$$\nP(G)=P(G|A)P(A)+P(G|{A}^{′})P({A}^{′})\n$$\n\nLet's go through the problem statement and translate each bit of information into mathematical notation.\n\n- Since there are $2$ boxes, we have\n\n$$\nP(A)=\\frac{1}{2},\\,P({A}^{′})=\\frac{1}{2}.\n$$\n\n- Since there are $3$ green marbles of the total of $10$ marbles in box $A$ and $8$  green marbles of the total of $10$ marbles in box $B,$ we have\n\n$$\nP(G|A)=\\frac{3}{10},\\,P(G|{A}^{′})=\\frac{8}{10}.\n$$\n\nSubstituting the above information into the law of total probability, the probability that a selected marble is green is\n\n$$\n\\begin{aligned}P(G) & =P(G|A)P(A)+P(G|{A}^{′})P({A}^{′}) \\\\  & =(\\frac{3}{10})(\\frac{1}{2})+(\\frac{8}{10})(\\frac{1}{2}) \\\\  & =\\frac{3}{20}+\\frac{8}{20} \\\\  & =\\frac{11}{20}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/requires-calculator true :question/answer-fields ["q-122298/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f0f7055d-9f45-5115-97f4-35d0c56008e0"] :knowledge-point/questions ["q-122298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81576/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "23b4cc7f-373c-5676-9712-77eca3bb13ef" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81576/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0cf57d5e-467b-56f1-bb1d-e78f686e3d00" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-81576/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "5989debf-8bdb-535b-80c6-4848118fa786" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-81576/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a520369b-49fd-51b0-9754-de9d41a44a0c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-81576/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a232c682-ce3f-5a5f-bc5d-f2ecc22db422" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-81576/selection" :answer-field/id #uuid "ebf78a22-36ed-512a-a6a8-c5329c6ca6d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81576/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-81576/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-81576/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-81576/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-81576/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-81576/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-81576" :question/id #uuid "4eaae104-8d2e-5865-b201-2de2f96bdaac" :question/math-academy-id "q-81576" :question/problem "What is the value of $f(x)=\\operatorname{csc}⁡(7x-\\frac{\\pi }{12})+5$ at its local minimum points?" :question/worked-solution "On a positive branch of the graph of $y=\\operatorname{csc}⁡x,$ we have\n\n$$\n\\operatorname{csc}⁡x\\ge 1.\n$$\n\nThe points where $\\operatorname{csc}⁡x=1$ are local minimums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(7x-\\frac{\\pi }{12})\\ge 1.\n$$\n\nAdding $5$ to the above inequality, we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(7x-\\frac{\\pi }{12})\\ge 1 \\\\  & \\operatorname{csc}⁡(7x-\\frac{\\pi }{12})+5\\ge 1+5 \\\\  & f(x)\\ge 6.\\end{aligned}\n$$\n\nTherefore, $f(x)=6$ at the local minimum points." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81576/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce"] :knowledge-point/questions ["q-81576"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-6731"] :question/problem "For the parametric curve \n\n$$\nx=3\\operatorname{sin}⁡\\theta ,\\,y=5\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\n calculate $\\frac{dy}{dx}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(\\theta )=3\\operatorname{cos}⁡\\theta ,\\,{y}^{′}(\\theta )=-5\\operatorname{sin}⁡\\theta .\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-5\\operatorname{sin}⁡\\theta }{3\\operatorname{cos}⁡\\theta }=-\\frac{5}{3}\\operatorname{tan}⁡\\theta .\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-120347/selection/9396f00d30f3e406bd4a937e657fe97e179b439763baa3e87ee5a6fbf940b14c" :answer/id #uuid "3c8024b9-98a7-5742-8975-44f2db7f5d5c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{cos}⁡(\\frac{\\pi }{16})" :db/ensure [:answer/validate]} {:db/id "q-120347/selection/0c9267011b61c5983970b08b3ac3084e0a2ea3660f14e561e67557f290064db5" :answer/id #uuid "398dfc9d-8215-548e-8963-d32de0b78d79" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡(\\frac{\\pi }{16})" :db/ensure [:answer/validate]} {:db/id "q-120347/selection/38c9342827af9cb76f7695042cc3ca6663e76e9a91069ff9d3e167b3590a4be7" :answer/id #uuid "36a888a2-9999-59ec-9cd8-229ed3030d6a" :answer/type :answer.type/math :answer/value "4\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/ensure [:answer/validate]} {:db/id "q-120347/selection/70f3a3ae7e0c3403ea87b329e1e38bef926cf69b8bbff22f32dd5c5b2b780552" :answer/id #uuid "afbd5857-1419-532c-abc1-5c27e3bea386" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/ensure [:answer/validate]} {:db/id "q-120347/selection/00c15c4950fee2c0f2e924d54f074f12b422065c3764622a5c809baccb270a28" :answer/id #uuid "f1c71444-dd4a-57b1-96b8-200c7235140d" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡(\\frac{\\pi }{4})" :db/ensure [:answer/validate]} {:db/id "q-120347/selection" :answer-field/id #uuid "3d960efe-ceb6-58e1-832b-78da060375a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120347/selection/00c15c4950fee2c0f2e924d54f074f12b422065c3764622a5c809baccb270a28" :answer-field/choices ["q-120347/selection/9396f00d30f3e406bd4a937e657fe97e179b439763baa3e87ee5a6fbf940b14c" "q-120347/selection/0c9267011b61c5983970b08b3ac3084e0a2ea3660f14e561e67557f290064db5" "q-120347/selection/38c9342827af9cb76f7695042cc3ca6663e76e9a91069ff9d3e167b3590a4be7" "q-120347/selection/70f3a3ae7e0c3403ea87b329e1e38bef926cf69b8bbff22f32dd5c5b2b780552" "q-120347/selection/00c15c4950fee2c0f2e924d54f074f12b422065c3764622a5c809baccb270a28"] :db/ensure [:answer-field/validate]} {:db/id "q-120347" :question/id #uuid "3e51393b-cf1d-5d4b-917b-3f067d1f544f" :question/math-academy-id "q-120347" :question/problem "Express $2{cos}^{2}⁡(\\frac{\\pi }{8})-2{sin}^{2}⁡(\\frac{\\pi }{8})$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n2({cos}^{2}⁡(\\frac{\\pi }{8})-{sin}^{2}⁡(\\frac{\\pi }{8}))\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{\\pi }{8})-{sin}^{2}⁡(\\frac{\\pi }{8}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{4}).\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}2({cos}^{2}⁡(\\frac{\\pi }{8})-{sin}^{2}⁡(\\frac{\\pi }{8})) & =2\\operatorname{cos}⁡(\\frac{\\pi }{4}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f"] :knowledge-point/questions ["q-120347"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74771/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" :answer/id #uuid "212151ed-6e07-5059-8cb9-3223491b3e98" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74771/selection/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" :answer/id #uuid "5402e8d4-9bd8-572c-80f7-13ef8ac7a5ea" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74771/selection/a58e880e036264e5b21442a2e9867416c984cde73a96371bb168dcb66090a333" :answer/id #uuid "fe9411cd-30b4-508b-a18d-15dba3195615" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74771/selection/2abc78f7808485d66e1af0c4afa164d186ae9695fc4e445022e90dab89030120" :answer/id #uuid "b4e9c6ad-9a69-58b4-8c48-c287e48acefe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74771/selection/64016bee11c110718ed4fa5affa1338833add0794a386797f22b2a6d8512dc99" :answer/id #uuid "b28ced1c-ba2f-556c-8e94-a11ac048a826" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74771/selection" :answer-field/id #uuid "486ac45d-503f-5e45-9911-203081d171d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74771/selection/a58e880e036264e5b21442a2e9867416c984cde73a96371bb168dcb66090a333" :answer-field/choices ["q-74771/selection/60eadf18022e36714cee17e0479ab6af66a6361ceef7571ec8305b4e57ee6d8f" "q-74771/selection/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" "q-74771/selection/a58e880e036264e5b21442a2e9867416c984cde73a96371bb168dcb66090a333" "q-74771/selection/2abc78f7808485d66e1af0c4afa164d186ae9695fc4e445022e90dab89030120" "q-74771/selection/64016bee11c110718ed4fa5affa1338833add0794a386797f22b2a6d8512dc99"] :db/ensure [:answer-field/validate]} {:db/id "q-74771" :question/id #uuid "1e6bb51b-2f06-5367-b05a-e25bda6eecb2" :question/math-academy-id "q-74771" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T({v}_{1}+5{v}_{2})=[\\begin{aligned}-7 \\\\ 11\\end{aligned}]\\,$ and $\\,T({v}_{1})=[\\begin{aligned}3 \\\\ -4\\end{aligned}]$, then find $\\,T({v}_{2}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(v+kw)=T(v)+T(kw)=T(v)+kT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T({v}_{1}+5{v}_{2}) & =T({v}_{1})+5T({v}_{2}) \\\\ [\\begin{aligned}-7 \\\\ 11\\end{aligned}] & =[\\begin{aligned}3 \\\\ -4\\end{aligned}]+5T({v}_{2}) \\\\ 5T({v}_{2}) & =[\\begin{aligned}-7 \\\\ 11\\end{aligned}]-[\\begin{aligned}3 \\\\ -4\\end{aligned}] \\\\ 5T({v}_{2}) & =[\\begin{aligned}-10 \\\\ 15\\end{aligned}] \\\\ T({v}_{2}) & =\\frac{1}{5}[\\begin{aligned}-10 \\\\ 15\\end{aligned}] \\\\ T({v}_{2}) & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74771/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3"] :knowledge-point/questions ["q-74771"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103912/selection/8f052b1bfb7ffeafaf04fc49ea51cd0c1d8629888e6f06d5fe1e4a16e93a0365" :answer/id #uuid "0119602e-ae05-5631-a3c6-326cf98ca0a0" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{2}=1" :db/ensure [:answer/validate]} {:db/id "q-103912/selection/d7fc4eca199eafed9f4bd3ca2c7899dc5b9cb2469cb90cec18f7ac589766e79f" :answer/id #uuid "e7cf1c64-d8e0-50ff-83cd-f5b85bd3fdcc" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-103912/selection/721e2ea5e033ee9cdf61cacdef95b93df8a9c0510b4fe587c61d26b1ca45c838" :answer/id #uuid "33bd661e-3a94-5a8d-9ad0-ef287e924386" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-103912/selection/2f5adca37833db852e83fcbc08bde647b8d5ffa07ec2aa49dfef49af768e9ee3" :answer/id #uuid "0b50fd87-9a94-519a-b2df-b7c7fbd644a8" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-103912/selection/747a9ee7e8d96d7ae652eefc0f787cccae79e255f95ef72bbfbaed4ede46dc77" :answer/id #uuid "c8ad4a90-4398-5697-b748-eb04f4a456fc" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{2}=1" :db/ensure [:answer/validate]} {:db/id "q-103912/selection" :answer-field/id #uuid "370cd7ad-7240-594d-ad13-7fd0f8b42fe5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103912/selection/8f052b1bfb7ffeafaf04fc49ea51cd0c1d8629888e6f06d5fe1e4a16e93a0365" :answer-field/choices ["q-103912/selection/8f052b1bfb7ffeafaf04fc49ea51cd0c1d8629888e6f06d5fe1e4a16e93a0365" "q-103912/selection/d7fc4eca199eafed9f4bd3ca2c7899dc5b9cb2469cb90cec18f7ac589766e79f" "q-103912/selection/721e2ea5e033ee9cdf61cacdef95b93df8a9c0510b4fe587c61d26b1ca45c838" "q-103912/selection/2f5adca37833db852e83fcbc08bde647b8d5ffa07ec2aa49dfef49af768e9ee3" "q-103912/selection/747a9ee7e8d96d7ae652eefc0f787cccae79e255f95ef72bbfbaed4ede46dc77"] :db/ensure [:answer-field/validate]} {:db/id "q-103912" :question/id #uuid "f2af82f3-9d93-5885-b2ca-b940ebfe011c" :question/math-academy-id "q-103912" :question/problem "Write the equation of the hyperbola $2{x}^{2}-9{y}^{2}=18$ in standard form." :question/worked-solution "The Cartesian equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nTherefore, to write the equation of the hyperbola in standard form, we need to divide both sides of the equation by $18$ and then simplify, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-9{y}^{2} & =18 \\\\ \\frac{2{x}^{2}}{18}-\\frac{9{y}^{2}}{18} & =\\frac{18}{18} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{2} & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103912/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfbe689c-ae04-5405-9a38-d80f10662a0b"] :knowledge-point/questions ["q-103912"] :db/ensure [:knowledge-point/validate]} {:db/id "q-28341/selection/a83d88d93def5279f83b2c5ec4788971c399195bc66bc536f236dc16114ece2a" :answer/id #uuid "eb42405b-9467-54a1-abcc-bf4ffc8f85ca" :answer/type :answer.type/math :answer/value "y=-\\frac{2}{3}x+2" :db/ensure [:answer/validate]} {:db/id "q-28341/selection/fa8a55df849882336b0a3d12f0d860240d1cc1cd6e2c05dd8117205a307d5739" :answer/id #uuid "87caf5f7-1192-5784-9e83-bb02335c1516" :answer/type :answer.type/math :answer/value "y=-4x+3" :db/ensure [:answer/validate]} {:db/id "q-28341/selection/b1466c25fd014f73f13bb767659dfbb84cb1cff4691b73546f3efd249901e181" :answer/id #uuid "404073ca-72fb-5104-992d-5dba92e853c3" :answer/type :answer.type/math :answer/value "y=4x+3" :db/ensure [:answer/validate]} {:db/id "q-28341/selection/4a6feb1ae56d0e93379a92acaeefc698f9a7eafc6ba989f007569e4a0c1c6ec1" :answer/id #uuid "8dc6da4f-977d-5a2e-8bf9-f1f8f971be13" :answer/type :answer.type/math :answer/value "y=\\frac{x}{2}-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-28341/selection/97f6fd45dfbc8b82d801bd1c49235ece982a375a8ff421aad603cc1db1b095d6" :answer/id #uuid "2244df98-3e18-5a80-80fb-b36bc6f00242" :answer/type :answer.type/math :answer/value "y=\\frac{x}{4}-5" :db/ensure [:answer/validate]} {:db/id "q-28341/selection" :answer-field/id #uuid "eb2273bf-a71f-5940-95ea-711271f7116a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-28341/selection/97f6fd45dfbc8b82d801bd1c49235ece982a375a8ff421aad603cc1db1b095d6" :answer-field/choices ["q-28341/selection/a83d88d93def5279f83b2c5ec4788971c399195bc66bc536f236dc16114ece2a" "q-28341/selection/fa8a55df849882336b0a3d12f0d860240d1cc1cd6e2c05dd8117205a307d5739" "q-28341/selection/b1466c25fd014f73f13bb767659dfbb84cb1cff4691b73546f3efd249901e181" "q-28341/selection/4a6feb1ae56d0e93379a92acaeefc698f9a7eafc6ba989f007569e4a0c1c6ec1" "q-28341/selection/97f6fd45dfbc8b82d801bd1c49235ece982a375a8ff421aad603cc1db1b095d6"] :db/ensure [:answer-field/validate]} {:db/id "q-28341" :question/id #uuid "e71680c0-b9f9-54f6-9973-5f9558436a68" :question/math-academy-id "q-28341" :question/problem "Which of the following lines is perpendicular to $16x+4y=12?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $16x+4y=12,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}16x+4y & =12 \\\\ 4y & =-16x+12 \\\\ y & =-4x+3\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-4.$\n\nLooking at the answer choices, the line $y=\\frac{x}{4}-5$ has a slope of $\\frac{1}{4}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-4)\\cdot \\frac{1}{4}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{x}{4}-5$ is perpendicular to the given line." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-28341/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d"] :knowledge-point/questions ["q-28341"] :db/ensure [:knowledge-point/validate]}]
