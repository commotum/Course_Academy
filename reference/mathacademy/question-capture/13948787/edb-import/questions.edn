#{[{:db/id #edb/ref 17592186087412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/id #uuid "7826cd52-8603-51ff-902e-c7764639dccd" :question/math-academy-id "e-3666" :question/problem "Express $\\cos^2{\\left(\\dfrac{\\pi}{24}\\right)} - \\sin^2{\\left(\\dfrac{\\pi}{24}\\right)}$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos^2 x - \\sin^2 x = \\cos 2x\n$$\n\nSubstituting\n\n$$\nx={\\dfrac{\\pi}{24}}\n$$\n\ninto the above, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} (\\frac{π}{24}) - \\sin^{2} (\\frac{π}{24}) &= \\cos (2 \\cdot \\frac{π}{24}) \\\\\n&= \\cos (\\frac{π}{12})\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/id #uuid "2b9dc462-ec26-5762-aa64-d9e8f16112c9" :question/math-academy-id "e-3667" :question/problem "Express $2\\cos^2{\\left(\\dfrac{\\pi}{3}\\right)}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2 \\cos^2 x - 1 = \\cos 2x\n$$\n\nSubstituting\n\n$$\nx={\\dfrac{\\pi}{3}}\n$$\n\ninto the above, we get\n\n$$\n\\begin{aligned}\n2\\cos^{2} (\\frac{π}{3}) - 1 &= \\cos (2 \\cdot \\frac{π}{3}) \\\\\n&= \\cos (\\frac{2π}{3})\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087414 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/id #uuid "e617aaf2-1232-57cc-8644-2467effda030" :question/math-academy-id "e-3668" :question/problem "Without using a calculator, find the exact value of $\\cos^2\\left(22.5^\\circ\\right) - \\sin^2\\left(22.5^\\circ\\right)$." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos^2 x - \\sin^2 x = \\cos 2x\n$$\n\nSubstituting\n\n$$\nx={22.5^\\circ}\n$$\n\ninto the above, we get\n\n$$\n\\begin{aligned}\n\\cos^{2} (22.5^{∘}) - \\sin^{2} (22.5^{∘}) &= \\cos (2 \\cdot 22.5^{∘}) \\\\\n&= \\cos 45^{∘} \\\\\n&= \\frac{\\sqrt{2}}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088039 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80fa6a4d-c529-543d-9e7e-44580c2be241" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{π}{4})" :db/id #edb/ref 17592186085172} {:answer/id #uuid "a564826e-a203-5259-abac-05f62e5c289f" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{3π}{4})" :db/id #edb/ref 17592186085173} {:answer/id #uuid "19879f55-bb20-5f40-8484-3ef5a53fe644" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{3π}{2})" :db/id #edb/ref 17592186085174} {:answer/id #uuid "1e657ecf-3c2a-50a9-b2fb-036820e375cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{4π}{3})" :db/id #edb/ref 17592186085175} {:answer/id #uuid "5c03489e-9a0f-5cf9-bd18-e5a19daec2b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{5π}{2})" :db/id #edb/ref 17592186085176}] :answer-field/correct {:answer/id #uuid "19879f55-bb20-5f40-8484-3ef5a53fe644" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (\\frac{3π}{2})" :db/id #edb/ref 17592186085174} :answer-field/id #uuid "19646cc8-0660-5842-8588-cddbeccf85bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085171}] :question/id #uuid "eda88667-03a3-54d2-bc45-5bd8cd910c52" :qu