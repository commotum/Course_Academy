:answer/validate]} {:db/id "q-36883/selection/c6c8145af45cffc8f4ea7da599e35b6bbf6518379525fbf109a5b1482d20d731" :answer/id #uuid "d2d24a12-464b-52da-8288-0fe36930e287" :answer/type :answer.type/math :answer/value "{lim}_{x\\to {4}^{-}}f(x)=4" :db/ensure [:answer/validate]} {:db/id "q-36883/selection/b32fb5c5cd2f0f5ad66ac658b91b14c1dfa1fd4993c77a1313fdac73a7e10988" :answer/id #uuid "dd01d823-189f-5583-bcf8-fc8ecb07ac33" :answer/type :answer.type/math :answer/value "{lim}_{x\\to {4}^{-}}f(x)=1" :db/ensure [:answer/validate]} {:db/id "q-36883/selection/a12451af43dbc13ac19cfa0b5e69ea3b7025feb317709680cf64930bfc5178bf" :answer/id #uuid "d2f59ba2-aec7-5662-bebf-3aee6a573d30" :answer/type :answer.type/math :answer/value "{lim}_{x\\to {4}^{-}}f(x)=0" :db/ensure [:answer/validate]} {:db/id "q-36883/selection/ba775ea9299c6673a26338b1ac8509d17821a36cab01608dc3b9f47e2bac5cb5" :answer/id #uuid "dacafd47-ded0-58ea-ad60-6fe5895e5066" :answer/type :answer.type/math :answer/value "{lim}_{x\\to {4}^{-}}f(x)=\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-36883/selection" :answer-field/id #uuid "b79e76bc-e745-5d75-996e-ed5cbd310fe7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36883/selection/4c1d1c31f8ebed8e51c7ef142c86d352c5d9c1283bc73ee56bc7b0527293d552" :answer-field/choices ["q-36883/selection/4c1d1c31f8ebed8e51c7ef142c86d352c5d9c1283bc73ee56bc7b0527293d552" "q-36883/selection/c6c8145af45cffc8f4ea7da599e35b6bbf6518379525fbf109a5b1482d20d731" "q-36883/selection/b32fb5c5cd2f0f5ad66ac658b91b14c1dfa1fd4993c77a1313fdac73a7e10988" "q-36883/selection/a12451af43dbc13ac19cfa0b5e69ea3b7025feb317709680cf64930bfc5178bf" "q-36883/selection/ba775ea9299c6673a26338b1ac8509d17821a36cab01608dc3b9f47e2bac5cb5"] :db/ensure [:answer-field/validate]} {:db/id "q-36883" :question/id #uuid "b7c4e097-3c68-515f-a652-a3cde28c0e7a" :question/math-academy-id "q-36883" :question/problem "Find the left-sided limit at $x=4$ for the function\n\n$$\nf(x)={\\begin{aligned}\\sqrt{x} & \\text{ for }\\,0\\le x<4 \\\\ 2 & \\text{ for }\\,x=4 \\\\ \\sqrt{x-2} & \\text{ for }\\,x>4.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<4,$ so we use the expression $f(x)=\\sqrt{x}.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{-}}f(x) & ={lim}_{x\\to {4}^{-}}\\sqrt{x} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36883/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3"] :knowledge-point/questions ["q-36883"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99967/selection/b198cad718fb374a4de39a519bb9a914942c506d41ce8354685cb0b4b0c12c3c" :answer/id #uuid "6e1d8a3d-fa87-54fe-a67d-9801a785f5af" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-2)^{-}}f(x)=-2,\\,{lim}_{x\\to {3}^{-}}f(x)=-3" :db/ensure [:answer/validate]} {:db/id "q-99967/selection/dafd5eba19c3b03bfa7b2fe06ff2bd3010d78a82fee5995e48c0566a6dd78b6e" :answer/id #uuid "6fc07858-2299-52f7-97ab-3d2cea5d86bf" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-2)^{-}}f(x)=2,\\,{lim}_{x\\to {3}^{-}}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-99967/selection/3b2d93fd4208620b80b74090c4cb9c3d0abb33ce6afb4c84e687aabf77fa37b1" :answer/id #uuid "247e7d11-197b-56d1-ae3c-3574eebd2658" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-2)^{-}}f(x)=2,\\,{lim}_{x\\to {3}^{-}}f(x)=3" :db/ensure [:answer/validate]} {:db/id "q-99967/selection/486e741ccf9fe7fa2249b8882dec26c83cc74aef28d396392de55389be9d141b" :answer/id #uuid "afd82805-3abb-589c-9fa4-8c52227a70d6" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-2)^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to {3}^{-}}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-99967/selection/63dd57126791c20cba64fd7ad17a57d23acfdea9c39058bcfa134a30bd911625" :answer/id #uuid "5c979e1f-f47e-5a2a-a836-8f220fe112b2" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-2)^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to {3}^{-}}f(x)=3" :db/ensure [:answer/validate]} {:db/id "q-99967/selection" :answer-field/id #uuid "9b43d5a5-8899-5fe9-af75-1f4ec1e718c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99967/selection/dafd5eba19c3b03bfa7b2fe06ff2bd3010d78a82fee5995e48c0566a6dd78b6e" :answer-field/choices ["q-99967/selection/b198cad718fb374a4de39a519bb9a914942c506d41ce8354685cb0b4b0c12c3c" "q-99967/selection/dafd5eba19c3b03bfa7b2fe06ff2bd3010d78a82fee5995e48c0566a6dd78b6e" "q-99967/selection/3b2d93fd4208620b80b74090c4cb9c3d0abb33ce6afb4c84e687aabf77fa37b1" "q-99967/selection/486e741ccf9fe7fa2249b8882dec26c83cc74aef28d396392de55389be9d141b" "q-99967/selection/63dd57126791c20cba64fd7ad17a57d23acfdea9c39058bcfa134a30bd911625"] :db/ensure [:answer-field/validate]} {:db/id "q-99967" :question/id #uuid "59f2b360-e6a9-5abb-b31f-45e821295526" :question/math-academy-id "q-99967" :question/problem "Find ${lim}_{x\\to (-2)^{-}}f(x)$ and ${lim}_{x\\to {3}^{-}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}-x & \\text{ for }\\,x<-2 \\\\ x & \\text{ for }\\,x>3.\\end{aligned}\n$$" :question/worked-solution "Approaching $x=-2$ from the left, we have $x<-2,$ so we use the expression $f(x)=-x.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-2)^{-}}f(x) & ={lim}_{x\\to (-2)^{-}}(-x) \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$\n\nOn the other hand, the left-sided limit ${lim}_{x\\to {3}^{-}}f(x)$ does not exist since $f(x)$ is not defined on the interval $x\\in [-2,3].$ \n\nConsequently, \n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99967/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd"] :knowledge-point/questions ["q-99967"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36696/selection/6e204d9b0a5fef6e7dd8e47841a025509ba9d4cebc253b0f618e32391fae7411" :answer/id #uuid "a2a49614-ecc1-5d6a-a7f4-888e080bd9d9" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=1,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-36696/selection/1931e7e7ea55a8edba26156aaa82287875d306fa955b9bd14c95cd4ae07fb4f7" :answer/id #uuid "b8d901ab-15ab-57e7-8c7c-cd8e3f466fd5" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1" :db/ensure [:answer/validate]} {:db/id "q-36696/selection/f3996af43e64e7d110e69b4e02c9e44eef82d74863158ee66d0e8aed74243790" :answer/id #uuid "b77b1d51-b805-522e-ba12-262953b5224b" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-36696/selection/a7a08fa66d975d5c4ce6b3b5db998ad5bb4347f0afb357bbe06a897ae9115871" :answer/id #uuid "2498c86d-1c86-566a-b246-c7af422be22a" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-36696/selection/6d181db77dbc1c9591a703e2b0773992ba66bcb646499f1d8acc2a9f4be99cb3" :answer/id #uuid "67892502-55d0-5b71-b8b4-668fea14cc79" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1" :db/ensure [:answer/validate]} {:db/id "q-36696/selection" :answer-field/id #uuid "63ec17f2-c83b-5128-bf98-03e78b8f190d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36696/selection/6e204d9b0a5fef6e7dd8e47841a025509ba9d4cebc253b0f618e32391fae7411" :answer-field/choices ["q-36696/selection/6e204d9b0a5fef6e7dd8e47841a025509ba9d4cebc253b0f618e32391fae7411" "q-36696/selection/1931e7e7ea55a8edba26156aaa82287875d306fa955b9bd14c95cd4ae07fb4f7" "q-36696/selection/f3996af43e64e7d110e69b4e02c9e44eef82d74863158ee66d0e8aed74243790" "q-36696/selection/a7a08fa66d975d5c4ce6b3b5db998ad5bb4347f0afb357bbe06a897ae9115871" "q-36696/selection/6d181db77dbc1c9591a703e2b0773992ba66bcb646499f1d8acc2a9f4be99cb3"] :db/ensure [:answer-field/validate]} {:db/id "q-36696" :question/id #uuid "65911f9a-fa00-54b8-9673-9586456d002e" :question/math-academy-id "q-36696" :question/problem "Find ${lim}_{x\\to \\,{0}^{+}}f(x)$ and ${lim}_{x\\to \\,{0}^{-}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}\\operatorname{sec}⁡x & \\text{ for }\\,-\\frac{\\pi }{2}<x<0 \\\\ \\operatorname{csc}⁡x & \\text{ for }\\,\\frac{\\pi }{2}<x<\\pi \\end{aligned}\n$$" :question/worked-solution "The right-sided limit ${lim}_{x\\to {0}^{+}}f(x)$ does not exist since $f(x)$ is not defined on the interval $x\\in (0,\\frac{\\pi }{2}).$ \n\nConsequently, \n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=\\text{DNE}.\n$$\n\nApproaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=\\operatorname{sec}⁡x.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}\\operatorname{sec}⁡x \\\\  & =\\operatorname{sec}⁡0 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=\\text{DNE},\\,{lim}_{x\\to {0}^{-}}f(x)=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36696/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd"] :knowledge-point/questions ["q-36696"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339967/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b90ee35a-4717-5a42-a548-0b5f77e31cea" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-339967/field-1" :answer-field/id #uuid "70bc4c13-8f74-5e8d-8f95-8291d34c577d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339967/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-339967/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-339967/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "232a2351-9efd-573f-901f-5043ce47b017" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-339967/field-2" :answer-field/id #uuid "43b61a3d-3272-539b-a33b-053f8faa6297" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339967/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-339967/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-339967" :question/id #uuid "fa3be5bb-98bd-5c95-a4d6-b0df3476c988" :question/math-academy-id "q-339967" :question/problem "Find ${lim}_{x\\to {0}^{-}}f(x)$ and ${lim}_{x\\to {2}^{+}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}3sin\\,(\\frac{\\pi }{3}x)+2 & \\text{ for }\\,x<0 \\\\ \\sqrt{7x+2}-1 & \\text{ for }\\,x\\ge 2.\\end{aligned}\n$$\n\n${lim}_{x\\to {0}^{-}}f(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {2}^{+}}f(x)=$\n{{field-2}}" :question/worked-solution "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=3sin\\,(\\frac{\\pi }{3}x)+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}[3sin\\,(\\frac{\\pi }{3}x)+2] \\\\  & =3sin\\,(\\frac{\\pi }{3}(0))+2 \\\\  & =3\\operatorname{sin}⁡(0)+2 \\\\  & =3\\cdot 0+2 \\\\  & =2.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=2$ from the right, we have $x\\ge 2,$ so we use the expression $f(x)=\\sqrt{7x+2}-1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(\\sqrt{7x+2}-1) \\\\  & =\\sqrt{7(2)+2}-1 \\\\  & =\\sqrt{16}-1 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339967/field-1" "q-339967/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd"] :knowledge-point/questions ["q-339967"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339939/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "2b0c3ace-7a61-54fe-8c76-7fb177851cac" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-339939/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "fb20f698-ecbd-5cc9-9607-91a51f6a0268" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-339939/field-1" :answer-field/id #uuid "304e0016-edb4-5b3d-90f9-e2d2f8e923e9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339939/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-339939/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-339939/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-339939/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "62edf372-39a6-5213-8992-606ee7160c79" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-339939/field-2" :answer-field/id #uuid "14759065-5e95-5216-b43f-1d85af5ea2bf" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339939/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-339939/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-339939" :question/id #uuid "4f147a66-27be-5b9c-9c82-1dfc6dc18520" :question/math-academy-id "q-339939" :question/problem "Find ${lim}_{x\\to (-1)^{-}}f(x)$ and ${lim}_{x\\to {2}^{+}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}2\\operatorname{sin}⁡(\\pi (x+1))-5 & \\text{ for }\\,x<-1 \\\\ \\sqrt{x-2}+(x-2)^{2}-3 & \\text{ for }\\,x\\ge 2.\\end{aligned}\n$$\n\n${lim}_{x\\to (-1)^{-}}f(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {2}^{+}}f(x)=$\n{{field-2}}" :question/worked-solution "Approaching $x=-1$ from the left, we have $x<-1,$ so we use the expression $f(x)=2\\operatorname{sin}⁡(\\pi (x+1))-5.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}[2\\operatorname{sin}⁡(\\pi (x+1))-5] \\\\  & =2\\operatorname{sin}⁡(\\pi (-1+1))-5 \\\\  & =2\\operatorname{sin}⁡(0)-5 \\\\  & =-5.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=2$ from the right, we have $x\\ge 2,$ so we use the expression $f(x)=\\sqrt{x-2}+(x-2)^{2}-3.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(\\sqrt{x-2}+(x-2)^{2}-3) \\\\  & =\\sqrt{2-2}+(2-2)^{2}-3 \\\\  & =\\sqrt{0}+{0}^{2}-3 \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339939/field-1" "q-339939/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd"] :knowledge-point/questions ["q-339939"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99968/selection/9c404a0e038a57368d6edeb4c37db54b5f4045966501553aa32f8b695083e462" :answer/id #uuid "b8aa663f-b2d6-58fc-bb78-83fff5a053f6" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-1)^{-}}f(x)=-1,\\,{lim}_{x\\to {1}^{+}}f(x)=3" :db/ensure [:answer/validate]} {:db/id "q-99968/selection/202ff53526d41d78eaddafafef6f105aafb0f767e1d1cf7125cd1a5c0aa191d3" :answer/id #uuid "d8915084-d164-5cb7-888a-acc52832840e" :answer/type :answer.type/math :answer/value "{lim}_{x\\to (-1)^{-}}f(x)=1,\\,{lim}_{x\\to {1}^{+}}f(x)=3" :db/ensure [:answer/validate]} {:db/id "q-99968/selection/a1b888d46dd624555aa05830b3595