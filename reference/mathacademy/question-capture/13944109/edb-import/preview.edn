\\  & ={e}^{2+(-2)}+3 \\\\  & ={e}^{0}+3 \\\\  & =1+3 \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -{2}^{-}}f(x)={lim}_{x\\to -{2}^{+}}f(x)=4.\n$$" 13194139533788 true] [17592186251147 1000 #edb/ref 17592186251148 13194139533788 true] [17592186251147 1000 #edb/ref 17592186251149 13194139533788 true] [17592186251147 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251147 1041 "field-1" 13194139533788 true] [17592186251147 1104 #edb/ref 17592186251149 13194139533788 true] [17592186251147 1110 #uuid "6fd6a0b7-1b27-5274-96ab-a1926974f446" 13194139533788 true] [17592186251148 1034 "16" 13194139533788 true] [17592186251148 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251148 1111 #uuid "045fffb4-9e06-586d-a853-b10378d20892" 13194139533788 true] [17592186251149 1034 "4" 13194139533788 true] [17592186251149 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251149 1111 #uuid "644df85c-5f72-56e0-9df5-abfdebd72356" 13194139533788 true] [17592186251150 1000 #edb/ref 17592186251151 13194139533788 true] [17592186251150 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251150 1041 "field-2" 13194139533788 true] [17592186251150 1104 #edb/ref 17592186251151 13194139533788 true] [17592186251150 1110 #uuid "5248d949-86fa-568c-b5a4-a781e1aca325" 13194139533788 true] [17592186251151 1034 "4" 13194139533788 true] [17592186251151 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251151 1111 #uuid "419fa797-bf64-5c85-911b-3a89ca338639" 13194139533788 true] [17592186251152 1017 #edb/ref 17592186251153 13194139533788 true] [17592186251152 1089 "q-339892" 13194139533788 true] [17592186251152 1091 #edb/ref 17592186045463 13194139533788 true] [17592186251152 1100 "Find the right-sided limit at $x=8$ for the function\n\n$$\nf(x)={\\begin{aligned}{x}^{2}-3x\\, & \\text{ for }\\,x\\le 8 \\\\ \\sqrt[3]{x}+2\\, & \\text{ for }\\,x>8.\\end{aligned}\n$$\n\n${lim}_{x\\to {8}^{+}}f(x)=$\n{{field-1}}" 13194139533788 true] [17592186251152 1113 #uuid "d540969a-8204-54d6-b275-8a37ed4ce9bc" 13194139533788 true] [17592186251152 1145 "Approaching from the right, we have $x>8,$ so we use the expression $f(x)=\\sqrt[3]{x}+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {8}^{+}}f(x) & ={lim}_{x\\to {8}^{+}}(\\sqrt[3]{x}+2) \\\\  & =\\sqrt[3]{8}+2 \\\\  & =2+2 \\\\  & =4.\\end{aligned}\n$$" 13194139533788 true] [17592186251153 1000 #edb/ref 17592186251154 13194139533788 true] [17592186251153 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251153 1041 "field-1" 13194139533788 true] [17592186251153 1104 #edb/ref 17592186251154 13194139533788 true] [17592186251153 1110 #uuid "513a33ea-c554-5106-ba89-32723b991fae" 13194139533788 true] [17592186251154 1034 "4" 13194139533788 true] [17592186251154 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251154 1111 #uuid "1506879a-40a4-5588-92da-c27bcf122f21" 13194139533788 true] [17592186251155 1017 #edb/ref 17592186251156 13194139533788 true] [17592186251155 1017 #edb/ref 17592186251159 13194139533788 true] [17592186251155 1089 "q-339939" 13194139533788 true] [17592186251155 1091 #edb/ref 17592186045463 13194139533788 true] [17592186251155 1100 "Find ${lim}_{x\\to (-1)^{-}}f(x)$ and ${lim}_{x\\to {2}^{+}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}2\\operatorname{sin}⁡(\\pi (x+1))-5 & \\text{ for }\\,x<-1 \\\\ \\sqrt{x-2}+(x-2)^{2}-3 & \\text{ for }\\,x\\ge 2.\\end{aligned}\n$$\n\n${lim}_{x\\to (-1)^{-}}f(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {2}^{+}}f(x)=$\n{{field-2}}" 13194139533788 true] [17592186251155 1113 #uuid "4f147a66-27be-5b9c-9c82-1dfc6dc18520" 13194139533788 true] [17592186251155 1145 "Approaching $x=-1$ from the left, we have $x<-1,$ so we use the expression $f(x)=2\\operatorname{sin}⁡(\\pi (x+1))-5.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}[2\\operatorname{sin}⁡(\\pi (x+1))-5] \\\\  & =2\\operatorname{sin}⁡(\\pi (-1+1))-5 \\\\  & =2\\operatorname{sin}⁡(0)-5 \\\\  & =-5.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=2$ from the right, we have $x\\ge 2,$ so we use the expression $f(x)=\\sqrt{x-2}+(x-2)^{2}-3.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(\\sqrt{x-2}+(x-2)^{2}-3) \\\\  & =\\sqrt{2-2}+(2-2)^{2}-3 \\\\  & =\\sqrt{0}+{0}^{2}-3 \\\\  & =-3.\\end{aligned}\n$$" 13194139533788 true] [17592186251156 1000 #edb/ref 17592186251157 13194139533788 true] [17592186251156 1000 #edb/ref 17592186251158 13194139533788 true] [17592186251156 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251156 1041 "field-1" 13194139533788 true] [17592186251156 1104 #edb/ref 17592186251157 13194139533788 true] [17592186251156 1110 #uuid "304e0016-edb4-5b3d-90f9-e2d2f8e923e9" 13194139533788 true] [17592186251157 1034 "-5" 13194139533788 true] [17592186251157 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251157 1111 #uuid "2b0c3ace-7a61-54fe-8c76-7fb177851cac" 13194139533788 true] [17592186251158 1034 "5" 13194139533788 true] [17592186251158 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251158 1111 #uuid "fb20f698-ecbd-5cc9-9607-91a51f6a0268" 13194139533788 true] [17592186251159 1000 #edb/ref 17592186251160 13194139533788 true] [17592186251159 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251159 1041 "field-2" 13194139533788 true] [17592186251159 1104 #edb/ref 17592186251160 13194139533788 true] [17592186251159 1110 #uuid "14759065-5e95-5216-b43f-1d85af5ea2bf" 13194139533788 true] [17592186251160 1034 "-3" 13194139533788 true] [17592186251160 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251160 1111 #uuid "62edf372-39a6-5213-8992-606ee7160c79" 13194139533788 true] [17592186251161 1017 #edb/ref 17592186251162 13194139533788 true] [17592186251161 1017 #edb/ref 17592186251164 13194139533788 true] [17592186251161 1089 "q-339967" 13194139533788 true] [17592186251161 1091 #edb/ref 17592186045463 13194139533788 true] [17592186251161 1100 "Find ${lim}_{x\\to {0}^{-}}f(x)$ and ${lim}_{x\\to {2}^{+}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}3sin\\,(\\frac{\\pi }{3}x)+2 & \\text{ for }\\,x<0 \\\\ \\sqrt{7x+2}-1 & \\text{ for }\\,x\\ge 2.\\end{aligned}\n$$\n\n${lim}_{x\\to {0}^{-}}f(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {2}^{+}}f(x)=$\n{{field-2}}" 13194139533788 true] [17592186251161 1113 #uuid "fa3be5bb-98bd-5c95-a4d6-b0df3476c988" 13194139533788 true] [17592186251161 1145 "Approaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=3sin\\,(\\frac{\\pi }{3}x)+2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}[3sin\\,(\\frac{\\pi }{3}x)+2] \\\\  & =3sin\\,(\\frac{\\pi }{3}(0))+2 \\\\  & =3\\operatorname{sin}⁡(0)+2 \\\\  & =3\\cdot 0+2 \\\\  & =2.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=2$ from the right, we have $x\\ge 2,$ so we use the expression $f(x)=\\sqrt{7x+2}-1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(\\sqrt{7x+2}-1) \\\\  & =\\sqrt{7(2)+2}-1 \\\\  & =\\sqrt{16}-1 \\\\  & =3.\\end{aligned}\n$$" 13194139533788 true] [17592186251162 1000 #edb/ref 17592186251163 13194139533788 true] [17592186251162 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251162 1041 "field-1" 13194139533788 true] [17592186251162 1104 #edb/ref 17592186251163 13194139533788 true] [17592186251162 1110 #uuid "70bc4c13-8f74-5e8d-8f95-8291d34c577d" 13194139533788 true] [17592186251163 1034 "2" 13194139533788 true] [17592186251163 1103 #edb/ref 17592186045453 13194139533788 true] [17592186251163 1111 #uuid "b90ee35a-4717-5a42-a548-0b5f77e31cea" 13194139533788 true] [17592186251164 1000 #edb/ref 17592186251165 13194139533788 true] [17592186251164 1040 #edb/ref 17592186045449 13194139533788 true] [17592186251164 1041 "field-2" 13194139533788 true] [17592186251164 1104 #edb/ref 17592186251165 13194139533788 true] [17592186251164 1110 #uuid "43b61a3d-3272-539b-a33b-053f8faa6297" 13