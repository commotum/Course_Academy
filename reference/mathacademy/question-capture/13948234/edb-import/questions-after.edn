\\operatorname{cos}⁡(\\frac{\\pi }{5})=4\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{5})\\operatorname{cos}⁡(\\frac{\\pi }{5})=4\\operatorname{sin}⁡(\\frac{2\\pi }{5}).\n$$"}] [{:db/id #edb/ref 17592186256321 :knowledge-point/_questions [{:knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d312bf9-58c7-5520-9129-0703c48a8cff" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡{28}^{∘}" :db/id #edb/ref 17592186256323} {:answer/id #uuid "727c4412-3cd6-58fc-99d1-47790c9ac038" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{50}^{∘}" :db/id #edb/ref 17592186256324} {:answer/id #uuid "7dfd7587-fda4-51d3-bbfd-8910552cadef" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{28}^{∘}" :db/id #edb/ref 17592186256325} {:answer/id #uuid "fc157362-2a60-5606-98ba-80157755256c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{56}^{∘}" :db/id #edb/ref 17592186256326} {:answer/id #uuid "4f4a2b50-b885-56c1-8cf9-e70be04d1f8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡{56}^{∘}" :db/id #edb/ref 17592186256327}] :answer-field/correct {:answer/id #uuid "fc157362-2a60-5606-98ba-80157755256c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{56}^{∘}" :db/id #edb/ref 17592186256326} :answer-field/id #uuid "f9834f55-f2fa-503d-b373-f1d8df6fecf3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256322}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dbcaa5c5-944e-50c6-9be1-0fbde394c6c0" :question/math-academy-id "q-7676" :question/problem "Express $2\\operatorname{sin}⁡{28}^{∘}\\operatorname{cos}⁡{28}^{∘}$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine:\n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\n \n\nSubstituting $x={28}^{∘}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡{28}^{∘}\\operatorname{cos}⁡{28}^{∘}=\\operatorname{sin}⁡(2\\cdot {28}^{∘})=\\operatorname{sin}⁡{56}^{∘}.\n$$"}]}
