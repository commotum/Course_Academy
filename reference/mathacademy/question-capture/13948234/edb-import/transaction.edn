atorname{sin}⁡(2\\cdot \\frac{\\pi }{10}) \\\\ 2\\operatorname{sin}⁡(\\frac{\\pi }{10})\\operatorname{cos}⁡(\\frac{\\pi }{10}) & =\\operatorname{sin}⁡(\\frac{\\pi }{5})\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{2\\operatorname{sin}⁡(\\frac{\\pi }{10})\\operatorname{cos}⁡(\\frac{\\pi }{10})}{\\operatorname{cos}⁡(\\frac{\\pi }{5})} & =\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{5})}{\\operatorname{cos}⁡(\\frac{\\pi }{5})}=\\operatorname{tan}⁡(\\frac{\\pi }{5})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119948/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9"] :knowledge-point/questions ["q-119948"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7305/selection/a1378dac157a00ee63c8ca5f1dfb0c92a70826a58897a40f9c2dceb5aa3cd010" :answer/id #uuid "30b3b57a-350b-57aa-9671-d921d8ac88f6" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/ensure [:answer/validate]} {:db/id "q-7305/selection/ea564a951089ed9c7db9db18a578cc93306a05ba88ac3696afb0c512a4d3d586" :answer/id #uuid "5eb68c40-7670-55f8-9bb2-511ad8765fcb" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/ensure [:answer/validate]} {:db/id "q-7305/selection/71094a981a8fa6701a4ccaba43645d22e7bfef0c2a124c5fb4732e44049b8c27" :answer/id #uuid "62346b99-48f0-5873-bfe4-a384b2655b88" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/ensure [:answer/validate]} {:db/id "q-7305/selection/41b2146f305c8c3e1f04e5d3b3d82c8c7da1ee00fee38cfb82dde8ded2ade824" :answer/id #uuid "bf1196b0-4c7c-5880-9caf-53995ca6623b" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/ensure [:answer/validate]} {:db/id "q-7305/selection/32e159084c407949dec588190f6d6834f911c007cffc9f5c1fcf9e4b59923fe