\\pi }{8})}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120018/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1"] :knowledge-point/questions ["q-120018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120030/selection/698f23e97fa8d59565649edce96b819add3a1243afe4ed6dc5d4235e417269cd" :answer/id #uuid "3dc00b94-761f-50d8-b824-5367d0294851" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡{70}^{∘}-1" :db/ensure [:answer/validate]} {:db/id "q-120030/selection/4db1a275e13914297560d39188ad5775e5aff64dfd997e50787ebbc13a5a77e1" :answer/id #uuid "edc29643-b617-541c-856c-135676894e48" :answer/type :answer.type/math :answer/value "2(1-\\operatorname{sin}⁡{70}^{∘})" :db/ensure [:answer/validate]} {:db/id "q-120030/selection/eaf283c5d14e7efea66fc0d57d40a9a74c28c1f29062bcdd2ee2df8aa614dba6" :answer/id #uuid "bc35480c-9e68-5723-bb86-f232d0d85fd5" :answer/type :answer.type/math :answer/value "2(1-\\operatorname{sin}⁡{140}^{∘})" :db/ensure [:answer/validate]} {:db/id "q-120030/selection/c5257076f35701f76a06c5c46f0ae02ee4884f59e0d878eca7bfcf7ad325d96e" :answer/id #uuid "126557c4-03cb-5df0-96b8-44428932ce41" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡{70}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-120030/selection/3c7fc74c439a0ca53e13451496b29e516ca214c9bff6b59d917869a9cd081d5a" :answer/id #uuid "32741f4f-5f3b-54f4-9a54-99df8f2ed7eb" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡{140}^{∘}-1" :db/ensure [:answer/validate]} {:db/id "q-120030/selection" :answer-field/id #uuid "c632c235-f581-5701-a287-08e8082006b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120030/selection/4db1a275e13914297560d39188ad5775e5aff64dfd997e50787ebbc13a5a77e1" :answer-field/choices ["q-120030/selection/698f23e97fa8d59565649edce96b819add3a1243afe4ed6dc5d4235e417269cd" "q-120030/selection/4db1a275e13914297560d39188ad5775e5aff64dfd997e50787ebbc13a5a77e1" "q-120030/selection/eaf283c5d14e7efea66fc0d57d40a9a74c28c1f29062bcdd2ee2df8aa614dba6" "q-120030/selection/c5257076f35701f76a06c5c46f0ae02ee4884f59e0d878eca7bfcf7ad325d96e" "q-120030/selection/3c7fc74c439a0ca53e13451496b29e516ca214c9bff6b59d917869a9cd081d5a"] :db/ensure [:answer-field/validate]} {:db/id "q-120030" :question/id #uuid "2628c4f1-9365-518c-ad53-f5432ebf8a51" :question/math-academy-id "q-120030" :question/problem "$\\frac{\\operatorname{sin}⁡{140}^{∘}\\operatorname{cot}⁡{70}^{∘}}{1+\\operatorname{sin}⁡{70}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={70}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {70}^{∘}) & =2\\operatorname{sin}⁡{70}^{∘}\\operatorname{cos}⁡{70}^{∘} \\\\ \\operatorname{sin}⁡({140}^{∘}) & =2\\operatorname{sin}⁡{70}^{∘}\\operatorname{cos}⁡{70}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{140}^{∘}\\operatorname{cot}⁡{70}^{∘}}{1+\\operatorname{sin}⁡{70}^{∘}} & =\\frac{2\\operatorname{sin}⁡{70}^{∘}\\operatorname{cos}⁡{70}^{∘}\\cdot \\frac{\\operatorname{cos}⁡{70}^{∘}}{\\operatorname{sin}⁡{70}^{∘}}}{1+\\operatorname{sin}⁡{70}^{∘}} \\\\  & =\\frac{2{cos}^{2}⁡{70}^{∘}}{1+\\operatorname{sin}⁡{70}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity in the form ${cos}^{2}⁡{70}^{∘}=1-{sin}^{2}⁡{70}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{2{cos}^{2}⁡{70}^{∘}}{1+\\operatorname{sin}⁡{70}^{∘}} & =\\frac{2(1-{sin}^{2}⁡{70}^{∘})}{1+\\operatorname{sin}⁡{70}^{∘}} \\\\  & =\\frac{2(1-\\operatorname{sin}⁡{70}^{∘})(1+\\operatorname{sin}⁡{70}^{∘})}{1+\\operatorname{sin}⁡{70}^{∘}} \\\\  & =\\frac{2(1-\\operatorname{sin}⁡{70}^{∘})\\cancel{(1+\\operatorname{sin}⁡{70}^{∘})}}{\\cancel{1+\\operatorname{sin}⁡{70}^{∘}}} \\\\  & =2(1-\\operatorname{sin}⁡{70}^{∘}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1"] :knowledge-point/questions ["q-120030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120058/selection/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" :answer/id #uuid "9c598e3d-8ec0-5060-9c46-6604a72abcc4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-120058/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "42f6c4eb-a87f-58bf-aef3-28ceb4c29ea9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120058/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "448580ff-e38e-57bf-9ca3-e7ce3176cf72" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-120058/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "f7f8f370-5c53-58d5-b28a-3312eb2ef750" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-120058/selection/c8cc0193c097b7d38e4091db7b8ea0b55b90f570b6dfeef91f6d5caca670d84e" :answer/id #uuid "8f36e0c4-2cb1-5785-bcd9-afae4aaefa72" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{4}" :db/ensure [:answer/validate]} {:db/id "q-120058/selection" :answer-field/id #uuid "e283ba02-233b-5f63-8318-1d0a3156c7ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120058/selection/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" :answer-field/choices ["q-120058/selection/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" "q-120058/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" "q-120058/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-120058/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-120058/selection/c8cc0193c097b7d38e4091db7b8ea0b55b90f570b6dfeef91f6d5caca670d84e"] :db/ensure [:answer-field/validate]} {:db/id "q-120058" :question/id #uuid "081c95ae-81cb-52c0-9684-47a33bf79aa8" :question/math-academy-id "q-120058" :question/problem "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{8})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}.$" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{8})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}=\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cdot \\frac{1}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}=\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{8})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}=\\frac{\\sqrt{2}}{4}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120058/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-120058"] :db/ensure [:knowledge-point/validate]} {:db/id "q-26907/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "900df914-20ff-5505-b0f6-e326c001dea3" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-26907/selection/ef0b1b4a04f5fc6a51d4d6a89767627b22bed976a1fce98df9bf432363517501" :answer/id #uuid "2c77db3a-1aa4-539f-a780-ce22a2aaacb3" :answer/type :answer.type/math :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-26907/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "d46f1e43-7407-5544-8349-047af93bae8d" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-26907/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "3c57098c-ca4d-5089-8705-33bb4cd019fe" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-26907/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "1f6db32f-f11a-52e4-b56d-01a2b5ea4461" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-26907/selection" :answer-field/id #uuid "2e25409f-82af-5dfd-aae5-d19fca9342ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-26907/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-26907/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-26907/selection/ef0b1b4a04f5fc6a51d4d6a89767627b22bed976a1fce98df9bf432363517501" "q-26907/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-26907/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-26907/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-26907" :question/id #uuid "01561bb9-e823-5e9c-a4a2-3c80ab23970f" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={sin}^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘}) \\\\  & =[{sin}^{2}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-26907/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-26907"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327763/field-1/ae8fd18df40ed63b030fc27f5184e683643eadeadb6020b7528ca509414435bb" :answer/id #uuid "21a4ec08-4df2-504b-8bb2-165aa83be092" :answer/type :answer.type/math :answer/value "-\\frac{7\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-327763/field-1" :answer-field/id #uuid "341f39aa-6a81-5083-8264-e503b649bf89" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327763/field-1/ae8fd18df40ed63b030fc27f5184e683643eadeadb6020b7528ca509414435bb" :answer-field/choices ["q-327763/field-1/ae8fd18df40ed63b030fc27f5184e683643eadeadb6020b7528ca509414435bb"] :db/ensure [:answer-field/validate]} {:db/id "q-327763" :question/id #uuid "8c3ab403-d373-50aa-ab7d-cad9629d8aab" :question/math-academy-id "q-327763" :question/problem "Find the exact value of $14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}).$\n\n$14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8})=$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{7\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{7\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}14\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8}) & =7\\cdot (2\\operatorname{sin}⁡(\\frac{7\\pi }{8})\\operatorname{cos}⁡(\\frac{7\\pi }{8})) \\\\  & =7\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{7\\sqrt{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327763/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-327763"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327247/field-1/8b188c767875bc36b5c2fcf455bcc6e32753ecfb0f3a6744a0ab0480c7735bf7" :answer/id #uuid "b8f7c825-7707-587d-8e45-1b9720663027" :answer/type :answer.type/math :answer/value "1+\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-327247/field-1/76f46a477e75b99655aa305865419af0de3877784cf890a4cc4d47f06e477c2c" :answer/id #uuid "a2580912-9437-58b6-aa92-b2bc4ba5d863" :answer/type :answer.type/math :answer/value "1-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-327247/field-1" :answer-field/id #uuid "f3ae0d78-4bdd-5308-93fd-56a84c536b1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327247/field-1/8b188c767875bc36b5c2fcf455bcc6e32753ecfb0f3a6744a0ab0480c7735bf7" :answer-field/choices ["q-327247/field-1/8b188c767875bc36b5c2fcf455bcc6e32753ecfb0f3a6744a0ab0480c7735bf7" "q-327247/field-1/76f46a477e75b99655aa305865419af0de3877784cf890a4cc4d47f06e477c2c"] :db/ensure [:answer-field/validate]} {:db/id "q-327247" :question/id #uuid "67832bb6-04a4-5dd5-a172-5c2d6c2063e0" :question/math-academy-id "q-327247" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}.$\n\n${(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}=$\n{{field-1}}" :question/worked-solution "First, we expand the parentheses and use the Pythagorean identity.\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,{(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2} & ={sin}^{2}⁡(\\frac{\\pi }{8})+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})+{cos}^{2}⁡(\\frac{\\pi }{8}) \\\\  & =[{sin}^{2}⁡(\\frac{\\pi }{8})+{cos}^{2}⁡(\\frac{\\pi }{8})]+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) \\\\  & =1+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\end{aligned}\n$$\n\nLet's recall the double-angle formula for sine:\n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=1+\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}=1+\\frac{\\sqrt{2}}{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327247/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-327247"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327277/field-1/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" :answer/id #uuid "c0e0681e-e415-58e5-bbfa-fab3a58a6398" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-327277/field-1" :answer-field/id #uuid "3511f9b5-075c-5b03-891e-874ccc91a604" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327277/field-1/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" :answer-field/choices ["q-327277/field-1/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1"] :db/ensure [:answer-field/validate]} {:db/id "q-327277" :question/id #uuid "b7ad8a7a-7fe3-5da1-8b56-916c39195e84" :question/math-academy-id "q-327277" :question/problem "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=$\n{{field-1}}" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\cdot \\frac{1}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8})\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{3\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8})=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\frac{\\sqrt{2}}{4}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-327277/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8"] :knowledge-point/questions ["q-327277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-24645/selection/ab4968165ae1688bb93207b8efd5e1f9545a2d0bba80c375c996fc4265a49f3e" :answer/id #uuid "bc1e05b2-a95b-57dc-b431-2f45bddc475e" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/ensure [:answer/validate]} {:db/id "q-24645/selection/6fb38bd9af42f00e1fe290593de532585d15dce8fde79a4010a278a346dcfa10" :answer/id #uuid "5999ac75-6f23-5ab3-a5d3-56f8903910ca" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/ensure [:answer/validate]} {:db/id "q-