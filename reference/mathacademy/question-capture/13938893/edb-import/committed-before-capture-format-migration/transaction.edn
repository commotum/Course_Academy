[{:db/id "q-2385/selection/c29f2f176175b5e144dd29f8811986c462b7ae7e4ef8a6dacc3abd16f3c58118" :answer/id #uuid "0298d7c4-e1f7-59cb-b57c-002e9a1e2e3e" :answer/type :answer.type/math :answer/value "\\frac{sin⁡x-2cos⁡x}{10{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-2385/selection/6c9644576ec46396f4cd13f130370696bd4ee648c6bf6771e1b1a4a5f52f9a6d" :answer/id #uuid "1972c673-2f4d-5387-a601-da273220e0fb" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}sin⁡x-2cos⁡x}{10{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-2385/selection/6f4b103dc381accc54f53e0cbb0d8dd26eff4a2c803ab03ba4f62619be0a835e" :answer/id #uuid "447571ba-27a5-5107-b39e-a36cd3a2da45" :answer/type :answer.type/math :answer/value "\\frac{sin⁡x-cos⁡x}{10{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-2385/selection/d44b659fea72d75a3795394b80720a6f80a05d1446f327bcd5a633e74d488aab" :answer/id #uuid "e2d3376e-477e-5c19-b6a8-15e8d8be22b0" :answer/type :answer.type/math :answer/value "\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-2385/selection/e7895e65f6cf1d886e19a59fcc9da333928b8a24d595107c2896c5dd36b36dbe" :answer/id #uuid "ca8d7719-b994-560c-b453-2e1a6764b0cf" :answer/type :answer.type/math :answer/value "\\frac{xsin⁡x-2cos⁡x}{10{x}^{4}}" :db/ensure [:answer/validate]} {:db/id "q-2385/selection" :answer-field/id #uuid "be09579d-9242-527e-9ac5-51867f38dd44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2385/selection/d44b659fea72d75a3795394b80720a6f80a05d1446f327bcd5a633e74d488aab" :answer-field/choices ["q-2385/selection/c29f2f176175b5e144dd29f8811986c462b7ae7e4ef8a6dacc3abd16f3c58118" "q-2385/selection/6c9644576ec46396f4cd13f130370696bd4ee648c6bf6771e1b1a4a5f52f9a6d" "q-2385/selection/6f4b103dc381accc54f53e0cbb0d8dd26eff4a2c803ab03ba4f62619be0a835e" "q-2385/selection/d44b659fea72d75a3795394b80720a6f80a05d1446f327bcd5a633e74d488aab" "q-2385/selection/e7895e65f6cf1d886e19a59fcc9da333928b8a24d595107c2896c5dd36b36dbe"] :db/ensure [:answer-field/validate]} {:db/id "q-2385" :question/id #uuid "e07a15ed-7f83-5697-b390-b47e0fed57d3" :question/math-academy-id "q-2385" :question/is-example false :question/problem "If $f(x)=\\frac{cos⁡x}{10{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=cos⁡x$ and $v(x)=10{x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-sin⁡x)(10{x}^{2})-(cos⁡x)(20x)}{(10{x}^{2})^{2}} \\\\  & =\\frac{-10{x}^{2}sin⁡x-20xcos⁡x}{100{x}^{4}} \\\\  & =\\frac{\\cancel{10x}(-xsin⁡x-2cos⁡x)}{\\cancel{10x}\\cdot 10{x}^{3}} \\\\  & =\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2385/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-2385"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47943/selection/391be31ff2213a12ca70b851d95e534d238ec01f8e02fa46bb2f39ddd5bf820b" :answer/id #uuid "4d814370-27d9-5d14-a9b5-4d68dc19ed31" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{sin}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-47943/selection/2b4008fd7ebc593a3293241b0c2b6f47407055128fb905449aa7a5ece81aaf87" :answer/id #uuid "3d2d5fbf-0155-5bc0-9b90-b234aaf29dc8" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{{cos}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-47943/selection/4d3406636f71c25b4fbc088a6dc4c79e34e000f9f05ebeeec75612a697c1c984" :answer/id #uuid "f7c525e5-c874-5d18-b554-82b80fb19988" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{cos}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-47943/selection/5f6853f4db2ad52d0c9714ded6cc21860ed775ebcdb08a75b36ce5bdd6ce5939" :answer/id #uuid "9262a8cf-40aa-5069-be49-5ddbc2e1bf0b" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{cos⁡x}" :db/ensure [:answer/validate]} {:db/id "q-47943/selection/ba9596a2e4acc83ff8d3ca6a99809149540384952d0ebeeed5e71053639de024" :answer/id #uuid "84956ea6-986d-514e-9b69-3a8f0c029914" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-47943/selection" :answer-field/id #uuid "39c6ab64-d55e-5873-83ff-9bdfd9743f5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47943/selection/ba9596a2e4acc83ff8d3ca6a99809149540384952d0ebeeed5e71053639de024" :answer-field/choices ["q-47943/selection/391be31ff2213a12ca70b851d95e534d238ec01f8e02fa46bb2f39ddd5bf820b" "q-47943/selection/2b4008fd7ebc593a3293241b0c2b6f47407055128fb905449aa7a5ece81aaf87" "q-47943/selection/4d3406636f71c25b4fbc088a6dc4c79e34e000f9f05ebeeec75612a697c1c984" "q-47943/selection/5f6853f4db2ad52d0c9714ded6cc21860ed775ebcdb08a75b36ce5bdd6ce5939" "q-47943/selection/ba9596a2e4acc83ff8d3ca6a99809149540384952d0ebeeed5e71053639de024"] :db/ensure [:answer-field/validate]} {:db/id "q-47943" :question/id #uuid "c49bd4f2-e707-576e-bc3a-9055f28a3971" :question/math-academy-id "q-47943" :question/is-example false :question/problem "If $f(x)=\\frac{{e}^{x}}{cos⁡x},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot cos⁡x-{e}^{x}\\cdot (cos⁡x)^{′}}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}cos⁡x+{e}^{x}sin⁡x}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-47943/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-47943"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47994/selection/2c7fe482f94a066f5c1c487e5590b1dd628ec77d2f6235f5e0655e57a46354a3" :answer/id #uuid "c3475223-11e3-5df1-b757-88c5192918ab" :answer/type :answer.type/math :answer/value "\\frac{x(cos⁡x-sin⁡x)}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-47994/selection/98c7351badeb86acad80f7f3986f20bb1793363df73250e80d49d73979fb6ea3" :answer/id #uuid "da7c2b50-f909-56d5-9875-51c5fd7a7141" :answer/type :answer.type/math :answer/value "\\frac{xcos⁡x-sin⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-47994/selection/e81c090dc1d1c02088e8bdea92d5f2970174d70e591b4527a5ae8f06dab55066" :answer/id #uuid "f8485091-8a96-5750-a7a1-59d857c8f184" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x-xsin⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-47994/selection/d6605830b116e808da1c9d546c4ae3ff66b108050d76ab2f455db8256f450d74" :answer/id #uuid "f43fefb2-bef3-5020-81f8-4ee9106e51c8" :answer/type :answer.type/math :answer/value "\\frac{xcos⁡x+sin⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-47994/selection/92f088582cdc0338c03c49a540572bb251d7c814d8cedaaadd709e363644f826" :answer/id #uuid "18b14e45-3112-5d32-85c1-9cbefcf8849b" :answer/type :answer.type/math :answer/value "\\frac{xcos⁡x-sin⁡x}{x}" :db/ensure [:answer/validate]} {:db/id "q-47994/selection" :answer-field/id #uuid "760c9074-82b8-549f-b954-59d5d57a9c31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47994/selection/98c7351badeb86acad80f7f3986f20bb1793363df73250e80d49d73979fb6ea3" :answer-field/choices ["q-47994/selection/2c7fe482f94a066f5c1c487e5590b1dd628ec77d2f6235f5e0655e57a46354a3" "q-47994/selection/98c7351badeb86acad80f7f3986f20bb1793363df73250e80d49d73979fb6ea3" "q-47994/selection/e81c090dc1d1c02088e8bdea92d5f2970174d70e591b4527a5ae8f06dab55066" "q-47994/selection/d6605830b116e808da1c9d546c4ae3ff66b108050d76ab2f455db8256f450d74" "q-47994/selection/92f088582cdc0338c03c49a540572bb251d7c814d8cedaaadd709e363644f826"] :db/ensure [:answer-field/validate]} {:db/id "q-47994" :question/id #uuid "ecad35be-533e-5219-83ba-78f271f39fec" :question/math-academy-id "q-47994" :question/is-example false :question/problem "Given that $y=\\frac{sin⁡x}{x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=sin⁡x$ and $v=x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=1.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{x(cos⁡x)-sin⁡x\\cdot (1)}{(x)^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{{x}^{2}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-47994/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-47994"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48507/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "1d3e535f-f432-58d0-8819-edfc60a2ff92" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-48507/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "b2f4988e-0aee-519f-82df-e6f04ca9bd4d" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-48507/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" :answer/id #uuid "f98f82fc-8698-5950-801c-c279922fc98b" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "q-48507/selection/9e8189a27a83304b098887ef1b653d77bfa8b6721b8d1af35a30758afc329a1d" :answer/id #uuid "fdfa0ded-eadc-58e6-aff7-dc3f96575ccd" :answer/type :answer.type/math :answer/value "-\\frac{1}{2\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48507/selection/70787413147d4d16d299f7c853b6379c1c1c0cacd6da013c9cde7cc1444c0311" :answer/id #uuid "e1d300ae-6ae5-5b6f-b181-267defa5fad3" :answer/type :answer.type/math :answer/value "\\frac{1}{4\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48507/selection" :answer-field/id #uuid "d3631e5e-fa10-547c-89ea-d51d11675141" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48507/selection/9e8189a27a83304b098887ef1b653d77bfa8b6721b8d1af35a30758afc329a1d" :answer-field/choices ["q-48507/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-48507/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-48507/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" "q-48507/selection/9e8189a27a83304b098887ef1b653d77bfa8b6721b8d1af35a30758afc329a1d" "q-48507/selection/70787413147d4d16d299f7c853b6379c1c1c0cacd6da013c9cde7cc1444c0311"] :db/ensure [:answer-field/validate]} {:db/id "q-48507" :question/id #uuid "a8047467-bbe6-52af-9503-e0d4183db84e" :question/math-academy-id "q-48507" :question/is-example false :question/problem "If a curve $C$ is given by $y=\\frac{sin⁡x}{2x},$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)=2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot (2x)-sin⁡x\\cdot (2x)^{′}}{(2x)^{2}} \\\\  & =\\frac{cos⁡x\\cdot (2x)-sin⁡x\\cdot 2}{{(2x)}^{2}} \\\\  & =\\frac{2(xcos⁡x-sin⁡x)}{4{x}^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{2{x}^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =\\frac{\\pi cos⁡(\\pi )-sin⁡(\\pi )}{2(\\pi )^{2}} \\\\  & =\\frac{\\pi (-1)-(0)}{2{\\pi }^{2}} \\\\  & =-\\frac{\\pi }{2{\\pi }^{2}} \\\\  & =-\\frac{1}{2\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{1}{2\\pi }.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48507/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-48507"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340332/field-1/2736027972f83a292425a37d6f20f301c676b044e92e527e2f70552fbc704032" :answer/id #uuid "5f2541ad-9157-50a6-b497-5e2e74dba85d" :answer/type :answer.type/math :answer/value "\\frac{2x}{(x^2+1)^2}" :db/ensure [:answer/validate]} {:db/id "q-340332/field-1" :answer-field/id #uuid "1051e7ba-f33d-556e-ae25-9fb71cdc09d8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340332/field-1/2736027972f83a292425a37d6f20f301c676b044e92e527e2f70552fbc704032" :answer-field/choices ["q-340332/field-1/2736027972f83a292425a37d6f20f301c676b044e92e527e2f70552fbc704032"] :db/ensure [:answer-field/validate]} {:db/id "q-340332" :question/id #uuid "7001b0c3-bc98-5a8e-9b42-ca25a529f192" :question/math-academy-id "q-340332" :question/is-example false :question/problem "Given that $y=\\frac{{x}^{2}}{{x}^{2}+1}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{2}$ and $v={x}^{2}+1.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}+1)\\cdot 2x-{x}^{2}\\cdot 2x}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2{x}^{3}+2x-2{x}^{3}}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2x}{{({x}^{2}+1)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340332/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-340332"] :db/ensure [:knowledge-point/validate]}]
