#{[{:db/id #edb/ref 17592186247906 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1972c673-2f4d-5387-a601-da273220e0fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}sin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186247908} {:answer/id #uuid "447571ba-27a5-5107-b39e-a36cd3a2da45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{sin⁡x-cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186247909} {:answer/id #uuid "0298d7c4-e1f7-59cb-b57c-002e9a1e2e3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{sin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186247910} {:answer/id #uuid "e2d3376e-477e-5c19-b6a8-15e8d8be22b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186247911} {:answer/id #uuid "ca8d7719-b994-560c-b453-2e1a6764b0cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xsin⁡x-2cos⁡x}{10{x}^{4}}" :db/id #edb/ref 17592186247912}] :answer-field/correct {:answer/id #uuid "e2d3376e-477e-5c19-b6a8-15e8d8be22b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}" :db/id #edb/ref 17592186247911} :answer-field/id #uuid "be09579d-9242-527e-9ac5-51867f38dd44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247907}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e07a15ed-7f83-5697-b390-b47e0fed57d3" :question/is-example false :question/math-academy-id "q-2385" :question/problem "If $f(x)=\\frac{cos⁡x}{10{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=cos⁡x$ and $v(x)=10{x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-sin⁡x)(10{x}^{2})-(cos⁡x)(20x)}{(10{x}^{2})^{2}} \\\\  & =\\frac{-10{x}^{2}sin⁡x-20xcos⁡x}{100{x}^{4}} \\\\  & =\\frac{\\cancel{10x}(-xsin⁡x-2cos⁡x)}{\\cancel{10x}\\cdot 10{x}^{3}} \\\\  & =\\frac{-xsin⁡x-2cos⁡x}{10{x}^{3}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247913 :knowledge-point/_questions [{:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f2541ad-9157-50a6-b497-5e2e74dba85d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{(x^2+1)^2}" :db/id #edb/ref 17592186247915}] :answer-field/correct {:answer/id #uuid "5f2541ad-9157-50a6-b497-5e2e74dba85d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{(x^2+1)^2}" :db/id #edb/ref 17592186247915} :answer-field/id #uuid "1051e7ba-f33d-556e-ae25-9fb71cdc09d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247914}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7001b0c3-bc98-5a8e-9b42-ca25a529f192" :question/is-example false :question/math-academy-id "q-340332" :question/problem "Given that $y=\\frac{{x}^{2}}{{x}^{2}+1}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{2}$ and $v={x}^{2}+1.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}+1)\\cdot 2x-{x}^{2}\\cdot 2x}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2{x}^{3}+2x-2{x}^{3}}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2x}{{({x}^{2}+1)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247916 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d2d5fbf-0155-5bc0-9b90-b234aaf29dc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186247918} {:answer/id #uuid "4d814370-27d9-5d14-a9b5-4d68dc19ed31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{sin}^{2}⁡x}" :db/id #edb/ref 17592186247919} {:answer/id #uuid "f7c525e5-c874-5d18-b554-82b80fb19988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186247920} {:answer/id #uuid "9262a8cf-40aa-5069-be49-5ddbc2e1bf0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{cos⁡x}" :db/id #edb/ref 17592186247921} {:answer/id #uuid "84956ea6-986d-514e-9b69-3a8f0c029914" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186247922}] :answer-field/correct {:answer/id #uuid "84956ea6-986d-514e-9b69-3a8f0c029914" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186247922} :answer-field/id #uuid "39c6ab64-d55e-5873-83ff-9bdfd9743f5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247917}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c49bd4f2-e707-576e-bc3a-9055f28a3971" :question/is-example false :question/math-academy-id "q-47943" :question/problem "If $f(x)=\\frac{{e}^{x}}{cos⁡x},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot cos⁡x-{e}^{x}\\cdot (cos⁡x)^{′}}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}cos⁡x+{e}^{x}sin⁡x}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247923 :knowledge-point/_questions [{:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3475223-11e3-5df1-b757-88c5192918ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x(cos⁡x-sin⁡x)}{{x}^{2}}" :db/id #edb/ref 17592186247925} {:answer/id #uuid "18b14e45-3112-5d32-85c1-9cbefcf8849b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{x}" :db/id #edb/ref 17592186247926} {:answer/id #uuid "da7c2b50-f909-56d5-9875-51c5fd7a7141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186247927} {:answer/id #uuid "f43fefb2-bef3-5020-81f8-4ee9106e51c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186247928} {:answer/id #uuid "f8485091-8a96-5750-a7a1-59d857c8f184" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-xsin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186247929}] :answer-field/correct {:answer/id #uuid "da7c2b50-f909-56d5-9875-51c5fd7a7141" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186247927} :answer-field/id #uuid "760c9074-82b8-549f-b954-59d5d57a9c31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247924}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ecad35be-533e-5219-83ba-78f271f39fec" :question/is-example false :question/math-academy-id "q-47994" :question/problem "Given that $y=\\frac{sin⁡x}{x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=sin⁡x$ and $v=x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=1.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{x(cos⁡x)-sin⁡x\\cdot (1)}{(x)^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{{x}^{2}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247930 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2f4988e-0aee-519f-82df-e6f04ca9bd4d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186247932} {:answer/id #uuid "e1d300ae-6ae5-5b6f-b181-267defa5fad3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\pi }" :db/id #edb/ref 17592186247933} {:answer/id #uuid "f98f82fc-8698-5950-801c-c279922fc98b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186247934} {:answer/id #uuid "fdfa0ded-eadc-58e6-aff7-dc3f96575ccd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186247935} {:answer/id #uuid "1d3e535f-f432-58d0-8819-edfc60a2ff92" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186247936}] :answer-field/correct {:answer/id #uuid "fdfa0ded-eadc-58e6-aff7-dc3f96575ccd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186247935} :answer-field/id #uuid "d3631e5e-fa10-547c-89ea-d51d11675141" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247931}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a8047467-bbe6-52af-9503-e0d4183db84e" :question/is-example false :question/math-academy-id "q-48507" :question/problem "If a curve $C$ is given by $y=\\frac{sin⁡x}{2x},$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)=2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot (2x)-sin⁡x\\cdot (2x)^{′}}{(2x)^{2}} \\\\  & =\\frac{cos⁡x\\cdot (2x)-sin⁡x\\cdot 2}{{(2x)}^{2}} \\\\  & =\\frac{2(xcos⁡x-sin⁡x)}{4{x}^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{2{x}^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =\\frac{\\pi cos⁡(\\pi )-sin⁡(\\pi )}{2(\\pi )^{2}} \\\\  & =\\frac{\\pi (-1)-(0)}{2{\\pi }^{2}} \\\\  & =-\\frac{\\pi }{2{\\pi }^{2}} \\\\  & =-\\frac{1}{2\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{1}{2\\pi }.$"}]}
