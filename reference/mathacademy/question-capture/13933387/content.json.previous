            },
            {
              "type": "math",
              "value": "9ln⁡|x|+C"
            },
            {
              "type": "math",
              "value": "ln⁡|x|+9x+C"
            }
          ],
          "correct_value": "\\frac{1}{9}ln⁡|x|+C"
        }
      ],
