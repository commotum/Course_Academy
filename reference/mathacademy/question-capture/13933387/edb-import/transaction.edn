{x})}^{2}\\text{d}x & =\\int (4-\\frac{4}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int 4\\,\\text{d}x-\\int \\frac{4}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4x-4ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =4x-4ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49100/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923"] :knowledge-point/questions ["q-49100"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29888/selection/adfe40c89a7282eb96021498aae61d70072111a55859524d4f51a27b17a5cfb1" :answer/id #uuid "e338e1f8-f748-5ad0-b086-779bf0376598" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29888/selection/7041074bf1e2b452856ae7f75160f831c9449d10e7d35e79cf2d75d8fdda124d" :answer/id #uuid "892fb345-663e-5fd3-89bc-8a79e2d1c780" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{x}^{2}+3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29888/selection/2999166c7bfbcb83bdea800ed63b57db314ff9d0013dddd88ebf65e149606031" :answer/id #uuid "9c94b488-8667-5bad-8a27-75fe30e06b03" :answer/type :answer.type/math :answer/value "\\frac{5}{2}{x}^{2}+4ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29888/selection/12189df03b4aa6658b527f7a8547be7b90bd437d5764d5e2cb03be9465424187" :answer/id #uuid "0a823de7-0965-57df-b2ee-5a35004bf699" :answer/type :answer.type/math :answer/value "\\frac{2}{3}{x}^{2}+2ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29888/selection/233c6eafb4d581f745e0dfe7c660d6ccae7ac1d22593ffc566a386acae06ccf5" :answer/id #uuid "b821e203-543c-5ae4-b1bb-1ef9fdefc48c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}{x}^{2}+5ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29888/selection" :answer-field/id #uuid "1132