}x \\\\  & =2\\cdot \\frac{{x}^{7/3+1}}{(\\frac{7}{3}+1)}-\\frac{1}{3}ln⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-29886/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923"] :knowledge-point/questions ["q-29886"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49067/selection/96e39a73cd3f9b571e9630efaac1b8a7ba1df94375560277651dcaa7febaa1c5" :answer/id #uuid "e6387507-7b6a-53b3-a25c-2c230d5c7448" :answer/type :answer.type/math :answer/value "1-\\frac{1}{x}+2ln⁡(|K|x)" :db/ensure [:answer/validate]} {:db/id "q-49067/selection/147f4f2c270a6f95f179659060838fc298e7828d78cb4ab004754254c30c68e3" :answer/id #uuid "743dd1c3-7700-5f2b-a471-d08f674c2509" :answer/type :answer.type/math :answer/value "x-\\frac{1}{x}+2ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-49067/selection/3c5421cf5fdb0c0a159f3bee12f7835fffbc80057c273ad8cf23ee0cff735856" :answer/id #uuid "53ad2061-2be1-5740-85ce-4223a41c91f1" :answer/type :answer.type/math :answer/value "1+2ln⁡(|K|x)" :db/ensure [:answer/validate]} {:db/id "q-49067/selection/22a093fd44b46ad95c46f894478a6734156186b2c02088a602b8c6bf5f9fc6c5" :answer/id #uuid "458bbd76-bde1-5719-8658-7ec82ebf748b" :answer/type :answer.type/math :answer/value "x+(1+ln⁡(K|x|))^{2}" :db/ensure [:answer/validate]} {:db/id "q-49067/selection/ef4a4fbe33a570cf385130cf2939e3a63e925b65b66ecf32afa1e5ada2ab2388" :answer/id #uuid "288db83c-ee07-58dc-9d12-d4f7af99832a" :answer/type :answer.type/math :answer/value "x-\\frac{1}{x}+ln⁡(2K|x|)" :db/ensure [:answer/validate]} {:db/id "q-49067/selection" :answer-field/id #uuid "f0613541-d58b-55a7-98ea-5a4e08a846b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49067/selection/147f4f2c270a6f95f179659060838fc298e7828d78cb4ab004754254c30c68e3" :answer-field/choices ["q-49067/selection/96e39a73cd3f9b571e9630efaac1b8a7ba1df94375560277651dcaa7febaa1c5" "q-49067/selection/147f4f2c270a6f95f179659060838fc298e7828d78cb4ab004754254c30c68e3" "q-49067/selection/3c5421cf5fdb0c0a159f3bee12f7835fffbc80057c273ad8cf23ee0cff735856" "q-49067/selection/22a093fd44b46ad95c46f894478a6734156186b2c02088a602b8c6bf5f9fc6c5" "q-49067/selection/ef4a4fbe33a570cf385130cf2939e3a63e925b65b66ecf32afa1e5ada2ab2388"] :db/ensure [:answer-field/validate]} {:db/id "q-49067" :question/id #uuid "8e532e27-9517-5098-b18d-b59e55e193d6" :question/math-academy-id "q-49067" :question/is-example false :question/problem "What is the antiderivative of ${(1+\\frac{1}{x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{1}{x})}^{2}\\text{d}x & =\\int (1+\\frac{2}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+2\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+2ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =x+2ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=2ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $2ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{1}{x})}^{2}\\text{d}x & =x-\\frac{1}{x}+2ln⁡|x|+2ln⁡K \\\\  & =x-\\frac{1}{x}+2(ln⁡|x|+ln⁡K) \\\\  & =x-\\frac{1}{x}+2ln⁡(K|x|).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49067/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9"] :knowledge-point/questions ["q-49067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103375/selection/b759e9fbc227cbae2bb11c16f4281ec5c3525058f489c90b15a5a70d4195c3e0" :answer/id #uuid "262f1ae0-7682-54b1-a14b-1e1b29639584" :answer/type :answer.type/math :answer/value "x-\\frac{9}{4x}+ln⁡(3K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103375/selection/44b5b75a562268bb7c55bf09c25bb7e4fd7bdca55884745643642ba658711c4b" :answer/id #uuid "9650511f-c6c7-561e-b264-dbb7415ad415" :answer/type :answer.type/math :answer/value "1-\\frac{3}{2x}+3ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103375/selection/b1a6c05f33eb62a9d2ae6adbdc0f590c4028e450bc2c2fc3288625bb27311363" :answer/id #uuid "b95522b3-770d-5d83-959c-a8ab20a9467c" :answer/type :answer.type/math :answer/value "x-\\frac{9}{4x}+3ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103375/selection/fefff388bd09c742c1feedf51e8f72d835852ff30ef1afca62e914752b701396" :answer/id #uuid "1ba8a068-d36f-5b9e-b0a4-f6bd8a68aaf4" :answer/type :answer.type/math :answer/value "x-\\frac{3}{2x}+3ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103375/selection/9d1a6f5869192fe4871b82e038c3da6aabc08336a681ea1c03e1f20ce7eb37aa" :answer/id #uuid "ed3cae77-e0a5-5fe0-91ed-6971b20011fe" :answer/type :answer.type/math :answer/value "1-\\frac{3}{2x}+ln⁡(3K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103375/selection" :answer-field/id #uuid "1106a4d3-3ecc-5385-bc8e-05a89af44b71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103375/selection/b1a6c05f33eb62a9d2ae6adbdc0f590c4028e450bc2c2fc3288625bb27311363" :answer-field/choices ["q-103375/selection/b759e9fbc227cbae2bb11c16f4281ec5c3525058f489c90b15a5a70d4195c3e0" "q-103375/selection/44b5b75a562268bb7c55bf09c25bb7e4fd7bdca55884745643642ba658711c4b" "q-103375/selection/b1a6c05f33eb62a9d2ae6adbdc0f590c4028e450bc2c2fc3288625bb27311363" "q-103375/selection/fefff388bd09c742c1feedf51e8f72d835852ff30ef1afca62e914752b701396" "q-103375/selection/9d1a6f5869192fe4871b82e038c3da6aabc08336a681ea1c03e1f20ce7eb37aa"] :db/ensure [:answer-field/validate]} {:db/id "q-103375" :question/id #uuid "934a8bc5-8b96-5268-9bd1-b570f7ef0ce6" :question/math-academy-id "q-103375" :question/is-example false :question/problem "What is the antiderivative of ${(1+\\frac{3}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{3}{x}+\\frac{9}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+3\\int \\frac{1}{x}\\,\\text{d}x+\\frac{9}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+3ln⁡|x|+\\frac{9{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+3ln⁡|x|-\\frac{9}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=3ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $3ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =x-\\frac{9}{4x}+3ln⁡|x|+3ln⁡K \\\\  & =x-\\frac{9}{4x}+3(ln⁡|x|+ln⁡K) \\\\  & =x-\\frac{9}{4x}+3ln⁡(K|x|).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103375/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9"] :knowledge-point/questions ["q-103375"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103603/selection/c198fa76f9a682a47995c414e14619759fadeaed43a8412f0b3110e20f4c2ff3" :answer/id #uuid "3263f433-bd19-5aee-8725-2933b2272fa3" :answer/type :answer.type/math :answer/value "2ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103603/selection/bece70089423c33368ba7f25f216b749dfe4688758f60c1b98f121f23f131685" :answer/id #uuid "12e483e3-188c-5f0f-8818-708e5d2bb117" :answer/type :answer.type/math :answer/value "\\frac{ln⁡(K|x|)}{2}" :db/ensure [:answer/validate]} {:db/id "q-103603/selection/20c4734ecec6cdf6005e3caebb43e85060ae3c4de9289e59d661887cbeabc8a4" :answer/id #uuid "b8ffee20-da7a-5122-96fb-f62f80610377" :answer/type :answer.type/math :answer/value "\\frac{2}{ln⁡(K|x|)}" :db/ensure [:answer/validate]} {:db/id "q-103603/selection/8518c922d147b7746dfca49be4ec43491eeda1d4c9e1b1efb0207e28fcf575c6" :answer/id #uuid "474617a8-b059-59b4-b0d4-0b090e35b524" :answer/type :answer.type/math :answer/value "ln⁡(\\frac{K|x|}{2})" :db/ensure [:answer/validate]} {:db/id "q-103603/selection/7f27437b7e0bbb525f9b0f6d796559b6ca881d51ea6c3a03d9b0b57eb15d369a" :answer/id #uuid "cc30956b-d428-55b2-886c-f1912aa4f8c2" :answer/type :answer.type/math :answer/value "ln⁡(2K|x|)" :db/ensure [:answer/validate]} {:db/id "q-103603/selection" :answer-field/id #uuid "43ce3375-65df-5470-9329-b5db269dae0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103603/selection/c198fa76f9a682a47995c414e14619759fadeaed43a8412f0b3110e20f4c2ff3" :answer-field/choices ["q-103603/selection/c198fa76f9a682a47995c414e14619759fadeaed43a8412f0b3110e20f4c2ff3" "q-103603/selection/bece70089423c33368ba7f25f216b749dfe4688758f60c1b98f121f23f131685" "q-103603/selection/20c4734ecec6cdf6005e3caebb43e85060ae3c4de9289e59d661887cbeabc8a4" "q-103603/selection/8518c922d147b7746dfca49be4ec43491eeda1d4c9e1b1efb0207e28fcf575c6" "q-103603/selection/7f27437b7e0bbb525f9b0f6d796559b6ca881d51ea6c3a03d9b0b57eb15d369a"] :db/ensure [:answer-field/validate]} {:db/id "q-103603" :question/id #uuid "9fe3753b-87a6-5212-beea-3e090a804668" :question/math-academy-id "q-103603" :question/is-example false :question/problem "What is the antiderivative of $2{x}^{-1}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $2$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int 2{x}^{-1}\\,\\text{d}x & =2\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=2ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $2ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int 2{x}^{-1}\\,\\text{d}x & =2ln⁡|x|+2ln⁡K \\\\  & =2(ln⁡|x|+ln⁡K) \\\\  & =2ln⁡(K|x|).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103603/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9"] :knowledge-point/questions ["q-103603"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29834/selection/ae491c8ad905c65262cc273773d86cbd66946cf0d6786386ccc5462efa845ba6" :answer/id #uuid "d8509648-b8b7-5a62-9e44-85b8204bd9b9" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}ln⁡(|x|+K)" :db/ensure [:answer/validate]} {:db/id "q-29834/selection/79b4d8e5286a96b29ef41960aef9909c759cc6a0086b894f3c286ff0dbc793f0" :answer/id #uuid "aeaefb05-1120-5469-8e48-3c3418df10f7" :answer/type :answer.type/math :answer/value "-ln⁡(\\frac{5}{2}K|x|)" :db/ensure [:answer/validate]} {:db/id "q-29834/selection/9a761440c5d8c5066d25db9b55df9de058cf37eeae063627062355c97153c6eb" :answer/id #uuid "93b64ef2-d3f6-5f4e-a571-d15cfbaeabd9" :answer/type :answer.type/math :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-29834/selection/d6e55ca5afd1ce3620ecb3eb3d6863592dab86572add2f33ede8e10d3d7ee621" :answer/id #uuid "dbcc41a3-b136-54d6-b54f-3347ccc74910" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-29834/selection/d53d96cfe6e174b2fc7850d009221eb29871e0dd1229519ca4b54ea3d111b90d" :answer/id #uuid "e7659ebe-d927-537d-8dd0-a3c09cc179c6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/ensure [:answer/validate]} {:db/id "q-29834/selection" :answer-field/id #uuid "438eb0be-5b2f-55bc-974a-51df73898ccd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29834/selection/d6e55ca5afd1ce3620ecb3eb3d6863592dab86572add2f33ede8e10d3d7ee621" :answer-field/choices ["q-29834/selection/ae491c8ad905c65262cc273773d86cbd66946cf0d6786386ccc5462efa845ba6" "q-29834/selection/79b4d8e5286a96b29ef41960aef9909c759cc6a0086b894f3c286ff0dbc793f0" "q-29834/selection/9a761440c5d8c5066d25db9b55df9de058cf37eeae063627062355c97153c6eb" "q-29834/selection/d6e55ca5afd1ce3620ecb3eb3d6863592dab86572add2f33ede8e10d3d7ee621" "q-29834/selection/d53d96cfe6e174b2fc7850d009221eb29871e0dd1229519ca4b54ea3d111b90d"] :db/ensure [:answer-field/validate]} {:db/id "q-29834" :question/id #uuid "9bf769c8-5612-5674-8d58-94da7b62284f" :question/math-academy-id "q-29834" :question/is-example false :question/problem "What is the antiderivative of $-\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}ln⁡|x|-\\frac{5}{2}ln⁡K \\\\  & =-\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =-\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-29834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9"] :knowledge-point/questions ["q-29834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15710/selection/ba915b02d2e1529a88b2f3ddf444e5b2c367bf773a8b8a0beda283f7b8633794" :answer/id #uuid "94d01489-e7db-54c1-8dac-8300deaf5ab7" :answer/type :answer.type/math :answer/value "\\frac{5}{2}ln⁡(|x|+K)" :db/ensure [:answer/validate]} {:db/id "q-15710/selection/d53d96cfe6e174b2fc7850d009221eb29871e0dd1229519ca4b54ea3d111b90d" :answer/id #uuid "697e2cee-d932-53c4-b6fe-3ed8095f715f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/ensure [:answer/validate]} {:db/id "q-15710/selection/9a761440c5d8c5066d25db9b55df9de058cf37eeae063627062355c97153c6eb" :answer/id #uuid "42ea6ec0-8538-51cf-b490-7f715e468784" :answer/type :answer.type/math :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/ensure [:answer/validate]} {:db/id "q-15710/selection/16dc315720ac2a739e48b16fc1f50077cec53e736a35dbac9dd942cc529df2ca" :answer/id #uuid "6a6d218d-49de-564b-9069-dc03f8bfd57f" :answer/type :answer.type/math :answer/value "ln⁡(\\frac{5}{2}K|x|)" :db/ensure [:answer/validate]} {:db/id "q-15710/selection/573f1e761b62c693d73e0b75b737e024fa71139d16a44db38b31a42311082f9b" :answer/id #uuid "1bd358b3-3148-5a80-9184-d1a5efe6a25a" :answer/type :answer.type/math :answer/value "ln⁡(\\frac{5}{2}|x|+K)" :db/ensure [:answer/validate]} {:db/id "q-15710/selection" :answer-field/id #uuid "ed982b4f-8a5f-595e-b736-9b3a360cb4df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15710/selection/9a761440c5d8c5066d25db9b55df9de058cf37eeae063627062355c97153c6eb" :answer-field/choices ["q-15710/selection/ba915b02d2e1529a88b2f3ddf444e5b2c367bf773a8b8a0beda283f7b8633794" "q-15710/selection/d53d96cfe6e174b2fc7850d009221eb29871e0dd1229519ca4b54ea3d111b90d" "q-15710/selection/9a761440c5d8c5066d25db9b55df9de058cf37eeae063627062355c97153c6eb" "q-15710/selection/16dc315720ac2a739e48b16fc1f50077cec53e736a35dbac9dd942cc529df2ca" "q-15710/selection/573f1e761b62c693d73e0b75b737e024fa71139d16a44db38b31a42311082f9b"] :db/ensure [:answer-field/validate]} {:db/id "q-15710" :question/id #uuid "8d1f204e-6159-5ce3-aeb0-0954856a3f5d" :question/math-academy-id "q-15710" :question/is-example false :question/problem "What is the antiderivative of $\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{5}{2x}\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{x}\\text{d}x \\\\  & =\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{5}{2x}\\text{d}x & =\\frac{5}{2}ln⁡|x|+\\frac{5}{2}ln⁡K \\\\  & =\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15710/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9"] :knowledge-point/questions ["q-15710"] :db/ensure [:knowledge-point/validate]}]
