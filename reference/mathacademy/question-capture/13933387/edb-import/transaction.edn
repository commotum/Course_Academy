[{:db/id [:question/math-academy-id "q-49097"] :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{1}{9}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{9x} & =\\frac{1}{9}\\int \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{9}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{1}{9}ln⁡|x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-29831/selection/0c8af8641fee3c0a1e69717e9127e5a0da12e93f9aaa103e51d3c687ab3af131" :answer/id #uuid "6da5437b-e68a-51b0-9453-77bd3cdf421b" :answer/type :answer.type/math :answer/value "\\frac{3}{ln⁡x}+C" :db/ensure [:answer/validate]} {:db/id "q-29831/selection/e8dd434483724bfd34335bb0d8a3f364febec57e5e31d5ad6f2d6a47b6eee21a" :answer/id #uuid "0eea302a-8566-5187-a6a1-f379529a75d7" :answer/type :answer.type/math :answer/value "-3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29831/selection/1707372d09690f73892c8d5e783abc12c37ad0210b21328305d6c76c1485e9f2" :answer/id #uuid "4a3c8df5-a39e-5da5-aaaf-060f370e34ce" :answer/type :answer.type/math :answer/value "3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-29831/selection/127ba05a109b3ecfaad64df3b67df919feb0327bf48af347d9ff10fe199ee5d0" :answer/id #uuid "809ed658-06ae-5b7d-b98f-482aba5f0919" :answer/type :answer.type/math :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/ensure [:answer/validate]} {:db/id "q-29831/selection/95290851e8c08c6d12cdcf36352ebc49dfaff784081b12b61d2e6cd54fee6748" :answer/id #uuid "44dd07d0-c099-54ca-ae3f-82625b4d1953" :answer/type :answer.type/math :answer/value "3ln⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-29831/selection" :answer-field/id #uuid "a2ff9178-9b37-5b0e-82a6-4eb83ebf80b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29831/selection/e8dd434483724bfd34335bb0d8a3f364febec57e5e31d5ad6f2d6a47b6eee21a" :answer-field/ch