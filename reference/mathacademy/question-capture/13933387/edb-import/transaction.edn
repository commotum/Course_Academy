o $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-29915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923"] :knowledge-point/questions ["q-29915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103374/selection/0cdc945c412a87276e7b738a7dba0d3cfbd17d7c9e25f5d2f89357db0187b00f" :answer/id #uuid "e692a06a-3574-50ec-8e0f-52edaa5a2430" :answer/type :answer.type/math :answer/value "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-103374/selection/2fb034e87997122934bdd4427567af1699e2a29c82c00985ffdcb5377b523151" :answer/id #uuid "c343fe99-11b8-5762-a043-b77f003cb120" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{x}^{2}-ln⁡|3x|+C" :db/ensure [:answer/validate]} {:db/id "q-103374/selection/8df8c1e7de84bdb31ec5f7de2282b9905236abf64641e0536809eaaf39a678c0" :answer/id #uuid "4970369f-845f-5c95-b39b-048ee1357e1e" :answer/type :answer.type/math :answer/value "3{x}^{2}+ln⁡|3x|+C" :db/ensure [:answer/validate]} {:db/id "q-103374/selection/adfe40c89a7282eb96021498aae61d70072111a55859524d4f51a27b17a5cfb1" :answer/id #uuid "51ac6de7-f1ad-58c2-bc04-4c4e7c72a5c1" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-103374/selection/f99287563f10bd084106030764ac5b4eadb284212d65e4e70288f0bd77310cbc" :answer/id #uuid "a831dc74-f020-5fdf-9569-f8d43e039408" :answer/type :answer.type/math :answer/value "\\frac{3}{4}{x}^{2}-ln⁡|3x|+C" :db/ensure [:answer/validate]} {:db/id "q-103374/selection" :answer-field/id #uuid "641ba6b7-43db-5b88-927d-75d8b29642d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103374/selection/0cdc945c412a87276e7b738a7dba0d3cfbd17d7c9e25f5d2f89357db0187b00f" :answer-field/choices ["q-103374/selection/0cdc945c412a87276e7b738a7dba0d3cfbd17d7c9e25f5d2f89357db0187b00f" "q-103374/selection/2fb034e87997122934bdd4427567af1699e2a29c82c00985ffdcb5377b523151" "q-103374/selection/8df8c1e7de84bdb31ec5f7de2282b9905236abf64641e0536809eaaf39a678c0" "q-103374/selection/adfe40c89a7282eb96021498aae61d70072111a55859524d4f51a27b17a5cfb1" "q-103374/selection/f99287563f10bd084106030764ac5b4eadb284212d65e4e70288f0bd77310cbc"] :db/ensure [:answer-field/validate]} {:db/id "q-103374" :question/id #uuid "4b4a35ed-e580-566f-ae20-c110ba4d2ca3" :question/math-academy-id "q-103374" :question/is-example false :question/problem "Calculate $\\int \\frac{3{x}^{2}-6}{2x}\\,dx.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-6}{2x}\\,\\text{d}x & =\\int (\\frac{3{x}^{2}}{2x}-\\frac{3}{x})\\text{d}x \\\\  & =\\int (\\frac{3}{2}x-\\frac{3}{x})\\text{d}x \\\\  & =\\frac{3}{2}\\int x\\,\\text{d}x-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{4}{x}^{2}-3ln⁡|x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923"] :knowledge-point/questions ["q-103374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49100/selection/932924b59af8802867ba4f6f7f00e11a435cf197f8f4dc7e8e1fffbf228c548c" :answer/id #uuid "0f707d8a-3765-56ea-b5f1-9537f88d7e9a" :answer/type :answer.type/math :answer/value "{(2x-ln⁡|x|)}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-49100/selection/edb8ea65eb889cb617478f86a2dd9d4faf4e4262c4aedb5b84fccb91455d94e7" :answer/id #uuid