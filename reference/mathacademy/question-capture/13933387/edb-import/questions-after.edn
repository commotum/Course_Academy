#{[{:db/id #edb/ref 17592186105496 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/id #uuid "625c532a-d455-5b15-880d-e9fc5ae8ee72" :question/is-example true :question/math-academy-id "e-374" :question/problem "Calculate $\\displaystyle\\int \\left(\\dfrac 2 x\\right)\\, \\textrm{d} x$." :question/worked-solution "First, we apply the constant factor rule and take the coefficient $2$ out of the integral. Then we compute the integral of\n\n$$\n\\dfrac 1 x\n$$\n\nand get\n\n$$\n\\begin{aligned}\n\\int(\\frac{2}{x})dx &= 2\\int\\frac{1}{x}dx \\\\\n&= 2\\ln \\mid x \\mid + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105497 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/id #uuid "9c57c69e-efa2-5e82-992c-53570e61af09" :question/is-example true :question/math-academy-id "e-375" :question/problem "Find the integral of $\\dfrac 1 {2x} + 3x$ with respect to $x$." :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int(\\frac{1}{2x} + 3x)dx &= \\int\\frac{1}{2x}dx + \\int3xdx \\\\\n&= \\frac{1}{2}\\int\\frac{1}{x}dx + 3\\intxdx \\\\\n&= \\frac{1}{2}\\ln \\mid x\\begin{vmatrix}+ 3 \\cdot \\frac{x^{1 + 1}}{1 + 1} + C \\\\ = \\frac{\\ln \\mid x\\end{vmatrix}}{2} + \\frac{3x^{2}}{2} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105498 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/id #uuid "bf47e35e-da86-5f88-b1e7-0cc731c37b31" :question/is-example true :question/math-academy-id "e-376" :question/problem "What is the antiderivative of $\\dfrac {3+2x} {x}$?" :question/worked-solution "We separate the integrand into the sum of two fractions so that we can simplify each term. So, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{3 + 2x}{x}dx &= \\int(\\frac{3}{x} + \\frac{2x}{x})dx \\\\\n&= \\int(\\frac{3}{x} + 2)dx \\\\\n&= 3\\int\\frac{1}{x}dx + 2\\intdx \\\\\n&= 3\\ln \\mid x \\mid + 2x + C\n\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C$, we can always write $C =3 \\ln K$ where $K$ is some other constant. Doing this allows us to combine the constant with $3\\ln \\mid x \\mid$ term, and we get\n\n$$\n\\begin{aligned}\n\\int\\frac{3 + 2x}{x}dx &= 3\\ln\\begin{vmatrix}x & + 2x + C \\\\ = 3\\ln & x\\end{vmatrix}+ 2x + 3\\ln K \\\\\n&= 3\\ln (K \\mid x \\mid) + 2x\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246110 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e692a06a-3574-50ec-8e0f-52edaa5a2430" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" :db/id #edb/ref 17592186246112} {:answer/id #uuid "c343fe99-11b8-5762-a043-b77f003cb120" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}-ln⁡|3x|+C" :db/id #edb/ref 17592186246113} {:answer/id #uuid "4970369f-845f-5c95-b39b-048ee1357e1e" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+ln⁡|3x|+C" :db/id #edb/ref 17592186246114} {:answer/id #uuid "51ac6de7-f1ad-58c2-bc04-4c4e7c72a5c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186246115} {:answer/id #uuid "a831dc74-f020-5fdf-9569-f8d43e039408" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-ln⁡|3x|+C" :db/id #edb/ref 17592186246116}] :answer-field/correct {:answer/id #uuid "e692a06a-3574-50ec-8e0f-52edaa5a2430" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" :db/id #edb/ref 17592186246112} :answer-field/id #uuid "641ba6b7-43db-5b88-927d-75d8b29642d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246111}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b4a35ed-e580-566f-ae20-c110ba4d2ca3" :question/is-example false :question/math-academy-id "q-103374" :question/problem "Calculate $\\int \\frac{3{x}^{2}-6}{2x}\\,dx.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-6}{2x}\\,\\text{d}x & =\\int (\\frac{3{x}^{2}}{2x}-\\frac{3}{x})\\text{d}x \\\\  & =\\int (\\frac{3}{2}x-\\frac{3}{x})\\text{d}x \\\\  & =\\frac{3}{2}\\int x\\,\\text{d}x-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{4}{x}^{2}-3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246117 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9650511f-c6c7-561e-b264-dbb7415ad415" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{3}{2x}+3ln⁡(K|x|)" :db/id #edb/ref 17592186246119} {:answer/id #uuid "ed3cae77-e0a5-5fe0-91ed-6971b20011fe" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{3}{2x}+ln⁡(3K|x|)" :db/id #edb/ref 17592186246120} {:answer/id #uuid "b95522b3-770d-5d83-959c-a8ab20a9467c" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{9}{4x}+3ln⁡(K|x|)" :db/id #edb/ref 17592186246121} {:answer/id #uuid "262f1ae0-7682-54b1-a14b-1e1b29639584" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{9}{4x}+ln⁡(3K|x|)" :db/id #edb/ref 17592186246122} {:answer/id #uuid "1ba8a068-d36f-5b9e-b0a4-f6bd8a68aaf4" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{3}{2x}+3ln⁡(K|x|)" :db/id #edb/ref 17592186246123}] :answer-field/correct {:answer/id #uuid "b95522b3-770d-5d83-959c-a8ab20a9467c" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{9}{4x}+3ln⁡(K|x|)" :db/id #edb/ref 17592186246121} :answer-field/id #uuid "1106a4d3-3ecc-5385-bc8e-05a89af44b71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246118}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "934a8bc5-8b96-5268-9bd1-b570f7ef0ce6" :question/is-example false :question/math-academy-id "q-103375" :question/problem "What is the antiderivative of ${(1+\\frac{3}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{3}{x}+\\frac{9}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+3\\int \\frac{1}{x}\\,\\text{d}x+\\frac{9}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+3ln⁡|x|+\\frac{9{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+3ln⁡|x|-\\frac{9}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=3ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $3ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =x-\\frac{9}{4x}+3ln⁡|x|+3ln⁡K \\\\  & =x-\\frac{9}{4x}+3(ln⁡|x|+ln⁡K) \\\\  & =x-\\frac{9}{4x}+3ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246124 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d312c00c-31ff-553e-a7b5-c9787569ac6d" :answer/type {:db/ident :answer.type/math} :answer/value "10+ln⁡|x|+C" :db/id #edb/ref 17592186246126} {:answer/id #uuid "641e2209-7436-506e-98f8-b55c636194fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡|x|}{10}+C" :db/id #edb/ref 17592186246127} {:answer/id #uuid "79b75330-3b23-5301-99f1-d22b0f667bda" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡|x|+C" :db/id #edb/ref 17592186246128} {:answer/id #uuid "4f9eccd3-37f3-50ab-9dc0-3c5254246c7f" :answer/type {:db/ident :answer.type/math} :answer/value "10ln⁡|x|+C" :db/id #edb/ref 17592186246129} {:answer/id #uuid "2245af43-fb26-5441-810f-44ab1e7eca8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{ln⁡|x|}+C" :db/id #edb/ref 17592186246130}] :answer-field/correct {:answer/id #uuid "4f9eccd3-37f3-50ab-9dc0-3c5254246c7f" :answer/type {:db/ident :answer.type/math} :answer/value "10ln⁡|x|+C" :db/id #edb/ref 17592186246129} :answer-field/id #uuid "b7480d61-2b9a-5128-94cf-27b0bd13ba90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8806f87d-6d6e-5f91-b84c-ba7d59b35f74" :question/is-example false :question/math-academy-id "q-103590" :question/problem "Calculate $\\int \\frac{10}{x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $10$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{10}{x}\\,\\text{d}x & =10\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =10ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246131 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8ffee20-da7a-5122-96fb-f62f80610377" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{ln⁡(K|x|)}" :db/id #edb/ref 17592186246133} {:answer/id #uuid "cc30956b-d428-55b2-886c-f1912aa4f8c2" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(2K|x|)" :db/id #edb/ref 17592186246134} {:answer/id #uuid "474617a8-b059-59b4-b0d4-0b090e35b524" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(\\frac{K|x|}{2})" :db/id #edb/ref 17592186246135} {:answer/id #uuid "12e483e3-188c-5f0f-8818-708e5d2bb117" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡(K|x|)}{2}" :db/id #edb/ref 17592186246136} {:answer/id #uuid "3263f433-bd19-5aee-8725-2933b2272fa3" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(K|x|)" :db/id #edb/ref 17592186246137}] :answer-field/correct {:answer/id #uuid "3263f433-bd19-5aee-8725-2933b2272fa3" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(K|x|)" :db/id #edb/ref 17592186246137} :answer-field/id #uuid "43ce3375-65df-5470-9329-b5db269dae0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246132}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9fe3753b-87a6-5212-beea-3e090a804668" :question/is-example false :question/math-academy-id "q-103603" :question/problem "What is the antiderivative of $2{x}^{-1}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $2$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int 2{x}^{-1}\\,\\text{d}x & =2\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=2ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $2ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int 2{x}^{-1}\\,\\text{d}x & =2ln⁡|x|+2ln⁡K \\\\  & =2(ln⁡|x|+ln⁡K) \\\\  & =2ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246138 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a6d218d-49de-564b-9069-dc03f8bfd57f" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(\\frac{5}{2}K|x|)" :db/id #edb/ref 17592186246140} {:answer/id #uuid "1bd358b3-3148-5a80-9184-d1a5efe6a25a" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(\\frac{5}{2}|x|+K)" :db/id #edb/ref 17592186246141} {:answer/id #uuid "42ea6ec0-8538-51cf-b490-7f715e468784" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186246142} {:answer/id #uuid "94d01489-e7db-54c1-8dac-8300deaf5ab7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(|x|+K)" :db/id #edb/ref 17592186246143} {:answer/id #uuid "697e2cee-d932-53c4-b6fe-3ed8095f715f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186246144}] :answer-field/correct {:answer/id #uuid "42ea6ec0-8538-51cf-b490-7f715e468784" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186246142} :answer-field/id #uuid "ed982b4f-8a5f-595e-b736-9b3a360cb4df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246139}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8d1f204e-6159-5ce3-aeb0-0954856a3f5d" :question/is-example false :question/math-academy-id "q-15710" :question/problem "What is the antiderivative of $\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{5}{2x}\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{x}\\text{d}x \\\\  & =\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{5}{2x}\\text{d}x & =\\frac{5}{2}ln⁡|x|+\\frac{5}{2}ln⁡K \\\\  & =\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246145 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da5437b-e68a-51b0-9453-77bd3cdf421b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{ln⁡x}+C" :db/id #edb/ref 17592186246147} {:answer/id #uuid "809ed658-06ae-5b7d-b98f-482aba5f0919" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/id #edb/ref 17592186246148} {:answer/id #uuid "4a3c8df5-a39e-5da5-aaaf-060f370e34ce" :answer/type {:db/ident :answer.type/math} :answer/value "3ln⁡|x|+C" :db/id #edb/ref 17592186246149} {:answer/id #uuid "44dd07d0-c099-54ca-ae3f-82625b4d1953" :answer/type {:db/ident :answer.type/math} :answer/value "3ln⁡x+C" :db/id #edb/ref 17592186246150} {:answer/id #uuid "0eea302a-8566-5187-a6a1-f379529a75d7" :answer/type {:db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186246151}] :answer-field/correct {:answer/id #uuid "0eea302a-8566-5187-a6a1-f379529a75d7" :answer/type {:db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186246151} :answer-field/id #uuid "a2ff9178-9b37-5b0e-82a6-4eb83ebf80b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246146}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e76c7f5c-03aa-5d2a-b607-e01b6de988cb" :question/is-example false :question/math-academy-id "q-29831" :question/problem "Calculate $\\int -\\frac{3}{x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-3$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{3}{x}\\,\\text{d}x & =-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246152 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeaefb05-1120-5469-8e48-3c3418df10f7" :answer/type {:db/ident :answer.type/math} :answer/value "-ln⁡(\\frac{5}{2}K|x|)" :db/id #edb/ref 17592186246154} {:answer/id #uuid "93b64ef2-d3f6-5f4e-a571-d15cfbaeabd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186246155} {:answer/id #uuid "d8509648-b8b7-5a62-9e44-85b8204bd9b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(|x|+K)" :db/id #edb/ref 17592186246156} {:answer/id #uuid "e7659ebe-d927-537d-8dd0-a3c09cc179c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186246157} {:answer/id #uuid "dbcc41a3-b136-54d6-b54f-3347ccc74910" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186246158}] :answer-field/correct {:answer/id #uuid "dbcc41a3-b136-54d6-b54f-3347ccc74910" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186246158} :answer-field/id #uuid "438eb0be-5b2f-55bc-974a-51df73898ccd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246153}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9bf769c8-5612-5674-8d58-94da7b62284f" :question/is-example false :question/math-academy-id "q-29834" :question/problem "What is the antiderivative of $-\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}ln⁡|x|-\\frac{5}{2}ln⁡K \\\\  & =-\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =-\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246159 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6b4e88c-37c2-5a27-99ed-8fa9d183b04c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186246161} {:answer/id #uuid "e3b79b2a-8d24-52f8-b2d7-ea01767a65e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}{x}^{2/3}-ln⁡|x|+C" :db/id #edb/ref 17592186246162} {:answer/id #uuid "98f266b8-26e3-519b-9fb1-a4a5461c3985" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{x}^{1/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186246163} {:answer/id #uuid "91d3a9a8-2e37-5945-bdaa-b2c4d9f45fb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{7/3}-3ln⁡|x|+C" :db/id #edb/ref 17592186246164} {:answer/id #uuid "953db35b-6987-594f-98bd-74f8ee96a0f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{7/3}-3ln⁡|x|+C" :db/id #edb/ref 17592186246165}] :answer-field/correct {:answer/id #uuid "b6b4e88c-37c2-5a27-99ed-8fa9d183b04c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186246161} :answer-field/id #uuid "84d9de3f-f70c-5706-8626-1ab47a6e49d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246160}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fb57945d-a06b-52d2-81e8-0e6f01bbe072" :question/is-example false :question/math-academy-id "q-29886" :question/problem "Find the integral of $2{x}^{7/3}-\\frac{1}{3x}$ with respect to $x.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (2{x}^{7/3}-\\frac{1}{3x})\\text{d}x & =\\int 2{x}^{7/3}\\,\\text{d}x-\\frac{1}{3}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{7/3+1}}{(\\frac{7}{3}+1)}-\\frac{1}{3}ln⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246166 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a823de7-0965-57df-b2ee-5a35004bf699" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}{x}^{2}+2ln⁡|x|+C" :db/id #edb/ref 17592186246168} {:answer/id #uuid "b821e203-543c-5ae4-b1bb-1ef9fdefc48c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}{x}^{2}+5ln⁡|x|+C" :db/id #edb/ref 17592186246169} {:answer/id #uuid "9c94b488-8667-5bad-8a27-75fe30e06b03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}+4ln⁡|x|+C" :db/id #edb/ref 17592186246170} {:answer/id #uuid "892fb345-663e-5fd3-89bc-8a79e2d1c780" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186246171} {:answer/id #uuid "e338e1f8-f748-5ad0-b086-779bf0376598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186246172}] :answer-field/correct {:answer/id #uuid "e338e1f8-f748-5ad0-b086-779bf0376598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186246172} :answer-field/id #uuid "11324d3d-04de-57a6-b69c-a8f032471f81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246167}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "02e4cdd1-f0b9-55b7-8051-e6a6201200e1" :question/is-example false :question/math-academy-id "q-29888" :question/problem "Find the integral of $\\frac{3}{{x}^{-1}}+3{x}^{-1}$ with respect to $x.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{3}{{x}^{-1}}+3{x}^{-1})\\text{d}x & =3\\int x\\,\\text{d}x+3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{2}{x}^{2}+3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246173 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2ae9acd-859c-5fc9-909b-6600582d18e6" :answer/type {:db/ident :answer.type/math} :answer/value "4ln⁡|x|+C" :db/id #edb/ref 17592186246175} {:answer/id #uuid "ed365905-528f-5327-a3f7-bf2502cb431a" :answer/type {:db/ident :answer.type/math} :answer/value "5x+C" :db/id #edb/ref 17592186246176} {:answer/id #uuid "330bf233-b28a-5885-9184-62e6b62be7e8" :answer/type {:db/ident :answer.type/math} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186246177} {:answer/id #uuid "3097346a-ff7a-5300-b530-4d2c89601a94" :answer/type {:db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186246178} {:answer/id #uuid "2daed363-9939-5fac-9969-d14c0e9abe93" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+C" :db/id #edb/ref 17592186246179}] :answer-field/correct {:answer/id #uuid "3097346a-ff7a-5300-b530-4d2c89601a94" :answer/type {:db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186246178} :answer-field/id #uuid "ccc0cb6a-a18b-545e-a649-74a16ab2952f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246174}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b09abd1d-2f35-514e-b67b-bea8f5c3165e" :question/is-example false :question/math-academy-id "q-29915" :question/problem "Find the integral of $\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1}$ with respect to $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246180 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "743dd1c3-7700-5f2b-a471-d08f674c2509" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{1}{x}+2ln⁡(K|x|)" :db/id #edb/ref 17592186246182} {:answer/id #uuid "458bbd76-bde1-5719-8658-7ec82ebf748b" :answer/type {:db/ident :answer.type/math} :answer/value "x+(1+ln⁡(K|x|))^{2}" :db/id #edb/ref 17592186246183} {:answer/id #uuid "53ad2061-2be1-5740-85ce-4223a41c91f1" :answer/type {:db/ident :answer.type/math} :answer/value "1+2ln⁡(|K|x)" :db/id #edb/ref 17592186246184} {:answer/id #uuid "e6387507-7b6a-53b3-a25c-2c230d5c7448" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{1}{x}+2ln⁡(|K|x)" :db/id #edb/ref 17592186246185} {:answer/id #uuid "288db83c-ee07-58dc-9d12-d4f7af99832a" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{1}{x}+ln⁡(2K|x|)" :db/id #edb/ref 17592186246186}] :answer-field/correct {:answer/id #uuid "743dd1c3-7700-5f2b-a471-d08f674c2509" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{1}{x}+2ln⁡(K|x|)" :db/id #edb/ref 17592186246182} :answer-field/id #uuid "f0613541-d58b-55a7-98ea-5a4e08a846b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246181}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8e532e27-9517-5098-b18d-b59e55e193d6" :question/is-example false :question/math-academy-id "q-49067" :question/problem "What is the antiderivative of ${(1+\\frac{1}{x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{1}{x})}^{2}\\text{d}x & =\\int (1+\\frac{2}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+2\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+2ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =x+2ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=2ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $2ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{1}{x})}^{2}\\text{d}x & =x-\\frac{1}{x}+2ln⁡|x|+2ln⁡K \\\\  & =x-\\frac{1}{x}+2(ln⁡|x|+ln⁡K) \\\\  & =x-\\frac{1}{x}+2ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106295 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6838ccf-3010-550f-8b69-92203b5e5c93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\ln \\mid x \\mid + C" :db/id #edb/ref 17592186104280} {:answer/id #uuid "fbd635a5-cb5f-5860-a9d5-5019c7393431" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (9 - x) + C" :db/id #edb/ref 17592186104281} {:answer/id #uuid "3a793066-35ab-5d95-87aa-360459a36f8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (9 + x) + C" :db/id #edb/ref 17592186104282} {:answer/id #uuid "5fd150d2-2a54-57e0-bd6f-45a4acd35724" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x \\mid + 9x + C" :db/id #edb/ref 17592186104283} {:answer/id #uuid "7e18315d-f492-5c27-ab50-67b054520d0f" :answer/type {:db/ident :answer.type/math} :answer/value "9\\ln \\mid x \\mid + C" :db/id #edb/ref 17592186104284}] :answer-field/correct {:answer/id #uuid "b6838ccf-3010-550f-8b69-92203b5e5c93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\ln \\mid x \\mid + C" :db/id #edb/ref 17592186104280} :answer-field/id #uuid "042c24f1-4bb1-5ca0-98fa-a8a7455b0d3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104279}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0721a79b-46f6-56dc-93df-e0a639013e16" :question/is-example false :question/math-academy-id "q-49097" :question/problem "Calculate $\\displaystyle \\int\\frac{dx}{9x}$." :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{1}{9}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{9x} & =\\frac{1}{9}\\int \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{9}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{1}{9}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246187 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a6d0f14-de35-5233-850a-d81cfdef0dcc" :answer/type {:db/ident :answer.type/math} :answer/value "2x-ln⁡|x|+C" :db/id #edb/ref 17592186246189} {:answer/id #uuid "b930de6e-1301-56cc-91e1-6fa3f5c17484" :answer/type {:db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186246190} {:answer/id #uuid "0f707d8a-3765-56ea-b5f1-9537f88d7e9a" :answer/type {:db/ident :answer.type/math} :answer/value "{(2x-ln⁡|x|)}^{2}+C" :db/id #edb/ref 17592186246191} {:answer/id #uuid "e26355f6-0127-5bf3-8af0-5abee4d64964" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡|2-\\frac{1}{x}|+C" :db/id #edb/ref 17592186246192} {:answer/id #uuid "5d9a3c4b-7dce-5ffc-86c4-0ad24df6126d" :answer/type {:db/ident :answer.type/math} :answer/value "2xln⁡|x|+C" :db/id #edb/ref 17592186246193}] :answer-field/correct {:answer/id #uuid "b930de6e-1301-56cc-91e1-6fa3f5c17484" :answer/type {:db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186246190} :answer-field/id #uuid "6e22a636-1cf8-54b5-89b6-73c805246eac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246188}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5480c40d-25a6-5f69-a7a6-31a121ff8b01" :question/is-example false :question/math-academy-id "q-49100" :question/problem "Find the integral of ${(2-\\frac{1}{x})}^{2}$ with respect to $x.$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(2-\\frac{1}{x})}^{2}\\text{d}x & =\\int (4-\\frac{4}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int 4\\,\\text{d}x-\\int \\frac{4}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4x-4ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =4x-4ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246194 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "481cdfc3-7335-52ff-a88b-e1539a324a8d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186246196} {:answer/id #uuid "41ca9292-c494-5a30-bc90-fdb9ada21374" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡|x|+C" :db/id #edb/ref 17592186246197} {:answer/id #uuid "36160de9-4d15-5a0d-af09-65da46ca5848" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡|x|+C" :db/id #edb/ref 17592186246198} {:answer/id #uuid "d7f2ef08-b7bd-518d-a3a4-f98587cbc38f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186246199} {:answer/id #uuid "a94f5128-53f6-55a0-83f2-ea99abdb278a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡|x|+C" :db/id #edb/ref 17592186246200}] :answer-field/correct {:answer/id #uuid "481cdfc3-7335-52ff-a88b-e1539a324a8d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186246196} :answer-field/id #uuid "9a72eb6e-3579-539d-ae02-cc4f5dd9ba6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246195}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f21ed7ed-f8ca-5e34-a315-eecffdbc56d2" :question/is-example false :question/math-academy-id "q-71098" :question/problem "Calculate $\\int -\\frac{2}{5x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{2}{5}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{2}{5x}\\,\\text{d}x & =-\\frac{2}{5}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{2}{5}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246201 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edb35945-5d40-524f-872a-414d86ef0cfa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186246203} {:answer/id #uuid "923d58e8-478e-58a5-9646-dc3d2089489e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186246204} {:answer/id #uuid "a641f403-b6f4-5974-8c78-009ae6e3bd34" :answer/type {:db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186246205} {:answer/id #uuid "63182f5b-d6c2-52ad-82fd-539f3dae9797" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186246206} {:answer/id #uuid "9f41050b-55f1-50c3-98cc-41db38d61209" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186246207}] :answer-field/correct {:answer/id #uuid "63182f5b-d6c2-52ad-82fd-539f3dae9797" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186246206} :answer-field/id #uuid "2edfaa52-5975-545b-997a-e49553865131" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246202}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "916a0682-0b5c-5b92-95bb-cc12ce858cbe" :question/is-example false :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"}]}
