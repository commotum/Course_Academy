94139533677 true] [17592186246110 1138 false 13194139533677 true] [17592186246110 1145 "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-6}{2x}\\,\\text{d}x & =\\int (\\frac{3{x}^{2}}{2x}-\\frac{3}{x})\\text{d}x \\\\  & =\\int (\\frac{3}{2}x-\\frac{3}{x})\\text{d}x \\\\  & =\\frac{3}{2}\\int x\\,\\text{d}x-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{4}{x}^{2}-3ln⁡|x|+C.\\end{aligned}\n$$" 13194139533677 true] [17592186246111 1000 #edb/ref 17592186246112 13194139533677 true] [17592186246111 1000 #edb/ref 17592186246113 13194139533677 true] [17592186246111 1000 #edb/ref 17592186246114 13194139533677 true] [17592186246111 1000 #edb/ref 17592186246115 13194139533677 true] [17592186246111 1000 #edb/ref 17592186246116 13194139533677 true] [17592186246111 1040 #edb/ref 17592186045450 13194139533677 true] [17592186246111 1041 "selection" 13194139533677 true] [17592186246111 1104 #edb/ref 17592186246112 13194139533677 true] [17592186246111 1110 #uuid "641ba6b7-43db-5b88-927d-75d8b29642d3" 13194139533677 true] [17592186246112 1034 "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" 13194139533677 true] [17592186246112 1103 #edb/ref 17592186045453 13194139533677 true] [17592186246112 1111 #uuid "e692a06a-3574-50ec-8e0f-52edaa5a2430" 13194139533677 true] [17592186246113 1034 "\\frac{3}{2}{x}^{2}-ln⁡|3x|+C" 13194139533677 true] [17592186246113 1103 #edb/ref 17592186045453 13194139533677 true] [17592186246113 1111 #uuid "c343fe99-11b8-5762-a043-b77f003cb120" 13194139533677 true] [17592186246114 1034 "3{x}^{2}+ln⁡|3x|+C" 13194139533677 true] [17592186246114 1103 #edb/ref 17592186045453 13194139533677 true] [17592186246114 1111 #uuid "4970369f-845f-5c95-b39b-048ee1357e1e" 13194139533677 true] [17592186246115 1034 "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" 13194139533677 true] [17592186246115 1103 #edb/ref 17592186045453 13194139533677 true] [17592186246115 1111 #uuid "51ac6de7-f1ad-58c2-bc04-4c4e7c72a5c1" 13194139533677 true] [17592186246116 1034 "\\frac{3}{