/math-academy-id "q-4807" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}+x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}+x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=4(1)+1=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =5(x-1) \\\\ y & =5x-5+3 \\\\ y & =5x-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-4807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-4807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10833/selection/7e559e19ed9eba2edad201b47bf9bb92847d2793624b3aa45a18745473bb10a9" :answer/id #uuid "4f076347-b5af-5d7c-8033-6f5967d80847" :answer/type :answer.type/math :answer/value "y=10x-3" :db/ensure [:answer/validate]} {:db/id "q-10833/selection/17802326c43a082d5e978e811ec70bad2b73002297960c6d7d039ae86ac33832" :answer/id #uuid "fe5f3cc7-7fb4-5400-b5d6-6e095f700407" :answer/type :answer.type/math :answer/value "y=10x-5" :db/ensure [:answer/validate]} {:db/id "q-10833/selection/a501d82eac7d6be7cdb7c78ffefce18054e13937d296cbb97bce49492e1b5e47" :answer/id #uuid "6438a0c5-899d-5ce4-be8b-94fb41b903af" :answer/type :answer.type/math :answer/value "y=5x-3" :db/ensure [:answer/validate]} {:db/id "q-10833/selection/d881b0c1af8296c9652af94ec3ab8cc2533997ff59e83209cf7923dc85741b15" :answer/id #uuid "6800912c-a6dc-558a-b5d0-91ca7112f65e" :answer/type :answer.type/math :answer/value "y=4x-1" :db/ensure [:answer/validate]} {:db/id "q-10833/selection/d6ecfdefffb769b462bb9a308bf60da50bbc017d5811bb70dcb8618ac46a7002" :answer/id #uuid "ad4d35fa-1625-5a31-bf32-7297a167fcfb" :answer/type :answer.type/math :answer/value "y=x-10" :db/ensure [:answer/validate]} {:db/id "q-10833/selection" :answer-field/id #uuid "78a2d98d-3e6a-5f04-bf36-a2f52f1df6be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10833/selection/7e559e19ed9eba2edad201b47bf9bb92847d2793624b3aa45a18745473bb10a9" :answer-field/choices ["q-10833/selection/7e559e19ed9eba2edad201b47bf9bb92847d2793624b3aa45a18745473bb10a9" "q-10833/selection/17802326c43a082d5e978e811ec70bad2b73002297960c6d7d039ae86ac33832" "q-10833/selection/a501d82eac7d6be7cdb7c78ffefce18054e13937d296cbb97bce49492e1b5e47" "q-10833/selection/d881b0c1af8296c9652af94ec3ab8cc2533997ff59e83209cf7923dc85741b15" "q-10833/selection/d6ecfdefffb769b462bb9a308bf60da50bbc017d5811bb70dcb8618ac46a7002"] :db/ensure [:answer-field/validate]} {:db/id "q-10833" :question/id #uuid "43201719-645b-5921-9af0-44bb465cf05a" :question/math-academy-id "q-10833" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y=3{x}^{2}+4x$ at the point $(1,7).$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=6(1)+4=10\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=10$ and the coordinates of our point $(1,7),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(7) & =10(x-1) \\\\ y & =10x-10+7 \\\\ y & =10x-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10833/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-10833"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103325/selection/26dcb49f98c905d3264b6bd0