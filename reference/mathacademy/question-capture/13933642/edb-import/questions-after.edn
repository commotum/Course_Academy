#{[{:db/id #edb/ref 17592186246075 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f30bccbe-d91e-52c3-8e4d-e712a8050424" :answer/type {:db/ident :answer.type/math} :answer/value "(-9,0)" :db/id #edb/ref 17592186246077} {:answer/id #uuid "659a30a7-1065-5632-9923-8e454505aa0f" :answer/type {:db/ident :answer.type/math} :answer/value "(0,6)" :db/id #edb/ref 17592186246078} {:answer/id #uuid "abe28e3c-fa1e-5783-9675-5b4a2fce8704" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,0)" :db/id #edb/ref 17592186246079} {:answer/id #uuid "c1ba1794-6d85-5a81-961b-08f11cd700c1" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186246080} {:answer/id #uuid "ac1bcc98-6e05-5fd9-a290-4c36a8ec5998" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186246081}] :answer-field/correct {:answer/id #uuid "ac1bcc98-6e05-5fd9-a290-4c36a8ec5998" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186246081} :answer-field/id #uuid "9397fc54-1151-5d09-ae19-6f647cf05442" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246076}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "adc2da3d-82d8-5282-9894-c924528467d1" :question/is-example false :question/math-academy-id "q-103325" :question/problem "Find where the tangent to the curve $y=4{x}^{3}-9x-1$ at the point $(1,-6)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=4{x}^{3}-9x-1.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(4{x}^{3}-9x-1)=12{x}^{2}-9\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm={f}^{′}(-1)=12(1)^{2}-9=3.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-6) & =3(x-1) \\\\ y & =3x-3-6 \\\\ y & =3x-9.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =3x-9 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the intersection point is $(3,0).$"}] [{:db/id #edb/ref 17592186246082 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16894b12-8016-54ca-ab59-24359eb0ac4e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186246084} {:answer/id #uuid "b56b3db9-3b08-5e9a-8ae2-9334633190a6" :answer/type {:db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186246085} {:answer/id #uuid "81ef8e88-12ef-5f26-ad9f-6232ea565e9a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186246086} {:answer/id #uuid "21274d73-c7e6-5b19-a31d-07ef6ad7bce1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186246087} {:answer/id #uuid "3a50d0a7-494a-521e-8d82-403fd3700358" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186246088}] :answer-field/correct {:answer/id #uuid "81ef8e88-12ef-5f26-ad9f-6232ea565e9a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186246086} :answer-field/id #uuid "6ffea135-9731-54b8-9a0b-6fe63fc0fc7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246083}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "23e73676-f861-5219-9ebb-4274bb45201f" :question/is-example false :question/math-academy-id "q-103330" :question/problem "Find where the tangent to the curve $y=2{x}^{5}-8x$ at the point $(1,-6)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=2{x}^{5}-8x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{5}-8x)=10{x}^{4}-8\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(1)=10(1)^{4}-8=2.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y+6 & =2(x-1) \\\\ y & =2x-2-6 \\\\ y & =2x-8.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =2(0)-8 \\\\ y & =-8\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,-8).$"}] [{:db/id #edb/ref 17592186246089 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4468690-aef0-58ba-bd1a-11f5fdcdd7d3" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186246091} {:answer/id #uuid "ae21f5c4-322c-5322-bfd4-e2146d243983" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186246092} {:answer/id #uuid "9cef949a-216e-53ee-9af9-b0ad6d748144" :answer/type {:db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186246093} {:answer/id #uuid "9b5f3e0b-415e-5493-8ce4-2f13d2d4e951" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186246094} {:answer/id #uuid "c0086013-72b6-5206-89f0-112a34476876" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186246095}] :answer-field/correct {:answer/id #uuid "e4468690-aef0-58ba-bd1a-11f5fdcdd7d3" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186246091} :answer-field/id #uuid "c77a34ae-3041-55a0-b542-0963f7483402" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246090}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a99d54b3-32e8-5d50-8e14-b10454b82269" :question/is-example false :question/math-academy-id "q-103331" :question/problem "Find where the tangent to the curve $y=\\frac{1}{x}+3$ at the point $(1,4)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=\\frac{1}{x}+3.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}+3)=-\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm={f}^{′}(1)=-\\frac{1}{(1)^{2}}=-1.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-(x-1) \\\\ y & =-x+1+4 \\\\ y & =5-x.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =5-0 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,5).$"}] [{:db/id #edb/ref 17592186246096 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe5f3cc7-7fb4-5400-b5d6-6e095f700407" :answer/type {:db/ident :answer.type/math} :answer/value "y=10x-5" :db/id #edb/ref 17592186246098} {:answer/id #uuid "4f076347-b5af-5d7c-8033-6f5967d80847" :answer/type {:db/ident :answer.type/math} :answer/value "y=10x-3" :db/id #edb/ref 17592186246099} {:answer/id #uuid "6438a0c5-899d-5ce4-be8b-94fb41b903af" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-3" :db/id #edb/ref 17592186246100} {:answer/id #uuid "ad4d35fa-1625-5a31-bf32-7297a167fcfb" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-10" :db/id #edb/ref 17592186246101} {:answer/id #uuid "6800912c-a6dc-558a-b5d0-91ca7112f65e" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186246102}] :answer-field/correct {:answer/id #uuid "4f076347-b5af-5d7c-8033-6f5967d80847" :answer/type {:db/ident :answer.type/math} :answer/value "y=10x-3" :db/id #edb/ref 17592186246099} :answer-field/id #uuid "78a2d98d-3e6a-5f04-bf36-a2f52f1df6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246097}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "43201719-645b-5921-9af0-44bb465cf05a" :question/is-example false :question/math-academy-id "q-10833" :question/problem "Find the equation of the tangent to the curve $y=3{x}^{2}+4x$ at the point $(1,7).$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=6(1)+4=10\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=10$ and the coordinates of our point $(1,7),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(7) & =10(x-1) \\\\ y & =10x-10+7 \\\\ y & =10x-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246103 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e87cece9-03d1-5ec1-b4c8-de3d138bcfa3" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-5" :db/id #edb/ref 17592186246105} {:answer/id #uuid "5c4fed34-6121-5f16-af2f-389e2e9bf282" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-3" :db/id #edb/ref 17592186246106} {:answer/id #uuid "da72774c-66cf-58af-827f-114c91d07aec" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186246107} {:answer/id #uuid "c81dd793-2f03-5512-8a8c-e73acc95ca07" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186246108} {:answer/id #uuid "d8c900fe-be07-5d47-a708-4b28e95a5b5d" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186246109}] :answer-field/correct {:answer/id #uuid "c81dd793-2f03-5512-8a8c-e73acc95ca07" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186246108} :answer-field/id #uuid "cc4a5e63-982d-59ab-a9e5-f692214b1aeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246104}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5dbefefa-920f-558f-b67a-d201b70cb392" :question/is-example false :question/math-academy-id "q-4807" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}+x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}+x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=4(1)+1=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =5(x-1) \\\\ y & =5x-5+3 \\\\ y & =5x-2.\\end{aligned}\n$$"}]}
