[{:db/id "q-136379/selection/e4e36a6ad38075ec02739cf9c39cc68cc39604e1cd64494295514028174fca7a" :answer/id #uuid "375697bb-e1cd-58a8-bdd6-128612fe2c3d" :answer/type :answer.type/math :answer/value "(-i+2j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136379/selection/9b9c2a7f9dc72e342c6a64fd0b0f766fa9879a8c9f0ae6ae419ce358afdee8d0" :answer/id #uuid "d1d24a6f-4136-5ddd-ab66-2521a932d41b" :answer/type :answer.type/math :answer/value "(6i+15j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136379/selection/5c37a2cc89562bae9ae178a6ae5916e5d7adecb3ca8a0d964b6dfa447e9113cd" :answer/id #uuid "e2c7c0f5-bbee-5b10-9beb-c053dc6b02b7" :answer/type :answer.type/math :answer/value "3j\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136379/selection/61cb31572d09f4158d4093e34515ae34682c5c8e25a5574d72d76bd855f05c95" :answer/id #uuid "7707adf1-96b2-52ca-9ee1-3e48596b651c" :answer/type :answer.type/math :answer/value "(5i+8j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136379/selection/9be2e419b2ac4de64eba879465d22dcb4ebe1f231cd824376d495ad191077340" :answer/id #uuid "ab833d1f-0614-5eca-b331-f371ab8009a3" :answer/type :answer.type/math :answer/value "-3i\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136379/selection" :answer-field/id #uuid "6a7832a4-4762-5c0f-a672-3556e5a82f6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136379/selection/9b9c2a7f9dc72e342c6a64fd0b0f766fa9879a8c9f0ae6ae419ce358afdee8d0" :answer-field/choices ["q-136379/selection/e4e36a6ad38075ec02739cf9c39cc68cc39604e1cd64494295514028174fca7a" "q-136379/selection/9b9c2a7f9dc72e342c6a64fd0b0f766fa9879a8c9f0ae6ae419ce358afdee8d0" "q-136379/selection/5c37a2cc89562bae9ae178a6ae5916e5d7adecb3ca8a0d964b6dfa447e9113cd" "q-136379/selection/61cb31572d09f4158d4093e34515ae34682c5c8e25a5574d72d76bd855f05c95" "q-136379/selection/9be2e419b2ac4de64eba879465d22dcb4ebe1f231cd824376d495ad191077340"] :db/ensure [:answer-field/validate]} {:db/id "q-136379" :question/id #uuid "f2e0ff07-fc5d-5fc3-af79-a12180dc0106" :question/math-academy-id "q-136379" :question/problem "A particle moves from the origin with a constant velocity of  $(2i+5j)\\,\\text{cm/s}.$ Find the position vector of the particle after $3$ seconds." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=2i+5j.\n$$\n\nTherefore, the position vector of the particle after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(2i+5j)(3) \\\\  & =(6i+15j)\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136379/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-136379"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136375/selection/bedd67f5afe32a5522869a956f1d14f57182b6f3119fec1b65987cdb5a3e016a" :answer/id #uuid "955d1aa7-330e-5cde-9f50-2e874b909d77" :answer/type :answer.type/math :answer/value "(i-8j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136375/selection/5aa0457660d2e269bd9d8e3791f8b299890d09aef22130de37389a7065604ef9" :answer/id #uuid "c43185c6-59e3-564d-9f23-31497d128211" :answer/type :answer.type/math :answer/value "2i\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136375/selection/fb332ad5392664e18c3a8798f86cdf62cde23996d8cea817d3c15a377e98793e" :answer/id #uuid "a9329fae-ed7b-5911-8b55-ddf2e78423c2" :answer/type :answer.type/math :answer/value "2j\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136375/selection/f0b9663d3eea82db9d93b38d0c147e87210e98a0be63c0fffdd59553def10111" :answer/id #uuid "d8829320-7fbc-56bc-8a7e-720c42582b41" :answer/type :answer.type/math :answer/value "(3i-4j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136375/selection/9bd5eb88c9ba41012638b01e14873ee95ff159f98ab99e15c063ba6a82778982" :answer/id #uuid "85e7156b-ef57-5373-8292-d67345db8b26" :answer/type :answer.type/math :answer/value "(2i+4j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136375/selection" :answer-field/id #uuid "a25069e5-e29e-5424-9441-b52946e5ed61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136375/selection/f0b9663d3eea82db9d93b38d0c147e87210e98a0be63c0fffdd59553def10111" :answer-field/choices ["q-136375/selection/bedd67f5afe32a5522869a956f1d14f57182b6f3119fec1b65987cdb5a3e016a" "q-136375/selection/5aa0457660d2e269bd9d8e3791f8b299890d09aef22130de37389a7065604ef9" "q-136375/selection/fb332ad5392664e18c3a8798f86cdf62cde23996d8cea817d3c15a377e98793e" "q-136375/selection/f0b9663d3eea82db9d93b38d0c147e87210e98a0be63c0fffdd59553def10111" "q-136375/selection/9bd5eb88c9ba41012638b01e14873ee95ff159f98ab99e15c063ba6a82778982"] :db/ensure [:answer-field/validate]} {:db/id "q-136375" :question/id #uuid "afe1f0be-e3c3-5ca8-ae7c-e8a7cf49172c" :question/math-academy-id "q-136375" :question/problem "A particle starts moving from the point with position vector $(i-4j)\\,\\text{km}$ with a constant velocity of $i\\,\\text{km/h}.$ Find the position vector of the particle after $2$ hours." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=i-4j,\\,u=i.\n$$\n\nTherefore, the position vector of the particle after $t=2\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(i-4j)+i(2) \\\\  & =(i-4j)+2i \\\\  & =(3i-4j)\\,\\text{km}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136375/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-136375"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280488/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer/id #uuid "35d68f32-6855-5dd5-8169-f0ef2b45642d" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "q-280488/field-1" :answer-field/id #uuid "0ef721e2-dccc-516b-87d1-653fcad60610" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280488/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer-field/choices ["q-280488/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9"] :db/ensure [:answer-field/validate]} {:db/id "q-280488/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "11d967c7-584a-5f23-bd6c-afcfbc8052b3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-280488/field-2" :answer-field/id #uuid "97c86c19-794a-5a8b-ba4b-cccece8e2f60" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280488/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-280488/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-280488" :question/id #uuid "cb71f3c0-82ad-5bc4-81c4-d96e38b9105c" :question/math-academy-id "q-280488" :question/problem "A particle moves with a constant velocity of $(6i+2j)\\,\\text{cm/s}.$ If its initial position is ${r}_{0}=(3i-5j)\\,\\text{cm},$ find its position vector $r$ after $5$ seconds.\n\n$r=(${{field-1}}  \n$i\\,\\,+$  \n{{field-2}}  \n$j)\\text{cm}$" :question/worked-solution "When a particle (or object) moves with constant velocity $u,$ the position vector at time $t$ is given by the equation\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position vector.\n\nIn this case,\n\n$$\n{r}_{0}=3i-5j,\\,u=6i+2j.\n$$\n\nTherefore, the position vector of the particle after $t=5\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(3i-5j)+(6i+2j)(5) \\\\  & =3i-5j+30i+10j \\\\  & =(\\,33\\,i+5\\,j)\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280488/field-1" "q-280488/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-280488"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280491/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d6db4ceb-dd07-59fa-851a-6c4ba22c6c37" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-280491/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "60d624ca-9a4e-50d7-b652-9d26f9feff91" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-280491/field-1" :answer-field/id #uuid "e6f8ce6c-49fb-5518-a6dd-9033e4001547" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280491/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-280491/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-280491/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-280491/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b0de7ae8-02db-52c7-84c5-aaa713340284" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-280491/field-2" :answer-field/id #uuid "00fb7d77-7f97-5598-82cb-39a142a125fb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280491/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-280491/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-280491" :question/id #uuid "b9ba8e59-9cf8-5def-afd8-4dae30f24f5d" :question/math-academy-id "q-280491" :question/problem "A bird glides with a constant velocity of $(-2i-1j)\\,\\text{yd/s}.$ If it starts at the position ${r}_{0}=(6i+4j)\\,\\text{yd},$ find its position vector $r$ after $3$ seconds.\n\n$r=(${{field-1}}  \n$i\\,\\,+$  \n{{field-2}}  \n$j)\\text{yd}$" :question/worked-solution "When a particle (or object) moves with constant velocity $u,$ the position vector at time $t$ is given by the equation\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position vector.\n\nIn this case,\n\n$$\n{r}_{0}=6i+4j,\\,u=-2i-1j.\n$$\n\nTherefore, the position vector of the bird after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(6i+4j)+(-2i-1j)(3) \\\\  & =6i+4j-6i-3j \\\\  & =(\\,0\\,i+1\\,j)\\,\\text{yd}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280491/field-1" "q-280491/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-280491"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280492/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "dbdd8c89-f4ec-5793-915e-ef0c97a79e60" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-280492/field-1" :answer-field/id #uuid "7ec0b6b9-1323-59c8-8164-ae7ffa8d38bd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280492/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-280492/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-280492/field-2/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "0db0ce9c-6788-57b1-994c-2261c75d22d1" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-280492/field-2" :answer-field/id #uuid "5790369e-5d68-5053-b0c1-c5d14c5f0365" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280492/field-2/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-280492/field-2/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49"] :db/ensure [:answer-field/validate]} {:db/id "q-280492" :question/id #uuid "7079cd9b-c2d6-5c5c-a2d9-8bcbd89f6dad" :question/math-academy-id "q-280492" :question/problem "An autonomous submarine travels with a constant velocity of $(3i+5j)\\,\\text{km/h}.$ If its initial position is ${r}_{0}=(-3i+0j)\\,\\text{km},$ find the position vector $r$ after $3$ hours.\n\n$r=(${{field-1}}  \n$i\\,\\,+$  \n{{field-2}}  \n$j)\\text{km}$" :question/worked-solution "When a particle (or object) moves with constant velocity $u,$ the position vector at time $t$ is given by the equation\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position vector.\n\nIn this case,\n\n$$\n{r}_{0}=-3i+0j,\\,u=3i+5j.\n$$\n\nTherefore, the position vector of the submarine after $t=3\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(-3i+0j)+(3i+5j)(3) \\\\  & =-3i+0j+9i+15j \\\\  & =(\\,6\\,i+15\\,j)\\,\\text{km}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280492/field-1" "q-280492/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-280492"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280513/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "ed489786-a9d6-5b3b-a37f-4960a65a28df" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-280513/field-1" :answer-field/id #uuid "92d293f1-b48a-55b5-8856-9340230cd701" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280513/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-280513/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-280513/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3ba8183b-7f3c-5c3d-a751-a97264f7f1de" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-280513/field-2" :answer-field/id #uuid "acf4ce3f-3785-573b-a60e-6ea11292114a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280513/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-280513/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-280513" :question/id #uuid "2950a2c3-a838-583b-ab8b-2ea8945603d8" :question/math-academy-id "q-280513" :question/problem "A skier begins at the position ${r}_{0}=(-3i+2j)\\,\\text{m}$ with an initial velocity of $(5i-2j)\\,\\text{m/s}$ and accelerates at $(2i+j)\\,{\\text{m/s}}^{2}.$ Determine the position vector after $2$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-3i+2j,\\,u=5i-2j,\\,a=2i+j.\n$$\n\nTherefore, the position vector of the skier after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(-3i+2j)+(5i-2j)(2)+\\frac{1}{2}(2i+j)(2)^{2} \\\\  & =(-3i+2j)+(5i-2j)(2)+\\frac{1}{2}(8i+4j) \\\\  & =(-3i+2j)+(10i-4j)+(4i+2j) \\\\  & =(\\,11\\,i+0\\,j)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280513/field-1" "q-280513/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-280513"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136416/selection/821f237ceda07b835ed7810cb97e40e77b46709cf0add045ce10a48efa47e93a" :answer/id #uuid "41badbec-bece-52e6-ac87-c8c50be5286c" :answer/type :answer.type/math :answer/value "(-7i-14j)\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136416/selection/71cde12d562cbe4f11d049d48c8d8be9adf7fe9c9156f3bab7d86fb8b595196a" :answer/id #uuid "aeb390af-5318-576f-9193-fa7560a8cfdc" :answer/type :answer.type/math :answer/value "14i\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136416/selection/5cb27e43f506244be083eae1824c8bac7a8ec09b7409ff33c291682a11bed106" :answer/id #uuid "2df51e8c-cc9e-545d-aefe-09673c2327e6" :answer/type :answer.type/math :answer/value "(5i-j)\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136416/selection/c5b66fa4e220365fe5c3715d4b6c3042471a2c685feb373409708738789c141f" :answer/id #uuid "893062d6-429d-52ce-b27b-25b17d0ddfd3" :answer/type :answer.type/math :answer/value "-7j\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136416/selection/ff971dbc073999dca56184499a3de64336e64e5f4ec4afb51ba55b81df9eacb9" :answer/id #uuid "252b5abf-0395-5a09-9f93-624057fde26c" :answer/type :answer.type/math :answer/value "(15i+5j)\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136416/selection" :answer-field/id #uuid "ff4f095b-07d9-5f63-aa1b-a9904baa0645" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136416/selection/71cde12d562cbe4f11d049d48c8d8be9adf7fe9c9156f3bab7d86fb8b595196a" :answer-field/choices ["q-136416/selection/821f237ceda07b835ed7810cb97e40e77b46709cf0add045ce10a48efa47e93a" "q-136416/selection/71cde12d562cbe4f11d049d48c8d8be9adf7fe9c9156f3bab7d86fb8b595196a" "q-136416/selection/5cb27e43f506244be083eae1824c8bac7a8ec09b7409ff33c291682a11bed106" "q-136416/selection/c5b66fa4e220365fe5c3715d4b6c3042471a2c685feb373409708738789c141f" "q-136416/selection/ff971dbc073999dca56184499a3de64336e64e5f4ec4afb51ba55b81df9eacb9"] :db/ensure [:answer-field/validate]} {:db/id "q-136416" :question/id #uuid "4eb6abc7-15cc-58dd-b3c7-5a5145bf8306" :question/math-academy-id "q-136416" :question/problem "A particle starts moving from the point with position vector $-2j\\,\\text{ft}$ with an acceleration of $4i\\,{\\text{ft/min}}^{2}$ and an initial velocity of $(3i+j)\\,\\text{ft/min}.$ Find the position vector of the particle after $2$ minutes." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-2j,\\,u=3i+j,\\,a=4i.\n$$\n\nTherefore, the position vector of the particle after $t=2\\,\\text{min}$ is\n\n$$\n\\begin{aligned}r & =(-2j)+(3i+j)(2)+\\frac{1}{2}(4i)(2)^{2} \\\\  & =-2j+(6i+2j)+2(4i) \\\\  & =6i+8i \\\\  & =14i\\,\\text{ft}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136416/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-136416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280504/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "47335ffc-76d6-57eb-9a83-fdf02abfce34" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-280504/field-1" :answer-field/id #uuid "8c65e026-3ed0-5489-8013-e57161dd45a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280504/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-280504/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-280504/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "9037442c-101c-5b1d-902f-85370b318b47" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-280504/field-2" :answer-field/id #uuid "b9d8b0b3-2dfd-5d99-9be8-5f825f686661" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280504/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-280504/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-280504" :question/id #uuid "1051f019-d3c2-55aa-8b3d-d7e882c05820" :question/math-academy-id "q-280504" :question/problem "A particle moves from the origin with an initial velocity of $(6i+8j)\\,\\text{m/s}$ and experiences a constant acceleration of $(-2i-10j)\\,{\\text{m/s}}^{2}.$ Determine the position vector of the ball after $1$ second.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=6i+8j,\\,a=-2i-10j.\n$$\n\nTherefore, the position vector of the particle after $t=1\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(6i+8j)(1)+\\frac{1}{2}(-2i-10j)(1)^{2} \\\\  & =(6i+8j)+\\frac{1}{2}(-2i-10j) \\\\  & =(6i+8j)+(-1i-5j) \\\\  & =(\\,5\\,i+3\\,j)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280504/field-1" "q-280504/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-280504"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280507/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e11a6f89-e45d-55f2-9cf5-3a573e61c6ea" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-280507/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "0ebd4de9-ed98-5cb7-a34a-9e305896dd0c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-280507/field-1" :answer-field/id #uuid "659d0a08-fdac-53a0-9dce-6b38aa942d2d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280507/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-280507/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-280507/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-280507/field-2/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "446e3c86-62fe-567c-9736-ff7fb09fbe10" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "q-280507/field-2" :answer-field/id #uuid "315ad1a6-46bd-5233-af8e-3644e8d1fe8f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280507/field-2/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer-field/choices ["q-280507/field-2/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a"] :db/ensure [:answer-field/validate]} {:db/id "q-280507" :question/id #uuid "ea3a2584-019c-5965-92b5-cae1e20c4ed5" :question/math-academy-id "q-280507" :question/problem "A toy rocket is launched from the origin with an initial velocity of $(2i+6j)\\,\\text{m/s}$ and a constant acceleration of $(i+5j)\\,{\\text{m/s}}^{2}.$ Determine the position vector of the rocket after $2$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=2i+6j,\\,a=i+5j.\n$$\n\nTherefore, the position vector of the rocket after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(2i+6j)(2)+\\frac{1}{2}(i+5j)(2)^{2} \\\\  & =(4i+12j)+2(i+5j) \\\\  & =(4i+12j)+(2i+10j) \\\\  & =(\\,6\\,i+22\\,j)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280507/field-1" "q-280507/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-280507"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186184411 :question/answer-fields 17592186180915] {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/67b85d65cb02de83636f99d7e15ba3d7b2d4f42db2d406bbb0ad6c24f21a9e64" :answer/id #uuid "c826faa3-9ccf-5b37-91b0-f036170396e2" :answer/type :answer.type/math :answer/value "(25i+36j)\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/e4771294de064a6b505c1cd2d74b6344ca0b82f1df259f4b670c0ac17e1740b2" :answer/id #uuid "5678055e-a5fe-5883-9892-528f0e2caaf3" :answer/type :answer.type/math :answer/value "(3i-8j)\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/15033b8ddcffffe14715de73850c12133b18b4cee7ceaa3eaac80956593c2e09" :answer/id #uuid "e4571d5a-445a-5b9e-b93d-210bf8fe49fb" :answer/type :answer.type/math :answer/value "(16i+49j)\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/f9c1cccdd4eddf131fa50c5e66e597992e88587e6a888332ce79865a30d49d12" :answer/id #uuid "5f974428-619f-5125-ba74-0bae2af9a1a9" :answer/type :answer.type/math :answer/value "(9i-64j)\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/056e1acd80391b520377946a5ee761aed28b7f32b592356fc677eef0a30db787" :answer/id #uuid "7d4875e8-5487-5ab7-96a7-0d77e7d194a2" :answer/type :answer.type/math :answer/value "(4i-7j)\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d" :answer-field/id #uuid "27d20681-f8f5-5211-8cd3-9f1bfb441efa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/f9c1cccdd4eddf131fa50c5e66e597992e88587e6a888332ce79865a30d49d12" :answer-field/choices ["q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/67b85d65cb02de83636f99d7e15ba3d7b2d4f42db2d406bbb0ad6c24f21a9e64" "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/e4771294de064a6b505c1cd2d74b6344ca0b82f1df259f4b670c0ac17e1740b2" "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/15033b8ddcffffe14715de73850c12133b18b4cee7ceaa3eaac80956593c2e09" "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/f9c1cccdd4eddf131fa50c5e66e597992e88587e6a888332ce79865a30d49d12" "q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d/056e1acd80391b520377946a5ee761aed28b7f32b592356fc677eef0a30db787"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-136413"] :question/problem "A particle starts moving from the point with position vector $(-i+j)\\,\\text{mm}$ with an acceleration of $(2i-6j)\\,{\\text{mm/min}}^{2}$ and an initial velocity of $(-3i+2j)\\,\\text{mm/min}.$ Find the position vector of the particle after $5$ minutes." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-i+j,\\,u=-3i+2j,\\,a=2i-6j.\n$$\n\nTherefore, the position vector of the particle after $t=5\\,\\text{min}$ is\n\n$$\n\\begin{aligned}r & =(-i+j)+(-3i+2j)(5)+\\frac{1}{2}(2i-6j)(5)^{2} \\\\  & =(-i+j)+(-15i+10j)+25(i-3j) \\\\  & =(-16i+11j)+(25i-75j) \\\\  & =(9i-64j)\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136413/selection/ma-v1/4225a56752ba9cf9b9473dcade893dfec39d63d66cb0465b527c533bb8ac8d2d"] :db/ensure [:question/validate]} {:db/id "q-280526/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "12911a5a-e222-56dc-b1f7-1b1e980b6901" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-280526/field-1" :answer-field/id #uuid "0677a7e7-8aaf-51da-832a-2aa3fbf65e47" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280526/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-280526/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-280526" :question/id #uuid "f61b77d9-5a00-5a3c-a675-ee9a1e23e376" :question/math-academy-id "q-280526" :question/problem "A mail truck departs from the post office at the origin and drives with a constant velocity of $(4i-3j)\\,\\text{mi/h}.$ Determine the distance $(|r|)$ from the truck to the origin after $2$ hours.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{mi}$" :question/worked-solution "If a particle moves with constant velocity $u,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=4i-3j.\n$$\n\nTherefore, the position vector of the truck after $t=2\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(4i-3j)(2) \\\\  & =(8i-6j)\\,\\text{mi}.\\end{aligned}\n$$\n\nFinally, the distance from the truck to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|8i-6j| \\\\  & =\\sqrt{{8}^{2}+(-6)^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =\\sqrt{100} \\\\  & =10\\,\\text{mi}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280526/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280526"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280531/field-1/ffac77d44650946d80cd36c20b47bf8adbe3a4883bae818b238194dbe80724ca" :answer/id #uuid "76eebddb-3d5f-5409-b754-79172fe50441" :answer/type :answer.type/math :answer/value "32\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-280531/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "65000e70-f9cc-5587-8d3d-34588f51716a" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-280531/field-1" :answer-field/id #uuid "c555a797-9f97-5397-8b50-54d365a7a1e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280531/field-1/ffac77d44650946d80cd36c20b47bf8adbe3a4883bae818b238194dbe80724ca" :answer-field/choices ["q-280531/field-1/ffac77d44650946d80cd36c20b47bf8adbe3a4883bae818b238194dbe80724ca" "q-280531/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8"] :db/ensure [:answer-field/validate]} {:db/id "q-280531" :question/id #uuid "f056a195-eb0d-534f-b5c8-1e1d2056a427" :question/math-academy-id "q-280531" :question/problem "A car accelerates from rest at the origin with an acceleration of $(3i-4j)\\,{\\text{m/s}}^{2}$ and an initial velocity of $2i\\,\\text{m/s}.$ Find the distance from the car to the origin$(|r|)$ after $4$ seconds.\n\n$\\,|r|=$ \n{{field-1}}\n$\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=2i,\\,a=3i-4j.\n$$\n\nTherefore, the position vector of the car after $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(2i)(4)+\\frac{1}{2}(3i-4j)(4)^{2} \\\\  & =8i+8(3i-4j) \\\\  & =8i+24i-32j \\\\  & =(32i-32j)\\,\\text{m}.\\end{aligned}\n$$\n\nFinally, the distance from the car to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|32i-32j| \\\\  & =\\sqrt{(32)^{2}+(-32)^{2}} \\\\  & =\\sqrt{1024+1024} \\\\  & =\\sqrt{2048} \\\\  & =32\\sqrt{2}\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280531/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280531"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280535/field-1/c961310a3bc781950858cd88cfba7959d0d487b62af56e846c2cdeea9c7b843b" :answer/id #uuid "cd641dd4-97a3-5c4b-bde4-de798a18e5a5" :answer/type :answer.type/math :answer/value "5\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-280535/field-1" :answer-field/id #uuid "9fa755fc-69d3-5109-bb16-c586e912820a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280535/field-1/c961310a3bc781950858cd88cfba7959d0d487b62af56e846c2cdeea9c7b843b" :answer-field/choices ["q-280535/field-1/c961310a3bc781950858cd88cfba7959d0d487b62af56e846c2cdeea9c7b843b"] :db/ensure [:answer-field/validate]} {:db/id "q-280535" :question/id #uuid "fd7864c9-0a89-5e68-91c2-2e2a463a3294" :question/math-academy-id "q-280535" :question/problem "A cyclist begins at the position $(2i-j)\\,\\text{m}$ with an initial velocity of $(3i+j)\\,\\text{m/s}$ and an acceleration of $(i+2j)\\,{\\text{m/s}}^{2}.$ Find the distance from the cyclist to the origin $(|r|)$ after $2$ seconds.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=2i-j,\\,u=3i+j,\\,a=i+2j.\n$$\n\nTherefore, the position vector of the cyclist after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(2i-j)+(3i+j)(2)+\\frac{1}{2}(i+2j)(2)^{2} \\\\  & =(2i-j)+(6i+2j)+2(i+2j) \\\\  & =(2i-j)+(6i+2j)+(2i+4j) \\\\  & =(10i+5j)\\,\\text{m}.\\end{aligned}\n$$\n\nFinally, the distance from the cyclist to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|10i+5j| \\\\  & =\\sqrt{{10}^{2}+{5}^{2}} \\\\  & =\\sqrt{100+25} \\\\  & =\\sqrt{125} \\\\  & =5\\sqrt{5}\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280535/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/que