orname{sin}⁡x\\operatorname{cos}⁡{180}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{180}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-1)-\\operatorname{cos}⁡x\\cdot (0) \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141278/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4"] :knowledge-point/questions ["q-141278"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332173/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "5060120e-9d30-57d2-a8a4-de6b67b5238c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332173/field-1" :answer-field/id #uuid "07bf55e3-16fc-5f9d-9fcf-e054aa7d9634" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332173/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-332173/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8"] :db/ensure [:answer-field/validate]} {:db/id "q-332173/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "8520e49d-65d5-5f8e-9fee-3e045cc61f42" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332173/field-2" :answer-field/id #uuid "663bf817-30d8-59e9-995a-d3a43f56530e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332173/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-332173/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-332173" :question/id #uuid "f053e95d-a0f8-5e87-a819-e853586b5592" :question/math-academy-id "q-332173" :question/problem "Express $\\operatorname{sin}⁡(x+{330}^{∘})$ in terms of