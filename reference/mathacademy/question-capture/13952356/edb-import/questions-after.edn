#{[{:db/id #edb/ref 17592186265915 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b7a541c-21c2-5e8a-b9b4-8143079d2e27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186265917} {:answer/id #uuid "a3267bbd-dbf1-5b95-94f5-da95d418d116" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265918} {:answer/id #uuid "da8feaee-d3c3-5bea-a1d7-31d1bab4634e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265919} {:answer/id #uuid "e2727fe8-71a3-55bd-b8f9-0e52259d4f7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186265920} {:answer/id #uuid "27e31be2-b6d1-5003-9329-3958db18a34b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265921}] :answer-field/correct {:answer/id #uuid "27e31be2-b6d1-5003-9329-3958db18a34b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265921} :answer-field/id #uuid "c5a4de8e-a6be-5d1d-b1e7-811c4abc576c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265916}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1a27c25-0f54-5bc8-aea5-490a48d036b1" :question/math-academy-id "q-141271" :question/problem "$\\operatorname{sin}⁡(x+{150}^{∘})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+{150}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{150}^{∘}+\\operatorname{cos}⁡x\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2}+\\frac{\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265922 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eefc292d-7e35-5d90-bbc5-b5c162920c60" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265924} {:answer/id #uuid "2cf639df-a1aa-5162-a473-7bb704592441" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186265925} {:answer/id #uuid "badf7d31-4008-5aba-a22d-825c2aeaf831" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265926} {:answer/id #uuid "d26bab37-b21b-5bc0-a7a1-4dd78ef5d9b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265927} {:answer/id #uuid "f50ea491-a30a-5ac3-8361-5a71567bc25e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186265928}] :answer-field/correct {:answer/id #uuid "2cf639df-a1aa-5162-a473-7bb704592441" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186265925} :answer-field/id #uuid "420d15a4-e7bd-51b5-81ff-d28180bfdff2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265923}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "09af6a92-47b8-5347-a45d-a716bfb2794b" :question/math-academy-id "q-141278" :question/problem "$\\operatorname{sin}⁡(x-{180}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={180}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{180}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{180}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{180}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-1)-\\operatorname{cos}⁡x\\cdot (0) \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265929 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5060120e-9d30-57d2-a8a4-de6b67b5238c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265931}] :answer-field/correct {:answer/id #uuid "5060120e-9d30-57d2-a8a4-de6b67b5238c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265931} :answer-field/id #uuid "07bf55e3-16fc-5f9d-9fcf-e054aa7d9634" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265930} {:answer-field/choices [{:answer/id #uuid "8520e49d-65d5-5f8e-9fee-3e045cc61f42" :answer/type {:db/ident :answer.type/math} :answer/value "\\fra