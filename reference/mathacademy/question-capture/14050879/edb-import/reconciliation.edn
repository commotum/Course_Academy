^{3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{3x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(3{e}^{3x})\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{3x}(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(3{e}^{3x})\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & =-{e}^{3x}\\operatorname{cos}⁡x+3J \\\\ I & =-{e}^{3x}\\operatorname{cos}⁡x+3({e}^{3x}\\operatorname{sin}⁡x-3I) \\\\ I & =-{e}^{3x}\\operatorname{cos}⁡x+3{e}^{3x}\\operatorname{sin}⁡x-9I \\\\ 10I & ={e}^{3x}(3\\operatorname{sin}⁡x-\\operatorname{cos}⁡x) \\\\ I & =\\frac{{e}^{3x}}{10}(3\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }{e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x & =(\\frac{{e}^{3x}}{10}(3\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)){|}_{0}^{\\pi } \\\\  & =\\frac{{e}^{3\\pi }}{10}(3\\operatorname{sin}⁡(\\pi )-\\operatorname{cos}⁡(\\pi ))-\\frac{{e}^{3(0)}}{10}(3\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0)) \\\\  & =\\frac{{e}^{3\\pi }}{10}+\\frac{1}{10} \\\\  & =\\frac{1}{10}({e}^{3\\pi }+1)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14050879/state.json" "file_sha256" "874fe499780830018c708f2824d31e0038879f10565d701af8b059efa6657e2f"} {"question" "q-83013" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14050879/activity-metadata.json" "file_sha256" "7d51f9ac6e40cd86e174554bbafa9211337125098e606e5510a0bcb7968fe6bb"} {"question" "q-83013" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14050879/state.json" "file_sha256" "874fe499780830018c708f2824d31e0038879f10565d701af8b059efa6657e2f"} {"question" "q-83013" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3{e}^{3\\pi }-10"] ["math" "5{e}^{3\\pi }+1"] ["math" "\\frac{1}{10}({e}^{3\\pi }+1)"] ["math" "\\frac{1}{5}({e}^{3\\pi }-1)"] ["math" "\\frac{1}{8}(3{e}^{3\\pi }+1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14050879/state.json" "file_sha256" "874fe499780830018c708f2824d31e0038879f10565d701af8b059efa6657e2f"} {"question" "q-83013" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{10}({e}^{3\\pi }+1)"] "categor