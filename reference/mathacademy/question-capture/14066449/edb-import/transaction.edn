[{:db/id "q-9644/selection/9630bc22d50034bb8ba42362fefbb296f930a7be4d970c9d5720ffe22989f3a5" :answer/id #uuid "bf3b35d3-23e6-5481-83f3-e3465349abb6" :answer/type :answer.type/math :answer/value "\\frac{1}{6}({e}^{12\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-9644/selection/3934658e8f128cfccb2bfc54bb3ed1a004e5a65a8c0354f15ab94f57e92f472e" :answer/id #uuid "00c09be5-c55a-55ef-9168-3210a56e9c24" :answer/type :answer.type/math :answer/value "\\frac{1}{12}({e}^{3\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-9644/selection/0ad1b58dd7e03d82b14b307db20e38406f5e1971afae61f836060939d32210d8" :answer/id #uuid "747181ed-7008-5992-8c92-67e52b5db591" :answer/type :answer.type/math :answer/value "\\frac{1}{12}({e}^{12\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-9644/selection/9d402bf081a888cfff86ef6cc43c21fd87d9644da531811f604d975bf6019fb1" :answer/id #uuid "3c1804a1-4ee1-5f06-aed1-5824b3177eac" :answer/type :answer.type/math :answer/value "\\frac{1}{12}({e}^{6\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-9644/selection/c78d5c17d65a35435af39967a6ce8238ddf57a8cf19f190289cd9fef55ea534f" :answer/id #uuid "5f183087-2703-582f-8b2e-02436ea61959" :answer/type :answer.type/math :answer/value "\\frac{1}{3}({e}^{6\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-9644/selection" :answer-field/id #uuid "41c28f86-514e-5385-b143-2a5efbc8f4c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9644/selection/0ad1b58dd7e03d82b14b307db20e38406f5e1971afae61f836060939d32210d8" :answer-field/choices ["q-9644/selection/9630bc22d50034bb8ba42362fefbb296f930a7be4d970c9d5720ffe22989f3a5" "q-9644/selection/3934658e8f128cfccb2bfc54bb3ed1a004e5a65a8c0354f15ab94f57e92f472e" "q-9644/selection/0ad1b58dd7e03d82b14b307db20e38406f5e1971afae61f836060939d32210d8" "q-9644/selection/9d402bf081a888cfff86ef6cc43c21fd87d9644da531811f604d975bf6019fb1" "q-9644/selection/c78d5c17d65a35435af39967a6ce8238ddf57a8cf19f190289cd9fef55ea534f"] :db/ensure [:answer-field/validate]} {:db/id "q-9644" :question/id #uuid "93cb24b1-b10c-5796-b7cc-8806cf2b6361" :question/math-academy-id "q-9644" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066449/assets/c06da8f06e8d640c23dbd81885fdd1bd5e5d89b15b1729cacd82ac52f301e44d.png)\n\nFind the area bounded by the polar curve $r={e}^{3\\theta }$ for $0\\le \\theta \\le 2\\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )={e}^{3\\theta }$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=2\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }{({e}^{3\\theta })}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{2\\pi }{e}^{6\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{6}{e}^{6\\theta }{|}_{0}^{2\\pi } \\\\  & =\\frac{1}{12}({e}^{12\\pi }-{e}^{0}) \\\\  & =\\frac{1}{12}({e}^{12\\pi }-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9644/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908"] :knowledge-point/questions ["q-9644"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124201/selection/dcde2f4649e9aaf15bb67a81218ea5ffc93a4a0155240334288b0330aa4ef6f8" :answer/id #uuid "937f2ac1-a028-573e-9163-06b1273a8b5d" :answer/type :answer.type/math :answer/value "\\frac{1}{4}e({e}^{2\\pi }-2)" :db/ensure [:answer/validate]} {:db/id "q-124201/selection/bcfa8d27c2ea310be9f6d17149962c752edd029d312ecaf6538c050792de4123" :answer/id #uuid "aa197dde-407f-574e-924b-33956b65b419" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{e}^{2}({e}^{\\pi +2}-1)" :db/ensure [:answer/validate]} {:db/id "q-124201/selection/2a40adcbfcb8f4808ee2fd376419f963974b5653dddc458a707cb3a68ae0c68c" :answer/id #uuid "f83c7790-887b-57a0-81e7-6af7942f0899" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{e}^{2}({e}^{2\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-124201/selection/d5eabc3c24d4639e0dff6f71ee5a43484eedda953426627c12de416992909988" :answer/id #uuid "54f6598b-b2aa-582e-8896-08a792c3f944" :answer/type :answer.type/math :answer/value "\\frac{1}{4}({e}^{2\\pi }-2)" :db/ensure [:answer/validate]} {:db/id "q-124201/selection/b8522f4a1d56268d54968dc15c3bee8a2161dd2bcdfa8a37074bc3ef62870661" :answer/id #uuid "56815344-b62b-567c-910f-48ab683aa32f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{e}^{2}({e}^{2\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "q-124201/selection" :answer-field/id #uuid "40d96a68-326a-5687-92ff-5b39e23c9ca1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124201/selection/2a40adcbfcb8f4808ee2fd376419f963974b5653dddc458a707cb3a68ae0c68c" :answer-field/choices ["q-124201/selection/dcde2f4649e9aaf15bb67a81218ea5ffc93a4a0155240334288b0330aa4ef6f8" "q-124201/selection/bcfa8d27c2ea310be9f6d17149962c752edd029d312ecaf6538c050792de4123" "q-124201/selection/2a40adcbfcb8f4808ee2fd376419f963974b5653dddc458a707cb3a68ae0c68c" "q-124201/selection/d5eabc3c24d4639e0dff6f71ee5a43484eedda953426627c12de416992909988" "q-124201/selection/b8522f4a1d56268d54968dc15c3bee8a2161dd2bcdfa8a37074bc3ef62870661"] :db/ensure [:answer-field/validate]} {:db/id "q-124201" :question/id #uuid "59508ede-59ec-5a29-a86b-5edd92b2e87c" :question/math-academy-id "q-124201" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066449/assets/34f6562d5a661d3a58755622571f50752aefa11c8e58b85dad5c70b13c179746.png)\n\nFind the area bounded by the polar curve $r={e}^{\\theta +1}$ for $0\\le \\theta \\le \\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )={e}^{\\theta +1}$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }{({e}^{\\theta +1})}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }{e}^{2\\theta +2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{2}{e}^{2\\theta +2}{|}_{0}^{\\pi } \\\\  & =\\frac{1}{4}({e}^{2\\pi +2}-{e}^{2}) \\\\  & =\\frac{1}{4}{e}^{2}({e}^{2\\pi }-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124201/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908"] :knowledge-point/questions ["q-124201"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352316/field-1/d06bf1a71801b8389637941eda5cc11bc5b0c84c488f3f7b2fb6d49b17b36965" :answer/id #uuid "bcc3e987-d617-5854-9594-d29d3081c005" :answer/type :answer.type/math :answer/value "\\frac{9\\pi}{2}-1" :db/ensure [:answer/validate]} {:db/id "q-352316/field-1" :answer-field/id #uuid "c26c963c-a5fe-5ab8-8e75-4faec0ff94ee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352316/field-1/d06bf1a71801b8389637941eda5cc11bc5b0c84c488f3f7b2fb6d49b17b36965" :answer-field/choices ["q-352316/field-1/d06bf1a71801b8389637941eda5cc11bc5b0c84c488f3f7b2fb6d49b17b36965"] :db/ensure [:answer-field/validate]} {:db/id "q-352316" :question/id #uuid "047839b2-457f-5b69-a8fd-3f1c219dc2ed" :question/math-academy-id "q-352316" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066449/assets/09b9f122e75f9d04d4bade197e57a319bc058b0ec22bcf3e35a9feab080c9f1c.png)\n\nFind the area $A$ bounded by the polar curve $r=4-2\\operatorname{sin}⁡\\theta $ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=4-2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{4}$ and ${\\theta }_{2}=\\frac{\\pi }{4}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(4-2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(16-16\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(16-16\\operatorname{sin}⁡\\theta +2(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(18\\theta +16\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(18\\theta \\,{|}_{-\\pi /4}^{\\pi /4}+16\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /4}^{\\pi /4}-\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /4}^{\\pi /4}) \\\\  & =9\\theta \\,{|}_{-\\pi /4}^{\\pi /4}+8\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /4}^{\\pi /4}-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /4}^{\\pi /4} \\\\  & =9(\\frac{\\pi }{4}+\\frac{\\pi }{4})+8(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(-\\frac{\\pi }{4}))-\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{9\\pi }{2}+8(0)-\\frac{1}{2}(2) \\\\  & =\\frac{9\\pi }{2}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352316/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-352316"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352332/field-1/6c54703629ed7e9d0ca329f71fdd061855e946eaf6f2ca6a51c18acf108e8e16" :answer/id #uuid "dc2c1a6a-5cb1-5a28-bb10-20b024d9fb20" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{8}+\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-352332/field-1/d83b321f48f04d3d6f697155f268d59f248c3c0475a4d179abe854aac40c134b" :answer/id #uuid "39b4d72e-9b0a-5410-b9a8-4506685dc609" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{8}-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-352332/field-1" :answer-field/id #uuid "61ea8472-7387-5109-9a6b-a10b07c1fdf6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352332/field-1/6c54703629ed7e9d0ca329f71fdd061855e946eaf6f2ca6a51c18acf108e8e16" :answer-field/choices ["q-352332/field-1/6c54703629ed7e9d0ca329f71fdd061855e946eaf6f2ca6a51c18acf108e8e16" "q-352332/field-1/d83b321f48f04d3d6f697155f268d59f248c3c0475a4d179abe854aac40c134b"] :db/ensure [:answer-field/validate]} {:db/id "q-352332" :question/id #uuid "d74913ef-d7ae-52c3-80e8-d365bdee5c7f" :question/math-academy-id "q-352332" :question/problem "Find the area $A$ bounded by the polar curve $r=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{4}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}({sin}^{2}⁡\\theta +2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(1+2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(1+\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta -\\frac{\\operatorname{cos}⁡(2\\theta )}{2}){|}_{0}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}) \\\\  & =\\frac{\\pi +2}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352332/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908"] :knowledge-point/questions ["q-352332"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352344/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" :answer/id #uuid "59b1d348-fd30-5874-9c8b-25dd39dd6b61" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-352344/field-1" :answer-field/id #uuid "a421642e-e57d-5c70-b34a-d0abba2fc4a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352344/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" :answer-field/choices ["q-352344/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c"] :db/ensure [:answer-field/validate]} {:db/id "q-352344" :question/id #uuid "f7cf59f2-80a3-547c-b1e9-a0a0bcccee5e" :question/math-academy-id "q-352344" :question/problem "Find the area $A$ bounded by the polar curve $r=1+\\operatorname{sin}⁡\\theta $ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1+\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+2\\operatorname{sin}⁡\\theta +\\frac{1}{2}(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\frac{3}{2}+2\\operatorname{sin}⁡\\theta -\\frac{1}{2}\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta -2\\operatorname{cos}⁡\\theta -\\frac{\\operatorname{sin}⁡(2\\theta )}{4}){|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-2\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{-\\pi /2}^{\\pi /2}\\,) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{3}{4}(\\frac{\\pi }{2}+\\frac{\\pi }{2})-(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(-\\frac{\\pi }{2}))-\\frac{1}{8}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )) \\\\  & =\\frac{3\\pi }{4}-(0-0)-0 \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352344/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-352344"] :db/ensure [:knowledge-point/validate]}]
