name{sin}⁡\\theta $ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4},$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535503 true] [17592186352470 1113 #uuid "047839b2-457f-5b69-a8fd-3f1c219dc2ed" 13194139535503 true] [17592186352470 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=4-2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{4}$ and ${\\theta }_{2}=\\frac{\\pi }{4}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(4-2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(16-16\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(16-16\\operatorname{sin}⁡\\theta +2(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(18\\theta +16\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(18\\theta \\,{|}_{-\\pi /4}^{\\pi /4}+16\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /4}^{\\pi /4}-\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /4}^{\\pi /4}) \\\\  & =9\\theta \\,{|}_{-\\pi /4}^{\\pi /4}+8\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /4}^{\\pi /4}-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /4}^{\\pi /4} \\\\  & =9(\\frac{\\pi }{4}+\\frac{\\pi }{4})+8(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(-\\frac{\\pi }{4}))-\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{9\\pi }{2}+8(0)-\\frac{1}{2}(2) \\\\  & =\\frac{9\\pi }{2}-1.\\end{aligned}\n$$" 13194139535503 true] [17592186352471 1000 #edb/ref 17592186352472 13194139535503 true] [17592186352471 1040 #edb/ref 17592186045449 13194139535503 true] [17592186352471 1041 "field-1" 13194139535503 true] [17592186352471 1104 #edb/ref 17592186352472 13194139535503 true] [17592186352471 1110 #uuid "c26c963c-a5fe-5ab8-8e75-4faec0ff94ee" 13194139535503 true] [17592186352472 1034 "\\frac{9\\pi}{2}-1" 13194139535503 true] [17592186352472 1103 #edb/ref 17592186045453 13194139535503 true] [17592186352472 1111 #uuid "bcc3e987-d617-5854-9594-d29d3081c005" 13194139535503 true] [17592186352473 1017 #edb/ref 17592186352474 13194139535503 true] [17592186352473 1089 "q-352332" 13194139535503 true] [17592186352473 1091 #edb/ref 17592186045465 13194139535503 true] [17592186352473 1100 "Find the area $A$ bounded by the polar curve $r=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535503 true] [17592186352473 1113 #uuid "d74913ef-d7ae-52c3-80e8-d365bdee5c7f" 13194139535503 true] [17592186352473 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\frac{\\pi }{4}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}({sin}^{2}⁡\\theta +2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(1+2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}(1+\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta -\\frac{\\operatorname{cos}⁡(2\\theta )}{2}){|}_{0}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}) \\\\  & =\\frac{\\pi +2}{8}.\\end{aligned}\n$$" 13194139535503 true] [17592186352474 1000 #edb/ref 17592186352475 13194139535503 true] [17592186352474 1000 #edb/ref 17592186352476 13194139535503 true] [17592186352474 1040 #edb/ref 17592186045449 13194139535503 true] [17592186352474 1041 "field-1" 13194139535503 true] [17592186352474 1104 #edb/ref 17592186352475 13194139535503 true] [17592186352474 1110 #uuid "61ea8472-7387-5109-9a6b-a10b07c1fdf6" 13194139535503 true] [17592186352475 1034 "\\frac{\\pi}{8}+\\frac{1}{4}" 13194139535503 true] [17592186352475 1103 #edb/ref 17592186045453 13194139535503 true] [17592186352475 1111 #uuid "dc2c1a6a-5cb1-5a28-bb10-20b024d9fb20" 13194139535503 true] [17592186352476 1034 "\\frac{\\pi}{8}-\\frac{1}{4}" 13194139535503 true] [17592186352476 1103 #edb/ref 17592186045453 13194139535503 true] [17592186352476 1111 #uuid "39b4d72e-9b0a-5410-b9a8-4506685dc609" 13194139535503 true] [17592186352477 1017 #edb/ref 17592186352478 13194139535503 true] [17592186352477 1089 "q-352344" 13194139535503 true] [17592186352477 1091 #edb/ref 17592186045465 13194139535503 true] [17592186352477 1100 "Find the area $A$ bounded by the polar curve $r=1+\\operatorname{sin}⁡\\theta $ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535503 true] [17592186352477 1113 #uuid "f7cf59f2-80a3-547c-b1e9-a0a0bcccee5e" 13194139535503 true] [17592186352477 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1+\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{2}$ and ${\\theta }_{2}=\\frac{\\pi }{2}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(1+2\\operatorname{sin}⁡\\theta +\\frac{1}{2}(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\frac{3}{2}+2\\operatorname{sin}⁡\\theta -\\frac{1}{2}\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta -2\\operatorname{cos}⁡\\theta -\\frac{\\operatorname{sin}⁡(2\\theta )}{4}){|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-2\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{-\\pi /2}^{\\pi /2}\\,) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /2}^{\\pi /2}-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{3}{4}(\\frac{\\pi }{2}+\\frac{\\pi }{2})-(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(-\\frac{\\pi }{2}))-\\frac{1}{8}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )) \\\\  & =\\frac{3\\pi }{4}-(0-0)-0 \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" 13194139535503 true] [17592186352478 1000 #edb/ref 17592186352479 13194139535503 true] [17592186352478 1040 #edb/ref 17592186045449 13194139535503 true] [17592186352478 1041 "field-1" 13194139535503 true] [17592186352478 1104 #edb/ref 17592186352479 13194139535503 true] [17592186352478 1110 #uuid "a421642e-e57d-5c70-b34a-d0abba2fc4a2" 13194139535503 true] [17592186352479 1034 "\\frac{3\\pi}{4}" 13194139535503 true] [17592186352479 1103 #edb/ref 17592186045453 13194139535503 true] [17592186352479 1111 #uuid "59b1d348-fd30-5874-9c8b-25dd39dd6b61" 13194139535503 true] [17592186352480 1017 #edb/ref 17592186352481 13194139535503 true] [17592186352480 1089 "q-9644" 13194139535503 true] [17592186352480 1091 #edb/ref 17592186045465 13194139535503 true] [175921863524