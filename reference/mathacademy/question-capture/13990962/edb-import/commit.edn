\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{2}+9) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =4y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{4y}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =\\frac{1}{4{f}^{-1}(x)} \\\\ {({f}^{-1})}^{′}(x) & =\\frac{1}{4{f}^{-1}(x)}.\\end{aligned}\n$$" 13194139534341 true] [17592186283761 1000 #edb/ref 17592186283762 13194139534341 true] [17592186283761 1000 #edb/ref 17592186283763 13194139534341 true] [17592186283761 1000 #edb/ref 17592186283764 13194139534341 true] [17592186283761 1000 #edb/ref 17592186283765 13194139534341 true] [17592186283761 1000 #edb/ref 17592186283766 13194139534341 true] [17592186283761 1040 #edb/ref 17592186045450 13194139534341 true] [17592186283761 1041 "selection" 13194139534341 true] [17592186283761 1104 #edb/ref 17592186283765 13194139534341 true] [17592186283761 1110 #uuid "a4aceb8e-29ac-5dac-88ed-3048ee820a5f" 13194139534341 true] [17592186283762 1034 "4{f}^{-1}(x)" 13194139534341 true] [17592186283762 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283762 1111 #uuid "6aea41ae-407f-5ea2-a1d0-7fd2faa360fc" 13194139534341 true] [17592186283763 1034 "\\frac{{f}^{-1}(x)}{4}" 13194139534341 true] [17592186283763 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283763 1111 #uuid "2823ab8a-a6b5-5f48-9d2a-109a82e800a1" 13194139534341 true] [17592186283764 1034 "\\frac{4}{{f}^{-1}(x)}" 13194139534341 true] [17592186283764 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283764 1111 #uuid "42115277-45df-5ed3-a939-9e1c8adda727" 13194139534341 true] [17592186283765 1034 "\\frac{1}{4{f}^{-1}(x)}" 13194139534341 true] [17592186283765 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283765 1111 #uuid "4ae0c894-812c-56ab-8eb1-2ee377463d68" 13194139534341 true] [17592186283766 1034 "\\frac{1}{{f}^{-1}(x)}" 13194139534341 true] [17592186283766 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283766 1111 #uuid "36f1505d-dbf1-5581-8b11-1c7127e55f04" 13194139534341 true] [17592186283767 1017 #edb/ref 17592186283768 13194139534341 true] [17592186283767 1089 "q-51349" 13194139534341 true] [17592186283767 1091 #edb/ref 17592186045464 13194139534341 true] [17592186283767 1100 "If $f(x)=\\operatorname{sin}⁡({e}^{x}),$ find ${({f}^{-1})}^{′}(x)$ as a function of ${f}^{-1}(x).$" 13194139534341 true] [17592186283767 1113 #uuid "ec72463d-d5ee-5538-ac45-df3dfce269a3" 13194139534341 true] [17592186283767 1145 "**Step 1:** First, we write the inverse function implicitly. The given function is $y=\\operatorname{sin}⁡({e}^{x}),$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=\\operatorname{sin}⁡({e}^{y})\n$$\n\nNote that in the equation above, we have $y={f}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}[\\operatorname{sin}⁡({e}^{y})] \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\operatorname{cos}⁡({e}^{y})\\cdot {e}^{y} \\\\ \\frac{\\text{d}x}{\\text{d}y} & ={e}^{y}\\operatorname{cos}⁡({e}^{y}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{e}^{y}\\operatorname{cos}⁡({e}^{y})} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{-y}\\operatorname{sec}⁡({e}^{y})\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & ={e}^{-{f}^{-1}(x)}\\operatorname{sec}⁡({e}^{{f}^{-1}(x)}) \\\\ {({f}^{-1})}^{′}(x) & ={e}^{-{f}^{-1}(x)}\\operatorname{sec}⁡({e}^{{f}^{-1}(x)}).\\end{aligned}\n$$" 13194139534341 true] [17592186283768 1000 #edb/ref 17592186283769 13194139534341 true] [17592186283768 1000 #edb/ref 17592186283770 13194139534341 true] [17592186283768 1000 #edb/ref 17592186283771 13194139534341 true] [17592186283768 1000 #edb/ref 17592186283772 13194139534341 true] [17592186283768 1000 #edb/ref 17592186283773 13194139534341 true] [17592186283768 1040 #edb/ref 17592186045450 13194139534341 true] [17592186283768 1041 "selection" 13194139534341 true] [17592186283768 1104 #edb/ref 17592186283770 13194139534341 true] [17592186283768 1110 #uuid "1b1126e6-9b33-54d9-9939-f85fd79daba9" 13194139534341 true] [17592186283769 1034 "{e}^{{f}^{-1}(x)}\\operatorname{cos}⁡({e}^{{f}^{-1}(x)})" 13194139534341 true] [17592186283769 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283769 1111 #uuid "afe7b751-b900-5083-8d6e-8a7f5912f219" 13194139534341 true] [17592186283770 1034 "{e}^{-{f}^{-1}(x)}\\operatorname{sec}⁡({e}^{{f}^{-1}(x)})" 13194139534341 true] [17592186283770 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283770 1111 #uuid "4780b023-f771-5749-bc7f-80a0bb9ab5ca" 13194139534341 true] [17592186283771 1034 "{e}^{-{f}^{-1}(x)}\\operatorname{cos}⁡({e}^{{f}^{-1}(x)})" 13194139534341 true] [17592186283771 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283771 1111 #uuid "48d64e71-651e-5a81-a0ee-9a97026a0dd9" 13194139534341 true] [17592186283772 1034 "{e}^{{f}^{-1}(x)}\\operatorname{csc}⁡({e}^{{f}^{-1}(x)})" 13194139534341 true] [17592186283772 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283772 1111 #uuid "3e6b1d43-1654-5781-89ab-f9d2b6071942" 13194139534341 true] [17592186283773 1034 "{e}^{{f}^{-1}(x)}\\operatorname{sec}⁡({e}^{-{f}^{-1}(x)})" 13194139534341 true] [17592186283773 1103 #edb/ref 17592186045453 13194139534341 true] [17592186283773 1111 #uuid "e4eeda2c-2ca5-5450-a593-be06143a83cd" 13194139534341 true] [17592186283774 1017 #edb/ref 17592186283775 13194139534341 true] [17592186283774 1089 "q-73083" 13194139534341 true] [17592186283774 1091 #edb/ref 17592186045464 13194139534341 true] [17592186283774 1100 "If $g(x)={e}^{\\operatorname{sin}⁡2x},$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" 13194139534341 true] [17592186283774 1113 #uuid "21913596-666f-5e3b-b3cf-ebdaeea1672d" 13194139534341 true] [17592186283774 1145 "**Step 1:** First, we write the inverse function implicitly. The given function is $y={e}^{\\operatorname{sin}⁡2x},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx={e}^{\\operatorname{sin}⁡2y}\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({e}^{\\operatorname{sin}⁡2y}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & ={e}^{\\operatorname{sin}⁡2y}\\cdot \\operatorname{cos}⁡2y\\cdot 2 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =2\\,{e}^{\\operatorname{sin}⁡2y}\\operatorname{cos}⁡2y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\,{e}^{\\operatorname{sin}⁡2y}\\operatorname{cos}⁡2y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{e}^{-\\operatorname{sin}⁡2y}\\operatorname{sec}⁡2y}{2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{{e}^{-\\operatorname{sin}⁡(2{g}^{-1}(x))}\\operatorname{sec}⁡(2{g}^{-1}(x))}{2} \\\\ {({g}^{-1})}^{′}(x) & =\\frac{{e}^{-\\operatorname{sin}⁡(2{g}^{-1}(x))}\\operatorname{sec}⁡(2{g}^{-1}(x))}{2}.\\end{aligned}\n$$" 13194139534341 true] [17592186283775 1000 #edb/ref 17592186283776 13194139534341 true] [17592186283775 1000 #edb/ref 17592186283777 13194139534341 true] [17592186283775 1000 #edb/ref 17592186283778 13194139534341 true] [17592186283775 1000 #edb/ref 17592186283779 13194139534341 true] [17592186283775 1000 #edb/r