date]} {:db/id "q-117462" :question/id #uuid "e64fd775-535a-57c6-92d2-90544b5aea0d" :question/math-academy-id "q-117462" :question/problem "$4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\frac{1}{\\sqrt{3}}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-\\frac{\\pi }{6})=-\\operatorname{tan}⁡(\\frac{\\pi }{6})=-\\frac{1}{\\sqrt{3}}.\n$$\n\nSince $-\\frac{\\pi }{6}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}})=-\\frac{\\pi }{6}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}4\\operatorname{arctan}⁡(-\\frac{1}{\\sqrt{3}}) & =4\\cdot (-\\frac{\\pi }{6}) \\\\  & =-\\frac{2\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-117462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b"] :knowledge-point/questions ["q-117462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82168/selection/04a957e6e22629a4173a3ba5fec0752e198f21a1bfd1ab3b4e1aaccd930174d3" :answer/id #uuid "d5dc7aaf-8efb-5927-9fd0-b30cd4bcabd0" :answer/type :answer.type/math :answer/value "{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82168/selection/bc1f7595490861f8fa350184b50826541fc7815f7212daefd0983d5cbe822ccc" :answer/id #uuid "6dc896e0-7fb4-5e0f-b72b-200ddbf3ae1a" :answer/type :answer.type/math :answer/value "-{60}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82168/selection/5b65178c72af1af2fe5a7aeaef5a6e00605e69ded44b1ba5e72cb6dd4731f6f6" :answer/id #uuid "19fa3890-70c6-516a-a83e-0ba43bc19131" :answer/type :answer.type/math :answer/value "-{30}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82168/selection/b8903bf0f0c79152fee06a2deb1a952caebfd91f17e1376aeed868afbb728af8" :answer/id #uuid "59f9f4da-69bf-5cc6-b764-9c93aed8eea7" :answer/type :answer.type/math :answer/value "{45}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82168/selection/0dedc37c1c07b1d3afccefbc2cd1d676db0a66a60d8f6fa588da436c9c06df07" :answer/id #uuid "5fa8722f-8fc2-5ecd-932f-c5c5f439eed7" :answer/type :answer.type/math :answer/value "-{45}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82168/selection" :answer-field/id #uuid "4d7210d8-c4e5-5a96-996f-9ac73f4182bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82168/selection/0dedc37c1c07b1d3afccefbc2cd1d676db0a66a60d8f6fa588da436c9c06df07" :answer-field/choices ["q-82168/selection/04a957e6e22629a4173a3ba5fec0752e198f21a1bfd1ab3b4e1aaccd930174d3" "q-82168/selection/bc1f7595490861f8fa350184b50826541fc7815f7212daefd0983d5cbe822ccc" "q-82168/selection/5b65178c72af1af2fe5a7aeaef5a6e00605e69ded44b1ba5e72cb6dd4731f6f6" "q-82168/selection/b8903bf0f0c79152fee06a2deb1a952caebfd91f17e1376aeed868afbb728af8" "q-82168/selection/0dedc37c1c07b1d3afccefbc2cd1d676db0a66a60d8f6fa588da436c9c06df07"] :db/ensure [:answer-field/validate]} {:db/id "q-82168" :question/id #uuid "751d9d58-2d64-59a8-827a-380f97a17c29" :question/math-academy-id "q-82168" :question/problem "$\\operatorname{arctan}⁡(-1)=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-{90}^{∘}<\\theta <{90}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-1$ is negative, our answer is an angle that lies in the fourth quadrant, where tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-{45}^{∘})=-\\operatorname{tan}⁡({45}^{∘})=-1.\n$$\n\nSince $-{45}^{∘}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that:\n\n$$\n\\operatorname{arctan}⁡(-1)=-{45}^{∘}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b"] :knowledge-point/questions ["q-82168"] :db/ensure [:knowledge-point/validate]}]
