#{[{:db/id #edb/ref 17592186284583 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab3429ce-58f7-55e6-8f04-13a18abe2b10" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186284585} {:answer/id #uuid "87f019a1-3763-53df-aff8-7420c297dc30" :answer/type {:db/ident :answer.type/math} :answer/value "10+10\\text{ }\\,\\text{i}" :db/id #edb/ref 17592186284586} {:answer/id #uuid "0c7862a8-4b56-5809-a9e6-c860eab67b09" :answer/type {:db/ident :answer.type/math} :answer/value "1+10\\text{ }\\,\\text{i}" :db/id #edb/ref 17592186284587} {:answer/id #uuid "c4231085-58f5-5faa-bc90-708562b03200" :answer/type {:db/ident :answer.type/math} :answer/value "5+5\\text{ }\\,\\text{i}" :db/id #edb/ref 17592186284588} {:answer/id #uuid "69a98d0b-9729-5b79-ab27-ad6daad02b5f" :answer/type {:db/ident :answer.type/math} :answer/value "10\\text{ }\\,\\text{i}" :db/id #edb/ref 17592186284589}] :answer-field/correct {:answer/id #uuid "69a98d0b-9729-5b79-ab27-ad6daad02b5f" :answer/type {:db/ident :answer.type/math} :answer/value "10\\text{ }\\,\\text{i}" :db/id #edb/ref 17592186284589} :answer-field/id #uuid "5b044b46-e792-55e6-b426-265320a9a959" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284584}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b79a5096-1a0b-5fc6-8e53-289ae9cb0a23" :question/math-academy-id "q-107564" :question/problem "Express $z=10(\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{2}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0$ and $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1$, we have\n\n$$\n\\begin{aligned}z & =10(\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{2})) \\\\  & =10(0+\\text{i}) \\\\  & =10\\text{ }\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284590 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7eceab0-366b-5776-ab2a-115d4cdb6162" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186284592} {:answer/id #uuid "af181426-9835-52ee-b01d-f5cdd212b398" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186284593}] :answer-field/correct {:answer/id #uuid "d7eceab0-366b-5776-ab2a-115d4cdb6162" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186284592} :answer-field/id #uuid "e2b41941-0024-56e4-9847-a4d0a01b2f69" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284591} {:answer-field/choices [{:answer/id #uuid "5c570236-afba-59b3-9c45-f33456ab1432" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186284595}] :answer-field/correct {:answer/id #uuid "5c570236-afba-59b3-9c45-f33456ab1432" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186284595} :answer-field/id #uuid "63d2046d-a7fa-55d1-99de-e8a1d49cb1e9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284594}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d1ca38ae-7b0b-5dce-86aa-49e40e354ec2" :question/math-academy-id "q-321310" :question/problem "Express $z=4\\sqrt{3}(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))$ in the form $z=x+y\\,\\text{i},$ where $x$ and $y$ are real numbers. Give the **exact** values of $x$ and $y.$\n\n$z=$\n{{field-1}}\n$+$\n{{field-2}}\n$i$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\frac{\\sqrt{3}}{2}$ and $\\operatorname{sin}⁡(\\frac{\\pi }{6})=\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}z & =4\\sqrt{3}(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})) \\\\  & =4\\sqrt{3}(\\frac{\\sqrt{3}}{2}+\\text{i}\\,\\frac{1}{2}) \\\\  & =\\frac{4\\cdot 3}{2}+\\text{i}\\,\\frac{4\\sqrt{3}}{2} \\\\  & =6+2\\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284596 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf8a1bb-9f7f-5d3c-b555-34f1ea0f13f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{29}}{29}" :db/id #edb/ref 17592186284598}] :answer-field/correct {:answer/id #uuid "edf8a1bb-9f7f-5d3c-b555-34f1ea0f13f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{29}}{29}" :db/id #edb/ref 17592186284598} :answer-field/id #uuid "3224b6c9-4e6c-5176-a81f-f4c0a3394212" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284597} {:answer-field/choices [{:answer/id #uuid "9ddff1ae-8e6e-58ca-ba23-402c232aef67" :answer/type {:db/ident :answer.type/math} :answer/value "5.90" :db/id #edb/ref 17592186284600}] :answer-field/correct {:answer/id #uuid "9ddff1ae-8e6e-58ca-ba23-402c232aef67" :answer/type {:db/ident :answer.type/math} :answer/value "5.90" :db/id #edb/ref 17592186284600} :answer-field/id #uuid "176e374e-a7f5-5ad4-bf8f-62395fc31a68" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284599} {:answer-field/choices [{:answer/id #uuid "1915e1a7-dd8e-56ce-9524-3a255c2f2383" :answer/type {:db/ident :answer.type/math} :answer/value "5.90" :db/id #edb/ref 17592186284602}] :answer-field/correct {:answer/id #uuid "1915e1a7-dd8e-56ce-9524-3a255c2f2383" :answer/type {:db/ident :answer.type/math} :answer/value "5.90" :db/id #edb/ref 17592186284602} :answer-field/id #uuid "2bba3519-9ab5-5b03-acf5-8d03c26af76a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284601}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "611bc47f-782a-5d17-b6c5-83149097d2d2" :question/math-academy-id "q-321385" :question/problem "Express $z=\\frac{9}{5+2\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$ Give the **exact** value of $r$ and round $\\theta $ in **radians** from $[0,2\\pi )$ to **two decimal places**.\n\n$z=$\n{{field-1}}$\\cdot (cos$\n$(${{field-2}}$)$\n$+\\,isin$\n$(${{field-3}}$))$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $5-2\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{9}{5+2\\text{i}} \\\\  & =\\frac{9(5-2\\text{i})}{(5+2\\text{i})(5-2\\text{i})} \\\\  & =\\frac{45-18\\text{i}}{{5}^{2}-(2\\text{i})^{2}} \\\\  & =\\frac{45-18\\text{i}}{{5}^{2}+(2)^{2}} \\\\  & =\\frac{45-18\\text{i}}{29} \\\\  & =\\frac{45}{29}-\\frac{18}{29}\\,i\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{45}{29}-\\frac{18}{29}\\,i,$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{(\\frac{45}{29})}^{2}+{(\\frac{18}{29})}^{2}} \\\\  & =\\sqrt{\\frac{2025+324}{{29}^{2}}} \\\\  & =\\frac{\\sqrt{2349}}{29} \\\\  & =\\frac{9\\sqrt{29}}{29}.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{45}{29}$ and $y=-\\frac{18}{29},$ $z$ lies in the fourth quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -arctan\\,(\\frac{|y|}{x}) \\\\  & =2\\pi -arctan\\,(\\frac{18}{45}) \\\\  & ≈5.90\\,,\\end{aligned}\n$$\n\nrounded to two decimal places.\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\frac{9\\sqrt{29}}{29}\\cdot \\,(\\operatorname{cos}⁡(5.90)+\\text{i}\\operatorname{sin}⁡(5.90)).\n$$"}] [{:db/id #edb/ref 17592186284603 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e598fafb-c9b5-53f4-b467-fa36df08668d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\operatorname{cos}⁡(3.107)+\\text{i}\\operatorname{sin}⁡(3.107))" :db/id #edb/ref 17592186284605} {:answer/id #uuid "9156d3e6-80a4-53a3-b5ee-7ad32f223f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\operatorname{cos}⁡(4.381)+\\text{i}\\operatorname{sin}⁡(4.381))" :db/id #edb/ref 17592186284606} {:answer/id #uuid "51b7d695-f706-5e21-8923-1b88db7ee750" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}(\\operatorname{cos}⁡(4.914)+\\text{i}\\operatorname{sin}⁡(4.914))" :db/id #edb/ref 17592186284607} {:answer/id #uuid "3467e09a-ef83-5645-8140-ab7b2e28ee18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.381)+\\text{i}\\operatorname{sin}⁡(5.381))" :db/id #edb/ref 17592186284608} {:answer/id #uuid "dbf18722-7f93-5074-aff9-0978277ec294" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176))" :db/id #edb/ref 17592186284609}] :answer-field/correct {:answer/id #uuid "dbf18722-7f93-5074-aff9-0978277ec294" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176))" :db/id #edb/ref 17592186284609} :answer-field/id #uuid "11f080a9-58ce-509b-8cc0-4cf17c80b279" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284604}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1f280618-7de3-53e4-9bd5-785b7a45e949" :question/math-academy-id "q-69966" :question/problem "Express $z=\\frac{4}{1+2\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$ Give $\\theta $ in radians to three decimal places." :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1-2\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1+2\\text{i}} \\\\  & =\\frac{4(1-2\\text{i})}{(1+2\\text{i})(1-2\\text{i})} \\\\  & =\\frac{4(1-2\\text{i})}{{1}^{2}-(2\\text{i})^{2}} \\\\  & =\\frac{4(1-2\\text{i})}{1+4} \\\\  & =\\frac{4}{5}-\\frac{8}{5}\\text{i}.\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{4}{5}-\\frac{8}{5}\\text{i},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{(\\frac{4}{5})}^{2}+{(-\\frac{8}{5})}^{2}} \\\\  & =\\sqrt{\\frac{{4}^{2}+{8}^{2}}{{5}^{2}}} \\\\  & =\\sqrt{\\frac{80}{25}} \\\\  & =\\sqrt{\\frac{16\\cdot 5}{25}} \\\\  & =\\frac{4\\sqrt{5}}{5}.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{4}{5}$ is positive and $y=-\\frac{8}{5}$ is negative, $z$ lies in the fourth quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =2\\pi -\\operatorname{arctan}⁡|\\frac{(-\\frac{8}{5})}{(\\frac{4}{5})}| \\\\  & =2\\pi -\\operatorname{arctan}⁡2 \\\\  & ≈5.176,\\end{aligned}\n$$\n\nrounded to three decimal places. \n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\frac{4\\sqrt{5}}{5}(\\operatorname{cos}⁡(5.176)+\\text{i}\\operatorname{sin}⁡(5.176)).\n$$"}] [{:db/id #edb/ref 17592186284610 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a4c1991-1a93-5dc7-9c7c-f09b11010c9c" :answer/type {:db/ident :answer.type/math} :answer/value "z=2+2\\text{i}" :db/id #edb/ref 17592186284612} {:answer/id #uuid "74a1cc72-4f8b-5c08-ab02-bfc361925fd6" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\text{i}" :db/id #edb/ref 17592186284613} {:answer/id #uuid "20b79ad2-c440-5bc5-9df3-8d93d35f703c" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\frac{\\sqrt{3}}{2}+\\frac{\\sqrt{3}}{2}\\text{i}" :db/id #edb/ref 17592186284614} {:answer/id #uuid "6619b78f-6baf-5173-9de7-b6f15a2559e8" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\frac{1}{2}+\\frac{1}{2}\\text{i}" :db/id #edb/ref 17592186284615} {:answer/id #uuid "3e25dba3-152f-53ae-963f-cacac1531613" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\sqrt{2}+\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186284616}] :answer-field/correct {:answer/id #uuid "74a1cc72-4f8b-5c08-ab02-bfc361925fd6" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\text{i}" :db/id #edb/ref 17592186284613} :answer-field/id #uuid "5d40e98c-5034-548d-bbbc-74e825529c28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284611}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "66b8616a-a25e-564d-8712-165503b57af7" :question/math-academy-id "q-8265" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{2}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0$ and $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1$, we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{2})) \\\\  & =2(0+\\text{i}) \\\\  & =2\\text{i}.\\end{aligned}\n$$"}]}
