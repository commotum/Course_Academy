3c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-75003" :question/id #uuid "fcf11fb9-58d2-55fd-b334-801c50653234" :question/math-academy-id "q-75003" :question/problem "Find $|r(4)|$ given that $r(t)=⟨\\frac{10}{t+1},\\,2t-2,\\,t-1⟩.$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨\\frac{10}{4+1},\\,2(4)-2,\\,4-1⟩ \\\\  & =⟨2,\\,6,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(2)}^{2}+{(6)}^{2}+(3)^{2}} \\\\  & =\\sqrt{4+36+9} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6"] :knowledge-point/questions ["q-75003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348688/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6f09b970-5892-5891-8ec5-0412520044bb" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-348688/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d84d600e-a017-5e73-9b8f-80abed7089cb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-348688/field-1" :answer-field/id #uuid "0528d9a0-f05b-5f03-87ca-04fee8e9f4f0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348688/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-348688/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-348688/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-348688" :question/id #uuid "12c75ade-a7cb-5a88-ad89-1782d7777d90" :question/math-academy-id "q-348688" :question/problem "Given that $r(t)=⟨\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t,\\,\\sqrt{t+3}⟩,$ what is $|r(0)|?$\n\n$|r(0)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨\\operatorname{tan}⁡(0),\\,\\operatorname{sec}⁡(0),\\,\\sqrt{0+3}⟩ \\\\  & =⟨0,\\,1,\\,\\sqrt{3}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(0)| & =\\sqrt{{0}^{2}+{1}^{2}+{(\\sqrt{3})}^{2}} \\\\  & =\\sqrt{0+1+3} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348688/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6"] :knowledge-point/questions ["q-348688"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75007/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "644f951e-e913-5fbb-bbcb-60d09149cc79" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-75007/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "090b9036-4f41-57e1-98ae-b3344ca0ef5a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-75007/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "a680c483-188a-5253-a6fc-9d02e1521a1a" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-75007/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7338b196-30f5-5613-b854-8a77d15b27c7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-75007/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "31181d37-fc8c-5cfb-93bf-bcd96e0021b7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-75007/selection