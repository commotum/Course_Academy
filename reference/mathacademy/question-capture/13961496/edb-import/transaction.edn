[:answer-field/validate]} {:db/id "q-346871" :question/id #uuid "4bed6628-9bc5-587b-9b20-a87b959b2364" :question/math-academy-id "q-346871" :question/problem "What is the value of $f(t)=\\sqrt[3]{{t}^{2}+4}\\,i+{3}^{t}\\,j+\\operatorname{tan}⁡(\\frac{\\pi t}{2})\\,k$ at $t=2?$\n\n$f(2)=$\n{{field-1}} $i\\,+\\,$\n\n{{field-2}} $j\\,+\\,$\n\n{{field-3}} $k$" :question/worked-solution "To evaluate, we substitute $t=2$ into the function, as follows:\n\n$$\n\\begin{aligned}f(2) & =\\sqrt[3]{{2}^{2}+4}\\,i+{3}^{2}\\,j+\\operatorname{tan}⁡(\\frac{2\\pi }{2})\\,k \\\\  & =\\sqrt[3]{8}\\,i+{3}^{2}\\,j+\\operatorname{tan}⁡(\\pi )\\,k \\\\  & =2\\,i+9\\,j+0\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346871/field-1" "q-346871/field-2" "q-346871/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a"] :knowledge-point/questions ["q-346871"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161506/selection/6e28864631d8b52eead39b3e6e03babcbd99f059520f6130bd49f2f8037be5c7" :answer/id #uuid "7e353741-f6f4-5427-bd0d-60b8b2e435ab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-161506/selection/9d1e17d9784da5ae0067ade351923f4b0836785a26b2360fd2d3ae75fb99bcb4" :answer/id #uuid "077b7ab8-87dc-5b2f-a05d-a3ca488daf73" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-161506/selection/d41e8ad0932523cffb7a2a88ca40c784311bb148faa6562f95c64444a18caea3" :answer/id #uuid "54548e6c-52a5-5c99-a202-b607377637d4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-161506/selection/38f36ecf7e66f4d51433bbcedaac05f456d9a6137d41b67a5fa6fd8c02f10335" :answer/id #uuid "ab1148a6-0633-5312-9d79-d8db68892360" :answer/type :ans