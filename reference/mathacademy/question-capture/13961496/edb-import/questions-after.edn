answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186268602} :answer-field/id #uuid "93d30fc0-6746-5195-a5a6-4aba48f0a492" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268600}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "442d4853-a2f5-55c8-ada0-a83ad98f8f66" :question/math-academy-id "q-74997" :question/problem "Given that $r(t)=⟨3t-1,\\,2t⟩,$ $|r(3)|=$" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨3(3)-1,\\,2(3)⟩ \\\\  & =⟨8,\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{(8)}^{2}+{(6)}^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268606 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a476ab-f1ad-5407-a5b4-b7c635d38ef5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186268608} {:answer/id #uuid "1b26ad41-0ed6-5944-b652-148cef72751d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186268609} {:answer/id #uuid "d530c1fe-060e-5c5e-8a78-4e0e2eeaf90c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186268610} {:answer/id #uuid "32d0e519-5b24-5b46-b50c-096b316838ea" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268611} {:answer/id #uuid "9d8cd03b-d9d8-543a-96a8-183443c65734" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268612}] :answer-field/correct {:answer/id #uuid "32d0e519-5b24-5b46-b50c-096b316838ea" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268611} :answer-field/id #uuid "c6108dfe-c2ec-5f5a-b4ef-7c4df8cd3e80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268607}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fcf11fb9-58d2-55fd-b334-801c50653234" :question/math-academy-id "q-75003" :question/problem "Find $|r(4)|$ given that $r(t)=⟨\\frac{10}{t+1},\\,2t-2,\\,t-1⟩.$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨\\frac{10}{4+1},\\,2(4)-2,\\,4-1⟩ \\\\  & =⟨2,\\,6,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(2)}^{2}+{(6)}^{2}+(3)^{2}} \\\\  & =\\sqrt{4+36+9} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268613 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87b1d33f-fe7b-5cd0-9d3d-d409a567c209" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268615} {:answer/id #uuid "9eda29bc-19d4-52fb-b59a-85396aad351d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268616} {:answer/id #uuid "ab93ecbe-5935-5986-80ef-2fc983c0196a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186268617} {:answer/id #uuid "586b5ae3-3342-501e-8e94-59bdffebe3d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186268618} {:answer/id #uuid "ed18e90c-ff09-5820-afb3-957b53c31273" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268619}] :answer-field/correct {:answer/id #uuid "9eda29bc-19d4-52fb-b59a-85396aad351d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 1759218626861