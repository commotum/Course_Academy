#{[{:db/id #edb/ref 17592186068380 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle$, calculate $\\mathbf r (3)$." :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}\nr(3) &= ⟨6(3), 2(3)^{2} - 1⟩ \\\\\n&= ⟨18, 17⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068381 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t) = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle$," :question/worked-solution "Evaluating the function at $t=4$, we get\n\n$$\n\\begin{aligned}\nr(4) &= ⟨2 - 4, 2\\sqrt{4}, 4 - 1⟩ \\\\\n&= ⟨ - 2, 4, 3⟩\n\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}\n\\mid r(4) \\mid &= \\sqrt{(-2)^{2} + (4)^{2} + (3)^{2}} \\\\\n&= \\sqrt{4 + 16 + 9} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068382 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi$." :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}\nf(π) &= ⟨\\cos π, \\sin π, π⟩ = ⟨ - 1, 0, π⟩\n\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle$.\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n$\\begin{bmatrix}-1 \\\\ 0 \\\\ π\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186268537 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a67d72f0-f373-5eb3-9bf2-4857976014da" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,\\,6⟩" :db/id #edb/ref 17592186268539} {:answer/id #uuid "5979b788-bd28-5eaf-a5e6-ba691860eee8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨9,\\,3⟩" :db/id #edb/ref 17592186268540} {:answer/id #uuid "465f5c8a-9b34-5d52-a429-4639e92343bd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨64,\\,40⟩" :db/id #edb/ref 17592186268541} {:answer/id #uuid "619ca699-28a7-5be2-afb9-c954f4be2454" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,\\,12⟩" :db/id #edb/ref 17592186268542} {:answer/id #uuid "b8bfe311-c38c-5120-b384-e4a0ae5d60dc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,9⟩" :db/id #edb/ref 17592186268543}] :answer-field/correct {:answer/id #uuid "a67d72f0-f373-5eb3-9bf2-4857976014da" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18,\\,6⟩" :db/id #edb/ref 17592186268539} :answer-field/id #uuid "2502aa90-d84b-5142-9cff-19054ee2187b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268538}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "85b19ac8-e7c5-5de9-9668-e92ad2daa76d" :question/math-academy-id "q-123199" :question/problem "Given that $r(t)=⟨{t}^{2}-46,\\,\\sqrt{5t-4}⟩,$ calculate $r(8).$" :question/worked-solution "We  substitute $t=8$ into our function, and we get\n\n$$\n\\begin{aligned}r(8) & =⟨{8}^{2}-46,\\,\\sqrt{5\\cdot 8-4}⟩ \\\\  & =⟨18,\\,6⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268544 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a664d28-c9a1-556b-ba4f-558574e84c3e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{3}{2}⟩" :db/id #edb/ref 17592186268546} {:answer/id #uuid "0ed3537f-cd1c-5d98-8387-77d3b2852077" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186268547} {:answer/id #uuid "9c8b907c-ddf1-50e8-9e06-05762c5cc9d1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12,\\,\\frac{1}{4}⟩" :db/id #edb/ref 17592186268548} {:answer/id #uuid "e0430a33-6147-54f9-84a1-fbd1f1ebf087" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{4}{3}⟩" :db/id #edb/ref 17592186268549} {:answer/id #uuid "bffe0b4f-5974-599e-a4a5-dee0571e1340" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{3},\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186268550}] :answer-field/correct {:answer/id #uuid "0ed3537f-cd1c-5d98-8387-77d3b2852077" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186268547} :answer-field/id #uuid "37a7cf68-64bf-5f22-8e84-044a11bb2dde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268545}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "12003e8d-c48c-5642-87cc-c7c437d424fc" :question/math-academy-id "q-123203" :question/problem "Given that $r(t)=⟨6\\operatorname{cos}⁡(5t),\\,{sin}^{2}⁡(5t)⟩,$ calculate $r(\\frac{\\pi }{3}).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{3}$ into our function, and we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨6\\operatorname{cos}⁡(5\\cdot \\frac{\\pi }{3}),\\,{sin}^{2}⁡(5\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨(6\\cdot \\frac{1}{2}),\\,{(-\\frac{\\sqrt{3}}{2})}^{2}⟩ \\\\  & =⟨3,\\,\\frac{3}{4}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069015 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cff65542-349f-5cbe-84e3-0440f87b222d" :answer/type {:db/ident :answer.type/text} :answer/value "$⟨4, 3, 12⟩$\n\n---\n\n<a id=\"the-magnitude-of-a-vector-valued-function\"></a>" :db/id #edb/ref 17592186065885} {:answer/id #uuid "e74f894c-1b5c-561e-90dd-ebf8e081e736" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3, 9, 16⟩" :db/id #edb/ref 17592186065886} {:answer/id #uuid "f4e5c15c-b975-5599-a180-19991e8f1aef" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3, 3, 16⟩" :db/id #edb/ref 17592186065887} {:answer/id #uuid "f8a0b296-9fd7-58db-aeef-0e3dfe4b01e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3, 1, 8⟩" :db/id #edb/ref 17592186065888} {:answer/id #uuid "6bfeaee6-b45b-570a-a05a-94291efe5176" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 3, 6⟩" :db/id #edb/ref 17592186065889} {:answer/id #uuid "d3f8ac61-6955-5400-8217-71b251376657" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,3,12⟩" :db/id #edb/ref 17592186268551}] :answer-field/correct {:answer/id #uuid "f4e5c15c-b975-5599-a180-19991e8f1aef" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3, 3, 16⟩" :db/id #edb/ref 17592186065887} :answer-field/id #uuid "8d2932ee-1e2e-5a84-bc39-e0089126d354" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065884}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0cd4c69a-4abd-54a9-8f88-7b5f4da95fc6" :question/math-academy-id "q-160793" :question/problem "What is the value of $f(t) = ⟨3e^{t - 5}, \\sqrt{t + 4}, (t - 3)^{4}⟩$ at $t = 5$?" :question/worked-solution "To evaluate, we substitute $t=5$ into the function, as follows:\n\n$$\n\\begin{aligned}f(5) & =⟨3{e}^{5-5},\\sqrt{5+4},(5-3)^{4}⟩ \\\\  & =⟨3{e}^{0},\\sqrt{9},{2}^{4}⟩ \\\\  & =⟨3,3,16⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=5$ is the vector $⟨3,3,16⟩.$"}] [{:db/id #edb/ref 17592186268552 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab1148a6-0633-5312-9d79-d8db68892360" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{2} \\\\ 9 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186268554} {:answer/id #uuid "7e353741-f6f4-5427-bd0d-60b8b2e435ab" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{2} \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186268555} {:answer/id #uuid "077b7ab8-87dc-5b2f-a05d-a3ca488daf73" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186268556} {:answer/id #uuid "54548e6c-52a5-5c99-a202-b607377637d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186268557} {:answer/id #uuid "e56bc078-835c-5486-a85b-d94d207a9247" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186268558}] :answer-field/correct {:answer/id #uuid "077b7ab8-87dc-5b2f-a05d-a3ca488daf73" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186268556} :answer-field/id #uuid "40fcd9bb-039e-555e-9cdd-a6709435ca09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "39cdd465-8a8f-530a-8cd2-e3cb51c2a94d" :question/math-academy-id "q-161506" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\sqrt{t+2} \\\\ 5-{t}^{2} \\\\ \\operatorname{cos}⁡(t-2)\\end{aligned}]$ at $t=2?$" :question/worked-solution "To evaluate, we substitute $t=2$ into the function, as follows:\n\n$$\n\\begin{aligned}f(2) & =[\\begin{aligned}\\sqrt{2+2} \\\\ 5-{2}^{2} \\\\ \\operatorname{cos}⁡(2-2)\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{4} \\\\ 5-4 \\\\ \\operatorname{cos}⁡(0)\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=2$ is the vector $[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}].$"}] [{:db/id #edb/ref 17592186268559 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea4c1e11-bc54-566e-b141-29b16c0b74aa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 10 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186268561} {:answer/id #uuid "24ae19b4-2e51-58f9-853b-9b5f548e52d5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 25 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186268562} {:answer/id #uuid "ddb6b60c-0e29-516d-824f-a766f5f006c3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186268563} {:answer/id #uuid "35031c1c-e25d-5903-862a-a993dedc5fe8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 5 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186268564} {:answer/id #uuid "4c4b5483-cbae-5889-95d6-4272993863be" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{ln}⁡4 \\\\ 10 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186268565}] :answer-field/correct {:answer/id #uuid "ddb6b60c-0e29-516d-824f-a766f5f006c3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186268563} :answer-field/id #uuid "ee65f761-76c7-5bcc-9375-5d179a2172d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268560}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5997d23c-f4be-520f-b449-c2cd06354d7b" :question/math-academy-id "q-161507" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\operatorname{ln}⁡(t-4) \\\\ 5t \\\\ 1-2t\\end{aligned}]$ at $t=5?$" :question/worked-solution "To evaluate, we substitute $t=5$ into the function, as follows:\n\n$$\n\\begin{aligned}f(5) & =[\\begin{aligned}\\operatorname{ln}⁡(5-4) \\\\ 5(5) \\\\ 1-2(5)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡1 \\\\ {5}^{2} \\\\ 1-10\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=5$ is the vector $[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}].$"}] [{:db/id #edb/ref 17592186268566 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6d35272-60dd-5dbc-a916-dbcdbf1a1172" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,28,16⟩" :db/id #edb/ref 17592186268568} {:answer/id #uuid "9ec040a5-d06f-5244-9ee4-d9b0efe62bb4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,10,16⟩" :db/id #edb/ref 17592186268569} {:answer/id #uuid "a4c03f69-648d-511f-a2a7-8844b7bd30ff" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},28,16⟩" :db/id #edb/ref