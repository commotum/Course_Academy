17592186248382}] :answer-field/correct {:answer/id #uuid "c3685cc7-ddff-5482-8916-b374a64f49d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{5}" :db/id #edb/ref 17592186248382} :answer-field/id #uuid "2c6e28e5-0291-5836-94b7-dac8034cab72" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248381}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b7051329-a00a-5962-876e-9ade482c493a" :question/is-example false :question/math-academy-id "q-336931" :question/problem "If $p(x)=11{x}^{4}$ and $q(x)=5{x}^{4},$ then\n\n${lim}_{x\\to \\infty }\\frac{p(x)}{q(x)}=$  \n{{field-1}}." :question/worked-solution "When we divide the two functions, we get a constant, and the limit of a constant is just the constant itself:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to \\infty }\\frac{(11{x}^{4})}{(5{x}^{4})} \\\\  & ={lim}_{x\\to \\infty }\\frac{11}{5} \\\\  & =\\frac{11}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106209 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5bea806-2913-57f5-ba32-be7aeda5bd15" :knowledge-point/title "Computing the Limit at Infinity of a Power Function With an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0c8660-b958-5948-817f-c495790e6c26" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{27}" :db/id #edb/ref 17592186103764} {:answer/id #uuid "48a3d730-474e-5c52-9906-53ca7e7ce41f" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186103765} {:answer/id #uuid "493e117b-ba9e-55d0-a4f8-1cad63fa41bf" :answer/type {:db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186103766} {:answer/id #uuid "6592e29d-e444-5ebd-901a-948679f3a73f" :answer/type {:db/ident :answer.type/math} :answer/value "∞" :db/id #edb/ref 17592186103767} {:answer/id #uuid "6b1246bc-001a-5ac7-9137-1221992a6f0c" :answer/type {:db/ident :answer.type/math} :answer/value "- ∞" :db/id #edb/ref 17592186103768} {:answer/id #uuid "1be6bff0-5372-5728-ac3d-51d12660551e" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186248383}] :answer-field/correct {:answer/id #uuid "6b1246bc-001a-5ac7-9137-1221992a6f0c" :answer/type {:db/ident :answer.type/math} :answer/value "- ∞" :db/id #edb/ref 17592186103768} :answer-field/id #uuid "281fdd24-c388-5161-94f8-d962e6beb7d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103763}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9e7d872a-3281-5ff2-815f-9462c8c82695" :question/is-example false :question/math-academy-id "q-35241" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1263/Source/Images/q-35241.png)\n\nThe figure shows the graph of $y = f(x)$. Calculate $lim_(x → - ∞)(xf(x))^{3}$." :question/worked-solution "Applying the power rule and the product rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{(xf(x))}^{3} & =({lim}_{x\\to -\\infty }{x}^{3})\\cdot ({lim}_{x\\to -\\infty }f(x)^{3}) \\\\  & =({lim}_{x\\to -\\infty }{x}^{3})\\cdot {({lim}_{x\\to -\\infty }f(x))}^{3}.\\end{aligned}\n$$\n\nFrom the graph, we get that ${lim}_{x\\to -\\infty }f(x)=3.$ Therefore, the above becomes:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{(xf(x))}^{3} & ={lim}_{x\\to -\\infty }{x}^{3}\\cdot {(3)}^{3} \\\\  & ={lim}_{x\\to -\\infty }{x}^{3}\\cdot 27 \\\\  & =27\\cdot {lim}_{x\\to -\\infty }{x}^{3}\\end{aligned}\n$$\n\nThe graph $y={x}^{3}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{3}=-\\infty .\n$$\n\nMultiplication by the positive constant $27$ does not affect the limit at infinity. So, we have\n\n$$\n\\begin{aligned}27\\cdot {lim}_{x\\to -\\infty }{x}^{3} & ={lim}_{x\\to -\\infty }{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }{(xf(x))}^{3}=-\\infty .\n$$"}] [{:db/id #edb/ref 17592186248384 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7543d9d8-5714-590a-bc8a-a6a9d62fb853" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186248386} {:answer/id #uuid "73d6f39b-91f0-5dea-b230-6cbac64088e5" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186248387} {:answer/id #uuid "166da29f-830c-51f1-872d-85cfc1bb508a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186248388} {:answer/id #uuid "66737e74-d6a6-58ce-8d9f-dabf599435ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186248389} {:answer/id #uuid "be702a1d-6741-5945-b020-3f09e397ecec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248390}] :answer-field/correct {:answer/id #uuid "7543d9d8-5714-590a-bc8a-a6a9d62fb853" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186248386} :answer-field/id #uuid "6b06e830-db73-555b-8e8e-61bcf09f61fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248385}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "494506ed-3be9-5fa5-a304-e992bf8e5303" :question/is-example false :question/math-academy-id "q-3946" :question/problem "Calculate ${lim}_{x\\to \\infty }(4{x}^{2}-5x+16).$" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(4{x}^{2}-5x+16) & ={lim}_{x\\to \\infty }(4{x}^{2}) \\\\  & =4\\cdot {lim}_{x\\to \\infty }({x}^{2}) \\\\  & =\\infty \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248391 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e4413e-1007-561a-93c7-561b7005cc4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186248393} {:answer/id #uuid "1d6f6749-6e90-5d9e-8c94-680278bcb57b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186248394} {:answer/id #uuid "59e2b2c6-ef9d-511e-a415-54c21f1f28c3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248395} {:answer/id #uuid "34b0d2ff-47c9-50a0-b61d-b991e370d1aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186248396} {:answer/id #uuid "f4d78422-761c-5dd6-b0ee-a4dfe3f5ab5a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186248397}] :answer-field/correct {:answer/id #uuid "46e4413e-1007-561a-93c7-561b7005cc4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186248393} :answer-field/id #uuid "7beb79b6-a8a5-5e99-91e8-88fbe9740b9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248392}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7b459699-7d1d-5e8e-a709-c8342eddf28d" :question/is-example false :question/math-academy-id "q-99300" :question/problem "Evaluate ${lim}_{t\\to \\infty }{({t}^{2}+1)}^{4}.$" :question/worked-solution "We identify the leading term and compute its limit. In this case, we raise the main term of the base polynomial to the given power.\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }({t}^{2}+1)^{4} & ={lim}_{t\\to \\infty }({t}^{2})^{4} \\\\  & ={lim}_{t\\to \\infty }{t}^{8} \\\\  & =\\infty \\end{aligned}\n$$"}]}
