4}) & =0 \\\\ 4{x}^{2}-4x+13 & =0.\\end{aligned}\n$$" 13194139534123 true] [17592186277921 1000 #edb/ref 17592186277922 13194139534123 true] [17592186277921 1000 #edb/ref 17592186277923 13194139534123 true] [17592186277921 1000 #edb/ref 17592186277924 13194139534123 true] [17592186277921 1000 #edb/ref 17592186277925 13194139534123 true] [17592186277921 1000 #edb/ref 17592186277926 13194139534123 true] [17592186277921 1040 #edb/ref 17592186045450 13194139534123 true] [17592186277921 1041 "selection" 13194139534123 true] [17592186277921 1104 #edb/ref 17592186277924 13194139534123 true] [17592186277921 1110 #uuid "a9cef55a-b4d1-5a31-a5ef-b5d62868f746" 13194139534123 true] [17592186277922 1034 "4{x}^{2}-13x+4=0" 13194139534123 true] [17592186277922 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277922 1111 #uuid "d01e41f0-e212-520d-95f0-74bec61d7121" 13194139534123 true] [17592186277923 1034 "4{x}^{2}-8x+16=0" 13194139534123 true] [17592186277923 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277923 1111 #uuid "a7162c1f-8403-56e9-b166-77c202871017" 13194139534123 true] [17592186277924 1034 "4{x}^{2}-4x+13=0" 13194139534123 true] [17592186277924 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277924 1111 #uuid "864dc1dc-f3e9-5499-abeb-685bebbf5189" 13194139534123 true] [17592186277925 1034 "4{x}^{2}+4x+13=0" 13194139534123 true] [17592186277925 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277925 1111 #uuid "610adbdd-1dce-505b-b0be-e08186378084" 13194139534123 true] [17592186277926 1034 "4{x}^{2}+16x+13=0" 13194139534123 true] [17592186277926 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277926 1111 #uuid "1c4d435e-940d-518b-89df-90a42c0fc5b5" 13194139534123 true] [17592186277927 1017 #edb/ref 17592186277928 13194139534123 true] [17592186277927 1089 "q-16936" 13194139534123 true] [17592186277927 1091 #edb/ref 17592186045465 13194139534123 true] [17592186277927 1100 "A quadratic equation in the variable $x$ with real coefficients has a root $x=-3+4\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." 13194139534123 true] [17592186277927 1113 #uuid "e559008a-7b37-5496-9372-56da3e8e43d1" 13194139534123 true] [17592186277927 1145 "Since the quadratic equation has real coefficients and $x=-3+4\\text{i}$ is a root, its conjugate $x=-3-4\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-3+4\\text{i}))(x-(-3-4\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-3-4\\text{i})-x(-3+4\\text{i})+(-3+4\\text{i})(-3-4\\text{i}) & =0 \\\\ {x}^{2}+3x+4x\\text{i}+3x-4x\\text{i}+9-16{\\text{i}}^{2} & =0 \\\\ {x}^{2}+6x+9+16 & =0 \\\\ {x}^{2}+6x+25 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=-3\\pm 4\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+6x+25) & =0 \\\\ 3{x}^{2}+18x+75 & =0.\\end{aligned}\n$$" 13194139534123 true] [17592186277928 1000 #edb/ref 17592186277929 13194139534123 true] [17592186277928 1000 #edb/ref 17592186277930 13194139534123 true] [17592186277928 1000 #edb/ref 17592186277931 13194139534123 true] [17592186277928 1000 #edb/ref 17592186277932 13194139534123 true] [17592186277928 1000 #edb/ref 17592186277933 13194139534123 true] [17592186277928 1040 #edb/ref 17592186045450 13194139534123 true] [17592186277928 1041 "selection" 13194139534123 true] [17592186277928 1104 #edb/ref 17592186277933 13194139534123 true] [17592186277928 1110 #uuid "18ac9bc7-2bf3-5f8c-b9d4-5fcb9fdd6e9d" 13194139534123 true] [17592186277929 1034 "3{x}^{2}+75x+18=0" 13194139534123 true] [17592186277929 1103 #edb/ref 17592186045453 13194139534123 true] [17592186277929 1111 #uuid "1d502d8e-3a85-5fe0-a6a4-683601c2b3e2" 13194139534123