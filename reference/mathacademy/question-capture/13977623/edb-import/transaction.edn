af-5fa6-5ec2-bdc0-5b948f1970bc" :answer/type :answer.type/math :answer/value "6{x}^{2}+6=0" :db/ensure [:answer/validate]} {:db/id "q-83584/selection/9226a8038eee300183921c181baa10ebcea32a84c9047b68ef437ddadb7dc1c1" :answer/id #uuid "91a4b701-2061-5820-b257-7fdf43ff4fa4" :answer/type :answer.type/math :answer/value "6{x}^{2}-2=0" :db/ensure [:answer/validate]} {:db/id "q-83584/selection/337548c335b2a87897b67b208eb4382e945096059b81ee755ae8c43200e9f197" :answer/id #uuid "faf4fa59-c7e0-5104-be05-c85f60e7b421" :answer/type :answer.type/math :answer/value "6{x}^{2}+2=0" :db/ensure [:answer/validate]} {:db/id "q-83584/selection/d271f92e15dba064e951820a682d7df9f6350fe91bcc804e77ef744472fd2a44" :answer/id #uuid "e2595612-a299-58d2-9c64-ecba8751d7d4" :answer/type :answer.type/math :answer/value "6{x}^{2}-3=0" :db/ensure [:answer/validate]} {:db/id "q-83584/selection/42fb161e3cd458eb9d37906bb186b330e4ec27624b9462e8cde8a53f6c6ff8a8" :answer/id #uuid "e46f587e-164c-530c-8904-2d3915a941a5" :answer/type :answer.type/math :answer/value "6{x}^{2}+3=0" :db/ensure [:answer/validate]} {:db/id "q-83584/selection" :answer-field/id #uuid "c702422a-718f-5f93-b4a0-dde2e4d353da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83584/selection/42fb161e3cd458eb9d37906bb186b330e4ec27624b9462e8cde8a53f6c6ff8a8" :answer-field/choices ["q-83584/selection/993fd03e46abdc8cd114c0ce5d99b581623e023fd4036858cc5978987151c1ad" "q-83584/selection/9226a8038eee300183921c181baa10ebcea32a84c9047b68ef437ddadb7dc1c1" "q-83584/selection/337548c335b2a87897b67b208eb4382e945096059b81ee755ae8c43200e9f197" "q-83584/selection/d271f92e15dba064e951820a682d7df9f6350fe91bcc804e77ef744472fd2a44" "q-83584/selection/42fb161e3cd458eb9d37906bb186b330e4ec27624b9462e8cde8a53f6c6ff8a8"] :db/ensure [:answer-field/validate]} {:db/id "q-83584" :question/id #uuid "bcd2e909-ecd9-5092-bf02-27cd4d48ec9e" :question/math-academy-id "q-83584" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\frac{\\sqrt{2}\\text{i}}{2}.$ Given that the coefficient of ${x}^{2}$ in the equation is $6$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=\\frac{\\sqrt{2}\\text{i}}{2}$ is a root, its conjugate  $x=-\\frac{\\sqrt{2}\\text{i}}{2}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\frac{\\sqrt{2}\\text{i}}{2})(x+\\frac{\\sqrt{2}\\text{i}}{2})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-{(\\frac{\\sqrt{2}\\text{i}}{2})}^{2} & =0 \\\\ {x}^{2}-\\frac{2}{4}(-1) & =0 \\\\ {x}^{2}+\\frac{1}{2} & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\frac{\\sqrt{2}\\text{i}}{2},$ but the coefficient of ${x}^{2}$ is not $6.$ Therefore, to find the desired equation, we multiply the equation above by $6.$ This gives\n\n$$\n\\begin{aligned}6({x}^{2}+\\frac{1}{2}) & =0 \\\\ 6{x}^{2}+3 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-83584/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d"] :knowledge-point/questions ["q-83584"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-28523"] :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=2\\text{i}$ is a root, its conjugate  $x=-2\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-2\\text{i})(x+2\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(2\\text{i})^{2} & =0 \\\\ {x}^{2}-4(-1) & =0 \\\\ {x}^{2}+4 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm 2\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+4) & =0 \\\\ 3{x}^{2}+12 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-160005/selection/82613518f59a11732489081ebf1ea69da2619002029b176178b5019b403afec4" :answer/id #uuid "b10a96ed-38ea-55c1-b195-dbbe9450bea8" :answer/type :answer.type/math :answer/value "4{x}^{2}+2=0" :db/ensure [:answer/validate]} {:db/id "q-160005/selection/df98932b1faea692d78b0c1c65548f31d57589b878803e7b2cde32d353a22f8f" :answer/id #uuid "094dee23-d7d6-5224-9d44-4d2d32346b28" :answer/type :answer.type/math :answer/value "4{x}^{2}-6=0" :db/ensure [:answer/validate]} {:db/id "q-160005/selection/1449e70389b5edec0dfea4ca89a2e1dd103f3969811b2e353122c7d0faddbf36" :answer/id #uuid "e36f6615-42cf-51c3-843c-23cbb69c46cb" :answer/type :answer.type/math :answer/value "4{x}^{2}-4=0" :db/ensure [:answer/validate]} {:db/id "q-160005/selection/0b8655b5b4fd947da163032779a16adced03622acd5496c9ebb88114c01f2c0f" :answer/id #uuid "d1762f5c-a828-593a-b476-2a0506e1ffc9" :answer/type :answer.type/math :answer/value "4{x}^{2}+6=0" :db/ensure [:answer/validate]} {:db/id "q-160005/selection/51fed60890baa8cf56aeff117252e2a938d45efa5b098e70e5faae9f40c6e705" :answer/id #uuid "0fae7175-8034-5d13-a670-ce76e142d890" :answer/type :answer.type/math :answer/value "4{x}^{2}+4=0" :db/ensure [:answer/validate]} {:db/id "q-160005/selection" :answer-field/id #uuid "f08fc1fe-886f-55ff-9c40-ae82cb5085de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160005/selection/0b8655b5b4fd947da163032779a16adced03622acd5496c9ebb88114c01f2c0f" :answer-field/choices ["q-160005/selection/82613518f59a11732489081ebf1ea69da2619002029b176178b5019b403afec4" "q-160005/selection/df98932b1faea692d78b0c1c65548f31d57589b878803e7b2cde32d353a22f8f" "q-160005/selection/1449e70389b5edec0dfea4ca89a2e1dd103f3969811b2e353122c7d0faddbf36" "q-160005/selection/0b8655b5b4fd947da163032779a16adced03622acd5496c9ebb88114c01f2c0f" "q-160005/selection/51fed60890baa8cf56aeff117252e2a938d45efa5b098e70e5faae9f40c6e705"] :db/ensure [:answer-field/validate]} {:db/id "q-160005" :question/id #uuid "c0e4e3f6-996e-5dd9-bca4-ac8109f31dab" :question/math-academy-id "q-160005" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $4$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i}$ is a root, its conjugate  $x=-\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:  \n\n$$\n(x-\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i})(x+\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i})=0\n$$\n\n   \n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-{(\\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i})}^{2} & =0 \\\\ {x}^{2}-\\frac{3}{2}(-1) & =0 \\\\ {x}^{2}+\\frac{3}{2} & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\sqrt{\\frac{3}{2}}\\text{ }\\,\\text{i},$ but the coefficient of ${x}^{2}$ is not $4.$ Therefore, to find the desired equation, we multiply the equation above by $4.$ This gives\n\n$$\n\\begin{aligned}4({x}^{2}+\\frac{3}{2}) & =0 \\\\ 4{x}^{2}+6 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-160005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d"] :knowledge-point/questions ["q-160005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281325/field-1/20523e0b4715837d517706f0545358d5c3f5aa0973230b6e97d98ef384a8f725" :answer/id #uuid "2e24ca91-8ef8-5b5f-8b1a-afb8aafc4d1d" :answer/type :answer.type/math :answer/value "25x^2+49" :db/ensure [:answer/validate]} {:db/id "q-281325/field-1/c5572080f997d5db4d506bc9a78e51018a8ec699ffe661bdd645cacf3c971082" :answer/id #uuid "3d3546cc-de96-500d-abf3-c5549084d191" :answer/type :answer.type/math :answer/value "25x^2-49" :db/ensure [:answer/validate]} {:db/id "q-281325/field-1" :answer-field/id #uuid "02afbf49-4d5a-5d46-9d05-62a18fc8c607" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281325/field-1/20523e0b4715837d517706f0545358d5c3f5aa0973230b6e97d98ef384a8f725" :answer-field/choices ["q-281325/field-1/20523e0b4715837d517706f0545358d5c3f5aa0973230b6e97d98ef384a8f725" "q-281325/field-1/c5572080f997d5db4d506bc9a78e51018a8ec699ffe661bdd645cacf3c971082"] :db/ensure [:answer-field/validate]} {:db/id "q-281325" :question/id #uuid "30b9a300-fc91-58f5-b861-39886df00af7" :question/math-academy-id "q-281325" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\frac{7\\text{i}}{5}.$ Given that the coefficient of ${x}^{2}$ in the equation is $25,$ find the equation. Write your answer in the form $a{x}^{2}+bx+c=0,$ where $a,$ $b,$ and $c$ are real constants.\n\n{{field-1}}$=0$" :question/worked-solution "Since the quadratic equation has real coefficients and $x=\\frac{7\\text{i}}{5}$ is a root, its conjugate $x=-\\frac{7\\text{i}}{5}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\frac{7\\text{i}}{5})(x+\\frac{7\\text{i}}{5})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-{(\\frac{7\\text{i}}{5})}^{2} & =0 \\\\ {x}^{2}-\\frac{49}{25}(-1) & =0 \\\\ {x}^{2}+\\frac{49}{25} & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\frac{7\\text{i}}{5},$ but the coefficient of ${x}^{2}$ is not $25.$ Therefore, to find the desired equation, we multiply the equation above by $25.$ This gives\n\n$$\n\\begin{aligned}25({x}^{2}+\\frac{49}{25}) & =0 \\\\ 25{x}^{2}+49 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-281325/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d"] :knowledge-point/questions ["q-281325"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281332/field-1/97bafa878a65007a21d81272a88c46268926d55d464844a8fa79f5953ebe08a0" :answer/id #uuid "b3a630b7-39d0-53be-9c9c-73924db46c6d" :answer/type :answer.type/math :answer/value "25x^2+2" :db/ensure [:answer/validate]} {:db/id "q-281332/field-1" :answer-field/id #uuid "88981c5f-8f0f-5e76-875f-020ddf19d5f5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281332/field-1/97bafa878a65007a21d81272a88c46268926d55d464844a8fa79f5953ebe08a0" :answer-field/choices ["q-281332/field-1/97bafa878a65007a21d81272a88c46268926d55d464844a8fa79f5953ebe08a0"] :db/ensure [:answer-field/validate]} {:db/id "q-281332" :question/id #uuid "9844b4bd-f63c-55f4-b3ff-74927a03bd17" :question/math-academy-id "q-281332" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\frac{\\sqrt{2}\\,\\text{i}}{5}.$ Given that the coefficient of ${x}^{2}$ in the equation is $25,$ find the equation. Write your answer in the form $a{x}^{2}+bx+c=0,$ where $a,$ $b,$ and $c$ are real constants.\n\n{{field-1}}$=0$" :question/worked-solution "Since the quadratic equation has real coefficients and $x=\\frac{\\sqrt{2}\\,\\text{i}}{5}$ is a root, its conjugate $x=-\\frac{\\sqrt{2}\\,\\text{i}}{5}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\frac{\\sqrt{2}\\,\\text{i}}{5})(x+\\frac{\\sqrt{2}\\,\\text{i}}{5})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-{(\\frac{\\sqrt{2}\\,\\text{i}}{5})}^{2} & =0 \\\\ {x}^{2}-\\frac{2}{25}(-1) & =0 \\\\ {x}^{2}+\\frac{2}{25} & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\frac{\\sqrt{2}\\,\\text{i}}{5},$ but the coefficient of ${x}^{2}$ is not $25.$ Therefore, to find the desired equation, we multiply the equation above by $25.$ This gives\n\n$$\n\\begin{aligned}25({x}^{2}+\\frac{2}{25}) & =0 \\\\ 25{x}^{2}+2 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-281332/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d"] :knowledge-point/questions ["q-281332"] :db/ensure [:knowledge-point/validate]} {:db/id "q-28224/selection/c750c56bb5811bb88e106d2abb2ab13ba871fb499599f926a38f329847e99903" :answer/id #uuid "d8d63285-206c-5943-b15b-851bfbf50262" :answer/type :answer.type/math :answer/value "5{x}^{2}+30x+13=0" :db/ensure [:answer/validate]} {:db/id "q-28224/selection/4b5ff1c5da4711832356292578e4258974cee925173a9add61b5e5506e615345" :answer/id #uuid "637c2717-30b4-5e15-8382-7ef96fabbeac" :answer/type :answer.type/math :answer/value "5{x}^{2}-30x-65=0" :db/ensure [:answer/validate]} {:db/id "q-28224/selection/beffdbb04ed52ccdde2c4138f20a4303139ede914059382f90cd789d728cb75f" :answer/id #uuid "2597656f-b4b6-578f-b9eb-d72012b86274" :answer/type :answer.type/math :answer/value "5{x}^{2}+65x+30=0" :db/ensure [:answer/validate]} {:db/id "q-28224/selection/b25f8e4cfa88bcae7386b49caee3687e73e0127d1b06c38f4eb0d2ab199d3bd5" :answer/id #uuid "d4e3282f-e6ea-592a-ad47-e4db2d129ebd" :answer/type :answer.type/math :answer/value "5{x}^{2}+30x+65=0" :db/ensure [:answer/validate]} {:db/id "q-28224/selection/6cd787ec37e68643861133a4589498a9179163d854d66d05830853048f2cb826" :answer/id #uuid "c466de8b-39cd-5efb-a312-656e8d6abc92" :answer/type :answer.type/math :answer/value "5{x}^{2}+6x+65=0" :db/ensure [:answer/validate]} {:db/id "q-28224/selection" :answer-field/id #uuid "9e694c51-d109-5447-8152-52cb1df0ecd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-28224/selection/b25f8e4cfa88bcae7386b49caee3687e73e0127d1b06c38f4eb0d2ab199d3bd5" :answer-field/choices ["q-28224/selection/c750c56bb5811bb88e106d2abb2ab13ba871fb499599f926a38f329847e99903" "q-28224/selection/4b5ff1c5da4711832356292578e4258974cee925173a9add61b5e5506e615345" "q-28224/selection/beffdbb04ed52ccdde2c4138f20a4303139ede914059382f90cd789d728cb75f" "q-28224/selection/b25f8e4cfa88bcae7386b49caee3687e73e0127d1b06c38f4eb0d2ab199d3bd5" "q-28224/selection/6cd787ec37e68643861133a4589498a9179163d854d66d05830853048f2cb826"] :db/ensure [:answer-field/validate]} {:db/id "q-28224" :question/id #uuid "184cd0a3-85ba-5b1e-a01b-94f6bbbf00ff" :question/math-academy-id "q-28224" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-3-2\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $5$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-3-2\\text{i}$ is a root, its conjugate $x=-3+2\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-3-2\\text{i}))(x-(-3+2\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-3+2\\text{i})-x(-3-2\\text{i})+(-3-2\\text{i})(-3+2\\text{i}) & =0 \\\\ {x}^{2}+3x-2x\\text{i}+3x+2x\\text{i}+9-4{\\text{i}}^{2} & =0 \\\\ {x}^{2}+6x+9+4 & =0 \\\\ {x}^{2}+6x+13 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=-3\\pm 2\\text{i},$ but the coefficient of ${x}^{2}$ is not $5.$ Therefore, to find the desired equation, we multiply the equation above by $5.$ This gives\n\n$$\n\\begin{aligned}5({x}^{2}+6x+13) & =0 \\\\ 5{x}^{2}+30x+65 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-28224/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5"] :knowledge-point/questions ["q-28224"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-28215"] :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-1+\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $1,$ find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-1+\\text{i}$ is a root, its conjugate $x=-1-\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-1+\\text{i}))(x-(-1-\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-1+\\text{i})-x(-1-\\text{i})+(-1+\\text{i})(-1-\\text{i}) & =0 \\\\ {x}^{2}+x-x\\text{i}+x+x\\text{i}+1-{\\text{i}}^{2} & =0 \\\\ {x}^{2}+2x+1+1 & =0 \\\\ {x}^{2}+2x+2 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-16938/selection/4e404b753ca73b27ccfa4dd5855bf10610b3140ba18f47e373ee0c357569d1f0" :answer/id #uuid "c1991f7c-f9be-50b5-bcd9-86c62d03659a" :answer/type :answer.type/math :answer/value "2{x}^{2}-4\\sqrt{3}x+8=0" :db/ensure [:answer/validate]} {:db/id "q-16938/selection/a22e0265b71978a486328d535d8d3eb3669c9adb5676311a155e550a13de5db4" :answer/id #uuid "cdb7d1bc-39a4-5a15-9e3f-2ec6e81c29f7" :answer/type :answer.type/math :answer/value "2{x}^{2}-6\\sqrt{3}x+18=0" :db/ensure [:answer/validate]} {:db/id "q-16938/selection/460cd51620558c279914695046b306a1bc7ab71d0d592e1fbb1b35125dd8f626" :answer/id #uuid "da3e800b-b782-5093-9946-7e5612d11fa8" :answer/type :answer.type/math :answer/value "2{x}^{2}-4\\sqrt{3}x+16=0" :db/ensure [:answer/validate]} {:db/id "q-16938/selection/44ade04f0faa8172c65bf4ff47f72991b0f152291f96b75cc864e2c9c1db6b9f" :answer/id #uuid "4140de87-6a61-54ce-9302-f2d5b140842a" :answer/type :answer.type/math :answer/value "2{x}^{2}-2\\sqrt{3}x+8=0" :db/ensure [:answer/validate]} {:db/id "q-16938/selection/8d026691e7549cbe79bab9309c60d36075b39ec2677b1d8e0426e82cd7cf280e" :answer/id #uuid "a143baa9-8ac6-5da9-a60d-9352e0d26b25" :answer/type :answer.type/math :answer/value "2{x}^{2}-8\\sqrt{3}x+10=0" :db/ensure [:answer/validate]} {:db/id "q-16938/selection" :answer-field/id #uuid "66c581f7-ce31-5634-a76f-a47e922c2ff9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16938/selection/4e404b753ca73b27ccfa4dd5855bf10610b3140ba18f47e373ee0c357569d1f0" :answer-field/choices ["q-16938/selection/4e404b753ca73b27ccfa4dd5855bf10610b3140ba18f47e373ee0c357569d1f0" "q-16938/selection/a22e0265b71978a486328d535d8d3eb3669c9adb5676311a155e550a13de5db4" "q-16938/selection/460cd51620558c279914695046b306a1bc7ab71d0d592e1fbb1b35125dd8f626" "q-16938/selection/44ade04f0faa8172c65bf4ff47f72991b0f152291f96b75cc864e2c9c1db6b9f" "q-16938/selection/8d026691e7549cbe79bab9309c60d36075b39ec2677b1d8e0426e82cd7cf280e"] :db/ensure [:answer-field/validate]} {:db/id "q-16938" :question/id #uuid "def05a71-1ca9-54ef-8d91-ee996f9ae29c" :question/math-academy-id "q-16938" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\sqrt{3}+\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=\\sqrt{3}+\\text{i}$ is a root, its conjugate $x=\\sqrt{3}-\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(\\sqrt{3}+\\text{i}))(x-(\\sqrt{3}-\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(\\sqrt{3}+\\text{i})-x(\\sqrt{3}-\\text{i})+(\\sqrt{3}-\\text{i})(\\sqrt{3}+\\text{i}) & =0 \\\\ {x}^{2}-x\\sqrt{3}-x\\text{i}-x\\sqrt{3}+x\\text{i}+3+\\sqrt{3}\\text{i}-\\sqrt{3}\\text{i}-{\\text{i}}^{2} & =0 \\\\ {x}^{2}-2\\sqrt{3}x+3+1 & =0 \\\\ {x}^{2}-2\\sqrt{3}x+4 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=\\sqrt{3}\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}-2\\sqrt{3}x+4) & =0 \\\\ 2{x}^{2}-4\\sqrt{3}x+8 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16938/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5"] :knowledge-point/questions ["q-16938"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16935/selection/92a2386c64b6dc8326d2e6039b5806b9534a9364f5a5252addffbc2377cd90ce" :answer/id #uuid "610adbdd-1dce-505b-b0be-e08186378084" :answer/type :answer.type/math :answer/value "4{x}^{2}+4x+13=0" :db/ensure [:answer/validate]} {:db/id "q-16935/selection/1e66d122be010b5b617913b74efb5d73e4ef13f2f6166f4e33935afdaa81f07e" :answer/id #uuid "d01e41f0-e212-520d-95f0-74bec61d7121" :answer/type :answer.type/math :answer/value "4{x}^{2}-13x+4=0" :db/ensure [:answer/validate]} {:db/id "q-16935/selection/82bdc260d1994f1054b75a007e5975686cf4d55b4d7d6454ce000fffad45f5cc" :answer/id #uuid "864dc1dc-f3e9-5499-abeb-685bebbf5189" :answer/type :answer.type/math :answer/value "4{x}^{2}-4x+13=0" :db/ensure [:answer/validate]} {:db/id "q-16935/selection/6ea544831f9ef8f4fe56e38054f32fdd2875e7bf5e646f5eb5539a65b26a6459" :answer/id #uuid "a7162c1f-8403-56e9-b166-77c202871017" :answer/type :answer.type/math :answer/value "4{x}^{2}-8x+16=0" :db/ensure [:answer/validate]} {:db/id "q-16935/selection/e931a6768e16b632830300692fa3c46626eb8a6cc362e89813067e1da1d9abfd" :answer/id #uuid "1c4d435e-940d-518b-89df-90a42c0fc5b5" :answer/type :answer.type/math :answer/value "4{x}^{2}+16x+13=0" :db/ensure [:answer/validate]} {:db/id "q-16935/selection" :answer-field/id #uuid "a9cef55a-b4d1-5a31-a5ef-b5d62868f746" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16935/selection/82bdc260d1994f1054b75a007e5975686cf4d55b4d7d6454ce000fffad45f5cc" :answer-field/choices ["q-16935/selection/92a2386c64b6dc8326d2e6039b5806b9534a9364f5a5252addffbc2377cd90ce" "q-16935/selection/1e66d122be010b5b617913b74efb5d73e4ef13f2f6166f4e33935afdaa81f07e" "q-16935/selection/82bdc260d1994f1054b75a007e5975686cf4d55b4d7d6454ce000fffad45f5cc" "q-16935/selection/6ea544831f9ef8f4fe56e38054f32fdd2875e7bf5e646f5eb5539a65b26a6459" "q-16935/selection/e931a6768e16b632830300692fa3c46626eb8a6cc362e89813067e1da1d9abfd"] :db/ensure [:answer-field/validate]} {:db/id "q-16935" :question/id #uuid "3e9fca3c-0e3f-5f42-89f3-8866c444b9c9" :question/math-academy-id "q-16935" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=\\frac{1}{2}+\\sqrt{3}\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $4$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=\\frac{1}{2}+\\sqrt{3}\\text{i}$ is a root, its conjugate $x=\\frac{1}{2}-\\sqrt{3}\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(\\frac{1}{2}+\\sqrt{3}\\text{i}))(x-(\\frac{1}{2}-\\sqrt{3}\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(\\frac{1}{2}-\\sqrt{3}\\text{i})-x(\\frac{1}{2}+\\sqrt{3}\\text{i})+(\\frac{1}{2}+\\sqrt{3}\\text{i})(\\frac{1}{2}-\\sqrt{3}\\text{i}) & =0 \\\\ {x}^{2}-\\frac{x}{2}+x\\sqrt{3}\\text{i}-\\frac{x}{2}-x\\sqrt{3}\\text{i}+\\frac{1}{4}-3{\\text{i}}^{2} & =0 \\\\ {x}^{2}-x+\\frac{1}{4}+3 & =0 \\\\ {x}^{2}-x+\\frac{13}{4} & =0\\end{aligned}\n$$\n\nThis equation has roots $x=\\frac{1}{2}\\pm \\sqrt{3}\\text{i},$ but the coefficient of ${x}^{2}$ is not $4.$ Therefore, to find the desired equation, we multiply the equation above by $4.$ This gives\n\n$$\n\\begin{aligned}4({x}^{2}-x+\\frac{13}{4}) & =0 \\\\ 4{x}^{2}-4x+13 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-16935/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5"] :knowledge-point/questions ["q-16935"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16936/selection/832978b1815b60e9746947a31103b1d2fca41ea4980205bc36b94ca2a850693c" :answer/id #uuid "625dfea3-ebe3-58b0-bcab-4f1f4b0a331f" :answer/type :answer.type/math :answer/value "3{x}^{2}+6x+25=0" :db/ensure [:answer/validate]} {:db/id "q-16936/selection/b931b5b69ca70aa2d223934edb751ccd60c8257616f9a9577521217955b7394f" :answer/id #uuid "b140914f-1374-5e37-a3da-d3426f753b79" :answer/type :answer.type/math :answer/value "3{x}^{2}+18x+75=0" :db/ensure [:answer/validate]} {:db/id "q-16936/selection/3c9df4a2d3cbf1683f07c283faac8848bc44f47c75e3df3c9f1735954ddc6718" :answer/id #uuid "1d502d8e-3a85-5fe0-a6a4-683601c2b3e2" :answer/type :answer.type/math :answer/value "3{x}^{2}+75x+18=0" :db/ensure [:answer/validate]} {:db/id "q-16936/selection/a0764aeb25cee386bbd9199a2e21b4dd9ef6cbd093582375bf5fdc20e2995144" :answer/id #uuid "43eb36c1-1817-502c-b215-7ae69013e2c2" :answer/type :answer.type/math :answer/value "3{x}^{2}-18x-25=0" :db/ensure [:answer/validate]} {:db/id "q-16936/selection/89c32cfb5a570a9183a67753069ecd52b0ad2fdb751db843a69e7c30a727291d" :answer/id #uuid "d9ab96b3-f892-5b70-9a9d-e24a064d4a17" :answer/type :answer.type/math :answer/value "3{x}^{2}+25x+6=0" :db/ensure [:answer/validate]} {:db/id "q-16936/selection" :answer-field/id #uuid "18ac9bc7-2bf3-5f8c-b9d4-5fcb9fdd6e9d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16936/selection/b931b5b69ca70aa2d223934edb751ccd60c8257616f9a9577521217955b7394f" :answer-field/choices ["q-16936/selection/832978b1815b60e9746947a31103b1d2fca41ea4980205bc36b94ca2a850693c" "q-16936/selection/b931b5b69ca70aa2d223934edb751ccd60c8257616f9a9577521217955b7394f" "q-16936/selection/3c9df4a2d3cbf1683f07c283faac8848bc44f47c75e3df3c9f1735954ddc6718" "q-16936/selection/a0764aeb25cee386bbd9199a2e21b4dd9ef6cbd093582375bf5fdc20e2995144" "q-16936/selection/89c32cfb5a570a9183a67753069ecd52b0ad2fdb751db843a69e7c30a727291d"] :db/ensure [:answer-field/validate]} {:db/id "q-16936" :question/id #uuid "e559008a-7b37-5496-9372-56da3e8e43d1" :question/math-academy-id "q-16936" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-3+4\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-3+4\\text{i}$ is a root, its conjugate $x=-3-4\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-3+4\\text{i}))(x-(-3-4\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-3-4\\text{i})-x(-3+4\\text{i})+(-3+4\\text{i})(-3-4\\text{i}) & =0 \\\\ {x}^{2}+3x+4x\\text{i}+3x-4x\\text{i}+9-16{\\text{i}}^{2} & =0 \\\\ {x}^{2}+6x+9+16 & =0 \\\\ {x}^{2}+6x+25 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=-3\\pm 4\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+6x+25) & =0 \\\\ 3{x}^{2}+18x+75 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16936/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5"] :knowledge-point/questions ["q-16936"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5776"] :question/problem "A quadratic equation with real coefficients has a root $x=5+4\\textrm{i}.$ What is the other root?" :question/worked-solution "We're given that the quadratic equation has real coefficients and that $x=5+4\\textrm{i}$ is a root. Therefore, its complex conjugate $x=5-4\\textrm{i}$ is also a root." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5777"] :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-3\\textrm{i}.$ Given that the coefficient of $x^2$ in the equation is $2,$ find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=-3\\textrm{i}$ is a root, its conjugate  $x = 3\\textrm{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-3\\textrm{i})(x+3\\textrm{i})= 0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(3\\text{i})^{2} & =0 \\\\ {x}^{2}-9(-1) & =0 \\\\ {x}^{2}+9 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm 3\\textrm{i},$ but the coefficient of $x^2$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}+9) & =0 \\\\ 2{x}^{2}+18 & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5778"] :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=6-8\\textrm{i}.$ Given that the coefficient of $x^2$ in the equation is $-1,$ find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=6-8\\textrm{i}$ is a root, its conjugate $x=6+8\\textrm{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n\\Bigl(x-(6-8\\textrm{i})\\Bigr)\\Bigl(x-(6+8\\textrm{i})\\Bigr) = 0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(6+8\\text{i})-x(6-8\\text{i})+(6-8\\text{i})(6+8\\text{i}) & =0 \\\\ {x}^{2}-6x-8x\\text{i}-6x+8x\\text{i}+36-64{\\text{i}}^{2} & =0 \\\\ {x}^{2}-12x+36+64 & =0 \\\\ {x}^{2}-12x+100 & =0\\end{aligned}\n$$\n\nThis equation has roots $x= 6 \\pm 8\\textrm{i},$ but the coefficient of $x^2$ is not $-1.$ Therefore, to find the desired equation, we multiply the equation above by $-1.$ This gives\n\n$$\n\\begin{aligned}-({x}^{2}-12x+100) & =0 \\\\ -{x}^{2}+12x-100 & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
