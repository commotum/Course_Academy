ld/validate]} {:db/id "q-16440" :question/id #uuid "d941dd07-47ec-5356-b0e4-b3fa2d7c5f55" :question/math-academy-id "q-16440" :question/problem "$\\frac{5}{-2+4\\text{i}}=$" :question/worked-solution "The denominator is $-2+4\\text{i}$ and its conjugate is $-2-4\\text{i}.$ We multiply both the numerator and the denominator by $-2-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{5}{-2+4\\text{i}} & =\\frac{5}{-2+4\\text{i}}\\cdot \\frac{-2-4\\text{i}}{-2-4\\text{i}} \\\\  & =\\frac{-10-20\\text{i}}{4+8\\text{i}-8\\text{i}-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16{\\text{i}}^{2}} \\\\  & =\\frac{-10-20\\text{i}}{4-16(-1)} \\\\  & =\\frac{-10-20\\text{i}}{4+16} \\\\  & =\\frac{-10-20\\text{i}}{20}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-10-20\\text{i}}{20}=-\\frac{10}{20}-\\frac{20}{20}\\text{i}=-\\frac{1}{2}-\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16440/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9"] :knowledge-point/questions ["q-16440"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74640/selection/8d172754ccd0db605170d829670a15aedb7dec0fb75e2c34858e3a658adba8a6" :answer/id #uuid "3da258ee-24d8-525d-a223-bb47e183e4a6" :answer/type :answer.type/math :answer/value "2-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74640/selection/3d5c9b8a9f6085aa4c92e1a3b3aed317cb67545d70395e40fed183af0eef64cc" :answer/id #uuid "c865486f-9f3c-58da-a7e7-2e47ba7fdd69" :answer/type :answer.type/math :answer/value "1+2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74640/selection/80f14af28cbc854468ec1b0c972127c8bcf3f13062742391bb6fc13a0ffa4299" :answer/id #uuid "e8e5e031-8b99-518b-bffb-42543ed42049" :answer/type :answer.type/math :answer/value "-2+\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74640/selection/8471602d8e40eaca128434603bd1bb97901eab4f13bcb9660022888e7fc8c3f1" :answer/id #uuid "d859f335-f943-597e-9b8f-2da5834b9848" :answer/type :answer.type/math :answer/value "1-2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74640/selection/6f359bd1b1a61e7e10bc249e405e3b8d6909706e45384c85acde8924db986358" :answer/id #uuid "bfef4a60-5a03-5c79-8b14-8dba653998ad" :answer/type :answer.type/math :answer/value "-1-2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74640/selection" :answer-field/id #uuid "d6ffc1e0-8bec-5603-99fd-3068263d3a8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74640/selection/3d5c9b8a9f6085aa4c92e1a3b3aed317cb67545d70395e40fed183af0eef64cc" :answer-field/choices ["q-74640/selection/8d172754ccd0db605170d829670a15aedb7dec0fb75e2c34858e3a658adba8a6" "q-74640/selection/3d5c9b8a9f6085aa4c92e1a3b3aed317cb67545d70395e40fed183af0eef64cc" "q-74640/selection/80f14af28cbc854468ec1b0c972127c8bcf3f13062742391bb6fc13a0ffa4299" "q-74640/selection/8471602d8e40eaca128434603bd1bb97901eab4f13bcb9660022888e7fc8c3f1" "q-74640/selection/6f359bd1b1a61e7e10bc249e405e3b8d6909706e45384c85acde8924db986358"] :db/ensure [:answer-field/validate]} {:db/id "q-74640" :question/id #uuid "e40b3e8d-acbf-5e5a-8904-17c200823e78" :question/math-academy-id "q-74640" :question/problem "$\\frac{5\\text{i}}{2+\\text{i}}=$" :question/worked-solution "The denominator is $2+\\text{i}$ and its conjugate is $2-\\text{i}.$ We multiply both the numerator and the denominator by $2-\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{5\\text{i}}{2+\\text{i}} & =\\frac{5\\text{i}}{2+\\text{i}}\\cdot \\frac{2-\\text{i}}{2-\\text{i}} \\\\  & =\\frac{10\\text{i}-5{\\text{i}}^{2}}{{2}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{10\\text{i}-5(-1)}{4-(-1)} \\\\  & =\\frac{10\\text{i}+5}{4+1} \\\\  & =\\frac{5+10\\text{i}}{5}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{5+10\\text{i}}{5}=\\frac{5}{5}+\\frac{10}{5}\\text{i}=1+2\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74640/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-74640"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74658/selection/2ecb940974495c8e695cae713b30e844f7c3bb3169a8eae28988a5a57741f97c" :answer/id #uuid "12c34c14-d4ea-553c-8023-a1c4a802dbbe" :answer/type :answer.type/math :answer/value "\\frac{7}{6}-\\frac{1}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74658/selection/5744076a7fa6a81758958f033b10af46e18805fd6f3f8a5a928c7309af6a4e2f" :answer/id #uuid "9a65b554-30f6-59b5-ad3a-b68b43756dd4" :answer/type :answer.type/math :answer/value "\\frac{5}{6}+\\frac{1}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74658/selection/974441531463d55e583a9701509c0051705218b6f9fd6c0f9363d37fc539f231" :answer/id #uuid "3f4cbc8d-4227-5c09-a20e-927e803f216c" :answer/type :answer.type/math :answer/value "-\\frac{5}{6}-\\frac{2}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74658/selection/0dfc6fbb5e97b6d3c9cb88e8dc3406d3d9f86e1efed738b82b2eef61e5348104" :answer/id #uuid "0c1d332d-c4f3-56b1-b32c-bec0cd92ef88" :answer/type :answer.type/math :answer/value "\\frac{1}{6}-\\frac{1}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74658/selection/ee44b4502e2b47ccea104253466acc350bd0c0d01ed74baefe3c9d1ca54543b3" :answer/id #uuid "8cdd065d-9160-58d2-9dd2-099103023c30" :answer/type :answer.type/math :answer/value "-\\frac{7}{6}+\\frac{1}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74658/selection" :answer-field/id #uuid "21173832-93ef-51bd-8b51-1dd33bf64e0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74658/selection/ee44b4502e2b47ccea104253466acc350bd0c0d01ed74baefe3c9d1ca54543b3" :answer-field/choices ["q-74658/selection/2ecb940974495c8e695cae713b30e844f7c3bb3169a8eae28988a5a57741f97c" "q-74658/selection/5744076a7fa6a81758958f033b10af46e18805fd6f3f8a5a928c7309af6a4e2f" "q-74658/selection/974441531463d55e583a9701509c0051705218b6f9fd6c0f9363d37fc539f231" "q-74658/selection/0dfc6fbb5e97b6d3c9cb88e8dc3406d3d9f86e1efed738b82b2eef61e5348104" "q-74658/selection/ee44b4502e2b47ccea104253466acc350bd0c0d01ed74baefe3c9d1ca54543b3"] :db/ensure [:answer-field/validate]} {:db/id "q-74658" :question/id #uuid "d001e5e8-238b-5615-a63b-2ba3e2764991" :question/math-academy-id "q-74658" :question/problem "If ${z}_{1}=-2-7\\text{i}$ and ${z}_{2}=6\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" :question/worked-solution "First, we set up the fraction:\n\n$$\n\\frac{-2-7\\text{i}}{6\\text{i}}\n$$\n\nThe denominator is the imaginary number $6\\text{i}.$ Note that this can be written as $0+6\\text{i},$ so the conjugate is $0-6\\text{i},$ or simply $-6\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-6\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{-2-7\\text{i}}{6\\text{i}} \\\\  & =\\frac{-2-7\\text{i}}{6\\text{i}}\\cdot \\frac{-6\\text{i}}{-6\\text{i}} \\\\  & =\\frac{12\\text{i}+42{\\text{i}}^{2}}{-36{\\text{i}}^{2}} \\\\  & =\\frac{12\\text{i}+42(-1)}{-36(-1)} \\\\  & =\\frac{-42+12\\text{i}}{36}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-42+12\\text{i}}{36}=-\\frac{42}{36}+\\frac{12}{36}\\text{i}=-\\frac{7}{6}+\\frac{1}{3}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74658/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958"] :knowledge-point/questions ["q-74658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316855/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" :answer/id #uuid "2fe10282-508d-5b3b-9908-a3fbb1809ad2" :answer/type :answer.type/math :answer/value "-\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-316855/field-1/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d" :answer/id #uuid "5890c373-95be-51c9-b36a-e328a1eba4d2" :answer/type :answer.type/math :answer/value "\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-316855/field-1" :answer-field/id #uuid "acc6a535-454a-5ae0-9bd1-6c9689bc94d5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316855/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" :answer-field/choices ["q-316855/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" "q-316855/field-1/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d"] :db/ensure [:answer-field/validate]} {:db/id "q-316855/field-2/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9" :answer/id #uuid "1d4b58b2-e536-5fbf-b4be-42d31a2e89ea" :answer/type :answer.type/math :answer/value "-\\frac{8}{13}" :db/ensure [:answer/validate]} {:db/id "q-316855/field-2" :answer-field/id #uuid "9a14e7aa-438b-5c59-9476-9abd225220fe" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316855/field-2/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9" :answer-field/choices ["q-316855/field-2/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9"] :db/ensure [:answer-field/validate]} {:db/id "q-316855" :question/id #uuid "9171a28d-fa2f-567e-a2a1-2aa08147aac0" :question/math-academy-id "q-316855" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4\\text{i}}{-2-3\\text{i}}=($ {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4\\text{i}}{-2-3\\text{i}} & =\\frac{4\\text{i}}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{-8\\text{i}+12{\\text{i}}^{2}}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8\\text{i}+12(-1)}{4-(-9)} \\\\  & =\\frac{-12-8\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-12-8\\text{i}}{13}=(-\\frac{12}{13})+(-\\frac{8}{13})\\,\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316855/field-1" "q-316855/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-316855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316870/field-1/7ccebbab7eeb6d417752aa3a7dda7b1973e3f610bda3b61d05461115b8eaf255" :answer/id #uuid "7fb467fa-bef4-56a0-aaa9-71bed1dfa94a" :answer/type :answer.type/math :answer/value "-\\frac{48}{25}" :db/ensure [:answer/validate]} {:db/id "q-316870/field-1" :answer-field/id #uuid "dac139f6-576b-52c9-8449-ac6fbe5ef7e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316870/field-1/7ccebbab7eeb6d417752aa3a7dda7b1973e3f610bda3b61d05461115b8eaf255" :answer-field/choices ["q-316870/field-1/7ccebbab7eeb6d417752aa3a7dda7b1973e3f610bda3b61d05461115b8eaf255"] :db/ensure [:answer-field/validate]} {:db/id "q-316870/field-2/83818e3ed05d6bde35cdef2471342a2ab8a9206aaab5e01cab70b67961793dd7" :answer/id #uuid "5cebdc4b-dda8-5bb3-bab2-58b6e89e1d30" :answer/type :answer.type/math :answer/value "-\\frac{36}{25}" :db/ensure [:answer/validate]} {:db/id "q-316870/field-2" :answer-field/id #uuid "25bbd1a5-601d-5823-9fa6-eab5f523d70d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316870/field-2/83818e3ed05d6bde35cdef2471342a2ab8a9206aaab5e01cab70b67961793dd7" :answer-field/choices ["q-316870/field-2/83818e3ed05d6bde35cdef2471342a2ab8a9206aaab5e01cab70b67961793dd7"] :db/ensure [:answer-field/validate]} {:db/id "q-316870" :question/id #uuid "9a06cccd-9359-5113-9fa9-604c27757929" :question/math-academy-id "q-316870" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{12}{-4+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-4+3\\text{i}$ and its conjugate is $-4-3\\text{i}.$ We multiply both the numerator and the denominator by $-4-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{12}{-4+3\\text{i}} & =\\frac{12}{-4+3\\text{i}}\\cdot \\frac{-4-3\\text{i}}{-4-3\\text{i}} \\\\  & =\\frac{12(-4-3\\text{i})}{(-4)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-48-36\\text{i}}{16-(-9)} \\\\  & =\\frac{-48-36\\text{i}}{25}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-48-36\\text{i}}{25}=(-\\frac{48}{25})+(-\\frac{36}{25})\\,\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316870/field-1" "q-316870/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9"] :knowledge-point/questions ["q-316870"] :db/ensure [:knowledge-point/validate]}]
