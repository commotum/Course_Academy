) & =5\\operatorname{cos}⁡0-0\\cdot \\operatorname{sin}⁡0=5.\\end{aligned}\n$$\n\nTherefore, the Maclaurin expansion is\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡x & =(0)+(1)\\cdot x+\\frac{(0)}{2!}{x}^{2}+\\frac{(-3)}{3!}{x}^{3}+\\frac{(0)}{4!}{x}^{4}+\\frac{(5)}{5!}{x}^{5}+⋯ \\\\  & =x-\\frac{{x}^{3}}{2}+\\frac{{x}^{5}}{24}+⋯.\\end{aligned}\n$$" 13194139534675 true] [17592186302734 1000 #edb/ref 17592186302735 13194139534675 true] [17592186302734 1000 #edb/ref 17592186302736 13194139534675 true] [17592186302734 1000 #edb/ref 17592186302737 13194139534675 true] [17592186302734 1000 #edb/ref 17592186302738 13194139534675 true] [17592186302734 1000 #edb/ref 17592186302739 13194139534675 true] [17592186302734 1040 #edb/ref 17592186045450 13194139534675 true] [17592186302734 1041 "selection" 13194139534675 true] [17592186302734 1104 #edb/ref 17592186302735 13194139534675 true] [17592186302734 1110 #uuid "13f2e6c3-de80-50b5-9068-6a6f60bf1de1" 13194139534675 true] [17592186302735 1034 "x\\operatorname{cos}⁡x=x-\\frac{{x}^{3}}{2}+\\frac{{x}^{5}}{24}+⋯" 13194139534675 true] [17592186302735 1103 #edb/ref 17592186045453 13194139534675 true] [17592186302735 1111 #uuid "52ebbba0-7857-5edd-af5b-dfd2a56bf112" 13194139534675 true] [17592186302736 1034 "x\\operatorname{cos}⁡x=x+\\frac{{x}^{2}}{6}+\\frac{{x}^{4}}{120}+⋯" 13194139534675 true] [17592186302736 1103 #edb/ref 17592186045453 13194139534675 true] [17592186302736 1111 #uuid "86da213f-cc75-52f3-a4c6-209f25d40535" 13194139534675 true] [17592186302737 1034 "x\\operatorname{cos}⁡x=x-\\frac{{x}^{3}}{2}+\\frac{{x}^{5}}{5}+⋯" 13194139534675 true] [17592186302737 1103 #edb/ref 17592186045453 13194139534675 true] [17592186302737 1111 #uuid "1d40c591-d2bb-55f9-8613-19135a05ef26" 13194139534675 true] [17592186302738 1034 "x\\operatorname{cos}⁡x=x-\\frac{{x}^{2}}{6}+\\frac{{x}^{4}}{120}+⋯" 13194139534675 true] [17592186302738 1103 #edb/ref 17592186045453 13194139534675 true] [17592186302738 1111 #uuid "f860afd3-8ad9-566e-87aa-90c8cb