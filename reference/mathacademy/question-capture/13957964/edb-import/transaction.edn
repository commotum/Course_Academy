ned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-277921/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f"] :knowledge-point/questions ["q-277921"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115124/selection/bd1aa4167d2d5edb9e1b6d07ecd4523c63499171b0004259d3baaa40981f6957" :answer/id #uuid "6bf4ba50-2e6a-5c79-b044-946c8793b726" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/ensure [:answer/validate]} {:db/id "q-115124/selection/2d7143e678ec0dbccaad0c70713c672902244d083ed0703cd5924dd8b7ca53cd" :answer/id #uuid "9ab69723-4124-51c1-8a26-99a155e4819f" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-115124/selection/890ad7211615c83cf06b7df3adc34af6a46a2e044941a0a9002d9eb496ac0c92" :answer/id #uuid "b3511758-ceda-5811-b808-1a9017e77f22" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/ensure [:answer/validate]} {:db/id "q-115124/selection/a431a9e282d2319ed45f75ef2af999c9f038389e81be603ef2b2495fe792358f" :answer/id #uuid "9f5d08e9-a5a8-5b40-8683-2d9e7ed0fa29" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/ensure [:answer/validate]} {:db/id "q-115124/selection/44252c6a402153144a605d51f284bf55c999568ff86c1748f8ca52d1a3727f2d" :answer/id #uuid "4a34e8d7-aef1-5c9c-833d-fd39e67149e4" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-115124/selection" :answer-field/id #uuid "04ea4c3f-0ebe-503f-a8ab-a5f196a4632c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115124/selection/bd1aa4167d2d5edb9e1b6d07ecd4523c63499171b0004259d3baaa40981f6957" :answer-field/choices ["q-115124/selection/bd1aa4167d2d5edb9e1b6d07ecd4523c63499171b0004259d3b