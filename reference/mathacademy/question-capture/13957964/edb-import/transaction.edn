[{:db/id [:question/math-academy-id "q-7604"] :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=4$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-279101/field-1/3313490df59ea22935dff310f97224095569a5fdfc1108547b8de39d6340614b" :answer/id #uuid "baa35645-ef47-5f54-9b9e-4c07e364a093" :answer/type :answer.type/math :answer/value "\\frac{x^2}{64}+\\frac{y^2}{36}" :db/ensure [:answer/validate]} {:db/id "q-279101/field-1/61cc091254d4d8a0036e87438c4f6c9b540b7fa6ee164fc94f29da7333a4cff1" :answer/id #uuid "7416161e-e86b-5694-a527-5a696a385ede" :answer/type :answer.type/math :answer/value "\\frac{x^2}{8}+\\frac{y^2}{6}" :db/ensure [:answer/validate]} {:db/id "q-279101/field-1" :answer-field/id #uuid "cca126d1-3161-54e3-a5f5-e41fb4e883ac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279101/field-1/3313490df59ea22935dff310f97224095569a5fdfc1108547b8de39d6340614b" :answer-field/choices ["q-279101/field-1/3313490df59ea22935dff310f97224095569a5fdfc1108547b8de39d6340614b" "q-279101/field-1/61cc091254d4d8a0036e87438c4f6c9b540b7fa6ee164fc94f29da7333a4cff1"] :db/ensure [:answer-field/validate]} {:db/id "q-279101" :question/id #uuid "012b63f2-36d4-5ed9-a297-1a5f74a1ead6" :question/math-academy-id "q-279101" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13957964/assets/eb9c9b61de232ab6c190a3a324ff3ee2515c61f72a16e2814d