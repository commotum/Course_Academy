2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=25.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=25,$ the length of the vertical radius must be $b=\\sqrt{25}=5.$\n\nThus, the semi-major axis has length $b=5,$ and the semi-minor axis has length $a=2.$\n\nTherefore, the major axis has length $2b=2\\cdot 5=10,$ and the minor axis has length $2a=2\\cdot 2=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279169/field-1" "q-279169/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9"] :knowledge-point/questions ["q-279169"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115134/selection/f36770990f720d64e3d80647489d861c27f05ec071d9dcd9bcabaf02c6eb7896" :answer/id #uuid "c0784555-d64b-530f-a8ee-d99b128e6f0b" :answer/type :answer.type/text :answer/value "$7$ and $6$" :db/ensure [:answer/validate]} {:db/id "q-115134/selection/015d0a18ab2e8d937f09c2e398a4e8d44c732d30e207a7ce9e2029aa03555e1c" :answer/id #uuid "56dd600f-8737-5a97-af81-302fdbf3038c" :answer/type :answer.type/text :answer/value "$28$ and $24$" :db/ensure [:answer/validate]} {:db/id "q-115134/selection/1e959d3e0ad78b84eb4d420de9028e0bdc711331ffcfbde8192a8c732e202714" :answer/id #uuid "9fdb9382-5d19-542d-8947-5e8d5bde2cc1" :answer/type :answer.type/text :answer/value "$24.5$ and $18$" :db/ensure [:answer/validate]} {:db/id "q-115134/selection/aca90e473161c6513a9a981f0a46f588bcefa57fe8fb788375f0705d97182228" :answer/id #uuid "5edb0aa2-5781-5407-8c2c-8eb589de64b3" :answer/type :answer.type/text :answer/value "$49$ and $36$" :db/ensure [:answer/validate]} {:db/id "q-115134/selection/4693cce2c33b1b815bc3a1c14a23bab00e462a0c8e55976f6a91403f3bc87e16" :answer/id #uuid "ea6c0040-a1a8-5b8e-bea9-b287003e0e0e" :answer/type :answer.type/text :answer/value "$14$ and $12$" :db/ensure [:answer/validate]} {:db/id "q-115134/selection" :answe