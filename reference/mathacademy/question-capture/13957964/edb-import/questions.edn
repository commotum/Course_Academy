#{[{:db/id #edb/ref 17592186087450 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/id #uuid "446ea007-1ff4-5023-8e3f-7f00eb0fb2d0" :question/math-academy-id "e-5071" :question/problem "What is the equation of the ellipse given below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/848/Source/Images/e5e3e1baad54a5ce65047fbcb5e7a58d.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1\n$$\n\nHere, the horizontal radius has length $a=5$ and the vertical radius has length $b=3$. Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\n\\frac{x^{2}}{a^{2}} + \\frac{y^{2}}{b^{2}} &= 1 \\\\\n\\frac{x^{2}}{5^{2}} + \\frac{y^{2}}{3^{2}} &= 1 \\\\\n\\frac{x^{2}}{25} + \\frac{y^{2}}{9} &= 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087451 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/id #uuid "af56117c-65e0-5f12-9780-7a95e6be829e" :question/math-academy-id "e-5072" :question/problem "What is the equation of the ellipse given below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/848/Source/Images/10eddd924b3dc68fbf1bb4eaeb8f92c5.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1\n$$\n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=4$. Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\n\\frac{x^{2}}{a^{2}} + \\frac{y^{2}}{b^{2}} &= 1 \\\\\n\\frac{x^{2}}{2^{2}} + \\frac{y^{2}}{4^{2}} &= 1 \\\\\n\\frac{x^{2}}{4} + \\frac{y^{2}}{16} &= 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087452 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/id #uuid "b7c94673-f847-5977-9b9f-8d235ea42eb2" :question/math-academy-id "e-5073" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation $\\dfrac{x^2}{36} + \\dfrac{y^2}{25} = 1$?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1\n$$\n\nIn the given equation, we have $a^2=36$ and $b^2=25$.\n\n- Since $a^2=36$, the length of the horizontal radius must be $a=\\sqrt{36} = 6$.\n- Since $b^2=25$, the length of the vertical radius must be $b=\\sqrt{25} = 5$.\n\nSo the semi-major axis has length $a=6$, and the semi-minor axis has length $b=5$.\n\nTherefore, the major axis has length\n\n$$\n2a = 2 \\cdot 6 = 12\n$$\n\nand the minor axis has length\n\n$$\n2b = 2 \\cdot 5 =10\n$$"}] [{:db/id #edb/ref 17592186088268 :knowledge-point/_questions [{:knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/title "Determining the Equation of a Wide Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81292d50-5c51-5b38-89f0-949bc6b6a964" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{8} + \\frac{y^{2}}{2} = 1" :db/id #edb/ref 17592186086540} {:answer/id #uuid "0c18f3df-95fb-536c-8e2f-3029a38b2427" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2} + \\frac{y^{2}}{4} = 1" :db/id #edb/ref 17592186086541} {:answer/id #uuid "1e67014b-0d00-54c0-af93-fd3ae84e9b33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{4} + \\frac{y^{2}}{2} = 1" :db/id #edb/ref 17592186086542} {:answer/id #uuid "3c28a557-2851-503b-97be-c5d293379692" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{4} + \\frac{y^{2}}{16} = 1" :db/id #edb/ref 17592186086543} {:answer/id #uuid "7affd3de-ff29-5c52-853b-6c179253ff99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{16} + \\frac{y^{2}}{4} = 1" :db/id #edb/ref 17592186086544}] :answer-field/correct {:answer/id #uuid "7affd3de-ff29-5c52-853b-6c179253ff99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{16} + \\frac{y^{2}}{4} = 1" :db/id #edb/ref 17592186086544} :answer-field/id #uuid "92982adf-0bda-5979-982f-53887542631a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086539}] :question/id #uuid "808bb938-3f2e-5c94-82a4-205181f5d6ac" :question/math-academy-id "q-7604" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/848/Source/Images/q-7604.png)\n\nWhat is the equation of the ellipse given above?"}]}
