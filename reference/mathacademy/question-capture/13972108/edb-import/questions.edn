#{[{:db/id #edb/ref 17592186068509 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "659cb2ef-191b-54f0-b0b5-d872cfd781bc" :question/math-academy-id "e-5061" :question/problem "Given the graph below, solve the inequality $(x+2)(1-x) \\geq 0$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/7f86e2d3365b5b2d8c7d4529af5e4b74.png)" :question/worked-solution "Notice that our inequality\n\n$$\n(x+2)(1-x) \\geq 0\n$$\n\nis a \"*greater than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny = (x+2)(1-x)\n$$\n\nis *above* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/210002d3cf31f38ff05cfb4d2c8facd8.png)\n\nSo, the solution to the inequality is\n\n$$\n-2 \\leq x \\leq 1\n$$"}] [{:db/id #edb/ref 17592186068597 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "b75cf4ed-e93b-589c-88ed-1a277273945c" :question/math-academy-id "e-9935" :question/problem "Given the graph below, solve the inequality $x^2- 3x-10 >0$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/c26583fa9f6c7acbaccf7857b267dc1c.png)" :question/worked-solution "Notice that our inequality\n\n$$\nx^2 -3x -10> 0\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny =x^2 -3x -10\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/3f7b1ac593e390153a762ca37cf339f6.png)\n\nSo, the solution to the inequality is $x < -2$ or $x > 5$."}] [{:db/id #edb/ref 17592186068598 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "36d4bf37-4818-58ac-9e39-75ce8ceef06a" :knowledge-point/title "Solving a \"Less Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "58407228-e1f1-5d75-8786-a604caea671a" :question/math-academy-id "e-9975" :question/problem "Given the graph below, solve the inequality $-x^2+2x+3 \\leq 0$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/e5447e5aa012a36be7ea03184d2d92e7.png)" :question/worked-solution "Notice that our inequality\n\n$$\n-x^2+2x+3 \\leq 0\n$$\n\nis a \"*less than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny =-x^2+2x+3\n$$\n\nis *below* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/0dd92f7bab40acea832ee8b4ca514994.png)\n\nSo, the solution to the inequality is\n\n$$\nx \\leq -1\n$$\n\nor\n\n$$\nx \\geq 3\n$$"}] [{:db/id #edb/ref 17592186068599 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fc419917-fe34-5bf9-8bf0-1b022fce11ff" :knowledge-point/title "Solving a \"Less Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "f84c11bc-b14f-5285-a782-2130d31f9e49" :question/math-academy-id "e-9976" :question/problem "Given the graph below, solve the inequality $-(x+2)(x-1) < 0$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/204af430d9ba7f6fa3f62a4c2abb7879.png)" :question/worked-solution "Notice that our inequality\n\n$$\n-(x+2)(x-1) < 0\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny = -(x+2)(x-1)\n$$\n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/75f69e4ae829fa9d8e57646ed3e3d4bf.png)\n\nSo, the solution to the inequality is $x< -2$ or $x > 1$."}] [{:db/id #edb/ref 17592186069099 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8505bc4e-15e1-5ecd-b89c-3e88cb6680ee" :answer/type {:db/ident :answer.type/math} :answer/value "x \\le - 2" :db/id #edb/ref 17592186066185} {:answer/id #uuid "8f0d00dc-611f-59a6-aad5-875425511382" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ge 3" :db/id #edb/ref 17592186066186} {:answer/id #uuid "bd20652b-7ff0-5c4c-aa73-bc40c4951725" :answer/type {:db/ident :answer.type/text} :answer/value "$x \\le - 2$ or $x \\ge 3$" :db/id #edb/ref 17592186066187} {:answer/id #uuid "3a1ebe7c-edde-5972-b972-da4f559232d5" :answer/type {:db/ident :answer.type/math} :answer/value "-2 \\le x \\le 3" :db/id #edb/ref 17592186066188} {:answer/id #uuid "3ca62eb0-7b4f-59b0-8ece-c5c7e9df04b8" :answer/type {:db/ident :answer.type/math} :answer/value "-3 \\le x \\le 2" :db/id #edb/ref 17592186066189}] :answer-field/correct {:answer/id #uuid "bd20652b-7ff0-5c4c-aa73-bc40c4951725" :answer/type {:db/ident :answer.type/text} :answer/value "$x \\le - 2$ or $x \\ge 3$" :db/id #edb/ref 17592186066187} :answer-field/id #uuid "6e37e467-9dec-5cab-873c-91e61bcb3d51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066184}] :question/id #uuid "ffe39127-4650-5f93-972b-bb5efc38f550" :question/math-academy-id "q-24351" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/468/Source/Images/q-24351.png)\n\nGiven the graph above, solve the inequality $(x + 2)(x - 3) \\ge 0$."}] [{:db/id #edb/ref 17592186069152 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a 