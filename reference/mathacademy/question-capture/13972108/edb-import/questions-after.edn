#{[{:db/id #edb/ref 17592186068509 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "659cb2ef-191b-54f0-b0b5-d872cfd781bc" :question/math-academy-id "e-5061" :question/problem "Given the graph below, solve the inequality $(x+2)(1-x) \\geq 0.$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/f1beeeb1247e21e6ebf442f8f9171320674d760551fe715afa98047be78db2bc.png)" :question/worked-solution "Notice that our inequality\n\n$$\n(x+2)(1-x) \\geq 0\n$$\n\nis a \"*greater than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny = (x+2)(1-x)\n$$\n\nis *above* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/ae3c40faa7e89979c135c06adf944aa46ec01564c556becaea725412d3b2560c.png)\n\nSo, the solution to the inequality is $-2 \\leq x \\leq 1.$"}] [{:db/id #edb/ref 17592186068597 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "b75cf4ed-e93b-589c-88ed-1a277273945c" :question/math-academy-id "e-9935" :question/problem "Given the graph below, solve the inequality $x^2- 3x-10 >0.$    \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/bb4b28c1fbc4e166f22acf62ae4ab11cdab0ee07c2c4af080db0bf7e290744aa.png)" :question/worked-solution "Notice that our inequality\n\n$$\nx^2 -3x -10> 0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny =x^2 -3x -10\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/ca22e171b36e21802769e3612a163d29b01209af1ef75887a65ab6013bb1401a.png)\n\nSo, the solution to the inequality is $x < -2$ or $x >   5.$"}] [{:db/id #edb/ref 17592186068598 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "36d4bf37-4818-58ac-9e39-75ce8ceef06a" :knowledge-point/title "Solving a \"Less Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "58407228-e1f1-5d75-8786-a604caea671a" :question/math-academy-id "e-9975" :question/problem "Given the graph below, solve the inequality $-x^2+2x+3 \\leq 0.$    \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/93fa79fb8411a6bdf16b3eb9c1aab489377a9b0d039b0be4b884f8cdc47bf683.png)" :question/worked-solution "Notice that our inequality\n\n$$\n-x^2+2x+3 \\leq 0,\n$$\n\nis a \"*less than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny =-x^2+2x+3\n$$\n\nis *below* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/6b11e0ab1c3cd92003d3b5330b4eab64e192efbe1953cfbc560b717ccc0e3c57.png)\n\nSo, the solution to the inequality is $x \\leq -1$ or $x \\geq 3.$"}] [{:db/id #edb/ref 17592186068599 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fc419917-fe34-5bf9-8bf0-1b022fce11ff" :knowledge-point/title "Solving a \"Less Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/id #uuid "f84c11bc-b14f-5285-a782-2130d31f9e49" :question/math-academy-id "e-9976" :question/problem "Given the graph below, solve the inequality $-(x+2)(x-1) <  0.$      \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/c764652658e603142d22e4a9ec02c59c2143bd4d5df2a38d6d6e7dd629ccf88b.png)" :question/worked-solution "Notice that our inequality\n\n$$\n-(x+2)(x-1) <   0,\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny = -(x+2)(x-1)\n$$\n\n   \n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972108/assets/cb3adba60c427e4f68bf756301a9b101ce17ca32adb8ea6ba9f3b492cccce2cc.png)\n\nSo, the solution to the inequality is $x<    -2$ or    $x >  1.$"}] [{:db/id #edb/ref 17592186276319 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1181fa36-59a5-52c4-88b2-42c777a41278" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le -5$ or $x\\ge 2$" :db/id #edb/ref 17592186276321} {:answer/id #uuid "77af28a3-ea44-5a69-8380-f59e37b5a901" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\le x\\le 5" :db/id #edb/ref 17592186276322} {:answer/id #uuid "62e312d4-2328-538d-bef6-ba420cc359e5" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\le x\\le 2" :db/id #edb/ref 17592186276323} {:answer/id #uuid "604c2220-6db7-5f5f-a0b7-33b09f25a19d" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 5" :db/id #edb/ref 17592186276324} {:answer/id #uuid "d833f320-9115-5581-9087-27346fcf5ad2" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le -2$ or $x\\ge 5$" :db/id #edb/ref 17592186276325}] :answer-field/correct {:answer/id #uuid "77af28a3-ea44-5a69-8380-f59e37b5a901" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\le x\\le 5" :db/id #edb/ref 17592186276322} :answer-field/id #uuid "5f86dc08-430f-586d-94