ure-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y+2\\operatorname{sin}⁡x.\n$$\n\n \n\nGiven that the point $P(\\pi ,1)$ lies on the graph of the function, evaluate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(3y+2\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3y)+\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3\\frac{\\text{d}y}{\\text{d}x}+2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3\\frac{\\text{d}y}{\\text{d}x}+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3(3y+2\\operatorname{sin}⁡x)+2\\operatorname{cos}⁡x \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =9y+6\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi ,1)} & ={(9y+6\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)|}_{(\\pi ,1)} \\\\  & =9(1)+6\\operatorname{sin}⁡(\\pi )+2\\operatorname{cos}⁡(\\pi ) \\\\  & =9-2 \\\\  & =7\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/activity-metadata.json" "file_sha256" "a3ba25409e04db5f5e21eb39a8e2f3b5251bf45daabc994ed203836df03b6405" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "7"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89878" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "9"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y-4\\operatorname{cos}⁡x.\n$$\n\nGiven that the point $(\\frac{\\pi }{2},0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f$\n- $(\\frac{\\pi }{2},0)$ is a local maximum point of the function $f$\n- $(\\frac{\\pi }{2},0)$ is an inflection point of the function $f$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" nil "attribute" "question/worked-solution" "value" "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(\\frac{\\pi }{2},0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)} & ={(y-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y-4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}+4\\operatorname{sin}⁡x \\\\  & =(y-4\\operatorname{cos}⁡x)+4\\operatorname{sin}⁡x \\\\  & =y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)} & ={(y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0+4\\operatorname{sin}⁡(\\frac{\\pi }{2})-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0+4-0 \\\\  & =4\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)}=0,\n$$\n\nwe obtain that $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(\\frac{\\pi }{2},0).$ So, according to the second derivative test, since \n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)}>0,\n$$\n\n \nwe have a local minimum (not a local maximum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(\\frac{\\pi }{2},0).$\n\nTherefore, the correct answer is \"I only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/activity-metadata.json" "file_sha256" "a3ba25409e04db5f5e21eb39a8e2f3b5251bf45daabc994ed203836df03b6405" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"} {"question" "q-89888" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "None of those listed"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/state.json" "file_sha256" "b8653792ef8fcb9bd5bc153cb0030a6f37488ef2159a4c40bfbf014d7bab3edd" "basis" 1390 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039828/edb-import/verification.json"}] "sources" [{"question" "q-89872" "field" nil "attribute" "question/problem" "value" "Consider the solution curves of the differential equation ${y}^{′}-{x}^{3}={y}^{2}-2x.$ Which of the following points are stationary points of their respective solution curve?\n\n- $(-1,-1)$\n- $(0,0)$\n- $(1,1)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89872" "field" nil "attribute" "question/worked-solution" "value" "Recall that a stationary point of $y(x)$ is a point $x=c$ in the domain of $y$ such that ${y}^{′}(c)=0.$ \n\nFirst, we make ${y}^{′}$ the subject of the equation.\n\n$$\n\\begin{aligned}{y}^{′}-{x}^{3}={y}^{2}-2x\\,⟹\\,{y}^{′}={x}^{3}+{y}^{2}-2x\\end{aligned}\n$$\n\nNow, we substitute the coordinates of our points into the differential equation and calculate the value of the derivative: \n\n$$\n\\begin{aligned}{{y}^{′}|}_{(-1,-1)} & ={({x}^{3}+{y}^{2}-2x)|}_{(-1,-1)} \\\\  & =(-1)^{3}+(-1)^{2}-2(-1) \\\\  & =2 \\\\  & \\ne 0\\,\\times  \\\\ {{y}^{′}|}_{(0,0)} & ={({x}^{3}+{y}^{2}-2x)|}_{(0,0)} \\\\  & =(0)^{3}+(0)^{2}-2(0) \\\\  & =0\\,✓ \\\\ {{y}^{′}|}_{(1,1)} & ={({x}^{3}+{y}^{2}-2x)|}_{(1,1)} \\\\  & =(1)^{3}+(1)^{2}-2(1) \\\\  & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89872" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/activity-metadata.json" "file_sha256" "f3a5a9413d83561163f39d9fef7643b08c289c321bed48d342c6c79512d3fa33"} {"question" "q-89872" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89872" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89872" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89877" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y+{e}^{x}.\n$$\n\n \n\nGiven that the point $P(-1,0)$ lies on the graph of the function, evaluate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89877" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(y+{e}^{x}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(y)+\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}y}{\\text{d}x}+{e}^{x}\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =(y+{e}^{x})+{e}^{x} \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =y+2{e}^{x}\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1,0)} & ={(y+2{e}^{x})|}_{(-1,0)} \\\\  & =0+2{e}^{-1} \\\\  & =2{e}^{-1}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89877" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/activity-metadata.json" "file_sha256" "f3a5a9413d83561163f39d9fef7643b08c289c321bed48d342c6c79512d3fa33"} {"question" "q-89877" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89877" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2{e}^{-1}"] ["math" "3"] ["math" "e"] ["math" "{e}^{-1}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89877" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2{e}^{-1}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89878" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y+2\\operatorname{sin}⁡x.\n$$\n\n \n\nGiven that the point $P(\\pi ,1)$ lies on the graph of the function, evaluate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89878" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(3y+2\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3y)+\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3\\frac{\\text{d}y}{\\text{d}x}+2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3\\frac{\\text{d}y}{\\text{d}x}+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =3(3y+2\\operatorname{sin}⁡x)+2\\operatorname{cos}⁡x \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =9y+6\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi ,1)} & ={(9y+6\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x)|}_{(\\pi ,1)} \\\\  & =9(1)+6\\operatorname{sin}⁡(\\pi )+2\\operatorname{cos}⁡(\\pi ) \\\\  & =9-2 \\\\  & =7\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89878" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/activity-metadata.json" "file_sha256" "f3a5a9413d83561163f39d9fef7643b08c289c321bed48d342c6c79512d3fa33"} {"question" "q-89878" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89878" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "3"] ["math" "4"] ["math" "7"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89878" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89886" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y-x.\n$$\n\nGiven that the point $(0,0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(0,0)$ is a stationary point of the function $f$\n- $(0,0)$ is a local minimum point of the function $f$\n- $(0,0)$ is an inflection point of the function $f$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89886" "field" nil "attribute" "question/worked-solution" "value" "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,0)} & ={(y-x)|}_{(0,0)} \\\\  & =0-0 \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}-1 \\\\  & =(y-x)-1 \\\\  & =y-x-1 \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)} & ={(y-x-1)|}_{(0,0)} \\\\  & =0-0-1 \\\\  & =-1 \\\\  & <0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,0)}=0,\n$$\n\nwe obtain that $(0,0)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(0,0).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)}<0,\n$$\n\nwe have a local maximum (not a local minimum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(0,0).$\n\nTherefore, the correct answer is \"I only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89886" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/activity-metadata.json" "file_sha256" "f3a5a9413d83561163f39d9fef7643b08c289c321bed48d342c6c79512d3fa33"} {"question" "q-89886" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89886" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "I, II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89886" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89888" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y-4\\operatorname{cos}⁡x.\n$$\n\nGiven that the point $(\\frac{\\pi }{2},0)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f$\n- $(\\frac{\\pi }{2},0)$ is a local maximum point of the function $f$\n- $(\\frac{\\pi }{2},0)$ is an inflection point of the function $f$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89888" "field" nil "attribute" "question/worked-solution" "value" "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(\\frac{\\pi }{2},0),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)} & ={(y-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y-4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}+4\\operatorname{sin}⁡x \\\\  & =(y-4\\operatorname{cos}⁡x)+4\\operatorname{sin}⁡x \\\\  & =y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)} & ={(y+4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x)|}_{(\\pi /2,0)} \\\\  & =0+4\\operatorname{sin}⁡(\\frac{\\pi }{2})-4\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =0+4-0 \\\\  & =4\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(\\pi /2,0)}=0,\n$$\n\nwe obtain that $(\\frac{\\pi }{2},0)$ is a stationary point of the function $f.$\n\n- Statement II is false. There is a critical point at $(\\frac{\\pi }{2},0).$ So, according to the second derivative test, since \n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(\\pi /2,0)}>0,\n$$\n\n \nwe have a local minimum (not a local maximum) at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(\\frac{\\pi }{2},0).$\n\nTherefore, the correct answer is \"I only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89888" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/activity-metadata.json" "file_sha256" "f3a5a9413d83561163f39d9fef7643b08c289c321bed48d342c6c79512d3fa33"} {"question" "q-89888" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89888" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "III only"] ["text" "None of those listed"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"} {"question" "q-89888" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053755/state.json" "file_sha256" "ffc7dab6d608033b11202bcc3a3ad60711d44f02af6a58d46cd1c3c98f9383aa"}] "usage" {"q-89872" [] "q-89878" [] "q-89888" []} "basis" 1786 "retractions" [] "immutable_answers" [17592186304361 17592186304362 17592186304363 17592186304364 17592186304365 17592186304368 17592186304369 17592186304370 17592186304371 17592186304372 17592186304375 17592186304376 17592186304377 17592186304378 17592186304379] "immutable_fields" [[17592186304360 :answer-field/correct] [17592186304360 :answer-field/id] [17592186304360 :answer-field/key] [17592186304360 :answer-field/type] [17592186304367 :answer-field/correct] [17592186304367 :answer-field/id] [17592186304367 :answer-field/key] [17592186304367 :answer-field/type] [17592186304374 :answer-fi