#{[{:db/id #edb/ref 17592186063969 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/is-example true :question/math-academy-id "e-382" :question/problem "Calculate $\\displaystyle \\int 3\\sin{x}\\,\\textrm d x$." :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\int3\\sin xdx &= 3\\int\\sin xdx \\\\\n&= 3(-\\cos x) + C \\\\\n&=-3\\cos x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063970 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/is-example true :question/math-academy-id "e-383" :question/problem "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x$." :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx =-\\csc x + C\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\int(-\\csc x\\cot x)dx &= -\\int(\\csc x\\cot x)dx \\\\\n&= - (-\\csc x) + C \\\\\n&= \\csc x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063971 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/id #uuid "3d2bde25-f8dc-5e62-9999-6593424f0ae2" :question/is-example true :question/math-academy-id "e-384" :question/problem "Calculate the integral $\\displaystyle{\\displaystyle \\int} (2\\sec^2 x + \\sec x \\tan x)\\, \\textrm{d}x$." :question/worked-solution "Recall that\n\n$$\n\\int \\sec^2 x \\, \\textrm dx = \\tan x + C\n$$\n\nand\n\n$$\n\\int \\sec x \\tan x \\, \\textrm dx = \\sec x + C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned} \\int (2\\sec^2 x + \\sec x \\tan x)\\, \\textrm{d}x& = 2 \\int \\sec^2 x \\, \\textrm{d}x+ \\int \\sec x \\tan x \\, \\textrm{d}x \\\\ &=2\\tan x + \\sec x + C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063972 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/is-example true :question/math-academy-id "e-385" :question/problem "Calculate the integral $\\displaystyle{\\displaystyle \\int} \\csc{x}(\\csc{x}+3\\cot{x})\\, \\textrm{d}x$." :question/worked-solution "Recall that\n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n\\int\\csc x(\\csc x + 3\\cot x)dx &= \\int\\csc^{2} x + 3\\csc x\\cot xdx \\\\\n&= \\int\\csc^{2} xdx + 3\\int\\csc x\\cot xdx \\\\\n&=-\\cot x - 3\\csc x + C\n\\end{aligned}\n$$"}]}
