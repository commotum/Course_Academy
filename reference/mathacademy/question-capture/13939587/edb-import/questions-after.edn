#{[{:db/id #edb/ref 17592186063969 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/is-example true :question/math-academy-id "e-382" :question/problem "Calculate $\\displaystyle \\int 3\\sin{x}\\,\\textrm d x$." :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\int3\\sin xdx &= 3\\int\\sin xdx \\\\\n&= 3(-\\cos x) + C \\\\\n&=-3\\cos x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063970 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/is-example true :question/math-academy-id "e-383" :question/problem "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x$." :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx =-\\csc x + C\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\int(-\\csc x\\cot x)dx &= -\\int(\\csc x\\cot x)dx \\\\\n&= - (-\\csc x) + C \\\\\n&= \\csc x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063971 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/id #uuid "3d2bde25-f8dc-5e62-9999-6593424f0ae2" :question/is-example true :question/math-academy-id "e-384" :question/problem "Calculate the integral $\\displaystyle{\\displaystyle \\int} (2\\sec^2 x + \\sec x \\tan x)\\, \\textrm{d}x$." :question/worked-solution "Recall that\n\n$$\n\\int \\sec^2 x \\, \\textrm dx = \\tan x + C\n$$\n\nand\n\n$$\n\\int \\sec x \\tan x \\, \\textrm dx = \\sec x + C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned} \\int (2\\sec^2 x + \\sec x \\tan x)\\, \\textrm{d}x& = 2 \\int \\sec^2 x \\, \\textrm{d}x+ \\int \\sec x \\tan x \\, \\textrm{d}x \\\\ &=2\\tan x + \\sec x + C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063972 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/is-example true :question/math-academy-id "e-385" :question/problem "Calculate the integral $\\displaystyle{\\displaystyle \\int} \\csc{x}(\\csc{x}+3\\cot{x})\\, \\textrm{d}x$." :question/worked-solution "Recall that\n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\n\\int\\csc x(\\csc x + 3\\cot x)dx &= \\int\\csc^{2} x + 3\\csc x\\cot xdx \\\\\n&= \\int\\csc^{2} xdx + 3\\int\\csc x\\cot xdx \\\\\n&=-\\cot x - 3\\csc x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248023 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52946635-ae73-5411-8f78-2b007305e95c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}cos⁡\\theta +C" :db/id #edb/ref 17592186248025} {:answer/id #uuid "f02e4af3-2274-52fb-b5d4-6e510852ca6a" :answer/type {:db/ident :answer.type/math} :answer/value "-6sin⁡\\theta +C" :db/id #edb/ref 17592186248026} {:answer/id #uuid "d9602e51-4a76-5079-acbc-bfd1ae550321" :answer/type {:db/ident :answer.type/math} :answer/value "6sin⁡\\theta +C" :db/id #edb/ref 17592186248027} {:answer/id #uuid "3eb6c978-a2b4-54e6-a0dd-8dc397c54480" :answer/type {:db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186248028} {:answer/id #uuid "16ab691a-88dc-54d3-8acf-3520ccb40ab4" :answer/type {:db/ident :answer.type/math} :answer/value "-6cos⁡\\theta +C" :db/id #edb/ref 17592186248029}] :answer-field/correct {:answer/id #uuid "3eb6c978-a2b4-54e6-a0dd-8dc397c54480" :answer/type {:db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186248028} :answer-field/id #uuid "d816fd0a-f58e-5191-9a98-abfecbefc8ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248024}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "79c79205-7e7a-5865-98f6-12a459ed75cd" :question/is-example false :question/math-academy-id "q-113907" :question/problem "$\\int (-6sin⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sin⁡\\theta \\,\\text{d}\\theta =-cos⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-6sin⁡\\theta )\\,\\text{d}\\theta  & =-6\\int sin⁡\\theta \\,\\text{d}\\theta  \\\\  & =-6(-cos⁡\\theta )+C \\\\  & =6cos⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248030 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5fb2828-2191-5c37-83a7-1eec6f30930e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}sin⁡y+C" :db/id #edb/ref 17592186248032} {:answer/id #uuid "3b7d83c0-bb71-5a47-a720-941c012c8a6d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}sin⁡y+C" :db/id #edb/ref 17592186248033} {:answer/id #uuid "5bb6c5fa-1be4-537f-b5eb-5dc77f1b9488" :answer/type {:db/ident :answer.type/math} :answer/value "5cos⁡y+C" :db/id #edb/ref 17592186248034} {:answer/id #uuid "8ef88d94-d932-5e9b-9dbf-0c334fd696a9" :answer/type {:db/ident :answer.type/math} :answer/value "5sin⁡y+C" :db/id #edb/ref 17592186248035} {:answer/id #uuid "0464adb7-11ff-5b75-9403-98431a725475" :answer/type {:db/ident :answer.type/mat