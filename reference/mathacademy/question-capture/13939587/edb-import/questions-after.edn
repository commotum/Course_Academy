 {:answer/id #uuid "31f42023-59f5-5381-8d13-63cd2a83fb1a" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-3cos⁡x+C" :db/id #edb/ref 17592186248040} :answer-field/id #uuid "4fead7fd-a6d3-53a1-bac0-060f54699504" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248038}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f2b823d7-3e58-57f8-851c-a34340567766" :question/is-example false :question/math-academy-id "q-113909" :question/problem "$\\int (2cos⁡x+3sin⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2cos⁡x+3sin⁡x)\\,\\text{d}x & =2\\int cos⁡x\\,\\text{d}x+3\\int sin⁡x\\,\\text{d}x \\\\  & =2sin⁡x+3(-cos⁡x)+C \\\\  & =2sin⁡x-3cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248044 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1c2502-a0b1-5868-be94-010b9dd46826" :answer/type {:db/ident :answer.type/math} :answer/value "3sec⁡x+C" :db/id #edb/ref 17592186248046} {:answer/id #uuid "846992f5-4205-5249-910d-b5622b1be9e9" :answer/type {:db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248047} {:answer/id #uuid "b27e698c-556e-5cc1-9fb7-78791abda4c5" :answer/type {:db/ident :answer.type/math} :answer/value "3sec⁡xcot⁡x+C" :db/id #edb/ref 17592186248048} {:answer/id #uuid "6c7b3296-b553-5620-ae89-cfcbe319e7b6" :answer/type {:db/ident :answer.type/math} :answer/value "-3csc⁡x+C" :db/id #edb/ref 17592186248049} {:answer/id #uuid "dc827998-7f71-576f-9abc-403bcaf958c4" :answer/type {:db/ident :answer.type/math} :answer/value "-3sec⁡x+C" :db/id #edb/ref 17592186248