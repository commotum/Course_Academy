⁡x\\,\\text{d}x+\\int 2{csc}^{2}⁡x\\,\\text{d}x \\\\  & =3\\int csc⁡xcot⁡x\\,\\text{d}x+2\\int {csc}^{2}⁡x\\,\\text{d}x \\\\  & =3(-csc⁡x)+2(-cot⁡x)+C \\\\  & =-3csc⁡x-2cot⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49121/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d"] :knowledge-point/questions ["q-49121"] :db/ensure [:knowledge-point/validate]}]
