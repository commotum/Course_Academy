d-2ee9-55d3-8ba3-33ff2e6119a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64020/selection/9f1947020dbec5c5051e38a95758f0f5784d2e8c2c190ef0d35dcd9f91836421" :answer-field/choices ["q-64020/selection/2c81482234932a6b65363d893395586ba232483a2019f2f92ccc3c422ae9f590" "q-64020/selection/94d371a39a4fe899ae86e49ef23f40217749816e5f513482d1b227648438b197" "q-64020/selection/9f1947020dbec5c5051e38a95758f0f5784d2e8c2c190ef0d35dcd9f91836421" "q-64020/selection/cc4a2a7e94688e4a1186f1890dd382d32c7e9c076206efb6497bc4aee8644609" "q-64020/selection/9bd048de2eb07723e1311a7f5e54a1500e6d36ab33f9ca35ee471f015e9e90f8"] :db/ensure [:answer-field/validate]} {:db/id "q-64020" :question/id #uuid "8a7533fa-9ecc-5c43-b4ae-5837f068bca8" :question/math-academy-id "q-64020" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $8x-4y<12?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}8x-4y & <12 \\\\ -4y & <-8x+12 \\\\ 4y & >8x-12 \\\\ y & >2x-3\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line $y=2x-3.$ Since the inequality involves a 'strictly greater than' sign, the line $y=2x-3$ itself is *not* part of the solution. Therefore, we draw a dashed line.\n\nThen, we need to decide whether to shade above or below the line. The inequality $y>2x-3$ refers to the $y$-values that are *greater than* those on the line $y=2x-3,$ so we shade *above* the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/d399f186d02b777d8b6774833cd9e0855de5f228b1e6872027d7909d2e6dbe6f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64020/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9ceefc-3aa8-5c13-90a1-e4a084f720cc"] :knowledge-point/questions ["q-64020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142097/selection/3ca574720da467ce5501beeb61d80beb3ceea2ab186e4cb89ff367dd8c1828d9" :answer/id #uuid "85fd2ac2-9e10-5d68-9347-cc87629137ea" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/9e6af7aceed6e31bccd5f568d50ac1c897b98cc568d383ea559a8b61abc203e7.png" :db/ensure [:answer/validate]} {:db/id "q-142097/selection/557ef1a5bf1ddc33b65e43d442f47ffeb0e76169190d3f69f96000e8e2fa1141" :answer/id #uuid "f8b1afc0-61aa-5f26-b113-daeb8d01ee71" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/1cc25938438d7ef2ad77bd5047a1417e5c0dba609e630bde7c3dee9dffa205ba.png" :db/ensure [:answer/validate]} {:db/id "q-142097/selection/2d6c6c5937cd7f60a823e5e5e8feb46dc6adc5337c7f52141ada3b2163d483aa" :answer/id #uuid "a46ce7eb-5748-585d-960b-3cb5b8654049" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/1497c291a9a068a414503d3081f52c5df56019d496a3f6c16cc905e6a20b97fe.png" :db/ensure [:answer/validate]} {:db/id "q-142097/selection/ad561081ffd7791261bac9310d89418d0922ab268692f56e46c221e30b688248" :answer/id #uuid "c49089de-1331-503a-9c8a-66650785a75a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/9febb7b2ffb18d3d4d1ea5976fb0de6ee164689d01d82cf89dfb83000febffb1.png" :db/ensure [:answer/validate]} {:db/id "q-142097/selection/9f1947020dbec5c5051e38a95758f0f5784d2e8c2c190ef0d35dcd9f91836421" :answer/id #uuid "33578693-938f-5119-8aff-8c8ab6acf599" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/07de9cd8bb359093767ba2dfe9e762ca602d97dbe7b1217541fe4b5017675162.png" :db/ensure [:answer/validate]} {:db/id "q-142097/selection" :answer-field/id #uuid "a0e79566-0f3e-5233-a3f1-b33af357af0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-142097/selection/9f1947020dbec5c5051e38a95758f0f5784d2e8c2c190ef0d35dcd9f91836421" :answer-field/choices ["q-142097/selection/3ca574720da467ce5501beeb61d80beb3ceea2ab186e4cb89ff367dd8c1828d9" "q-142097/selection/557ef1a5bf1ddc33b65e43d442f47ffeb0e76169190d3f69f96000e8e2fa1141" "q-142097/selection/2d6c6c5937cd7f60a823e5e5e8feb46dc6adc5337c7f52141ada3b2163d483aa" "q-142097/selection/ad561081ffd7791261bac9310d89418d0922ab268692f56e46c221e30b688248" "q-142097/selection/9f1947020dbec5c5051e38a95758f0f5784d2e8c2c190ef0d35dcd9f91836421"] :db/ensure [:answer-field/validate]} {:db/id "q-142097" :question/id #uuid "1cee14fe-e375-5314-aab5-fe2b10bd1948" :question/math-academy-id "q-142097" :question/problem "Which of the following shaded areas describes the region bounded by the inequality $4x-2y<6?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}4x-2y & <6 \\\\ -2y & <-4x+6 \\\\ 2y & >4x-6 \\\\ y & >2x-3\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line \n\n$$\ny=2x-3.\n$$\n\n Since the inequality involves a 'strictly greater than' sign, the line $y=2x-3$ itself is *not* part of the solution. Therefore, we draw a **dashed line**.\n\nThen, we need to decide whether to shade above or below the line. The inequality \n\n$$\ny>2x-3\n$$\n\n refers to the $y$-values that are *greater than* those on the line $y=2x-3,$ so we shade *above* the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/2fe69dace2487c1b6dc73fcd122fd358513d8ac9528b3195d2075f8b62c75b4a.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-142097/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9ceefc-3aa8-5c13-90a1-e4a084f720cc"] :knowledge-point/questions ["q-142097"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64021"] :question/problem "Which of the following shaded areas describes the region bounded by the inequality $x-y<3?$" :question/worked-solution "First, we convert the inequality into slope-intercept form:\n\n$$\n\\begin{aligned}x-y & <3 \\\\ -y & <-x+3 \\\\ y & >x-3\\end{aligned}\n$$\n\nNow, we proceed as usual. We start by drawing the corresponding straight line \n\n$$\ny=x-3.\n$$\n\n Since the inequality involves a 'strictly greater than' sign, the line $y=x-3$ itself is *not* part of the solution. Therefore, we draw a **dashed line**.\n\nThen, we need to decide whether to shade above or below the line. The inequality \n\n$$\ny>x-3\n$$\n\n refers to the $y$-values that are *greater than* those on the line $y=x-3,$ so we shade *above* the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/77a4c9b6bc705a2fbf486bfef5a6ce57924aae86c4abf1510040c7957b873329.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-109942/selection/88855cc3fbabefd525bb4d1f01f936be108a6d3e132cd8f073dfec2e4933688d" :answer/id #uuid "1780ed63-0950-59cc-97d0-725d4da92b8a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/ebf7fd57f5d07afebc22899418ce34d14e59dcdb2a01087950de675b7086f405.png" :db/ensure [:answer/validate]} {:db/id "q-109942/selection/734ab262bb5d37ea4497dc092ed6b35037666b05604ea5d3d462b98296ad1de4" :answer/id #uuid "239033c2-0a8b-51a0-b255-a4f2efa1928f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996642/assets/a16d99b349797e305083d8295ef098fbfbe3ea82970b5a48606ea5c678e08262.png" :db/ensure [:answer/validate]} {:db/id "q-109942/selection/fbcc96d800cfb5948139f383b3da0bbb47adfb99765b3f7412a3d34a2c3018cf" :answer/id #