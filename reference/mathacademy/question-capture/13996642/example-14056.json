  "html": "<div id=\"step-e14056\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Inequalities Involving Horizontal and Vertical Lines</div>       \n                        <div class=\"helpButton\" stepid=\"e14056\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>Find the inequality that describes the shaded region shown below.</p>\n<div id=\"graphic-43fad45f1d96c5e8626ab609a68bfd59\" class=\"graphic\"><img src=\"/graphics/43fad45f1d96c5e8626ab609a68bfd59\"></div>\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n