 \\\\ 112-108-70 & =B(11)(6) \\\\ B & =\\frac{-66}{66} \\\\ B & =-1.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}7(-2)^{2}-27(-2)-70 & =A(4-(-2))((-2)+2) \\\\  & \\,+B(2(-2)+3)((-2)+2) \\\\  & \\,+C(2(-2)+3)(4-(-2)) \\\\ 28+54-70 & =C(-1)(6) \\\\ C & =\\frac{12}{-6} \\\\ C & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=-5+(-1)+(-2)=-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255604 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06960a75-d1ce-50a8-9a33-202c43aa40bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186255606} {:answer/id #uuid "9e70aa43-3f02-5a25-b9a1-c1a0e5bd33f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{(4x-1)}-\\frac{4}{(x+3)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186255607} {:answer/id #uuid "db5a7151-9f02-547e-92f8-505a5f2ad40a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{(4x-1)}-\\frac{1}{(x+3)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186255608} {:answer/id #uuid "f849c5f2-c66b-55e9-9ccc-4a285b0320aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}+\\frac{6}{(x+3)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186255609} {:answer/id #uuid "886cc596-c9c0-5bad-ad8c-a0e113d52281" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(4x-1)}-\\frac{6}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186255610}] :answer-field/correct {:answer/id #uuid "06960a75-d1ce-50a8-9a33-202c43aa40bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}" :db/id #edb/ref 17592186255606} :answer-field/id #uuid "48b720b7-ca39-5caa-b2b7-fa823bcefcb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255605}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2342f685-c172-5848-82b1-5cf6c2c6a23b" :question/math-academy-id "q-69820" :question/problem "Express $\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)} & =\\frac{A}{(4x-1)}+\\frac{B}{(x+3)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(4x-1)(x+3)(x+1)$ gives\n\n$$\n-2{x}^{2}+29x+1=A(x+3)(x+1)+B(4x-1)(x+1)+C(4x-1)(x+3).\n$$\n\nFor $x=\\frac{1}{4}$, we get \n\n$$\n\\begin{aligned}-2{(\\frac{1}{4})}^{2}+29(\\frac{1}{4})+1 & =A(\\frac{1}{4}+3)(\\frac{1}{4}+1) \\\\  & \\,+B(4(\\frac{1}{4})-1)(\\frac{1}{4}+1) \\\\  & \\,+C(4(\\frac{1}{4})-1)(\\frac{1}{4}+3) \\\\ -\\frac{1}{8}+\\frac{29}{4}+1 & =A(\\frac{65}{16}) \\\\ \\frac{65}{8} & =A(\\frac{65}{16}) \\\\ A & =\\frac{16}{8} \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}-2(-3)^{2}+29(-3)+1 & =A(-3+3)(-3+1) \\\\  & \\,+B(4(-3)-1)(-3+1) \\\\  & \\,+C(4(-3)-1)(-3+3) \\\\ -18-87+1 & =B(-13)(-2) \\\\ B & =\\frac{-104}{26} \\\\ B & =-4.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}-2(-1)^{2}+29(-1)+1 & =A(-1+3)(-1+1) \\\\  & \\,+B(4(-1)-1)(-1+1) \\\\  & \\,+C(4(-1)-1)(-1+3) \\\\ -2-29+1 & =C(-5)(2) \\\\ C & =\\frac{-30}{-10} \\\\ C & =3.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-2{x}^{2}+29x+1}{(4x-1)(x+3)(x+1)}=\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186255611 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2766d17-3539-5858-986e-ebd3a4f84034" :answer/type 