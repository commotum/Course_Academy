-x)(x+2)+B(2x+3)(x+2)+C(2x+3)(4-x).\n$$\n\nFor $x=-\\frac{3}{2}$, we get \n\n$$\n\\begin{aligned}7{(-\\frac{3}{2})}^{2}-27\\cdot (-\\frac{3}{2})-70 & =A(4-(-\\frac{3}{2}))((-\\frac{3}{2})+2) \\\\  & \\,+B(2(-\\frac{3}{2})+3)((-\\frac{3}{2})+2) \\\\  & \\,+C(2(-\\frac{3}{2})+3)(4-(-\\frac{3}{2})) \\\\ \\frac{63}{4}+\\frac{81}{2}-70 & =\\frac{11}{4}A \\\\ -\\frac{55}{4} & =\\frac{11}{4}A \\\\ A & =-\\frac{55}{4}\\cdot \\frac{4}{11} \\\\ A & =-5.\\end{aligned}\n$$\n\nFor $x=4$, we get \n\n$$\n\\begin{aligned}7(4)^{2}-27(4)-70 & =A(4-4)(4+2) \\\\  & \\,+B(2(4)+3)(4+2) \\\\  & \\,+C(2(4)+3)(4-4) \\\\ 112-108-70 & =B(11)(6) \\\\ B & =\\frac{-66}{66} \\\\ B & =-1.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}7(-2)^{2}-27(-2)-70 & =A(4-(-2))((-2)+2) \\\\  & \\,+B(2(-2)+3)((-2)+2) \\\\  & \\,+C(2(-2)+3)(4-(-2)) \\\\ 28+54-70 & =C(-1)(6) \\\\ C & =\\frac{12}{-6} \\\\ C & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=-5+(-1)+(-2)=-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-69752/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df"] :knowledge-point/questions ["q-69752"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69820/selection/77f5ee8275f1c5f288ffb5b6c43c311bc7ef5d3ab5bd657de55a4e143f86a7fd" :answer/id #uuid "06960a75-d1ce-50a8-9a33-202c43aa40bb" :answer/type :answer.type/math :answer/value "\\frac{2}{(4x-1)}-\\frac{4}{(x+3)}+\\frac{3}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-69820/selection/ad15f138ff808da8eca9b84fc0775a89141d2e3c693eead92cfc814a09024213" :answer/id #uuid "db5a7151-9f02-547e-92f8-505a5f2ad40a" :answer/type :answer.type/math :answer/value "\\frac{4}{(4x-1)}-\\frac{1}{(x+3)}-\\frac{2}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-69820/selection/ef88a09814cfcea10a127f5211203111431d34fd83543e611bae9d6b66f2d61a" :answer/id #uuid "886cc596-c9c0-5bad-ad8c-a0e113d52281" :answer/type :answer.t