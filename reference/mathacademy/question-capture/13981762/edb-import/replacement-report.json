          "question": "e-7904",
          "field": null,
          "attribute": "question/problem",
          "value": "Solve the inequality\n\n$$\n\\dfrac{x+5}{1-3x} \\lt 2, \\quad x \\lt 0.\n$$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981762/example-7904.json",
          "file_sha256": "e02854fdee15071489a23d7594b26a96ded565045b062922650db6a87b4cc2f3"
        }
      ],
      "basis": 1088,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981762/edb-import/commit.edn",
