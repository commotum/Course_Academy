}} \\\\ (\\operatorname{ln}⁡({x}^{2}+1)+{e}^{x})\\cdot \\frac{3x+4}{\\operatorname{ln}⁡({x}^{2}+1)+{e}^{x}} & >(\\operatorname{ln}⁡({x}^{2}+1)+{e}^{x})\\cdot \\frac{x+10}{\\operatorname{ln}⁡({x}^{2}+1)+{e}^{x}} \\\\ 3x+4 & >x+10 \\\\ 2x & >6 \\\\ x & >\\,3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328530/field-1" "q-328530/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bca43484-4a4f-57b7-a4c2-23d1db997afd"] :knowledge-point/questions ["q-328530"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328407/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer/id #uuid "105ccb02-f200-5610-9836-8000a8369485" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "q-328407/field-1" :answer-field/id #uuid "07150b6e-9fbf-5711-9107-13bc6ec9ed0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328407/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer-field/choices ["q-328407/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0"] :db/ensure [:answer-field/validate]} {:db/id "q-328407/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer/id #uuid "b681efae-467e-55c9-95b3-911e72eb79c8" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-328407/field-2" :answer-field/id #uuid "795f9410-1d80-5fd6-8047-1f2a772a4878" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328407/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer-field/choices ["q-328407/field-2/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818"] :db/ensure [:answer-field/validate]} {:db/id "q-328407" :question/id #uuid "255c8902-af73-55ea-b1a3-dba865ae654b" :question/math-academy-id "q-328407" :question/problem "Solve the inequality $\\frac{4{y}^{3}+11y-5}{{y}^{2}+2}\\le 4y.$\n\n$y$\n{{field-1}}{{field-2}}" :question/worked-solution "We know that the denominator ${y}^{2}+2$ is positive for all values of $y.$ So, we can multiply both sides of the inequality by ${y}^{2}+2$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{4{y}^{3}+11y-5}{{y}^{2}+2} & \\le 4y \\\\ ({y}^{2}+2)\\cdot \\frac{4{y}^{3}+11y-5}{{y}^{2}+2} & \\le ({y}^{2}+2)\\cdot 4y \\\\ 4{y}^{3}+11y-5 & \\le 4{y}^{3}+8y \\\\ 11y-5 & \\le 8y \\\\ 3y-5 & \\le 0 \\\\ y & \\le \\,\\frac{5}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328407/field-1" "q-328407/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bca43484-4a4f-57b7-a4c2-23d1db997afd"] :knowledge-point/questions ["q-328407"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328553/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "74eaaf5c-3e1c-5883-a199-218c86b08473" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-328553/field-1" :answer-field/id #uuid "2fa16a87-7fb5-5bad-8967-23387f1415f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328553/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-328553/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-328553/field-2/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "a18c72f0-3ac1-58a0-bb76-696d6918db58" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-328553/field-2" :answer-field/id #uuid "ea00d19a-3df5-5c3c-88af-64b554e18bd6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328553/field-2/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer-field/choices ["q-328553/field-2/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda"] :db/ensure [:answer-field/validate]} {:db/id "q-328553" :question/id #uuid "128fbafe-4df5-5561-876c-935b083d1854" :question/math-academy-id "q-328553" :question/problem "Solve the inequality\n$({e}^{2x}+{x}^{4})(5x-1)<0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Since ${e}^{2x}+{x}^{4}$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{({e}^{2x}+{x}^{4})(5x-1)}{{e}^{2x}+{x}^{4}} & <\\frac{0}{{e}^{2x}+{x}^{4}} \\\\ 5x-1 & <0 \\\\ 5x & <1 \\\\ x & <\\,\\frac{1}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328553/field-1" "q-328553/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef29dc50-df8b-50b7-9533-c670e3c08347"] :knowledge-point/questions ["q-328553"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328549/field-1/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer/id #uuid "11c5cc82-c496-59bb-ad2d-bbcb7db18e92" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "q-328549/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "47bbe85d-8350-50ae-b3ab-0c19ec6035bb" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-328549/field-1" :answer-field/id #uuid "cf071a7e-d2ea-5786-9787-eaf2cd870d2a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328549/field-1/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" :answer-field/choices ["q-328549/field-1/22814de28a0b1b4f20d5edd62707d192b78050d457a70349795d30d86dfcd7fa" "q-328549/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-328549/field-2/69eb9f7876f2d3b47a612b45e269e69c3a833fb0cff6b1db30fc34f27ac095c1" :answer/id #uuid "f0c97e1c-f2a2-5d38-b9af-3a5d6cbeda7f" :answer/type :answer.type/math :answer/value "-\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "q-328549/field-2" :answer-field/id #uuid "31302e44-9541-587b-adb2-ee39baf608ff" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328549/field-2/69eb9f7876f2d3b47a612b45e269e69c3a833fb0cff6b1db30fc34f27ac095c1" :answer-field/choices ["q-328549/field-2/69eb9f7876f2d3b47a612b45e269e69c3a833fb0cff6b1db30fc34f27ac095c1"] :db/ensure [:answer-field/validate]} {:db/id "q-328549" :question/id #uuid "b1be8a95-00d3-5635-8d87-78e9d7b1b05f" :question/math-academy-id "q-328549" :question/problem "Solve the inequality\n$(2\\sqrt{{x}^{2}+9})(-7x-5)<0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Note that the factor $2\\sqrt{{x}^{2}+9}$ is always positive for all real numbers $x.$\n\nSince $2\\sqrt{{x}^{2}+9}$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{(2\\sqrt{{x}^{2}+9})(-7x-5)}{\\,2\\sqrt{{x}^{2}+9}\\,} & <\\frac{0}{\\,2\\sqrt{{x}^{2}+9}\\,} \\\\ -7x-5 & <0 \\\\ -7x & <5 \\\\ x & >\\,-\\frac{5}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328549/field-1" "q-328549/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef29dc50-df8b-50b7-9533-c670e3c08347"] :knowledge-point/questions ["q-328549"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-89658"] :question/problem "Solve the inequality\n\n$$\n4x{e}^{2x}-5{e}^{2x}\\le 0.\n$$" :question/worked-solution "First, we factor the given inequality, as follows:\n\n$$\n\\begin{aligned}4x{e}^{2x}-5{e}^{2x} & \\le 0 \\\\ {e}^{2x}(4x-5) & \\le 0\\end{aligned}\n$$\n\nSince ${e}^{2x}$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{{e}^{2x}(4x-5)}{{e}^{2x}} & \\le \\frac{0}{{e}^{2x}} \\\\ 4x-5 & \\le 0 \\\\ 4x & \\le 5 \\\\ x & \\le \\frac{5}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-89661/selection/c4d8fcc3d0001d305927fbe8d5a0bcc565b987d26bf192f936c7579b4dde886a" :answer/id #uuid "49557046-514a-58a7-82df-49d85d28d121" :answer/type :answer.type/math :answer/value "x>0" :db/ensure [:answer/validate]} {:db/id "q-89661/selection/42eb19afc75cf20a848b6f99e4e53cb1d5cf58286f6c3a62cf4ea397bc18b03c" :answer/id #uuid "0269a33a-02b9-56bd-a588-33febba6040e" :answer/type :answer.type/math :answer/value "x<5" :db/ensure [:answer/validate]} {:db/id "q-89661/selection/c9f503d2289873e2852b653f2e282532bc8e4caec9a460dc28751def8d9a8bb2" :answer/id #uuid "5e202dd0-601d-575c-bed7-8792a3bbc978" :answer/type :answer.type/math :answer/value "x<1" :db/ensure [:answer/validate]} {:db/id "q-89661/selection/b7ae4aa12f5fb1a640728f66ae83453e93d44961bc52fb8f0ccc73f6a586a97d" :answer/id #uuid "63ea2566-3672-5541-ac3e-2f3fb1b49924" :answer/type :answer.type/math :answer/value "x>4" :db/ensure [:answer/validate]} {:db/id "q-89661/selection/1235061e5472926481ddeb36b23313e44d3189b3ae0ecc652c6bbec56a95bfe7" :answer/id #uuid "85520716-87a8-575a-acc3-427e49492210" :answer/type :answer.type/math :answer/value "x>2" :db/ensure [:answer/validate]} {:db/id "q-89661/selection" :answer-field/id #uuid "a3bc5f9c-0057-5099-b478-272ba2eea899" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89661/selection/c4d8fcc3d0001d305927fbe8d5a0bcc565b987d26bf192f936c7579b4dde886a" :answer-field/choices ["q-89661/selection/c4d8fcc3d0001d305927fbe8d5a0bcc565b987d26bf192f936c7579b4dde886a" "q-89661/selection/42eb19afc75cf20a848b6f99e4e53cb1d5cf58286f6c3a62cf4ea397bc18b03c" "q-89661/selection/c9f503d2289873e2852b653f2e282532bc8e4caec9a460dc28751def8d9a8bb2" "q-89661/selection/b7ae4aa12f5fb1a640728f66ae83453e93d44961bc52fb8f0ccc73f6a586a97d" "q-89661/selection/1235061e5472926481ddeb36b23313e44d3189b3ae0ecc652c6bbec56a95bfe7"] :db/ensure [:answer-field/validate]} {:db/id "q-89661" :question/id #uuid "f44f2990-d5b3-5df2-b67d-fb78ccc8bd0e" :question/math-academy-id "q-89661" :question/problem "Solve the inequality\n\n$$\n6{x}^{5}+18x>3x.\n$$" :question/worked-solution "First, we move all terms to the left-hand side and factor:\n\n$$\n\\begin{aligned}6{x}^{5}+18x & >3x \\\\ 6{x}^{5}+15x & >0 \\\\ 3x(2{x}^{4}+5) & >0\\end{aligned}\n$$\n\nSince $2{x}^{4}+5$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{3x(2{x}^{4}+5)}{2{x}^{4}+5} & >\\frac{0}{2{x}^{4}+5} \\\\ 3x & >0 \\\\ x & >0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89661/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef29dc50-df8b-50b7-9533-c670e3c08347"] :knowledge-point/questions ["q-89661"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89562/selection/ebe6f4d26afa362a416b64d63b5c4b51d9e2ae71005bcb2b10a9632f19911f50" :answer/id #uuid "303e801e-9848-51f5-8c96-3e6ed87c6185" :answer/type :answer.type/math :answer/value "x\\ge 2" :db/ensure [:answer/validate]} {:db/id "q-89562/selection/a2166b56ac9283a49c314c69ce026f1b812faf344000cc6010e9a213abf68628" :answer/id #uuid "e8de4e92-426f-57a5-b02e-2df3760bf47c" :answer/type :answer.type/math :answer/value "x\\le 1" :db/ensure [:answer/validate]} {:db/id "q-89562/selection/0ffcd15795e34096849b65562b63d39d444e2d6511f2bdba60b68039c64a76f9" :answer/id #uuid "fe716a13-88f7-54d5-b359-890b5ed2c61b" :answer/type :answer.type/math :answer/value "x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-89562/selection/12615117e5c4c8855f0a975b4c6d85ccaee67beb5e42186ff02f608448fb981b" :answer/id #uuid "423ac134-8235-512e-9bd9-30c144e432af" :answer/type :answer.type/math :a