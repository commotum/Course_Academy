3" :question/id #uuid "5b5529ad-b1a2-552f-b12b-dc7e0d4b23e0" :question/math-academy-id "q-116263" :question/problem "Solve the inequality\n\n$$\n(-1-\\operatorname{ln}⁡(|x|+2))(4x+7)\\le 0.\n$$" :question/worked-solution "Since $-1-\\operatorname{ln}⁡(|x|+2)$ is always negative, we can divide both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}(-1-\\operatorname{ln}⁡(|x|+2))(4x+7) & \\le 0 \\\\ \\frac{(-1-\\operatorname{ln}⁡(|x|+2))(4x+7)}{(-1-\\operatorname{ln}⁡(|x|+2))} & \\ge \\frac{0}{(-1-\\operatorname{ln}⁡(|x|+2))} \\\\ 4x+7 & \\ge 0 \\\\ 4x & \\ge -7 \\\\ x & \\ge -\\frac{7}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-116263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96b438f1-77af-551c-8a45-52a93e5995a8"] :knowledge-point/questions ["q-116263"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89676/selection/d8a167b2f86a18fa284aefe264ef0c35a0b3166154d86d12836cbd880463df6c" :answer/id #uuid "fb61ae1b-ccf1-5aac-92ab-46304dcc136a" :answer/type :answer.type/math :answer/value "x>1" :db/ensure [:answer/validate]} {:db/id "q-89676/selection/743bd864517fc2a7e414764d21d8462cb006562cfca76ef3ee77f5ee0bc33a6f" :answer/id #uuid "7a9ee56f-95d0-53ce-bbd1-95404c89101d" :answer/type :answer.type/math :answer/value "x<2" :db/ensure [:answer/validate]} {:db/id "q-89676/selection/c4d8fcc3d0001d305927fbe8d5a0bcc565b987d26bf192f936c7579b4dde886a" :answer/id #uuid "96abff79-1dc0-5283-a690-0b9bca310e07" :answer/type :answer.type/math :answer/value "x>0" :db/ensure [:answer/validate]} {:db/id "q-89676/selection/9b063fa2a26a79469af3bdd1c54b9c09402779d4607b7c25a7696b9c3086ed04" :answer/id #uuid "1ac30744-c336-593a-9ab2-ca17f6f846d6" :answer/type :answer.type/math :answer/value "x>-2" :db/ensure [:answer/validate]} {:db/id "q-89676/selection/d74efeefe227631e91b6e1908be92c58544b0fd3b26314c7082e97