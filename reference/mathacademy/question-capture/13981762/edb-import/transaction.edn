q-116265/selection/bffba701728d50ebba9d07385aa3e0a524f5c5a1e12ea56ddf03790729946d67" :answer/id #uuid "9984be31-6c2f-577e-90bf-8ba463b7f807" :answer/type :answer.type/math :answer/value "x<\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-116265/selection/0853a0542c597ebd74d0d7e25ff8e897f797a1258739f13a6eb1407ccb18bbd0" :answer/id #uuid "6037e0d5-3e9e-553a-a31a-fca34ace9bf4" :answer/type :answer.type/math :answer/value "x<-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-116265/selection/cd6d00d56b346ccb434a8e74058c51a2141da8ca58fa723666792c19225fd42c" :answer/id #uuid "66128952-c996-5f21-857f-000e32c9d34c" :answer/type :answer.type/math :answer/value "x>-\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-116265/selection/9b063fa2a26a79469af3bdd1c54b9c09402779d4607b7c25a7696b9c3086ed04" :answer/id #uuid "89515b2b-7ab4-55df-b45b-43339edcff23" :answer/type :answer.type/math :answer/value "x>-2" :db/ensure [:answer/validate]} {:db/id "q-116265/selection" :answer-field/id #uuid "4d1b9d0e-b2bd-5c3b-8fbd-578a1323f298" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116265/selection/cd6d00d56b346ccb434a8e74058c51a2141da8ca58fa723666792c19225fd42c" :answer-field/choices ["q-116265/selection/81110fefad62c8711af743d72d211a6cf9c1c90ff2803860ebb0ee411e30ef0d" "q-116265/selection/bffba701728d50ebba9d07385aa3e0a524f5c5a1e12ea56ddf03790729946d67" "q-116265/selection/0853a0542c597ebd74d0d7e25ff8e897f797a1258739f13a6eb1407ccb18bbd0" "q-116265/selection/cd6d00d56b346ccb434a8e74058c51a2141da8ca58fa723666792c19225fd42c" "q-116265/selection/9b063fa2a26a79469af3bdd1c54b9c09402779d4607b7c25a7696b9c3086ed04"] :db/ensure [:answer-field/validate]} {:db/id "q-116265" :question/id #uuid "079d429f-ce2e-5460-8272-295a0ca5238b" :question/math-academy-id "q-116265" :question/problem "Solve the inequality\n\n$$\n(2\\operatorname{arctan}⁡(x+3)-3\\pi )(2x+9)<0.\n$$" :question/worked-solution "Note that the factor $2\\operatorname{arctan}⁡(x+3)-3\\pi $ is always negative. We know this because\n\n$$\n-\\frac{\\pi }{2}<\\operatorname{arctan}⁡(x+3)<\\frac{\\pi }{2}\\,⇒\\,-4\\pi <2\\operatorname{arctan}⁡(x+3)-3\\pi <-2\\pi .\n$$\n\nSince $2\\operatorname{arctan}⁡(x+3)-3\\pi $ is always negative, we can divide both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}(2\\operatorname{arctan}⁡(x+3)-3\\pi )(2x+9) & <0 \\\\ \\frac{(2\\operatorname{arctan}⁡(x+3)-3\\pi )(2x+9)}{2\\operatorname{arctan}⁡(x+3)-3\\pi } & >\\frac{0}{2\\operatorname{arctan}⁡(x+3)-3\\pi } \\\\ 2x+9 & >0 \\\\ 2x & >-9 \\\\ x & >-\\frac{9}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-116265/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96b438f1-77af-551c-8a45-52a93e5995a8"] :knowledge-point/questions ["q-116265"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116269/selection/28ef7612a87757db02264c8b7534e57f3815d7fc98469361df547d6336ec948e" :answer/id #uuid "84a6d0fe-4266-5911-9f6a-1613fd9c9f6a" :answer/type :answer.type/math :answer/value "x\\ge -\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-116269/selection/b516ae039fef4c58f76f7215ab41152459e1440d1a1d7c7e328975a20b1aa0d1" :answer/id #uuid "b5c2ab07-2afc-5bfe-899c-5af65296e448" :answer/type :answer.type/math :answer/value "x\\le -\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "q-116269/selection/9b04ee5f5c98fe4e247b241e7c600d71067f25a787fa7010984e0be2c293c1be" :answer/id #uuid "56af529f-a298-5f7a-9543-557ef4148605" :answer/type :answer.type/math :answer/value "x\\le -\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-116269/selection/a35d062a87f0cdd6bcf96a9ce4474fed1cf6964985d0d73e08902ca348452c21" :answer/id #uuid "538f5ae6-3244-5de8-9404-b508749ce025" :answer/type :answer.type/math :answer/value "x\\le \\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-116269/selection/46c5ec706eccfd218068154141ddc77971cbde3ace9c66671ff89581ed98aad0" :answer/id #uuid "06454c98-f362-50ab-993c-5dcad0b22d82" :answer/type :answer.type/math :answer/value "x\\ge \\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "q-116269/selection" :answer-field/id #uuid "a72623f4-8836-53da-b3b4-39ef60d8cbcf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116269/selection/b516ae039fef4c58f76f7215ab41152459e1440d1a1d7c7e328975a20b1aa0d1" :answer-field/choices ["q-116269/selection/28ef7612a87757db02264c8b7534e57f3815d7fc98469361df547d6336ec948e" "q-116269/selection/b516ae039fef4c58f76f7215ab41152459e1440d1a1d7c7e328975a20b1aa0d1" "q-116269/selection/9b04ee5f5c98fe4e247b241e7c600d71067f25a787fa7010984e0be2c293c1be" "q-116269/selection/a35d062a87f0cdd6bcf96a9ce4474fed1cf6964985d0d73e08902ca348452c21" "q-116269/selection/46c5ec706eccfd218068154141ddc77971cbde3ace9c66671ff89581ed98aad0"] :db/ensure [:answer-field/validate]} {:db/id "q-116269" :question/id #uuid "005b4d3e-ef8e-55a5-ae81-8ff2469130a1" :question/math-academy-id "q-116269" :question/problem "Solve the inequality\n\n$$\n\\frac{2x+3}{\\operatorname{arctan}⁡(x)-\\pi }\\ge \\frac{2-7x}{\\operatorname{arctan}⁡(x)-\\pi }.\n$$" :question/worked-solution "Note that the factor $\\operatorname{arctan}⁡(x)-\\pi $ is always negative. We know this because\n\n$$\n-\\frac{\\pi }{2}<\\operatorname{arctan}⁡x<\\frac{\\pi }{2}\\,⇒\\,-\\frac{3\\pi }{2}<\\operatorname{arctan}⁡(x)-\\pi <-\\frac{\\pi }{2}.\n$$\n\nSince $\\operatorname{arctan}⁡(x)-\\pi $ is always negative, we can multiply both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{2x+3}{\\operatorname{arctan}⁡(x)-\\pi } & \\ge \\frac{2-7x}{\\operatorname{arctan}⁡(x)-\\pi } \\\\ (\\operatorname{arctan}⁡(x)-\\pi )\\cdot \\frac{2x+3}{\\operatorname{arctan}⁡(x)-\\pi } & \\le (\\operatorname{arctan}⁡(x)-\\pi )\\cdot \\frac{2-7x}{\\operatorname{arctan}⁡(x)-\\pi } \\\\ 2x+3 & \\le 2-7x \\\\ 9x & \\le -1 \\\\ x & \\le -\\frac{1}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-116269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96b438f1-77af-551c-8a45-52a93e5995a8"] :knowledge-point/questions ["q-116269"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89671/selection/4fba1a1b5b5a88505fde9df3d3e0af291d4b393f60f86b1a594c882428959c7e" :answer/id #uuid "2bc766c4-dad9-5360-b2a6-b52babaa635f" :answer/type :answer.type/math :answer/value "x<4" :db/ensure [:answer/validate]} {:db/id "q-89671/selection/8f76e462957fb434a3d41a30d4aee7e4d94453f7a9ebe4a2fea4dc30b98d8c81" :answer/id #uuid "13926da6-f8ea-5f38-8be1-dcca2ea326f3" :answer/type :answer.type/math :answer/value "x<\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-89671/selection/81110fefad62c8711af743d72d211a6cf9c1c90ff2803860ebb0ee411e30ef0d" :answer/id #uuid "c185b79c-f9ae-59e9-9dba-19f4a71dcfd6" :answer/type :answer.type/math :answer/value "x>\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-89671/selection/1235061e5472926481ddeb36b23313e44d3189b3ae0ecc652c6bbec56a95bfe7" :answer/id #uuid "40821dba-62fa-5b78-80f7-9eaf4ed4d6f6" :answer/type :answer.type/math :answer/value "x>2" :db/ensure [:answer/validate]} {:db/id "q-89671/selection/c9f503d2289873e2852b653f2e282532bc8e4caec9a460dc28751def8d9a8bb2" :answer/id #uuid "2623d4a6-eae9-5f22-a132-e97ed6d5b3d3" :answer/type :answer.type/math :answer/value "x<1" :db/ensure [:answer/validate]} {:db/id "q-89671/selection" :answer-field/id #uuid "f45068e9-4574-5c00-b993-1b41571b46b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89671/selection/8f76e462957fb434a3d41a30d4aee7e4d94453f7a9ebe4a2fea4dc30b98d8c81" :answer-field/choices ["q-89671/selection/4fba1a1b5b5a88505fde9df3d3e0af291d4b393f60f86b1a594c882428959c7e" "q-89671/selection/8f76e462957fb434a3d41a30d4aee7e4d94453f7a9ebe4a2fea4dc30b98d8c81" "q-89671/selection/81110fefad62c8711af743d72d211a6cf9c1c90ff2803860ebb0ee411e30ef0d" "q-89671/selection/1235061e5472926481ddeb36b23313e44d3189b3ae0ecc652c6bbec56a95bfe7" "q-89671/selection/c9f503d2289873e2852b653f2e282532bc8e4caec9a460dc28751def8d9a8bb2"] :db/ensure [:answer-field/validate]} {:db/id "q-89671" :question/id #uuid "92a095d0-ce8e-56cc-ae98-0a56b2f75ef0" :question/math-academy-id "q-89671" :question/problem "Solve the inequality\n\n$$\n\\frac{x+2}{2{sin}^{2}⁡x-3}>\\frac{4-3x}{2{sin}^{2}⁡x-3}.\n$$" :question/worked-solution "Note that the factor $2{sin}^{2}⁡x-3$ is always negative. We know this because\n\n$$\n0\\le {sin}^{2}⁡x\\le 1\\,⇒\\,-3\\le 2{sin}^{2}⁡x-3\\le -1.\n$$\n\nSince $2{sin}^{2}⁡x-3$ is always negative, we can multiply both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{x+2}{2{sin}^{2}⁡x-3} & >\\frac{4-3x}{2{sin}^{2}⁡x-3} \\\\ (2{sin}^{2}⁡x-3)\\cdot \\frac{x+2}{2{sin}^{2}⁡x-3} & <(2{sin}^{2}⁡x-3)\\cdot \\frac{4-3x}{2{sin}^{2}⁡x-3} \\\\ x+2 & <4-3x \\\\ 4x & <2 \\\\ x & <\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-89671/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96b438f1-77af-551c-8a45-52a93e5995a8"] :knowledge-point/questions ["q-89671"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-89117"] :question/problem "Solve the inequality\n\n$$\n\\frac{3x+2}{1-x}>4,\\,x>2.\n$$" :question/worked-solution "Since $x>2,$ we have that\n\n$$\n\\begin{aligned}x & >2 \\\\ -x & <-2 \\\\ 1-x & <-1.\\end{aligned}\n$$\n\nThis means that $1-x$ is negative for all the values of $x$ that we are considering $(x>2).$ So, we can multiply both sides by $1-x,$ provided that we flip the sign of the inequality:\n\n$$\n\\begin{aligned}\\frac{3x+2}{1-x} & >4 \\\\ (1-x)\\cdot \\frac{3x+2}{1-x} & <(1-x)\\cdot 4 \\\\ 3x+2 & <4-4x \\\\ 7x & <2 \\\\ x & <\\frac{2}{7}\\end{aligned}\n$$\n\nHowever, there are no numbers that satisfy both $x>2$ and $x<\\frac{2}{7}.$ So, the inequality has no solution." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-329163/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3db9ff17-d044-5f0e-9887-e940f84feb70" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-329163/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b49cb1de-3b06-509c-9c3b-a4814e68e5a5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-329163/field-1" :answer-field/id #uuid "28d9cf8b-25a0-5dda-a977-53b0a291a649" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-329163/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-329163/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-329163/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-329163/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "016e0125-ac97-52e9-8332-160584d63b69" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-329163/field-2" :answer-field/id #uuid "40c30737-e768-5b80-835a-92a1633f5746" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-329163/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-329163/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-329163/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "fe32e3f7-bd8c-5e0b-a97f-85bc71bd7ffb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-329163/field-3" :answer-field/id #uuid "9c055130-084b-5f91-91e1-eee1f253b56f" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-329163/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-329163/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-329163" :question/id #uuid "a9b27759-e26c-5938-bbc4-e59752cda93b" :question/math-academy-id "q-329163" :question/problem "Solve the inequality\n\n$$\n\\frac{8-2x}{|x-1|-1}\\ge 0,\\,x>3.\n$$\n\n{{field-1}}{{field-2}}\n$x\\le $\n{{field-3}}" :question/worked-solution "Since $x>3,$ we have that\n\n$$\n\\begin{aligned}x & >3 \\\\ x-1 & >2 \\\\ |x-1| & >2 \\\\ |x-1|-1 & >1\\end{aligned}\n$$\n\nThis means that $|x-1|-1$ is positive for all the values of $x$ that we are considering $(x>3).$ So, we can multiply both sides by $|x-1|-1,$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{8-2x}{|x-1|-1} & \\ge 0 \\\\ (|x-1|-1)\\cdot \\frac{8-2x}{|x-1|-1} & \\ge (|x-1|-1)\\cdot 0 \\\\ 8-2x & \\ge 0 \\\\ -2x & \\ge -8 \\\\ x & \\le 4\\end{aligned}\n$$\n\nNote that we had to flip the sign of the inequality again since we divided by a negative number ($-2$).\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x>3$ and $x\\le 4.$ So, the solution to our inequality is\n\n$$\n3<x\\le 4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-329163/field-1" "q-329163/field-2" "q-329163/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e4aa85c-345d-5869-9dcd-b2ef128dae3d"] :knowledge-point/questions ["q-329163"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116273/selection/c688ca18d5843d66fa8bd0f9791c67ad47a9b0c61a06d962ec281ffab2fff9a9" :answer/id #uuid "11f4aa14-d454-5fb1-adea-89a546012787" :answer/type :answer.type/math :answer/value "5<x\\le 8" :db/ensure [:answer/validate]} {:db/id "q-116273/selection/541f5c37a1ea188011012d49d98c19c90ac48d2e01b5254d4e6f9d334655d8a1" :answer/id #uuid "7a73b86a-8a46-5a2b-85b9-0051d98cfa63" :answer/type :answer.type/math :answer/value "x>5" :db/ensure [:answer/validate]} {:db/id "q-116273/selection/f772ae178e2de29f046ef0563b9184fb855185401f5061bd1c2aba931ea420ab" :answer/id #uuid "e840141a-d7a3-5182-a878-854ed50af58f" :answer/type :answer.type/math :answer/value "x\\ge 6" :db/ensure [:answer/validate]} {:db/id "q-116273/selection/906097efaf3649cef1201c1a97df7639387b3f5ea693e7b803683aa3ba2cb573" :answer/id #uuid "4cbed8db-34b1-5c4c-aa03-785fd6250075" :answer/type :answer.type/math :answer/value "5<x\\le 6" :db/ensure [:answer/validate]} {:db/id "q-116273/selection/c5bb8c11b7ecd47cf5ad74fbbe08be4c380eec924210970be192c7c21423380d" :answer/id #uuid "d7ec6ca1-0a01-5908-8d0a-8c33e187da59" :answer/type :answer.type/math :answer/value "x\\ge 8" :db/ensure [:answer/validate]} {:db/id "q-116273/selection" :answer-field/id #uuid "df6cd855-1f71-5d02-a766-53d229f7c8c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116273/selection/f772ae178e2de29f046ef0563b9184fb855185401f5061bd1c2aba931ea420ab" :answer-field/choices ["q-116273/selection/c688ca18d5843d66fa8bd0f9791c67ad47a9b0c61a06d962ec281ffab2fff9a9" "q-116273/selection/541f5c37a1ea188011012d49d98c19c90ac48d2e01b5254d4e6f9d334655d8a1" "q-116273/selection/f772ae178e2de29f046ef0563b9184fb855185401f5061bd1c2aba931ea420ab" "q-116273/selection/906097efaf3649cef1201c1a97df7639387b3f5ea693e7b803683aa3ba2cb573" "q-116273/selection/c5bb8c11b7ecd47cf5ad74fbbe08be4c380eec924210970be192c7c21423380d"] :db/ensure [:answer-field/validate]} {:db/id "q-116273" :question/id #uuid "f4cf36d3-7f64-5689-9ba7-6939c71f4209" :question/math-academy-id "q-116273" :question/problem "Solve the inequality\n\n$$\n\\frac{x}{x-3}\\le 2,\\,x>5.\n$$" :question/worked-solution "Since $x>5,$ we have that\n\n$$\n\\begin{aligned}x & >5 \\\\ x-3 & >5-3 \\\\ x-3 & >2.\\end{aligned}\n$$\n\nThis means that $x-3$ is positive for all the values of $x$ that we are considering $(x>5).$ So, we can multiply both sides by $x-3,$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{x}{x-3} & \\le 2 \\\\ (x-3)\\cdot \\frac{x}{x-3} & \\le (x-3)\\cdot 2 \\\\ x & \\le 2x-6 \\\\ -x & \\le -6 \\\\ x & \\ge 6\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x>5$ and $x\\ge 6.$ So, the solution to our inequality is $x\\ge 6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116273/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e4aa85c-345d-5869-9dcd-b2ef128dae3d"] :knowledge-point/questions ["q-116273"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-89571"] :question/problem "Solve the inequality\n\n$$\n\\frac{2x-3}{\\operatorname{ln}⁡(x-2)}\\ge 0,\\,x>3.\n$$" :question/worked-solution "Since $x>3,$ we have that\n\n$$\n\\begin{aligned}x & >3 \\\\ x-2 & >3-2 \\\\ x-2 & >1.\\end{aligned}\n$$\n\nThis means that $\\operatorname{ln}⁡(x-2)$ is positive for all the values of $x$ that we are considering $(x>3).$ So, we can multiply both sides by $\\operatorname{ln}⁡(x-2),$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{2x-3}{\\operatorname{ln}⁡(x-2)} & \\ge 0 \\\\ \\operatorname{ln}⁡(x-2)\\cdot \\frac{2x-3}{\\operatorname{ln}⁡(x-2)} & \\ge \\operatorname{ln}⁡(x-2)\\cdot 0 \\\\ 2x-3 & \\ge 0 \\\\ 2x & \\ge 3 \\\\ x & \\ge \\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x>3$ and $x>\\frac{3}{2}.$ So, the solution to our inequality is $x>3.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-89572/selection/d74efeefe227631e91b6e1908be92c58544b0fd3b26314c7082e97f5802f2692" :answer/id #uuid "1346a1ab-58c5-522c-a120-abb3e35383ed" :answer/type :answer.type/math :answer/value "x<-1" :db/ensure [:answer/validate]} {:db/id "q-89572/selection/28410a97d1259017bc2b1c4bdb66cb79974e406eb98c7899329660b64985e69f" :answer/id #uuid "f410ada1-238b-5d78-a359-e34f2e22117a" :answer/type :answer.type/math :answer/value "-5\\le x\\le -3" :db/ensure [:answer/validate]} {:db/id "q-89572/selection/210812d09712d052c196bed2cab9fc48f03ccb9ea03b12715cfa1bc58931c6f7" :answer/id #uuid "d8a7834c-bd5b-5b4d-8a7c-7853cf933069" :answer/type :answer.type/math :answer/value "x\\le -5" :db/ensure [:answer/validate]} {:db/id "q-89572/selection/2baeee35bc2a76346e4de3b0f6e1e9bf9501063e67fed1ce8ff7050ed157959e" :answer/id #uuid "406685b0-9c67-5f98-a966-e4f978643dc9" :answer/type :answer.type/math :answer/value "-3\\le x<-1" :db/ensure [:answer/validate]} {:db/id "q-89572/selection/14e4e7017f13777eef6e3281daf7a176fb620f472cfe8ae474e10eb34c3376ee" :answer/id #uuid "33474b8d-0dbc-5222-8ed4-185e8e0d9424" :answer/type :answer.type/math :answer/value "x\\le -3" :db/ensure [:answer/validate]} {:db/id "q-89572/selection" :answer-field/id #uuid "f69aa5b4-3b65-5ed1-8adf-c152a4b0543c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89572/selection/14e4e7017f13777eef6e3281daf7a176fb620f472cfe8ae474e10eb34c3376ee" :answer-field/choices ["q-89572/selection/d74efeefe227631e91b6e1908be92c58544b0fd3b26314c7082e97f5802f2692" "q-89572/selection/28410a97d1259017bc2b1c4bdb66cb79974e406eb98c7899329660b64985e69f" "q-89572/selection/210812d09712d052c196bed2cab9fc48f03ccb9ea03b12715cfa1bc58931c6f7" "q-89572/selection/2baeee35bc2a76346e4de3b0f6e1e9bf9501063e67fed1ce8ff7050ed157959e" "q-89572/selection/14e4e7017f13777eef6e3281daf7a176fb620f472cfe8ae474e10eb34c3376ee"] :db/ensure [:answer-field/validate]} {:db/id "q-89572" :question/id #uuid "9c3d094e-2960-5478-a6a7-e8c041fc7903" :question/math-academy-id "q-89572" :question/problem "Solve the inequality\n\n$$\n(2x-1)(x+3)\\ge 0,\\,x<-1.\n$$" :question/worked-solution "Since $x<-1,$ we have that\n\n$$\n\\begin{aligned}x & <-1 \\\\ 2x & <-2 \\\\ 2x-1 & <-3.\\end{aligned}\n$$\n\nThis means that $2x-1$ is negative for all the values of $x$ that we are considering $(x<-1).$ So, we can divide both sides by $2x-1,$ provided that we flip the sign of the inequality:\n\n$$\n\\begin{aligned}(2x-1)(x+3) & \\ge 0 \\\\ \\frac{(2x-1)(x+3)}{2x-1} & \\le \\frac{0}{2x-1} \\\\ x+3 & \\le 0 \\\\ x & \\le -3\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x\\le -3$ and $x<-1.$ So, the solution to our inequality is $x\\le -3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-89572/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e4aa85c-345d-5869-9dcd-b2ef128dae3d"] :knowledge-point/questions ["q-89572"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7901"] :question/problem "Solve the inequality\n\n$$\n\\dfrac{2}{5x^4 +2} \\lt \\dfrac{5-2x}{5x^4+2}.\n$$" :question/worked-solution "We know that the denominator $5x^4+ 2$ is positive for all values of $x.$ So, we can multiply both sides of the inequality by $5x^4+2$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{2}{5{x}^{4}+2} & <\\frac{5-2x}{5{x}^{4}+2} \\\\ (5{x}^{4}+2)\\cdot \\frac{2}{5{x}^{4}+2} & <(5{x}^{4}+2)\\cdot \\frac{5-2x}{5{x}^{4}+2} \\\\ 2 & <5-2x \\\\ 2x & <3 \\\\ x & <\\frac{3}{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7902"] :question/problem "Solve the inequality\n\n$$\n6x^3 + 3x \\lt 0.\n$$" :question/worked-solution "First, we factor:\n\n$$\n\\begin{aligned}6{x}^{3}+3x & <0. \\\\ 3x(2{x}^{2}+1) & <0\\end{aligned}\n$$\n\nSince $2x^2 + 1$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{3x(2{x}^{2}+1)}{2{x}^{2}+1} & <\\frac{0}{2{x}^{2}+1} \\\\ 3x & <0 \\\\ x & <0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7903"] :question/problem "Solve the inequality\n\n$$\n(2\\sin{x}-9)(2x) \\leq 0.\n$$" :question/worked-solution "Note that the factor $2\\sin{x}-9$ is always negative. We know this because\n\n$$\n-1 \\leq \\sin x \\leq 1 \\quad \\Rightarrow \\quad -11 \\leq 2\\sin x - 9 \\leq -7.\n$$\n\nBecause $2\\sin{x}-9$ is always negative, we can divide both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}(2\\operatorname{sin}⁡x-9)(2x) & \\le 0 \\\\ \\frac{(2\\operatorname{sin}⁡x-9)(2x)}{2\\operatorname{sin}⁡x-9} & \\ge \\frac{0}{2\\operatorname{sin}⁡x-9} \\\\ 2x & \\ge 0 \\\\ x & \\ge 0.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7904"] :question/problem "Solve the inequality\n\n$$\n\\dfrac{x+5}{1-3x} \\lt 2, \\quad x \\lt 0.\n$$" :question/worked-solution "Since $x\\lt 0,$ we have that\n\n$$\n\\begin{aligned}x & <0 \\\\ -x & >0 \\\\ -3x & >0 \\\\ 1-3x & >1.\\end{aligned}\n$$\n\nThis means that $1-3x$ is positive for all the values of $x$ that we are considering $(x\\lt 0).$ So, we can multiply both sides by $1-3x,$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{x+5}{1-3x} & <2 \\\\ (1-3x)\\cdot \\frac{x+5}{1-3x} & <(1-3x)\\cdot 2 \\\\ x+5 & <2-6x \\\\ 7x & <-3 \\\\ x & <-\\frac{3}{7}\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x \\lt 0$ and $x \\lt -\\dfrac{3}{7}.$ So, the solution to our inequality is $x \\lt -\\dfrac{3}{7}.$" :db/ensure [:question/validate]}]
