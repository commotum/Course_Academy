 -\\frac{1}{9}.\\end{aligned}\n$$" 13194139534401 true] [17592186286407 1000 #edb/ref 17592186286408 13194139534401 true] [17592186286407 1000 #edb/ref 17592186286409 13194139534401 true] [17592186286407 1000 #edb/ref 17592186286410 13194139534401 true] [17592186286407 1000 #edb/ref 17592186286411 13194139534401 true] [17592186286407 1000 #edb/ref 17592186286412 13194139534401 true] [17592186286407 1040 #edb/ref 17592186045450 13194139534401 true] [17592186286407 1041 "selection" 13194139534401 true] [17592186286407 1104 #edb/ref 17592186286412 13194139534401 true] [17592186286407 1110 #uuid "a72623f4-8836-53da-b3b4-39ef60d8cbcf" 13194139534401 true] [17592186286408 1034 "x\\ge -\\frac{1}{3}" 13194139534401 true] [17592186286408 1103 #edb/ref 17592186045453 13194139534401 true] [17592186286408 1111 #uuid "84a6d0fe-4266-5911-9f6a-1613fd9c9f6a" 13194139534401 true] [17592186286409 1034 "x\\ge \\frac{1}{9}" 13194139534401 true] [17592186286409 1103 #edb/ref 17592186045453 13194139534401 true] [17592186286409 1111 #uuid "06454c98-f362-50ab-993c-5dcad0b22d82" 13194139534401 true] [17592186286410 1034 "x\\le -\\frac{2}{3}" 13194139534401 true] [17592186286410 1103 #edb/ref 17592186045453 13194139534401 true] [17592186286410 1111 #uuid "56af529f-a298-5f7a-9543-557ef4148605" 13194139534401 true] [17592186286411 1034 "x\\le \\frac{1}{3}" 13194139534401 true] [17592186286411 1103 #edb/ref 17592186045453 13194139534401 true] [17592186286411 1111 #uuid "538f5ae6-3244-5de8-9404-b508749ce025" 13194139534401 true] [17592186286412 1034 "x\\le -\\frac{1}{9}" 13194139534401 true] [17592186286412 1103 #edb/ref 17592186045453 13194139534401 true] [17592186286412 1111 #uuid "b5c2ab07-2afc-5bfe-899c-5af65296e448" 13194139534401 true] [17592186286413 1017 #edb/ref 17592186286414 13194139534401 true] [17592186286413 1089 "q-116273" 13194139534401 true] [17592186286413 1091 #edb/ref 17592186045464 13194139534401 true] [17592186286413 1100 "Solve the inequality\n\n$$\n\\frac{x}{x-3}\\le 2,\\