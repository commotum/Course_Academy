#{[{:db/id #edb/ref 17592186068945 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "875c59c9-b1f6-5457-9eb1-878c93776457" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 24" :db/id #edb/ref 17592186065465} {:answer/id #uuid "8d21b9c4-e14d-5288-b37c-0375087fb3db" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 12" :db/id #edb/ref 17592186065466} {:answer/id #uuid "c6111099-1508-583a-b36e-4e923db2734f" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 16" :db/id #edb/ref 17592186065467} {:answer/id #uuid "13f83d14-8c10-5119-beb3-a5dba9032a19" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 8" :db/id #edb/ref 17592186065468} {:answer/id #uuid "467c3295-ac45-54e8-9325-73580505898b" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 17" :db/id #edb/ref 17592186065469}] :answer-field/correct {:answer/id #uuid "467c3295-ac45-54e8-9325-73580505898b" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 17" :db/id #edb/ref 17592186065469} :answer-field/id #uuid "c2ef266c-91cd-5457-9508-bcfbc90e3887" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065464}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "182dc49a-808d-540a-a4f9-abacbd57ac1e" :question/math-academy-id "q-112474" :question/problem "The equation $t^{2} + 10t + 13 = 0$ can be written in the form $(t + p)^{2} = q$. Find $p + q$." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}+10t+13 & =0 \\\\ {t}^{2}+10t & =-13 \\\\ {t}^{2}+2\\cdot 5\\cdot t & =-13 \\\\ {t}^{2}+2\\cdot 5\\cdot t+{5}^{2}-{5}^{2} & =-13 \\\\ (t+5)^{2}-25 & =-13\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(t+5)^{2}-25 & =-13 \\\\ (t+5)^{2} & =12\\end{aligned}\n$$\n\nHence, $p=5,$ $q=12,$ and $p+q=17.$"}] [{:db/id #edb/ref 17592186256328 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c910fc9-faad-5356-be11-f0500ed12f51" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186256330} {:answer/id #uuid "5a94e0c0-8946-54a2-989f-09d20106cc76" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=-2\\pm \\sqrt{2}" :db/id #edb/ref 17592186256331} {:answer/id #uuid "8dd374d6-e32d-5daf-8439-eb50db844239" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=8,\\,m=4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186256332} {:answer/id #uuid "1752d166-a3f3-517a-9092-c235d5186331" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=10,\\,m=4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186256333} {:answer/id #uuid "cef09595-ee12-5584-bfe1-6b1ea5c0d31b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=14,\\,m=-4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186256334}] :answer-field/correct {:answer/id #uuid "6c910fc9-faad-5356-be11-f0500ed12f51" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186256330} :answer-field/id #uuid "ab59f28a-c13f-5d55-837d-ebdb79eb165d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256329}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d70e8a4-cad6-5c6f-b225-88fe32f8d423" :question/math-academy-id "q-112487" :question/problem "The equation ${m}^{2}+8=-8m$ can be written in the form $(m+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-8m$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{m}^{2}+8 & =-8m \\\\ {m}^{2}+8m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m+{4}^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2}-{4}^{2} & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(m+4)^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2} & =8\\end{aligned}\n$$\n\nSo, $p=4,q=8,$ and $p+q=12.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(m+4)^{2} & =8 \\\\ \\sqrt{(m+4)^{2}} & =\\sqrt{8} \\\\ |m+4| & =\\sqrt{8} \\\\ m+4 & =\\pm 2\\sqrt{2} \\\\ m & =-4\\pm 2\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256335 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56e2508-b6cc-5d52-ae90-fba36150c1a9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=12\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186256337} {:answer/id #uuid "838174d9-f82f-5f7d-854a-ce24092de414" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26,\\,a=2\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186256338} {:answer/id #uuid "fdcabf79-d237-56bb-a9af-1eca5b811a8d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=21,\\,a=3\\pm 5\\sqrt{2}" :db/id #edb/ref 17592186256339} {:answer/id #uuid "f54ca75a-0c67-5ef1-b9b9-6ccb51f93438" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=30,\\,a=1\\pm 3\\sqrt{3}" :db/id #edb/ref 17592186256340} {:answer/id #uuid "75157e92-fcc3-56a4-818c-b86ac879ba58" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=6\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186256341}] :answer-field/correct {:answer/id #uuid "75157e92-fcc3-56a4-818c-b86ac879ba58" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=24,\\,a=6\\pm 3\\sqrt{2}" :db/id #edb/ref 17592186256341} :answer-field/id #uuid "e1476630-98ba-541a-adf5-49ce5fea2c87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256336}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "be8f497a-8c44-5854-8059-6756cc3a135d" :question/math-academy-id "q-112490" :question/problem "The equation ${a}^{2}-12a+18=0$ can be written in the form $(a-p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}-12a+18 & =0 \\\\ {a}^{2}-12a & =-18 \\\\ {a}^{2}-2\\cdot 6\\cdot a+{6}^{2}-{6}^{2} & =-18 \\\\ (a-6)^{2}-{6}^{2} & =-18\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a-6)^{2}-{6}^{2} & =-18 \\\\ (a-6)^{2}-36 & =-18 \\\\ (a-6)^{2} & =18\\end{aligned}\n$$\n\nSo, $p=6,q=18,$ and $p+q=24.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a-6)^{2} & =18 \\\\ \\sqrt{(a-6)^{2}} & =\\sqrt{18} \\\\ |a-6| & =\\sqrt{18} \\\\ a-6 & =\\pm 3\\sqrt{2} \\\\ a & =6\\pm 3\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069140 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066384} {:answer/id #uuid "a2710526-3439-5d45-a3cb-b94809df5d4a" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 9, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066385} {:answer/id #uuid "b5eac8af-989a-5812-82cd-e6e80a244860" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} =-4" :db/id #edb/ref 17592186066386} {:answer/id #uuid "cec6266a-38e0-5082-ae2c-0c20a9b251e4" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 6" :db/id #edb/ref 17592186066387} {:answer/id #uuid "d0b0d285-5968-53b9-b5b2-00fcaf5e3048" :answer/type {:db/ident :answer.type/math} :answer/value "p + q =-11x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066388}] :answer-field/correct {:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066384} :answer-field/id #uuid "d792d360-b68f-53ea-add1-82615c19183b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066383}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation $x^{2} - 4x + 4 = 9$ can be written in the form $(x + p)^{2} = q$. Find $p + q$, and the sum of the roots $x_{1} + x_{2}$." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186069189 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df094c63-c951-50c2-b02d-233e810293df" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 49, x =-3$ and $x = 11$" :db/id #edb/ref 17592186066666} {:answer/id #uuid "1ccdee43-18fc-5919-a3bb-4d01e91f422e" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 49, x =-11$ and $x = 3$" :db/id #edb/ref 17592186066667} {:answer/id #uuid "2089f552-f663-565d-be3d-4e7fca74ca05" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 53, x =-9$ and $x = 3$" :db/id #edb/ref 17592186066668} {:answer/id #uuid "6fd6753f-bd2a-5f02-830f-a1ea1f8783b5" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 53, x =-11$ and $x = 3$" :db/id #edb/ref 17592186066669} {:answer/id #uuid "71b7c176-f98b-56ef-b8b8-316d3651a530" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 51, x =-2$ and $x = 3$" :db/id #edb/ref 17592186066670}] :answer-field/correct {:answer/id #uuid "6fd6753f-bd2a-5f02-830f-a1ea1f8783b5" :answer/type {:db/ident :answer.type/text} :answer/value "$p + q = 53, x =-11$ and $x = 3$" :db/id #edb/ref 17592186066669} :answer-field/id #uuid "edb66e5d-55fa-5807-b0a8-9ba7d4621b89" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066665}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "31f81354-1c7b-50a3-a648-778f85068793" :question/math-academy-id "q-3430" :question/problem "The equation $x^{2} + 8x - 33 = 0$ can be written in the form $(x + p)^{2} = q$. Find $p + q$, and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x-33 & =0 \\\\ {x}^{2}+8x & =33 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =33 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =33 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =33 \\\\ (x+4)^{2}-16 & =33\\end{aligned}\n$$\n\nThen, we isolate the perfect square and solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =33 \\\\ (x+4)^{2} & =49\\end{aligned}\n$$\n\nSo, $p=4,q=49,$ and $p+q=53.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =49 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{49} \\\\ x+4 & =\\pm 7 \\\\ x & =-4\\pm 7\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}x & =-4+7=3 \\\\ x & =-4-7=-11\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-11$ and $x=3.$"}]}
