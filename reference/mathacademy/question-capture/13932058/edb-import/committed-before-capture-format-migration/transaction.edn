66514/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-66514" :question/id #uuid "e687e18c-9edd-57ea-b75b-3cb3764012f6" :question/math-academy-id "q-66514" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/f65062d48189401ba22b1b08637d187eed532d5f93dca7663c2e80743510d5d7.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/cc31f6f291058c7890a9210d5ebfac21cdd961c74c3db5e080d7fca334102b53.png)\n\nFrom the above, we see that: \n\n- For graph III, a horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph III shows a one-to-one function. This means that the function is invertible.\n\n- For graphs I, II and IV, some horizontal lines intersect the curve more than once. So, these are not one-to-one functions. As a result, they are not invertible." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66514/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30"] :knowledge-point/questions ["q-66514"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36063/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6c76b358-2b74-52da-b5a1-414c8d452f11" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-36063/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "17b451d9-51a7-5a20-ab99-f3e2f6f46644" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-36063/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "1bd16930-a43a-5142-b4db-22083c4791a3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-36063/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "3cc79d0f-f470-5b01-8966-5d49618570c9" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-36063/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "e1a64aee-d214-52af-8221-3e9095157c0b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-36063/selection" :answer-field/id #uuid "0479c94b-3a90-5efc-9f60-f99d81a78b2f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36063/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-36063/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-36063/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-36063/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-36063/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-36063/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-36063" :question/id #uuid "1a35aff9-b532-5679-a853-22b41fc9f74f" :question/math-academy-id "q-36063" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/1dd593e8b48b13ec512a3e0c823ec0aaac4f5341bd519c7bb9b04648f95f4251.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/2a68cbeceea9173ab7a53d334d073e9779b048ad8946fd3ff81b09adb79cee98.png)\n\nFrom the above, we see that:\n\n- For graph II, a horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph II shows a one-to-one function. As a result, this function is invertible.\n\n- For graphs I, III and IV, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36063/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30"] :knowledge-point/questions ["q-36063"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36941"] :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-2,0].$ Indeed, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/d7c6e8d314483ad67e89ce5d4675b7af27fa08c88a4ed9d95eed9ad2a4da51cc.png)\n\n- The given function is **not** invertible on the intervals $x\\in (-2,2]$ and $x\\in [-4,-2]\\cup [2,4]$ because some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/cee829f7e3d5f32b0acb54cb5c40406d8391d2a2967c68df0c1f5e1cae87d729.png)\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-36002/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "00bf83c4-61fd-509d-b03a-3081edca0abf" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-36002/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "91093f4e-b466-5a4d-a6b5-f81025a64891" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-36002/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "7b3ccbba-7692-5b9f-8f6a-d2f872405d99" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-36002/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "ce204ac1-108e-5ada-abc7-89ed9f70b592" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-36002/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "30f273d6-04c3-5a35-bff9-f86644a94b9d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-36002/selection" :answer-field/id #uuid "09e52a2a-b6fb-5231-b075-aecb8b2b042a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36002/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-36002/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-36002/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-36002/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-36002/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-36002/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-36002" :question/id #uuid "fdd9b8a8-3521-5250-8471-b1939a55f628" :question/math-academy-id "q-36002" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/c51c5a4de562e5a3301ea76afc6af57b459acd4c46e5c65d54afc226d883a137.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\n- $x\\in (-3,0]$\n- $x\\in (-3,1)$\n- $x\\in [0,3)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The given function is invertible on the intervals $x\\in (-3,0]$ and $x\\in [0,3).$ Indeed, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/00a80dde24ca012e0282362224c8b63764f5e149a8bfcda9c76ff4eb958fa93a.png)\n\n \n\n- The given function is **not** invertible on the interval $x\\in (-3,1)$  because some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/9ea54918e2ef4310b58e9cf8a0c9b1f9757a404d97dbbfd9e5b037af2193f38c.png)\n\n \n\nHence, the correct answer is 'I and III only''." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36002/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60"] :knowledge-point/questions ["q-36002"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36004/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "84998050-7b40-5f16-9063-fcebbe0cb995" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-36004/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "d4f99dde-2516-51af-841e-f3278edc61b3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-36004/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "b484bb7a-4b44-52fd-9b5f-e13a70a4dc4e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-36004/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "4ec4637d-ce78-58d7-9bbd-3dc310d0458b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-36004/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "78205b08-181d-5dcb-be41-5cacf40a0ab9" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-36004/selection" :answer-field/id #uuid "fcd3ca4b-2179-5da1-b39e-05542e389c53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36004/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-36004/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-36004/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-36004/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-36004/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-36004/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-36004" :question/id #uuid "f1576eb0-9e79-5e65-81b7-76d09de9784a" :question/math-academy-id "q-36004" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/1597ad53471d0d9b44812c5caa31bcb160cfa150d1df9a9314447fa49e62ccff.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\n- $x\\in [-6,0]$\n- $x\\in [-6,4)$\n- $x\\in [4,10)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in [-6,0]$ and $x\\in [4,10).$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/7cb282e3fa66af801ff03816973d5f5f1d0cb41e39d08a8addd27d7aa9c5b9df.png)\n\n      \n\n- The given function is **not** invertible on the interval $[-6,4]$  because some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/000953609a7b3e13ad09473ead62f96aa895c7f94aa618884e69883595004fd4.png)\n\n \n\n Therefore, the correct answer is \"I  and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36004/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60"] :knowledge-point/questions ["q-36004"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36061/selection/48172333f4c9fa1d8e7cce43bdf545f3a76b675b3cf1918dcb8fba790cec24bf" :answer/id #uuid "07501a66-868d-58d0-b9f4-9596bc272343" :answer/type :answer.type/math :answer/value "x\\in [-3,0]" :db/ensure [:answer/validate]} {:db/id "q-36061/selection/5791ae076a4afc746c9ce8c565a6b35ef5764ebf3361558bb591f7fe2f2a3e5b" :answer/id #uuid "13f995c5-1ae6-5459-93cb-1c91845c2866" :answer/type :answer.type/math :answer/value "x\\in [-3,1]" :db/ensure [:answer/validate]} {:db/id "q-36061/selection/9daf7e0a750457c6a079b14165e24f7060d6db4868b76e4d26fd758109cf9ca0" :answer/id #uuid "3119ef8c-12a5-5da8-a5aa-f57ee2250014" :answer/type :answer.type/math :answer/value "x\\in [-3,4]" :db/ensure [:answer/validate]} {:db/id "q-36061/selection/1721925bd0af945d4f79e08947f766cd000d83993c813e7422a68927cabfb02e" :answer/id #uuid "1e3f621d-87a9-55d3-955b-17f9e012a4be" :answer/type :answer.type/math :answer/value "x\\in [-3,4)" :db/ensure [:answer/validate]} {:db/id "q-36061/selection/ec269c852b17600320cdac043a440118315e1fff29438c38ba9d5aa856f720ec" :answer/id #uuid "124bcde7-2790-5932-8fe1-f5a3e35f4eab" :answer/type :answer.type/math :answer/value "x\\in [1,4]" :db/ensure [:answer/validate]} {:db/id "q-36061/selection" :answer-field/id #uuid "92d8ecc6-9335-5095-9a7d-fdf6881b1c23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36061/selection/5791ae076a4afc746c9ce8c565a6b35ef5764ebf3361558bb591f7fe2f2a3e5b" :answer-field/choices ["q-36061/selection/48172333f4c9fa1d8e7cce43bdf545f3a76b675b3cf1918dcb8fba790cec24bf" "q-36061/selection/5791ae076a4afc746c9ce8c565a6b35ef5764ebf3361558bb591f7fe2f2a3e5b" "q-36061/selection/9daf7e0a750457c6a079b14165e24f7060d6db4868b76e4d26fd758109cf9ca0" "q-36061/selection/1721925bd0af945d4f79e08947f766cd000d83993c813e7422a68927cabfb02e" "q-36061/selection/ec269c852b17600320cdac043a440118315e1fff29438c38ba9d5aa856f720ec"] :db/ensure [:answer-field/validate]} {:db/id "q-36061" :question/id #uuid "8cd22e19-bd25-51c4-940d-5221f04a8731" :question/math-academy-id "q-36061" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/4d4353286b5d1668d2a67539db8b1fd27227872b1f5a2eaa5fd6015716f255b0.png)\n\nDetermine the largest interval on which the function $f(x)$ (shown above) is invertible." :question/worked-solution "First, notice that the domain of our function is $x\\in [-3,4).$\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ does not pass the horizontal line test on the interval $x\\in [1,4).$ In this case, the horizontal line $y=-1$ intersects the graph at more than one point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/a709558673202ef4a7835dcea6e23b7ec5b13684272c56023058223c01fb8061.png)\n\n- The function $f(x)$ is invertible on the interval $x\\in [-3,1].$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/5a65e71f571e9510580ba5fe105a6eac48acfe4564c5a6bf76371c2bf09ff651.png)\n\nTherefore, the largest interval on which the function is invertible is:\n\n$$\nx\\in [-3,1]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-36061/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60"] :knowledge-point/questions ["q-36061"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108673/selection/07bba556641a58b39e1506b1d6054b146579b5754654b99835b06cebc8795afc" :answer/id #uuid "b2ce3887-e780-5a2e-98dc-72cb17c19e89" :answer/type :answer.type/text :answer/value "I  and III only" :db/ensure [:answer/validate]} {:db/id "q-108673/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "bab0805a-3bdc-5759-8db9-8e433188df0c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-108673/selection/5267565fb670f61c6c24e0670f2fb4f745887a45a1d2648084130ba9de933c0a" :answer/id #uuid "1544d6c2-514b-5ed3-a321-02a55ec8d2a7" :answer/type :answer.type/text :answer/value "I  and II only" :db/ensure [:answer/validate]} {:db/id "q-108673/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "abd9ffe3-02a4-5525-b139-75722c29e13a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-108673/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "e3ba4da6-7589-5edd-a247-29ec893f8378" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-108673/selection" :answer-field/id #uuid "63063725-9c06-5e40-9a60-3fcd720089ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108673/selection/07bba556641a58b39e1506b1d6054b146579b5754654b99835b06cebc8795afc" :answer-field/choices ["q-108673/selection/07bba556641a58b39e1506b1d6054b146579b5754654b99835b06cebc8795afc" "q-108673/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-108673/selection/5267565fb670f61c6c24e0670f2fb4f745887a45a1d2648084130ba9de933c0a" "q-108673/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-108673/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-108673" :question/id #uuid "5e08394b-d0b3-5e84-8365-84dd1770cf90" :question/math-academy-id "q-108673" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/3db32ea943ff1f457704a29f325a592eb4e1e0e53ee258041d08346bf9da4716.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\n- $x\\in (-2,0]$\n- $x\\in (-3,0)$\n- $x\\in (0,2)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The given function is invertible on the intervals $x\\in (-2,0]$ and $x\\in (0,2).$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/46e1daf2cb9025b6a736f223fbe168ea32b66302cebea23ca3a2d473e78b77b3.png)\n\n        \n\n- The given function is **not** invertible on the interval $(-3,0)$  because some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/d2ed3670f7c67d60c7739ee35d66943b8341b2a49faa97546242609dd39afabc.png)\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-108673/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60"] :knowledge-point/questions ["q-108673"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66482"] :question/worked-solution "The graph of the function $f(x)={x}^{2}+2$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units up to get $f(x)={x}^{2}+2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/ff3d1ac7500d83574b8671b23e99d4a0f1dbd6ab9cebc906aa06ff2c21f95345.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/a71ce036adc5dc0b15fce9e367a0c8512699dc6a7814f4e9a1886696d2abad6e.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in [0,\\infty )$ and  $x\\in (-\\infty ,0].$ On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/6858bd1fab8d9659c84fa941cd63ee9f509c8364dce0e753706c640ecfe6e9ec.png)\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-66725/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "eb199e1f-3386-5f7f-a3fd-e27d1aa32736" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-66725/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "7f6cf143-cbdc-53bf-8cd1-7055de3b64df" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-66725/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "514b617e-1470-5d45-ba92-53fbff4f153d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-66725/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "bd213512-1733-556a-b244-e6486893704f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-66725/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "f9086544-2c0f-52ec-ad94-5f2f5f708ed9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-66725/selection" :answer-field/id #uuid "53edd5a3-e1a4-57f0-a8a0-071b51fb43c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66725/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-66725/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-66725/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-66725/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-66725/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-66725/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-66725" :question/id #uuid "dd254a1a-f8a4-5f4b-b81d-c5dcb8bdc11d" :question/math-academy-id "q-66725" :question/is-example false :question/problem "Given that $f(x)=-x+3,$ on which of the following intervals is $f(x)$ invertible?\n\n- $x\\in (-\\infty ,\\infty )$\n- $x\\in (0.5,\\infty )$\n- $x\\in [-3,\\sqrt{2}]$" :question/worked-solution "The function $f(x)$ is a linear function with slope $-1$ and $y$-intercept $3,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/aaa05d1ab0fd630dacd81723fe00472cb901fb6f73af5f111f44459476191c0f.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (0.5,\\infty )$ and $x\\in [-3,\\sqrt{2}].$\n\nTherefore, the correct answer is \"I, II, and III\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66725/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d"] :knowledge-point/questions ["q-66725"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66778/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "6f8a037c-1c6f-5e11-8357-a6c2f4c47196" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-66778/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9f86b073-6dd1-50b1-927f-426838817586" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-66778/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8a6a1058-9104-57f5-9a7d-3ce1478fca05" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-66778/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1a48302a-dc3c-563b-9090-ce95e47df86b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-66778/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "78864212-ca2b-5e18-80ef-347c20e8df9d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-66778/selection" :answer-field/id #uuid "a8456194-4870-5651-9907-46e558f25a6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66778/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-66778/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-66778/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-66778/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-66778/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-66778/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-66778" :question/id #uuid "4fb981fb-d1de-5cf1-a91e-ec4693f30623" :question/math-academy-id "q-66778" :question/is-example false :question/problem "Given that $f(x)=|x+1|-3,$ on which of the following intervals is $f(x)$ invertible?\n\n- $x\\in (-\\infty ,1]$\n- $x\\in [1,\\infty )$\n- $x\\in (-\\infty ,-1]$" :question/worked-solution "The graph of the function $f(x)=|x+1|-3$ can be obtained in the following way:\n\n- Take the curve $y=|x|.$\n\n- Translate it by $1$ units to the left,  to get $y=|x+1|.$\n\n- Finally, translate $y=|x+1|$ by $3$ units down to get $f(x)=|x+1|-3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/3b9f56280089991c7db7652d84a777edd5c5e012921f0d48362f4fc3e4fd2a6e.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test. \n\n- The function $f(x)$ is invertible on each of the intervals $x\\in (-\\infty ,-1]$ and $x\\in [1,\\infty ).$ On these intervals, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/fd0b0fe70e009f43e80b0f712b6cfd576deb4c4c0457f61adae04cf7e44f140c.png)\n\n  \n\n- The function $f(x)$ is not invertible on the interval $x\\in (-\\infty ,1].$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/582ec1960b053731bf201c84d8c58fd4e1734a2b085cd5549a01aace4b600b4a.png)\n\n \n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66778/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d"] :knowledge-point/questions ["q-66778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66669/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0cd370f6-3c93-5eda-9eac-539bb3a27499" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-66669/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "7a35e99c-1b0e-5efc-bb12-73dbbc9be9ca" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-66669/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "1e600908-bcb8-5927-9a9e-62b963ec33b6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-66669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "3ebe1cc4-44ed-568a-8cfc-08b9188b8187" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-66669/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "0f299779-9645-5fec-9d18-5081087bfaf9" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-66669/selection" :answer-field/id #uuid "115f5585-6883-54bd-9a38-1df84dfaba64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-66669/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-66669/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-66669/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-66669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-66669/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-66669" :question/id #uuid "8d503350-373b-552d-8a35-6045ac022068" :question/math-academy-id "q-66669" :question/is-example false :question/problem "Given that $f(x)=(x-2{)}^{2},$ on which of the following intervals is $f(x)$ invertible?\n\n- $x\\in (2,\\infty )$\n- $x\\in (-1,5)$\n- $x\\in (-\\infty ,2]$" :question/worked-solution "The graph of the function $f(x)=(x-2{)}^{2},$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units  to  the right  $f(x)=(x-2{)}^{2}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/1e3ac550e35a3dc93b3e26e5834f763847b04f5133de02e368124f54dd2b9dd6.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-1,5).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/3ebb316ca122b6786b8ef501fc7c56f8e0e68c8cfc32e5801c493d38382fc26c.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in (2,\\infty )$  and $x\\in (-\\infty ,2].$  On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/86c7c9cacc7a3868565f33130563ffed0ca423aa087e76cc08d103ea171822ed.png)\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d"] :knowledge-point/questions ["q-66669"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66723"] :question/worked-solution "The function $f(x)$ is a linear function with slope $1$ and $y$-intercept $1,$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932058/assets/00d6394343d441ee10fa20ee029b8f89b52ff1e6ded8e7fdbe0756118212f1a8.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (-1,\\infty )$ and $x\\in (-10,5).$\n\nTherefore, the correct answer is \"I, II, and III\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]}]
