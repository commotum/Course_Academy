[{:db/id "q-250826/field-1/1d7716e1cad4e0adcf2420f6f88c21d49d8fd574d58ccf65d8621d13f9fcff76" :answer/id #uuid "c98d7d76-9213-5bfd-9865-88dc75073ba7" :answer/type :answer.type/math :answer/value "3.2" :db/ensure [:answer/validate]} {:db/id "q-250826/field-1" :answer-field/id #uuid "fde673a7-82df-57c0-97af-b737b43935a6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250826/field-1/1d7716e1cad4e0adcf2420f6f88c21d49d8fd574d58ccf65d8621d13f9fcff76" :answer-field/choices ["q-250826/field-1/1d7716e1cad4e0adcf2420f6f88c21d49d8fd574d58ccf65d8621d13f9fcff76"] :db/ensure [:answer-field/validate]} {:db/id "q-250826" :question/id #uuid "3ec12e89-df49-505f-87f0-09e7f188d155" :question/math-academy-id "q-250826" :question/problem "If the sum of the first $32$ terms of an arithmetic series is ${S}_{32}=648,$ and the last term is ${a}_{32}=37.3,$ then the first term of the series is ${a}_{1}=${{field-1}}." :question/worked-solution "We are given the last term of our series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nSubstituting ${a}_{32}=37.3$, $N=32$, and ${S}_{N}=648$ into the formula above and solving for ${a}_{1}$, we get\n\n$$\n\\begin{aligned}648 & =\\frac{32}{2}({a}_{1}+37.3) \\\\ 648 & =16({a}_{1}+37.3) \\\\ \\frac{648}{16} & ={a}_{1}+37.3 \\\\ 40.5 & ={a}_{1}+37.3 \\\\ {a}_{1} & =3.2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-250826/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d7a21aa-f2e3-5461-81a6-5cbd0f63c03d"] :knowledge-point/questions ["q-250826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-233787/field-1/7e65c4a96e497a890af95e6095bcb84da70635dbef2af74c5157528159efa3ff" :answer/id #uuid "502c605e-4428-5a1d-b76e-3c9c0467ba38" :answer/type :answer.type/math :answer/value "-2.2" :db/ensure [:answer/validate]} {:db/id 17592186075693 :answer-field/choices ["q-233787/field-1/7e65c4a96e497a890af95e6095bcb84da70635dbef2af74c5157528159efa3ff"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-233787"] :question/problem "If the sum of the first $50$ terms of an arithmetic series is ${S}_{50}=600,$ and the last term is ${a}_{50}=21.8,$ then the first term of the series is ${a}_{1}=${{field-1}}." :question/worked-solution "We are given the last term of our series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nSubstituting ${a}_{50}=21.8$, $N=50$, and ${S}_{N}=600$ into the formula above and solving for ${a}_{1}$, we get\n\n$$\n\\begin{aligned}600 & =\\frac{50}{2}({a}_{1}+21.8) \\\\ 600 & =25({a}_{1}+21.8) \\\\ \\frac{600}{25} & ={a}_{1}+21.8 \\\\ 24 & ={a}_{1}+21.8 \\\\ {a}_{1} & =2.2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-250824/field-1/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer/id #uuid "7f741519-dbc1-5f4f-81f9-6647f7131564" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "q-250824/field-1" :answer-field/id #uuid "9bdb5469-bd87-5679-894a-ce2f07603eb7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250824/field-1/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer-field/choices ["q-250824/field-1/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11"] :db/ensure [:answer-field/validate]} {:db/id "q-250824" :question/id #uuid "e3f57bb6-e095-5580-af3c-db798c84b3e1" :question/math-academy-id "q-250824" :question/problem "If the sum of the first $20$ terms of an arithmetic series is ${S}_{20}=-635,$ and the last term is ${a}_{20}=-65,$ then the first term of the series is ${a}_{1}=${{field-1}}." :question/worked-solution "We are given the last term of our series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}({a}_{1}+{a}_{N}),\n$$\n\nwhere ${a}_{1}$ is the first term, ${a}_{N}$ is the last term, and $N$ is the number of terms.\n\nSubstituting ${a}_{20}=-65$, $N=20$, and ${S}_{N}=-635$ into the formula above and solving for ${a}_{1}$, we get\n\n$$\n\\begin{aligned}-635 & =\\frac{20}{2}({a}_{1}+(-65)) \\\\ -635 & =10({a}_{1}-65) \\\\ -\\frac{635}{10} & ={a}_{1}-65 \\\\ -63.5 & ={a}_{1}-65 \\\\ {a}_{1} & =1.5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-250824/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d7a21aa-f2e3-5461-81a6-5cbd0f63c03d"] :knowledge-point/questions ["q-250824"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108630/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "7e647899-3041-58c5-b0a4-d1e8034f6b96" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-108630/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" :answer/id #uuid "18df0d97-5148-549f-8338-2a5221ff0cda" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-108630/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "1566f176-db34-5dcd-8a13-c7087a83f337" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-108630/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "4a5f8270-dd21-5c45-a6b5-76a9386ee0f8" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answ