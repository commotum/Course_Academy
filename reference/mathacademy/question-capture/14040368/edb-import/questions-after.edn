#{[{:db/id #edb/ref 17592186307055 :knowledge-point/_questions [{:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceee72aa-ee31-5323-8443-523f2234a0ce" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186307057} {:answer/id #uuid "8452cb91-7694-52d5-a8f7-64a61f1c102c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}(x+3)(x-3)^{2}" :db/id #edb/ref 17592186307058} {:answer/id #uuid "2c47a2dc-1e64-54ee-9a80-14d0dca49ca9" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{8}(x+3)(x-3)^{2}" :db/id #edb/ref 17592186307059} {:answer/id #uuid "f82d2a4d-807f-5a5c-93fa-f6f20429dd11" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{8}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186307060} {:answer/id #uuid "c4a63922-2589-5ebc-bba0-9c8f77371341" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186307061}] :answer-field/correct {:answer/id #uuid "f82d2a4d-807f-5a5c-93fa-f6f20429dd11" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{8}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186307060} :answer-field/id #uuid "be0e7474-ddca-5d74-85f5-84048b123a20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307056}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9907e86a-7f0e-52ec-b8f3-600094230c4d" :question/math-academy-id "q-102664" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=1-2t,\\,\\,\\,y=(t-2)^{2}(t+1),\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=1-2t\\,⇒\\,t=\\frac{1-x}{2}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{1-x}{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={(\\frac{1-x}{2}-2)}^{2}(\\frac{1-x}{2}+1) \\\\  & ={(\\frac{1-x-4}{2})}^{2}(\\frac{1-x+2}{2}) \\\\  & ={(\\frac{-x-3}{2})}^{2}(\\frac{3-x}{2}) \\\\  & =-\\frac{1}{8}(x+3)^{2}(x-3).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=-\\frac{1}{8}(x+3)^{2}(x-3).$"}] [{:db/id #edb/ref 17592186302853 :knowledge-point/_questions [{:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a19bcd5-75fd-56e9-b93c-1f0f33097874" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+(y-3)^{2}=1" :db/id #edb/ref 17592186302855} {:answer/id #uuid "f87de581-41ff-5ae5-87a1-e327c0722145" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=3" :db/id #edb/ref 17592186302856} {:answer/id #uuid "94bb46a3-ebab-5ca7-b8c6-b355e2600d21" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186302857} {:answer/id #uuid "5eafc569-c09a-5b83-b176-cad75ab16314" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302858} {:answer/id #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302859}] :answer-field/correct {:answer/id #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302859} :answer-field/id #uuid "d587d9eb-47a2-5b16-9a07-604038e8c3ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302854}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d6247c7-93e8-5757-8717-e162c7d262b7" :question/math-academy-id "q-15657" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-3,\\,\\,\\,y=\\operatorname{cos}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t-3\\, & ⇒\\,\\operatorname{sin}⁡t=x+3 \\\\ y=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=y.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n(x+3)^{2}+{y}^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(x+3)^{2}+{y}^{2}=1.$"}] [{:db/id #edb/ref 17592186307062 :knowledge-point/_questions [{:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f94cb9c0-1aef-5920-9e36-292ab6763aa4" :answer/type {:db/ident :answer.type/math} :answer/value "y=1-\\frac{{x}^{2}}{9}" :db/id #edb/ref 17592186307064} {:answer/id #uuid "e997ce2d-a1d4-59a7-b20d-754d3ed14510" :answer/type {:db/ident :answer.type/math} :answer/value "y=7(\\frac{{x}^{2}}{9}+1)" :db/id #edb/ref 17592186307065} {:answer/id #uuid "c541779d-bbe7-5c87-8f30-1ed1b67ea24f" :answer/type {:db/ident :answer.type/math} :answer/value "y=4(\\frac{2{x}^{2}}{9}-1)" :db/id #edb/ref 17592186307066} {:answer/id #uuid "e55f241a-779f-5e97-b1b7-f13353144ee3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{2}}{9}-1" :db/id #edb/ref 17592186307067} {:answer/id #uuid "ca950cea-4977-5929-b108-f1f297fada93" :answer/type {:db/ident :answer.type/math} :answer/value "y=1+\\frac{{x}^{2}}{6}" :db/id #edb/ref 17592186307068}] :answer-field/correct {:answer/id #uuid "c541779d-bbe7-5c87-8f30-1ed1b67ea24f" :answer/type {:db/ident :answer.type/math} :answer/value "y=4(\\frac{2{x}^{2}}{9}-1)" :db/id #edb/ref 17592186307066} :answer-field/id #uuid "1d956d25-b226-5c60-804c-520274c8dd5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307063}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a1295497-95f0-563c-9b4d-4d497affdde7" :question/math-academy-id "q-24575" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=-3\\operatorname{cos}⁡t,\\,\\,\\,y=4\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=-3\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=-\\frac{x}{3} \\\\ y=4\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{4}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=-\\frac{x}{3}$ and $\\operatorname{cos}⁡2t=\\frac{y}{4}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =2{(-\\frac{x}{3})}^{2}-1 \\\\ \\frac{y}{4} & =\\frac{2{x}^{2}}{9}-1 \\\\ y & =4(\\frac{2{x}^{2}}{9}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4(\\frac{2{x}^{2}}{9}-1).$"}] [{:db/id #edb/ref 17592186307069 :knowledge-point/_questions [{:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fedd790-b414-5df0-b803-c6a6e192da48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-3x}{7x-2}" :db/id #edb/ref 17592186307071} {:answer/id #uuid "48722a34-c240-5044-91ab-55900841e87d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-3x}{7x+2}" :db/id #edb/ref 17592186307072}] :answer-field/correct {:answer/id #uuid "3fedd790-b414-5df0-b803-c6a6e192da48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-3x}{7x-2}" :db/id #edb/ref 17592186307071} :answer-field/id #uuid "5a9c97f1-891e-564f-8f1f-38428b9f0bd3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307070} {:answer-field/choices [{:answer/id #uuid "db7f0568-4682-57f4-ac6a-4e4e92a2b0ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186307074}] :answer-field/correct {:answer/id #uuid "db7f0568-4682-57f4-ac6a-4e4e92a2b0ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186307074} :answer-field/id #uuid "741bd4b4-b682-5c8d-82e9-5875f1a98167" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307073}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "68b75bd8-3590-5aaa-ab0b-d5ba8601a2b1" :question/math-academy-id "q-320926" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{t+3},\\,\\,\\,y=\\frac{t}{-2t+1},\\,t\\ne -3,\\,\\,\\,t\\ne \\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}$,\\,\\,\\,x\\ne 0.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{t+3}\\,⇒\\,t=-3+\\frac{1}{x}\n$$\n\nNow, substituting $t=-3+\\frac{1}{x}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{(-3+\\frac{1}{x})}{(-2\\,(-3+\\frac{1}{x})+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(6-\\frac{2}{x}+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(7-\\frac{2}{x})} \\\\  & =\\frac{-3x+1}{\\cancel{x}}\\cdot \\frac{\\cancel{x}}{7x-2} \\\\  & =\\frac{1-3x}{7x-2}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{1-3x}{7x-2}.$\n\nFinally, since $t\\ne \\frac{1}{2}$ and $x=\\frac{1}{t+3}$ has range $x\\ne 0,$ we must have \n$x\\ne \\frac{2}{7},\\text{ }0.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{1-3x}{7x-2},\\,x\\ne \\frac{2}{7},\\,\\,\\,x\\ne 0.\n$$"}] [{:db/id #edb/ref 17592186307075 :knowledge-point/_questions [{:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2d7fdfb-7593-576b-95d5-708df9d988cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2}{9}+(y+2)^2" :db/id #edb/ref 17592186307077}] :answer-field/correct {:answer/id #uuid "b2d7fdfb-7593-576b-95d5-708df9d988cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2}{9}+(y+2)^2" :db/id #edb/ref 17592186307077} :answer-field/id #uuid "ce949294-a5bb-59b8-b616-d52224c4ba47" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307076}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bc324745-12fd-530c-8527-373071b9f1c2" :question/math-academy-id "q-320946" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=3\\operatorname{sin}⁡t,\\,\\,\\,y=\\operatorname{cos}⁡t-2,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n{{field-1}}$=1.$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{3} \\\\ y=\\operatorname{cos}⁡t-2\\, & ⇒\\,\\operatorname{cos}⁡t=y+2\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{(\\frac{x}{3})}^{2}+(y+2)^{2} & =1 \\\\ \\frac{1}{9}{x}^{2}+(y+2)^{2} & =1.\\end{aligned}\n$$"}]}
