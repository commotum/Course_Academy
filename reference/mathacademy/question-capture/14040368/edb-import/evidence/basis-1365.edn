#{[{:db/id #edb/ref 17592186302853 :knowledge-point/_questions [{:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically With Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a19bcd5-75fd-56e9-b93c-1f0f33097874" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+(y-3)^{2}=1" :db/id #edb/ref 17592186302855} {:answer/id #uuid "f87de581-41ff-5ae5-87a1-e327c0722145" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=3" :db/id #edb/ref 17592186302856} {:answer/id #uuid "94bb46a3-ebab-5ca7-b8c6-b355e2600d21" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186302857} {:answer/id #uuid "5eafc569-c09a-5b83-b176-cad75ab16314" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302858} {:answer/id #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302859}] :answer-field/correct {:answer/id #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+{y}^{2}=1" :db/id #edb/ref 17592186302859} :answer-field/id #uuid "d587d9eb-47a2-5b16-9a07-604038e8c3ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302854}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d6247c7-93e8-5757-8717-e162c7d262b7" :question/math-academy-id "q-15657" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-3,\\,\\,\\,y=\\operatorname{cos}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t-3\\, & ⇒\\,\\operatorname{sin}⁡t=x+3 \\\\ y=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=y.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n(x+3)^{2}+{y}^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(x+3)^{2}+{y}^{2}=1.$"}]}
