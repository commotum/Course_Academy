\frac{\\pi }{2}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =\\operatorname{sin}⁡x\\cdot (0)-\\operatorname{cos}⁡x\\cdot (1) \\\\  & =-\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256169 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a17055-da4a-5052-88d8-97b80c8598c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256171} {:answer/id #uuid "7ca5291a-bc45-5834-b658-77d532fc1625" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256172} {:answer/id #uuid "e951fcc1-6cc2-5679-8aa6-3b01b288f925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256173} {:answer/id #uuid "b50e7c34-7cb2-5ac1-870a-0185ebd9237e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256174} {:answer/id #uuid "852f33e2-94d3-5f14-a474-c3c53547cc54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256175}] :answer-field/correct {:answer/id #uuid "e951fcc1-6cc2-5679-8aa6-3b01b288f925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256173} :answer-field/id #uuid "06e98bff-f4cd-53dc-95ee-ab2032113a87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256170}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fc99c212-2992-5cfb-b10c-7267f29b028a" :question/math-academy-id "q-142025" :question/problem "$\\operatorname{sin}⁡(x+\\frac{4\\pi }{3})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{4\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{\\pi }{6}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{4\\pi }{3})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})+\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}-\\sqrt{3}\\frac{\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060025 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5197ab4-4e77-5da4-a06e-95284d6f010f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} - \\sqrt{2}}{4}" :db/id #edb/ref 17592186056870} {:answer/id #uuid "10934ea1-aaa6-5df7-9018-8a7d96895c9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} - \\sqrt{6}}{2}" :db/id #edb/ref 17592186056871} {:answer/id #uuid "435d6fcb-7928-5703-a3af-cd0fa64e1d1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} + \\sqrt{2}}{2}" :db/id #edb/ref 17592186056872} {:answer/id #uuid "5805d066-53f8-5759-ac95-75e64893aa70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} + \\sqrt{2}}{4}" :db/id #edb/ref 17592186056873} {:answer/id #uuid "5859ca7e-67fd-5c52-9689-50ed3b39d57b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} + \\sqrt{2}}{4}" :db/id #edb/ref 17592186056874}] :answer-field/correct {:answer/id #uuid "5805d066-53f8-5759-ac95-75e64893aa70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6} + \\sqrt{2}}{4}" :db/id #edb/ref 17592186056873} :answer-field/id #uuid "67fb2ff1-7b31-51c5-8b58-e24086e85c4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056869}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d93d90d2-8105-59cb-a801-47640240ddbd" :question/math-academy-id "q-1708" :question/problem "What is the exact value of $\\sin (\\frac{5π}{12})$?\n\n*Hint: Use the fact that $\\frac{5π}{12} = \\frac{π}{4} + \\frac{π}{6}$.*" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(x+y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y+\\operatorname{cos}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for sine with $x=\\frac{\\pi }{4}$ and $y=\\frac{\\pi }{6}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{5\\pi }{12}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}+\\frac{\\pi }{6}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\operatorname{cos}⁡(\\frac{\\pi }{4})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{6}+\\sqrt{2}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256176 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b410810-c759-5901-9fdb-3abd6050bc98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256178}] :answer-field/correct {:answer/id #uuid "3b410810-c759-5901-9fdb-3abd6050bc98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256178} :answer-field/id #uuid "df3c9c2d-31e4-5e1d-80dd-b627e2b65d06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256177}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "62115611-6812-5fe4-88b8-5e2a1338a624" :question/math-academy-id "q-274557" :question/problem "Using the fact that ${75}^{∘}={135}^{∘}-{60}^{∘},$\ncalculate the **exact** value of $\\operatorname{sin}⁡{75}^{∘}.$\n\n$\\operatorname{sin}⁡({75}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(x-y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-\\operatorname{cos}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for sine with $x={135}^{∘}$ and $y={60}^{∘},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡{75}^{∘} & =\\operatorname{sin}⁡({135}^{∘}-{60}^{∘}) \\\\  & =\\operatorname{sin}⁡{135}^{∘}\\operatorname{cos}⁡{60}^{∘}-\\operatorname{cos}⁡{135}^{∘}\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2}-(-\\frac{\\sqrt{2}}{2})\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\  & =\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256179 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f379c7-29f3-59ee-8926-22ea1347a0d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186256181}] :answer-field/correct {:answer/id #uuid "11f379c7-29f3-59ee-8926-22ea1347a0d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186256181} :answer-field/id #uuid "d428d16a-3a39-561c-aa4f-04aca22396a6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256180} {:answer-field/choices [{:answer/id #uuid "7a127341-75fd-5f5c-af7c-da19ee197736" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186256183}] :answer-field/correct {:answer/id #uuid "7a127341-75fd-5f5c-af7c-da19ee197736" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186256183} :answer-field/id #uuid "10dd25a6-26c2-582b-bc2d-a494c200bab3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55a7ad5d-18c6-5be2-91c1-af9dca8455b9" :question/math-academy-id "q-332180" :question/problem "Express $\\operatorname{sin}⁡(x-{330}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{330}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={330}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{330}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{330}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{330}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{3}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256184 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff24b77-f98b-5d96-9e59-c43859fdaa36" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256186}] :answer-field/correct {:answer/id #uuid "1ff24b77-f98b-5d96-9e59-c43859fdaa36" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256186} :answer-field/id #uuid "8e633081-e8ba-5bea-813e-6226d64aa2a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256185} {:answer-field/choices [{:answer/id #uuid "f5e1686c-1e01-597b-8da8-99f341349c92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256188}] :answer-field/correct {:answer/id #uuid "f5e1686c-1e01-597b-8da8-99f341349c92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256188} :answer-field/id #uuid "656c255b-1781-5192-9969-89b9a5b0401c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256187}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "61b76c91-5479-5f0c-be33-9c66ee258fcb" :question/math-academy-id "q-332188" :question/problem "Express $sin\\,(x+\\frac{7\\pi }{4})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$sin\\,(x+\\frac{7\\pi }{4})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,-$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{7\\pi }{4},$ we get\n\n$$\n\\begin{aligned}sin\\,(x+\\frac{7\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡\\frac{7\\pi }{4}+\\operatorname{cos}⁡x\\operatorname{sin}⁡\\frac{7\\pi }{4} \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})+\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060200 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98feb3a2-fe47-5684-91d1-2ec37a1de332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}(\\sin x - \\cos x)" :db/id #edb/ref 17592186058184} {:answer/id #uuid "ae04796f-78fc-54d5-a610-750af24422ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\sin x - \\cos x)" :db/id #edb/ref 17592186058185} {:answer/id #uuid "b53a3c7a-f62d-5dc4-b8e8-8611ff6fd501" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\sin x + \\cos x)" :db/id #edb/ref 17592186058186} {:answer/id #uuid "f2d4d77b-476c-5ee1-956e-32ae340df119" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\cos x - \\sin x)" :db/id #edb/ref 17592186058187} {:answer/id #uuid "62e51e7a-9b02-5161-83e7-1ade11040899" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sin x - \\cos x)" :db/id #edb/ref 17592186058188}] :answer-field/correct {:answer/id #uuid "ae04796f-78fc-54d5-a610-750af24422ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\sin x - \\cos x)" :db/id #edb/ref 17592186058185} :answer-field/id #uuid "0c2ca764-2c34-505f-a29d-c57ce8ec16bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058183}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f043b7ca-be08-556b-94ec-1d757642bb0f" :question/math-academy-id "q-43383" :question/problem "What is $\\sin (x - \\frac{π}{4})$?" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256189 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b707cb5c-d738-5414-ac4a-ac286c6b57b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256191} {:answer/id #uuid "35ed7a4c-e2f2-52b9-97e7-a5b5c2bb73e9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256192} {:answer/id #uuid "7a39ecc6-e407-55b8-af74-9818c3534591" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{4}" :db/id #edb/ref 17592186256193} {:answer/id #uuid "a472cacf-5e53-5141-88cc-30978db055af" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{3}}{4}" :db/id #edb/ref 17592186256194} {:answer/id #uuid "780e9cb6-a3e0-5f56-a047-fd648dfab5d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186256195}] :answer-field/correct {:answer/id #uuid "35ed7a4c-e2f2-52b9-97e7-a5b5c2bb73e9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256192} :answer-field/id #uuid "5e4ffd16-296a-596b-887f-30628090b4be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256190}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "42a4d9da-f1b0-59e3-b817-4de8af8534c3" :question/math-academy-id "q-65427" :question/problem "What is the exact value of $\\operatorname{sin}⁡(-{105}^{∘})?$\n\n*Hint: Use the fact that $-{105}^{∘}={30}^{∘}-{135}^{∘}.$*" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(x-y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-\\operatorname{cos}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for sine with $x={30}^{∘}$ and $y={135}^{∘},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(-{105}^{∘}) & =\\operatorname{sin}⁡({30}^{∘}-{135}^{∘}) \\\\  & =\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{135}^{∘}-\\operatorname{cos}⁡{30}^{∘}\\operatorname{sin}⁡{135}^{∘} \\\\  & =\\frac{1}{2}\\cdot (-\\frac{\\sqrt{2}}{2})-\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256196 :knowledge-point/_questions [{:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b735f089-c71e-5bc6-a3fd-1c8bcb25fe03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186256198} {:answer/id #uuid "fa71039a-eef5-5bfd-9ffc-443c2ab1d01c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186256199} {:answer/id #uuid "c7f97183-dfbd-5e58-844d-d013f8e69ca1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256200} {:answer/id #uuid "893a0e17-d38c-5030-9402-80cbc2d8864e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186256201} {:answer/id #uuid "5b80c9da-8b2d-56b3-a6c9-9c9cd7141a34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186256202}] :answer-field/correct {:answer/id #uuid "893a0e17-d38c-5030-9402-80cbc2d8864e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186256201} :answer-field/id #uuid "1388bf6c-a3c0-56c0-ab35-9e8a697c12a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256197}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "88e811b0-72e3-5ee2-987a-52c239d19e8b" :question/math-academy-id "q-65430" :question/problem "What is the exact value of $\\operatorname{sin}⁡(\\frac{11\\pi }{12})?$\n\n*Hint: Use the fact that $\\frac{11\\pi }{12}=\\frac{7\\pi }{6}-\\frac{\\pi }{4}.$*" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(x-y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-\\operatorname{cos}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for sine with $x=\\frac{7\\pi }{6}$ and $y=\\frac{\\pi }{4}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{11\\pi }{12}) & =\\operatorname{sin}⁡(\\frac{7\\pi }{6}-\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(\\frac{7\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(\\frac{7\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =(-\\frac{1}{2})\\cdot \\frac{\\sqrt{2}}{2}-(-\\frac{\\sqrt{3}}{2})\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{6}-\\sqrt{2}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256203 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59d3cacb-f0f0-59aa-a1b6-7ccd1b4cd928" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256205} {:answer/id #uuid "0dadc94d-fcff-5432-a726-c6d27a34c663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256206} {:answer/id #uuid "8e48325c-ee5b-5522-b0f5-823aa4440b8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186256207} {:answer/id #uuid "347a1962-6fb7-5ad0-a0e8-3e14e77139c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256208} {:answer/id #uuid "cb4d776e-1f4f-54a8-9ba8-bb110463c168" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186256209}] :answer-field/correct {:answer/id #uuid "8e48325c-ee5b-5522-b0f5-823aa4440b8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186256207} :answer-field/id #uuid "e6bd4ffc-26cd-579a-ab5e-d4a324ccf29f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256204}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "39a2861c-f473-5813-ae7e-8448a98496f2" :question/math-academy-id "q-65437" :question/problem "$\\operatorname{sin}⁡(x+\\frac{\\pi }{4})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060275 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fc6e61-4b9f-55fe-9467-d6ffe4d7f9e1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(\\sin x + \\cos x)" :db/id #edb/ref 17592186058634} {:answer/id #uuid "97261f1e-73d3-55a4-92c0-1fc342fe2657" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\cos x - \\sin x)" :db/id #edb/ref 17592186058635} {:answer/id #uuid "a29b3579-efae-5e49-b6d6-3a164b64711b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\sin x - \\cos x}{2}" :db/id #edb/ref 17592186058636} {:answer/id #uuid "ad92b818-d7ad-59f1-80e9-6f27d28b927e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\sin x + \\cos x)" :db/id #edb/