x$ and $v={330}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{330}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{330}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{330}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{3}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332180/field-1" "q-332180/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4"] :knowledge-point/questions ["q-332180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142025/selection/4b098d8883ebf2ba53c3601846fe278f4795f8ac00c0d681adaeae0c20d765d8" :answer/id #uuid "b50e7c34-7cb2-5ac1-870a-0185ebd9237e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-142025/selection/06c129a163c97006369bb0806e7b9e704714ecf801adbcbb3dc7754660f94847" :answer/id #uuid "52a17055-da4a-5052-88d8-97b80c8598c4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-142025/selection/32fa7800f5553992514df42309e048cec7a79fe30e6a7a1e93b45bd1de161bae" :answer/id #uuid "e951fcc1-6cc2-5679-8aa6-3b01b288f925" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-142025/selection/0b590b8931b52d303485734f4a04c1ccffc1053e2f81df83bd215c3c11195ae6" :answer/id #uuid "7ca5291a-bc45-5834-b658-77d532fc1625" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-142025/selection/b47314a97a54