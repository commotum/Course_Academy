fc4a54af7fc14996112136bc8a5ee67f1b6c263cdac" "q-65437/selection/2f7e33ed1d657bfa95e2d4ed8f7d694e8a6ad321bdc461d2ce3b9605c7a81d46" "q-65437/selection/b47314a97a54e45d80cd55506f2439e3aa5a9e91692dc91b10f98189bf794419" "q-65437/selection/bb9ea564fb994b93561b9ad37070caf0942b15a289b73153073fc60a218622be" "q-65437/selection/9e0a763344d6220ddcf5d5dbe02e664371db35b32ddb54c7e5fbe5598c03f32b"] :db/ensure [:answer-field/validate]} {:db/id "q-65437" :question/id #uuid "39a2861c-f473-5813-ae7e-8448a98496f2" :question/math-academy-id "q-65437" :question/problem "$\\operatorname{sin}⁡(x+\\frac{\\pi }{4})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65437/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de"] :knowledge-point/questions ["q-65437"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-43383"] :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{\\sqrt{2}}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-141284/selection/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" :answer/id #uuid "a3ec7978-3c5e-504f-ad1a-564592d17074" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141284/selection/376b7e6657094b6f27cfd097d0316675d1ce4f8d239bebcb30613cfcfa6702c5" :answer/id #uuid "acd1d166-60a6-57a7-9346-61399f9eaaf1" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-141284/selection/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" :answer/id #uuid "480eac04-49ae-5f3d-89e1-88810ee4b020" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-141284/selection/368797d5118e1201063d8ae15ba56c1c486308d78c9aee2f8c81df21f6d16087" :answer/id #uuid "d637b734-bac4-50a7-aee0-a3cad15beee7" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141284/selection/aec903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4" :answer/id #uuid "c1a4d7f0-7073-512a-8b0f-b6f37bb99610" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-141284/selection" :answer-field/id #uuid "3b373fcb-e691-5be2-ae8b-d19c6c473206" :answer-field/key "selection" :answer-field/type :a