lection/fc327a263c0643e9fc0bb9e6c7219e2f56483d54e38294609be696bdf070041e" "q-65430/selection/2e322c183dbc7d1ea89480e5179cfacfe0785b47fba2faa443ef41c049164964"] :db/ensure [:answer-field/validate]} {:db/id "q-65430" :question/id #uuid "88e811b0-72e3-5ee2-987a-52c239d19e8b" :question/math-academy-id "q-65430" :question/problem "What is the exact value of $\\operatorname{sin}⁡(\\frac{11\\pi }{12})?$\n\n*Hint: Use the fact that $\\frac{11\\pi }{12}=\\frac{7\\pi }{6}-\\frac{\\pi }{4}.$*" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(x-y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y-\\operatorname{cos}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for sine with $x=\\frac{7\\pi }{6}$ and $y=\\frac{\\pi }{4}$, we obtain\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{11\\pi }{12}) & =\\operatorname{sin}⁡(\\frac{7\\pi }{6}-\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(\\frac{7\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(\\frac{7\\pi }{6})\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =(-\\frac{1}{2})\\cdot \\frac{\\sqrt{2}}{2}-(-\\frac{\\sqrt{3}}{2})\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{6}-\\sqrt{2}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65430/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "213eda96-c41d-5361-9da9-8349617014f1"] :knowledge-point/questions ["q-65430"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119007/selection/d0d61c54762d9b488f480bc471fc698475d8cbd85b0b3c6bd26403e4e57dcd69" :answer/id #uuid "617e3053-e2df-5bcf-9956-b1393c90b5ab" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119007/selection/5054635cad4fcbc98cab82d2769a162bbd97df66191eab7a2c3d78704b6740bd" :answer/id #uuid "9db298b6-b43c-5118-821f-e87730da0fde" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}+\\sqrt{2}}