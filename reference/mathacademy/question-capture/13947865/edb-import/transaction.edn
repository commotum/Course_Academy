frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332188/field-1" "q-332188/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de"] :knowledge-point/questions ["q-332188"] :db/ensure [:knowledge-point/validate]}]
