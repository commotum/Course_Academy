#{[{:db/id #edb/ref 17592186326416 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baac03c2-5594-5d6d-afe6-d11f2e4af0af" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186326418} {:answer/id #uuid "8f481d6f-8d90-54b7-a5fa-650497b3a7ba" :answer/type {:db/ident :answer.type/math} :answer/value "-125" :db/id #edb/ref 17592186326419} {:answer/id #uuid "82837abc-9914-5634-a56e-cbcaa750236a" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186326420} {:answer/id #uuid "249f7f9c-87a9-52ce-aef3-ae224f992091" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186326421} {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422}] :answer-field/correct {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422} :answer-field/id #uuid "232cbb19-7070-5995-9c13-5f120cbc0d60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326417}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "179f7f4a-7495-5cce-8a55-25ec8c046a62" :question/math-academy-id "q-131096" :question/problem "Calculate the determinant of the matrix\n$D=[\\begin{aligned}0 & 0 & 0 & 1 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 1 & 2 & 3 \\\\ 6 & 5 & 3 & 0\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(D) & ={d}_{11}{C}_{11}+{d}_{12}{C}_{12}+{d}_{13}{C}_{13}+{d}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+1\\cdot {C}_{14} \\\\  & =1{C}_{14} \\\\  & =1\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 1 \\\\ 0 & 4 & 0 & ∗ \\\\ 0 & 1 & 2 & ∗ \\\\ 6 & 5 & 3 & ∗\\end{aligned}| \\\\  & =1(-1)^{1+4}|\\begin{aligned}0 & 4 & 0 \\\\ 0 & 1 & 2 \\\\ 6 & 5 & 3\\end{aligned}| \\\\  & =-1(0\\cdot |\\begin{aligned}1 & 2 \\\\ 5 & 3\\end{aligned}|-4\\cdot |\\begin{aligned}0 & 2 \\\\ 6 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 6 & 5\\end{aligned}|) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326430 :knowledge-point/_questions [{:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aeb1a24c-9e55-50ba-8ddb-52ab32da0658" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 2 & 0 \\\\ 1 & 3 & 5 \\\\ 0 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186326432} {:answer/id #uuid "c0033cfc-f631-5db4-9d33-3e51d742e348" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186326433} {:answer/id #uuid "f81c3fbc-9329-50cf-9fb2-61aafb3137c0" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 0 & 5 \\\\ -7 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186326434} {:answer/id #uuid "4f1b72a1-f86b-5c21-81c2-1d4f874329fa" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-2 & 2 & 0 \\\\ 0 & 2 & -2 \\\\ -7 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186326435} {:answer/id #uuid "cf0b953a-e3f9-5cfc-b762-164e75ae1084" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 0 \\\\ 1 & 3 & 5 \\\\ 0 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186326436}] :answer-field/correct {:answer/id #uuid "c0033cfc-f631-5db4-9d33-3e51d742e348" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186326433} :answer-field/id #uuid "f9e4c8a0-b9b8-580d-b345-94c8ee59b01c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326431}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dc203d1d-4257-5339-9a9d-96833ce028df" :question/math-academy-id "q-36043" :question/problem "Find the cofactor of ${b}_{34}$ in \n$B=[\\begin{aligned}-2 & 2 & 3 & 0 \\\\ 1 & 3 & 0 & 5 \\\\ 0 & 2 & 1 & -2 \\\\ -7 & 0 & 0 & 3\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${b}_{34}$, we remove the $3$rd row and the $4$th column: \n\n$$\nB=[\\begin{aligned}-2 & 2 & 3 & ∗ \\\\ 1 & 3 & 0 & ∗ \\\\ ∗ & ∗ & ∗ & -2 \\\\ -7 & 0 & 0 & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${b}_{34}$ is\n\n$$\n\\begin{aligned}{C}_{34} & =(-1)^{3+4}{M}_{34} \\\\  & =-{M}_{34} \\\\  & =-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$"}]}
