 3\\end{aligned}|" :db/id #edb/ref 17592186326435} {:answer/id #uuid "cf0b953a-e3f9-5cfc-b762-164e75ae1084" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 0 \\\\ 1 & 3 & 5 \\\\ 0 & 2 & -2\\end{aligned}|" :db/id #edb/ref 17592186326436}] :answer-field/correct {:answer/id #uuid "c0033cfc-f631-5db4-9d33-3e51d742e348" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186326433} :answer-field/id #uuid "f9e4c8a0-b9b8-580d-b345-94c8ee59b01c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326431}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dc203d1d-4257-5339-9a9d-96833ce028df" :question/math-academy-id "q-36043" :question/problem "Find the cofactor of ${b}_{34}$ in \n$B=[\\begin{aligned}-2 & 2 & 3 & 0 \\\\ 1 & 3 & 0 & 5 \\\\ 0 & 2 & 1 & -2 \\\\ -7 & 0 & 0 & 3\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${b}_{34}$, we remove the $3$rd row and the $4$th column: \n\n$$\nB=[\\begin{aligned}-2 & 2 & 3 & ∗ \\\\ 1 & 3 & 0 & ∗ \\\\ ∗ & ∗ & ∗ & -2 \\\\ -7 & 0 & 0 & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${b}_{34}$ is\n\n$$\n\\begin{aligned}{C}_{34} & =(-1)^{3+4}{M}_{34} \\\\  & =-{M}_{34} \\\\  & =-|\\begin{aligned}-2 & 2 & 3 \\\\ 1 & 3 & 0 \\\\ -7 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309319 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347ef0fd-a81d-53f9-92c4-f8d67ad6ec95" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186309321} {:answer/id #uuid "6017ae45-a08f-543c-b5d0-52dff35ae102" :answer/type {:db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186309322} {:answer/id #uuid "5b78316c-dd1e-5257-9c2a-e1ea54ad016d" :answer/type {:db/ident :answer.type/math} :answer/value "-51" :db/id #edb/ref 17592186309323} {:answer/id #uuid "931dc1f4-35c6-5465-bde2-cbd7472cd65e" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186309324} {:answer/id #uuid "c8050bf2-c812-508f-8b32-bec260e615c2" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186309325}] :answer-field/correct {:answer/id #uuid "6017ae45-a08f-543c-b5d0-52dff35ae102" :answer/type {:db/ident :answer.type/math} :answer/value "-62" :db/id #edb/ref 17592186309322} :answer-field/id #uuid "66c3b9ce-36b7-5ca9-a937-b9ad6a3024e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309320}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "847eae56-3846-5fab-8026-233085fa9f12" :question/math-academy-id "q-36045" :question/problem "Calculate the determinant of the matrix\n$Z=[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & -3 & 5 & 4 \\\\ 0 & 4 & 3 & 5\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+(-1)\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}-{C}_{13} \\\\  & =1\\cdot |\\begin{aligned}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & -3 & 5 & 4 \\\\ ∗ & 4 & 3 & 5\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & -1 & ∗ \\\\ 0 & 0 & ∗ & 0 \\\\ 0 & -3 & ∗ & 4 \\\\ 0 & 4 & ∗ & 5\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|+(-1)\\cdot (-1)^{1+3}|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|-|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =(0\\cdot |\\begin{aligned}5 & 4 \\\\ 3 & 5\\end{aligned}|-(-2)\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}-3 & 5 \\\\ 4 & 3\\end{aligned}|)-(0\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|-0\\cdot |\\begin{aligned}0 & 4 \\\\ 0 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}0 & -3 \\\\ 0 & 4\\end{aligned}|) \\\\  & =0+2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0-(0-0+0) \\\\  & =2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}| \\\\  & =2((-3)\\cdot 5-4\\cdot 4) \\\\  & =2\\cdot (-31) \\\\  & =-62\\end{aligned}\n$$"}]}
