\ 5 & 3\\end{aligned}|-4\\cdot |\\begin{aligned}0 & 2 \\\\ 6 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 6 & 5\\end{aligned}|) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309299 :knowledge-point/_questions [{:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280e95c5-3f84-5fb6-bb3d-ccccb96fea5c" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & 8 & -2 & 1 \\\\ 6 & 2 & -9 & -1 \\\\ 1 & 5 & 2 & 0 \\\\ -1 & 4 & 3 & 2\\end{aligned}|" :db/id #edb/ref 17592186309301} {:answer/id #uuid "0717789c-241d-52d3-9cf8-4b53b1661a2f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 8 & -2 & 1 \\\\ 6 & 2 & -9 & -1 \\\\ 1 & 5 & 2 & 0 \\\\ -1 & 4 & 3 & 2\\end{aligned}|" :db/id #edb/ref 17592186309302} {:answer/id #uuid "a8fb6d5c-d554-5afb-b696-df5aa51b6a71" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}7 & -3 & 4 & 2 \\\\ 8 & -2 & 0 & 1 \\\\ 2 & -9 & 4 & -1 \\\\ 5 & 2 & 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186309303} {:answer/id #uuid "dcbe8a3d-3be0-5e78-9588-5d6ca969406f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|" :db/id #edb/ref 17592186309304} {:answer/id #uuid "eead6dd2-b700-55b4-8478-2f6b793cdbfc" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|" :db/id #edb/ref 17592186309305}] :answer-field/correct {:answer/id #uuid "dcbe8a3d-3be0-5e78-9588-5d6ca969406f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|" :db/id #edb/ref 17592186309304} :answer-field/id #uuid "9585fb38-1f53-5bf9-92dc-ed8e675bb8d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309300}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f1bc6daa-53f0-51ba-94e5-aef13e4c2d91" :question/math-academy-id "q-32793" :question/problem "Find the cofactor of ${d}_{15}$ in \n$D=[\\begin{aligned}1 & 7 & -3 & 4 & 2 \\\\ 0 & 8 & -2 & 0 & 1 \\\\ 6 & 2 & -9 & 4 & -1 \\\\ 1 & 5 & 2 & 1 & 0 \\\\ -1 & 4 & 3 & 10 & 2\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${d}_{15}$, we remove the $1$st row and $5$th column: \n\n$$\nD=[\\begin{aligned}∗ & ∗ & ∗ & ∗ & 2 \\\\ 0 & 8 & -2 & 0 & ∗ \\\\ 6 & 2 & -9 & 4 & ∗ \\\\ 1 & 5 & 2 & 1 & ∗ \\\\ -1 & 4 & 3 & 10 & ∗\\end{aligned}]\n$$\n\n \nSo, the minor is \n\n$$\n{M}_{15}=|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|.\n$$\n\nTherefore, the cofactor of ${d}_{15}$ is\n\n$$\n\\begin{aligned}{C}_{15} & =(-1)^{1+5}{M}_{15} \\\\  & ={M}_{15} \\\\  & =|\\begin{aligned}0 & 8 & -2 & 0 \\\\ 6 & 2 & -9 & 4 \\\\ 1 & 5 & 2 & 1 \\\\ -1 & 4 & 3 & 10\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120138 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cf96559-d15d-5d46-b82e-9867f3e76df1" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186117349} {:answer/id #uuid "a25cc8da-6ff1-541d-a96e-66eae2c114c7" :answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186117350} {:answer/id #uuid "b82e2f65-4085-5175-a78b-20b556a9c38a" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186117351} {:answer/id