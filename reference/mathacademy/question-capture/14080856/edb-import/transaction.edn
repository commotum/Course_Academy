0 & 1 & 2\\end{aligned}|+(-1)\\cdot (-1)^{4+1}|\\begin{aligned}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 0 & 8 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 2\\end{aligned}|+|\\begin{aligned}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{aligned}| \\\\  & =-(0\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}|+8\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|)+(0\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|+0\\cdot |\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|) \\\\  & =8\\cdot (-1)+(-3)\\cdot 1 \\\\  & =-8-3 \\\\  & =-11\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-131123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e"] :knowledge-point/questions ["q-131123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36053/selection/f30dd034bba82cd3c07b30b5632e5650aa13f430f17f7fc6b6682ec635c4ee3f" :answer/id #uuid "0a0a5386-82d8-5130-8e03-8fb8f36be995" :answer/type :answer.type/math :answer/value "157" :db/ensure [:answer/validate]} {:db/id "q-36053/selection/81cdca96c6a3c26678e622d8c159144757ded0bde2666fb22b8c4d8c09b17aa1" :answer/id #uuid "f3a54f04-3935-5bf7-b165-fb8ca242ffcd" :answer/type :answer.type/math :answer/value "148" :db/ensure [:answer/validate]} {:db/id "q-36053/selection/9a6a718f2435acb4f68a7dfa1b8ee8ccda88dd8959d0dfc98658956326c6e320" :answer/id #uuid "a23d11bf-51d3-5b95-bbef-3da89187419f" :answer/type :answer.type/math :answer/value "-178" :db/ensure [:answer/validate]} {:db/id "q-36053/selection/0771d18ec8ad75312361ca2a0480fa659f0ea3b003faff563364c2603d6a9ae5" :answer/id #uuid "a854e73a-8b29-5f86-8d48-3f2d7d22fa59" :answer/type :answer.type/math :answer/value "-371" :db/ensure [:answer/validate]} {:db/id "q-36053/selection/76da391199c7c0055883be9f3f4e9942c2c66c2d57814df96f93a604