e/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/edb-import/verification.json"} {"question" "q-36045" "field" nil "attribute" "question/problem" "value" "Calculate the determinant of the matrix\n$Z=[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & -3 & 5 & 4 \\\\ 0 & 4 & 3 & 5\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/state.json" "file_sha256" "bad8bf355a2d98eb4d09c16da2e9a1b14334a08a175647bfc8ad054277c71a4e" "basis" 1462 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/edb-import/verification.json"} {"question" "q-36045" "field" nil "attribute" "question/worked-solution" "value" "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(Z) & ={z}_{11}{C}_{11}+{z}_{12}{C}_{12}+{z}_{13}{C}_{13}+{z}_{14}{C}_{14} \\\\  & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+(-1)\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & ={C}_{11}-{C}_{13} \\\\  & =1\\cdot |\\begin{aligned}1 & ∗ & ∗ & ∗ \\\\ ∗ & 0 & -2 & 0 \\\\ ∗ & -3 & 5 & 4 \\\\ ∗ & 4 & 3 & 5\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & -1 & ∗ \\\\ 0 & 0 & ∗ & 0 \\\\ 0 & -3 & ∗ & 4 \\\\ 0 & 4 & ∗ & 5\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+1}|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|+(-1)\\cdot (-1)^{1+3}|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 & 0 \\\\ -3 & 5 & 4 \\\\ 4 & 3 & 5\\end{aligned}|-|\\begin{aligned}0 & 0 & 0 \\\\ 0 & -3 & 4 \\\\ 0 & 4 & 5\\end{aligned}| \\\\  & =(0\\cdot |\\begin{aligned}5 & 4 \\\\ 3 & 5\\end{aligned}|-(-2)\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}-3 & 5 \\\\ 4 & 3\\end{aligned}|)-(0\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|-0\\cdot |\\begin{aligned}0 & 4 \\\\ 0 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}0 & -3 \\\\ 0 & 4\\end{aligned}|) \\\\  & =0+2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}|+0-(0-0+0) \\\\  & =2\\cdot |\\begin{aligned}-3 & 4 \\\\ 4 & 5\\end{aligned}| \\\\  & =2((-3)\\cdot 5-4\\cdot 4) \\\\  & =2\\cdot (-31) \\\\  & =-62\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/state.json" "file_sha256" "bad8bf355a2d98eb4d09c16da2e9a1b14334a08a175647bfc8ad054277c71a4e" "basis" 1462 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/edb-import/verification.json"} {"question" "q-36045" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/activity-metadata.json" "file_sha256" "079affb9679cf342141ab56f4aba9a7e48b2be1c797f70d41c4e589f5b75d13c" "basis" 1462 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/edb-import/verification.json"} {"question" "q-36045" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/state.json" "file_sha256" "bad8bf355a2d98eb4d09c16da2e9a1b14334a08a175647bfc8ad054277c71a4e" "basis" 1462 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/edb-import/verification.json"} {"question" "q-36045" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-51"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039717/state.json" "file_sha256" "bad8bf355a2d98eb4d09c16da2e9a1b14334a08a175647bfc8ad054277c71a4e" "basis" 1462 "verification" "/home/jake/Devel