 NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea98bbe2-63f0-56a4-8d00-c25bca1abb09" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}3 & 5 & 0 & 7 \\\\ -1 & 0 & -5 & 6 \\\\ 4 & 0 & 6 & 8 \\\\ 11 & 3 & 0 & -9\\end{aligned}|" :db/id #edb/ref 17592186309266} {:answer/id #uuid "84b558de-9ad1-511a-a205-8e84afb6474d" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-5 & -8 & 2 & 0 \\\\ 3 & 5 & 0 & 7 \\\\ -1 & 0 & -5 & 6 \\\\ 4 & 0 & 6 & 8\\end{aligned}|" :db/id #edb/ref 17592186309267} {:answer/id #uuid "dce10d67-a18e-5ba3-89e4-a901d663016d" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 5 & 0 & 7 \\\\ -1 & 0 & -5 & 6 \\\\ 4 & 0 & 6 & 8 \\\\ 11 & 3 & 0 & -9\\end{aligned}|" :db/id #edb/ref 17592186309268} {:answer/id #uuid "3db7489b-6662-58ff-95a5-b35e8b3f31ce" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}-8 & 2 & 0 & 1 \\\\ 5 & 0 & 7 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 0 & 6 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309269} {:answer/id #uuid "7a429195-b34f-518a-adc4-aa7b22db7fef" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-8 & 2 & 0 & 1 \\\\ 5 & 0 & 7 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 0 & 6 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309270}] :answer-field/correct {:answer/id #uuid "7a429195-b34f-518a-adc4-aa7b22db7fef" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-8 & 2 & 0 & 1 \\\\ 5 & 0 & 7 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 0 & 6 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309270} :answer-field/id #uuid "602ab407-9661-5d0a-bd79-04af3bd6ff9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309265}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "89faed72-6b2b-5ac2-b9c3-e4ab7bcb56d9" :question/math-academy-id "q-130904" :question/problem "Find the cofactor of ${d}_{51}$ in \n$D=[\\begin{aligned}-5 & -8 & 2 & 0 & 1 \\\\ 3 & 5 & 0 & 7 & 1 \\\\ -1 & 0 & -5 & 6 & -4 \\\\ 4 & 0 & 6 & 8 & 3 \\\\ 11 & 3 & 0 & -9 & 3\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${d}_{51}$, we remove the $5$th row and $1$st column: \n\n$$\nD=[\\begin{aligned}∗ & -8 & 2 & 0 & 1 \\\\ ∗ & 5 & 0 & 7 & 1 \\\\ ∗ & 0 & -5 & 6 & -4 \\\\ ∗ & 0 & 6 & 8 & 3 \\\\ 11 & ∗ & ∗ & ∗ & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{51}=|\\begin{aligned}-8 & 2 & 0 & 1 \\\\ 5 & 0 & 7 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 0 & 6 & 8 & 3\\end{aligned}|.\n$$\n\nNow, the cofactor of ${d}_{51}$ is\n\n$$\n\\begin{aligned}{C}_{51} & =(-1)^{5+1}{M}_{51} \\\\  & ={M}_{51} \\\\  & =|\\begin{aligned}-8 & 2 & 0 & 1 \\\\ 5 & 0 & 7 & 1 \\\\ 0 & -5 & 6 & -4 \\\\ 0 & 6 & 8 & 3\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309271 :knowledge-point/_questions [{:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d121efe-a33f-5699-a3e3-cd3ec4a36782" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309273} {:answer/id #uuid "1b6eab7a-1fe0-58dc-85b7-8a7c4dbbb40c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -8 & 2 & -5 \\\\ 3 & 5 & 6 & 3 \\\\ -1 & -1 & -5 & 6 \\\\ 4 & 5 & 3 & 8\\end{aligned}|" :db/id #edb/ref 17592186309274} {:answer/id #uuid "0007e7ad-808e-5128-98f4-009625a08aa8" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -8 & 2 & -5 \\\\ -1 & -1 & -5 & 6 \\\\ 4 & 5 & 3 & 8 \\\\ -9 & 3 & 7 & -9\\end{aligned}|" :db/id #edb/ref 17592186309275} {:answer/id #uuid "207afcce-2b99-5b0f-a0e3-16d11bff390e" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & -8 & 2 & -5 \\\\ -1 & -1 & -5 & 6 \\\\ 4 & 5 & 3 & 8 \\\\ -9 & 3 & 7 & -9\\end{aligned}|" :db/id #edb/ref 17592186309276} {:answer/id #uuid "1c48f884-9a2e-5b38-8e98-927b8774adea" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309277}] :answer-field/correct {:answer/id #uuid "1c48f884-9a2e-5b38-8e98-927b8774adea" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|" :db/id #edb/ref 17592186309277} :answer-field/id #uuid "a8aba7e0-7133-5da3-af8c-b13e3994794a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309272}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ebbea878-b1bd-5990-8d32-9b0b85df7ff7" :question/math-academy-id "q-130906" :question/problem "Find the cofactor of ${x}_{52}$ in \n$X=[\\begin{aligned}1 & -8 & 2 & -5 & -1 \\\\ 3 & 5 & 6 & 3 & 1 \\\\ -1 & -1 & -5 & 6 & -4 \\\\ 4 & 5 & 3 & 8 & 3 \\\\ -9 & 3 & 7 & -9 & 0\\end{aligned}].$" :question/worked-solution "First, to get the minor of ${x}_{52}$, we remove the $5$th row and $2$nd column: \n\n$$\nX=[\\begin{aligned}1 & ∗ & 2 & -5 & -1 \\\\ 3 & ∗ & 6 & 3 & 1 \\\\ -1 & ∗ & -5 & 6 & -4 \\\\ 4 & ∗ & 3 & 8 & 3 \\\\ ∗ & 3 & ∗ & ∗ & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{52}=|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|.\n$$\n\nNow, the cofactor of ${x}_{52}$ is\n\n$$\n\\begin{aligned}{C}_{52} & =(-1)^{5+2}{M}_{52} \\\\  & =-{M}_{52} \\\\  & =-|\\begin{aligned}1 & 2 & -5 & -1 \\\\ 3 & 6 & 3 & 1 \\\\ -1 & -5 & 6 & -4 \\\\ 4 & 3 & 8 & 3\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326416 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baac03c2-5594-5d6d-afe6-d11f2e4af0af" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186326418} {:answer/id #uuid "8f481d6f-8d90-54b7-a5fa-650497b3a7ba" :answer/type {:db/ident :answer.type/math} :answer/value "-125" :db/id #edb/ref 17592186326419} {:answer/id #uuid "82837abc-9914-5634-a56e-cbcaa750236a" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186326420} {:answer/id #uuid "249f7f9c-87a9-52ce-aef3-ae224f992091" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186326421} {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422}] :answer-field/correct {:answer/id #uuid "d3d5e303-e169-53f1-af41-e7d2822ac03b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186326422} :answer-field/id #uuid "232cbb19-7070-5995-9c13-5f120cbc0d60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326417}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "179f7f4a-7495-5cce-8a55-25ec8c046a62" :question/math-academy-id "q-131096" :question/problem "Calculate the determinant of the matrix\n$D=[\\begin{aligned}0 & 0 & 0 & 1 \\\\ 0 & 4 & 0 & 4 \\\\ 0 & 1 & 2 & 3 \\\\ 6 & 5 & 3 & 0\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(D) & ={d}_{11}{C}_{11}+{d}_{12}{C}_{12}+{d}_{13}{C}_{13}+{d}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+1\\cdot {C}_{14} \\\\  & =1{C}_{14} \\\\  & =1\\cdot |\\begin{aligned}∗ & ∗ & ∗ & 1 \\\\ 0 & 4 & 0 & ∗ \\\\ 0 & 1 & 2 & ∗ \\\\ 6 & 5 & 3 & ∗\\end{aligned}| \\\\  & =1(-1)^{1+4}|\\begin{aligned}0 & 4 & 0 \\\\ 0 & 1 & 2 \\\\ 6 & 5 & 3\\end{aligned}| \\\\  & =-1(0\\cdot |\\begin{aligned}1 & 2 \\\\ 5 & 3\\end{aligned}|-4\\cdot |\\begin{aligned}0 & 2 \\\\ 6 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 6 & 5\\end{aligned}|) \\\\  & =-(0-4(3\\cdot 0-2\\cdot 6)+0) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385953 :knowledge-point/_questions [{:knowledge-point/id #uuid "055b3809-f9aa-5dcc-8c1a-b0eb71020d7e" :knowledge-point/title "Calculating the Determinant of a NxN Matrix Using Cofactor Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27ffc6c8-3d2a-5c30-bd3b-e885701f4d9c" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186385955} {:answer/id #uuid "2964e972-387d-5637-a133-e1e20585a4af" :answer/type {:db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186385956} {:answer/id #uuid "7bf860bf-b779-5286-b783-abc5f80b5559" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186385957} {:answer/id #uuid "4e7a423e-b3a8-5d87-b517-7deee8d5799d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186385958} {:answer/id #uuid "f43b4742-5b36-5cfe-b3dc-c2efec322db2" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186385959}] :answer-field/correct {:answer/id #uuid "27ffc6c8-3d2a-5c30-bd3b-e885701f4d9c" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186385955} :answer-field/id #uuid "11a4cf3b-b615-5f91-8e60-4730b8d0fb8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385954}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9b9c934f-9b45-5dd7-a418-73f95c3ed061" :question/math-academy-id "q-131123" :question/problem "Calculate the determinant of the matrix\n$H=[\\begin{aligned}0 & 1 & 0 & -1 \\\\ 0 & 3 & 0 & 8 \\\\ 1 & 2 & 1 & 0 \\\\ 0 & 2 & 1 & 2\\end{aligned}].$" :question/worked-solution "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(H) & ={h}_{11}{C}_{11}+{h}_{12}{C}_{12}+{h}_{13}{C}_{13}+{h}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13}+(-1)\\cdot {C}_{14} \\\\  & ={C}_{12}-{C}_{14} \\\\  & =1\\cdot |\\begin{aligned}∗ & 1 & ∗ & ∗ \\\\ 0 & ∗ & 0 & 8 \\\\ 1 & ∗ & 1 & 0 \\\\ 0 & ∗ & 1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}∗ & ∗ & ∗ & -1 \\\\ 0 & 3 & 0 & ∗ \\\\ 1 & 2 & 1 & ∗ \\\\ 0 & 2 & 1 & ∗\\end{aligned}| \\\\  & =1\\cdot (-1)^{1+2}|\\begin{aligned}0 & 0 & 8 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 2\\end{aligned}|+(-1)\\cdot (-1)^{4+1}|\\begin{aligned}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{aligned}| \\\\  & =-|\\begin{aligned}0 & 0 & 8 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 2\\end{aligned}|+|\\begin{aligned}0 & 3 & 0 \\\\ 1 & 2 & 1 \\\\ 0 & 2 & 1\\end{aligned}| \\\\  & =-(0\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}|+8\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|)+(0\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|+0\\cdot |\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|) \\\\  & =8\\cdot (-1)+(-3)\\cdot 1 \\\\  & =-8-3 \\\\  & =-11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309299 :knowledge-point/_questions [{:knowledge-point/id #uuid "58148550-e41f-5df0-80dc-e783619cf87d" :knowledge-point/title "Calculating a Cofactor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280e95c5-3f84-5fb6-bb3d-ccccb96fea5c" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}0 & 8 & -2 & 1 \\\\ 6 & 2 & -9 & -1 \\\\ 1 & 5 & 2 & 0 \\\\ -1 & 4 & 3 & 2\\end{aligned}|" :db/id #edb/ref 17592186309301} {:answer/id #uuid "0717789c-241d-52d3-9cf8-4