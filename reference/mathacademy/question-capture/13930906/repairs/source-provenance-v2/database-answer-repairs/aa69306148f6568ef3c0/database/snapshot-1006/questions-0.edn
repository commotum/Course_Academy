#{[{:db/id #edb/ref 17592186284784 :knowledge-point/_questions [{:db/id #edb/ref 17592186083219 :knowledge-point/id #uuid "74677256-e307-5d49-b7e0-c3f4e79cf818" :knowledge-point/title "Calculating the Number of Ways That N Objects Can Be Arranged"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08737316-aa20-5df6-851c-dce808b637e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281762} {:answer/id #uuid "18fd45dc-1ede-51cf-9585-369b367a8961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186281914} {:answer/id #uuid "82a108e9-b949-5ec3-82d9-001193cc0c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186282820} {:answer/id #uuid "b939e1e9-b6b5-5e42-8a94-194f830d95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283290} {:answer/id #uuid "ea97fa87-edd6-5cc7-984b-14ae7f4f6d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186283739}] :answer-field/correct {:answer/id #uuid "08737316-aa20-5df6-851c-dce808b637e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281762} :answer-field/id #uuid "6814504a-adfe-5300-8bd4-6599a98f28d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53fbad36-9779-558b-839c-131c419555eb" :question/math-academy-id "q-1804" :question/problem "Suppose that $5$ pictures are to be hung from left to right in a hallway. In how many possible ways can they be hung?" :question/worked-solution "There are $n=5$ pictures, so the number of possible arrangements is\n\n$$\n\\begin{aligned}5! & =5\\times 4\\times 3\\times 2\\times 1 \\\\  & =120.\\end{aligned}\n$$\n\nTherefore, there are $120$ ways of arranging the $5$ pictures."}]}
