{
  "dom_id": "step-e5671",
  "name": "Example: Calculating the Number of Ways That N Objects Can Be Arranged",
  "problem": "Suppose there are five books on a bookshelf. How many possible ways can we arrange them?",
  "worked_solution": "There are $n=5$ books, so the number of possible arrangements is\n\n$$\n\\begin{aligned}5! & =5\\times 4\\times 3\\times 2\\times 1 \\\\  & =120.\\end{aligned}\n$$\n\nTherefore, there are $120$ ways of arranging the $5$ books.",
  "calculator_instructions": "",
  "fields": [],
