y+{x}^{2}}{y}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2y+{x}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}-2y & ={x}^{2}.\\end{aligned}\n$$\n\nThis differential equation is in standard form with  $P(x)=-2$ and $Q(x)={x}^{2}.$ Since the equation is written in standard form, we conclude that it is a first-order linear ODE.\n\nAll of the other equations cannot be written in the standard form, and therefore they are not first-order linear ODEs." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-79754" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/activity-metadata.json" "file_sha256" "17d5ed82e071b24b9b8925d8254b79244802620613702a0706b3182b3cda5921"} {"question" "q-79754" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-79754" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{y\\operatorname{cos}⁡x}-y"] ["math" "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y+{x}^{2}}{y}"] ["math" "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{y-x}{{y}^{2}}"] ["math" "\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}+3x}{y}"] ["math" "y\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-2x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-79754" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\frac{1}{y})\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y+{x}^{2}}{y}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-103354" "field" nil "attribute" "question/problem" "value" "Write the following first-order linear ODE in standard form.\n\n$$\n(\\operatorname{cos}⁡x)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡2x-(\\operatorname{sin}⁡x)\\,y=0\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-103354" "field" nil "attribute" "question/worked-solution" "value" "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}(\\operatorname{cos}⁡x)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡2x-(\\operatorname{sin}⁡x)\\,y & =0 \\\\ (\\operatorname{cos}⁡x)\\frac{\\text{d}y}{\\text{d}x}-(\\operatorname{sin}⁡x)\\,y & =-\\operatorname{sin}⁡2x \\\\ \\frac{\\text{d}y}{\\text{d}x}-(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})y & =-\\frac{\\operatorname{sin}⁡2x}{\\operatorname{cos}⁡x} \\\\ \\frac{\\text{d}y}{\\text{d}x}-(\\operatorname{tan}⁡x)y & =-\\frac{2\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{cos}⁡x} \\\\ \\frac{\\text{d}y}{\\text{d}x}+{{(-\\operatorname{tan}⁡x)}_{⏟}}_{P(x)}y & ={{-2\\operatorname{sin}⁡x}_{⏟}}_{Q(x)}.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=-\\operatorname{tan}⁡x$ and $Q(x)=-2\\operatorname{sin}⁡x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-103354" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/activity-metadata.json" "file_sha256" "17d5ed82e071b24b9b8925d8254b79244802620613702a0706b3182b3cda5921"} {"question" "q-103354" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-103354" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\text{d}y}{\\text{d}x}+(\\operatorname{sec}⁡x)y=-2\\operatorname{sin}⁡2x"] ["math" "\\frac{\\text{d}y}{\\text{d}x}+2\\operatorname{sin}⁡x=(\\operatorname{tan}⁡x)y"] ["math" "\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡2x=(\\operatorname{sec}⁡x)y"] ["math" "\\frac{\\text{d}y}{\\text{d}x}-(\\operatorname{cot}⁡x)y=2\\operatorname{cos}⁡x"] ["math" "\\frac{\\text{d}y}{\\text{d}x}-(\\operatorname{tan}⁡x)y=-2\\operatorname{sin}⁡x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-103354" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\text{d}y}{\\text{d}x}-(\\operatorname{tan}⁡x)y=-2\\operatorname{sin}⁡x"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331601" "field" nil "attribute" "question/problem" "value" "Which of the following first-order linear differential equations are homogeneous?\n\n- ${y}^{′}+2xy=0$\n- ${y}^{′}+2xy=4$\n- ${y}^{′}+2xy=-y$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331601" "field" nil "attribute" "question/worked-solution" "value" "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+2xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+2xy=4.\n$$\n\nThe presence of the constant term $4$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+2xy=-y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+2xy & =-y \\\\ {y}^{′}+2xy+y & =0 \\\\ {y}^{′}+(2x+1)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\nTherefore, the correct answer is \"I and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331601" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/activity-metadata.json" "file_sha256" "17d5ed82e071b24b9b8925d8254b79244802620613702a0706b3182b3cda5921"} {"question" "q-331601" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331601" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331601" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and III only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331743" "field" nil "attribute" "question/problem" "value" "Which of the following first-order linear differential equations are inhomogeneous?\n\n- ${y}^{′}+{x}^{2}y=-2$\n- ${y}^{′}+{x}^{2}y=y$\n- ${y}^{′}+{x}^{2}y=0$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331743" "field" nil "attribute" "question/worked-solution" "value" "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=-2.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-2$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=y.\n$$\n\nWe collect the $y$-terms on the left side:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{2}y & =y \\\\ {y}^{′}+{x}^{2}y-y & =0 \\\\ {y}^{′}+({x}^{2}-1)y & =0.\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is \"I only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331743" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/activity-metadata.json" "file_sha256" "17d5ed82e071b24b9b8925d8254b79244802620613702a0706b3182b3cda5921"} {"question" "q-331743" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331743" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"} {"question" "q-331743" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14080399/state.json" "file_sha256" "6a36807b6587d2cdea76e3dff56545f2fdeb906fc8225120f941523f44e81c16"}] "usage" {"q-8352" [{"kind" "presentations" "entity" 17592186283049} {"kind" "responses" "entity" 17592186283049}] "q-103354" [] "q-331601" [] "q-79754" []} "basis" 2834 "retractions" [[17592186088080 :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\n1. $y^{\\prime } + 2xy = 0$\n2. $y^{\\prime } + 2xy = 4$\n3. $y^{\\prime } + 2xy =-y$"] [17592186088080 :question/worked-solution "Collect all terms involving $y$ on the left. Equation I already has zero forcing and is homogeneous. Equation II has forcing $4$, so it is inhomogeneous. Equation III becomes $y^{\\prime}+(2x+1)y=0$, so it is homogeneous. Therefore the answer is I and III only."]] "immutable_answers" [17592186085386 17592186085387 17592186085388 17592186085389 17592186085390 17592186087109 17592186087110 17592186087111 17592186087112 17592186087113 17592186295537 17592186295538 17592186295539 17592186295540 17592186295541 17592186295614 17592186295615 17592186295616 17592186295617 17592186295618] "immutable_fields" [[17592186085385 :answer-field/correct] [17592186085385 :answer-field/id] [17592186085385 :answer-field/key] [17592186085385 :answer-field/type] [17592186087108 :answer-field/correct] [17592186087108 :answer-field/id] [17592186087108 :answer-field/key] [17592186087108 :answer-field/type] [17592186295536 :answer-field/correct] [17592186295536 :answer-field/id] [17592186295536 :answer-field/key] [17592186295536 :answer-field/type] [17592186295613 :answer-field/correct] [17592186295613 :answer-field/id] [17592186295613 :answer-field/key] [17592186295613 :answer-field/type]] "no