/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186268763} {:answer/id #uuid "78791bf3-487f-5615-adc8-b32dbb04c37d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268764} {:answer/id #uuid "7c1eff62-faf2-5395-aa7f-3b7b0292053e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268765} {:answer/id #uuid "0ac94549-6189-537c-ba55-86ac70c3d2bc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268766}] :answer-field/correct {:answer/id #uuid "08484c2f-fd25-5b8c-925c-5c77f863525f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186268762} :answer-field/id #uuid "b858c286-6eb2-59cc-8787-9e1c2b27e881" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268761}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2667074f-0f9f-5ca2-9b54-866ee3dc1a9a" :question/math-academy-id "q-70768" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\n- $(\\frac{1}{2},\\frac{\\pi }{6})$\n- $(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$\n- $(-1,\\pi )$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{1}{2},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{1}{2})$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{1}{2},\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{4},-\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{3\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(-1,\\pi ).$ We note the following:\n\n- The point $(\\pi ,-1)$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\pi $ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,\\pi )$ lies on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186268767 :knowledge-point/_questions [{:knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdfa3991-6db6-5b3e-bda4-fb8e9e58cc99" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186268769} {:answer/id #uuid "bac5342b-5d10-547c-86b0-c690a8a29394" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268770} {:answer/id #uuid "b2e08124-5234-5e9b-99bd-19db73a7da14" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268771} {:answer/id #uuid "62f014d8-75ba-50d8-a497-0c0a161df040" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268772} {:answer/id #uuid "218ac60f-0d53-570c-b372-6802a12599c3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186268773}] :answer-field/correct {:answer/id #uuid "bac5342b-5d10-547c-86b0-c690a8a29394" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268770} :answer-field/id #uuid "c8ca9703-0ffa-504a-81c5-5a2704135141" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268768}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3692464e-f017-5c85-befd-6c0f45c59ad9" :question/math-academy-id "q-70769" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\n- $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$\n- $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$\n- $(1,\\frac{\\pi }{3})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=-\\frac{\\pi }{6}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(1,\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},1)$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186268774 :knowledge-point/_questions [{:knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e990c7c-0abe-5fc7-abb7-f4a114a4f1ff" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186268776} {:answer/id #uuid "6ab0fb69-d4a4-5c1b-9020-5adfdd25b043" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268777} {:answer/id #uuid "79fec1fd-e877-52fb-a2ee-65e36e130a06" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268778} {:answer/id #uuid "e7037df1-b25e-5678-bf62-3023c3b0c8e1" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268779} {:answer/id #uuid "afeac6e4-0683-5840-98af-d8cf9a3ed1dd" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186268780}] :answer-field/correct {:answer/id #uuid "79fec1fd-e877-52fb-a2ee-65e36e130a06" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268778} :answer-field/id #uuid "bcfa2ada-c6f3-58f7-bf88-c6f9de680bbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268775}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2cacc97b-4c53-5c23-a1c9-c837345342b8" :question/math-academy-id "q-70770" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\n- $(-\\frac{1}{4},\\frac{\\pi }{4})$\n- $(\\frac{1}{2},-\\frac{\\pi }{3})$\n- $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(-\\frac{1}{4},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},-\\frac{1}{4})$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(-\\frac{1}{4},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{1}{2},-\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{3},\\frac{1}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=-\\frac{\\pi }{3}$ does **not** lie within this range.   $\\,\\times $\n\nTherefore, the point $(\\frac{1}{2},-\\frac{\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{6},-\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{5\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{2},\\frac{5\\pi }{6})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186111347 :knowledge-point/_questions [{:knowledge-point/id #uuid "00a8fb88-4b07-57be-94c5-a6b499c9df5b" :knowledge-point/title "Graphing the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cdbea0e-2526-54bf-ac0b-b7733dbe0c54" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-4.png" :db/id #edb/ref 17592186110178} {:answer/id #uuid "0ec8b9c7-8b7a-5f3d-a567-8fd44a18b958" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-3.png" :db/id #edb/ref 17592186110179} {:answer/id #uuid "0ed94a75-44a0-5cc0-8066-86b3e2632f59" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-5.png" :db/id #edb/ref 17592186110180} {:answer/id #uuid "476110cd-86d8-569f-b55c-d9d20b44b409" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-2.png" :db/id #edb/ref 17592186110181} {:answer/id #uuid "577ab067-8704-52f0-aefc-eb98b6ca3b88" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-1.png" :db/id #edb/ref 17592186110182}] :answer-field/correct {:answer/id #uuid "577ab067-8704-52f0-aefc-eb98b6ca3b88" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1486/Source/Images/q-9099-a-1.png" :db/id #edb/ref 17592186110182} :answer-field/id #uuid "ab6aa775-8af8-51ac-994d-e3e18a6a90b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186110177}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c3a7af2-fbb6-5be6-a4dd-58acbc47bee4" :question/math-academy-id "q-9099" :question/problem "What is the graph of $y = \\arccos x$?" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arccos}⁡x:$\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [0,\\pi ].$\n\n- Its minimum value occurs at $x=1.$\n\n- Its maximum value occurs at $x=-1.$\n\n- Its $y$-intercept is $y=\\frac{\\pi }{2}.$\n\n- The function is strictly decreasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13962979/assets/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)"}]}
