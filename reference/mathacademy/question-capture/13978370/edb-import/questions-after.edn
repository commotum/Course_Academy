 guests."}] [{:db/id #edb/ref 17592186278479 :knowledge-point/_questions [{:knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/title "Calculating Permutations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "632f5c16-d4b8-55a5-9c0b-3dd23cebc1af" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186278481} {:answer/id #uuid "4e8bdc99-075c-526c-8d9f-fc7faf85a704" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186278482} {:answer/id #uuid "b4e94260-c17b-5852-a7a9-bab77484fb07" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186278483} {:answer/id #uuid "c39bf5e7-e41b-58e5-bee8-a4debe073ab8" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186278484} {:answer/id #uuid "847bad58-a385-5956-b3e1-0a0604c835bd" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186278485}] :answer-field/correct {:answer/id #uuid "847bad58-a385-5956-b3e1-0a0604c835bd" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186278485} :answer-field/id #uuid "1e231142-0317-5a5c-97fc-d024a293dba7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278480}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a3c195f-9dee-5075-8916-30f7b2c97cc0" :question/math-academy-id "q-6536" :question/problem "How many permutations are there of the letters in the word ''RAIN\"?" :question/worked-solution "In the word \"RAIN\" there are a total of $4$ letters, so there are $4!$ ways of arranging them:\n\n$$\n\\begin{aligned}4! & =4\\times 3\\times 2\\times 1 \\\\  & =24.\\end{aligned}\n$$\n\nTherefore, there are $24$ possible arrangements of the letters of the word \"RAIN\"."}]}
