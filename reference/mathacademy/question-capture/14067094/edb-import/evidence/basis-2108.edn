#{[{:db/id #edb/ref 17592186083827 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfc1bda-5eff-5a6f-b371-ab5883fc7a95" :answer/type {:db/ident :answer.type/math} :answer/value "12m/s" :db/id #edb/ref 17592186082329} {:answer/id #uuid "cb76cb83-825b-5d0d-be09-9bfb4563099c" :answer/type {:db/ident :answer.type/math} :answer/value "16m/s" :db/id #edb/ref 17592186082330} {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} {:answer/id #uuid "50ffc313-9571-553c-b356-7dae55d432ee" :answer/type {:db/ident :answer.type/math} :answer/value "4m/s" :db/id #edb/ref 17592186082332} {:answer/id #uuid "7b99555a-846b-5a82-ba1b-a2a1f5c28fde" :answer/type {:db/ident :answer.type/math} :answer/value "24m/s" :db/id #edb/ref 17592186082333}] :answer-field/correct {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} :answer-field/id #uuid "a34c9314-d67c-5e55-b802-bfbf18eee36a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082328}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fdcc1478-03c8-5a05-bbb2-e650f412de86" :question/math-academy-id "q-7112" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=2t-9{t}^{2}$, where $t$ is the time in seconds. If the particle has velocity $v=-2\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s}$, calculate the speed of the particle at the moment $t=2\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (2t-9{t}^{2})\\text{d}t \\\\  & ={t}^{2}-3{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=-2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-2 & =(1)^{2}-3(1)^{3}+C \\\\ -2 & =1-3+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)={t}^{2}-3{t}^{3}.$\n\nWe evaluate the velocity at time $t=2\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(2) & =(2)^{2}-3(2)^{3} \\\\  & =4-24 \\\\  & =-20\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $20\\,\\text{m/s}.$"}]}
