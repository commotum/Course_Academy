#{[{:db/id #edb/ref 17592186354356 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0b128cb-762b-5ac3-9e2e-ab6bd5e30399" :answer/type {:db/ident :answer.type/math} :answer/value "3t^4+10t^2+12" :db/id #edb/ref 17592186354358}] :answer-field/correct {:answer/id #uuid "f0b128cb-762b-5ac3-9e2e-ab6bd5e30399" :answer/type {:db/ident :answer.type/math} :answer/value "3t^4+10t^2+12" :db/id #edb/ref 17592186354358} :answer-field/id #uuid "d42913a8-486c-5cdb-b6ff-a9765aa155fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354357}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef5a528e-3d29-5ffb-a668-9fd133c57543" :question/math-academy-id "q-351003" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{ft}/{\\text{s}}^{2},$ given by the function $a(t)=12{t}^{3}+20t,$ where $t$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{ft/s}$) of the particle at time $t$ given that the particle has velocity $v=25\\,\\text{ft/s}$ when $t=1\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (12{t}^{3}+20t)\\text{d}t \\\\  & =3{t}^{4}+10{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=25.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}25 & =3({1}^{4})+10({1}^{2})+C \\\\ 25 & =13+C \\\\ C & =12.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=3{t}^{4}+10{t}^{2}+12.$"}] [{:db/id #edb/ref 17592186354359 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f611c80-3aed-5021-b1b6-999a77942a65" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\cos(t)+10" :db/id #edb/ref 17592186354361} {:answer/id #uuid "6e2e28b2-dd67-5539-a65d-4d62b7df06e5" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\cos(t)+4" :db/id #edb/ref 17592186354362}] :answer-field/correct {:answer/id #uuid "6e2e28b2-dd67-5539-a65d-4d62b7df06e5" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\cos(t)+4" :db/id #edb/ref 17592186354362} :answer-field/id #uuid "1f020414-ee06-5bdc-a0d2-e4713f6d9b12" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354360}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "965499a4-cbc7-5edc-bbf6-55706f2f19ea" :question/math-academy-id "q-351027" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{m /s}}^{2},$ given by the function $a(t)=6\\operatorname{sin}⁡(t),$ where $t>0$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=10\\,\\text{m /s}$ when $t=\\pi \\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time.\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int 6\\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =6\\int \\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =-6\\operatorname{cos}⁡(t)+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(\\pi )=10.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}10 & =-6\\operatorname{cos}⁡(\\pi )+C \\\\ 10 & =-6(-1)+C \\\\ 10 & =6+C \\\\ C & =4.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=-6\\operatorname{cos}⁡(t)+4.$"}] [{:db/id #edb/ref 17592186354363 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec671c1e-8977-579d-900b-a5adce9b2587" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{t}-3t+10" :db/id #edb/ref 17592186354365}] :answer-field/correct {:answer/id #uuid "ec671c1e-8977-579d-900b-a5adce9b2587" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{t}-3t+10" :db/id #edb/ref 17592186354365} :answer-field/id #uuid "c177ed9b-7caf-5cbe-8bfa-16833e78f3f8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186354364}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8b1822ff-b3b6-5a2a-882b-65b7f52390da" :question/math-academy-id "q-351051" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{ft/s}}^{2},$ given by the function $a(t)=\\frac{6}{{t}^{2}}-3,$ where $t>0$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{ft/s}$) of the particle at time $t$ given that the particle has velocity $v=1\\,\\text{ft/s}$ when $t=2\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (\\frac{6}{{t}^{2}}-3)\\,\\text{d}t \\\\  & =\\int \\frac{6}{{t}^{2}}\\,\\text{d}t+\\int (-3)\\,\\text{d}t \\\\  & =-\\frac{6}{t}-3t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}1 & =-\\frac{6}{2}-3(2)+C \\\\ 1 & =-9+C \\\\ C & =10.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=-\\frac{6}{t}-3t+10.$"}] [{:db/id #edb/ref 17592186083827 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfc1bda-5eff-5a6f-b371-ab5883fc7a95" :answer/type {:db/ident :answer.type/math} :answer/value "12m/s" :db/id #edb/ref 17592186082329} {:answer/id #uuid "cb76cb83-825b-5d0d-be09-9bfb4563099c" :answer/type {:db/ident :answer.type/math} :answer/value "16m/s" :db/id #edb/ref 17592186082330} {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} {:answer/id #uuid "50ffc313-9571-553c-b356-7dae55d432ee" :answer/type {:db/ident :answer.type/math} :answer/value "4m/s" :db/id #edb/ref 17592186082332} {:answer/id #uuid "7b99555a-846b-5a82-ba1b-a2a1f5c28fde" :answer/type {:db/ident :answer.type/math} :answer/value "24m/s" :db/id #edb/ref 17592186082333}] :answer-field/correct {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} :answer-field/id #uuid "a34c9314-d67c-5e55-b802-bfbf18eee36a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082328}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fdcc1478-03c8-5a05-bbb2-e650f412de86" :question/math-academy-id "q-7112" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=2t-9{t}^{2}$, where $t$ is the time in seconds. If the particle has velocity $v=-2\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s}$, calculate the speed of the particle at the moment $t=2\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (2t-9{t}^{2})\\text{d}t \\\\  & ={t}^{2}-3{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=-2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-2 & =(1)^{2}-3(1)^{3}+C \\\\ -2 & =1-3+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)={t}^{2}-3{t}^{3}.$\n\nWe evaluate the velocity at time $t=2\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(2) & =(2)^{2}-3(2)^{3} \\\\  & =4-24 \\\\  & =-20\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $20\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186298733 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55721e0-1b81-5593-821a-aff69e2b460c" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=3{e}^{-2t}+2" :db/id #edb/ref 17592186298735} {:answer/id #uuid "ff5a9804-6578-54e3-90d7-d7e356c94090" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=3{e}^{-2t}-1" :db/id #edb/ref 17592186298736} {:answer/id #uuid "16d6b473-aafc-50ef-8bac-8ee3a1a27acf" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=-2{e}^{-2t}+4" :db/id #edb/ref 17592186298737} {:answer/id #uuid "4f9a4ce0-a120-5c6d-bfda-e473791274a2" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=-2{e}^{-t}+2" :db/id #edb/ref 17592186298738} {:answer/id #uuid "0798db24-5209-5971-8b62-6f9c2c116fbf" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=12{e}^{-t}-10" :db/id #edb/ref 17592186298739}] :answer-field/correct {:answer/id #uuid "ff5a9804-6578-54e3-90d7-d7e356c94090" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=3{e}^{-2t}-1" :db/id #edb/ref 17592186298736} :answer-field/id #uuid "65cbf151-a992-50f6-b66a-9f516413b70a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298734}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06962200-76b2-5d6f-909d-2509c3b16b67" :question/math-academy-id "q-81707" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=-6{e}^{-2t}$, where $t$ is the time in seconds. If the particle has velocity $v=2\\,\\text{m}/\\text{s}$ when $t=0\\,\\text{s}$, find the velocity (in $\\text{m/s}$)  of the particle at time $t.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (-6{e}^{-2t})\\,\\text{d}t \\\\  & =-6(-\\frac{1}{2}{e}^{-2t})+C \\\\  & =3{e}^{-2t}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}2 & =3{e}^{0}+C \\\\ 2 & =3+C \\\\ C & =-1.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=3{e}^{-2t}-1.$"}]}
