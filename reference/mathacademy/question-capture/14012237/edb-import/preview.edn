xt{d}x}\\,\\text{d}x & =\\int 3{x}^{2}\\,\\text{d}x \\\\ \\int \\operatorname{cos}⁡y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 3{x}^{2}\\,\\text{d}x \\\\ \\int \\operatorname{cos}⁡y\\,\\text{d}y & =\\int 3{x}^{2}\\,\\text{d}x \\\\ \\operatorname{sin}⁡y & ={x}^{3}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{sin}⁡y={x}^{3}+C.\n$$" 13194139534470 true] [17592186290091 1000 #edb/ref 17592186290092 13194139534470 true] [17592186290091 1000 #edb/ref 17592186290093 13194139534470 true] [17592186290091 1000 #edb/ref 17592186290094 13194139534470 true] [17592186290091 1000 #edb/ref 17592186290095 13194139534470 true] [17592186290091 1000 #edb/ref 17592186290096 13194139534470 true] [17592186290091 1040 #edb/ref 17592186045450 13194139534470 true] [17592186290091 1041 "selection" 13194139534470 true] [17592186290091 1104 #edb/ref 17592186290096 13194139534470 true] [17592186290091 1110 #uuid "b0239e82-ea6b-51fb-b67b-3105cf1e47e8" 13194139534470 true] [17592186290092 1034 "\\operatorname{tan}⁡y=\\frac{1}{{x}^{3}}+C" 13194139534470 true] [17592186290092 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290092 1111 #uuid "3bae4517-ca75-59cb-a32f-b2a2a2c2eaa2" 13194139534470 true] [17592186290093 1034 "\\operatorname{sin}⁡y=\\frac{1}{{x}^{3}}+C" 13194139534470 true] [17592186290093 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290093 1111 #uuid "0aeecf5d-5702-513e-801c-5c126e01c8a1" 13194139534470 true] [17592186290094 1034 "\\text{ }y={x}^{3}+C" 13194139534470 true] [17592186290094 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290094 1111 #uuid "17ce1359-aa2a-5472-9c96-f2901f6cba5f" 13194139534470 true] [17592186290095 1034 "\\operatorname{tan}⁡y={x}^{3}+C" 13194139534470 true] [17592186290095 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290095 1111 #uuid "222d92b3-2dcd-5344-b8b0-8d766efd687a" 13194139534470 true] [17592186290096 1034 "\\operatorname{sin}⁡y={x}^{3}+C" 13194139534470 true] [17592186290096 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290096 1111 #uuid "201dba49-412a-5f39-a491-3eaaf266d447" 13194139534470 true] [17592186290097 1017 #edb/ref 17592186290098 13194139534470 true] [17592186290097 1089 "q-158117" 13194139534470 true] [17592186290097 1091 #edb/ref 17592186045463 13194139534470 true] [17592186290097 1100 "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y\\operatorname{sin}⁡x$ for $y\\ne 0.$" 13194139534470 true] [17592186290097 1113 #uuid "5a9f1df5-0abe-52e3-bf22-4b38e70bcd85" 13194139534470 true] [17592186290097 1145 "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡x \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =-\\operatorname{cos}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=-\\operatorname{cos}⁡x+C\n$$" 13194139534470 true] [17592186290098 1000 #edb/ref 17592186290099 13194139534470 true] [17592186290098 1000 #edb/ref 17592186290100 13194139534470 true] [17592186290098 1000 #edb/ref 17592186290101 13194139534470 true] [17592186290098 1000 #edb/ref 17592186290102 13194139534470 true] [17592186290098 1000 #edb/ref 17592186290103 13194139534470 true] [17592186290098 1040 #edb/ref 17592186045450 13194139534470 true] [17592186290098 1041