}} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int x\\,\\text{d}x \\\\ {e}^{y} & =\\frac{{x}^{2}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{e}^{y}=\\frac{{x}^{2}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2}+C).\n$$" 13194139534470 true] [17592186290105 1000 #edb/ref 17592186290106 13194139534470 true] [17592186290105 1000 #edb/ref 17592186290107 13194139534470 true] [17592186290105 1000 #edb/ref 17592186290108 13194139534470 true] [17592186290105 1000 #edb/ref 17592186290109 13194139534470 true] [17592186290105 1000 #edb/ref 17592186290110 13194139534470 true] [17592186290105 1040 #edb/ref 17592186045450 13194139534470 true] [17592186290105 1041 "selection" 13194139534470 true] [17592186290105 1104 #edb/ref 17592186290109 13194139534470 true] [17592186290105 1110 #uuid "d3632192-c66e-50c5-801e-6d1652a6c0f8" 13194139534470 true] [17592186290106 1034 "y=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2})+C" 13194139534470 true] [17592186290106 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290106 1111 #uuid "128eee03-ebf6-5e0f-a12c-86ca6152676d" 13194139534470 true] [17592186290107 1034 "y=\\frac{\\operatorname{ln}⁡({x}^{2})}{2}+C" 13194139534470 true] [17592186290107 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290107 1111 #uuid "4bda40f0-2d83-59e6-8f7b-7ba05cf47032" 13194139534470 true] [17592186290108 1034 "y=\\frac{{x}^{2}}{2}+C" 13194139534470 true] [17592186290108 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290108 1111 #uuid "61da996c-429e-5771-9273-3176fc625092" 13194139534470 true] [17592186290109 1034 "y=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2}+C)" 13194139534470 true] [17592186290109 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290109 1111 #uuid "07c6ebfc-e491-5570-a132-4f1f7d478f38" 13194139534470 true] [17592186290110 1034 "y=\\operatorname{ln}⁡(\\frac{x}{2})+C" 13194139534470 true] [17592186290110 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290110 1111 #uuid "f72e1a12-1c41-5fc1-b88e-073808038329" 13194139534470 true] [17592186290111 1017 #edb/ref 17592186290112 13194139534470 true] [17592186290111 1089 "q-79663" 13194139534470 true] [17592186290111 1091 #edb/ref 17592186045464 13194139534470 true] [17592186290111 1100 "Find the general solution to the differential equation ${y}^{′}-2xy=3{x}^{2}y$ for $y\\ne 0.$" 13194139534470 true] [17592186290111 1113 #uuid "e1ecad53-dd2a-50f5-9cf7-3133c20315a0" 13194139534470 true] [17592186290111 1145 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}-2xy & =3{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x}-2xy & =3{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}y+2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(3{x}^{2}+2x)y \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}+2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3{x}^{2}+2x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (3{x}^{2}+2x)\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & ={x}^{3}+{x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|={x}^{3}+{x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & ={x}^{3}+{x}^{2}+C \\\\ |y| & ={e}^{{x}^{3}+{x}^{2}+C} \\\\ |y| & ={e}^{{x}^{3}+{x}^{2}}\\cdot {e}^{C} \\\\ |y| & =K{e}^{{x}^{3}+{x}^{2}}\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{{x}^{3}+{x}^{2}}.\n$$" 13194139534470 true] [17592186290112 1000 #edb/ref 17592186290113 13194139534470 true] [17592186290112 1000 #edb/ref 17592186290114 13194139534470 true] [17592186290112 1000 #edb/ref 17592186290115 13194139534470 true] [17592186290112 1000 #edb/ref 17592186290116 13194139534470 true] [17592186290112 1000 #edb/ref 17592186290117 13194139534470 true] [17592186290112 1040 #edb/ref 17592186045450 13194139534470 true] [17592186290112 1041 "selection" 13194139534470 true] [17592186290112 1104 #edb/ref 17592186290115 13194139534470 true] [17592186290112 1110 #uuid "4d7defa0-0bd3-5dba-a9b1-ce70b28f05df" 13194139534470 true] [17592186290113 1034 "y=K{e}^{6x+2}" 13194139534470 true] [17592186290113 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290113 1111 #uuid "b77b1bab-d61a-51fd-ac76-46d237d3c984" 13194139534470 true] [17592186290114 1034 "y=K{e}^{3{x}^{2}+2x}" 13194139534470 true] [17592186290114 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290114 1111 #uuid "59f85b27-4e41-5a41-960b-ad9a37fd1329" 13194139534470 true] [17592186290115 1034 "y=K{e}^{{x}^{3}+{x}^{2}}" 13194139534470 true] [17592186290115 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290115 1111 #uuid "7f8bb634-72c0-55c9-92da-f5d7e725d536" 13194139534470 true] [17592186290116 1034 "y=K{e}^{\\sqrt{3{x}^{2}+2x}}" 13194139534470 true] [17592186290116 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290116 1111 #uuid "6bb55016-963a-5440-ad69-b4690e203631" 13194139534470 true] [17592186290117 1034 "y=K{e}^{\\sqrt{{x}^{3}+{x}^{2}}}" 13194139534470 true] [17592186290117 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290117 1111 #uuid "42d289aa-6bdd-5d3a-906e-71a6468e02c1" 13194139534470 true] [17592186290118 1017 #edb/ref 17592186290119 13194139534470 true] [17592186290118 1089 "q-79664" 13194139534470 true] [17592186290118 1091 #edb/ref 17592186045465 13194139534470 true] [17592186290118 1100 "Find the general solution to the differential equation ${y}^{′}-{y}^{2}=6{x}^{2}{y}^{2}$ for $y\\ne 0.$" 13194139534470 true] [17592186290118 1113 #uuid "09d456a1-9fef-5540-85ee-2f11d2f0e40e" 13194139534470 true] [17592186290118 1145 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}-{y}^{2} & =6{x}^{2}{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}-{y}^{2} & =6{x}^{2}{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}{y}^{2}+{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(6{x}^{2}+1){y}^{2} \\\\ \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}+1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (6{x}^{2}+1)\\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}}\\,\\text{d}y & =\\int (6{x}^{2}+1)\\,\\text{d}x \\\\ -\\frac{1}{y} & =2{x}^{3}+x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n-\\frac{1}{y}=2{x}^{3}+x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2{x}^{3}+x+C}.\\end{aligned}\n$$" 13194139534470 true] [17592186290119 1000 #edb/ref 17592186290120 13194139534470 true] [17592186290119 1000 #edb/ref 17592186290121 13194139534470 true] [17592186290119 1000 #edb/ref 17592186290122 13194139534470 true] [17592186290119 1000 #edb/ref 17592186290123 13194139534470 true] [17592186290119 1000 #edb/ref 17592186290124 13194139534470 true] [17592186290119 1040 #edb/ref 17592186045450 13194139534470 true] [17592186290119 1041 "selection" 13194139534470 true] [17592186290119 1104 #edb/ref 17592186290123 13194139534470 true] [17592186290119 1110 #uuid "7ceb3d60-5583-5261-82e7-277a1667cf86" 13194139534470 true] [17592186290120 1034 "y=\\frac{1}{{x}^{3}+{x}^{2}}+C" 13194139534470 true] [17592186290120 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290120 1111 #uuid "83886acf-1c8e-5960-b6ee-e7830ed74739" 13194139534470 true] [17592186290121 1034 "y=-\\frac{C}{2{x}^{3}+x}" 13194139534470 true] [17592186290121 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290121 1111 #uuid "1fb29469-b4cf-5fa4-9b43-729d593893b3" 13194139534470 true] [17592186290122 1034 "y=\\frac{1}{{x}^{3}+{x}^{2}+C}" 13194139534470 true] [17592186290122 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290122 1111 #uuid "a0e52c87-c4b3-52a7-8ff6-ffd53d74f1fa" 13194139534470 true] [17592186290123 1034 "y=-\\frac{1}{2{x}^{3}+x+C}" 13194139534470 true] [17592186290123 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290123 1111 #uuid "e5ab7321-4111-5db9-9f25-55c51a7d43f3" 13194139534470 true] [17592186290124 1034 "y=\\frac{1}{{x}^{2}-x}+C" 13194139534470 true] [17592186290124 1103 #edb/ref 17592186045453 13194139534470 true] [17592186290124 1111 #uuid "18a72a28-9a43-5b76-a889-40e9df5aefb4" 13194139534470 true] [17592186290125 1017 #edb/ref 17592186290126 13194139534470 true] [17592186290125 1089 "q-79665" 13194139534470 true] [17592186290125 1091 #edb/ref 17592186045465 13194139534470 true] [17592186290125 1100 "Find the general solution to the differential equation $\\frac{1}{\\sqrt{xy}}\\,{y}^{′}=1$ for $y\\ne 0.$" 13194139534470 true] [17592186290125 1113 #uuid "6da6b3d2-c0db-5d2c-8ab4-8655fe604ab1" 13194139534470 true] [17592186290125 1145 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{xy}}{y}^{′} & =1 \\\\ \\frac{1}{\\sqrt{xy}}\\,\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{x}}\\cdot \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\frac{1}{\\sqrt{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{x}\\end{aligned}\n$$\n\