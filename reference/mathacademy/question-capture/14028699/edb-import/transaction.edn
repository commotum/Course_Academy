[{:db/id "q-13837/selection/f48b848c0ba9eb972a6ecdade8ce516585f3a0e3b5dbeab089775adb9307dc15" :answer/id #uuid "e756493d-3c8c-57d8-90e1-be36dd1d5835" :answer/type :answer.type/math :answer/value "-\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-13837/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "69c99b6a-6c0f-5f8c-9951-8a54dff3d90d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-13837/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "2ebb5c01-1c79-5691-a284-503b3a980104" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-13837/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "01c32cb9-2ad9-50ca-a5c5-dca250f86cc1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-13837/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "4bcdf51d-9dea-5c4d-ad01-2bf5eed3179e" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-13837/selection" :answer-field/id #uuid "e9ffbbfe-9f09-5e1b-bc61-14e3d7d23971" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13837/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-13837/selection/f48b848c0ba9eb972a6ecdade8ce516585f3a0e3b5dbeab089775adb9307dc15" "q-13837/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-13837/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-13837/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-13837/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-13837" :question/id #uuid "a6c4fb19-6c0b-5ad6-b5c2-399285a74805" :question/math-academy-id "q-13837" :question/problem "What is the value of ${\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{0}^{2}u\\,\\text{d}u \\\\  & =\\frac{2}{3}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{2} \\\\  & ={\\frac{{u}^{2}}{3}|}_{0}^{2} \\\\  & =\\frac{{2}^{2}}{3}-\\frac{{0}^{2}}{3} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13837/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-13837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31402/selection/2644bb4fe283bde630f6afe170c8162bf360cff7a455f43575ba9cfaae3fd64c" :answer/id #uuid "bd965fb2-1789-5964-8ef8-b488cf979b3c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31402/selection/9d3f4f40bd0dc017e6eea8fa294a6ce9cdad8467a65359f57cb23c4b4e131250" :answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/ensure [:answer/validate]} {:db/id "q-31402/selection/6c4df8bfeb424309e914977f615c88f91af8f41cb44a9edb775c894c00c1af86" :answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/ensure [:answer/validate]} {:db/id "q-31402/selection/cad4a66ce66e9eccc55cab729ed88cb41464a9ecbc2d5952a14de1cef19bf6ef" :answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/ensure [:answer/validate]} {:db/id "q-31402/selection/5a23f5a0cebc13fe4684d7376007cd436ce0725d85c312ba8711ff25b4906c59" :answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type :answer.type/math :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/ensure [:answer/validate]} {:db/id "q-31402/selection" :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31402/selection/6c4df8bfeb424309e914977f615c88f91af8f41cb44a9edb775c894c00c1af86" :answer-field/choices ["q-31402/selection/2644bb4fe283bde630f6afe170c8162bf360cff7a455f43575ba9cfaae3fd64c" "q-31402/selection/9d3f4f40bd0dc017e6eea8fa294a6ce9cdad8467a65359f57cb23c4b4e131250" "q-31402/selection/6c4df8bfeb424309e914977f615c88f91af8f41cb44a9edb775c894c00c1af86" "q-31402/selection/cad4a66ce66e9eccc55cab729ed88cb41464a9ecbc2d5952a14de1cef19bf6ef" "q-31402/selection/5a23f5a0cebc13fe4684d7376007cd436ce0725d85c312ba8711ff25b4906c59"] :db/ensure [:answer-field/validate]} {:db/id "q-31402" :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-31402/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-31402"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49517/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f" :answer/id #uuid "9c711872-257a-5848-8e4c-dd1c657b00a4" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-49517/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "524ea2e2-f7bf-54c8-a8e1-0153d25e5d82" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-49517/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "746b73e3-a854-51ed-afa1-e49db2fca351" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-49517/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" :answer/id #uuid "13352cbc-e3ef-5c20-a984-a4f28355966f" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "q-49517/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" :answer/id #uuid "89e29aa9-bebb-5c9c-9daa-3656589fcf9d" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-49517/selection" :answer-field/id #uuid "a3fff10e-e01e-56b8-b4db-0fc67177d61f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49517/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" :answer-field/choices ["q-49517/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f" "q-49517/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-49517/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-49517/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" "q-49517/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90"] :db/ensure [:answer-field/validate]} {:db/id "q-49517" :question/id #uuid "c64c0963-f587-5317-a871-4cabd1c366d4" :question/math-academy-id "q-49517" :question/problem "What is the value of ${\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x}?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x} & ={\\int }_{e}^{{e}^{2}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =\\operatorname{ln}⁡2-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡2\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-49517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73655/selection/0cb03fe7ac81d1de002f3694bb8959315c3c39c40fa84e2ffd2a2dc55e2eca4c" :answer/id #uuid "45e4bfd9-8771-5c4f-994e-8ad5cc6880c0" :answer/type :answer.type/math :answer/value "8{ln}^{2}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73655/selection/7f71a5d5e1f9de08a40acbfa23f0a70eecd50452f9610289907329068d3de9d4" :answer/id #uuid "c3e63f95-ccce-5bbc-bc38-67c44512bce5" :answer/type :answer.type/math :answer/value "4{ln}^{2}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73655/selection/fdd792b046b3b350abd345961d10c1d4458b7ba3db0b3417a53eadf7ada48a0f" :answer/id #uuid "c09a8737-ed78-57d3-aa26-bacad5ffa153" :answer/type :answer.type/math :answer/value "8\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73655/selection/e753a76676684ac53d75b3a15c5cde1a0135810f6afcc5ec53fea7d55006bf07" :answer/id #uuid "9d5c1fe5-649e-5c9c-bbcb-2f1710de59cb" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73655/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f" :answer/id #uuid "4ad90a5e-2350-5d46-9460-7b2a345dafc9" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73655/selection" :answer-field/id #uuid "d4c34f04-67a4-5b53-911d-1aff60d25f14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73655/selection/7f71a5d5e1f9de08a40acbfa23f0a70eecd50452f9610289907329068d3de9d4" :answer-field/choices ["q-73655/selection/0cb03fe7ac81d1de002f3694bb8959315c3c39c40fa84e2ffd2a2dc55e2eca4c" "q-73655/selection/7f71a5d5e1f9de08a40acbfa23f0a70eecd50452f9610289907329068d3de9d4" "q-73655/selection/fdd792b046b3b350abd345961d10c1d4458b7ba3db0b3417a53eadf7ada48a0f" "q-73655/selection/e753a76676684ac53d75b3a15c5cde1a0135810f6afcc5ec53fea7d55006bf07" "q-73655/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f"] :db/ensure [:answer-field/validate]} {:db/id "q-73655" :question/id #uuid "76948c35-6b31-5ab2-9ce4-a6587cc4fbab" :question/math-academy-id "q-73655" :question/problem "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73655/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-73655"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114021/selection/05d1790d511a94183f257617de1b4fe61c65c4a408c8addfa47e676d992e70da" :answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114021/selection/53b6de425d1d9295b68f7e76bef268f827e5584659e358662b423c2a47616b2e" :answer/id #uuid "0af5c69f-4a32-5280-8629-56cf6cc6a40e" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114021/selection/8a082fcf86bbc78dafd337191afcd76b7ae734c84b96392c1fbbe117dc671e7c" :answer/id #uuid "4564c6d0-559d-5e06-9ade-60604719e2da" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114021/selection/b211d72543d362d87fef0dd0e11dcbd79699d8d00efbf4e98827c1b6758fd923" :answer/id #uuid "09910614-5f8e-57ca-b9bb-cdbbdc063de9" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡7\\cdot {log}_{7}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114021/selection/0e3c94cc9937e450858a3d3aa8854247acb532500198db9be4fc35441c498bcf" :answer/id #uuid "319ec15c-ba68-5e46-9aaf-8ac3f4fab1e5" :answer/type :answer.type/math :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114021/selection" :answer-field/id #uuid "cd76030c-9865-5c76-b381-8194bd798e5f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114021/selection/05d1790d511a94183f257617de1b4fe61c65c4a408c8addfa47e676d992e70da" :answer-field/choices ["q-114021/selection/05d1790d511a94183f257617de1b4fe61c65c4a408c8addfa47e676d992e70da" "q-114021/selection/53b6de425d1d9295b68f7e76bef268f827e5584659e358662b423c2a47616b2e" "q-114021/selection/8a082fcf86bbc78dafd337191afcd76b7ae734c84b96392c1fbbe117dc671e7c" "q-114021/selection/b211d72543d362d87fef0dd0e11dcbd79699d8d00efbf4e98827c1b6758fd923" "q-114021/selection/0e3c94cc9937e450858a3d3aa8854247acb532500198db9be4fc35441c498bcf"] :db/ensure [:answer-field/validate]} {:db/id "q-114021" :question/id #uuid "8ffcfa20-542a-5da6-b7ce-c73215ba6769" :question/math-academy-id "q-114021" :question/problem "$\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{7}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114021/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-114021"] :db/ensure [:knowledge-point/validate]}]
