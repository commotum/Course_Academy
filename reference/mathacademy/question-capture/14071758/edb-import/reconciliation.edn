Academy/reference/mathacademy/question-capture-workers/linear/14038863/edb-import/verification.json"} {"question" "q-174432" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/activity-metadata.json" "file_sha256" "738a4e0cbcad33d280093808d8491a29f9b6bae5ddd19b897166250d0475262a" "basis" 1346 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/edb-import/verification.json"} {"question" "q-174432" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "6450dd7505d899bc08eefb0d4bdb0216ac4dcc1cfb5eaba8bef3922f75b5e157" "basis" 1346 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/edb-import/verification.json"} {"question" "q-174432" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{-2,-1,0,1,2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "6450dd7505d899bc08eefb0d4bdb0216ac4dcc1cfb5eaba8bef3922f75b5e157" "basis" 1346 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/edb-import/verification.json"} {"question" "q-174432" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{-2,0,1,2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038863/state.json" "file_sha256" "6450dd7505d899bc08eefb0d4bdb0216ac4dcc1cfb5eaba8bef3922f75b5e157" "basis" 1346 "verification" "/home/jake/Developer/Course_Academy/reference/mat