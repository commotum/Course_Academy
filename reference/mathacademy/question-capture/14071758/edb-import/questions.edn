ion/worked-solution "To write down the elements of ${B}_{3},$ we substitute $i=3$ into the expression and get\n\n$$\n\\begin{aligned}{B}_{3} & ={0,\\frac{3}{3},3+1} \\\\  & ={0,1,4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301858 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c47c3fe-ec07-5b80-aa8c-fa8e851f2afa" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301860} {:answer/id #uuid "93ebb613-fdf9-5e54-b8f1-14a90aec09b3" :answer/type {:db/ident :answer.type/math} :answer/value "(1,{\\pi }^{2}]" :db/id #edb/ref 17592186301861} {:answer/id #uuid "bc00795a-0ae9-5144-9e4f-755af8782a89" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186301862} {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} {:answer/id #uuid "3d293630-1ea0-50f6-929b-fef5636b0265" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186301864}] :answer-field/correct {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} :answer-field/id #uuid "652575d2-1133-52ba-aa18-1777b2241940" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301859}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3b913652-35e0-5990-a89e-87d94dd9275f" :question/math-academy-id "q-174350" :question/problem "Let ${S}_{x}=(\\operatorname{sin}⁡x,{x}^{2}+{\\pi }^{2}],$ where $x\\in [0,2\\pi ).$ Then, ${S}_{\\pi }=$" :question/worked-solution "To write down the elements of ${S}_{\\pi },$ we substitute $x=\\pi $ into the expression and get\n\n$$\n\\begin{aligned}{S}_{\\pi } & =(\\operatorname{sin}⁡(\\pi ),\\,(\\pi )^{2}+{\\pi }^{2}] \\\\  & =(0,2{\\pi }^{2}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301879 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70aa514d-ce85-5ef3-a4d6-34797ec872d3" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301881} {:answer/id #uuid "c97317a8-a746-5750-b28a-a07f90a98120" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301882} {:answer/id #uuid "0d101027-229f-52b6-9945-fbbf2fd4db44" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,1,2}" :db/id #edb/ref 17592186301883} {:answer/id #uuid "d8ef49f9-ab3d-5220-a75f-ce3b42b6e7e0" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,2}" :db/id #edb/ref 17592186301884} {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186301885}] :answer-field/correct {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186301885} :answer-field/id #uuid "9a15f3b5-e99a-5dee-99dc-c88d7567146d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301880}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef27fbd0-7df4-5dde-8dc8-ee9c354474a1" :question/math-academy-id "q-174432" :question/problem "Find ${⋃}_{i\\in I}{X}_{i}$, given that $I={-2,1,2},$ and\n\n$$\n\\begin{aligned}{X}_{-2}={-2,-1,0},\\,{X}_{1}={0,1},\\,{X}_{2}={0,1,2}.\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i} & ={X}_{-2}\\cup {X}_{1}\\cup {X}_{2} \\\\  & ={-2,-1,0}\\,\\cup \\,{0,1}\\,\\cup \\,{0,1,2} \\\\  & ={-2,-1,0,1,2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301900 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "705a4e97-b646-5b2d-b9b4-69c1d33d2ab0" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301902} {:answer/id #uuid "95592a43-1738-5c1d-8443-f1d1bd6ac31e" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301903} {:answer/id #uuid "22984d0c-1c38-5606-9d7a-fea6e1c437a3" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\,1}" :db/id #edb/ref 17592186301904} {:answer/id #uuid "8b38faa4-4aee-523d-992a-2f02a360a59f" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186301905} {:answer/id #uuid "2d26066e-8356-5ea8-9303-7f13424cfdca" :answer/type {:db/ident :answer.type/math} :answer/value "{i}" :db/id #edb/ref 17592186301906}] :answer-field/correct {:answer/id #uuid "705a4e97-b646-5b2d-b9b4-69c1d33d2ab0" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301902} :answer-field/id #uuid "36bacc20-0e84-5e2a-bd9a-66636e93471f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301901}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2127b35a-3511-5ad2-8ca4-d1c00cbec952" :question/math-academy-id "q-174447" :question/problem "Let $I=Z$ and ${X}_{i}={i-1,\\,i},$ then ${⋂}_{i\\in I}{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=-1,$ we have ${X}_{-1}={-2,-1}$\n\n- if $i=0,$ we have ${X}_{0}={-1,0}$\n\n- if $i=1,$ we have ${X}_{1}={0,1}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}]}
