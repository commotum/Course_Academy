int is $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i}=[1,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-174454/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845"] :knowledge-point/questions ["q-174454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-174450/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" :answer/id #uuid "d76e65c4-56ba-5562-9854-91e9b5ac5da2" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id "q-174450/selection/3f48c5d66954b2c239135dfbfd7897cab553793bde08ceadd4dc08ad57828434" :answer/id #uuid "0fcb9ab4-6a38-59fa-9790-78f66f1330d7" :answer/type :answer.type/math :answer/value "{0}" :db/ensure [:answer/validate]} {:db/id "q-174450/selection/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "3c58950c-7d5c-5874-a18e-3960a8bbad6b" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-174450/selection/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" :answer/id #uuid "539abb9f-c47a-5735-a4e3-59646a3c67ff" :answer/type :answer.type/math :answer/value "N" :db/ensure [:answer/validate]} {:db/id "q-174450/selection/0fff4413fa387084e7d53959737f0fb0f1392a783a8c9a50980eafb3e78f0fa1" :answer/id #uuid "391d8c48-65d0-5f00-968a-dd7da5fb15ba" :answer/type :answer.type/math :answer/value "{-i,0,i}" :db/ensure [:answer/validate]} {:db/id "q-174450/selection" :answer-field/id #uuid "463b3440-dae3-5bc9-93e5-5440d7c20a77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-174450/selection/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer-field/choices ["q-174450/selection/2531b01062963bf17cb1953367062769d91dcfc4519f4f6b120c5de4951d40dd" "q-174450/selection/3f48c5d66954b2c239135dfbfd7897cab553793bde08ceadd4