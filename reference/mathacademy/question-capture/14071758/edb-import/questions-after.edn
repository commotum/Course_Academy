#{[{:db/id #edb/ref 17592186054275 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/id #uuid "154d4cf7-a72a-51b1-bbb3-9bcf83b88e98" :question/math-academy-id "e-12665" :question/problem "Find $T_2$ given that $T_n = \\{ 1, 2, \\ldots, 2n+1 \\},$ where $n \\in \\mathbb{N}.$" :question/worked-solution "To write down the elements of $T_2,$ we substitute $n=2$ into the expression and get\n\n$$\n\\begin{aligned}{T}_{2} & ={1,2,…,2(2)+1} \\\\  & ={1,2,…,5} \\\\  & ={1,2,3,4,5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054282 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/id #uuid "60e24dac-c47a-53ee-9c91-0e6987e966f0" :question/math-academy-id "e-12763" :question/problem "Find $\\,\\displaystyle \\bigcup_{i \\in I} S_i$, given that $I = \\{ -1, 0, 1 \\},$ and $S_i = (i-1, \\,i+1).$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n\\bigcup_{i \\in I} A_i = \\big\\{ x\\in U \\: : \\: x \\in A_i \\:\\:\\textrm{for at least one } A_i,\\:\\: i \\in I \\big\\}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{-1}\\cup {S}_{0}\\cup {S}_{1} \\\\  & =(-2,0)\\,\\cup \\,(-1,1)\\,\\cup \\,(0,2) \\\\  & =(-2,2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054283 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/id #uuid "842ee2c1-8e78-56dd-b109-b9fcc273704e" :question/math-academy-id "e-12764" :question/problem "Find $\\,\\displaystyle \\bigcap_{i \\in I} X_i$  given that $I = \\mathbb{N}$ and $X_i = \\{ i, \\, 2i \\}.$" :question/worked-solution "The intersection of a family of indexed sets $\\{A_i\\}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n\\bigcap_{i \\in I} A_i = \\big\\{ x\\in U \\: : \\: x \\in A_i \\:\\:\\textrm{for all } A_i,\\:\\: i \\in I \\big\\}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have $X_1 = \\{ 1, 2 \\}$\n\n- if $i=2,$ we have $X_2 = \\{ 2, 4 \\}$\n\n- if $i=3,$ we have $X_3 = \\{ 3, 6 \\}$\n\n- if $i=4,$ we have $X_4 = \\{ 4, 8 \\}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054959 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a41d844b-a17d-5f56-b2ac-5ef53397a937" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1, 0, 1, 2}" :db/id #edb/ref 17592186051696} {:answer/id #uuid "c607dee7-292f-56d4-857f-69c669c1f240" :answer/type {:db/ident :answer.type/math} :answer/value "{-4, 0, 4}" :db/id #edb/ref 17592186051697} {:answer/id #uuid "f71e639e-aa99-5e93-9025-736c54785389" :answer/type {:db/ident :answer.type/math} :answer/value "{-2, 0, 2}" :db/id #edb/ref 17592186051698} {:answer/id #uuid "35921484-5768-5484-8ebb-9a8a12f489c8" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186051699} {:answer/id #uuid "47807ad2-a124-5b85-af75-4b2c042e37b3" :answer/type {:db/ident :answer.type/math} :answer/value "{-4,-3,-2,-1, 0, 1, 2, 3, 4}" :db/id #edb/ref 17592186051700}] :answer-field/correct {:answer/id #uuid "c607dee7-292f-56d4-857f-69c669c1f240" :answer/type {:db/ident :answer.type/math} :answer/value "{-4, 0, 4}" :db/id #edb/ref 17592186051697} :answer-field/id #uuid "e1784f6a-16c7-50a2-b633-7ed9131a61f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051695}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "77aae56c-e4ac-576d-8d1a-15be238dce04" :question/math-academy-id "q-172662" :question/problem "Let ${A}_{i}={-{i}^{2},0,2i},$ where $i\\in {1,2,3,4,5}.$ Then, ${A}_{2}=$" :question/worked-solution "To write down the elements of ${A}_{2},$ we substitute $i=2$ into the expression and get\n\n$$\n\\begin{aligned}{A}_{2} & ={-(2)^{2},\\,0,\\,2(2)} \\\\  & ={-4,0,4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054960 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "891c57e7-7a8a-5a83-af70-6e0a6138792b" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, …, 41}" :db/id #edb/ref 17592186051702} {:answer/id #uuid "dd10fbcf-f5f8-5985-bdde-e51481dc5833" :answer/type {:db/ident :answer.type/math} :answer/value "{-5,-4, …, 4, 5}" :db/id #edb/ref 17592186051703} {:answer/id #uuid "1a08f111-d2ce-56fa-a5aa-7848cd20fe16" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4}" :db/id #edb/ref 17592186051704} {:answer/id #uuid "66e3711c-df15-5144-a652-2053423cbc5c" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4, 5}" :db/id #edb/ref 17592186051705} {:answer/id #uuid "6daee3a7-a690-5985-8150-de2b8d250f3a" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186051706}] :answer-field/correct {:answer/id #uuid "66e3711c-df15-5144-a652-2053423cbc5c" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, 4, 5}" :db/id #edb/ref 17592186051705} :answer-field/id #uuid "5034b73e-83b1-57b2-b792-e9e5c81b2e5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051701}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3bbe0ff8-2b59-5a83-81b0-7e5b39b20a89" :question/math-academy-id "q-172665" :question/problem "Let ${S}_{n}={1,2,…,n+1},$ where $n\\in N.$ Then, ${S}_{4}=$" :question/worked-solution "To write down the elements of ${S}_{4},$ we substitute $n=4$ into the expression and get\n\n$$\n\\begin{aligned}{S}_{4} & ={1,2,…,4+1} \\\\  & ={1,2,…,5} \\\\  & ={1,2,3,4,5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301837 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d70040-3661-5c8f-a202-b312f83f8c37" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301839} {:answer/id #uuid "a6068690-7340-5af7-9af3-4a46faf38598" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301840} {:answer/id #uuid "6f287108-616a-527f-a7c2-13bd348ce872" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,3}" :db/id #edb/ref 17592186301841} {:answer/id #uuid "c35f2a07-e624-5d9a-99fa-6127d82266a0" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,3,4}" :db/id #edb/ref 17592186301842} {:answer/id #uuid "36b72640-0d38-5ab8-80ee-5b581273e77e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,4}" :db/id #edb/ref 17592186301843}] :answer-field/correct {:answer/id #uuid "36b72640-0d38-5ab8-80ee-5b581273e77e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,4}" :db/id #edb/ref 17592186301843} :answer-field/id #uuid "6014c28f-f171-5876-a557-1f68b86d8e5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592