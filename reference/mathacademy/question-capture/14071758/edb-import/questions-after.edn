uestion/id #uuid "3f799de6-950d-5a63-a281-49e95d5ade18" :question/math-academy-id "q-174342" :question/problem "Let ${D}_{i}={2i-1,-i,1,i+2},$ where $i\\in {0,2,3,5}.$ Then, ${D}_{0}=$" :question/worked-solution "To write down the elements of ${D}_{0},$ we substitute $i=0$ into the expression and get\n\n$$\n\\begin{aligned}{D}_{0} & ={2(0)-1,-0,1,0+2} \\\\  & ={-1,0,1,2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301858 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c47c3fe-ec07-5b80-aa8c-fa8e851f2afa" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301860} {:answer/id #uuid "93ebb613-fdf9-5e54-b8f1-14a90aec09b3" :answer/type {:db/ident :answer.type/math} :answer/value "(1,{\\pi }^{2}]" :db/id #edb/ref 17592186301861} {:answer/id #uuid "bc00795a-0ae9-5144-9e4f-755af8782a89" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186301862} {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} {:answer/id #uuid "3d293630-1ea0-50f6-929b-fef5636b0265" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186301864}] :answer-field/correct {:answer/id #uuid "a043c953-86ec-56ed-9a0b-4dbdd57daf5e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2{\\pi }^{2}]" :db/id #edb/ref 17592186301863} :answer-field/id #uuid "652575d2-1133-52ba-aa18-1777b2241940" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301859}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3b913652-35e0-5990-a89e-87d94dd9275f" :question/math-academy-id "q-174350" :question/problem "Let ${S}_{x}=(\\operatorname{sin}⁡x,{x}^{2}+{\\pi }^{2}],$ where $x\\in [0,2\\pi ).$ Then, ${S}_{\\pi }=$" :question/worked-solution "To write down the elements of ${S}_{\\pi },$ we substitute $x=\\pi $ into the expression and get\n\n$$\n\\begin{aligned}{S}_{\\pi } & =(\\operatorname{sin}⁡(\\pi ),\\,(\\pi )^{2}+{\\pi }^{2}] \\\\  & =(0,2{\\pi }^{2}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301879 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70aa514d-ce85-5ef3-a4d6-34797ec872d3" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186301881} {:answer/id #uuid "c97317a8-a746-5750-b28a-a07f90a98120" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301882} {:answer/id #uuid "0d101027-229f-52b6-9945-fbbf2fd4db44" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,1,2}" :db/id #edb/ref 17592186301883} {:answer/id #uuid "d8ef49f9-ab3d-5220-a75f-ce3b42b6e7e0" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,2}" :db/id #edb/ref 17592186301884} {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186301885}] :answer-field/correct {:answer/id #uuid "9602fe9e-1b01-562b-bd1a-e0f9e9a4c054" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,1,2}" :db/id #edb/ref 17592186301885} :answer-field/id #uuid "9a15f3b5-e99a-5dee-99dc-c88d7567146d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301880}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef27fbd0-7df4-5dde-8dc8-ee9c354474a1" :question/math-academy-id "q-174432" :question/problem "Find ${⋃}_{i\\in I}{X}_{i}$, given that $I={-2,1,2},$ and\n\n$$\n\\begin{aligned}{X}_{-2}={-2,-1,0},\\,{X}_{1}={0,1},\\,{X}_{2}={0,1,2}.\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i} & ={X}_{-2}\\cup {X}_{1}\\cup {X}_{2} \\\\  & ={-2,-1,0}\\,\\cup \\,{0,1}\\,\\cup \\,{0,1,2} \\\\  & ={-2,-1,0,1,2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373140 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d593b8cd-0b73-5691-9a7f-405907eb6bb4" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186373142} {:answer/id #uuid "603db64b-7168-5e1c-8d92-5ba76fcc462b" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373143} {:answer/id #uuid "add1bdb9-e716-5b3c-8e0b-fa09b21b01ce" :answer/type {:db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186373144} {:answer/id #uuid "fa1e403b-963d-51bc-8800-f0f2f993592e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186373145} {:answer/id #uuid "ee22fe2f-67e4-50c9-8dcf-80eba226edb5" :answer/type {:db/ident :answer.type/math} :answer/value "[0,1]" :db/id #edb/ref 17592186373146}] :answer-field/correct {:answer/id #uuid "add1bdb9-e716-5b3c-8e0b-fa09b21b01ce" :answer/type {:db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186373144} :answer-field/id #uuid "f99899aa-14cf-5c01-b898-45d70166353d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373141}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8465ac03-30ce-5a0e-b3a1-d521ab7c4513" :question/math-academy-id "q-174434" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I={0,1,2},$ and\n\n$$\n\\begin{aligned}{S}_{0}={0},\\,{S}_{1}=(0,1),\\,{S}_{2}=(0,2).\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{0}\\cup {S}_{1}\\cup {S}_{2} \\\\  & ={0}\\,\\cup \\,(0,1)\\,\\cup \\,(0,2) \\\\  & =[0,2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373147 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30b92f75-7be9-5606-b5b0-d28eadd80656" :answer/type {:db/ident :answer.type/math} :answer/value "{5,6,7,8}" :db/id #edb/ref 17592186373149} {:answer/id #uuid "a1f4eab6-3edf-5788-b57b-17f13de17f69" :answer/type {:db/ident :answer.type/math} :answer/value "(4,7]" :db/id #edb/ref 17592186373150} {:answer/id #uuid "93ad1ea4-f96b-593f-9551-959c0c721a16" :answer/type {:db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186373151} {:answer/id #uuid "24f994ff-d01f-5d66-8263-bdf69ac94083" :answer/type {:db/ident :answer.type/math} :answer/value "[5,7]" :db/id #edb/ref 17592186373152} {:answer/id #uuid "00fff02f-0aa0-5d59-884f-4503d1739c9d" :answer/type {:db/ident :answer.type/math} :answer/value "[5,7)" :db/id #edb/ref 17592186373153}] :answer-field/correct {:answer/id #uuid "93ad1ea4-f96b-593f-9551-959c0c721a16" :answer/type {:db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186373151} :answer-field/id #uuid "b5fea6bc-63d4-5119-be61-552c52522d6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373148}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2e93c9f4-a402-5b49-98b4-23f3ef0f2a88" :question/math-academy-id "q-174435" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I={5,6,7},$ and\n${S}_{i}=[i,\\,i+1).$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{5}\\cup {S}_{6}\\cup {S}_{7} \\\\  & =[5,6)\\,\\cup \\,[6,7)\\,\\cup \\,[7,8) \\\\  & =[5,8).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301900 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "705a4e97-b646-5b2d-b9b4-69c1d33d2ab0" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301902} {:answer/id #uuid "95592a43-1738-5c1d-8443-f1d1bd6ac31e" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186301903} {:answer/id #uuid "22984d0c-1c38-5606-9d7a-fea6e1c437a3" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\,1}" :db/id #edb/ref 17592186301904} {:answer/id #uuid "8b38faa4-4aee-523d-992a-2f02a360a59f" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186301905} {:answer/id #uuid "2d26066e-8356-5ea8-9303-7f13424cfdca" :answer/type {:db/ident :answer.type/math} :answer/value "{i}" :db/id #edb/ref 17592186301906}] :answer-field/correct {:answer/id #uuid "705a4e97-b646-5b2d-b9b4-69c1d33d2ab0" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186301902} :answer-field/id #uuid "36bacc20-0e84-5e2a-bd9a-66636e93471f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301901}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2127b35a-3511-5ad2-8ca4-d1c00cbec952" :question/math-academy-id "q-174447" :question/problem "Let $I=Z$ and ${X}_{i}={i-1,\\,i},$ then ${⋂}_{i\\in I}{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=-1,$ we have ${X}_{-1}={-2,-1}$\n\n- if $i=0,$ we have ${X}_{0}={-1,0}$\n\n- if $i=1,$ we have ${X}_{1}={0,1}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373154 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a974bd-34df-5539-a51f-b988288577af" :answer/type {:db/ident :answer.type/math} :answer/value "{1}" :db/id #edb/ref 17592186373156} {:answer/id #uuid "4fcb192e-77e0-51af-a080-dc32995ad0c3" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373157} {:answer/id #uuid "5ca71b94-157b-52cf-a62a-e5ebb70f6c6c" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1}" :db/id #edb/ref 17592186373158} {:answer/id #uuid "032132dc-4a4e-5530-b435-c4069330018d" :answer/type {:db/ident :answer.type/math} :answer/value "{2i}" :db/id #edb/ref 17592186373159} {:answer/id #uuid "b42b8870-8bbe-5535-90fe-e607e612468e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,2}" :db/id #edb/ref 17592186373160}] :answer-field/correct {:answer/id #uuid "b42b8870-8bbe-5535-90fe-e607e612468e" :answer/type {:db/ident :answer.type/math} :answer/value "{0,2}" :db/id #edb/ref 17592186373160} :answer-field/id #uuid "b0fc744a-152d-5abc-8b1b-fe24a8313801" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373155}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f81401fc-7272-545a-b669-3931fdd2ff90" :question/math-academy-id "q-174449" :question/problem "Let $I=N$ and ${X}_{i}={0,2,…,2i},$ then ${⋂}_{i\\in I}{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${X}_{1}={0,2}$\n\n- if $i=2,$ we have ${X}_{2}={0,2,4}$\n\n- if $i=3,$ we have ${X}_{3}={0,2,4,6}$\n\nand so on. \n\nNotice that the only elements that lie in all the sets are $0$ and $2.$ Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}={0,2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373161 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391d8c48-65d0-5f00-968a-dd7da5fb15ba" :answer/type {:db/ident :answer.type/math} :answer/value "{-i,0,i}" :db/id #edb/ref 17592186373163} {:answer/id #uuid "539abb9f-c47a-5735-a4e3-59646a3c67ff" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186373164} {:answer/id #uuid "d76e65c4-56ba-5562-9854-91e9b5ac5da2" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373165} {:answer/id #uuid "0fcb9ab4-6a38-59fa-9790-78f66f1330d7" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186373166} {:answer/id #uuid "3c58950c-7d5c-5874-a18e-3960a8bbad6b" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186373167}] :answer-field/correct {:answer/id #uuid "3c58950c-7d5c-5874-a18e-3960a8bbad6b" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186373167} :answer-field/id #uuid "463b3440-dae3-5bc9-93e5-5440d7c20a77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373162}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8c18cb2f-40d9-561a-ae86-f5069b2faa43" :question/math-academy-id "q-174450" :question/problem "Let $I=N$ and ${X}_{i}={-i,\\,0,\\,i},$ then ${⋃}_{i\\in I}{X}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${X}_{1}={-1,0,1}$\n\n- if $i=2,$ we have ${X}_{2}={-2,0,2}$\n\n- if $i=3,$ we have ${X}_{3}={-3,0,3}$\n\nand so on. \n\nNotice that all the integers belong to one of the sets.\n\nTherefore, \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i}=Z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373168 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e81ba4e-1871-5453-bffd-c44bb55044a2" :answer/type {:db/ident :answer.type/math} :answer/value "[0,2]" :db/id #edb/ref 17592186373170} {:answer/id #uuid "a34cbcce-07e7-529e-86d7-1250ed0ea7d2" :answer/type {:db/ident :answer.type/math} :answer/value "[0,1)" :db/id #edb/ref 17592186373171} {:answer/id #uuid "9048aeca-16e2-5edc-90fc-81f08fdd089d" :answer/type {:db/ident :answer.type/math} :answer/value "[1,2]" :db/id #edb/ref 17592186373172} {:answer/id #uuid "13403842-e333-53ce-ab13-b4165d514dcb" :answer/type {:db/ident :answer.type/math} :answer/value "[0,1]" :db/id #edb/ref 17592186373173} {:answer/id #uuid "5dbcc888-d126-5e70-9d94-2cab73a8a0f8" :answer/type {:db/ident :answer.type/math} :answer/value "[0,3)" :db/id #edb/ref 17592186373174}] :answer-field/correct {:answer/id #uuid "6e81ba4e-1871-5453-bffd-c44bb55044a2" :answer/type {:db/ident :answer.type/math} :answer/value "[0,2]" :db/id #edb/ref 17592186373170} :answer-field/id #uuid "806ca8cd-5181-50b2-b814-6723606bd58a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373169}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e93345f2-3174-5a0c-9411-82956332baac" :question/math-academy-id "q-174452" :question/problem "Let $I=N$ and ${S}_{i}=[0,\\,1+\\frac{1}{i}],$ then ${⋃}_{i\\in I}{S}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${S}_{1}=[0,2]$\n\n- if $i=2,$ we have ${S}_{2}=[0,\\frac{3}{2}]$\n\n- if $i=3,$ we have ${S}_{3}=[0,\\frac{4}{3}]$\n\nand so on. \n\nNotice that as $i$ increases, \n\n- the left endpoint of the intervals is $0$ for all the sets,\n\n- the right endpoint of the intervals approaches $1$ but never reaches it.\n\nMoreover, all the intervals are contained in ${S}_{1}.$\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i}={S}_{1}=[0,2].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373175 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa173421-d267-5720-85e4-7b13bf62d262" :answer/type {:db/ident :answer.type/math} :answer/value "[1,3]" :db/id #edb/ref 17592186373177} {:answer/id #uuid "69a8d507-f6b1-5cb1-b5ee-71b4e9828733" :answer/type {:db/ident :answer.type/math} :answer/value "[2,\\infty )" :db/id #edb/ref 17592186373178} {:answer/id #uuid "eeccd4b6-a196-57c3-beb4-4ca0dfb2e21c" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373179} {:answer/id #uuid "a7b0814a-29e1-55f4-bbe0-1383f4882888" :answer/type {:db/ident :answer.type/math} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186373180} {:answer/id #uuid "b481eaab-722e-578b-b8e7-df73da507406" :answer/type {:db/ident :answer.type/math} :answer/value "[1,2]" :db/id #edb/ref 17592186373181}] :answer-field/correct {:answer/id #uuid "a7b0814a-29e1-55f4-bbe0-1383f4882888" :answer/type {:db/ident :answer.type/math} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186373180} :answer-field/id #uuid "f83e6c25-d4ec-55c8-9ee1-33b76f43766a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373176}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "339f82bb-aa03-5f27-aba6-89ff4c363bd5" :question/math-academy-id "q-174454" :question/problem "Let $I=N$ and ${S}_{i}=[i,\\,{i}^{2}+1],$ then ${⋃}_{i\\in I}{S}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${S}_{1}=[1,2]$\n\n- if $i=2,$ we have ${S}_{2}=[2,5]$\n\n- if $i=3,$ we have ${S}_{3}=[3,10]$\n\nand so on.\n\nNotice that as $i$ increases the left and right endpoints of the intervals approaches $\\infty .$ The smallest left endpoint is $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i}=[1,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373182 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "914d4384-f6bc-54b7-9dae-81e75272ef26" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pm 1,\\pm 2,\\pm 3}" :db/id #edb/ref 17592186373184} {:answer/id #uuid "43bb64da-84c6-55a9-9e9e-377e1c8db4ff" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186373185} {:answer/id #uuid "436405b7-9ad1-5cde-a7b4-66de088b215b" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373186} {:answer/id #uuid "e3eebb57-045c-5150-90aa-f4a4fe1299bb" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186373187} {:answer/id #uuid "e22946c8-3c03-5958-bafb-84586dfca4a5" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\pm 1,\\pm 2,\\pm 3}" :db/id #edb/ref 17592186373188}] :answer-field/correct {:answer/id #uuid "e22946c8-3c03-5958-bafb-84586dfca4a5" :answer/type {:db/ident :answer.type/math} :answer/value "{0,\\pm 1,\\pm 2,\\pm 3}" :db/id #edb/ref 17592186373188} :answer-field/id #uuid "a2872c2c-242f-5922-9c48-62cd27789e20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373183}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "97ca40b8-4855-51a9-b7c0-ff8ffbfe5093" :question/math-academy-id "q-184612" :question/problem "Find ${⋃}_{i=1}^{3}{X}_{i}$, given that \n\n$$\n\\begin{aligned}{X}_{1}={-1,0,1},\\,{X}_{2}={-2,0,2},\\,{X}_{3}={-3,0,3}.\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋃}_{i=1}^{3}$ means that our index set is \n${1,2,3}.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{⋃}_{i=1}^{3}{X}_{i} & ={X}_{1}\\cup {X}_{2}\\cup {X}_{3} \\\\  & ={-1,0,1}\\,\\cup \\,{-2,0,2}\\,\\cup \\,{-3,0,3} \\\\  & ={0,\\pm 1,\\pm 2,\\pm 3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373189 :knowledge-point/_questions [{:knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a2279ee-e42e-528f-9c4a-3070419a0f76" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186373191} {:answer/id #uuid "32962fba-aae2-524e-bd31-0db7df6188fa" :answer/type {:db/ident :answer.type/math} :answer/value "{-3,-2,-1,0,2,3}" :db/id #edb/ref 17592186373192} {:answer/id #uuid "2d4c234c-944e-57ec-a9ad-dc7501792941" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,2,3}" :db/id #edb/ref 17592186373193} {:answer/id #uuid "9128df88-6acd-5b46-a2d5-c12e261790d9" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,2,3}" :db/id #edb/ref 17592186373194} {:answer/id #uuid "6508813f-37d0-5ded-a27d-0d0858b8bcf8" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,2,3}" :db/id #edb/ref 17592186373195}] :answer-field/correct {:answer/id #uuid "9128df88-6acd-5b46-a2d5-c12e261790d9" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,-1,0,2,3}" :db/id #edb/ref 17592186373194} :answer-field/id #uuid "5b970013-34a1-524a-a068-62c2c87e2dc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373190}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "88da868c-5846-5286-9189-c21f0d5a4285" :question/math-academy-id "q-184639" :question/problem "Find ${⋃}_{i=0}^{2}{X}_{i}$, given that \n\n$$\n\\begin{aligned}{X}_{0}={-2,-1,2},\\,{X}_{1}={-1,0,2},\\,{X}_{2}={-2,0,3}.\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nThe notation ${⋃}_{i=0}^{2}$ means that our index set is \n${0,1,2}.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{⋃}_{i=0}^{2}{X}_{i} & ={X}_{0}\\cup {X}_{1}\\cup {X}_{2} \\\\  & ={-2,-1,2}\\,\\cup \\,{-1,0,2}\\,\\cup \\,{-2,0,3} \\\\  & ={-2,-1,0,2,3}.\\end{aligned}\n$$"}]}
