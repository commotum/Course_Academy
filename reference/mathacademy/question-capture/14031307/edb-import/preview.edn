t)|,$ we conclude that the speed of the particle is $8\\,\\text{m/s}.$" 13194139534524 true] [17592186293089 1000 #edb/ref 17592186293090 13194139534524 true] [17592186293089 1000 #edb/ref 17592186293091 13194139534524 true] [17592186293089 1000 #edb/ref 17592186293092 13194139534524 true] [17592186293089 1000 #edb/ref 17592186293093 13194139534524 true] [17592186293089 1000 #edb/ref 17592186293094 13194139534524 true] [17592186293089 1040 #edb/ref 17592186045450 13194139534524 true] [17592186293089 1041 "selection" 13194139534524 true] [17592186293089 1104 #edb/ref 17592186293091 13194139534524 true] [17592186293089 1110 #uuid "b0821bfa-2a7b-522d-af11-dd32a8ec57b0" 13194139534524 true] [17592186293090 1034 "16\\,\\text{m/s}" 13194139534524 true] [17592186293090 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293090 1111 #uuid "229f3361-a069-5d11-98b8-9e17ad6afed4" 13194139534524 true] [17592186293091 1034 "8\\,\\text{m/s}" 13194139534524 true] [17592186293091 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293091 1111 #uuid "29570dd1-e291-57bc-8b6e-cf8465f5c412" 13194139534524 true] [17592186293092 1034 "14\\,\\text{m/s}" 13194139534524 true] [17592186293092 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293092 1111 #uuid "7c3fe598-d5a8-5880-a268-2f866d9a80bd" 13194139534524 true] [17592186293093 1034 "12\\,\\text{m/s}" 13194139534524 true] [17592186293093 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293093 1111 #uuid "2ed2a1ae-1b0e-53f8-9876-05b05d79c543" 13194139534524 true] [17592186293094 1034 "4\\,\\text{m/s}" 13194139534524 true] [17592186293094 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293094 1111 #uuid "1ee65b08-2504-5fd6-8f88-44b6feac33aa" 13194139534524 true] [17592186293095 1017 #edb/ref 17592186293096 13194139534524 true] [17592186293095 1089 "q-346883" 13194139534524 true] [17592186293095 1091 #edb/ref 17592186045463 13194139534524 true] [17592186293095 1100 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=12{t}^{5}+5{t}^{4},$ where $t$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=6\\,\\text{m/s}$ when $t=1\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" 13194139534524 true] [17592186293095 1113 #uuid "fd69d235-be6f-5d7e-afe1-9f5f4f1fa348" 13194139534524 true] [17592186293095 1145 "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (12{t}^{5}+5{t}^{4})\\text{d}t \\\\  & =2{t}^{6}+{t}^{5}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=6.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}6 & =2({1}^{6})+{1}^{5}+C \\\\ 6 & =3+C \\\\ C & =3.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=2{t}^{6}+{t}^{5}+3.$" 13194139534524 true] [17592186293096 1000 #edb/ref 17592186293097 13194139534524 true] [17592186293096 1000 #edb/ref 17592186293098 13194139534524 true] [17592186293096 1040 #edb/ref 17592186045449 13194139534524 true] [17592186293096 1041 "field-1" 13194139534524 true] [17592186293096 1104 #edb/ref 17592186293098 13194139534524 true] [17592186293096 1110 #uuid "db3334eb-9035-531f-a680-f558d38afd21" 13194139534524 true] [17592186293097 1034 "2t^6+t^5" 13194139534524 true] [17592186293097 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293097 1111 #uuid "59e9c8d6-7ff2-5e42-9e17-de3f02113652" 13194139534524 true] [17592186293098 1034 "2t^6+t^5+3" 13194139534524 true] [17592186293098 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293098 1111 #uuid "ec5fd701-8fb5-5d48-a243-6eb8071712ea" 13194139534524 true] [17592186293099 1017 #edb/ref 17592186293100 13194139534524 true] [17592186293099 1089 "q-351053" 13194139534524 true] [17592186293099 1091 #edb/ref 17592186045465 13194139534524 true] [17592186293099 1100 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{ft/s}}^{2},$ given by the function $a(t)=8t+{e}^{t-2},$ where $t>0$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{ft/s}$) of the particle at time $t$ given that the particle has velocity $v=5\\,\\text{ft/s}$ when $t=2\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" 13194139534524 true] [17592186293099 1113 #uuid "8b60df2a-7490-5c0c-92f4-ec1ff2f92190" 13194139534524 true] [17592186293099 1145 "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (8t+{e}^{t-2})\\text{d}t \\\\  & =4{t}^{2}+{e}^{t-2}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=5.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}5 & =4({2}^{2})+{e}^{2-2}+C \\\\ 5 & =16+1+C \\\\ 5 & =17+C \\\\ C & =-12.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=4{t}^{2}+{e}^{t-2}-12.$" 13194139534524 true] [17592186293100 1000 #edb/ref 17592186293101 13194139534524 true] [17592186293100 1040 #edb/ref 17592186045449 13194139534524 true] [17592186293100 1041 "field-1" 13194139534524 true] [17592186293100 1104 #edb/ref 17592186293101 13194139534524 true] [17592186293100 1110 #uuid "d62b30db-ea6f-54d3-8460-2e4d020062b6" 13194139534524 true] [17592186293101 1034 "4t^2+e^{t-2}-12" 13194139534524 true] [17592186293101 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293101 1111 #uuid "1c9b7cb0-23e7-58fc-b747-f8d7abb9edf8" 13194139534524 true] [17592186293102 1017 #edb/ref 17592186293103 13194139534524 true] [17592186293102 1089 "q-351058" 13194139534524 true] [17592186293102 1091 #edb/ref 17592186045464 13194139534524 true] [17592186293102 1100 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=5{e}^{t},$ where $a(t)$ is measured in ${\\text{m/s}}^{2}$ and $t$ is measured in seconds. Find the speed of the particle at the moment $t=\\operatorname{ln}⁡2\\,\\text{s}$ given that the particle has velocity $v=\\frac{1}{2}\\,\\text{m/s}$ when $t=0\\,\\text{s}.$\n\nThe speed at the moment $t=\\operatorname{ln}⁡2\\,\\text{s}$ is\n{{field-1}} $\\,\\text{m/s}.$" 13194139534524 true] [17592186293102 1113 #uuid "842fcf81-235b-5826-abfd-5c8a902285e2" 13194139534524 true] [17592186293102 1145 "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int 5{e}^{t}\\,\\text{d}t \\\\  & =5{e}^{t}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=\\frac{1}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{2} & =5{e}^{0}+C \\\\ \\frac{1}{2} & =5+C \\\\ C & =-\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=5{e}^{t}-\\frac{9}{2}.$\n\nWe evaluate the velocity at time $t=\\operatorname{ln}⁡2\\,\\text{s}:$\n\n$$\n\\begin{aligned}v(\\operatorname{ln}⁡2) & =5{e}^{\\operatorname{ln}⁡2}-\\frac{9}{2} \\\\  & =5(2)-\\frac{9}{2} \\\\  & =\\frac{20}{2}-\\frac{9}{2} \\\\  & =\\frac{11}{2}\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $\\frac{11}{2}\\,\\text{m/s}.$" 13194139534524 true] [17592186293103 1000 #edb/ref 17592186293104 13194139534524 true] [17592186293103 1040 #edb/ref 17592186045449 13194139534524 true] [17592186293103 1041 "field-1" 13194139534524 true] [17592186293103 1104 #edb/ref 17592186293104 13194139534524 true] [17592186293103 1110 #uuid "139dc4dd-2b62-56d0-8df5-e7a62b035a69" 13194139534524 true] [17592186293104 1034 "\\frac{11}{2}" 13194139534524 true] [17592186293104 1103 #edb/ref 17592186045453 13194139534524 true] [17592186293104 1111 #uuid "e7f577e6-0388-59af-975d-ed57b6e34411" 13194139534524 true] [17592186293105 1017 #edb/ref 17592186293106 13194139534524 true] [17592186293105 10