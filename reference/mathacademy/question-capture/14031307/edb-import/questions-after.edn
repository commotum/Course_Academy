#{[{:db/id #edb/ref 17592186293088 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229f3361-a069-5d11-98b8-9e17ad6afed4" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,\\text{m/s}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "29570dd1-e291-57bc-8b6e-cf8465f5c412" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,\\text{m/s}" :db/id #edb/ref 17592186293091} {:answer/id #uuid "7c3fe598-d5a8-5880-a268-2f866d9a80bd" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,\\text{m/s}" :db/id #edb/ref 17592186293092} {:answer/id #uuid "2ed2a1ae-1b0e-53f8-9876-05b05d79c543" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{m/s}" :db/id #edb/ref 17592186293093} {:answer/id #uuid "1ee65b08-2504-5fd6-8f88-44b6feac33aa" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\text{m/s}" :db/id #edb/ref 17592186293094}] :answer-field/correct {:answer/id #uuid "29570dd1-e291-57bc-8b6e-cf8465f5c412" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,\\text{m/s}" :db/id #edb/ref 17592186293091} :answer-field/id #uuid "b0821bfa-2a7b-522d-af11-dd32a8ec57b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293089}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8100af6f-78fb-572b-8dbf-b54d6569a9aa" :question/math-academy-id "q-102694" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{m/s}}^{2},$ given by the function $a(t)=8-\\frac{3}{2}{t}^{2}$, where $t$ is the time in seconds. If the particle has velocity $v=-\\frac{5}{2}\\,\\text{m/s}$ when $t=0\\,\\text{s}$, calculate the speed of the particle at the moment $t=3\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (8-\\frac{3}{2}{t}^{2})\\text{d}t \\\\  & =8t-\\frac{1}{2}{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=-\\frac{5}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-\\frac{5}{2} & =8(0)-\\frac{1}{2}(0)^{3}+C \\\\ -\\frac{5}{2} & =0+C \\\\ C & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=8t-\\frac{1}{2}{t}^{3}-\\frac{5}{2}.$\n\nWe evaluate the velocity at time $t=3\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(3) & =8(3)-\\frac{1}{2}(3)^{3}-\\frac{5}{2} \\\\  & =24-\\frac{27}{2}-\\frac{5}{2} \\\\  & =24-16 \\\\  & =8\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $8\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186293095 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59e9c8d6-7ff2-5e42-9e17-de3f02113652" :answer/type {:db/ident :answer.type/math} :answer/value "2t^6+t^5" :db/id #edb/ref 17592186293097} {:answer/id #uuid "ec5fd701-8fb5-5d48-a243-6eb8071712ea" :answer/type {:db/ident :answer.type/math} :answer/value "2t^6+t^5+3" :db/id #edb/ref 17592186293098}] :answer-field/correct {:answer/id #uuid "ec5fd701-8fb5-5d48-a243-6eb8071712ea" :answer/type {:db/ident :answer.type/math} :answer/value "2t^6+t^5+3" :db/id #edb/ref 17592186293098} :answer-field/id #uuid "db3334eb-9035-531f-a680-f558d38afd21" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293096}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fd69d235-be6f-5d7e-afe1-9f5f4f1fa348" :question/math-academy-id "q-346883" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=12{t}^{5}+5{t}^{4},$ where $t$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=6\\,\\text{m/s}$ when $t=1\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (12{t}^{5}+5{t}^{4})\\text{d}t \\\\  & =2{t}^{6}+{t}^{5}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=6.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}6 & =2({1}^{6})+{1}^{5}+C \\\\ 6 & =3+C \\\\ C & =3.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=2{t}^{6}+{t}^{5}+3.$"}] [{:db/id #edb/ref 17592186293099 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9b7cb0-23e7-58fc-b747-f8d7abb9edf8" :answer/type {:db/ident :answer.type/math} :answer/value "4t^2+e^{t-2}-12" :db/id #edb/ref 17592186293101}] :answer-field/correct {:answer/id #uuid "1c9b7cb0-23e7-58fc-b747-f8d7abb9edf8" :answer/type {:db/ident :answer.type/math} :answer/value "4t^2+e^{t-2}-12" :db/id #edb/ref 17592186293101} :answer-field/id #uuid "d62b30db-ea6f-54d3-8460-2e4d020062b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293100}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8b60df2a-7490-5c0c-92f4-ec1ff2f92190" :question/math-academy-id "q-351053" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{ft/s}}^{2},$ given by the function $a(t)=8t+{e}^{t-2},$ where $t>0$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{ft/s}$) of the particle at time $t$ given that the particle has velocity $v=5\\,\\text{ft/s}$ when $t=2\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (8t+{e}^{t-2})\\text{d}t \\\\  & =4{t}^{2}+{e}^{t-2}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=5.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}5 & =4({2}^{2})+{e}^{2-2}+C \\\\ 5 & =16+1+C \\\\ 5 & =17+C \\\\ C & =-12.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=4{t}^{2}+{e}^{t-2}-12.$"}] [{:db/id #edb/ref 17592186293102 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7f577e6-0388-59af-975d-ed57b6e34411" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186293104}] :answer-field/correct {:answer/id #uuid "e7f577e6-0388-59af-975d-ed57b6e34411" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186293104} :answer-field/id #uuid "139dc4dd-2b62-56d0-8df5-e7a62b035a69" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293103}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "842fcf81-235b-5826-abfd-5c8a902285e2" :question/math-academy-id "q-351058" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=5{e}^{t},$ where $a(t)$ is measured in ${\\text{m/s}}^{2}$ and $t$ is measured in seconds. Find the speed of the particle at the moment $t=\\operatorname{ln}⁡2\\,\\text{s}$ given that the particle has velocity $v=\\frac{1}{2}\\,\\text{m/s}$ when $t=0\\,\\text{s}.$\n\nThe speed at the moment $t=\\operatorname{ln}⁡2\\,\\text{s}$ is\n{{field-1}} $\\,\\text{m/s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int 5{e}^{t}\\,\\text{d}t \\\\  & =5{e}^{t}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=\\frac{1}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{2} & =5{e}^{0}+C \\\\ \\frac{1}{2} & =5+C \\\\ C & =-\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=5{e}^{t}-\\frac{9}{2}.$\n\nWe evaluate the velocity at time $t=\\operatorname{ln}⁡2\\,\\text{s}:$\n\n$$\n\\begin{aligned}v(\\operatorname{ln}⁡2) & =5{e}^{\\operatorname{ln}⁡2}-\\frac{9}{2} \\\\  & =5(2)-\\frac{9}{2} \\\\  & =\\frac{20}{2}-\\frac{9}{2} \\\\  & =\\frac{11}{2}\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $\\frac{11}{2}\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186293105 :knowledge-point/_questions [{:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Not a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed809a03-4572-515e-a90a-253c954a3b55" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2}{2+t}+1" :db/id #edb/ref 17592186293107} {:answer/id #uuid "21ba67ca-ede3-5292-ae53-acc7f1eb5ae2" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{4}{2+t}" :db/id #edb/ref 17592186293108} {:answer/id #uuid "c16bfa56-c932-511c-b379-861a1a94b44b" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{16}{(2+t)^{3}}" :db/id #edb/ref 17592186293109} {:answer/id #uuid "98c4f535-b8b1-5e6f-ae36-b8c83bff1666" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{8}{(2+t)^{3}}+1" :db/id #edb/ref 17592186293110} {:answer/id #uuid "14b1b5ea-0033-53ff-a7d5-a8ed11ec266c" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{4}{2+t}+2" :db/id #edb/ref 17592186293111}] :answer-field/correct {:answer/id #uuid "21ba67ca-ede3-5292-ae53-acc7f1eb5ae2" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{4}{2+t}" :db/id #edb/ref 17592186293108} :answer-field/id #uuid "6fb486a1-ced8-5a1b-abb5-3b379effe262" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293106}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c9475821-fea2-5788-a17f-6ba5954989bf" :question/math-academy-id "q-81708" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=-\\frac{4}{(2+t)^{2}}$, where $t$ is the time in seconds. If the particle has velocity $v=2\\,\\text{m}/\\text{s}$ when $t=0\\,\\text{s}$, find the velocity (in $\\text{m}/\\text{s}$) of the particle at time $t.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (-\\frac{4}{(2+t)^{2}})\\,\\text{d}t \\\\  & =\\frac{4}{2+t}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}2 & =\\frac{4}{2+0}+C \\\\ 2 & =2+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{4}{2+t}.$"}]}
