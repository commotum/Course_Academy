60af" "q-36915/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-36915/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-36915/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-36915" :question/id #uuid "20c4225d-0d81-5ff8-857a-87c9bd75e2a6" :question/math-academy-id "q-36915" :question/problem "If $C={♣,♠,♡,♢,△,♣}$, then $|C|=$" :question/worked-solution "The cardinality of a finite set $C$ is the number of elements in $C.$ \n\nLet's start by listing all the elements of $C:$\n\n$$\n♣,\\,♠,\\,♡,\\,♢,\\,△\n$$\n\nNote that only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\nSince $C$ has $5$ elements, its cardinality is $|C|=5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-36915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb35fcff-d9f0-5ae8-999e-7e8bbc0b0919"] :knowledge-point/questions ["q-36915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181547/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "ff512eba-85e2-54cd-b236-cd8c6e78d355" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-181547/field-1" :answer-field/id #uuid "2d84293b-f344-5cf0-a3be-552d58049f5c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-181547/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-181547/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-181547" :question/id #uuid "e785a181-80ef-535b-a367-3a898de69e5f" :question/math-academy-id "q-181547" :question/problem "If $S={\\sqrt{2},\\sqrt{3},\\sqrt{5},\\sqrt{7}},$ then $|S|=${{field-1}}." :question/worked-solution "The cardinality of a finite set $S$ is the number of elements in $S.$ \n\nLet's start by listing all the elements of $S:$\n\n$$\n\\sqrt{2},\\,\\sqrt{3},\\,\\sqrt{5},\\,\\sqrt{7}\n$$\n\nSince $S$ has $4$ elements, its cardinality is $|S|=\\text{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181547/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb35fcff-d9f0-5ae8-999e-7e8bbc0b0919"] :knowledge-point/questions ["q-181547"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104909/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "2415f99e-36da-5d48-b827-1552fa824b49" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-104909/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "918ad9f9-0faa-5451-afc7-8e7a7e9e50ac" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-104909/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e11f4791-3601-54d1-bccb-d17740111803" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-104909/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "dcaf430a-d5d4-52cf-aa5e-fc88abd79d15" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-104909/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "a9e6ae55-9290-5fcd-97a6-4acf79896790" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-104909/selection" :answer-field/id #uuid "08fb8054-9f79-5c57-9a3a-3493eb6ef4a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104909/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-104909/selection/7845f5bf94d2cfe99f73682a3452