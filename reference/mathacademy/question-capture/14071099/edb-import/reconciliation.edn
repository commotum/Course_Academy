1e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181573" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181573" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2609"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181582" "field" nil "attribute" "question/problem" "value" "If $A={1,6,36,216,…,2\\,176\\,782\\,336},$ then $|A|=${{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181582" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,6,\\,36,\\,216,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=6:$\n\n$$\n\\begin{aligned}r & =6 \\\\  & =\\frac{6}{1} \\\\  & =\\frac{36}{6} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=1\\cdot {6}^{n-1}={6}^{n-1}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA={{6}^{n-1}:n\\in N,\\,1\\le n\\le N}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}{6}^{N-1} & =2\\,176\\,782\\,336 \\\\ N-1 & ={log}_{6}⁡(2\\,176\\,782\\,336) \\\\ N-1 & =\\frac{{log}_{10}⁡(2\\,176\\,782\\,336)}{{log}_{10}⁡(6)} \\\\ N-1 & =12 \\\\ N & =13\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA={{6}^{n-1}:n\\in N,\\,1\\le n\\le 13}.\n$$\n\nFinally, since $A$ has $13$ elements, we must have $|A|=13.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181582" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/activity-metadata.json" "file_sha256" "3144a4334782a62050a0811e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181582" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181582" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "13"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181454" "field" nil "attribute" "question/problem" "value" "If $A={3,6,12,24,48,…,98\\,304},$ then $|A|=${{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181454" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n3,\\,6,\\,12,\\,24,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{6}{3} \\\\  & =\\frac{12}{6} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=3({2}^{n-1})=\\frac{3}{2}(2)^{n}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA={\\frac{3}{2}(2)^{n}:n\\in N,\\,1\\le n\\le N}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{3}{2}(2)^{N} & =98\\,304 \\\\ {2}^{N} & =65\\,536 \\\\ N & ={log}_{2}⁡(65\\,536) \\\\ N & =\\frac{{log}_{10}⁡(65\\,536)}{{log}_{10}⁡(2)} \\\\ N & =16\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA={\\frac{3}{2}(2)^{n}:n\\in N,\\,1\\le n\\le 16}.\n$$\n\nFinally, since $A$ has $16$ elements, we must have $|A|=16.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181454" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/activity-metadata.json" "file_sha256" "3144a4334782a62050a0811e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181454" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181454" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "16"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181583" "field" nil "attribute" "question/problem" "value" "If $A={1,11,121,1\\,331,…,214\\,358\\,881},$ then $|A|=${{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181583" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,11,\\,121,\\,1\\,331,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=11:$\n\n$$\n\\begin{aligned}r & =11 \\\\  & =\\frac{11}{1} \\\\  & =\\frac{121}{11} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=1\\cdot {11}^{n-1}={11}^{n-1}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA={{11}^{n-1}:n\\in N,\\,1\\le n\\le N}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}{11}^{N-1} & =214\\,358\\,881 \\\\ N-1 & ={log}_{11}⁡(214\\,358\\,881) \\\\ N-1 & =\\frac{{log}_{10}⁡(214\\,358\\,881)}{{log}_{10}⁡(11)} \\\\ N-1 & =8 \\\\ N & =9\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA={{11}^{n-1}:n\\in N,\\,1\\le n\\le 9}.\n$$\n\nFinally, since $A$ has $9$ elements, we must have $|A|=9.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181583" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/activity-metadata.json" "file_sha256" "3144a4334782a62050a0811e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181583" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181583" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181576" "field" nil "attribute" "question/problem" "value" "If $A={2,10,50,250,…,2\\,441\\,406\\,250},$ then $|A|=${{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181576" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n2,\\,10,\\,50,\\,250,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=5:$\n\n$$\n\\begin{aligned}r & =5 \\\\  & =\\frac{10}{2} \\\\  & =\\frac{50}{10} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=2({5}^{n-1})=\\frac{2}{5}(5)^{n}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA={\\frac{2}{5}(5)^{n}:n\\in N,\\,1\\le n\\le N}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{2}{5}(5)^{N} & =2\\,441\\,406\\,250 \\\\ {5}^{N} & =6\\,103\\,515\\,625 \\\\ N & ={log}_{5}⁡(6\\,103\\,515\\,625) \\\\ N & =\\frac{{log}_{10}⁡(6\\,103\\,515\\,625)}{{log}_{10}⁡(5)} \\\\ N & =14\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA={\\frac{2}{5}(5)^{n}:n\\in N,\\,1\\le n\\le 14}.\n$$\n\nFinally, since $A$ has $14$ elements, we must have $|A|=14.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181576" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/activity-metadata.json" "file_sha256" "3144a4334782a62050a0811e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181576" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181576" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "14"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181584" "field" nil "attribute" "question/problem" "value" "If $A={1,9,81,729,…,3\\,486\\,784\\,401},$ then $|A|=${{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181584" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n1,\\,9,\\,81,\\,729,\\,…\n$$\n\nform a geometric sequence with a common ratio $r=9:$\n\n$$\n\\begin{aligned}r & =9 \\\\  & =\\frac{9}{1} \\\\  & =\\frac{81}{9} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted ${a}_{n},$ is given by\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}=1\\cdot {9}^{n-1}={9}^{n-1}.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA={{9}^{n-1}:n\\in N,\\,1\\le n\\le N}\n$$\n\nwhere $N\\in N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}{9}^{N-1} & =3\\,486\\,784\\,401 \\\\ N-1 & ={log}_{9}⁡(3\\,486\\,784\\,401) \\\\ N-1 & =\\frac{{log}_{10}⁡(3\\,486\\,784\\,401)}{{log}_{10}⁡(9)} \\\\ N-1 & =10 \\\\ N & =11\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA={{9}^{n-1}:n\\in N,\\,1\\le n\\le 11}.\n$$\n\nFinally, since $A$ has $11$ elements, we must have $|A|=11.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181584" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/activity-metadata.json" "file_sha256" "3144a4334782a62050a0811e21313a4a537bc521b0680b93202a42b6753a09db"} {"question" "q-181584" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "q-181584" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "11"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/state.json" "file_sha256" "33ddcc82728c8b73f06200b96a9cc05ffaa6bf3c13b298466e1bca5d2a7fa3f3"} {"question" "e-13148" "field" nil "attribute" "question/problem" "value" "If $A = \\{1, 1, 2,1, 3,3\\}$, then what is $\\left|A\\right|?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13148.json" "file_sha256" "db15d316b5d99ea054d84ec03c4dfa850149dddedfa3fce3fe461cffd1ffb8f2"} {"question" "e-13148" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nLet's start by listing all the elements of $A{:}$\n\n$$\n1,\\qquad 2, \\qquad 3\n$$\n\nNote that only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\nSince $A$ has $3$ elements, its cardinality is $|A| = 3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13148.json" "file_sha256" "db15d316b5d99ea054d84ec03c4dfa850149dddedfa3fce3fe461cffd1ffb8f2"} {"question" "e-13149" "field" nil "attribute" "question/problem" "value" "What is the cardinal number of $X = \\{ a, \\emptyset, \\{\\emptyset\\}, \\{\\{\\emptyset\\}\\}, b \\}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13149.json" "file_sha256" "6237a969d792b210a90aa8b66d69f40c9cc2c4a819cb60f50e3131a7e558e9e7"} {"question" "e-13149" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $X$ is the number of elements in $X.$ \n\nLet's start by listing all the elements of $X{:}$\n\n$$\na, \\qquad \\emptyset, \\qquad \\{\\emptyset\\}, \\qquad \\{\\{\\emptyset\\}\\}, \\qquad b\n$$\n\nNote the following:\n\n- Only *unique* elements are counted. In other words, duplicate elements are *not* counted separately.\n\n- $\\emptyset, \\{\\emptyset\\}$ and $\\{\\{\\emptyset\\}\\}$ each count as single, distinct elements of $X.$\n\nSince $X$ has $5$ elements, the cardinality is $|X| = 5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13149.json" "file_sha256" "6237a969d792b210a90aa8b66d69f40c9cc2c4a819cb60f50e3131a7e558e9e7"} {"question" "e-13169" "field" nil "attribute" "question/problem" "value" "If $A = \\{10, 19, 28,\\ldots,865\\},$ then what is $|A|?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13169.json" "file_sha256" "52b3468a617d00c8e4b331fb632473daadd561fed5d093aef3956b936116155c"} {"question" "e-13169" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n10, \\quad 19, \\quad 28,\\quad \\ldots\n$$\n\nform an arithmetic sequence with a common difference $d=9{:}$\n\n$$\n\\begin{aligned}d & =9 \\\\  & =19-10 \\\\  & =28-19 \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our arithmetic sequence, denoted $a_n,$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & =10+(n-1)\\cdot 9 \\\\  & =10+9n-9 \\\\  & =9n+1.\\end{aligned}\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\n\\begin{aligned}A & ={9n+1:n\\in N,\\,1\\le n\\le N}\\end{aligned}\n$$\n\nwhere $N\\in \\mathbb N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}9N+1 & =865 \\\\ 9N & =864 \\\\ N & =\\frac{864}{9} \\\\ N & =96\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA = \\left\\{9n+1: n\\in \\mathbb N,\\: 1\\leq n \\leq 96  \\right\\}.\n$$\n\nFinally, since $A$ has $96$ elements, we must have $|A| = 96.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13169.json" "file_sha256" "52b3468a617d00c8e4b331fb632473daadd561fed5d093aef3956b936116155c"} {"question" "e-13172" "field" nil "attribute" "question/problem" "value" "If $A = \\{3, 21, 147,1\\,029,\\ldots,5\\,931\\,980\\,229\\},$ then what is $|A|?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13172.json" "file_sha256" "4a4f94b54a98d217a2380f811c1fee63b81530ed760efbde746de3a1d7082ee0"} {"question" "e-13172" "field" nil "attribute" "question/worked-solution" "value" "The cardinality of a finite set $A$ is the number of elements in $A.$ \n\nNotice that the elements of our set \n\n$$\n3, \\quad 21, \\quad 147, \\quad 1\\,029,\\quad \\ldots\n$$\n\nform a geometric sequence with a common ratio $r=7{:}$\n\n$$\n\\begin{aligned}r & =7 \\\\  & =\\frac{21}{3} \\\\  & =\\frac{147}{21} \\\\  & =⋯\\end{aligned}\n$$\n\nThe $n$th term of our geometric sequence, denoted $a_n,$ is given by\n\n$$\na_n = a_1 r^{n-1} = 3(7^{n-1}) = \\dfrac37(7)^n.\n$$\n\nTherefore, we can express $A$ in set-builder notation as follows:\n\n$$\nA = \\left\\{\\dfrac37(7)^n : n\\in \\mathbb N,\\: 1\\leq n \\leq N \\right\\}\n$$\n\nwhere $N\\in \\mathbb N$ is to be determined.\n\nTo find $N,$ we solve the following equation:\n\n$$\n\\begin{aligned}\\frac{3}{7}(7)^{N} & =5\\,931\\,980\\,229 \\\\ {7}^{N} & =13\\,841\\,287\\,201 \\\\ N & ={log}_{7}⁡(13\\,841\\,287\\,201) \\\\ N & =\\frac{{log}_{10}⁡(13\\,841\\,287\\,201)}{{log}_{10}⁡(7)} \\\\ N & =12\\end{aligned}\n$$\n\nTherefore, our set $A$ can be expressed as\n\n$$\nA = \\left\\{\\dfrac37(7)^n : n\\in \\mathbb N,\\: 1\\leq n \\leq 12\\right\\}.\n$$\n\nFinally, since $A$ has $12$ elements, we must have $|A| = 12.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071099/example-13172.json" "file_sha256" "4a4f94b54a98d217a2380f811c1fee63b81530ed760efbde746de3a1d7082ee0"}] "usage" {"e-13149" [] "e-13148" [] "q-80737" [] "q-181553" [] "q-181563" [] "q-181576" [] "q-181551" [] "e-13169" [] "q-181583" [] "e-13172" [] "q-181587" [] "q-181454" [] "q-181582" [] "q-181557" [] "q-104887" [] "q-181559" []} "basis" 2537 "retr