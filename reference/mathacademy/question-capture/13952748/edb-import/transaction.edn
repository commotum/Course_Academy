4"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276511/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "8ab00f58-7043-56bc-80b9-e4b46201457c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-276511/field-1" :answer-field/id #uuid "c679c82c-67f7-5dc4-8bf8-24e4e95d39aa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276511/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-276511/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-276511/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "81de9715-bf88-552b-8e04-4b22a43e1750" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-276511/field-2" :answer-field/id #uuid "c5954563-d1e1-57ff-ab0d-d5df53561cff" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276511/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-276511/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-276511" :question/id #uuid "7173cc2a-4622-5226-b8ea-06c0c7668125" :question/math-academy-id "q-276511" :question/problem "If the point $P$ has polar coordinates $(2,\\frac{\\pi }{2}),$ then its Cartesian coordinates are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =2\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ x & =2\\cdot 0 \\\\ x & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ y & =2\\cdot 1 \\\\ y & =2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(0,2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-276511/field-1" "q-276511/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c"] :knowledge-point/questions ["q-276511"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120311/selection/728e57b7963430d3c20cef3b86b5fa5df5f16fa2eaa9648e82885f0099a47019" :answer/id #uuid "c6fbc8ef-f30c-5f1e-b016-24b45c931a18" :answer/type :answer.type/math :answer/value "(-2,-\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-120311/selection/9f75d7617086506a75f8a57a076deb29ae1e77a0d14780b7129f8ab0ffd274f2" :answer/id #uuid "2c07b934-6c82-5ff9-8e4e-c582f03b2d7b" :answer/type :answer.type/math :answer/value "(2\\sqrt{2},-2)" :db/ensure [:answer/validate]} {:db/id "q-120311/selection/99c83a1316f3e0533d816323ed5760ec011727197cb9ebb42f65d5d1bd10da9a" :answer/id #uuid "572c37de-c6e1-5111-ae49-cd7109e007da" :answer/type :answer.type/math :answer/value "(-2\\sqrt{2},-2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-120311/selection/d557150d4e6cef6fcffba6c9cf7e5a4ffaa99d118b70a22a6eab14a30b85a690" :answer/id #uuid "8fa31c6e-d533-5d17-8e4e-2327ffacc325" :answer/type :answer.type/math :answer/value "(2\\sqrt{2},-1)" :db/ensure [:answer/validate]} {:db/id "q-120311/selection/e8b6e48d2640b190477b067d73ed38c8ae23d6a2118701d65bc1f8aac439d661" :answer/id #uuid "ea306d4e-4767-5838-a873-081559cb2fc9" :answer/type :answer.type/math :answer/value "(-2,2)" :db/ensure [:answer/validate]} {:db/id "q-120311/selection" :answer-field/id #uuid "f37d886e-a3db-54ed-8136-8135816a8801" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120311/selection/99c83a1316f3e0533d816323ed5760ec011727197cb9ebb42f65d5d1bd10da9a" :answer-field/choices ["q-120311/selection/728e57b7963430d3c20cef3b86b5fa5df5f16fa2eaa9648e82885f0099a47019" "q-120311/selection/9f75d7617086506a75f8a57a076deb29ae1e77a0d14780b7129f8ab0ffd274f2" "q-120311/selection/99c83a1316f3e0533d816323ed5760ec011727197cb9ebb42f65d5d1bd10da9a" "q-120311/selection/d557150d4e6cef6fcffba6c9cf7e5a4ffaa99d118b70a22a6eab14a30b85a690" "q-120311/selection/e8b6e48d2640b190477b067d73ed38c8ae23d6a2118701d65bc1f8aac439d661"] :db/ensure [:answer-field/validate]} {:db/id "q-120311" :question/id #uuid "193e517a-c8a3-5593-924d-bbd3ab8f46f4" :question/math-academy-id "q-120311" :question/problem "The point $P$ has polar coordinates $(4,{225}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2\\sqrt{2},-2\\sqrt{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120311/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c"] :knowledge-point/questions ["q-120311"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276514/field-1/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" :answer/id #uuid "513f9504-104a-5018-8c1d-c98f3d06af66" :answer/type :answer.type/math :answer/value "-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-276514/field-1" :answer-field/id #uuid "62f3ef7f-4ab7-5d1d-ac29-6188319c61aa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276514/field-1/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" :answer-field/choices ["q-276514/field-1/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f"] :db/ensure [:answer-field/validate]} {:db/id "q-276514/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "ba7b8f20-40d3-516b-817b-109a1d5dd0c1" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-276514/field-2" :answer-field/id #uuid "c7a0da30-89e1-5087-a3c4-9e7fa7d7ee6a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276514/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-276514/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-276514" :question/id #uuid "399dff58-5640-5b52-a04e-25f3ce63a28c" :question/math-academy-id "q-276514" :question/problem "If the point $P$ has polar coordinates $(4,\\frac{7\\pi }{6}),$ then its Cartesian coordinates are\n\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =4\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-2\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =4\\cdot -\\frac{1}{2} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2\\sqrt{3},-2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-276514/field-1" "q-276514/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c"] :knowledge-point/questions ["q-276514"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276786/field-1/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" :answer/id #uuid "3b3acb1a-ab0a-5b22-9b41-323026d642fb" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-276786/field-1" :answer-field/id #uuid "8a0f9566-5e77-5620-9dd0-3bfc1a02b3de" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276786/field-1/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" :answer-field/choices ["q-276786/field-1/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e"] :db/ensure [:answer-field/validate]} {:db/id "q-276786/field-2/b5348ddf71e5472e38f3abfd1fd508b6086b48d4f20aefdbfcdf24c25a3eb0ab" :answer/id #uuid "7ac96947-efdd-550e-a44e-41f65188f306" :answer/type :answer.type/math :answer/value "-4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-276786/field-2" :answer-field/id #uuid "a5443125-7f8c-5e98-af18-c55fd5aeeb59" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276786/field-2/b5348ddf71e5472e38f3abfd1fd508b6086b48d4f20aefdbfcdf24c25a3eb0ab" :answer-field/choices ["q-276786/field-2/b5348ddf71e5472e38f3abfd1fd508b6086b48d4f20aefdbfcdf24c25a3eb0ab"] :db/ensure [:answer-field/validate]} {:db/id "q-276786" :question/id #uuid "67dc0f42-e4f5-5bc1-9f03-440fc8535835" :question/math-academy-id "q-276786" :question/problem "If the distance from a point $P$ to the origin is $8,$ and that $P$ makes an angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=8,\\,\\theta =\\frac{7\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\cdot \\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\cdot \\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(4\\sqrt{2},-4\\sqrt{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-276786/field-1" "q-276786/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-276786"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17137/selection/ad9347cb1f1504b5ae7304f546d0c15711f724df1661d66bf9fff491cb91faaa" :answer/id #uuid "7c068f4a-dc0a-5730-86d0-3692048e016a" :answer/type :answer.type/math :answer/value "(-7,0)" :db/ensure [:answer/validate]} {:db/id "q-17137/selection/ff992f3bfbf9256bb8a93ba4418b1d3fc4bf7775122685039de83403d09a1dca" :answer/id #uuid "d3f90cec-568b-5b2d-b613-75c5be456eec" :answer/type :answer.type/math :answer/value "(1,0)" :db/ensure [:answer/validate]} {:db/id "q-17137/selection/f2d3c1a7d39629bea356a024a828af9cb6c2c4f43d4ffe2776f9b7b220c6297b" :answer/id #uuid "c8e0378a-9576-5e7d-a4a5-8dc51f7f479b" :answer/type :answer.type/math :answer/value "(7,0)" :db/ensure [:answer/validate]} {:db/id "q-17137/selection/cb584b5a26ec18b706f0fa60126da68f2cd9503b65f8959765f6ed9ba8e172ff" :answer/id #uuid "7a9bd102-bd8c-5cad-bac3-03bf3c1fdf07" :answer/type