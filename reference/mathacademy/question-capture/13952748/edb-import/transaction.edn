[{:db/id "q-8519/selection/060e11a7c22b93f22ff715910900f666c2182399b76a2f011ac5c1dc0a478f72" :answer/id #uuid "dd8a5005-c0ae-5ac5-8e59-40bd6284e726" :answer/type :answer.type/math :answer/value "(-3,-\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "q-8519/selection/c794bd91fafb22a9d44d418b426dc48e1f5ff8baeb0fa9196ef9f62ad2b94178" :answer/id #uuid "aab39890-41b2-55fe-8e41-de736216ccc9" :answer/type :answer.type/math :answer/value "(3\\sqrt{2},-3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-8519/selection/8514ae74089b6a5896b30ec2f47e9458c2e0564e18dcfd19cc2be70d8a1f7893" :answer/id #uuid "137986cd-bae7-5166-8185-7c24c15f3bbe" :answer/type :answer.type/math :answer/value "(3\\sqrt{2},3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-8519/selection/6fee32b6593f2eb94136eab757cd0ff4bbb8d3e2bf536adb3fbaed4c19cb1d23" :answer/id #uuid "ebf88997-6b46-5779-8627-ffb5f21c0dfe" :answer/type :answer.type/math :answer/value "(-\\frac{3}{2},-3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-8519/selection/6bbec5a5d2478c2cc4a0215b7a096bca82136247c3c40b95f922a01206e71e25" :answer/id #uuid "bd74836d-bdad-5231-8960-30d3bd87b611" :answer/type :answer.type/math :answer/value "(-3\\sqrt{2},-3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-8519/selection" :answer-field/id #uuid "774a89f7-9ae3-5415-b7d7-7ec8885d5975" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8519/selection/8514ae74089b6a5896b30ec2f47e9458c2e0564e18dcfd19cc2be70d8a1f7893" :answer-field/choices ["q-8519/selection/060e11a7c22b93f22ff715910900f666c2182399b76a2f011ac5c1dc0a478f72" "q-8519/selection/c794bd91fafb22a9d44d418b426dc48e1f5ff8baeb0fa9196ef9f62ad2b94178" "q-8519/selection/8514ae74089b6a5896b30ec2f47e9458c2e0564e18dcfd19cc2be70d8a1f7893" "q-8519/selection/6fee32b6593f2eb94136eab757cd0ff4bbb8d3e2bf536adb3fbaed4c19cb1d23" "q-8519/selection/6bbec5a5d2478c2cc4a0215b7a096bca82136247c3c40b95f922a01206e71e25"] :db/ensure [:answer-field/validate]} {:db/id "q-8519" :question/id #uuid "3fb5ea40-ef50-5f62-83b4-93e5913563b4" :question/math-academy-id "q-8519" :question/problem "The point $P$ has polar coordinates $(6,{45}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate od $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =6\\operatorname{cos}⁡({45}^{∘}) \\\\ x & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ x & =3\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =6\\operatorname{sin}⁡({45}^{∘}) \\\\ y & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ y & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(3\\sqrt{2},3\\sqrt{2}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8519/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c"] :knowledge-point/questions ["q-8519"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276774/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b87b8898-51e4-55fa-a207-af5edaeef5b7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-276774/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "74fb2b27-8e0d-587e-8652-fc2487b4351c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-276774/field-1" :answer-field/id #uuid "677642e6-f9ff-5920-9c88-c5d451e69e87" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276774/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-276774/field-1/ad06fa8bb7e77edd4098e00237