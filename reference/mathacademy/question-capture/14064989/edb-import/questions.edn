-52de-91bc-9af61b9158cb" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186326265} {:answer/id #uuid "924594b4-d799-5e7c-a60f-20c7a2a4171f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186326266} {:answer/id #uuid "fe4794d1-6bd6-5787-9028-04a689758f60" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186326267} {:answer/id #uuid "fde2a93d-c6f0-5365-b631-52802265652a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186326268} {:answer/id #uuid "fc37606b-7354-5384-9aca-4d36dd8a52f9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186326269}] :answer-field/correct {:answer/id #uuid "924594b4-d799-5e7c-a60f-20c7a2a4171f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186326266} :answer-field/id #uuid "fadd03e5-8730-58cb-8eaa-be2b9f7fc337" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326264}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9ec9156e-6a13-5769-a47f-7384d9da375e" :question/math-academy-id "q-75662" :question/problem "Given that $A,B,$ and $C$ are $7\\times 7$ matrices, which of the following statements are always true?\n\n- $A(B+C)=AC+AB$\n- $A(BC)=(BA)C$\n- $AB=BA$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is distributive, so \n\n$$\nA(B+C)=AB+AC=AC+AB\n$$\n\n since matrix addition is commutative.\n\n- Statement II is false. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general. However, since matrix multiplication is not commutative, we have\n\n$$\n\\begin{aligned}A(BC)=(AB)C\\ne (BA)C.\\end{aligned}\n$$\n\n- Statement III is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\nTherefore, only statement I is true."}]}
