[{:db/id "q-14432/selection/874554f20d4a27fcf40f31003ef17c86c7dffc5893adde051a6037dfbf851378" :answer/id #uuid "b6a3cdc3-89a3-56cd-8306-b29ea372c374" :answer/type :answer.type/math :answer/value "\\frac{4{g}^{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-14432/selection/9d470ea9e6f2edb0655a8aff0290acadd56ef5c7ef9c9ba3be4685027b0ea146" :answer/id #uuid "88dde628-02bf-5a93-b478-e0e0085e04a2" :answer/type :answer.type/math :answer/value "\\frac{6}{g}" :db/ensure [:answer/validate]} {:db/id "q-14432/selection/4afff9374d6ff8f81db965680aa1f7308b865eb3dd582e8876b90eece58f03b9" :answer/id #uuid "4b40eec7-3fcc-5c08-b260-edea6a6b44ba" :answer/type :answer.type/math :answer/value "\\frac{5}{2g}" :db/ensure [:answer/validate]} {:db/id "q-14432/selection/06d39a24d1231bf887d85cfb78863738aa996f02f5f89211e31cdeeed7bf0225" :answer/id #uuid "00271db1-ce5d-5870-8ecf-b3d687ff0c03" :answer/type :answer.type/math :answer/value "\\frac{4g}{15}" :db/ensure [:answer/validate]} {:db/id "q-14432/selection/c9b5c564f482a2a0b2ba26fe8b7a504865273b90ab76c23716a6bce3410a55f0" :answer/id #uuid "d12cb98d-88b6-589d-8446-4a8b8393d644" :answer/type :answer.type/math :answer/value "\\frac{8g}{3}" :db/ensure [:answer/validate]} {:db/id "q-14432/selection" :answer-field/id #uuid "ed517a1f-0582-5bc2-a1f9-34e84174f8be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14432/selection/c9b5c564f482a2a0b2ba26fe8b7a504865273b90ab76c23716a6bce3410a55f0" :answer-field/choices ["q-14432/selection/874554f20d4a27fcf40f31003ef17c86c7dffc5893adde051a6037dfbf851378" "q-14432/selection/9d470ea9e6f2edb0655a8aff0290acadd56ef5c7ef9c9ba3be4685027b0ea146" "q-14432/selection/4afff9374d6ff8f81db965680aa1f7308b865eb3dd582e8876b90eece58f03b9" "q-14432/selection/06d39a24d1231bf887d85cfb78863738aa996f02f5f89211e31cdeeed7bf0225" "q-14432/selection/c9b5c564f482a2a0b2ba26fe8b7a504865273b90ab76c23716a6bce3410a55f0"] :db/ensure [:answer-field/validate]} {:db/id "q-14432" :question/id #uuid "53d8f5ac-4e03-5656-9b30-96c599c40d3e" :question/math-academy-id "q-14432" :question/problem "$\\frac{4}{5g}÷\\frac{3}{10{g}^{2}}=$" :question/worked-solution "To compute\n\n$$\n\\frac{4}{5g}÷\\frac{3}{10{g}^{2}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4}{5g}÷\\frac{3}{10{g}^{2}} & = \\\\ \\frac{4}{5g}\\cdot \\frac{10{g}^{2}}{3} & = \\\\ \\frac{4}{\\cancel{5}\\cdot \\cancel{g}}\\cdot \\frac{\\cancel{5}\\cdot 2\\cdot {g}^{\\cancel{2}}}{3} & = \\\\ 4\\cdot \\frac{2g}{3} & = \\\\ \\frac{8g}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-14432/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f"] :knowledge-point/questions ["q-14432"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15459/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "a3271490-7360-5c33-8f48-b80e2a4eb53f" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-15459/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "9a8ec8fd-ce2d-5eb3-8db9-45c6f17be030" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-15459/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "b15bc5f6-b521-570b-977c-4ec6cb64f4ae" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-15459/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "4d474441-f83d-5751-960e-48d3a449323e" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-15459/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "be1edce8-9456-501a-beba-6ccc30f01c50" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-15459/selection" :answer-field/id #uuid "5eb7b41d-1ff5-5dcf-b3d4-1f415821afa2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15459/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer-field/choices ["q-15459/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-15459/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-15459/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-15459/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-15459/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-15459" :question/id #uuid "1c7ac090-4865-5789-a9b9-f3f3d9345ee3" :question/math-academy-id "q-15459" :question/problem "A circle in the Cartesian plane is given by the equation ${y}^{2}+2x+{x}^{2}=24y-120.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}+2x+{x}^{2} & =24y-120 \\\\ {x}^{2}+2x+{y}^{2}-24y & =-120 \\\\ ({x}^{2}+2x)+({y}^{2}-24y) & =-120 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 12y+{12}^{2}) & =-120+{1}^{2}+{12}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 12y+{12}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-12)^{2} & ={5}^{2} \\\\ (x-(-1))^{2}+(y-12)^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-1,b=12,r=5,$ and \n\n$$\na+b+r=-1+12+5=16.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15459/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11981/selection/c3a4ca471b327140be21765d529aacd4c97cee22458783966c8902cf72e66d97" :answer/id #uuid "d6d04f0e-ce33-560f-8d25-2455198c422e" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}1 & 1 \\\\ -2 & -1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11981/selection/dcbdc54305d9f36d6864fde9e55cdf32c0e460ba263119733c6acb205518cab0" :answer/id #uuid "b6629edf-3d57-548c-9714-d3922342714c" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}-1 & 2 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11981/selection/ecc5e0a13128d5c8c0bc3e996e81c51e216a0a3f7a125c4fdecfc2225f0db65c" :answer/id #uuid "8e6b3535-dc3e-5474-8344-c9298e897403" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}-1 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11981/selection/85add219653b37d623dafac367729330487162bf4367924fafd508d3eaa5f5a9" :answer/id #uuid "b435961a-37d4-5224-ba98-809edcd5fcfa" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}-1 & -1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11981/selection/fa06de82f0289971de8696355eafbfdf1bbcc6ee9476999f25088ff12121211f" :answer/id #uuid "24ddd589-010f-5889-9e7d-826aef99668e" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11981/selection" :answer-field/id #uuid "eef2c23a-5001-5982-b0f4-845efea30bc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11981/selection/ecc5e0a13128d5c8c0bc3e996e81c51e216a0a3f7a125c4fdecfc2225f0db65c" :answer-field/choices ["q-11981/selection/c3a4ca471b327140be21765d529aacd4c97cee22458783966c8902cf72e66d97" "q-11981/selection/dcbdc54305d9f36d6864fde9e55cdf32c0e460ba263119733c6acb205518cab0" "q-11981/selection/ecc5e0a13128d5c8c0bc3e996e81c51e216a0a3f7a125c4fdecfc2225f0db65c" "q-11981/selection/85add219653b37d623dafac367729330487162bf4367924fafd508d3eaa5f5a9" "q-11981/selection/fa06de82f0289971de8696355eafbfdf1bbcc6ee9476999f25088ff12121211f"] :db/ensure [:answer-field/validate]} {:db/id "q-11981" :question/id #uuid "e2ae4a2f-fd5f-5872-89b2-269b37fd8b57" :question/math-academy-id "q-11981" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}x-y=4 \\\\ 2x-y=5\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ 5\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot (-1)-(-1)\\cdot 2}[\\begin{aligned}-1 & 1 \\\\ -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}-1 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}4 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11981/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-11981"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121028/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" :answer/id #uuid "739b2b03-cec2-56b5-aa38-4ace4bc119c8" :answer/type :answer.type/math :answer/value "\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "q-121028/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "3a4d3a07-a231-521c-a426-1cd6cd9993d8" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-121028/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "1bd67f70-d6c2-5071-b7e4-83c5f5974917" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-121028/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" :answer/id #uuid "4b008d64-98cd-5cf1-970e-5ef9d2d8acba" :answer/type :answer.type/math :answer/value "\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "q-121028/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "84139496-dd2c-5b40-a558-029ab7fa76e6" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-121028/selection" :answer-field/id #uuid "efe4347c-0b67-51e7-a55f-d6c7fdd8f093" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121028/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" :answer-field/choices ["q-121028/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" "q-121028/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-121028/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-121028/selection/a272cbe64fea514fe5c8c9685aef2c9378fdfe44c54941c8bcba64a5f713bc84" "q-121028/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e"] :db/ensure [:answer-field/validate]} {:db/id "q-121028" :question/id #uuid "48581854-707a-55c3-820d-b972a1199e65" :question/math-academy-id "q-121028" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cos}⁡(2x)=\\frac{\\sqrt{2}}{2}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=\\frac{\\pi }{8}+n\\pi ,\\,x=a\\pi +n\\pi ,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{4}+2\\pi n, & \\, & \\, & 2x=\\frac{7\\pi }{4}+2\\pi n.\\end{aligned}\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{4}+2\\pi n, & \\, & \\, & 2x=\\frac{7\\pi }{4}+2\\pi n \\\\ x & =\\frac{\\pi }{8}+n\\pi , & \\, & \\, & x=\\frac{7\\pi }{8}+n\\pi \\end{aligned}\n$$\n\nTherefore, $a=\\frac{7}{8}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121028/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a180dc90-c6b9-577e-9eef-ed60ecafe4e5"] :knowledge-point/questions ["q-121028"] :db/ensure [:knowledge-point/validate]} {:db/id "q-90056/selection/ba622ca8e71aa325015feffb16a4f2e2e8909d3c8b462d627c47cd2a905b3985" :answer/id #uuid "b8ffc9fd-e1dd-5559-bfe8-c77d3a0de026" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+3y\\ge 6 \\\\ y\\ge 2-x\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-90056/selection/ab4bdb0602dbbf5586fb122e06a909fae3664b2e67b2314509aa1d15673e7b2f" :answer/id #uuid "116db77a-0c72-5c7e-828f-bdddfced3d20" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+3y\\le 6 \\\\ y\\le 2-x\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-90056/selection/1e6061c586f19bea4fd77dd875ec1722f9458ffc69bc2b4136b046ed1e06772d" :answer/id #uuid "c84b3697-9ac6-510f-84f5-e6d0f172fa74" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+3y<6 \\\\ y>2-x\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-90056/selection/e2436da591f2098d1276fb1c1f68df5e982f32e7c3bc2e53bc1c561fe9b84465" :answer/id #uuid "4058b86a-60d4-5fb5-a126-6e52a54f592b" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+3y\\ge 6 \\\\ y\\le 2-x\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-90056/selection/ad37543267649f3ae96ff163c186e2a3283cd4448086170e6f0d37e0d9529513" :answer/id #uuid "e5e0db47-0c4d-559a-bb85-82354afa7bc9" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+3y\\le 6 \\\\ y\\ge 2-x\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-90056/selection" :answer-field/id #uuid "f54292a5-bfce-5666-9990-c08fe65c74db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-90056/selection/ab4bdb0602dbbf5586fb122e06a909fae3664b2e67b2314509aa1d15673e7b2f" :answer-field/choices ["q-90056/selection/ba622ca8e71aa325015feffb16a4f2e2e8909d3c8b462d627c47cd2a905b3985" "q-90056/selection/ab4bdb0602dbbf5586fb122e06a909fae3664b2e67b2314509aa1d15673e7b2f" "q-90056/selection/1e6061c586f19bea4fd77dd875ec1722f9458ffc69bc2b4136b046ed1e06772d" "q-90056/selection/e2436da591f2098d1276fb1c1f68df5e982f32e7c3bc2e53bc1c561fe9b84465" "q-90056/selection/ad37543267649f3ae96ff163c186e2a3283cd4448086170e6f0d37e0d9529513"] :db/ensure [:answer-field/validate]} {:db/id "q-90056" :question/id #uuid "de3c44cb-d266-5c4d-b164-e3eeaaa99800" :question/math-academy-id "q-90056" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14064989/assets/2b2f637d9468aa104dff160b1ebf1f764868e14704adc02e870ea19fa12e4b17.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+3y=6.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{3}x+2.\n$$\n\nNow, since the shaded region lies  *below* the line, the inequality is a \"less than\" or equal to inequality. So the corresponding inequality is\n\n$$\ny\\le -\\frac{1}{3}x+2,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+3y\\le 6.\n$$\n\nNow consider the line $y=2-x.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le 2-x.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+3y\\le 6 \\\\ y\\le 2-x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-90056/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b"] :knowledge-point/questions ["q-90056"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32586"] :question/problem "If $h(x)=\\sqrt{2x+3},$ find ${({h}^{-1})}^{′}(x)$ as a function of ${h}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=\\sqrt{2x+3},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=\\sqrt{2y+3}\n$$\n\nNote that in the equation above, we have $y={h}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}[\\sqrt{2y+3}] \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}[(2y+3)^{1/2}] \\\\ \\frac{\\text{d}x}{\\text{d}y} & =(2y+3)^{-1/2} \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\frac{1}{\\sqrt{2y+3}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{2y+3}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${h}^{-1}(x).$ Since $y={h}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{h}^{-1}(x)] & =\\sqrt{2{h}^{-1}(x)+3} \\\\ {({h}^{-1})}^{′}(x) & =\\sqrt{2{h}^{-1}(x)+3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-68043/selection/ce613869d158ee65610d5a29cd642712ce8ff839e4d13681a91669926bfe6116" :answer/id #uuid "ef182f3a-9301-529c-a79c-bb644879b044" :answer/type :answer.type/text :answer/value "Does not exist." :db/ensure [:answer/validate]} {:db/id "q-68043/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6fa7c714-4915-5a03-9d14-2998b5a58a87" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-68043/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "ef8ca5a1-1a42-5caa-9222-f008dad6ec19" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-68043/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "ca74564e-978c-5d2a-9612-2fc106534d74" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-68043/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "5df22c97-e35e-5d21-a311-faa243d8c95d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-68043/selection" :answer-field/id #uuid "691de6ce-d5d3-5a13-9c50-06484df7668f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-68043/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer-field/choices ["q-68043/selection/ce613869d158ee65610d5a29cd642712ce8ff839e4d13681a91669926bfe6116" "q-68043/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-68043/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" "q-68043/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-68043/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-68043" :question/id #uuid "f2188e54-85fe-53d7-875d-fe88e450703e" :question/math-academy-id "q-68043" :question/problem "Calculate ${lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\,\\,\\frac{{x}^{3}+x}{2{x}^{2}+x+4} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{x}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+\\frac{1}{x})}{(2+\\frac{1}{x}+\\frac{4}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{(x+0)}{(2+0+0)} \\\\  & ={lim}_{x\\to \\infty }\\,\\,\\frac{x}{2} \\\\  & =\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-68043/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d"] :knowledge-point/questions ["q-68043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87685/selection/ebe6f4d26afa362a416b64d63b5c4b51d9e2ae71005bcb2b10a9632f19911f50" :answer/id #uuid "7dae45a0-a246-5b2d-887e-38876039e3bb" :answer/type :answer.type/math :answer/value "x\\ge 2" :db/ensure [:answer/validate]} {:db/id "q-87685/selection/0ffcd15795e34096849b65562b63d39d444e2d6511f2bdba60b68039c64a76f9" :answer/id #uuid "d8d65038-7933-5b48-accc-652c62fc2c22" :answer/type :answer.type/math :answer/value "x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-87685/selection/5cc7740f68d249c121b563986e4e523978d95f1257146cf3f764835ba1481425" :answer/id #uuid "3e83efc3-a4a2-5c02-8a23-b7a1e0d380ed" :answer/type :answer.type/math :answer/value "x\\ge \\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-87685/selection/cf4ab89044f45e06a6b7dbb103cc136da38b257036032f3995e7c1b49183b3e5" :answer/id #uuid "74fb9603-13fb-5c0b-be0d-368e1781813f" :answer/type :answer.type/math :answer/value "x\\le \\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-87685/selection/8ef4120686e7520d69cb1d7684d905708092536316e2305259fdf82e491966ae" :answer/id #uuid "c37427f1-19d6-5db5-b6d1-e700452a786c" :answer/type :answer.type/math :answer/value "x\\le 2" :db/ensure [:answer/validate]} {:db/id "q-87685/selection" :answer-field/id #uuid "3e608aba-7cc3-5f14-9c32-5d30b1a554af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87685/selection/5cc7740f68d249c121b563986e4e523978d95f1257146cf3f764835ba1481425" :answer-field/choices ["q-87685/selection/ebe6f4d26afa362a416b64d63b5c4b51d9e2ae71005bcb2b10a9632f19911f50" "q-87685/selection/0ffcd15795e34096849b65562b63d39d444e2d6511f2bdba60b68039c64a76f9" "q-87685/selection/5cc7740f68d249c121b563986e4e523978d95f1257146cf3f764835ba1481425" "q-87685/selection/cf4ab89044f45e06a6b7dbb103cc136da38b257036032f3995e7c1b49183b3e5" "q-87685/selection/8ef4120686e7520d69cb1d7684d905708092536316e2305259fdf82e491966ae"] :db/ensure [:answer-field/validate]} {:db/id "q-87685" :question/id #uuid "af54b629-4ba1-522d-8445-a7561dd015c8" :question/math-academy-id "q-87685" :question/problem "Solve the inequality $1-4\\sqrt{3x-2}\\le 9.$" :question/worked-solution "First, we isolate the square root:\n\n$$\n\\begin{aligned}1-4\\sqrt{3x-2} & \\le 9 \\\\ -4\\sqrt{3x-2} & \\le 8 \\\\ \\sqrt{3x-2} & \\ge -2\\end{aligned}\n$$\n\nHere, the square root is greater than a negative number $(-2),$ so any number we can substitute into the square root will satisfy the inequality. So, the solution is the domain of the square root.\n\nTo find the domain, we recall that the expression under the square root must be greater than or equal to $0:$\n\n$$\n3x-2\\ge 0\\,⇒\\,x\\ge \\frac{2}{3}\n$$\n\nTherefore, the solution is $x\\ge \\frac{2}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87685/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "24f2c5a5-dc56-5f78-8138-8f7b3a6280e2"] :knowledge-point/questions ["q-87685"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129223/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "53025eaa-e03c-5a79-9f02-e480ce97b82f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129223/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "20fde7ef-7f23-585a-b164-e9d1afdcb361" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-129223/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "15c9a850-725f-517a-bc3d-861d44c558ae" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129223/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c9864dd8-11c3-550d-9dac-a1977ebd9c6d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-129223/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "27415501-96b9-5193-84c6-f9cb710b1f02" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-129223/selection" :answer-field/id #uuid "1afb4ca5-ca86-55ee-a9f9-e8dc94611ae5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129223/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-129223/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129223/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-129223/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-129223/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-129223/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25"] :db/ensure [:answer-field/validate]} {:db/id "q-129223" :question/id #uuid "b4e4bfc1-b5ef-51c2-a12a-529f7a844a95" :question/math-academy-id "q-129223" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[3]{x}}{\\operatorname{cos}⁡x}?$   \n\n- $[-1,1]$\n- $[-2,2]$\n- $[0,1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The intervals $[-1,1]$ and $[0,1]$ are closed, and the function is continuous on each of these intervals. Therefore, the extreme value theorem is applicable on each $[-1,1]$  and $[0,1].$\n\n- The interval $[-2,2]$ is closed, but the function is not continuous on it because it is not defined at $x=\\pm \\frac{\\pi }{2}.$  Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da"] :knowledge-point/questions ["q-129223"] :db/ensure [:knowledge-point/validate]}]
