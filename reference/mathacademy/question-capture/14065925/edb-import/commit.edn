\pi } \\\\ C & =6\\pi .\\end{aligned}\n$$\n\nLastly, since $C=2\\pi r,$ we have\n\n$$\n\\begin{aligned}2\\pi r & =6\\pi  \\\\ r & =3.\\end{aligned}\n$$" 13194139535475 true] [17592186351138 1000 #edb/ref 17592186351139 13194139535475 true] [17592186351138 1040 #edb/ref 17592186045449 13194139535475 true] [17592186351138 1041 "field-1" 13194139535475 true] [17592186351138 1104 #edb/ref 17592186351139 13194139535475 true] [17592186351138 1110 #uuid "4aeb03c8-5ee3-5018-9e58-d5fe767aa350" 13194139535475 true] [17592186351139 1034 "3" 13194139535475 true] [17592186351139 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351139 1111 #uuid "57f6e8ec-9891-5480-82c2-33d4f0e90a10" 13194139535475 true] [17592186351140 1017 #edb/ref 17592186351141 13194139535475 true] [17592186351140 1089 "q-344724" 13194139535475 true] [17592186351140 1091 #edb/ref 17592186045463 13194139535475 true] [17592186351140 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14065925/assets/7cfd87cefcfc8d89330ba08f41c1a90392a2cea68550c1bb648362a8f65e68b6.png)\n\nA circular ripple spreads on the surface of a pond in a circular shape. The area of the ripple is increasing at a rate of $6\\pi \\,{\\text{ft}}^{2}\\,/\\text{s}.$ How fast is the radius of the ripple increasing at the moment when the radius is $4\\,\\text{ft}?$ Do not round the answer.\n\nThe radius of the ripple is increasing at a rate of\n{{field-1}}\n$\\text{ft}/\\text{s}.$" 13194139535475 true] [17592186351140 1113 #uuid "94353f0d-8c1e-5849-a6b7-63fe2a4729db" 13194139535475 true] [17592186351140 1145 "In this situation, we want to find $\\frac{\\text{d}r}{\\text{d}t}$ at the moment when $r=4,$ and we are also told that $\\frac{\\text{d}A}{\\text{d}t}=6\\pi .$\n\nTo start, let's write down the area formula for the circle and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi r.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}A}{\\text{d}t}=6\\pi $ and $r=4,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}6\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi (4) \\\\ 6\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 8\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{3}{4}.\\end{aligned}\n$$\n\nWe conclude that the radius is increasing at a rate of $\\frac{3}{4}\\,\\text{ft}/\\text{s}.$" 13194139535475 true] [17592186351141 1000 #edb/ref 17592186351142 13194139535475 true] [17592186351141 1000 #edb/ref 17592186351143 13194139535475 true] [17592186351141 1040 #edb/ref 17592186045449 13194139535475 true] [17592186351141 1041 "field-1" 13194139535475 true] [17592186351141 1104 #edb/ref 17592186351142 13194139535475 true] [17592186351141 1110 #uuid "2bb8d963-9f74-5e95-965d-b85d83733110" 13194139535475 true] [17592186351142 1034 "\\frac{3}{4}" 13194139535475 true] [17592186351142 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351142 1111 #uuid "664fa3b9-b222-5122-91ad-68f24550d527" 13194139535475 true] [17592186351143 1034 "\\frac{3}{2}" 13194139535475 true] [17592186351143 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351143 1111 #uuid "8561063b-eb23-54af-abc9-22676b0b0b77" 13194139535475 true] [17592186351144 1017 #edb/ref 17592186351145 13194139535475 true] [17592186351144 1089 "q-344744" 13194139535475 true] [17592186351144 1091 #edb/ref 17592186045463 13194139535475 true] [17592186351144 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14065925/assets/9854b8b086ef6f60f02a37f2a0885cbcdd41ec24d5548abe1aa2d6fbebe8dbfe.png)\n\nA spherical balloon is being inflated, causing its enclosed volume to increase at a rate of $128\\pi \\text{ }{\\text{cm}}^{3}/\\text{s}.$ How fast is the radius increasing at the moment when the radius is $4\\text{ }\\text{cm}?$ Do not round the answer.\n\nThe radius of the balloon is increasing at a rate of \n{{field-1}} $\\text{cm}/\\text{s}.$" 13194139535475 true] [17592186351144 1113 #uuid "ad7ac8e7-4074-5114-b1eb-c69db9309f47" 13194139535475 true] [17592186351144 1145 "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=128\\pi \\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=4\\,\\text{cm}.$\n\nTo start, let's write down the formula for the volume of a sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=128\\pi $ and $r=4,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}128\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (4)^{2} \\\\ 128\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 64\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =2.\\end{aligned}\n$$\n\nTherefore, when the radius of the balloon is $4\\,\\text{cm},$ the radius is increasing at a rate of $2$ $\\text{ }\\,\\text{cm}/\\text{s}.$" 13194139535475 true] [17592186351145 1000 #edb/ref 17592186351146 13194139535475 true] [17592186351145 1000 #edb/ref 17592186351147 13194139535475 true] [17592186351145 1040 #edb/ref 17592186045449 13194139535475 true] [17592186351145 1041 "field-1" 13194139535475 true] [17592186351145 1104 #edb/ref 17592186351147 13194139535475 true] [17592186351145 1110 #uuid "6f86b5cd-58c4-5d14-8dcb-a977ed2fc7e2" 13194139535475 true] [17592186351146 1034 "8" 13194139535475 true] [17592186351146 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351146 1111 #uuid "f8f39765-64d6-50ee-bcd5-f63db23c0454" 13194139535475 true] [17592186351147 1034 "2" 13194139535475 true] [17592186351147 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351147 1111 #uuid "534319e5-85df-5395-8919-f67ed7b2f174" 13194139535475 true] [17592186351148 1017 #edb/ref 17592186351149 13194139535475 true] [17592186351148 1089 "q-344749" 13194139535475 true] [17592186351148 1091 #edb/ref 17592186045463 13194139535475 true] [17592186351148 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14065925/assets/e1aafeb4abd5ee1ee545474ed353bccbfb0986cefccb33779fa5744d735d1bdd.png)\n\nA spherical balloon is inflated at the rate of $48{\\text{ cm}}^{3}\\text{/s}.$ If at a particular moment the balloon's radius is changing at the rate $\\frac{3}{4\\pi }\\text{ cm/s},$ then what is the radius of the balloon at this moment? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{cm}$" 13194139535475 true] [17592186351148 1113 #uuid "ec2e9a04-0ac2-5fac-9d3b-24868574e1b4" 13194139535475 true] [17592186351148 1145 "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=48{\\text{ cm}}^{3}\\text{/s},\n$$\n\nand we want to find $r$ when $\\frac{\\text{d}r}{\\text{d}t}=\\frac{3}{4\\pi }\\text{ cm/s}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=48$ and $\\frac{\\text{d}r}{\\text{d}t}=\\frac{3}{4\\pi },$ and solve for $r.$ We get\n\n$$\n\\begin{aligned}48 & =\\frac{3}{4\\pi }\\cdot 4\\pi (r)^{2} \\\\ 48 & =3{r}^{2} \\\\ r & =\\sqrt{16} \\\\ r & =4.\\end{aligned}\n$$\n\nTherefore, the radius at that moment is $4\\text{ }\\text{ cm}.$" 13194139535475 true] [17592186351149 1000 #edb/ref 17592186351150 13194139535475 true] [17592186351149 1040 #edb/ref 17592186045449 13194139535475 true] [17592186351149 1041 "field-1" 13194139535475 true] [17592186351149 1104 #edb/ref 17592186351150 13194139535475 true] [17592186351149 1110 #uuid "b38829df-aba3-5a9f-87e7-2a583ca7fa15" 13194139535475 true] [17592186351150 1034 "4" 13194139535475 true] [17592186351150 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351150 1111 #uuid "d693c65e-271f-565c-a795-0f8f53212cad" 13194139535475 true] [17592186351151 1017 #edb/ref 17592186351152 13194139535475 true] [17592186351151 1089 "q-344751" 13194139535475 true] [17592186351151 1091 #edb/ref 17592186045463 13194139535475 true] [17592186351151 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14065925/assets/287add661cff085d1090295f67f87ee80eeaa3d8301ee6632ab54a812a6cd119.png)\n\nA spherical hailstone is melting uniformly, causing its radius to change at a rate of $\\frac{1}{6\\pi }\\,\\text{mm}\\text{/s}.$ If the radius at a certain moment is $15\\,\\text{mm},$ what is the rate at which the surface area is decreasing?\n\nThe surface area of the hailstone is decreasing at a rate of\n{{field-1}} ${\\text{mm}}^{2}\\text{/s}.$" 13194139535475 true] [17592186351151 1113 #uuid "8ef823c2-17e3-576d-a12b-1eff5e378c3c" 13194139535475 true] [17592186351151 1145 "Let $r$ be the radius of the hailstone and $A$ its surface area. Both $r$ and $A$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}r}{\\text{d}t}=-\\frac{1}{6\\pi }\\,\\text{mm}\\text{/s},\n$$\n\nand we want to find $\\frac{\\text{d}A}{\\text{d}t}$ when $r=15\\,\\text{mm}.$\n\nTo start, let's write down the surface area formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =4\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(4\\pi {r}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(4\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}8\\pi r.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=-\\frac{1}{6\\pi }$ and $r=15.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =-\\frac{1}{6\\pi }\\cdot 8\\pi (15) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =-20.\\end{aligned}\n$$\n\nWe conclude that the surface area of the hailstone is decreasing at a rate of $20{\\text{ mm}}^{2}\\text{/s}.$" 13194139535475 true] [17592186351152 1000 #edb/ref 17592186351153 13194139535475 true] [17592186351152 1040 #edb/ref 17592186045449 13194139535475 true] [17592186351152 1041 "field-1" 13194139535475 true] [17592186351152 1104 #edb/ref 17592186351153 13194139535475 true] [17592186351152 1110 #uuid "d4e8fd4b-f1a1-5680-ae2a-76aa675acb76" 13194139535475 true] [17592186351153 1034 "20" 13194139535475 true] [17592186351153 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351153 1111 #uuid "9378ce20-35ee-52c0-8627-1134eea521d0" 13194139535475 true] [17592186351154 1017 #edb/ref 17592186351155 13194139535475 true] [17592186351154 1089 "q-48520" 13194139535475 true] [17592186351154 1091 #edb/ref 17592186045463 13194139535475 true] [17592186351154 1100 "The radius of a circle is increasing. At a particular moment, the rate of increase of the area of the circle is numerically equal to two-thirds of the rate of increase of the circumference. What is the radius of the circle at that moment?" 13194139535475 true] [17592186351154 1113 #uuid "b8d48815-34e5-5703-a8f9-0f1af6101d28" 13194139535475 true] [17592186351154 1145 "Let $r$  be the radius, $A$ the area, and $C$ the circumference of the circle. We wish to find $r$ at the moment when $\\frac{\\text{d}A}{\\text{d}t}=\\frac{2}{3}\\frac{\\text{d}C}{\\text{d}t}.$\n\nTo start, let's set up an equation relating the area $A$ and the circumference $C$ of the circle. Since $C=2\\pi r$ and $A=\\pi {r}^{2},$ the relationship between $A$ and $C$ is\n\n$$\nA=\\pi {r}^{2}=\\pi {(\\frac{C}{2\\pi })}^{2}=\\frac{{C}^{2}}{4\\pi }.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}C}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{C}{2\\pi }.\\end{aligned}\n$$\n\nNow, since $\\frac{\\text{d}A}{\\text{d}t}=\\frac{2}{3}\\frac{\\text{d}C}{\\text{d}t},$ we have\n\n$$\n\\begin{aligned}\\frac{2}{3}\\frac{\\text{d}C}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{C}{2\\pi } \\\\ \\frac{2}{3} & =\\frac{C}{2\\pi } \\\\ C & =\\frac{4\\pi }{3}.\\end{aligned}\n$$\n\nLastly, since $C=2\\pi r,$ we have\n\n$$\n\\begin{aligned}2\\pi r & =\\frac{4\\pi }{3} \\\\ r & =\\frac{2}{3}.\\end{aligned}\n$$" 13194139535475 true] [17592186351155 1000 #edb/ref 17592186351156 13194139535475 true] [17592186351155 1000 #edb/ref 17592186351157 13194139535475 true] [17592186351155 1000 #edb/ref 17592186351158 13194139535475 true] [17592186351155 1000 #edb/ref 17592186351159 13194139535475 true] [17592186351155 1000 #edb/ref 17592186351160 13194139535475 true] [17592186351155 1040 #edb/ref 17592186045450 13194139535475 true] [17592186351155 1041 "selection" 13194139535475 true] [17592186351155 1104 #edb/ref 17592186351156 13194139535475 true] [17592186351155 1110 #uuid "4ff78f64-2449-5f95-a647-e95decd31f6c" 13194139535475 true] [17592186351156 1034 "\\frac{2}{3}" 13194139535475 true] [17592186351156 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351156 1111 #uuid "4897ada0-2c94-5cf0-ba08-41193ffc201e" 13194139535475 true] [17592186351157 1034 "\\frac{3}{2\\pi }" 13194139535475 true] [17592186351157 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351157 1111 #uuid "51bc57b8-40d3-5768-9b51-f7d20ffc7303" 13194139535475 true] [17592186351158 1034 "3\\pi " 13194139535475 true] [17592186351158 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351158 1111 #uuid "02ab01ef-ea88-5695-9d52-2caed06354d2" 13194139535475 true] [17592186351159 1034 "\\pi \\sqrt{2}" 13194139535475 true] [17592186351159 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351159 1111 #uuid "f2c9838b-0da0-55a7-a4c6-67df46f6062c" 13194139535475 true] [17592186351160 1034 "3\\sqrt{2}" 13194139535475 true] [17592186351160 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351160 1111 #uuid "24ef66b9-6248-5c37-9bf5-944c0d0ab87c" 13194139535475 true] [17592186351161 1017 #edb/ref 17592186351162 13194139535475 true] [17592186351161 1089 "q-48523" 13194139535475 true] [17592186351161 1091 #edb/ref 17592186045465 13194139535475 true] [17592186351161 1100 "The radius of a circle is increasing. At a particular moment, the rate of increase of the area of the circle is numerically equal to one third of the rate of increase of the diameter. Determine the radius of the circle at that moment." 13194139535475 true] [17592186351161 1113 #uuid "df002dfb-f43a-5d15-a121-3e41ea165d9d" 13194139535475 true] [17592186351161 1145 "Let $r$  be the radius, $A$ the area, and $D$ the diameter of the circle. We wish to find $r$ at the moment when $\\frac{\\text{d}A}{\\text{d}t}=\\frac{1}{3}\\frac{\\text{d}D}{\\text{d}t}.$\n\nTo start, let's set up an equation relating the area $A$ and the diameter $D$ of the circle. Since $D=2r$ and $A=\\pi {r}^{2},$ the relationship between $A$ and $D$ is\n\n$$\nA=\\pi {r}^{2}=\\pi {(\\frac{D}{2})}^{2}=\\frac{\\pi {D}^{2}}{4}.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\pi {D}^{2}}{4}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}D}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}D}(\\frac{\\pi {D}^{2}}{4}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}D}{\\text{d}t}\\cdot \\frac{\\pi D}{2}.\\end{aligned}\n$$\n\nNow, since $\\frac{\\text{d}A}{\\text{d}t}=\\frac{1}{3}\\frac{\\text{d}D}{\\text{d}t},$ we have\n\n$$\n\\begin{aligned}\\frac{1}{3}\\frac{\\text{d}D}{\\text{d}t} & =\\frac{\\text{d}D}{\\text{d}t}\\cdot \\frac{\\pi D}{2} \\\\ \\frac{1}{3} & =\\frac{\\pi D}{2} \\\\ D & =\\frac{2}{3\\pi }.\\end{aligned}\n$$\n\nLastly, since $D=2r,$ we have\n\n$$\n\\begin{aligned}2r & =\\frac{2}{3\\pi } \\\\ r & =\\frac{1}{3\\pi }.\\end{aligned}\n$$" 13194139535475 true] [17592186351162 1000 #edb/ref 17592186351163 13194139535475 true] [17592186351162 1000 #edb/ref 17592186351164 13194139535475 true] [17592186351162 1000 #edb/ref 17592186351165 13194139535475 true] [17592186351162 1000 #edb/ref 17592186351166 13194139535475 true] [17592186351162 1000 #edb/ref 17592186351167 13194139535475 true] [17592186351162 1040 #edb/ref 17592186045450 13194139535475 true] [17592186351162 1041 "selection" 13194139535475 true] [17592186351162 1104 #edb/ref 17592186351166 13194139535475 true] [17592186351162 1110 #uuid "1a4e5326-e5aa-5228-9be2-f8130adba292" 13194139535475 true] [17592186351163 1034 "\\sqrt{2}" 13194139535475 true] [17592186351163 1103 #edb/ref 17592186045453 13194139535475 true] [17592186351163 1111 #uuid "09a5f3e4-6e4e-57e3-933e-ecc823375b8a" 13194139535475 true] [17592186351