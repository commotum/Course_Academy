this equation is ${y}^{″}.$\n\n- Equation III is not a second-order differential equation. The highest derivative in this equation is ${y}^{‴},$ so this is a third-order differential equation.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96672/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b"] :knowledge-point/questions ["q-96672"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96663/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7b9d0f75-0bd5-51f7-970d-2cdf9b4bd698" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-96663/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a9f8ea16-f9cd-595d-839d-df65010a5149" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-96663/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "259e1a9a-b4c6-5859-b8e9-e7ff7a430ba3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-96663/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "81c7b091-9e59-5e81-aa07-6c9a58b0133b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-96663/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8708086d-d7e2-5311-97cc-d59dd5ce5ca2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-96663/selection" :answer-field/id #uuid "9fcc026b-82d2-5846-98c8-b2a64ac1522f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96663/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-96663/selection/ad06fa8bb