[{:db/id [:question/math-academy-id "q-95982"] :question/problem "What is the order of the ordinary differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{x}^{3}y=5{y}^{4}\\frac{\\text{d}y}{\\text{d}x}?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ which has order $2.$\n\nTherefore, the order of the ODE is $2.$" :db/ensure [:question/validate]} {:db/id "q-118781/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "66d25487-68f6-5014-8db4-e0cb08a0de0d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-118781/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "b29801d2-6483-514e-9099-aa269d9816f5" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-118781/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "28649c78-5975-5e5b-9f64-24e6e19800cb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-118781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e3c06e4d-4cfb-5018-9420-a1c73a3667b4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-118781/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "9f211831-069a-570b-83ed-b75cee7516da" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-118781/selection" :answer-field/id #uuid "d0d987eb-903e-5449-b204-80f83227cb1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-118781/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-118781/s