1-\\operatorname{cos}⁡x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-119866/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59"] :knowledge-point/questions ["q-119866"] :db/ensure [:knowledge-point/validate]}]
