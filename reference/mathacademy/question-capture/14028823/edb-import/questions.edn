#{[{:db/id #edb/ref 17592186101452 :knowledge-point/_questions [{:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473" :knowledge-point/title "Finding Particular Solutions of Differential Equations by First Rearranging and Then Separating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac850ec3-b885-5757-ba0b-addc1fb55d94" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{e^{x + 1}}{x + 1}" :db/id #edb/ref 17592186100309} {:answer/id #uuid "f3def530-3e15-5653-91e5-ea71d37b51a4" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2e^{-x}}{x^{2} + 1}" :db/id #edb/ref 17592186100310} {:answer/id #uuid "039a2432-47e3-531f-91cd-63e89c5ac45c" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{4e^{x}}{x + 2}" :db/id #edb/ref 17592186100311} {:answer/id #uuid "058896ec-2ddc-5d58-8b04-b130dc246aeb" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2e^{x}}{x + 1}" :db/id #edb/ref 17592186100312} {:answer/id #uuid "54e0dc55-8dde-5219-bcb3-f4ff7d7701d1" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{4e^{-x}}{x^{2} + 2}" :db/id #edb/ref 17592186100313}] :answer-field/correct {:answer/id #uuid "058896ec-2ddc-5d58-8b04-b130dc246aeb" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2e^{x}}{x + 1}" :db/id #edb/ref 17592186100312} :answer-field/id #uuid "7c8c55a6-2e87-5008-995e-44213170dbdd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100308}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "167e1aa1-119e-56a2-b6bf-0adbf44240f8" :question/math-academy-id "q-79372" :question/problem "Find the particular solution to the differential equation $(\\frac{1}{xy} + \\frac{1}{y})\\frac{dy}{dx} = 1$ that satisfies $y(1) = e$." :question/requires-calculator false :question/worked-solution "Combine the coefficient of $y'$:\n$$\\frac{x+1}{xy}y'=1,\\qquad \\frac{y'}y=\\frac{x}{x+1}=1-\\frac1{x+1}.$$\nNear the initial point $x=1$, integration gives $\\ln|y|=x-\\ln|x+1|+C$, hence $y=Ke^x/(x+1)$. Using $y(1)=e$ yields $e=Ke/2$, so $K=2$ and\n$$y=\\frac{2e^x}{x+1}.$$\nUse the interval $x>0$ containing the initial point; the original equation is undefined at $x=0$."}]}
