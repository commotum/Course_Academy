[{:db/id "q-10560/selection/3a69813e23ead618e208f975c59463d6b20baeebb42710c3dd99587c534a1882" :answer/id #uuid "db8d4e98-fbfe-5dce-9968-a73106b01d1e" :answer/type :answer.type/math :answer/value "4\\operatorname{cot}⁡x-4+C" :db/ensure [:answer/validate]} {:db/id "q-10560/selection/708da2ee2359d3ba383814912183ac57bcfec16466e599d5a56ae20bb6c2601c" :answer/id #uuid "2d88eb3c-8e09-50a0-bc79-6048912c515e" :answer/type :answer.type/math :answer/value "-4\\operatorname{cot}⁡x-4+C" :db/ensure [:answer/validate]} {:db/id "q-10560/selection/3988d69aa3272f76558f9774aa68ad45ed0eaf7b4de95cd2f6316daa5205af13" :answer/id #uuid "f1979184-0085-58bc-84c6-8f6bb5f9c2e2" :answer/type :answer.type/math :answer/value "-4\\operatorname{cot}⁡x-4x+C" :db/ensure [:answer/validate]} {:db/id "q-10560/selection/7de49671cc6792a0fb476c1f860a64d978011f7123c0467e17d70a3b31272538" :answer/id #uuid "271abfe3-678a-5a0b-b390-c828fe46b397" :answer/type :answer.type/math :answer/value "4\\operatorname{cot}⁡x+4x+C" :db/ensure [:answer/validate]} {:db/id "q-10560/selection/909f5d99f6dad6412c3d8420680d2d7567f52600a066dd137ffb4552c6952b3d" :answer/id #uuid "3a00f8df-235b-5591-880e-5cb088c7e4d6" :answer/type :answer.type/math :answer/value "4\\operatorname{cot}⁡x-4x+C" :db/ensure [:answer/validate]} {:db/id "q-10560/selection" :answer-field/id #uuid "b0304cac-9464-5bf1-b6e7-4d92e4459a90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10560/selection/3988d69aa3272f76558f9774aa68ad45ed0eaf7b4de95cd2f6316daa5205af13" :answer-field/choices ["q-10560/selection/3a69813e23ead618e208f975c59463d6b20baeebb42710c3dd99587c534a1882" "q-10560/selection/708da2ee2359d3ba383814912183ac57bcfec16466e599d5a56ae20bb6c2601c" "q-10560/selection/3988d69aa3272f76558f9774aa68ad45ed0eaf7b4de95cd2f6316daa5205af13" "q-10560/selection/7de49671cc6792a0fb476c1f860a64d978011f7123c0467e17d70a3b31272538" "q-10560/selection/909f5d99f6dad6412c3d8420680d2d7567f52600a066dd137ffb4552c6952b3d"] :db/ensure [:answer-field/validate]} {:db/id "q-10560" :question/id #uuid "32ae57e1-a8b6-5b40-8edd-03975c1ae75c" :question/math-academy-id "q-10560" :question/problem "Calculate $\\int 4{cot}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n\\begin{aligned}{cot}^{2}⁡x & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int 4{cot}^{2}⁡x\\,\\text{d}x & =\\int 4({csc}^{2}⁡x-1)\\,\\text{d}x \\\\  & =\\int (4{csc}^{2}⁡x-4)\\,\\text{d}x \\\\  & =-4\\operatorname{cot}⁡x-4x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10560/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca"] :knowledge-point/questions ["q-10560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114430/selection/afc612f7a2e9835bb5067d6cd8a6887ca43859034ff75431404125ffca310d0f" :answer/id #uuid "d8eadc8e-1180-5f22-ae00-6da587479ab0" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡x+{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-114430/selection/a6d5977be7ff18ae14d372d0023192643ca53a6c00d5ceda0010cd040c16d435" :answer/id #uuid "8844c747-4140-56a1-8321-99c03df2bd0d" :answer/type :answer.type/math :answer/value "{cos}^{2}⁡x+x+C" :db/ensure [:answer/validate]} {:db/id "q-114430/selection/86ad0dbaf20b2616aeb535c5cf4117f676edd7d11dd29e85ec9f3fa67e90b45c" :answer/id #uuid "4d5cb82a-a57f-5bcc-9bac-04b189f62203" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x+{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-114430/selection/199d8c7c245b19909eaafe26fbdee1cd1a37dc78e7e11d6ee5545fc1b1bce4ab" :answer/id #uuid "387680d8-38f3-5103-b1c3-716e28ccf12e" :answer/type :answer.type/math :answer/value "{sec}^{2}⁡x+{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-114430/selection/9ea5482b4d385593525d28352c2511f3827dc209772eb11ebb8753523397f610" :answer/id #uuid "9d9e01f0-d5cc-59f3-921f-3150db4086ab" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x+x+C" :db/ensure [:answer/validate]} {:db/id "q-114430/selection" :answer-field/id #uuid "737b2e7b-f438-5d8b-8f33-6d08b5e9a5d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114430/selection/86ad0dbaf20b2616aeb535c5cf4117f676edd7d11dd29e85ec9f3fa67e90b45c" :answer-field/choices ["q-114430/selection/afc612f7a2e9835bb5067d6cd8a6887ca43859034ff75431404125ffca310d0f" "q-114430/selection/a6d5977be7ff18ae14d372d0023192643ca53a6c00d5ceda0010cd040c16d435" "q-114430/selection/86ad0dbaf20b2616aeb535c5cf4117f676edd7d11dd29e85ec9f3fa67e90b45c" "q-114430/selection/199d8c7c245b19909eaafe26fbdee1cd1a37dc78e7e11d6ee5545fc1b1bce4ab" "q-114430/selection/9ea5482b4d385593525d28352c2511f3827dc209772eb11ebb8753523397f610"] :db/ensure [:answer-field/validate]} {:db/id "q-114430" :question/id #uuid "0c9267cc-d64e-5c0d-89b0-a5f849c0be02" :question/math-academy-id "q-114430" :question/problem "$\\int (1+2x+{tan}^{2}⁡x)\\text{d}x=$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int (1+2x+{tan}^{2}⁡x)\\text{d}x & =\\int (1+{tan}^{2}⁡x+2x)\\text{d}x \\\\  & =\\int ({sec}^{2}⁡x+2x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x+{x}^{2}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114430/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-114430"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114454/selection/3aa2e6e5db968a6aa325d5f699368018bcc0e6bcc153e03b35ca9c99a940d0cb" :answer/id #uuid "d2ec536b-4961-5fe6-8ebb-372fffd6bc64" :answer/type :answer.type/math :answer/value "2+\\frac{2{\\pi }^{2}}{27}" :db/ensure [:answer/validate]} {:db/id "q-114454/selection/9807a43bd696313f5e4c4cfd70be8cdf26f428cf67c578c8016b179d2fad5112" :answer/id #uuid "8395b527-507a-5a39-ba42-6dbd62835de0" :answer/type :answer.type/math :answer/value "3+\\frac{7{\\pi }^{2}}{9}" :db/ensure [:answer/validate]} {:db/id "q-114454/selection/b94f56b0a31a68e63523991f2f184507ab9b00b824f97b8e417a2ae57f66eac0" :answer/id #uuid "2988201c-b1d9-5069-a368-ab1f88a1b53e" :answer/type :answer.type/math :answer/value "2+\\frac{{\\pi }^{3}}{16}" :db/ensure [:answer/validate]} {:db/id "q-114454/selection/9da7f2f02ff78aeb892674dd3be19991f6bd0eeaa566e1f5a7e0c05a0e7c803f" :answer/id #uuid "8e666528-2275-5a8f-9224-2bc95f0f7410" :answer/type :answer.type/math :answer/value "1+\\frac{{\\pi }^{3}}{8}" :db/ensure [:answer/validate]} {:db/id "q-114454/selection/78483a8d4fd9ddc9f401abe2a4c49557424eb99513cb81c7cdddfcb2cae990c4" :answer/id #uuid "08a446bd-a7c6-5042-839c-486ec10f6562" :answer/type :answer.type/math :answer/value "2+\\frac{7{\\pi }^{3}}{64}" :db/ensure [:answer/validate]} {:db/id "q-114454/selection" :answer-field/id #uuid "fe6b2348-12ae-528b-a19b-7116eb8cd3a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114454/selection/78483a8d4fd9ddc9f401abe2a4c49557424eb99513cb81c7cdddfcb2cae990c4" :answer-field/choices ["q-114454/selection/3aa2e6e5db968a6aa325d5f699368018bcc0e6bcc153e03b35ca9c99a940d0cb" "q-114454/selection/9807a43bd696313f5e4c4cfd70be8cdf26f428cf67c578c8016b179d2fad5112" "q-114454/selection/b94f56b0a31a68e63523991f2f184507ab9b00b824f97b8e417a2ae57f66eac0" "q-114454/selection/9da7f2f02ff78aeb892674dd3be19991f6bd0eeaa566e1f5a7e0c05a0e7c803f" "q-114454/selection/78483a8d4fd9ddc9f401abe2a4c49557424eb99513cb81c7cdddfcb2cae990c4"] :db/ensure [:answer-field/validate]} {:db/id "q-114454" :question/id #uuid "706bfb86-78d1-57d5-9212-fd50f64465b3" :question/math-academy-id "q-114454" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}(2+3{x}^{2}+2{cot}^{2}⁡x)\\text{d}x=$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}(2+3{x}^{2}+2{cot}^{2}⁡x)\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}(2(1+{cot}^{2}⁡x)+3{x}^{2})\\text{d}x \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}(2{csc}^{2}⁡x+3{x}^{2})\\text{d}x \\\\  & =(-2\\operatorname{cot}⁡x+{x}^{3}){|}_{\\pi /4}^{\\pi /2} \\\\  & =-2\\operatorname{cot}⁡(\\frac{\\pi }{2})+{(\\frac{\\pi }{2})}^{3}-[-2\\operatorname{cot}⁡(\\frac{\\pi }{4})+{(\\frac{\\pi }{4})}^{3}] \\\\  & =-0+\\frac{{\\pi }^{3}}{8}+2(1)-\\frac{{\\pi }^{3}}{64} \\\\  & =2+\\frac{7{\\pi }^{3}}{64}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114454/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca"] :knowledge-point/questions ["q-114454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114467/selection/ef705dd416c0ad7014c3e3e897acb50123dcbbd93c19bb96ce8e7256176a83c2" :answer/id #uuid "64732086-d830-5481-a3d4-c645b7dc667b" :answer/type :answer.type/math :answer/value "3\\operatorname{cot}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-114467/selection/08b55cffd9583cc543f2f94318da3d48a2f1638b32ce1c63b2e2e521eacce430" :answer/id #uuid "3df6b120-214b-553f-ac74-dceabad39f18" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{cot}^{2}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-114467/selection/e6ecaa66590c0b0eefdfd4b7f12d05e6cba4c35e4d7d04ed433dc1ac53d1eee8" :answer/id #uuid "8774fc24-25cb-566c-a497-0d21c7085bf5" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-114467/selection/5465b4a43dd34d049f07559ec423c71b44fd217e43df0f8bf5940928a1c2e229" :answer/id #uuid "aa9cb27c-ae77-528b-865e-7270a2ef9410" :answer/type :answer.type/math :answer/value "3{tan}^{2}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-114467/selection/58c0613f345c227a7a463d75c3538e12acd5f316192fc78e734af9ea919a1739" :answer/id #uuid "af3e88c8-9568-536a-ae74-776e27b65c89" :answer/type :answer.type/math :answer/value "3\\operatorname{tan}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "q-114467/selection" :answer-field/id #uuid "ec162a03-9978-5b5a-b96d-7d7370e4f59a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114467/selection/e6ecaa66590c0b0eefdfd4b7f12d05e6cba4c35e4d7d04ed433dc1ac53d1eee8" :answer-field/choices ["q-114467/selection/ef705dd416c0ad7014c3e3e897acb50123dcbbd93c19bb96ce8e7256176a83c2" "q-114467/selection/08b55cffd9583cc543f2f94318da3d48a2f1638b32ce1c63b2e2e521eacce430" "q-114467/selection/e6ecaa66590c0b0eefdfd4b7f12d05e6cba4c35e4d7d04ed433dc1ac53d1eee8" "q-114467/selection/5465b4a43dd34d049f07559ec423c71b44fd217e43df0f8bf5940928a1c2e229" "q-114467/selection/58c0613f345c227a7a463d75c3538e12acd5f316192fc78e734af9ea919a1739"] :db/ensure [:answer-field/validate]} {:db/id "q-114467" :question/id #uuid "964b8d6e-4269-5807-9b82-c5306872b7c3" :question/math-academy-id "q-114467" :question/problem "$\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x=$" :question/worked-solution "From the identity ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ with $\\theta =3x+2,$ we get \n\n$$\n\\begin{aligned}{cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)({cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2))}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int {sec}^{2}⁡(3x+2)\\,\\text{d}x & = \\\\ \\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6"] :knowledge-point/questions ["q-114467"] :db/ensure [:knowledge-point/validate]} {:db/id "q-362509/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "46e2ba4d-bd4d-592d-bbda-c6c7f25eb1c3" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-362509/field-1" :answer-field/id #uuid "8be5e35e-4247-5308-8cf0-ac71074bfac8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-362509/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-362509/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-362509" :question/id #uuid "0ec0c4c5-dfc0-59c3-83c8-64ac67cc3435" :question/math-academy-id "q-362509" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{1-{tan}^{4}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Using the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x,\n$$\n\nwe compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{1-{tan}^{4}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{(1-{tan}^{2}⁡x)(1+{tan}^{2}⁡x)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x}{{sec}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /6} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡(0) \\\\  & =\\frac{1}{2}-0 \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-362509/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-362509"] :db/ensure [:knowledge-point/validate]}]
