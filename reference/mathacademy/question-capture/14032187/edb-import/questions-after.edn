#{[{:db/id #edb/ref 17592186293590 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1979184-0085-58bc-84c6-8f6bb5f9c2e2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}⁡x-4x+C" :db/id #edb/ref 17592186293592} {:answer/id #uuid "db8d4e98-fbfe-5dce-9968-a73106b01d1e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cot}⁡x-4+C" :db/id #edb/ref 17592186293593} {:answer/id #uuid "2d88eb3c-8e09-50a0-bc79-6048912c515e" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}⁡x-4+C" :db/id #edb/ref 17592186293594} {:answer/id #uuid "271abfe3-678a-5a0b-b390-c828fe46b397" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cot}⁡x+4x+C" :db/id #edb/ref 17592186293595} {:answer/id #uuid "3a00f8df-235b-5591-880e-5cb088c7e4d6" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cot}⁡x-4x+C" :db/id #edb/ref 17592186293596}] :answer-field/correct {:answer/id #uuid "f1979184-0085-58bc-84c6-8f6bb5f9c2e2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}⁡x-4x+C" :db/id #edb/ref 17592186293592} :answer-field/id #uuid "b0304cac-9464-5bf1-b6e7-4d92e4459a90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293591}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "32ae57e1-a8b6-5b40-8edd-03975c1ae75c" :question/math-academy-id "q-10560" :question/problem "Calculate $\\int 4{cot}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n\\begin{aligned}{cot}^{2}⁡x & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int 4{cot}^{2}⁡x\\,\\text{d}x & =\\int 4({csc}^{2}⁡x-1)\\,\\text{d}x \\\\  & =\\int (4{csc}^{2}⁡x-4)\\,\\text{d}x \\\\  & =-4\\operatorname{cot}⁡x-4x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293597 :knowledge-point/_questions [{:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387680d8-38f3-5103-b1c3-716e28ccf12e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186293599} {:answer/id #uuid "4d5cb82a-a57f-5bcc-9bac-04b189f62203" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186293600} {:answer/id #uuid "9d9e01f0-d5cc-59f3-921f-3150db4086ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+x+C" :db/id #edb/ref 17592186293601} {:answer/id #uuid "8844c747-4140-56a1-8321-99c03df2bd0d" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x+x+C" :db/id #edb/ref 17592186293602} {:answer/id #uuid "d8eadc8e-1180-5f22-ae00-6da587479ab0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186293603}] :answer-field/correct {:answer/id #uuid "4d5cb82a-a57f-5bcc-9bac-04b189f62203" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186293600} :answer-field/id #uuid "737b2e7b-f438-5d8b-8f33-6d08b5e9a5d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293598}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0c9267cc-d64e-5c0d-89b0-a5f849c0be02" :question/math-academy-id "q-114430" :question/problem "$\\int (1+2x+{tan}^{2}⁡x)\\text{d}x=$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int (1+2x+{tan}^{2}⁡x)\\text{d}x & =\\int (1+{tan}^{2}⁡x+2x)\\text{d}x \\\\  & =\\int ({sec}^{2}⁡x+2x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x+{x}^{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293604 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2ec536b-4961-5fe6-8ebb-372fffd6bc64" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{2{\\pi }^{2}}{27}" :db/id #edb/ref 17592186293606} {:answer/id #uuid "08a446bd-a7c6-5042-839c-486ec10f6562" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{7{\\pi }^{3}}{64}" :db/id #edb/ref 17592186293607} {:answer/id #uuid "8395b527-507a-5a39-ba42-6dbd62835de0" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\frac{7{\\pi }^{2}}{9}" :db/id #edb/ref 17592186293608} {:answer/id #uuid "8e666528-2275-5a8f-9224-2bc95f0f7410" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{{\\pi }^{3}}{8}" :db/id #edb/ref 17592186293609} {:answer/id #uuid "2988201c-b1d9-5069-a368-ab1f88a1b53e" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{{\\pi }^{3}}{16}" :db/id #edb/ref 17592186293610}] :answer-field/correct {:answer/id #uuid "08a446bd-a7c6-5042-839c-486ec10f6562" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{7{\\pi }^{3}}{64}" :db/id #edb/ref 17592186293607} :answer-field/id #uuid "fe6b2348-12ae-528b-a19b-7116eb8cd3a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293605}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "706bfb86-78d1-57d5-9212-fd50f64465b3" :question/math-academy-id "q-114454" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}(2+3{x}^{2}+2{cot}^{2}⁡x)\\text{d}x=$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}(2+3{x}^{2}+2{cot}^{2}⁡x)\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}(2(1+{cot}^{2}⁡x)+3{x}^{2})\\text{d}x \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}(2{csc}^{2}⁡x+3{x}^{2})\\text{d}x \\\\  & =(-2\\operatorname{cot}⁡x+{x}^{3}){|}_{\\pi /4}^{\\pi /2} \\\\  & =-2\\operatorname{cot}⁡(\\frac{\\pi }{2})+{(\\frac{\\pi }{2})}^{3}-[-2\\operatorname{cot}⁡(\\frac{\\pi }{4})+{(\\frac{\\pi }{4})}^{3}] \\\\  & =-0+\\frac{{\\pi }^{3}}{8}+2(1)-\\frac{{\\pi }^{3}}{64} \\\\  & =2+\\frac{7{\\pi }^{3}}{64}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293611 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df6b120-214b-553f-ac74-dceabad39f18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cot}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186293613} {:answer/id #uuid "aa9cb27c-ae77-528b-865e-7270a2ef9410" :answer/type {:db/ident :answer.type/math} :answer/value "3{tan}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186293614} {:answer/id #uuid "af3e88c8-9568-536a-ae74-776e27b65c89" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186293615} {:answer/id #uuid "8774fc24-25cb-566c-a497-0d21c7085bf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186293616} {:answer/id #uuid "64732086-d830-5481-a3d4-c645b7dc667b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cot}⁡(3x+2)+C" :db/id #edb/ref 17592186293617}] :answer-field/correct {:answer/id #uuid "8774fc24-25cb-566c-a497-0d21c7085bf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186293616} :answer-field/id #uuid "ec162a03-9978-5b5a-b96d-7d7370e4f59a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293612}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "964b8d6e-4269-5807-9b82-c5306872b7c3" :question/math-academy-id "q-114467" :question/problem "$\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x=$" :question/worked-solution "From the identity ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ with $\\theta =3x+2,$ we get \n\n$$\n\\begin{aligned}{cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)({cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2))}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int {sec}^{2}⁡(3x+2)\\,\\text{d}x & = \\\\ \\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293618 :knowledge-point/_questions [{:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e2ba4d-bd4d-592d-bbda-c6c7f25eb1c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186293620}] :answer-field/correct {:answer/id #uuid "46e2ba4d-bd4d-592d-bbda-c6c7f25eb1c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186293620} :answer-field/id #uuid "8be5e35e-4247-5308-8cf0-ac71074bfac8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293619}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0ec0c4c5-dfc0-59c3-83c8-64ac67cc3435" :question/math-academy-id "q-362509" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{1-{tan}^{4}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Using the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x,\n$$\n\nwe compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{1-{tan}^{4}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x(1-{tan}^{2}⁡x)}{(1-{tan}^{2}⁡x)(1+{tan}^{2}⁡x)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sec}⁡x}{{sec}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /6} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡(0) \\\\  & =\\frac{1}{2}-0 \\\\  & =\\frac{1}{2}\\end{aligned}\n$$"}]}
