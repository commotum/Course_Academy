#{[{:db/id #edb/ref 17592186263076 :knowledge-point/_questions [{:knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b79bfc8-676e-503e-946d-79385b847734" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡\\theta +1" :db/id #edb/ref 17592186263078} {:answer/id #uuid "4073f40b-f338-5512-8805-07da0b91533e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186263079} {:answer/id #uuid "fd8433ab-0870-5ee6-b35b-d356bfb83b83" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta +1" :db/id #edb/ref 17592186263080} {:answer/id #uuid "149d5725-1e14-5155-9da6-56ce57bba912" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186263081} {:answer/id #uuid "16e20f5a-308b-5ed2-9c26-f51ecdda727b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta +2" :db/id #edb/ref 17592186263082}] :answer-field/correct {:answer/id #uuid "149d5725-1e14-5155-9da6-56ce57bba912" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186263081} :answer-field/id #uuid "ffb74cdf-9966-5f6e-ae4d-1ade8b619ef8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263077}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "07c79843-d608-549b-bcdf-0073c53dea96" :question/math-academy-id "q-119381" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{4}⁡\\theta +{cos}^{2}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }.$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\frac{{cos}^{4}⁡\\theta +{cos}^{2}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }=\\frac{{cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡\\theta ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } & =\\frac{{cos}^{2}⁡\\theta \\cdot 1+{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{2{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{2\\cdot {cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{2\\cdot \\cancel{{cos}^{2}⁡\\theta }}{\\cancel{{cos}^{2}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{2}{\\operatorname{sin}⁡\\theta } \\\\  & =2\\operatorname{csc}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{cos}^{4}⁡\\theta +{cos}^{2}⁡\\theta {sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }=2\\operatorname{csc}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186263083 :knowledge-point/_questions [{:knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2291f25-fb93-5acd-ae05-77f1ba1474e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186263085} {:answer/id #uuid "710f6324-c1c6-5b06-b752-9ef49eb8b494" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta -1" :db/id #edb/ref 17592186263086} {:answer/id #uuid "66902a3d-f8a3-50d0-871e-a4e0c1ec6e97" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta +1" :db/id #edb/ref 17592186263087} {:answer/id #uuid "b1f311e6-2637-54c1-a3eb-72d0fcc85b10" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186263088} {:answer/id #uuid "a6a78ee1-7f38-5cc4-979f-8af77967d901" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186263089}] :answer-field/correct {:answer/id #uuid "e2291f25-fb93-5acd-ae05-77f1ba1474e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186263085} :answer-field/id #uuid "28611615-9679-52c7-aceb-4be8e0b5a6fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263084}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "820b44d3-cfa0-523e-b82f-8693cbae61c6" :question/math-academy-id "q-119387" :question/problem "$\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot 1} \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }\\operatorname{cos}⁡\\theta }{\\cancel{{sin}^{2}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\operatorname{cot}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186263090 :knowledge-point/_questions [{:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6623c070-2c4d-53f8-a668-02bab38fc350" :answer/type {:db/ident :answer.type/math} :answer/value "1+{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186263092} {:answer/id #uuid "13daada9-5931-591e-9f2b-25654b755037" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186263093} {:answer/id #uuid "133ec3b4-7b40-5f64-9241-f13009d8da51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186263094} {:answer/id #uuid "ff4117ea-6eca-5a30-b380-bf0871a75acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186263095} {:answer/id #uuid "1161400f-fac5-54cb-b47d-c897b6913ac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186263096}] :answer-field/correct {:answer/id #uuid "13daada9-5931-591e-9f2b-25654b755037" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186263093} :answer-field/id #uuid "4238ba6b-2e70-5283-b7ea-82c97366ed76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263091}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a50909c4-a6a9-5b36-a619-4604d6f9a9f9" :question/math-academy-id "q-119773" :question/problem "$1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1}{1}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1\\cdot (1+{sin}^{2}⁡\\theta )}{1\\cdot (1+{sin}^{2}⁡\\theta )}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1+{sin}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1+1}{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{2}{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=\\frac{2}{1+{sin}^{2}⁡\\theta }.\n$$"}] [{:db/id #edb/ref 17592186263097 :knowledge-point/_questions [{:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9b9d60-2107-5f0b-9fc0-f9947951ca9c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186263099} {:answer/id #uuid "f68d22cf-f49f-57f1-91ea-4f00ff7836ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186263100} {:answer/id #uuid "922a8e15-32ac-5c92-a6e2-9ef22f3d29a2" :answer/type {:db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186263101} {:answer/id #uuid "59b5ddb2-47e7-55cd-baba-aefd01983ceb" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186263102} {:answer/id #uuid "5190df98-793c-5e49-b6b7-c9fb25048e2e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186263103}] :answer-field/correct {:answer/id #uuid "3b9b9d60-2107-5f0b-9fc0-f9947951ca9c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186263099} :answer-field/id #uuid "63e0b72a-0e78-55e0-af58-b1d477fc563e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263098}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a7dc2170-1f88-5ea2-a622-698bc8f5a8c8" :question/math-academy-id "q-43291" :question/problem "Simplify $\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta }+\\frac{(1-\\operatorname{sin}⁡\\theta )(1-\\operatorname{sin}⁡\\theta )}{\\operatorname{cos}⁡\\theta (1-\\operatorname{sin}⁡\\theta )} \\\\  & =\\frac{{cos}^{2}⁡\\theta +{(1-\\operatorname{sin}⁡\\theta )}^{2}}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡\\theta +{(1-\\operatorname{sin}⁡\\theta )}^{2}}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } & =\\frac{{cos}^{2}⁡\\theta +1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+1-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{1+1-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2(1-\\operatorname{sin}⁡\\theta )}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2}{\\operatorname{cos}⁡\\theta } \\\\  & =2\\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }=2\\operatorname{sec}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186263104 :knowledge-point/_questions [{:knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99b3a21f-f804-5079-9237-c7ba45995e62" :answer/type {:db/ident :answer.type/math} :answer/value "-{sin}^{2}⁡x" :db/id #edb/ref 17592186263106} {:answer/id #uuid "67629e5c-0bcd-5caf-991f-2eb02622bf56" :answer/type {:db/ident :answer.type/math} :answer/value "-{sin}^{3}⁡x" :db/id #edb/ref 17592186263107} {:answer/id #uuid "1eea05d5-6ede-58a0-b4b7-12e908839696" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186263108} {:answer/id #uuid "8703a7bb-64a8-53d2-baa1-cb8bec8da121" :answer/type {:db/ident :answer.type/math} :answer/value "{sin}^{2}⁡x" :db/id #edb/ref 17592186263109} {:answer/id #uuid "62df7017-dd05-5781-823b-58ceae6caabd" :answer/type {:db/ident :answer.type/math} :answer/value "{sin}^{3}⁡x" :db/id #edb/ref 17592186263110}] :answer-field/correct {:answer/id #uuid "62df7017-dd05-5781-823b-58ceae6caabd" :answer/type {:db/ident :answer.type/math} :answer/value "{sin}^{3}⁡x" :db/id #edb/ref 17592186263110} :answer-field/id #uuid "28dfb25a-d3d8-5c90-93db-d5681f0340d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263105}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8e963a6f-8389-5581-b393-ae7fbf5d7d1f" :question/math-academy-id "q-65242" :question/problem "Simplify the trigonometric expression ${sin}^{5}⁡x+{cos}^{2}⁡x{sin}^{3}⁡x.$" :question/worked-solution "First, we factor ${sin}^{3}⁡x$ from the expression:\n\n$$\n{sin}^{5}⁡x+{cos}^{2}⁡x{sin}^{3}⁡x={sin}^{3}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x)\n$$\n\nThen, we use ${sin}^{2}⁡x+{cos}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}{sin}^{3}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x) & ={sin}^{3}⁡x\\cdot 1 \\\\  & ={sin}^{3}⁡x\\end{aligned}\n$$\n\nWe conclude that\n\n$$\n{sin}^{5}⁡x+{cos}^{2}⁡x{sin}^{3}⁡x={sin}^{3}⁡x.\n$$"}]}
