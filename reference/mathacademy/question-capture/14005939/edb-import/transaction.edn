2}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2507/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-2507"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2504/selection/f94030beda921f8515669b30e144fd7beac06bdbeaa9388650c697332670b9e7" :answer/id #uuid "09012162-0dcf-5502-acf8-652fbf5f4664" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(16x)}{16}+C" :db/ensure [:answer/validate]} {:db/id "q-2504/selection/89906495db1a1c8daec3f51731a7faf6972332f8014e4bae89f725cfd4d05ede" :answer/id #uuid "917cb601-d5eb-572d-bf4f-bb06a638fc75" :answer/type :answer.type/math :answer/value "4\\operatorname{arctan}⁡(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-2504/selection/f5ebbdbcf1628ee2f9203eba0ce82465a63ca4d34507894b3f7eb2beb039a6cd" :answer/id #uuid "0d211053-2cb4-527f-9855-1c711ef74364" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(8x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "q-2504/selection/d9e1d259136bffadcdd482efa8f5f35aa9732395e67bf32fab31e41a5caf976f" :answer/id #uuid "6d26f927-4703-5484-9b89-b190a8cfc990" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{16}+C" :db/ensure [:answer/validate]} {:db/id "q-2504/selection/cd7c8f2420436bd8bb55c3db36ee9785a71c8d8daf033e0becfc84d6e39e0c4d" :answer/id #uuid "b1e2fd85-f260-5896-b563-68fad839d972" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-2504/selection" :answer-field/id #uuid "2979d981-dd42-57b5-88bf-67d3e7add18c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2504/selection/cd7c8f2420436bd8bb55c3db36ee9785a71c8d8daf033e0becfc84d6e39e0c4d" :answer-field/choices ["q-2504/selection/f94030beda921f8515669b30e144fd7beac06bdbeaa9388650c697332670b9e7" "q-2504/selection/89906495db1a1c8daec3f51731a7faf6972332f8014e4bae89f725cfd4d05ede" "q-2504/selection/f5ebbdbcf1628ee2f9203eba0ce82465a63ca4d34507894b3f7eb2beb039a6cd" "q-2504/selection/d9e1d259136bffadcdd482efa8f5f35aa9732395e67bf32fab31e41a5caf976f" "q-2504/selection/cd7c8f2420436bd8bb55c3db36ee9785a71c8d8daf033e0becfc84d6e39e0c4d"] :db/ensure [:answer-field/validate]} {:db/id "q-2504" :question/id #uuid "2793cfa5-af9d-509f-b5fa-c5da2d7d9995" :question/math-academy-id "q-2504" :question/problem "$\\int \\frac{1}{1+16{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $16{x}^{2}=(4x)^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+16{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(4x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2504/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-2504"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49551/selection/d8287df44d91964bda79c