54d3b3ef8cca5702ca74bdada94655190ae5b51145b15ba2b"] :db/ensure [:answer-field/validate]} {:db/id "q-49551" :question/id #uuid "ec0c05df-7d58-5545-ba25-2a23d7c5e6ce" :question/math-academy-id "q-49551" :question/problem "$\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\int \\frac{2}{64\\cdot (1+{x}^{2}/64)}\\,\\text{d}x \\\\  & =\\frac{2}{64}\\int \\frac{1}{1+{x}^{2}/64}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{8})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{8}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{8}\\,⟹\\,\\text{d}x=8\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+{u}^{2}}\\cdot (8\\,\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{8})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49551/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-49551"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114046/selection/79f1aa65fb3d502cebaedfa732809a82735736037d6850dde54f0e1477c9f76d" :answer/id #uuid "742eb3c8-dc80-5fa9-ad36-9329b3c7002e" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114046/selection/26ef6994ff2b44acd71fac929cf66afe6d5437cef4fd29f87c59ccf982f1e534" :answer/id #uuid "28a8ac60-0116-5e76-8bd0-8240616a4ef3" :answer/type :answer.type/math :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-114046/selection/b728d2133f4a2f209ceaaf32693821daf96fc57f7c38d753a8701f59765041ce" :answer/id #uuid "f60a0147-29d7-5482-8679-51b7608e7d2d" :answer/type :answer.type/math :answer/value "\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-114046/selection/a124a90e2d19cfd165e2445c6c23c767862f815015aef76959704afc0e1ef829" :answer/id #uuid "ed595cf4-8bc0-52f4-ad0d-ea6680beeb00" :answer/type :answer.type/math :answer/value "9\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-114046/selection/077ace950979026b9aabe853b5b596102c43696e5f14c6a28e03a8bfdfd136d7" :answer/id #uuid "c61400a3-b4de-54ea-b92a-2aaddcd20daf" :answer/type :answer.type/math :answer/value "\\operatorname{arctan}⁡(9x)+C" :db/ensure [:answer/validate]} {:db/id "q-114046/selection" :answer-field/id #uuid "a2c6f62f-0ddf-58c2-8ebd-7d6080a86152" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114046/selection/b728d2133f4a2f209ceaaf32693821daf96fc57f7c38d753a8701f59765041ce" :answer-field/choices ["q-114046/selection/79f1aa65fb3d502cebaedfa732809a82735736037d6850dde54f0e1477c9f76d" "q-114046/selection/26ef6994ff2b44acd71fac929cf66afe6d5437cef4fd29f87c59ccf982f1e534" "q-114046/selection/b728d2133f4a2f209ceaaf32693821daf96fc57f7c38d753a8701f59765041ce" "q-114046/selection/a124a90e2d19cfd165e2445c6c23c767862f815015aef76959704afc0e1ef829" "q-114046/selection/077ace950979026b9aabe853b5b596102c43696e5f14c6a28e03a8bfdfd136d7"] :db/ensure [:answer-field/validate]} {:db/id "q-114046" :question/id #uuid "773c49c1-4feb-58a3-abe3-1d48220dd1dc" :question/math-academy-id "q-114046" :question/problem "Calculate $\\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x & =\\int \\frac{9}{81\\cdot (1+{x}^{2}/81)}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{x}^{2}/81}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+(x/9)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\n The only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{9})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{9}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{9}\\,⟹\\,\\text{d}x=9\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{9}{81+{x}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+(x/9)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot (9\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\operatorname{arctan}⁡u+C \\\\  & =\\operatorname{arctan}⁡(\\frac{x}{9})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-114046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69477/selection/68fe4d429980f2a3c704aef380c749ebb8bbff2c93020c4bcf0511ac9a2c8000" :answer/id #uuid "77c353a2-f4f0-5b4f-8ae0-3993629b9a27" :answer/type :answer.type/math :answer/value "\\text{arcsec}(9x)+C" :db/ensure [:answer/validate]} {:db/id "q-69477/selection/6c45ce1e037ae641c134911373c600c8d9167245b41beacf7ce46b45ad1996d1" :answer/id #uuid "1bc3416c-0064-57b0-b78d-08f1d83b230a" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(9x)}{9}+C" :db/ensure [:answer/validate]} {:db/id "q-69477/selection/0a02c8c10d4ff95b8674f27f39b4f895e80a2734b8f111769a7d60a86c90869d" :answer/id #uuid "1ff28e8d-b554-5c19-b021-743988a1c637" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(3x)}{81}+C" :db/ensure [:answer/validate]} {:db/id "q-69477/selection/c67c7590c181520b00ed5e3f78607f368decdcc7da6f78dd7a3e85df8fcf0803" :answer/id #uuid "6fcb23e3-2a81-5fd3-a30a-60b177abb850" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(9x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-69477/selection/21ad8be0f48dc85b9b01b226cc019dd523b18637790eac04f50ca81eb70126bf" :answer/id #uuid "d14e6d0d-efbe-5716-9965-81124d6eaad5" :answer/type :answer.type/math :answer/value "\\text{arcsec}(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-69477/selection" :answer-field/id #uuid "0dbfec11-1b58-50bd-aa86-a4448edc8930" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69477/selection/c67c7590c181520b00ed5e3f78607f368decdcc7da6f78dd7a3e85df8fcf0803" :answer-field/choices ["q-69477/selection/68fe4d429980f2a3c704aef380c749ebb8bbff2c93020c4bcf0511ac9a2c8000" "q-69477/selection/6c45ce1e037ae641c134911373c600c8d9167245b41beacf7ce46b45ad1996d1" "q-69477/selection/0a02c8c10d4ff95b8674f27f39b4f895e80a2734b8f111769a7d60a86c90869d" "q-69477/selection/c67c7590c181520b00ed5e3f78607f368decdcc7da6f78dd7a3e85df8fcf0803" "q-69477/selection/21ad8be0f48dc85b9b01b226cc019dd523b18637790eac04f50ca81eb70126bf"] :db/ensure [:answer-field/validate]} {:db/id "q-69477" :question/id #uuid "ee223eb2-629b-5731-9725-5e8dc3250c29" :question/math-academy-id "q-69477" :question/problem "$\\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=3\\int \\frac{\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $9x.$\n\nSo, let's substitute $u=9x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,⟹\\,\\text{d}x=\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}3\\int \\frac{1}{|9x|\\sqrt{(9x)^{2}-1}}\\text{d}x & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(9x)}{3}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69477/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7"] :knowledge-point/questions ["q-69477"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114051/selection/4a0689793f0a34e2bd18356051b63044c195c280298c89be0505eb24137315c3" :answer/id #uuid "29ee8153-af01-53fa-afe5-b4270151bafa" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(5x)+C" :db/ensure [:answer/validate]} {:db/id "q-114051/selection/d26fae1dc859cf56a18e4920c39d87383672fc5e14a8b1ee2c738d431e9a6ef1" :answer/id #uuid "556bc950-a93a-5a12-a14d-a56c0183c7a6" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114051/selection/63772b90237b3346491e8545397ad5b53ec748af2bf73914f4d9e0bf96bd90f0" :answer/id #uuid "76658b0f-bdb1-5178-a04c-e74d20b5614b" :answer/type :answer.type/math :answer/value "\\text{arcsec}(\\sqrt{5}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114051/selection/9bf4a30f55295d4c685d811de09dbd52fcd77438b9853f2bcb845d88021d2db2" :answer/id #uuid "75156ac2-1acc-5fc2-81d1-afc274fa4cc1" :answer/type :answer.type/math :answer/value "\\sqrt{5}\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114051/selection/6f1c8e42680e609067522949f1d0e8b5002d0ff7e542f2ac32c560ee9cae93d5" :answer/id #uuid "5d032742-72a0-5631-a227-587bdd5dffd9" :answer/type :answer.type/math :answer/value "\\text{arcsec}(5x)+C" :db/ensure [:answer/validate]} {:db/id "q-114051/selection" :answer-field/id #uuid "2390826e-c3f6-5f7e-975a-d4d0aba4a2f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114051/selection/63772b90237b3346491e8545397ad5b53ec748af2bf73914f4d9e0bf96bd90f0" :answer-field/choices ["q-114051/selection/4a0689793f0a34e2bd18356051b63044c195c280298c89be0505eb24137315c3" "q-114051/selection/d26fae1dc859cf56a18e4920c39d87383672fc5e14a8b1ee2c738d431e9a6ef1" "q-114051/selection/63772b90237b3346491e8545397ad5b53ec748af2bf73914f4d9e0bf96bd90f0" "q-114051/selection/9bf4a30f55295d4c685d811de09dbd52fcd77438b9853f2bcb845d88021d2db2" "q-114051/selection/6f1c8e42680e609067522949f1d0e8b5002d0ff7e542f2ac32c560ee9cae93d5"] :db/ensure [:answer-field/validate]} {:db/id "q-114051" :question/id #uuid "604712d6-42d9-5fa2-83bd-a9f37f01b70e" :question/math-academy-id "q-114051" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114051/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7"] :knowledge-point/questions ["q-114051"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49519/selection/0fef89ab934e794c175e4357de0f1fa321fcb98f19b38420d188f1da0dfef093" :answer/id #uuid "2627ae3f-41d7-5cbe-b37a-70cc75dd4f40" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(16x)}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-49519/selection/11ac2bffd5fded82cbc098cd632dad75cd3ab67eec66bcdf17db86fc7dae86cc" :answer/id #uuid "6667fcec-c3d4-578a-aa5c-c91b07c0a242" :answer/type :answer.type/math :answer/value "4\\text{arcsec}(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-49519/selection/cd7c8f2420436bd8bb55c3db36ee9785a71c8d8daf033e0becfc84d6e39e0c4d" :answer/id #uuid "53225feb-5584-5718-a3da-ae6e6f262ffc" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-49519/selection/9c9cc4e329d428f6d7250119f4c237ed81a01856b4e857d0ee88c11387b69cfd" :answer/id #uuid "1a02d456-d344-5fb5-88a4-0547f4cb651d" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-49519/selection/d5dce8752bc5bf6bb76be1b0bdb95720c80f3b77cdf9cce4d09d26c692abb181" :answer/id #uuid "7070e6ab-0e5c-529c-9344-5fda4e755c06" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-49519/selection"