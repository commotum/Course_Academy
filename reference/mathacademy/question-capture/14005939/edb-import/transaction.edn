bf036fad991d850470398cf27e896134d171cbe1aac03914065218"] :db/ensure [:answer-field/validate]} {:db/id "q-114025" :question/id #uuid "23b873d8-ac0f-5aee-8252-f929246de6fc" :question/math-academy-id "q-114025" :question/problem "Calculate $\\int \\frac{1}{9\\sqrt{1-81{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $81{x}^{2}=(9x)^{2}.$\n\nSo, let's substitute $u=9x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,⟹\\,\\text{d}x=\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{9\\sqrt{1-81{x}^{2}}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-(9x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{81}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡(9x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114025/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839"] :knowledge-point/questions ["q-114025"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114027/selection/723533cb2ce9de0ba9c2cbec5d09a2e83e793abb25338cc311707df491820e9b" :answer/id #uuid "cbfbca95-5141-5253-a86e-9584a7b510a6" :answer/type :answer.type/math :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114027/selection/9963f2b10d9d1d85b70350bd7e2f81806b3940444e10df0cf92d2c5c3b45707e" :answer/id #uuid "187e2440-fa88-5df3-9582-c6cab739bf44" :answer/type :answer.type/math :answer/value "\\frac{8\\s