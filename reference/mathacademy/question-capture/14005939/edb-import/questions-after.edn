name{arctan}⁡(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064563 :knowledge-point/_questions [{:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9da81b68-ebde-5369-92b1-4afdce4b14af" :answer/type {:db/ident :answer.type/math} :answer/value "(\\arcsin (4x))/(4) + C" :db/id #edb/ref 17592186061890} {:answer/id #uuid "dde39b33-fd37-56d1-bbaf-6d1fd4f24137" :answer/type {:db/ident :answer.type/math} :answer/value "(\\arccos (2x))/(2) + C" :db/id #edb/ref 17592186061891} {:answer/id #uuid "09c7eaeb-4c9f-5943-9207-780c5d920920" :answer/type {:db/ident :answer.type/math} :answer/value "(\\arcsin (2x))/(2) + C" :db/id #edb/ref 17592186061892} {:answer/id #uuid "240d0d2e-240b-5e8a-a4ac-f17deb60ef34" :answer/type {:db/ident :answer.type/math} :answer/value "2\\arcsin (2x) + C" :db/id #edb/ref 17592186061893} {:answer/id #uuid "62b96790-fefd-5e0f-9e83-686cd1db7b8d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\arccos (4x))/(4) + C" :db/id #edb/ref 17592186061894}] :answer-field/correct {:answer/id #uuid "09c7eaeb-4c9f-5943-9207-780c5d920920" :answer/type {:db/ident :answer.type/math} :answer/value "(\\arcsin (2x))/(2) + C" :db/id #edb/ref 17592186061892} :answer-field/id #uuid "fc8c01c4-13bb-5195-bcbf-b6814e95ea4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061889}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "acd4f39a-fd64-5311-a828-2932bce0f1a8" :question/math-academy-id "q-2505" :question/problem "$\\int \\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(2x)}{2}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287533 :knowledge-point/_questions [{:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efbd9355-7eca-50ac-9063-b06770bdc7cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C" :db/id #edb/ref 17592186287535} {:answer/id #uuid "64a7ab19-7abb-57f6-a957-9d9a7cf2d6a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(x)}{25}+C" :db/id #edb/ref 17592186287536} {:answer/id #uuid "97242a87-2ce3-57fd-928b-28648b62cbc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287537} {:answer/id #uuid "28602c5a-0558-5bfb-adfa-a6e38012cfab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287538} {:answer/id #uuid "aea0486f-7ecf-5b4b-aaf0-d75ab5ee51ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(25x)}{25}+C" :db/id #edb/ref 17592186287539}] :answer-field/correct {:answer/id #uuid "97242a87-2ce3-57fd-928b-28648b62cbc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287537} :answer-field/id #uuid "b5033eb5-575b-5736-bdc0-22f90f2d0c84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287534}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b276c35b-2077-5eef-8db9-05ae17fa54c3" :question/math-academy-id "q-2507" :question/problem "$\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287540 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2f9806d-3a72-5f0a-a6f4-db8dad8871f6" :knowledge-point/title "Calculating Definite Integrals Using Substitution with Inverse Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a4a8f7-42d1-5dd3-b7bb-4185824a00e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{12}" :db/id #edb/ref 17592186287542} {:answer/id #uuid "71112578-89b5-5fba-bc90-fd5415f8439e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\sqrt{5}\\pi" :db/id #edb/ref 17592186287543}] :answer-field/correct {:answer/id #uuid "71112578-89b5-5fba-bc90-fd5415f8439e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\sqrt{5}\\pi" :db/id #edb/ref 17592186287543} :answer-field/id #uuid "fee69010-2c06-5927-a264-74e8018dfe87" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186287541}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6840375a-3412-588f-aa1f-b3b36a2c5359" :question/math-academy-id "q-351291" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =10{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{5(1-16{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{10}{\\sqrt{5}}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine, \n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(4x)}^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}\\operatorname{arcsin}⁡u\\,{|}_{0}^{1/2} \\\\  & =\\frac{\\sqrt{5}}{2}(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{\\sqrt{5}}{2}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi \\sqrt{5}}{12}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287544 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2627ae3f-41d7-5cbe-b37a-70cc75dd4f40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(16x)}{2}+C" :db/id #edb/ref 17592186287546} {:answer/id #uuid "6667fcec-c3d4-578a-aa5c-c91b07c0a242" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{arcsec}(4x)+C" :db/id #edb/ref 17592186287547} {:answer/id #uuid "1a02d456-d344-5fb5-88a4-0547f4cb651d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{4}+C" :db/id #edb/ref 17592186287548} {:answer/id #uuid "53225feb-5584-5718-a3da-ae6e6f262ffc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C" :db/id #edb/ref 17592186287549} {:answer/id #uuid "7070e6ab-0e5c-529c-9344-5fda4e755c06" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(4x)}{4}+C" :db/id #edb/ref 17592186287550}] :answer-field/correct {:answer/id #uuid "7070e6ab-0e5c-529c-9344-5fda4e755c06" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(4x)}{4}+C" :db/id #edb/ref 17592186287550} :answer-field/id #uuid "acf9d476-8a4f-5422-a9b6-c351088a07bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287545}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f772a798-298b-5c91-aac0-873cbcc63da7" :question/math-academy-id "q-49519" :question/problem "$\\int \\frac{1}{4|x|\\sqrt{16{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{4|x|\\sqrt{16{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|4x|\\sqrt{(4x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $4x.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{4|x|\\sqrt{16{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|4x|\\sqrt{(4x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{4}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287551 :knowledge-point/_questions [{:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83968c12-e703-5226-be8b-0715c08ed100" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcsin}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186287553} {:answer/id #uuid "7db732e0-f117-5d15-8e6c-192e1b8b0c88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arctan}⁡(5x)+C" :db/id #edb/ref 17592186287554} {:answer/id #uuid "b8363bbb-cc56-5ac6-8d3f-8e98593234ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arctan}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186287555} {:answer/id #uuid "eb4c1463-6ab8-54a2-86a8-95b8ee5aa49e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186287556} {:answer/id #uuid "53788ea9-2d45-508b-8be1-dbc999162a1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186287557}] :answer-field/correct {:answer/id #uuid "b8363bbb-cc56-5ac6-8d3f-8e98593234ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arctan}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186287555} :answer-field/id #uuid "968c70b5-c733-5603-a441-c96bb891841e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287552}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ce76c021-250c-5a67-b73f-f7d925e67c4d" :question/math-academy-id "q-49550" :question/problem "$\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{25\\cdot (1+{x}^{2}/25)}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+{x}^{2}/25}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{5})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+{u}^{2}}\\cdot (5\\,\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡(\\frac{x}{5})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287558 :knowledge-point/_questions [{:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4c5e771-9cb1-56a1-95ac-c77fe0c7e8f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(8x)}{8}+C" :db/id #edb/ref 17592186287560} {:answer/id #uuid "7122d01d-b98c-5c26-9957-977d4cd0e05e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186287561} {:answer/id #uuid "e0e43244-c07c-535d-a80b-3027cfc6337b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186287562} {:answer/id #uuid "5fd01d36-e9a0-5dd6-8590-f6961df3ca3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{8}+C" :db/id #edb/ref 17592186287563} {:answer/id #uuid "6f85c4d0-8beb-556a-891b-16513bc22405" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{4})}{4}+C" :db/id #edb/ref 17592186287564}] :answer-field/correct {:answer/id #uuid "e0e43244-c07c-535d-a80b-3027cfc6337b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{4}+C" :db/id #edb/ref 17592186287562} :answer-field/id #uuid "8ad8d76f-0b16-53dc-933f-d51940670705" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287559}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ec0c05df-7d58-5545-ba25-2a23d7c5e6ce" :question/math-academy-id "q-49551" :question/problem "$\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\int \\frac{2}{64\\cdot (1+{x}^{2}/64)}\\,\\text{d}x \\\\  & =\\frac{2}{64}\\int \\frac{1}{1+{x}^{2}/64}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{8})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{8}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{8}\\,⟹\\,\\text{d}x=8\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+{u}^{2}}\\cdot (8\\,\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{8})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287565 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ece5e85e-b4c8-5984-bbf6-c5d641f7e0b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(6x)+C" :db/id #edb/ref 17592186287567} {:answer/id #uuid "a03c8a46-63d7-5d87-a112-ce2eca95627e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(6x)}{6}+C" :db/id #edb/ref 17592186287568} {:answer/id #uuid "b070d04b-21f0-56e8-9371-ade15a7a070c" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(36x)+C" :db/id #edb/ref 17592186287569} {:answer/id #uuid "2ff750ae-15dc-55bb-9be1-c739ed561569" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(36x)}{6}+C" :db/id #edb/ref 17592186287570} {:answer/id #uuid "d940b245-8aaa-5c05-b55f-729bde7fe241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(6x)}{6}+C" :db/id #edb/ref 17592186287571}] :answer-field/correct {:answer/id #uuid "d940b245-8aaa-5c05-b55f-729bde7fe241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(6x)}{6}+C" :db/id #edb/ref 17592186287571} :answer-field/id #uuid "6a492674-5acb-5ad6-8f37-d62b4b029ca0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287566}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "916b6d41-3fd5-5521-b94a-8c94035e86e8" :question/math-academy-id "q-49555" :question/problem "$\\int \\frac{1}{6|x|\\sqrt{36{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{6|x|\\sqrt{36{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|6x|\\sqrt{(6x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $6x.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{6|x|\\sqrt{36{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|6x|\\sqrt{(6x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{6}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{6}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(6x)}{6}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287572 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff28e8d-b554-5c19-b021-743988a1c637" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(3x)}{81}+C" :db/id #edb/ref 17592186287574} {:answer/id #uuid "d14e6d0d-efbe-5716-9965-81124d6eaad5" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(3x)+C" :db/id #edb/ref 17592186287575} {:answer/id #uuid "77c353a2-f4f0-5b4f-8ae0-3993629b9a27" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(9x)+C" :db/id #edb/ref 17592186287576} {:answer/id #uuid "1bc3416c-0064-57b0-b78d-08f1d83b230a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(9x)}{9}+C" :db/id #edb/ref 17592186287577} {:answer/id #uuid "6fcb23e3-2a81-5fd3-a30a-60b177abb850" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(9x)}{3}+C" :db/id #edb/ref 17592186287578}] :answer-field/correct {:answer/id #uuid "6fcb23e3-2a81-5fd3-a30a-60b177abb850" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(9x)}{3}+C" :db/id #edb/ref 17592186287578} :answer-field/id #uuid "0dbfec11-1b58-50bd-aa86-a4448edc8930" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287573}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ee223eb2-629b-5731-9725-5e8dc3250c29" :question/math-academy-id "q-69477" :question/problem "$\\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{3\\,\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}=3\\int \\frac{\\text{d}x}{|9x|\\sqrt{(9x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $9x.$\n\nSo, let's substitute $u=9x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,⟹\\,\\text{d}x=\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}3\\int \\frac{1}{|9x|\\sqrt{(9x)^{2}-1}}\\text{d}x & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(9x)}{3}+C\\end{aligned}\\end{aligned}\n$$"}]}
