    {
      "question": "e-470",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "6f1b954174214cb08074d1e094bd7874e82c41a76551dbb13cecde336bcb530c",
      "new_sha256": "b88fb4262ec179f79d164a6440130e9d1034c0ce819d0737958fa0791ac873fb",
      "category": "ma_capture",
