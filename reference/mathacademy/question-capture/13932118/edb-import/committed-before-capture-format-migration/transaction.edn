06f677d79163db8"] :db/ensure [:answer-field/validate]} {:db/id "q-71136" :question/id #uuid "748d3aac-95ca-55c7-80f0-ef3cf5eeb0de" :question/math-academy-id "q-71136" :question/is-example false :question/problem "What is the domain of the function $f(x)=\\frac{1}{x-5}-2?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}x-5 & =0 \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,5)\\cup (5,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2"] :knowledge-point/questions ["q-71136"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106736/selection/25744d83dd5dbdb65636f2eb97794b21bac6de9797033919b4c1a9913918eb0f" :answer/id #uuid "498a20a4-97f8-51a2-bbc4-41988fcb3737" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0)\\cup (0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-106736/selection/364a0fc95f568eeda6b983d9a3400fb16174b6a42553a3e2d14d96e6aa084560" :answer/id #uuid "902c7524-1aed-5dec-832e-a1e7cd4d8c9b" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,2)\\cup (2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-106736/selection/921aa0b9e797e8453202c6424e5a79d68835d09b5fc6267b1a78726f1f05fb01" :answer/id #uuid "6bef7bbb-f0a2-575c-9b3e-40e18b3d1979" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-106736/selection/5cd5635e024c66c0c6d4362b5824aee259341d35e0543b26903a8e7dce4028f7" :answer/id #uuid "c06f93de-83d7-5773-a10e-c90f140be779" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,\\frac{5}{2})\\cup (\\frac{5}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-106736/selection/b4ddf9a443c1ebe8cd9a37a375d5efafb6710172215a5f34b265538527b24a11" :answer/id #uuid "17479f34-e99f-5292-847b-2f652612fb8e" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-106736/selection" :answer-field/id #uuid "33e26785-e89e-559b-be8e-e0115e081544" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106736/selection/b4ddf9a443c1ebe8cd9a37a375d5efafb6710172215a5f34b265538527b24a11" :answer-field/choices ["q-106736/selection/25744d83dd5dbdb65636f2eb97794b21bac6de9797033919b4c1a9913918eb0f" "q-106736/selection/364a0fc95f568eeda6b983d9a3400fb16174b6a42553a3e2d14d96e6aa084560" "q-106736/selection/921aa0b9e797e8453202c6424e5a79d68835d09b5fc6267b1a78726f1f05fb01" "q-106736/selection/5cd5635e024c66c0c6d4362b5824aee259341d35e0543b26903a8e7dce4028f7" "q-106736/selection/b4ddf9a443c1ebe8cd9a37a375d5efafb6710172215a5f34b265538527b24a11"] :db/ensure [:answer-field/validate]} {:db/id "q-106736" :question/id #uuid "48eb0f9b-3f8b-5468-b554-83ddaf4810b3" :question/math-academy-id "q-106736" :question/is-example false :question/problem "What is the range of $f(x)=-\\frac{3}{5-2x}-2?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=-2.$ Therefore, the horizontal asymptote is $y=-2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,-2)\\cup (-2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932118/assets/51bdabd83a57cce915c284a27699aa200712b259257c371d9e1f19a4b60fa790.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-106736/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424"] :knowledge-point/questions ["q-106736"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113497/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "fbebfebe-4627-59d0-85cf-2de0d82d0aa2" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-113497/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "b73bd762-ba35-5a16-83b6-60865511a2cd" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-113497/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "27d127ee-2caa-5da8-bef9-c8e648fa86f8" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-113497/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "996866ab-c90b-50d1-93e0-4f8d6594510a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-113497/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "408d4c31-2bab-559a-8dde-449fcd812260" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-113497/selection" :answer-field/id #uuid "3d1db606-86b7-5040-8197-ba216b68e318" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113497/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-113497/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-113497/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-113497/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-113497/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-113497/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-113497" :question/id #uuid "a9abc221-9017-5e9f-8c4a-626f722655fd" :question/math-academy-id "q-113497" :question/is-example false :question/problem "The domain of the function $f(x)=\\frac{4}{kx-3}$ is $(-\\infty ,\\frac{3}{5})\\cup (\\frac{3}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-3 & =0 \\\\ kx & =3 \\\\ x & =\\frac{3}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{3}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{3}{5}$ is excluded from the domain. Equating this to $\\frac{3}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{3}{k} & =\\frac{3}{5} \\\\ k & =\\frac{3\\cdot 5}{3} \\\\ k & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113497/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858"] :knowledge-point/questions ["q-113497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276658/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4c4316b1-83b3-52f5-9c49-df3ee8de986e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-276658/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ab5287ec-640a-5a4c-9069-6cb57e0f0cd6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-276658/field-1" :answer-field/id #uuid "8ffe8070-4c34-5dd5-8d9b-6077ce0cddda" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276658/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-276658/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-276658/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-276658" :question/id #uuid "9ac115e3-97c0-5ded-a3e8-bc682e128884" :question/math-academy-id "q-276658" :question/is-example false :question/problem "If the domain of the function $f(x)=\\frac{3x+7}{4x-12n}$ is $(-\\infty ,6)\\cup (6,\\infty ),$ then $n=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}4x-12n & =0 \\\\ 4x & =12n \\\\ x & =3n.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=3n.$ \n\nOn the other hand, we can see that $x=6$ is excluded from the domain. Equating this to $3n,$ we get\n\n$$\n\\begin{aligned}3n & =6 \\\\ n & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-276658/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858"] :knowledge-point/questions ["q-276658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276679/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8b029b8c-a6bf-5100-af97-dac73abf5a57" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-276679/field-1" :answer-field/id #uuid "4a809de0-d15d-528b-9a22-4afbed20e8c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276679/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-276679/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-276679/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b913d2aa-d607-5191-ad77-e4bff8b384e1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-276679/field-2" :answer-field/id #uuid "9f9994a3-7c3c-599f-ab32-119e1b11dc90" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276679/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-276679/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-276679/field-3/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer/id #uuid "3df1d9a2-8503-51f7-a0d0-74729f86f71c" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "q-276679/field-3" :answer-field/id #uuid "c5c2c716-0696-5c65-9ade-0f1e105e1282" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276679/field-3/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer-field/choices ["q-276679/field-3/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c"] :db/ensure [:answer-field/validate]} {:db/id "q-276679" :question/id #uuid "c8a5825a-f1e1-5240-8fdd-e494d6a6939a" :question/math-academy-id "q-276679" :question/is-example false :question/problem "What is the range of the function $f(x)=\\frac{5}{x+3}+2\\,?$\n\nThe range is\n$f(x)\\in (-\\infty ,$\n{{field-1}}$)\\cup (${{field-2}}$,$\n{{field-3}}$).$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=2.$ Therefore, the horizontal asymptote is $y=2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,2)\\cup (2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932118/assets/abb045c42cc762e74407610e8a082a7e0adfc89374232a911f974762e5aa2db6.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-276679/field-1" "q-276679/field-2" "q-276679/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424"] :knowledge-point/questions ["q-276679"] :db/ensure [:knowledge-point/validate]}]
