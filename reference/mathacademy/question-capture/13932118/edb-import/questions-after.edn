#{[{:db/id #edb/ref 17592186244270 :knowledge-point/_questions [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "498a20a4-97f8-51a2-bbc4-41988fcb3737" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186244272} {:answer/id #uuid "902c7524-1aed-5dec-832e-a1e7cd4d8c9b" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186244273} {:answer/id #uuid "c06f93de-83d7-5773-a10e-c90f140be779" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\frac{5}{2})\\cup (\\frac{5}{2},\\infty )" :db/id #edb/ref 17592186244274} {:answer/id #uuid "6bef7bbb-f0a2-575c-9b3e-40e18b3d1979" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186244275} {:answer/id #uuid "17479f34-e99f-5292-847b-2f652612fb8e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186244276}] :answer-field/correct {:answer/id #uuid "17479f34-e99f-5292-847b-2f652612fb8e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186244276} :answer-field/id #uuid "33e26785-e89e-559b-be8e-e0115e081544" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244271}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "48eb0f9b-3f8b-5468-b554-83ddaf4810b3" :question/is-example false :question/math-academy-id "q-106736" :question/problem "What is the range of $f(x)=-\\frac{3}{5-2x}-2?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=-2.$ Therefore, the horizontal asymptote is $y=-2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,-2)\\cup (-2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932118/assets/51bdabd83a57cce915c284a27699aa200712b259257c371d9e1f19a4b60fa790.png)"}] [{:db/id #edb/ref 17592186244277 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbebfebe-4627-59d0-85cf-2de0d82d0aa2" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186244279} {:answer/id #uuid "408d4c31-2bab-559a-8dde-449fcd812260" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244280} {:answer/id #uuid "996866ab-c90b-50d1-93e0-4f8d6594510a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244281} {:answer/id #uuid "27d127ee-2caa-5da8-bef9-c8e648fa86f8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186244282} {:answer/id #uuid "b73bd762-ba35-5a16-83b6-60865511a2cd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244283}] :answer-field/correct {:answer/id #uuid "b73bd762-ba35-5a16-83b6-60865511a2cd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244283} :answer-field/id #uuid "3d1db606-86b7-5040-8197-ba216b68e318" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244278}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9abc221-9017-5e9f-8c4a-626f722655fd" :question/is-example false :question/math-academy-id "q-113497" :question/problem "The domain of the function $f(x)=\\frac{4}{kx-3}$ is $(-\\infty ,\\frac{3}{5})\\cup (\\frac{3}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-3 & =0 \\\\ kx & =3 \\\\ x & =\\frac{3}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{3}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{3}{5}$ is excluded from the domain. Equating this to $\\frac{3}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{3}{k} & =\\frac{3}{5} \\\\ k & =\\frac{3\\cdot 5}{3} \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244284 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab5287ec-640a-5a4c-9069-6cb57e0f0cd6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244286} {:answer/id #uuid "4c4316b1-83b3-52f5-9c49-df3ee8de986e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244287}] :answer-field/correct {:answer/id #uuid "4c4316b1-83b3-52f5-9c49-df3ee8de986e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244287} :answer-field/id #uuid "8ffe8070-4c34-5dd5-8d9b-6077ce0cddda" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244285}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9ac115e3-97c0-5ded-a3e8-bc682e128884" :question/is-example false :question/math-academy-id "q-276658" :question/problem "If the domain of the function $f(x)=\\frac{3x+7}{4x-12n}$ is $(-\\infty ,6)\\cup (6,\\infty ),$ then $n=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}4x-12n & =0 \\\\ 4x & =12n \\\\ x & =3n.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=3n.$ \n\nOn the other hand, we can see that $x=6$ is excluded from the domain. Equating this to $3n,$ we get\n\n$$\n\\begin{aligned}3n & =6 \\\\ n & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244288 :knowledge-point/_questions [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b029b8c-a6bf-5100-af97-dac73abf5a57" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244290}] :answer-field/correct {:answer/id #uuid "8b029b8c-a6bf-5100-af97-dac73abf5a57" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244290} :answer-field/id #uuid "4a809de0-d15d-528b-9a22-4afbed20e8c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244289} {:answer-field/choices [{:answer/id #uuid "b913d2aa-d607-5191-ad77-e4bff8b384e1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244292}] :answer-field/correct {:answer/id #uuid "b913d2aa-d607-5191-ad77-e4bff8b384e1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244292} :answer-field/id #uuid "9f9994a3-7c3c-599f-ab32-119e1b11dc90" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244291} {:answer-field/choices [{:answer/id #uuid "3df1d9a2-8503-51f7-a0d0-74729f86f71c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186244294}] :answer-field/correct {:answer/id #uuid "3df1d9a2-8503-51f7-a0d0-74729f86f71c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186244294} :answer-field/id #uuid "c5c2c716-0696-5c65-9ade-0f1e105e1282" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244293}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c8a5825a-f1e1-5240-8fdd-e494d6a6939a" :question/is-example false :question/math-academy-id "q-276679" :question/problem "What is the range of the function $f(x)=\\frac{5}{x+3}+2\\,?$\n\nThe range is\n$f(x)\\in (-\\infty ,$\n{{field-1}}$)\\cup (${{field-2}}$,$\n{{field-3}}$).$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=2.$ Therefore, the horizontal asymptote is $y=2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,2)\\cup (2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932118/assets/abb045c42cc762e74407610e8a082a7e0adfc89374232a911f974762e5aa2db6.png)"}] [{:db/id #edb/ref 17592186244295 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e5bedc-b077-5c07-aeb6-c9f74e46350f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)\\cup (5,\\infty )" :db/id #edb/ref 17592186244297} {:answer/id #uuid "e11dde92-734a-5060-940e-a34eeca7db4e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186244298} {:answer/id #uuid "75e59b25-d6be-5f32-bea9-68e27583d91c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5)\\cup (5,\\infty )" :db/id #edb/ref 17592186244299} {:answer/id #uuid "8917a81f-c631-584a-a730-77e5f199b685" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (5,\\infty )" :db/id #edb/ref 17592186244300} {:answer/id #uuid "338c04ec-c684-5375-95a6-556a382f6e9b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-0)\\cup (0,\\infty )" :db/id #edb/ref 17592186244301}] :answer-field/correct {:answer/id #uuid "11e5bedc-b077-5c07-aeb6-c9f74e46350f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)\\cup (5,\\infty )" :db/id #edb/ref 17592186244297} :answer-field/id #uuid "00c82b8f-257e-5b18-a61a-a186fa5e0ea6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "748d3aac-95ca-55c7-80f0-ef3cf5eeb0de" :question/is-example false :question/math-academy-id "q-71136" :question/problem "What is the domain of the function $f(x)=\\frac{1}{x-5}-2?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}x-5 & =0 \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,5)\\cup (5,\\infty ).$"}]}
