              "type": "math",
              "value": "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{6} & 1 & 0 \\\\ -\\frac{1}{3} & 0 & 1\\end{aligned}]",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}1 & \\frac{1}{6} & \\frac{1}{3} \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]",
              "option": "1",
              "source_option": "b"
