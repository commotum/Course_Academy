#{[{:db/id #edb/ref 17592186294258 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fb6c44-5d1c-548d-b12a-c2d42c762c26" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 6 & 49\\end{aligned}]" :db/id #edb/ref 17592186294260} {:answer/id #uuid "7bee1c28-a017-513f-aec8-d20f4a003bf7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 6 & 9\\end{aligned}]" :db/id #edb/ref 17592186294261} {:answer/id #uuid "0388cfc5-c8d1-5fc5-9831-f028d3cb6239" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-49 & -8 \\\\ 6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294262} {:answer/id #uuid "50b87d23-088b-577f-87fa-71e62dd568a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294263} {:answer/id #uuid "1ff4399e-ed7b-55f3-a569-294cd45859c7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -8 \\\\ -6 & 49\\end{aligned}]" :db/id #edb/ref 17592186294264}] :answer-field/correct {:answer/id #uuid "50b87d23-088b-577f-87fa-71e62dd568a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186294263} :answer-field/id #uuid "6c833db1-4dfe-5b56-8c61-d74f13993f47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294259}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4a1381b5-29b5-5930-b404-a382cf590fc1" :question/math-academy-id "q-130807" :question/problem "Find the product ${E}_{1}^{-1}{E}_{2}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 8 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{1}^{-1}.$ We write down ${E}_{1}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{1}\\,|\\,I\\,] & =[\\begin{aligned}1 & 8 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+(-8){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -8 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{1}^{-1}=[\\begin{aligned}1 & -8 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}^{-1}{E}_{2}:$\n\n$$\n{E}_{1}^{-1}{E}_{2}=[\\begin{aligned}1 & -8 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}]=[\\begin{aligned}49 & -8 \\\\ -6 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186311021 :knowledge-point/_questions [{:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d" :knowledge-point/title "Inverting a Frobenius Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b25f38b-636f-5de0-9797-eccc6742c19c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311023} {:answer/id #uuid "84719427-b4e8-59d4-b969-c3e635109c07" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{6} & 1 & 0 \\\\ -\\frac{1}{3} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311024} {:answer/id #uuid "1335d27f-d44b-58a8-b586-dbffda46877b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{6} & 1 & 0 \\\\ \\frac{1}{3} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311025} {:answer/id #uuid "8a80d01f-3d07-50bc-84c7-70282935a7e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311026} {:answer/id #uuid "2f4e4587-c1cc-5bcb-b0a6-b223c3c8e9e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\frac{1}{6} & \\frac{1}{3} \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311027}] :answer-field/correct {:answer/id #uuid "8a80d01f-3d07-50bc-84c7-70282935a7e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186311026} :answer-field/id #uuid "7c09309c-f061-569e-8c77-bf6cc59031c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311022}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7852050f-67a6-578c-976b-548dc012848b" :question/math-academy-id "q-135395" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 6 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -6 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360497 :knowledge-point/_questions [{:knowledge-point/id #uuid "36986a18-172c-5983-8f6f-3211b6e8f89d" :knowledge-point/title "Finding the Radius of Curvature of a Plane Curve Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c571bc2-35c7-570d-a288-b1a921ab5fc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{5}}{5}" :db/id #edb/ref 17592186360499} {:answer/id #uuid "73de1ff4-ee8d-51cf-91a8-0c042cc2db9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186360500} {:answer/id #uuid "c7866a8d-9be9-5327-b333-d494ad8459d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{5}}{6}" :db/id #edb/ref 17592186360501} {:answer/id #uuid "880393eb-753a-546c-9dc4-dfe6e16927c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186360502} {:answer/id #uuid "d81299ca-c205-557f-92d3-4842f71314a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{5}" :db/id #edb/ref 17592186360503}] :answer-field/correct {:answer/id #uuid "c7866a8d-9be9-5327-b333-d494ad8459d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{5}}{6}" :db/id #edb/ref 17592186360501} :answer-field/id #uuid "5012f3a7-3b63-5e7e-b09a-8167a80cfe4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360498}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "49e5c10d-6a90-5598-9eca-de58bdca7cbe" :question/math-academy-id "q-162403" :question/problem "Find the radius of the curvature for the curve $r(t)=⟨{e}^{2t},\\,{e}^{-t}⟩$ at $t=0.$" :question/worked-solution "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)={e}^{2t},\\,y(t)={e}^{-t}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2{e}^{2t},\\, & {y}^{′}(t) & =-{e}^{-t} \\\\ {x}^{″}(t) & =4{e}^{2t},\\, & {y}^{″}(t) & ={e}^{-t}\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2{e}^{2t}\\cdot {e}^{-t}-(-{e}^{-t})\\cdot 4{e}^{2t}|}{{((2{e}^{2t})^{2}+(-{e}^{-t})^{2})}^{3/2}} \\\\  & =\\frac{6{e}^{t}}{{(4{e}^{4t}+{e}^{-2t})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{6{e}^{(0)}}{{(4{e}^{4(0)}+{e}^{-2(0)})}^{3/2}} \\\\  & =\\frac{6}{{5}^{3/2}} \\\\  & =\\frac{6}{5\\sqrt{5}}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=\\frac{5\\sqrt{5}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294580 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c812adc-7418-5a76-9c7f-96c726c7ca0e" :knowledge-point/title "Finding the Maximum Speed of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8af1a7f0-21ea-599e-8ae4-8c70b697fdc3" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,m/s" :db/id #edb/ref 17592186294582} {:answer/id #uuid "0fd70fd7-4169-593d-b17d-6524c8aa73d3" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,m/s" :db/id #edb/ref 17592186294583} {:answer/id #uuid "99bea051-55e3-5f06-9ebe-be38839b0a5a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\,m/s" :db/id #edb/ref 17592186294584} {:answer/id #uuid "97e80f02-5fc0-5dbe-8691-00ee2ab26405" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{13}\\,m/s" :db/id #edb/ref 17592186294585} {:answer/id #uuid "cc59692d-8e56-544e-8518-ed211520a029" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{6}\\,m/s" :db/id #edb/ref 17592186294586}] :answer-field/correct {:answer/id #uuid "97e80f02-5fc0-5dbe-8691-00ee2ab26405" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{13}\\,m/s" :db/id #edb/ref 17592186294585} :answer-field/id #uuid "9bfa03b0-59e8-5335-aa32-e5c6bb8083d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294581}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c0d1d1a5-d9cb-5570-acc7-da72657b9a2b" :question/math-academy-id "q-163548" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin is $x\\,m,$ the velocity is $v\\,m/s,$ and the acceleration is $(4-x)\\,{m/s}^{2}.$ If $P$ has velocity $v=6\\,m/s$ at the origin, find the maximum velocity of the particle." :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/d4e5b78932f8ff6155ac81e12538eb31ac211c9d27d6a2b0c67542527ccd3b2a.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(4-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4-x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}4-x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=4-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (4-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=4x-\\frac{1}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =4(0)-\\frac{1}{2}(0)^{2}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+18 \\\\ {v}^{2} & =8x-{x}^{2}+36 \\\\ v & =\\pm \\sqrt{-{x}^{2}+8x+36}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+8x+36}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-(4)^{2}+8(4)+36}=2\\sqrt{13}\\,m/s\n$$"}] [{:db/id #edb/ref 17592186364969 :knowledge-point/_questions [{:knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96" :knowledge-point/title "Evaluating a Hessian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4223c84a-633e-5d34-ae57-21c4f7de5091" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186364971} {:answer/id #uuid "02349ac6-0b22-5fb1-8e57-19399fecf3f4" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186364972} {:answer/id #uuid "e27acc18-d276-599f-b725-1840f8eb24ca" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186364973} {:answer/id #uuid "b4f1b36e-b82e-52a3-99d4-bd6f57fbe987" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186364974} {:answer/id #uuid "2a0c6bec-1135-5071-931f-2dc14d4eb0b2" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186364975}] :answer-field/correct {:answer/id #uuid "e27acc18-d276-599f-b725-1840f8eb24ca" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186364973} :answer-field/id #uuid "6aae77dd-804e-5791-9b66-5a8e698e4c7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364970}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2c30dd99-4223-5fc5-b0a9-d42d9d800191" :question/math-academy-id "q-163642" :question/problem "Given that \n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=4xy-3{y}^{2},\\,\\frac{∂f}{∂y}=2{x}^{2}-6xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4xy-3{y}^{2})=4y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2{x}^{2}-6xy)=4x-6y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(4xy-3{y}^{2})=4x-6y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2{x}^{2}-6xy)=-6x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}4y & 4x-6y \\\\ 4x-6y & -6x\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=[\\begin{aligned}4 & -2 \\\\ -2 & -6\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,1)=4\\cdot (-6)-(-2)\\cdot (-2)=-28.\n$$"}] [{:db/id #edb/ref 17592186365717 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19cc766-bdc5-5ab2-aa4d-ebddf8311116" :knowledge-point/title "Approximating a Multivariable Function at a Point Using a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "625252f5-70b7-5519-8288-50aa0773fcdb" :answer/type {:db/ident :answer.type/math} :answer/value "55" :db/id #edb/ref 17592186365719} {:answer/id #uuid "6ef8257a-155e-5b88-a037-e88562d62ddd" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186365720} {:answer/id #uuid "61974dae-c296-55f0-922e-a3ba72c070d2" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186365721} {:answer/id #uuid "9f4abef3-6f17-5e7c-b416-d7da97b7c2eb" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186365722} {:answer/id #uuid "367ee035-9424-5179-adb4-74c4e4ded90c" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186365723}] :answer-field/correct {:answer/id #uuid "61974dae-c296-55f0-922e-a3ba72c070d2" :answer/type {:db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186365721} :answer-field/id #uuid "3b91bd78-5134-55ef-bafc-4c63534b5298" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186365718}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "64cc5ba2-54af-56a0-8677-64acabcf0828" :question/math-academy-id "q-164831" :question/problem "For the twice-differentiable function $f:{R}^{2}\\to R,$ we have the following data:\n\n$$\n\\begin{aligned}f(0,0) & =5, & \\,{f}^{′}(0,0) & =[\\begin{aligned}1 & 2\\end{aligned}], & \\,{f}^{″}(0,0) & =[\\begin{aligned}2 & 4 \\\\ 4 & 1\\end{aligned}]\\end{aligned}\n$$\n\nUse the quadratic Taylor polynomial of $f$ about $a=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to approximate the value of $f(2,2).$" :question/worked-solution "Suppose that the function $f:{R}^{n}\\to R$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶z\n$$\n\n \n\nand is twice differentiable at $x=a.$ Then, the quadratic Taylor polynomial of $f$ about $a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere\n\n$$\n{f}^{′}(a)={[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have $a=[\\begin{aligned}0 \\\\ 0\\end{aligned}],$ and the following data:\n\n$$\n\\begin{aligned}f(a) & =5, & \\,{f}^{′}(a) & =[\\begin{aligned}1 & 2\\end{aligned}], & \\,{f}^{″}(a) & =[\\begin{aligned}2 & 4 \\\\ 4 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈5+[\\begin{aligned}1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x \\\\ y\\end{aligned}]}^{T}[\\begin{aligned}2 & 4 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nFinally, evaluating the polynomial at $x=[\\begin{aligned}2 \\\\ 2\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(2,2) & ≈5+[\\begin{aligned}1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}2 \\\\ 2\\end{aligned}]}^{T}[\\begin{aligned}2 & 4 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =5+[\\begin{aligned}1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}2 \\\\ 2\\end{aligned}]}^{T}[\\begin{aligned}2 & 4 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 2\\end{aligned}] \\\\  & =5+6+\\frac{1}{2}[\\begin{aligned}2 & 2\\end{aligned}][\\begin{aligned}12 \\\\ 10\\end{aligned}] \\\\  & =11+\\frac{1}{2}(44) \\\\  & =33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320370 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8dc2b61-3e0a-5e73-83df-04cc621d5feb" :knowledge-point/title "Solving a First-Order ODE Using a Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f19dadc-9a47-59fe-8d57-14ca9a0f095a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{1+C{e}^{x}}" :db/id #edb/ref 17592186320372} {:answer/id #uuid "59ca6c49-6b6b-5efa-9d96-1f6004f090cc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{-1}{1+C{e}^{x}}" :db/id #edb/ref 17592186320373} {:answer/id #uuid "f814935a-3005-55a2-aacc-7b2a0929f3ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{x+C}" :db/id #edb/ref 17592186320374} {:answer/id #uuid "58d16a85-9e04-5f05-b7d5-8cf620b3a60b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{-1+Cx}" :db/id #edb/ref 17592186320375} {:answer/id #uuid "197b642a-007d-568a-ab5d-e44698445089" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{-1+C{e}^{x}}" :db/id #edb/ref 17592186320376}] :answer-field/correct {:answer/id #uuid "6f19dadc-9a47-59fe-8d57-14ca9a0f095a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{1+C{e}^{x}}" :db/id #edb/ref 17592186320372} :answer-field/id #uuid "98047d80-b5b5-5e6e-82bb-eb5ebd0f6a0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320371}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "23f7cb90-301b-5baf-815d-3ddcf267e164" :question/math-academy-id "q-17552" :question/problem "Find the general solution to the following equation.\n\n$$\n\\frac{dy}{dx}={y}^{2}-y\n$$\n\n*Hint: You may wish to make use of the substitution* $z={y}^{-1}.$" :question/worked-solution "First, we make the substitution\n\n$$\nz={y}^{-1}\\,⟹\\,y={z}^{-1}\\,\n$$\n\nDifferentiating $z(x)$ with the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=-\\frac{1}{{y}^{2}}\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{{z}^{2}}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nConsequently, the original differential equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{{z}^{2}}\\,\\frac{\\text{d}z}{\\text{d}x} & =\\frac{1}{{z}^{2}}-\\frac{1}{z} \\\\ -\\frac{\\text{d}z}{\\text{d}x} & =1-z\\end{aligned}\n$$\n\nThis differential equation is linear, so we can use the method of integrating factors. First, we write the above equation in standard form:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x} & =-1+z \\\\ \\frac{\\text{d}z}{\\text{d}x}-z & =-1\\end{aligned}\n$$\n\nThe above equation is in the standard form\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}+P(x)z=Q(x)\n$$\n\nwith\n\n$$\n\\begin{aligned}P(x)=-1,\\,Q(x)=-1\\,.\\end{aligned}\n$$\n\nWe then compute an integrating factor:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int (-1)\\,\\text{d}x} \\\\  & ={e}^{-x}\\end{aligned}\n$$\n\nMultiplying both sides of the standard form equation by $I(x)={e}^{-x}$ yields:\n\n$$\n\\begin{aligned}{e}^{-x}\\cdot (\\frac{dz}{dx}-z) & ={e}^{-x}\\cdot (-1) \\\\ {e}^{-x}\\frac{dz}{dx}-{e}^{-x}z & =-{e}^{-x} \\\\ \\frac{d}{dx}(z{e}^{-x}) & =-{e}^{-x}\\,.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{d}{dx}(z{e}^{-x})\\,dx\\, & =-\\int {e}^{-x}\\,dx \\\\ z{e}^{-x} & ={e}^{-x}+C \\\\ z & =1+C{e}^{x}\\end{aligned}\n$$\n\nFinally, we determine $y(x)$ by writing $z={y}^{-1}.$ This results in\n\n$$\n\\begin{aligned}{y}^{-1} & =1+C{e}^{x} \\\\ y & =\\frac{1}{1+C{e}^{x}}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325548 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbefb3bb-4783-5d77-b404-1f43ee8765de" :knowledge-point/title "Identifying Cases Where Differentiating Under the Integral Sign Applies"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43d32bc2-4073-5381-b98a-567bc2a48223" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186325550} {:answer/id #uuid "67d4f15c-1970-5c8f-9633-9d0d2238c0a9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186325551} {:answer/id #uuid "fc69be5c-c48c-5ba0-97b7-1eb82db7b44c" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186325552} {:answer/id #uuid "f9ef9151-5076-5e05-b513-372963712e9e" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186325553} {:answer/id #uuid "55f9ef50-b404-5db7-8f65-687d158f834f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186325554}] :answer-field/correct {:answer/id #uuid "55f9ef50-b404-5db7-8f65-687d158f834f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186325554} :answer-field/id #uuid "6c173abd-1245-5684-a5f3-018c5be6619b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186325549}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2025eb0b-c186-520b-9049-e64b856c84a6" :question/math-academy-id "q-335251" :question/problem "For which of the following functions is it valid to differentiate under the integral sign?\n\n- ${F}_{1}(t)={\\int }_{0}^{1}\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}\\,\\text{d}x,\\,t\\in (-1,1)$\n- ${F}_{2}(t)={\\int }_{0}^{1}\\frac{1}{x-t}\\,\\text{d}x,\\,t\\in (1,2)$\n- ${F}_{3}(t)={\\int }_{0}^{1}\\frac{1}{\\sqrt{|x-t|}}\\,\\text{d}x,\\,t\\in (0,1)$" :question/worked-solution "Suppose $f(x,t)$ is continuous on $R=[a,b]\\times [c,d]$ and $\\frac{∂f}{∂t}$ exists and is continuous on $R.$ Then, the function\n\n$$\nF(t)={\\int }_{a}^{b}f(x,t)\\,\\text{d}x\n$$\n\nis differentiable on $(c,d),$ and\n\n$$\n{F}^{′}(t)=\\frac{\\text{d}}{\\text{d}t}{\\int }_{a}^{b}f(x,t)\\,\\text{d}x={\\int }_{a}^{b}\\frac{∂f}{∂t}(x,t)\\,\\text{d}x.\n$$\n\nThis is known as *differentiating under the integral sign.*\n\nWith that in mind, let's check each function:\n\n- For the first function, we have \n\n$$\n{f}_{1}(x,t)=\\frac{\\operatorname{ln}⁡(1+tx)}{1+{x}^{2}}.\n$$\n\nWe fix ${t}_{0}\\in (-1,1)$ and choose $[c,d]⊂(-1,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{1}$ is continuous on $R$ (since $1+tx>0$). Computing the  partial derivative, we have\n\n$$\n\\frac{∂{f}_{1}}{∂t}=\\frac{x}{(1+tx)(1+{x}^{2})}\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{1}^{′}(t)$ for all $t\\in (-1,1).$\n\n- For the second function, we have \n\n$$\n{f}_{2}(x,t)=\\frac{1}{x-t}.\n$$\n\nWe fix ${t}_{0}\\in (1,2)$ and choose $[c,d]⊂(1,2)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that ${f}_{2}$ is continuous on $R$ (since the denominator never vanishes on $R$). Computing the partial derivative, we have\n\n$$\n\\frac{∂{f}_{2}}{∂t}=\\frac{1}{(x-t)^{2}},\n$$\n\nwhich exists and is continuous on $R.$ Thus, differentiating under the integral sign is valid at ${t}_{0}.$ And since our choice of ${t}_{0}$ was arbitrary, we can compute ${F}_{2}^{′}(t)$ for all $t\\in (1,2).$\n\n- For the third function, we have \n\n$$\n{f}_{3}(x,t)=\\frac{1}{\\sqrt{|x-t|}}.\n$$\n\nWe fix ${t}_{0}\\in (0,1)$ and choose $[c,d]⊂(0,1)$ such that $c<{t}_{0}<d,$ so $R=[0,1]\\times [c,d].$\n\nNote that this function is undefined when $x=t,$ since the denominator vanishes. Thus, ${f}_{3}$ is not continuous on $R,$ and differentiating under the integral sign is *not* valid.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186294659 :knowledge-point/_questions [{:knowledge-point/id #uuid "11810d4b-610c-5dac-8fe7-abf9391c2aa7" :knowledge-point/title "Calculating the Distance Between Two Objects"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ece31cc5-4493-571f-be4f-43a27342195e" :answer/type {:db/ident :answer.type/math} :answer/value "4.8" :db/id #edb/ref 17592186294661}] :answer-field/correct {:answer/id #uuid "ece31cc5-4493-571f-be4f-43a27342195e" :answer/type {:db/ident :answer.type/math} :answer/value "4.8" :db/id #edb/ref 17592186294661} :answer-field/id #uuid "cfb1e79f-7789-5ee9-8707-8979eaf696ae" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294660} {:answer-field/choices [{:answer/id #uuid "0c18ce72-f6b8-5ce2-bf10-d7edc42cee9c" :answer/type {:db/ident :answer.type/math} :answer/value "10^{2}" :db/id #edb/ref 17592186294663}] :answer-field/correct {:answer/id #uuid "0c18ce72-f6b8-5ce2-bf10-d7edc42cee9c" :answer/type {:db/ident :answer.type/math} :answer/value "10^{2}" :db/id #edb/ref 17592186294663} :answer-field/id #uuid "7c91fc5c-380e-5e71-92bf-b258b18e1dfa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294662}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "386b24bd-3eff-5335-834a-d78cada3240c" :question/math-academy-id "q-336300" :question/problem "The gravitational force between two objects, of masses $(4.5\\times {10}^{6})\\,\\text{kg}$ and $(2.8\\times {10}^{6})\\,\\text{kg},$ has a magnitude of $(3.6\\times {10}^{-3})\\,\\text{N}.$\nAccording to Newton's law of universal gravitation, what is the distance between the centers of mass of the two objects? Write your answer in scientific notation, rounding to **two significant figures** where appropriate. Assume the Newtonian constant of gravitation is $G=(6.67\\times {10}^{-11})\\,{\\text{m}}^{3}/(\\text{kg}\\cdot {\\text{s}}^{2}).$\n\nThe distance between the two objects is\n$(${{field-1}}\n$\\times $\n{{field-2}}$)\\,\\text{m}.$" :question/worked-solution "Newton's law of universal gravitation states that the gravitational force attracting two objects is proportional to the product of the two masses and inversely proportional to the square of the distance between their centers of mass:\n\n$$\nF=G\\frac{{m}_{1}{m}_{2}}{{r}^{2}}\n$$\n\nwhere\n\n- $F$ is the gravitational force between the objects, measured in Newtons $(\\text{N}),$\n\n- $G=(6.67\\times {10}^{-11})\\,{\\text{m}}^{3}/(\\text{kg}\\cdot {\\text{s}}^{2})$ is the Newtonian constant of gravitation,\n\n- ${m}_{1}$ and ${m}_{2}$ are the masses of the objects, measured in $\\text{kg},$ and\n\n- $r$ is the distance between their centers of mass, measured in $\\text{m}.$\n\nFirst, let's rearrange the formula to make $r$ the subject:\n\n$$\n\\begin{aligned}F & =G\\frac{{m}_{1}{m}_{2}}{{r}^{2}} \\\\ {r}^{2} & =G\\frac{{m}_{1}{m}_{2}}{F} \\\\ r & =\\sqrt{G\\frac{{m}_{1}{m}_{2}}{F}}\\end{aligned}\n$$\n\nChoosing ${m}_{1}=(4.5\\times {10}^{6})\\,\\text{kg}$ and ${m}_{2}=(2.8\\times {10}^{6})\\,\\text{kg}$ and substituting in the other known values, we have\n\n$$\n\\begin{aligned}{r}^{2} & =(6.67\\times {10}^{-11})\\cdot \\frac{(4.5\\times {10}^{6})\\cdot (2.8\\times {10}^{6})}{3.6\\times {10}^{-3}} \\\\  & =\\frac{6.67\\cdot 4.5\\cdot 2.8}{3.6}\\times \\frac{{10}^{-11}\\cdot {10}^{6}\\cdot {10}^{6}}{{10}^{-3}} \\\\  & =23.345\\times {10}^{4}.\\end{aligned}\n$$\n\nFinally, taking the square root, we get\n\n$$\n\\begin{aligned}r & =\\sqrt{23.345\\times {10}^{4}} \\\\  & =\\sqrt{23.345}\\times \\sqrt{{10}^{4}} \\\\  & =(4.8316…)\\times {10}^{2}.\\end{aligned}\n$$\n\nTherefore, rounded to two significant figures, the distance between the two objects is\n$(\\,4.8\\times {10}^{2}\\,)\\,\\text{m}.$"}] [{:db/id #edb/ref 17592186120206 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2a445fa-d44b-574a-8369-b30cac3a3c96" :knowledge-point/title "Calculating the Shortest Distance Between an Osculating Plane and the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90dafe4a-c60d-5a22-af27-196cd1b848ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4π}{3}" :db/id #edb/ref 17592186117737} {:answer/id #uuid "ed925136-3220-53c2-a267-e958a9402525" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186117738} {:answer/id #uuid "2208379e-c8da-5db5-85d1-059ea5abbb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4π}{5}" :db/id #edb/ref 17592186117739} {:answer/id #uuid "3248ef06-0e12-5038-a0e6-b5dffde6689c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186117740} {:answer/id #uuid "5de8357e-540b-5140-a3e5-e922a03973a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5π}{3}" :db/id #edb/ref 17592186117741}] :answer-field/correct {:answer/id #uuid "2208379e-c8da-5db5-85d1-059ea5abbb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4π}{5}" :db/id #edb/ref 17592186117739} :answer-field/id #uuid "f732a7f2-a1d9-599e-865c-b4a9cb818912" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117736}] :question/id #uuid "5eba7f51-df52-5732-a9c9-7fd19c4deaa0" :question/math-academy-id "q-33732" :question/problem "Find the shortest distance between the origin and the osculating plane for the curve $r(t)$ at the point where $t = \\frac{π}{3}$, given that\n$r(t)|= ⟨\\cos 3t, 4t,-\\sin 3t⟩; T(t)|= \\frac{1}{5}⟨ - 3\\sin 3t, 4,-3\\cos 3t⟩; N(t)|= ⟨ - \\cos 3t, 0, \\sin 3t⟩$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively."}] [{:db/id #edb/ref 17592186294667 :knowledge-point/_questions [{:knowledge-point/id #uuid "55abc561-2d1a-5da7-80f0-f52ea8c1bc3b" :knowledge-point/title "Finding the Orthogonal Trajectories of a One-Parameter Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6e8a51f-03c5-59c0-b027-d554459af78c" :answer/type {:db/ident :answer.type/math} :answer/value "x=Ky" :db/id #edb/ref 17592186294669} {:answer/id #uuid "712138d7-e620-5be5-b342-8a3843ff1257" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=K" :db/id #edb/ref 17592186294670} {:answer/id #uuid "88282ac6-c4c6-50a3-a829-eed1fc5efb79" :answer/type {:db/ident :answer.type/math} :answer/value "y=Kx" :db/id #edb/ref 17592186294671} {:answer/id #uuid "a0f73c9d-7bbc-5af3-8bdc-37f401b89654" :answer/type {:db/ident :answer.type/math} :answer/value "xy=K" :db/id #edb/ref 17592186294672} {:answer/id #uuid "8a6daef7-cda8-562b-b48f-730cd7e06337" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}+K" :db/id #edb/ref 17592186294673}] :answer-field/correct {:answer/id #uuid "8a6daef7-cda8-562b-b48f-730cd7e06337" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}+K" :db/id #edb/ref 17592186294673} :answer-field/id #uuid "5bca0655-c64d-5fdc-9b72-2e0dc772b824" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294668}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "494759ac-e110-5f70-93f7-3b6af7555034" :question/math-academy-id "q-337570" :question/problem "Find the orthogonal trajectories of the family of curves $xy=C,$ where $C$ and $K$ are parameters." :question/worked-solution "Orthogonal trajectories are families of curves that intersect another given family of curves at right angles. In other words, the tangent lines of curves from each family are perpendicular at every intersection point.\n\nLet's determine the slope of the family of curves given by $xy=C.$ First, we implicitly differentiate with respect to $x$ and solve for the derivative of $y:$\n\n$$\n\\begin{aligned}\\frac{d}{dx}(xy) & =\\frac{d}{dx}(C) \\\\ y+x{y}^{′} & =0 \\\\ x{y}^{′} & =-y \\\\ {y}^{′} & =-\\frac{y}{x}\\end{aligned}\n$$\n\nNote that the parameter $C$ has already been eliminated.\n\nFor a curve to intersect this family orthogonally, its slope ${y}_{⊥}^{′}$ must be the negative reciprocal of the slope ${y}^{′}$ above. Hence,\n\n$$\n{y}_{⊥}^{′}=-\\frac{1}{{y}^{′}}=-\\frac{1}{(-\\frac{y}{x})}=\\frac{x}{y}.\n$$\n\nHence, the orthogonal trajectories must satisfy\n\n$$\n\\frac{dy}{dx}=\\frac{x}{y}.\n$$\n\nTo find the general solution, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}y\\cdot \\frac{dy}{dx} & =x \\\\ \\int y\\cdot \\frac{dy}{dx}\\,dx & =\\int x\\,dx \\\\ \\int y\\,dy & =\\int x\\,dx \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+{K}_{1} \\\\ {y}^{2} & ={x}^{2}+K\\end{aligned}\n$$\n\nNote that $K=2{K}_{1}$ is a constant of integration.\n\nTherefore, the orthogonal trajectories of the family of curves $xy=C,$ where $C$ is a parameter, are given by\n\n$$\n{y}^{2}={x}^{2}+K,\n$$\n\nwhere $K$ is a parameter. Some curves from each family for specific parameter values are given in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/98159dfb60fd280468ad8165475b5ba58e41658174a932b4c9555ef1153a577c.png)\n\n**Note**: For the slopes ${y}^{′}$ and ${y}_{⊥}^{′},$ we divide by $x$ and $y,$ respectively. So, the orthogonal trajectories are only defined on the region $x,y\\ne 0.$"}] [{:db/id #edb/ref 17592186294719 :knowledge-point/_questions [{:knowledge-point/id #uuid "734fe467-57d6-5b3f-a61e-1e2e4624b5fc" :knowledge-point/title "Using Abel's Identity to Conclude Independence/Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6e05566-95b8-564c-9cfc-913d0f6fa03b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186294721} {:answer/id #uuid "df881ed4-b6ec-5b5a-89cf-5b98f3e117ba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{Q(x)}{{x}^{2}+1}" :db/id #edb/ref 17592186294722} {:answer/id #uuid "f5b052f0-e079-5c09-bd11-7e534e01b874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+1}{Q(x)}" :db/id #edb/ref 17592186294723} {:answer/id #uuid "e91d7c62-251e-57d9-8ed3-113e72949674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186294724}] :answer-field/correct {:answer/id #uuid "e91d7c62-251e-57d9-8ed3-113e72949674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186294724} :answer-field/id #uuid "31d63072-94ae-5b91-9e6e-8feb402b4ae9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186294720} {:answer-field/choices [{:answer/id #uuid "dbdb9a95-ba14-5e69-9187-8655c2d40495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{C}{{x}^{2}+1}" :db/id #edb/ref 17592186294726} {:answer/id #uuid "b303f4f7-2d61-5f92-b2e2-3604679f8f09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{C}{{e}^{x}}" :db/id #edb/ref 17592186294727} {:answer/id #uuid "a30010e8-ab17-5838-a398-d794b51a0505" :answer/type {:db/ident :answer.type/math} :answer/value "C{e}^{\\operatorname{arctan}⁡(x)}" :db/id #edb/ref 17592186294728} {:answer/id #uuid "7b8631c6-9ee6-53b3-ac9b-dc359c495d85" :answer/type {:db/ident :answer.type/math} :answer/value "C{e}^{-\\operatorname{arctan}⁡(x)}" :db/id #edb/ref 17592186294729}] :answer-field/correct {:answer/id #uuid "7b8631c6-9ee6-53b3-ac9b-dc359c495d85" :answer/type {:db/ident :answer.type/math} :answer/value "C{e}^{-\\operatorname{arctan}⁡(x)}" :db/id #edb/ref 17592186294729} :answer-field/id #uuid "ae983504-8e5c-5bc8-839c-eb1f0e78a6d8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186294725} {:answer-field/choices [{:answer/id #uuid "d417faed-38a1-5dca-a375-e4508e2e18e1" :answer/type {:db/ident :answer.type/text} :answer/value "$W(x)\\ne 0$ for all $x\\in R$" :db/id #edb/ref 17592186294731} {:answer/id #uuid "cd9c5e01-1b30-5a5b-bde4-df7c8649e36f" :answer/type {:db/ident :answer.type/text} :answer/value "$W(x)=0$ for all $x\\in R$" :db/id #edb/ref 17592186294732} {:answer/id #uuid "fdfdb94a-0599-5e19-8202-e3d36c030c40" :answer/type {:db/ident :answer.type/text} :answer/value "$W(x)=0$ for some but not all $x\\in R$" :db/id #edb/ref 17592186294733}] :answer-field/correct {:answer/id #uuid "d417faed-38a1-5dca-a375-e4508e2e18e1" :answer/type {:db/ident :answer.type/text} :answer/value "$W(x)\\ne 0$ for all $x\\in R$" :db/id #edb/ref 17592186294731} :answer-field/id #uuid "69f067df-2c92-5450-9de2-4a884870ae7f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186294730}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "736a842a-a005-5f7c-a75f-80d3e3e641b7" :question/math-academy-id "q-343302" :question/problem "$$\n{y}^{″}+\\frac{1}{{x}^{2}+1}{y}^{′}+Q(x)y=0\n$$\n\nLet ${y}_{1}$ and ${y}_{2}$ be solutions to the second-order homogeneous differential equation above, where $Q(x)$ is continuous on $(-\\infty ,\\infty ).$ The Wronskian satisfies $W(0)=2.$ Select the correct options in the reasoning below.\nThe Wronskian $W(x)$ satisfies the following first-order differential equation:\n\n$$\n-\\frac{1}{{x}^{2}+1}\n$$\n\nSolving this equation, we get\n\n$$\nC{e}^{\\operatorname{arctan}⁡(x)}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nNow, using the fact that $W(0)=2,$ we obtain \n{{field-3}}." :question/worked-solution "Abel's identity says that if ${y}_{1}$ and ${y}_{2}$ are solutions of\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=0,\n$$\n\nthen their Wronskian $W(x)$ satisfies\n\n$$\n{W}^{′}(x)=-P(x)W(x).\n$$\n\nIn our equation, the coefficient of ${y}^{′}$ is \n\n$$\nP(x)=\\frac{1}{{x}^{2}+1}.\n$$\n\nSubstituting into Abel's identity gives\n\n$$\n{W}^{′}(x)=-\\frac{1}{{x}^{2}+1}W(x).\n$$\n\nNow, we solve the first-order differential equation for $W:$\n\n$$\n\\begin{aligned}{W}^{′} & =-\\frac{1}{{x}^{2}+1}W \\\\ \\frac{\\text{d}W}{W} & =-\\frac{1}{{x}^{2}+1}\\text{d}x \\\\ \\int \\frac{\\text{d}W}{W} & =\\int -\\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|W| & =-\\operatorname{arctan}⁡(x)+K \\\\ |W| & ={e}^{K}{e}^{-\\operatorname{arctan}⁡(x)} \\\\ W & =C{e}^{-\\operatorname{arctan}⁡(x)}\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nNext, we use the given value $W(0)=2$ to find $C:$\n\n$$\n\\begin{aligned}W(0) & =C{e}^{-\\operatorname{arctan}⁡(0)} \\\\ 2 & =C\\end{aligned}\n$$\n\nTherefore, we have $W(x)\\ne 0\\text{ for all }x\\in R.$"}] [{:db/id #edb/ref 17592186294741 :knowledge-point/_questions [{:knowledge-point/id #uuid "90458c6e-3d72-5235-a1c0-627fe4fd2855" :knowledge-point/title "Reconstructing a Three-Variable Function From Its Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23f90c55-cb3e-5e62-bc60-f164febd0b2e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)=\\operatorname{sin}⁡(2x)+y{z}^{2}+C" :db/id #edb/ref 17592186294743} {:answer/id #uuid "feadf2cc-2fc5-5249-bd32-86e9aa39b5bc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)={cos}^{2}⁡(2x)+2yz+C" :db/id #edb/ref 17592186294744} {:answer/id #uuid "ef66f3d1-c36f-5352-bab1-49341b797fbb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+C" :db/id #edb/ref 17592186294745} {:answer/id #uuid "3d9e840b-18d7-5ddc-b240-a471593eba06" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)=\\operatorname{cos}⁡(2x)+yz+C" :db/id #edb/ref 17592186294746} {:answer/id #uuid "457428cc-98f3-5ea0-aca9-79cb1f0e72ed" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)={sin}^{2}⁡(2x)+2{y}^{2}z+C" :db/id #edb/ref 17592186294747}] :answer-field/correct {:answer/id #uuid "ef66f3d1-c36f-5352-bab1-49341b797fbb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+C" :db/id #edb/ref 17592186294745} :answer-field/id #uuid "60c5e6c4-7dc7-56e4-97c0-75ffef545d48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294742}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f48dae94-b20d-5d85-9a71-53e264ee506a" :question/math-academy-id "q-36978" :question/problem "Consider the function\n\n$$\nF(x,y,z)=2\\operatorname{cos}⁡(2x)\\,i+2yz\\,j+{y}^{2}\\,k.\n$$\n\nFind $f(x,y,z)$ such that $∇f(x,y,z)=F(x,y,z).$" :question/worked-solution "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n∇f(x,y,z)=\\frac{∂f}{∂x}\\,\\text{i}+\\frac{∂f}{∂y}\\,\\text{j}+\\frac{∂f}{∂z}\\,\\text{k}.\n$$\n\nSince $∇f(x,y,z)=F(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=2\\operatorname{cos}⁡(2x),\\,\\frac{∂f}{∂y}=2yz,\\,\\frac{∂f}{∂z}={y}^{2}\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int 2\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡(2x)+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=2yz$ into account, we obtain\n\n$$\n\\begin{aligned}\\frac{∂g}{∂y} & =2yz\\end{aligned}\n$$\n\nNow we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int (2yz)\\,\\text{d}y \\\\  & ={y}^{2}z+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)={y}^{2}z+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}={y}^{2}+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}={y}^{2}$ into account, we obtain\n\n$$\n\\begin{aligned}{y}^{2}+{h}^{′}(z) & ={y}^{2} \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=\\operatorname{sin}⁡(2x)+{y}^{2}z+C.\n$$"}] [{:db/id #edb/ref 17592186294327 :knowledge-point/_questions [{:knowledge-point/id #uuid "37209e5f-a6e8-55d5-b76f-19f79db67566" :knowledge-point/title "Computing 4x4 Determinants Using Row and Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d41a26e-4c34-529a-9f07-9c3a331390a0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186294329} {:answer/id #uuid "b2419836-5865-5ec6-b639-b2dca741c0af" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186294330} {:answer/id #uuid "f57cf019-138f-5826-83eb-991f6aac57a4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186294331} {:answer/id #uuid "e885b534-d733-57eb-b0a9-e0d0f540779a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186294332} {:answer/id #uuid "d6d18489-db79-5815-a081-d4edc5fd9420" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186294333}] :answer-field/correct {:answer/id #uuid "d6d18489-db79-5815-a081-d4edc5fd9420" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186294333} :answer-field/id #uuid "fd0771f6-8065-5439-a3d4-c10a760e8167" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294328}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f7b429e2-c38b-50a3-87f8-3dc384ee9f6e" :question/math-academy-id "q-42890" :question/problem "Calculate the value of \n$\\,|\\begin{aligned}1 & 2 & -3 & 2 \\\\ 2 & 2 & -3 & -1 \\\\ -3 & 2 & -2 & 4 \\\\ -2 & -2 & 3 & 2\\end{aligned}|.$\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero. You should be able to reduce the given $4\\times 4$ determinant to a $3\\times 3$ determinant.*" :question/worked-solution "Using elementary row operations, let's make entries below ${a}_{12}=2$ equal to zero.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & -3 & 2 \\\\ 2 & 2 & -3 & -1 \\\\ -3 & 2 & -2 & 4 \\\\ -2 & -2 & 3 & 2\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ {R}_{4}:={R}_{4}+{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}1 & 2 & -3 & 2 \\\\ 1 & 0 & 0 & -3 \\\\ -4 & 0 & 1 & 2 \\\\ -1 & 0 & 0 & 4\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & 2 & -3 & 2 \\\\ 1 & 0 & 0 & -3 \\\\ -4 & 0 & 1 & 2 \\\\ -1 & 0 & 0 & 4\\end{aligned}| \\\\  & =2\\cdot (-1)^{1+2}|\\begin{aligned}1 & 0 & -3 \\\\ -4 & 1 & 2 \\\\ -1 & 0 & 4\\end{aligned}| \\\\  & =-2|\\begin{aligned}1 & 0 & -3 \\\\ -4 & 1 & 2 \\\\ -1 & 0 & 4\\end{aligned}| \\\\  & =(-2)\\cdot 1\\cdot (-1)^{2+2}|\\begin{aligned}1 & -3 \\\\ -1 & 4\\end{aligned}| \\\\  & =-2(4-3) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294334 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef65513d-1e9e-571f-8b93-4e2d63aed68e" :knowledge-point/title "Identifying Subspaces of Function Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5481ebe6-7afc-5959-b9ff-3ac4af78b201" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186294336} {:answer/id #uuid "30ebfb58-3bc7-569d-95bf-f02e3b8ca8a5" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186294337} {:answer/id #uuid "5d7679e4-a83a-5caf-a580-1ef94cc88f1a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186294338} {:answer/id #uuid "f9c9dce6-e0bc-52df-a671-6796ea08e690" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186294339} {:answer/id #uuid "2a4dd53b-c48e-5dad-815f-a941a41f4766" :answer/type {:db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186294340}] :answer-field/correct {:answer/id #uuid "5481ebe6-7afc-5959-b9ff-3ac4af78b201" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186294336} :answer-field/id #uuid "506d02c0-5619-5a27-a023-c555e254176f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294335}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "549da073-b722-5fcb-9360-923ddd086ff3" :question/math-academy-id "q-43780" :question/problem "Consider the vector space $C[-1,1]$ of all continuous functions $f:[-1,1]\\to R$ and its subset $A={f\\in C[-1,1]\\,|\\,f(1)\\le 0}.$ \n\nWhich of the following statements are true?\n\n- $A$ is closed under function addition\n- $A$ is closed under scalar multiplication\n- $A$ is a subspace of $C[-1,1]$\n- $A$ is **not** a subspace of $C[-1,1]$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If $f(x),g(x)\\in A,$ then\n\n$$\n\\begin{aligned}(f+g)(1) & =f(1)+g(1)\\le 0\\end{aligned}\n$$\n\nSo, $A$ is closed under addition.\n\n- Statement II is false. For example, if $f(x)\\in A$ and $k=-1\\in R,$ then \n\n$$\n\\begin{aligned}f(1) & \\le 0 \\\\ kf(1) & \\ge k\\cdot 0 \\\\ (kf) & \\ge 0\\end{aligned}\n$$\n\nSo, $A$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $A$ is *not* a subspace because it's not closed under scalar multiplication.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186120426 :knowledge-point/_questions [{:knowledge-point/id #uuid "36986a18-172c-5983-8f6f-3211b6e8f89d" :knowledge-point/title "Finding the Radius of Curvature of a Plane Curve Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9777d1a5-c0d1-5e45-a5c5-8804d9a99224" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186119032} {:answer/id #uuid "cb2e66a9-128e-571e-8b39-e64df411f919" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186119033} {:answer/id #uuid "1816e76f-b533-5aa6-a5b0-dee6d82320ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186119034} {:answer/id #uuid "5c618108-f77b-578b-a3ec-390444c1ccfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186119035} {:answer/id #uuid "784bf460-93ab-573f-92f2-1afac72cdaba" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186119036}] :answer-field/correct {:answer/id #uuid "1816e76f-b533-5aa6-a5b0-dee6d82320ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186119034} :answer-field/id #uuid "c318bce1-18de-5fa1-b45d-da4ab5a7464b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186119031}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bf912f7e-2809-5344-9478-be3125239509" :question/math-academy-id "q-64901" :question/problem "Find the radius of the curvature for the curve $r(t)=⟨{e}^{t},\\,{e}^{-t}⟩$ at $t=0.$" :question/worked-solution "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)={e}^{t},\\,y(t)={e}^{-t}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & ={e}^{t},\\, & {y}^{′}(t) & =-{e}^{-t} \\\\ {x}^{″}(t) & ={e}^{t},\\, & {y}^{″}(t) & ={e}^{-t}\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|{e}^{t}\\cdot {e}^{-t}-(-{e}^{-t})\\cdot {e}^{t}|}{{(({e}^{t})^{2}+(-{e}^{-t})^{2})}^{3/2}} \\\\  & =\\frac{2}{{({e}^{2t}+{e}^{-2t})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{2}{{({e}^{2(0)}+{e}^{-2(0)})}^{3/2}} \\\\  & =\\frac{2}{{2}^{3/2}} \\\\  & =\\frac{1}{\\sqrt{2}}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186333811 :knowledge-point/_questions [{:knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "536de9bd-b925-5fde-9a18-7659e6ac81d7" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186333813} {:answer/id #uuid "0e698b23-e674-562b-9725-672ace33dc69" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333814} {:answer/id #uuid "7e4df8ba-9dfc-5923-84a3-872dca158f01" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186333815} {:answer/id #uuid "071f479b-04d2-5caa-b345-9f4513703d40" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186333816} {:answer/id #uuid "3cedb535-b6d1-504a-9105-51c5e70ffc2e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333817}] :answer-field/correct {:answer/id #uuid "3cedb535-b6d1-504a-9105-51c5e70ffc2e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333817} :answer-field/id #uuid "3d78575b-a3e0-576b-b5ff-36e8ed92f2f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333812}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "538bab68-7058-5f4f-b133-c515348f8f89" :question/math-academy-id "q-74964" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}\n$$\n\n- The limit evaluates to $0$ along the path $y=x$\n- The limit evaluates to $2$ along the path $y={x}^{2}$\n- The limit exists and is equal to $2$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-x} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{x(2x-1)} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{2x-1} \\\\  & =\\frac{2\\cdot 0}{2\\cdot 0-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is also true. Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2\\end{aligned}\n$$\n\n- Statement III is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186368255 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da38700e-6cef-5a76-b977-fb143e5f3ce4" :answer/type {:db/ident :answer.type/math} :answer/value "e-2" :db/id #edb/ref 17592186368257} {:answer/id #uuid "bdc2660c-89f6-5af0-9c43-45260bd1415c" :answer/type {:db/ident :answer.type/math} :answer/value "2-e" :db/id #edb/ref 17592186368258} {:answer/id #uuid "8c38c489-c392-56d7-b827-3d7519be8373" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368259} {:answer/id #uuid "4ce2bbef-c135-5197-8d10-2ee0d2def449" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186368260} {:answer/id #uuid "ab0fef72-835c-53ea-9e68-78c0ca90383f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186368261}] :answer-field/correct {:answer/id #uuid "ab0fef72-835c-53ea-9e68-78c0ca90383f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186368261} :answer-field/id #uuid "98b9b42f-9987-54bc-bd68-413c1c8d2bab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368256}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5dfed89f-88e1-5c5a-a0c4-8c6a48d5109c" :question/math-academy-id "q-79812" :question/problem "If $f(x,y)=x\\operatorname{ln}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,e)$ to $(1,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,e),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,e) & =\\operatorname{ln}⁡e\\,\\text{d}x+\\frac{0}{e}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,e+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(0,e)$ to $(1,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-0=1, \\\\ Δy & =2-e.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (1)+0\\cdot (2-e) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $1.$"}] [{:db/id #edb/ref 17592186367847 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ad17d11-325f-5888-a5cd-61ee27f7a103" :knowledge-point/title "Finding Two Linearly Independent Complex Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fffe5aa-ee8a-5b26-8ade-c9c24234c182" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186367849} {:answer/id #uuid "6e8805f9-1c6e-521c-a98a-cc0f79fe6a50" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186367850} {:answer/id #uuid "bf6a9dad-8386-5818-983d-4906ea5a545f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186367851} {:answer/id #uuid "b212765d-6088-51dd-bcb2-b84794cb59e1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186367852} {:answer/id #uuid "b36e4cb5-c904-56fb-a24e-dd76af5a2e67" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186367853}] :answer-field/correct {:answer/id #uuid "1fffe5aa-ee8a-5b26-8ade-c9c24234c182" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186367849} :answer-field/id #uuid "2d6d9648-4bd5-5a09-8c96-d66b096cb920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367848}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "defa1cb1-365b-5e5f-ab67-ca3d065551d3" :question/math-academy-id "q-81190" :question/problem "Let ${v}_{1}=[\\begin{aligned}{a}_{1} \\\\ {b}_{1}\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}{a}_{2} \\\\ {b}_{2}\\end{aligned}]$ be linearly independent eigenvectors of the matrix\n$A=[\\begin{aligned}-1 & 5 \\\\ -2 & 1\\end{aligned}].$\nGiven that ${\\lambda }_{1}=3\\text{i}$ is an eigenvalue of $A,$ find the value of $\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}.$" :question/worked-solution "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\,{\\lambda }_{1}=3\\text{i}$ and\n\n$$\n\\begin{aligned}A-{\\lambda }_{1}I & =[\\begin{aligned}-1 & 5 \\\\ -2 & 1\\end{aligned}]-[\\begin{aligned}3\\text{i} & 0 \\\\ 0 & 3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-1-3\\text{i} & 5 \\\\ -2 & 1-3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the homogeneous system of linear equations\n\n$$\n{\\begin{aligned}(-1-3\\text{i}){x}_{1}+5{x}_{2}=0 \\\\ -2{x}_{1}+(1-3\\text{i}){x}_{2}=0.\\end{aligned}\n$$\n\nNow, since the matrix $A-3\\text{i}I$ is singular, the system above must have a non-zero solution. This means that one equation of the system is a multiple of another. As a result, we can drop one of the rows and take one of the variables as the free variable. For example, from the first equation, we get\n\n$$\n{x}_{2}=\\frac{1}{5}(1+3\\text{i}){x}_{1}\n$$\n\nHence, the general solution is given by\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ \\frac{1}{5}(1+3\\text{i}){x}_{1}\\end{aligned}],\\,{x}_{1}\\in C.\n$$\n\nSetting ${x}_{1}=5,$ we get the eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}5 \\\\ 1+3\\text{i}\\end{aligned}].\n$$\n\n \n\nOn the other hand, since ${\\lambda }_{1}=3\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the  complex conjugate of ${\\lambda }_{1}.$ Therefore, \n\n$$\n{\\lambda }_{2}=\\overset{―}{{\\lambda }_{1}}=-3\\text{i}.\n$$\n\nMoreover, the corresponding eigenvector to ${\\lambda }_{2}$ is\n\n$$\n{v}_{2}={\\overset{―}{v}}_{1}=[\\begin{aligned}5 \\\\ 1-3\\text{i}\\end{aligned}].\n$$\n\nTherefore, we obtain\n\n$$\n\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}}=\\frac{(5)(5)}{(1+3\\text{i})(1-3\\text{i})}=\\frac{5}{2}.\n$$"}] [{:db/id #edb/ref 17592186306866 :knowledge-point/_questions [{:knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e" :knowledge-point/title "Restoring a Matrix Given Its Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef1b710-a3f0-5447-a9e9-c53014f598d8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-17 & 30 \\\\ -9 & 16\\end{aligned}]" :db/id #edb/ref 17592186306868} {:answer/id #uuid "7dc45458-19b1-5438-9f0f-4ef79ff85392" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 9 \\\\ -3 & 17\\end{aligned}]" :db/id #edb/ref 17592186306869} {:answer/id #uuid "232a5974-ded3-5a6c-a231-23c4eef5215b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 & 19 \\\\ -3 & 7\\end{aligned}]" :db/id #edb/ref 17592186306870} {:answer/id #uuid "8d839acd-7543-59a8-a16a-041acb3aaf6a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 & 9 \\\\ -30 & 17\\end{aligned}]" :db/id #edb/ref 17592186306871} {:answer/id #uuid "dbd04ec0-b98b-5749-ae26-f1005f26dfa8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 9 \\\\ -30 & 1\\end{aligned}]" :db/id #edb/ref 17592186306872}] :answer-field/correct {:answer/id #uuid "8d839acd-7543-59a8-a16a-041acb3aaf6a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 & 9 \\\\ -30 & 17\\end{aligned}]" :db/id #edb/ref 17592186306871} :answer-field/id #uuid "9ac6deca-d8f8-517a-a24a-93496cb68beb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306867}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f76ba1b-7ea5-5d91-91ae-a14e891b8be6" :question/math-academy-id "q-86676" :question/problem "Find a $2\\times 2$ matrix $G$ that has eigenvalues ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}3 \\\\ 5\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $G,$ then $G$ must be diagonalizable.\n\nSo, we can write $G=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $G,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nG={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}].$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}G & =[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-16 & 9 \\\\ -30 & 17\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351276 :knowledge-point/_questions [{:knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d7fd9a1-349b-5b8e-8f71-4b17b56d5d2c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186351278} {:answer/id #uuid "b2cb348c-0172-5197-961c-11cf29367f62" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186351279} {:answer/id #uuid "f2d59f86-dffc-588b-9b43-ee67ea32cf4f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186351280} {:answer/id #uuid "65dac41c-c0d7-5355-95dd-06cda0199205" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186351281} {:answer/id #uuid "666c985b-a1f1-5bf2-a63c-01e100bf3098" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186351282}] :answer-field/correct {:answer/id #uuid "b2cb348c-0172-5197-961c-11cf29367f62" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186351279} :answer-field/id #uuid "0b1cae30-f8b9-5ce6-ad58-43e95762085d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351277}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e83ef381-2688-5e65-8917-dab31a31675d" :question/math-academy-id "q-94383" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+8{y}^{′}+41y=10{e}^{t}.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}$\n- $y=R\\operatorname{sin}⁡(9t+ϕ)+\\frac{{e}^{t}}{5}$\n- $y=R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+10{e}^{t}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+8{y}^{′}+41y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +41 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+41 & =0 \\\\ (\\lambda +4)^{2}+25 & =0 \\\\ (\\lambda +4)^{2} & =-25 \\\\ \\lambda +4 & =\\pm 5\\text{i} \\\\ \\lambda  & =-4\\pm 5\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha {e}^{t}.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{5}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{{e}^{t}}{5}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}.\\end{aligned}\n$$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186294842 :knowledge-point/_questions [{:knowledge-point/id #uuid "1979b91d-2ac0-5d35-b4cc-1c9c9505b503" :knowledge-point/title "Differentiating an Inverse Tanh Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08412b52-4cfb-5412-8537-58ef35295219" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{1-{e}^{2x}}" :db/id #edb/ref 17592186294844} {:answer/id #uuid "1be660e5-4491-5cc2-a883-603f1c398d43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{{e}^{2x}-1}" :db/id #edb/ref 17592186294845} {:answer/id #uuid "2a0eb8f8-92ae-5019-9d5c-faa2978588e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2x}}{1-{e}^{x}}" :db/id #edb/ref 17592186294846} {:answer/id #uuid "7f9c5272-40a5-58cd-912a-33a4cd05f646" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{{e}^{2x}+1}" :db/id #edb/ref 17592186294847} {:answer/id #uuid "a2f14128-a178-5bb3-afd9-439f540096b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{1+{e}^{2x}}" :db/id #edb/ref 17592186294848}] :answer-field/correct {:answer/id #uuid "08412b52-4cfb-5412-8537-58ef35295219" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{1-{e}^{2x}}" :db/id #edb/ref 17592186294844} :answer-field/id #uuid "7d1a91e0-b7d1-5713-8e41-61b2622139c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294843}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7bc13545-d6a0-5612-9a84-04aec6ad0b6d" :question/math-academy-id "q-95505" :question/problem "$$\n\nIf $y=\\operatorname{artanh}⁡{e}^{x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic tangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡{e}^{x}) \\\\  & =\\frac{1}{1-{({e}^{x})}^{2}}\\cdot {({e}^{x})}^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327981 :knowledge-point/_questions [{:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182d3b2b-1ff8-5162-9803-5cdc14fde36a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327983} {:answer/id #uuid "9ae7dbf8-9d35-59f4-8fb4-f5967daa274a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327984} {:answer/id #uuid "ceaf322b-af0a-5832-9ab1-5005664b314b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327985} {:answer/id #uuid "ac80e5c1-9497-5654-9017-aebc7b0be494" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327986} {:answer/id #uuid "6adc60b9-17a8-5f75-a61a-a023629cf8ba" :answer/type {:db/ident :answer.type/math} :answer/value "-2{coth}^{2}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327987}] :answer-field/correct {:answer/id #uuid "9ae7dbf8-9d35-59f4-8fb4-f5967daa274a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327984} :answer-field/id #uuid "8d77f60d-e9ec-5547-bf6b-a7c070b2c1dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327982}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59346a59-f274-5f87-97f7-8c14ba6c65f5" :question/math-academy-id "q-96055" :question/problem "$\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t & \\,⇒\\,\\int \\operatorname{sinh}⁡t\\,\\text{d}t=\\operatorname{cosh}⁡t+C, \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t & \\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t & =2\\int {csch}^{2}⁡t\\,\\text{d}t+\\int \\operatorname{sinh}⁡t\\,\\text{d}t \\\\  & =2(-\\operatorname{coth}⁡t)+\\operatorname{cosh}⁡t+C \\\\  & =-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C.\\end{aligned}\n$$"}]}
