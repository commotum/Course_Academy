4998e4" "q-126984/selection/b90687c43b566000ff1bc334f3b654cbb2d75edf3c937485326e00f2d63a1179"] :db/ensure [:answer-field/validate]} {:db/id "q-126984" :question/id #uuid "3cd72f9e-93c4-57cc-9338-613eb7f923c9" :question/math-academy-id "q-126984" :question/problem "${lim}_{n\\to \\infty }{(1+\\frac{\\pi x}{n})}^{2n}=$" :question/worked-solution "Recall the following special limit: \n\n$$\n{e}^{u}={lim}_{n\\to \\infty }{(1+\\frac{u}{n})}^{n}\n$$\n\nHence, with $u=\\pi x$, we get\n\n$$\n{e}^{\\pi x}={lim}_{n\\to \\infty }{(1+\\frac{\\pi x}{n})}^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{\\pi x}{n})}^{2n} & ={lim}_{n\\to \\infty }{[{(1+\\frac{\\pi x}{n})}^{n}]}^{2} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{\\pi x}{n})}^{n}]}^{2} \\\\  & ={({e}^{\\pi x})}^{2} \\\\  & ={e}^{2\\pi x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126984/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16ad6bbc-b8c4-52f6-9f24-0d8494d83b94"] :knowledge-point/questions ["q-126984"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338050/field-1/6ed2d71c5313cf75d0a76b7d0a19a014ddc22265f72d879d9e34f193e5809d2b" :answer/id #uuid "136173a6-1ec0-5054-88d1-6593075ae124" :answer/type :answer.type/math :answer/value "e^{2x}" :db/ensure [:answer/validate]} {:db/id "q-338050/field-1" :answer-field/id #uuid "e4fd7d09-223a-5875-83eb-f9e6291b03de" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338050/field-1/6ed2d71c5313cf75d0a76b7d0a19a014ddc22265f72d879d9e34f193e5809d2b" :answer-field/choices ["q-338050/field-1/6ed2d71c5313cf75d0a76b7d0a19a014ddc22265f72d879d9e34f193e5809d2b"] :db/ensure [:answer-field/validate]} {:db/id "q-338050" :question/id #uuid "b267e012-23c0-525e-92e3-883c328cdffd" :question/math-academy-id "q-338050" :question/problem "Calculate the following limit:\n\n${lim}_{n\\to \\infty }{(1+\\frac{x\\sqrt{2}}{n})}^{n\\sqrt{2}}=$\n{{field-1}}" :question/worked-solution "Recall the following special limit:\n\n$$\n{e}^{u}={lim}_{n\\to \\infty }{(1+\\frac{u}{n})}^{n}\n$$\n\nHence, with $u=x\\sqrt{2},$ we get\n\n$$\n{e}^{x\\sqrt{2}}={lim}_{n\\to \\infty }{(1+\\frac{x\\sqrt{2}}{n})}^{n}.\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{x\\sqrt{2}}{n})}^{n\\sqrt{2}} & ={lim}_{n\\to \\infty }{[{(1+\\frac{x\\sqrt{2}}{n})}^{n}]}^{\\sqrt{2}} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{x\\sqrt{2}}{n})}^{n}]}^{\\sqrt{2}} \\\\  & ={({e}^{x\\sqrt{2}})}^{\\sqrt{2}} \\\\  & ={e}^{2x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338050/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16ad6bbc-b8c4-52f6-9f24-0d8494d83b94"] :knowledge-point/questions ["q-338050"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-9357"] :question/problem "Calculate $\\displaystyle{\\lim_{n \\to \\infty} \\left(1+\\dfrac{1}{n}\\right)^{3n}}.$" :question/worked-solution "Recall the following special limit: \n\n$$\ne = \\lim_{n \\to  \\infty} \\left(1+\\dfrac{1}{n}\\right)^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{3n} & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{3} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{3} \\\\  & ={e}^{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9361"] :question/problem "Calculate $\\displaystyle{\\lim_{n \\to \\infty} \\left(1+\\dfrac{1}{n}\\right)^{nx/3}}.$" :question/worked-solution "Recall the following special limit: \n\n$$\ne = \\lim_{n \\to  \\infty} \\left(1+\\dfrac{1}{n}\\right)^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{nx/3} & ={lim}_{n\\to \\infty }{[{(1+\\frac{1}{n})}^{n}]}^{x/3} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{1}{n})}^{n}]}^{x/3} \\\\  & ={e}^{x/3} \\\\  & =\\sqrt[3]{{e}^{x}}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9358"] :question/problem "Calculate $\\displaystyle{\\lim_{n \\to \\infty} \\left(1+\\dfrac{x}{n}\\right)^{-n/2}}.$" :question/worked-solution "Recall the following special limit: \n\n$$\ne^x = \\lim_{n \\to  \\infty} \\left(1+\\dfrac{x}{n}\\right)^{n}\n$$\n\nNow, we rewrite the given limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{-n/2} & ={lim}_{n\\to \\infty }{[{(1+\\frac{x}{n})}^{n}]}^{-1/2} \\\\  & ={[{lim}_{n\\to \\infty }{(1+\\frac{x}{n})}^{n}]}^{-1/2} \\\\  & ={({e}^{x})}^{-1/2} \\\\  & =\\sqrt{\\frac{1}{{e}^{x}}}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
