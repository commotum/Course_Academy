{2})\\cdot \\operatorname{cos}⁡({y}^{2})\\cdot 2y \\\\ \\frac{\\text{d}x}{\\text{d}y} & =6y{sin}^{2}⁡({y}^{2})\\operatorname{cos}⁡({y}^{2}) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{6y{sin}^{2}⁡({y}^{2})\\operatorname{cos}⁡({y}^{2})} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{csc}^{2}⁡({y}^{2})\\operatorname{sec}⁡({y}^{2})}{6y}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =\\frac{{csc}^{2}⁡({[{f}^{-1}(x)]}^{2})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{2})}{6{f}^{-1}(x)} \\\\ {({f}^{-1})}^{′}(x) & =\\frac{{csc}^{2}⁡({[{f}^{-1}(x)]}^{2})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{2})}{6{f}^{-1}(x)}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/state.json" "file_sha256" "92636fd31d02c0dd27ff45c17964c0bb650eeb8093fdc371c1a377598fe9ac8d"} {"question" "q-32643" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/activity-metadata.json" "file_sha256" "2e156de1335d27406e8b355259b19f7acc6c7f4ff91a253871efe5a495eeb82e"} {"question" "q-32643" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/state.json" "file_sha256" "92636fd31d02c0dd27ff45c17964c0bb650eeb8093fdc371c1a377598fe9ac8d"} {"question" "q-32643" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{{csc}^{2}⁡({[{f}^{-1}(x)]}^{2})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{2})}{6{f}^{-1}(x)}"] ["math" "-\\frac{{csc}^{2}⁡({[{f}^{-1}(x)]}^{2})\\operatorname{sec}⁡({[{f}^{-1}(x)]}^{2})}{{f}^{-1}(x)}"] ["math" "\\frac{{cos}^{2}⁡({[{f}^{-1}(x)]}^{2})\\operatorname{sin}⁡({[{f}^{-1}(x)]}^