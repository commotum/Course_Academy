}{\\text{d}y} & =\\operatorname{cos}⁡(2y+5)\\cdot 2 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =2\\operatorname{cos}⁡(2y+5) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\operatorname{cos}⁡(2y+5)} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2}\\operatorname{sec}⁡(2y+5)\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{1}{2}\\operatorname{sec}⁡(2{g}^{-1}(x)+5) \\\\ {({g}^{-1})}^{′}(x) & =\\frac{1}{2}\\operatorname{sec}⁡(2{g}^{-1}(x)+5).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/state.json" "file_sha256" "92636fd31d02c0dd27ff45c17964c0bb650eeb8093fdc371c1a377598fe9ac8d"} {"question" "q-32635" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/activity-metadata.json" "file_sha256" "2e156de1335d27406e8b355259b19f7acc6c7f4ff91a253871efe5a495eeb82e"} {"question" "q-32635" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/state.json" "file_sha256" "92636fd31d02c0dd27ff45c17964c0bb650eeb8093fdc371c1a377598fe9ac8d"} {"question" "q-32635" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{cos}⁡(2{g}^{-1}(x)+5)"] ["math" "2\\operatorname{csc}⁡(2{g}^{-1}(x)+5)"] ["math" "\\frac{1}{2}\\,\\operatorname{csc}⁡(2{g}^{-1}(x)+5)"] ["math" "\\frac{1}{2}\\,\\operatorname{sec}⁡(2{g}^{-1}(x)+5)"] ["math" "\\operatorname{sec}⁡(2{g}^{-1}(x))"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979277/state.json" "file_sha256" "92636fd31d02c0dd27ff45c17964