[{:db/id "q-8427/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "984ee96b-4ac0-5e7a-bde6-7ed49bdf48de" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-8427/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f4349533-283e-5819-88cb-0cd11c85c3df" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-8427/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "522176c9-f8b4-52b4-a331-8bac2b70a135" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-8427/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "7f334c66-fa9a-5e90-a105-62c70d891948" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-8427/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "adc491b8-03b6-5657-b74f-02b5c0531bd7" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-8427/selection" :answer-field/id #uuid "039eab0d-68a9-546f-ae81-a9862d41ad0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8427/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-8427/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-8427/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-8427/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-8427/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-8427/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-8427" :question/id #uuid "8b8e4100-9820-5dcf-ac19-03a2a5373bbb" :question/math-academy-id "q-8427" :question/problem "A triangle $S$ has vertices at $(0,2),(-1,2),(-1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ about the origin?\n\n- $(1,-1)$\n- $(0,-2)$\n- $(-2,-1)$" :question/worked-solution "The counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{90}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & -1 & -1 \\\\ 2 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{90}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & -1 & -1 \\\\ 2 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 & 0 \\\\ 0 & -1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-2,0),(-2,-1),(0,-1).$\n\nSo, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8427/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-8427"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160619/selection/518797f4390609fb34ea8cf9c4eebc7548f2c7266b002db4543f37621ad35def" :answer/id #uuid "65a3beed-47ed-544c-80fd-8e3487b18804" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/5bd4d8cc2643767b82acc0e61d168f5b387be67a7ff96634604e0d6828cc288b.png" :db/ensure [:answer/validate]} {:db/id "q-160619/selection/25b9c9d533e47475cb8f3d75f50d3d597b5d31c44e7588535a56ad30a1ca651e" 