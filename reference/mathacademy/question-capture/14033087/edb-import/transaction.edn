b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/8ea257c65769c4d6f67f55ce6533c1bfdfe45debcf1ba532b9ec3f717238507a.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160621/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-160621"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160627/selection/4aa7734504b444382f6f1cc04430a3a15cf07134402a98e1f99ec48234e12436" :answer/id #uuid "9a7d6100-079c-5012-9b5f-037a5687e6cb" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/09b2ae9333118de0621a5f29610b6a83689fadaeb9c05e7a30b2799b12a1bd58.png" :db/ensure [:answer/validate]} {:db/id "q-160627/selection/7e4f0f2eb661c4ee8c98b19654ab1656348fd8a299f91316849034a1bda39a51" :answer/id #uuid "3c8adda5-0333-5dd2-8fb3-c3aec8bca265" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/5a1923eec2b66ef4eb861ec42b00ea48a3285aaaf3255c42d12c001c9cde32f8.png" :db/ensure [:answer/validate]} {:db/id "q-160627/selection/382fd1a7060d9042e5881704ecf42ae05281c4cabb3f48c877ae6dd25baf1143" :answer/id #uuid "49be66f3-ba66-5919-b1db-61bdeb019eba" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/ensure [:answer/validate]} {:db/id "q-160627/selection/59505978f57609fc19387bbf195060afbe2ff639ad2dfd4813a3c899f6786821" :answer/id #uuid "708ee9ac-745d-55db-b410-f1f4aab15194" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/ead70b80d9256e1211addc404613f2dfe4a19baf822cbd77f429572ffc9a3a6d.png" :db/ensure [:answer/validate]} {:db/id "q-160627/selection/ff2ea61c9d54ffd63e65325a5bd4b06e5ceee6fd18c5b6598d6f3748da4dd88d" :answer/id #uuid "5bbcd6fb-ec6e-579f-beca-1eaad44b5f89" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/23f63717c8d356c698137359824112511b0bbd5ec04c59e47d22500d842d03b6.png" :db/ensure [:answer/validate]} {:db/id "q-160627/selection" :answer-field/id #uuid "7099fd12-65a9-5316-9ba3-b4fd5bb3e69a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160627/selection/382fd1a7060d9042e5881704ecf42ae05281c4cabb3f48c877ae6dd25baf1143" :answer-field/choices ["q-160627/selection/4aa7734504b444382f6f1cc04430a3a15cf07134402a98e1f99ec48234e12436" "q-160627/selection/7e4f0f2eb661c4ee8c98b19654ab1656348fd8a299f91316849034a1bda39a51" "q-160627/selection/382fd1a7060d9042e5881704ecf42ae05281c4cabb3f48c877ae6dd25baf1143" "q-160627/selection/59505978f57609fc19387bbf195060afbe2ff639ad2dfd4813a3c899f6786821" "q-160627/selection/ff2ea61c9d54ffd63e65325a5bd4b06e5ceee6fd18c5b6598d6f3748da4dd88d"] :db/ensure [:answer-field/validate]} {:db/id "q-160627" :question/id #uuid "04e79ef7-7090-527f-95f0-0f13ae5b3650" :question/math-academy-id "q-160627" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/0bd98626bc49cc3c58e503d5a7373b6af0fcce721cfdf82ff372eaa57d157dda.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/d5ff1c1a7c99b08d04d2ac58d9f8195ee29c8b564873a9abfb2635e93cec1968.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160627/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-160627"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160644/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ad5b0ee2-7af1-5000-b95c-9787ca1087c5" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-160644/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "317cb7f7-cd1c-5803-88fa-e4caf85faf2a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160644/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b5f75dfa-b784-5059-a491-313dfb65c162" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-160644/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "bf7197e7-af48-5688-acbe-4eaf01deb432" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-160644/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "61129a8e-e817-555a-b8cc-c20f7bd58800" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160644/selection" :answer-field/id #uuid "0e1d7e5c-861f-50ad-96f8-5c1feba4e907" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160644/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-160644/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-160644/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-160644/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-160644/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-160644/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-160644" :question/id #uuid "8d8905ff-87fc-56b7-a3d8-d73cbc677520" :question/math-academy-id "q-160644" :question/problem "A triangle $S$ has vertices at $(2,-3),(3,1),(-4,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(3,2)$\n- $(1,-3)$\n- $(-1,4)$" :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}2 & 3 & -4 \\\\ -3 & 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}2 & 3 & -4 \\\\ -3 & 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 & -1 \\\\ -2 & -3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,-2),(1,-3),(-1,4).$\n\nSo, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160644/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-160644"] :db/ensure [:knowledge-point/validate]}]
