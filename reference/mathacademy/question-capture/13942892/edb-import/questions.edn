2186258822}] :answer-field/correct {:answer/id #uuid "7390bed0-b01c-5f2a-befd-54ef50e8735e" :answer/type {:db/ident :answer.type/math} :answer/value "(k+1)^{2}k!" :db/id #edb/ref 17592186258821} :answer-field/id #uuid "f402311c-4280-5dc9-b696-2f17bc3e00bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258817}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ee6a7d7-dbe7-5b40-954a-acea9efee6e8" :question/math-academy-id "q-19877" :question/problem "Given that $k\\ge 0$ is an integer, $\\frac{{((k+1)!)}^{2}}{k!}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+1)!=(k+1)k!\n$$\n\nThen, we can cancel the $k!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{((k+1)!)}^{2}}{k!} & =\\frac{{((k+1)k!)}^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot (k!)^{2}}{k!} \\\\  & =\\frac{(k+1)^{2}\\,\\cdot k!\\cdot \\cancel{k!}}{\\cancel{k!}} \\\\  & =(k+1)^{2}k!\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258823 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d4b7050-b0ec-506e-8d2d-3de366c66aef" :answer/type {:db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186258825} {:answer/id #uuid "77002e1b-3856-5764-ac6e-3589194b4e01" :answer/type {:db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186258826} {:answer/id #uuid "238bf615-e4f5-5bc6-8891-998d63d57915" :answer/type {:db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186258827} {:answer/id #uuid "acbce194-3273-5052-9801-7566a12961bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186258828} {:answer/id #uuid "43d0cf0c-78ed-59b6-80b1-240f71aac532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186258829}] :answer-field/correct {:answer/id #uuid "77002e1b-3856-5764-ac6e-3589194b4e01" :answer/type {:db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186258826} :answer-field/id #uuid "520f903f-cc0f-5087-a651-ef4c311135ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186258824}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4a8f7cc8-f392-57e5-b3c9-254ee480518f" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186260805 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a4fc142-f8be-5f31-882a-e83b75f5f1ee" :answer/type {:db/ident :answer.type/math} :answer/value "k+2" :db/id #edb/ref 17592186260807} {:answer/id #uuid "b73b0fee-d32e-56aa-ad42-83d1a7c3fa14" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+5k+6" :db/id #edb/ref 17592186260808} {:answer/id #uuid "9fd33fda-aef8-5fb6-b1e9-74d1da876554" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}-3k+1" :db/id #edb/ref 17592186260809} {:answer/id #uuid "3c092cc7-e57c-5648-9b3e-ba3be80ea005" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+2k+3" :db/id #edb/ref 17592186260810} {:answer/id #uuid "8dd55d92-a16d-5694-9a50-729422e0bc37" :answer/type {:db/ident :answer.type/math} :answer/value "k+3" :db/id #edb/ref 17592186260811}] :answer-field/correct {:answer/id #uuid "b73b0fee-d32e-56aa-ad42-83d1a7c3fa14" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}+5k+6" :db/id #edb/ref 17592186260808} :answer-field/id #uuid "b54fd3d2-3af0-5e41-8978-da67e08d4bbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186260806}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1390df05-6bca-5037-aa71-abe139ff704c" :question/math-academy-id "q-6397" :question/problem "Given that $k\\ge 0$ is an integer, simplify $\\frac{(k+3)!}{(k+1)k!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(k+3)!=(k+3)\\cdot (k+2)\\cdot (k+1)\\cdot k!\n$$\n\nThen, we cancel the $k!$ and $(k+1)$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+3)!}{(k+1)k!}= & \\frac{(k+3)\\cdot (k+2)\\cdot (k+1)\\cdot k!}{(k+1)\\cdot k!} \\\\ = & \\frac{(k+3)\\cdot (k+2)\\cdot \\cancel{(k+1)}\\cdot \\cancel{k!}}{\\cancel{(k+1)}\\cdot \\cancel{k!}} \\\\ = & (k+3)(k+2) \\\\ = & {k}^{2}+5k+6\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261404 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbcf8c96-eec1-510a-a0f6-919ab37fe0a0" :answer/type {:db/ident :answer.type/math} :answer/value "n(n-1)" :db/id #edb/ref 17592186261406} {:answer/id #uuid "6