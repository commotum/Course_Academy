#{[{:db/id #edb/ref 17592186179444 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/id #uuid "6dfde17c-e23e-5137-86cb-f8b756788f13" :question/math-academy-id "e-5669" :question/problem "Given that $n \\geq 2$ is an integer, simplify $\\dfrac {n!} {(n - 2)!}$." :question/worked-solution "First, notice the following:\n\n$$\nn! = n \\cdot (n-1) \\cdot (n-2)\n$$\n\nThen, we cancel the $(n-2)$! that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned} \\dfrac {n!} {(n - 2)!} &= \\dfrac {n \\cdot (n - 1) \\cdot (n - 2)!} {(n - 2)!} \\\\[5pt] &= \\dfrac {n \\cdot (n - 1) \\cdot \\cancel{(n - 2)!}} {\\cancel{(n - 2)!}} \\\\[5pt] &= n(n -1) \\\\[5pt] &= n^2 - n \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179445 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/id #uuid "357d19f9-977d-5143-a881-3ecbc068556c" :question/math-academy-id "e-5670" :question/problem "Given that $k \\geq 1$ is an integer, simplify $\\dfrac {k^2(k - 1)!} {k!}$." :question/worked-solution "First, we notice that\n\n$$\nk! = k \\cdot (k-1)\n$$\n\nSo, we can simplify the numerator as follows:\n\n$$\nk^2 (k-1)! = k \\cdot \\underbrace{k \\cdot (k-1)!}_{k!} = k \\cdot k\n$$\n\nThen, we cancel the $k$! that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned} \\dfrac {k^2(k - 1)!} {k!} &= \\dfrac {k \\cdot k!} {k!} \\\\[5pt] &= \\dfrac {k \\cdot \\cancel{k!}} {\\cancel{k!}} \\\\[5pt] &= \\dfrac {k} {1} \\\\[5pt] &= k \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186179522 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/id #uuid "bcdea8ab-4c41-5d45-b62f-a1f2dc9f83e2" :question/math-academy-id "e-9520" :question/problem "Which of the following is equivalent to $(k+1)$! for any $k \\geq 2$?\n\n1. $(k+1) \\cdot k \\cdot (k-1)$\n2. $(k+1) \\cdot k \\cdot (k-1)$!\n3. $(k+1) \\cdot k$" :question/worked-solution "Using the definition of factorial, we have\n\n$$\n(k+1)! = (k+1) \\cdot k \\cdot (k-1) \\cdot (k-2) \\cdot \\: \\cdots \\: \\cdot 2 \\cdot 1\n$$\n\nNow, applying the factorial definition to all but the first two factors, we get\n\n$$\n\\begin{aligned}\n(k + 1)! &= (k + 1) \\cdot k \\cdot (k - 1) \\cdot (k - 2) \\cdot ⋯ \\cdot 2 \\cdot 1^(⏞)^((k - 1)!) \\\\\n&= (k + 1) \\cdot k \\cdot (k - 1)\n\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186179929 :knowledge-point/_questions [{:knowledge-point/id #uuid "90a5c75b-e93d-5f09-a126-3d0cb5ede2d5" :knowledge-point/title "Writing a Factorial in an Equivalent Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c90e64f6-b971-583a-a9f2-0f2e6b238c70" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 2) \\cdot k" :db/id #edb/ref 17592186177575} {:answer/id #uuid "192eb793-0884-5285-9d42-add055458c1b" :answer/type {:db/ident :answer.type/text} :answer/value "$(k + 2) \\cdot (k + 1)$!" :db/id #edb/ref 17592186177576} {:answer/id #uuid "199f723d-c8af-5880-b07a-b0c19d909d47" :answer/type {:db/ident :answer.type/math} :answer/value "(k + 2) \\cdot (k + 1)" :db/id #edb/ref 17592186177577} {:answer/id #uuid "371aa547-6f1e-54dc-a525-5e9100c066d6" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186177578} {:answer/id #uuid "482520d9-aef7-5737-a828-3b1c8d889e3e" :answer/type {:db/ident :answer.type/text} :answer/value "$(k + 2) \\cdot k$!" :db/id #edb/ref 17592186177579}] :answer-field/correct {:answer/id #uuid "192eb793-0884-5285-9d42-add055458c1b" :answer/type {:db/ident :answer.type/text} :answer/value "$(k + 2) \\cdot (k + 1)$!" :db/id #edb/ref 17592186177576} :answer-field/id #uuid "a8a8d747-42f1-5ad3-b02f-15d11d4b7168" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177574}] :question/id #uuid "06937889-7753-54db-a2ad-60dda70867ce" :question/math-academy-id "q-124142" :question/problem "Which of the following is equivalent to $(k + 2)$! for any $k \\ge 0$?"}] [{:db/id #edb/ref 17592186180048 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bade85f-502f-5951-9443-6b542568ea91" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} + 2n + 12" :db/id #edb/ref 17592186178279} {:answer/id #uuid "a4b34d92-1a83-5df6-8a74-f44b50ef4c64" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} - 10n + 6" :db/id #edb/ref 17592186178280} {:answer/id #uuid "e7d360e1-22e9-541b-bcaa-27786584d4c5" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} + 6n" :db/id #edb/ref 17592186178281} {:answer/id #uuid "500967db-f3f4-5220-abb0-cbc64c6a9e7b" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} + 10n + 24" :db/id #edb/ref 17592186178282} {:answer/id #uuid "73f796ed-01b8-57bc-9669-25bce71e0006" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} + 4" :db/id #edb/ref 17592186178283}] :answer-field/correct {:answer/id #uuid "500967db-f3f4-5220-abb0-cbc64c6a9e7b" :answer/type {:db/ident :answer.type/math} :answer/value "n^{2} + 10n + 24" :db/id #edb/ref 17592186178282} :answer-field/id #uuid "be12d33e-aec7-5d1b-9153-4b5bb75f8eb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178278}] :question/id #uuid "de3d35c0-fc07-591a-a365-7e51db64e6b8" :question/math-academy-id "q-19874" :question/problem "G