[{:db/id [:question/math-academy-id "q-97794"] :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(p,2p,3p)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(p,-2p,6p)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(p-p{)}^{2}+(-2p-2p{)}^{2}+(6p-3p{)}^{2}} \\\\  & =\\sqrt{{0}^{2}+(-4p{)}^{2}+(3p{)}^{2}} \\\\  & =\\sqrt{16{p}^{2}+9{p}^{2}} \\\\  & =\\sqrt{25{p}^{2}} \\\\  & =5\\,|p|.\\end{aligned}\n$$\n\nFinally, since $d=15,$ we get\n\n$$\n\\begin{aligned}5\\,|p| & =15 \\\\ |p| & =3 \\\\ p & =\\pm 3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-98142/selection/28c4dd7810cac2a8042280140154960b69ed756d2785d98973578b4f3a443651" :answer/id #uuid "bc09407a-bcd1-54d3-9697-104fedb1045a" :answer/type :answer.type/math :answer/value "4\\sqrt{2}\\,w" :db/ensure [:answer/validate]} {:db/id "q-98142/selection/a44acf8551890f27c17f602019269ef80b1d05b95b7d03977e0db8ab79c027ce" :answer/id #uuid "c00df639-1b39-57c4-8a92-1ce2b9de74cc" :answer/type :answer.type/math :answer/value "7w" :db/ensure [:answer/validate]} {:db/id "q-98142/selection/e5d1aa1dfbaac0c721e527a91f392d9e58479f44059d9c1d0fbba06430db5105" :answer/id #uuid "8a8e7686-7ef1-5459-b6ab-d5490ae7920c" :answer/type :answer.type/math :answer/value "2\\sqrt{3}\\,w" :db/ensure [:answer/validate]} {:db/id "q-98142/selection/c805b7d266bc9562306b344554c0267fe0423ab00d3d7d0df1c8a3e6037963d1" :answer/id #uuid "c6d07571-d4d8-5988-900f-3588ed7b537a" :answer/type :answer.type/math :answer/value "6w" :db/ensure [:answer/validate]} {:db/id "q-98142/selection/fb533f568ef1dc570f531c27462b7ed74930979df5ed56c31a79d0dc884f2e52" :answer/id #uuid "50abfb99-6628-5691-8a3d-f67ec195d897" :answer/type :answer.type/math :answer/value "4\\sqrt{3}\\,w" :db/ensure [:answer/validate]} {:db/id "q-98142/selection" :answer-field/id #uuid "833a71b8-5938-5587-a5b5-6597fde9bed4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98142/selection/fb533f568ef1dc570f531c27462b7ed74930979df5ed56c31a79d0dc884f2e52" :answer-field/choices ["q-98142/selection/28c4dd7810cac2a8042280140154960b69ed756d2785d98973578b4f3a443651" "q-98142/selection/a44acf8551890f27c17f602019269ef80b1d05b95b7d03977e0db8ab79c027ce" "q-98142/selection/e5d1aa1dfbaac0c721e527a91f392d9e58479f44059d9c1d0fbba06430db5105" "q-98142/selection/c805b7d266bc9562306b344554c0267fe0423ab00d3d7d0df1c8a3e6037963d1" "q-98142/selection/fb533f568ef1dc570f531c27462b7ed74930979df5ed56c31a79d0dc884f2e52"] :db/ensure [:answer-field/validate]} {:db/id "q-98142" :question/id #uuid "fb9ffaa1-a202-507f-aa7e-4d95a973e5e2" :question/math-academy-id "q-98142" :question/is-example false :question/problem "Calculate the distance between the points $(3w,2w,7w)$ and $(-w,6w,3w),$ given that $w$ is positive." :question/worked-solution "The distance $d$ between two points $({x}_{1},{y}_{1},{z}_{1})$ and $({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have ${{(3w,2w,7w)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(-w,6w,3w)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Applying the distance formula, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{(-w-3w{)}^{2}+(6w-2w{)}^{2}+(3w-7w{)}^{2}} \\\\  & =\\sqrt{(-4w{)}^{2}+(4w{)}^{2}+(-4w{)}^{2}} \\\\  & =\\sqrt{16{w}^{2}+16{w}^{2}+16{w}^{2}} \\\\  & =\\sqrt{48{w}^{2}} \\\\  & =\\sqrt{48}\\,\\sqrt{{w}^{2}} \\\\  & =4\\sqrt{3}\\,|w|.\\end{aligned}\n$$\n\nFinally, since $w$ is positive, we have $|w|=w.$ Therefore,\n\n$$\nd=4\\sqrt{3}\\,w.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98142/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d4e178c7-bdb4-5139-a20c-3e17de51ee11"] :knowledge-point/questions ["q-98142"] :db/ensure [:knowledge-point/validate]} {:db/id "q-262213/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "c408819d-2bce-59a4-ac90-4ef4f62eb63d" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-262213/field-1" :answer-field/id #uuid "0fee43ed-eb26-59a0-9017-0f3209718402" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-262213/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-262213/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-262213" :question/id #uuid "dbf029a1-26a8-5cd1-b398-2207c2da1538" :question/math-academy-id "q-262213" :question/is-example false :question/problem "The distance between the points $A(-1,4,-1)$ and $B(2,6,5)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(-1,4,-1)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,6,5)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-(-1){)}^{2}+(6-4{)}^{2}+(5-(-1){)}^{2}} \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}} \\\\  & =\\sqrt{9+4+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-262213/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7"] :knowledge-point/questions ["q-262213"] :db/ensure [:knowledge-point/validate]} {:db/id "q-262216/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "54a8a3e2-acdc-5dfe-887e-26eec66da0d9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-262216/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0c74c9b7-9277-5d89-99df-2106b8fecea3" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-262216/field-1" :answer-field/id #uuid "224286ef-6e0d-55fa-ac96-40bf3d2cddb1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-262216/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-262216/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-262216/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-262216" :question/id #uuid "7ece7e52-279f-5dba-9e0d-33706c4c02a1" :question/math-academy-id "q-262216" :question/is-example false :question/problem "The distance between the points $A(5,-2,-3)$ and $B(2,2,-3)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(5,-2,-3)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,2,-3)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-5{)}^{2}+(2-(-2){)}^{2}+(-3-(-3){)}^{2}} \\\\  & =\\sqrt{(-3{)}^{2}+{4}^{2}+{0}^{2}} \\\\  & =\\sqrt{9+16+0} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-262216/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7"] :knowledge-point/questions ["q-262216"] :db/ensure [:knowledge-point/validate]} {:db/id "q-262223/field-1/2d7938b36b9b608f1e882bd61e1f0c4189e0dfa0f27d73e4e30bacb9a2a85078" :answer/id #uuid "64a84aa1-aa02-5cf2-92ea-fdc4a10ca3f7" :answer/type :answer.type/math :answer/value "\\sqrt{21}" :db/ensure [:answer/validate]} {:db/id "q-262223/field-1" :answer-field/id #uuid "fd6529ac-fec9-532d-a9e4-73e695fa462f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-262223/field-1/2d7938b36b9b608f1e882bd61e1f0c4189e0dfa0f27d73e4e30bacb9a2a85078" :answer-field/choices ["q-262223/field-1/2d7938b36b9b608f1e882bd61e1f0c4189e0dfa0f27d73e4e30bacb9a2a85078"] :db/ensure [:answer-field/validate]} {:db/id "q-262223" :question/id #uuid "f252ca68-1ec7-54e9-bf4a-2b98cecc1ea3" :question/math-academy-id "q-262223" :question/is-example false :question/problem "The distance between the points $A(4,-2,-2)$ and $B(3,-4,2)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(4,-2,-2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(3,-4,2)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(3-4{)}^{2}+(-4-(-2){)}^{2}+(2-(-2){)}^{2}} \\\\  & =\\sqrt{(-1{)}^{2}+(-2{)}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+4+16} \\\\  & =\\sqrt{21}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-262223/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7"] :knowledge-point/questions ["q-262223"] :db/ensure [:knowledge-point/validate]}]
