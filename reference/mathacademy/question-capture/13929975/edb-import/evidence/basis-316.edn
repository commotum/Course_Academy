#{[{:db/id #edb/ref 17592186242671 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c408819d-2bce-59a4-ac90-4ef4f62eb63d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186242673}] :answer-field/correct {:answer/id #uuid "c408819d-2bce-59a4-ac90-4ef4f62eb63d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186242673} :answer-field/id #uuid "0fee43ed-eb26-59a0-9017-0f3209718402" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242672}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dbf029a1-26a8-5cd1-b398-2207c2da1538" :question/is-example false :question/math-academy-id "q-262213" :question/problem "The distance between the points $A(-1,4,-1)$ and $B(2,6,5)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(-1,4,-1)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,6,5)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-(-1){)}^{2}+(6-4{)}^{2}+(5-(-1){)}^{2}} \\\\  & =\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}} \\\\  & =\\sqrt{9+4+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242674 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c74c9b7-9277-5d89-99df-2106b8fecea3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242676} {:answer/id #uuid "54a8a3e2-acdc-5dfe-887e-26eec66da0d9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242677}] :answer-field/correct {:answer/id #uuid "54a8a3e2-acdc-5dfe-887e-26eec66da0d9" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242677} :answer-field/id #uuid "224286ef-6e0d-55fa-ac96-40bf3d2cddb1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242675}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7ece7e52-279f-5dba-9e0d-33706c4c02a1" :question/is-example false :question/math-academy-id "q-262216" :question/problem "The distance between the points $A(5,-2,-3)$ and $B(2,2,-3)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(5,-2,-3)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(2,2,-3)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(2-5{)}^{2}+(2-(-2){)}^{2}+(-3-(-3){)}^{2}} \\\\  & =\\sqrt{(-3{)}^{2}+{4}^{2}+{0}^{2}} \\\\  & =\\sqrt{9+16+0} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242678 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64a84aa1-aa02-5cf2-92ea-fdc4a10ca3f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186242680}] :answer-field/correct {:answer/id #uuid "64a84aa1-aa02-5cf2-92ea-fdc4a10ca3f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186242680} :answer-field/id #uuid "fd6529ac-fec9-532d-a9e4-73e695fa462f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242679}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f252ca68-1ec7-54e9-bf4a-2b98cecc1ea3" :question/is-example false :question/math-academy-id "q-262223" :question/problem "The distance between the points $A(4,-2,-2)$ and $B(3,-4,2)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(4,-2,-2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(3,-4,2)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(3-4{)}^{2}+(-4-(-2){)}^{2}+(2-(-2){)}^{2}} \\\\  & =\\sqrt{(-1{)}^{2}+(-2{)}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+4+16} \\\\  & =\\sqrt{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186074471 :knowledge-point/_questions [{:knowledge-point/id #uuid "d4e178c7-bdb4-5139-a20c-3e17de51ee11" :knowledge-point/title "Calculating the Distance Between Two Points With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3173d46-cd3e-58bb-8f99-a1d55f59bb8f" :answer/type {:db/ident :answer.type/math} :answer/value "± 2" :db/id #edb/ref 17592186073341} {:answer/id #uuid "f973cf96-67d7-55c5-825f-b2a7ef2f4fd2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186073342} {:answer/id #uuid "02a4f6f5-2e51-5fef-ab48-4f1869547b73" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186073343} {:answer/id #uuid "17bdc604-682d-5f66-a786-de386622c8bf" :answer/type {:db/ident :answer.type/math} :answer/value "± 3" :db/id #edb/ref 17592186073344} {:answer/id #uuid "4cafc32f-cfc4-5870-8bdc-ceabba952f3e" :answer/type {:db/ident :answer.type/math} :answer/value "± 5" :db/id #edb/ref 17592186073345}] :answer-field/correct {:answer/id #uuid "17bdc604-682d-5f66-a786-de386622c8bf" :answer/type {:db/ident :answer.type/math} :answer/value "± 3" :db/id #edb/ref 17592186073344} :answer-field/id #uuid "e0b17fb0-db16-5df3-b163-963b78eb4ef2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186073340}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "80fbb873-e940-547c-85d1-534e3310a7c5" :question/is-example false :question/math-academy-id "q-97794" :question/problem "Consider the points $A(p, 2p, 3p)$ and $B(p,-2p, 6p)$. Given that the distance between $A$ and $B$ is $15$, find the possible values of $p$." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have $A{{(p,2p,3p)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(p,-2p,6p)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(p-p{)}^{2}+(-2p-2p{)}^{2}+(6p-3p{)}^{2}} \\\\  & =\\sqrt{{0}^{2}+(-4p{)}^{2}+(3p{)}^{2}} \\\\  & =\\sqrt{16{p}^{2}+9{p}^{2}} \\\\  & =\\sqrt{25{p}^{2}} \\\\  & =5\\,|p|.\\end{aligned}\n$$\n\nFinally, since $d=15,$ we get\n\n$$\n\\begin{aligned}5\\,|p| & =15 \\\\ |p| & =3 \\\\ p & =\\pm 3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242681 :knowledge-point/_questions [{:knowledge-point/id #uuid "d4e178c7-bdb4-5139-a20c-3e17de51ee11" :knowledge-point/title "Calculating the Distance Between Two Points With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc09407a-bcd1-54d3-9697-104fedb1045a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}\\,w" :db/id #edb/ref 17592186242683} {:answer/id #uuid "c00df639-1b39-57c4-8a92-1ce2b9de74cc" :answer/type {:db/ident :answer.type/math} :answer/value "7w" :db/id #edb/ref 17592186242684} {:answer/id #uuid "c6d07571-d4d8-5988-900f-3588ed7b537a" :answer/type {:db/ident :answer.type/math} :answer/value "6w" :db/id #edb/ref 17592186242685} {:answer/id #uuid "8a8e7686-7ef1-5459-b6ab-d5490ae7920c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\,w" :db/id #edb/ref 17592186242686} {:answer/id #uuid "50abfb99-6628-5691-8a3d-f67ec195d897" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\,w" :db/id #edb/ref 17592186242687}] :answer-field/correct {:answer/id #uuid "50abfb99-6628-5691-8a3d-f67ec195d897" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\,w" :db/id #edb/ref 17592186242687} :answer-field/id #uuid "833a71b8-5938-5587-a5b5-6597fde9bed4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242682}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fb9ffaa1-a202-507f-aa7e-4d95a973e5e2" :question/is-example false :question/math-academy-id "q-98142" :question/problem "Calculate the distance between the points $(3w,2w,7w)$ and $(-w,6w,3w),$ given that $w$ is positive." :question/worked-solution "The distance $d$ between two points $({x}_{1},{y}_{1},{z}_{1})$ and $({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have ${{(3w,2w,7w)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(-w,6w,3w)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Applying the distance formula, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{(-w-3w{)}^{2}+(6w-2w{)}^{2}+(3w-7w{)}^{2}} \\\\  & =\\sqrt{(-4w{)}^{2}+(4w{)}^{2}+(-4w{)}^{2}} \\\\  & =\\sqrt{16{w}^{2}+16{w}^{2}+16{w}^{2}} \\\\  & =\\sqrt{48{w}^{2}} \\\\  & =\\sqrt{48}\\,\\sqrt{{w}^{2}} \\\\  & =4\\sqrt{3}\\,|w|.\\end{aligned}\n$$\n\nFinally, since $w$ is positive, we have $|w|=w.$ Therefore,\n\n$$\nd=4\\sqrt{3}\\,w.\n$$"}]}
