2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{22}\\ne 0$ (condition II is violated).\n\n$$\nB=[\\begin{aligned}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{aligned}]\n$$\n\nTherefore, only $B$ is **not** in row echelon form." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72575/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3"] :knowledge-point/questions ["q-72575"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72570/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "20b862d9-d9c1-59f3-931f-b125e94e3452" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-72570/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "7c082051-065e-5ee8-b7b4-ce2abea953cd" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-72570/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "0d45340e-5ad1-5c1e-ba6d-facf718c8fe7" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-72570/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "ebff7082-7cb2-53db-8baf-9f9a6ff5a55b" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-72570/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "824c8fb1-a345-5368-875a-a551d0e1dce3" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answ