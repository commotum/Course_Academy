 \\\\ -1 & 1 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st and $3$rd rows of $A$ are $4$ and $-1$, respectively.\n\n$$\nA=[\\begin{aligned}0 & 4 & 1 & -3 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & 0 & -1 & 1 \\\\ -1 & 1 & 0 & 0\\end{aligned}]\n$$\n\nSo, the answer is $4+(-1)=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb"] :knowledge-point/questions ["q-73143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129210/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "72c41345-bcc1-5a94-bc43-17008d0a509b" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-129210/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "d9a2383a-c510-51c6-9e69-2b4ee557a3f1" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-129210/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "33f5c5e9-20d6-55ef-8096-86e9af3e487e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-129210/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "740e1620-f50b-587e-8103-ddc3553daa71" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-129210/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4d68997f-19cd-5561-b23e-ed63bb45b2c6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129210/selection" :answer-field/id #uuid "e318616d-791c-5a03-93a3-ac99c3733229" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129210/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-129210/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-129210/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-129210/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-129210/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-129210/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-129210" :question/id #uuid "ea048481-9a85-5459-a314-8e26e851ea3b" :question/math-academy-id "q-129210" :question/problem "What is the sum of the leading entries of the $2$nd and $4$th rows in the matrix $A,$ given below?\n\n$$\nA=[\\begin{aligned}4 & 1 & -2 & 7 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 3 & 0 & -7\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $2$nd and $4$th rows of  $A$ are $1$ and $3$, respectively.\n\n$$\nA=[\\begin{aligned}4 & 1 & -2 & 7 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 0 & 0 & 6 \\\\ 0 & 3 & 0 & -7\\end{aligned}].\n$$\n\nSo, the answer is $1+3=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129210/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb"] :knowledge-point/questions ["q-129210"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72491/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "29a65063-853d-5a3b-a3e0-1a2fdd4bfe15" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-72491/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "b42d0231-1610-5a04-b9be-9527c66255de" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-72491/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" :answer/id #uuid "3f64a202-2b23-506d-aa37-d333e3bdaddd" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "q-72491/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "ec33bc2a-2c9f-52b9-b2b4-fe068198fb52" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-72491/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "a5973063-bbc9-50fa-9b33-23103ddfd6df" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-72491/selection" :answer-field/id #uuid "146ca6a7-1db4-5afc-8540-3285801c381b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72491/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer-field/choices ["q-72491/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-72491/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" "q-72491/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" "q-72491/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-72491/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d"] :db/ensure [:answer-field/validate]} {:db/id "q-72491" :question/id #uuid "307a31ed-3320-5bc6-9033-1067b69032de" :question/math-academy-id "q-72491" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}],\\,C=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{43}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}]\n$$\n\nTherefore, only $A$ and $C$ are **not** in row echelon form." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72491/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799"] :knowledge-point/questions ["q-72491"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129225/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "36a4c8a7-1f82-5acd-92a3-1a8263be8dfd" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-129225/selection/f073cec77042b855fcc95ae59e5c07a0d566930857e27de8effde7dcda1f144f" :answer/id #uuid "570c56a5-dd9c-5268-adcc-8e541e813115" :answer/type :answer.type/text :answer/value "$A,$ $B,$ and $C$" :db/ensure [:answer/validate]} {:db/id "q-129225/selection/b9