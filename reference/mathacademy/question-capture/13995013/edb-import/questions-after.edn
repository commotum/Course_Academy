#{[{:db/id #edb/ref 17592186284701 :knowledge-point/_questions [{:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1206802-f32f-52dd-a17f-b9ed17f6c521" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186284703}] :answer-field/correct {:answer/id #uuid "c1206802-f32f-52dd-a17f-b9ed17f6c521" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186284703} :answer-field/id #uuid "dec01293-ad56-5fe0-8ab6-befde9716b19" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284702} {:answer-field/choices [{:answer/id #uuid "6eae45c9-938f-56f9-af1f-676013f1786c" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186284705}] :answer-field/correct {:answer/id #uuid "6eae45c9-938f-56f9-af1f-676013f1786c" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186284705} :answer-field/id #uuid "aaab0f71-27e7-5c7b-8efe-1d883386aa48" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284704}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f32bfc0e-cc17-5330-92be-8cf66d45c131" :question/math-academy-id "q-277888" :question/problem "Solve the inequality $-{(\\frac{5}{3})}^{3-4x}<{8}^{3-x}.$\n\n{{field-1}}{{field-2}}\n$x\\,<\\,\\infty $" :question/worked-solution "Since ${8}^{3-x}$ is always positive and $-{(\\frac{5}{3})}^{3-4x}$ is always negative, we always have\n\n$$\n-{(\\frac{5}{3})}^{3-4x}<{8}^{3-x}.\n$$\n\nThis means that the given inequality is satisfied by all real values of $x.$\n\nTherefore,\n\n$$\n-\\infty <x<\\infty \n$$"}] [{:db/id #edb/ref 17592186284706 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3f315c9-57b5-55f2-806e-b96b3383142c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186284708} {:answer/id #uuid "0af4cfee-e1eb-5fa2-b114-8735d431e1d6" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186284709} {:answer/id #uuid "132dbda2-22cf-550f-aa27-44d46e835ce8" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2+\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186284710} {:answer/id #uuid "1941da76-6da4-519c-ab61-54f7ff4022e7" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186284711} {:answer/id #uuid "960ed352-1d65-557c-b6a3-ee87ec9dcf25" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186284712}] :answer-field/correct {:answer/id #uuid "960ed352-1d65-557c-b6a3-ee87ec9dcf25" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186284712} :answer-field/id #uuid "0c53fa3d-89f5-5417-96e7-e43da45d830a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284707}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6442f940-7379-5d45-a797-9e3a79792102" :question/math-academy-id "q-87827" :question/problem "Solve the inequality $5\\cdot {(\\frac{2}{3})}^{x}\\le 4.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}5\\cdot {(\\frac{2}{3})}^{x} & \\le 4 \\\\ {(\\frac{2}{3})}^{x} & \\le \\frac{4}{5}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{2}{3})}^{x}] & \\le \\operatorname{ln}⁡(\\frac{4}{5}) \\\\ x\\operatorname{ln}⁡(\\frac{2}{3}) & \\le \\operatorname{ln}⁡(\\frac{4}{5}) \\\\ x(\\operatorname{ln}⁡2-\\operatorname{ln}⁡3) & \\le \\operatorname{ln}⁡4-\\operatorname{ln}⁡5.\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡2-\\operatorname{ln}⁡3$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\ge \\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2-\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284713 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25218328-4940-5a13-ac81-adf2848b6140" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.72)}" :db/id #edb/ref 17592186284715} {:answer/id #uuid "d4037d79-85e3-5440-9bd9-3c7bd8c69eba" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(0.72)}{\\operatorname{ln}⁡(4)}" :db/id #edb/ref 17592186284716} {:answer/id #uuid "8d593cee-0187-5464-9504-bf09ee5cb993" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.70)}" :db/id #edb/ref 17592186284717} {:answer/id #uuid "ef685232-5ff2-5859-9b3a-06ff7ee8a4d6" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.72)}" :db/id #edb/ref 17592186284718} {:answer/id #uuid "f2a6662f-f1d8-54a7-8431-b76d861f2f21" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.75)}" :db/id #edb/ref 17592186284719}] :answer-field/correct {:answer/id #uuid "ef685232-5ff2-5859-9b3a-06ff7ee8a4d6" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.72)}" :db/id #edb/ref 17592186284718} :answer-field/id #uuid "094a8daf-b32f-52b2-9423-a8bf1db94a6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284714}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "76051b0e-a4ef-5e9a-997d-59eb3e716f57" :question/math-academy-id "q-87831" :question/problem "Solve the inequality ${(0.72)}^{x}-4\\le 0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(0.72)}^{x}-4 & \\le 0 \\\\ {(0.72)}^{x} & \\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.72)^{x}] & \\le \\operatorname{ln}⁡(4) \\\\ x\\operatorname{ln}⁡(0.72) & \\le \\operatorname{ln}⁡(4)\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡(0.72)$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\ge \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.72)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284720 :knowledge-point/_questions [{:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bd789f1-a0a6-5fcd-a043-00e3a810d88e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡9-\\operatorname{ln}⁡6}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186284722} {:answer/id #uuid "20cfa75a-cbd4-5179-9705-88d1124ec23b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡7-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186284723} {:answer/id #uuid "70b5254a-0d5a-51ab-90e2-4262fc1cd7cc" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡7+\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186284724} {:answer/id #uuid "01db4ad9-0edc-5a61-b520-f6163676a306" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡6-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡9}" :db/id #edb/ref 17592186284725} {:answer/id #uuid "d2a8c042-a7e2-5281-8eb8-6a7befd6eddd" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡6-\\operatorname{ln}⁡7}{\\operatorname{ln}⁡7+\\operatorname{ln}⁡9}" :db/id #edb/ref 17592186284726}] :answer-field/correct {:answer/id #uuid "20cfa75a-cbd4-5179-9705-88d1124ec23b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡7-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186284723} :answer-field/id #uuid "2cfb3ed8-013f-5358-8749-151bd9ac379f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284721}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fc502058-41ee-5a3d-ac39-7e9a39b84c93" :question/math-academy-id "q-87855" :question/problem "Solve the inequality $9\\cdot {6}^{x}\\ge {7}^{1-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}9\\cdot {6}^{x} & \\ge {7}^{1-x} \\\\ \\operatorname{ln}⁡(9\\cdot {6}^{x}) & \\ge \\operatorname{ln}⁡({7}^{1-x}) \\\\ \\operatorname{ln}⁡9+\\operatorname{ln}⁡({6}^{x}) & \\ge (1-x)\\operatorname{ln}⁡7 \\\\ \\operatorname{ln}⁡9+x\\operatorname{ln}⁡6 & \\ge \\operatorname{ln}⁡7-x\\operatorname{ln}⁡7 \\\\ x\\operatorname{ln}⁡6+x\\operatorname{ln}⁡7 & \\ge \\operatorname{ln}⁡7-\\operatorname{ln}⁡9 \\\\ x(\\operatorname{ln}⁡6+\\operatorname{ln}⁡7) & \\ge \\operatorname{ln}⁡7-\\operatorname{ln}⁡9 \\\\ x & \\ge \\frac{\\operatorname{ln}⁡7-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284727 :knowledge-point/_questions [{:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fcb3b9b-c81d-5d43-bf2b-e5f170beba1b" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186284729} {:answer/id #uuid "8667c300-1e1d-566d-af17-a3551bb30fb3" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{2}{3}" :db/id #edb/ref 17592186284730} {:answer/id #uuid "2bb344e8-c7d3-512d-ab0f-20cb3c37220c" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186284731} {:answer/id #uuid "59a9c254-9d5c-5f27-bf0b-34110025cba2" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{2}{15}" :db/id #edb/ref 17592186284732} {:answer/id #uuid "0b4f37b1-4b56-5fac-89e8-d2e300755d67" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{1}{15}" :db/id #edb/ref 17592186284733}] :answer-field/correct {:answer/id #uuid "2bb344e8-c7d3-512d-ab0f-20cb3c37220c" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186284731} :answer-field/id #uuid "c6189b56-e202-52f1-9594-1ce6f0a38186" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284728}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9120390f-51e3-5928-bab6-50b6203dc900" :question/math-academy-id "q-87873" :question/problem "Solve the inequality $-{e}^{3x-2}>15.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}-{e}^{3x-2} & >15 \\\\ {e}^{3x-2} & <-15.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n{e}^{3x-2}>0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality ${e}^{3x-2}<-15$ has no solutions."}]}
