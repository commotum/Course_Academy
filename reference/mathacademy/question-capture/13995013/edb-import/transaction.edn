 #uuid "76051b0e-a4ef-5e9a-997d-59eb3e716f57" :question/math-academy-id "q-87831" :question/problem "Solve the inequality ${(0.72)}^{x}-4\\le 0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(0.72)}^{x}-4 & \\le 0 \\\\ {(0.72)}^{x} & \\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.72)^{x}] & \\le \\operatorname{ln}⁡(4) \\\\ x\\operatorname{ln}⁡(0.72) & \\le \\operatorname{ln}⁡(4)\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡(0.72)$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\ge \\frac{\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(0.72)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87831/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4"] :knowledge-point/questions ["q-87831"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87855/selection/03545ba42da63fe08f868844fd7439e3e772590a69fcd5b36e4007fb65add679" :answer/id #uuid "6bd789f1-a0a6-5fcd-a043-00e3a810d88e" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡9-\\operatorname{ln}⁡6}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/ensure [:answer/validate]} {:db/id "q-87855/selection/31fe4729939a60014a5c2f383d312531c2f1fd685421e1c7fe947dc19041b26d" :answer/id #uuid "20cfa75a-cbd4-5179-9705-88d1124ec23b" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡7-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/ensure [:answer/validate]} {:db/id "q-87855/selection/ab4322daf8a4d6aae4af6eef8bb0d632860dd25bda38c396f1a21d43fd54f227" :answer/id #uuid "d2a8c042-a7e2-5281-8eb8-6a7befd6eddd" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡6-\\operatorname{ln}⁡7}{\\operatorname{ln}⁡7+\\operatorname{ln}⁡9}" :db/ensure [:answer/validate]} {:db/id "q-87855/selection/8a3daf7cc39cb77d6fbbe370c15a569685d85ca447c50d28769450555d42aef6" :answer/id #uuid "01db4ad9-0edc-5a61-b520-f6163676a306" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡6-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡9}" :db/ensure [:answer/validate]} {:db/id "q-87855/selection/47339633304e9673fa919026db4ea62be7c3c628bde87ca8c39fa8d8a7e8f26f" :answer/id #uuid "70b5254a-0d5a-51ab-90e2-4262fc1cd7cc" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡7+\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/ensure [:answer/validate]} {:db/id "q-87855/selection" :answer-field/id #uuid "2cfb3ed8-013f-5358-8749-151bd9ac379f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87855/selection/31fe4729939a60014a5c2f383d312531c2f1fd685421e1c7fe947dc19041b26d" :answer-field/choices ["q-87855/selection/03545ba42da63fe08f868844fd7439e3e772590a69fcd5b36e4007fb65add679" "q-87855/selection/31fe4729939a60014a5c2f383d312531c2f1fd685421e1c7fe947dc19041b26d" "q-87855/selection/ab4322daf8a4d6aae4af6eef8bb0d632860dd25bda38c396f1a21d43fd54f227" "q-87855/selection/8a3daf7cc39cb77d6fbbe370c15a569685d85ca447c50d28769450555d42aef6" "q-87855/selection/47339633304e9673fa919026db4ea62be7c3c628bde87ca8c39fa8d8a7e8f26f"] :db/ensure [:answer-field/validate]} {:db/id "q-87855" :question/id #uuid "fc502058-41ee-5a3d-ac39-7e9a39b84c93" :question/math-academy-id "q-87855" :question/problem "Solve the inequality $9\\cdot {6}^{x}\\ge {7}^{1-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}9\\cdot {6}^{x} & \\ge {7}^{1-x} \\\\ \\operatorname{ln}⁡(9\\cdot {6}^{x}) & \\ge \\operatorname{ln}⁡({7}^{1-x}) \\\\ \\operatorname{ln}⁡9+\\operatorname{ln}⁡({6}^{x}) & \\ge (1-x)\\operatorname{ln}⁡7 \\\\ \\operatorname{ln}⁡9+x\\operatorname{ln}⁡6 & \\ge \\operatorname{ln}⁡7-x\\operatorname{ln}⁡7 \\\\ x\\operatorname{ln}⁡6+x\\operatorname{ln}⁡7 & \\ge \\operatorname{ln}⁡7-\\operatorname{ln}⁡9 \\\\ x(\\operatorname{ln}⁡6+\\operatorname{ln}⁡7) & \\ge \\operatorname{ln}⁡7-\\operatorname{ln}⁡9 \\\\ x & \\ge \\frac{\\operatorname{ln}⁡7-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87855/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-87855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87873/selection/873fee144c562d75bf7a69d698fa20eb4b5da424686a8109c9d38df787728712" :answer/id #uuid "59a9c254-9d5c-5f27-bf0b-34110025cba2" :answer/type :answer.type/math :answer/value "x>\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "q-87873/selection/4ce1f73e578c4deeb421e4985180e57c6a369d9e632ecf09a22e0d2fc0d123e0" :answer/id #uuid "8667c300-1e1d-566d-af17-a3551bb30fb3" :answer/type :answer.type/math :answer/value "x<\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-87873/selection/12cf5bf844cf95b95e80f529266ac6af4ed60a8ea790e2b44db6283719be635c" :answer/id #uuid "1fcb3b9b-c81d-5d43-bf2b-e5f170beba1b" :answer/type :answer.type/text :answer/value "all real numbers" :db/ensure [:answer/validate]} {:db/id "q-87873/selection/9c3b19a2c5ac704f92ee2acd03e3527c1f639a93604d0efe248cce942fd57dc1" :answer/id #uuid "0b4f37b1-4b56-5fac-89e8-d2e300755d67" :answer/type :answer.type/math :answer/value "x<\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "q-87873/selection/52f8bfd00f6b3deb0e93232df027641f8c16cee0e37ff5f896dd75bd009234e2" :answer/id #uuid "2bb344e8-c7d3-512d-ab0f-20cb3c37220c" :answer/type :answer.type/text :answer/value "no solutions" :db/ensure [:answer/validate]} {:db/id "q-87873/selection" :answer-field/id #uuid "c6189b56-e202-52f1-9594-1ce6f0a38186" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87873/selection/52f8bfd00f6b3deb0e93232df027641f8c16cee0e37ff5f896dd75bd009234e2" :answer-field/choices ["q-87873/selection/873fee144c562d75bf7a69d698fa20eb4b5da424686a8109c9d38df787728712" "q-87873/selection/4ce1f73e578c4deeb421e4985180e57c6a369d9e632ecf09a22e0d2fc0d123e0" "q-87873/selection/12cf5bf844cf95b95e80f529266ac6af4ed60a8ea790e2b44db6283719be635c" "q-87873/selection/9c3b19a2c5ac704f92ee2acd03e3527c1f639a93604d0efe248cce942fd57dc1" "q-87873/selection/52f8bfd00f6b3deb0e93232df027641f8c16cee0e37ff5f896dd75bd009234e2"] :db/ensure [:answer-field/validate]} {:db/id "q-87873" :question/id #uuid "9120390f-51e3-5928-bab6-50b6203dc900" :question/math-academy-id "q-87873" :question/problem "Solve the inequality $-{e}^{3x-2}>15.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}-{e}^{3x-2} & >15 \\\\ {e}^{3x-2} & <-15.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n{e}^{3x-2}>0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality ${e}^{3x-2}<-15$ has no solutions." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87873/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa"] :knowledge-point/questions ["q-87873"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277888/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "c1206802-f32f-52dd-a17f-b9ed17f6c521" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-277888/field-1" :answer-field/id #uuid "dec01293-ad56-5fe0-8ab6-befde9716b19" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277888/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer-field/choices ["q-277888/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934"] :db/ensure [:answer-field/validate]} {:db/id "q-277888/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "6eae45c9-938f-56f9-af1f-676013f1786c" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-277888/field-2" :answer-field/id #uuid "aaab0f71-27e7-5c7b-8efe-1d883386aa48" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277888/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-277888/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-277888" :question/id #uuid "f32bfc0e-cc17-5330-92be-8cf66d45c131" :question/math-academy-id "q-277888" :question/problem "Solve the inequality $-{(\\frac{5}{3})}^{3-4x}<{8}^{3-x}.$\n\n{{field-1}}{{field-2}}\n$x\\,<\\,\\infty $" :question/worked-solution "Since ${8}^{3-x}$ is always positive and $-{(\\frac{5}{3})}^{3-4x}$ is always negative, we always have\n\n$$\n-{(\\frac{5}{3})}^{3-4x}<{8}^{3-x}.\n$$\n\nThis means that the given inequality is satisfied by all real values of $x.$\n\nTherefore,\n\n$$\n-\\infty <x<\\infty \n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-277888/field-1" "q-277888/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-277888"] :db/ensure [:knowledge-point/validate]}]
