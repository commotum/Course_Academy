c{5-p}{p} & = \\\\ \\frac{3p}{p}+\\frac{5-p}{p}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3p}{p}+\\frac{5-p}{p} & = \\\\ \\frac{3p+5-p}{p} & = \\\\ \\frac{2p+5}{p}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113217/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-113217"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113225/selection/d21de30997e00f50d6bffcb4c7974df877ea874e301fd796d44f435fee546188" :answer/id #uuid "991076ce-2af0-55f2-bfe6-dc38edd9ed6e" :answer/type :answer.type/math :answer/value "-\\frac{3(w+8)}{w+4}" :db/ensure [:answer/validate]} {:db/id "q-113225/selection/dbd815975773d2afbd5400a0c10c669f327e451bb6c08b477a53f73251a79701" :answer/id #uuid "7ab30660-4d02-5fe7-90e2-d43f7ea1ca67" :answer/type :answer.type/math :answer/value "-\\frac{3w+10}{w+4}" :db/ensure [:answer/validate]} {:db/id "q-113225/selection/08be96ac67cf050f56148347fa94b7985c9c0ca6aa4d403cb2200ada93f9c662" :answer/id #uuid "df136a3c-0c94-558d-8875-21bb302f26a0" :answer/type :answer.type/math :answer/value "-\\frac{w+8}{w+4}" :db/ensure [:answer/validate]} {:db/id "q-113225/selection/0d552facbd6ea71cebfe8594a70359805547a4c15124898301f1866f7dc2a012" :answer/id #uuid "047cf466-15a1-57d1-86a4-70733122e133" :answer/type :answer.type/math :answer/value "\\frac{3(w-4)}{w+4}" :db/ensure [:answer/validate]} {:db/id "q-113225/selection/61d4b175b3fb19d599f02c7aa721249301b8f73428d2ae67adc4c85d0640b761" :answer/id #uuid "94e3ab92-1f0e-57a3-a793-d52dafe8e1d5" :answer/type :answer.type/math :answer/value "-\\frac{w+24}{w+4}" :db/ensure [:answer/validate]} {:db/id "q-113225/selection" :answer-field/id #uuid "6e452f2a-dcba-5730-9761-703baf6d43d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113225/selection/d21de30997e00f50d6bffcb4c7974df877ea874e301fd796d44f435fee546188" :answer-field/choices ["q-113225/selection/d21de30997e00f50d6bffcb4c7974df877ea874e301fd796d44f435fee546188" "q-113225/selection/dbd815975773d2afbd5400a0c10c669f327e451bb6c08b477a53f73251a79701" "q-113225/selection/08be96ac67cf050f56148347fa94b7985c9c0ca6aa4d403cb2200ada93f9c662" "q-113225/selection/0d552facbd6ea71cebfe8594a70359805547a4c15124898301f1866f7dc2a012" "q-113225/selection/61d4b175b3fb19d599f02c7aa721249301b8f73428d2ae67adc4c85d0640b761"] :db/ensure [:answer-field/validate]} {:db/id "q-113225" :question/id #uuid "8208ac8f-2edb-5e55-90bc-68d51c8ee105" :question/math-academy-id "q-113225" :question/is-example false :question/problem "Write $\\frac{3w}{w+4}-6$ as a single fraction." :question/worked-solution "Using the fact that $6=\\frac{6}{1}$, we can write the expression as\n\n$$\n\\frac{3w}{w+4}-\\frac{6}{1}.\n$$\n\n \n\nIn order to subtract the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $w+4$ by multiplying the top and bottom of the second fraction by $w+4:$\n\n$$\n\\begin{aligned}\\frac{3w}{w+4}-\\frac{6}{1} & = \\\\ \\frac{3w}{w+4}-\\frac{w+4}{w+4}\\cdot \\frac{6}{1} & = \\\\ \\frac{3w}{w+4}-\\frac{6(w+4)}{w+4}\\end{aligned}\n$$\n\nFinally, we subtract the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3w}{w+4}-\\frac{6(w+4)}{w+4} & = \\\\ \\frac{3w-6(w+4)}{w+4} & = \\\\ \\frac{3w-6w-24}{w+4} & = \\\\ \\frac{-3w-24}{w+4} & = \\\\ -\\frac{3(w+8)}{w+4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113225/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-113225"] :db/ensure [:knowledge-point/validate]}]
