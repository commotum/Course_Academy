re [:question/validate]} {:db/id [:knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3"] :knowledge-point/questions ["q-69903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70295/selection/a077b01c15c69bbdf66f873a396e9080196cbe7f222ff47a366abfd16629e9b3" :answer/id #uuid "aa1f829e-5b7d-5bd2-90fd-a52349346cdc" :answer/type :answer.type/math :answer/value "\\frac{2wz-4w-3}{(z-1)(2w-3)}" :db/ensure [:answer/validate]} {:db/id "q-70295/selection/14a9cbaaafeb6b64fc631a309b7b2e1257cbc08f571da670b212680020529f51" :answer/id #uuid "78892bff-703c-568b-965b-b2a5de7c1864" :answer/type :answer.type/math :answer/value "\\frac{2wz-3}{(z-1)(2w-3)}" :db/ensure [:answer/validate]} {:db/id "q-70295/selection/8d5d71c79c1886b1384af804ff9bf46d5df58d6d0e467921a842c46185bce8be" :answer/id #uuid "a008b897-1f0d-5efc-8252-d783b1545b8b" :answer/type :answer.type/math :answer/value "\\frac{4w-2wz}{(z-1)(2w-3)}" :db/ensure [:answer/validate]} {:db/id "q-70295/selection/0fa3f68dd969c41f66ba1ad2408a3babb273a69cf9bed7412f959abf84a8b16f" :answer/id #uuid "a2c9c902-abee-5a3a-89a0-57cdca476b16" :answer/type :answer.type/math :answer/value "\\frac{2wz-4z+3}{(z-1)(2w-3)}" :db/ensure [:answer/validate]} {:db/id "q-70295/selection/7a3b7dfd0894be8b1e8627d04c00af67b13bd3f486ba592862b4babba814976f" :answer/id #uuid "29e9c33e-e143-5bc0-af93-91981c446fb8" :answer/type :answer.type/math :answer/value "\\frac{2wz-3z}{(z-1)(2w-3)}" :db/ensure [:answer/validate]} {:db/id "q-70295/selection" :answer-field/id #uuid "f2c58060-ddbd-5a62-a914-e817afee1448" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70295/selection/14a9cbaaafeb6b64fc631a309b7b2e1257cbc08f571da670b212680020529f51" :answer-field/choices ["q-70295/selection/a077b01c15c69bbdf66f873a396e9080196cbe7f222ff47a366abfd16629e9b3" "q-70295/selection/14a9cbaaafeb6b64fc631a309b7b2e1257cbc08f571da670b212680020529f51" "q-70295/selection/8d5d71c79c1886b1384af804ff9bf46d5df58d6d0e467921a842c46185bce8be" "q-70295/selection/0fa3f68dd969c41f66ba1ad2408a3babb273a69cf9bed7412f959abf84a8b16f" "q-70295/selection/7a3b7dfd0894be8b1e8627d04c00af67b13bd3f486ba592862b4babba814976f"] :db/ensure [:answer-field/validate]} {:db/id "q-70295" :question/id #uuid "c462f9dc-0271-5628-94dd-832997d4ff88" :question/math-academy-id "q-70295" :question/is-example false :question/problem "$\\frac{1}{z-1}+\\frac{2w}{2w-3}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $(z-1)(2w-3),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $2w-3,$ and the top and bottom of the second fraction by $z-1:$ \n\n$$\n\\begin{aligned}\\frac{1}{z-1}+\\frac{2w}{2w-3} & = \\\\ \\frac{2w-3}{2w-3}\\cdot \\frac{1}{z-1}+\\frac{z-1}{z-1}\\cdot \\frac{2w}{2w-3} & = \\\\ \\frac{2w-3}{(z-1)(2w-3)}+\\frac{(z-1)2w}{(z-1)(2w-3)} & = \\\\ \\frac{(2w-3)+(z-1)2w}{(z-1)(2w-3)} & = \\\\ \\frac{2w-3+2wz-2w}{(z-1)(2w-3)} & = \\\\ \\frac{2wz-3}{(z-1)(2w-3)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70295/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3"] :knowledge-point/questions ["q-70295"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113217/selection/9cfea46cbca16be2eec7e2ba4ebc5f5feedde5772b2c57172587b94b04c01dd5" :answer/id #uuid "d88ff7dd-55d4-51b2-8a10-8d04a1ebd62d" :answer/type :answer.type/math :answer/value "\\frac{2p-5}{p}" :db/ensure [:answer/validate]} {:db/id "q-113217/selection/11e694106669edf196fdf2dd1451428f35f6fb7018311bb6cfc0a5539bba7ca1" :answer/id #uuid "18fdd50c-5776-5421-9044-525658077004" :answer/type :answer.type/math :answer/value "\\frac{2p+5}{p}" :db/ensure [:answer/validate]} {:db/id "q-113217/selection/ded9689ba8ef85583d0e8ac89f28c0c9a992c00ed24f30bde39dcf7921ba1a94" :answer/id #uuid "bf67acc6-8a4a-5066-b5c5-7fbcece54f