#{[{:db/id #edb/ref 17592186339273 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc35e15-010d-5c1c-a2b8-a51fad741f64" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/94247512fd446447144d808c76d00bc9c0d50d4175697597360117eca00b3cf1.png" :db/id #edb/ref 17592186339275} {:answer/id #uuid "75adcf9e-815d-57a1-887d-20ffd3892bab" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/57bedcb6a7191770472af16526b2172ad0c8da718de33b606bc168c514a367d8.png" :db/id #edb/ref 17592186339276} {:answer/id #uuid "d1e3c743-cfa3-5cc0-a1c7-9b4575fbab2e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/aefad4c0112e05c1a014ab7a6c684207d047971eccff5fc1b1a637b7d09d8e94.png" :db/id #edb/ref 17592186339277} {:answer/id #uuid "397aa031-151c-5547-82fb-185687a4d390" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/fc9a40db16e8434cadb89266518dcf56c6ed60213ecde42d237229466cdd99d0.png" :db/id #edb/ref 17592186339278} {:answer/id #uuid "3b9a074c-6f79-53eb-9290-67e60175eb82" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/12850dda11d88566b9f62cb9a3d91b79c2b32900c76280257aae14aa69375ef9.png" :db/id #edb/ref 17592186339279}] :answer-field/correct {:answer/id #uuid "6fc35e15-010d-5c1c-a2b8-a51fad741f64" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/94247512fd446447144d808c76d00bc9c0d50d4175697597360117eca00b3cf1.png" :db/id #edb/ref 17592186339275} :answer-field/id #uuid "94dd94f9-a34d-504b-a190-d7ad674ef9ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339274}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "de2d7c97-764c-58c0-b8ba-f8d09c210ae1" :question/math-academy-id "q-147561" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/d88ae8667df81624f0a28295c980f846ae88e9b4766fe0d0f692dd75509a56e9.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 8 & 4\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 8 & 4\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 5 & 2 \\\\ 4 & 20 & 8\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(1,4)$, $(5,20)$, and  $(2,8).$  Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/94247512fd446447144d808c76d00bc9c0d50d4175697597360117eca00b3cf1.png)"}] [{:db/id #edb/ref 17592186339280 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e4a8430-6b20-5a38-879f-aed55131dec6" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/5e316ceff92e78155ee352a2e5c3c526d30852fb1803fd9cfb938bea3e5cf984.png" :db/id #edb/ref 17592186339282} {:answer/id #uuid "ee0afb26-d708-5013-83f4-7d011a687b0b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/dfa05a8c2c943d5f74e5e5fef468006117c97b2d3d0a7b7a6b9c2024b6089272.png" :db/id #edb/ref 17592186339283} {:answer/id #uuid "00397b04-978a-5183-bc58-165cbe505603" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/d3f815e4205f0a24a125162072843fe507d0683ce40a89fdd13ee29c296f7500.png" :db/id #edb/ref 17592186339284} {:answer/id #uuid "2aa6565e-339f-5618-9b98-de9e108cd1e9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/b6fe02d5b3d96aeaa6a4edc9a027ec69993330252322e10a57618dd499bb02b5.png" :db/id #edb/ref 17592186339285} {:answer/id #uuid "d91a02e3-6aaa-5ee7-864a-e5b3a2781b4b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/6ba878568654dc85dba3ac561617132f851e62b63473eb8239fa716f53cd0dcd.png" :db/id #edb/ref 17592186339286}] :answer-field/correct {:answer/id #uuid "2aa6565e-339f-5618-9b98-de9e108cd1e9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/b6fe02d5b3d96aeaa6a4edc9a027ec69993330252322e10a57618dd499bb02b5.png" :db/id #edb/ref 17592186339285} :answer-field/id #uuid "156c3aba-8995-5b5c-b49c-308998a55d7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339281}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "873c9a2b-8c1b-5842-a449-297472752d44" :question/math-academy-id "q-147605" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/add078cb1b05f772f25c91a4736f5aacd4490ff8556ce6a0d0ea7ad44869d0e7.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & 1 \\\\ 10 & -5\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & -1 \\\\ 0 & 2 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & 1 \\\\ 10 & -5\\end{aligned}][\\begin{aligned}1 & 1 & -1 \\\\ 0 & 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 0 & 4 \\\\ 10 & 0 & -20\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,10)$, $(0,0),$ $(4,-20).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/8c86cb108725b3f1c7b5731dda0f11a5cb21a7daa023c5153cce1ece3ba6ba0f.png)"}] [{:db/id #edb/ref 17592186105993 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fea43b6-fd7b-5edc-b6b7-7f8b2cbab502" :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bb34d14-4e6b-5921-bbae-0804ad06b4f2" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186102206} {:answer/id #uuid "b2b33753-c1ca-54f2-b9c6-98ba27f6fa8e" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186102207} {:answer/id #uuid "cb1ac350-98a0-5f6c-8490-7f08a97c5de0" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186102208} {:answer/id #uuid "1338e2d6-476a-5cc4-a9f7-69b9fb7f0f6c" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186102209} {:answer/id #uuid "39e1c3d2-cf9c-5c0f-ac61-180359ad5ac6" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186102210}] :answer-field/correct {:answer/id #uuid "1338e2d6-476a-5cc4-a9f7-69b9fb7f0f6c" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186102209} :answer-field/id #uuid "98d6bd43-1322-57b8-8f87-0e031cdaba61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102205}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ba678a53-c013-5d44-b391-2d5cc0a9cc96" :question/math-academy-id "q-162150" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/e2ab6906100a96a123b4b1520613f1e38fe2c7e77af390a8efe0596a2861727d.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin."}] [{:db/id #edb/ref 17592186339287 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fea43b6-fd7b-5edc-b6b7-7f8b2cbab502" :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "876b4bd5-718d-5deb-9d7e-2d10440aca4e" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186339289} {:answer/id #uuid "c1114dec-3774-5e74-9ef0-1c064c926d9c" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186339290} {:answer/id #uuid "d14ed35a-8d21-5643-bb24-7ac6b5632bba" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186339291} {:answer/id #uuid "2bb68096-50a5-5fda-942e-4abd37aa54f1" :answer/type {:db/ident :answer.type/text} :answer/value "A quadrilateral" :db/id #edb/ref 17592186339292} {:answer/id #uuid "62696a8e-2598-5fc7-b61e-1fa63b4062fa" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186339293}] :answer-field/correct {:answer/id #uuid "d14ed35a-8d21-5643-bb24-7ac6b5632bba" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186339291} :answer-field/id #uuid "b4b2c88e-6c1e-5b13-ad87-12bf23911a60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339288}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2ebf302f-e626-5c64-a0a0-339c0907c8f2" :question/math-academy-id "q-162204" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/2cb5cf6d3307c1291dbbb785cd71ed6edecba3d448afbc2f5f5c2d1128b457c1.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & -4 \\\\ 3 & 6\\end{aligned}].\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-2 & -4 \\\\ 3 & 6\\end{aligned}| \\\\  & =(-2)\\cdot 6-(-4)\\cdot 3 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the quadrilateral under the action of $T$ is a line segment."}] [{:db/id #edb/ref 17592186106472 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5e3475-705f-5e07-a5df-5e5f30b47be7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-4.png" :db/id #edb/ref 17592186105342} {:answer/id #uuid "aacc0592-89fa-52a0-81dd-48065c4b6f9e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-5.png" :db/id #edb/ref 17592186105343} {:answer/id #uuid "afd277bf-e8b4-5e67-9d77-55f526df47de" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-1.png" :db/id #edb/ref 17592186105344} {:answer/id #uuid "de2919ea-f3fb-55b3-aff8-b42cfbf3a8ed" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-3.png" :db/id #edb/ref 17592186105345} {:answer/id #uuid "08eb15e4-d5fa-5245-88af-72443c000031" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-2.png" :db/id #edb/ref 17592186105346}] :answer-field/correct {:answer/id #uuid "afd277bf-e8b4-5e67-9d77-55f526df47de" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-96873-a-1.png" :db/id #edb/ref 17592186105344} :answer-field/id #uuid "ed2c47ad-e3f3-568d-9d77-d15b18ef1495" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105341}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e654df3b-ce22-5258-85fb-03604192e335" :question/math-academy-id "q-96873" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/131d9f30fac5b1cc4b8eb72a989ca16b0d3cbf7d16725aa38581bfd115b1fc77.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & -2 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}1 & 1 & -2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 & -4 \\\\ -2 & 2 & 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(1,-2)$, $(-1,2),$ $(-4,8).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060375/assets/87d2a7f522d68e1a50d9c5bb5e33498b2a28e869785f5109c4f6bf3a1c7ff701.png)"}]}
