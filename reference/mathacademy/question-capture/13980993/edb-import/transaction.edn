97721582e9dfa6a54ca01a18ec1b9a8357846e6de"] :db/ensure [:answer-field/validate]} {:db/id "q-116595" :question/id #uuid "c253474c-d011-5341-9695-96e00a1c311b" :question/math-academy-id "q-116595" :question/problem "Solve the inequality $(x+2)^{4}(x+5)(x-7)\\ge 0.$" :question/worked-solution "First, we define the function $f(x)$ as\n\n$$\nf(x)=(x+2)^{4}(x+5)(x-7).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-5,$ $x=-2,$ and $x=7.$ These roots divide the number line into $4$ subintervals:\n\n$$\n(-\\infty ,-5),\\,(-5,-2),\\,(-2,7),\\,(7,\\infty ).\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-5)$ | $(-5,-2)$ | $(-2,7)$ | $(7,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $(x+2)^{4}$ | $+$ | $+$ | $+$ | $+$ |\n| $x+5$ | $-$ | $+$ | $+$ | $+$ |\n| $x-7$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $+$ | $-$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-\\infty ,-5)$ and $(7,\\infty ).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in (-\\infty ,-5]\\cup {-2}\\cup [7,\\infty ).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116595/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e675f1c-9093-5f6e-a3b3-112d0bc8e516"] :knowledge-point/questions ["q-116595"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281717/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "188e62fd-bcd1-515a-8207-c1117a4b8b65" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-281717/field-1" :answer-field/id #uuid "9de28166-112d-518d-b5b6-b0cbb728e0ac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281717/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-281717/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-281717/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "14dbbfa6-dab4-5569-84e5-58a5ee903d80" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-281717/field-2" :answer-field/id #uuid "c203be72-1752-5ca2-ab60-aa25ca1d31e0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281717/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-281717/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-281717/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "72683dbe-cf0f-582b-baee-87854a8639b8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-281717/field-3" :answer-field/id #uuid "f3cae0d2-51a5-5ad4-87ee-e837d408487b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281717/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-281717/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-281717" :question/id #uuid "01fdc9a5-492f-5aee-bfa0-e1d7b2a5216c" :question/math-academy-id "q-281717" :question/problem "Solve the inequality $(3x-1)^{2}(2x+5)^{2}(4-x)(x-2)\\ge 0.$\n\n$x\\in $\n${-\\frac{5}{2},$\n{{field-1}}\n$}⋃$\n$[$\n{{field-2}}$,$\n{{field-3}}$]$" :question/worked-solution "First, we define the function $f(x)$ as\n\n$$\nf(x)=(3x-1)^{2}(2x+5)^{2}(4-x)(x-2).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-\\frac{5}{2},\\text{ }\\frac{1}{3},\\text{ }2,$ and $4.$ These roots divide the number line into five subintervals:\n\n$$\n(-\\infty ,-\\frac{5}{2}),\\,(-\\frac{5}{2},\\frac{1}{3}),\\,(\\frac{1}{3},2),\\,(2,4),\\,(4,\\infty )\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-\\frac{5}{2})$ | $(-\\frac{5}{2},\\frac{1}{3})$ | $(\\frac{1}{3},2)$ | $(2,4)$ | $(4,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| $(3x-1)^{2}$ | $+$ | $+$ | $+$ | $+$ | $+$ |\n| $(2x+5)^{2}$ | $+$ | $+$ | $+$ | $+$ | $+$ |\n| $(4-x)$ | $+$ | $+$ | $+$ | $+$ | $-$ |\n| $(x-2)$ | $-$ | $-$ | $-$ | $+$ | $+$ |\n| $f(x)$ | $-$ | $-$ | $-$ | $+$ | $-$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is non-negative only on the closed interval $(2,4).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in {-\\frac{5}{2},\\frac{1}{3}}⋃[2,4].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-281717/field-1" "q-281717/field-2" "q-281717/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e675f1c-9093-5f6e-a3b3-112d0bc8e516"] :knowledge-point/questions ["q-281717"] :db/ensure [:knowledge-point/validate]} {:db/id "q-271009/field-1/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "b6298571-17b7-5765-ae0c-aa55e392b979" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-271009/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "80d732d0-d7d9-512e-84d8-643ace5a0de7" 