[{:db/id "q-10258/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" :answer/id #uuid "fdd65c43-ddc8-5344-b3b9-3702eed0dce3" :answer/type :answer.type/math :answer/value "2{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-10258/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer/id #uuid "bd30ebf2-ffc3-591f-8036-c0aa8770a6d6" :answer/type :answer.type/math :answer/value "{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-10258/selection/befd90710524d6816cc6f9000f5fcbe3588260409ac32225f1f54a2401a94bd5" :answer/id #uuid "5631dfe0-b479-5513-aca5-2762fb01e883" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-10258/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "423803cf-f495-5387-8d96-c0349a4f6072" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-10258/selection/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" :answer/id #uuid "f0c29155-bdc8-5348-a88b-52111ff9b6fb" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-10258/selection" :answer-field/id #uuid "25eeb9f8-033d-5747-aea9-ee634ba6fa53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10258/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer-field/choices ["q-10258/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" "q-10258/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" "q-10258/selection/befd90710524d6816cc6f9000f5fcbe3588260409ac32225f1f54a2401a94bd5" "q-10258/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-10258/selection/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc"] :db/ensure [:answer-field/validate]} {:db/id "q-10258" :question/id #uuid "cb154f08-6559-53b7-a400-880200f1e12f" :question/math-academy-id "q-10258" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t),\\,y=2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)) \\\\  & =2\\operatorname{cos}⁡t-2(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =2t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)) \\\\  & =-2\\operatorname{sin}⁡t+2(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =2t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(2t\\operatorname{sin}⁡t)}^{2}+{(2t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =2\\cdot {\\frac{{t}^{2}}{2}|}_{0}^{\\pi } \\\\  & =2(\\frac{{\\pi }^{2}}{2}-0) \\\\  & ={\\pi }^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10258/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-10258"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20909/selection/e3ba9c2a19ac23a6b09f9fc93611907b4ad5420fabf42ec148f1dd58767f682a" :answer/id #uuid "d1b9ffae-5a7e-5786-93e9-5aafbda20223" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-20909/selection/04eb01f64e2d03bd833cfd13e48238aa20213bae1b930c24b6ba3a6255c4e5b0" :answer/id #uuid "f2ba8a55-9456-51de-b7e6-0805dac7bedd" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{{e}^{t}+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-20909/selection/fd9307ccabd67e6c8b0bd77adffec814f5e8940c596e7ccb380e3d9bd371e357" :answer/id #uuid "4d2b126f-98d4-577c-928e-023fd72e4c21" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-20909/selection/9784f9cad855d9567ae63cf8791ba0e79f9eba530ff915d7378a1611d078199a" :answer/id #uuid "b638de2f-2e5f-5a30-86a8-a49c4d621517" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{t}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-20909/selection/4a3b03c59b054fb2f187f29588e761ecb4e00ca8bdb227c9367b51aebfd56e11" :answer/id #uuid "3fcb735f-dca9-5f5e-818c-db3a5680cf32" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{2{e}^{2t}+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-20909/selection" :answer-field/id #uuid "68fb0ed2-9407-580f-a58e-21c6c77c8450" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20909/selection/e3ba9c2a19ac23a6b09f9fc93611907b4ad5420fabf42ec148f1dd58767f682a" :answer-field/choices ["q-20909/selection/e3ba9c2a19ac23a6b09f9fc93611907b4ad5420fabf42ec148f1dd58767f682a" "q-20909/selection/04eb01f64e2d03bd833cfd13e48238aa20213bae1b930c24b6ba3a6255c4e5b0" "q-20909/selection/fd9307ccabd67e6c8b0bd77adffec814f5e8940c596e7ccb380e3d9bd371e357" "q-20909/selection/9784f9cad855d9567ae63cf8791ba0e79f9eba530ff915d7378a1611d078199a" "q-20909/selection/4a3b03c59b054fb2f187f29588e761ecb4e00ca8bdb227c9367b51aebfd56e11"] :db/ensure [:answer-field/validate]} {:db/id "q-20909" :question/id #uuid "c830167c-2696-5fc6-a132-b4bf04199a72" :question/math-academy-id "q-20909" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\nWe have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(\\frac{1}{2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{({e}^{2t})+(\\frac{1}{4})}\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20909/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-20909"] :db/ensure [:knowledge-point/validate]} {:db/id "q-21353/selection/5b461e4903fb4bee4f79d553c19d82e10b7fca5b81938ce6c1f17524c645cae5" :answer/id #uuid "2a684d34-bd7d-5ef9-afa9-418142c319f7" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}-1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21353/selection/ab085eada8d1cb2a4e0a13c971229214251ee420d58bbe10b3701251d8e06a68" :answer/id #uuid "56dc4cb4-a3ba-5823-89e0-c31480c5d08e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}-1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21353/selection/f77449b054077c6635f64812fca71989595025ca736dec80738f65f0ecd99b93" :answer/id #uuid "df7caecb-1e07-5509-a6c7-7b8bcef62c1e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21353/selection/e092321e2e4f8bc3636dc17c8c6744be3bf80df081965cc40b7eb847c1120622" :answer/id #uuid "832e380e-b74e-5982-9caa-3d3906f19aef" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21353/selection/a56cb9e9bd58be975cee4966957fbc6a18064f99257910fef0bc6eb646ae268b" :answer/id #uuid "0f51bbc6-25c6-556b-822b-a62236f54b3a" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21353/selection" :answer-field/id #uuid "940d0cdb-9b17-536f-bd8c-5523d35fb495" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-21353/selection/f77449b054077c6635f64812fca71989595025ca736dec80738f65f0ecd99b93" :answer-field/choices ["q-21353/selection/5b461e4903fb4bee4f79d553c19d82e10b7fca5b81938ce6c1f17524c645cae5" "q-21353/selection/ab085eada8d1cb2a4e0a13c971229214251ee420d58bbe10b3701251d8e06a68" "q-21353/selection/f77449b054077c6635f64812fca71989595025ca736dec80738f65f0ecd99b93" "q-21353/selection/e092321e2e4f8bc3636dc17c8c6744be3bf80df081965cc40b7eb847c1120622" "q-21353/selection/a56cb9e9bd58be975cee4966957fbc6a18064f99257910fef0bc6eb646ae268b"] :db/ensure [:answer-field/validate]} {:db/id "q-21353" :question/id #uuid "a60afb71-a1f2-5589-86e8-84aaf38f221a" :question/math-academy-id "q-21353" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/4aa2bca8faab077c47fb968882579233babe7d323ba3120088e8ea5599fbd570.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y=t$\nfrom $t=0$ to $t=2$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{({e}^{t})^{2}+(1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-21353/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-21353"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351429/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "607d2ead-57ad-5e9b-9e46-db3f9e1c5aee" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-351429/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b6b971c9-4d8b-5176-9443-9e9317291fae" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-351429/field-1" :answer-field/id #uuid "23d21ae5-275a-57fa-be0c-36e703a95440" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351429/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-351429/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-351429/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-351429" :question/id #uuid "daa6df4e-3e98-516e-8c24-f7a80383c109" :question/math-academy-id "q-351429" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/5fdcb137c459d5631db3dc3d02ff33ca0b791619694f1badbe7f3f2d0b19141d.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\frac{1}{2}{t}^{2},\\,y=\\frac{1}{3}(2t+1)^{3/2},\\,t\\in [0,2].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{2}) \\\\  & =t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}(2t+1)^{3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{3}{2}(2t+1)^{1/2}\\cdot 2 \\\\  & =(2t+1)^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t)^{2}+{((2t+1)^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{t}^{2}+2t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t+1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}|t+1|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(t+1)\\,\\text{d}t \\\\  & =(\\frac{{t}^{2}}{2}+t)\\,{|}_{0}^{2} \\\\  & =(\\frac{4}{2}+2)-0 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351429/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351429"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351508/field-1/bf2b77424556b6dd6596aa5dbe63d91cdd57b2551ab650aa06eec403bd2295e1" :answer/id #uuid "3c866a45-7c77-53f3-89ab-b833bdae0a10" :answer/type :answer.type/math :answer/value "\\frac{8}{3}(3\\sqrt{3}-1)" :db/ensure [:answer/validate]} {:db/id "q-351508/field-1" :answer-field/id #uuid "c21a7e11-5399-5e0f-ac9d-57aa633caae5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351508/field-1/bf2b77424556b6dd6596aa5dbe63d91cdd57b2551ab650aa06eec403bd2295e1" :answer-field/choices ["q-351508/field-1/bf2b77424556b6dd6596aa5dbe63d91cdd57b2551ab650aa06eec403bd2295e1"] :db/ensure [:answer-field/validate]} {:db/id "q-351508" :question/id #uuid "19ae43f2-819d-535d-9894-a3c2692ab780" :question/math-academy-id "q-351508" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/a61d1a169971b5e0af320372885cdcbae794d163ab767685ef5b688a083aaadb.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2+4t,\\,y=\\frac{8}{3}{t}^{3/2},\\,t\\in [0,2].\n$$\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2+4t)=4,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{8}{3}{t}^{3/2})=4{t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}\\sqrt{{4}^{2}+{(4{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{16+16t}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2}(1+t)^{1/2}\\,\\text{d}t \\\\  & =4\\cdot \\frac{2}{3}(1+t)^{3/2}\\,{|}_{0}^{2} \\\\  & =\\frac{8}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{8}{3}(3\\sqrt{3}-1) \\\\  & =8\\sqrt{3}-\\frac{8}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351508/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351508"] :db/ensure [:knowledge-point/validate]}]
