1229/assets/4aa2bca8faab077c47fb968882579233babe7d323ba3120088e8ea5599fbd570.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y=t$\nfrom $t=0$ to $t=2$ (shown above)?" 13194139534523 true] [17592186293074 1113 #uuid "a60afb71-a1f2-5589-86e8-84aaf38f221a" 13194139534523 true] [17592186293074 1145 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{({e}^{t})^{2}+(1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139534523 true] [17592186293075 1000 #edb/ref 17592186293076 13194139534523 true] [17592186293075 1000 #edb/ref 17592186293077 13194139534523 true] [17592186293075 1000 #edb/ref 17592186293078 13194139534523 true] [17592186293075 1000 #edb/ref 17592186293079 13194139534523 true] [17592186293075 1000 #edb/ref 17592186293080 13194139534523 true] [17592186293075 1040 #edb/ref 17592186045450 13194139534523 true] [17592186293075 1041 "selection" 13194139534523 true] [17592186293075 1104 #edb/ref 17592186293080 13194139534523 true] [17592186293075 1110 #uuid "940d0cdb-9b17-536f-bd8c-5523d35fb495" 13194139534523 true] [17592186293076 1034 "{\\int }_{0}^{2}\\sqrt{{e}^{2t}-1}\\,\\text{d}t" 13194139534523 true] [17592186293076 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293076 1111 #uuid "2a684d34-bd7d-5ef9-afa9-418142c319f7" 13194139534523 true] [17592186293077 1034 "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+4}\\,\\text{d}t" 13194139534523 true] [17592186293077 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293077 1111 #uuid "0f51bbc6-25c6-556b-822b-a62236f54b3a" 13194139534523 true] [17592186293078 1034 "{\\int }_{0}^{2}\\sqrt{{e}^{t}-1}\\,\\text{d}t" 13194139534523 true] [17592186293078 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293078 1111 #uuid "56dc4cb4-a3ba-5823-89e0-c31480c5d08e" 13194139534523 true] [17592186293079 1034 "{\\int }_{0}^{2}\\sqrt{{e}^{t}+2}\\,\\text{d}t" 13194139534523 true] [17592186293079 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293079 1111 #uuid "832e380e-b74e-5982-9caa-3d3906f19aef" 13194139534523 true] [17592186293080 1034 "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" 13194139534523 true] [17592186293080 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293080 1111 #uuid "df7caecb-1e07-5509-a6c7-7b8bcef62c1e" 13194139534523 true] [17592186293081 1017 #edb/ref 17592186293082 13194139534523 true] [17592186293081 1089 "q-351429" 13194139534523 true] [17592186293081 1091 #edb/ref 17592186045463 13194139534523 true] [17592186293081 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/5fdcb137c459d5631db3dc3d02ff33ca0b791619694f1badbe7f3f2d0b19141d.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\frac{1}{2}{t}^{2},\\,y=\\frac{1}{3}(2t+1)^{3/2},\\,t\\in [0,2].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" 13194139534523 true] [17592186293081 1113 #uuid "daa6df4e-3e98-516e-8c24-f7a80383c109" 13194139534523 true] [17592186293081 1145 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{2}) \\\\  & =t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}(2t+1)^{3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{3}{2}(2t+1)^{1/2}\\cdot 2 \\\\  & =(2t+1)^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t)^{2}+{((2t+1)^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{t}^{2}+2t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t+1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}|t+1|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(t+1)\\,\\text{d}t \\\\  & =(\\frac{{t}^{2}}{2}+t)\\,{|}_{0}^{2} \\\\  & =(\\frac{4}{2}+2)-0 \\\\  & =4.\\end{aligned}\n$$" 13194139534523 true] [17592186293082 1000 #edb/ref 17592186293083 13194139534523 true] [17592186293082 1000 #edb/ref 17592186293084 13194139534523 true] [17592186293082 1040 #edb/ref 17592186045449 13194139534523 true] [17592186293082 1041 "field-1" 13194139534523 true] [17592186293082 1104 #edb/ref 17592186293084 13194139534523 true] [17592186293082 1110 #uuid "23d21ae5-275a-57fa-be0c-36e703a95440" 13194139534523 true] [17592186293083 1034 "2" 13194139534523 true] [17592186293083 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293083 1111 #uuid "b6b971c9-4d8b-5176-9443-9e9317291fae" 13194139534523 true] [17592186293084 1034 "4" 13194139534523 true] [17592186293084 1103 #edb/ref 17592186045453 13194139534523 true] [17592186293084 1111 #uuid "607d2ead-57ad-5e9b-9e46-db3f9e1c5aee" 13194139534523 true] [17592186293085 1017 #edb/ref 17592186293086 13194139534523 true] [17592186293085 1089 "q-351508" 13194139534523 true] [17592186293085 1091 #edb/ref 17592186045465 13194139534523 true] [17592186293085 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/a61d1a169971b5e0af320372885cdcbae794d163ab767685ef5b688a083aaadb.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2+4t,\\,y=\\frac{8}{3}{t}^{3/2},\\,t\\in [0,2].\n$$\n\n$L=$\n{{field-1}}" 13194139534523 true] [17592186293085 1113 #uuid "19ae43f2-819d-535d-9894-a3c2692ab780" 13194139534523 true] [17592186293085 1145 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2+4t)=4,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{8}{3}{t}^{3/2})=4{t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}\\sqrt{{4}^{2}+{(4{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{16+16t}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2}(1+t)^{1/2}\\,\\text{d}t \\\\  & =4\\cdot \\frac{2}{3}(1+t)^{3/2}\\,{|}_{0}^{2} \\\\  & =\\frac{8}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{8}{3}(3\\sqrt{3}-1) \\\\  & =8\\sqrt{3}-\\frac{8}{3}.\\end{aligned}\n$$" 13194139534523 true] [17592186293086 1000 #edb/ref 17592186293087 13194139534523 true] [17592186293086 1040 #edb/ref 17592186045449 13194139534523 true] [17592186293086 1041 "field-1" 13194139534523 true] [17592186293086 1104 #edb/ref 17592186293087 13194139534523 true] [17592186293086 1110 #uuid "c21a7e11-5399-5e0f-ac9d-57aa633caae5" 13194139534523 true] [17592186293087 1034 "\\frac{8}{3}(3\\sqrt{3}-1)" 13194139534523 true] [17592186293087 1103 #edb/ref 17592186045453 131941395