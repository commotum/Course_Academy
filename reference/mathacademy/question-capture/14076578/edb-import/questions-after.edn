m below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076578/assets/3f1ca1c3d6ffd56fe0686ee209c967775b5daf09a99e80a3f38ad0a56f4424ce.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in [-1,\\infty ).$"}] [{:db/id #edb/ref 17592186294940 :knowledge-point/_questions [{:knowledge-point/id #uuid "461c0f55-cb85-511e-b8cb-be11f8a3c250" :knowledge-point/title "Domains of Functions With Reciprocal and Radical Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b36b7c-8d31-5c45-88e9-1a7709ad010a" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186294942} {:answer/id #uuid "0ea652ea-fe6e-5e0f-9a7a-975940b5b11a" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in [2,\\infty )" :db/id #edb/ref 17592186294943} {:answer/id #uuid "0ae78325-9217-5755-b00d-b9ed1041c3dd" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (2,\\infty )" :db/id #edb/ref 17592186294944} {:answer/id #uuid "bddd9662-5bff-520e-bd81-10491383a15a" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186294945} {:answer/id #uuid "2371b2e0-4171-5adb-9d44-30ef6a2a3b3f" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty -2)\\cup (-2,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186294946}] :answer-field/correct {:answer/id #uuid "0ae78325-9217-5755-b00d-b9ed1041c3dd" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (2,\\infty )" :db/id #edb/ref 17592186294944} :answer-field/id #uuid "878f152c-4a63-57a8-adeb-271534214d1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294941}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3935e6d4-017d-52a4-878d-007229f03d28" :question/math-academy-id "q-162685" :q