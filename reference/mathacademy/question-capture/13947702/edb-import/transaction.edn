lidate]} {:db/id [:knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a"] :knowledge-point/questions ["q-288446"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288051/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "16e383a3-f5b8-5cc9-9cee-8416077b3ca4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-288051/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c430f780-eaf0-5c8f-a42d-bf2d2637b0c7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-288051/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1fd08dbe-e60a-5fcb-ada9-c38a3499b7cd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-288051/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "af0be384-2419-503e-b23a-fcfe000f1f8b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-288051/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b7f74c8a-6c5d-58de-9068-4624d614ccd9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-288051/selection" :answer-field/id #uuid "443196e8-2fdd-5df0-998e-da53d8476756" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288051/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-288051/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-288051/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-288051/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-288051/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-288051/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-288051" :question/id #uuid "e1c9c830-4c7c-525c-ab10-8752098cfbe0" :question/math-academy-id "q-288051" :question/problem "The following equation is true for all values of $x.$\n\n$$\n{x}^{2}+2x+c={x}^{2}+2x+5\n$$\n\nWhat is the value of the constant $c?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the constant terms on both sides. On the left-hand side, the constant is $c.$ On the right-hand side, the constant is $5.$\n\nSo, we have\n\n$$\nc=5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288051/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a"] :knowledge-point/questions ["q-288051"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288459/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "8704a721-176a-5207-bda6-5d4b11b46933" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-288459/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b25085bc-40ff-5d1d-943f-e31268f4f786" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-288459/field-1" :answer-field/id #uuid "652da9b8-4c2c-59b4-ae35-d86b5193ef15" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288459/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-288459/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-288459/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-288459" :question/id #uuid "6a6c0692-e234-5b82-adb2-8a6dc6c8405c" :question/math-academy-id "q-288459" :question/problem "The equation\n\n$$\np{x}^{2}+qx-6={x}^{2}+7x-6\n$$\n\nis true for all values of $x,$ where $p$ and $q$ are constants. What is the value of $pq?$\n\n$pq=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of ${x}^{2}$ on the left-hand side is $p,$ and on the right-hand side it is $1.$ So, we have \n\n$$\np=1.\n$$\n\n- The coefficient of $x$ on the left-hand side is $q,$ and on the right-hand side it is $7.$ So, we have \n\n$$\nq=7.\n$$\n\nNow, we compute the product:\n\n$$\n\\begin{aligned}pq & =1\\cdot 7 \\\\  & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288459/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e"] :knowledge-point/questions ["q-288459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288464/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "9c4440ff-6fcf-5796-8092-e168dfb8d9df" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-288464/field-1" :answer-field/id #uuid "1888d438-714b-5154-b9be-b524b7304b1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288464/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-288464/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-288464" :question/id #uuid "b996e1b8-0371-5d56-a6f0-f9cbd6e51c66" :question/math-academy-id "q-288464" :question/problem "The equation \n\n$$\nu{x}^{2}+vx-3=-7{x}^{2}+x-3\n$$\n\nis true for all values of $x,$ where $u$ and $v$ are constants. What is the value of $uv?$\n\n$uv=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of ${x}^{2}$ on the left-hand side is $u,$ and on the right-hand side it is $-7.$ So, we have \n\n$$\nu=-7.\n$$\n\n- The coefficient of $x$ on the left-hand side is $v,$ and on the right-hand side it is $1.$ So, we have \n\n$$\nv=1.\n$$\n\nNow, we compute the product:\n\n$$\n\\begin{aligned}uv & =(-7)\\cdot 1 \\\\  & =-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288464/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e"] :knowledge-point/questions ["q-288464"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288452/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "58af5c1a-841f-598d-b82c-121c30f8d6a5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-288452/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer/id #uuid "ed785341-1301-5e9b-9415-bead8f0dabb6" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-288452/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "808d3963-90f8-5ac1-89d7-d1deec77ecb3" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-288452/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "be4d0d45-11b5-5356-9466-d79c1bc36ba5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-288452/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "6ea4fedd-c176-5516-bcb4-6c73de21c793" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-288452/selection" :answer-field/id #uuid "73dbd387-dbc2-5a93-b8c2-e40bad3c1830" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288452/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer-field/choices ["q-288452/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-288452/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" "q-288452/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-288452/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-288452/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45"] :db/ensure [:answer-field/validate]} {:db/id "q-288452" :question/id #uuid "ef6fd5d3-be04-5074-a0a6-cef98c8ae090" :question/math-academy-id "q-288452" :question/problem "The equation\n\n$$\n{x}^{2}+nx+d={x}^{2}-12x-8\n$$\n\nis true for all values of $x,$ where $n$ and $d$ are constants. What is the value of $n+d?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $n,$ and on the right-hand side it is $-12.$ So, we have \n\n$$\nn=-12.\n$$\n\n- The constant term on the left-hand side is $d,$ and on the right-hand side it is $-8.$ So, we have \n\n$$\nd=-8.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}n+d & =-12+(-8) \\\\  & =-12-8 \\\\  & =-20\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e"] :knowledge-point/questions ["q-288452"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288463/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "091e819b-931a-5249-a7c7-1e8e48b61bf7" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-288463/field-1" :answer-field/id #uuid "01b097be-48a0-541a-9ca5-94f86b8fbc0b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288463/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-288463/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-288463" :question/id #uuid "e44f0762-0d97-57a0-af00-2ff5a26957f8" :question/math-academy-id "q-288463" :question/problem "The equation\n\n$$\nt{x}^{2}+wx+6=4{x}^{2}-2x+6\n$$\n\nis true for all values of $x,$ where $t$ and $w$ are constants. What is the value of $tw?$\n\n$tw=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of ${x}^{2}$ on the left-hand side is $t,$ and on the right-hand side it is $4.$ So, we have \n\n$$\nt=4.\n$$\n\n- The coefficient of $x$ on the left-hand side is $w,$ and on the right-hand side it is $-2.$ So, we have \n\n$$\nw=-2.\n$$\n\nNow, we compute the product:\n\n$$\n\\begin{aligned}tw & =4\\cdot (-2) \\\\  & =-8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288463/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e"] :knowledge-point/questions ["q-288463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288451/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "57944513-f089-57e2-be4e-82a4b018a3ff" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-288451/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0cc5e965-e4a9-5e2a-8e1f-4994b8aedee0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-288451/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a8f94a06-911d-5ead-a5ae-2c35a7696751" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-288451/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "43dc81ee-bed2-503a-80f5-c72f17768141" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-288451/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1a5845ce-6ea2-5030-9a3c-a63935aca909" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-288451/selection" :answer-field/id #uuid "070d8ebc-e2b3-5395-ac7c-f602cb2a9ae5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288451/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-288451/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-288451/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-288451/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-288451/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-288451/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-288451" :question/id #uuid "cbe86354-6280-5067-a456-42950cdfd26a" :question/math-academy-id "q-288451" :question/problem "The equation \n\n$$\n{x}^{2}+mx+c={x}^{2}+7x-5\n$$\n\nis true for all values of $x,$ where $m$ and $c$ are constants. What is the value of $m+c?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $m,$ and on the right-hand side it is $7.$ So, we have \n\n$$\nm=7.\n$$\n\n- The constant term on the left-hand side is $c,$ and on the right-hand side it is $-5.$ So, we have \n\n$$\nc=-5.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}m+c & =7+(-5) \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e"] :knowledge-point/questions ["q-288451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288698/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "63f7f2c9-d41a-5f88-8548-80aefb6d7627" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-288698/field-1" :answer-field/id #uuid "78b6324b-22fe-5284-8b6c-f377ca83ad25" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288698/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-288698/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-288698" :question/id #uuid "e2b02957-533e-54ac-94ee-103972717b02" :question/math-academy-id "q-288698" :question/problem "The equation\n\n$$\n(mx+10)(x+n)=-5{x}^{2}+20x-20\n$$\n\nis true for all values of $x,$ where $m$ and $n$ are constants. What is the value of $m+n?$\n\n$m+n=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the product on the left-hand side must expand to match the right-hand side.\n\nFirst, let's expand the left-hand side:\n\n$$\n\\begin{aligned}(mx+10)(x+n) & =m{x}^{2}+mnx+10x+10n \\\\  & =m{x}^{2}+(mn+10)x+10n.\\end{aligned}\n$$\n\nNext, we equate the expanded form to the right-hand side:\n\n$$\nm{x}^{2}+(mn+10)x+10n=-5{x}^{2}+20x-20.\n$$\n\nNow, we compare the coefficients of corresponding terms.\n\n- Equating the coefficients of ${x}^{2},$ we get\n\n$$\nm=-5.\n$$\n\n- Equating the constant terms, we get\n\n$$\n10n=-20\\,⇒\\,n=-2.\n$$\n\nLet's verify that values $m=-5$ and $n=-2$ produce the correct linear coefficient:\n\n$$\n\\begin{aligned}mn+10 & =(-5)(-2)+10 \\\\  & =10+10 \\\\  & =20\\,✓\\end{aligned}\n$$\n\nwhich matches the coefficient of $x$ on the right-hand side. So, our solution is valid.\n\nFinally, we compute the value of $m+n:$\n\n$$\n\\begin{aligned}m+n & =-5+(-2) \\\\  & =-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-288698/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1"] :knowledge-point/questions ["q-288698"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288057/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "67d06be6-5ae9-5aa9-9041-9034eeac2a3a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186210488 :answer-field/choices ["q-288057/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-288057"] :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the product on the left-hand side must expand to match the right-hand side.\n\nFirst, let's expand the left-hand side:\n\n$$\n\\begin{aligned}(ax+4)(x+b) & =a{x}^{2}+abx+4x+4b \\\\  & =a{x}^{2}+(ab+4)x+4b.\\end{aligned}\n$$\n\nNext, we equate the expanded form to the right-hand side:\n\n$$\na{x}^{2}+(ab+4)x+4b=2{x}^{2}+14x+20.\n$$\n\nNow, we compare the coefficients of corresponding terms.\n\n- Equating the coefficients of ${x}^{2},$ we get\n\n$$\na=2.\n$$\n\n- Equating the constant terms, we get\n\n$$\n4b=20\\,⇒\\,b=5.\n$$\n\nLet's verify that values $a=2$ and $b=5$ produce the correct linear coefficient:\n\n$$\n\\begin{aligned}ab+4 & =2\\cdot 5+4 \\\\  & =10+4 \\\\  & =14\\,✓\\end{aligned}\n$$\n\nwhich matches the coefficient of $x$ on the right-hand side. So, our solution is valid.\n\nFinally, we compute the value of $a+b:$\n\n$$\n\\begin{aligned}a+b & =2+5 \\\\  & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-288055"] :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $k$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nk({x}^{2}+7x+10)=k{x}^{2}+7kx+10k\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\nk{x}^{2}+7kx+10k=5{x}^{2}+35x+50.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\nk=5.\n$$\n\nLet's verify that value $k=5$ produces the correct linear coefficient and constant term:\n\n- $7k=7(5)=35\\,✓$\n\n- $10k=10(5)=50\\,✓$\n\nSo, our solution is valid." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-288468/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "07c8222b-75e0-5775-84d3-f1224424ed81" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-288468/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "dd68e33a-5c52-5923-97ab-e722a61e4fca" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-288468/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "f4545191-d3a5-58f8-8bd2-c496a9006f2a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-288468/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "dfbe5945-bfff-52d7-a503-35996d529bf6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-288468/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9e55d357-4249-5383-84bb-727fa1e29284" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-288468/selection" :answer-field/id #uuid "daebb1a6-92f0-59cf-bff5-b5367267f8bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288468/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-288468/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-288468/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-288468/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-288468/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-288468/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-288468" :question/id #uuid "9f05ef00-ecf3-521e-8eb7-f45de3139297" :question/math-academy-id "q-288468" :question/problem "The equation\n\n$$\nt(2{x}^{2}-3x+1)=-6{x}^{2}+9x-3\n$$\n\nis true for all values of $x,$ where $t$ is a constant. What is the value of $t?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $t$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nt(2{x}^{2}-3x+1)=2t{x}^{2}-3tx+t\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\n2t{x}^{2}-3tx+t=-6{x}^{2}+9x-3.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\n2t=-6\\,⇒\\,t=-3.\n$$\n\nLet's verify that value $t=-3$ produces the correct linear coefficient and constant term:\n\n- $-3t=(-3)(-3)=9\\,✓$\n\n- $t=-3\\,✓$\n\nSo, our solution is valid." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288468/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1"] :knowledge-point/questions ["q-288468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288697/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3f0e7d6d-7f8f-5fc4-b1b6-a416d2781d28" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-288697/field-1" :answer-field/id #uuid "6164c4c1-c223-5f65-b959-f84fc20d982f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-288697/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-288697/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-288697" :question/id #uuid "c020a0c1-43c7-514c-b47c-f3c429e8e8cf" :question/math-academy-id "q-288697" :question/problem "The equation \n\n$$\n(cx-8)(x+d)=4{x}^{2}-20x+24\n$$\n\nis true for all values of $x,$ where $c$ and $d$ are constants.What is the value of $c+d?$\n\n$c+d=$\n{{field-1}}" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the product on the left-hand side must expand to match the right-hand side.\n\nFirst, let's expand the left-hand side:\n\n$$\n\\begin{aligned}(cx-8)(x+d) & =c{x}^{2}+cdx-8x-8d \\\\  & =c{x}^{2}+(cd-8)x-8d.\\end{aligned}\n$$\n\nNext, we equate the expanded form to the right-hand side:\n\n$$\nc{x}^{2}+(cd-8)x-8d=4{x}^{2}-20x+24.\n$$\n\nNow, we compare the coefficients of corresponding terms.\n\n- Equating the coefficients of ${x}^{2},$ we get\n\n$$\nc=4.\n$$\n\n- Equating the constant terms, we get\n\n$$\n-8d=24\\,⇒\\,d=-3.\n$$\n\nLet's verify that values $c=4$ and $d=-3$ produce the correct linear coefficient:\n\n$$\n\\begin{aligned}cd-8 & =4\\cdot (-3)-8 \\\\  & =-12-8 \\\\  & =-20\\,✓\\end{aligned}\n$$\n\nwhich matches the coefficient of $x$ on the right-hand side. So, our solution is valid.\n\nFinally, we compute the value of $c+d:$\n\n$$\n\\begin{aligned}c+d & =4+(-3) \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-288697/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1"] :knowledge-point/questions ["q-288697"] :db/ensure [:knowledge-point/validate]}]
