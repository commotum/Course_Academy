-1} & =2 \\\\ \\operatorname{ln}⁡({e}^{2x-1}) & =\\operatorname{ln}⁡(2) \\\\ 2x-1 & =\\operatorname{ln}⁡(2)\\end{aligned}\n$$\n\nFinally, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}2x-1 & =\\operatorname{ln}⁡(2) \\\\ 2x & =\\operatorname{ln}⁡(2)+1 \\\\ x & =\\frac{\\operatorname{ln}⁡(2)+1}{2}\\end{aligned}\n$$" 13194139533784 true] [17592186250943 1000 #edb/ref 17592186250944 13194139533784 true] [17592186250943 1000 #edb/ref 17592186250945 13194139533784 true] [17592186250943 1000 #edb/ref 17592186250946 13194139533784 true] [17592186250943 1000 #edb/ref 17592186250947 13194139533784 true] [17592186250943 1000 #edb/ref 17592186250948 13194139533784 true] [17592186250943 1040 #edb/ref 17592186045450 13194139533784 true] [17592186250943 1041 "selection" 13194139533784 true] [17592186250943 1104 #edb/ref 17592186250945 13194139533784 true] [17592186250943 1110 #uuid "b1a89f27-0e4d-5982-b3d8-98c60e5f4cca" 13194139533784 true] [17592186250944 1034 "\\frac{\\operatorname{ln}⁡(2)-1}{2}" 13194139533784 true] [17592186250944 1103 #edb/ref 17592186045453 13194139533784 true] [17592186250944 1111 #uuid "4aa962d8-2359-5b0b-bc47-6962a02a3d51" 13194139533784 true] [17592186250945 1034 "\\frac{\\operatorname{ln}⁡(2)+1}{2}" 13194139533784 true] [17592186250945 1103 #edb/ref 17592186045453 13194139533784 true] [17592186250945 1111 #uuid "aff65057-e752-5d86-a8d7-29ab66bcb91a" 13194139533784 true] [17592186250946 1034 "2\\operatorname{ln}⁡(2)-2" 13194139533784 true] [17592186250946 1103 #edb/ref 17592186045453 13194139533784 true] [17592186250946 1111 #uuid "ca1a10dc-ece8-5f93-bbfd-2798c9d2c2c8" 13194139533784 true] [17592186250947 1034 "\\operatorname{ln}⁡(2)+1" 13194139533784 true] [17592186250947 1103 #edb/ref 17592186045453 13194139533784 true] [17592186250947 1111 #uuid "1b2d2fd1-765b-5f2f-bd4d-e98802629809" 13194139533784 true] [17592186250948 1034 "3\\operatorname{ln}⁡(2)+1" 13194139533784 true] [17592186250948 1103 #edb/ref 17592186045453 13194139533784 true] [175921