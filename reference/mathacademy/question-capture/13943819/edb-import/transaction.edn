idate]} {:db/id "q-165974" :question/id #uuid "6cd244e5-78b1-5417-9ff1-33275ef2661d" :question/math-academy-id "q-165974" :question/problem "Find the root of $f(x)=2(5)^{x}-50.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n2(5)^{x}-50=0\n$$\n\nFirst, we isolate the term with the variable exponent by adding $50$ to both sides:\n\n$$\n\\begin{aligned}2(5)^{x}-50 & =0 \\\\ 2(5)^{x}-\\cancel{50}+\\cancel{50} & =0+50 \\\\ 2(5)^{x} & =50\\end{aligned}\n$$\n\nDividing both sides by $2,$ we get\n\n$$\n\\begin{aligned}2(5)^{x} & =50 \\\\ {5}^{x} & =25.\\end{aligned}\n$$\n\nNow, we rewrite $25$ as ${5}^{2}$ to get\n\n$$\n{5}^{x}={5}^{2}.\n$$\n\nFinally, since both sides of the equation share the same base $(5)$, we equate the exponents. This gives\n\n$$\nx=2.\n$$\n\nTherefore, the root of $f(x)$ is $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-165974/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee02c223-dd7f-5c5d-b09f-e7bc6bd16b0c"] :knowledge-point/questions ["q-165974"] :db/ensure [:knowledge-point/validate]} {:db/id "q-92959/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "2832f6b6-66e0-5519-8d51-7974e9a15288" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-92959/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "6cba8ece-1cbf-56cc-b4b8-5d454dd076da" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-92959/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "36a3dd0b-f4f7-51e2-b09e-673b39667406" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-92959/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "938b0ef3-353c-568b-a82a-038676209815" :answer/type :answer.t