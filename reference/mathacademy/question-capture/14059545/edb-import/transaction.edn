\\frac{\\operatorname{sin}⁡\\theta +\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{cos}⁡\\theta -\\theta \\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17113/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0a0dd73-d526-529b-9a98-594e8d5825aa"] :knowledge-point/questions ["q-17113"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353226/field-1/a5e57cea287e5ca8beadd1e749502731b8ac41436eb8110dabde3a60aedb3366" :answer/id #uuid "4c7145de-5df2-557b-ad17-e1f5e8be30e7" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\pi}" :db/ensure [:answer/validate]} {:db/id "q-353226/field-1" :answer-field/id #uuid "8c3efd92-c125-538d-b812-1c923f312509" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353226/field-1/a5e57cea287e5ca8beadd1e749502731b8ac41436eb8110dabde3a60aedb3366" :answer-field/choices ["q-353226/field-1/a5e57cea287e5ca8beadd1e749502731b8ac41436eb8110dabde3a60aedb3366"] :db/ensure [:answer-field/validate]} {:db/id "q-353226" :question/id #uuid "b959c586-f4d8-56a6-a6a1-f79e542f2117" :question/math-academy-id "q-353226" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059545/assets/064e75694d82bed2177df55e2e66c3343a2c0396cd54f5d4304f952a01abb219.png)\n\nFor the polar curve $r=\\theta $ (shown above) evaluate the derivative $\\frac{\\text{d}y}{\\text{d}x}$   at $\\theta =\\frac{\\pi }{2}$ given that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta ) & =\\operatorname{sin}⁡\\theta +\\theta \\operatorname{cos}⁡\\theta , \\\\ {x}^{′}(\\theta ) & =\\operatorname{cos}⁡\\theta -\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nDo not round the answer.\n\n${\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /2}=$\n{{field-1}}" :question/worked-solution "To find $\\frac{\\text{d}y}{\\text{d}x},$ we use the rule for differentiating parametric equations:\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}\n$$\n\nEvaluating the numerator and denominator at $\\theta =\\frac{\\pi }{2},$ we have\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{2}\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =1+\\frac{\\pi }{2}\\cdot 0 \\\\  & =1,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =0-\\frac{\\pi }{2}\\cdot 1 \\\\  & =-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\frac{\\pi }{2}} & =\\frac{{y}^{′}(\\frac{\\pi }{2})}{{x}^{′}(\\frac{\\pi }{2})} \\\\  & =\\frac{1}{(-\\frac{\\pi }{2})} \\\\  & =-\\frac{2}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353226/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c86c57df-5103-5931-b423-e4dafeb9721a"] :knowledge-point/questions ["q-353226"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353218/field-1/e37f4ce5b7617223a46901d43c3aaec33db8b9fd888875eb3edae34de1222f5f" :answer/id #uuid "1e44ac56-dfa1-575b-8f11-fc1bda0ed005" :answer/type :answer.type/math :answer/value "-3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-353218/field-1/bb5e3e524771fed0f8298cd585cdb5759ed07bb1ac0ac034d00b73a0b668a9ce" :answer/id #uuid "ca21b8c9-83d4-52b7-90a4-57b4fd394350" :answer/type :answer.type/math :answer/value "3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-353218/field-1" :answer-field/id #uuid "033cf2eb-cb16-57b8-b667-9f264caff1cb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353218/field-1/e37f4ce5b7617223a46901d43c3aaec33db8b9fd888875eb3edae34de1222f5f" :answer-field/choices ["q-353218/field-1/e37f4ce5b7617223a46901d43c3aaec33db8b9fd888875eb3edae34de1222f5f" "q-353218/field-1/bb5e3e524771fed0f8298cd585cdb5759ed07bb1ac0ac034d00b73a0b668a9ce"] :db/ensure [:answer-field/validate]} {:db/id "q-353218" :question/id #uuid "d5170d88-8672-5c73-9bf3-b2239f1bac15" :question/math-academy-id "q-353218" :question/problem "Find the slope $m$ of the tangent line to the polar curve $r=1+\\operatorname{sec}⁡(\\theta )$ at $\\theta =\\frac{\\pi }{3}$ given that\n\n$$\n\\begin{aligned}{y}^{′}(\\theta ) & =\\operatorname{cos}⁡(\\theta )+{sec}^{2}⁡(\\theta ), \\\\ {x}^{′}(\\theta ) & =-\\operatorname{sin}⁡(\\theta ).\\end{aligned}\n$$\n\nDo not round the answer.\n\n$m=$ \n{{field-1}}" :question/worked-solution "To find $\\frac{\\text{d}y}{\\text{d}x}$ we use the rule\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nWe have,\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{3}) & =\\operatorname{cos}⁡(\\frac{\\pi }{3})+{sec}^{2}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}+{2}^{2} \\\\  & =\\frac{1}{2}+4 \\\\  & =\\frac{9}{2},\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{3}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\n \n\nHence, the slope $m$ of the tangent line is\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /3} & =\\frac{{y}^{′}(\\frac{\\pi }{3})}{{x}^{′}(\\frac{\\pi }{3})} \\\\  & =\\frac{(\\frac{9}{2})}{(-\\frac{\\sqrt{3}}{2})} \\\\  & =-\\frac{9}{\\sqrt{3}} \\\\  & =-3\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353218/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c86c57df-5103-5931-b423-e4dafeb9721a"] :knowledge-point/questions ["q-353218"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141046/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7f2f47f4-aa3c-590c-81b2-92caf242497a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-141046/selection/dd4535bb62d0a257526afe2dfd8bdd1b2372319a3c82775682b64347de2aaf98" :answer/id #uuid "62cac228-a0a4-5c20-a17d-3470c4b9fb12" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}\\,{e}^{\\pi /2}" :db/ensure [:answer/validate]} {:db/id "q-141046/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "c97dfd70-8f98-52fc-8df9-bdf4ad4e190a" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-141046/selection/c0604a86cfd857bc489253f78a41d2e71ce7c6f6c7bd728e03e271ea75d6c980" :answer/id #uuid "2fda00af-63ce-5268-b73c-092e60cb1f99" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-141046/selection/d9ae93c00b26b0f509ac2a3aca171d00885d4f94b89c0ecf147549aa46d66bc2" :answer/id #uuid "aba4ef22-40bb-5bcc-aca4-1eaa383c4290" :answer/type :answer.type/math :answer/value "3{e}^{\\pi /2}" :db/ensure [:answer/validate]} {:db/id "q-141046/selection" :answer-field/id #uuid "878319dc-5f9b-5a6b-a67e-192061f68d82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141046/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-141046/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-141046/selection/dd4535bb62d0a257526afe2dfd8bdd1b2372319a3c82775682b64347de2aaf98" "q-141046/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-141046/selection/c0604a86cfd857bc489253f78a41d2e71ce7c6f6c7bd728e03e271ea75d6c980" "q-141046/selection/d9ae93c00b26b0f509ac2a3aca171d00885d4f94b89c0ecf147549aa46d66bc2"] :db/ensure [:answer-field/validate]} {:db/id "q-141046" :question/id #uuid "32f5cae8-0afe-508b-ace8-3e3628e8d1ad" :question/math-academy-id "q-141046" :question/problem "Find the slope of the tangent line to the polar curve $r={e}^{2\\theta }$ at $\\theta =\\frac{\\pi }{4}$ given that\n\n$$\n{y}^{′}(\\theta )={e}^{2\\theta }(\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta ),\\,{x}^{′}(\\theta )={e}^{2\\theta }(2\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\n$$" :question/worked-solution "To find $\\frac{\\text{d}y}{\\text{d}x}$ we use the rule\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nWe have,\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & ={e}^{\\pi /2}(\\operatorname{cos}⁡\\frac{\\pi }{4}+2\\operatorname{sin}⁡\\frac{\\pi }{4}) \\\\  & ={e}^{\\pi /2}(\\frac{\\sqrt{2}}{2}+2\\cdot \\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{3\\sqrt{2}}{2}\\,{e}^{\\pi /2},\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{4}) & ={e}^{\\pi /2}(2\\operatorname{cos}⁡\\frac{\\pi }{4}-\\operatorname{sin}⁡\\frac{\\pi }{4}) \\\\  & ={e}^{\\pi /2}(2\\cdot \\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,{e}^{\\pi /2},\\end{aligned}\n$$\n\n \n\nHence, the slope of the tangent line is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /4} & =\\frac{{y}^{′}(\\frac{\\pi }{4})}{{x}^{′}(\\frac{\\pi }{4})} \\\\  & =\\frac{(\\frac{3\\sqrt{2}}{2}\\,{e}^{\\pi /2})}{(\\frac{\\sqrt{2}}{2}\\,{e}^{\\pi /2})} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c86c57df-5103-5931-b423-e4dafeb9721a"] :knowledge-point/questions ["q-141046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141048/selection/9677250c9edd0a612a0d750dc6fff6fd833a7f772cd890cb65b14a85469dade3" :answer/id #uuid "2dbfd437-651e-5e1b-bd59-6975203c0e4e" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-141048/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "c2ccbb8c-c20d-541e-bfd7-5f2cb60cd442" :answer/type :answer.type/