:answer/validate]} {:db/id "q-105394/selection" :answer-field/id #uuid "ae8089ab-4e1c-5702-b2db-6f9decb4e524" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105394/selection/36ac8993aedada5b9494b8734ae1c87b9870db17c69870191e1671dc364dd52f" :answer-field/choices ["q-105394/selection/d79c03133c78b27ab6e43fdd9397d901a86f6409167093c112bd0252ae50eb84" "q-105394/selection/36ac8993aedada5b9494b8734ae1c87b9870db17c69870191e1671dc364dd52f" "q-105394/selection/e271a35438665aa7552cb74716f1d03c2ce4cafcbd5d78422286ffb03bf288ca" "q-105394/selection/24955eaed95b84019b75aca0d5c10a8715e27ecd11c25e362892918c5e240ac6" "q-105394/selection/5e19927fb20c4d4a1b6f74f2118665089e5e5c1e69a005738dae046b7c610bab"] :db/ensure [:answer-field/validate]} {:db/id "q-105394" :question/id #uuid "13f8c420-bff7-5362-ad65-7f9dc2709f76" :question/math-academy-id "q-105394" :question/problem "Which of the following functions is continuous on the interval $[-1,2)?$" :question/worked-solution "The correct answer is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945275/assets/105d87736460f2949a0cde4c7fe7cc105e72889312a529970d74080b14e3ffe8.png)\n\n \n\nIndeed, we have that $f(x)$ is continuous on the open interval $(-1,2).$ \n\nAdditionally, the function is right-continuous at $x=-1.$ Hence, it is continuous on the interval $[-1,2).$\n\nNotice that\n\n- $h(x)$ is not right-continuous at $x=-1.$\n\n- $p(x)$ and $g(x)$ are not continuous at some point that lies inside the interval $[-1,2).$\n\n- $q(x)$ is not continuous at $x=1$, and so is not continuous on $[-1,2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105394/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbfddefc-d68b-5b1e-9ec5-fd18be204d92"] :knowledge-point/questions ["q-105394"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105418/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "985118e9-4b7d-5ec2-a131-0eacf3feb74a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-105418/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d0633811-d841-5658-8eb3-140465ba26f6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-105418/selection/2ca4bfe4352389d647a1104a74259abfbc0ec6c68f7a958d38fd0bedad40d918" :answer/id #uuid "b610421d-b970-5cbf-8e45-22ab853cdf89" :answer/type :answer.type/text :answer/value "The function is not continuous on any of the given intervals" :db/ensure [:answer/validate]} {:db/id "q-105418/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "ae35c32a-7b7b-5799-af30-11b1a9896635" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-105418/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "fb8e672e-30fe-52a7-a4a1-722538b115f0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-105418/selection" :answer-field/id #uuid "412cb687-fc68-5ada-a756-eca977d828c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105418/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-105418/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-105418/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-105418/selection/2ca4bfe4352389d647a1104a74259abfbc0ec6c68f7a958d38fd0bedad40d918" "q-105418/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-105418/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-105418" :question/id #uuid "b3f87a1e-7af1-56ec