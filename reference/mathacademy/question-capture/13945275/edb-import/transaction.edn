ontinuous on $(-\\infty ,2].$\n\n- $p(x)$ and $h(x)$ are not continuous at $x=0$, and so are not continuous on $(-\\infty ,2].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105413/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbfddefc-d68b-5b1e-9ec5-fd18be204d92"] :knowledge-point/questions ["q-105413"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76158/selection/b806aadac147af25cacb097f7f0115e0af973cfdbfa2212c3fc365ecc5a582fb" :answer/id #uuid "eeafc3d3-1f5f-537d-8f10-c3e726c8484e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945275/assets/2baaf696411a0d3ab6f20bf4977c78f3076f9665f9cac965a37cdca9fb4e8387.png" :db/ensure [:answer/validate]} {:db/id "q-76158/selection/30dd8e488b6dc37411e2ce7bdbfef1b19c0d2afc0370709b26350c0b8e6e8063" :answer/id #uuid "f9243421-0a20-54f3-8f74-3e96b0ab3892" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945275/assets/d146dcbae1741d150191f2848ed6d0b000a913bfc2eb603b459ebe19a6a656aa.png" :db/ensure [:answer/validate]} {:db/id "q-76158/selection/dd1f60da602e3f3773a66b87fd4cb0f7d84ffdc009485ca1e61c7e477e9c78f4" :answer/id #uuid "298dc4a0-d057-5a3e-a1c1-b2198bff2755" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945275/assets/07b072fd0a49d28fda59c356fe6e8c344d6093f20e23835d26bc386cdd973876.png" :db/ensure [:answer/validate]} {:db/id "q-76158/selection/d2d93fd79f1e1f4ff11e537c180e1d8cfeff6a86f86a2fc1465356996b4e77a3" :answer/id #uuid "9aff30f0-8e1f-5f7c-87d0-18d9dc56c7e9" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945275/assets/221f7b64094910a5c1037e7071826f27f2ea0472ea93a612e9d38f3c46f5ad27.png" :db/ensure [:answer/validate]} {:db/id "q-76158/selection/e48e006618