[{:db/id "q-107495/selection/789686924f0490659eceabbc3c4c533f840a7e59ba864da5515004cf060119a1" :answer/id #uuid "e6f134f1-baa9-549d-a1d9-f1c54243277e" :answer/type :answer.type/math :answer/value "{e}^{2\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-107495/selection/ba2000bcd3abf603a333427d8b8e28b469d398063228a30b8dc060c4a1152bd5" :answer/id #uuid "21e87d5a-487c-58a8-9650-5cf816c15ca7" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/40}" :db/ensure [:answer/validate]} {:db/id "q-107495/selection/6d510f70ea07a6aaf84a0f72f8d109160128600a153a787848bdb9b100ffbdfe" :answer/id #uuid "569caf71-3ce7-5214-9680-d1d03f38e086" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/20}" :db/ensure [:answer/validate]} {:db/id "q-107495/selection/ca301f6bd2521c2691b98d6e60198dac4b820991bc48106b2fe92cc6569a2eb6" :answer/id #uuid "658dd5f8-54f2-59b2-99b3-77874ca7d07c" :answer/type :answer.type/math :answer/value "{e}^{3\\pi \\text{i}/10}" :db/ensure [:answer/validate]} {:db/id "q-107495/selection/0867988808511a52eb2d3ab376ebc9d95a4e2022312f5c2b18650d835439f079" :answer/id #uuid "d0d46b85-e673-5a60-b143-660c6cae3e30" :answer/type :answer.type/math :answer/value "{e}^{\\pi \\text{i}/10}" :db/ensure [:answer/validate]} {:db/id "q-107495/selection" :answer-field/id #uuid "0e864228-b889-5614-968b-88d2559e57e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107495/selection/0867988808511a52eb2d3ab376ebc9d95a4e2022312f5c2b18650d835439f079" :answer-field/choices ["q-107495/selection/789686924f0490659eceabbc3c4c533f840a7e59ba864da5515004cf060119a1" "q-107495/selection/ba2000bcd3abf603a333427d8b8e28b469d398063228a30b8dc060c4a1152bd5" "q-107495/selection/6d510f70ea07a6aaf84a0f72f8d109160128600a153a787848bdb9b100ffbdfe" "q-107495/selection/ca301f6bd2521c2691b98d6e60198dac4b820991bc48106b2fe92cc6569a2eb6" "q-107495/selection/0867988808511a52eb2d3ab376ebc9d95a4e2022312f5c2b18650d835439f079"] :db/ensure [:answer-field/validate]} {:db/id "q-107495" :question/id #uuid "78651eb4-8048-5b92-af07-f86f14c30c25" :question/math-academy-id "q-107495" :question/problem "Find the principal $20$th root of unity." :question/worked-solution "Let $z$ be a $20$th root of unity. This means that \n\n$$\n{z}^{20}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{20}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/20}={e}^{k\\pi \\text{i}/10}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/10}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107495/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7"] :knowledge-point/questions ["q-107495"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162239/selection/bb09fc4669431ca02b6404319bd60a7a56aea8ef902077033593b40605443dd2" :answer/id #uuid "eed69bc8-4626-5a22-a503-c5fa984364d8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png" :db/ensure [:answer/validate]} {:db/id "q-162239/selection/265c801d844e9e0729948e0a1ac79b76ff2ced9085a2d1824bbe2172e4f74740" :answer/id #uuid "5da1037f-012d-5fa3-a8a2-01162162cdb0" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/9111f21143412d791b0195722da4f6d461444f386efd9baf609c70a4fe709fd8.png" :db/ensure [:answer/validate]} {:db/id "q-162239/selection/0c424ce7dc25aa7925c0465b153b3132932dd6b430cd98a6674ad77413f0175e" :answer/id #uuid "c4d7ae5d-d5cc-5a7f-a017-0cc1a272d91