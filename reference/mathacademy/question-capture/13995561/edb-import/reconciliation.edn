demy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-162245" "field" nil "attribute" "question/problem" "value" "Which of the following diagrams shows all the $9$th roots of unity?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-162245" "field" nil "attribute" "question/worked-solution" "value" "Geometrically, the $9$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular nonagon (regular $9$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-162245" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/activity-metadata.json" "file_sha256" "efeba78947963653518be88df3e317edf940418a7f26a0b9199e31abd8f0bf40"} {"question" "q-162245" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-162245" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/58013857f5024f78c322059e5ffdbf10943b0479722202c972a51ccda4be3525.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/b473ada0488958a7faf410a6cadb0a1b9aedfde1925658a1f635913b1e2507c3.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-162245" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216709" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/bf78e90c844df2d80ffb3b08476ecd0370ffbbf63050bcabf20265692b2deeb3.png)\n\nFind the root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216709" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $9$ points in our diagram, we need to find a $9$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{9}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/9}={e}^{2k\\pi \\text{i}/9}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/e797056434dc122218bdc501cd9e1d5af93127658daa14f7c38b3bd7be8b877f.png)\n\n \n\nSo, the required root corresponds to $k=3.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{3}={e}^{2(3)\\pi \\text{i}/9}={e}^{2\\pi \\text{i}/3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216709" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/activity-metadata.json" "file_sha256" "efeba78947963653518be88df3e317edf940418a7f26a0b9199e31abd8f0bf40"} {"question" "q-216709" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216709" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{2\\pi \\text{i}/3}"] ["math" "{e}^{5\\pi \\text{i}/6}"] ["math" "{e}^{5\\pi \\text{i}/9}"] ["math" "{e}^{7\\pi \\text{i}/6}"] ["math" "{e}^{7\\pi \\text{i}/9}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216709" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{2\\pi \\text{i}/3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216713" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/70665e4b48e324582ff9b1d448580d2e4462cddc7e51ac42a5766bb605d0bf1c.png)\n\nFind the root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216713" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $8$ points in our diagram, we need to find a $8$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{8}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/8}={e}^{k\\pi \\text{i}/4}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/assets/31a716f5f4abcda0baea7586f732f9009d2cd4821b429d060d985858c61a3b62.png)\n\n \n\nSo, the required root corresponds to $k=3.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{3}={e}^{(3)\\pi \\text{i}/4}={e}^{3\\pi \\text{i}/4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216713" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/activity-metadata.json" "file_sha256" "efeba78947963653518be88df3e317edf940418a7f26a0b9199e31abd8f0bf40"} {"question" "q-216713" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216713" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{3\\pi \\text{i}/4}"] ["math" "{e}^{5\\pi \\text{i}/4}"] ["math" "{e}^{5\\pi \\text{i}/8}"] ["math" "{e}^{5\\pi \\text{i}/9}"] ["math" "{e}^{7\\pi \\text{i}/8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"} {"question" "q-216713" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{3\\pi \\text{i}/4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995561/state.json" "file_sha256" "b5f3091f264237278f4b144b278a0fdd1e98fbbdc12ba8d800aea360a64ad1c7"}] "usage" {} "basis" 1069 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
