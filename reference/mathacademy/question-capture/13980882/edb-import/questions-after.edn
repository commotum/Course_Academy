#{[{:db/id #edb/ref 17592186281294 :knowledge-point/_questions [{:knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c79874-f9f1-571a-b9a5-16ca24be562c" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186281296} {:answer/id #uuid "e2611dd2-9bd3-5830-b4c8-82edf7164be5" :answer/type {:db/ident :answer.type/text} :answer/value "I, III, and IV only" :db/id #edb/ref 17592186281297} {:answer/id #uuid "a1aa88e2-823e-5c97-a817-7ba17055a1a3" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281298} {:answer/id #uuid "0d7b628b-0379-50f2-bc2c-3ee818867d54" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186281299} {:answer/id #uuid "1e2bb27c-11ae-5e64-b9c0-3f801903a126" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281300}] :answer-field/correct {:answer/id #uuid "1e2bb27c-11ae-5e64-b9c0-3f801903a126" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281300} :answer-field/id #uuid "5ea811c7-e487-5f42-b9f8-005e922a4e22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281295}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "08681bdb-d18d-52f4-853d-7f023cb7b260" :question/math-academy-id "q-108605" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980882/assets/a6e311063c3222d8be1b5fe37379d21c4dbb3198afd7c338a273bb1cf366fc1e.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that:\n\n- For graph II, any horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph II shows a one-to-one function. As a result, this function is invertible.\n\n- For graphs I, III, and IV, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible."}] [{:db/id #edb/ref 17592186083493 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a939f690-0172-521b-8588-804f90d192e2" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186080289} {:answer/id #uuid "171ec757-f8bd-583b-a48f-da981b156ce2" :answer/type {:db/ident :answer.type/math} :answer/value "1080" :db/id #edb/ref 17592186080290} {:answer/id #uuid "1b29819a-fb57-561f-9b17-c94dff0ed781" :answer/type {:db/ident :answer.type/math} :answer/value "196" :db/id #edb/ref 17592186080291} {:answer/id #uuid "2d2689fd-d49d-585d-b258-b79df6264f6f" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186080292} {:answer/id #uuid "7ccd3412-02af-5ce2-9da2-32307e8f1543" :answer/type {:db/ident :answer.type/math} :answer/value "5040" :db/id #edb/ref 17592186080293}] :answer-field/correct {:answer/id #uuid "a939f690-0172-521b-8588-804f90d192e2" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186080289} :answer-field/id #uuid "3fdbfb85-0e7e-5463-bf18-a8807ffedb3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080288}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f30edfb7-ec90-58c9-a061-c0fd1748dea8" :question/math-academy-id "q-1801" :question/problem "Evaluate $(\\frac{10}{6}).$" :question/requires-calculator true :question/worked-solution "First, note that $(\\frac{10}{6})$ means the same thing as ${}_{10}{C}_{6}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=10$ and $r=6,$ we get\n\n$$\n\\begin{aligned}{}_{10}{C}_{6} & =\\frac{10!}{(10-6)!6!} \\\\  & =\\frac{10!}{4!6!} \\\\  & =\\frac{10\\cdot 9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{4!\\cancel{6!}} \\\\  & =\\frac{10\\cdot 9\\cdot 8\\cdot 7}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{5\\,040}{24} \\\\  & =210.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281301 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21df5827-52f6-57ec-9c9e-aa93d7e9216e" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}+3" :db/id #edb/ref 17592186281303} {:answer/id #uuid "f114e9b8-cac1-50ba-a395-e381d8bb6db2" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}-2" :db/id #edb/ref 17592186281304} {:answer/id #uuid "553a781b-c50b-598b-ba5a-08fee0b0b841" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}-3" :db/id #edb/ref 17592186281305} {:answer/id #uuid "6dd0672a-5dce-5bd5-929c-bf39bffcd9d7" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}" :db/id #edb/ref 17592186281306} {:answer/id #uuid "92f3f9e1-30c6-551d-9862-f9ff94cab461" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}+2" :db/id #edb/ref 17592186281307}] :answer-field/correct {:answer/id #uuid "553a781b-c50b-598b-ba5a-08fee0b0b841" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{8})}^{x}-3" :db/id #edb/ref 17592186281305} :answer-field/id #uuid "1c5edda9-092a-5e25-8536-488b61b9231a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281302}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3bdef897-6fb1-52b2-84e8-2991640d04c4" :question/math-academy-id "q-27448" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980882/assets/f5b33723509f58055f0ded0c575ea097cc90ff05fcfc72fc3270553248de0f2b.png)\n\nThe graph above shows the curve $y={(\\frac{1}{8})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{8})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{8})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186281308 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf1b5dd-b580-56be-8e44-66f1fbd18490" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186281310} {:answer/id #uuid "b43d2518-4b7b-5398-9ac9-b3ed00aa6344" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281311} {:answer/id #uuid "29e0dae8-cafd-536d-bef0-cee23d8df621" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281312} {:answer/id #uuid "cd6d04a8-16c6-5456-bd4f-189120503388" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186281313} {:answer/id #uuid "3af06527-486e-5c9d-95de-5c920ccccf54" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186281314}] :answer-field/correct {:answer/id #uuid "29e0dae8-cafd-536d-bef0-cee23d8df621" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281312} :answer-field/id #uuid "3f3158eb-fd35-5f38-b15a-caca8853faee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281309}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bc33708c-6675-5c4d-add3-ff1acd566a68" :question/math-academy-id "q-3304" :question/problem "Find the value of $x$ that satisfies the equation ${8}^{x}\\cdot {4}^{2x-1}=32.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $8={2}^{3}$, $4={2}^{2}$ and $32={2}^{5},$ as follows:\n\n$$\n{({2}^{3})}^{x}\\cdot {({2}^{2})}^{2x-1}={2}^{5}\n$$\n\nThen, we apply the power rule and the product rule of exponents. This gives:\n\n$$\n\\begin{aligned}{2}^{3x}\\cdot {2}^{2(2x-1)} & ={2}^{5} \\\\ {2}^{3x+2(2x-1)} & ={2}^{5}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents and solve for $x:$\n\n$$\n\\begin{aligned}3x+2(2x-1) & =5 \\\\ 3x+4x-2 & =5 \\\\ 7x & =7 \\\\ x & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281315 :knowledge-point/_questions [{:knowledge-point/id #uuid "29956ecb-a28a-5406-b8dc-9776e9a3ccee" :knowledge-point/title "Differentiating a Polynomial Raised to a Power Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b656a3a4-5efd-573f-9a31-752b8af7e196" :answer/type {:db/ident :answer.type/math} :answer/value "-28(1-7x)^3" :db/id #edb/ref 17592186281317}] :answer-field/correct {:answer/id #uuid "b656a3a4-5efd-573f-9a31-752b8af7e196" :answer/type {:db/ident :answer.type/math} :answer/value "-28(1-7x)^3" :db/id #edb/ref 17592186281317} :answer-field/id #uuid "0b829935-3485-5a9c-8ecb-106aa4a44b89" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281316}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1828f73d-8e30-58d0-95fc-8bce2cfc9181" :question/math-academy-id "q-340690" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(1-7x)^{4}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={g}^{4},\\,g=1-7x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4{g}^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-7.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4{g}^{3}\\cdot (-7) \\\\  & =-28(1-7x)^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281318 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "806dd40a-45da-5a8a-a040-ef00812b03e8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281320}] :answer-field/correct {:answer/id #uuid "806dd40a-45da-5a8a-a040-ef00812b03e8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281320} :answer-field/id #uuid "1b947dfa-2181-55d4-a6cc-1928297d422e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281319}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "958c8a96-376c-5bbd-bca4-7ca1bae02381" :question/math-academy-id "q-341825" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=\\operatorname{tan}⁡x-{x}^{2}$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x-{x}^{2}) \\\\  & ={sec}^{2}⁡x-2x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={sec}^{2}⁡(0)-2\\cdot 0 \\\\  & ={(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2}-0 \\\\  & ={(\\frac{1}{1})}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $1.$"}] [{:db/id #edb/ref 17592186281321 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea2b7d0b-3612-5bee-8ccd-a56606c8af65" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b=e+1$" :db/id #edb/ref 17592186281323} {:answer/id #uuid "c28b45f8-8324-5eb1-9c9c-334f4006b896" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b=2e$" :db/id #edb/ref 17592186281324} {:answer/id #uuid "89f95166-9a92-5dfe-b19d-17dd972877b9" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b={e}^{2}$" :db/id #edb/ref 17592186281325} {:answer/id #uuid "f6be9a2b-cbbe-5b8f-afec-ff1fc8fcbd0e" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b={e}^{2}$" :db/id #edb/ref 17592186281326} {:answer/id #uuid "ee50c769-188e-5968-b82d-3d9c5dc8abf7" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡(x+e)$ and $b=2e$" :db/id #edb/ref 17592186281327}] :answer-field/correct {:answer/id #uuid "c28b45f8-8324-5eb1-9c9c-334f4006b896" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)=\\operatorname{ln}⁡x$ and $b=2e$" :db/id #edb/ref 17592186281324} :answer-field/id #uuid "ddf17f9d-4e6e-5a31-ad2d-5723949d666e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281322}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "00fd6781-496f-504f-8d8f-9433de9018a5" :question/math-academy-id "q-49235" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{e}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nNotice that we're given that the lower limit $a=e.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{e}{n}.$ Therefore, \n\n$$\n\\frac{e}{n}=\\frac{b-e}{n}\\,⟹\\,b=2e.\n$$\n\nConsequently,  ${x}_{i}=e+\\frac{ie}{n}$ and $f({x}_{i})=\\operatorname{ln}⁡{x}_{i}.$\n\nHence,\n\n$$\n{\\int }_{e}^{2e}\\operatorname{ln}⁡x\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{ln}⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=\\operatorname{ln}⁡x$ and $b=2e.$"}] [{:db/id #edb/ref 17592186281328 :knowledge-point/_questions [{:knowledge-point/id #uuid "74d05ad6-7e4a-5c50-92d1-ca4b2f00cbb1" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e50b1afc-26db-5300-95e4-d136af180bb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186281330} {:answer/id #uuid "4be21ce8-b07d-501b-b492-b7775e7ff8e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281331} {:answer/id #uuid "f7676bcf-48a9-5fe9-b2ad-9877140590d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186281332} {:answer/id #uuid "111f812b-1ee8-5c4b-8c26-5c7ce9b79659" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186281333} {:answer/id #uuid "024bca2e-a111-5a14-b298-87c1348bde31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186281334}] :answer-field/correct {:answer/id #uuid "4be21ce8-b07d-501b-b492-b7775e7ff8e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186281331} :answer-field/id #uuid "18357b7a-266a-57cd-94ca-5cb250dacb07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281329}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef571d7e-15de-5505-9d00-d15c6ffa6363" :question/math-academy-id "q-64730" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980882/assets/2f01b946a5c7c0f93c2171379603c4426913af5a15d0bc03434785144cfe4102.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{2},$ what is $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{2}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{2}.\n$$\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{2}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{4}} \\\\  & =\\pm \\sqrt{\\frac{2}{4}} \\\\  & =\\pm \\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. Therefore $\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{2}}{2}.$\n\nUsing the fact that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we finally get\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{\\sqrt{2}}{2})}{(\\frac{\\sqrt{2}}{2})}=1.\n$$"}] [{:db/id #edb/ref 17592186281335 :knowledge-point/_questions [{:knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39e6c3a2-e3a1-53c6-814d-7982a5f05597" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{3},\\,x=3" :db/id #edb/ref 17592186281337} {:answer/id #uuid "f25f276a-ff70-5532-b497-89768d96d295" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{3},\\,x=\\frac{1}{3}" :db/id #edb/ref 17592186281338} {:answer/id #uuid "fd9ec87d-a2fb-5f41-b5c1-7d480630bbec" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,x=\\frac{1}{3}" :db/id #edb/ref 17592186281339} {:answer/id #uuid "9be9616c-3a2f-58b8-b272-43e6fa6f4846" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,x=3" :db/id #edb/ref 17592186281340} {:answer/id #uuid "3a96f723-d9fe-5114-8287-a025721d0042" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186281341}] :answer-field/correct {:answer/id #uuid "3a96f723-d9fe-5114-8287-a025721d0042" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186281341} :answer-field/id #uuid "4e3d6524-f45c-5166-a47a-2e3b19a6d6f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281336}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "32ba2264-1073-53c2-9413-bebb41a92212" :question/math-academy-id "q-6912" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{2x}{3{x}^{2}+1}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n3{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ does not have any vertical asymptotes."}] [{:db/id #edb/ref 17592186281342 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c72ad8-2c0d-5d8c-bd82-960e64e520d2" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186281344} {:answer/id #uuid "30c6d6b9-549a-591e-afc8-ebcc2062c940" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186281345} {:answer/id #uuid "c0127500-c0b2-5531-b0b3-ab6c7813146d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281346} {:answer/id #uuid "c2575243-a1ef-5f75-8ad0-18c5c44971e1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186281347} {:answer/id #uuid "8bc0c876-a3c9-5caa-822f-6cea52030431" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281348}] :answer-field/correct {:answer/id #uuid "03c72ad8-2c0d-5d8c-bd82-960e64e520d2" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186281344} :answer-field/id #uuid "97f261a2-9dca-5877-9367-865ceec97cf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281343}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07cdba0d-b698-52a7-a7d7-7d131e11e8f5" :question/math-academy-id "q-78131" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980882/assets/3c0dc4b8f7f45a5bc1177778431eccf9bcaac1bf6d520d605f9e6bc08d5b1d91.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\n- $x=-2$\n- $x=0$\n- $x=2$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is not continuous at $x=-2.$ Since there is an asymptote at $x=-2,$ it is impossible to draw the function in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is continuous at $x=0.$ The graph can be drawn in the neighborhood of $x=0$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is continuous at $x=2.$ The graph can be drawn in the neighborhood of $x=2$ without taking our pencil off of the paper.\n\nHence, the correct answer is \"II and III only\"."}]}
