#{[{:db/id #edb/ref 17592186129338 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aabbb934-741b-5e31-bec7-3a01bf0641f2" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{π}{4} + \\frac{nπ}{6}" :db/id #edb/ref 17592186125835} {:answer/id #uuid "f200cfb3-4182-5cb7-a692-895b48fb333f" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{nπ}{3}" :db/id #edb/ref 17592186125836} {:answer/id #uuid "11933639-0b06-5c77-9282-e5c44ae54526" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{π}{3} + \\frac{nπ}{4}" :db/id #edb/ref 17592186125837} {:answer/id #uuid "398e2ab4-86c1-5d94-8706-695ca8118381" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{nπ}{4}" :db/id #edb/ref 17592186125838} {:answer/id #uuid "5a3451c5-c8f4-532e-92c8-c4d02570aec4" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{π}{6} + \\frac{nπ}{3}" :db/id #edb/ref 17592186125839}] :answer-field/correct {:answer/id #uuid "f200cfb3-4182-5cb7-a692-895b48fb333f" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ne \\frac{nπ}{3}" :db/id #edb/ref 17592186125836} :answer-field/id #uuid "7d5db013-f68f-5e2c-8f62-c0cf2ce047d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186125834}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5b603bb2-83f9-5e88-8ecc-163481ff664d" :question/math-academy-id "q-10404" :question/problem "What is the domain of the function  $f(x)=2\\operatorname{cot}⁡(3x)?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{cot}⁡x$ is given by the expression\n\n$$\nx\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $2\\operatorname{cot}⁡(3x),$ we replace the $x$ on the left-hand side of the above with $(3x).$ This gives\n\n$$\n3x\\ne n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}3x & \\ne n\\pi  \\\\ x & \\ne \\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{n\\pi }{3},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186276297 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fcac61d-695e-5554-9f4d-7de5fe867dfd" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{3\\pi }{2}+3n\\pi " :db/id #edb/ref 17592186276299} {:answer/id #uuid "40e93def-d1d5-5414-a55a-1ddb48e21501" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{3\\pi }{2}+n\\pi " :db/id #edb/ref 17592186276300} {:answer/id #uuid "0336b4b0-cb3a-5321-8eaa-61b75d000693" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186276301} {:answer/id #uuid "a0013cf5-eb51-5b6a-aae9-684a44a9457e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{2}+4n\\pi " :db/id #edb/ref 17592186276302} {:answer/id #uuid "cfc93677-52b5-53aa-9bcc-e50761fa688d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+\\frac{2n\\pi }{3}" :db/id #edb/ref 17592186276303}] :answer-field/correct {:answer/id #uuid "0fcac61d-695e-5554-9f4d-7de5fe867dfd" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ne \\frac{3\\pi }{2}+3n\\pi " :db/id #edb/ref 17592186276299} :answer-field/id #uuid "34b2fdc7-ca35-54c9-b580-3331b57d0057" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276298}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ff49aec1-dbe8-567d-97c7-2ab5d0eb085f" :question/math-academy-id "q-10406" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(\\frac{x}{3})+1?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(\\frac{x}{3})+1,$ we replace the $x$ on the left-hand side of the above with $(\\frac{x}{3}).$ This gives\n\n$$\n\\frac{x}{3}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{3} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{3\\pi }{2}+3n\\pi .\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{3\\pi }{2}+3n\\pi ,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186129518 :knowledge-point/_questions [{:knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5a6f290-2578-52a6-b6c3-8141919ab3e8" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{4} + \\frac{π}{2}" :db/id #edb/ref 17592186126903} {:answer/id #uuid "1ce1ee2f-d603-5ff5-a9a2-2df6222771fd" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{2} + \\frac{nπ}{3}" :db/id #edb/ref 17592186126904} {:answer/id #uuid "79e12d3a-bcff-572d-9e7e-fcd1ca90eff5" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{6} + \\frac{nπ}{2}" :db/id #edb/ref 17592186126905} {:answer/id #uuid "79e52fff-8d65-5aa8-8eb7-3d710a32c654" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{3} + \\frac{nπ}{3}" :db/id #edb/ref 17592186126906} {:answer/id #uuid "7f5b911f-9fdc-56d8-a7be-9aa2ccbff28a" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{6} + \\frac{nπ}{3}" :db/id #edb/ref 17592186126907}] :answer-field/correct {:answer/id #uuid "7f5b911f-9fdc-56d8-a7be-9aa2ccbff28a" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{π}{6} + \\frac{nπ}{3}" :db/id #edb/ref 17592186126907} :answer-field/id #uuid "645259c0-483b-5d6d-bcba-8ea6e59bc3cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126902}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c1a32678-c222-5acf-a84e-47fe7a7eb545" :question/math-academy-id "q-29352" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(3x)+2?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(3x)+2,$ we replace the $x$ on the left-hand side of the above with $(3x).$ This gives\n\n$$\n3x=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}3x & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{6}+\\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{6}+\\frac{n\\pi }{3},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186276304 :knowledge-point/_questions [{:knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8dc52fc-98f0-5bc9-8fe3-92389c14490e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{8}" :db/id #edb/ref 17592186276306} {:answer/id #uuid "5fe5fc7f-e618-516e-864d-3d6f7548060b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186276307} {:answer/id #uuid "4e3bb7ed-b663-5998-9706-e51c7a8fa092" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi n" :db/id #edb/ref 17592186276308} {:answer/id #uuid "ead94950-c0e2-5cb3-bd4e-fc64a0c04635" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{4}" :db/id #edb/ref 17592186276309} {:answer/id #uuid "52b6b85b-edd5-5a10-ae7b-35a3e9f6b321" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi n" :db/id #edb/ref 17592186276310}] :answer-field/correct {:answer/id #uuid "5fe5fc7f-e618-516e-864d-3d6f7548060b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186276307} :answer-field/id #uuid "ce6064ee-6d16-5ec2-ab67-38aae0c43702" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276305}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "db3f3d5c-5651-5847-bdb7-4ee59fd9d9fa" :question/math-academy-id "q-81542" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=\\operatorname{tan}⁡(2x)?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{tan}⁡x$ are given by\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & =n\\pi  \\\\ x & =\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186276311 :knowledge-point/_questions [{:knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad233bc5-bfa0-5d47-9ba5-258600819bb8" :answer/type {:db/ident :answer.type/math} :answer/value "x=2+n" :db/id #edb/ref 17592186276313} {:answer/id #uuid "77596efb-c13d-58ef-bf89-056eaf7245a4" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186276314} {:answer/id #uuid "b0f2dca3-3ffc-5904-b7ad-84e2397e9e07" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186276315} {:answer/id #uuid "52df50b3-e220-546d-994c-1fbe30c3784b" :answer/type {:db/ident :answer.type/math} :answer/value "x=1+2n" :db/id #edb/ref 17592186276316} {:answer/id #uuid "c770b61f-0034-5113-b019-c22675fa17fa" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pi +2n\\pi " :db/id #edb/ref 17592186276317}] :answer-field/correct {:answer/id #uuid "52df50b3-e220-546d-994c-1fbe30c3784b" :answer/type {:db/ident :answer.type/math} :answer/value "x=1+2n" :db/id #edb/ref 17592186276316} :answer-field/id #uuid "9d25ae64-a58a-5566-9862-d970b871c7d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276312}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "32ece69d-c2b4-54a3-8cdb-0af4b72c6b7a" :question/math-academy-id "q-81557" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(\\frac{\\pi x}{2})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(\\frac{\\pi x}{2}),$ we replace the $x$ on the left-hand side of the above with $(\\frac{\\pi x}{2}).$ This gives\n\n$$\n\\frac{\\pi x}{2}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\pi x}{2} & =\\frac{\\pi }{2}+n\\pi  \\\\ \\frac{x}{2} & =\\frac{1}{2}+n \\\\ x & =1+2n.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=1+2n,$ where $n$ is an integer."}]}
