c28d7"] :db/ensure [:answer-field/validate]} {:db/id "q-40333" :question/id #uuid "339b5953-a820-57a6-b370-eaa9a986d779" :question/math-academy-id "q-40333" :question/problem "Given the polynomial $P(x)=-{x}^{2}(x+1)(x-2)(x+2),$ find the solution of $P(x)\\le 0.$" :question/worked-solution "To solve the inequality $P(x)\\le 0,$ we need to find the values of $x$ for which the curve $y=P(x)$ lies below the $x$-axis or touches this axis.\n\nThe roots of the polynomial $P(x)=-{x}^{2}(x+1)(x-2)(x+2)$ are $x=\\pm 2,x=-1$ and $x=0,$ where\n\n- $x=\\pm 2$ and $x=-1$ are simple roots, and\n\n- $x=0$ has multiplicity $2.$\n\nAlso, $P(x)$ is a quintic polynomial with a negative leading coefficient. So, we can graph the curve as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033945/assets/1fb947e6360139669bae0821e0de8460da53ead628f589998fab1ce442646cdf.png)\n\nSince we are interested in solving $P(x)\\le 0,$ we look for the part of the curve that is below the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $x\\in [-2,-1]\\cup {0}\\cup [2,\\infty ).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40333/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64b71f10-5b2b-5cae-a5dc-b9c160484d82"] :knowledge-point/questions ["q-40333"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40334/selection/67ae0fa3bf421bbc28050ba872db939a2810ba4d64242009b122f16f7feac0b3" :answer/id #uuid "c796b0ea-a4f0-55c1-b581-253020801a7b" :answer/type :answer.type/math :answer/value "x\\in (-1,2)" :db/ensure [:answer/validate]} {:db/id "q-40334/selection/9db0efa0948cf6c66c19d7e27ce3575bd938c29862489347745fb8087459262f" :answer/id #uuid "b723e3b0-c6c9-5e15-8974-6d270b7173d8" :answer/type :answer.type/math :answer/value "x\\in (2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-40334/selection/cb2db2c3536d80ef3e6a23ca4b9c540c483fed8d8b3b89ae1e3d882a398517e3" :answer/id #uuid "e0ffb3bc-c9bb-5b86-9c1e-b56c06569d60" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-1)" :db/ensure [:answer/validate]} {:db/id "q-40334/selection/43457592f1e6c654a81f371d2be0207c4f221a8bdf2c8b17fbbd8f5e511ec9ed" :answer/id #uuid "1c4073e8-f2fa-508a-9e58-9ac55da4fef3" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-1)\\cup (2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-40334/selection/c1f987ba5d42f3797a39b4472ab54a37d59d0606d886589ec09c8bdae67d495d" :answer/id #uuid "eb2f7c96-343f-55b7-bf16-aebd7723db96" :answer/type :answer.type/math :answer/value "x\\in (-1,0)\\cup (0,2)" :db/ensure [:answer/validate]} {:db/id "q-40334/selection" :answer-field/id #uuid "1f189ece-3137-5595-951a-316be6645793" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40334/selection/43457592f1e6c654a81f371d2be0207c4f221a8bdf2c8b17fbbd8f5e511ec9ed" :answer-field/choices ["q-40334/selection/67ae0fa3bf421bbc28050ba872db939a2810ba4d64242009b122f16f7feac0b3" "q-40334/selection/9db0efa0948cf6c66c19d7e27ce3575bd938c29862489347745fb8087459262f" "q-40334/selection/cb2db2c3536d80ef3e6a23ca4b9c540c483fed8d8b3b89ae1e3d882a398517e3" "q-40334/selection/43457592f1e6c654a81f371d2be0207c4f221a8bdf2c8b17fbbd8f5e511ec9ed" "q-40334/selection/c1f987ba5d42f3797a39b4472ab54a37d59d0606d886589ec09c8bdae67d495d"] :db/ensure [:answer-field/validate]} {:db/id "q-40334" :question/id #uuid "8d4d2b0d-5f7d-59e7-b207-07fa5cc43dcd" :question/math-academy-id "q-40334" :question/problem "Given $P(x)={x}^{4}-{x}^{3}-2{x}^{2},$ solve $P(x)>0.$" :question/worked-solution "To solve the inequality $P(x)>0,$ we need to find the values of $x$ for which the curve $y=P(x)$ lies above the $x$-axis.\n\nFirst, we factorize the polynomial $P(x):$\n\n$$\n\\begin{aligned}P(x) & ={x}^{4}-{x}^{3}-2{x}^{2} \\\\  & ={x}^{2}({x}^{2}-x-2) \\\\  & ={x}^{2}({x}^{2}+x-2x-2) \\\\  & ={x}^{2}(x(x+1)-2(x+1)) \\\\  & ={x}^{2}(x+1)(x-2)\\end{aligned}\n$$\n\nThe roots of the polynomial $P(x)={x}^{4}-{x}^{3}-2{x}^{2}$ are $x=-1,$ $x=0$ and $x=2,$ where\n\n- $x=0$ has multiplicity $2,$ and\n\n- $x=-1$ and $x=2$ are simple roots.\n\nSo, we can graph the curve as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033945/assets/c0756761d00b0805683e447d8cee3b657bbbe004a0a47da428927585037b06c2.png)\n\nSince we are interested in solving $P(x)>0,$ we look for the part of the curve that is above the $x$-axis.\n\nBased on the graph, the solution is $x\\in (-\\infty ,-1)\\cup (2,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40334/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "48de9cc7-5f86-51e4-a827-796f77381af2"] :knowledge-point/questions ["q-40334"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40338/selection/5a2fff3f4361c4773b8bfd62b219d9ad0aa450150b947642ad4fc012a087b8f9" :answer/id #uuid "dabba310-d4e4-5a16-bd43-a73d31cae5ca" :answer/type :answer.type/math :answer/value "x\\in (-2,2)" :db/ensure [:answer/validate]} {:db/id "q-40338/selection/bf00229e223e44eb20258cc38287d60c51cdcb0aaefb8c636fad11a1c721095f" :answer/id #uuid "2d53e61a-6427-53e2-a9e6-b3337c00bd17" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,0)" :db/ensure [:answer/validate]} {:db/id "q-40338/selection/864ebf6cd385f6a29c4148920ec1de78409db023f67b141255972a197aae66b3" :answer/id #uuid "6b6e4308-cd2d-5294-890c-d1203cc620b2" :answer/type :answer.type/math :answer/value "x\\in (-2,0)\\cup (0,1)\\cup (1,2)" :db/ensure [:answer/validate]} {:db/id "q-40338/selection/f727e22e2133e1866b36d2e927f4ff4f4572101443305e90631d1945f717b356" :answer/id #uuid "5ff58f0c-4a40-5382-857b-87ba433df160" :answer/type :answer.type/math :answer/value "x\\in (-2,0)\\cup (1,2)" :db/ensure [:answer/validate]} {:db/id "q-40338/selection/0c5a94b86ba6318cd4c8e86af8d5fa01bdf8ae3384eb70ccfa5332fdc7bc4e44" :answer/id #uuid "ed1a1e36-e68a-5aff-b21d-3963066c9ec2" 