[{:db/id "q-127510/selection/4fb4850b6697d9f765c31b591dd434eb67c25e4e1bd0de372bb84019ab261363" :answer/id #uuid "98e1e0ff-743c-569c-b614-76b1a24afd2f" :answer/type :answer.type/math :answer/value "\\frac{3}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127510/selection/648b3e475b1437c8b64e5ca7b1baf7821527489d00065b6f3507faba525de458" :answer/id #uuid "6bf53810-17e3-50d9-9265-faef9adc9f6c" :answer/type :answer.type/math :answer/value "-\\frac{1}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127510/selection/3d9ff2e6233f2aeb9f3e60a4d8c756407ee07b760bdca66d76901b7c908d78ae" :answer/id #uuid "57dee876-bdb8-5b12-82df-d69cf4a140e5" :answer/type :answer.type/math :answer/value "-\\frac{1}{6y}" :db/ensure [:answer/validate]} {:db/id "q-127510/selection/42b18b4bfcc20a237fc869c5f819e26f68291e29538fdea9c0b07aa1292ef625" :answer/id #uuid "637894dd-0d6c-54a9-83ad-56488e748ea4" :answer/type :answer.type/math :answer/value "\\frac{2}{y}" :db/ensure [:answer/validate]} {:db/id "q-127510/selection/b193fd41ef4d3d55f57a336b0d37348bf7f8888e926f8d035510eabf1558d151" :answer/id #uuid "9f744bd6-01c2-5c3a-aa68-d050b8b71e50" :answer/type :answer.type/math :answer/value "\\frac{6}{y}" :db/ensure [:answer/validate]} {:db/id "q-127510/selection" :answer-field/id #uuid "b72d92f6-80a1-5d86-ad74-6bc51e0181cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127510/selection/b193fd41ef4d3d55f57a336b0d37348bf7f8888e926f8d035510eabf1558d151" :answer-field/choices ["q-127510/selection/4fb4850b6697d9f765c31b591dd434eb67c25e4e1bd0de372bb84019ab261363" "q-127510/selection/648b3e475b1437c8b64e5ca7b1baf7821527489d00065b6f3507faba525de458" "q-127510/selection/3d9ff2e6233f2aeb9f3e60a4d8c756407ee07b760bdca66d76901b7c908d78ae" "q-127510/selection/42b18b4bfcc20a237fc869c5f819e26f68291e29538fdea9c0b07aa1292ef625" "q-127510/selection/b193fd41ef4d3d55f57a336b0d37348bf7f8888e926f8d035510eabf1558d151"] :db/ensure [:answer-field/validate]} {:db/id "q-127510" :question/id #uuid "f4ab8b81-d973-5071-988e-98d4a76582ba" :question/math-academy-id "q-127510" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/e0d18f7db92cfbe372f998e69d2395f2d586eb36cd25773588149c4ccf678eba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(3,6).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(3,6)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=3$ and $y=6$ into the equation above, we get\n\n$$\n\\begin{aligned}(6)^{2} & =4p(3) \\\\ 36 & =12p \\\\ p & =3.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=12x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =12 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127510/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-127510"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127520/selection/bea7d3eed16960e568d1baa543a4204b898cb1032d10c2587e52123bb86f6e6c" :answer/id #uuid "86000a37-cb17-56c9-9c4d-ac70884a8bd8" :answer/type :answer.type/math :answer/value "-\\frac{1}{y}" :db/ensure [:answer/validate]} {:db/id "q-127520/selection/f6684b45a352276f7e17cf36c22fb7343364ae1d091274bee0b93b89dc5cf94b" :answer/id #uuid "c818e460-5a42-58d4-8eb8-baf86e9968cd" :answer/type :answer.type/math :answer/value "-\\frac{2}{y}" :db/ensure [:answer/validate]} {:db/id "q-127520/selection/f17f9a3f25127a6cfd9e39307fa301a45afc47758f59b426c5bf2ced8c5cf1b4" :answer/id #uuid "e4de1cc8-d105-5589-9c7e-39f1fa8f3425" :answer/type :answer.type/math :answer/value "\\frac{1}{4y}" :db/ensure [:answer/validate]} {:db/id "q-127520/selection/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" :answer/id #uuid "1f5a1c87-0513-55ba-86f0-3ede239e862c" :answer/type :answer.type/math :answer/value "\\frac{4}{y}" :db/ensure [:answer/validate]} {:db/id "q-127520/selection/648b3e475b1437c8b64e5ca7b1baf7821527489d00065b6f3507faba525de458" :answer/id #uuid "98f3616f-ff9d-5f02-b530-4721c8d8710f" :answer/type :answer.type/math :answer/value "-\\frac{1}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127520/selection" :answer-field/id #uuid "9fa7ac80-0e41-5656-a28a-a763fd0dd171" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127520/selection/bea7d3eed16960e568d1baa543a4204b898cb1032d10c2587e52123bb86f6e6c" :answer-field/choices ["q-127520/selection/bea7d3eed16960e568d1baa543a4204b898cb1032d10c2587e52123bb86f6e6c" "q-127520/selection/f6684b45a352276f7e17cf36c22fb7343364ae1d091274bee0b93b89dc5cf94b" "q-127520/selection/f17f9a3f25127a6cfd9e39307fa301a45afc47758f59b426c5bf2ced8c5cf1b4" "q-127520/selection/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" "q-127520/selection/648b3e475b1437c8b64e5ca7b1baf7821527489d00065b6f3507faba525de458"] :db/ensure [:answer-field/validate]} {:db/id "q-127520" :question/id #uuid "fd639251-1f6a-5740-8dfa-329f5ae4115a" :question/math-academy-id "q-127520" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/60987d053d138d4a26cbc05adccb0da23810f97243f9399d3fe401a0202394b0.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-8,4).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-8$ and $y=4$ into the equation above, we get\n\n$$\n\\begin{aligned}(4)^{2} & =4p(-8) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-2x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-2x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-127520/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-127520"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127523/selection/a7ff0523ec24bf10f5f21883d90e047892b164f74941f50f470ca1e831fe5fcb" :answer/id #uuid "cfdf1a21-cf48-581c-a4c2-8ac86c161b28" :answer/type :answer.type/math :answer/value "\\frac{y-1}{4(x-1)}" :db/ensure [:answer/validate]} {:db/id "q-127523/selection/86cddbaa537bb94df70b94b9907bcd2db888d5846f407e60e0135b321cb947e4" :answer/id #uuid "479cd430-21a3-583b-8062-21ebd12a9c5b" :answer/type :answer.type/math :answer/value "-\\frac{x+1}{4(y+1)}" :db/ensure [:answer/validate]} {:db/id "q-127523/selection/91051edc75a6cb3e524348181caea8d414496ed25a7d777ec066c4d4ead158ca" :answer/id #uuid "2b4bd7b8-af8d-574b-960c-4767a8226061" :answer/type :answer.type/math :answer/value "-\\frac{4(y+1)}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-127523/selection/c4e86b066dd8bb588856cac20f35d9bdd75d95ee11b1c96af6a906a5fe7e2f58" :answer/id #uuid "1224f751-bdcd-5e67-a3e4-b857b6191a0d" :answer/type :answer.type/math :answer/value "-\\frac{4(x+1)}{y+1}" :db/ensure [:answer/validate]} {:db/id "q-127523/selection/e2b9aeafbd4d837591c76e0fbea0698c4617237164f1050f4d01ddb127e86f88" :answer/id #uuid "981201de-0a80-50ed-b82e-4e3003d941d0" :answer/type :answer.type/math :answer/value "\\frac{x-1}{4(y-1)}" :db/ensure [:answer/validate]} {:db/id "q-127523/selection" :answer-field/id #uuid "fc7f9366-e691-5d53-b492-a61f456e856f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127523/selection/86cddbaa537bb94df70b94b9907bcd2db888d5846f407e60e0135b321cb947e4" :answer-field/choices ["q-127523/selection/a7ff0523ec24bf10f5f21883d90e047892b164f74941f50f470ca1e831fe5fcb" "q-127523/selection/86cddbaa537bb94df70b94b9907bcd2db888d5846f407e60e0135b321cb947e4" "q-127523/selection/91051edc75a6cb3e524348181caea8d414496ed25a7d777ec066c4d4ead158ca" "q-127523/selection/c4e86b066dd8bb588856cac20f35d9bdd75d95ee11b1c96af6a906a5fe7e2f58" "q-127523/selection/e2b9aeafbd4d837591c76e0fbea0698c4617237164f1050f4d01ddb127e86f88"] :db/ensure [:answer-field/validate]} {:db/id "q-127523" :question/id #uuid "d416524e-532d-55cb-a87a-c47d846d65e0" :question/math-academy-id "q-127523" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/ebef81911a434828ab94e643007d06b677538cdf0995198c7a065e35a8f81996.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(-1,-1)$ and has semiaxes $2$ and $1,$ its equation is given by\n\n$$\n\\frac{(x-(-1))^{2}}{{2}^{2}}+\\frac{(y-(-1))^{2}}{{1}^{2}}=1\\,⟹\\,\\frac{(x+1)^{2}}{4}+(y+1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4}+(y+1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}((y+1)^{2}) & =0 \\\\ \\frac{2(x+1)}{4}+2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{4(y+1)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127523/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127525/selection/89b83b723da2cb2f9f7dedfbbb5bbe80b821abdb6d93b1dbc6c20aad7c9d0689" :answer/id #uuid "6c093218-0b96-5e69-a871-4dbe27adf686" :answer/type :answer.type/math :answer/value "\\frac{3(y-1)}{2x}" :db/ensure [:answer/validate]} {:db/id "q-127525/selection/ed4c78a62513c4b42cbcd6f138719c41ccbd3e9bf59d5e4885314c734c9162e5" :answer/id #uuid "57712342-f680-5a52-933c-8243de72b458" :answer/type :answer.type/math :answer/value "-\\frac{9x}{4(y-1)}" :db/ensure [:answer/validate]} {:db/id "q-127525/selection/30966167bc68d387ede97fd41b09a3a4d753597d3e18d1f0bf04052025b306f8" :answer/id #uuid "7299e052-a6df-579c-a570-959e642f84f4" :answer/type :answer.type/math :answer/value "\\frac{4x}{9(y-1)}" :db/ensure [:answer/validate]} {:db/id "q-127525/selection/4613aedbdaeadd843140d584fdb87aa5673ccf1edd582e716b5f1f63118b34fe" :answer/id #uuid "ec9292c9-d3b6-58be-a58e-e42b602dc42d" :answer/type :answer.type/math :answer/value "-\\frac{4(y-1)}{9x}" :db/ensure [:answer/validate]} {:db/id "q-127525/selection/2306e8f687d39832f3e41d1fd0dcdd58ac47201763b576883926a09b51018464" :answer/id #uuid "eaf47958-aafc-5a1a-ab57-ec43012205a6" :answer/type :answer.type/math :answer/value "\\frac{3x}{2(y-1)}" :db/ensure [:answer/validate]} {:db/id "q-127525/selection" :answer-field/id #uuid "23020047-306d-563d-9dfd-103d5832c02a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127525/selection/ed4c78a62513c4b42cbcd6f138719c41ccbd3e9bf59d5e4885314c734c9162e5" :answer-field/choices ["q-127525/selection/89b83b723da2cb2f9f7dedfbbb5bbe80b821abdb6d93b1dbc6c20aad7c9d0689" "q-127525/selection/ed4c78a62513c4b42cbcd6f138719c41ccbd3e9bf59d5e4885314c734c9162e5" "q-127525/selection/30966167bc68d387ede97fd41b09a3a4d753597d3e18d1f0bf04052025b306f8" "q-127525/selection/4613aedbdaeadd843140d584fdb87aa5673ccf1edd582e716b5f1f63118b34fe" "q-127525/selection/2306e8f687d39832f3e41d1fd0dcdd58ac47201763b576883926a09b51018464"] :db/ensure [:answer-field/validate]} {:db/id "q-127525" :question/id #uuid "aa181e11-20ae-5975-ae43-f6e2c0ff7bd3" :question/math-academy-id "q-127525" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/eb0fbc8f57621946a5ec5168e8c607d230269e0c6a64b4c86c835c110f0f6288.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(0,1)$ and has semiaxes $2$ and $3,$ its equation is given by\n\n$$\n\\frac{(x-0)^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{{3}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{(y-1)^{2}}{9}) & =0 \\\\ \\frac{2x}{4}+\\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{4(y-1)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127525/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127525"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342355/field-1/7915590ef0c399e3ecfb584fcf1b3b6bec09bc495b277f4dfa87b3efad31d3e7" :answer/id #uuid "d71d8b6e-ab16-5cf4-930c-5d1ee335292a" :answer/type :answer.type/math :answer/value "\\frac{1}{3y}" :db/ensure [:answer/validate]} {:db/id "q-342355/field-1" :answer-field/id #uuid "231c2430-d1e0-543c-87a8-51308491bc67" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342355/field-1/7915590ef0c399e3ecfb584fcf1b3b6bec09bc495b277f4dfa87b3efad31d3e7" :answer-field/choices ["q-342355/field-1/7915590ef0c399e3ecfb584fcf1b3b6bec09bc495b277f4dfa87b3efad31d3e7"] :db/ensure [:answer-field/validate]} {:db/id "q-342355" :question/id #uuid "0a45a514-77e5-5323-acea-ec16c914b3b7" :question/math-academy-id "q-342355" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/1aab10c5376ca6ae6c43829bc6f7617fb236b24c883d8ad61c47b83b75511d5a.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(6,-2).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=6$ and $y=-2$ into the equation above, we get\n\n$$\n\\begin{aligned}(-2)^{2} & =4p(6) \\\\ 4 & =24p \\\\ p & =\\frac{1}{6}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{2}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{3y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342355/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-342355"] :db/ensure [:knowledge-point/validate]}]
