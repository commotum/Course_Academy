#{[{:db/id #edb/ref 17592186359122 :knowledge-point/_questions [{:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f" :knowledge-point/title "Calculating the Slope of the Tangent to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57dee876-bdb8-5b12-82df-d69cf4a140e5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6y}" :db/id #edb/ref 17592186359124} {:answer/id #uuid "637894dd-0d6c-54a9-83ad-56488e748ea4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{y}" :db/id #edb/ref 17592186359125} {:answer/id #uuid "98e1e0ff-743c-569c-b614-76b1a24afd2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2y}" :db/id #edb/ref 17592186359126} {:answer/id #uuid "6bf53810-17e3-50d9-9265-faef9adc9f6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2y}" :db/id #edb/ref 17592186359127} {:answer/id #uuid "9f744bd6-01c2-5c3a-aa68-d050b8b71e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{y}" :db/id #edb/ref 17592186359128}] :answer-field/correct {:answer/id #uuid "9f744bd6-01c2-5c3a-aa68-d050b8b71e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{y}" :db/id #edb/ref 17592186359128} :answer-field/id #uuid "b72d92f6-80a1-5d86-ad74-6bc51e0181cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359123}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f4ab8b81-d973-5071-988e-98d4a76582ba" :question/math-academy-id "q-127510" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/e0d18f7db92cfbe372f998e69d2395f2d586eb36cd25773588149c4ccf678eba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(3,6).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(3,6)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=3$ and $y=6$ into the equation above, we get\n\n$$\n\\begin{aligned}(6)^{2} & =4p(3) \\\\ 36 & =12p \\\\ p & =3.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=12x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =12 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6}{y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186359129 :knowledge-point/_questions [{:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f" :knowledge-point/title "Calculating the Slope of the Tangent to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5a1c87-0513-55ba-86f0-3ede239e862c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{y}" :db/id #edb/ref 17592186359131} {:answer/id #uuid "98f3616f-ff9d-5f02-b530-4721c8d8710f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2y}" :db/id #edb/ref 17592186359132} {:answer/id #uuid "86000a37-cb17-56c9-9c4d-ac70884a8bd8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186359133} {:answer/id #uuid "e4de1cc8-d105-5589-9c7e-39f1fa8f3425" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4y}" :db/id #edb/ref 17592186359134} {:answer/id #uuid "c818e460-5a42-58d4-8eb8-baf86e9968cd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{y}" :db/id #edb/ref 17592186359135}] :answer-field/correct {:answer/id #uuid "86000a37-cb17-56c9-9c4d-ac70884a8bd8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{y}" :db/id #edb/ref 17592186359133} :answer-field/id #uuid "9fa7ac80-0e41-5656-a28a-a763fd0dd171" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359130}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "fd639251-1f6a-5740-8dfa-329f5ae4115a" :question/math-academy-id "q-127520" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/60987d053d138d4a26cbc05adccb0da23810f97243f9399d3fe401a0202394b0.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-8,4).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-8$ and $y=4$ into the equation above, we get\n\n$$\n\\begin{aligned}(4)^{2} & =4p(-8) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-2x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-2x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186359136 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a" :knowledge-point/title "Calculating the Slope of the Tangent to an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479cd430-21a3-583b-8062-21ebd12a9c5b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+1}{4(y+1)}" :db/id #edb/ref 17592186359138} {:answer/id #uuid "2b4bd7b8-af8d-574b-960c-4767a8226061" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4(y+1)}{x+1}" :db/id #edb/ref 17592186359139} {:answer/id #uuid "cfdf1a21-cf48-581c-a4c2-8ac86c161b28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y-1}{4(x-1)}" :db/id #edb/ref 17592186359140} {:answer/id #uuid "1224f751-bdcd-5e67-a3e4-b857b6191a0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4(x+1)}{y+1}" :db/id #edb/ref 17592186359141} {:answer/id #uuid "981201de-0a80-50ed-b82e-4e3003d941d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-1}{4(y-1)}" :db/id #edb/ref 17592186359142}] :answer-field/correct {:answer/id #uuid "479cd430-21a3-583b-8062-21ebd12a9c5b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+1}{4(y+1)}" :db/id #edb/ref 17592186359138} :answer-field/id #uuid "fc7f9366-e691-5d53-b492-a61f456e856f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359137}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d416524e-532d-55cb-a87a-c47d846d65e0" :question/math-academy-id "q-127523" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/ebef81911a434828ab94e643007d06b677538cdf0995198c7a065e35a8f81996.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(-1,-1)$ and has semiaxes $2$ and $1,$ its equation is given by\n\n$$\n\\frac{(x-(-1))^{2}}{{2}^{2}}+\\frac{(y-(-1))^{2}}{{1}^{2}}=1\\,⟹\\,\\frac{(x+1)^{2}}{4}+(y+1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4}+(y+1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}((y+1)^{2}) & =0 \\\\ \\frac{2(x+1)}{4}+2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{4(y+1)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186359143 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a" :knowledge-point/title "Calculating the Slope of the Tangent to an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eaf47958-aafc-5a1a-ab57-ec43012205a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x}{2(y-1)}" :db/id #edb/ref 17592186359145} {:answer/id #uuid "7299e052-a6df-579c-a570-959e642f84f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x}{9(y-1)}" :db/id #edb/ref 17592186359146} {:answer/id #uuid "ec9292c9-d3b6-58be-a58e-e42b602dc42d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4(y-1)}{9x}" :db/id #edb/ref 17592186359147} {:answer/id #uuid "6c093218-0b96-5e69-a871-4dbe27adf686" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(y-1)}{2x}" :db/id #edb/ref 17592186359148} {:answer/id #uuid "57712342-f680-5a52-933c-8243de72b458" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9x}{4(y-1)}" :db/id #edb/ref 17592186359149}] :answer-field/correct {:answer/id #uuid "57712342-f680-5a52-933c-8243de72b458" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9x}{4(y-1)}" :db/id #edb/ref 17592186359149} :answer-field/id #uuid "23020047-306d-563d-9dfd-103d5832c02a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186359144}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aa181e11-20ae-5975-ae43-f6e2c0ff7bd3" :question/math-academy-id "q-127525" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/eb0fbc8f57621946a5ec5168e8c607d230269e0c6a64b4c86c835c110f0f6288.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(0,1)$ and has semiaxes $2$ and $3,$ its equation is given by\n\n$$\n\\frac{(x-0)^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{{3}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{(y-1)^{2}}{9}) & =0 \\\\ \\frac{2x}{4}+\\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{4(y-1)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186359150 :knowledge-point/_questions [{:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f" :knowledge-point/title "Calculating the Slope of the Tangent to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d71d8b6e-ab16-5cf4-930c-5d1ee335292a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3y}" :db/id #edb/ref 17592186359152}] :answer-field/correct {:answer/id #uuid "d71d8b6e-ab16-5cf4-930c-5d1ee335292a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3y}" :db/id #edb/ref 17592186359152} :answer-field/id #uuid "231c2430-d1e0-543c-87a8-51308491bc67" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186359151}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0a45a514-77e5-5323-acea-ec16c914b3b7" :question/math-academy-id "q-342355" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069054/assets/1aab10c5376ca6ae6c43829bc6f7617fb236b24c883d8ad61c47b83b75511d5a.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(6,-2).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=6$ and $y=-2$ into the equation above, we get\n\n$$\n\\begin{aligned}(-2)^{2} & =4p(6) \\\\ 4 & =24p \\\\ p & =\\frac{1}{6}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{2}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{3y}\\end{aligned}\n$$"}]}
