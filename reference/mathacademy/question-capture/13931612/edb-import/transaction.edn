a6bd8b92ea2"] :db/ensure [:answer-field/validate]} {:db/id "q-10839" :question/id #uuid "193a75aa-4f94-519d-96f9-e023967170ab" :question/math-academy-id "q-10839" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y={x}^{2}-3x$ at the point $(-2,10).$" :question/worked-solution "Let $f(x)={x}^{2}-3x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3x)=2x-3.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(-2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(-2)=2(-2)-3=-7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-7$ and the coordinates of our point $(-2,10),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(10) & =-7(x-(-2)) \\\\ y-10 & =-7(x+2) \\\\ y & =-7x-14+10 \\\\ y & =-7x-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10839/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-10839"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10841/selection/dfa879c5187361c521910305b1d33c758fc2fbdab2d984242b7e043b37074919" :answer/id #uuid "002c1d3b-b850-5ea1-aec2-53feb52e2759" :answer/type :answer.type/math :answer/value "y=9" :db/ensure [:answer/validate]} {:db/id "q-10841/selection/4d2e65fd79bfd0d6e1621122b44f4d28cd5b4d9f2fd50e1b9323e06b6e542099" :answer/id #uuid "2297580a-178f-5cdc-85f6-f46595aee86a" :answer/type :answer.type/math :answer/value "y=9x" :db/ensure [:answer/validate]} {:db/id "q-10841/selection/15e4df905f760d5f390a000f165fecae1a509f84f1834c998b6f869ffc6965ad" :answer/id #uuid "84503a51-60f5-50ac-8980-6acef0742c68" :answer/type :answer.type/math :answer/value "y=-9" :db/ensure [:answer/validate]} {:db/id "q-10841/selection/a13e78d823132714d85d3a6a74a7e0580022c63f90cccb7625c8c22c7da46a31" :answer/id #uuid "117ec70f-6564-5998-874b-5a35d8109afb" :answer/type :answer.type/math :answer/value "y=-9x" :db/ensure [:answer/validate]} {:db/id "q-10841/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer/id #uuid "a0443d82-56ed-539e-aa3d-a614d2638075" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "q-10841/selection" :answer-field/id #uuid "cb4dc901-3ae4-5e02-9c7a-d48747e51481" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10841/selection/15e4df905f760d5f390a000f165fecae1a509f84f1834c998b6f869ffc6965ad" :answer-field/choices ["q-10841/selection/dfa879c5187361c521910305b1d33c758fc2fbdab2d984242b7e043b37074919" "q-10841/selection/4d2e65fd79bfd0d6e1621122b44f4d28cd5b4d9f2fd50e1b9323e06b6e542099" "q-10841/selection/15e4df905f760d5f390a000f165fecae1a509f84f1834c998b6f869ffc6965ad" "q-10841/selection/a13e78d823132714d85d3a6a74a7e0580022c63f90cccb7625c8c22c7da46a31" "q-10841/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7"] :db/ensure [:answer-field/validate]} {:db/id "q-10841" :question/id #uuid "7368e613-bb1f-5cb2-ac24-2ec824bcacc5" :question/math-academy-id "q-10841" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y={x}^{2}-6x$ at the point $(3,-9).$" :question/worked-solution "Let $f(x)={x}^{2}-6x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6x)=2x-6.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(3)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(3)=2(3)-6=0.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=0$ and the coordinates of our point $(3,-9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-9) & =0(x-3) \\\\ y & =-9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172