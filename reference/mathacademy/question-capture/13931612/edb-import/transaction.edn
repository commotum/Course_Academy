/validate]} {:db/id "q-10837" :question/id #uuid "8eed30ff-0254-5346-9105-1abcf394d3fd" :question/math-academy-id "q-10837" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y=5{x}^{2}+4x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=5{x}^{2}+4x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}+4x)=10x+4.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=10(1)+4=14\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=14$ and the coordinates of our point $(1,9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(9) & =14(x-1) \\\\ y & =14x-14+9 \\\\ y & =14x-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10837/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-10837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10845/selection/347e63bb4a291fdccf3f0a7943ee12da861e9872ada7f5a644d4e2cbe07f8d22" :answer/id #uuid "ab980c55-c12d-5fb6-9789-b5fc7b6a54ba" :answer/type :answer.type/math :answer/value "y=-3x+12" :db/ensure [:answer/validate]} {:db/id "q-10845/selection/d2b6b4de54f2b0bc64c8e4bc56ec311431b1b3ff8ab9733577ba30b67fbf7932" :answer/id #uuid "dc772fe7-1324-5027-bf0a-8d233e12c13f" :answer/type :answer.type/math :answer/value "y=-3x+1" :db/ensure [:answer/validate]} {:db/id "q-10845/selection/91c1d95f6da3e0df16c5befaf5ae3b37075fed8af62e96465ac49e557516c74e" :answer/id #uuid "41e52791-4f04-5105-a6df-3d4cee449839" :answer/type :answer.type/math :answer/value "y=-3x+6" :db/ensure [:answer/validate]} {:db/id "q-10845/selection/98ebaee805b16d66ee3ac31f79f0172bc3ccb5d41f465357213d8118b41775c5" :answer/id #uuid "c9d29286-ff59-5770-8d25-9bc0988f9f44" :answer/type :answer.type/math :answer/value "y=-3x+9" :db/ensure [:answer/validate]} {:db/id "q-10845/selection/7ae459c02791a2881b6671b6c7d20be0b288222eda2a2e3e5f762d4b64d93c2e" :answer/id #uuid "e79ee688-008e-5e02-b127-c180132956aa" :answer/type :answer.type/math :answer/value "y=-3x+3" :db/ensure [:answer/validate]} {:db/id "q-10845/selection" :answer-field/id #uuid "47482bac-a9de-5b00-af1f-2913ae2e4650" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10845/selection/347e63bb4a291fdccf3f0a7943ee12da861e9872ada7f5a644d4e2cbe07f8d22" :answer-field/choices ["q-10845/selection/347e63bb4a291fdccf3f0a7943ee12da861e9872ada7f5a644d4e2cbe07f8d22" "q-10845/selection/d2b6b4de54f2b0bc64c8e4bc56ec311431b1b3ff8ab9733577ba30b67fbf7932" "q-10845/selection/91c1d95f6da3e0df16c5befaf5ae3b37075fed8af62e96465ac49e557516c74e" "q-10845/selection/98ebaee805b16d66ee3ac31f79f0172bc3ccb5d41f465357213d8118b41775c5" "q-10845/selection/7ae459c02791a2881b6671b6c7d20be0b288222eda2a2e3e5f762d4b64d93c2e"] :db/ensure [:answer-field/validate]} {:db/id "q-10845" :question/id #uuid "88d07886-4d1e-5870-a644-8ea1806855a9" :question/math-academy-id "q-10845" :question/is-example false :question/problem "Find the equation of the tangent to the curve $y=\\frac{2}{{x}^{5}}+7x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=\\frac{2}{{x}^{5}}+7x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{5}}+7x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-5}+7x) \\\\  & =-10{x}^{-6}+7.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-10(1{)}^{-6}+7=-3.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=-3$ and the coordinates of our point $(1,9),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(9) & =-3(x-1) \\\\ y & =-3x+3+9 \\\\ y & =-3x+12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10845/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-10845"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342381/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e8d87bba-be48-528a-9962-6d47fab533ba" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342381/field-1" :answer-field/id #uuid "d903a737-5156-5f34-aae6-45a8845d4d0e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342381/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342381/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342381/field-2/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer/id #uuid "d3b196b9-e364-5805-b77c-b0f3b211a844" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "q-342381/field-2" :answer-field/id #uuid "b89c3483-164c-5f89-b0ea-79f656408f92" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342381/field-2/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer-field/choices ["q-342381/field-2/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b"] :db/ensure [:answer-field/validate]} {:db/id "q-342381" :question/id #uuid "ab8d2aab-354f-5dc2-82dc-fb8380f780da" :question/math-academy-id "q-342381" :question/is-example false :question/problem "Find where the tangent to the curve $y=\\sqrt{x}+\\frac{6}{\\sqrt{x}}$ at the point  $(4,5)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\sqrt{x}+\\frac{6}{\\sqrt{x}}.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\frac{6}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{1/2})+6\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-1/2}) \\\\  & =\\frac{1}{2}{x}^{-1/2}+6\\cdot (-\\frac{1}{2}){x}^{-3/2} \\\\  & =\\frac{1}{2\\sqrt{x}}-\\frac{3}{\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(4) \\\\  & =\\frac{1}{2\\sqrt{4}}-\\frac{3}{\\sqrt{{4}^{3}}} \\\\  & =\\frac{1}{4}-\\frac{3}{8} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-\\frac{1}{8}(x-4) \\\\ y & =-\\frac{1}{8}x+\\frac{1}{2}+5 \\\\ y & =-\\frac{1}{8}x+\\frac{11}{2}.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{8}(0)+\\frac{11}{2} \\\\ y & =\\frac{11}{2}.\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,\\frac{11}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342381/field-1" "q-342381/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c"] :knowledge-point/questions ["q-342381"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342379/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "2c545b39-b9ff-51ab-8caf-82da656c835a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-342379/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "bf40c181-630d-5501-b3d8-4eb636e69ca8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-342379/field-1" :answer-field/id #uuid "ca77e8de-3c50-543a-8e83-140af27526e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342379/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-342379/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-342379/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-342379/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fb1dd618-c830-53be-8911-3190b6bdf9a6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342379/field-2" :answer-field/id #uuid "7a0ab9dd-4e4a-5811-8205-125ba522e619" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342379/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342379/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342379" :question/id #uuid "fbe0283f-22e7-53a8-b4f7-b07d4936416a" :question/math-academy-id "q-342379" :question/is-example false :question/problem "Find where the tangent to the curve $y=-2\\sqrt{x}$ at the point  $(4,-4)$ intersects the $x$-axis.\n\nThe tangent intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=-2\\sqrt{x}.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2\\sqrt{x}) \\\\  & =-2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}) \\\\  & =-2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =-2\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =-\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(4) \\\\  & =-\\frac{1}{\\sqrt{4}} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-4) & =-\\frac{1}{2}(x-4) \\\\ y+4 & =-\\frac{1}{2}x+2 \\\\ y & =-\\frac{1}{2}x+2-4 \\\\ y & =-\\frac{1}{2}x-2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}-\\frac{1}{2}x-2 & =0 \\\\ \\frac{1}{2}x & =-2 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342379/field-1" "q-342379/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c"] :knowledge-point/questions ["q-342379"] :db/ensure [:knowledge-point/validate]} {:db/id "q-304090/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "78cc7ee4-05a1-5daa-9eac-bce5ae3be9e1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-304090/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "36d507d0-340d-5078-bf7c-81166bcf902e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-304090/field-1" :answer-field/id #uuid "a843db39-7c78-587a-8d82-b933b84b4cc4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-304090/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-304090/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-304090/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-304090/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e1ba1433-4af8-59fd-9b6b-481a3eea28d3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-304090/field-2" :answer-field/id #uuid "1ead8a6d-45aa-590a-9cd5-208f392b486c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-304090/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-304090/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-304090" :question/id #uuid "065e9604-fa49-5d1e-97d2-7ea5636842cf" :question/math-academy-id "q-304090" :question/is-example false :question/problem "Find where the tangent to the curve $y=4x-{x}^{2}$ at the point  $(1,3)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=4x-{x}^{2}.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =4-2x.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm={f}^{′}(1)=4-2(1)=2.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =2(x-1) \\\\ y & =2x-2+3 \\\\ y & =2x+1.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =2(0)+1 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-304090/field-1" "q-304090/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c"] :knowledge-point/questions ["q-304090"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342377/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c64f9f04-ecfa-5cf3-8eda-0f68d9ad030b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342377/field-1" :answer-field/id #uuid "fd45ea3b-1471-5dba-be81-73c443879475" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342377/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342377/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342377/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "fd1acad2-f0fe-525c-8652-e0b8f403f375" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-342377/field-2" :answer-field/id #uuid "b583525f-1e84-5cc9-a3cd-89e399a4235e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342377/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-342377/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-342377" :question/id #uuid "0da41f90-fa12-5c48-97e3-9f5af174c4d6" :question/math-academy-id "q-342377" :question/is-example false :question/problem "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $y$-axis.\n\nThe tangent intersects the $y$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =\\frac{1}{2}(0)+2 \\\\ y & =2.\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342377/field-1" "q-342377/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c"] :knowledge-point/questions ["q-342377"] :db/ensure [:knowledge-point/validate]}]
