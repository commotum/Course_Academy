 & 0.5\\end{aligned}].$" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n$$\n{Y}^{T}=[\\begin{aligned}-20 & 9 \\\\ 0 & 6 \\\\ 15 & 0.5\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186059891 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cf627a0-6921-58ee-91c0-2f225d425711" :knowledge-point/title "Finding the Transpose of a Row Vector or Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833663bf-3970-5af6-8e3a-39f84ce0af74" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 5 \\\\ 4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186056067} {:answer/id #uuid "848e9a7a-7c07-5311-acc3-3f32cc5e5be9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186056068} {:answer/id #uuid "88494fb1-c066-508f-b55b-d80ff6428bdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186056069} {:answer/id #uuid "ce89aba2-05bf-5b03-9f7b-8c7a1ac5d7ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4 \\\\ -5 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186056070} {:answer/id #uuid "06e646e6-1255-5a25-8e64-5d9c2c72a532" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -5 & 4 & -4\\end{bmatrix}" :db/id #edb/ref 17592186056071}] :answer-field/correct {:answer/id #uuid "848e9a7a-7c07-5311-acc3-3f32cc5e5be9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186056068} :answer-field/id #uuid "c3dafa3b-f8f7-511e-a394-16441e7131df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056066}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f200fb1-1ac4-518a-a135-3b50068ae3b9" :question/math-academy-id "q-1045" :question/problem "Find ${Z}^{T}$ given that \n$Z=[\\begin{aligned}-4 & 4 & 5 & 1\\end{aligned}].$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{Z}^{T}=[\\begin{aligned}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186283415 :knowledge-point/_questions [{:knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a237d6ae-7385-5f85-9641-a2ba92dbdf28" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186283417} {:answer/id #uuid "b419398e-ca5c-5a32-b1d2-dda65b160da1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 1" :db/id #edb/ref 17592186283418} {:answer/id #uuid "4d0bd704-f652-58d9-8f7f-1b7c57e72276" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186283419} {:answer/id #uuid "bae11b1e-ea4d-5bc1-87eb-4aad3287e15b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 2" :db/id #edb/ref 17592186283420} {:answer/id #uuid "19c18f01-e0e3-5822-b2fb-85458691d155" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186283421}] :answer-field/correct {:answer/id #uuid "bae11b1e-ea4d-5bc1-87eb-4aad3287e15b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 2" :db/id #edb/ref 17592186283420} :answer-field/id #uuid "dfae36a6-74c7-58e1-b014-d185e5d71aa0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283416}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6b79add3-a695-5ebe-b43d-a6b601a71591" :question/math-academy-id "q-126141" :question/problem "Consider  the matrix\n    $X=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$\nWhat are the dimensions of ${X}^{T}?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $m\\times n$ to $n\\times m.$\n\nSo, since $X$ is a $2\\times 1$ matrix, the transpose ${X}^{T}$ is a $1\\times 2$ matrix."}] [{:db/id #edb/ref 17592186283422 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cf627a0-6921-58ee-91c0-2f225d425711" :knowledge-point/title "Finding the Transpose of a Row Vector or Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2799c7f-e0eb-5a92-8792-973c735da9ea" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283424} {:answer/id #uuid "2deed520-0a6d-5b7c-8332-e5d6428ef06b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283425}] :answer-field/correct {:answer/id #uuid "c2799c7f-e0eb-5a92-8792-973c735da9ea" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283424} :answer-field/id #uuid "4576e653-51d0-50e8-8068-5d445179e7a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283423}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9ca63ded-7976-5099-958a-67684248e409" :question/math-academy-id "q-282769" :question/problem "If\n    $T=[\\begin{aligned}-5\\end{aligned}]$,\nthen find the transpose of $T.$\n\n  \n\n| ${T}^{T}=$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n$$\n{T}^{T}=[\\begin{aligned}-5\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186283426 :knowledge-point/_questions [{:knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3d896f-bbc0-5667-91ba-7805cc305b15" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283428}] :answer-field/correct {:answer/id #uuid "2b3d896f-bbc0-5667-91ba-7805cc305b15" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283428} :answer-field/id #uuid "14c45dc4-e092-51fc-85d2-a86fecb8a9ff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283427} {:answer-field/choices [{:answer/id #uuid "495a31b3-c98e-5e85-bedd-91bcfe05df5a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283430}] :answer-field/correct {:answer/id #uuid "495a31b3-c98e-5e85-bedd-91bcfe05df5a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283430} :answer-field/id #uuid "4f18a66b-9f30-5806-b3db-d6f1e32ba347" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283429}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ff2a9b0-f10f-5a91-9b32-61de1c874cf7" :question/math-academy-id "q-282793" :question/problem "Consider the matrix\n\n$$\nF=[\\begin{aligned}6 \\\\ -4 \\\\ 1 \\\\ 9 \\\\ 0 \\\\ 2\\end{aligned}].\n$$\n\nWhat are the dimensions of ${F}^{T}?$\n\n${F}^{T}$ is a \n\n{{field-1}}\n$\\times $\n{{field-2}}\n matrix." :question/worked-solution "When a matrix is transposed, its dimensions switch from $m\\times n$ to $n\\times m.$  \n\nSo, since $F$ is a $6\\times 1$ matrix, the transpose ${F}^{T}$ is a $1\\times 6$ matrix."}]}
