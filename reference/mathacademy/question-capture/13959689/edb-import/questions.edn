#{[{:db/id #edb/ref 17592186092009 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/id #uuid "14832dae-6df8-5511-9a92-bf9164478091" :question/math-academy-id "e-5386" :question/problem "What is the polar equation of the curve shown below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/b0ade58178ac4356466574c51340eb2f.png)" :question/worked-solution "The given curve is a circle of radius $4$ centered at the origin.\n\nTherefore, its polar equation is $r=4$."}] [{:db/id #edb/ref 17592186092010 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/id #uuid "3eb95e18-94ad-563c-bbf8-3843c75958a8" :question/math-academy-id "e-5387" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=2.7$ intersects the negative $x$-axis." :question/worked-solution "The polar curve $r=2.7$ is a circle of radius $2.7$ centered at the origin. It crosses the negative $x$-axis at the point where $r=2.7$ and\n\n$$\n\\theta = \\pi\n$$\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/2300747114f08c9085447b58342f6072.png)\n\nTherefore, the point of intersection in polar coordinates is\n\n$$\n\\left(2.7, \\pi\\right)\n$$"}] [{:db/id #edb/ref 17592186092011 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/id #uuid "285c25a2-acec-57eb-8db8-e708eec876c7" :question/math-academy-id "e-5388" :question/problem "Find the polar equation of the circle centered at the origin that passes through the point $A(2,5)$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/4b332878cbf0e949d1836127184d68cb.png)" :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r = k$.\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}\nk &= \\sqrt{x^{2} + y^{2}} \\\\\n&= \\sqrt{2^{2} + 5^{2}} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$\n\nTherefore, the equation of the circle is\n\n$$\nr=\\sqrt{29}\n$$"}] [{:db/id #edb/ref 17592186092545 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1e00824-76b0-59ee-8b69-0e97a3a639e8" :answer/type {:db/ident :answer.type/math} :answer/value "r = 50" :db/id #edb/ref 17592186089707} {:answer/id #uuid "c77a1706-1358-53d3-a0e8-88be37ed1191" :answer/type {:db/ident :answer.type/math} :answer/value "r = 7" :db/id #edb/ref 17592186089708} {:answer/id #uuid "ce8559b8-e522-5427-a7eb-f9a80dfbaaf4" :answer/type {:db/ident :answer.type/math} :answer/value "r = 52" :db/id #edb/ref 17592186089709} {:answer/id #uuid "eace999b-39fa-5805-96fd-5cf5b43cc102" :answer/type {:db/ident :answer.type/math} :answer/value "r = 5\\sqrt{2}" :db/id #edb/ref 17592186089710} {:answer/id #uuid "48f2296b-2101-5f04-ab6e-520c93f3fc31" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\sqrt{52}" :db/id #edb/ref 17592186089711}] :answer-field/correct {:answer/id #uuid "48f2296b-2101-5f04-ab6e-520c93f3fc31" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\sqrt{52}" :db/id #edb/ref 17592186089711} :answer-field/id #uuid "faa491b1-521e-5b48-9851-0bd2822e6e20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089706}] :question/id #uuid "125edd16-dfa8-5ed1-af01-368de5476e99" :question/math-academy-id "q-17150" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/937/Sourc