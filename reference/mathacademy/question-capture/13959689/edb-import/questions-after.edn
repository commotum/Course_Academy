#{[{:db/id #edb/ref 17592186092009 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/id #uuid "14832dae-6df8-5511-9a92-bf9164478091" :question/math-academy-id "e-5386" :question/problem "What is the polar equation of the curve shown below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/b0ade58178ac4356466574c51340eb2f.png)" :question/worked-solution "The given curve is a circle of radius $4$ centered at the origin.\n\nTherefore, its polar equation is $r=4$."}] [{:db/id #edb/ref 17592186092010 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/id #uuid "3eb95e18-94ad-563c-bbf8-3843c75958a8" :question/math-academy-id "e-5387" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=2.7$ intersects the negative $x$-axis." :question/worked-solution "The polar curve $r=2.7$ is a circle of radius $2.7$ centered at the origin. It crosses the negative $x$-axis at the point where $r=2.7$ and\n\n$$\n\\theta = \\pi\n$$\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/2300747114f08c9085447b58342f6072.png)\n\nTherefore, the point of intersection in polar coordinates is\n\n$$\n\\left(2.7, \\pi\\right)\n$$"}] [{:db/id #edb/ref 17592186092011 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/id #uuid "285c25a2-acec-57eb-8db8-e708eec876c7" :question/math-academy-id "e-5388" :question/problem "Find the polar equation of the circle centered at the origin that passes through the point $A(2,5)$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/4b332878cbf0e949d1836127184d68cb.png)" :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r = k$.\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}\nk &= \\sqrt{x^{2} + y^{2}} \\\\\n&= \\sqrt{2^{2} + 5^{2}} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$\n\nTherefore, the equation of the circle is\n\n$$\nr=\\sqrt{29}\n$$"}] [{:db/id #edb/ref 17592186267791 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62ffaa14-ef5f-5ce2-9f8b-e0c6e1303903" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/db4f4edb33bf4f4f93d62b66f1dc0caa7a9d37d1441f070c277e28e9b64233e9.png" :db/id #edb/ref 17592186267793} {:answer/id #uuid "e549eca6-74ba-5986-b6d9-ed1d12101a93" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/092519f172ba42dcd46b614d14d8949c61dda6542c1c216bd216945c63b1fe9e.png" :db/id #edb/ref 17592186267794} {:answer/id #uuid "10262e90-33f9-5682-9d54-14775894cb0e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/f5e42c53bf851b7c6a19c90414205dd9c1cd7448017c1b7176188e9105fc0875.png" :db/id #edb/ref 17592186267795} {:answer/id #uuid "b561ddb3-3c7f-53ea-9b4d-857c3c06c77a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/51a2c8b68d2ec914b76df80e3c338e364a3dd6172c7d300dba724060b4940587.png" :db/id #edb/ref 17592186267796} {:answer/id #uuid "326b5d8a-0993-5639-991d-faafb2d95353" :answer/type {:db/ident :answer.type/image} :answer/value "/h