 }{6})\\le 1.\n$$\n\nMultiplying the above inequality by $3$ and then adding $2$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 1 \\\\  & -3\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 3 \\\\  & -1\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+2\\le 5 \\\\  & -1\\le f(x)\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,5].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40903/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5696c2d5-4e35-5ed3-a4a2-6fe9b158e461"] :knowledge-point/questions ["q-40903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10379/selection/4d333eb7c60ca1526183cdb8d47b570e79654ce1fe1e2616f07a959ab21e4026" :answer/id #uuid "78aa5a40-09d2-5735-a097-9f636e0fd13d" :answer/type :answer.type/math :answer/value "y\\in [-4,0)" :db/ensure [:answer/validate]} {:db/id "q-10379/selection/c8e7284e015e7c33261f076df69ce08fa74018770d5db9952c4792ff8e4be700" :answer/id #uuid "fcff4627-0b78-5a22-a713-c1dd3504169e" :answer/type :answer.type/math :answer/value "y\\in (-4,0]" :db/ensure [:answer/validate]} {:db/id "q-10379/selection/10a01eb90e14837d1a19147714f141aa105754ab43ff7f98d193107e51db0e1c" :answer/id #uuid "bc4e5b53-a634-5d6d-8c51-2e0831d6f973" :answer/type :answer.type/math :answer/value "y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-10379/selection/ae6e3a250fc8475e37687b3f0e8786a577a6ba893f1eda1e2628eebaeffc1198" :answer/id #uuid "db7d3f02-9ef0-5ffb-9d52-29c193f3485b" :answer/type :answer.type/math :answer/value "y\\in (-4,0)" :db/ensure [:answer/validate]} {:db/id "q-10379/selection/0491c48d2f4415c614196580bf383677daf3d916dc2ef2814fc66b88631273a0" :answer/id #uuid "a0f7c438-abaa-58c9-8bc8-561dd28fc314" :answer/type :answer.type/math :answer/value "y\\in [-4,0]" :db/ensure [:answer/validate]} {:db/id "q-10379/selection" :answer-field/id #uuid "af264a72-7d28-58e0-bdfc-f3f91226bcba" :answer-field/key "selectio