t\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(x-{30}^{∘})\\le 1 \\\\  & 4\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})\\ge -4 \\\\  & 5\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})+1\\ge -3 \\\\  & -3\\le y\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-3,5].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-41964/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5696c2d5-4e35-5ed3-a4a2-6fe9b158e461"] :knowledge-point/questions ["q-41964"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41840/selection/7f60642926646f0f07f4606c0a7c5698af05ccddbc114ddcd1cf2beb64f76ed2" :answer/id #uuid "7b34a9ba-01bb-5baa-9892-a0aa1f80fd4b" :answer/type :answer.type/math :answer/value "y\\in [4,6]" :db/ensure [:answer/validate]} {:db/id "q-41840/selection/69c78eab3d74871676f97c42b1afd4d22acfda2ec107a362ffbdcdd911c9aa18" :answer/id #uuid "fe54b646-c22a-5d08-aa8b-730b7b388416" :answer/type :answer.type/math :answer/value "y\\in [3,6]" :db/ensure [:answer/validate]} {:db/id "q-41840/selection/928830a89c68dc595408988b39f4ce81003cfcc59f9795acab54514b37a533b3" :answer/id #uuid "2a47dc30-f61a-5b22-9ed7-0d9d04d69b71" :answer/type :answer.type/math :answer/value "y\\in [2,4]" :db/ensure [:answer/validate]} {:db/id "q-41840/selection/2efb60324e67cdadfbee9e42ee2ef6c658339827a9f238b8404e91d38e34b2c7" :answer/id #uuid "376948c7-3e1d-554c-bc02-dd4348cb21ba" :answer/type :answer.type/math :answer/value "y\\in [-2,6]" :db/ensure [:answer/validate]} {:db/id "q-41840/selection/4a98cc8e96ae6447ad672c9ad2dae7369ab1d693e0da84443d19f848dd67fd02" :answer/id #uuid "f9083a03-aa14-59d2-b42d-a7598bc1a6df" :answer/type :answer.type/math :answer/value "y\\in [2,6]" :db/ensure [:answer/validate]} {:db/id "q-41840/selection" :answer-field/id #uuid "35778d9a-65e5-5c71-aa1d-63da9e9c8a5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41840/selection/4a98cc8e96ae6447ad672c9ad2dae7369ab1d693e