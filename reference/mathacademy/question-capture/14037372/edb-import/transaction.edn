1089cf7f5371572044b4914f06ff68d325549888258d2ea0bbb6a840278c"] :db/ensure [:answer-field/validate]} {:db/id "q-135993" :question/id #uuid "0c7d1d68-7776-5a99-ac1f-d8104a891538" :question/math-academy-id "q-135993" :question/problem "${(1-\\frac{b}{3})}^{8}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{b}{3}$ and $n=8$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{b}{3})}^{8} & =1+8\\cdot (-\\frac{b}{3})+\\frac{8(8-1)}{2!}\\cdot {(-\\frac{b}{3})}^{2}+⋯ \\\\  & =1-\\frac{8b}{3}+\\frac{8\\cdot 7}{2}\\cdot \\frac{{b}^{2}}{9}+⋯ \\\\  & =1-\\frac{8b}{3}+28\\cdot \\frac{{b}^{2}}{9}+⋯ \\\\  & =1-\\frac{8b}{3}+\\frac{28{b}^{2}}{9}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135993/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-135993"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135997/selection/df0f36d24eaae51940deb21c58fa7c48b8a81a376fea890dd4253efa64ac5852" :answer/id #uuid "0f03d2a8-7776-5ebc-9f36-845845c056a9" :answer/type :answer.type/math :answer/value "1-15c+\\frac{475{c}^{2}}{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135997/selection/a831e3bd63d862081871b8f10e8b82a3647358d1cdbaf99d254fa2f3fd586661" :answer/id #uuid "e672ab98-766e-518b-bd04-c1d3df27f441" :answer/type :answer.type/math :answer/value "1-15c+\\frac{375{c}^{2}}{4}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135997/selection/3a661d193180a312b4c554e1484cb975fa3a569ad30f7c4329e0493e84d30eb8" :answer/id #uuid "5dff4b3d-2fa4-5e63-956f-d25df08b5784" :answer/type :answer.type/math :answer/value "1+15c+\\frac{375{c}^{2}}{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135997/selection/7415d0537854d6e3b441f1311543f34ac3eb7566efd67614857c446e88e9a659" :answer/id #uuid "211bf208-c9c4-5bd0-ba84-145463d3424b" :answer/type :answer.type/math :answer/value "1-15c+\\frac{365{c}^{2}}{4}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135997/selection/7c4c70480267322af505e0056ea940eed1854196001c5f299a993f7b70770f8e" :answer/id #uuid "f354b856-a763-5459-917d-1b7c65879322" :answer/type :answer.type/math :answer/value "1+15c+125{c}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135997/selection" :answer-field/id #uuid "e1e0d471-f19d-54fa-b5d0-e4d517f743e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135997/selection/a831e3bd63d862081871b8f10e8b82a3647358d1cdbaf99d254fa2f3fd586661" :answer-field/choices ["q-135997/selection/df0f36d24eaae51940deb21c58fa7c48b8a81a376fea890dd4253efa64ac5852" "q-135997/selection/a831e3bd63d862081871b8f10e8b82a3647358d1cdbaf99d254fa2f3fd586661" "q-135997/selection/3a661d193180a312b4c554e1484cb975fa3a569ad30f7c4329e0493e84d30eb8" "q-135997/selection/7415d0537854d6e3b441f1311543f34ac3eb7566efd67614857c446e88e9a659" "q-135997/selection/7c4c70480267322af505e0056ea940eed1854196001c5f299a993f7b70770f8e"] :db/ensure [:answer-field/validate]} {:db/id "q-135997" :question/id #uuid "0db46391-e6b4-5a1f-98bf-4e42a41ac41f" :question/math-academy-id "q-135997" :question/problem "${(1-\\frac{5c}{2})}^{6}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{5c}{2}$ and $n=6$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{5c}{2})}^{6} & =1+6\\cdot (-\\frac{5c}{2})+\\frac{6(6-1)}{2!}\\cdot {(-\\frac{5c}{2})}^{2}+⋯ \\\\  & =1-15c+\\frac{6\\cdot 5}{2}\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+15\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+\\frac{375{c}^{2}}{4}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135997/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-135997"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136018/selection/82f825c47f2cb8350a56bd614bade5890466922da8e42aee220f0f32fe9aebbe" :answer/id #uuid "5f40462b-cab3-506b-8ced-26861d85d9f3" :answer/type :answer.type/math :answer/value "\\frac{14}{9}" :db/ensure [:answer/validate]} {:db/id "q-136018/selection/0ae058651fedb4739e55a202bae445bd90493fe87d59bf14ede09e39230a38f3" :answer/id #uuid "de0723b8-de73-5adf-9f76-9a7a5d685cb1" :answer/type :answer.type/math :answer/value "-\\frac{28}{9}" :db/ensure [:answer/validate]} {:db/id "q-136018/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "65f5e2d6-cd29-5f31-98e3-d4ee0e8aeaa9" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-136018/selection/73e4bf0d36bec5192d4f539a0fa835ccef9d190f000b7a58018627854d2c4b0e" :answer/id #uuid "73c2ebc8-779a-5091-9406-a8ee72434bd9" :answer/type :answer.type/math :answer/value "-\\frac{14}{9}" :db/ensure [:answer/validate]} {:db/id "q-136018/selection/37aaee7b588424c953f27a2f0a670b5146b3d4da6164849e2ad640c7dc7f95a3" :answer/id #uuid "765beb4f-575b-542e-b47c-62de78e681b0" :answer/type :answer.type/math :answer/value "\\frac{28}{9}" :db/ensure [:answer/validate]} {:db/id "q-136018/selection" :answer-field/id #uuid "730a087b-4bb9-5755-8f76-d5caf8022a24" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136018/selection/82f825c47f2cb8350a56bd614bade5890466922da8e42aee220f0f32fe9aebbe" :answer-field/choices ["q-136018/selection/82f825c47f2cb8350a56bd614bade5890466922da8e42aee220f0f32fe9aebbe" "q-136018/selection/0ae058651fedb4739e55a202bae445bd90493fe87d59bf14ede09e39230a38f3" "q-136018/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-136018/selection/73e4bf0d36bec5192d4f539a0fa835ccef9d190f000b7a58018627854d2c4b0e" "q-136018/selection/37aaee7b588424c953f27a2f0a670b5146b3d4da6164849e2ad640c7dc7f95a3"] :db/ensure [:answer-field/validate]} {:db/id "q-136018" :question/id #uuid "c07d4a9d-1a61-586f-93cb-62583b04cc4f" :question/math-academy-id "q-136018" :question/problem "The coefficient of ${b}^{4}$ in the expansion of ${(1-\\frac{b}{3})}^{9}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{b}{3}$ and $n$ with $9$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{9(9-1)(9-2)(9-3)}{4!}\\cdot {(-\\frac{b}{3})}^{4} & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{24}\\cdot {(-\\frac{1}{3})}^{4}\\cdot {b}^{4} \\\\  & =126\\cdot \\frac{1}{81}{b}^{4} \\\\  & =\\frac{14}{9}{b}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${b}^{4}$ is $\\frac{14}{9}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136018/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca"] :knowledge-point/questions ["q-136018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251020/field-1/c79dd90cc0d490bfa519fba8eac9fad94d0b7768cef8fb9bc7f3f9373b8b89ba" :answer/id #uuid "eab9fb96-0297-5789-87fa-77bad221e523" :answer/type :answer.type/math :answer/value "1-63k+1701k^2" :db/ensure [:answer/validate]} {:db/id "q-251020/field-1/56b2bc12fbf3c55863ac20d7af7f83fade9b9c7d532260b66effac29f0003735" :answer/id #uuid "dd15e9af-0987-5590-aef1-44d1e5a858c9" :answer/type :answer.type/math :answer/value "1-63k+567k^2" :db/ensure [:answer/validate]} {:db/id "q-251020/field-1" :answer-field/id #uuid "11872608-a986-504a-8a30-35dbdd05a375" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251020/field-1/c79dd90cc0d490bfa519fba8eac9fad94d0b7768cef8fb9bc7f3f9373b8b89ba" :answer-field/choices ["q-251020/field-1/c79dd90cc0d490bfa519fba8eac9fad94d0b7768cef8fb9bc7f3f9373b8b89ba" "q-251020/field-1/56b2bc12fbf3c55863ac20d7af7f83fade9b9c7d532260b66effac29f0003735"] :db/ensure [:answer-field/validate]} {:db/id "q-251020" :question/id #uuid "a929be0c-7e37-5e7c-95f2-700b617cf38a" :question/math-academy-id "q-251020" :question/problem "Find, in ascending powers of $k,$ the **first three terms** in the binomial expansion of ${(1-9k)}^{7}.$\n\n$(1-9k)^{7}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-9k$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-9k)}^{7} & =1+7\\cdot (-9k)+\\frac{7(7-1)}{2!}\\cdot (-9k)^{2}+⋯ \\\\  & =1-63k+\\frac{7\\cdot 6}{2}\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+21\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+1\\,701{k}^{2}+⋯\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-251020/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-251020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251113/field-1/0bec6424400faa1d38e9ba3aa9d418975b431fe4b6865bbfd039d365e9ece416" :answer/id #uuid "c065b3cb-8f8f-587d-b815-e01f339f0c3d" :answer/type :answer.type/math :answer/value "2835" :db/ensure [:answer/validate]} {:db/id "q-251113/field-1" :answer-field/id #uuid "acb5abc3-89e7-5602-b815-1ab38b462b56" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251113/field-1/0bec6424400faa1d38e9ba3aa9d418975b431fe4b6865bbfd039d365e9ece416" :answer-field/choices ["q-251113/field-1/0bec6424400faa1d38e9ba3aa9d418975b431fe4b6865bbfd039d365e9ece416"] :db/ensure [:answer-field/validate]} {:db/id "q-251113" :question/id #uuid "40463d93-5382-540f-9f33-a9603f14c0fb" :question/math-academy-id "q-251113" :question/problem "The coefficient of ${m}^{4}$ in the expansion of ${(1-3m)}^{7}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-3m$ and $n$ with $7$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{7(7-1)(7-2)(7-3)}{4!}\\cdot (-3m)^{4} & =\\frac{7\\cdot 6\\cdot 5\\cdot 4}{24}\\cdot (-3)^{4}\\cdot {m}^{4} \\\\  & =35\\cdot 81{m}^{4} \\\\  & =2835{m}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${m}^{4}$ is $2835.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-251113/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca"] :knowledge-point/questions ["q-251113"] :db/ensure [:knowledge-point/validate]}]
