#{[{:db/id #edb/ref 17592186296941 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320d7c83-a834-5c9e-8f78-79f83da8bf13" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8b}{3}+\\frac{28{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296943} {:answer/id #uuid "71d44cdc-5675-5984-a8ed-318f31c0cde0" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8b}{3}+\\frac{19{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296944} {:answer/id #uuid "27739473-c865-5fd4-adbe-7b4fb1e27824" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{8b}{3}+\\frac{29{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296945} {:answer/id #uuid "1be44a2f-4bf0-522e-a1b2-f123c37e08c0" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8b}{3}+\\frac{26{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296946} {:answer/id #uuid "8694090f-02ac-5551-a9b2-23d2cfac3d03" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{8b}{3}+\\frac{32{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296947}] :answer-field/correct {:answer/id #uuid "320d7c83-a834-5c9e-8f78-79f83da8bf13" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8b}{3}+\\frac{28{b}^{2}}{9}+⋯" :db/id #edb/ref 17592186296943} :answer-field/id #uuid "e9799901-9a41-5c26-9b18-9ebb99b2bb18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296942}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0c7d1d68-7776-5a99-ac1f-d8104a891538" :question/math-academy-id "q-135993" :question/problem "${(1-\\frac{b}{3})}^{8}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{b}{3}$ and $n=8$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{b}{3})}^{8} & =1+8\\cdot (-\\frac{b}{3})+\\frac{8(8-1)}{2!}\\cdot {(-\\frac{b}{3})}^{2}+⋯ \\\\  & =1-\\frac{8b}{3}+\\frac{8\\cdot 7}{2}\\cdot \\frac{{b}^{2}}{9}+⋯ \\\\  & =1-\\frac{8b}{3}+28\\cdot \\frac{{b}^{2}}{9}+⋯ \\\\  & =1-\\frac{8b}{3}+\\frac{28{b}^{2}}{9}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296948 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dff4b3d-2fa4-5e63-956f-d25df08b5784" :answer/type {:db/ident :answer.type/math} :answer/value "1+15c+\\frac{375{c}^{2}}{2}+⋯" :db/id #edb/ref 17592186296950} {:answer/id #uuid "211bf208-c9c4-5bd0-ba84-145463d3424b" :answer/type {:db/ident :answer.type/math} :answer/value "1-15c+\\frac{365{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186296951} {:answer/id #uuid "f354b856-a763-5459-917d-1b7c65879322" :answer/type {:db/ident :answer.type/math} :answer/value "1+15c+125{c}^{2}+⋯" :db/id #edb/ref 17592186296952} {:answer/id #uuid "e672ab98-766e-518b-bd04-c1d3df27f441" :answer/type {:db/ident :answer.type/math} :answer/value "1-15c+\\frac{375{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186296953} {:answer/id #uuid "0f03d2a8-7776-5ebc-9f36-845845c056a9" :answer/type {:db/ident :answer.type/math} :answer/value "1-15c+\\frac{475{c}^{2}}{2}+⋯" :db/id #edb/ref 17592186296954}] :answer-field/correct {:answer/id #uuid "e672ab98-766e-518b-bd04-c1d3df27f441" :answer/type {:db/ident :answer.type/math} :answer/value "1-15c+\\frac{375{c}^{2}}{4}+⋯" :db/id #edb/ref 17592186296953} :answer-field/id #uuid "e1e0d471-f19d-54fa-b5d0-e4d517f743e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296949}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0db46391-e6b4-5a1f-98bf-4e42a41ac41f" :question/math-academy-id "q-135997" :question/problem "${(1-\\frac{5c}{2})}^{6}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{5c}{2}$ and $n=6$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{5c}{2})}^{6} & =1+6\\cdot (-\\frac{5c}{2})+\\frac{6(6-1)}{2!}\\cdot {(-\\frac{5c}{2})}^{2}+⋯ \\\\  & =1-15c+\\frac{6\\cdot 5}{2}\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+15\\cdot \\frac{25{c}^{2}}{4}+⋯ \\\\  & =1-15c+\\frac{375{c}^{2}}{4}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296955 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de0723b8-de73-5adf-9f76-9a7a5d685cb1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{28}{9}" :db/id #edb/ref 17592186296957} {:answer/id #uuid "765beb4f-575b-542e-b47c-62de78e681b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28}{9}" :db/id #edb/ref 17592186296958} {:answer/id #uuid "73c2ebc8-779a-5091-9406-a8ee72434bd9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{14}{9}" :db/id #edb/ref 17592186296959} {:answer/id #uuid "5f40462b-cab3-506b-8ced-26861d85d9f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186296960} {:answer/id #uuid "65f5e2d6-cd29-5f31-98e3-d4ee0e8aeaa9" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186296961}] :answer-field/correct {:answer/id #uuid "5f40462b-cab3-506b-8ced-26861d85d9f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186296960} :answer-field/id #uuid "730a087b-4bb9-5755-8f76-d5caf8022a24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296956}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c07d4a9d-1a61-586f-93cb-62583b04cc4f" :question/math-academy-id "q-136018" :question/problem "The coefficient of ${b}^{4}$ in the expansion of ${(1-\\frac{b}{3})}^{9}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{b}{3}$ and $n$ with $9$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{9(9-1)(9-2)(9-3)}{4!}\\cdot {(-\\frac{b}{3})}^{4} & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{24}\\cdot {(-\\frac{1}{3})}^{4}\\cdot {b}^{4} \\\\  & =126\\cdot \\frac{1}{81}{b}^{4} \\\\  & =\\frac{14}{9}{b}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${b}^{4}$ is $\\frac{14}{9}.$"}] [{:db/id #edb/ref 17592186296962 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd15e9af-0987-5590-aef1-44d1e5a858c9" :answer/type {:db/ident :answer.type/math} :answer/value "1-63k+567k^2" :db/id #edb/ref 17592186296964} {:answer/id #uuid "eab9fb96-0297-5789-87fa-77bad221e523" :answer/type {:db/ident :answer.type/math} :answer/value "1-63k+1701k^2" :db/id #edb/ref 17592186296965}] :answer-field/correct {:answer/id #uuid "eab9fb96-0297-5789-87fa-77bad221e523" :answer/type {:db/ident :answer.type/math} :answer/value "1-63k+1701k^2" :db/id #edb/ref 17592186296965} :answer-field/id #uuid "11872608-a986-504a-8a30-35dbdd05a375" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296963}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a929be0c-7e37-5e7c-95f2-700b617cf38a" :question/math-academy-id "q-251020" :question/problem "Find, in ascending powers of $k,$ the **first three terms** in the binomial expansion of ${(1-9k)}^{7}.$\n\n$(1-9k)^{7}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-9k$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-9k)}^{7} & =1+7\\cdot (-9k)+\\frac{7(7-1)}{2!}\\cdot (-9k)^{2}+⋯ \\\\  & =1-63k+\\frac{7\\cdot 6}{2}\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+21\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+1\\,701{k}^{2}+⋯\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296966 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c065b3cb-8f8f-587d-b815-e01f339f0c3d" :answer/type {:db/ident :answer.type/math} :answer/value "2835" :db/id #edb/ref 17592186296968}] :answer-field/correct {:answer/id #uuid "c065b3cb-8f8f-587d-b815-e01f339f0c3d" :answer/type {:db/ident :answer.type/math} :answer/value "2835" :db/id #edb/ref 17592186296968} :answer-field/id #uuid "acb5abc3-89e7-5602-b815-1ab38b462b56" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296967}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "40463d93-5382-540f-9f33-a9603f14c0fb" :question/math-academy-id "q-251113" :question/problem "The coefficient of ${m}^{4}$ in the expansion of ${(1-3m)}^{7}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-3m$ and $n$ with $7$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{7(7-1)(7-2)(7-3)}{4!}\\cdot (-3m)^{4} & =\\frac{7\\cdot 6\\cdot 5\\cdot 4}{24}\\cdot (-3)^{4}\\cdot {m}^{4} \\\\  & =35\\cdot 81{m}^{4} \\\\  & =2835{m}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${m}^{4}$ is $2835.$"}]}
