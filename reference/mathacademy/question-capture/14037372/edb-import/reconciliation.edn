jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/activity-metadata.json" "file_sha256" "1efaf6c3080d3dc33f36950bb4b8b3ca678b008eb2878226c653253ed685871c"} {"question" "q-135997" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-135997" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1+15c+125{c}^{2}+⋯"] ["math" "1+15c+\\frac{375{c}^{2}}{2}+⋯"] ["math" "1-15c+\\frac{365{c}^{2}}{4}+⋯"] ["math" "1-15c+\\frac{375{c}^{2}}{4}+⋯"] ["math" "1-15c+\\frac{475{c}^{2}}{2}+⋯"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-135997" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1-15c+\\frac{375{c}^{2}}{4}+⋯"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-136018" "field" nil "attribute" "question/problem" "value" "The coefficient of ${b}^{4}$ in the expansion of ${(1-\\frac{b}{3})}^{9}$ is" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-136018" "field" nil "attribute" "question/worked-solution" "value" "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{b}{3}$ and $n$ with $9$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{9(9-1)(9-2)(9-3)}{4!}\\cdot {(-\\frac{b}{3})}^{4} & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{24}\\cdot {(-\\frac{1}{3})}^{4}\\cdot {b}^{4} \\\\  & =126\\cdot \\frac{1}{81}{b}^{4} \\\\  & =\\frac{14}{9}{b}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${b}^{4}$ is $\\frac{14}{9}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-136018" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/activity-metadata.json" "file_sha256" "1efaf6c3080d3dc33f36950bb4b8b3ca678b008eb2878226c653253ed685871c"} {"question" "q-136018" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-136018" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{14}{9}"] ["math" "-\\frac{28}{9}"] ["math" "18"] ["math" "\\frac{14}{9}"] ["math" "\\frac{28}{9}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-136018" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{14}{9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251020" "field" nil "attribute" "question/problem" "value" "Find, in ascending powers of $k,$ the **first three terms** in the binomial expansion of ${(1-9k)}^{7}.$\n\n$(1-9k)^{7}=$\n{{field-1}}$\\,+\\,⋯$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251020" "field" nil "attribute" "question/worked-solution" "value" "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-9k$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-9k)}^{7} & =1+7\\cdot (-9k)+\\frac{7(7-1)}{2!}\\cdot (-9k)^{2}+⋯ \\\\  & =1-63k+\\frac{7\\cdot 6}{2}\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+21\\cdot 81{k}^{2}+⋯ \\\\  & =1-63k+1\\,701{k}^{2}+⋯\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251020" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/activity-metadata.json" "file_sha256" "1efaf6c3080d3dc33f36950bb4b8b3ca678b008eb2878226c653253ed685871c"} {"question" "q-251020" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251020" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1-63k+1701k^2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251113" "field" nil "attribute" "question/problem" "value" "The coefficient of ${m}^{4}$ in the expansion of ${(1-3m)}^{7}$ is{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251113" "field" nil "attribute" "question/worked-solution" "value" "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-3m$ and $n$ with $7$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{7(7-1)(7-2)(7-3)}{4!}\\cdot (-3m)^{4} & =\\frac{7\\cdot 6\\cdot 5\\cdot 4}{24}\\cdot (-3)^{4}\\cdot {m}^{4} \\\\  & =35\\cdot 81{m}^{4} \\\\  & =2835{m}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${m}^{4}$ is $2835.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251113" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/activity-metadata.json" "file_sha256" "1efaf6c3080d3dc33f36950bb4b8b3ca678b008eb2878226c653253ed685871c"} {"question" "q-251113" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"} {"question" "q-251113" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2835"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037372/state.json" "file_sha256" "d7ed5460e635fa5a773edf06dc3b4336b32e29d59140e6a93421a054a80958e2"}] "usage" {} "basis" 1269 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
