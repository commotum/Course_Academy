#{[{:db/id #edb/ref 17592186243797 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f94b193-985e-5fa4-93e9-cbbbb376f300" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186243799} {:answer/id #uuid "7bbc8c57-260f-5e69-a8d9-816990a3462e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{13}{10})" :db/id #edb/ref 17592186243800} {:answer/id #uuid "333e2172-7ae1-5a82-bf98-851d5991c9a6" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186243801} {:answer/id #uuid "1eb2a3c9-b515-566c-abff-cd0e276887f5" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{21}{10})" :db/id #edb/ref 17592186243802} {:answer/id #uuid "04d2139a-e33e-5a31-a9a5-e2a1e1e1733d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{5}{2})" :db/id #edb/ref 17592186243803}] :answer-field/correct {:answer/id #uuid "04d2139a-e33e-5a31-a9a5-e2a1e1e1733d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{5}{2})" :db/id #edb/ref 17592186243803} :answer-field/id #uuid "1ec24b9b-d970-5b5f-9636-4936c9b671f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243798}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d4172d49-9de6-50d7-a291-6f9452de375f" :question/is-example false :question/math-academy-id "q-170349" :question/problem "For the curve $y=2{(\\frac{4}{5})}^{x}+\\frac{1}{2},$ find the point of intersection with the $y$-axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={(\\frac{4}{5})}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $2{(\\frac{4}{5})}^{x},$ the $y$-coordinate becomes\n\n$$\ny=2\\cdot 1=2.\n$$\n\n- Finally, after a vertical shift of $\\frac{1}{2}$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2+\\frac{1}{2}=\\frac{5}{2}.\n$$\n\n**Method 2**\n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2{(\\frac{4}{5})}^{0}+\\frac{1}{2} \\\\  & =2\\cdot 1+\\frac{1}{2} \\\\  & =2+\\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, $y=2{(\\frac{4}{5})}^{x}+\\frac{1}{2}$ intercepts the $y$-axis at $(0,\\frac{5}{2}).$"}] [{:db/id #edb/ref 17592186243804 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f48c5964-3909-5803-8a1a-3abb5952d4dd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186243806} {:answer/id #uuid "19b508c4-f7e8-52b1-9f5f-e63c0d8d188b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243807} {:answer/id #uuid "867ac86c-a462-529c-bf52-6f71f653b509" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186243808} {:answer/id #uuid "c54cc89b-19b0-510c-8170-49c1f88bc79d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186243809} {:answer/id #uuid "4b9411ce-075e-5b5a-a82d-84a3ebf2d617" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186243810}] :answer-field/correct {:answer/id #uuid "19b508c4-f7e8-52b1-9f5f-e63c0d8d188b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243807} :answer-field/id #uuid "8a1521c5-c82a-58a8-93b6-cd59291c7c29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243805}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "75272390-7345-5972-93be-334c68a62bbd" :question/is-example false :question/math-academy-id "q-27474" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931806/assets/4f7a6bc26eab91db2abe7890075db6fe8fd7e632282b680fe1907156830bbbc3.png)\n\nThe graph above shows the curve $y={(\\frac{1}{8})}^{x}+c.$ What is the value of $c?$" :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{8})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{8})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"}] [{:db/id #edb/ref 17592186243811 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c63784df-c428-577f-9150-dc767046a284" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186243813} {:answer/id #uuid "0fa488d9-9727-5077-bc3f-9f2c9ca9a706" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186243814} {:answer/id #uuid "36dc5c3c-1096-5606-8b13-420158651b7d" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186243815} {:answer/id #uuid "5edffdd2-669a-5dc5-a4d9-1e2d373c3a41" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186243816} {:answer/id #uuid "c7f2add0-3ef6-50ff-9a40-fa00b1b9988e" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186243817}] :answer-field/correct {:answer/id #uuid "c7f2add0-3ef6-50ff-9a40-fa00b1b9988e" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186243817} :answer-field/id #uuid "173ce975-53c4-5781-84d2-93ef75b6317e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243812}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/is-example false :question/math-academy-id "q-27482" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931806/assets/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186243818 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fe37f75-e5f0-5c88-b657-109020923936" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{3}{4})" :db/id #edb/ref 17592186243820} {:answer/id #uuid "6ebb5fe3-ab18-57e7-8377-1e1057378c4c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{11}{4})" :db/id #edb/ref 17592186243821} {:answer/id #uuid "cb552c2d-234b-5035-9ee4-d877ce5d5285" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-\\frac{5}{4})" :db/id #edb/ref 17592186243822} {:answer/id #uuid "f55909bb-907b-515c-a42a-3b017c53704e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{5}{4},0)" :db/id #edb/ref 17592186243823} {:answer/id #uuid "3b983e67-65b9-5598-a727-dac38a5e7185" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{11}{4},0)" :db/id #edb/ref 17592186243824}] :answer-field/correct {:answer/id #uuid "6ebb5fe3-ab18-57e7-8377-1e1057378c4c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{11}{4})" :db/id #edb/ref 17592186243821} :answer-field/id #uuid "afa7549d-2c8a-5773-9b7c-8c6510e8f8ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243819}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6e04c829-6db8-5fa5-8934-b51fe8fdf99c" :question/is-example false :question/math-academy-id "q-31363" :question/problem "For the curve $y=\\frac{3}{4}{(\\frac{1}{5})}^{x}+2,$ find the point of intersection with the $y$-axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={(\\frac{1}{5})}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $\\frac{3}{4}{(\\frac{1}{5})}^{x},$ the $y$-coordinate becomes\n\n$$\ny=\\frac{3}{4}\\cdot 1=\\frac{3}{4}.\n$$\n\n- Finally, after a vertical shift of $2$ units up, we get a point with the $y$-coordinate\n\n$$\ny=\\frac{3}{4}+2=\\frac{11}{4}.\n$$\n\n**Method 2**\n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =\\frac{3}{4}{(\\frac{1}{5})}^{0}+2 \\\\  & =\\frac{3}{4}\\cdot 1+2 \\\\  & =\\frac{3}{4}+2 \\\\  & =\\frac{11}{4}\\end{aligned}\n$$\n\nTherefore, $y=\\frac{3}{4}{(\\frac{1}{5})}^{x}+2$ intercepts the $y$-axis at $(0,\\frac{11}{4}).$"}] [{:db/id #edb/ref 17592186069363 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5e689f4-fafe-51d9-8f84-04fe303c9c49" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186067710} {:answer/id #uuid "250de593-7da5-5480-a683-bdcb0e30b47d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186067711} {:answer/id #uuid "4ba8ac4a-b839-5b8e-b904-d788717aa0a5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186067712} {:answer/id #uuid "61be181c-8317-5b72-b0c2-02691b26958b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186067713} {:answer/id #uuid "663ad338-c931-5cd2-a243-09a3b4b3d3b9" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186067714}] :answer-field/correct {:answer/id #uuid "a5e689f4-fafe-51d9-8f84-04fe303c9c49" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186067710} :answer-field/id #uuid "da74a0c9-ab57-5bec-960c-80da3d3d418b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067709}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71d513de-a58e-50a7-b4d2-f05bb9e08ea8" :question/is-example false :question/math-academy-id "q-55433" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/456/Source/Images/q-55433.png)\n\nThe graph above shows $y = k(\\frac{1}{3})^{x} + c$. Find the value of $k - c$." :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3,$ hence $c=-3.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,3),$ so we substitute $x=0$ and $y=3$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-3 & =y \\\\ k{(\\frac{1}{2})}^{0}-3 & =3 \\\\ k-3 & =3 \\\\ k & =6\\end{aligned}\n$$\n\nTherefore, \n\n$$\nk-c=6-(-3)=9.\n$$\n\nThe equation of the curve is $y=6{(\\frac{1}{2})}^{x}-3.$"}]}
