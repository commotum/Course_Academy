535345 true] [17592186344991 1113 #uuid "bc3e6bf9-50aa-5413-821b-b19c043d5f9f" 13194139535345 true] [17592186344991 1145 "The intermediate value theorem can be applied to closed intervals on which the function is continuous.\n\nThe function is discontinuous at the values of $x$ which makes the denominator equal to zero.\n\nSetting the denominator equal to zero, we have ${x}^{2}+5x+6=0,$ which corresponds to $x=-3$ or $x=-2.$ \n\nWe conclude that the intermediate value theorem can be applied to the function $f(x)$ only on closed intervals that do not contain the points $x=-3$ or $x=-2.$ \n\nFrom the given options, only the interval $[-1,3]$ is allowed. The intervals $[-8,-3)$ and $(-2,1]$ are not closed, while $[-5,-3]$ and $[-4,-2]$ contain the point $x=-3.$" 13194139535345 true] [17592186344992 1000 #edb/ref 17592186344993 13194139535345 true] [17592186344992 1000 #edb/ref 17592186344994 13194139535345 true] [17592186344992 1000 #edb/ref 17592186344995 13194139535345 true] [17592186344992 1000 #edb/ref 17592186344996 13194139535345 true] [17592186344992 1000 #edb/ref 17592186344997 13194139535345 true] [17592186344992 1040 #edb/ref 17592186045450 13194139535345 true] [17592186344992 1041 "selection" 13194139535345 true] [17592186344992 1104 #edb/ref 17592186344994 13194139535345 true] [17592186344992 1110 #uuid "f316c664-e162-5146-9216-285295eb0098" 13194139535345 true] [17592186344993 1034 "(-2,1]" 13194139535345 true] [17592186344993 1103 #edb/ref 17592186045453 13194139535345 true] [17592186344993 1111 #uuid "cd0e4cbd-0cf5-5247-bb9f-42420165d644" 13194139535345 true] [17592186344994 1034 "[-1,3]" 13194139535345 true] [17592186344994 1103 #edb/ref 17592186045453 13194139535345 true] [17592186344994 1111 #uuid "502822aa-bdd4-5e02-8621-c427876da4bf" 13194139535345 true] [17592186344995 1034 "[-4,-2]" 13194139535345 true] [17592186344995 1103 #edb/ref 17592186045453 13194139535345 true] [17592186344995 1111 #uuid "5a65cea0-8ee6-5597-b009-0b07d92e7328" 13194139535345