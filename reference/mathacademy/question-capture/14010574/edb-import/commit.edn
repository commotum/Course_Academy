cdot bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 3 \\\\  & =3.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-4}^{4}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2}+{A}_{3} \\\\  & =6+12-2\\pi +3 \\\\  & =21-2\\pi .\\end{aligned}\n$$" 13194139534463 true] [17592186289675 1000 #edb/ref 17592186289676 13194139534463 true] [17592186289675 1000 #edb/ref 17592186289677 13194139534463 true] [17592186289675 1000 #edb/ref 17592186289678 13194139534463 true] [17592186289675 1000 #edb/ref 17592186289679 13194139534463 true] [17592186289675 1000 #edb/ref 17592186289680 13194139534463 true] [17592186289675 1040 #edb/ref 17592186045450 13194139534463 true] [17592186289675 1041 "selection" 13194139534463 true] [17592186289675 1104 #edb/ref 17592186289680 13194139534463 true] [17592186289675 1110 #uuid "d47c3dc4-aea7-58ff-8bd3-9baf57e6312f" 13194139534463 true] [17592186289676 1034 "18-4\\pi " 13194139534463 true] [17592186289676 1103 #edb/ref 17592186045453 13194139534463 true] [17592186289676 1111 #uuid "424d89dc-d6a1-5599-83f5-5608ad40b255" 13194139534463 true] [17592186289677 1034 "19-2\\pi " 13194139534463 true] [17592186289677 1103 #edb/ref 17592186045453 13194139534463 true] [17592186289677 1111 #uuid "0ac2144b-27b0-551c-a438-7c7dcb4c0784" 13194139534463 true] [17592186289678 1034 "14+2\\pi " 13194139534463 true] [17592186289678 1103 #edb/ref 17592186045453 13194139534463 true] [17592186289678 1111 #uuid "ffd9397b-0e81-5ad6-a8e4-78ba1876c415" 13194139534463 true] [17592186289679 1034 "12+2\\pi " 13194139534463 true] [17592186289679 1103 #edb/ref 17592186045453 13194139534463 true] [17592186289679 1111 #uuid "2df1dce3-027e-5e65-8748-5e0d62b6f721" 13194139534463 true] [17592186289680 1034 "21-2\\pi " 13194139534463 true] [17592186289680 1103 #edb/ref 17592186045453 13194139534463 true] [17592186289680 1111 #uuid "936814f3-5e8f-5cd5-affd-6445a2184354" 13194139534463 true]] :edb/tempids {"q-117662" 17592186289612 "q-117662/selection" 17592186289613 "q-117662/selection