        {
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010574/assets/45e506d3b6d3a2ca1a9b16a061f5c081e10b8c578796d7d4a1dfab6e6f793520.png",
          "sha256": "45e506d3b6d3a2ca1a9b16a061f5c081e10b8c578796d7d4a1dfab6e6f793520"
