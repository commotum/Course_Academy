  "html": "<div id=\"questionExplanation-141140\" class=\"questionExplanation\" style=\"display: block;\"><p><style>\ndiv.graphic {\n    margin-top: 0px;\n    margin-bottom: 0px;\n    text-align: center;\n}\n</style></p>\n<table rules=\"all\" cellpadding=\"10\" align=\"center\" width=\"600px\" style=\"border:1px solid black; margin: auto; margin-bottom: 4mm; margin-top: 4mm\">\n    <tbody><tr>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Multiplicity</th>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Sketch</th>\n        <th bgcolor=\"#D6EAF8\" style=\"text-align: center;\">Sketch</th>\n    </tr>\n    <tr>\n        <td width=\"200px\" height=\"120px\" style=\"font-size:10pt;\" align=\"center\">  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"2\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math></mjx-assistive-mml></mjx-container> <br><br> (Simple Root) </td>\n        <td width=\"200px\" style=\"font-size:10pt;\">\n\n<div id=\"graphic-c63521b1376f40c1b1c39a4e9c43b2ac\" class=\"graphic\"><img src=\"/graphics/c63521b1376f40c1b1c39a4e9c43b2ac\"></div>\n\n        </td>\n<td width=\"200px\" height=\"120px\" style=\"font-size:10pt;\" align=\"center\">\n\n<div id=\"graphic-6acac8f6e2745dee6551ceeece78a646\" class=\"graphic\"><img src=\"/graphics/6acac8f6e2745dee6551ceeece78a646\"></div>\n\n        </td>\n    </tr>\n    <tr>\n        <td height=\"120px\" style=\"font-size:10pt;\" align=\"center\">  <mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" tabindex=\"0\" ctxtmenu_counter=\"3\" style=\"font-size: 113.1%; position: relative;\"><mjx-math class=\"MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-