ity." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141144/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb"] :knowledge-point/questions ["q-141144"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141137/selection/ec02809dd1e6821394a8fad410960d296eb89008f4b144c1b308cfeb35053c1b" :answer/id #uuid "80b15ed9-76b4-5233-a1a0-76ef81f7a42f" :answer/type :answer.type/text :answer/value "$x=-5$ is a multiple root of odd multiplicity" :db/ensure [:answer/validate]} {:db/id "q-141137/selection/fed86577c8264f4486bc2d5b2b58289d832260dc464d651d7268de152e1c2fa2" :answer/id #uuid "25593c0f-f34b-5c98-ba04-af9b30576587" :answer/type :answer.type/text :answer/value "$x=-5$ is a simple root of even multiplicity" :db/ensure [:answer/validate]} {:db/id "q-141137/selection/e31df21600b8ecc5e339d453d999fbe6db77627b30a2cd0f711b911fbecf6e6b" :answer/id #uuid "ea9bfa58-8626-5e67-a778-76b11ba789ae" :answer/type :answer.type/text :answer/value "$x=-5$ is a multiple root of even multiplicity" :db/ensure [:answer/validate]} {:db/id "q-141137/selection/ef7243b8521ac38de993cc84ec5aded1e290489f55253e60f8df04e7640b7fbd" :answer/id #uuid "df754432-c054-5f57-9606-40aa7eddecf6" :answer/type :answer.type/text :answer/value "$x=-5$ is not a root of $p(x)$" :db/ensure [:answer/validate]} {:db/id "q-141137/selection/87517ba08d703d2d17076ac19b02302d1cd4fbc476f815ed1ff0f2a94dcd325a" :answer/id #uuid "ca888811-bbd7-50a0-9f2a-ef0739ee164f" :answer/type :answer.type/text :answer/value "$x=-5$ is a simple root" :db/ensure [:answer/validate]} {:db/id "q-141137/selection" :answer-field/id #uuid "aad3729c-f0cc-5bdc-a57d-f6f80541795d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141137/selection/ec02809dd1e6821394a8fad410960d296eb89008f4b144c1b308cfeb35053c1b" :answer-field/choices ["q-141137/selection/ec02809dd1e6821394a8fad410960d296eb89008f4b144c1b308cfeb35053c1