0,2$ is $2,$ which is even, the graph just touches the $x$-axis and reverses direction at these points.\n\nOnly the graphs $\\text{II}$ and $\\text{IV}$ satisfy these conditions.\n\nTo choose between these two graphs, we need to consider the end behavior. Since the leading coefficient is negative, as $x$ approaches $\\infty ,$ $y$ approaches $-\\infty .$\n\nOnly graph $\\text{II}$ displays this end behavior. Therefore, the correct answer is $\\text{II}.$"}] [{:db/id #edb/ref 17592186244407 :knowledge-point/_questions [{:knowledge-point/id #uuid "d03ac24f-82a6-5af8-b1b8-9021e521d47a" :knowledge-point/title "Identifying the Graph of a Factored Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b246a14-6b77-52ac-b261-47eb83344e95" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{II}" :db/id #edb/ref 17592186244409} {:answer/id #uuid "2111708c-7e10-5983-bfca-52fe7738bfb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{I}" :db/id #edb/ref 17592186244410} {:answer/id #uuid "2097a466-e299-5e0f-b803-4dd5c6c150a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{III}" :db/id #edb/ref 17592186244411} {:answer/id #uuid "6ad22ea1-c7b4-5452-8a48-cb04319bd151" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{IV}" :db/id #edb/ref 17592186244412} {:answer/id #uuid "20ded722-6085-55e2-9e59-1350529f7c71" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given graphs are correct" :db/id #edb/ref 17592186244413}] :answer-field/correct {:answer/id #uuid "2111708c-7e10-5983-bfca-52fe7738bfb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{I}" :db/id #edb/ref 17592186244410} :answer-field/id #uuid "0325550c-9ae8-5c73-9dfb-1dfed7cbb94f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244408}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54de7fdd-88f3-5923-97f8-2e47de03660c" :question/is-example false :question/math-academy-id "q-80356" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932088/assets/f92cef7097e146629d85d63316c7c32f62ab3f1062eae012714a737c5c388f7b.png)\n\nWhich of the above could be the graph of $y=(x+3)(x+1{)}^{2}(x-1)?$" :question/worked-solution "Based on the factored equation, we can make the following conclusions about the graph:\n\n- Since the multiplicity of the roots $x=-3,1$ is $1,$ which is odd, the graph must cross the $x$-axis at these points. Moreover, because $x=-3,1$ are simple roots, the graph must *not* be tangent to the $x$-axis at these points.\n\n- Since the multiplicity of the root $x=-1$ is $2,$ which is even, the graph just touches the $x$-axis and reverses direction at this point.\n\nOnly the graphs $\\text{I}$ and $\\text{IV}$ satisfy these conditions.\n\nTo choose between these two graphs, we need to consider the end behavior. Since the leading coefficient is positive, as $x$ approaches $\\infty ,$ $y$ approaches $\\infty .$\n\nOnly graph $\\text{I}$ displays this end behavior. Therefore, the correct answer is $\\text{I}.$"}] [{:db/id #edb/ref 17592186244414 :knowledge-point/_questions [{:knowledge-point/id #uuid "d03ac24f-82a6-5af8-b1b8-9021e521d47a" :knowledge-point/title "Identifying the Graph of a Factored Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0769b9f-b0d4-5c18-b6f1-fb4807f92295" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{II}" :db/id #edb/ref 17592186244416} {:answer/id #uuid "c973b264-67e3-5f92-a8d9-b32c6d5d9943" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{I}" :db/id #edb/ref 17592186244417} {:answer/id #uuid "7619a420-ec56-5b9d-bb64-e9bdc91e608c" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{III}" :db/id #edb/ref 17592186244418} {:answer/id #uuid "ac6d3948-93e3-5bb2-aabc-1ed2d3780717" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{IV}" :db/id #edb/ref 17592186244419} {:answer/id #uuid "b4a4aa1c-095d-546e-8253-081d81e3a0fb" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given graphs are correct" :db/id #edb/ref 17592186244420}] :answer-field/correct {:answer/id #uuid "7619a420-ec56-5b9d-bb64-e9bdc91e608c" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{III}" :db/id #edb/ref 17592186244418} :answer-field/id #uuid "f2dde687-cf62-573c-84ef-4e64d0fdf7c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244415}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0750685e-93c4-5275-b381-7912d968366c" :question/is-example false :question/math-academy-id "q-80361" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932088/assets/0bf56fdb429d050465875f1c885aa83a36fb4fd7bfe4709fcda11db1a3574a2d.png)\n\nWhich of the above could be the graph of $y=-{x}^{4}(x+1)(x-2{)}^{3}?$" :question/worked-solution "Based on the factored equation, we can make the following conclusions about the graph:\n\n- Since the multiplicity of the roots $x=0$ is $4,$ which is even, the graph just touches the $x$-axis and reverses direction at this point.\n\n- Since the multiplicity of the root $x=-1$ is $1,$ which is odd, the graph must cross the $x$-axis at this point. Moreover, because $x=-1$ is a simple root, the graph must *not* be tangent to the $x$-axis at this point.\n\n- Since the multiplicity of the root $x=2$ is $3,$ which is odd, the graph must cross the $x$-axis at this point. Moreover, because $x=2$ is a triple-root, the graph must be tangent to the $x$-axis at this point.\n\nOnly the graphs $\\text{III}$ and $\\text{IV}$ satisfy these conditions.\n\nTo choose between these two graphs, we need to consider the end behavior. Since the leading coefficient is negative, as $x$ approaches $\\infty ,$ $y$ approaches $-\\infty .$\n\nOnly graph $\\text{III}$ displays this end behavior. Therefore, the correct answer is $\\text{III}.$"}]}
