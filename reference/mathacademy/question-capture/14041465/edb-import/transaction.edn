n/f9507c77d3b89740666add201203a04a2b382249dc5fee4349a326286f06f3a9" "q-15460/selection/d4e6d995e03548a2d215bafba27f272952f2eecfb6d898241a2a81b8b1112741"] :db/ensure [:answer-field/validate]} {:db/id "q-15460" :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15460"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15468/selection/91136fadd0b6263ee76e8951a291ac53142fd45f13c1c51e3e27a1f64e449e45" :answer/id #uuid "82762366-67ff-558b-bad4-45bc9623bf41" :answer/type :answer.type/text :answer/value "center: $(12,3)$, radius: $4$" :db/ensure [:answer/validate]} {:db/id "q-15468/selection/e2a86175e2b9d57511876e0503c3c0b96c121935d286312ba7693216a0f2eac9" :answer/id #uuid "f114d097-d08b-5673-b2d0-be256bbd6923" :answer/type :answer.type/text :answer/value "center: $(-3,12)$, radius: $4$" :db/ensure [:answer/validate]} {:db/id "q-15468/selection/89bca53f4f7d2c4c84b313e4701af1222a17185bbf464539dd6352319736d668" :answer/id #uuid "e40ab223-92ce-5115-b482-0dfdc4dc1bff" :answer/type 