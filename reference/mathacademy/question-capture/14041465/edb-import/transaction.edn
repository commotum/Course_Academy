ure [:answer-field/validate]} {:db/id "q-5194" :question/id #uuid "bc743f42-dcd1-5c9e-9195-336e4a7fa0ab" :question/math-academy-id "q-5194" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+2y+{y}^{2}+1=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+2y+{y}^{2}+1 & =0 \\\\ ({x}^{2}+2x)+({y}^{2}+2y) & =-1 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =-1+{1}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+1)^{2} & ={1}^{2} \\\\ (x-(-1))^{2}+(y-(-1))^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-1)$ and its radius is $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-5194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-5194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14619/selection/8e4d6e1fdb76c00dc4ee2e08f8450be8d2de379e6162d57af6b42295c23c6faf" :answer/id #uuid "fd30edf8-3b02-5301-898e-597f2320cfde" :answer/type :answer.type/text :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14619/selection/54beee3030306d84a0ced8aa47140b1bd1638c8232475094333c6fc09378baeb" :answer/id #uuid "1abd7183-fd69-5f0b-8aa1-bd53cafbe401" :answer/type :answer.type/text :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14619/selection/46061bd04bf456df37808afdf7886153bbe607701266ae847b70835caf1e39dc" :answer/id #uuid "bcf5d284-0bd3-52ad-a7fd-eb2220fc203f" :answer/type :answer.type/text :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/selection/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" :answer/id #uuid "d1ab1473-cf48-5997-8f3f-19fea4f8a4d6" :answer/type :answer.type/text :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/selection/1ba85811e5b4e050216c0b99b2ae2731e957a6a9a066fbef01dc7b1402227539" :answer/id #uuid "2759dc37-5211-5b6c-a393-6d14019e8a75" :answer/type :answer.type/text :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/selection" :answer-field/id #uuid "76458f5e-e71d-5150-a944-f4a21e12700a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14619/selection/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" :answer-field/choices ["q-14619/selection/8e4d6e1fdb76c00dc4ee2e08f8450be8d2de379e6162d57af6b42295c23c6faf" "q-14619/selection/54beee3030306d84a0ced8aa47140b1bd1638c8232475094333c6fc09378baeb" "q-14619/selection/46061bd04bf456df37808afdf7886153bbe607701266ae847b70835caf1e39dc" "q-14619/selection/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" "q-14619/selection/1ba85811e5b4e050216c0b99b2ae2731e957a6a9a066fbef01dc7b1402227539"] :db/ensure [:answer-field/validate]} {:db/id "q-14619" :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-14619/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-14619"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14620/selection/d5e61b4c36a3c12cd6589681316639199cd82bd39296268ac9903a7b96e2b5a7" :answer/id #uuid "cc845eac-6e4a-5022-ae24-2ba3cad6d195" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},\\frac{1}{2}),$ radius: $\\frac{33}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14620/selection/bf32e013176adc3f694c10221910b9f83b31d54111b584d57455fbf5b4f190f6" :answer/id #uuid "b473dbef-f099-51c9-a564-caf29d8de5ff" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14620/selection/64ba4ef942c23493800d4dde62b2e20d9ea6bb8d667b7d45bd50d068143a13b3" :answer/id #uuid "6ec723b9-8fdd-5b90-ab8c-cc1c07e3fd25" :answer/type :answer.type/text :answer/value "center: $(-\\frac{5}{2},-\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14620/selection/80edfac29566f067342109216c69b606d541eed6801dd611301d701be5a2ef5b" :answer/id #uuid "a613efdf-e165-500e-9338-a519b855eb8d" :answer/type :answer.type/text :answer/value "center: $(-\\frac{3}{2},\\frac{5}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14620/selection/9eff91ea74a1d09c8d0b2eff3677b5a1b79f6b84f5f5dd7f0acb742c76cc198c" :answer/id #uuid "19d95e67-8ec4-5d91-bf7c-f857fa8abf23" :answer/type :answer.type/text :answer/value "center: $(\\frac{5}{2},\\frac{3}{2}),$ radius: $\\frac{33}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14620/selection" :answer-field/id #uuid "c9590550-298d-5252-851f-963e24812c3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14620/selection/bf32e013176adc3f694c10221910b9f83b31d54111b584d57455fbf5b4f190f6" :answer-field/choices ["q-14620/selection/d5e61b4c36a3c12cd6589681316639199cd82bd39296268ac9903a7b96e2b5a7" "q-14620/selection/bf32e013176adc3f694c10221910b9f83b31d54111b584d57455fbf5b4f190f6" "q-14620/selection/64ba4ef942c23493800d4dde62b2e20d9ea6bb8d667b7d45bd50d068143a13b3" "q-14620/selection/80edfac29566f067342109216c69b606d541eed6801dd611301d701be5a2ef5b" "q-14620/selection/9eff91ea74a1d09c8d0b2eff3677b5a1b79f6b84f5f5dd7f0acb742c76cc198c"] :db/ensure [:answer-field/validate]} {:db/id "q-14620" :question/id #uuid "81f03299-4594-54ac-9964-5f51e6735938" :question/math-academy-id "q-14620" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+5x-3y-8=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+5x-3y-8 & =0 \\\\ ({x}^{2}+5x)+({y}^{2}-3y) & =8 \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =8+{(\\frac{5}{2})}^{2}+{(\\frac{3}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =\\frac{33}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & =\\frac{33}{2} \\\\ {(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\sqrt{\\frac{33}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},\\frac{3}{2})$ and its radius is $\\sqrt{\\frac{33}{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-14620/selection"] :db/ensure [:question/validate]} {:db/