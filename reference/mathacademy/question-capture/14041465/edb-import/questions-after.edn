#{[{:db/id #edb/ref 17592186311747 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2759dc37-5211-5b6c-a393-6d14019e8a75" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186311749} {:answer/id #uuid "bcf5d284-0bd3-52ad-a7fd-eb2220fc203f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186311750} {:answer/id #uuid "1abd7183-fd69-5f0b-8aa1-bd53cafbe401" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186311751} {:answer/id #uuid "fd30edf8-3b02-5301-898e-597f2320cfde" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186311752} {:answer/id #uuid "d1ab1473-cf48-5997-8f3f-19fea4f8a4d6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186311753}] :answer-field/correct {:answer/id #uuid "d1ab1473-cf48-5997-8f3f-19fea4f8a4d6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186311753} :answer-field/id #uuid "76458f5e-e71d-5150-a944-f4a21e12700a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311748}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$"}] [{:db/id #edb/ref 17592186311754 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ec723b9-8fdd-5b90-ab8c-cc1c07e3fd25" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},-\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186311756} {:answer/id #uuid "a613efdf-e165-500e-9338-a519b855eb8d" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{5}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186311757} {:answer/id #uuid "19d95e67-8ec4-5d91-bf7c-f857fa8abf23" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{5}{2},\\frac{3}{2}),$ radius: $\\frac{33}{2}$" :db/id #edb/ref 17592186311758} {:answer/id #uuid "b473dbef-f099-51c9-a564-caf29d8de5ff" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186311759} {:answer/id #uuid "cc845eac-6e4a-5022-ae24-2ba3cad6d195" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{1}{2}),$ radius: $\\frac{33}{2}$" :db/id #edb/ref 17592186311760}] :answer-field/correct {:answer/id #uuid "b473dbef-f099-51c9-a564-caf29d8de5ff" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{5}{2},\\frac{3}{2}),$ radius: $\\sqrt{\\frac{33}{2}}$" :db/id #edb/ref 17592186311759} :answer-field/id #uuid "c9590550-298d-5252-851f-963e24812c3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311755}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "81f03299-4594-54ac-9964-5f51e6735938" :question/math-academy-id "q-14620" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+5x-3y-8=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+5x-3y-8 & =0 \\\\ ({x}^{2}+5x)+({y}^{2}-3y) & =8 \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =8+{(\\frac{5}{2})}^{2}+{(\\frac{3}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{5}{2}x+{(\\frac{5}{2})}^{2})+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & =\\frac{33}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & =\\frac{33}{2} \\\\ {(x+\\frac{5}{2})}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\sqrt{\\frac{33}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{5}{2},\\frac{3}{2})$ and its radius is $\\sqrt{\\frac{33}{2}}.$"}] [{:db/id #edb/ref 17592186311761 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b226257-1417-5613-ae43-fa6996f0a1f5" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,5)$, radius: $3$" :db/id #edb/ref 17592186311763} {:answer/id #uuid "f7b6bafc-1f68-5364-bbe0-fe0f18d557a7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186311764} {:answer/id #uuid "796f7794-be73-5393-8747-e2411be62ced" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-1)$, radius: $7$" :db/id #edb/ref 17592186311765} {:answer/id #uuid "51b98f8e-0e81-58db-9ef8-648df80bd61f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,1)$, radius: $4$" :db/id #edb/ref 17592186311766} {:answer/id #uuid "66612ec5-7b60-59b9-b673-99b8da0089aa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-5)$, radius: $9$" :db/id #edb/ref 17592186311767}] :answer-field/correct {:answer/id #uuid "f7b6bafc-1f68-5364-bbe0-fe0f18d557a7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186311764} :answer-field/id #uuid "e708c6fb-451c-54ba-a217-7a1cf76b5f4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311762}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$"}] [{:db/id #edb/ref 17592186311768 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbb48062-8a89-50a1-9f8c-defb17df5363" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,12)$, radius: $4$" :db/id #edb/ref 17592186311770} {:answer/id #uuid "e40ab223-92ce-5115-b482-0dfdc4dc1bff" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-12,-3)$, radius: $4$" :db/id #edb/ref 17592186311771} {:answer/id #uuid "82762366-67ff-558b-bad4-45bc9623bf41" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,3)$, radius: $4$" :db/id #edb/ref 17592186311772} {:answer/id #uuid "690c9ba9-f436-59f4-bc39-a40d08fc87be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186311773} {:answer/id #uuid "f114d097-d08b-5673-b2d0-be256bbd6923" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-3,12)$, radius: $4$" :db/id #edb/ref 17592186311774}] :answer-field/correct {:answer/id #uuid "690c9ba9-f436-59f4-bc39-a40d08fc87be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(12,-3)$, radius: $4$" :db/id #edb/ref 17592186311773} :answer-field/id #uuid "3d092bcd-d6ec-5035-8b33-1dfe5c7252eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311769}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "be8f09c0-1674-5f60-b4a5-c147dd1743d5" :question/math-academy-id "q-15468" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-24x+{y}^{2}+6y=-137.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}-24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}-2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-12)^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(12,-3)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186311775 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3f8ec2c-a18b-5b1d-80ba-3c5657c87c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $4$" :db/id #edb/ref 17592186311777} {:answer/id #uuid "679ad223-5e03-519f-a9c0-1bcca08fe1e3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $1$" :db/id #edb/ref 17592186311778} {:answer/id #uuid "c825e921-cd45-5db4-8d29-05ae3ce8294b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,1)$, radius: $1$" :db/id #edb/ref 17592186311779} {:answer/id #uuid "c8167d23-a732-5e7d-978b-0f6d5c7787bf" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,0)$, radius: $2$" :db/id #edb/ref 17592186311780} {:answer/id #uuid "eace1d8b-4316-5ffd-a036-c2a34f7a39a3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,1)$, radius: $1$" :db/id #edb/ref 17592186311781}] :answer-field/correct {:answer/id #uuid "679ad223-5e03-519f-a9c0-1bcca08fe1e3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-1)$, radius: $1$" :db/id #edb/ref 17592186311778} :answer-field/id #uuid "3df7c95c-1a90-5bcc-bd63-687e365b2ca2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311776}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bc743f42-dcd1-5c9e-9195-336e4a7fa0ab" :question/math-academy-id "q-5194" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+2y+{y}^{2}+1=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+2y+{y}^{2}+1 & =0 \\\\ ({x}^{2}+2x)+({y}^{2}+2y) & =-1 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =-1+{1}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot y+{1}^{2}) & =1\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+1)^{2} & ={1}^{2} \\\\ (x-(-1))^{2}+(y-(-1))^{2} & ={1}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-1)$ and its radius is $1.$"}]}
