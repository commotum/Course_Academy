[{:db/id "q-78961/selection/89934188dd9d854dacdf2fc4ddd6398ce910813bf164913d5afbb3c5e985f1c2" :answer/id #uuid "35747aba-4b03-59de-8639-d0692d88904b" :answer/type :answer.type/math :answer/value "\\frac{4{x}^{4}}{\\operatorname{ln}⁡3}(1-4\\operatorname{ln}⁡x)+C" :db/ensure [:answer/validate]} {:db/id "q-78961/selection/909107f74ab19a57035d0773677b0006eaf767927de294e80749115054cf48e1" :answer/id #uuid "a5fce483-ddb6-550c-a47a-5b0153253090" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78961/selection/d7cc1db03dfc0bb613e8888de328bc111366d46cecd82f772c69c2cbed673151" :answer/id #uuid "e0bfee78-a755-56f1-99d6-f628299c5ae2" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78961/selection/7199f95d3283d807f9f328bb9bbbf98caf3eb999fa193611f0251bd1ee0d92fd" :answer/id #uuid "bee828e4-b972-5e91-b00f-662c59402e67" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78961/selection/da1f2a17a4f07e2258d975eac2efa353ab2837e2941cbe587e73efb241c62793" :answer/id #uuid "c01bd8c2-c331-54a0-8b18-db31f2dcdf99" :answer/type :answer.type/math :answer/value "\\frac{4{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78961/selection" :answer-field/id #uuid "f75209d2-e563-555c-8c80-fa9cb6f9fdb9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78961/selection/909107f74ab19a57035d0773677b0006eaf767927de294e80749115054cf48e1" :answer-field/choices ["q-78961/selection/89934188dd9d854dacdf2fc4ddd6398ce910813bf164913d5afbb3c5e985f1c2" "q-78961/selection/909107f74ab19a57035d0773677b0006eaf767927de294e80749115054cf48e1" "q-78961/selection/d7cc1db03dfc0bb613e8888de328bc111366d46cecd82f772c69c2cbed673151" "q-78961/selection/7199f95d3283d807f9f328bb9bbbf98caf3eb999fa193611f0251bd1ee0d92fd" "q-78961/selection/da1f2a17a4f07e2258d975eac2efa353ab2837e2941cbe587e73efb241c62793"] :db/ensure [:answer-field/validate]} {:db/id "q-78961" :question/id #uuid "ee7df271-efad-5656-8b8b-3993fc52b08a" :question/math-academy-id "q-78961" :question/problem "Calculate $\\int 16{x}^{3}{log}_{3}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=16{x}^{3}\\, & ⟹\\,v=\\int 16{x}^{3}\\,\\text{d}x=4{x}^{4}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 16{x}^{3}{log}_{3}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡(x)(4{x}^{4})-\\int \\frac{4{x}^{4}}{x\\operatorname{ln}⁡3}\\,\\text{d}x \\\\  & =4{x}^{4}{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\int 4{x}^{3}\\,\\text{d}x \\\\  & =4{x}^{4}{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\cdot {x}^{4}+C \\\\  & =\\frac{4{x}^{4}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}-\\frac{{x}^{4}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78961/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-78961"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78962/selection/f3692a755e41aca1789cb721180a44f764017a294b64261a4e743655b469fbb0" :answer/id #uuid "61a7f51c-b809-5293-9060-2e7e447669a0" :answer/type :answer.typ