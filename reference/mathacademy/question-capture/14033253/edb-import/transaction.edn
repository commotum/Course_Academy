50be"] :db/ensure [:answer-field/validate]} {:db/id "q-78962" :question/id #uuid "0002bb48-63e3-5869-82b8-396b34ff4061" :question/math-academy-id "q-78962" :question/problem "Calculate $\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}-\\frac{{x}^{5}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78962/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-78962"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78973/selection/6fee0a49647ccf815976f4fa112c557742ad3de8505707ffe2ea65feb70fb307" :answer/id #uuid "c33681d6-952b-5538-8d83-59c7b03cbb1f" :answer/type :answer.type/math :answer/value "4x(\\operatorname{ln}⁡(4x)+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78973/selection/8a25c7e595311864c0771b26acd9c951abd74e0204865aeb1a6d59c2818f0802" :answer/id #uuid "93bad77f-fc4c-5151-b61a-1e3552e61d95" :answer/type :answer.type/math :answer/value "2x(\\operatorname{ln}⁡(4x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78973/selection/a493d267a22152a6bcec8c684f30fddaac919e3bdfcd708171607368790d973f" :answer/id #uuid "24b67811-2588-5ef9-b110-04869e9d624f" :answer/type :answer.type/math :answer/value "4x(\\operatorname{ln}⁡(2x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78973/selection/26a253de18f173a5e08eb51d5747f0064a3b797a169de148b5d986685eab1b2b" :answer/id #uuid "d8803e90-c191-52d6-8000-b1786a6f2b98" :answer/type :answer.type/math :answer/value "2x(\\operatorname{ln}⁡(2x)+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78973/selection/b789b1081c2b8081a3ed0d487592d02cd018b6d92322fb2072b0a3aa876eccb2" :answer/id #uuid "0b28fab3-cd5e-5936-b51e-8b0a7c76cac7" :answer/type :answer.type/math :answer/value "x(\\operatorname{ln}⁡(4x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78973/selection" :answer-field/id #uuid "69fc184d-93d8-5619-91bc-9ecb7ce71f48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78973/selection/8a25c7e595311864c0771b26acd9c951abd74e0204865aeb1a6d59c2818f0802" :answer-field/choices ["q-78973/selection/6fee0a49647ccf815976f4fa112c557742ad3de8505707ffe2ea65feb70fb307" "q-78973/selection/8a25c7e595311864c0771b26acd9c951abd74e0204865aeb1a6d59c2818f0802" "q-78973/selection/a493d267a22152a6bcec8c684f30fddaac919e3bdfcd708171607368790d973f" "q-78973/selection/26a253de18f173a5e08eb51d5747f0064a3b797a169de148b5d986685eab1b2b" "q-78973/selection/b789b1081c2b8081a3ed0d487592d02cd018b6d92322fb2072b0a3aa876eccb2"] :db/ensure [:answer-field/validate]} {:db/id "q-78973" :question/id #uuid "8f8b4061-8471-5977-a76a-c60012c56f62" :question/math-academy-id "q-78973" :question/problem "$\\int 2\\operatorname{ln}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int 2\\operatorname{ln}⁡4x\\,\\text{d}x=2\\int \\operatorname{ln}⁡4x\\cdot 1\\,\\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}2\\int \\operatorname{ln}⁡(4x)\\,\\text{d}x & =2\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =2[uv-\\int v{u}^{′}\\,\\text{d}x] \\\\  & =2[\\operatorname{ln}⁡(4x)\\cdot x-\\int x\\cdot \\frac{1}{x}\\,\\text{d}x] \\\\  & =2[x\\operatorname{ln}⁡(4x)-\\int \\,\\text{d}x] \\\\  & =2x\\operatorname{ln}⁡(4x)-2x+C \\\\  & =2x(\\operatorname{ln}⁡(4x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78973/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-78973"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114592/selection/07d2617a97f47ffcef97b80c38d83ee229231cd42f7f301cb701468aab821949" :answer/id #uuid "6a9e84e4-0159-5c35-ab56-b2fb3eef105d" :answer/type :answer.type/math :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)-x+C" :db/ensure [:answer/validate]} {:db/id "q-114592/selection/642d920ace4b44eb9f179a3798c237c8b33bfe773d72b639358de4bb354bb7ea" :answer/id #uuid "e160f72d-d70e-563e-b0e2-4f69c703004d" :answer/type :answer.type/math :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-x+C" :db/ensure [:answer/validate]} {:db/id "q-114592/selection/c1b89019c314fbed4d64ab537b4eb3976dc29ec797f0b8e672f81bd0ee89f2e5" :answer/id #uuid "85934a88-847c-5579-b52f-c98987135b92" :answer/type :answer.type/math :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)+C" :db/ensure [:answer/validate]} {:db/id "q-114592/selection/5ae65feca244138270e638a77d98972bf6df6f1a53d4dda791fcfdb64ec63354" :answer/id #uuid "f6a9a4b2-94cf-5cea-8601-fae741bfc553" :answer/type :answer.type/math :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-6x+C" :db/ensure [:answer/validate]} {:db/id "q-114592/selection/dc5c9a935cad9e3cd9c104e16ce4cf8122b89692ff3add0eba1f64e26fb99ebf" :answer/id #uuid "e48d527f-2067-50f2-be69-8c868207bf16" :answer/type :answer.type/math :answer/value "(x-3)\\operatorname{ln}⁡(x-3)+3x+C" :db/ensure [:answer/validate]} {:db/id "q-114592/selection" :answer-field/id #uuid "0f253d85-c210-5565-afd9-b86eecd88011" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114592/selection/642d920ace4b44eb9f179a3798c237c8b33bfe773d72b639358de4bb354bb7ea" :answer-field/choices ["q-114592/selection/07d2617a97f47ffcef97b80c38d83ee229231cd42f7f301cb701468aab821949" "q-114592/selection/642d920ace4b44eb9f179a3798c237c8b33bfe773d72b639358de4bb354bb7ea" "q-114592/selection/c1b89019c314fbed4d64ab537b4eb3976dc29ec797f0b8e672f81bd0ee89f2e5" "q-114592/selection/5ae65feca244138270e638a77d98972bf6df6f1a53d4dda791fcfdb64ec63354" "q-114592/selection/dc5c9a935cad9e3cd9c104e16ce4cf8122b89692ff3add0eba1f64e26fb99ebf"] :db/ensure [:answer-field/validate]} {:db/id "q-114592" :question/id #uuid "6b86c6e4-2e5b-5fd5-acdb-a0e53fdeb34a" :question/math-academy-id "q-114592" :question/problem "$\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=\\int \\operatorname{ln}⁡(x-3)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x-3)\\, & ⟹\\,{u}^{′}=\\frac{1}{x-3} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x-3)\\cdot x-\\int x\\cdot \\frac{1}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x.\\end{aligned}\n$$\n\nNow, we use a substitution $x-3=u,$ thus $x=u+3$ and $\\text{d}x=\\text{d}u.$ Hence,\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{u+3}{u}\\,\\text{d}u \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\,\\text{d}u-3\\int \\frac{\\text{d}u}{u} \\\\  & =x\\operatorname{ln}⁡(x-3)-u-3\\operatorname{ln}⁡u+D \\\\  & =x\\operatorname{ln}⁡(x-3)-(x-3)-3\\operatorname{ln}⁡(x-3)+D \\\\  & =x\\operatorname{ln}⁡(x-3)-3\\operatorname{ln}⁡(x-3)-x+3+D \\\\  & =(x-3)\\operatorname{ln}⁡(x-3)-x+C,\\end{aligned}\n$$\n\nwhere $C=D+3$ is an integral constant." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114592/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-114592"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351016/field-1/ca970e1281ee36f2a14de47c378129e1e224ba37844d978a6efe4e98613f271f" :answer/id #uuid "9662af08-d7c1-5e9d-9406-c9a29a091296" :answer/type :answer.type/math :answer/value "\\frac{2e^3+1}{8\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-351016/field-1" :answer-field/id #uuid "5bbe9ae0-c8e2-5837-bd7c-0b50582d2798" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351016/field-1/ca970e1281ee36f2a14de47c378129e1e224ba37844d978a6efe4e98613f271f" :answer-field/choices ["q-351016/field-1/ca970e1281ee36f2a14de47c378129e1e224ba37844d978a6efe4e98613f271f"] :db/ensure [:answer-field/validate]} {:db/id "q-351016" :question/id #uuid "60e017ef-1df5-5087-bcd7-4d4b713d9cc6" :question/math-academy-id "q-351016" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x={\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(8x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡(3)} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x & ={\\int }_{1/8}^{{e}^{3}/8}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1/8}^{{e}^{3}/8}-{\\int }_{1/8}^{{e}^{3}/8}v{u}^{′}\\text{d}x \\\\  & ={log}_{3}⁡(8x)\\,(x){|}_{1/8}^{{e}^{3}/8}-{\\int }_{1/8}^{{e}^{3}/8}x(\\frac{1}{x\\operatorname{ln}⁡(3)})\\,\\text{d}x \\\\  & =[{log}_{3}⁡(8\\cdot \\frac{{e}^{3}}{8})\\,(\\frac{{e}^{3}}{8})-{log}_{3}⁡(8\\cdot \\frac{1}{8})\\,(\\frac{1}{8})]-\\frac{1}{\\operatorname{ln}⁡(3)}{\\int }_{1/8}^{{e}^{3}/8}\\text{d}x \\\\  & =\\frac{{e}^{3}}{8}{log}_{3}⁡({e}^{3})-\\frac{1}{8}{log}_{3}⁡(1)-\\frac{1}{\\operatorname{ln}⁡(3)}x{|}_{1/8}^{{e}^{3}/8} \\\\  & =\\frac{{e}^{3}}{8}\\cdot \\frac{3}{\\operatorname{ln}⁡(3)}-\\frac{1}{\\operatorname{ln}⁡(3)}(\\frac{{e}^{3}}{8}-\\frac{1}{8}) \\\\  & =\\frac{1}{8\\operatorname{ln}⁡(3)}(2{e}^{3}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351016/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-351016"] :db/ensure [:knowledge-point/validate]}]
