#{[{:db/id #edb/ref 17592186293925 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a9e84e4-0159-5c35-ab56-b2fb3eef105d" :answer/type {:db/ident :answer.type/math} :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186293927} {:answer/id #uuid "f6a9a4b2-94cf-5cea-8601-fae741bfc553" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-6x+C" :db/id #edb/ref 17592186293928} {:answer/id #uuid "e160f72d-d70e-563e-b0e2-4f69c703004d" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186293929} {:answer/id #uuid "85934a88-847c-5579-b52f-c98987135b92" :answer/type {:db/ident :answer.type/math} :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)+C" :db/id #edb/ref 17592186293930} {:answer/id #uuid "e48d527f-2067-50f2-be69-8c868207bf16" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)+3x+C" :db/id #edb/ref 17592186293931}] :answer-field/correct {:answer/id #uuid "e160f72d-d70e-563e-b0e2-4f69c703004d" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186293929} :answer-field/id #uuid "0f253d85-c210-5565-afd9-b86eecd88011" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293926}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b86c6e4-2e5b-5fd5-acdb-a0e53fdeb34a" :question/math-academy-id "q-114592" :question/problem "$\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=\\int \\operatorname{ln}⁡(x-3)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x-3)\\, & ⟹\\,{u}^{′}=\\frac{1}{x-3} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x-3)\\cdot x-\\int x\\cdot \\frac{1}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x.\\end{aligned}\n$$\n\nNow, we use a substitution $x-3=u,$ thus $x=u+3$ and $\\text{d}x=\\text{d}u.$ Hence,\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{u+3}{u}\\,\\text{d}u \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\,\\text{d}u-3\\int \\frac{\\text{d}u}{u} \\\\  & =x\\operatorname{ln}⁡(x-3)-u-3\\operatorname{ln}⁡u+D \\\\  & =x\\operatorname{ln}⁡(x-3)-(x-3)-3\\operatorname{ln}⁡(x-3)+D \\\\  & =x\\operatorname{ln}⁡(x-3)-3\\operatorname{ln}⁡(x-3)-x+3+D \\\\  & =(x-3)\\operatorname{ln}⁡(x-3)-x+C,\\end{aligned}\n$$\n\nwhere $C=D+3$ is an integral constant."}] [{:db/id #edb/ref 17592186293932 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9662af08-d7c1-5e9d-9406-c9a29a091296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2e^3+1}{8\\ln(3)}" :db/id #edb/ref 17592186293934}] :answer-field/correct {:answer/id #uuid "9662af08-d7c1-5e9d-9406-c9a29a091296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2e^3+1}{8\\ln(3)}" :db/id #edb/ref 17592186293934} :answer-field/id #uuid "5bbe9ae0-c8e2-5837-bd7c-0b50582d2798" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293933}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "60e017ef-1df5-5087-bcd7-4d4b713d9cc6" :question/math-academy-id "q-351016" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x={\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(8x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡(3)} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/8}^{{e}^{3}/8}{log}_{3}⁡(8x)\\,\\text{d}x & ={\\int }_{1/8}^{{e}^{3}/8}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1/8}^{{e}^{3}/8}-{\\int }_{1/8}^{{e}^{3}/8}v{u}^{′}\\text{d}x \\\\  & ={log}_{3}⁡(8x)\\,(x){|}_{1/8}^{{e}^{3}/8}-{\\int }_{1/8}^{{e}^{3}/8}x(\\frac{1}{x\\operatorname{ln}⁡(3)})\\,\\text{d}x \\\\  & =[{log}_{3}⁡(8\\cdot \\frac{{e}^{3}}{8})\\,(\\frac{{e}^{3}}{8})-{log}_{3}⁡(8\\cdot \\frac{1}{8})\\,(\\frac{1}{8})]-\\frac{1}{\\operatorname{ln}⁡(3)}{\\int }_{1/8}^{{e}^{3}/8}\\text{d}x \\\\  & =\\frac{{e}^{3}}{8}{log}_{3}⁡({e}^{3})-\\frac{1}{8}{log}_{3}⁡(1)-\\frac{1}{\\operatorname{ln}⁡(3)}x{|}_{1/8}^{{e}^{3}/8} \\\\  & =\\frac{{e}^{3}}{8}\\cdot \\frac{3}{\\operatorname{ln}⁡(3)}-\\frac{1}{\\operatorname{ln}⁡(3)}(\\frac{{e}^{3}}{8}-\\frac{1}{8}) \\\\  & =\\frac{1}{8\\operatorname{ln}⁡(3)}(2{e}^{3}+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293935 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bee828e4-b972-5e91-b00f-662c59402e67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186293937} {:answer/id #uuid "35747aba-4b03-59de-8639-d0692d88904b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{4}}{\\operatorname{ln}⁡3}(1-4\\operatorname{ln}⁡x)+C" :db/id #edb/ref 17592186293938} {:answer/id #uuid "a5fce483-ddb6-550c-a47a-5b0153253090" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293939} {:answer/id #uuid "e0bfee78-a755-56f1-99d6-f628299c5ae2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293940} {:answer/id #uuid "c01bd8c2-c331-54a0-8b18-db31f2dcdf99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293941}] :answer-field/correct {:answer/id #uuid "a5fce483-ddb6-550c-a47a-5b0153253090" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293939} :answer-field/id #uuid "f75209d2-e563-555c-8c80-fa9cb6f9fdb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293936}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ee7df271-efad-5656-8b8b-3993fc52b08a" :question/math-academy-id "q-78961" :question/problem "Calculate $\\int 16{x}^{3}{log}_{3}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=16{x}^{3}\\, & ⟹\\,v=\\int 16{x}^{3}\\,\\text{d}x=4{x}^{4}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 16{x}^{3}{log}_{3}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡(x)(4{x}^{4})-\\int \\frac{4{x}^{4}}{x\\operatorname{ln}⁡3}\\,\\text{d}x \\\\  & =4{x}^{4}{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\int 4{x}^{3}\\,\\text{d}x \\\\  & =4{x}^{4}{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\cdot {x}^{4}+C \\\\  & =\\frac{4{x}^{4}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}-\\frac{{x}^{4}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{x}^{4}}{\\operatorname{ln}⁡3}(4\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$"}] [{:db/id #edb/ref 17592186293942 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ab38cf-a5af-5384-bdb0-adebedb61c03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293944} {:answer/id #uuid "7f0342b1-2889-533a-b143-2aaa9b3865da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293945} {:answer/id #uuid "ddc97104-c440-566b-8fdd-51084aa09457" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{4}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293946} {:answer/id #uuid "a1ba874e-8dcf-5530-8e52-ba8a0c690296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293947} {:answer/id #uuid "61a7f51c-b809-5293-9060-2e7e447669a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293948}] :answer-field/correct {:answer/id #uuid "61a7f51c-b809-5293-9060-2e7e447669a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293948} :answer-field/id #uuid "1e49af5d-d2fe-5544-93ff-5bc43178ebe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293943}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0002bb48-63e3-5869-82b8-396b34ff4061" :question/math-academy-id "q-78962" :question/problem "Calculate $\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}-\\frac{{x}^{5}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$"}] [{:db/id #edb/ref 17592186293949 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8803e90-c191-52d6-8000-b1786a6f2b98" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(2x)+1)+C" :db/id #edb/ref 17592186293951} {:answer/id #uuid "c33681d6-952b-5538-8d83-59c7b03cbb1f" :answer/type {:db/ident :answer.type/math} :answer/value "4x(\\operatorname{ln}⁡(4x)+1)+C" :db/id #edb/ref 17592186293952} {:answer/id #uuid "93bad77f-fc4c-5151-b61a-1e3552e61d95" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293953} {:answer/id #uuid "24b67811-2588-5ef9-b110-04869e9d624f" :answer/type {:db/ident :answer.type/math} :answer/value "4x(\\operatorname{ln}⁡(2x)-1)+C" :db/id #edb/ref 17592186293954} {:answer/id #uuid "0b28fab3-cd5e-5936-b51e-8b0a7c76cac7" :answer/type {:db/ident :answer.type/math} :answer/value "x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293955}] :answer-field/correct {:answer/id #uuid "93bad77f-fc4c-5151-b61a-1e3552e61d95" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293953} :answer-field/id #uuid "69fc184d-93d8-5619-91bc-9ecb7ce71f48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293950}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8f8b4061-8471-5977-a76a-c60012c56f62" :question/math-academy-id "q-78973" :question/problem "$\\int 2\\operatorname{ln}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int 2\\operatorname{ln}⁡4x\\,\\text{d}x=2\\int \\operatorname{ln}⁡4x\\cdot 1\\,\\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}2\\int \\operatorname{ln}⁡(4x)\\,\\text{d}x & =2\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =2[uv-\\int v{u}^{′}\\,\\text{d}x] \\\\  & =2[\\operatorname{ln}⁡(4x)\\cdot x-\\int x\\cdot \\frac{1}{x}\\,\\text{d}x] \\\\  & =2[x\\operatorname{ln}⁡(4x)-\\int \\,\\text{d}x] \\\\  & =2x\\operatorname{ln}⁡(4x)-2x+C \\\\  & =2x(\\operatorname{ln}⁡(4x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}]}
