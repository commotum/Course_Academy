#{[{:db/id #edb/ref 17592186329700 :knowledge-point/_questions [{:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "968a6766-a97b-5295-801e-491648daaf89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\sqrt{z+4}+C" :db/id #edb/ref 17592186329702} {:answer/id #uuid "f97d7aaa-0563-513d-977a-8ff780161b79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt[3]{(z+4)^{2}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186329703} {:answer/id #uuid "fd1d842b-6b7a-5b68-af1a-53754dd6a488" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186329704} {:answer/id #uuid "87e02f6a-c0f6-57e3-8d2c-584b177fe446" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\frac{1}{2\\sqrt{z+4}}+C" :db/id #edb/ref 17592186329705} {:answer/id #uuid "88f44c10-8f0f-593a-95a8-2586d73f1f2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(z+4)^{3}}}{2}+\\frac{1}{2\\sqrt{z+4}}+C" :db/id #edb/ref 17592186329706}] :answer-field/correct {:answer/id #uuid "fd1d842b-6b7a-5b68-af1a-53754dd6a488" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186329704} :answer-field/id #uuid "27e1a75c-e9dd-50d2-a5ca-b71b56162348" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329701}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c7f45e4c-e83c-5188-bd11-074855df9108" :question/math-academy-id "q-2592" :question/problem "Find the integral of $\\frac{z+5}{\\sqrt{z+4}}.$" :question/worked-solution "Let $u=z+4.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}z=\\text{d}u.\n$$\n\nWe also note that\n$z+5=u+1.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $z:$\n\n$$\n\\begin{aligned}\\int \\frac{z+5}{\\sqrt{z+4}}\\,\\text{d}z & =\\int \\frac{u+1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\frac{u}{\\sqrt{u}}+\\frac{1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\sqrt{u}\\,\\text{d}u+\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u+\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{2{u}^{3/2}}{3}+2\\sqrt{u}+C \\\\  & =\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329707 :knowledge-point/_questions [{:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19eb2c3b-8a97-576c-9a1b-28463c4850c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}}{7}-{x}^{2}+C" :db/id #edb/ref 17592186329709} {:answer/id #uuid "b99fcf91-2a16-54f3-b0a2-824d77cd7949" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}\\sqrt[5]{(1-x)^{7}}+\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}-\\frac{2}{3}\\sqrt[5]{(1-x)^{2}}+C" :db/id #edb/ref 17592186329710} {:answer/id #uuid "a72672e3-2c33-52f9-9a96-f26f68e7008d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\sqrt{{x}^{9}}+\\frac{2}{7}\\sqrt{{x}^{3}}-\\frac{5}{3}\\sqrt{{x}^{3}}+C" :db/id #edb/ref 17592186329711} {:answer/id #uuid "a0c0ac65-171e-5f82-b0fe-8275370d3c95" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C" :db/id #edb/ref 17592186329712} {:answer/id #uuid "d478804d-1e8c-59fc-8cb3-027194f5067d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}-\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}+\\sqrt{(1-x)^{3}}+C" :db/id #edb/ref 17592186329713}] :answer-field/correct {:answer/id #uuid "a0c0ac65-171e-5f82-b0fe-8275370d3c95" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C" :db/id #edb/ref 17592186329712} :answer-field/id #uuid "160f67f9-8a32-5b64-8bb4-e000c3215b07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329708}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "71a753e3-9496-5228-ba12-3b27ca135d46" :question/math-academy-id "q-2615" :question/problem "Calculate the integral $\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x.$" :question/worked-solution "Let $u=1-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that\n$x=1-u.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x & =-\\int (1-u)^{2}\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{2}-2u+1)\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{5/2}-2{u}^{3/2}+{u}^{1/2})\\,\\text{d}u \\\\  & =-(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2}+\\frac{2}{3}{u}^{3/2})+C \\\\  & =-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329714 :knowledge-point/_questions [{:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2" :knowledge-point/title "Calculating Definite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f211e4-48c4-54f8-8586-fe2c24e2ab50" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln(2)-1" :db/id #edb/ref 17592186329716}] :answer-field/correct {:answer/id #uuid "26f211e4-48c4-54f8-8586-fe2c24e2ab50" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln(2)-1" :db/id #edb/ref 17592186329716} :answer-field/id #uuid "feaf0c94-6248-549d-8726-0cd46ee35699" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186329715}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b6ca6185-1f98-5207-b0cd-2f75db44038f" :question/math-academy-id "q-348289" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{3}+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,3{x}^{2}\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that ${x}^{3}=u-1.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2{x}^{3}}{({x}^{3}+1)^{2}}\\cdot 3{x}^{2}\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{2(u-1)}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{2}(\\frac{2}{u}-\\frac{2}{{u}^{2}})\\,\\text{d}u \\\\  & ={(2\\operatorname{ln}⁡|u|+\\frac{2}{u})|}_{1}^{2} \\\\  & =(2\\operatorname{ln}⁡(2)+\\frac{2}{2})-(2\\operatorname{ln}⁡(1)+2) \\\\  & =2\\operatorname{ln}⁡(2)-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329717 :knowledge-point/_questions [{:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447d70fd-9bc0-536d-b56a-6baf45fc5cf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\int ({u}^{6/5}-{u}^{1/5})\\text{d}u" :db/id #edb/ref 17592186329719} {:answer/id #uuid "afecfb73-1b38-5d7a-93b4-6f9f6502a123" :answer/type {:db/ident :answer.type/math} :answer/value "\\int ({u}^{1/5}+{u}^{-1/5})\\text{d}u" :db/id #edb/ref 17592186329720} {:answer/id #uuid "f402bf92-b747-5875-be3d-97198a2f5b3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\int ({u}^{6/5}+{u}^{1/5})\\text{d}u" :db/id #edb/ref 17592186329721} {:answer/id #uuid "1f12587a-24bf-5dc6-92f9-04c097d54e9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int {u}^{1/5}\\,\\text{d}u" :db/id #edb/ref 17592186329722} {:answer/id #uuid "93c75f3d-8dd5-5972-bf2a-65b84c562e22" :answer/type {:db/ident :answer.type/math} :answer/value "\\int {u}^{6/5}\\,\\text{d}u" :db/id #edb/ref 17592186329723}] :answer-field/correct {:answer/id #uuid "f402bf92-b747-5875-be3d-97198a2f5b3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\int ({u}^{6/5}+{u}^{1/5})\\text{d}u" :db/id #edb/ref 17592186329721} :answer-field/id #uuid "9a148915-426c-5add-806a-34715dd640ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329718}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "59980c3f-441f-54c6-8144-e27ba400a19a" :question/math-academy-id "q-49386" :question/problem "Given that $u=x-1$, which integral is equivalent to $\\int x\\sqrt[5]{x-1}\\,\\text{d}x?$" :question/worked-solution "Since $u=x-1,$ then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that\n$x=u+1.$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int x\\sqrt[5]{x-1}\\,\\text{d}x & =\\int (u+1)(\\sqrt[5]{u})(\\text{d}u) \\\\  & =\\int (u+1)({u}^{1/5})(\\text{d}u) \\\\  & =\\int ({u}^{6/5}+{u}^{1/5})\\text{d}u\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329724 :knowledge-point/_questions [{:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2" :knowledge-point/title "Calculating Definite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1210c81d-0e86-597e-9dac-7a00ef8b01e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{0}^{2}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186329726} {:answer/id #uuid "ad1dd8a5-d998-5c79-be21-6522c583d96b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{-3}^{7}\\sqrt{u}\\,\\text{d}u" :db/id #edb/ref 17592186329727} {:answer/id #uuid "bdc4c23b-af7b-5cd3-8e99-a175d9446ce1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{0}^{2}({u}^{1/2}-3{u}^{-1/2})\\text{d}u" :db/id #edb/ref 17592186329728} {:answer/id #uuid "14b56439-63e9-52a4-9445-be718ec567d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186329729} {:answer/id #uuid "75779223-01a6-5671-8f5e-3d4a35d341ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{\\int }_{3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186329730}] :answer-field/correct {:answer/id #uuid "14b56439-63e9-52a4-9445-be718ec567d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/id #edb/ref 17592186329729} :answer-field/id #uuid "2e3e2d2f-80b4-53e8-9296-a4932dd17f29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329725}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7a1a231a-d98b-5233-a49a-ec2fe77f8469" :question/math-academy-id "q-49533" :question/problem "Given that $u=5x-3$, which integral is equivalent to ${\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x?$" :question/worked-solution "Since $u=5x-3$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+3}{5}.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $-3$ | $7$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x & ={\\int }_{-3}^{7}\\frac{u+3}{5}\\cdot \\sqrt{u}\\cdot \\frac{1}{5}\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}(u+3){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u\\end{aligned}\n$$"}]}
