[{:db/id "q-2592/selection/0a5e17530e7f56d7df4b763392019a63357fdecb61dc6ad6fa0165a5dfb1eea4" :answer/id #uuid "968a6766-a97b-5295-801e-491648daaf89" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\sqrt{z+4}+C" :db/ensure [:answer/validate]} {:db/id "q-2592/selection/c95435301744f919a877cdfdaf6108be70f33044662eab5d48c47db1d20c91b2" :answer/id #uuid "87e02f6a-c0f6-57e3-8d2c-584b177fe446" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\frac{1}{2\\sqrt{z+4}}+C" :db/ensure [:answer/validate]} {:db/id "q-2592/selection/8052b3f700c01f3a353aa2fe45c5e1c6e3334e126394f246c0c479f8c7041cb1" :answer/id #uuid "fd1d842b-6b7a-5b68-af1a-53754dd6a488" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C" :db/ensure [:answer/validate]} {:db/id "q-2592/selection/118f5a45d875a771c4cb1038fe9987fb239cfb6b155a168bcf9727bf5ab839c9" :answer/id #uuid "f97d7aaa-0563-513d-977a-8ff780161b79" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt[3]{(z+4)^{2}}}{3}+2\\sqrt{z+4}+C" :db/ensure [:answer/validate]} {:db/id "q-2592/selection/d9829578c41e7b9a2c3947bbe5781a62d92233f391964a3f4eafbf3e944be993" :answer/id #uuid "88f44c10-8f0f-593a-95a8-2586d73f1f2e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{(z+4)^{3}}}{2}+\\frac{1}{2\\sqrt{z+4}}+C" :db/ensure [:answer/validate]} {:db/id "q-2592/selection" :answer-field/id #uuid "27e1a75c-e9dd-50d2-a5ca-b71b56162348" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2592/selection/8052b3f700c01f3a353aa2fe45c5e1c6e3334e126394f246c0c479f8c7041cb1" :answer-field/choices ["q-2592/selection/0a5e17530e7f56d7df4b763392019a63357fdecb61dc6ad6fa0165a5dfb1eea4" "q-2592/selection/c95435301744f919a877cdfdaf6108be70f33044662eab5d48c47db1d20c91b2" "q-2592/selection/8052b3f700c01f3a353aa2fe45c5e1c6e3334e126394f246c0c479f8c7041cb1" "q-2592/selection/118f5a45d875a771c4cb1038fe9987fb239cfb6b155a168bcf9727bf5ab839c9" "q-2592/selection/d9829578c41e7b9a2c3947bbe5781a62d92233f391964a3f4eafbf3e944be993"] :db/ensure [:answer-field/validate]} {:db/id "q-2592" :question/id #uuid "c7f45e4c-e83c-5188-bd11-074855df9108" :question/math-academy-id "q-2592" :question/problem "Find the integral of $\\frac{z+5}{\\sqrt{z+4}}.$" :question/worked-solution "Let $u=z+4.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}z=\\text{d}u.\n$$\n\nWe also note that\n$z+5=u+1.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $z:$\n\n$$\n\\begin{aligned}\\int \\frac{z+5}{\\sqrt{z+4}}\\,\\text{d}z & =\\int \\frac{u+1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\frac{u}{\\sqrt{u}}+\\frac{1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\sqrt{u}\\,\\text{d}u+\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u+\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{2{u}^{3/2}}{3}+2\\sqrt{u}+C \\\\  & =\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2592/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-2592"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2615/selection/1cea4c6aacea16d83b4a53901a30febbcbfca26f460a46fc0dd72a08b6ee0828" :answer/id #uuid "a72672e3-2c33-52f9-9a96-f26f68e7008d" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}\\sqrt{{x}^{9}}+\\frac{2}{7}\\sqrt{{x}^{3}}-\\frac{5}{3}\\sqrt{{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-2615/selection/07354e5253dbbfe57ada4ebf687d56f6c2c4a93897e85b11ace9b41c4b40fec2" :answer/id #uuid "19eb2c3b-8a97-576c-9a1b-28463c4850c8" :answer/type :answer.type/math :answer/value "\\frac{2{x}^{2}}{7}-{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-2615/selection/da710eea5a94ae173288fe002d47acc6a47e0a305744d8bd8584c960bd665554" :answer/id #uuid "a0c0ac65-171e-5f82-b0fe-8275370d3c95" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-2615/selection/f392c55153a3706389064df6a65541853bd27c1416e1926e4ca2811574c31d87" :answer/id #uuid "d478804d-1e8c-59fc-8cb3-027194f5067d" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}\\sqrt{(1-x)^{7}}-\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}+\\sqrt{(1-x)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-2615/selection/084ebd891d87c80ab219fc7a2a90f6cff9cbdd93fef2686220919b7ebf2fadc7" :answer/id #uuid "b99fcf91-2a16-54f3-b0a2-824d77cd7949" :answer/type :answer.type/math :answer/value "\\frac{2}{7}\\sqrt[5]{(1-x)^{7}}+\\frac{4}{5}\\sqrt[5]{(1-x)^{4}}-\\frac{2}{3}\\sqrt[5]{(1-x)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-2615/selection" :answer-field/id #uuid "160f67f9-8a32-5b64-8bb4-e000c3215b07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2615/selection/da710eea5a94ae173288fe002d47acc6a47e0a305744d8bd8584c960bd665554" :answer-field/choices ["q-2615/selection/1cea4c6aacea16d83b4a53901a30febbcbfca26f460a46fc0dd72a08b6ee0828" "q-2615/selection/07354e5253dbbfe57ada4ebf687d56f6c2c4a93897e85b11ace9b41c4b40fec2" "q-2615/selection/da710eea5a94ae173288fe002d47acc6a47e0a305744d8bd8584c960bd665554" "q-2615/selection/f392c55153a3706389064df6a65541853bd27c1416e1926e4ca2811574c31d87" "q-2615/selection/084ebd891d87c80ab219fc7a2a90f6cff9cbdd93fef2686220919b7ebf2fadc7"] :db/ensure [:answer-field/validate]} {:db/id "q-2615" :question/id #uuid "71a753e3-9496-5228-ba12-3b27ca135d46" :question/math-academy-id "q-2615" :question/problem "Calculate the integral $\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x.$" :question/worked-solution "Let $u=1-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that\n$x=1-u.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int {x}^{2}\\sqrt{1-x}\\,\\text{d}x & =-\\int (1-u)^{2}\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{2}-2u+1)\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int ({u}^{5/2}-2{u}^{3/2}+{u}^{1/2})\\,\\text{d}u \\\\  & =-(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2}+\\frac{2}{3}{u}^{3/2})+C \\\\  & =-\\frac{2}{7}\\sqrt{(1-x)^{7}}+\\frac{4}{5}\\sqrt{(1-x)^{5}}-\\frac{2}{3}\\sqrt{(1-x)^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2615/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-2615"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49386/selection/7a55c771e897e700d142545d3f702d7a1fd70e43c39f7fc433fc84c82731f99f" :answer/id #uuid "f402bf92-b747-5875-be3d-97198a2f5b3e" :answer/type :answer.type/math :answer/value "\\int ({u}^{6/5}+{u}^{1/5})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49386/selection/9405a454d86254a3564e680f3c5bed24abd6cc32ad83706895d182b5e318e31b" :answer/id #uuid "1f12587a-24bf-5dc6-92f9-04c097d54e9b" :answer/type :answer.type/math :answer/value "\\int {u}^{1/5}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49386/selection/18edc72f0957d66d2f2dcf2d8d685e79679f80db1028ab286775579def688cea" :answer/id #uuid "447d70fd-9bc0-536d-b56a-6baf45fc5cf6" :answer/type :answer.type/math :answer/value "\\int ({u}^{6/5}-{u}^{1/5})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49386/selection/fb8dec3369e58c1b981dd7d7aa04fa8b5d11cd6a9de7a894b51c469782f71092" :answer/id #uuid "93c75f3d-8dd5-5972-bf2a-65b84c562e22" :answer/type :answer.type/math :answer/value "\\int {u}^{6/5}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49386/selection/5b02132da830a3f60cbbac3fcb3466349361182ed010cd6cab4d3dde167b93a0" :answer/id #uuid "afecfb73-1b38-5d7a-93b4-6f9f6502a123" :answer/type :answer.type/math :answer/value "\\int ({u}^{1/5}+{u}^{-1/5})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49386/selection" :answer-field/id #uuid "9a148915-426c-5add-806a-34715dd640ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49386/selection/7a55c771e897e700d142545d3f702d7a1fd70e43c39f7fc433fc84c82731f99f" :answer-field/choices ["q-49386/selection/7a55c771e897e700d142545d3f702d7a1fd70e43c39f7fc433fc84c82731f99f" "q-49386/selection/9405a454d86254a3564e680f3c5bed24abd6cc32ad83706895d182b5e318e31b" "q-49386/selection/18edc72f0957d66d2f2dcf2d8d685e79679f80db1028ab286775579def688cea" "q-49386/selection/fb8dec3369e58c1b981dd7d7aa04fa8b5d11cd6a9de7a894b51c469782f71092" "q-49386/selection/5b02132da830a3f60cbbac3fcb3466349361182ed010cd6cab4d3dde167b93a0"] :db/ensure [:answer-field/validate]} {:db/id "q-49386" :question/id #uuid "59980c3f-441f-54c6-8144-e27ba400a19a" :question/math-academy-id "q-49386" :question/problem "Given that $u=x-1$, which integral is equivalent to $\\int x\\sqrt[5]{x-1}\\,\\text{d}x?$" :question/worked-solution "Since $u=x-1,$ then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that\n$x=u+1.$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int x\\sqrt[5]{x-1}\\,\\text{d}x & =\\int (u+1)(\\sqrt[5]{u})(\\text{d}u) \\\\  & =\\int (u+1)({u}^{1/5})(\\text{d}u) \\\\  & =\\int ({u}^{6/5}+{u}^{1/5})\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49386/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-49386"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49533/selection/1a16c41bbc53db52c04d9ec2460bf94d74437eb07f3f81fcd64cf807309b943b" :answer/id #uuid "ad1dd8a5-d998-5c79-be21-6522c583d96b" :answer/type :answer.type/math :answer/value "\\frac{1}{5}{\\int }_{-3}^{7}\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49533/selection/8e9147e75c85436261c3577dc8574992b2a9e2471cc69c008d50583042efde13" :answer/id #uuid "14b56439-63e9-52a4-9445-be718ec567d7" :answer/type :answer.type/math :answer/value "\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49533/selection/19f1b30ea906677b79868daa69121720ba2ea0f92736b729df9de0ee87ba8bc3" :answer/id #uuid "1210c81d-0e86-597e-9dac-7a00ef8b01e9" :answer/type :answer.type/math :answer/value "\\frac{1}{5}{\\int }_{0}^{2}\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49533/selection/61f63927add7111633ca9fe7f44f6af1622264a43188790d0288e623c5d60ae2" :answer/id #uuid "bdc4c23b-af7b-5cd3-8e99-a175d9446ce1" :answer/type :answer.type/math :answer/value "\\frac{1}{25}{\\int }_{0}^{2}({u}^{1/2}-3{u}^{-1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49533/selection/ef24aaa940c818e5d8bd85564bb20cb37d457085676e7fc7a09dc8d6e0205d61" :answer/id #uuid "75779223-01a6-5671-8f5e-3d4a35d341ad" :answer/type :answer.type/math :answer/value "\\frac{1}{5}{\\int }_{3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49533/selection" :answer-field/id #uuid "2e3e2d2f-80b4-53e8-9296-a4932dd17f29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49533/selection/8e9147e75c85436261c3577dc8574992b2a9e2471cc69c008d50583042efde13" :answer-field/choices ["q-49533/selection/1a16c41bbc53db52c04d9ec2460bf94d74437eb07f3f81fcd64cf807309b943b" "q-49533/selection/8e9147e75c85436261c3577dc8574992b2a9e2471cc69c008d50583042efde13" "q-49533/selection/19f1b30ea906677b79868daa69121720ba2ea0f92736b729df9de0ee87ba8bc3" "q-49533/selection/61f63927add7111633ca9fe7f44f6af1622264a43188790d0288e623c5d60ae2" "q-49533/selection/ef24aaa940c818e5d8bd85564bb20cb37d457085676e7fc7a09dc8d6e0205d61"] :db/ensure [:answer-field/validate]} {:db/id "q-49533" :question/id #uuid "7a1a231a-d98b-5233-a49a-ec2fe77f8469" :question/math-academy-id "q-49533" :question/problem "Given that $u=5x-3$, which integral is equivalent to ${\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x?$" :question/worked-solution "Since $u=5x-3$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+3}{5}.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $-3$ | $7$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{5x-3}\\,\\text{d}x & ={\\int }_{-3}^{7}\\frac{u+3}{5}\\cdot \\sqrt{u}\\cdot \\frac{1}{5}\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}(u+3){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{25}{\\int }_{-3}^{7}({u}^{3/2}+3{u}^{1/2})\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49533/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-49533"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348289/field-1/233e1f0417295998b1f6d87a5c1da981d7e6b45f94ed3cbb1206d6c7a55ecaa5" :answer/id #uuid "26f211e4-48c4-54f8-8586-fe2c24e2ab50" :answer/type :answer.type/math :answer/value "2\\ln(2)-1" :db/ensure [:answer/validate]} {:db/id "q-348289/field-1" :answer-field/id #uuid "feaf0c94-6248-549d-8726-0cd46ee35699" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348289/field-1/233e1f0417295998b1f6d87a5c1da981d7e6b45f94ed3cbb1206d6c7a55ecaa5" :answer-field/choices ["q-348289/field-1/233e1f0417295998b1f6d87a5c1da981d7e6b45f94ed3cbb1206d6c7a55ecaa5"] :db/ensure [:answer-field/validate]} {:db/id "q-348289" :question/id #uuid "b6ca6185-1f98-5207-b0cd-2f75db44038f" :question/math-academy-id "q-348289" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{3}+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,3{x}^{2}\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that ${x}^{3}=u-1.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{6{x}^{5}}{({x}^{3}+1)^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2{x}^{3}}{({x}^{3}+1)^{2}}\\cdot 3{x}^{2}\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{2(u-1)}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{2}(\\frac{2}{u}-\\frac{2}{{u}^{2}})\\,\\text{d}u \\\\  & ={(2\\operatorname{ln}⁡|u|+\\frac{2}{u})|}_{1}^{2} \\\\  & =(2\\operatorname{ln}⁡(2)+\\frac{2}{2})-(2\\operatorname{ln}⁡(1)+2) \\\\  & =2\\operatorname{ln}⁡(2)-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348289/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-348289"] :db/ensure [:knowledge-point/validate]}]
