30}^{∘}\n$$\n\nSince $-{30}^{∘}$ lies outside the given domain, it is not a solution.\n\nTo generate the solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={180}^{∘}+x={180}^{∘}-{30}^{∘}={150}^{∘}, \\\\ {x}_{2} & =2\\cdot {180}^{∘}+x=2\\cdot {180}^{∘}-{30}^{∘}={330}^{∘}.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x={150}^{∘}$ and $x={330}^{∘}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274558/field-1" "q-274558/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ba963ded-e9ff-5324-9d22-acb6b7a85e10"] :knowledge-point/questions ["q-274558"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29207/selection/9816b001c878549759686732913aed2bf8240aede588f8b3825b7da75ceb494a" :answer/id #uuid "243509e1-664b-5f5f-a1f4-36801eca74bf" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-29207/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" :answer/id #uuid "7cd374af-c906-51df-84ac-b73509e1a483" :answer/type :answer.type/math :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-29207/selection/4e4ce44ca37da77628b8203cf932ca9514b646c263c1dd9cfa5a2b940ec453b3" :answer/id #uuid "1a23b493-557c-54bb-8c51-427a8e4b5401" :answer/type :answer.type/math :answer/value "\\frac{7{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-29207/selection/ed5b0237607f5fd14ef0ef6a03ad488eb352c18840ce7bca6c5e90c8402e7c2e" :answer/id #uuid "1b5a7d2c-042e-58cb-b44d-72b9739d2e7a" :answer/type :answer.type/math :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-29207/selection/9fd9604a33923dcebe8a17d833e9e1e0665390bc77393075dcdb50de6a12a3a3" :answer/id #uuid "41cea4a7-546d-507a-a823-64ebc3c11b5e" :answer/type :answer.type/math :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-29207/selection" :answer-field/id #uuid "77b3799d-89b8-5487-b5d2-78660ea9fb8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29207/selection/9fd9604a33923dcebe8a17d833e9e1e0665390bc77393075dcdb50de6a12a3a3" :answer-field/choices ["q-29207/selection/9816b001c878549759686732913aed2bf8240aede588f8b3825b7da75ceb494a" "q-29207/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" "q-29207/selection/4e4ce44ca37da77628b8203cf932ca9514b646c263c1dd9cfa5a2b940ec453b3" "q-29207/selection/ed5b0237607f5fd14ef0ef6a03ad488eb352c18840ce7bca6c5e90c8402e7c2e" "q-29207/selection/9fd9604a33923dcebe8a17d833e9e1e0665390bc77393075dcdb50de6a12a3a3"] :db/ensure [:answer-field/validate]} {:db/id "q-29207" :question/id #uuid "12f917ae-0eb2-5de2-82e7-0cc05d22a03d" :question/math-academy-id "q-29207" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=1$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=1\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(1)=\\frac{\\pi }{4}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{4}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{4}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +\\frac{\\pi }{4}=\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{4},\\frac{5\\pi }{4}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{5\\pi }{4}=\\frac{5{\\pi }^{2}}{16}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-29207/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ba963ded-e9ff-5324-9d22-acb6b7a85e10"] :knowledge-point/questions ["q-29207"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120620/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" :answer/id #uuid "d6fae503-fba0-5873-b5c4-2f973e211d34" :answer/type :answer.type/math :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-120620/selection/7fdb708f0810c1fe78d182b7a6008108a1f44ad8ce9a8e7620ca9a4b7f01c340" :answer/id #uuid "3c0176d8-6ce8-5202-a8b8-f9cb9fb8be47" :answer/type :answer.type/math :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/ensure [:answer/validate]} {:db/id "q-120620/selection/080aa7aa965688cd2badb7b57dce39c6db33b60e55a0036b313d953319d0b4d6" :answer/id #uuid "97c8fa7e-edde-5220-bc7d-9c70b74fd26b" :answer/type :answer.type/math :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/ensure [:answer/validate]} {:db/id "q-120620/selection/1469cb3234d8827d90ce635fea976fd9f8898ec812577cad4fcea5557d011275" :answer/id #uuid "47d4762a-9733-5065-84d9-079e643a2da1" :answer/type :answer.type/math :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/ensure [:answer/validate]} {:db/id "q-120620/selection/6896a5b01dacacdba29c63c5726edc41e702d98103d2c246e6f528cbb98df145" :answer/id #uuid "8df980c9-1d81-50d8-aa17-16c27741f4e3" :answer/type :answer.type/math :answer/value "\\frac{7{\\pi }^{2}}{36}" :db/ensure [:answer/validate]} {:db/id "q-120620/selection" :answer-field/id #uuid "72186251-acfd-58ae-8b3d-240e90cefaf1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120620/selection/6896a5b01dacacdba29c63c5726edc41e702d98103d2c246e6f528cbb98df145" :answer-field/choices ["q-120620/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" "q-120620/selection/7fdb708f0810c1fe78d182b7a6008108a1f44ad8ce9a8e7620ca9a4b7f01c340" "q-120620/selection/080aa7aa965688cd2badb7b57dce39c6db33b60e55a0036b313d953319d0b4d6" "q-120620/selection/1469cb3234d8827d90ce635fea976fd9f8898ec812577cad4fcea5557d011275" "q-120620/selection/6896a5b01dacacdba29c63c5726edc41e702d98103d2c246e6f528cbb98df145"] :db/ensure [:answer-field/validate]} {:db/id "q-120620" :question/id #uuid "e4bfe25b-7745-56bc-a188-ffde09186b7e" :question/math-academy-id "q-120620" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=\\frac{3}{\\sqrt{3}}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\sqrt{3}}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n{x}_{2}=\\pi +x=\\pi +\\frac{\\pi }{6}=\\frac{7\\pi }{6}.\n$$\n\nSo, the solutions are ${x}_{1}=\\frac{\\pi }{6},\\frac{7\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot \\frac{7\\pi }{6}=\\frac{7{\\pi }^{2}}{36}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-120620/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ba963ded-e9ff-5324-9d22-acb6b7a85e10"] :knowledge-point/questions ["q-120620"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29247/selection/30321150ee845543b2debd25ce4413c87e0b285ed0aab6a483249efafae8d959" :answer/id #uuid "e6e33af4-3af8-5bbf-b0de-3474ded2c3a0" :answer/type :answer.type/math :answer/value "2\\,134" :db/ensure [:answer/validate]} {:db/id "q-29247/selection/aba3fdff2dab62abd1263d577da1b3b7383b4ba5cd1fe6663e702b41900607e0" :answer/id #uuid "bcd0d182-8776-5f6a-a563-0720edfe80f8" :answer/type :answer.type/math :answer/value "2\\,564" :db/ensure [:answer/validate]} {:db/id "q-29247/selection/c21e06d30b2e45ef8b622d40ba3533bdbb769bed623d1456198424e80eb7a4d3" :answer/id #uuid "a37bc472-80c4-56c5-821b-4f9a836332d9" :answer/type :answer.type/math :answer/value "2\\,194" :db/ensure [:answer/validate]} {:db/id "q-29247/selection/fdcc8116307959765ece0146e62c8c22afdc8bd2db1d49522b7195a8d31d58fc" :answer/id #uuid "ca4b23c4-c7f8-50a5-881c-9f8de472b86e" :answer/type :answer.type/math :answer/value "2\\,124" :db/ensure [:answer/validate]} {:db/id "q-29247/selection/dc428ac61b8a1bf3cad8f5e5a1716a4a66ad425699aafbdfd13f1fa0c0f409c1" :answer/id #uuid "a498b00d-e812-5ad6-b89a-b6c6083b22ef" :answer/type :answer.type/math :answer/value "2\\,164" :db/ensure [:answer/validate]} {:db/id "q-29247/selection" :answer-field/id #uuid "4d7cf8c2-65b6-55a8-9bcd-b37f374ca4e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29247/selection/dc428ac61b8a1bf3cad8f5e5a1716a4a66ad425699aafbdfd13f1fa0c0f409c1" :answer-field/choices ["q-29247/selection/30321150ee845543b2debd25ce4413c87e0b285ed0aab6a483249efafae8d959" "q-29247/selection/aba3fdff2dab62abd1263d577da1b3b7383b4ba5cd1fe6663e702b41900607e0" "q-29247/selection/c21e06d30b2e45ef8b622d40ba3533bdbb769bed623d1456198424e80eb7a4d3" "q-29247/selection/fdcc8116307959765ece0146e62c8c22afdc8bd2db1d49522b7195a8d31d58fc" "q-29247/selection/dc428ac61b8a1bf3cad8f5e5a1716a4a66ad425699aafbdfd13f1fa0c0f409c1"] :db/ensure [:answer-field/validate]} {:db/id "q-29247" :question/id #uuid "afe96723-09c8-5d86-b142-e57c4c0aa80b" :question/math-academy-id "q-29247" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $3\\operatorname{cot}⁡x=20-\\operatorname{cot}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x$:\n\n$$\n\\begin{aligned}3\\operatorname{cot}⁡x & =20-\\operatorname{cot}⁡x \\\\ 4\\operatorname{cot}⁡x & =20 \\\\ \\operatorname{cot}⁡x & =5\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{5}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{1}{5})=(11.309\\,9…)^{∘}≈{11.310}^{∘}\\end{aligned}\n$$\n\nSince ${11.310}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={11.310}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}={180}^{∘}+{11.310}^{∘}={191.310}^{∘}.\\end{aligned}\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n11.310\\cdot 191.310≈2\\,164\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-29247/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c71c49ee-e496-5d4e-87fa-96e28dd830ca"] :knowledge-point/questions ["q-29247"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327780/field-1/7ba4ebd0d8a414ae4c404538d01dce67a31f8f6714da9cff2a89b3a7ecb90e95" :answer/id #uuid "ca7da035-d6df-5764-96a7-84fccc1bbd3e" :answer/type :answer.type/math :answer/value "76" :db/ensure [:answer/validate]} {:db/id "q-327780/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "1c5070b6-d21e-5ddb-9e65-9b21b37d7b29" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-327780/field-1" :answer-field/id #uuid "4b596d55-605d-513d-893e-12400ae08475" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327780/field-1/7ba4ebd0d8a414ae4c404538d01dce67a31f8f6714da9cff2a89b3a7ecb90e95" :answer-field/choices ["q-327780/field-1/7ba4ebd0d8a414ae4c404538d01dce67a31f8f6714da9cff2a89b3a7ecb90e95" "q-327780/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-327780/field-2/d144965a68a71154d2438737e51156d9918da199ac2f07b96e885a6c60965580" :answer/id #uuid "efa5c6da-b3b1-51f3-8678-79720081a3a7" :answer/type :answer.type/math :answer/value "256" :db/ensure [:answer/validate]} {:db/id "q-327780/field-2" :answer-field/id #uuid "358d68eb-de0d-5dba-a947-62968792248f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327780/field-2/d144965a68a71154d2438737e51156d9918da199ac2f07b96e885a6c60965580" :answer-field/choices ["q-327780/field-2/d144965a68a71154d2438737e51156d9918da199ac2f07b96e885a6c60965580"] :db/ensure [:answer-field/validate]} {:db/id "q-327780" :question/id #uuid "5dd12e1b-3e10-56f5-a9b3-6cdf51c48527" :question/math-academy-id "q-327780" :question/problem "Find, **in ascending order and rounded to the nearest integer**, the two solutions to the equation $\\operatorname{cot}⁡x=\\frac{1}{4}$  for ${0}^{∘}\\le x<{360}^{∘}.$\n\n**In ascending order,** the solutions are $x=$ \n{{field-1}}${}^{∘}$ and $x=$ \n{{field-2}}${}^{∘}.$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=4.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(4)=(75.963\\,7…)^{∘}≈{75.964}^{∘}\n$$\n\nSince ${75.964}^{∘}$ lies inside the given domain, our first solution, rounded to the nearest integer, is ${x}_{1}={76}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$\nHence,\n\n$$\n{x}_{2}={180}^{∘}+x={180}^{∘}+{75.964}^{∘}≈{256}^{∘},\n$$\n\nrounded to the nearest integer.\n\nTherefore, in ascending order, the solutions are $x={76}^{∘}$ and $x={256}^{∘}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-327780/field-1" "q-327780/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c71c49ee-e496-5d4e-87fa-96e28dd830ca"] :knowledge-point/questions ["q-327780"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-29242"] :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $5\\operatorname{cot}⁡x=11+\\operatorname{cot}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x$:\n\n$$\n\\begin{aligned}5\\operatorname{cot}⁡x & =11+\\operatorname{cot}⁡x \\\\ 4\\operatorname{cot}⁡x & =11 \\\\ \\operatorname{cot}⁡x & =\\frac{11}{4}\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{4}{11}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{4}{11})=(19.983\\,1…)^{∘}≈{19.983}^{∘}\\end{aligned}\n$$\n\nSince ${19.983}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={19.983}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n{x}_{2}={180}^{∘}+x={180}^{∘}+{19.983}^{∘}={199.983}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n19.983\\cdot 199.983≈3\\,996\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-274562/field-1/3cc4fd9ed9e3087b90e0e061efb4af208d7e8bceac111d500e24030df086c91a" :answer/id #uuid "d7a232b0-2e2e-5134-b6b6-cdbf8fc819d9" :answer/type :answer.type/math :answer/value "113" :db/ensure [:answer/validate]} {:db/id "q-274562/field-1/21b3922c447d95ef72830e9a9ad9c4c16826fd94e990171384322edf84c2ba00" :answer/id #uuid "2225e952-49f4-5b40-a34c-9c89c1a64feb" :answer/type :answer.type/math :answer/value "67" :db/ensure [:answer/validate]} {:db/id "q-274562/field-1" :answer-field/id #uuid "ca1cd32f-d904-56cd-8a73-a993fee0b58b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274562/field-1/3cc4fd9ed