grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14032506/state.json" "file_sha256" "a539a32a8dd95d0912b2245a29a49169ae75be19b878410dfc591b197b2c603c"}] "usage" {"q-42265" []} "basis" 1223 "retractions" [[17592186115748 :question/problem "Given that $A, B$, and $C$ are $4 \\cdot 4$ matrices, which of the following statements are always true?\n\n1. $AB = BA$\n2. $(AB)C = A(BC)$\n3. $AC + BC = (A + B)C$"]] "immutable_answers" [17592186113860 17592186113861 17592186113862 17592186113863 17592186113864] "immutable_fields" [[17592186113859 :answer-field/correct] [17592186113859 :answer-field/id] [17592186113859 :answer-field/key] [17592186113859 :answer-field/type]] "no_history" []}
