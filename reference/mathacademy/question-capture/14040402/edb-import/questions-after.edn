#{[{:db/id #edb/ref 17592186308840 :knowledge-point/_questions [{:knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e25b4b2-22f4-5ecd-bdda-279c63492cb8" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\,897" :db/id #edb/ref 17592186308842} {:answer/id #uuid "48f4fc96-edb1-5301-a879-d8330c8a7362" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,346" :db/id #edb/ref 17592186308843} {:answer/id #uuid "b9c26c9a-34b7-58d4-9bca-3d74b372c53a" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\,124" :db/id #edb/ref 17592186308844} {:answer/id #uuid "21acaee4-f32d-5f2a-8fc2-54c8728903f4" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\,929" :db/id #edb/ref 17592186308845} {:answer/id #uuid "aba11855-a554-50d0-9968-f9a7f8be3735" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\,235" :db/id #edb/ref 17592186308846}] :answer-field/correct {:answer/id #uuid "21acaee4-f32d-5f2a-8fc2-54c8728903f4" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\,929" :db/id #edb/ref 17592186308845} :answer-field/id #uuid "81150a3d-4af3-556e-8c7a-50ba848986b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308841}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "34f30bac-93c7-5019-95f7-3ddbfb548336" :question/math-academy-id "q-120635" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $3-4\\operatorname{cot}⁡x=-2\\operatorname{cot}⁡x$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/requires-calculator true :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}3-4\\operatorname{cot}⁡x & =-2\\operatorname{cot}⁡x \\\\ -2\\operatorname{cot}⁡x & =-3 \\\\ \\operatorname{cot}⁡x & =\\frac{3}{2}\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{2}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{2}{3})=(33.690\\,0…)^{∘}≈{33.690}^{∘}\\end{aligned}\n$$\n\nSince ${33.690}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={33.690}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=-{180}^{∘}+{33.690}^{∘}=-{146.310}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{146.310}^{∘},\\,{33.690}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n(-146.310)\\cdot 33.690≈-4\\,929\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186308847 :knowledge-point/_questions [{:knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d02e939d-59c6-5a31-96f6-14ee3057436e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186308849}] :answer-field/correct {:answer/id #uuid "d02e939d-59c6-5a31-96f6-14ee3057436e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186308849} :answer-field/id #uuid "5db4c15c-6db2-5378-bd97-c6a561fcf818" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308848} {:answer-field/choices [{:answer/id #uuid "8932798f-16d9-5a0d-9525-969c5fa41a7c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186308851}] :answer-field/correct {:answer/id #uuid "8932798f-16d9-5a0d-9525-969c5fa41a7c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186308851} :answer-field/id #uuid "14d38cc9-4dac-509d-9710-8e52178c1b6b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308850} {:answer-field/choices [{:answer/id #uuid "f33b269b-2d26-5ae9-b02f-010e6ec8c749" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186308853}] :answer-field/correct {:answer/id #uuid "f33b269b-2d26-5ae9-b02f-010e6ec8c749" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186308853} :answer-field/id #uuid "294f81e3-77a5-5e56-b619-5941fd3a14ac" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308852} {:answer-field/choices [{:answer/id #uuid "ac1faf61-5f85-5150-a55a-f457484b60fb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186308855}] :answer-field/correct {:answer/id #uuid "ac1faf61-5f85-5150-a55a-f457484b60fb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186308855} :answer-field/id #uuid "192c1a57-a3b9-593d-9f8f-1ea3af702df7" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308854}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5c1bda76-f90d-562c-b15f-d7fb64f98b44" :question/math-academy-id "q-251446" :question/problem "**From left to right**, the points of intersection of the parabola ${x}^{2}=4(y+\\frac{1}{2})$ with the $x$-axis are $A$ and $B.$ Find the **exact** coordinates of $A$ and $B.$\n\n$A(${{field-1}}$,$\n{{field-2}}$)\\,$ and $\\,B(${{field-3}}$,$\n{{field-4}}$)$" :question/worked-solution "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2} & =4(0+\\frac{1}{2}) \\\\ {x}^{2} & =2 \\\\ x & =\\pm \\sqrt{2}\\text{ }\\end{aligned}\n$$\n\nTherefore, the coordinates of the intersection points, from left to right, are $(-\\sqrt{2},0)$ and $(\\sqrt{2},0).$"}] [{:db/id #edb/ref 17592186308856 :knowledge-point/_questions [{:knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b90d648d-171f-51c2-97b0-752a3130e8ed" :answer/type {:db/ident :answer.type/math} :answer/value "x^2-4x+29" :db/id #edb/ref 17592186308858} {:answer/id #uuid "35b7eb22-1da7-567a-b313-335e0fde6de2" :answer/type {:db/ident :answer.type/math} :answer/value "x^2-4x-21" :db/id #edb/ref 17592186308859}] :answer-field/correct {:answer/id #uuid "b90d648d-171f-51c2-97b0-752a3130e8ed" :answer/type {:db/ident :answer.type/math} :answer/value "x^2-4x+29" :db/id #edb/ref 17592186308858} :answer-field/id #uuid "24fad0c8-a8f5-5710-adde-1d8e174aafd0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308857}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "387c5ba6-af83-553b-9db1-67f720d2ad8d" :question/math-academy-id "q-281343" :question/problem "A quadratic equation with real coefficients has a complex root $x=2+5\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $1,$ find the equation. Write your answer in the form $a{x}^{2}+bx+c=0,$ where $a,$ $b,$ and $c$ are real constants.\n\n{{field-1}}$=0$" :question/worked-solution "Since the quadratic equation has real coefficients and $x=2+5\\text{i}$ is a root, we know that its complex conjugate $x=2-5\\text{i}$ is also a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(2+5\\text{i}))(x-(2-5\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(2+5\\text{i})-x(2-5\\text{i})+(2+5\\text{i})(2-5\\text{i}) & =0 \\\\ {x}^{2}-2x-\\cancel{5x\\text{i}}-2x+\\cancel{5x\\text{i}}+4-25{\\text{i}}^{2} & =0 \\\\ {x}^{2}-4x+4+25 & =0 \\\\ {x}^{2}-4x+29 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302446 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4b0ad18-c84b-5e54-a67c-6a2f293969d8" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186302448} {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449}] :answer-field/correct {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449} :answer-field/id #uuid "e7b30cc0-d262-5f4d-8593-772f1da5138d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302447}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b90809e4-4aff-5a7b-bad0-bfb4210baded" :question/math-academy-id "q-325177" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(6,2)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{36+4} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=2\\sqrt{10}.$"}] [{:db/id #edb/ref 17592186308860 :knowledge-point/_questions [{:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f96ca09-8ca1-5d53-bd11-868ef46d5e0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186308862}] :answer-field/correct {:answer/id #uuid "5f96ca09-8ca1-5d53-bd11-868ef46d5e0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186308862} :answer-field/id #uuid "44a1e65b-ed67-5754-af82-d0f5f3843575" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308861}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "58748e15-69f9-5abe-94c4-9c4bd5de4ccf" :question/math-academy-id "q-341918" :question/problem "Find the slope $m$ of the tangent at the point $(9,\\,4)$ for the curve $\\sqrt{x}-\\sqrt{y}=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}-{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{1}{2}{x}^{-1/2}-\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ -\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ -\\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(9,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(9,\\,4)} \\\\  & ={(\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(9,\\,4)} \\\\  & =\\frac{\\sqrt{4}}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}]}
