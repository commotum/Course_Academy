#{[{:db/id #edb/ref 17592186302446 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4b0ad18-c84b-5e54-a67c-6a2f293969d8" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186302448} {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449}] :answer-field/correct {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449} :answer-field/id #uuid "e7b30cc0-d262-5f4d-8593-772f1da5138d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302447}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b90809e4-4aff-5a7b-bad0-bfb4210baded" :question/math-academy-id "q-325177" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(6,2)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{36+4} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=2\\sqrt{10}.$"}]}
