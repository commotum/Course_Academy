5716 true] [17592186363031 1041 "field-1" 13194139535716 true] [17592186363031 1104 #edb/ref 17592186363032 13194139535716 true] [17592186363031 1110 #uuid "ee2c1396-2e55-5c8d-8ebf-daab6e87b537" 13194139535716 true] [17592186363032 1034 "\\frac{1}{4}" 13194139535716 true] [17592186363032 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363032 1111 #uuid "df3889dc-037c-57b4-b1e8-6f1ded27af82" 13194139535716 true] [17592186363033 1000 #edb/ref 17592186363034 13194139535716 true] [17592186363033 1040 #edb/ref 17592186045449 13194139535716 true] [17592186363033 1041 "field-2" 13194139535716 true] [17592186363033 1104 #edb/ref 17592186363034 13194139535716 true] [17592186363033 1110 #uuid "8cc6704d-aa5b-5127-87b8-aea648b10e80" 13194139535716 true] [17592186363034 1034 "6" 13194139535716 true] [17592186363034 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363034 1111 #uuid "e94f7cbc-7ffa-58a9-94e7-e5b531bc989c" 13194139535716 true] [17592186363035 1017 #edb/ref 17592186363036 13194139535716 true] [17592186363035 1089 "q-88460" 13194139535716 true] [17592186363035 1091 #edb/ref 17592186045465 13194139535716 true] [17592186363035 1100 "What is the product of solutions of the equation $2{x}^{2}\\cdot {6}^{x+3}-9x\\cdot {6}^{x+3}+4\\cdot {6}^{x+3}=0?$" 13194139535716 true] [17592186363035 1113 #uuid "1e70f367-6480-5897-b934-951d91fc00be" 13194139535716 true] [17592186363035 1145 "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {6}^{x+3}-9x\\cdot {6}^{x+3}+4\\cdot {6}^{x+3} & =0 \\\\ (2{x}^{2}-9x+4){6}^{x+3} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}-9x+4=0\\,\\text{and}\\,{6}^{x+3}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}-9x+4=0$ can be factored as\n\n$$\n(2x-1)(x-4)=0,\n$$\n\nwhich leads to the solutions $x=\\frac{1}{2},4.$\n\n- The equation ${6}^{x+3}=0$ has no solutions because ${6}^{x+3}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=\\frac{1}{2},4,$ and their product is $\\frac{1}{2}\\cdot 4=2.$" 13194139535716 true] [17592186363036 1000 #edb/ref 17592186363037 13194139535716 true] [17592186363036 1000 #edb/ref 17592186363038 13194139535716 true] [17592186363036 1000 #edb/ref 17592186363039 13194139535716 true] [17592186363036 1000 #edb/ref 17592186363040 13194139535716 true] [17592186363036 1000 #edb/ref 17592186363041 13194139535716 true] [17592186363036 1040 #edb/ref 17592186045450 13194139535716 true] [17592186363036 1041 "selection" 13194139535716 true] [17592186363036 1104 #edb/ref 17592186363038 13194139535716 true] [17592186363036 1110 #uuid "fa4e42d5-1b09-5857-9502-e6caf5ca0333" 13194139535716 true] [17592186363037 1034 "\\frac{1}{8}" 13194139535716 true] [17592186363037 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363037 1111 #uuid "ac127ffb-efe4-528d-8920-7336e28a9610" 13194139535716 true] [17592186363038 1034 "2" 13194139535716 true] [17592186363038 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363038 1111 #uuid "0a2f68ec-59c1-55fe-9e7a-cefd24008237" 13194139535716 true] [17592186363039 1034 "\\frac{3}{4}" 13194139535716 true] [17592186363039 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363039 1111 #uuid "2d64f196-9115-505f-b0ca-5d59f8134ea5" 13194139535716 true] [17592186363040 1034 "-\\frac{1}{4}" 13194139535716 true] [17592186363040 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363040 1111 #uuid "cd145944-dc1c-507e-94ae-e20a971a4226" 13194139535716 true] [17592186363041 1034 "-6" 13194139535716 true] [17592186363041 1103 #edb/ref 17592186045453 13194139535716 true] [17592186363041 1111 #uuid "9d2b57e2-2e1a-5b81-9f13-673d579e972e" 13194139535716 true]] :edb/tempids {"q-237946" 17592186363013 "q-237946/field-1" 17592186363014 "q-237946/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac04103016