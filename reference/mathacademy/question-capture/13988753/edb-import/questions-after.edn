#{[{:db/id #edb/ref 17592186283219 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c1cc04-9317-5240-ab25-5ce1761dff56" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283221} {:answer/id #uuid "374971ce-2969-5c9a-a729-87f941694aad" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283222}] :answer-field/correct {:answer/id #uuid "02c1cc04-9317-5240-ab25-5ce1761dff56" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283221} :answer-field/id #uuid "d102c203-b758-58d5-886f-0a70e7a45563" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283220} {:answer-field/choices [{:answer/id #uuid "3131f03f-ca7b-55e0-8aa6-ce87627ccb34" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283224}] :answer-field/correct {:answer/id #uuid "3131f03f-ca7b-55e0-8aa6-ce87627ccb34" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283224} :answer-field/id #uuid "d1a82d85-9de2-5b81-8c59-0d5d58e8bf7f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283223}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2e8a16b6-124a-5f20-8e5c-bd0704bf2fa3" :question/math-academy-id "q-275272" :question/problem "The center of the hyperbola $5{y}^{2}-2{x}^{2}-20y+4x=-8$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}5{y}^{2}-2{x}^{2}-20y+4x & =-8 \\\\ 5{y}^{2}-20y-2{x}^{2}+4x & =-8 \\\\ 5[{y}^{2}-4y]-2[{x}^{2}-2x] & =-8 \\\\ 5[(y-2)^{2}-4]-2[(x-1)^{2}-1] & =-8 \\\\ 5(y-2)^{2}-20-2(x-1)^{2}+2 & =-8 \\\\ 5(y-2)^{2}-2(x-1)^{2} & =-8+20-2 \\\\ 5(y-2)^{2}-2(x-1)^{2} & =10 \\\\ \\frac{(y-2)^{2}}{2}-\\frac{(x-1)^{2}}{5} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,2\\,).$"}] [{:db/id #edb/ref 17592186283225 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e3cdfd6-e1a7-5f3f-b9c5-2f9180c11ea5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283227}] :answer-field/correct {:answer/id #uuid "9e3cdfd6-e1a7-5f3f-b9c5-2f9180c11ea5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283227} :answer-field/id #uuid "c184c230-d19c-5a16-96a7-ce28ab83cfcf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283226} {:answer-field/choices [{:answer/id #uuid "221eba26-7769-5be9-a4b2-ada2eb316ec2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283229}] :answer-field/correct {:answer/id #uuid "221eba26-7769-5be9-a4b2-ada2eb316ec2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283229} :answer-field/id #uuid "9b2d1cff-8888-55a2-94fb-d152bfb19f72" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283228}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "62a4c207-3a57-5ac6-8ed6-631aa5b25cf9" :question/math-academy-id "q-328317" :question/problem "The center of the hyperbola $\\frac{{y}^{2}}{49}-\\frac{(x-3)^{2}}{81}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{{y}^{2}}{{7}^{2}}-\\frac{(x-3)^{2}}{{9}^{2}}=1\n$$\n\nIn this case, we have $h=3$ and $k=0.$\n\nTherefore, the center of the hyperbola is $(\\,3,0\\,).$"}] [{:db/id #edb/ref 17592186283230 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98792725-41a0-5da0-b5d6-db129288946a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283232} {:answer/id #uuid "85fa5698-91ef-5c47-ba6f-ce806d63abad" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283233}] :answer-field/correct {:answer/id #uuid "98792725-41a0-5da0-b5d6-db129288946a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283232} :answer-field/id #uuid "a46e7f45-4f14-549b-8d34-2661338a50d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283231} {:answer-field/choices [{:answer/id #uuid "1591d5c8-2a19-5ea4-9ff8-fe4dff361aaa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283235}] :answer-field/correct {:answer/id #uuid "1591d5c8-2a19-5ea4-9ff8-fe4dff361aaa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283235} :answer-field/id #uuid "3aeef4ab-8348-5c3d-8693-991a60de3e78" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283234}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e9b14a36-f374-5fea-92c5-1f777c17e46a" :question/math-academy-id "q-328355" :question/problem "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+6y=11$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+6y & =11 \\\\ 4({x}^{2}-2x)-({y}^{2}-6y) & =11 \\\\ 4[(x-1)^{2}-1]-[(y-3)^{2}-9] & =11 \\\\ 4(x-1)^{2}-4-(y-3)^{2}+9 & =11 \\\\ 4(x-1)^{2}-(y-3)^{2} & =11+4-9 \\\\ 4(x-1)^{2}-(y-3)^{2} & =6 \\\\ \\frac{(x-1)^{2}}{3/2}-\\frac{(y-3)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,3\\,).$"}] [{:db/id #edb/ref 17592186283236 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eea4c868-4ace-54ba-85db-5048b99b029d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186283238}] :answer-field/correct {:answer/id #uuid "eea4c868-4ace-54ba-85db-5048b99b029d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186283238} :answer-field/id #uuid "3465dba8-859f-5411-b6d2-0c46ff7c4828" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283237} {:answer-field/choices [{:answer/id #uuid "d9d39615-e366-59b6-b3d8-142cea001e00" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283240}] :answer-field/correct {:answer/id #uuid "d9d39615-e366-59b6-b3d8-142cea001e00" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283240} :answer-field/id #uuid "6f527782-e8a6-5aae-8aed-cfdfc0882d56" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283239}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "09c64bd9-77f7-5f17-9820-6fbba82bdb70" :question/math-academy-id "q-328392" :question/problem "The center of the hyperbola $-{x}^{2}+16{y}^{2}-32y-8x=16$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}+16{y}^{2}-32y-8x & =16 \\\\ 16{y}^{2}-32y-{x}^{2}-8x & =16 \\\\ 16[{y}^{2}-2y]-[{x}^{2}+8x] & =16 \\\\ 16[(y-1)^{2}-1]-[(x+4)^{2}-16] & =16 \\\\ 16(y-1)^{2}-16-(x+4)^{2}+16 & =16 \\\\ 16(y-1)^{2}-(x+4)^{2} & =16 \\\\ \\frac{(y-1)^{2}}{1}-\\frac{(x+4)^{2}}{16} & =1 \\\\ \\frac{(y-1)^{2}}{1}-\\frac{(x-(-4))^{2}}{16} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,-4,1\\,).$"}] [{:db/id #edb/ref 17592186083846 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1f496c6-06de-58ab-a6cc-238587303c5a" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186082443} {:answer/id #uuid "cf93fdb0-6325-51f7-b966-89117123cb32" :answer/type {:db/ident :answer.type/math} :answer/value "(5, 1)" :db/id #edb/ref 17592186082444} {:answer/id #uuid "d8da84e4-47c6-5c50-97f1-8c6c44153f12" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186082445} {:answer/id #uuid "e5ea4f80-5a09-5ea8-8323-1bae494c88b1" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 5)" :db/id #edb/ref 17592186082446} {:answer/id #uuid "145ef716-8cda-5b27-abf2-b4aa2a22abfe" :answer/type {:db/ident :answer.type/math} :answer/value "(2, 4)" :db/id #edb/ref 17592186082447}] :answer-field/correct {:answer/id #uuid "cf93fdb0-6325-51f7-b966-89117123cb32" :answer/type {:db/ident :answer.type/math} :answer/value "(5, 1)" :db/id #edb/ref 17592186082444} :answer-field/id #uuid "5c04a11b-f8c3-59e6-ac9e-ec1ba5b563b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082442}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6d1ce982-0517-57cd-b99f-ed09b083d84e" :question/math-academy-id "q-78353" :question/problem "What is the center of the hyperbola $\\frac{(y-1)^{2}}{16}-\\frac{(x-5)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nIn this case, we have $h=5$ and $k=1.$\n\nTherefore, the center of the hyperbola is $(5,1).$"}]}
