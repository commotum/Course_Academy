rt/verification.json"} {"question" "q-98912" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{9}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/state.json" "file_sha256" "083cedc3fdd0b85d3812a558fb198fdeb4c2ea77e8dc02263f48a93d29350d43" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-98912" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/state.json" "file_sha256" "083cedc3fdd0b85d3812a558fb198fdeb4c2ea77e8dc02263f48a93d29350d43" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-158447" "field" nil "attribute" "question/problem" "value" "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}+1}{k},\\, & 1<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/state.json" "file_sha256" "083cedc3fdd0b85d3812a558fb198fdeb4c2ea77e8dc02263f48a93d29350d43" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-158447" "field" nil "attribute" "question/worked-solution" "value" "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x & =\\frac{1}{k}{\\int }_{1}^{4}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{k}{[\\frac{{x}^{3}}{3}+x]}_{1}^{4} \\\\  & =\\frac{1}{k}([\\frac{64}{3}+4]-[\\frac{1}{3}+1]) \\\\  & =\\frac{1}{k}(21+3) \\\\  & =\\frac{24}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{24}{k}=1\\,⟹\\,k=24.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/state.json" "file_sha256" "083cedc3fdd0b85d3812a558fb198fdeb4c2ea77e8dc02263f48a93d29350d43" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-158447" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/activity-metadata.json" "file_sha256" "c4a186e5aecfa61e70d4fe50418f4589eebd79ebb36f78dff23bdee1ce36e317" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-158447" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/state.json" "file_sha256" "083cedc3fdd0b85d3812a558fb198fdeb4c2ea77e8dc02263f48a93d29350d43" "basis" 1402 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040017/edb-import/verification.json"} {"question" "q-158447" "field" "sele