#{[{:db/id #edb/ref 17592186292933 :knowledge-point/_questions [{:knowledge-point/id #uuid "c41ffe1b-e741-58bf-9844-83fbc6bc7030" :knowledge-point/title "Parametrizing a Horizontal Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1517160e-72ad-5e62-b00e-77c5174e7637" :answer/type {:db/ident :answer.type/math} :answer/value "x=8t,\\,\\,y=4{t}^{2}" :db/id #edb/ref 17592186292935} {:answer/id #uuid "4c37a600-251f-5021-8b4a-7c39f479aabd" :answer/type {:db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186292936} {:answer/id #uuid "8593643e-a3bc-58d5-a042-5fb0852cb852" :answer/type {:db/ident :answer.type/math} :answer/value "x=4t,\\,\\,y=4{t}^{2}" :db/id #edb/ref 17592186292937} {:answer/id #uuid "34823243-63af-5fde-9cf1-abd6fabad0ed" :answer/type {:db/ident :answer.type/math} :answer/value "x=8{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186292938} {:answer/id #uuid "7bbc21b6-a647-59d6-8f35-47f31ea9a034" :answer/type {:db/ident :answer.type/math} :answer/value "x=4{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186292939}] :answer-field/correct {:answer/id #uuid "7bbc21b6-a647-59d6-8f35-47f31ea9a034" :answer/type {:db/ident :answer.type/math} :answer/value "x=4{t}^{2},\\,\\,y=8t" :db/id #edb/ref 17592186292939} :answer-field/id #uuid "c89ea158-23e5-5e30-88f9-2466f575924a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292934}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1f6617b3-b325-5f1d-a6de-a4539212e656" :question/math-academy-id "q-106421" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=16x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =16x \\\\ 4p & =16 \\\\ p & =4.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(4){t}^{2},\\,y=2(4)t,\n$$\n\nwhich simplify to\n\n$$\nx=4{t}^{2},\\,y=8t.\n$$"}] [{:db/id #edb/ref 17592186292940 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccc7f71-d2e0-5f35-80a5-042a53eda2da" :knowledge-point/title "Finding the Cartesian Equation of a Parabola Given Its Parametric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f803e75-9b26-5e64-a1d6-7b797e1d6f4b" :answer/type {:db/ident :answer.type/math} :answer/value "-3y" :db/id #edb/ref 17592186292942}] :answer-field/correct {:answer/id #uuid "1f803e75-9b26-5e64-a1d6-7b797e1d6f4b" :answer/type {:db/ident :answer.type/math} :answer/value "-3y" :db/id #edb/ref 17592186292942} :answer-field/id #uuid "e99c9df6-f2cc-5ed9-a171-8462a5376590" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292941}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fe4c9ac-c3be-5ca2-8785-0a4e82bd680c" :question/math-academy-id "q-280361" :question/problem "Consider the following parabola:\n\n$$\nx=-2t,\\,y=-\\frac{4}{3}{t}^{2},\\,t\\in (-\\infty ,\\infty )\n$$\n\nThe Cartesian equation of the parabola is\n\n${x}^{2}=$\n{{field-1}}." :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =-\\frac{x}{2},\\,{t}^{2}=-\\frac{3y}{4}.\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{{x}^{2}}{4}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-\\frac{3y}{4}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4} & =-\\frac{3y}{4} \\\\ {x}^{2} & =-3y\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${x}^{2}=-3y.$"}] [{:db/id #edb/ref 17592186292943 :knowledge-point/_questions [{:knowledge-point/id #uuid "c41ffe1b-e741-58bf-9844-83fbc6bc7030" :knowledge-point/title "Parametrizing a Horizontal Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117bc97b-159e-5f39-ae0b-5622a3e8cdd5" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=t" :db/id #edb/ref 17592186292945} {:answer/id #uuid "9c782378-7a17-5bfd-8b36-6ecb1e1ae9f0" :answer/type {:db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186292946} {:answer/id #uuid "7f2d9e68-a412-52df-bab4-bbe886a1f0f4" :answer/type {:db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=2t" :db/id #edb/ref 17592186292947} {:answer/id #uuid "fd7cd036-f557-5ad8-80f5-2d359137642c" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186292948} {:answer/id #uuid "25faf918-8669-5623-96c0-13e9863656c2" :answer/type {:db/ident :answer.type/math} :answer/value "x=4{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186292949}] :answer-field/correct {:answer/id #uuid "9c782378-7a17-5bfd-8b36-6ecb1e1ae9f0" :answer/type {:db/ident :answer.type/math} :answer/value "x=2{t}^{2},\\,\\,y=4t" :db/id #edb/ref 17592186292946} :answer-field/id #uuid "6c7489d0-5022-5856-a7a9-edd1a1b530fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292944}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a9145c40-11b6-5c53-84a9-a35178e11e5a" :question/math-academy-id "q-84713" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=8x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =8x \\\\ 4p & =8 \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(2){t}^{2},\\,y=2(2)t,\n$$\n\nwhich simplify to\n\n$$\nx=2{t}^{2},\\,y=4t.\n$$"}] [{:db/id #edb/ref 17592186292950 :knowledge-point/_questions [{:knowledge-point/id #uuid "c41ffe1b-e741-58bf-9844-83fbc6bc7030" :knowledge-point/title "Parametrizing a Horizontal Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abf67c92-8439-5da3-ad32-3da71bae0baa" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186292952} {:answer/id #uuid "ae81af5a-897c-57ba-8234-a67aeaa3bd01" :answer/type {:db/ident :answer.type/math} :answer/value "x=-{t}^{2},\\,\\,y=-t" :db/id #edb/ref 17592186292953} {:answer/id #uuid "c9f03f2d-b0f2-5cc9-8aef-0a322494a651" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2{t}^{2},\\,\\,y=-t" :db/id #edb/ref 17592186292954} {:answer/id #uuid "89da28e5-b2d4-5d5d-a1af-c408847123e4" :answer/type {:db/ident :answer.type/math} :answer/value "x=2t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186292955} {:answer/id #uuid "e40f87dc-ceb0-574a-a0b2-21274b385970" :answer/type {:db/ident :answer.type/math} :answer/value "x=-{t}^{2},\\,\\,y=-2t" :db/id #edb/ref 17592186292956}] :answer-field/correct {:answer/id #uuid "e40f87dc-ceb0-574a-a0b2-21274b385970" :answer/type {:db/ident :answer.type/math} :answer/value "x=-{t}^{2},\\,\\,y=-2t" :db/id #edb/ref 17592186292956} :answer-field/id #uuid "3211c247-545e-56e6-8770-74f762989612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292951}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bce7fc99-bd19-5e4a-b792-a3131930ed98" :question/math-academy-id "q-84716" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14030835/assets/85894c676349da1794c2b4e3ab3add867fbe9e91037bee060e3592039c3850cf.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is horizontal, has its vertex at $(0,0),$ and passes through the point $(-4,4).$\n\nThe parametric equations of a horizontal parabola that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(-4,4),$ we can substitute $x=-4$ and $y=4$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}-4=p{t}^{2} \\\\ 4=2pt.\\end{aligned}\n$$\n\nSolving the second equation for $t,$ we have\n\n$$\n\\begin{aligned}4 & =2pt \\\\ 2 & =pt \\\\ t & =\\frac{2}{p}.\\end{aligned}\n$$\n\nSubstituting this into the first equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-4 & =p{(\\frac{2}{p})}^{2} \\\\ -4 & =p\\cdot \\frac{4}{{p}^{2}} \\\\ -4 & =\\frac{4}{p} \\\\ p & =-1.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(-1){t}^{2},\\,y=2(-1)t,\n$$\n\nwhich simplify to\n\n$$\nx=-{t}^{2},\\,y=-2t.\n$$"}] [{:db/id #edb/ref 17592186292957 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccc7f71-d2e0-5f35-80a5-042a53eda2da" :knowledge-point/title "Finding the Cartesian Equation of a Parabola Given Its Parametric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b45ce23d-deea-5ff7-96e3-9653a68a49c3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{4}{3}x" :db/id #edb/ref 17592186292959} {:answer/id #uuid "32678392-1bba-5f12-8f68-7faff3019212" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=\\frac{1}{2}x" :db/id #edb/ref 17592186292960} {:answer/id #uuid "1f86edc9-61b4-536a-9240-09ba49787893" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x" :db/id #edb/ref 17592186292961} {:answer/id #uuid "244f01a1-6ea3-5947-b99b-1fba8ffc55a9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=6x" :db/id #edb/ref 17592186292962} {:answer/id #uuid "6ff5b688-26ff-5bb0-b5dc-41961fc7548b" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=12x" :db/id #edb/ref 17592186292963}] :answer-field/correct {:answer/id #uuid "6ff5b688-26ff-5bb0-b5dc-41961fc7548b" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=12x" :db/id #edb/ref 17592186292963} :answer-field/id #uuid "804885a6-7eac-53cc-82bc-50894af38ab2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292958}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ed5bc52d-bb18-523c-9f90-f507332dc970" :question/math-academy-id "q-84732" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx=3{t}^{2},\\,y=6t,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{x}{3},\\,t=\\frac{y}{6}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{{y}^{2}}{36}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=\\frac{x}{3}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{36} & =\\frac{x}{3} \\\\ {y}^{2} & =12x\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${y}^{2}=12x.$"}]}
