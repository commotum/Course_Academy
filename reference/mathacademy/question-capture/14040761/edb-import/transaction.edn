5037ecf8d078e"] :db/ensure [:answer-field/validate]} {:db/id "q-8266" :question/id #uuid "e4d06b79-4480-5290-8b5b-dc93437c54b8" :question/math-academy-id "q-8266" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡\\frac{\\pi }{6}=\\frac{\\sqrt{3}}{2}$ and $\\operatorname{sin}⁡\\frac{\\pi }{6}=\\frac{1}{2}$, we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})) \\\\  & =2(\\frac{\\sqrt{3}}{2}+\\text{i}\\frac{1}{2}) \\\\  & =\\sqrt{3}+\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8266/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-8266"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107551/selection/90b8e11d08515b62046dced1122aafbf87f886137cf8e9c602a4e896a3a16b0e" :answer/id #uuid "6c3f78e1-9c4d-52eb-bbbf-a302f170d0d2" :answer/type :answer.type/math :answer/value "z=-1-\\sqrt{2}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-107551/selection/8a9a909eb80172cdb343d276983a8aac41d0a89af6726b9d6690391540f2cbc7" :answer/id #uuid "5ce99d14-18bb-5f38-b196-557bb5512fd8" :answer/type :answer.type/math :answer/value "z=1+\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-107551/selection/35b59fe762539dfd2dd4736b4ddf163c75f328134864c9dfb931de4417e21b5b" :answer/id #uuid "abedc3a5-6965-50fc-9319-4b18d60c1cc6" :answer/type :answer.type/math :answer/value "z=-1+\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-107551/selection/26629db449ba7f7b64a167e566028cb8d08205a2fa53c7704f0883eda6c33fc8" :answer/id #uuid "9e38bef1-fe15-57c1-8076-d53c3f6063f0" :answer/type :answer.type/math :answer/value "z=-\\sqrt{2}+\\sqrt{2}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-107551/selection/a8e9a5abccd284101412a5f4fc5954c41cbcb0edf1fb08139c76142c686c4ad6" :answer/id #uuid "a95f7a1f-87ac-50f7-b8f4-96b911f15185" :answer/type :answer.type/math :answer/value "z=1-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-107551/selection" :answer-field/id #uuid "2942c6e2-cf46-5fff-99ce-4aa59c31c21a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107551/selection/35b59fe762539dfd2dd4736b4ddf163c75f328134864c9dfb931de4417e21b5b" :answer-field/choices ["q-107551/selection/90b8e11d08515b62046dced1122aafbf87f886137cf8e9c602a4e896a3a16b0e" "q-107551/selection/8a9a909eb80172cdb343d276983a8aac41d0a89af6726b9d6690391540f2cbc7" "q-107551/selection/35b59fe762539dfd2dd4736b4ddf163c75f328134864c9dfb931de4417e21b5b" "q-107551/selection/26629db449ba7f7b64a167e566028cb8d08205a2fa53c7704f0883eda6c33fc8" "q-107551/selection/a8e9a5abccd284101412a5f4fc5954c41cbcb0edf1fb08139c76142c686c4ad6"] :db/ensure [:answer-field/validate]} {:db/id "q-107551" :question/id #uuid "02d6fd52-a861-5d95-bf24-0c758b7ad072" :question/math-academy-id "q-107551" :question/problem "Express $z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{3\\pi }{4})$ and $\\operatorname{sin}⁡(\\frac{3\\pi }{4}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4})) \\\\  & =\\sqrt{2}(-\\frac{\\sqrt{2}}{2}+\\text{i}\\frac{\\sqrt{2}}{2}) \\\\  & =-1+\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107551/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-107551"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321307/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "22836923-fc03-5402-8141-9222a52d1559" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-321307/field-1" :answer-field/id #uuid "fcdfea74-cd57-53fa-a391-fbee5222088f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321307/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-321307/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-321307/field-2/9b223a0ab365daa4b5a2181b47705c4fbc769ef9e67ad9150396a67e2722390d" :answer/id #uuid "02d0f4e4-5e64-5947-9cef-a798925d9689" :answer/type :answer.type/math :answer/value "8\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-321307/field-2" :answer-field/id #uuid "2c2bc6e8-f55d-59d1-adbd-4b9f68ff80c2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321307/field-2/9b223a0ab365daa4b5a2181b47705c4fbc769ef9e67ad9150396a67e2722390d" :answer-field/choices ["q-321307/field-2/9b223a0ab365daa4b5a2181b47705c4fbc769ef9e67ad9150396a67e2722390d"] :db/ensure [:answer-field/validate]} {:db/id "q-321307" :question/id #uuid "365db755-fb52-5c7a-bece-457b5b41e9cb" :question/math-academy-id "q-321307" :question/problem "Express $z=16(\\operatorname{cos}⁡(\\frac{5\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{3}))$ in the form $z=x+y\\,\\text{i},$ where $x$ and $y$ are real numbers. Give the **exact** values of $x$ and $y.$\n\n$z=$\n{{field-1}}\n$-$\n{{field-2}}\n$i$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{5\\pi }{3})$ and $\\operatorname{sin}⁡(\\frac{5\\pi }{3}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{5\\pi }{3}) & =\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{5\\pi }{3}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =-\\frac{\\sqrt{3}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =16(\\operatorname{cos}⁡(\\frac{5\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{3})) \\\\  & =16(\\frac{1}{2}-\\text{i}\\,\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{16}{2}-\\text{i}\\,\\frac{16\\sqrt{3}}{2} \\\\  & =8-8\\sqrt{3}\\,\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321307/field-1" "q-321307/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-321307"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321424/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a9bc2dd0-cf2a-5f41-9231-eda114df3c3e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-321424/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "09232dfa-fe99-536e-80da-2db98dd035ff" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-321424/field-1" :answer-field/id #uuid "a28a222d-f0d5-5bac-804e-c69e6b02c9f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321424/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-321424/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-321424/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-321424/field-2/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer/id #uuid "4f3c984f-7ba8-5a96-870e-fc1ec80bcea3" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-321424/field-2" :answer-field/id #uuid "3fffe176-6bcc-59ec-b8e8-030c88ae46f6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321424/field-2/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer-field/choices ["q-321424/field-2/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3"] :db/ensure [:answer-field/validate]} {:db/id "q-321424/field-3/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer/id #uuid "545c4246-9974-54b1-8ec6-a5b2499773b8" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-321424/field-3" :answer-field/id #uuid "8b6215b3-96fb-58fa-aec1-29a0827d183a" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321424/field-3/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer-field/choices ["q-321424/field-3/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3"] :db/ensure [:answer-field/validate]} {:db/id "q-321424" :question/id #uuid "ae148b77-e89c-5896-b914-e16652165b9b" :question/math-academy-id "q-321424" :question/problem "Express $z=\\frac{6}{1+\\sqrt{3}\\,\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$ Give the **exact** values of $r$ and $\\theta ,$ in **radians** from $[0,2\\pi ).$\n\n$z=$\n{{field-1}}$\\cdot (\\operatorname{cos}⁡(${{field-2}}$)+i\\operatorname{sin}⁡(${{field-3}}$))$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1-\\sqrt{3}\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{6}{1+\\sqrt{3}\\,\\text{i}} \\\\  & =\\frac{6(1-\\sqrt{3}\\,\\text{i})}{(1+\\sqrt{3}\\,\\text{i})(1-\\sqrt{3}\\text{i})} \\\\  & =\\frac{6(1-\\sqrt{3}\\,\\text{i})}{{1}^{2}-(\\sqrt{3}\\,\\text{i})^{2}} \\\\  & =\\frac{6(1-\\sqrt{3}\\,\\text{i})}{1-(-3)} \\\\  & =\\frac{6(1-\\sqrt{3}\\,\\text{i})}{4} \\\\  & =\\frac{3}{2}-\\frac{3\\sqrt{3}}{2}\\text{i}\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{3}{2}-\\frac{3\\sqrt{3}}{2}\\text{i},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{(\\frac{3}{2})}^{2}+{(\\frac{3\\sqrt{3}}{2})}^{2}} \\\\  & =\\sqrt{\\frac{9}{4}+\\frac{27}{4}} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{3}{2}>0$ and $y=-\\frac{3\\sqrt{3}}{2}<0,$ $z$ lies in the fourth quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡(\\frac{|y|}{x}) \\\\  & =2\\pi -\\operatorname{arctan}⁡(\\frac{\\frac{3\\sqrt{3}}{2}}{\\frac{3}{2}}) \\\\  & =2\\pi -\\operatorname{arctan}⁡(\\sqrt{3}) \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=3(\\operatorname{cos}⁡(\\frac{5\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{3}))\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321424/field-1" "q-321424/field-2" "q-321424/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36"] :knowledge-point/questions ["q-321424"] :db/ensure [:knowledge-point/validate]} {:db/id "q-324223/field-1/d1404352b4278ea1ce4dd9f5f5934bf19d3b00d8bd3163b8c388b8d2cea512ea" :answer/id #uuid "bf278238-c70a-5c68-bf66-08ca033b3a83" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{170}}{10}" :db/ensure [:answer/validate]} {:db/id "q-324223/field-1" :answer-field/id #uuid "e180222b-8362-5e96-9e39-d3d2806cd5e4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-324223/field-1/d1404352b4278ea1ce4dd9f5f5934bf19d3b00d8bd3163b8c388b8d2cea512ea" :answer-field/choices ["q-324223/field-1/d1404352b4278ea1ce4dd9f5f5934bf19d3b00d8bd3163b8c388b8d2cea512ea"] :db/ensure [:answer-field/validate]} {:db/id "q-324223/field-2/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f" :answer/id #uuid "fd1aec4b-91b6-5331-9907-c8b3d65e3fc0" :answer/type :answer.type/math :answer/value "4.79" :db/ensure [:answer/validate]} {:db/id "q-324223/field-2" :answer-field/id #uuid "f46ce93f-c626-5a80-8475-739a4309ee23" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-324223/field-2/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f" :answer-field/choices ["q-324223/field-2/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f"] :db/ensure [:answer-field/validate]} {:db/id "q-324223/field-3/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f" :answer/id #uuid "935ea1ad-535f-5dd5-9989-aac5d2ef2cf3" :answer/type :answer.type/math :answer/value "4.79" :db/ensure [:answer/validate]} {:db/id "q-324223/field-3" :answer-field/id #uuid "cae47216-9166-51f2-b67d-35decd316af2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-324223/field-3/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f" :answer-field/choices ["q-324223/field-3/eead93b3f63bc87ed039c03ae3231a8a881dc47aa6b65423d21a0778c3eecd1f"] :db/ensure [:answer-field/validate]} {:db/id "q-324223" :question/id #uuid "13701031-121d-510b-a14e-38926f9d51e8" :question/math-academy-id "q-324223" :question/problem "Express $z=\\frac{3-5\\text{i}}{4+2\\,\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$ Give the **exact** value of $r$ and round $\\theta $ in **radians** from $[0,2\\pi )$ to **two decimal places**.\n\n$z=$\n{{field-1}}$\\cdot (cos$ \n$(${{field-2}}$)$\n$+\\,isin$\n$(${{field-3}}$))$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $4-2\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{3-5\\text{i}}{4+2\\text{i}} \\\\  & =\\frac{(3-5\\text{i})(4-2\\text{i})}{(4+2\\text{i})(4-2\\text{i})} \\\\  & =\\frac{12-6\\text{i}-20\\text{i}+10{\\text{i}}^{2}}{{4}^{2}-(2\\text{i})^{2}} \\\\  & =\\frac{12-26\\text{i}-10}{16-(-4)} \\\\  & =\\frac{2-26\\text{i}}{20} \\\\  & =\\frac{1}{10}-\\frac{13}{10}\\text{i}\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{1}{10}-\\frac{13}{10}\\text{i},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{(\\frac{1}{10})}^{2}+{(-\\frac{13}{10})}^{2}} \\\\  & =\\sqrt{\\frac{1+169}{100}} \\\\  & =\\sqrt{\\frac{170}{100}} \\\\  & =\\frac{\\sqrt{170}}{10} \\\\  & =\\frac{\\sqrt{170}}{10}.\\end{aligned}\n$$\n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{1}{10}$ and $y=-\\frac{13}{10},$ $z$ lies in the fourth quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡(\\frac{|y|}{x}) \\\\  & =2\\pi -\\operatorname{arctan}⁡(\\frac{\\frac{13}{10}}{\\frac{1}{10}}) \\\\  & =2\\pi -\\operatorname{arctan}⁡(13) \\\\  & ≈2\\pi -1.49 \\\\  & ≈4.79,\\end{aligned}\n$$\n\nrounded to two decimal places. \n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\frac{\\sqrt{170}}{10}(\\operatorname{cos}⁡(4.79)+\\text{i}\\operatorname{sin}⁡(4.79))\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-324223/field-1" "q-324223/field-2" "q-324223/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36"] :knowledge-point/questions ["q-324223"] :db/ensure [:knowledge-point/validate]}]
