#{[{:db/id #edb/ref 17592186247978 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/title "Differentiating a Natural Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f381c761-2e10-53f1-9d4a-9e7800aec038" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{2}}" :db/id #edb/ref 17592186247980} {:answer/id #uuid "c70a23de-9f2e-522c-abfc-b088d88f14a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186247981} {:answer/id #uuid "2d71c6ca-678c-552b-8d0a-779c3b04815f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186247982} {:answer/id #uuid "1c525a40-4a7d-5469-b35c-f3e6eb0e5671" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186247983} {:answer/id #uuid "2e1b15af-1738-5f1a-afb6-83531eb443b6" :answer/type {:db/ident :answer.type/math} :answer/value "2xln⁡{x}^{2}" :db/id #edb/ref 17592186247984}] :answer-field/correct {:answer/id #uuid "1c525a40-4a7d-5469-b35c-f3e6eb0e5671" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186247983} :answer-field/id #uuid "25d52288-4288-5c92-9b85-b241ab27bd90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247979}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41d94fb1-0796-5126-8532-2f9de9e221a2" :question/is-example false :question/math-academy-id "q-11932" :question/problem "Given that $g(x)=ln⁡{x}^{2}$, find $\\frac{\\text{d}g}{\\text{d}x}.$" :question/worked-solution "First, we express $g(x)$ as the composite function\n\n$$\ng=ln⁡u,\\,u={x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}g}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}g}{\\text{d}x} & =\\frac{\\text{d}g}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot 2x \\\\  & =\\frac{1}{{x}^{2}}\\cdot 2x \\\\  & =\\frac{2x}{{x}^{2}} \\\\  & =\\frac{2\\cancel{x}}{x\\cdot \\cancel{x}} \\\\  & =\\frac{2}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247985 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac7f7e-1e07-57d7-a82a-d6545588c2de" :knowledge-point/title "Differentiating a Natural Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf43511-e31f-5d6d-893e-006e0d204eab" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-1" :db/id #edb/ref 17592186247987} {:answer/id #uuid "7eb98203-e8bd-50b5-8687-f8773184c875" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x" :db/id #edb/ref 17592186247988} {:answer/id #uuid "e1424c1c-6dfb-5277-8789-3ae4c08adda1" :answer/type {:db/ident :answer.type/math} :answer/value "y=x+1" :db/id #edb/ref 17592186247989} {:answer/id #uuid "9b6d1e0d-8be8-5230-95e1-dab4898bd164" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186247990} {:answer/id #uuid "5ac0a9e2-390d-5ca7-8df8-64efe5f989f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x" :db/id #edb/ref 17592186247991}] :answer-field/correct {:answer/id #uuid "9b6d1e0d-8be8-5230-95e1-dab4898bd164" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186247990} :answer-field/id #uuid "d3087ae0-d165-5afc-8bc6-061639664776" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247986}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "21f3cce3-d0bf-56b4-b9d5-792bbb5193fe" :question/is-example false :question/math-academy-id "q-150015" :question/problem "Find the equation of the tangent to the curve $f(x)=ln⁡(2-x)$ at the point $(1,0).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=ln⁡u,\\,u=2-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{u}\\cdot (-1) \\\\  & =\\frac{1}{2-x}\\cdot (-1) \\\\  & =\\frac{1}{x-2}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={\\frac{1}{x-2}|}_{x=1} \\\\  & =\\frac{1}{(1)-2} \\\\  & =-1\\,.\\end{aligned}\n$$\n\nHence, the slope of the tangent line at the point $(1,0)$ is $m=-1.$ Now, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =(-1)\\cdot (x-1) \\\\ y & =-x+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247992 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b3fc3b-89d9-58c4-ad78-9e6dfa48b59f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^4}{x^5-2}" :db/id #edb/ref 17592186247994} {:answer/id #uuid "852ff590-2cf1-56cf-be26-4feb2441563d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^4}{(x^5-2)\\ln(10)}" :db/id #edb/ref 17592186247995}] :answer-field/correct {:answer/id #uuid "852ff590-2cf1-56cf-be26-4feb2441563d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x^4}{(x^5-2)\\ln(10)}" :db/id #edb/ref 17592186247995} :answer-field/id #uuid "f58a6d02-3e67-555d-9c59-624054843415" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247993}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "064aa851-fad2-5beb-a8c7-4269d81d295b" :question/is-example false :question/math-academy-id "q-310149" :question/problem "Given that $y=log⁡({x}^{5}-2),$ find $\\frac{\\text{d}y}{\\text{d}x}$ in terms of $x.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=log⁡(u),\\,u={x}^{5}-2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(10)},\\,\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(10)}\\cdot 5{x}^{4} \\\\  & =\\frac{5{x}^{4}}{({x}^{5}-2)ln⁡(10)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247996 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5ef82dd-f11b-5b24-8748-035aeac1972e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x\\ln(4)}" :db/id #edb/ref 17592186247998}] :answer-field/correct {:answer/id #uuid "f5ef82dd-f11b-5b24-8748-035aeac1972e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x\\ln(4)}" :db/id #edb/ref 17592186247998} :answer-field/id #uuid "305b9e15-be51-5cbf-8746-5cb3a92cf499" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247997}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0ae9e168-e07a-5c2c-b242-60b8c0d52457" :question/is-example false :question/math-academy-id "q-341694" :question/problem "Given that $y={log}_{4}⁡(\\sqrt{7x}),$ find $\\frac{\\text{d}y}{\\text{d}x}$  in terms of $x.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={log}_{4}⁡(u),\\,u=\\sqrt{7x}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(4)},\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{7}{2\\sqrt{7x}}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(4)}\\cdot \\frac{7}{2\\sqrt{7x}} \\\\  & =\\frac{1}{\\sqrt{7x}ln⁡(4)}\\cdot \\frac{7}{2\\sqrt{7x}} \\\\  & =\\frac{7}{2\\cdot 7xln⁡(4)} \\\\  & =\\frac{\\cancel{7}}{2\\cdot \\cancel{7}xln⁡(4)} \\\\  & =\\frac{1}{2xln⁡(4)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247999 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f8408a0-0d1e-5cf0-ab14-bc5a6eab0579" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)ln⁡(10)}" :db/id #edb/ref 17592186248001} {:answer/id #uuid "1a08ad94-8b67-5380-9e71-fad071fdee02" :answer/type {:db/ident :answer.type/math} :answer/value "(1-x)ln⁡(10)" :db/id #edb/ref 17592186248002} {:answer/id #uuid "ddd43c5c-a364-53a2-bcd4-afd9c617def6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{(1-x)}" :db/id #edb/ref 17592186248003} {:answer/id #uuid "efd4f56d-b3c9-5ce0-b212-28d0e4d1d3b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡(10)}{(1-x)}" :db/id #edb/ref 17592186248004} {:answer/id #uuid "bb46fb89-0503-508d-9482-26e80c8d09bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)}" :db/id #edb/ref 17592186248005}] :answer-field/correct {:answer/id #uuid "4f8408a0-0d1e-5cf0-ab14-bc5a6eab0579" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)ln⁡(10)}" :db/id #edb/ref 17592186248001} :answer-field/id #uuid "9d2de6e4-2c0d-5c82-bc58-bd58a9be1088" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248000}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4fb12260-0edc-575d-9430-0fcd1d7f49c9" :question/is-example false :question/math-academy-id "q-51317" :question/problem "Find ${y}^{′}$ for $y=log⁡(1-x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=log⁡u={log}_{10}⁡(u),\\,u=1-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(10)},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(10)}\\cdot (-1) \\\\  & =\\frac{1}{(1-x)ln⁡(10)}\\cdot (-1) \\\\  & =-\\frac{1}{(1-x)ln⁡(10)}.\\end{aligned}\n$$"}]}
