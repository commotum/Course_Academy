#{[{:db/id #edb/ref 17592186340435 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a00fa7-a425-5b28-941c-bc8027676ebe" :knowledge-point/title "Determining the Convergence of a Geometric Series With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e8e8a-c08b-504d-9522-4b571e1104e5" :answer/type {:db/ident :answer.type/text} :answer/value "Inconclusive because $|r|=1.$" :db/id #edb/ref 17592186340437} {:answer/id #uuid "7d375993-39cc-5510-b4be-f6bfb7193bc1" :answer/type {:db/ident :answer.type/text} :answer/value "The series is convergent because $|r|<1.$" :db/id #edb/ref 17592186340438} {:answer/id #uuid "8c90ed99-540e-52fc-a2b5-955e8462447d" :answer/type {:db/ident :answer.type/text} :answer/value "The series is convergent because $|r|\\ge 1.$" :db/id #edb/ref 17592186340439} {:answer/id #uuid "a88a1770-a9ee-5cfc-b628-c0481b143eee" :answer/type {:db/ident :answer.type/text} :answer/value "The series is divergent because $|r|<1.$" :db/id #edb/ref 17592186340440} {:answer/id #uuid "00e8acae-4fe8-52ca-ba24-462ccd477d6f" :answer/type {:db/ident :answer.type/text} :answer/value "The series is divergent because $|r|\\ge 1.$" :db/id #edb/ref 17592186340441}] :answer-field/correct {:answer/id #uuid "7d375993-39cc-5510-b4be-f6bfb7193bc1" :answer/type {:db/ident :answer.type/text} :answer/value "The series is convergent because $|r|<1.$" :db/id #edb/ref 17592186340438} :answer-field/id #uuid "c13a9b3a-f43c-5d7c-9c96-39ce388cd0c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340436}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "70349a80-6da9-5e69-9b25-2638db753518" :question/math-academy-id "q-124898" :question/problem "Which of the following statements is true regarding the series  ${\\sum }_{n=0}^{\\infty }(-2){(-0.75)}^{n}$ ?" :question/worked-solution "The series starts with $n=0.$ So the common ratio is\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{1}}{{a}_{0}} \\\\  & =\\frac{(-2){(-0.75)}^{1}}{(-2){(-0.75)}^{0}} \\\\  & =-0.75.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$"}] [{:db/id #edb/ref 17592186340442 :knowledge-point/_questions [{:knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e603ceb7-1a75-58de-9626-b6bcbf739582" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186340444} {:answer/id #uuid "0cc4e9d3-0e68-5eda-82ad-184c9cd5feeb" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340445} {:answer/id #uuid "be0159d3-a888-5400-8b76-9efd5e8f4a1a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340446} {:answer/id #uuid "bb2133ff-d152-5932-9e2d-9e01b30f9be7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340447} {:answer/id #uuid "26c7b591-d77f-503f-9811-efac150cd7ab" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340448}] :answer-field/correct {:answer/id #uuid "e603ceb7-1a75-58de-9626-b6bcbf739582" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186340444} :answer-field/id #uuid "d6b7e9dc-20a5-5b4b-9cc9-9b5ef0e13ab3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340443}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "42918211-ff75-544f-a50d-12af55938909" :question/math-academy-id "q-124913" :question/problem "Which of the following geometric series converge?\n\n- $162+108+72+48+⋯$\n- $1-\\frac{3}{4}+\\frac{9}{16}-\\frac{27}{64}+⋯$\n- $-10-9-8.1-7.29-⋯$" :question/worked-solution "Let's look at each series in turn.\n\n- For the geometric series $162+108+72+48+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{108}{162} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\n- For the geometric series $1-\\frac{3}{4}+\\frac{9}{16}-\\frac{27}{64}+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-\\frac{3}{4})}{1} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\n- For the geometric series $-10-9-8.1-7.29-⋯$  the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{-9}{-10} \\\\  & =0.9\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\nIn conclusion, series I, II, and III converge."}] [{:db/id #edb/ref 17592186340449 :knowledge-point/_questions [{:knowledge-point/id #uuid "908ce57e-7ca8-5e5f-bdcb-0d2ef79f10ea" :knowledge-point/title "Calculating the Range of Values of a Parameter for Which a Geometric Series Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d79bd4c1-7e26-5e95-848e-2eab15afb9d2" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186340451}] :answer-field/correct {:answer/id #uuid "d79bd4c1-7e26-5e95-848e-2eab15afb9d2" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186340451} :answer-field/id #uuid "5fa13092-77fd-568a-a2a8-7af9553d13fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186340450} {:answer-field/choices [{:answer/id #uuid "e49cbb37-176c-5237-8d13-a0891e5aab05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340453}] :answer-field/correct {:answer/id #uuid "e49cbb37-176c-5237-8d13-a0891e5aab05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340453} :answer-field/id #uuid "104e112c-de94-50c0-a0da-f3ec80691af4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186340452}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "04940bef-7b77-59d4-ab08-b580f0ca2a68" :question/math-academy-id "q-351365" :question/problem "Find the range of values of $k$ for which the series\n${\\sum }_{n=1}^{\\infty }{(\\frac{9}{{81}^{k}})}^{n}$\nconverges. Do not round the answer.\n\n$k$\n{{field-1}}{{field-2}}" :question/worked-solution "We see that this is a geometric series with a common ratio of $r=\\frac{9}{{81}^{k}}.$\n\nFor the series to converge, we require $|r|<1.$ Therefore, we have\n\n$$\n\\begin{aligned}|\\frac{9}{{81}^{k}}| & <1 \\\\ \\frac{9}{{81}^{k}} & <1 \\\\ 9 & <{81}^{k} \\\\ {81}^{k} & >9.\\end{aligned}\n$$\n\nNotice that we could remove the absolute value bars because $\\frac{9}{{81}^{k}}$ is always positive.\n\nThe equation ${81}^{k}=9$ has the solution $k=\\frac{1}{2}.$ Now, since ${81}^{k}$ increases as $k$ increases, the solution to ${81}^{k}>9$ must be $k>\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186340454 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a00fa7-a425-5b28-941c-bc8027676ebe" :knowledge-point/title "Determining the Convergence of a Geometric Series With an Arbitrary Starting Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24253501-ed5d-51b9-a6b9-afed9f12edb0" :answer/type {:db/ident :answer.type/text} :answer/value "The series is convergent because $|r|<1$" :db/id #edb/ref 17592186340456} {:answer/id #uuid "1b314e5b-3658-5b0a-b05e-8881b885b68e" :answer/type {:db/ident :answer.type/text} :answer/value "The series is divergent because $|r|\\ge 1$" :db/id #edb/ref 17592186340457} {:answer/id #uuid "e183ce12-225b-52d0-b0d9-e9305c6f1591" :answer/type {:db/ident :answer.type/text} :answer/value "Inconclusive because $|r|=1$" :db/id #edb/ref 17592186340458} {:answer/id #uuid "4ae9455d-92e4-5bf0-b02b-2a9b584e7d63" :answer/type {:db/ident :answer.type/text} :answer/value "The series is convergent because $|r|\\ge 1$" :db/id #edb/ref 17592186340459} {:answer/id #uuid "cc7a9563-5141-58ab-8d0b-f7918abfaac5" :answer/type {:db/ident :answer.type/text} :answer/value "The series is divergent because $|r|<1$" :db/id #edb/ref 17592186340460}] :answer-field/correct {:answer/id #uuid "1b314e5b-3658-5b0a-b05e-8881b885b68e" :answer/type {:db/ident :answer.type/text} :answer/value "The series is divergent because $|r|\\ge 1$" :db/id #edb/ref 17592186340457} :answer-field/id #uuid "89e4aba7-2fae-5b02-88df-814b813c7624" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340455}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59cf05e8-bced-5671-9530-ca5d2b186e65" :question/math-academy-id "q-40577" :question/problem "Which of the following statements is true regarding the series  ${\\sum }_{n=3}^{\\infty }\\frac{2}{15}{(\\frac{6}{5})}^{n-1}$ ?" :question/worked-solution "The series starts with $n=3.$ So the common ratio is\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{4}}{{a}_{3}} \\\\  & =\\frac{\\frac{2}{15}{(\\frac{6}{5})}^{4-1}}{\\frac{2}{15}{(\\frac{6}{5})}^{3-1}} \\\\  & =\\frac{{(\\frac{6}{5})}^{3}}{{(\\frac{6}{5})}^{2}} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$"}] [{:db/id #edb/ref 17592186340461 :knowledge-point/_questions [{:knowledge-point/id #uuid "908ce57e-7ca8-5e5f-bdcb-0d2ef79f10ea" :knowledge-point/title "Calculating the Range of Values of a Parameter for Which a Geometric Series Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66c2f1e8-2603-5308-87b2-3399bfe87644" :answer/type {:db/ident :answer.type/math} :answer/value "k>2" :db/id #edb/ref 17592186340463} {:answer/id #uuid "92d7606d-c28e-5150-a8cc-0e98be046bdd" :answer/type {:db/ident :answer.type/math} :answer/value "k<1" :db/id #edb/ref 17592186340464} {:answer/id #uuid "3cdcf386-2021-59bb-bffa-79e2726a01cb" :answer/type {:db/ident :answer.type/math} :answer/value "k<4" :db/id #edb/ref 17592186340465} {:answer/id #uuid "ef782d9f-b06b-5152-be13-c41571a3ecde" :answer/type {:db/ident :answer.type/math} :answer/value "k<2" :db/id #edb/ref 17592186340466} {:answer/id #uuid "8caf3ed3-3457-5122-84d0-6e5fe999e035" :answer/type {:db/ident :answer.type/math} :answer/value "k>4" :db/id #edb/ref 17592186340467}] :answer-field/correct {:answer/id #uuid "ef782d9f-b06b-5152-be13-c41571a3ecde" :answer/type {:db/ident :answer.type/math} :answer/value "k<2" :db/id #edb/ref 17592186340466} :answer-field/id #uuid "b22ffd0b-cc79-5274-b7a2-ddf13d214993" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340462}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0ee6fc86-be50-5d6e-9d77-57ae54b68909" :question/math-academy-id "q-50607" :question/problem "For which values of $k$ does the series ${\\sum }_{n=1}^{\\infty }\\frac{{3}^{kn-2}}{{9}^{n-1}}$ converge?" :question/worked-solution "First, we rewrite the series so that it's in the form ${\\sum }_{n=1}^{\\infty }a{r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{{3}^{kn-2}}{{9}^{n-1}} & ={\\sum }_{n=1}^{\\infty }\\frac{{3}^{kn}\\cdot {3}^{-2}}{{9}^{n-1}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{9}(\\frac{{3}^{kn}}{{9}^{n-1}}) \\\\  & ={\\sum }_{n=1}^{\\infty }(\\frac{{3}^{kn}}{{9}^{n}}) \\\\  & ={\\sum }_{n=1}^{\\infty }{(\\frac{{3}^{k}}{9})}^{n}.\\end{aligned}\n$$\n\nWe see that this is a geometric series with a common ratio of $r=\\frac{{3}^{k}}{9}.$ \n\nFor the series to converge, we require $|r|<1.$ Therefore, we have\n\n$$\n\\begin{aligned}|\\frac{{3}^{k}}{9}| & <1 \\\\ \\frac{{3}^{k}}{9} & <1 \\\\ {3}^{k} & <9.\\end{aligned}\n$$\n\nNotice that we could remove the absolute value bars because $\\frac{{3}^{k}}{9}$ is always positive.\n\nThe equation ${3}^{k}=9$ has the solution $k=2.$ Now, since ${3}^{k}$ increases as $k$ increases, the solution to ${3}^{k}<9$ must be $k<2.$"}]}
