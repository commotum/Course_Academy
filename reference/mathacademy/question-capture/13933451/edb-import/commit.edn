245936 1089 "q-319385" 13194139533674 true] [17592186245936 1091 #edb/ref 17592186045463 13194139533674 true] [17592186245936 1100 "Differentiate $\\sqrt{x}tan⁡(x).$\n\n$(\\sqrt{x}tan⁡(x))^{′}=\\frac{tan⁡(x)}{2\\sqrt{x}}\\,+$\n{{field-1}}" 13194139533674 true] [17592186245936 1113 #uuid "5331b913-1534-51bc-898a-115837523a77" 13194139533674 true] [17592186245936 1138 false 13194139533674 true] [17592186245936 1145 "Here, we have the product of the two functions $u(x)=\\sqrt{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(\\sqrt{x}tan⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\sqrt{x})^{′}\\cdot tan⁡(x)+\\sqrt{x}\\cdot (tan⁡(x))^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}(tan⁡(x))+(\\sqrt{x})({sec}^{2}⁡(x)) \\\\  & =\\frac{tan⁡(x)}{2\\sqrt{x}}+\\sqrt{x}{sec}^{2}⁡(x)\\end{aligned}\n$$" 13194139533674 true] [17592186245937 1000 #edb/ref 17592186245938 13194139533674 true] [17592186245937 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245937 1041 "field-1" 13194139533674 true] [17592186245937 1104 #edb/ref 17592186245938 13194139533674 true] [17592186245937 1110 #uuid "240812b4-90d5-5a54-bc15-81b785846fe7" 13194139533674 true] [17592186245938 1034 "\\sqrt{x}\\sec(x)^2" 13194139533674 true] [17592186245938 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245938 1111 #uuid "a9ee957e-1b51-5604-aa79-567e37a99ba6" 13194139533674 true] [17592186245939 1017 #edb/ref 17592186245940 13194139533674 true] [17592186245939 1089 "q-319425" 13194139533674 true] [17592186245939 1091 #edb/ref 17592186045463 13194139533674 true] [17592186245939 1100 "Given that $f(x)={4}^{x}tan⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}ln⁡(4)tan⁡(x)\\,+$\n{{field-1}}" 13194139533674 true] [17592186245939 1113 #uuid "0b6ecc2c-4a26-5a15-81e5-8545e9ddf3a8" 13194139533674 true] [17592186245939 1138 false 13194139533674 true] [17592186245939 1145 "Here, we have the product of two functions $u(x)={4}^{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({4}^{x})}^{′}tan⁡(x)+{4}^{x}{(tan⁡(x))}^{′} \\\\  & =({4}^{x}ln⁡(4))tan⁡(x)+{4}^{x}({sec}^{2}⁡(x)) \\\\  & ={4}^{x}ln⁡(4)tan⁡(x)+{4}^{x}{sec}^{2}⁡(x)\\end{aligned}\n$$" 13194139533674 true] [17592186245940 1000 #edb/ref 17592186245941 13194139533674 true] [17592186245940 1000 #edb/ref 17592186245942 13194139533674 true] [17592186245940 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245940 1041 "field-1" 13194139533674 true] [17592186245940 1104 #edb/ref 17592186245942 13194139533674 true] [17592186245940 1110 #uuid "12c3a932-6fda-5822-8d61-4f184e97290c" 13194139533674 true] [17592186245941 1034 "4^x\\cos(x)" 13194139533674 true] [17592186245941 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245941 1111 #uuid "007d6d89-e391-5bca-ab0c-fed8cee73035" 13194139533674 true] [17592186245942 1034 "4^x\\sec(x)^2" 13194139533674 true] [17592186245942 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245942 1111 #uuid "3deb2f4e-c7cb-5adf-89f2-459e32dc25ca" 13194139533674 true] [17592186245943 1017 #edb/ref 17592186245944 13194139533674 true] [17592186245943 1089 "q-319806" 13194139533674 true] [17592186245943 1091 #edb/ref 17592186045465 13194139533674 true] [17592186245943 1100 "If a curve $C$ is given by $y=(x+2)cos⁡x,$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi }{2}$ is{{field-1}}." 13194139533674 true] [17592186245943 1113 #uuid "341d8268-3e52-5e9c-8d92-5fa8fdd54c6d" 13194139533674 true] [17592186245943 1138 false 13194139533674 true] [17592186245943 1145 "We differentiate using the product rule. Let $u(x)=x+2$ and $v(x)=cos⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x+2)\\cdot (-sin⁡x)+cos⁡x\\cdot 1 \\\\  & =-(x+2)sin⁡x+cos⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi }{2}$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\frac{\\pi }{2}} & =-(\\frac{\\pi }{2}+2)sin⁡\\frac{\\pi }{2}+cos⁡\\frac{\\pi }{2} \\\\  & =-(\\frac{\\pi }{2}+2)(1)+0 \\\\  & =-\\frac{\\pi }{2}-2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{\\pi }{2}-2.$" 13194139533674 true] [17592186245944 1000 #edb/ref 17592186245945 13194139533674 true] [17592186245944 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245944 1041 "field-1" 13194139533674 true] [17592186245944 1104 #edb/ref 17592186245945 13194139533674 true] [17592186245944 1110 #uuid "e2bc35eb-cb18-53a6-a664-4316b59dd9ff" 13194139533674 true] [17592186245945 1034 "-\\frac{\\pi}{2}-2" 13194139533674 true] [17592186245945 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245945 1111 #uuid "af56b612-6a45-559f-b0e4-339ceb6e3c16" 13194139533674 true] [17592186245946 1017 #edb/ref 17592186245947 13194139533674 true] [17592186245946 1089 "q-319829" 13194139533674 true] [17592186245946 1091 #edb/ref 17592186045465 13194139533674 true] [17592186245946 1100 "If a curve $C$ is given by $y=(x-1)ln⁡(4x-3),$ calculate the slope of the tangent line to the curve at the point where $x=1$ is{{field-1}}." 13194139533674 true] [17592186245946 1113 #uuid "119e9e4c-c48a-58b7-ad3b-e8e76b4e81f2" 13194139533674 true] [17592186245946 1138 false 13194139533674 true] [17592186245946 1145 "We differentiate using the product rule. Let $u(x)=x-1$ and $v(x)=ln⁡(4x-3).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{4}{4x-3}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x-1)\\cdot \\frac{4}{4x-3}+ln⁡(4x-3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =(1-1)\\cdot \\frac{4}{4(1)-3}+ln⁡(4(1)-3) \\\\  & =0+ln⁡(1)=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$" 13194139533674 true] [17592186245947 1000 #edb/ref 17592186245948 13194139533674 true] [17592186245947 1000 #edb/ref 17592186245949 13194139533674 true] [17592186245947 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245947 1041 "field-1" 13194139533674 true] [17592186245947 1104 #edb/ref 17592186245949 13194139533674 true] [17592186245947 1110 #uuid "fe6fa0ec-97c7-5d07-9255-9a82b7afae8b" 13194139533674 true] [17592186245948 1034 "4" 13194139533674 true] [17592186245948 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245948 1111 #uuid "14b1edfd-df36-5ac5-82a0-e7771a6bc79a" 13194139533674 true] [17592186245949 1034 "0" 13194139533674 true] [17592186245949 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245949 1111 #uuid "3e8cd0e5-6d6f-5a22-a31e-95b1933fe74a" 13194139533674 true] [17592186245950 1017 #edb/ref 17592186245951 13194139533674 true] [17592186245950 1089 "q-319842" 13194139533674 true] [17592186245950 1091 #edb/ref 17592186045465 13194139533674 true] [17592186245950 1100 "If a curve $C$ is given by $y=({x}^{2}-4x+7){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=0$ is{{field-1}}." 13194139533674 true] [17592186245950 1113 #uuid "4919c5bf-bc12-5af9-8e7c-1d76c4c20ab5" 13194139533674 true] [17592186245950 1138 false 13194139533674 true] [17592186245950 1145 "We differentiate using the product rule. Let $u(x)={x}^{2}-4x+7$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-4,\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{2}-4x+7)\\cdot {e}^{x}+{e}^{x}\\cdot (2x-4) \\\\  & ={e}^{x}({x}^{2}-2x+3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={{e}^{x}({x}^{2}-2x+3)|}_{x=0} \\\\  & =1\\cdot (0-0+3)=3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$" 13194139533674 true] [17592186245951 1000 #edb/ref 17592186245952 13194139533674 true] [17592186245951 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245951 1041 "field-1" 13194139533674 true] [17592186245951 1104 #edb/ref 17592186245952 13194139533674 true] [17592186245951 1110 #uuid "b588f616-32bc-5294-80e6-7534a387f08c" 13194139533674 true] [17592186245952 1034 "3" 13194139533674 true] [17592186245952 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245952 1111 #uuid "7d18b49a-29f3-5d21-a01f-2181aca28330" 13194139533674 true] [17592186245953 1017 #edb/ref 17592186245954 13194139533674 true] [17592186245953 1089 "q-319902" 13194139533674 true] [17592186245953 1091 #edb/ref 17592186045463 13194139533674 true] [17592186245953 1100 "Given that $f(x)={x}^{3}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,{x}^{3}{e}^{x}$" 13194139533674 true] [17592186245953 1113 #uuid "2d339bf7-2068-5f66-88da-f338ed057e57" 13194139533674 true] [17592186245953 1138 false 13194139533674 true] [17592186245953 1145 "Here, we have the product of two functions $u(x)={x}^{3}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{3})^{′}{e}^{x}+{x}^{3}({e}^{x})^{′} \\\\  & =(3{x}^{2})({e}^{x})+({x}^{3})({e}^{x}) \\\\  & =3{x}^{2}{e}^{x}+{x}^{3}{e}^{x}\\end{aligned}\n$$" 13194139533674 true] [17592186245954 1000 #edb/ref 17592186245955 13194139533674 true] [17592186245954 1000 #edb/ref 17592186245956 13194139533674 true] [17592186245954 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245954 1041 "field-1" 13194139533674 true] [17592186245954 1104 #edb/ref 17592186245956 13194139533674 true] [17592186245954 1110 #uuid "8ce5e0fc-e7ef-53ec-b7d1-4b67a28f0f43" 13194139533674 true] [17592186245955 1034 "3xe^x" 13194139533674 true] [17592186245955 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245955 1111 #uuid "908f5813-24e4-5722-af75-7bfad4c49afd" 13194139533674 true] [17592186245956 1034 "3x^2e^x" 13194139533674 true] [17592186245956 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245956 1111 #uuid "95cd1d02-1ad4-5316-bf53-0b4526bf9bf1" 13194139533674 true] [17592186245957 1017 #edb/ref 17592186245958 13194139533674 true] [17592186245957 1089 "q-319903" 13194139533674 true] [17592186245957 1091 #edb/ref 17592186045463 13194139533674 true] [17592186245957 1100 "Given that $f(x)=5{x}^{2}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=10x{e}^{x}\\,+$\n{{field-1}}" 13194139533674 true] [17592186245957 1113 #uuid "48f201c1-c07d-592c-bdf0-148678ba4e79" 13194139533674 true] [17592186245957 1138 false 13194139533674 true] [17592186245957 1145 "Here, we have the product of two functions $u(x)=5{x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(5{x}^{2})^{′}{e}^{x}+5{x}^{2}({e}^{x})^{′} \\\\  & =(10x)({e}^{x})+(5{x}^{2})({e}^{x}) \\\\  & =10x{e}^{x}+5{x}^{2}{e}^{x}\\end{aligned}\n$$" 13194139533674 true] [17592186245958 1000 #edb/ref 17592186245959 13194139533674 true] [17592186245958 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245958 1041 "field-1" 13194139533674 true] [17592186245958 1104 #edb/ref 17592186245959 13194139533674 true] [17592186245958 1110 #uuid "b5099b38-c89e-5815-aeff-ff7eba0b6d69" 13194139533674 true] [17592186245959 1034 "5x^2e^x" 13194139533674 true] [17592186245959 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245959 1111 #uuid "117262d1-644f-51d5-b18e-d7e0cc95d46e" 13194139533674 true] [17592186245960 1017 #edb/ref 17592186245961 13194139533674 true] [17592186245960 1089 "q-320816" 13194139533674 true] [17592186245960 1091 #edb/ref 17592186045463 13194139533674 true] [17592186245960 1100 "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" 13194139533674 true] [17592186245960 1113 #uuid "24eceaef-2370-5c05-b195-43f3fecf97c8" 13194139533674 true] [17592186245960 1138 false 13194139533674 true] [17592186245960 1145 "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})(\\frac{1}{xln⁡(7)}) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$" 13194139533674 true] [17592186245961 1000 #edb/ref 17592186245962 13194139533674 true] [17592186245961 1040 #edb/ref 17592186045449 13194139533674 true] [17592186245961 1041 "field-1" 13194139533674 true] [17592186245961 1104 #edb/ref 17592186245962 13194139533674 true] [17592186245961 1110 #uuid "0c9a2335-1879-5d6c-89b4-4d94cc13d496" 13194139533674 true] [17592186245962 1034 "-5^{-x}\\ln(5)\\left(\\frac{\\ln(x)}{\\ln(7)}\\right)" 13194139533674 true] [17592186245962 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245962 1111 #uuid "2e285f04-b30b-5d66-821a-6e3df0108e3c" 13194139533674 true] [17592186245963 1017 #edb/ref 17592186245964 13194139533674 true] [17592186245963 1089 "q-48516" 13194139533674 true] [17592186245963 1091 #edb/ref 17592186045465 13194139533674 true] [17592186245963 1100 "If a curve $C$ is given by $y={e}^{x}sin⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" 13194139533674 true] [17592186245963 1113 #uuid "cc9975f3-0886-5dd3-9861-8f258d2d4517" 13194139533674 true] [17592186245963 1138 false 13194139533674 true] [17592186245963 1145 "We differentiate using the product rule. Let $u(x)={e}^{x}$ and $v(x)=sin⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x},\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+(sin⁡x)\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & ={{e}^{x}(cos⁡x+sin⁡x)|}_{x=\\pi } \\\\  & ={e}^{\\pi }(-1+0) \\\\  & =-{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-{e}^{\\pi }.$" 13194139533674 true] [17592186245964 1000 #edb/ref 17592186245965 13194139533674 true] [17592186245964 1000 #edb/ref 17592186245966 13194139533674 true] [17592186245964 1000 #edb/ref 17592186245967 13194139533674 true] [17592186245964 1000 #edb/ref 17592186245968 13194139533674 true] [17592186245964 1000 #edb/ref 17592186245969 13194139533674 true] [17592186245964 1040 #edb/ref 17592186045450 13194139533674 true] [17592186245964 1041 "selection" 13194139533674 true] [17592186245964 1104 #edb/ref 17592186245965 13194139533674 true] [17592186245964 1110 #uuid "66567d8c-da1a-5a49-8192-4b1ed8507244" 13194139533674 true] [17592186245965 1034 "-{e}^{\\pi }" 13194139533674 true] [17592186245965 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245965 1111 #uuid "508da6c4-b80d-54e7-bbbb-695d79fd2e33" 13194139533674 true] [17592186245966 1034 "-\\pi {e}^{\\pi }" 13194139533674 true] [17592186245966 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245966 1111 #uuid "17796f93-2d45-52ff-95fe-cbe9dd8c4323" 13194139533674 true] [17592186245967 1034 "\\pi {e}^{\\pi }" 13194139533674 true] [17592186245967 1103 #edb/ref 17592186045453 13194139533674 true] [17592186245967 1111 #uuid "4fc950ac-a57c-5229-91d5-b99f45effd19" 13194139533674 true] [17592186245968 1034 "{e}^{\\pi }" 13194139533674 true] [17592186245968 1103 