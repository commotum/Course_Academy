t rule:\n\n$$\n\\begin{aligned}({e}^{x}cos⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot cos⁡x+{e}^{x}\\cdot (cos⁡x)^{′} \\\\  & =({e}^{x})(cos⁡x)+({e}^{x})(-sin⁡x) \\\\  & ={e}^{x}cos⁡x-{e}^{x}sin⁡x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104297/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77"] :knowledge-point/questions ["q-104297"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1931/selection/778b054fec6d95c6d47f76481f8e53aaea79142ed098e8abf27f07cb9803925c" :answer/id #uuid "d6405989-b549-5549-b1f2-4e0f27d5246f" :answer/type :answer.type/math :answer/value "{e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/ensure [:answer/validate]} {:db/id "q-1931/selection/001dfe8402707630a8fb11115df178a31997c6b99198a42a9dc49729ae75f82d" :answer/id #uuid "05fa68c9-3bb4-59ec-be8a-1ee57b90ff06" :answer/type :answer.type/math :answer/value "{e}^{x}{csc}^{2}⁡x+{e}^{x}tan⁡x" :db/ensure [:answer/validate]} {:db/id "q-1931/selection/87f2fbfa6e13cb33c59158cb30fbf0988f588ef26cfe3a41c061c280b5dc27d0" :answer/id #uuid "08e65ca7-34fb-5cb1-9e45-74398b142a1b" :answer/type :answer.type/math :answer/value "{e}^{x}{sec}^{2}⁡x+tan⁡x" :db/ensure [:answer/validate]} {:db/id "q-1931/selection/3c61bd8f6f07c881cb9d8c0a6f8dcc46a5f4dd528225aac8f48d8fa55b63a8c1" :answer/id #uuid "fe287f89-f1a4-5fd6-aead-acbf238e88bc" :answer/type :answer.type/math :answer/value "{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/ensure [:answer/validate]} {:db/id "q-1931/selection/55397e8ad930a88850524075c3a7ed439b3ecde29b59196293fc368b99b26812" :answer/id #uuid "b000acc0-45e1-554b-8e26-e9cef32982df" :answer/type :answer.type/math :answer/value "{e}^{x}sec⁡x+{e}^{x}{sec}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1931/selection" :answer-field/id #uuid "e5314495-ceb6-51f6-acdd-59565a81e6a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "