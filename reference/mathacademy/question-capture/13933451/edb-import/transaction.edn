answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319350/field-1/cf85052df8c199950a0adba46587c43310d73e516f24c4866700c0d8a456b403" :answer-field/choices ["q-319350/field-1/cf85052df8c199950a0adba46587c43310d73e516f24c4866700c0d8a456b403" "q-319350/field-1/ac4b42f57421d92022b2348206642ab473c8cdb2d8fc8a709950c91c0766f502"] :db/ensure [:answer-field/validate]} {:db/id "q-319350" :question/id #uuid "67285904-f548-5015-a58f-0525bb936013" :question/math-academy-id "q-319350" :question/is-example false :question/problem "Differentiate ${e}^{x}(2+sin⁡(x)).$\n\n$({e}^{x}(2+sin⁡(x)))^{′}=$\n{{field-1}} $+\\,{e}^{x}cos⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=2+sin⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}sec⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot (2+sin⁡(x))+{e}^{x}\\cdot (2+sin⁡(x))^{′} \\\\  & =({e}^{x})(2+sin⁡(x))+({e}^{x})(cos⁡(x)) \\\\  & =(2+sin⁡(x)){e}^{x}+{e}^{x}cos⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319350/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77"] :knowledge-point/questions ["q-319350"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319357/field-1/429d9bc44088520ed725c6ea730c569fa3a930303a55968bd0d707097e7e3d84" :answer/id #uuid "1ae5a149-0c74-5362-94d4-f1d2efbf8241" :answer/type :answer.type/math :answer/value "4x\\cos(x)" :db/ensure [:answer/validate]} {:db/id "q-319357/field-1" :answer-field/id #uuid "a694e1ca-3d1f-5b77-bbec-f633c40dcf83" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319357/field-1/429d9bc44088520ed725c6ea730c569fa3a930303a55968bd0d707097e7e3d84" :answer-field/choices ["q-319357/field-1/429d9bc44088520ed725c6ea730c569fa3a930303a55968bd0d707097e7e3d84"] :db/ensure [:answer-field/validate]} {:db/id "q-319357" :question/id #uuid "55c03f31-8ac1-5a56-a46f-8459d217f2ce" :question/math-academy-id "q-319357" :question/is-example false :question/problem "Differentiate $2{x}^{2}cos⁡(x).$\n\n$(2{x}^{2}cos⁡(x))^{′}=$\n{{field-1}} $-\\,2{x}^{2}sin⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)=2{x}^{2}$ and $v(x)=cos⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(2{x}^{2}cos⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2{x}^{2})^{′}\\cdot cos⁡(x)+2{x}^{2}\\cdot (cos⁡(x))^{′} \\\\  & =(4x)(cos⁡(x))+(2{x}^{2})(-sin⁡(x)) \\\\  & =4xcos⁡(x)-2{x}^{2}sin⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319357/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77"] :knowledge-point/questions ["q-319357"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1934/selection/3975e70ce511141bc86089da52eb6a3a1a1059f87452dbb731a556cd49636c4a" :answer/id #uuid "7c6c61a9-4a9e-5eeb-9400-d216b97e222d" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x}{xln⁡10}+sin⁡xlog⁡x" :db/ensure [:answer/validate]} {:db/id "q-1934/selection/95aa07c0bdd2912be0d5ccd72ac7a93021d41e2acad8f2e480b793d4b206bbd3" :answer/id #uuid "56900f49-fe53-55e2-9d06-0b76dd4c62a9" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/ensure [:answer/validate]} {:db/id "q-1934/selection/9a0cd04e2df57521640f9a991d7375fc98aa618d26430ff74fafd54af0544ab6" :answer/id #uuid "20ce28b2-2d05-5eac-a2f5-25cb2927259c" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x}{ln⁡10}-sin⁡xlog⁡x" :db/ensure [:answer/validate]} {:db/id "q-1934/selection/540a508640c617bdb57f506d3063285cba92b0d2862d623df97af1981ca25faf" :answer/id #uuid "b1f89b35-a54e-5b89-bfd5-e57abaf54257" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x}{x}-sin⁡xlog⁡x" :db/ensure [:answer/validate]} {:db/id "q-1934/selecti