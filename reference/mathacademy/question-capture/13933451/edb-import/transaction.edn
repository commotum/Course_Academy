[{:db/id "q-319385/field-1/39bb893c1b994ff27c4495153cc3cdf8af5cef803baeddc1bfa3e33d9f71808d" :answer/id #uuid "a9ee957e-1b51-5604-aa79-567e37a99ba6" :answer/type :answer.type/math :answer/value "\\sqrt{x}\\sec(x)^2" :db/ensure [:answer/validate]} {:db/id "q-319385/field-1" :answer-field/id #uuid "240812b4-90d5-5a54-bc15-81b785846fe7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319385/field-1/39bb893c1b994ff27c4495153cc3cdf8af5cef803baeddc1bfa3e33d9f71808d" :answer-field/choices ["q-319385/field-1/39bb893c1b994ff27c4495153cc3cdf8af5cef803baeddc1bfa3e33d9f71808d"] :db/ensure [:answer-field/validate]} {:db/id "q-319385" :question/id #uuid "5331b913-1534-51bc-898a-115837523a77" :question/math-academy-id "q-319385" :question/is-example false :question/problem "Differentiate $\\sqrt{x}tan⁡(x).$\n\n$(\\sqrt{x}tan⁡(x))^{′}=\\frac{tan⁡(x)}{2\\sqrt{x}}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=\\sqrt{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(\\sqrt{x}tan⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\sqrt{x})^{′}\\cdot tan⁡(x)+\\sqrt{x}\\cdot (tan⁡(x))^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}(tan⁡(x))+(\\sqrt{x})({sec}^{2}⁡(x)) \\\\  & =\\frac{tan⁡(x)}{2\\sqrt{x}}+\\sqrt{x}{sec}^{2}⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319385/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77"] :knowledge-point/questions ["q-319385"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104297/selection/d97f70a348cab534fd6d6a1dfa9cf17945360fb425c1ce614f811afcc21b14ba" :answer/id #uuid "f33cbbcc-321e-5ce3-a167-b6e07d8a84ba" :answer/type :answer.type/math :answer/value "-{e}^{x}cos⁡x-{e}^{x}sin⁡x" :db/ensure [:answer/validate]} {:db/id "q-104297/selection/8cf2f694bbc7ef89f697272155cddebf714db48b78c640c83f8844006aea