-4d94cc13d496" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320816/field-1/acf1d65c465becf7b713daef31dfc6664bc485c06597a1a22e3310ea6320d591" :answer-field/choices ["q-320816/field-1/acf1d65c465becf7b713daef31dfc6664bc485c06597a1a22e3310ea6320d591"] :db/ensure [:answer-field/validate]} {:db/id "q-320816" :question/id #uuid "24eceaef-2370-5c05-b195-43f3fecf97c8" :question/math-academy-id "q-320816" :question/is-example false :question/problem "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})(\\frac{1}{xln⁡(7)}) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320816/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-320816"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319902/field-1/a0c00213d0c83ae30ecc3297404d3d990148b81263f8e5cf5539c4abf344ae93" :answer/id #uuid "95cd1d02-1ad4-5316-bf53-0b4526bf9bf1" :answer/type :answer.type/math :answer/value "3x^2e^x" :db/ensure [:answer/validate]} {:db/id "q-319902/field-1/7dea4d33bfd7e0a8a0fc2df5b8652f39672b75eae27c4ccd28abacb38ff8ea2d" :answer/id #uuid "908f5813-24e4-5722-af75-7bfad4c49afd" :answer/type :answer.type/math :answer/value "3xe^x" :db/ensure [:answer/validate]} {:db/id "q-319902/field-1" :answer-field/id #uuid "8ce5e0fc-e7ef-53ec-b7d1-4b67a28f0f43" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319902/field-1/a0c00213d0c83ae30ecc3297404d3d990148b81263f8e5cf5539c4abf344ae93" :answer-field/choices ["q-319902/field-1/a0c00213d0c83ae30ecc3297404d3d990148b81263f8e5cf5539c4abf344ae93" "q-319902/field-1/7dea4d33bfd7e0a8a0fc2df5b8652f39672b75eae27c4ccd28abacb38ff8ea2d"] :db/ensure [:answer-field/validate]} {:db/id "q-319902" :question/id #uuid "2d339bf7-2068-5f66-88da-f338ed057e57" :question/math-academy-id "q-319902" :question/is-example false :question/problem "Given that $f(x)={x}^{3}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,{x}^{3}{e}^{x}$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{3}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{3})^{′}{e}^{x}+{x}^{3}({e}^{x})^{′} \\\\  & =(3{x}^{2})({e}^{x})+({x}^{3})({e}^{x}) \\\\  & =3{x}^{2}{e}^{x}+{x}^{3}{e}^{x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319902/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-319902"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319903/field-1/0430b065ac92bd5e9eecd2fe54f26d142bf008199c01a5c11e51018e885e6577" :answer/id #uuid "117262d1-644f-51d5-b18e-d7e0cc95d46e" :answer/type :answer.type/math :answer/value "5x^2e^x" :db/ensure [:answer/validate]} {:db/id "q-319903/field-1" :answer-field/id #uuid "b5099b38-c89e-5815-aeff-ff7eba0b6d69" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319903/field-1/0430b065ac92bd5e9eecd2fe54f26d142bf008199c01a5c11e51018e885e6577" :answer-field/choices ["q-319903/field-1/0430b065ac92bd5e9eecd2fe54f26d142bf008199c01a5c11e51018e885e6577"] :db/ensure [:answer-field/validate]} {:db/id "q-319903" :question/id #uuid "48f201c1-c07d-592c-bdf0-148678ba4e79" :question/math-academy-id "q-319903" :question/is-example false :question/problem "Given that $f(x)=5{x}^{2}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=10x{e}^{x}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=5{x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(5{x}^{2})^{′}{e}^{x}+5{x}^{2}({e}^{x})^{′} \\\\  & =(10x)({e}^{x})+(5{x}^{2})({e}^{x}) \\\\  & =10x{e}^{x}+5{x}^{2}{e}^{x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319903/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-319903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319842/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7d18b49a-29f3-5d21-a01f-2181aca28330" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-319842/field-1" :answer-field/id #uuid "b588f616-32bc-5294-80e6-7534a387f08c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319842/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-319842/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-319842" :question/id #uuid "4919c5bf-bc12-5af9-8e7c-1d76c4c20ab5" :question/math-academy-id "q-319842" :question/is-example false :question/problem "If a curve $C$ is given by $y=({x}^{2}-4x+7){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=0$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{2}-4x+7$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-4,\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{2}-4x+7)\\cdot {e}^{x}+{e}^{x}\\cdot (2x-4) \\\\  & ={e}^{x}({x}^{2}-2x+3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={{e}^{x}({x}^{2}-2x+3)|}_{x=0} \\\\  & =1\\cdot (0-0+3)=3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319842/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-319842"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319829/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3e8cd0e5-6d6f-5a22-a31e-95b1933fe74a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-319829/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "14b1edfd-df36-5ac5-82a0-e7771a6bc79a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-319829/field-1" :answer-field/id #uuid "fe6fa0ec-97c7-5d07-9255-9a82b7afae8b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319829/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-319829/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-319829/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-319829" :question/id #uuid "119e9e4c-c48a-58b7-ad3b-e8e76b4e81f2" :question/math-academy-id "q-319829" :question/is-example false :question/problem "If a curve $C$ is given by $y=(x-1)ln⁡(4x-3),$ calculate the slope of the tangent line to the curve at the point where $x=1$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=x-1$ and $v(x)=ln⁡(4x-3).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{4}{4x-3}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x-1)\\cdot \\frac{4}{4x-3}+ln⁡(4x-3).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =(1-1)\\cdot \\frac{4}{4(1)-3}+ln⁡(4(1)-3) \\\\  & =0+ln⁡(1)=0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319829/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-319829"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48993/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c2073118-60a1-5cd7-a2fd-2d7e050adeb6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-48993/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d7b0fd00-a479-5d89-97fc-630e69d9fd9d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-48993/selection/0d474ca756c76f6ecddcd5fcfb411f0292ef0ce725af778ee27af0d5dc8595bc" :answer/id #uuid "06776ac1-2b07-5ea5-b424-d4df98dec91d" :answer/type :answer.type/math :answer/value "-e" :db/ensure [:answer/validate]} {:db/id "q-48993/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" :answer/id #uuid "235b4182-f195-5f0f-af5f-ef3319f6ecf8" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "q-48993/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "d6b2ac9e-ba6e-5ae8-b082-88cb3a08b53b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-48993/selection" :answer-field/id #uuid "5195554f-a9d7-59e7-a999-266765561a9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48993/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-48993/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-48993/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-48993/selection/0d474ca756c76f6ecddcd5fcfb411f0292ef0ce725af778ee27af0d5dc8595bc" "q-48993/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" "q-48993/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-48993" :question/id #uuid "e8b5cdf9-a868-5624-a5a7-6b797578fa7a" :question/math-academy-id "q-48993" :question/is-example false :question/problem "If a curve $C$ is given by $y=xln⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=e.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=x$ and $v(x)=ln⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =x\\cdot \\frac{1}{x}+(ln⁡x)\\cdot 1 \\\\  & =1+ln⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=e} & =1+ln⁡x \\\\  & =1+ln⁡e \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48993/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-48993"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48516/selection/0d5775caf8caf008b24a23219632040f0ab24811e4a6e7f201f09a3cebf242a5" :answer/id #uuid "508da6c4-b80d-54e7-bbbb-695d79fd2e33" :answer/type :answer.type/math :answer/value "-{e}^{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48516/selection/179b7f72805b908f1d471c7392aeb7a133b0100720ba56a4b9f62c17d0af3b8b" :answer/id #uuid "17796f93-2d45-52ff-95fe-cbe9dd8c4323" :answer/type :answer.type/math :answer/value "-\\pi {e}^{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48516/selection/d4cdb73eb4bce286f56c4b3e0a8b05862d4f6bb9d9eea3a1f57ba237919af600" :answer/id #uuid "49cef95d-4239-5d30-99ec-56044816e650" :answer/type :answer.type/math :answer/value "{e}^{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48516/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "92af597c-f699-54ab-9af9-37d43ec79519" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-48516/selection/360d087a0daa8617ad7fa86661deffb84afb6c8c5ea7933712d066935ea004db" :answer/id #uuid "4fc950ac-a57c-5229-91d5-b99f45effd19" :answer/type :answer.type/math :answer/value "\\pi {e}^{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-48516/selection" :answer-field/id #uuid "66567d8c-da1a-5a49-8192-4b1ed8507244" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48516/selection/0d5775caf8caf008b24a23219632040f0ab24811e4a6e7f201f09a3cebf242a5" :answer-field/choices ["q-48516/selection/0d5775caf8caf008b24a23219632040f0ab24811e4a6e7f201f09a3cebf242a5" "q-48516/selection/179b7f72805b908f1d471c7392aeb7a133b0100720ba56a4b9f62c17d0af3b8b" "q-48516/selection/d4cdb73eb4bce286f56c4b3e0a8b05862d4f6bb9d9eea3a1f57ba237919af600" "q-48516/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-48516/selection/360d087a0daa8617ad7fa86661deffb84afb6c8c5ea7933712d066935ea004db"] :db/ensure [:answer-field/validate]} {:db/id "q-48516" :question/id #uuid "cc9975f3-0886-5dd3-9861-8f258d2d4517" :question/math-academy-id "q-48516" :question/is-example false :question/problem "If a curve $C$ is given by $y={e}^{x}sin⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={e}^{x}$ and $v(x)=sin⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x},\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{x}\\cdot cos⁡x+(sin⁡x)\\cdot {e}^{x} \\\\  & ={e}^{x}(cos⁡x+sin⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & ={{e}^{x}(cos⁡x+sin⁡x)|}_{x=\\pi } \\\\  & ={e}^{\\pi }(-1+0) \\\\  & =-{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-{e}^{\\pi }.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48516/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-48516"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319806/field-1/d7ef74a4fc27e208ed8a6b5ba4972746dd4cd91a7796fab01895ce37b4120f33" :answer/id #uuid "af56b612-6a45-559f-b0e4-339ceb6e3c16" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{2}-2" :db/ensure [:answer/validate]} {:db/id "q-319806/field-1" :answer-field/id #uuid "e2bc35eb-cb18-53a6-a664-4316b59dd9ff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319806/field-1/d7ef74a4fc27e208ed8a6b5ba4972746dd4cd91a7796fab01895ce37b4120f33" :answer-field/choices ["q-319806/field-1/d7ef74a4fc27e208ed8a6b5ba4972746dd4cd91a7796fab01895ce37b4120f33"] :db/ensure [:answer-field/validate]} {:db/id "q-319806" :question/id #uuid "341d8268-3e52-5e9c-8d92-5fa8fdd54c6d" :question/math-academy-id "q-319806" :question/is-example false :question/problem "If a curve $C$ is given by $y=(x+2)cos⁡x,$ then the slope of the tangent line to the curve at the point where $x=\\frac{\\pi }{2}$ is{{field-1}}." :question/worked-solution "We differentiate using the product rule. Let $u(x)=x+2$ and $v(x)=cos⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1,\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(x+2)\\cdot (-sin⁡x)+cos⁡x\\cdot 1 \\\\  & =-(x+2)sin⁡x+cos⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi }{2}$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\frac{\\pi }{2}} & =-(\\frac{\\pi }{2}+2)sin⁡\\frac{\\pi }{2}+cos⁡\\frac{\\pi }{2} \\\\  & =-(\\frac{\\pi }{2}+2)(1)+0 \\\\  & =-\\frac{\\pi }{2}-2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $-\\frac{\\pi }{2}-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319806/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-319806"] :db/ensure [:knowledge-point/validate]}]
