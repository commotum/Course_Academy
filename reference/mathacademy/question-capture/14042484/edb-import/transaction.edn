[{:db/id [:question/math-academy-id "q-4798"] :question/problem "Suppose that $f(x)$ is a  function such that ${\\int }_{6}^{3}\\frac{1}{5}\\,f(x)\\,\\text{d}x=-1$ and ${\\int }_{0}^{3}f(x)\\,\\text{d}x=3.$ What is the value of ${\\int }_{0}^{6}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{6}^{3}\\frac{1}{5}\\,f(x)\\,\\text{d}x & =-1 \\\\ \\frac{1}{5}{\\int }_{6}^{3}\\,f(x)\\,\\text{d}x & =-1 \\\\ -\\frac{1}{5}{\\int }_{3}^{6}f(x)\\,\\text{d}x & =-1 \\\\ {\\int }_{3}^{6}f(x)\\,\\text{d}x & =5\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x \\\\  & =3+5 \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-73340/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "806fdf4b-d184-51a3-b2d1-ebba9540063c" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-73340/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "3491f547-a2d2-5730-bd00-c78d9e565d0e" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-73340/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "e4e5dc23-5514-516b-b1cb-ff25820584aa" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-73340/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "f46aed68-3045-5f14-963c-6577e48a9a92" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-73340/selection/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "7fb7424e-7dce-5bb6-bb2d-583ca746897f" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "q-73340/selection" :answer-field/id #uuid "172a3372-f8ae-5e6c-a3d7-62217779873c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73340/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer-field/choices ["q-73340/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-73340/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" "q-73340/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-73340/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" "q-73340/selection/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a"] :db/ensure [:answer-field/validate]} {:db/id "q-73340" :question/id #uuid "3d18142b-aa1e-57ea-9669-93dca8ee3908" :question/math-academy-id "q-73340" :question/problem "Given that ${\\int }_{3}^{1}\\,f(x)\\,\\text{d}x=-4$, calculate\n${\\int }_{1}^{3}(7f(x)+2)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\,f(x)\\,\\text{d}x=-{\\int }_{3}^{1}\\,f(x)\\,\\text{d}x=4\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}(7f(x)+2)\\,\\text{d}x & =7{\\int }_{1}^{3}f(x)\\,\\text{d}x+2{\\int }_{1}^{3}\\,\\text{d}x \\\\  & =7(4)+2\\cdot x\\,{|}_{1}^{3} \\\\  & =28+2(3-1) \\\\  & =28+4 \\\\  & =32.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73340/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b"] :knowledge-point/questions ["q-73340"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114019/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "49f705ac-2a39-58af-91cf-eaba9be5a7ba" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-114019/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e4b1a8a7-9944-5870-8e81-7e80620cabba" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-114019/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "34a0c263-cabf-54f3-8a79-523f1042ebba" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-114019/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f6cbd999-b9e5-524a-a637-85186fc69ddf" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-114019/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "92291d58-9c29-5d69-b30b-4b37071a27ed" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-114019/selection" :answer-field/id #uuid "df61f736-c1c7-51db-8e7d-78faa3e261ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114019/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-114019/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-114019/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-114019/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-114019/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-114019/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-114019" :question/id #uuid "6209eb05-365f-5911-a012-6087af30a3b6" :question/math-academy-id "q-114019" :question/problem "Given that ${\\int }_{1}^{-1}f(x)\\,\\text{d}x=-1,$ calculate\n${\\int }_{-1}^{1}(f(x)-6x)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}f(x)\\,\\text{d}x=-{\\int }_{1}^{-1}f(x)\\,\\text{d}x=1\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}(f(x)-6x)\\,\\text{d}x & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x-6{\\int }_{-1}^{1}x\\,\\text{d}x \\\\  & =1-6\\cdot \\frac{1}{2}\\cdot {x}^{2}\\,{|}_{-1}^{1} \\\\  & =1-3({1}^{2}-(-1)^{2}) \\\\  & =1-3\\cdot 0 \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114019/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b"] :knowledge-point/questions ["q-114019"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346213/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9c9e9463-cf26-5397-aa9f-1a4cb6b1c09d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-346213/field-1" :answer-field/id #uuid "84427e48-6112-5d6f-b1f0-44c153ce084a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346213/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-346213/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-346213" :question/id #uuid "c37702e7-83e5-59fe-8b7e-6f801a08f386" :question/math-academy-id "q-346213" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x=15$ and ${\\int }_{-1}^{2}f(x)\\,\\text{d}x=1.$ What is the value of ${\\int }_{-1}^{7}f(x)\\,\\text{d}x?$\n\n${\\int }_{-1}^{7}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x & =15 \\\\ (-5){\\int }_{7}^{2}f(x)\\,\\text{d}x & =15 \\\\ 5{\\int }_{2}^{7}f(x)\\,\\text{d}x & =15 \\\\ {\\int }_{2}^{7}f(x)\\,\\text{d}x & =3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{7}f(x)\\,\\text{d}x & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{7}f(x)\\,\\text{d}x \\\\  & =1+3 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346213/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e"] :knowledge-point/questions ["q-346213"] :db/ensure [:knowledge-point/validate]}]
