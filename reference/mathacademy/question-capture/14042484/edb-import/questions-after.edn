#{[{:db/id #edb/ref 17592186315671 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b" :knowledge-point/title "Evaluating an Integral Given Another Integral With Reversed Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f705ac-2a39-58af-91cf-eaba9be5a7ba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315673} {:answer/id #uuid "f6cbd999-b9e5-524a-a637-85186fc69ddf" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186315674} {:answer/id #uuid "34a0c263-cabf-54f3-8a79-523f1042ebba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315675} {:answer/id #uuid "92291d58-9c29-5d69-b30b-4b37071a27ed" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186315676} {:answer/id #uuid "e4b1a8a7-9944-5870-8e81-7e80620cabba" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186315677}] :answer-field/correct {:answer/id #uuid "49f705ac-2a39-58af-91cf-eaba9be5a7ba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186315673} :answer-field/id #uuid "df61f736-c1c7-51db-8e7d-78faa3e261ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186315672}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6209eb05-365f-5911-a012-6087af30a3b6" :question/math-academy-id "q-114019" :question/problem "Given that ${\\int }_{1}^{-1}f(x)\\,\\text{d}x=-1,$ calculate\n${\\int }_{-1}^{1}(f(x)-6x)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}f(x)\\,\\text{d}x=-{\\int }_{1}^{-1}f(x)\\,\\text{d}x=1\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}(f(x)-6x)\\,\\text{d}x & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x-6{\\int }_{-1}^{1}x\\,\\text{d}x \\\\  & =1-6\\cdot \\frac{1}{2}\\cdot {x}^{2}\\,{|}_{-1}^{1} \\\\  & =1-3({1}^{2}-(-1)^{2}) \\\\  & =1-3\\cdot 0 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298332 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ea1e3d-dc06-55ac-96cb-198a85cb5968" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298334} {:answer/id #uuid "40cebf71-b610-58c4-bb42-4fb90ef0f8a6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298335} {:answer/id #uuid "9e86906b-6482-5407-b3fb-54277787c5e1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298336} {:answer/id #uuid "09d10639-77fe-5cb0-9ab7-f266159f785e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298337} {:answer/id #uuid "f61c1445-0106-59a7-b683-c9035bab95a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298338}] :answer-field/correct {:answer/id #uuid "f61c1445-0106-59a7-b683-c9035bab95a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298338} :answer-field/id #uuid "9bdfebfc-1c3e-5a02-9e91-b37099a84576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298333}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "61ddbb4e-de49-5742-b133-eb07be0fd7de" :question/math-academy-id "q-114138" :question/problem "Given that ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=2$ and ${\\int }_{1}^{3}f(x)\\,\\text{d}x=1,$ then what is ${\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{3}f(x)\\,\\text{d}x={\\int }_{-1}^{3}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}2+1 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x \\\\ 3 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x & =2{\\int }_{-1}^{3}f(x)\\,\\text{d}x-3{\\int }_{-1}^{3}\\text{d}x \\\\  & =2\\cdot 3-3\\cdot x\\,{|}_{-1}^{3} \\\\  & =2\\cdot 3-3(3-(-1)) \\\\  & =6-3(4) \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315678 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c9e9463-cf26-5397-aa9f-1a4cb6b1c09d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315680}] :answer-field/correct {:answer/id #uuid "9c9e9463-cf26-5397-aa9f-1a4cb6b1c09d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186315680} :answer-field/id #uuid "84427e48-6112-5d6f-b1f0-44c153ce084a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186315679}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c37702e7-83e5-59fe-8b7e-6f801a08f386" :question/math-academy-id "q-346213" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x=15$ and ${\\int }_{-1}^{2}f(x)\\,\\text{d}x=1.$ What is the value of ${\\int }_{-1}^{7}f(x)\\,\\text{d}x?$\n\n${\\int }_{-1}^{7}f(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{7}^{2}(-5)\\,f(x)\\,\\text{d}x & =15 \\\\ (-5){\\int }_{7}^{2}f(x)\\,\\text{d}x & =15 \\\\ 5{\\int }_{2}^{7}f(x)\\,\\text{d}x & =15 \\\\ {\\int }_{2}^{7}f(x)\\,\\text{d}x & =3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{7}f(x)\\,\\text{d}x & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{7}f(x)\\,\\text{d}x \\\\  & =1+3 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078888 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "860f25bd-cea8-5b65-b376-cb0913b54fe5" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186076540} {:answer/id #uuid "23dc41c5-4635-5f04-8757-c3e0bc36d0da" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186076541} {:answer/id #uuid "2829ac6b-de31-5329-a54f-3c1d21118d27" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186076542} {:answer/id #uuid "28ee6d01-c544-51ca-8a5d-f538b11903b9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186076543} {:answer/id #uuid "6c429e33-50a6-5edf-801e-c13bde0e78ad" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186076544}] :answer-field/correct {:answer/id #uuid "6c429e33-50a6-5edf-801e-c13bde0e78ad" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186076544} :answer-field/id #uuid "ae8b6523-1b19-5916-8ad4-bc753a22b74a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186076539}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "77fb0fc1-711e-5505-92d1-e385391bf5f1" :question/math-academy-id "q-4798" :question/problem "Suppose that $f(x)$ is a  function such that ${\\int }_{6}^{3}\\frac{1}{5}\\,f(x)\\,\\text{d}x=-1$ and ${\\int }_{0}^{3}f(x)\\,\\text{d}x=3.$ What is the value of ${\\int }_{0}^{6}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{6}^{3}\\frac{1}{5}\\,f(x)\\,\\text{d}x & =-1 \\\\ \\frac{1}{5}{\\int }_{6}^{3}\\,f(x)\\,\\text{d}x & =-1 \\\\ -\\frac{1}{5}{\\int }_{3}^{6}f(x)\\,\\text{d}x & =-1 \\\\ {\\int }_{3}^{6}f(x)\\,\\text{d}x & =5\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x \\\\  & =3+5 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186315681 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b" :knowledge-point/title "Evaluating an Integral Given Another Integral With Reversed Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "806fdf4b-d184-51a3-b2d1-ebba9540063c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186315683} {:answer/id #uuid "7fb7424e-7dce-5bb6-bb2d-583ca746897f" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186315684} {:answer/id #uuid "f46aed68-3045-5f14-963c-6577e48a9a92" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186315685} {:answer/id #uuid "e4e5dc23-5514-516b-b1cb-ff25820584aa" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186315686} {:answer/id #uuid "3491f547-a2d2-5730-bd00-c78d9e565d0e" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186315687}] :answer-field/correct {:answer/id #uuid "f46aed68-3045-5f14-963c-6577e48a9a92" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186315685} :answer-field/id #uuid "172a3372-f8ae-5e6c-a3d7-62217779873c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186315682}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3d18142b-aa1e-57ea-9669-93dca8ee3908" :question/math-academy-id "q-73340" :question/problem "Given that ${\\int }_{3}^{1}\\,f(x)\\,\\text{d}x=-4$, calculate\n${\\int }_{1}^{3}(7f(x)+2)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\,f(x)\\,\\text{d}x=-{\\int }_{3}^{1}\\,f(x)\\,\\text{d}x=4\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}(7f(x)+2)\\,\\text{d}x & =7{\\int }_{1}^{3}f(x)\\,\\text{d}x+2{\\int }_{1}^{3}\\,\\text{d}x \\\\  & =7(4)+2\\cdot x\\,{|}_{1}^{3} \\\\  & =28+2(3-1) \\\\  & =28+4 \\\\  & =32.\\end{aligned}\n$$"}]}
