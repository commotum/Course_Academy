#{[{:db/id #edb/ref 17592186298332 :knowledge-point/_questions [{:knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ea1e3d-dc06-55ac-96cb-198a85cb5968" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298334} {:answer/id #uuid "40cebf71-b610-58c4-bb42-4fb90ef0f8a6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298335} {:answer/id #uuid "9e86906b-6482-5407-b3fb-54277787c5e1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298336} {:answer/id #uuid "09d10639-77fe-5cb0-9ab7-f266159f785e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298337} {:answer/id #uuid "f61c1445-0106-59a7-b683-c9035bab95a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298338}] :answer-field/correct {:answer/id #uuid "f61c1445-0106-59a7-b683-c9035bab95a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298338} :answer-field/id #uuid "9bdfebfc-1c3e-5a02-9e91-b37099a84576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298333}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "61ddbb4e-de49-5742-b133-eb07be0fd7de" :question/math-academy-id "q-114138" :question/problem "Given that ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=2$ and ${\\int }_{1}^{3}f(x)\\,\\text{d}x=1,$ then what is ${\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{3}f(x)\\,\\text{d}x={\\int }_{-1}^{3}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}2+1 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x \\\\ 3 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x & =2{\\int }_{-1}^{3}f(x)\\,\\text{d}x-3{\\int }_{-1}^{3}\\text{d}x \\\\  & =2\\cdot 3-3\\cdot x\\,{|}_{-1}^{3} \\\\  & =2\\cdot 3-3(3-(-1)) \\\\  & =6-3(4) \\\\  & =-6.\\end{aligned}\n$$"}]}
