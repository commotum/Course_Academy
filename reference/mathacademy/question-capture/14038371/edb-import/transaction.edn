db224d5c35994d35c5e78344ed6f981dce4aa3f172ed74fff17cdf236c9415be"] :db/ensure [:answer-field/validate]} {:db/id "q-8269" :question/id #uuid "f8802f08-8e40-5ad8-ac69-b3d021d0d2e9" :question/math-academy-id "q-8269" :question/problem "The second-degree Taylor polynomial of $f(x)=(2-3x)^{3/2}$ about $x=0$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & =(2-3x)^{3/2} & ⟹ &  & f(0) & =(2-0)^{3/2}={2}^{3/2} \\\\ {f}^{′}(x) & =-\\frac{9}{2}(2-3x)^{1/2} & ⟹ &  & {f}^{′}(0) & =-\\frac{9}{2}(2-0)^{1/2}=-9\\cdot {2}^{-1/2} \\\\ {f}^{″}(x) & =\\frac{27}{4}(2-3x)^{-1/2} & ⟹ &  & {f}^{″}(0) & =27\\cdot {2}^{-5/2}.\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & ={2}^{3/2}+(-9\\cdot {2}^{-1/2})x+(27\\cdot {2}^{-5/2})(\\frac{1}{2}){x}^{2} \\\\  & ={2}^{3/2}(1-\\frac{9}{4}x+\\frac{27}{32}{x}^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-8269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4"] :knowledge-point/questions ["q-8269"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12383/selection/6946347f5dd2c134a728670d431cedf6e143e89164a1bd0907b742a6839c7948" :answer/id #uuid "cc6b8ab7-d011-5077-860e-cb16ecfb2e12" :answer/type :answer.type/math :answer/value "1-\\frac{\\pi }{2}{x}^{2}+\\frac{{\\pi }^{2}}{8}{x}^{4}" :db/ensure [:answer/validate]} {:db/id "q-12383/selection/590dec3c79e44938fcc6613947c1cf2e12cfc98ed021d9e4dcbf15d82475814b" :answer/id #uuid "a22cc48b-c254-5ec8-807e-d966c51a4664" :answer/type :answer.type/math :answer/value "1+\\frac{\\pi }{2}x+\\frac{{\\pi }^{2}}{8}{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-12383/selection/1ed3e49576fdb95f01475f563ba903dd521f68680cc49f40d0a0247462e79248" :answer/id #uuid "50ed7028-391e-522e-8110-b0a873de4954" :answer/type :answer.type/math :answer/value "x+\\frac{\\pi }{2}{x}^{2}+\\frac{{\\pi }^{3}}{6}{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-12383/selection/98da90c3e6b09e57102d2484b22e413016c1e3362e328948cc5eb1e54319f1da" :answer/id #uuid "08f00f8f-c0dd-56e0-ac0d-c43c1aec6f61" :answer/type :answer.type/math :answer/value "1+\\frac{\\pi }{2}x+\\frac{{\\pi }^{2}}{4}{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-12383/selection/64caba54d4808a2edfa1105ce6e22967127fd1e7b859d2664564776234512045" :answer/id #uuid "32e1a987-a6ab-5b14-99c2-8f3c0bb0862e" :answer/type :answer.type/math :answer/value "\\pi -\\frac{{\\pi }^{2}}{2}x-\\frac{3{\\pi }^{3}}{8}{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-12383/selection" :answer-field/id #uuid "954d6b11-cbcf-5af5-b249-20ab5456910d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12383/selection/590dec3c79e44938fcc6613947c1cf2e12cfc98ed021d9e4dcbf15d82475814b" :answer-field/choices ["q-12383/selection/6946347f5dd2c134a728670d431cedf6e143e89164a1bd0907b742a6839c7948" "q-12383/selection/590dec3c79e44938fcc6613947c1cf2e12cfc98ed021d9e4dcbf15d82475814b" "q-12383/selection/1ed3e49576fdb95f01475f563ba903dd521f68680cc49f40d0a0247462e79248" "q-12383/selection/98da90c3e6b09e57102d2484b22e413016c1e3362e328948cc5eb1e54319f1da" "q-12383/selection/64caba54d4808a2edfa1105ce6e22967127fd1e7b859d2664564776234512045"] :db/ensure [:answer-field/validate]} {:db/id "q-12383" :question/id #uuid "1c1d62a7-d9e8-5f26-a49a-895681b28399" :question/math-academy-id "q-12383" :question/problem "The second-degree Taylor polynomial of $f(x)={e}^{\\pi x/2}$ about $x=0$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & ={e}^{\\pi x/2} & ⟹ &  & f(0) & =1 \\\\ {f}^{′}(x) & =\\frac{\\pi }{2}{e}^{\\pi x/2} & ⟹ &  & {f}^{′}(0) & =\\frac{\\pi }{2} \\\\ {f}^{″}(x) & =\\frac{{\\pi }^{2}}{4}{e}^{\\pi x/2} & ⟹ &  & {f}^{″}(0) & =\\frac{{\\pi }^{2}}{4}\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+(\\frac{\\pi }{2})\\cdot x+(\\frac{{\\pi }^{2}}{4})\\cdot \\frac{1}{2}{x}^{2} \\\\  & =1+\\frac{\\pi }{2}x+\\frac{{\\pi }^{2}}{8}{x}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12383/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4"] :knowledge-point/questions ["q-12383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15638/selection/4422fb1232a5e7384dd7f5a0463a317681fc10ad30c47dcc35ab987a2d844832" :answer/id #uuid "726d1978-99d6-5cf2-9362-a3907988ee9a" :answer/type :answer.type/math :answer/value "\\frac{6}{5}-\\frac{1}{25}(x-5)+\\frac{2}{25}(x-5)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15638/selection/fdbb1c8b593a3b354463f2ed23a0d32f6e9915385c1ed53922e3e6a25b5e7f42" :answer/id #uuid "d6fada2a-52f0-5e47-b42f-728feefc9f03" :answer/type :answer.type/math :answer/value "\\frac{6}{5}-\\frac{1}{25}(x-5)+\\frac{1}{125}(x-5)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15638/selection/d5c360c9aac4acdf3edc05afb69abb23cec28b2e8a93d93791dc7431f626d6c4" :answer/id #uuid "63414612-104b-55ed-882a-3b852a4d75bb" :answer/type :answer.type/math :answer/value "\\frac{6}{5}-\\frac{1}{6}(x-5)+\\frac{1}{24}(x-5)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15638/selection/43f67fca9d482ab97faced27cda66b51438b96a4d794e6a4d2da3cccddcd2f6b" :answer/id #uuid "6df7afc1-44e5-57d1-81e0-8ce284688297" :answer/type :answer.type/math :answer/value "\\frac{6}{5}-\\frac{1}{12}(x-5)+\\frac{1}{24}(x-5)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15638/selection/a703ecbf16c4b2f2c6493c8c1f6d2693d1f9ca55a06c24d327e8fb1378aafda5" :answer/id #uuid "64c6ba85-9c60-5231-a29e-639a25103159" :answer/type :answer.type/math :answer/value "\\frac{6}{5}-\\frac{1}{5}(x-5)+\\frac{2}{125}(x-5)^{2}" :db/ensure [:answer/validate]} {:db/id "q-15638/selection" :answer-field/id #uuid "8b154948-d633-53ed-9cbd-8c8a328b0eb5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15638/selection/fdbb1c8b593a3b354463f2ed23a0d32f6e9915385c1ed53922e3e6a25b5e7f42" :answer-field/choices ["q-15638/selection/4422fb1232a5e7384dd7f5a0463a317681fc10ad30c47dcc35ab987a2d844832" "q-15638/selection/fdbb1c8b593a3b354463f2ed23a0d32f6e9915385c1ed53922e3e6a25b5e7f42" "q-15638/selection/d5c360c9aac4acdf3edc05afb69abb23cec28b2e8a93d93791dc7431f626d6c4" "q-15638/selection/43f67fca9d482ab97faced27cda66b51438b96a4d794e6a4d2da3cccddcd2f6b" "q-15638/selection/a703ecbf16c4b2f2c6493c8c1f6d2693d1f9ca55a06c24d327e8fb1378aafda5"] :db/ensure [:answer-field/validate]} {:db/id "q-15638" :question/id #uuid "63c7a704-6b32-5a2a-994a-73c19c50b774" :question/math-academy-id "q-15638" :question/problem "The second-degree Taylor polynomial of $f(x)=\\frac{x+1}{x}$ about $x=5$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=5,$ we plug $a=5$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(5)+{f}^{′}(5)(x-5)+\\frac{1}{2}{f}^{″}(5)(x-5)^{2}.\n$$\n\nSo, we need to work out $f(5),$ ${f}^{′}(5),$ and ${f}^{″}(5):$ \n\n$$\n\\begin{aligned}f(x) & =\\frac{x+1}{x} & ⟹ &  & f(5) & =\\frac{6}{5} \\\\ {f}^{′}(x) & =-\\frac{1}{{x}^{2}} & ⟹ &  & {f}^{′}(5) & =-\\frac{1}{25} \\\\ {f}^{″}(x) & =2{x}^{-3} & ⟹ &  & {f}^{″}(5) & =\\frac{2}{125}\\end{aligned}\n$$\n\nWe now plug the results for $f(5),$ ${f}^{′}(5),$ and ${f}^{″}(5)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =(\\frac{6}{5})+(-\\frac{1}{25})\\cdot (x-5)+(\\frac{2}{125})\\cdot \\frac{1}{2}(x-5)^{2} \\\\  & =\\frac{6}{5}-\\frac{1}{25}(x-5)+\\frac{1}{125}(x-5)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15638/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4"] :knowledge-point/questions ["q-15638"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81059/selection/602764c7df5493d96a41df7b1e43f6b176fc7746e6dea7e7edcd879542478102" :answer/id #uuid "7e84e586-4594-557e-8a58-7bb94ad7af1d" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-81059/selection/b5348ddf71e5472e38f3abfd1fd508b6086b48d4f20aefdbfcdf24c25a3eb0ab" :answer/id #uuid "e36dd7bb-8f18-5419-96b1-0abf0db3034e" :answer/type :answer.type/math :answer/value "-4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-81059/selection/22879df45f12d03caa6fc4777f904520a0b72bbf0f4efea7d9e05060b02279fe" :answer/id #uuid "a1a8b306-86e6-5d55-be87-1e3917b8a5d6" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-81059/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "0b56f66e-39cc-5d76-b8ee-98cffe2ba845" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-81059/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "35dc4de5-8c28-558c-a14f-6835fc292143" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-81059/selection" :answer-field/id #uuid "7242b31d-06a4-5a77-bbf0-3eae604e6c07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81059/selection/22879df45f12d03caa6fc4777f904520a0b72bbf0f4efea7d9e05060b02279fe" :answer-field/choices ["q-81059/selection/602764c7df5493d96a41df7b1e43f6b176fc7746e6dea7e7edcd879542478102" "q-81059/selection/b5348ddf71e5472e38f3abfd1fd508b6086b48d4f20aefdbfcdf24c25a3eb0ab" "q-81059/selection/22879df45f12d03caa6fc4777f904520a0b72bbf0f4efea7d9e05060b02279fe" "q-81059/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" "q-81059/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0"] :db/ensure [:answer-field/validate]} {:db/id "q-81059" :question/id #uuid "a000ea29-976d-55b5-925a-b906444d88a0" :question/math-academy-id "q-81059" :question/problem "What is the coefficient of ${(x-\\frac{\\pi }{4})}^{2}$ in the second-degree Taylor polynomial of $f(x)=\\operatorname{sin}⁡x$ at $x=\\frac{\\pi }{4}?$" :question/worked-solution "The second-degree Taylor polynomial of $f(x)$ about $x=\\frac{\\pi }{4}$ is given by\n\n$$\n\\begin{aligned}{P}_{2}(x) & =f(\\frac{\\pi }{4})+{f}^{′}(\\frac{\\pi }{4})(x-\\frac{\\pi }{4})+\\frac{1}{2}{f}^{″}(\\frac{\\pi }{4}){(x-\\frac{\\pi }{4})}^{2}.\\end{aligned}\n$$\n\nThe coefficient of ${(x-\\frac{\\pi }{4})}^{2}$ in the above Taylor polynomial is \n\n$$\n\\frac{1}{2}{f}^{″}(\\frac{\\pi }{4}).\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nThen, we evaluate ${f}^{″}(x)$ at $x=\\frac{\\pi }{4}.$ This gives\n\n$$\n{f}^{″}(\\frac{\\pi }{4})=-\\operatorname{sin}⁡(\\frac{\\pi }{4})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nFinally, we determine the coefficient of ${(x-\\frac{\\pi }{4})}^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{f}^{″}(\\frac{\\pi }{4}) & =\\frac{1}{2}\\cdot (-\\frac{\\sqrt{2}}{2})=-\\frac{\\sqrt{2}}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81059/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "039f9f0b-70dd-5360-9240-2260ff706c93"] :knowledge-point/questions ["q-81059"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83722/selection/22879df45f12d03caa6fc4777f904520a0b72bbf0f4efea7d9e05060b02279fe" :answer/id #uuid "d7b8b5f5-ab4d-5b70-97b2-5555312305bf" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-83722/selection/dbca82685519a4df89c377adb9c8376d34a82a93ee260b1599af9b44b5cb96e5" :answer/id #uuid "7399fab9-2996-5294-9040-8497328bab2f" :answer/type :answer.type/math :answer/value "-\\sqrt{2}{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-83722/selection/b6f52a39d48adc2b52e510818472b452abad090345021a5a55bda0a655c3b2a1" :answer/id #uuid "825bbdad-3904-5496-820c-3e3299ef87d2" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-83722/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer/id #uuid "548468ab-77b8-5565-9c0a-e82c2b469e1b" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-83722/selection/d243abe0ff1d550b6549e17edf330456b536359834c4506778d1cf6b1c0906bb" :answer/id #uuid "5033f896-d243-5824-a644-20afd3e3c4f1" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-83722/selection" :answer-field/id #uuid "ff8ed8ad-f0ce-51cf-8e0d-dd4413b29547" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83722/selection/d243abe0ff1d550b6549e17edf330456b536359834c4506778d1cf6b1c0906bb" :answer-field/choices ["q-83722/selection/22879df45f12d03caa6fc4777f904520a0b72bbf0f4efea7d9e05060b02279fe" "q-83722/selection/dbca82685519a4df89c377adb9c8376d34a82a93ee260b1599af9b44b5cb96e5" "q-83722/selection/b6f52a39d48adc2b52e510818472b452abad090345021a5a55bda0a655c3b2a1" "q-83722/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" "q-83722/selection/d243abe0ff1d550b6549e17edf330456b536359834c4506778d1cf6b1c0906bb"] :db/ensure [:answer-field/validate]} {:db/id "q-83722" :question/id #uuid "fd0ce43b-34b9-59f2-b126-b3b72a398da3" :question/math-academy-id "q-83722" :question/problem "What is the coefficient of ${(x-\\frac{1}{4})}^{2}$ in the second-degree Taylor polynomial of $f(x)=\\operatorname{cos}⁡(\\pi x)$ at $x=\\frac{1}{4}?$" :question/worked-solution "The second-degree Taylor polynomial of $f(x)$ about $x=\\frac{1}{4}$ is given by\n\n$$\n\\begin{aligned}{P}_{2}(x) & =f(\\frac{1}{4})+{f}^{′}(\\frac{1}{4})(x-\\frac{1}{4})+\\frac{{f}^{″}(\\frac{1}{4})}{2}{(x-\\frac{1}{4})}^{2}.\\end{aligned}\n$$\n\nThe coefficient of ${(x-\\frac{1}{4})}^{2}$ in the above Taylor polynomial is \n\n$$\n\\frac{{f}^{″}(\\frac{1}{4})}{2}.\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡(\\pi x) \\\\ {f}^{′}(x) & =-\\pi \\operatorname{sin}⁡(\\pi x) \\\\ {f}^{″}(x) & =-{\\pi }^{2}\\operatorname{cos}⁡(\\pi x)\\end{aligned}\n$$\n\nThen, we evaluate ${f}^{″}(x)$ at $x=\\frac{1}{4}.$ This gives\n\n$$\n{f}^{″}(\\frac{1}{4})=-{\\pi }^{2}\\operatorname{cos}⁡(\\pi \\cdot \\frac{1}{4})=-{\\pi }^{2}\\frac{\\sqrt{2}}{2}=-\\frac{\\sqrt{2}{\\pi }^{2}}{2}.\n$$\n\nFinally, we determine the coefficient of ${(x-\\frac{1}{4})}^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{f}^{″}(\\frac{1}{4})}{2} & =\\frac{(-\\frac{\\sqrt{2}{\\pi }^{2}}{2})}{2}=-\\frac{\\sqrt{2}{\\pi }^{2}}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83722/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "039f9f0b-70dd-5360-9240-2260ff706c93"] :knowledge-point/questions ["q-83722"] :db/ensure [:knowledge-point/validate]}]
