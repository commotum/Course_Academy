{log}_{3}⁡(2x))^{2}\\,\\text{d}x & =2x{({log}_{3}⁡(2x))}^{2}-\\frac{4}{\\operatorname{ln}⁡3}(x{log}_{3}⁡(2x)-\\frac{x}{\\operatorname{ln}⁡3}+D) \\\\  & =2x{({log}_{3}⁡(2x))}^{2}-\\frac{4x{log}_{3}⁡(2x)}{\\operatorname{ln}⁡3}+\\frac{4x}{{ln}^{2}⁡3}+C \\\\  & =\\frac{2x{ln}^{2}⁡(2x)}{{ln}^{2}⁡3}-\\frac{4x\\operatorname{ln}⁡(2x)}{{ln}^{2}⁡3}+\\frac{4x}{{ln}^{2}⁡3}+C \\\\  & =\\frac{x}{{ln}^{2}⁡3}(2{ln}^{2}⁡(2x)-4\\operatorname{ln}⁡(2x)+4)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{4D}{\\operatorname{ln}⁡3}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡(2x)=\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡3}.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}2({log}_{3}⁡(2x))^{2}\\,\\text{d}x & ={[\\frac{x}{{ln}^{2}⁡3}(2{ln}^{2}⁡(2x)-4\\operatorname{ln}⁡(2x)+4)]}_{1/2}^{e/2} \\\\  & =\\frac{e/2}{{ln}^{2}⁡3}(2{ln}^{2}⁡e-4\\operatorname{ln}⁡e+4)-\\frac{1/2}{{ln}^{2}⁡3}(2{ln}^{2}⁡1-4\\operatorname{ln}⁡1+4) \\\\  & =\\frac{e/2}{{ln}^{2}⁡3}(2-4+4)-\\frac{1/2}{{ln}^{2}⁡3}(0-0+4) \\\\  & =\\frac{e}{{ln}^{2}⁡3}-\\frac{2}{{ln}^{2}⁡3} \\\\  & =\\frac{1}{{ln}^{2}⁡3}(\\,e-2\\,)\\end{aligned}\n$$" 13194139534510 true] [17592186292580 1000 #edb/ref 17592186292581 13194139534510 true] [17592186292580 1040 #edb/ref 17592186045449 13194139534510 true] [17592186292580 1041 "field-1" 13194139534510 true] [17592186292580 1104 #edb/ref 17592186292581 13194139534510 true] [17592186292580 1110 #uuid "8db07128-df79-56d7-b0ec-6c90fb02153b" 13194139534510 true] [17592186292581 1034 "e-2" 13194139534510 true] [17592186292581 1103 #edb/ref 17592186045453 13194139534510 true] [17592186292581 1111 #uuid "aac3d8cf-44fb-586c-80da-211a2c82db02" 13194139534510 true]] :edb/tempids {"q-346495" 17592186292565 "q-346495/field-1" 17592186292566 "q-346495/field-1/62cc046c7be043c11b5e3b362dd40f4f500f437182b97e2d141ef7a9436903d1" 17592186292567 "q-346495/field-1/b41968dfd230f0cce586e7b6618faef4b0879dbcc45d70b204609b04d6503af6" 