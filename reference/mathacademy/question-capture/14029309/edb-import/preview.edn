cos}⁡x)-\\int (-\\operatorname{cos}⁡x)\\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & ={[6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =(\\frac{3{\\pi }^{2}}{2}-12)-0 \\\\  & =\\frac{3{\\pi }^{2}}{2}-12\\end{aligned}\n$$" 13194139534510 true] [17592186292573 1000 #edb/ref 17592186292574 13194139534510 true] [17592186292573 1000 #edb/ref 17592186292575 13194139534510 true] [17592186292573 1040 #edb/ref 17592186045449 13194139534510 true] [17592186292573 1041 "field-1" 13194139534510 true] [17592186292573 1104 #edb/ref 17592186292575 13194139534510 true] [17592186292573 1110 #uuid "40d323e5-1043-5a99-a402-d3f5e604ca44" 13194139534510 true] [17592186292574 1034 "\\frac{3}{2}\\pi^2+12" 13194139534510 true] [17592186292574 1103 #edb/ref 17592186045453 13194139534510 true] [17592186292574 1111 #uuid "168ff4b3-533f-582d-b25a-979d3efd7f50" 13194139534510 true] [17592186292575 1034 "\\frac{3}{2}\\pi^2-12" 13194139534510 true] [17592186292575 1103 #edb/ref 17592186045453 13194139534510 true] [17592186292575 1111 #uuid "a86f81ec-d4a1-5b3b-a720-98fcd4e8ed18" 13194139534510 true] [17592186292576 1017 #edb/ref 17592186292577 13194139534510 true] [17592186292576 1089 "q-352123" 13194139534510 true] [17592186292576 1091 #edb/ref 17592186045464 13194139534510 true] [17592186292576 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}({log}_{4}⁡x)^{2}\\,\\text{d}x=\\frac{1}{{ln}^{2}⁡(4)}(${{field-1}}$)$" 13194139534510 true] [17592186292576 1113 #uuid "0bf8ad24-049d-5bee-acf8-a2c3a0c8dc34" 13194139534510 true] [17592186292576 1145 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{4}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 1\\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{4}⁡x)}^{2}(x)-\\int (x)(\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}\\int {log}_{4}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{4}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{4}⁡x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 1\\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{4}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{4}⁡x)(x)-\\int (x)(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{log}_{4}⁡x-\\frac{1}{\\operatorname{ln}⁡4}\\int 1\\,\\text{d}x \\\\  & =x{log}_{4}⁡x-\\frac{x}{\\operatorname{ln}⁡4}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}(x{log}_{4}⁡x-\\frac{x}{\\operatorname{ln}⁡4}+D) \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2x{log}_{4}⁡x}{\\operatorname{ln}⁡4}+\\frac{2x}{{ln}^{2}⁡4}+C \\\\  & =\\frac{x{ln}^{2}⁡x}{{ln}^{2}⁡4}-\\frac{2x\\operatorname{ln}⁡x}{{ln}^{2}⁡4}+\\frac{2x}{{ln}^{2}⁡4}+C \\\\  & =\\frac{x}{{ln}^{2}⁡4}({ln}^{2}⁡x-2\\operatorname{ln}⁡x+2)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡4}.$\n\nNote that in the above calculation we used the change of base formula ${log}_{4}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡4}.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}({log}_{4}⁡x)^{2}\\,\\text{d}x & ={[\\frac{x}{{ln}^{2}⁡4}({ln}^{2}⁡x-2\\operatorname{ln}⁡x+2)]}_{1}^{e} \\\\  & =\\frac{e}{{ln}^{2}⁡4}({ln}^{2}⁡e-2\\operatorname{ln}⁡e+2)-\\frac{1}{{ln}^{2}⁡4}({ln}^{2}⁡1-2\\operatorname{ln}⁡1+2) \\\\  & =\\frac{e}{{ln}^{2}⁡4}(1-2+2)-\\frac{1}{{ln}^{2}⁡4}(0-0+2) \\\\  & =\\frac{e}{{ln}^{2}⁡4}-\\frac{2}{{ln}^{2}⁡4} \\\\  & =\\frac{1}{{ln}^{2}⁡4}(\\,e-2\\,)\\end{aligned}\n$$" 13194139534510 true] [17592186292577 1000 #edb/ref 17592186292578 13194139534510 true] [17592186292577 1040 #edb/ref 17592186045449 13194139534510 true] [17592186292577 1041 "field-1" 13194139534510 true] [17592186292577 1104 #edb/ref 17592186292578 13194139534510 true] [17592186292577 1110 #uuid "7abe78d8-9159-538a-bc02-9212a4b9240a" 13194139534510 true] [17592186292578 1034 "e-2" 13194139534510 true] [17592186292578 1103 #edb/ref 17592186045453 13194139534510 true] [17592186292578 1111 #uuid "4c983b27-030e-5f1e-a668-728e74ecac24" 13194139534510 true] [17592186292579 1017 #edb/ref 17592186292580 13194139534510 true] [17592186292579 1089 "q-352124" 13194139534510 true] [17592186292579 1091 #edb/ref 17592186045464 13194139534510 true] [17592186292579 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/2}^{e/2}2({log}_{3}⁡(2x