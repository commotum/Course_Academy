question/difficulty :question.difficulty/easy :question/answer-fields ["q-130070/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-130070"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72757/selection/9295673f718b13b697ff10258354c62c412ad2b5bf277d1162f7b6dab072efb6" :answer/id #uuid "7e7c4fe3-ee5a-52f8-a31e-733c92511db7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72757/selection/65f6e9c18ffd1ef53d0665b5853000689e739fb135f999e171fef45bf10b3845" :answer/id #uuid "e4df7cf2-aac7-553b-877e-6cb67d2a8fca" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -5 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72757/selection/1e45123bace9f9690d7f8c83a48ae2f848f065833d4f2ca80dd8e8c44ce71b61" :answer/id #uuid "192dc6cd-78cd-5304-b7af-df3f1d214d93" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 5 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72757/selection/9f27bc5ff80eb268bae9916f908c4d6510516b58a857cc5e3d9950ffbbdac702" :answer/id #uuid "5e453c45-0417-5b9b-8be2-1eb8139668e4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72757/selection/b261d0c5c3b3a9e3aa09b5c8cc7e5b3c3e7a281114d4f945abb6e75429f0b94b" :answer/id #uuid "641a07f6-019f-5c96-897c-12f9a1738625" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72757/selection" :answer-field/id #uuid "c5a49d2a-631e-5d78-b09d-520420f129e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72757/selection/b261d0c5c3b3a9e3aa09b5c8cc7e5b3c3e7a281114d4f945abb6e75429f0b94b" :answer-field/choices ["q-72757/selection/9295673f718b13b697ff10258354c62c412ad2b5bf277d1162f7b6dab072efb6" "q-72757/selection/65f6e9c18ffd1ef53d0665b5853000689e739fb135f999e171fef45bf10b3845" "q-72757/selection/1e45123bace9f9690d7f8c83a48ae2f848f065833d4f2ca80dd8e8c44ce71b61" "q-72757/selection/9f27bc5ff80eb268bae9916f908c4d6510516b58a857cc5e3d9950ffbbdac702" "q-72757/selection/b261d0c5c3b3a9e3aa09b5c8cc7e5b3c3e7a281114d4f945abb6e75429f0b94b"] :db/ensure [:answer-field/validate]} {:db/id "q-72757" :question/id #uuid "7e529998-60b8-53c0-bae5-50351fb55c46" :question/math-academy-id "q-72757" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ on $T?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+2{R}_{1}$ means that we need to add $2$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:  \n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ -2+(2)(1) & -2+(2)(3) & 1+(2)(2)\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72757/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-72757"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72763/selection/156458bbc4688311344557ee38378d80db478a23f3098803b6c9fadaa0ff4820" :answer/id #uuid "82b27b13-6f43-56cc-b68d-c90d3d58b619" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72763/selection/e24d1658d124acaa1b95dcba72d939e75b6921dd9ce59ed5af177707253ac437" :answer/id #uuid "d7235c6d-1e3b-5b81-94d5-9c906e668fff" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72763/selection/9050fb0de6074d5f254e36057c1005d443aeb12e96ce43e9faece48a1ff00e78" :answer/id #uuid "cc35c5fa-247f-5124-b5a6-f8f94585cd33" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72763/selection/0252a829081e5674f378c26812b5e3c03b385fddd0732aa537ece5becf67b3b7" :answer/id #uuid "5175a431-00e2-5855-9621-7201124c4e00" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 0 & 1 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72763/selection/c4b6cea8bbc80fa5499fd1478428f8a1e23c8cde246234d17471defd3a3f7a6a" :answer/id #uuid "d340fbf3-5924-5ad6-a24b-580c36345a93" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-72763/selection" :answer-field/id #uuid "24f5c6a9-2126-504b-b81d-9e871487c69e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72763/selection/9050fb0de6074d5f254e36057c1005d443aeb12e96ce43e9faece48a1ff00e78" :answer-field/choices ["q-72763/selection/156458bbc4688311344557ee38378d80db478a23f3098803b6c9fadaa0ff4820" "q-72763/selection/e24d1658d124acaa1b95dcba72d939e75b6921dd9ce59ed5af177707253ac437" "q-72763/selection/9050fb0de6074d5f254e36057c1005d443aeb12e96ce43e9faece48a1ff00e78" "q-72763/selection/0252a829081e5674f378c26812b5e3c03b385fddd0732aa537ece5becf67b3b7" "q-72763/selection/c4b6cea8bbc80fa5499fd1478428f8a1e23c8cde246234d17471defd3a3f7a6a"] :db/ensure [:answer-field/validate]} {:db/id "q-72763" :question/id #uuid "7bb79bc8-bcb7-5840-8ed7-f3bc7161c5d4" :question/math-academy-id "q-72763" :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{aligned}]\\,{R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1+(-1)(1) & -1+(-1)(0) & 1+(-1)(2) & 2+(-1)(3)\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72763/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063"] :knowledge-point/questions ["q-72763"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20387/selection/f987ce7d5fddf697fa4a4a4b6b02b89e2c5fd70526acf39d202ff1d578d42a99" :answer/id #uuid "37ef4a59-22e0-5882-8897-e02584f2673b" :answer/type :answer.type/math :answer/value "{R}_{1}:=(-2){R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-20387/selection/8f289b3afb4b65c46944bf713006ce017370b411becc56b66fc92e53870c5e67" :answer/id #uuid "7ac79a0b-4c51-5040-8edd-8a0941cb3d16" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{4}{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-20387/selection/24fb8368f1cc951593e69585e4bd9635221b5cde3ef058fd2a672d3055145a60" :answer/id #uuid "3ed66a36-9c8d-580a-a249-73f97a945541" :answer/type :answer.type/math :answer/value "{R}_{1}:=-\\frac{1}{4}{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-20387/selection/09e445a920c0f0885813446533d10520a9e8298d27a31d7199a78025db0b064e" :answer/id #uuid "59886eec-5b76-5272-81cc-d142ff776816" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}-\\frac{1}{2}{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-20387/selection/721dccafcf1237fcbb8735a8149a6cb424b9a189a14605d85c15bd2037d0261b" :answer/id #uuid "bba9d503-04fd-5495-99de-6490a453477b" :answer/type :answer.type/math :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-20387/selection" :answer-field/id #uuid "b1892170-7ed3-526b-81f1-ab8abb87f797" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20387/selection/721dccafcf1237fcbb8735a8149a6cb424b9a189a14605d85c15bd2037d0261b" :answer-field/choices ["q-20387/selection/f987ce7d5fddf697fa4a4a4b6b02b89e2c5fd70526acf39d202ff1d578d42a99" "q-20387/selection/8f289b3afb4b65c46944bf713006ce017370b411becc56b66fc92e53870c5e67" "q-20387/selection/24fb8368f1cc951593e69585e4bd9635221b5cde3ef058fd2a672d3055145a60" "q-20387/selection/09e445a920c0f0885813446533d10520a9e8298d27a31d7199a78025db0b064e" "q-20387/selection/721dccafcf1237fcbb8735a8149a6cb424b9a189a14605d85c15bd2037d0261b"] :db/ensure [:answer-field/validate]} {:db/id "q-20387" :question/id #uuid "d2a8dbb7-9603-524c-971f-27fd98667b24" :question/math-academy-id "q-20387" :question/problem "Which of the following elementary row operations transforms the matrix $S$ into the matrix $T$, where\n\n$$\nS=[\\begin{aligned}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}],\\,T=[\\begin{aligned}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $2$nd and $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that changes the $1$st  row, we notice that\n\n$$\n\\begin{aligned}S & =[\\begin{aligned}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}] & \\,{R}_{1}:=\\frac{1}{4}\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}] \\\\  & =T.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=\\frac{1}{4}{R}_{1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20387/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd"] :knowledge-point/questions ["q-20387"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72854/selection/58f0a58fcf7431e28dc703d81c5d61549e440b58a4a432d55e1c5c10c7e99505" :answer/id #uuid "f3e50a0a-cfdb-5337-8175-1ace643b47ad" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72854/selection/68251afb7d5265ab2eef8142e64cf8a2285da19da30c63394cdf21243da32ab0" :answer/id #uuid "8b41bef5-0524-5407-a72f-b63576d2085c" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72854/selection/ee27e375b547ea5fc5ad6d5941a6bd59da01a1a078b05a702a9fa77b75f9acc7" :answer/id #uuid "a0057d8d-f392-54e4-b18a-90d49217d312" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+2{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72854/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" :answer/id #uuid "19f9e8f2-f823-52c8-84d1-ca4b330b8994" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72854/selection/d08f3558658610d29715769fc4e3be1ae852695298e29e031b43d08f1c45d01d" :answer/id #uuid "6b5e353f-2098-5235-8784-050c2dabb80b" :answer/type :answer.type/math :answer/value "{R}_{1}↔{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-72854/selection" :answer-field/id #uuid "3c24a5cb-d140-53b2-a14b-ea1b845c083e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72854/selection/68251afb7d5265ab2eef8142e64cf8a2285da19da30c63394cdf21243da32ab0" :answer-field/choices ["q-72854/selection/58f0a58fcf7431e28dc703d81c5d61549e440b58a4a432d55e1c5c10c7e99505" "q-72854/selection/68251afb7d5265ab2eef8142e64cf8a2285da19da30c63394cdf21243da32ab0" "q-72854/selection/ee27e375b547ea5fc5ad6d5941a6bd59da01a1a078b05a702a9fa77b75f9acc7" "q-72854/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" "q-72854/selection/d08f3558658610d29715769fc4e3be1ae852695298e29e031b43d08f1c45d01d"] :db/ensure [:answer-field/validate]} {:db/id "q-72854" :question/id #uuid "0036de8b-5fff-5bbf-814a-73d67f190a9f" :question/math-academy-id "q-72854" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}],\\,W=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}]\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}] \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72854/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd"] :knowledge-point/questions ["q-72854"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72850/selection/afa2f83d83b36db34cd4d81ec4430f2436a044bd20873fcfab45f871263940fd" :answer/id #uuid "57dcaddb-e17a-5319-8391-1bbfaa5e1746" :answer/type :answer.type/math :answer/value "{R}_{2}:=2{R}_{3}+4{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72850/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" :answer/id #uuid "df865a4c-f091-5a19-908c-188da5ffe640" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72850/selection/ca3404a9dcb14c92cd24f70f9b0055193ecb7c3210b66a8ced963edbca9af5f4" :answer/id #uuid "7ce6b170-3815-5197-874e-f691b9c0a607" :answer/type :answer.type/math :answer/value "{R}_{1}↔{R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72850/selection/f8291cb8855f3f343f6897c8e6df825f622606a6aaeb2e1e1b3ddea7849b5f81" :answer/id #uuid "8c33d05c-8340-5f0c-84f4-7b580b4d86e1" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72850/selection/c1fd4f4b99ecd8e8e62f333bc7e32ee22906baf10f2a5bd4cc30ab3c53dfad8f" :answer/id #uuid "51686c06-537b-5183-ad26-a8da2b4f161f" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{2}+(-5){R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72850/selection" :answer-field/id #uuid "b0d16a95-65f1-52c0-9345-aa9b08de7040" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72850/selection/ca3404a9dcb14c92cd24f70f9b0055193ecb7c3210b66a8ced963edbca9af5f4" :answer-field/choices ["q-72850/selection/afa2f83d83b36db34cd4d81ec4430f2436a044bd20873fcfab45f871263940fd" "q-72850/selection/04429f4ea15eb4af81d44cead2195a435aa8607effac07fc8f0664fde9195a2c" "q-72850/selection/ca3404a9dcb14c92cd24f70f9b0055193ecb7c3210b66a8ced963edbca9af5f4" "q-72850/selection/f8291cb8855f3f343f6897c8e6df825f622606a6aaeb2e1e1b3ddea7849b5f81" "q-72850/selection/c1fd4f4b99ecd8e8e62f333bc7e32ee22906baf10f2a5bd4cc30ab3c53dfad8f"] :db/ensure [:answer-field/validate]} {:db/id "q-72850" :question/id #uuid "796dfdc4-dc11-5fb3-8b4d-d35b9831de3e" :question/math-academy-id "q-72850" :question/problem "Which of the following elementary row operations transforms the matrix $U$ into the matrix $V$, where\n\n$$\nU=[\\begin{aligned}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{aligned}],\\,V=[\\begin{aligned}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $2$nd row is the same in both matrices. The only rows that have changed are the $1$st row and the $3$rd row.   \n\nBy considering the given row operations that change both the $1$st and the $3$rd row, we notice that\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{aligned}] & \\,{R}_{1}↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{aligned}] \\\\  & =V.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}↔{R}_{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72850/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd"] :knowledge-point/questions ["q-72850"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72857/selection/dc9e567a5df0d813dbd6450be9aedb528c9186563642d559ec0bf9125e8cd0cb" :answer/id #uuid "e48e34b9-1996-5a03-9337-29b7369721f4" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72857/selection/3e335c7c3959d7e2dc0a68888a23a8bc0fc22b406dfb10a5be283141d740d485" :answer/id #uuid "1d88ecb9-c302-59a1-9893-becd727a2967" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72857/selection/10749f3446ccaafbcbd871abeb60c34683e459cb552f88e989a4a8615d231b6f" :answer/id #uuid "4fcc24ab-b842-55f5-9aa5-a6c3447ebd61" :answer/type :answer.type/math :answer/value "{R}_{3}:=(-1){R}_{3}" :db/ensure [:answer/validate]} {:db/id "q-72857/selection/517aecd147c03db26512f80d832a90c1b3718978e874bb40d2b821dedadf1d11" :answer/id #uuid "6c278518-20f2-57df-8461-04ac38998bd5" :answer/type :answer.type/math :answer/value "{R}_{3}:={R}_{3}+{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-72857/selection/da987fdde44243550a6b097e2597a1e45f2eb05b0dffe7cb31f755964048446b" :answer/id #uuid "655f522a-a132-52e1-9ded-4ff6cf0c12d1" :answer/type :answer.type/math :answer/value "{R}_{3}↔{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-72857/selection" :answer-field/id #uuid "29998fc5-5844-5bc5-b0d5-e8c190f510a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72857/selection/dc9e567a5df0d813dbd6450be9aedb528c9186563642d559ec0bf9125e8cd0cb" :answer-field/choices ["q-72857/selection/dc9e567a5df0d813dbd6450be9aedb528c9186563642d559ec0bf9125e8cd0cb" "q-72857/selection/3e335c7c3959d7e2dc0a68888a23a8bc0fc22b406dfb10a5be283141d740d485" "q-72857/selection/10749f3446ccaafbcbd871abeb60c34683e459cb552f88e989a4a8615d231b6f" "q-72857/selection/517aecd147c03db26512f80d832a90c1b3718978e874bb40d2b821dedadf1d11" "q-72857/selection/da987fdde44243550a6b097e2597a1e45f2eb05b0dffe7cb31f755964048446b"] :db/ensure [:answer-field/validate]} {:db/id "q-72857" :question/id #uuid "98d5b2ef-e0f1-5947-9335-d5945e4a2ed8" :question/math-academy-id "q-72857" :question/problem "Given that\n$C=[\\begin{aligned}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{aligned}]$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$" :question/worked-solution "Of the given options, we consider the row operation    \n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 2 & \\,2 & \\,1\\end{aligned}]\\,{R}_{3}:={R}_{3}+\\frac{1}{2}\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}2 & \\,-4 & \\,\\,-2 \\\\ 0 & \\,-1 & \\,4 \\\\ 3 & \\,0 & \\,0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72