3a1c76dba4342553f9dde4b10c28d8ecf7a08be44af275a505b748e51e9746f6" "q-130064/selection/fe2384b6c14a491a35066e802639a640efea25569edab10cae41a5c814779c1c" "q-130064/selection/6f28cbeb2c03eac79155c286c61b87d8964a2477d99226518f3ae3e944b489d3"] :db/ensure [:answer-field/validate]} {:db/id "q-130064" :question/id #uuid "0b7da60c-f61b-5a37-b863-88993cbe5b14" :question/math-academy-id "q-130064" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=[\\begin{aligned}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{1} & :={R}_{1}-2{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{1}:={R}_{1}-2{R}_{2}$ means that we need to add $-2$ times the second row to the first row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}0 & 4 & 7 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}]\\,{R}_{1}:={R}_{1}+(-2)\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}0+(-2)(5) & 4+(-2)(2) & 7+(-2)(1) \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}] \\\\  & ∼[\\begin{aligned}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1 & 3 & 0\\end{aligned}]\\,{R}_{3}:={R}_{3}+(1)\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 1+(1)(5) & 3+(1)(2) & 0+(1)(1)\\end{aligned}] \\\\  & ∼[\\begin{aligned}-10 & 0 & 5 \\\\ 5 & 2 & 1 \\\\ 6 & 5 & 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130064/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2"] :knowledge-point/questions ["q-130064"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130010/selection/9587fb8e5774dd6754b69423a997aff11e27ce4316979a3219166c84e99d11f1" :answer/id #uuid "543a3da9-cb2d-5855-8f46-085de649bb5d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ -5 & 9 & -11 \\\\ -2 & 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130010/selection/177cd063ce18cbb43a77f6ecd29aef9bd5fd0bea669466ced55729b37d020f16" :answer/id #uuid "8fd9b1f4-d74d-52a3-9aed-e6db9d178847" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ -14 & 3 & -4 \\\\ -2 & 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130010/selection/5216b29b6e15cab25265cd7e9fbd2a85524708566368b8828ce935fefc55f570" :answer/id #uuid "ed2a940f-0183-5b3a-ab68-061004f95a08" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130010/selection/7da818238e528d5d1fb245712618ad16c939535268c72af1135b090ba1b8a518" :answer/id #uuid "52a4e6b3-4a0b-5914-8f6b-15a262b1fdd2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130010/selection/dd821ac1b8798e680882243d94572706469c6818089742d35df40d8390d7494f" :answer/id #uuid "94b6491b-89a0-5970-a0b4-b54e305f7242" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 26 & 19 & -26 \\\\ -2 & 4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130010/selection" :answer-field/id #uuid "09e5f06a-ba45-55fc-8900-093b4ca249e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130010/selection/5216b29b6e15cab25265cd7e9fbd2a85524708566368b8828ce935fefc55f570" :answer-field/choices ["q-130010/selection/9587fb8e5774dd6754b69423a997aff11e27ce4316979a3219166c84e99d11f1" "q-130010/selection/177cd063ce18cbb43a77f6ecd29aef9bd5fd0bea669466ced55729b37d020f16" "q-130010/selection/5216b29b6e15cab25265cd7e9fbd2a85524708566368b8828ce935fefc55f570" "q-130010/selection/7da818238e528d5d1fb245712618ad16c939535268c72af1135b090ba1b8a518" "q-130010/selection/dd821ac1b8798e680882243d94572706469c6818089742d35df40d8390d7494f"] :db/ensure [:answer-field/validate]} {:db/id "q-130010" :question/id #uuid "d1a5db75-1b21-5cae-946a-8cdf4a8b6bd6" :question/math-academy-id "q-130010" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=[\\begin{aligned}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+3{R}_{1} \\\\ {R}_{2} & :={R}_{2}-{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+3{R}_{1}$ means that we need to add $3$ times the first row to the second row.\n\n- The operation ${R}_{2}:={R}_{2}-{R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{aligned}]\\,{R}_{2}:={R}_{2}+3\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 1+(3)(9) & -3+(3)(6) & -2+(3)(-7) \\\\ -2 & 4 & -3\\end{aligned}] \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 28+(-1)(-2) & 15+(-1)(4) & -23+(-1)(-3) \\\\ -2 & 4 & -3\\end{aligned}] \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130010/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2"] :knowledge-point/questions ["q-130010"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130006/selection/c01a65eb1e6c8f7d83d7dca4c272b1e9d5077a0ada8dc3e60c8dac45b4958a4d" :answer/id #uuid "50691937-0cf2-5b