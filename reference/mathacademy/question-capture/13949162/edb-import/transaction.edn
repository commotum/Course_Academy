[{:db/id "q-338396/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2e330232-ea69-5e4d-8860-2f98ad26449f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-338396/field-1" :answer-field/id #uuid "45d17601-5212-57fc-81a0-98a67cf0c81b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338396/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-338396/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-338396" :question/id #uuid "b02345e9-0e5e-51b9-851e-2fb58ece83fd" :question/math-academy-id "q-338396" :question/problem "Find the **exact** value of the limit.\n\n${lim}_{x\\to 2}\\sqrt[3]{\\frac{{x}^{3}}{{x}^{2}-4x+5}}=$\n{{field-1}}" :question/worked-solution "Applying the root and quotient rules, we have that\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt[3]{\\frac{{x}^{3}}{{x}^{2}-4x+5}} & =\\sqrt[3]{{lim}_{x\\to 2}\\frac{{x}^{3}}{{x}^{2}-4x+5}} \\\\  & =\\sqrt[3]{\\frac{{lim}_{x\\to 2}({x}^{3})}{{lim}_{x\\to 2}({x}^{2}-4x+5)}}\\,.\\end{aligned}\n$$\n\nNow, we calculate the limits of the numerator and denominator separately. This gives\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}({x}^{3}) & ={2}^{3} \\\\  & =8\\end{aligned}\n$$\n\nand\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 2}({x}^{2}-4x+5) & ={2}^{2}-4(2)+5 \\\\  & =4-8+5 \\\\  & =1\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{lim}_{x\\to 2}({x}^{3})}{{lim}_{x\\to 2}({x}^{2}-4x+5)}} & =\\sqrt[3]{\\frac{8}{1}} \\\\  & =\\sqrt[3]{8} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338396/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964"] :knowledge-point/questions ["q-338396"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71165/selection/9eae0ecc1ae28e673f9f7209709bcc12cf05d5734cc58f1bb5d624937a3848d6" :answer/id #uuid "e21e2cb9-ae6e-57e6-967d-88f483d8d43c" :answer/type :answer.type/math :answer/value "4{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-71165/selection/3d2eb62e3ff2a42128a081fec0d6a356a166bca22b42a17cb6e6272163d27457" :answer/id #uuid "e332897a-01dd-5fe3-8cee-c5276ad4cb4f" :answer/type :answer.type/math :answer/value "-2{x}^{4}+C" :db/ensure [:answer/validate]} {:db/id "q-71165/selection/76661aa4892c3ccc8fbd269f44866301b9d4d23699f49f39ef3e4c6b9dc802ad" :answer/id #uuid "b7d9ce8f-2464-5c06-b5d3-f5fc0e4c11c0" :answer/type :answer.type/math :answer/value "-4{x}^{4}+C" :db/ensure [:answer/validate]} {:db/id "q-71165/selection/c31499ebdac953c62cd256e86474bcf38f5c9df15b8f3d400d8090bb9fbf8921" :answer/id #uuid "e95cb500-23d2-5f67-b05f-1780d375955d" :answer/type :answer.type/math :answer/value "-2{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-71165/selection/0a9d94f8b38d653e18a292d871f86a38220b3bdb92f725d9e1a1505e3d0c71f3" :answer/id #uuid "12e33dad-ef27-5ccf-ad60-8e847eaaa420" :answer/type :answer.type/math :answer/value "-8{x}^{4}+C" :db/ensure [:answer/validate]} {:db/id "q-71165/selection" :answer-field/id #uuid "e727ef59-70f7-5c46-a80b-fa66bbde8c28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71165/selection/3d2eb62e3ff2a42128a081fec0d6a356a166bca22b42a17cb6e6272163d27457" :answer-field/choices ["q-71165/selection/9eae0ecc1ae28e673f9f7209709bcc12cf05d5734cc58f1bb5d624937a3848d6" "q-71165/selection/3d2eb62e3ff2a42128a081fec0d6a356a166bca22b42a17cb6e6272163d27457" "q-71165/selection/76661aa4892c3ccc8fbd269f44866301b9d4d23699f49f39ef3e4c6b9dc802ad" "q-71165/selection/c31499ebdac953c62cd256e86474bcf38f5c9df15b8f3d400d8090bb9fbf8921" "q-71165/selection/0a9d94f8b38d653e18a292d871f86a38220b3bdb92f725d9e1a1505e3d0c71f3"] :db/ensure [:answer-field/validate]} {:db/id "q-71165" :question/id #uuid "2d8c084f-d8ff-5f92-9569-1953da85c67f" :question/math-academy-id "q-71165" :question/problem "Calculate $\\int (-8{x}^{3})\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-8{x}^{3})\\,\\text{d}x & =-8\\int {x}^{3}\\,\\text{d}x \\\\  & =-8(\\frac{{x}^{3+1}}{3+1})+C \\\\  & =-8\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =-2{x}^{4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71165/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183"] :knowledge-point/questions ["q-71165"] :db/ensure [:knowledge-point/validate]} {:db/id "q-61203/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "548840ce-bd20-5b10-b50f-a91b7d7ea091" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-61203/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ae7d6a32-9f79-595f-9701-65d1479b2a84" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-61203/selection/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e" :answer/id #uuid "ca507321-c66c-52b0-9ef9-342aa994b2cc" :answer/type :answer.type/math :answer/value "-17" :db/ensure [:answer/validate]} {:db/id "q-61203/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "5cdb7f24-414d-5683-bda0-8ab1db998a69" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-61203/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "6cf41f36-7699-53b6-b5d6-ba4baa4e09fd" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-61203/selection" :answer-field/id #uuid "fe064f1e-34bf-5a7e-bb53-e1ade0fca113" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-61203/selection/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e" :answer-field/choices ["q-61203/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-61203/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-61203/selection/c5b1c452fbbf695d51774e4fdb54a1ea7a83bfb5edb76e399d7d1b89ecc5113e" "q-61203/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-61203/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-61203" :question/id #uuid "f33f273d-36a2-559f-8e4a-6a2268d64069" :question/math-academy-id "q-61203" :question/problem "What is the sixth term of the following sequence?\n\n$$\nf(n+2)=f(n+1)+f(n)\\,,\\,f(1)=-4\\,,\\,f(2)=-1,\\,n\\ge 1\n$$" :question/worked-solution "The sixth term is represented by $f(6).$\n\nTo compute $f(6),$ we first need to compute $f(3).$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+2) & =f(n+1)+f(1) \\\\ f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =(-4)+(-1) \\\\ f(3) & =-5\\end{aligned}\n$$\n\nNext, to compute $f(4),$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =(-5)+(-1) \\\\ f(4) & =-6\\end{aligned}\n$$\n\nWe continue this process to compute $f(5)$ and $f(6)$ as follows:\n\n$$\n\\begin{aligned}f(5) & =f(4)+f(3)=(-6)+(-5)=-11 \\\\ f(6) & =f(5)+f(4)=(-11)+(-6)=-17\\end{aligned}\n$$\n\nTherefore, the sixth term of the sequence is $f(6)=-17.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-61203/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614"] :knowledge-point/questions ["q-61203"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1780/selection/a5bcf5044d7131cdf0d721e80125a87ad3d00df1e947910bf38c9dd3889981de" :answer/id #uuid "f85dba1c-97d6-53e6-baec-d3a6a5c0071b" :answer/type :answer.type/math :answer/value "81" :db/ensure [:answer/validate]} {:db/id "q-1780/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "a7514173-15bd-5344-ac61-60534909e8cc" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-1780/selection/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer/id #uuid "a89d47d6-7d72-539d-916d-d2a4b0a4e73b" :answer/type :answer.type/math :answer/value "270" :db/ensure [:answer/validate]} {:db/id "q-1780/selection/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer/id #uuid "ea32e158-9dc8-5e64-ab79-c0914e460f30" :answer/type :answer.type/math :answer/value "180" :db/ensure [:answer/validate]} {:db/id "q-1780/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "9b00320c-eb84-5c33-bdd7-56ce148f1604" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-1780/selection" :answer-field/id #uuid "b380d71c-d89a-5821-8fd0-a2bebb0985dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1780/selection/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer-field/choices ["q-1780/selection/a5bcf5044d7131cdf0d721e80125a87ad3d00df1e947910bf38c9dd3889981de" "q-1780/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-1780/selection/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" "q-1780/selection/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" "q-1780/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-1780" :question/id #uuid "3217b938-6776-57d3-a045-a78f82513de9" :question/math-academy-id "q-1780" :question/problem "Suppose you have $5$ shirts, $4$ pants, and $9$ ties. How many outfits can be made consisting of a shirt, pants, and a tie?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of shirts} \\\\  & \\times \\text{Number of pants} \\\\  & \\times \\text{Number of ties} \\\\  & =5\\times 4\\times 9 \\\\  & =180.\\end{aligned}\n$$\n\nTherefore, $180$ different outfits can be made consisting of a shirt, pants, and a tie." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1780/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6"] :knowledge-point/questions ["q-1780"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64675/selection/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" :answer/id #uuid "e13f9f1f-d973-5f0f-a1e2-78cc78ad8f90" :answer/type :answer.type/text :answer/value "I" :db/ensure [:answer/validate]} {:db/id "q-64675/selection/fedc83039a71afd7ff873189f6d75e2c9ac7feb2068f67bcca48fea646469135" :answer/id #uuid "916946a2-fe6e-5d3c-9a65-a5938c3f018f" :answer/type :answer.type/text :answer/value "Between quadrants III and IV" :db/ensure [:answer/validate]} {:db/id "q-64675/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" :answer/id #uuid "47e0f7a8-cc9e-5974-9a39-877364e06d66" :answer/type :answer.type/text :answer/value "III" :db/ensure [:answer/validate]} {:db/id "q-64675/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" :answer/id #uuid "b1944c40-c2c1-58d9-a917-5856de87e6b0" :answer/type :answer.type/text :answer/value "IV" :db/ensure [:answer/validate]} {:db/id "q-64675/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7" :answer/id #uuid "d5925800-3583-5be3-96c8-f946d72bc2af" :answer/type :answer.type/text :answer/value "II" :db/ensure [:answer/validate]} {:db/id "q-64675/selection" :answer-field/id #uuid "6d1d837e-4fe2-5e72-9a0e-b0299bf13fa4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64675/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" :answer-field/choices ["q-64675/selection/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" "q-64675/selection/fedc83039a71afd7ff873189f6d75e2c9ac7feb2068f67bcca48fea646469135" "q-64675/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" "q-64675/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" "q-64675/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7"] :db/ensure [:answer-field/validate]} {:db/id "q-64675" :question/id #uuid "44ac753e-1a93-50f3-a318-c664d2c32040" :question/math-academy-id "q-64675" :question/problem "The angle $\\theta =-{395}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{395}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{395}^{∘}+{360}^{∘}=-{35}^{∘}$\n\n- $-{395}^{∘}+2\\cdot {360}^{∘}={325}^{∘}\\,✓$\n\nSo the angle ${325}^{∘}$ is coterminal with $-{395}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/936e222cebb005bc504867f26eb2144bb976cab2441e53051121e056be158be1.png)\n\nWe see that ${325}^{∘}$ lies in quadrant IV. Therefore, $-{395}^{∘}$ also lies in this quadrant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64675/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee"] :knowledge-point/questions ["q-64675"] :db/ensure [:knowledge-point/validate]} {:db/id "q-23386/selection/5fd45cec95fc45f99550587cbe4d80dda358c751536fdf37920e2dff6de9568a" :answer/id #uuid "5c4c9fe2-02c0-57c4-9f0a-4478a046fc10" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "q-23386/selection/b5bada3c0a7f51241babbf8faaa936e67ae79cb56c147124d8f537b21afa6e88" :answer/id #uuid "baa0a422-393e-5847-b089-8e6c730e03b3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "q-23386/selection/280a2accdbb908e6be2304801905ce145d56813a9e0824dd3bee048366799bc1" :answer/id #uuid "a3b70270-c393-57a1-b8e3-b392ff96a715" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{7}" :db/ensure [:answer/validate]} {:db/id "q-23386/selection/e9fe03eb46cc37573ec616cc04dc0d03303ea19a17951a98b1d4a181cc97ecac" :answer/id #uuid "76c19521-0ced-57a7-9440-b0815b56bae5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}}{2}" :db/ensure [:answer/validate]} {:db/id "q-23386/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "6b80b6a9-d7e9-5960-88f6-32f69484a819" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-23386/selection" :answer-field/id #uuid "5435d141-7257-5935-83ed-ac313c47213c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-23386/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-23386/selection/5fd45cec95fc45f99550587cbe4d80dda358c751536fdf37920e2dff6de9568a" "q-23386/selection/b5bada3c0a7f51241babbf8faaa936e67ae79cb56c147124d8f537b21afa6e88" "q-23386/selection/280a2accdbb908e6be2304801905ce145d56813a9e0824dd3bee048366799bc1" "q-23386/selection/e9fe03eb46cc37573ec616cc04dc0d03303ea19a17951a98b1d4a181cc97ecac" "q-23386/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8"] :db/ensure [:answer-field/validate]} {:db/id "q-23386" :question/id #uuid "75a1ef17-bd84-5a6f-a321-ae3c8b53dee2" :question/math-academy-id "q-23386" :question/problem "$\\operatorname{sin}⁡(\\frac{2\\pi }{3})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{2\\pi }{3})=\\frac{\\sqrt{3}}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-23386/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b"] :knowledge-point/questions ["q-23386"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113296/selection/cc3781b69c900457a57dd2fe4813a9ec915a5fde3c2aeeb1db8b67468b87ffb4" :answer/id #uuid "04b6c341-9c7f-57c4-887d-d97df4a836d1" :answer/type :answer.type/math :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/ensure [:answer/validate]} {:db/id "q-113296/selection/5efc331b8f8e662dff2fa4362a3c70e7dd80ac1ec6ccfe14c37e78fff1075be9" :answer/id #uuid "181b05a4-3d83-5761-af97-acbe6f928228" :answer/type :answer.type/math :answer/value "\\frac{3+8v}{3+2v}" :db/ensure [:answer/validate]} {:db/id "q-113296/selection/a78848234bc237a1135b0756289eaa5331c1bb523a279f7f169b546d167f3a9b" :answer/id #uuid "854c750f-32a8-56e1-a054-75899195a266" :answer/type :answer.type/math :answer/value "\\frac{3-8v}{2(3+2v)}" :db/ensure [:answer/validate]} {:db/id "q-113296/selection/21a9cf9faa7502c8ae18383d1fbcb019441b531d448fc484dcd19fd416243293" :answer/id #uuid "48fd37dc-102e-54db-bbfb-3a2cbcc44c92" :answer/type :answer.type/math :answer/value "\\frac{2(3+v)}{3+2v}" :db/ensure [:answer/validate]} {:db/id "q-113296/selection/c5455f77648220180f9943e0533cabff2854a75a9bb41d44756f56883b0b2614" :answer/id #uuid "76c40b6e-aa86-56c9-b41d-570a2e53d136" :answer/type :answer.type/math :answer/value "\\frac{5-8v}{2(3+2v)}" :db/ensure [:answer/validate]} {:db/id "q-113296/selection" :answer-field/id #uuid "9bce0baa-80ba-5fc5-88d2-880f32116a15" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113296/selection/cc3781b69c900457a57dd2fe4813a9ec915a5fde3c2aeeb1db8b67468b87ffb4" :answer-field/choices ["q-113296/selection/cc3781b69c900457a57dd2fe4813a9ec915a5fde3c2aeeb1db8b67468b87ffb4" "q-113296/selection/5efc331b8f8e662dff2fa4362a3c70e7dd80ac1ec6ccfe14c37e78fff1075be9" "q-113296/selection/a78848234bc237a1135b0756289eaa5331c1bb523a279f7f169b546d167f3a9b" "q-113296/selection/21a9cf9faa7502c8ae18383d1fbcb019441b531d448fc484dcd19fd416243293" "q-113296/selection/c5455f77648220180f9943e0533cabff2854a75a9bb41d44756f56883b0b2614"] :db/ensure [:answer-field/validate]} {:db/id "q-113296" :question/id #uuid "94656d5b-5501-55b7-ac7e-cff2be11bd02" :question/math-academy-id "q-113296" :question/problem "Given that $\\frac{7v}{2(3+2v)}=t$ and $\\frac{3-5v}{3+2v}=r,$ what is $t+r?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\nt+r=\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(3+2v)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2}{2}\\cdot \\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+6-10v}{2(3+2v)} & = \\\\ \\frac{6-3v}{2(3+2v)} & = \\\\ \\frac{3(2-v)}{2(3+2v)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113296/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31"] :knowledge-point/questions ["q-113296"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13616/selection/a2955f88f577e14b32ef8fabcc4bb70d4cd613455948b707cb3b55e13633d49b" :answer/id #uuid "bf89ce8c-3dad-532f-8eff-ff87b00f8adf" :answer/type :answer.type/math :answer/value "(-4,7)" :db/ensure [:answer/validate]} {:db/id "q-13616/selection/7b3e321f8555564491c682241273e940cb8c08032210dd4c2c6b868682665d2c" :answer/id #uuid "6b324b87-3037-5239-8380-00230f914382" :answer/type :answer.type/math :answer/value "(-4,9)" :db/ensure [:answer/validate]} {:db/id "q-13616/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" :answer/id #uuid "3ce325be-d2cc-5441-8328-1ef2bf8bd000" :answer/type :answer.type/math :answer/value "(-4,6)" :db/ensure [:answer/validate]} {:db/id "q-13616/selection/778c353184dc2f90b9c60c504f37ad8f6d048fa9753af8c9158889f74a47bc06" :answer/id #uuid "8e0f401a-6d08-5342-9a9a-4b3cc5fe0f66" :answer/type :answer.type/math :answer/value "(-4,-6)" :db/ensure [:answer/validate]} {:db/id "q-13616/selection/93fb82ac5f7f057f85da1fe86c7a963325ca548ec91a734e7ea380e050beb566" :answer/id #uuid "ecb4ed72-5fee-5e6e-a9ce-13185b0825a8" :answer/type :answer.type/math :answer/value "(6,4)" :db/ensure [:answer/validate]} {:db/id "q-13616/selection" :answer-field/id #uuid "6884fa24-6da2-5e75-be16-32f1846cdd2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13616/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" :answer-field/choices ["q-13616/selection/a2955f88f577e14b32ef8fabcc4bb70d4cd613455948b707cb3b55e13633d49b" "q-13616/selection/7b3e321f8555564491c682241273e940cb8c08032210dd4c2c6b868682665d2c" "q-13616/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" "q-13616/selection/778c353184dc2f90b9c60c504f37ad8f6d048fa9753af8c9158889f74a47bc06" "q-13616/selection/93fb82ac5f7f057f85da1fe86c7a963325ca548ec91a734e7ea380e050beb566"] :db/ensure [:answer-field/validate]} {:db/id "q-13616" :question/id #uuid "60e5d36c-88c0-5cf7-8b86-f1dd3ac9a6db" :question/math-academy-id "q-13616" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/afef278ec13dda23227ef9dc28b0e5f3240a0481eaca208fa3b2d3ba27c85537.png)\n\nGiven that $(-1,4)$ is the midpoint of the line segment $\\overset{―}{PQ}$ above, find the coordinates of $P.$" :question/worked-solution "The given points are ${{(2,2)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$, ${{(a,b)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(-1,4)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (-1,4) & =(\\frac{2+a}{2},\\frac{2+b}{2})\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}{\\begin{aligned}-1=\\frac{2+a}{2} \\\\ 4=\\frac{2+b}{2}\\end{aligned}\\,⇒\\,{\\begin{aligned}a=-4 \\\\ b=6.\\end{aligned}\\end{aligned}\n$$\n\nThus, $(a,b)=(-4,6).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-13616/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0b6b70eb-df57-5d17-a753-645ccdf94945"] :knowledge-point/questions ["q-13616"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288821/selection/73610690e76a6524c994b1b0ec1b920dc0eea16d0b58f89a37880698071285bf" :answer/id #uuid "e0f4ca59-de3e-5472-a5d0-95413f861c9b" :answer/type :answer.type/math :answer/value "58\\,971" :db/ensure [:answer/validate]} {:db/id "q-288821/selection/2d4dfd5659920c41a73f16a85410a9bb66a6dac611acacc639f673c45ac14b3b" :answer/id #uuid "650d1dd7-08da-540b-86ac-5ae2c13762e1" :answer/type :answer.type/math :answer/value "\\frac{427}{2}" :db/ensure [:answer/validate]} {:db/id "q-288821/selection/fa997a24154a07b167aa572eb80485297ba9210601651a71a34690f67565524f" :answer/id #uuid "959fb719-9d81-539a-a680-dc3eba45ac90" :answer/type :answer.type/math :answer/value "-58\\,971" :db/ensure [:answer/validate]} {:db/id "q-288821/selection/9632fa41a90f5d95be7dd75185dae88062e7b603b7e121392ec5b3b106820eb2" :answer/id #uuid "164d42bb-31a8-5e23-bb63-95ad62ce46e5" :answer/type :answer.type/math :answer/value "(-2)\\cdot 58\\,971" :db/ensure [:answer/validate]} {:db/id "q-288821/selection/a52e20437247c869d2f5c50397a82e712b99115db076b5a4680c9852d7476860" :answer/id #uuid "2f574de3-cd2a-50bc-93a3-4159ffc99be3" :answer/type :answer.type/math :answer/value "\\frac{-58\\,971}{427}" :db/ensure [:answer/validate]} {:db/id "q-288821/selection" :answer-field/id #uuid "d4ef662f-a053-5e72-9509-a0921088d28c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288821/selection/fa997a24154a07b167aa572eb80485297ba9210601651a71a34690f67565524f" :answer-field/choices ["q-288821/selection/73610690e76a6524c994b1b0ec1b920dc0eea16d0b58f89a37880698071285bf" "q-288821/selection/2d4dfd5659920c41a73f16a85410a9bb66a6dac611acacc639f673c45ac14b3b" "q-288821/selection/fa997a24154a07b167aa572eb80485297ba9210601651a71a34690f67565524f" "q-288821/selection/9632fa41a90f5d95be7dd75185dae88062e7b603b7e121392ec5b3b106820eb2" "q-288821/selection/a52e20437247c869d2f5c50397a82e712b99115db076b5a4680c9852d7476860"] :db/ensure [:answer-field/validate]} {:db/id "q-288821" :question/id #uuid "943b524b-b2a3-5844-86ae-8628c6825604" :question/math-academy-id "q-288821" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+427x-58\\,971=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=427,\\,c=-58\\,971.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-58\\,971)}{1}=-58\\,971.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736"] :knowledge-point/questions ["q-288821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112876/selection/49c6887e3ef94e66559359e6f972e4a1952b9f1ea9f6dad3ef689373d3ec8a2f" :answer/id #uuid "d8542cc2-cb0a-5cf8-84ad-40437a5be95e" :answer/type :answer.type/math :answer/value "\\frac{1}{21}" :db/ensure [:answer/validate]} {:db/id "q-112876/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "bdf7a7e2-c83d-5d7f-a3be-d03c4fd46a56" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-112876/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "45e3514d-7e1e-5a50-aec2-37cd36d7b91c" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-112876/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "af67276e-0858-58f6-8d90-ce34dfe7c0ca" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-112876/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "5100696c-1323-5af2-94ba-f71d4f2e601b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-112876/selection" :answer-field/id #uuid "1f68bd25-2d3e-5bc1-b52a-7f474271c701" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112876/selection/49c6887e3ef94e66559359e6f972e4a1952b9f1ea9f6dad3ef689373d3ec8a2f" :answer-field/choices ["q-112876/selection/49c6887e3ef94e66559359e6f972e4a1952b9f1ea9f6dad3ef689373d3ec8a2f" "q-112876/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-112876/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-112876/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-112876/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-112876" :question/id #uuid "6029834b-7153-5587-95c0-5adfbb9eff9b" :question/math-academy-id "q-112876" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=14{x}^{4}+3{x}^{2}-x-7?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-7$ and the leading coefficient is $14.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-7}{\\text{factor of }14}.\n$$\n\nOf the given answer choices, only $\\frac{1}{21}$ does not take the above form. The denominator $(21)$ is not a factor of $14.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112876/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322"] :knowledge-point/questions ["q-112876"] :db/ensure [:knowledge-point/validate]} {:db/id "q-250543/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "9515f7da-b1dc-51db-b689-f0977d4f5c5c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-250543/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "4ce518d5-82cb-56e3-8acd-2caa5157f5d8" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-250543/field-1" :answer-field/id #uuid "abf388ef-d094-558a-94c3-1e372d97c0a5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250543/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-250543/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-250543/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-250543/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5c3b0258-b5ba-59da-9790-f68d61b80f8c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-250543/field-2" :answer-field/id #uuid "84030060-d5c1-5f90-aaed-3632ab2d0ef9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250543/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-250543/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-250543" :question/id #uuid "c0f5813f-1311-5202-9907-b6bbfa128b38" :question/math-academy-id "q-250543" :question/problem "Solve the equation ${x}^{2}-12x+40=0.$\n\n$x=$\n{{field-1}}\n$\\pm $\n{{field-2}}$\\text{i}$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=1,\\,b=-12,$ and $c=40.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{12\\pm \\sqrt{(-12)^{2}-4(1)(40)}}{2(1)} \\\\  & =\\frac{12\\pm \\sqrt{144-160}}{2} \\\\  & =\\frac{12\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{12\\pm 4\\,\\text{i}}{2} \\\\  & =6\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=6+2\\text{i}$ and $x=6-2\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-250543/field-1" "q-250543/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbe35c7b-8068-5b28-a820-d25e6b62565a"] :knowledge-point/questions ["q-250543"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66691"] :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{log}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}2-x & =0 \\\\ -x & =-2 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=2.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-148434/selection/9cad37f6e14714f9e8df4562876d102c8d6693cb0efe39d30149c54527a14f88" :answer/id #uuid "c253899b-067d-52fa-a7bc-3f9ba3f43b64" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{7x+1}{4x}" :db/ensure [:answer/validate]} {:db/id "q-148434/selection/74a736d77dfc5499256f19530ca090c291f51848fccbabec0ca4efff2b792af7" :answer/id #uuid "903f8109-394b-53d0-bf6c-7ddf61ca7bc9" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{x+4}{7x}" :db/ensure [:answer/validate]} {:db/id "q-148434/selection/bb234f990cb8695a97e30ab68deb0ffae131915fc85a936b08ad246b49ff3c44" :answer/id #uuid "a00400d3-3ab1-5ee7-9dfa-4db1a0a614a6" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{4x+7}{7x}" :db/ensure [:answer/validate]} {:db/id "q-148434/selection/037df70ea5a43bd79c0c24cb11e4eeb9bcd549d79b75e1d62d3d0ba328705329" :answer/id #uuid "2c0dbc63-1dfb-5bf0-9f00-fe5408d36e0b" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{4-x}{7x}" :db/ensure [:answer/validate]} {:db/id "q-148434/selection/a4e4107d94bf35ad2729ec8e4fda684369a06158ddb18ba4981fcb5aac4f7803" :answer/id #uuid "cb8994dc-e439-5191-9a3d-16ccf536d7c9" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{4x+4}{7x}" :db/ensure [:answer/validate]} {:db/id "q-148434/selection" :answer-field/id #uuid "4ce0241a-c33b-5946-a90a-9bf8729d04bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-148434/selection/74a736d77dfc5499256f19530ca090c291f51848fccbabec0ca4efff2b792af7" :answer-field/choices ["q-148434/selection/9cad37f6e14714f9e8df4562876d102c8d6693cb0efe39d30149c54527a14f88" "q-148434/selection/74a736d77dfc5499256f19530ca090c291f51848fccbabec0ca4efff2b792af7" "q-148434/selection/bb234f990cb8695a97e30ab68deb0ffae131915fc85a936b08ad246b49ff3c44" "q-148434/selection/037df70ea5a43bd79c0c24cb11e4eeb9bcd549d79b75e1d62d3d0ba328705329" "q-148434/selection/a4e4107d94bf35ad2729ec8e4fda684369a06158ddb18ba4981fcb5aac4f7803"] :db/ensure [:answer-field/validate]} {:db/id "q-148434" :question/id #uuid "04d4cf54-a7a9-55d6-92f9-191eb3416f50" :question/math-academy-id "q-148434" :question/problem "Find the inverse of the function $f(x)=\\frac{4}{7x-1}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{4}{7x-1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{4}{7y-1}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{4}{7y-1} \\\\ x(7y-1) & =4 \\\\ 7xy-x & =4 \\\\ 7xy & =x+4 \\\\ y & =\\frac{x+4}{7x}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{x+4}{7x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-148434/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "421b9396-2a7b-5c45-897a-9de5f52683de"] :knowledge-point/questions ["q-148434"] :db/ensure [:knowledge-point/validate]}]
