#{[{:db/id #edb/ref 17592186262775 :knowledge-point/_questions [{:knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf7a7e2-c83d-5d7f-a3be-d03c4fd46a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186262777} {:answer/id #uuid "d8542cc2-cb0a-5cf8-84ad-40437a5be95e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186262778} {:answer/id #uuid "5100696c-1323-5af2-94ba-f71d4f2e601b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186262779} {:answer/id #uuid "45e3514d-7e1e-5a50-aec2-37cd36d7b91c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186262780} {:answer/id #uuid "af67276e-0858-58f6-8d90-ce34dfe7c0ca" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262781}] :answer-field/correct {:answer/id #uuid "d8542cc2-cb0a-5cf8-84ad-40437a5be95e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186262778} :answer-field/id #uuid "1f68bd25-2d3e-5bc1-b52a-7f474271c701" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6029834b-7153-5587-95c0-5adfbb9eff9b" :question/math-academy-id "q-112876" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=14{x}^{4}+3{x}^{2}-x-7?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-7$ and the leading coefficient is $14.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-7}{\\text{factor of }14}.\n$$\n\nOf the given answer choices, only $\\frac{1}{21}$ does not take the above form. The denominator $(21)$ is not a factor of $14.$"}] [{:db/id #edb/ref 17592186262782 :knowledge-point/_questions [{:knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48fd37dc-102e-54db-bbfb-3a2cbcc44c92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(3+v)}{3+2v}" :db/id #edb/ref 17592186262784} {:answer/id #uuid "181b05a4-3d83-5761-af97-acbe6f928228" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3+8v}{3+2v}" :db/id #edb/ref 17592186262785} {:answer/id #uuid "854c750f-32a8-56e1-a054-75899195a266" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3-8v}{2(3+2v)}" :db/id #edb/ref 17592186262786} {:answer/id #uuid "76c40b6e-aa86-56c9-b41d-570a2e53d136" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5-8v}{2(3+2v)}" :db/id #edb/ref 17592186262787} {:answer/id #uuid "04b6c341-9c7f-57c4-887d-d97df4a836d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186262788}] :answer-field/correct {:answer/id #uuid "04b6c341-9c7f-57c4-887d-d97df4a836d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186262788} :answer-field/id #uuid "9bce0baa-80ba-5fc5-88d2-880f32116a15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262783}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "94656d5b-5501-55b7-ac7e-cff2be11bd02" :question/math-academy-id "q-113296" :question/problem "Given that $\\frac{7v}{2(3+2v)}=t$ and $\\frac{3-5v}{3+2v}=r,$ what is $t+r?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\nt+r=\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(3+2v)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2}{2}\\cdot \\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+6-10v}{2(3+2v)} & = \\\\ \\frac{6-3v}{2(3+2v)} & = \\\\ \\frac{3(2-v)}{2(3+2v)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262789 :knowledge-point/_questions [{:knowledge-point/id #uuid "0b6b70eb-df57-5d17-a753-645ccdf94945" :knowledge-point/title "Finding the Coordinates of an Endpoint Given the Midpoint"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce325be-d2cc-5441-8328-1ef2bf8bd000" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,6)" :db/id #edb/ref 17592186262791} {:answer/id #uuid "8e0f401a-6d08-5342-9a9a-4b3cc5fe0f66" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186262792} {:answer/id #uuid "6b324b87-3037-5239-8380-00230f914382" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,9)" :db/id #edb/ref 17592186262793} {:answer/id #uuid "ecb4ed72-5fee-5e6e-a9ce-13185b0825a8" :answer/type {:db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186262794} {:answer/id #uuid "bf89ce8c-3dad-532f-8eff-ff87b00f8adf" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186262795}] :answer-field/correct {:answer/id #uuid "3ce325be-d2cc-5441-8328-1ef2bf8bd000" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,6)" :db/id #edb/ref 17592186262791} :answer-field/id #uuid "6884fa24-6da2-5e75-be16-32f1846cdd2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262790}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "60e5d36c-88c0-5cf7-8b86-f1dd3ac9a6db" :question/math-academy-id "q-13616" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/afef278ec13dda23227ef9dc28b0e5f3240a0481eaca208fa3b2d3ba27c85537.png)\n\nGiven that $(-1,4)$ is the midpoint of the line segment $\\overset{―}{PQ}$ above, find the coordinates of $P.$" :question/worked-solution "The given points are ${{(2,2)}_{⏟}}_{\\text{(}{x}_{1},\\,{y}_{1})}$, ${{(a,b)}_{⏟}}_{\\text{(}{x}_{2},\\,{y}_{2})}$ and ${{(-1,4)}_{⏟}}_{\\text{(}{x}_{m},\\,{y}_{m})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\ (-1,4) & =(\\frac{2+a}{2},\\frac{2+b}{2})\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n\\begin{aligned}{\\begin{aligned}-1=\\frac{2+a}{2} \\\\ 4=\\frac{2+b}{2}\\end{aligned}\\,⇒\\,{\\begin{aligned}a=-4 \\\\ b=6.\\end{aligned}\\end{aligned}\n$$\n\nThus, $(a,b)=(-4,6).$"}] [{:db/id #edb/ref 17592186262796 :knowledge-point/_questions [{:knowledge-point/id #uuid "421b9396-2a7b-5c45-897a-9de5f52683de" :knowledge-point/title "Finding the Inverse of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c0dbc63-1dfb-5bf0-9f00-fe5408d36e0b" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{4-x}{7x}" :db/id #edb/ref 17592186262798} {:answer/id #uuid "903f8109-394b-53d0-bf6c-7ddf61ca7bc9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+4}{7x}" :db/id #edb/ref 17592186262799} {:answer/id #uuid "c253899b-067d-52fa-a7bc-3f9ba3f43b64" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{7x+1}{4x}" :db/id #edb/ref 17592186262800} {:answer/id #uuid "cb8994dc-e439-5191-9a3d-16ccf536d7c9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{4x+4}{7x}" :db/id #edb/ref 17592186262801} {:answer/id #uuid "a00400d3-3ab1-5ee7-9dfa-4db1a0a614a6" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{4x+7}{7x}" :db/id #edb/ref 17592186262802}] :answer-field/correct {:answer/id #uuid "903f8109-394b-53d0-bf6c-7ddf61ca7bc9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+4}{7x}" :db/id #edb/ref 17592186262799} :answer-field/id #uuid "4ce0241a-c33b-5946-a90a-9bf8729d04bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "04d4cf54-a7a9-55d6-92f9-191eb3416f50" :question/math-academy-id "q-148434" :question/problem "Find the inverse of the function $f(x)=\\frac{4}{7x-1}.$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{4}{7x-1}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{4}{7y-1}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{4}{7y-1} \\\\ x(7y-1) & =4 \\\\ 7xy-x & =4 \\\\ 7xy & =x+4 \\\\ y & =\\frac{x+4}{7x}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{x+4}{7x}.\n$$"}] [{:db/id #edb/ref 17592186262803 :knowledge-point/_questions [{:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a89d47d6-7d72-539d-916d-d2a4b0a4e73b" :answer/type {:db/ident :answer.type/math} :answer/value "270" :db/id #edb/ref 17592186262805} {:answer/id #uuid "ea32e158-9dc8-5e64-ab79-c0914e460f30" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186262806} {:answer/id #uuid "9b00320c-eb84-5c33-bdd7-56ce148f1604" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186262807} {:answer/id #uuid "f85dba1c-97d6-53e6-baec-d3a6a5c0071b" :answer/type {:db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186262808} {:answer/id #uuid "a7514173-15bd-5344-ac61-60534909e8cc" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186262809}] :answer-field/correct {:answer/id #uuid "ea32e158-9dc8-5e64-ab79-c0914e460f30" :answer/type {:db/ident :answer.type/math} :answer/value "180" :db/id #edb/ref 17592186262806} :answer-field/id #uuid "b380d71c-d89a-5821-8fd0-a2bebb0985dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262804}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3217b938-6776-57d3-a045-a78f82513de9" :question/math-academy-id "q-1780" :question/problem "Suppose you have $5$ shirts, $4$ pants, and $9$ ties. How many outfits can be made consisting of a shirt, pants, and a tie?" :question/worked-solution "Using the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Number of outfits} & =\\text{Number of shirts} \\\\  & \\times \\text{Number of pants} \\\\  & \\times \\text{Number of ties} \\\\  & =5\\times 4\\times 9 \\\\  & =180.\\end{aligned}\n$$\n\nTherefore, $180$ different outfits can be made consisting of a shirt, pants, and a tie."}] [{:db/id #edb/ref 17592186262810 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3b70270-c393-57a1-b8e3-b392ff96a715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{7}" :db/id #edb/ref 17592186262812} {:answer/id #uuid "5c4c9fe2-02c0-57c4-9f0a-4478a046fc10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186262813} {:answer/id #uuid "baa0a422-393e-5847-b089-8e6c730e03b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{5}" :db/id #edb/ref 17592186262814} {:answer/id #uuid "6b80b6a9-d7e9-5960-88f6-32f69484a819" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186262815} {:answer/id #uuid "76c19521-0ced-57a7-9440-b0815b56bae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186262816}] :answer-field/correct {:answer/id #uuid "6b80b6a9-d7e9-5960-88f6-32f69484a819" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186262815} :answer-field/id #uuid "5435d141-7257-5935-83ed-ac313c47213c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262811}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "75a1ef17-bd84-5a6f-a321-ae3c8b53dee2" :question/math-academy-id "q-23386" :question/problem "$\\operatorname{sin}⁡(\\frac{2\\pi }{3})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{2\\pi }{3})=\\frac{\\sqrt{3}}{2}.$"}] [{:db/id #edb/ref 17592186262817 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbe35c7b-8068-5b28-a820-d25e6b62565a" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots Using the Quadratic Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9515f7da-b1dc-51db-b689-f0977d4f5c5c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186262819} {:answer/id #uuid "4ce518d5-82cb-56e3-8acd-2caa5157f5d8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186262820}] :answer-field/correct {:answer/id #uuid "9515f7da-b1dc-51db-b689-f0977d4f5c5c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186262819} :answer-field/id #uuid "abf388ef-d094-558a-94c3-1e372d97c0a5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262818} {:answer-field/choices [{:answer/id #uuid "5c3b0258-b5ba-59da-9790-f68d61b80f8c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262822}] :answer-field/correct {:answer/id #uuid "5c3b0258-b5ba-59da-9790-f68d61b80f8c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262822} :answer-field/id #uuid "84030060-d5c1-5f90-aaed-3632ab2d0ef9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262821}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0f5813f-1311-5202-9907-b6bbfa128b38" :question/math-academy-id "q-250543" :question/problem "Solve the equation ${x}^{2}-12x+40=0.$\n\n$x=$\n{{field-1}}\n$\\pm $\n{{field-2}}$\\text{i}$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=1,\\,b=-12,$ and $c=40.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{12\\pm \\sqrt{(-12)^{2}-4(1)(40)}}{2(1)} \\\\  & =\\frac{12\\pm \\sqrt{144-160}}{2} \\\\  & =\\frac{12\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{12\\pm 4\\,\\text{i}}{2} \\\\  & =6\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=6+2\\text{i}$ and $x=6-2\\text{i}.$"}] [{:db/id #edb/ref 17592186262823 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "650d1dd7-08da-540b-86ac-5ae2c13762e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{427}{2}" :db/id #edb/ref 17592186262825} {:answer/id #uuid "e0f4ca59-de3e-5472-a5d0-95413f861c9b" :answer/type {:db/ident :answer.type/math} :answer/value "58\\,971" :db/id #edb/ref 17592186262826} {:answer/id #uuid "164d42bb-31a8-5e23-bb63-95ad62ce46e5" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\cdot 58\\,971" :db/id #edb/ref 17592186262827} {:answer/id #uuid "2f574de3-cd2a-50bc-93a3-4159ffc99be3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-58\\,971}{427}" :db/id #edb/ref 17592186262828} {:answer/id #uuid "959fb719-9d81-539a-a680-dc3eba45ac90" :answer/type {:db/ident :answer.type/math} :answer/value "-58\\,971" :db/id #edb/ref 17592186262829}] :answer-field/correct {:answer/id #uuid "959fb719-9d81-539a-a680-dc3eba45ac90" :answer/type {:db/ident :answer.type/math} :answer/value "-58\\,971" :db/id #edb/ref 17592186262829} :answer-field/id #uuid "d4ef662f-a053-5e72-9509-a0921088d28c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262824}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "943b524b-b2a3-5844-86ae-8628c6825604" :question/math-academy-id "q-288821" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+427x-58\\,971=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=427,\\,c=-58\\,971.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-58\\,971)}{1}=-58\\,971.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262830 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1bddb74-97be-5f35-b559-afb707e6e964" :knowledge-point/title "Applying the Root Rule to Compute a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e330232-ea69-5e4d-8860-2f98ad26449f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262832}] :answer-field/correct {:answer/id #uuid "2e330232-ea69-5e4d-8860-2f98ad26449f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262832} :answer-field/id #uuid "45d17601-5212-57fc-81a0-98a67cf0c81b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186262831}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b02345e9-0e5e-51b9-851e-2fb58ece83fd" :question/math-academy-id "q-338396" :question/problem "Find the **exact** value of the limit.\n\n${lim}_{x\\to 2}\\sqrt[3]{\\frac{{x}^{3}}{{x}^{2}-4x+5}}=$\n{{field-1}}" :question/worked-solution "Applying the root and quotient rules, we have that\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\sqrt[3]{\\frac{{x}^{3}}{{x}^{2}-4x+5}} & =\\sqrt[3]{{lim}_{x\\to 2}\\frac{{x}^{3}}{{x}^{2}-4x+5}} \\\\  & =\\sqrt[3]{\\frac{{lim}_{x\\to 2}({x}^{3})}{{lim}_{x\\to 2}({x}^{2}-4x+5)}}\\,.\\end{aligned}\n$$\n\nNow, we calculate the limits of the numerator and denominator separately. This gives\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}({x}^{3}) & ={2}^{3} \\\\  & =8\\end{aligned}\n$$\n\nand\n \n\n$$\n\\begin{aligned}{lim}_{x\\to 2}({x}^{2}-4x+5) & ={2}^{2}-4(2)+5 \\\\  & =4-8+5 \\\\  & =1\\,.\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{lim}_{x\\to 2}({x}^{3})}{{lim}_{x\\to 2}({x}^{2}-4x+5)}} & =\\sqrt[3]{\\frac{8}{1}} \\\\  & =\\sqrt[3]{8} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262833 :knowledge-point/_questions [{:knowledge-point/id #uuid "549d3c1f-305c-5d21-a3cf-863fb0ff1614" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "548840ce-bd20-5b10-b50f-a91b7d7ea091" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186262835} {:answer/id #uuid "6cf41f36-7699-53b6-b5d6-ba4baa4e09fd" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186262836} {:answer/id #uuid "5cdb7f24-414d-5683-bda0-8ab1db998a69" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186262837} {:answer/id #uuid "ca507321-c66c-52b0-9ef9-342aa994b2cc" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186262838} {:answer/id #uuid "ae7d6a32-9f79-595f-9701-65d1479b2a84" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186262839}] :answer-field/correct {:answer/id #uuid "ca507321-c66c-52b0-9ef9-342aa994b2cc" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186262838} :answer-field/id #uuid "fe064f1e-34bf-5a7e-bb53-e1ade0fca113" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262834}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f33f273d-36a2-559f-8e4a-6a2268d64069" :question/math-academy-id "q-61203" :question/problem "What is the sixth term of the following sequence?\n\n$$\nf(n+2)=f(n+1)+f(n)\\,,\\,f(1)=-4\\,,\\,f(2)=-1,\\,n\\ge 1\n$$" :question/worked-solution "The sixth term is represented by $f(6).$\n\nTo compute $f(6),$ we first need to compute $f(3).$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+2) & =f(n+1)+f(1) \\\\ f(1+2) & =f(1+1)+f(1) \\\\ f(3) & =f(2)+f(1) \\\\ f(3) & =(-4)+(-1) \\\\ f(3) & =-5\\end{aligned}\n$$\n\nNext, to compute $f(4),$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}f(2+2) & =f(2+1)+f(2) \\\\ f(4) & =f(3)+f(2) \\\\ f(4) & =(-5)+(-1) \\\\ f(4) & =-6\\end{aligned}\n$$\n\nWe continue this process to compute $f(5)$ and $f(6)$ as follows:\n\n$$\n\\begin{aligned}f(5) & =f(4)+f(3)=(-6)+(-5)=-11 \\\\ f(6) & =f(5)+f(4)=(-11)+(-6)=-17\\end{aligned}\n$$\n\nTherefore, the sixth term of the sequence is $f(6)=-17.$"}] [{:db/id #edb/ref 17592186262840 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5925800-3583-5be3-96c8-f946d72bc2af" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186262842} {:answer/id #uuid "47e0f7a8-cc9e-5974-9a39-877364e06d66" :answer/type {:db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186262843} {:answer/id #uuid "b1944c40-c2c1-58d9-a917-5856de87e6b0" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186262844} {:answer/id #uuid "e13f9f1f-d973-5f0f-a1e2-78cc78ad8f90" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186262845} {:answer/id #uuid "916946a2-fe6e-5d3c-9a65-a5938c3f018f" :answer/type {:db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186262846}] :answer-field/correct {:answer/id #uuid "b1944c40-c2c1-58d9-a917-5856de87e6b0" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186262844} :answer-field/id #uuid "6d1d837e-4fe2-5e72-9a0e-b0299bf13fa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262841}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "44ac753e-1a93-50f3-a318-c664d2c32040" :question/math-academy-id "q-64675" :question/problem "The angle $\\theta =-{395}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{395}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{395}^{∘}+{360}^{∘}=-{35}^{∘}$\n\n- $-{395}^{∘}+2\\cdot {360}^{∘}={325}^{∘}\\,✓$\n\nSo the angle ${325}^{∘}$ is coterminal with $-{395}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949162/assets/936e222cebb005bc504867f26eb2144bb976cab2441e53051121e056be158be1.png)\n\nWe see that ${325}^{∘}$ lies in quadrant IV. Therefore, $-{395}^{∘}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186115849 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8512c0bb-0aa8-5518-862b-94b40eabab20" :answer/type {:db/ident :answer.type/math} :answer/value "x =-2" :db/id #edb/ref 17592186114466} {:answer/id #uuid "b6638623-5162-5821-b784-188239682328" :answer/type {:db/ident :answer.type/math} :answer/value "x =-1" :db/id #edb/ref 17592186114467} {:answer/id #uuid "d5b987b5-34fb-5ef0-8724-c3b856a4bc7f" :answer/type {:db/ident :answer.type/math} :answer/value "x =-3" :db/id #edb/ref 17592186114468} {:answer/id #uuid "e0bedfa2-c891-506b-b0f4-ce2edec520a0" :answer/type {:db/ident :answer.type/math} :answer/value "x = 2" :db/id #edb/ref 17592186114469} {:answer/id #uuid "6e3c66c9-3263-55ee-8dad-f7185a27bfb0" :answer/type {:db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186114470}] :answer-field/correct {:answer/id #uuid "e0bedfa2-c891-506b-b0f4-ce2edec520a0" :answer/type {:db/ident :answer.type/math} :answer/value "x = 2" :db/id #edb/ref 17592186114469} :answer-field/id #uuid "3673e62e-49ed-50a6-bb69-f32eb824187f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114465}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "083fbe94-c722-5f14-b6e0-9e202f8f9b2a" :question/math-academy-id "q-66691" :question/problem "Find the equation of the vertical asymptote of the function $f(x) =-\\log (2 - x) + 3$." :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{log}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}2-x & =0 \\\\ -x & =-2 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186262847 :knowledge-point/_questions [{:knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e33dad-ef27-5ccf-ad60-8e847eaaa420" :answer/type {:db/ident :answer.type/math} :answer/value "-8{x}^{4}+C" :db/id #edb/ref 17592186262849} {:answer/id #uuid "e332897a-01dd-5fe3-8cee-c5276ad4cb4f" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{4}+C" :db/id #edb/ref 17592186262850} {:answer/id #uuid "b7d9ce8f-2464-5c06-b5d3-f5fc0e4c11c0" :answer/type {:db/ident :answer.type/math} :answer/value "-4{x}^{4}+C" :db/id #edb/ref 17592186262851} {:answer/id #uuid "e21e2cb9-ae6e-57e6-967d-88f483d8d43c" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186262852} {:answer/id #uuid "e95cb500-23d2-5f67-b05f-1780d375955d" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{5}+C" :db/id #edb/ref 17592186262853}] :answer-field/correct {:answer/id #uuid "e332897a-01dd-5fe3-8cee-c5276ad4cb4f" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{4}+C" :db/id #edb/ref 17592186262850} :answer-field/id #uuid "e727ef59-70f7-5c46-a80b-fa66bbde8c28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262848}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2d8c084f-d8ff-5f92-9569-1953da85c67f" :question/math-academy-id "q-71165" :question/problem "Calculate $\\int (-8{x}^{3})\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-8{x}^{3})\\,\\text{d}x & =-8\\int {x}^{3}\\,\\text{d}x \\\\  & =-8(\\frac{{x}^{3+1}}{3+1})+C \\\\  & =-8\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =-2{x}^{4}+C\\end{aligned}\n$$"}]}
