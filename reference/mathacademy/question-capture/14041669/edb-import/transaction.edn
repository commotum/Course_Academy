frac{1}{3}-\\frac{10}{21} \\\\  & =\\frac{6+7-10}{21} \\\\  & =\\frac{1}{7} \\\\  & \\ne 0\\,\\times \\end{aligned}\n$$\n\nTherefore, $A$ and $B$ are not mutually exclusive events." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87286/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65bec174-0235-5a32-a0d2-2892af4ddaf9"] :knowledge-point/questions ["q-87286"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12552/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "3a63241c-df4f-51fc-8b18-2296350882ac" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-12552/selection/57f27b4de16f64fcab2f3b810a7087fb3b270a063a6807c410b738013ce41fde" :answer/id #uuid "125ca9ed-4c79-5d83-ba81-bae105b45e75" :answer/type :answer.type/math :answer/value "0.8" :db/ensure [:answer/validate]} {:db/id "q-12552/selection/57f1df4deeb63ac8b169c1392105cc1ec886c4a882da47e1d3a4a61ab32f1e2a" :answer/id #uuid "976b1181-7a48-50a6-8bd4-8b8d94503cc6" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "q-12552/selection/2468d3f08d897d95f4d28b48c13e6034ce1716985d166fd89a0b8119476fe5c8" :answer/id #uuid "5e0873c3-1a10-543f-85ab-8eebe87fcc3f" :answer/type :answer.type/math :answer/value "0.2" :db/ensure [:answer/validate]} {:db/id "q-12552/selection/39981dba206f2eda72355f0b9a140bd7936091ac640a56dd6d43c8b061ecfc15" :answer/id #uuid "91893fc4-fd91-56ce-b44c-cede7f6c8404" :answer/type :answer.type/math :answer/value "0.28" :db/ensure [:answer/validate]} {:db/id "q-12552/selection" :answer-field/id #uuid "bc3933ad-5091-5d8f-a7ac-5c0f282452ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12552/selection/2468d3f08d897d95f4d28b48c13e6034ce1716985d166fd89a0b8119476fe5c8" :answer-field/choices ["q-12552/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" "q-