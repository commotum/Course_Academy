c{17}{24} & =\\frac{3}{8}+\\frac{1}{3}-P(A\\cap B) \\\\ P(A\\cap B) & =\\frac{3}{8}+\\frac{1}{3}-\\frac{17}{24} \\\\  & =\\frac{9+8-17}{24} \\\\  & =0\\,✓\\end{aligned}\n$$\n\nTherefore, $A$ and $B$ are mutually exclusive events." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-120513/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65bec174-0235-5a32-a0d2-2892af4ddaf9"] :knowledge-point/questions ["q-120513"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87289/selection/9fb5c612ee365ea61ce6f134c95ae853f67289ad9f707d5c163f9eafe471bb65" :answer/id #uuid "a56d4ff4-e5af-5f04-95ad-5bcdc7051fea" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)<P(A\\cup B)$" :db/ensure [:answer/validate]} {:db/id "q-87289/selection/0061b50a1bd801002aefb7fcd79da6338d0e8284ab98965d23896361b15e0c35" :answer/id #uuid "8f2ed765-b60f-50c5-96a5-3ea3312151aa" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)\\ne P(A\\cup B)$" :db/ensure [:answer/validate]} {:db/id "q-87289/selection/adb82c8e48b920522dec6825f8ed26c41c791120cdcc513e1721071259b292ed" :answer/id #uuid "6f57882e-e4bb-5a32-b814-9771c13e8739" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A\\cap B)\\ne 0$" :db/ensure [:answer/validate]} {:db/id "q-87289/selection/fd78638e3bc30d2e897905460d8513d277f3f3c07109a4384279262d8a838492" :answer/id #uuid "0eea9adb-50ed-522d-85b4-e4e5314e3b81" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\ne P(B)$" :db/ensure [:answer/validate]} {:db/id "q-87289/selection/72fd1f0079d054315a89de1a806511a99edf60de21f2577cbc2dfa13c97964c5" :answer/id #uuid "6a25db9b-575b-55ad-9bc9-86380e98af08" :answer/type :answer.type/text :answer/value "$A$ and $B$ are mutually exclusive events, since $P(A\\cap B)=0$" :db/en