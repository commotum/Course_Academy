ate]} {:db/id [:question/math-academy-id "q-12551"] :question/problem "Suppose that $A$ and $B$ are mutually exclusive events. Given that $P(A)=\\frac{2}{7}$ and $P(A\\cup B)=\\frac{3}{4},$ find $P(B).$" :question/worked-solution "If $A$ and $B$ are mutually exclusive events, then $P(A\\cap B)=0.$\n\nTherefore, by the addition law, we have that\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B) \\\\ P(B) & =P(A\\cup B)-P(A) \\\\  & =\\frac{3}{4}-\\frac{2}{7} \\\\  & =\\frac{21-8}{28} \\\\  & =\\frac{13}{28}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-87308/selection/386b207bf78f44cbb023498a077727154d807f55c706af230d476181abf3e8cc" :answer/id #uuid "6333b560-a0e3-57c1-86be-ca4d06fe4901" :answer/type :answer.type/math :answer/value "\\frac{8}{25}" :db/ensure [:answer/validate]} {:db/id "q-87308/selection/b336641abcb999c21c9e53c96c83b284fdf2bf3a3de0d87fa53f648928975e27" :answer/id #uuid "7bbb94e4-cb66-5f2c-920a-962789e93724" :answer/type :answer.type/math :answer/value "\\frac{2}{25}" :db/ensure [:answer/validate]} {:db/id "q-87308/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" :answer/id #uuid "e60e6569-dba3-53fc-9050-11b9c25ada2f" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-87308/selection/29648ef4e020fc43d1b46acbdbbedfd18f3de75ade3ca2e0ef505839d2f8c39b" :answer/id #uuid "7f826c59-0b4e-5ed6-b029-4ef26a46532f" :answer/type :answer.type/math :answer/value "\\frac{7}{5}" :db/ensure [:answer/validate]} {:db/id "q-87308/selection/cf21262d987240c6bebb84eacdd634abfd2c370d99882f632c36363ebf6fffb6" :answer/id #uuid "975d7a3d-6486-530a-9868-370d036170c8" :answer/type :answer.type/math :answer/value "\\frac{7}{25}" :db/ensure [:answer/validate]} {:db/id "q-87308/selection" :answer-field/id #uuid "ced2a49d-ef9a-5ea3-aedd-a5bb6a1b22b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correc