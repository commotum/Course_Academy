text{d}}{\\text{d}u}{\\int }_{-4}^{u}\\frac{1}{t}\\,\\text{d}t) \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\frac{1}{u}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{x}^{2})\\cdot (-\\frac{1}{u}) \\\\  & =-2x\\cdot (-\\frac{1}{-{x}^{2}}) \\\\  & =-2x\\cdot \\frac{1}{{x}^{2}} \\\\  & =-\\frac{2}{x}.\\end{aligned}\\end{aligned}\n$$" 13194139534913 true] [17592186319352 1000 #edb/ref 17592186319353 13194139534913 true] [17592186319352 1000 #edb/ref 17592186319354 13194139534913 true] [17592186319352 1000 #edb/ref 17592186319355 13194139534913 true] [17592186319352 1000 #edb/ref 17592186319356 13194139534913 true] [17592186319352 1000 #edb/ref 17592186319357 13194139534913 true] [17592186319352 1040 #edb/ref 17592186045450 13194139534913 true] [17592186319352 1041 "selection" 13194139534913 true] [17592186319352 1104 #edb/ref 17592186319354 13194139534913 true] [17592186319352 1110 #uuid "9f7b4c45-d028-59ab-8a8f-0f782cb30f5a" 13194139534913 true] [17592186319353 1034 "\\frac{1}{x}" 13194139534913 true] [17592186319353 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319353 1111 #uuid "2750f188-1555-5a7c-bf96-b1a2e625394f" 13194139534913 true] [17592186319354 1034 "-\\frac{2}{x}" 13194139534913 true] [17592186319354 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319354 1111 #uuid "b362d609-9c9f-569c-a798-c880a9381f08" 13194139534913 true] [17592186319355 1034 "-\\operatorname{ln}⁡x" 13194139534913 true] [17592186319355 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319355 1111 #uuid "19c69a97-5494-57e3-a028-bdbadf73474d" 13194139534913 true] [17592186319356 1034 "\\frac{1}{\\operatorname{ln}⁡x}" 13194139534913 true] [17592186319356 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319356 1111 #uuid "c86282f8-f50b-5e80-afbb-504815f405f6" 13194139534913 true] [17592186319357 1034 "-x" 13194139534913 true] [17592186319357 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319357 1111 #uuid "fd45bf03-6e24-54f0-9207-b2f04081