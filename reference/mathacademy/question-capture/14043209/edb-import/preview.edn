13 true] [17592186319314 1000 #edb/ref 17592186319315 13194139534913 true] [17592186319314 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319314 1041 "field-1" 13194139534913 true] [17592186319314 1104 #edb/ref 17592186319315 13194139534913 true] [17592186319314 1110 #uuid "558852eb-4f01-5cbd-b343-42bd170341c9" 13194139534913 true] [17592186319315 1034 "-\\sin(x^2)" 13194139534913 true] [17592186319315 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319315 1111 #uuid "63ff3cba-ad6a-5e94-bd5e-b12e583ca126" 13194139534913 true] [17592186319316 1017 #edb/ref 17592186319317 13194139534913 true] [17592186319316 1089 "q-316389" 13194139534913 true] [17592186319316 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319316 1100 "Let $f(t)={t}^{2}{e}^{3t}.$ Find ${h}^{′}(2)$ given the function $h$ is defined by $h(x)={\\int }_{x}^{3}f(t)\\,\\text{d}t$ for $x<3.$\n\n${h}^{′}(2)=$\n{{field-1}}" 13194139534913 true] [17592186319316 1113 #uuid "bbf23fd5-c7a9-5978-b5c2-9ee5483a0885" 13194139534913 true] [17592186319316 1145 "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we prefer the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{3}{t}^{2}{e}^{3t}\\,\\text{d}t=-{\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{3}{t}^{2}{e}^{3t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t) \\\\  & =-{x}^{2}{e}^{3x}.\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(2),$ we substitute $x=2$ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(2) & =-{2}^{2}\\cdot {e}^{3(2)} \\\\  & =-4{e}^{6}\\end{aligned}\n$$" 13194139534913 true] [17592186319317 1000 #edb/ref 17592186319318 13194139534913 true] [17592186319317 1000 #edb/ref 17592186319319 13194139534913 true] [17592186319317 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319317 1041 "field-1" 13194139534913 true] [17592186319317 1104 #edb/ref 17592186319318 13194139534913 true] [17592186319317 1110 #uuid "dd29bc71-9add-50cd-8034-bbbf0e144829" 13194139534913 true] [17592186319318 1034 "-4e^6" 13194139534913 true] [17592186319318 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319318 1111 #uuid "33e429fa-0574-5d0a-9d11-643300181573" 13194139534913 true] [17592186319319 1034 "4e^6" 13194139534913 true] [17592186319319 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319319 1111 #uuid "fea009ec-e891-50b7-8ac1-faaacc48e800" 13194139534913 true] [17592186319320 1017 #edb/ref 17592186319321 13194139534913 true] [17592186319320 1089 "q-316401" 13194139534913 true] [17592186319320 1091 #edb/ref 17592186045464 13194139534913 true] [17592186319320 1100 "Find ${g}^{′}(x)$ for $g(x)={\\int }_{{e}^{x}}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t.$\n\n${g}^{′}(x)=$\n{{field-1}}" 13194139534913 true] [17592186319320 1113 #uuid "64a8ab90-732d-5ddf-a15d-bdcfaa0872b0" 13194139534913 true] [17592186319320 1145 "To compute ${g}^{′}(x),$ we first make the substitution $u={e}^{x}$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{{e}^{x}}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t\\end{aligned}\n$$\n\nThe limit $u$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t & =\\frac{\\text{d}}{\\text{d}u}(-{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}u}{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\frac{\\text{d}}{\\text{d}u}{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t) \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\operatorname{cos}⁡({u}^{3})) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})\\cdot (-\\operatorname{cos}⁡(({e}^{x})^{3})) \\\\  & =-{e}^{x}\\operatorname{cos}⁡({e}^{3x}).\\end{aligned}\n$$" 13194139534913 true] [17592186319321 1000 #edb/ref 17592186319322 13194139534913 true] [17592186319321 1000 #edb/ref 17592186319323 13194139534913 true] [17592186319321 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319321 1041 "field-1" 13194139534913 true] [17592186319321 1104 #edb/ref 17592186319323 13194139534913 true] [17592186319321 1110 #uuid "eb542cc0-a312-5033-b7ea-41072d444b9b" 13194139534913 true] [17592186319322 1034 "e^x\\cos(e^{3x})" 13194139534913 true] [17592186319322 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319322 1111 #uuid "b2f4d357-a6b9-5c57-9ef9-4a0ecc205abb" 13194139534913 true] [17592186319323 1034 "-e^x\\cos(e^{3x})" 13194139534913 true] [17592186319323 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319323 1111 #uuid "2564531a-7553-506e-9554-e8994460b02a" 13194139534913 true] [17592186319324 1017 #edb/ref 17592186319325 13194139534913 true] [17592186319324 1089 "q-332067" 13194139534913 true] [17592186319324 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319324 1100 "Let $f(t)=\\operatorname{ln}⁡t\\operatorname{sin}⁡t.$ Find ${h}^{′}(\\pi )$ given the function $h$ is defined by $h(x)={\\int }_{x}^{2\\pi }f(t)\\,\\text{d}t$ for $0<x<2\\pi .$\n\n${h}^{′}(\\pi )=$\n{{field-1}}" 13194139534913 true] [17592186319324 1113 #uuid "7c89f865-0b83-58a4-aac0-5e0e25249852" 13194139534913 true] [17592186319324 1145 "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we prefer the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{2\\pi }\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t=-{\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{2\\pi }\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t) \\\\  & =-\\operatorname{ln}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(\\pi ),$ we substitute $x=\\pi $ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(\\pi ) & =-\\operatorname{ln}⁡(\\pi )\\cdot \\operatorname{sin}⁡(\\pi ) \\\\  & =-\\operatorname{ln}⁡\\pi \\cdot 0 \\\\  & =0\\end{aligned}\n$$" 13194139534913 true] [17592186319325 1000 #edb/ref 17592186319326 13194139534913 true] [17592186319325 1000 #edb/ref 17592186319327 13194139534913 true] [17592186319325 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319325 1041 "field-1" 13194139534913 true] [17592186319325 1104 #edb/ref 17592186319327 13194139534913 true] [17592186319325 1110 #uuid "410a2e5f-ab0d-5735-9de9-e05503b26a33" 13194139534913 true] [17592186319326 1034 "1" 13194139534913 true] [17592186319326 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319326 1111 #uuid "9117a9b6-8ab8-53fe-866f-6acd9182c966" 13194139534913 true] [17592186319327 1034 "0" 13194139534913 true] [17592186319327 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319327 1111 #uuid "601f0262-e552-5bea-9eec-760a76177e8f" 13194139534913 true] [17592186319328 1017 #edb/ref 17592186319329 13194139534913 true] [17592186319328 1089 "q-332071" 13194139534913 true] [17592186319328 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319328 1100 "Let $f(t)=2{t}^{3}+{t}^{2}-1.$ Find ${h}^{′}(0)$ given the function $h$ is defined by $h(x)={\\int }_{x}^{1}f(t)\\,\\text{d}t$ for $x<1.$\n\n${h}^{′}(0)=$\n{{field-1}}" 13194139534913 true] [17592186319328 1113 #uuid "bd3e742b-7240-59fc-94f4-6663ac30d7db" 13194139534913 true] [17592186319328 1145 "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{1}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t=-{\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{1}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t) \\\\  & =-(2{x}^{3}+{x}^{2}-1).\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(0),$ we substitute $x=0$ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(0) & =-(2\\cdot {0}^{3}+{0}^{2}-1) \\\\  & =-(0+0-1) \\\\  & =1\\end{aligned}\n$$" 13194139534913 true] [17592186319329 1000 #edb/ref 17592186319330 13194139534913 true] [17592186319329 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319329 1041 "field-1" 13194139534913 true] [17592186319329 1104 #edb/ref 17592186319330 13194139534913 true] [17592186319329 1110 #uuid "19dba24c-54b5-516b-8240-fe1fff592bd1" 13194139534913 true] [17592186319330 1034 "1" 13194139534913 true] [17592186319330 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319330 1111 #uuid "24d92f18-9896-5815-a91e-2ac8de777387" 13194139534913 true] [17592186319331 1017 #edb/ref 17592186319332 13194139534913 true] [17592186319331 1089 "q-333563" 13194139534913 true] [17592186319331 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319331 1100 "Find ${g}^{′}(x)$ if $g(x)={\\int }_{0}^{{x}^{3}+1}{e}^{t}\\,\\text{d}t.$\n\n${g}^{′}(x)=$ \n{{field-1}} ${e}^{{x}^{3}+1}$" 13194139534913 true] [17592186319331 1113 #uuid "110184fb-4f4b-5c53-bfd3-fe4e1173890d" 13194139534913 true] [17592186319331 1145 "To compute ${g}^{′}(x),$ we first make the substitution $u={x}^{3}+1$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{0}^{{x}^{3}+1}{e}^{t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}{e}^{t}\\,\\text{d}t\\end{aligned}\n$$\n\nThe integrand is continuous on $[0,u].$ Therefore, by FTC II, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}{e}^{t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot {e}^{u} \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+1)\\cdot {e}^{{x}^{3}+1} \\\\  & =3{x}^{2}\\cdot {e}^{{x}^{3}+1} \\\\  & =3{x}^{2}\\,{e}^{{x}^{3}+1}.\\end{aligned}\n$$" 13194139534913 true] [17592186319332 1000 #edb/ref 17592186319333 13194139534913 true] [17592186319332 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319332 1041 "field-1" 13194139534913 true] [17592186319332 1104 #edb/ref 17592186319333 13194139534913 true] [17592186319332 1110 #uuid "76ab5b15-4d7c-5988-9774-8dc401899170" 13194139534913 true] [17592186319333 1034 "3x^2" 13194139534913 true] [17592186319333 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319333 1111 #uuid "2c51ff18-4f24-571b-9e30-6b40ac4b542c" 13194139534913 true] [17592186319334 1017 #edb/ref 17592186319335 13194139534913 true] [17592186319334 1089 "q-333573" 13194139534913 true] [17592186319334 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319334 1100 "Find ${g}^{′}(x)$ if $g(x)={\\int }_{0}^{{x}^{3}}({t}^{3}-2t)\\,\\text{d}t.$\n\n${g}^{′}(x)=$ \n{{field-1}}" 13194139534913 true] [17592186319334 1113 #uuid "caf3e0e6-df65-5a67-9c9b-e28b29e53d7d" 13194139534913 true] [17592186319334 1145 "To compute ${g}^{′}(x),$ we first make the substitution $u={x}^{3}$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{0}^{{x}^{3}}({t}^{3}-2t)\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}({t}^{3}-2t)\\,\\text{d}t\\end{aligned}\n$$\n\nThe integrand is continuous on $[0,u].$ Therefore, by FTC II, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}({t}^{3}-2t)\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot ({u}^{3}-2u) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})\\cdot (({x}^{3})^{3}-2({x}^{3})) \\\\  & =3{x}^{2}\\cdot ({x}^{9}-2{x}^{3}) \\\\  & =3{x}^{2}({x}^{9}-2{x}^{3}).\\end{aligned}\n$$" 13194139534913 true] [17592186319335 1000 #edb/ref 17592186319336 13194139534913 true] [17592186319335 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319335 1041 "field-1" 13194139534913 true] [17592186319335 1104 #edb/ref 17592186319336 13194139534913 true] [17592186319335 1110 #uuid "5fcd6320-af3b-50cb-8b93-61aee974c5ea" 13194139534913 true] [17592186319336 1034 "3x^{11}-6x^5" 13194139534913 true] [17592186319336 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319336 1111 #uuid "047b6330-dc47-5782-a93c-4e203e18aa67" 13194139534913 true] [17592186319337 1017 #edb/ref 17592186319338 13194139534913 true] [17592186319337 1089 "q-333882" 13194139534913 true] [17592186319337 1091 #edb/ref 17592186045464 13194139534913 true] [17592186319337 1100 "If $G(x)={\\int }_{x}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t,$ then ${G}^{′}(0)=${{field-1}}." 13194139534913 true] [17592186319337 1113 #uuid "36b5cbf2-4547-50e0-a29e-914ff91501a4" 13194139534913 true] [17592186319337 1145 "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t & ={\\int }_{x}^{a}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{tan}⁡(x).$\n\nThe integrand $(1+{t}^{2})^{2}$ is continuous for all $t.$ Therefore, applying the FTC II, we have\n\n$$\n\\begin{aligned}{G}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t)+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-(1+{x}^{2})^{2}+\\frac{\\text{d}u}{\\text{d}x}\\cdot {(1+{u}^{2})}^{2} \\\\  & =-(1+{x}^{2})^{2}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(x))\\cdot {(1+{tan}^{2}⁡(x))}^{2} \\\\  & =-(1+{x}^{2})^{2}+{sec}^{2}⁡(x)\\cdot {(1+{tan}^{2}⁡(x))}^{2}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{tan}⁡(x).$\n\nFinally, we can compute ${G}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{G}^{′}(0) & =-(1+{0}^{2})^{2}+{sec}^{2}⁡(0)\\cdot {(1+{tan}^{2}⁡(0))}^{2} \\\\  & =-1+1\\cdot {1}^{2} \\\\  & =0.\\end{aligned}\n$$" 13194139534913 true] [17592186319338 1000 #edb/ref 17592186319339 13194139534913 true] [17592186319338 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319338 1041 "field-1" 13194139534913 true] [17592186319338 1104 #edb/ref 17592186319339 13194139534913 true] [17592186319338 1110 #uuid "b9daacc8-19e7-529a-9a8a-0c2f8745cf0d" 13194139534913 true] [17592186319339 1034 "0" 13194139534913 true] [17592186319339 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319339 1111 #uuid "e4efc0b0-5690-5dcb-bda3-90185ceaff37" 13194139534913 true] [17592186319340 1017 #edb/ref 17592186319341 13194139534913 true] [17592186319340 1089 "q-333952" 13194139534913 true] [17592186319340 1091 #edb/ref 17592186045464 13194139534913 true] [17592186319340 1100 "If $G(x)={\\int }_{x}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t,$ then ${G}^{′}(0)=${{field-1}}." 13194139534913 true] [17592186319340 1113 #uuid "845f0089-00c1-55c9-9061-c3bdb326a9aa" 13194139534913 true] [17592186319340 1145 "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t & ={\\int }_{x}^{a}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{cos}⁡(x).$\n\nThe integrand ${e}^{t}$ is continuous for all $t.$ Therefore, applying the FTC II, we have\n\n$$\n\\begin{aligned}{G}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}{e}^{t}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}{e}^{t}\\,\\text{d}t)+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}{e}^{t}\\,\\text{d}t) \\\\  & =-{e}^{x}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))\\cdot {e}^{u} \\\\  & =-{e}^{x}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))\\cdot {e}^{\\operatorname{cos}⁡(x)} \\\\  & =-{e}^{x}-\\operatorname{sin}⁡(x)\\cdot {e}^{\\operatorname{cos}⁡(x)}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{cos}⁡(x).$\n\nFinally, we can compute ${G}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{G}^{′}(0) & =-{e}^{0}-\\operatorname{sin}⁡(0)\\cdot {e}^{\\operatorname{cos}⁡(0)} \\\\  & =-1-0 \\\\  & =-1.\\end{aligned}\n$$" 13194139534913 true] [17592186319341 1000 #edb/ref 17592186319342 13194139534913 true] [17592186319341 1000 #edb/ref 17592186319343 13194139534913 true] [17592186319341 1040 #edb/ref 17592186045449 13194139534913 true] [17592186319341 1041 "field-1" 13194139534913 true] [17592186319341 1104 #edb/ref 17592186319343 13194139534913 true] [17592186319341 1110 #uuid "9ca5ae5b-cd4d-533c-b91b-1a241d120141" 13194139534913 true] [17592186319342 1034 "1" 13194139534913 true] [17592186319342 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319342 1111 #uuid "08d345e1-830a-5cef-b585-ba6bb99c16b0" 13194139534913 true] [17592186319343 1034 "-1" 13194139534913 true] [17592186319343 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319343 1111 #uuid "644d5b2b-40e5-501b-9822-e49577403178" 13194139534913 true] [17592186319344 1017 #edb/ref 17592186319345 13194139534913 true] [17592186319344 1089 "q-4553" 13194139534913 true] [17592186319344 1091 #edb/ref 17592186045465 13194139534913 true] [17592186319344 1100 "Find ${f}^{′}(2)$ if $f(x)={\\int }_{2}^{2x}\\sqrt{{t}^{3}-t}\\,\\text{d}t.$" 13194139534913 true] [17592186319344 1113 #uuid "c07e1de1-cd19-51e2-9521-40cd741e9f90" 13194139534913 true] [17592186319344 1145 "To compute ${f}^{′}(x),$ we first make the substitution $u=2x$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{2}^{2x}\\sqrt{{t}^{3}-t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{2}^{u}\\sqrt{{t}^{3}-t}\\,\\text{d}t\\end{aligned}\\end{aligned}\n$$\n\nThe integrand is continuous on $[2,u],$ and so by FTC II we get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\sqrt{{u}^{3}-u} \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2x)\\cdot \\sqrt{(2x)^{3}-(2x)} \\\\  & =2\\sqrt{8{x}^{3}-2x}.\\end{aligned}\\end{aligned}\n$$\n\nFinally, to find the value of ${f}^{′}(2),$ we substitute $x=2$ in the above:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(2) & =2\\sqrt{8(2)^{3}-2(2)} \\\\  & =2\\sqrt{64-4} \\\\  & =4\\sqrt{15}.\\end{aligned}\\end{aligned}\n$$" 13194139534913 true] [17592186319345 1000 #edb/ref 17592186319346 13194139534913 true] [17592186319345 1000 #edb/ref 17592186319347 13194139534913 true] [17592186319345 1000 #edb/ref 17592186319348 13194139534913 true] [17592186319345 1000 #edb/ref 17592186319349 13194139534913 true] [17592186319345 1000 #edb/ref 17592186319350 13194139534913 true] [17592186319345 1040 #edb/ref 17592186045450 13194139534913 true] [17592186319345 1041 "selection" 13194139534913 true] [17592186319345 1104 #edb/ref 17592186319348 13194139534913 true] [17592186319345 1110 #uuid "6013b560-f643-52c0-997d-0659c95349b6" 13194139534913 true] [17592186319346 1034 "8\\sqrt{5}" 13194139534913 true] [17592186319346 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319346 1111 #uuid "5e7b05ec-b43b-5adb-88e5-a3ddf5b979de" 13194139534913 true] [17592186319347 1034 "2\\sqrt{15}" 13194139534913 true] [17592186319347 1103 #edb/ref 17592186045453 13194139534913 true] [17592186319347 1111 #uuid "ef5aa62e-68ee-5a37-a279-604349a87ca4" 13194139534913 true] [17592186319348 1034