operatorname{cos}⁡t}{{t}^{2}+4}$ is continuous on $[3,x],$ where $x>3.$ So, FTC II applies, and we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{3}^{x}\\frac{\\operatorname{cos}⁡t}{{t}^{2}+4}\\,\\text{d}t & =\\frac{\\operatorname{cos}⁡x}{{x}^{2}+4}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-75583/selection/deb3c2333d1c5ac9b3e8adade94146cc940e51dfd7761cca9f6abeb651cb0a9d" :answer/id #uuid "f3534a66-3b14-5162-b9d2-a59d8ca5268f" :answer/type :answer.type/math :answer/value "{g}^{′}(\\frac{\\pi }{4})=\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-75583/selection/e6875ee361b6731bf716b7411b201a5ccd8f5da2d82d19a314fc8fe60e3a71aa" :answer/id #uuid "967b3ee4-7a82-5278-b0dd-3f2ae427c2b5" :answer/type :answer.type/math :answer/value "{g}^{′}(\\frac{\\pi }{4})=1" :db/ensure [:answer/validate]} {:db/id "q-75583/selection/fb9a32945c2b41eb721ff682dee713d725c12580d1304c80cb706ec11f56d356" :answer/id #uuid "d59fbc42-ee86-50ac-aa25-ceeaf2a462d7" :answer/type :answer.type/math :answer/value "{g}^{′}(\\frac{\\pi }{4})=\\frac{\\pi \\sqrt[3]{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-75583/selection/d5ec881bd4e6a005d78e3263615100c2d678c19c11087e5de0d2c1372c31e591" :answer/id #uuid "74101cae-c8db-5f43-a5ea-15ecae944e59" :answer/type :answer.type/math :answer/value "{g}^{′}(\\frac{\\pi }{4})=\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-75583/selection/48a1b6e2047f9c17f1e0cbe98c864c1c48d497e13322bc141ed2b3ba3fb6b4dd" :answer/id #uuid "6ebceae7-ba05-5111-8b16-99f49869c7bc" :answer/type :answer.type/math :answer/value "{g}^{′}(\\frac{\\pi }{4})=0" :db/ensure [:answer/validate]} {:db/id "q-75583/selection" :answer-field/id #uuid "c8ba2c16-ce21-568a-856d-aa74fb258a7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75583/selection/d5ec881bd4e6a005d78e3263615100c2d678c19c11087e5de0d2c1372c31e591" :answer-field/choices ["q-75583/selection/deb3c2333d1c5ac9b3e8adade94146cc940e51dfd7761cca9f6abeb651cb0a9d" "q-75583/selection/e6875ee361b6731bf716b7411b201a5ccd8f5da2d82d19a314fc8fe60e3a71aa" "q-75583/selection/fb9a32945c2b41eb721ff682dee713d725c12580d1304c80cb706ec11f56d356" "q-75583/selection/d5ec881bd4e6a005d78e3263615100c2d678c19c11087e5de0d2c1372c31e591" "q-75583/selection/48a1b6e2047f9c17f1e0cbe98c864c1c48d497e13322bc141ed2b3ba3fb6b4dd"] :db/ensure [:answer-field/validate]} {:db/id "q-75583" :question/id #uuid "8b31d2f7-a6e0-5ec4-9743-3d458a957ec1" :question/math-academy-id "q-75583" :question/problem "Let $f(t)=t\\sqrt[3]{\\operatorname{tan}⁡t}.$ Find ${g}^{′}(\\frac{\\pi }{4})$ given the function $g$ is defined by $g(x)={\\int }_{0}^{x}f(t)\\,\\text{d}t$ for $0<x<\\frac{\\pi }{2}.$" :question/worked-solution "The function $f(t)=t\\sqrt[3]{\\operatorname{tan}⁡t}$ is continuous on $[0,x],$ where $0<x<\\frac{\\pi }{2}.$ So, FTC II applies, and we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{0}^{x}t\\sqrt[3]{\\operatorname{tan}⁡t}\\,\\text{d}t \\\\  & =x\\sqrt[3]{\\operatorname{tan}⁡x}.\\end{aligned}\n$$\n\nFinally, to find the value of ${g}^{′}(\\frac{\\pi }{4}),$ we substitute $x=\\frac{\\pi }{4}$ into the above:\n\n$$\n\\begin{aligned}\\begin{aligned}{g}^{′}(\\frac{\\pi }{4}) & =\\frac{\\pi }{4}\\sqrt[3]{\\operatorname{tan}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{\\pi }{4}\\sqrt[3]{1} \\\\  & =\\frac{\\pi }{4}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75583/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf94b5cf-6407-5931-92df-9f87818e8a71"] :knowledge-point/questions ["q-75583"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30618/selection/c1913ecaa0b8ad556e6501fa15649565f21ed7c744c86e836a96a90560a13d1b" :answer/id #uuid "80bd4f7a-710e-59cd-9e0f-c940a40b5018" :answer/type :answer.type/math :answer/value "2x+5x-2" :db/ensure [:answer/validate]} {:db/id "q-30618/selection/88a47db5e020cd1a62a5d232686833935b3dcae9679147a39edbd82599adfe8f" :answer/id #uuid "91a298e4-ddea-531b-a878-eb9e67f73cac" :answer/type :answer.type/math :answer/value "2x-2" :db/ensure [:answer/validate]} {:db/id "q-30618/selection/11e1156c39a42dc2fcade6b1e4701522e27e53b5149c4c4c2c48c61d5f9e30f2" :answer/id #uuid "b50014eb-37b1-5e7e-b39e-79967c5f2b03" :answer/type :answer.type/math :answer/value "{x}^{2}+2x+5" :db/ensure [:answer/validate]} {:db/id "q-30618/selection/f48c6fa54a6760dceac7fffc3c0e24af5d33c291300f67bf5e2bff19cffdd427" :answer/id #uuid "f80f8d18-7241-5132-a755-c8d2b2d5d4a6" :answer/type :answer.type/math :answer/value "2x+2" :db/ensure [:answer/validate]} {:db/id "q-30618/selection/9d89e755e80af187998e965c71afc317f37d48784f610aefb4ad75cfc9106482" :answer/id #uuid "1f9989e1-a37a-5179-934b-0e67516f6de2" :answer/type :answer.type/math :answer/value "{x}^{2}-2x+5" :db/ensure [:answer/validate]} {:db/id "q-30618/selection" :answer-field/id #uuid "abaf9c92-8c4f-5b30-a893-c6d9a79404fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30618/selection/9d89e755e80af187998e965c71afc317f37d48784f610aefb4ad75cfc9106482" :answer-field/choices ["q-30618/selection/c1913ecaa0b8ad556e6501fa15649565f21ed7c744c86e836a96a90560a13d1b" "q-30618/selection/88a47db5e020cd1a62a5d232686833935b3dcae9679147a39edbd82599adfe8f" "q-30618/selection/11e1156c39a42dc2fcade6b1e4701522e27e53b5149c4c4c2c48c61d5f9e30f2" "q-30618/selection/f48c6fa54a6760dceac7fffc3c0e24af5d33c291300f67bf5e2bff19cffdd427" "q-30618/selection/9d89e755e80af187998e965c71afc317f37d48784f610aefb4ad75cfc9106482"] :db/ensure [:answer-field/validate]} {:db/id "q-30618" :question/id #uuid "2c58494e-2f61-5da1-b978-8b08a71602bf" :question/math-academy-id "q-30618" :question/problem "Calculate\n$\\frac{\\text{d}}{\\text{d}x}{\\int }_{-1}^{x}({t}^{2}-2t+5)\\,\\text{d}t$\nfor $x>-1.$" :question/worked-solution "The function ${t}^{2}-2t+5$ is continuous on $[-1,x]$ where $x>-1.$ So, FTC II applies, and we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{-1}^{x}({t}^{2}-2t+5)\\,\\text{d}t & ={x}^{2}-2x+5.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-30618/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf94b5cf-6407-5931-92df-9f87818e8a71"] :knowledge-point/questions ["q-30618"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332071/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "24d92f18-9896-5815-a91e-2ac8de777387" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332071/field-1" :answer-field/id #uuid "19dba24c-54b5-516b-8240-fe1fff592bd1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332071/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332071/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332071" :question/id #uuid "bd3e742b-7240-59fc-94f4-6663ac30d7db" :question/math-academy-id "q-332071" :question/problem "Let $f(t)=2{t}^{3}+{t}^{2}-1.$ Find ${h}^{′}(0)$ given the function $h$ is defined by $h(x)={\\int }_{x}^{1}f(t)\\,\\text{d}t$ for $x<1.$\n\n${h}^{′}(0)=$\n{{field-1}}" :question/worked-solution "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{1}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t=-{\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{1}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{1}^{x}(2{t}^{3}+{t}^{2}-1)\\,\\text{d}t) \\\\  & =-(2{x}^{3}+{x}^{2}-1).\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(0),$ we substitute $x=0$ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(0) & =-(2\\cdot {0}^{3}+{0}^{2}-1) \\\\  & =-(0+0-1) \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332071/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5075a64-0f91-58cf-b01b-5b71035f0680"] :knowledge-point/questions ["q-332071"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316389/field-1/52e67a3724f0e219cce1a5ffb16b81e4efa1916b0c736705f75b569a781f36f1" :answer/id #uuid "33e429fa-0574-5d0a-9d11-643300181573" :answer/type :answer.type/math :answer/value "-4e^6" :db/ensure [:answer/validate]} {:db/id "q-316389/field-1/8840b372e46b3afec4de68947b8dded984dc91bbc0bd7379bd6151755e9e51b2" :answer/id #uuid "fea009ec-e891-50b7-8ac1-faaacc48e800" :answer/type :answer.type/math :answer/value "4e^6" :db/ensure [:answer/validate]} {:db/id "q-316389/field-1" :answer-field/id #uuid "dd29bc71-9add-50cd-8034-bbbf0e144829" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316389/field-1/52e67a3724f0e219cce1a5ffb16b81e4efa1916b0c736705f75b569a781f36f1" :answer-field/choices ["q-316389/field-1/52e67a3724f0e219cce1a5ffb16b81e4efa1916b0c736705f75b569a781f36f1" "q-316389/field-1/8840b372e46b3afec4de68947b8dded984dc91bbc0bd7379bd6151755e9e51b2"] :db/ensure [:answer-field/validate]} {:db/id "q-316389" :question/id #uuid "bbf23fd5-c7a9-5978-b5c2-9ee5483a0885" :question/math-academy-id "q-316389" :question/problem "Let $f(t)={t}^{2}{e}^{3t}.$ Find ${h}^{′}(2)$ given the function $h$ is defined by $h(x)={\\int }_{x}^{3}f(t)\\,\\text{d}t$ for $x<3.$\n\n${h}^{′}(2)=$\n{{field-1}}" :question/worked-solution "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we prefer the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{3}{t}^{2}{e}^{3t}\\,\\text{d}t=-{\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{3}{t}^{2}{e}^{3t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{3}^{x}{t}^{2}{e}^{3t}\\,\\text{d}t) \\\\  & =-{x}^{2}{e}^{3x}.\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(2),$ we substitute $x=2$ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(2) & =-{2}^{2}\\cdot {e}^{3(2)} \\\\  & =-4{e}^{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316389/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5075a64-0f91-58cf-b01b-5b71035f0680"] :knowledge-point/questions ["q-316389"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316373/field-1/c94c6623ed2a7cd5f804560db676797d26bb38e27b59d95b72d901e192b66c9d" :answer/id #uuid "63ff3cba-ad6a-5e94-bd5e-b12e583ca126" :answer/type :answer.type/math :answer/value "-\\sin(x^2)" :db/ensure [:answer/validate]} {:db/id "q-316373/field-1" :answer-field/id #uuid "558852eb-4f01-5cbd-b343-42bd170341c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316373/field-1/c94c6623ed2a7cd5f804560db676797d26bb38e27b59d95b72d901e192b66c9d" :answer-field/choices ["q-316373/field-1/c94c6623ed2a7cd5f804560db676797d26bb38e27b59d95b72d901e192b66c9d"] :db/ensure [:answer-field/validate]} {:db/id "q-316373" :question/id #uuid "964d2478-77e2-59e8-841e-e018ad51c322" :question/math-academy-id "q-316373" :question/problem "If $x<2,$ then $\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{2}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t=${{field-1}}." :question/worked-solution "Here, the variable limit $x$ appears as the lower limit of integration. To apply FTC II directly, we prefer the variable on the upper limit. Using the property of definite integrals, we rewrite\n\n$$\n{\\int }_{x}^{2}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t=-{\\int }_{2}^{x}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t.\n$$\n\nNow, by FTC II we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{2}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{2}^{x}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}{\\int }_{2}^{x}\\operatorname{sin}⁡({t}^{2})\\,\\text{d}t \\\\  & =-\\operatorname{sin}⁡({x}^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316373/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5075a64-0f91-58cf-b01b-5b71035f0680"] :knowledge-point/questions ["q-316373"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332067/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "601f0262-e552-5bea-9eec-760a76177e8f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-332067/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9117a9b6-8ab8-53fe-866f-6acd9182c966" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332067/field-1" :answer-field/id #uuid "410a2e5f-ab0d-5735-9de9-e05503b26a33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332067/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-332067/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-332067/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332067" :question/id #uuid "7c89f865-0b83-58a4-aac0-5e0e25249852" :question/math-academy-id "q-332067" :question/problem "Let $f(t)=\\operatorname{ln}⁡t\\operatorname{sin}⁡t.$ Find ${h}^{′}(\\pi )$ given the function $h$ is defined by $h(x)={\\int }_{x}^{2\\pi }f(t)\\,\\text{d}t$ for $0<x<2\\pi .$\n\n${h}^{′}(\\pi )=$\n{{field-1}}" :question/worked-solution "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we prefer the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\nh(x)={\\int }_{x}^{2\\pi }\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t=-{\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{2\\pi }\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{2\\pi }^{x}\\operatorname{ln}⁡t\\operatorname{sin}⁡t\\,\\text{d}t) \\\\  & =-\\operatorname{ln}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFinally, to find the value of ${h}^{′}(\\pi ),$ we substitute $x=\\pi $ in the above:\n\n$$\n\\begin{aligned}{h}^{′}(\\pi ) & =-\\operatorname{ln}⁡(\\pi )\\cdot \\operatorname{sin}⁡(\\pi ) \\\\  & =-\\operatorname{ln}⁡\\pi \\cdot 0 \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332067/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5075a64-0f91-58cf-b01b-5b71035f0680"] :knowledge-point/questions ["q-332067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75217/selection/22b50eb154fbb81438f7acffbb7798e5f56c6e6c6fdd73ec4571d349e20ae628" :answer/id #uuid "76f59966-3352-5b9e-97e4-746ee41c03b1" :answer/type :answer.type/math :answer/value "-(x+4)" :db/ensure [:answer/validate]} {:db/id "q-75217/selection/145d6054e0d67a58fd193c60b8ae124fa11465178a0f0e6ed6bdfe2f747ce8c1" :answer/id #uuid "a02138fc-c356-5f9d-9305-9ecc85184c34" :answer/type :answer.type/math :answer/value "(x+4)" :db/ensure [:answer/validate]} {:db/id "q-75217/selection/ecd95efb3cb959ea96bfc8fde2e62c00cddf61e56c5b3909d481e7fb350e5f25" :answer/id #uuid "9aacb5e1-201d-5d08-9edc-a0837653558d" :answer/type :answer.type/math :answer/value "-(x+5)" :db/ensure [:answer/validate]} {:db/id "q-75217/selection/c56a42268579e7fb33f9cdbf4f3b9b5acaf6852f4bd8a7eecf8f6a2d254784d3" :answer/id #uuid "5e02efc0-75af-5b6a-bb13-a33fca702adb" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{2}+7x+12}{x-2}" :db/ensure [:answer/validate]} {:db/id "q-75217/selection/54d10e0f9fb2af6f9c2f345147ad1e8762feb39e51f990e37ae81e48c3ea15d0" :answer/id #uuid "14d0f2ad-92d5-5fc2-a2a2-6848e63e9d1d" :answer/type :answer.type/math :answer/value "\\frac{2x+7}{x-2}" :db/ensure [:answer/validate]} {:db/id "q-75217/selection" :answer-field/id #uuid "761fa7ca-df8b-51ac-b133-cc164da689b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75217/selection/c56a42268579e7fb33f9cdbf4f3b9b5acaf6852f4bd8a7eecf8f6a2d254784d3" :answer-field/choices ["q-75217/selection/22b50eb154fbb81438f7acffbb7798e5f56c6e6c6fdd73ec4571d349e20ae628" "q-75217/selection/145d6054e0d67a58fd193c60b8ae124fa11465178a0f0e6ed6bdfe2f747ce8c1" "q-75217/selection/ecd95efb3cb959ea96bfc8fde2e62c00cddf61e56c5b3909d481e7fb350e5f25" "q-75217/selection/c56a42268579e7fb33f9cdbf4f3b9b5acaf6852f4bd8a7eecf8f6a2d254784d3" "q-75217/selection/54d10e0f9fb2af6f9c2f345147ad1e8762feb39e51f990e37ae81e48c3ea15d0"] :db/ensure [:answer-field/validate]} {:db/id "q-75217" :question/id #uuid "94fa79a1-d796-5df1-8f75-14242dc59a6d" :question/math-academy-id "q-75217" :question/problem "Calculate\n$\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{0}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t$\nfor $x<0.$" :question/worked-solution "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\n{\\int }_{x}^{0}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t=-{\\int }_{0}^{x}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{x}^{0}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{0}^{x}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{0}^{x}\\frac{{t}^{2}+7t+12}{t-2}\\,\\text{d}t) \\\\  & =-\\frac{{x}^{2}+7x+12}{x-2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75217/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5075a64-0f91-58cf-b01b-5b71035f0680"] :knowledge-point/questions ["q-75217"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333573/field-1/c57299747f0621628721a403ad7edc0bbc2e4ca535f9dbf5f35463af99e05ab7" :answer/id #uuid "047b6330-dc47-5782-a93c-4e203e18aa67" :answer/type :answer.type/math :answer/value "3x^{11}-6x^5" :db/ensure [:answer/validate]} {:db/id "q-333573/field-1" :answer-field/id #uuid "5fcd6320-af3b-50cb-8b93-61aee974c5ea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333573/field-1/c57299747f0621628721a403ad7edc0bbc2e4ca535f9dbf5f35463af99e05ab7" :answer-field/choices ["q-333573/field-1/c57299747f0621628721a403ad7edc0bbc2e4ca535f9dbf5f35463af99e05ab7"] :db/ensure [:answer-field/validate]} {:db/id "q-333573" :question/id #uuid "caf3e0e6-df65-5a67-9c9b-e28b29e53d7d" :question/math-academy-id "q-333573" :question/problem "Find ${g}^{′}(x)$ if $g(x)={\\int }_{0}^{{x}^{3}}({t}^{3}-2t)\\,\\text{d}t.$\n\n${g}^{′}(x)=$ \n{{field-1}}" :question/worked-solution "To compute ${g}^{′}(x),$ we first make the substitution $u={x}^{3}$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{0}^{{x}^{3}}({t}^{3}-2t)\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}({t}^{3}-2t)\\,\\text{d}t\\end{aligned}\n$$\n\nThe integrand is continuous on $[0,u].$ Therefore, by FTC II, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}({t}^{3}-2t)\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot ({u}^{3}-2u) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})\\cdot (({x}^{3})^{3}-2({x}^{3})) \\\\  & =3{x}^{2}\\cdot ({x}^{9}-2{x}^{3}) \\\\  & =3{x}^{2}({x}^{9}-2{x}^{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333573/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0703e1b-2b81-5b95-b2ad-a7e42e702c21"] :knowledge-point/questions ["q-333573"] :db/ensure [:knowledge-point/validate]} {:db/id "q-4553/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5b00ba3a-496f-58be-9948-56ee8204f8a2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-4553/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "696cdcc2-51da-5b11-860d-d7e89bf3c2d0" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-4553/selection/1cbd653029d187d9d275880d73c2682459afa80fd8507dd16e6e5dd2b088e9dd" :answer/id #uuid "ef5aa62e-68ee-5a37-a279-604349a87ca4" :answer/type :answer.type/math :answer/value "2\\sqrt{15}" :db/ensure [:answer/validate]} {:db/id "q-4553/selection/183e897125984dc7d173207cb97dc8f23eafcaff3cd4b6a1b325e3bc2a195b6a" :answer/id #uuid "5e7b05ec-b43b-5adb-88e5-a3ddf5b979de" :answer/type :answer.type/math :answer/value "8\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-4553/selection/28cbd8709c9ed788764382635111bcbfd311300a8084f94e186f51653baf2d21" :answer/id #uuid "5f876eac-832a-5e8a-a18c-ab96aa548409" :answer/type :answer.type/math :answer/value "4\\sqrt{15}" :db/ensure [:answer/validate]} {:db/id "q-4553/selection" :answer-field/id #uuid "6013b560-f643-52c0-997d-0659c95349b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-4553/selection/28cbd8709c9ed788764382635111bcbfd311300a8084f94e186f51653baf2d21" :answer-field/choices ["q-4553/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-4553/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-4553/selection/1cbd653029d187d9d275880d73c2682459afa80fd8507dd16e6e5dd2b088e9dd" "q-4553/selection/183e897125984dc7d173207cb97dc8f23eafcaff3cd4b6a1b325e3bc2a195b6a" "q-4553/selection/28cbd8709c9ed788764382635111bcbfd311300a8084f94e186f51653baf2d21"] :db/ensure [:answer-field/validate]} {:db/id "q-4553" :question/id #uuid "c07e1de1-cd19-51e2-9521-40cd741e9f90" :question/math-academy-id "q-4553" :question/problem "Find ${f}^{′}(2)$ if $f(x)={\\int }_{2}^{2x}\\sqrt{{t}^{3}-t}\\,\\text{d}t.$" :question/worked-solution "To compute ${f}^{′}(x),$ we first make the substitution $u=2x$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{2}^{2x}\\sqrt{{t}^{3}-t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{2}^{u}\\sqrt{{t}^{3}-t}\\,\\text{d}t\\end{aligned}\\end{aligned}\n$$\n\nThe integrand is continuous on $[2,u],$ and so by FTC II we get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\sqrt{{u}^{3}-u} \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2x)\\cdot \\sqrt{(2x)^{3}-(2x)} \\\\  & =2\\sqrt{8{x}^{3}-2x}.\\end{aligned}\\end{aligned}\n$$\n\nFinally, to find the value of ${f}^{′}(2),$ we substitute $x=2$ in the above:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(2) & =2\\sqrt{8(2)^{3}-2(2)} \\\\  & =2\\sqrt{64-4} \\\\  & =4\\sqrt{15}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-4553/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0703e1b-2b81-5b95-b2ad-a7e42e702c21"] :knowledge-point/questions ["q-4553"] :db/ensure [:knowledge-point/validate]} {:db/id "q-4776/selection/192c6030d8816553cdfcf13c7f5f26bd0bc0f29788b453b1e64332880bc35044" :answer/id #uuid "2750f188-1555-5a7c-bf96-b1a2e625394f" :answer/type :answer.type/math :answer/value "\\frac{1}{x}" :db/ensure [:answer/validate]} {:db/id "q-4776/selection/69e937132f461dc59e07300f58a72cb8bee2e42e353b92b6f0a39e7742431e7b" :answer/id #uuid "19c69a97-5494-57e3-a028-bdbadf73474d" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-4776/selection/9548f21f2a1d62934fc93a12558e018ef7fca8be3be6d35da647d99e0199b83d" :answer/id #uuid "c86282f8-f50b-5e80-afbb-504815f405f6" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-4776/selection/519335d79487260f7556d67079cf42cdf5bc60afab6dcfa560001c704ab43319" :answer/id #uuid "b362d609-9c9f-569c-a798-c880a9381f08" :answer/type :answer.type/math :answer/value "-\\frac{2}{x}" :db/ensure [:answer/validate]} {:db/id "q-4776/selection/da1e2ee83a948d87f5a1d96dda4b6d5e3c16439006d20546b9e74e8f37a8756c" :answer/id #uuid "fd45bf03-6e24-54f0-9207-b2f04081d85a" :answer/type :answer.type/math :answer/value "-x" :db/ensure [:answer/validate]} {:db/id "q-4776/selection" :answer-field/id #uuid "9f7b4c45-d028-59ab-8a8f-0f782cb30f5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-4776/selection/519335d79487260f7556d67079cf42cdf5bc60afab6dcfa560001c704ab43319" :answer-field/choices ["q-4776/selection/192c6030d8816553cdfcf13c7f5f26bd0bc0f29788b453b1e64332880bc35044" "q-4776/selection/69e937132f461dc59e07300f58a72cb8bee2e42e353b92b6f0a39e7742431e7b" "q-4776/selection/9548f21f2a1d62934fc93a12558e018ef7fca8be3be6d35da647d99e0199b83d" "q-4776/selection/519335d79487260f7556d67079cf42cdf5bc60afab6dcfa560001c704ab43319" "q-4776/selection/da1e2ee83a948d87f5a1d96dda4b6d5e3c16439006d20546b9e74e8f37a8756c"] :db/ensure [:answer-field/validate]} {:db/id "q-4776" :question/id #uuid "253bec95-1329-5337-b512-00619d2a4dbc" :question/math-academy-id "q-4776" :question/problem "For $x>0,$ find ${f}^{′}(x)$ if $f(x)={\\int }_{-{x}^{2}}^{-4}\\frac{1}{t}\\,\\text{d}t.$" :question/worked-solution "To compute ${f}^{′}(x),$ we first make the substitution $u=-{x}^{2}$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{-{x}^{2}}^{-4}\\frac{1}{t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{-4}\\frac{1}{t}\\,\\text{d}t\\end{aligned}\\end{aligned}\n$$\n\nThe limit $u$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of the definite integrals, we can write\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{-4}\\frac{1}{t}\\,\\text{d}t & =\\frac{\\text{d}}{\\text{d}u}(-{\\int }_{-4}^{u}\\frac{1}{t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}u}{\\int }_{-4}^{u}\\frac{1}{t}\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\frac{\\text{d}}{\\text{d}u}{\\int }_{-4}^{u}\\frac{1}{t}\\,\\text{d}t) \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\frac{1}{u}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-{x}^{2})\\cdot (-\\frac{1}{u}) \\\\  & =-2x\\cdot (-\\frac{1}{-{x}^{2}}) \\\\  & =-2x\\cdot \\frac{1}{{x}^{2}} \\\\  & =-\\frac{2}{x}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-4776/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0703e1b-2b81-5b95-b2ad-a7e42e702c21"] :knowledge-point/questions ["q-4776"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316401/field-1/e747907ffecd6882e206a60e77699b41671426bc3422ee237602699ac69547b9" :answer/id #uuid "2564531a-7553-506e-9554-e8994460b02a" :answer/type :answer.type/math :answer/value "-e^x\\cos(e^{3x})" :db/ensure [:answer/validate]} {:db/id "q-316401/field-1/06f488197dee1f02ac991d52c110106574baf5ad32a03ba4676e4f486ec803a6" :answer/id #uuid "b2f4d357-a6b9-5c57-9ef9-4a0ecc205abb" :answer/type :answer.type/math :answer/value "e^x\\cos(e^{3x})" :db/ensure [:answer/validate]} {:db/id "q-316401/field-1" :answer-field/id #uuid "eb542cc0-a312-5033-b7ea-41072d444b9b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316401/field-1/e747907ffecd6882e206a60e77699b41671426bc3422ee237602699ac69547b9" :answer-field/choices ["q-316401/field-1/e747907ffecd6882e206a60e77699b41671426bc3422ee237602699ac69547b9" "q-316401/field-1/06f488197dee1f02ac991d52c110106574baf5ad32a03ba4676e4f486ec803a6"] :db/ensure [:answer-field/validate]} {:db/id "q-316401" :question/id #uuid "64a8ab90-732d-5ddf-a15d-bdcfaa0872b0" :question/math-academy-id "q-316401" :question/problem "Find ${g}^{′}(x)$ for $g(x)={\\int }_{{e}^{x}}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t.$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "To compute ${g}^{′}(x),$ we first make the substitution $u={e}^{x}$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{{e}^{x}}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t\\end{aligned}\n$$\n\nThe limit $u$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t & =\\frac{\\text{d}}{\\text{d}u}(-{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}u}{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{u}^{5}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\frac{\\text{d}}{\\text{d}u}{\\int }_{5}^{u}\\operatorname{cos}⁡({t}^{3})\\,\\text{d}t) \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot (-\\operatorname{cos}⁡({u}^{3})) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})\\cdot (-\\operatorname{cos}⁡(({e}^{x})^{3})) \\\\  & =-{e}^{x}\\operatorname{cos}⁡({e}^{3x}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-316401/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0703e1b-2b81-5b95-b2ad-a7e42e702c21"] :knowledge-point/questions ["q-316401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333563/field-1/2d3a984d13fcfa2d49a4379c1a5f4004efc66432e70e3935f9a89e4c01ad5e11" :answer/id #uuid "2c51ff18-4f24-571b-9e30-6b40ac4b542c" :answer/type :answer.type/math :answer/value "3x^2" :db/ensure [:answer/validate]} {:db/id "q-333563/field-1" :answer-field/id #uuid "76ab5b15-4d7c-5988-9774-8dc401899170" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333563/field-1/2d3a984d13fcfa2d49a4379c1a5f4004efc66432e70e3935f9a89e4c01ad5e11" :answer-field/choices ["q-333563/field-1/2d3a984d13fcfa2d49a4379c1a5f4004efc66432e70e3935f9a89e4c01ad5e11"] :db/ensure [:answer-field/validate]} {:db/id "q-333563" :question/id #uuid "110184fb-4f4b-5c53-bfd3-fe4e1173890d" :question/math-academy-id "q-333563" :question/problem "Find ${g}^{′}(x)$ if $g(x)={\\int }_{0}^{{x}^{3}+1}{e}^{t}\\,\\text{d}t.$\n\n${g}^{′}(x)=$ \n{{field-1}} ${e}^{{x}^{3}+1}$" :question/worked-solution "To compute ${g}^{′}(x),$ we first make the substitution $u={x}^{3}+1$ and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{0}^{{x}^{3}+1}{e}^{t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}{e}^{t}\\,\\text{d}t\\end{aligned}\n$$\n\nThe integrand is continuous on $[0,u].$ Therefore, by FTC II, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{0}^{u}{e}^{t}\\,\\text{d}t \\\\  & =\\frac{\\text{d}u}{\\text{d}x}\\cdot {e}^{u} \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+1)\\cdot {e}^{{x}^{3}+1} \\\\  & =3{x}^{2}\\cdot {e}^{{x}^{3}+1} \\\\  & =3{x}^{2}\\,{e}^{{x}^{3}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333563/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0703e1b-2b81-5b95-b2ad-a7e42e702c21"] :knowledge-point/questions ["q-333563"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333952/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "644d5b2b-40e5-501b-9822-e49577403178" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-333952/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "08d345e1-830a-5cef-b585-ba6bb99c16b0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-333952/field-1" :answer-field/id #uuid "9ca5ae5b-cd4d-533c-b91b-1a241d120141" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333952/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-333952/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-333952/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-333952" :question/id #uuid "845f0089-00c1-55c9-9061-c3bdb326a9aa" :question/math-academy-id "q-333952" :question/problem "If $G(x)={\\int }_{x}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t,$ then ${G}^{′}(0)=${{field-1}}." :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t & ={\\int }_{x}^{a}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{cos}⁡(x).$\n\nThe integrand ${e}^{t}$ is continuous for all $t.$ Therefore, applying the FTC II, we have\n\n$$\n\\begin{aligned}{G}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}{e}^{t}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}{e}^{t}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{cos}⁡(x)}{e}^{t}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}{e}^{t}\\,\\text{d}t)+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}{e}^{t}\\,\\text{d}t) \\\\  & =-{e}^{x}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))\\cdot {e}^{u} \\\\  & =-{e}^{x}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))\\cdot {e}^{\\operatorname{cos}⁡(x)} \\\\  & =-{e}^{x}-\\operatorname{sin}⁡(x)\\cdot {e}^{\\operatorname{cos}⁡(x)}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{cos}⁡(x).$\n\nFinally, we can compute ${G}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{G}^{′}(0) & =-{e}^{0}-\\operatorname{sin}⁡(0)\\cdot {e}^{\\operatorname{cos}⁡(0)} \\\\  & =-1-0 \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-333952/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f"] :knowledge-point/questions ["q-333952"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333882/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e4efc0b0-5690-5dcb-bda3-90185ceaff37" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-333882/field-1" :answer-field/id #uuid "b9daacc8-19e7-529a-9a8a-0c2f8745cf0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333882/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-333882/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-333882" :question/id #uuid "36b5cbf2-4547-50e0-a29e-914ff91501a4" :question/math-academy-id "q-333882" :question/problem "If $G(x)={\\int }_{x}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t,$ then ${G}^{′}(0)=${{field-1}}." :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t & ={\\int }_{x}^{a}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\operatorname{tan}⁡(x).$\n\nThe integrand $(1+{t}^{2})^{2}$ is continuous for all $t.$ Therefore, applying the FTC II, we have\n\n$$\n\\begin{aligned}{G}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t+{\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}(1+{t}^{2})^{2}\\,\\text{d}t)+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{\\operatorname{tan}⁡(x)}(1+{t}^{2})^{2}\\,\\text{d}t) \\\\  & =-(1+{x}^{2})^{2}+\\frac{\\text{d}u}{\\text{d}x}\\cdot {(1+{u}^{2})}^{2} \\\\  & =-(1+{x}^{2})^{2}+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(x))\\cdot {(1+{tan}^{2}⁡(x))}^{2} \\\\  & =-(1+{x}^{2})^{2}+{sec}^{2}⁡(x)\\cdot {(1+{tan}^{2}⁡(x))}^{2}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{tan}⁡(x).$\n\nFinally, we can compute ${G}^{′}(0).$ We get\n\n$$\n\\begin{aligned}{G}^{′}(0) & =-(1+{0}^{2})^{2}+{sec}^{2}⁡(0)\\cdot {(1+{tan}^{2}⁡(0))}^{2} \\\\  & =-1+1\\cdot {1}^{2} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-333882/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f"] :knowledge-point/questions ["q-333882"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117289/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "99a92494-e0cf-52de-ab02-c000b4dbf8c7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-117289/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "04bfafa5-fff9-51cb-b195-6f5f762d519a" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-117289/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "7e7753f8-282c-5360-ba7a-676831fb28da" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-117289/selection/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" :answer/id #uuid "94e7b54e-df1b-564b-b397-7d7a260ed3d3" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-117289/selection/b01ba7e917b2f2dc3ff90ccb2c435764c9ebef2dea263cc318e0c231eb7eeb1d" :answer/id #uuid "c9e568fc-550a-5922-ace2-4495328f1423" :answer/type :answer.type/math :answer/value "-\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-117289/selection" :answer-field/id #uuid "05575e57-4021-5a57-b22c-aa88d47b637a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-117289/selection/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" :answer-field/choices ["q-117289/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-117289/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" "q-117289/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-117289/selection/aa640bdf1bd5b2b15c3dbfe770f68b41d304d610e4d1af786c1f1372fe3dc48f" "q-117289/selection/b01ba7e917b2f2dc3ff90ccb2c435764c9ebef2dea263cc318e0c231eb7eeb1d"] :db/ensure [:answer-field/validate]} {:db/id "q-117289" :question/id #uuid "1a5fda93-db37-5201-9a1b-f45b1acfcd5a" :question/math-academy-id "q-117289" :question/problem "Find ${f}^{′}(1)$ if $f(x)={\\int }_{x}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t.$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{x}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t & ={\\int }_{x}^{a}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $\\sqrt{x}.$\n\nThe integrand $\\frac{1}{{t}^{4}+3}$ is continuous for all $t,$ so applying the FTC II gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t+{\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}\\frac{1}{{t}^{4}+3}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\sqrt{x}}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}\\frac{1}{{t}^{4}+3}\\,\\text{d}t) \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{1}{2\\sqrt{x}}\\cdot \\frac{1}{{u}^{4}+3} \\\\  & =-\\frac{1}{{x}^{4}+3}+\\frac{1}{2\\sqrt{x}((\\sqrt{x})^{4}+3)} \\\\  & =\\frac{1}{2\\sqrt{x}({x}^{2}+3)}-\\frac{1}{{x}^{4}+3}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\sqrt{x}.$\n\nFinally, we can compute ${f}^{′}(1).$ We get\n\n$$\n\\begin{aligned}{f}^{′}(1) & =\\frac{1}{2\\sqrt{1}({1}^{2}+3)}-\\frac{1}{{1}^{4}+3} \\\\  & =\\frac{1}{8}-\\frac{1}{4} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f"] :knowledge-point/questions ["q-117289"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75458/selection/6ca7336989d6213220798ce50974a32843ebfaf1a0ddbf815402e5e0caed89e3" :answer/id #uuid "53ca0fd6-7484-511e-b736-5a2e1a1d8021" :answer/type :answer.type/math :answer/value "\\frac{e}{2+{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-75458/selection/379e1a7358d77875c17561b7af69b16062b2814d9352925f34e9ef35ee1917d2" :answer/id #uuid "b52753b0-1bf4-5820-8b27-afea450c25ba" :answer/type :answer.type/math :answer/value "\\frac{1}{3e}" :db/ensure [:answer/validate]} {:db/id "q-75458/selection/1ca0fcfab814d3143f97fff1b4fb80370293eea77e86ffac7938a545ff8cccbf" :answer/id #uuid "5c468f91-19d1-520d-b09a-94666178fd8c" :answer/type :answer.type/math :answer/value "\\frac{e}{2+{e}^{2}}-\\frac{1}{3e}" :db/ensure [:answer/validate]} {:db/id "q-75458/selection/0aae2595e057793e7566cc74436e209be2bb52517570bdf224227b82ab38c04b" :answer/id #uuid "366d8039-7f11-582a-8502-6deb1a331a86" :answer/type :answer.type/math :answer/value "\\frac{e}{2+{e}^{2}}-\\frac{1}{{e}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-75458/selection/adc63e772377b8bd3298c1c09a25fecb844063f6c58c5d1ab63dcc15e22a76af" :answer/id #uuid "a13a3755-7b59-5e30-a433-f21ece8342ff" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-75458/selection" :answer-field/id #uuid "a59c82ba-af0b-5b0e-8ff5-2ec31d060609" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75458/selection/1ca0fcfab814d3143f97fff1b4fb80370293eea77e86ffac7938a545ff8cccbf" :answer-field/choices ["q-75458/selection/6ca7336989d6213220798ce50974a32843ebfaf1a0ddbf815402e5e0caed89e3" "q-75458/selection/379e1a7358d77875c17561b7af69b16062b2814d9352925f34e9ef35ee1917d2" "q-75458/selection/1ca0fcfab814d3143f97fff1b4fb80370293eea77e86ffac7938a545ff8cccbf" "q-75458/selection/0aae2595e057793e7566cc74436e209be2bb52517570bdf224227b82ab38c04b" "q-75458/selection/adc63e772377b8bd3298c1c09a25fecb844063f6c58c5d1ab63dcc15e22a76af"] :db/ensure [:answer-field/validate]} {:db/id "q-75458" :question/id #uuid "b368aef2-d174-5fff-ab87-437a429b2144" :question/math-academy-id "q-75458" :question/problem "Find ${F}^{′}(e)$ if $F(x)={\\int }_{\\operatorname{ln}⁡(x)}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t.$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡(x)}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t & ={\\int }_{\\operatorname{ln}⁡(x)}^{a}\\frac{t}{2+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t \\\\  & =-{\\int }_{a}^{\\operatorname{ln}⁡(x)}\\frac{t}{2+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t,\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $\\operatorname{ln}⁡x$ and $x.$\n\nThe integrand $\\frac{t}{2+{t}^{2}}$ is continuous for all $t,$ so applying FTC II gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{\\operatorname{ln}⁡(x)}\\frac{t}{2+{t}^{2}}\\,\\text{d}t+{\\int }_{a}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{\\operatorname{ln}⁡(x)}\\frac{t}{2+{t}^{2}}\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}\\frac{t}{2+{t}^{2}}\\,\\text{d}t) \\\\  & =-\\frac{\\text{du}}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}\\frac{t}{2+{t}^{2}}\\,\\text{d}t)+\\frac{x}{2+{x}^{2}} \\\\  & =-\\frac{1}{x}(\\frac{u}{2+{u}^{2}})+\\frac{x}{2+{x}^{2}} \\\\  & =-\\frac{1}{x}(\\frac{\\operatorname{ln}⁡(x)}{2+(\\operatorname{ln}⁡x)^{2}})+\\frac{x}{2+{x}^{2}} \\\\  & =\\frac{x}{2+{x}^{2}}-\\frac{\\operatorname{ln}⁡(x)}{2x+x(\\operatorname{ln}⁡(x))^{2}}.\\end{aligned}\n$$\n\nNote that we used the substitution $u=\\operatorname{ln}⁡(x).$\n\nFinally, we can compute ${F}^{′}(e).$ We get\n\n$$\n\\begin{aligned}{F}^{′}(e) & =\\frac{e}{2+{e}^{2}}-\\frac{\\operatorname{ln}⁡e}{2e+e(\\operatorname{ln}⁡e)^{2}} \\\\  & =\\frac{e}{2+{e}^{2}}-\\frac{1}{2e+e} \\\\  & =\\frac{e}{2+{e}^{2}}-\\frac{1}{3e}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a0f285ec-4f37-5d0d-a65c-be3ca48c740f"] :knowledge-point/questions ["q-75458"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-438"] :question/problem "Calculate $\\displaystyle\\dfrac {\\textrm d} {\\textrm dx} \\int_2^x \\dfrac {t^3} {t-1}\\,\\textrm d t$ for $x>2.$" :question/worked-solution "The function $\\dfrac {t^3} {t-1}$ is continuous on $[2,x],$ where $x>2.$ So FTC II applies, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{2}^{x}\\frac{{t}^{3}}{t-1}\\,\\text{d}t=\\frac{{x}^{3}}{x-1}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-439"] :question/problem "Calculate $\\displaystyle\\dfrac {\\textrm d} {\\textrm dx} \\int_x^0  \\dfrac{t^3}{t^2 +1}\\,\\textrm d t.$" :question/worked-solution "In this example, the variable limit $x$ is located on the lower limit. To apply FTC II, we need the variable to be on the upper limit. Using the properties of definite integrals, we can write\n\n$$\n\\displaystyle \\int_x^0 \\dfrac{t^3}{t^2 +1} \\,\\textrm d t  = -  \\int_0^x \\dfrac{t^3}{t^2 +1}\\,\\textrm d t.\n$$\n\nTherefore, by FTC II, we have\n\n$$\n\\eqalign{\n \\displaystyle\\dfrac {\\textrm d} {\\textrm dx} \\int_x^0  \\dfrac{t^3}{t^2 +1} \\,\\textrm d t \n\t& \\, \\, = \\, \\, \\dfrac {\\textrm d} {\\textrm dx} \\left(-\\int_0^x \\dfrac{t^3}{t^2 +1} \\,\\textrm d t \\right)\\\n\t& \\, \\, = \\, \\, -\\dfrac {\\textrm d} {\\textrm dx} \\left(\\int_0^x \\dfrac{t^3}{t^2 +1} \\,\\textrm d t \\right)\\\n\t&= \\, \\, -\\dfrac{x^3}{x^2 +1}.}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-440"] :question/problem "Find $f'(x)$ for $f(x) = \\displaystyle \\int_2^{x^2}\\arctan t\\,\\textrm d t.$" :question/worked-solution "To compute $f'(x),$  we first make the substitution $u=x^2$  and then we apply the chain rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}{\\int }_{2}^{{x}^{2}}\\operatorname{arctan}⁡t\\,\\text{d}t \\\\  & =\\frac{\\text{du}}{\\text{d}x}\\cdot \\frac{\\text{d}}{\\text{d}u}{\\int }_{2}^{u}\\operatorname{arctan}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\n \n\nThe integrand is continuous for all $t,$ so by FTC II we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}u}{\\text{d}x}\\cdot \\operatorname{arctan}⁡(u) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})\\cdot \\operatorname{arctan}⁡(u) \\\\  & =2x\\operatorname{arctan}⁡({x}^{2}).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-441"] :question/problem "Find $f'(1)$ if  $\\displaystyle f(x) = \\int_x^{x^2} (t^2 + 2t)  \\,\\, \\textrm d t.$" :question/worked-solution "Here, both the lower and upper limits contain a variable. However, to apply FTC II, we need the variable to be on the upper limit only. So, we can split the integral into two integrals, and rewrite them so that in both cases the variable is on the upper limit. We get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{x}^{{x}^{2}}({t}^{2}+2t)\\,\\text{d}t & ={\\int }_{x}^{a}({t}^{2}+2t)\\,\\text{d}t+{\\int }_{a}^{{x}^{2}}({t}^{2}+2t)\\,\\text{d}t \\\\  & =-{\\int }_{a}^{x}({t}^{2}+2t)\\,\\text{d}t+{\\int }_{a}^{{x}^{2}}({t}^{2}+2t)\\,\\text{d}t,\\end{aligned}\\end{aligned}\n$$\n\nwhere $a$ is any constant number between $x$ and $x^2.$\n\nThe integrand $t^2 + 2t$ is continuous for all $t,$ so applying FTC II gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-{\\int }_{a}^{x}({t}^{2}+2t)\\,\\text{d}t+{\\int }_{a}^{{x}^{2}}({t}^{2}+2t)\\,\\text{d}t) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{x}({t}^{2}+2t)\\,\\text{d}t)+\\frac{\\text{d}}{\\text{d}x}({\\int }_{a}^{{x}^{2}}({t}^{2}+2t)\\,\\text{d}t) \\\\  & =-({x}^{2}+2x)+\\frac{\\text{d}u}{\\text{d}x}\\frac{\\text{d}}{\\text{d}u}({\\int }_{a}^{u}({t}^{2}+2t)\\,\\text{d}t) \\\\  & =-{x}^{2}-2x+2x({u}^{2}+2u) \\\\  & =-{x}^{2}-2x+2x(({x}^{2})^{2}+2{x}^{2}) \\\\  & =-{x}^{2}-2x+2x({x}^{4}+2{x}^{2}) \\\\  & =-{x}^{2}-2x+2{x}^{5}+4{x}^{3} \\\\  & =2{x}^{5}+4{x}^{3}-{x}^{2}-2x.\\end{aligned}\n$$\n\nNote that we used the substitution $u=x^2,$ as before.\n\nFinally, we can compute $f'(1).$ We get\n\n$$\n\\begin{aligned}{f}^{′}(1) & =2(1)^{5}+4(1)^{3}-(1)^{2}-2(1) \\\\  & =2+4-1-2 \\\\  & =3.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
