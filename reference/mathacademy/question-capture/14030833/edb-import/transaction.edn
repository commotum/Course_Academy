[{:db/id "q-3038/selection/eb83598dd0ae6a842948fb6ab23713ee6e4bdf6d74ca23e21c4cfe97e1d6e552" :answer/id #uuid "a3b721c0-e203-5134-a61c-c8c523281190" :answer/type :answer.type/math :answer/value "-\\operatorname{tan}⁡(\\frac{1}{x})+C" :db/ensure [:answer/validate]} {:db/id "q-3038/selection/d612e35da16dd66b861057ce52180f68846bb482af9be2df558cff02d5c4c013" :answer/id #uuid "1e2effa8-cb26-5d13-91b2-d7d58efee624" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡(\\frac{1}{x})+C" :db/ensure [:answer/validate]} {:db/id "q-3038/selection/39a9f99258741677c0fd8d25838053fed4bf341922870237977e24554bbaa7fd" :answer/id #uuid "5ce02167-e712-5bf4-8f5e-56c70f44ee58" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡(\\frac{1}{x})+C" :db/ensure [:answer/validate]} {:db/id "q-3038/selection/02666c86594751b028195a492fb0cf916745dd54f4fa24614a37bc72fbadfbdf" :answer/id #uuid "0eb4d2bb-fdc6-52d2-8431-faced7e42df6" :answer/type :answer.type/math :answer/value "2\\operatorname{tan}⁡(\\frac{1}{x})+C" :db/ensure [:answer/validate]} {:db/id "q-3038/selection/b2efafe5006c460dfe877f6dafc166b15c436efdef7fdfa83da9e71d7fc33cee" :answer/id #uuid "1b16369d-f215-5951-975b-b93fbbea1d82" :answer/type :answer.type/math :answer/value "-\\operatorname{csc}⁡(\\frac{1}{x})+C" :db/ensure [:answer/validate]} {:db/id "q-3038/selection" :answer-field/id #uuid "5622a881-5efd-551d-bacc-0d4f2606b172" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3038/selection/eb83598dd0ae6a842948fb6ab23713ee6e4bdf6d74ca23e21c4cfe97e1d6e552" :answer-field/choices ["q-3038/selection/eb83598dd0ae6a842948fb6ab23713ee6e4bdf6d74ca23e21c4cfe97e1d6e552" "q-3038/selection/d612e35da16dd66b861057ce52180f68846bb482af9be2df558cff02d5c4c013" "q-3038/selection/39a9f99258741677c0fd8d25838053fed4bf341922870237977e24554bbaa7fd" "q-3038/selection/02666c86594751b028195a492fb0cf916745dd54f4fa24614a37bc72fbadfbdf" "q-3038/selection/b2efafe5006c460dfe877f6dafc166b15c436efdef7fdfa83da9e71d7fc33cee"] :db/ensure [:answer-field/validate]} {:db/id "q-3038" :question/id #uuid "7b8b9fd5-920e-5e84-a786-4e2fa1bbbe7a" :question/math-academy-id "q-3038" :question/problem "Calculate the integral $\\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let $u=\\frac{1}{x}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{{x}^{2}}\\,⟹\\,-\\text{d}u=\\frac{1}{{x}^{2}}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x & =\\int {sec}^{2}⁡(\\frac{1}{x})\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡u\\cdot (-\\text{d}u) \\\\  & =-\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =-\\operatorname{tan}⁡u+C \\\\  & =-\\operatorname{tan}⁡(\\frac{1}{x})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-3038/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d359337c-4ec2-5100-bdac-d0858619db3b"] :knowledge-point/questions ["q-3038"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10045/selection/fcea8cfb384bdba175fd1e9521ac467b4532ae3fa3be500ebb29de22bfebda6d" :answer/id #uuid "b901a701-0924-534c-b204-f56250140f6d" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1+\\operatorname{sin}⁡(1))-\\operatorname{ln}⁡(1-\\operatorname{sin}⁡(1))" :db/ensure [:answer/validate]} {:db/id "q-10045/selection/8f9c0400688c981a4ab6f3c8a8b13b41e2fddc39cb4df4a64bd042804d91d89c" :answer/id #uuid "885b624b-818d-5f19-866a-7b99e939245a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2-\\operatorname{sin}⁡(1))+\\operatorname{ln}⁡(2+\\operatorname{sin}⁡(1))" :db/ensure [:answer/validate]} {:db/id "q-10045/selection/063637862443b014f0588cc8974f065842c72645f73373e1e1cce0b8c2996cde" :answer/id #uuid "8d34198a-cd07-5a08-8aa8-38d1e2ffa00f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2+\\operatorname{sin}⁡(1))+\\operatorname{ln}⁡(2-\\operatorname{sin}⁡(1))" :db/ensure [:answer/validate]} {:db/id "q-10045/selection/593efd0318a613038398afedd4862cae35d51c432458cefbdcbe51ad46710554" :answer/id #uuid "799aeb84-bdc6-54e2-9dcf-c48d0a462d72" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡(1+\\operatorname{sin}⁡(2))-\\operatorname{ln}⁡(1-\\operatorname{sin}⁡(2))" :db/ensure [:answer/validate]} {:db/id "q-10045/selection/b6381be2e3377271dd17d0f48d7dac8f0d64169838b880092cbd0e53c047de1c" :answer/id #uuid "d032cadd-d126-5a42-9992-e1de343fc13a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1-\\operatorname{sin}⁡(2))-\\operatorname{ln}⁡(1+\\operatorname{sin}⁡(2))" :db/ensure [:answer/validate]} {:db/id "q-10045/selection" :answer-field/id #uuid "a27a8296-3fbc-593b-990f-f3a8856f80ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10045/selection/fcea8cfb384bdba175fd1e9521ac467b4532ae3fa3be500ebb29de22bfebda6d" :answer-field/choices ["q-10045/selection/fcea8cfb384bdba175fd1e9521ac467b4532ae3fa3be500ebb29de22bfebda6d" "q-10045/selection/8f9c0400688c981a4ab6f3c8a8b13b41e2fddc39cb4df4a64bd042804d91d89c" "q-10045/selection/063637862443b014f0588cc8974f065842c72645f73373e1e1cce0b8c2996cde" "q-10045/selection/593efd0318a613038398afedd4862cae35d51c432458cefbdcbe51ad46710554" "q-10045/selection/b6381be2e3377271dd17d0f48d7dac8f0d64169838b880092cbd0e53c047de1c"] :db/ensure [:answer-field/validate]} {:db/id "q-10045" :question/id #uuid "8ff1d836-eff6-5416-8eca-f38f9d49cb8f" :question/math-academy-id "q-10045" :question/problem "${\\int }_{-1}^{1}\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}\\,\\text{d}x=$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(1+\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\n$$\n\nSo, let $u=1+\\operatorname{sin}⁡x.$ Differentiating, we have \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x\\,⟹\\,\\text{d}u=\\operatorname{cos}⁡x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $-1$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1-\\operatorname{sin}⁡(1)$ | $1+\\operatorname{sin}⁡(1)$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}\\frac{\\operatorname{cos}⁡x}{1+\\operatorname{sin}⁡x}\\,\\text{d}x & ={\\int }_{-1}^{1}\\frac{1}{1+\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & ={\\int }_{1-\\operatorname{sin}⁡(1)}^{1+\\operatorname{sin}⁡(1)}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|{|}_{1-\\operatorname{sin}⁡(1)}^{1+\\operatorname{sin}⁡(1)} \\\\  & =\\operatorname{ln}⁡(1+\\operatorname{sin}⁡(1))-\\operatorname{ln}⁡(1-\\operatorname{sin}⁡(1))\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-10045/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc24eade-1b3d-5672-88fd-0bb48b371509"] :knowledge-point/questions ["q-10045"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-13474"] :question/problem "$\\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\,\\text{d}x & =4\\int {sec}^{2}⁡({x}^{3})\\cdot {x}^{2}\\,\\text{d}x \\\\  & =4\\int {sec}^{2}⁡(u)\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{4}{3}\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡u+C \\\\  & =\\frac{4}{3}\\operatorname{tan}⁡({x}^{3})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-350060/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "10be2153-58f9-5fdb-8aee-003db3a4ef43" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-350060/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "464a7fee-cdae-5411-ac36-0274f045c5da" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-350060/field-1" :answer-field/id #uuid "4665f929-297f-5960-b15f-c3fbbdc0c955" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350060/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-350060/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-350060/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-350060" :question/id #uuid "1647abd3-8524-50dc-9015-b53f7e45b70f" :question/math-academy-id "q-350060" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}3{sec}^{2}⁡(x-\\frac{\\pi }{4})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=x-\\frac{\\pi }{4},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /4$ |\n| --- | --- | --- |\n| $u$ | $-\\pi /4$ | $0$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}3{sec}^{2}⁡(x-\\frac{\\pi }{4})\\,\\text{d}x & =3{\\int }_{-\\pi /4}^{0}{sec}^{2}⁡(u)\\,\\text{d}u \\\\  & =3\\operatorname{tan}⁡(u){|}_{-\\pi /4}^{0} \\\\  & =3(0-(-1)) \\\\  & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350060/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "084eb4cc-2f84-5288-90a6-be84066922b6"] :knowledge-point/questions ["q-350060"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350071/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "8b720361-fa00-51ec-83b6-c9a264d424a4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-350071/field-1" :answer-field/id #uuid "d3ee8efe-9659-5bca-8f1b-6ce5a82d861d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350071/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-350071/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-350071" :question/id #uuid "d2e06399-eadb-50ef-a9f6-d3bbbc68b0aa" :question/math-academy-id "q-350071" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /3}^{2\\pi /3}4\\operatorname{csc}⁡(x-\\frac{\\pi }{6})\\operatorname{cot}⁡(x-\\frac{\\pi }{6})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=x-\\frac{\\pi }{6},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\pi /3$ | $2\\pi /3$ |\n| --- | --- | --- |\n| $u$ | $\\pi /6$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /3}^{2\\pi /3}4\\operatorname{csc}⁡(x-\\frac{\\pi }{6})\\operatorname{cot}⁡(x-\\frac{\\pi }{6})\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /2}4\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =4{\\int }_{\\pi /6}^{\\pi /2}\\operatorname{csc}⁡(u)\\operatorname{cot}⁡(u)\\,\\text{d}u \\\\  & =-4\\operatorname{csc}⁡(u){|}_{\\pi /6}^{\\pi /2} \\\\  & =-4(\\operatorname{csc}⁡(\\frac{\\pi }{2})-\\operatorname{csc}⁡(\\frac{\\pi }{6})) \\\\  & =-4(1-2) \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350071/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "084eb4cc-2f84-5288-90a6-be84066922b6"] :knowledge-point/questions ["q-350071"] :db/ensure [:knowledge-point/validate]}]
