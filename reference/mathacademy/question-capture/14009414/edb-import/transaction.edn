[{:db/id "q-114293/selection/2b81578b939b6c15018d7b6c3c7e81fc64b1de287c9775ecc3b0b1110ab54904" :answer/id #uuid "a8c2f046-0e1e-54bb-b647-df1e1bbac18c" :answer/type :answer.type/math :answer/value "\\frac{(2x-1){e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114293/selection/cd33d9c7a1ff42560db7d123d1878cddc118bea52f0f077d7003a73564761377" :answer/id #uuid "5840cb45-3abb-5479-8451-bbb65798a149" :answer/type :answer.type/math :answer/value "(2x-1){e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-114293/selection/326fad72de8facb7ca4306400cf63ecebdae20dadf6ca74af8c815ace6e44cb6" :answer/id #uuid "02327162-99a5-5018-a182-2a304b5ce1e8" :answer/type :answer.type/math :answer/value "(1-x){e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-114293/selection/001000898d2de560b0b6ad7e24511936d715e052afcf5c464332c7513b970409" :answer/id #uuid "30a0088b-1923-5fdb-ada8-dbb91684be77" :answer/type :answer.type/math :answer/value "(2-3x){e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-114293/selection/4d1b44fb1129266b33adec1f2abaefb38861f62f68575a3ee860f1a1b9615d36" :answer/id #uuid "1a8148c3-1142-5af7-8bb5-d1aa9d1c6016" :answer/type :answer.type/math :answer/value "\\frac{(2-x){e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114293/selection" :answer-field/id #uuid "dfcb73e0-5c96-58fc-a6e5-c62cb4c5e84c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114293/selection/326fad72de8facb7ca4306400cf63ecebdae20dadf6ca74af8c815ace6e44cb6" :answer-field/choices ["q-114293/selection/2b81578b939b6c15018d7b6c3c7e81fc64b1de287c9775ecc3b0b1110ab54904" "q-114293/selection/cd33d9c7a1ff42560db7d123d1878cddc118bea52f0f077d7003a73564761377" "q-114293/selection/326fad72de8facb7ca4306400cf63ecebdae20dadf6ca74af8c815ace6e44cb6" "q-114293/selection/001000898d2de560b0b6ad7e24511936d715e052afcf5c464332c7513b970409" "q-114293/selection/4d1b44fb1129266b33adec1f2abaefb38861f62f68575a3ee860f1a1b9615d36"] :db/ensure [:answer-field/validate]} {:db/id "q-114293" :question/id #uuid "22b47a5c-d440-5039-af24-74694e9daefc" :question/math-academy-id "q-114293" :question/problem "Calculate $\\int (3x-4){e}^{-3x}\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (3x-4){e}^{-3x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=3x-4\\, & ⟹\\,{u}^{′}=3 \\\\ {v}^{′}={e}^{-3x}\\, & ⟹\\,v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (3x-4)\\cdot {e}^{-3x}\\,\\text{d}x & =(3x-4)\\cdot (-\\frac{{e}^{-3x}}{3})-\\int (-\\frac{{e}^{-3x}}{3})\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (3x-4){e}^{-3x}\\,\\text{d}x & =-\\frac{(3x-4){e}^{-3x}}{3}+\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-\\frac{(3x-4){e}^{-3x}}{3}-\\frac{{e}^{-3x}}{3}+C \\\\  & =-\\frac{(3x-3){e}^{-3x}}{3}+C \\\\  & =(1-x){e}^{-3x}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114293/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948"] :knowledge-point/questions ["q-114293"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114288/selection/bf0c705f7ac0b5a36095b0edd0b64e8529f2888b1daaef9d3b946ce43fdb17f5" :answer/id #uuid "a2b92c9b-f60c-56d1-afd4-919813dc0996" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-114288/selection/6e0b42f64a10592716257721f114da314f6bdb837548e27a6e3e00a680f99f72" :answer/id #uuid "7051331b-9832-5d38-9313-dacb894e97ae" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{8x}}{4}+\\frac{5{e}^{8x}}{16}+C" :db/ensure [:answer/validate]} {:db/id "q-114288/selection/f8d7b431416620c99dd41f8f45b0da8ef5ab7a9894986214881e06ff075e7bd4" :answer/id #uuid "7373ec35-03b3-5775-897d-2e1f54523943" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{8x}}{8}-\\frac{{e}^{8x}}{16}+C" :db/ensure [:answer/validate]} {:db/id "q-114288/selection/97e5ff231594017ec69835920022a7113cfac68795da45994e99dd28795f8b80" :answer/id #uuid "b48058c2-5346-5519-abbb-5bcf8354e302" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C" :db/ensure [:answer/validate]} {:db/id "q-114288/selection/4720812f9a319145cc938a2dc528a31224a19ff75e2f2cb54b3e674af2837803" :answer/id #uuid "0f437192-3fd7-5be0-8add-e8b38339eea7" :answer/type :answer.type/math :answer/value "\\frac{3x{e}^{8x}}{8}+\\frac{{e}^{8x}}{12}+C" :db/ensure [:answer/validate]} {:db/id "q-114288/selection" :answer-field/id #uuid "86fb0546-a595-54c5-b395-d753ce6ff53f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114288/selection/97e5ff231594017ec69835920022a7113cfac68795da45994e99dd28795f8b80" :answer-field/choices ["q-114288/selection/bf0c705f7ac0b5a36095b0edd0b64e8529f2888b1daaef9d3b946ce43fdb17f5" "q-114288/selection/6e0b42f64a10592716257721f114da314f6bdb837548e27a6e3e00a680f99f72" "q-114288/selection/f8d7b431416620c99dd41f8f45b0da8ef5ab7a9894986214881e06ff075e7bd4" "q-114288/selection/97e5ff231594017ec69835920022a7113cfac68795da45994e99dd28795f8b80" "q-114288/selection/4720812f9a319145cc938a2dc528a31224a19ff75e2f2cb54b3e674af2837803"] :db/ensure [:answer-field/validate]} {:db/id "q-114288" :question/id #uuid "1a8cff6a-f726-5f01-b056-1c73c4cb34b6" :question/math-academy-id "q-114288" :question/problem "$\\int 4x{e}^{8x}\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 4x{e}^{8x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=4x\\, & ⟹\\,{u}^{′}=4 \\\\ {v}^{′}={e}^{8x}\\, & ⟹\\,v=\\frac{1}{8}{e}^{8x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot {e}^{8x}\\,\\text{d}x & =4x\\cdot \\frac{1}{8}{e}^{8x}-\\int \\frac{1}{8}{e}^{8x}\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 4x{e}^{8x}\\,\\text{d}x & =\\frac{1}{2}x{e}^{8x}-\\frac{1}{2}\\int {e}^{8x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114288/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948"] :knowledge-point/questions ["q-114288"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2420/selection/c54d8cc300868a5bac3a455f5b15991434aab77f9034be9c9c2a53769c1aaa3c" :answer/id #uuid "45a33943-b861-59c1-89c3-26eb11f72abd" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x+\\frac{1}{\\operatorname{ln}⁡5})+C" :db/ensure [:answer/validate]} {:db/id "q-2420/selection/492da8304fbbf488f08cb5fec7a0ce6b574d6fd576d57cbe5e1dbe3c39a608cb" :answer/id #uuid "d1e0ce0e-76dc-5a7d-997d-67b939ee60fa" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-2420/selection/52ea8680937302cab7825bb257feb88f04ea7e3b4f1d1c06c5cdd3cec0d009d8" :answer/id #uuid "8b16bd54-1ca7-5f2f-b410-221a5b572f89" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-\\frac{1}{\\operatorname{ln}⁡5})+C" :db/ensure [:answer/validate]} {:db/id "q-2420/selection/4243d0e822b8330c24714bd9ea825129f50dcf0a1cb2dc839939de430e33bca4" :answer/id #uuid "4b33630c-ecb5-56f2-ac14-1b6e8f4d8588" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(\\frac{1}{x}-\\frac{x}{\\operatorname{ln}⁡5})+C" :db/ensure [:answer/validate]} {:db/id "q-2420/selection/fd38a90ed22d5bf8cefbf2e11a8b6c159677c20d03b2315b3644b3acabb8bf6b" :answer/id #uuid "ad468f28-f450-5fa3-868d-b9834bd738d7" :answer/type :answer.type/math :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(1-\\frac{x}{\\operatorname{ln}⁡5})+C" :db/ensure [:answer/validate]} {:db/id "q-2420/selection" :answer-field/id #uuid "f875e6b9-8981-5816-a243-dbaaacb5933a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2420/selection/52ea8680937302cab7825bb257feb88f04ea7e3b4f1d1c06c5cdd3cec0d009d8" :answer-field/choices ["q-2420/selection/c54d8cc300868a5bac3a455f5b15991434aab77f9034be9c9c2a53769c1aaa3c" "q-2420/selection/492da8304fbbf488f08cb5fec7a0ce6b574d6fd576d57cbe5e1dbe3c39a608cb" "q-2420/selection/52ea8680937302cab7825bb257feb88f04ea7e3b4f1d1c06c5cdd3cec0d009d8" "q-2420/selection/4243d0e822b8330c24714bd9ea825129f50dcf0a1cb2dc839939de430e33bca4" "q-2420/selection/fd38a90ed22d5bf8cefbf2e11a8b6c159677c20d03b2315b3644b3acabb8bf6b"] :db/ensure [:answer-field/validate]} {:db/id "q-2420" :question/id #uuid "0fee3246-3b94-5446-856c-0c95a1862f47" :question/math-academy-id "q-2420" :question/problem "$\\int x{5}^{x}\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{5}^{x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={5}^{x}\\, & ⟹\\,v=\\frac{{5}^{x}}{\\operatorname{ln}⁡(5)}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {5}^{x}\\,\\text{d}x & =x\\cdot \\frac{{5}^{x}}{\\operatorname{ln}⁡(5)}-\\int \\frac{{5}^{x}}{\\operatorname{ln}⁡(5)}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x{5}^{x}\\,\\text{d}x & =\\frac{x{5}^{x}}{\\operatorname{ln}⁡(5)}-\\int \\frac{{5}^{x}}{\\operatorname{ln}⁡(5)}\\,\\text{d}x \\\\  & =\\frac{x{5}^{x}}{\\operatorname{ln}⁡(5)}-\\frac{{5}^{x}}{(\\operatorname{ln}⁡(5))^{2}}+C \\\\  & =\\frac{{5}^{x}}{\\operatorname{ln}⁡5}(x-\\frac{1}{\\operatorname{ln}⁡5})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2420/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948"] :knowledge-point/questions ["q-2420"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12560/selection/c1a25194246512ffc552f475f38821277e0d68f323371409a30ecf19a63356e7" :answer/id #uuid "ddfe3b31-f7ec-5c69-8ab2-ab63332be930" :answer/type :answer.type/math :answer/value "-\\frac{x{e}^{2x+5}}{4}+\\frac{{e}^{2x+5}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-12560/selection/9ddbc4fa60ee55b4562fa3abb038570a9b204eb743a9e288527e24ceb8b74d7c" :answer/id #uuid "33f83f5e-ab39-5c59-a1da-895918f6c799" :answer/type :answer.type/math :answer/value "-\\frac{(x+7){e}^{2x+5}}{4}+\\frac{{e}^{2x+5}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-12560/selection/a77e75a262d08095b6a46e5b26dc8dc76668985bbab08281813b475dc65c7ced" :answer/id #uuid "e8b9c357-a3eb-5d0a-a9ec-b4355d6c9831" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{2x+5}}{4}-\\frac{{e}^{2x+5}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-12560/selection/c6b28150747a637b4bc14eb4c4b237a66d87b372d0ea83a5c44fcc954d58edc5" :answer/id #uuid "f5b1a02a-d530-5d62-99d9-a63f1e0d8f74" :answer/type :answer.type/math :answer/value "\\frac{(x+7){e}^{2x+5}}{2}-\\frac{{e}^{2x+5}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-12560/selection/cefad6bcdb6f6724ad269f18c9df96924fefbe039d6d866e857b349f7d8aa080" :answer/id #uuid "b68b56b6-bf5d-5526-851c-1ce7aff442fb" :answer/type :answer.type/math :answer/value "\\frac{(x+7){e}^{2x+5}}{4}-\\frac{x{e}^{2x+5}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-12560/selection" :answer-field/id #uuid "654d3da2-47f2-5194-a575-68fe6213b525" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12560/selection/c6b28150747a637b4bc14eb4c4b237a66d87b372d0ea83a5c44fcc954d58edc5" :answer-field/choices ["q-12560/selection/c1a25194246512ffc552f475f38821277e0d68f323371409a30ecf19a63356e7" "q-12560/selection/9ddbc4fa60ee55b4562fa3abb038570a9b204eb743a9e288527e24ceb8b74d7c" "q-12560/selection/a77e75a262d08095b6a46e5b26dc8dc76668985bbab08281813b475dc65c7ced" "q-12560/selection/c6b28150747a637b4bc14eb4c4b237a66d87b372d0ea83a5c44fcc954d58edc5" "q-12560/selection/cefad6bcdb6f6724ad269f18c9df96924fefbe039d6d866e857b349f7d8aa080"] :db/ensure [:answer-field/validate]} {:db/id "q-12560" :question/id #uuid "4b37af6e-76fe-5074-b739-7927c18f01a2" :question/math-academy-id "q-12560" :question/problem "Calculate the integral $\\int (x+7){e}^{2x+5}\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (x+7){e}^{2x+5}\\,\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+7\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{2x+5}\\, & ⟹\\,v=\\frac{{e}^{2x+5}}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+7)\\cdot {e}^{2x+5}\\,\\text{d}x & =(x+7)\\cdot \\frac{{e}^{2x+5}}{2}-\\int \\frac{{e}^{2x+5}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+7){e}^{2x+5}\\,\\text{d}x & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{1}{2}\\int {e}^{2x+5}\\,\\text{d}x \\\\  & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{{e}^{2x+5}}{4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-12560/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948"] :knowledge-point/questions ["q-12560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114287/selection/72b5f8a5fb59f9734b8fcef1d0b0550679fd90048935fb1adeb4824b66a49e3b" :answer/id #uuid "bddc3cf2-3f22-5caf-93ac-23307c7115ee" :answer/type :answer.type/math :answer/value "-2x{e}^{-3x}-\\frac{2{e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114287/selection/5968ff10baaaf5522c6f826d692fe907a1000626a15fdfa37aaea0a012c5bfe0" :answer/id #uuid "0337ec50-1281-5f53-87d6-01d2705a10f4" :answer/type :answer.type/math :answer/value "-3x{e}^{-3x}-\\frac{{e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114287/selection/959e678d94fcc09609f501a826f7bd9c86273d1f023994023ca1b57d587ec753" :answer/id #uuid "93450f80-7305-5aec-b8ec-a22229ad2662" :answer/type :answer.type/math :answer/value "4x{e}^{-3x}-\\frac{3{e}^{-3x}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-114287/selection/f242303027bd03a915068cf6723a0136157f45e2e757d485d1e5b650b9151823" :answer/id #uuid "6259b2e9-3e7b-59b7-bfb0-173616ef23cb" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{-3x}}{2}-\\frac{2{e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114287/selection/2bbcdeaaeddac50e63108a0cc385082f42d44baec85134a7be0ab58cd91215d7" :answer/id #uuid "f7558fff-d697-5dda-879e-5b66e4da6fe3" :answer/type :answer.type/math :answer/value "-x{e}^{-3x}+\\frac{2{e}^{-3x}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114287/selection" :answer-field/id #uuid "741db9be-5b9b-54e5-9fe9-b7b974d0dd70" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114287/selection/72b5f8a5fb59f9734b8fcef1d0b0550679fd90048935fb1adeb4824b66a49e3b" :answer-field/choices ["q-114287/selection/72b5f8a5fb59f9734b8fcef1d0b0550679fd90048935fb1adeb4824b66a49e3b" "q-114287/selection/5968ff10baaaf5522c6f826d692fe907a1000626a15fdfa37aaea0a012c5bfe0" "q-114287/selection/959e678d94fcc09609f501a826f7bd9c86273d1f023994023ca1b57d587ec753" "q-114287/selection/f242303027bd03a915068cf6723a0136157f45e2e757d485d1e5b650b9151823" "q-114287/selection/2bbcdeaaeddac50e63108a0cc385082f42d44baec85134a7be0ab58cd91215d7"] :db/ensure [:answer-field/validate]} {:db/id "q-114287" :question/id #uuid "b2f0b068-41b8-5842-8ef3-240b1ca8e48a" :question/math-academy-id "q-114287" :question/problem "Calculate $\\int 6x{e}^{-3x}\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 6x{e}^{-3x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}={e}^{-3x}\\, & ⟹\\,v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nWe, substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 6x\\cdot {e}^{-3x}\\,\\text{d}x & =6x\\cdot (-\\frac{{e}^{-3x}}{3})-\\int (-\\frac{{e}^{-3x}}{3})\\cdot 6\\,\\text{d}x \\\\  & =-2x{e}^{-3x}+2\\int {e}^{-3x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 6x{e}^{-3x}\\,\\text{d}x & =-2x{e}^{-3x}+2\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-2x{e}^{-3x}-\\frac{2{e}^{-3x}}{3}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114287/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948"] :knowledge-point/questions ["q-114287"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14453/selection/4fdfe613b2afe4b482fd8e98b1e2bc1288504dab884779b0a412384d904e4fdb" :answer/id #uuid "5ecd12ba-ead6-5c9b-8b19-d74505a582ef" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡6x-x\\operatorname{sin}⁡6x+C" :db/ensure [:answer/validate]} {:db/id "q-14453/selection/8232afb58f5187bbf13188e088a6be251a1fc49e24003b68d18fdf2f43eb7dff" :answer/id #uuid "48db7a12-5f2d-570a-af53-80aeae1b7bc0" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡6x+x\\operatorname{sin}⁡6x+C" :db/ensure [:answer/validate]} {:db/id "q-14453/selection/79749d24aaf8211a467a9a0296f8d935738c5a998ca16852a1492f6ad4ab55c9" :answer/id #uuid "b4b17332-732c-555e-b0f4-f4f78b98b353" :answer/type :answer.type/math :answer/value "6x\\operatorname{sin}⁡x+6\\operatorname{cos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-14453/selection/5ff5037a48ce01c9fca6f8a22cfb33c1171e7dbdc6b217bdfb617b3946f90a6c" :answer/id #uuid "063f1038-b031-50a8-9960-e1cfd90959d2" :answer/type :answer.type/math :answer/value "-6x\\operatorname{sin}⁡x+6\\operatorname{cos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-14453/selection/879a1ea85c97b30be1a630a232ef3caf48d88320959796f65c7781fa7f2c1b46" :answer/id #uuid "a3040a83-50d0-52cd-83d6-0701b7b0b560" :answer/type :answer.type/math :answer/value "-6x\\operatorname{cos}⁡x-\\operatorname{cos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-14453/selection" :answer-field/id #uuid "ca396769-eb6d-53cf-8398-a4cc0df729e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14453/selection/79749d24aaf8211a467a9a0296f8d935738c5a998ca16852a1492f6ad4ab55c9" :answer-field/choices ["q-14453/selection/4fdfe613b2afe4b482fd8e98b1e2bc1288504dab884779b0a412384d904e4fdb" "q-14453/selection/8232afb58f5187bbf13188e088a6be251a1fc49e24003b68d18fdf2f43eb7dff" "q-14453/selection/79749d24aaf8211a467a9a0296f8d935738c5a998ca16852a1492f6ad4ab55c9" "q-14453/selection/5ff5037a48ce01c9fca6f8a22cfb33c1171e7dbdc6b217bdfb617b3946f90a6c" "q-14453/selection/879a1ea85c97b30be1a630a232ef3caf48d88320959796f65c7781fa7f2c1b46"] :db/ensure [:answer-field/validate]} {:db/id "q-14453" :question/id #uuid "39c1f4f6-a031-555a-af2e-76dd70b7318e" :question/math-academy-id "q-14453" :question/problem "$\\int 6x\\operatorname{cos}⁡(x)\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 6x\\operatorname{cos}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 6x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =6x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 6\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 6x\\operatorname{cos}⁡(x)\\,\\text{d}x & =6x\\operatorname{sin}⁡(x)-6\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =6x\\operatorname{sin}⁡(x)-6(-\\operatorname{cos}⁡(x))+C \\\\  & =6x\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-14453/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-14453"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74090/selection/319a703d8873a74aefcf4ba66d0211f505cc11cb8a1c84be39cda7b9a0501e3d" :answer/id #uuid "198c8f4c-56f0-5207-af5e-9ea835359917" :answer/type :answer.type/math :answer/value "10x\\operatorname{sin}⁡(x)+10\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74090/selection/ccc0f5bff267a55cffc7bc8538a1f5c0eda22c162e69649fb048f0d6e35328c4" :answer/id #uuid "1b8c7ce4-cac6-509c-b60c-8658bc94214a" :answer/type :answer.type/math :answer/value "10\\operatorname{sin}⁡(x)-10x\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74090/selection/6cc9fe9d802c13e1d78b7a49b3f01d8878908005062a0df36b4194e55cdb921e" :answer/id #uuid "7d30a13c-f8c3-5850-8b27-454978932aa4" :answer/type :answer.type/math :answer/value "10x\\operatorname{sin}⁡(x)+\\frac{\\operatorname{cos}⁡(x)}{10}+C" :db/ensure [:answer/validate]} {:db/id "q-74090/selection/8802c3aeff8df5b87bb6d870b8b880a344901fcd41a3561471a58c80be041a3d" :answer/id #uuid "76c5e5f4-76f8-5470-82b6-cc171144b920" :answer/type :answer.type/math :answer/value "10\\operatorname{sin}⁡(x)-\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74090/selection/f86da4462e4bd0d162b0b59d7d2166ee3db5573aacc5db0767a132930953189f" :answer/id #uuid "b53d9767-eb38-5f96-a8b7-c6784af37754" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{sin}⁡(x)}{10}-\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74090/selection" :answer-field/id #uuid "75d982fc-1d07-5ed6-830c-726192ed99e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74090/selection/319a703d8873a74aefcf4ba66d0211f505cc11cb8a1c84be39cda7b9a0501e3d" :answer-field/choices ["q-74090/selection/319a703d8873a74aefcf4ba66d0211f505cc11cb8a1c84be39cda7b9a0501e3d" "q-74090/selection/ccc0f5bff267a55cffc7bc8538a1f5c0eda22c162e69649fb048f0d6e35328c4" "q-74090/selection/6cc9fe9d802c13e1d78b7a49b3f01d8878908005062a0df36b4194e55cdb921e" "q-74090/selection/8802c3aeff8df5b87bb6d870b8b880a344901fcd41a3561471a58c80be041a3d" "q-74090/selection/f86da4462e4bd0d162b0b59d7d2166ee3db5573aacc5db0767a132930953189f"] :db/ensure [:answer-field/validate]} {:db/id "q-74090" :question/id #uuid "c21d0dc3-2df8-5b24-86c4-408d7b44edd6" :question/math-academy-id "q-74090" :question/problem "Calculate $\\int 10x\\operatorname{cos}⁡(x)\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 10x\\operatorname{cos}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=10x\\, & ⟹\\,{u}^{′}=10 \\\\ {v}^{′}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 10x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =10x\\cdot (\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))\\cdot 10\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 10x\\operatorname{cos}⁡(x)\\,\\text{d}x & =10x\\operatorname{sin}⁡(x)-10\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =10x\\operatorname{sin}⁡(x)+10\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74090/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-74090"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114297/selection/783c93eaae6323c7f36116a317a8434b2fb8b73b19898bf3b7b1844ef5917a96" :answer/id #uuid "d7fb474c-7e53-5437-9a65-388ead62564c" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(3x)-\\frac{x\\operatorname{cos}⁡(3x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114297/selection/94d7aa7d5fa9444a1c4d553473e89b92ddaab7878238951ec594393cd5574c38" :answer/id #uuid "f5b781ec-938b-5f02-8e23-aac6bda548c3" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡(3x)+\\frac{x\\operatorname{cos}⁡(3x)}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-114297/selection/fd12978b14105ad88fffc2ba6aad2f312f8e521e7d3f8c47ed41df7d011605b0" :answer/id #uuid "20e24aae-7294-5f43-b360-89d0d52fcba0" :answer/type :answer.type/math :answer/value "x\\operatorname{sin}⁡(3x)+\\frac{\\operatorname{cos}⁡(3x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114297/selection/25ef211dda64cf3940770b689527f6b2cc76cf3de04f55fe224e6f28564ef758" :answer/id #uuid "654b3963-72be-5d2d-ab21-468291cae36b" :answer/type :answer.type/math :answer/value "2x\\operatorname{sin}⁡(3x)+\\frac{\\operatorname{cos}⁡(3x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-114297/selection/4e60a412e9a0c9210a40eb3ed8db7bca4ec5d08b47ffbd08ea247fc6e3dc3026" :answer/id #uuid "9c08afd9-7502-5e45-bcae-5d34da2f52b9" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{sin}⁡(3x)}{3}-\\frac{\\operatorname{cos}⁡(3x)}{9}+C" :db/ensure [:answer/validate]} {:db/id "q-114297/selection" :answer-field/id #uuid "097e307a-baf0-562a-a260-70b760dce7bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114297/selection/fd12978b14105ad88fffc2ba6aad2f312f8e521e7d3f8c47ed41df7d011605b0" :answer-field/choices ["q-114297/selection/783c93eaae6323c7f36116a317a8434b2fb8b73b19898bf3b7b1844ef5917a96" "q-114297/selection/94d7aa7d5fa9444a1c4d553473e89b92ddaab7878238951ec594393cd5574c38" "q-114297/selection/fd12978b14105ad88fffc2ba6aad2f312f8e521e7d3f8c47ed41df7d011605b0" "q-114297/selection/25ef211dda64cf3940770b689527f6b2cc76cf3de04f55fe224e6f28564ef758" "q-114297/selection/4e60a412e9a0c9210a40eb3ed8db7bca4ec5d08b47ffbd08ea247fc6e3dc3026"] :db/ensure [:answer-field/validate]} {:db/id "q-114297" :question/id #uuid "e39f59c6-1dff-56e6-932b-2ba7bba5a751" :question/math-academy-id "q-114297" :question/problem "$\\int 3x\\operatorname{cos}⁡(3x)\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 3x\\operatorname{cos}⁡(3x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=3x\\, & ⟹\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =3x\\cdot (\\frac{\\operatorname{sin}⁡(3x)}{3})-\\int (\\frac{\\operatorname{sin}⁡(3x)}{3})\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 3x\\operatorname{cos}⁡(3x)\\,\\text{d}x & =x\\operatorname{sin}⁡(3x)-\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(3x)+\\frac{\\operatorname{cos}⁡(3x)}{3}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114297/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-114297"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114314/selection/b6adae220436dff61c87a6744efd41ae414cd9fdfe033f9129ee686e80d88846" :answer/id #uuid "6241a189-3434-5fa7-bd6a-1f84f8396f56" :answer/type :answer.type/math :answer/value "-2x\\operatorname{cot}⁡x-\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-114314/selection/2fd05488787aac7a111413193317b4bab0d49bce5f407189c5fbf4382fa234b8" :answer/id #uuid "f55817f1-d0c7-5040-b35e-ec4ee3f947ee" :answer/type :answer.type/math :answer/value "-x\\operatorname{cot}⁡x-2\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-114314/selection/ce6824d11c02de731077c6d0bfe23cbc28f8ab054ab33a85461dda71368bf16b" :answer/id #uuid "fb574e6c-2f2a-5f5c-8b49-3b144168df1f" :answer/type :answer.type/math :answer/value "x\\operatorname{tan}⁡x-\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-114314/selection/a8c7af326c5183f4ad46327fbc46e3c79a1728c02db9a54b65cecbeeda5533d7" :answer/id #uuid "644b3aaf-cefd-5234-8335-739a32ab175c" :answer/type :answer.type/math :answer/value "x\\operatorname{tan}⁡x-2\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-114314/selection/3b5a61d39e2965959971c92cd2416e75c118cf35d70fb3475a985dcd7ec713ac" :answer/id #uuid "9282af3b-81a0-582a-84c3-c48741017a33" :answer/type :answer.type/math :answer/value "-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-114314/selection" :answer-field/id #uuid "a2ca7314-1853-5a2e-a8a4-327cd176b8ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114314/selection/3b5a61d39e2965959971c92cd2416e75c118cf35d70fb3475a985dcd7ec713ac" :answer-field/choices ["q-114314/selection/b6adae220436dff61c87a6744efd41ae414cd9fdfe033f9129ee686e80d88846" "q-114314/selection/2fd05488787aac7a111413193317b4bab0d49bce5f407189c5fbf4382fa234b8" "q-114314/selection/ce6824d11c02de731077c6d0bfe23cbc28f8ab054ab33a85461dda71368bf16b" "q-114314/selection/a8c7af326c5183f4ad46327fbc46e3c79a1728c02db9a54b65cecbeeda5533d7" "q-114314/selection/3b5a61d39e2965959971c92cd2416e75c118cf35d70fb3475a985dcd7ec713ac"] :db/ensure [:answer-field/validate]} {:db/id "q-114314" :question/id #uuid "e9ee642b-9c85-56dd-a07d-2fe51c8fec98" :question/math-academy-id "q-114314" :question/problem "Calculate $\\int x{csc}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{csc}^{2}⁡x\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={csc}^{2}⁡x\\, & ⟹\\,v=-\\operatorname{cot}⁡x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {csc}^{2}⁡x\\,\\text{d}x & =x\\cdot (-\\operatorname{cot}⁡x)-\\int (-\\operatorname{cot}⁡x)\\cdot 1\\,\\text{d}x \\\\  & =-x\\operatorname{cot}⁡x+\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral using the substitution $u=\\operatorname{sin}⁡x,$ where $\\text{d}u=\\operatorname{cos}⁡x\\,\\text{d}x,$ as follows:\n\n$$\n\\begin{aligned}\\int x{csc}^{2}⁡(x)\\,\\text{d}x & =-x\\operatorname{cot}⁡x+\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & =-x\\operatorname{cot}⁡x+\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|u|+C \\\\  & =-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114314/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-114314"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114311/selection/7db2e67c26951a544daab4f60ab7954e3cd6a9741ce9ebe0ba0c3b84654fa88f" :answer/id #uuid "25bd4a24-6a2d-512f-9a80-78111b9e46c0" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡(x)-6\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114311/selection/bef90c2a9c3b6f2e2ae3e62777dc1ad5c70d5c134933f5943cea64a374dc1087" :answer/id #uuid "a59e50f6-012a-51fe-aa5a-c0873ac26fa6" :answer/type :answer.type/math :answer/value "(2x+3)\\operatorname{cos}⁡(x)-\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114311/selection/6fc47a9283251e97a3ba436f750326a26c624ebc4b775394dfb6feb7b2e7e45a" :answer/id #uuid "ceaa5544-28b2-5406-9aba-4a17e48e9d62" :answer/type :answer.type/math :answer/value "2x\\operatorname{cos}⁡(x)+4\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114311/selection/3cff85021ee716085557ce9f68df32f10b26f61ce66f6b44916104044608d849" :answer/id #uuid "c363b1e4-ca51-5471-8e33-ce4fab83915a" :answer/type :answer.type/math :answer/value "-(2x+3)\\operatorname{cos}⁡(x)-4\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114311/selection/cffcee6e4142b7d5524f1a6c30c0ee94247ff575fe062fde0c78ade1d2f75e30" :answer/id #uuid "6c69d6d4-44ca-5592-b031-4859ad271a1d" :answer/type :answer.type/math :answer/value "-(2x+3)\\operatorname{cos}⁡(x)+2\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114311/selection" :answer-field/id #uuid "8c28147d-36e4-5ede-800d-179032583cc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114311/selection/cffcee6e4142b7d5524f1a6c30c0ee94247ff575fe062fde0c78ade1d2f75e30" :answer-field/choices ["q-114311/selection/7db2e67c26951a544daab4f60ab7954e3cd6a9741ce9ebe0ba0c3b84654fa88f" "q-114311/selection/bef90c2a9c3b6f2e2ae3e62777dc1ad5c70d5c134933f5943cea64a374dc1087" "q-114311/selection/6fc47a9283251e97a3ba436f750326a26c624ebc4b775394dfb6feb7b2e7e45a" "q-114311/selection/3cff85021ee716085557ce9f68df32f10b26f61ce66f6b44916104044608d849" "q-114311/selection/cffcee6e4142b7d5524f1a6c30c0ee94247ff575fe062fde0c78ade1d2f75e30"] :db/ensure [:answer-field/validate]} {:db/id "q-114311" :question/id #uuid "3927a442-7821-55f2-aba3-bde17aab07b6" :question/math-academy-id "q-114311" :question/problem "$\\int (2x+3)\\operatorname{sin}⁡(x)\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (2x+3)\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x+3\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (2x+3)\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =(2x+3)\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows\n\n$$\n\\begin{aligned}\\int (2x+3)\\operatorname{sin}⁡(x)\\text{d}x & =-(2x+3)\\operatorname{cos}⁡(x)+2\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-(2x+3)\\operatorname{cos}⁡(x)+2\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114311/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-114311"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114320/selection/bb65a6e7eb44ee90b780f2599cff43126ec6e746ea702726d0b0b4b36574be52" :answer/id #uuid "aafc5bd6-10a3-5fce-a049-6753b52ab1be" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114320/selection/38b5bfb83b8763c94515546cd2df6b9030f59055f5d98025355ca58a21d30f58" :answer/id #uuid "64dcb982-2410-5312-a3a8-32b772bb9b83" :answer/type :answer.type/math :answer/value "\\frac{1}{4}({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114320/selection/fdf03c71619ff3119ffbf7c70e6fc9639acaf8623959e5ac1ad84d0c79ba2041" :answer/id #uuid "67a7fc43-9fda-544e-84ff-d25caa3092e6" :answer/type :answer.type/math :answer/value "-\\frac{5}{4}({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114320/selection/168d389e2b5c9f76b65300de76958996ddac3f95997ff0d499cafe8deba09ffd" :answer/id #uuid "24736613-630b-55f9-819a-105d0c0a9e05" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114320/selection/27ed806b5be621517e6561fc10027b2e24b44dc0599dd0651ceccba49ce94505" :answer/id #uuid "a70e6a6f-7ef1-53d0-9f4e-395353be66a0" :answer/type :answer.type/math :answer/value "\\frac{5}{4}({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114320/selection" :answer-field/id #uuid "e565e2c1-f70a-54e4-bdf6-b1c175431f0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114320/selection/bb65a6e7eb44ee90b780f2599cff43126ec6e746ea702726d0b0b4b36574be52" :answer-field/choices ["q-114320/selection/bb65a6e7eb44ee90b780f2599cff43126ec6e746ea702726d0b0b4b36574be52" "q-114320/selection/38b5bfb83b8763c94515546cd2df6b9030f59055f5d98025355ca58a21d30f58" "q-114320/selection/fdf03c71619ff3119ffbf7c70e6fc9639acaf8623959e5ac1ad84d0c79ba2041" "q-114320/selection/168d389e2b5c9f76b65300de76958996ddac3f95997ff0d499cafe8deba09ffd" "q-114320/selection/27ed806b5be621517e6561fc10027b2e24b44dc0599dd0651ceccba49ce94505"] :db/ensure [:answer-field/validate]} {:db/id "q-114320" :question/id #uuid "3972fccf-fd67-52cd-ade5-97cff4fde1d4" :question/math-academy-id "q-114320" :question/problem "Evaluate ${\\int }_{-1}^{0}3x{e}^{-2x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=3x & ⇒ & {u}^{′}=3 \\\\ {v}^{′}={e}^{-2x} & ⇒ & v=-\\frac{{e}^{-2x}}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot {e}^{-2x}\\,\\text{d}x & =3x\\cdot (-\\frac{{e}^{-2x}}{2})-\\int (-\\frac{{e}^{-2x}}{2})\\cdot 3\\,\\text{d}x \\\\  & =-\\frac{3x{e}^{-2x}}{2}+\\frac{3}{2}\\int {e}^{-2x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}3x{e}^{-2x}\\,\\text{d}x & =-\\frac{3x{e}^{-2x}}{2}{|}_{-1}^{0}+\\frac{3}{2}{\\int }_{-1}^{0}{e}^{-2x}\\,\\text{d}x \\\\  & =-\\frac{3x{e}^{-2x}}{2}{|}_{-1}^{0}-\\frac{3}{4}{e}^{-2x}{|}_{-1}^{0} \\\\  & =-\\frac{3}{2}[0{e}^{-2(0)}-(-1){e}^{-2(-1)}]-\\frac{3}{4}[{e}^{-2(0)}-{e}^{-2(-1)}] \\\\  & =-\\frac{3}{2}[0+{e}^{2}]-\\frac{3}{4}[1-{e}^{2}] \\\\  & =-\\frac{3}{2}{e}^{2}-\\frac{3}{4}+\\frac{3}{4}{e}^{2} \\\\  & =-\\frac{3}{4}{e}^{2}-\\frac{3}{4} \\\\  & =-\\frac{3}{4}({e}^{2}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114320/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-114320"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49674/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9b13811f-4a58-54c3-8790-3494d297b97a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-49674/selection/35d0af53e25a7911f6d08c6d063fcf9231a1273a16a0f7056530d6f5d5dfbdd8" :answer/id #uuid "f2202011-f89c-5347-ba9b-ecf730a87cb6" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-49674/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "734b65ea-919d-5772-b4e4-6607d840ef8c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-49674/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "819ecb8d-76ca-5088-89ba-70c3ffc074f1" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-49674/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "fddf3212-9334-5ea0-af72-69b858fd25a4" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-49674/selection" :answer-field/id #uuid "ffc1d0ca-a504-534b-b970-16556e359de2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49674/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-49674/selection/d971375f57c56d8a55a09f2b892e