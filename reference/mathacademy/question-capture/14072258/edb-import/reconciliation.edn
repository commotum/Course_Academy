rm, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "2b881bb3817b14744b5b3494377b9605a47e52a1496f2839e9be73e8e2dfdb05" "basis" 1449 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/edb-import/verification.json"} {"question" "q-35734" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/activity-metadata.json" "file_sha256" "2c680fda06fa2f83e46075e6ebe9b567cd34ab2f0257707276276bc6230ca565" "basis" 1449 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/edb-import/verification.json"} {"question" "q-35734" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "2b881bb3817b14744b5b3494377b9605a47e52a1496f2839e9be73e8e2dfdb05" "basis" 1449 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/edb-import/verification.json"} {"question" "q-35734" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$1$st and $2$nd only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/state.json" "file_sha256" "2b881bb3817b14744b5b3494377b9605a47e52a1496f2839e9be73e8e2dfdb05" "basis" 1449 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040466/edb-import/verification.json"} {"question" "q-35