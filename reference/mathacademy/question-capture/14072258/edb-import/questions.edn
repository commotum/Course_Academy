 :db/id #edb/ref 17592186121800} {:answer/id #uuid "c5ce2854-fd1a-5255-bf12-736a9db6d465" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186121801} {:answer/id #uuid "3aaf0356-bea4-57dc-94dc-d0a8943c4b50" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186121802} {:answer/id #uuid "5ca98bf6-3fde-56af-8234-c7a3b296a200" :answer/type {:db/ident :answer.type/text} :answer/value "$5$th only" :db/id #edb/ref 17592186121803}] :answer-field/correct {:answer/id #uuid "8779bf35-546f-5765-bb56-68f1c9880ccf" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186121799} :answer-field/id #uuid "381a65ce-186a-52ec-b16a-760c7868d6d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121798}] :question/id #uuid "bfb0514f-33ea-5674-8071-994ec564a12b" :question/math-academy-id "q-35391" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$B = \\begin{bmatrix}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186124820 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae2b6b35-014b-5003-842d-3020255a62c3" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are non-pivot" :db/id #edb/ref 17592186121943} {:answer/id #uuid "d05889a6-354e-5dec-8004-441e1a510388" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186121944} {:answer/id #uuid "f2bfc036-f3b4-5b71-a591-06944408a1e6" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186121945} {:answe