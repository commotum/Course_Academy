 $4$ pivots, and therefore the number of pivot columns is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130962/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741"] :knowledge-point/questions ["q-130962"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130963/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3d579971-55f2-5926-b631-762df9c16024" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-130963/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "ce0cd0ea-e69c-5be7-9178-ff40e20b504d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-130963/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "0b69edae-013b-5046-9387-b11189d2e72f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-130963/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e3075212-2f3f-59c3-bcba-258de36470ec" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-130963/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "855aa6a9-d6b5-534f-8b2a-81bee1afede1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-130963/selection" :answer-field/id #uuid "6f2e0c91-d3b0-5c7f-adb2-77338a7eb517" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130963/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-130963/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-130963/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-130963/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-130963/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-130963/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-130963" :question/id #uuid "eae101a0-2456-55e5-8d92-d0eccb15db1a" :question/math-academy-id "q-130963" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼[\\begin{aligned}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{aligned}] & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼[\\begin{aligned}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 9\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $4$ pivots, and therefore the number of pivot columns is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741"] :knowledge-point/questions ["q-130963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73625/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "37fb577a-5654-5c42-98a3-3666a1153aaf" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-73625/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c60f1100-92b8-50a3-b