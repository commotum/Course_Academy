 0 & -3 & 2 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $3$rd and $4$th columns:\n\n$$\nA=[\\begin{aligned}-1 & 7 & 0 & -4 \\\\ 0 & 0 & -3 & 2 \\\\ 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130934/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1"] :knowledge-point/questions ["q-130934"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35391"] :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=[\\begin{aligned}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $4$ pivots in the $1$st, $2$nd, $4$th, and $5$th columns:\n\n$$\nB=[\\begin{aligned}3 & 4 & 3 & 0 & -5 \\\\ 0 & 2 & 0 & -4 & 1 \\\\ 0 & 0 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-35730"] :question/problem "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $2$ pivots in the $1$st and $3$rd columns:\n\n$$\nP=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 0 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $2$nd column." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-73614/selection/02b0be138d8a0f39c7c3b7759031408a6993e6def8ee036ed0124e8b802e1efa" :answer/id #uuid "be822a90-f0a2-5242-9576-630d2188f7a8" :answer/type :answer.type/text :answer/value "$1$st and $2$nd only" :db/ensure [:answer/validate]} {:db/id "q-73614/selection/c12325f74ab3486398192a8d5229dcc8858f296945874fe16d6865db6a7dc4f8" :answer/id #uuid "dbaa6fa4-3443-5bf9-b661-23b3e0f84989" :answer/type :answer.type/text :answer/value "$1$st only" :db/ensure [:answer/validate]} {:db/id "q-73614/selection/06bf89e9fe9bd2978d91ae6a9925dcc52276fdd44f8de901ef2103c38fcbff28" :answer/id #uuid "99976c86-21c6-5243-b5a8-f0c9af954e45" :answer/type :answer.type/text :answer/value "$1$st and $3$rd only" :db/ensure [:answer/validate]} {:db/id "q-73614/selection/f939dbf9ac60b3bb68fae785b704e995bea0bf29f57322c65884ecf0fe435db4" :answer/id #uuid "a9c53a0d-6ca3-5f4c-a209-e25fb1d10601" :answer/type :answer.type/text :answer/value "$2$nd only" :db/ensure [:answer/validate]} {:db/id "q-73614/selection/0617f40c30d3177ee66fae7128600d63e0a36dcd56b2d8d825516d16b1bfc4ec" :answer/id #uuid "d675be28-afa8-54cd-84d8-5b9e6b2a34b3" :answer/type :answer.type/text :answer/value "$3$rd only" :db/ensure [:answer/validate]} {:db/id "q-73614/selection" :answer-field/id #uuid "b19078b4-05df-5e4f-86e8-9dd69e6fabf8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73614/selection/c12325f74ab3486398192a8d5229dcc8858f296945874fe16d6865db6a7dc4f8" :answer-field/choices ["q-73614/selection/02b0be138d8a0f39c7c3b7759031408a6993e6def8ee036ed0124e8b802e1efa" "q-73614/selection/c12325f74ab3486398192a8d5229dcc8858f296945874fe16d6865db6a7dc4f8" "q-73614/selection/06bf89e9fe9bd2978d91ae6a9925dcc52276fdd44f8de901ef2103c38fcbff28" "q-73614/selection/f939dbf9ac60b3bb68fae785b704e995bea0bf29f57322c65884ecf0fe435db4" "q