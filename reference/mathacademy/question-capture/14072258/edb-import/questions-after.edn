gned}1 & 2 & -1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186375660 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be822a90-f0a2-5242-9576-630d2188f7a8" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186375662} {:answer/id #uuid "d675be28-afa8-54cd-84d8-5b9e6b2a34b3" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186375663} {:answer/id #uuid "99976c86-21c6-5243-b5a8-f0c9af954e45" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186375664} {:answer/id #uuid "dbaa6fa4-3443-5bf9-b661-23b3e0f84989" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186375665} {:answer/id #uuid "a9c53a0d-6ca3-5f4c-a209-e25fb1d10601" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186375666}] :answer-field/correct {:answer/id #uuid "dbaa6fa4-3443-5bf9-b661-23b3e0f84989" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186375665} :answer-field/id #uuid "b19078b4-05df-5e4f-86e8-9dd69e6fabf8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375661}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "de38baa9-a386-5cc1-be5b-d4e4ac11ab42" :question/math-academy-id "q-73614" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}0 & 3 & 4 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $2$ pivots in the $2$nd and $3$rd columns:\n\n$$\nA=[\\begin{aligned}0 & 3 & 4 \\\\ 0 & 0 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $1$st column."}] [{:db/id #edb/ref 17592186375667 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37fb577a-5654-5c42-98a3-3666a1153aaf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375669} {:answer/id #uuid "58f2fba0-f394-5844-8bdd-57bd15078a97" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375670} {:answer/id #uuid "c60f1100-92b8-50a3-ba03-fa9c61fdbd11" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186375671} {:answer/id #uuid "9da7801f-5bb6-593f-899e-304b3b39973b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186375672} {:answer/id #uuid "ea24a5b3-77f4-58c2-981a-a252f783f19c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186375673}] :answer-field/correct {:answer/id #uuid "37fb577a-5654-5c42-98a3-3666a1153aaf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186375669} :answer-field/id #uuid "95f61532-5193-570d-8206-9f39a1d92a0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375668}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d6d981c8-9943-5824-a087-8778518de01a" :question/math-academy-id "q-73625" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & 0 & 0 & 8 & 1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}]}
