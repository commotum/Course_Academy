#{[{:db/id #edb/ref 17592186322404 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cf0c341-bb64-53ac-b1b5-fbd0f2861558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322406} {:answer/id #uuid "b5e001fa-5cce-5139-b479-b668b154bec9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322407} {:answer/id #uuid "f163575b-0b5f-515a-abcd-7193bfaecbf6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322408} {:answer/id #uuid "c8fb0641-3a3d-5afa-9248-bb58e8e3ac51" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322409} {:answer/id #uuid "34a1fbec-7497-5269-9261-b82398df7161" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186322410}] :answer-field/correct {:answer/id #uuid "4cf0c341-bb64-53ac-b1b5-fbd0f2861558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186322406} :answer-field/id #uuid "eeed0805-e25a-5df2-a5ba-04f91d32ca10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322405}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2cb7299f-8b80-5020-a0a1-407df3d0dba1" :question/math-academy-id "q-130958" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 2 & 0 & 0 & -2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 0 & 1 & 2 \\\\ 0 & 0 & -3 & 7 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -4 & -4\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186322411 :knowledge-point/_questions [{:knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de3e9c10-b38f-54ad-a596-d6ad322ddcc6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322413} {:answer/id #uuid "6d7f6896-75b1-5adc-bd6b-0169f4983e46" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186322414} {:answer/id #uuid "0e586b01-f37c-54cd-b7b2-c1664f1b092f" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186322415} {:answer/id #uuid "279a5dfc-a00c-5892-8e7a-eff376593c4f" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd" :db/id #edb/ref 17592186322416} {:answer/id #uuid "00121e22-b6de-5071-b3b2-6d0d345a1dda" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186322417}] :answer-field/correct {:answer/id #uuid "de3e9c10-b38f-54ad-a596-d6ad322ddcc6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322413} :answer-field/id #uuid "e14eaf20-399c-53e1-b338-ba5f598d2e1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322412}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "af69649b-ba41-5eae-bb14-bde36a03c4ab" :question/math-academy-id "q-35754" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 4 & 3\\end{aligned}]?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 4 & 3\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 5 \\\\ 0 & 4 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $2$ pivots. In particular, the pivot columns are the $1$st and $2$nd columns."}]}
