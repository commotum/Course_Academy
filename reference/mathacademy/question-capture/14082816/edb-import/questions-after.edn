1309 :knowledge-point/_questions [{:knowledge-point/id #uuid "33586620-e110-5a37-874f-a92103c5e9fb" :knowledge-point/title "Solving for One Coefficient in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ec209f6-9f67-5be4-a1e5-a058b0c97e42" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186321311} {:answer/id #uuid "4cae1f17-e703-5cbd-b52f-ebdb2959db84" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186321312} {:answer/id #uuid "5c2abbb8-30d6-5419-81df-961c80bd67f4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186321313} {:answer/id #uuid "515df100-2311-55f6-84d3-5b2b3c2cddd2" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186321314} {:answer/id #uuid "01273b43-df1c-5f5b-a6c8-eec678b2dff7" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186321315}] :answer-field/correct {:answer/id #uuid "4cae1f17-e703-5cbd-b52f-ebdb2959db84" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186321312} :answer-field/id #uuid "94f49771-acfd-5c3a-aeaf-c2fd40d7b5b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186321310}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aada095f-b604-55ca-adb1-bafdd7c5b85b" :question/math-academy-id "q-34602" :question/problem "Find $k$, if $8{a}_{1}+k{a}_{2}=0$ and\n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ 6 \\\\ -4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $k$ term, we get\n\n$$\n\\begin{aligned}8{a}_{1}+k{a}_{2} & =0 \\\\ 8[\\begin{aligned}-3 \\\\ 6 \\\\ -4\\end{aligned}]+k[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ k[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]-8[\\begin{aligned}-3 \\\\ 6 \\\\ -4\\end{aligned}] \\\\ k[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}] & =[\\begin{aligned}24 \\\\ -48 \\\\ 32\\end{aligned}].\\end{aligned}\n$$\n\nEquating the first components, we get \n\n$$\n-2k=24\\,⟹\\,k=-12.\n$$\n\nBut then \n\n$$\n\\begin{aligned}-12[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}]=[\\begin{aligned}24 \\\\ -36 \\\\ 48\\end{aligned}]\\ne [\\begin{aligned}24 \\\\ -48 \\\\ 32\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, there is no $k$ such that \n $8{a}_{1}+k{a}_{2}=0.$"}] [{:db/id #edb/ref 17592186321316 :knowledge-point/_questions [{:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "240d5547-f75a-5217-a337-31ed278a378b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ -5 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186321318} {:answer/id #uuid "8334a2a9-9569-515a-8062-f982ee8c163c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186321319} {:answer/id #uuid "31d57cf9-5e7a-5f99-8bef-908e67dea7ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -5 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186321320} {:answer/id #uuid "fc4282fc-1a7a-5917-896a-a286112f6957" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 6 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186321321} {:answer/id #uuid "d30c39d8-471d-5cb9-9a9a-5833d6fddc7d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186321322}] :answer-field/correct {:answer/id #uuid "31d57cf9-5e7a-5f99-8bef-908e67dea7ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -5 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186321320} :answer-field/id #uuid "a3022814-08a0-5872-9a60-95a62167c0ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186321317}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8eb567c3-b45a-5792-98ad-b502b4836a87" :question/math-academy-id "q-73931" :question/problem "Find $x$, if $3a+2x=b$ and\n\n$$\na=[\\begin{aligned}1 \\\\ 2 \\\\ -5\\end{aligned}],\\,b=[\\begin{aligned}9 \\\\ -4 \\\\ -3\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}3a+2x & =b \\\\ 2x & =b-3a \\\\ x & =\\frac{1}{2}(b-3a) \\\\ x & =\\frac{1}{2}([\\begin{aligned}9 \\\\ -4 \\\\ -3\\end{aligned}]-3[\\begin{aligned}1 \\\\ 2 \\\\ -5\\end{aligned}]) \\\\ x & =\\frac{1}{2}[\\begin{aligned}6 \\\\ -10 \\\\ 12\\end{aligned}] \\\\ x & =[\\begin{aligned}3 \\\\ -5 \\\\ 6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387306 :knowledge-point/_questions [{:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2162ea04-9609-5246-b80f-554320af2195" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ -3 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186387308} {:answer/id #uuid "1567a295-a659-5e66-a31d-a1c088ef7850" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 15 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186387309} {:answer/id #uuid "4e80efe3-22e4-5ee6-9457-6c42e662859e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ -6 \\\\ 9\\en