. Hence,the system has no solution." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/state.json" "file_sha256" "3693b0643c1637beb0ed893dfd77bc3fee5e50bf0bbf7e312c52cf34eea746d7" "basis" 1628 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/edb-import/verification.json"} {"question" "q-34242" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/activity-metadata.json" "file_sha256" "277a1276fba71699bb031c7c6ec50d19a68b1ac54e98c9c2b1323f94e6b8525b" "basis" 1628 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/edb-import/verification.json"} {"question" "q-34242" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/state.json" "file_sha256" "3693b0643c1637beb0ed893dfd77bc3fee5e50bf0bbf7e312c52cf34eea746d7" "basis" 1628 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/edb-import/verification.json"} {"question" "q-34242" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/state.json" "file_sha256" "3693b0643c1637beb0ed893dfd77bc3fee5e50bf0bbf7e312c52cf34eea746d7" "basis" 1628 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042052/edb-import/verification.json"} {"question" "q-34242" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0"] "cat