}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ 5 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 2{x}_{1}-{x}_{2} \\\\ {x}_{1}-{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ 5 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}0=4 \\\\ 2{x}_{1}-{x}_{2}=5 \\\\ {x}_{1}-{x}_{2}=1\\end{aligned}\n$$\n\nThe first equation is a false statement. Hence,the system has no solution." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-34242" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/activity-metadata.json" "file_sha256" "a70cb16ea7c938975cb7f05d7d1eb3f8f5c1010f3b7770c1c30064bcb693fa5f"} {"question" "q-34242" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-34242" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "0"] ["math" "1"] ["math" "2"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-34242" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "No solution"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73954" "field" nil "attribute" "question/problem" "value" "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ 3 \\\\ 4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}5 \\\\ 4 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73954" "field" nil "attribute" "question/worked-solution" "value" "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}-2 \\\\ 3 \\\\ 4\\end{aligned}]+{x}_{2}[\\begin{aligned}5 \\\\ 4 \\\\ -3\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}] \\\\ [\\begin{aligned}-2{x}_{1} \\\\ 3{x}_{1} \\\\ 4{x}_{1}\\end{aligned}]+[\\begin{aligned}5{x}_{2} \\\\ 4{x}_{2} \\\\ -3{x}_{2}\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}] \\\\ [\\begin{aligned}-2{x}_{1}+5{x}_{2} \\\\ 3{x}_{1}+4{x}_{2} \\\\ 4{x}_{1}-3{x}_{2}\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}-2{x}_{1}+5{x}_{2}=16 \\\\ 3{x}_{1}+4{x}_{2}=-1 \\\\ 4{x}_{1}-3{x}_{2}=-18\\end{aligned}\n$$\n\nMultiplying the first equation by $3$, the second equation by $2$, and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}15{x}_{2}+8{x}_{2} & =48-2 \\\\ 23{x}_{2} & =46 \\\\ {x}_{2} & =2.\\end{aligned}\n$$\n\nNow, we substitute ${x}_{2}=2$  into the second equation to get \n\n$$\n\\begin{aligned}3{x}_{1}+4{x}_{2} & =-1\\text{ } \\\\ 3{x}_{1}+4(2) & =-1 \\\\ 3{x}_{1} & =-9 \\\\ {x}_{1} & =-3.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-3$ and ${x}_{2}=2$ into our third equation to get\n\n$$\n\\begin{aligned}4{x}_{1}-3{x}_{2} & =-18 \\\\ 4(-3)-3(2) & =-18 \\\\ -18 & =-18,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo, the solution of the system is ${x}_{1}=-3$ and ${x}_{2}=2,$ which means\n\n$$\n-3{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=(-3)+2=-1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73954" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/activity-metadata.json" "file_sha256" "a70cb16ea7c938975cb7f05d7d1eb3f8f5c1010f3b7770c1c30064bcb693fa5f"} {"question" "q-73954" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73954" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-4"] ["math" "-5"] ["math" "4"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73954" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-105168" "field" nil "attribute" "question/problem" "value" "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ -8 \\\\ 6\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 5 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-105168" "field" nil "attribute" "question/worked-solution" "value" "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 \\\\ -8 \\\\ 6\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 5 \\\\ -3\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 3{x}_{1} \\\\ -2{x}_{1}\\end{aligned}]+[\\begin{aligned}-3{x}_{2} \\\\ -8{x}_{2} \\\\ 6{x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 5{x}_{3} \\\\ -3{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=2 \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3}=1 \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}=2\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ -2 & 6 & -3 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ 0 & 0 & 1 & 6\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}-{x}_{3}=-5 \\\\ {x}_{3}=6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=6.$ Substituting ${x}_{3}=6$ into the second equation, we obtain\n\n$$\n{x}_{2}-6=-5\\,⟹\\,{x}_{2}=1.\n$$\n\nNow, substituting ${x}_{2}=1$ and ${x}_{3}=6$ into the first equation, we obtain\n\n$$\n{x}_{1}-3(1)+2(6)=2\\,⟹\\,{x}_{1}=-7.\n$$\n\nSo, the solution of the system is ${x}_{1}=-7$, ${x}_{2}=1$, and ${x}_{3}=6,$ which means \n\n$$\n-7{a}_{1}+{a}_{2}+6{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-7+1+6=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-105168" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/activity-metadata.json" "file_sha256" "a70cb16ea7c938975cb7f05d7d1eb3f8f5c1010f3b7770c1c30064bcb693fa5f"} {"question" "q-105168" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-105168" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "0"] ["math" "1"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-105168" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-74032" "field" nil "attribute" "question/problem" "value" "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}3 \\\\ -11 \\\\ 1\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ -18 \\\\ -1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-74032" "field" nil "attribute" "question/worked-solution" "value" "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -2 \\\\ 2\\end{aligned}]+{x}_{3}[\\begin{aligned}3 \\\\ -11 \\\\ 1\\end{aligned}] & =[\\begin{aligned}5 \\\\ -18 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2} \\\\ -2{x}_{2} \\\\ 2{x}_{2}\\end{aligned}]+[\\begin{aligned}3{x}_{3} \\\\ -11{x}_{3} \\\\ {x}_{3}\\end{aligned}] & =[\\begin{aligned}5 \\\\ -18 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} \\\\ -2{x}_{2}-11{x}_{3} \\\\ {x}_{1}+2{x}_{2}+{x}_{3}\\end{aligned}] & =[\\begin{aligned}5 \\\\ -18 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3}=5 \\\\ -2{x}_{2}-11{x}_{3}=-18 \\\\ {x}_{1}+2{x}_{2}+{x}_{3}=-1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{aligned}].\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 1 & 2 & 1 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & -2 & -11 & -18 \\\\ 0 & 1 & -2 & -6\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & -1 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & -2 & -11 & -18\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & -15 & -30\\end{aligned}] & {R}_{3} & :=-\\frac{1}{15}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -2 & -6 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3}=5 \\\\ {x}_{2}-2{x}_{3}=-6 \\\\ {x}_{3}=2.\\end{aligned}\n$$\n\n \n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this value into  the second equation, we get\n\n$$\n{x}_{2}-2(2)=-6\\,⟹\\,{x}_{2}=-2.\n$$\n\n \n\nFinally, by substituting ${x}_{2}=-2$ and ${x}_{3}=2$ into the first equation, we obtain \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{2}+3{x}_{3} & =5 \\\\ {x}_{1}+(-2)+3(2) & =5 \\\\ {x}_{1}+4 & =5 \\\\ {x}_{1} & =1.\\end{aligned}\n$$\n\nSo, the solution of the system is ${x}_{1}=1$, ${x}_{2}=-2$, and ${x}_{3}=2,$ which means \n\n$$\n{a}_{1}-2{a}_{2}+2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-2)+2=1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-74032" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/activity-metadata.json" "file_sha256" "a70cb16ea7c938975cb7f05d7d1eb3f8f5c1010f3b7770c1c30064bcb693fa5f"} {"question" "q-74032" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-74032" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "6"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-74032" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73992" "field" nil "attribute" "question/problem" "value" "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 0 \\\\ -1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 5 \\\\ 1\\end{aligned}],\\,b=[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73992" "field" nil "attribute" "question/worked-solution" "value" "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 0 \\\\ -1\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 5 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ 3{x}_{1}\\end{aligned}]+[\\begin{aligned}-{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 5{x}_{3} \\\\ {x}_{3}\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} \\\\ 5{x}_{3} \\\\ 3{x}_{1}-{x}_{2}+{x}_{3}\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=-5 \\\\ 5{x}_{3}=-10 \\\\ 3{x}_{1}-{x}_{2}+{x}_{3}=1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 0 & 2 & -5 & 16\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 2 & -5 & 16 \\\\ 0 & 0 & 5 & -10\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 5 & -10\\end{aligned}] & {R}_{3} & :=\\frac{1}{5}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=-5 \\\\ {x}_{2}-2.5\\,{x}_{3}=8 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting this value into the second equation, we get \n\n$$\n{x}_{2}-2.5(-2)=8\\,⟹\\,{x}_{2}=8-5=3.\n$$\n\nFinally,  substituting ${x}_{2}=3$ and ${x}_{3}=-2$  into the first equation, we obtain\n\n$$\n{x}_{1}-(3)+2(-2)=-5\\,⟹\\,{x}_{1}=2.\n$$\n\nSo, the solution of the system is ${x}_{1}=2$, ${x}_{2}=3$, and ${x}_{3}=-2,$ which means \n\n$$\n2{a}_{1}+3{a}_{2}-2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+3-2=3.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73992" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/activity-metadata.json" "file_sha256" "a70cb16ea7c938975cb7f05d7d1eb3f8f5c1010f3b7770c1c30064bcb693fa5f"} {"question" "q-73992" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73992" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "4"] ["math" "5"] ["math" "6"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.json" "file_sha256" "d981bc78b4b52e0e3b5a626533c540cb0f8af4ae2955e0066dce541080e46812"} {"question" "q-73992" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/state.