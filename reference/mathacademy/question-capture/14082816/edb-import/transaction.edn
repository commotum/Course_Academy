3029a4f007127aae3e5c95a5508436ceb79f5463f20e92a268a5d4dce4" "q-73936/selection/a4ed5eba9dfca5e7f447e48d75b1e7ac31008d27608282e3ac6ecd076520f469" "q-73936/selection/7f39569955ba064daa9683e0493e926434688ca8ff2b8acb71f141cb6d10c780"] :db/ensure [:answer-field/validate]} {:db/id "q-73936" :question/id #uuid "348f7a1d-d1ce-5a20-a4c3-2efbac29746f" :question/math-academy-id "q-73936" :question/problem "Find $x$, if $4a-2x=b$ and\n\n$$\na=[\\begin{aligned}2 \\\\ 6 \\\\ -4\\end{aligned}],\\,b=[\\begin{aligned}12 \\\\ -6 \\\\ -10\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}4a-2x & =b \\\\ 2x & =4a-b \\\\ x & =\\frac{1}{2}(4a-b) \\\\ x & =\\frac{1}{2}(4[\\begin{aligned}2 \\\\ 6 \\\\ -4\\end{aligned}]-[\\begin{aligned}12 \\\\ -6 \\\\ -10\\end{aligned}]) \\\\ x & =\\frac{1}{2}[\\begin{aligned}-4 \\\\ 30 \\\\ -6\\end{aligned}] \\\\ x & =[\\begin{aligned}-2 \\\\ 15 \\\\ -3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73936/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919"] :knowledge-point/questions ["q-73936"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105161/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "60be7523-d278-5123-b879-2344e0c92d74" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-105161/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "0a4a21f9-1bac-5bff-8a85-463cfabd027c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105161/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "52779063-8881-5e5b-b003-3ea9eafa4201" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-105161/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "804425ea-56ef-547a-97e1-89f3b3f4b848" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-105161/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "fabf58c5-c945-5500-a51f-3b7189d80b10" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-105161/selection" :answer-field/id #uuid "7f3f3ee2-b7cd-5dec-a437-c3d6f8a9ddfd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105161/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-105161/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-105161/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-105161/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-105161/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-105161/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-105161" :question/id #uuid "5e3d35d4-4023-5683-a525-12eaa9fbede7" :question/math-academy-id "q-105161" :question/problem "Find the value of ${x}_{1}-{x}_{2}$ given that $7a+4x=b$ and\n\n$$\na=[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 4 \\\\ -3 \\\\ -6\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}7a+4x & =b \\\\ 4x & =b-7a \\\\ x & =\\frac{1}{4}(b-7a) \\\\ x & =\\frac{1}{4}([\\begin{aligned}-1 \\\\ 4 \\\\ -3 \\\\ -6\\end{aligned}]-7[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 2\\end{aligned}]) \\\\ x & =\\frac{1}{4}[\\begin{aligned}-8 \\\\ 4 \\\\ 4 \\\\ -20\\end{aligned}] \\\\ x & =[\\begin{aligned}-2 \\\\ 1 \\\\ 1 \\\\ -5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${x}_{1}-{x}_{2}=-2-1=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919"] :knowledge-point/questions ["q-105161"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-34568"] :question/problem "Consider the vectors\n\n$$\n{c}_{1}=[\\begin{aligned}-1 \\\\ 3 \\\\ 5\\end{aligned}],\\,{c}_{2}=[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}],\\,d=[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}].\n$$\n\nIf ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}-1 \\\\ 3 \\\\ 5\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-{x}_{1} \\\\ 3{x}_{1} \\\\ 5{x}_{1}\\end{aligned}]+[\\begin{aligned}4{x}_{2} \\\\ {x}_{2} \\\\ 2{x}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-{x}_{1}+4{x}_{2} \\\\ 3{x}_{1}+{x}_{2} \\\\ 5{x}_{1}+2{x}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}-{x}_{1}+4{x}_{2}=3 \\\\ 3{x}_{1}+{x}_{2}=4 \\\\ 5{x}_{1}+2{x}_{2}=5\\end{aligned}\n$$\n\nMultiplying the first equation by $3$ and adding the result to the second equation, we get\n\n$$\n\\begin{aligned}13{x}_{2} & =13\\,⟹\\,{x}_{2}=1.\\end{aligned}\n$$\n\nSubstituting ${x}_{2}=1$ into the first equation, we get\n\n$$\n\\begin{aligned}-{x}_{1}+4(1) & =3\\,⟹\\,{x}_{1}=1.\\end{aligned}\n$$\n\nFinally, substituting ${x}_{1}=1$ and ${x}_{2}=1$ into the third equation, we obtain\n\n$$\n\\begin{aligned}5{x}_{1}+2{x}_{2} & =5 \\\\ 5(1)+2(1) & =5 \\\\ 7 & =5,\\end{aligned}\n$$\n\nwhich gives a false statement. \n\nSo, the system has no solution." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-73954/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "a1a8f928-83ab-5fb2-af01-ba09b4e8d2b4" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-73954/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "05abe5d3-534a-59e4-849a-fecf054ff7dc" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-73954/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a21f3728-530f-5844-a211-ed2eb4dfaf55" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-73954/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "3f6677ce-6f4b-5849-85bc-d4532e2b5edc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-73954/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "0d63f362-3186-5550-a8f1-93658696f7e7" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-73954/selection" :answer-field/id #uuid "0d9dc079-ace9-597d-98ca-7b6841f35ee8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73954/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-73954/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-73954/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-73954/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-73954/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-73954/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67"] :db/ensure [:answer-field/validate]} {:db/id "q-73954" :question/id #uuid "14e6eb58-ec97-520f-a3b6-e469837fdc9b" :question/math-academy-id "q-73954" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}-2 \\\\ 3 \\\\ 4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}5 \\\\ 4 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b,$ then what is ${x}_{1}+{x}_{2}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}-2 \\\\ 3 \\\\ 4\\end{aligned}]+{x}_{2}[\\begin{aligned}5 \\\\ 4 \\\\ -3\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}] \\\\ [\\begin{aligned}-2{x}_{1} \\\\ 3{x}_{1} \\\\ 4{x}_{1}\\end{aligned}]+[\\begin{aligned}5{x}_{2} \\\\ 4{x}_{2} \\\\ -3{x}_{2}\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}] \\\\ [\\begin{aligned}-2{x}_{1}+5{x}_{2} \\\\ 3{x}_{1}+4{x}_{2} \\\\ 4{x}_{1}-3{x}_{2}\\end{aligned}] & =[\\begin{aligned}16 \\\\ -1 \\\\ -18\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}-2{x}_{1}+5{x}_{2}=16 \\\\ 3{x}_{1}+4{x}_{2}=-1 \\\\ 4{x}_{1}-3{x}_{2}=-18\\end{aligned}\n$$\n\nMultiplying the first equation by $3$, the second equation by $2$, and adding the resulting equations, we obtain \n\n$$\n\\begin{aligned}15{x}_{2}+8{x}_{2} & =48-2 \\\\ 23{x}_{2} & =46 \\\\ {x}_{2} & =2.\\end{aligned}\n$$\n\nNow, we substitute ${x}_{2}=2$  into the second equation to get \n\n$$\n\\begin{aligned}3{x}_{1}+4{x}_{2} & =-1\\text{ } \\\\ 3{x}_{1}+4(2) & =-1 \\\\ 3{x}_{1} & =-9 \\\\ {x}_{1} & =-3.\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-3$ and ${x}_{2}=2$ into our third equation to get\n\n$$\n\\begin{aligned}4{x}_{1}-3{x}_{2} & =-18 \\\\ 4(-3)-3(2) & =-18 \\\\ -18 & =-18,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo, the solution of the system is ${x}_{1}=-3$ and ${x}_{2}=2,$ which means\n\n$$\n-3{a}_{1}+2{a}_{2}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}=(-3)+2=-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73954/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e5e826-3121-500a-9103-e618cb16c5b2"] :knowledge-point/questions ["q-73954"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105168/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "4250256c-1125-542a-819f-1aa213362e31" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105168/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d74b43a7-9d8f-5d05-b2d0-00d7709dde21" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-105168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1fc364fe-15f1-5fc9-b62b-128302726ace" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-105168/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "977281d2-30c8-5ffb-a3ec-10faa5aa31e1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-105168/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "1cdf8288-04f8-58a2-90cd-e3b5d024ba20" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-105168/selection" :answer-field/id #uuid "6990e5c8-3c63-576d-8ca2-ec8c1c5d88b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105168/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-105168/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-105168/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-105168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-105168/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-105168/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-105168" :question/id #uuid "9541c7b4-0663-5396-9a08-887584cc6208" :question/math-academy-id "q-105168" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ -8 \\\\ 6\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 5 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have  \n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 3 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-3 \\\\ -8 \\\\ 6\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 5 \\\\ -3\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 3{x}_{1} \\\\ -2{x}_{1}\\end{aligned}]+[\\begin{aligned}-3{x}_{2} \\\\ -8{x}_{2} \\\\ 6{x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 5{x}_{3} \\\\ -3{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3} \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3} \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=2 \\\\ 3{x}_{1}-8{x}_{2}+5{x}_{3}=1 \\\\ -2{x}_{1}+6{x}_{2}-3{x}_{3}=2\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 3 & -8 & 5 & 1 \\\\ -2 & 6 & -3 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ -2 & 6 & -3 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 2 \\\\ 0 & 1 & -1 & -5 \\\\ 0 & 0 & 1 & 6\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=2 \\\\ {x}_{2}-{x}_{3}=-5 \\\\ {x}_{3}=6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=6.$ Substituting ${x}_{3}=6$ into the second equation, we obtain\n\n$$\n{x}_{2}-6=-5\\,⟹\\,{x}_{2}=1.\n$$\n\nNow, substituting ${x}_{2}=1$ and ${x}_{3}=6$ into the first equation, we obtain\n\n$$\n{x}_{1}-3(1)+2(6)=2\\,⟹\\,{x}_{1}=-7.\n$$\n\nSo, the solution of the system is ${x}_{1}=-7$, ${x}_{2}=1$, and ${x}_{3}=6,$ which means \n\n$$\n-7{a}_{1}+{a}_{2}+6{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=-7+1+6=0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-105168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73992/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "02ee2ea2-2988-5741-bf62-6af834d17a2d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-73992/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "70b95bea-e87e-572d-bb31-83417d9134f3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-73992/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "47167bc9-ef18-5b94-8896-7efb4e4107f1" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-73992/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9e6b230b-33b0-5467-aa98-e7d3de1032f1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-73992/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "9ce02f7c-04a9-5ac7-b531-6934a9fee5b0" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-73992/selection" :answer-field/id #uuid "19b38c34-28a7-5285-b571-bb9d789beb82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73992/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-73992/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-73992/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-73992/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-73992/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-73992/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67"] :db/ensure [:answer-field/validate]} {:db/id "q-73992" :question/id #uuid "171d7adc-d40b-5e04-8b00-b146afdaeb83" :question/math-academy-id "q-73992" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 0 \\\\ -1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ 5 \\\\ 1\\end{aligned}],\\,b=[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 0 \\\\ -1\\end{aligned}]+{x}_{3}[\\begin{aligned}2 \\\\ 5 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 0 \\\\ 3{x}_{1}\\end{aligned}]+[\\begin{aligned}-{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{3} \\\\ 5{x}_{3} \\\\ {x}_{3}\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3} \\\\ 5{x}_{3} \\\\ 3{x}_{1}-{x}_{2}+{x}_{3}\\end{aligned}] & =[\\begin{aligned}-5 \\\\ -10 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=-5 \\\\ 5{x}_{3}=-10 \\\\ 3{x}_{1}-{x}_{2}+{x}_{3}=1\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{aligned}]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 3 & -1 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 0 & 5 & -10 \\\\ 0 & 2 & -5 & 16\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 2 & -5 & 16 \\\\ 0 & 0 & 5 & -10\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 5 & -10\\end{aligned}] & {R}_{3} & :=\\frac{1}{5}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -5 \\\\ 0 & 1 & -2.5 & 8 \\\\ 0 & 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=-5 \\\\ {x}_{2}-2.5\\,{x}_{3}=8 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting this value into the second equation, we get \n\n$$\n{x}_{2}-2.5(-2)=8\\,⟹\\,{x}_{2}=8-5=3.\n$$\n\nFinally,  substituting ${x}_{2}=3$ and ${x}_{3}=-2$  into the first equation, we obtain\n\n$$\n{x}_{1}-(3)+2(-2)=-5\\,⟹\\,{x}_{1}=2.\n$$\n\nSo, the solution of the system is ${x}_{1}=2$, ${x}_{2}=3$, and ${x}_{3}=-2,$ which means \n\n$$\n2{a}_{1}+3{a}_{2}-2{a}_{3}=b.\n$$\n\nConsequently, \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=2+3-2=3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-73992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105170/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "965ca52f-2190-5554-871c-69ac7d7ab359" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105170/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "eff636f3-b198-59d4-9f2f-810a6c64ce12" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-105170/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "44b35dcf-92af-52dc-9983-49175277bdb8" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-105170/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "aad0eb49-3784-58fd-ab15-3d2fb2f7ee9c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-105170/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "e51413da-6e3e-58b6-9bfc-725f3bc25cc7" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-105170/selection" :answer-field/id #uuid "3c01106d-fd1a-5c80-a154-36c814c4fdca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105170/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer-field/choices ["q-105170/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-105170/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-105170/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-105170/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-105170/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67"] :db/ensure [:answer-field/validate]} {:db/id "q-105170" :question/id #uuid "6ab3f90e-8765-500f-9621-dff08b568cfa" :question/math-academy-id "q-105170" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}4 \\\\ -3 \\\\ 8\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}7 \\\\ -7 \\\\ 14\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ -3 \\\\ 7\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ -3 \\\\ 8\\end{aligned}]+{x}_{3}[\\begin{aligned}7 \\\\ -7 \\\\ 14\\end{aligned}] & =[\\begin{aligned}5 \\\\ -3 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ -{x}_{1} \\\\ 2{x}_{1}\\end{aligned}]+[\\begin{aligned}4{x}_{2} \\\\ -3{x}_{2} \\\\ 8{x}_{2}\\end{aligned}]+[\\begin{aligned}7{x}_{3} \\\\ -7{x}_{3} \\\\ 14{x}_{3}\\end{aligned}] & =[\\begin{aligned}5 \\\\ -3 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+4{x}_{2}+7{x}_{3} \\\\ -{x}_{1}-3{x}_{2}-7{x}_{3} \\\\ 2{x}_{1}+8{x}_{2}+14{x}_{3}\\end{aligned}] & =[\\begin{aligned}5 \\\\ -3 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+4{x}_{2}+7{x}_{3}=5 \\\\ -{x}_{1}-3{x}_{2}-7{x}_{3}=-3 \\\\ 2{x}_{1}+8{x}_{2}+14{x}_{3}=7\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & 4 & 7 & 5 \\\\ -1 & -3 & -7 & -3 \\\\ 2 & 8 & 14 & 7\\end{aligned}].\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 4 & 7 & 5 \\\\ -1 & -3 & -7 & -3 \\\\ 2 & 8 & 14 & 7\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & 7 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 2 & 8 & 14 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & 7 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+4{x}_{2}+7{x}_{3}=5 \\\\ {x}_{2}=2 \\\\ 0=-3.\\end{aligned}\n$$\n\nHowever, the final equation $0=-3$  gives a false statement. So the system has no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105170/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-105170"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105169/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "77a070d1-a7e0-5a87-b628-841a1a7dc211" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-105169/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b8dbc27d-8fad-5d1d-a690-989d77281404" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-105169/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" :answer/id #uuid "1594f466-029c-538a-927c-f05ba108777d" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "q-105169/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "43094605-3da8-5055-b24e-0fac50416cd0" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-105169/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "fdf7cfc0-7f0a-5781-b257-35a5fcc09ae5" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-105169/selection" :answer-field/id #uuid "ca0ebbbb-330e-54e1-b8d2-6e8546cd0563" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105169/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer-field/choices ["q-105169/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" "q-105169/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-105169/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" "q-105169/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" "q-105169/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67"] :db/ensure [:answer-field/validate]} {:db/id "q-105169" :question/id #uuid "fe99bc13-e7dd-5467-8c41-093bc5c5d798" :question/math-academy-id "q-105169" :question/problem "Consider the vectors\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 5 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 6 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-1 \\\\ -8 \\\\ 2\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ -3 \\\\ 4\\end{aligned}].\n$$\n\nIf ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b,$ then what is ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "If ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=b$, then we have\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ 5 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 6 \\\\ -2\\end{aligned}]+{x}_{3}[\\begin{aligned}-1 \\\\ -8 \\\\ 2\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1} \\\\ 5{x}_{1} \\\\ -2{x}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2} \\\\ 6{x}_{2} \\\\ -2{x}_{2}\\end{aligned}]+[\\begin{aligned}-{x}_{3} \\\\ -8{x}_{3} \\\\ 2{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} \\\\ 5{x}_{1}+6{x}_{2}-8{x}_{3} \\\\ -2{x}_{1}-2{x}_{2}+2{x}_{3}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3}=2 \\\\ 5{x}_{1}+6{x}_{2}-8{x}_{3}=-3 \\\\ -2{x}_{1}-2{x}_{2}+2{x}_{3}=4\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=[\\begin{aligned}1 & 1 & -1 & 2 \\\\ 5 & 6 & -8 & -3 \\\\ -2 & -2 & 2 & 4\\end{aligned}].\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & -1 & 2 \\\\ 5 & 6 & -8 & -3 \\\\ -2 & -2 & 2 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 & 2 \\\\ 0 & 1 & -3 & -13 \\\\ -2 & -2 & 2 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -1 & 2 \\\\ 0 & 1 & -3 & -13 \\\\ 0 & 0 & 0 & 8\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3}=2 \\\\ {x}_{2}-3{x}_{3}=-13 \\\\ 0=8.\\end{aligned}\n$$\n\nHowever, the final equation $0=8$  gives a false statement. So the system has no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105169/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe"] :knowledge-point/questions ["q-105169"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4789"] :question/problem "Find $s,$ if $3\\mathbf{a_1}+s\\mathbf{a_2} = \\mathbf{b}$ and\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/assets/df62636427555a986454d8d2787e110eb664771f5a74a38fdaa99ec593643729.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4790"] :question/problem "Find $\\mathbf{x},$ if $\\mathbf{a}+2\\mathbf{x} = \\mathbf{b}$ and\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/assets/93311059b2929dfac5a7dc2019e4591534fdcf3c416486ffdfc78ece16901ca4.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4791"] :question/problem "Consider the vectors\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/assets/cc8a77d53637f5523dcdadd79ea3a282efe30b96aaeb9ec31fce1f39d4006186.png)\n\nIf $x_1 \\mathbf{c}_1 + x_2\\mathbf{c}_2  = \\mathbf d,$ then what is $x_1+x_2?$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6191"] :question/problem "Consider the vectors\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/assets/9f5f9de266fac1e593ea58a3406ff88ccecb3a64963d55367297404360771d83.png)\n\nIf $x_1 \\mathbf{a}_1 + x_2\\mathbf{a}_2 + x_3\\mathbf{a}_3 = \\mathbf b,$ then what is $x_1+x_2+x_3?$" :question/worked-solution "Since $\\mathbf{b}$ is a linear combination of vectors $\\mathbf{a_1}, \\,\\mathbf{a_2}$ and $\\mathbf{a_3}$ with coefficients $x_1,\\, x_2$ and $x_3,$ respectively, we have\n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ {x}_{1} \\\\ 0\\end{aligned}]+[\\begin{aligned}{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{aligned}]+[\\begin{aligned}{x}_{3} \\\\ 2{x}_{3} \\\\ 3{x}_{3}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}{x}_{2}+{x}_{3} \\\\ {x}_{1}+2{x}_{3} \\\\ -{x}_{2}+3{x}_{3}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}{x}_{2}+{x}_{3}=1 \\\\ {x}_{1}+2{x}_{3}=1 \\\\ -{x}_{2}+3{x}_{3}=7\\end{aligned}\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082816/assets/4d3cb5eb82dd012582c78fc2c1201c62f99779d92974aba2a61f5a6bce8b91b9.png)\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}0 & 1 & 1 & 1 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & -1 & 3 & 7\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & -1 & 3 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 4 & 8\\end{aligned}] & {R}_{3} & :=\\frac{1}{4}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{3}=1 \\\\ {x}_{2}+{x}_{3}=1 \\\\ {x}_{3}=2.\\end{aligned}\n$$\n\nFrom the third equation, we get $x_3 = 2.$ Substituting this into the second equation, we get\n\n$$\nx_2+(2) = 1 \\quad\\Rightarrow\\quad x_2 = -1,\n$$\n\nand substituting $x_3=2$ into the first equation, we get\n\n$$\nx_1+2(2) = 1 \\quad\\Rightarrow\\quad x_1 = -3.\n$$\n\nSo the solution of the system is $x_1=-3, x_2=-1, x_3=2,$ which means\n\n$$\n-3 \\mathbf{a_1}- \\mathbf{a_2} +2 \\mathbf{a_3}= \\mathbf{b}.\n$$\n\nConsequently,\n\n$$\nx_1+x_2+x_3=-3-1+2=-2.\n$$" :db/ensure [:question/validate]}]
