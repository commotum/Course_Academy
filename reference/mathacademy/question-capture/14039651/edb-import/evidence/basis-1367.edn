#{[{:db/id #edb/ref 17592186302970 :knowledge-point/_questions [{:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b067803-e356-59ab-b56a-815759d59f7e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186302972} {:answer/id #uuid "2759eceb-a311-5908-8801-d68d919706d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186302973} {:answer/id #uuid "152fb2d4-ee5a-518f-9a22-e7350d93decf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186302974} {:answer/id #uuid "2a0c1e4a-0d81-5dc3-b7ef-67ae2278f12b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186302975} {:answer/id #uuid "8e604a39-c5f4-5995-a4ab-4d0963ea48b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186302976}] :answer-field/correct {:answer/id #uuid "2a0c1e4a-0d81-5dc3-b7ef-67ae2278f12b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186302975} :answer-field/id #uuid "0bca70f5-3474-50a1-9aae-c870451900ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302971}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "90f43e47-681b-5a78-9983-d0ba65d64a48" :question/math-academy-id "q-114423" :question/problem "Calculate $\\int \\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{\\operatorname{sec}⁡x}{{sec}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\operatorname{sec}⁡x}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$"}]}
