\\frac{6}{{x}^{2}+25}\\,\\text{d}x & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡(\\frac{a}{5})) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-(-\\frac{\\pi }{2})) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\  & =\\frac{6}{5}\\cdot \\frac{3\\pi }{4} \\\\  & =\\frac{9\\pi }{10}.\\end{aligned}\n$$" 13194139535110 true] [17592186331874 1000 #edb/ref 17592186331875 13194139535110 true] [17592186331874 1040 #edb/ref 17592186045449 13194139535110 true] [17592186331874 1041 "field-1" 13194139535110 true] [17592186331874 1104 #edb/ref 17592186331875 13194139535110 true] [17592186331874 1110 #uuid "1fa79485-3dde-506d-89cf-179d9510a873" 13194139535110 true] [17592186331875 1034 "\\frac{9\\pi}{10}" 13194139535110 true] [17592186331875 1103 #edb/ref 17592186045453 13194139535110 true] [17592186331875 1111 #uuid "65bed312-8452-55b3-947b-9b80a311307f" 13194139535110 true]] :edb/tempids {"q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657" 17592186331849 "q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657/07a3540ad51bfb53d362c69b0c3835b387a5d7d769d089dc5189f608ec57d640" 17592186331850 "q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657/1e940709a1b00fa910544fd0093551b452ea4b241ad5d9959525312e8a27fa19" 17592186331851 "q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" 17592186331852 "q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" 17592186331853 "q-100493/selection/ma-v1/cd1d051d7b57197ba874ff777b54dd0c909fd7cb4a9f65d23e915c3e0a265657/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" 17592186331854 "q-152641" 17592186331855 "q-152641/selection" 17592186331856 "q-152641/selection/1