#{[{:db/id #edb/ref 17592186352635 :knowledge-point/_questions [{:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9206aa7a-0fa2-5726-9a57-74c0b5a833f7" :answer/type {:db/ident :answer.type/math} :answer/value "y-1=\\pm 5(x+1)" :db/id #edb/ref 17592186352637} {:answer/id #uuid "00f9e819-0711-599f-b016-f041661a29dd" :answer/type {:db/ident :answer.type/math} :answer/value "y-1=\\pm \\frac{1}{2}(x-1)" :db/id #edb/ref 17592186352638} {:answer/id #uuid "98623e6a-2f74-59a5-9b92-382f760f9550" :answer/type {:db/ident :answer.type/math} :answer/value "y-2=\\pm \\frac{1}{5}(x-2)" :db/id #edb/ref 17592186352639} {:answer/id #uuid "00a0a2d0-1d35-5515-8b27-0ce97bee0627" :answer/type {:db/ident :answer.type/math} :answer/value "y+2=\\pm 2(x+1)" :db/id #edb/ref 17592186352640} {:answer/id #uuid "98fb6adf-2efa-5a13-b312-03192daac55c" :answer/type {:db/ident :answer.type/math} :answer/value "y-2=\\pm 5(x-1)" :db/id #edb/ref 17592186352641}] :answer-field/correct {:answer/id #uuid "98fb6adf-2efa-5a13-b312-03192daac55c" :answer/type {:db/ident :answer.type/math} :answer/value "y-2=\\pm 5(x-1)" :db/id #edb/ref 17592186352641} :answer-field/id #uuid "023dd63b-1ad0-50d9-a4df-01e2d0577423" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186352636}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "91c1c8c4-74ef-5df2-b862-509a3ca27ef4" :question/math-academy-id "q-165483" :question/problem "Calculate the asymptotes of the hyperbola \n${y}^{2}-25{x}^{2}-4y+50x-46=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-25{x}^{2}-4y+50x-46 & =0 \\\\ {y}^{2}-4y-25{x}^{2}+50x-46 & =0 \\\\ [{y}^{2}-4y]-25[{x}^{2}-2x]-46 & =0 \\\\ [(y-2)^{2}-4]-25[(x-1)^{2}-1]-46 & =0 \\\\ (y-2)^{2}-4-25(x-1)^{2}+25-46 & =0 \\\\ (y-2)^{2}-25(x-1)^{2} & =46+4-25 \\\\ (y-2)^{2}-25(x-1)^{2} & =25 \\\\ \\frac{(y-2)^{2}}{25}-(x-1)^{2} & =1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(1,2),\\,a=\\sqrt{25}=5,\\,b=\\sqrt{1}=1.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\ny-2=\\pm 5(x-1).\n$$"}] [{:db/id #edb/ref 17592186352642 :knowledge-point/_questions [{:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48c146d5-bc1a-55c8-8154-001b3bbd5d40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}(x+3)" :db/id #edb/ref 17592186352644} {:answer/id #uuid "b725303b-ffe0-56ca-bdb7-e5002785b3ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}(x+3)" :db/id #edb/ref 17592186352645}] :answer-field/correct {:answer/id #uuid "b725303b-ffe0-56ca-bdb7-e5002785b3ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}(x+3)" :db/id #edb/ref 17592186352645} :answer-field/id #uuid "32719783-0d02-5464-ba52-1c11f69ed8b5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186352643}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "be726065-ce9d-5004-b5f1-84da122847df" :question/math-academy-id "q-325365" :question/problem "Calculate the asymptotes of the hyperbola $\\frac{{y}^{2}}{12}-\\frac{(x+3)^{2}}{27}=1.$\n\n$y=\\pm $\n{{field-1}}" :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(-3,0),\\,a=\\sqrt{12}=2\\sqrt{3},\\,b=\\sqrt{27}=3\\sqrt{3}.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y-0 & =\\pm (\\frac{2\\sqrt{3}}{3\\sqrt{3}})(x-(-3)) \\\\ y & =\\pm \\,\\frac{2}{3}(x+3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186352646 :knowledge-point/_questions [{:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8735dab-3e76-53bb-8a25-9fcd08c92350" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186352648}] :answer-field/correct {:answer/id #uuid "c8735dab-3e76-53bb-8a25-9fcd08c92350" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186352648} :answer-field/id #uuid "b381d918-9cf3-569b-9cb8-4eadf5c85e7e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186352647} {:answer-field/choices [{:answer/id #uuid "7334602b-ec91-5393-a858-4fd28a887add" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186352650}] :answer-field/correct {:answer/id #uuid "7334602b-ec91-5393-a858-4fd28a887add" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186352650} :answer-field/id #uuid "db02c27f-3f3d-5556-b5d7-bd493458efdf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186352649}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ba94fa4e-99b5-5217-b9f3-8081f688e63d" :question/math-academy-id "q-325369" :question/problem "Calculate the asymptotes of the hyperbola $\\frac{(y+4)^{2}}{8}-\\frac{{x}^{2}}{18}=1.$\n\n$y\\,\\,+$\n{{field-1}}\n$=\\pm $\n{{field-2}}" :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(0,-4),\\,a=\\sqrt{8}=2\\sqrt{2},\\,b=\\sqrt{18}=3\\sqrt{2}.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y-(-4) & =\\pm (\\frac{2\\sqrt{2}}{3\\sqrt{2}})(x-0) \\\\ y+4 & =\\pm \\,\\frac{2}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186352651 :knowledge-point/_questions [{:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3044fdf-a534-5cef-b6f7-ba17f30e4826" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186352653}] :answer-field/correct {:answer/id #uuid "b3044fdf-a534-5cef-b6f7-ba17f30e4826" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186352653} :answer-field/id #uuid "4f238af1-6116-599d-8084-47e905e3f471" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186352652} {:answer-field/choices [{:answer/id #uuid "51baa54b-1f22-5d89-afc6-449000b9dda8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}(x-3)" :db/id #edb/ref 17592186352655}] :answer-field/correct {:answer/id #uuid "51baa54b-1f22-5d89-afc6-449000b9dda8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}(x-3)" :db/id #edb/ref 17592186352655} :answer-field/id #uuid "0674679d-1cda-50c6-abaf-5a8e0e5fe74a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186352654}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "babf6353-821a-51d2-8a25-894755482c42" :question/math-academy-id "q-325434" :question/problem "Calculate the asymptotes of the hyperbola $25{x}^{2}-4{y}^{2}-150x-8y+121=0.$\n\n$y\\,\\,+$\n{{field-1}}\n$=\\pm $\n{{field-2}}" :question/worked-solution "Group the $x$ and $y$ terms and complete the square:\n\n$$\n\\begin{aligned}25{x}^{2}-4{y}^{2}-150x-8y+121 & =0 \\\\ 25({x}^{2}-6x)-4({y}^{2}+2y)+121 & =0 \\\\ 25\\,[(x-3)^{2}-9]-4\\,[(y+1)^{2}-1]+121 & =0 \\\\ 25(x-3)^{2}-225-4(y+1)^{2}+4+121 & =0 \\\\ 25(x-3)^{2}-4(y+1)^{2} & =100 \\\\ \\frac{25(x-3)^{2}}{100}-\\frac{4(y+1)^{2}}{100} & =1 \\\\ \\frac{(x-3)^{2}}{4}-\\frac{(y+1)^{2}}{25} & =1\\end{aligned}\n$$\n\nThus it is a horizontal hyperbola\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1,\n$$\n\nso the asymptotes are\n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nHere,\n\n$$\n(h,k)=(3,-1),\\,a=\\sqrt{4}=2,\\,b=\\sqrt{25}=5.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}y-(-1) & =\\pm (\\frac{5}{2})(x-3) \\\\ y+1 & =\\pm \\,\\frac{5}{2}(x-3).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186352656 :knowledge-point/_questions [{:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f52750b-c8cc-565a-8ca4-164813a4d64a" :answer/type {:db/ident :answer.type/math} :answer/value "y+2=\\pm \\frac{1}{2}(x+2)" :db/id #edb/ref 17592186352658} {:answer/id #uuid "847ece12-3b82-51ab-99d5-04d4583be870" :answer/type {:db/ident :answer.type/math} :answer/value "y+2=\\pm 4(x-2)" :db/id #edb/ref 17592186352659} {:answer/id #uuid "94dc00b7-77c6-5e92-9b58-7fb032fa9356" :answer/type {:db/ident :answer.type/math} :answer/value "y-2=\\pm 4(x+2)" :db/id #edb/ref 17592186352660} {:answer/id #uuid "e704999b-2eb5-5f10-af2d-6206dc7ee485" :answer/type {:db/ident :answer.type/math} :answer/value "y+2=\\pm \\frac{1}{4}(x-2)" :db/id #edb/ref 17592186352661} {:answer/id #uuid "a90fc085-6da9-5793-adf4-d3fc1c0a7e40" :answer/type {:db/ident :answer.type/math} :answer/value "y-2=\\pm 2(x+2)" :db/id #edb/ref 17592186352662}] :answer-field/correct {:answer/id #uuid "e704999b-2eb5-5f10-af2d-6206dc7ee485" :answer/type {:db/ident :answer.type/math} :answer/value "y+2=\\pm \\frac{1}{4}(x-2)" :db/id #edb/ref 17592186352661} :answer-field/id #uuid "81eb7818-3bd0-54f5-9076-bf68df896d65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186352657}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dfd5e6-7533-5893-9049-cca7e6b67e63" :question/math-academy-id "q-86791" :question/problem "Calculate the asymptotes of the hyperbola $16{y}^{2}-{x}^{2}+4x+64y+44=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}16{y}^{2}-{x}^{2}+4x+64y+44 & =0 \\\\ 16{y}^{2}+64y-{x}^{2}+4x & =-44 \\\\ 16[{y}^{2}+4y]-[{x}^{2}-4x] & =-44 \\\\ 16[(y+2)^{2}-4]-[(x-2)^{2}-4] & =-44 \\\\ 16(y+2)^{2}-64-(x-2)^{2}+4 & =-44 \\\\ 16(y+2)^{2}-(x-2)^{2} & =-44+64-4 \\\\ 16(y+2)^{2}-(x-2)^{2} & =16 \\\\ \\frac{16(y+2)^{2}}{16}-\\frac{(x-2)^{2}}{16} & =\\frac{16}{16} \\\\ (y+2)^{2}-\\frac{(x-2)^{2}}{16} & =1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(2,-2),\\,a=\\sqrt{1}=1,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y+2 & =\\pm \\frac{1}{4}(x-2).\\end{aligned}\n$$"}]}
