2</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msup></mtd></mtr><mtr><mtd><msup><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><msub><mi>log</mi><mn>2</mn></msub><mo data-mjx-texclass=\"NONE\">\u2061</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo></mrow></msup><mo>\u22c5</mo><msup><mn>2</mn><mn>4</mn></msup></mtd><mtd><mi></mi><mo>\u2264</mo><msup><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><msub><mi>log</mi><mn>2</mn></msub><mo data-mjx-texclass=\"NONE\">\u2061</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>\u2212</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></msup></mtd></mtr><mtr><mtd><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mn>3</mn><mo stretchy=\"false\">)</mo><mo>\u22c5</mo><mn>16</mn></mtd><mtd><mi></mi><mo>\u2264</mo><mi>x</mi><mo>\u2212</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>16</mn><mi>x</mi><mo>+</mo><mn>48</mn></mtd><mtd><mi></mi><mo>\u2264</mo><mi>x</mi><mo>\u2212</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>15</mn><mi>x</mi></mtd><mtd><mi></mi><mo>\u2264</mo><mo>\u2212</mo><mn>50</mn></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mi></mi><mo>\u2264</mo><mo>\u2212</mo><mstyle displaystyle=\"true\" scriptlevel=\"0\"><mfrac><mn>10</mn><mn>3</mn></mfrac></mstyle></mtd></mtr></mtable></math></mjx-assistive-mml></mjx-container></p>\n<p>Now, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:</p>\n<p><mjx-container class=\"MathJax CtxtMenu_Attached_0\" jax=\"CHTML\" display=\"true\" tabindex=\"0\" ctxtmenu_counter=\"7\" style=\"font-size: 119.4%; position: relative;\"><mjx-math display=\"true\" class=\"MJX-TEX\" aria-hidden=\"true\" style=\"margin-left: 0px; margin-right: 0px;\"><mjx-mtable style=\"min-width: 12.589em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0px; padding-bottom: 0.3em;\"><mjx-mi class=\"mjx-i\"><mjx-c