erset{―}{y}) \\\\  & =\\frac{1}{4}[(1-3)(2-3)+(2-3)(1-3)+(2-3)(3-3)+(7-3)(6-3)] \\\\  & =\\frac{1}{4}[(-2)(-1)+(-1)(-2)+(-1)(0)+(4)(3)] \\\\  & =\\frac{1}{4}[2+2+0+12] \\\\  & =\\frac{1}{4}\\cdot 16 \\\\  & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149571" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/activity-metadata.json" "file_sha256" "924d48f416a43ecafed5234df2f9b453fdd0c6d3e7fbb8f99de0bcaac9a84f22"} {"question" "q-149571" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149571" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2.5"] ["math" "3"] ["math" "3.5"] ["math" "4"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149571" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149617" "field" nil "attribute" "question/problem" "value" "Consider the following data sets:\n\n$$\nx={6,\\,4,\\,8,\\,6},\\,y={4,\\,7,\\,11,\\,14}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=9.$ Calculate $\\text{Cov}(x,y).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149617" "field" nil "attribute" "question/worked-solution" "value" "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(4-9)+(4-6)(7-9)+(8-6)(11-9)+(6-6)(14-9)] \\\\  & =\\frac{1}{4}[(0)(-5)+(-2)(-2)+(2)(2)+(0)(5)] \\\\  & =\\frac{1}{4}[0+4+4+0] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149617" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/activity-metadata.json" "file_sha256" "924d48f416a43ecafed5234df2f9b453fdd0c6d3e7fbb8f99de0bcaac9a84f22"} {"question" "q-149617" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149617" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-5"] ["math" "1"] ["math" "2"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149617" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149618" "field" nil "attribute" "question/problem" "value" "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={-12,\\,-10,\\,-9,\\,-13},\\,y={-2,\\,0,\\,3,\\,3}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149618" "field" nil "attribute" "question/worked-solution" "value" "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (-12-10-9-13) \\\\  & =\\frac{1}{4}\\cdot (-44) \\\\  & =-11 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (-2+0+3+3) \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-12-(-11))(-2-1)+(-10-(-11))(0-1) \\\\  & \\,\\,\\,+(-9-(-11))(3-1)+(-13-(-11))(3-1)] \\\\  & =\\frac{1}{4}[(-1)(-3)+(1)(-1)+(2)(2)+(-2)(2)] \\\\  & =\\frac{1}{4}[3-1+4-4] \\\\  & =\\frac{1}{4}\\cdot 2 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149618" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/activity-metadata.json" "file_sha256" "924d48f416a43ecafed5234df2f9b453fdd0c6d3e7fbb8f99de0bcaac9a84f22"} {"question" "q-149618" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149618" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-\\frac{1}{2}"] ["math" "1"] ["math" "\\frac{1}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"} {"question" "q-149618" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json" "file_sha256" "8564607f29b53019abb9aa7c914fc47faaf2fb7b8e5d7c839818798c676fe78b"}] "usage" {} "basis" 2357 "retract