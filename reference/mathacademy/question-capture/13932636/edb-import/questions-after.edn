#{[{:db/id #edb/ref 17592186096333 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/id #uuid "8e4367b2-f7bc-5588-b30b-d612915e3e68" :question/is-example true :question/math-academy-id "e-3624" :question/problem "Given that $f(x)=3e^x + \\ln 3$, find $f'(x)$." :question/worked-solution "The derivative of $e^x$ is just $e^x$ itself. On the other hand, $\\ln 3$ is a constant, so its derivative is $0$.\n\nUsing the addition rule, then, we have\n\n$$\n\\begin{aligned} f'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3e^x + \\ln 3\\right) \\\\ &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3e^x\\right) + \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\ln 3 \\right) \\\\ &= 3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right) + 0 \\\\ &= 3 e^x. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096334 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/id #uuid "48334c0c-a49e-5dfb-9f8a-8caa0c22d1f9" :question/is-example true :question/math-academy-id "e-3625" :question/problem "Given that $f(x)=4e^x+ 3x^4 - x^2$, find $f'(x)$." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned} f'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x+3x^{4} - x^2 \\right) \\\\ &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4e^x\\right)+\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3x^{4}\\right) -\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{2}\\right) \\\\ &= 4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right)+3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^{4}\\right) - 2x \\\\ &= 4 e^x+ 3 \\cdot 4x^{3} - 2x \\\\ &= 4 e^x+ 12x^{3} - 2x. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096335 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/is-example true :question/math-academy-id "e-3626" :question/problem "Given that $f(x)=3 \\cdot 2^x$, find $f'(x)$." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned} f'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3 \\cdot 2^x\\right) \\\\ &= 3 \\cdot \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(2^x\\right) \\\\ &= 3 \\cdot 2^{x}\\ln 2 \\\\ &= 3 \\ln 2 \\cdot 2^{x}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245223 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ccd40c-0532-5362-a8ab-8899ae46bbda" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245225} {:answer/id #uuid "f936e2c5-bb90-5d98-8e50-7f79279bc89c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186245226} {:answer/id #uuid "afd0be6c-6058-575e-87f5-515c036dc8cf" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245227} {:answer/id #uuid "2c8e8f7d-6782-50d3-aa4c-e69b9df8ef08" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245228} {:answer/id #uuid "7f0210e5-8a8f-511b-b027-ed23976105f5" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡5" :db/id #edb/ref 17592186245229}] :answer-field/correct {:answer/id #uuid "2c8e8f7d-6782-50d3-aa4c-e69b9df8ef08" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245228} :answer-field/id #uuid "31c58275-d3e3-584a-8929-d5aead0b0695" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245224}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f7b61deb-1329-54cd-9f8e-7b37d897d8b2" :question/is-example false :question/math-academy-id "q-101587" :question/problem "Given that $f(x)=5{e}^{x}+1$, find the slope of the tangent at $x=0.$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $1$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =5{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5{e}^{x})\\,|}_{x=0} \\\\  & =5{e}^{0} \\\\  & =5\\cdot 1 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245230 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc377ebd-3b51-5feb-ae05-84cf080f2041" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186245232} {:answer/id #uuid "4ac05082-c107-50e1-8494-5a7fbfaa40de" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186245233} {:answer/id #uuid "cbe5b93e-9bf6-55df-bc3a-2300a72e143c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245234} {:answer/id #uuid "412f2cb6-8e57-5bbc-94ac-8e58cbdd8922" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245235} {:answer/id #uuid "16d2efe9-4ce8-586b-ae79-36fbce4714c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186245236}] :answer-field/correct {:answer/id #uuid "cc377ebd-3b51-5feb-ae05-84cf080f2041" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186245232} :answer-field/id #uuid "f2fb3ab1-f249-566b-9bd7-7df1102800d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245231}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "151e5a9a-4eb7-551f-83a1-b54374213ab5" :question/is-example false :question/math-academy-id "q-101590" :question/problem "Given that $f(x)=2{e}^{x}-ln⁡11$, find the slope of the tangent at $x=1.$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-ln⁡11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}-ln⁡11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-ln⁡11) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x})\\,|}_{x=1} \\\\  & =2{e}^{1} \\\\  & =2e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245237 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b33c4381-902e-578b-9646-52b7678e06f9" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186245239} {:answer/id #uuid "982123d8-6562-543f-aa63-9d0edda6abd9" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186245240} {:answer/id #uuid "ab81de42-b3fe-573e-8bc1-7ab5a95c11a3" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186245241} {:answer/id #uuid "1173697c-4512-545e-8a09-fc54613d0bab" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186245242} {:answer/id #uuid "57a7c55e-bee9-5aa3-b1f8-c42909909914" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186245243}] :answer-field/correct {:answer/id #uuid "b33c4381-902e-578b-9646-52b7678e06f9" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186245239} :answer-field/id #uuid "0f95d7b7-b698-552f-81b3-d35214e77069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245238}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6695fa0f-c166-510d-bef5-83f050a38203" :question/is-example false :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245244 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "599dad21-c0ca-53c3-ba45-53b35a5f7f85" :answer/type {:db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186245246} {:answer/id #uuid "924eb671-ceb2-51ab-a025-1ca54ad3b1a2" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186245247} {:answer/id #uuid "fed61a98-8e2e-5048-a8fe-7098bb9a5914" :answer/type {:db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186245248} {:answer/id #uuid "13ea3006-3caf-5435-8c18-687bd17034ec" :answer/type {:db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186245249} {:answer/id #uuid "3f0a0328-9a5a-5b54-a7f2-0edfef71ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186245250}] :answer-field/correct {:answer/id #uuid "fed61a98-8e2e-5048-a8fe-7098bb9a5914" :answer/type {:db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186245248} :answer-field/id #uuid "ea0e8ba2-41a5-50da-9da6-ca205ec4e4c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245245}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eba396a3-91f5-53b3-9038-a796230d1de8" :question/is-example false :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245251 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20f9a831-647d-5eab-a0a9-6c67c2689274" :answer/type {:db/ident :answer.type/math} :answer/value "2+6e" :db/id #edb/ref 17592186245253} {:answer/id #uuid "bba20075-83e0-5bbd-bad2-535c7563134d" :answer/type {:db/ident :answer.type/math} :answer/value "8e" :db/id #edb/ref 17592186245254} {:answer/id #uuid "2fdfcb39-e34f-5ef1-a6e5-4c3bbf46379d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186245255} {:answer/id #uuid "2397b92c-fd15-59b5-a1e0-d6fb1b394ffc" :answer/type {:db/ident :answer.type/math} :answer/value "6e" :db/id #edb/ref 17592186245256} {:answer/id #uuid "c0c70661-df72-5115-9e5c-f109801e513e" :answer/type {:db/ident :answer.type/math} :answer/value "1+6e" :db/id #edb/ref 17592186245257}] :answer-field/correct {:answer/id #uuid "2fdfcb39-e34f-5ef1-a6e5-4c3bbf46379d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186245255} :answer-field/id #uuid "8cefc821-2654-5e29-8375-8078e8443fcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245252}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "10dbaed9-d34d-5103-bc8c-6018b7175763" :question/is-example false :question/math-academy-id "q-140432" :question/problem "Given that $f(x)={x}^{2}+2x+6{e}^{x}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x)+\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+6\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2x+2+6{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2x+2+6{e}^{x})\\,|}_{x=0} \\\\  & =2\\cdot 0+2+6\\cdot {e}^{0} \\\\  & =2+6\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245258 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f776fbe7-c1ff-54fc-9972-defd134a63fe" :answer/type {:db/ident :answer.type/math} :answer/value "-4e" :db/id #edb/ref 17592186245260} {:answer/id #uuid "34739037-4fea-5202-b0b4-eea9382ebfb1" :answer/type {:db/ident :answer.type/math} :answer/value "2e-6" :db/id #edb/ref 17592186245261} {:answer/id #uuid "1da42195-ced4-523c-ab75-07cc0b7ca3f4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245262} {:answer/id #uuid "70ca3050-050a-53e9-ac76-2a0b10754aec" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245263} {:answer/id #uuid "61226f53-ac4b-5e8f-a2c1-0c2bda2f146b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186245264}] :answer-field/correct {:answer/id #uuid "1da42195-ced4-523c-ab75-07cc0b7ca3f4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245262} :answer-field/id #uuid "b302b289-5bb7-5cc6-be7e-31685a513c5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245259}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6f96b023-aa99-5126-9d98-2d4b7dde2056" :question/is-example false :question/math-academy-id "q-17247" :question/problem "Given that $f(x)=2{e}^{x}-3{x}^{2}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}-3{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =2{e}^{x}-3(2x) \\\\  & =2{e}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2{e}^{x}-6x)\\,|}_{x=0} \\\\  & =2{e}^{0}-6\\cdot 0 \\\\  & =2\\cdot 1-0 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245265 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9533f672-1273-558b-976a-c9808d9634f4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245267} {:answer/id #uuid "d75aa0e5-48ff-51c7-88b7-5d17442e535b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186245268} {:answer/id #uuid "ba8507fc-287c-595a-868d-23c80652e40c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186245269} {:answer/id #uuid "5c3b7e2b-79a6-5680-8e90-5524874769b9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245270} {:answer/id #uuid "f589d543-7898-53f0-966c-016fce897ef7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245271}] :answer-field/correct {:answer/id #uuid "5c3b7e2b-79a6-5680-8e90-5524874769b9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245270} :answer-field/id #uuid "7da4826b-5ec3-5f81-954a-7e77adbd899c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245266}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "333fcb51-0bbe-5fd1-abf3-582272445148" :question/is-example false :question/math-academy-id "q-17255" :question/problem "Given that $f(x)=11{e}^{x}+8{x}^{2}-12x-20$, find the slope of the tangent at $x=0.$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11{e}^{x}+8{x}^{2}-12x-20) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(8{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(12x)-\\frac{\\text{d}}{\\text{d}x}(20) \\\\  & =11\\frac{\\text{d}}{\\text{d}x}({e}^{x})+8\\frac{\\text{d}}{\\text{d}x}({x}^{2})-12\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(20) \\\\  & =11{e}^{x}+8(2x)-12(1)-0 \\\\  & =11{e}^{x}+16x-12.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(11{e}^{x}+16x-12)|}_{x=0} \\\\  & =11{e}^{0}+16\\cdot 0-12 \\\\  & =11\\cdot 1+0-12 \\\\  & =11-12 \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245272 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8ceeea3-9d41-55e5-b584-5aeb99474063" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id #edb/ref 17592186245274} {:answer/id #uuid "edad8190-417a-5069-b8e2-977076c2e1f1" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3" :db/id #edb/ref 17592186245275} {:answer/id #uuid "58f52d14-95ee-582b-bab5-a83eedbbf36c" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5e" :db/id #edb/ref 17592186245276} {:answer/id #uuid "cbfc7296-a450-5ed8-a358-2c4347a0d850" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186245277} {:answer/id #uuid "f68449a8-1439-54b6-9112-9b071eadd874" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245278}] :answer-field/correct {:answer/id #uuid "a8ceeea3-9d41-55e5-b584-5aeb99474063" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id #edb/ref 17592186245274} :answer-field/id #uuid "e5c9bfd2-6e1c-5078-86fc-2bbc3906ccd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245273}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d4297003-d87d-50b1-8d62-c56588831177" :question/is-example false :question/math-academy-id "q-17388" :question/problem "Given that $f(x)={3}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}y}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+5\\frac{\\text{d}y}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}ln⁡3+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}ln⁡3+5{e}^{x})|}_{x=0} \\\\  & ={3}^{0}ln⁡3+5{e}^{0} \\\\  & =1\\cdot ln⁡3+5\\cdot 1 \\\\  & =ln⁡3+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245279 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d96f7801-6943-57f4-b621-19f2d5dcde26" :answer/type {:db/ident :answer.type/math} :answer/value "42+2e^{-1}" :db/id #edb/ref 17592186245281}] :answer-field/correct {:answer/id #uuid "d96f7801-6943-57f4-b621-19f2d5dcde26" :answer/type {:db/ident :answer.type/math} :answer/value "42+2e^{-1}" :db/id #edb/ref 17592186245281} :answer-field/id #uuid "4e07171e-7a33-53a0-97d2-e7b785679a49" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245280}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e65e96ca-4822-5bf0-bb2c-1ba7385542a1" :question/is-example false :question/math-academy-id "q-304035" :question/problem "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245282 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc271ec7-0efc-54b3-9115-2685575056a3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot8^x\\ln(8)+12" :db/id #edb/ref 17592186245284} {:answer/id #uuid "41681629-b813-58d0-8acb-d3d785c357f9" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot8^x+12" :db/id #edb/ref 17592186245285}] :answer-field/correct {:answer/id #uuid "bc271ec7-0efc-54b3-9115-2685575056a3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot8^x\\ln(8)+12" :db/id #edb/ref 17592186245284} :answer-field/id #uuid "e6936770-a4e5-5a11-9389-0331d0fdaf38" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245283}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd96388d-6f15-569f-bc11-b254a12e45eb" :question/is-example false :question/math-academy-id "q-304038" :question/problem "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(ln⁡(8){8}^{x})+12(1)+0 \\\\  & =3ln⁡(8){8}^{x}+12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245286 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfc49b76-77a7-546d-a59c-0e938e14c9d7" :answer/type {:db/ident :answer.type/math} :answer/value "6e^x" :db/id #edb/ref 17592186245288} {:answer/id #uuid "43073e84-5690-55fc-ac6a-fa934c6e7fba" :answer/type {:db/ident :answer.type/math} :answer/value "6e^x+8" :db/id #edb/ref 17592186245289}] :answer-field/correct {:answer/id #uuid "cfc49b76-77a7-546d-a59c-0e938e14c9d7" :answer/type {:db/ident :answer.type/math} :answer/value "6e^x" :db/id #edb/ref 17592186245288} :answer-field/id #uuid "785fb0a2-54cf-5451-8622-411e9884a29a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245287}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5a13ddf1-d3b9-5682-9ec2-7dea245fa36c" :question/is-example false :question/math-academy-id "q-340056" :question/problem "Given that $f(x)=6{e}^{x}+ln⁡8,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡8$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}+ln⁡8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡8) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =6{e}^{x}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245290 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47a48e23-9c46-506c-8e92-391f4fe24039" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186245292}] :answer-field/correct {:answer/id #uuid "47a48e23-9c46-506c-8e92-391f4fe24039" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186245292} :answer-field/id #uuid "304b2bbd-9e43-58d4-8a50-05bf8bb76d8e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245291}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "020a6823-fb1e-518f-92c1-a5ae8eb08fe5" :question/is-example false :question/math-academy-id "q-340067" :question/problem "Given that $f(x)=9{e}^{x}+ln⁡4$, the slope of the tangent line at $x=ln⁡2$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡4$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}+ln⁡4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡4) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=ln⁡2} & ={(9{e}^{x})\\,|}_{x=ln⁡2} \\\\  & =9{e}^{ln⁡2} \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245293 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8207df72-93c7-50e0-bcb5-dbdae30fcbbb" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot8^x\\ln(8)" :db/id #edb/ref 17592186245295}] :answer-field/correct {:answer/id #uuid "8207df72-93c7-50e0-bcb5-dbdae30fcbbb" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot8^x\\ln(8)" :db/id #edb/ref 17592186245295} :answer-field/id #uuid "1cc4d6ae-8842-5ede-8272-2da4e9cb9751" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245294}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c6327cee-2232-53ac-b90a-ea5e68bca1f1" :question/is-example false :question/math-academy-id "q-340272" :question/problem "Given that $f(x)=7-2\\cdot {8}^{x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(7-2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-\\frac{\\text{d}}{\\text{d}x}(2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-2\\frac{\\text{d}}{\\text{d}x}({8}^{x}) \\\\  & =0-2(ln⁡(8){8}^{x}) \\\\  & =-2ln⁡(8){8}^{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245296 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd968646-fada-522e-ab8b-cd5144563887" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(5)+4" :db/id #edb/ref 17592186245298}] :answer-field/correct {:answer/id #uuid "bd968646-fada-522e-ab8b-cd5144563887" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(5)+4" :db/id #edb/ref 17592186245298} :answer-field/id #uuid "d56c8b7d-74e1-5fbc-8f1e-b74aa93f489a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245297}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "47e3375b-0473-5a59-80e0-5aae3fa936ba" :question/is-example false :question/math-academy-id "q-340280" :question/problem "Given that $f(x)={5}^{x}-6{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-6{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-6\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =ln⁡(5)\\cdot {5}^{x}-6(3{x}^{2})+4(1)-0 \\\\  & =ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4)|}_{x=0} \\\\  & =ln⁡(5)\\cdot {5}^{0}-18(0)^{2}+4 \\\\  & =ln⁡(5)\\cdot 1-0+4 \\\\  & =ln⁡(5)+4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245299 :knowledge-point/_questions [{:knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e5d469-e959-5536-b906-dacc240cee2a" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=10-2{e}^{x}" :db/id #edb/ref 17592186245301} {:answer/id #uuid "7b88b5e2-fb90-5cbb-8987-6f8497a70025" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=10-{e}^{x}" :db/id #edb/ref 17592186245302} {:answer/id #uuid "6c1bc884-e006-5051-bf63-c85a8df7fab6" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=0" :db/id #edb/ref 17592186245303} {:answer/id #uuid "4dfcddcd-289d-5bcf-bcc8-8db79c6ac8fa" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-{e}^{x}" :db/id #edb/ref 17592186245304} {:answer/id #uuid "06d355e6-3a0a-5c2b-bd66-07d8a5cd6621" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-2{e}^{x}" :db/id #edb/ref 17592186245305}] :answer-field/correct {:answer/id #uuid "06d355e6-3a0a-5c2b-bd66-07d8a5cd6621" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-2{e}^{x}" :db/id #edb/ref 17592186245305} :answer-field/id #uuid "8830077a-0b44-5300-b2b9-a6ce554bf337" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245300}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ae8d98f7-a543-5e0f-9907-71c10ecb2c5d" :question/is-example false :question/math-academy-id "q-71053" :question/problem "Given that $f(x)=10-2{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $10$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(10-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(10)+\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}) \\\\  & =0-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-2{e}^{x}.\\end{aligned}\\end{aligned}\n$$"}]}
