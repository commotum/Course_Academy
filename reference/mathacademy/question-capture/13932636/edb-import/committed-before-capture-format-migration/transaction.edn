6-9d98-2d4b7dde2056" :question/math-academy-id "q-17247" :question/is-example false :question/problem "Given that $f(x)=2{e}^{x}-3{x}^{2}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}-3{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =2{e}^{x}-3(2x) \\\\  & =2{e}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2{e}^{x}-6x)\\,|}_{x=0} \\\\  & =2{e}^{0}-6\\cdot 0 \\\\  & =2\\cdot 1-0 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17247/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205"] :knowledge-point/questions ["q-17247"] :db/ensure [:knowledge-point/validate]} {:db/id "q-304035/field-1/17ac0832b088fed7a30ea38f17f01b759fd95c23d340fb24a34f6c3b499352e0" :answer/id #uuid "d96f7801-6943-57f4-b621-19f2d5dcde26" :answer/type :answer.type/math :answer/value "42+2e^{-1}" :db/ensure [:answer/validate]} {:db/id "q-304035/field-1" :answer-field/id #uuid "4e07171e-7a33-53a0-97d2-e7b785679a49" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-304035/field-1/17ac0832b088fed7a30ea38f17f01b759fd95c23d340fb24a34f6c3b499352e0" :answer-field/choices ["q-304035/field-1/17ac0832b088fed7a30ea38f17f01b759fd95c23d340fb24a34f6c3b499352e0"] :db/ensure [:answer-field/validate]} {:db/id "q-304035" :question/id #uuid "e65e96ca-4822-5bf0-bb2c-1ba7385542a1" :question/math-academy-id "q-304035" :question/is-example false :question/problem "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-304035/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205"] :knowledge-point/questions ["q-304035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140431/selection/489d13775f78a4b22aaeeec01e9cda585c75638be7b89af12b0a0741204ca677" :answer/id #uuid "fed61a98-8e2e-5048-a8fe-7098bb9a5914" :answer/type :answer.type/math :answer/value "2e+8" :db/ensure [:answer/validate]} {:db/id "q-140431/selection/0300409f33bb51beb7d383399b661ff4fcb5c99fbc8fef4b64a172ca08203ef5" :answer/id #uuid "599dad21-c0ca-53c3-ba45-53b35a5f7f85" :answer/type :answer.type/math :answer/value "2e+4" :db/ensure [:answer/validate]} {:db/id "q-140431/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" :answer/id #uuid "924eb671-ceb2-51ab-a025-1ca54ad3b1a2" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "q-140431/selection/ebca3240bbaf03060745e5f5c8cca59dfc5b49b882d461af3c575db97e76d29b" :answer/id #uuid "3f0a0328-9a5a-5b54-a7f2-0edfef71ab6a" :answer/type :answer.type/math :answer/value "e+4" :db/ensure [:answer/validate]} {:db/id "q-140431/selection/61b5187051a657684ede78476c5fd72b4df081414013e20f1b02675feff02106" 