592186045450 13194139533665 true] [17592186245238 1041 "selection" 13194139533665 true] [17592186245238 1104 #edb/ref 17592186245239 13194139533665 true] [17592186245238 1110 #uuid "0f95d7b7-b698-552f-81b3-d35214e77069" 13194139533665 true] [17592186245239 1034 "{6}^{x}ln⁡6-10x+6" 13194139533665 true] [17592186245239 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245239 1111 #uuid "b33c4381-902e-578b-9646-52b7678e06f9" 13194139533665 true] [17592186245240 1034 "{6}^{x}ln⁡6-10{x}^{2}+6x-19" 13194139533665 true] [17592186245240 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245240 1111 #uuid "982123d8-6562-543f-aa63-9d0edda6abd9" 13194139533665 true] [17592186245241 1034 "{6}^{x}-10{x}^{2}+6x-19" 13194139533665 true] [17592186245241 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245241 1111 #uuid "ab81de42-b3fe-573e-8bc1-7ab5a95c11a3" 13194139533665 true] [17592186245242 1034 "{6}^{x}-10x+6" 13194139533665 true] [17592186245242 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245242 1111 #uuid "1173697c-4512-545e-8a09-fc54613d0bab" 13194139533665 true] [17592186245243 1034 "{6}^{x}ln⁡6-10{x}^{2}+6x" 13194139533665 true] [17592186245243 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245243 1111 #uuid "57a7c55e-bee9-5aa3-b1f8-c42909909914" 13194139533665 true] [17592186245244 1017 #edb/ref 17592186245245 13194139533665 true] [17592186245244 1089 "q-140431" 13194139533665 true] [17592186245244 1091 #edb/ref 17592186045463 13194139533665 true] [17592186245244 1100 "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" 13194139533665 true] [17592186245244 1113 #uuid "eba396a3-91f5-53b3-9038-a796230d1de8" 13194139533665 true] [17592186245244 1138 false 13194139533665 true] [17592186245244 1145 "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$" 13194139533665 true] [17592186245245 1000 #edb/ref 17592186245246 13194139533665 true] [17592186245245 1000 #edb/ref 17592186245247 13194139533665 true] [17592186245245 1000 #edb/ref 17592186245248 13194139533665 true] [17592186245245 1000 #edb/ref 17592186245249 13194139533665 true] [17592186245245 1000 #edb/ref 17592186245250 13194139533665 true] [17592186245245 1040 #edb/ref 17592186045450 13194139533665 true] [17592186245245 1041 "selection" 13194139533665 true] [17592186245245 1104 #edb/ref 17592186245248 13194139533665 true] [17592186245245 1110 #uuid "ea0e8ba2-41a5-50da-9da6-ca205ec4e4c7" 13194139533665 true] [17592186245246 1034 "2e+4" 13194139533665 true] [17592186245246 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245246 1111 #uuid "599dad21-c0ca-53c3-ba45-53b35a5f7f85" 13194139533665 true] [17592186245247 1034 "2e" 13194139533665 true] [17592186245247 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245247 1111 #uuid "924eb671-ceb2-51ab-a025-1ca54ad3b1a2" 13194139533665 true] [17592186245248 1034 "2e+8" 13194139533665 true] [17592186245248 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245248 1111 #uuid "fed61a98-8e2e-5048-a8fe-7098bb9a5914" 13194139533665 true] [17592186245249 1034 "e+8" 13194139533665 true] [17592186245249 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245249 1111 #uuid "13ea3006-3caf-5435-8c18-687bd17034ec" 13194139533665 true] [17592186245250 1034 "e+4" 13194139533665 true] [17592186245250 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245250 1111 #uuid "3f0a0328-9a5a-5b54-a7