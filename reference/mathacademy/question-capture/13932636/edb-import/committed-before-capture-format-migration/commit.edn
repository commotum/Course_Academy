{d}}{\\text{d}x}({5}^{x})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-6\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =ln⁡(5)\\cdot {5}^{x}-6(3{x}^{2})+4(1)-0 \\\\  & =ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4)|}_{x=0} \\\\  & =ln⁡(5)\\cdot {5}^{0}-18(0)^{2}+4 \\\\  & =ln⁡(5)\\cdot 1-0+4 \\\\  & =ln⁡(5)+4.\\end{aligned}\n$$" 13194139533665 true] [17592186245297 1000 #edb/ref 17592186245298 13194139533665 true] [17592186245297 1040 #edb/ref 17592186045449 13194139533665 true] [17592186245297 1041 "field-1" 13194139533665 true] [17592186245297 1104 #edb/ref 17592186245298 13194139533665 true] [17592186245297 1110 #uuid "d56c8b7d-74e1-5fbc-8f1e-b74aa93f489a" 13194139533665 true] [17592186245298 1034 "\\ln(5)+4" 13194139533665 true] [17592186245298 1103 #edb/ref 17592186045453 13194139533665 true] [17592186245298 1111 #uuid "bd968646-fada-522e-ab8b-cd5144563887" 13194139533665 true] [17592186245299 1017 #edb/ref 17592186245300 13194139533665 true] [17592186245299 1089 "q-71053" 13194139533665 true] [17592186245299 1091 #edb/ref 17592186045463 13194139533665 true] [17592186245299 1100 "Given that $f(x)=10-2{e}^{x},$ find ${f}^{′}(x).$" 13194139533665 true] [17592186245299 1113 #uuid "ae8d98f7-a543-5e0f-9907-71c10ecb2c5d" 13194139533665 true] [17592186245299 1138 false 13194139533665 true] [17592186245299 1145 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $10$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(10-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(10)+\\frac{\\text{d}}{\\text{d}x}(-