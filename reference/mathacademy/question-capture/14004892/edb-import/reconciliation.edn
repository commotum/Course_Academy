Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-142315" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/activity-metadata.json" "file_sha256" "50c6f502bd60fceea6148813148952d7c9f32825dff9e7c7a62692e856f6f20d"} {"question" "q-142315" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-142315" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1\\le x\\le 5"] ["math" "-5\\le x\\le -1"] ["text" "$x\\le -5$ or $x\\ge 1$"] ["text" "$x\\le -6$ or $x\\ge 1$"] ["text" "$x\\le 1$ or $x\\ge 5$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-142315" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$x\\le 1$ or $x\\ge 5$"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" nil "attribute" "question/problem" "value" "Find the solution of $-{x}^{2}-5x<0.$\n\n$x$\n{{field-1}}{{field-2}}$\\,\\text{or}\\,x>$\n{{field-3}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" nil "attribute" "question/worked-solution" "value" "To solve the inequality \n\n$$\n-{x}^{2}-5x<0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}-5x\n$$\n\nlies *below* the $x$-axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}-5x & =0 \\\\ -x(x+5) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=-5,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/196587385ffa960d79d64d66f6ba14481905dd3de6159ecaec6a8e7bd2ab58b8.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the $x$-axis.\n\nSo, the solution to the inequality is $x<-5$ or $x>0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/activity-metadata.json" "file_sha256" "50c6f502bd60fceea6148813148952d7c9f32825dff9e7c7a62692e856f6f20d"} {"question" "q-277268" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "<"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277268" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277446" "field" nil "attribute" "question/problem" "value" "Solve the inequality ${x}^{2}\\ge 5x+14$ and express the solution set in interval notation.\n\n$x\\in (${{field-1}}$,$\n{{field-2}}$]\\,⋃\\,[$\n{{field-3}}$,\\,\\infty )$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277446" "field" nil "attribute" "question/worked-solution" "value" "To solve this inequality using the graphical method, we first need to move all of the terms to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}{x}^{2} & \\ge 5x+14 \\\\ {x}^{2}-5x-14 & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y={x}^{2}-5x-14$ lies **above** the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-5x-14 & =0 \\\\ (x-7)(x+2) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-2$ and $x=7,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/628325ae599d6b004fdabe85319ec9f8acd701c76b776cc4dea6b321cb554415.png)\n\nSince we are interested in solving \n\n$$\n{x}^{2}-5x-14\\ge 0,\n$$\n\n \nwe look for the part of the parabola that is **above** the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $x\\le -2$ or $x\\ge 7.$\n\nUsing interval notation, we write $x\\in (-\\infty ,-2]⋃[7,\\infty ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277446" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/activity-metadata.json" "file_sha256" "50c6f502bd60fceea6148813148952d7c9f32825dff9e7c7a62692e856f6f20d"} {"question" "q-277446" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277446" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\infty"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f5