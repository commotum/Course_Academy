urse_Academy/reference/mathacademy/question-capture/14004892/assets/d35f232f4a0ff7dc26238a1ac75ec8c2dc7216efa75f767dbbbac271b8a23a79.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the $x$-axis.\n\nSo, the solution to the inequality is $2<x<6.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277266" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/activity-metadata.json" "file_sha256" "50c6f502bd60fceea6148813148952d7c9f32825dff9e7c7a62692e856f6f20d"} {"question" "q-277266" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277266" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277266" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/state.json" "file_sha256" "e24df0582909315adb72fd277f390f540723e960e189ef30bf731563e1ac64f6"} {"question" "q-277266" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "<"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/