[{:db/id [:question/math-academy-id "q-70302"] :question/problem "Find the solution of $-{x}^{2}+3x\\ge 0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}+3x\\ge 0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}+3x\n$$\n\nlies *above* the $x$-axis or touches this axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+3x & =0 \\\\ -x(x-3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=3,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/68d82c96c820a6a0bf5e3c74ea93cbf2091e96ebfa7dfe200e8beb140cb7962e.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *above* the axis or touches the $x$-axis. \n\nSo, the solution to the inequality is $0\\le x\\le 3.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-75992/selection/ac09eca2f21937a8f083b9dbfcb03b1b1d420c75fa559cfbed0020d026e6ead5" :answer/id #uuid "32c9c689-c84c-51bb-b99d-db2383f566e9" :answer/type :answer.type/math :answer/value "-3<x<5" :db/ensure [:answer/validate]} {:db/id "q-75992/selection/ff97d62455f469acffc9176e7d9adcdf5cc1e23347acf67419cb7f8926cd01e1" :answer/id #uuid "318aa98b-6ffb-5d4e-be4a-f283baa24091" :answer/type :answer.type/text :answer/value "$x<-3$ or $x>5$" :db/ensure [:answer/validate]} {:db/id "q-75992/selection/b713ae4474441d042b7a660abef3e713beb4fdf78f5cfe089085d0dcf002cd3e" :answer/id #uuid "52a8d098-7c90-5f76-b516-7c3d18a12750" :answer/type :answer.type/math :answer/value "x>-5" :db/ensure [:answer/validate]} {:db/id "q-75992/selection/508c99241371692f2758aa079a23870a921af6b6669f58fa3598bdab0ac95f54" :answer/id #uuid "6398ac05-d0cf-50b9-9c57-9c8f1535e1dd" :answer/type :answer.type/text :answer/value "$x<-5$ or $x>3$" :db/ensure [:answer/validate]} {:db/id "q-75992/selection/f39e840f704faf4fb9d30902480e7be0e4adbbb040bb38cf2c59a2184fb27d57" :answer/id #uuid "df0314d7-f4bd-5b85-9dcb-536022968a74" :answer/type :answer.type/math :answer/value "-5<x<3" :db/ensure [:answer/validate]} {:db/id "q-75992/selection" :answer-field/id #uuid "3d14ff67-88a4-5f30-a72a-c4d31746ad93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75992/selection/f39e840f704faf4fb9d30902480e7be0e4adbbb040bb38cf2c59a2184fb27d57" :answer-field/choices ["q-75992/selection/ac09eca2f21937a8f083b9dbfcb03b1b1d420c75fa559cfbed0020d026e6ead5" "q-75992/selection/ff97d62455f469acffc9176e7d9adcdf5cc1e23347acf67419cb7f8926cd01e1" "q-75992/selection/b713ae4474441d042b7a660abef3e713beb4fdf78f5cfe089085d0dcf002cd3e" "q-75992/selection/508c99241371692f2758aa079a23870a921af6b6669f58fa3598bdab0ac95f54" "q-75992/selection/f39e840f704faf4fb9d30902480e7be0e4adbbb040bb38cf2c59a2184fb27d57"] :db/ensure [:answer-field/validate]} {:db/id "q-75992" :question/id #uuid "2282fc8b-5f07-5b53-b623-6b1ab1d9c8e2" :question/math-academy-id "q-75992" :question/problem "Find the solution of $-{x}^{2}-2x+15>0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}-2x+15>0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}-2x+15\n$$\n\nlies *above* the $x$-axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}-2x+15 & =0 \\\\ -({x}^{2}+2x-15) & =0 \\\\ -(x+5)(x-3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-5$ and $x=3,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/da88a1971a7a389c8f5b59ebd3cef2a146eb09113c3e71031bf9dfb6cdbe91e1.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *above* the axis. \n\nSo, the solution to the inequality is $-5<x<3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef5d4f19-5602-54a9-96ea-4e42054ff5c8"] :knowledge-point/questions ["q-75992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277261/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "84c33ea6-bb13-5100-bb87-2bcdc541fcfb" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-277261/field-1" :answer-field/id #uuid "71a8be97-7422-5302-8b78-2578719bcb12" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277261/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-277261/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-277261/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "9c277ac3-bdda-5c4f-88c3-0cb5ff11558a" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-277261/field-2" :answer-field/id #uuid "8101cb33-016b-52eb-86e0-d77b39ea5087" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277261/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-277261/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-277261/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c7475d48-a360-5e40-baed-72fead7588d5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-277261/field-3" :answer-field/id #uuid "dbf1be94-c7ff-5c08-9926-7500dd47f144" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277261/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-277261/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-277261" :question/id #uuid "97cb304e-e93c-5daa-a4b2-1596461506ea" :question/math-academy-id "q-277261" :question/problem "Find the solution of ${x}^{2}+6x\\ge 0.$\n\n$x\\le $\n{{field-1}}$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "To solve the inequality \n\n$$\n{x}^{2}+6x\\ge 0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny={x}^{2}+6x\n$$\n\nlies *above* the $x$-axis or touches this axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}{x}^{2}+6x & =0 \\\\ x(x+6) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=-6,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/7d9fd824b1e4d63e417e002c07a01adb4c14f73fc81be66c31a5c9aa30ab7ffd.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *above* the $x$-axis or touches this axis.\n\nSo, the solution to the inequality is $x\\le -6$ or $x\\ge 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-277261/field-1" "q-277261/field-2" "q-277261/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef5d4f19-5602-54a9-96ea-4e42054ff5c8"] :knowledge-point/questions ["q-277261"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142180/selection/bd2ff21795ab6b7d5240606964364470fa913451d64e80954aff5b68faa6f551" :answer/id #uuid "af590961-0bd5-5ca1-a1b4-14fbac3432c0" :answer/type :answer.type/text :answer/value "$x<3$ or $x>6$" :db/ensure [:answer/validate]} {:db/id "q-142180/selection/6ab4728d9843f245ac233e557b5e68b478b503be693e1bd15d73c03ee260f0c1" :answer/id #uuid "46686b94-fb93-5bd6-a55a-3d1e88237a98" :answer/type :answer.type/math :answer/value "3<x<6" :db/ensure [:answer/validate]} {:db/id "q-142180/selection/05d575ed248854a9b54ce615837b03df8ece97ac92e52e534989729c73021f73" :answer/id #uuid "18af854d-5ad2-5e11-84b7-daace24e2618" :answer/type :answer.type/text :answer/value "$x\\le 3$ or $x\\ge 6$" :db/ensure [:answer/validate]} {:db/id "q-142180/selection/82c48ea180bd130b2e4360b790bb6c1e27b57bc788d345c8aee41d23572a368b" :answer/id #uuid "641801e0-7e99-53e2-8a78-262737cc3391" :answer/type :answer.type/math :answer/value "3\\le x\\le 6" :db/ensure [:answer/validate]} {:db/id "q-142180/selection/cc9cce0f63a2c8b117a2cd4fbe267eabddb06a3b649ea2e64c69defc220732bc" :answer/id #uuid "ea731b58-0672-5c27-9746-f4f563585cee" :answer/type :answer.type/text :answer/value "$x\\le -6$ or $x\\ge -3$" :db/ensure [:answer/validate]} {:db/id "q-142180/selection" :answer-field/id #uuid "b2847316-26e8-5479-9c35-14bafbe0cd46" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-142180/selection/82c48ea180bd130b2e4360b790bb6c1e27b57bc788d345c8aee41d23572a368b" :answer-field/choices ["q-142180/selection/bd2ff21795ab6b7d5240606964364470fa913451d64e80954aff5b68faa6f551" "q-142180/selection/6ab4728d9843f245ac233e557b5e68b478b503be693e1bd15d73c03ee260f0c1" "q-142180/selection/05d575ed248854a9b54ce615837b03df8ece97ac92e52e534989729c73021f73" "q-142180/selection/82c48ea180bd130b2e4360b790bb6c1e27b57bc788d345c8aee41d23572a368b" "q-142180/selection/cc9cce0f63a2c8b117a2cd4fbe267eabddb06a3b649ea2e64c69defc220732bc"] :db/ensure [:answer-field/validate]} {:db/id "q-142180" :question/id #uuid "7c874fa8-4e3f-5670-ad9f-092472b4f347" :question/math-academy-id "q-142180" :question/problem "Find the solution of $-{x}^{2}+9x-18\\ge 0.$" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}+9x-18\\ge 0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}+9x-18\n$$\n\nlies *above* the $x$-axis or touches this axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+9x-18 & =0 \\\\ -({x}^{2}-9x+18) & =0 \\\\ -(x-3)(x-6) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=3$ and $x=6,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/d4c28d26425c3c5bfc95dece73c8d8cb74f395f2de04a2c2ee1b1fd69f8433ed.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *above* the axis or touches the $x$-axis. \n\nSo, the solution to the inequality is $3\\le x\\le 6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-142180/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef5d4f19-5602-54a9-96ea-4e42054ff5c8"] :knowledge-point/questions ["q-142180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277184/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "3005012d-3005-5574-841a-d6d8ef5f1cf8" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-277184/field-1" :answer-field/id #uuid "4d56aba4-068f-554b-845b-6e41b8e9bedd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277184/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-277184/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-277184/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "43b1c655-2664-5778-8256-7306ff56b09e" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-277184/field-2" :answer-field/id #uuid "63a043b6-6b95-5fbc-be4c-967d82a7d960" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277184/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-277184/field-2/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-277184/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :an