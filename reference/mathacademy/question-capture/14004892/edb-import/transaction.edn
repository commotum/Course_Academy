b5aa6a3f29e7154e329926a47bbbb0eb45dce3251148986785f09ee383.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the $x$-axis or touches this axis.\n\nSo, the solution to the inequality is $x\\le 1$ or $x\\ge 5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-142315/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cbe80595-c807-506c-a356-566f1edb3402"] :knowledge-point/questions ["q-142315"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277268/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "cefee137-2b86-53a5-a950-0305643a3607" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-277268/field-1" :answer-field/id #uuid "7bfc3a8d-8388-5e63-9de0-d4f288e3d048" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277268/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-277268/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-277268/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "0383579f-01ee-5c0e-bd91-1d0eef2a6d8b" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-277268/field-2" :answer-field/id #uuid "382dc4ea-c226-539a-bf4c-b9a0cd735211" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277268/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-277268/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-277268/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ab62fed8-1fcd-5d99-8192-76b28169166e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-277268/field-3" :answer-field/id #uuid "f6f31152-4a25-5926-b246-12a60329c9c2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277268/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-277268/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-277268" :question/id #uuid "a8bf36c0-44b3-508f-92cd-90458542d6a9" :question/math-academy-id "q-277268" :question/problem "Find the solution of $-{x}^{2}-5x<0.$\n\n$x$\n{{field-1}}{{field-2}}$\\,\\text{or}\\,x>$\n{{field-3}}" :question/worked-solution "To solve the inequality \n\n$$\n-{x}^{2}-5x<0,\n$$\n\nwe need to find the values of $x$ for which the parabola \n\n$$\ny=-{x}^{2}-5x\n$$\n\nlies *below* the $x$-axis.\n\nFirst, let's find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}-5x & =0 \\\\ -x(x+5) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=-5,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/196587385ffa960d79d64d66f6ba14481905dd3de6159ecaec6a8e7bd2ab58b8.png)\n\nThe values marked in blue show all $x$-values where the parabola lies *below* the $x$-axis.\n\nSo, the solution to the inequality is $x<-5$ or $x>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-277268/field-1" "q-277268/field-2" "q-277268/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cbe80595-c807-506c-a356-566f1edb3402"] :knowledge-point/questions ["q-277268"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277446/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "cce52837-268a-5ecc-91da-5d71e8033de3" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-277446/field-1" :answer-field/id #uuid "a72feb3f-0fe1-51e8-8a4e-89e35357811d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277446/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer-field/choices ["q-277446/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934"] :db/ensure [:answer-field/validate]} {:db/id "q-277446/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "8d3fbda6-0fb0-5b2d-8b8a-d3d0b50816fc" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-277446/field-2" :answer-field/id #uuid "ac47b8b5-23dd-5588-a2a7-16e6299fcb85" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277446/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-277446/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-277446/field-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "008300ee-91bf-520b-8ee5-e9c2ac359303" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-277446/field-3" :answer-field/id #uuid "512746bf-56cc-57f8-9cdf-a0ea75a34112" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277446/field-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-277446/field-3/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-277446" :question/id #uuid "06a5bdb6-75f8-585d-85f0-c921ed00a1b6" :question/math-academy-id "q-277446" :question/problem "Solve the inequality ${x}^{2}\\ge 5x+14$ and express the solution set in interval notation.\n\n$x\\in (${{field-1}}$,$\n{{field-2}}$]\\,⋃\\,[$\n{{field-3}}$,\\,\\infty )$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the terms to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}{x}^{2} & \\ge 5x+14 \\\\ {x}^{2}-5x-14 & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y={x}^{2}-5x-14$ lies **above** the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-5x-14 & =0 \\\\ (x-7)(x+2) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-2$ and $x=7,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/628325ae599d6b004fdabe85319ec9f8acd701c76b776cc4dea6b321cb554415.png)\n\nSince we are interested in solving \n\n$$\n{x}^{2}-5x-14\\ge 0,\n$$\n\n \nwe look for the part of the parabola that is **above** the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $x\\le -2$ or $x\\ge 7.$\n\nUsing interval notation, we write $x\\in (-\\infty ,-2]⋃[7,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-277446/field-1" "q-277446/field-2" "q-277446/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b"] :knowledge-point/questions ["q-277446"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3881/selection/10b67dc80df7f14aea3e6a1acceef04e5d9f01e274592230ac697053d0c7de9c" :answer/id #uuid "42b5bcb4-ae97-5343-bd13-69bf3de6d303" :answer/type :answer.type/math :answer/value "x\\in [-4,4]" :db/ensure [:answer/validate]} {:db/id "q-3881/selection/6ea9d132ecc966614453b9efa703ca6c53cdcafd1f710408ddb1a18075810877" :answer/id #uuid "1ff8c155-e111-5f11-a27b-95d67ef2d45a" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,0]\\cup [4,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-3881/selection/03fdea6a5f31db9f154ccd6fddd947b62dcd119faa2249cdd4f87e6dce41a2ef" :answer/id #uuid "491d4207-815d-51c2-b0d2-c5bb36a643af" :answer/type :answer.type/math :answer/value "x\\in [-4,0]" :db/ensure [:answer/validate]} {:db/id "q-3881/selection/62773e2f885c16d8ec4a4aed668ce0ced8aefb0da96d586642dbcb1356ee3562" :answer/id #uuid "96aeab05-8205-5ad4-a837-aae1365e97b9" :answer/type :answer.type/math :answer/value "x\\in [0,4]" :db/ensure [:answer/validate]} {:db/id "q-3881/selection/0707ac308701c1496779d495253c3085a0772b3291264e76412138286a84f721" :answer/id #uuid "42a70efb-e811-59ca-8b82-7d0822752496" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-4]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-3881/selection" :answer-field/id #uuid "31c95dd9-6725-56ed-8818-45591275d67d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3881/selection/62773e2f885c16d8ec4a4aed668ce0ced8aefb0da96d586642dbcb1356ee3562" :answer-field/choices ["q-3881/selection/10b67dc80df7f14aea3e6a1acceef04e5d9f01e274592230ac697053d0c7de9c" "q-3881/selection/6ea9d132ecc966614453b9efa703ca6c53cdcafd1f710408ddb1a18075810877" "q-3881/selection/03fdea6a5f31db9f154ccd6fddd947b62dcd119faa2249cdd4f87e6dce41a2ef" "q-3881/selection/62773e2f885c16d8ec4a4aed668ce0ced8aefb0da96d586642dbcb1356ee3562" "q-3881/selection/0707ac308701c1496779d495253c3085a0772b3291264e76412138286a84f721"] :db/ensure [:answer-field/validate]} {:db/id "q-3881" :question/id #uuid "aa538d2c-daa6-561a-b09f-00677fd2938c" :question/math-academy-id "q-3881" :question/problem "Find the solution of $-{x}^{2}\\ge -4x.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}-{x}^{2} & \\ge -4x \\\\ -{x}^{2}+4x & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y=-{x}^{2}+4x$ lies above the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}-{x}^{2}+4x & =0 \\\\ -x(x-4) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=0$ and $x=4,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/d234c29de2a39c664d6a03acf1d8cc43782914a3c82045cc103353ebaf67b897.png)\n\nSince we are interested in solving \n\n$$\n-{x}^{2}+4x\\ge 0,\n$$\n\nwe look for the part of the parabola that is above the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $0\\le x\\le 4.$ \n\nUsing interval notation, we write $x\\in [0,4].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-3881/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b"] :knowledge-point/questions ["q-3881"] :db/ensure [:knowledge-point/validate]} {:db/id "q-44772/selection/b3408cddd99acdf30d0fb1a831cea74c0ef34b3c204cae1b033897d7d5a049a6" :answer/id #uuid "8f1bb29a-3d57-5742-b1d7-fb6c5aaa73af" :answer/type :answer.type/math :answer/value "x\\in [-\\frac{5}{2},0]" :db/ensure [:answer/validate]} {:db/id "q-44772/selection/9e912706e41503fce0a12bb1f81844ec934898a9f55b79cbd8e0a5bf703fb6c1" :answer/id #uuid "4fe6323b-1275-5ee6-a278-aeaa86cf5d14" :answer/type :answer.type/math :answer/value "x\\in [0,3]" :db/ensure [:answer/validate]} {:db/id "q-44772/selection/6e9ad189b77126a369408aea47390c266d96e22f9f5a0ca64ed58ce59d1d3ffd" :answer/id #uuid "f91c9c34-345a-509a-8d6e-6a9058bd4cd2" :answer/type :answer.type/math :answer/value "x\\in [0,\\frac{5}{2}]" :db/ensure [:answer/validate]} {:db/id "q-44772/selection/000518d66d14cdd11db396b31ed1678241fd9509422a944b93a711bac8d0a737" :answer/id #uuid "77d4cc90-88df-5703-b111-000a78f60eb0" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-\\frac{5}{2}]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-44772/selection/78912341919908de98dbf50240853504fad6a0ff8c9806b63b9668070a82b5ec" :answer/id #uuid "c3505a1b-80dc-5a09-b7f4-2a9347db1405" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,0]\\cup [\\frac{5}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-44772/selection" :answer-field/id #uuid "a8606a1e-4f71-50a8-9377-1ebe62b5ce95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-44772/selection/b3408cddd99acdf30d0fb1a831cea74c0ef34b3c204cae1b033897d7d5a049a6" :answer-field/choices ["q-44772/selection/b3408cddd99acdf30d0fb1a831cea74c0ef34b3c204cae1b033897d7d5a049a6" "q-44772/selection/9e912706e41503fce0a12bb1f81844ec934898a9f55b79cbd8e0a5bf703fb6c1" "q-44772/selection/6e9ad189b77126a369408aea47390c266d96e22f9f5a0ca64ed58ce59d1d3ffd" "q-44772/selection/000518d66d14cdd11db396b31ed1678241fd9509422a944b93a711bac8d0a737" "q-44772/selection/78912341919908de98dbf50240853504fad6a0ff8c9806b63b9668070a82b5ec"] :db/ensure [:answer-field/validate]} {:db/id "q-44772" :question/id #uuid "e00f75b4-33fd-550f-8d24-3fa586937e86" :question/math-academy-id "q-44772" :question/problem "Find the solution of $-2{x}^{2}\\ge 5x.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}-2{x}^{2} & \\ge 5x \\\\ -2{x}^{2}-5x & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y=-2{x}^{2}-5x$ lies above the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}-2{x}^{2}-5x & =0 \\\\ -x(2x+5) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-\\frac{5}{2}$ and $x=0,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/33b031b579d84d633e4dcc56c912333327449fcbc6969eeceb34e209c4d308d1.png)\n\nSince we are interested in solving \n\n$$\n-2{x}^{2}-5x\\ge 0,\n$$\n\n we look for the part of the parabola that is above the $x$-axis or touches this axis.\n\n Based on the graph, the solution is $-\\frac{5}{2}\\le x\\le 0.$ \n\nUsing interval notation, we write $x\\in [-\\frac{5}{2},0].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-44772/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b"] :knowledge-point/questions ["q-44772"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-3951"] :question/problem "Find the solution of $2{x}^{2}-12\\le -5x.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}2{x}^{2}-12 & \\le -5x \\\\ 2{x}^{2}+5x-12 & \\le 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y=2{x}^{2}+5x-12$ lies below the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}2{x}^{2}+5x-12 & =0 \\\\ (2{x}^{2}+8x)+(-3x-12) & =0 \\\\ 2x(x+4)-3(x+4) & =0 \\\\ (2x-3)(x+4) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-4$ and $x=\\frac{3}{2},$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/ba6c384800a5b42f2033527997328aa9f9d792b33b3fabecfe9b3a93789f46c4.png)\n\nSince we are interested in solving\n \n\n$$\n2{x}^{2}+5x-12\\le 0,\n$$\n\n we look for the part of the parabola that is below the $x$-axis or touches this axis.\n\n Based on the graph, the solution is $-4\\le x\\le \\frac{3}{2}.$ \n\nUsing interval notation, we write $x\\in [-4,\\frac{3}{2}].$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-3875/selection/797a9e9fcfe59eeaa8bfdd3198508511b290186ef3b9de356ce807def479dcef" :answer/id #uuid "3152fd5f-053a-53ef-b4b5-f23db7077658" :answer/type :answer.type/math :answer/value "x\\in [0,9]" :db/ensure [:answer/validate]} {:db/id "q-3875/selection/5d7de2842e0b7a783941cddc224c1e5866eb9c0b6d09db591f0dba57410931c6" :answer/id #uuid "688f528a-2a4d-5a1d-b1c7-33237de89fea" :answer/type :answer.type/math :answer/value "x\\in [-9,0]" :db/ensure [:answer/validate]} {:db/id "q-3875/selection/eeaaccf55246dc334b1d1d3d21db028c57bf5840574ca3bda26a88f9b914b5b0" :answer/id #uuid "066c2e89-73b8-5bcf-923c-00f96ba2cf9f" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-9]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-3875/selection/1bc930b819a867dd92316c630f72f43b0ef797f90031e70198283ab49c55f76a" :answer/id #uuid "ef486d5b-856b-5e96-a823-26277781df64" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,9]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-3875/selection/4def16ae8b48b0b3abfdb210122ab37f4abc47116bc0ed80ec205a478f8dfd26" :answer/id #uuid "557bf362-c269-5faa-b5e9-d2b620a376f5" :answer/type :answer.type/math :answer/value "x\\in [-9,9]" :db/ensure [:answer/validate]} {:db/id "q-3875/selection" :answer-field/id #uuid "a183b333-0b28-5416-8dbd-17b595d42844" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3875/selection/5d7de2842e0b7a783941cddc224c1e5866eb9c0b6d09db591f0dba57410931c6" :answer-field/choices ["q-3875/selection/797a9e9fcfe59eeaa8bfdd3198508511b290186ef3b9de356ce807def479dcef" "q-3875/selection/5d7de2842e0b7a783941cddc224c1e5866eb9c0b6d09db591f0dba57410931c6" "q-3875/selection/eeaaccf55246dc334b1d1d3d21db028c57bf5840574ca3bda26a88f9b914b5b0" "q-3875/selection/1bc930b819a867dd92316c630f72f43b0ef797f90031e70198283ab49c55f76a" "q-3875/selection/4def16ae8b48b0b3abfdb210122ab37f4abc47116bc0ed80ec205a478f8dfd26"] :db/ensure [:answer-field/validate]} {:db/id "q-3875" :question/id #uuid "30b6a93f-c7e8-5ae1-bd52-e140f18d4ecf" :question/math-academy-id "q-3875" :question/problem "Find the solution of ${x}^{2}\\le -9x.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$\n\n$$\n\\begin{aligned}{x}^{2} & \\le -9x \\\\ {x}^{2}+9x & \\le 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y={x}^{2}+9x$ lies below the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}{x}^{2}+9x & =0 \\\\ x(x+9) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-9$ and $x=0,$ and we can graph the parabola as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004892/assets/eacd8f468f34bea6eec93afd32bbeee452a3a6435342035f7c45c3578f40f92f.png)\n\nSince we are interested in solving \n\n$$\n{x}^{2}+9x\\le 0,\n$$\n\n we look for the part of the parabola that is below the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $-9\\le x\\le 0.$ \n\nUsing interval notation, we write $x\\in [-9,0].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-3875/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b"] :knowledge-point/questions ["q-3875"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3878/selection/7ab64f3f1186ca029114597dadde248e9210b445db9cc4765c9eb6842f104079" :answer/id #uuid "81296db2-a25c-59ea-897c-e682c8e58487" :answer/type :answer.type/math :answer/value "x\\in (0,3)" :db/ensure [:answer/validate]} {:db/id "q-3878/selection/ffae011c948e35e39590d3fd0895f474e5198241ae71974b4a217318bfaea6b8" :answer/id #uuid "37bc8824-4184-56a9-b61c-eb8af36c361d" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-3)\\cup (0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-3878/selection/ac8a310096cc61d1db7c2a9abbb7f349ac10a1b8fee177406effd0480d1843eb" :answer/id #uuid "c7e02b04-a58f-5f09-97ad-641ac954cf2d" :answer/type :answer.type/math :answer/valu