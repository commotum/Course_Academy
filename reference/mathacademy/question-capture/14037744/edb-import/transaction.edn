/difficulty :question.difficulty/easy :question/answer-fields ["q-123224/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea"] :knowledge-point/questions ["q-123224"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123319/selection/caa82b03f19606e3b97fc6a57f569e8927af032fed5735e22630e87ceb56e17f" :answer/id #uuid "7e403d58-a8a0-5564-bf33-23e71d03d682" :answer/type :answer.type/math :answer/value "⟨\\frac{3t}{4}+8t,\\,{e}^{t+1}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123319/selection/cd82c1b0ef9e254b8c5226bcc240c460c542bfdf63386075d342945e88e3b24c" :answer/id #uuid "a870ff6f-aca3-5d3a-bfc9-38b70bfe1d98" :answer/type :answer.type/math :answer/value "⟨\\frac{{t}^{4}}{2}+8t,\\,{e}^{t+1}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123319/selection/8f6e5cd9455cf33303441901476ef81c98c0b5d93d5a4068c69114ed4eb9bbcc" :answer/id #uuid "cb4a6834-76ae-5517-92d4-424998d1db45" :answer/type :answer.type/math :answer/value "⟨\\frac{3{t}^{4}}{2}+8t,\\,{e}^{t-1}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123319/selection/2e649f13f7e84a64f4dca02242bcf5de9d2a3caa5eb26a2596a07ba823ed94c9" :answer/id #uuid "0f4c361f-31eb-5c73-b6f0-d6d09b784717" :answer/type :answer.type/math :answer/value "⟨\\frac{3{t}^{4}}{2}+8t,\\,{e}^{t+1}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123319/selection/98c50bd5c5f78d37342b7af8fe22b7cf9ba65ad956fc0b286c8e8105d01d1baf" :answer/id #uuid "d10051ad-4c29-521b-b9c7-3714d1aabdcb" :answer/type :answer.type/math :answer/value "⟨\\frac{4{t}^{2}}{3},\\,{e}^{t}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123319/selection" :answer-field/id #uuid "3fb8b05d-f7e2-5c53-8124-b26c25571fe0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123319/selection/2e649f13f7e84a64f4dca02242bcf5de9d2a3caa5eb26a2596a07ba823ed94c9" :answer-field/choices ["q-123319/selection/caa82b03f19606e3b97fc6a57f569e8927af032fed5735e22630e87ceb56e17f" "q-123319/selection/cd82c1b0ef9e254b8c5226bcc240c460c542bfdf63386075d342945e88e3b24c" "q-123319/selection/8f6e5cd9455cf33303441901476ef81c98c0b5d93d5a4068c69114ed4eb9bbcc" "q-123319/selection/2e649f13f7e84a64f4dca02242bcf5de9d2a3caa5eb26a2596a07ba823ed94c9" "q-123319/selection/98c50bd5c5f78d37342b7af8fe22b7cf9ba65ad956fc0b286c8e8105d01d1baf"] :db/ensure [:answer-field/validate]} {:db/id "q-123319" :question/id #uuid "df00f0c0-8884-50e4-8a06-bd7eedd1eafa" :question/math-academy-id "q-123319" :question/problem "If ${F}^{′}(t)=⟨6{t}^{3}+8,\\,{e}^{t+1}⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨6{t}^{3}+8,\\,{e}^{t+1}⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨6{t}^{3}+8,\\,{e}^{t+1}⟩\\text{d}t & =⟨\\int (6{t}^{3}+8)\\,\\text{d}t,\\int {e}^{t+1}\\,\\text{d}t⟩ \\\\  & =⟨\\frac{3{t}^{4}}{2}+8t+{c}_{1},\\,{e}^{t+1}+{c}_{2}⟩ \\\\  & =⟨\\frac{3{t}^{4}}{2}+8t,\\,{e}^{t+1}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\frac{3{t}^{4}}{2}+8t,\\,{e}^{t+1}⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123319/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea"] :knowledge-point/questions ["q-123319"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123424/selection/117b30badf67c39c0b8c5fd918771c1721f25554f0a77fff1cec5f730937ea42" :answer/id #uuid "657584f9-862b-5e76-a30d-9c7a11f65045" :answer/type :answer.type/math :answer/value "⟨{sin}^{2}⁡t,\\,{e}^{3t}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123424/selection/9926f705b7d46a681cdd930da13c2466eded30b0438c877447fd11f8edb416bc" :answer/id #uuid "171dbb49-5856-5a4b-a574-0a4958fbd86c" :answer/type :answer.type/math :answer/value "⟨-4\\operatorname{cos}⁡t,\\,{e}^{3t}⟩+C" :db/ensure [:answer/validate]} {:db/id "q-1234