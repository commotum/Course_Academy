tion/85e4189f9f88ba21c7b65818ab59c6813cc6b20c2904ade9ef7d02567c3ef7aa"] :db/ensure [:answer-field/validate]} {:db/id "q-99268" :question/id #uuid "c999e655-1f88-54f4-a90f-5c566eaba127" :question/math-academy-id "q-99268" :question/problem "$\\int ⟨\\frac{1}{{t}^{2}},\\,-\\operatorname{cot}⁡t\\operatorname{csc}⁡t⟩\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨\\frac{1}{{t}^{2}},\\,-\\operatorname{cot}⁡t\\operatorname{csc}⁡t⟩\\text{d}t & =⟨\\int \\frac{1}{{t}^{2}}\\,\\text{d}t,\\,\\int -\\operatorname{cot}⁡t\\operatorname{csc}⁡t\\,\\text{d}t⟩ \\\\  & =⟨-\\frac{1}{t}+{c}_{1},\\,\\operatorname{csc}⁡t+{c}_{2}⟩ \\\\  & =⟨-\\frac{1}{t},\\,\\operatorname{csc}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-\\frac{1}{t},\\,\\operatorname{csc}⁡t⟩+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99268/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8"] :knowledge-point/questions ["q-99268"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349150/field-1/cef844f984b60552a9c52522bddacb7f61630a8705246b75d7a6580f476f785f" :answer/id #uuid "b0c6ff27-9471-5a2f-ab38-fae61b711c6b" :answer/type :answer.type/math :answer/value "\\frac{40}{3}" :db/ensure [:answer/validate]} {:db/id "q-349150/field-1" :answer-field/id #uuid "2bb7dace-5b5c-5f36-83ed-5fef89ac886c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349150/field-1/cef844f984b60552a9c52522bddacb7f61630a8705246b75d7a6580f476f785f" :answer-field/choices ["q-349150/field-1/cef844f984b60552a9c52522bddacb7f61630a8705246b75d7a6580f476f785f"] :db/ensure [:answer-field/validate]} {:db/id "q-349150/field-2/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "889e2b17-059e-5003-bed7-ea3e1142dd14" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-349150/field-2" :answer-field/id #uuid "618d9a77-1494-517b-88d6-a861903a0587" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349150/field-2/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer-field/choices ["q-349150/field-2/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776"] :db/ensure [:answer-field/validate]} {:db/id "q-349150" :question/id #uuid "38fa20a5-69c7-5d73-82b7-ef72ada1eb2c" :question/math-academy-id "q-349150" :question/problem "Evaluate the following integral of a vector-valued function. Do not round the answer.\n\n${\\int }_{-1}^{3}⟨{t}^{2}+t,\\,2{t}^{3}-t⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}⟨{t}^{2}+t,\\,2{t}^{3}-t⟩\\,\\text{d}t & =⟨{\\int }_{-1}^{3}({t}^{2}+t)\\,\\text{d}t,\\,{\\int }_{-1}^{3}(2{t}^{3}-t)\\,\\text{d}t⟩.\\end{aligned}\n$$\n\nFor the first component,\n\n$$\n\\int ({t}^{2}+t)\\,\\text{d}t=\\frac{1}{3}{t}^{3}+\\frac{1}{2}{t}^{2}.\n$$\n\nFor the second component,\n\n$$\n\\int (2{t}^{3}-t)\\,\\text{d}t=\\frac{1}{2}{t}^{4}-\\frac{1}{2}{t}^{2}.\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}⟨{t}^{2}+t,\\,2{t}^{3}-t⟩\\,\\text{d}t & =⟨(\\frac{1}{3}{t}^{3}+\\frac{1}{2}{t}^{2}){|}_{-1}^{3},\\,(\\frac{1}{2}{t}^{4}-\\frac{1}{2}{t}^{2}){|}_{-1}^{3}⟩ \\\\  & =⟨(\\frac{1}{3}(27)+\\frac{1}{2}(9))-(\\frac{1}{3}(-1)+\\frac{1}{2}(1)),\\,(\\frac{1}{2}(81)-\\frac{1}{2}(9))-(\\frac{1}{2}(1)-\\frac{1}{2}(1))⟩ \\\\  & =⟨(9+\\frac{9}{2})-(-\\frac{1}{3}+\\frac{1}{2}),\\,(36)-0⟩ \\\\  & =⟨\\frac{40}{3},\\,36⟩ \\\\  & =⟨\\frac{40}{3},\\,36⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349150/field-1" "q-349150/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-349150"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349114/field-1/6ae7a5204459d283456c06fee3983e9ad44be61264469c4c8e852ba4fce00ceb" :answer/id #uuid "a1d71b42-f070-5358-9f0e-c4adc08918e2" :answer/type :answer.type/math :answer/value "\\frac{287}{2}" :db/ensure [:answer/validate]} {:db/id "q-349114/field-1/7e7008dc75621d397d8ee88934aeacd7977e27d5abf3a4ae8a31319a1f58418e" :answer/id #uuid "f9e0903d-3a8e-505c-8983-eb7b07a91287" :answer/type :answer.type/math :answer/value "\\frac{289}{2}" :db/ensure [:answer/validate]} {:db/id "q-349114/field-1" :answer-field/id #uuid "ca78dcba-e03e-55f4-a6b6-697976aae431" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349114/field-1/6ae7a5204459d283456c06fee3983e9ad44be61264469c4c8e852ba4fce00ceb" :answer-field/choices ["q-349114/field-1/6ae7a5204459d283456c06fee3983e9ad44be61264469c4c8e852ba4fce00ceb" "q-349114/field-1/7e7008dc75621d397d8ee88934aeacd7977e27d5abf3a4ae8a31319a1f58418e"] :db/ensure [:answer-field/validate]} {:db/id "q-349114/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "17cb9437-8362-5fd4-b1f5-853fd91ff2f3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-349114/field-2" :answer-field/id #uuid "a8e0d458-8832-5643-adf1-bf6d548ff4bc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349114/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-349114/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-349114" :question/id #uuid "6fadc125-abed-52ab-bd71-19f0048b22b3" :question/math-academy-id "q-349114" :question/problem "Evaluate the following integral of a vector-valued function. Do not round the answer.\n\n${\\int }_{1}^{8}⟨5t-2,\\,\\frac{1}{3\\sqrt[3]{{t}^{2}}}⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{1}^{8}⟨5t-2,\\,\\frac{1}{3\\sqrt[3]{{t}^{2}}}⟩\\,\\text{d}t & =⟨{\\int }_{1}^{8}(5t-2)\\,\\text{d}t,\\,{\\int }_{1}^{8}\\frac{1}{3\\sqrt[3]{{t}^{2}}}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\nFor the first component, we integrate directly:\n\n$$\n\\int (5t-2)\\,\\text{d}t=\\frac{5}{2}{t}^{2}-2t.\n$$\n\nFor the second component, we write \n\n$$\n\\frac{1}{3\\sqrt[3]{{t}^{2}}}=\\frac{1}{3}{t}^{-2/3}\n$$\n\nand integrate:\n\n$$\n\\int \\frac{1}{3}{t}^{-2/3}\\,\\text{d}t=\\frac{1}{3}\\cdot \\frac{{t}^{1/3}}{1/3}={t}^{1/3}.\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{1}^{8}⟨5t-2,\\,\\frac{1}{3\\sqrt[3]{{t}^{2}}}⟩\\,\\text{d}t & =⟨(\\frac{5}{2}{t}^{2}-2t){|}_{1}^{8},\\,({t}^{1/3}){|}_{1}^{8}⟩ \\\\  & =⟨(\\frac{5}{2}\\cdot 64-16)-(\\frac{5}{2}\\cdot 1-2),\\,2-1⟩ \\\\  & =⟨144-\\frac{1}{2},\\,1⟩ \\\\  & =⟨\\frac{287}{2},\\,1⟩ \\\\  & =⟨\\frac{287}{2},\\,1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349114/field-1" "q-349114/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-349114"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349125/field-1/42eb32237f9c30cf6778bba4be501f6b52564117e1a7483208f74f4ac8044be4" :answer/id #uuid "55922e53-210b-5fa5-b670-3946124d8533" :answer/type :answer.type/math :answer/value "\\frac{104}{3}" :db/ensure [:answer/validate]} {:db/id "q-349125/field-1" :answer-field/id #uuid "cff1402b-99f4-5108-a3b3-9132dd70b503" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349125/field-1/42eb32237f9c30cf6778bba4be501f6b52564117e1a7483208f74f4ac8044be4" :answer-field/choices ["q-349125/field-1/42eb32237f9c30cf6778bba4be501f6b52564117e1a7483208f74f4ac8044be4"] :db/ensure [:answer-field/validate]} {:db/id "q-349125/field-2/bfc83495e4974d1ac2ff34ae319118f03ddbb8a7abb442ec2c39deaa5023cdb1" :answer/id #uuid "c8281c39-3c2d-5572-ad74-9617adfaee94" :answer/type :answer.type/math :answer/value "3-3e^{-4}" :db/ensure [:answer/validate]} {:db/id "q-349125/field-2" :answer-field/id #uuid "ec3a91d2-82b0-5be7-936f-57109841dbd7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349125/field-2/bfc83495e4974d1ac2ff34ae319118f03ddbb8a7abb442ec2c39deaa5023cdb1" :answer-field/choices ["q-349125/field-2/bfc83495e4974d1ac2ff34ae319118f03ddbb8a7abb442ec2c39deaa5023cdb1"] :db/ensure [:answer-field/validate]} {:db/id "q-349125" :question/id #uuid "b006e5b2-6245-5b87-9f41-f85be3078035" :question/math-academy-id "q-349125" :question/problem "Evaluate the following integral of a vector-valued function. Do not round the answer.\n\n${\\int }_{0}^{4}⟨2{t}^{2}-t,\\,3{e}^{-t}⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}⟨2{t}^{2}-t,\\,3{e}^{-t}⟩\\,\\text{d}t & =⟨{\\int }_{0}^{4}(2{t}^{2}-t)\\,\\text{d}t,\\,{\\int }_{0}^{4}3{e}^{-t}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\nFor the first component,\n\n$$\n\\int (2{t}^{2}-t)\\,\\text{d}t=\\frac{2}{3}{t}^{3}-\\frac{1}{2}{t}^{2}.\n$$\n\nFor the second component,\n\n$$\n\\int 3{e}^{-t}\\,\\text{d}t=3\\cdot (-{e}^{-t})=-3{e}^{-t}.\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}⟨2{t}^{2}-t,\\,3{e}^{-t}⟩\\,\\text{d}t & =⟨(\\frac{2}{3}{t}^{3}-\\frac{1}{2}{t}^{2}){|}_{0}^{4},\\,(-3{e}^{-t}){|}_{0}^{4}⟩ \\\\  & =⟨(\\frac{2}{3}(64)-\\frac{1}{2}(16))-0,\\,(-3{e}^{-4})-(-3)⟩ \\\\  & =⟨(\\frac{128}{3}-8),\\,3(1-{e}^{-4})⟩ \\\\  & =⟨\\frac{104}{3},\\,3(1-{e}^{-4})⟩ \\\\  & =⟨\\frac{104}{3},\\,3(1-{e}^{-4})⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349125/field-1" "q-349125/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-349125"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99366/selection/698bfff590d44f7c5ebbddfa8189937e50a28f73edd7a85ac9a6e533c43eaa80" :answer/id #uuid "c5e38e97-5f12-59b6-b616-ea30f2a42749" :answer/type :answer.type/math :answer/value "⟨-2\\sqrt{2},\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99366/selection/a77ae1feb02cd5a97a3ce1a7cce7b6d5111f3b47f98ee67694cf4ecd328502e7" :answer/id #uuid "c49f4764-bf9d-5b6f-90ae-2114b5bbd7a3" :answer/type :answer.type/math :answer/value "⟨2\\sqrt{2},\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99366/selection/9b7f74323c28190f76c67fb70e7f0fc48f9e5798242423767a34ead53dd0bf48" :answer/id #uuid "016bcfe3-94ae-5601-a3b8-1c85ae544a85" :answer/type :answer.type/math :answer/value "⟨\\sqrt{2},\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-99366/selection/390ff93f07b9ec0551b631df77549514cf34542c89f5ff7047c36b3545d5874a" :answer/id #uuid "9ae2db3b-49e6-5911-8adb-36468474b8a2" :answer/type :answer.type/math :answer/value "⟨1,\\,\\sqrt{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99366/selection/7d895d43ab6ef7050d730c0bf8bc55508e8c5fef16c12367968d17c119e32163" :answer/id #uuid "c18ed17f-2440-5540-93e3-19da6caaafb5" :answer/type :answer.type/math :answer/value "⟨1,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-99366/selection" :answer-field/id #uuid "7c4686a7-fd0f-5125-ac8e-3034077d153b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99366/selection/7d895d43ab6ef7050d730c0bf8bc55508e8c5fef16c12367968d17c119e32163" :answer-field/choices ["q-99366/selection/698bfff590d44f7c5ebbddfa8189937e50a28f73edd7a85ac9a6e533c43eaa80" "q-99366/selection/a77ae1feb02cd5a97a3ce1a7cce7b6d5111f3b47f98ee67694cf4ecd328502e7" "q-99366/selection/9b7f74323c28190f76c67fb70e7f0fc48f9e5798242423767a34ead53dd0bf48" "q-99366/selection/390ff93f07b9ec0551b631df77549514cf34542c89f5ff7047c36b3545d5874a" "q-99366/selection/7d895d43ab6ef7050d730c0bf8bc55508e8c5fef16c12367968d17c119e32163"] :db/ensure [:answer-field/validate]} {:db/id "q-99366" :question/id #uuid "ce4de9d0-a35b-5282-8a54-5ba3b82cc5ab" :question/math-academy-id "q-99366" :question/problem "${\\int }_{0}^{\\pi /4}⟨\\sqrt{2}\\operatorname{cos}⁡t,\\,{sec}^{2}⁡t⟩\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each componentt separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}⟨\\sqrt{2}\\operatorname{cos}⁡t,\\,{sec}^{2}⁡t⟩\\text{d}t & =⟨{\\int }_{0}^{\\pi /4}\\sqrt{2}\\operatorname{cos}⁡t\\,\\text{d}t,{\\int }_{0}^{\\pi /4}{sec}^{2}⁡t\\,\\text{d}t⟩ \\\\  & =⟨\\sqrt{2}\\operatorname{sin}⁡t\\,\\,{|}_{0}^{\\pi /4},\\,\\operatorname{tan}⁡t\\,\\,{|}_{0}^{\\pi /4}⟩ \\\\  & =⟨\\text{ }\\sqrt{2}\\operatorname{sin}⁡(\\pi /4)-\\sqrt{2}\\operatorname{sin}⁡(0),\\,\\operatorname{tan}⁡(\\pi /4)-\\operatorname{tan}⁡(0)⟩ \\\\  & =⟨\\text{ }\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2}-0,\\,1-0⟩ \\\\  & =⟨1,\\,1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99366/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-99366"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123520/selection/057795de1fa0fc7eecc109a7eb44c8cf989be3d428fa66d7f80986fc0158ab61" :answer/id #uuid "9fa38c1e-5cd2-54aa-83fb-380dd20e2e7f" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{5},\\,\\sqrt{15}⟩" :db/ensure [:answer/validate]} {:db/id "q-123520/selection/4f8a63f1e5807aa83f980c0fd08714e8f1bd603568b5d03546c59448cb0bd7e7" :answer/id #uuid "fd6abd3d-ae0f-56fb-b6bc-8824f28d4f16" :answer/type :answer.type/math :answer/value "⟨\\frac{5}{6},\\,10\\sqrt{5}⟩" :db/ensure [:answer/validate]} {:db/id "q-123520/selection/707dcd1492ac3a3bd05585006afee5b988715f115d6a62364962cba346527efe" :answer/id #uuid "3feae394-1d20-5411-8788-c0fe27686679" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{5},\\,15\\sqrt{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-123520/selection/1e4571c5f595d669d9dd35d39bf105ec262cdb13c9053bfb7405e12347d69e49" :answer/id #uuid "4092c4d0-cf7c-51b0-9993-253845a00980" :answer/type :answer.type/math :answer/value "⟨\\frac{6}{5},\\,10\\sqrt{15}⟩" :db/ensure [:answer/validate]} {:db/id "q-123520/selection/4f422fb6ef52d4e3144f9853b592c846042fd1198fff94ad0b6a0aa836447b84" :answer/id #uuid "0c346cb5-c9e6-5084-8db3-f653e51baba2" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{6},\\,15\\sqrt{10}⟩" :db/ensure [:answer/validate]} {:db/id "q-123520/selection" :answer-field/id #uuid "87c04e2b-de81-5c25-81f3-acf002a3439c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123520/selection/1e4571c5f595d669d9dd35d39bf105ec262cdb13c9053bfb7405e12347d69e49" :answer-field/choices ["q-123520/selection/057795de1fa0fc7eecc109a7eb44c8cf989be3d428fa66d7f80986fc0158ab61" "q-123520/selection/4f8a63f1e5807aa83f980c0fd08714e8f1bd603568b5d03546c59448cb0bd7e7" "q-123520/selection/707dcd1492ac3a3bd05585006afee5b988715f115d6a62364962cba346527efe" "q-123520/selection/1e4571c5f595d669d9dd35d39bf105ec262cdb13c9053bfb7405e12347d69e49" "q-123520/selection/4f422fb6ef52d4e3144f9853b592c846042fd1198fff94ad0b6a0aa836447b84"] :db/ensure [:answer-field/validate]} {:db/id "q-123520" :question/id #uuid "8ddb6848-feaf-575a-b3b1-c2eb9f0a30e2" :question/math-academy-id "q-123520" :question/problem "${\\int }_{1}^{16}⟨\\frac{1}{5\\sqrt{t}},\\,\\sqrt{t-1}⟩\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}⟨\\frac{1}{5\\sqrt{t}},\\,\\sqrt{t-1}⟩\\text{d}t & =⟨{\\int }_{1}^{16}\\frac{1}{5\\sqrt{t}}\\,\\text{d}t,{\\int }_{1}^{16}\\sqrt{t-1}\\,\\text{d}t⟩ \\\\  & =⟨\\frac{2}{5}\\sqrt{t}\\,\\,{|}_{1}^{16},\\,\\frac{2\\sqrt{(t-1)^{3}}}{3}\\,\\,{|}_{1}^{16}⟩ \\\\  & =⟨\\frac{2}{5}\\cdot \\sqrt{16}-\\frac{2}{5}\\cdot \\sqrt{1},\\,\\frac{2\\sqrt{(16-1)^{3}}}{3}-\\frac{2\\sqrt{(1-1)^{3}}}{3}⟩ \\\\  & =⟨\\frac{6}{5},\\,10\\sqrt{15}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123520/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-123520"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99517/selection/4743b91593a16d2e4e40fadbcd7d82b8506d1f4f9c9f49c61b69fc060b1cfebe" :answer/id #uuid "c1352cdf-a45a-5473-8cb5-e42a88c50278" :answer/type :answer.type/math :answer/value "⟨{(t-1)}^{3}+1,\\,{t}^{4}-t+1⟩" :db/ensure [:answer/validate]} {:db/id "q-99517/selection/447c1d38f47694709debbe5d8ca08c25c7f8e8b535d70a150927095e5cf9b678" :answer/id #uuid "a3a99672-6130-5757-97a9-b83c8b12152d" :answer/type :answer.type/math :answer/value "⟨{t}^{3}+1,\\,{t}^{4}-t+1⟩" :db/ensure [:answer/validate]} {:db/id "q-99517/selection/f2957b46af2b45d2d779f765d036a4b607bde558775b5f461f8bfefbc5b47c21" :answer/id #uuid "c94e23ed-1753-5650-a1c1-b6caad8e1766" :answer/type :answer.type/math :answer/value "⟨{t}^{3}+2,\\,{t}^{4}{-}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99517/selection/823249e2b4894d55c10d41f5df75d24cb745a8516a2d64b96c9956acf244ea99" :answer/id #uuid "647b7987-adbd-5e6d-92f8-a6c276eebf61" :answer/type :answer.type/math :answer/value "⟨{(t-1)}^{3}+1,\\,\\frac{{t}^{5}}{5}-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99517/selection/71ff83e12665f099532f9a579aa6513cddb5fc67b54238735d2235438de649f4" :answer/id #uuid "754a9675-1fba-57e7-b5df-c41e907a83ae" :answer/type :answer.type/math :answer/value "⟨{(t-1)}^{4}+1,\\,\\frac{{t}^{4}}{4}-4⟩" :db/ensure [:answer/validate]} {:db/id "q-99517/selection" :answer-field/id #uuid "c88d0d3d-3348-569a-ae2e-19e781544506" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99517/selection/4743b91593a16d2e4e40fadbcd7d82b8506d1f4f9c9f49c61b69fc060b1cfebe" :answer-field/choices ["q-99517/selection/4743b91593a16d2e4e40fadbcd7d82b8506d1f4f9c9f49c61b69fc060b1cfebe" "q-99517/selection/447c1d38f47694709debbe5d8ca08c25c7f8e8b535d70a150927095e5cf9b678" "q-99517/selection/f2957b46af2b45d2d779f765d036a4b607bde558775b5f461f8bfefbc5b47c21" "q-99517/selection/823249e2b4894d55c10d41f5df75d24cb745a8516a2d64b96c9956acf244ea99" "q-99517/selection/71ff83e12665f099532f9a579aa6513cddb5fc67b54238735d2235438de649f4"] :db/ensure [:answer-field/validate]} {:db/id "q-99517" :question/id #uuid "ac793faa-32dd-5854-af7f-a8fbffd850cd" :question/math-academy-id "q-99517" :question/problem "If ${F}^{′}(t)=⟨3(t-1)^{2},4\\,{t}^{3}-1⟩$ and $F(1)=⟨1,\\,1⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3(t-1)^{2},\\,4{t}^{3}-1⟩\\text{d}t\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨3(t-1)^{2},\\,4{t}^{3}-1⟩\\text{d}t & =⟨\\int 3(t-1)^{2}\\,\\text{d}t,\\int (4{t}^{3}-1)\\text{d}t⟩ \\\\  & =⟨{(t-1)}^{3}+{c}_{1},\\,{t}^{4}-t+{c}_{2}⟩.\\end{aligned}\n$$\n\n  \n\nThe initial condition $F(1)=⟨1,\\,1⟩$ gives \n\n$$\n\\begin{aligned}F(1)=⟨{((1)-1)}^{3}+{c}_{1},\\,(1)^{4}-(1)+{c}_{2}⟩ & =⟨1,\\,1⟩ \\\\ ⟨{c}_{1},\\,{c}_{2}⟩ & =⟨1,\\,1⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=1$ and ${c}_{2}=1.$ Consequently\n\n$$\nF(t)=⟨{(t-1)}^{3}+1,\\,{t}^{4}-t+1⟩.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1"] :knowledge-point/questions ["q-99517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99586/selection/1c4244fa95c8e55cb6d4f9c6899bae669d2d2e14585b831d06aac3556e7299f8" :answer/id #uuid "490597ec-c45d-5242-a457-4499ead33105" :answer/type :answer.type/math :answer/value "⟨\\frac{4{t}^{3/2}+3{t}^{2}+5}{6},\\,{2}^{t}+\\operatorname{ln}⁡2⟩" :db/ensure [:answer/validate]} {:db/id "q-99586/selection/5172eb2d4486b93e3c5772e1713e29b497a0a6abbbc089a98c4d40cdfae22938" :answer/id #uuid "6a5d585f-817f-54a3-b2ab-036662f81ead" :answer/type :answer.type/math :answer/value "⟨\\frac{3{t}^{2}+5}{6},\\,\\frac{{2}^{t}-2}{\\operatorname{ln}⁡2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99586/selection/b09bf36f369f47cbe2a82c4d120eb21bf543e77f875fe48de98a0c7cd2e857c3" :answer/id #uuid "796e8910-a230-5f5f-9ad7-35ae4bc416a9" :answer/type :answer.type/math :answer/value "⟨\\frac{4{t}^{3/2}}{6},\\,\\frac{{2}^{t}}{\\operatorname{ln}⁡2}+\\operatorname{ln}⁡2⟩" :db/ensure [:answer/validate]} {:db/id "q-99586/selection/c27e996989921a47e633a2ce49f18a8cb5383d419e923f86f53570cd41b9737a" :answer/id #uuid "c55bec89-84a7-5ab8-9496-3aba2affd051" :answer/type :answer.type/math :answer/value "⟨\\frac{4{t}^{3/2}+5}{6},\\,\\frac{{2}^{t}}{\\operatorname{ln}⁡2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99586/selection/346de3f9eb06bf361f1901f6c69018bbb75ca679274a72a2de1521958ea4092b" :answer/id #uuid "a5982c98-dd59-5886-aa98-5bc604eb172f" :answer/type :answer.type/math :answer/value "⟨\\frac{4{t}^{3/2}+3{t}^{2}+5}{6},\\,\\frac{{2}^{t}-2}{\\operatorname{ln}⁡2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99586/selection" :answer-field/id #uuid "3b0c5dac-ad1d-52e4-98e4-b4f34092336a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99586/selection/346de3f9eb06bf361f1901f6c69018bbb75ca679274a72a2de1521958ea4092b" :answer-field/choices ["q-99586/selection/1c4244fa95c8e55cb6d4f9c6899bae669d2d2e14585b831d06aac3556e7299f8" "q-99586/selection/5172eb2d4486b93e3c5772e1713e29b497a0a6abbbc089a98c4d40cdfae22938" "q-99586/selection/b09bf36f369f47cbe2a82c4d120eb21bf543e77f875fe48de98a0c7cd2e857c3" "q-99586/selection/c27e996989921a47e633a2ce49f18a8cb5383d419e923f86f53570cd41b9737a" "q-99586/selection/346de3f9eb06bf361f1901f6c69018bbb75ca679274a72a2de1521958ea4092b"] :db/ensure [:answer-field/validate]} {:db/id "q-99586" :question/id #uuid "679c8eba-9d63-5e58-9520-a2c190d788d6" :question/math-academy-id "q-99586" :question/problem "If ${F}^{′}(t)=⟨\\sqrt{t}+t,\\,{2}^{t}⟩$ and $F(1)=⟨2,\\,0⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨\\sqrt{t}+t,\\,{2}^{t}⟩\\text{d}t\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨\\sqrt{t}+t,\\,{2}^{t}⟩\\text{d}t & =⟨\\int (\\sqrt{t}+t)\\,\\text{d}t,\\int {2}^{t}\\,\\text{d}t⟩ \\\\  & =⟨\\frac{2{t}^{3/2}}{3}+\\frac{{t}^{2}}{2}+{c}_{1},\\,\\frac{{2}^{t}}{\\operatorname{ln}⁡2}+{c}_{2}⟩.\\end{aligned}\n$$\n\n   \n\nThe initial condition $F(1)=⟨2,\\,0⟩$ gives \n\n$$\n\\begin{aligned}F(1)=⟨\\frac{2(1)^{3/2}}{3}+\\frac{{1}^{2}}{2}+{c}_{1},\\,\\frac{{2}^{1}}{\\operatorname{ln}⁡2}+{c}_{2}⟩ & =⟨2,\\,0⟩ \\\\ ⟨\\frac{7}{6}+{c}_{1},\\,\\frac{2}{\\operatorname{ln}⁡2}+{c}_{2}⟩ & =⟨2,\\,0⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=\\frac{5}{6}$ and ${c}_{2}=-\\frac{2}{\\operatorname{ln}⁡2}.$ Consequently\n\n$$\n\\begin{aligned}F(t) & =⟨\\frac{2{t}^{3/2}}{3}+\\frac{{t}^{2}}{2}+\\frac{5}{6},\\,\\frac{{2}^{t}}{\\operatorname{ln}⁡2}-\\frac{2}{\\operatorname{ln}⁡2}⟩ \\\\  & =⟨\\frac{4{t}^{3/2}+3{t}^{2}+5}{6},\\,\\frac{{2}^{t}-2}{\\operatorname{ln}⁡2}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99586/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1"] :knowledge-point/questions ["q-99586"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349355/field-1/8380a92af413f379c8761af7561beb417a997e40e5f4e5c3c1685fbd2cbb3e57" :answer/id #uuid "f08e59e7-415b-5c8f-848d-703d8961f906" :answer/type :answer.type/math :answer/value "4\\ln(t+1)+2" :db/ensure [:answer/validate]} {:db/id "q-349355/field-1/42e16288ad4135f713b401ab559dfae619af2aeca50adc9c2e0fba8fccd76258" :answer/id #uuid "47116129-dd17-52d4-a5cd-17af6222ec30" :answer/type :answer.type/math :answer/value "4\\ln(t+1)+3" :db/ensure [:answer/validate]} {:db/id "q-349355/field-1" :answer-field/id #uuid "72198386-eade-5d65-9626-89b803a74bc8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349355/field-1/8380a92af413f379c8761af7561beb417a997e40e5f4e5c3c1685fbd2cbb3e57" :answer-field/choices ["q-349355/field-1/8380a92af413f379c8761af7561beb417a997e40e5f4e5c3c1685fbd2cbb3e57" "q-349355/field-1/42e16288ad4135f713b401ab559dfae619af2aeca50adc9c2e0fba8fccd76258"] :db/ensure [:answer-field/validate]} {:db/id "q-349355/field-2/4fd4ee240129969ae6d20bf041c394e7b8ad98b609f38bfc8c8a71c63d34e5b2" :answer/id #uuid "538658d4-48db-5016-9c74-59d88403fe3b" :answer/type :answer.type/math :answer/value "2t\\sqrt{t}-1" :db/ensure [:answer/validate]} {:db/id "q-349355/field-2" :answer-field/id #uuid "6796ce46-7bea-5098-b314-78af4b163782" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349355/field-2/4fd4ee240129969ae6d20bf041c394e7b8ad98b609f38bfc8c8a71c63d34e5b2" :answer-field/choices ["q-349355/field-2/4fd4ee240129969ae6d20bf041c394e7b8ad98b609f38bfc8c8a71c63d34e5b2"] :db/ensure [:answer-field/validate]} {:db/id "q-349355" :question/id #uuid "c0bced7b-54b7-5ffb-932d-ddddf77d652e" :question/math-academy-id "q-349355" :question/problem "Find $F(t)$ given that \n\n$$\n{F}^{′}(t)=⟨\\frac{4}{t+1}\\,,3\\sqrt{t}⟩\n$$\n\n and $F(0)=⟨2,\\,-1⟩.$\n\n$F(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨\\frac{4}{t+1}\\,,3\\sqrt{t}⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨\\frac{4}{t+1}\\,,3\\sqrt{t}⟩\\text{d}t & =⟨\\int \\frac{4}{t+1}\\,\\text{d}t,\\int 3\\sqrt{t}\\,\\text{d}t⟩ \\\\  & =⟨4\\operatorname{ln}⁡(t+1)+{c}_{1},\\,2{t}^{\\frac{3}{2}}+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $F(0)=⟨2,\\,-1⟩$ gives\n\n$$\n\\begin{aligned}F(0)=⟨4\\operatorname{ln}⁡(1)+{c}_{1},\\,2(0)^{\\frac{3}{2}}+{c}_{2}⟩ & =⟨2,\\,-1⟩ \\\\ ⟨{c}_{1},\\,{c}_{2}⟩ & =⟨2,\\,-1⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=2$ and ${c}_{2}=-1.$ Consequently\n\n$$\nF(t)=⟨4\\operatorname{ln}⁡(t+1)+2,\\,2{t}^{3/2}-1⟩.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349355/field-1" "q-349355/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1"] :knowledge-point/questions ["q-349355"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349193/field-1/5d00c86bb468aa1d21412cb331cb5f056f412239ae2aba2b31a4cef8a2edd711" :answer/id #uuid "8500ecfa-7f69-5692-8378-8a2da6c8d14a" :answer/type :answer.type/math :answer/value "\\frac{8}{\\sqrt{t}}-6" :db/ensure [:answer/validate]} {:db/id "q-349193/field-1" :answer-field/id #uuid "d017f787-38e7-5ada-9e05-3e69d1b615f8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349193/field-1/5d00c86bb468aa1d21412cb331cb5f056f412239ae2aba2b31a4cef8a2edd711" :answer-field/choices ["q-349193/field-1/5d00c86bb468aa1d21412cb331cb5f056f412239ae2aba2b31a4cef8a2edd711"] :db/ensure [:answer-field/validate]} {:db/id "q-349193/field-2/32b807d7b017989fb70163260e605ead6c751296d86484b8d2be446bbec5f863" :answer/id #uuid "a4279aaa-49fe-5b0c-891a-825cbf2ec989" :answer/type :answer.type/math :answer/value "4\\ln(t+1)" :db/ensure [:answer/validate]} {:db/id "q-349193/field-2" :answer-field/id #uuid "492cfa94-52ea-559a-bd8d-87c09d8c7730" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349193/field-2/32b807d7b017989fb70163260e605ead6c751296d86484b8d2be446bbec5f863" :answer-field/choices ["q-349193/field-2/32b807d7b017989fb70163260e605ead6c751296d86484b8d2be446bbec5f863"] :db/ensure [:answer-field/validate]} {:db/id "q-349193" :question/id #uuid "66b119c5-e8c6-574b-9b80-220999d2b97b" :question/math-academy-id "q-349193" :question/problem "Find $F(t)$ given that \n\n$$\n{F}^{′}(t)=⟨-\\frac{4}{{t}^{3/2}}\\,,\\frac{4}{t+1}⟩\n$$\n\n and $F(1)=⟨2,\\,4\\operatorname{ln}⁡(2)⟩.$\n\n$F(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨-\\frac{4}{{t}^{3/2}}\\,,\\frac{4}{t+1}⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨-\\frac{4}{{t}^{3/2}}\\,,\\frac{4}{t+1}⟩\\text{d}t & =⟨\\int -\\frac{4}{{t}^{3/2}}\\,\\text{d}t,\\int \\frac{4}{t+1}\\,\\text{d}t⟩ \\\\  & =⟨\\frac{8}{\\sqrt{t}}+{c}_{1},\\,4\\operatorname{ln}⁡(t+1)+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $F(1)=⟨2,\\,4\\operatorname{ln}⁡(2)⟩$ gives\n\n$$\n\\begin{aligned}F(1)=⟨\\frac{8}{\\sqrt{1}}+{c}_{1},\\,4\\operatorname{ln}⁡(2)+{c}_{2}⟩ & =⟨2,\\,4\\operatorname{ln}⁡(2)⟩ \\\\ ⟨8+{c}_{1},\\,4\\operatorname{ln}⁡(2)+{c}_{2}⟩ & =⟨2,\\,4\\operatorname{ln}⁡(2)⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=-6$ and ${c}_{2}=0.$ Consequently\n\n$$\nF(t)=⟨\\frac{8}{\\sqrt{t}}-6,\\,4\\operatorname{ln}⁡(t+1)⟩.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349193/field-1" "q-349193/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1"] :knowledge-point/questions ["q-349193"] :db/ensure [:knowledge-point/validate]} {:db/id "q-347095/field-1/0f7d639f1c30e0a079888712bd47ecb673272fccb620e5e0faff54b743c0ec18" :answer/id #uuid "a9ff2c46-bf01-5472-99ce-9fae200440d8" :answer/type :answer.type/math :answer/value "\\csc(t)+3" :db/ensure [:answer/validate]} {:db/id "q-347095/field-1" :answer-field/id #uuid "13ee2487-b82e-53be-a770-7e5b07ee0404" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347095/field-1/0f7d639f1c30e0a079888712bd47ecb673272fccb620e5e0faff54b743c0ec18" :answer-field/choices ["q-347095/field-1/0f7d639f1c30e0a079888712bd47ecb673272fccb620e5e0faff54b743c0ec18"] :db/ensure [:answer-field/validate]} {:db/id "q-347095/field-2/f565c036a528839ddab043f98d62226d95a1b694550f73f3366448675634ea17" :answer/id #uuid "65c95fca-3e13-51dc-a7d6-1b53a4b08f5d" :answer/type :answer.type/math :answer/value "\\sin(3t)-1" :db/ensure [:answer/validate]} {:db/id "q-347095/field-2" :answer-field/id #uuid "b15423ac-0a9a-5d06-8fd9-e7a90583e7e6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347095/field-2/f565c036a528839ddab043f98d62226d95a1b694550f73f3366448675634ea17" :answer-field/choices ["q-347095/field-2/f565c036a528839ddab043f98d62226d95a1b694550f73f3366448675634ea17"] :db/ensure [:answer-field/validate]} {:db/id "q-347095" :question/id #uuid "5dcc9dd5-b778-5f6e-991f-d3af5cb19af7" :question/math-academy-id "q-347095" :question/problem "Find $F(t)$ given that \n\n$$\n{F}^{′}(t)=⟨-\\operatorname{csc}⁡(t)\\operatorname{cot}⁡(t)\\,,3\\operatorname{cos}⁡(3t)⟩\n$$\n\n and $F(\\frac{\\pi }{2})=⟨4,\\,-2⟩.$\n\n$F(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨-\\operatorname{csc}⁡(t)\\operatorname{cot}⁡(t)\\,,3\\operatorname{cos}⁡(3t)⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨-\\operatorname{csc}⁡(t)\\operatorname{cot}⁡(t)\\,,3\\operatorname{cos}⁡(3t)⟩\\text{d}t & =⟨\\int -\\operatorname{csc}⁡(t)\\operatorname{cot}⁡(t)\\,\\text{d}t,\\int 3\\operatorname{cos}⁡(3t)\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{csc}⁡(t)+{c}_{1},\\,\\operatorname{sin}⁡(3t)+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $F(\\frac{\\pi }{2})=⟨4,\\,-2⟩$ gives\n\n$$\n\\begin{aligned}F(\\frac{\\pi }{2})=⟨\\operatorname{csc}⁡(\\frac{\\pi }{2})+{c}_{1},\\,\\operatorname{sin}⁡(\\frac{3\\pi }{2})+{c}_{2}⟩ & =⟨4,\\,-2⟩ \\\\ ⟨1+{c}_{1},\\,-1+{c}_{2}⟩ & =⟨4,\\,-2⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=3$ and ${c}_{2}=-1.$ Consequently\n\n$$\nF(t)=⟨\\operatorname{csc}⁡(t)+3,\\,\\operatorname{sin}⁡(3t)-1⟩.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-347095/field-1" "q-347095/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1"] :knowledge-point/questions ["q-347095"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-612"] :question/problem "Find $\\mathbf F(t)$ given that $\\mathbf F'(t)= \\langle 6t^5+2t, \\sec^2 t\\rangle.$" :question/worked-solution "Note that \n\n$$\n\\mathbf F(t)=\\int \\mathbf F'(t)\\, \\textrm d t=\\int \\left\\langle 6t^5+2t,\\, \\sec^2 t\\right\\rangle \\, \\textrm d t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨6{t}^{5}+2t,\\,{sec}^{2}⁡t⟩\\,\\text{d}t & =⟨\\int (6{t}^{5}+2t)\\,\\text{d}t,\\,\\int {sec}^{2}⁡t\\,\\text{d}t⟩ \\\\  & =⟨{t}^{6}+{t}^{2}+{c}_{1},\\,\\operatorname{tan}⁡t+{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+C,\\end{aligned}\n$$\n\nwhere $\\mathbf C$ is an arbitrary (vector) constant of integration." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-613"] :question/problem "Calculate $\\displaystyle \\int \\left\\langle\\cos(2t+1), \\, 4\\right\\rangle \\,\\textrm d t\\,.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡(2t+1),\\,4⟩\\,\\text{d}t=⟨\\int \\operatorname{cos}⁡(2t+1)\\,\\text{d}t,\\,\\int 4\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t) =\\cos(2t+1),$ we calculate its integral using substitution. So, we let $u= 2t +1.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d t} = 2\\quad\\Longrightarrow\\quad \\textrm d t = \\dfrac 1 2 \\textrm d u.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t & =\\int \\operatorname{cos}⁡(2t+1)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡u)+{c}_{1} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(2t+1)+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t) =4,$ we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t=\\int 4\\text{d}t=4t+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡(2t+1),\\,4⟩\\,\\text{d}t & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1)+{c}_{1},\\,4t+{c}_{2}⟩ \\\\  & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1),\\,4t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1),\\,4t⟩+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-614"] :question/problem "Evaluate $\\displaystyle \\int_0^{2} \\left\\langle 2e^{t},\\, 6t^2\\right\\rangle\\, \\textrm d t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}⟨2{e}^{t},\\,6{t}^{2}⟩\\,\\text{d}t & =⟨{\\int }_{0}^{2}2{e}^{t}\\,\\text{d}t,\\,{\\int }_{0}^{2}6{t}^{2}\\,\\text{d}t⟩. \\\\  & =⟨2{e}^{t}\\,\\,{|}_{0}^{2},\\,2{t}^{3}\\,\\,{|}_{0}^{2}⟩ \\\\  & =⟨[2{e}^{2}-2{e}^{0}],\\,[2\\cdot {2}^{3}-0]⟩ \\\\  & =⟨2{e}^{2}-2,\\,16⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-615"] :question/problem "Calculate $\\mathbf F(t)$ given that $\\mathbf F'(t)= \\left\\langle \\sec t \\tan t, \\,  \\sin(2t)\\right\\rangle$ and $\\mathbf F(0)=\\langle 0,\\, 0\\rangle.$" :question/worked-solution "Note that \n\n$$\n\\mathbf F(t)=\\int \\mathbf F'(t)\\, \\textrm d t=\\int \\left\\langle \\sec t \\tan t,\\,  \\sin(2t)\\right\\rangle \\, \\textrm d t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sin}⁡(2t)⟩\\,\\text{d}t & =⟨\\int \\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t,\\int \\operatorname{sin}⁡(2t)\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{sec}⁡t+{c}_{1},\\,-\\frac{1}{2}\\operatorname{cos}⁡(2t)+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $\\mathbf F(0)=\\left\\langle 0,\\, 0 \\right\\rangle$ gives\n\n$$\n\\begin{aligned}F(0)=⟨\\operatorname{sec}⁡0+{c}_{1},\\,-\\frac{1}{2}\\operatorname{cos}⁡(2\\cdot 0)+{c}_{2}⟩ & =⟨0,\\,0⟩ \\\\ ⟨1+{c}_{1},\\,-\\frac{1}{2}+{c}_{2}⟩ & =⟨0,\\,0⟩.\\end{aligned}\n$$\n\nTherefore, $c_1=-1$ and $c_2=\\dfrac 12.$ Consequently, \n\n$$\n\\mathbf F(t)=\\left\\langle  \\sec t - 1  , \\,  -\\dfrac 1 2\\cos(2t)+ \\dfrac12\\right\\rangle.\n$$" :db/ensure [:question/validate]}]
