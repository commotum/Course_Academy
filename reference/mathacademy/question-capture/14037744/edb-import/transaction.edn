\\operatorname{cot}⁡t+{c}_{1},\\,{e}^{3t}+{c}_{2}⟩ \\\\  & =⟨-4\\operatorname{cot}⁡t,\\,{e}^{3t}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-4\\operatorname{cot}⁡t,\\,{e}^{3t}⟩+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123424/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8"] :knowledge-point/questions ["q-123424"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99350/selection/39725d6a53c4c267e86c5c3257e861bda9668dabdc01d5d0e494cb3c0436e2cb" :answer/id #uuid "12813cd4-e446-54c7-97d8-b20f24924629" :answer/type :answer.type/math :answer/value "⟨t{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-99350/selection/3ba217fbce93a0b73b278ff0cad5866470f34b7be4c8d6ba4c5bc6409bcf9d67" :answer/id #uuid "81d2fa57-7251-5e5c-bb91-670a36a38485" :answer/type :answer.type/math :answer/value "⟨e,\\,2+\\operatorname{cos}⁡2t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-99350/selection/f5c7f3bbd8c401183a03c2a606c72de20e044cd0c90bb859aafabcc8d6898fa3" :answer/id #uuid "6c50d982-47ba-526a-a751-64e67930e65d" :answer/type :answer.type/math :answer/value "⟨{e}^{t},\\,-2\\operatorname{sin}⁡2t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-99350/selection/b963cd97f3e0896e7b067a0826e39c120e55ffb9599e673278b015734d3f6678" :answer/id #uuid "aa213fb5-f039-5bf4-93e1-feaf75499e2a" :answer/type :answer.type/math :answer/value "⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-99350/selection/963d43e7ce58231dce33e00d583d725c48384575a02347a4b583ceaeb3a7f80e" :answer/id #uuid "a2fc81b2-1aa7-57e3-acb5-d8e9b0bf6ea3" :answer/type :answer.type/math :answer/value "⟨{e}^{t},\\,2-\\operatorname{cos}⁡2t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-99350/selection" :answer-field/id #uuid "a165d197-792d-51ca-a35c-beefe49cf864" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99350/selection/b963cd97f3e0896e7b067a0826e39c120e55ffb9599e673278b015734d3f6678" :answer-field/choices ["q-99350/selection/39725d6a53c4c267e86c5c3257e861bda9668dabdc01d5d0e494cb3c0436e2cb" "q-99350/selection/3ba217fbce93a0b73b278ff0cad5866470f34b7be4c8d6ba4c5bc6409bcf9d67" "q-99350/selection/f5c7f3bbd8c401183a03c2a606c72de20e044cd0c90bb859aafabcc8d6898fa3" "q-99350/selection/b963cd97f3e0896e7b067a0826e39c120e55ffb9599e673278b015734d3f6678" "q-99350/selection/963d43e7ce58231dce33e00d583d725c48384575a02347a4b583ceaeb3a7f80e"] :db/ensure [:answer-field/validate]} {:db/id "q-99350" :question/id #uuid "7f24cce4-3316-593f-909a-7953ae6cdae1" :question/math-academy-id "q-99350" :question/problem "Find $\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\,\\text{d}t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\text{d}t=⟨\\int {e}^{t}\\,\\text{d}t,\\,\\int 4\\operatorname{sin}⁡2t\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)={e}^{t},$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int {e}^{t}\\text{d}t={e}^{t}+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=4\\operatorname{sin}⁡2t,$ we calculate its integral using substitution. So, we let $u=2t.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2\\,⟹\\,\\text{d}t=\\frac{1}{2}\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 4\\operatorname{sin}⁡2t\\,\\text{d}t \\\\  & =\\int 4\\operatorname{sin}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{4}{2}\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =2(-\\operatorname{cos}⁡u)+{c}_{2} \\\\  & =-2\\operatorname{cos}⁡2t+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,4\\operatorname{sin}⁡2t⟩\\text{d}t & =⟨{e}^{t}+{c}_{1},\\,-2\\operatorname{cos}⁡2t+{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,-2\\operatorname{cos}⁡2t⟩+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99350/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8"] :knowledge-point/questions ["q-99350"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-50204"] :question/problem "Find $\\int ⟨{e}^{t},\\,\\operatorname{cos}⁡t⟩\\,\\text{d}t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,\\operatorname{cos}⁡t⟩\\,\\text{d}t & =⟨\\int {e}^{t}\\,\\text{d}t,\\,\\int \\operatorname{cos}⁡t\\,\\text{d}t⟩ \\\\  & =⟨{e}^{t}+{c}_{1},\\,\\operatorname{sin}⁡t+{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,\\operatorname{sin}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,\\operatorname{sin}⁡t⟩+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-50078/selection/a309cd2b199c88866848a805caa4fe34028e0730dc6227e6231bff49f69e009c" :answer/id #uuid "02acfd0b-8b6f-5645-b4ec-17b11e1ade16" :answer/type :answer.type/math :answer/value "⟨{e}^{t},\\,-\\operatorname{tan}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-50078/selection/b1729c78bdd2a33d4167d7b2352ac9ea4b93bf97edc972fdf8b97deab5b07118" :answer/id #uuid "672da137-8e68-5ffb-8f60-f86e38a3d560" :answer/type :answer.type/math :answer/value "⟨{e}^{-t},\\,\\operatorname{csc}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-50078/selection/3a604f51e497c28ae124923b3ead1dc21c7bd15098ce320300e21b4167875c1f" :answer/id #uuid "348dfb6b-156c-5f49-8ff1-a8ffea3ef788" :answer/type :answer.type/math :answer/value "⟨-{e}^{-t},\\,\\operatorname{tan}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-50078/selection/feebf72aca58d61db908124aa675cc5c355222aebc3a5dc4df6c761aeb16deee" :answer/id #uuid "98252e08-446c-524b-b96d-bfc403302007" :answer/type :answer.type/math :answer/value "⟨{e}^{t},\\,\\operatorname{sec}⁡t⟩+C" :db/ensure [:answer/validate