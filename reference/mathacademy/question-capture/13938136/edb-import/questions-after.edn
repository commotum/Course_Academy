#{[{:db/id #edb/ref 17592186248163 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8efbeae1-3516-5eb3-b963-75537441d57f" :answer/type {:db/ident :answer.type/math} :answer/value "({g}^{2}+36{h}^{2})(g+6h)(g-6h)" :db/id #edb/ref 17592186248165} {:answer/id #uuid "7218c5d1-3ab4-5c51-afd1-0093e5cde9c4" :answer/type {:db/ident :answer.type/math} :answer/value "(g+36h)(g+6h)(g-6h)" :db/id #edb/ref 17592186248166} {:answer/id #uuid "56ea3847-abda-549a-80c9-5979409836b9" :answer/type {:db/ident :answer.type/math} :answer/value "({g}^{2}+6{h}^{2})(g+3h)(g-3h)" :db/id #edb/ref 17592186248167} {:answer/id #uuid "51bad81e-477f-5f02-9dd2-db1434c0bd5f" :answer/type {:db/ident :answer.type/math} :answer/value "(g-6h)^{4}" :db/id #edb/ref 17592186248168} {:answer/id #uuid "88a60872-fafd-50e3-a265-6a36b233d89a" :answer/type {:db/ident :answer.type/math} :answer/value "({g}^{2}+36{h}^{2})(g-6h)^{2}" :db/id #edb/ref 17592186248169}] :answer-field/correct {:answer/id #uuid "8efbeae1-3516-5eb3-b963-75537441d57f" :answer/type {:db/ident :answer.type/math} :answer/value "({g}^{2}+36{h}^{2})(g+6h)(g-6h)" :db/id #edb/ref 17592186248165} :answer-field/id #uuid "9d97dd84-6ec5-5e6d-b590-bb936884603d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248164}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "94568326-4add-523a-9970-740075840c8b" :question/is-example false :question/math-academy-id "q-112047" :question/problem "Factor the expression ${g}^{4}-1\\,296{h}^{4}.$\n\n*Hint: You may wish to make use of the fact that $1\\,296={36}^{2}.$*" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{g}^{4}-1\\,296{h}^{4}={({g}^{2})}^{2}-{(36{h}^{2})}^{2}\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n{({g}^{2})}^{2}-{(36{h}^{2})}^{2}=({g}^{2}+36{h}^{2})({g}^{2}-36{h}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares:\n\n$$\n{g}^{2}-36{h}^{2}={g}^{2}-(6h)^{2}\n$$\n\n Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}({g}^{2}+36{h}^{2})({g}^{2}-36{h}^{2}) & =({g}^{2}+36{h}^{2})(g+6h)(g-6h)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248170 :knowledge-point/_questions [{:knowledge-point/id #uuid "94cbd132-72fc-5645-bca3-9c81b6ac3845" :knowledge-point/title "Applying the Rule of Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "251d5a53-c2f4-5a75-9b30-ea3839d19404" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186248172} {:answer/id #uuid "75ecc73e-3608-57fc-a752-90f7a4471c2f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186248173} {:answer/id #uuid "0eaa0324-b789-5848-a11f-6c66434977bf" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186248174} {:answer/id #uuid "4a430658-97a0-54f2-9275-e33ab24db993" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186248175} {:answer/id #uuid "636cbc9c-ac02-5f79-8e3e-26e8bc2f0091" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248176}] :answer-field/correct {:answer/id #uuid "0eaa0324-b789-5848-a11f-6c66434977bf" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186248174} :answer-field/id #uuid "c5904bd9-652c-5937-aac6-a38a6a23ec58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248171}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "943b9eea-882f-5331-8325-3e39142318ab" :question/is-example false :question/math-academy-id "q-122082" :question/problem "David wants to play with one of his favorite toys. He has $3$ action figures, $8$ cars, $2$ building blocks sets, and $1$ electronic device. How many choices of toys does David have?" :question/worked-solution "In order to find the total number of choices David has, we can use the **rule of sum**:\n\n$$\n3+8+2+1=14\n$$\n\nTherefore, David has a choice of $14$ toys."}] [{:db/id #edb/ref 17592186248177 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d59d6a9b-bcb6-50f1-a667-50bf186d1265" :answer/type {:db/ident :answer.type/text} :answer/value "Between quadrants I and II" :db/id #edb/ref 17592186248179} {:answer/id #uuid "14574a40-341f-5a04-94e3-4dcb7cde822d" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186248180} {:answer/id #uuid "b11893c0-0c0b-5125-a6c5-dd0e4c72ee69" :answer/type {:db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186248181} {:answer/id #uuid "cff0057b-9658-5442-a7fc-64e229d19e05" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186248182} {:answer/id #uuid "8e75c66f-e505-5275-9fd3-17257d77e79a" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186248183}] :answer-field/correct {:answer/id #uuid "8e75c66f-e505-5275-9fd3-17257d77e79a" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186248183} :answer-field/id #uuid "86beff0f-f2c3-575e-9f2f-07c8a9bfb612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248178}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d0e55934-d01a-5c52-b15c-95be9b2ee854" :question/is-example false :question/math-academy-id "q-124716" :question/problem "The angle $\\theta =-\\frac{43\\pi }{12}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-\\frac{43\\pi }{12}$ by *adding* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $-\\frac{43\\pi }{12}+2\\pi =-\\frac{19\\pi }{12}$\n\n- $-\\frac{43\\pi }{12}+2\\cdot (2\\pi )=\\frac{5\\pi }{12}\\,✓$\n\nSo the angle $-\\frac{43\\pi }{12}$ is coterminal with $\\frac{5\\pi }{12}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13938136/assets/98324683d6b71e6026341cd70e2c84acb35bb117bd0bb41b627121b3b4f17a79.png)\n\nWe see that $\\frac{5\\pi }{12}$ lies in quadrant I. Therefore, $-\\frac{43\\pi }{12}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186248184 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Synthetic Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158601eb-5d2c-56be-9640-a63182532af1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248186}] :answer-field/correct {:answer/id #uuid "158601eb-5d2c-56be-9640-a63182532af1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248186} :answer-field/id #uuid "2922d52a-1275-5801-9173-26241151ceb6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248185}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7e641bf-c9dd-5010-81cc-3e5834590a0f" :question/is-example false :question/math-academy-id "q-278326" :question/problem "The multiplicity of the root $x=-10$ in the polynomial $p(x)={x}^{3}+30{x}^{2}+300x+1000$ is{{field-1}}." :question/worked-solution "Since $x=-10$ is a root of $p(x),$ the factor theorem tells us that $(x+10)$ is a factor of $p(x).$\n\nBecause $(x+10)$ is a factor of $p(x),$ we know that $(x+10)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x+10)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-10$ | $1$ | $30$ | $300$ | $1000$ |\n|  | $↓$ | $-10$ | $-200$ | $-1000$ |\n|  | $1$ | $20$ | $100$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x+10}={x}^{2}+20x+100,\n$$\n\nwhich means that\n\n$$\np(x)=(x+10)({x}^{2}+20x+100).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x+10)(x+10)^{2} \\\\  & =(x+10)^{3}.\\end{aligned}\n$$\n\nThe factor $(x+10)$ has an exponent of $3$ in the factored form of $p(x).$ So the root $x=-10$ has multiplicity $3.$"}] [{:db/id #edb/ref 17592186248187 :knowledge-point/_questions [{:knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5182805d-fda4-5a06-96b7-0692777707b2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248189}] :answer-field/correct {:answer/id #uuid "5182805d-fda4-5a06-96b7-0692777707b2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248189} :answer-field/id #uuid "201d794d-dae3-5b0d-bd63-0b6542fef142" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248188}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3f202e8b-630d-50de-8a3d-0b543130e628" :question/is-example false :question/math-academy-id "q-338426" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13938136/assets/52c11d9ff3afeef74c579d4cb2c5448c9f5b77b7d6569535214bb67408276026.png)\n\nIf the figure above shows the graph of the functions $f(x)$ and $g(x),$ then\n\n${lim}_{x\\to \\,1}\\sqrt{\\frac{3f(x)-g(x)}{f(x)}}=$\n{{field-1}}" :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,1}f(x)=2$ and ${lim}_{x\\to \\,1}g(x)=4.$\n\nApplying the root and the quotient rules, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}\\sqrt{\\frac{3f(x)-g(x)}{f(x)}} & =\\sqrt{\\,{lim}_{x\\to \\,1}\\frac{3f(x)-g(x)}{f(x)}\\,} \\\\  & =\\sqrt{\\,\\frac{{lim}_{x\\to \\,1}(3f(x)-g(x))}{{lim}_{x\\to \\,1}f(x)}\\,}.\\end{aligned}\n$$\n\nNow, we calculate the limits of the numerator and denominator separately. This gives\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}(3f(x)-g(x)) & =3(2)-4 \\\\  & =6-4 \\\\  & =2,\\end{aligned}\n$$\n\nand\n\n$$\n{lim}_{x\\to \\,1}f(x)=2.\n$$\n\nSo we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,1}\\sqrt{\\frac{3f(x)-g(x)}{f(x)}} & =\\sqrt{\\frac{2}{2}} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248190 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117c4140-7066-5f39-b26c-374bef02e79b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186248192} {:answer/id #uuid "a1330dc7-c11b-57cc-a195-97cf55d6cefe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186248193} {:answer/id #uuid "bbb664ea-94f6-551b-b2a6-b5cf310f6b98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186248194} {:answer/id #uuid "0678c30a-7fab-598d-968f-934e3ea7d3e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186248195} {:answer/id #uuid "25d84bad-78e6-50c8-a7f1-d046f435f616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186248196}] :answer-field/correct {:answer/id #uuid "25d84bad-78e6-50c8-a7f1-d046f435f616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186248196} :answer-field/id #uuid "3f45cfc7-b505-54ca-b9ba-ae869a0aee7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248191}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "926640fe-3830-5c44-85a6-d06f89a5ca73" :question/is-example false :question/math-academy-id "q-64927" :question/problem "$cos⁡(\\frac{11\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13938136/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{11\\pi }{6}$ corresponds to the point $(\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $cos⁡(\\frac{11\\pi }{6})=\\frac{\\sqrt{3}}{2}.$"}] [{:db/id #edb/ref 17592186248197 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6a0a30e-3f82-5798-9030-365e590ddd5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-z+2}{z(w-1)}" :db/id #edb/ref 17592186248199} {:answer/id #uuid "cb0feeb3-911c-5013-9d5b-3155a62dbdbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2w}{z(w-1)}" :db/id #edb/ref 17592186248200} {:answer/id #uuid "360d371b-f170-5783-acb5-c3af763a767c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{w+3}{z(w-1)}" :db/id #edb/ref 17592186248201} {:answer/id #uuid "365725af-9bb0-5094-9de5-ec9d0767803e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{z-6}{z(w-1)}" :db/id #edb/ref 17592186248202} {:answer/id #uuid "f367018f-3530-571f-ad6d-9daffb62400b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{z+3}{z(w-1)}" :db/id #edb/ref 17592186248203}] :answer-field/correct {:answer/id #uuid "f367018f-3530-571f-ad6d-9daffb62400b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{z+3}{z(w-1)}" :db/id #edb/ref 17592186248203} :answer-field/id #uuid "e28c27a7-325c-5eba-9980-2849411f29d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248198}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "77e05f93-4f79-5c82-a6fe-d57ac219a554" :question/is-example false :question/math-academy-id "q-70291" :question/problem "Simplify $\\frac{3}{z(w-1)}-\\frac{1}{1-w}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $z(w-1)$ if we multiply the top and bottom of the second fraction by $-z:$\n\n$$\n\\begin{aligned}\\frac{3}{z(w-1)}-\\frac{1}{1-w} & = \\\\ \\frac{3}{z(w-1)}-\\frac{(-z)}{(-z)}\\cdot \\frac{1}{1-w} & = \\\\ \\frac{3}{z(w-1)}+\\frac{z}{z(w-1)} & = \\\\ \\frac{z+3}{z(w-1)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248204 :knowledge-point/_questions [{:knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3" :knowledge-point/title "Finding the Midpoint of a Segment With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61079067-1867-59b5-8857-8598a4ea42b8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2a,b)" :db/id #edb/ref 17592186248206} {:answer/id #uuid "93ad9a93-7869-5408-b7bc-75fccc72c264" :answer/type {:db/ident :answer.type/math} :answer/value "(-a,b)" :db/id #edb/ref 17592186248207} {:answer/id #uuid "2f0613a7-0f04-5de3-b912-cfb756101062" :answer/type {:db/ident :answer.type/math} :answer/value "(a,-b)" :db/id #edb/ref 17592186248208} {:answer/id #uuid "74951dba-a6ea-5ffc-bba3-918d37d25da6" :answer/type {:db/ident :answer.type/math} :answer/value "(-4a,5b)" :db/id #edb/ref 17592186248209} {:answer/id #uuid "b3486209-4bb0-5953-927f-2cae55f14141" :answer/type {:db/ident :answer.type/math} :answer/value "(-2a,3b)" :db/id #edb/ref 17592186248210}] :answer-field/correct {:answer/id #uuid "93ad9a93-7869-5408-b7bc-75fccc72c264" :answer/type {:db/ident :answer.type/math} :answer/value "(-a,b)" :db/id #edb/ref 17592186248207} :answer-field/id #uuid "8904260a-4426-5528-8654-93b119108ab6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248205}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eedc9d16-8edc-55bd-876e-81e7d64a16db" :question/is-example false :question/math-academy-id "q-73719" :question/problem "Find the midpoint of the line segment with endpoints $(3a,-4b)$ and $(-5a,6b).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(3a,-4b)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-5a,6b)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{3a+(-5a)}{2},\\frac{-4b+6b}{2}) \\\\  & =(\\frac{3a-5a}{2},\\frac{-4b+6b}{2}) \\\\  & =(\\frac{-2a}{2},\\frac{2b}{2}) \\\\  & =(-a,b).\\end{aligned}\n$$"}]}
