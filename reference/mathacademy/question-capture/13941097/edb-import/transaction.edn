}{\\text{d}u}=\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u),\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{csc}⁡x\\operatorname{cot}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u)\\cdot (-\\operatorname{csc}⁡x\\operatorname{cot}⁡x) \\\\  & =-\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\cdot \\operatorname{sec}⁡(\\operatorname{csc}⁡(x))\\cdot \\operatorname{tan}⁡(\\operatorname{csc}⁡(x)).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342445/field-1" "q-342445/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37"] :knowledge-point/questions ["q-342445"] :db/ensure [:knowledge-point/validate]}]
