me{tan}⁡u \\\\  & =2\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31320/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-31320"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31338/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c42c4972-fb0a-5aa5-973d-ae1f029e11d9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31338/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "7b01cb61-da98-5256-a277-93edab9727ff" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-31338/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "5b180426-2802-55de-befa-7a0a05429e07" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-31338/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "601da557-6c68-57ab-82f9-a0704a025da8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-31338/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "5564dadc-9793-5184-8969-31e9829a0d6c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-31338/selection" :answer-field/id #uuid "f28b8fa5-063f-566c-87c0-d65d3defd467" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31338/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-31338/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-31338/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-31338/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-31338/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-31338/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a"] :db/ensure [:answer-field/validate]} {:db/id "q-31338" :question/id #uuid "f0a20154-4979-52d5-a59b-8c443685f700" :question/math-academy-id "q-31338" :question/problem "Find the slope of $f(x)=\\operatorname{cot}⁡(2\\pi -3x)$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is $3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31338/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-31338"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31340/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "3faac535-1eed-5d9d-8b81-042bd18237dc" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-31340/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "993d6b2a-cc06-5faa-93ff-5518d0789830" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31340/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "4fccd886-915b-581e-b60e-103bcac02004" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-31340/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ba3275da-ff1a-5649-82ea-ac7d71f6d280" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-31340/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "c26813cd-bc60-5821-b9bf-ac72705909cd" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-31340/selection" :answer-field/id #uuid "e567891c-e76a-566c-8cc5-e92026da2c00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31340/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-31340/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-31340/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-31340/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-31340/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-31340/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-31340" :question/id #uuid "20ad52c2-8f54-5714-be4e-62fde8b2ebfb" :question/math-academy-id "q-31340" :question/problem "Find the slope of $f(x)=\\operatorname{csc}⁡(5x)$ at $x=-\\frac{\\pi }{2}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{csc}⁡u,\\,u=5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-\\operatorname{csc}⁡u\\operatorname{cot}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-\\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot (5) \\\\  & =-5\\operatorname{csc}⁡u\\operatorname{cot}⁡u \\\\  & =-5\\operatorname{csc}⁡(5x)\\operatorname{cot}⁡(5x).\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=-\\frac{\\pi }{2}$ is \n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}{|}_{x=-\\pi /2} & =-5\\operatorname{csc}⁡(5x)\\operatorname{cot}⁡(5x){|}_{x=-\\pi /2} \\\\  & =-5\\operatorname{csc}⁡(5\\cdot (-\\frac{\\pi }{2}))\\operatorname{cot}⁡(5\\cdot (-\\frac{\\pi }{2})) \\\\  & =-5\\operatorname{csc}⁡(-\\frac{5\\pi }{2})\\operatorname{cot}⁡(-\\frac{5\\pi }{2}) \\\\  & =-5\\cdot (-1)\\cdot 0 \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nHence, the slope of the tangent to the curve at $x=-\\frac{\\pi }{2}$ is $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31340/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-31340"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48512/selection/0f9867736a0751423288f389ed75c99f55dabfe0fcc34acca552728eaa88390e" :answer/id #uuid "73e0aed9-9715-5790-9947-4275f50e7dce" :answer/type :answer.type/math :answer/value "y=x-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-48512/selection/f9282064c26657f63597f6017554a74c7d65207cc7e82ae93202bf5fab1de4d6" :answer/id #uuid "7f81fd48-a200-5815-8e5a-8f081ffac6ee" :answer/type :answer.type/math :answer/value "y=\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-48512/selection/6849b334b34ff9c4e52fa34f81a710c08900fdfc24f4053cdb4c516c15d10f8a" :answer/id #uuid "2a470438-fff3-5dfc-9fa0-6324ba0c0734" :answer/type :answer.type/math :answer/value "y=3x-\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-48512/selection/5f0833e990329fbb13b4e8b36131c3b9bfbbe9f01e395a0615dd648c0bf614a1" :answer/id #uuid "c95daef1-8352-537c-bf99-0fa1f93a1e8e" :answer/type :answer.type/math :answer/value "y=3x-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-48512/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer/id #uuid "b053f24c-4996-5ce9-98d0-dc47c9aea36e" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "q-48512/selection" :answer-field/id #uuid "58eac446-51d4-59e2-bf70-de88799bc63e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48512/selection/6849b334b34ff9c4e52fa34f81a710c08900fdfc24f4053cdb4c516c15d10f8a" :answer-field/choices ["q-48512/selection/0f9867736a0751423288f389ed75c99f55dabfe0fcc34acca552728eaa88390e" "q-48512/selection/f9282064c26657f63597f6017554a74c7d65207cc7e82ae93202bf5fab1de4d6" "q-48512/selection/6849b334b34ff9c4e52fa34f81a710c08900fdfc24f4053cdb4c516c15d10f8a" "q-48512/selection/5f0833e990329fbb13b4e8b36131c3b9bfbbe9f01e395a0615dd648c0bf614a1" "q-48512/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7"] :db/ensure [:answer-field/validate]} {:db/id "q-48512" :question/id #uuid "4144dd65-7226-52bc-a7d8-5957ea70967a" :question/math-academy-id "q-48512" :question/problem "Find the equation of the tangent to the curve $y=\\operatorname{cot}⁡(2\\pi -3x)$ at the point $(\\frac{\\pi }{2},0).$" :question/worked-solution "First, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(-{csc}^{2}⁡u)\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}m={f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(\\frac{\\pi }{2},0):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =3(x-\\frac{\\pi }{2}) \\\\ y & =3x-\\frac{3\\pi }{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-48512/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-48512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-310222/field-1/9ba576dc6f353fb4e1fa4e94382076a19c00a3e3c2a42459a50c957a5a56e5f5" :answer/id #uuid "95b67c40-7340-5f04-8aea-22ad839d66c7" :answer/type :answer.type/math :answer/value "\\frac{-6x^2}{\\sin(2x^3)^2}" :db/ensure [:answer/validate]} {:db/id "q-310222/field-1" :answer-field/id #uuid "d7690651-f37f-597a-8dc6-f34c249d582f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-310222/field-1/9ba576dc6f353fb4e1fa4e94382076a19c00a3e3c2a42459a50c957a5a56e5f5" :answer-field/choices ["q-310222/field-1/9ba576dc6f353fb4e1fa4e94382076a19c00a3e3c2a42459a50c957a5a56e5f5"] :db/ensure [:answer-field/validate]} {:db/id "q-310222" :question/id #uuid "0c90cfa9-0486-5203-9da6-c4a1b9ecc483" :question/math-academy-id "q-310222" :question/problem "Given that $f(x)=\\operatorname{cot}⁡(2{x}^{3}),$ we have\n\n${f}^{′}(x)=$\n\n{{field-1}}." :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{cot}⁡u,\\,u=2{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=6{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot 6{x}^{2} \\\\  & =-6{x}^{2}{csc}^{2}⁡(2{x}^{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-310222/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-310222"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72156/selection/c137bc5064d4879b8a88b51318523aa086b8909f9e76424829ab185d9760fba8" :answer/id #uuid "3d33837b-4c69-54cb-9b6d-d761eb8463b7" :answer/type :answer.type/math :answer/value "-40{cos}^{7}⁡x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72156/selection/e19911fcb2936ce8aef280a9238e227127ece540cb1eda25f83c6625ea0d6723" :answer/id #uuid "1ce228d4-4fa3-5766-bf52-775d47061ab4" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡x{sin}^{7}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72156/selection/9d55173506e56aae27b42538aba94a361ed22f9af8b064990a1f66cfb2c58b37" :answer/id #uuid "b4995489-1af9-5779-a344-a958925a6cf8" :answer/type :answer.type/math :answer/value "-5{sin}^{7}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72156/selection/f78612172a978c9e1fd79f9205f81efbf327020b859de7019a75e0bef500ab35" :answer/id #uuid "b6705871-38da-5e55-a4be-03e6e35a8e68" :answer/type :answer.type/math :answer/value "40{cos}^{7}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72156/selection/b6c15a94568fecfb29fea5c7f81649e9505ee9e6543704e745e2daa5f1762558" :answer/id #uuid "6e1fdb45-bad5-54a7-b9e7-4b21dff7406b" :answer/type :answer.type/math :answer/value "-40\\operatorname{cos}⁡x{sin}^{7}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72156/selection" :answer-field/id #uuid "2dc3a383-3cd2-5cef-b0d6-bdf8180d64d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72156/selection/c137bc5064d4879b8a88b51318523aa086b8909f9e76424829ab185d9760fba8" :answer-field/choices ["q-72156/selection/c137bc5064d4879b8a88b51318523aa086b8909f9e76424829ab185d9760fba8" "q-72156/selection/e19911fcb2936ce8aef280a9238e227127ece540cb1eda25f83c6625ea0d6723" "q-72156/selection/9d55173506e56aae27b42538aba94a361ed22f9af8b064990a1f66cfb2c58b37" "q-72156/selection/f78612172a978c9e1fd79f9205f81efbf327020b859de7019a75e0bef500ab35" "q-72156/selection/b6c15a94568fecfb29fea5c7f81649e9505ee9e6543704e745e2daa5f1762558"] :db/ensure [:answer-field/validate]} {:db/id "q-72156" :question/id #uuid "05c5e383-09df-5a39-ad1a-77ea88b63ed5" :question/math-academy-id "q-72156" :question/problem "Find ${f}^{′}(x)$ when $f(x)=5{cos}^{8}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=5(\\operatorname{cos}⁡x)^{8}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=5{u}^{8},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=40{u}^{7},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =40{u}^{7}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =40(\\operatorname{cos}⁡x)^{7}(-\\operatorname{sin}⁡x) \\\\  & =-40{cos}^{7}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72156/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-72156"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342424/field-1/4981a8fcf5154b2937e1279b0cd7130a9e88cbacdd5521e83e2084a8f55c9250" :answer/id #uuid "8af6499f-b8c4-507f-92d1-c7b735b28355" :answer/type :answer.type/math :answer/value "20\\cos(x)^4\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-342424/field-1/3387414ad9834a43aba7f1b619fe6fa16c393009922a32989e7aba646f0fc78b" :answer/id #uuid "0aed239e-8e9e-5d86-8e94-114d42429c22" :answer/type :answer.type/math :answer/value "-20\\cos(x)^4\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-342424/field-1" :answer-field/id #uuid "16edfbcd-48e6-56d9-944c-70c5ca3c214a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342424/field-1/4981a8fcf5154b2937e1279b0cd7130a9e88cbacdd5521e83e2084a8f55c9250" :answer-field/choices ["q-342424/field-1/4981a8fcf5154b2937e1279b0cd7130a9e88cbacdd5521e83e2084a8f55c9250" "q-342424/field-1/3387414ad9834a43aba7f1b619fe6fa16c393009922a32989e7aba646f0fc78b"] :db/ensure [:answer-field/validate]} {:db/id "q-342424" :question/id #uuid "41618891-0d89-52d2-8e35-cd9776cd53cf" :question/math-academy-id "q-342424" :question/problem "Given that $f(x)=-4{cos}^{5}⁡(x),$ we have\n\n${f}^{′}(x)=$\n{{field-1}}." :question/worked-solution "First, we express\n\n$$\nf(x)=-4(\\operatorname{cos}⁡(x))^{5}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=-4{u}^{5},\\,u=\\operatorname{cos}⁡(x).\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-20{u}^{4},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡(x).\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-20{u}^{4}\\cdot (-\\operatorname{sin}⁡(x)) \\\\  & =20{cos}^{4}⁡(x)\\operatorname{sin}⁡(x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342424/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-342424"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72154/