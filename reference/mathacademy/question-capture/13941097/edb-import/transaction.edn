in}⁡(x))^{7}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf={u}^{7},\\,u=\\operatorname{sin}⁡(x).\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=7{u}^{6},\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡(x).\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =7{u}^{6}\\cdot \\operatorname{cos}⁡(x) \\\\  & =7{sin}^{6}⁡(x)\\operatorname{cos}⁡(x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342420/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-342420"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48560/selection/acac502442b4c16b8d071489cc18607a8c9d01b0875e1fb8a9baea440585187a" :answer/id #uuid "f2a330b5-009a-52f4-b367-473bbfb1b19a" :answer/type :answer.type/math :answer/value "-2{cos}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48560/selection/6ed7541656a78e913aa4a29fcc63f14df4ad943c9afe513ee16462bc07eb26b0" :answer/id #uuid "a5d0ac51-4c7b-54b8-89bd-6faf18852a4e" :answer/type :answer.type/math :answer/value "{cos}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48560/selection/b34c1ad52c2002217dc503efc29e7e834c180d9816ed133b900011193994e6de" :answer/id #uuid "9c693f85-719c-5df5-8530-abf66c5f3571" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡x\\,\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48560/selection/f19b31e1804aa67ab580baba6294b232074c2796c005fe7e35db0b60bde8ef29" :answer/id #uuid "6c027a30-dd2d-5e37-973b-33f1fddabd68" :answer/type :answer.type/math :answer/value "-2\\operatorname{sin}⁡x\\,\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48560/selection/a931fbf4123c49aea3da11d366dfc3c7396fef81e795eb51d60df4a2433ed3cc" :answer/id #uuid "dfaf06f9-80d2-59fa-863e-5d357a9127ad" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x\\,\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48560/selection" :answer-field/id #uuid "cabeb49d-b84f-526d-b429-420f757cd5a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48560/selection/b34c1ad52c2002217dc503efc29e7e834c180d9816ed133b900011193994e6de" :answer-field/choices ["q-48560/selection/acac502442b4c16b8d071489cc18607a8c9d01b0875e1fb8a9baea440585187a" "q-48560/selection/6ed7541656a78e913aa4a29fcc63f14df4ad943c9afe513ee16462bc07eb26b0" "q-48560/selection/b34c1ad52c2002217dc503efc29e7e834c180d9816ed133b900011193994e6de" "q-48560/selection/f19b31e1804aa67ab580baba6294b232074c2796c005fe7e35db0b60bde8ef29" "q-48560/selection/a931fbf4123c49aea3da11d366dfc3c7396fef81e795eb51d60df4a2433ed3cc"] :db/ensure [:answer-field/validate]} {:db/id "q-48560" :question/id #uuid "90cda8c9-8228-53b9-bb6f-76648ef22cc8" :question/math-academy-id "q-48560" :question/problem "Find ${f}^{′}(x)$ when $f(x)={sin}^{2}⁡x.$" :question/worked-solution "First, we express\n\n$$\nf(x)=(\\operatorname{sin}⁡x)^{2}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf={u}^{2},\\,u=\\operatorname{sin}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=2u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2u\\cdot \\operatorname{cos}⁡x \\\\  & =2\\operatorname{sin}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-48560/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-48560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342436/field-1/850412f4c9f4324f8861600508e59e5ff5b48b4fbd31cee743141975b5d87611" :answer/id #uuid "0770d101-f764-5cd4-8e13-9f5c8482a895" :answer/type :answer.type/math :answer/value "\\frac{1}{\\cos(\\tan(x))^2}" :db/ensure [:answer/validate]} {:db/id "q-342436/field-1" :answer-field/id #uuid "2418653b-858c-5b51-927a-a4714e73acfa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342436/field-1/850412f4c9f4324f8861600508e59e5ff5b48b4fbd31cee743141975b5d87611" :answer-field/choices ["q-342436/field-1/850412f4c9f4324f8861600508e59e5ff5b48b4fbd31cee743141975b5d87611"] :db/ensure [:answer-field/validate]} {:db/id "q-342436" :question/id #uuid "a6814a75-da83-5355-bf98-1eb781c96296" :question/math-academy-id "q-342436" :question/problem "Given that $y=\\operatorname{tan}⁡(\\operatorname{tan}⁡(x)),$ we have\n\n$\\frac{\\text{d}y}{\\text{d}x}={sec}^{2}⁡(x)\\,\\cdot $\n{{field-1}}." :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\operatorname{tan}⁡(u),\\,u=\\operatorname{tan}⁡(x).\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={sec}^{2}⁡(u),\\,\\frac{\\text{d}u}{\\text{d}x}={sec}^{2}⁡(x).\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={sec}^{2}⁡(u)\\cdot {sec}^{2}⁡(x) \\\\  & ={sec}^{2}⁡(x)\\cdot {sec}^{2}⁡(\\operatorname{tan}⁡(x)).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342436/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37"] :knowledge-point/questions ["q-342436"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72173/selection/a1b6d43134c92382665d2ff6cfaa7f0a56cd1c44a06510558dac5fa94b02695b" :answer/id #uuid "c7cc3570-7b46-5bdf-8eca-1d1d299e114d" :answer/type :answer.type/math :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72173/selection/ea6cb6e61ab0e449955aab0f4acafbfc449d49cf1b2e97dd85b2f2721034b6b5" :answer/id #uuid "66f5e1bd-da78-53b0-b7c2-000c9064f900" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72173/selection/7ab419f5703a71bf4200ff03250d433f573a54f57071b75db73e2ddee04c8a6f" :answer/id #uuid "8acd60a1-93b3-55b9-a976-f21972ee8df0" :answer/type :answer.type/math :answer/value "3\\operatorname{sec}⁡x\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72173/selection/1c96c095264f0da9dddee66df5146f6bcf5c188ee1af9e862360307826cd12e1" :answer/id #uuid "b0c68edb-5213-50eb-b467-de5306b2c6ab" :answer/type :answer.type/math :answer/value "3\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72173/selection/55ab42975b7720cc564ac1b48e6fb26e9b118e351e23370c2cfdcc80d94b068a" :answer/id #uuid "783d43e6-aa55-5357-8c5c-6216e9dfba91" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡(-\\operatorname{sin}⁡x)\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72173/selection" :answer-field/id #uuid "8499a557-a87c-542e-9f5c-37d383c8727f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72173/selection/a1b6d43134c92382665d2ff6cfaa7f0a56cd1c44a06510558dac5fa94b02695b" :answer-field/choices ["q-72173/selection/a1b6d43134c92382665d2ff6cfaa7f0a56cd1c44a06510558dac5fa94b02695b" "q-72173/selection/ea6cb6e61ab0e449955aab0f4acafbfc449d49cf1b2e97dd85b2f2721034b6b5" "q-72173/selection/7ab419f5703a71bf4200ff03250d433f573a54f57071b75db73e2ddee04c8a6f" "q-72173/selection/1c96c095264f0da9dddee66df5146f6bcf5c188ee1af9e862360307826cd12e1" "q-72173/selection/55ab42975b7720cc564ac1b48e6fb26e9b118e351e23370c2cfdcc80d94b068a"] :db/ensure [:answer-field/validate]} {:db/id "q-72173" :question/id #uuid "0850c6d8-9345-5a32-9826-232b712af5ac" :question/math-academy-id "q-72173" :question/problem "Find the derivative of $y=3\\operatorname{sec}⁡(\\operatorname{cos}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\operatorname{sec}⁡u,\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\operatorname{sec}⁡u\\operatorname{tan}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72173/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37"] :knowledge-point/questions ["q-72173"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341223/field-1/d77d44b5097fbbe3c31cbf999f370b945404caabad4bde6b6b7b7c7c9bcdc4d2" :answer/id #uuid "79b35e0d-fade-5801-8857-5ae0d019c226" :answer/type :answer.type/math :answer/value "-4\\cos(x)" :db/ensure [:answer/validate]} {:db/id "q-341223/field-1/286f252b5fa1a4ba57085c40f32117fc2d0d91f90827ceb8126693f1545fae8e" :answer/id #uuid "858dc101-b0d5-5de1-a73d-7a42c8fb0b44" :answer/type :answer.type/math :answer/value "4\\cos(x)" :db/ensure [:answer/validate]} {:db/id "q-341223/field-1" :answer-field/id #uuid "153a3731-b23c-5cde-bede-9b86e334f429" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341223/field-1/d77d44b5097fbbe3c31cbf999f370b9