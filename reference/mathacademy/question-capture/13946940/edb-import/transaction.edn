[{:db/id "q-332018/field-1/2f812dc55aeec41829ef551bd5cd43d9dfefd0bb3c65bda74b19c631bc8985d1" :answer/id #uuid "c2f7ea0b-23c2-5400-a759-8ec402880fc7" :answer/type :answer.type/math :answer/value "-0.61" :db/ensure [:answer/validate]} {:db/id "q-332018/field-1" :answer-field/id #uuid "cd240eb9-5eb7-5a6c-bf95-1e4b8f1721c6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332018/field-1/2f812dc55aeec41829ef551bd5cd43d9dfefd0bb3c65bda74b19c631bc8985d1" :answer-field/choices ["q-332018/field-1/2f812dc55aeec41829ef551bd5cd43d9dfefd0bb3c65bda74b19c631bc8985d1"] :db/ensure [:answer-field/validate]} {:db/id "q-332018" :question/id #uuid "228cc6f3-1808-5165-94f7-09b330f1f3c8" :question/math-academy-id "q-332018" :question/problem "A data set has mean $\\overset{―}{x}=7$ and variance ${\\sigma }^{2}=1.7.$ Find the $z$-score of an observation $x=6.2,$ rounding your answer to $2$ decimal places.\n\n$z=$\n{{field-1}}" :question/worked-solution "The $z$-score of an observation $x$ is defined by\n\n$$\nz=\\frac{x-\\overset{―}{x}}{\\sigma }.\n$$\n\nThe $z$-score represents how many standard deviations an observation is above or below the mean of the data set.\n\nHere, we're told that the mean is $\\overset{―}{x}=7,$ and we can calculate the standard deviation as\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{1.7}.\n$$\n\nSo, the $z$-score of the observation $x=6.2$ is given by\n\n$$\n\\begin{aligned}z & =\\frac{x-\\overset{―}{x}}{\\sigma } \\\\  & =\\frac{6.2-7}{\\sqrt{1.7}} \\\\  & ≈-0.61,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332018/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dc94085c-4088-5eaf-887a-eea7f040573c"] :knowledge-point/questions ["q-332018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94460/selection/03f4d794aab989989238169d979f4252915c5a4d9ba2cfa5aa4a4d5829c96ed0" :answer/id #uuid "9013badc-42