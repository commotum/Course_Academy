answer-fields [{:answer-field/choices [{:answer/id #uuid "db68038b-374f-5362-870a-2ba4081076e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186268231} {:answer/id #uuid "e728f264-4932-5a0f-9365-26b3ebb68f14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{tan}⁡x-1}" :db/id #edb/ref 17592186268232} {:answer/id #uuid "abba1715-f5bb-5343-b514-1114c4c13370" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{1-\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186268233} {:answer/id #uuid "eaa2ed37-afe2-5da2-bf93-c91905bdb852" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186268234} {:answer/id #uuid "7c9d283c-ae1e-5178-a934-13dea73e9e24" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{1+\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186268235}] :answer-field/correct {:answer/id #uuid "eaa2ed37-afe2-5da2-bf93-c91905bdb852" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186268234} :answer-field/id #uuid "2dd89473-9581-5def-bc29-3d46599d6831" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268230}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "be30c7d2-3406-5e2b-8459-18b2cb5de7e3" :question/math-academy-id "q-142832" :question/problem "$\\frac{4\\operatorname{tan}⁡x}{{sec}^{2}⁡x-1}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{4\\operatorname{tan}⁡x}{{sec}^{2}⁡x-1} & =\\frac{4\\operatorname{tan}⁡x}{1+{tan}^{2}⁡x-1} \\\\  & =\\frac{4\\operatorname{tan}⁡x}{{tan}^{2}⁡x} \\\\  & =\\frac{4\\operatorname{tan}⁡x}{\\operatorname{tan}⁡x\\cdot \\operatorname{tan}⁡x} \\\\  & =\\frac{4\\cancel{\\operatorname{tan}⁡x}}{\\cancel{\\operatorname{tan}⁡x}\\cdot \\operatorname{tan}⁡x} \\\\  & =\\frac{4}{\\operatorname{tan}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{4\\operatorname{tan}⁡x}{{sec}^{2}⁡x-1}=\\frac{4}{\\operatorname{tan}⁡x}.\n$$"}] [{:db/id #edb/ref 17592186268236 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3b714da-3f82-5f2a-b809-91f95d27480a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268238} {:answer/id #uuid "b61659b2-28d9-547c-926b-c5b24275a2a9" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268239} {:answer/id #uuid "57f64615-5bf2-5f12-8c39-605abe79b044" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268240} {:answer/id #uuid "4116984e-02d3-5b9d-96ae-85752c7b4bed" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268241} {:answer/id #uuid "9c211ca5-ddc8-5c40-b1dd-ec5b2191f1ef" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268242}] :answer-field/correct {:answer/id #uuid "a3b714da-3f82-5f2a-b809-91f95d27480a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268238} :answer-field/id #uuid "498f6180-4180-570b-8360-84bce772c0b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8510cfee-abc8-5e92-9edd-86d13571ef1f" :question/math-academy-id "q-142839" :question/problem "$\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x} & =\\frac{1-(1+{tan}^{2}⁡x)}{\\operatorname{tan}⁡x} \\\\  & =\\frac{-{tan}^{2}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{tan}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\cancel{\\operatorname{tan}⁡x}}{\\cancel{\\operatorname{tan}⁡x}} \\\\  & =-\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=-\\operatorname{tan}⁡x.\n$$"}] [{:db/id #edb/ref 17592186268243 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e7c6e38-a87a-5e7a-9189-c2cc00805689" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268245} {:answer/id #uuid "0e8680b9-af6c-50a2-8539-1144826c4f14" :answer/type {:db/ident :answer.type/math} :answer/value "1+2\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268246} {:answer/id #uuid "dd0ac4e1-2af1-5de0-9b9c-3ad09e043b64" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186268247} {:answer/id #uuid "6ae5e249-b384-59fa-9918-2509daeda5cb" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268248} {:answer/id #uuid "f2b3c4a5-1a69-5feb-98d8-26a37b1c112e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268249}] :answer-field/correct {:answer/id #uuid "f2b3c4a5-1a69-5feb-98d8-26a37b1c112e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268249} :answer-field/id #uuid "fdbce858-b666-51bf-af3b-9bfc28a0abf1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268244}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7846a8aa-6fe8-52c3-b913-e91f7310ae92" :question/math-academy-id "q-142842" :question/problem "$\\frac{{tan}^{3}⁡\\theta }{1-{sec}^{2}⁡\\theta }=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{{tan}^{3}⁡\\theta }{1-{sec}^{2}⁡\\theta } & =\\frac{{tan}^{3}⁡\\theta }{1-(1+{tan}^{2}⁡\\theta )} \\\\  & =\\frac{{tan}^{3}⁡\\theta }{1-1-{tan}^{2}⁡\\theta } \\\\  & =-\\frac{{tan}^{3}⁡\\theta }{{tan}^{2}⁡\\theta } \\\\  & =-\\frac{{tan}^{2}⁡\\theta \\cdot \\operatorname{tan}⁡\\theta }{{tan}^{2}⁡\\theta } \\\\  & =-\\frac{\\cancel{{tan}^{2}⁡\\theta }\\cdot \\operatorname{tan}⁡\\theta }{\\cancel{{tan}^{2}⁡\\theta }} \\\\  & =-\\operatorname{tan}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{3}⁡\\theta }{1-{sec}^{2}⁡\\theta }=-\\operatorname{tan}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186268250 :knowledge-point/_questions [{:knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1d2cc8d-fff3-57ee-92a8-904346f981ff" :answer/type {:db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186268252} {:answer/id #uuid "ab6a86c1-39ea-5e34-bfbc-019fa8a78ce9" :answer/type {:db/ident :answer.type/math} :answer/value "2-{sin}^{2}⁡x" :db/id #edb/ref 17592186268253} {:answer/id #uuid "bb173f22-b901-594c-9098-7a22ce95fe31" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186268254} {:answer/id #uuid "c2b50e4d-22c6-5782-8985-be8bb71d8549" :answer/type {:db/ident :answer.type/math} :answer/value "1+2{sin}^{2}⁡x" :db/id #edb/ref 17592186268255} {:answer/id #uuid "c9f903dd-6b7b-576f-8b51-c4520d2cd6da" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186268256}] :answer-field/correct {:answer/id #uuid "a1d2cc8d-fff3-57ee-92a8-904346f981ff" :answer/type {:db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186268252} :answer-field/id #uuid "ef1f986b-1abe-50ab-91ce-ffb1d2569c28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "61af6545-1a96-5743-b430-8e3ad4b8da4d" :question/math-academy-id "q-142871" :question/problem "${cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x) & ={cos}^{2}⁡x\\text{ }\\,(1+{tan}^{2}⁡x-2{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x(1-{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x\\end{aligned}\n$$\n\nNext, we recall the identities:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,{cos}^{2}⁡x=1-{sin}^{2}⁡x\n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x} \\\\  & ={cos}^{2}⁡x-\\cancel{{cos}^{2}⁡x}\\cdot \\frac{{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}} \\\\  & ={cos}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-{sin}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-2{sin}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=1-2{sin}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186268257 :knowledge-point/_questions [{:knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4351fc6a-36a9-5e22-9333-010c40a418cf" :answer/type {:db/ident :answer.type/math} :answer/value "-{sin}^{2}⁡x" :db/id #edb/ref 17592186268259} {:answer/id #uuid "af632be7-bd6a-5b26-976c-ac718a76a4d4" :answer/type {:db/ident :answer.type/math} :answer/value "2-{sin}^{2}⁡x" :db/id #edb/ref 17592186268260} {:answer/id #uuid "7e751687-2b59-53b8-9234-021cb67e0000" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186268261} {:answer/id #uuid "65d7efe4-ecb5-5f19-8640-2b2dfa94e36f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186268262} {:answer/id #uuid "300ce1b6-4b06-5117-8a16-0a33d700a96a" :answer/type {:db/ident :answer.type/math} :answer/value "2{cos}^{2}⁡x" :db/id #edb/ref 17592186268263}] :answer-field/correct {:answer/id #uuid "4351fc6a-36a9-5e22-9333-010c40a418cf" :answer/type {:db/ident :answer.type/math} :answer/value "-{sin}^{2}⁡x" :db/id #edb/ref 17592186268259} :answer-field/id #uuid "7bccf825-ba88-5d21-ad62-61231c02fd35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268258}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "db0061b3-c2d4-5614-afe3-22b55236bbdb" :question/math-academy-id "q-142878" :question/problem "$(1-{sec}^{2}\\,x)\\cdot {cos}^{2}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}(1-{sec}^{2}⁡x)\\cdot {cos}^{2}⁡x & =(1-(1+{tan}^{2}⁡x))\\cdot {cos}^{2}⁡x \\\\  & =-{tan}^{2}⁡x\\cdot {cos}^{2}⁡x\\end{aligned}\n$$\n\nNext, we recall the following identity:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\n \n\nUsing the above identity, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}-{tan}^{2}⁡x\\cdot {cos}^{2}⁡x & =-\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}\\cdot {cos}^{2}⁡x \\\\  & =-\\frac{{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}}\\cdot \\cancel{{cos}^{2}⁡x} \\\\  & =-{sin}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(1-{sec}^{2}\\,x)\\cdot {cos}^{2}⁡x=-{sin}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186111105 :knowledge-point/_questions [{:knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c12d622-b0b4-5d2e-9117-5740dac660cf" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186108726} {:answer/id #uuid "c2a33c5f-8478-51fa-b708-e4026d3f3603" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} θ" :db/id #edb/ref 17592186108727} {:answer/id #uuid "17dcea8a-933d-5640-a4e7-22b32d723989" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186108728} {:answer/id #uuid "60898e50-4d60-5c04-a505-9d01cb216d2d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186108729} {:answer/id #uuid "744758fe-9792-5ba2-82ad-893bc102d9c8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec θ" :db/id #edb/ref 17592186108730}] :answer-field/correct {:answer/id #uuid "17dcea8a-933d-5640-a4e7-22b32d723989" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186108728} :answer-field/id #uuid "bb72c19d-05aa-5bb8-80c9-71cf2af83e1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108725}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a581c5d1-c937-510f-8cbd-8478ab152d79" :question/math-academy-id "q-43617" :question/problem "What is $\\frac{1 + \\tan^{2} θ}{\\sec^{2} θ}$?" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } & =\\frac{{sec}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{sec}^{2}⁡\\theta }}{\\cancel{{sec}^{2}⁡\\theta }} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta }=1.\n$$"}]}
