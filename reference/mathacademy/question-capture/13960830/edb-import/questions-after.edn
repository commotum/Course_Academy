c}^{2}⁡\\theta }} \\\\  & =\\operatorname{tan}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta +{tan}^{3}⁡\\theta }{\\operatorname{tan}⁡\\theta \\operatorname{sec}⁡\\theta }=\\operatorname{tan}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186268208 :knowledge-point/_questions [{:knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "412942af-2c22-50b7-9506-1b86678954b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186268210} {:answer/id #uuid "2e5c7d3d-e837-5ac7-89f1-6a5812299040" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta +1" :db/id #edb/ref 17592186268211} {:answer/id #uuid "c665df5d-fbe5-5623-a2cb-61041b31a0bb" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186268212} {:answer/id #uuid "6110f076-89f2-5bd7-abb0-5a5a47722fc6" :answer/type {:db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡\\theta +1" :db/id #edb/ref 17592186268213} {:answer/id #uuid "540c98e9-0b2d-50b1-840e-8118fd23786e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186268214}] :answer-field/correct {:answer/id #uuid "540c98e9-0b2d-50b1-840e-8118fd23786e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186268214} :answer-field/id #uuid "e9177377-1284-5aed-9b7b-97c61ff8e622" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268209}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "428beb78-87fa-540f-8a27-37ee187505c5" :question/math-academy-id "q-142819" :question/problem "$\\frac{\\operatorname{tan}⁡\\theta +{tan}^{3}⁡\\theta }{\\operatorname{tan}⁡\\theta }=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta +{tan}^{3}⁡\\theta }{\\operatorname{tan}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta \\text{ }\\,(1+{tan}^{2}⁡\\theta )}{\\operatorname{tan}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\,{sec}^{2}⁡\\theta }{\\operatorname{tan}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{tan}⁡\\theta }{sec}^{2}⁡\\theta }{\\cancel{\\operatorname{tan}⁡\\theta }} \\\\  & ={sec}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta +{tan}^{3}⁡\\theta }{\\operatorname{tan}⁡\\theta }={sec}^{2}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186268215 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b10325-28bc-512b-91da-61bba4b94f92" :answer/type {:db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186268217} {:answer/id #uuid "7bc7729d-866c-59a6-9100-e03e468db228" :answer/type {:db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x+1" :db/id #edb/ref 17592186268218} {:answer/id #uuid "900fde3b-2d98-5197-973e-b26734803ad7" :answer/type {:db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x" :db/id #edb/ref 17592186268219} {:answer/id #uuid "45600786-4b0c-53fd-a4aa-8f706e823160" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268220} {:answer/id #uuid "0d886c4e-507a-561e-9ef4-ec6d71c49f74" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186268221}] :answer-field/correct {:answer/id #uuid "45b10325-28bc-512b-91da-61bba4b94f92" :answer/type {:db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186268217} :answer-field/id #uuid "f8561ce6-ebb4-55d2-8d6e-ddc8769eb29d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268216}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ffcd3c53-9ad9-5cd5-a88c-1c61894f9cb0" :question/math-academy-id "q-142822" :question/problem "${(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x & ={sec}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =1+{tan}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =2+{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=2+{tan}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186268222 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249ecc0c-e6cc-52f0-9aea-7e131ce62be7" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186268224} {:answer/id #uuid "1cf6a2ad-c65f-5ce0-96a4-063f2897053f" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186268225} {:answer/id #uuid "49b2a709-1544-5d5d-a228-e9f3de31c469" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268226} {:answer/id #uuid "da70392f-48e4-58ee-88e6-67e1