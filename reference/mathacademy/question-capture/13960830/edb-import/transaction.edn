⁡x\\cdot \\cancel{\\operatorname{tan}⁡x}}{\\cancel{\\operatorname{tan}⁡x}} \\\\  & =-\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=-\\operatorname{tan}⁡x.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-142839/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b"] :knowledge-point/questions ["q-142839"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142832/selection/ce9cff372b96fa31327889ccec965ce88e7780606d5dfbc937ddc4ed5e0084dc" :answer/id #uuid "7c9d283c-ae1e-5178-a934-13dea73e9e24" :answer/type :answer.type/math :answer/value "\\frac{4}{1+\\operatorname{tan}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-142832/selection/09393e280859d681b37d127510800fd75783bc974f90cb2d7d2225520334110a" :answer/id #uuid "db68038b-374f-5362-870a-2ba4081076e0" :answer/type :answer.type/math :answer/value "\\frac{2}{\\operatorname{tan}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-142832/selection/cbb68d365b543d0abba97bed71b8e6ad77d2b44ba34507ac7ba484a9caf5dbd0" :answer/id #uuid "eaa2ed37-afe2-5da2-bf93-c91905bdb852" :answer/type :answer.type/math :answer/value "\\frac{4}{\\operatorname{tan}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-142832/selection/afcd5ec9c3eddfad6f27635581fa52dc9efa0856e2f6b17f6944b914bbaa4e09" :answer/id #uuid "e728f264-4932-5a0f-9365-26b3ebb68f14" :answer/type :answer.type/math :answer/value "\\frac{2}{\\operatorname{tan}⁡x-1}" :db/ensure [:answer/validate]} {:db/id "q-142832/selection/c5357ce72417930297baaf49be4f0c4b596b0f8e8ada5ef29472d2a3e950ed26" :answer/id #uuid "abba1715-f5bb-5343-b514-1114c4c13370" :answer/type :answer.type/math :answer/value "\\frac{4}{1-\\operatorname{tan}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-142832/selection" :answer-field/id #uuid "2dd89473-9581-5def-bc29-3d46599d6831" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :