#{[{:db/id #edb/ref 17592186110213 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/id #uuid "3d64bc1e-3937-5e0d-b0f8-7dd06acd27ef" :question/math-academy-id "e-10052" :question/problem "Express $2\\tan x\\cdot(\\cot x+\\tan{x})$ in terms of $\\sec x$ only." :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+\\tan^2 x = \\sec^2{x}\n$$\n\nAlso, recall the following identity:\n\n$$\n\\cot x = \\dfrac{1}{\\tan x}\\quad\\Longrightarrow\\quad \\tan x\\cdot \\cot x = 1\n$$\n\nUsing the above identities, we can simplify our expression as follows:\n\n$$\n\\begin{aligned}\n2\\tan x \\cdot (\\cot x + \\tan x) &= 2\\tan x \\cdot \\cot x + 2\\tan^{2} x \\\\\n&= 2 \\cdot 1 + 2\\tan^{2} x \\\\\n&= 2(1 + \\tan^{2} x) \\\\\n&= 2\\sec^{2} x\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\tan x\\cdot(\\cot x+\\tan{x})= 2\\sec^2x\n$$"}] [{:db/id #edb/ref 17592186110214 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/id #uuid "c04610a2-f73f-57a9-b17b-da9b30a5e431" :question/math-academy-id "e-10053" :question/problem "Express $(1-\\sec x)(1+\\sec x)$ in terms of $\\tan x$ only." :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+\\tan^2 x = \\sec^2{x}\n$$\n\nFirst, we expand the parentheses using the difference of squares formula:\n\n$$\n(1-\\sec x)(1+\\sec x) = 1 - \\sec^2x\n$$\n\nThen, we rewrite the expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\n1 - \\sec^{2} x &= 1 - (1 + \\tan^{2} x) \\\\\n&= 1 - 1 - \\tan^{2} x \\\\\n&=-\\tan^{2} x\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(1-\\sec x)(1+\\sec x)= -\\tan^2 x\n$$"}] [{:db/id #edb/ref 17592186110368 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/id #uuid "b34736aa-e682-5ab3-85a0-dd86f49759f1" :question/math-academy-id "e-3143" :question/problem "Simplify the expression $\\dfrac{2\\sec^2 \\theta}{1+\\tan^2 \\theta}$." :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+\\tan^2 \\theta = \\sec^2{\\theta}\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\dfrac{2\\sec^2 \\theta}{\\color{blue}1+\\tan^2 \\theta} = \\dfrac{2\\sec^2 \\theta}{\\color{blue}\\sec^2 \\theta}\n$$\n\nWe now cancel the common factor of $\\sec^2 \\theta$ in the numerator and denominator and simplify the fraction:\n\n$$\n\\begin{aligned}\n\\frac{2\\sec^{2} θ}{\\sec^{2} θ} &= \\frac{2\\sec^{2} θ}{\\sec^{2} θ} \\\\\n&= \\frac{2 \\cdot 1}{1} \\\\\n&= 2\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac{2\\sec^2 \\theta}{1+\\tan^2 \\theta} = 2\n$$"}] [{:db/id #edb/ref 17592186111105 :knowledge-point/_questions [{:knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c12d622-b0b4-5d2e-9117-5740dac660cf" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186108726} {:answer/id #uuid "c2a33c5f-8478-51fa-b708-e4026d3f3603" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} θ" :db/id #edb/ref 17592186108727} {:answer/id #uuid "17dcea8a-933d-5640-a4e7-22b32d723989" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186108728} {:answer/id #uuid "60898e50-4d60-5c04-a505-9d01cb216d2d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186108729} {:answer/id #uuid "744758fe-9792-5ba2-82ad-893bc102d9c8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec θ" :db/id #edb/ref 17592186108730}] :answer-field/correct {:answer/id #uuid "17dcea8a-933d-5640-a4e7-22b32d723989" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186108728} :answer-field/id #uuid "bb72c19d-05aa-5bb8-80c9-71cf2af83e1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108725}] :question/id #uuid "a581c5d1-c937-510f-8cbd-8478ab152d79" :question/math-academy-id "q-43617" :question/problem "What is $\\frac{1 + \\tan^{2} θ}{\\sec^{2} θ}$?"}]}
