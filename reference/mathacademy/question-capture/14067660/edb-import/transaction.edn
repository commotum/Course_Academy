on/8eef07084ab1eefc548f0c543ad7ae5dd1bd5dda013da16284bc9164775c9581"] :db/ensure [:answer-field/validate]} {:db/id "q-49387" :question/id #uuid "e0f170b0-4582-5f75-be18-6c4138c9d5fe" :question/math-academy-id "q-49387" :question/problem "Given that $u=1+{x}^{2}$, which integral is equivalent to $\\int \\frac{{x}^{3}\\,\\text{d}x}{\\sqrt{1+{x}^{2}}}?$" :question/worked-solution "Since $u=1+{x}^{2}$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,x\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that\n${x}^{2}=u-1$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{3}\\,\\text{d}x}{\\sqrt{1+{x}^{2}}} & =\\int \\frac{1}{\\sqrt{1+{x}^{2}}}\\cdot {x}^{2}\\cdot x\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (u-1)\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int ({u}^{1/2}-{u}^{-1/2})\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49387/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-49387"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49528/selection/0eb1d51b72f8c5b83b562a645ef6b26f3a7de0573642457d79ccd241390c4ae9" :answer/id #uuid "65bfd6ea-0b3e-5e10-9cc9-182843c979db" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\int ({u}^{4/3}+{u}^{1/3})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49528/selection/60bc6e4f7f9368a1174d28866fc1da181652f842f1a1f8f7b8b9f80bb6a9f339" :answer/id #uuid "229f2080-8aaf-556f-81a5-94ca867e7036" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\int ({u}^{4/3}-{u}^{1/3})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49528/selection/e4967892e2f095a17270ddcf55a8704fe9ff99a793ad120d48705e3867d9a8a4" :answer/id #uuid "6243f96f-4df5-5398-8196-fcbe168c5382" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\int ({u}^{1/3}-u)\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49528/selection/93fe16111918a05b710f97d0305bd88eb73d965bb4858a682670054207b0f20d" :answer/id #uuid "c94b626c-93cf-5bb3-b581-9fba3b164f52" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\int ({u}^{4/3}+{u}^{1/3})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49528/selection/090ed15e232ab309a2545e725bee8eda1ebe68b001159a14246f501f1d09e1fb" :answer/id #uuid "705ccb68-65fd-52fc-b1a2-74265483e3d1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\int ({u}^{5/3}-{u}^{2/3})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49528/selection" :answer-field/id #uuid "0a9eead4-f9d9-5426-a6e2-a7c248be6a7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49528/selection/60bc6e4f7f9368a1174d28866fc1da181652f842f1a1f8f7b8b9f80bb6a9f339" :answer-field/choices ["q-49528/selection/0eb1d51b72f8c5b83b562a645ef6b26f3a7de0573642457d79ccd241390c4ae9" "q-49528/selection/60bc6e4f7f9368a1174d28866fc1da181652f842f1a1f8f7b8b9f80bb6a9f339" "q-49528/selection/e4967892e2f095a17270ddcf55a8704fe9ff99a793ad120d48705e3867d9a8a4" "q-49528/selection/93fe16111918a05b710f97d0305bd88eb73d965bb4858a682670054207b0f20d" "q-49528/selection/090ed15e232ab309a2545e725bee8eda1ebe68b001159a14246f501f1d09e1fb"] :db/ensure [:answer-field/validate]} {:db/id "q-49528" :question/id #uuid "4d81f389-41ec-5f00-a1bb-6a3968481248" :question/math-academy-id "q-49528" :question/problem "Given that $u=2x+1$, which integral is equivalent to $\\int x\\sqrt[3]{2x+1}\\,\\text{d}x?$" :question/worked-solution "Since $u=2x+1$, then we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\\end{aligned}\n$$\n\nWe also note that $x=\\frac{1}{2}(u-1).$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int x\\sqrt[3]{2x+1}\\,\\text{d}x & =\\int \\frac{1}{2}(u-1)(\\sqrt[3]{u})(\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{4}\\int (u-1)({u}^{1/3})\\text{d}u \\\\  & =\\frac{1}{4}\\int ({u}^{4/3}-{u}^{1/3})\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49528/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-49528"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49532/selection/e10b5ecfda3c358fee72b44de0845ff13bf600131545dc0055a35a58a033d322" :answer/id #uuid "8f4fd8cc-bc1a-5e7c-84be-1d5bff570af7" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49532/selection/bfd2e3d195f9990dac0f149c14ccc712982d77c1c8b2ffb27ce1695edd976faf" :answer/id #uuid "fb8ef75b-9146-5d22-bfb5-36301abeb54c" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49532/selection/9f6b62f07ae67f49982ccbe0e71507193a986d9015e753df38daace30d0b5f4a" :answer/id #uuid "9d53bd7d-8d8d-5500-a84b-db6450e024c6" :answer/type :answer.type/math :answer/value "\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49532/selection/9f4c58e8bbe26a63eded99e31f267e8c5ce32d430d33c74d0724836edd57fe4d" :answer/id #uuid "fe72603a-bfcc-59a1-9929-a74c73b6c4b8" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}(3-u)\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49532/selection/00f0829ab9bdae6a23adf1894040ca07eab678c0d920a12805415d42e8c53c44" :answer/id #uuid "d8bfa1f0-c6bf-572c-b5d4-a10f54b13f66" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{-1}^{0}(3-u)\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49532/selection" :answer-field/id #uuid "887609de-40da-522d-b071-ac5384d4543e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49532/selection/bfd2e3d195f9990dac0f149c14ccc712982d77c1c8b2ffb27ce1695edd976faf" :answer-field/choices ["q-49532/selection/e10b5ecfda3c358fee72b44de0845ff13bf600131545dc0055a35a58a033d322" "q-49532/selection/bfd2e3d195f9990dac0f149c14ccc712982d77c1c8b2ffb27ce1695edd976faf" "q-49532/selection/9f6b62f07ae67f49982ccbe0e71507193a986d9015e753df38daace30d0b5f4a" "q-49532/selection/9f4c58e8bbe26a63eded99e31f267e8c5ce32d430d33c74d0724836edd57fe4d" "q-49532/selection/00f0829ab9bdae6a23adf1894040ca07eab678c0d920a12805415d42e8c53c44"] :db/ensure [:answer-field/validate]} {:db/id "q-49532" :question/id #uuid "1acd046b-858c-598a-a588-48bb2b8b4ced" :question/math-academy-id "q-49532" :question/problem "Given that $u=3-2{x}^{2}$, which integral is equivalent to ${\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x?$" :question/worked-solution "Since $u=3-2{x}^{2}$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4x\\,⟹\\,-\\frac{\\text{d}u}{4}=x\\text{d}x.\n$$\n\nWe also note that ${x}^{2}=\\frac{1}{2}(3-u).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $3$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x & ={\\int }_{-1}^{0}{x}^{2}\\sqrt{3-2{x}^{2}}\\cdot x\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{2}(3-u)\\sqrt{u}\\cdot (-\\frac{\\text{d}u}{4}) \\\\  & =-\\frac{1}{8}{\\int }_{1}^{3}(3-u)\\sqrt{u}\\,\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-49532"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346390/field-1/4d6df88e186ac2d7dfc8b8e2c919235d387be4e187c30b28324e1ae4b236efd5" :answer/id #uuid "ea413bd0-d7be-575f-a7cc-dc613b121fac" :answer/type :answer.type/math :answer/value "\\frac{112}{15}" :db/ensure [:answer/validate]} {:db/id "q-346390/field-1" :answer-field/id #uuid "34ee8b24-d01f-51c6-813d-1c260eb1aed9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346390/field-1/4d6df88e186ac2d7dfc8b8e2c919235d387be4e187c30b28324e1ae4b236efd5" :answer-field/choices ["q-346390/field-1/4d6df88e186ac2d7dfc8b8e2c919235d387be4e187c30b28324e1ae4b236efd5"] :db/ensure [:answer-field/validate]} {:db/id "q-346390" :question/id #uuid "e04132cd-e0f7-51e6-9f06-0ac34088093a" :question/math-academy-id "q-346390" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1/2}^{3/2}4x\\sqrt{2x+1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u=2x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{2}(u-1).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1/2$ | $3/2$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $4$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1/2}^{3/2}4x\\sqrt{2x+1}\\,\\text{d}x & ={\\int }_{0}^{4}4\\cdot \\frac{1}{2}(u-1)\\cdot \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & ={\\int }_{0}^{4}({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & ={(\\frac{1}{(5/2)}{u}^{5/2}-\\frac{1}{(3/2)}{u}^{3/2})|}_{0}^{4} \\\\  & ={(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})|}_{0}^{4} \\\\  & =(\\frac{2}{5}\\cdot {4}^{5/2}-\\frac{2}{3}\\cdot {4}^{3/2})-(\\frac{2}{5}\\cdot {0}^{5/2}-\\frac{2}{3}\\cdot {0}^{3/2}) \\\\  & =\\frac{64}{5}-\\frac{16}{3} \\\\  & =\\frac{112}{15}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346390/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-346390"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346393/field-1/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer/id #uuid "8a108a6a-2d5b-55d3-91a7-c59edd458aec" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "q-346393/field-1" :answer-field/id #uuid "efc632ae-3d1d-55ba-ae41-4f93349beacb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346393/field-1/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a" :answer-field/choices ["q-346393/field-1/12b48b00f9c1ff14570ca66bc629787a88856efba1cda24cfb28da58c148801a"] :db/ensure [:answer-field/validate]} {:db/id "q-346393" :question/id #uuid "1f1d91cd-995d-5a83-baa8-2b6f13a85e97" :question/math-academy-id "q-346393" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{6}\\frac{3x+1}{\\sqrt{x+3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u=x+3.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-3.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $6$ |\n| --- | --- | --- |\n| **$u$** | $4$ | $9$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}\\frac{3x+1}{\\sqrt{x+3}}\\,\\text{d}x & ={\\int }_{4}^{9}\\frac{3(u-3)+1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{9}\\frac{3u-8}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{9}(3{u}^{1/2}-8{u}^{-1/2})\\,\\text{d}u \\\\  & ={(\\frac{3}{(3/2)}{u}^{3/2}-\\frac{8}{(1/2)}{u}^{1/2})|}_{4}^{9} \\\\  & ={(2{u}^{3/2}-16{u}^{1/2})|}_{4}^{9} \\\\  & =(2\\cdot {9}^{3/2}-16\\cdot {9}^{1/2})-(2\\cdot {4}^{3/2}-16\\cdot {4}^{1/2}) \\\\  & =(2\\cdot 27-16\\cdot 3)-(2\\cdot 8-16\\cdot 2) \\\\  & =(54-48)-(16-32) \\\\  & =6-(-16) \\\\  & =22\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346393/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-346393"] :db/ensure [:knowledge-point/validate]}]
