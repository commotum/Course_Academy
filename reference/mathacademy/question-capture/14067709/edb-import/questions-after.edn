0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=5.$ Therefore, the matrix represents a dilation with a scale factor of $5.$"}] [{:db/id #edb/ref 17592186339993 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "430df4a4-34a9-59e6-84cf-b79d9ffe5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186339995} {:answer/id #uuid "d5729c6c-d4b9-525a-adaa-683447d5ad12" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186355760}] :answer-field/correct {:answer/id #uuid "430df4a4-34a9-59e6-84cf-b79d9ffe5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186339995} :answer-field/id #uuid "657a3e51-9e57-5f43-ab81-d712ba8a8a8b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186339994} {:answer-field/choices [{:answer/id #uuid "9d71e758-f854-57c9-835b-cec2d5d5dd83" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339997}] :answer-field/correct {:answer/id #uuid "9d71e758-f854-57c9-835b-cec2d5d5dd83" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339997} :answer-field/id #uuid "b85e75e1-9e22-5fb6-82e5-6fa957b2fc9a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186339996} {:answer-field/choices [{:answer/id #uuid "8674b42a-ad67-5c70-9d5b-b60bab49aa1b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339999}] :answer-field/correct {:answer/id #uuid "8674b42a-ad67-5c70-9d5b-b60bab49aa1b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339999} :answer-field/id #uuid "ced36865-5123-5c0a-a0c1-ff0853107de9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186339998} {:answer-field/choices [{:answer/id #uuid "51bb3af5-9e13-5fb9-99b8-bf5b2cb06277" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186340001}] :answer-field/correct {:answer/id #uuid "51bb3af5-9e13-5fb9-99b8-bf5b2cb06277" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186340001} :answer-field/id #uuid "efcb9209-e8f0-5f5b-b0dd-08c5d815dcab" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186340000}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "146f2d83-686f-5f58-9e04-992ef6d10c3d" :question/math-academy-id "q-328218" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}4 \\\\ -7\\end{aligned}]$ and $T(v)=[\\begin{aligned}56 \\\\ -98\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}56 \\\\ -98\\end{aligned}] \\\\  & =14\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}] \\\\  & =14v\\end{aligned}\n$$\n\nSo we have $T(v)=14v,$ and so the linear transformation $T$ is a dilation with scale factor $k=14.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}14 & 0 \\\\ 0 & 14\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186355761 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "322897b3-c50d-5f65-a505-ff966228b9f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186355763}] :answer-field/correct {:answer/id #uuid "322897b3-c50d-5f65-a505-ff966228b9f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186355763} :answer-field/id #uuid "9ca17642-df95-5348-9786-1af88c156abb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355762} {:answer-field/choices [{:answer/id #uuid "9f165755-9fc6-5754-b41e-d81bad52353a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355765}] :answer-field/correct {:answer/id #uuid "9f165755-9fc6-5754-b41e-d81bad52353a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355765} :answer-field/id #uuid "fff3f68e-cdfd-5cd0-888b-6ba35b5d1b6e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355764} {:answer-field/choices [{:answer/id #uuid "a55c87ab-3c1b-54d6-ab9c-ad0c38d534de" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355767}] :answer-field/correct {:answer/id #uuid "a55c87ab-3c1b-54d6-ab9c-ad0c38d534de" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355767} :answer-field/id #uuid "0efe7f2d-725c-5a12-8227-53da391cf1a9" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355766} {:answer-field/choices [{:answer/id #uuid "8fac5fdc-a42d-5744-9194-31a76eaa203d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186355769}] :answer-field/correct {:answer/id #uuid "8fac5fdc-a42d-5744-9194-31a76eaa203d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186355769} :answer-field/id #uuid "2d316221-61f6-50e8-9d19-9c0ff91ec726" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186355768}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "523ef76a-97be-5fae-a5a2-7a0a3a7ab633" :question/math-academy-id "q-328230" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}8 \\\\ -12\\end{aligned}]$ and $T(v)=[\\begin{aligned}6 \\\\ -9\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}6 \\\\ -9\\end{aligned}] \\\\  & =\\frac{3}{4}\\cdot [\\begin{aligned}8 \\\\ -12\\end{aligned}] \\\\  & =\\frac{3}{4}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{3}{4}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{3}{4}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}\\frac{3}{4} & 0 \\\\ 0 & \\frac{3}{4}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186355770 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b683033-884b-5925-819a-bfee0040d10e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186355772} {:answer/id #uuid "70090d93-e409-5fd5-b9fd-2bda998fd643" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186355773} {:answer/id #uuid "5f61d629-a7fc-5268-9ad6-e4f07ea883f2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186355774} {:answer/id #uuid "eea1744b-c4c2-53ef-ac7b-79e9dc92ff07" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186355775} {:answer/id #uuid "c4988b6d-a4b3-5a35-8103-802acf31115b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186355776}] :answer-field/correct {:answer/id #uuid "70090d93-e409-5fd5-b9fd-2bda998fd643" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186355773} :answer-field/id #uuid "115d4aab-d7a6-544d-b0a6-f096ce173f14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355771}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "1040f4bd-3d1a-5f7b-8b2b-4c581d4ad345" :question/math-academy-id "q-78297" :question/problem "Which of the following represents a reflection across the $x$-axis?" :question/worked-solution "The correct answer is $T=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)"}] [{:db/id #edb/ref 17592186340026 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878d8b5a-332e-57b8-ad3f-4a150d6d1701" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340028} {:answer/id #uuid "a90a0b84-9f32-5dbe-a7ae-d285e9287e44" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340029} {:answer/id #uuid "a0599022-189a-5283-b4c2-f1dcc5c4c096" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186340030} {:answer/id #uuid "d5ed3328-c7a4-5bf3-8087-947b079fa46b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340031} {:answer/id #uuid "c76fcb16-1af1-5e77-a170-608a3f6fe97e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186340032}] :answer-field/correct {:answer/id #uuid "878d8b5a-332e-57b8-ad3f-4a150d6d1701" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186340028} :answer-field/id #uuid "4f6c406f-d5be-58bb-91fb-2f154d007181" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "184c771a-5e73-5330-965f-3d9f2f0e7498" :question/math-academy-id "q-78301" :question/problem "Which of the following represents a reflection in the line $y=x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)"}]}
