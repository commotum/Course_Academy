[{:db/id "q-12040/selection/b9932827c948eef4ae63653dcd0e1afa8c548e0c979a775b3a59e41976d8989d" :answer/id #uuid "9cbd7492-2708-5afc-8121-b5617ea2bff9" :answer/type :answer.type/text :answer/value "Reflection in the line $x=5$" :db/ensure [:answer/validate]} {:db/id "q-12040/selection/83351679bef40cdde3e69e55c2c6f08222a317ed82557f1e3ec0abdce5a513f4" :answer/id #uuid "0f5c87f4-1ddb-59e5-86c5-3591598f2838" :answer/type :answer.type/text :answer/value "Reflection across the $y$-axis" :db/ensure [:answer/validate]} {:db/id "q-12040/selection/354549e05d30f5acb6c9a5e876a1b220679b1daee3381277145bd16fe273c514" :answer/id #uuid "6ed2dd38-03e0-528c-9f1f-424edf1feaee" :answer/type :answer.type/text :answer/value "Reflection across the $x$-axis" :db/ensure [:answer/validate]} {:db/id "q-12040/selection/1daf9811a3eb3ba55f6c92e85700aaae66ddf1ce9bb41066584ad7720c7715be" :answer/id #uuid "db3ae9ef-8918-5283-af4d-ef35c64f9857" :answer/type :answer.type/text :answer/value "Dilation with scale factor $5$" :db/ensure [:answer/validate]} {:db/id "q-12040/selection/35e5590afff9e203c591316feb0af2faeb8b8c40f6a06bf0812b7e22c6307e58" :answer/id #uuid "ddad89c8-27de-5157-99e0-2e3eaaca74b7" :answer/type :answer.type/text :answer/value "Dilation with scale factor $\\frac{1}{5}$" :db/ensure [:answer/validate]} {:db/id "q-12040/selection" :answer-field/id #uuid "abf5e327-2fbf-5dd2-90a1-99f583250954" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12040/selection/1daf9811a3eb3ba55f6c92e85700aaae66ddf1ce9bb41066584ad7720c7715be" :answer-field/choices ["q-12040/selection/b9932827c948eef4ae63653dcd0e1afa8c548e0c979a775b3a59e41976d8989d" "q-12040/selection/83351679bef40cdde3e69e55c2c6f08222a317ed82557f1e3ec0abdce5a513f4" "q-12040/selection/354549e05d30f5acb6c9a5e876a1b220679b1daee3381277145bd16fe273c514" "q-12040/selection/1daf9811a3eb3ba55f6c92e85700aaae66ddf1ce9bb41066584ad7720c7715be" "q-12040/selection/35e5590afff9e203c591316feb0af2faeb8b8c40f6a06bf0812b7e22c6307e58"] :db/ensure [:answer-field/validate]} {:db/id "q-12040" :question/id #uuid "e0248467-d4d0-53ed-a76a-c05070c65759" :question/math-academy-id "q-12040" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=5.$ Therefore, the matrix represents a dilation with a scale factor of $5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12040/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-12040"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78297/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" :answer/id #uuid "9b683033-884b-5925-819a-bfee0040d10e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/selection/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" :answer/id #uuid "5f61d629-a7fc-5268-9ad6-e4f07ea883f2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" :answer/id #uuid "eea1744b-c4c2-53ef-ac7b-79e9dc92ff07" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/selection/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" :answer/id #uuid "c4988b6d-a4b3-5a35-8103-802acf31115b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" :answer/id #uuid "70090d93-e409-5fd5-b9fd-2bda998fd643" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/selection" :answer-field/id #uuid "115d4aab-d7a6-544d-b0a6-f096ce173f14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78297/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" :answer-field/choices ["q-78297/selection/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" "q-78297/selection/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" "q-78297/selection/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" "q-78297/selection/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" "q-78297/selection/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a"] :db/ensure [:answer-field/validate]} {:db/id "q-78297" :question/id #uuid "1040f4bd-3d1a-5f7b-8b2b-4c581d4ad345" :question/math-academy-id "q-78297" :question/problem "Which of the following represents a reflection across the $x$-axis?" :question/worked-solution "The correct answer is $T=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78297/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-78297"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-78301"] :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)" :db/ensure [:question/validate]} {:db/id "q-328218/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "d5729c6c-d4b9-525a-adaa-683447d5ad12" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186339994 :answer-field/choices ["q-328218/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-328230/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "322897b3-c50d-5f65-a505-ff966228b9f1" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-328230/field-1" :answer-field/id #uuid "9ca17642-df95-5348-9786-1af88c156abb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328230/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-328230/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-328230/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9f165755-9fc6-5754-b41e-d81bad52353a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328230/field-2" :answer-field/id #uuid "fff3f68e-cdfd-5cd0-888b-6ba35b5d1b6e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328230/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328230/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328230/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a55c87ab-3c1b-54d6-ab9c-ad0c38d534de" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328230/field-3" :answer-field/id #uuid "0efe7f2d-725c-5a12-8227-53da391cf1a9" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328230/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328230/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328230/field-4/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "8fac5fdc-a42d-5744-9194-31a76eaa203d" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-328230/field-4" :answer-field/id #uuid "2d316221-61f6-50e8-9d19-9c0ff91ec726" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328230/field-4/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-328230/field-4/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-328230" :question/id #uuid "523ef76a-97be-5fae-a5a2-7a0a3a7ab633" :question/math-academy-id "q-328230" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}8 \\\\ -12\\end{aligned}]$ and $T(v)=[\\begin{aligned}6 \\\\ -9\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}6 \\\\ -9\\end{aligned}] \\\\  & =\\frac{3}{4}\\cdot [\\begin{aligned}8 \\\\ -12\\end{aligned}] \\\\  & =\\frac{3}{4}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{3}{4}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{3}{4}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}\\frac{3}{4} & 0 \\\\ 0 & \\frac{3}{4}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328230/field-1" "q-328230/field-2" "q-328230/field-3" "q-328230/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508"] :knowledge-point/questions ["q-328230"] :db/ensure [:knowledge-point/validate]}]
