d/correct" "value" [:answer.type/math "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/state.json" "file_sha256" "be1605394f6301c1f49b70b30415b892576c782d3c9b37c2545b58a76bb881b5" "basis" 1942 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14060608/edb-import/verification.json"}] "sources" [{"question" "q-12040" "field" nil "attribute" "question/problem" "value" "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}]?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-12040" "field" nil "attribute" "question/worked-solution" "value" "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=5.$ Therefore, the matrix represents a dilation with a scale factor of $5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-12040" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/activity-metadata.json" "file_sha256" "66a4a2cd7a87fed0565d1e2c0c5138123ab823a63b162a625de9fcb3d7f73c34"} {"question" "q-12040" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-12040" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "Dilation with scale factor $5$"] ["text" "Dilation with scale factor $\\frac{1}{5}$"] ["text" "Reflection across the $x$-axis"] ["text" "Reflection across the $y$-axis"] ["text" "Reflection in the line $x=5$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-12040" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "Dilation with scale factor $5$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78297" "field" nil "attribute" "question/problem" "value" "Which of the following represents a reflection across the $x$-axis?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78297" "field" nil "attribute" "question/worked-solution" "value" "The correct answer is $T=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78297" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/activity-metadata.json" "file_sha256" "66a4a2cd7a87fed0565d1e2c0c5138123ab823a63b162a625de9fcb3d7f73c34"} {"question" "q-78297" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78297" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78297" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78301" "field" nil "attribute" "question/problem" "value" "Which of the following represents a reflection in the line $y=x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78301" "field" nil "attribute" "question/worked-solution" "value" "The correct answer is $T=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/assets/0e37a258ea833a2d490fc34a34af40a5c7a18f7589f107c6d0ed631b331c8f2a.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78301" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/activity-metadata.json" "file_sha256" "66a4a2cd7a87fed0565d1e2c0c5138123ab823a63b162a625de9fcb3d7f73c34"} {"question" "q-78301" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78301" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-78301" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-328218" "field" nil "attribute" "question/problem" "value" "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}4 \\\\ -7\\end{aligned}]$ and $T(v)=[\\begin{aligned}56 \\\\ -98\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-328218" "field" nil "attribute" "question/worked-solution" "value" "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}56 \\\\ -98\\end{aligned}] \\\\  & =14\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}] \\\\  & =14v\\end{aligned}\n$$\n\nSo we have $T(v)=14v,$ and so the linear transformation $T$ is a dilation with scale factor $k=14.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}14 & 0 \\\\ 0 & 14\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-328218" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/activity-metadata.json" "file_sha256" "66a4a2cd7a87fed0565d1e2c0c5138123ab823a63b162a625de9fcb3d7f73c34"} {"question" "q-328218" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-328218" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "14"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067709/state.json" "file_sha256" "32d3b2aaea45ef2c761901fa9d0371783468af5a81145aa14a60db30fef590af"} {"question" "q-328218" "field" "field-2" "attribute" "answer-field/type" "value" :ans