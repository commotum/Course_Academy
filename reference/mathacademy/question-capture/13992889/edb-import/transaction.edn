[{:db/id "q-8516/selection/ec65335feb095d837d456b0aa087c3a6459d8cb1a6cd28ae164f06172bdadda7" :answer/id #uuid "3b826ea6-45e9-552a-b2b7-23a0ced5e341" :answer/type :answer.type/math :answer/value "(4\\sqrt{3},4)" :db/ensure [:answer/validate]} {:db/id "q-8516/selection/4f619f4c61fe608a283179b39297b3297a2e2944e77f3a218d57a8678ec05929" :answer/id #uuid "78e6a573-db71-5e90-8d0a-e6056f1644cf" :answer/type :answer.type/math :answer/value "(-4\\sqrt{3},4\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-8516/selection/e4b9cef41ce01735dc4cdd38a00ddc2c446a6a65aa788f3ad187f3a5d0cfda9b" :answer/id #uuid "7d3977c5-026d-525f-8042-e8c6c91d0a14" :answer/type :answer.type/math :answer/value "(4\\sqrt{3},2\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-8516/selection/2306067b9924be79b2ff43edca82162b77a1bc2cfe344f4d6344c483f8547a57" :answer/id #uuid "812aa501-d3e7-5763-884c-db0c4c65df59" :answer/type :answer.type/math :answer/value "(-4\\sqrt{3},4)" :db/ensure [:answer/validate]} {:db/id "q-8516/selection/6cdd7172bf30bb682ad8a833f98149dce8a75efb311e57a23604341b6f38b6c7" :answer/id #uuid "396b65f5-3d69-5f33-ac9a-0ab05f39a611" :answer/type :answer.type/math :answer/value "(-4\\sqrt{3},8\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-8516/selection" :answer-field/id #uuid "8030794a-70c3-5af2-be4f-6b9e7f71dca7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8516/selection/2306067b9924be79b2ff43edca82162b77a1bc2cfe344f4d6344c483f8547a57" :answer-field/choices ["q-8516/selection/ec65335feb095d837d456b0aa087c3a6459d8cb1a6cd28ae164f06172bdadda7" "q-8516/selection/4f619f4c61fe608a283179b39297b3297a2e2944e77f3a218d57a8678ec05929" "q-8516/selection/e4b9cef41ce01735dc4cdd38a00ddc2c446a6a65aa788f3ad187f3a5d0cfda9b" "q-8516/selection/2306067b9924be79b2ff43edca82162b77a1bc2cfe344f4d6344c483f8547a57" "q-8516/selection/6cdd7172bf30bb682ad8a833f98149dce8a75efb311e57a23604341b6f38b6c7"] :db/ensure [:answer-field/validate]} {:db/id "q-8516" :question/id #uuid "b1322fc7-b8f4-5689-9d6d-6409e18f9414" :question/math-academy-id "q-8516" :question/problem "Given that the distance from a point $P$ to the origin is $8,$ and that $P$ makes an angle of ${150}^{∘}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=8,\\,\\theta ={150}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡({150}^{∘}) \\\\  & =8(-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡({150}^{∘}) \\\\  & =8\\cdot \\frac{1}{2} \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8516/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-8516"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81221/selection/fd888426dabe57d0818948abf5e2cd522afba7c6dc757c7715110181ec1888ec" :answer/id #uuid "dfd02eb7-b292-56d2-be2d-52df39170c74" :answer/type :answer.type/math :answer/value "(\\frac{5\\sqrt{2}}{2},\\frac{9}{2})" :db/ensure [:answer/validate]} {:db/id "q-81221/selection/9157701c003807c0ae1864708419f1ea7573768e7b28a921756b14d4ad2058a6" :answer/id #uuid "de88db37-e345-52db-a9e3-37d83f7c9daa" :answer/type :answer.type/math :answer/value "(\\frac{5}{2},\\frac{5\\sqrt{3}}{2})" :db/ensure [:answer/validate]} {:db/id "q-81221/selection/f82676c0ff660cfe4982c0934f1a1116190f912169df2688cd1c36e31306df62" :answer/id #uuid "e6d1f963-f4bb-5f7d-82e5-f765172178fc" :answer/type :answer.type/math :answer/value "(\\sqrt{3},4)" :db/ensure [:answer/validate]} {:db/id "q-81221/selection/870dfc07e02ed47581012f8ec3536652d2e78bcdd6d42368ac80feaa7c7c2bca" :answer/id #uuid "aee7ec98-539f-50ed-9772-35b9763ab5b1" :answer/type :answer.type/math :answer/value "(2\\sqrt{2},\\frac{9}{2})" :db/ensure [:answer/validate]} {:db/id "q-81221/selection/d57f88c16b35541ce6d361513686404e7ac0cb23188b1b90ed067605618b721b" :answer/id #uuid "b6ca44c3-e6fa-5a8f-8dc0-39c39c56afd2" :answer/type :answer.type/math :answer/value "(2\\sqrt{2},4)" :db/ensure [:answer/validate]} {:db/id "q-81221/selection" :answer-field/id #uuid "ce918a06-7490-5890-8c94-068cb3ba806a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81221/selection/9157701c003807c0ae1864708419f1ea7573768e7b28a921756b14d4ad2058a6" :answer-field/choices ["q-81221/selection/fd888426dabe57d0818948abf5e2cd522afba7c6dc757c7715110181ec1888ec" "q-81221/selection/9157701c003807c0ae1864708419f1ea7573768e7b28a921756b14d4ad2058a6" "q-81221/selection/f82676c0ff660cfe4982c0934f1a1116190f912169df2688cd1c36e31306df62" "q-81221/selection/870dfc07e02ed47581012f8ec3536652d2e78bcdd6d42368ac80feaa7c7c2bca" "q-81221/selection/d57f88c16b35541ce6d361513686404e7ac0cb23188b1b90ed067605618b721b"] :db/ensure [:answer-field/validate]} {:db/id "q-81221" :question/id #uuid "8d971046-62ac-5734-9c96-a4f6e7240242" :question/math-academy-id "q-81221" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13992889/assets/6e9d2238ca77532c3adda8d35f94061d108c3e15432ce48fdc33885ddf4f4e48.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(5,\\frac{7\\pi }{6})$ and $m∠AOB=\\frac{5\\pi }{6},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(5,\\frac{7\\pi }{6}),$ we must have $r=5.$ Also, since the points $A$ and $B$ both lie on a circle of radius $5,$ the $r$-coordinate of $B$ must also be $5.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{7\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{7\\pi }{6}-\\frac{5\\pi }{6}=\\frac{\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(5,\\frac{\\pi }{3})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =5\\cdot \\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =5\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{5\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\frac{5}{2},\\frac{5\\sqrt{3}}{2}).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81221/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529"] :knowledge-point/questions ["q-81221"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120455/selection/2b60a9fd6df2176f7c22b27dc232834a5a01974f63f4bcbe52f975728a0851d1" :answer/id #uuid "45505d89-0cc4-58f4-8a2e-12498ffa153f" :answer/type :answer.type/math :answer/value "(-\\sqrt{3},-2\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-120455/selection/301c665fa5b08e4f53cf051876c0ac4f2c0f2374e44a4977c5df175189b9a3bd" :answer/id #uuid "ca145c2d-4ef1-5ee2-a403-9a86d3f273e0" :answer/type :answer.type/math :answer/value "(4\\sqrt{3},-\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-120455/selection/85a5c3126ab6394d2732296e3e5736a373c4fdb4ef9ff3e819d498d9d0bd7bd6" :answer/id #uuid "dab4f8ba-d324-5153-bb01-49a224bdc7ac" :answer/type :answer.type/math :answer/value "(\\sqrt{3},-6)" :db/ensure [:answer/validate]} {:db/id "q-120455/selection/4092a64dadcd1770c4bc5f03e2ceec00e1a618883566c5562060b32a9c8b254e" :answer/id #uuid "d7945e89-ed31-5bfd-a9e1-3155d34ae6f5" :answer/type :answer.type/math :answer/value "(6,-6)" :db/ensure [:answer/validate]} {:db/id "q-120455/selection/042d040aa2cc36d7d7c58cea1f8f0b87a7bc06033bbc5d06076ce02ff099d99d" :answer/id #uuid "daff37a1-2f5c-5887-ae8d-cf0b681a0dc1" :answer/type :answer.type/math :answer/value "(6\\sqrt{3},-6)" :db/ensure [:answer/validate]} {:db/id "q-120455/selection" :answer-field/id #uuid "7078df4c-a5e7-5da2-8534-148b74222cd4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120455/selection/042d040aa2cc36d7d7c58cea1f8f0b87a7bc06033bbc5d06076ce02ff099d99d" :answer-field/choices ["q-120455/selection/2b60a9fd6df2176f7c22b27dc232834a5a01974f63f4bcbe52f975728a0851d1" "q-120455/selection/301c665fa5b08e4f53cf051876c0ac4f2c0f2374e44a4977c5df175189b9a3bd" "q-120455/selection/85a5c3126ab6394d2732296e3e5736a373c4fdb4ef9ff3e819d498d9d0bd7bd6" "q-120455/selection/4092a64dadcd1770c4bc5f03e2ceec00e1a618883566c5562060b32a9c8b254e" "q-120455/selection/042d040aa2cc36d7d7c58cea1f8f0b87a7bc06033bbc5d06076ce02ff099d99d"] :db/ensure [:answer-field/validate]} {:db/id "q-120455" :question/id #uuid "31c6b35f-5eb7-5133-a456-1d279c62cfea" :question/math-academy-id "q-120455" :question/problem "The point $A$ has polar coordinates $(r,\\frac{5\\pi }{6})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{11\\pi }{6}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-3,\\sqrt{3}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{12}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{12})^{2},\\frac{11\\pi }{6})=(12,\\frac{11\\pi }{6}).\n$$\n\n \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =12(\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =12(-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(6\\sqrt{3},-6).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120455/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb"] :knowledge-point/questions ["q-120455"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120593/selection/113e246b47b3c3c13d03f6490d7005bcc4faacd7561888518b94476c0851dc23" :answer/id #uuid "4a524a8c-7ee7-55cc-92fd-0b819388ab8f" :answer/type :answer.type/math :answer/value "(-3\\sqrt{2},3)" :db/ensure [:answer/validate]} {:db/id "q-120593/selection/c0b52b408c35f15482d5042401f3645ec1799e206e9a05f23661ebe2d0daac50" :answer/id #uuid "a4fc519b-70d3-514b-8e5a-0d5ae4809238" :answer/type :answer.type/math :answer/value "(-3,3)" :db/ensure [:answer/validate]} {:db/id "q-120593/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" :answer/id #uuid "27bd01d9-8487-59b2-9635-63742d849960" :answer/type :answer.type/math :answer/value "(-3,3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-120593/selection/3b17f3108fe4a0950de93b03b0f459e0116ff3fc06fe9a8ea94afd45efdc87fd" :answer/id #uuid "e51a9886-5eed-566c-8638-f03de94df6da" :answer/type :answer.type/math :answer/value "(\\sqrt{2},3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-120593/selection/8caf6bc367f6be4dc0e3d763b835848de8e99a5775eb41d8119b392fa985db42" :answer/id #uuid "2da9f761-0ea0-51e8-a346-09b0ba2c0006" :answer/type :answer.type/math :answer/value "(-3\\sqrt{2},\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-120593/selection" :answer-field/id #uuid "dacd2989-d6d4-573c-bcbf-17b088f5c451" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120593/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" :answer-field/choices ["q-120593/selection/113e246b47b3c3c13d03f6490d7005bcc4faacd7561888518b94476c0851dc23" "q-120593/selection/c0b52b408c35f15482d5042401f3645ec1799e206e9a05f23661ebe2d0daac50" "q-120593/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" "q-120593/selection/3b17f3108fe4a0950de93b03b0f459e0116ff3fc06fe9a8ea94afd45efdc87fd" "q-120593/selection/8caf6bc367f6be4dc0e3d763b835848de8e99a5775eb41d8119b392fa985db42"] :db/ensure [:answer-field/validate]} {:db/id "q-120593" :question/id #uuid "365fb499-a14f-5af1-930c-600fea6dbc7f" :question/math-academy-id "q-120593" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13992889/assets/48517c5d3fa340bed1cc7b5493f0099a72afa79d9e0690b79695afe018c8a05c.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(6,\\frac{\\pi }{6})$ and $m∠AOB=\\frac{\\pi }{2},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(6,\\frac{\\pi }{6}),$ we must have $r=6.$ Also, since the points $A$ and $B$ both lie on a circle of radius $6,$ the $r$-coordinate of $B$ must also be $6.$ \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{\\pi }{6}+\\frac{\\pi }{2}=\\frac{2\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(6,\\frac{2\\pi }{3})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6(-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6(\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-3,3\\sqrt{3}).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120593/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529"] :knowledge-point/questions ["q-120593"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276798/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer/id #uuid "b565b9f3-ad0e-5fdd-b1ff-f24ceb8dc903" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-276798/field-1" :answer-field/id #uuid "a57caf9e-0c40-5ca5-afb7-1f65c65eee62" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276798/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer-field/choices ["q-276798/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f"] :db/ensure [:answer-field/validate]} {:db/id "q-276798/field-2/ff6f8f91cd305eae076cf9f7836fcc06a126a979b161893ea3dcca5881985734" :answer/id #uuid "9eb4487c-db08-5301-b250-ac5bf957eae4" :answer/type :answer.type/math :answer/value "-\\frac{3\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-276798/field-2" :answer-field/id #uuid "a01b9d36-4744-5669-b547-ba3222bad5f0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276798/field-2/ff6f8f91cd305eae076cf9f7836fcc06a126a979b161893ea3dcca5881985734" :answer-field/choices ["q-276798/field-2/ff6f8f91cd305eae076cf9f7836fcc06a126a979b161893ea3dcca5881985734"] :db/ensure [:answer-field/validate]} {:db/id "q-276798" :question/id #uuid "06e9b16e-32d6-5484-ba19-7d06d175fd17" :question/math-academy-id "q-276798" :question/problem "If the distance from a point $P$ to the origin is $3,$ and that $P$ makes an angle of ${240}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=3,\\,\\theta ={240}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\cdot \\operatorname{cos}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\cdot \\operatorname{sin}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{3}{2},-\\frac{3\\sqrt{3}}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-276798/field-1" "q-276798/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-276798"] :db/ensure [:knowledge-point/validate]}]
