/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039348/edb-import/verification.json"} {"question" "q-69893" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{{x}^{2}}{5}+\\frac{{y}^{2}}{2}=1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039348/state.json" "file_sha256" "884e335fad258d025012e3b66dfb5b90a71715a7cb3c08c2cdd50d2f0eb98414" "basis" 1360 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039348/edb-import/verification.json"}] "sources" [{"question" "q-7598" "field" nil "attribute" "question/problem" "value" "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}=1?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-7598" "field" nil "attribute" "question/worked-solution" "value" "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=4$ and ${b}^{2}=16.$\n\n- Since ${a}^{2}=4,$ the length of the horizontal radius must be $a=\\sqrt{4}=2.$\n\n- Since ${b}^{2}=16,$ the length of the vertical radius must be $b=\\sqrt{16}=4.$\n\nSo the semi-major axis has length $b=4,$ and the semi-minor axis has length $a=2.$\n\nTherefore, the major axis has length $2b=2\\cdot 4=8,$ and the minor axis has length $2a=2\\cdot 2=4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-7598" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/activity-metadata.json" "file_sha256" "a73a02e030dd982ecacab1b39d926a10b35c86348fefd1d32a05dadca49f4a18"} {"question" "q-7598" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-7598" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$4$ and $2$"] ["text" "$6$ and $2$"] ["text" "$6$ and $4$"] ["text" "$8$ and $2$"] ["text" "$8$ and $4$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-7598" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$8$ and $4$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-69893" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/assets/be8468d84e3820bd1e9181d31aa3a1b7d1a85c743020a69cb67fc3f601a88363.png)\n\nWhat is the equation of the ellipse given above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-69893" "field" nil "attribute" "question/worked-solution" "value" "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-69893" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/activity-metadata.json" "file_sha256" "a73a02e030dd982ecacab1b39d926a10b35c86348fefd1d32a05dadca49f4a18"} {"question" "q-69893" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-69893" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{4}=1"] ["math" "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{5}=1"] ["math" "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{10}=1"] ["math" "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1"] ["math" "\\frac{{x}^{2}}{5}+\\frac{{y}^{2}}{2}=1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041013/state.json" "file_sha256" "e178569f40b724efaa1d176b0cc8d8c5332c15057f2bab31501980dffe633e1d"} {"question" "q-69893" "field" "selection" "a