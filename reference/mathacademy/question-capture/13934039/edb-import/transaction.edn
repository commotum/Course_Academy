ac{3\\pi }{2}$ is a vertical asymptote.\n\n- Statement III is true. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=-2$ belongs to the range." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42886/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9"] :knowledge-point/questions ["q-42886"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65332/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "2e023378-0111-5d57-b1ca-5fcf705a2ad2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-65332/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "bfdceccd-ab1c-51df-8e1a-7b54ad56f145" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-65332/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "12e6da9f-695a-5581-ac67-281ace2ef108" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-65332/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "5d29c688-3596-54f8-9526-d78739e28b00" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-65332/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "9e5e06fd-8337-58ea-a2f2-248a46a33067" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-65332/selection" :answer-field/id #uuid "ff1fe016-e077-5886-a3da-8039c1b98073" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65332/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-65332/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-65332/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-65332/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-65332/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-65332/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-65332" :question/id #uuid "3d652f1a-c6ee-5796-966d-faf889bb3033" :question/math-academy-id "q-65332" :question/is-example false :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- $x=-\\pi $ is not in the domain of the function. $$\n- $y=-\\frac{1}{3}$ is in the range of the function. $$\n- $x=-\\frac{3\\pi }{2}$ is a vertical asymptote." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934039/assets/da729794a0331383debd75be0a4ce4a9f2d4da3286f50bd4f284868996077412.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function is defined for all real numbers except the values $\\frac{\\pi }{2}+n\\pi $ for any integer $n,$ thus it is defined for $x=-\\pi .$\n\n- Statement II is false. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=-\\frac{1}{3}$ is not in the range.\n\n- Statement III is true. The function $y=sec⁡x$ has vertical asymptotes at $x=\\frac{\\pi }{2}+n\\pi $, thus $x=-\\frac{3\\pi }{2}$ is a vertical asymptote." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65332/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9"] :knowledge-point/questions ["q-65332"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47455/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "12927978-9de8-52f7-9e4f-e98160711f30" :answer/type :answer.type/text :ans