d/validate]} {:db/id "q-103691" :question/id #uuid "b2f84c41-54d9-5d26-a43f-85f7af5ae1ae" :question/math-academy-id "q-103691" :question/is-example false :question/problem "If $sec⁡x=3\\sqrt{3},$ then what is $sec⁡(x+8\\pi )?$" :question/worked-solution "The period of $y=sec⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\nsec⁡x=sec⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=4$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}sec⁡x=sec⁡(x+2\\cdot 4\\cdot \\pi )=sec⁡(x+8\\pi ).\\end{aligned}\n$$\n\nTherefore, if $sec⁡x=3\\sqrt{3},$ then $sec⁡(x+8\\pi )=3\\sqrt{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103691/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce45704e-ecea-5c67-bb40-a413f8a0d72e"] :knowledge-point/questions ["q-103691"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66603/selection/a677fbafac7a5bed60e17e64dd5b782d3724f5b1a7b1066327ab81936bfe900c" :answer/id #uuid "0b80670f-8770-511c-84fb-36014be689b6" :answer/type :answer.type/math :answer/value "\\frac{5}{2}+2\\pi " :db/ensure [:answer/validate]} {:db/id "q-66603/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "877c11cb-6c36-5e95-a988-a3719269b3a8" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-66603/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "020a7fbe-db44-55b7-bd1d-768a0b7028be" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-66603/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "c2e319ff-1dd3-5bb0-b05e-73e84acea4d0" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-66603/selection/d4a22aed69ccaac0732ea6ccd67e782dbdb55eb818c0e13d739504088f5ccc9b" :answer/id #uuid "c4ccddf1-e435-5117-9f3c-1b90ed6b9caf" :answer/type :answer.type/math :answer/value "4+\\pi " :db/ensure [:answer/validate]} {:db/id "q-66603/selection" :answer-field/id #uuid "f1e11de8-930a-56cb-ae6f-ffeb1b84a08e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66603/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-66603/selection/a677fbafac7a5bed60e17e64dd5b782d3724f5b1a7b1066327ab81936bfe900c" "q-66603/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-66603/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-66603/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-66603/selection/d4a22aed69ccaac0732ea6ccd67e782dbdb55eb818c0e13d739504088f5ccc9b"] :db/ensure [:answer-field/validate]} {:db/id "q-66603" :question/id #uuid "95e491e4-b856-5f9d-a26b-b1ed227422f5" :question/math-academy-id "q-66603" :question/is-example false :question/problem "If $sec⁡x=\\frac{5}{2},$ then what is $4sec⁡(x+10\\pi )-3?$" :question/worked-solution "The period of $y=sec⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\nsec⁡x=sec⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}sec⁡x=sec⁡(x+2\\cdot 5\\cdot \\pi )=sec⁡(x+10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $sec⁡x=\\frac{5}{2},$ then $sec⁡(x+10\\pi )=\\frac{5}{2}.$\n\nFinally, then\n\n$$\n\\begin{aligned}4sec⁡(x+10\\pi )-3 & =4(\\frac{5}{2})-3 \\\\  & =2(5)-3 \\\\  & =10-3 \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66603/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce45704e-ecea-5c67-bb40-a413f8a0d72e"] :knowledge-point/questions ["q-66603"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103692/selection/7346ebe1e5d722acf040262ae8e6e53d26ca80a32da08982328df7eef98b7372" :answer/id #uuid "fd7ec9b0-8a3b-5cc9-9199-27dd41d9d39d" :answer/type :answer.type/math :ans