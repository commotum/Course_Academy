ssets/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136631/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e"] :knowledge-point/questions ["q-136631"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136623/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "397a5f44-99dc-59c0-af23-7707e8949dad" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-136623/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "a123e890-17d8-59e5-96b1-fc04d8f43471" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-136623/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "657f3603-5fea-59bc-8743-f4a678b78d00" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-136623/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "750dfcdd-2a17-51e2-9e7f-6fb3bf9ce64d" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-136623/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "a3e02c92-e3c0-5414-a2bf-ea36ca5900d8" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-136623/selection" :answer-field/id #uuid "f9882397-8495-5e27-a125-069a29b3baf0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136623/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer-field/choices ["q-136623/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-136623/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-136623/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-136623/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-136623/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3"] :db/ensure [:answer-field/validate]} {:db/id "q-136623" :question/id #uuid "ae3cb1bd-2bc1-5766-9ec9-742fa9428ab0" :question/math-academy-id "q-136623" :question/is-example false :question/problem "If $sec⁡x=-2,$ then $5sec⁡(-x+12\\pi )+1=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934039/assets/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $sec⁡x$ is $2\\pi .$\n\n- Our graph is symmetric about the $y$-axis. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $sec⁡x,$ we have\n\n$$\n\\begin{aligned}sec⁡(-x+12\\pi ) & =sec⁡(-x+2\\pi \\cdot 6) \\\\  & =sec⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $sec⁡x,$ we have\n\n$$\n\\begin{aligned}sec⁡(-x) & =sec⁡x \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5sec⁡(-x+12\\pi )+1 & =5\\cdot (-2)+1 \\\\  & =-10+1 \\\\  & =-9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-136623/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e"] :knowledge-point/questions ["q-136623"] :db/ensure [:knowledge-point/validate]}]
