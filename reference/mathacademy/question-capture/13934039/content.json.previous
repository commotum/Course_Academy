  "questions": [
    {
      "math_academy_id": "q-42853",
      "knowledge_point_id": "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9",
      "knowledge_point": "Describing Properties of the Secant Function",
      "problem": "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- $x=\\frac{3\\pi }{2}$ is in the domain.\n- $x=\\pi $ is a root. $$\n- $y=\\frac{1}{2}$ is not in the range of the function.",
      "worked_solution": "Let's plot the graph of $y=sec⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934039/assets/da729794a0331383debd75be0a4ce4a9f2d4da3286f50bd4f284868996077412.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function is defined for all real numbers except the values $\\frac{\\pi }{2}+n\\pi $ for any integer $n,$ thus it is not defined for $x=\\frac{3\\pi }{2}.$\n\n- Statement II is false. The function has no zeros.\n\n- Statement III is true. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=\\frac{1}{2}$ does not belong to the range.",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "type": "text",
              "value": "III only"
            },
            {
              "type": "text",
              "value": "I and II only"
            },
            {
              "type": "text",
              "value": "None"
            },
            {
              "type": "text",
              "value": "II and III only"
            },
            {
              "type": "text",
              "value": "II only"
            }
          ],
          "correct_value": "III only"
        }
      ],
      "difficulty": "moderate",
      "provenance": {
        "activity_question": "question-42853",
        "kp_title": "Describing Properties of the Secant Function",
        "kp_href": null
      }
