[{:db/id "q-77471/selection/6f9db83dba8705e43bd44882bdefdd7c7d8a0378c02c59a0bd482ca3e9a37baa" :answer/id #uuid "72b5d8a0-b53c-5798-9cdd-264de35c564a" :answer/type :answer.type/math :answer/value "pq-1" :db/ensure [:answer/validate]} {:db/id "q-77471/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d585aefb-b3d1-5c9e-b5d0-372d881ac583" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-77471/selection/3cbd134247e79d7e8c3d00a835581bd7e10cc0b7ade502a1cb141391dd011b18" :answer/id #uuid "10b492e3-d7de-5ca3-a98d-0a69da84abf8" :answer/type :answer.type/math :answer/value "2pq" :db/ensure [:answer/validate]} {:db/id "q-77471/selection/5fa5887ba95b3fbcdb700184cea7d1928eaeb58920e8c8ad638110eb2b01665f" :answer/id #uuid "c67a7291-905f-5f3f-9726-285cd425afd4" :answer/type :answer.type/math :answer/value "p-q" :db/ensure [:answer/validate]} {:db/id "q-77471/selection/128bdb85220724ef3ebb016ef0c31c579460c2f3d3cfa6d8c4ccfcbe49aef0a2" :answer/id #uuid "2fdcba7f-bb28-52a9-b424-602659009d5c" :answer/type :answer.type/math :answer/value "q-p" :db/ensure [:answer/validate]} {:db/id "q-77471/selection" :answer-field/id #uuid "25417d09-1503-5cfe-88dc-64309d1b6e69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77471/selection/3cbd134247e79d7e8c3d00a835581bd7e10cc0b7ade502a1cb141391dd011b18" :answer-field/choices ["q-77471/selection/6f9db83dba8705e43bd44882bdefdd7c7d8a0378c02c59a0bd482ca3e9a37baa" "q-77471/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-77471/selection/3cbd134247e79d7e8c3d00a835581bd7e10cc0b7ade502a1cb141391dd011b18" "q-77471/selection/5fa5887ba95b3fbcdb700184cea7d1928eaeb58920e8c8ad638110eb2b01665f" "q-77471/selection/128bdb85220724ef3ebb016ef0c31c579460c2f3d3cfa6d8c4ccfcbe49aef0a2"] :db/ensure [:answer-field/validate]} {:db/id "q-77471" :question/id #uuid "dd7509ff-1fe8-581a-b2d2-d01fdb008e24" :question/math-academy-id "q-77471" :question/problem "What is the minor of ${k}_{22}$ in the matrix\n$K=[\\begin{aligned}p & p & -p \\\\ -q & q & q \\\\ q & -2 & q\\end{aligned}]?$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nK=[\\begin{aligned}p & ∗ & -p \\\\ ∗ & q & ∗ \\\\ q & ∗ & q\\end{aligned}]\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}p & -p \\\\ q & q\\end{aligned}] & =|\\begin{aligned}p & -p \\\\ q & q\\end{aligned}| \\\\  & =p\\cdot p-q\\cdot (-p) \\\\  & =pq+pq \\\\  & =2pq\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77471/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-77471"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332175/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "10692e21-def1-58d9-82d7-41df447ada3d" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332175/field-1" :answer-field/id #uuid "57d18ad5-433f-50c0-afb7-21df4c1a2a0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332175/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer-field/choices ["q-332175/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744"] :db/ensure [:answer-field/validate]} {:db/id "q-332175/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "e2326f7f-0b72-5413-ab31-73bd5817bdef" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332175/field-2" :answer-field/id #uuid "a52966d4-1d56-5452-9e0d-b3caebfa598f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332175/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-332175/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-332175" :question/id #uuid "a4183e51-f524-53bb-8633-07760d485b70" :question/math-academy-id "q-332175" :question/problem "Express $\\operatorname{sin}⁡(x-{210}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{210}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{210}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{210}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332175/field-1" "q-332175/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4"] :knowledge-point/questions ["q-332175"] :db/ensure [:knowledge-point/validate]} {:db/id "q-54161/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "d675e7f3-aa07-5682-8bc4-59c11d3f33cd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-54161/selection/f8c9313511a22623b27e22dd02975276bfcea5cd809b7d7428d12805ee7d39f9" :answer/id #uuid "05d366fd-013c-57c5-8082-657ed79f8810" :answer/type :answer.type/math :answer/value "60{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-54161/selection/555fe95d4aec08b3e983df992fd4cec3468c32bd3163bd59607cc56f7e417474" :answer/id #uuid "1d2691ce-419a-5d26-a515-b4a89c3c41fd" :answer/type :answer.type/math :answer/value "15t" :db/ensure [:answer/validate]} {:db/id "q-54161/selection/e2f2fce187e72126c0533eda37425d3d7bda4f03a586b0e102e8b105c9285c18" :answer/id #uuid "c554f7c6-d4c4-5196-a09f-ed97a73c9e81" :answer/type :answer.type/math :answer/value "\\frac{5}{t}" :db/ensure [:answer/validate]} {:db/id "q-54161/selection/b89181f6c0e3487e2d976224e08a4bc1583d99201619977415027ef65e9b3720" :answer/id #uuid "b86cd693-b2f5-513d-8c07-ad4ad5e389ad" :answer/type :answer.type/math :answer/value "\\frac{1}{15t}" :db/ensure [:answer/validate]} {:db/id "q-54161/selection" :answer-field/id #uuid "7c8482ab-5b8e-5338-b0b8-f6e49c1b7e77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-54161/selection/555fe95d4aec08b3e983df992fd4cec3468c32bd3163bd59607cc56f7e417474" :answer-field/choices ["q-54161/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-54161/selection/f8c9313511a22623b27e22dd02975276bfcea5cd809b7d7428d12805ee7d39f9" "q-54161/selection/555fe95d4aec08b3e983df992fd4cec3468c32bd3163bd59607cc56f7e417474" "q-54161/selection/e2f2fce187e72126c0533eda37425d3d7bda4f03a586b0e102e8b105c9285c18" "q-54161/selection/b89181f6c0e3487e2d976224e08a4bc1583d99201619977415027ef65e9b3720"] :db/ensure [:answer-field/validate]} {:db/id "q-54161" :question/id #uuid "fb260a57-62db-5317-884e-db3ce39bc673" :question/math-academy-id "q-54161" :question/problem "A curve is defined by the parametric equations $x={t}^{2}-1,\\,y=4{t}^{5}+1$ where $t$ is a real number. Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2t,\\,{y}^{′}(t)=20{t}^{4}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{20{t}^{4}}{2t}=10{t}^{3}.\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(10{t}^{3})}{2t} \\\\  & =\\frac{30{t}^{2}}{2t} \\\\  & =15t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-54161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1"] :knowledge-point/questions ["q-54161"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-48696"] :question/problem "The population $p$, in millions, of a particular colony of bacteria after $t$ days can be modeled by the function $p(t)=\\frac{{2}^{{t}^{2}+1}}{\\operatorname{ln}⁡2}.$ What is the instantaneous rate of change of the bacteria population as a function of $t?$" :question/worked-solution "The instantaneous rate of change of the bacteria population is equal to ${p}^{′}(t).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{p}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{2}^{{t}^{2}+1}}{\\operatorname{ln}⁡2}) \\\\  & =\\frac{{2}^{{t}^{2}+1}\\cdot (2t)\\cdot \\operatorname{ln}⁡2}{\\operatorname{ln}⁡2} \\\\  & =2t\\cdot {2}^{{t}^{2}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-40178/selection/1925c79f109bd958b319f47447236ae06bcae092e30daa7b1e253443b3ca67ca" :answer/id #uuid "9e7d75ec-b6e8-5935-8161-cef7ff455977" :answer/type :answer.type/math :answer/value "6\\,144" :db/ensure [:answer/validate]} {:db/id "q-40178/selection/58b89175b1ee6a2bc07d58c95510b254c2e0f94d3ccdbb34b3325ef0dcde7a2e" :answer/id #uuid "66289b0e-3bc4-5cf9-a7af-30d98407fbf4" :answer/type :answer.type/math :answer/value "2\\,048" :db/ensure [:answer/validate]} {:db/id "q-40178/selection/ca586105846448ac1699334550a0524d222d9427262045b50db275ff6439e66d" :answer/id #uuid "a5bf168e-09f1-53ca-9703-3c0cd88098f7" :answer/type :answer.type/math :answer/value "3\\,072" :db/ensure [:answer/validate]} {:db/id "q-40178/selection/e1337f4aed674541ef366d41557e8888cb81c3be51fb1fa67574e9c9f7d0819b" :answer/id #uuid "464bf8ba-856d-5217-acc8-9f5419529fba" :answer/type :answer.type/math :answer/value "4\\,364" :db/ensure [:answer/validate]} {:db/id "q-40178/selection/71bc96fe6fc80605dc170caa65f64a0c698449a11b0d745ff529eb8c7949e655" :answer/id #uuid "7ef8a7c3-11dd-559d-8f3c-9984fba7e000" :answer/type :answer.type/math :answer/value "1\\,024" :db/ensure [:answer/validate]} {:db/id "q-40178/selection" :answer-field/id #uuid "ff1ac375-bbc8-5535-9f4c-59e4dde8a361" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40178/selection/58b89175b1ee6a2bc07d58c95510b254c2e0f94d3ccdbb34b3325ef0dcde7a2e" :answer-field/choices ["q-40178/selection/1925c79f109bd958b319f47447236ae06bcae092e30daa7b1e253443b3ca67ca" "q-40178/selection/58b89175b1ee6a2bc07d58c95510b254c2e0f94d3ccdbb34b3325ef0dcde7a2e" "q-40178/selection/ca586105846448ac1699334550a0524d222d9427262045b50db275ff6439e66d" "q-40178/selection/e1337f4aed674541ef366d41557e8888cb81c3be51fb1fa67574e9c9f7d0819b" "q-40178/selection/71bc96fe6fc80605dc170caa65f64a0c698449a11b0d745ff529eb8c7949e655"] :db/ensure [:answer-field/validate]} {:db/id "q-40178" :question/id #uuid "bf253c8e-f56d-577e-8af9-45821f9cd76e" :question/math-academy-id "q-40178" :question/problem "Consider the infinite geometric sequence that has a fourth term equal to $24$ and a seventh term equal to $\\frac{3}{8}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{4}=24$ and ${a}_{7}=\\frac{3}{8}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{(\\frac{3}{8})}{24} \\\\ {r}^{3} & =(\\frac{3}{8})(\\frac{1}{24}) \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nNow, using the formula\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}\n$$\n\nfor the $n$th term of the geometric sequence, we can find the first term. Indeed, for $n=4$ we obtain:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}(r)^{3} \\\\ 24 & ={a}_{1}{(\\frac{1}{4})}^{3} \\\\ 24 & ={a}_{1}(\\frac{1}{64}) \\\\ {a}_{1} & =1\\,536\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{1\\,536}{(1-\\frac{1}{4})} \\\\  & =\\frac{1\\,536}{(\\frac{3}{4})} \\\\  & =1\\,536(\\frac{4}{3}) \\\\  & =2\\,048.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-40178/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e"] :knowledge-point/questions ["q-40178"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115309/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" :answer/id #uuid "2e288629-c875-57a7-a744-8beef0f21c22" :answer/type :answer.type/math :answer/value "(-4,6)" :db/ensure [:answer/validate]} {:db/id "q-115309/selection/75f4af1a631ad1eb2c776bcfc360da05b1f0db1e66e0cdeeac4b794c54d527b2" :answer/id #uuid "ec32dc70-8e70-5c28-ab7c-9d9d3d72a88e" :answer/type :answer.type/math :answer/value "(6,-2)" :db/ensure [:answer/validate]} {:db/id "q-115309/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81" :answer/id #uuid "89497849-fd9d-5245-9d3a-4059493c2953" :answer/type :answer.type/math :answer/value "(6,-4)" :db/ensure [:answer/validate]} {:db/id "q-115309/selection/0871e10954df4a4466c31e310c776a637178c80d96247ce77ab8bd91135139af" :answer/id #uuid "5bc9eb5d-a79f-5714-8233-7358713503ce" :answer/type :answer.type/math :answer/value "(4,-6)" :db/ensure [:answer/validate]} {:db/id "q-115309/selection/144b9b27e5407875a6110661fb7cd60e576017bb9ef58d532f3de14f6cf246b2" :answer/id #uuid "e1b82bf7-0d35-545c-b325-3b5470b9722a" :answer/type :answer.type/math :answer/value "(2,6)" :db/ensure [:answer/validate]} {:db/id "q-115309/selection" :answer-field/id #uuid "739f30a4-1ba2-54f5-832e-1999e6e2dca8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115309/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" :answer-field/choices ["q-115309/selection/6c3e308b11d30a98d1115bf47991e53779e217d5f5adb05f3e9737a571395b20" "q-115309/selection/75f4af1a631ad1eb2c776bcfc360da05b1f0db1e66e0cdeeac4b794c54d527b2" "q-115309/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81" "q-115309/selection/0871e10954df4a4466c31e310c776a637178c80d96247ce77ab8bd91135139af" "q-115309/selection/144b9b27e5407875a6110661fb7cd60e576017bb9ef58d532f3de14f6cf246b2"] :db/ensure [:answer-field/validate]} {:db/id "q-115309" :question/id #uuid "cf51bfe3-04e9-56d5-87f7-d329556cf2cb" :question/math-academy-id "q-115309" :question/problem "What is the center of the ellipse $\\frac{(x+4)^{2}}{4}+\\frac{(y-6)^{2}}{36}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-4$ and $k=6,$ so the center is located at $(-4,6).$" :question/difficulty :que