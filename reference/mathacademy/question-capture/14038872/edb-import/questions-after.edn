#{[{:db/id #edb/ref 17592186302102 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bc9eb5d-a79f-5714-8233-7358713503ce" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-6)" :db/id #edb/ref 17592186302104} {:answer/id #uuid "e1b82bf7-0d35-545c-b325-3b5470b9722a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186302105} {:answer/id #uuid "89497849-fd9d-5245-9d3a-4059493c2953" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186302106} {:answer/id #uuid "2e288629-c875-57a7-a744-8beef0f21c22" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,6)" :db/id #edb/ref 17592186302107} {:answer/id #uuid "ec32dc70-8e70-5c28-ab7c-9d9d3d72a88e" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-2)" :db/id #edb/ref 17592186302108}] :answer-field/correct {:answer/id #uuid "2e288629-c875-57a7-a744-8beef0f21c22" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,6)" :db/id #edb/ref 17592186302107} :answer-field/id #uuid "739f30a4-1ba2-54f5-832e-1999e6e2dca8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302103}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cf51bfe3-04e9-56d5-87f7-d329556cf2cb" :question/math-academy-id "q-115309" :question/problem "What is the center of the ellipse $\\frac{(x+4)^{2}}{4}+\\frac{(y-6)^{2}}{36}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-4$ and $k=6,$ so the center is located at $(-4,6).$"}] [{:db/id #edb/ref 17592186302109 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad9b9344-1711-5ff4-b489-f6ef2a0bd2eb" :knowledge-point/title "Determining Whether a Right Riemann Sum is an Overestimate or Underestimate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf80c87-eef4-5f26-8b63-cbfb70bc33fc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/8361d4cb197686b79cf21cb88ee70de5b3578e92fb758fb84aec754871dfca3e.png" :db/id #edb/ref 17592186302111} {:answer/id #uuid "1075aa64-2813-5140-ba13-08a19d1f3025" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/7c79516ab4216ae1eed208c87204ae045b7f070f13d98853d6fed56eaae9b1c6.png" :db/id #edb/ref 17592186302112} {:answer/id #uuid "9fd4dbb8-3ef1-5a11-847e-f240aa92d0c1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/a20867cc6aca9f9b9a5b2b5780597938f43547380a6a0294671660f4a982383a.png" :db/id #edb/ref 17592186302113} {:answer/id #uuid "37db84f6-1a5d-5bc8-ac1c-17f991eded16" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/9e57c21db9ca295e246eee4510497763c857d280338aba261a3f1c6fb309da9d.png" :db/id #edb/ref 17592186302114} {:answer/id #uuid "d857a929-20db-5181-ba45-3ff8acef0308" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/a4dc3b8db26fe963aca60dab6fd927581896329e1801c11ce2687be251d65840.png" :db/id #edb/ref 17592186302115}] :answer-field/correct {:answer/id #uuid "ecf80c87-eef4-5f26-8b63-cbfb70bc33fc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/8361d4cb197686b79cf21cb88ee70de5b3578e92fb758fb84aec754871dfca3e.png" :db/id #edb/ref 17592186302111} :answer-field/id #uuid "39fe786b-4764-590d-b275-6412c661af10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302110}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "73a107f3-de5c-51c5-9778-c2302ba770ac" :question/math-academy-id "q-115699" :question/problem "A right Riemann sum is used to approximate the area under the curve $y=f(x)$ between $x=-4$ and $x=-1$ for each of the functions below. For which function does the Riemann sum give an *underestimate* of the area?" :question/worked-solution "The right Riemann sum underestimates the area under the respective curve if the function is decreasing over the given interval. \n\nOf the given options, the only function that is decreasing over $x\\in [-4,-1]$ is as follows.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038872/assets/8361d4cb197686b79cf21cb88ee70de5b3578e92fb758fb84aec754871dfca3e.png)"}] [{:db/id #edb/ref 17592186302116 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d211f02d-c40f-50c2-a20d-deb0a43d3209" :answer/type {:db/ident :answer.type/math} :answer/value "1+2\\operatorname{tan}⁡x" :db/id #edb/ref 17592186302118} {:answer/id #uuid "35ed506a-9521-5180-a96f-682b0dd8d833" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186302119} {:answer/id #uuid "bbd030d7-e3f3-5d11-a24e-1a39bd081e7e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186302120} {:answer/id #uuid "a85045ce-0e2b-583c-bb65-24f96d61b1b3" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186302121} {:answer/id #uuid "3b7551bf-7805-5d9d-8ec0-f2ca0e1720cc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186302122}] :answer-field/correct {:answer/id #uuid "bbd030d7-e3f3-5d11-a24e-1a39bd081e7e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186302120} :answer-field/id #uuid "d308c519-f561-5b02-8c0f-0dd415d40d2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302117}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d7b1e141-0f1f-5182-b6a5-be50ff0bb0dc" :question/math-academy-id "q-142835" :question/problem "$\\frac{2{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{2\\,{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x} & =\\frac{2\\,(1+{tan}^{2}⁡x)-1}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{2+2{tan}^{2}⁡x-1}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{1+2{tan}^{2}⁡x}{1+2{tan}^{2}⁡x} \\\\  & =\\frac{\\cancel{1+2{tan}^{2}⁡x}}{\\cancel{1+2{tan}^{2}⁡x}} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{2{sec}^{2}⁡x-1}{1+2{tan}^{2}⁡x}=1.\n$$"}] [{:db/id #edb/ref 17592186302123 :knowledge-point/_questions [{:knowledge-point/id #uuid "5eb24b54-bdb8-5269-bd38-d346a52bbc6e" :knowledge-point/title "Finding Solutions of Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186858b9-b9f0-5d60-9d72-9f09ea351310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\ln(9)}{1+\\ln(9)}" :db/id #edb/ref 17592186302125}] :answer-field/correct {:answer/id #uuid "186858b9-b9f0-5d60-9d72-9f09ea351310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\ln(9)}{1+\\ln(9)}" :db/id #edb/ref 17592186302125} :answer-field/id #uuid "98ddf865-1c62-526a-98a9-cb3cdff75bd0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302124}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b74609cf-54a2-5e61-b71b-f371e006d3b3" :question/math-academy-id "q-242909" :question/problem "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation ${e}^{x}={9}^{5-x}.$\n\n$x=$\n{{field-1}}" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x} & ={9}^{5-x} \\\\ \\operatorname{ln}⁡({e}^{x}) & =\\operatorname{ln}⁡({9}^{5-x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives\n\n$$\nx=\\operatorname{ln}⁡({9}^{5-x}).\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\nx=(5-x)\\operatorname{ln}⁡(9)\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x & =(5-x)\\operatorname{ln}⁡(9) \\\\ x & =5\\operatorname{ln}⁡(9)-x\\operatorname{ln}⁡(9) \\\\ x+x\\operatorname{ln}⁡(9) & =5\\operatorname{ln}⁡(9) \\\\ x(1+\\operatorname{ln}⁡(9)) & =5\\operatorname{ln}⁡(9) \\\\ x & =\\frac{5\\operatorname{ln}⁡(9)}{1+\\operatorname{ln}⁡(9)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302126 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10692e21-def1-58d9-82d7-41df447ada3d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302128}] :answer-field/correct {:answer/id #uuid "10692e21-def1-58d9-82d7-41df447ada3d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302128} :answer-field/id #uuid "57d18ad5-433f-50c0-afb7-21df4c1a2a0d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302127} {:answer-field/choices [{:answer/id #uuid "e2326f7f-0b72-5413-ab31-73bd5817bdef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186302130}] :answer-field/correct {:answer/id #uuid "e2326f7f-0b72-5413-ab31-73bd5817bdef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186302130} :answer-field/id #uuid "a52966d4-1d56-5452-9e0d-b3caebfa598f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302129}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a4183e51-f524-53bb-8633-07760d485b70" :question/math-academy-id "q-332175" :question/problem "Express $\\operatorname{sin}⁡(x-{210}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{210}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{210}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{210}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302131 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0adffc7-ef35-5f7a-a790-06addb354c2e" :knowledge-point/title "Calculating the Sum to Infinity of a Geometric Series Given Two of Its Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e7d75ec-b6e8-5935-8161-cef7ff455977" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,144" :db/id #edb/ref 17592186302133} {:answer/id #uuid "66289b0e-3bc4-5cf9-a7af-30d98407fbf4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,048" :db/id #edb/ref 17592186302134} {:answer/id #uuid "7ef8a7c3-11dd-559d-8f3c-9984fba7e000" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,024" :db/id #edb/ref 17592186302135} {:answer/id #uuid "a5bf168e-09f1-53ca-9703-3c0cd88098f7" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,072" :db/id #edb/ref 17592186302136} {:answer/id #uuid "464bf8ba-856d-5217-acc8-9f5419529fba" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,364" :db/id #edb/ref 17592186302137}] :answer-field/correct {:answer/id #uuid "66289b0e-3bc4-5cf9-a7af-30d98407fbf4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,048" :db/id #edb/ref 17592186302134} :answer-field/id #uuid "ff1ac375-bbc8-5535-9f4c-59e4dde8a361" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302132}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bf253c8e-f56d-577e-8af9-45821f9cd76e" :question/math-academy-id "q-40178" :question/problem "Consider the infinite geometric sequence that has a fourth term equal to $24$ and a seventh term equal to $\\frac{3}{8}.$ What is the sum to infinity of the terms of this sequence?" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nFrom the question statement we have ${a}_{4}=24$ and ${a}_{7}=\\frac{3}{8}.$ We can find the common ratio using the following formula:\n\n$$\n{r}^{n-m}=\\frac{{a}_{n}}{{a}_{m}}\n$$\n\nSubstituting in the known information into the above gives:\n\n$$\n\\begin{aligned}{r}^{7-4} & =\\frac{(\\frac{3}{8})}{24} \\\\ {r}^{3} & =(\\frac{3}{8})(\\frac{1}{24}) \\\\ {r}^{3} & =\\frac{1}{64} \\\\ {r}^{3} & ={(\\frac{1}{4})}^{3} \\\\ r & =\\frac{1}{4}\\end{aligned}\n$$\n\nNow, using the formula\n\n$$\n{a}_{n}={a}_{1}{r}^{n-1}\n$$\n\nfor the $n$th term of the geometric sequence, we can find the first term. Indeed, for $n=4$ we obtain:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}(r)^{3} \\\\ 24 & ={a}_{1}{(\\frac{1}{4})}^{3} \\\\ 24 & ={a}_{1}(\\frac{1}{64}) \\\\ {a}_{1} & =1\\,536\\end{aligned}\n$$\n\nSo, using the formula, we find that the sum to infinity is\n\n$$\n\\begin{aligned}{S}_{\\infty } & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{1\\,536}{(1-\\frac{1}{4})} \\\\  & =\\frac{1\\,536}{(\\frac{3}{4})} \\\\  & =1\\,536(\\frac{4}{3}) \\\\  & =2\\,048.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078937 :knowledge-point/_questions [{:knowledge-point/id #uuid "236cec41-4836-5526-893d-e6f2a23d1801" :knowledge-point/title "Determining a Rate of Change for a Given Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "857b16b7-183a-567a-b91c-3c589d3ec9ec" :answer/type {:db/ident :answer.type/text} :answer/value "$2 \\cdot 2^{t^{2} + 1}$ million bacteria per day" :db/id #edb/ref 17592186076834} {:answer/id #uuid "9164e8a1-b76b-5dbe-9f2b-cc9824c95fae" :answer/type {:db/ident :answer.type/text} :answer/value "$2 \\cdot 2^{t^{3}}$ million bacteria per day" :db/id #edb/ref 17592186076835} {:answer/id #uuid "c086f0d7-55b0-5972-b0ca-282894ec9cf0" :answer/type {:db/ident :answer.type/text} :answer/value "$2t \\cdot 2^{t^{2} + 1}$ million bacteria per day" :db/id #edb/ref 17592186076836} {:answer/id #uuid "ed4a557f-4e0e-5f2b-a314-7c6ade559eb1" :answer/type {:db/ident :answer.type/text} :answer/value "$\\frac{1}{t} \\cdot 2^{t^{2} + 1}$ million bacteria per day" :db/id #edb/ref 17592186076837} {:answer/id #uuid "0df084c5-c305-5ab2-a3c7-71cb1c4f1100" :answer/type {:db/ident :answer.type/text} :answer/value "$2^{t^{2} + 1}$ million bacteria per day" :db/id #edb/ref 17592186076838}] :answer-field/correct {:answer/id #uuid "c086f0d7-55b0-5972-b0ca-282894ec9cf0" :answer/type {:db/ident :answer.type/text} :answer/value "$2t \\cdot 2^{t^{2} + 1}$ million bacteria per day" :db/id #edb/ref 17592186076836} :answer-field/id #uuid "16bc38f0-bb37-5f06-a33f-e18cc188fcdc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186076833}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b4091c7-9a78-5230-a947-2f7371f4b53c" :question/math-academy-id "q-48696" :question/problem "The population $p$, in millions, of a particular colony of bacteria after $t$ days can be modeled by the function $p(t)=\\frac{{2}^{{t}^{2}+1}}{\\operatorname{ln}⁡2}.$ What is the instantaneous rate of change of the bacteria population as a function of $t?$" :question/worked-solution "The instantaneous rate of change of the bacteria population is equal to ${p}^{′}(t).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{p}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{2}^{{t}^{2}+1}}{\\operatorname{ln}⁡2}) \\\\  & =\\frac{{2}^{{t}^{2}+1}\\cdot (2t)\\cdot \\operatorname{ln}⁡2}{\\operatorname{ln}⁡2} \\\\  & =2t\\cdot {2}^{{t}^{2}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302138 :knowledge-point/_questions [{:knowledge-point/id #uuid "16dac5bd-acbd-51c6-8636-172e3a55aaf1" :knowledge-point/title "Finding the Second Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d2691ce-419a-5d26-a515-b4a89c3c41fd" :answer/type {:db/ident :answer.type/math} :answer/value "15t" :db/id #edb/ref 17592186302140} {:answer/id #uuid "d675e7f3-aa07-5682-8bc4-59c11d3f33cd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186302141} {:answer/id #uuid "b86cd693-b2f5-513d-8c07-ad4ad5e389ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15t}" :db/id #edb/ref 17592186302142} {:answer/id #uuid "c554f7c6-d4c4-5196-a09f-ed97a73c9e81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{t}" :db/id #edb/ref 17592186302143} {:answer/id #uuid "05d366fd-013c-57c5-8082-657ed79f8810" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{3}" :db/id #edb/ref 17592186302144}] :answer-field/correct {:answer/id #uuid "1d2691ce-419a-5d26-a515-b4a89c3c41fd" :answer/type {:db/ident :answer.type/math} :answer/value "15t" :db/id #edb/ref 17592186302140} :answer-field/id #uuid "7c8482ab-5b8e-5338-b0b8-f6e49c1b7e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302139}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fb260a57-62db-5317-884e-db3ce39bc673" :question/math-academy-id "q-54161" :question/problem "A curve is defined by the parametric equations $x={t}^{2}-1,\\,y=4{t}^{5}+1$ where $t$ is a real number. Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2t,\\,{y}^{′}(t)=20{t}^{4}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{20{t}^{4}}{2t}=10{t}^{3}.\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(10{t}^{3})}{2t} \\\\  & =\\frac{30{t}^{2}}{2t} \\\\  & =15t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302145 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fdcba7f-bb28-52a9-b424-602659009d5c" :answer/type {:db/ident :answer.type/math} :answer/value "q-p" :db/id #edb/ref 17592186302147} {:answer/id #uuid "10b492e3-d7de-5ca3-a98d-0a69da84abf8" :answer/type {:db/ident :answer.type/math} :answer/value "2pq" :db/id #edb/ref 17592186302148} {:answer/id #uuid "c67a7291-905f-5f3f-9726-285cd425afd4" :answer/type {:db/ident :answer.type/math} :answer/value "p-q" :db/id #edb/ref 17592186302149} {:answer/id #uuid "72b5d8a0-b53c-5798-9cdd-264de35c564a" :answer/type {:db/ident :answer.type/math} :answer/value "pq-1" :db/id #edb/ref 17592186302150} {:answer/id #uuid "d585aefb-b3d1-5c9e-b5d0-372d881ac583" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186302151}] :answer-field/correct {:answer/id #uuid "10b492e3-d7de-5ca3-a98d-0a69da84abf8" :answer/type {:db/ident :answer.type/math} :answer/value "2pq" :db/id #edb/ref 17592186302148} :answer-field/id #uuid "25417d09-1503-5cfe-88dc-64309d1b6e69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302146}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dd7509ff-1fe8-581a-b2d2-d01fdb008e24" :question/math-academy-id "q-77471" :question/problem "What is the minor of ${k}_{22}$ in the matrix\n$K=[\\begin{aligned}p & p & -p \\\\ -q & q & q \\\\ q & -2 & q\\end{aligned}]?$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nK=[\\begin{aligned}p & ∗ & -p \\\\ ∗ & q & ∗ \\\\ q & ∗ & q\\end{aligned}]\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}p & -p \\\\ q & q\\end{aligned}] & =|\\begin{aligned}p & -p \\\\ q & q\\end{aligned}| \\\\  & =p\\cdot p-q\\cdot (-p) \\\\  & =pq+pq \\\\  & =2pq\\end{aligned}\n$$"}]}
