#{[{:db/id #edb/ref 17592186286859 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2007ae32-b5e6-5550-b29a-826f97943a4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186286861}] :answer-field/correct {:answer/id #uuid "2007ae32-b5e6-5550-b29a-826f97943a4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186286861} :answer-field/id #uuid "7d8df78f-e342-51ad-a9b3-d749fd1f31ef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286860}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "241427c9-1fe6-5bdc-853c-7a72d573e969" :question/math-academy-id "q-270380" :question/problem "Find the root of $f(x)=2\\sqrt[5]{7-6x}+6.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n2\\sqrt[5]{7-6x}+6=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}2\\sqrt[5]{7-6x}+6 & =0 \\\\ 2\\sqrt[5]{7-6x} & =-6 \\\\ \\sqrt[5]{7-6x} & =-3 \\\\ (\\sqrt[5]{7-6x})^{5} & =(-3)^{5} \\\\ 7-6x & =-243 \\\\ -6x & =-250 \\\\ x & =\\frac{125}{3}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{125}{3}.$"}] [{:db/id #edb/ref 17592186286862 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb35e32-6ce4-54d4-9973-62682605a7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186286864} {:answer/id #uuid "72bdebe3-a0ba-5f57-b384-bd370bec8e2c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286865}] :answer-field/correct {:answer/id #uuid "2eb35e32-6ce4-54d4-9973-62682605a7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186286864} :answer-field/id #uuid "d614dae8-d6b5-5013-9fde-10e2e6a2665b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286863}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e0182092-4dc4-5fba-8ca6-358bfd1a05a9" :question/math-academy-id "q-277244" :question/problem "Find the root of $f(x)=9\\sqrt[7]{2x-6}-9.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n9\\sqrt[7]{2x-6}-9=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}9\\sqrt[7]{2x-6}-9 & =0 \\\\ 9\\sqrt[7]{2x-6} & =9 \\\\ \\sqrt[7]{2x-6} & =1 \\\\ (\\sqrt[7]{2x-6})^{7} & ={1}^{7} \\\\ 2x-6 & =1 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186286866 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8839cf0-93ab-5511-9257-a4c9b938098f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286868}] :answer-field/correct {:answer/id #uuid "d8839cf0-93ab-5511-9257-a4c9b938098f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286868} :answer-field/id #uuid "8b18ebb4-17dd-5f25-a8bc-b9a1c18957a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286867}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bed8a4a3-f09a-51ca-a078-9b2e3d39c6cc" :question/math-academy-id "q-277256" :question/problem "Find the root of $f(x)=-5\\sqrt[8]{4x+9}+5.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the roots of $f(x),$ we must solve $f(x)=0:$\n\n$$\n-5\\sqrt[8]{4x+9}+5=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-5\\sqrt[8]{4x+9}+5 & =0 \\\\ -5\\sqrt[8]{4x+9} & =-5 \\\\ \\sqrt[8]{4x+9} & =1 \\\\ {(\\sqrt[8]{4x+9})}^{8} & ={1}^{8} \\\\ 4x+9 & =1 \\\\ 4x & =-8 \\\\ x & =-2\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}-5\\sqrt[8]{4\\cdot (-2)+9}+5 & =0 \\\\ -5\\sqrt[8]{1}+5 & =0 \\\\ -5\\cdot 1+5 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-2.$"}] [{:db/id #edb/ref 17592186286869 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27bbd90c-bccb-5021-ae06-d72febdebcc5" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{17}{3}" :db/id #edb/ref 17592186286871} {:answer/id #uuid "015e5fba-a074-59ae-9d3f-33887b923a36" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186286872} {:answer/id #uuid "8e1f3be6-12ad-5df4-8a53-1845fb333276" :answer/type {:db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186286873} {:answer/id #uuid "0e28764e-16b1-5363-8f25-ee36a75bd084" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no root" :db/id #edb/ref 17592186286874} {:answer/id #uuid "c13fcffa-9537-5345-bb3c-44a2c056ea3f" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186286875}] :answer-field/correct {:answer/id #uuid "8e1f3be6-12ad-5df4-8a53-1845fb333276" :answer/type {:db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186286873} :answer-field/id #uuid "8d96c36b-e01a-5759-b4a9-a4b89ad1a6dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286870}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4398c8a3-5403-5b24-9b80-21300bf72d36" :question/math-academy-id "q-93098" :question/problem "Find the root of $f(x)=-5\\sqrt[4]{3x+1}+10.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-5\\sqrt[4]{3x+1}+10=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-5\\sqrt[4]{3x+1}+10 & =0 \\\\ -5\\sqrt[4]{3x+1} & =-10 \\\\ \\sqrt[4]{3x+1} & =2 \\\\ (\\sqrt[4]{3x+1})^{4} & ={2}^{4} \\\\ 3x+1 & =16 \\\\ 3x & =15 \\\\ x & =5\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}-5\\sqrt[4]{3\\cdot 5+1}+10 & =0 \\\\ -5\\sqrt[4]{16}+10 & =0 \\\\ -5\\cdot 2+10 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=5.$"}] [{:db/id #edb/ref 17592186286876 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b941ae9-b29e-5eed-b4e0-43fd1069894c" :answer/type {:db/ident :answer.type/math} :answer/value "x=-15" :db/id #edb/ref 17592186286878} {:answer/id #uuid "085dc9a7-a9f8-5485-86b1-5d90a75620e3" :answer/type {:db/ident :answer.type/math} :answer/value "x=8" :db/id #edb/ref 17592186286879} {:answer/id #uuid "fc819e07-765c-5334-9dcd-6dc57ced0953" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no root" :db/id #edb/ref 17592186286880} {:answer/id #uuid "aa94f550-247e-5e25-9f74-77e244b33b04" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 13" :db/id #edb/ref 17592186286881} {:answer/id #uuid "d2323aef-800c-5cf2-9654-6e3a8b2bfb76" :answer/type {:db/ident :answer.type/math} :answer/value "x=15" :db/id #edb/ref 17592186286882}] :answer-field/correct {:answer/id #uuid "fc819e07-765c-5334-9dcd-6dc57ced0953" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no root" :db/id #edb/ref 17592186286880} :answer-field/id #uuid "ce267bbe-477d-5913-852b-1b61ff6e2f71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286877}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "deb7d641-51be-5b64-b25b-f4aefccbd21e" :question/math-academy-id "q-93099" :question/problem "Find the root of $f(x)=-4\\sqrt[6]{5x-11}-8.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-4\\sqrt[6]{5x-11}-8=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-4\\sqrt[6]{5x-11}-8 & =0 \\\\ -4\\sqrt[6]{5x-11} & =8 \\\\ \\sqrt[6]{5x-11} & =-2\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root."}]}
