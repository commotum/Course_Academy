faa05b3aeca72ddcb08efc3d365" :answer/id #uuid "2007ae32-b5e6-5550-b29a-826f97943a4d" :answer/type :answer.type/math :answer/value "\\frac{125}{3}" :db/ensure [:answer/validate]} {:db/id "q-270380/field-1" :answer-field/id #uuid "7d8df78f-e342-51ad-a9b3-d749fd1f31ef" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270380/field-1/a72dd11ddb15d9f51ef3fd9f1d9f2357f2b4bfaa05b3aeca72ddcb08efc3d365" :answer-field/choices ["q-270380/field-1/a72dd11ddb15d9f51ef3fd9f1d9f2357f2b4bfaa05b3aeca72ddcb08efc3d365"] :db/ensure [:answer-field/validate]} {:db/id "q-270380" :question/id #uuid "241427c9-1fe6-5bdc-853c-7a72d573e969" :question/math-academy-id "q-270380" :question/problem "Find the root of $f(x)=2\\sqrt[5]{7-6x}+6.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n2\\sqrt[5]{7-6x}+6=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}2\\sqrt[5]{7-6x}+6 & =0 \\\\ 2\\sqrt[5]{7-6x} & =-6 \\\\ \\sqrt[5]{7-6x} & =-3 \\\\ (\\sqrt[5]{7-6x})^{5} & =(-3)^{5} \\\\ 7-6x & =-243 \\\\ -6x & =-250 \\\\ x & =\\frac{125}{3}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{125}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-270380/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52"] :knowledge-point/questions ["q-270380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277244/field-1/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "2eb35e32-6ce4-54d4-9973-62682605a7f4" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-277244/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "72bdebe3-a0ba-5f57-b384-bd370bec8e2c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-277244/field-1" :answer-field/id #uuid "d614dae8-d6b5-5013-9fde-10e2e6a2665b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277244/field-1/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer-field/choices ["q-277244/field-1/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-277244/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-277244" :question/id #uuid "e0182092-4dc4-5fba-8ca6-358bfd1a05a9" :question/math-academy-id "q-277244" :question/problem "Find the root of $f(x)=9\\sqrt[7]{2x-6}-9.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n9\\sqrt[7]{2x-6}-9=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}9\\sqrt[7]{2x-6}-9 & =0 \\\\ 9\\sqrt[7]{2x-6} & =9 \\\\ \\sqrt[7]{2x-6} & =1 \\\\ (\\sqrt[7]{2x-6})^{7} & ={1}^{7} \\\\ 2x-6 & =1 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{7}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-277244/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52"] :knowledge-point/questions ["q-277244"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277256/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "d8839cf0-93ab-5511-9257-a4c9b938098f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-277256/field-1" :answer-field/id #uuid "8b18ebb4-17dd-5f25-a8bc-b9a1c18957a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277256/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-277256/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-277256" :question/id #uuid "bed8a4a3-f09a-51ca-a078-9b2e3d39c6cc" :question/math-academy-id "q-277256" :question/problem "Find the root of $f(x)=-5\\sqrt[8]{4x+9}+5.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the roots of $f(x),$ we must solve $f(x)=0:$\n\n$$\n-5\\sqrt[8]{4x+9}+5=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-5\\sqrt[8]{4x+9}+5 & =0 \\\\ -5\\sqrt[8]{4x+9} & =-5 \\\\ \\sqrt[8]{4x+9} & =1 \\\\ {(\\sqrt[8]{4x+9})}^{8} & ={1}^{8} \\\\ 4x+9 & =1 \\\\ 4x & =-8 \\\\ x & =-2\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}-5\\sqrt[8]{4\\cdot (-2)+9}+5 & =0 \\\\ -5\\sqrt[8]{1}+5 & =0 \\\\ -5\\cdot 1+5 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-277256/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876"] :knowledge-point/questions ["q-277256"] :db/ensure [:knowledge-point/validate]}]
