[{:db/id "q-66792/selection/550973fa814bde7dbb571c070e8fcfec73c5188be83cc08123d05bba69e74bf5" :answer/id #uuid "a7591086-c099-5a10-b96b-1e1751faf87e" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{2+3\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-66792/selection/2130a8f5cfb8f040b71ecfec80c9f08baf297e12dfabc473304c7896a4fd774f" :answer/id #uuid "e1cd8fd1-719a-53f2-8250-2dd6f52b9fe9" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{1-\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-66792/selection/9c5143be293f75f1d1108b2ea9712f4df7b011ed2f487dd3a9f37b0b63fb69cd" :answer/id #uuid "315db262-e025-5508-a5b1-5528a6e23f27" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-66792/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" :answer/id #uuid "59c2d403-f4c5-512b-b9e4-67a2be33dcbb" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-66792/selection/b2692aaec358b68ed1745b219926c7b60368894489c301606ed4ab0b317678c5" :answer/id #uuid "b349fc73-4e72-5c3d-b741-ad907e69d746" :answer/type :answer.type/math :answer/value "\\frac{1}{1+\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-66792/selection" :answer-field/id #uuid "de46083e-cd07-56ed-bc00-6d359161d91d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66792/selection/2130a8f5cfb8f040b71ecfec80c9f08baf297e12dfabc473304c7896a4fd774f" :answer-field/choices ["q-66792/selection/550973fa814bde7dbb571c070e8fcfec73c5188be83cc08123d05bba69e74bf5" "q-66792/selection/2130a8f5cfb8f040b71ecfec80c9f08baf297e12dfabc473304c7896a4fd774f" "q-66792/selection/9c5143be293f75f1d1108b2ea9712f4df7b011ed2f487dd3a9f37b0b63fb69cd" "q-66792/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" "q-66792/selection/b2692aaec358b68ed1745b219926c7b60368894489c301606ed4ab0b317678c5"] :db/ensure [:answer-field/validate]} {:db/id "q-66792" :question/id #uuid "d0e7f287-adec-5973-9d8d-d6bf16f0de13" :question/math-academy-id "q-66792" :question/problem "Expressed in terms of natural logarithms, what value of $x$ satisfies the equation ${e}^{x}={2}^{x+1}?$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x} & ={2}^{x+1} \\\\ \\operatorname{ln}⁡({e}^{x}) & =\\operatorname{ln}⁡({2}^{x+1})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x & =\\operatorname{ln}⁡({2}^{x+1})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x & =(x+1)\\operatorname{ln}⁡2\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}x & =(x+1)\\operatorname{ln}⁡2 \\\\ x & =x\\operatorname{ln}⁡2+\\operatorname{ln}⁡2 \\\\ x-x\\operatorname{ln}⁡2 & =\\operatorname{ln}⁡2 \\\\ x(1-\\operatorname{ln}⁡2) & =\\operatorname{ln}⁡2 \\\\ x & =\\frac{\\operatorname{ln}⁡2}{1-\\operatorname{ln}⁡2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66792/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5eb24b54-bdb8-5269-bd38-d346a52bbc6e"] :knowledge-point/questions ["q-66792"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66896/selection/17fd042b4c987ef80000b54ebcefc92a84a475cc29cb638478483988fb342f3a" :answer/id #uuid "6b4bd7d5-9600-595e-855c-6bdd39428f97" :answer/type :answer.type/math :answer/value "\\frac{1-\\operatorname{ln}⁡3}{3}" :db/ensure [:answer/validate]} {:db/id "q-66896/selection/b9320a622d4da3f7bb19aa0ad970ce3c4f9674a058bc66b20f506848dc51ffca" :answer/id #uuid "5beb47bb-38f4-596c-be4d-beb3cf20ba2c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2-\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-66896/selection/1e5fba6b4a2f5f8158c26a012dd3be07780368d9d701f4dd94d7a6b593269f24" :answer/id #uuid "14051835-a242-5085-9536-8364699ab3d2" :answer/type :answer.type/math :answer/value "\\frac{1}{1-\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-66896/selection/1ec98a45790c6714059c183bdb505ea1c9ba3e59c68dc46a44c95b3438c0cc03" :answer/id #uuid "308d614f-9575-52fe-a980-5710414e17ff" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{log}⁡3}{1+\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-66896/selection/772a1b0695a2df7046f559ac639e45797b16cc364784f0065b5ae5338ff84cdf" :answer/id #uuid "44820db2-c460-55d0-9512-4c4990ef2a84" :answer/type :answer.type/math :answer/value "1-\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-66896/selection" :answer-field/id #uuid "81d059f0-3026-5355-bdf0-ce4bfb21cd9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66896/selection/1e5fba6b4a2f5f8158c26a012dd3be07780368d9d701f4dd94d7a6b593269f24" :answer-field/choices ["q-66896/selection/17fd042b4c987ef80000b54ebcefc92a84a475cc29cb638478483988fb342f3a" "q-66896/selection/b9320a622d4da3f7bb19aa0ad970ce3c4f9674a058bc66b20f506848dc51ffca" "q-66896/selection/1e5fba6b4a2f5f8158c26a012dd3be07780368d9d701f4dd94d7a6b593269f24" "q-66896/selection/1ec98a45790c6714059c183bdb505ea1c9ba3e59c68dc46a44c95b3438c0cc03" "q-66896/selection/772a1b0695a2df7046f559ac639e45797b16cc364784f0065b5ae5338ff84cdf"] :db/ensure [:answer-field/validate]} {:db/id "q-66896" :question/id #uuid "4b29265f-c944-5a5b-bb00-edb60f6cc60f" :question/math-academy-id "q-66896" :question/problem "Expressed in terms of natural logarithms, what value of $x$ satisfies the equation ${e}^{x-1}={3}^{x}?$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x-1} & ={3}^{x} \\\\ \\operatorname{ln}⁡({e}^{x-1}) & =\\operatorname{ln}⁡({3}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-1 & =\\operatorname{ln}⁡({3}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-1 & =x\\operatorname{ln}⁡3\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}x-1 & =x\\operatorname{ln}⁡3 \\\\ x-x\\operatorname{ln}⁡3 & =1 \\\\ x(1-\\operatorname{ln}⁡3) & =1 \\\\ x & =\\frac{1}{1-\\operatorname{ln}⁡3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66896/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5eb24b54-bdb8-5269-bd38-d346a52bbc6e"] :knowledge-point/questions ["q-66896"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66897/selection/1f27379703d758df6f3bf0d153dff29b190edf55e4d93e9e31354501203c067d" :answer/id #uuid "82ea3122-d5cb-5060-8d1c-7837073e95bd" :answer/type :answer.type/math :answer/value "\\frac{5}{1-\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-66897/selection/f68c2fe3c6b33e2d5dc1943ca39df0665ee3d3e939126aff8d8254141807edf4" :answer/id #uuid "b5a8c3a9-3128-5e93-bcf9-c3216b719ab0" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡5-\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "q-66897/selection/d6a99f1e05ccde06eec92325edf3edce345e492df5fd1e545ca3f6f72aa8ac13" :answer/id #uuid "8ef409e6-42d4-54b9-ad50-fa666f95ff17" :answer/type :answer.type/math :answer/value "\\frac{1+\\operatorname{ln}⁡4}{5}" :db/ensure [:answer/validate]} {:db/id "q-66897/selection/c738841dec1ba68eae816ff9f3a4223d3c86fae2e57e6d1e85dd5841c91085ab" :answer/id #uuid "cdd4eeeb-37d2-53df-8ce3-a4dda3f1d3c7" :answer/type :answer.type/math :answer/value "5\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "q-66897/selection/58e641ea35d47fc74d27bb6429f1dc405e3551240d45889bf038298fc23609cd" :answer/id #uuid "7916e07a-6421-5980-bca0-4fa59ae145e5" :answer/type :answer.type/math :answer/value "5(1-\\operatorname{ln}⁡4)" :db/ensure [:answer/validate]} {:db/id "q-66897/selection" :answer-field/id #uuid "0246dc3c-86ad-59d8-8e3a-c92fbedcf356" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66897/selection/1f27379703d758df6f3bf0d153dff29b190edf55e4d93e9e31354501203c067d" :answer-field/choices ["q-66897/selection/1f27379703d758df6f3bf0d153dff29b190edf55e4d93e9e31354501203c067d" "q-66897/selection/f68c2fe3c6b33e2d5dc1943ca39df0665ee3d3e939126aff8d8254141807edf4" "q-66897/selection/d6a99f1e05ccde06eec92325edf3edce345e492df5fd1e545ca3f6f72aa8ac13" "q-66897/selection/c738841dec1ba68eae816ff9f3a4223d3c86fae2e57e6d1e85dd5841c91085ab" "q-66897/selection/58e641ea35d47fc74d27bb6429f1dc405e3551240d45889bf038298fc23609cd"] :db/ensure [:answer-field/validate]} {:db/id "q-66897" :question/id #uuid "ad3aa12e-9200-54f0-8cef-9a72c4b36ddb" :question/math-academy-id "q-66897" :question/problem "Expressed in terms of natural logarithms, what value of $x$ satisfies the equation ${e}^{x-5}={4}^{x}?$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x-5} & ={4}^{x} \\\\ \\operatorname{ln}⁡({e}^{x-5}) & =\\operatorname{ln}⁡({4}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-5 & =\\operatorname{ln}⁡({4}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-5 & =x\\operatorname{ln}⁡4\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}x-5 & =x\\operatorname{ln}⁡4 \\\\ x-x\\operatorname{ln}⁡4 & =5 \\\\ x(1-\\operatorname{ln}⁡4) & =5 \\\\ x & =\\frac{5}{1-\\operatorname{ln}⁡4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66897/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5eb24b54-bdb8-5269-bd38-d346a52bbc6e"] :knowledge-point/questions ["q-66897"] :db/ensure [:knowledge-point/validate]} {:db/id "q-242914/field-1/2d71f571431b15bba1357bfcace59b7d07477e0400971ff7f0fae949151daac2" :answer/id #uuid "c13a7922-3441-5c68-ac31-ba6026553bb1" :answer/type :answer.type/math :answer/value "\\frac{(4\\ln(3)-3\\ln(8))}{\\ln(3)+2\\ln(8)}" :db/ensure [:answer/validate]} {:db/id "q-242914/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "de14078e-9826-53cb-871d-56c36cf00a6e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-242914/field-1" :answer-field/id #uuid "a6d66702-1876-50e0-935e-dff783b1570c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-242914/field-1/2d71f571431b15bba1357bfcace59b7d07477e0400971ff7f0fae949151daac2" :answer-field/choices ["q-242914/field-1/2d71f571431b15bba1357bfcace59b7d07477e0400971ff7f0fae949151daac2" "q-242914/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-242914" :question/id #uuid "07e669d6-9649-5b20-abe3-70dd6ee4e891" :question/math-academy-id "q-242914" :question/problem "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation ${3}^{4-x}={8}^{2x+3}.$\n\n$x=$\n{{field-1}}" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{3}^{4-x} & ={8}^{2x+3} \\\\ \\operatorname{ln}⁡({3}^{4-x}) & =\\operatorname{ln}⁡({8}^{2x+3})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives\n\n$$\n(4-x)\\operatorname{ln}⁡(3)=(2x+3)\\operatorname{ln}⁡(8).\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(4-x)\\operatorname{ln}⁡(3) & =(2x+3)\\operatorname{ln}⁡(8) \\\\ 4\\operatorname{ln}⁡(3)-x\\operatorname{ln}⁡(3) & =2x\\operatorname{ln}⁡(8)+3\\operatorname{ln}⁡(8) \\\\ -x\\operatorname{ln}⁡(3)-2x\\operatorname{ln}⁡(8) & =3\\operatorname{ln}⁡(8)-4\\operatorname{ln}⁡(3) \\\\ x\\operatorname{ln}⁡(3)+2x\\operatorname{ln}⁡(8) & =4\\operatorname{ln}⁡(3)-3\\operatorname{ln}⁡(8) \\\\ x(\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(8)) & =4\\operatorname{ln}⁡(3)-3\\operatorname{ln}⁡(8) \\\\ x & =\\frac{4\\operatorname{ln}⁡(3)-3\\operatorname{ln}⁡(8)}{\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(8)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-242914/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-242914"] :db/ensure [:knowledge-point/validate]} {:db/id "q-242919/field-1/0e1835e8236051dfc64bf053d8bd33d9f80cc350bb99ca47beccc9b5cd1ded12" :answer/id #uuid "f91695cd-31c2-5dd8-a3bc-8c8d39866e0d" :answer/type :answer.type/math :answer/value "\\frac{(5\\ln(6)-\\ln(5))}{4\\ln(5)-7\\ln(6)}" :db/ensure [:answer/validate]} {:db/id "q-242919/field-1" :answer-field/id #uuid "bbf7d9ab-8258-5d0c-b997-6f5651d1d1a4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-242919/field-1/0e1835e8236051dfc64bf053d8bd33d9f80cc350bb99ca47beccc9b5cd1ded12" :answer-field/choices ["q-242919/field-1/0e1835e8236051dfc64bf053d8bd33d9f80cc350bb99ca47beccc9b5cd1ded12"] :db/ensure [:answer-field/validate]} {:db/id "q-242919" :question/id #uuid "aea2ce2a-0f99-56fa-8c97-890df44863a1" :question/math-academy-id "q-242919" :question/problem "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation ${5}^{4x+1}={6}^{7x+5}.$\n\n$x=$\n{{field-1}}" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{5}^{4x+1} & ={6}^{7x+5} \\\\ \\operatorname{ln}⁡({5}^{4x+1}) & =\\operatorname{ln}⁡({6}^{7x+5})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives\n\n$$\n(4x+1)\\operatorname{ln}⁡(5)=(7x+5)\\operatorname{ln}⁡(6).\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(4x+1)\\operatorname{ln}⁡(5) & =(7x+5)\\operatorname{ln}⁡(6) \\\\ 4x\\operatorname{ln}⁡(5)+\\operatorname{ln}⁡(5) & =7x\\operatorname{ln}⁡(6)+5\\operatorname{ln}⁡(6) \\\\ 4x\\operatorname{ln}⁡(5)-7x\\operatorname{ln}⁡(6) & =5\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(5) \\\\ x(4\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(6)) & =5\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(5) \\\\ x & =\\frac{5\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(5)}{4\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(6)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-242919/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-242919"] :db/ensure [:knowledge-point/validate]}]
