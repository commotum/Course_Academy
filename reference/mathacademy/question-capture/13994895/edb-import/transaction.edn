[{:db/id "q-16239/selection/40f3530bea5f174c5db23da6133ade5bb001a92c3fde5be8a78285d04fff07ad" :answer/id #uuid "cd948c03-41a4-5aac-ba09-664e32463ccc" :answer/type :answer.type/math :answer/value "x=-{30}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-16239/selection/68c36adc890c044975f3d23f08b98e54a7ef65c89c0ddaa193fde401a6c258d4" :answer/id #uuid "070e3404-9bfe-5464-a8f0-09d537e53b3f" :answer/type :answer.type/math :answer/value "x=-{150}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-16239/selection/052dc86a0dee1ef53fe5018f47b6af2bbd00088abe2a0ce4330fc91d44f3906a" :answer/id #uuid "b396ed97-56e2-57e0-9c61-ca0bc74a72c3" :answer/type :answer.type/math :answer/value "x=-{60}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-16239/selection/aef21d3c5ab1596b65bad3142ea6e4caa99b57727ad049f978f6fa268ff8f39a" :answer/id #uuid "d62c12e5-70a4-5c20-93c2-5f4a3c1d98f1" :answer/type :answer.type/math :answer/value "x={30}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-16239/selection/00889b9aff8b605e4232fef11779d8f2f6b6afe9ecb7299196d2f236aedc474d" :answer/id #uuid "cbd22138-6aef-5994-8db4-43e21e810b64" :answer/type :answer.type/math :answer/value "x={60}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-16239/selection" :answer-field/id #uuid "0234d2cf-4f38-5047-98dc-97ff17c95fdd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16239/selection/40f3530bea5f174c5db23da6133ade5bb001a92c3fde5be8a78285d04fff07ad" :answer-field/choices ["q-16239/selection/40f3530bea5f174c5db23da6133ade5bb001a92c3fde5be8a78285d04fff07ad" "q-16239/selection/68c36adc890c044975f3d23f08b98e54a7ef65c89c0ddaa193fde401a6c258d4" "q-16239/selection/052dc86a0dee1ef53fe5018f47b6af2bbd00088abe2a0ce4330fc91d44f3906a" "q-16239/selection/aef21d3c5ab1596b65bad3142ea6e4caa99b57727ad049f978f6fa268ff8f39a" "q-16239/selection/00889b9aff8b605e4232fef11779d8f2f6b6afe9ecb7299196d2f236aedc474d"] :db/ensure [:answer-field/validate]} {:db/id "q-16239" :question/id #uuid "e43578bf-65fe-55c0-92ae-03aa0f0fdd82" :question/math-academy-id "q-16239" :question/problem "In degrees, find the general solution to the equation $\\operatorname{tan}⁡x=-\\frac{\\sqrt{3}}{3}.$  Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-{30}^{∘}\n$$\n\nThe tangent function has a period of ${180}^{∘}.$  Hence, the general solution for the given equation is: \n\n$$\nx=-{30}^{∘}+n\\cdot {180}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16239/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aa20dbfa-3f6f-5caf-9c10-906f2422f161"] :knowledge-point/questions ["q-16239"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17339/selection/0ef3267027edac74be1db348e3d39cb78ea594c8594ab144b35ba9c73928df24" :answer/id #uuid "4bd914ed-e7e2-585a-b5c4-2f6a69d325fd" :answer/type :answer.type/math :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17339/selection/aef21d3c5ab1596b65bad3142ea6e4caa99b57727ad049f978f6fa268ff8f39a" :answer/id #uuid "d4621475-a621-5031-ae31-82dc0bd5ba17" :answer/type :answer.type/math :answer/value "x={30}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17339/selection/3684caaa8d0f35aca63cb5f9d89127e68b062d19749583e335a6444d16cca268" :answer/id #uuid "63a47322-70c4-5c85-929b-378b73b26f7e" :answer/type :answer.type/math :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17339/selection/c88c2f7f1e13f4adbf8ce7cbe38871bd4d416816d7482aa42fbef5d999c7e8e4" :answer/id #uuid "0ebed461-7d9d-5885-a986-562891152590" :answer/type :answer.type/math :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={150}^{∘}+n\\cdot {360}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17339/selection/00889b9aff8b605e4232fef11779d8f2f6b6afe9ecb7299196d2f236aedc474d" :answer/id #uuid "50250ec1-2b12-5dec-a12a-87792fd4e8e5" :answer/type :answer.type/math :answer/value "x={60}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17339/selection" :answer-field/id #uuid "59dba2d5-059d-5c90-a402-fbb12321fb4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17339/selection/3684caaa8d0f35aca63cb5f9d89127e68b062d19749583e335a6444d16cca268" :answer-field/choices ["q-17339/selection/0ef3267027edac74be1db348e3d39cb78ea594c8594ab144b35ba9c73928df24" "q-17339/selection/aef21d3c5ab1596b65bad3142ea6e4caa99b57727ad049f978f6fa268ff8f39a" "q-17339/selection/3684caaa8d0f35aca63cb5f9d89127e68b062d19749583e335a6444d16cca268" "q-17339/selection/c88c2f7f1e13f4adbf8ce7cbe38871bd4d416816d7482aa42fbef5d999c7e8e4" "q-17339/selection/00889b9aff8b605e4232fef11779d8f2f6b6afe9ecb7299196d2f236aedc474d"] :db/ensure [:answer-field/validate]} {:db/id "q-17339" :question/id #uuid "1ddbf3d9-8889-58ba-a6a1-5eb2cc14cb5a" :question/math-academy-id "q-17339" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/6839910f0269266caf6888e1e921506bd9585c6805e3d787538771cf379901f7.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{cos}⁡x$ and $y=\\frac{\\sqrt{3}}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." :question/worked-solution "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has ${\\theta }_{R}={30}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nHence, the general solution for the given equation is\n\n$$\nx={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17339/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff04ceeb-c9f6-5562-b494-204eb62d7f5b"] :knowledge-point/questions ["q-17339"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274744/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "d6c27cab-03ce-5394-8d8f-1e2f560530e1" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-274744/field-1" :answer-field/id #uuid "e7462b08-0ee9-59b5-b0a5-3266ebcdd84a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274744/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-274744/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-274744/field-2/e792eba67a521531d68e5f67786d5b3cea0fc3869014543152be243f2639fb08" :answer/id #uuid "3217e18c-ea63-5152-9526-af1909f36b7f" :answer/type :answer.type/math :answer/value "300" :db/ensure [:answer/validate]} {:db/id "q-274744/field-2" :answer-field/id #uuid "e68a6708-0acc-5768-860e-bacabf64390a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274744/field-2/e792eba67a521531d68e5f67786d5b3cea0fc3869014543152be243f2639fb08" :answer-field/choices ["q-274744/field-2/e792eba67a521531d68e5f67786d5b3cea0fc3869014543152be243f2639fb08"] :db/ensure [:answer-field/validate]} {:db/id "q-274744/field-3/fa2764e4d443b0fd1a8b9b79f38b985d2b576f72681c3b867c06cfeb24c839e4" :answer/id #uuid "bfd121a4-c00e-5d67-967b-123cc03b7a4f" :answer/type :answer.type/math :answer/value "360" :db/ensure [:answer/validate]} {:db/id "q-274744/field-3" :answer-field/id #uuid "ac59376b-afec-5bb1-9c29-f7ae8da197dc" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274744/field-3/fa2764e4d443b0fd1a8b9b79f38b985d2b576f72681c3b867c06cfeb24c839e4" :answer-field/choices ["q-274744/field-3/fa2764e4d443b0fd1a8b9b79f38b985d2b576f72681c3b867c06cfeb24c839e4"] :db/ensure [:answer-field/validate]} {:db/id "q-274744" :question/id #uuid "5dfa9c3a-a9ef-5e35-a9ef-db0765b2c2f4" :question/math-academy-id "q-274744" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/e4845bc1fbe702020161e15391e0c2bf8b8c2ee4fcd953790707ce5505d4df56.png)\n\nThe graph above shows a portion of the curve $y=\\operatorname{sec}⁡x$ and the line $y=2.$ The expressions \n\n$$\nx={\\theta }_{1}+n\\cdot b,\\,x={\\theta }_{2}+n\\cdot b,\n$$\n\nwhere ${\\theta }_{1}<{\\theta }_{2}$ and $n$ is an integer, generate the $x$-values of all of the points of intersection. Find the values of ${\\theta }_{1}$ and ${\\theta }_{2}$ in $[0,{360}^{∘}),$ and the value of $b.$\n\n${\\theta }_{1}=${{field-1}}${}^{∘},\\,{\\theta }_{2}=$\n{{field-2}}${}^{∘},\\,b=$\n{{field-3}}${}^{∘}$" :question/worked-solution "At the intersection points, the $y$-values are the same for both graphs. This gives the equation\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡x=2.\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}.\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the $4$th quadrant, and it also has ${\\theta }_{R}={60}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/40879eca8abd0b5b45d233a6aafe8642a10aaa7cf91b090bee86b47333beb0b8.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nThe general solution for the given equation is \n\n$$\nx={60}^{∘}+n\\cdot {360}^{∘},\\,x=-{60}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nWriting this as $x=\\theta +n\\cdot {360}^{∘},$ where $\\theta \\in [0,{360}^{∘}),$ we get\n\n$$\nx={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nTherefore, since ${\\theta }_{1}<{\\theta }_{2},$ we have ${\\theta }_{1}=60\\,{\\,}^{∘},$ ${\\theta }_{2}=300\\,{\\,}^{∘},$ and $b=360\\,{\\,}^{∘}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274744/field-1" "q-274744/field-2" "q-274744/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff04ceeb-c9f6-5562-b494-204eb62d7f5b"] :knowledge-point/questions ["q-274744"] :db/ensure [:knowledge-point/validate]} {:db/id "q-322666/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" :answer/id #uuid "293a6d5b-1db4-535e-b558-6a6a4d2ee76b" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-322666/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08" :answer/id #uuid "aaa0ec33-7bcc-5d2d-b62f-e98e656edcd9" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-322666/field-1" :answer-field/id #uuid "4d7000d9-5014-5fc1-a7d2-c2668779597a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322666/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" :answer-field/choices ["q-322666/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" "q-322666/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08"] :db/ensure [:answer-field/validate]} {:db/id "q-322666/field-2/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a" :answer/id #uuid "09a92b36-5544-5621-ae1c-f38cf9ae7e6e" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-322666/field-2" :answer-field/id #uuid "e53b8915-f7a4-54f5-9dbb-fb57332172a5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322666/field-2/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a" :answer-field/choices ["q-322666/field-2/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a"] :db/ensure [:answer-field/validate]} {:db/id "q-322666/field-3/f37b140e44c3c1469a0b674232c5aaeb4f71e6e7b8d79e0c213b062c66caacc7" :answer/id #uuid "e74454dc-8c8b-5e40-8157-911fba137766" :answer/type :answer.type/math :answer/value "2\\pi" :db/ensure [:answer/validate]} {:db/id "q-322666/field-3" :answer-field/id #uuid "9174379f-e5dc-5a2a-ae62-b966c0c7ab0a" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-322666/field-3/f37b140e44c3c1469a0b674232c5aaeb4f71e6e7b8d79e0c213b062c66caacc7" :answer-field/choices ["q-322666/field-3/f37b140e44c3c1469a0b674232c5aaeb4f71e6e7b8d79e0c213b062c66caacc7"] :db/ensure [:answer-field/validate]} {:db/id "q-322666" :question/id #uuid "7446f0da-7ec8-5bd8-8eef-790153fe681a" :question/math-academy-id "q-322666" :question/problem "Assuming that $n$ is an integer, the general solution to the equation $3\\operatorname{csc}⁡x-6=0$ is given by \n\n$$\nx={\\theta }_{1}+bn,\\,x={\\theta }_{2}+bn,\n$$\n\nwhere ${\\theta }_{1}<{\\theta }_{2}.$ Find the values of ${\\theta }_{1}$ and ${\\theta }_{2}$ in $[0,2\\pi ),$ and the value of $b.$\n\n${\\theta }_{1}=${{field-1}}$,\\,{\\theta }_{2}=$\n{{field-2}}$,\\,b=$\n{{field-3}}" :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}3\\,\\operatorname{csc}⁡x-6 & =0 \\\\ 3\\,\\operatorname{csc}⁡x & =6 \\\\ \\operatorname{csc}⁡x & =2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=arcsin\\,(\\frac{1}{2})=\\frac{\\pi }{6}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the $2$nd quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/b0738a8a505b89ff687cb4de350a00f2e10d6209fbeee7dcdfdf0ee359a9cc3c.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nThe general solution for the given equation is\n\n$$\nx=\\frac{\\pi }{6}+2\\pi n,\\,x=\\frac{5\\pi }{6}+2\\pi n.\n$$\n\nTherefore, since ${\\theta }_{1}<{\\theta }_{2},$ we have ${\\theta }_{1}=\\frac{\\pi }{6},\\text{ }{\\theta }_{2}=\\frac{5\\pi }{6},\\text{ }\\text{and}\\text{ }b=2\\pi .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-322666/field-1" "q-322666/field-2" "q-322666/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6a231e4f-d6b3-549f-81d4-30c0a883f9b4"] :knowledge-point/questions ["q-322666"] :db/ensure [:knowledge-point/validate]} {:db/id "q-323843/field-1/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" :answer/id #uuid "341a660b-e7f8-5c18-9c14-309c24a87c35" :answer/type :answer.type/math :answer/value "75" :db/ensure [:answer/validate]} {:db/id "q-323843/field-1" :answer-field/id #uuid "c4a48f17-6e9a-552e-bac0-e4a8f071a5be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323843/field-1/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" :answer-field/choices ["q-323843/field-1/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a"] :db/ensure [:answer-field/validate]} {:db/id "q-323843/field-2/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer/id #uuid "1d7036a9-2cd7-5510-a9d5-eadf45db9286" :answer/type :answer.type/math :answer/value "180" :db/ensure [:answer/validate]} {:db/id "q-323843/field-2" :answer-field/id #uuid "e4a3a5b8-baf3-502a-8430-417e122e8ebf" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323843/field-2/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer-field/choices ["q-323843/field-2/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18"] :db/ensure [:answer-field/validate]} {:db/id "q-323843" :question/id #uuid "d1ef0895-423f-5f39-a7ff-9f2f0d08d420" :question/math-academy-id "q-323843" :question/problem "Find the general solution to the equation $\\operatorname{cot}⁡x=\\frac{1}{\\sqrt{3}+2}$ in the form $x=\\theta +n\\cdot b$ where $\\theta \\in [0,{180}^{∘}),$ $n$ is an integer and $b$ is the period in degrees.\n\n*Hint: You may use the fact that $tan\\,({75}^{∘})=\\sqrt{3}+2.$*\n\n$x=$\n{{field-1}}${}^{∘}+\\,n\\,\\cdot $\n{{field-2}}${}^{∘}$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{tan}⁡x} & =\\frac{1}{\\sqrt{3}+2} \\\\ \\operatorname{tan}⁡x & =\\sqrt{3}+2.\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(\\sqrt{3}+2)={75}^{∘}\n$$\n\nThe tangent function has a period of ${180}^{∘}.$  Hence, the general solution for the given equation is\n\n$$\nx={75}^{∘}+n\\cdot {180}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-323843/field-1" "q-323843/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aa20dbfa-3f6f-5caf-9c10-906f2422f161"] :knowledge-point/questions ["q-323843"] :db/ensure [:knowledge-point/validate]}]
