-5994-8db4-43e21e810b64" 13194139534371 true] [17592186284552 1034 "x=-{60}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284552 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284552 1111 #uuid "b396ed97-56e2-57e0-9c61-ca0bc74a72c3" 13194139534371 true] [17592186284553 1034 "x=-{30}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284553 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284553 1111 #uuid "cd948c03-41a4-5aac-ba09-664e32463ccc" 13194139534371 true] [17592186284554 1034 "x=-{150}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284554 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284554 1111 #uuid "070e3404-9bfe-5464-a8f0-09d537e53b3f" 13194139534371 true] [17592186284555 1034 "x={30}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284555 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284555 1111 #uuid "d62c12e5-70a4-5c20-93c2-5f4a3c1d98f1" 13194139534371 true] [17592186284556 1017 #edb/ref 17592186284557 13194139534371 true] [17592186284556 1089 "q-17339" 13194139534371 true] [17592186284556 1091 #edb/ref 17592186045463 13194139534371 true] [17592186284556 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/6839910f0269266caf6888e1e921506bd9585c6805e3d787538771cf379901f7.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{cos}⁡x$ and $y=\\frac{\\sqrt{3}}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." 13194139534371 true] [17592186284556 1113 #uuid "1ddbf3d9-8889-58ba-a6a1-5eb2cc14cb5a" 13194139534371 true] [17592186284556 1145 "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has ${\\theta }_{R}={30}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nHence, the general solution for the given equation is\n\n$$\nx={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}.\n$$" 13194139534371 true] [17592186284557 1000 #edb/ref 17592186284558 13194139534371 true] [17592186284557 1000 #edb/ref 17592186284559 13194139534371 true] [17592186284557 1000 #edb/ref 17592186284560 13194139534371 true] [17592186284557 1000 #edb/ref 17592186284561 13194139534371 true] [17592186284557 1000 #edb/ref 17592186284562 13194139534371 true] [17592186284557 1040 #edb/ref 17592186045450 13194139534371 true] [17592186284557 1041 "selection" 13194139534371 true] [17592186284557 1104 #edb/ref 17592186284560 13194139534371 true] [17592186284557 1110 #uuid "59dba2d5-059d-5c90-a402-fbb12321fb4e" 13194139534371 true] [17592186284558 1034 "x={60}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284558 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284558 1111 #uuid "50250ec1-2b12-5dec-a12a-87792fd4e8e5" 13194139534371 true] [17592186284559 1034 "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" 13194139534371 true] [17592186284559 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284559 1111 #uuid "4bd914ed-e7e2-585a-b5c4-2f6a69d325fd" 13194139534371 true] [17592186284560 1034 "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" 13194139534371 true] [17592186284560 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284560 1111 #uuid "63a47322-70c4-5c85-929b-378b73b26f7e" 13194139534371 true] [17592186284561 1034 "x={30}^{∘}+n\\cdot {180}^{∘}" 13194139534371 true] [17592186284561 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284561 1111 #uuid "d4621475-a621-5031-ae31-82dc0bd5ba17" 13194139534371 true] [17592186284562 1034 "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={150}^{∘}+n\\cdot {360}^{∘}" 13194139534371 true] [17592186284562 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284562 1111 #uuid "0ebed461-7d9d-5885-a986-562891152590" 13194139534371 true] [17592186284563 1017 #edb/ref 17592186284564 13194139534371 true] [17592186284563 1017 #edb/ref 17592186284566 13194139534371 true] [17592186284563 1017 #edb/ref 17592186284568 13194139534371 true] [17592186284563 1089 "q-274744" 13194139534371 true] [17592186284563 1091 #edb/ref 17592186045465 13194139534371 true] [17592186284563 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/e4845bc1fbe702020161e15391e0c2bf8b8c2ee4fcd953790707ce5505d4df56.png)\n\nThe graph above shows a portion of the curve $y=\\operatorname{sec}⁡x$ and the line $y=2.$ The expressions \n\n$$\nx={\\theta }_{1}+n\\cdot b,\\,x={\\theta }_{2}+n\\cdot b,\n$$\n\nwhere ${\\theta }_{1}<{\\theta }_{2}$ and $n$ is an integer, generate the $x$-values of all of the points of intersection. Find the values of ${\\theta }_{1}$ and ${\\theta }_{2}$ in $[0,{360}^{∘}),$ and the value of $b.$\n\n${\\theta }_{1}=${{field-1}}${}^{∘},\\,{\\theta }_{2}=$\n{{field-2}}${}^{∘},\\,b=$\n{{field-3}}${}^{∘}$" 13194139534371 true] [17592186284563 1113 #uuid "5dfa9c3a-a9ef-5e35-a9ef-db0765b2c2f4" 13194139534371 true] [17592186284563 1145 "At the intersection points, the $y$-values are the same for both graphs. This gives the equation\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡x=2.\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}.\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the $4$th quadrant, and it also has ${\\theta }_{R}={60}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/40879eca8abd0b5b45d233a6aafe8642a10aaa7cf91b090bee86b47333beb0b8.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nThe general solution for the given equation is \n\n$$\nx={60}^{∘}+n\\cdot {360}^{∘},\\,x=-{60}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nWriting this as $x=\\theta +n\\cdot {360}^{∘},$ where $\\theta \\in [0,{360}^{∘}),$ we get\n\n$$\nx={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nTherefore, since ${\\theta }_{1}<{\\theta }_{2},$ we have ${\\theta }_{1}=60\\,{\\,}^{∘},$ ${\\theta }_{2}=300\\,{\\,}^{∘},$ and $b=360\\,{\\,}^{∘}.$" 13194139534371 true] [17592186284564 1000 #edb/ref 17592186284565 13194139534371 true] [17592186284564 1040 #edb/ref 17592186045449 13194139534371 true] [17592186284564 1041 "field-1" 13194139534371 true] [17592186284564 1104 #edb/ref 17592186284565 13194139534371 true] [17592186284564 1110 #uuid "e7462b08-0ee9-59b5-b0a5-3266ebcdd84a" 13194139534371 true] [17592186284565 1034 "60" 13194139534371 true] [17592186284565 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284565 1111 #uuid "d6c27cab-03ce-5394-8d8f-1e2f560530e1" 13194139534371 true] [17592186284566 1000 #edb/ref 17592186284567 13194139534371 true] [17592186284566 1040 #edb/ref 17592186045449 13194139534371 true] [17592186284566 1041 "field-2" 13194139534371 true] [17592186284566 1104 #edb/ref 17592186284567 13194139534371 true] [17592186284566 1110 #uuid "e68a6708-0acc-5768-860e-bacabf64390a" 13194139534371 true] [17592186284567 1034 "300" 13194139534371 true] [17592186284567 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284567 1111 #uuid "3217e18c-ea63-5152-9526-af1909f36b7f" 13194139534371 true] [17592186284568 1000 #edb/ref 17592186284569 13194139534371 true] [17592186284568 1040 #edb/ref 17592186045449 13194139534371 true] [17592186284568 1041 "field-3" 13194139534371 true] [17592186284568 1104 #edb/ref 17592186284569 13194139534371 true] [17592186284568 1110 #uuid "ac59376b-afec-5bb1-9c29-f7ae8da197dc" 13194139534371 true] [17592186284569 1034 "360" 13194139534371 true] [17592186284569 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284569 1111 #uuid "bfd121a4-c00e-5d67-967b-123cc03b7a4f" 13194139534371 true] [17592186284570 1017 #edb/ref 17592186284571 13194139534371 true] [17592186284570 1017 #edb/ref 17592186284574 13194139534371 true] [17592186284570 1017 #edb/ref 17592186284576 13194139534371 true] [17592186284570 1089 "q-322666" 13194139534371 true] [17592186284570 1091 #edb/ref 17592186045465 13194139534371 true] [17592186284570 1100 "Assuming that $n$ is an integer, the general solution to the equation $3\\operatorname{csc}⁡x-6=0$ is given by \n\n$$\nx={\\theta }_{1}+bn,\\,x={\\theta }_{2}+bn,\n$$\n\nwhere ${\\theta }_{1}<{\\theta }_{2}.$ Find the values of ${\\theta }_{1}$ and ${\\theta }_{2}$ in $[0,2\\pi ),$ and the value of $b.$\n\n${\\theta }_{1}=${{field-1}}$,\\,{\\theta }_{2}=$\n{{field-2}}$,\\,b=$\n{{field-3}}" 13194139534371 true] [17592186284570 1113 #uuid "7446f0da-7ec8-5bd8-8eef-790153fe681a" 13194139534371 true] [17592186284570 1145 "First, we rearrange the equation and isolate $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}3\\,\\operatorname{csc}⁡x-6 & =0 \\\\ 3\\,\\operatorname{csc}⁡x & =6 \\\\ \\operatorname{csc}⁡x & =2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=arcsin\\,(\\frac{1}{2})=\\frac{\\pi }{6}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the $2$nd quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994895/assets/b0738a8a505b89ff687cb4de350a00f2e10d6209fbeee7dcdfdf0ee359a9cc3c.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nThe general solution for the given equation is\n\n$$\nx=\\frac{\\pi }{6}+2\\pi n,\\,x=\\frac{5\\pi }{6}+2\\pi n.\n$$\n\nTherefore, since ${\\theta }_{1}<{\\theta }_{2},$ we have ${\\theta }_{1}=\\frac{\\pi }{6},\\text{ }{\\theta }_{2}=\\frac{5\\pi }{6},\\text{ }\\text{and}\\text{ }b=2\\pi .$" 13194139534371 true] [17592186284571 1000 #edb/ref 17592186284572 13194139534371 true] [17592186284571 1000 #edb/ref 17592186284573 13194139534371 true] [17592186284571 1040 #edb/ref 17592186045449 13194139534371 true] [17592186284571 1041 "field-1" 13194139534371 true] [17592186284571 1104 #edb/ref 17592186284572 13194139534371 true] [17592186284571 1110 #uuid "4d7000d9-5014-5fc1-a7d2-c2668779597a" 13194139534371 true] [17592186284572 1034 "\\frac{\\pi}{6}" 13194139534371 true] [17592186284572 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284572 1111 #uuid "293a6d5b-1db4-535e-b558-6a6a4d2ee76b" 13194139534371 true] [17592186284573 1034 "\\frac{\\pi}{3}" 13194139534371 true] [17592186284573 1103 #edb/ref 17592186045453 13194139534371 true] [17592186284573 1111 #uuid "aaa0ec33-7bcc-5d2d-b62f-e98e656edcd9" 131941