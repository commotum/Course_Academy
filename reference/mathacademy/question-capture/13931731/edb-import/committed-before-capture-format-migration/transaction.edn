its, so $n=6.$ We want to select $4$ of those digits for the passcode, so we have $r=4.$ \n\nTherefore, the number of different passcodes is \n\n$$\n\\begin{aligned}{}_{6}{P}_{4} & =\\frac{6!}{(6-4)!} \\\\  & =\\frac{6!}{2!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =6\\cdot 5\\cdot 4\\cdot 3 \\\\  & =360.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9"] :knowledge-point/questions ["q-84978"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122233/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "e0d4cc6c-817e-53a2-a366-c0d10cbe6a53" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-122233/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ec744e7f-bc4e-56b9-acfa-9c1ecac912f4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-122233/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "55f0e79f-797f-5833-9f14-c06a6304c31b" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-122233/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "607fdaf5-7073-52b8-ae26-68adae34ab30" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-122233/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "4fab4e2f-7535-5870-b2a3-822e38827406" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-122233/selection" :answer-field/id #uuid "b000454b-8d8a-5922-aabd-1682d36a0d67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122233/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-122233/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-122233/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-122233/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" "q-122233/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-122233/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-122233" :question/id #uuid "8de5a14a-1960-5058-86a3-9b2c571140bb" :question/math-academy-id "q-122233" :question/is-example false :question/problem "Ashley has $5$ tasks. She decides to do one on Thursday and another on Friday. How many different choices of the two tasks does Ashley have?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $5$ tasks to choose from, so $n=5.$ We want to select $2$ of those for Ashley to do, so we have $r=2.$ \n\nTherefore, the number of different choices is\n\n$$\n\\begin{aligned}{}_{5}{P}_{2} & =\\frac{5!}{(5-2)!} \\\\  & =\\frac{5!}{3!} \\\\  & =\\frac{5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =5\\cdot 4 \\\\  & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122233/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9"] :knowledge-point/questions ["q-122233"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84979/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "6b2f5314-8c10-594e-a73e-ecb60654d83e" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-84979/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "4b27b12b-bef1-55a2-a406-78b906bd5395" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-84979/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer/id #uuid "3b8280b3-8cee-5144-8937-d97589f514e1" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "q-84979/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "f8738ba7-d816-58ea-8a50-14c291682adf" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-84979/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "067683bd-abbc-58a7-993f-6f3886778726" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-84979/selection" :answer-field/id #uuid "679a6f3d-b4f8-5429-9c9e-91dd72c829e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84979/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer-field/choices ["q-84979/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" "q-84979/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" "q-84979/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" "q-84979/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-84979/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c"] :db/ensure [:answer-field/validate]} {:db/id "q-84979" :question/id #uuid "76ea7dfe-886c-53a9-9a24-059c41ea4262" :question/math-academy-id "q-84979" :question/is-example false :question/problem "Of the $7$ students who are going to take a test, the top $2$ will get different prizes. In how many ways can both prizes be awarded?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $7$ students, so $n=7.$ We want to select $2$ of those students for both the prizes, so we have $r=2.$ \n\nTherefore, the number of different ways to award the prizes is \n\n$$\n\\begin{aligned}{}_{7}{P}_{2} & =\\frac{7!}{(7-2)!} \\\\  & =\\frac{7!}{5!} \\\\  & =\\frac{7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =7\\cdot 6 \\\\  & =42.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84979/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9"] :knowledge-point/questions ["q-84979"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84983/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "ad882a67-604a-55f8-9713-1ebe17c0a0ca" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-84983/selection/4fc5c8f33dd1402d61c3b32cd95b1df9f8f40884748b122dc4bc6504362d8c06" :answer/id #uuid "522d96c4-9029-50e1-a11f-93417e2d4c71" :answer/type :answer.type/math :answer/value "3\\,024" :db/ensure [:answer/validate]} {:db/id "q-84983/selection/de16c984d1eb79cd8c7cf62c94e408b707a961b2747b5ca555670db6f8b7be5a" :answer/id #uuid "0cbde4fc-85c6-5dc2-9988-92bb6e038ca5" :answer/type :answer.type/math :answer/value "15\\,120" :db/ensure [:answer/validate]} {:db/id "q-84983/selection/200281aa839b31ffa2b31f13d7ef2e8552c45af89e232234ffd41fa1e8883d60" :answer/id #uuid "8b00b64e-2670-54f8-ba60-5e7add84dd48" :answer/type :answer.type/math :answer/value "2\\,016" :db/ensure [:answer/validate]} {:db/id "q-84983/selection/a6587dc8f80ca7ee69256d458805ce0606765e42d21ad3fe374214ae5189b375" :answer/id #uuid "fc8c794d-687a-5c4b-860c-16ab5dd040cb" :answer/type :answer.type/math :answer/value "1\\,344" :db/ensure [:answer/validate]} {:db/id "q-84983/selection" :answer-field/id #uuid "0a20e807-b532-5b5d-86ac-8f2c92c8065b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84983/selection/4fc5c8f33dd1402d61c3b32cd95b1df9f8f40884748b122dc4bc6504362d8c06" :answer-field/choices ["q-84983/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" "q-84983/selection/4fc5c8f33dd1402d61c3b32cd95b1df9f8f40884748b122dc4bc6504362d8c06" "q-84983/selection/de16c984d1eb79cd8c7cf62c94e408b707a961b2747b5ca555670db6f8b7be5a" "q-84983/selection/200281aa839b31ffa2b31f13d7ef2e8552c45af89e232234ffd41fa1e8883d60" "q-84983/selection/a6587dc8f80ca7ee69256d458805ce0606765e42d21ad3fe374214ae5189b375"] :db/ensure [:answer-field/validate]} {:db/id "q-84983" :question/id #uuid "4ef67e9d-56e9-502f-9f38-dd41f4d01e7c" :question/math-academy-id "q-84983" :question/is-example false :question/problem "A bag contains $9$ different colored marbles. Jamie takes $4$ marbles from the bag, one at a time, and puts them in the order they were taken from the bag to create a sequence of colors. How many different sequences of colors are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $9$ colored marbles, so $n=9.$ We want to select $4$ of those marbles to make a sequence of colors, so we have $r=4.$ \n\nTherefore, the number of different ways to choose the marbles is \n\n$$\n\\begin{aligned}{}_{9}{P}_{4} & =\\frac{9!}{(9-4)!} \\\\  & =\\frac{9!}{5!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =9\\cdot 8\\cdot 7\\cdot 6 \\\\  & =3\\,024.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84983/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9"] :knowledge-point/questions ["q-84983"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1791/selection/8815a52bb7709c969bf878c9c39334f20fb397a71acb3417f1d27bbf7b8baba7" :answer/id #uuid "7970e71b