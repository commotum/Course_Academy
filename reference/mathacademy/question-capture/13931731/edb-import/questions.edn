5787-91d1-2ff69135fb16" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186243792} {:answer/id #uuid "6dcb1e18-7c9c-51ea-9e87-8cbdae59b767" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186243793} {:answer/id #uuid "af968b23-84a6-5ce7-86b5-2041c90504bb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186243794} {:answer/id #uuid "06d1ac18-5f64-5831-af00-e25a208cc426" :answer/type {:db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186243795} {:answer/id #uuid "5f66ddb8-86b4-5a61-a570-138553eb648b" :answer/type {:db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186243796}] :answer-field/correct {:answer/id #uuid "6dcb1e18-7c9c-51ea-9e87-8cbdae59b767" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186243793} :answer-field/id #uuid "148b68a1-9988-5c0b-8340-8964a8cd4e07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243791}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b1198cf2-96b8-5b7c-bdc4-b79e3231eb29" :question/math-academy-id "q-85049" :question/problem "$P(7,7)=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,7)$ means the same thing as ${}_{7}{P}_{7}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,7) & =\\frac{7!}{(7-7)!} \\\\  & =\\frac{7!}{0!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot 3\\cdot 2\\cdot 1}{1} \\\\  & =5\\,040.\\end{aligned}\n$$"}]}
