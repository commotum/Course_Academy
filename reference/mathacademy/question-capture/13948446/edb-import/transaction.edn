d #uuid "0cb5000c-1e8c-55a2-9990-20266613c4d9" :answer/type :answer.type/math :answer/value "({x}^{2}+3)({x}^{2}-3)" :db/ensure [:answer/validate]} {:db/id "q-87324/selection/0d6c9d693b98058c8b0fe1e25913392fb4a24c0c1e69cf1bac17e5e6f0e10c91" :answer/id #uuid "70115adc-d19d-52d2-bce1-1c6fd1e66d0a" :answer/type :answer.type/math :answer/value "{({x}^{2}-3\\text{i})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-87324/selection/64e0f1ef6859fc9a595e7c78a01a1a83b2c6ba911274de4dc6a85c293891ee8b" :answer/id #uuid "ebb215aa-417a-5920-8a59-5fce4c5deeb1" :answer/type :answer.type/math :answer/value "({x}^{2}+3\\text{i})({x}^{2}-3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-87324/selection/9975cbe9a1c04ac9b2e28e0bfd48004951ec0bc241387f07ab39e192927ca40d" :answer/id #uuid "3178792c-3f8b-5241-9f57-9b0dda5615eb" :answer/type :answer.type/math :answer/value "{({x}^{2}+3\\text{i})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-87324/selection/5df49f0406769eeae307709f751cad9ad3cdf7a30990f5e62139a663c0598393" :answer/id #uuid "69bed38c-8082-55ba-aed2-b0a8e60186a1" :answer/type :answer.type/math :answer/value "{({x}^{2}-3)}^{2}" :db/ensure [:answer/validate]} {:db/id "q-87324/selection" :answer-field/id #uuid "24c48979-d367-54b0-8c18-1189df6e545f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87324/selection/64e0f1ef6859fc9a595e7c78a01a1a83b2c6ba911274de4dc6a85c293891ee8b" :answer-field/choices ["q-87324/selection/4369f5b104906c8065c4788059b96b9d6781303429cdf39ebb28672b7c9a2b45" "q-87324/selection/0d6c9d693b98058c8b0fe1e25913392fb4a24c0c1e69cf1bac17e5e6f0e10c91" "q-87324/selection/64e0f1ef6859fc9a595e7c78a01a1a83b2c6ba911274de4dc6a85c293891ee8b" "q-87324/selection/9975cbe9a1c04ac9b2e28e0bfd48004951ec0bc241387f07ab39e192927ca40d" "q-87324/selection/5df49f0406769eeae307709f751cad9ad3cdf7a30990f5e62139a663c0598393"] :db/ensure [:answer-field/validate]} {:db/id "q-87324" :question/id #uuid "4346369e-cdee-51e0-b640-ab0ca22e5f6f" :question/math-academy-id "q-87324" :question/problem "Factor ${x}^{4}+9.$" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n{x}^{4}+9={({x}^{2})}^{2}+{3}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}{x}^{4}+9 & ={x}^{4}-(-9) \\\\  & ={x}^{4}-(9{\\text{i}}^{2}) \\\\  & ={({x}^{2})}^{2}-{(3\\text{i})}^{2} \\\\  & =({x}^{2}+3\\text{i})({x}^{2}-3\\text{i})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87324/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-87324"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320744/field-1/f9a839614e34ff2776cd0776f724ebb47eef62305809e64703538209cdc5e4d7" :answer/id #uuid "6189679e-cab4-5533-b8d2-07511bcc5006" :answer/type :answer.type/math :answer/value "(r^3+2i)(r^3-2i)" :db/ensure [:answer/validate]} {:db/id "q-320744/field-1/73c6d6a92dad117f85e2121c5004d9803ff15ec24a37534b75b98c240af51f17" :answer/id #uuid "5a01336f-3aed-541f-bc4b-24849652ca8e" :answer/type :answer.type/math :answer/value "(r^3+2)(r^3-2)" :db/ensure [:answer/validate]} {:db/id "q-320744/field-1" :answer-field/id #uuid "feaadf76-1ae8-5c97-9976-80e4ba3ccda2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320744/field-1/f9a839614e34ff2776cd0776f724ebb47eef62305809e64703538209cdc5e4d7" :answer-field/choices ["q-320744/field-1/f9a839614e34ff2776cd0776f724ebb47eef62305809e64703538209cdc5e4d7" "q-320744/field-1/73c6d6a92dad117f85e2121c5004d9803ff15ec24a37534b75b98c240af51f17"] :db/ensure [:answer-field/validate]} {:db/id "q-320744" :question/id #uuid "7af5c447-534a-541e-a009-eb560d8f021f" :question/math-academy-id "q-320744" :question/problem "Write ${r}^{6}+4$ in factored form by rewriting the second term of the expression as the square of an imaginary number. Use $i$ to denote the imaginary unit.\n\n${r}^{6}+4=$\n{{field-1}}" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n{r}^{6}+4={({r}^{3})}^{2}+{2}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${i}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}{r}^{6}+4 & ={r}^{6}-(-4) \\\\  & ={r}^{6}-(4{i}^{2}) \\\\  & ={({r}^{3})}^{2}-{(2i)}^{2} \\\\  & =({r}^{3}+2i)({r}^{3}-2i)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320744/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-320744"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320771/field-1/6d44b433d4ef5d34cde03aca4ded694750dd1b7ae8587d2860af17db455bdb9d" :answer/id #uuid "7fd477c0-dba7-51cf-957a-97b536ee5ca2" :answer/type :answer.type/math :answer/value "(4p^6+im^5)(4p^6-im^5)" :db/ensure [:answer/validate]} {:db/id "q-320771/field-1" :answer-field/id #uuid "d4e56128-ce3b-50cd-b4cd-f7f718a2a0bf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320771/field-1/6d44b433d4ef5d34cde03aca4ded694750dd1b7ae8587d2860af17db455bdb9d" :answer-field/choices ["q-320771/field-1/6d44b433d4ef5d34cde03aca4ded694750dd1b7ae8587d2860af17db455bdb9d"] :db/ensure [:answer-field/validate]} {:db/id "q-320771" :question/id #uuid "d788f9e8-a357-5b0b-8ecb-f9a36fd7b3ea" :question/math-academy-id "q-320771" :question/problem "Write $16{p}^{12}+{m}^{10}$ in factored form by rewriting the second term of the expression as the square of an imaginary number. Use $i$ to denote the imaginary unit.\n\n$16{p}^{12}+{m}^{10}=$\n{{field-1}}" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n16{p}^{12}+{m}^{10}={(4{p}^{6})}^{2}+{({m}^{5})}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${i}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}16{p}^{12}+{m}^{10} & =16{p}^{12}-(-{m}^{10}) \\\\  & =16{p}^{12}-({i}^{2}{m}^{10}) \\\\  & ={(4{p}^{6})}^{2}-{(i{m}^{5})}^{2} \\\\  & =(4{p}^{6}+i{m}^{5})(4{p}^{6}-i{m}^{5})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-320771/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-320771"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170499/selection/c7ba53b8f9ef048bf9fc8829b66882ebdeb0aeb520813e7bdec02c1be58a6dd8" :answer/id #uuid "37637c55-4a7f-59e9-a30b-b1cf5ceca5ed" :answer/type :answer.type/math :answer/value "49({t}^{6}+3\\text{i})({t}^{6}-3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-170499/selection/2a6a600533bd1ebc08a81a35a2d64f6b9aa68b5abdd2ce77655c3b80d3150330" :answer/id #uuid "52dd5c12-cb2f-5a9c-9b95-3df7f5012747" :answer/type :answer.type/math :answer/value "(7{t}^{6}+3\\text{i})(7{t}^{6}-3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-170499/selection/3d9362fd2ef13d3f0c7770116a6abee0a633da98d9d749402505d75f9e7a1f7d" :answer/id #uuid "04141cc7-73a3-57e7-b905-0884ea8e2fbd" :answer/type :answer.type/math :answer/value "9(7{t}^{6}+\\text{i})(7{t}^{6}-\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-170499/selection/41c9de9f7139a4addae18b7898608b7e824129a45a7f1a07906076969699d2b9" :answer/id #uuid "633fa9e4-b7c4-514e-b80f-ee59cf61c55f" :answer/type :answer.type/math :answer/value "49({t}^{6}+3)({t}^{6}-3)" :db/ensure [:answer/validate]} {:db/id "q-170499/selection/8f72a76e766f3d123af6579abec7a612cf27ac515094ef20014b4bc919afd9fa" :answer/id #uuid "38a82961-a357-5232-8064-4432bc46e66e" :answer/type :answer.type/math :answer/value "(7{t}^{6}+3)(7{t}^{6}-3)" :db/ensure [:answer/validate]} {:db/id "q-170499/selection" :answer-field/id #uuid "f3c72336-8067-5cc1-aa03-7a61729d441d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170499/selection/2a6a600533bd1ebc08a81a35a2d64f6b9aa68b5abdd2ce77655c3b80d3150330" :answer-field/choices ["q-170499/selection/c7ba53b8f9ef048bf9fc8829b66882ebdeb0aeb520813e7bdec02c1be58a6dd8" "q-170499/selection/2a6a600533bd1ebc08a81a35a2d64f6b9aa68b5abdd2ce77655c3b80d3150330" "q-170499/selection/3d9362fd2ef13d3f0c7770116a6abee0a633da98d9d749402505d75f9e7a1f7d" "q-170499/selection/41c9de9f7139a4addae18b7898608b7e824129a45a7f1a07906076969699d2b9" "q-170499/selection/8f72a76e766f3d123af6579abec7a612cf27ac515094ef20014b4bc919afd9fa"] :db/ensure [:answer-field/validate]} {:db/id "q-170499" :question/id #uuid "c96cb0b5-0ea7-5886-9424-b0c6b79e9292" :question/math-academy-id "q-170499" :question/problem "$49{t}^{12}+9=$" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n49{t}^{12}+9={(7{t}^{6})}^{2}+{3}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}49{t}^{12}+9 & =49{t}^{12}-(-9) \\\\  & =49{t}^{12}-(9{\\text{i}}^{2}) \\\\  & ={(7{t}^{6})}^{2}-(3\\text{i})^{2} \\\\  & =(7{t}^{6}+3\\text{i})(7{t}^{6}-3\\text{i})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170499/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-170499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46502/selection/5b8140e78ab186abadbdec7369dd56e04367a0d8889e8eb5424560bd20e67083" :answer/id #uuid "00b059d6-8f92-5f6a-a773-db97bef047a3" :answer/type :answer.type/math :answer/value "(3m+2{n}^{2})(3m-2{n}^{2})" :db/ensure [:answer/validate]} {:db/id "q-46502/selection/35fa45e206f2b4b0c91b13bb10dd8d7124e28c0e6967eca25714d9a4754fca12" :answer/id #uuid "7f5e8f37-7284-584e-a045-a0a3aadf21bb" :answer/type :answer.type/math :answer/value "9\\,({m}^{2}+\\text{i}{n}^{5})({m}^{2}-\\text{i}{n}^{5})" :db/ensure [:answer/validate]} {:db/id "q-46502/selection/21b08c3cb412e3eea2fb7b3217fcede3d62a5387ae8d279ade0c0aa4ca202467" :answer/id #uuid "91fa2cb5-3f1b-5d19-b814-3be2a0645b82" :answer/type :answer.type/math :answer/value "(3m+2\\text{i}{n}^{2})(3m-2\\text{i}{n}^{2})" :db/ensure [:answer/validate]} {:db/id "q-46502/selection/e16f837d7b32229650d4d575b363cf10d829ebd7fd173f1ad0a11c2bd0fbc95c" :answer/id #uuid "6151af81-45c5-5aa4-9d98-2e201f181e5c" :answer/type :answer.type/math :answer/value "(3{m}^{2}+2\\text{i}{n}^{5})(3{m}^{2}-2\\text{i}{n}^{5})" :db/ensure [:answer/validate]} {:db/id "q-46502/selection/ae2b1d1b2955f0427e390ba89dafda9959f93e5ff5fd80ca94722b4c6fbdb14d" :answer/id #uuid "c17e32af-77b2-5562-baa4-d1094fb33886" :answer/type :answer.type/math :answer/value "9\\,({m}^{2}+2{n}^{5})({m}^{2}-2{n}^{5})" :db/ensure [:answer/validate]} {:db/id "q-46502/selection" :answer-field/id #uuid "fd924dce-3b06-5ec5-a586-aba7a459b1d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46502/selection/e16f837d7b32229650d4d575b363cf10d829ebd7fd173f1ad0a11c2bd0fbc95c" :answer-field/choices ["q-46502/selection/5b8140e78ab186abadbdec7369dd56e04367a0d8889e8eb5424560bd20e67083" "q-46502/selection/35fa45e206f2b4b0c91b13bb10dd8d7124e28c0e6967eca25714d9a4754fca12" "q-46502/selection/21b08c3cb412e3eea2fb7b3217fcede3d62a5387ae8d279ade0c0aa4ca202467" "q-46502/selection/e16f837d7b32229650d4d575b363cf10d829ebd7fd173f1ad0a11c2bd0fbc95c" "q-46502/selection/ae2b1d1b2955f0427e390ba89dafda9959f93e5ff5fd80ca94722b4c6fbdb14d"] :db/ensure [:answer-field/validate]} {:db/id "q-46502" :question/id #uuid "3836c1ea-4956-533e-b395-a4a0ae49ee76" :question/math-academy-id "q-46502" :question/problem "$9{m}^{4}+4{n}^{10}=$" :question/worked-solution "Notice that the given expression is a sum of squares, since\n\n$$\n9{m}^{4}+4{n}^{10}={(3{m}^{2})}^{2}+{(2{n}^{5})}^{2}.\n$$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}9{m}^{4}+4{n}^{10} & =9{m}^{4}-(-4{n}^{10}) \\\\  & =9{m}^{4}-(4{\\text{i}}^{2}{n}^{10}) \\\\  & ={(3{m}^{2})}^{2}-{(2\\text{i}{n}^{5})}^{2} \\\\  & =(3{m}^{2}+2\\text{i}{n}^{5})(3{m}^{2}-2\\text{i}{n}^{5})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-46502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8216c637-fe4d-51fd-b256-0379eb0e7dba"] :knowledge-point/questions ["q-46502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46443/selection/bc6fb9035e6e0263ee3e8fc0fe6011d8ba30f37fb85deb4ad361ab53120f20ba" :answer/id #uuid "5e0fa95a-5b40-5dc2-a62b-94ae3bbea427" :answer/type :answer.type/math :answer/value "p(3+\\text{i}t)(3-\\text{i}t)" :db/ensure [:answer/validate]} {:db/id "q-46443/selection/20fbaad7e159ab4b2059735c54558a951888df498747e25b32a5e3ffdf388355" :answer/id #uuid "eaf812f1-f505-50dc-96f8-00adbe013391" :answer/type :answer.type/math :answer/value "(3+\\text{i}pt)(3-\\text{i}pt)" :db/ensure [:answer/validate]} {:db/id "q-46443/selection/8e89bf18cd6d06311fcd0b6509f7b7fd6bc68d692a428b7fdfbfec8da46a2321" :answer/id #uuid "f0417094-366a-59f0-b827-8f7eab085afd" :answer/type :answer.type/math :answer/value "p(3+t)(3-t)" :db/ensure [:answer/validate]} {:db/id "q-46443/selection/1e1643969c9f030bc567e6614ed081561c90785f1ba55b322d1104867b241001" :answer/id #uuid "c0da53e0-301e-5b0d-a508-b2b007206ea6" :answer/type :answer.type/math :answer/value "(3+pt)(3-pt)" :db/ensure [:answer/validate]} {:db/id "q-46443/selection/c9833069f6b0e03958a19db381d036907e4ca3c92a4f8c2226ab17fce7a79e1e" :answer/id #uuid "aac82f08-e874-5ec0-84c5-449c609571e0" :answer/type :answer.type/math :answer/value "p(3+\\text{i}pt)(3-\\text{i}pt)" :db/ensure [:answer/validate]} {:db/id "q-46443/selection" :answer-field/id #uuid "279ef482-f109-5531-b653-7309f92e0aa2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46443/selection/bc6fb9035e6e0263ee3e8fc0fe6011d8ba30f37fb85deb4ad361ab53120f20ba" :answer-field/choices ["q-46443/selection/bc6fb9035e6e0263ee3e8fc0fe6011d8ba30f37fb85deb4ad361ab53120f20ba" "q-46443/selection/20fbaad7e159ab4b2059735c54558a951888df498747e25b32a5e3ffdf388355" "q-46443/selection/8e89bf18cd6d06311fcd0b6509f7b7fd6bc68d692a428b7fdfbfec8da46a2321" "q-46443/selection/1e1643969c9f030bc567e6614ed081561c90785f1ba55b322d1104867b241001" "q-46443/selection/c9833069f6b0e03958a19db381d036907e4ca3c92a4f8c2226ab17fce7a79e1e"] :db/ensure [:answer-field/validate]} {:db/id "q-46443" :question/id #uuid "90a0851c-25fb-565a-8ffc-02325f1722fc" :question/math-academy-id "q-46443" :question/problem "The expression $9p+p{t}^{2}$ is equivalent to" :question/worked-solution "First, let's factor $p$ from the expression. We have\n\n$$\n9p+p{t}^{2}=p(9+{t}^{2}).\n$$\n\nLet's now focus on factoring the expression $(9+{t}^{2}).$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}9+{t}^{2} & =9-(-{t}^{2}) \\\\  & =9-({\\text{i}}^{2}{t}^{2}) \\\\  & ={3}^{2}-(\\text{i}t)^{2} \\\\  & =(3+\\text{i}t)(3-\\text{i}t)\\end{aligned}\n$$\n\nFinally, substituting this back into our main expression, we get\n\n$$\np(9+{t}^{2})=p(3+\\text{i}t)(3-\\text{i}t).\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-46443/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de6dbad-0ca5-5a17-a04b-cdfd72d6dab5"] :knowledge-point/questions ["q-46443"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320788/field-1/3daf3ebd7035232411fccfa609a34cb1ff3bc6817e537f6a8de1edf505501e94" :answer/id #uuid "08f180a9-ef25-51ac-9b63-cd1b8a146e07" :answer/type :answer.type/math :answer/value "t^5(7t^2+6i)(7t^2-6i)" :db/ensure [:answer/validate]} {:db/id "q-320788/field-1/af8d95e8b1019dd74dcc095cab97c819b631dd8fca19c1b0962cec6b5aa75b7f" :answer/id #uuid "7acc6f4c-587a-55f7-951b-de6ef609f23a" :answer/type :answer.type/math :answer/value "t^5(7t^2+6)(7t^2-6)" :db/ensure [:answer/validate]} {:db/id "q-320788/field-1" :answer-field/id #uuid "b453bf26-4fe6-5175-b1d1-86c390d715f5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320788/field-1/3daf3ebd7035232411fccfa609a34cb1ff3bc6817e537f6a8de1edf505501e94" :answer-field/choices ["q-320788/field-1/3daf3ebd7035232411fccfa609a34cb1ff3bc6817e537f6a8de1edf505501e94" "q-320788/field-1/af8d95e8b1019dd74dcc095cab97c819b631dd8fca19c1b0962cec6b5aa75b7f"] :db/ensure [:answer-field/validate]} {:db/id "q-320788" :question/id #uuid "6ff868e4-26d0-57ff-a62e-75e89aef9101" :question/math-academy-id "q-320788" :question/problem "Write $49{t}^{9}+36{t}^{5}$ in factored form by rewriting the second term of the expression as the square of an imaginary number. Use $i$ to denote the imaginary unit.\n\n$49{t}^{9}+36{t}^{5}=$\n{{field-1}}" :question/worked-solution "First, let's factor out ${t}^{5}$ from the expression:\n\n$$\n49{t}^{9}+36{t}^{5}={t}^{5}\\,(49{t}^{4}+36).\n$$\n\nNow focus on factoring $(49{t}^{4}+36).$  \n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${i}^{2}=-1.$ Finally, we factor it as a difference of squares.\n\n$$\n\\begin{aligned}49{t}^{4}+36 & =49{t}^{4}-(-36) \\\\  & =49{t}^{4}-(36{i}^{2}) \\\\  & =(7{t}^{2})^{2}-(6i)^{2} \\\\  & =(7{t}^{2}+6i)(7{t}^{2}-6i).\\end{aligned}\n$$\n\nSubstituting back, we obtain\n\n$$\n{t}^{5}\\,(49{t}^{4}+36)={t}^{5}(7{t}^{2}+6i)(7{t}^{2}-6i).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320788/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de6dbad-0ca5-5a17-a04b-cdfd72d6dab5"] :knowledge-point/questions ["q-320788"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320785/field-1/6fc6a85a1ad2bb15b156a1736676e92ab3299db8a210359233c5e89f976eaa11" :answer/id #uuid "8ccc25ca-a24e-5ea4-9057-b639c0f711fc" :answer/type :answer.type/math :answer/value "-2(3s+4i)(3s-4i)" :db/ensure [:answer/validate]} {:db/id "q-320785/field-1" :answer-field/id #uuid "f2f33061-699e-532e-9802-00ece96f7f98" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320785/field-1/6fc6a85a1ad2bb15b156a1736676e92ab3299db8a210359233c5e89f976eaa11" :answer-field/choices ["q-320785/field-1/6fc6a85a1ad2bb15b156a1736676e92ab3299db8a210359233c5e89f976eaa11"] :db/ensure [:answer-field/validate]} {:db/id "q-320785" :question/id #uuid "ce872820-a659-5d59-b5ee-57498846afc0" :question/math-academy-id "q-320785" :question/problem "Write $-18{s}^{2}-32$ in factored form by rewriting the second term of the expression as the square of an imaginary number. Use $i$ to denote the imaginary unit.\n\n$-18{s}^{2}-32=$\n{{field-1}}" :question/worked-solution "First, let's factor out $-2$ from the expression:\n\n$$\n-18{s}^{2}-32=-2\\,(9{s}^{2}+16).\n$$\n\nNow focus on factoring $(9{s}^{2}+16).$  \n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${i}^{2}=-1.$ Finally, we factor it as a difference of squares.\n\n$$\n\\begin{aligned}9{s}^{2}+16 & =9{s}^{2}-(-16) \\\\  & =9{s}^{2}-(16{i}^{2}) \\\\  & =(3s)^{2}-(4i)^{2} \\\\  & =(3s+4i)(3s-4i).\\end{aligned}\n$$\n\nSubstituting back, we obtain\n\n$$\n-2\\,(9{s}^{2}+16)=-2(3s+4i)(3s-4i).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320785/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de6dbad-0ca5-5a17-a04b