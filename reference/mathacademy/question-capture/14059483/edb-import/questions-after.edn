#{[{:db/id #edb/ref 17592186338150 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "770464f3-24c4-5d37-94d7-df7dbb3986ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{8}" :db/id #edb/ref 17592186338152} {:answer/id #uuid "69adfe94-671f-5332-bb00-4248ca3371a2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{16}" :db/id #edb/ref 17592186338153} {:answer/id #uuid "da099e55-8447-560f-9cd1-14fdbb25ac3e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186338154} {:answer/id #uuid "bd48e72e-4a55-5569-a908-2372e419a7f8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{16}" :db/id #edb/ref 17592186338155} {:answer/id #uuid "4469a471-3272-511f-83f1-577fb7a9dcb2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{16}" :db/id #edb/ref 17592186338156}] :answer-field/correct {:answer/id #uuid "da099e55-8447-560f-9cd1-14fdbb25ac3e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186338154} :answer-field/id #uuid "cb84f938-5705-5e86-84f2-522a195e1d2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338151}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ca6888b6-2f58-5a99-82de-12bf27a8489d" :question/math-academy-id "q-30922" :question/problem "Evaluate the integral ${\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=-2x,$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x & =-5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{-2x}\\,\\text{d}u \\\\  & =-5{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{-2})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({4}^{-2})} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡({4}^{-2})}-{e}^{0}) \\\\  & =\\frac{5}{2}({4}^{-2}-1) \\\\  & =\\frac{5}{2}(\\frac{1}{16}-1) \\\\  & =\\frac{5}{2}\\cdot (-\\frac{15}{16}) \\\\  & =-\\frac{75}{32}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097136 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c20adce1-5b4c-5f9f-bdfa-99a93f387f55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186095179} {:answer/id #uuid "fd6bd1ff-a2da-56b0-970c-b8ed18d1bde1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186095180} {:answer/id #uuid "024fe159-6c87-5b32-84c3-77a30c61cd63" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186095181} {:answer/id #uuid "12cc34d1-3b3f-5435-a295-5b37f10f4e45" :answer/type {:db/ident :answer.type/math} :answer/value "e - 1" :db/id #edb/ref 17592186095182} {:answer/id #uuid "231487aa-c9b0-508b-908e-f30adefb35d9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186095183}] :answer-field/correct {:answer/id #uuid "12cc34d1-3b3f-5435-a295-5b37f10f4e45" :answer/type {:db/ident :answer.type/math} :answer/value "e - 1" :db/id #edb/ref 17592186095182} :answer-field/id #uuid "fc0a52e6-fcef-55f6-a9fb-40c409593998" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095178}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "68ba7826-02c2-5b69-a594-6dc133f00570" :question/math-academy-id "q-30923" :question/problem "${\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}u=\\frac{1}{3}\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x & ={\\int }_{0}^{3}{e}^{x/3}\\cdot \\frac{1}{3}\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =({e}^{u}){|}_{0}^{1} \\\\  & ={e}^{1}-{e}^{0} \\\\  & =e-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338157 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c896565b-bfa2-5d6f-aa05-8019baca532a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186338159}] :answer-field/correct {:answer/id #uuid "c896565b-bfa2-5d6f-aa05-8019baca532a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186338159} :answer-field/id #uuid "108dba1e-c59a-5bff-8738-136fc36938e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338158}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dce91173-0e12-5cec-a428-00d8f65397ad" :question/math-academy-id "q-349595" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $5\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{5x}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{5\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{5})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{4}{5}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({2}^{5})} \\\\  & =\\frac{4}{5}({e}^{\\operatorname{ln}⁡({2}^{5})}-{e}^{0}) \\\\  & =\\frac{4}{5}({2}^{5}-1) \\\\  & =\\frac{4}{5}(32-1) \\\\  & =\\frac{4}{5}\\cdot 31 \\\\  & =\\frac{124}{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338160 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "722f90e8-d2f6-5572-9f2f-b5394d785250" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{\\ln(2)}" :db/id #edb/ref 17592186338162} {:answer/id #uuid "0049add7-7619-569d-a0cd-9deabba9f49f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{\\ln(2)}" :db/id #edb/ref 17592186338163}] :answer-field/correct {:answer/id #uuid "0049add7-7619-569d-a0cd-9deabba9f49f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{\\ln(2)}" :db/id #edb/ref 17592186338163} :answer-field/id #uuid "f7977e70-88e4-5a80-8e05-917c39ceb114" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338161}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "070bb86d-3928-5d5e-adbd-a78cee200c58" :question/math-academy-id "q-349626" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $4$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x & ={\\int }_{4}^{2}3\\cdot {2}^{u}(-1)\\text{d}u \\\\  & =-3{\\int }_{4}^{2}{2}^{u}\\,\\text{d}u \\\\  & =-3(\\frac{{2}^{u}}{\\operatorname{ln}⁡2}){|}_{4}^{2} \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}({2}^{2}-{2}^{4}) \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}(4-16) \\\\  & =\\frac{36}{\\operatorname{ln}⁡2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338164 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82f14d54-a520-50c4-bea4-fbaa78a7b570" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\ln(3)}" :db/id #edb/ref 17592186338166}] :answer-field/correct {:answer/id #uuid "82f14d54-a520-50c4-bea4-fbaa78a7b570" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\ln(3)}" :db/id #edb/ref 17592186338166} :answer-field/id #uuid "d7281f12-b555-5cfc-8e0c-b713584ee94a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338165}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2c513b25-7aef-5893-9064-bf0b06e43d8c" :question/math-academy-id "q-349648" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x & ={\\int }_{0}^{2}{3}^{u}\\text{d}u \\\\  & =\\frac{{3}^{u}}{\\operatorname{ln}⁡3}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}({3}^{2}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}(9-1) \\\\  & =\\frac{8}{\\operatorname{ln}⁡3}\\end{aligned}\n$$"}]}
