[{:db/id "q-30922/selection/a963e88ed537e1ac7b325190066c734e1284f94a0b49945799bbb70481792ae0" :answer/id #uuid "4469a471-3272-511f-83f1-577fb7a9dcb2" :answer/type :answer.type/math :answer/value "-\\frac{75}{16}" :db/ensure [:answer/validate]} {:db/id "q-30922/selection/98f791340c916b43a1328b669bca9d56282fc10a4e8dbe2b87582fcbae4cd6e9" :answer/id #uuid "bd48e72e-4a55-5569-a908-2372e419a7f8" :answer/type :answer.type/math :answer/value "-\\frac{15}{16}" :db/ensure [:answer/validate]} {:db/id "q-30922/selection/5843e9a67bd1bd01f2adbb09f4b60773d625571034ab6264266567ec44c84a31" :answer/id #uuid "69adfe94-671f-5332-bb00-4248ca3371a2" :answer/type :answer.type/math :answer/value "-\\frac{25}{16}" :db/ensure [:answer/validate]} {:db/id "q-30922/selection/02664073f5d4c861831565c0e66b2fa51a6fd71e804359f51c841be5d3f634fb" :answer/id #uuid "770464f3-24c4-5d37-94d7-df7dbb3986ff" :answer/type :answer.type/math :answer/value "-\\frac{25}{8}" :db/ensure [:answer/validate]} {:db/id "q-30922/selection/7d0de1bd718be74b687db4a2c2426e1322d5000d8925aea2e593c40da4b0880c" :answer/id #uuid "da099e55-8447-560f-9cd1-14fdbb25ac3e" :answer/type :answer.type/math :answer/value "-\\frac{75}{32}" :db/ensure [:answer/validate]} {:db/id "q-30922/selection" :answer-field/id #uuid "cb84f938-5705-5e86-84f2-522a195e1d2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30922/selection/7d0de1bd718be74b687db4a2c2426e1322d5000d8925aea2e593c40da4b0880c" :answer-field/choices ["q-30922/selection/a963e88ed537e1ac7b325190066c734e1284f94a0b49945799bbb70481792ae0" "q-30922/selection/98f791340c916b43a1328b669bca9d56282fc10a4e8dbe2b87582fcbae4cd6e9" "q-30922/selection/5843e9a67bd1bd01f2adbb09f4b60773d625571034ab6264266567ec44c84a31" "q-30922/selection/02664073f5d4c861831565c0e66b2fa51a6fd71e804359f51c841be5d3f634fb" "q-30922/selection/7d0de1bd718be74b687db4a2c2426e1322d5000d8925aea2e593c40da4b0880c"] :db/ensure [:answer-field/validate]} {:db/id "q-30922" :question/id #uuid "ca6888b6-2f58-5a99-82de-12bf27a8489d" :question/math-academy-id "q-30922" :question/problem "Evaluate the integral ${\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=-2x,$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x & =-5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{-2x}\\,\\text{d}u \\\\  & =-5{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{-2})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({4}^{-2})} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡({4}^{-2})}-{e}^{0}) \\\\  & =\\frac{5}{2}({4}^{-2}-1) \\\\  & =\\frac{5}{2}(\\frac{1}{16}-1) \\\\  & =\\frac{5}{2}\\cdot (-\\frac{15}{16}) \\\\  & =-\\frac{75}{32}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30922/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-30922"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-30923"] :question/problem "${\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}u=\\frac{1}{3}\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x & ={\\int }_{0}^{3}{e}^{x/3}\\cdot \\frac{1}{3}\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =({e}^{u}){|}_{0}^{1} \\\\  & ={e}^{1}-{e}^{0} \\\\  & =e-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-349595/field-1/f4026bbf837dafece1f291c18f4e2e56b54f87c61cd617a4d72208623aa21532" :answer/id #uuid "c896565b-bfa2-5d6f-aa05-8019baca532a" :answer/type :answer.type/math :answer/value "\\frac{124}{5}" :db/ensure [:answer/validate]} {:db/id "q-349595/field-1" :answer-field/id #uuid "108dba1e-c59a-5bff-8738-136fc36938e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349595/field-1/f4026bbf837dafece1f291c18f4e2e56b54f87c61cd617a4d72208623aa21532" :answer-field/choices ["q-349595/field-1/f4026bbf837dafece1f291c18f4e2e56b54f87c61cd617a4d72208623aa21532"] :db/ensure [:answer-field/validate]} {:db/id "q-349595" :question/id #uuid "dce91173-0e12-5cec-a428-00d8f65397ad" :question/math-academy-id "q-349595" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $5\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{5x}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{5\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{5})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{4}{5}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({2}^{5})} \\\\  & =\\frac{4}{5}({e}^{\\operatorname{ln}⁡({2}^{5})}-{e}^{0}) \\\\  & =\\frac{4}{5}({2}^{5}-1) \\\\  & =\\frac{4}{5}(32-1) \\\\  & =\\frac{4}{5}\\cdot 31 \\\\  & =\\frac{124}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349595/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-349595"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349626/field-1/f5c8e9c5243d4a0bea065205b12baa1caa61f8aafcb7911b919fc7701a675fe8" :answer/id #uuid "0049add7-7619-569d-a0cd-9deabba9f49f" :answer/type :answer.type/math :answer/value "\\frac{36}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-349626/field-1/66ca8b346135beb4909056afdc368832c39163e8c134ae3ae8b521e2848c64bc" :answer/id #uuid "722f90e8-d2f6-5572-9f2f-b5394d785250" :answer/type :answer.type/math :answer/value "\\frac{12}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-349626/field-1" :answer-field/id #uuid "f7977e70-88e4-5a80-8e05-917c39ceb114" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349626/field-1/f5c8e9c5243d4a0bea065205b12baa1caa61f8aafcb7911b919fc7701a675fe8" :answer-field/choices ["q-349626/field-1/f5c8e9c5243d4a0bea065205b12baa1caa61f8aafcb7911b919fc7701a675fe8" "q-349626/field-1/66ca8b346135beb4909056afdc368832c39163e8c134ae3ae8b521e2848c64bc"] :db/ensure [:answer-field/validate]} {:db/id "q-349626" :question/id #uuid "070bb86d-3928-5d5e-adbd-a78cee200c58" :question/math-academy-id "q-349626" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $4$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x & ={\\int }_{4}^{2}3\\cdot {2}^{u}(-1)\\text{d}u \\\\  & =-3{\\int }_{4}^{2}{2}^{u}\\,\\text{d}u \\\\  & =-3(\\frac{{2}^{u}}{\\operatorname{ln}⁡2}){|}_{4}^{2} \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}({2}^{2}-{2}^{4}) \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}(4-16) \\\\  & =\\frac{36}{\\operatorname{ln}⁡2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349626/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-349626"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349648/field-1/4a40def2e71f859ec7e744982698c0d4448c7542a47bb7dbb4358f84bdd70088" :answer/id #uuid "82f14d54-a520-50c4-bea4-fbaa78a7b570" :answer/type :answer.type/math :answer/value "\\frac{8}{\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-349648/field-1" :answer-field/id #uuid "d7281f12-b555-5cfc-8e0c-b713584ee94a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349648/field-1/4a40def2e71f859ec7e744982698c0d4448c7542a47bb7dbb4358f84bdd70088" :answer-field/choices ["q-349648/field-1/4a40def2e71f859ec7e744982698c0d4448c7542a47bb7dbb4358f84bdd70088"] :db/ensure [:answer-field/validate]} {:db/id "q-349648" :question/id #uuid "2c513b25-7aef-5893-9064-bf0b06e43d8c" :question/math-academy-id "q-349648" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x & ={\\int }_{0}^{2}{3}^{u}\\text{d}u \\\\  & =\\frac{{3}^{u}}{\\operatorname{ln}⁡3}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}({3}^{2}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}(9-1) \\\\  & =\\frac{8}{\\operatorname{ln}⁡3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349648/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-349648"] :db/ensure [:knowledge-point/validate]}]
