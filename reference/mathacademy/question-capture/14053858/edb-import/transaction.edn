18382a957de69f7c2ca73bc6212de2585"] :db/ensure [:answer-field/validate]} {:db/id "q-65399" :question/id #uuid "816a7b5d-7d2b-59fc-bd5e-93ad35d7edfe" :question/math-academy-id "q-65399" :question/problem "Simplify ${sec}^{4}⁡x-{tan}^{4}⁡x.$" :question/worked-solution "First, we can simplify our expression by factoring it as a difference of squares, as follows:\n\n$$\n\\begin{aligned}{sec}^{4}⁡x-{tan}^{4}⁡x & =({sec}^{2}⁡x-{tan}^{2}⁡x)({sec}^{2}⁡x+{tan}^{2}⁡x)\\end{aligned}\n$$\n\nNext, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nFinally, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}({sec}^{2}⁡x-{tan}^{2}⁡x)({sec}^{2}⁡x+{tan}^{2}⁡x) & =(1)({sec}^{2}⁡x+{tan}^{2}⁡x) \\\\  & ={sec}^{2}⁡x+{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{4}⁡x-{tan}^{4}⁡x={sec}^{2}⁡x+{tan}^{2}⁡x.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65399/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b"] :knowledge-point/questions ["q-65399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65400/selection/1ad009c7386646ccea2b504857d5aa5a3257dc0f94e6e25b04ec94802f2010cb" :answer/id #uuid "9ee9b21f-cd62-55b8-94bb-30f712f37f33" :answer/type :answer.type/math :answer/value "{tan}^{2}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-65400/selection/fbdfea5b1daf4d74b7704516814c3c28369f5bc5063ac90d7a612b0fa0bb5de8" :answer/id #uuid "6cf81a91-c1b9-58f4-815a-b95bb2ac3662" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65400/selection/8f7fe62b45f9ab1b7d1cf8cb30da1bf4a3564025bc54189261a7f0677fa27a4c" :answer/id #uuid "cfa89f69-f329-5f5b-b7c6-ba2401e3d161" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-65400/selection/a0332b537f4486805ad1793740b0a1ac4165eaeb48e40facdc78c5de1981c15a" :answer/id #uuid "7b440d5b-af78-5eca-bfdf-78411ec00c16" :answer/type :answer.type/math :answer/value "{tan}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65400/selection/bbbbf8af302753ca905188e09e4a1284c668cbdd8c0ff86fe10d417707c71f1c" :answer/id #uuid "4e7e38c9-fdf2-55c3-b031-edce6c165f4c" :answer/type :answer.type/math :answer/value "{tan}^{2}⁡\\theta -1" :db/ensure [:answer/validate]} {:db/id "q-65400/selection" :answer-field/id #uuid "47aae9bf-585f-59cd-9e13-87baf7084e0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65400/selection/a0332b537f4486805ad1793740b0a1ac4165eaeb48e40facdc78c5de1981c15a" :answer-field/choices ["q-65400/selection/1ad009c7386646ccea2b504857d5aa5a3257dc0f94e6e25b04ec94802f2010cb" "q-65400/selection/fbdfea5b1daf4d74b7704516814c3c28369f5bc5063ac90d7a612b0fa0bb5de8" "q-65400/selection/8f7fe62b45f9ab1b7d1cf8cb30da1bf4a3564025bc54189261a7f0677fa27a4c" "q-65400/selection/a0332b537f4486805ad1793740b0a1ac4165eaeb48e40facdc78c5de1981c15a" "q-65400/selection/bbbbf8af302753ca905188e09e4a1284c668cbdd8c0ff86fe10d417707c71f1c"] :db/ensure [:answer-field/validate]} {:db/id "q-65400" :question/id #uuid "6a821d69-3cb9-5c4a-9785-e02e8036266b" :question/math-academy-id "q-65400" :question/problem "Which of the following is equivalent to ${sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1 & =-{sec}^{2}⁡\\theta ({sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta )+2{sec}^{2}⁡\\theta -1 \\\\  & =-{sec}^{2}⁡\\theta \\cdot (1)+2{sec}^{2}⁡\\theta -1 \\\\  & =-{sec}^{2}⁡\\theta +2{sec}^{2}⁡\\theta -1\\end{aligned}\n$$\n\nNext, we can further simplify our expression using $(2)$, as follows:\n\n$$\n\\begin{aligned}-{sec}^{2}⁡\\theta +2{sec}^{2}⁡\\theta -1 & ={sec}^{2}⁡\\theta -1 \\\\  & ={tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{sec}^{4}⁡\\theta +2{sec}^{2}⁡\\theta -1={tan}^{2}⁡\\theta .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65400/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8"] :knowledge-point/questions ["q-65400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65410/selection/018a58cdec4b59170f9cee5fd81424c960ecacbce6a72cf9e96fa909202d0628" :answer/id #uuid "a0d6a6b6-40ce-5551-868a-adf95cee771e" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\alpha +1" :db/ensure [:answer/validate]} {:db/id "q-65410/selection/d007f29e3723252e07a8f638e4cd2490cf03ba3964adc03d0d54a62afd254bb8" :answer/id #uuid "3e9cd08f-e83e-59c5-9469-837f0c1cae29" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\alpha " :db/ensure [:answer/validate]} {:db/id "q-65410/selection/0629e6efbf3316663c14998dfa43a75320032383d4ba12c17243a95302122d3f" :answer/id #uuid "b621a88e-cfb6-5d36-955c-f3cdeae769a7" :answer/type :answer.type/math :answer/value "1-\\operatorname{cos}⁡\\alpha " :db/ensure [:answer/validate]} {:db/id "q-65410/selection/c0ba71debaf68c6c078313a1b25e5f81a06e94fcb95a7b6b6cc04b5c19a08f84" :answer/id #uuid "a551f56b-bb35-59a4-a705-6600c14b8475" :answer/type :answer.type/math :answer/value "{cos}^{2}⁡\\alpha +1" :db/ensure [:answer/validate]} {:db/id "q-65410/selection/1f0006b9596afd3a67e2bdfd82582f6175b471e23eec4cb60e8d4b0e8916ce0c" :answer/id #uuid "a76baf1a-76e1-5091-9e37-6cb5e723ba01" :answer/type :answer.type/math :answer/value "{cos}^{2}⁡\\alpha " :db/ensure [:answer/validate]} {:db/id "q-65410/selection" :answer-field/id #uuid "5eaa2d93-7016-54cb-a39e-e6ad762be7bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65410/selection/d007f29e3723252e07a8f638e4cd2490cf03ba3964adc03d0d54a62afd254bb8" :answer-field/choices ["q-65410/selection/018a58cdec4b59170f9cee5fd81424c960ecacbce6a72cf9e96fa909202d0628" "q-65410/selection/d007f29e3723252e07a8f638e4cd2490cf03ba3964adc03d0d54a62afd254bb8" "q-65410/selection/0629e6efbf3316663c14998dfa43a75320032383d4ba12c17243a95302122d3f" "q-65410/selection/c0ba71debaf68c6c078313a1b25e5f81a06e94fcb95a7b6b6cc04b5c19a08f84" "q-65410/selection/1f0006b9596afd3a67e2bdfd82582f6175b471e23eec4cb60e8d4b0e8916ce0c"] :db/ensure [:answer-field/validate]} {:db/id "q-65410" :question/id #uuid "2db73422-d97a-5f74-9a86-860248027e3a" :question/math-academy-id "q-65410" :question/problem "Simplify $\\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1}.$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\alpha ={sec}^{2}⁡\\alpha  \\\\  & (2) & {tan}^{2}⁡\\alpha ={sec}^{2}⁡\\alpha -1 \\\\  & (3) & {sec}^{2}⁡\\alpha -{tan}^{2}⁡\\alpha =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1} & =\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha -1+\\operatorname{sec}⁡\\alpha +1} \\\\  & =\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha }\\end{aligned}\n$$\n\nFinally, we can further simplify our expression by factoring it out, as follows:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{sec}⁡\\alpha }{{sec}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha } & =\\frac{1+\\operatorname{sec}⁡\\alpha }{\\operatorname{sec}⁡\\alpha (\\operatorname{sec}⁡\\alpha +1)} \\\\  & =\\frac{\\cancel{1+\\operatorname{sec}⁡\\alpha }}{\\operatorname{sec}⁡\\alpha \\cancel{(\\operatorname{sec}⁡\\alpha +1)}} \\\\  & =\\frac{1}{\\operatorname{sec}⁡\\alpha } \\\\  & =\\operatorname{cos}⁡\\alpha \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1+\\operatorname{sec}⁡\\alpha }{{tan}^{2}⁡\\alpha +\\operatorname{sec}⁡\\alpha +1}=\\operatorname{cos}⁡\\alpha .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65410/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b"] :knowledge-point/questions ["q-65410"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74157/selection/d2058c598527de7c11bc996ce15b7e8d70a0510720f8a997ffa0afb27ee61aa4" :answer/id #uuid "8059ab97-895c-5341-a50a-e6979ca25a94" :answer/type :answer.type/math :answer/value "{tan}^{4}⁡x-1" :db/ensure [:answer/validate]} {:db/id "q-74157/selection/ce26c6166d9d85117e61ee2b87469df64262e499077a2211312bfdc647f4ec11" :answer/id #uuid "f84ad0f3-8593-5b19-8b01-5f46789f0e4a" :answer/type :answer.type/math :answer/value "(1+\\operatorname{tan}⁡x){tan}^{3}⁡x" :db/ensure [:answer/validate]} {:db/id "q-74157/selection/6fa671236e266cb81eda08eec83e1f7e7c5f446d1bb9b31b511ba01c971779d0" :answer/id #uuid "3e403142-3d3f-5f6f-a42a-d72b52af3009" :answer/type :answer.type/math :answer/value "(1+\\operatorname{tan}⁡x)^{4}" :db/ensure [:answer/validate]} {:db/id "q-74157/selection/74b7944f518f926780e6f147cb0623a8142dcf183f25c7e455998b2e65b1b9c4" :answer/id #uuid "35f395de-71e2-535f-8e80-21eea1177a5a" :answer/type :answer.type/math :answer/value "{tan}^{4}⁡x" :db/ensure [:answer/validate]} {:db/id "q-74157/selection/a42add3ca7ddbe4cde6737cd1594cc46e5108a7edea573655b54d117cc855fed" :answer/id #uuid "a9032168-7c1b-51a9-8962-3f60a94b5fbd" :answer/type :answer.type/math :answer/value "(1+{tan}^{2}⁡x){tan}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-74157/selection" :answer-field/id #uuid "2b6b2448-6cce-5d43-9a34-d0e050735757" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74157/selection/a42add3ca7ddbe4cde6737cd1594cc46e5108a7edea573655b54d117cc855fed" :answer-field/choices ["q-74157/selection/d2058c598527de7c11bc996ce15b7e8d70a0510720f8a997ffa0afb27ee61aa4" "q-74157/selection/ce26c6166d9d85117e61ee2b87469df64262e499077a2211312bfdc647f4ec11" "q-74157/selection/6fa671236e266cb81eda08eec83e1f7e7c5f446d1bb9b31b511ba01c971779d0" "q-74157/selection/74b7944f518f926780e6f147cb0623a8142dcf183f25c7e455998b2e65b1b9c4" "q-74157/selection/a42add3ca7ddbe4cde6737cd1594cc46e5108a7edea573655b54d117cc855fed"] :db/ensure [:answer-field/validate]} {:db/id "q-74157" :question/id #uuid "3309aa28-d6ca-59c8-be57-306a349ee257" :question/math-academy-id "q-74157" :question/problem "Which of the following is equivalent to ${sec}^{4}⁡x-{sec}^{2}⁡x?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{4}⁡x-{sec}^{2}⁡x & ={sec}^{2}⁡x\\cdot ({sec}^{2}⁡x-1) \\\\  & ={sec}^{2}⁡x\\cdot {tan}^{2}⁡x\\end{aligned}\n$$\n\nFinally, we can use $(1),$ as follows:\n\n$$\n\\begin{aligned}{sec}^{2}⁡x{tan}^{2}⁡x & =(1+{tan}^{2}⁡x){tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{4}⁡x-{sec}^{2}⁡x=(1+{tan}^{2}⁡x){tan}^{2}⁡x.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74157/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8"] :knowledge-point/questions ["q-74157"] :db/ensure [:knowledge-point/validate]} {:db/id "q-