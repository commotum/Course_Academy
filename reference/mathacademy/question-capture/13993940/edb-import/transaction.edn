gned}4 & -2 \\\\ 0 & 6\\end{aligned}]+[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4+4+2 & -5+(-2)+0 \\\\ 0+0+0 & 9+6+2\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -7 \\\\ 0 & 17\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279481/field-1" "q-279481/field-2" "q-279481/field-3" "q-279481/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98"] :knowledge-point/questions ["q-279481"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279512/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "023c04cc-305f-5ebd-86f7-133b6333c63b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-279512/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "76a435c6-5997-5d40-aa02-99b267412c1d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-279512/field-1" :answer-field/id #uuid "c31e9aab-113f-5796-9a5e-629c1cd17b52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279512/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-279512/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-279512/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-279512/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "e7eebd5b-ff26-5e9e-8111-01cae8520bf4" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-279512/field-2" :answer-field/id #uuid "25bde992-14b8-5462-9fe9-3a61765070ec" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279512/field-2/f853eeffac47c628af4a2b7e7b0ecd02