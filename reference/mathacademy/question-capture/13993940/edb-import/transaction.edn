-3 \\\\  & ={X}^{2}-2X-3I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-2A-3I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}4 & -2 \\\\ 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}4 & -2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & -10 \\\\ 5 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-2A-3I \\\\  & =[\\begin{aligned}14 & -10 \\\\ 5 & -1\\end{aligned}]-2[\\begin{aligned}4 & -2 \\\\ 1 & 1\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}14 & -10 \\\\ 5 & -1\\end{aligned}]-[\\begin{aligned}8 & -4 \\\\ 2 & 2\\end{aligned}]-[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}14-8-3 & -10-(-4)-0 \\\\ 5-2-0 & -1-2-3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -6 \\\\ 3 & -6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279512/field-1" "q-279512/field-2" "q-279512/field-3" "q-279512/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98"] :knowledge-point/questions ["q-279512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279493/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9d7b7235-5069-5a96-a585-af052a0adc06" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-279493/field-1" :answer-field/id #uuid "f476a17c-df57-5bc8-bfd2-483934cd1e33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279493/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-279493/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-279493/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc46