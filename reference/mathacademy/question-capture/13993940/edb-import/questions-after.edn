#{[{:db/id #edb/ref 17592186114976 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/id #uuid "f832e671-b4bd-5d1d-81e7-b215a8ee4e27" :question/math-academy-id "e-4414" :question/problem "Find $A^4$ given that $[\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}]$" :question/worked-solution "First, to find $A^2,$ we multiply $A$ by itself:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}]\\cdot [\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, since $A^4 = A^2 \\cdot A^2,$ we get\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =[\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}]\\cdot [\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}81 & 0 \\\\ 100 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114977 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "61443225-bc08-5d36-a603-3a1d7e392a98" :knowledge-point/title "Evaluating a Matrix Polynomial"}] :question/id #uuid "bea8819f-6feb-5de6-a585-4379378ccdbd" :question/math-academy-id "e-4417" :question/problem "Consider the matrix\n\n$$\n[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]\n$$\n\nFind $f(D)$ if $f(X)=-X^2+3X+2.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & =-{X}^{2}+3X+2 \\\\  & =-{X}^{2}+3X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(D)=-D^2+3D+2I.$\n\nLet's calculate $D^2$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]\\cdot [\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -10 \\\\ 0 & 9\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(D)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(D) & =-{D}^{2}+3D+2I \\\\  & =-[\\begin{aligned}1 & -10 \\\\ 0 & 9\\end{aligned}]+3[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 10 \\\\ 0 & -9\\end{aligned}]+[\\begin{aligned}3 & 15 \\\\ 0 & -9\\end{aligned}]+[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1+3+2 & 10+15+0 \\\\ 0 & -9-9+2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 25 \\\\ 0 & -16\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284390 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7eb6d094-45de-589e-8d8c-bd2d3e5c9cd7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 3 \\\\ -3 & -5\\end{aligned}]" :db/id #edb/ref 17592186284392} {:answer/id #uuid "32f2ce44-10fb-540d-8131-38db35d77ff6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & -3 \\\\ 3 & -8\\end{aligned}]" :db/id #edb/ref 17592186284393} {:answer/id #uuid "e5993f5c-93e9-5b21-b14e-45535ad336a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 3 \\\\ -3 & -8\\end{aligned}]" :db/id #edb/ref 17592186284394} {:answer/id #uuid "f2577cfd-e807-5b01-9abb-b1ffa27d1570" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 3 \\\\ 3 & 8\\end{aligned}]" :db/id #edb/ref 17592186284395} {:answer/id #uuid "bea15954-d927-51a9-97c1-a694edce6be1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 5 \\\\ -3 & -8\\end{aligned}]" :db/id #edb/ref 17592186284396}] :answer-field/correct {:answer/id #uuid "e5993f5c-93e9-5b21-b14e-45535ad336a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 3 \\\\ -3 & -8\\end{aligned}]" :db/id #edb/ref 17592186284394} :answer-field/id #uuid "94d29360-e103-582c-b94d-8e34fb4f9f45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284391}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "eb7c8832-4379-58b6-8448-344f50234c74" :question/math-academy-id "q-130564" :question/problem "If $A=[\\begin{aligned}-2 & -3 \\\\ 3 & 1\\end{aligned}]$, then ${A}^{2}=$" :question/worked-solution "To find ${A}^{2},$ we multiply $A$ by itself:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}-2 & -3 \\\\ 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 3 \\\\ -3 & -8\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284397 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e031d2ca-7b25-54cb-b3e8-da85378bd2eb" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186284399} {:answer/id #uuid "460877ba-7bb4-5f8d-b838-703d06e2a554" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186284400}] :answer-field/correct {:answer/id #uuid "e031d2ca-7b25-54cb-b3e8-da85378bd2eb" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186284399} :answer-field/id #uuid "e8b1a1a6-12bc-5410-8dd2-d82b349e8416" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284398} {:answer-field/choices [{:answer/id #uuid "fbf1d913-bc8f-5478-8b91-be66fd990d93" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186284402}] :answer-field/correct {:answer/id #uuid "fbf1d913-bc8f-5478-8b91-be66fd990d93" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186284402} :answer-field/id #uuid 