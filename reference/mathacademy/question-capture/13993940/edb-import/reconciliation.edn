Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-78348" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-5 \\\\  & ={X}^{2}-2X-5I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-2C-5I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 4 \\\\ 6 & 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-2C-5I \\\\  & =[\\begin{aligned}7 & 4 \\\\ 6 & 7\\end{aligned}]-2[\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}]-5[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 4 \\\\ 6 & 7\\end{aligned}]-[\\begin{aligned}2 & 4 \\\\ 6 & 2\\end{aligned}]-[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}7-2-5 & 4-4-0 \\\\ 6-6-0 & 7-2-5\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-78348" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/activity-metadata.json" "file_sha256" "5f9d41fb3d6ea0c003801a20c8806967f2b03a19ae29030a1297e1301428f2c6"} {"question" "q-78348" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-78348" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & -2 \\\\ -3 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 4 \\\\ 6 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}7 & -2 \\\\ -3 & 7\\end{aligned}]"] ["math" "[\\begin{aligned}7 & 4 \\\\ 6 & 7\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-78348" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "e-4414" "field" nil "attribute" "question/problem" "value" "Find $A^4$ given that $[\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/example-4414.json" "file_sha256" "73339b9f7ca1fae3e011a0db0ef2b6d2a69cb2a055600b158333fb6d4a69c9a2"} {"question" "e-4414" "field" nil "attribute" "question/worked-solution" "value" "First, to find $A^2,$ we multiply $A$ by itself:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}]\\cdot [\\begin{aligned}3 & 0 \\\\ 5 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, since $A^4 = A^2 \\cdot A^2,$ we get\n\n$$\n\\begin{aligned}{A}^{4} & ={A}^{2}\\cdot {A}^{2} \\\\  & =[\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}]\\cdot [\\begin{aligned}9 & 0 \\\\ 10 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}81 & 0 \\\\ 100 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/example-4414.json" "file_sha256" "73339b9f7ca1fae3e011a0db0ef2b6d2a69cb2a055600b158333fb6d4a69c9a2"} {"question" "e-4417" "field" nil "attribute" "question/problem" "value" "Consider the matrix\n\n$$\n[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]\n$$\n\nFind $f(D)$ if $f(X)=-X^2+3X+2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/example-4417.json" "file_sha256" "f50404291ac1aa09e140bbb16a6e0d012d1f9a5c4d32d34192fbdfa01c59c690"} {"question" "e-4417" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & =-{X}^{2}+3X+2 \\\\  & =-{X}^{2}+3X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(D)=-D^2+3D+2I.$\n\nLet's calculate $D^2$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]\\cdot [\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -10 \\\\ 0 & 9\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(D)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(D) & =-{D}^{2}+3D+2I \\\\  & =-[\\begin{aligned}1 & -10 \\\\ 0 & 9\\end{aligned}]+3[\\begin{aligned}1 & 5 \\\\ 0 & -3\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 10 \\\\ 0 & -9\\end{aligned}]+[\\begin{aligned}3 & 15 \\\\ 0 & -9\\end{aligned}]+[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1+3+2 & 10+15+0 \\\\ 0 & -9-9+2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 25 \\\\ 0 & -16\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/example-4417.json" "file_sha256" "f50404291ac1aa09e140bbb16a6e0d012d1f9a5c4d32d34192fbdfa01c59c690"}] "usage" {"q-78348" [] "e-4417" [] "e-4414" []} "basis" 1055 "retractions" [[17592186115866 :question/problem "Consider the matrix $C = \\begin{bmatrix}1 & 2 \\\\ 3 & 1\\end{bmatrix}$. Find $f(C)$ if $f(X) = X^{2} - 2X - 5$."] [17592186114976 :question/problem "Find $A^4$ given that $\\begin{bmatrix}3 & 0 \\\\ 5 & -1\\end{bmatrix}$"] [17592186114976 :question/worked-solution "First, to find $A^2$, we multiply $A$ by itself:\n\n$$\n\\begin{aligned}\nA^{2} &= A \\cdot A \\\\\n&= \\begin{bmatrix}3 & 0 \\\\ 5 & -1\\end{bmatrix} \\cdot \\begin{bmatrix}3 & 0 \\\\ 5 & -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}9 & 0 \\\\ 10 & 1\\end{bmatrix}\n\\end{aligned}\n$$\n\nNow, since\n\n$$\nA^4 = A^2 \\cdot A^2\n$$\n\nwe get\n\n$$\n\\begin{aligned}\nA^{4} &= A^{2} \\cdot A^{2} \\\\\n&= \\begin{bmatrix}9 & 0 \\\\ 10 & 1\\end{bmatrix} \\cdot \\begin{bmatrix}9 & 0 \\\\ 10 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}81 & 0 \\\\ 100 & 1\\end{bmatrix}\n\\end{aligned}\n$$"] [17592186114977 :question/problem "Consider the matrix\n$\\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix}$\nFind $f(D)$ if $f(X)=-X^2+3X+2$."] [17592186114977 :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}\nf(X) &= -X^{2} + 3X + 2 \\\\\n&=-X^{2} + 3X + 2I\n\\end{aligned}\n$$\n\nSo, we want to find\n\n$$\nf(D)=-D^2+3D+2I\n$$\n\nLet's calculate $D^2$ as follows:\n\n$$\n\\begin{aligned}\nD^{2} &= D \\cdot D \\\\\n&= \\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix} \\cdot \\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 & -10 \\\\ 0 & 9\\end{bmatrix}\n\\end{aligned}\n$$\n\nNow, we can evaluate $f(D)$:\n\n$$\n\\begin{aligned}\nf(D) &= -D^{2} + 3D + 2I \\\\\n&=-\\begin{bmatrix}1 & -10 \\\\ 0 & 9\\end{bmatrix} + 3\\begin{bmatrix}1 & 5 \\\\ 0 & -3\\end{bmatrix} + 2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-1 & 10 \\\\ 0 & -9\\end{bmatrix} + \\begin{bmatrix}3 & 15 \\\\ 0 & -9\\end{bmatrix} + \\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-1 + 3 + 2 & 10 + 15 + 0 \\\\ 0 & -9 - 9 + 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}4 & 25 \\\\ 0 & -16\\end{bmatrix}\n\\end{aligned}\n$$"]] "immutable_answers" [17592186114568 17592186114569 17592186114570 17592186114571 17592186114572] "immutable_fields" [[17592186114567 :answer-field/correct] [17592186114567 :answer-field/id] [17592186114567 :answer-field/key] [17592186114567 :answer-field/type]] "no_history" []}
