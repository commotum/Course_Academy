gned}] \\\\  & =[\\begin{aligned}7 & -3 \\\\ 6 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(H):$\n\n$$\n\\begin{aligned}f(H) & ={H}^{2}+3H+2I \\\\  & =[\\begin{aligned}7 & -3 \\\\ 6 & -2\\end{aligned}]+3[\\begin{aligned}3 & -1 \\\\ 2 & 0\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -3 \\\\ 6 & -2\\end{aligned}]+[\\begin{aligned}9 & -3 \\\\ 6 & 0\\end{aligned}]+[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}7+9+2 & -3+(-3)+0 \\\\ 6+6+0 & -2+0+2\\end{aligned}] \\\\  & =[\\begin{aligned}18 & -6 \\\\ 12 & 0\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279495" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/activity-metadata.json" "file_sha256" "5f9d41fb3d6ea0c003801a20c8806967f2b03a19ae29030a1297e1301428f2c6"} {"question" "q-279495" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279495" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "18"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279495" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/ref