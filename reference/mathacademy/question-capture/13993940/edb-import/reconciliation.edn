8\\end{aligned}]"] ["math" "[\\begin{aligned}-5 & -3 \\\\ 3 & -8\\end{aligned}]"] ["math" "[\\begin{aligned}-5 & 3 \\\\ -3 & -8\\end{aligned}]"] ["math" "[\\begin{aligned}-8 & 3 \\\\ -3 & -5\\end{aligned}]"] ["math" "[\\begin{aligned}5 & 3 \\\\ 3 & 8\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-130564" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-5 & 3 \\\\ -3 & -8\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279481" "field" nil "attribute" "question/problem" "value" "Consider the matrix $A=[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}].$ If $f(X)={X}^{2}+2X+2$, find $f(A).$\n\n| $f(A)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279481" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+2X+2 \\\\  & ={X}^{2}+2X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+2A+2I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}]\\cdot [\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -5 \\\\ 0 & 9\\end{aligned}]\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+2A+2I \\\\  & =[\\begin{aligned}4 & -5 \\\\ 0 & 9\\end{aligned}]+2[\\begin{aligned}2 & -1 \\\\ 0 & 3\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -5 \\\\ 0 & 9\\end{aligned}]+[\\begin{aligned}4 & -2 \\\\ 0 & 6\\end{aligned}]+[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4+4+2 & -5+(-2)+0 \\\\ 0+0+0 & 9+6+2\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -7 \\\\ 0 & 17\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279481" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/activity-metadata.json" "file_sha256" "5f9d41fb3d6ea0c003801a20c8806967f2b03a19ae29030a1297e1301428f2c6"} {"question" "q-279481" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279481" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77bacb38e05dde3b89bfde4f088cb9"} {"question" "q-279481" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993940/state.json" "file_sha256" "347b635e60b4f5225ccb2ca1aedb03aa9b77