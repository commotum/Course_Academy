{\\sqrt{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103890/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-103890"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103892/selection/601eeb94ba137e9f3f1a478f80233e7c2a54172679789b632caf4613b2f15823" :answer/id #uuid "fab7dd4d-dc65-514b-9772-d5d30b096275" :answer/type :answer.type/text :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "q-103892/selection/f56ee1e8e70aa9e14a4bd68a5dfaec16255501d9826b63da51a5e88726b9f05b" :answer/id #uuid "2dd28ccc-5041-5268-905d-590ac5a1d07f" :answer/type :answer.type/text :answer/value "center: $(7,0)$, radius: $7$" :db/ensure [:answer/validate]} {:db/id "q-103892/selection/ec0187f6e2a5c32ec8ac968c5bc6a77757991f1224cc39f6e5389ea6fee25a15" :answer/id #uuid "56ce61a3-ac2e-56a2-8b11-f20042f8e067" :answer/type :answer.type/text :answer/value "center: $(\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "q-103892/selection/16977fcd139040b80567f811f2551207707d475fc8bd716c746ef44f34ea52e8" :answer/id #uuid "67035495-b331-5e7c-8953-3dc5b889059c" :answer/type :answer.type/text :answer/value "center: $(-7,0)$, radius: $49$" :db/ensure [:answer/validate]} {:db/id "q-103892/selection/85a3845e2af36027c71ab8bc83200a8b089897a03a3a0c08635d63d6d2c5a981" :answer/id #uuid "3198fda6-31bf-5d2f-95cd-fdb6dff384b4" :answer/type :answer.type/text :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{4}$" :db/ensure [:answer/validate]} {:db/id "q-103892/selection" :answer-field/id #uuid "14533ebb-5210-55ff-85c5-884fb46c55ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103892/selection/601eeb94ba137e9f3f1a478f80233e7c2a54172679789b632caf4613b2f15823" :answer-field/choices ["q-103892/selection/601eeb94ba137e9f3f1a478f80233e7c2a54172679789b632caf4613b2f15823" "q-103892/selection/f56ee1e8e70aa9e14a4bd68a5dfaec16255501d9826b63da51a5e88726b9f05b" "q-103892/selection/ec0187f6e2a5c32ec8ac968c5bc6a77757991f1224cc39f6e5389ea6fee25a15" "q-103892/selection/16977fcd139040b80567f811f2551207707d475fc8bd716c746ef44f34ea52e8" "q-103892/selection/85a3845e2af36027c71ab8bc83200a8b089897a03a3a0c08635d63d6d2c5a981"] :db/ensure [:answer-field/validate]} {:db/id "q-103892" :question/id #uuid "3f6a0f67-fd62-5333-8099-37761d6fc395" :question/math-academy-id "q-103892" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7x=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7x & =0 \\\\ ({x}^{2}+7x)+{y}^{2} & =0 \\\\ ({x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2})+{y}^{2} & ={(\\frac{7}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x+\\frac{7}{2})}^{2}+{y}^{2} & ={(\\frac{7}{2})}^{2} \\\\ {(x-(-\\frac{7}{2}))}^{2}+(y-0)^{2} & ={(\\frac{7}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{7}{2},0)$ and its radius is $\\frac{7}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103892/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-103892"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103896/selection/a04b60e794fc49c163f003ee7306b26ed14f6f68563de3c50714c729e691f018" :answer/id #uuid "b4ee14f2-0816-5365-9a87-a2a32ab4ba59" :answer/type :answer.type/text :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/ensure [:answer/validate]} {:db/id "q-103896/selection/9c63115bf13c3a5904b8fc38d376f63493d08b061dd2360d5a4175883935cef4" :answer/id #uuid "bc2d5659-90c2-562f-8b73-5bcbf3b1c11f" :answer/type :answer.t