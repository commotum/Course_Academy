y}^{2}+2\\cdot 2y+{2}^{2}) & =20+{1}^{2}+{2}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+2)^{2} & ={5}^{2} \\\\ (x-(-1))^{2}+(y-(-2))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-2)$ and its radius is $5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-5180/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-5180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5191/selection/b30c630bd0fa6afbf85b95525214b54241d79fa080909429e76fd407416a5250" :answer/id #uuid "ba749403-bff0-5677-9191-b791246b4be0" :answer/type :answer.type/text :answer/value "center: $(5,-2)$, radius: $4$" :db/ensure [:answer/validate]} {:db/id "q-5191/selection/06ae728ab8d42b3153499f383edfced6f3e4ea83b9efb837f66c1ae621ef054b" :answer/id #uuid "d34d348c-22a6-5d4f-b5a3-7baee0b12879" :answer/type :answer.type/text :answer/value "center: $(5,-2)$, radius: $2$" :db/ensure [:answer/validate]} {:db/id "q-5191/selection/cc2795a4a11d5bcf8a2dad128e176adf8f716a781f5a4666085ce69661930ab8" :answer/id #uuid "4e99dbc7-762f-502f-9699-b85176ec48ce" :answer/type :answer.type/text :answer/value "center: $(-5,-2)$, radius: $4$" :db/ensure [:answer/validate]} {:db/id "q-5191/selection/049083cb42667eb374ce375065946c861e3773f15da28580ec83abd3ff5780f5" :answer/id #uuid "049b955b-fdf1-5dde-9c00-f5f212ec3402" :answer/type :answer.type/text :answer/value "center: $(-5,2)$, radius: $2$" :db/ensure [:answer/validate]} {:db/id "q-5191/selection/e458829039bea2ae3216e37819a1011eb55b1682e470b9404c9f2e5ecff1e426" :answer/id #uuid "30c4c7c8-ecbc-5019-a51f-917367a31174" :answer/type :answer.type/text :answer/value "center: $(5,-4)$, radius: $2$" :db/ensure [:answer/validate]} {:db/id "q-5191/selection" :answer-field/id #uuid "17cad6eb-93ef-5e