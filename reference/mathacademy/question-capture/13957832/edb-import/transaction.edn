-16)$ and its radius is $3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15461/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15461"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15456/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "03894442-088c-57e0-8bae-f6305a621117" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-15456/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "25127a4a-0b74-5e8a-9ca1-33e3de3a4f93" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-15456/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "cc7e6c80-4f88-5e91-9995-e75768ee7492" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-15456/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "6efdb8d8-fe2e-54ed-8e7c-4b8fe98b7852" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-15456/selection/4e0d8402ce61a9969d16a551582a4c98e6792e5edb3c1272d991dba7d5c92279" :answer/id #uuid "5f4305da-9bf6-5240-bf92-e77c19b58751" :answer/type :answer.type/math :answer/value "-14" :db/ensure [:answer/validate]} {:db/id "q-15456/selection" :answer-field/id #uuid "48ac1700-5645-50e6-b4a8-ecf4768b91f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15456/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer-field/choices ["q-15456/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-15456/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-15456/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-15456/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-15456/selection/4e0d8402ce61a9969d16a551582a4c98e6792e5edb3c1272d991dba7d5c92279"] :db/ensure [:answer-field/validate]} {:db/id "q-15456" :question/id #uuid "ef135fe4-2cc3-594b-85e4-18d9af72e974" :question/math-academy-id "q-15456" :question/problem "A circle in the Cartesian plane is given by the equation \n$137+6y=-{y}^{2}-{x}^{2}-24x.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}137+6y & =-{y}^{2}-{x}^{2}-24x \\\\ {x}^{2}+24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}+24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-(-12))^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-12,b=-3$ and $r=4,$  and\n\n$$\na+b+r=-12-3+4=-11.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15456/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15456"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5180/selection/3554c78f0cfc7ab9d35ebf3c616856f0d1c3147655e182c50f8f477c4e37ecb5" :answer/id #uuid "80642a10-2cc6-5629-9831-8c57755e62a3" :answer/type :answer.type/text :answer/value "center: $(1,2)$, radius: $21$" :db/ensure [:answer/validate]} {:db/id "q-5180/selection/a0a78a373f6d503b1a2f86afa460d67ba9f143b1ac0c7c3c01e919ba3f2ac9fb" :answer/id #uuid "14ef14db-61e7-5506-975a-379994078334" :answer/type :answer.type/text :answer/value "center: $(-1,-2)$, radius: $5$" :db/ensure [:answer/v