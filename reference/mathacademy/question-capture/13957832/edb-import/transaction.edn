nsure [:answer-field/validate]} {:db/id "q-5183" :question/id #uuid "6ac8461a-29d0-5698-901e-84a35dae5276" :question/math-academy-id "q-5183" :question/problem "Find the center and radius of the circle whose equation is ${y}^{2}-8x-10y+{x}^{2}=8.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}-8x-10y+{x}^{2} & =8 \\\\ ({x}^{2}-8x)+({y}^{2}-10y) & =8 \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =8+{4}^{2}+{5}^{2} \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-4)^{2}+(y-5)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(4,5)$ and its radius is $7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-5183/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-5183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15461/selection/c2aa3e0e8ce07111baf6c50a486119913a0eef6386d680bd237874bd221a5d93" :answer/id #uuid "ebee8a28-ea38-5dca-ae4d-8428d6c7a450" :answer/type :answer.type/text :answer/value "center: $(-4,-16)$, radius: $3$" :db/ensure [:answer/validate]} {:db/id "q-15461/selection/785d35fdfb528680cbcfe8e3a77dbd09bfdc48e8418e8e23a145730b491a09d7" :answer/id #uuid "1f1fa414-403a-524c-a7d3-3a821205658c" :answer/type :answer.type/text :answer/value "center: $(-16,4)$, radius: $2$" :db/ensure [:answer/validate]} {:db/id "q-15461/selection/2f2a3b9eecddbe6dcc7b242ed25ea2d8c4655f0cf642e84c965ff0aff5e9ea90" :answer/id #uuid "2c3ebf6f-a27a-5e77-97ca-c79e838e0430" :answer/type :answer.type/text :answer/value "center: $(4,-16)$, radius: $9$" :db/ensure [:answer/validate]} {:db/id "q-15461/selection/a09993d9c98ba5aff6252661cdc63744fd86c5092bfc1c050136e173a368a87c" :answer/id #uuid "