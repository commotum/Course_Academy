{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{(y-\\frac{1}{4})}^{2} & =\\frac{9}{16} \\\\ (x-1)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-76374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103890/selection/a97cea809703e712258190672be135230aed4c9494de7bae394ef72a528d221c" :answer/id #uuid "b2bf761f-e3fe-5680-a48d-4a0dc918c4ec" :answer/type :answer.type/text :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/ensure [:answer/validate]} {:db/id "q-103890/selection/7d86a1684cac54cd7fe24adf9d86122ff8b7abd0872729d905cee82c5e97e939" :answer/id #uuid "c01a4f0c-2e1e-5ecd-a21c-5556064fa38f" :answer/type :answer.type/text :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/ensure [:answer/validate]} {:db/id "q-103890/selection/f9938b195553c5fb08a6507c34fe45a43210e9061c94c0c0614ee4f8e056529f" :answer/id #uuid "1281df56-2554-51f4-a1f6-17b289f9bfdd" :answer/type :answer.type/text :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/ensure [:answer/validate]} {:db/id "q-103890/selection/2c2c4101a9dc5b5bf770027a7613318d599703fba60ac5486c7a41dd0a053960" :answer/id #uuid "0f3fa180-68be-5426-b193-a1a034d84dea" :answer/type :answer.type/text :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/ensure [:answer/validate]} {:db/id "q-103890/selection/bd56882dbc0223bbd378bceca227f179cbfa3dcbea54d30e237b8aa5e830317e" :answer/id #uuid "1b6369aa-4d19-5610-8e90-5