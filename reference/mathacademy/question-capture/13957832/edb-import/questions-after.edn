#{[{:db/id #edb/ref 17592186078170 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/id #uuid "36c32777-8081-5431-a112-321738a3adab" :question/math-academy-id "e-3228" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - 4x + 6y = 12$." :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}\nx^{2} + y^{2} - 4x + 6y &= 12 \\\\\n(x^{2} - 4x) + (y^{2} + 6y) &= 12 \\\\\n(x^{2} - 2 \\cdot 2x + 2^{2}) + (y^{2} + 2 \\cdot 3y + 3^{2}) &= 12 + 2^{2} + 3^{2} \\\\\n(x^{2} - 2 \\cdot 2x + 2^{2}) + (y^{2} + 2 \\cdot 3y + 3^{2}) &= 25\n\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}\n(x - 2)^{2} + (y + 3)^{2} &= 5^{2} \\\\\n(x - 2)^{2} + (y - (-3))^{2} &= 5^{2}\n\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-3)$ and its radius is $5$."}] [{:db/id #edb/ref 17592186078171 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/id #uuid "b05d1090-fd7b-52eb-84a7-55377ead0dda" :question/math-academy-id "e-3229" :question/problem "Find the center and radius of the circle whose equation is $x^2 + y^2 - x = 6$." :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}\nx^{2} + y^{2} - x &= 6 \\\\\n(x^{2} - x) + y^{2} &= 6 \\\\\n(x^{2} - 2 \\cdot \\frac{1}{2}x + (\\frac{1}{2})^{2}) + y^{2} &= 6 + (\\frac{1}{2})^{2} \\\\\n(x^{2} - 2 \\cdot \\frac{1}{2}x + (\\frac{1}{2})^{2}) + y^{2} &= \\frac{25}{4}\n\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}\n(x - \\frac{1}{2})^{2} + y^{2} &= (\\frac{5}{2})^{2} \\\\\n(x - \\frac{1}{2})^{2} + (y - 0)^{2} &= (\\frac{5}{2})^{2}\n\\end{aligned}\n$$\n\nTherefore, the circle is centered at\n\n$$\n\\left(\\dfrac{1}{2}, 0 \\right)\n$$\n\nand its radius is\n\n$$\n\\dfrac{5}{2}\n$$"}] [{:db/id #edb/ref 17592186267588 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3fa180-68be-5426-b193-a1a034d84dea" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186267590} {:answer/id #uuid "c01a4f0c-2e1e-5ecd-a21c-5556064fa38f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186267591} {:answer/id #uuid "b2bf761f-e3fe-5680-a48d-4a0dc918c4ec" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186267592} {:answer/id #uuid "1b6369aa-4d19-5610-8e90-5d836b0230ab" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186267593} {:answer/id #uuid "1281df56-2554-51f4-a1f6-17b289f9bfdd" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186267594}] :answer-field/correct {:answer/id #uuid "b2bf761f-e3fe-5680-a48d-4a0dc918c4ec" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186267592} :answer-field/id #uuid "b1180fbc-fd40-5da3-b3c2-64cd7891f8fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267589}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "887a23fb-1cd0-5cc6-962a-e0db32f88480" :question/math-academy-id "q-103890" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+3x-y-2=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+3x-y-2 & =0 \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =2 \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =2+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{9}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{9}{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{3}{\\sqrt{2}})}^{2}\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{3}{\\sqrt{2}}.$"}] [{:db/id #edb/ref 17592186267595 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67035495-b331-5e7c-8953-3dc5b889059c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-7,0)$, radius: $49$" :db/id #edb/ref 17592186267597} {:answer/id #uuid "fab7dd4d-dc65-514b-9772-d5d30b096275" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186267598} {:answer/id #uuid "3198fda6-31bf-5d2f-95cd-fdb6dff384b4" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186267599} {:answer/id #uuid "56ce61a3-ac2e-56a2-8b11-f20042f8e067" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186267600} {:answer/id #uuid "2dd28ccc-5041-5268-905d-590ac5a1d07f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7,0)$, radius: $7$" :db/id #edb/ref 17592186267601}] :answer-field/correct {:answer/id #uuid "fab7dd4d-dc65-514b-9772-d5d30b096275" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186267598} :answer-field/id #uuid "14533ebb-5210-55ff-85c5-884fb46c55ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267596}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3f6a0f67-fd62-5333-8099-37761d6fc395" :question/math-academy-id "q-103892" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7x=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7x & =0 \\\\ ({x}^{2}+7x)+{y}^{2} & =0 \\\\ ({x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2})+{y}^{2} & ={(\\frac{7}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x+\\frac{7}{2})}^{2}+{y}^{2} & ={(\\frac{7}{2})}^{2} \\\\ {(x-(-\\frac{7}{2}))}^{2}+(y-0)^{2} & ={(\\frac{7}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{7}{2},0)$ and its radius is $\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186267602 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81c92a54-b378-5306-b24a-5a883c1ba843" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},4)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186267604} {:answer/id #uuid "a829303f-f937-5c4a-b398-c4820a77a361" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186267605} {:answer/id #uuid "d75a2e4f-54b3-556b-84df-554d221896be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186267606} {:answer/id #uuid "dcb32ff0-0207-52d3-98bb-5655d30da220" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186267607} {:answer/id #uuid "c09624d9-3433-53e0-b5c2-46b48ae59e20" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186267608}] :answer-field/correct {:answer/id #uuid "d75a2e4f-54b3-556b-84df-554d221896be" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186267606} :answer-field/id #uuid "4ac5ca72-2993-563f-83e5-10c84694f15e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267603}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ad58d20a-321f-5920-925e-1ef527d5406d" :question/math-academy-id "q-103894" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3x-4y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3x-4y & =0 \\\\ ({x}^{2}-3x)+({y}^{2}-4y) & =0 \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & ={(\\frac{3}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2}+(y-2)^{2} & ={(\\frac{5}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{3}{2},2)$ and its radius is $\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186267609 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc2d5659-90c2-562f-8b73-5bcbf3b1c11f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267611} {:answer/id #uuid "b4ee14f2-0816-5365-9a87-a2a32ab4ba59" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186267612} {:answer/id #uuid "bee2a7f9-9e0d-50de-97bd-23f858c54752" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267613} {:answer/id #uuid "db6d8342-6de0-5be2-88b7-25271850311e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{1}{2})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267614} {:answer/id #uuid "155656d9-ed94-5c9c-a983-b6a88c31ee4b" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186267615}] :answer-field/correct {:answer/id #uuid "bc2d5659-90c2-562f-8b73-5bcbf3b1c11f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267611} :answer-field/id #uuid "cdbd9e1a-f976-5c08-bcd3-e48c96cc1175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267610}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fb848c78-f3b3-5f5a-9ab1-16e531bb66fd" :question/math-academy-id "q-103896" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-\\frac{1}{2}y=\\frac{1}{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-\\frac{1}{2}y & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-\\frac{1}{2}y) & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & ={(\\frac{1}{4})}^{2}+\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186267616 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03894442-088c-57e0-8bae-f6305a621117" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186267618} {:answer/id #uuid "25127a4a-0b74-5e8a-9ca1-33e3de3a4f93" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186267619} {:answer/id #uuid "5f4305da-9bf6-5240-bf92-e77c19b58751" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186267620} {:answer/id #uuid "cc7e6c80-4f88-5e91-9995-e75768ee7492" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186267621} {:answer/id #uuid "6efdb8d8-fe2e-54ed-8e7c-4b8fe98b7852" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186267622}] :answer-field/correct {:answer/id #uuid "25127a4a-0b74-5e8a-9ca1-33e3de3a4f93" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186267619} :answer-field/id #uuid "48ac1700-5645-50e6-b4a8-ecf4768b91f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267617}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ef135fe4-2cc3-594b-85e4-18d9af72e974" :question/math-academy-id "q-15456" :question/problem "A circle in the Cartesian plane is given by the equation \n$137+6y=-{y}^{2}-{x}^{2}-24x.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}137+6y & =-{y}^{2}-{x}^{2}-24x \\\\ {x}^{2}+24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}+24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-(-12))^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-12,b=-3$ and $r=4,$  and\n\n$$\na+b+r=-12-3+4=-11.\n$$"}] [{:db/id #edb/ref 17592186267623 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c3ebf6f-a27a-5e77-97ca-c79e838e0430" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,-16)$, radius: $9$" :db/id #edb/ref 17592186267625} {:answer/id #uuid "0fb6df86-216e-5057-99c6-67ab4c39d7d7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(16,-4)$, radius: $3$" :db/id #edb/ref 17592186267626} {:answer/id #uuid "1f1fa414-403a-524c-a7d3-3a821205658c" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-16,4)$, radius: $2$" :db/id #edb/ref 17592186267627} {:answer/id #uuid "e9f48cc5-3782-5809-807a-fbdcb380c190" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,16)$, radius: $7$" :db/id #edb/ref 17592186267628} {:answer/id #uuid "ebee8a28-ea38-5dca-ae4d-8428d6c7a450" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-16)$, radius: $3$" :db/id #edb/ref 17592186267629}] :answer-field/correct {:answer/id #uuid "ebee8a28-ea38-5dca-ae4d-8428d6c7a450" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-16)$, radius: $3$" :db/id #edb/ref 17592186267629} :answer-field/id #uuid "6ab62e85-50c4-52bf-bd80-a26823b17959" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267624}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c7c63903-55d6-5d67-b473-e574826fdf67" :question/math-academy-id "q-15461" :question/problem "Find the center and radius of the circle whose equation is $8x+32y+{y}^{2}=-263-{x}^{2}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+32y+{y}^{2} & =-263-{x}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}+32y) & =-263 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}+2\\cdot 16y+{16}^{2}) & =-263+{4}^{2}+{16}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}+2\\cdot 16y+{16}^{2}) & =9\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y+16)^{2} & ={3}^{2} \\\\ (x-(-4))^{2}+(y-(-16))^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-4,-16)$ and its radius is $3.$"}] [{:db/id #edb/ref 17592186267630 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9ac6b21-7f5d-598d-939b-8205c48bf2a5" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,0)$, radius: $4$" :db/id #edb/ref 17592186267632} {:answer/id #uuid "80642a10-2cc6-5629-9831-8c57755e62a3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,2)$, radius: $21$" :db/id #edb/ref 17592186267633} {:answer/id #uuid "96054646-cc27-5077-a167-10340fd6522a" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,-4)$, radius: $6$" :db/id #edb/ref 17592186267634} {:answer/id #uuid "14ef14db-61e7-5506-975a-379994078334" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-2)$, radius: $5$" :db/id #edb/ref 17592186267635} {:answer/id #uuid "6a2b5c07-17c2-5b25-9ed4-e1870b3c9211" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $5$" :db/id #edb/ref 17592186267636}] :answer-field/correct {:answer/id #uuid "14ef14db-61e7-5506-975a-379994078334" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-2)$, radius: $5$" :db/id #edb/ref 17592186267635} :answer-field/id #uuid "42ad433b-ba40-59b4-ab30-72e5a661ed22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267631}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c05e21fb-c735-5386-b5cb-2d2e9d606786" :question/math-academy-id "q-5180" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}+4y=20.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2}+4y & =20 \\\\ ({x}^{2}+2x)+({y}^{2}+4y) & =20 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =20+{1}^{2}+{2}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =25\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+2)^{2} & ={5}^{2} \\\\ (x-(-1))^{2}+(y-(-2))^{2} & ={5}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,-2)$ and its radius is $5.$"}] [{:db/id #edb/ref 17592186267637 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ba2797-b988-56d4-83ea-82584889138e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $7$" :db/id #edb/ref 17592186267639} {:answer/id #uuid "40cce118-f677-5ab4-8a7e-a2eca4461d74" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $8$" :db/id #edb/ref 17592186267640} {:answer/id #uuid "83d1fbf6-d2eb-55eb-875e-e38f946cbeaa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $4$" :db/id #edb/ref 17592186267641} {:answer/id #uuid "6ef8eabf-8f27-5a8e-a054-2e78be3b9bbc" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $8$" :db/id #edb/ref 17592186267642} {:answer/id #uuid "0e8e5493-b004-57f0-add5-f414437af640" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186267643}] :answer-field/correct {:answer/id #uuid "0e8e5493-b004-57f0-add5-f414437af640" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186267643} :answer-field/id #uuid "8bba623e-1098-55dd-b2aa-6f7deaa41663" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267638}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6ac8461a-29d0-5698-901e-84a35dae5276" :question/math-academy-id "q-5183" :question/problem "Find the center and radius of the circle whose equation is ${y}^{2}-8x-10y+{x}^{2}=8.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}-8x-10y+{x}^{2} & =8 \\\\ ({x}^{2}-8x)+({y}^{2}-10y) & =8 \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =8+{4}^{2}+{5}^{2} \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-4)^{2}+(y-5)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(4,5)$ and its radius is $7.$"}] [{:db/id #edb/ref 17592186267644 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049b955b-fdf1-5dde-9c00-f5f212ec3402" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,2)$, radius: $2$" :db/id #edb/ref 17592186267646} {:answer/id #uuid "d34d348c-22a6-5d4f-b5a3-7baee0b12879" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $2$" :db/id #edb/ref 17592186267647} {:answer/id #uuid "ba749403-bff0-5677-9191-b791246b4be0" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $4$" :db/id #edb/ref 17592186267648} {:answer/id #uuid "4e99dbc7-762f-502f-9699-b85176ec48ce" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,-2)$, radius: $4$" :db/id #edb/ref 17592186267649} {:answer/id #uuid "30c4c7c8-ecbc-5019-a51f-917367a31174" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-4)$, radius: $2$" :db/id #edb/ref 17592186267650}] :answer-field/correct {:answer/id #uuid "d34d348c-22a6-5d4f-b5a3-7baee0b12879" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-2)$, radius: $2$" :db/id #edb/ref 17592186267647} :answer-field/id #uuid "17cad6eb-93ef-5ede-994c-aa55be6230cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267645}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de50b32f-0e81-5265-af93-914b19cb4b00" :question/math-academy-id "q-5191" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}-10x+{y}^{2}+4y+25=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-10x+{y}^{2}+4y+25 & =0 \\\\ ({x}^{2}-10x)+({y}^{2}+4y) & =-25 \\\\ ({x}^{2}-2\\cdot 5x+{5}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-25+{5}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 5x+25)+({y}^{2}+2\\cdot 2y+4) & =4\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-5)^{2}+(y+2)^{2} & =4 \\\\ (x-5)^{2}+(y-(-2))^{2} & ={2}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(5,-2)$ and its radius is $2.$"}] [{:db/id #edb/ref 17592186267651 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c694fd-5f25-5db4-91ef-da64448ef115" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,-\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186267653} {:answer/id #uuid "9169325b-3dfc-533a-b438-cd09ce7895a0" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267654} {:answer/id #uuid "3f1a59f5-ac1d-522e-b6fb-7bb4e1fbc3ee" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267655} {:answer/id #uuid "14880970-af68-5240-862b-98f07eb9db43" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{4},1),$ radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186267656} {:answer/id #uuid "a7877a85-b0db-518d-a396-fc3de9de0c9f" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,\\frac{1}{4}),$ radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186267657}] :answer-field/correct {:answer/id #uuid "3f1a59f5-ac1d-522e-b6fb-7bb4e1fbc3ee" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,\\frac{1}{4}),$ radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186267655} :answer-field/id #uuid "224e7539-cbe7-504e-9c02-1b5042553fe2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267652}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "64257e64-8ece-56eb-a9da-46dae15085ca" :question/math-academy-id "q-76374" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}-4x+2{y}^{2}-y=-1.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}-4x+2{y}^{2}-y & =-1 \\\\ {x}^{2}-2x+{y}^{2}-\\frac{1}{2}y & =-\\frac{1}{2} \\\\ ({x}^{2}-2x)+({y}^{2}-\\frac{1}{2}y) & =-\\frac{1}{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =-\\frac{1}{2}+{1}^{2}+{(\\frac{1}{4})}^{2} \\\\ ({x}^{2}-2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot \\frac{1}{4}y+{(\\frac{1}{4})}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-1)^{2}+{(y-\\frac{1}{4})}^{2} & =\\frac{9}{16} \\\\ (x-1)^{2}+{(y-\\frac{1}{4})}^{2} & ={(\\frac{3}{4})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(1,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"}]}
