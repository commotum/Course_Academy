 #edb/ref 17592186279669}] :answer-field/correct {:answer/id #uuid "60ee425f-5f2d-509c-b87c-90787c8a4175" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi}{4}" :db/id #edb/ref 17592186279669} :answer-field/id #uuid "2cc0ce40-0864-5a33-a09f-3e7a2e290b53" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279668} {:answer-field/choices [{:answer/id #uuid "41a10b61-200f-5d2f-8f1e-41e9abc92fee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19\\pi}{12}" :db/id #edb/ref 17592186279671}] :answer-field/correct {:answer/id #uuid "41a10b61-200f-5d2f-8f1e-41e9abc92fee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19\\pi}{12}" :db/id #edb/ref 17592186279671} :answer-field/id #uuid "0e741ea3-e2d2-58e6-9ad3-9c08f58597ad" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279670} {:answer-field/choices [{:answer/id #uuid "2918c7e9-be4f-50fc-9143-98598cd05233" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi}{12}" :db/id #edb/ref 17592186279673}] :answer-field/correct {:answer/id #uuid "2918c7e9-be4f-50fc-9143-98598cd05233" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi}{12}" :db/id #edb/ref 17592186279673} :answer-field/id #uuid "dd3cf5f0-4488-5c51-b391-aa950d38f750" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279672}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8191d21e-e7b2-58ac-88d7-73913c678fbd" :question/math-academy-id "q-274700" :question/problem "Expressed in **ascending order** in radians, the **exact solutions** to the equation $\\operatorname{tan}⁡(3x)=-1,$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$\n {{field-1}}$,\\,\\,{x}_{2}=$ \n{{field-2}}$,\\,\\,{x}_{3}=$ \n{{field-3}}$,\\,\\,{x}_{4}=$ \n{{field-4}}$,\\,\\,{x}_{5}=$ \n{{field-5}}$,\\,\\,{x}_{6}=$ \n{{field-6}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}3x & =-\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =-\\frac{\\pi }{12}+\\frac{n\\pi }{3} \\\\ x & =\\frac{(4n-1)\\pi }{12}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=1$ gives $x=\\frac{\\pi }{4}$\n\n- Setting $n=2$ gives $x=\\frac{7\\pi }{12}$\n\n- Setting $n=3$ gives $x=\\frac{11\\pi }{12}$\n\n- Setting $n=4$ gives $x=\\frac{5\\pi }{4}$\n\n- Setting $n=5$ gives $x=\\frac{19\\pi }{12}$\n\n- Setting $n=6$ gives $x=\\frac{23\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ \n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}=\\frac{\\pi }{4},\\,\\,{x}_{2}=\\frac{7\\pi }{12},\\,\\,{x}_{3}=\\frac{11\\pi }{12},\\,\\,{x}_{4}=\\frac{5\\pi }{4},\\,\\,{x}_{5}=\\frac{19\\pi }{12},\\,\\,{x}_{6}=\\frac{23\\pi }{12}.\n$$"}] [{:db/id #edb/ref 17592186279674 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f40f50e-49a7-5eda-b642-dc7085569b23" :knowledge-point/title "Solving a Trigonometric Equation Containing the Tangent Function Transformed by One Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a43a6a5a-e0ea-56ff-945b-44d2f8e03a4f" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186279676} {:answer/id #uuid "4486a80f-6b4c-5bc0-970e-2f81b292afd4" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186279677}] :answer-field/correct {:answer/id #uuid "a43a6a5a-e0ea-56ff-945b-44d2f8e03a4f" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186279676} :answer-field/id #uuid "81d2