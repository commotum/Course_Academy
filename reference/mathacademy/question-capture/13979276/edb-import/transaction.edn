ield-6/ecd9c1766b11afd30e73de1de4e87750c83775d2df52c6bbe9186b912aa0857c"] :db/ensure [:answer-field/validate]} {:db/id "q-328359/field-7/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer/id #uuid "e6fe8c16-f73f-5f89-ae14-76bc898878f3" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-328359/field-7" :answer-field/id #uuid "8e680df8-6a0a-5a87-b627-1237c7363719" :answer-field/key "field-7" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328359/field-7/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3" :answer-field/choices ["q-328359/field-7/30c65f95461d7cf832bda679931de2b4099e743d19de1b695cb0707c6a50ede3"] :db/ensure [:answer-field/validate]} {:db/id "q-328359/field-8/9c85ea125e56a76fbf756f5eedac6011c7785e0ad22a50a8a43d0b1bae0512b2" :answer/id #uuid "4820e11e-46e2-52b3-9ab6-9f53ea6c8b4c" :answer/type :answer.type/math :answer/value "\\frac{23\\pi}{12}" :db/ensure [:answer/validate]} {:db/id "q-328359/field-8" :answer-field/id #uuid "ffb4073c-e853-56f7-8a64-854a42c4fdc7" :answer-field/key "field-8" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328359/field-8/9c85ea125e56a76fbf756f5eedac6011c7785e0ad22a50a8a43d0b1bae0512b2" :answer-field/choices ["q-328359/field-8/9c85ea125e56a76fbf756f5eedac6011c7785e0ad22a50a8a43d0b1bae0512b2"] :db/ensure [:answer-field/validate]} {:db/id "q-328359" :question/id #uuid "05d62ebd-da1d-59cf-9c43-a246ead9b2bf" :question/math-academy-id "q-328359" :question/problem "Expressed in **ascending order** in radians, the **exact solutions** to the equation  $\\operatorname{tan}⁡(4x-\\frac{\\pi }{3})=\\sqrt{3},$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}$,\\,{x}_{3}=$\n{{field-3}}$,\\,{x}_{4}=$\n{{field-4}}\n\n${x}_{5}=$\n{{field-5}}$,\\,{x}_{6}=$\n{{field-6}}$,\\,{x}_{7}=$\n{{field-7}}$,\\,{x}_{8}=$\n{{field-8}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}4x-\\frac{\\pi }{3} & =\\frac{\\pi }{3}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}4x & =\\frac{\\pi }{3}+\\frac{\\pi }{3}+n\\pi  \\\\ 4x & =\\frac{2\\pi }{3}+n\\pi  \\\\ x & =\\frac{\\pi }{6}+\\frac{n\\pi }{4} \\\\ x & =\\frac{(3n+2)\\pi }{12}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{6}$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{12}$\n\n- Setting $n=2$ gives $x=\\frac{2\\pi }{3}$\n\n- Setting $n=3$ gives $x=\\frac{11\\pi }{12}$\n\n- Setting $n=4$ gives $x=\\frac{7\\pi }{6}$\n\n- Setting $n=5$ gives $x=\\frac{17\\pi }{12}$\n\n- Setting $n=6$ gives $x=\\frac{5\\pi }{3}$\n\n- Setting $n=7$ gives $x=\\frac{23\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ \n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{\\pi }{6},\\,{x}_{2}=\\frac{5\\pi }{12},\\,{x}_{3}=\\frac{2\\pi }{3},\\,{x}_{4}=\\frac{11\\pi }{12}, \\\\ {x}_{5} & =\\frac{7\\pi }{6},\\,{x}_{6}=\\frac{17\\pi }{12},\\,{x}_{7}=\\frac{5\\pi }{3},\\,{x}_{8}=\\frac{23\\pi }{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-328359/field-1" "q-328359/field-2" "q-328359/field-3" "q-328359/field-4" "q-328359/field-5" "q-328359/field-6" "q-328359/field-7" "q-328359/field-8"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f3bd5e5c-b8d1-53e5-9968-8bef8faceb4b"] :knowledge-point/questions ["q-328359"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328351/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "49dc544f-bf24-5444-9dd0-facd04bd5fd9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328351/field-1" :answer-field/id #uuid "c7c43dfe-aa04-5a5d-b7e2-6c94b175039d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328351/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328351/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328351/field-2/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "fb03a6aa-23b6-5ff3-bcc7-417fd4d2f367" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-328351/field-2" :answer-field/id #uuid "eb390330-83d8-5eb6-a659-d75b12a8c375" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328351/field-2/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer-field/choices ["q-328351/field-2/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412"] :db/ensure [:answer-field/validate]} {:db/id "q-328351/field-3/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer/id #uuid "e92400b9-bc2f-5ff8-a3b9-7728634154d1" :answer/type :answer.type/math :answer/value "180" :db/ensure [:answer/validate]} {:db/id "q-328351/field-3" :answer-field/id #uuid "1f3d98e5-30cc-50b4-aa92-01d46f23b53b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328351/field-3/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18" :answer-field/choices ["q-328351/field-3/23191a7abb2085fa58cfcf0bd067eedb8c4feb2e427bc3ee2024594244bb9b18"] :db/ensure [:answer-field/validate]} {:db/id "q-328351/field-4/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer/id #uuid "b670f12b-6ddf-5c4d-b961-d054354c05e5" :answer/type :answer.type/math :answer/value "270" :db/ensure [:answer/validate]} {:db/id "q-328351/field-4" :answer-field/id #uuid "10ffcf17-651b-596d-9841-08ccdfc42bc7" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328351/field-4/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer-field/choices ["q-328351/field-4/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7"] :db/ensure [:answer-field/validate]} {:db/id "q-328351" :question/id #uuid "bdb7a25f-1f4a-5b5e-9bf8-a8766f4279fa" :question/math-academy-id "q-328351" :question/problem "Expressed in **ascending order** in degrees, the **exact solutions** to the equation $4\\operatorname{tan}⁡(2x-{45}^{∘})+4=0,$ for ${0}^{∘}\\le x<{360}^{∘},$ are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$\n{{field-2}}${}^{∘},\\,{x}_{3}=$\n{{field-3}}${}^{∘},\\,{x}_{4}=$\n{{field-4}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}4\\operatorname{tan}⁡(2x-{45}^{∘})+4 & =0 \\\\ 4\\operatorname{tan}⁡(2x-{45}^{∘}) & =-4 \\\\ \\operatorname{tan}⁡(2x-{45}^{∘}) & =-1.\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x-{45}^{∘} & =-{45}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get\n\n$$\n\\begin{aligned}2x & ={45}^{∘}-{45}^{∘}+n\\cdot {180}^{∘} \\\\ 2x & =n\\cdot {180}^{∘} \\\\ x & =n\\cdot {90}^{∘}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={0}^{∘}$\n\n- Setting $n=1$ gives $x={90}^{∘}$\n\n- Setting $n=2$ gives $x={180}^{∘}$\n\n- Setting $n=3$ gives $x={270}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ \n\nSo, in ascending order, the solutions are \n\n$$\n{x}_{1}={0}^{∘},\\,{x}_{2}={90}^{∘},\\,{x}_{3}={180}^{∘},\\,{x}_{4}={270}^{∘}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-328351/field-1" "q-328351/field-2" "q-328351/field-3" "q-328351/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f3bd5e5c-b8d1-53e5-9968-8bef8faceb4b"] :knowledge-point/questions ["q-328351"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-8482"] :question/problem "Consider the equation $\\operatorname{tan}⁡(2x-\\frac{\\pi }{3})=-\\sqrt{3}$ for $0\\le x<2\\pi .$ Given that the exact solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{2}\\cdot {x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{3} & =-\\frac{\\pi }{3}+n\\pi .\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}+\\frac{\\pi }{3}+n\\pi  \\\\ 2x & =n\\pi  \\\\ x & =\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=0$\n\n- Setting $n=1$ gives $x=\\frac{\\pi }{2}$\n\n- Setting $n=2$ gives $x=\\pi $\n\n- Setting $n=3$ gives $x=\\frac{3\\pi }{2}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=0,\\frac{\\pi }{2},\\pi ,\\frac{3\\pi }{2}.\n$$\n\nFinally, since ${x}_{2}=\\frac{\\pi }{2}$ and ${x}_{3}=\\pi ,$ we have\n\n$$\n{x}_{2}\\cdot {x}_{3}=\\frac{\\pi }{2}\\cdot \\pi =\\frac{{\\pi }^{2}}{2}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-8556"] :question/problem "Consider the equation $\\sqrt{3}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})+3=0$ for $-\\pi <x\\le \\pi .$ If the exact solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{1}+{x}_{4}?$" :question/worked-solution "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}\\sqrt{3}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6})+3 & =0 \\\\ \\sqrt{3}\\operatorname{tan}⁡(2x+\\frac{\\pi }{6}) & =-3 \\\\ \\operatorname{tan}⁡(2x+\\frac{\\pi }{6}) & =-\\frac{3}{\\sqrt{3}} \\\\ \\operatorname{tan}⁡(2x+\\frac{\\pi }{6}) & =-\\sqrt{3}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =-\\frac{\\pi }{3}+n\\pi .\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}-\\frac{\\pi }{6}+n\\pi  \\\\ 2x & =-\\frac{\\pi }{2}+n\\pi  \\\\ x & =-\\frac{\\pi }{4}+\\frac{n\\pi }{2} \\\\ x & =\\frac{(2n-1)\\pi }{4}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi <x\\le \\pi .$\n\n- Setting $n=-1$ gives $x=-\\frac{3\\pi }{4}$\n\n- Setting $n=0$ gives $x=-\\frac{\\pi }{4}$\n\n- Setting $n=1$ gives $x=\\frac{\\pi }{4}$\n\n- Setting $n=2$ gives $x=\\frac{3\\pi }{4}$\n\nAll other values of $n$ generate solutions outside the domain $-\\pi <x\\le \\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=-\\frac{3\\pi }{4},\\,-\\frac{\\pi }{4},\\,\\frac{\\pi }{4},\\,\\frac{3\\pi }{4}\n$$\n\nFinally, since ${x}_{1}=-\\frac{3\\pi }{4}$ and ${x}_{4}=\\frac{3\\pi }{4},$ we have\n\n$$\n{x}_{1}+{x}_{4}=-\\frac{3\\pi }{4}+\\frac{3\\pi }{4}=0.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-8550"] :question/problem "Consider the equation $\\operatorname{tan}⁡(2x+\\frac{\\pi }{3})=\\frac{\\sqrt{3}}{3}$ for $-\\pi <x\\le \\pi .$ If the exact solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{2}+{x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{3} & =\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{6}-\\frac{\\pi }{3}+n\\pi  \\\\ 2x & =-\\frac{\\pi }{6}+n\\pi  \\\\ x & =-\\frac{\\pi }{12}+\\frac{n\\pi }{2} \\\\ x & =\\frac{(6n-1)\\pi }{12}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi <x\\le \\pi .$\n\n- Setting $n=-1$ gives $x=-\\frac{7\\pi }{12}$\n\n- Setting $n=0$ gives $x=-\\frac{\\pi }{12}$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{12}$\n\n- Setting $n=2$ gives $x=\\frac{11\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $-\\pi <x\\le \\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=-\\frac{7\\pi }{12},\\,-\\frac{\\pi }{12},\\,\\frac{5\\pi }{12},\\,\\frac{11\\pi }{12}.\n$$\n\nFinally, since ${x}_{2}=-\\frac{\\pi }{12}$ and ${x}_{3}=\\frac{5\\pi }{12},$ we have\n\n$$\n{x}_{2}+{x}_{3}=-\\frac{\\pi }{12}+\\frac{5\\pi }{12}=\\frac{\\pi }{3}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-65855/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" :answer/id #uuid "776d8315-d5bd-551b-987e-b69082eacc0d" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-65855/selection/2730a0af8102f8bcbf6ccc10af07b8dc5622c8cddd5e1f6ef65886476ed67499" :answer/id #uuid "3e5ce4eb-db38-527d-85ab-c79beedfc8ec" :answer/type :answer.type/math :answer/value "\\frac{4{\\pi }^{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-65855/selection/1a4ee89f0618612cc5673272ad35e8d4625ee9ed24d34bd6027e2e3a826aae92" :answer/id #uuid "b4e66774-751c-5eea-8d10-4af132761eff" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-65855/selection/8a062f85dfae2453091ecd95389dc9b0751d8bb7c18126361428cf17100dc6b2" :answer/id #uuid "f2983b5d-1f05-5e94-a60e-527bcb6f953e" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-65855/selection/036700265ffc6a9473c27cf0361784cfc24e841090a8239cee429a74cf087475" :answer/id #uuid "e0355ca6-5828-5463-8acc-5160551e38d7" :answer/type :answer.type/math :answer/value "\\frac{5{\\pi }^{2}}{12}" :db/ensure [:answer/validate]} {:db/id "q-65855/selection" :answer-field/id #uuid "ec58a1e8-7a8c-578f-97cd-11bdb61534c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65855/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" :answer-field/choices ["q-65855/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" "q-65855/selection/2730a0af8102f8bcbf6ccc10af07b8dc5622c8cddd5e1f6ef65886476ed67499" "q-65855/selection/1a4ee89f0618612cc5673272ad35e8d4625ee9ed24d34bd6027e2e3a826aae92" "q-65855/selection/8a062f85dfae2453091ecd95389dc9b0751d8bb7c18126361428cf17100dc6b2" "q-65855/selection/036700265ffc6a9473c27cf0361784cfc24e841090a8239cee429a74cf087475"] :db/ensure [:answer-field/validate]} {:db/id "q-65855" :question/id #uuid "32385bf9-21f8-5ffa-a56e-a6ed215bd301" :question/math-academy-id "q-65855" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the exact solutions to the equation $\\operatorname{tan}⁡2x=-\\frac{\\sqrt{3}}{3}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{6}+n\\pi  \\\\ x & =-\\frac{\\pi }{12}+\\frac{n\\pi }{2} \\\\ x & =\\frac{(6n-1)\\pi }{12}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{12}$\n\n- Setting $n=2$ gives $x=\\frac{11\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$ So, the solutions are $x=\\frac{5\\pi }{12},\\frac{11\\pi }{12}.$\n\nFinally, \n\n$$\n{x}_{1}+{x}_{2}=\\frac{5\\pi }{12}+\\frac{11\\pi }{12}=\\frac{4\\pi }{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65855/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9eb12a99-5169-52f7-8830-5de0d2d854f6"] :knowledge-point/questions ["q-65855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121558/selection/f463209293bd4cc45182dd5181335490604a8703a2ad0644c1e5df923f127eba" :answer/id #uuid "9abeff4f-7081-5c4e-93bc-7416794b815a" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{9}" :db/ensure [:answer/validate]} {:db/id "q-121558/selection/35d0af53e25a7911f6d08c6d063fcf9231a1273a16a0f7056530d6f5d5dfbdd8" :answer/id #uuid "9a30c90e-f891-5c42-b439-f9b6277aa206" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-121558/selection/ded5223ba109b16050fd2ed9a98315e4fa4e8b74b34949bbeaad746173ab22ec" :answer/id #uuid "39706848-34cb-52b6-a137-adfe0a1da07f" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{9}" :db/ensure [:answer/validate]} {:db/id "q-121558/selection/9f0d438dfd4d5982c3f4e3665de700db23e9bfeee576652451172a72342a875c" :answer/id #uuid "8a78c5ab-dedb-5d05-a9be-2cba49c14588" :answer/type :answer.type/math :answer/value "\\frac{17\\pi }{18}" :db/ensure [:answer/validate]} {:db/id "q-121558/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" :answer/id #uuid "7718bc86-72da-5c01-b4ef-3856325f575c" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-121558/selection" :answer-field/id #uuid "1a90c4ce-ffc2-5c3e-ae6e-f9123deb070d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121558/selection/ded5223ba109b16050fd2ed9a98315e4fa4e8b74b34949bbeaad746173ab22ec" :answer-field/choices ["q-121558/selection/f463209293bd4cc45182dd5181335490604a8703a2ad0644c1e5df923f127eba" "q-121558/selection/35d0af53e25a7911f6d08c6d063fcf9231a1273a16a0f7056530d6f5d5dfbdd8" "q-121558/selection/ded5223ba109b16050fd2ed9a98315e4fa4e8b74b34949bbeaad746173ab22ec" "q-121558/selection/9f0d438dfd4d5982c3f4e3665de700db23e9bfeee576652451172a72342a875c" "q-121558/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9"] :db/ensure [:answer-field/validate]} {:db/id "q-121558" :question/id #uuid "928a8e32-c255-52c7-a2c8-64bff84ba192" :question/math-academy-id "q-121558" :question/problem "Consider the equation $\\operatorname{tan}⁡3x=\\frac{\\sqrt{3}}{3}$ for $0\\le x<\\pi .$ If the exact solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ are written in ascending order, what is the value of ${x}_{1}+{x}_{3}?$" :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}3x & =\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{18}+\\frac{n\\pi }{3} \\\\ x & =\\frac{(1+6n)\\pi }{18}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{18}$\n\n- Setting $n=1$ gives $x=\\frac{7\\pi }{18}$\n\n- Setting $n=2$ gives $x=\\frac{13\\pi }{18}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3}$ (written in ascending order) are \n\n$$\nx=\\frac{\\pi }{18},\\frac{7\\pi }{18},\\frac{13\\pi }{18}.\n$$\n\nFinally, \n\n$$\n\\begin{aligned}{x}_{1}+{x}_{3} & =\\frac{\\pi }{18}+\\frac{13\\pi }{18} \\\\  & =\\frac{14\\pi }{18} \\\\  & =\\frac{7\\pi }{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121558/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9eb12a99-5169-52f7-8830-5de0d2d854f6"] :knowledge-point/questions ["q-121558"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328366/field-1/1dfe5d3e9f8fd42552c7b31c49336d4fae04902ae10782beb1dc9761d4ec8720" :answer/id #uuid "8149a868-11b5-5f9d-8fb1-39dfb7d01979" :answer/type :answer.type/math :answer/value "-\\frac{5\\pi}{8}" :db/ensure [:answer/validate]} {:db/id "q-328366/field-1" :answer-field/id #uuid "d7c88d87-d7a4-5364-aea1-b16bcbed6338" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328366/field-1/1dfe5d3e9f8fd42552c7b31c49336d4fae04902ae10782beb1dc9761d4ec8720" :answer-field/choices ["q-328366/field-1/1dfe5d3e9f8fd42552c7b31c49336d4fae04902ae10782beb1dc9761d4ec8720"] :db/ensure [:answer-field/validate]} {:db/id "q-328366/field-2/df003ee9c7fdf8044716e15095fade12195225d90442943b3a6680635b49447e" :answer/id #uuid "d3be3081-5f86-5ead-9f37-e3d507d656a2" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{8}" :db/ensure [:answer/validate]} {:db/id "q-328366/field-2" :answer-field/id #uuid "c505558b-5e80-54a1-8424-cc1bcb958ec4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328366/field-2/df003ee9c7fdf8044716e15095fade12195225d90442943b3a6680635b49447e" :answer-field/choices ["q-328366/field-2/df003ee9c7fdf8044716e15095fade12195225d90442943b3a6680635b49447e"] :db/ensure [:answer-field/validate]} {:db/id "q-328366/field-3/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff" :answer/id #uuid "3e29cd1c-b788-57d8-a024-17a1c0d26b9f" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{8}" :db/ensure [:answer/validate]} {:db/id "q-328366/field-3" :answer-field/id #uuid "7d742008-a4ee-58cd-83b6-bbb26e431c1d" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328366/field-3/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff" :answer-field/choices ["q-328366/field-3/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff"] :db/ensure [:answer-field/validate]} {:db/id "q-328366/field-4/982e7074bfc9300a47eac4545ea7a20092e7300b51396d862b143f05ee9fe7b6" :answer/id #uuid "5f7e081a-ddcc-541d-8ec8-0c286f0c65f4" :answer/type :answer.type/math :answer/value "\\frac{7\\pi}{8}" :db/ensure [:answer/validate]} {:db/id "q-328366/field-4" :answer-field/id #uuid "a395fad7-0f4e-5aa4-9141-385c9258da87" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328366/field-4/982e7074bfc9300a47eac4545ea7a20092e7300b51396d862b143f05ee9fe7b6" :answer-field/choices ["q-328366/field-4/982e7074bfc9300a47eac4545ea7a20092e7300b51396d862b143f05ee9fe7b6"] :db/ensure [:answer-field/validate]} {:db/id "q-328366" :question/id #uuid "cbb01e88-b572-58bc-9bf4-e3da4c96ce22" :question/math-academy-id "q-328366" :question/problem "Expressed in **ascending order** in radians, the **exact solutions** to the equation  $\\operatorname{tan}⁡(2x)=-1,$ for $-\\pi \\le x<\\pi ,$  are\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}$,\\,{x}_{3}=$\n{{field-3}}$,\\,{x}_{4}=$\n{{field-4}}." :question/worked-solution "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =-\\frac{\\pi }{8}+\\frac{n\\pi }{2} \\\\ x & =\\frac{(4n-1)\\pi }{8}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi \\le x<\\pi .$\n\n- Setting $n=-1$ gives $x=-\\frac{5\\pi }{8}$\n\n- Setting $n=0$ gives $x=-\\frac{\\pi }{8}$\n\n- Setting $n=1$ gives $x=\\frac{3\\pi }{8}$\n\n- Setting $n=2$ gives $x=\\frac{7\\pi }{8}$\n\nAll other values of $n$ generate solutions outside the domain $-\\pi \\le x<\\pi .$ \n\nSo, in ascending order,  the solutions are \n\n$$\n{x}_{1}=-\\frac{5\\pi }{8},\\,{x}_{2}=-\\frac{\\pi }{8},\\,{x}_{3}=\\frac{3\\pi }{8},\\,{x}_{4}=\\frac{7\\pi }{8}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328366/field-1" "q-328366/field-2" "q-328366/field-3" "q-328366/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9eb12a99-5169-52f7-8830-5de0d2d854f6"] :knowledge-point/questions ["q-328366"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-3788"] :question/problem "Consider the equation ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979276/assets/7e0f60e448e962ce549aebf35dd3e8464906da476372d1a1c5a37872c80fb440.png) for ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979276/assets/ca606454194eae814a48b23f94f31feeda9cf8909e13b3c7d89ea4bcf6c333be.png) If the exact solutions ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979276/assets/c0df697489169684397c5dc05995090373d8bd0cf88fdfddd0720d1e37ded701.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979276/assets/04948deceef460fa535a5e8adf5eac483de5ccc1cc3260b5f28391e2d2fbb4ff.png) are written in ascending order, what is the numerical value of ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979276/assets/086e44b3255b905dfb48a2debe16b415a94d490cac55af7f6a48434ec9605e99.png)" :question/worked-solution "