stion/math-academy-id "q-115105" :question/problem "Given that \n\n$$\n\\frac{5x+8}{(x+2)^{2}}=\\frac{5}{x+2}+\\frac{B}{(x+2)^{2}},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Multiplying both sides of the given equality by $(x+2)^{2}$ gives\n\n$$\n\\begin{aligned}5x+8 & =5(x+2)+B.\\end{aligned}\n$$\n\nLetting $x=-2$  gives\n\n$$\n\\begin{aligned}5(-2)+8 & =5(-2+2)+B \\\\ -2 & =0+B \\\\ B & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c"] :knowledge-point/questions ["q-115105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115101/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "548a65d2-4d6c-5328-b863-20d25619f8f3" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-115101/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "1b6a94eb-7c80-5761-afbc-0a9bbc3a32eb" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-115101/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "43cdd514-a719-587f-ac8a-a2a020c36d63" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-115101/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "a1559c3f-0744-54b9-84cb-010ea394d66c" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-115101/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c14b87f2-ff61-5344-b1bf-43b391f4f048" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-115101/selection" :answer-field/id #uuid "77523ba6-ca30-5cf2-a4a7-4e47acc0c839" :answer-field/key "selection" :answer-f