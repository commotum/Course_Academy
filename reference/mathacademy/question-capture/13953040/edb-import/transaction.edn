d03"] :db/ensure [:answer-field/validate]} {:db/id "q-73195" :question/id #uuid "077cbb69-7b3a-569b-b9f4-a96c83bfd1a4" :question/math-academy-id "q-73195" :question/problem "Given that \n\n$$\n\\frac{5x-2}{(x+3)^{2}}=\\frac{A}{x+3}-\\frac{17}{(x+3)^{2}},\n$$\n\nwhat is the value of $A?$" :question/worked-solution "Multiplying both sides of the given equality by $(x+3)^{2}$ gives\n\n$$\n\\begin{aligned}5x-2 & =A(x+3)-17.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}5(0)-2 & =A(0+3)-17 \\\\ -2 & =3A-17 \\\\ 15 & =3A \\\\ A & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73195/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c"] :knowledge-point/questions ["q-73195"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351180/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "29a7a68d-974d-530e-8135-370d43bfae06" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-351180/field-1" :answer-field/id #uuid "d62fe2c9-529f-578e-bcf1-b7bf26bdf9f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351180/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-351180/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-351180" :question/id #uuid "09ecfa29-3e1d-58ec-bb66-030884bb1735" :question/math-academy-id "q-351180" :question/problem "Express $\\frac{2x+17}{(x+5)^{2}}$ as a sum of partial fractions.\n\n|  | $\\frac{2x+17}{(x+5)^{2}}\\,=\\,\\frac{2}{(x+5)}\\,\\,+$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $(x+5)^{2}$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{2x+17}{(x+5)^{2}}=\\frac{2}{(x+5)}+\\frac{B}{(x+5)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+5)^{2}$ gives\n\n$$\n\\begin{aligned}2x+17 & =2(x+5)+B.\\end{aligned}\n$$\n\nLetting $x=-5$ gives\n\n$$\n\\begin{aligned}2(-5)+17 & =2(-5+5)+B \\\\ -10+17 & =0+B \\\\ B & =7.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{2x+17}{(x+5)^{2}}=\\frac{2}{(x+5)}+\\frac{7}{(x+5)^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351180/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c"] :knowledge-point/questions ["q-351180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351194/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "87d7279b-da1a-5d09-855f-675f3e71f350" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-351194/field-1" :answer-field/id #uuid "075806db-8199-5d17-b07a-535556e86bcb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351194/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-351194/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-351194/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "b2cbcf6a-5f35-54d9-b112-d091272783fb" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-351194/field-2" :answer-field/id #uuid "75e03637-c5a8-5d2c-a4ba-a17412de15ca" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351194/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-351194/field-2/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-351194" :question/id #uuid "f6baf907-562c-5625-b455-e1c9ae68d5aa" :question/math-academy-id "q-351194" :question/problem "Express $\\frac{5x-6}{(x+1)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{5x-6}{(x+1)^{2}}=$ | {{field-1}} | $-$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x+1$ |  | $(x+1)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{5x-6}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides of the above equality by $(x+1)^{2}$ gives\n\n$$\n5x-6=A(x+1)+B.\n$$\n\nLetting $x=-1$ gives\n\n$$\n\\begin{aligned}5(-1)-6 & =A(-1+1)+B \\\\ B & =-11.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}0-6 & =A(0+1)-11 \\\\ -6 & =A-11 \\\\ A & =5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{5x-6}{(x+1)^{2}}=\\frac{5}{x+1}-\\frac{11}{(x+1)^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351194/field-1" "q-351194/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187"] :knowledge-point/questions ["q-351194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73189/selection/2088e8b68a5012cf6f1fdefa2cebf9a59832f63685f2141e7773a6e62ac181a7" :answer/id #uuid "d9e20de9-7934-5d3d-8453-accfc6a1cc4d" :answer/type :answer.type/text :answer/value "$A=1$ and $B=4$" :db/ensure [:answer/validate]} {:db/id "q-73189/selection/276cad2a5cf85780a9e335e1a846113ba169af2831907020b3adf01582bbc2a8" :answer/id #uuid "5867dc4d-5739-56c8-bfca-904f0a159285" :answer/type :answer.type/text :answer/value "$A=2$ and $B=1$" :db/ensure [:answer/validate]} {:db/id "q-73189/selection/26a586a283d9635019536d50e1367ef67a365d947475d48551a1ffa8401bf5dd" :answer/id #uuid "51f742e7-875f-5745-8136-028062c98933" :answer/type :answer.type/text :answer/value "$A=4$ and $B=2$" :db/ensure [:answer/validate]} {:db/id "q-73189/selection/9fbe096a0b12b589c60ab4b2af334b13761821477d3fceb226b78ae93cff5f36" :answer/id #uuid "836982b5-7b6d-5262-b7ab-25192ad500cd" :answer/type :answer.type/text :answer/value "$A=2$ and $B=-1$" :db/ensure [:answer/validate]} {:db/id "q-73189/selection/b0ee5771d2e0c1ac3e81bdf027728ba9eb7642d2445400520d7c8f8d355d06b3" :answer/id #uuid "7a560135-07d5-5e39-a003-369bbc249dbe" :answer/type :answer.type/text :answer/value "$A=-2$ and $B=-1$" :db/ensure [:answer/validate]} {:db/id "q-73189/selection" :answer-field/id #uuid "fcb8ea7a-40a3-5e1f-a328-dde9b745c08b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73189/selection/9fbe096a0b12b589c60ab4b2af334b13761821477d3fceb226b78ae93cff5f36" :answer-field/choices ["q-73189/selection/2088e8b68a5012cf6f1fdefa2cebf9a59832f63685f2141e7773a6e62ac181a7" "q-73189/selection/276cad2a5cf85780a9e335e1a846113ba169af2831907020b3adf01582bbc2a8" "q-73189/selection/26a586a283d9635019536d50e1367ef67a365d947475d48551a1ffa8401bf5dd" "q-73189/selection/9fbe096a0b12b589c60ab4b2af334b13761821477d3fceb226b78ae93cff5f36" "q-73189/selection/b0ee5771d2e0c1ac3e81bdf027728ba9eb7642d2445400520d7c8f8d355d06b3"] :db/ensure [:answer-field/validate]} {:db/id "q-73189" :question/id #uuid "8e5d3142-b826-521f-9a5c-2fb700156ee4" :question/math-academy-id "q-73189" :question/problem "Given that \n\n$$\n\\frac{2x+1}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}},\n$$\n\nfind the real constants $A$ and $B.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+1)^{2}$ gives\n\n$$\n\\begin{aligned}2x+1 & =A(x+1)+B.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}2(-1)+1 & =A(-1+1)+B \\\\ -1 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}2(0)+1 & =A(0+1)-1 \\\\ 2 & =A\\end{aligned}\n$$\n\nTherefore, $A=2$ and $B=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73189/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187"] :knowledge-point/questions ["q-73189"] :db/ensure [:knowledge-point/validate]} {:db/i