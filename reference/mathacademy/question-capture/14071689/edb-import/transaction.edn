idate]} {:db/id "q-129447" :question/id #uuid "5e5b828c-ff83-5c0f-9142-19fd4fcaac5d" :question/math-academy-id "q-129447" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & {x}_{1}-2{x}_{2}+{x}_{3}=2 \\\\  & {x}_{2}+{x}_{3}=-\\frac{1}{2} \\\\  & {x}_{3}=-1\\end{aligned}\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=-\\frac{1}{2}\\,⟹\\,{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{1}{2}$ and ${x}_{3}=-1$ into the first equation to get\n\n$$\n{x}_{1}-2(\\frac{1}{2})+(-1)=2\\,⟹\\,{x}_{1}=2+1+1=4.\n$$\n\nTherefore, the solution is ${x}_{1}=4$, ${x}_{2}=\\frac{1}{2}$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨4,\\frac{1}{2},-1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129447/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-129447"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10196/selection/daecc05476bf121294f044a4116b69ff5eca71d1acf4169f2738896987d77915" :answer/id #uuid "a3d81afe-921f-5924-8ec4-3752eef4e765" :answer/type :answer.type/math :answer/value "⟨1,-3,2⟩" :db/ensure [:answer/validate]} {:db/id "q-10196/selection/f8cc6ec9fbf2e86d2cbb17991f435f01acf0ab7250534378a4572478eb80f788" :answer/id #uuid "0edc8e80-301c-592b-85cd-1b34f987523f" :answer/type :answer.type/math :answer/value "⟨1,-3,0⟩" :db/ensure [:answer/validate]} {:db/id "q-10196/selection/b0722f64c2bc050a6f031766037880b0883126e527653daf7de051ac21fde06c" :answer/id #uuid "dcf5cf11-c5e8-5cf5-a35a-49d716e9112c" :answer/type :answer.type/math :answer/value "⟨0,3,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-10196/selection/3d7b2806895ab54d2d05dedbc0c7445b2ee005281044914c9482956c0e55df35" :answer/id #uuid "ec9e3dfd-6d35-5ac5-bd17-acd8a11964b8" :answer/type :answer.typ