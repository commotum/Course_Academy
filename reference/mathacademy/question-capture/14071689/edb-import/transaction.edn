"q-129613/selection/6099e61251461670d582f1c487023df2f10f1ab32ddf8f8706b145a5da34bce1"] :db/ensure [:answer-field/validate]} {:db/id "q-129613" :question/id #uuid "5d1052d8-b940-5719-aa2e-19c644ae92d1" :question/math-academy-id "q-129613" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned} & 2{x}_{1}-{x}_{2}+4{x}_{3}=-1 \\\\  & {x}_{2}+2{x}_{3}=-3 \\\\  & -{x}_{3}=-1\\end{aligned}\n$$" :question/worked-solution "The third equation states that \n\n$$\n-{x}_{3}=-1\\,⟹\\,{x}_{3}=1.\n$$\n\n Substituting this into the second equation, we get\n\n$$\n{x}_{2}+2(1)=-3\\,⟹\\,{x}_{2}=-3-2=-5.\n$$\n\nNow, we substitute ${x}_{3}=1$ and ${x}_{2}=-5$ into the first equation to get\n\n$$\n2{x}_{1}-(-5)+4(1)=-1\\,⟹\\,{x}_{1}=\\frac{-1-5-4}{2}=-5.\n$$\n\nTherefore, the solution is \n${x}_{1}=-5$, ${x}_{2}=-5$, and ${x}_{3}=1.$  In vector form, the solution can be written as $[\\begin{aligned}-5 \\\\ -5 \\\\ 1\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129613/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-129613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72983/selection/b7cf2b4d37a4810af9c86cb5a850ea6c96caf1040a568c544dcf1bf2f62cefe3" :answer/id #uuid "762c9b72-bff9-5ac2-83c0-98b99dd2e4f4" :answer/type :answer.type/math :answer/value "⟨-1,\\frac{1}{2},\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-72983/selection/467875b966fcf1bfaa8a14cb041e08736b211022adfd4670e41c04c1ccf252f1" :answer/id #uuid "09196d8a-0f6e-5f17-bd63-e3c5edc5079a" :answer/type :answer.type/math :answer/value "⟨1,\\frac{1}{2},1⟩" :db/ensure [:answer/validate]} {:db/id "q-72983/selection/b9fdd5a408d6b77f9a51a91fe7a06bb951a60ed4c645540921e2503c023a7f48" :answer/id #uuid "fead6a44-2581-5313-9796-c6436f41264e" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},\\frac{1}{2},-1⟩" :db/ensure [:answer/validate]} {:db/id "q-72983/selection/a099fcc49d4c257e4c8704f5884c29b3c2ae084431b0652bb534f160613fd8e8" :answer/id #uuid "82b18c98-c4d5-5b60-a165-ec2d853b3d98" :answer/type :answer.type/math :answer/value "⟨-1,-1,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-72983/selection/69fb6acb544b2d1bdb00530d755700c54af2fbe980212f6dd34ddde0f13a1f8b" :answer/id #uuid "e0ebd03f-04c8-531b-bda9-35c14a2a5e0f" :answer/type :answer.type/math :answer/value "⟨-1,\\frac{1}{2},-1⟩" :db/ensure [:answer/validate]} {:db/id "q-72983/selection" :answer-field/id #uuid "43fd12c1-dcef-5689-8821-3f9dd4c9b252" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72983/selection/b7cf2b4d37a4810af9c86cb5a850ea6c96caf1040a568c544dcf1bf2f62cefe3" :answer-field/choices ["q-72983/selection/b7cf2b4d37a4810af9c86cb5a850ea6c96caf1040a568c544dcf1bf2f62cefe3" "q-72983/selection/467875b966fcf1bfaa8a14cb041e08736b211022adfd4670e41c04c1ccf252f1" "q-72983/selection/b9fdd5a408d6b77f9a51a91fe7a06bb951a60ed4c645540921e2503c023a7f48" "q-72983/selection/a099fcc49d4c257e4c8704f5884c29b3c2ae084431b0652bb534f160613fd8e8" "q-72983/selection/69fb6acb544b2d1bdb00530d755700c54af2fbe980212f6dd34ddde0f13a1f8b"] :db/ensure [:answer-field/validate]} {:db/id "q-72983" :question/id #uuid "c1d6feb3-6a84-59ca-8e6c-8c1a5c040ca0" :question/math-academy-id "q-72983" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}2 & 1 & 1 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 2 & 1\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & 2x+y+z=-1 \\\\  & y+z=1 \\\\  & 2z=1\\end{aligned}\n$$\n\nThe third equation states that\n \n\n$$\n2z=1\\,⟹\\,z=\\frac{1}{2}.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+(\\frac{1}{2})=1\\,⟹\\,y=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nNow, we substitute $z=y=\\frac{1}{2}$  into the first equation to get\n\n$$\n2x+(\\frac{1}{2})+(\\frac{1}{2})=-1\\,⟹\\,x=\\frac{1}{2}(-1-\\frac{1}{2}-\\frac{1}{2})=-1.\n$$\n\nTherefore, the solution is $x=-1$, $y=\\frac{1}{2}$, and $z=\\frac{1}{2}.$ In vector form, the solution can be written as $⟨-1,\\frac{1}{2},\\frac{1}{2}⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72983/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-72983"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4690"] :question/problem "Solve the following system of equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071689/assets/3b7ca238880ce9b06f58b1667d29b3fa0103560fa475238134cd3e802c7e7720.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4691"] :question/problem "Solve the system of equations that is represented by the augmented matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071689/assets/1ecadec01586fecee4a8b6d8ad5015168387124430849ed2e7d884908e28e927.png)" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071689/assets/c7c7d0904aa85c2cd9915e95a8ca3cee9857deb216148f59372204c6672d8811.png)\n\nThe third equation states that $x_3=5.$ Substituting this into the second equation, we get\n\n$$\nx_2+(5)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-5=-7.\n$$\n\nNow, we substitute both $x_3 = 5$ and $x_2 = -7$ into the first equation to get\n\n$$\nx_1+(-7)-(5) = 1\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = 1 + 7 + 5 = 13.\n$$\n\nTherefore, the solution is $x_1 = 13,$ $x_2=-7,$ and $x_3 = 5.$ Or, in vector form, the solution is $\\langle 13,-7,5 \\rangle.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4692"] :question/problem "Solve the system of equations that is represented by the augmented matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071689/assets/fd5c0fe6de60e36b0bd2414cb8ef991265c30bdfa4d8cfdac3242f51a54dbb87.png)" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x_1,$ $x_2,$ and $x_3.$ We obtain the following system of linear equations:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071689/assets/41347eb5694181e386cae05a31e455d12e2fbd1a0d70cd36bb37ed72da75f82d.png)\n\nThe third equation states that\n\n$$\n3x_3=3 \n\t\\qquad\\Longrightarrow\\qquad \n\tx_3=1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\nx_2+(1)=-2\n\t\\qquad\\Longrightarrow\\qquad\n\tx_2=-2-1=-3.\n$$\n\nNow, we substitute both $x_3 = 1$ and $x_2 = -3$ into the first equation to get\n\n$$\n2x_1+(-3)-(1) = 0\n\t\\qquad\\Longrightarrow\\qquad\n\tx_1 = \\dfrac{1}{2} (3 + 1) = 2.\n$$\n\nTherefore, the solution is $x_1 = 2,$ $x_2=-3,$ and $x_3 = 1.$ Or, in vector form, the solution is $\\langle 2,-3,1 \\rangle.$" :db/ensure [:question/validate]}]
