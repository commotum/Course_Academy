 :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-20452"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129457/selection/23010cdde42f7379553ec867d98f614c43ebaa7a53fa06bab51c29b9785de282" :answer/id #uuid "7420e76d-dbaf-559a-b8e5-c0b92f66f131" :answer/type :answer.type/math :answer/value "⟨1,\\frac{1}{3},2⟩" :db/ensure [:answer/validate]} {:db/id "q-129457/selection/7e21e104f10bfa5257ffb6516e4d4ff065cca58c029cbb947215270dfa0f3242" :answer/id #uuid "3a8f6aff-d611-58c7-ab3a-e08f92e2dd97" :answer/type :answer.type/math :answer/value "⟨5,-\\frac{1}{3},2⟩" :db/ensure [:answer/validate]} {:db/id "q-129457/selection/2852e9d4923f1c37c5a6ec5cbbf8ab6915918d6208d1cb30fb9ea270403ecd1e" :answer/id #uuid "10025ac4-0e41-5a06-84fa-1c1ff50bb639" :answer/type :answer.type/math :answer/value "⟨5,-\\frac{5}{3},2⟩" :db/ensure [:answer/validate]} {:db/id "q-129457/selection/9a7b1e1bce5af4bb96f0870eb6849525c152aeb3b0906e912c3eca491d313b3c" :answer/id #uuid "74269e3a-6935-5920-87d5-050652b14293" :answer/type :answer.type/math :answer/value "⟨1,-\\frac{1}{3},2⟩" :db/ensure [:answer/validate]} {:db/id "q-129457/selection/69acdc260b97e7ea045472fd998c09c21898543e8fa931f09baabbd886664212" :answer/id #uuid "6d2221d7-dd65-5f54-8537-8b9183e55d15" :answer/type :answer.type/math :answer/value "⟨3,-\\frac{5}{3},2⟩" :db/ensure [:answer/validate]} {:db/id "q-129457/selection" :answer-field/id #uuid "94814854-2555-5f05-858d-0fd44357e53c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129457/selection/2852e9d4923f1c37c5a6ec5cbbf8ab6915918d6208d1cb30fb9ea270403ecd1e" :answer-field/choices ["q-129457/selection/23010cdde42f7379553ec867d98f614c43ebaa7a53fa06bab51c29b9785de282" "q-129457/selection/7e21e104f10bfa5257ffb6516e4d4ff065cca58c029cbb947215270dfa0f3242" "q-129457/selection/2852e9d4923f1c37c5a6ec5cbbf8ab6915918d6208d1cb30fb9ea270403ecd1e" "q-129457/selection/9a7b1e1bce5af4bb96f0870eb6849525c152aeb3b0906e912c3eca491d313b3c" "q-129457/selection/69acdc260b97e7ea045472fd998c09c21898543e8fa931f09baabbd886664212"] :db/ensure [:answer-field/validate]} {:db/id "q-129457" :question/id #uuid "2be2eddf-2797-5459-b6f4-6e33f3a5ea60" :question/math-academy-id "q-129457" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}1 & 3 & 1 & 2 \\\\ 0 & 1 & \\frac{1}{3} & -1 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & {x}_{1}+3{x}_{2}+{x}_{3}=2 \\\\  & {x}_{2}+\\frac{{x}_{3}}{3}=-1 \\\\  & {x}_{3}=2\\end{aligned}\n$$\n\nThe third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+\\frac{2}{3}=-1\\,⟹\\,{x}_{2}=-1-\\frac{2}{3}=-\\frac{5}{3}.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-\\frac{5}{3}$ into the first equation to get\n\n$$\n{x}_{1}+3(-\\frac{5}{3})+(2)=2\\,⟹\\,{x}_{1}=2+5-2=5.\n$$\n\nTherefore, the solution is ${x}_{1}=5$, ${x}_{2}=-\\frac{5}{3}$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨5,-\\frac{5}{3},2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129457/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e"] :knowledge-point/questions ["q-129457"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-10205"] :question/problem "Solve the system of equations represented by the augmented matrix \n\n$$\n[\\begin{aligned}1 & 1 & 1 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+z=1 \\\\  & y+z=1 \\\\  & z=1\\end{aligned}\n$$\n\nThe third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny+(1)=1\\,⟹\\,y=1-1=0.\n$$\n\nNow, we substitute $z=1$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(1)=1\\,⟹\\,x=1-1=0.\n$$\n\nTherefore, the solution is $x=0$, $y=0$, and $z=1.$ In vector form, the solution can be written as $⟨0,0,1⟩.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-129604/selection/f4c086b47f1e2b19209eeeba7da352f910c8c8d12bedeec2c0d41a33274b11e0" :answer/id #uuid "37cc23ba-84e9-55b6-9892-06cff57be60b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -3 \\\\ -1\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-129604/selection/1bfec6aeb29e120af310560fdb04726d528e0522cfe56f1c299975ef0b3bf9b0" :answer/id #uuid "8ab4c26e-e26e-50d2-8e94-c17917dc2028" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 3 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129604/selection/d6facdc5e1ea8e90be716ca5fe50248fe7a44c0b87a1ef0b0c3dbc7da29c9068" :answer/id #uuid "dcd4b6fb-a44b-522f-8281-d79544ae1873" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-129604/selection/d997f551e7303eb27fd1b4080997d9262084c23fe40eb3064c99036f4d054827" :answer/id #uuid "1a3dec52-39d8-5cb1-bb73-c211a04d7e1e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 3 \\\\ 1\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-129604/selection/f378989867d0205332e6da48e04846b746c6a2ec71888484e13a2797e548c9d5" :answer/id #uuid "97ead942-e9f9-5139-9d4e-ff5269c81db1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ -3 \\\\ -1\\end{aligned}]." :db/ensure [:answer/validate]} {:db/id "q-129604/selection" :answer-field/id #uuid "8ffa725a-deba-5d7a-98bb-4fa0e125ae4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129604/selection/1bfec6aeb29e120af310560fdb04726d528e0522cfe56f1c299975ef0b3bf9b0" :answer-field/choices ["q-129604/selection/f4c086b47f1e2b19209eeeba7da352f910c8c8d12bedeec2c0d41a33274b11e0" "q-129604/selection/1bfec6aeb29e120af310560fdb04726d528e0522cfe56f1c299975ef0b3bf9b0" "q-129604/selection/d6facdc5e1ea8e90be716ca5fe50248fe7a44c0b87a1ef0b0c3dbc7da29c9068" "q-129604/selection/d997f551e7303eb27fd1b4080997d9262084c23fe40eb3064c99036f4d054827" "q-129604/selection/f378989867d0205332e6da48e04846b746c6a2ec71888484e13a2797e548c9d5"] :db/ensure [:answer-field/validate]} {:db/id "q-129604" :question/id #uuid "658b8a0c-c7da-5eec-b48e-0c5df4481268" :question/math-academy-id "q-129604" :question/problem "Solve the system of equations represented by the augmented matrix: \n\n$$\n[\\begin{aligned}4 & 1 & 2 & -3 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & -1 & 1\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & 4x+y+2z=-3 \\\\  & y+3z=0 \\\\  & -z=1\\end{aligned}\n$$\n\nThe third equation states that \n\n$$\n-z=1\\,⟹\\,z=-1.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+3(-1)=0\\,⟹\\,y=3.\n$$\n\nNow, we substitute $z=-1$ and $y=3$ into the first equation to get\n\n$$\n4x+(3)+2(-1)=-3\\,⟹\\,x=\\frac{-3-3+2}{4}=-1.\n$$\n\nTherefore, the solution is $x=-1$, $y=3$, and $z=-1.$ In vector form, the solution can be written as \n$[\\begin{aligned}-1 \\\\ 3 \\\\ -1\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129604/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "52e51c9a-6bce-5ea6-a9fe-febb09f8754d"] :knowledge-point/questions ["q-129604"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129613/selection/dec