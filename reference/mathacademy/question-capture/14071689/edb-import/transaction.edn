frac{1}{3})=2\\,⟹\\,{x}_{1}=2-1-\\frac{1}{3}=\\frac{2}{3}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{2}{3}$, ${x}_{2}=1$, and ${x}_{3}=-\\frac{1}{3}.$ In vector form, the solution can be written as\n$[\\begin{aligned}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129455/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-129455"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10198/selection/bcc1a1c76bb87efa8b9cd1fb73923174d1a5b5d3c65cf36110dc919b3365cf7f" :answer/id #uuid "20fdd5e8-0c68-5e8f-a2e2-d0c30071d9e3" :answer/type :answer.type/math :answer/value "⟨11,3,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-10198/selection/285cac8a32947bf4cada2a9a38cc9ff9c5a0fde0d8bcba6de0cfe4a7bbbe7c3e" :answer/id #uuid "69b3a22a-5c15-5091-82dc-c5e6b98642bb" :answer/type :answer.type/math :answer/value "⟨9,2,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-10198/selection/fac6094a36c6da25a7aa5d7996abe5f9b3e31848e6476bb45c5b45126bfa7731" :answer/id #uuid "b7fd4a74-59cb-5c43-a370-5f85e656f676" :answer/type :answer.type/math :answer/value "⟨11,3,3⟩" :db/ensure [:answer/validate]} {:db/id "q-10198/selection/48dafaba4a9bfae5740e5ce6d84786ead94316376f24eac3a044df8212cb46f6" :answer/id #uuid "a1ae9096-d25e-5cb5-9b03-ce33265a6f76" :answer/type :answer.type/math :answer/value "⟨12,-3,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-10198/selection/6d23a49cf16348e6e51588e2dea9e6a7c6259037680bd236316077b2faf901f0" :answer/id #uuid "d0166eab-0786-56ff-9710-3df80a8ba13c" :answer/type :answer.type/math :answer/value "⟨9,-3,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-10198/selection" :answer-field/id #uuid "c39b8b99-6b9b-567e-ac99-c783d05d4941" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10198/selection/bcc1a1c76bb87efa8b9cd1fb73923174d1a5b5d3c65cf36110dc919b3365cf7f" :answer-field/choices ["q-10198/selection/bcc1a1c76bb87efa8b9cd1fb73923174d1a5b5d3c65cf36110dc919b3365cf7f" "q-10198/selection/285cac8a32947bf4cada2a9a38cc9ff9c5a0fde0d8bcba6de0cfe4a7bbbe7c3e" "q-10198/selection/fac6094a36c6da25a7aa5d7996abe5f9b3e31848e6476bb45c5b45126bfa7731" "q-10198/selection/48dafaba4a9bfae5740e5ce6d84786ead94316376f24eac3a044df8212cb46f6" "q-10198/selection/6d23a49cf16348e6e51588e2dea9e6a7c6259037680bd236316077b2faf901f0"] :db/ensure [:answer-field/validate]} {:db/id "q-10198" :question/id #uuid "8bfbf7d4-d461-5ae8-bd89-a3d95042e1da" :question/math-academy-id "q-10198" :question/problem "Solve the following system of equations:\n    \n\n$$\n{\\begin{aligned} & {x}_{1}-{x}_{2}+3{x}_{3}=9 \\\\  & {x}_{2}-3{x}_{3}=2 \\\\  & {x}_{3}=\\frac{1}{3}\\end{aligned}\n$$" :question/worked-solution "The third equation states that  ${x}_{3}=\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-3(\\frac{1}{3})=2\\,⟹\\,{x}_{2}=2+1=3.\n$$\n\nNow, we substitute ${x}_{3}=\\frac{1}{3}$ and ${x}_{2}=3$ into the first equation to get\n\n$$\n{x}_{1}-(3)+3(\\frac{1}{3})=9\\,⟹\\,{x}_{1}=9+3-1=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=\\frac{1}{3}.$ In vector form, the solution can be written as $⟨11,3,\\frac{1}{3}⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10198/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af"] :knowledge-point/questions ["q-10198"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-20422"] :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}1 & -3 & 4 & 5 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & {x}_{1}-3{x}_{2}+4{x}_{3}=5 \\\\  & {x}_{2}+{x}_{3}=0 \\\\  & {x}_{3}=2\\end{aligned}\n$$\n\nThe third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(2)=0\\,⟹\\,{x}_{2}=-2.\n$$\n\nNow, we substitute ${x}_{3}=2$ and ${x}_{2}=-2$ into the first equation to get\n\n$$\n{x}_{1}-3(-2)+4(2)=5\\,⟹\\,{x}_{1}=5-6-8=-9.\n$$\n\nTherefore, the solution is ${x}_{1}=-9$, ${x}_{2}=-2$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨-9,-2,2⟩.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-20452/selection/d2538dd0aa8d8aedee6e4948106b37fdd2138eba318441930267adc8771cc655" :answer/id #uuid "370853d7-0a1f-5213-919d-7fdfcf5875ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 5 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20452/selection/812e7107be707cd1e98538615744d8928de0a373aa85e414954245bb861b874f" :answer/id #uuid "d912721c-8603-5983-b347-2a8f23f6655f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 4 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20452/selection/a7e1a15fad5f61724c6dbaefd71fd715cb18fa27ca4bc17621ecb04437ef50a1" :answer/id #uuid "24884f2e-0b21-5c63-a1e0-99e5e7e3fc62" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 5 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20452/selection/987d9a4796942b36117e74309227e8e08d3a495af38985b9fe2ec2c76bbd98ca" :answer/id #uuid "45549891-43f8-5c28-8ddb-55a793741bac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20452/selection/961a3d2af574e0af10f9b103e9ecf6d7dc688c4ba46a8c0907436afcdf1c360e" :answer/id #uuid "b91cefaa-269a-5411-82a0-baae9d578f0a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\