[{:db/id "q-96857/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "98c82bb9-67e8-55f7-84a2-dd77c0d1c7e7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-96857/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "fcae665c-3a2c-5949-9c01-e2fa2708a4f3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96857/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "df38f974-972f-57d5-ba47-bee09e2f3bb6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96857/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e49c2824-da01-5e1a-8c72-3504875b08d2" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-96857/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "9898d208-ae8f-5bb4-b448-63eb9326e2e5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-96857/selection" :answer-field/id #uuid "74c9d122-9ade-5428-bec8-0741e4bfd753" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96857/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-96857/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96857/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96857/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-96857/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-96857/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-96857" :question/id #uuid "ebb43161-f95d-5871-a9cc-75d7456e0b50" :question/math-academy-id "q-96857" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(0,-1),(-2,1),$ and $(3,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(1,3)$\n- $(0,-3)$\n- $(2,3)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}0 & -2 & 3 \\\\ -1 & 1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}][\\begin{aligned}0 & -2 & 3 \\\\ -1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 1 & 3 \\\\ -9 & 3 & 9\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,-9),$  $(1,3)$, and $(3,9).$ \n\nSo, the correct answer is \" I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96857/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6"] :knowledge-point/questions ["q-96857"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-21067"] :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & 1 \\\\ 6 & 2\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-1,-1),(0,-1),$ and $(0,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(4,-1)$\n- $(0,0)$\n- $(-4,-8)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-1 & 0 & 0 \\\\ -1 & -1 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & 1 \\\\ 6 & 2\\end{aligned}][\\begin{aligned}-1 & 0 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -1 & 0 \\\\ -8 & -2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,-8),$ $(-1,-2)$, and $(0,0).$\n\nSo, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-147668/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "58ad1e6b-adf3-52cd-aecb-ac30e59feb28" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-147668/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "73c06a27-23a8-5503-bac0-b74613d69742" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-147668/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f35c6757-c1cc-5e95-adc9-7f3b43987bee" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-147668/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "f3aab5aa-276e-5326-bbfe-4b9e1ca11ad8" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-147668/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "cda1164d-4de5-56fe-ab02-1b31eb5243b7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-147668/selection" :answer-field/id #uuid "be65ef3d-5052-5673-a3d9-6e70ca192993" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-147668/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-147668/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-147668/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-147668/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-147668/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-147668/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-147668" :question/id #uuid "88e719bc-e349-5ca0-a13c-a121f56b9351" :question/math-academy-id "q-147668" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -4 \\\\ -4 & 8\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,0)$, $(0,-3)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(12,-24)$\n- $(8,16)$\n- $(2,-4)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 0 & -2 \\\\ 0 & -3 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -4 \\\\ -4 & 8\\end{aligned}][\\begin{aligned}1 & 0 & -2 \\\\ 0 & -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 12 & -8 \\\\ -4 & -24 & 16\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(2,-4)$, $(12,-24)$ and $(-8,16).$ \n\nSo, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-147668/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6"] :knowledge-point/questions ["q-147668"] :db/ensure [:kno