2}}\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta } & =1\\cdot 1=1.\\end{aligned}\n$$" 13194139534887 true] [17592186317545 1000 #edb/ref 17592186317546 13194139534887 true] [17592186317545 1000 #edb/ref 17592186317547 13194139534887 true] [17592186317545 1000 #edb/ref 17592186317548 13194139534887 true] [17592186317545 1000 #edb/ref 17592186317549 13194139534887 true] [17592186317545 1000 #edb/ref 17592186317550 13194139534887 true] [17592186317545 1040 #edb/ref 17592186045450 13194139534887 true] [17592186317545 1041 "selection" 13194139534887 true] [17592186317545 1104 #edb/ref 17592186317548 13194139534887 true] [17592186317545 1110 #uuid "b20bb663-9eed-5948-8df3-b03b23b904f7" 13194139534887 true] [17592186317546 1034 "\\frac{1}{2}" 13194139534887 true] [17592186317546 1103 #edb/ref 17592186045453 13194139534887 true] [17592186317546 1111 #uuid "e5f3ef3b-f2a7-5831-ad69-d73bd2d530cf" 13194139534887 true] [17592186317547 1034 "2" 13194139534887 true] [17592186317547 1103 #edb/ref 17592186045453 13194139534887 true] [17592186317547 1111 #uuid "32ba09f3-6f25-5996-9334-d05dfa3db2a7" 13194139534887 true] [17592186317548 1034 "1" 13194139534887 true] [17592186317548 1103 #edb/ref 17592186045453 13194139534887 true] [17592186317548 1111 #uuid "3924e8e7-6041-5061-ab2b-1afb4b5d761b" 13194139534887 true] [17592186317549 1034 "0" 13194139534887 true] [17592186317549 1103 #edb/ref 17592186045453 13194139534887 true] [17592186317549 1111 #uuid "d49244c3-e3d8-5b30-a8f9-4c854c57370c" 13194139534887 true] [17592186317550 1034 "-1" 13194139534887 true] [17592186317550 1103 #edb/ref 17592186045453 13194139534887 true] [17592186317550 1111 #uuid "79368d3f-2f5c-5e5c-a102-1956aaf64842" 13194139534887 true]] :edb/tempids {"q-105433" 17592186317499 "q-105433/selection" 17592186317500 "q-105433/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" 17592186317501 "q-105433/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" 17592