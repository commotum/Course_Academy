4d800f51c6b26"] :db/ensure [:answer-field/validate]} {:db/id "q-19214" :question/id #uuid "0c47865b-2aaa-5c86-aef6-8fa8e66730a0" :question/math-academy-id "q-19214" :question/problem "Let $p=⟨1,-1,1⟩$ and $q=⟨8,4,2⟩.$ Find the vector projection of $q$ onto $p.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{1\\cdot 8+(-1)\\cdot 4+1\\cdot 2}{{1}^{2}+(-1)^{2}+{1}^{2}}p \\\\  & =\\frac{6}{3}⟨1,-1,1⟩ \\\\  & =⟨2,-2,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19214/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-19214"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126510/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea63e9ad021b9d6c3fce938f23f4" :answer/id #uuid "966f2bc5-40f7-5ca2-9091-b5a8f61da4ee" :answer/type :answer.type/math :answer/value "⟨0,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-126510/selection/b102648baa6e7b65cbe82f351cd716ed6a8a2192342bd98d70c9f01e48f2a1bc" :answer/id #uuid "91e877a6-02ab-552b-97c4-5cccc530272b" :answer/type :answer.type/math :answer/value "⟨2,3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-126510/selection/bbd6e6806a07514b0c63dd17577bc226d2eeda26b20b2b8774a204e294ddcdfa" :answer/id #uuid "6486d0d4-95c3-5c0e-9cc8-b51afa994c06" :answer/type :answer.type/math :answer/value "⟨4,6,2⟩" :db/ensure [:answer/validate]} {:db/id "q-126510/selection/ea9be4026c1c33302351e9c3dc141ce6f340efe45374ea056304b0a308a19a72" :answer/id #uuid "a005d464-b671-5f99-8b50-fc8047d2b2a7" :answer/type :answer.type/math :answer/value "⟨\\frac{2}{3},1,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-126510/selection/363e46478ca976aae4059e69ee2c963e4aefdfb37b532830277ca5d1b1d55580" :answer/id #uuid "b30e07cb-eba6-5843-a651-f696dcdf6894" :answer/type :answer.type/math :answer/value "⟨\\frac{4}{3},2,\\frac{2}{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-126510/selection" :answer-field/id #uuid "ca67510d-990c-560a-ac46-d8bbef224bd6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126510/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea63e9ad021b9d6c3fce938f23f4" :answer-field/choices ["q-126510/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea63e9ad021b9d6c3fce938f23f4" "q-126510/selection/b102648baa6e7b65cbe82f351cd716ed6a8a2192342bd98d70c9f01e48f2a1bc" "q-126510/selection/bbd6e6806a07514b0c63dd17577bc226d2eeda26b20b2b8774a204e294ddcdfa" "q-126510/selection/ea9be4026c1c33302351e9c3dc141ce6f340efe45374ea056304b0a308a19a72" "q-126510/selection/363e46478ca976aae4059e69ee2c963e4aefdfb37b532830277ca5d1b1d55580"] :db/ensure [:answer-field/validate]} {:db/id "q-126510" :question/id #uuid "e3f38b02-e1ac-5e11-bd12-39ce506f87ec" :question/math-academy-id "q-126510" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}]$ and $d=[\\begin{aligned}4 \\\\ 6 \\\\ 2\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 4+0\\cdot 6+(-2)\\cdot 2}{{4}^{2}+{6}^{2}+{2}^{2}}d \\\\  & =\\frac{0}{{4}^{2}+{6}^{2}+{2}^{2}}d \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126510/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-126510"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212459/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "15bc20b7-0ab3-5940-8a4c-8e7abe2d8f0c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-212459/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d2a74b3b-9fc0-58c4-841c-ec75dfea349d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-212459/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "7fdebe6c-0fe3-55bd-9266-df4fc47d13d9" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-212459/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "379ecede-e210-5f7a-bc62-22a7d0cab0b5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-212459/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "600d675d-09af-527c-8a83-fd401f100681" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-212459/selection" :answer-field/id #uuid "d673c1ff-36d0-5131-b76e-f75b0c97830c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-212459/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-212459/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-212459/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-212459/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-212459/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-212459/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-212459" :question/id #uuid "d6371890-9b49-5b67-8b04-902dab4c2c28" :question/math-academy-id "q-212459" :question/problem "Let $a=⟨2,-1,-2⟩$ and $b=⟨x,-4,0⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =2\\cdot x+(-1)\\cdot (-4)+(-2)\\cdot 0 \\\\  & =2x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-212459/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-212459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275232/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "a345d400-f7fa-5cd8-a91e-c847507ee825" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-275232/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "dce7c581-2bbe-5ab1-9e05-696dc1c8b265" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-275232/field-1" :answer-field/id #uuid "9c29c376-c641-5f92-affc-0d4fe084c60e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275232/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-275232/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-275232/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-275232/field-2/954f2b2ecf089f1c43903a74f4575cff67