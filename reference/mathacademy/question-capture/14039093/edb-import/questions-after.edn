#{[{:db/id #edb/ref 17592186301562 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "966f2bc5-40f7-5ca2-9091-b5a8f61da4ee" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186301564} {:answer/id #uuid "b30e07cb-eba6-5843-a651-f696dcdf6894" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{3},2,\\frac{2}{3}⟩" :db/id #edb/ref 17592186301565} {:answer/id #uuid "91e877a6-02ab-552b-97c4-5cccc530272b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,3,1⟩" :db/id #edb/ref 17592186301566} {:answer/id #uuid "6486d0d4-95c3-5c0e-9cc8-b51afa994c06" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,6,2⟩" :db/id #edb/ref 17592186301567} {:answer/id #uuid "a005d464-b671-5f99-8b50-fc8047d2b2a7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{3},1,\\frac{1}{3}⟩" :db/id #edb/ref 17592186301568}] :answer-field/correct {:answer/id #uuid "966f2bc5-40f7-5ca2-9091-b5a8f61da4ee" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186301564} :answer-field/id #uuid "ca67510d-990c-560a-ac46-d8bbef224bd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301563}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e3f38b02-e1ac-5e11-bd12-39ce506f87ec" :question/math-academy-id "q-126510" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}]$ and $d=[\\begin{aligned}4 \\\\ 6 \\\\ 2\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 4+0\\cdot 6+(-2)\\cdot 2}{{4}^{2}+{6}^{2}+{2}^{2}}d \\\\  & =\\frac{0}{{4}^{2}+{6}^{2}+{2}^{2}}d \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301569 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "918bdfe7-188b-5cf1-9e8a-9e473598896c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{6}{\\sqrt{3}},\\frac{6}{\\sqrt{3}},\\frac{6}{\\sqrt{3}}⟩" :db/id #edb/ref 17592186301571} {:answer/id #uuid "906ddc14-6b94-5f91-afa8-e3c97d820894" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-3,-3⟩" :db/id #edb/ref 17592186301572} {:answer/id #uuid "c228beae-8ee9-577c-8751-f973ba19bf90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-2,2⟩" :db/id #edb/ref 17592186301573} {:answer/id #uuid "4308afc8-5573-5d3b-a314-11ff71afc593" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,-6,6⟩" :db/id #edb/ref 17592186301574} {:answer/id #uuid "d5e6dc5f-0d90-5424-a931-924f2d4f6741" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{\\sqrt{3}},-\\frac{1}{\\sqrt{3}},\\frac{1}{\\sqrt{3}}⟩" :db/id #edb/ref 17592186301575}] :answer-field/correct {:answer/id #uuid "c228beae-8ee9-577c-8751-f973ba19bf90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-2,2⟩" :db/id #edb/ref 17592186301573} :answer-field/id #uuid "7d5e379a-53bf-5845-8d31-6fe50fd5491e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301570}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0c47865b-2aaa-5c86-aef6-8fa8e66730a0" :question/math-academy-id "q-19214" :question/problem "Let $p=⟨1,-1,1⟩$ and $q=⟨8,4,2⟩.$ Find the vector projection of $q$ onto $p.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{1\\cdot 8+(-1)\\cdot 4+1\\cdot 2}{{1}^{2}+(-1)^{2}+{1}^{2}}p \\\\  & =\\frac{6}{3}⟨1,-1,1⟩ \\\\  & =⟨2,-2,2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301576 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "600d675d-09af-527c-8a83-fd401f100681" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186301578} {:answer/id #uuid "7fdebe6c-0fe3-55bd-9266-df4fc47d13d9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186301579} {:answer/id #uuid "d2a74b3b-9fc0-58c4-841c-ec75dfea349d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186301580} {:answer/id #uuid "379ecede-e210-5f7a-bc62-22a7d0cab0b5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301581} {:answer/id #uuid "15bc20b7-0ab3-5940-8a4c-8e7abe2d8f0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301582}] :answer-field/correct {:answer/id #uuid "15bc20b7-0ab3-5940-8a4c-8e7abe2d8f0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301582} :answer-field/id #uuid "d673c1ff-36d0-5131-b76e-f75b0c97830c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301577}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d6371890-9b49-5b67-8b04-902dab4c2c28" :question/math-academy-id "q-212459" :question/problem "Let $a=⟨2,-1,-2⟩$ and $b=⟨x,-4,0⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =2\\cdot x+(-1)\\cdot (-4)+(-2)\\cdot 0 \\\\  & =2x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301583 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dce7c581-2bbe-5ab1-9e05-696dc1c8b265" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301585} {:answer/id #uuid "a345d400-f7fa-5cd8-a91e-c847507ee825" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301586}] :answer-field/correct {:answer/id #uuid "a345d400-f7fa-5cd8-a91e-c847507ee825" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301586} :answer-field/id #uuid "9c29c376-c641-5f92-affc-0d4fe084c60e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301584} {:answer-field/choices [{:answer/id #uuid "e07ba3bc-4d7f-574f-a910-6070fb49530e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301588}] :answer-field/correct {:answer/id #uuid "e07ba3bc-4d7f-574f-a910-6070fb49530e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301588} :answer-field/id #uuid "ca8b82f7-91ac-500d-ab70-bb200564be7d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301587} {:answer-field/choices [{:answer/id #uuid "facc5f32-9789-5664-93dd-878f75fd6815" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301590}] :answer-field/correct {:answer/id #uuid "facc5f32-9789-5664-93dd-878f75fd6815" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301590} :answer-field/id #uuid "9f24e2c4-2d35-58bf-b28f-4fb07da7199d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301589}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "40125f41-6010-5e4f-9f6f-cf0dc54cc73a" :question/math-academy-id "q-275232" :question/problem "Let $p=⟨-1,1,1⟩$ and $q=⟨4,8,2⟩.$ Find the vector projection of $q$ onto $p.$\n\n${\\text{proj}}_{p}\\,q=⟨$  \n\n{{field-1}},\n\n{{field-2}},\n\n{{field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{(-1)\\cdot 4+1\\cdot 8+1\\cdot 2}{(-1)^{2}+{1}^{2}+{1}^{2}}p \\\\  & =\\frac{6}{3}⟨-1,1,1⟩ \\\\  & =⟨-2,2,2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301591 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c85083-bc83-528c-8d1f-fc5a50d45b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301593}] :answer-field/correct {:answer/id #uuid "03c85083-bc83-528c-8d1f-fc5a50d45b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301593} :answer-field/id #uuid "322b7425-d3d2-5a70-a37c-99308ff6f056" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301592} {:answer-field/choices [{:answer/id #uuid "1ac83aed-e236-5302-b09e-602a52e63fb6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301595}] :answer-field/correct {:answer/id #uuid "1ac83aed-e236-5302-b09e-602a52e63fb6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301595} :answer-field/id #uuid "9d74ba26-1535-5eb1-b612-b9790af2f93e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301594} {:answer-field/choices [{:answer/id #uuid "d4e95c59-ba81-5759-89e8-ec38e53dc938" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301597}] :answer-field/correct {:answer/id #uuid "d4e95c59-ba81-5759-89e8-ec38e53dc938" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301597} :answer-field/id #uuid "0d2bc418-dc00-5ac7-b1bf-135141d18285" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301596}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4cadee86-2a70-5613-ad3c-bf59bc4d8e2b" :question/math-academy-id "q-317652" :question/problem "Let $a=⟨5,-3,4⟩$ and $b=⟨1,2,-2⟩.$ Find the vector projection of $a$ onto $b.$\n\n${\\text{proj}}_{b}\\,a=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}\\,b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}\\,b \\\\  & =\\frac{5\\cdot 1+(-3)\\cdot 2+4\\cdot (-2)}{{1}^{2}+{2}^{2}+(-2)^{2}}\\,b \\\\  & =\\frac{5-6-8}{1+4+4}\\,⟨1,2,-2⟩ \\\\  & =\\frac{-9}{9}\\,⟨1,2,-2⟩ \\\\  & =(-1)\\,⟨1,2,-2⟩ \\\\  & =⟨-1,-2,2⟩.\\end{aligned}\n$$"}]}
