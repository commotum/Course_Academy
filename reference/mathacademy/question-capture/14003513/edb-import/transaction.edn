8f075595574d" "q-32139/selection/bc149dd7283c3114c48861730d1e7535d15bfb330a565f534d2c63af3b4040f4" "q-32139/selection/3f2c07daa5ff526ea5f0bd8c34ccaab15c7f09b10dc51c0aeac25ff9d095e111"] :db/ensure [:answer-field/validate]} {:db/id "q-32139" :question/id #uuid "34c426c5-7657-5020-93fd-26e20c441212" :question/math-academy-id "q-32139" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}2x+6y=46 \\\\ 8x+y=-23\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}46 \\\\ -23\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}] \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32139/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-32139"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102802/selection/b5385f9961107dfe1f5fc28742b446c0adc7c1b21f1dcea7a3b5d5de332409a5" :answer/id #uuid "3ce4fa79-c313-53b3-ab65-6034ed4240f1" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}[\\begin{aligned}4 & 2 \\\\ -5 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102802/selection/9647aeaa9234db6ef0dac372eec75979ca432b3cac69dc157ffb50de6d43cecb" :answer/id #uuid "f9912763-e233-572c-9945-18af489f6217" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ 5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102802/selection/5344db66445417db02c3b2a6de3d48d3729f931da7434d72c7e3ccef4149f602" :answer/id #uuid "c759e328-d237-5131-a459-dd2ac09738a4" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}[\\begin{aligned}0 & -2 \\\\ 5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102802/selection/01f46d899605cb4050fbea03daa0d06c7b09a25e4c70481a312790d5d67e4f65" :answer/id #uuid "f67ffc2f-680d-5cc6-a154-58e08b1bea4a" :answer/type :answer.type/math :answer/value "x=\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102802/selection/3a04686699cecfdf797a18edb2498f08cd1071fba3614abc7e5b566cbd9a9859" :answer/id #uuid "a77a25e4-1532-5fe5-96f8-d52197463720" :answer/type :answer.type/math :answer/value "x=[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-102802/selection" :answer-field/id #uuid "1fe145e9-45ba-50d5-9dc7-6044f32ba04b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102802/selection/01f46d899605cb4050fbea03daa0d06c7b09a25e4c70481a312790d5d67e4f65" :answer-field/choices ["q-102802/selection/b5385f9961107dfe1f5fc28742b446c0adc7c1b21f1dcea7a3b5d5de332409a5" "q-102802/selection/9647aeaa9234db6ef0dac372eec75979ca432b3cac69dc157ffb50de6d43cecb" "q-102802/selection/5344db66445417db02c3b2a6de3d48d3729f931da7434d72c7e3ccef4149f602" "q-102802/selection/01f46d899605cb4050fbea03daa0d06c7b09a25e4c70481a312790d5d67e4f65" "q-102802/selection/3a04686699cecfdf797a18edb2498f08cd1071fba3614abc7e5b566cbd9a9859"] :db/ensure [:answer-field/validate]} {:db/id "q-102802" :question/id #uuid "97e41006-c01d-55c0-bdd6-ad1a3b1505cf" :question/math-academy-id "q-102802" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}4x-2y=4 \\\\ 6=5x\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}4x-2y=4 \\\\ 5x=6.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ 6\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}4 & -2 \\\\ 5 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 0-5\\cdot (-2)}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{10}[\\begin{aligned}0 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}4 \\\\ 6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102802/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952"] :knowledge-point/questions ["q-102802"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320805/field-1/a32a0f7e64ab5ec8f15b0f308e5fdf0a8e3a7cac0bfab30d64cde5f86a67acae" :answer/id #uuid "5121d015-f1d8-52bf-9d65-0cea17480a9c" :answer/type :answer.type/math :answer/value "-\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "q-320805/field-1/830a08a17a3bc68a8e849c8d7e7a7e21cd8b84724f1767acc4bccbeebb91b0c8" :answer/id #uuid "01681ac2-e161-567b-8a45-b934df1d456b" :answer/t