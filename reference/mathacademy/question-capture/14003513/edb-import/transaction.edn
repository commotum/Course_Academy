3bdd2bae4daa121c4c7dc7a3715fef6ae72e835" "q-12285/selection/eb0170c7f67315af395000cd7b56b2aa6a501ecca9f440014c3d08d2eae34429" "q-12285/selection/6fab25feb06a4fe8453ca840405725e05ef980f95537a7d5e5038d7d4f1bd3c0" "q-12285/selection/36a6910d1ad8a308632a451f5a70e069e3239a268f6f001787fa8a675331b0b6" "q-12285/selection/9f497105ec4fc1949b481f086bd7b8cd23be7465c218edccd12c62f74cf81986"] :db/ensure [:answer-field/validate]} {:db/id "q-12285" :question/id #uuid "227f5432-14f9-5618-8402-19510df62a5a" :question/math-academy-id "q-12285" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}6x-4y=2 \\\\ -x+y=-1\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}6 & -4 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}6 & -4 \\\\ -1 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 1-(-4)\\cdot (-1)}[\\begin{aligned}1 & 4 \\\\ 1 & 6\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 4 \\\\ 1 & 6\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & 4 \\\\ 1 & 6\\end{aligned}][\\begin{aligned}2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12285/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd"] :knowledge-point/questions ["q-12285"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32139/selection/2c193e74061c376bb1df3d0710e9c928993e3f2c4367b20f13b68f0ce2bd9210" :answer/id #uuid "50336411-1fa5-5ede-962e-0f9067f0173b" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{50}[\\