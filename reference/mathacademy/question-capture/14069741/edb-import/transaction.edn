tion/id #uuid "0bae377c-104c-53d6-9d87-6e941d21af86" :question/math-academy-id "q-130029" :question/problem "Given $X∼\\text{Geom}(\\frac{3}{4}),$ compute $P(X=3).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{3}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(\\frac{1}{4})}^{x-1}(\\frac{3}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & ={(\\frac{1}{4})}^{2}(\\frac{3}{4}) \\\\  & =\\frac{3}{64}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130029/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d83ab99-0e27-5989-9a57-6b4a192fa4a4"] :knowledge-point/questions ["q-130029"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97127/selection/64231ef49a1e7bdbe6ef0c55088039242dea0b19dac27cbc79027013f7996514" :answer/id #uuid "9b0b8397-d318-5d13-9abf-3f9f5b9d3358" :answer/type :answer.type/math :answer/value "0.0466" :db/ensure [:answer/validate]} {:db/id "q-97127/selection/e005894627d6c3bf7f17de73eb8fa8c8e09dc5dfc8cca269b807acec3611b29f" :answer/id #uuid "18a92c98-fdf9-53d8-b8a4-985ae0645a4e" :answer/type :answer.type/math :answer/value "0.0655" :db/ensure [:answer/validate]} {:db/id "q-97127/selection/9197e58a12d99f78d8396ce5e0b33f3f314db38786368e19f921fb355d4fd2d6" :answer/id #uuid "ddb977c2-78d5-57d8-83a1-a3b060c76f78" :answer/type :answer.type/math :answer/value "0.0566" :db/ensure [:answer/validate]} {:db/id "q-97127/selection/a787a1f5c565098f695e20895c449fd76d4a5e05b4e505e3e73bc40e9365238d" :answer/id #uuid "7bddba16-13a4-5eae-bf41-7af18cd30b76" :answer/type :answer.type/math :answer/value "0.0656" :db/ensure [:answer/validate]} {:db/id "q-97127/selection/892498be10358f456163906e002fdf7a32