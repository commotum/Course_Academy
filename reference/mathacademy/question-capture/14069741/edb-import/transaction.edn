gned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "120381af-c472-5894-8b19-da2ab61d3a7e"] :knowledge-point/questions ["q-130191"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332603/field-1/142771c28ebc3b942b1bdfd70c456baec0d8977c9b2eb3123fdce7b19c6e7c73" :answer/id #uuid "8830c554-6fd3-5a55-9442-1b276588a792" :answer/type :answer.type/math :answer/value "0.9976" :db/ensure [:answer/validate]} {:db/id "q-332603/field-1/615c050c713ca426ca6c1a51cb825fca9380a82faf315534fad2b950dc389073" :answer/id #uuid "eef27090-7ad2-5480-8b1c-307a50df2d12" :answer/type :answer.type/math :answer/value "0.9919" :db/ensure [:answer/validate]} {:db/id "q-332603/field-1" :answer-field/id #uuid "4a3c042f-f1b9-5c1b-9727-30615fbe3223" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332603/field-1/142771c28ebc3b942b1bdfd70c456baec0d8977c9b2eb3123fdce7b19c6e7c73" :answer-field/choices ["q-332603/field-1/142771c28ebc3b942b1bdfd70c456baec0d8977c9b2eb3123fdce7b19c6e7c73" "q-332603/field-1/615c050c713ca426ca6c1a51cb825fca9380a82faf315534fad2b950dc389073"] :db/ensure [:answer-field/validate]} {:db/id "q-332603" :question/id #uuid "534ec1b3-606d-503b-b972-6d5a1d2b6ade" :question/math-academy-id "q-332603" :question/problem "Given $X∼\\text{Geom}(0.7),$ compute the value of $P(X\\le 5).$ Round your answer to $4$ decimal places.\n\n$P(X\\le 5)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}(0.3)^{x-1}(0.7), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 5) & =P(X\\in {1,2,3,4,5}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4)+P(X=5) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & =(0.3)^{0}(0.7)+(0.3)^{1}(0.7)+(0.3)^{2}(0.7)+(0.3)^{3}(0.7)+(0.3)^{4}(0.7) \\\\  & ≈0.9976.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332603/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "120381af-c472-5894-8b19-da2ab61d3a7e"] :knowledge-point/questions ["q-332603"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130193/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" :answer/id #uuid "bfab11ad-5456-59bb-bdc7-a259b206e8b3" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]} {:db/id "q-130193/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "ec88fde1-e35b-59ff-94db-02c329742455" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-130193/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer/id #uuid "523a0ee6-2136-5dba-96c0-828c84a6eb37" :answer/type :answer.type/math :answer/value "\\frac{3}{16}" :db/ensure [:answer/validate]} {:db/id "q-130193/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "d7d9e326-6cc8-5599-91a3-7a4225545c9f" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-130193/selection/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9" :answer/id #uuid "e3d56ec8-d2bd-5917-a433-6931a8394a9a" :answer/type :answer.type/math :answer/value "\\frac{7}{16}" :db/ensure [:answer/validate]} {:db/id "q-130193/selection" :answer-field/id #uuid "e9b079b3-9d6c-54e0-a0b5-f88981ff2ea2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130193/selection/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9" :answer-field/choices ["q-130193/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" "q-130193/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-130193/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" "q-130193/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" "q-130193/selection/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9"] :db/ensure [:answer-field/validate]} {:db/id "q-130193" :question/id #uuid "14e83071-7c0b-501d-9d30-b10aeda26879" :question/math-academy-id "q-130193" :question/problem "Given $X∼\\text{Geom}(\\frac{1}{4}),$ compute $P(X\\le 2).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(\\frac{3}{4})}^{x-1}(\\frac{1}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in {1,2}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{3}{4})}^{0}(\\frac{1}{4})+{(\\frac{3}{4})}^{1}(\\frac{1}{4}) \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130193/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "120381af-c472-5894-8b19-da2ab61d3a7e"] :knowledge-point/questions ["q-130193"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97146/selection/f19a5e6df9a20723941acd94d5ee99453db0c3c4057ef6157f572095a616bfdf" :answer/id #uuid "a37fd2cd-9664-5bc9-94b7-5d6311742a20" :answer/type :answer.type/math :answer/value "0.9203" :db/ensure [:answer/validate]} {:db/id "q-97146/selection/e0698017ef457e125def951ba953088c50554357b3e2fed93c10bca95b63c178" :answer/id #uuid "cb98bcf4-b120-5325-8871-785f916ecf9d" :answer/type :answer.type/math :answer/value "0.9832" :db/ensu