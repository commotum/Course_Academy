6/selection/3f5965185c5730076989b32aa72e37e64671f0872338384ae60d4dbda1497e45" "q-130196/selection/d874acf3ce73b0cc522f333e55a41838d32ba2b26fdb2006bc54b62d10c64660"] :db/ensure [:answer-field/validate]} {:db/id "q-130196" :question/id #uuid "a68dcc60-835e-570e-881a-d98a20b12368" :question/math-academy-id "q-130196" :question/problem "Given $X∼\\text{Geom}(0.15),$ compute $P(X<3).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.15),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.85)}^{x-1}(0.15), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in {1,2}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(0.85)}^{0}(0.15)+{(0.85)}^{1}(0.15) \\\\  & =0.2775.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130196/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "120381af-c472-5894-8b19-da2ab61d3a7e"] :knowledge-point/questions ["q-130196"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130191/selection/2c78c2af77bc46a00d797960cbf99b1e369104510b49e73af292d5994ded741f" :answer/id #uuid "a44735c9-21f2-5c7c-bce8-12c04e7c9dd9" :answer/type :answer.type/math :answer/value "0.7782" :db/ensure [:answer/validate]} {:db/id "q-130191/selection/a78f8442bcc103567191802cb155435b3f5b594073cc6e73f2e488e2374f0680" :answer/id #uuid "d1aa1f0b-4e46-5acf-9145-1f57770b6925" :answer/type :answer.type/math :answer/value "0.8358" :db/ensure [:answer/validate]} {:db/id "q-130191/selection/daae98a5f584b2c8d80d80feff47939d9d8ed856ca701295eb66b75553c89dfc" :answer/id #uuid "7e5b6315-fd0b-59c3-829f-d1d51ddcdaca" :answer/type :answer.type/math :answer/value "0.6304" :db/ensure [:answer/validate]} {:db/id "q-130191/selection/9271e9cf94a4e559df