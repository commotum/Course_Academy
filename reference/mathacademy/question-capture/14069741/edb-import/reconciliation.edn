\\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=5) & =f(5) \\\\  & ={(0.6)}^{4}(0.4) \\\\  & ≈0.0518.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130031" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-130031" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130031" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.0154"] ["math" "0.0311"] ["math" "0.0518"] ["math" "0.0778"] ["math" "0.1296"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130031" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.0518"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332367" "field" nil "attribute" "question/problem" "value" "Given $X∼\\text{Geom}(\\frac{2}{7}),$ compute $P(X=4).$  Round your final answer to $4$ decimal places.\n\n$P(X=4)≈$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332367" "field" nil "attribute" "question/worked-solution" "value" "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{2}{7}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(\\frac{5}{7})}^{x-1}(\\frac{2}{7}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=4) & =f(4) \\\\  & ={(\\frac{5}{7})}^{3}(\\frac{2}{7}) \\\\  & ≈0.1041.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332367" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-332367" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332367" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.1041"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130196" "field" nil "attribute" "question/problem" "value" "Given $X∼\\text{Geom}(0.15),$ compute $P(X<3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130196" "field" nil "attribute" "question/worked-solution" "value" "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.15),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.85)}^{x-1}(0.15), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in {1,2}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(0.85)}^{0}(0.15)+{(0.85)}^{1}(0.15) \\\\  & =0.2775.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130196" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-130196" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130196" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.1084"] ["math" "0.1275"] ["math" "0.2584"] ["math" "0.2775"] ["math" "0.9584"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130196" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.2775"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130191" "field" nil "attribute" "question/problem" "value" "Given $X∼\\text{Geom}(0.4),$ compute $P(X\\le 4).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130191" "field" nil "attribute" "question/worked-solution" "value" "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.4),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.6)}^{x-1}(0.4), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in {1,2,3,4}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(0.6)}^{0}(0.4)+{(0.6)}^{1}(0.4)+{(0.6)}^{2}(0.4)+{(0.6)}^{3}(0.4) \\\\  & =0.8704.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130191" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-130191" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130191" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.4704"] ["math" "0.6304"] ["math" "0.7782"] ["math" "0.8358"] ["math" "0.8704"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130191" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.8704"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332603" "field" nil "attribute" "question/problem" "value" "Given $X∼\\text{Geom}(0.7),$ compute the value of $P(X\\le 5).$ Round your answer to $4$ decimal places.\n\n$P(X\\le 5)≈$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332603" "field" nil "attribute" "question/worked-solution" "value" "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}(0.3)^{x-1}(0.7), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 5) & =P(X\\in {1,2,3,4,5}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4)+P(X=5) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & =(0.3)^{0}(0.7)+(0.3)^{1}(0.7)+(0.3)^{2}(0.7)+(0.3)^{3}(0.7)+(0.3)^{4}(0.7) \\\\  & ≈0.9976.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332603" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-332603" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-332603" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.9976"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130193" "field" nil "attribute" "question/problem" "value" "Given $X∼\\text{Geom}(\\frac{1}{4}),$ compute $P(X\\le 2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130193" "field" nil "attribute" "question/worked-solution" "value" "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{1}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(\\frac{3}{4})}^{x-1}(\\frac{1}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in {1,2}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{3}{4})}^{0}(\\frac{1}{4})+{(\\frac{3}{4})}^{1}(\\frac{1}{4}) \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130193" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/activity-metadata.json" "file_sha256" "8dede424ed142129a061e192b20063344796d4df33f30ea6b3676f94aad24e1f"} {"question" "q-130193" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130193" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{16}"] ["math" "\\frac{1}{4}"] ["math" "\\frac{3}{16}"] ["math" "\\frac{3}{8}"] ["math" "\\frac{7}{16}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069741/state.json" "file_sha256" "d2232788d5ae006e657883bf12b2c7ebbd9593e036ab0ec22393b665c0b735ac"} {"question" "q-130193" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{7}{16}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-captu