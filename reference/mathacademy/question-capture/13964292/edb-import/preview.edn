d}4 \\\\ 1 \\\\ 3\\end{aligned}].$ Round your answer to $2$ decimal places." 13194139533962 true] [17592186269059 1113 #uuid "c5453ef5-4b15-5cbd-af32-541aa54e44cc" 13194139533962 true] [17592186269059 1145 "Rearranging the dot product formula, we have: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+4\\cdot 1+2\\cdot 3}{\\sqrt{(-1)^{2}+{4}^{2}+{2}^{2}}\\sqrt{{4}^{2}+{1}^{2}+{3}^{2}}} \\\\  & =\\frac{6}{\\sqrt{21}\\cdot \\sqrt{26}} \\\\  & =\\frac{6}{\\sqrt{546}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{6}{\\sqrt{546}})≈{75.12}^{∘}.\n$$" 13194139533962 true] [17592186269060 1000 #edb/ref 17592186269061 13194139533962 true] [17592186269060 1000 #edb/ref 17592186269062 13194139533962 true] [17592186269060 1000 #edb/ref 17592186269063 13194139533962 true] [17592186269060 1000 #edb/ref 17592186269064 13194139533962 true] [17592186269060 1000 #edb/ref 17592186269065 13194139533962 true] [17592186269060 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269060 1041 "selection" 13194139533962 true] [17592186269060 1104 #edb/ref 17592186269065 13194139533962 true] [17592186269060 1110 #uuid "7d44a01f-eb22-5eb0-9f4c-4dafddb5fdf0" 13194139533962 true] [17592186269061 1034 "{84.37}^{∘}" 13194139533962 true] [17592186269061 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269061 1111 #uuid "ea9de93e-d608-510c-9830-15000067a76a" 13194139533962 true] [17592186269062 1034 "{71.25}^{∘}" 13194139533962 true] [17592186269062 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269062 1111 #uuid "82c97997-bef6-5b00-9dda-e6c2385e1de2" 13194139533962 true] [17592186269063 1034 "{79.41}^{∘}" 13194139533962 true] [17592186269063 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269063 1111 #uuid "7e22e2b5-f91f-5fc6-879b-ea7b9daca6f3" 13194139533962 true] [17592186269064 1034 "{69.56}^{∘}" 13194139533962 true] [17592186269064 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269064 1111 #uuid "0a53b0c8-688c-5914-81ce-28f2f2bdbe3a" 13194139533962 true] [17592186269065 1034 "{75.12}^{∘}" 13194139533962 true] [17592186269065 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269065 1111 #uuid "beaf3c5d-a0ca-5e73-817e-ba012989875d" 13194139533962 true] [17592186269066 1017 #edb/ref 17592186269067 13194139533962 true] [17592186269066 1089 "q-101510" 13194139533962 true] [17592186269066 1091 #edb/ref 17592186045465 13194139533962 true] [17592186269066 1100 "Find $∠QPR$ given the points $P(-4,3,1)$, $Q(-1,2,0)$, and $R(-10,5,3).$" 13194139533962 true] [17592186269066 1113 #uuid "af00a80e-1320-5335-a947-5ce3ede8cf57" 13194139533962 true] [17592186269066 1145 "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨-4,3,1⟩,\\,q=⟨-1,2,0⟩,\\,r=⟨-10,5,3⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨-1,2,0⟩-⟨-4,3,1⟩ \\\\  & =⟨3,-1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨-10,5,3⟩-⟨-4,3,1⟩ \\\\  & =⟨-6,2,2⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{3\\cdot (-6)+(-1)\\cdot 2+(-1)\\cdot 2}{\\sqrt{{3}^{2}+(-1)^{2}+(-1)^{2}}\\sqrt{(-6)^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{-22}{\\sqrt{11}\\cdot \\sqrt{44}} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-1)={180}^{∘}.\n$$" 13194139533962 true] [17592186269067 1000 #edb/ref 17592186269068 13194139533962 true] [17592186269067 1000 #edb/ref 17592186269069 13194139533962 true] [17592186269067 1000 #edb/ref 17592186269070 13194139533962 true] [17592186269067 1000 #edb/ref 17592186269071 13194139533962 true] [17592186269067 1000 #edb/ref 17592186269072 13194139533962 true] [17592186269067 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269067 1041 "selection" 13194139533962 true] [17592186269067 1104 #edb/ref 17592186269069 13194139533962 true] [17592186269067 1110 #uuid "fdaea567-3b0b-54de-9b16-a108031e4eff" 13194139533962 true] [17592186269068 1034 "{90}^{∘}" 13194139533962 true] [17592186269068 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269068 1111 #uuid "27bcfe70-6989-5359-9ab8-99a8be1e27c9" 13194139533962 true] [17592186269069 1034 "{180}^{∘}" 13194139533962 true] [17592186269069 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269069 1111 #uuid "d9fd197d-e501-5e43-8c1c-2232a6ef539c" 13194139533962 true] [17592186269070 1034 "{0}^{∘}" 13194139533962 true] [17592186269070 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269070 1111 #uuid "b8f831b4-cf64-570c-b2d2-906e374febed" 13194139533962 true] [17592186269071 1034 "{45}^{∘}" 13194139533962 true] [17592186269071 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269071 1111 #uuid "1f9ac76d-964b-5482-9d58-9e89c6296713" 13194139533962 true] [17592186269072 1034 "{120}^{∘}" 13194139533962 true] [17592186269072 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269072 1111 #uuid "7cf1043e-f893-5baa-9db6-4c2fb8c3639b" 13194139533962 true] [17592186269073 1017 #edb/ref 17592186269074 13194139533962 true] [17592186269073 1089 "q-101511" 13194139533962 true] [17592186269073 1091 #edb/ref 17592186045465 13194139533962 true] [17592186269073 1100 "Find $∠BAC$ given the points $A(2,-1,1)$, $B(3,1,-2)$, and $C(-1,1,1).$ Round your answer to the nearest degree." 13194139533962 true] [17592186269073 1113 #uuid "16a09fd3-be95-51b4-b0ac-0c24039ae9ee" 13194139533962 true] [17592186269073 1145 "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$" 13194139533962 true] [17592186269074 1000 #edb/ref 17592186269075 13194139533962 true] [17592186269074 1000 #edb/ref 17592186269076 13194139533962 true] [17592186269074 1000 #edb/ref 17592186269077 13194139533962 true] [17592186269074 1000 #edb/ref 17592186269078 13194139533962 true] [17592186269074 1000 #edb/ref 17592186269079 13194139533962 true] [17592186269074 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269074 1041 "selection" 13194139533962 true] [17592186269074 1104 #edb/ref 17592186269077 13194139533962 true] [17592186269074 1110 #uuid "4237779a-fb1d-5aae-9935-ca22c819fe5c" 13194139533962 true] [17592186269075 1034 "{79}^{∘}" 13194139533962 true] [17592186269075 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269075 1111 #uuid "eb1e08c5-8191-51cb-828c-4e1bf4d18edb" 13194139533962 true] [17592186269076 1034 "{77}^{∘}" 13194139533962 true] [17592186269076 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269076 1111 #uuid "c48d61db-8a7b-58a9-baa3-b45f0e2b2e24" 13194139533962 true] [17592186269077 1034 "{86}^{∘}" 13194139533962 true] [17592186269077 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269077 1111 #uuid "6fe43b6a-8e20-5aa9-b47c-1e0b409544b8" 13194139533962 true] [17592186269078 1034 "{91}^{∘}" 13194139533962 true] [17592186269078 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269078 1111 #uuid "a8481d0e-1847-5899-a263-24206ff622f8" 13194139533962 true] [17592186269079 1034 "{81}^{∘}" 13194139533962 true] [17592186269079 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269079 1111 #uuid "f68369eb-d5b2-597a-8ad3-4e02ef54893c" 13194139533962 true] [17592186269080 1017 #edb/ref 17592186269081 13194139533962 true] [17592186269080 1089 "q-101514" 13194139533962 true] [17592186269080 1091 #edb/ref 17592186045465 13194139533962 true] [17592186269080 1100 "Given that $a\\cdot b=-10$, find the angle between $a=⟨-4t,3t⟩$ and $b=⟨2,1⟩.$ Round your answer to $1$ decimal place." 13194139533962 true] [17592186269080 1113 #uuid "852d0fcb-212d-5f7f-bb3f-afcaa190e7c3" 13194139533962 true] [17592186269080 1145 "First, since $a\\cdot b=-10$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-10 \\\\ (-4t)\\cdot 2+3t\\cdot 1 & =-10 \\\\ -8t+3t & =-10 \\\\ -5t & =-10 \\\\ t & =2\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a & =⟨-4(2),\\,3(2)⟩ \\\\  & =⟨-8,6⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $a$ and $b$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-10}{\\sqrt{(-8)^{2}+{6}^{2}}\\sqrt{{2}^{2}+{1}^{2}}} \\\\  & =-\\frac{10}{10\\cdot \\sqrt{5}} \\\\  & =-\\frac{1}{\\sqrt{5}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{1}{\\sqrt{5}})≈{116.6}^{∘}.\n$$" 13194139533962 true] [17592186269081 1000 #edb/ref 17592186269082 13194139533962 true] [17592186269081 1000 #edb/ref 17592186269083 13194139533962 true] [17592186269081 1000 #edb/ref 17592186269084 13194139533962 true] [17592186269081 1000 #edb/ref 17592186269085 13194139533962 true] [17592186269081 1000 #edb/ref 17592186269086 13194139533962 true] [17592186269081 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269081 1041 "selection" 13194139533962 true] [17592186269081 1104 #edb/ref 17592186269082 13194139533962 true] [17592186269081 1110 #uuid "f467919b-d9c3-556d-b9c6-eb60fabcc3ed" 13194139533962 true] [17592186269082 1034 "{116.6}^{∘}" 13194139533962 true] [17592186269082 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269082 1111 #uuid "28b8bdbb-40f0-5e9c-9af6-75ad034239f9" 13194139533962 true] [17592186269083 1034 "{111.1}^{∘}" 13194139533962 true] [17592186269083 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269083 1111 #uuid "8c46e53c-d1ff-5dc9-ad5b-7d8ca4d94a1a" 13194139533962 true] [17592186269084 1034 "{122.3}^{∘}" 13194139533962 true] [17592186269084 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269084 1111 #uuid "23bbb5d2-e5e3-5cee-9ce1-e977f27b0c84" 13194139533962 true] [17592186269085 1034 "{113.8}^{∘}" 13194139533962 true] [17592186269085 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269085 1111 #uuid "047be692-7ec1-5921-9e3e-a096d5ab0960" 13194139533962 true] [17592186269086 1034 "{120.9}^{∘}" 13194139533962 true] [17592186269086 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269086 1111 #uuid "00c34ec0-c0f2-5eaa-bd8f-92c1fa6ac6de" 13194139533962 true] [17592186269087 1017 #edb/ref 17592186269088 13194139533962 true] [17592186269087 1089 "q-101520" 13194139533962 true] [17592186269087 1091 #edb/ref 17592186045464 13194139533962 true] [17592186269087 1100 "Consider the points $D(t,5,3)$, $E({t}^{2},2,t)$ and $F(t+3,{t}^{2},1).$ Find $∠EDF$ given that $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=6.$ Round your answer to $2$ decimal places." 13194139533962 true] [17592186269087 1113 #uuid "8fc7cf1b-c116-59a4-83f2-94ca1412ae63" 13194139533962 true] [17592186269087 1145 "Note that the position vectors of the points $D$, $E$, $F$ are\n\n$$\n\\begin{aligned}d=⟨t,\\,5,\\,3⟩,\\,e=⟨{t}^{2},\\,2,\\,t⟩,\\,f=⟨t+3,\\,{t}^{2},\\,1⟩.\\end{aligned}\n$$\n\nThe triangle $△DEF$ is shown (schematically) in the diagram below, where we denote $∠EDF=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/c9cfb3e84e6f76d243125f2a09246b2a1300a0134e71359bb2b528082f064f93.png)\n\nFirst, we find the components of $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =⟨{t}^{2},\\,2,\\,t⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨{t}^{2}-t,\\,-3,\\,t-3⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =⟨t+3,\\,{t}^{2},\\,1⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨3,\\,{t}^{2}-5,\\,-2⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=6$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF} & =6 \\\\ ({t}^{2}-t)\\cdot 3+(-3)\\cdot ({t}^{2}-5)+(t-3)\\cdot (-2) & =6 \\\\ 3{t}^{2}-3t-3{t}^{2}+15-2t+6 & =6 \\\\ -5t+21 & =6 \\\\ -5t & =-15 \\\\ t & =3\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨{3}^{2}-3,-3,3-3⟩ \\\\  & =⟨6,-3,0⟩, \\\\ \\overset{\\to }{DF} & =⟨3,{3}^{2}-5,-2⟩ \\\\  & =⟨3,4,-2⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}}{|\\overset{\\to }{DE}||\\overset{\\to }{DF}|} \\\\  & =\\frac{6}{\\sqrt{{6}^{2}+(-3)^{2}+{0}^{2}}\\sqrt{{3}^{2}+{4}^{2}+(-2)^{2}}} \\\\  & =\\frac{6}{3\\sqrt{5}\\cdot \\sqrt{29}} \\\\  & =\\frac{2}{\\sqrt{145}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{145}})≈{80.44}^{∘}.\n$$" 13194139533962 true] [17592186269088 1000 #edb/ref 17592186269089 13194139533962 true] [17592186269088 1000 #edb/ref 17592186269090 13194139533962 true] [17592186269088 1000 #edb/ref 17592186269091 13194139533962 true] [17592186269088 1000 #edb/ref 17592186269092 13194139533962 true] [17592186269088 1000 #edb/ref 17592186269093 13194139533962 true] [17592186269088 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269088 1041 "selection" 13194139533962 true] [17592186269088 1104 #edb/ref 17592186269093 13194139533962 true] [17592186269088 1110 #uuid "69c601c3-8547-5f8b-8af3-b0698702489b" 13194139533962 true] [17592186269089 1034 "{75.22}^{∘}" 13194139533962 true] [17592186269089 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269089 1111 #uuid "33d889d7-3053-5698-b65c-fe5ae9aa07f7" 13194139533962 true] [17592186269090 1034 "{78.55}^{∘}" 13194139533962 true] [17592186269090 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269090 1111 #uuid "bf85c120-7483-5553-bdcd-a44069470789" 13194139533962 true] [17592186269091 1034 "{70.99}^{∘}" 13194139533962 true] [17592186269091 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269091 1111 #uuid "fb6a7436-5d40-5ead-afe9-8fc3f33b83ca" 13194139533962 true] [17592186269092 1034 "{85.33}^{∘}" 13194139533962 true] [17592186269092 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269092 1111 #uuid "08336714-fd00-56fc-9883-ef766d26fd89" 13194139533962 true] [17592186269093 1034 "{80.44}^{∘}" 13194139533962 true] [17592186269093 1103 #edb/ref 17592186045453 13194139533962 true