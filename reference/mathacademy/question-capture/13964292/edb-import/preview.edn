heta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{0}^{2}+{2}^{2}}\\sqrt{{2}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{4}{\\sqrt{8}\\cdot \\sqrt{13}} \\\\  & =\\frac{4}{2\\sqrt{26}} \\\\  & =\\frac{2}{\\sqrt{26}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{26}})≈{67}^{∘}.\n$$" 13194139533962 true] [17592186269095 1000 #edb/ref 17592186269096 13194139533962 true] [17592186269095 1000 #edb/ref 17592186269097 13194139533962 true] [17592186269095 1000 #edb/ref 17592186269098 13194139533962 true] [17592186269095 1000 #edb/ref 17592186269099 13194139533962 true] [17592186269095 1000 #edb/ref 17592186269100 13194139533962 true] [17592186269095 1040 #edb/ref 17592186045450 13194139533962 true] [17592186269095 1041 "selection" 13194139533962 true] [17592186269095 1104 #edb/ref 17592186269097 13194139533962 true] [17592186269095 1110 #uuid "3ae427d9-2381-531f-87a7-c13fc1fb292e" 13194139533962 true] [17592186269096 1034 "{65}^{∘}" 13194139533962 true] [17592186269096 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269096 1111 #uuid "7d53a02b-b33e-51dd-8ab2-e9af5a421db7" 13194139533962 true] [17592186269097 1034 "{67}^{∘}" 13194139533962 true] [17592186269097 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269097 1111 #uuid "a3f9b012-c354-5d6e-9581-72bdf697d50f" 13194139533962 true] [17592186269098 1034 "{70}^{∘}" 13194139533962 true] [17592186269098 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269098 1111 #uuid "4d60903b-6a7a-53d2-83bb-a4aa0851a070" 13194139533962 true] [17592186269099 1034 "{62}^{∘}" 13194139533962 true] [17592186269099 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269099 1111 #uuid "4a098196-3c16-5eab-ba4d-21e17c7dbf00" 13194139533962 true] [17592186269100 1034 "{59}^{∘}" 13194139533962 true] [17592186269100 1103 #edb/ref 17592186045453 13194139533962 true] [17592186269100 1