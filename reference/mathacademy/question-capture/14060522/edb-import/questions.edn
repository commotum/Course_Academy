#{[{:db/id #edb/ref 17592186091999 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c96e6d6f-22be-5bfd-b24e-be9e34fcb149" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/id #uuid "d2e0c6d3-e37e-5c12-be20-3d645b7c3b59" :question/math-academy-id "e-5359" :question/problem "Calculate the asymptotes of the hyperbola $\\dfrac{(x+2)^2}{18} - \\dfrac{(y+7)^2}{32} = 1$." :question/worked-solution "The standard equation of a horizontal hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(x-h)^2}{a^2} - \\frac{(y-k)^2}{b^2}=1\n$$\n\nFor a horizontal hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\dfrac{b}{a}(x-h)\n$$\n\nIn our case, we have\n\n$$\n(h,k) = (-2,-7),\\qquad a=\\sqrt{18} = 3\\sqrt{2}, \\qquad b=\\sqrt{32} = 4\\sqrt{2}\n$$\n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}\ny + 7 &= ± (\\frac{4\\sqrt{2}}{3\\sqrt{2}})(x + 2) \\\\\ny + 7 &= ± \\frac{4}{3}(x + 2)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092071 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola by Completing the Square"}] :question/id #uuid "2d3b2c00-06c8-5fc8-b615-b5e1b7cd7b8a" :question/math-academy-id "e-7428" :question/problem "Calculate the asymptotes of the hyperbola $9x^2 - y^2 - 36 x - 2y + 26 = 0$." :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}\n9x^{2} - y^{2} - 36x - 2y + 26 &= 0 \\\\\n9x^{2} - 36x - y^{2} - 2y + 26 &= 0 \\\\\n9[x^{2} - 4x] - [y^{2} + 2y] + 26 &= 0 \\\\\n9[(x - 2)^{2} - 4] - [(y + 1)^{2} - 1] + 26 &= 0 \\\\\n9(x - 2)^{2} - 36 - (y + 1)^{2} + 1 + 26 &= 0 \\\\\n9(x - 2)^{2} - (y + 1)^{2} &= -26 - 1 + 36 \\\\\n9(x - 2)^{2} - (y + 1)^{2} &= 9 \\\\\n&= (x - 2)^{2} - ((y + 1)^{2})/(9) = 1\n\\end{aligned}\n$$\n\nThe asymptotes of the horizontal hyperbola\n\n$$\n\\dfrac{(x-h)^2}{a^2} - \\dfrac{(y-k)^2}{b^2} = 1\n$$\n\nare given by\n\n$$\ny-k = \\pm\\dfrac{b}{a}(x-h)\n$$\n\nIn our case, we have\n\n$$\nh = 2, \\qquad k = -1, \\qquad a = \\sqrt{1} = 1,\\qquad b = \\sqrt{9} = 3\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}\ny + 1 &= ± 3(x - 2)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092072 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/id #uuid "3d9ae1ea-3b06-5167-b39a-3dc7ea09d8c2" :question/math-academy-id "e-7430" :question/problem "Calculate the asymptotes of the hyperbola $\\dfrac{(y - 1) ^ 2} {16} - \\dfrac{(x + 3)^2}{9} = 1$." :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\dfrac{(y-k)^2}{a^2} - \\dfrac{(x-h)^2}{b^2} = 1\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k = \\pm\\dfrac{a}{b}(x-h)\n$$\n\nIn our case, we have\n\n$$\na = \\sqrt{16} = 4, \\qquad b = \\sqrt{9} = 3, \\qquad h = -3, \\qquad k = 1\n$$\n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}\ny - 1 &= ± \\frac{4}{3}(x - (-3)) \\\\\ny - 1 &= ± \\frac{4}{3}(x + 3)\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092073 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola by Completing the Square"}] :question/id #uuid "1e0f4c0f-ed23-5d76-a63c-77a65be647cb" :question/math-academy-id "e-7431" :question/problem "Calculate the asymptotes of the hyperbola $y^2 - x^2 - 2y = 0$." :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}\ny^{2} - x^{2} - 2y &= 0 \\\\\n(y^{2} - 2y) - x^{2} &= 0 \\\\\n(y - 1)^{2} - 1 - x^{2} &= 0 \\\\\n(y - 1)^{2} - x^{2} &= 1\n\\end{aligned}\n$$\n\nThe asymptotes of the vertical hyperbola\n\n$$\n\\dfrac{(y-k)^2}{a^2} - \\dfrac{(x-h)^2}{b^2} = 1\n$$\n\nare given by\n\n$$\ny-k=\\pm \\dfrac{a}{b}(x-h)\n$$\n\nIn our case, we have\n\n$$\n(h,k) = (0,1), \\qquad a = \\sqrt{1} = 1, \\qquad b= \\sqrt{1} = 1\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}\ny - 1 &= ± x\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092528 :knowledge-point/_questions [{:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "959440f7-7db2-52e9-9617-b028063ff3ce" :answer/type {:db/ident :answer.type/math} :answer/value "y + 4 = ± \\frac{1}{3}x" :db/id #edb/ref 17592186089605} {:answer/id #uuid "98bc9fd4-759d-5f8f-917c-56b143c4cdda" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± 3(x + 4)" :db/id #edb/ref 17592186089606} {:answer/id #uuid "d041be2b-8164-55be-96b7-48c878a7e289" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± (x + 4)" :db/id #edb/ref 17592186089607} {:answer/id #uuid "6bb677a8-888a-5543-a6d1-529b862e9b0b" :answer/type {:db/ident :answer.type/math} :answer/value "y + 4 = ± x" :db/id #edb/ref 17592186089608} {:answer/id #uuid "79028a7e-bbff-545e-9ea4-06f78d1324f2" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{1}{3}(x + 4)" :db/id #edb/ref 17592186089609}] :answer-field/correct {:answer/id #uuid "d041be2b-8164-55be-96b7-48c878a7e289" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± (x + 4)" :db/id #edb/ref 17592186089607} :answer-field/id #uuid "300b7fc9-ed76-584d-9666-29645bda10bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089604}] :question/id #uuid "0b62a5af-9003-5857-84de-8df378771243" :question/math-academy-id "q-16443" :question/problem "Calculate the asymptotes of the hyperbola $x^{2} - y^{2} + 8x + 7 = 0$."}] [{:db/id #edb/ref 17592186092780 :knowledge-point/_questions [{:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7953033-81e7-51d6-8a33-55c75ed95a0d" :answer/type {:db/ident :answer.type/math} :answer/value "y - 2 = ± \\frac{1}{4}(x + 1)" :db/id #edb/ref 17592186091146} {:answer/id #uuid "441f2c19-d4d8-52c0-aae7-1e1942639a4a" :answer/type {:db/ident :answer.type/math} :answer/value "y - 1 = ± \\frac{1}{4}(x + 2)" :db/id #edb/ref 17592186091147} {:answer/id #uuid "45b0cbef-b34c-505a-9297-af32174ec48d" :answer/type {:db/ident :answer.type/math} :answer/value "y + 1 = ± 4(x - 2)" :db/id #edb/ref 17592186091148} {:answer/id #uuid "5e0d1220-47b4-5f49-a7ca-290c29c259e7" :answer/type {:db/ident :answer.type/math} :answer/value "y - 4 = ± 2(x + 1)" :db/id #edb/ref 17592186091149} {:answer/id #uuid "7a1d93e6-afd5-5d65-8f6c-a6d0f60222ae" :answer/type {:db/ident :answer.type/math} :answer/value "y - 2 = (x - 2)" :db/id #edb/ref 17592186091150}] :answer-field/correct {:answer/id #uuid "45b0cbef-b34c-505a-9297-af32174ec48d" :answer/type {:db/ident :answer.type/math} :answer/value "y + 1 = ± 4(x - 2)" :db/id #edb/ref 17592186091148} :answer-field/id #uuid "b74d1a67-339a-5ca1-a1f4-d7d17388eaae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091145}] :question/id #uuid "99b70427-adca-5add-87bd-308032db0a42" :question/math-academy-id "q-83906" :question/problem "Calculate the asymptotes of the hyperbola $16x^{2} - y^{2} - 64x - 2y + 47 = 0$."}]}
