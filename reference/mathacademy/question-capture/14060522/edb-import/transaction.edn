f2e97c8c16d981f9d1de9c85ce2627" "q-10470/selection/9af12d423fd362fa6778c53f05c2ccf556982e29e13fd7450652e1b948d46250" "q-10470/selection/6b157889562ad9da564aa6230fb1a794214d797f8bdf1cc6fdcc7938d51bc3d6"] :db/ensure [:answer-field/validate]} {:db/id "q-10470" :question/id #uuid "df144c9c-31f2-594e-958f-a4bf1a0938ce" :question/math-academy-id "q-10470" :question/problem "Calculate the asymptotes of the hyperbola $\\frac{(y-2)^{2}}{25}-\\frac{(x-2)^{2}}{9}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{25}=5,\\,b=\\sqrt{9}=3,\\,h=2,\\,k=2.\n$$\n\nTherefore, the asymptotes are given by\n\n$$\ny-2=\\pm \\frac{5}{3}(x-2).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10470/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4"] :knowledge-point/questions ["q-10470"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16436/selection/fcaf5d5a9366dbcd42911253ed72fa07d46e95e81cbbdabf14360255f60674c1" :answer/id #uuid "0158a5c6-30eb-5e22-a988-f9675073ff3c" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{3\\sqrt{2}}{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-16436/selection/36c70b5157b917aba92a9e87be7fe3e3ab1ffa597c0ee735e6096d582e2ab195" :answer/id #uuid "0a95a2c9-522a-5d86-88c0-e5ff99128e49" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{\\sqrt{6}}{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-16436/selection/5cc97f5717fcbbf694bd916dd60d2f65d7d357ece5be2fd00a6f4ea91f197682" :answer/id #uuid "20ad743f-19d4-5118-91d4-d3a23cc46d6f" :answer/type :answer.type/math :answer/value "y+1=\\pm \\sqrt{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-16436/selection/b20716d84988c69de7a8e5d41e42607e378bc1e6821464d2447a740b72becc89" :answer/id #uuid "2420da5d-3482-55be-9b8c-05dae6246b6d" :answer/type :answer.type/math :answer/value "y-1=\\pm \\frac{\\sqrt{6}}{2}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-16436/selection/cbf3a91c8270ab5abedc23194bae19e671fad1d268b677c0166bee22bd7b5c0c" :answer/id #uuid "336fa1b0-6e83-5ca5-a641-032a4b6ff0eb" :answer/type :answer.type/math :answer/value "y-1=\\pm \\sqrt{3}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-16436/selection" :answer-field/id #uuid "01a20373-9e89-5ac6-8f6d-3f0c4042efc5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16436/selection/36c70b5157b917aba92a9e87be7fe3e3ab1ffa597c0ee735e6096d582e2ab195" :answer-field/choices ["q-16436/selection/fcaf5d5a9366dbcd42911253ed72fa07d46e95e81cbbdabf14360255f60674c1" "q-16436/selection/36c70b5157b917aba92a9e87be7fe3e3ab1ffa597c0ee735e6096d582e2ab195" "q-16436/selection/5cc97f5717fcbbf694bd916dd60d2f65d7d357ece5be2fd00a6f4ea91f197682" "q-16436/selection/b20716d84988c69de7a8e5d41e42607e378bc1e6821464d2447a740b72becc89" "q-16436/selection/cbf3a91c8270ab5abedc23194bae19e671fad1d268b677c0166bee22bd7b5c0c"] :db/ensure [:answer-field/validate]} {:db/id "q-16436" :question/id #uuid "c56c9dd5-76a5-553a-ab03-9c4e5fe7c26a" :question/math-academy-id "q-16436" :question/problem "Calculate the asymptotes of the hyperbola $\\frac{(y+1)^{2}}{3}-\\frac{(x+1)^{2}}{2}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{3},\\,b=\\sqrt{2},\\,h=-1,\\,k=-1.\n$$\n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y-(-1) & =\\pm (\\frac{\\sqrt{3}}{\\sqrt{2}})(x-(-1)) \\\\ y+1 & =\\pm \\frac{\\sqrt{6}}{2}(x+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16436/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4"] :knowledge-point/questions ["q-16436"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325367/field-1/46583dff710b4906c619bb22c65caca207bb28299f7c0f8334b20138d9e58435" :answer/id #uuid "efde410c-eeb1-5310-b905-ba8a174a4fe5" :answer/type :answer.type/math :answer/value "\\frac{3}{2}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-325367/field-1" :answer-field/id #uuid "29a21931-e8d3-5203-862d-5fd7dd016b51" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325367/field-1/46583dff710b4906c619bb22c65caca207bb28299f7c0f8334b20138d9e58435" :answer-field/choices ["q-325367/field-1/46583dff710b4906c619bb22c65caca207bb28299f7c0f8334b20138d9e58435"] :db/ensure [:answer-field/validate]} {:db/id "q-325367" :question/id #uuid "fb21eb3a-428b-5941-aee7-65dc2cddf525" :question/math-academy-id "q-325367" :question/problem "Calculate the asymptotes of the hyperbola $\\frac{{y}^{2}}{27}-\\frac{(x-4)^{2}}{12}=1.$\n\n$y=\\pm $\n{{field-1}}" :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(4,0),\\,a=\\sqrt{27}=3\\sqrt{3},\\,b=\\sqrt{12}=2\\sqrt{3}.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y-0 & =\\pm (\\frac{3\\sqrt{3}}{2\\sqrt{3}})(x-4) \\\\ y & =\\pm \\,\\frac{3}{2}(x-4).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325367/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ace3c4b0-6b1c-595d-bc60-b89e2b24f6b4"] :knowledge-point/questions ["q-325367"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-83906"] :question/problem "Calculate the asymptotes of the hyperbola $16{x}^{2}-{y}^{2}-64x-2y+47=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-{y}^{2}-64x-2y+47 & =0 \\\\ (16{x}^{2}-64x)+(-{y}^{2}-2y)+47 & =0 \\\\ 16[{x}^{2}-4x]-[{y}^{2}+2y]+47 & =0 \\\\ 16[(x-2)^{2}-4]-[(y+1)^{2}-1]+47 & =0 \\\\ 16(x-2)^{2}-64-(y+1)^{2}+1+47 & =0 \\\\ 16(x-2)^{2}-(y+1)^{2} & =64-1-47 \\\\ 16(x-2)^{2}-(y+1)^{2} & =16 \\\\ \\frac{16(x-2)^{2}}{16}-\\frac{(y+1)^{2}}{16} & =\\frac{16}{16} \\\\ \\frac{(x-2)^{2}}{1}-\\frac{(y+1)^{2}}{16} & =1\\end{aligned}\n$$\n\nThe asymptotes of a horizontal hyperbola\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\nh=2,\\,k=-1,\\,a=\\sqrt{1}=1,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y+1 & =\\pm \\frac{4}{1}(x-2) \\\\  & =\\pm 4(x-2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-86672/selection/b0bc6d48bfe19f79544756963f4dadca6e8beaf8fa3f478ccfed1a687c0e3142" :answer/id #uuid "31defa8c-960b-522e-8a1e-dbca0a770cb0" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{4}{3}(x+2)" :db/ensure [:answer/validate]} {:db/id "q-86672/selection/2689e47efa167af62d5718b566f5400db37c48700430e5dab675eedaf147e0c6" :answer/id #uuid "4fbf05f1-9bcc-592c-b81a-b7ce3f49de9d" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{4}(x+2)" :db/ensure [:answer/validate]} {:db/id "q-86672/selection/ffef99fdbac0bc94bfc7bb1d01e1d88020c8875ec77a05bde4cb05a8c789c112" :answer/id #uuid "85d9242b-7ef3-5c68-bb4e-7c42d3fbf484" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{2}(x-2)" :db/ensure [:answer/validate]} {:db/id "q-86672/selection/8fb3ee83ffafc874563409c1cb8311a756ee1a8974d331c8347e811b26f0dea4" :answer/id #uuid "4ea00e33-799b-569c-8e10-371909d3e064" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{2}{3}(x+2)" :db/ensure [:answer/validate]} {:db/id "q-86672/selection/6da1b49806279b6e97d0c0a4c6419e1d3a1cc2b4052e4c8b77f98383882f6b81" :answer/id #uuid "bd5aa16b-b756-5ef4-8a46-7bc63618764e" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{2}(x+2)" :db/ensure [:answer/validate]} {:db/id "q-86672/selection" :answer-field/id #uuid "509b81c5-0ba0-5c32-8ddd-3f7634159945" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86672/selection/8fb3ee83ffafc874563409c1cb8311a756ee1a8974d331c8347e811b26f0dea4" :answer-field/choices ["q-86672/selection/b0bc6d48bfe19f79544756963f4dadca6e8beaf8fa3f478ccfed1a687c0e3142" "q-86672/selection/2689e47efa167af62d5718b566f5400db37c48700430e5dab675eedaf147e0c6" "q-86672/selection/ffef99fdbac0bc94bfc7bb1d01e1d88020c8875ec77a05bde4cb05a8c789c112" "q-86672/selection/8fb3ee83ffafc874563409c1cb8311a756ee1a8974d331c8347e811b26f0dea4" "q-86672/selection/6da1b49806279b6e97d0c0a4c6419e1d3a1cc2b4052e4c8b77f98383882f6b81"] :db/ensure [:answer-field/validate]} {:db/id "q-86672" :question/id #uuid "8b4aa972-1824-5c7a-b4a4-7df673a2b3ef" :question/math-academy-id "q-86672" :question/problem "Calculate the asymptotes of the hyperbola $4{x}^{2}-9{y}^{2}+16x-20=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ terms and complete the square, as follows:\n\n$$\n\\begin{aligned}4{x}^{2}-9{y}^{2}+16x-20 & =0 \\\\ (4{x}^{2}+16x)-9{y}^{2}-20 & =0 \\\\ 4[{x}^{2}+4x]-9{y}^{2}-20 & =0 \\\\ 4[(x+2)^{2}-4]-9{y}^{2}-20 & =0 \\\\ 4(x+2)^{2}-16-9{y}^{2}-20 & =0 \\\\ 4(x+2)^{2}-9{y}^{2} & =20+16 \\\\ 4(x+2)^{2}-9{y}^{2} & =36 \\\\ \\frac{4(x+2)^{2}}{36}-\\frac{9{y}^{2}}{36} & =\\frac{36}{36} \\\\ \\frac{(x+2)^{2}}{9}-\\frac{{y}^{2}}{4} & =1\\end{aligned}\n$$\n\nThe asymptotes of a horizontal hyperbola\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\nh=-2,\\,k=0,\\,a=\\sqrt{9}=3,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{2}{3}(x+2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86672/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9"] :knowledge-point/questions ["q-86672"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325375/field-1/726f8e89c7aaa036638b20c908891f1bc5ec24ceb0139abe44fca05aa987999c" :answer/id #uuid "684b5f20-eab6-5da3-aa5b-f880a807bd47" :answer/type :answer.type/math :answer/value "\\frac{2}{3}(x-3)" :db/ensure [:answer/validate]} {:db/id "q-325375/field-1/4d00d3a76c934e77031c6e3a92d0f863e06e6021dae8dcb1c9d7f4c13aa2a525" :answer/id #uuid "b02cfe4b-b84a-5177-ba5f-a72d00e0a714" :answer/type :answer.type/math :answer/value "\\frac{3}{2}(x-3)" :db/ensure [:answer/validate]} {:db/id "q-325375/field-1" :answer-field/id #uuid "6a2e259a-77d0-5ac7-8711-3f7aa387e98a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325375/field-1/726f8e89c7aaa036638b20c908891f1bc5ec24ceb0139abe44fca05aa987999c" :answer-field/choices ["q-325375/field-1/726f8e89c7aaa036638b20c908891f1bc5ec24ceb0139abe44fca05aa987999c" "q-325375/field-1/4d00d3a76c934e77031c6e3a92d0f863e06e6021dae8dcb1c9d7f4c13aa2a525"] :db/ensure [:answer-field/validate]} {:db/id "q-325375" :question/id #uuid "c6231a16-b519-5567-8003-872b8131c4e6" :question/math-academy-id "q-325375" :question/problem "Calculate the asymptotes of the hyperbola $4{x}^{2}-9{y}^{2}-24x=0.$\n\n$y=\\pm $\n{{field-1}}" :question/worked-solution "Group the $x$ terms and complete the square:\n\n$$\n\\begin{aligned}4{x}^{2}-9{y}^{2}-24x & =0 \\\\ 4({x}^{2}-6x)-9{y}^{2} & =0 \\\\ 4\\,[(x-3)^{2}-9]-9{y}^{2} & =0 \\\\ 4(x-3)^{2}-36-9{y}^{2} & =0 \\\\ 4(x-3)^{2}-9{y}^{2} & =36 \\\\ \\frac{4(x-3)^{2}}{36}-\\frac{9{y}^{2}}{36} & =1 \\\\ \\frac{(x-3)^{2}}{9}-\\frac{{y}^{2}}{4} & =1\\end{aligned}\n$$\n\nThus it is a horizontal hyperbola\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1,\n$$\n\nso the asymptotes are\n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nHere,\n\n$$\n(h,k)=(3,0),\\,a=\\sqrt{9}=3,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}y-0 & =\\pm (\\frac{2}{3})(x-3) \\\\ y & =\\pm \\,\\frac{2}{3}(x-3).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325375/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9"] :knowledge-point/questions ["q-325375"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-16443"] :question/problem "Calculate the asymptotes of the hyperbola ${x}^{2}-{y}^{2}+8x+7=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}+8x+7 & =0 \\\\ {x}^{2}+8x-{y}^{2}+7 & =0 \\\\ (x+4)^{2}-16-{y}^{2}+7 & =0 \\\\ (x+4)^{2}-{y}^{2}-9 & =0 \\\\ (x+4)^{2}-{y}^{2} & =9 \\\\ \\frac{(x+4)^{2}}{9}-\\frac{{y}^{2}}{9} & =1\\end{aligned}\n$$\n\nThe standard equation of a horizontal hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(-4,0),\\,a=\\sqrt{9}=3,\\,b=\\sqrt{9}=3.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\ny=\\pm (x+4).\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-10476/selection/6c9dee8fc4fb5815d75aba9a1e5e1e2587a54907866034673fd1235242302567" :answer/id #uuid "3f3bd40f-657e-570e-9f5c-13725ca4272b" :answer/type :answer.type/math :answer/value "y-1=\\pm \\frac{3}{2}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-10476/selection/6294389ffc0ca1c260cf25607172ebd725792d8783cb80d9fdf3144c24a6042a" :answer/id #uuid "cf8a242d-c825-5a86-b1a0-8c0f9fd9f17f" :answer/type :answer.type/math :answer/value "y-1=\\pm \\frac{3}{4}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-10476/selection/00a551b21a989d3bd4e4b92285a3e042f8c41eefefa2285ac210db5e2b279c41" :answer/id #uuid "915e809a-b0b7-5c3b-9b7a-2eee711f1e92" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{2}{3}(x+4)" :db/ensure [:answer/validate]} {:db/id "q-10476/selection/a823c4002020a7f666c4f54ed90916f37eac02823185098eda5718248baab7b0" :answer/id #uuid "c57a1b68-82ae-51e7-893c-536419d5cac2" :answer/type :answer.type/math :answer/value "y-1=\\pm \\frac{2}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-10476/selection/309466bd884c99f0f62c082439d545d256fcfa60582e540cb8cc837e11b9f2f2" :answer/id #uuid "fb378d5f-1c54-566b-99c7-6903a656166d" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{3}{2}(x+4)" :db/ensure [:answer/validate]} {:db/id "q-10476/selection" :answer-field/id #uuid "92edd747-4141-5a9c-b88e-174903fb9281" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10476/selection/a823c4002020a7f666c4f54ed90916f37eac02823185098eda5718248baab7b0" :answer-field/choices ["q-10476/selection/6c9dee8fc4fb5815d75aba9a1e5e1e2587a54907866034673fd1235242302567" "q-10476/selection/6294389ffc0ca1c260cf25607172ebd725792d8783cb80d9fdf3144c24a6042a" "q-10476/selection/00a551b21a989d3bd4e4b92285a3e042f8c41eefefa2285ac210db5e2b279c41" "q-10476/selection/a823c4002020a7f666c4f54ed90916f37eac02823185098eda5718248baab7b0" "q-10476/selection/309466bd884c99f0f62c082439d545d256fcfa60582e540cb8cc837e11b9f2f2"] :db/ensure [:answer-field/validate]} {:db/id "q-10476" :question/id #uuid "67b95450-22b9-5cce-8735-0135006f36b7" :question/math-academy-id "q-10476" :question/problem "Calculate the asymptotes of the hyperbola $4{x}^{2}-9{y}^{2}-32x+18y+19=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{x}^{2}-9{y}^{2}-32x+18y+19 & =0 \\\\ 4{x}^{2}-32x-9{y}^{2}+18y+19 & =0 \\\\ 4[{x}^{2}-8x]-9[{y}^{2}-2y]+19 & =0 \\\\ 4[(x-4)^{2}-16]-9[(y-1)^{2}-1]+19 & =0 \\\\ 4(x-4)^{2}-64-9(y-1)^{2}+9+19 & =0 \\\\ 4(x-4)^{2}-9(y-1)^{2} & =64-9-19 \\\\ 4(x-4)^{2}-9(y-1)^{2} & =36 \\\\ \\frac{(x-4)^{2}}{9}-\\frac{(y-1)^{2}}{4} & =1\\end{aligned}\n$$\n\nThe standard equation of a horizontal hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\frac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(4,1),\\,a=\\sqrt{9}=3,\\,b=\\sqrt{4}=2.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\ny-1=\\pm \\frac{2}{3}(x-4).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56abbbc0-080d-5586-931f-957bd2b793b9"] :knowledge-point/questions ["q-10476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325439/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "957b593f-cf9b-5c8a-9f34-31be36bad502" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-325439/field-1" :answer-field/id #uuid "f7e16298-3a18-58c9-bfbf-87a322e4df24" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325439/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-325439/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-325439/field-2/b16a27d950b357ba888bb494c120bb671325cffe75dde64354cb0565f9eed3ae" :answer/id #uuid "afd8c2d3-a6ee-584a-95af-77d0e5c87362" :answer/type :answer.type/math :answer/value "\\frac{4}{3}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-325439/field-2" :answer-field/id #uuid "69efbad8-269c-5b98-9ae4-2b3ebb5255b1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325439/field-2/b16a27d950b357ba888bb494c120bb671325cffe75dde64354cb0565f9eed3ae" :answer-field/choices ["q-325439/field-2/b16a27d950b357ba888bb494c120bb671325cffe75dde64354cb0565f9eed3ae"] :db/ensure [:answer-field/validate]} {:db/id "q-325439" :question/id #uuid "e46f8545-8a61-54bd-8997-8c67725dfcd8" :question/math-academy-id "q-325439" :question/problem "Calculate the asymptotes of the hyperbola $9{y}^{2}+36y-16{x}^{2}+32x-124=0.$\n\n$y\\,\\,+$\n{{field-1}}\n$=\\pm $\n{{field-2}}" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the square, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}+36y-16{x}^{2}+32x-124 & =0 \\\\ 9({y}^{2}+4y)-16({x}^{2}-2x)-124 & =0 \\\\ 9\\,[(y+2)^{2}-4]-16\\,[(x-1)^{2}-1]-124 & =0 \\\\ 9(y+2)^{2}-36-16(x-1)^{2}+16-124 & =0 \\\\ 9(y+2)^{2}-16(x-1)^{2} & =144 \\\\ \\frac{9(y+2)^{2}}{144}-\\frac{16(x-1)^{2}}{144} & =1 \\\\ \\frac{(y+2)^{2}}{16}-\\frac{(x-1)^{2}}{9} & =1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(1,-2),\\,a=\\sqrt{16}=4,\\,b=\\sqrt{9}=3.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y-(-2) & =\\pm (\\frac{4}{3})(x-1) \\\\ y+2 & =\\pm \\,\\frac{4}{3}(x-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325439/field-1" "q-325439/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a"] :knowledge-point/questions ["q-325439"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325436/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "6b28774d-9e6b-5d7f-9a67-3fc1e224e3c3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-325436/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a0479e9b-ab8a-5fbb-89f2-8ae56cf236fd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-325436/field-1" :answer-field/id #uuid "b30cb763-a63f-5877-8a13-2109d112d867" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325436/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-325436/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-325436/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-325436/field-2/78da8a4c0448da1fe9380fa1788dd033a4204b6df3722b7d284cb0fc8bc520d4" :answer/id #uuid "8c8087f5-2d7c-54c8-b353-6ced9dbb25ab" :answer/type :answer.type/math :answer/value "\\frac{2}{3}x" :db/ensure [:answer/validate]} {:db/id "q-325436/field-2" :answer-field/id #uuid "4c3bd35c-20e6-5fc9-bf8f-a8720c437373" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325436/field-2/78da8a4c0448da1fe9380fa1788dd033a4204b6df3722b7d284cb0fc8bc520d4" :answer-field/choices ["q-325436/field-2/78da8a4c0448da1fe9380fa1788dd033a4204b6df3722b7d284cb0fc8bc520d4"] :db/ensure [:answer-field/validate]} {:db/id "q-325436" :question/id #uuid "95fc4051-ef0b-536b-911f-79cd27270db2" :question/math-academy-id "q-325436" :question/problem "Calculate the asymptotes of the hyperbola $9{y}^{2}-4{x}^{2}+54y-27=0.$\n\n$y\\,\\,+$\n{{field-1}}\n$=\\pm $\n{{field-2}}" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ terms and complete the square, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-4{x}^{2}+54y-27 & =0 \\\\ 9({y}^{2}+6y)-4{x}^{2}-27 & =0 \\\\ 9\\,[(y+3)^{2}-9]-4{x}^{2}-27 & =0 \\\\ 9(y+3)^{2}-81-4{x}^{2}-27 & =0 \\\\ 9(y+3)^{2}-4{x}^{2} & =108 \\\\ \\frac{9(y+3)^{2}}{108}-\\frac{4{x}^{2}}{108} & =1 \\\\ \\frac{(y+3)^{2}}{12}-\\frac{{x}^{2}}{27} & =1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(0,-3),\\,a=\\sqrt{12}=2\\sqrt{3},\\,b=\\sqrt{27}=3\\sqrt{3}.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y-(-3) & =\\pm (\\frac{2\\sqrt{3}}{3\\sqrt{3}})(x-0) \\\\ y+3 & =\\pm \\,\\frac{2}{3}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325436/field-1" "q-325436/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a"] :knowledge-point/questions ["q-325436"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83909/selection/6908675b9d9bfe720ae538a159d1b46d8ffdb88ca6d1be500087dd10521496a5" :answer/id #uuid "fa868989-7d98-5e92-a18a-4baead0eef1e" :answer/type :answer.type/math :answer/value "y-3=\\pm \\frac{3}{2}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-83909/selection/696547f772a59f3d133a9b9340520276da2b757a004f85c07d651926027ed6f2" :answer/id #uuid "20ce194f-2520-5d97-aae1-348472b69cb8" :answer/type :answer.type/math :answer/value "y-4=\\pm \\frac{3}{2}(x-3)" :db/ensure [:answer/validate]} {:db/id "q-83909/selection/20bc38e82f74e4dcf0713b2cb795093148899e9d9e17fca6b69ac77303236487" :answer/id #uuid "6c12a8fa-a26d-5309-892c-8e9a92622266" :answer/type :answer.type/math :answer/value "y+4=\\pm \\frac{3}{2}(x+3)" :db/ensure [:answer/validate]} {:db/id "q-83909/selection/34cf1d601e4fe17fcc91223071915da5b9e0537fc43c0bb0f2226002c7bb5958" :answer/id #uuid "57cbbed7-408b-563c-b74b-e5f6445b8879" :answer/type :answer.type/math :answer/value "y-4=\\pm \\frac{2}{3}(x+3)" :db/ensure [:answer/validate]} {:db/id "q-83909/selection/d939282ebb1ee9ea95a44d7f3bbba18704bfafcb6d6809232e89596663bb016c" :answer/id #uuid "9c0da25e-32de-56a2-9bc2-28fe465bac18" :answer/type :answer.type/math :answer/value "y-3=\\pm \\frac{2}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-83909/selection" :answer-field/id #uuid "5975b365-40ae-52c5-a408-39240e5e216c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83909/selection/696547f772a59f3d133a9b9340520276da2b757a004f85c07d651926027ed6f2" :answer-field/choices ["q-83909/selection/6908675b9d9bfe720ae538a159d1b46d8ffdb88ca6d1be500087dd10521496a5" "q-83909/selection/696547f772a59f3d133a9b9340520276da2b757a004f85c07d651926027ed6f2" "q-83909/selection/20bc38e82f74e4dcf0713b2cb795093148899e9d9e17fca6b69ac77303236487" "q-83909/selection/34cf1d601e4fe17fcc91223071915da5b9e0537fc43c0bb0f2226002c7bb5958" "q-83909/selection/d939282ebb1ee9ea95a44d7f3bbba18704bfafcb6d6809232e89596663bb016c"] :db/ensure [:answer-field/validate]} {:db/id "q-83909" :question/id #uuid "f0226369-319a-5694-ae58-86b4c1cede6f" :question/math-academy-id "q-83909" :question/problem "Calculate the asymptotes of the hyperbola $4{y}^{2}-9{x}^{2}+54x-32y=53.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ terms and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-9{x}^{2}+54x-32y & =53 \\\\ (4{y}^{2}-32y)+(-9{x}^{2}+54x) & =53 \\\\ 4[{y}^{2}-8y]-9[{x}^{2}-6x] & =53 \\\\ 4[(y-4)^{2}-16]-9[(x-3)^{2}-9] & =53 \\\\ 4(y-4)^{2}-64-9(x-3)^{2}+81 & =53 \\\\ 4(y-4)^{2}-9(x-3)^{2} & =53+64-81 \\\\ 4(y-4)^{2}-9(x-3)^{2} & =36 \\\\ \\frac{4(y-4)^{2}}{36}-\\frac{9(x-3)^{2}}{36} & =\\frac{36}{36} \\\\ \\frac{(y-4)^{2}}{9}-\\frac{(x-3)^{2}}{4} & =1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(3,4),\\,a=\\sqrt{9}=3,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\ny-4=\\pm \\frac{3}{2}(x-3).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83909/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a"] :knowledge-point/questions ["q-83909"] :db/ensure [:knowledge-point/validate]} {:db/id "q-165482/selection/e1ceeb16a19a4a33b069d031f771fc27176e165659557283702321144135164b" :answer/id #uuid "dd995755-b973-55ab-b259-3b034c93df53" :answer/type :answer.type/math :answer/value "y-1=\\pm \\frac{1}{2}(x+2)" :db/ensure [:answer/validate]} {:db/id "q-165482/selection/ab3ff3b0f1dc9f4b9fa0d57487f82e0c076b47ee862d6735b425992d1fc5e401" :answer/id #uuid "c084646b-ddf7-530d-ab8f-86171196bca5" :answer/type :answer.type/math :answer/value "y+2=\\pm 2(x-1)" :db/ensure [:answer/validate]} {:db/id "q-165482/selection/2a6f2b4b043598437a6058901e136bf3888f95b93054b082047a08c10af4bf51" :answer/id #uuid "a1a034ce-810a-5912-9ad3-8dd4c55ee450" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{1}{4}(x-2)" :db/ensure [:answer/validate]} {:db/id "q-165482/selection/edd649cfd2ee89f1af0eff28155213e78c4136c36f4402cf89ff5ed59986bbe9" :answer/id #uuid "8d75ac35-239c-5e52-8565-2de81fd4e5aa" :answer/type :answer.type/math :answer/value "y-1=\\pm 4(x+2)" :db/ensure [:answer/validate]} {:db/id "q-165482/selection/b5b23ff9bcc3e758ac12ace51dd276e6436bf392d310664e47d44339606d44b0" :answer/id #uuid "53bef55b-4c75-54dc-a46e-b16219998816" :answer/type :answer.type/math :answer/value "y+2=\\pm \\frac{1}{2}(x-1)" :db/ensure [:answer/validate]} {:db/id "q-165482/selection" :answer-field/id #uuid "b5e32863-3b4e-53fc-b0ff-62f4d944d47a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-165482/selection/e1ceeb16a19a4a33b069d031f771fc27176e165659557283702321144135164b" :answer-field/choices ["q-165482/selection/e1ceeb16a19a4a33b069d031f771fc27176e165659557283702321144135164b" "q-165482/selection/ab3ff3b0f1dc9f4b9fa0d57487f82e0c076b47ee862d6735b425992d1fc5e401" "q-165482/selection/2a6f2b4b043598437a6058901e136bf3888f95b93054b082047a08c10af4bf51" "q-165482/selection/edd649cfd2ee89f1af0eff28155213e78c4136c36f4402cf89ff5ed59986bbe9" "q-165482/selection/b5b23ff9bcc3e758ac12ace51dd276e6436bf392d310664e47d44339606d44b0"] :db/ensure [:answer-field/validate]} {:db/id "q-165482" :question/id #uuid "d765260f-7408-51ca-af7e-de1bc557eb5a" :question/math-academy-id "q-165482" :question/problem "Calculate the asymptotes of the hyperbola $4{y}^{2}-{x}^{2}-8y-4x-16=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-{x}^{2}-8y-4x-16 & =0 \\\\ 4{y}^{2}-8y-{x}^{2}-4x-16 & =0 \\\\ 4[{y}^{2}-2y]-[{x}^{2}+4x]-16 & =0 \\\\ 4[(y-1)^{2}-1]-[(x+2)^{2}-4]-16 & =0 \\\\ 4(y-1)^{2}-4-(x+2)^{2}+4-16 & =0 \\\\ 4(y-1)^{2}-(x+2)^{2} & =16 \\\\ \\frac{(y-1)^{2}}{4}-\\frac{(x+2)^{2}}{16}=1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(-2,1),\\,a=\\sqrt{4}=2,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\ny-1=\\pm \\frac{1}{2}(x+2).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-165482/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a"] :knowledge-point/questions ["q-165482"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10480/selection/ff213f7be061d71d5381b0fcbebd2e4363a160b0beec32547f0bf79836524b03" :answer/id #uuid "0425ee5b-4d95-5db7-9c86-fbf33b8aa090" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{2\\sqrt{5}}{5}(x-6)" :db/ensure [:answer/validate]} {:db/id "q-10480/selection/b52dfb9af03e8193eefa544066f73502f68b225c5b101663f188b3c6eb77ab5f" :answer/id #uuid "458cd9d3-bdc0-502d-9627-7c858fd98dd3" :answer/type :answer.type/math :answer/value "y-6=\\pm \\frac{\\sqrt{5}}{2}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-10480/selection/88ff883e013f7a1ef10f7eadf42a73376a0058ff3802fe6df9826df076e1cacf" :answer/id #uuid "d6e7c577-a3a2-51e3-9de3-1caa802defc6" :answer/type :answer.type/math :answer/value "y+1=\\pm \\frac{\\sqrt{5}}{2}(x-6)" :db/ensure [:answer/validate]} {:db/id "q-10480/selection/ccbd072c8f773036c8f8e3150f9b94032dbf349538b6783919bce40d668bf2cf" :answer/id #uuid "783cee4d-656a-5172-8c5c-ff16484c4383" :answer/type :answer.type/math :answer/value "y-6=\\pm \\frac{4\\sqrt{5}}{5}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-10480/selection/8d73aa722b5a2719e67a2c7beb9103cb30337ff215c49e1308897a21c15320dd" :answer/id #uuid "4f815a4e-929e-5a91-927f-ed6de5e29500" :answer/type :answer.type/math :answer/value "y-6=\\pm \\frac{2\\sqrt{5}}{5}(x+1)" :db/ensure [:answer/validate]} {:db/id "q-10480/selection" :answer-field/id #uuid "d182e9c6-e0ba-5599-9493-2b77b938f789" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10480/selection/b52dfb9af03e8193eefa544066f73502f68b225c5b101663f188b3c6eb77ab5f" :answer-field/choices ["q-10480/selection/ff213f7be061d71d5381b0fcbebd2e4363a160b0beec32547f0bf79836524b03" "q-10480/selection/b52dfb9af03e8193eefa544066f73502f68b225c5b101663f188b3c6eb77ab5f" "q-10480/selection/88ff883e013f7a1ef10f7eadf42a73376a0058ff3802fe6df9826df076e1cacf" "q-10480/selection/ccbd072c8f773036c8f8e3150f9b94032dbf349538b6783919bce40d668bf2cf" "q-10480/selection/8d73aa722b5a2719e67a2c7beb9103cb30337ff215c49e1308897a21c15320dd"] :db/ensure [:answer-field/validate]} {:db/id "q-10480" :question/id #uuid "77851a06-c0ae-5922-bbf6-af708ba25be0" :question/math-academy-id "q-10480" :question/problem "Calculate the asymptotes of the hyperbola $4{y}^{2}-5{x}^{2}-48y-10x+59=0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-5{x}^{2}-48y-10x+59 & =0 \\\\ 4{y}^{2}-48y-5{x}^{2}-10x+59 & =0 \\\\ 4[{y}^{2}-12y]-5[{x}^{2}+2x]+59 & =0 \\\\ 4[(y-6)^{2}-36]-5[(x+1)^{2}-1]+59 & =0 \\\\ 4(y-6)^{2}-144-5(x+1)^{2}+5+59 & =0 \\\\ 4(y-6)^{2}-5(x+1)^{2} & =144-5-59 \\\\ 4(y-6)^{2}-5(x+1)^{2} & =80 \\\\ \\frac{(y-6)^{2}}{20}-\\frac{(x+1)^{2}}{16}=1\\end{aligned}\n$$\n\nThe asymptotes of a vertical hyperbola\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\frac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k)=(-1,6),\\,a=\\sqrt{20}=2\\sqrt{5},\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\ny-6=\\pm \\frac{\\sqrt{5}}{2}(x+1).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10480/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d19a514c-faa5-5f69-9870-87f78878f08a"] :knowledge-point/questions ["q-10480"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5359"] :question/problem "Calculate the asymptotes of the hyperbola $\\dfrac{(x+2)^2}{18} - \\dfrac{(y+7)^2}{32} = 1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at $(h,k)$ is\n\n$$\n\\frac{(x-h)^2}{a^2} - \\frac{(y-k)^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola, the equations of the asymptotes are\n\n$$\ny-k=\\pm \\dfrac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\n(h,k) = (-2,-7),\\qquad a=\\sqrt{18} = 3\\sqrt{2}, \\qquad b=\\sqrt{32} = 4\\sqrt{2}.\n$$\n\n \n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y+7 & =\\pm (\\frac{4\\sqrt{2}}{3\\sqrt{2}})(x+2) \\\\ y+7 & =\\pm \\frac{4}{3}(x+2).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7430"] :question/worked-solution "The standard equation of a vertical hyperbola centered at $(h,k)$ is\n\n$$\n\\dfrac{(y-k)^2}{a^2} - \\dfrac{(x-h)^2}{b^2} = 1.\n$$\n\nFor a vertical hyperbola, the equations of the asymptotes are\n\n$$\ny-k = \\pm\\dfrac{a}{b}(x-h).\n$$\n\nIn our case, we have \n\n$$\na = \\sqrt{16} = 4, \\qquad b = \\sqrt{9} = 3, \\qquad h = -3, \\qquad k = 1.\n$$\n\nTherefore, the asymptotes are given by\n\n$$\n\\begin{aligned}y-1 & =\\pm \\frac{4}{3}(x-(-3)) \\\\ y-1 & =\\pm \\frac{4}{3}(x+3).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7428"] :question/problem "Calculate the asymptotes of the hyperbola $9x^2 - y^2 - 36 x - 2y + 26 = 0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}9{x}^{2}-{y}^{2}-36x-2y+26 & =0 \\\\ 9{x}^{2}-36x-{y}^{2}-2y+26 & =0 \\\\ 9[{x}^{2}-4x]-[{y}^{2}+2y]+26 & =0 \\\\ 9[(x-2)^{2}-4]-[(y+1)^{2}-1]+26 & =0 \\\\ 9(x-2)^{2}-36-(y+1)^{2}+1+26 & =0 \\\\ 9(x-2)^{2}-(y+1)^{2} & =-26-1+36 \\\\ 9(x-2)^{2}-(y+1)^{2} & =9 \\\\ (x-2)^{2}-\\frac{(y+1)^{2}}{9}=1\\end{aligned}\n$$\n\nThe asymptotes of the horizontal hyperbola\n\n$$\n\\dfrac{(x-h)^2}{a^2} - \\dfrac{(y-k)^2}{b^2} = 1\n$$\n\nare given by \n\n$$\ny-k = \\pm\\dfrac{b}{a}(x-h).\n$$\n\nIn our case, we have \n\n$$\nh = 2, \\qquad k = -1, \\qquad a = \\sqrt{1} = 1,\\qquad b = \\sqrt{9} = 3.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y+1 & =\\pm 3(x-2).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7431"] :question/problem "Calculate the asymptotes of the hyperbola $y^2 - x^2 - 2y = 0.$" :question/worked-solution "To rewrite the equation of the hyperbola in standard form, we need to group the $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-{x}^{2}-2y & =0 \\\\ ({y}^{2}-2y)-{x}^{2} & =0 \\\\ (y-1)^{2}-1-{x}^{2} & =0 \\\\ (y-1)^{2}-{x}^{2} & =1\\end{aligned}\n$$\n\nThe asymptotes of the vertical hyperbola\n\n$$\n\\dfrac{(y-k)^2}{a^2} - \\dfrac{(x-h)^2}{b^2} = 1\n$$\n\nare given by \n\n$$\ny-k=\\pm \\dfrac{a}{b}(x-h) .\n$$\n\nIn our case, we have \n\n$$\n(h,k) = (0,1), \\qquad a = \\sqrt{1} = 1, \\qquad b= \\sqrt{1} = 1.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y-1 & =\\pm x.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
