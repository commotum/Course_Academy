{"authored" [{"question" "q-119038" "field" nil "attribute" "question/problem" "value" "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" nil "attribute" "question/worked-solution" "value" "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/activity-metadata.json" "file_sha256" "e0ce3625e0df62ca0ea55575ada38985c21728032260dd59bc792c2c2e96634f" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=-4{e}^{-2x}+Cx+D"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=-{e}^{-2x}+C{e}^{-x}+Dx"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=2{e}^{-2x}+Cx+D"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=2{e}^{-2x}+C{e}^{-x}+D"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y={e}^{-2x}+C{x}^{2}+Dx"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"} {"question" "q-119038" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=2{e}^{-2x}+Cx+D"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/state.json" "file_sha256" "760c07a175acb7b33e2ab6e88e80add647d6afa869b6730164f889c3d0f4650b" "basis" 1489 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/edb-import/verification.json"}] "sources" [{"question" "q-50044" "field" nil "attribute" "question/problem" "value" "Find the particular solution to the differential equation below that satisfies the condition $y(-1)=2$\n \n\n$$\nx\\cdot \\frac{\\text{d}y}{\\text{d}x}=6{x}^{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50044" "field" nil "attribute" "question/worked-solution" "value" "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=6{x}^{2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 6{x}^{2}\\,\\text{d}x \\\\ y & =6(\\frac{{x}^{3}}{3})\\,\\text{d}x \\\\  & =2{x}^{3}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=2{x}^{3}+C.$ To find a particular solution, we substitute the condition $y(-1)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =2{x}^{3}+C \\\\ 2 & =2(-1)^{3}+C \\\\ 2 & =-2+C \\\\ C & =4.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=2{x}^{3}+4.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50044" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/activity-metadata.json" "file_sha256" "04223ef10b67c6447620bcf1bb9502602999972046e6ef9a9f0332a81fce7f80"} {"question" "q-50044" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50044" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=-2{x}^{2}+4"] ["math" "y=2{x}^{3}+4"] ["math" "y=3{x}^{2}-1"] ["math" "y=6{x}^{3}+8"] ["math" "y={x}^{3}+3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50044" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=2{x}^{3}+4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50148" "field" nil "attribute" "question/problem" "value" "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-{e}^{3x}=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50148" "field" nil "attribute" "question/worked-solution" "value" "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={e}^{3x}.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int {e}^{3x}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{3}{e}^{3x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\frac{1}{3}{e}^{3x}+C)\\text{d}x \\\\ y & =\\frac{1}{3}\\int {e}^{3x}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =\\frac{1}{3}(\\frac{1}{3}\\,{e}^{3x})+Cx+D \\\\  & =\\frac{1}{9}{e}^{3x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50148" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/activity-metadata.json" "file_sha256" "04223ef10b67c6447620bcf1bb9502602999972046e6ef9a9f0332a81fce7f80"} {"question" "q-50148" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50148" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=-\\frac{1}{3}{e}^{3x}+Cx+D"] ["math" "y=-\\frac{1}{9}{e}^{3x}+C{x}^{2}+D"] ["math" "y=\\frac{1}{3}{e}^{3x}+Cx+D"] ["math" "y=\\frac{1}{9}{e}^{3x}+Cx+D"] ["math" "y=\\frac{1}{9}{e}^{3x}+C{x}^{2}+D"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-50148" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=\\frac{1}{9}{e}^{3x}+Cx+D"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-79565" "field" nil "attribute" "question/problem" "value" "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-79565" "field" nil "attribute" "question/worked-solution" "value" "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =2\\int x\\,\\text{d}x \\\\  & ={x}^{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/fa13b048e5ca54c7074bbf6ec11421bfd8fb9e1618abd732a5faa1d78372a863.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-79565" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/activity-metadata.json" "file_sha256" "04223ef10b67c6447620bcf1bb9502602999972046e6ef9a9f0332a81fce7f80"} {"question" "q-79565" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-79565" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/09fb3125c260d2f042ec3a509bb7e776d0d47ece3e78255931f8bc9781aa31c8.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/8ca894c5a5ca9e93af8c39242ba1584447472bb81c872e1225c52a4fbc652e1c.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/9908bd23538332705791bbd968dfdf5e22ddde8884aaa9fed58268bc1132d208.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/af10bb7e5a91561be6d83950803920c8c74aeee40f7982c0564250f707628cbb.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/ff60bb4fceb52346f5f9b4275343729a737dd52e0283beaaeb4d740e1751feca.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-79565" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/assets/af10bb7e5a91561be6d83950803920c8c74aeee40f7982c0564250f707628cbb.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-119038" "field" nil "attribute" "question/problem" "value" "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-119038" "field" nil "attribute" "question/worked-solution" "value" "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-119038" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/activity-metadata.json" "file_sha256" "04223ef10b67c6447620bcf1bb9502602999972046e6ef9a9f0332a81fce7f80"} {"question" "q-119038" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-119038" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=-4{e}^{-2x}+Cx+D"] ["math" "y=-{e}^{-2x}+C{e}^{-x}+Dx"] ["math" "y=2{e}^{-2x}+Cx+D"] ["math" "y=2{e}^{-2x}+C{e}^{-x}+D"] ["math" "y={e}^{-2x}+C{x}^{2}+Dx"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-119038" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=2{e}^{-2x}+Cx+D"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-347842" "field" nil "attribute" "question/problem" "value" "Find the particular solution to the differential equation $8x-\\frac{\\text{d}y}{\\text{d}x}={x}^{2}$ that satisfies the condition $y(2)=5.$\n\n$y=-\\frac{{x}^{3}}{3}\\,+${{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-347842" "field" nil "attribute" "question/worked-solution" "value" "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{x}^{2}+8x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-{x}^{2}+8x)\\,\\text{d}x \\\\ y & =-\\frac{{x}^{3}}{3}+8\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =-\\frac{{x}^{3}}{3}+4{x}^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-\\frac{{x}^{3}}{3}+4{x}^{2}+C.$ To find a particular solution, we substitute the condition $y(2)=5$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =-\\frac{{x}^{3}}{3}+4{x}^{2}+C \\\\ 5 & =-\\frac{{2}^{3}}{3}+4({2}^{2})+C \\\\ 5 & =-\\frac{8}{3}+16+C \\\\ 5 & =\\frac{40}{3}+C \\\\ C & =-\\frac{25}{3}.\\end{aligned}\n$$\n\nTherefore, our particular solution is \n\n$$\ny=-\\frac{{x}^{3}}{3}+4{x}^{2}-\\frac{25}{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-347842" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/activity-metadata.json" "file_sha256" "04223ef10b67c6447620bcf1bb9502602999972046e6ef9a9f0332a81fce7f80"} {"question" "q-347842" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"} {"question" "q-347842" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4x^2-\\frac{25}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057609/state.json" "file_sha256" "064ccf9080765ed9a95dca54c905e84690bfcc193708e74ccfffa76110060d1f"}] "usage" {"q-50148" [{"kind" "presentations" "entity" 17592186283218} {"kind" "responses" "entity" 17592186283218}] "q-119038" []} "basis" 1862 "retractions" [[17592186097221 :question/problem "Solve the differential equation\n\n$\\frac{d^{2}y}{dx^{2}} - e^{3x} = 0$."] [17592186097221 :question/worked-solution "The equation is $y''=e^{3x}$. Integrate twice:\n$$y'=\\frac13e^{3x}+C,\\qquad y=\\frac19e^{3x}+Cx+D.$$"]] "immutable_answers" [17592186095684 17592186095685 17592186095686 17592186095687 17592186095688 17592186310843 17592186310844 17592186310845 17592186310846 17592186310847] "immutable_fields" [[17592186095683 :answer-field/correct] [17592186095683 :answer-field/id] [17592186095683 :answer-field/key] [17592186095683 :answer-field/type] [17592186310842 :answer-field/correct] [17592186310842 :answer-field/id] [17592186310842 :answer-field/key] [17592186310842 :answer-field/type]] "no_history" []}
