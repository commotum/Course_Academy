#{[{:db/id #edb/ref 17592186310841 :knowledge-point/_questions [{:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070" :knowledge-point/title "Finding the General Solution of a Second Order Differential Equation by Integrating Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfd9fab-eee2-5452-9cef-7e428deaaf4e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186310843} {:answer/id #uuid "a5162f30-f9f8-56f0-87e3-c050745c20d2" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186310844} {:answer/id #uuid "72905702-3042-5474-a8ed-03080ecbc5a9" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-2x}+C{x}^{2}+Dx" :db/id #edb/ref 17592186310845} {:answer/id #uuid "1547bd12-2561-5d09-8e55-3a2f8e1e5a46" :answer/type {:db/ident :answer.type/math} :answer/value "y=-{e}^{-2x}+C{e}^{-x}+Dx" :db/id #edb/ref 17592186310846} {:answer/id #uuid "20516aab-1dff-53db-99bc-d2fc0df33732" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+C{e}^{-x}+D" :db/id #edb/ref 17592186310847}] :answer-field/correct {:answer/id #uuid "a5162f30-f9f8-56f0-87e3-c050745c20d2" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{-2x}+Cx+D" :db/id #edb/ref 17592186310844} :answer-field/id #uuid "fc0e6c8d-b9b0-5a01-9ad3-7b6d7b3d5bd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310842}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "795b711d-ea65-5cb8-87a2-70f0c9e6f190" :question/math-academy-id "q-119038" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$"}]}
