[{:db/id "q-7923/selection/e734b1372b024d325a80aac3ecd7ae645c2e93085a4d5628b552e32d725988c5" :answer/id #uuid "4cbb613e-6c3c-5efa-9a2f-3fff1a8a7bf8" :answer/type :answer.type/text :answer/value "$G$ only" :db/ensure [:answer/validate]} {:db/id "q-7923/selection/4b16245951e05152034db441eae824cfa95e6a93e30cd02b9a3094a035df19af" :answer/id #uuid "a7d03e0d-dd0b-5bf2-8b23-b76ba4a52cb8" :answer/type :answer.type/text :answer/value "$D$ and $F$ only" :db/ensure [:answer/validate]} {:db/id "q-7923/selection/5eaaedc1920d4a83ef5a62370e247bd8c483a4fa6f40a6c2bc1289a9fe8f4aed" :answer/id #uuid "31e64cc4-7607-5320-b4ee-b148069f834c" :answer/type :answer.type/text :answer/value "$F$ only" :db/ensure [:answer/validate]} {:db/id "q-7923/selection/60588346cbfb9849815fb5f44abf120d5eb08ea92b4b5a7cc8ea31935a20f5a5" :answer/id #uuid "11647ab9-20e9-5f5d-8ca6-1654dff9013b" :answer/type :answer.type/text :answer/value "$F$ and $G$ only" :db/ensure [:answer/validate]} {:db/id "q-7923/selection/640f70d9899672c77f8e0e95d31bc3f0b68a2ac2413007137d5a1f0c42548641" :answer/id #uuid "2bf5d5bd-33dd-5816-ab8e-7ced732d2e0a" :answer/type :answer.type/text :answer/value "$D$ and $G$ only" :db/ensure [:answer/validate]} {:db/id "q-7923/selection" :answer-field/id #uuid "5f0956b5-0f62-5fe0-afd9-ac75f12da804" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7923/selection/5eaaedc1920d4a83ef5a62370e247bd8c483a4fa6f40a6c2bc1289a9fe8f4aed" :answer-field/choices ["q-7923/selection/e734b1372b024d325a80aac3ecd7ae645c2e93085a4d5628b552e32d725988c5" "q-7923/selection/4b16245951e05152034db441eae824cfa95e6a93e30cd02b9a3094a035df19af" "q-7923/selection/5eaaedc1920d4a83ef5a62370e247bd8c483a4fa6f40a6c2bc1289a9fe8f4aed" "q-7923/selection/60588346cbfb9849815fb5f44abf120d5eb08ea92b4b5a7cc8ea31935a20f5a5" "q-7923/selection/640f70d9899672c77f8e0e95d31bc3f0b68a2ac2413007137d5a1f0c42548641"] :db/ensure [:answer-field/validate]} {:db/id "q-7923" :question/id #uuid "e1200f5c-4446-5343-a392-4a0d1b7415e1" :question/math-academy-id "q-7923" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7923/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381"] :knowledge-point/questions ["q-7923"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11726/selection/0a8fca681a0766148b3eb19d2e82ebe9998365f6743b5f55845170828471c476" :answer/id #uuid "9e763788-e014-5dfe-bb78-d0e0a7d97e3f" :answer/type :answer.type/math :answer/value "n=4" :db/ensure [:answer/validate]} {:db/id "q-11726/selection/1ffe22325d545b387ec66610fcb7718a337027c2a7022ab3cc700378cbe7a854" :answer/id #uuid "668cc876-46ae-5a7a-9648-0751b3caf48d" :answer/type :answer.type/math :answer/value "n=\\pm 2" :db/ensure [:answer/validate]} {:db/id "q-11726/selection/078aa7f9eec13f8491deb044fe9d29b7baefc8f50bd8f1ac7928ec042b84bd06" :answer/id #uuid "50067a03-1333-5bf0-a22b-1f89881465a1" :answer/type :answer.type/math :answer/value "n=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-11726/selection/523faf2ff73deb0ecf0a74de64d6a5e493898861777f7db0c262737cff204f37" :answer/id #uuid "9ba2c3f7-d9cd-5fe9-a1ed-affd720daeb3" :answer/type :answer.type/math :answer/value "n=-2" :db/ensure [:answer/validate]} {:db/id "q-11726/selection/d30fa942a867811d9394b53d6647204fc6ba92171c2a5aa02c4689a8b56834f6" :answer/id #uuid "d1a29f37-a243-5c17-a6f7-dff248983c9f" :answer/type :answer.type/math :answer/value "n=-4" :db/ensure [:answer/validate]} {:db/id "q-11726/selection" :answer-field/id #uuid "5cb2afb1-bc85-553a-b1f5-353aae32076d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11726/selection/078aa7f9eec13f8491deb044fe9d29b7baefc8f50bd8f1ac7928ec042b84bd06" :answer-field/choices ["q-11726/selection/0a8fca681a0766148b3eb19d2e82ebe9998365f6743b5f55845170828471c476" "q-11726/selection/1ffe22325d545b387ec66610fcb7718a337027c2a7022ab3cc700378cbe7a854" "q-11726/selection/078aa7f9eec13f8491deb044fe9d29b7baefc8f50bd8f1ac7928ec042b84bd06" "q-11726/selection/523faf2ff73deb0ecf0a74de64d6a5e493898861777f7db0c262737cff204f37" "q-11726/selection/d30fa942a867811d9394b53d6647204fc6ba92171c2a5aa02c4689a8b56834f6"] :db/ensure [:answer-field/validate]} {:db/id "q-11726" :question/id #uuid "e69ae315-1398-5ca6-a131-1a78b58c73a5" :question/math-academy-id "q-11726" :question/problem "If $P=[\\begin{aligned}n & -8 \\\\ -2 & n\\end{aligned}]$ is a singular matrix, calculate the value(s) of $n.$" :question/worked-solution "The matrix $P$ is singular if and only if $det(P)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(P) & =n\\cdot n-(-2)\\cdot (-8) \\\\  & ={n}^{2}-16.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $n:$\n\n$$\n\\begin{aligned}{n}^{2}-16 & =0 \\\\ {n}^{2} & =16 \\\\ n & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the values of $n$ are $n=\\pm 4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-11726"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127821/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "6f1e8475-4581-5d54-82c8-30a79f5b84c3" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-127821/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" :answer/id #uuid "2fa270f1-39b7-5559-91a0-c3ac999965f0" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "q-127821/selection/388512368289b55a28b51e3708497ef5e5ac190c8f2471d1dc0a7a7a5018616e" :answer/id #uuid "22f462bf-af92-5f66-b161-1437e27ac16d" :answer/type :answer.type/text :answer/value "$B$  and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-127821/selection/bec67fc59832fc3ca45a7c7611f69691068c79dbb6b693aec17ff2660f36490d" :answer/id #uuid "bfd23f33-7e15-58a1-8b3c-cfba4dd114bd" :answer/type :answer.type/text :answer/value "$A$  and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-127821/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "dfd5b2c0-51ad-5626-9b43-54b1a0d7fccf" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-127821/selection" :answer-field/id #uuid "cca04b2b-a4de-5524-b216-2806fb864de7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127821/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer-field/choices ["q-127821/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-127821/selection/e432f1020975ada4c83798ae75bfd6c0ae4dfe63215763f08b8be8ccabf8a5d3" "q-127821/selection/388512368289b55a28b51e3708497ef5e5ac190c8f2471d1dc0a7a7a5018616e" "q-127821/selection/bec67fc59832fc3ca45a7c7611f69691068c79dbb6b693aec17ff2660f36490d" "q-127821/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c"] :db/ensure [:answer-field/validate]} {:db/id "q-127821" :question/id #uuid "41a5decc-6a63-5e15-9219-32df767b7987" :question/math-academy-id "q-127821" :question/problem "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}],\\,B=[\\begin{aligned}-3 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ 7 & 5\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=-2\\cdot (-3)-1\\cdot 6=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $1\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 5-7\\cdot 0=5.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381"] :knowledge-point/questions ["q-127821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127901/selection/8254ac8110dcd394b8b706e8f99c770385966cba0db950b3977417dadb17f891" :answer/id #uuid "0efe0cfa-da0f-52d3-95a8-480613bdc19e" :answer/type :answer.type/math :answer/value "a=1" :db/ensure [:answer/validate]} {:db/id "q-127901/selection/0bcb21f3d78d8799a44faaab87a784784e2bc842b1e3aa226428f00add008617" :answer/id #uuid "a8f3bf97-bbd7-501a-982e-40be88e617cb" :answer/type :answer.type/math :answer/value "a=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-127901/selection/a546f710be4b21f2e7077d78c01fab0ac3b115433f37395ac6b52855c41c6f35" :answer/id #uuid "8fa8fe29-70c0-52bc-9ed1-8d885a0128bd" :answer/type :answer.type/math :answer/value "a=\\pm 12" :db/ensure [:answer/validate]} {:db/id "q-127901/selection/6b4283b0326742537aa3a5602e310f38b523d5d13f02711a1089c5799bebec1d" :answer/id #uuid "2e5aa331-8ed7-5b85-9d2e-bf04adc39ae5" :answer/type :answer.type/math :answer/value "a=\\pm 9" :db/ensure [:answer/validate]} {:db/id "q-127901/selection/bd0bab753ac2cad40ab041032aa1eaa1f406096b5c3ceed2bfbf79a9f9493d65" :answer/id #uuid "f3d62c9d-06c5-5717-842b-2ffa2f92a7d4" :answer/type :answer.type/math :answer/value "a=2" :db/ensure [:answer/validate]} {:db/id "q-127901/selection" :answer-field/id #uuid "0fa4888e-ae52-58a0-a416-fe73c97693b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127901/selection/a546f710be4b21f2e7077d78c01fab0ac3b115433f37395ac6b52855c41c6f35" :answer-field/choices ["q-127901/selection/8254ac8110dcd394b8b706e8f99c770385966cba0db950b3977417dadb17f891" "q-127901/selection/0bcb21f3d78d8799a44faaab87a784784e2bc842b1e3aa226428f00add008617" "q-127901/selection/a546f710be4b21f2e7077d78c01fab0ac3b115433f37395ac6b52855c41c6f35" "q-127901/selection/6b4283b0326742537aa3a5602e310f38b523d5d13f02711a1089c5799bebec1d" "q-127901/selection/bd0bab753ac2cad40ab041032aa1eaa1f406096b5c3ceed2bfbf79a9f9493d65"] :db/ensure [:answer-field/validate]} {:db/id "q-127901" :question/id #uuid "67bc8ab5-c4a7-53b0-b9d4-1ed70d9f6dbd" :question/math-academy-id "q-127901" :question/problem "If $A=[\\begin{aligned}48 & a \\\\ a & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $a.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127901/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-127901"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275738/field-1/04a84983d576665bfbfb320a6e35cbd365c3da4019dc70c3aa860fa57ab80c1f" :answer/id #uuid "d44a3b5c-10eb-5340-9c5e-b15d0cb24b3b" :answer/type :answer.type/math :answer/value "\\frac{9}{5}" :db/ensure [:answer/validate]} {:db/id "q-275738/field-1" :answer-field/id #uuid "219788c3-5b8c-5404-a253-21c37bcbc3cf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275738/field-1/04a84983d576665bfbfb320a6e35cbd365c3da4019dc70c3aa860fa57ab80c1f" :answer-field/choices ["q-275738/field-1/04a84983d576665bfbfb320a6e35cbd365c3da4019dc70c3aa860fa57ab80c1f"] :db/ensure [:answer-field/validate]} {:db/id "q-275738" :question/id #uuid "1001d893-ecd0-5002-87f8-aa27a5a9e78c" :question/math-academy-id "q-275738" :question/problem "If $B=[\\begin{aligned}x-5 & x+3 \\\\ 2 & -3\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(x-5)\\cdot (-3)-2\\cdot (x+3) \\\\  & =-3x+15-2x-6 \\\\  & =-5x+9.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-5x+9 & =0 \\\\ -5x & =-9 \\\\ x & =\\frac{9}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275738/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-275738"] :db/ensure [:knowledge-point/validate]}]
