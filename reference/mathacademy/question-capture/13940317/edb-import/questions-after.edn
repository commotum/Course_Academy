#{[{:db/id #edb/ref 17592186249804 :knowledge-point/_questions [{:knowledge-point/id #uuid "e37b91f0-ea0a-58b0-98d0-8f3626578dd6" :knowledge-point/title "Computing the Limit of Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87355fde-3a83-5901-b6ea-80f76125edb8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186249806}] :answer-field/correct {:answer/id #uuid "87355fde-3a83-5901-b6ea-80f76125edb8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186249806} :answer-field/id #uuid "f63c5db5-f691-540b-9e7a-8e469bf7467b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186249805}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "53d8dce8-397e-5b28-942d-ca10c6ec8958" :question/math-academy-id "q-344144" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\pi /6}\\frac{\\operatorname{cot}⁡(3x)-\\sqrt{3}}{2}=$\n{{field-1}}" :question/worked-solution "Substituting $x=\\frac{\\pi }{6}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /6}\\frac{\\operatorname{cot}⁡(3x)-\\sqrt{3}}{2} & =\\frac{\\operatorname{cot}⁡(3\\cdot \\frac{\\pi }{6})-\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cot}⁡(\\frac{\\pi }{2})-\\sqrt{3}}{2} \\\\  & =\\frac{(\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{2})}{\\operatorname{sin}⁡(\\frac{\\pi }{2})}-\\sqrt{3})}{2} \\\\  & =\\frac{(\\frac{0}{1}-\\sqrt{3})}{2} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249807 :knowledge-point/_questions [{:knowledge-point/id #uuid "e37b91f0-ea0a-58b0-98d0-8f3626578dd6" :knowledge-point/title "Computing the Limit of Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90b0c1db-1464-5b9d-bad0-871611c51628" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186249809} {:answer/id #uuid "f97217f2-5e66-58e4-910c-fbbb053d88c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249810} {:answer/id #uuid "bafa0292-1d6c-5d62-9fd2-2b50a61d6b9e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186249811} {:answer/id #uuid "31a45a7a-e3a3-5027-9f45-c40d6a03ce41" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249812} {:answer/id #uuid "2cb905d6-ee04-50d8-ae0e-e6e556d3157c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186249813}] :answer-field/correct {:answer/id #uuid "31a45a7a-e3a3-5027-9f45-c40d6a03ce41" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249812} :answer-field/id #uuid "096cbec5-fcc3-593e-afc5-bfeeb320293a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249808}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f66a0076-8574-55ea-a46f-4caf92c84b78" :question/math-academy-id "q-37290" :question/problem "Calculate ${lim}_{x\\to (\\pi /3)}({tan}^{2}⁡(x)+3{cot}^{2}⁡(x)).$" :question/worked-solution "Substituting $x=\\frac{\\pi }{3}$ directly into the limit, we have\n\n \n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /3)}({tan}^{2}⁡(x)+3{cot}^{2}⁡(x)) & ={tan}^{2}⁡(\\frac{\\pi }{3})+3{cot}^{2}⁡(\\frac{\\pi }{3}) \\\\  & ={(\\operatorname{tan}⁡(\\frac{\\pi }{3}))}^{2}+3{(\\operatorname{cot}⁡(\\frac{\\pi }{3}))}^{2} \\\\  & ={(\\sqrt{3})}^{2}+3{(\\frac{\\sqrt{3}}{3})}^{2} \\\\  & =3+3(\\frac{3}{9}) \\\\  & =3+1 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249814 :knowledge-point/_questions [{:knowledge-point/id #uuid "e37b91f0-ea0a-58b0-98d0-8f3626578dd6" :knowledge-point/title "Computing the Limit of Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a1f60af-0def-5ccf-b6e5-9b9a73c575fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186249816} {:answer/id #uuid "ad57914d-3578-5cc1-839e-47970a85f5af" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186249817} {:answer/id #uuid "4f493888-cc2b-5ce9-aa9f-04a97d836676" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249818} {:answer/id #uuid "af1fac2c-3620-5983-b1bf-b23907d5f8e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186249819} {:answer/id #uuid "118c35c4-01b9-518d-b489-1e1bd00c5418" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186249820}] :answer-field/correct {:answer/id #uuid "af1fac2c-3620-5983-b1bf-b23907d5f8e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186249819} :answer-field/id #uuid "858e1d30-0d11-5afe-a048-c186050fe839" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249815}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f27fcbd4-06f3-5af1-bede-4104ac6aed00" :question/math-academy-id "q-47039" :question/problem "Calculate ${lim}_{x\\to \\pi }\\operatorname{cot}⁡x.$" :question/worked-solution "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x) & =\\operatorname{cot}⁡(\\pi ) \\\\  & =\\frac{\\operatorname{cos}⁡\\pi }{\\operatorname{sin}⁡\\pi } \\\\  & =\\frac{-1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{cot}⁡(x).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13940317/assets/5e9d0e9d944cda9c97555ffdeac5aa245905f800cd99e11f5d172203bad3892d.png)\n\nAs $x$ approaches $\\pi $ from the left, the values of $y=\\operatorname{cot}⁡(x)$ are negative and decrease without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{-}}\\operatorname{cot}⁡(x)=-\\infty \n$$\n\nHowever, as $x$ approaches $\\pi $ from the right, the values of $y=\\operatorname{cot}⁡(x)$ are positive and grow without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{+}}\\operatorname{cot}⁡(x)=\\infty \n$$\n\nSince the two limits are not equal, we conclude that\n\n$$\n{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186249821 :knowledge-point/_questions [{:knowledge-point/id #uuid "b89b9224-71e0-5c90-8e9e-5fc3f7e29574" :knowledge-point/title "Computing the Limit of a Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e0b4a1d-4f44-5b4a-b2eb-38de754147b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186249823} {:answer/id #uuid "e286ceb9-23b7-5359-89ae-1eae4ae39369" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249824} {:answer/id #uuid "12455579-bdb0-506c-8d9d-4b95448f5856" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249825} {:answer/id #uuid "585c0b10-46ae-5a20-a402-27cd258155af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186249826} {:answer/id #uuid "3bf61c50-2bb3-5aaa-86a4-e440fcf82502" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186249827}] :answer-field/correct {:answer/id #uuid "12455579-bdb0-506c-8d9d-4b95448f5856" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249825} :answer-field/id #uuid "556fb9ed-ccb2-541d-9074-cd32681607a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249822}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a3c895b3-cff7-5d1d-ad6c-1ae205543135" :question/math-academy-id "q-65487" :question/problem "Calculate ${lim}_{x\\to \\pi }{csc}^{2}⁡(\\frac{x}{3}-\\frac{\\pi }{6}).$" :question/worked-solution "Substituting $x=\\pi $ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi }{csc}^{2}⁡(\\frac{x}{3}-\\frac{\\pi }{6}) & ={csc}^{2}⁡(\\frac{\\pi }{3}-\\frac{\\pi }{6}) \\\\  & ={csc}^{2}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{{sin}^{2}⁡(\\frac{\\pi }{6})} \\\\  & =\\frac{1}{{(\\frac{1}{2})}^{2}} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125117 :knowledge-point/_questions [{:knowledge-point/id #uuid "b89b9224-71e0-5c90-8e9e-5fc3f7e29574" :knowledge-point/title "Computing the Limit of a Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a08888e5-167a-5abe-865c-0a7774e2d28d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186123725} {:answer/id #uuid "d2e541a7-2557-5e6c-8dca-01bd2a1721fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186123726} {:answer/id #uuid "da2c3c5b-19e0-5f88-8dac-1c267d33765d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186123727} {:answer/id #uuid "501eed37-a8e5-5148-aeae-756c7b33521e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186123728} {:answer/id #uuid "50253a0f-a03f-5b7c-b7dc-afe93212b92b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186123729}] :answer-field/correct {:answer/id #uuid "501eed37-a8e5-5148-aeae-756c7b33521e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186123728} :answer-field/id #uuid "cdd14678-abd7-50f9-ab46-6681508f714c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123724}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "683cbe5d-f5f2-5d3d-bddd-bb767f5e130a" :question/math-academy-id "q-67609" :question/problem "Calculate $lim_(x → π/3)\\csc (2x)$." :question/worked-solution "Substituting $x=\\frac{\\pi }{3}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi /3}\\operatorname{csc}⁡(2x) & =\\operatorname{csc}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =\\frac{1}{\\operatorname{sin}⁡(\\frac{2\\pi }{3})} \\\\  & =\\frac{1}{(\\frac{\\sqrt{3}}{2})} \\\\  & =\\frac{2\\sqrt{3}}{3}.\\end{aligned}\n$$"}]}
