d2a847c534494f986e3832cfb56182984" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114045" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "e59e1b71ebf7bfe048ef53492dc8da7d2a847c534494f986e3832cfb56182984" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114045" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\operatorname{arctan}⁡(\\frac{x}{4})+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "e59e1b71ebf7bfe048ef53492dc8da7d2a847c534494f986e3832cfb56182984" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114057" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "e59e1b71ebf7bfe048ef53492dc8da7d2a847c534494f986e3832cfb56182984" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114057" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\text{d}x=\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $10x.$\n\nSo, let's substitute $u=10x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,⟹\\,\\text{d}x=\\frac{1}{10}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\,\\text{d}x \\\\  & =50\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{10}\\text{d}u) \\\\  & =50\\cdot \\frac{1}{10}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =5\\,\\text{arcsec }u+C \\\\  & =5\\,\\text{arcsec}(10x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "e59e1b71ebf7bfe048ef53492dc8da7d2a847c534494f986e3832cfb56182984" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114057" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95" "basis" 2451 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/edb-import/verification.json"} {"question" "q-114057" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/ref