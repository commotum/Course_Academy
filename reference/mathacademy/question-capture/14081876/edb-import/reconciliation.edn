gin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot (4\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =2\\operatorname{arctan}⁡u+C \\\\  & =2\\operatorname{arctan}⁡(\\frac{x}{4})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081876/state.json" "file_sha256" "e7bbb47845a2e23b35f5040b32279d278f6ed5a78c9f14e4c24c773a7367c5df"} {"question" "q-114045" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081876/activity-metadata.json" "file_sha256" "7d6962be85cd3228234bebdeaf5b79a516623b560a0cec1cb2afbcf673404b4f"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081876/state.json" "file_sha256" "e7bbb47845a2e23b35f5040b32279d278f6ed5a78c9f14e4c24c773a7367c5df"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arctan}⁡(4x)+C"] ["math" "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\operatorname{arctan}⁡(\\frac{x}{4})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081876/state.json" "file_sha256" "e7bbb47845a2e23b35f5040b32279d278f6ed5a78c9f14e4c24c773a7367c5df"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_A