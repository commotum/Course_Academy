0714464e59aaa398f7b5837ec7e33a45a3b884aefdc0fb7"] :db/ensure [:answer-field/validate]} {:db/id "q-114022" :question/id #uuid "06f9fcd3-7dc3-572e-aebd-f0b325ad80ff" :question/math-academy-id "q-114022" :question/problem "Calculate $\\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x & =5\\int \\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =5\\cdot \\frac{1}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(5x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114022/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839"] :knowledge-point/questions ["q-114022"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2503/selection/d4f09c7fbdb23fa1aacc21f6111fc62a644ad00def14b5ccf051b562801cacd0" :answer/id #uuid "f5a02a66-2dff-5a2e-8773-e294b5ace204" :answer/type :answer.type/math :answer/value "9\\operatorname{arcsin}⁡({x}^{2})+C" :db/ensure [:answer/validate]} {:db/id "q-2503/selection/a88a13a69cd363a58bbff2c891ca520f2a03e28ec7a4f1ee56335bfaabaa38a0" :answer/id #uuid "0660f1c2-d0eb-5695-9125-39f42f6e7a5c" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\,\\operatorname{arccos}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-2503/selection/205a0136fd2ce693fea4d4b99e76e7c853d74d480b73dd398dfd943740a48530" :answer/id #uuid "1887a276-a905-590e-8e14-81f551946c65" :answer/type :answer.type/math :answer/value "\\operatorname{arccos}⁡({x}^{2})+C" :db/ensure [:answer/validate]} {:db/id "q-2503/selection/8434eb458d7556f4d13b64284711e1453a81e465a45941451efdee1fdaa31fb8" :answer/id #uuid "a16b6838-2fd1-5879-9dc2-e9ea30ed67b9" :answer/type :answer.type/math :answer/value "9\\operatorname{arcsin}⁡(\\frac{{x}^{2}}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-2503/selection/9c0adafc0decb9c0cd05324f3897ab8d3e9fb3c2ebf44f439c74c9bffb52c7aa" :answer/id #uuid "ddb0662b-a49d-5600-b71c-7e43e29b347d" :answer/type :answer.type/math :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-2503/selection" :answer-field/id #uuid "e24e0939-48de-54b3-bcb2-b09bc3f4bf9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2503/selection/9c0adafc0decb9c0cd05324f3897ab8d3e9fb3c2ebf44f439c74c9bffb52c7aa" :answer-field/choices ["q-2503/selection/d4f09c7fbdb23fa1aacc21f6111fc62a644ad00def14b5ccf051b562801cacd0" "q-2503/selection/a88a13a69cd363a58bbff2c891ca520f2a03e28ec7a4f1ee56335bfaabaa38a0" "q-2503/selection/205a0136fd2ce693fea4d4b99e76e7c853d74d480b73dd398dfd943740a48530" "q-2503/selection/8434eb458d7556f4d13b64284711e1453a81e465a45941451efdee1fdaa31fb8" "q-2503/selection/9c0adafc0decb9c0cd05324f3897ab8d3e9fb3c2ebf44f439c74c9bffb52c7aa"] :db/ensure [:answer-field/validate]} {:db/id "q-2503" :question/id #uuid "13a78144-8a47-53f6-b98e-d8949fd04cee" :question/math-academy-id "q-2503" :question/problem "$\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{9\\cdot (1-{x}^{2}/9)}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{x}^{2}/9}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$  \n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2503/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839"] :knowledge-point/questions ["q-2503"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2506/selection/3946f99bda1f9da148e82570a61787b6decbbc13a3ac2bf4c1f50860c439662d" :answer/id #uuid "2b5806af-a54b-5964-b378-db9de23e4b3a" :answer/type :answer.type/math :answer/value "3\\operatorname{arcsin}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-2506/selection/4f0599b0940e5294795ef3d7eeaeed38caaf8259ab4309dc9e673f0df5e49560" :answer/id #uuid "7715034f-0bcf-57ea-b86a-42ada0ee1bdb" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arcsin}⁡(9x)}{9}+C" :db/ensure [:answer/validate]} {:db/id "q-2506/selection/a777df40bb904c4126091ccc0201c8d6a21f7d02da5e0ee4d3e5bf390d23cb9f" :answer/id #uuid "63a62c68-e945-5653-bda6-cd72ecec5f1c" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}{(9x)}^{2}}{9}+C" :db/ensure [:answer/validate]} {:db/id "q-2506/selection/cbfc7d753f0889293cf2c9c4cade1e1d944b7a0032669880083a79c054e3c774" :answer/id #uuid "618357c3-6896-5030-b609-1cb12d81272e" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-2506/selection/f7058ff8412dc5b3cd8451be704731ab3ed025b465d971958a9cb9a74f1f4462" :answer/id #uuid "57d553da-d2b8-5f13-9084-52e8376313ed" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(3x)}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-2506/selection" :answer-field/id #uuid "c144ee9b-b3a5-53ff-bfbb-6f2c6da31853" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2506/selection/cbfc7d753f0889293cf2c9c4cade1e1d944b7a0032669880083a79c054e3c774" :answer-field/choices ["q-2506/selection/3946f99bda1f9da148e82570a61787b6decbbc13a3ac2bf4c1f50860c439662d" "q-2506/selection/4f0599b0940e5294795ef3d7eeaeed38caaf8259ab4309dc9e673f0df5e49560" "q-2506/selection/a777df40bb904c4126091ccc0201c8d6a21f7d02da5e0ee4d3e5bf390d23cb9f" "q-2506/selection/cbfc7d753f0889293cf2c9c4cade1e1d944b7a0032669880083a79c054e3c774" "q-2506/selection/f7058ff8412dc5b3cd8451be704731ab3ed025b465d971958a9cb9a74f1f4462"] :db/ensure [:answer-field/validate]} {:db/id "q-2506" :question/id #uuid "eb831ed0-a0b3-5c25-b9f6-fd4d203c7534" :question/math-academy-id "q-2506" :question/problem "$\\int \\frac{1}{\\sqrt{1-9{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{1-9{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(3x)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2506/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839"] :knowledge-point/questions ["q-2506"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114040/selection/3f6a5682b3c03dce59da9a974a45b644ea48b4a6b055baaa4ff330a1fa27a654" :answer/id #uuid "a461745c-9638-59d6-b368-b38c74fd7f43" :answer/type :answer.type/math :answer/value "2\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114040/selection/5a863e59af171b73264019b1ae391d3cd6cce5ef5c252818da5427f4a116b428" :answer/id #uuid "26a88651-da37-5bd5-8a7f-6468439454b2" :answer/type :answer.type/math :answer/value "4\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114040/selection/ad673bb665323e72b63ee12e985329643cadbda7a3671a40350f1d851971faae" :answer/id #uuid "cb4b52ef-dbc9-5fde-babe-9d7af5ad8ef2" :answer/type :answer.type/math :answer/value "2\\sqrt{2}\\operatorname{arctan}⁡(2x)+C" :db/ensure [:answer/validate]} {:db/id "q-114040/selection/ef5d9593221812647fbc45d1d3da098f9d387a435caa06019eced512fc270b0a" :answer/id #uuid "b280bf1a-b822-5709-93fe-2bfb49990147" :answer/type :answer.type/math :answer/value "2\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114040/selection/692e7cc14389e04cbdf507dc48b3e00a5efe8462920e0006a940be6ecfd75e23" :answer/id #uuid "8a5abfc8-8a22-5b8d-8d5b-c57656508aff" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/ensure [:answer/validate]} {:db/id "q-114040/selection" :answer-field/id #uuid "ffb5dfc8-bb57-53c4-a17e-c885d65c750f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114040/selection/3f6a5682b3c03dce59da9a974a45b644ea48b4a6b055baaa4ff330a1fa27a654" :answer-field/choices ["q-114040/selection/3f6a5682b3c03dce59da9a974a45b644ea48b4a6b055baaa4ff330a1fa27a654" "q-114040/selection/5a863e59af171b73264019b1ae391d3cd6cce5ef5c252818da5427f4a116b428" "q-114040/selection/ad673bb665323e72b63ee12e985329643cadbda7a3671a40350f1d851971faae" "q-114040/selection/ef5d9593221812647fbc45d1d3da098f9d387a435caa06019eced512fc270b0a" "q-114040/selection/692e7cc14389e04cbdf507dc48b3e00a5efe8462920e0006a940be6ecfd75e23"] :db/ensure [:answer-field/validate]} {:db/id "q-114040" :question/id #uuid "6375a1b5-3a33-5c03-9588-226ce6ea4b45" :question/math-academy-id "q-114040" :question/problem "Calculate $\\int \\frac{4}{1+2{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\sqrt{2}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{1+2{x}^{2}}\\,\\text{d}x & =4\\int \\frac{1}{1+(\\sqrt{2}x)^{2}}\\text{d}x \\\\  & =4\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\frac{4}{\\sqrt{2}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{4\\sqrt{2}}{2}\\operatorname{arctan}⁡u+C \\\\  & =2\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114040/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-114040"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186064862 :question/answer-fields 17592186063681] {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/4ec39a55273a2be2bd6404ccf03402fee4c2ff53467af844d2502c97f3c41bb0" :answer/id #uuid "417d2e37-50c5-52be-9ad1-5ef3e29ccce1" :answer/type :answer.type/math :answer/value "\\,\\text{arcsec}(2x)+C" :db/ensure [:answer/validate]} {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/c4173e53b7121b783770606d2c4d3a9318c06e4e2b936ca63ef1811e4764208f" :answer/id #uuid "adfa7cbb-3632-5bfd-a770-50e138685353" :answer/type :answer.type/math :answer/value "2\\,\\text{arcsec}(2x)+C" :db/ensure [:answer/validate]} {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/f969989fdca7b84acb349d507e0d0e6fd197981f7405d56c10a1ebaa3618c321" :answer/id #uuid "e5252e92-3b1d-558d-bb0d-d4d6274ce2b2" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(2x)}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/b52e6508d394072ffdb241f44a82704d8485b171cac56199cd4aea7d97a29a91" :answer/id #uuid "7a1c4a5f-6d2e-5d31-836d-60701da6335c" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/bf6f288912bcb4970bdd176b127840ce8e496ad75eed714614e4df0db61bf331" :answer/id #uuid "47b970bf-19f3-560a-a661-9ab7e4b348a8" :answer/type :answer.type/math :answer/value "4\\,\\text{arcsec}(2x)+C" :db/ensure [:answer/validate]} {:db/id "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab" :answer-field/id #uuid "ccea3ab5-dbe8-57dd-8d1a-cb5f656a1000" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/c4173e53b7121b783770606d2c4d3a9318c06e4e2b936ca63ef1811e4764208f" :answer-field/choices ["q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/4ec39a55273a2be2bd6404ccf03402fee4c2ff53467af844d2502c97f3c41bb0" "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/c4173e53b7121b783770606d2c4d3a9318c06e4e2b936ca63ef1811e4764208f" "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/f969989fdca7b84acb349d507e0d0e6fd197981f7405d56c10a1ebaa3618c321" "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/b52e6508d394072ffdb241f44a82704d8485b171cac56199cd4aea7d97a29a91" "q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab/bf6f288912bcb4970bdd176b127840ce8e496ad75eed714614e4df0db61bf331"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-73717"] :question/problem "$\\int \\frac{2}{|x|\\sqrt{4{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{2\\,\\text{d}x}{|x|\\sqrt{4{x}^{2}-1}}=4\\int \\frac{\\text{d}x}{|2x|\\sqrt{(2x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $2x.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{|x|\\sqrt{4{x}^{2}-1}}\\,\\text{d}x & =4\\int \\frac{1}{|2x|\\sqrt{(2x)^{2}-1}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =2\\,\\text{arcsec}\\,u+C \\\\  & =2\\,\\text{arcsec}(2x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73717/selection/ma-v1/7a7baa0c528d4ac911850435dfa564b386581feba4bf10560b0b9bcd5d5f2cab"] :db/ensure [:question/validate]} {:db/id "q-73716/selection/d5dce8752bc5bf6bb76be1b0bdb95720c80f3b77cdf9cce4d09d26c692abb181" :answer/id #uuid "87783ba2-ad71-57f6-97d5-099f53e852fd" :answer/type :answer.type/math :answer/value "\\frac{\\text{arcsec}(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-73716/selection/5f6d8e6755d5a2767de674458f7bc45fecd7ab668cde05e2ac3c7f512ed5b677" :answer/id #uuid "c90e8996-3291-5ba2-b5bb-ff027d2b9d28" :answer/type :answer.type/math :answer/value "\\frac{\\text{arctan}(4x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-73716/selection/d84863d5b745c76cbc50873ef2fe9b9e3660c2f75693c85205c7e04752f24df5" :answer/id #uuid "92756af3-6868-530a-86d9-3b1011028b96" :answer/type :answer.type/math :answer/value "\\text{arcsec}(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-73716/selection/1d0d58978ce4e1a480d1a0d2a1381ca22aa729d92b322d2d51d47e9a5d66b245" :answer/id #uuid "6c946414-264f-5cf9-b85b-307fc9c6bab9" :answer/type :answer.type/math :answer/value "\\text{arctan}(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-73716/selection/0c1b03353c5742f3252b175bf501ebbb52ec1cf6b5d4a05105024e4351d5914a" :answer/id #uuid "8d6518f1-2301-511d-9e0c-2223747ee291" :answer/type :answer.type/math :answer/value "4\\,\\text{arcsec}(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-73716/selection" :answer-field/id #uuid "016f400f-b7c8-5922-b075-a95bd1523f58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73716/selection/d5dce8752bc5bf6bb7