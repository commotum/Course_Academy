y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{3}{2}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266820 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc888568-12f2-55f5-8cc9-533dd4220c7b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186266822} {:answer/id #uuid "18220b29-6dc6-5731-9065-7672676d1018" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266823} {:answer/id #uuid "ce0a65ad-fef1-58a8-841c-b6f690a46ef3" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},0)" :db/id #edb/ref 17592186266824} {:answer/id #uuid "7fc77981-422e-5f9e-8088-dac591901b2d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186266825} {:answer/id #uuid "2d5e623c-58e9-57c5-bfac-8965c84d8dca" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186266826}] :answer-field/correct {:answer/id #uuid "18220b29-6dc6-5731-9065-7672676d1018" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266823} :answer-field/id #uuid "609f0fdc-e2ee-52a7-b5a9-4e4cbd6ca8bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266821}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7b2e900c-638c-5274-9e3e-d1fc3bede822" :question/math-academy-id "q-115905" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=2x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(\\frac{1}{2})x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{1}{2}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266827 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aedf82a-c38c-5adf-bd3f-eece000750ea" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266829} {:answer/id #uuid "6d9a5cd6-eca8-5548-94be-60a2a3ca8e5a" :answer/type {:db/ident :answer.type/math} :answer/value "(-12,0)" :db/id #edb/ref 17592186266830} {:answer/id #uuid "aadef980-bc9e-50d2-aa1c-df6bb6cce3d8" :answer/type {:db/ident :answer.type/math} :answer/value "(0,12)" :db/id #edb/ref 17592186266831} {:answer/id #uuid "b709c0ff-8419-51c1-a769-225fcbdaea51" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186266832} {:answer/id #uuid "f57b15ae-c201-51f2-a3b1-6ee8897eeca1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186266833}] :answer-field/correct {:answer/id #uuid "4aedf82a-c38c-5adf-bd3f-eece000750ea" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266829} :answer-field/id #uuid "0aa28e89-670d-5265-b7e6-5df3e56d8b37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266828}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "334be10e-93a9-566b-9a5f-562bba5bdcbc" :question/math-academy-id "q-115906" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-12x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(-3)x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-3.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266834 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cf5d028-9038-571d-b59f-75dcc853c909" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-7)" :db/id #edb/ref 17592186266836} {:answer/id #uuid "11402634-1122-5f5b-8f6e-65162370a1e3" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186266837} {:answer/id #uuid "8620cb5a-7d0a-5695-9c8f-6a8282770b65" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-1)" :db/id #edb/ref 17592186266838} {:answer/id #uuid "c60ed7f0-d63d-5021-8655-c5b7ffb1f385" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,5)" :db/id #edb/ref 17592186266839} {:answer/id #uuid "dca086ff-69da-5e78-a1d1-83c8d57dec4b" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,1)" :db/id #edb/ref 17592186266840}] :answer-field/correct {:answer/id #uuid "dca086ff-69da-5e78-a1d1-83c8d57dec4b" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,1)" :db/id #edb/ref 17592186266840} :answer-field/id #uuid "eb73e947-6dd7-5bbe-a7a4-6bb742b806aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266835}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54f31e5f-ca52-50c1-8543-926149d04961" :question/math-academy-id "q-115911" :question/problem "What are the coordinates of the vertex of the parabola $(y-1)^{2}=5(x+7)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-1)^{2}=4(\\frac{5}{4})(x+7).\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=-7$ and $k=1.$ Therefore, the coordinates of the vertex of the parabola are $(-7,1).$"}] [{:db/id #edb/ref 17592186266841 :knowledge-point/_questions [{:knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30b3578d-cbd3-57ed-857a-806fac16aacf" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266843} {:answer/id #uuid "fc8ec65c-c534-5873-ac90-ec84ed545d04" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186266844} {:answer/id #uuid "9e5a6fb0-c246-5880-bfa2-53a8f5031ed4" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186266845} {:answer/id #uuid "f3340c04-9af4-51e4-9ecd-ab97fce3f879" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186266846} {:answer/id #uuid "67261f7d-0f60-518f-93e3-bdd1c315bfe0" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186266847}] :answer-field/correct {:answer/id #uuid "f3340c04-9af4-51e4-9ecd-ab97fce3f879" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186266846} :answer-field/id #uuid "741d6166-a174-5d8a-a55d-1304ee4195d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266842}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4aa7ced4-8469-5160-ad25-977c6875bebf" :question/math-academy-id "q-11854" :question/probl