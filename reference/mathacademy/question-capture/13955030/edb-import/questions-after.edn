)" :db/id #edb/ref 17592186266881} {:answer/id #uuid "97235930-eabd-520b-b7ae-4e1a5c5a811c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186266882}] :answer-field/correct {:answer/id #uuid "213a38cb-3cbd-5fc4-b6a7-1d4545bcbe68" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266878} :answer-field/id #uuid "a1eba0f3-8058-51d5-b9fb-50cdb5fec425" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266877}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c6d83e3b-2bd8-550b-8a90-d2ec25fc6c12" :question/math-academy-id "q-84953" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=-2y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(-\\frac{1}{2})y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{2}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266883 :knowledge-point/_questions [{:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5d34753-16f4-5649-9570-16e494380b24" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266885} {:answer/id #uuid "7cf7586c-37f1-5d9e-abed-91820a9ab0b0" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{5}{4})" :db/id #edb/ref 17592186266886} {:answer/id #uuid "a415f26a-1873-5c52-9ca8-259c714cbbb1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186266887} {:answer/id #uuid "a572ca12-bcaa-599e-859d-c494309cabbe" :answer/type {:db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186266888} {:answer/id #uuid "498d5b6d-d8f6-552f-8570-a96aec38b43b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{4},0)" :db/id #edb/ref 17592186266889}] :answer-field/correct {:answer/id #uuid "f5d34753-16f4-5649-9570-16e494380b24" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266885} :answer-field/id #uuid "4f41ef2c-7d5a-5520-9384-4644a41b87c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266884}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b172b8b6-92b6-5fd0-9be7-d17e30aac693" :question/math-academy-id "q-84954" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(\\frac{5}{4})y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266890 :knowledge-point/_questions [{:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81b0ac2e-52b3-52d4-b3f1-bdc48408a839" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186266892} {:answer/id #uuid "1220db06-8d55-5b45-8633-63d8ae70b3cd" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,5)" :db/id #edb/ref 17592186266893} {:answer/id #uuid "a7c44f30-c266-57dd-bb4e-20ca1fa83ae3" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186266894} {:answer/id #uuid "3a29c26b-836e-511e-a859-21a2f25b4026" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186266895} {:answer/id #uuid "f838df5b-e3bf-5ad8-897a-6c111f31ec56" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186266896}] :answer-field/correct {:answer/id #uuid "f838df5b-e3bf-5ad8-897a-6c111f31ec56" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186266896} :answer-field/id #uuid "ea0c984f-1559-55b4-ab38-a1c99e8ce31e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266891}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c9132494-7cb8-59b9-b0de-5a5009a5a6e9" :question/math-academy-id "q-84967" :question/problem "What are the coordinates of the vertex of the parabola $(x+3)^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+3)^{2} & =4(\\frac{5}{4})(y-0).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-3$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(-3,0).$"}] [{:db/id #edb/ref 17592186266897 :knowledge-point/_questions [{:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfca2a1d-c375-57b9-af7f-7eea800c0157" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186266899} {:answer/id #uuid "9b8d703f-e30f-5f34-a218-af1d5157b069" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186266900} {:answer/id #uuid "db192c92-67d2-51f1-aa9b-535e98b7677f" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,2)" :db/id #edb/ref 17592186266901} {:answer/id #uuid "f5acf892-baab-5d1c-ba16-76d71522f4c5" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-4)" :db/id #edb/ref 17592186266902} {:answer/id #uuid "74eb7668-6995-5ff1-80f4-fb0a5db976ba" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186266903}] :answer-field/correct {:answer/id #uuid "74eb7668-6995-5ff1-80f4-fb0a5db976ba" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186266903} :answer-field/id #uuid "ad007a6e-ca36-586d-a2f2-831f6541e6f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266898}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f18008ac-3228-5419-b034-8362f0ce4f60" :question/math-academy-id "q-84969" :question/problem "What are the coordinates of the vertex of the parabola $(x-1)^{2}=2(y-4)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-1)^{2} & =4(\\frac{1}{2})(y-4).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{1}{2}.$\n\nComparing our equation with the standard equation, we can see that we have $h=1$ and $k=4.$ Therefore, the coordinates of the vertex of the parabola are $(1,4).$"}] [{:db/id #edb/ref 17592186266904 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c878b45-38de-5400-884f-bac1a0b99b26" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266906} {:answer/id #uuid "b4095be9-2a16-5646-99f9-62fb7125ab07" :answer/type {:db/ident :answer.type/math} :answer/value "(2,8)" :db/id #edb/ref 17592186266907} {:answer/id #uuid "b96d2121-3a86-565b-98bf-a9e938357782" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186266908} {:answer/id #uuid "d6e6dd79-bfc8-5d67-8bf5-4d32d2000f1e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186266909} {:answer/id #uuid "7ca19518-9fbf-5267-b10e-98b8a7ad6cbb" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186266910}] :answer-field/correct {:answer/id #uuid "5c878b45-38de-5400-884f-bac1a0b99b26" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186266906} :answer-field/id #uuid "6cf08cdd-6125-5c43-bf2c-f97b8079f6db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266905}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "df4b219d-6d3b-5962-9fe7-2faeb256f449" :question/math-academy-id "q-84975" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-8x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(-2)x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-2.$ Therefore, our parabola has its vertex at $(0,0).$"}] [{:db/id #edb/ref 17592186266911 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88af0ed0-b19d-5778-ab46-7437e083a39b" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-1)" :db/id #edb/ref 17592186266913} {:answer/id #uuid "f9ae16f2-1e34-5c58-a298-c71ff6658003" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4)" :db/id #edb/ref 17592186266914} {:answer/id #uuid "8c00fe3d-3862-54e1-a813-ff5bb0d27f69" :answer/type {:db/ident :answer.type/math} :answer/value "(1,4)" :db/id #edb/ref 17592186266915} {:answer/id #uuid "9001912b-0453-553f-89ec-4ea7eacf1f27" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186266916} {:answer/id #uuid "f88797c2-d2bd-5ad9-a27d-e24e88350400" :answer/type {:db/ident :answer.type/math} :answer/value "(4,1)" :db/id #edb/ref 17592186266917}] :answer-field/correct {:answer/id #uuid "9001912b-0453-553f-89ec-4ea7eacf1f27" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186266916} :answer-field/id #uuid "1fcf76fb-c7fc-51ef-bf03-829087d81bbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266912}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4b89da5-7c8a-5c91-bc44-a0bbe206e201" :question/math-academy-id "q-84977" :question/problem "What are the coordinates of the vertex of the parabola $(y-4)^{2}=-3(x+1)?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-4)^{2}=4(-\\frac{3}{4})(x+1).\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{4}.$ \n\nComparing our equation with the standard equation, we can see that we have $h=-1$ and $k=4.$ Therefore, the coordinates of the vertex of the parabola are $(-1,4).$"}]}
