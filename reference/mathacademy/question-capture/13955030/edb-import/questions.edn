#{[{:db/id #edb/ref 17592186096432 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/id #uuid "31dd152b-cab9-5754-9335-42ed830d3c01" :question/math-academy-id "e-5343" :question/problem "What are the coordinates of the vertex of the parabola shown below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/1128/Source/Images/c32556a1750c2646553f1d651cf80276.png)" :question/worked-solution "The vertex of a right-opening parabola is the left-most point of the parabola.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1128/Source/Images/bb5ca8660686588f12b07d7637e89213.png)\n\nTherefore, the coordinates of the vertex are $(-4,2)$."}] [{:db/id #edb/ref 17592186096489 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d27b85e4-ddae-5b5f-965a-5dff51b8449b" :knowledge-point/title "Identifying the Vertex of a Vertical Parabola Given Its Graph"}] :question/id #uuid "34e8e4aa-b8c8-518d-857a-42ac8f7345b9" :question/math-academy-id "e-7472" :question/problem "What is the vertex of the parabola shown below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/1128/Source/Images/cd3c7bdba2479509b9cd04f3d8878921.png)" :question/worked-solution "The vertex of a downward-opening parabola is the highest point of the parabola.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1128/Source/Images/a2e288f321fbccaef999b7c00983f4af.png)\n\nTherefore, the coordinates of the vertex are $(4,3)$."}] [{:db/id #edb/ref 17592186096490 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a" :knowledge-point/title "Stating the Vertex of a Vertical Parabola Given Its Equation in Standard Form"}] :question/id #uuid "40e08a6f-a312-5f00-8b4a-e5fe8fe3cefb" :question/math-academy-id "e-7475" :question/problem "What are the coordinates of the vertex of the parabola $(x+1)^2=8(y-2)$?" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k)\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}\n(x + 1)^{2} &= 4(2)(y - 2)\n\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p =2$.\n\nComparing our equation with the standard equation, we can see that we have $h= -1$ and $k=2$. Therefore, the coordinates of the vertex of the parabola are $(-1,2)$."}] [{:db/id #edb/ref 17592186096491 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c" :knowledge-point/title "Stating the Vertex of a Horizontal Parabola Given Its Equation in Standard Form"}] :question/id #uuid "258f64db-05c1-5314-a6d8-aa2f604f5c95" :question/math-academy-id "e-7476" :question/problem "What are the coordinates of the vertex of the parabola $(y-2)^2=2(x+1)$?" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h)\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as\n\n$$\n(y-2)^2 = 4\\left(\\dfrac{2}{4}\\right)(x +1)\n$$\n\nwhich simplifies to\n\n$$\n(y-2)^2 = 4\\left(\\dfrac{1}{2}\\right)(x +1)\n$$\n\nIt is now clear that our equation is of the standard type with\n\n$$\np=\\dfrac{1}{2}\n$$\n\nComparing our equation with the standard equation, we can see that we have $h=-1$ and $k=2$. Therefore, the coordinates of the vertex of the parabola are\n\n$$\n\\left(-1,2\\right)\n$$"}] [{:db/id #edb/ref 17592186096934 :knowledge-point/_questions [{:knowledge-point/id #uuid "d27b85e4-ddae-5b5f-965a-5dff51b8449b" :knowledge-point/title "Identifying the Vertex of a Vertical Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1e9a949-cfdc-5169-8e38-ef4455917ae1" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-3)" :db/id #edb/ref 17592186094011} {:answer/id #uuid "c0e7b966-efa7-5261-a826-fc489bccd090" :answer/type {:db/ident :answer.type/math} :answer/value "(6, 6)" :db/id #edb/ref 17592186094012} {:answer/id #uuid "1dbeaf52-9d1f-5bb0-a5eb-98633fadd163" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-6)" :db/id #edb/ref 17592186094013} {:answer/id #uuid "2f79f99d-d153-58c8-b688-98be1a517ab6" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-2)" :db/id #edb/ref 17592186094014} {:answer/id #uuid "376db3f0-03ff-558b-801b-746c2068a421" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-6)" :db/id #edb/ref 17592186094015}] :answer-field/correct {:answer/id #uuid "376db3f0-03ff-558b-801b-746c2068a421" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-6)" :db/id #edb/ref 17592186094015} :answer-field/id #uuid "095c92ea-39aa-5444-b3dd-ce01698ac750" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094010}] :question/id #uuid "3d302ba9-8f9f-5fe2-8a0d-8b672417d6d5" :question/math-academy-id "q-11870" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1128/Source/Images/q-11870.png)\n\nWhat is the vertex of the parabola shown above?"}]}
