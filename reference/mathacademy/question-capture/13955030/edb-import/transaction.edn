q-84967/selection/8fbd2d3f8fec30b8988b313ab55584eaf14bae431349fa2771dc259291903d20" "q-84967/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" "q-84967/selection/94aa507eeceffcdf0395127f3b0d8eb69718e22da6834ec0a95c67cf83eb0344" "q-84967/selection/f30fb0f59fafb6752d784950cc322d7f2032f94280c61093320bd35b48f74686" "q-84967/selection/f3b15f9080639a787097d8b780ade7100103852ae38e37130300d2afcd5c2f1d"] :db/ensure [:answer-field/validate]} {:db/id "q-84967" :question/id #uuid "c9132494-7cb8-59b9-b0de-5a5009a5a6e9" :question/math-academy-id "q-84967" :question/problem "What are the coordinates of the vertex of the parabola $(x+3)^{2}=5y?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x+3)^{2} & =4(\\frac{5}{4})(y-0).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=\\frac{5}{4}.$\n\nComparing our equation with the standard equation, we can see that we have $h=-3$ and $k=0.$ Therefore, the coordinates of the vertex of the parabola are $(-3,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84967/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a"] :knowledge-point/questions ["q-84967"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115898/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :answer/id #uuid "2a561b51-952b-50f4-b2ca-e91dcd5af55d" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "q-115898/selection/5b263d1ec2eefc0f1f946d1934d5550e9bc69dba58a9bac2f12054f8facba8b0" :answer/id #uuid "e23a7290-b4f0-5c31-b77e-cec289443ae3" :answer/type :answer.type/math :answer/value "(0,6)" :db/ensure [:answer/validate]} {:db/id "q-115898/selection/24b42