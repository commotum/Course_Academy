  "html": "<div id=\"step-e5343\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Identifying the Vertex of a Horizontal Parabola Given Its Graph</div>       \n                        <div class=\"helpButton\" stepid=\"e5343\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>What are the coordinates of the vertex of the parabola shown below?</p>\n<div id=\"graphic-c32556a1750c2646553f1d651cf80276\" class=\"graphic\"><img src=\"/graphics/c32556a1750c2646553f1d651cf80276\"></div>  \n\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                         