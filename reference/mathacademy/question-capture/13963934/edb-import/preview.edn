33960 true] [17592186268970 1000 #edb/ref 17592186268974 13194139533960 true] [17592186268970 1000 #edb/ref 17592186268975 13194139533960 true] [17592186268970 1040 #edb/ref 17592186045450 13194139533960 true] [17592186268970 1041 "selection" 13194139533960 true] [17592186268970 1104 #edb/ref 17592186268971 13194139533960 true] [17592186268970 1110 #uuid "018f506c-4a97-5133-9ae2-7b60a3495771" 13194139533960 true] [17592186268971 1034 "\\operatorname{ln}⁡|{x}^{2}+2x|+C" 13194139533960 true] [17592186268971 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268971 1111 #uuid "15b17e22-7cf6-5918-8333-cd934d44a4f9" 13194139533960 true] [17592186268972 1034 "\\frac{\\operatorname{ln}⁡|{x}^{2}+2x|}{2x+2}+C" 13194139533960 true] [17592186268972 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268972 1111 #uuid "2d9e9546-5757-5cd8-ad14-2f0e74d6b34c" 13194139533960 true] [17592186268973 1034 "\\operatorname{ln}⁡|\\frac{2x+2}{{x}^{2}+2x}|+C" 13194139533960 true] [17592186268973 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268973 1111 #uuid "3372881b-89f6-56b1-b998-feda0cdb84a7" 13194139533960 true] [17592186268974 1034 "\\operatorname{ln}⁡|2x+2|+C" 13194139533960 true] [17592186268974 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268974 1111 #uuid "a6eb9d72-35df-55dc-b60c-308e6c232a23" 13194139533960 true] [17592186268975 1034 "\\operatorname{ln}⁡|\\frac{{x}^{2}+2x}{2x+2}|+C" 13194139533960 true] [17592186268975 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268975 1111 #uuid "b32343a6-6925-5309-bf35-5889a7bf6208" 13194139533960 true] [17592186268976 1017 #edb/ref 17592186268977 13194139533960 true] [17592186268976 1089 "q-113728" 13194139533960 true] [17592186268976 1091 #edb/ref 17592186045464 13194139533960 true] [17592186268976 1100 "$\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x=$" 13194139533960 true] [17592186268976 1113 #uuid "ce8c32d3-4826-5698-9579-504253d6428c" 13194139533960 true] [17592186268976 1145 "Let $u=1-{x}^{3}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}\\,⟹\\,(-\\frac{2}{3})\\text{d}u=2{x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot 2{x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{2}{3})\\text{d}u \\\\  & =-\\frac{2}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{2}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{4}{3}\\sqrt{u}+C \\\\  & =-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$" 13194139533960 true] [17592186268977 1000 #edb/ref 17592186268978 13194139533960 true] [17592186268977 1000 #edb/ref 17592186268979 13194139533960 true] [17592186268977 1000 #edb/ref 17592186268980 13194139533960 true] [17592186268977 1000 #edb/ref 17592186268981 13194139533960 true] [17592186268977 1000 #edb/ref 17592186268982 13194139533960 true] [17592186268977 1040 #edb/ref 17592186045450 13194139533960 true] [17592186268977 1041 "selection" 13194139533960 true] [17592186268977 1104 #edb/ref 17592186268982 13194139533960 true] [17592186268977 1110 #uuid "a1f40447-403f-503a-a049-4b564230ebc8" 13194139533960 true] [17592186268978 1034 "\\frac{3}{4\\sqrt{1-{x}^{3}}}+C" 13194139533960 true] [17592186268978 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268978 1111 #uuid "b0ae7f17-4665-5b22-ab29-6e4a7150c1b9" 13194139533960 true] [17592186268979 1034 "\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" 13194139533960 true] [17592186268979 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268979 1111 #uuid "029048c7-a423-5e94-a44b-76d56138f85c" 13194139533960 true] [17592186268980 1034 "-\\frac{3}{2}\\sqrt{1-{x}^{3}}+C" 13194139533960 true] [17592186268980 1103 #edb/ref 17592186045453 13194139533960 true] [17592186268980 1111 #uuid "1568e3a3-8a54-555b-a38f-18896009ce50" 13194139533960 true] [17592186268981 1034 "-\\frac{2}{3\\sqrt{1-{x}^{3}}}+C" 13194139533960 true] [17592186268981