[{:db/id "q-49634/selection/114e8ca0e4865ae2516f4efba5cd9f10a950445f659da889c969118cb090a72c" :answer/id #uuid "18bcd067-458a-5305-b90d-dd6c68008692" :answer/type :answer.type/math :answer/value "\\frac{3}{2\\sqrt{{x}^{2}+1}}+C" :db/ensure [:answer/validate]} {:db/id "q-49634/selection/ce6e80f49bfc1b745b51293da0d8a9e5a5e8b41b2c3a3edde859897e66951e13" :answer/id #uuid "48da8709-c85b-5eae-b6c6-7080f55cd11f" :answer/type :answer.type/math :answer/value "\\sqrt{{x}^{2}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49634/selection/649fb0db03181d32a2d96a5671c3a2e8e8bc00f99528f48d325fb7d9925a6972" :answer/id #uuid "709e06d2-1501-5113-9438-edfe90c4eedf" :answer/type :answer.type/math :answer/value "3\\sqrt{{x}^{2}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49634/selection/e274ea7b787634114c2893209e321ddd92a54937ccb7e3cff0b1d44569a3a11c" :answer/id #uuid "35aa26a7-5a1d-5137-b1bb-66a9e9e32ed4" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\sqrt{{x}^{2}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49634/selection/bfbeab0385e5740d79fb8dc26c6d5e2797e374c1262dc4399507f5c0ad23979f" :answer/id #uuid "b4102607-6320-573a-b348-98a4a6ccf0a2" :answer/type :answer.type/math :answer/value "\\frac{3}{\\sqrt{{x}^{2}+1}}+C" :db/ensure [:answer/validate]} {:db/id "q-49634/selection" :answer-field/id #uuid "f6052538-781d-50f2-a58d-645aa08dd652" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49634/selection/649fb0db03181d32a2d96a5671c3a2e8e8bc00f99528f48d325fb7d9925a6972" :answer-field/choices ["q-49634/selection/114e8ca0e4865ae2516f4efba5cd9f10a950445f659da889c969118cb090a72c" "q-49634/selection/ce6e80f49bfc1b745b51293da0d8a9e5a5e8b41b2c3a3edde859897e66951e13" "q-49634/selection/649fb0db03181d32a2d96a5671c3a2e8e8bc00f99528f48d325fb7d9925a6972" "q-49634/selection/e274ea7b787634114c2893209e321ddd92a54937ccb7e3cff0b1d44569a3a11c" "q-49634/selection/bfbeab0385e5740d79fb8dc26c6d5e2797e374c1262dc4399507f5c0ad23979f"] :db/ensure [:answer-field/validate]} {:db/id "q-49634" :question/id #uuid "2800347c-bd4c-5798-aee5-e97a7b63541a" :question/math-academy-id "q-49634" :question/problem "Calculate $\\int \\frac{3x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\cdot x\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\frac{3}{2}(2\\sqrt{u})+C \\\\  & =3\\sqrt{u}+C \\\\  & =3\\sqrt{{x}^{2}+1}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49634/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-49634"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113710/selection/d06579998c056d82b221a43ddd2586a5ddf1814cf83a1e421d0864e7ca96efd2" :answer/id #uuid "4a8e858a-7e8d-5fc6-aa40-2d8012351a68" :answer/type :answer.type/math :answer/value "2(4+{x}^{6})^{6}+C" :db/ensure [:answer/validate]} {:db/id "q-113710/selection/f1334f0bb6ebbc309120a532120d8a44ed1d6edbd1a2c338a122899187579d89" :answer/id #uuid "c6ae30d9-7cf0-5bbc-9cce-34b1f60a5d48" :answer/type :answer.type/math :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/ensure [:answer/validate]} {:db/id "q-113710/selection/65cb1f669916fa528ea4aff6c7de0955a75e64cf2eb86f27e262807570fcb847" :answer/id #uuid "97f26a1a-dbba-5ae4-abe4-fc47c8b881f0" :answer/type :answer.type/math :answer/value "\\frac{(4+{x}^{6})^{6}}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-113710/selection/1c02287ae9f0ff8974d544b5d5b94fd6e42e2a4662d36b833b061cfe54d8ed11" :answer/id #uuid "5a8d4332-8dbf-5542-a0c0-82fa609bfc53" :answer/type :answer.type/math :answer/value "\\frac{(4+{x}^{6})^{6}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113710/selection/4d3fbfc81962a167ceb48e4beb06954eeb94e4896fc5aa2d4d3d86ea43afba36" :answer/id #uuid "c6b5d3eb-3155-5749-9696-bd907c5f7669" :answer/type :answer.type/math :answer/value "\\frac{(4+{x}^{6})^{6}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113710/selection" :answer-field/id #uuid "4f57bef0-f08a-512a-8737-1cecc5e6aa04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113710/selection/f1334f0bb6ebbc309120a532120d8a44ed1d6edbd1a2c338a122899187579d89" :answer-field/choices ["q-113710/selection/d06579998c056d82b221a43ddd2586a5ddf1814cf83a1e421d0864e7ca96efd2" "q-113710/selection/f1334f0bb6ebbc309120a532120d8a44ed1d6edbd1a2c338a122899187579d89" "q-113710/selection/65cb1f669916fa528ea4aff6c7de0955a75e64cf2eb86f27e262807570fcb847" "q-113710/selection/1c02287ae9f0ff8974d544b5d5b94fd6e42e2a4662d36b833b061cfe54d8ed11" "q-113710/selection/4d3fbfc81962a167ceb48e4beb06954eeb94e4896fc5aa2d4d3d86ea43afba36"] :db/ensure [:answer-field/validate]} {:db/id "q-113710" :question/id #uuid "4f37db1f-70e6-5494-bcff-bbda79f12583" :question/math-academy-id "q-113710" :question/problem "Calculate $\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x.$" :question/worked-solution "In this case, the term $2{x}^{5}$ outside the parentheses isn't quite the derivative of $4+{x}^{6}.$ But the derivative is $6{x}^{5},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=4+{x}^{6}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{5}\\,⟹\\,\\frac{1}{3}\\text{d}u=2{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x & =\\int (4+{x}^{6})^{5}\\cdot 2{x}^{5}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{3}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{18}{u}^{6}+C \\\\  & =\\frac{1}{18}(4+{x}^{6})^{6}+C \\\\  & =\\frac{(4+{x}^{6})^{6}}{18}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113710/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-113710"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113715/selection/85543d6b7c1c4a660d381b531d69528e57236ae4ec560dc9c3889d649a3f2978" :answer/id #uuid "9dfb9eff-25c0-5fbc-b36e-5be57fb54d42" :answer/type :answer.type/math :answer/value "\\sqrt{({x}^{3}+10)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113715/selection/09cc9b317cca3d69d66a7ede036c75869645bdc88397a28d24e9fa14ed4a790c" :answer/id #uuid "e048a37a-58ce-5f43-ae3d-3a0e3141ee19" :answer/type :answer.type/math :answer/value "\\frac{9\\sqrt{({x}^{3}+10)^{3}}}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-113715/selection/bb6157ed63cdbbb727505c8a13d0f9b74a6afffe9d596db5cee6c189bb7cb91b" :answer/id #uuid "294af0db-c979-5652-a17a-84fa34992b04" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{({x}^{3}+10)^{3}}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113715/selection/973e9afd07d542136e8890368e5c1221444eb885d6f8b18f4b498e0b2fef7117" :answer/id #uuid "bfd63136-1fc8-54a4-bcf8-3946a6bac061" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{({x}^{3}+10)^{3}}}{9}+C" :db/ensure [:answer/validate]} {:db/id "q-113715/selection/085462138ca38956438ab3abd365541c28e00ba0782c3ed2b2066b22b253de8f" :answer/id #uuid "29e6e1af-f7f8-5e61-8a28-1055968d3696" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{({x}^{3}+10)^{3}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113715/selection" :answer-field/id #uuid "5dd20dcf-42f7-591b-9305-4cdb92b420f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113715/selection/973e9afd07d542136e8890368e5c1221444eb885d6f8b18f4b498e0b2fef7117" :answer-field/choices ["q-113715/selection/85543d6b7c1c4a660d381b531d69528e57236ae4ec560dc9c3889d649a3f2978" "q-113715/selection/09cc9b317cca3d69d66a7ede036c75869645bdc88397a28d24e9fa14ed4a790c" "q-113715/selection/bb6157ed63cdbbb727505c8a13d0f9b74a6afffe9d596db5cee6c189bb7cb91b" "q-113715/selection/973e9afd07d542136e8890368e5c1221444eb885d6f8b18f4b498e0b2fef7117" "q-113715/selection/085462138ca38956438ab3abd365541c28e00ba0782c3ed2b2066b22b253de8f"] :db/ensure [:answer-field/validate]} {:db/id "q-113715" :question/id #uuid "c719d4ad-7c2f-5ad1-8b4c-4707dea196f0" :question/math-academy-id "q-113715" :question/problem "Calculate $\\int 2{x}^{2}\\sqrt{{x}^{3}+10}\\,\\text{d}x.$" :question/worked-solution "In this case, the $2{x}^{2}$ that's outside the square root isn't quite the derivative of ${x}^{3}+10.$ But the derivative is $3{x}^{2},$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{3}+10.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2}\\,⟹\\,\\frac{2}{3}\\text{d}u=2{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\sqrt{{x}^{3}+10}\\,\\text{d}x & =\\int \\sqrt{{x}^{3}+10}\\cdot 2{x}^{2}\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{2}{3}\\text{d}u \\\\  & =\\frac{2}{3}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{2}{3}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{2}{3}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{3}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{9}{u}^{3/2}+C \\\\  & =\\frac{4}{9}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4\\sqrt{({x}^{3}+10)^{3}}}{9}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113715/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-113715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113721/selection/165d6424c07d7360afd3888cad2680a00b4106fecaf62a97e5accb88b0d51688" :answer/id #uuid "15b17e22-7cf6-5918-8333-cd934d44a4f9" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|{x}^{2}+2x|+C" :db/ensure [:answer/validate]} {:db/id "q-113721/selection/8aa1df6d76e55279d45f7c16921c6d39260c2ef92a36dcf000a7fb2eaa0621c6" :answer/id #uuid "3372881b-89f6-56b1-b998-feda0cdb84a7" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{2x+2}{{x}^{2}+2x}|+C" :db/ensure [:answer/validate]} {:db/id "q-113721/selection/92e76295d4348ed09966f08d35e00ab4446fdb1fe19cdd94c9a0494bb5455a22" :answer/id #uuid "b32343a6-6925-5309-bf35-5889a7bf6208" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{2}+2x}{2x+2}|+C" :db/ensure [:answer/validate]} {:db/id "q-113721/selection/92705b9690af19b5b98d6fd126ea3a3f0f6e489d7e23cb3107cf9caa50817df7" :answer/id #uuid "a6eb9d72-35df-55dc-b60c-308e6c232a23" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|2x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-113721/selection/79e79a963c7968449db14e3e54677cf98896b4252e3a6bb111729ce210a68d9f" :answer/id #uuid "2d9e9546-5757-5cd8-ad14-2f0e74d6b34c" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{2}+2x|}{2x+2}+C" :db/ensure [:answer/validate]} {:db/id "q-113721/selection" :answer-field/id #uuid "018f506c-4a97-5133-9ae2-7b60a3495771" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113721/selection/165d6424c07d7360afd3888cad2680a00b4106fecaf62a97e5accb88b0d51688" :answer-field/choices ["q-113721/selection/165d6424c07d7360afd3888cad2680a00b4106fecaf62a97e5accb88b0d51688" "q-113721/selection/8aa1df6d76e55279d45f7c16921c6d39260c2ef92a36dcf000a7fb2eaa0621c6" "q-113721/selection/92e76295d4348ed09966f08d35e00ab4446fdb1fe19cdd94c9a0494bb5455a22" "q-113721/selection/92705b9690af19b5b98d6fd126ea3a3f0f6e489d7e23cb3107cf9caa50817df7" "q-113721/selection/79e79a963c7968449db14e3e54677cf98896b4252e3a6bb111729ce210a68d9f"] :db/ensure [:answer-field/validate]} {:db/id "q-113721" :question/id #uuid "d31a6502-3081-5fe7-a78d-26602c4423a8" :question/math-academy-id "q-113721" :question/problem "Calculate $\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+2x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x+2\\,⟹\\,\\text{d}u=(2x+2)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{2}+2x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113721/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8"] :knowledge-point/questions ["q-113721"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113728/selection/c18ef55e0a1ab866fc1a96a0e3756e1f1d2b897fa29dadf099e20ad62113e64f" :answer/id #uuid "6dd766cd-2e71-58df-b392-42ec3a7f127e" :answer/type :answer.type/math :answer/value "-\\frac{2}{3\\sqrt{1-{x}^{3}}}+C" :db/ensure [:answer/validate]} {:db/id "q-113728/selection/11242522b7019a9b12cb4e2590a4392a9fda787082147192d27784f0f6f01809" :answer/id #uuid "b0ae7f17-4665-5b22-ab29-6e4a7150c1b9" :answer/type :answer.type/math :answer/value "\\frac{3}{4\\sqrt{1-{x}^{3}}}+C" :db/ensure [:answer/validate]} {:db/id "q-113728/selection/934690eac083d10bb769aadc1cd99f2033425ea0e78c01bd1b54d7ffb70f59f8" :answer/id #uuid "1568e3a3-8a54-555b-a38f-18896009ce50" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}\\sqrt{1-{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113728/selection/917ee302d34a3c92b54f346867fb01ae0129fe4cc613ed5736d83b1b029a7cd5" :answer/id #uuid "029048c7-a423-5e94-a44b-76d56138f85c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113728/selection/ebecb800c372334f25579950f48c38f4110981f939e9a6073cdde00d17f12613" :answer/id #uuid "cbb55cd5-c7b4-51d5-978e-5cfabbf4f949" :answer/type :answer.type/math :answer/value "-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113728/selection" :answer-field/id #uuid "a1f40447-403f-503a-a049-4b564230ebc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113728/selection/ebecb800c372334f25579950f48c38f4110981f939e9a6073cdde00d17f12613" :answer-field/choices ["q-113728/selection/c18ef55e0a1ab866fc1a96a0e3756e1f1d2b897fa29dadf099e20ad62113e64f" "q-113728/selection/11242522b7019a9b12cb4e2590a4392a9fda787082147192d27784f0f6f01809" "q-113728/selection/934690eac083d10bb769aadc1cd99f2033425ea0e78c01bd1b54d7ffb70f59f8" "q-113728/selection/917ee302d34a3c92b54f346867fb01ae0129fe4cc613ed5736d83b1b029a7cd5" "q-113728/selection/ebecb800c372334f25579950f48c38f4110981f939e9a6073cdde00d17f12613"] :db/ensure [:answer-field/validate]} {:db/id "q-113728" :question/id #uuid "ce8c32d3-4826-5698-9579-504253d6428c" :question/math-academy-id "q-113728" :question/problem "$\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x=$" :question/worked-solution "Let $u=1-{x}^{3}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}\\,⟹\\,(-\\frac{2}{3})\\text{d}u=2{x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot 2{x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{2}{3})\\text{d}u \\\\  & =-\\frac{2}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{2}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{4}{3}\\sqrt{u}+C \\\\  & =-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113728/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-113728"] :db/ensure [:knowledge-point/validate]}]
