603 1000 #edb/ref 17592186277605 13194139534101 true] [17592186277603 1000 #edb/ref 17592186277606 13194139534101 true] [17592186277603 1000 #edb/ref 17592186277607 13194139534101 true] [17592186277603 1000 #edb/ref 17592186277608 13194139534101 true] [17592186277603 1040 #edb/ref 17592186045450 13194139534101 true] [17592186277603 1041 "selection" 13194139534101 true] [17592186277603 1104 #edb/ref 17592186277605 13194139534101 true] [17592186277603 1110 #uuid "7cf26401-090c-53af-b1c7-debcf25cf837" 13194139534101 true] [17592186277604 1034 "$-3$ only" 13194139534101 true] [17592186277604 1103 #edb/ref 17592186045454 13194139534101 true] [17592186277604 1111 #uuid "79b69ffd-53b1-5296-bcd8-9d40d7ca5dd3" 13194139534101 true] [17592186277605 1034 "Any value of $p$" 13194139534101 true] [17592186277605 1103 #edb/ref 17592186045454 13194139534101 true] [17592186277605 1111 #uuid "da7c4a38-f290-54d6-9b3e-a6b031c2a044" 13194139534101 true] [17592186277606 1034 "$-3$ and $3$ only" 13194139534101 true] [17592186277606 1103 #edb/ref 17592186045454 13194139534101 true] [17592186277606 1111 #uuid "df8b1348-1e8c-5006-a02e-3ba39d9941d7" 13194139534101 true] [17592186277607 1034 "$-10$ only" 13194139534101 true] [17592186277607 1103 #edb/ref 17592186045454 13194139534101 true] [17592186277607 1111 #uuid "aa75b007-abdf-51b3-8a2c-37e2fad5717a" 13194139534101 true] [17592186277608 1034 "$\\frac{5}{2}$ only" 13194139534101 true] [17592186277608 1103 #edb/ref 17592186045454 13194139534101 true] [17592186277608 1111 #uuid "9ced83b0-069a-581b-a26a-2ec6171ee6b7" 13194139534101 true] [17592186277609 1017 #edb/ref 17592186277610 13194139534101 true] [17592186277609 1089 "q-18271" 13194139534101 true] [17592186277609 1091 #edb/ref 17592186045463 13194139534101 true] [17592186277609 1100 "Given that\n$A=[\\begin{aligned}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{aligned}]$\nand $det(A)=-30,$ find the value of $k.$" 13194139534101 true] [17592186277609 1113 #uuid "484cc9a7-1050-5967-a771-2eb02ecf6624" 13194139534101 true] [17592186277609 1145 "Let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}\\text{det}(A) & =|\\begin{aligned}-k & 0 & -3 \\\\ 1 & 3 & -1 \\\\ 2k & 0 & 1\\end{aligned}| \\\\  & =-k|\\begin{aligned}3 & -1 \\\\ 0 & 1\\end{aligned}|-0|\\begin{aligned}1 & -1 \\\\ 2k & 1\\end{aligned}|-3|\\begin{aligned}1 & 3 \\\\ 2k & 0\\end{aligned}| \\\\  & =-k\\cdot 3+0-3\\cdot (-6k) \\\\  & =-3k+18k \\\\  & =15k\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-30,$ we have:\n\n$$\n\\begin{aligned}15k & =-30 \\\\ k & =-2\\end{aligned}\n$$" 13194139534101 true] [17592186277610 1000 #edb/ref 17592186277611 13194139534101 true] [17592186277610 1000 #edb/ref 17592186277612 13194139534101 true] [17592186277610 1000 #edb/ref 17592186277613 13194139534101 true] [17592186277610 1000 #edb/ref 17592186277614 13194139534101 true] [17592186277610 1000 #edb/ref 17592186277615 13194139534101 true] [17592186277610 1040 #edb/ref 17592186045450 13194139534101 true] [17592186277610 1041 "selection" 13194139534101 true] [17592186277610 1104 #edb/ref 17592186277615 13194139534101 true] [17592186277610 1110 #uuid "d82ed055-710f-50a2-b301-dff7259d617b" 13194139534101 true] [17592186277611 1034 "3" 13194139534101 true] [17592186277611 1103 #edb/ref 17592186045453 13194139534101 true] [17592186277611 1111 #uuid "b3de16e1-b682-517d-98fa-b1828e7c83e6" 13194139534101 true] [17592186277612 1034 "2" 13194139534101 true] [17592186277612 1103 #edb/ref 17592186045453 13194139534101 true] [17592186277612 1111 #uuid "382071f9-c0c1-54ac-8989-c56fb17c56bf" 13194139534101 true] [17592186277613 1034 "1" 13194139534101 true] [17592186277613 1103 #edb/ref 17592186045453 13194139534101 true] [17592186277613 1111 #uuid "fda14de4-a359-5c1e-9b5c-e42be5b924e1" 13194139534101 true] [17592186277614 1034 "-3" 13194139534101 true] [17592186277614 1103 #edb/ref 17592186045453 13194139534101 true] [17592186277614 1111 #uuid "9de5d843-f2