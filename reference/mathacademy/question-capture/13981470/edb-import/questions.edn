#{[{:db/id #edb/ref 17592186157062 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc" :knowledge-point/title "Solving an Inequality Involving an Odd Power"}] :question/id #uuid "264fc406-4800-5084-8fb9-5d312bdbd87a" :question/math-academy-id "e-7651" :question/problem "Solve the inequality $2(x - 2)^3 - 5 \\gt 11$." :question/worked-solution "Isolating the cubic term, we find\n\n$$\n\\begin{bmatrix}2(x - 2)^{3} - 5 & > 11 \\\\ 2(x - 2)^{3} & > 16 \\\\ (x - 2)^{3} & > 8\\end{bmatrix}\n$$\n\nThen, we take the cube root of both sides and get\n\n$$\n\\begin{bmatrix}\\sqrt[3]{(x - 2)^{3}} & > \\sqrt[3]{8} \\\\ x - 2 & > 2 \\\\ x & > 4\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186157063 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e2463ef2-c276-53cb-a1a1-8601789574d3" :knowledge-point/title "Solving an Inequality Involving an Even Power Compared To a Negative Number"}] :question/id #uuid "2d467e68-1d9b-5e6b-ab4f-663716e72c08" :question/math-academy-id "e-7652" :question/problem "Solve $(5x-1)^6 + 5 \\geq -4$." :question/worked-solution "Isolating the sixth-degree term, we find\n\n$$\n\\begin{bmatrix}(5x - 1)^{6} + 5 & \\ge - 4 \\\\ (5x - 1)^{6} & \\ge - 9\\end{bmatrix}\n$$\n\nNote that\n\n$$\n(5x - 1)^{6} \\geq 0\n$$\n\nfor all values of $x$ because the power $(6)$ is even.\n\nTherefore, the solution to the given inequality is all real numbers."}] [{:db/id #edb/ref 17592186157064 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f" :knowledge-point/title "Solving an Inequality Involving an Even Power"}] :question/id #uuid "bc596174-92e8-5def-ac86-34ef18cfa3c5" :question/math-academy-id "e-7653" :question/problem "Solve the inequality $\\dfrac{(5x + 2)^4}{9} - 3 \\gt 6$." :question/worked-solution "Isolating the quartic term, we find\n$\\begin{bmatrix}((5x + 2)^{4})/(9) - 3 & > 6 \\\\ ((5x + 2)^{4})/(9) & > 9 \\\\ (5x + 2)^{4} & > 81\\end{bmatrix}$.\n\nNow, we take the fourth root of both sides and get\n$\\sqrt[4]{(5x + 2)^{4}} \\mid > \\sqrt[4]{81}; \\mid 5x + 2 \\mid \\mid > 3$.\n\nThis corresponds to the following compound inequality:\n$5x + 2 \\lt -3 \\qquad \\textrm{or} \\qquad 5x + 2 \\gt 3$\n\nWe can solve each inequality using the usual methods.\n\n$$\n\\begin{bmatrix}5x + 2 & < - 3 & 5x + 2 & > 3 \\\\ 5x & < - 5 & 5x & > 1 \\\\ x & < - 1 & x & > \\frac{1}{5}\\end{bmatrix}\n$$\n\nTherefore, the solution is\n\n$$\nx \\lt -1 \\quad \\textrm{or} \\quad x \\gt \\dfrac{1}{5}\n$$"}] [{:db/id #edb/ref 17592186157827 :knowledge-point/_questions [{:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc" :knowledge-point/title "Solving an Inequality Involving an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9585770b-702f-5195-8b52-6be05ef3707f" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ge 1" :db/id #edb/ref 17592186156215} {:answer/id #uuid "f32f09b7-3b42-5919-bc58-503c152ac81d" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ge \\frac{2}{3}" :db/id #edb/ref 17592186156216} {:answer/id #uuid "17f384d2-3281-5d1a-9d3b-f5b053a20585" :answer/type {:db/ident :answer.type/math} :answer/value "x \\le \\frac{1}{2}" :db/id #edb/ref 17592186156217} {:answer/id #uuid "2e4c1f75-1a96-5205-bc4a-065994eedec2" :answer/type {:db/ident :answer.type/math} :answer/value "x \\ge \\frac{1}{2}" :db/id #edb/ref 17592186156218} {:answer/id #uuid "6ec5bf34-4c4a-55ab-a43b-abeec0ebd22b" :answer/type {:db/ident :answer.type/math} :answer/value "x \\le \\frac{2}{3}" :db/id #edb/ref 17592186156219}] :answer-field/correct {:answer/id #uuid "17f384d2-3281-5d1a-9d3b-f5b053a20585" :answer/type {:db/ident :answer.type/math} :answer/value "x \\le \\frac{1}{2}" :db/id #edb/ref 17592186156217} :answer-field/id #uuid "397c3e38-6fa0-539c-bc37-f8a54d8b5362" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186156214}] :question/id #uuid "c797b467-18dd-5587-bb87-a96080eddf3c" :question/math-academy-id "q-87448" :question/problem "Solve the inequality $(5 - 2x)^{3} - 60 \\ge 4$."}]}
