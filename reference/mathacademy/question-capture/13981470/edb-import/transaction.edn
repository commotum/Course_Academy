q-87821" :question/id #uuid "9532e0ca-ce7a-5b85-b57a-a7477a29240f" :question/math-academy-id "q-87821" :question/problem "Solve the inequality $3(2-5x)^{9}+5\\le 8.$" :question/worked-solution "Isolating the ninth-degree term, we find\n\n$$\n\\begin{aligned}3(2-5x)^{9}+5 & \\le 8 \\\\ 3(2-5x)^{9} & \\le 3 \\\\ (2-5x)^{9} & \\le 1.\\end{aligned}\n$$\n\nThen, we take the ninth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[9]{(2-5x)^{9}} & \\le \\sqrt[9]{1} \\\\ 2-5x & \\le 1 \\\\ -5x & \\le -1 \\\\ x & \\ge \\frac{1}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc"] :knowledge-point/questions ["q-87821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278048/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer/id #uuid "fcbee9b7-2d0d-53d7-84d9-e8a95542f39e" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "q-278048/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "83475b74-f0ed-50f9-ba62-38caa4368f08" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278048/field-1" :answer-field/id #uuid "98b73f5c-3f13-52bd-9adf-e1e433e72260" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278048/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer-field/choices ["q-278048/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" "q-278048/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-278048/field-2/acc158d5083b0655f359ab9a5b0f1f539ad855f6c76b288a40277a585ab49734" :answer/id #uuid "028c7ef9-9fde-588f-8a86-bcb67046a448" :answer/type :answer.type/math :answer/value "6-5^{\\frac{1}{3}}" :db/ensure [:answer/validate]} {:db/id "q-278048/field-2" :answer-field/id #uuid "fa9f02d1-4941-574d-a7d7-931d14c9e2c5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278048/field-2/acc158d5083b0655f359ab9a5b0f1f539ad855f6c76b288a40277a585ab49734" :answer-field/choices ["q-278048/field-2/acc158d5083b0655f359ab9a5b0f1f539ad855f6c76b288a40277a585ab49734"] :db/ensure [:answer-field/validate]} {:db/id "q-278048" :question/id #uuid "34cd14a9-3fc5-5c65-905b-62d28d2da943" :question/math-academy-id "q-278048" :question/problem "Find the exact solution of the inequality $(x-6)^{3}+5\\le 0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the cubic-degree term, we find\n\n$$\n\\begin{aligned}(x-6)^{3}+5 & \\le 0 \\\\ (x-6)^{3} & \\le -5.\\end{aligned}\n$$\n\nThen, we take the third root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[3]{(x-6)^{3}} & \\le \\sqrt[3]{-5} \\\\ x-6 & \\le \\sqrt[3]{-5} \\\\ x & \\le \\sqrt[3]{-5}+6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278048/field-1" "q-278048/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc"] :knowledge-point/questions ["q-278048"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278051/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "360f013d-7ccb-5f03-801b-0de9a4162e4b" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278051/field-1" :answer-field/id #uuid "da2da26d-3ea6-5b2d-8ed6-6bf8c2d99e8a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278051/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-278051/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-278051/field-2/835a5bafc2075e81e71c0d3792541734aef843954d5aac399df774b096639797" :answer/id #uuid "604f1546-379b-5d72-be50-c66dd7c0b269" :answer/type :answer.type/math :answer/value "9^{\\frac{1}{7}}-5" :db/ensure [:answer/validate]} {:db/id "q-278051/field-2" :answer-field/id #uuid "356a5ce2-900a-5ca2-b109-ee875bbf79f8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278051/field-2/835a5bafc2075e81e71c0d3792541734aef843954d5aac399df774b096639797" :answer-field/choices ["q-278051/field-2/835a5bafc2075e81e71c0d3792541734aef843954d5aac399df774b096639797"] :db/ensure [:answer-field/validate]} {:db/id "q-278051" :question/id #uuid "8f96d7c7-49d8-5912-9da1-cffe54ad2c27" :question/math-academy-id "q-278051" :question/problem "Find the exact solution of the inequality $(x+5)^{7}-1\\ge 8.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the seventh-degree term, we find\n\n$$\n\\begin{aligned}(x+5)^{7}-1 & \\ge 8 \\\\ (x+5)^{7} & \\ge 9.\\end{aligned}\n$$\n\nThen, we take the seventh root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[7]{(x+5)^{7}} & \\ge \\sqrt[7]{9} \\\\ x+5 & \\ge \\sqrt[7]{9} \\\\ x & \\ge \\sqrt[7]{9}-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278051/field-1" "q-278051/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc"] :knowledge-point/questions ["q-278051"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278121/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer/id #uuid "1a106b92-a903-5f72-8e7e-6a3d0a29405e" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "q-278121/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "3f56fb40-842f-548a-bf57-0d7ea0d7a1a6" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278121/field-1" :answer-field/id #uuid "67d20b1b-c2c0-58e4-bafc-9deebf033339" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278121/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer-field/choices ["q-278121/field-1/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" "q-278121/field-1/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-278121/field-2/6497a65486736fffa7a7ae0742e36dd82b47569a93f9ad1bdb3deddebc1f1a83" :answer/id #uuid "e790864c-23ad-51d3-adf2-858c777254d0" :answer/type :answer.type/math :answer/value "3-13^{\\frac{1}{7}}" :db/ensure [:answer/validate]} {:db/id "q-278121/field-2" :answer-field/id #uuid "723f52a3-b130-5b11-b246-bb8cdfff5e1a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278121/field-2/6497a65486736fffa7a7ae0742e36dd82b47569a93f9ad1bdb3deddebc1f1a83" :answer-field/choices ["q-278121/field-2/6497a65486736fffa7a7ae0742e36dd82b47569a93f9ad1bdb3deddebc1f1a83"] :db/ensure [:answer-field/validate]} {:db/id "q-278121" :question/id #uuid "457dac10-7325-5ec0-b736-38ba54dd0950" :question/math-academy-id "q-278121" :question/problem "Find the exact solution of the inequality $(3-x)^{7}-8\\ge 5.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the seventh-degree term, we find\n\n$$\n\\begin{aligned}(3-x)^{7}-8 & \\ge 5 \\\\ (3-x)^{7} & \\ge 13.\\end{aligned}\n$$\n\nThen, we take the seventh root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[7]{(3-x)^{7}} & \\ge \\sqrt[7]{13} \\\\ 3-x & \\ge \\sqrt[7]{13} \\\\ -x & \\ge \\sqrt[7]{13}-3 \\\\ x & \\le -\\sqrt[7]{13}+3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278121/field-1" "q-278121/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "60062061-501a-5ab1-87fc-c6fc39ea3fbc"] :knowledge-point/questions ["q-278121"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-87448"] :question/problem "Solve the inequality $(5-2x)^{3}-60\\ge 4.$" :question/worked-solution "Isolating the cubic term, we find\n\n$$\n\\begin{aligned}(5-2x)^{3}-60 & \\ge 4 \\\\ (5-2x)^{3} & \\ge 64.\\end{aligned}\n$$\n\nThen, we take the cube root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[3]{(5-2x)^{3}} & \\ge \\sqrt[3]{64} \\\\ 5-2x & \\ge 4 \\\\ -2x & \\ge -1 \\\\ x & \\le \\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-116221/selection/4c9165bc8fbccf6191727b7ef08ac4a371d9f43f0d44100a57d81e322f80c30e" :answer/id #uuid "3ed63e80-29cc-506a-b1ad-ce050e7d3a6a" :answer/type :answer.type/math :answer/value "x<-1-\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-116221/selection/b7f997431c1fce0d3166196e880aeea9bac64a754d0a20df22efbe1b520e6b51" :answer/id #uuid "cb3dc11d-6041-518c-b908-1614b3342e84" :answer/type :answer.type/math :answer/value "x<0" :db/ensure [:answer/validate]} {:db/id "q-116221/selection/4b90c026d3063dfe35b028574b11699eb1488fd006da6f275d0a93857d1c7748" :answer/id #uuid "45855a7c-ba17-53d1-b64d-be17f5c1db8d" :answer/type :answer.type/math :answer/value "x>1+\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-116221/selection/4830a6fef9288cfe060c82c06e8907032120ca0fe102adc0e42b2e5cb9e34946" :answer/id #uuid "1a93e023-6e43-5c3b-9cf3-6eca2a191b62" :answer/type :answer.type/math :answer/value "x<1-\\sqrt[6]{2}\\,\\text{or}\\,x>1+\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-116221/selection/9b063fa2a26a79469af3bdd1c54b9c09402779d4607b7c25a7696b9c3086ed04" :answer/id #uuid "01124737-6c5e-5c9e-b7e3-8ff76ee8dc37" :answer/type :answer.type/math :answer/value "x>-2" :db/ensure [:answer/validate]} {:db/id "q-116221/selection" :answer-field/id #uuid "ab0bfeb7-ca05-59e9-a5c1-d4cf1565de8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116221/selection/4830a6fef9288cfe060c82c06e8907032120ca0fe102adc0e42b2e5cb9e34946" :answer-field/choices ["q-116221/selection/4c9165bc8fbccf6191727b7ef08ac4a371d9f43f0d44100a57d81e322f80c30e" "q-116221/selection/b7f997431c1fce0d3166196e880aeea9bac64a754d0a20df22efbe1b520e6b51" "q-116221/selection/4b90c026d3063dfe35b028574b11699eb1488fd006da6f275d0a93857d1c7748" "q-116221/selection/4830a6fef9288cfe060c82c06e8907032120ca0fe102adc0e42b2e5cb9e34946" "q-116221/selection/9b063fa2a26a79469af3bdd1c54b9c09402779d4607b7c25a7696b9c3086ed04"] :db/ensure [:answer-field/validate]} {:db/id "q-116221" :question/id #uuid "b64255ff-f045-5b1b-b2e0-7a0c0df1a6c0" :question/math-academy-id "q-116221" :question/problem "Solve the inequality $4(1-x)^{6}-1>7.$" :question/worked-solution "Isolating the sixth-degree term, we find\n\n$$\n\\begin{aligned}4(1-x)^{6}-1 & >7 \\\\ 4(1-x)^{6} & >8 \\\\ (1-x)^{6} & >2.\\end{aligned}\n$$\n\nNow, we take the sixth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[6]{(1-x)^{6}} & >\\sqrt[6]{2} \\\\ |1-x| & >\\sqrt[6]{2}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\n1-x<-\\sqrt[6]{2}\\,\\text{or}\\,1-x>\\sqrt[6]{2}\n$$\n\nWe can solve each inequality using the usual methods.\n\n$$\n\\begin{aligned}1-x & <-\\sqrt[6]{2} &  &  & 1-x & >\\sqrt[6]{2} \\\\ -x & <-\\sqrt[6]{2}-1 &  &  & -x & >\\sqrt[6]{2}-1 \\\\ x & >1+\\sqrt[6]{2} &  &  & x & <1-\\sqrt[6]{2}\\end{aligned}\n$$\n\nSo, the solution is\n\n$$\nx<1-\\sqrt[6]{2}\\,\\text{or}\\,x>1+\\sqrt[6]{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116221/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-116221"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278143/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "bfc8b207-d348-59ba-adc7-6e78e0ea765c" :answe