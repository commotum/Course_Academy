442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-278143" :question/id #uuid "f5e7cceb-3b0e-5ae1-861b-1378b9b9e348" :question/math-academy-id "q-278143" :question/problem "Find the exact solution of the inequality $-4(5-x)^{6}+147>-109.$\n\n{{field-1}}\n$<x$\n{{field-2}}{{field-3}}" :question/worked-solution "Isolating the sixth-degree term, we find\n\n$$\n\\begin{aligned}-4(5-x)^{6}+147 & >-109 \\\\ -4(5-x)^{6} & >-256 \\\\ (5-x)^{6} & <64.\\end{aligned}\n$$\n\nNote that we had to flip the inequality when we divided both sides by $-4.$\n\nNow, we take the sixth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[6]{(5-x)^{6}} & <\\sqrt[6]{64} \\\\ |5-x| & <2.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\n-2<5-x<2\n$$\n\nNow, we can solve the compound inequality using the usual methods.\n\n$$\n\\begin{aligned}-2<5-x & <2 \\\\ -7<-x & <-3 \\\\ 7>x & >3\\end{aligned}\n$$\n\nTo make the final result easier to read, we will rewrite it so that the lower number is on the left:\n\n$$\n3<x<7\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278143/field-1" "q-278143/field-2" "q-278143/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-278143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87918/selection/89d719ac38215a30dec3cd6c6a3507becc8269d20ae5941c93d21ae095ad7050" :answer/id #uuid "8934b52b-f1bc-5f98-bf08-742e9aacdd80" :answer/type :answer.type/math :answer/value "x\\le \\sqrt{2}+5" :db/ensure [:answer/validate]} {:db/id "q-87918/selection/e35f7f62d0dd19696eef2225ebb64be6cd14ba59aa2d05770a482da8a369020b" :answer/id #uuid "0a65cf1e-cfc8-5554-87de-e4021b9fb18c" :answer/type :answer.type/math :answer/value "-\\sqrt{2}\\le x\\le \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-87918/selection/372b7d7d73801cadac6c17de123cfd8dc0d92acec0b5d43828808760ba6ac2db" :answer/id #uuid "9c65d21b-8d27-540f-9396-0f665d23cd5b" :answer/type :answer.type/math :answer/value "5-\\sqrt{2}\\le x\\le 5+\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-87918/selection/49df6217bb8cd3ca93fa84e0be3324b361cefea34fc3c600c889251fcd44de86" :answer/id #uuid "210d0b1f-1b29-55df-9b13-e552c960a58a" :answer/type :answer.type/text :answer/value "$x\\le -5-\\sqrt{2}\\,$ or $\\,x\\ge 5-\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-87918/selection/8acf1aa8cab9839e28b473702ee2b66db066200575ffc168536fe3e9a2545b8a" :answer/id #uuid "c07c0cfd-bbf4-5542-a9db-9268e868d011" :answer/type :answer.type/math :answer/value "x\\ge 5-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-87918/selection" :answer-field/id #uuid "3cdb7af8-7881-58d7-816c-44a68432625b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87918/selection/372b7d7d73801cadac6c17de123cfd8dc0d92acec0b5d43828808760ba6ac2db" :answer-field/choices ["q-87918/selection/89d719ac38215a30dec3cd6c6a3507becc8269d20ae5941c93d21ae095ad7050" "q-87918/selection/e35f7f62d0dd19696eef2225ebb64be6cd14ba59aa2d05770a482da8a369020b" "q-87918/selection/372b7d7d73801cadac6c17de123cfd8dc0d92acec0b5d43828808760ba6ac2db" "q-87918/selection/49df6217bb8cd3ca93fa84e0be3324b361cefea34fc3c600c889251fcd44de86" "q-87918/selection/8acf1aa8cab9839e28b473702ee2b66db066200575ffc168536fe3e9a2545b8a"] :db/ensure [:answer-field/validate]} {:db/id "q-87918" :question/id #uuid "fceb2ee0-c860-5eb1-97cf-5d41fec4b50b" :question/math-academy-id "q-87918" :question/problem "Solve the inequality $(5-x)^{2}+4\\le 6.$" :question/worked-solution "Isolating the quadratic term, we find\n\n$$\n\\begin{aligned}(5-x)^{2}+4 & \\le 6 \\\\ (5-x)^{2} & \\le 2.\\end{aligned}\n$$\n\nNow, we take the square root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt{(5-x)^{2}} & \\le \\sqrt{2} \\\\ |5-x| & \\le \\sqrt{2}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\n-\\sqrt{2}\\le 5-x\\le \\sqrt{2}\n$$\n\nNow, we can solve the compound inequality using the usual methods.\n\n$$\n\\begin{aligned}-\\sqrt{2}\\le 5-x & \\le \\sqrt{2} \\\\ -\\sqrt{2}-5\\le -x & \\le \\sqrt{2}-5 \\\\ 5+\\sqrt{2}\\ge x & \\ge 5-\\sqrt{2}\\end{aligned}\n$$\n\nTo make the final result easier to read, we will rewrite it so that the lower number is on the left:\n\n$$\n5-\\sqrt{2}\\le x\\le 5+\\sqrt{2}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-87918/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-87918"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278138/field-1/b4086ea6fd7e56d512d06e7b7e3621e711cba3cb559fc19105dfa24f314ea10d" :answer/id #uuid "98f582e2-e2be-508c-aa5d-193cf2f1175e" :answer/type :answer.type/math :answer/value "4-\\sqrt{17}" :db/ensure [:answer/validate]} {:db/id "q-278138/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3e3e0ece-756a-569d-a148-d3a7e3091918" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-278138/field-1" :answer-field/id #uuid "24a27655-e704-5b64-914d-d2e117a456d0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278138/field-1/b4086ea6fd7e56d512d06e7b7e3621e711cba3cb559fc19105dfa24f314ea10d" :answer-field/choices ["q-278138/field-1/b4086ea6fd7e56d512d06e7b7e3621e711cba3cb559fc19105dfa24f314ea10d" "q-278138/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-278138/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "f3a76996-f434-5ec4-88b1-2cca71ab0dd0" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278138/field-2" :answer-field/id #uuid "c14f0aff-3287-5a25-86ab-735d882d7828" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278138/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-278138/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-278138/field-3/9bf60bb9a95aa81eb771c7fec1441ad52bbf8cc96112721d1029b8b30dac3b85" :answer/id #uuid "beb4da28-d37a-5140-9b81-9a81606eb95c" :answer/type :answer.type/math :answer/value "4+\\sqrt{17}" :db/ensure [:answer/validate]} {:db/id "q-278138/field-3" :answer-field/id #uuid "dffd5c06-a1bb-52a6-8baa-ef1954725c9f" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278138/field-3/9bf60bb9a95aa81eb771c7fec1441ad52bbf8cc96112721d1029b8b30dac3b85" :answer-field/choices ["q-278138/field-3/9bf60bb9a95aa81eb771c7fec1441ad52bbf8cc96112721d1029b8b30dac3b85"] :db/ensure [:answer-field/validate]} {:db/id "q-278138" :question/id #uuid "83635496-e658-526e-b35d-174e9d817b7f" :question/math-academy-id "q-278138" :question/problem "Find the exact solution of the inequality $(4-x)^{2}-10\\ge 7.$\n\n$x\\le ${{field-1}}\n$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "Isolating the quadratic term, we find\n\n$$\n\\begin{aligned}(4-x)^{2}-10 & \\ge 7 \\\\ (4-x)^{2} & \\ge 17.\\end{aligned}\n$$\n\nNow, we take the square root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt{(4-x)^{2}} & \\ge \\sqrt{17} \\\\ |4-x| & \\ge \\sqrt{17}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\n4-x\\le -\\sqrt{17}\\,\\text{or}\\,4-x\\ge \\sqrt{17}\n$$\n\nWe can solve each inequality using the usual methods.\n\n$$\n\\begin{aligned}4-x & \\le -\\sqrt{17} &  &  & 4-x & \\ge \\sqrt{17} \\\\ -x & \\le -\\sqrt{17}-4 &  &  & -x & \\ge \\sqrt{17}-4 \\\\ x & \\ge 4+\\sqrt{17} &  &  & x & \\le 4-\\sqrt{17}\\end{aligned}\n$$\n\nSo, the solution is\n\n$$\nx\\le 4-\\sqrt{17}\\,\\text{or}\\,x\\ge 4+\\sqrt{17}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-278138/field-1" "q-278138/field-2" "q-278138/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-278138"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116224/selection/34d18b4575e73b006f4538802ed5d1efca0dec6749e44b07af8b7e9fae39a4f1" :answer/id #uuid "1a2acc41-124a-50ed-b92f-af62f1a030d3" :answer/type :answer.type/math :answer/value "x>\\sqrt[4]{6}+1" :db/ensure [:answer/validate]} {:db/id "q-116224/selection/c17e7ac186c0c8d1ddd5c335dc0d28928fa188a218f2083da1e16f5262f02f83" :answer/id #uuid "7fbfc105-b7cb-552d-83d1-bf427302e37b" :answer/type :answer.type/math :answer/value "x<\\sqrt[4]{6}-4" :db/ensure [:answer/validate]} {:db/id "q-116224/selection/b9be10c23252e0e0d3fa2331e75d3f592f099058a3d254953ce6a5382a4fde3d" :answer/id #uuid "4ed0a7ab-26f4-56dc-a9f3-bac1066f8633" :answer/type :answer.type/math :answer/value "x<\\sqrt[4]{6}+3" :db/ensure [:answer/validate]} {:db/id "q-116224/selection/bbd775170b33ef8bc325dad0b198af950f4fec584cb4982e346042747eda1019" :answer/id #uuid "2e225e8e-0eed-585f-a6a9-d5e4a8f12c37" :answer/type :answer.type/math :answer/value "-\\sqrt[4]{6}-4<x<\\sqrt[4]{6}-4" :db/ensure [:answer/validate]} {:db/id "q-116224/selection/7764d9385bf53abd9c836ea800671461b499be84813909f3c443a363acc7a04b" :answer/id #uuid "953d479f-f7dd-5d8d-8a1e-3415811e97fb" :answer/type :answer.type/text :answer/value "$x<-\\sqrt[4]{6}-2\\,$ or $\\,x>\\sqrt[4]{6}-2$" :db/ensure [:answer/validate]} {:db/id "q-116224/selection" :answer-field/id #uuid "e59d52a6-82e2-5979-aeea-009a3685986d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116224/selection/bbd775170b33ef8bc325dad0b198af950f4fec584cb4982e346042747eda1019" :answer-field/choices ["q-116224/selection/34d18b4575e73b006f4538802ed5d1efca0dec6749e44b07af8b7e9fae39a4f1" "q-116224/selection/c17e7ac186c0c8d1ddd5c335dc0d28928fa188a218f2083da1e16f5262f02f83" "q-116224/selection/b9be10c23252e0e0d3fa2331e75d3f592f099058a3d254953ce6a5382a4fde3d" "q-116224/selection/bbd775170b33ef8bc325dad0b198af950f4fec584cb4982e346042747eda1019" "q-116224/selection/7764d9385bf53abd9c836ea800671461b499be84813909f3c443a363acc7a04b"] :db/ensure [:answer-field/validate]} {:db/id "q-116224" :question/id #uuid "f798ab92-48c0-5ca8-a2db-e9b18af0cb6a" :question/math-academy-id "q-116224" :question/problem "Solve the inequality $2(x+4)^{4}+6<18.$" :question/worked-solution "Isolating the quartic term, we find\n\n$$\n\\begin{aligned}2(x+4)^{4}+6 & <18 \\\\ 2(x+4)^{4} & <12 \\\\ (x+4)^{4} & <6.\\end{aligned}\n$$\n\nNow, we take the fourth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[4]{(x+4)^{4}} & <\\sqrt[4]{6} \\\\ |x+4| & <\\sqrt[4]{6}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\n-\\sqrt[4]{6}<x+4<\\sqrt[4]{6}\n$$\n\nNow, we can solve the compound inequality using the usual methods.\n\n$$\n\\begin{aligned}-\\sqrt[4]{6}<x+4 & <\\sqrt[4]{6} \\\\ -\\sqrt[4]{6}-4<x & <\\sqrt[4]{6}-4\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116224/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-116224"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87840/selection/ad0c66c8506d8203bd7b2957e093733561791281baddc7be4c3073626395bafc" :answer/id #uuid "49956feb-4a6e-56f8-86e5-bbd8b70b002d" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\sqrt[8]{3}+2}{4}" :db/ensure [:answer/validate]} {:db/id "q-87840/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "f818daf0-bb72-5dba-969c-400dbe0848a1" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-87840/selection/88f562cfd11bf27ac5a2c0ca888d34d98c