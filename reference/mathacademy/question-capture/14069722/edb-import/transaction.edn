.63) & =Φ(0.63)-Φ(-0.63) \\\\  & =0.7357-0.2643 \\\\  & =0.4714.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-330889/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02d2757f-1179-5ad6-b8c7-5165ac3a3eff"] :knowledge-point/questions ["q-330889"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330908/field-1/4b1e57e98b93401271ce99c72c6fcd2ee592c3bb426ba032af268d57aa82c184" :answer/id #uuid "d2e05292-35cc-59ef-997f-c5e5bcd4c75f" :answer/type :answer.type/math :answer/value "0.8764" :db/ensure [:answer/validate]} {:db/id "q-330908/field-1" :answer-field/id #uuid "940d9bb0-2b28-5602-89ff-31cf3b00c86d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-330908/field-1/4b1e57e98b93401271ce99c72c6fcd2ee592c3bb426ba032af268d57aa82c184" :answer-field/choices ["q-330908/field-1/4b1e57e98b93401271ce99c72c6fcd2ee592c3bb426ba032af268d57aa82c184"] :db/ensure [:answer-field/validate]} {:db/id "q-330908" :question/id #uuid "f31e8083-0326-52b0-a159-f48c24746347" :question/math-academy-id "q-330908" :question/problem "The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. Given that $Z∼N(0,1),$ compute $P(-1.54<Z<1.54).$\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.6\\,$ | $\\,0.0526\\,$ | $\\,0.0516\\,$ | $\\,0.0505\\,$ |\n| $\\,-1.5\\,$ | $\\,0.0643\\,$ | $\\,0.0630\\,$ | $\\,0.0618\\,$ |\n| $\\,-1.4\\,$ | $\\,0.0778\\,$ | $\\,0.0764\\,$ | $\\,0.0749\\,$ |\n\n$P(-1.54<Z<1.54)=$\n{{field-1}}" :question/worked-solution "We're given that $Z∼N(0,1),$ and we wish to compute $P(-1.54<Z<1.54).$ The required probability is represented by the area shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/assets/af13b1b1ef963dc2a922eab8b213015bd5af23b28fbf907fe4b7e5226a8768f4.png)\n\nBy the definition of the cumulative distribution function $Φ(z),$ \n\n$$\nP(Z\\le z)=Φ(z).\n$$\n\nSo, we express the required probability in terms of $Φ(z)$:\n\n$$\n\\begin{aligned}P(-1.54<Z<1.54) & =P(Z<1.54)-P(Z\\le -1.54) \\\\  & =P(Z\\le 1.54)-P(Z\\le -1.54) \\\\  & =Φ(1.54)-Φ(-1.54)\\end{aligned}\n$$\n\nFrom the table, we know that\n\n$$\nΦ(-1.54)=0.0618,\n$$\n\nbut we are not given $Φ(1.54).$ However, we can compute this using symmetry:\n\n$$\n\\begin{aligned}Φ(1.54) & =P(Z\\le 1.54) \\\\  & =1-P(Z\\le -1.54) \\\\  & =1-Φ(-1.54) \\\\  & =1-0.0618 \\\\  & =0.9382\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(-1.54<Z<1.54) & =Φ(1.54)-Φ(-1.54) \\\\  & =0.9382-0.0618 \\\\  & =0.8764.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-330908/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02d2757f-1179-5ad6-b8c7-5165ac3a3eff"] :knowledge-point/questions ["q-330908"] :db/ensure [:knowledge-point/validate]} {:db/id "q-183823/selection/a12ae6eeaf3c7c7547162ade0e794f002963bf9b6a5037a1ade2e126697f599f" :answer/id #uuid "2c0f7d7e-da31-57d6-9e0a-737052a11b40" :answer/type :answer.type/math :answer/value "0.2052" :db/ensure [:answer/validate]} {:db/id "q-183823/selection/c884e01618f431d13f1dbacc612d402562f8e26b5f65a9d19282d08d4f19c288" :answer/id #uuid "d6472c0f-c392-55de-af87-b1d37a685741" :answer/type :answer.type/math :answer/value "0.1428" :db/ensure [:answer/validate]} {:db/id "q-183823/selection/1265ee2847d1ef0fefb8dba26ba17d92491ffc0da00c2841b0c0cd03a8cad6a4" :answer/id #uuid "14580e4c-86ea-57d7-81c8-f9a8ed14a9a1" :answer/type :answer.type/math :answer/value "0.2206" :db/ensure [:answer/validate]} {:db/id "q-183823/selection/1c70ddad608de31bc635fd5ae0ce09a8e5395c3738228aabea193f07ad1c974e" :answer/id #uuid "03a4258d-e31e-5b4e-8983-7cd0f21cf929" :answer/type :answer.type/math :answer/value "0.1272" :db/ensure [:answer/validate]} {:db/id "q-183823/selection/90f79ae92a3df705bac16a741