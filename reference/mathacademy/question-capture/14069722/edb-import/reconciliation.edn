y/reference/mathacademy/question-capture/14069722/assets/3e4fb2143266d45a620bf39a978ba8ac4f0ed2585942f79dc90435a4896f9a0d.png)\n\nBy symmetry, this equals the area corresponding to the probability $P(Z>0.73).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/assets/6bb24449a20276b9d190e2b31926bb6e0d52f22536431e27c05db00b92886ffc.png)\n\nNote that the two shaded areas above have the same area. Therefore,\n\n$$\n\\begin{aligned}P(Z<-0.73) & =P(Z>0.73) \\\\  & =1-P(Z<0.73) \\\\  & =1-Φ(0.73) \\\\  & =1-0.7673 \\\\  & =0.2327.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/state.json" "file_sha256" "f38b28e68eb1c72046b151d63c599d8baf82ed4ee0a6819917072f7c857cf6bd"} {"question" "q-131532" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/activity-metadata.json" "file_sha256" "9675d43953465dc0c2310694be85278d058ad772405778d09e3fc4335832b01f"} {"question" "q-131532" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/state.json" "file_sha256" "f38b28e68eb1c72046b151d63c599d8baf82ed4ee0a6819917072f7c857cf6bd"} {"question" "q-131532" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.2136"] ["math" "0.2327"] ["math" "0.2470"] ["math" "0.7673"] ["math" "0.7849"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069722/state.json" "file_sha256" "f38b28e68eb1c72046b151d63c599d8baf82ed4ee0a6819917072f7c857cf6bd"} {"question" "q-131532" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.2327"] "category" "model_interpretation" "file" "