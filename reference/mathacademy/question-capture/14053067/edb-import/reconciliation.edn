x} & ⟹ &  & {f}^{″}(0) & =25\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+5x+\\frac{25}{2}{x}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053067/state.json" "file_sha256" "747bb39a98fe64df7969183f07bc09be3d489734ef3e7f4984bc8a9544b8f806"} {"question" "q-125085" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053067/activity-metadata.json" "file_sha256" "47d1ae260c7095f7a438aba91922a20e97b8e136db963ee009b8e1e595db6483"} {"question" "q-125085" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053067/state.json" "file_sha256" "747bb39a98fe64df7969183f07bc09be3d489734ef3e7f4984bc8a9544b8f806"} {"question" "q-125085" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1+5x+10{x}^{2}"] ["math" "1+5x+25{x}^{2}"] ["math" "1+5x+\\frac{10}{4}{x}^{2}"] ["math" "1+5x+\\frac{25}{2}{x}^{2}"] ["math" "1+5x+\\frac{5}{2}{x}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053067/state.json" "file_sha256" "747bb39a98fe64df7969183f07bc09be3d489734ef3e7f4984bc8a9544b8f806"} {"question" "q-125085" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1+5x+\\frac{25}{2}{x}^{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053067/state.json" "file_sha256" "747bb39a98fe64df7969183f07bc09be3d489734ef3e7f4984bc8a9544b8f806"}] "usage" {"q-125085" [] "q-50690" []} "basis" 1773 "retractions" [[175921