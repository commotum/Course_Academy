#{[{:db/id #edb/ref 17592186304739 :knowledge-point/_questions [{:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4" :knowledge-point/title "Finding the Second-Degree Taylor Polynomial of a Given Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e0fcec-c97b-5a0c-ba32-3254647525da" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+25{x}^{2}" :db/id #edb/ref 17592186304741} {:answer/id #uuid "6e268aa2-61b7-57bf-b621-9882faea7885" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+\\frac{5}{2}{x}^{2}" :db/id #edb/ref 17592186304742} {:answer/id #uuid "ddc3b40b-2747-5ebf-b8ac-7430b8d7fe8e" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+10{x}^{2}" :db/id #edb/ref 17592186304743} {:answer/id #uuid "d8ad4ab3-a782-5e87-be7d-14e14d47a8d6" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+\\frac{10}{4}{x}^{2}" :db/id #edb/ref 17592186304744} {:answer/id #uuid "f8c331de-f833-5ebe-86f9-d608e6752ab1" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+\\frac{25}{2}{x}^{2}" :db/id #edb/ref 17592186304745}] :answer-field/correct {:answer/id #uuid "f8c331de-f833-5ebe-86f9-d608e6752ab1" :answer/type {:db/ident :answer.type/math} :answer/value "1+5x+\\frac{25}{2}{x}^{2}" :db/id #edb/ref 17592186304745} :answer-field/id #uuid "6da36dfe-c74c-5b8d-b8ef-ab3c570d22a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304740}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "443233e2-c490-5eba-a149-cc94e7ac316d" :question/math-academy-id "q-125085" :question/problem "The second-degree Taylor polynomial of $f(x)={e}^{5x}$ about $x=0$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & ={e}^{5x} & ⟹ &  & f(0) & =1 \\\\ {f}^{′}(x) & =5{e}^{5x} & ⟹ &  & {f}^{′}(0) & =5 \\\\ {f}^{″}(x) & =25{e}^{5x} & ⟹ &  & {f}^{″}(0) & =25\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+5x+\\frac{25}{2}{x}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101374 :knowledge-point/_questions [{:knowledge-point/id #uuid "039f9f0b-70dd-5360-9240-2260ff706c93" :knowledge-point/title "Finding a Coefficient in a Second-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b26ab1b3-a00c-53ce-b0d1-0a0b06136d75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186099841} {:answer/id #uuid "393a100a-dd40-59b8-a100-09fd20f355de" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{27}" :db/id #edb/ref 17592186099842} {:answer/id #uuid "3c425eeb-88b8-525a-bb6a-4237d513e613" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{81}" :db/id #edb/ref 17592186099843} {:answer/id #uuid "5b614bbc-764e-5844-947d-c7c0eb3819d8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9}" :db/id #edb/ref 17592186099844} {:answer/id #uuid "7630dd7b-5cec-5f3c-b632-ead6b7a41690" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186099845}] :answer-field/correct {:answer/id #uuid "b26ab1b3-a00c-53ce-b0d1-0a0b06136d75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186099841} :answer-field/id #uuid "a0a2ea04-bc38-5193-a87a-2b597e24ed56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099840}] :question/id #uuid "80807571-ee20-5110-be5c-308f4935082c" :question/math-academy-id "q-50690" :question/problem "What is the coefficient of $x^{2}$ in the second-degree Taylor polynomial of $f(x) = \\frac{1}{3 + x}$ at $x = 0$?"}]}
