#{[{:db/id #edb/ref 17592186388890 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c235b344-972e-5ebe-9391-e8507bc8fbaf" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186388892} {:answer/id #uuid "1c321f50-6f5b-57b7-b89c-2236077f1244" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186388893} {:answer/id #uuid "ce5d6e78-fc4f-57a1-91b7-e7bc74d4f249" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{4}" :db/id #edb/ref 17592186388894} {:answer/id #uuid "49427d11-21bf-56d2-b648-1bba185e669c" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186388895} {:answer/id #uuid "a303bbe6-57aa-5b31-a034-cd1096d6e129" :answer/type {:db/ident :answer.type/math} :answer/value "x=2,4" :db/id #edb/ref 17592186388896}] :answer-field/correct {:answer/id #uuid "49427d11-21bf-56d2-b648-1bba185e669c" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2}" :db/id #edb/ref 17592186388895} :answer-field/id #uuid "d9e46c4a-a417-5e2b-b4f1-bd6c720b50f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388891}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a00d81d6-68f0-5e48-a9c1-67cc26baceef" :question/math-academy-id "q-103541" :question/problem "Let $a=⟨-3,2,0⟩,$ $b=⟨2,-4,2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{77}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 2 & 0 \\\\ 2 & -4 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ -4 & 2x\\end{aligned}|i-|\\begin{aligned}-3 & 0 \\\\ 2 & 2x\\end{aligned}|j+|\\begin{aligned}-3 & 2 \\\\ 2 & -4\\end{aligned}|k \\\\  & =(4x-0)i-(-6x-0)j+(12-4)k \\\\  & =⟨4x,6x,8⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(6x)^{2}+(8)^{2}} \\\\  & =\\sqrt{16{x}^{2}+36{x}^{2}+64} \\\\  & =\\sqrt{52{x}^{2}+64}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{77} \\\\ \\sqrt{52{x}^{2}+64} & =\\sqrt{77} \\\\ 52{x}^{2}+64 & =77 \\\\ 52{x}^{2} & =13 \\\\ {x}^{2} & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186388897 :knowledge-point/_questions [{:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/title "Solving for an Unknown in an Equation Involving the Cross Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ec4b6fc-357a-5cb9-a7ad-e1c6cf3f268d" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 10" :db/id #edb/ref 17592186388899} {:answer/id #uuid "7092078f-850b-5b65-b7d2-a97ca6904d57" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2,\\,1" :db/id #edb/ref 17592186388900} {:answer/id #uuid "73ddea97-0727-5299-a4b7-c4a8ba4aa019" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,10" :db/id #edb/ref 17592186388901} {:answer/id #uuid "0d3f121a-0770-5330-9c4c-d8daffa64bb4" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186388902} {:answer/id #uuid "3e4b42ea-69a7-5ec0-b057-1b7cce695032" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5,\\,2" :db/id #edb/ref 17592186388903}] :answer-field/correct {:answer/id #uuid "3e4b42ea-69a7-5ec0-b057-1b7cce695032" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5,\\,2" :db/id #edb/ref 17592186388903} :answer-field/id #uuid "1feabf27-8611-5959-8d1a-66e0182c2aab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388898}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ec2237d8-ce94-5e3f-a6e3-ffd58ec607ef" :question/math-academy-id "q-103549" :question/problem "Let $a=⟨0,3,4⟩,$ $b=⟨-1,-x,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{221}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ -1 & -x & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 4 \\\\ -x & 2\\end{aligned}|i-|\\begin{aligned}0 & 4 \\\\ -1 & 2\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ -1 & -x\\end{aligned}|k \\\\  & =(6+4x)i-(0+4)j+(0+3)k \\\\  & =⟨6+4x,-4,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(6+4x)^{2}+(-4)^{2}+(3)^{2}} \\\\  & =\\sqrt{36+48x+16{x}^{2}+16+9} \\\\  & =\\sqrt{61+48x+16{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{221} \\\\ \\sqrt{61+48x+16{x}^{2}} & =\\sqrt{221} \\\\ 61+48x+16{x}^{2} & =221 \\\\ 16{x}^{2}+48x-160 & =0 \\\\ {x}^{2}+3x-10 & =0 \\\\ (x+5)(x-2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-5,\\,2.$"}] [{:db/id #edb/ref 17592186304140 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4212f4-d006-5297-af36-1a524a7e0e1a" :answer/type {:db/ident :answer.type/math} :answer/value "-2j+3k" :db/id #edb/ref 17592186304142} {:answer/id #uuid "a7f86920-d48b-5bb1-929a-47d877dcb03e" :answer/type {:db/ident :answer.type/math} :answer/value "i-3j+6k" :db/id #edb/ref 17592186304143} {:answer/id #uuid "db451de7-5d82-5de4-acb8-dde80233194d" :answer/type {:db/ident :answer.type/math} :answer/value "i-2j+4k" :db/id #edb/ref 17592186304144} {:answer/id #uuid "0cef887d-ea75-5f48-ba74-3864a6efb0ca" :answer/type {:db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186304145} {:answer/id #uuid "0e02933d-8cdf-58b3-af7a-0425474c7883" :answer/type {:db/ident :answer.type/math} :answer/value "3i+2j-4k" :db/id #edb/ref 17592186304146}] :answer-field/correct {:answer/id #uuid "0cef887d-ea75-5f48-ba74-3864a6efb0ca" :answer/type {:db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186304145} :answer-field/id #uuid "7428cc9d-be23-51c5-8628-2d9194a400da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304141}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "032ca46b-c982-5019-abec-409ae74b9ee6" :question/math-academy-id "q-1396" :question/problem "Let $a=4i+2j-k$ and $b=2i+2j-k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ 2 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ 2 & -1\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ 2 & 2\\end{aligned}|k \\\\  & =(2\\cdot (-1)-(-1)\\cdot 2)i-(4\\cdot (-1)-(-1)\\cdot 2)j+(4\\cdot 2-2\\cdot 2)k \\\\  & =(-2+2)i-(-4+2)j+(8-4)k \\\\  & =2j+4k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304154 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993a98d4-20cd-566d-9f82-3ffbeedf8a75" :answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186304156} {:answer/id #uuid "40a4553f-8bda-55f4-a2ea-1b4c6ed6ab65" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186388904}] :answer-field/correct {:answer/id #uuid "993a98d4-20cd-566d-9f82-3ffbeedf8a75" :answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186304156} :answer-field/id #uuid "1795bf82-ea19-50ff-bc2a-07f8a600d105" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304155} {:answer-field/choices [{:answer/id #uuid "c7e6b2f5-b760-56bc-a31b-b8c0afa2c37f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186304158}] :answer-field/correct {:answer/id #uuid "c7e6b2f5-b760-56bc-a31b-b8c0afa2c37f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186304158} :answer-field/id #uuid "b8b30046-a2be-5c15-a0c3-c09a040b3785" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304157} {:answer-field/choices [{:answer/id #uuid "db66174d-aea5-5fa7-8a2b-273d64b55553" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186304160}] :answer-field/correct {:answer/id #uuid "db66174d-aea5-5fa7-8a2b-273d64b55553" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186304160} :answer-field/id #uuid "fc98d800-e65e-5497-a49b-af01b8892bc3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304159}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e5b2e711-c105-5c4d-9045-58a44fcaf370" :question/math-academy-id "q-282143" :question/problem "Let $a=3i-4j+k$ and $b=-2i+5j+6k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -2 & 5 & 6\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 5 & 6\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -2 & 6\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -2 & 5\\end{aligned}|k \\\\  & =((-4)(6)-(1)(5))i-((3)(6)-(1)(-2))j+((3)(5)-(-4)(-2))k \\\\  & =(-24-5)i-(18+2)j+(15-8)k \\\\  & =-29\\,i-20\\,j+7\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318103 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdd9955a-377f-5d76-8eb5-9fadd44cba22" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186318105} {:answer/id #uuid "782ad791-7780-514b-9c8a-49517256f889" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186318106}] :answer-field/correct {:answer/id #uuid "782ad791-7780-514b-9c8a-49517256f889" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186318106} :answer-field/id #uuid "12874d1c-11ec-5996-85dd-d4a12794eb59" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318104} {:answer-field/choices [{:answer/id #uuid "b11176b1-86a4-5508-9060-761f97effa51" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186318108}] :answer-field/correct {:answer/id #uuid "b11176b1-86a4-5508-9060-761f97effa51" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186318108} :answer-field/id #uuid "67913577-bdc9-5e12-b26c-777c50a8e9ea" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318107} {:answer-field/choices [{:answer/id #uuid "287b3087-a03c-51cf-bdc9-66f4f54eed87" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318110}] :answer-field/correct {:answer/id #uuid "287b3087-a03c-51cf-bdc9-66f4f54eed87" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186318110} :answer-field/id #uuid "e6ab4b56-2e7a-54d3-8a94-460f157f427b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318109}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6572ddc0-25ae-52d8-b154-215a4d77456a" :question/math-academy-id "q-282145" :question/problem "Let $a=-6i+3j+2k$ and $b=4i-j+5k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,-\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -6 & 3 & 2 \\\\ 4 & -1 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ -1 & 5\\end{aligned}|i-|\\begin{aligned}-6 & 2 \\\\ 4 & 5\\end{aligned}|j+|\\begin{aligned}-6 & 3 \\\\ 4 & -1\\end{aligned}|k \\\\  & =(3\\cdot 5-2\\cdot -1)i-(-6\\cdot 5-2\\cdot 4)j+(-6\\cdot -1-3\\cdot 4)k \\\\  & =(15+2)i-(-30-8)j+(6-12)k \\\\  & =17\\,i+38\\,j-6\\,k\\end{aligned}\n$$"}]}
