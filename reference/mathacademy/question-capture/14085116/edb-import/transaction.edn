[{:db/id "q-103541/selection/a869d0e88ffced7d6d9f6ba0e40ce1a27c2d4cababfdddf641f153f4e11398a6" :answer/id #uuid "ce5d6e78-fc4f-57a1-91b7-e7bc74d4f249" :answer/type :answer.type/math :answer/value "x=\\pm \\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-103541/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" :answer/id #uuid "c235b344-972e-5ebe-9391-e8507bc8fbaf" :answer/type :answer.type/math :answer/value "x=\\pm 2" :db/ensure [:answer/validate]} {:db/id "q-103541/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" :answer/id #uuid "1c321f50-6f5b-57b7-b89c-2236077f1244" :answer/type :answer.type/math :answer/value "x=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-103541/selection/bff57b94ed551cdac19267d82aba0423246854660abc886321e7341bf59a3dee" :answer/id #uuid "a303bbe6-57aa-5b31-a034-cd1096d6e129" :answer/type :answer.type/math :answer/value "x=2,4" :db/ensure [:answer/validate]} {:db/id "q-103541/selection/b851a0bbb5a082def41f78b7651a85b9fb9b309ca5c7943c3b94220fefbe8287" :answer/id #uuid "49427d11-21bf-56d2-b648-1bba185e669c" :answer/type :answer.type/math :answer/value "x=\\pm \\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-103541/selection" :answer-field/id #uuid "d9e46c4a-a417-5e2b-b4f1-bd6c720b50f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103541/selection/b851a0bbb5a082def41f78b7651a85b9fb9b309ca5c7943c3b94220fefbe8287" :answer-field/choices ["q-103541/selection/a869d0e88ffced7d6d9f6ba0e40ce1a27c2d4cababfdddf641f153f4e11398a6" "q-103541/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" "q-103541/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" "q-103541/selection/bff57b94ed551cdac19267d82aba0423246854660abc886321e7341bf59a3dee" "q-103541/selection/b851a0bbb5a082def41f78b7651a85b9fb9b309ca5c7943c3b94220fefbe8287"] :db/ensure [:answer-field/validate]} {:db/id "q-103541" :question/id #uuid "a00d81d6-68f0-5e48-a9c1-67cc26baceef" :question/math-academy-id "q-103541" :question/problem "Let $a=⟨-3,2,0⟩,$ $b=⟨2,-4,2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{77}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 2 & 0 \\\\ 2 & -4 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ -4 & 2x\\end{aligned}|i-|\\begin{aligned}-3 & 0 \\\\ 2 & 2x\\end{aligned}|j+|\\begin{aligned}-3 & 2 \\\\ 2 & -4\\end{aligned}|k \\\\  & =(4x-0)i-(-6x-0)j+(12-4)k \\\\  & =⟨4x,6x,8⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(6x)^{2}+(8)^{2}} \\\\  & =\\sqrt{16{x}^{2}+36{x}^{2}+64} \\\\  & =\\sqrt{52{x}^{2}+64}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{77} \\\\ \\sqrt{52{x}^{2}+64} & =\\sqrt{77} \\\\ 52{x}^{2}+64 & =77 \\\\ 52{x}^{2} & =13 \\\\ {x}^{2} & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103541/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-103541"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103549/selection/1556f670f30d400f42e4e1f0b4ff5cdc92ebcb0c9c4696038365c18a666316bb" :answer/id #uuid "7092078f-850b-5b65-b7d2-a97ca6904d57" :answer/type :answer.type/math :answer/value "x=-2,\\,1" :db/ensure [:answer/validate]} {:db/id "q-103549/selection/00816b3d2904fdebb89c16e605f98828221aff2033cdcc44cbbbfe61658197c8" :answer/id #uuid "4ec4b6fc-357a-5cb9-a7ad-e1c6cf3f268d" :answer/type :answer.type/math :answer/value "x=\\pm 10" :db/ensure [:answer/validate]} {:db/id "q-103549/selection/567b5b3a9bca761d6f8766b72369b905a179b7daabac761c0ced4c700c106ef0" :answer/id #uuid "73ddea97-0727-5299-a4b7-c4a8ba4aa019" :answer/type :answer.type/math :answer/value "x=-1,\\,10" :db/ensure [:answer/validate]} {:db/id "q-103549/selection/e5715d173dee108c299615c50d66a459f8dfdfd2d0c8db0375ada746e91a63fd" :answer/id #uuid "3e4b42ea-69a7-5ec0-b057-1b7cce695032" :answer/type :answer.type/math :answer/value "x=-5,\\,2" :db/ensure [:answer/validate]} {:db/id "q-103549/selection/5b073700a15034eef9d86418d2beb7a48945becaf327bea65b414b48e0abd8e1" :answer/id #uuid "0d3f121a-0770-5330-9c4c-d8daffa64bb4" :answer/type :answer.type/math :answer/value "x=\\pm 1" :db/ensure [:answer/validate]} {:db/id "q-103549/selection" :answer-field/id #uuid "1feabf27-8611-5959-8d1a-66e0182c2aab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103549/selection/e5715d173dee108c299615c50d66a459f8dfdfd2d0c8db0375ada746e91a63fd" :answer-field/choices ["q-103549/selection/1556f670f30d400f42e4e1f0b4ff5cdc92ebcb0c9c4696038365c18a666316bb" "q-103549/selection/00816b3d2904fdebb89c16e605f98828221aff2033cdcc44cbbbfe61658197c8" "q-103549/selection/567b5b3a9bca761d6f8766b72369b905a179b7daabac761c0ced4c700c106ef0" "q-103549/selection/e5715d173dee108c299615c50d66a459f8dfdfd2d0c8db0375ada746e91a63fd" "q-103549/selection/5b073700a15034eef9d86418d2beb7a48945becaf327bea65b414b48e0abd8e1"] :db/ensure [:answer-field/validate]} {:db/id "q-103549" :question/id #uuid "ec2237d8-ce94-5e3f-a6e3-ffd58ec607ef" :question/math-academy-id "q-103549" :question/problem "Let $a=⟨0,3,4⟩,$ $b=⟨-1,-x,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{221}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ -1 & -x & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 4 \\\\ -x & 2\\end{aligned}|i-|\\begin{aligned}0 & 4 \\\\ -1 & 2\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ -1 & -x\\end{aligned}|k \\\\  & =(6+4x)i-(0+4)j+(0+3)k \\\\  & =⟨6+4x,-4,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(6+4x)^{2}+(-4)^{2}+(3)^{2}} \\\\  & =\\sqrt{36+48x+16{x}^{2}+16+9} \\\\  & =\\sqrt{61+48x+16{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{221} \\\\ \\sqrt{61+48x+16{x}^{2}} & =\\sqrt{221} \\\\ 61+48x+16{x}^{2} & =221 \\\\ 16{x}^{2}+48x-160 & =0 \\\\ {x}^{2}+3x-10 & =0 \\\\ (x+5)(x-2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-5,\\,2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103549/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-103549"] :db/ensure [:knowledge-point/validate]} {:db/id "q-282143/field-1/ebe3072a1dd0240f82f7c04e06603ef971401ed1aea6a421c38664ef5adb09f3" :answer/id #uuid "40a4553f-8bda-55f4-a2ea-1b4c6ed6ab65" :answer/type :answer.type/math :answer/value "29" :db/ensure [:answer/validate]} {:db/id 17592186304155 :answer-field/choices ["q-282143/field-1/ebe3072a1dd0240f82f7c04e06603ef971401ed1aea6a421c38664ef5adb09f3"] :db/ensure [:answer-field/validate]}]
