a_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/state.json" "file_sha256" "c67ab59a49029f9e2c4f22a62a9d91369e26fc6ab6019728ac68fd5c32866ba8" "basis" 1386 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/edb-import/verification.json"} {"question" "q-282145" "field" nil "attribute" "question/problem" "value" "Let $a=-6i+3j+2k$ and $b=4i-j+5k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,+\\,$\n{{field-2}}$\\,j\\,-\\,$\n{{field-3}}$\\,k$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/state.json" "file_sha256" "023bb5df0675be4a565cba8dcd76f607ded559136262dfd96e7fd94b70a7732e" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"} {"question" "q-282145" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -6 & 3 & 2 \\\\ 4 & -1 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ -1 & 5\\end{aligned}|i-|\\begin{aligned}-6 & 2 \\\\ 4 & 5\\end{aligned}|j+|\\begin{aligned}-6 & 3 \\\\ 4 & -1\\end{aligned}|k \\\\  & =(3\\cdot 5-2\\cdot -1)i-(-6\\cdot 5-2\\cdot 4)j+(-6\\cdot -1-3\\cdot 4)k \\\\  & =(15+2)i-(-30-8)j+(6-12)k \\\\  & =17\\,i+38\\,j-6\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/state.json" "file_sha256" "023bb5df0675be4a565cba8dcd76f607ded559136262dfd96e7fd94b70a7732e" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"} {"question" "q-282145" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/activity-metadata.json" "file_sha256" "1f9593abe2bcd968550617c130879f834c4232f5e69de9554b6a95fa36c71400" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"} {"question" "q-282145" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/state.json" "file_sha256" "023bb5df0675be4a565cba8dcd76f607ded559136262dfd96e7fd94b70a7732e" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"} {"question" "q-282145" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/state.json" "file_sha256" "023bb5df0675be4a565cba8dcd76f607ded559136262dfd96e7fd94b70a7732e" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"} {"question" "q-282145" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/state.json" "file_sha256" "023bb5df0675be4a565cba8dcd76f607ded559136262dfd96e7fd94b70a7732e" "basis" 1583 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042784/edb-import/verification.json"}] "sources" [{"question" "q-1396" "field" nil "attribute" "question/problem" "value" "Let $a=4i+2j-k$ and $b=2i+2j-k.$ Find $a\\times b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-1396" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ 2 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ 2 & -1\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ 2 & 2\\end{aligned}|k \\\\  & =(2\\cdot (-1)-(-1)\\cdot 2)i-(4\\cdot (-1)-(-1)\\cdot 2)j+(4\\cdot 2-2\\cdot 2)k \\\\  & =(-2+2)i-(-4+2)j+(8-4)k \\\\  & =2j+4k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-1396" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/activity-metadata.json" "file_sha256" "d07a52595030bf36f384115cfda2a59c0e11c561b7e25a997306ca44da2ef130"} {"question" "q-1396" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-1396" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2j+3k"] ["math" "2j+4k"] ["math" "3i+2j-4k"] ["math" "i-2j+4k"] ["math" "i-3j+6k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-1396" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2j+4k"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103541" "field" nil "attribute" "question/problem" "value" "Let $a=⟨-3,2,0⟩,$ $b=⟨2,-4,2x⟩$ and $|\\,a\\times b\\,|=\\sqrt{77}.$ Find $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103541" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 2 & 0 \\\\ 2 & -4 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ -4 & 2x\\end{aligned}|i-|\\begin{aligned}-3 & 0 \\\\ 2 & 2x\\end{aligned}|j+|\\begin{aligned}-3 & 2 \\\\ 2 & -4\\end{aligned}|k \\\\  & =(4x-0)i-(-6x-0)j+(12-4)k \\\\  & =⟨4x,6x,8⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(4x)^{2}+(6x)^{2}+(8)^{2}} \\\\  & =\\sqrt{16{x}^{2}+36{x}^{2}+64} \\\\  & =\\sqrt{52{x}^{2}+64}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{77} \\\\ \\sqrt{52{x}^{2}+64} & =\\sqrt{77} \\\\ 52{x}^{2}+64 & =77 \\\\ 52{x}^{2} & =13 \\\\ {x}^{2} & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\frac{1}{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103541" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/activity-metadata.json" "file_sha256" "d07a52595030bf36f384115cfda2a59c0e11c561b7e25a997306ca44da2ef130"} {"question" "q-103541" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103541" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=2,4"] ["math" "x=\\pm 2"] ["math" "x=\\pm 4"] ["math" "x=\\pm \\frac{1}{2}"] ["math" "x=\\pm \\frac{1}{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103541" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=\\pm \\frac{1}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103549" "field" nil "attribute" "question/problem" "value" "Let $a=⟨0,3,4⟩,$ $b=⟨-1,-x,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{221}.$ Find $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103549" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 4 \\\\ -1 & -x & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 4 \\\\ -x & 2\\end{aligned}|i-|\\begin{aligned}0 & 4 \\\\ -1 & 2\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ -1 & -x\\end{aligned}|k \\\\  & =(6+4x)i-(0+4)j+(0+3)k \\\\  & =⟨6+4x,-4,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(6+4x)^{2}+(-4)^{2}+(3)^{2}} \\\\  & =\\sqrt{36+48x+16{x}^{2}+16+9} \\\\  & =\\sqrt{61+48x+16{x}^{2}}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{221} \\\\ \\sqrt{61+48x+16{x}^{2}} & =\\sqrt{221} \\\\ 61+48x+16{x}^{2} & =221 \\\\ 16{x}^{2}+48x-160 & =0 \\\\ {x}^{2}+3x-10 & =0 \\\\ (x+5)(x-2) & =0.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-5,\\,2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103549" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/activity-metadata.json" "file_sha256" "d07a52595030bf36f384115cfda2a59c0e11c561b7e25a997306ca44da2ef130"} {"question" "q-103549" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103549" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=-1,\\,10"] ["math" "x=-2,\\,1"] ["math" "x=-5,\\,2"] ["math" "x=\\pm 1"] ["math" "x=\\pm 10"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14085116/state.json" "file_sha256" "b84f47cd8a8499828d7fb9c61221ad35bd7dfd491396045489b55251dea1d9fa"} {"question" "q-103549" "field" "selectio