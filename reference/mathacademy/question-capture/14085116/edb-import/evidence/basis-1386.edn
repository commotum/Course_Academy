#{[{:db/id #edb/ref 17592186304140 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4212f4-d006-5297-af36-1a524a7e0e1a" :answer/type {:db/ident :answer.type/math} :answer/value "-2j+3k" :db/id #edb/ref 17592186304142} {:answer/id #uuid "a7f86920-d48b-5bb1-929a-47d877dcb03e" :answer/type {:db/ident :answer.type/math} :answer/value "i-3j+6k" :db/id #edb/ref 17592186304143} {:answer/id #uuid "db451de7-5d82-5de4-acb8-dde80233194d" :answer/type {:db/ident :answer.type/math} :answer/value "i-2j+4k" :db/id #edb/ref 17592186304144} {:answer/id #uuid "0cef887d-ea75-5f48-ba74-3864a6efb0ca" :answer/type {:db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186304145} {:answer/id #uuid "0e02933d-8cdf-58b3-af7a-0425474c7883" :answer/type {:db/ident :answer.type/math} :answer/value "3i+2j-4k" :db/id #edb/ref 17592186304146}] :answer-field/correct {:answer/id #uuid "0cef887d-ea75-5f48-ba74-3864a6efb0ca" :answer/type {:db/ident :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186304145} :answer-field/id #uuid "7428cc9d-be23-51c5-8628-2d9194a400da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304141}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "032ca46b-c982-5019-abec-409ae74b9ee6" :question/math-academy-id "q-1396" :question/problem "Let $a=4i+2j-k$ and $b=2i+2j-k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ 2 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ 2 & -1\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ 2 & 2\\end{aligned}|k \\\\  & =(2\\cdot (-1)-(-1)\\cdot 2)i-(4\\cdot (-1)-(-1)\\cdot 2)j+(4\\cdot 2-2\\cdot 2)k \\\\  & =(-2+2)i-(-4+2)j+(8-4)k \\\\  & =2j+4k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304154 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "993a98d4-20cd-566d-9f82-3ffbeedf8a75" :answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186304156}] :answer-field/correct {:answer/id #uuid "993a98d4-20cd-566d-9f82-3ffbeedf8a75" :answer/type {:db/ident :answer.type/math} :answer/value "-29" :db/id #edb/ref 17592186304156} :answer-field/id #uuid "1795bf82-ea19-50ff-bc2a-07f8a600d105" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304155} {:answer-field/choices [{:answer/id #uuid "c7e6b2f5-b760-56bc-a31b-b8c0afa2c37f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186304158}] :answer-field/correct {:answer/id #uuid "c7e6b2f5-b760-56bc-a31b-b8c0afa2c37f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186304158} :answer-field/id #uuid "b8b30046-a2be-5c15-a0c3-c09a040b3785" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304157} {:answer-field/choices [{:answer/id #uuid "db66174d-aea5-5fa7-8a2b-273d64b55553" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186304160}] :answer-field/correct {:answer/id #uuid "db66174d-aea5-5fa7-8a2b-273d64b55553" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186304160} :answer-field/id #uuid "fc98d800-e65e-5497-a49b-af01b8892bc3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304159}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e5b2e711-c105-5c4d-9045-58a44fcaf370" :question/math-academy-id "q-282143" :question/problem "Let $a=3i-4j+k$ and $b=-2i+5j+6k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,+\\,$\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -2 & 5 & 6\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 5 & 6\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -2 & 6\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -2 & 5\\end{aligned}|k \\\\  & =((-4)(6)-(1)(5))i-((3)(6)-(1)(-2))j+((3)(5)-(-4)(-2))k \\\\  & =(-24-5)i-(18+2)j+(15-8)k \\\\  & =-29\\,i-20\\,j+7\\,k\\end{aligned}\n$$"}]}
