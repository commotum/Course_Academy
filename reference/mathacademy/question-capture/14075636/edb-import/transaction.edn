academy-id "q-38174" :question/problem "Find the value of $|\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 5 & 2 \\\\ 1 & 0 & -4\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-1 & 0 & 3 \\\\ 0 & 5 & 2 \\\\ 1 & 0 & -4\\end{aligned}| & =(-1)|\\begin{aligned}5 & 2 \\\\ 0 & -4\\end{aligned}|-0|\\begin{aligned}0 & 2 \\\\ 1 & -4\\end{aligned}|+3|\\begin{aligned}0 & 5 \\\\ 1 & 0\\end{aligned}| \\\\  & =-1(-20-0)-0+3(0-5) \\\\  & =(-1)\\cdot (-20)+3\\cdot (-5) \\\\  & =20-15 \\\\  & =5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-38174/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07"] :knowledge-point/questions ["q-38174"] :db/ensure [:knowledge-point/validate]} {:db/id "q-38124/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "70a225fc-74cc-58cd-a6cd-7814998ee80d" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-38124/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "4b15cf7d-2c15-57ab-bf56-b81e5ed3ffe5" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-38124/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "e3ffe942-9ea7-5d25-b8ac-0ef3f37f8a30" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-38124/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "44959884-50ca-520d-8383-e92bc110ef84" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-38124/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "d8458d00-6dcb-5e