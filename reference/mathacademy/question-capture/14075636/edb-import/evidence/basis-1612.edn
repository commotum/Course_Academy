#{[{:db/id #edb/ref 17592186320311 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5864ebc-bd7f-518a-ae9b-cfcd1031f011" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186320313} {:answer/id #uuid "e053aafa-15e9-53d8-b693-05a611f29ea3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $8$ only" :db/id #edb/ref 17592186320314} {:answer/id #uuid "8d870840-8390-59b1-9bf4-6f4cc2c09cf8" :answer/type {:db/ident :answer.type/text} :answer/value "$-5$ and $1$ only" :db/id #edb/ref 17592186320315} {:answer/id #uuid "308cd1c5-fdc4-50d9-a9ee-e91c144ed145" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ only" :db/id #edb/ref 17592186320316} {:answer/id #uuid "d6454265-e507-5721-bd63-f7e365b93e7b" :answer/type {:db/ident :answer.type/text} :answer/value "$-6$ and $3$ only" :db/id #edb/ref 17592186320317}] :answer-field/correct {:answer/id #uuid "e053aafa-15e9-53d8-b693-05a611f29ea3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $8$ only" :db/id #edb/ref 17592186320314} :answer-field/id #uuid "653b22c2-ac63-55f3-b4fb-7b1a85208b53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320312}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "30a80f14-b653-5ec9-a12d-20d43bb40f91" :question/math-academy-id "q-128506" :question/problem "Given that the determinant of\n$[\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}]$\nis $-29$, find all the possible values of $m.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $m:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 6 & m \\\\ m & 3 & 0 \\\\ 2 & 1 & 1\\end{aligned}| & =1|\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}|-6|\\begin{aligned}m & 0 \\\\ 2 & 1\\end{aligned}|+m|\\begin{aligned}m & 3 \\\\ 2 & 1\\end{aligned}| \\\\  & =(3-0)-6(m-0)+m(m-6) \\\\  & =3-6m+{m}^{2}-6m \\\\  & ={m}^{2}-12m+3\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-29,$ we have:\n\n$$\n\\begin{aligned}{m}^{2}-12m+3 & =-29 \\\\ {m}^{2}-12m+32 & =0 \\\\ m & =\\frac{-(-12)\\pm \\sqrt{{12}^{2}-4\\cdot 1\\cdot 32}}{2\\cdot 1} \\\\  & =\\frac{12\\pm \\sqrt{16}}{2} \\\\  & =\\frac{12\\pm 4}{2} \\\\  & =6\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $m=4$ and $m=8.$"}]}
