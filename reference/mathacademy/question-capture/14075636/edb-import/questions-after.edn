er/id #uuid "ba5ab3a4-a23e-5d98-a856-53bd180f6638" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186382715} {:answer/id #uuid "a58c1343-7f9b-5ade-866f-c49a992fadd9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186382716}] :answer-field/correct {:answer/id #uuid "322d15df-c2a3-5a81-b0ae-2f1b5488d6f8" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186382714} :answer-field/id #uuid "6efe6246-d1db-5a32-bfa4-33acdd2eee4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382711}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6560a8c3-9190-54f7-a7a3-0816e210c8a1" :question/math-academy-id "q-38176" :question/problem "Find the value of $|\\begin{aligned}6 & 0 & 7 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}6 & 0 & 7 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & -1\\end{aligned}| & =6|\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}|-0|\\begin{aligned}0 & 0 \\\\ 1 & -1\\end{aligned}|+7|\\begin{aligned}0 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =6(-2-0)-0+7(0-2) \\\\  & =6\\cdot (-2)+7\\cdot (-2) \\\\  & =-12-14 \\\\  & =-26\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382717 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6e400dd-e15a-5c70-9ea8-d79b4678a3af" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382719} {:answer/id #uuid "5987a13b-36d8-5878-86bb-d89d007e2f87" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382720} {:answer/id #uuid "7f7be161-d6a6-5e3d-ae84-046cac1fe11e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382721} {:answer/id #uuid "6c76a0cb-b92b-53a0-a6a6-ce3e8d11fbf0" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382722} {:answer/id #uuid "79c205fb-c281-5bc7-a08d-5148321446c5" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382723}] :answer-field/correct {:answer/id #uuid "5987a13b-36d8-5878-86bb-d89d007e2f87" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382720} :answer-field/id #uuid "14fc5fd3-acb1-5e2d-848c-f71765f05031" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382718}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "08581ff2-f136-5cd3-82eb-06aac34673a0" :question/math-academy-id "q-38179" :question/problem "Which of the following statements are true regarding the matrix $E$ given below?\n\n- $E$ is a singular matrix\n- $E$ is **not**  a singular matrix\n- $det(E)=-2$\n\n$$\nE=[\\begin{aligned}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(E) & =|\\begin{aligned}\\frac{2}{3} & 3 & 4 \\\\ \\frac{2}{3} & 5 & 6 \\\\ \\frac{2}{3} & 7 & 8\\end{aligned}| \\\\  & =\\frac{2}{3}|\\begin{aligned}5 & 6 \\\\ 7 & 8\\end{aligned}|-3|\\begin{aligned}\\frac{2}{3} & 6 \\\\ \\frac{2}{3} & 8\\end{aligned}|+4|\\begin{aligned}\\frac{2}{3} & 5 \\\\ \\frac{2}{3} & 7\\end{aligned}| \\\\  & =\\frac{2}{3}(40-42)-3(\\frac{16}{3}-\\frac{12}{3})+4(\\frac{14}{3}-\\frac{10}{3}) \\\\  & =\\frac{2}{3}\\cdot (-2)-3\\cdot \\frac{4}{3}+4\\cdot \\frac{4}{3} \\\\  & =-\\frac{4}{3}-\\frac{12}{3}+\\frac{16}{3} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(E)=0$, the matrix is singular. \n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186382724 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae5bd86d-d5f8-5e04-87b9-25d303f20062" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186382726} {:answer/id #uuid "8a124bf0-1bdb-5e69-9294-36fdc430c8a0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382727} {:answer/id #uuid "544eab82-41ec-557e-80f7-10720247f011" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382728} {:answer/id #uuid "b0a9e27c-f893-5b0d-877f-04b4bd34735a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382729} {:answer/id #uuid "9a234bb1-11b9-5b3e-8ef5-8410508acc87" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382730}] :answer-field/correct {:answer/id #uuid "9a234bb1-11b9-5b3e-8ef5-8410508acc87" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382730} :answer-field/id #uuid "7a8f03f3-eb38-540e-bdfe-b2d7ec4fcb96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382725}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a5eb8a6b-37c6-54e6-b340-18101dbf3f8f" :question/math-academy-id "q-38187" :question/problem "Which of the following statements are true regarding the matrix $N$ given below?\n\n- $N$ is **not** a singular matrix\n- $N$ is a singular matrix\n- $det(N)=-1$\n\n$$\nN=[\\begin{aligned}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(N) & =|\\begin{aligned}\\frac{1}{7} & 3 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 4 & -\\frac{1}{7} \\\\ \\frac{1}{7} & 5 & -\\frac{1}{7}\\end{aligned}| \\\\  & =\\frac{1}{7}|\\begin{aligned}4 & -\\frac{1}{7} \\\\ 5 & -\\frac{1}{7}\\end{aligned}|-3|\\begin{aligned}\\frac{1}{7} & -\\frac{1}{7} \\\\ \\frac{1}{7} & -\\frac{1}{7}\\end{aligned}|+(-\\frac{1}{7})|\\begin{aligned}\\frac{1}{7} & 4 \\\\ \\frac{1}{7} & 5\\end{aligned}| \\\\  & =\\frac{1}{7}(-\\frac{4}{7}+\\frac{5}{7})-3(-\\frac{1}{49}+\\frac{1}{49})-\\frac{1}{7}(\\frac{5}{7}-\\frac{4}{7}) \\\\  & =\\frac{1}{7}\\cdot \\frac{1}{7}-3\\cdot 0-\\frac{1}{7}\\cdot \\frac{1}{7} \\\\  & =\\frac{1}{49}-\\frac{1}{49} \\\\  & =0\\end{aligned}\n$$\n\nSince $det(N)=0$, the matrix is singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186303350 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9def4b4a-1dd6-546f-a05a-5cec780136ac" :answer/type {:db/ident :answer.type/text} :answer/value "I  only" :db/id #edb/ref 17592186303352} {:answer/id #uuid "ea8d1bfd-dd9d-5df0-bb07-aecfb19ecda9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303353} {:answer/id #uuid "e3c5ada5-b582-58a4-9b16-63c359d07add" :answer/type {:db/ident :answer.type/text} :answer/value "I and III  only" :db/id #edb/ref 17592186303354} {:answer/id #uuid "19695a11-6184-50a6-b7e4-a8ce98068372" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303355} {:answer/id #uuid "7e56084e-c049-5d03-8053-7d8f8a131ad4" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186303356}] :answer-field/correct {:answer/id #uuid "9def4b4a-1dd6-546f-a05a-5cec780136ac" :answer/type {:db/ident :answer.type/text} :answer/value "I  only" :db/id #edb/ref 17592186303352} :answer-field/id #uuid "e5ffcb6e-0917-5f6f-a0aa-f5850879ca37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303351}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f488e99f-6a91-5199-9a3f-4686ca4250e2" :question/math-academy-id "q-77477" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\n- $S$ is **not** a singular matrix\n- $S$ is a singular matrix\n- $det(S)=\\sqrt{3}$\n\n$$\nS=[\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}1 & 2 & \\,0 \\\\ 2 & \\sqrt{3} & \\,\\,-1 \\\\ \\sqrt{3} & 4 & \\,\\,-\\sqrt{3}\\end{aligned}| \\\\  & =1|\\begin{aligned}\\sqrt{3} & \\,\\,-1 \\\\ 4 & \\,\\,-\\sqrt{3}\\end{aligned}|-2|\\begin{aligned}2 & \\,-1 \\\\ \\sqrt{3} & \\,-\\sqrt{3}\\end{aligned}|+0|\\begin{aligned}2 & \\sqrt{3} \\\\ \\sqrt{3} & 4\\end{aligned}| \\\\  & =1(-{(\\sqrt{3})}^{2}+4)-2(-2\\sqrt{3}+\\sqrt{3})+0 \\\\  & =(-3+4)-2\\cdot (-\\sqrt{3}) \\\\  & =1+2\\sqrt{3}\\end{aligned}\n$$\n\nSince $det(S)=1+2\\sqrt{3}\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186303357 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9405d7f-2eab-599d-9ba5-e87cacabdf95" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303359} {:answer/id #uuid "8b70e71f-f769-57db-b7fb-a5767752d8e1" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186303360} {:answer/id #uuid "916c7451-7165-5939-b18f-f24a87f57db6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303361} {:answer/id #uuid "8e92102a-d2be-58f6-bc96-f9d23e118a46" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303362} {:answer/id #uuid "341dcfd3-2a7a-54a5-a51a-2cd79256e8e3" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186303363}] :answer-field/correct {:answer/id #uuid "341dcfd3-2a7a-54a5-a51a-2cd79256e8e3" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186303363} :answer-field/id #uuid "92720cbe-efa5-5123-a597-8ee071c3b10d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303358}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "24cc52a8-4124-5277-acdf-def6004941a2" :question/math-academy-id "q-77478" :question/problem "Which of the following statements are true regarding the matrix $R$ given below?\n\n- $R$ is a singular matrix\n- $det(R)=0$\n- $det(R)=1$\n\n \n\n$$\nR=[\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}\\frac{3}{5} & \\frac{2}{5} & \\frac{1}{5} \\\\ 1 & 2 & 3 \\\\ 0 & \\frac{1}{2} & 1\\end{aligned}| \\\\  & =\\frac{3}{5}|\\begin{aligned}2 & 3 \\\\ \\frac{1}{2} & 1\\end{aligned}|-\\frac{2}{5}|\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}|+\\frac{1}{5}|\\begin{aligned}1 & 2 \\\\ 0 & \\frac{1}{2}\\end{aligned}| \\\\  & =\\frac{3}{5}(2-\\frac{3}{2})-\\frac{2}{5}(1-0)+\\frac{1}{5}(\\frac{1}{2}-0) \\\\  & =\\frac{3}{5}\\cdot \\frac{1}{2}-\\frac{2}{5}\\cdot 1+\\frac{1}{5}\\cdot \\frac{1}{2} \\\\  & =\\frac{3}{10}-\\frac{2}{5}+\\frac{1}{10} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(R)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."}]}
