#{[{:db/id #edb/ref 17592186128899 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/id #uuid "b7a64276-0aab-5ef0-861b-528ebbd66e60" :question/math-academy-id "e-5839" :question/problem "What is the domain of the function $f(x) = \\dfrac{3}{2-x}+1$?" :question/worked-solution "A reciprocal function is defined for all values of $x$ except those that make the denominator zero. To find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}\n2 - x &= 0 \\\\\nx &= 2\n\\end{aligned}\n$$\n\nTherefore, the domain is $x \\in (-\\infty,2) \\cup (2,\\infty)$."}] [{:db/id #edb/ref 17592186128900 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/id #uuid "1d4c0776-f7ea-5529-bb58-8f9d892c9551" :question/math-academy-id "e-5840" :question/problem "The domain of the function $f(x) = \\dfrac{5}{2x-a}+3$ is $(-\\infty,3) \\cup (3,+\\infty)$. What is the value of $a$?" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}\n2x - a &= 0 \\\\\n2x &= a \\\\\nx &= \\frac{a}{2}\n\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is\n\n$$\nx = \\dfrac{a}{2}\n$$\n\nOn the other hand, we can see that $x=3$ is excluded from the domain. Equating this to\n\n$$\n\\dfrac{a}{2}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\n\\frac{a}{2} &= 3 \\\\\na &= 6\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186128901 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/id #uuid "fb0fd8d0-a34c-509f-a13d-dc39464262c0" :question/math-academy-id "e-5841" :question/problem "Find the range of the function $f(x)=\\dfrac{3}{4x-1}+2$." :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x) = \\dfrac{a}{bx+c} + d\n$$\n\nhas the horizontal asymptote $y=d$, and therefore, its range is\n\n$$\nf(x) \\in (-\\infty, d)\\cup (d,\\infty)\n$$\n\nIn our case, $d = 2$. Therefore, the horizontal asymptote is $y = 2$, and the range of the function is\n\n$$\nf(x) \\in (-\\infty, 2) \\cup (2, \\infty)\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/2082/Source/Images/936fa12fa348e9787c6996f12c05b858.png)"}] [{:db/id #edb/ref 17592186129633 :knowledge-point/_questions [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b04261a1-84f7-50f2-bf7d-3fe2d7f2288e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞, ∞)" :db/id #edb/ref 17592186127593} {:answer/id #uuid "ca7b21e6-5bea-537f-b295-c6fbddeddb9e" :answer/type {:db/ident :answer.type/math} :answer/value "[MATH: f(x) ∈ [0, ∞)]" :db/id #edb/ref 17592186127594} {:answer/id #uuid "1fb622bf-4a25-58d5-98c0-a3a4c8f4a4d2" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞, 1)∪(1, ∞)" :db/id #edb/ref 17592186127595} {:answer/id #uuid "2445be01-ad86-5bd5-8a4f-4d110de75320" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞, 0)∪(0, ∞)" :db/id #edb/ref 17592186127596} {:answer/id #uuid "72368749-973c-56ce-9ac9-424023b8917f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞,-1)∪(-1, ∞)" :db/id #edb/ref 17592186127597}] :answer-field/correct {:answer/id #uuid "1fb622bf-4a25-58d5-98c0-a3a4c8f4a4d2" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞, 1)∪(1, ∞)" :db/id #edb/ref 17592186127595} :answer-field/id #uuid "f708ebff-317f-556d-a566-e354974c9e79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127592}] :question/id #uuid "d217a65e-0c89-5e42-9ec0-707fb475019f" :question/math-academy-id "q-38708" :question/problem "What is the range of $f(x) = \\frac{1}{2x + 3} + 1$?"}]}
