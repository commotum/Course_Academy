ormed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cca5b25-88bf-585f-b250-00961b7128e9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385100}] :answer-field/correct {:answer/id #uuid "6cca5b25-88bf-585f-b250-00961b7128e9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385100} :answer-field/id #uuid "b442d7c3-8d89-5741-a995-5aa4fa825e21" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385099} {:answer-field/choices [{:answer/id #uuid "0e5c7d9a-cac0-5b6a-80ac-3391ac101ade" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385102}] :answer-field/correct {:answer/id #uuid "0e5c7d9a-cac0-5b6a-80ac-3391ac101ade" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385102} :answer-field/id #uuid "91109d89-26a5-5927-8ac8-0003b6eeb9a6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385101} {:answer-field/choices [{:answer/id #uuid "e9c32012-c56a-5019-9aa9-543a62230655" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186385104}] :answer-field/correct {:answer/id #uuid "e9c32012-c56a-5019-9aa9-543a62230655" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186385104} :answer-field/id #uuid "4e31b4cf-a029-5334-9ae3-efd5631ade67" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385103}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "69d6f4c5-874c-5f58-942c-02047370838d" :question/math-academy-id "q-276607" :question/problem "What is the domain of the function $f(x)=\\frac{7}{3x-12}\\,?$\n\nThe domain is\n$x\\in (-\\infty ,$\n{{field-1}}$)\\cup (${{field-2}}$,$\n{{field-3}}$).$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}3x-12 & =0 \\\\ 3x & =12 \\\\ x & =\\frac{12}{3} \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,4)\\cup (4,\\infty ).$"}] [{:db/id #edb/ref 17592186385105 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222afaa3-c12a-5f70-b9e5-4aa95c89afb5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385107}] :answer-field/correct {:answer/id #uuid "222afaa3-c12a-5f70-b9e5-4aa95c89afb5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385107} :answer-field/id #uuid "e318449a-e13b-56b5-9b37-d387137613cb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385106} {:answer-field/choices [{:answer/id #uuid "15c7da02-578c-531d-99c8-5e9f7fad8ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186385109}] :answer-field/correct {:answer/id #uuid "15c7da02-578c-531d-99c8-5e9f7fad8ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186385109} :answer-field/id #uuid "fa359ed9-14fa-5da8-ab24-68da9f1ebad7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385108} {:answer-field/choices [{:answer/id #uuid "eb067ccb-eee8-5f94-9bd3-d15c22cc7830" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186385111}] :answer-field/correct {:answer/id #uuid "eb067ccb-eee8-5f94-9bd3-d15c22cc7830" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186385111} :answer-field/id #uuid "3c5950f4-d0f0-56ac-8f51-2b0d44ff26e1" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385110}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "66c6f846-71e3-5cee-b2ac-e58338cbb504" :question/math-academy-id "q-276609" :question/problem "What is the domain of the function $f(x)=-\\frac{9}{8x-20}\\,?$\n\nThe domain is\n$x\\in (${{field-1}}$,$\n{{field-2}}$)\\cup (${{field-3}}$,\\infty ).$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}8x-20 & =0 \\\\ 8x & =20 \\\\ x & =\\frac{20}{8} \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{5}{2})\\cup (\\frac{5}{2},\\infty ).$"}] [{:db/id #edb/ref 17592186385112 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b438ce81-09fb-51b5-ac22-26a6d1e6b521" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385114} {:answer/id #uuid "c95159ef-3571-53e9-8246-15c6041b41cc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385115}] :answer-field/correct {:answer/id #uuid "c95159ef-3571-53e9-8246-15c6041b41cc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385115} :answer-field/id #uuid "80f4d7a0-9e70-5d4a-9a99-05dc5f407194" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385113} {:answer-field/choices [{:answer/id #uuid "a44df0fc-c827-5721-ae3f-3eed235f9c6b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385117}] :answer-field/correct {:answer/id #uuid "a44df0fc-c827-5721-ae3f-3eed235f9c6b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385117} :answer-field/id #uuid "44000e01-524a-588d-9fdc-30531737c8d0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385116} {:answer-field/choices [{:answer/id #uuid "856e7dd4-4668-5e9a-9106-e901c61cc143" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186385119}] :answer-field/correct {:answer/id #uuid "856e7dd4-4668-5e9a-9106-e901c61cc143" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186385119} :answer-field/id #uuid "56bfb637-ce77-5628-ad97-468962be6523" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385118}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "804c9e5b-57fe-5fb3-b4a8-36593cd9e981" :question/math-academy-id "q-276611" :question/problem "What is the domain of the function $f(x)=\\frac{5}{9x+18}-4\\,?$\n\nThe domain is\n$x\\in (-\\infty ,$\n{{field-1}}$)\\cup (${{field-2}}$,$\n{{field-3}}$).$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}9x+18 & =0 \\\\ 9x & =-18 \\\\ x & =-\\frac{18}{9} \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,-2)\\cup (-2,\\infty ).$"}] [{:db/id #edb/ref 17592186385120 :knowledge-point/_questions [{:knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "039eb605-e648-502a-b861-f7ebdd3f4473" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385122} {:answer/id #uuid "b976db77-1b94-5d38-aa71-eec7162c046e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385123}] :answer-field/correct {:answer/id #uuid "b976db77-1b94-5d38-aa71-eec7162c046e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385123} :answer-field/id #uuid "eecf5936-6463-58da-b496-25e85c5d0daa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385121} {:answer-field/choices [{:answer/id #uuid "834a51f5-1f41-5853-89b0-8a4ae6528f1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186385125}] :answer-field/correct {:answer/id #uuid "834a51f5-1f41-5853-89b0-8a4ae6528f1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186385125} :answer-field/id #uuid "1f8eac20-d21b-5b78-b1f8-f17967660a81" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385124} {:answer-field/choices [{:answer/id #uuid "807feccc-8b3d-5657-b030-6462b5354b04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186385127}] :answer-field/correct {:answer/id #uuid "807feccc-8b3d-5657-b030-6462b5354b04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186385127} :answer-field/id #uuid "ff0fe720-35e6-566f-b40c-e276bad8494c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385126}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e100052d-1a3f-51db-af1c-83b47b51aff5" :question/math-academy-id "q-276622" :question/problem "What is the domain of the function $f(x)=\\frac{3}{15x-9}+6\\,?$\n\nThe domain is\n$x\\in (${{field-1}}$,$\n{{field-2}}$)\\cup (${{field-3}}$,\\infty ).$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}15x-9 & =0 \\\\ 15x & =9 \\\\ x & =\\frac{9}{15} \\\\ x & =\\frac{3}{5}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{3}{5})\\cup (\\frac{3}{5},\\infty ).$"}] [{:db/id #edb/ref 17592186385128 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d1f2713-0ab8-5eb1-96ae-9559cf8b1898" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385130} {:answer/id #uuid "1ed3e8ed-c026-53e9-957e-3622a41ce5f2" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186385131}] :answer-field/correct {:answer/id #uuid "3d1f2713-0ab8-5eb1-96ae-9559cf8b1898" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385130} :answer-field/id #uuid "133d2e90-9392-5ab0-b808-c8e6723eae96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385129}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3ed9d2b0-4586-5fb5-b80a-ffcceabe3ac2" :question/math-academy-id "q-276663" :question/problem "If the domain of the function $f(x)=\\frac{2x+7}{bx+5}$ is $(-\\infty ,-\\frac{5}{6})\\cup (-\\frac{5}{6},\\infty ),$ then $b=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}bx+5 & =0 \\\\ bx & =-5 \\\\ x & =-\\frac{5}{b}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-\\frac{5}{b}.$ \n\nOn the other hand, we can see that $x=-\\frac{5}{6}$ is excluded from the domain. Equating this to $-\\frac{5}{b},$ we get\n\n$$\n\\begin{aligned}-\\frac{5}{b} & =-\\frac{5}{6} \\\\ \\frac{5}{b} & =\\frac{5}{6} \\\\ b & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385132 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14392f54-6041-56b8-bda7-69f6142c0dd8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385134}] :answer-field/correct {:answer/id #uuid "14392f54-6041-56b8-bda7-69f6142c0dd8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385134} :answer-field/id #uuid "7e732e2e-0ce8-57f5-8e7d-71dea127a91a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385133}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "778d76a3-0b65-5434-8317-81d5645c5c22" :question/math-academy-id "q-276676" :question/problem "If the domain of the function $f(x)=\\frac{8x-9}{kx-2}$ is $(-\\infty ,\\frac{1}{2})\\cup (\\frac{1}{2},\\infty ),$ then $k=${{field-1}}." :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-2 & =0 \\\\ kx & =2 \\\\ x & =\\frac{2}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{2}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{1}{2}$ is excluded from the domain. Equating this to $\\frac{2}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{2}{k} & =\\frac{1}{2} \\\\ k & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385135 :knowledge-point/_questions [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f956884c-64d9-571d-a573-753d2cfa0bd2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385137}] :answer-field/correct {:answer/id #uuid "f956884c-64d9-571d-a573-753d2cfa0bd2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186385137} :answer-field/id #uuid "1ff4614b-07f2-5087-812a-a0062b26c48c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385136} {:answer-field/choices [{:answer/id #uuid "6f4b8c82-9fd3-51f3-888e-777f453c685e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186385139}] :answer-field/correct {:answer/id #uuid "6f4b8c82-9fd3-51f3-888e-777f453c685e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186385139} :answer-field/id #uuid "7cfc8cbd-5e93-560b-8d93-ec8835243b12" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385138} {:answer-field/choices [{:answer/id #uuid "03190ca9-b179-54da-b9ad-c48e1801aaa0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186385141}] :answer-field/correct {:answer/id #uuid "03190ca9-b179-54da-b9ad-c48e1801aaa0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186385141} :answer-field/id #uuid "60abfba9-9acd-5560-ab42-aafda01aedd5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186385140}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0a01627c-6e47-548e-be88-d7425dde3b4b" :question/math-academy-id "q-276693" :question/problem "What is the range of the function $f(x)=-\\frac{3}{2x-7}+1\\,?$\n\nThe range is\n$f(x)\\in (${{field-1}}$,$\n{{field-2}}$)\\cup (${{field-3}}$,\\infty ).$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=1.$ Therefore, the horizontal asymptote is $y=1,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,1)\\cup (1,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14078796/assets/1a74169e0b8ed0494364e704ec742ed6a399f60db118a9506185c31ee61aaa80.png)"}] [{:db/id #edb/ref 17592186129633 :knowledge-point/_questions [{:knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b04261a1-84f7-50f2-bf7d-3fe2d7f2288e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) ∈ (- ∞, ∞)" :db/id #edb/ref 17592186127593} {:answer/id #uuid "ca7b21e6-5bea-537f-b295-c6fbddeddb9e" :answer/type {:db/ident :answer.type/math} :answer/value "[MATH: f(x) ∈ [0, ∞)]" :db/id #edb/ref 17592186127594} {:answer/id #uu