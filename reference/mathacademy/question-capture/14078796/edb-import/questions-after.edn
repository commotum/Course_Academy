963028c-c816-5b9a-9aab-ffd93f0e75fc" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186385144} {:answer/id #uuid "539407b1-7258-5be9-af39-7e93b0eaae22" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186385145} {:answer/id #uuid "88b7b97c-24a0-54f8-a1f3-3d4f4386cc54" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186385146} {:answer/id #uuid "7c99932c-fac7-5444-8be5-2beae9493068" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{2})\\cup (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186385147} {:answer/id #uuid "fbee02f0-ec72-55cb-b2f5-35aae6c285c3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{3}{2})\\cup (\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186385148}] :answer-field/correct {:answer/id #uuid "fbee02f0-ec72-55cb-b2f5-35aae6c285c3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{3}{2})\\cup (\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186385148} :answer-field/id #uuid "6448f7fa-f4c1-5470-a157-107332c85adf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385143}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cb18a9e5-c10c-53fd-a481-39b4af5920e9" :question/math-academy-id "q-40020" :question/problem "What is the domain of the function $f(x)=\\frac{2}{2x-3}-\\frac{1}{2}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{3}{2})\\cup (\\frac{3}{2},\\infty ).$"}] [{:db/id #edb/ref 17592186385149 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c877c67-6de5-5f58-8489-7ff5bc8a04ec" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186385151} {:answer/id #uuid "c09eeb69-b86a-5692-9de9-6bcc7d93090c" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186385152} {:answer/id #uuid "77892745-a97f-5aa6-809f-2adfb8a2de7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385153} {:answer/id #uuid "faf2eddb-97b3-5c2b-984b-d82752c7aaf9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385154} {:answer/id #uuid "b619f7fa-4ada-54e1-b16f-0da4615db7c8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385155}] :answer-field/correct {:answer/id #uuid "77892745-a97f-5aa6-809f-2adfb8a2de7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385153} :answer-field/id #uuid "a79e5f1b-761f-5abc-afdc-150b023fc87a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385150}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0a2b47b8-25e8-5aa9-807c-9ee17850b9b4" :question/math-academy-id "q-40028" :question/problem "The domain of the function $f(x)=\\frac{6}{ax-18}+5$ is $(-\\infty ,9)\\cup (9,+\\infty ).$ What is the value of $a?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}ax-18 & =0 \\\\ ax & =18 \\\\ x & =\\frac{18}{a}.\\end{aligned}\n$$\n\n \n\nSo, the point that must be excluded from the domain is $x=\\frac{18}{a}.$ \n\nOn the other hand, we can see that $x=9$ is excluded from the domain. Equating this to $\\frac{18}{a},$ we get\n\n$$\n\\begin{aligned}\\frac{18}{a} & =9 \\\\ a & =\\frac{18}{9} \\\\ a & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385156 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168f4d5d-590e-505a-8bf8-ef7c72e1b98d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186385158} {:answer/id #uuid "0bd76ed7-ed61-5c4e-836b-41c8254c9a88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186385159} {:answer/id #uuid "896c3f2e-df47-5940-9644-16941f4bb733" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385160} {:answer/id #uuid "028db1b5-9a60-586e-ba0f-7217ffca1f74" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186385161} {:answer/id #uuid "508ff9a7-810f-5099-bcbb-31779404bd55" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385162}] :answer-field/correct {:answer/id #uuid "508ff9a7-810f-5099-bcbb-31779404bd55" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385162} :answer-field/id #uuid "1e77eec7-934d-5375-9a75-eeaeb82d370d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385157}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8de37b78-6a35-5301-af3c-213d723b9a75" :question/math-academy-id "q-81307" :question/problem "The domain of the function $f(x)=\\frac{4x+2}{x+3a}$ is $(-\\infty ,6)\\cup (6,\\infty ).$ What is the value of $a?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}x+3a & =0 \\\\ x & =-3a.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-3a.$ \n\nOn the other hand, we can see that $x=6$ is excluded from the domain. Equating this to $-3a,$ we get\n\n$$\n\\begin{aligned}-3a & =6 \\\\ a & =-2.\\end{aligned}\n$$"}]}
