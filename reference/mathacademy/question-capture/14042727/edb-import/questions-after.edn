#{[{:db/id #edb/ref 17592186317082 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fabd2315-8992-5aff-9fa8-2e74d74dc8c0" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186317084} {:answer/id #uuid "32477030-d71f-5818-97a9-8b0aa169f002" :answer/type {:db/ident :answer.type/math} :answer/value "79" :db/id #edb/ref 17592186317085} {:answer/id #uuid "594f1c75-af20-5181-adf4-34c8e56fdfcd" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186317086} {:answer/id #uuid "47c09873-8d1d-5704-9552-70a5ff56f885" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186317087} {:answer/id #uuid "85101206-7aba-5c7c-a07a-5982a3bac415" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186317088}] :answer-field/correct {:answer/id #uuid "fabd2315-8992-5aff-9fa8-2e74d74dc8c0" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186317084} :answer-field/id #uuid "e219cc7c-efca-5b68-a953-c7be185a35fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317083}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f6eb5e12-95ae-5b0b-b902-abc4f32a452e" :question/math-academy-id "q-2414" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=3{t}^{2}-6t.$ \nAt time $t=2,$ the particle is located at the position $x=6.$ What is the position of the particle at time $t=5?$" :question/worked-solution "The position of the particle at $t=5$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,5].$ Therefore, we can calculate it as follows:\n\n$$\nx(5)=x(2)+{\\int }_{2}^{5}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(5) & =6+{\\int }_{2}^{5}(3{t}^{2}-6t)\\,\\text{dt} \\\\  & =6+{[{t}^{3}-3{t}^{2}]}_{2}^{5} \\\\  & =6+([(5)^{3}-3(5)^{2}]-[(2)^{3}-3(2)^{2}]) \\\\  & =6+([125-75]-[8-12]) \\\\  & =6+(50-(-4)) \\\\  & =6+54 \\\\  & =60.\\end{aligned}\n$$\n\nSo the position of the particle at $t=5$ is $x=60.$"}] [{:db/id #edb/ref 17592186317089 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2567e6eb-702c-57e9-8a35-65faf7c4a5b0" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186317091}] :answer-field/correct {:answer/id #uuid "2567e6eb-702c-57e9-8a35-65faf7c4a5b0" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186317091} :answer-field/id #uuid "3eb12efc-13bb-58f0-a351-872e3384d0f9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317090}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a73379bf-3cdc-5ce7-a08f-2ee49976d4da" :question/math-academy-id "q-351449" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=6t-{t}^{2}.$ At time $t=3$ the particle is located at the position $x=2.$ \nFind the position of the particle at time $t=6.$\n\nThe position of the particle at $t=6$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=3$ plus the total displacement over $t\\in [3,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(3)+{\\int }_{3}^{6}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(6) & =2+{\\int }_{3}^{6}(6t-{t}^{2})\\,\\text{d}t \\\\  & =2+{[3{t}^{2}-\\frac{1}{3}{t}^{3}]}_{3}^{6} \\\\  & =2+[3(6)^{2}-\\frac{1}{3}(6)^{3}]-[3(3)^{2}-\\frac{1}{3}(3)^{3}] \\\\  & =2+36-18 \\\\  & =2+18 \\\\  & =20.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=6$ is $x=20.$"}] [{:db/id #edb/ref 17592186176479 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9871c2b0-93d5-5e4e-9e64-7b6d24daf872" :answer/type {:db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186175417} {:answer/id #uuid "a75ca5c5-000c-5141-b29b-b9e8fd5ee55b" :answer/type {:db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186175418} {:answer/id #uuid "fff7b8ac-2fe3-57aa-88e0-08c21ac58506" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186175419} {:answer/id #uuid "58ac4f26-5845-5b66-89b2-1c75504c0091" :answer/type {:db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186175420} {:answer/id #uuid "5db41f1b-862b-5b7e-8301-73c54ac81dde" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186175421}] :answer-field/correct {:answer/id #uuid "fff7b8ac-2fe3-57aa-88e0-08c21ac58506" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186175419} :answer-field/id #uuid "ae21d5c8-14c5-59d9-8770-834ae59a8f3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175416}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f38c2d58-f071-5d09-92ca-36e11adfb46f" :question/math-academy-id "q-7113" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=4t+3{t}^{2}.$ At time $t=1$ the particle is located at the position $x=12.$ What is the position of the particle at time $t=4?$" :question/requires-calculator true :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(1)+{\\int }_{1}^{4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(4) & =12+{\\int }_{1}^{4}(4t+3{t}^{2})\\text{d}t \\\\  & =12+[2{t}^{2}+{t}^{3}]_{1}^{4} \\\\  & =12+([2(4)^{2}+{4}^{3}]-[2(1)^{2}+{1}^{3}]) \\\\  & =12+([32+64]-[2+1]) \\\\  & =12+(96-3) \\\\  & =12+93 \\\\  & =105\\end{aligned}\n$$\n\nSo the position of the particle at $t=4$ is $x=105.$"}] [{:db/id #edb/ref 17592186317092 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dc13e5a-fe0a-5c09-92ac-0461142173ef" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186317094} {:answer/id #uuid "61de2e41-98c9-5655-ba4f-d250c67d67ba" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186317095} {:answer/id #uuid "e5c5a3f3-edc6-5d39-9992-629f99ad685c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186317096} {:answer/id #uuid "a13766c8-056f-52e2-8e34-e492d8846e34" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186317097} {:answer/id #uuid "5ac9207a-db8b-5725-ab4c-914bfa71ac53" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186317098}] :answer-field/correct {:answer/id #uuid "e5c5a3f3-edc6-5d39-9992-629f99ad685c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186317096} :answer-field/id #uuid "9055f599-2064-5028-bdc6-515c45c30cd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317093}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb15d24-7ff5-58bf-b04b-310e248ca644" :question/math-academy-id "q-81510" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042727/assets/e484bfde797b94d298227bac9ae25fb68a3de5698e7f8d8527e37e11cb051a95.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=2$ the particle is located at the position $x=1.$ What is the position of the particle at time $t=8?$" :question/worked-solution "The position of the particle at $t=8$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,8].$ Therefore, we can calculate it as follows:\n\n$$\nx(8)=x(2)+{\\int }_{2}^{8}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(2)=1$, and we can compute the integral ${\\int }_{2}^{8}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=2$ to $t=8.$ Computing the signed area, we get\n\n$$\n{\\int }_{2}^{8}v(t)\\,\\text{d}t=14.\n$$\n\nTherefore,\n\n$$\nx(8)=1+14=15\n$$\n\nSo the position of the particle at $t=8$ is $x=15.$"}] [{:db/id #edb/ref 17592186176497 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8656bc5c-89b7-5faa-8e9a-d4cf5489a133" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186175525} {:answer/id #uuid "ecfe37b6-348a-58dc-bd12-be8195dd4179" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186175526} {:answer/id #uuid "ee1a6f05-7b76-5b87-b2a4-545260f49a5c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186175527} {:answer/id #uuid "fe7d6fb4-c3a2-5a7d-8a35-c55219fd1ffe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186175528} {:answer/id #uuid "4cbe59bf-9aa6-53f5-b2af-bf84d5cc8d46" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186175529}] :answer-field/correct {:answer/id #uuid "ee1a6f05-7b76-5b87-b2a4-545260f49a5c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186175527} :answer-field/id #uuid "05c91bec-14bb-507d-8d12-a179ce71164a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175524}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c28570f9-857d-5ff0-823f-c8f4501357d9" :question/math-academy-id "q-81515" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042727/assets/6c0f74fa4820cd8e6945666ab90e0eafac4cc1ada7578fb5a053f197adf08084.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=7?$" :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(1)+{\\int }_{1}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=2$, and we can compute the integral ${\\int }_{1}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{7}v(t)\\,\\text{d}t=0.\n$$\n\nTherefore,\n\n$$\nx(7)=2+0=2\n$$\n\nSo the position of the particle at $t=7$ is $x=2.$"}]}
