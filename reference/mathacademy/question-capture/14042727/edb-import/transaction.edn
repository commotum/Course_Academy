[{:db/id "q-2414/selection/442511f9b0fecd2a08a6dca7fc8cc4e966d1876da93632eb687adf93cc074fd5" :answer/id #uuid "32477030-d71f-5818-97a9-8b0aa169f002" :answer/type :answer.type/math :answer/value "79" :db/ensure [:answer/validate]} {:db/id "q-2414/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "fabd2315-8992-5aff-9fa8-2e74d74dc8c0" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-2414/selection/87f70942b9483cb5cedbd7b4150ebc995451772f024ba0c75aaaea5741b3bd06" :answer/id #uuid "85101206-7aba-5c7c-a07a-5982a3bac415" :answer/type :answer.type/math :answer/value "68" :db/ensure [:answer/validate]} {:db/id "q-2414/selection/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" :answer/id #uuid "594f1c75-af20-5181-adf4-34c8e56fdfcd" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id "q-2414/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "47c09873-8d1d-5704-9552-70a5ff56f885" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-2414/selection" :answer-field/id #uuid "e219cc7c-efca-5b68-a953-c7be185a35fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2414/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-2414/selection/442511f9b0fecd2a08a6dca7fc8cc4e966d1876da93632eb687adf93cc074fd5" "q-2414/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-2414/selection/87f70942b9483cb5cedbd7b4150ebc995451772f024ba0c75aaaea5741b3bd06" "q-2414/selection/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" "q-2414/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784"] :db/ensure [:answer-field/validate]} {:db/id "q-2414" :question/id #uuid "f6eb5e12-95ae-5b0b-b902-abc4f32a452e" :question/math-academy-id "q-2414" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=3{t}^{2}-6t.$ \nAt time $t=2,$ the particle is located at the position $x=6.$ What is the position of the particle at time $t=5?$" :question/worked-solution "The position of the particle at $t=5$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,5].$ Therefore, we can calculate it as follows:\n\n$$\nx(5)=x(2)+{\\int }_{2}^{5}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(5) & =6+{\\int }_{2}^{5}(3{t}^{2}-6t)\\,\\text{dt} \\\\  & =6+{[{t}^{3}-3{t}^{2}]}_{2}^{5} \\\\  & =6+([(5)^{3}-3(5)^{2}]-[(2)^{3}-3(2)^{2}]) \\\\  & =6+([125-75]-[8-12]) \\\\  & =6+(50-(-4)) \\\\  & =6+54 \\\\  & =60.\\end{aligned}\n$$\n\nSo the position of the particle at $t=5$ is $x=60.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2414/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-2414"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-7113"] :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=4t+3{t}^{2}.$ At time $t=1$ the particle is located at the position $x=12.$ What is the position of the particle at time $t=4?$" :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(1)+{\\int }_{1}^{4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(4) & =12+{\\int }_{1}^{4}(4t+3{t}^{2})\\text{d}t \\\\  & =12+[2{t}^{2}+{t}^{3}]_{1}^{4} \\\\  & =12+([2(4)^{2}+{4}^{3}]-[2(1)^{2}+{1}^{3}]) \\\\  & =12+([32+64]-[2+1]) \\\\  & =12+(96-3) \\\\  & =12+93 \\\\  & =105\\end{aligned}\n$$\n\nSo the position of the particle at $t=4$ is $x=105.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-81510/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "5ac9207a-db8b-5725-ab4c-914bfa71ac53" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-81510/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "a13766c8-056f-52e2-8e34-e492d8846e34" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-81510/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "4dc13e5a-fe0a-5c09-92ac-0461142173ef" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-81510/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "61de2e41-98c9-5655-ba4f-d250c67d67ba" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-81510/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "e5c5a3f3-edc6-5d39-9992-629f99ad685c" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-81510/selection" :answer-field/id #uuid "9055f599-2064-5028-bdc6-515c45c30cd5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81510/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-81510/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" "q-81510/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-81510/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-81510/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-81510/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49"] :db/ensure [:answer-field/validate]} {:db/id "q-81510" :question/id #uuid "ffb15d24-7ff5-58bf-b04b-310e248ca644" :question/math-academy-id "q-81510" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042727/assets/e484bfde797b94d298227bac9ae25fb68a3de5698e7f8d8527e37e11cb051a95.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=2$ the particle is located at the position $x=1.$ What is the position of the particle at time $t=8?$" :question/worked-solution "The position of the particle at $t=8$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,8].$ Therefore, we can calculate it as follows:\n\n$$\nx(8)=x(2)+{\\int }_{2}^{8}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(2)=1$, and we can compute the integral ${\\int }_{2}^{8}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=2$ to $t=8.$ Computing the signed area, we get\n\n$$\n{\\int }_{2}^{8}v(t)\\,\\text{d}t=14.\n$$\n\nTherefore,\n\n$$\nx(8)=1+14=15\n$$\n\nSo the position of the particle at $t=8$ is $x=15.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81510/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-81510"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-81515"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042727/assets/6c0f74fa4820cd8e6945666ab90e0eafac4cc1ada7578fb5a053f197adf08084.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=7?$" :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(1)+{\\int }_{1}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=2$, and we can compute the integral ${\\int }_{1}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{7}v(t)\\,\\text{d}t=0.\n$$\n\nTherefore,\n\n$$\nx(7)=2+0=2\n$$\n\nSo the position of the particle at $t=7$ is $x=2.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-351449/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "2567e6eb-702c-57e9-8a35-65faf7c4a5b0" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-351449/field-1" :answer-field/id #uuid "3eb12efc-13bb-58f0-a351-872e3384d0f9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351449/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-351449/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c"] :db/ensure [:answer-field/validate]} {:db/id "q-351449" :question/id #uuid "a73379bf-3cdc-5ce7-a08f-2ee49976d4da" :question/math-academy-id "q-351449" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=6t-{t}^{2}.$ At time $t=3$ the particle is located at the position $x=2.$ \nFind the position of the particle at time $t=6.$\n\nThe position of the particle at $t=6$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=3$ plus the total displacement over $t\\in [3,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(3)+{\\int }_{3}^{6}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(6) & =2+{\\int }_{3}^{6}(6t-{t}^{2})\\,\\text{d}t \\\\  & =2+{[3{t}^{2}-\\frac{1}{3}{t}^{3}]}_{3}^{6} \\\\  & =2+[3(6)^{2}-\\frac{1}{3}(6)^{3}]-[3(3)^{2}-\\frac{1}{3}(3)^{3}] \\\\  & =2+36-18 \\\\  & =2+18 \\\\  & =20.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=6$ is $x=20.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351449/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-351449"] :db/ensure [:knowledge-point/validate]}]
