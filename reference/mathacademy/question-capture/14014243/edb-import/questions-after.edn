#{[{:db/id #edb/ref 17592186291932 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bf1789b-0528-53b2-9636-b650173e40fc" :answer/type {:db/ident :answer.type/math} :answer/value "v=6.67" :db/id #edb/ref 17592186291934} {:answer/id #uuid "3ae132cd-f2e6-5d2a-9e61-5f3bb1f8fe7b" :answer/type {:db/ident :answer.type/math} :answer/value "v=8.05" :db/id #edb/ref 17592186291935} {:answer/id #uuid "187a8792-a736-5109-afaa-b5102e429ddd" :answer/type {:db/ident :answer.type/math} :answer/value "v=4.33" :db/id #edb/ref 17592186291936} {:answer/id #uuid "31acd7b7-30ef-52de-a927-59d8c2fc2308" :answer/type {:db/ident :answer.type/math} :answer/value "v=3.75" :db/id #edb/ref 17592186291937} {:answer/id #uuid "a51691ee-7eda-5998-bb64-5271ba9f9715" :answer/type {:db/ident :answer.type/math} :answer/value "v=0.22" :db/id #edb/ref 17592186291938}] :answer-field/correct {:answer/id #uuid "187a8792-a736-5109-afaa-b5102e429ddd" :answer/type {:db/ident :answer.type/math} :answer/value "v=4.33" :db/id #edb/ref 17592186291936} :answer-field/id #uuid "d1d86087-858c-59b3-977a-6fd36bab8013" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291933}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3df15b1d-5c6a-5a31-88c3-94f27234c33f" :question/math-academy-id "q-19302" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)={t}^{2}-2t+\\operatorname{ln}⁡t,\\,t>0.\n$$\n\nCalculate the velocity at time $t=3.$ Round your answer to $2$ decimal places." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2t+\\operatorname{ln}⁡t) \\\\  & =2t-2+\\frac{1}{t}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=3,$ we substitute $t=3$ into the velocity function above:\n\n$$\n\\begin{aligned}v(3) & =2(3)-2+\\frac{1}{3} \\\\  & =6-2+\\frac{1}{3} \\\\  & =\\frac{13}{3} \\\\  & =4.333\\,333… \\\\  & ≈4.33\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291939 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ae5253-5466-567b-8b8c-ff8e6def52e7" :answer/type {:db/ident :answer.type/math} :answer/value "1.92\\,\\text{ft/s}" :db/id #edb/ref 17592186291941} {:answer/id #uuid "0d11f062-8018-5f11-908e-1b425186b500" :answer/type {:db/ident :answer.type/math} :answer/value "2.15\\,\\text{ft/s}" :db/id #edb/ref 17592186291942} {:answer/id #uuid "d33b10b9-30fb-5d73-8c52-000422742b66" :answer/type {:db/ident :answer.type/math} :answer/value "3.25\\,\\text{ft/s}" :db/id #edb/ref 17592186291943} {:answer/id #uuid "7f4d4396-3018-57c0-9713-ebd0636424b2" :answer/type {:db/ident :answer.type/math} :answer/value "1.18\\,\\text{ft/s}" :db/id #edb/ref 17592186291944} {:answer/id #uuid "483fe72b-380e-5cbc-b953-1b23e2a7003a" :answer/type {:db/ident :answer.type/math} :answer/value "3.52\\,\\text{ft/s}" :db/id #edb/ref 17592186291945}] :answer-field/correct {:answer/id #uuid "0d11f062-8018-5f11-908e-1b425186b500" :answer/type {:db/ident :answer.type/math} :answer/value "2.15\\,\\text{ft/s}" :db/id #edb/ref 17592186291942} :answer-field/id #uuid "6be5a40a-c193-504a-b629-d725cf07f153" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291940}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4cc52979-cdf5-55ff-829a-3138755048ac" :question/math-academy-id "q-19308" :question/problem "The position $s(t)$ of a particle (in feet) at time $t$ seconds is given by \n\n$$\ns(t)=3{e}^{-t}+3\\operatorname{ln}⁡t-3t,\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=3\\,\\text{s}.$ Round your answer to $2$ decimal places." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{e}^{-t}+3\\operatorname{ln}⁡t-3t) \\\\  & =-3{e}^{-t}+\\frac{3}{t}-3\\end{aligned}\n$$\n\nWhen $t=3,$ the velocity is\n\n$$\n\\begin{aligned}v(3) & =-3{e}^{-3}+\\frac{3}{3}-3 \\\\  & =-3{e}^{-3}-2 \\\\  & ≈-2.15\\,\\text{ft/s}.\\end{aligned}\n$$\n\nTherefore, the speed is $|-2.15|=2.15\\,\\text{ft/s}.$"}] [{:db/id #edb/ref 17592186291946 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0ddd62d-e265-5331-acce-ab48fe0cc97b" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186291948}] :answer-field/correct {:answer/id #uuid "f0ddd62d-e265-5331-acce-ab48fe0cc97b" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186291948} :answer-field/id #uuid "b98ebd0a-70b4-551e-933d-76bc2d44b652" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291947}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "871e3cc8-2937-5098-a352-9d073ae34cfe" :question/math-academy-id "q-336146" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=3{log}_{2}⁡t-2t,\\,t>0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to one decimal place.\n\n$v(2)≈$\n{{field-1}}" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{log}_{2}⁡t-2t) \\\\  & =\\frac{3}{t\\operatorname{ln}⁡2}-2\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =\\frac{3}{2\\operatorname{ln}⁡2}-2 \\\\  & =0.16404… \\\\  & ≈0.2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291949 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0453f37-c645-555a-a6d1-436bd4f53754" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186291951} {:answer/id #uuid "a37817b2-dcd3-5555-ad41-3c0bcc8c0e3d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186291952} {:answer/id #uuid "92b7af90-a1f5-5f7a-a310-a821b8439d4d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291953} {:answer/id #uuid "296b1962-8062-58fe-9430-826a1a36c4f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291954} {:answer/id #uuid "343ef335-9a3e-502c-bb60-cbc4834eef32" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291955}] :answer-field/correct {:answer/id #uuid "92b7af90-a1f5-5f7a-a310-a821b8439d4d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186291953} :answer-field/id #uuid "85ab4c65-e2c8-53df-a021-1b410e6dcc02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291950}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6fcc8693-858c-5557-8089-af48250e0ea4" :question/math-academy-id "q-7104" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=3{t}^{2}-12t,\\,t\\ge 0.\n$$\n\nCalculate the speed of the particle when $t=1.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-12t) \\\\  & =6t-12\\end{aligned}\n$$\n\nWhen $t=1,$ the velocity is\n\n$$\nv(1)=6(1)-12=-6.\n$$\n\nTherefore, the speed is $|-6|=6.$"}] [{:db/id #edb/ref 17592186291956 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1866518-4c57-58ae-ad8e-43271dd67ef2" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{t}{{t}^{2}+1}" :db/id #edb/ref 17592186291958} {:answer/id #uuid "109df4b6-4f23-5836-82d0-ae6532a2f2f1" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186291959} {:answer/id #uuid "85952fc2-a830-584c-91c5-1928beaf7aa9" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186291960} {:answer/id #uuid "85adf7a8-8f41-56b4-ba50-1d9048983037" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186291961} {:answer/id #uuid "8b319a74-9d2f-5039-92a2-22993fb6a65e" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{{t}^{2}+1}" :db/id #edb/ref 17592186291962}] :answer-field/correct {:answer/id #uuid "85adf7a8-8f41-56b4-ba50-1d9048983037" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186291961} :answer-field/id #uuid "bf7573de-1da4-560f-ba88-605716b8344d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291957}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2c45107f-9360-503e-9bf0-50d3816b1ed2" :question/math-academy-id "q-73136" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\operatorname{ln}⁡({t}^{2}+1).$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+1)) \\\\  & =\\frac{1}{{t}^{2}+1}\\cdot 2t \\\\  & =\\frac{2t}{{t}^{2}+1}\\end{aligned}\n$$"}]}
