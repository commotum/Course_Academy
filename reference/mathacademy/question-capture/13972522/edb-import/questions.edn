#{[{:db/id #edb/ref 17592186100596 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/title "Finding an Entry of a Matrix"}] :question/id #uuid "622baf41-fe35-55ee-bfc6-f1e6a2cb089a" :question/math-academy-id "e-4371" :question/problem "Find the entry $a_{23}$ of the matrix ${A}$, where\n$\\begin{bmatrix}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}$" :question/worked-solution "The entry $a_{23}$ lies at the intersection of the $2$nd row and $3$rd column. Therefore,\n\n$$\na_{23}={\\color{blue}{-3}}\n$$\n\n$\\begin{bmatrix}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186100597 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ecd07ea0-767d-55f0-a61c-da49dd320f89" :knowledge-point/title "Finding an Entry of a Square Matrix"}] :question/id #uuid "fe56a988-49e9-5f33-b0a5-f43d33984c1d" :question/math-academy-id "e-4372" :question/problem "Find the entry $b_{22}$ of the matrix ${B}$, where\n$\\begin{bmatrix}-5 & 1 \\\\ 0 & 2\\end{bmatrix}$" :question/worked-solution "The entry $b_{22}$ lies at the intersection of the $2$nd row and $2$nd column. Therefore,\n\n$$\nb_{22}={\\color{blue}{2}}\n$$\n\n$\\begin{bmatrix}-5 & 1 \\\\ 0 & 2\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186100598 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1cc70bda-40cf-5860-9a47-25f290c71041" :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] :question/id #uuid "432a6a1a-ba9d-5aa0-b758-d4d32e9992f3" :question/math-academy-id "e-4373" :question/problem "Consider the highlighted entry of the matrix $C$ given below. Describe it in terms of $c_{ij}$.\n\n$\\begin{bmatrix}0 & -2 & 5 \\\\ 34 & 5 & 1\\end{bmatrix}$" :question/worked-solution "The entry lies at the intersection of the $1$st row and $3$rd column. Therefore, we have\n\n$$\nc_{13}={\\bbox[lightgray, 2pt]{5}}\n$$"}] [{:db/id #edb/ref 17592186101037 :knowledge-point/_questions [{:knowled