53d9f31bbe812c4d19c2a6605c868" "q-70360/selection/5ac41f560d44589b8e3c2694f07e5aad599f8614f2e9137ca5f260315addf712"] :db/ensure [:answer-field/validate]} {:db/id "q-70360" :question/id #uuid "122985a1-7e86-5493-b392-952256a980d8" :question/math-academy-id "q-70360" :question/is-example false :question/problem "$\\frac{4y}{x-6}+\\frac{2y}{2x+3}=$" :question/worked-solution "In this case, we need to put the fractions over a common denominator of $(x-6)(2x+3),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $2x+3,$ and the top and bottom of the second fraction by $x-6:$ \n\n$$\n\\begin{aligned}\\frac{4y}{x-6}+\\frac{2y}{2x+3} & = \\\\ \\frac{2x+3}{2x+3}\\cdot \\frac{4y}{x-6}+\\frac{x-6}{x-6}\\cdot \\frac{2y}{2x+3} & = \\\\ \\frac{4y(2x+3)}{(x-6)(2x+3)}+\\frac{2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{4y(2x+3)+2y(x-6)}{(x-6)(2x+3)} & = \\\\ \\frac{8xy+12y+2xy-12y}{(x-6)(2x+3)} & = \\\\ \\frac{10xy}{(x-6)(2x+3)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70360/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3db20b82-9561-5c54-8e12-8914bb6747c3"] :knowledge-point/questions ["q-70360"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113219/selection/99814b957c2770e7a89e711b63eba9fd1f3f1e630e9b6fb575ae0e507f9b8801" :answer/id #uuid "3e022e83-0361-56e3-97f7-a1b9916772e4" :answer/type :answer.type/math :answer/value "\\frac{3(2h+1)}{h}" :db/ensure [:answer/validate]} {:db/id "q-113219/selection/498487abcc08e9d5757224cd19eb13f554abdffc3fa749183d0461b510ae0811" :answer/id #uuid "40831578-ff21-558c-89b8-520eb3865c9b" :answer/type :answer.type/math :answer/value "\\frac{2h-1}{h}" :db/ensure [:answer/validate]} {:db/id "q-113219/selection/62a430d7c1a5d1280eee1a528a5b28241979fdea29dc9e8eaf8f8513b7c0794d" :answer/id #uuid "22555531-2d92-54be-8c5a-ef1a04e70bd7" :answer/type :answer.type/math :answer/value "\\frac{h-3}{h}" :db/ensure [:answer/validate]} {:db/id "q-113219/selection/786d195d45b84584d08c801d044db3b4c9c0e251ac8d8433229e18a8268899b9" :answer/id #uuid "6d7eda36-c6fd-572b-9acd-285549208452" :answer/type :answer.type/math :answer/value "\\frac{3(2h-1)}{h}" :db/ensure [:answer/validate]} {:db/id "q-113219/selection/8da1ebea05a307a0283695014a1ca53ff55b3561eab320ffaf76434520f3b4f4" :answer/id #uuid "5b48c39f-6466-5150-9c81-103e929cfff3" :answer/type :answer.type/math :answer/value "\\frac{2h+1}{h}" :db/ensure [:answer/validate]} {:db/id "q-113219/selection" :answer-field/id #uuid "2cc2b2e9-11aa-5acb-9238-ecd67f93b5fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113219/selection/786d195d45b84584d08c801d044db3b4c9c0e251ac8d8433229e18a8268899b9" :answer-field/choices ["q-113219/selection/99814b957c2770e7a89e711b63eba9fd1f3f1e630e9b6fb575ae0e507f9b8801" "q-113219/selection/498487abcc08e9d5757224cd19eb13f554abdffc3fa749183d0461b510ae0811" "q-113219/selection/62a430d7c1a5d1280eee1a528a5b28241979fdea29dc9e8eaf8f8513b7c0794d" "q-113219/selection/786d195d45b84584d08c801d044db3b4c9c0e251ac8d8433229e18a8268899b9" "q-113219/selection/8da1ebea05a307a0283695014a1ca53ff55b3561eab320ffaf76434520f3b4f4"] :db/ensure [:answer-field/validate]} {:db/id "q-113219" :question/id #uuid "1499037e-a606-58e5-b3be-b1c588e43b7e" :question/math-academy-id "q-113219" :question/is-example false :question/problem "Write $5+\\frac{h-3}{h}$ as a single fraction." :question/worked-solution "Using the fact that $5=\\frac{5}{1},$ we can write the expression as\n\n$$\n\\frac{5}{1}+\\frac{h-3}{h}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $h$ by multiplying the top and bottom of the first fraction by $h:$\n\n$$\n\\begin{aligned}\\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{h}{h}\\cdot \\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{5h}{h}+\\frac{h-3}{h}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{5h}{h}+\\frac{h-3}{h} & = \\\\ \\frac{5h+h-3}{h} & = \\\\ \\frac{6h-3}{h} & = \\\\ \\frac{3(2h-1)}{h}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113219/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-113219"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113221/selection/9247886bc8fae2a0dc26d93709624f765ad6fa41e09e528e1b84f94407f1beb0" :answer/id #uuid "bf7979c6-4748-5675-9411-96254bee1d3b" :answer/type :answer.type/math :answer/value "\\frac{3(k-1)}{k}" :db/ensure [:answer/validate]} {:db/id "q-113221/selection/82755304d044af79ab7d532675e18cda18a2dfcc299e994fd7d44c88ee11eb93" :answer/id #uuid "9bb2a8b2-4457-5aec-a75e-59ad6db210b6" :answer/type :answer.type/math :answer/value "\\frac{4k+3}{k}" :db/ensure [:answer/validate]} {:db/id "q-113221/selection/de18472c0ee85bdbb348ddbf1846045ee668b152fa6f19542b1a98a4196fd2c0" :answer/id #uuid "c4a8c1b4-00b2-522d-a935-677d003a19ea" :answer/type :answer.type/math :answer/value "\\frac{3(k+1)}{k}" :db/ensure [:answer/validate]} {:db/id "q-113221/selection/56f1a23d20c99d98c90c7dfc5761ccec93e34b129229ad75112c133b1e3078d5" :answer/id #uuid "98fac445-356a-51e0-b888-496a7ae95742" :answer/type :answer.type/math :answer/value "\\frac{8k-3}{k}" :db/ensure [:answer/validate]} {:db/id "q-113221/selection/82c8212f0774383753c5528a14761c7aaa5895a3e61af08ec908094259977654" :answer/id #uuid "a84b2eab-b5a6-5fb1-b468-bd9134470196" :answer/type :answer.type/math :answer/value "\\frac{4k-1}{k}" :db/ensure [:answer/validate]} {:db/id "q-113221/selection" :answer-field/id #uuid "cf1f80a0-b455-513e-92e2-e43df47b271b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113221/selection/82755304d044af79ab7d532675e18cda18a2dfcc299e994fd7d44c88ee11eb93" :answer-field/choices ["q-113221/selection/9247886bc8fae2a0dc26d93709624f765ad6fa41e09e528e1b84f94407f1beb0" "q-113221/selection/82755304d044af79ab7d532675e18cda18a2dfcc299e994fd7d44c88ee11eb93" "q-113221/selection/de18472c0ee85bdbb348ddbf1846045ee668b152fa6f19542b1a98a4196fd2c0" "q-113221/selection/56f1a23d20c99d98c90c7dfc5761ccec93e34b129229ad75112c133b1e3078d5" "q-113221/selection/82c8212f0774383753c5528a14761c7aaa5895a3e61af08ec908094259977654"] :db/ensure [:answer-field/validate]} {:db/id "q-113221" :question/id #uuid "191f0018-0145-5873-a8dd-22bae45a6fd5" :question/math-academy-id "q-113221" :question/is-example false :question/problem "Write $6+\\frac{3-2k}{k}$ as a single fraction." :question/worked-solution "Using the fact that $6=\\frac{6}{1},$ we can write the expression as\n\n$$\n\\frac{6}{1}+\\frac{3-2k}{k}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $k$ by multiplying the top and bottom of the first fraction by $k:$\n\n$$\n\\begin{aligned}\\frac{6}{1}+\\frac{3-2k}{k} & = \\\\ \\frac{k}{k}\\cdot \\frac{6}{1}+\\frac{3-2k}{k} & = \\\\ \\frac{6k}{k}+\\frac{3-2k}{k}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{6k}{k}+\\frac{3-2k}{k} & = \\\\ \\frac{6k+3-2k}{k} & = \\\\ \\frac{4k+3}{k}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113221/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-113221"] :db/ensure [:knowledge-point/validate]}]
