[{:db/id [:question/math-academy-id "q-11858"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003808/assets/8b1d78038032973d7bb5738b67963e0bfadb258e4c1eb06f191496bded406696.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a right-opening parabola is the left-most point of the parabola.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003808/assets/aaf295d69a75c976df8aaf02ee6680486c502f7ce5719b41682cdf2499cab984.png)\n\nTherefore, the coordinates of the vertex are $(-6,0).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-84830"] :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=4(y-2)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nComparing our equation with the standard equation, we can see that we have $h=0$ and $k=2.$ Therefore, the coordinates of the vertex of the parabola are $(0,2).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-84947/selection/f3b15f9080639a787097d8b780ade7100103852ae38e37130300d2afcd5c2f1d" :answer/id #uuid "bc3ae3b8-b114-558a-baaa-9cd784bdcee5" :answer/type :answer.type/math :answer/value "(-3,0)" :db/ensure [:answer/validate]} {:db/id "q-84947/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" :answer/id #uuid "e9ec3454-462a-548e-a113-ab3669eee311" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "q-84947/selection/aca3fb0d9ddb49350c290ac929c3cc1d4fe3619668acb3d7b8d6d89671359f83" :answer/id #uuid "f3445f00-22c2-5e58-bd68-ef1d1c31e9f9" :answer/type :answer.type/math :answer/value "(0,3)" :db/ensure [:answer/validate]} {:db/id "q-84947/selection/f3