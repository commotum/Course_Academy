d3292b3a50a20caba1be6fc314343612f38e3ea2"] :db/ensure [:answer-field/validate]} {:db/id "q-84966" :question/id #uuid "586fe0ed-baf1-5cf1-9b94-1dfe96efb997" :question/math-academy-id "q-84966" :question/problem "What are the coordinates of the vertex of the parabola ${x}^{2}=-\\frac{3}{2}(y-1)?$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as\n\n$$\n\\begin{aligned}(x-0)^{2} & =4(-\\frac{3}{8})(y-1).\\end{aligned}\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{3}{8}.$\n\nComparing our equation with the standard equation, we can see that we have $h=0$ and $k=1.$ Therefore, the coordinates of the vertex of the parabola are $(0,1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84966/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67455965-c9d3-5ae8-8b56-2a58af95df0a"] :knowledge-point/questions ["q-84966"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115908/selection/af22f8809b7ea512514e0843e603059a2f0cabf3b094d2680a296d62443e7d08" :answer/id #uuid "248d0675-1c22-5207-9166-a41b8114441a" :answer/type :answer.type/math :answer/value "(8,0)" :db/ensure [:answer/validate]} {:db/id "q-115908/selection/e65ce3f35238adafb1c4662790d2bfc7ea051b44f409308c61081548c96b1ae4" :answer/id #uuid "407c69bf-f7f5-55fa-a185-81235d39bf41" :answer/type :answer.type/math :answer/value "(0,32)" :db/ensure [:answer/validate]} {:db/id "q-115908/selection/66de7ff1b7cbf574d42b7bd40f9ad0ac12b5f01e0beb69f180f89bdfcac40c0b" :answer/id #uuid "a21b34b6-b728-596f-a47f-6c5589f1e1ae" :answer/type :answer.type/math :answer/value "(0,-8)" :db/ensure [:answer/validate]} {:db/id "q-115908/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :answer/id #uuid "97a079cd-1a5e-56de-9bd6-987023c816da" :answer/type :a