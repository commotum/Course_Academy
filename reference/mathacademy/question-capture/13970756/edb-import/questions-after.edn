#{[{:db/id #edb/ref 17592186275628 :knowledge-point/_questions [{:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb" :knowledge-point/title "Dividing an Imaginary Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de0b10b-47fe-56b5-b937-b5569e5e9101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275630}] :answer-field/correct {:answer/id #uuid "1de0b10b-47fe-56b5-b937-b5569e5e9101" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275630} :answer-field/id #uuid "764ff62d-2f8e-5ef3-af41-de7e5875e934" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275629} {:answer-field/choices [{:answer/id #uuid "2c0eb84b-6c92-5b7e-a069-18784297930a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275632}] :answer-field/correct {:answer/id #uuid "2c0eb84b-6c92-5b7e-a069-18784297930a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275632} :answer-field/id #uuid "c07b9bab-4835-5fbd-a748-3f03e4df9125" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275631}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e8165711-54b7-5043-aeb6-860843b30537" :question/math-academy-id "q-316847" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5\\text{i}}{1+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $1+3\\text{i}$ and its conjugate is $1-3\\text{i}.$ We multiply both the numerator and the denominator by $1-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5\\text{i}}{1+3\\text{i}} & =\\frac{5\\text{i}}{1+3\\text{i}}\\cdot \\frac{1-3\\text{i}}{1-3\\text{i}} \\\\  & =\\frac{5\\text{i}-15{\\text{i}}^{2}}{{1}^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{5\\text{i}-15(-1)}{1-(-9)} \\\\  & =\\frac{5\\text{i}+15}{10} \\\\  & =\\frac{15+5\\text{i}}{10}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{15+5\\text{i}}{10}=(\\frac{3}{2})+(\\frac{1}{2})\\,\\text{i}.\n$$"}] [{:db/id #edb/ref 17592186275633 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8af7f3a-52bb-5031-bd75-a6dd25393d1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{24}{25}" :db/id #edb/ref 17592186275635} {:answer/id #uuid "ad052d28-4d67-5d1a-bc30-40cd87f2181b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{25}" :db/id #edb/ref 17592186275636}] :answer-field/correct {:answer/id #uuid "ad052d28-4d67-5d1a-bc30-40cd87f2181b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{25}" :db/id #edb/ref 17592186275636} :answer-field/id #uuid "9f21e874-a77b-5ad0-b250-f66c314a7c01" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275634} {:answer-field/choices [{:answer/id #uuid "8839c6ea-7023-5c99-84e6-9815752a300a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{32}{25}" :db/id #edb/ref 17592186275638}] :answer-field/correct {:answer/id #uuid "8839c6ea-7023-5c99-84e6-9815752a300a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{32}{25}" :db/id #edb/ref 17592186275638} :answer-field/id #uuid "6893f730-5bfe-53a0-82f3-b2c5b34d58e1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275637}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "28d4b987-74ce-5e68-acc4-1696040a482b" :question/math-academy-id "q-316866" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{8}{3+4\\text{i}}=($\n {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $3+4\\text{i}$ and its conjugate is $3-4\\text{i}.$ We multiply both the numerator and the denominator by $3-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{8}{3+4\\text{i}} & =\\frac{8}{3+4\\text{i}}\\cdot \\frac{3-4\\text{i}}{3-4\\text{i}} \\\\  & =\\frac{8(3-4\\text{i})}{{3}^{2}-(4\\text{i})^{2}} \\\\  & =\\frac{24-32\\text{i}}{9-(-16)} \\\\  & =\\frac{24-32\\text{i}}{25}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{24-32\\text{i}}{25}=(\\frac{24}{25})+(-\\frac{32}{25})\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186275639 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5732facb-3c7a-5316-aefe-6363f85e922d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186275641}] :answer-field/correct {:answer/id #uuid "5732facb-3c7a-5316-aefe-6363f85e922d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{13}" :db/id #edb/ref 17592186275641} :answer-field/id #uuid "58546355-f26b-59a5-a14e-203f6070847d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275640} {:answer-field/choices [{:answer/id #uuid "363576bd-5aa3-5767-93bf-df0f5da6140e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186275643}] :answer-field/correct {:answer/id #uuid "363576bd-5aa3-5767-93bf-df0f5da6140e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186275643} :answer-field/id #uuid "874f22ee-26ac-519f-9d50-048764065442" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275642}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bc900cb3-472d-557f-9d66-56f5a84c0c6d" :question/math-academy-id "q-316875" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4}{-2-3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4}{-2-3\\text{i}} & =\\frac{4}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{4(-2+3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8+12\\text{i}}{4-(-9)} \\\\  & =\\frac{-8+12\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-8+12\\text{i}}{13}=(-\\frac{8}{13})+(\\frac{12}{13})\\,\\text{i}\n$$"}] [{:db/id #edb/ref 17592186275644 :knowledge-point/_questions [{:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e114a50a-7213-5723-a390-9a32deaa27b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{17}+\\frac{5}{17}\\text{i}" :db/id #edb/ref 17592186275646} {:answer/id #uuid "335af9f5-95c4-588f-8095-1c1fed2fa286" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{17}-\\frac{5}{17}\\text{i}" :db/id #edb/ref 17592186275647} {:answer/id #uuid "dfa67e3b-a103-5db9-b050-cee0e425324f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{17}+\\frac{3}{17}\\text{i}" :db/id #edb/ref 17592186275648} {:answer/id #uuid "6df7780d-f578-5d9d-9949-17331c4623a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{17}-\\frac{3}{17}\\text{i}" :db/id #edb/ref 17592186275649} {:answer/id #uuid "cd308bed-dd1d-514f-8173-6ea62b55099c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{17}+\\frac{3}{17}\\text{i}" :db/id #edb/ref 17592186275650}] :answer-field/correct {:answer/id #uuid "cd308bed-dd1d-514f-8173-6ea62b55099c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{17}+\\frac{3}{17}\\text{i}" :db/id #edb/ref 17592186275650} :answer-field/id #uuid "0fd1883b-e209-5213-b90b-7014f6ee2e5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275645}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c198a414-2383-54dd-a859-66a622e1e534" :question/math-academy-id "q-74645" :question/problem "$\\frac{2}{5-3\\text{i}}=$" :question/worked-solution "The denominator is $5-3\\text{i}$ and its conjugate is $5+3\\text{i}.$ We multiply both the numerator and the denominator by $5+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2}{5-3\\text{i}} & =\\frac{2}{5-3\\text{i}}\\cdot \\frac{5+3\\text{i}}{5+3\\text{i}} \\\\  & =\\frac{10+6\\text{i}}{25+15\\text{i}-15\\text{i}-9{\\text{i}}^{2}} \\\\  & =\\frac{10+6\\text{i}}{25-9{\\text{i}}^{2}} \\\\  & =\\frac{10+6\\text{i}}{25-(9)(-1)} \\\\  & =\\frac{10+6\\text{i}}{25+9} \\\\  & =\\frac{10+6\\text{i}}{34}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{10+6\\text{i}}{34}=\\frac{10}{34}+\\frac{6}{34}\\text{i}=\\frac{5}{17}+\\frac{3}{17}\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275651 :knowledge-point/_questions [{:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958" :knowledge-point/title "Dividing a Complex Number by an Imaginary Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82930eec-5143-5cb4-ad2e-acef290128e8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186275653} {:answer/id #uuid "ce6cd9b2-62b5-5b5b-87ad-8156d9263f51" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186275654} {:answer/id #uuid "d4358646-3044-5765-8dec-1659b7334977" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186275655} {:answer/id #uuid "ee71f55b-47b2-59d7-97f8-d5378a962070" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}+\\frac{2}{3}\\text{i}" :db/id #edb/ref 17592186275656} {:answer/id #uuid "75f9338f-1db7-5f31-b56b-fa182ea9d42b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{4}{3}\\text{i}" :db/id #edb/ref 17592186275657}] :answer-field/correct {:answer/id #uuid "82930eec-5143-5cb4-ad2e-acef290128e8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186275653} :answer-field/id #uuid "62cf2847-e1c1-53f3-b1fb-c257576f4a05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275652}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "48e8594b-70b2-564c-8866-9f05278aa647" :question/math-academy-id "q-74653" :question/problem "If ${z}_{1}=5-2\\text{i}$ and ${z}_{2}=3\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" :question/worked-solution "First, we set up the fraction:\n\n$$\n\\frac{5-2\\text{i}}{3\\text{i}}\n$$\n\nThe denominator is the imaginary number $3\\text{i}.$ Note that this can be written as $0+3\\text{i},$ so the conjugate is $0-3\\text{i},$ or simply $-3\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{5-2\\text{i}}{3\\text{i}} \\\\  & =\\frac{5-2\\text{i}}{3\\text{i}}\\cdot \\frac{-3\\text{i}}{-3\\text{i}} \\\\  & =\\frac{-15\\text{i}+6{\\text{i}}^{2}}{-9{\\text{i}}^{2}} \\\\  & =\\frac{-15\\text{i}+6(-1)}{-9(-1)} \\\\  & =\\frac{-6-15\\text{i}}{9}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-6-15\\text{i}}{9}=-\\frac{6}{9}-\\frac{15}{9}\\text{i}=-\\frac{2}{3}-\\frac{5}{3}\\text{i}\\end{aligned}\\end{aligned}\n$$"}]}
