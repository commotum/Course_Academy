09f1ff9efa6dd66793ed37ef63914518445be0e1"] :db/ensure [:answer-field/validate]} {:db/id "q-74645" :question/id #uuid "c198a414-2383-54dd-a859-66a622e1e534" :question/math-academy-id "q-74645" :question/problem "$\\frac{2}{5-3\\text{i}}=$" :question/worked-solution "The denominator is $5-3\\text{i}$ and its conjugate is $5+3\\text{i}.$ We multiply both the numerator and the denominator by $5+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2}{5-3\\text{i}} & =\\frac{2}{5-3\\text{i}}\\cdot \\frac{5+3\\text{i}}{5+3\\text{i}} \\\\  & =\\frac{10+6\\text{i}}{25+15\\text{i}-15\\text{i}-9{\\text{i}}^{2}} \\\\  & =\\frac{10+6\\text{i}}{25-9{\\text{i}}^{2}} \\\\  & =\\frac{10+6\\text{i}}{25-(9)(-1)} \\\\  & =\\frac{10+6\\text{i}}{25+9} \\\\  & =\\frac{10+6\\text{i}}{34}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{10+6\\text{i}}{34}=\\frac{10}{34}+\\frac{6}{34}\\text{i}=\\frac{5}{17}+\\frac{3}{17}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74645/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9"] :knowledge-point/questions ["q-74645"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74653/selection/4ab1980aee19528545e0cc3df1f975e0a3080537b84a68fb745aa9173d413eee" :answer/id #uuid "ce6cd9b2-62b5-5b5b-87ad-8156d9263f51" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74653/selection/e4853e05133b6236828dd2c802ee3b1727720cf40ab449acc5d94007f803096d" :answer/id #uuid "75f9338f-1db7-5f31-b56b-fa182ea9d42b" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}-\\frac{4}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74653/selection/a447cbead25d55d33bcea0cdf8785ff433af9a13c6ed2acc4f8c9e4e2dca90c7" :answer/id #uuid "ee71f55b-47b2-59d7-97f8-d5378a962070" :answer/type :answer.type/math :answer/value "\\frac{5}{3}+\\frac{2}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74653/selection/91d907fbac2281f7cf887650f92f25bb8173a42df47d4bc4636de2bfa7eecf53" :answer/id #uuid "d4358646-3044-5765-8dec-1659b7334977" :answer/type :answer.type/math :answer/value "\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74653/selection/478179c61edd3bc6a4cd8f313574014cab8454b1ffb2c4ae7f5b90011b128966" :answer/id #uuid "82930eec-5143-5cb4-ad2e-acef290128e8" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}-\\frac{5}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74653/selection" :answer-field/id #uuid "62cf2847-e1c1-53f3-b1fb-c257576f4a05" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74653/selection/478179c61edd3bc6a4cd8f313574014cab8454b1ffb2c4ae7f5b90011b128966" :answer-field/choices ["q-74653/selection/4ab1980aee19528545e0cc3df1f975e0a3080537b84a68fb745aa9173d413eee" "q-74653/selection/e4853e05133b6236828dd2c802ee3b1727720cf40ab449acc5d94007f803096d" "q-74653/selection/a447cbead25d55d33bcea0cdf8785ff433af9a13c6ed2acc4f8c9e4e2dca90c7" "q-74653/selection/91d907fbac2281f7cf887650f92f25bb8173a42df47d4bc4636de2bfa7eecf53" "q-74653/selection/478179c61edd3bc6a4cd8f313574014cab8454b1ffb2c4ae7f5b90011b128966"] :db/ensure [:answer-field/validate]} {:db/id "q-74653" :question/id #uuid "48e8594b-70b2-564c-8866-9f05278aa647" :question/math-academy-id "q-74653" :question/problem "If ${z}_{1}=5-2\\text{i}$ and ${z}_{2}=3\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" :question/worked-solution "First, we set up the fraction:\n\n$$\n\\frac{5-2\\text{i}}{3\\text{i}}\n$$\n\nThe denominator is the imaginary number $3\\text{i}.$ Note that this can be written as $0+3\\text{i},$ so the conjugate is $0-3\\text{i},$ or simply $-3\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{5-2\\text{i}}{3\\text{i}} \\\\  & =\\frac{5-2\\text{i}}{3\\text{i}}\\cdot \\frac{-3\\text{i}}{-3\\text{i}} \\\\  & =\\frac{-15\\text{i}+6{\\text{i}}^{2}}{-9{\\text{i}}^{2}} \\\\  & =\\frac{-15\\text{i}+6(-1)}{-9(-1)} \\\\  & =\\frac{-6-15\\text{i}}{9}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-6-15\\text{i}}{9}=-\\frac{6}{9}-\\frac{15}{9}\\text{i}=-\\frac{2}{3}-\\frac{5}{3}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958"] :knowledge-point/questions ["q-74653"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316847/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "1de0b10b-47fe-56b5-b937-b5569e5e9101" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-316847/field-1" :answer-field/id #uuid "764ff62d-2f8e-5ef3-af41-de7e5875e934" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316847/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-316847/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-316847/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "2c0eb84b-6c92-5b7e-a069-18784297930a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-316847/field-2" :answer-field/id #uuid "c07b9bab-4835-5fbd-a748-3f03e4df9125" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316847/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-316847/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-316847" :question/id #uuid "e8165711-54b7-5043-aeb6-860843b30537" :question/math-academy-id "q-316847" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5\\text{i}}{1+3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $1+3\\text{i}$ and its conjugate is $1-3\\text{i}.$ We multiply both the numerator and the denominator by $1-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5\\text{i}}{1+3\\text{i}} & =\\frac{5\\text{i}}{1+3\\text{i}}\\cdot \\frac{1-3\\text{i}}{1-3\\text{i}} \\\\  & =\\frac{5\\text{i}-15{\\text{i}}^{2}}{{1}^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{5\\text{i}-15(-1)}{1-(-9)} \\\\  & =\\frac{5\\text{i}+15}{10} \\\\  & =\\frac{15+5\\text{i}}{10}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{15+5\\text{i}}{10}=(\\frac{3}{2})+(\\frac{1}{2})\\,\\text{i}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316847/field-1" "q-316847/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-316847"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316866/field-1/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f" :answer/id #uuid "ad052d28-4d67-5d1a-bc30-40cd87f2181b" :answer/type :answer.type/math :answer/value "\\frac{24}{25}" :db/ensure [:answer/validate]} {:db/id "q-316866/field-1/793138a624409b90fa9b340ca090834ed407b4abcfc4980ec68ef46e0b8cea69" :answer/id #uuid "e8af7f3a-52bb-5031-bd75-a6dd25393d1a" :answer/type :answer.type/math :answer/value "-\\frac{24}{25}" :db/ensure [:answer/validate]} {:db/id "q-316866/field-1" :answer-field/id #uuid "9f21e874-a77b-5ad0-b250-f66c314a7c01" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316866/field-1/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f" :answer-field/choices ["q-316866/field-1/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f" "q-316866/field-1/793138a624409b90fa9b340ca090834ed407b4abcfc4980ec68ef46e0b8cea69"] :db/ensure [:answer-field/validate]} {:db/id "q-316866/field-2/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c" :answer/id #uuid "8839c6ea-7023-5c99-84e6-9815752a300a" :answer/type :answer.type/math :answer/value "-\\frac{32}{25}" :db/ensure [:answer/validate]} {:db/id "q-316866/field-2" :answer-field/id #uuid "6893f730-5bfe-53a0-82f3-b2c5b34d58e1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316866/field-2/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c" :answer-field/choices ["q-316866/field-2/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c"] :db/ensure [:answer-field/validate]} {:db/id "q-316866" :question/id #uuid "28d4b987-74ce-5e68-acc4-1696040a482b" :question/math-academy-id "q-316866" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{8}{3+4\\text{i}}=($\n {{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $3+4\\text{i}$ and its conjugate is $3-4\\text{i}.$ We multiply both the numerator and the denominator by $3-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{8}{3+4\\text{i}} & =\\frac{8}{3+4\\text{i}}\\cdot \\frac{3-4\\text{i}}{3-4\\text{i}} \\\\  & =\\frac{8(3-4\\text{i})}{{3}^{2}-(4\\text{i})^{2}} \\\\  & =\\frac{24-32\\text{i}}{9-(-16)} \\\\  & =\\frac{24-32\\text{i}}{25}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{24-32\\text{i}}{25}=(\\frac{24}{25})+(-\\frac{32}{25})\\,\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316866/field-1" "q-316866/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9"] :knowledge-point/questions ["q-316866"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316875/field-1/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9" :answer/id #uuid "5732facb-3c7a-5316-aefe-6363f85e922d" :answer/type :answer.type/math :answer/value "-\\frac{8}{13}" :db/ensure [:answer/validate]} {:db/id "q-316875/field-1" :answer-field/id #uuid "58546355-f26b-59a5-a14e-203f6070847d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316875/field-1/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9" :answer-field/choices ["q-316875/field-1/0240bbbb32e708b766e146f87704bbfb43351b6dfc06152b57d3d720c7486ad9"] :db/ensure [:answer-field/validate]} {:db/id "q-316875/field-2/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d" :answer/id #uuid "363576bd-5aa3-5767-93bf-df0f5da6140e" :answer/type :answer.type/math :answer/value "\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-316875/field-2" :answer-field/id #uuid "874f22ee-26ac-519f-9d50-048764065442" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316875/field-2/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d" :answer-field/choices ["q-316875/field-2/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d"] :db/ensure [:answer-field/validate]} {:db/id "q-316875" :question/id #uuid "bc900cb3-472d-557f-9d66-56f5a84c0c6d" :question/math-academy-id "q-316875" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{4}{-2-3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{4}{-2-3\\text{i}} & =\\frac{4}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{4(-2+3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-8+12\\text{i}}{4-(-9)} \\\\  & =\\frac{-8+12\\text{i}}{13}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-8+12\\text{i}}{13}=(-\\frac{8}{13})+(\\frac{12}{13})\\,\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316875/field-1" "q-316875/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9"] :knowledge-point/questions ["q-316875"] :db/ensure [:knowledge-point/validate]}]
