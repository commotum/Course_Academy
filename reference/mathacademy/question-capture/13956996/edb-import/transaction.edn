1208e24cf1a022ff7d6505ec0081faf6574" "q-116927/selection/134c068bfcafc59b5066b894f3bb3a2ec3ef04815ba462d3c198bb6c3a15cfa9" "q-116927/selection/217f59164235783a935174700f4daab7a0ffa5c9a0c398ba0d19dce9030c437b"] :db/ensure [:answer-field/validate]} {:db/id "q-116927" :question/id #uuid "6871bb55-7096-5bdc-95c3-97647e61a9a8" :question/math-academy-id "q-116927" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/343897550f0f7b9e4a479e47c9191ababa31070dac79dbf4d54befe869661a48.png)\n\nGiven that the points $X$ and $Y$ with coordinates $(-1,2)$ and $(1,-2),$ respectively, are the endpoints of a diameter of a circle centered at the origin, what is the equation of the circle?" :question/worked-solution "The equation of a circle with radius $r,$ centered at the origin, is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nFirst, we calculate the length of the diameter $\\overset{―}{XY}:$\n\n$$\n\\begin{aligned}XY & =\\sqrt{(-1-1)^{2}+(2-(-2))^{2}} \\\\  & =\\sqrt{(-2)^{2}+{4}^{2}} \\\\  & =\\sqrt{4+16} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nSince $\\overset{―}{XY}$ is a diameter, the radius is\n\n$$\nr=\\frac{XY}{2}=\\frac{2\\sqrt{5}}{2}=\\sqrt{5}.\n$$\n\nSo, the equation of the circle is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={(\\sqrt{5})}^{2} \\\\ {x}^{2}+{y}^{2} & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-116927/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e75012ec-8203-574b-ba07-0a26e4cf4691"] :knowledge-point/questions ["q-116927"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14559/selection/5efc61350a1c6b4d6bbce279454f25f377abdfffe75badf072e6aad81079b5fc" :answer/id #uuid "0f919697-d086-5c01-b28c-dab3ff23bcf3" :answer/type :answer.type/math :answer/value "{x}^{2}+{y}^{2}=\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-14559/selection/89915c1571680806587e3b1defefe1208e24cf1a022ff7d6505ec0081faf6574" :answer/id #uuid "fea0b4b6-4011-5789-a704-3774e3fbe460" :answer/type :answer.type/math :answer/value "{x}^{2}+{y}^{2}=25" :db/ensure [:answer/validate]} {:db/id "q-14559/selection/1b29fee6a2b4db3faadcb32f64058546357c882be3d2f7ecc30f3f98840bc09d" :answer/id #uuid "6778cf3d-0306-556d-9879-566cfa0f6f20" :answer/type :answer.type/math :answer/value "{x}^{2}+{y}^{2}=100" :db/ensure [:answer/validate]} {:db/id "q-14559/selection/217f59164235783a935174700f4daab7a0ffa5c9a0c398ba0d19dce9030c437b" :answer/id #uuid "b7c1258b-cb57-5a5d-97f3-d3a123597d7e" :answer/type :answer.type/math :answer/value "{x}^{2}+{y}^{2}=5" :db/ensure [:answer/validate]} {:db/id "q-14559/selection/f7608b18c40c1fc099ba7b282ec8518d3f085351d258f715092a918fa66ee774" :answer/id #uuid "d30a2377-bc5d-52ea-a655-ebf7df3b76b8" :answer/type :answer.type/math :answer/value "(x-4)^{2}+(y-3)^{2}=5" :db/ensure [:answer/validate]} {:db/id "q-14559/selection" :answer-field/id #uuid "021ccf57-4059-55f5-b193-fcbb451d844e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14559/selection/89915c1571680806587e3b1defefe1208e24cf1a022ff7d6505ec0081faf6574" :answer-field/choices ["q-14559/selection/5efc61350a1c6b4d6bbce279454f25f377abdfffe75badf072e6aad81079b5fc" "q-14559/selection/89915c1571680806587e3b1defefe1208e24cf1a022ff7d6505ec0081faf6574" "q-14559/selection/1b29fee6a2b4db3faadcb32f64058546357c882be3d2f7ecc30f3f98840bc09d" "q-14559/selection/217f59164235783a935174700f4daab7a0ffa5c9a0c398ba0d19dce9030c437b" "q-14559/selection/f7608b18c40c1fc099ba7b282ec8518d3f085351d258f715092a918fa66ee774"] :db/ensure [:answer-field/validate]} {:db/id "q-14559" :question/id #uuid "08a7411b-9289-5682-bc33-79fdf3eacff1" :question/math-academy-id "q-14559" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/14af607cba7a2c47e8443857f5f3ed6ff33cd5fa2fb12e5d451eea08a932139a.png)\n\nGiven that the points $X$ and $Y$ with coordinates $(3,4)$ and $(-3,-4),$ respectively, are the endpoints of a diameter of a circle centered at the origin, what is the equation of the circle?" :question/worked-solution "The equation of a circle with radius $r,$ centered at the origin, is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nFirst, we calculate the length of the diameter $\\overset{―}{XY}:$\n\n$$\n\\begin{aligned}XY & =\\sqrt{{(4-(-4))}^{2}+{(3-(-3))}^{2}} \\\\  & =\\sqrt{{8}^{2}+{6}^{2}} \\\\  & =\\sqrt{100} \\\\  & =10\\end{aligned}\n$$\n\nSince $\\overset{―}{XY}$ is a diameter, the radius is\n\n$$\nr=\\frac{XY}{2}=\\frac{10}{2}=5.\n$$\n\nTherefore, the equation of the circle is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={5}^{2} \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-14559/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e75012ec-8203-574b-ba07-0a26e4cf4691"] :knowledge-point/questions ["q-14559"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-3220"] :question/problem "What is the center and radius of the circle with equation $x^2 + y^2 = 9?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the origin is \n\n$$\nx^2 + y^2 = r^2.\n$$\n\nSo, the equation $x^2+y^2=9$ represents a circle that is centered at the origin, with radius\n\n$$\n\\begin{aligned}{r}^{2} & =9 \\\\ r & =\\sqrt{9} \\\\ r & =3.\\end{aligned}\n$$\n\nNote that we disregarded the negative solution for the radius since the radius of a circle must be positive.\n\nIn conclusion, the circle is centered at the origin and its radius is $3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3221"] :question/problem "What is the equation of the circle given below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/6d437677c2ae4c642a30ccf3528ab390274137d8ec646731aaf3b8a024e649da.png)" :question/worked-solution "The general equation of a circle with radius $r$ centered at the origin is \n\n$$\nx^2 + y^2 = r^2.\n$$\n\nFrom the picture, we see that our circle is centered at $(0,0)$ and has radius $r = 2.$ So, the equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={2}^{2} \\\\ {x}^{2}+{y}^{2} & =4.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3223"] :question/worked-solution "The set of all points $(x,y)$ that are a distance $4$ from the origin defines a circle with radius $r=4$ centered at the origin, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/8ce0e0d4582e98c15c0baea65910d03d7877550d2647581adff04df65e643e9c.png)\n\nSo, the required equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={4}^{2} \\\\ {x}^{2}+{y}^{2} & =16.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3225"] :question/problem "Given that the points $A$ and $B$ with coordinates $(-2,4)$ and $(2,-4),$ respectively,  lie on a diameter of a circle centered at the origin, what is the equation of the circle?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/1909e28f4fa0376eb59fc1d1a117d10e9fbe4580aee1706e90516d84dede5940.png)" :question/worked-solution "The equation of a circle with radius $r,$ centered at the origin, is \n\n$$\nx^2 + y^2 = r^2.\n$$\n\nNow, we first calculate the diameter $AB\\mathbin{:}$\n\n$$\n\\begin{aligned}AB & =\\sqrt{(-2-2)^{2}+{(4-(-4))}^{2}} \\\\  & =\\sqrt{{4}^{2}+{8}^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}\\end{aligned}\n$$\n\nSince $\\overline{AB}$ is a diameter, the radius is\n\n$$\nr=\\dfrac{AB}{2} = \\dfrac {4\\sqrt{5}}{2}=2\\sqrt5.\n$$\n\nSo, the equation of the circle is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={(2\\sqrt{5})}^{2} \\\\ {x}^{2}+{y}^{2} & =20.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
