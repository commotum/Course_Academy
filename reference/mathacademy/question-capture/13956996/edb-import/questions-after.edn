 #uuid "54e93528-7f3e-585b-adb2-59ca1ddb709e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186300272}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c110d52b-a473-5b27-a95b-4651eb5cdc50" :question/math-academy-id "q-249695" :question/problem "The circle with equation ${x}^{2}+{y}^{2}=196$ is centered at $(${{field-1}}$,$ \n{{field-2}}$)$ and its radius is{{field-3}}." :question/worked-solution "The general equation of a circle with radius $r$ centered at the origin is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nSo, the equation ${x}^{2}+{y}^{2}=196$ represents a circle that is centered at the origin, with radius\n\n$$\n\\begin{aligned}{r}^{2} & =196 \\\\ r & =\\sqrt{196} \\\\ r & =14.\\end{aligned}\n$$\n\nNote that we disregarded the negative solution for the radius since the radius of a circle must be positive.\n\nTherefore, the center is $(0,0)$ and the radius is $r=14.$"}] [{:db/id #edb/ref 17592186300274 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfc862ea-961c-50e4-a89b-10c5ef88d851" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e531f534-19e9-5f81-8d04-a51fbd4f2229" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186300276} {:answer/id #uuid "8cd3bb77-9ec4-5122-811c-e0b6a2f53723" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300277}] :answer-field/correct {:answer/id #uuid "8cd3bb77-9ec4-5122-811c-e0b6a2f53723" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300277} :answer-field/id #uuid "793cd198-56ee-5c9b-bfc7-123f86dd0971" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186300275} {:answer-field/choices [{:answer/id #uuid "e480c403-f38a-5300-9646-884a