287 :knowledge-point/_questions [{:knowledge-point/id #uuid "30bb1401-f704-520c-a23e-5a238e44960e" :knowledge-point/title "Finding the Equation of a Circle Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36b898a9-4a5e-5f6d-860f-d4b354f85fbb" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+y^2" :db/id #edb/ref 17592186300289} {:answer/id #uuid "bb5822bb-998e-5dae-96fd-a166219422d4" :answer/type {:db/ident :answer.type/math} :answer/value "x^2-y^2" :db/id #edb/ref 17592186300290}] :answer-field/correct {:answer/id #uuid "36b898a9-4a5e-5f6d-860f-d4b354f85fbb" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+y^2" :db/id #edb/ref 17592186300289} :answer-field/id #uuid "eed564d8-7d9f-5acd-85c3-0c95226850b3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186300288} {:answer-field/choices [{:answer/id #uuid "c11c20e3-8d5c-592a-a16a-23f62d0b52c8" :answer/type {:db/ident :answer.type/math} :answer/value "625" :db/id #edb/ref 17592186300292}] :answer-field/correct {:answer/id #uuid "c11c20e3-8d5c-592a-a16a-23f62d0b52c8" :answer/type {:db/ident :answer.type/math} :answer/value "625" :db/id #edb/ref 17592186300292} :answer-field/id #uuid "706d3259-042d-5071-b455-2dab4602c47a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186300291}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0cd3ceb-3f0f-5723-90be-962a17d3e0ca" :question/math-academy-id "q-249864" :question/problem "Construct an equation that describes the set of all points $(x,y)$ that are a distance of $25$ units from the origin. Express your answer in standard form.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "The set of all points $(x,y)$ that are a distance of $25$ units from the origin defines a circle with radius $r=25$ centered at the origin, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13956996/assets/d526d47989c735bcdd8629b76246c3bd88d4b3a142bcdffb33ea8bc0c51cb31e.png)\n\nSo, the required equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={25}^{2} \\\\ {x}^{2}+{y}^{2} & =625.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186300293 :knowledge-point/_questions [{:knowledge-point/id #uuid "cfc862ea-961c-50e4-a89b-10c5ef88d851" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3b502fb-a519-5461-ae70-6c82e6d92adb" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and the radius is $169$" :db/id #edb/ref 17592186300295} {:answer/id #uuid "857938e6-65c1-537b-aa41-d91d4edbdb76" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,1)$ and the radius is $\\sqrt{13}$" :db/id #edb/ref 17592186300296} {:answer/id #uuid "1d191633-7568-5331-902a-21b6e16318bd" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and the radius is $26$" :db/id #edb/ref 17592186300297} {:answer/id #uuid "ce7f5b16-1c41-551c-9743-a91d66d9b75b" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,1)$ and the radius is $9$" :db/id #edb/ref 17592186300298} {:answer/id #uuid "94aefdd3-99db-5dba-90a0-d4f47dea5eea" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and the radius is $13$" :db/id #edb/ref 17592186300299}] :answer-field/correct {:answer/id #uuid "94aefdd3-99db-5dba-90a0-d4f47dea5eea" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and the radius is $13$" :db/id #edb/ref 17592186300299} :answer-field/id #uuid "97aa2390-4b2d-52b3-b25f-2b75f9ef994a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300294}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "13dc47a1-270d-56c2-8deb-b105337fbddb" :question/math-academy-id "q-54202" :question/problem "What is the center and radius of the circle with the equation ${x}^{2}+{y}^{2}=169?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the origin is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nSo, the equation ${x}^{2}+{y}^{2}=169$ represents a circle that is centered at the origin, with radius\n\n$$\n\\begin{aligned}{r}^{2} & =169 \\\\ r & =\\sqrt{169} \\\\ r & =13.\\end{aligned}\n$$\n\nNote that we disregarded the negative solution for the radius since the radius of a circle must be positive.\n\nTherefore, the circle is centered at $(0,0)$ and its radius is $13.$"}] [{:db/id #edb/ref 17592186300300 :knowledge-point/_questions [{:knowledge-point/id #uuid "30bb1401-f704-520c-a23e-5a238e44960e" :knowledge-point/title "Finding the Equation of a Circle Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69d47994-8c76-5c87-8c8d-826b21deeb48" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=144" :db/id #edb/ref 17592186300302} {:answer/id #uuid "413b0fde-0d2d-5847-a6e4-767a08dc1e48" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=24" :db/id #edb/ref 17592186300303} {:answer/id #uuid "6e2cb57c-4470-54b8-889d-b383db14c607" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=12" :db/id #edb/ref 17592186300304} {:answer/id #uuid "0ae96107-3154-57da-9b34-0658d6d1198a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}+144=0" :db/id #edb/ref 17592186300305} {:answer/id #uuid "b4ec9784-e4c0-5c68-8a8a-6af8b40f3f46" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{12}" :db/id #edb/ref 17592186300306}] :answer-field/correct {:answer/id #uuid "69d47994-8c76-5c87-8c8d-826b21deeb48" :answer/type {:db/ident