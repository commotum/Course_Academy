[{:db/id "q-22978/selection/494cd77ad8a9b447737f156e4d1a6455198b704f906ab2283374911afa938361" :answer/id #uuid "a6874f49-c4b9-5a3c-91ee-f42730108937" :answer/type :answer.type/math :answer/value "{180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-22978/selection/907756791a4f329995490175b71e3707835b60e4ecf44704d854e41a31e1a4cb" :answer/id #uuid "15926eda-7242-54ae-8ec2-ba359d102d7e" :answer/type :answer.type/math :answer/value "{545}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-22978/selection/6155cbdde72d7f146858b986bebdadebfa17074b81004d9f2368419e9f309292" :answer/id #uuid "e209b57b-63b3-559d-ba9c-1e542a26a85d" :answer/type :answer.type/math :answer/value "{450}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-22978/selection/c9e1dae1c3439e2b9c60d1d7b4e22970ee4e56e8e01e62e75c5739208dc046c5" :answer/id #uuid "f50dc8aa-38d8-5671-93c1-9dd4eab56638" :answer/type :answer.type/math :answer/value "-{800}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-22978/selection/2441f6ea647cbddcbdc92e069da351cb4aa6fc5443b772bc4ffdfd2e0871ebda" :answer/id #uuid "4ebee52c-17d2-50f9-841e-821bb635f2f0" :answer/type :answer.type/math :answer/value "-{505}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-22978/selection" :answer-field/id #uuid "55a56d46-281d-5ec8-90d5-ba68a8ee96d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-22978/selection/907756791a4f329995490175b71e3707835b60e4ecf44704d854e41a31e1a4cb" :answer-field/choices ["q-22978/selection/494cd77ad8a9b447737f156e4d1a6455198b704f906ab2283374911afa938361" "q-22978/selection/907756791a4f329995490175b71e3707835b60e4ecf44704d854e41a31e1a4cb" "q-22978/selection/6155cbdde72d7f146858b986bebdadebfa17074b81004d9f2368419e9f309292" "q-22978/selection/c9e1dae1c3439e2b9c60d1d7b4e22970ee4e56e8e01e62e75c5739208dc046c5" "q-22978/selection/2441f6ea647cbddcbdc92e069da351cb4aa6fc5443b772bc4ffdfd2e0871ebda"] :db/ensure [:answer-field/validate]} {:db/id "q-22978" :question/id #uuid "5d8dcd0b-e0c8-5bbf-9e83-e01bcc550fb1" :question/math-academy-id "q-22978" :question/problem "Which angle is coterminal with $-{175}^{∘}?$" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{175}^{∘}$:\n\n- $-{175}^{∘}+{360}^{∘}={185}^{∘}$\n\n- $-{175}^{∘}+2\\cdot {360}^{∘}={545}^{∘}\\,✓$\n\nThere are no answer choices larger than ${545}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{175}^{∘}$:\n\n- $-{175}^{∘}-{360}^{∘}=-{535}^{∘}$\n\n- $-{175}^{∘}-2\\cdot {360}^{∘}=-{895}^{∘}$\n\nThere are no answer choices smaller than $-{895}^{∘},$ so we can stop here.\n\nSo the correct answer is ${545}^{∘}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-22978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bba0ad98-6940-502a-873c-8a589a03a499"] :knowledge-point/questions ["q-22978"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86322/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "45b400ff-dcba-57ea-a17c-d7b3baa20039" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-86322/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "903e6612-7286-5806-b2ff-fd846bc7285b" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-86322/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "3be755e5-9744-50da-b6c2-6d219cf385ab" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-86322/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "2259148e-5fed-52b7-a28b-8b4e2340b452" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-86322/selection/8a135ace4937b1ffa2c52fbce040999428005f5395e9d793e225144a0384a1ba" :answer/id #uuid "c811d858-4ca9-52b8-83cd-b5dffb4f26d4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-86322/selection" :answer-field/id #uuid "c1da4c49-433f-500b-803b-5f3a1a342c9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86322/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer-field/choices ["q-86322/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" "q-86322/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" "q-86322/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-86322/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" "q-86322/selection/8a135ace4937b1ffa2c52fbce040999428005f5395e9d793e225144a0384a1ba"] :db/ensure [:answer-field/validate]} {:db/id "q-86322" :question/id #uuid "3252a42d-5a90-5eb8-a245-7d72a6cbf420" :question/math-academy-id "q-86322" :question/problem "$\\operatorname{sec}⁡{135}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${135}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡{135}^{∘}=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡{135}^{∘}=\\frac{1}{\\operatorname{cos}⁡{135}^{∘}}=-\\sqrt{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86322/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d"] :knowledge-point/questions ["q-86322"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10735/selection/ba9db842b377a084bb4c4aae65133cb5d3ddc31e6d67f08278b697a1efe45781" :answer/id #uuid "fdbc4307-6880-58c1-80a5-04acdd3cd7b2" :answer/type :answer.type/math :answer/value "\\frac{21}{{x}^{-8}}" :db/ensure [:answer/validate]} {:db/id "q-10735/selection/4ba642f2f9c1826b59f8c948e1b9fa2525c007fe4ef6f656d7591af2dd0f3513" :answer/id #uuid "07fd0db0-b5f5-5a3d-9284-594cd72e2ba0" :answer/type :answer.type/math :answer/value "18{x}^{5}" :db/ensure [:answer/validate]} {:db/id "q-10735/selection/00e6b1625d7330b2130b3f7b88126171285c04a1cea0fffe124a66c70b0784b7" :answer/id #uuid "4420dc69-ff6f-5e56-b4be-9ab9823215d4" :answer/type :answer.type/math :answer/value "21{x}^{7}" :db/ensure [:answer/validate]} {:db/id "q-10735/selection/e0d4dfa2468ef26d91a338a8ff7b423153a69cf18ce9ae927d1b36cf7e286874" :answer/id #uuid "326b8b90-9f9b-5434-af6a-87598a59f30d" :answer/type :answer.type/math :answer/value "\\frac{21}{{x}^{8}}" :db/ensure [:answer/validate]} {:db/id "q-10735/selection/d5dc5b87df6c15725d99cb5381fa0a26621cb3b3ddc8ccefcd38c15b609f5dde" :answer/id #uuid "ae62b9fd-68a3-5e20-9ced-38c37543f946" :answer/type :answer.type/math :answer/value "-\\frac{21}{{x}^{8}}" :db/ensure [:answer/validate]} {:db/id "q-10735/selection" :answer-field/id #uuid "a2eabba0-4025-511f-8464-843dab99c26d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10735/selection/e0d4dfa2468ef26d91a338a8ff7b423153a69cf18ce9ae927d1b36cf7e286874" :answer-field/choices ["q-10735/selection/ba9db842b377a084bb4c4aae65133cb5d3ddc31e6d67f08278b697a1efe45781" "q-10735/selection/4ba642f2f9c1826b59f8c948e1b9fa2525c007fe4ef6f656d7591af2dd0f3513" "q-10735/selection/00e6b1625d7330b2130b3f7b88126171285c04a1cea0fffe124a66c70b0784b7" "q-10735/selection/e0d4dfa2468ef26d91a338a8ff7b423153a69cf18ce9ae927d1b36cf7e286874" "q-10735/selection/d5dc5b87df6c15725d99cb5381fa0a26621cb3b3ddc8ccefcd38c15b609f5dde"] :db/ensure [:answer-field/validate]} {:db/id "q-10735" :question/id #uuid "778ca374-f002-5bcc-9db6-f0d4476b5986" :question/math-academy-id "q-10735" :question/problem "If $y=-\\frac{3}{{x}^{7}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=-\\frac{3}{{x}^{7}}=-3{x}^{-7}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\text{d}}{\\text{d}x}(-3{x}^{-7}) \\\\  & =-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-7}) \\\\  & =-3\\cdot (-7){x}^{-7-1} \\\\  & =21{x}^{-8} \\\\  & =\\frac{21}{{x}^{8}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10735/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62"] :knowledge-point/questions ["q-10735"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-41579"] :question/problem "Simplify $\\frac{5+b}{3b}+\\frac{6-b}{3b}.$" :question/worked-solution "We have a common denominator of $3b,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{5+b}{3b}+\\frac{6-b}{3b} & = \\\\ \\frac{5+b+6-b}{3b} & = \\\\ \\frac{(5+6)+(b-b)}{3b} & = \\\\ \\frac{11}{3b}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-104040/selection/0951e2ada1b3eaf5fb6e9a359241860c75a6b2776d319bae9d021beb552371c2" :answer/id #uuid "3b3d0655-2605-5ced-82b9-6b1c4a94930d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/701e652c0db6997cae3fe82828cfe37a7dd4ddb07712fb0dd2b747f47b94a3d0.png" :db/ensure [:answer/validate]} {:db/id "q-104040/selection/9282100c44e40c0442d61a71fe3ce88a817fba4cabda3987f3