46e896587e3997465682bf02892ea7" "q-104040/selection/cf47cee512ea5f64a54b348aa2fa62269adda36f57255b1a4a939ab10ede10a3" "q-104040/selection/807c3d7e157de0976a151e65be42c70384d53fbfe63c64acc9858785e099a227"] :db/ensure [:answer-field/validate]} {:db/id "q-104040" :question/id #uuid "26714345-59e1-5173-b792-dc1a82d81e99" :question/math-academy-id "q-104040" :question/problem "Select the function that has a discontinuity at $x=-3.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a break exactly at $x=-3$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\nAll the other given graphs can be plotted without taking the pencil off of the paper." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104040/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7"] :knowledge-point/questions ["q-104040"] :db/ensure [:knowledge-point/validate]} {:db/id "q-262221/field-1/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" :answer/id #uuid "f6af8c94-9bc1-5889-9a8c-de0a46a865e0" :answer/type :answer.type/math :answer/value "2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-262221/field-1" :answer-field/id #uuid "3676e022-27c6-5903-8d25-f11f842f5262" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-262221/field-1/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" :answer-field/choices ["q-262221/field-1/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037"] :db/ensure [:answer-field/validate]} {:db/id "q-262221" :question/id #uuid "15259eb9-e584-5617-b029-3ef6354f46e2" :question/math-academy-id "q-262221" :question/problem "The distance between the points $A(3,1,2)$ and $B(5,-3,4)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A{{(3,1,2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(5,-3,4)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(5-3)^{2}+(-3-1)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+{2}^{2}} \\\\  & =\\sqrt{4+16+4} \\\\  & =\\sqrt{24} \\\\  & =2\\sqrt{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-262221/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7"] :knowledge-point/questions ["q-262221"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124410/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "2f111851-8eee-5065-b7ab-916fa003e91a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124410/selection/d6f27b7c7939a102723fed67409856455f84c69bf3e5c2599003ca6bf26244df" :answer/id #uuid "cc747dbe-0407-5d0a-82a3-da3f8e721368" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id "q-124410/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "4020eecd-7361-56e5-9f4e-d5bea4e9152d" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-124410/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "667ff609-a8e0-5d1d-a1c2-413c93c19b2c" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-124410/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f689fae0-046f-5964-834f-fbab504d1230" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-124410/selection" :answer-field/id #uuid "80641b3f-2dcc-5305-b6a8-37de7514ac53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124410/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-124410/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-124410/selection/d6f27b7c7939a102723fed67409856455f84c69bf3e5c2599003ca6bf26244df" "q-124410/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-124410/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-124410/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-124410" :question/id #uuid "df44a4f2-8e7b-5965-860a-aa02ef9d22dd" :question/math-academy-id "q-124410" :question/problem "$3!-0!=$" :question/worked-solution "The given expression is a subtraction of two factorials.\n\n- Computing $3!$ using the definition, we get\n\n$$\n3!=3\\cdot 2\\cdot 1=6.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}3!-0! & =6-1=5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124410/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d084334-b89a-5a33-9373-086018cdfbc3"] :knowledge-point/questions ["q-124410"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113253/selection/72a7633971ea893422f61798f9aba6adfe74c2c7327ab774b3df138c67277001" :answer/id #uuid "0f54602d-b2e5-5568-b875-11ddb4a5298a" :answer/type :answer.type/math :answer/value "x=-1\\pm 8\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-113253/selection/c854fce53eff848f894d5b57454bb03ecef3eb6c160280344bf17d4429955466" :answer/id #uuid "3755fa66-a91c-5660-95ca-d899725aa273" :answer/type :answer.type/math :answer/value "x=1\\pm 64\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-113253/selection/b591b9c2a0658f9b3577e44fc3c813562c3893541d69a0455ffe3f7628322bb8" :answer/id #uuid "91807a7b-5577-51b7-8ce5-db0475ab0616" :answer/type :answer.type/math :answer/value "x=8\\pm 16\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-113253/selection/3ef117d4c974691362cff665921a2bdd19ec461e0ec3177946c5681320d44c32" :answer/id #uuid "df06f99b-147c-5282-bd87-037367f5e317" :answer/type :answer.type/math :answer/value "x=8\\pm \\text{i}" :db/ensure [:answer/validate]} {:db/id "q-113253/selection/a379a350c3b247128fbdc5b012d14ffbd5641d8183c85c3657d31e162462529f" :answer/id #uuid "f4148326-16bb-596c-b7d2-7961bfd1c4d6" :answer/type :answer.type/math :answer/value "x=1\\pm 8\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-113253/selection" :answer-field/id #uuid "445f5743-6ad5-5ff8-861d-7e4659223e30" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113253/selection/a379a350c3b247128fbdc5b012d14ffbd5641d8183c85c3657d31e162462529f" :answer-field/choices ["q-113253/selection/72a7633971ea893422f61798f9aba6adfe74c2c7327ab774b3df138c67277001" "q-113253/selection/c854fce53eff848f894d5b57454bb03ecef3eb6c160280344bf17d4429955466" "q-113253/selection/b591b9c2a0658f9b3577e44fc3c813562c3893541d69a0455ffe3f7628322bb8" "q-113253/selection/3ef117d4c974691362cff665921a2bdd19ec461e0ec3177946c5681320d44c32" "q-113253/selection/a379a350c3b247128fbdc5b012d14ffbd5641d8183c85c3657d31e162462529f"] :db/ensure [:answer-field/validate]} {:db/id "q-113253" :question/id #uuid "84fcd074-662f-5f90-a82a-a4386fd75d95" :question/math-academy-id "q-113253" :question/problem "What are the solutions of the equation $(x-1)^{2}=-64?$" :question/worked-solution "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =-64 \\\\ x-1 & =\\pm \\sqrt{-64} \\\\ x-1 & =\\pm 8\\,\\text{i} \\\\ x & =1\\pm 8\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+8\\,\\text{i}$ and $x=1-8\\,\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113253/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141"] :knowledge-point/questions ["q-113253"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39135"] :question/problem "Given that $(x+3)$ is a factor of $f(x)=2{x}^{3}+8{x}^{2}+7x+3,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+3)$ is a factor of $f(x),$ so $(x+3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & 2 & 8 & 7 & 3 \\\\  &  & -6 & -6 & -3 \\\\  & 2 & 2 & 1 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{f(x)}{x+3}=2{x}^{2}+2x+1\n$$\n\nwhich means that\n\n$$\nf(x)=(x+3)(2{x}^{2}+2x+1).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $2{x}^{2}+2x+1=0$ is \n\n$$\nD=(2)^{2}-4(2)(1)=-4<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=-3.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =2(0)^{3}+8(0)^{2}+7(0)+3=3.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,3),$\n\n- passes through the $x$-axis at the single root $x=-3,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/f004d901b5738a46732f41c12f12c812432a2fa14af71469b5abff49e368607d.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-113848/selection/19abc9577a92691ea85fcbcc91200bbfbc0161738e1819f3f2aabad116df3bf2" :answer/id #uuid "e556c0f3-37ea-5971-9b0b-d264db36d7d4" :answer/type :answer.type/math :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-113848/selection/e2d81bbdd3022bf61c6d27c1284dfc9196b6f6fe351d12a5517f841e94bd79fa" :answer/id #uuid "3dc36b19-ff15-5d50-9511-e6c8a3296f86" :answer/type :answer.type/math :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/ensure [:answer/validate]} {:db/id "q-113848/selection/eac0fc647ab1e2431fd0c20f42894bf0b0281fa7c838836ae25e0f75fc017d79" :answer/id #uuid "56e78c2c-10d9-5bab-8e1b-fda29a511635" :answer/type :answer.type/math :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/ensure [:answer/validate]} {:db/id "q-113848/selection/7912bc5cc39133c8f963d412fe6745aa1eeb34d39da4fb6e36b7a600fd51b317" :answer/id #uuid "a1d7e7bf-98d4-5aff-b255-91863d5b5f7e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113848/selection/bcd2c02c326c0b397c967728a48d112e4019ae1732f5b6072ab890ea921962e2" :answer/id #uuid "fe127715-e44c-5723-a4a4-0f5c6e3ec150" :answer/type :answer.type/math :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113848/selection" :answer-field/id #uuid "ed0c53a3-4019-58e4-9a40-c36428ea9886" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113848/selection/e2d81bbdd3022bf61c6d27c1284dfc9196b6f6fe351d12a5517f841e94bd79fa" :answer-field/choices ["q-113848/selection/19abc9577a92691ea85fcbcc91200bbfbc0161738e1819f3f2aabad116df3bf2" "q-113848/selection/e2d81bbdd3022bf61c6d27c1284dfc9196b6f6fe351d12a5517f841e94bd79fa" "q-113848/selection/eac0fc647ab1e2431fd0c20f42894bf0b0281fa7c838836ae25e0f75fc017d79" "q-113848/selection/7912bc5cc39133c8f963d412fe6745aa1eeb34d39da4fb6e36b7a600fd51b317" "q-113848/selection/bcd2c02c326c0b397c967728a48d112e4019ae1732f5b6072ab890ea921962e2"] :db/ensure [:answer-field/validate]} {:db/id "q-113848" :question/id #uuid "de0205fc-51f4-5abe-9cd4-dc41ea4ca473" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{(-\\frac{1}{3})}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113848/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de"] :knowledge-point/questions ["q-113848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-148444/selection/5c044c9bffb6816e82ed06bc0cbf51e08dc451615558aa2f7e949fb6ed9b27bc" :answer/id #uuid "ad1d944f-7079-5621-b71b-8dae7c7b7e98" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{2}{\\sqrt{x}}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-148444/selection/8b0cab4521971ac4228be28c6a977320dc5baa2bbe890b7cf1b87206f6b28392" :answer/id #uuid "bd9c30c7-ffc9-577d-b271-e8743c0b6134" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}+1" :db/ensure [:answer/validate]} {:db/id "q-148444/selection/87659bd027fe412eb2b7c4c5f6fb415e51a1d7ba56828456ed794acca89d6eb2" :answer/id #uuid "8116fb68-2f6f-5fdd-b2c2-4e3bd521beef" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{\\sqrt{x}}-2" :db/ensure [:answer/validate]} {:db/id "q-148444/selection/8e15f9e7976a3e06343c25d5389a3d496db9c2bc2c7114648da7563619374ff4" :answer/id #uuid "a490c015-c11f-50e9-af4f-eeae6c6ee767" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-148444/selection/e45470bf24842c80096eec6d61937e899d6921ec86464d290cb429c7e4a2487f" :answer/id #uuid "d0a5d34e-c140-5220-82c7-577bf52de87d" :answer/type :answer.type/math :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-1" :db/ensure [:answer/validate]} {:db/id "q-148444/selection" :answer-field/id #uuid "db7c514e-4f1f-5758-b45b-4a45a7dffe70" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-148444/selection/8e15f9e7976a3e06343c25d5389a3d496db9c2bc2c7114648da7563619374ff4" :answer-field/choices ["q-148444/selection/5c044c9bffb6816e82ed06bc0cbf51e08dc451615558aa2f7e949fb6ed9b27bc" "q-148444/selection/8b0cab4521971ac4228be28c6a977320dc5baa2bbe890b7cf1b87206f6b28392" "q-148444/selection/87659bd027fe412eb2b7c4c5f6fb415e51a1d7ba56828456ed794acca89d6eb2" "q-148444/selection/8e15f9e7976a3e06343c25d5389a3d496db9c2bc2c7114648da7563619374ff4" "q-148444/selection/e45470bf24842c80096eec6d61937e899d6921ec86464d290cb429c7e4a2487f"] :db/ensure [:answer-field/validate]} {:db/id "q-148444" :question/id #uuid "f7c93dc9-ef3f-57a5-9461-a74860dab0b0" :question/math-academy-id "q-148444" :question/problem "The function $f(x)=\\frac{1}{(2x+1)^{2}}$ is defined for $x>-\\frac{1}{2}.$ Find ${f}^{-1}(x).$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{(2x+1)^{2}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{(2y+1)^{2}}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{(2y+1)^{2}} \\\\ (2y+1)^{2} & =\\frac{1}{x} \\\\ \\sqrt{(2y+1)^{2}} & =\\sqrt{\\frac{1}{x}} \\\\ |2y+1| & =\\frac{1}{\\sqrt{x}} \\\\ 2y+1 & =\\frac{1}{\\sqrt{x}} \\\\ 2y & =\\frac{1}{\\sqrt{x}}-1 \\\\ y & =\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}\\end{aligned}\n$$\n\nNote that we used the fact that for $y>-\\frac{1}{2},$ we have\n\n$$\n|2y+1|=2y+1.\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-148444/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "421b9396-2a7b-5c45-897a-9de5f52683de"] :knowledge-point/questions ["q-148444"] :db/ensure [:knowledge-point/validate]}]
