#{[{:db/id #edb/ref 17592186277661 :knowledge-point/_questions [{:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3d0655-2605-5ced-82b9-6b1c4a94930d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/701e652c0db6997cae3fe82828cfe37a7dd4ddb07712fb0dd2b747f47b94a3d0.png" :db/id #edb/ref 17592186277663} {:answer/id #uuid "7531a2d4-2ea7-5994-8aa7-7ea6bd35d471" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/deacb7f7b36ae12e236a3d5eae46def61ba2570a2cd8d7a4bb4527ce9d2cec7b.png" :db/id #edb/ref 17592186277664} {:answer/id #uuid "ccdb4c6f-4f60-534a-9181-df0c5e161fa7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/a3026fef480f96f0b1d1583c0136b3b7c82054bbce13b2480a14fa37cba608f6.png" :db/id #edb/ref 17592186277665} {:answer/id #uuid "b8b33720-8474-5f76-9f5e-a0e306fa7933" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/9eb01437ae94e15e061548f8be50dfd101d5350fb3550a131afe7ff5fd975c10.png" :db/id #edb/ref 17592186277666} {:answer/id #uuid "c38935c7-e9aa-5754-8a68-cbe8f76a0ca7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/e56e3c7e64c1bfa06b48a00225f3b7cf0551397ab96d160c88989ea24b70584b.png" :db/id #edb/ref 17592186277667}] :answer-field/correct {:answer/id #uuid "7531a2d4-2ea7-5994-8aa7-7ea6bd35d471" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/deacb7f7b36ae12e236a3d5eae46def61ba2570a2cd8d7a4bb4527ce9d2cec7b.png" :db/id #edb/ref 17592186277664} :answer-field/id #uuid "9bd3b028-ad15-58f6-ac93-8b4d97f1b096" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277662}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26714345-59e1-5173-b792-dc1a82d81e99" :question/math-academy-id "q-104040" :question/problem "Select the function that has a discontinuity at $x=-3.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a break exactly at $x=-3$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186277668 :knowledge-point/_questions [{:knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4420dc69-ff6f-5e56-b4be-9ab9823215d4" :answer/type {:db/ident :answer.type/math} :answer/value "21{x}^{7}" :db/id #edb/ref 17592186277670} {:answer/id #uuid "07fd0db0-b5f5-5a3d-9284-594cd72e2ba0" :answer/type {:db/ident :answer.type/math} :answer/value "18{x}^{5}" :db/id #edb/ref 17592186277671} {:answer/id #uuid "fdbc4307-6880-58c1-80a5-04acdd3cd7b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{{x}^{-8}}" :db/id #edb/ref 17592186277672} {:answer/id #uuid "ae62b9fd-68a3-5e20-9ced-38c37543f946" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{21}{{x}^{8}}" :db/id #edb/ref 17592186277673} {:answer/id #uuid "326b8b90-9f9b-5434-af6a-87598a59f30d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{{x}^{8}}" :db/id #edb/ref 17592186277674}] :answer-field/correct {:answer/id #uuid "326b8b90-9f9b-5434-af6a-87598a59f30d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{{x}^{8}}" :db/id #edb/ref 17592186277674} :answer-field/id #uuid "a2eabba0-4025-511f-8464-843dab99c26d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277669}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "778ca374-f002-5bcc-9db6-f0d4476b5986" :question/math-academy-id "q-10735" :question/problem "If $y=-\\frac{3}{{x}^{7}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=-\\frac{3}{{x}^{7}}=-3{x}^{-7}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\text{d}}{\\text{d}x}(-3{x}^{-7}) \\\\  & =-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-7}) \\\\  & =-3\\cdot (-7){x}^{-7-1} \\\\  & =21{x}^{-8} \\\\  & =\\frac{21}{{x}^{8}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277675 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df06f99b-147c-5282-bd87-037367f5e317" :answer/type {:db/ident :answer.type/math} :answer/value "x=8\\pm \\text{i}" :db/id #edb/ref 17592186277677} {:answer/id #uuid "0f54602d-b2e5-5568-b875-11ddb4a5298a" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186277678} {:answer/id #uuid "f4148326-16bb-596c-b7d2-7961bfd1c4d6" :answer/type {:db/ident :answer.type/math} :answer/value "x=1\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186277679} {:answer/id #uuid "91807a7b-5577-51b7-8ce5-db0475ab0616" :answer/type {:db/ident :answer.type/math} :answer/value "x=8\\pm 16\\,\\text{i}" :db/id #edb/ref 17592186277680} {:answer/id #uuid "3755fa66-a91c-5660-95ca-d899725aa273" :answer/type {:db/ident :answer.type/math} :answer/value "x=1\\pm 64\\,\\text{i}" :db/id #edb/ref 17592186277681}] :answer-field/correct {:answer/id #uuid "f4148326-16bb-596c-b7d2-7961bfd1c4d6" :answer/type {:db/ident :answer.type/math} :answer/value "x=1\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186277679} :answer-field/id #uuid "445f5743-6ad5-5ff8-861d-7e4659223e30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277676}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "84fcd074-662f-5f90-a82a-a4386fd75d95" :question/math-academy-id "q-113253" :question/problem "What are the solutions of the equation $(x-1)^{2}=-64?$" :question/worked-solution "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =-64 \\\\ x-1 & =\\pm \\sqrt{-64} \\\\ x-1 & =\\pm 8\\,\\text{i} \\\\ x & =1\\pm 8\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+8\\,\\text{i}$ and $x=1-8\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186277682 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e556c0f3-37ea-5971-9b0b-d264db36d7d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/id #edb/ref 17592186277684} {:answer/id #uuid "a1d7e7bf-98d4-5aff-b255-91863d5b5f7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/id #edb/ref 17592186277685} {:answer/id #uuid "fe127715-e44c-5723-a4a4-0f5c6e3ec150" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/id #edb/ref 17592186277686} {:answer/id #uuid "3dc36b19-ff15-5d50-9511-e6c8a3296f86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186277687} {:answer/id #uuid "56e78c2c-10d9-5bab-8e1b-fda29a511635" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/id #edb/ref 17592186277688}] :answer-field/correct {:answer/id #uuid "3dc36b19-ff15-5d50-9511-e6c8a3296f86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C" :db/id #edb/ref 17592186277687} :answer-field/id #uuid "ed0c53a3-4019-58e4-9a40-c36428ea9886" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277683}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de0205fc-51f4-5abe-9cd4-dc41ea4ca473" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{(-\\frac{1}{3})}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277689 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d084334-b89a-5a33-9373-086018cdfbc3" :knowledge-point/title "Evaluating the Factorial of Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "667ff609-a8e0-5d1d-a1c2-413c93c19b2c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277691} {:answer/id #uuid "f689fae0-046f-5964-834f-fbab504d1230" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277692} {:answer/id #uuid "2f111851-8eee-5065-b7ab-916fa003e91a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277693} {:answer/id #uuid "cc747dbe-0407-5d0a-82a3-da3f8e721368" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186277694} {:answer/id #uuid "4020eecd-7361-56e5-9f4e-d5bea4e9152d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277695}] :answer-field/correct {:answer/id #uuid "4020eecd-7361-56e5-9f4e-d5bea4e9152d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186277695} :answer-field/id #uuid "80641b3f-2dcc-5305-b6a8-37de7514ac53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277690}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "df44a4f2-8e7b-5965-860a-aa02ef9d22dd" :question/math-academy-id "q-124410" :question/problem "$3!-0!=$" :question/worked-solution "The given expression is a subtraction of two factorials.\n\n- Computing $3!$ using the definition, we get\n\n$$\n3!=3\\cdot 2\\cdot 1=6.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}3!-0! & =6-1=5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277696 :knowledge-point/_questions [{:knowledge-point/id #uuid "421b9396-2a7b-5c45-897a-9de5f52683de" :knowledge-point/title "Finding the Inverse of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad1d944f-7079-5621-b71b-8dae7c7b7e98" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{2}{\\sqrt{x}}-\\frac{1}{2}" :db/id #edb/ref 17592186277698} {:answer/id #uuid "8116fb68-2f6f-5fdd-b2c2-4e3bd521beef" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{1}{\\sqrt{x}}-2" :db/id #edb/ref 17592186277699} {:answer/id #uuid "bd9c30c7-ffc9-577d-b271-e8743c0b6134" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}+1" :db/id #edb/ref 17592186277700} {:answer/id #uuid "a490c015-c11f-50e9-af4f-eeae6c6ee767" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}" :db/id #edb/ref 17592186277701} {:answer/id #uuid "d0a5d34e-c140-5220-82c7-577bf52de87d" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-1" :db/id #edb/ref 17592186277702}] :answer-field/correct {:answer/id #uuid "a490c015-c11f-50e9-af4f-eeae6c6ee767" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}" :db/id #edb/ref 17592186277701} :answer-field/id #uuid "db7c514e-4f1f-5758-b45b-4a45a7dffe70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277697}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f7c93dc9-ef3f-57a5-9461-a74860dab0b0" :question/math-academy-id "q-148444" :question/problem "The function $f(x)=\\frac{1}{(2x+1)^{2}}$ is defined for $x>-\\frac{1}{2}.$ Find ${f}^{-1}(x).$" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{1}{(2x+1)^{2}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{1}{(2y+1)^{2}}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{1}{(2y+1)^{2}} \\\\ (2y+1)^{2} & =\\frac{1}{x} \\\\ \\sqrt{(2y+1)^{2}} & =\\sqrt{\\frac{1}{x}} \\\\ |2y+1| & =\\frac{1}{\\sqrt{x}} \\\\ 2y+1 & =\\frac{1}{\\sqrt{x}} \\\\ 2y & =\\frac{1}{\\sqrt{x}}-1 \\\\ y & =\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}\\end{aligned}\n$$\n\nNote that we used the fact that for $y>-\\frac{1}{2},$ we have\n\n$$\n|2y+1|=2y+1.\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{1}{2\\sqrt{x}}-\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186277703 :knowledge-point/_questions [{:knowledge-point/id #uuid "bba0ad98-6940-502a-873c-8a589a03a499" :knowledge-point/title "Finding Coterminal Angles in Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ebee52c-17d2-50f9-841e-821bb635f2f0" :answer/type {:db/ident :answer.type/math} :answer/value "-{505}^{∘}" :db/id #edb/ref 17592186277705} {:answer/id #uuid "a6874f49-c4b9-5a3c-91ee-f42730108937" :answer/type {:db/ident :answer.type/math} :answer/value "{180}^{∘}" :db/id #edb/ref 17592186277706} {:answer/id #uuid "e209b57b-63b3-559d-ba9c-1e542a26a85d" :answer/type {:db/ident :answer.type/math} :answer/value "{450}^{∘}" :db/id #edb/ref 17592186277707} {:answer/id #uuid "15926eda-7242-54ae-8ec2-ba359d102d7e" :answer/type {:db/ident :answer.type/math} :answer/value "{545}^{∘}" :db/id #edb/ref 17592186277708} {:answer/id #uuid "f50dc8aa-38d8-5671-93c1-9dd4eab56638" :answer/type {:db/ident :answer.type/math} :answer/value "-{800}^{∘}" :db/id #edb/ref 17592186277709}] :answer-field/correct {:answer/id #uuid "15926eda-7242-54ae-8ec2-ba359d102d7e" :answer/type {:db/ident :answer.type/math} :answer/value "{545}^{∘}" :db/id #edb/ref 17592186277708} :answer-field/id #uuid "55a56d46-281d-5ec8-90d5-ba68a8ee96d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277704}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5d8dcd0b-e0c8-5bbf-9e83-e01bcc550fb1" :question/math-academy-id "q-22978" :question/problem "Which angle is coterminal with $-{175}^{∘}?$" :question/worked-solution "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{175}^{∘}$:\n\n- $-{175}^{∘}+{360}^{∘}={185}^{∘}$\n\n- $-{175}^{∘}+2\\cdot {360}^{∘}={545}^{∘}\\,✓$\n\nThere are no answer choices larger than ${545}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{175}^{∘}$:\n\n- $-{175}^{∘}-{360}^{∘}=-{535}^{∘}$\n\n- $-{175}^{∘}-2\\cdot {360}^{∘}=-{895}^{∘}$\n\nThere are no answer choices smaller than $-{895}^{∘},$ so we can stop here.\n\nSo the correct answer is ${545}^{∘}.$"}] [{:db/id #edb/ref 17592186277710 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7" :knowledge-point/title "Calculating the Distance Between Two Points in Three Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6af8c94-9bc1-5889-9a8c-de0a46a865e0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186277712}] :answer-field/correct {:answer/id #uuid "f6af8c94-9bc1-5889-9a8c-de0a46a865e0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186277712} :answer-field/id #uuid "3676e022-27c6-5903-8d25-f11f842f5262" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186277711}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "15259eb9-e584-5617-b029-3ef6354f46e2" :question/math-academy-id "q-262221" :question/problem "The distance between the points $A(3,1,2)$ and $B(5,-3,4)$ is{{field-1}}." :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A{{(3,1,2)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(5,-3,4)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(5-3)^{2}+(-3-1)^{2}+(4-2)^{2}} \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+{2}^{2}} \\\\  & =\\sqrt{4+16+4} \\\\  & =\\sqrt{24} \\\\  & =2\\sqrt{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129652 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ef84d8b-a825-581a-aa43-2b18b42ab882" :knowledge-point/title "Graphing an Expanded Cubic Curve with a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e14758-05b5-548d-8468-52ff5a72bf98" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-4.png" :db/id #edb/ref 17592186127707} {:answer/id #uuid "1445a717-c9e5-51c6-8d79-fc8bc635de3e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-3.png" :db/id #edb/ref 17592186127708} {:answer/id #uuid "175a2cbf-e021-5b62-afc9-eb3f8635d964" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-5.png" :db/id #edb/ref 17592186127709} {:answer/id #uuid "463a664f-3231-56a3-bfb6-d53f2a562327" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-2.png" :db/id #edb/ref 17592186127710} {:answer/id #uuid "50d668ed-bc11-5bd5-a2b8-0a66307789e0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-1.png" :db/id #edb/ref 17592186127711}] :answer-field/correct {:answer/id #uuid "50d668ed-bc11-5bd5-a2b8-0a66307789e0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2084/Source/Images/q-39135-a-1.png" :db/id #edb/ref 17592186127711} :answer-field/id #uuid "bee5c42d-5ef8-5bc9-a0f5-f6ea65425b6d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127706}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7f032169-ef22-5e6b-92e9-31b38bfaf554" :question/math-academy-id "q-39135" :question/problem "Given that $(x+3)$ is a factor of $f(x)=2{x}^{3}+8{x}^{2}+7x+3,$ which of the following curves is generated by $y=f(x)?$\n\n(*Note: Figures not drawn to scale*)" :question/worked-solution "First, we need to factor the polynomial. We are told that $(x+3)$ is a factor of $f(x),$ so $(x+3)$ divides $f(x)$ with zero remainder. To begin factoring $f(x),$ we can divide it by $(x+3)$ using synthetic division:\n\n$$\n\\begin{aligned} & {x}^{3} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & 2 & 8 & 7 & 3 \\\\  &  & -6 & -6 & -3 \\\\  & 2 & 2 & 1 & 0\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{f(x)}{x+3}=2{x}^{2}+2x+1\n$$\n\nwhich means that\n\n$$\nf(x)=(x+3)(2{x}^{2}+2x+1).\n$$\n\nThe equation is now fully factored. Note that the discriminant of $2{x}^{2}+2x+1=0$ is \n\n$$\nD=(2)^{2}-4(2)(1)=-4<0,\n$$\n\nwhich implies that the quadratic factor has no real roots. So by the zero-product rule, we deduce that $f(x)$ has a single root at $x=-3.$ \n\nWe also find the $y$-intercept of the curve by substituting the value $x=0$ into the equation:\n\n$$\n\\begin{aligned}y & =2(0)^{3}+8(0)^{2}+7(0)+3=3.\\end{aligned}\n$$\n\nSo, the curve:\n\n- has a $y$-intercept at $(0,3),$\n\n- passes through the $x$-axis at the single root $x=-3,$ and\n\n- has no more $x$-intercepts.\n\nBecause the leading coefficient is positive, the graph takes an inverted $\\text{S}$-shape. Therefore, the graph looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/f004d901b5738a46732f41c12f12c812432a2fa14af71469b5abff49e368607d.png)"}] [{:db/id #edb/ref 17592186069252 :knowledge-point/_questions [{:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa" :knowledge-point/title "Adding Rational Expressions With a Common Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed3b2c6-4148-596a-bf16-4e9ddca23009" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2b + 1}{3b}" :db/id #edb/ref 17592186067044} {:answer/id #uuid "af29b81e-1f0b-5fdf-9d87-0c4acd6518f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11 + 2b}{3b}" :db/id #edb/ref 17592186067045} {:answer/id #uuid "18443e3e-fcd0-5419-b136-1d2cfc50fb73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11 - 2b}{3b}" :db/id #edb/ref 17592186067046} {:answer/id #uuid "380e1019-5c00-5212-9db3-c545f83cc6ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2b - 1}{3b}" :db/id #edb/ref 17592186067047} {:answer/id #uuid "3813ba5a-6e00-58e2-942c-4fee9f482508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3b}" :db/id #edb/ref 17592186067048}] :answer-field/correct {:answer/id #uuid "3813ba5a-6e00-58e2-942c-4fee9f482508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3b}" :db/id #edb/ref 17592186067048} :answer-field/id #uuid "86597dfe-9948-50f9-8078-a41a7d3a737b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067043}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f24c09b5-350f-5383-a4ad-ef306d26e28f" :question/math-academy-id "q-41579" :question/problem "Simplify $\\frac{5+b}{3b}+\\frac{6-b}{3b}.$" :question/worked-solution "We have a common denominator of $3b,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{5+b}{3b}+\\frac{6-b}{3b} & = \\\\ \\frac{5+b+6-b}{3b} & = \\\\ \\frac{(5+6)+(b-b)}{3b} & = \\\\ \\frac{11}{3b}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277713 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecd367ac-2a68-56d0-b553-85277a9c921d" :knowledge-point/title "Finding the Secant or Cosecant of a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3be755e5-9744-50da-b6c2-6d219cf385ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186277715} {:answer/id #uuid "c811d858-4ca9-52b8-83cd-b5dffb4f26d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186277716} {:answer/id #uuid "903e6612-7286-5806-b2ff-fd846bc7285b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186277717} {:answer/id #uuid "45b400ff-dcba-57ea-a17c-d7b3baa20039" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186277718} {:answer/id #uuid "2259148e-5fed-52b7-a28b-8b4e2340b452" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186277719}] :answer-field/correct {:answer/id #uuid "45b400ff-dcba-57ea-a17c-d7b3baa20039" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186277718} :answer-field/id #uuid "c1da4c49-433f-500b-803b-5f3a1a342c9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277714}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3252a42d-5a90-5eb8-a245-7d72a6cbf420" :question/math-academy-id "q-86322" :question/problem "$\\operatorname{sec}⁡{135}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13975009/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${135}^{∘}$ corresponds to the point $(-\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡{135}^{∘}=-\\frac{\\sqrt{2}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡{135}^{∘}=\\frac{1}{\\operatorname{cos}⁡{135}^{∘}}=-\\sqrt{2}.\n$$"}]}
