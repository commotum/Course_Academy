5bd188be3e2f1baea7dc6d189ccd4" "q-19194/selection/4562aeee808cb8cf0e7d3783a8b7bbcc21c4e9a75c667fb73a3777a59d8896b9" "q-19194/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea63e9ad021b9d6c3fce938f23f4"] :db/ensure [:answer-field/validate]} {:db/id "q-19194" :question/id #uuid "16afdc3e-3de7-5f89-a577-96cb66b16553" :question/math-academy-id "q-19194" :question/problem "Let $a=⟨-2,-1,-4⟩$ and $b=⟨6,-5,3⟩.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{(-2)\\cdot 6+(-1)\\cdot (-5)+(-4)\\cdot 3}{{6}^{2}+(-5)^{2}+{3}^{2}}b \\\\  & =-\\frac{19}{70}⟨6,-5,3⟩ \\\\  & =⟨-\\frac{57}{35},\\frac{19}{14},-\\frac{57}{70}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-19194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275235/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "820db87f-2659-51f7-828b-46a83f5bec34" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-275235/field-1" :answer-field/id #uuid "b0dfc3fb-73ec-54eb-8092-aff33d72e5c5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275235/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-275235/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-275235/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "247064a8-06cc-52b3-8c5a-4d8ca8915dad" :answer/type :answer.