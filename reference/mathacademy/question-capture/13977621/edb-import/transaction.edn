n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{0\\cdot \\sqrt{2}+(-3)\\cdot 1+1\\cdot 0}{(\\sqrt{2})^{2}+{1}^{2}+{0}^{2}}b \\\\  & =\\frac{-3}{3}⟨\\sqrt{2},1,0⟩ \\\\  & =⟨-\\sqrt{2},-1,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-18377/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-18377"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126507/selection/1fbbd8db31a9037ffcd03280fdf251bc13e3487a4c5034bef1f0c6fb48403406" :answer/id #uuid "7ac89813-eaca-5387-a2b6-0d02fd8454ba" :answer/type :answer.type/math :answer/value "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩" :db/ensure [:answer/validate]} {:db/id "q-126507/selection/229194fc7dc19514d20d9ad5dc0e2ddb7186ea63e9ad021b9d6c3fce938f23f4" :answer/id #uuid "0e59a8e3-387e-5f83-bec5-0d38f4ae21f8" :answer/type :answer.type/math :answer/value "⟨0,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-126507/selection/9687e5aa5e86122b95d69f8defc375d906dfc6d06f2c79685c9f16951da09085" :answer/id #uuid "9bde2a5f-5a7c-55ac-8713-2718f5108164" :answer/type :answer.type/math :answer/value "⟨2,1,\\sqrt{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-126507/selection/7a8b63b8adde46162fd46073fb9186eee56fb5a5c66a36637ba2e7bcde8c8488" :answer/id #uuid "4ef1b113-fe6c-519b-8127-c191b645f492" :answer/type :answer.type/math :answer/value "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩" :db/ensure [:answer/validate]} {:db/id "q-126507/selection/82c9af51f6780ca7e97a0125112d12170934de915531a0bfa2747b9be3ecb6e4" :answer/id #uuid "4aed13cc-9ab2-52d0-8d21-3832ca7e15de" :answer/type :answer.type/math :answer/value "⟨6,3,3\\sqrt{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-126507/selection" :answer-field/id #uuid "e2aef5f8-4e90-57ed-878d-b61826033a23" :answer-field/key "s