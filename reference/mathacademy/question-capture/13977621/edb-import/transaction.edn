5235/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-275235"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317924/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f560ffaa-3949-53fe-847f-ae73129b4267" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317924/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "82a70726-08cf-54f3-82ae-93b3c5321b0f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-317924/field-1" :answer-field/id #uuid "4ad32d67-6aa1-57f8-aa69-21ef2b0f0245" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317924/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317924/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-317924/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-317924/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "25dc21fb-21d2-5000-9cdd-a04443408ce8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317924/field-2" :answer-field/id #uuid "48d4ad65-36d5-5cd5-a889-74de85618f2f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317924/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317924/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317924/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5ea563aa-b2ad-5c02-b280-00bcc3d1ebe5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317924/field-3" :answer-field/id #uuid "92d93412-b3d5-5edf-8064-584c952a5609" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317924/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317924/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317924" :question/id #uuid "d76899f3-011a-5326-9aaa-6e8e8b6af9c0" :question/math-academy-id "q-317924" :question/problem "Let $u=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]$ and $v=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $u$ onto $v.$\n\n${\\text{proj}}_{v}\\,u=⟨$\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,u & =\\frac{u\\cdot v}{v\\cdot v}v \\\\  & =\\frac{{u}_{x}{v}_{x}+{u}_{y}{v}_{y}+{u}_{z}{v}_{z}}{{v}_{x}^{2}+{v}_{y}^{2}+{v}_{z}^{2}}v \\\\  & =\\frac{(1)\\cdot 2+(-2)\\cdot 1+(1)\\cdot 0}{{2}^{2}+{1}^{2}+{0}^{2}}v \\\\  & =\\frac{0}{5}v \\\\  & =⟨\\,0,0,0\\,⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317924/field-1" "q-317924/field-2" "q-317924/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-317924"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316761/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "69eee15f-675e-5451-9bf0-87f26f881a43" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-316761/field-1" :answer-field/id #uuid "6889c208-b26b-546c-9fe1-cb0a3c998435" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316761/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-316761/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-316761" :question/id #uuid "6fd1a3fd-cf3d-56c3-88b8-eb3ea7bb8999" :question/math-academy-id "q-316761" :question/problem "Let $r=⟨-5,1,3⟩$ and $s=⟨n,-2,4⟩.$ Given that the projection of $r$ onto $s$ is the zero vector, find the value of $n.$\n\n$n=$\n{{field-1}}" :question/worked-solution "Since $r$ is a nonzero vector, its projection onto another nonzero vector $s$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nr⊥s\\,⟹\\,r\\cdot s=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}r\\cdot s & ={r}_{x}\\cdot {s}_{x}+{r}_{y}\\cdot {s}_{y}+{r}_{z}\\cdot {s}_{z} \\\\  & =(-5)\\cdot n+1\\cdot (-2)+3\\cdot 4 \\\\  & =-5n-2+12 \\\\  & =10-5n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}r\\cdot s & =0 \\\\ 10-5n & =0 \\\\ n & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316761/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-316761"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275237/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "3d6cefe9-ad1a-5c96-89ee-13765cab6bdc" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-275237/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b2f9ca16-7042-569a-baeb-d1ce8d29aa01" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-275237/field-1" :answer-field/id #uuid "8e7fdc11-8a2f-532b-9337-bd8dcc7ccf8f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275237/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-275237/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-275237/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-275237" :question/id #uuid "ba2dc2b6-282e-5a04-8a40-e8efff6fe0f3" :question/math-academy-id "q-275237" :question/problem "Let $a=[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 3 \\\\ 1\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-2\\cdot x+1\\cdot 3+2\\cdot 1 \\\\  & =-2x+5.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -2x+5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275237/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-275237"] :db/ensure [:knowledge-point/validate]} {:db/id "q-212458/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "b24546f6-e090-5171-a69e-f59055facd6e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-212458/selection/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" :answer/id #uuid "89beb507-2355-56db-ad70-2ff06beda27d" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "q-212458/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b" :answer/id #uuid "79391234-73d9-5ee0-92b9-8f5990d9c344" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-212458/selection/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" :answer/id #uuid "1d7418e3-574b-55d3-8644-e430728584e7" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-212458/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "8723e7a4-352c-5419-b117-c1cf379034f4" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-212458/selection" :answer-field/id #uuid "3d982e5d-4c5a-5a80-8ae6-7e8e38a04701" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-212458/selection/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" :answer-field/choices ["q-212458/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-212458/selection/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" "q-212458/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b" "q-212458/selection/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" "q-212458/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-212458" :question/id #uuid "5b48b4f7-6f79-595f-aadb-f1b18c1eb86c" :question/math-academy-id "q-212458" :question/problem "Let $a=⟨-5,-3,1⟩$ and $b=⟨x,-2,-3⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =-5\\cdot x+(-3)\\cdot (-2)+1\\cdot (-3) \\\\  & =3-5x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3-5x & =0 \\\\ -5x & =-3 \\\\ x & =\\frac{3}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-212458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf"] :knowledge-point/questions ["q-212458"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-14617"] :question/problem "Suppose that $|\\,\\mathbf{a}\\,|=8,|\\,\\mathbf{b}\\,|=4$ and that the angle between the vectors is $\\theta = \\dfrac{5\\pi}{6}.$ Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$ in terms of the vector $\\mathbf{b}.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $\\mathbf{b}\\mathbin{:}$\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{b}}{|\\,\\mathbf{b}\\,|} = \\dfrac{\\mathbf{b}}{4} = \\dfrac{1}{4} \\mathbf{b}\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =-4\\sqrt{3}\\cdot \\frac{1}{4}b \\\\  & =-\\sqrt{3}b\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14618"] :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 5+(-3)\\cdot (-4)+5\\cdot 0}{{5}^{2}+(-4)^{2}+{0}^{2}}b \\\\  & =\\frac{17}{41}⟨5,-4,0⟩ \\\\  & =⟨\\frac{85}{41},-\\frac{68}{41},0⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14619"] :question/problem "Let $[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 5 \\\\ -1\\end{aligned}]$. Find the vector projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{1\\cdot 1+0\\cdot 5+1\\cdot (-1)}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =\\frac{0}{{1}^{2}+{5}^{2}+(-1)^{2}}b \\\\  & =⟨0,0,0⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
