field-3}}\n\n$⟩$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{(-2)\\cdot (-1)+8\\cdot 3+(-1)\\cdot (-2)}{(-1)^{2}+{3}^{2}+(-2)^{2}}d \\\\  & =\\frac{28}{14}⟨-1,3,-2⟩ \\\\  & =2⟨-1,3,-2⟩ \\\\  & =⟨-2,6,-4⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275231/field-1" "q-275231/field-2" "q-275231/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f"] :knowledge-point/questions ["q-275231"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275230/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "7541c8ad-38ab-5c2f-ac90-24aa4e64367b" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-275230/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e15fe54c-65a3-5c95-bde0-75492747c438" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-275230/field-1" :answer-field/id #uuid "12f32dd3-ed56-5374-8c14-6d495b8663ea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275230/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer-field/choices ["q-275230/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" "q-275230/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-275230/field-2/cd5e079fde19978562b84c87e245556b9d0b95f0bc7938117e3671aa3b7c0e08" :answer/id #uuid "619599e1-e9bd-5cbd-bc65-bf0146fc09c0" :answer/type :answer.type/math :answer/value "-\\frac{7}{6}" :db/ensure [:answer/validate]} {:db/id "q-275230/fie