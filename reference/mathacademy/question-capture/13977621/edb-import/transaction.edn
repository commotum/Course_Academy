sqrt{2})\\cdot \\frac{1}{6}b \\\\  & =-3\\sqrt{2}b\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19220/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b"] :knowledge-point/questions ["q-19220"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316441/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d20b519a-bd74-56f6-ab0d-28c760680985" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-316441/field-1" :answer-field/id #uuid "bcc5df4b-5be8-53c5-ae41-8c913d42951b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316441/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-316441/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-316441" :question/id #uuid "b32d4bc6-b577-5cf1-a1b8-28f5d0c75f21" :question/math-academy-id "q-316441" :question/problem "Suppose that $|\\,a\\,|=4$, $|\\,b\\,|=8\\sqrt{2}$ and that the angle between the vectors is $\\theta =\\frac{\\pi }{4}.$ Find the vector projection of $b$ onto $a$ in terms of the vector $a.$\n\n${\\text{proj}}_{a}\\,b=$\n{{field-1}}\n$a$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =|\\,b\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =8\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $a:$\n\n$$\nu=\\frac{a}{|\\,a\\,|}=\\frac{a}{4}=\\frac{1}{4}a\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & ={\\text{comp}}_{a}\\,b\\cdot u \\\\  & =8\\cdot \\frac{1}{4}a \\\\  & =2\\,a\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316441/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b"] :knowledge-point/questions ["q-316441"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275228/field-1/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" :answer/id #uuid "2dcc5c85-5907-532e-9db5-89520567f8fd" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-275228/field-1/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "e26dee69-5eff-5f6d-872c-2baab6a6ddf2" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-275228/field-1" :answer-field/id #uuid "9ea6baab-a0e4-5a9c-b45f-3c6cc5a86359" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275228/field-1/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" :answer-field/choices ["q-275228/field-1/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" "q-275228/field-1/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-275228" :question/id #uuid "637cb119-eb86-568a-a2d9-f23e98e4459a" :question/math-academy-id "q-275228" :question/problem "Suppose that $|\\,p\\,|=6$, $|\\,q\\,|=12$ and that the angle between the vectors is $\\theta ={150}^{∘}.$ Find the vector projection of $q$ onto $p$ in terms of the vector $p.$\n\n${\\text{proj}}_{p}\\,q=$\n{{field-1}}\n$p$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =|\\,q\\,|\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡({150}^{∘}) \\\\  & =12\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $p:$\n\n$$\nu=\\frac{p}{|\\,p\\,|}=\\frac{p}{6}=\\frac{1}{6}p\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & ={\\text{comp}}_{p}\\,q\\cdot u \\\\  & =-6\\sqrt{3}\\cdot \\frac{1}{6}p \\\\  & =-\\sqrt{3}\\,p\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275228/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b"] :knowledge-point/questions ["q-275228"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71838/selection/3ff50ddaa5a12beaca183bea576d6a28b6c90a679e8c680a26cce7bfe9705d9d" :answer/id #uuid "ece23503-bd50-5b21-94c0-5a21dd3f5a7e" :answer/type :answer.type/math :answer/value "\\frac{2}{5}d" :db/ensure [:answer/validate]} {:db/id "q-71838/selection/578f0799de773b11f4f5e78b0f8c35d0fb139f75677da9d21f1c608c8b28f85f" :answer/id #uuid "01bacc67-0858-554d-a2ad-adfed5f8dc32" :answer/type :answer.type/math :answer/value "\\frac{5}{2}d" :db/ensure [:answer/validate]} {:db/id "q-71838/selection/49703d01debfd0bcd56c6fe75f3a0b8eb368281e319491d4a1862e6199ff8ae5" :answer/id #uuid "b2f3bbbd-559f-5e27-9190-64dc733578f7" :answer/type :answer.type/math :answer/value "5d" :db/ensure [:answer/validate]} {:db/id "q-71838/selection/e81c9e2d59632f164a18b050e097c163df3fbc8e45d65439fa0a5c372d22be38" :answer/id #uuid "f6da54aa-6722-520c-8d57-601765094e27" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{3}}{5}d" :db/ensure [:answer/validate]} {:db/id "q-71838/selection/ee9b7a0a23e77664b5c9f5b12655965cef1d5b19ea7e295c0b9f94e422aeced5" :answer/id #uuid "1d7ffe4d-4b39-59ef-b4ff-61a6dce957f7" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{3}}{3}d" :db/ensure [:answer/validate]} {:db/id "q-71838/selection" :answer-field/id #uuid "5c9ee979-e0da-5150-9eaf-e21e2bc6decb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71838/selection/578f0799de773b11f4f5e78b0f8c35d0fb139f75677da9d21f1c608c8b28f85f" :answer-field/choices ["q-71838/selection/3ff50ddaa5a12beaca183bea576d6a28b6c90a679e8c680a26cce7bfe9705d9d" "q-71838/selection/578f0799de773b11f4f5e78b0f8c35d0fb139f75677da9d21f1c608c8b28f85f" "q-71838/selection/49703d01debfd0bcd56c6fe75f3a0b8eb368281e319491d4a1862e6199ff8ae5" "q-71838/selection/e81c9e2d59632f164a18b050e097c163df3fbc8e45d65439fa0a5c372d22be38" "q-71838/selection/ee9b7a0a23e77664b5c9f5b12655965cef1d5b19ea7e295c0b9f94e422aeced5"] :db/ensure [:answer-field/validate]} {:db/id "q-71838" :question/id #uuid "7ba84402-0df7-51f8-9c09-70d13a0fe926" :question/math-academy-id "q-71838" :question/problem "Suppose that $|\\,c\\,|=10$, $|\\,d\\,|=2\\sqrt{3}$ and that the angle between the vectors is $\\theta ={30}^{∘}.$ Find the vector projection of $c$ onto $d$ in terms of the vector $d.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡({30}^{∘}) \\\\  & =10\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =5\\sqrt{3}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $d:$\n\n$$\nu=\\frac{d}{|\\,d\\,|}=\\frac{d}{2\\sqrt{3}}=\\frac{1}{2\\sqrt{3}}d\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & ={\\text{comp}}_{d}\\,c\\cdot u \\\\  & =5\\sqrt{3}\\cdot \\frac{1}{2\\sqrt{3}}d \\\\  & =\\frac{5}{2}d\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71838/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b"] :knowledge-point/questions ["q-71838"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18377/selection/e19b141b33fa320bdfb20a79b649af81f95675390be42a9e2d96ce1d117e2e72" :answer/id #uuid "bc3df04f-5c06-5456-a867-4e13c336b9aa" :answer/type :answer.type/math :answer/value "⟨-\\sqrt{2},1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-18377/selection/229194fc7dc19