256" "d0735f36e4489cf129b060df9782f01d73b0c72b260928e8aab3f7e9ff655550"} {"question" "q-126507" "field" nil "attribute" "question/worked-solution" "value" "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{6\\cdot 3+3\\cdot 1+3\\sqrt{2}\\cdot 0}{{6}^{2}+{3}^{2}+(3\\sqrt{2})^{2}}a \\\\  & =\\frac{21}{63}⟨6,3,3\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨6,3,3\\sqrt{2}⟩ \\\\  & =⟨2,1,\\sqrt{2}⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/state.json" "file_sha256" "d0735f36e4489cf129b060df9782f01d73b0c72b260928e8aab3f7e9ff655550"} {"question" "q-126507" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/activity-metadata.json" "file_sha256" "7459781824c6f21b40d26082ff3711104219233040a184de8850470e27f22fdf"} {"question" "q-126507" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/state.json" "file_sha256" "d0735f36e4489cf129b060df9782f01d73b0c72b260928e8aab3f7e9ff655550"} {"question" "q-126507" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨0,0,0⟩"] ["math" "⟨2,1,\\sqrt{2}⟩"] ["math" "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩"] ["math" "⟨6,3,3\\sqrt{2}⟩"] ["math" "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13977621/state.json" "file_sha256" "d0735f36e4489cf129b060df9782f01d73b0c72b260928e8aab3f7e9ff655550"} {"question" "q-126507" "field" "selection" "attribute" "answer-f