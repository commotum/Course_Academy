/selection/625f40a59af0f5938119dbedf38d07692ba9d02d04e5cf360117ecca1c5ee729"] :db/ensure [:answer-field/validate]} {:db/id "q-115308" :question/id #uuid "ac71fe37-e4e6-5f04-833b-dc05c051078d" :question/math-academy-id "q-115308" :question/problem "What is the center of the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-2$ and $k=3,$ so the center is located at $(-2,3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115308/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7"] :knowledge-point/questions ["q-115308"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278312/field-1/ec6f4a6380cd56250fb040c51c79a724a33fe02f06ba462d040f78b3da50ee97" :answer/id #uuid "0c833d29-7783-5eba-b328-e441a01cc990" :answer/type :answer.type/math :answer/value "\\frac{(x-5)^2}{4}+\\frac{(y-2)^2}{25}" :db/ensure [:answer/validate]} {:db/id "q-278312/field-1" :answer-field/id #uuid "ba6f87da-c319-57a2-ad8a-fe94131112fe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278312/field-1/ec6f4a6380cd56250fb040c51c79a724a33fe02f06ba462d040f78b3da50ee97" :answer-field/choices ["q-278312/field-1/ec6f4a6380cd56250fb040c51c79a724a33fe02f06ba462d040f78b3da50ee97"] :db/ensure [:answer-field/validate]} {:db/id "q-278312" :question/id #uuid "5cc9c897-95e9-5696-af7c-76e6d5890aee" :question/math-academy-id "q-278312" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13971771/assets/0405790e07a49ddb62c4444ba13669ee74e6b7c37d5c2949a244246b8d54b65a.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(5,2),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{4}+\\frac{(y-2)^{2}}{25} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278312/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656"] :knowledge-point/questions ["q-278312"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278315/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "974f5b03-9df1-518b-9c5a-8e52dfee3dd2" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-278315/field-1" :answer-field/id #uuid "a68bbe66-e00b-5bb0-9eba-dce80863ac01" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278315/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-278315/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-278315/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "df966b9d-68ea-5c02-abea-2b0593f66e40" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-278315/field-2" :answer-field/id #uuid "2db8a76d-2f1b-5129-9aae-75f1b9bb1bd6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278315/field-2/9