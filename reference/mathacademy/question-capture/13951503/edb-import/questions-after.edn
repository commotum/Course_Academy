sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265076 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47107a0d-a5b8-5f71-969a-6a5c5867ee22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265078}] :answer-field/correct {:answer/id #uuid "47107a0d-a5b8-5f71-969a-6a5c5867ee22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265078} :answer-field/id #uuid "502af5de-34e1-5719-a0cd-91d272d0c742" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265077} {:answer-field/choices [{:answer/id #uuid "c557764c-783e-576b-a73c-561ba627c160" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265080}] :answer-field/correct {:answer/id #uuid "c557764c-783e-576b-a73c-561ba627c160" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265080} :answer-field/id #uuid "9dee45c7-3366-566c-9daf-5574fc8bc4dc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265079}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7826dacd-8a5b-5b27-a57f-5e8f9b59d466" :question/math-academy-id "q-332521" :question/problem "Express $\\operatorname{cos}⁡(x+\\frac{4\\pi }{3})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+\\frac{4\\pi }{3})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,-$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{4\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{4\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{4\\pi }{3})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x-\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}]}
