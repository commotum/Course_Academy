#{[{:db/id #edb/ref 17592186265051 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "323512fe-6627-5095-9392-9745ab26448f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186265053} {:answer/id #uuid "95f027f3-3616-5248-b931-bde4c71d08fd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265054} {:answer/id #uuid "3168da19-061c-5e68-9983-24ce3bc71245" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186265055} {:answer/id #uuid "ed3f1a66-f7d6-51ad-8cd1-cbff55dd24d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186265056} {:answer/id #uuid "d196dc14-cb73-57ba-bfee-4fcbaebcfe18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186265057}] :answer-field/correct {:answer/id #uuid "95f027f3-3616-5248-b931-bde4c71d08fd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186265054} :answer-field/id #uuid "ead2199f-661e-5f4f-9324-fad556aa4e89" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265052}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ba1cda9c-4f8c-55f0-aedc-2eddcc0213a7" :question/math-academy-id "q-141375" :question/problem "$\\operatorname{cos}⁡(x-{180}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={180}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{180}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{180}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{180}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-1)+\\operatorname{sin}⁡x\\cdot 0 \\\\  & =-\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265058 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "415b42ea-0088-559f-afa3-e256c6154572" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186265060} {:answer/id #uuid "5cadc4d4-142b-578e-8dc6-045167b59494" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186265061} {:answer/id #uuid "d63091e5-1f95-58fb-8f05-c6934fa5a090" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186265062} {:answer/id #uuid "ca21cb54-9f1d-50f9-8543-d554fa937ad7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186265063} {:answer/id #uuid "65112d40-9f10-5605-a531-30416f4d5e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186265064}] :answer-field/correct {:answer/id #uuid "415b42ea-0088-559f-afa3-e256c6154572" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186265060} :answer-field/id #uuid "f0dc60c5-d940-5212-8ccc-3810db6895f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265059}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "232e6411-ac60-53fb-a6dd-eac85597e332" :question/math-academy-id "q-142142" :question/problem "$\\operatorname{cos}⁡(x-{210}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{210}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{210}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265065 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5e1efa-ff51-56cb-837a-c4d3b889a015" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265067}] :answer-field/correct {:answer/id #uuid "0c5e1efa-ff51-56cb-837a-c4d3b889a015" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186265067} :answer-field/id #uuid "c52e9aba-9d95-5400-b6a5-59d352eaa866" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265066} {:answer-field/choices [{:answer/id #uuid "9ccaa835-20e2-54ee-9424-9434ab7c95f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265069}] :answer-field/correct {:answer/id #uuid "9ccaa835-20e2-54ee-9424-9434ab7c95f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265069} :answer-field/id #uuid "a6771cb9-7d56-5d52-a5b9-3b5bc8ff75ef" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265068}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "431a59af-798d-5f13-b9e1-c4c58d8d7c69" :question/math-academy-id "q-274500" :question/problem "Express $\\operatorname{cos}⁡(x+\\frac{5\\pi }{3})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+\\frac{5\\pi }{3})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{5\\pi }{3}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{5\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{5\\pi }{3})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{5\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot (\\frac{1}{2})-\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265070 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9eb62b-7e67-5309-a024-93c8ab705e6a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186265072} {:answer/id #uuid "f895e217-87aa-5050-8766-c789562b563a" :answer/type {:db/ident