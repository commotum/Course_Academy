              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x>-2,\\,y=0\\}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne -2\\}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "The domain is the entire $xy-$plane",
              "option": "3",
              "source_option": "d"
            },
            {
