\\\\  & ≈3.785.\\end{aligned}\n$$\n\nFinally, substituting $r=5$ and $\\theta =3.785$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=5\\,{\\text{e}}^{3.785\\,\\text{i}}\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17519/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff"] :knowledge-point/questions ["q-17519"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17524/selection/9b5e5794757efa300c579917d4c6bee9d752f67f606ebdcc96a05d1d4a90b5a7" :answer/id #uuid "42cfe6cd-8c70-5046-b98e-d974d4d8aea6" :answer/type :answer.type/math :answer/value "z=2\\sqrt{10}\\,{\\text{e}}^{1.983\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-17524/selection/1510ad99d4ec2fc08e37ad84e9a2bfc9d34f80db9a729f6f0279eba413cbcb2f" :answer/id #uuid "9284b0a5-6797-5f77-b7a1-d4c0b8fe315e" :answer/type :answer.type/math :answer/value "z=2\\sqrt{10}\\,{\\text{e}}^{1.389\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-17524/selection/5b1c57b2fe1d2c7a23137a4888d43983b4ae855a32aee50ca906745651c8ec1f" :answer/id #uuid "76927f0f-078b-5d44-88fa-aa29a676241c" :answer/type :answer.type/math :answer/value "z=2\\sqrt{10}\\,{\\text{e}}^{1.893\\,\\text{i}}" :db/ensure [:answer/validate]} {:db/id "q-17524/selection/68d4df31bc64a550f7bada6a6bd95bbf6ff7d4d37cf949c22c5ff182d4f103ba" :answer/id #uuid "274fc05d-1f82-55d1-bec8-b925b6291c70" :answer/type :answer.type/math :answer/value "z=\\sqrt{3}\\,{\\text{e}}^{\\pi \\text{i}/3}" :db/ensure [:answer/validate]} {:db/id "q-17524/selection/258919ca51210d08083ccad6ade1d1469f2f23dfb23cf85269750a7a35c21a46" :answer/id #uuid "027c16c5-2973-5717-8af4-0135a10f6020" :answer/type :answer.type/math :answer/value "z=2\\sqrt{10}\\,{\\text{e}}^{\\pi \\text{i}/3}" :db/ensure [:answer/validate]} {:db/id "q-17524/selection" :answer-field/id #uuid "e5df713a-1952-5f2f-aad9-fbc435f9cd6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17524/selection/5b1c57b2fe1d2c7a23137a4888d43983b4ae855a32aee50ca906745651c8ec1f" :answer-field/choices ["q-17524/selection/9b5e5794757efa300c579917d4c6bee9d752f67f606ebdcc96a05d1d4a90b5a7" "q-17524/selection/1510ad99d4ec2fc08e37ad84e9a2bfc9d34f80db9a729f6f0279eba413cbcb2f" "q-17524/selection/5b1c57b2fe1d2c7a23137a4888d43983b4ae855a32aee50ca906745651c8ec1f" "q-17524/selection/68d4df31bc64a550f7bada6a6bd95bbf6ff7d4d37cf949c22c5ff182d4f103ba" "q-17524/selection/258919ca51210d08083ccad6ade1d1469f2f23dfb23cf85269750a7a35c21a46"] :db/ensure [:answer-field/validate]} {:db/id "q-17524" :question/id #uuid "7a435c59-9a38-57a4-9c2b-af498b51b708" :question/math-academy-id "q-17524" :question/problem "Write the complex number $z=-2+6\\text{i}$ in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to $3$ decimal places." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+{6}^{2}} \\\\  & =2\\sqrt{10}\\end{aligned}\n$$\n\nSince $z$ lies in the second quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-3)| \\\\  & ≈1.893.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{10}$ and $\\theta =1.893$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{10}\\,{\\text{e}}^{1.893\\,\\text{i}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17524/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff"] :knowledge-point/questions ["q-17524"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-71978"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059847/assets/c5d36b72e7e2ff6754152a559d64bf3610708c9a2d3790c859bc9abacc9220b6.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-1+\\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]}]
