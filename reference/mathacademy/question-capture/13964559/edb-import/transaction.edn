                           \n                                        $q=⟨0,\\,-3,\\,$\n\n                                    \n                                \n                                    \n                            \n                                        $2$                \n                                    \n                                \n                                    \n                                        \n                                        \n$⟩\\,,$ \n\n                                    \n                                \n                                    \n                                        \n                                                \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $r=⟨0,\\,$ \n\n                                    \n                                \n                                    \n                            \n                                        $4$                \n                                    \n                                \n                                    \n                                        \n                                        \n$,\\,3⟩\\,.$\n\nCurrent part:\n\nExpress the vector $x=\\overset{\\to }{QR}$ in terms of the vectors $q$ and $r.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $x\\,=\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                         $\\text{ }$ (Type the vectors $q$ and $r$ as $q$ and $r$, respectively)." :question/worked-solution "According to the triangle law of addition, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{QR} & =\\overset{\\to }{OR}-\\overset{\\to }{OQ} \\\\ x & =r-q.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-168032/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33f0ec6b-9cb4-5246-9ac6-23b35e3b224e"] :knowledge-point/questions ["q-168032"] :db/ensure [:knowledge-point/validate]} {:db/id "q-168031/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6a9735d0-1428-56cd-b110-f96c0bdccf2a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-168031/field-1" :answer-field/id #uuid "f20dff8a-4f1a-5d3f-8e76-ac7f060f5cea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-168031/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-168031/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-168031/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d980e5fa-559b-5c15-8a3d-e2fbca685352" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-168031/field-2" :