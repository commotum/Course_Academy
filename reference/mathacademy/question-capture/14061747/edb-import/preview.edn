}}{3}\\operatorname{cos}⁡\\theta  & =-\\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =-\\frac{\\sqrt{3}}{3}\\operatorname{cos}⁡\\theta  \\\\ \\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } & =-\\frac{\\sqrt{3}}{3}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\ \\operatorname{tan}⁡\\theta  & =-\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nThe principal value of $\\theta $ is\n\n$$\n\\theta =\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-\\frac{\\pi }{6}.\n$$\n\nThis value lies outside the domain $0\\le \\theta <2\\pi .$ To get a value that's inside the domain, we add $\\pi :$\n\n$$\n{\\theta }_{1}=-\\frac{\\pi }{6}+\\pi =\\frac{5\\pi }{6}\n$$\n\nTo get a second solution, we add $\\pi $ to ${\\theta }_{1}:$\n\n$$\n{\\theta }_{2}=\\frac{5\\pi }{6}+\\pi =\\frac{11\\pi }{6}\n$$\n\nTherefore, our solutions are $\\frac{5\\pi }{6},\\,\\frac{11\\pi }{6}.$" 13194139535291 true] [17592186342120 1000 #edb/ref 17592186342121 13194139535291 true] [17592186342120 1000 #edb/ref 17592186342122 13194139535291 true] [17592186342120 1000 #edb/ref 17592186342123 13194139535291 true] [17592186342120 1000 #edb/ref 17592186342124 13194139535291 true] [17592186342120 1000 #edb/ref 17592186342125 13194139535291 true] [17592186342120 1040 #edb/ref 17592186045450 13194139535291 true] [17592186342120 1041 "selection" 13194139535291 true] [17592186342120 1104 #edb/ref 17592186342123 13194139535291 true] [17592186342120 1110 #uuid "d9cea939-28cb-56ad-b007-22bdaefef6a8" 13194139535291 true] [17592186342121 1034 "\\frac{5\\pi }{6},\\,\\frac{4\\pi }{3}" 13194139535291 true] [17592186342121 1103 #edb/ref 17592186045453 13194139535291 true] [17592186342121 1111 #uuid "4b46f4d0-8627-5b28-b4e7-7a8115e3c0b6" 13194139535291 true] [17592186342122 1034 "\\frac{5\\pi }{6},\\,\\frac{5\\pi }{3}" 13194139535291 true] [17592186342122 1103 #edb/ref 17592186045453 13194139535291 true] [17592186342122 1111 #uuid "76cb81ba-521b-5e15-9011-60778fdf52e9" 131941