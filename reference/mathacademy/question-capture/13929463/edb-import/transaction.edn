26cf4b0" "q-73156/selection/9aabad6edad3fe111c59b2cba70bedc4ea3e472084e2f1fada93bcaf95a2a64d" "q-73156/selection/4b16573449f9099168ba1aa20143d8c83f7c63ea2eccd811c9c0e6d8e8326a50" "q-73156/selection/cb50b8283de676cb91ef8a3c354dbb894f4cd372a6037a347639ed3158f5dc16"] :db/ensure [:answer-field/validate]} {:db/id "q-73156" :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/is-example false :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73156/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a"] :knowledge-point/questions ["q-73156"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73160/selection/212ace4f83547bc4ff3dcdfedcadedb5398daa7b69f4f050ce87ee4b30eed7b3" :answer/id #uuid "694cf8f0-f27b-5a1e-9714-f1adf172de87" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-2+\\frac{4j}{n})}^{-2}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73160/selection/3e6ab0739c93b8313c6d82d0793f629c76637423ecd05c49afe5a33a62723c2d" :answer/id #uuid "806d68f6-97cc-5d52-a054-36e2bb30ac66" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73160/selection/d0d3bef0c577c59f441001c55cbf8ab81e441a26f17ee61828dcff6473cb9804" :answer/id #uuid "afa474fd-b84b-5434-bb1c-be111ec9b324" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{j}{n})}^{-2}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73160/selection/2b15df4878ec9cfe6451480b801903cbe585d2207dee6d1bb0eb36cb34d22f3c" :answer/id #uuid "c365e3bf-81ee-5ba0-97b6-2afaa363d5bf" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73160/selection/b73a7ed161cf27a2d5910b99461012c48f59dd39ae3c39a2f6e0a4cf25c0ebf2" :answer/id #uuid "3b9147eb-89c9-5273-a69a-b4bfcd391b57" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{4j}{n})}^{-4}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73160/selection" :answer-field/id #uuid "98fcbe93-6e9f-5bf6-bd60-a87c8b54acde" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73160/selection/2b15df4878ec9cfe6451480b801903cbe585d2207dee6d1bb0eb36cb34d22f3c" :answer-field/choices ["q-73160/selection/212ace4f83547bc4ff3dcdfedcadedb5398daa7b69f4f050ce87ee4b30eed7b3" "q-73160/selection/3e6ab0739c93b8313c6d82d0793f629c76637423ecd05c49afe5a33a62723c2d" "q-73160/selection/d0d3bef0c577c59f441001c55cbf8ab81e441a26f17ee61828dcff6473cb9804" "q-73160/selection/2b15df4878ec9cfe6451480b801903cbe585d2207dee6d1bb0eb36cb34d22f3c" "q-73160/selection/b73a7ed161cf27a2d5910b99461012c48f59dd39ae3c39a2f6e0a4cf25c0ebf2"] :db/ensure [:answer-field/validate]} {:db/id "q-73160" :question/id #uuid "335c4ec6-068b-5929-b745-60315556b8d8" :question/math-academy-id "q-73160" :question/is-example false :question/problem "What is ${\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=-5{x}^{-2},$ the lower bound is $a=-4,$ and the upper bound is $b=-2.$ So, we have\n\n$$\nΔx=\\frac{-2-(-4)}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+j\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+\\frac{2j}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73160/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a"] :knowledge-point/questions ["q-73160"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73180/selection/1400f170f06bc5d71465fe837564006c972343d732a6eb0a4150db161b7f1246" :answer/id #uuid "7cb9cd70-cf1b-5e08-8c70-8f5a0c4b1cca" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73180/selection/f0522e5c89f6ff5109f12589355b6b8e88185a13580b88fab124619ad242c63b" :answer/id #uuid "3d8b9f2a-ec73-5dc8-9930-c55179c34795" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73180/selection/ac30dd72b6cff46cbad4d437496a833072e234c3fd782894b045f5ec0b0a0d94" :answer/id #uuid "cbbcfea0-a81e-5ad6-b8b0-b0b9eccd2346" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73180/selection/b8c661e6a68f8406c587ede9aacb6c34b10296bfd5037644882c5f7d730bc22f" :answer/id #uuid "1666d2f8-c115-59af-832a-5b8583a704cb" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73180/selection/c9e5c57d6bc47e137ab409c51149c051216c5954af12bd96f34dcf195c2d161c" :answer/id #uuid "b81c5dad-1888-5f96-acb3-2ab0ae0a41e8" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73180/selection" :answer-field/id #uuid "6a564570-454a-512d-9d5f-25e03b29b690" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73180/selection/ac30dd72b6cff46cbad4d437496a833072e234c3fd782894b045f5ec0b0a0d94" :answer-field/choices ["q-73180/selection/1400f170f06bc5d71465fe837564006c972343d732a6eb0a4150db161b7f1246" "q-73180/selection/f0522e5c89f6ff5109f12589355b6b8e88185a13580b88fab124619ad242c63b" "q-73180/selection/ac30dd72b6cff46cbad4d437496a833072e234c3fd782894b045f5ec0b0a0d94" "q-73180/selection/b8c661e6a68f8406c587ede9aacb6c34b10296bfd5037644882c5f7d730bc22f" "q-73180/selection/c9e5c57d6bc47e137ab409c51149c051216c5954af12bd96f34dcf195c2d161c"] :db/ensure [:answer-field/validate]} {:db/id "q-73180" :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/is-example false :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73180/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2"] :knowledge-point/questions ["q-73180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73185/selection/02388650d88b2644a560fb8ae89a9f02e228c911f24e314eec2d2e5d1b645b0b" :answer/id #uuid "146ce130-ceaa-58c7-86da-de41f259154a" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[(1+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73185/selection/dd24fd019422c9a9cad5704291f496ecbbdfc7097f341c538b10185247e7152d" :answer/id #uuid "1e04a23d-a4bb-5bda-ab66-fd2ba9a2b27f" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73185/selection/3119021c28bf3edaf835dc232400fd0ed6d559da88a82d4fd8c4237e177aa71f" :answer/id #uuid "42aa4612-4453-5f6d-adba-c3b00f29a77b" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{5m}{n})\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73185/selection/4b744f2d9a77ff3f4c85724684492ded9ed2d82f4d823c95f9d17130bc5afe11" :answer/id #uuid "0a2533a4-4b8e-5c74-8306-81d07feb1461" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(3+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73185/selection/ade9f4acfda436abaa901900cdfd82dbead8cec102965b3f96646bdc21b8d38c" :answer/id #uuid "cfa2cfff-a556-5cd2-86a9-53947c75dafb" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[4(2+\\frac{5m}{n})\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73185/selection" :answer-field/id #uuid "d9577d8c-6531-5709-9143-3624f0d1ce8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73185/selection/dd24fd019422c9a9cad5704291f496ecbbdfc7097f341c538b10185247e7152d" :answer-field/choices ["q-73185/selection/02388650d88b2644a560fb8ae89a9f02e228c911f24e314eec2d2e5d1b645b0b" "q-73185/selection/dd24fd019422c9a9cad5704291f496ecbbdfc7097f341c538b10185247e7152d" "q-73185/selection/3119021c28bf3edaf835dc232400fd0ed6d559da88a82d4fd8c4237e177aa71f" "q-73185/selection/4b744f2d9a77ff3f4c85724684492ded9ed2d82f4d823c95f9d17130bc5afe11" "q-73185/selection/ade9f4acfda436abaa901900cdfd82dbead8cec102965b3f96646bdc21b8d38c"] :db/ensure [:answer-field/validate]} {:db/id "q-73185" :question/id #uuid "3c3f36e2-ab95-5680-a92b-2a2ccc51a1c6" :question/math-academy-id "q-73185" :question/is-example false :question/problem "What is ${\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡(4x-3),$ the lower bound is $a=1$ and the upper bound is $b=6.$ So, we have\n\n$$\nΔx=\\frac{6-1}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(1+m\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(1+\\frac{5m}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(4(1+\\frac{5m}{n})-3)\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{20m}{n})\\cdot \\frac{5}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73185/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2"] :knowledge-point/questions ["q-73185"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346201/field-1/8714833de5849a822866b4d1bfbc5f10afd6785045a9e09a7cd5a9107740fb4c" :answer/id #uuid "05757d4d-980c-5453-8af2-73efb4a8f3c6" :answer/type :answer.type/math :answer/value "(x+8)^{1/3}" :db/ensure [:answer/validate]} {:db/id "q-346201/field-1" :answer-field/id #uuid "5328458b-018e-59bc-9024-8e3ee6ef1e91" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346201/field-1/8714833de5849a822866b4d1bfbc5f10afd6785045a9e09a7cd5a9107740fb4c" :answer-field/choices ["q-346201/field-1/8714833de5849a822866b4d1bfbc5f10afd6785045a9e09a7cd5a9107740fb4c"] :db/ensure [:answer-field/validate]} {:db/id "q-346201/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3bfbcb7b-57ab-5867-b3b9-078b373f582c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-346201/field-2" :answer-field/id #uuid "2ddf06ec-b8f5-5986-aa73-4529548ae327" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346201/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-346201/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-346201" :question/id #uuid "f5d1bcc5-dbfa-58e4-9969-5d16f58b431b" :question/math-academy-id "q-346201" :question/is-example false :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{-1}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{((-1+\\frac{3k}{n})+8)}^{1/3}\\cdot \\frac{3}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=-1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-(-1)}{n}\\,⟹\\,b=2.\n$$\n\nConsequently, ${x}_{k}=-1+\\frac{3k}{n}$ and $f({x}_{k})=({x}_{k}+8{)}^{1/3}.$\n\nHence,\n\n$$\n{\\int }_{-1}^{2}(x+8{)}^{1/3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{((-1+\\frac{3k}{n})+8)}^{1/3}\\cdot \\frac{3}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=(x+8{)}^{1/3}\\,\\text{and}\\,b=2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346201/field-1" "q-346201/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5"] :knowledge-point/questions ["q-346201"] :db/ensure [:knowledge-point/validate]}]
