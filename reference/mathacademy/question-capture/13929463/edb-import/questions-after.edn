#{[{:db/id #edb/ref 17592186242446 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05757d4d-980c-5453-8af2-73efb4a8f3c6" :answer/type {:db/ident :answer.type/math} :answer/value "(x+8)^{1/3}" :db/id #edb/ref 17592186242448}] :answer-field/correct {:answer/id #uuid "05757d4d-980c-5453-8af2-73efb4a8f3c6" :answer/type {:db/ident :answer.type/math} :answer/value "(x+8)^{1/3}" :db/id #edb/ref 17592186242448} :answer-field/id #uuid "5328458b-018e-59bc-9024-8e3ee6ef1e91" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242447} {:answer-field/choices [{:answer/id #uuid "3bfbcb7b-57ab-5867-b3b9-078b373f582c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242450}] :answer-field/correct {:answer/id #uuid "3bfbcb7b-57ab-5867-b3b9-078b373f582c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242450} :answer-field/id #uuid "2ddf06ec-b8f5-5986-aa73-4529548ae327" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242449}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f5d1bcc5-dbfa-58e4-9969-5d16f58b431b" :question/is-example false :question/math-academy-id "q-346201" :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{-1}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{((-1+\\frac{3k}{n})+8)}^{1/3}\\cdot \\frac{3}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=-1.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-(-1)}{n}\\,⟹\\,b=2.\n$$\n\nConsequently, ${x}_{k}=-1+\\frac{3k}{n}$ and $f({x}_{k})=({x}_{k}+8{)}^{1/3}.$\n\nHence,\n\n$$\n{\\int }_{-1}^{2}(x+8{)}^{1/3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[{((-1+\\frac{3k}{n})+8)}^{1/3}\\cdot \\frac{3}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=(x+8{)}^{1/3}\\,\\text{and}\\,b=2.\n$$"}] [{:db/id #edb/ref 17592186242451 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf8c304-699f-59b1-965f-88c84d4f1734" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186242453} {:answer/id #uuid "5dc027dd-568b-54f6-81e1-1b40e0454f09" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186242454} {:answer/id #uuid "8f2cfd02-de7c-5db8-9b88-5b58ffc09599" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186242455} {:answer/id #uuid "5a8cd61a-5c86-5747-9dc6-d41ff7988c49" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186242456} {:answer/id #uuid "a3c67575-8fd9-5dbb-9f56-67380c23565a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186242457}] :answer-field/correct {:answer/id #uuid "8f2cfd02-de7c-5db8-9b88-5b58ffc09599" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186242455} :answer-field/id #uuid "35d7befa-73f8-5540-b397-b4f13599e0f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242452}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/is-example false :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242458 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "694cf8f0-f27b-5a1e-9714-f1adf172de87" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-2+\\frac{4j}{n})}^{-2}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186242460} {:answer/id #uuid "c365e3bf-81ee-5ba0-97b6-2afaa363d5bf" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186242461} {:answer/id #uuid "806d68f6-97cc-5d52-a054-36e2bb30ac66" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186242462} {:answer/id #uuid "3b9147eb-89c9-5273-a69a-b4bfcd391b57" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{4j}{n})}^{-4}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186242463} {:answer/id #uuid "afa474fd-b84b-5434-bb1c-be111ec9b324" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{j}{n})}^{-2}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186242464}] :answer-field/correct {:answer/id #uuid "c365e3bf-81ee-5ba0-97b6-2afaa363d5bf" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186242461} :answer-field/id #uuid "98fcbe93-6e9f-5bf6-bd60-a87c8b54acde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242459}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "335c4ec6-068b-5929-b745-60315556b8d8" :question/is-example false :question/math-academy-id "q-73160" :question/problem "What is ${\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=-5{x}^{-2},$ the lower bound is $a=-4,$ and the upper bound is $b=-2.$ So, we have\n\n$$\nΔx=\\frac{-2-(-4)}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+j\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+\\frac{2j}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242465 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cb9cd70-cf1b-5e08-8c70-8f5a0c4b1cca" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242467} {:answer/id #uuid "cbbcfea0-a81e-5ad6-b8b0-b0b9eccd2346" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242468} {:answer/id #uuid "1666d2f8-c115-59af-832a-5b8583a704cb" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186242469} {:answer/id #uuid "b81c5dad-1888-5f96-acb3-2ab0ae0a41e8" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242470} {:answer/id #uuid "3d8b9f2a-ec73-5dc8-9930-c55179c34795" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186242471}] :answer-field/correct {:answer/id #uuid "cbbcfea0-a81e-5ad6-b8b0-b0b9eccd2346" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242468} :answer-field/id #uuid "6a564570-454a-512d-9d5f-25e03b29b690" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242466}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/is-example false :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242472 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146ce130-ceaa-58c7-86da-de41f259154a" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[(1+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242474} {:answer/id #uuid "42aa4612-4453-5f6d-adba-c3b00f29a77b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{5m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242475} {:answer/id #uuid "0a2533a4-4b8e-5c74-8306-81d07feb1461" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(3+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242476} {:answer/id #uuid "cfa2cfff-a556-5cd2-86a9-53947c75dafb" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[4(2+\\frac{5m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242477} {:answer/id #uuid "1e04a23d-a4bb-5bda-ab66-fd2ba9a2b27f" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242478}] :answer-field/correct {:answer/id #uuid "1e04a23d-a4bb-5bda-ab66-fd2ba9a2b27f" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{20m}{n})\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186242478} :answer-field/id #uuid "d9577d8c-6531-5709-9143-3624f0d1ce8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242473}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c3f36e2-ab95-5680-a92b-2a2ccc51a1c6" :question/is-example false :question/math-academy-id "q-73185" :question/problem "What is ${\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡(4x-3),$ the lower bound is $a=1$ and the upper bound is $b=6.$ So, we have\n\n$$\nΔx=\\frac{6-1}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}ln⁡(4x-3)\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(1+m\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(1+\\frac{5m}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(4(1+\\frac{5m}{n})-3)\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[ln⁡(1+\\frac{20m}{n})\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}]}
