[{:db/id "q-11841/selection/aa2e09d05951c28bbb2c8485d0937bb6971938bcb13e6b292b96d57e1ac203dd" :answer/id #uuid "d23a480e-88a4-5af8-8779-11add69e1de0" :answer/type :answer.type/math :answer/value "(1+\\operatorname{ln}⁡3){3}^{x}" :db/ensure [:answer/validate]} {:db/id "q-11841/selection/044de4b534c81619a0d9bc2ba2dd1afa08b03465a3720de72b1ff0decb565d91" :answer/id #uuid "5d6ccc1e-c212-5844-b4ba-20c7d99f3135" :answer/type :answer.type/math :answer/value "{3}^{x}" :db/ensure [:answer/validate]} {:db/id "q-11841/selection/8449f5324a3cdee0dd5afaa8be3d72b808cc7ce9a477e8685c52f1e2b018db5d" :answer/id #uuid "a306448d-60e8-514b-9415-9e962562b712" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3\\cdot {3}^{x}" :db/ensure [:answer/validate]} {:db/id "q-11841/selection/2e6106a5dcf739339cbc268c85651339a912644f2b9c5e034893f2e766070228" :answer/id #uuid "74e19656-27ba-5d17-ac41-eefac97766b9" :answer/type :answer.type/math :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/ensure [:answer/validate]} {:db/id "q-11841/selection/16a955b36c62b02c63a6790026b05828dd911e2c228cfabd4d5a4afb675be516" :answer/id #uuid "957cc015-2ff4-5858-80ca-542fc92725fc" :answer/type :answer.type/math :answer/value "(x\\operatorname{ln}⁡3){3}^{x}" :db/ensure [:answer/validate]} {:db/id "q-11841/selection" :answer-field/id #uuid "fcb13a5f-9e2a-52d0-9caf-b5218e365c14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11841/selection/2e6106a5dcf739339cbc268c85651339a912644f2b9c5e034893f2e766070228" :answer-field/choices ["q-11841/selection/aa2e09d05951c28bbb2c8485d0937bb6971938bcb13e6b292b96d57e1ac203dd" "q-11841/selection/044de4b534c81619a0d9bc2ba2dd1afa08b03465a3720de72b1ff0decb565d91" "q-11841/selection/8449f5324a3cdee0dd5afaa8be3d72b808cc7ce9a477e8685c52f1e2b018db5d" "q-11841/selection/2e6106a5dcf739339cbc268c85651339a912644f2b9c5e034893f2e766070228" "q-11841/selection/16a955b36c62b02c63a6790026b05828dd911e2c228cfabd4d5a4afb675be516"] :db/ensure [:answer-field/validate]} {:db/id "q-11841" :question/id #uuid "c180c9d9-776e-5095-b2ca-7bd71cf574a7" :question/math-academy-id "q-11841" :question/problem "Given that $f(x)=x\\cdot {3}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=x$ and $v(x)={3}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(x)^{′}\\cdot {3}^{x}+x\\cdot ({3}^{x})^{′} \\\\  & ={3}^{x}+(x)(\\operatorname{ln}⁡3\\cdot {3}^{x}) \\\\  & ={3}^{x}+x\\operatorname{ln}⁡3\\cdot {3}^{x} \\\\  & =(1+x\\operatorname{ln}⁡3){3}^{x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-11841"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48515/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "912d0c11-5ebd-54e9-af91-d3d9997f436a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-48515/selection/aa2ac1f6d18119000d6145f3ff83f5f2dfca8d04cba8a379c37b8a0b7275cc2f" :answer/id #uuid "551ef613-a012-5a64-a847-250d4db04faa" :answer/type :answer.type/math :answer/value "5+2\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "q-48515/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9d57a49d-f4ed-5d1c-9403-fa134933df8d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-48515/selection/a36b84e5a4543e816b3295a29d8ccf409cc756d01ccbeab9fba2b247cf607ef5" :answer/id #uuid "6dccbd62-8a05-598c-af35-b8e680f9de0a" :answer/type :answer.type/math :answer/value "1-\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-48515/selection/f3dac89f2ee5e33877fb0ae412fdefdc0cdcceb7dcdcd6e702e1e3ff0391e011" :answer/id #uuid "28f93fdb-a8a1-5944-8984-c11cadf0893d" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-48515/selection" :answer-field/id #uuid "b86965d0-31f0-5589-bffd-4b2285f7500f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48515/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-48515/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-48515/selection/aa2ac1f6d18119000d6145f3ff83f5f2dfca8d04cba8a379c37b8a0b7275cc2f" "q-48515/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-48515/selection/a36b84e5a4543e816b3295a29d8ccf409cc756d01ccbeab9fba2b247cf607ef5" "q-48515/selection/f3dac89f2ee5e33877fb0ae412fdefdc0cdcceb7dcdcd6e702e1e3ff0391e011"] :db/ensure [:answer-field/validate]} {:db/id "q-48515" :question/id #uuid "330ecc2e-b308-5509-8b53-ac52f3ee0861" :question/math-academy-id "q-48515" :question/problem "If a curve $C$ is given by $y=(3x-2)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3x-2$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(3x-2)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 3 \\\\  & =\\frac{3x-2}{x}+3\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3x-2}{x}+3\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{3(1)-2}{1}+3\\operatorname{ln}⁡1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48515/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-48515"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48517/selection/e717fe391874e9afbbb789b330b29ee753bc9f3f5139f9f84084f53fe61de752" :answer/id #uuid "1217113f-c35a-59ef-98ba-c0ec7ba67b9c" :answer/type :answer.type/math :answer/value "3e+5" :db/ensure [:answer/validate]} {:db/id "q-48517/selection/f8da8e04f79d501004a2b6968b4efe96af3e12326ce746122141321f6b06a617" :answer/id #uuid "34934d52-3eb2-54bf-a723-2e0d02ea33e9" :answer/type :answer.type/math :answer/value "{e}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-48517/selection/1fd25f73ed20f650cee8827b14a9e9415d623db7026f702eaf2850bd6b22e3e4" :answer/id #uuid "347b555f-2854-5399-bcd2-629dddb1f8ab" :answer/type :answer.type/math :answer/value "19{e}^{2}" :db/ensure [:answer/validate]} {:db/id "q-48517/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" :answer/id #uuid "e954f233-43ea-5227-838b-84aa28674fcb" :answer/type :answer.type/math :answer/value "{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-48517/selection/a1b2ccfba458a845fd8ee10e6daa31506496a50a50042e082232a7d8cf1de62a" :answer/id #uuid "1aadf521-2119-50b9-be22-d834aac58344" :answer/type :answer.type/math :answer/value "4e" :db/ensure [:answer/validate]} {:db/id "q-48517/selection" :answer-field/id #uuid "179223e6-5b62-580e-9a38-cf433b22d31f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48517/selection/1fd25f73ed20f650cee8827b14a9e9415d623db7026f702eaf2850bd6b22e3e4" :answer-field/choices ["q-48517/selection/e717fe391874e9afbbb789b330b29ee753bc9f3f5139f9f84084f53fe61de752" "q-48517/selection/f8da8e04f79d501004a2b6968b4efe96af3e12326ce746122141321f6b06a617" "q-48517/selection/1fd25f73ed20f650cee8827b14a9e9415d623db7026f702eaf2850bd6b22e3e4" "q-48517/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" "q-48517/selection/a1b2ccfba458a845fd8ee10e6daa31506496a50a50042e082232a7d8cf1de62a"] :db/ensure [:answer-field/validate]} {:db/id "q-48517" :question/id #uuid "7d7f0345-c801-53f1-91dc-0c2acb65defb" :question/math-academy-id "q-48517" :question/problem "If a curve $C$ is given by $y=({x}^{3}-1){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{3}-1$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2},\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{3}-1)\\cdot {e}^{x}+{e}^{x}\\cdot (3{x}^{2}) \\\\  & ={e}^{x}({x}^{3}+3{x}^{2}-1).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={{e}^{x}({x}^{3}+3{x}^{2}-1)|}_{x=2} \\\\  & ={e}^{2}({2}^{3}+3(2)^{2}-1) \\\\  & =19{e}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $19{e}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83"] :knowledge-point/questions ["q-48517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320814/field-1/ff8522769a994b832a8d835e9063fd3be532371280f5375c19ef97d9e927eae6" :answer/id #uuid "5e3624fd-6a11-594f-901b-9f6c169c6684" :answer/type :answer.type/math :answer/value "3^x\\ln(x)" :db/ensure [:answer/validate]} {:db/id "q-320814/field-1/9057988130015a17da23f195921e3f64335afb91b3dee85a3f142f4ef4a343a3" :answer/id #uuid "6be1c15a-c1af-586e-ac41-5befb758f0ac" :answer/type :answer.type/math :answer/value "3^x" :db/ensure [:answer/validate]} {:db/id "q-320814/field-1" :answer-field/id #uuid "63e29222-5a8d-5853-8b80-3d161379b88e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320814/field-1/ff8522769a994b832a8d835e9063fd3be532371280f5375c19ef97d9e927eae6" :answer-field/choices ["q-320814/field-1/ff8522769a994b832a8d835e9063fd3be532371280f5375c19ef97d9e927eae6" "q-320814/field-1/9057988130015a17da23f195921e3f64335afb91b3dee85a3f142f4ef4a343a3"] :db/ensure [:answer-field/validate]} {:db/id "q-320814" :question/id #uuid "6755afd0-1d15-5a55-b5fd-7034b536b6e7" :question/math-academy-id "q-320814" :question/problem "Given that $f(x)={3}^{x}{log}_{3}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)={log}_{3}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({3}^{x})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})(\\frac{1}{x\\operatorname{ln}⁡(3)}) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320814/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-320814"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320815/field-1/d2c92127f86183d5623faa1e18822060db33560c890cf4b8bcf25a8bc5695cef" :answer/id #uuid "5f494c67-2b1f-563c-b6ae-d467104f00fc" :answer/type :answer.type/math :answer/value "\\frac{4^x}{x\\ln(4)}" :db/ensure [:answer/validate]} {:db/id "q-320815/field-1" :answer-field/id #uuid "1e915aa4-1cf3-58c6-a7f5-6d6f8030abff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320815/field-1/d2c92127f86183d5623faa1e18822060db33560c890cf4b8bcf25a8bc5695cef" :answer-field/choices ["q-320815/field-1/d2c92127f86183d5623faa1e18822060db33560c890cf4b8bcf25a8bc5695cef"] :db/ensure [:answer-field/validate]} {:db/id "q-320815" :question/id #uuid "698df9b7-5456-5bcc-9e90-ffc1581df963" :question/math-academy-id "q-320815" :question/problem "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})(\\frac{1}{x\\operatorname{ln}⁡(4)}) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320815/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8"] :knowledge-point/questions ["q-320815"] :db/ensure [:knowledge-point/validate]}]
