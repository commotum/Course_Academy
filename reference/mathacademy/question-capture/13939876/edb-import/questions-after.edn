#{[{:db/id #edb/ref 17592186249776 :knowledge-point/_questions [{:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d6ccc1e-c212-5844-b4ba-20c7d99f3135" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}" :db/id #edb/ref 17592186249778} {:answer/id #uuid "957cc015-2ff4-5858-80ca-542fc92725fc" :answer/type {:db/ident :answer.type/math} :answer/value "(x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186249779} {:answer/id #uuid "74e19656-27ba-5d17-ac41-eefac97766b9" :answer/type {:db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186249780} {:answer/id #uuid "a306448d-60e8-514b-9415-9e962562b712" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot {3}^{x}" :db/id #edb/ref 17592186249781} {:answer/id #uuid "d23a480e-88a4-5af8-8779-11add69e1de0" :answer/type {:db/ident :answer.type/math} :answer/value "(1+\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186249782}] :answer-field/correct {:answer/id #uuid "74e19656-27ba-5d17-ac41-eefac97766b9" :answer/type {:db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186249780} :answer-field/id #uuid "fcb13a5f-9e2a-52d0-9caf-b5218e365c14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249777}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c180c9d9-776e-5095-b2ca-7bd71cf574a7" :question/math-academy-id "q-11841" :question/problem "Given that $f(x)=x\\cdot {3}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=x$ and $v(x)={3}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(x)^{′}\\cdot {3}^{x}+x\\cdot ({3}^{x})^{′} \\\\  & ={3}^{x}+(x)(\\operatorname{ln}⁡3\\cdot {3}^{x}) \\\\  & ={3}^{x}+x\\operatorname{ln}⁡3\\cdot {3}^{x} \\\\  & =(1+x\\operatorname{ln}⁡3){3}^{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249783 :knowledge-point/_questions [{:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6be1c15a-c1af-586e-ac41-5befb758f0ac" :answer/type {:db/ident :answer.type/math} :answer/value "3^x" :db/id #edb/ref 17592186249785} {:answer/id #uuid "5e3624fd-6a11-594f-901b-9f6c169c6684" :answer/type {:db/ident :answer.type/math} :answer/value "3^x\\ln(x)" :db/id #edb/ref 17592186249786}] :answer-field/correct {:answer/id #uuid "5e3624fd-6a11-594f-901b-9f6c169c6684" :answer/type {:db/ident :answer.type/math} :answer/value "3^x\\ln(x)" :db/id #edb/ref 17592186249786} :answer-field/id #uuid "63e29222-5a8d-5853-8b80-3d161379b88e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186249784}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6755afd0-1d15-5a55-b5fd-7034b536b6e7" :question/math-academy-id "q-320814" :question/problem "Given that $f(x)={3}^{x}{log}_{3}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)={log}_{3}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({3}^{x})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})(\\frac{1}{x\\operatorname{ln}⁡(3)}) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249787 :knowledge-point/_questions [{:knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f494c67-2b1f-563c-b6ae-d467104f00fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4^x}{x\\ln(4)}" :db/id #edb/ref 17592186249789}] :answer-field/correct {:answer/id #uuid "5f494c67-2b1f-563c-b6ae-d467104f00fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4^x}{x\\ln(4)}" :db/id #edb/ref 17592186249789} :answer-field/id #uuid "1e915aa4-1cf3-58c6-a7f5-6d6f8030abff" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186249788}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "698df9b7-5456-5bcc-9e90-ffc1581df963" :question/math-academy-id "q-320815" :question/problem "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})(\\frac{1}{x\\operatorname{ln}⁡(4)}) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249790 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dccbd62-8a05-598c-af35-b8e680f9de0a" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186249792} {:answer/id #uuid "551ef613-a012-5a64-a847-250d4db04faa" :answer/type {:db/ident :answer.type/math} :answer/value "5+2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186249793} {:answer/id #uuid "9d57a49d-f4ed-5d1c-9403-fa134933df8d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249794} {:answer/id #uuid "912d0c11-5ebd-54e9-af91-d3d9997f436a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186249795} {:answer/id #uuid "28f93fdb-a8a1-5944-8984-c11cadf0893d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186249796}] :answer-field/correct {:answer/id #uuid "9d57a49d-f4ed-5d1c-9403-fa134933df8d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249794} :answer-field/id #uuid "b86965d0-31f0-5589-bffd-4b2285f7500f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249791}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "330ecc2e-b308-5509-8b53-ac52f3ee0861" :question/math-academy-id "q-48515" :question/problem "If a curve $C$ is given by $y=(3x-2)\\operatorname{ln}⁡x,$ calculate the slope of the tangent line to the curve at the point where $x=1.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3x-2$ and $v(x)=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3,\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =(3x-2)\\cdot \\frac{1}{x}+(\\operatorname{ln}⁡x)\\cdot 3 \\\\  & =\\frac{3x-2}{x}+3\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=1$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3x-2}{x}+3\\operatorname{ln}⁡x)|}_{x=1} \\\\  & =\\frac{3(1)-2}{1}+3\\operatorname{ln}⁡1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $1.$"}] [{:db/id #edb/ref 17592186249797 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee64135e-9b9f-5429-a4df-efa522042b83" :knowledge-point/title "Finding the Slope of the Tangent Line to a Product  at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347b555f-2854-5399-bcd2-629dddb1f8ab" :answer/type {:db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186249799} {:answer/id #uuid "1aadf521-2119-50b9-be22-d834aac58344" :answer/type {:db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186249800} {:answer/id #uuid "e954f233-43ea-5227-838b-84aa28674fcb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186249801} {:answer/id #uuid "1217113f-c35a-59ef-98ba-c0ec7ba67b9c" :answer/type {:db/ident :answer.type/math} :answer/value "3e+5" :db/id #edb/ref 17592186249802} {:answer/id #uuid "34934d52-3eb2-54bf-a723-2e0d02ea33e9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+2" :db/id #edb/ref 17592186249803}] :answer-field/correct {:answer/id #uuid "347b555f-2854-5399-bcd2-629dddb1f8ab" :answer/type {:db/ident :answer.type/math} :answer/value "19{e}^{2}" :db/id #edb/ref 17592186249799} :answer-field/id #uuid "179223e6-5b62-580e-9a38-cf433b22d31f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249798}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d7f0345-c801-53f1-91dc-0c2acb65defb" :question/math-academy-id "q-48517" :question/problem "If a curve $C$ is given by $y=({x}^{3}-1){e}^{x},$ calculate the slope of the tangent line to the curve at the point where $x=2.$" :question/worked-solution "We differentiate using the product rule. Let $u(x)={x}^{3}-1$ and $v(x)={e}^{x}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2},\\,\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =u\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}u}{\\text{d}x} \\\\  & =({x}^{3}-1)\\cdot {e}^{x}+{e}^{x}\\cdot (3{x}^{2}) \\\\  & ={e}^{x}({x}^{3}+3{x}^{2}-1).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=2$ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={{e}^{x}({x}^{3}+3{x}^{2}-1)|}_{x=2} \\\\  & ={e}^{2}({2}^{3}+3(2)^{2}-1) \\\\  & =19{e}^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $19{e}^{2}.$"}]}
