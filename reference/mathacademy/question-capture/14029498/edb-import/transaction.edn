[{:db/id "q-74654/selection/9776a62729db7f90b694107bca4c2a19bff8b8ca61c785067897fdba13d1d7e8" :answer/id #uuid "29cd0a60-5cd2-5e5f-9dfa-e21c15775b50" :answer/type :answer.type/math :answer/value "\\frac{1}{4}+\\frac{3}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74654/selection/2cb2b40033cabf30ef90b1af6abd68221651d5e6b2ce9ae72687896748c9173a" :answer/id #uuid "0f928061-3e27-50b8-b05b-3f31993e7d07" :answer/type :answer.type/math :answer/value "\\frac{5}{4}-\\frac{1}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74654/selection/cf830fbb079151eef1816e0a73341f8851d73b0451ed4d40305715b7321dc666" :answer/id #uuid "e0c9cbfe-e143-5378-9dd3-08fb363427d2" :answer/type :answer.type/math :answer/value "\\frac{3}{4}-\\frac{3}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74654/selection/493ae1b33340b891caa2c401371b5c020780032590084f496de462a77a0bd276" :answer/id #uuid "47479dd7-0df2-55b4-894e-65a9f3609b39" :answer/type :answer.type/math :answer/value "\\frac{3}{2}-\\frac{1}{4}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74654/selection/30620b8dc384213be45fc35152fb80e8e19421d56b232836ea43e35aeb4efa37" :answer/id #uuid "47646cbc-679f-5db7-bf84-f66a87e574cf" :answer/type :answer.type/math :answer/value "\\frac{1}{4}-\\frac{3}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74654/selection" :answer-field/id #uuid "33d41a29-1d36-570c-906a-cdc8820aada9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74654/selection/30620b8dc384213be45fc35152fb80e8e19421d56b232836ea43e35aeb4efa37" :answer-field/choices ["q-74654/selection/9776a62729db7f90b694107bca4c2a19bff8b8ca61c785067897fdba13d1d7e8" "q-74654/selection/2cb2b40033cabf30ef90b1af6abd68221651d5e6b2ce9ae72687896748c9173a" "q-74654/selection/cf830fbb079151eef1816e0a73341f8851d73b0451ed4d40305715b7321dc666" "q-74654/selection/493ae1b33340b891caa2c401371b5c020780032590084f496de462a77a0bd276" "q-74654/selection/30620b8dc384213be45fc35152fb80e8e19421d56b232836ea43e35aeb4efa37"] :db/ensure [:answer-field/validate]} {:db/id "q-74654" :question/id #uuid "b360ffce-06f6-5c3e-8fff-4c161220f31e" :question/math-academy-id "q-74654" :question/problem "$\\frac{6+\\text{i}}{4\\text{i}}=$" :question/worked-solution "Here, the denominator is the imaginary number $4\\text{i}.$ Note that this can be written as $0+4\\text{i},$ so the conjugate is $0-4\\text{i},$ or simply $-4\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{6+\\text{i}}{4\\text{i}} & =\\frac{6+\\text{i}}{4\\text{i}}\\cdot \\frac{-4\\text{i}}{-4\\text{i}} \\\\  & =\\frac{-24\\text{i}-4{\\text{i}}^{2}}{-16{\\text{i}}^{2}} \\\\  & =\\frac{-24\\text{i}-4(-1)}{-16(-1)} \\\\  & =\\frac{4-24\\text{i}}{16}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{4-24\\text{i}}{16} & =\\frac{4}{16}-\\frac{24}{16}\\text{i} \\\\  & =\\frac{1}{4}-\\frac{3}{2}\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74654/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958"] :knowledge-point/questions ["q-74654"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127838/selection/7ac37b6a9a088130baec1c3b5e61df170c38b8681439d0881a70198b14c16132" :answer/id #uuid "c1cb6b65-0f97-5d5f-8b22-b8890e6797d7" :answer/type :answer.type/math :answer/value "4n" :db/ensure [:answer/validate]} {:db/id "q-127838/selection/5fc9f09280325665e9e8980673b8fcf31a603bfcff515fc2ae2aaf8cbe59d947" :answer/id #uuid "653644b0-5342-5dd7-ba29-a7cfaeade2ce" :answer/type :answer.type/math :answer/value "12n" :db/ensure [:answer/validate]} {:db/id "q-127838/selection/84543ce9858c91d1ad6dc153651f91343c8766679931c1ff839ce9cca6efe5b1" :answer/id #uuid "137c510c-446c-5ac4-9206-222c6493612a" :answer/type :answer.type/math :answer/value "6n" :db/ensure [:answer/validate]} {:db/id "q-127838/selection/7b6a0bda54041fd7da6c7dc20481a69ece2ece275f6887609b9c1579b598a735" :answer/id #uuid "edaaac1a-88e2-518e-833f-77dc5e09265d" :answer/type :answer.type/math :answer/value "18n" :db/ensure [:answer/validate]} {:db/id "q-127838/selection/c685da916204959b38453c5dd68e678b3fabfc5940a15c94e775899ab87b041d" :answer/id #uuid "a9f8ed7d-5bf0-5dcc-b9b7-d27afae13f7a" :answer/type :answer.type/math :answer/value "24n" :db/ensure [:answer/validate]} {:db/id "q-127838/selection" :answer-field/id #uuid "5ba727a4-81fb-5a56-abce-ea644f58432e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127838/selection/5fc9f09280325665e9e8980673b8fcf31a603bfcff515fc2ae2aaf8cbe59d947" :answer-field/choices ["q-127838/selection/7ac37b6a9a088130baec1c3b5e61df170c38b8681439d0881a70198b14c16132" "q-127838/selection/5fc9f09280325665e9e8980673b8fcf31a603bfcff515fc2ae2aaf8cbe59d947" "q-127838/selection/84543ce9858c91d1ad6dc153651f91343c8766679931c1ff839ce9cca6efe5b1" "q-127838/selection/7b6a0bda54041fd7da6c7dc20481a69ece2ece275f6887609b9c1579b598a735" "q-127838/selection/c685da916204959b38453c5dd68e678b3fabfc5940a15c94e775899ab87b041d"] :db/ensure [:answer-field/validate]} {:db/id "q-127838" :question/id #uuid "6031cc66-ec95-5415-9785-9f9e09ec2735" :question/math-academy-id "q-127838" :question/problem "The vector $u$ has magnitude $6$, the vector $v$ has magnitude $4$, the angle between $u$ and $v$ is ${30}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$" :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =6\\cdot 4\\cdot \\operatorname{sin}⁡{30}^{∘}\\cdot n \\\\  & =24\\cdot \\frac{1}{2}\\cdot n \\\\  & =12n.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127838/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd"] :knowledge-point/questions ["q-127838"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106832/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "9a6443fa-1a0b-51ee-b860-501184545d20" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-106832/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2946a868-1500-5d7a-8bff-44dd42e5e7d5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-106832/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "39bbe88a-2431-597a-a713-28a16abe634b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-106832/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "5558984e-05d9-5ba1-9de2-fa71a77b8cf3" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-106832/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "460ae15b-f4be-5514-98b7-e705956a073c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-106832/selection" :answer-field/id #uuid "e3208868-49e5-557c-b01c-a936ff6cb30c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106832/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-106832/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-106832/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-106832/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-106832/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-106832/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-106832" :question/id #uuid "d9250d96-2930-55be-a93d-b3b19673faf9" :question/math-academy-id "q-106832" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{-\\operatorname{sin}⁡x}{2x-{x}^{3}}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{-\\operatorname{sin}⁡x}{2x-{x}^{3}}={lim}_{x\\to \\infty }\\frac{\\operatorname{sin}⁡x}{{x}^{3}-2x}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|\\operatorname{sin}⁡x|\\le 1.\n$$\n\nHowever, the denominator ${x}^{3}-2x$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{-\\operatorname{sin}⁡x}{2x-{x}^{3}}={lim}_{x\\to \\infty }\\frac{\\operatorname{sin}⁡x}{{x}^{3}-2x}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{-\\operatorname{sin}⁡x}{2x-{x}^{3}},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029498/assets/a9d96a5a85181cddc6eb1bd5f79d6a0238ef16f060ddebf2dc4c48ef1911604f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074"] :knowledge-point/questions ["q-106832"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328382/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b8e3be0f-25a5-51fe-a9ad-5cbaebe7ef10" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-328382/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "f1af8e26-b3f1-5767-9bbb-95792354f892" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-328382/field-1" :answer-field/id #uuid "ed6a1d8b-b783-5448-957c-feea21ab1621" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328382/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-328382/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-328382/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-328382/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "24c5fd38-fad6-58fe-9efa-6cb6358a5d06" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-328382/field-2" :answer-field/id #uuid "4c460dcd-9be9-542b-8990-d412f56cf644" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328382/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-328382/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-328382" :question/id #uuid "dd806166-c3df-538e-871b-d9477c5bfc0b" :question/math-academy-id "q-328382" :question/problem "The center of the hyperbola ${x}^{2}-9{y}^{2}-6x-36y=54$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-9{y}^{2}-6x-36y & =54 \\\\ {x}^{2}-6x-9{y}^{2}-36y & =54 \\\\ [{x}^{2}-6x]-9[{y}^{2}+4y] & =54 \\\\ [(x-3)^{2}-9]-9[(y+2)^{2}-4] & =54 \\\\ (x-3)^{2}-9-9(y+2)^{2}+36 & =54 \\\\ (x-3)^{2}-9(y+2)^{2} & =54+9-36 \\\\ (x-3)^{2}-9(y+2)^{2} & =27 \\\\ \\frac{(x-3)^{2}}{(\\sqrt{27})^{2}}-\\frac{(y+2)^{2}}{(\\sqrt{3})^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{(\\sqrt{27})^{2}}-\\frac{(y-(-2))^{2}}{(\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,3,-2\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328382/field-1" "q-328382/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951"] :knowledge-point/questions ["q-328382"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17124/selection/0f9417f56e4afa644286c6413ecbb991b36689a7a905a525ce516b624d5ce084" :answer/id #uuid "0019a12c-e576-5a4b-b94b-3337d9bd793e" :answer/type :answer.type/math :answer/value "(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2})" :db/ensure [:answer/validate]} {:db/id "q-17124/selection/d63dc7d16b255fe4d35643eb8ab3f1499f8186ac0bd720c3292e42ae5d98051a" :answer/id #uuid "9b29f011-514a-5612-b515-2c1d43c38312" :answer/type :answer.type/math :answer/value "(-\\frac{\\sqrt{2}}{4},-\\frac{\\sqrt{2}}{4})" :db/ensure [:answer/validate]} {:db/id "q-17124/selection/94d82750d5260f82fdecb736646efb0d6edb6b3f4bb4f8622f5da952fb365fd1" :answer/id #uuid "b0cbd1d3-638c-56ed-96b1-0b3edcc865f0" :answer/type :answer.type/math :answer/value "(-\\frac{\\sqrt{2}}{6},-\\frac{\\sqrt{2}}{6})" :db/ensure [:answer/validate]} {:db/id "q-17124/selection/2a1abfc7088447960b23cca3641d1bb912a4bd04f988b497e25524234f73ac51" :answer/id #uuid "b25b450c-fcf5-5490-96c8-5403facd11e4" :answer/type :answer.type/math :answer/value "(-\\frac{\\sqrt{2}}{3},-\\frac{\\sqrt{2}}{3})" :db/ensure [:answer/validate]} {:db/id "q-17124/selection/b1ac86e63cfa92bbaca4fea8479be9253a062be525897336211dce7853ae77f8" :answer/id #uuid "0d70bf82-a79c-5359-bc83-3c6414396490" :answer/type :answer.type/math :answer/value "(-\\frac{\\sqrt{2}}{5},-\\frac{\\sqrt{2}}{5})" :db/ensure [:answer/validate]} {:db/id "q-17124/selection" :answer-field/id #uuid "b636fb6d-c682-542b-b25c-749bd6dcf1f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17124/selection/94d82750d5260f82fdecb736646efb0d6edb6b3f4bb4f8622f5da952fb365fd1" :answer-field/choices ["q-17124/selection/0f9417f56e4afa644286c6413ecbb991b36689a7a905a525ce516b624d5ce084" "q-17124/selection/d63dc7d16b255fe4d35643eb8ab3f1499f8186ac0bd720c3292e42ae5d98051a" "q-17124/selection/94d82750d5260f82fdecb736646efb0d6edb6b3f4bb4f8622f5da952fb365fd1" "q-17124/selection/2a1abfc7088447960b23cca3641d1bb912a4bd04f988b497e25524234f73ac51" "q-17124/selection/b1ac86e63cfa92bbaca4fea8479be9253a062be525897336211dce7853ae77f8"] :db/ensure [:answer-field/validate]} {:db/id "q-17124" :question/id #uuid "1600c079-8696-5fa4-9f4f-536830552848" :question/math-academy-id "q-17124" :question/problem "Given that the distance from a point $P$ to the origin is $\\frac{1}{3},$ and that $P$ makes an angle of $\\frac{5\\pi }{4}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=\\frac{1}{3},\\,\\theta =\\frac{5\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =\\frac{1}{3}\\operatorname{cos}⁡(\\frac{5\\pi }{4}) \\\\ x & =\\frac{1}{3}(\\frac{-\\sqrt{2}}{2}) \\\\ x & =-\\frac{\\sqrt{2}}{6}\\end{aligned}\n$$\n\nThen we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =\\frac{1}{3}\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\ y & =\\frac{1}{3}(\\frac{-\\sqrt{2}}{2}) \\\\ y & =-\\frac{\\sqrt{2}}{6}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{\\sqrt{2}}{6},-\\frac{\\sqrt{2}}{6}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17124/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-17124"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351278/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "b84caf6b-47a6-51dd-bc22-d93398b42e45" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-351278/field-1" :answer-field/id #uuid "c7354aa1-1525-55a5-8a28-58ba28267f4f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351278/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-351278/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-351278" :question/id #uuid "55bbc0e5-8d38-5973-b1f1-afc64d12e238" :question/math-academy-id "q-351278" :question/problem "Express $\\frac{9{x}^{2}-6x+20}{(2{x}^{2}+5)x}$ as a sum of partial fractions.\n\n| $\\frac{9{x}^{2}-6x+20}{(2{x}^{2}+5)x}=\\,$ | $x\\,-\\,${{field-1}} | $+$ | $4$ |\n| --- | --- | --- | --- |\n|  | $2{x}^{2}+5$ |  | $x$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{9{x}^{2}-6x+20}{(2{x}^{2}+5)x}=\\frac{x+B}{2{x}^{2}+5}+\\frac{4}{x}.\\end{aligned}\n$$\n\nMultiplying both sides by $(2{x}^{2}+5)x$ gives\n\n$$\n\\begin{aligned}9{x}^{2}-6x+20 & =(x+B)x+4(2{x}^{2}+5).\\end{aligned}\n$$\n\nFor $x=1$, we get\n\n$$\n\\begin{aligned}9(1)^{2}-6(1)+20 & =(1+B)(1)+4(2(1)^{2}+5) \\\\ 23 & =1+B+28 \\\\ B & =-6.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{9{x}^{2}-6x+20}{(2{x}^{2}+5)x}=\\frac{x-6}{2{x}^{2}+5}+\\frac{4}{x}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351278/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5c6490a5-4923-58e8-99c3-d568a033800e"] :knowledge-point/questions ["q-351278"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65463/selection/b7715aaff8d8bfc13b9ad1aa1a06964070ac58e98c196e013ecabbefdbeb38c5" :answer/id #uuid "a23c4fb3-8b28-5e2b-af17-42a557a791a4" :answer/type :answer.type/math :answer/value "1-\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-65463/selection/cfc8fef17e139caa5fddf2aa821cf0d765f6ef916d009a28f07f272343f7f48b" :answer/id #uuid "de4bfde3-a56f-5f58-842d-0df431407c64" :answer/type :answer.type/math :answer/value "{csc}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-65463/selection/50d2bfa0478944f3db26ca55c760f664e300d6b15e21412591425b290e153395" :answer/id #uuid "2c38ed34-fd0e-5248-b6cf-1bdf0286e986" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-65463/selection/a98494342e002e6aaafaca0a7c1380dcf653309456473755d062f2ef41e7c098" :answer/id #uuid "6e521150-7bb5-5ca1-a819-2d10fb4f9843" :answer/type :answer.type/math :answer/value "1+\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-65463/selection/9e03065c7b08a29564174b2b0f3357ad7bff7c8b7386d9b98462efa8a553b6ab" :answer/id #uuid "643a58f1-4de4-5b5d-96e1-23780f14359e" :answer/type :answer.type/math :answer/value "2\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-65463/selection" :answer-field/id #uuid "3a051f82-005b-5382-8325-838241e21514" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65463/selection/50d2bfa0478944f3db26ca55c760f664e300d6b15e21412591425b290e153395" :answer-field/choices ["q-65463/selection/b7715aaff8d8bfc13b9ad1aa1a06964070ac58e98c196e013ecabbefdbeb38c5" "q-65463/selection/cfc8fef17e139caa5fddf2aa821cf0d765f6ef916d009a28f07f272343f7f48b" "q-65463/selection/50d2bfa0478944f3db26ca55c760f664e300d6b15e21412591425b290e153395" "q-65463/selection/a98494342e002e6aaafaca0a7c1380dcf653309456473755d062f2ef41e7c098" "q-65463/selection/9e03065c7b08a29564174b2b0f3357ad7bff7c8b7386d9b98462efa8a553b6ab"] :db/ensure [:answer-field/validate]} {:db/id "q-65463" :question/id #uuid "e148983a-5035-5901-aa4f-54a3e738d0a1" :question/math-academy-id "q-65463" :question/problem "Simplify $\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1}-1.$" :question/worked-solution "First, we multiply the numerator and the denominator of the fraction by $\\operatorname{csc}⁡x+1.$ This gives: \n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1} & =\\frac{{cot}^{2}⁡x}{\\operatorname{csc}⁡x-1}\\cdot \\frac{\\operatorname{csc}⁡x+1}{\\operatorname{csc}⁡x+1} \\\\  & =\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{csc}^{2}⁡x-1}\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta $, we have\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{csc}^{2}⁡x-1}-1 & =\\frac{{cot}^{2}⁡x\\,(\\operatorname{csc}⁡x+1)}{{cot}^{2}⁡x}-1 \\\\  & =\\frac{\\cancel{{cot}^{2}⁡x}\\,(\\operatorname{csc}⁡x+1)}{\\cancel{{cot}^{2}⁡x}}-1 \\\\  & =(\\operatorname{csc}⁡x+1)\\,-1 \\\\  & =\\operatorname{csc}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65463/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77"] :knowledge-point/questions ["q-65463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134016/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "d43841e2-859c-5834-b8b9-9fc0694c41b7" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-134016/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "994e93e7-c00a-5742-8a68-75269590ca63" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-134016/selection/81ce827f579fc6a9bfd3f3ef9f4a88359adb134fba1cf48d7cb4c8219e6688c9" :answer/id #uuid "5158c879-7858-5855-87a8-1fd6c3fabb37" :answer/type :answer.type/math :answer/value "-\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "q-134016/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "de8710da-d1c1-520a-ac96-3582c83f6d7a" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-134016/selection/774940da4ab3b26727b8db6c1c90fb931ece0a7759ec47b6581e5af495721ce1" :answer/id #uuid "95660e11-a29a-5099-8d9d-0dc2000b2ab4" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-134016/selection" :answer-field/id #uuid "de8facb1-7b54-5d95-8b90-671f98bba8ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-134016/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer-field/choices ["q-134016/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" "q-134016/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-134016/selection/81ce827f579fc6a9bfd3f3ef9f4a88359adb134fba1cf48d7cb4c8219e6688c9" "q-134016/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" "q-134016/selection/774940da4ab3b26727b8db6c1c90fb931ece0a7759ec47b6581e5af495721ce1"] :db/ensure [:answer-field/validate]} {:db/id "q-134016" :question/id #uuid "0a2a1e0f-109b-5eb1-aede-0460221885ac" :question/math-academy-id "q-134016" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029498/assets/e2d51071ddc198adecdff56593dec29ba9aef10d90b89ddc03a4cdbe9c757034.png)\n\nWhat is the slope of the trend line shown above?" :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(0,8)$ and $({x}_{2},{y}_{2})=(3,7).$\n\nTherefore, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{7-8}{3-0} \\\\  & =\\frac{-1}{3} \\\\  & =-\\frac{1}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-134016/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3"] :knowledge-point/questions ["q-134016"] :db/ensure [:knowledge-point/validate]} {:db/id "q-288444/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "838eda95-a363-598c-b42f-c95bc7f93707" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-288444/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "4b720bf6-ab1f-5f5b-b28b-bd2d9226c53b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-288444/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "d8b50d2d-73a8-50e5-be21-8640d6f0cf0a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-288444/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "95698a32-4eb8-5163-b62c-1cbbf4c09e8f" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-288444/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0db79e22-5124-5430-8d80-42a1d499b503" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-288444/selection" :answer-field/id #uuid "0931fc79-d008-5b67-8515-1a375ae7f283" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288444/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-288444/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-288444/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-288444/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-288444/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-288444/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-288444" :question/id #uuid "f0b2734f-0ee6-5285-8bef-0e313bb618ab" :question/math-academy-id "q-288444" :question/problem "The following equation is true for all values of $x.$\n\n$$\n-2{x}^{2}+3x+b=-2{x}^{2}+3x-6\n$$\n\nWhat is the value of the constant $b?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the constant terms on both sides. On the left-hand side, the constant is $b.$ On the right-hand side, the constant is $-6.$\n\nSo, we have\n\n$$\nb=-6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-288444/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a"] :knowledge-point/questions ["q-288444"] :db/ensure [:knowledge-point/validate]}]
