481840" "q-77678/selection/43282a2954a0c74a389100e24cbb085243d54befffef9e3c428687f3819869b6" "q-77678/selection/d4884c9a65759031a94e7b8fc4f44dc441849df9e462d4ce93d65163a03ff26d"] :db/ensure [:answer-field/validate]} {:db/id "q-77678" :question/id #uuid "1d9f58cb-435d-56fa-87f4-3623cbee5471" :question/math-academy-id "q-77678" :question/problem "Find the derivative of  $f(t)=\\operatorname{arctan}⁡t\\,i+(3{t}^{2}-5t)\\,j+\\frac{1}{1+t}\\,k$ at $t=1.$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-5t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{1+t})\\,k \\\\  & =\\frac{1}{1+{t}^{2}}\\,i+(6t-5)\\,j-\\frac{1}{(1+t)^{2}}\\,k\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(1)$ we substitute $t=1$ into the expression for ${f}^{′}(t)$:\n\n$$\n\\begin{aligned}{f}^{′}(1) & =\\frac{1}{1+(1)^{2}}\\,i+(6(1)-5)\\,j-\\frac{1}{(1+(1))^{2}}\\,k \\\\  & =\\frac{1}{2}\\,i+\\,j-\\frac{1}{4}\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77678/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee"] :knowledge-point/questions ["q-77678"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32417/selection/feb9605868e2bdd6f801622eb6cc0386ce767fadc9e8054618c0223f7e29120d" :answer/id #uuid "bc121725-d27a-5776-b5c2-408b4a1936a9" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/ensure [:answer/validate]} {:db/id "q-32417/selection/069c0a6ae39b31d705aa53c589b71b66a82505c35a962601e96d2fbbc3b0c572" :answer/id #uuid "fb4e788e-497f-5bc5-ac41-a16fba649e04" :answer/type :answer.type/math :answer/value "-\\frac{1}{1-{t}^{2}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/ensure [:answer/validate]} {:db/id "q-32417/selection/4ccf93ee0d17ece