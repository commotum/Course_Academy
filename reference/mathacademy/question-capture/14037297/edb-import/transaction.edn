695798e5ea8badf2a5b3849ad1d" "q-32280/selection/82c79a11c5f316588a4977bf9de059017422d38604e630b6407357df3b622d75" "q-32280/selection/e791981b75ebca1b534fa7bd97fe80541770b2f8a2a0a8aff9716980d5c22a1b"] :db/ensure [:answer-field/validate]} {:db/id "q-32280" :question/id #uuid "f56cbc0a-b886-55fd-8b4c-e347c18369ea" :question/math-academy-id "q-32280" :question/problem "Find ${f}^{″}(\\pi )$ if $f(t)=[\\begin{aligned}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ 3{cos}^{2}⁡t \\\\ 4\\operatorname{sin}⁡t-5\\end{aligned}].$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n{f}^{′}(t)=[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(3{cos}^{2}⁡t)\\,\\,\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t-5)\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -6\\operatorname{cos}⁡t\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{aligned}]\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(-6\\operatorname{cos}⁡t\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)\\,\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ -6({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\ -4\\operatorname{sin}⁡t\\end{aligned}]=[\\begin{aligned}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -6\\operatorname{cos}⁡2t \\\\ -4\\operatorname{sin}⁡t\\end{aligned}]\n$$\n\nFinally, we find ${f}^{″}(\\pi )$ by substituting $t=\\pi $ into the above:\n\n$$\n{f}^{″}(\\pi )=[\\begin{aligned}-\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi  \\\\ -6\\operatorname{cos}⁡2\\pi  \\\\ -4\\operatorname{sin}⁡\\pi \\end{aligned}]=[\\begin{aligned}-(-1)-0 \\\\ -6\\cdot 1 \\\\ -4\\cdot 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -6 \\\\ 0\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32280/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-32280"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75034/selection/c34bc4b22becf0c5b9a89c13c074508d05d7da679d7a4e4d32a0e29d909cd136" :answer/id #uuid "9c3d50c3-e65d-5d7e-b70a-206f4550fe6d" :answer/type :answer.type/math :answer/value "⟨\\frac{-1}{t+1},\\,-\\frac{1}{2\\sqrt{{t}^{3}}}⟩" :db/ensure [:answer/validate]} {:db/id "q-75034/selection/4c2b173dd0d93ff6b6fe533182d575397aadad297f3e313173d8733b3b08d802" :answer/id #uuid "d73d67dd-6669-5d22-ae3d-66d87b4962d1" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{(t+1)^{2}},\\,\\frac{1}{\\sqrt{{t}^{3}}}⟩" :db/ensure [:answer/validate]} {:db/id "q-75034/selection/630a16976e222049089f48975d67269ff577d1a9b39c3c7e169ad0f786ed62af" :answer/id #uuid "a2d2b0e9-a81c-5f06-9560-dcc520d49aaa" :answer/type :answer.type/math :answer/value "⟨\\frac{-3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩" :db/ensure [:answer/validate]} {:db/id "q-75034/selection/4ac0b5e32a6026f94fd5eacda1336e8b339174621241a7edadbd1a3241c022cf" :answer/id #uuid "ea04a700-d4a1-5333-82e1-d5470f7ab098" :answer/type :answer.type/math :answer/value "⟨\\frac{-3}{t+1},\\,-\\frac{1}{2\\sqrt{t}}⟩" :db/ensure [:answer/validate]} {:db/id "q-75034/selection/35c878747a2104b41692b5df0d05b25944275fa9edd7a12731296124d72555a9" :answer/id #uuid "cd0aa54e-b500-5291-be3e-5e6deae95540" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{4\\sqrt{{t}^{3}}},\\,\\frac{-3}{(t+1)^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-75034/selection" :answer-field/id #uuid "e8de9187-2c1c-5a2d-946c-42e9d3657f57" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75034/selection/630a16976e222049089f48975d67269ff577d1a9b39c3c7e169ad0f786ed62af" :answer-field/choices ["q-75034/selection/c34bc4b22becf0c5b9a89c13c074508d05d7da679d7a4e4d32a0e29d909cd136" "q-75034/selection/4c2b173dd0d93ff6b6fe533182d575397aadad297f3e313173d8733b3b08d802" "q-75034/selection/630a16976e222049089f48975d67269ff577d1a9b39c3c7e169ad0f786ed62af" "q-75034/selection/4ac0b5e32a6026f94fd5eacda1336e8b339174621241a7edadbd1a3241c022cf" "q-75034/selection/35c878747a2104b41692b5df0d05b25944275fa9edd7a12731296124d72555a9"] :db/ensure [:answer-field/validate]} {:db/id "q-75034" :question/id #uuid "40db78a3-8e98-5f3c-8f6f-0721104f563f" :question/math-academy-id "q-75034" :question/problem "Given that $r(t)=⟨3\\operatorname{ln}⁡(t+1),\\,\\sqrt{t}⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=3\\operatorname{ln}⁡(t+1),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{3}{t+1} \\\\ {x}^{″}(t) & =-\\frac{3}{(t+1)^{2}}.\\end{aligned}\n$$\n\n- For $y(t)=\\sqrt{t},$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{1}{2\\sqrt{t}} \\\\ {y}^{″}(t) & =-\\frac{1}{4\\sqrt{{t}^{3}}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-\\frac{3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75034/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-75034"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123167/selection/4f4ae71dda81847bc18da6511ff7881d572d32e2637a03f5af4127e0ab1d9619" :answer/id #uuid "feb420f5-92f6-50f8-9f43-b14a9faed5d0" :answer/type :answer.type/math :answer/value "⟨2\\operatorname{cos}⁡t,\\,2t⟩" :db/ensure [:answer/validate]} {:db/id "q-123167/selection/6420d1b904cf3af80b95dd764bcd38232176e7868d0980c5bdb351f82db26e48" :answer/id #uuid "daa56bde-0ca1-5908-a8a5-dc39f006622f" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{cos}⁡t,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "q-123167/selection/e18c6bb5d93ea20278c3b61cab05f6af72103ed81c8cc1377c7ac88cffcbd902" :answer/id #uuid "b0918c43-5799-55a5-85a1-82fcfde2f444" :answer/type :answer.type/math :answer/value "⟨2\\operatorname{cos}⁡t,\\,t-1⟩" :db/ensure [:answer/validate]} {:db/id "q-123167/selection/739ffa918a6724e00f705eb24cd977846523713519e77f0db20008dd7605d6a9" :answer/id #uuid "b765b9fb-44c6-5bff-a7bf-d24be9b68e2b" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{sin}⁡t,\\,2t-1⟩" :db/ensure [:answer/validate]} {:db/id "q-123167/selection/4be434b931d5ffd6170e4a23f9f4e39fced449b09bd0976c32363d5db1a1b80f" :answer/id #uuid "ea0caa8a-efee-56d7-bcba-88fab2c4cc9c" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{sin}⁡t,\\,-2t⟩" :db/ensure [:answer/validate]} {:db/id "q-123167/selection" :answer-field/id #uuid "5cd48b67-6cfd-533d-b1fc-b4bc48bff2ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123167/selection/6420d1b904cf3af80b95dd764bcd38232176e7868d0980c5bdb351f82db26e48" :answer-field/choices ["q-123167/selection/4f4ae71dda81847bc18da6511ff7881d572d32e2637a03f5af4127e0ab1d9619" "q-123167/selection/6420d1b904cf3af80b95dd764bcd38232176e7868d0980c5bdb351f82db26e48" "q-123167/selection/e18c6bb5d93ea20278c3b61cab05f6af72103ed81c8cc1377c7ac88cffcbd902" "q-123167/selection/739ffa918a6724e00f705eb24cd977846523713519e77f0db20008dd7605d6a9" "q-123167/selection/4be434b931d5ffd6170e4a23f9f4e39fced449b09bd0976c32363d5db1a1b80f"] :db/ensure [:answer-field/validate]} {:db/id "q-123167" :question/id #uuid "8f7fd91d-2382-5008-942f-17ee55f68071" :question/math-academy-id "q-123167" :question/problem "Given that $r(t)=⟨2\\operatorname{cos}⁡t,\\,{t}^{2}-t⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=2\\operatorname{cos}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-2\\operatorname{sin}⁡t \\\\ {x}^{″}(t) & =-2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\n- For $y(t)={t}^{2}-t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =2t-1 \\\\ {y}^{″}(t) & =2.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-2\\operatorname{cos}⁡t,\\,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123167/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-123167"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69907/selection/4bfafc027cb9baed64f9a0e3e67104c40d2f6b60a58c4310218c575f6bc29d58" :answer/id #uuid "2e2718ae-b57e-557d-b895-ae7069cf41e9" :answer/type :answer.type/math :answer/value "9{e}^{3t+2}\\,i-4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k" :db/ensure [:answer/validate]} {:db/id "q-69907/selection/01aa59f3813069219e9ba4bce5f723767f45b6e29fe5d729f60186b50a9cdbfd" :answer/id #uuid "c6768e3e-c0e0-58f5-a6f0-c7316661b894" :answer/type :answer.type/math :answer/value "3{e}^{3t+2}\\,i+\\operatorname{cos}⁡2t\\,j-10{t}^{3}\\,k" :db/ensure [:answer/validate]} {:db/id "q-69907/selection/bed5dbdd5f5c006437e79fea30bd2ecbc4ae6282657b6df2d703a5b4ab26a980" :answer/id #uuid "fe26d7af-11cc-5520-8d93-26e93308c32b" :answer/type :answer.type/math :answer/value "9{e}^{3t+2}\\,i-\\operatorname{cos}⁡2t\\,j+20{t}^{3}\\,k" :db/ensure [:answer/validate]} {:db/id "q-69907/selection/fe8897c2737da7937704996b4e62559d12110fd754b3da9cb8887748a75c984b" :answer/id #uuid "03fdb001-9fcc-56f9-98c8-c7a5a29115d5" :answer/type :answer.type/math :answer/value "3{e}^{3t+2}\\,i+4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k" :db/ensure [:answer/validate]} {:db/id "q-69907/selection/8a059505d1cd31ecff752cdbd553de36afb4608d0747a5792cfe0f2b8a45aef1" :answer/id #uuid "6588280c-67ff-592b-a7b4-ba8e5d8a27fa" :answer/type :answer.type/math :answer/value "{e}^{3t+2}\\,i-\\operatorname{cos}⁡2t\\,j+20{t}^{3}\\,k" :db/ensure [:answer/validate]} {:db/id "q-69907/selection" :answer-field/id #uuid "d880a43d-7e0b-53bc-b672-d28bf0076e54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69907/selection/4bfafc027cb9baed64f9a0e3e67104c40d2f6b60a58c4310218c575f6bc29d58" :answer-field/choices ["q-69907/selection/4bfafc027cb9baed64f9a0e3e67104c40d2f6b60a58c4310218c575f6bc29d58" "q-69907/selection/01aa59f3813069219e9ba4bce5f723767f45b6e29fe5d729f60186b50a9cdbfd" "q-69907/selection/bed5dbdd5f5c006437e79fea30bd2ecbc4ae6282657b6df2d703a5b4ab26a980" "q-69907/selection/fe8897c2737da7937704996b4e62559d12110fd754b3da9cb8887748a75c984b" "q-69907/selection/8a059505d1cd31ecff752cdbd553de36afb4608d0747a5792cfe0f2b8a45aef1"] :db/ensure [:answer-field/validate]} {:db/id "q-69907" :question/id #uuid "5854a1fc-01c0-5fc6-8d85-2b342d3dc37f" :question/math-academy-id "q-69907" :question/problem "Find the second derivative of $f(t)={e}^{3t+2}\\,i+\\operatorname{cos}⁡2t\\,j-2{t}^{5}\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{3t+2})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(-2{t}^{5})\\,k \\\\  & =3{e}^{3t+2}\\,i+(-2\\cdot \\operatorname{sin}⁡2t)\\,j+(-2\\cdot 5{t}^{4})\\,k \\\\  & =3{e}^{3t+2}\\,i-2\\operatorname{sin}⁡2t\\,j-10{t}^{4}\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(3{e}^{3t+2})\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(-10{t}^{4})\\,k \\\\  & =3(3{e}^{3t+2})\\,i-2(2\\operatorname{cos}⁡2t)\\,j-10(4{t}^{3})\\,k \\\\  & =9{e}^{3t+2}\\,i-4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69907/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-69907"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-609"] :question/problem "Given that $\\mathbf r(t) = \\langle 10t^4 ,\\, 6\\ln t\\rangle,$ what is $\\mathbf r'\\left(\\dfrac{1}{2}\\right)?$" :question/worked-solution "We differentiate each component separately.\n\n- For the $x$-component $x(t) = 10t^4,$ we have\n\n$$\nx'(t) = 40t^3,\n$$\n\nand therefore\n\n$$\nx'\\left(\\dfrac{1}{2}\\right) = 40\\left(\\dfrac{1}{2}\\right)^3 = 5.\n$$\n\n- For the $y$-component $y(t) = 6 \\ln t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t)=\\frac{6}{t},\\end{aligned}\n$$\n\nand therefore\n\n$$\ny'\\left(\\dfrac{1}{2}\\right) = \\dfrac{6}{\\left(\\dfrac{1}{2}\\right)}=12.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(\\frac{1}{2}) & =⟨{x}^{′}(\\frac{1}{2}),\\,{y}^{′}(\\frac{1}{2})⟩ \\\\  & =⟨5,\\,12⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-2398"] :question/problem "Find the derivative of  $\\mathbf f(t) = \\langle \\sin t ,\\cos t , t \\rangle$ at $t= \\dfrac{\\pi}4.$" :question/worked-solution "First, we find $\\mathbf f'(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t,\\,1⟩\\end{aligned}\n$$\n\nNow, to compute $\\mathbf f'\\left(\\dfrac{\\pi}4\\right),$ we substitute $t=\\dfrac{\\pi}4$ into the expression for $\\mathbf f'(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =⟨\\operatorname{cos}⁡(\\frac{\\pi }{4}),\\,-\\operatorname{sin}⁡(\\frac{\\pi }{4}),\\,1⟩ \\\\  & =⟨\\frac{\\sqrt{2}}{2},\\,-\\frac{\\sqrt{2}}{2},\\,1⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-611"] :question/problem "Given that $\\mathbf r(t) = \\langle t^6,\\, t^5\\rangle,$ Calculate $\\mathbf r''(t).$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t) = t^6,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =6{t}^{5} \\\\ {x}^{″}(t) & =30{t}^{4}.\\end{aligned}\n$$\n\n- For $y(t) = t^5,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =5{t}^{4} \\\\ {y}^{″}(t) & =20{t}^{3}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨30{t}^{4},\\,20{t}^{3}⟩ \\\\  & =10⟨3{t}^{4},\\,2{t}^{3}⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
