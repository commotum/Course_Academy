51ec3f33f1" "q-34724/selection/7d56e64d898143e6a49609abbf48d1b567940aa954bca6db49d3a10f9c1b36de" "q-34724/selection/1ff27e65ed4eb6a83b0ca5893981cf5b42bc8bbd41ff5ce145dccd29423c59ce"] :db/ensure [:answer-field/validate]} {:db/id "q-34724" :question/id #uuid "7e579ce0-d5f9-57b8-931d-2fc18fc335d1" :question/math-academy-id "q-34724" :question/problem "Find the derivative of  $f(t)={e}^{t}\\operatorname{sin}⁡t\\,i+{e}^{t}\\,j+{e}^{t}\\operatorname{cos}⁡t\\,k$ at $t=\\pi .$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{cos}⁡t)\\,k \\\\  & =({e}^{t}\\operatorname{sin}⁡t+{e}^{t}\\operatorname{cos}⁡t)\\,i+{e}^{t}\\,j+({e}^{t}\\operatorname{cos}⁡t-{e}^{t}\\operatorname{sin}⁡t)\\,k\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi )$ we substitute $t=\\pi $ into the expression for ${f}^{′}(t)$:\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =({e}^{\\pi }\\operatorname{sin}⁡\\pi +{e}^{\\pi }\\operatorname{cos}⁡\\pi )\\,i+{e}^{\\pi }\\,j+({e}^{\\pi }\\operatorname{cos}⁡\\pi -{e}^{\\pi }\\operatorname{sin}⁡\\pi )\\,k \\\\  & =({e}^{\\pi }\\cdot 0+{e}^{\\pi }\\cdot (-1))\\,i+{e}^{\\pi }\\,j+({e}^{\\pi }\\cdot (-1)-{e}^{\\pi }\\cdot 0)\\,k \\\\  & =-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-34724/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee"] :knowledge-point/questions ["q-34724"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130405/selection/71261fe250ed120463ec6587c1b3ec1cf352a706b2b9fae665b68cebf2c83359" :answer/id #uuid "848e8751-d500-58e3-a7a4-d67cb8f3929e" :answer/type :answer.type/math :answer/value "3{e}^{2}\\,i-3\\,j-\\frac{1}{4}\\,k" :db/ensure [:answer/validate