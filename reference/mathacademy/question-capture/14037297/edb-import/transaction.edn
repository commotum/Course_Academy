\text{d}}{\\text{d}t}(\\operatorname{arccos}⁡3t)\\,i-\\frac{\\text{d}}{\\text{d}t}(5{t}^{4})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{{t}^{3}})\\,k \\\\  & =-\\frac{3}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32417/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee"] :knowledge-point/questions ["q-32417"] :db/ensure [:knowledge-point/validate]} {:db/id "q-50467/selection/0e628df9760c480bb117127810ab53144a3c997cb31efcc6406376d93f557030" :answer/id #uuid "f8306d7b-85f8-5c1b-a31f-d3a5e16f0087" :answer/type :answer.type/math :answer/value "⟨2\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({tan}^{2}⁡t+{sec}^{2}⁡t)⟩" :db/ensure [:answer/validate]} {:db/id "q-50467/selection/6fc65be63f6d3a634ccdbc0f53c57288a38893671225e6b719eb4747fae703ad" :answer/id #uuid "88b820fa-1a16-517f-9da7-1c476ae063dd" :answer/type :answer.type/math :answer/value "⟨2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({tan}^{2}⁡t+{sec}^{2}⁡t)⟩" :db/ensure [:answer/validate]} {:db/id "q-50467/selection/5e87a1b5fc8d2e85859b3f45fa95fc0e8c6934da61387ef73e4bad253832e5cf" :answer/id #uuid "05e9aa89-4d5c-5e02-8f43-31eb797d14c3" :answer/type :answer.type/math :answer/value "⟨2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,{sec}^{3}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-50467/selection/ddd0b1edf576b20f12ed28c9e4038a3919bf94ac7137cb5a0a1db0d63d9ed9f8" :answer/id #uuid "4e7c8b52-a41b-595d-af0d-30a2a3fc1d2b" :answer/type :answer.type/math :answer/value "⟨2\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,{sec}^{3}⁡t\\operatorname{tan}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-50467/selection/a10e0dc8d2991d839e86f27a06800c83c7ba1ad80b3475a10c8767ce5d30baca" :answer/id #uuid "40615f60-9250-598b-9235-610cc0e94635" :answer/type :answer.type/math :answer/value "⟨2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({tan}^{2}⁡t+\\operatorname{sec}⁡t)⟩" :db/ensure [:answer/validate]} {:db/id "q-50467/selection" :answer-field/id #uuid "cd690fd1-0f1b-5fc3-8cdd-13ca7633556c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50467/selection/6fc65be63f6d3a634ccdbc0f53c57288a38893671225e6b719eb4747fae703ad" :answer-field/choices ["q-50467/selection/0e628df9760c480bb117127810ab53144a3c997cb31efcc6406376d93f557030" "q-50467/selection/6fc65be63f6d3a634ccdbc0f53c57288a38893671225e6b719eb4747fae703ad" "q-50467/selection/5e87a1b5fc8d2e85859b3f45fa95fc0e8c6934da61387ef73e4bad253832e5cf" "q-50467/selection/ddd0b1edf576b20f12ed28c9e4038a3919bf94ac7137cb5a0a1db0d63d9ed9f8" "q-50467/selection/a10e0dc8d2991d839e86f27a06800c83c7ba1ad80b3475a10c8767ce5d30baca"] :db/ensure [:answer-field/validate]} {:db/id "q-50467" :question/id #uuid "7fd0a18c-43f2-5761-ad4b-96e6a87257fc" :question/math-academy-id "q-50467" :question/problem "Given that $r(t)=⟨\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{tan}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & ={sec}^{2}⁡t \\\\ {x}^{″}(t) & =2{sec}^{2}⁡t\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{sec}⁡t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\operatorname{sec}⁡t\\operatorname{tan}⁡t \\\\ {y}^{″}(t) & =\\operatorname{sec}⁡t{tan}^{2}⁡t+{sec}^{3}⁡t \\\\  & =\\operatorname{sec}⁡t({tan}^{2}⁡t+{sec}^{2}⁡t).\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨2{sec}^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({tan}^{2}⁡t+{sec}^{2}⁡t)⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-50467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540