\frac{1}{4}\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037297/state.json" "file_sha256" "4aabbe12df4d3c2905fca263a94a19a151a234d0e9b0d9ba51535c42f58475a1"} {"question" "q-77678" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037297/activity-metadata.json" "file_sha256" "122de489a2fb17360002e9d6afdd30f518ad7c477b5db46c5a5d447bad6fc548"} {"question" "q-77678" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037297/state.json" "file_sha256" "4aabbe12df4d3c2905fca263a94a19a151a234d0e9b0d9ba51535c42f58475a1"} {"question" "q-77678" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\,j-\\frac{1}{4}\\,k"] ["math" "\\,i+\\,j+\\frac{1}{2}\\,k"] ["math" "\\frac{1}{2}\\,i+2\\,j-\\frac{1}{2}\\,k"] ["math" "\\frac{1}{2}\\,i+\\,j+\\frac{1}{4}\\,k"] ["math" "\\frac{1}{2}\\,i+\\,j-\\frac{1}{4}\\,k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037297/state.json" "file_sha256" "4aabbe12df4d3c2905fca263a94a19a151a234d0e9b0d9ba51535c42f58475a1"} {"question" "q-77678" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}\\,i+\\,j-\\frac{1}{4}\\,k"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037297/state.json" "file_sha256" "4aabbe12df4d3c2905fca263a94a19a151a234d0e9b0d9ba51535c42f58475a1"} {"question" "q-32417" "field" nil "attribute" "question/problem" "value" "Find the derivative of  $f(t)=\\operatorname{arccos}⁡3t\\,i-5{t}^{4}\\,j+\\frac{2}{{t}^{3}}\\,k$ with respect to $t.$" "category" "ma_capture" 