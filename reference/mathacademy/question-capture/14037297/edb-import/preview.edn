os}⁡t\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{aligned}]\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(-6\\operatorname{cos}⁡t\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)\\,\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ -6({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\ -4\\operatorname{sin}⁡t\\end{aligned}]=[\\begin{aligned}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -6\\operatorname{cos}⁡2t \\\\ -4\\operatorname{sin}⁡t\\end{aligned}]\n$$\n\nFinally, we find ${f}^{″}(\\pi )$ by substituting $t=\\pi $ into the above:\n\n$$\n{f}^{″}(\\pi )=[\\begin{aligned}-\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi  \\\\ -6\\operatorname{cos}⁡2\\pi  \\\\ -4\\operatorname{sin}⁡\\pi \\end{aligned}]=[\\begin{aligned}-(-1)-0 \\\\ -6\\cdot 1 \\\\ -4\\cdot 0\\end{aligned}]=[\\begin{aligned}1 \\\\ -6 \\\\ 0\\end{aligned}]\n$$" 13194139534573 true] [17592186296293 1000 #edb/ref 17592186296294 13194139534573 true] [17592186296293 1000 #edb/ref 17592186296295 13194139534573 true] [17592186296293 1000 #edb/ref 17592186296296 13194139534573 true] [17592186296293 1000 #edb/ref 17592186296297 13194139534573 true] [17592186296293 1000 #edb/ref 17592186296298 13194139534573 true] [17592186296293 1040 #edb/ref 17592186045450 13194139534573 true] [17592186296293 1041 "selection" 13194139534573 true] [17592186296293 1104 #edb/ref 17592186296296 13194139534573 true] [17592186296293 1110 #uuid "e8fadb71-0f6a-5185-bb76-b05264c49d8e" 13194139534573 true] [17592186296294 1034 "[\\begin{aligned}1 \\\\ 6 \\\\ 0\\end{aligned}]" 13194139534573 true] [17592186296294 1103 #edb/ref 17592186045453 13194139534573 true] [17592186296294 1111 #uuid "febe63d1-d258-5e53-8cd7-df14721779c2" 13194139534573 true] [17592186296295 1034 "[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{ali