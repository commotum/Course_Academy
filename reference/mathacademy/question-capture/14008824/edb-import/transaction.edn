idate]} {:db/id "q-275539/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "556b4699-a3ea-5c69-88e0-00ec44a76a53" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-275539/field-1" :answer-field/id #uuid "c7167cb4-32e2-5cbc-a1bf-ff0a4c445670" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275539/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-275539/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-275539" :question/id #uuid "d3f06126-dd7a-58be-a1a3-c69ca4cf1a54" :question/math-academy-id "q-275539" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}4 \\\\ -1\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}1 & 4 \\\\ 2 & -1\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 4 \\\\ 2 & -1\\end{aligned}| \\\\  & =1\\cdot (-1)-4\\cdot 2 \\\\  & =-9\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-9\\,|=9\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275539/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408"] :knowledge-point/questions ["q-275539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320413/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ff42ca44-dc1d-5e13-99a8-a52e9d30db21" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-320413/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "6b3e234d-d2a8-5f59-8922-1eb77dd08dd9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-320413/field-1" :answer-field/id #uuid "3d19b4ca-11a1-569c-bf9c-65953d1bce47" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320413/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-320413/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-320413/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-320413" :question/id #uuid "f76f30e6-ef9b-537f-bdbc-c545f6421b50" :question/math-academy-id "q-320413" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=⟨-4,-1⟩$ and $\\text{v}=⟨6,2⟩.$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-4 & 6 \\\\ -1 & 2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-4 & 6 \\\\ -1 & 2\\end{aligned}| \\\\  & =(-4)\\cdot 2-6\\cdot (-1) \\\\  & =-8-(-6) \\\\  & =-2\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-2\\,|=2\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320413/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408"] :knowledge-point/questions ["q-320413"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320558/field-1/6cf1ba8fcecf7ff74fcb48e7f39a2cabed6551908e76b1f229ada74cff9b7d1c" :answer/id #uuid "e5669635-9956-5e62-b8d3-ebc7c9ac5b32" :answer/type :answer.type/math :answer/value "2\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "q-320558/field-1" :answer-field/id #uuid "82129578-1092-5512-bc14-e44ab2f9fbe3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320558/field-1/6cf1ba8fcecf7ff74fcb48e7f39a2cabed6551908e76b1f229ada74cff9b7d1c" :answer-field/choices ["q-320558/field-1/6cf1ba8fcecf7ff74fcb48e7f39a2cabed6551908e76b1f229ada74cff9b7d1c"] :db/ensure [:answer-field/validate]} {:db/id "q-320558" :question/id #uuid "e3d7e857-f860-5925-9b71-d1c2560557c0" :question/math-academy-id "q-320558" :question/problem "Given that the area spanned between the vectors $\\text{u}=[\\begin{aligned}-\\sqrt{7} \\\\ 5\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}a \\\\ -10\\end{aligned}]$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-\\sqrt{7} & a \\\\ 5 & -10\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-\\sqrt{7} & a \\\\ 5 & -10\\end{aligned}| \\\\  & =(-\\sqrt{7})(-10)-a\\cdot 5 \\\\  & =10\\sqrt{7}-5a\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}10\\sqrt{7}-5a & =0 \\\\ 5a & =10\\sqrt{7} \\\\ a & =2\\sqrt{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320558/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166"] :knowledge-point/questions ["q-320558"] :db/ensure [:knowledge-point/validate]}]
