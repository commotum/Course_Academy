rt{-3+7}-2}{-3+3}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -3}\\frac{\\sqrt{x+7}-2}{x+3} & ={lim}_{x\\to -3}\\frac{(\\sqrt{x+7}-2)(\\sqrt{x+7}+2)}{(x+3)(\\sqrt{x+7}+2)} \\\\  & ={lim}_{x\\to -3}\\frac{(\\sqrt{x+7})^{2}-{2}^{2}}{(x+3)(\\sqrt{x+7}+2)} \\\\  & ={lim}_{x\\to -3}\\frac{(x+7)-4}{(x+3)(\\sqrt{x+7}+2)} \\\\  & ={lim}_{x\\to -3}\\frac{x+3}{(x+3)(\\sqrt{x+7}+2)} \\\\  & ={lim}_{x\\to -3}\\frac{\\cancel{x+3}}{\\cancel{(x+3)}(\\sqrt{x+7}+2)} \\\\  & ={lim}_{x\\to -3}\\frac{1}{\\sqrt{x+7}+2} \\\\  & =\\frac{1}{\\sqrt{-3+7}+2} \\\\  & =\\frac{1}{\\sqrt{4}+2} \\\\  & =\\frac{1}{2+2} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139533898 true] [17592186264514 1000 #edb/ref 17592186264515 13194139533898 true] [17592186264514 1000 #edb/ref 17592186264516 13194139533898 true] [17592186264514 1040 #edb/ref 17592186045449 13194139533898 true] [17592186264514 1041 "field-1" 13194139533898 true] [17592186264514 1104 #edb/ref 17592186264516 13194139533898 true] [17592186264514 1110 #uuid "cb94437b-fe96-54b0-bf3f-fe8f95d05890" 13194139533898 true] [17592186264515 1034 "\\frac{1}{2}" 13194139533898 true] [17592186264515 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264515 1111 #uuid "6e309da2-8437-59fc-8ae7-12d5aa4f7bd8" 13194139533898 true] [17592186264516 1034 "\\frac{1}{4}" 13194139533898 true] [17592186264516 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264516 1111 #uuid "98e58c33-27e1-524e-a5f4-011ccf164971" 13194139533898 true] [17592186264517 1017 #edb/ref 17592186264518 13194139533898 true] [17592186264517 1089 "q-338499" 13194139533898 true] [17592186264517 1091 #edb/ref 17592186045463 13194139533898 true] [17592186264517 1100 "Evaluate the following limit:\n\n${lim}_{x\\to 64}\\frac{x-64}{\\sqrt{4x}-16}=$\n{{field-1}}" 13194139533898 true] [17592186264517 1113 #uuid "f5c72df1-9772-5859-9f99-47b53efc1e38" 13194139533898 true] [17592186264517 1145 "If we attempt to evaluate the limit by simply evaluating the function at $x=64,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 64}\\frac{x-64}{\\sqrt{4x}-16} & =\\frac{64-64}{\\sqrt{4(64)}-16}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 64}\\frac{x-64}{\\sqrt{4x}-16} & ={lim}_{x\\to 64}\\frac{(x-64)(\\sqrt{4x}+16)}{(\\sqrt{4x}-16)(\\sqrt{4x}+16)} \\\\  & ={lim}_{x\\to 64}\\frac{(x-64)(\\sqrt{4x}+16)}{(\\sqrt{4x})^{2}-{16}^{2}} \\\\  & ={lim}_{x\\to 64}\\frac{(x-64)(\\sqrt{4x}+16)}{4x-256} \\\\  & ={lim}_{x\\to 64}\\frac{(x-64)(\\sqrt{4x}+16)}{4(x-64)} \\\\  & ={lim}_{x\\to 64}\\frac{\\cancel{(x-64)}(\\sqrt{4x}+16)}{4\\cancel{(x-64)}} \\\\  & ={lim}_{x\\to 64}\\frac{\\sqrt{4x}+16}{4} \\\\  & =\\frac{\\sqrt{4(64)}+16}{4} \\\\  & =\\frac{16+16}{4} \\\\  & =\\frac{32}{4} \\\\  & =8.\\end{aligned}\n$$" 13194139533898 true] [17592186264518 1000 #edb/ref 17592186264519 13194139533898 true] [17592186264518 1040 #edb/ref 17592186045449 13194139533898 true] [17592186264518 1041 "field-1" 13194139533898 true] [17592186264518 1104 #edb/ref 17592186264519 13194139533898 true] [17592186264518 1110 #uuid "a96e2238-390d-594b-9be4-12bad99b389a" 13194139533898 true] [17592186264519 1034 "8" 13194139533898 true] [17592186264519 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264519 1111 #uuid "ce584506-2795-558d-b996-4516410cfc88" 13194139533898 true] [17592186264520 1017 #edb/ref 17592186264521 13194139533898 true] [17592186264520 1089 "q-338515" 13194139533898 true] [17592186264520 1091 #edb/ref 17592186045465 13194139533898 true] [17592186264520 1100 "Evaluate the following limit:\n\n${lim}_{z\\to 6}\\frac{z-6}{\\sqrt{3z-2}-4}=$\n{{field-1}}" 13194139533898 true] [17592186264520 1113 #uuid "4f682dc1-21d5-50c6-a843-a82f4d54fb3f" 13194139533898 true] [17592186264520 1145 "If we attempt to evaluate the limit by simply evaluating the function at $z=6,$ we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{z\\to 6}\\frac{z-6}{\\sqrt{3z-2}-4} & =\\frac{6-6}{\\sqrt{3(6)-2}-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{z\\to 6}\\frac{z-6}{\\sqrt{3z-2}-4} & ={lim}_{z\\to 6}\\frac{(z-6)(\\sqrt{3z-2}+4)}{(\\sqrt{3z-2}-4)(\\sqrt{3z-2}+4)} \\\\  & ={lim}_{z\\to 6}\\frac{(z-6)(\\sqrt{3z-2}+4)}{(\\sqrt{3z-2})^{2}-{4}^{2}} \\\\  & ={lim}_{z\\to 6}\\frac{(z-6)(\\sqrt{3z-2}+4)}{(3z-2)-16} \\\\  & ={lim}_{z\\to 6}\\frac{(z-6)(\\sqrt{3z-2}+4)}{3z-18} \\\\  & ={lim}_{z\\to 6}\\frac{(z-6)(\\sqrt{3z-2}+4)}{3(z-6)} \\\\  & ={lim}_{z\\to 6}\\frac{\\sqrt{3z-2}+4}{3} \\\\  & =\\frac{\\sqrt{3(6)-2}+4}{3} \\\\  & =\\frac{4+4}{3} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$" 13194139533898 true] [17592186264521 1000 #edb/ref 17592186264522 13194139533898 true] [17592186264521 1000 #edb/ref 17592186264523 13194139533898 true] [17592186264521 1040 #edb/ref 17592186045449 13194139533898 true] [17592186264521 1041 "field-1" 13194139533898 true] [17592186264521 1104 #edb/ref 17592186264522 13194139533898 true] [17592186264521 1110 #uuid "bc7bd336-dc82-597d-938b-ca1bda73e817" 13194139533898 true] [17592186264522 1034 "\\frac{8}{3}" 13194139533898 true] [17592186264522 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264522 1111 #uuid "e5b4e8a5-a2cc-5f7c-9777-ff4b3cf574bf" 13194139533898 true] [17592186264523 1034 "\\frac{4}{3}" 13194139533898 true] [17592186264523 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264523 1111 #uuid "a5cfa902-4e4d-535a-9d48-b74e92e2614f" 13194139533898 true] [17592186264524 1017 #edb/ref 17592186264525 13194139533898 true] [17592186264524 1089 "q-46830" 13194139533898 true] [17592186264524 1091 #edb/ref 17592186045465 13194139533898 true] [17592186264524 1100 "Evaluate ${lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3}.$" 13194139533898 true] [17592186264524 1113 #uuid "b7ad57fc-300b-5ef8-bc85-cd0a410390d4" 13194139533898 true] [17592186264524 1145 "If we attempt to evaluate the limit by simply evaluating the function at $x=4$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & =\\frac{4-4}{\\sqrt{3(4)-3}-3}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{(\\sqrt{3x-3}-3)(\\sqrt{3x-3}+3)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{{(\\sqrt{3x-3})}^{2}-{3}^{2}} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-3-9} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-12} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3(x-4)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{\\sqrt{3x-3}+3}{3} \\\\  & =\\frac{\\sqrt{3(4)-3}+3}{3} \\\\  & =\\frac{3+3}{3} \\\\  & =2.\\end{aligned}\n$$" 13194139533898 true] [17592186264525 1000 #edb/ref 17592186264526 13194139533898 true] [17592186264525 1000 #edb/ref 17592186264527 13194139533898 true] [17592186264525 1000 #edb/ref 17592186264528 13194139533898 true] [17592186264525 1000 #edb/ref 17592186264529 13194139533898 true] [17592186264525 1000 #edb/ref 17592186264530 13194139533898 true] [17592186264525 1040 #edb/ref 17592186045450 13194139533898 true] [17592186264525 1041 "selection" 13194139533898 true] [17592186264525 1104 #edb/ref 17592186264528 13194139533898 true] [17592186264525 1110 #uuid "5c40c8fa-e118-58fb-8b13-d3cdad09628e" 13194139533