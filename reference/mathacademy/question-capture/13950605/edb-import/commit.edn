2}+2)}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{{(\\sqrt{x+2})}^{2}-{2}^{2}}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x+2-4}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x-2}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{1}{(x+2)(\\sqrt{x+2}+2)} \\\\  & =\\frac{1}{(2+2)(\\sqrt{2+2}+2)} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$" 13194139533898 true] [17592186264532 1000 #edb/ref 17592186264533 13194139533898 true] [17592186264532 1000 #edb/ref 17592186264534 13194139533898 true] [17592186264532 1000 #edb/ref 17592186264535 13194139533898 true] [17592186264532 1000 #edb/ref 17592186264536 13194139533898 true] [17592186264532 1000 #edb/ref 17592186264537 13194139533898 true] [17592186264532 1040 #edb/ref 17592186045450 13194139533898 true] [17592186264532 1041 "selection" 13194139533898 true] [17592186264532 1104 #edb/ref 17592186264537 13194139533898 true] [17592186264532 1110 #uuid "846cf5ca-7696-5b32-a145-e9f822d54432" 13194139533898 true] [17592186264533 1034 "\\frac{1}{24}" 13194139533898 true] [17592186264533 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264533 1111 #uuid "8177625e-0fcd-5d78-8f77-7ad6c29a7ae2" 13194139533898 true] [17592186264534 1034 "\\frac{1}{8}" 13194139533898 true] [17592186264534 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264534 1111 #uuid "e658e508-987f-5a4f-8f2e-ec2f8203d053" 13194139533898 true] [17592186264535 1034 "\\infty " 13194139533898 true] [17592186264535 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264535 1111 #uuid "fc2e0f3a-8505-59a5-925d-db93ef752c28" 13194139533898 true] [17592186264536 1034 "\\text{DNE}" 13194139533898 true] [17592186264536 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264536 1111 #uuid "22179b09-8761-585b-871e-5bb6d504d869" 13194139533898 true] [17592186264537 1034 "\\frac{1}{16}" 13194139533898 true] [17592186264537 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264537 1111 #uuid 