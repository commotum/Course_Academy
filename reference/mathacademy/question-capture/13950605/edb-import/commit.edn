25)(x+5\\sqrt{x})} \\\\  & ={lim}_{x\\to {25}^{-}}\\frac{2({x}^{2}-{(5\\sqrt{x})}^{2})}{(x-25)(x+5\\sqrt{x})} \\\\  & ={lim}_{x\\to {25}^{-}}\\frac{2({x}^{2}-25x)}{(x-25)(x+5\\sqrt{x})} \\\\  & ={lim}_{x\\to {25}^{-}}\\frac{2x(x-25)}{(x-25)(x+5\\sqrt{x})} \\\\  & ={lim}_{x\\to {25}^{-}}\\frac{2x}{x+5\\sqrt{x}} \\\\  & =\\frac{2(25)}{25+5\\sqrt{25}} \\\\  & =1.\\end{aligned}\n$$" 13194139533898 true] [17592186264546 1000 #edb/ref 17592186264547 13194139533898 true] [17592186264546 1000 #edb/ref 17592186264548 13194139533898 true] [17592186264546 1000 #edb/ref 17592186264549 13194139533898 true] [17592186264546 1000 #edb/ref 17592186264550 13194139533898 true] [17592186264546 1000 #edb/ref 17592186264551 13194139533898 true] [17592186264546 1040 #edb/ref 17592186045450 13194139533898 true] [17592186264546 1041 "selection" 13194139533898 true] [17592186264546 1104 #edb/ref 17592186264549 13194139533898 true] [17592186264546 1110 #uuid "c3bffd14-44d5-5a70-ab62-289469c303c9" 13194139533898 true] [17592186264547 1034 "\\frac{1}{2}" 13194139533898 true] [17592186264547 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264547 1111 #uuid "4c6042be-68e6-5614-b52d-6187961da820" 13194139533898 true] [17592186264548 1034 "2" 13194139533898 true] [17592186264548 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264548 1111 #uuid "c39a0edb-c621-53b4-845d-43c733153aa0" 13194139533898 true] [17592186264549 1034 "1" 13194139533898 true] [17592186264549 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264549 1111 #uuid "d5a9454a-fd37-5f0a-94d4-516aff72fd65" 13194139533898 true] [17592186264550 1034 "\\text{DNE}" 13194139533898 true] [17592186264550 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264550 1111 #uuid "659ab017-b94c-5292-b78f-13b403f41670" 13194139533898 true] [17592186264551 1034 "0" 13194139533898 true] [17592186264551 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264551 1111 #uuid "23eb41e1-df86-5d23-b317-2c9449eb29ae" 13194139533898 true] [17592186264552 1017 #edb/ref 17592186264553 13194139533898 true] [17592186264552 1089 "q-51040" 13194139533898 true] [17592186264552 1091 #edb/ref 17592186045465 13194139533898 true] [17592186264552 1100 "Evaluate ${lim}_{x\\to 0}\\frac{\\sqrt{x+1}-1}{x}.$" 13194139533898 true] [17592186264552 1113 #uuid "b6bd49bc-86e4-5ec8-9bf9-75f8b341fe2d" 13194139533898 true] [17592186264552 1145 "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\sqrt{x+1}-1}{x} & =\\frac{\\sqrt{0+1}-1}{0}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\sqrt{x+1}-1}{x} & ={lim}_{x\\to 0}\\frac{(\\sqrt{x+1}-1)(\\sqrt{x+1}+1)}{x(\\sqrt{x+1}+1)} \\\\  & ={lim}_{x\\to 0}\\frac{{(\\sqrt{x+1})}^{2}-{1}^{2}}{x(\\sqrt{x+1}+1)} \\\\  & ={lim}_{x\\to 0}\\frac{x+1-1}{x(\\sqrt{x+1}+1)} \\\\  & ={lim}_{x\\to 0}\\frac{x}{x(\\sqrt{x+1}+1)} \\\\  & ={lim}_{x\\to 0}\\frac{1}{\\sqrt{x+1}+1} \\\\  & =\\frac{1}{\\sqrt{0+1}+1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139533898 true] [17592186264553 1000 #edb/ref 17592186264554 13194139533898 true] [17592186264553 1000 #edb/ref 17592186264555 13194139533898 true] [17592186264553 1000 #edb/ref 17592186264556 13194139533898 true] [17592186264553 1000 #edb/ref 17592186264557 13194139533898 true] [17592186264553 1000 #edb/ref 17592186264558 13194139533898 true] [17592186264553 1040 #edb/ref 17592186045450 13194139533898 true] [17592186264553 1041 "selection" 13194139533898 true] [17592186264553 1104 #edb/ref 17592186264555 13194139533898 true] [17592186264553 1110 #uuid "ba7360ea-2b42-5549-809f-306a8b78a2a3" 13194139533898 true] [17592186264554 1034 "\\infty " 13194139533898 true] [17592186264554 1103 #edb/ref 17592186045453 13194139533898 true] [17592186264554 1111 #uuid "92739