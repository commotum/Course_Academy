            "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/state.json",
            "solution_quote": "\\begin{aligned}L & ={\\int }_{-1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}({t}^{2}+1)\\text{d}t \\\\  & =(\\frac{{t}^{3}}{3}+t){|}_{-1}^{2} \\\\  & =(\\frac{{2}^{3}}{3}+2)-(\\frac{(-1)^{3}}{3}+(-1)) \\\\  & =\\frac{8}{3}+2+\\frac{1}{3}+1 \\\\  & =6.\\end{aligned}",
            "matches_worked_solution": true,
            "choice_present": true
          }
        }
      ],
