\  & =\\sqrt{16{t}^{2}} \\\\  & =4t\\end{aligned}\n$$\n\nNotice that $t>0$ for $t\\in [1,2].$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}4t\\,\\text{d}t \\\\  & =2{t}^{2}{|}_{1}^{2} \\\\  & =2(4-1) \\\\  & =6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/state.json" "file_sha256" "c5e2344e2053875a8f7044cb31a6e2aa235174b1a4bf464f5f77a2d76c1d0fa0"} {"question" "q-77220" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/activity-metadata.json" "file_sha256" "fb3a5b9af65d21b9d95c7517a0a4f98cbb9e040a8b3d6e8b495d281fedc6ff97"} {"question" "q-77220" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/state.json" "file_sha256" "c5e2344e2053875a8f7044cb31a6e2aa235174b1a4bf464f5f77a2d76c1d0fa0"} {"question" "q-77220" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "10"] ["math" "6"] ["math" "7"] ["math" "8"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/state.json" "file_sha256" "c5e2344e2053875a8f7044cb31a6e2aa235174b1a4bf464f5f77a2d76c1d0fa0"} {"question" "q-77220" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/state.json" "file_sha256" "c5e2344e2053875a8f7044cb31a6e2aa235174b1a4bf464f5f77a2d76c1d0fa0"} {"question" "q-77219" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/refer