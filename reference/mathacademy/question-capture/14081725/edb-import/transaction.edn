d6acf22dd7ecd86b006924243574345ca9ef5e730eef47" "q-64723/selection/ebcccf0ce87810160aa246cd7848a81e33e77b3a7553c74ee805a442b3311c60"] :db/ensure [:answer-field/validate]} {:db/id "q-64723" :question/id #uuid "719d5fba-71fa-5184-acdb-743568f97311" :question/math-academy-id "q-64723" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/d42e9c6ed71f06c2dec273a91d3a4cfbdf5c58095be9370285d7987d38f7b5a6.png)\n\nWhich integral  expression gives the arc length of the curve $h(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ from  $t=0$ to $t=2\\pi ?$" :question/worked-solution "First, we find ${h}^{′}(t)$ and $‖{h}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+1\\,k \\\\ ‖{h}^{′}(t)‖ & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+(1)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2\\pi }‖{h}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64723/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fc0992a-423e-5023-98d5-9d53c3b77788"] :knowledge-point/questions ["q-64723"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33857/selection/5246c8549fe862bea412db6030fef076f0169cca686a41c12ef872ce3887978a" :answer/id #uuid "2682cd05-f34e-548c-92da-7dd34da92460" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-33857/selection/753bd7c0d74f7cdaa508363d29fc1a55917d3dfbde681b489fe8aa70858086ce" :answer/id #uuid "09c4114b-2ce3-509f-8748-3e1ea5998f76" :answer/type :answer.type/math :answer/value "\\sqrt{2}{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-33857/selection/11d500003a76d3f4e03e3ffaf34ed3aabf37c91114d4bcd86ba41f50d97aafce" :answer/id #uuid "f56a565d-421d-597f-8c68-4ecd22cc4ff6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-33857/selection/409b6956845f082f998500ea9a62fa869b67cde005a9a78625348bd2123ae1f8" :answer/id #uuid "1c3dbafa-7eaa-5dca-8091-163cf82517d9" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}\\sqrt{{cos}^{2}⁡2t-{sin}^{2}⁡2t+{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-33857/selection/d53c15db21aceb62ba4322c9d29eb041ffdcde63ad5fb0efb4a39bf13c2c9625" :answer/id #uuid "18dd8168-207b-5720-b340-055e5aa420da" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-33857/selection" :answer-field/id #uuid "b9e043f1-c322-5196-86ff-10577048fa8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33857/selection/5246c8549fe862bea412db6030fef076f0169cca686a41c12ef872ce3887978a" :answer-field/choices ["q-33857/selection/5246c8549fe862bea412db6030fef076f0169cca686a41c12ef872ce3887978a" "q-33857/selection/753bd7c0d74f7cdaa508363d29fc1a55917d3dfbde681b489fe8aa70858086ce" "q-33857/selection/11d500003a76d3f4e03e3ffaf34ed3aabf37c91114d4bcd86ba41f50d97aafce" "q-33857/selection/409b6956845f082f998500ea9a62fa869b67cde005a9a78625348bd2123ae1f8" "q-33857/selection/d53c15db21aceb62ba4322c9d29eb041ffdcde63ad5fb0efb4a39bf13c2c9625"] :db/ensure [:answer-field/validate]} {:db/id "q-33857" :question/id #uuid "9bbc0eb8-8d84-56e2-8aa3-6e6ce32581ff" :question/math-academy-id "q-33857" :question/problem "Which integral  expression gives the arc length of the curve $f(t)=⟨\\operatorname{sin}⁡2t,\\operatorname{cos}⁡2t,{t}^{2}⟩$\nfrom  $t=0$ to $t=1?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,\\,-2\\operatorname{sin}⁡2t,\\,2t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(2\\operatorname{cos}⁡2t)^{2}+(-2\\operatorname{sin}⁡2t)^{2}+(2t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡2t+4{sin}^{2}⁡2t+4{t}^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡2t+{sin}^{2}⁡2t+{t}^{2})} \\\\  & =2\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{f}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{1}2\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33857/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fc0992a-423e-5023-98d5-9d53c3b77788"] :knowledge-point/questions ["q-33857"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64724/selection/15d15c7de19c75b3c2bf12550edf1c87ed75a5734c65b999ac9abfd842d1bd3f" :answer/id #uuid "7f3f71ba-ef54-5366-958b-62984409ea9f" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-64724/selection/c3b44954991390d0f8e8cfa077a9438f69dc519a3489861bd0102ac4ed50d167" :answer/id #uuid "18ebd3ba-da6b-57b8-ba8a-ce208847d91f" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-64724/selection/577b87ef3f0b91a54b7eeb0b1db68cea64fcd20b1d87c6ea09188884a1b6da15" :answer/id #uuid "60309b90-fb67-551d-8c85-52f518022235" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}\\sqrt{16{t}^{6}+9}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-64724/selection/39728c3f382e01a7398f0bb2c7de19ed8be5a2a8d23d2f0c6ee8ffa61cd6608c" :answer/id #uuid "bfde0bb5-99f2-57fd-aabe-54d0b8631eeb" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{{t}^{6}+{t}^{4}+9}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-64724/selection/475517262fcf2deebbd79c572a2b216ca84ed9fc98bb91634b2e99620a418c7c" :answer/id #uuid "ceb07095-21f5-530d-a75b-a0fad53315c2" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{8{t}^{5}+9{t}^{3}+6}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-64724/selection" :answer-field/id #uuid "1041892c-cd4a-5495-a532-87df652b85bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64724/selection/15d15c7de19c75b3c2bf12550edf1c87ed75a5734c65b999ac9abfd842d1bd3f" :answer-field/choices ["q-64724/selection/15d15c7de19c75b3c2bf12550edf1c87ed75a5734c65b999ac9abfd842d1bd3f" "q-64724/selection/c3b44954991390d0f8e8cfa077a9438f69dc519a3489861bd0102ac4ed50d167" "q-64724/selection/577b87ef3f0b91a54b7eeb0b1db68cea64fcd20b1d87c6ea09188884a1b6da15" "q-64724/selection/39728c3f382e01a7398f0bb2c7de19ed8be5a2a8d23d2f0c6ee8ffa61cd6608c" "q-64724/selection/475517262fcf2deebbd79c572a2b216ca84ed9fc98bb91634b2e99620a418c7c"] :db/ensure [:answer-field/validate]} {:db/id "q-64724" :question/id #uuid "93e74816-9928-5c75-b857-debb8b7d37d0" :question/math-academy-id "q-64724" :question/problem "Which integral expression gives the arc length of the curve $r(t)={t}^{3}\\,i+3t\\,j+{t}^{4}\\,k$ from  $t=2$ to $t=5?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(3t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{4})\\,k \\\\  & =3{t}^{2}\\,i+3\\,j+4{t}^{3}\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(3{t}^{2})^{2}+(3)^{2}+(4{t}^{3})^{2}} \\\\  & =\\sqrt{9{t}^{4}+9+16{t}^{6}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{2}^{5}‖{r}^{′}(t)‖\\,\\text{d}t={\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64724/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fc0992a-423e-5023-98d5-9d53c3b77788"] :knowledge-point/questions ["q-64724"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127585/selection/f00d8b7a5eeed0dcaa02b7f16c350647a90a461726a760f9ecdf0379dbf8fa63" :answer/id #uuid "01ed9fa1-c8dc-5157-aeec-4aca75494731" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-127585/selection/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" :answer/id #uuid "eaea0aa4-af5f-5e60-a200-0b26c23c53da" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-127585/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "f39aca7e-a3c8-560b-806c-bdc701f9ec5a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-127585/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "6856beae-0384-5fdb-a24b-5364f9fe57b4" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-127585/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6148606a-b419-5da4-8087-5071562d478e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-127585/selection" :answer-field/id #uuid "94a3a2fb-5a98-5825-9cf3-61f79671bb47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127585/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-127585/selection/f00d8b7a5eeed0dcaa02b7f16c350647a90a461726a760f9ecdf0379dbf8fa63" "q-127585/selection/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" "q-127585/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-127585/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-127585/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-127585" :question/id #uuid "1c41e24c-0b02-5456-808b-29702e52055c" :question/math-academy-id "q-127585" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/c4aa91668440687bbae4b1f85672f5cbaf7ce00d978049c7558eed99b7361d1a.png)\n\nFind the arc length of the curve $r(t)=⟨3t-{t}^{3},\\,3{t}^{2}⟩$ from $t=-1$ to $t=1.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨3-3{t}^{2},\\,6t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3-3{t}^{2})}^{2}+{(6t)}^{2}} \\\\  & =\\sqrt{9-18{t}^{2}+9{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{9{t}^{4}+18{t}^{2}+9} \\\\  & =3\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =3\\sqrt{({t}^{2}+1)^{2}} \\\\  & =3({t}^{2}+1)\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}3({t}^{2}+1)\\,\\text{d}t \\\\  & =3{\\int }_{-1}^{1}({t}^{2}+1)\\,\\text{d}t \\\\  & =3(\\frac{{t}^{3}}{3}+t){|}_{-1}^{1} \\\\  & =3(\\frac{{1}^{3}}{3}+1-[\\frac{(-1)^{3}}{3}+(-1)]) \\\\  & =3(\\frac{1}{3}+1+\\frac{1}{3}+1) \\\\  & =3(\\frac{8}{3}) \\\\  & =8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127585/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e310cbe-9d6b-5bc4-960a-8813333bc8be"] :knowledge-point/questions ["q-127585"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127602/selection/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" :answer/id #uuid "3c865a2d-09e5-5d3b-80e0-3a504ff4e99e" :answer/type :answer.type/math :answer/value "\\frac{11}{3}" :db/ensure [:answer/validate]} {:db/id "q-127602/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9267559c-62da-5abb-916c-0ff5c6123751" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-127602/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "10495939-2abf-5cdc-bb93-cfa02699e239" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-127602/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "0ffaed98-5e50-502a-822a-dbab396427fc" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-127602/selection/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" :answer/id #uuid "1d0c1590-cb77-5ed1-b4b4-6f68391f9bb9" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "q-127602/selection" :answer-field/id #uuid "8b2cd560-6ea1-5b15-9bd9-294d986283a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127602/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-127602/selection/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" "q-127602/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-127602/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-127602/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-127602/selection/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225"] :db/ensure [:answer-field/validate]} {:db/id "q-127602" :question/id #uuid "1df62e56-e883-5fdf-91e4-8c4a1c360268" :question/math-academy-id "q-127602" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/33412629fc30584cf4a1726eef7e4f23f623ae4439d25045d61e36f68914dacd.png)\n\nFind the arc length of the curve $r(t)=⟨t,\\,\\frac{1}{3}({t}^{2}+2)^{3/2}⟩$ from $t=-1$ to $t=2.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}({t}^{2}+2)^{3/2})⟩ \\\\  & =⟨1,\\,t\\sqrt{{t}^{2}+2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{1}^{2}+{(t\\sqrt{{t}^{2}+2})}^{2}} \\\\  & =\\sqrt{1+{t}^{2}({t}^{2}+2)} \\\\  & =\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =\\sqrt{({t}^{2}+1)^{2}} \\\\  & ={t}^{2}+1\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}({t}^{2}+1)\\text{d}t \\\\  & =(\\frac{{t}^{3}}{3}+t){|}_{-1}^{2} \\\\  & =(\\frac{{2}^{3}}{3}+2)-(\\frac{(-1)^{3}}{3}+(-1)) \\\\  & =\\frac{8}{3}+2+\\frac{1}{3}+1 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127602/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e310cbe-9d6b-5bc4-960a-8813333bc8be"] :knowledge-point/questions ["q-127602"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-77066"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/9b83db0bb11b8e4bbcc4b04b7bf696879d4d7f4732d6aef7d005f9da2b625526.png)\n\nFind the arc length of the curve $g(t)=⟨2{t}^{3/2},\\,3t⟩$ from $t=0$ to $t=3.$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{3/2}),\\,\\frac{\\text{d}}{\\text{d}t}(3t)⟩ \\\\  & =⟨3\\sqrt{t},\\,3⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(3\\sqrt{t})^{2}+{3}^{2}} \\\\  & =\\sqrt{9t+9} \\\\  & =3\\sqrt{t+1}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{3}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}3\\sqrt{t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}3(t+1)^{1/2}\\,\\text{d}t \\\\  & =2(t+1)^{3/2}{|}_{0}^{3} \\\\  & =16-2 \\\\  & =14.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-77220"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/2efa774a3a7e97c23f695cfbdf681b53df055b8a84b84e2729af0a565841aeb7.png)\n\nFind the arc length of the curve $r(t)=⟨\\operatorname{cos}⁡2t+2t\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡2t-2t\\operatorname{cos}⁡2t⟩$\nfrom  $t=1$ to $t=2.$" :db/ensure [:question/validate]} {:db/id "q-77219/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "a699708f-e472-5b52-ac92-0c1d5fd6c0a5" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-77219/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "92af2aa4-fb54-5a57-9073-eb3723725ecc" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-77219/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "ac5ab492-65fc-53d5-902f-033db686c641" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-77219/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "5601f2f3-faee-5726-90f8-7a766783fab1" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-77219/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "d0073190-8a9b-5654-81e4-822f934ad3ae" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-77219/selection" :answer-field/id #uuid "11a3c0e4-0114-5c81-967b-925e19f4b8d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77219/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer-field/choices ["q-77219/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" "q-77219/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" "q-77219/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-77219/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-77219/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784"] :db/ensure [:answer-field/validate]} {:db/id "q-77219" :question/id #uuid "a41921d1-8594-5fa3-8ca7-2ec902d5e059" :question/math-academy-id "q-77219" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/2324d20426a6ef6110714341f256ed3943c66d4068cdb9bd3d1763f8f528f5a1.png)\n\nFind the arc length of the curve $r(t)=⟨6t,-\\frac{3}{t}-{t}^{3}⟩$\nfrom  $t=1$ to $t=3.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{t}-{t}^{3})⟩ \\\\  & =⟨6,\\,\\frac{3}{{t}^{2}}-3{t}^{2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{6}^{2}+{(\\frac{3}{{t}^{2}}-3{t}^{2})}^{2}} \\\\  & =3\\sqrt{{2}^{2}+{(\\frac{1}{{t}^{2}}-{t}^{2})}^{2}} \\\\  & =3\\sqrt{4+\\frac{1}{{t}^{4}}-2+{t}^{4}} \\\\  & =3\\sqrt{\\frac{1}{{t}^{4}}+2+{t}^{4}} \\\\  & =3\\sqrt{{(\\frac{1}{{t}^{2}}+{t}^{2})}^{2}} \\\\  & =3(\\frac{1}{{t}^{2}}+{t}^{2})\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{3}3(\\frac{1}{{t}^{2}}+{t}^{2})\\,\\text{d}t \\\\  & =3{\\int }_{1}^{3}(\\frac{1}{{t}^{2}}+{t}^{2})\\text{d}t \\\\  & =3(-\\frac{1}{t}+\\frac{{t}^{3}}{3}){|}_{1}^{3} \\\\  & =(-\\frac{3}{t}+{t}^{3}){|}_{1}^{3} \\\\  & =(-1+27)-(-3+1) \\\\  & =28\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77219/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e310cbe-9d6b-5bc4-960a-8813333bc8be"] :knowledge-point/questions ["q-77219"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127635/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "810d1fe2-54f0-5011-bbd6-504ad832ee01" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-127635/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ecda2a41-0dd7-51fc-ac8d-3bd95987cae0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-127635/selection/53a62adc469f7106cfcc253972af70d0b351ee4c505c92859749c553ee85bd38" :answer/id #uuid "09ed347c-cf90-5b69-b821-4c6eb7883f8a" :answer/type :answer.type/math :answer/value "\\frac{11}{6}" :db/ensure [:answer/validate]} {:db/id "q-127635/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "68574972-e4da-5ce8-9829-244f93acc88b" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-127635/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "cce2d06a-3857-5e4a-82c9-78255952db4d" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-127635/selection" :answer-field/id #uuid "2b70033d-cb5e-5200-9f2e-7c95f5566b55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127635/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer-field/choices ["q-127635/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-127635/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-127635/selection/53a62adc469f7106cfcc253972af70d0b351ee4c505c92859749c553ee85bd38" "q-127635/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" "q-127635/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba"] :db/ensure [:answer-field/validate]} {:db/id "q-127635" :question/id #uuid "296a9cc9-0f93-53af-89f8-f5d81544c725" :question/math-academy-id "q-127635" :question/problem "Find the arc length of the curve $r(t)=⟨2t,\\,\\frac{1}{3}{t}^{3},\\,{t}^{2}⟩$ from $t=-1$ to $t=0.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}))⟩ \\\\  & =⟨2,\\,{t}^{2},\\,2t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(2)}^{2}+{({t}^{2})}^{2}+{(2t)}^{2}} \\\\  & =\\sqrt{{t}^{4}+4{t}^{2}+4} \\\\  & =\\sqrt{({t}^{2}+2)^{2}} \\\\  & ={t}^{2}+2\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{0}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}({t}^{2}+2)\\,\\text{d}t \\\\  & =(\\frac{1}{3}{t}^{3}+2t){|}_{-1}^{0} \\\\  & =(\\frac{{0}^{3}}{3}+2(0))-(\\frac{(-1)^{3}}{3}+2(-1)) \\\\  & =\\frac{1}{3}+2 \\\\  & =\\frac{7}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127635/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1889ba1a-09d4-5021-9ed2-3e531f8d5ef0"] :knowledge-point/questions ["q-127635"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-3063"] :question/problem "Write down the integral that gives the arc length of the curve  $\\mathbf f (t) = \\langle 3 \\sin t, \\: 2\\sin 2t \\rangle$\nfrom $t =\\dfrac {3\\pi} 2$  to $t = 2\\pi.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/574a16e843a9c81e5fc9ddbbe2c0dc2c308ffcac4991bcbf48c7f45b4871c93b.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3064"] :question/problem "Find the arc length of the curve $\\mathbf g (t) = \\langle 3 - 2 \\sin 2t, \\: 1 - 2\\cos 2t \\rangle$ from $t=\\dfrac \\pi 3$ to $\\pi.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/29c97e5963d451cc389944ef113764b2d15998448e773a02bb98c062207c2860.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6303"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081725/assets/8573aedcd26cba038b2db072560cd3d6ba7676542888a2d9b8a356713eaf6724.png)\n\nFind the arc length of the curve $\\mathbf r (t) = \\langle \\sin t ,\\: \\cos t, \\: t \\rangle$\nfrom  $t =0$ to $t = 2\\pi.$" :db/ensure [:question/validate]}]
