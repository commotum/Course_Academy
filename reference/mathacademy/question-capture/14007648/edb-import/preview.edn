 =-1+\\frac{9}{2} \\\\  & =\\frac{7}{2}.\\end{aligned}\n$$" 13194139534455 true] [17592186289283 1000 #edb/ref 17592186289284 13194139534455 true] [17592186289283 1000 #edb/ref 17592186289285 13194139534455 true] [17592186289283 1000 #edb/ref 17592186289286 13194139534455 true] [17592186289283 1000 #edb/ref 17592186289287 13194139534455 true] [17592186289283 1000 #edb/ref 17592186289288 13194139534455 true] [17592186289283 1040 #edb/ref 17592186045450 13194139534455 true] [17592186289283 1041 "selection" 13194139534455 true] [17592186289283 1104 #edb/ref 17592186289284 13194139534455 true] [17592186289283 1110 #uuid "007d62a7-55c6-5596-b950-ec735cb25f85" 13194139534455 true] [17592186289284 1034 "\\frac{7}{2}" 13194139534455 true] [17592186289284 1103 #edb/ref 17592186045453 13194139534455 true] [17592186289284 1111 #uuid "17a39a49-1c25-5567-a7fd-02caa5aaad2d" 13194139534455 true] [17592186289285 1034 "\\frac{5}{2}" 13194139534455 true] [17592186289285 1103 #edb/ref 17592186045453 13194139534455 true] [17592186289285 1111 #uuid "4b6aa3cc-e6f8-55e8-bfe8-2f4451ab5c3c" 13194139534455 true] [17592186289286 1034 "3" 13194139534455 true] [17592186289286 1103 #edb/ref 17592186045453 13194139534455 true] [17592186289286 1111 #uuid "08ac3ccc-6bf1-5eda-a26f-91669578b290" 13194139534455 true] [17592186289287 1034 "2" 13194139534455 true] [17592186289287 1103 #edb/ref 17592186045453 13194139534455 true] [17592186289287 1111 #uuid "97a6cc19-1985-55ed-a0cf-250741459888" 13194139534455 true] [17592186289288 1034 "\\frac{3}{2}" 13194139534455 true] [17592186289288 1103 #edb/ref 17592186045453 13194139534455 true] [17592186289288 1111 #uuid "8899f5f9-9427-5727-bd89-8badf73414fe" 13194139534455 true]] :edb/tempids {"q-14786" 17592186289230 "q-14786/selection" 17592186289231 "q-14786/selection/07a3540ad51bfb53d362c69b0c3835b387a5d7d769d089dc5189f608ec57d640" 17592186289232 "q-14786/selection/6ac4f212f011c45df3510df27d7693abb9e5e88d6ff82f73a10c32b6250ab3f7" 17592186289233 "q-14786/sele