" "q-71034/selection/86423235e53c8d8dc9981e6682cedf299265e0e05314e3e8a4a2ce2d2e6e0985" "q-71034/selection/7ca7a42537943f0bbb77032c140900a0ef9f5b5b605c5b34e76aec3a879d78c6" "q-71034/selection/cdacae8e20935d87e9d3d270ba9fca5f6a76c98ac48b9816045fdc991ee1aa62" "q-71034/selection/3299fd5ca020b757a35c0ef310fc47d080045d87ffea5ca6ea3da2df69ce12c2"] :db/ensure [:answer-field/validate]} {:db/id "q-71034" :question/id #uuid "0e75ca09-55e0-56a4-85df-a6bfc7789b73" :question/math-academy-id "q-71034" :question/problem "Find a parametric equation of the plane that passes through the points $L(-1,-1,1),\\,M(2,5,-3)$, and $N(0,-8,-1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =⟨2,5,-3⟩-⟨-1,-1,1⟩ \\\\  & =⟨3,6,-4⟩ \\\\ \\overset{\\to }{LN} & =⟨0,-8,-1⟩-⟨-1,-1,1⟩ \\\\  & =⟨1,-7,-2⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $l=⟨-1,-1,1⟩$ of the point $l,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =l+s\\overset{\\to }{LM}+t\\overset{\\to }{LN} \\\\ r & =⟨-1,-1,1⟩+s⟨3,6,-4⟩+t⟨1,-7,-2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71034/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa"] :knowledge-point/questions ["q-71034"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71036/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" :answer/id #uuid "af581e99-f8df-5617-85c8-cc7b5791afab" :answer/type :answer.type/text :answer/value "The plane is undefined" :db/ensure [:answer/validate]} {:db/id "q-71036/selection/e28bd7ea8651ffd2e840c3fe1117244aa57a192a6c2405dd7fc100dbc6632caf" :answer/id #uuid "8055be52-6052-5055-8660-0041ac28c2c5" :answer/type :answer.type/math :answer/value "r=⟨3,6,2⟩+s⟨2,-9,0⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71036/selection/c9008605e9ce156c28beb2b3db310c91f718617ca9a804a39e8269adb24d8c32" :answer/id #uuid "ac4ce038-a717-5c0d-b4a4-6d2f8678acad" :answer/type :answer.type/math :answer/value "r=⟨3,6,2⟩+s⟨0,-6,-1⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71036/selection/0a5b9b8b21d0263d9b25beca9a418b783955dfdf7264f95e174d23a86ee34c9c" :answer/id #uuid "2f3e43e1-3762-52bc-bf68-8e5a138ca345" :answer/type :answer.type/math :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨2,-9,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71036/selection/a68243a60e5c294d8bec37134dc6a47515bb497c4a87d7582d66da8ccb3daecd" :answer/id #uuid "52e845ba-ddb5-530f-bdd3-3435f18edd50" :answer/type :answer.type/math :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71036/selection" :answer-field/id #uuid "ec937a83-4e84-5b53-9ec3-8cafc21ea228" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71036/selection/a68243a60e5c294d8bec37134dc6a47515bb497c4a87d7582d66da8ccb3daecd" :answer-field/choices ["q-71036/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" "q-71036/selection/e28bd7ea8651ffd2e840c3fe1117244aa57a192a6c2405dd7fc100dbc6632caf" "q-71036/selection/c9008605e9ce156c28beb2b3db310c91f718617ca9a804a39e8269adb24d8c32" "q-71036/selection/0a5b9b8b21d0263d9b25beca9a418b783955dfdf7264f95e174d23a86ee34c9c" "q-71036/selection/a68243a60e5c294d8bec37134dc6a47515bb497c4a87d7582d66da8ccb3daecd"] :db/ensure [:answer-field/validate]} {:db/id "q-71036" :question/id #uuid "901f1360-df93-5e5e-ac60-c5607de4f628" :question/math-academy-id "q-71036" :question/problem "Find a parametric equation of the plane that passes through the points $P(3,6,2),\\,Q(2,-9,0)$, and $R(3,0,1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,-9,0⟩-⟨3,6,2⟩ \\\\  & =⟨-1,-15,-2⟩ \\\\ \\overset{\\to }{PR} & =⟨3,0,1⟩-⟨3,6,2⟩ \\\\  & =⟨0,-6,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨3,6,2⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71036/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa"] :knowledge-point/questions ["q-71036"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128741/selection/af1899c1483fb56fdfad61be1e2c799c99d19cfd6bbecf9b323e439904b8442a" :answer/id #uuid "883287e2-a22a-5866-9f86-3af322e4f5e8" :answer/type :answer.type/math :answer/value "r=⟨1,-2,3⟩+s⟨1,-2,-1⟩+t⟨5,3,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128741/selection/16774f0cd8cdc68a1d61a86c996652b62964291059fb3248dd77b6c302f22574" :answer/id #uuid "2296ee22-29c4-5cad-913e-95d4426da320" :answer/type :answer.type/math :answer/value "r=⟨1,-2,3⟩+s⟨2,-1,-1⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128741/selection/f700a8aa186b7f6f102003973584a6987ba587f765fe393b394327a4aab972a2" :answer/id #uuid "66ed9ad4-457c-5194-b232-9583f0a305c8" :answer/type :answer.type/math :answer/value "r=⟨1,-2,3⟩+s⟨2,-2,-1⟩+t⟨3,5,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128741/selection/c5958ede44b6aea292e26dd839aedf58ea77a5002454c8fbd62fa5dd22da27ee" :answer/id #uuid "f27b04e6-394d-5f9a-9844-f6c14698c3ab" :answer/type :answer.type/math :answer/value "r=⟨1,-2,3⟩+s⟨2,-1,-2⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128741/selection/c99f0086446afe8895cf10c4db00f5dbb16cb12ff5cb172baeab6eac801dec74" :answer/id #uuid "1ee9aec9-fb7e-5250-ace8-f082136c792a" :answer/type :answer.type/math :answer/value "r=⟨1,-2,3⟩+s⟨2,1,2⟩+t⟨-3,1,5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128741/selection" :answer-field/id #uuid "d767602d-d48d-597f-988f-cbe8628ba9a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128741/selection/f700a8aa186b7f6f102003973584a6987ba587f765fe393b394327a4aab972a2" :answer-field/choices ["q-128741/selection/af1899c1483fb56fdfad61be1e2c799c99d19cfd6bbecf9b323e439904b8442a" "q-128741/selection/16774f0cd8cdc68a1d61a86c996652b62964291059fb3248dd77b6c302f22574" "q-128741/selection/f700a8aa186b7f6f102003973584a6987ba587f765fe393b394327a4aab972a2" "q-128741/selection/c5958ede44b6aea292e26dd839aedf58ea77a5002454c8fbd62fa5dd22da27ee" "q-128741/selection/c99f0086446afe8895cf10c4db00f5dbb16cb12ff5cb172baeab6eac801dec74"] :db/ensure [:answer-field/validate]} {:db/id "q-128741" :question/id #uuid "d8ae8a52-91d4-5f03-bbaf-4e5a85108c69" :question/math-academy-id "q-128741" :question/problem "Find a parametric equation of the plane that passes through the points $P(1,-2,3),\\,Q(3,-4,2),$ and $R(4,3,2).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-4,2⟩-⟨1,-2,3⟩ \\\\  & =⟨2,-2,-1⟩ \\\\ \\overset{\\to }{PR} & =⟨4,3,2⟩-⟨1,-2,3⟩ \\\\  & =⟨3,5,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨1,-2,3⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨1,-2,3⟩+s⟨2,-2,-1⟩+t⟨3,5,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-128741/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa"] :knowledge-point/questions ["q-128741"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71038/selection/96aa106b19bbb400222a8a5cb194bc6faaf9c8a91ffeaa17fca70190be2c1baa" :answer/id #uuid "92a30e6a-10ef-5725-86a1-a00f807a8509" :answer/type :answer.type/math :answer/value "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71038/selection/aac6e859d96d4323a13843a36edb28c330b975fa4013ae2a1bddde3950910c6a" :answer/id #uuid "90b03145-1cac-56ad-865e-5c67e0a740a2" :answer/type :answer.type/math :answer/value "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71038/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" :answer/id #uuid "141c5393-b7dc-5eba-bda8-0021b6661837" :answer/type :answer.type/text :answer/value "The plane is undefined" :db/ensure [:answer/validate]} {:db/id "q-71038/selection/4c683d021f71afdd65f3fbc0dfa1616e0565b12f8de5e902fa50a6ed99adaebb" :answer/id #uuid "fe8c7179-84ca-55c7-a95a-71bf236b37f4" :answer/type :answer.type/math :answer/value "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71038/selection/0bb2344a25d3964c4aa8d06d1326685e75322a01a98435f3c410e09ba54edf83" :answer/id #uuid "f606e85e-cff2-5a26-8299-f11bc5f1cbe7" :answer/type :answer.type/math :answer/value "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-71038/selection" :answer-field/id #uuid "8020178d-97d0-5144-83d9-bbe3df22d8c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71038/selection/aac6e859d96d4323a13843a36edb28c330b975fa4013ae2a1bddde3950910c6a" :answer-field/choices ["q-71038/selection/96aa106b19bbb400222a8a5cb194bc6faaf9c8a91ffeaa17fca70190be2c1baa" "q-71038/selection/aac6e859d96d4323a13843a36edb28c330b975fa4013ae2a1bddde3950910c6a" "q-71038/selection/21c23afb400b5ecde4e1b3eb66e299e52cada41d68e41227ea75e59a02ad68a8" "q-71038/selection/4c683d021f71afdd65f3fbc0dfa1616e0565b12f8de5e902fa50a6ed99adaebb" "q-71038/selection/0bb2344a25d3964c4aa8d06d1326685e75322a01a98435f3c410e09ba54edf83"] :db/ensure [:answer-field/validate]} {:db/id "q-71038" :question/id #uuid "db707fa9-1d8f-50b6-afa1-0508b2bf8ad5" :question/math-academy-id "q-71038" :question/problem "Find a parametric equation of the plane that passes through the points $U(2,-1,0),\\,V(3,4,-3)$, and $W(2,0,0).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{UV}$ and $\\overset{\\to }{UW},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨3,4,-3⟩-⟨2,-1,0⟩ \\\\  & =⟨1,5,-3⟩ \\\\ \\overset{\\to }{UW} & =⟨2,0,0⟩-⟨2,-1,0⟩ \\\\  & =⟨0,1,0⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨2,-1,0⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+s\\overset{\\to }{UV}+t\\overset{\\to }{UW} \\\\ r & =⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71038/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa"] :knowledge-point/questions ["q-71038"] :db/ensure [:knowledge-point/validate]}]
