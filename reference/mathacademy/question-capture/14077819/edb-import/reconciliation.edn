2⟩ \\\\  & =⟨0,-6,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨3,6,2⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71036" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/activity-metadata.json" "file_sha256" "bac8017a7b1f2806a0606b007b551ced5b2fcb760a3ff30eee3030fcbab782b0"} {"question" "q-71036" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71036" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨2,-9,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨3,6,2⟩+s⟨0,-6,-1⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨3,6,2⟩+s⟨2,-9,0⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["text" "The plane is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71036" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128760" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the points $U(5,3,1)$ and $V(2,-1,-3),$ and is parallel to the vector $v=⟨-4,2,6⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128760" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find two vectors that are parallel to the plane (but not to each other). We already have one vector $v=⟨-4,2,6⟩.$ Let's also use the displacement vector $\\overset{\\to }{UV}$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨2,-1,-3⟩-⟨5,3,1⟩ \\\\  & =⟨-3,-4,-4⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨5,3,1⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+sv+t\\overset{\\to }{UV} \\\\ r & =⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128760" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/activity-metadata.json" "file_sha256" "bac8017a7b1f2806a0606b007b551ced5b2fcb760a3ff30eee3030fcbab782b0"} {"question" "q-128760" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128760" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,4,-3⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨5,3,1⟩+s⟨-6,2,4⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨5,3,1⟩+s⟨-6,4,2⟩+t⟨4,-4,-3⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨5,3,1⟩+s⟨4,2,6⟩+t⟨-4,-3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128760" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "r=⟨5,3,1⟩+s⟨-4,2,6⟩+t⟨-3,-4,-4⟩,\\,s,t\\in (-\\infty ,\\infty )"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128741" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the points $P(1,-2,3),\\,Q(3,-4,2),$ and $R(4,3,2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128741" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨3,-4,2⟩-⟨1,-2,3⟩ \\\\  & =⟨2,-2,-1⟩ \\\\ \\overset{\\to }{PR} & =⟨4,3,2⟩-⟨1,-2,3⟩ \\\\  & =⟨3,5,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨1,-2,3⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨1,-2,3⟩+s⟨2,-2,-1⟩+t⟨3,5,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128741" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/activity-metadata.json" "file_sha256" "bac8017a7b1f2806a0606b007b551ced5b2fcb760a3ff30eee3030fcbab782b0"} {"question" "q-128741" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128741" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=⟨1,-2,3⟩+s⟨1,-2,-1⟩+t⟨5,3,-1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨1,-2,3⟩+s⟨2,-1,-1⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨1,-2,3⟩+s⟨2,-1,-2⟩+t⟨3,5,1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨1,-2,3⟩+s⟨2,-2,-1⟩+t⟨3,5,-1⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨1,-2,3⟩+s⟨2,1,2⟩+t⟨-3,1,5⟩,\\,s,t\\in (-\\infty ,\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-128741" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "r=⟨1,-2,3⟩+s⟨2,-2,-1⟩+t⟨3,5,-1⟩,\\,s,t\\in (-\\infty ,\\infty )"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71038" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the points $U(2,-1,0),\\,V(3,4,-3)$, and $W(2,0,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71038" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{UV}$ and $\\overset{\\to }{UW},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =⟨3,4,-3⟩-⟨2,-1,0⟩ \\\\  & =⟨1,5,-3⟩ \\\\ \\overset{\\to }{UW} & =⟨2,0,0⟩-⟨2,-1,0⟩ \\\\  & =⟨0,1,0⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $u=⟨2,-1,0⟩$ of the point $U,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =u+s\\overset{\\to }{UV}+t\\overset{\\to }{UW} \\\\ r & =⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71038" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/activity-metadata.json" "file_sha256" "bac8017a7b1f2806a0606b007b551ced5b2fcb760a3ff30eee3030fcbab782b0"} {"question" "q-71038" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71038" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["math" "r=⟨2,-1,0⟩+s⟨3,4,-3⟩+t⟨2,0,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] ["text" "The plane is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "q-71038" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "r=⟨2,-1,0⟩+s⟨1,5,-3⟩+t⟨0,1,0⟩,\\,s,t\\in (-\\infty ,\\infty )"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/state.json" "file_sha256" "d526e2393a1241fb2502cebde1d4789dafbd406b3bdda2fe62cfc9e3da8b67a7"} {"question" "e-4940" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the point $P(-3,2,5)$ and is parallel to the vectors $\\mathbf{b}= \\langle 17,3,15 \\rangle$  and $\\mathbf{c}= \\langle 5,0,-8 \\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4940.json" "file_sha256" "0f4a5a9dfbca4e0ee94ec3d28b13cc72601c01b2145f5184d21ac48d32111a27"} {"question" "e-4940" "field" nil "attribute" "question/worked-solution" "value" "A parametric equation of a plane is given by \n\n$$\n\\mathbf{r}=\\mathbf{p}+ s\\mathbf{b}+ t \\mathbf{c},\n$$\n\nwhere $\\mathbf{p}$ is the position vector of a point on the plane and the vectors $\\mathbf{b}$ and $\\mathbf{c}$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $P$ is $\\mathbf{p}=\\langle -3,2,5 \\rangle,$ and the two vectors that are parallel to the plane (but not to each other) are $\\mathbf{b}= \\langle 17,3,15 \\rangle$ and $\\mathbf{c}= \\langle 5,0,-8 \\rangle.$\n\nSo, a parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =⟨-3,2,5⟩+s\\,⟨17,3,15⟩+t\\,⟨5,0,-8⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4940.json" "file_sha256" "0f4a5a9dfbca4e0ee94ec3d28b13cc72601c01b2145f5184d21ac48d32111a27"} {"question" "e-5884" "field" nil "attribute" "question/problem" "value" "Find a normal vector to the plane \n\n$$\n\\mathbf{r}= \\langle -6,3, 2 \\rangle + t \\langle 4, 2, -1 \\rangle + s \\langle 4, -3, 2 \\rangle,\\qquad t,\\,s \\in (-\\infty,\\infty).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-5884.json" "file_sha256" "7c75dbabc368c132f470e92b2d6a4c812871307a8fae77592fe27c34b54b2b70"} {"question" "e-5884" "field" nil "attribute" "question/worked-solution" "value" "From the parametric equation, we have that $\\mathbf{v} = \\langle 4, 2, -1 \\rangle$ and $\\mathbf{w} = \\langle 4, -3, 2 \\rangle$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $\\mathbf{v}$ and $\\mathbf{w}$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}4 \\\\ 2 \\\\ -1\\end{aligned}]\\times [\\begin{aligned}4 \\\\ -3 \\\\ 2\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ 4 & -3 & 2\\end{aligned}\\right| \\\\  & =i-12j-20k \\\\  & =⟨1,-12,-20⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $\\mathbf{n}=\\langle 1, -12, -20 \\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-5884.json" "file_sha256" "7c75dbabc368c132f470e92b2d6a4c812871307a8fae77592fe27c34b54b2b70"} {"question" "e-4941" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the point $C(2,50,-19)$ and is parallel to the lines $\\mathbf{r}= \\langle 2,\\sqrt{6},17 \\rangle + s \\langle -1,7,2 \\rangle$ and $\\mathbf{r}= \\langle 20,-44, 27 \\rangle + t \\langle 2\\sqrt{3},9,-8 \\rangle$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4941.json" "file_sha256" "f45f164cd323edb01de11e0020b8711625a174d76a373829d04981efba8bd8ad"} {"question" "e-4941" "field" nil "attribute" "question/worked-solution" "value" "The direction vectors of the lines are $\\mathbf{v_1}=\\langle  -1,7,2  \\rangle$ and $\\mathbf{v_2}=\\langle 2\\sqrt{3},9,-8 \\rangle$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $C(2,50,-19)$ lies on the plane and its position vector is $\\mathbf{c}=\\langle 2,50,-19 \\rangle.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+s{v}_{1}+t{v}_{2} \\\\ r & =⟨2,50,-19⟩+s\\,⟨-1,7,2⟩+t\\,⟨2\\sqrt{3},9,-8⟩,\\,s,t\\in (-\\infty ,\\infty )\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4941.json" "file_sha256" "f45f164cd323edb01de11e0020b8711625a174d76a373829d04981efba8bd8ad"} {"question" "e-4942" "field" nil "attribute" "question/problem" "value" "Find a parametric equation of the plane that passes through the points $A(-1,4,-3),$ $B(7,5,4),$ and $C(2,-2,8).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4942.json" "file_sha256" "266baf37ed8be00252cb39c068f1f2aba3a388eb15e8f42f8839dddd4cdf1068"} {"question" "e-4942" "field" nil "attribute" "question/worked-solution" "value" "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨7,5,4⟩-⟨-1,4,-3⟩ \\\\  & =⟨8,1,7⟩ \\\\ \\overset{\\to }{AC} & =⟨2,-2,8⟩-⟨-1,4,-3⟩ \\\\  & =⟨3,-6,11⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $\\mathbf{a}=\\langle -1,4,-3 \\rangle$ of the point $A,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s\\overset{\\to }{AB}+t\\overset{\\to }{AC} \\\\ r & =⟨-1,4,-3⟩+s⟨8,1,7⟩+t⟨3,-6,11⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\n**Watch out!** The form of the final equation depends on our choice of vectors and the point on the plane. We could have picked other vectors. Likewise, we could have chosen $B$ or $C$ instead of $A$ as our point on the plane. So, the answer is *not unique*!" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077819/example-4942.json" "file_sha256" "266baf37ed8be00252cb39c068f1f2aba3a388eb15e8f42f8839dddd4cdf1068"}] "usage" {"q-33818" [] "q-33819" [] "e-4941" [] "q-70972" [] "q-33158" [] "e-4940" [] "q-70969" [] "q-128760" [] "q-70978" [] "e-5884" [] "q-128501" [] "q-128467" [] "e-4942" [] "q-33822" []} "basis" 2808 "retractions" [[17592186120211 :question/problem "Find a normal vector to the plane\n\n$r = ⟨2, 0,-1⟩ + t⟨ - 2,-7, 5⟩ + s⟨2, 12, 5⟩, t, s ∈ (- ∞, ∞)$."] [17592186120169 :question/problem "Find a parametric equation of the plane that passes through the point $B(-2, 23, 14)$ and is parallel to the lines $r = ⟨ - 3, 5, 1⟩ + s⟨ - 3, 5, 4⟩$ and $r = ⟨ - 30, 55, 25⟩ + t⟨4, 7,-1⟩$."]] "immutable