7e917b2f2dc3ff90ccb2c435764c9ebef2dea263cc318e0c231eb7eeb1d" "q-136639/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-136639/selection/1f5b353af7cbb90a89e4a07f196cff5b0ba27d9934d00e9a38de61eff80108f7" "q-136639/selection/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" "q-136639/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e"] :db/ensure [:answer-field/validate]} {:db/id "q-136639" :question/id #uuid "43f38354-d453-5a54-bedd-c97200da2de6" :question/math-academy-id "q-136639" :question/is-example false :question/problem "If $tan⁡a=\\frac{4}{5},$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933873/assets/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-\\frac{4}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136639/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7"] :knowledge-point/questions ["q-136639"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158046/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "157f0816-893e-5932-b514-0192d3b68646" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-158046/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" :answer/id #uuid "c1e6cf9f-c1ae-5769-a71d-df1788898d95" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-158046/selection/e29b8dc9fff8bfe59222ba8d842daa54fb0f5efdfe5440d77e5ec66eb4dca239" :answer/id #uuid "9e9d5c41-1c3c-5f72-aed0-00655708ae51" :answer/type :answer.type/math :answer/value "\\pi +\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-158046/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8dace757-b9ec-56f2-9400-1269df92064b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-158046/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b" :answer/id #uuid "3f4b4477-660e-5714-b505-d0a25a2344b3" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-158046/selection" :answer-field/id #uuid "5a16fdac-8762-505c-a542-af7c74cd4100" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158046/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-158046/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-158046/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" "q-158046/selection/e29b8dc9fff8bfe59222ba8d842daa54fb0f5efdfe5440d77e5ec66eb4dca239" "q-158046/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-158046/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b"] :db/ensure [:answer-field/validate]} {:db/id "q-158046" :question/id #uuid "e8566090-d643-5dbe-8765-e92369416700" :question/math-academy-id "q-158046" :question/is-example false :question/problem "If $tan⁡x=-2,$ then $\\frac{3}{5}tan⁡(-x-7\\pi )+\\frac{4}{5}=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933873/assets/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nFrom the graph, we note the following:\n\n- The period of $tan⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $tan⁡x,$ we have\n\n$$\n\\begin{aligned}tan⁡(-x-7\\pi ) & =tan⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $tan⁡x,$ we have\n\n$$\n\\begin{aligned}tan⁡(-x) & =-tan⁡x \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{3}{5}tan⁡(-x-7\\pi )+\\frac{4}{5} & =\\frac{3}{5}\\cdot 2+\\frac{4}{5} \\\\  & =\\frac{6}{5}+\\frac{4}{5} \\\\  & =\\frac{10}{5} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-158046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7"] :knowledge-point/questions ["q-158046"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-136548"] :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933873/assets/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-158038/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "053cecc9-7f20-53ff-9e9a-94dce16ff772" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-158038/selection/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" :answer/id #uuid 