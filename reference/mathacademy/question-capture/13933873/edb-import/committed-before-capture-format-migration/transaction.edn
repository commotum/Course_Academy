873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-x) & =-tan⁡x \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158038/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7"] :knowledge-point/questions ["q-158038"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158041/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "8a139043-4a92-5b9a-b86c-7c070005be47" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-158041/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "f9c374c9-b095-5e2c-bc39-0efbed8aa6c0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-158041/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "0091aa30-09bf-5a3f-9b92-18ff012af49d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-158041/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6aa2314b-8077-5f5e-aaa8-24f8fe179acb" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-158041/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "2fe09367-8d58-5cdb-931e-810c1b9b1988" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-158041/selection" :answer-field/id #uuid "37b92d9e-62b7-5ad8-891c-381fd78cc8b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158041/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-158041/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-158041/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-158041/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-158041/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-158041/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-158041" :question/id #uuid "6beda82e-a20a-5d58-a4e3-3ff246d0aab0" :question/math-academy-id "q-158041" :question/is-example false :question/problem "If $tan⁡x=-4,$ then $\\frac{1}{2}tan⁡(-x+3\\pi )+3=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933873/assets/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nFrom the graph, we note the following:\n\n- The period of $tan⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $tan⁡x,$ we have\n\n$$\n\\begin{aligned}tan⁡(-x+3\\pi ) & =tan⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $tan⁡x,$ we have\n\n$$\n\\begin{aligned}tan⁡(-x) & =-tan⁡x \\\\  & =-(-4) \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}tan⁡(-x+3\\pi )+3 & =\\frac{1}{2}\\cdot 4+3 \\\\  & =\\frac{4}{2}+3 \\\\  & =2+3 \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-158041/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7"] :knowledge-point/questions ["q-158041"] :db/ensure [:knowledge-point/validate]}]
