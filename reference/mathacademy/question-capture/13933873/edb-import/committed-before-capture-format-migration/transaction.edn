5e28726f38f15ccb41f44d3f" "q-66594/selection/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" "q-66594/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-66594" :question/id #uuid "022c6c58-a2d3-57ca-999d-54e67f40fd2a" :question/math-academy-id "q-66594" :question/is-example false :question/problem "If $tan⁡x=\\sqrt{3},$ for some $x$, find the value of $tan⁡(x-5\\pi ).$" :question/worked-solution "The period of $y=tan⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ntan⁡x=tan⁡(x+n\\pi ).\n$$\n\nSubstituting $n=-5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}tan⁡x=tan⁡(x+(-5)\\cdot \\pi )=tan⁡(x-5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $tan⁡x=\\sqrt{3},$ we get that $tan⁡(x-5\\pi )=\\sqrt{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66594/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe"] :knowledge-point/questions ["q-66594"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70998/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2f3c2a7d-d53e-53f5-aa7e-30ddc1281d5a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-70998/selection/8b0da25323387be7cd3dda381ee4e2ebbdc8b10be241bc2e3eeead0da24f888a" :answer/id #uuid "e0bb51a4-37b4-5012-aebc-26f7dca082a7" :answer/type :answer.type/math :answer/value "5\\pi " :db/ensure [:answer/validate]} {:db/id "q-70998/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0bdaa1a6-0ad9-5cbf-b467-296fec6d9591" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-70998/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "09290c50-7d58-5923-9413-31a0976cd14b" :answer/type :answer.type/math :answer/value "-