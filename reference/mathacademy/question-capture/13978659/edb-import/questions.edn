#{[{:db/id #edb/ref 17592186100609 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/id #uuid "f7868f7f-b296-5a38-9af6-61dc4d1198a7" :question/math-academy-id "e-4408" :question/problem "Calculate the product $I_3 B$ given that $I_3$ is the $3 \\times 3$ identity matrix and\n$\\begin{bmatrix}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{bmatrix}$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $I_3$ is a $3 \\times 3$ matrix and $B$ is a $3 \\times 3$ matrix too.\n\nTherefore, the multiplication is well defined and\n$\\begin{bmatrix}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186100610 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/id #uuid "9832238f-baff-5527-a11a-c65b6529cb0b" :question/math-academy-id "e-4410" :question/problem "Calculate the product $C D$, if\n$\\begin{bmatrix}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{bmatrix}$\nand\n$\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}$" :question/worked-solution "Notice that $D$ is the $2$nd *column* of the identity matrix $I_3$.\n\nSince we're multiplying the $3\\times 3$ matrix $C$ by the $2$nd *column* of the identity matrix $I_3$, the result must be the $2$nd *column* of $C$. Therefore,\n\n$$\n\\begin{bmatrix}1 \\\\ 1 \\\\ 4\\end{bmatrix}\n$$\n\nDon't believe it? Let's check the long way:\n\n$$\n\\begin{aligned}\nCD &= \\begin{bmatrix}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 \\cdot 0 + 1 \\cdot 1 + 0 \\cdot 0 \\\\ -1 \\cdot 0 + 1 \\cdot 1 + (-4) \\cdot 0 \\\\ 5 \\cdot 0 + 4 \\cdot 1 + (-2) \\cdot 0\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 \\\\ 1 \\\\ 4\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101054 :knowledge-point/_questions [{:knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8561cf7d-5905-51f0-afa8-dfa160c2a666" :answer/type {:db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186098095} {:answer/id #uuid "9d75e31c-6d5f-5ff7-bfb7-9af46b05c952" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098096} {:answer/id #uuid "b04ab11c-1e23-5a8a-ace9-0a5b7e812fa6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186098097} {:answer/id #uuid "d9147d52-f2e7-5bda-9f5b-fe0aae8f7137" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098098} {:answer/id #uuid "730c731f-1318-55a0-8381-b58852458731" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098099}] :answer-field/correct {:answer/id #uuid "730c731f-1318-55a0-8381-b58852458731" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098099} :answer-field/id #uuid "eb3b92a3-f788-5f9e-bc32-c27df022209b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098094}] :question/id #uuid "612ed9a2-f644-5c99-b797-cab8e5ee69a6" :question/math-academy-id "q-13762" :question/problem "Calculate the product $I_{2}B$ given that $I_{2}$ is the $2 \\cdot 2$ identity matrix and\n\n$B = \\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186101315 :knowledge-point/_questions [{:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a95370d-414b-5eac-8919-246de33eac09" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 2\\sqrt{5} & -2.5\\end{bmatrix}" :db/id #edb/ref 17592186099487} {:answer/id #uuid "a84bcb4e-521f-5ea1-9075-3e249dbed932" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5 \\\\ -2.5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186099488} {:answer/id #uuid "e006e13f-10ad-5b98-98da-0e4073b443c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\sqrt{5} \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186099489} {:answer/id #uuid "2c32ad2d-131b-5f58-b76f-c00ad96820b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186099490} {:answer/id #uuid "695edc9d-dd29-5f2a-b8fd-06ab5abd1f2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5\\end{bmatrix}" :db/id #edb/ref 17592186099491}] :answer-field/correct {:answer/id #uuid "2c32ad2d-131b-5f58-b76f-c00ad96820b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186099490} :answer-field/id #uuid "954dd7be-0875-59ee-8cb2-ab4ad7d267c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099486}] :question/id #uuid "bde0cdd0-7dbe-5ba4-9b36-e66cfe099501" :question/math-academy-id "q-41949" :question/problem "Find the product $AB$, if\n\n$A = \\begin{bmatrix}2\\sqrt{7} & -3 & 3.5 \\\\ -2 & 2\\sqrt{5} & -2.5 \\\\ \\sqrt{3} & 4 & 5\\end{bmatrix}$\nand\n$B = \\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}$."}]}
