1+(-3)\\cdot 0+3.5\\cdot 0 \\\\ (-2)\\cdot 1+2\\sqrt{5}\\cdot 0+(-2.5)\\cdot 0 \\\\ \\sqrt{3}\\cdot 1+4\\cdot 0+5\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-41944/selection/7b026bb6ce4c703a41a0a36765ff9205dc985fd12edf1a5ca336ece368b73952" :answer/id #uuid "bbd472d0-73ef-50e9-855a-0399cfed9979" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\sqrt{5} & 4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41944/selection/8b54f488aa757cc952ac43c603ee2c6ca7a5c3d04ea205b1ffc769dfd2a08c7f" :answer/id #uuid "4460027c-0c38-5e6a-8d86-3dc9b9c03c6b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41944/selection/1062dfbfcbbd474d42296285e868f40164d04ba20865fa6faee1e67869dfb418" :answer/id #uuid "5d130fa2-0493-59f0-af50-5160da776d28" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & -\\sqrt{3}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41944/selection/f0c015c7afbfcbede89e75007ba609939f126628e950d07ff2915d37319768ba" :answer/id #uuid "3d480acf-3659-5c9e-a0aa-59046b467d2b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 2\\sqrt{2} \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41944/selection/64ff85b91fc0ff67a699b4a8d326acf2844a938b108a4dc94a860946d2180819" :answer/id #uuid "51168f06-2e01-5b0b-8693-e06b3de9dde2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\sqrt{5} \\\\ -3 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41944/selection" :answer-field/id #uuid "d5abea32-c0b7-548b-8c88-75fbbdda6178" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-41944/selection/8b54f488aa757cc952ac43c603ee2c6ca7a5c3d04ea205b1ffc769dfd2a08c7f" :answer-field/choices ["q-41944/selection/7b026bb6ce4c703a41a0a36765ff9205dc985fd12edf1a5ca336ece368b73952" "q-41944/selection/8b54f488aa757cc952ac43c603ee2c6ca7a5c3d04ea205b1ffc769dfd2a08c7f" "q-41944/selection/1062dfbfcbbd474d42296285e868f40164d04ba20865fa6faee1e67869dfb418" "q-41944/selection/f0c015c7afbfcbede89e75007ba609939f126628e950d07ff2915d37319768ba" "q-41944/selection/64ff85b91fc0ff67a699b4a8d326acf2844a938b108a4dc94a860946d2180819"] :db/ensure [:answer-field/validate]} {:db/id "q-41944" :question/id #uuid "c7963c06-fa30-5a29-ac72-ec8ff733ff33" :question/math-academy-id "q-41944" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}0 & 1 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}].$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 & 0\\end{aligned}][\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-41944/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee"] :knowledge-point/questions ["q-41944"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4408"] :question/problem "Calculate the product $I_3 B$ given that $I_3$ is the $3 \\times 3$ identity matrix and\n$[\\begin{aligned}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{aligned}]$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix $I_3$ is a $3 \\times 3$ matrix and $B$ is a $3 \\times 3$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n[\\begin{aligned}2 & 3 & -1 \\\\ 5 & 2 & 7 \\\\ 0 & 4 & 6\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4410"] :question/problem "Calculate the product $C D,$ if\n$[\\begin{aligned}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{aligned}]$\nand \n$[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]$" :question/worked-solution "Notice that $D$ is the $2$nd *column* of the identity matrix $I_3.$\n\nSince we're multiplying the $3\\times 3$ matrix $C$ by the $2$nd *column* of the identity matrix $I_3,$ the result must be the $2$nd *column* of $C.$ Therefore,\n\n$$\n[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}]\n$$\n\nDon't believe it? Let's check the long way:\n\n$$\n\\begin{aligned}CD & =[\\begin{aligned}2 & 1 & 0 \\\\ -1 & 1 & -4 \\\\ 5 & 4 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 0+1\\cdot 1+0\\cdot 0 \\\\ -1\\cdot 0+1\\cdot 1+(-4)\\cdot 0 \\\\ 5\\cdot 0+4\\cdot 1+(-2)\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
