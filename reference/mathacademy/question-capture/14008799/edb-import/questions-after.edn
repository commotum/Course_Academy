#{[{:db/id #edb/ref 17592186289074 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77fa05a0-065f-55e0-8772-10a5bc27239c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289076} {:answer/id #uuid "6a91d886-93d0-55d4-8332-e22191fabdbd" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186289077} {:answer/id #uuid "20089555-b2b4-5881-a546-c245548b5d8e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289078} {:answer/id #uuid "c1f0d6d2-2f1c-5b64-ac9e-f8c29191a81e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289079} {:answer/id #uuid "74990dcd-b63e-5bb8-9b9e-0d439fcabe1d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289080}] :answer-field/correct {:answer/id #uuid "c1f0d6d2-2f1c-5b64-ac9e-f8c29191a81e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289079} :answer-field/id #uuid "6cbf946a-6bde-519f-b590-8ddb36f996c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289075}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "49eb189d-dbb6-571c-b92b-059f64da6668" :question/math-academy-id "q-10972" :question/problem "Given that\n\n$$\n\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $x(x+5)$ gives\n\n$$\n6x-25=A(x+5)+B(x).\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}6(0)-25 & =A(0+5)+B(0) \\\\ -25 & =5A \\\\ A & =-\\frac{25}{5} \\\\ A & =-5.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}6(-5)-25 & =A(-5+5)+B(-5) \\\\ -55 & =-5B \\\\ B & =\\frac{-55}{-5} \\\\ B & =11.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-5+11=6.\n$$"}] [{:db/id #edb/ref 17592186289081 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b15a2ae2-33a3-5746-842a-9a2d607e237e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289083} {:answer/id #uuid "6ea7df15-fda0-56a5-8524-af36e4835348" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289084}] :answer-field/correct {:answer/id #uuid "b15a2ae2-33a3-5746-842a-9a2d607e237e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289083} :answer-field/id #uuid "b59de7de-5b4e-5842-81d5-3bd55d78385a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289082} {:answer-field/choices [{:answer/id #uuid "ff8e4b5a-c2e5-5efb-86d4-1d2ceb089327" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289086}] :answer-field/correct {:answer/id #uuid "ff8e4b5a-c2e5-5efb-86d4-1d2ceb089327" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289086} :answer-field/id #uuid "cce518ad-0699-51ac-a515-be2a14a3ed4b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289085} {:answer-field/choices [{:answer/id #uuid "ddff0951-d7ac-56ae-b2c5-e8d039ddfe8f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289088}] :answer-field/correct {:answer/id #uuid "ddff0951-d7ac-56ae-b2c5-e8d039ddfe8f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289088} :answer-field/id #uuid "9c0f6555-bbbe-59c1-ac69-11563dbb0c8b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289087}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9f49d989-80e0-5f66-8ce2-1d24c01ad0ca" :question/math-academy-id "q-346796" :question/problem "Express $\\frac{5{x}^{2}+10x-21}{(x-1)(x+2)(2x-3)}$ as a sum of partial fractions.\n\n| $\\frac{5{x}^{2}+10x-21}{(x-1)(x+2)(2x-3)}=\\,$ | {{field-1}} | $-$ | {{field-2}} | $+$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $x-1$ |  | $x+2$ |  | $2x-3$ |" :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{5{x}^{2}+10x-21}{(x-1)(x+2)(2x-3)}=\\frac{A}{x-1}+\\frac{B}{x+2}+\\frac{C}{2x-3}.\n$$\n\nMultiplying both sides by $(x-1)(x+2)(2x-3)$ gives\n\n$$\n5{x}^{2}+10x-21=A(x+2)(2x-3)+B(x-1)(2x-3)+C(x-1)(x+2).\n$$\n\nFor $x=1,$ we get\n\n$$\n\\begin{aligned}5(1)^{2}+10(1)-21 & =A(1+2)(2(1)-3)+B(1-1)(2(1)-3)+C(1-1)(1+2) \\\\ -6 & =-3A \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=-2,$ we get\n\n$$\n\\begin{aligned}5(-2)^{2}+10(-2)-21 & =A(-2+2)(2(-2)-3)+B(-2-1)(2(-2)-3)+C(-2-1)(-2+2) \\\\ -21 & =21B \\\\ B & =-1.\\end{aligned}\n$$\n\nFor $x=\\frac{3}{2}$, we get\n\n$$\n\\begin{aligned}5{(\\frac{3}{2})}^{2}+10(\\frac{3}{2})-21 & =A(\\frac{3}{2}+2)(2(\\frac{3}{2})-3)+B(\\frac{3}{2}-1)(2(\\frac{3}{2})-3)+C(\\frac{3}{2}-1)(\\frac{3}{2}+2) \\\\ \\frac{21}{4} & =\\frac{7}{4}C \\\\ C & =3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{5{x}^{2}+10x-21}{(x-1)(x+2)(2x-3)}=\\frac{2}{x-1}-\\frac{1}{x+2}+\\frac{3}{2x-3}.\n$$"}] [{:db/id #edb/ref 17592186289089 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df797e27-a173-5b04-9f46-8d090078f38e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289091}] :answer-field/correct {:answer/id #uuid "df797e27-a173-5b04-9f46-8d090078f38e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289091} :answer-field/id #uuid "92430816-e191-55f5-a35c-fd2663b67f23" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fbf7949e-794d-58c7-ac2f-19452bc80c32" :question/math-academy-id "q-350930" :question/problem "Express $\\frac{3x+5}{(x-3)(2x+1)}$ as a sum of partial fractions.\n\n|  | $\\frac{3x+5}{(x-3)(2x+1)}\\,=\\,\\frac{2}{x-3}\\,\\,+$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $2x+1$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{B}{2x+1}.\n$$\n\nMultiplying both sides by $(x-3)(2x+1)$ gives\n\n$$\n3x+5=2(2x+1)+B(x-3).\n$$\n\nFor $x=-\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}3(-\\frac{1}{2})+5 & =2(2(-\\frac{1}{2})+1)+B(-\\frac{1}{2}-3) \\\\ \\frac{7}{2} & =-\\frac{7}{2}B \\\\ B & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{-1}{2x+1}.\n$$"}] [{:db/id #edb/ref 17592186289092 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2108f2a6-ecae-5b6c-892e-7ff91379f52b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289094} {:answer/id #uuid "7a72248a-b4f4-570b-8213-8abc451c6b01" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289095}] :answer-field/correct {:answer/id #uuid "7a72248a-b4f4-570b-8213-8abc451c6b01" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289095} :answer-field/id #uuid "c1a907d5-a384-5154-acb0-2ba33ac2ea0d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289093} {:answer-field/choices [{:answer/id #uuid "5ed002da-f0ff-58b5-894f-067f0f2dee58" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289097}] :answer-field/correct {:answer/id #uuid "5ed002da-f0ff-58b5-894f-067f0f2dee58" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289097} :answer-field/id #uuid "73880f27-7cf8-57f6-b1f5-977502950cda" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289096}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a509bb24-c324-53ee-b0e8-d5545e81981a" :question/math-academy-id "q-350945" :question/problem "Express $\\frac{3x+10}{(x+4)(x+5)}$ as a sum of partial fractions.\n\n| $\\frac{3x+10}{(x+4)(x+5)}=\\,$ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x+4$ |  | $x+5$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\frac{3x+10}{(x+4)(x+5)}=\\frac{A}{x+4}+\\frac{B}{x+5}.\n$$\n\nMultiplying both sides by $(x+4)(x+5)$ gives\n\n$$\n3x+10=A(x+5)+B(x+4).\n$$\n\nFor $x=-4$, we get \n\n$$\n\\begin{aligned}3(-4)+10 & =A(-4+5)+B(-4+4) \\\\ -2 & =A \\\\ A & =-2.\\end{aligned}\n$$\n\nFor $x=-5,$ we get \n\n$$\n\\begin{aligned}3(-5)+10 & =A(-5+5)+B(-5+4) \\\\ -5 & =-B \\\\ B & =5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+10}{(x+4)(x+5)}=\\frac{-2}{x+4}+\\frac{5}{x+5}.\n$$"}] [{:db/id #edb/ref 17592186289098 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd94580-8be7-5ecd-b961-b61dacb6d4e2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289100}] :answer-field/correct {:answer/id #uuid "4cd94580-8be7-5ecd-b961-b61dacb6d4e2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289100} :answer-field/id #uuid "4fa4e72c-a663-53fb-88a8-492e5dddebaa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289099} {:answer-field/choices [{:answer/id #uuid "18495756-4680-5dda-8ea9-87a62d87a15e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289102}] :answer-field/correct {:answer/id #uuid "18495756-4680-5dda-8ea9-87a62d87a15e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289102} :answer-field/id #uuid "402b5a81-b7e5-5f4e-b248-3232e34fcee3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289101} {:answer-field/choices [{:answer/id #uuid "00db50a4-956c-5cfe-8921-daa4691efb2d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289104}] :answer-field/correct {:answer/id #uuid "00db50a4-956c-5cfe-8921-daa4691efb2d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289104} :answer-field/id #uuid "e65d5f1d-7b02-5f01-b7f4-2bd24a15a42a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289103}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "22388e94-bbac-5ece-b8f5-9d21f73d9f0e" :question/math-academy-id "q-350988" :question/problem "Express $\\frac{2}{(1-x)(2x-3)(x-2)}$ as a sum of partial fractions.\n\n| $\\frac{2}{(1-x)(2x-3)(x-2)}=\\,$ | {{field-1}} | $+$ | {{field-2}} | $-$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $1-x$ |  | $2x-3$ |  | $x-2$ |" :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{2}{(1-x)(2x-3)(x-2)}=\\frac{A}{1-x}+\\frac{B}{2x-3}+\\frac{C}{x-2}.\n$$\n\nMultiplying both sides by $(1-x)(2x-3)(x-2)$ gives\n\n$$\n2=A(2x-3)(x-2)+B(1-x)(x-2)+C(1-x)(2x-3).\n$$\n\nFor $x=1,$ we get\n\n$$\n\\begin{aligned}2 & =A(2(1)-3)(1-2)+B(1-1)(1-2)+C(1-1)(2(1)-3) \\\\ 2 & =A \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=\\frac{3}{2}$, we get\n\n$$\n\\begin{aligned}2 & =A(2(\\frac{3}{2})-3)(\\frac{3}{2}-2) \\\\  & \\,+B(1-\\frac{3}{2})(\\frac{3}{2}-2) \\\\  & \\,+C(1-\\frac{3}{2})(2(\\frac{3}{2})-3) \\\\ 2 & =\\frac{1}{4}B \\\\ B & =8.\\end{aligned}\n$$\n\nFor $x=2,$ we get\n\n$$\n\\begin{aligned}2 & =A(2(2)-3)(2-2)+B(1-2)(2-2)+C(1-2)(2(2)-3) \\\\ 2 & =-C \\\\ C & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{2}{(1-x)(2x-3)(x-2)}=\\frac{2}{1-x}+\\frac{8}{2x-3}-\\frac{2}{x-2}.\n$$"}]}
