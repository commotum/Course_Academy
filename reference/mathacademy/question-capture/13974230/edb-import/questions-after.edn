& 5y\\end{aligned}| \\\\  & =-x\\cdot 5y-(-2y)\\cdot \\frac{x}{2} \\\\  & =-5xy+xy \\\\  & =-4xy\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275841 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1ab823-b6fe-572f-9d1c-893d9590b762" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}y+3" :db/id #edb/ref 17592186275843} {:answer/id #uuid "7080cd9c-72a1-595f-9522-f95115d1831b" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}-3)" :db/id #edb/ref 17592186275844} {:answer/id #uuid "80caf25f-3557-5a29-b5ec-2ae83f65bb76" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}x-5" :db/id #edb/ref 17592186275845} {:answer/id #uuid "88e1a293-5503-53cb-8e30-15f7b328369a" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}" :db/id #edb/ref 17592186275846} {:answer/id #uuid "1d8992d6-5373-584f-9367-b4b7b0792e87" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186275847}] :answer-field/correct {:answer/id #uuid "1d8992d6-5373-584f-9367-b4b7b0792e87" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186275847} :answer-field/id #uuid "0649b2c1-014c-5e99-a326-a0d708c8320c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275842}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4370c65c-319e-5f98-b4fd-ea0c6e518fe5" :question/math-academy-id "q-127603" :question/problem "Calculate $det(D)$, if\n    $D=[\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}| \\\\  & =2x\\cdot xy-y\\cdot (-5) \\\\  & =2{x}^{2}y+5y \\\\  & =y(2{x}^{2}+5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275848 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d29fc6c6-ed22-5328-b095-d23bdef0df1e" :answer/type {:db/ident :answer.type/math} :answer/value "v=-2" :db/id #edb/ref 17592186275850} {:answer/id #uuid "b2a6b859-b6fa-5b98-8477-5726c47f9c7e" :answer/type {:db/ident :answer.type/math} :answer/value "v=\\frac{3}{4}" :db/id #edb/ref 17592186275851} {:answer/id #uuid "93ff7f4a-4099-50cf-8e61-d187fdbe9ef4" :answer/type {:db/ident :answer.type/math} :answer/value "v=4" :db/id #edb/ref 17592186275852} {:answer/id #uuid "ee36df99-e3e5-5272-9b4d-a0f74effa7bd" :answer/type {:db/ident :answer.type/math} :answer/value "v=-3" :db/id #edb/ref 17592186275853} {:answer/id #uuid "aeedcd66-f4ba-5455-a801-1d0e3aa65f78" :answer/type {:db/ident :answer.type/math} :answer/value "v=\\frac{7}{3}" :db/id #edb/ref 17592186275854}] :answer-field/correct {:answer/id #uuid "d29fc6c6-ed22-5328-b095-d23bdef0df1e" :answer/type {:db/ident :answer.type/math} :answer/value "v=-2" :db/id #edb/ref 17592186275850} :answer-field/id #uuid "5eb19b20-3a6d-5ef4-a9cf-64f356088b82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275849}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "25fa2f42-3a0c-5274-a75f-53c4c844a01f" :question/math-academy-id "q-127606" :question/problem "If\n$T=[\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}]$\nand $det(T)=-4$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}| \\\\  & =v\\cdot (v+8)-2v\\cdot 2 \\\\  & ={v}^{2}+4v\\end{aligned}\n$$\n\nSince $det(T)=-4$, we obtain:\n\n$$\n\\begin{aligned}det(T) & =-4 \\\\ {v}^{2}+4v & =-4 \\\\ {v}^{2}+4v+4 & =0 \\\\ (v+2)^{2} & =0 \\\\ v & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275855 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857}] :answer-field/correct {:answer/id #uuid "2721fb1b-944f-514b-9459-32c248390c5f" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186275857} :answer-field/id #uuid "9689caa6-d67d-586d-afb2-3478b2ba698d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275856}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31f29a1f-5ce7-5787-80e1-70b0610804ac" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275858 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e461bf47-03f4-5003-8d58-fdbea0088802" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275860} {:answer/id #uuid "364aa401-e418-5ba4-ace1-76cc57798bd6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275861} {:answer/id #uuid "b38ea0c1-5513-519c-9062-33d3be5908ed" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275862} {:answer/id #uuid "4a5e14f2-2e56-5895-bb45-0d02101eaaf7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275863} {:answer/id #uuid "1c0b1fd9-9b7e-517e-b36f-e47f59ff85bd" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186275864}] :answer-field/correct {:answer/id #uuid "b38ea0c1-5513-519c-9062-33d3be5908ed" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275862} :answer-field/id #uuid "4509185d-1945-575e-a9b4-c6d3bab4ae54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275859}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c4b4d94f-d983-5344-b970-912e089ceb98" :question/math-academy-id "q-69661" :question/problem "If\n$S=[\\begin{aligned}1-p & 1+p \\\\ -3 & 2\\end{aligned}]$\nand $det(S)=2$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}1-p & 1+p \\\\ -3 & 2\\end{aligned}| \\\\  & =(1-p)\\cdot 2-(1+p)\\cdot (-3) \\\\  & =2-2p+3+3p \\\\  & =5+p\\end{aligned}\n$$\n\nSince $det(S)=2$, we obtain:\n\n$$\n\\begin{aligned}det(S) & =2 \\\\ 5+p & =2 \\\\ p & =2-5 \\\\ p & =-3\\end{aligned}\n$$"}]}
