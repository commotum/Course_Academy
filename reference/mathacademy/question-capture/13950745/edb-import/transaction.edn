} {:db/id "q-278353/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "824ed6c0-e56e-5273-9ffc-b00678e6e86c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278353/field-4" :answer-field/id #uuid "38b9aa91-e502-56d5-8a3e-d08f63eb614f" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278353/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278353/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278353" :question/id #uuid "fab1f9f2-d236-5418-afcd-760bf28fe153" :question/math-academy-id "q-278353" :question/problem "From **left to right,** the $x$-intercepts of the hyperbola $\\frac{(x-1)^{2}}{18}-\\frac{(y-3)^{2}}{9}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand \n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}-\\frac{(y-3)^{2}}{9} & =1 \\\\ \\frac{(x-1)^{2}}{18}-\\frac{(0-3)^{2}}{9} & =1 \\\\ \\frac{(x-1)^{2}}{18}-1 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =2 \\\\ (x-1)^{2} & =36 \\\\ x-1 & =\\pm 6 \\\\ x & =1\\pm 6 \\\\ x & =-5,7\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $(-5,0)$ and $(7,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278353/field-1" "q-278353/field-2" "q-278353/field-3" "q-278353/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-278353"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170553/selection/4597073aef20e6cb012b916e4500cbfbc57491f9cc15f82e6b83537dec6ef9d0" :answer/id #uuid "b3e809c5-9b3c-501d-b9cd-dfd1d06541bb" :answer/type :