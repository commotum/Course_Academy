e]} {:db/id "q-170552" :question/id #uuid "0582fa2b-c02a-5efe-af39-d631ed443100" :question/math-academy-id "q-170552" :question/problem "Calculate the $x$-intercepts of the hyperbola $10{x}^{2}-{y}^{2}=40.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}10{x}^{2}-{y}^{2} & =40 \\\\ 10{x}^{2}-(0)^{2} & =40 \\\\ 10{x}^{2}-0 & =40 \\\\ 10{x}^{2} & =40 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $(\\pm 2,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-170552/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-170552"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278358/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c1f45d24-c1b4-5567-ae01-0d2d9878b3d2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-278358/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "a2296e4c-ccaa-5dcf-8548-0a0d5de365eb" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-278358/field-1" :answer-field/id #uuid "a593675c-3024-54a7-9ff3-de4c3bfb4917" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278358/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-278358/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-278358/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-278358/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "12d2e191-abe6-5144-b5ce-c98286abdae1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278358/field-2" :answer-field/id #uuid "0f60eafd-f63d-5e8c-9ce4-210a3ff12982" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278358/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278358/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278358" :question/id #uuid "f5dfbb5d-49db-5fdc-a270-17124409b919" :question/math-academy-id "q-278358" :question/problem "The $x$-intercept of the hyperbola $\\frac{(y+2)^{2}}{4}-\\frac{(x-4)^{2}}{8}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+2)^{2}}{4}-\\frac{(x-4)^{2}}{8} & =1 \\\\ \\frac{(0+2)^{2}}{4}-\\frac{(x-4)^{2}}{8} & =1 \\\\ 1-\\frac{(x-4)^{2}}{8} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =0 \\\\ (x-4)^{2} & =0 \\\\ x-4 & =0 \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278358/field-1" "q-278358/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-278358"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277801/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0cc5c806-dd24-5c3c-a89e-92864116a934" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-277801/field-1" :answer-field/id #uuid "8922b141-39c7-5010-89f9-e0e8d5347a98" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277801/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-277801/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-277801/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fcc35d1c-d56c-5021-ae39-15ec4cbbc93f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-277801/field-2" :answer-field/id #uuid "56aae14e-4665-5566-bdb9-625558334861" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277801/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-277801/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-277801" :question/id #uuid "5b674bc0-9200-5895-bd90-f0429ce87f8c" :question/math-academy-id "q-277801" :question/problem "The $x$-intercept of the hyperbola $\\frac{(y-3)^{2}}{9}-\\frac{(x-1)^{2}}{16}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-3)^{2}}{9}-\\frac{(x-1)^{2}}{16} & =1 \\\\ \\frac{(0-3)^{2}}{9}-\\frac{(x-1)^{2}}{16} & =1 \\\\ 1-\\frac{(x-1)^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{16} & =0 \\\\ (x-1)^{2} & =0 \\\\ x-1 & =0 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-277801/field-1" "q-277801/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-277801"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278353/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "cff4a322-0085-569e-9b3f-cef63b861973" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:d