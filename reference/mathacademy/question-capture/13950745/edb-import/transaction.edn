25} & =0 \\\\ (y-5)^{2} & =0 \\\\ y-5 & =0 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $(0,5).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84045/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-84045"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84058/selection/7dd86c96ea6213c3182c02aa8739ed9814369441c95fb63b16d4ecf8eebd77b0" :answer/id #uuid "1d5463aa-ce75-5130-a96a-993b80f00035" :answer/type :answer.type/math :answer/value "(0,\\pm \\sqrt{5})" :db/ensure [:answer/validate]} {:db/id "q-84058/selection/dae5335f979b458799ffc035d2adfc1f0d0e4959597eec73a82bdb6dc329f121" :answer/id #uuid "3bbfd6f4-1eb4-543d-854e-946b939b5212" :answer/type :answer.type/text :answer/value "There are no $y$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-84058/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" :answer/id #uuid "bb21b2bc-b066-51d8-a700-b59cd87de178" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "q-84058/selection/0b750ee53a257966a9e77c1391e96388485f001caa39e027698ca7276ebfed13" :answer/id #uuid "0c0c7e62-9036-5a77-a734-9efc96420282" :answer/type :answer.type/math :answer/value "(0,\\pm 1)" :db/ensure [:answer/validate]} {:db/id "q-84058/selection/c2d7a8530ee76cd48410676dd25d672a58b41edb9844598e76b319744b248e3b" :answer/id #uuid "60b5fe01-714a-5791-aa05-37aebf2fa256" :answer/type :answer.type/math :answer/value "(0,\\pm 2)" :db/ensure [:answer/validate]} {:db/id "q-84058/selection" :answer-field/id #uuid "7c98c364-478e-5d86-bffb-4d8db869983d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84058/selection/7dd86c96ea6213c3182c02aa8739ed9814369441c95fb63b16d4ecf8eebd77b0" :answer-field/choices ["q-84058/selection/7dd86c96ea6213c3182c02aa8739ed9814369441c95fb63b16d4ecf8eebd77b0" "q-84058/selection/dae5335f979b458799ffc035d2adfc1f0d0e4959597eec73a82bdb6dc329f121" "q-84058/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" "q-84058/selection/0b750ee53a257966a9e77c1391e96388485f001caa39e027698ca7276ebfed13" "q-84058/selection/c2d7a8530ee76cd48410676dd25d672a58b41edb9844598e76b319744b248e3b"] :db/ensure [:answer-field/validate]} {:db/id "q-84058" :question/id #uuid "071b577f-4795-5c5f-ac92-28f777d2ffbb" :question/math-academy-id "q-84058" :question/problem "Calculate the $y$-intercepts of the hyperbola $4{y}^{2}-5{x}^{2}=20.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-5{x}^{2} & =20 \\\\ 4{y}^{2}-5(0)^{2} & =20 \\\\ 4{y}^{2} & =20 \\\\ {y}^{2} & =5 \\\\ y & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm \\sqrt{5}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84058/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-84058"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278387/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "241979fa-5adf-5116-b826-d3057e899717" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-278387/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5acfbb99-2498-5455-840f-4cee94edc91e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-278387/field-1" :answer-field/id #uuid "5eeae4ee-e240-55d1-bb9c-5c90971f2b31" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278387/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-278387/field-1/ad06fa8bb