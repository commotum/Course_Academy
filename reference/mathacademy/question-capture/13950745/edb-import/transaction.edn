rked-solution "To find the points where the hyperbola intersects the line $x=3,$ we substitute $x=3$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-9{y}^{2} & =18 \\\\ 3(3)^{2}-9{y}^{2} & =18 \\\\ 27-9{y}^{2} & =18 \\\\ -9{y}^{2} & =18-27 \\\\ -9{y}^{2} & =-9 \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nTherefore, from top to bottom, the hyperbola intersects the vertical line $x=3$  at the points $(3,1)$ and $(3,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278372/field-1" "q-278372/field-2" "q-278372/field-3" "q-278372/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793"] :knowledge-point/questions ["q-278372"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278384/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "a0f006f5-6d1e-5606-a998-90447c2acafa" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-278384/field-1" :answer-field/id #uuid "f6a490ce-aa4d-5638-93ef-ac28c5a9161a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278384/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-278384/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-278384/field-2/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "acec711b-9b69-563b-a058-0557334f05a1" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-278384/field-2" :answer-field/id #uuid "54372aed-dd68-5e3f-9a87-06eaf6e93935" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278384/field-2/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer-field/choices ["q-278384/field-2