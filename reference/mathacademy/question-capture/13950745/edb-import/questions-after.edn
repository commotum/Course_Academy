-3)^{2}}{9}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand \n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}-\\frac{(y-3)^{2}}{9} & =1 \\\\ \\frac{(x-1)^{2}}{18}-\\frac{(0-3)^{2}}{9} & =1 \\\\ \\frac{(x-1)^{2}}{18}-1 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =2 \\\\ (x-1)^{2} & =36 \\\\ x-1 & =\\pm 6 \\\\ x & =1\\pm 6 \\\\ x & =-5,7\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $(-5,0)$ and $(7,0).$"}] [{:db/id #edb/ref 17592186264754 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1f45d24-c1b4-5567-ae01-0d2d9878b3d2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264756} {:answer/id #uuid "a2296e4c-ccaa-5dcf-8548-0a0d5de365eb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264757}] :answer-field/correct {:answer/id #uuid "c1f45d24-c1b4-5567-ae01-0d2d9878b3d2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264756} :answer-field/id #uuid "a593675c-3024-54a7-9ff3-de4c3bfb4917" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264755} {:answer-field/choices [{:answer/id #uuid "12d2e191-abe6-5144-b5ce-c98286abdae1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264759}] :answer-field/correct {:answer/id #uuid "12d2e191-abe6-5144-b5ce-c98286abdae1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264759} :answer-field/id #uuid "0f60eafd-f63d-5e8c-9ce4-210a3ff12982" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264758}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5dfbb5d-49db-5fdc-a270-17124409b919" :question/math-academy-id "q-278358" :question/problem "The $x$-intercept of the hyperbola $\\frac{(y+2)^{2}}{4}-\\frac{(x-4)^{2}}{8}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+2)^{2}}{4}-\\frac{(x-4)^{2}}{8} & =1 \\\\ \\frac{(0+2)^{2}}{4}-\\frac{(x-4)^{2}}{8} & =1 \\\\ 1-\\frac{(x-4)^{2}}{8} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =0 \\\\ (x-4)^{2} & =0 \\\\ x-4 & =0 \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(4,0).$"}] [{:db/id #edb/ref 17592186264760 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093cea9e-667a-5183-b3d4-b1211936424d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264762}] :answer-field/correct {:answer/id #uuid "093cea9e-667a-5183-b3d4-b1211936424d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264762} :answer-field/id #uuid "3ff9e39c-08f8-594c-9e90-63e47778d606" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264761} {:answer-field/choices [{:answer/id #uuid "86021b2d-7ad1-523e-95ac-7e2e95bc78b4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264764}] :answer-field/correct {:answer/id #uuid "86021b2d-7ad1-523e-95ac-7e2e95bc78b4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264764} :answer-field/id #uuid "af576c18-e9f3-514c-809c-d07d55b396f8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264763}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a26f7a92-e625-525c-9ca3-0d3ed4556a84" :question/math-academy-id "q-278368" :question/problem "The $y$-intercept of the hyperbola $(x-1)^{2}-\\frac{(y+3)^{2}}{3}=1$ is$\\,(${{field-1}},\n{{field-2}}$).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}-\\frac{(y+3)^{2}}{3} & =1 \\\\ (0-1)^{2}-\\frac{(y+3)^{2}}{3} & =1 \\\\ 1-\\frac{(y+3)^{2}}{3} & =1 \\\\ -\\frac{(y+3)^{2}}{3} & =0 \\\\ (y+3)^{2} & =0 \\\\ y+3 & =0 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $(0,-3).$"}] [{:db/id #edb/ref 17592186264765 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc6c50c7-1b99-5401-b0cf-a510977d2868" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264767} {:answer/id #uuid "56145521-71af-5b81-9804-9b98ea77e192" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264768}] :answer-field/correct {:answer/id #uuid "bc6c50c7-1b99-5401-b0cf-a510977d2868" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264767} :answer-field/id #uuid "e419e8e8-fe9b-5dbc-9545-43db57f9c678" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264766} {:answer-field/choices [{:answer/id #uuid "74648690-266b-5eab-9b2e-8739537e97c8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264770}] :answer-field/correct {:answer/id #uuid "74648690-266b-5eab-9b2e-8739537e97c8" :answer/t