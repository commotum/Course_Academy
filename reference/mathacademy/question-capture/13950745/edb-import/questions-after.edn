-4}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=2.5,$ we substitute $y=2.5$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-{x}^{2} & =16 \\\\ 4(2.5)^{2}-{x}^{2} & =16 \\\\ 25-{x}^{2} & =16 \\\\ -{x}^{2} & =16-25 \\\\ -{x}^{2} & =-9 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, from left to right, the hyperbola intersects the vertical line $y=2.5$  at the points $(-3,2.5)$ and $(3,2.5).$"}] [{:db/id #edb/ref 17592186264806 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e01b02c7-f65f-52b5-bdf5-edc9d534f8e6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264808}] :answer-field/correct {:answer/id #uuid "e01b02c7-f65f-52b5-bdf5-edc9d534f8e6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264808} :answer-field/id #uuid "3577dc9d-f305-5bf7-b57b-d27e8534347c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264807} {:answer-field/choices [{:answer/id #uuid "1e493414-cbfd-5554-8951-b56dd6eeef99" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264810}] :answer-field/correct {:answer/id #uuid "1e493414-cbfd-5554-8951-b56dd6eeef99" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264810} :answer-field/id #uuid "764cc31d-bd41-58fe-ae98-aefa8fdf2f24" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264809}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a83b146-c3f6-599a-bc41-f567758cd670" :question/math-academy-id "q-278386" :question/problem "The hyperbola $6{x}^{2}-8{y}^{2}=24$ intersects the line $x=2$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=2,$ we substitute $x=2$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}6{x}^{2}-8{y}^{2} & =24 \\\\ 6(2)^{2}-8{y}^{2} & =24 \\\\ 24-8{y}^{2} & =24 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=2$  at $(2,0).$"}] [{:db/id #edb/ref 17592186264811 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5acfbb99-2498-5455-840f-4cee94edc91e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264813} {:answer/id #uuid "241979fa-5adf-5116-b826-d3057e899717" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264814}] :answer-field/correct {:answer/id #uuid "241979fa-5adf-5116-b826-d3057e899717" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264814} :answer-field/id #uuid "5eeae4ee-e240-55d1-bb9c-5c90971f2b31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264812} {:answer-field/choices [{:answer/id #uuid "73906bef-c62c-5eab-8373-b5f8789118ab" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264816}] :answer-field/correct {:answer/id #uuid "73906bef-c62c-5eab-8373-b5f8789118ab" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264816} :answer-field/id #uuid "212a713f-5178-5f68-b856-942c063292b0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264815}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "52e3ee06-4eb3-571c-834e-73b9bff768df" :question/math-academy-id "q-278387" :question/problem "The hyperbola ${x}^{2}-\\frac{{y}^{2}}{9}=1$ intersects the line $x=1$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=1,$ we substitute $x=1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{{y}^{2}}{9} & =1 \\\\ (1)^{2}-\\frac{{y}^{2}}{9} & =1 \\\\ 1-\\frac{{y}^{2}}{9} & =1 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=1$  at $(1,0).$"}] [{:db/id #edb/ref 17592186264817 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "727dd59c-06e4-57c1-8a30-066e8e3756aa" :answer/type {:db/ident :answer.type/math} :answer/value "(1,\\pm \\frac{1}{5})" :db/id #edb/ref 17592186264819} {:answer/id #uuid "91bd5114-c607-53bd-b3f6-ae37cae4d1c7" :answer/type {:db/ident :answer.type/math} :answer/value "(1,\\pm 2)" :db/id #edb/ref 17592186264820} {:answer/id #uuid "ae74172a-017b-5612-8e2f-0954d30a805b" :answer/type {:db/ident :answer.type/text} :answer/value "There are no  points of intersection" :db/id #edb/ref 17592186264821} {:answer/id #uuid "ce90e425-d370-5eef-bc87-1fb36ff799e0" :answer/type {:db/ident :answer.type/math} :answer/value "(1,\\pm \\frac{1}{2})" :db/id #edb/ref 17592186264822} {:answer/id #uuid "3d92911f-9e86-5b64-8ded-87c8b3bc47be" :answer/type {:db/ident :answer.type/math} :answer/value "(1,\\pm 1)" :db/id #edb/ref 17592186264823}] :answer-field/correct {:answer/id #uuid "ae74172a-017b-5612-8e2f-0954d30a805b" :answer/type {:db/ident :answer.type/text} :answer/value "There are no  points of intersection" :db/id #edb/ref 17592186264821} :answer-field/id #uuid "e30bff39-8639-5b38-9c3b-28d43b594052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264818}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "44b6743d-1c93-5938-a5b7-911cefd1238e" :question/math-academy-id "q-8011" :question/problem "Calculate the points where the hyperbola \n$25{x}^{2}-{y}^{2}=26$\nintersects the line $x=1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=1,$ we substitute $x=1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-{y}^{2} & =26 \\\\ 25(1)^{2}-{y}^{2} & =26 \\\\ -{y}^{2} & =26-25 \\\\ -{y}^{2} & =1 \\\\ {y}^{2} & =-1\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. \nSo, the hyperbola does not intersect the vertical line $x=1.$"}] [{:db/id #edb/ref 17592186264824 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca31bfdd-709d-5049-bc02-b121caa2717a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 5)" :db/id #edb/ref 17592186264826} {:answer/id #uuid "59d5f290-4150-52a1-aafa-7b6cbe86761e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186264827} {:answer/id #uuid "2f433040-ecbe-5307-a055-63b88498c8a7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 3)" :db/id #edb/ref 17592186264828} {:answer/id #uuid "eff5e56f-23c2-5b12-8ad4-c0ece8311597" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186264829} {:answer/id #uuid "0be492ed-c02e-56fe-a8ba-bae7359d68a2" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186264830}] :answer-field/correct {:answer/id #uuid "59d5f290-4150-52a1-aafa-7b6cbe86761e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186264827} :answer-field/id #uuid "2a5f1419-df80-589c-acd3-b2ef3a6d9e7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264825}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "583b4955-ad68-57f1-abf5-a8aa6fbac164" :question/math-academy-id "q-84045" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(x+3)^{2}}{9}-\\frac{(y-5)^{2}}{25}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{9}-\\frac{(y-5)^{2}}{25} & =1 \\\\ \\frac{(0+3)^{2}}{9}-\\frac{(y-5)^{2}}{25} & =1 \\\\ 1-\\frac{(y-5)^{2}}{25} & =1 \\\\ -\\frac{(y-5)^{2}}{25} & =0 \\\\ (y-5)^{2} & =0 \\\\ y-5 & =0 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $(0,5).$"}] [{:db/id #edb/ref 17592186264831 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c0c7e62-9036-5a77-a734-9efc96420282" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 1)" :db/id #edb/ref 17592186264833} {:answer/id #uuid "1d5463aa-ce75-5130-a96a-993b80f00035" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm \\sqrt{5})" :db/id #edb/ref 17592186264834} {:answer/id #uuid "60b5fe01-714a-5791-aa05-37aebf2fa256" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 2)" :db/id #edb/ref 17592186264835} {:answer/id #uuid "3bbfd6f4-1eb4-543d-854e-946b939b5212" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186264836} {:answer/id #uuid "bb21b2bc-b066-51d8-a700-b59cd87de178" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186264837}] :answer-field/correct {:answer/id #uuid "1d5463aa-ce75-5130-a96a-993b80f00035" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm \\sqrt{5})" :db/id #edb/ref 17592186264834} :answer-field/id #uuid "7c98c364-478e-5d86-bffb-4d8db869983d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264832}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "071b577f-4795-5c5f-ac92-28f777d2ffbb" :question/math-academy-id "q-84058" :question/problem "Calculate the $y$-intercepts of the hyperbola $4{y}^{2}-5{x}^{2}=20.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-5{x}^{2} & =20 \\\\ 4{y}^{2}-5(0)^{2} & =20 \\\\ 4{y}^{2} & =20 \\\\ {y}^{2} & =5 \\\\ y & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm \\sqrt{5}).$"}]}
