} & =-9 \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nTherefore, from top to bottom, the hyperbola intersects the vertical line $x=3$  at the points $(3,1)$ and $(3,-1).$"}] [{:db/id #edb/ref 17592186264775 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4e1154e-7f7f-580f-b24f-cb6a0bfe9904" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264777}] :answer-field/correct {:answer/id #uuid "d4e1154e-7f7f-580f-b24f-cb6a0bfe9904" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264777} :answer-field/id #uuid "41b73486-692a-552b-98c1-6b43459cc248" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264776} {:answer-field/choices [{:answer/id #uuid "a967f871-6774-5123-9c0e-fa19a38c3ac7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264779}] :answer-field/correct {:answer/id #uuid "a967f871-6774-5123-9c0e-fa19a38c3ac7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264779} :answer-field/id #uuid "e0e04429-740a-571c-9cee-8c644701f204" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264778}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "76e113f8-fc6f-514a-9924-ec8aaae4d36b" :question/math-academy-id "q-278374" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{12}=1$ intersects the line $y=x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{12} & =1 \\\\ \\frac{{x}^{2}}{3}-\\frac{{x}^{2}}{12} & =1 \\\\ \\frac{12{x}^{2}}{36}-\\frac{3{x}^{2}}{36} & =1 \\\\ \\frac{9{x}^{2}}{36} & =1 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186264780 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "730c0f83-755b-5070-89cf-87b3254ec271" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264782} {:answer/id #uuid "bae71417-2834-58a6-943c-7f0ad123769b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264783}] :answer-field/correct {:answer/id #uuid "730c0f83-755b-5070-89cf-87b3254ec271" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264782} :answer-field/id #uuid "8e1651f2-d37a-54c2-9114-eef3e43f2e83" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264781} {:answer-field/choices [{:answer/id #uuid "3be5a155-b40c-5e7a-b681-207b7fa85dcf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264785}] :answer-field/correct {:answer/id #uuid "3be5a155-b40c-5e7a-b681-207b7fa85dcf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264785} :answer-field/id #uuid "4edf9491-9b0f-5433-9cc4-2aaf28bc63a2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264784}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5bea3b57-2a79-53a0-be43-d2e4d30fedc6" :question/math-academy-id "q-278375" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16}=1$ intersects the line $y=-x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=-x,$ we first replace $y$ with $-x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{(-x)^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{2{x}^{2}}{16}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{16} & =1 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-4$ and $x=4.$"}] [{:db/id #edb/ref 17592186264786 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eb5a90a-24be-5f02-b5dd-561158a561cf" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264788} {:answer/id #uuid "54fb7f73-369b-52a9-883a-9b9fd3dadcab" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264789}] :answer-field/correct {:answer/id #uuid "9eb5a90a-24be-5f02-b5dd-561158a561cf" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264788} :answer-field/id #uuid "9f30fc65-eca1-5c87-9e82-50b3df47c11e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264787} {:answer-field/choices [{:answer/id #uuid "0d88a308-f985-56bf-974e-50627ad00296" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264791}] :answer-field/correct {:answer/id #uuid "0d88a308-f985-56bf-974e-50627ad00296" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264791} :answer-field/id #uuid "bee1488a-d9ee-59cf-a553-c06ba63a2f0b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264790}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b2cfbfb-c2b5-564f-a50c-f6a3316ef02c" :question/math-academy-id "q-278378" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $8{x}^{2}-5{y}^{2}=27$ intersects the line $y=x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}8{x}^{2}-5{y}^{2} & =27 \\\\ 8{x}^{2}-5{x}^{2} & =27 \\\\ 3{x}^{2} & =27 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-3$ and $x=3.$"}] [{:db/id #edb/ref 17592186264792 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c255fe9-1c78-59a2-9436-f6e0e35710c6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264794}] :answer-field/correct {:answer/id #uuid "9c255fe9-1c78-59a2-9436-f6e0e35710c6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264794} :answer-field/id #uuid "a6e4370b-0a5f-50d1-9a6e-89dc2ce13cda" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264793} {:answer-field/choices [{:answer/id #uuid "f5673a02-af4a-5370-98bc-39467a65b801" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264796}] :answer-field/correct {:answer/id #uuid "f5673a02-af4a-5370-98bc-39467a65b801" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264796} :answer-field/id #uuid "2fade023-2100-52c4-bce2-de3057bee2b4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264795}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fd45590-0bb3-5985-845c-fe2af3734d03" :question/math-academy-id "q-278383" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $14{x}^{2}-5{y}^{2}=64$ intersects the line $y=\\sqrt{2}x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=\\sqrt{2}x,$ we first replace $y$ with $\\sqrt{2}x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}14{x}^{2}-5{y}^{2} & =64 \\\\ 14{x}^{2}-5(\\sqrt{2}x)^{2} & =64 \\\\ 14{x}^{2}-5(2{x}^{2}) & =64 \\\\ 14{x}^{2}-10{x}^{2} & =64 \\\\ 4{x}^{2} & =64 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-4$ and $x=4.$"}] [{:db/id #edb/ref 17592186264797 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0f006f5-6d1e-5606-a998-90447c2acafa" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264799}] :answer-field/correct {:answer/id #uuid "a0f006f5-6d1e-5606-a998-90447c2acafa" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264799} :answer-field/id #uuid "f6a490ce-aa4d-5638-93ef-ac28c5a9161a" :answer-field/key "field-1" :answer-field/type {:db/ident :a