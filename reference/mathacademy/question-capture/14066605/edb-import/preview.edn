i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x-2\\text{i})(x+2\\text{i})(x-(1+\\text{i}))(x-(1-\\text{i})) & = \\\\ 3({x}^{2}+2\\text{i}x-2\\text{i}x-(2\\text{i})^{2})({x}^{2}-x(1-\\text{i})-x(1+\\text{i})+(1+\\text{i})(1-\\text{i})) & = \\\\ 3({x}^{2}+4)({x}^{2}-2x+2) & = \\\\ 3({x}^{4}-2{x}^{3}+2{x}^{2}+4{x}^{2}-8x+8) & = \\\\ 3({x}^{4}-2{x}^{3}+6{x}^{2}-8x+8) & = \\\\ 3{x}^{4}-6{x}^{3}+18{x}^{2}-24x+24 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{4}-6{x}^{3}+18{x}^{2}-24x+24\\,.$" 13194139535509 true] [17592186352838 1000 #edb/ref 17592186352839 13194139535509 true] [17592186352838 1040 #edb/ref 17592186045449 13194139535509 true] [17592186352838 1041 "field-1" 13194139535509 true] [17592186352838 1104 #edb/ref 17592186352839 13194139535509 true] [17592186352838 1110 #uuid "46d227b6-12ef-52ca-951f-3033e6d3d9a7" 13194139535509 true] [17592186352839 1034 "3x^4-6x^3+18x^2-24x" 13194139535509 true] [17592186352839 1103 #edb/ref 17592186045453 13194139535509 true] [17592186352839 1111 #uuid "070f6cda-b78c-5c39-865d-d6cec8d18555" 13194139535509 true] [17592186352840 1017 #edb/ref 17592186352841 13194139535509 true] [17592186352840 1089 "q-8212" 13194139535509 true] [17592186352840 1091 #edb/ref 17592186045465 13194139535509 true] [17592186352840 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066605/assets/8fb9e432fe79c363a42d362ef5c352eab6e8b55b83583f2a946ed9251ce293e3.png)\n\nThe Argand diagram above shows the roots of a quartic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the quartic term is $1.$" 13194139535509 true] [17592186352840 1113 #uuid "4b8c31ed-b430-578b-beff-5b3dbca10d94" 13194139535509 true] [17592186352840 1145 "From the diagram, we see that $f(x)$ has roots ${x}_{1,2}=\\pm 1,$ and ${x}_{3,4}=\\pm 4\\text{i}.$ Additionally, we're given that the coefficient of the quartic term is $a=1.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{ali