#{[{:db/id #edb/ref 17592186105508 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d766de83-9394-57be-84a4-bb88f5ddf792" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/id #uuid "7d104813-5c61-5696-912a-b29d6f012b28" :question/math-academy-id "e-4315" :question/problem "Let $\\mathbf{a}=\\langle 2, -3, -7 \\rangle$. Find $\\mid \\mathbf{a} \\mid$." :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}\n\\mid a \\mid &= \\sqrt{a_{x}^{2} + a_{y}^{2} + a_{z}^{2}} \\\\\n&= \\sqrt{2^{2} + (-3)^{2} + (-7)^{2}} \\\\\n&= \\sqrt{4 + 9 + 49} \\\\\n&= \\sqrt{62}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105509 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1916efa2-6a98-59a5-858c-c4fe64d8e8bc" :knowledge-point/title "Calculating the Magnitude of a Vector Given the Coordinates of its Endpoints"}] :question/id #uuid "c0f385e3-6689-59d4-af2c-036e630f4303" :question/math-academy-id "e-4316" :question/problem "Let $A(1,1,2)$ and $B(2,-2,3)$. Find $\\mid \\overrightarrow{AB} \\mid$." :question/worked-solution "We have\n\n$$\nOA^(→) = a = i + j + 2k,; OB^(→) = b = 2i - 2j + 3k\n$$\n\nExpressing $\\overrightarrow{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\nAB^(→) &= OB^(→) - OA^(→) \\\\\n&= b - a \\\\\n&= (2i - 2j + 3k) - (i + j + 2k) \\\\\n&= i - 3j + k\n\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n\\mid AB^(→) \\mid &= \\sqrt{1^{2} + (-3)^{2} + 1^{2}} \\\\\n&= \\sqrt{1 + 9 + 1} \\\\\n&= \\sqrt{11}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105510 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "83423c03-d314-5f78-9acf-58cbb6f7774b" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/id #uuid "76abe9ed-240e-589b-9317-78cae1ccf91b" :question/math-academy-id "e-4317" :question/problem "Let $\\begin{bmatrix}4 \\\\ -5 \\\\ 1\\end{bmatrix}$ Find a unit vector that is parallel to $\\mathbf{a}$." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\mathbf{u} = \\dfrac{\\mathbf{a}}{\\mid \\,\\mathbf{a}\\, \\mid}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n\\mid a \\mid &= \\sqrt{a_{x}^{2} + a_{y}^{2} + a_{z}^{2}} \\\\\n&= \\sqrt{4^{2} + (-5)^{2} + 1^{2}} \\\\\n&= \\sqrt{16 + 25 + 1} \\\\\n&= \\sqrt{42}\n\\end{aligned}\n$$\n\nFinally, we divide $\\mathbf{a}$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{a}{\\mid a \\mid} \\\\\n&= \\frac{1}{\\sqrt{42}}a \\\\\n&= \\frac{1}{\\sqrt{42}} \\cdot \\begin{bmatrix}4 \\\\ -5 \\\\ 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}4/\\sqrt{42} \\\\ -5/\\sqrt{42} \\\\ 1/\\sqrt{42}\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106026 :knowledge-point/_questions [{:knowledge-point/id #uuid "83423c03-d314-5f78-9acf-58cbb6f7774b" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe61b3a1-9e6d-55b4-b6b7-27c3bed2c392" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{74}}, \\frac{8}{\\sqrt{74}}, \\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186102394} {:answer/id #uuid "186ff4db-a684-5234-a9fe-d4445b22cdd3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{74}}, \\frac{8}{\\sqrt{74}}, \\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186102395} {:answer/id #uuid "22ad60e1-fb01-562a-88b8-08b42c1e9884" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{77}},-\\frac{8}{\\sqrt{77}},-\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102396} {:answer/id #uuid "28b4bc21-f68e-5747-965e-a89aa5afb118" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{77}}, \\frac{8}{\\sqrt{77}}, \\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102397} {:answer/id #uuid "49474f4b-2912-595f-95b0-9e42acee4bb3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{77}}, \\frac{8}{\\sqrt{77}}, \\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102398}] :answer-field/correct {:answer/id #uuid "49474f4b-2912-595f-95b0-9e42acee4bb3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{77}}, \\frac{8}{\\sqrt{77}}, \\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102398} :answer-field/id #uuid "9edea1ff-b532-59c5-b499-57648c90c425" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102393}] :question/id #uuid "46dce84e-4f15-50e3-8511-5dd62cf1728a" :question/math-academy-id "q-18975" :question/problem "Let $a = ⟨ - 2, 8, 3⟩$. Find a unit vector that is parallel to $a$."}]}
