#{[{:activity/first-step {:db/id #edb/ref 17592186101674} :activity/id #uuid "e035a7b5-8ab1-5910-8886-36efa38ee822" :activity/scope {:db/id #edb/ref 17592186048783 :topic/id #uuid "be557898-2dc0-5c08-b4e7-63bbb4f08f56" :topic/math-academy-id 1198} :activity/steps [{:db/id #edb/ref 17592186101674 :step/content {:db/id #edb/ref 17592186101958 :tutorial/content "Given two matrices, it is not always possible to multiply them together. To demonstrate why, consider the following two matrices:\n\n$$\n[\\begin{aligned}1 & 12 \\\\ 6 & -4\\end{aligned}]\n$$\n\nNormally, to compute the product $AB,$ we multiply each row of $A$ by each column of $B.$ However, in this case, each row of $A$ has $\\color{blue}2$ entries, while each column of $B$ has $\\color{red}3$ entries. The number of entries do not match!\n\n$$\n[\\begin{aligned}1 & 12 \\\\ 6 & -4\\end{aligned}]\n$$\n\nAs a result, we cannot compute the dot product, and therefore the product $AB$ is not defined." :tutorial/id #uuid "15951cb3-8d8f-580c-803c-d989e64ec1e4" :tutorial/math-academy-id 2990 :tutorial/title "Introduction"} :step/id #uuid "07f07b20-6f36-5da7-9065-e34083c05d34" :step/math-academy-id 16180 :step/next {:db/id #edb/ref 17592186101747}} {:db/id #edb/ref 17592186101675 :step/content {:db/id #edb/ref 17592186100869 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100691 :question/id #uuid "da92ef6c-cb0b-5a4c-9a0d-0f0a9db19616" :question/math-academy-id "e-4403"} :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048297} {:db/id #edb/ref 17592186048896}] :knowledge-point/questions [{:db/id #edb/ref 17592186101319} {:db/id #edb/ref 17592186101409} {:db/id #edb/ref 17592186265727} {:db/id #edb/ref 17592186290369} {:db/id #edb/ref 17592186290370} {:db/id #edb/ref 17592186290371} {:db/id #edb/ref 17592186329644} {:db/id #edb/ref 17592186329645} {:db/id #edb/ref 17592186329646} {:db/id #edb/ref 17592186329647}] :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"} :step/id #uuid "0cf8a8d6-df08-539f-89e4-03e4272a9103" :step/math-academy-id 16182 :step/next {:db/id #edb/ref 17592186101676}} {:db/id #edb/ref 17592186101676 :step/content {:db/id #edb/ref 17592186100870 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100692 :question/id #uuid "c677ee1a-d3c2-534c-985c-efaa5dc04c86" :question/math-academy-id "e-4404"} :knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce" :knowledge-point/questions [{:db/id #edb/ref 17592186101410} {:db/id #edb/ref 17592186101411} {:db/id #edb/ref 17592186265735} {:db/id #edb/ref 17592186265740} {:db/id #edb/ref 17592186299836} {:db/id #edb/ref 17592186299838} {:db/id #edb/ref 17592186338807} {:db/id #edb/ref 17592186338808} {:db/id #edb/ref 17592186345300} {:db/id #edb/ref 17592186398354} {:db/id #edb/ref 17592186398933}] :knowledge-point/title "Determining the Dimension of the Product of Two Matrices Given the Dimensions of the Factors"} :step/id #uuid "0df3419d-02f7-5df1-ad69-d0b480e15bb2" :step/math-academy-id 16184 :step/next {:db/id #edb/ref 17592186101677}} {:db/id #edb/ref 17592186101677 :step/content {:db/id #edb/ref 17592186100871 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100693 :question/id #uuid "9352349d-64e0-5437-9d72-7e7f7e571064" :question/math-academy-id "e-4405"} :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/questions [{:db/id #edb/ref 17592186101320} {:db/id #edb/ref 17592186101321} {:db/id #edb/ref 17592186265741} {:db/id #edb/ref 17592186265742} {:db/id #edb/ref 17592186292849} {:db/id #edb/ref 17592186299839} {:db/id #edb/ref 17592186299841} {:db/id #edb/ref 17592186299843} {:db/id #edb/ref 17592186345301} {:db/id #edb/ref 17592186403885}] :knowledge-point/title "Determining the Dimension of the Product of Two Matrices"} :step/id #uuid "f71e7a6b-ca82-55ed-a10e-c28bb5ea6729" :step/math-academy-id 16185} {:db/id #edb/ref 17592186101747 :step/content {:db/id #edb/ref 17592186101985 :tutorial/content "We can only multiply two matrices if they are **conformable** for multiplication, which means that the number of columns in the first matrix must equal the number of rows in the second matrix. In other words, we can only multiply two matrices if the first matrix has dimensions $n$ and the second matrix has dimensions $n$\n\nIf the matrices $A$ and $B$ (in that order) are conformable for multiplication and have dimensions $n$ and $n$ respectively, then the product $AB$ will have the dimensions $m \\times k.$\n\nLet's illustrate these ideas with some concrete examples." :tutorial/id #uuid "0df41235-ef9f-50ab-b91b-78caa512f359" :tutorial/math-academy-id 3800 :tutorial/title "Conformability for Matrix Multiplication"} :step/id #uuid "f1cc4bcd-da1d-5aaf-8820-cac2e4f8bed8" :step/math-academy-id 21624 :step/next {:db/id #edb/ref 17592186101675}}] :activity/title "Conformability for Matrix Multiplication" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186101057}]}
