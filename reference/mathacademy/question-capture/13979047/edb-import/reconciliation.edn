}}\\times 2}={CD}_{3\\times 2}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129492" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-129492" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129492" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\times 2"] ["math" "2\\times 3"] ["math" "3\\times 2"] ["math" "3\\times 3"] ["text" "The product is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129492" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\times 2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-77475" "field" nil "attribute" "question/problem" "value" "Let\n$Y=[\\begin{aligned}\\sqrt{2} & -1 & 0\\end{aligned}]$\nand\n$U=[\\begin{aligned}-4 \\\\ 0 \\\\ \\sqrt{3}\\end{aligned}].$\nWhat are the dimensions of $YU?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-cap