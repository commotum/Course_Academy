{8}}}{\\times }_{✓}{A}_{\\boxed{\\text{8}}\\times 7}={BA}_{2\\times 7}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129486" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-129486" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129486" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\times 7"] ["math" "2\\times 8"] ["math" "7\\times 2"] ["math" "8\\times 7"] ["text" "The product is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129486" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\times 7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320344" "field" nil "attribute" "question/problem" "value" "If $X$ is a $5\\times 7$ matrix and $Y$ is a $10\\times 5$ matrix, then the dimensions of $YX$ are{{field-1}}$\\times $\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320344" "field" nil "attribute" "question/worked-solution" "value" "There are $5$ columns in $Y$ and $5$ rows in $X.$ Since the number of columns in $Y$ equals the number of rows in $X,$ the matrices $Y$ and $X$ are conformable for multiplication, and $YX$ is a $10\\times 7$ matrix:\n\n$$\n{Y}_{10\\times \\boxed{\\text{5}}}{\\times }_{✓}{X}_{\\boxed{\\text{5}}\\times 7}={YX}_{10\\times 7}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320344" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-320344" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320344" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320344" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b