3979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-129480" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129480" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1\\times 5"] ["math" "5\\times 1"] ["math" "5\\times 5"] ["math" "7\\times 5"] ["text" "The product is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-129480" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5\\times 1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-70705" "field" nil "attribute" "question/problem" "value" "Suppose $U$ is a $2\\times 3$ matrix and $V$ is a $5\\times 2$ matrix. What are the dimensions of $VU?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-70705" "field" nil "attribute" "question/worked-solution" "value" "There are $2$ columns in $V$ and $2$ rows in $U.$ Since the number of columns in $V$ equals the number of rows in $U,$ the matrices $V$ and $U$ are conformable for multiplication, and $VU$ is a $5\\times 3$ matrix:\n\n$$\n{V}_{5\\times \\boxed{\\text{2}}}{\\times }_{✓}{U}_{\\boxed{\\text{2}}\\times 3}={VU}_{5\\times 3}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-70705" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-70705" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-70705" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\times 2"] ["math" "3\\times 5"] ["math" "5\\times 3"] ["math" "5\\times 5"] ["text" "The product is undefined"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-70705" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5\\times 3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" nil "attribute" "question/problem" "value" "Let\n$E=[\\begin{aligned}-1 & 2 \\\\ 4 & 0 \\\\ 3 & 5 \\\\ 7 & -6\\end{aligned}]$\nand\n$F=[\\begin{aligned}9 & -2 & 8 & 1 \\\\ -4 & 6 & 0 & -3\\end{aligned}].$\nThen, the dimensions of $FE$ are{{field-1}}$\\times $\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" nil "attribute" "question/worked-solution" "value" "We notice that $E$ is a $4\\times 2$ matrix and $F$ is a $2\\times 4$ matrix. \n\nThere are $4$ columns in $F$ and $4$ rows in $E.$ Since the number of columns in $F$ equals the number of rows in $E,$ the matrices $F$ and $E$ are conformable for multiplication. \n\nThe product $FE$ has dimensions $2\\times 2:$\n\n$$\n{F}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{E}_{\\boxed{\\text{4}}\\times 2}={FE}_{2\\times 2}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-320371" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-320371" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-77476" "field" nil "attribute" "question/problem" "value" "Let\n$E=[\\begin{aligned}3 \\\\ -1 \\\\ \\frac{3}{2}\\end{aligned}]$\nand\n$R=[\\begin{aligned}-1 & \\sqrt{3} & 1\\end{aligned}].$\nWhat are the dimensions of $ER?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-77476" "field" nil "attribute" "question/worked-solution" "value" "We notice that $E$ is a $3\\times 1$ matrix and $R$ is a $1\\times 3$ matrix. \n\nThere is $1$ column in $E$ and $1$ row in $R.$ Since the number of columns in $E$ equals the number of rows in $R,$ the matrices $E$ and $R$ are conformable for multiplication. \n\nThe product $ER$ has dimensions $3\\times 3:$\n\n$$\n{E}_{3\\times \\boxed{\\text{1}}}{\\times }_{✓}{R}_{\\boxed{\\text{1}}\\times 3}={ER}_{3\\times 3}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/state.json" "file_sha256" "ba090db14c2dfc5f445393c04e1a961f648b91d0b9703749c30d55368772f329"} {"question" "q-77476" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979047/activity-metadata.json" "file_sha256" "f9257f8c40add6ab1b82355accdf9587b7750c84fd830461d2b204bd0b61c3bd"} {"question" "q-77476" "field" "selection" "attribu