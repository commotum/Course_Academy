2 \\\\ 0 & 2\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 0 & 1\\end{aligned}| \\\\ |\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 & 1 \\\\ 2 & 0 & 0 \\\\ 0 & -2 & -2\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}1 & -2 & 1 \\\\ -2 & 0 & 0 \\\\ 0 & 2 & -2\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}1 & -2 & 0 \\\\ -2 & 0 & 2 \\\\ 1 & 0 & -2\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{2}[\\begin{aligned}1 & -2 & 0 \\\\ -2 & 0 & 2 \\\\ 1 & 0 & -2\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}-1 & 2 & 0 \\\\ 2 & 0 & -2 \\\\ -1 & 0 & 2\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}-1 & 2 & 0 \\\\ 2 & 0 & -2 \\\\ -1 & 0 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}5 \\\\ 8 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{2} \\\\ 4 \\\\ -\\frac{7}{2}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=\\frac{5}{2},y=4,z=-\\frac{7}{2}.$" 13194139535268 true] [17592186340841 1000 #edb/ref 17592186340842 13194139535268 true] [17592186340841 1000 #edb/ref 17592186340843 13194139535268 true] [17592186340841 1000 #edb/ref 17592186340844 13194139535268 true] [17592186340841 1000 #edb/ref 17592186340845 13194139535268 true] [17592186340841 1000 #edb/ref 17592186340846 13194139535268 true] [17592186340841 1040 #edb/ref 17592186045450 13194139535268 true] [17592186340841 1041 "selection" 13194139535268 true] [17592186340841 1104 #edb/ref 17592186340844 13194139535268 true] [17592186340841 1110 #uuid "b17aa334-95a3-5fed-9246-3dcdbe01c49d" 13194139535268 true] [17592186340842 1034 "x=\\frac{5}{2},y=-4,z=-\\frac{7}{2}" 13194139535268 true] [17592186340842 1103 #edb/ref 17592186045453 13194139535268 true] [175921863