#{[{:db/id #edb/ref 17592186171742 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/id #uuid "ef170346-47b1-5ce7-a99d-070021b3fb81" :question/math-academy-id "e-5344" :question/problem "Calculate the coordinates of the vertex of the parabola $y^2 - 8x - 6y + 33 = 0$." :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x-6y+33 & =0 \\\\ {y}^{2}-6y & =8x-33 \\\\ (y-3)^{2}-9 & =8x-33 \\\\ (y-3)^{2} & =8x-33+9 \\\\ (y-3)^{2} & =8x-24 \\\\ (y-3)^{2} & =8(x-3) \\\\ (y-3)^{2} & =4(2)(x-3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (3,3).$"}] [{:db/id #edb/ref 17592186171755 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/id #uuid "a7f9f74b-e213-5f38-8cb2-b9352ee515ad" :question/math-academy-id "e-7471" :question/problem "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}-10x-4y-7 & =0 \\\\ 5{x}^{2}-10x & =4y+7 \\\\ 5[{x}^{2}-2x] & =4y+7 \\\\ 5[(x-1)^{2}-1] & =4y+7 \\\\ 5(x-1)^{2}-5 & =4y+7 \\\\ 5(x-1)^{2} & =4y+7+5 \\\\ 5(x-1)^{2} & =4y+12 \\\\ 5(x-1)^{2} & =4(y+3) \\\\ (x-1)^{2} & =\\frac{4}{5}(y+3) \\\\ (x-1)^{2} & =4(\\frac{1}{5})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (1,-3).$"}] [{:db/id #edb/ref 17592186346890 :knowledge-point/_questions [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fe92b88-6ffb-56f0-9fee-3dd81c002a88" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186346892} {:answer/id #uuid "93dc16b2-61fe-57c7-9e1b-ce961569a889" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186346893} {:answer/id #uuid "042b1080-b7d4-519b-94e2-fe7f5f38f3d9" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186346894} {:answer/id #uuid "ac87821a-cc0e-55c8-a8d6-102ef68746f1" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186346895} {:answer/id #uuid "9a3cb017-4bf9-5405-a1a9-0e6da55e5b1d" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-1)" :db/id #edb/ref 17592186346896}] :answer-field/correct {:answer/id #uuid "9a3cb017-4bf9-5405-a1a9-0e6da55e5b1d" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-1)" :db/id #edb/ref 17592186346896} :answer-field/id #uuid "4fd4964f-c573-5799-abae-6891aaea2e7d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346891}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6b83c7c7-5cc8-50a8-88f2-06b2797824da" :question/math-academy-id "q-103668" :question/problem "Calculate the coordinates of the vertex of the parabola ${x}^{2}+2x-2y-1=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+2x-2y-1 & =0 \\\\ {x}^{2}+2x & =2y+1 \\\\ (x+1)^{2}-1 & =2y+1 \\\\ (x+1)^{2} & =2y+1+1 \\\\ (x+1)^{2} & =2y+2 \\\\ (x+1)^{2} & =4(\\frac{1}{2})(y+1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-1,-1).$"}] [{:db/id #edb/ref 17592186346897 :knowledge-point/_questions [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73224360-f922-5e61-abcd-79aac2a9a6d9" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186346899} {:answer/id #uuid "dd0cef16-214d-5805-a244-cfc5a9c9f262" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186346900} {:answer/id #uuid "9331f245-4192-57bc-aeb8-864755c6737a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,4)" :db/id #edb/ref 17592186346901} {:answer/id #uuid "539333d0-03ad-5230-8a22-63e62e845b60" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186346902} {:answer/id #uuid "37a27760-2af6-574c-9415-0ff108c9525c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-3)" :db/id #edb/ref 17592186346903}] :answer-field/correct {:answer/id #uuid "37a27760-2af6-574c-9415-0ff108c9525c" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-3)" :db/id #edb/ref 17592186346903} :answer-field/id #uuid "d6d6be44-cfdd-5b02-8668-d6871ebb94bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346898}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "538f5e8c-c16f-5b57-abdc-bced6105f398" :question/math-academy-id "q-103675" :question/problem "Calculate the coordinates of the vertex of the parabola ${y}^{2}-8x+6y+49=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x+6y+49 & =0 \\\\ {y}^{2}+6y & =8x-49 \\\\ (y+3)^{2}-9 & =8x-49 \\\\ (y+3)^{2} & =8x-49+9 \\\\ (y+3)^{2} & =8x-40 \\\\ (y+3)^{2} & =8(x-5) \\\\ (y+3)^{2} & =4(2)(x-5)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,-3).$"}] [{:db/id #edb/ref 17592186346904 :knowledge-point/_questions [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1026e63-5cb7-57e1-9f81-baecad70ec48" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186346906} {:answer/id #uuid "4237e44f-9d05-5405-9e65-4f01bfa2f889" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186346907} {:answer/id #uuid "16e69bea-7e56-539a-b629-b6c3b1e5691d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346908} {:answer/id #uuid "2e859355-8ce1-5c84-ab41-7752b6f36053" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186346909} {:answer/id #uuid "74b92882-b12b-549d-8c8b-61336811aab4" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186346910}] :answer-field/correct {:answer/id #uuid "16e69bea-7e56-539a-b629-b6c3b1e5691d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346908} :answer-field/id #uuid "c22b9668-b470-500f-a648-907e76d86798" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346905}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5d598806-d2cc-567e-8388-50f260fc632a" :question/math-academy-id "q-103677" :question/problem "Calculate the coordinates of the vertex of the parabola $2{y}^{2}-x+4y=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}2{y}^{2}-x+4y & =0 \\\\ 2{y}^{2}+4y & =x \\\\ 2[{y}^{2}+2y] & =x \\\\ 2[(y+1)^{2}-1] & =x \\\\ 2(y+1)^{2}-2 & =x \\\\ 2(y+1)^{2} & =x+2 \\\\ (y+1)^{2} & =\\frac{1}{2}(x+2) \\\\ (y+1)^{2} & =4(\\frac{1}{8})(x+2)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-2,-1).$"}] [{:db/id #edb/ref 17592186346911 :knowledge-point/_questions [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e19687b-6433-58f7-9384-b99ceb562532" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-4)" :db/id #edb/ref 17592186346913} {:answer/id #uuid "d9c8019f-5145-5036-8787-276c440d5730" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186346914} {:answer/id #uuid "f52b007b-fd7f-5182-8210-717b301edba9" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186346915} {:answer/id #uuid "c142f931-6a6b-5e46-8757-5fbd90c94bee" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186346916} {:answer/id #uuid "c36e07be-10d5-5b65-acd