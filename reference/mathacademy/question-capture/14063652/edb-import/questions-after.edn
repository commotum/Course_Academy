owledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc26410-426d-5d80-822d-f475a00e4200" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 3)" :db/id #edb/ref 17592186168440} {:answer/id #uuid "fbd77b0f-f9c4-559d-89c6-3505cb36051d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186168441} {:answer/id #uuid "5cc61621-ac6e-5bce-aff1-c35f8afb6d80" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, 3)" :db/id #edb/ref 17592186168442} {:answer/id #uuid "7d445f5d-0470-54d4-9c80-100f1f6a581c" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186168443} {:answer/id #uuid "7e32d48d-8864-56d4-a33c-239178bfee1c" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186168444}] :answer-field/correct {:answer/id #uuid "7e32d48d-8864-56d4-a33c-239178bfee1c" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186168444} :answer-field/id #uuid "c44634d0-f8f3-59f3-89ab-330bb6ed6526" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168439}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "330d0d52-2b13-5441-8452-b279bf17bf67" :question/math-academy-id "q-11883" :question/problem "Calculate the coordinates of the vertex of the parabola $3{x}^{2}+6x+4y+15=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}+6x+4y+15 & =0 \\\\ 3{x}^{2}+6x & =-4y-15 \\\\ 3[{x}^{2}+2x] & =-4y-15 \\\\ 3[(x+1)^{2}-1] & =-4y-15 \\\\ 3(x+1)^{2}-3 & =-4y-15 \\\\ 3(x+1)^{2} & =-4y-15+3 \\\\ 3(x+1)^{2} & =-4y-12 \\\\ 3(x+1)^{2} & =-4(y+3) \\\\ (x+1)^{2} & =-\\frac{4}{3}(y+3) \\\\ (x+1)^{2} & =4(-\\frac{1}{3})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-1,-3).$"}] [{:db/id #edb/ref 17592186346932 :knowledge-point/_questions [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf3b9416-3fe8-51e8-855f-fe197b979580" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186346934} {:answer/id #uuid "9c5c5924-7b06-51c0-af6c-5c3162d97a97" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186346935} {:answer/id #uuid "aa24124f-cba2-52fa-9c45-7b34736000d9" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186346936} {:answer/id #uuid "a8d1da2b-2d72-59ef-a792-bb85c1eb223e" :answer/type {:db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186346937} {:answer/id #uuid "13e78480-ee22-5173-91c1-676584a8a64b" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186346938}] :answer-field/correct {:answer/id #uuid "bf3b9416-3fe8-51e8-855f-fe197b979580" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186346934} :answer-field/id #uuid "c208cbaf-08d4-59be-9cd5-6f81440588fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346933}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4d39c4a7-c781-5873-9f1a-44bb25d738ff" :question/math-academy-id "q-11884" :question/problem "Calculate the coordinates of the vertex of the parabola $3{x}^{2}-30x-8y+67=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-30x-8y+67 & =0 \\\\ 3{x}^{2}-30x & =8y-67 \\\\ 3[{x}^{2}-10x] & =8y-67 \\\\ 3[(x-5)^{2}-25] & =8y-67 \\\\ 3(x-5)^{2}-75 & =8y-67 \\\\ 3(x-5)^{2} & =8y-67+75 \\\\ 3(x-5)^{2} & =8y+8 \\\\ 3(x-5)^{2} & =8(y+1) \\\\ (x-5)^{2} & =\\frac{8}{3}(y+1) \\\\ (x-5)^{2} & =4(\\frac{2}{3})(y+1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,-1).$"}] [{:db/id #edb/ref 17592186346939 :knowledge-point/_questions [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4438b56-0096-5908-84ef-fd34541b4776" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,4)" :db/id #edb/ref 17592186346941} {:answer/id #uuid "6858a2dc-8413-5f05-b501-681560ec2bcb" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186346942} {:answer/id #uuid "cfa6c06f-e4f2-5a98-a454-c678cd69af67" :answer/type {:db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186346943} {:answer/id #uuid "5b570929-d4a1-56ed-87f7-a029a0f7e2a6" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186346944} {:answer/id #uuid "dcdd0ca0-5ea3-5703-a120-5b6cae2df2ad" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186346945}] :answer-field/correct {:answer/id #uuid "6858a2dc-8413-5f05-b501-681560ec2bcb" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186346942} :answer-field/id #uuid "04975c8e-5a7c-57ca-aef4-63b8cff28d14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346940}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "611bd0c9-a37c-54fc-8ed4-cf3e0139b18b" :question/math-academy-id "q-85080" :question/problem "Calculate the coordinates of the vertex of the parabola $5{x}^{2}+30x+2y+41=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}+30x+2y+41 & =0 \\\\ 5{x}^{2}+30x & =-2y-41 \\\\ 5[{x}^{2}+6x] & =-2y-41 \\\\ 5[(x+3)^{2}-9] & =-2y-41 \\\\ 5(x+3)^{2}-45 & =-2y-41 \\\\ 5(x+3)^{2} & =-2y-41+45 \\\\ 5(x+3)^{2} & =-2y+4 \\\\ 5(x+3)^{2} & =-2(y-2) \\\\ (x+3)^{2} & =-\\frac{2}{5}(y-2) \\\\ (x+3)^{2} & =4(-\\frac{1}{10})(y-2)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(-3,2).$"}] [{:db/id #edb/ref 17592186346946 :knowledge-point/_questions [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50d07f0c-46f5-5322-8156-496b40c0b512" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186346948} {:answer/id #uuid "a6ae2bda-b898-5cbf-8b30-c5be5ba7c14e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186346949} {:answer/id #uuid "2aa2cc3d-c485-5e3e-8f99-d2b52fc2a685" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186346950} {:answer/id #uuid "66836616-8131-5456-be95-65592d8ea867" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186346951} {:answer/id #uuid "c413c65e-884d-5f5e-9fb9-dc70c574af46" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186346952}] :answer-field/correct {:answer/id #uuid "2aa2cc3d-c485-5e3e-8f99-d2b52fc2a685" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186346950} :answer-field/id #uuid "9982d8b0-aa2b-578f-88bd-4fbc2c1d62e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346947}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c12418db-55af-52a9-bb6a-8cc90c7d2c59" :question/math-academy-id "q-86523" :question/problem "Calculate the coordinates of the vertex of the parabola $3{y}^{2}-2x+18y+29=0.$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}3{y}^{2}-2x+18y+29 & =0 \\\\ 3{y}^{2}+18y & =2x-29 \\\\ 3[{y}^{2}+6y] & =2x-29 \\\\ 3[(y+3)^{2}-9] & =2x-29 \\\\ 3(y+3)^{2}-27 & =2x-29 \\\\ 3(y+3)^{2} & =2x-29+27 \\\\ 3(y+3)^{2} & =2x-2 \\\\ 3(y+3)^{2} & =2(x-1) \\\\ (y+3)^{2} & =\\frac{2}{3}(x-1) \\\\ (y+3)^{2} & =4(\\frac{1}{6})(x-1)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(1,-3).$"}]}
