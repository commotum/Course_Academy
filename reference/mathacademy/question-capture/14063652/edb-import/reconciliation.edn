-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-4x-4y+24 & =0 \\\\ {y}^{2}-4y & =4x-24 \\\\ (y-2)^{2}-4 & =4x-24 \\\\ (y-2)^{2} & =4x-24+4 \\\\ (y-2)^{2} & =4x-20 \\\\ (y-2)^{2} & =4(x-5) \\\\ (y-2)^{2} & =4(1)(x-5)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103680" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/activity-metadata.json" "file_sha256" "f6221ff180acafaeaafdf9a9050db5cc20ab72ce4073d30ccfe6cc85ac2a58be"} {"question" "q-103680" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103680" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-1,4)"] ["math" "(-1,5)"] ["math" "(2,-2)"] ["math" "(5,-1)"] ["math" "(5,2)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103680" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(5,2)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103675" "field" nil "attribute" "question/problem" "value" "Calculate the coordinates of the vertex of the parabola ${y}^{2}-8x+6y+49=0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103675" "field" nil "attribute" "question/worked-solution" "value" "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x+6y+49 & =0 \\\\ {y}^{2}+6y & =8x-49 \\\\ (y+3)^{2}-9 & =8x-49 \\\\ (y+3)^{2} & =8x-49+9 \\\\ (y+3)^{2} & =8x-40 \\\\ (y+3)^{2} & =8(x-5) \\\\ (y+3)^{2} & =4(2)(x-5)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(5,-3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103675" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/activity-metadata.json" "file_sha256" "f6221ff180acafaeaafdf9a9050db5cc20ab72ce4073d30ccfe6cc85ac2a58be"} {"question" "q-103675" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103675" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-2,5)"] ["math" "(2,-3)"] ["math" "(2,4)"] ["math" "(5,-2)"] ["math" "(5,-3)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "q-103675" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(5,-3)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/state.json" "file_sha256" "7626fb3aadf54178c3dab5c6dae5c454714220bb44f31faaeaae6744128c066f"} {"question" "e-7471" "field" nil "attribute" "question/problem" "value" "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/example-7471.json" "file_sha256" "f8a8a8df9dd31ed2c0def18e9a4d74a3f4d2c47df729097a90bad28836565960"} {"question" "e-7471" "field" nil "attribute" "question/worked-solution" "value" "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}5{x}^{2}-10x-4y-7 & =0 \\\\ 5{x}^{2}-10x & =4y+7 \\\\ 5[{x}^{2}-2x] & =4y+7 \\\\ 5[(x-1)^{2}-1] & =4y+7 \\\\ 5(x-1)^{2}-5 & =4y+7 \\\\ 5(x-1)^{2} & =4y+7+5 \\\\ 5(x-1)^{2} & =4y+12 \\\\ 5(x-1)^{2} & =4(y+3) \\\\ (x-1)^{2} & =\\frac{4}{5}(y+3) \\\\ (x-1)^{2} & =4(\\frac{1}{5})(y+3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (1,-3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/example-7471.json" "file_sha256" "f8a8a8df9dd31ed2c0def18e9a4d74a3f4d2c47df729097a90bad28836565960"} {"question" "e-5344" "field" nil "attribute" "question/problem" "value" "Calculate the coordinates of the vertex of the parabola $y^2 - 8x - 6y + 33 = 0$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/example-5344.json" "file_sha256" "53252a9117e1acda7e7f98cc49a7c640f73e396fa5a1a7f5e9192335ba0c1298"} {"question" "e-5344" "field" nil "attribute" "question/worked-solution" "value" "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h),\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-8x-6y+33 & =0 \\\\ {y}^{2}-6y & =8x-33 \\\\ (y-3)^{2}-9 & =8x-33 \\\\ (y-3)^{2} & =8x-33+9 \\\\ (y-3)^{2} & =8x-24 \\\\ (y-3)^{2} & =8(x-3) \\\\ (y-3)^{2} & =4(2)(x-3)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k) = (3,3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063652/example-5344.json" "file_sha256" "53252a9117e1acda7e7f98cc49a7c640f73e396fa5a1a7f5e9192335ba0c1298"}] "usage" {"q-11883" [] "e-5344" [] "e-7471" []} "basis" 2071 "retractions" [[17592186172206 :question/problem "Calculate the coordinates of the vertex of the parabola $3x^{2} + 6x + 4y + 15 = 0$."] [17592186171755 :question/problem "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0$."] [17592186171755 :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k)\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}\n5x^{2} - 10x - 4y - 7 &= 0 \\\\\n5x^{2} - 10x &= 4y + 7 \\\\\n5[x^{2} - 2x] &= 4y + 7 \\\\\n5[(x - 1)^{2} - 1] &= 4y + 7 \\\\\n5(x - 1)^{2} - 5 &= 4y + 7 \\\\\n5(x - 1)^{2} &= 4y + 7 + 5 \\\\\n5(x - 1)^{2} &= 4y + 12 \\\\\n5(x - 1)^{2} &= 4(y + 3) \\\\\n(x - 1)^{2} &= \\frac{4}{5}(y + 3) \\\\\n(x - 1)^{2} &= 4(\\frac{1}{5})(y + 3)\n\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are\n\n$$\n(h,k) = (1,-3)\n$$"] [17592186171742 :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h)\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}\ny^{2} - 8x - 6y + 33 &= 0 \\\\\ny^{2} - 6y &= 8x - 33 \\\\\n(y - 3)^{2} - 9 &= 8x - 33 \\\\\n(y - 3)^{2} &= 8x - 33 + 9 \\\\\n(y - 3)^{2} &= 8x - 24 \\\\\n(y - 3)^{2} &= 8(x - 3) \\\\\n(y - 3)^{2} &= 4(2)(x - 3)\n\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are\n\n$$\n(h,k) = (3,3)\n$$"]] "immutable_answers" [17592186168440 17592186168441 17592186168442 17592186168443 17592186168444] "immutable_fields" [[17592186168439 :answer-field/correct] [17592186168439 :answer-field/id] [17592186168439 :answer-field/key] [17592186168439 :answer-field/type]] "no_history" []}
