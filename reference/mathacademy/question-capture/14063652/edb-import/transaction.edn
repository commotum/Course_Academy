4,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103679/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd"] :knowledge-point/questions ["q-103679"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86523/selection/66e9706a41786654138bad54e9f9465d1eb13af1723fccd92995cfc8619107f7" :answer/id #uuid "2aa2cc3d-c485-5e3e-8f99-d2b52fc2a685" :answer/type :answer.type/math :answer/value "(1,-3)" :db/ensure [:answer/validate]} {:db/id "q-86523/selection/401028d5b9270d38e1d29135724ad40402f59019069c5cc7877bbd313667b0b6" :answer/id #uuid "50d07f0c-46f5-5322-8156-496b40c0b512" :answer/type :answer.type/math :answer/value "(3,-1)" :db/ensure [:answer/validate]} {:db/id "q-86523/selection/625f40a59af0f5938119dbedf38d07692ba9d02d04e5cf360117ecca1c5ee729" :answer/id #uuid "a6ae2bda-b898-5cbf-8b30-c5be5ba7c14e" :answer/type :answer.type/math :answer/value "(-3,2)" :db/ensure [:answer/validate]} {:db/id "q-86523/selection/a0df205a085a017b83e0565c9c57a6cf159145bbbd452ad77949f13f41582921" :answer/id #uuid "66836616-8131-5456-be95-65592d8ea867" :answer/type :answer.type/math :answer/value "(-3,-1)" :db/ensure [:answer/validate]} {:db/id "q-86523/selection/c6a1f0b35fb86f12a0e1138b6e2c0461f265df1c7e058c326ad8966bfd682852" :answer/id #uuid "c413c65e-884d-5f5e-9fb9-dc70c574af46" :answer/type :answer.type/math :answer/value "(2,-3)" :db/ensure [:answer/validate]} {:db/id "q-86523/selection" :answer-field/id #uuid "9982d8b0-aa2b-578f-88bd-4fbc2c1d62e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86523/selection/66e9706a41786654138bad54e9f9465d1eb13af1723fccd92995cfc8619107f7" :answer-field/choices ["q-86523/selection/66e9706a41786654138bad54e9f9465d1eb13af1723fccd92995cfc8619107f7" "q-86523/selection/401028d5b9270d38e1d29135724ad40402f59019069c5cc7877bbd313667b0b6" "q-86523/selection/625f40a59af0f5938119dbedf38d07692ba9d02d04e5cf360117ecca