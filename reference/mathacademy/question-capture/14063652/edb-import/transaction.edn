stion/difficulty :question.difficulty/moderate :question/answer-fields ["q-11884/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca"] :knowledge-point/questions ["q-11884"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11880/selection/e39a0b2bafcf40b535faa3427e30b1fbe141ca721fa0296e2c83009a372fbed5" :answer/id #uuid "4669e448-4031-5f81-8ced-7f76058b3b71" :answer/type :answer.type/math :answer/value "(4,5)" :db/ensure [:answer/validate]} {:db/id "q-11880/selection/8fbd2d3f8fec30b8988b313ab55584eaf14bae431349fa2771dc259291903d20" :answer/id #uuid "33d29702-8bf0-5182-9f01-f34ad219d998" :answer/type :answer.type/math :answer/value "(3,5)" :db/ensure [:answer/validate]} {:db/id "q-11880/selection/2b8de20aca599b94cdd36df4676f28adcba3994b9b9b1e6c286d50858d21c25a" :answer/id #uuid "cd4d0cf1-f0a5-5122-86e2-223cf3305274" :answer/type :answer.type/math :answer/value "(-3,-5)" :db/ensure [:answer/validate]} {:db/id "q-11880/selection/4b2d3effbade2d09a12f01f379ddce1dae02aadbdcde760910a4cb0b306512a1" :answer/id #uuid "8d80c8de-15a5-5ce5-ad71-28194510b985" :answer/type :answer.type/math :answer/value "(-5,-3)" :db/ensure [:answer/validate]} {:db/id "q-11880/selection/c1d3aef88b1fb7ecf3fddb51dcad568a6bd266e00ada20f42f03e60154928af1" :answer/id #uuid "ea7c183c-03b1-518e-90f5-713dfc13fd2f" :answer/type :answer.type/math :answer/value "(5,3)" :db/ensure [:answer/validate]} {:db/id "q-11880/selection" :answer-field/id #uuid "aea25f30-05cc-5c77-8b55-333d1134436e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11880/selection/8fbd2d3f8fec30b8988b313ab55584eaf14bae431349fa2771dc259291903d20" :answer-field/choices ["q-11880/selection/e39a0b2bafcf40b535faa3427e30b1fbe141ca721fa0296e2c83009a372fbed5" "q-11880/selection/8fbd2d3f8fec30b8988b313ab55584eaf14bae431349fa2771dc259291903d20" "q-11880/selection/2b8de20aca599b94cdd36df4676f28adcba3994b9b9b1e6c286d50858d21c25a" "q-11880/selection/4b2d3effbade2d09a12f01f379ddce1dae02aadbdcde760910a4cb0b306512a1" "q-11880/selection/c1d3aef88b1fb7ecf3fddb51dcad568a6bd266e00ada20f42f03e60154928af1"] :db/ensure [:answer-field/validate]} {:db/id "q-11880" :question/id #uuid "7277a392-ac08-55b9-987a-df87176d1a05" :question/math-academy-id "q-11880" :question/problem "Calculate the coordinates of the vertex of the parabola ${x}^{2}-6x-2y+19=0.$" :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nwhere $p$ is constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-6x-2y+19 & =0 \\\\ {x}^{2}-6x & =2y-19 \\\\ (x-3)^{2}-9 & =2y-19 \\\\ (x-3)^{2} & =2y-19+9 \\\\ (x-3)^{2} & =2y-10 \\\\ (x-3)^{2} & =2(y-5) \\\\ (x-3)^{2} & =4(\\frac{1}{2})(y-5)\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are $(h,k)=(3,5).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11880/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca"] :knowledge-point/questions ["q-11880"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103668/selection/1d77d86dae2ed61625b4af15a6dd7a32243e0b9026ac7b1e9c222245e5eff213" :answer/id #uuid "5fe92b88-6ffb-56f0-9fee-3dd81c002a88" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "q-103668/selection/8fbef25e0013385c5c4de2827f3f6377bb56f3bc145afd16f5385c69df073111" :answer/id #uuid "042b1080-b7d4-519b-94e2-fe7f5f38f3d9" :answer/type :answer.type/math :answer/value "(-2,1)" :db/ensure [:answer/validate]} {:db/id "q-103668/selection/cc0e4f4e8d080594555a574b002679d62af8dcf6204de501ba97ce5b2e6759ab" :answer/id #uuid "9a3cb017-4bf9-5405-a1a9-0e6da55e5b1d" :answer/type :answer.type/math :answer/value "(-1,-1)" :db/ensure [:answer/v