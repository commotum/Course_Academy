#{[{:db/id #edb/ref 17592186171742 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "393cdd18-ede6-5870-94ad-a093e67db2fd" :knowledge-point/title "Calculating the Vertex of a Horizontal Parabola by Completing the Square"}] :question/id #uuid "ef170346-47b1-5ce7-a99d-070021b3fb81" :question/math-academy-id "e-5344" :question/problem "Calculate the coordinates of the vertex of the parabola $y^2 - 8x - 6y + 33 = 0$." :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^2 = 4p(x-h)\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $y$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}\ny^{2} - 8x - 6y + 33 &= 0 \\\\\ny^{2} - 6y &= 8x - 33 \\\\\n(y - 3)^{2} - 9 &= 8x - 33 \\\\\n(y - 3)^{2} &= 8x - 33 + 9 \\\\\n(y - 3)^{2} &= 8x - 24 \\\\\n(y - 3)^{2} &= 8(x - 3) \\\\\n(y - 3)^{2} &= 4(2)(x - 3)\n\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are\n\n$$\n(h,k) = (3,3)\n$$"}] [{:db/id #edb/ref 17592186171755 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/id #uuid "a7f9f74b-e213-5f38-8cb2-b9352ee515ad" :question/math-academy-id "e-7471" :question/problem "Calculate the coordinates of the vertex of the parabola $5x^2 -10x - 4y - 7 = 0$." :question/worked-solution "The standard equation of an upward- or downward-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(x-h)^2 = 4p(y-k)\n$$\n\nwhere $p$ is a constant.\n\nTo write the given equation in this form, we need to group the $x$-terms on the left-hand side and complete the square, as follows:\n\n$$\n\\begin{aligned}\n5x^{2} - 10x - 4y - 7 &= 0 \\\\\n5x^{2} - 10x &= 4y + 7 \\\\\n5[x^{2} - 2x] &= 4y + 7 \\\\\n5[(x - 1)^{2} - 1] &= 4y + 7 \\\\\n5(x - 1)^{2} - 5 &= 4y + 7 \\\\\n5(x - 1)^{2} &= 4y + 7 + 5 \\\\\n5(x - 1)^{2} &= 4y + 12 \\\\\n5(x - 1)^{2} &= 4(y + 3) \\\\\n(x - 1)^{2} &= \\frac{4}{5}(y + 3) \\\\\n(x - 1)^{2} &= 4(\\frac{1}{5})(y + 3)\n\\end{aligned}\n$$\n\nTherefore, the coordinates of the vertex are\n\n$$\n(h,k) = (1,-3)\n$$"}] [{:db/id #edb/ref 17592186172206 :knowledge-point/_questions [{:knowledge-point/id #uuid "744f58f2-59be-552a-bb2f-d0819f35c1ca" :knowledge-point/title "Calculating the Vertex of a Vertical Parabola by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc26410-426d-5d80-822d-f475a00e4200" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 3)" :db/id #edb/ref 17592186168440} {:answer/id #uuid "fbd77b0f-f9c4-559d-89c6-3505cb36051d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186168441} {:answer/id #uuid "5cc61621-ac6e-5bce-aff1-c35f8afb6d80" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, 3)" :db/id #edb/ref 17592186168442} {:answer/id #uuid "7d445f5d-0470-54d4-9c80-100f1f6a581c" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186168443} {:answer/id #uuid "7e32d48d-8864-56d4-a33c-239178bfee1c" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186168444}] :answer-field/correct {:answer/id #uuid "7e32d48d-8864-56d4-a33c-239178bfee1c" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186168444} :answer-field/id #uuid "c44634d0-f8f3-59f3-89ab-330bb6ed6526" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168439}] :question/id #uuid "330d0d52-2b13-5441-8452-b279bf17bf67" :question/math-academy-id "q-11883" :question/problem "Calculate the coordinates of the vertex of the parabola $3x^{2} + 6x + 4y + 15 = 0$."}]}
