hacademy/question-capture-workers/linear/14044251/state.json" "file_sha256" "cd54b31305739ec8ae99d7d9b9907b51839e10b2b4c1e1568412700b9e606c11" "basis" 1644 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/edb-import/verification.json"} {"question" "q-73620" "field" nil "attribute" "question/worked-solution" "value" "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $3$rd and $5$th columns." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/state.json" "file_sha256" "cd54b31305739ec8ae99d7d9b9907b51839e10b2b4c1e1568412700b9e606c11" "basis" 1644 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/edb-import/verification.json"} {"question" "q-73620" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/activity-metadata.json" "file_sha256" "68f8816ea43ac3c3244e51fc9497ca2fffb25c4763b1771e2ba195e86de5fbd2" "basis" 1644 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/edb-import/verification.json"} {"question" "q-73620" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044251/state.json" "file_sha256" "cd54b31305739ec8ae99d7d9b9907b51839e10b2b4c1e1568412700b9e606c11" "bas