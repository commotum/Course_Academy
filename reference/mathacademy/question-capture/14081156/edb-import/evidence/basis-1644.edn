#{[{:db/id #edb/ref 17592186322425 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132a235f-13c0-504d-bad1-9b2909cce7f7" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186322427} {:answer/id #uuid "87fd7682-ece8-5a43-bba4-4d062c1cbbad" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $5$th only" :db/id #edb/ref 17592186322428} {:answer/id #uuid "919a724d-ddc8-5dff-8dec-b8efa924874d" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186322429} {:answer/id #uuid "9b697cd5-fc51-5252-afd6-c02659b8a2b3" :answer/type {:db/ident :answer.type/text} :answer/value "$5$th only" :db/id #edb/ref 17592186322430} {:answer/id #uuid "029734f4-650f-50ee-bf1c-62a8b61fdb63" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd, $4$th, and $5$th only" :db/id #edb/ref 17592186322431}] :answer-field/correct {:answer/id #uuid "919a724d-ddc8-5dff-8dec-b8efa924874d" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186322429} :answer-field/id #uuid "fa67b964-21e7-51ef-9502-6cf701b3f74c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322426}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e65644f1-643f-5cec-a338-633970614cd1" :question/math-academy-id "q-73620" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $3$rd and $5$th columns."}]}
