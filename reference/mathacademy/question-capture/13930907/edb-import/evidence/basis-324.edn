wer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/e592604fd1ad241d29c9c78ea9dd2d1876f1dadf393c56cceeb40ee3ef3487be.png" :db/id #edb/ref 17592186243136} {:answer/id #uuid "8bfd7e7a-4af9-5dd1-a785-fc04c105885b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/b5c133b4a0ba0d8cb2b54ac4baf815f00f87f8b6120693e9cd3e8c2ad1b351b9.png" :db/id #edb/ref 17592186243137} {:answer/id #uuid "d346e2a6-4cb8-5432-83b0-e7e80db14a5d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/b6216233aafdda4cc4a2de499d532951e7c241b773e7d6e8f9a7a12a9d610436.png" :db/id #edb/ref 17592186243138} {:answer/id #uuid "d9b998f1-a47c-591a-9cbb-28a4f49a035b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/e6586917f318ad60f2a49b609c517b8cda4e6d36f2a9a275c534870ae57df415.png" :db/id #edb/ref 17592186243139}] :answer-field/correct {:answer/id #uuid "d346e2a6-4cb8-5432-83b0-e7e80db14a5d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/b6216233aafdda4cc4a2de499d532951e7c241b773e7d6e8f9a7a12a9d610436.png" :db/id #edb/ref 17592186243138} :answer-field/id #uuid "c10886b1-933f-5a9c-9a01-0974300921d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243134}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9f9c9217-dcbf-5de4-8d95-24d9f5f3f6cb" :question/is-example false :question/math-academy-id "q-170590" :question/problem "Which of the following is the graph of $y={(\\frac{5}{3})}^{x}+1?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{5}{3})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/ff62aa6e655becc0a34af9f47b89d06ea8b22fec1644f8a4b1edacb82b794e83.png)\n\nTo sketch the graph of $y={(\\frac{5}{3})}^{x}+1,$ we take the graph of $y={(\\frac{5}{3})}^{x}$ and shift it $1$ unit up. The $y$-intercept moves from $(0,1)$ to $(0,2),$ and the horizontal asymptote moves from $y=0$ to $y=1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/f66b03cccba11fccc8574ba757cacf3fa87f226644f1c422a34a3c56908819ad.png)"}] [{:db/id #edb/ref 17592186243140 :knowledge-point/_questions [{:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec56ad9-e582-5906-8890-adc9b12076c0" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1.5)" :db/id #edb/ref 17592186243142} {:answer/id #uuid "fee2e70d-1869-5acd-a9e0-5c8aaed5bf7e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186243143} {:answer/id #uuid "edb4f1c2-c8ee-5413-a23f-45cb6d8f346a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,5)" :db/id #edb/ref 17592186243144} {:answer/id #uuid "08b6825e-dd61-525c-a509-def3f70ef93c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186243145} {:answer/id #uuid "366a1e40-3e61-5dc3-9eed-6134d54e5d44" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2.5)" :db/id #edb/ref 17592186243146}] :answer-field/correct {:answer/id #uuid "366a1e40-3e61-5dc3-9eed-6134d54e5d44" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2.5)" :db/id #edb/ref 17592186243146} :answer-field/id #uuid "90de2cb8-a86b-582c-b4c9-78d1405158b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243141}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "044be021-af1b-58f6-8166-5de9f8623207" :question/is-example false :question/math-academy-id "q-170594" :question/problem "For the curve $y=1.5({4}^{x})+1,$ find the point of intersection with the $y$-axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={4}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({4}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $1$ unit up, we get a point with the $y$-coordinate\n\n$$\ny=1.5+1=2.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({4}^{0})+1 \\\\  & =1.5\\cdot 1+1 \\\\  & =1.5+1 \\\\  & =2.5\\end{aligned}\n$$\n\nTherefore, $y=1.5({4}^{x})+1,$ intercepts the $y$-axis at $(0,2.5).$"}] [{:db/id #edb/ref 17592186243147 :knowledge-point/_questions [{:knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9d8ea52-f1e3-5b8f-a729-a37e4c96c1d4" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}-10" :db/id #edb/ref 17592186243149} {:answer/id #uuid "dea4c775-752f-5f8a-bbb0-a54cdebe30eb" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}+15" :db/id #edb/ref 17592186243150} {:answer/id #uuid "99c609af-289f-53be-9d1f-1f1932c485fe" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}+11" :db/id #edb/ref 17592186243151} {:answer/id #uuid "8e91690a-05f3-567b-b271-c01f46a5d8ba" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}+10" :db/id #edb/ref 17592186243152} {:answer/id #uuid "03ffa133-004b-5b21-9b9a-49363d842ef2" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}-11" :db/id #edb/ref 17592186243153}] :answer-field/correct {:answer/id #uuid "8e91690a-05f3-567b-b271-c01f46a5d8ba" :answer/type {:db/ident :answer.type/math} :answer/value "y={25}^{x}+10" :db/id #edb/ref 17592186243152} :answer-field/id #uuid "6552390f-0aa6-511d-8375-943b6916df9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243148}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "579a4ba5-6e28-50c1-a811-da98f7d3570b" :question/is-example false :question/math-academy-id "q-26804" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/b05d0a8e3d11d2fb1fe9018b17962f3c3cd7137bd91739a249d3bbe28371366b.png)\n\nThe graph above shows the curve $y={25}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={25}^{x}$ is $y=0.$ The vertical translation $y={25}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=10.$ Therefore, $c=10.$"}] [{:db/id #edb/ref 17592186243154 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b0095a-5c21-5353-bc7f-1c58dd725ba1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/ab4f8abb0d6f0739928f379ced41063e1fdcef5f008045aef53736fdddbdce02.png" :db/id #edb/ref 17592186243156} {:answer/id #uuid "2d5f004d-12c8-59a5-a81b-d5ce7a7ce420" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/007764e0a0352178f8dc7b3480c445fcc3c58d51c0220837bc4ab84efe6