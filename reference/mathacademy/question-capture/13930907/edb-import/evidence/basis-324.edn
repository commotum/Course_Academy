or $k:$\n\n$$\n\\begin{aligned}y & =k({3}^{x})+2 \\\\ 5 & =k({3}^{0})+2 \\\\ 5 & =k(1)+2 \\\\ 5 & =k+2 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({3}^{x})+2.$"}] [{:db/id #edb/ref 17592186243238 :knowledge-point/_questions [{:knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3666cbda-ca9f-5956-b1fc-3e0aec99becd" :answer/type {:db/ident :answer.type/math} :answer/value "y={7}^{x}" :db/id #edb/ref 17592186243240} {:answer/id #uuid "8e1476f2-e7ad-5556-ad57-7af67c1976af" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5({7}^{x})" :db/id #edb/ref 17592186243241} {:answer/id #uuid "f614d023-f9ce-5924-9430-915fdc1460b4" :answer/type {:db/ident :answer.type/math} :answer/value "y={7}^{x}-5" :db/id #edb/ref 17592186243242} {:answer/id #uuid "96a155e5-f99d-53ad-be90-672ffe9f6aef" :answer/type {:db/ident :answer.type/math} :answer/value "y={7}^{x}+5" :db/id #edb/ref 17592186243243} {:answer/id #uuid "598d6398-739b-5519-b00f-b9653a12bb49" :answer/type {:db/ident :answer.type/math} :answer/value "y=5({7}^{x})" :db/id #edb/ref 17592186243244}] :answer-field/correct {:answer/id #uuid "f614d023-f9ce-5924-9430-915fdc1460b4" :answer/type {:db/ident :answer.type/math} :answer/value "y={7}^{x}-5" :db/id #edb/ref 17592186243242} :answer-field/id #uuid "791dd545-e6d9-5582-ade7-f4543d8c3a0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243239}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e3895eed-142e-575e-9dc8-ac455f52b8d9" :question/is-example false :question/math-academy-id "q-99774" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/d80c45f952e4c8a65349be524849104b1a76e6ee276186646c6c3facd83c8181