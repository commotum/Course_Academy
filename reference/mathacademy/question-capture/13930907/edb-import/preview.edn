ake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/bbdfe3e538e840385c082f16ca2cdfd07a7731c561d05cab6e7a25f487cdf463.png" 13194139533636 true] [17592186243173 1103 #edb/ref 17592186045452 13194139533636 true] [17592186243173 1111 #uuid "1a7f3cfe-3b30-5f74-9ec8-89916ccfb73f" 13194139533636 true] [17592186243174 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/6674add26b7a15f5b09c53a832d649979484f0ffd41b440069dd5230cd9a5187.png" 13194139533636 true] [17592186243174 1103 #edb/ref 17592186045452 13194139533636 true] [17592186243174 1111 #uuid "ff9aadce-66f8-5bec-9ff6-f3b26e3361d3" 13194139533636 true] [17592186243175 1017 #edb/ref 17592186243176 13194139533636 true] [17592186243175 1089 "q-29233" 13194139533636 true] [17592186243175 1091 #edb/ref 17592186045463 13194139533636 true] [17592186243175 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/e20c8b73d3e46aa90c5d37a30d8343c98d6c6b0f3f17a232580583a8ae812125.png)\n\nThe graph above shows $y=k({2}^{x})+c.$ Find the value of $k$ and $c.$" 13194139533636 true] [17592186243175 1113 #uuid "50d9e785-c783-5e7b-a19a-46b5b93eacd8" 13194139533636 true] [17592186243175 1138 false 13194139533636 true] [17592186243175 1145 "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-2,$ so $c=-2.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-2.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-2 \\\\ 1 & =k({2}^{0})-2 \\\\ 1 & =k(1)-2 \\\\ 1 & =k-2 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, $k=3$ and $c=-2.$" 13194139533636 true] [17592186243176 1000 #edb/ref 17592186243177 13194139533636 true] [17592186243176 1000 #edb/ref 17592186243178 13194139533636 true] [17592186243176 1000 #edb/ref 17592186243179 13194139533636 true] [17592186243176 1000 #edb/ref 17592186243180 13194139533636 true] [17592186243176 1000 #edb/ref 17592186243181 13194139533636 true] [17592186243176 1040 #edb/ref 17592186045450 13194139533636 true] [17592186243176 1041 "selection" 13194139533636 true] [17592186243176 1104 #edb/ref 17592186243181 13194139533636 true] [17592186243176 1110 #uuid "def1725a-e53b-5370-ae60-f14121a6a98a" 13194139533636 true] [17592186243177 1034 "$k=2$ and $c=2$" 13194139533636 true] [17592186243177 1103 #edb/ref 17592186045454 13194139533636 true] [17592186243177 1111 #uuid "5c722140-882f-5084-8bb5-0d1f24754314" 13194139533636 true] [17592186243178 1034 "$k=-2$ and $c=-2$" 13194139533636 true] [17592186243178 1103 #edb/ref 17592186045454 13194139533636 true] [17592186243178 1111 #uuid "abe0c8e0-84b9-5cc9-a31c-f813433f1d89" 13194139533636 true] [17592186243179 1034 "$k=0$ and $c=-2$" 13194139533636 true] [17592186243179 1103 #edb/ref 17592186045454 13194139533636 true] [17592186243179 1111 #uuid "33a25ec1-82fa-5195-a165-b8dd4dde1293" 13194139533636 true] [17592186243180 1034 "$k=0$ and $c=2$" 13194139533636 true] [17592186243180 1103 #edb/ref 17592186045454 13194139533636 true] [17592186243180 1111 #uuid "f278ee7c-64e5-5ec3-ac51-984148937a96" 13194139533636 true] [17592186243181 1034 "$k=3$ and $c=-2$" 13194139533636 true] [17592186243181 1103 #edb/ref 17592186045454 13194139533636 true] [17592186243181 1111 #uuid "2270eb27-4010-5720-aa37-15e8d324c364" 13194139533636 true] [17592186243182 1017 #edb/ref 17592186243183 13194139533636 true] [17592186243182 1089 "q-30269" 13194139533636 true] [17592186243182 1091 #edb/ref 17592186045465 13194139533636 true] [17592186243182 1100 "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." 13194139533636 true] [17592186243182 1113 #uuid "40561353-6ae6-56d7-a244-8d424aca1309" 13194139533636 true] [17592186243182 1138 false 13194139533636 true] [17592186243182 1145 "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$" 13194139533636 true] [17592186243183 1000 #edb/ref 17592186243184 13194139533636 true] [17592186243183 1000 #edb/ref 17592186243185 13194139533636 true] [17592186243183 1000 #edb/ref 17592186243186 13194139533636 true] [17592186243183 1000 #edb/ref 17592186243187 13194139533636 true] [17592186243183 1000 #edb/ref 17592186243188 13194139533636 true] [17592186243183 1040 #edb/ref 17592186045450 13194139533636 true] [17592186243183 1041 "selection" 13194139533636 true] [17592186243183 1104 #edb/ref 17592186243187 13194139533636 true] [17592186243183 1110 #uuid "f62e9fd0-d581-5e28-a0ab-9c623924ddf1" 13194139533636 true] [17592186243184 1034 "(5.5,0)" 13194139533636 true] [17592186243184 1103 #edb/ref 17592186045453 13194139533636 true] [17592186243184 1111 #uuid "9d580471-c03d-55e5-9634-d181285c1113" 13194139533636 true] [17592186243185 1034 "(10.5,0)" 13194139533636 true] [17592186243185 1103 #edb/ref 17592186045453 13194139533636 true] [17592186243185 1111 #uuid "012e8bbd-148c-5705-beb6-74d5457cba4f" 13194139533636 true] [17592186243186 1034 "(0,11.5)" 13194139533636 true] [17592186243186 1103 #edb/ref 17592186045453 13194139533636 true] [17592186243186 1111 #uuid "732c8a0c-8c9b-58ed-87df-f1edb381041c" 13194139533636 true] [17592186243187 1034 "(0,10.5)" 13194139533636 true] [17592186243187 1103 #edb/ref 17592186045453 13194139533636 true] [17592186243187 1111 #uuid "00b1d9ff-e450-5ee7-9582-eeeafa197e90" 13194139533636 true] [17592186243188 1034 "(0,5.5)" 13194139533636 true] [17592186243188 1103 #edb/ref 17592186045453 13194139533636 true] [17592186243188 1111 #uuid "86a56d94-543b-5e19-8c4c-999be94bb974" 13194139533636 true] [17592186243189 1017 #edb/ref 17592186243190 13194139533636 true] [17592186243189 1089 "q-30873" 13194139533636 true] [17592186243189 1091 #edb/ref 17592186045465 13194139533636 true] [17592186243189 1100 "For the curve $y=1.5({10}^{x})-8.5$, find the point of intersection with the $y-$axis." 13194139533636 true] [17592186243189 1113 #uuid "95525d30-4708-5ca7-9a4e-37a9e46fc742" 13194139533636 true] [17592186243189 1138 false 13194139533636 true] [17592186243189 1145 "**Method 1**\n\n- For the curve $y={10}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({10}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $8.5$ units down, we get a point with the $y$-coordinate\n\n$$\ny=1.5-8.5=-7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({10}^{0})-8.5 \\\\  & =1.5\\cdot 1-8.5 \\\\  & =1.5-8.5 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=1.5({10}^{x})-8.5$ intercepts the $y$-axis at $(0,-7).$" 13194139533636 true] [17592186243190 1000 #edb/ref 17592186243191 13194139533636 true] [17592186243190 1000 #edb/ref 17592186243192 13194139533636 true] [17592186243190 1000 #edb/ref 17592186243193 13194139533636 true] [17592186243190 1000 #edb/ref 17592186243194 13194139533636 true] [17592186243190 1000 #edb/ref 17592186243195 13194139533636 true] [17592186243190 1040 #edb/ref 17592186045450 13194139533636 true] [17592186243190 1041 "selection" 13194139533636 true] [17592186243190 1104 #edb/ref 17592186243192 13194139533636 true] [17592186243190 1110 #uuid "3a493aef-cb5b-57bb-b771-f9d7b70c1586" 13