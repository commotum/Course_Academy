 we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2),$ but the horizontal asymptote stays at $y=0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/5a9871ac900e85c9f47118f6233b2e7f094af010dcb73e54221cadac01ce1644.png)\n\nFinally, we plot the graph of $y=2({3}^{x})-4.$ To do this, we shift the above graph $4$ units down. The $y$-intercept moves from $(0,2)$ to $(0,-2),$ and the horizontal asymptote moves from $y=0$ to $y=-4.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/89a7ee023e8d4232b617052efdc9844cb00b2e3f05968119cea11c89242ca61a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7121/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93"] :knowledge-point/questions ["q-7121"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30269/selection/5dc2199efb2d70deb941e6b8e378a2664d58ae1953fa240c1e58d9fe2adc2018" :answer/id #uuid "732c8a0c-8c9b-58ed-87df-f1edb381041c" :answer/type :answer.type/math :answer/value "(0,11.5)" :db/ensure [:answer/validate]} {:db/id "q-30269/selection/5290f2c9c880df791f27a1d089226457e7bff6c5e05ba5ee53392e5fd109489b" :answer/id #uuid "012e8bbd-148c-5705-beb6-74d5457cba4f" :answer/type :answer.type/math :answer/value "(10.5,0)" :db/ensure [:answer/validate]} {:db/id "q-30269/selection/cde7bb2e637497176833fd9327fd388b243471ef4da2aa7c49cdf33a339c3272" :answer/id #uuid "00b1d9ff-e450-5ee7-9582-eeeafa197e90" :answer/type :answer.type/math :answer/value "(0,10.5)" :db/ensure [:answer/validate]} {:db/id "q-30269/selection/f8ff18d7aaf53ed8318a4be008a6048dfbb4258b9100611407fbf7025f642b9c" :answer/id #uuid "86a56d94-543b-5e19-8c4c-999be94bb974" :answer/type :answer.type/math :answer/value "(0,5.5)" :db/ensure [:answer/validate]} {:db/id "q-30269/selection/00f95012f16ed1bef22adb34232779f280650796e3c0155aa5aad888083ec52b" :answer/id #uuid "9d580471-c03d-55e5-9634-d181285c1113" :answer/type :answer.type/math :answer/value "(5.5,0)" :db/ensure [:answer/validate]} {:db/id "q-30269/selection" :answer-field/id #uuid "f62e9fd0-d581-5e28-a0ab-9c623924ddf1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30269/selection/cde7bb2e637497176833fd9327fd388b243471ef4da2aa7c49cdf33a339c3272" :answer-field/choices ["q-30269/selection/5dc2199efb2d70deb941e6b8e378a2664d58ae1953fa240c1e58d9fe2adc2018" "q-30269/selection/5290f2c9c880df791f27a1d089226457e7bff6c5e05ba5ee53392e5fd109489b" "q-30269/selection/cde7bb2e637497176833fd9327fd388b243471ef4da2aa7c49cdf33a339c3272" "q-30269/selection/f8ff18d7aaf53ed8318a4be008a6048dfbb4258b9100611407fbf7025f642b9c" "q-30269/selection/00f95012f16ed1bef22adb34232779f280650796e3c0155aa5aad888083ec52b"] :db/ensure [:answer-field/validate]} {:db/id "q-30269" :question/id #uuid "40561353-6ae6-56d7-a244-8d424aca1309" :question/math-academy-id "q-30269" :question/is-example false :question/problem "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93"] :knowledge-point/questions ["q-30269"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-30270"] :question/worked-solution "**Method 1**\n\n- For the curve $y={6}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=5({6}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=5\\cdot 1=5.\n$$\n\n- Finally, after a vertical shift of $2$ units up, we get a point with the $y$-coordinate\n\n$$\ny=5+2=7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =5({6}^{0})+2 \\\\  & =5\\cdot 1+2 \\\\  & =5+2 \\\\  & =7\\end{aligned}\n$$\n\nTherefore, $y=5({6}^{x})+2$ intercepts the $y$-axis at $(0,7).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-170594/selection/a8d21c191bb52f35e36b7998de659bcfd3f034bae56d7de9f7b5454525c340d2" :answer/id #uuid "08b6825e-dd61-525c-a509-def3f70ef93c" :answer/type :answer.type/math :answer/value "(0,4)" :db/ensure [:answer/validate]} {:db/id "q-170594/selection/92ceb4efdc0cd986fcf6d914c334e6bc24d60c60afe74f5d1910588d4d342e77" :answer/id #uuid "edb4f1c2-c8ee-5413-a23f-45cb6d8f346a" :answer/type :answer.type/math :answer/value "(0,5)" :db/ensure [:answer/validate]} {:db/id "q-170594/selection/2fa95eaad0155bcd6838bf6a605e2cc1c96be26a8493c884ddc246e28c347329" :answer/id #uuid "5ec56ad9-e582-5906-8890-adc9b12076c0" :answer/type :answer.type/math :answer/value "(0,1.5)" :db/ensure [:answer/validate]} {:db/id "q-170594/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" :answer/id #uuid "fee2e70d-1869-5acd-a9e0-5c8aaed5bf7e" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "q-170594/selection/b5eea47f2eaf8b2575b894074fb7ff0b9ea6759bc875f80cb6168dd482ec7734" :answer/id #uuid "366a1e40-3e61-5dc3-9eed-6134d54e5d44" :answer/type :answer.type/math :answer/value "(0,2.5)" :db/ensure [:answer/validate]} {:db/id "q-170594/selection" :answer-field/id #uuid "90de2cb8-a86b-582c-b4c9-78d1405158b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170594/selection/b5eea47f2eaf8b2575b894074fb7ff0b9ea6759bc875f80cb6168dd482ec7734" :answer-field/choices ["q-170594/selection/a8d21c191bb52f35e36b7998de659bcfd3f034bae56d7de9f7b5454525c340d2" "q-170594/selection/92ceb4efdc0cd986fcf6d914c334e6bc24d60c60afe74f5d1910588d4d342e77" "q-170594/selection/2fa95eaad0155bcd6838bf6a605e2cc1c96be26a8493c884ddc246e28c347329" "q-170594/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" "q-170594/selection/b5eea47f2eaf8b2575b894074fb7ff0b9ea6759bc875f80cb6168dd482ec7734"] :db/ensure [:answer-field/validate]} {:db/id "q-170594" :question/id #uuid "044be021-af1b-58f6-8166-5de9f8623207" :question/math-academy-id "q-170594" :question/is-example false :question/problem "For the curve $y=1.5({4}^{x})+1,$ find the point of intersection with the $y$-axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={4}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({4}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $1$ unit up, we get a point with the $y$-coordinate\n\n$$\ny=1.5+1=2.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({4}^{0})+1 \\\\  & =1.5\\cdot 1+1 \\\\  & =1.5+1 \\\\  & =2.5\\end{aligned}\n$$\n\nTherefore, $y=1.5({4}^{x})+1,$ intercepts the $y$-axis at $(0,2.5).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170594/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93"] :knowledge-point/questions ["q-170594"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29233/selection/673b6e96094d13722f62dfb17b0e3f89943a7495098f42b7aae41838c9809fb7" :answer/id #uuid "f278ee7c-64e5-5ec3-ac51-984148937a96" :answer/type :answer.type/text :answer/value "$k=0$ and $c=2$" :db/ensure [:answer/validate]} {:db/id "q-29233/selection/0551c8494cce9538ab41f1d38e6a4df52ee8771c944f50f1092506e007df7c3b" :answer/id #uuid "5c722140-882f-5084-8bb5-0d1f24754314" :answer/type :answer.type/text :answer/value "$k=2$ and $c=2$" :db/ensure [:answer/validate]} {:db/id "q-29233/selection/5c4bba099e115e8abc327cc5398c2438c34194574c0e74b9a012176be82d3ba5" :answer/id #uuid "33a25ec1-82fa-5195-a165-b8dd4dde1293" :answer/type :answer.type/text :answer/value "$k=0$ and $c=-2$" :db/ensure [:answer/validate]} {:db/id "q-29233/selection/5aee842ea7e5d78eb6c05846a50d4e05cd7997e45d22c828bca7ed37552e8421" :answer/id #uuid "abe0c8e0-84b9-5cc9-a31c-f813433f1d89" :answer/type :answer.type/text :answer/value "$k=-2$ and $c=-2$" :db/ensure [:answer/validate]} {:db/id "q-29233/selection/e2a39016c3b78b0bc5e99461236f94ed82c3e176b2ce2bf27db7c3e360a7109f" :answer/id #uuid "2270eb27-4010-5720-aa37-15e8d324c364" :answer/type :answer.type/text :answer/value "$k=3$ and $c=-2$" :db/ensure [:answer/validate]} {:db/id "q-29233/selection" :answer-field/id #uuid "def1725a-e53b-5370-ae60-f14121a6a98a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29233/selection/e2a39016c3b78b0bc5e99461236f94ed82c3e176b2ce2bf27db7c3e360a7109f" :answer-field/choices ["q-29233/selection/673b6e96094d13722f62dfb17b0e3f89943a7495098f42b7aae41838c9809fb7" "q-29233/selection/0551c8494cce9538ab41f1d38e6a4df52ee8771c944f50f1092506e007df7c3b" "q-29233/selection/5c4bba099e115e8abc327cc5398c2438c34194574c0e74b9a012176be82d3ba5" "q-29233/selection/5aee842ea7e5d78eb6c05846a50d4e05cd7997e45d22c828bca7ed37552e8421" "q-29233/selection/e2a39016c3b78b0bc5e99461236f94ed82c3e176b2ce2bf27db7c3e360a7109f"] :db/ensure [:answer-field/validate]} {:db/id "q-29233" :question/id #uuid "50d9e785-c783-5e7b-a19a-46b5b93eacd8" :question/math-academy-id "q-29233" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/e20c8b73d3e46aa90c5d37a30d8343c98d6c6b0f3f17a232580583a8ae812125.png)\n\nThe graph above shows $y=k({2}^{x})+c.$ Find the value of $k$ and $c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-2,$ so $c=-2.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-2.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-2 \\\\ 1 & =k({2}^{0})-2 \\\\ 1 & =k(1)-2 \\\\ 1 & =k-2 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, $k=3$ and $c=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-29233/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef"] :knowledge-point/questions ["q-29233"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7239/selection/60f8174667e3483730e3b5f41cdf7e09aba868f2845ca1fceb2ef0a75b731a9e" :answer/id #uuid "844f2490-7b12-529a-b80e-0c35a7d52ef4" :answer/type :answer.type/math :answer/value "y={2}^{x}-1" :db/ensure [:answer/validate]} {:db/id "q-7239/selection/1440cd3e834c68ff14b159a51964aff0181e53450cd8a9451805a85b14a49943" :answer/id #uuid "953b6933-1cff-5ebc-91df-e58b50437bf3" :answer/type :answer.type/math :answer/value "y=3({2}^{x})+2" :db/ensure [:answer/validate]} {:db/id "q-7239/selection/c9439c3a87d7792d36cad1f09a7bdbae07fe98eac50f0c85ad077c6ec9110a75" :answer/id #uuid "72d344a4-e544-5a9f-8903-dc30db064235" :answer/type :answer.type/math :answer/value "y=2({2}^{x})-1" :db/ensure [:answer/validate]} {:db/id "q-7239/selection/201134005dc16f5b0e1cb0944be4bf7a76fd3d91e6df133db2481814bdac8162" :answer/id #uuid "45b0c147-a8e6-5f6f-9692-24d80337ec17" :answer/type :answer.type/math :answer/value "y=3({2}^{x})-2" :db/ensure [:answer/validate]} {:db/id "q-7239/selection/5995e4e30452d9d99795c014d1d58d00e6dbf9b2bb23e29efa7bc8a171b1d5e6" :answer/id #uuid "d7028a03-2d73-55d3-93cb-01575460b9b6" :answer/type :answer.type/math :answer/value "y=3({2}^{x})-1" :db/ensure [:answer/validate]} {:db/id "q-7239/selection" :answer-field/id #uuid "d5f1e821-3bea-5481-bc5e-f76e477663a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7239/selection/5995e4e30452d9d99795c014d1d58d00e6dbf9b2bb23e29efa7bc8a171b1d5e6" :answer-field/choices ["q-7239/selection/60f8174667e3483730e3b5f41cdf7e09aba868f2845ca1fceb2ef0a75b731a9e" "q-7239/selection/1440cd3e834c68ff14b159a51964aff0181e53450cd8a9451805a85b14a49943" "q-7239/selection/c9439c3a87d7792d36cad1f09a7bdbae07fe98eac50f0c85ad077c6ec9110a75" "q-7239/selection/201134005dc16f5b0e1cb0944be4bf7a76fd3d91e6df133db2481814bdac8162" "q-7239/selection/5995e4e30452d9d99795c014d1d58d00e6dbf9b2bb23e29efa7bc8a171b1d5e6"] :db/ensure [:answer-field/validate]} {:db/id "q-7239" :question/id #uuid "6b95ee2c-0cc4-59f6-8547-b33a98043811" :question/math-academy-id "q-7239" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/1ca11413bbce2ff307e494fb5a79028535b76cff24619e6921620f88c3e274ec.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1,$ so $c=-1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-1 \\\\ 2 & =k({2}^{0})-1 \\\\ 2 & =k(1)-1 \\\\ 2 & =k-1 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({2}^{x})-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7239/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef"] :knowledge-point/questions ["q-7239"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99778/selection/cf1404d4607f5a109c0d870d19c83d382d7a8f129550c2a494ada69fc905674f" :answer/id #uuid "f9c584c4-c3f1-5de4-abda-bb5ed8a7a059" :answer/type :answer.type/math :answer/value "y=4({5}^{x})-3" :db/ensure [:answer/validate]} {:db/id "q-99778/selection/55591c1830c58279282be348e98f6f6b8a8ecb754151f9e497ab25d0300d163e" :answer/id #uuid "aecfff04-64b7-576b-8272-922641e623cd" :answer/type :answer.type/math :answer/value "y=2({5}^{x})-1" :db/ensure [:answer/validate]} {:db/id "q-99778/selection/d1d585b7963f88408fa70e9b6dccfa69884f15f6e64e0378eb1ab97799fbbe4c" :answer/id #uuid "69f068cd-f63c-55e1-bc29-2be69780860d" :answer/type :answer.type/math :answer/value "y=3({5}^{x})-2" :db/ensure [:answer/validate]} {:db/id "q-99778/selection/2d31431d9662d1c78e07c1980280c65dbe0e55787b2bba9f4540713fb10eb970" :answer/id #uuid "915f2e1e-8564-572c-8f63-c1af64672b27" :answer/type :answer.type/math :answer/value "y=2({5}^{x})" :db/ensure [:answer/validate]} {:db/id "q-99778/selection/0d69660825d274d9bf5359b763471c74f8af73ec56bac43ea11defb902990afc" :answer/id #uuid "15183709-63f9-51df-a095-6afdd1af6c2f" :answer/type :answer.type/math :answer/value "y=3({5}^{x})+2" :db/ensure [:answer/validate]} {:db/id "q-99778/selection" :answer-field/id #uuid "a7902bcb-9113-5828-9abe-629de31c8d10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99778/selection/d1d585b7963f88408fa70e9b6dccfa69884f15f6e64e0378eb1ab97799fbbe4c" :answer-field/choices ["q-99778/selection/cf1404d4607f5a109c0d870d19c83d382d7a8f129550c2a494ada69fc905674f" "q-99778/selection/55591c1830c58279282be348e98f6f6b8a8ecb754151f9e497ab25d0300d163e" "q-99778/selection/d1d585b7963f88408fa70e9b6dccfa69884f15f6e64e0378eb1ab97799fbbe4c" "q-99778/selection/2d31431d9662d1c78e07c1980280c65dbe0e55787b2bba9f4540713fb10eb970" "q-99778/selection/0d69660825d274d9bf5359b763471c74f8af73ec56bac43ea11defb902990afc"] :db/ensure [:answer-field/validate]} {:db/id "q-99778" :question/id #uuid "57080f07-951e-52c6-9845-629796cf8644" :question/math-academy-id "q-99778" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930907/assets/5119e42566eff8078bdcf38d8c521e291f902bf1f03f6ddb00321989e3c94c5a.png)\n\nThe graph above shows $y=k({5}^{x})+c.$ Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({5}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-2,$ so $c=-2.$\n\nTherefore, our function takes the form\n\n$$\ny=k({5}^{x})-2.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({5}^{x})-2 \\\\ 1 & =k({5}^{0})-2 \\\\ 1 & =k(1)-2 \\\\ 1 & =k-2 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({5}^{x})-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99778/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef"] :knowledge-point/questions ["q-99778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7241/selection/bfadd821ecce14d871337160bacd1c621d08d20687c2272a2a94e53fa1001746" :answer/id #uuid "c67b9555-084a-5b2e-8202-f86d143dca3e" :answer/type :answer.type/math :answer/value "y=1.5({2}^{x})+4" :db/ensure [:answer/validate]} {:db/id "q-7241/selection/b9310648c2