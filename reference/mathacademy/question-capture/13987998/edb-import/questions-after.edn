#{[{:db/id #edb/ref 17592186284180 :knowledge-point/_questions [{:knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8225be4b-5a8c-5cc4-a6d6-01cf5b1076dd" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,8)" :db/id #edb/ref 17592186284182} {:answer/id #uuid "b5bd527e-c17c-53d1-857d-b4ba0c0b49d1" :answer/type {:db/ident :answer.type/math} :answer/value "(-8,\\infty )" :db/id #edb/ref 17592186284183} {:answer/id #uuid "0d40a22b-db28-523f-a4b8-950b37a2f11b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-8)\\cup (-8,\\infty )" :db/id #edb/ref 17592186284184} {:answer/id #uuid "12ac8426-453b-5239-a9a1-596adf50bd18" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-8)" :db/id #edb/ref 17592186284185} {:answer/id #uuid "3c0c153a-f1be-594c-bf2f-3769841357ac" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,8)\\cup (8,\\infty )" :db/id #edb/ref 17592186284186}] :answer-field/correct {:answer/id #uuid "0d40a22b-db28-523f-a4b8-950b37a2f11b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-8)\\cup (-8,\\infty )" :db/id #edb/ref 17592186284184} :answer-field/id #uuid "d9eb5149-815b-5791-a3fa-65ba6ebd2c88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284181}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "38a3c401-bc6c-50ef-8c53-cbd42788a556" :question/math-academy-id "q-105465" :question/problem "Determine the largest union of intervals on which the function $f(x)=-\\frac{2{x}^{3}}{2x+16}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =-\\frac{2{x}^{3}}{2x+16} \\\\  & =-\\frac{2{x}^{3}}{2(x+8)} \\\\  & =-\\frac{{x}^{3}}{x+8}\\end{aligned}\n$$\n\n \n\nThis function is continuous everywhere except at the excluded point $x=-8.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,-8)$ and $(-8,\\infty ),$ namely\n\n$$\n(-\\infty ,-8)\\cup (-8,\\infty )\n$$\n\nand the function is also continuous on these intervals."}] [{:db/id #edb/ref 17592186284187 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c9958ee-c8b0-5d33-8755-e61cb445b0de" :knowledge-point/title "Finding the Intervals on Which a Logarithmic Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5b1eed-8bbb-56b4-b4a8-5ada475a6133" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,9)" :db/id #edb/ref 17592186284189} {:answer/id #uuid "9f94fc9a-279a-5770-a4cc-45e492545aff" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-9)" :db/id #edb/ref 17592186284190} {:answer/id #uuid "c740c0ec-d372-54a0-81d8-b0f20c76e80c" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,9)\\cup (9,\\infty )" :db/id #edb/ref 17592186284191} {:answer/id #uuid "0e176e7f-5c9c-582e-92ca-5c02ca5ef964" :answer/type {:db/ident :answer.type/math} :answer/value "(9,\\infty )" :db/id #edb/ref 17592186284192} {:answer/id #uuid "289006d8-c103-521d-8f01-6624b00f6314" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,9]" :db/id #edb/ref 17592186284193}] :answer-field/correct {:answer/id #uuid "4d5b1eed-8bbb-56b4-b4a8-5ada475a6133" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,9)" :db/id #edb/ref 17592186284189} :answer-field/id #uuid "bc04fe67-7c2d-55f8-a116-4999cec625e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284188}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c67b0d1a-9677-5c9d-9aa5-5bb5db5a4824" :question/math-academy-id "q-105474" :question/problem "Find the largest interval of continuity for the function $f(x)={log}_{5}⁡(9-x).$" :question/worked-solution "The logarithmic function ${log}_{2}⁡(9-x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n9-x>0\\,⟹\\,x<9\n$$\n\nTherefore, the function $f(x)=\\operatorname{log}⁡(9-x)$ is continuous on the interval $(-\\infty ,9).$"}] [{:db/id #edb/ref 17592186284194 :knowledge-point/_questions [{:knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b7e1433-afe9-5ad4-9757-6257dd75177f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186284196}] :answer-field/correct {:answer/id #uuid "7b7e1433-afe9-5ad4-9757-6257dd75177f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186284196} :answer-field/id #uuid "4c06799e-0609-5d97-8a3b-929b3163db28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284195} {:answer-field/choices [{:answer/id #uuid "7bc9bd00-9f71-5594-8a51-ea59ae9a9566" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186284198}] :answer-field/correct {:answer/id #uuid "7bc9bd00-9f71-5594-8a51-ea59ae9a9566" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186284198} :answer-field/id #uuid "6acc179c-e9ef-5761-95ec-98d0f55d7221" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186284197} {:answer-field/choices [{:answer/id #uuid "dd9128c0-7774-5264-84e3-4c6426ca5b3a" :answer/type {:db/ident :answer.type/math}