[{:db/id "q-3568/selection/5b5050061005401a515f4ee4eecb72b29ae1298caec210457888a3e0bd938ff3" :answer/id #uuid "0d1112d5-9458-51ee-9759-39f8a67b6b0c" :answer/type :answer.type/math :answer/value "\\frac{1}{5}{x}^{5}+\\frac{1}{3}{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-3568/selection/50e4c9811530e7e5d909155d12232013a86dd7fc710a1d8385646575a9da5ee8" :answer/id #uuid "2640017c-40b1-5f40-88f6-5fed30f77f24" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\sqrt{({x}^{2}-1)^{3}}+\\frac{1}{5}\\sqrt{({x}^{2}-1)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-3568/selection/61878409bddcd8fd45596920800256d1e51a08e491fa7cba8d31778dc0348a9a" :answer/id #uuid "759057ae-f75a-555c-bcc4-7bc53c74cac2" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{({x}^{2}-1)^{5}}+\\frac{2}{3}\\sqrt{({x}^{2}-1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-3568/selection/838d9b3e57d00ac1cf6389afd274def4d31bec8f6c28ee3c4cb19dd18ed01b12" :answer/id #uuid "0d1a6c86-ff05-5609-a94e-e92dd7c00abe" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{{x}^{5}}+\\frac{2}{3}\\sqrt{{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-3568/selection/2262a23f1a257bb24357b73303ce5e9f8e447bc228e32c04ea1dd56005976f12" :answer/id #uuid "e73fd4cb-379a-5237-ab13-4f6899fc8b21" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\sqrt{({x}^{2}-1)^{5}}+\\frac{1}{3}\\sqrt{({x}^{2}-1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-3568/selection" :answer-field/id #uuid "e709357f-c811-50c8-8531-6c354055bf3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3568/selection/2262a23f1a257bb24357b73303ce5e9f8e447bc228e32c04ea1dd56005976f12" :answer-field/choices ["q-3568/selection/5b5050061005401a515f4ee4eecb72b29ae1298caec210457888a3e0bd938ff3" "q-3568/selection/50e4c9811530e7e5d909155d12232013a86dd7fc710a1d8385646575a9da5ee8" "q-3568/selection/61878409bddcd8fd45596920800256d1e51a08e491fa7cba8d31778dc0348a9a" "q-3568/selection/838d9b3e57d00ac1cf6389afd274def4d31bec8f6c28ee3c4cb19dd18ed01b12" "q-3568/selection/2262a23f1a257bb24357b73303ce5e9f8e447bc228e32c04ea1dd56005976f12"] :db/ensure [:answer-field/validate]} {:db/id "q-3568" :question/id #uuid "b0947ab8-ff40-52ae-9110-810f07fe5fed" :question/math-academy-id "q-3568" :question/problem "$\\int {x}^{3}\\sqrt{{x}^{2}-1}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{2}-1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,x\\,\\text{d}x=\\frac{\\text{d}u}{2}.\n$$\n\nWe also note that\n${x}^{2}=u+1.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int {x}^{3}\\sqrt{{x}^{2}-1}\\,\\text{d}x & =\\int {x}^{2}\\cdot \\sqrt{{x}^{2}-1}\\cdot x\\,\\text{d}x \\\\  & =\\int (u+1)\\cdot \\sqrt{u}\\cdot \\frac{\\text{d}u}{2} \\\\  & =\\frac{1}{2}\\int (u+1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int ({u}^{3/2}+{u}^{1/2})\\text{d}u \\\\  & =\\frac{1}{2}(\\frac{2}{5}{u}^{5/2}+\\frac{2}{3}{u}^{3/2})+C \\\\  & =\\frac{1}{5}\\sqrt{({x}^{2}-1)^{5}}+\\frac{1}{3}\\sqrt{({x}^{2}-1)^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-3568/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-3568"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12497/selection/75f2e53ce5fed058a82739c1187c9a7b3b6983a4647e082b0c8fdf133bbf4146" :answer/id #uuid "f93be6c7-8370-594a-8ec4-895037c31ceb" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{(3x+1)^{5}}-\\frac{2}{27}\\sqrt{(3x+1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-12497/selection/9e9e4d2a2275e318932390de37b676914ad21c7a88df9886c36b6c3bae1083f2" :answer/id #uuid "3fe86874-733a-51b6-8c68-eae983fd92dc" :answer/type :answer.type/math :answer/value "\\frac{2}{45}\\sqrt{(3x+1)^{5}}-\\frac{2}{27}\\sqrt{(3x+1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-12497/selection/d06274da9981adf47075714eab0a512275169cc915a9f74f6620da95885db5a3" :answer/id #uuid "350af97e-5528-5c7d-b67d-b1ef1a67d7a1" :answer/type :answer.type/math :answer/value "\\frac{2}{45}\\sqrt{(3x+1)^{5}}-\\frac{2}{9}\\sqrt{(3x+1)^{3}}+С" :db/ensure [:answer/validate]} {:db/id "q-12497/selection/d861c0a9b1623351318adfef383236e95dd9e8c51bf6cfd4164e7ce6d263154f" :answer/id #uuid "0f3a4c0e-ee37-5796-b6eb-fc45bc29144e" :answer/type :answer.type/math :answer/value "\\frac{2}{15}\\sqrt{(3x+1)^{5}}-\\frac{2}{3}\\sqrt{(3x+1)^{3}}+С" :db/ensure [:answer/validate]} {:db/id "q-12497/selection/6d774078da7465a00df4d112a3fa5c40e9953eaa4f627541f2b13d55a515bc6f" :answer/id #uuid "a46e18ec-e7b9-5f5b-a625-ab354f70add9" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{(3x+1)^{5}}-\\frac{2}{3}\\sqrt{(3x+1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-12497/selection" :answer-field/id #uuid "ed38ec3c-83e4-5c0f-a482-06f52c076152" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12497/selection/9e9e4d2a2275e318932390de37b676914ad21c7a88df9886c36b6c3bae1083f2" :answer-field/choices ["q-12497/selection/75f2e53ce5fed058a82739c1187c9a7b3b6983a4647e082b0c8fdf133bbf4146" "q-12497/selection/9e9e4d2a2275e318932390de37b676914ad21c7a88df9886c36b6c3bae1083f2" "q-12497/selection/d06274da9981adf47075714eab0a512275169cc915a9f74f6620da95885db5a3" "q-12497/selection/d861c0a9b1623351318adfef383236e95dd9e8c51bf6cfd4164e7ce6d263154f" "q-12497/selection/6d774078da7465a00df4d112a3fa5c40e9953eaa4f627541f2b13d55a515bc6f"] :db/ensure [:answer-field/validate]} {:db/id "q-12497" :question/id #uuid "c7847dc4-fecf-5341-b5e3-df7c7bce0568" :question/math-academy-id "q-12497" :question/problem "$\\int x\\sqrt{3x+1}\\,\\text{d}x=$" :question/worked-solution "Let $u=3x+1.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe also note that\n$x=\\frac{u-1}{3}.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int x\\sqrt{3x+1}\\,\\text{d}x & =\\int \\frac{u-1}{3}\\cdot \\sqrt{u}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{9}\\int ({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & =\\frac{1}{9}(\\frac{1}{5/2}{u}^{5/2}-\\frac{1}{3/2}{u}^{3/2})+C \\\\  & =\\frac{1}{9}(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})+C \\\\  & =\\frac{2}{45}{u}^{5/2}-\\frac{2}{27}{u}^{3/2}+C \\\\  & =\\frac{2}{45}\\sqrt{(3x+1)^{5}}-\\frac{2}{27}\\sqrt{(3x+1)^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12497/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-12497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113751/selection/7d4e2d1bd63c8ce3f98c6c08f97c8f1719cc6ed8a21cedd5a0b79a01ab9ce977" :answer/id #uuid "c6a9cf29-9efc-5527-a29a-1330ac2270d1" :answer/type :answer.type/math :answer/value "\\int (\\sqrt{{u}^{3}}-2\\sqrt{{u}^{2}}+\\frac{1}{u})\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-113751/selection/7dff7df199bc359a1bab328379571cc917b34b8e134d1742f55f25b6fd52e377" :answer/id #uuid "566dff2a-34c9-55f3-9adb-d8d1c1d34d4f" :answer/type :answer.type/math :answer/value "\\int (\\sqrt{{u}^{3}}-2\\sqrt{u})\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-113751/selection/c0bbf9811ab6d360d457dadd0eb4a646403905b0e91f343ab22528b60fdc3d9e" :answer/id #uuid "40c11f9d-b4e9-5910-9af7-8587f7a6408a" :answer/type :answer.type/math :answer/value "\\int (\\sqrt{{u}^{3}}+\\frac{1}{\\sqrt{u}})\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-113751/selection/bf8b6fa0d040e68155af85dbee4408262a960dd7c930c33e0263ff614f1d797a" :answer/id #uuid "68be909c-c6c1-5ee1-8bc4-7cbd3ae60c5d" :answer/type :answer.type/math :answer/value "\\int (\\frac{1}{\\sqrt{u}}-2\\sqrt{u})\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-113751/selection/ff5e09448d02b7a6185dca2ba38717fd53198ccd547a0c5e60aba08b1dfaa5bc" :answer/id #uuid "45bd2058-16a7-551a-8242-7336a361e9f0" :answer/type :answer.type/math :answer/value "\\int (\\sqrt{{u}^{3}}-2\\sqrt{u}+\\frac{1}{\\sqrt{u}})\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-113751/selection" :answer-field/id #uuid "c05f6cf4-27df-5e4f-9f0c-9635ab289308" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113751/selection/ff5e09448d02b7a6185dca2ba38717fd53198ccd547a0c5e60aba08b1dfaa5bc" :answer-field/choices ["q-113751/selection/7d4e2d1bd63c8ce3f98c6c08f97c8f1719cc6ed8a21cedd5a0b79a01ab9ce977" "q-113751/selection/7dff7df199bc359a1bab328379571cc917b34b8e134d1742f55f25b6fd52e377" "q-113751/selection/c0bbf9811ab6d360d457dadd0eb4a646403905b0e91f343ab22528b60fdc3d9e" "q-113751/selection/bf8b6fa0d040e68155af85dbee4408262a960dd7c930c33e0263ff614f1d797a" "q-113751/selection/ff5e09448d02b7a6185dca2ba38717fd53198ccd547a0c5e60aba08b1dfaa5bc"] :db/ensure [:answer-field/validate]} {:db/id "q-113751" :question/id #uuid "e75208f3-66d2-5336-8c11-cf16a17b2543" :question/math-academy-id "q-113751" :question/problem "Given that $u=x+1,$ which integral is equivalent to $\\int \\frac{{x}^{2}}{\\sqrt{x+1}}\\,\\text{d}x?$" :question/worked-solution "Since $u=x+1,$ we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nWe also note that \n$x=u-1.$\n\nNow we can rewrite the integral in terms of $u:$\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{\\sqrt{x+1}}\\,\\text{d}x & =\\int \\frac{(u-1)^{2}}{\\sqrt{u}}\\text{d}u \\\\  & =\\int ({u}^{2}-2u+1){u}^{-1/2}\\,\\text{d}u \\\\  & =\\int ({u}^{3/2}-2{u}^{1/2}+{u}^{-1/2})\\,\\text{d}u \\\\  & =\\int (\\sqrt{{u}^{3}}-2\\sqrt{u}+\\frac{1}{\\sqrt{u}})\\,\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113751/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-113751"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2621/selection/4d236d40b93b7429cb0a04b69fdbe355fdc7bcf6596257ea8ae350f53c1ea32a" :answer/id #uuid "b7a7ca29-a9b9-5dd3-ba44-205a7f0aa456" :answer/type :answer.type/math :answer/value "-6\\sqrt{(4-x)^{3}}+\\frac{4}{5}\\sqrt{(4-x)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-2621/selection/9d3e566ab785f811ee63b33ef29555d503b739c948ff84ad967a8d874219ccf1" :answer/id #uuid "b2c27e03-0c92-58f1-a3a9-89ee0b9e74ed" :answer/type :answer.type/math :answer/value "6\\sqrt{(2x+1)^{3}}-\\frac{1}{5}\\sqrt{(2x+1)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-2621/selection/8d1d9f032bfe9dc88e717009e9e3df9fb3393e2fb3d284d2c4913eea71be04d0" :answer/id #uuid "e1ef5868-4ce9-553c-9a3e-189d884609e9" :answer/type :answer.type/math :answer/value "3\\sqrt[3]{4-x}-\\frac{4}{5}\\sqrt{(4-x)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-2621/selection/8a403c1bc4558620a56d9d065c0bbd9a457cb2c41683fa5fe70c3b8a163452fd" :answer/id #uuid "db9370fa-b104-5620-9ae2-d65a73097e7c" :answer/type :answer.type/math :answer/value "-\\sqrt{(4-x)^{3}}+\\frac{1}{5}\\sqrt{(4-x)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-2621/selection/0773472f7b88415174622942c4a3a3ad2ed710691b871af75c5ae1edf0c277b5" :answer/id #uuid "81705b29-5730-5582-91cf-c3064a5fe7f8" :answer/type :answer.type/math :answer/value "-8\\sqrt{(2x+1)^{3}}+\\frac{4}{5}\\sqrt{(2x+1)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-2621/selection" :answer-field/id #uuid "810df670-b0d4-5707-bb0c-a22486fcd9ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2621/selection/4d236d40b93b7429cb0a04b69fdbe355fdc7bcf6596257ea8ae350f53c1ea32a" :answer-field/choices ["q-2621/selection/4d236d40b93b7429cb0a04b69fdbe355fdc7bcf6596257ea8ae350f53c1ea32a" "q-2621/selection/9d3e566ab785f811ee63b33ef29555d503b739c948ff84ad967a8d874219ccf1" "q-2621/selection/8d1d9f032bfe9dc88e717009e9e3df9fb3393e2fb3d284d2c4913eea71be04d0" "q-2621/selection/8a403c1bc4558620a56d9d065c0bbd9a457cb2c41683fa5fe70c3b8a163452fd" "q-2621/selection/0773472f7b88415174622942c4a3a3ad2ed710691b871af75c5ae1edf0c277b5"] :db/ensure [:answer-field/validate]} {:db/id "q-2621" :question/id #uuid "be71fbcd-9a1b-52f1-a03d-09ac21b51a07" :question/math-academy-id "q-2621" :question/problem "Calculate the integral of $(2x+1)\\sqrt{4-x}.$" :question/worked-solution "Let $u=4-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that\n$x=4-u.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int (2x+1)\\sqrt{4-x}\\,\\text{d}x & =\\int (2(4-u)+1)\\sqrt{u}(-\\text{d}u) \\\\  & =-\\int (9-2u)\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int (9{u}^{1/2}-2{u}^{3/2})\\text{d}u \\\\  & =-(6{u}^{3/2}-\\frac{4}{5}{u}^{5/2})+C \\\\  & =-6\\sqrt{(4-x)^{3}}+\\frac{4}{5}\\sqrt{(4-x)^{5}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2621/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-2621"] :db/ensure [:knowledge-point/validate]} {:db/id "q-3566/selection/2937bcfef302b92f4b138b3fe1498f62808f042981c62fa36115037491799245" :answer/id #uuid "ebf64bed-48fb-537f-9941-c742341c31eb" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\sqrt{{x}^{3}}+\\frac{1}{2}\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-3566/selection/d658d93ab12f076b7dbaa56cc6be29de7812cafc9c80d280512a3c34b13ec5b8" :answer/id #uuid "b72195c2-356b-5fc6-99c6-0ab1fd9901ee" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{(x-2)^{3}}+\\frac{5}{2}\\sqrt{(x-2)^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-3566/selection/b6b4f32a06d2279669dc460c0ac880f53b99fc066356478208d8f068739d8f06" :answer/id #uuid "5f1dbbb4-e4e3-591e-9ea0-f099da5798f4" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{(x-2)^{5}}+\\frac{4}{3}\\sqrt{(x-2)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-3566/selection/439df50b20aa16255567f6f800e563ada84191be0c506f94461d84257cdba7a8" :answer/id #uuid "ec8cb281-40c0-5bfe-883b-b8ae8d16f64c" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\sqrt{{x}^{5}}+\\frac{1}{2}\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-3566/selection/b477834c186117d98d209e982b46f2fd328442973a560598e765bd1ef3b39396" :answer/id #uuid "3a6ee48a-903f-58d1-8384-164c8a220d9b" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\sqrt{(x-2)^{3}}+\\frac{1}{3}\\sqrt{x-2}+C" :db/ensure [:answer/validate]} {:db/id "q-3566/selection" :answer-field/id #uuid "3f1b5e58-0ee4-5fd5-b1b6-e1712617cfad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3566/selection/b6b4f32a06d2279669dc460c0ac880f53b99fc066356478208d8f068739d8f06" :answer-field/choices ["q-3566/selection/2937bcfef302b92f4b138b3fe1498f62808f042981c62fa36115037491799245" "q-3566/selection/d658d93ab12f076b7dbaa56cc6be29de7812cafc9c80d280512a3c34b13ec5b8" "q-3566/selection/b6b4f32a06d2279669dc460c0ac880f53b99fc066356478208d8f068739d8f06" "q-3566/selection/439df50b20aa16255567f6f800e563ada84191be0c506f94461d84257cdba7a8" "q-3566/selection/b477834c186117d98d209e982b46f2fd328442973a560598e765bd1ef3b39396"] :db/ensure [:answer-field/validate]} {:db/id "q-3566" :question/id #uuid "e786549a-0a8e-5dc2-9a4e-5ebc4637d496" :question/math-academy-id "q-3566" :question/problem "Find the integral of $x\\sqrt{x-2}.$" :question/worked-solution "Let $u=x-2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that\n$x=u+2.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int x\\sqrt{x-2}\\,\\text{d}x & =\\int (u+2)\\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{3/2}+2{u}^{1/2}\\,\\text{d}u \\\\  & =(\\frac{2}{5}{u}^{5/2}+\\frac{4}{3}{u}^{3/2})+C \\\\  & =\\frac{2}{5}\\sqrt{(x-2)^{5}}+\\frac{4}{3}\\sqrt{(x-2)^{3}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-3566/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f"] :knowledge-point/questions ["q-3566"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348275/field-1/3de79bddf6f841c5881cdae443d3aaa683eb5842e99646c5b7e2837e89382703" :answer/id #uuid "21d1cab4-c1f7-5f71-a1df-cf3de95349aa" :answer/type :answer.type/math :answer/value "-\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-348275/field-1" :answer-field/id #uuid "5137e620-e16b-50aa-b292-3d536c7d44c7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348275/field-1/3de79bddf6f841c5881cdae443d3aaa683eb5842e99646c5b7e2837e89382703" :answer-field/choices ["q-348275/field-1/3de79bddf6f841c5881cdae443d3aaa683eb5842e99646c5b7e2837e89382703"] :db/ensure [:answer-field/validate]} {:db/id "q-348275" :question/id #uuid "b2f0e758-5c58-59ed-a47f-4247690d5b4a" :question/math-academy-id "q-348275" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{1/3}\\frac{7}{4}x\\sqrt[3]{6x+6}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u=6x+6.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{1}{6}(u-6).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $-1$ | $1/3$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $8$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1/3}\\frac{7}{4}x\\sqrt[3]{6x+6}\\,\\text{d}x & ={\\int }_{0}^{8}\\frac{7}{4}\\cdot \\frac{1}{6}(u-6)\\cdot {u}^{1/3}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{7}{144}{\\int }_{0}^{8}({u}^{4/3}-6{u}^{1/3})\\,\\text{d}u \\\\  & =\\frac{7}{144}{(\\frac{1}{(7/3)}{u}^{7/3}-6\\cdot \\frac{1}{(4/3)}{u}^{4/3})|}_{0}^{8} \\\\  & =\\frac{7}{144}{(\\frac{3}{7}{u}^{7/3}-\\frac{9}{2}{u}^{4/3})|}_{0}^{8} \\\\  & =\\frac{7}{144}[(\\frac{3}{7}\\cdot {8}^{7/3}-\\frac{9}{2}\\cdot {8}^{4/3})-(\\frac{3}{7}\\cdot {0}^{7/3}-\\frac{9}{2}\\cdot {0}^{4/3})] \\\\  & =\\frac{7}{144}(\\frac{384}{7}-72) \\\\  & =\\frac{7}{144}\\cdot (-\\frac{120}{7}) \\\\  & =-\\frac{5}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348275/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-348275"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49529/selection/b17aa3de46af595c8778cfcf8af829350d5e902af28841f71f06dac79333a449" :answer/id #uuid "5bc3441e-9c1a-52b9-894c-e029a3ed2bd2" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{1}^{5}\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49529/selection/6ce93646225f178fcfc412b52a62f978058330b380bae32a513b6f9725313229" :answer/id #uuid "2632e5d7-224b-5f2a-bb6d-0bb9cb084339" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{1}^{3}\\sqrt{u}\\,\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49529/selection/88af5c812a3792f25d43120bcb964ad307e58045367150f56e02adb2ab03c543" :answer/id #uuid "5c44f510-c857-5d50-9a51-c77517d15df0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49529/selection/b5b3fee5d230215d36731c39158245a2e7a253c3353c902c1f1bfa934e821de8" :answer/id #uuid "164dbc2e-52ac-5329-a1d2-6bc3a35b46ea" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{1}^{5}({u}^{1/2}+{u}^{-1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49529/selection/6a21b240aec7837fe3215d426c229d70a7c68eeb32e6a16144c499ef311424e3" :answer/id #uuid "afe79a8f-278e-54ce-b3df-87e54f77ccf2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{1}^{3}({u}^{3/2}+{u}^{1/2})\\text{d}u" :db/ensure [:answer/validate]} {:db/id "q-49529/selection" :answer-field/id #uuid "565cb476-77eb-58ab-834c-aca701602963" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49529/selection/88af5c812a3792f25d43120bcb964ad307e58045367150f56e02adb2ab03c543" :answer-field/choices ["q-49529/selection/b17aa3de46af595c8778cfcf8af829350d5e902af28841f71f06dac79333a449" "q-49529/selection/6ce93646225f178fcfc412b52a62f978058330b380bae32a513b6f9725313229" "q-49529/selection/88af5c812a3792f25d43120bcb964ad307e58045367150f56e02adb2ab03c543" "q-49529/selection/b5b3fee5d230215d36731c39158245a2e7a253c3353c902c1f1bfa934e821de8" "q-49529/selection/6a21b240aec7837fe3215d426c229d70a7c68eeb32e6a16144c499ef311424e3"] :db/ensure [:answer-field/validate]} {:db/id "q-49529" :question/id #uuid "e225c27f-f22c-57f5-a0fe-6a9d803a1bd6" :question/math-academy-id "q-49529" :question/problem "Given that $u=2x-1$, which integral is equivalent to ${\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x?$" :question/worked-solution "Since $u=2x-1$, then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe also note that $x=\\frac{u+1}{2}.$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $1$ | $3$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $5$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}x\\sqrt{2x-1}\\,\\text{d}x & ={\\int }_{1}^{5}\\frac{u+1}{2}\\cdot \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}(u+1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{1}^{5}({u}^{3/2}+{u}^{1/2})\\text{d}u\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49529/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-49529"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-13191"] :question/problem "Evaluate the integral ${\\int }_{-2}^{0}x{(x+2)}^{3}\\,\\text{d}x.$" :question/worked-solution "Let $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe also note that $x=u-2.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $-2$ | $0$ |\n| --- | --- | --- |\n| **$u$** | $0$ | $2$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{(x+2)}^{3}\\,\\text{d}x & ={\\int }_{0}^{2}(u-2){u}^{3}\\,\\text{d}u \\\\  & ={\\int }_{0}^{2}({u}^{4}-2{u}^{3})\\,\\text{d}u \\\\  & ={(\\frac{1}{5}{u}^{5}-2\\cdot \\frac{1}{4}{u}^{4})|}_{0}^{2} \\\\  & ={(\\frac{1}{5}{u}^{5}-\\frac{1}{2}{u}^{4})|}_{0}^{2} \\\\  & =\\frac{1}{5}({2}^{5}-{0}^{5})-\\frac{1}{2}({2}^{4}-{0}^{4}) \\\\  & =\\frac{1}{5}(32-0)-\\frac{1}{2}(16-0) \\\\  & =\\frac{32}{5}-8 \\\\  & =-\\frac{8}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-17045/selection/aeae7685e6f448658758d88a553ce55e6aa2d096c3deaefb5ac5bbd6db749508" :answer/id #uuid "0367bb0c-043f-532b-aaa2-9e362a682752" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{2}^{11}}}{7}" :db/ensure [:answer/validate]} {:db/id "q-17045/selection/fea9df766fb7b0cacf228ba840d7a3a0e63a4a5613b441e877380c314cbebfe0" :answer/id #uuid "5f6f8a96-3d8b-5038-bbf2-dac68be1c259" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{2}^{11}}}{35}" :db/ensure [:answer/validate]} {:db/id "q-17045/selection/4a6714bfe9f064d1a17c250b50a13f0e97cacca6f47f0f5d1a43bdeafdb5e9f3" :answer/id #uuid "3a6bf903-36f1-5dc9-bf0e-4b691bb81d3e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{2}^{9}}}{35}" :db/ensure [:answer/validate]} {:db/id "q-17045/selection/9e2ea7ad56f302ea9a99a518597533837c2a41470656e44ee63f78c998267d86" :answer/id #uuid "9ec5bc58-ef13-548f-a74b-5a11e9bfbb8c" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{{2}^{9}}}{7}" :db/ensure [:answer/validate]} {:db/id "q-17045/selection/e58b4fc2e0ad7c9c08592e14c1866f5858a4d3e55a1c5b86a14e0a853f92d989" :answer/id #uuid "e0b6f21b-ab7d-5206-98ae-6c8ea154769d" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{{2}^{7}}}{35}" :db/ensure [:answer/validate]} {:db/id "q-17045/selection" :answer-field/id #uuid "e2d3c9b7-7c04-5114-a9d8-152c5aa8b507" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17045/selection/fea9df766fb7b0cacf228ba840d7a3a0e63a4a5613b441e877380c314cbebfe0" :answer-field/choices ["q-17045/selection/aeae7685e6f448658758d88a553ce55e6aa2d096c3deaefb5ac5bbd6db749508" "q-17045/selection/fea9df766fb7b0cacf228ba840d7a3a0e63a4a5613b441e877380c314cbebfe0" "q-17045/selection/4a6714bfe9f064d1a17c250b50a13f0e97cacca6f47f0f5d1a43bdeafdb5e9f3" "q-17045/selection/9e2ea7ad56f302ea9a99a518597533837c2a41470656e44ee63f78c998267d86" "q-17045/selection/e58b4fc2e0ad7c9c08592e14c1866f5858a4d3e55a1c5b86a14e0a853f92d989"] :db/ensure [:answer-field/validate]} {:db/id "q-17045" :question/id #uuid "390b34d9-8917-5dfd-b97a-6e01a91be677" :question/math-academy-id "q-17045" :question/problem "Evaluate ${\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x.$" :question/worked-solution "Let $u=2-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that $x=2-u.$\n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $2$ |\n| --- | --- | --- |\n| **$u$** | $2$ | $0$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}x\\sqrt{{(2-x)}^{3}}\\,\\text{d}x & ={\\int }_{0}^{2}x{(2-x)}^{3/2}\\,\\text{d}x \\\\  & ={\\int }_{2}^{0}(2-u){u}^{3/2}(-\\text{d}u) \\\\  & ={\\int }_{2}^{0}(u-2){u}^{3/2}\\,\\text{d}u \\\\  & ={\\int }_{2}^{0}({u}^{5/2}-2{u}^{3/2})\\,\\text{d}u \\\\  & ={(\\frac{2}{7}{u}^{7/2}-2\\cdot \\frac{2}{5}{u}^{5/2})|}_{2}^{0} \\\\  & ={(\\frac{2}{7}{u}^{7/2}-\\frac{4}{5}{u}^{5/2})|}_{2}^{0} \\\\  & =\\frac{2}{7}({0}^{7/2}-{2}^{7/2})-\\frac{4}{5}({0}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{{2}^{9/2}}{7}+\\frac{{2}^{9/2}}{5} \\\\  & =\\frac{{2}^{11/2}}{35} \\\\  & =\\frac{\\sqrt{{2}^{11}}}{35}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-17045/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-17045"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348282/field-1/0d247918008ed78cc89a6965d62d9f4a8fe02d275ec22142df80e82512aa1ea1" :answer/id #uuid "a3462745-6c6d-5ba6-aabb-a9207f2917b2" :answer/type :answer.type/math :answer/value "\\frac{7}{12}" :db/ensure [:answer/validate]} {:db/id "q-348282/field-1" :answer-field/id #uuid "9aa6276a-0faf-5501-85a5-ea1e3a9e7b06" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348282/field-1/0d247918008ed78cc89a6965d62d9f4a8fe02d275ec22142df80e82512aa1ea1" :answer-field/choices ["q-348282/field-1/0d247918008ed78cc89a6965d62d9f4a8fe02d275ec22142df80e82512aa1ea1"] :db/ensure [:answer-field/validate]} {:db/id "q-348282" :question/id #uuid "57fa7def-4034-54bc-ad71-ed9f4d5340c7" :question/math-academy-id "q-348282" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-3}^{-2}\\frac{48(x+2)}{{({x}^{2}+4x)}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{2}+4x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x+4\\,⟹\\,2(x+2)\\,\\text{d}x=\\text{d}u.\n$$\n\nComputing our limits of integration, we get\n\n| **$x$** | $-3$ | $-2$ |\n| --- | --- | --- |\n| **$u$** | $-3$ | $-4$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-2}\\frac{48(x+2)}{{({x}^{2}+4x)}^{3}}\\,\\text{d}x & =24{\\int }_{-3}^{-2}\\frac{1}{{({x}^{2}+4x)}^{3}}\\cdot 2(x+2)\\,\\text{d}x \\\\  & =24{\\int }_{-3}^{-4}\\frac{1}{{u}^{3}}\\,\\text{d}u \\\\  & =24{\\int }_{-3}^{-4}{u}^{-3}\\,\\text{d}u \\\\  & =24\\cdot {(-\\frac{1}{2}{u}^{-2})|}_{-3}^{-4} \\\\  & ={(-\\frac{12}{{u}^{2}})|}_{-3}^{-4} \\\\  & =-\\frac{12}{(-4)^{2}}-(-\\frac{12}{(-3)^{2}}) \\\\  & =-\\frac{12}{16}-(-\\frac{12}{9}) \\\\  & =-\\frac{3}{4}+\\frac{4}{3} \\\\  & =\\frac{7}{12}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348282/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "94ad8efa-33ee-5451-b6b9-c99cb81a9ba2"] :knowledge-point/questions ["q-348282"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-458"] :question/problem "Calculate $\\displaystyle \\int x^3\\sqrt{x^2 + 1}\\, \\textrm{d}x.$" :question/worked-solution "Let $u = x^2+1.$ Then, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can now solve the integral in terms of $u,$ and then express our final answer in terms of $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\int {x}^{3}\\sqrt{{x}^{2}+1}\\,\\text{d}x & =\\int {x}^{2}\\cdot x\\sqrt{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int {x}^{2}\\sqrt{{x}^{2}+1}\\,\\cdot x\\,\\text{d}x \\\\  & =\\int \\overset{u-1}{\\overset{⏞}{{x}^{2}}}\\sqrt{{x}^{2}+1}\\cdot \\overset{\\frac{1}{2}\\text{d}u}{\\overset{⏞}{x\\,\\text{d}x}} \\\\  & =\\int (u-1)\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int (u-1){u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int ({u}^{3/2}-{u}^{1/2})\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\frac{2}{5}{u}^{5/2}-\\frac{2}{3}{u}^{3/2})+C \\\\  & =\\frac{1}{5}({x}^{2}+1)^{5/2}-\\frac{1}{3}({x}^{2}+1)^{3/2}+C \\\\  & =\\frac{1}{5}\\sqrt{({x}^{2}+1)^{5}}-\\frac{1}{3}\\sqrt{({x}^{2}+1)^{3}}+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-457"] :question/problem "Evaluate $\\displaystyle \\int_0^{1/2}x(1-2x)^5\\,\\textrm d x.$" :question/worked-solution "Let $u=1-2x.$ Then, we have\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -2\\quad\\Longrightarrow\\quad -\\dfrac 1 2 \\,\\textrm d u = \\textrm d x.\n$$\n\nWe also note that $x = \\dfrac 1 2 (1-u).$ \n\nComputing our limits of integration, we get\n\n| **$x$** | $0$ | $1/2$ |\n| --- | --- | --- |\n| **$u$** | $1$ | $0$ |\n\nWe can now solve the integral using our new variable $u,$ remembering to use the new limits of integration:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}x(1-2x)^{5}\\,\\text{d}x & ={\\int }_{1}^{0}\\frac{1}{2}\\cdot (1-u)\\cdot {u}^{5}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{4}{\\int }_{1}^{0}(1-u)\\cdot {u}^{5}\\,\\text{d}u \\\\  & =-\\frac{1}{4}{\\int }_{1}^{0}({u}^{5}-{u}^{6})\\,\\text{d}u \\\\  & =-\\frac{1}{4}{(\\frac{1}{6}{u}^{6}-\\frac{1}{7}{u}^{7})|}_{1}^{0} \\\\  & =-\\frac{1}{4}([0-0]-[\\frac{1}{6}-\\frac{1}{7}]) \\\\  & =-\\frac{1}{4}(-\\frac{1}{42}) \\\\  & =\\frac{1}{168}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
