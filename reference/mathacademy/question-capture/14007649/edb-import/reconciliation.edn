ution is\n\n$$\nx\\in (-\\infty ,-4)⋃(-2,-1)⋃(1,\\infty ).\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/assets/52f8bc240c3ed26c6a9d377925ae774641b386ad4c5b970f450c7eb3975d1e57.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-270807" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/activity-metadata.json" "file_sha256" "40d53369556a3591f8a5fabb19914a539057ea8d02e671d5400829b03c8a88a4"} {"question" "q-270807" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-270807" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-270807" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-270807" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450