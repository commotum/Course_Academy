estion-capture/14007649/assets/5ebfbd4e18de00fad05c4192be2147a9b9765e00fae5b74ac608e85466c21e73.png)\n\nSince we are interested in solving $P(x)>0,$ we look for the part of the curve that is above the $x$-axis.\n\nBased on the graph, the solution is \n\n$$\nx\\in (-3,0)\\cup (0,4).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-87672" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/activity-metadata.json" "file_sha256" "40d53369556a3591f8a5fabb19914a539057ea8d02e671d5400829b03c8a88a4"} {"question" "q-87672" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-87672" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x\\in (-3,0)\\cup (0,4)"] ["math" "x\\in (-3,4)"] ["math" "x\\in (-4,0)\\cup (0,3)"] ["math" "x\\in (-4,\\infty )"] ["math" "x\\in (-\\infty ,-4)\\cup (3,\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-87672" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x\\in (-3,0)\\cup (0,4)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/state.json" "file_sha256" "fd5c48a023c450892602f94d85885db356a4d6569bc664f76e8806fb5a098947"} {"question" "q-116437" "fi