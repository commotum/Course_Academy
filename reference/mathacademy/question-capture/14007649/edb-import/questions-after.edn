f7e0e70-14f3-515a-962c-3f67efc56857" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288497} {:answer-field/choices [{:answer/id #uuid "85fd3026-20d0-597e-9748-d115bfe34620" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288500}] :answer-field/correct {:answer/id #uuid "85fd3026-20d0-597e-9748-d115bfe34620" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288500} :answer-field/id #uuid "7005cd24-57ce-51b9-a068-e559b2110314" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288499}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "962bc392-065c-5c3b-87f9-80613181e44f" :question/math-academy-id "q-276760" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/assets/dc1af37c27d53e918ce8bee58789250b3c68833b6fae4c0c3721e4be4aad19f3.png)\n\nGiven the sketch of a polynomial $p(x)$ above, find the solution to $p(x)\\ge 0.$\n\n$x\\in [$\n{{field-1}}\n$,$\n{{field-2}}$]⋃[$\n{{field-3}}$,\\,3]⋃[$\n{{field-4}}$,\\,\\infty )$" :question/worked-solution "To solve the inequality $p(x)\\ge 0,$ we need to find the values of $x$ for which the curve $y=p(x)$ lies above the $x$-axis or touches this axis. \n\nBased on the graph, the solution is\n\n$$\nx\\in [\\,-3,-1]⋃[1,3]⋃[4,\\infty ).\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007649/assets/77f15f6fdfc055595bfff4d946e993c8cccd72f3fcc67e732c7d6b6abde2abec.png)"}] [{:db/id #edb/ref 17592186288501 :knowledge-point/_questions [{:knowledge-point/id #uuid "64b71f10-5b2b-5cae-a5dc-b9c160484d82" :knowledge-point/title "Solving a Factored Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "514309a3-20fb-5c04-9d64-c5cf0d41d814" :answer/type {:db/ident :an