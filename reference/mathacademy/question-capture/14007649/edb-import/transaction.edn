nsure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64b71f10-5b2b-5cae-a5dc-b9c160484d82"] :knowledge-point/questions ["q-87521"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270809/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f43d106c-379f-56d6-a4f9-df4b0b8711a9" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-270809/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "ea9a1e7d-c129-5663-878d-b81a58808f26" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-270809/field-1" :answer-field/id #uuid "87f9021f-0350-5018-8b26-ab9a28b7dedd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270809/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-270809/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-270809/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-270809/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "686cbbca-2293-567c-97c0-52e415633e12" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-270809/field-2" :answer-field/id #uuid "f0c634eb-8777-5b41-a2bb-da7c01c9621d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270809/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-270809/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-270809/field-3/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer/id #uuid "ade3d0a2-09ad-5dcc-888d-125a9a7abf20" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/va