[{:db/id "q-7169/selection/d3b5a8b3808179f8b8009d720536f272d879537ed657de82b1d9ce45402af930" :answer/id #uuid "2029c861-e843-5d75-8f0c-e981f191df3a" :answer/type :answer.type/math :answer/value "v=38" :db/ensure [:answer/validate]} {:db/id "q-7169/selection/ebe5514d0fac8c187fae76ecb06ee5eb584b22127ace946ccdb0dfb847969b28" :answer/id #uuid "b734d036-1eac-593c-96b5-f22ade6e8f93" :answer/type :answer.type/math :answer/value "v=22" :db/ensure [:answer/validate]} {:db/id "q-7169/selection/fef2109a46569c981848a8ff3bac7d81cb88bfbfe76b2c74c67ffb5ddf8d415a" :answer/id #uuid "e117bb9e-188a-5f1f-a025-66a39d6622fb" :answer/type :answer.type/math :answer/value "v=14" :db/ensure [:answer/validate]} {:db/id "q-7169/selection/486b4698dcab96be96d0e62076e3145c69671da4c3b532a56f305716221e6cee" :answer/id #uuid "d11c166b-c962-56da-8e30-d05daf2adfea" :answer/type :answer.type/math :answer/value "v=32" :db/ensure [:answer/validate]} {:db/id "q-7169/selection/aab9eecf42c2d6d62e1f8f97a6d3044f9a1a3008c5d8d31aa5b59bbe89dbcc64" :answer/id #uuid "978c361e-3372-5458-98de-c138327c51cf" :answer/type :answer.type/math :answer/value "v=40" :db/ensure [:answer/validate]} {:db/id "q-7169/selection" :answer-field/id #uuid "4468bb8b-dd7a-57fe-9f12-205030ccafa1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7169/selection/aab9eecf42c2d6d62e1f8f97a6d3044f9a1a3008c5d8d31aa5b59bbe89dbcc64" :answer-field/choices ["q-7169/selection/d3b5a8b3808179f8b8009d720536f272d879537ed657de82b1d9ce45402af930" "q-7169/selection/ebe5514d0fac8c187fae76ecb06ee5eb584b22127ace946ccdb0dfb847969b28" "q-7169/selection/fef2109a46569c981848a8ff3bac7d81cb88bfbfe76b2c74c67ffb5ddf8d415a" "q-7169/selection/486b4698dcab96be96d0e62076e3145c69671da4c3b532a56f305716221e6cee" "q-7169/selection/aab9eecf42c2d6d62e1f8f97a6d3044f9a1a3008c5d8d31aa5b59bbe89dbcc64"] :db/ensure [:answer-field/validate]} {:db/id "q-7169" :question/id #uuid "1b08d9a6-05a2-5df5-bf4f-68c02807ae8d" :question/math-academy-id "q-7169" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)={t}^{2}(2t+4).$ Calculate the velocity at time $t=2.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}[{t}^{2}(2t+4)] \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+4{t}^{2}) \\\\  & =6{t}^{2}+8t\\end{aligned}\n$$\n\n \n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =6(2)^{2}+8(2) \\\\  & =24+16 \\\\  & =40\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7169/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9"] :knowledge-point/questions ["q-7169"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-7175"] :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ seconds is given by \n\n$$\ns(t)=\\frac{5t-10}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{5t-10}{t}) \\\\  & =\\frac{10}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\nv(2)=\\frac{10}{(2)^{2}}=\\frac{10}{4}=2.5.\n$$\n\nTherefore, the speed is $|2.5|=2.5\\,\\text{cm/s}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-336138/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "4f8d490f-d676-5edc-9479-5ffe2d436b48" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336138/field-1" :answer-field/id #uuid "2531ee74-f8b3-5fee-89f8-3afeb7eea38a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336138/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-336138/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336138" :question/id #uuid "f31d851b-1815-542f-834c-0040330b3a50" :question/math-academy-id "q-336138" :question/problem "The position $x$ of a particle at time $t$ is given by \n\n$$\nx(t)=16\\sqrt{t}-{t}^{4},\\,t\\ge 0.\n$$\n\nCalculate the velocity at time $t=1.$\n\n$v(1)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(16\\sqrt{t}-{t}^{4}) \\\\  & =\\frac{16}{2\\sqrt{t}}-4{t}^{3} \\\\  & =\\frac{8}{\\sqrt{t}}-4{t}^{3}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=1,$ we substitute $t=1$ into the velocity function above:\n\n$$\n\\begin{aligned}v(1) & =\\frac{8}{\\sqrt{1}}-4({1}^{3}) \\\\  & =8-4 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336138/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9"] :knowledge-point/questions ["q-336138"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336166/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "24dc7e9b-39dc-551d-9716-801d255f68c4" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-336166/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "da56aff1-a846-523b-923e-de795c83da9d" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-336166/field-1" :answer-field/id #uuid "1f6d8522-b08f-5cd2-9006-f465e704631f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336166/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-336166/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-336166/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-336166/field-2/cf4aaefaf4cca1f17fc8f168edf95d7abdfcf2db3a8e0941f6aee384802f32e6" :answer/id #uuid "6e115967-e80b-52b0-97f9-481c9ee6e3fd" :answer/type :answer.type/math :answer/value "\\frac{\\ln(2)}{4}" :db/ensure [:answer/validate]} {:db/id "q-336166/field-2" :answer-field/id #uuid "301aa2c1-a7d2-572a-92b2-dbd8c49c98f0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336166/field-2/cf4aaefaf4cca1f17fc8f168edf95d7abdfcf2db3a8e0941f6aee384802f32e6" :answer-field/choices ["q-336166/field-2/cf4aaefaf4cca1f17fc8f168edf95d7abdfcf2db3a8e0941f6aee384802f32e6"] :db/ensure [:answer-field/validate]} {:db/id "q-336166" :question/id #uuid "3c9f7bfd-dd97-5c50-bff1-b05200e8ca4e" :question/math-academy-id "q-336166" :question/problem "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)=\\frac{{2}^{t}}{{2}^{t}+1}$, where $t$ is the time, measured in seconds. Find the position ${s}_{0}$ and velocity ${v}_{0}$ of the particle at the initial moment of time $t=0\\,\\text{s}.$\n\n${s}_{0}=$\n{{field-1}}$\\text{m}\\,\\text{and}\\,$\n\n${v}_{0}=$\n{{field-2}}$\\text{m/s}$" :question/worked-solution "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)=\\frac{{2}^{t}}{{2}^{t}+1}:$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & =\\frac{{2}^{0}}{{2}^{0}+1} \\\\  & =\\frac{1}{2}\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{2}^{t}}{{2}^{t}+1}) \\\\  & =\\frac{({2}^{t}+1)\\cdot {2}^{t}\\operatorname{ln}⁡2-{2}^{t}\\cdot {2}^{t}\\operatorname{ln}⁡2}{{({2}^{t}+1)}^{2}} \\\\  & =\\frac{{2}^{t}\\operatorname{ln}⁡2}{{({2}^{t}+1)}^{2}}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =\\frac{{2}^{0}\\cdot \\operatorname{ln}⁡2}{{({2}^{0}+1)}^{2}} \\\\  & =\\frac{\\operatorname{ln}⁡2}{4}\\,\\text{m/s}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336166/field-1" "q-336166/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9"] :knowledge-point/questions ["q-336166"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336186/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "76444ab8-3205-5dd4-8465-39fd1fb69557" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-336186/field-1" :answer-field/id #uuid "5ffc2ec4-6b31-5f60-a238-dd3fed91e04d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336186/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-336186/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-336186" :question/id #uuid "c1b6e4b2-26cc-5cd3-b616-d286a84f4a20" :question/math-academy-id "q-336186" :question/problem "The position $s(t)$ of a particle (in inches) at time $t$ minutes is given by \n\n$$\ns(t)=3{t}^{4}-4{e}^{t},\\,t\\ge 0.\n$$\n\nCalculate the speed of the particle when $t=0\\,\\text{min}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{in/min}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{4}-4{e}^{t}) \\\\  & =12{t}^{3}-4{e}^{t}\\end{aligned}\n$$\n\nWhen $t=0,$ the velocity is\n\n$$\n\\begin{aligned}v(0) & =12\\cdot {0}^{3}-4{e}^{0} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the speed is $|-4|=4\\,\\text{in/min}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336186/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48"] :knowledge-point/questions ["q-336186"] :db/ensure [:knowledge-point/validate]}]
