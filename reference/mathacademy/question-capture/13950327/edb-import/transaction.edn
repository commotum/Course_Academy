9954a50f5c7236c60c79c99c2a7" :answer/id #uuid "6fde4057-70b7-5db4-b707-84e078cd5363" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 3 \\\\ 4 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-11441/selection" :answer-field/id #uuid "21a9178d-b711-5b55-ac73-b024b5f52118" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11441/selection/2497a5501d89b1ca058f893874eb04c52acad4c4f78c09535a0cb21c904144df" :answer-field/choices ["q-11441/selection/6a4926cd91d04630da6d7e23120f215f742b3f004bab77c95bb1a804be7c8ccf" "q-11441/selection/2497a5501d89b1ca058f893874eb04c52acad4c4f78c09535a0cb21c904144df" "q-11441/selection/d863ad6a6f813dcf1294ab1e7b3ee0fdaedc0f0c520739789a1690edb34eab38" "q-11441/selection/fd19899fe79dff7d60ff634414f6c6f63c9f6050eaa57067b13ba38121c2431a" "q-11441/selection/742562643d26baae7dcea023ef86b021185ed9954a50f5c7236c60c79c99c2a7"] :db/ensure [:answer-field/validate]} {:db/id "q-11441" :question/id #uuid "b16d8b8b-90db-5732-a5f9-3cead7a1b2c5" :question/math-academy-id "q-11441" :question/problem "Calculate $A-B$, where\n\n$$\nA=[\\begin{aligned}5 & 5 \\\\ 5 & 4\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =[\\begin{aligned}5 & 5 \\\\ 5 & 4\\end{aligned}]-[\\begin{aligned}3 & 2 \\\\ 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}5-3 & 5-2 \\\\ 5-1 & 4-0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 4 & 4\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11441/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d3c4ee0-3a49-5eef-a7c0-56d1731cd826"] :knowledge-point/questions ["q-11441"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4374"] :question/problem "Calculate $A+B,$ where\n\n$$\n[\\begin{aligned}1 & -5 \\\\ -2 & 3\\end{aligned}]\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & -5 \\\\ -2 & 3\\end{aligned}]+[\\begin{aligned}-10 & 2 \\\\ 2 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & -3 \\\\ 0 & -1\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4396"] :question/problem "Calculate ${A}+ {B},$ where\n\n$$\n[\\begin{aligned}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{aligned}]\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{aligned}]+[\\begin{aligned}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1+(-2) & 3+(-3) & 1+1 & 0+1 \\\\ 2+1 & 4+(-2) & -1+3 & 2+1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 & 2 & 1 \\\\ 3 & 2 & 2 & 3\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4375"] :question/problem "Calculate $A-B,$ where\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{aligned}]\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =[\\begin{aligned}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{aligned}]-[\\begin{aligned}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}2-0 & -1-(-1) \\\\ -1-2 & 0-(-1) \\\\ 3-(-1) & 2-3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
