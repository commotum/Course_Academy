#{[{:db/id #edb/ref 17592186054458 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n$$\n[\\begin{aligned}1 & -5 \\\\ -2 & 3\\end{aligned}]\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & -5 \\\\ -2 & 3\\end{aligned}]+[\\begin{aligned}-10 & 2 \\\\ 2 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & -3 \\\\ 0 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054459 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1d3c4ee0-3a49-5eef-a7c0-56d1731cd826" :knowledge-point/title "Subtracting Matrices"}] :question/id #uuid "fc4a66f3-5180-5ac0-bd4d-830196fa459a" :question/math-academy-id "e-4375" :question/problem "Calculate $A-B,$ where\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{aligned}]\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =[\\begin{aligned}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{aligned}]-[\\begin{aligned}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}2-0 & -1-(-1) \\\\ -1-2 & 0-(-1) \\\\ 3-(-1) & 2-3\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054460 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "95627f8c-4151-5565-8803-7558bd674acb" :knowledge-point/title "Adding Non-Square Matrices"}] :question/id #uuid "b77816bd-e128-5888-9973-97c51c99f7f0" :question/math-academy-id "e-4396" :question/problem "Calculate ${A}+ {B},$ where\n\n$$\n[\\begin{aligned}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{aligned}]\n$$" :question/worked-solution "We add the corresponding entries:\n\