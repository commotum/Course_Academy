#{[{:db/id #edb/ref 17592186054458 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B$, where\n\n$\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\nA + B &= \\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix} + \\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 - 10 & -5 + 2 \\\\ -2 + 2 & 3 - 4\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054459 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1d3c4ee0-3a49-5eef-a7c0-56d1731cd826" :knowledge-point/title "Subtracting Matrices"}] :question/id #uuid "fc4a66f3-5180-5ac0-bd4d-830196fa459a" :question/math-academy-id "e-4375" :question/problem "Calculate $A-B$, where\n\n$\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}\nA - B &= \\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix} - \\begin{bmatrix}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 - 0 & -1 - (-1) \\\\ -1 - 2 & 0 - (-1) \\\\ 3 - (-1) & 2 - 3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054460 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "95627f8c-4151-5565-8803-7558bd674acb" :knowledge-point/title "Adding Non-Square Matrices"}] :question/id #uuid "b77816bd-e128-5888-9973-97c51c99f7f0" :question/math-academy-id "e-4396" :question/problem "Calculate ${A}+ {B}$, where\n$\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}\nA + B &= \\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix} + \\begin{bmatrix}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 + (-2) & 3 + (-3) & 1 + 1 & 0 + 1 \\\\ 2 + 1 & 4 + (-2) & -1 + 3 & 2 + 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-1 & 0 & 2 & 1 \\\\ 3 & 2 & 2 & 3\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054880 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051246} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051247} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051248} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051249} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051250}] :answer-field/correct {:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051246} :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051245}] :question/id #uuid "06528850-