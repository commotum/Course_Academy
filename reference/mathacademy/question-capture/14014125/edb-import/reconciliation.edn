ve\n\n$$\n\\text{Area}(D)=1\\cdot 1=1.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=(-4)\\cdot 3-2\\cdot 1=-12-2=-14.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,-14\\,|\\cdot 1 \\\\  & =14.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014125/state.json" "file_sha256" "e05ecea4e4a7e584a12a597e9fa31a52dc42069ad526b84d64edcfc3b49e563f"} {"question" "q-316598" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014125/activity-metadata.json" "file_sha256" "727b597be255a074562489f7d94444178ebfd48dc8b1705ea2d3779a1a54b6a7"} {"question" "q-316598" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014125/state.json" "file_sha256" "e05ecea4e4a7e584a12a597e9fa31a52dc42069ad526b84d64edcfc3b49e563f"} {"question" "q-316598" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "14"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014125/state.json" "file_sha256" "e05ecea4e4a7e584a12a597e9fa31a52dc42069ad526b84d64edcfc3b49e563f"}] "usage" {} "basis" 1182 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
