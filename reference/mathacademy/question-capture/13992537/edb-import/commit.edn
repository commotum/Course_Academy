7 true] [17592186283990 1104 #edb/ref 17592186283991 13194139534357 true] [17592186283990 1110 #uuid "8a507e12-d55f-5b60-99ad-55d64aab3aa3" 13194139534357 true] [17592186283991 1034 "12" 13194139534357 true] [17592186283991 1103 #edb/ref 17592186045453 13194139534357 true] [17592186283991 1111 #uuid "f46ad528-cc2b-522d-a59e-d2d1226b8d21" 13194139534357 true] [17592186283992 1034 "6" 13194139534357 true] [17592186283992 1103 #edb/ref 17592186045453 13194139534357 true] [17592186283992 1111 #uuid "00f7ee57-b995-5fc6-96e6-25d4f673a92d" 13194139534357 true] [17592186283993 1017 #edb/ref 17592186283994 13194139534357 true] [17592186283993 1089 "q-316567" 13194139534357 true] [17592186283993 1091 #edb/ref 17592186045463 13194139534357 true] [17592186283993 1100 "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=[\\begin{aligned}6 & 5 \\\\ 4 & 3\\end{aligned}]?\n$$\n\nThe area scale factor is\n{{field-1}} ." 13194139534357 true] [17592186283993 1113 #uuid "2d0b4edc-cbc9-5f80-b991-016b7fc5b45b" 13194139534357 true] [17592186283993 1145 "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|6\\cdot 3-5\\cdot 4| \\\\  & =|18-20| \\\\  & =|-2| \\\\  & =2.\\end{aligned}\n$$" 13194139534357 true] [17592186283994 1000 #edb/ref 17592186283995 13194139534357 true] [17592186283994 1040 #edb/ref 17592186045449 13194139534357 true] [17592186283994 1041 "field-1" 13194139534357 true] [17592186283994 1104 #edb/ref 17592186283995 13194139534357 true] [17592186283994 1110 #uuid "a7ada992-7914-5094-b8fa-c4a276bc3698" 13194139534357 true] [17592186283995 1034 "2" 13194139534357 true] [17592186283995 1103 #edb/ref 17592186045453 13194139534357 true] [17592186283995 1111 #uuid "c491273b-534c-5fb0-aa67-d6309ef9ce64" 13194139534357 true] [17592186283996 1017 #edb/ref 17592186283997 13194139534357 true] [17592186283996 1089 "q-316578" 13194139