899/selection/d80f838165aecf86aa9c73bd034301f093baf48b44475f0123c79aa749fe53d4" "q-37899/selection/7b90ad80455272770675a6cc5d2461eafee4c1e9e9d4f5e8dcf9b8b7434b1987"] :db/ensure [:answer-field/validate]} {:db/id "q-37899" :question/id #uuid "92855669-74b1-5c98-b515-77b010a48943" :question/math-academy-id "q-37899" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/f4fdf6f8d819a4ee043b1cc3b86d795e3166ebfe181e0958246dc084c2f9c6fc.png)\n\nThe point $P$ lies on the unit circle. Given that the $x$-coordinate of $P$ is $\\frac{3}{7},$ use the Pythagorean Identity to find $sin⁡\\theta .$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/cb569d4b7b76699259d2167b8c930e636e3fb794b14ef25a4d909c224235d7c3.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{3}{7}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{3}{7}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{3}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{49}} \\\\  & =\\pm \\sqrt{\\frac{40}{49}} \\\\  & =\\pm \\frac{2\\sqrt{10}}{7}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So our final answer is $sin⁡\\theta =\\frac{2\\sqrt{10}}{7}$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37899/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c73db44-2ec2-5025-9431-acb02e414916"] :knowledge-point/questions ["q-37899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37915/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "fe4d1e0d-f58c-589a-8e51-2249af6c384e" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-37915/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer/id #uuid "9e27fa36-a5ef-5848-98c0-7f72b264ed62" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-37915/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "9fee02c0-effd-5e07-bbd4-c037e2ba2b18" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-37915/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "ce77f37d-58fa-57ab-b1ad-32be6f8bac8c" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-37915/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "52f3f149-4d2b-5179-ada7-61331cd2c5fd" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-37915/selection" :answer-field/id #uuid "2769842c-de42-5444-b0a8-f64b39b160b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37915/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-37915/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-37915/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" "q-37915/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-37915/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-37915/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e"] :db/ensure [:answer-field/validate]} {:db/id "q-37915" :question/id #uuid "5108857e-4a0b-577d-ab56-bb8f18245f20" :question/math-academy-id "q-37915" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/6c36dbce847c719accc77fa15f33dfb9a87cfae669691afe30f7693663076d2e.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{10}}{4},$ use the Pythagorean identity to find $2{cos}^{2}⁡\\theta .$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/52fe94bb303a001e89f9db221e9730d4ca8c5c284217aa20fb6084ee041dec66.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{10}}{4}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{10}}{4}.\n$$\n\nWe can use the Pythagorean identity to find $2{cos}^{2}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ 2{cos}^{2}⁡\\theta  & =2-2{sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{10}}{4}$ gives\n\n$$\n\\begin{aligned}2{cos}^{2}⁡\\theta  & =2-2{(\\frac{\\sqrt{10}}{4})}^{2} \\\\  & =2-2(\\frac{10}{16}) \\\\  & =2-\\frac{20}{16} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nSo our final answer is $2{cos}^{2}⁡\\theta =\\frac{3}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c73db44-2ec2-5025-9431-acb02e414916"] :knowledge-point/questions ["q-37915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64681/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "f5ef0bc3-c240-524b-b40a-3503bb0b8b22" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-64681/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "68446250-0675-5e89-b707-0653b9d79937" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-64681/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "483c0296-fd0f-53ac-b330-838f83260f21" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-64681/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "cea943c2-5640-59a3-a907-317a28833ba9" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-64681/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "37501a1a-e20e-5de6-8dff-05d2a13f043a" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-64681/selection" :answer-field/id #uuid "e8496765-3856-5244-a44a-b1d2bf054d90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64681/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-64681/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-64681/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-64681/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-64681/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" "q-64681/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-64681" :question/id #uuid "d91e312e-ed3c-5f08-9bb3-835259efe424" :question/math-academy-id "q-64681" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/94b8650466747f6858b30adbb8962e6c91159466b570f536d4999e2b08c31b67.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{1}{2},$ use the Pythagorean identity to find $sin⁡\\theta .$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931905/assets/cb569d4b7b76699259d2167b8c930e636e3fb794b14ef25a4d909c224235d7c3.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{2}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{1}{2}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So our final answer is $sin⁡\\theta =\\frac{\\sqrt{3}}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64681/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c73db44-2ec2-5025-9431-acb02e414916"] :knowledge-point/questions ["q-64681"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65059/selection/7e5cd78cc3416d56e10f5d15d8a4929e4b73fe2ad5dc4e0714b080eb641dd5c1" :answer/id #uuid "0cccef28-4cf1-581a-a432-8c11ab47189e" :answer/type :answer.type/math :answer/value "\\frac{55}{9}" :db/ensure [:answer/validate]} {:db/id "q-65059/selection/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" 