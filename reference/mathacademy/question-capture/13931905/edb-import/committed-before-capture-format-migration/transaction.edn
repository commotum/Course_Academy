lty/moderate :question/answer-fields ["q-124789/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74d05ad6-7e4a-5c50-92d1-ca4b2f00cbb1"] :knowledge-point/questions ["q-124789"] :db/ensure [:knowledge-point/validate]}]
