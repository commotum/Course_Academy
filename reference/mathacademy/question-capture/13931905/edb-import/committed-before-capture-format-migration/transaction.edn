qrt{21}}{5}.\\end{aligned}\n$$\n\nSince $A$ lies in the first quadrant, $y$ must be positive, so we select the positive answer. Therefore, our final answer is $y=\\frac{\\sqrt{21}}{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65031/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87c18ea8-af12-52bd-8420-ec24ed63de65"] :knowledge-point/questions ["q-65031"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124608/selection/d40ff1748f692a57b65f6e80ee8d7881de7a3ace2a9ae8ad5c4db11161c2d59c" :answer/id #uuid "cc5d66a0-f342-5332-b267-1ff4540fa776" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{11}}{3}" :db/ensure [:answer/validate]} {:db/id "q-124608/selection/8a73755b9c6eaa07ff2395062fbe69098fbaa629193e2ebcacc20386fc933265" :answer/id #uuid "b9d76b8a-3f2c-56e3-9b5f-5a18a6748cc2" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{11}}{9}" :db/ensure [:answer/validate]} {:db/id "q-124608/selection/373704b22146b1b349c34b0d18e3babe4f9cf54975d290ff346c3ab14b749592" :answer/id #uuid "9fb437ea-e614-5770-8300-0cc9185ecf54" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{6}}{9}" :db/ensure [:answer/validate]} {:db/id "q-124608/selection/6f1b1e6d6efb3e49f546f382ebd2796d1934aeda46cab4a4fd746b3290da22d0" :answer/id #uuid "e84aa24b-382f-515a-8cf8-bfd552d84928" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{3}" :db/ensure [:answer/validate]} {:db/id "q-124608/selection/450da4880392cd748bb1f6c6afa801d25cbfb9176f0166cfe4d2a9fdadde5fb2" :answer/id #uuid "7d0e3134-1b03-57ad-8c14-d8e28988878e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}}{3}" :db/ensure [:answer/validate]} {:db/id "q-124608/selection" :answer-field/id #uuid "bbc36ff3-d93c-5137-aefe-14f40d0a6ced" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124608/selection/450da4880392cd748bb1f6c6afa801d25cbfb9176f0166cfe4d2a9fdadde5fb2" :answer-fie