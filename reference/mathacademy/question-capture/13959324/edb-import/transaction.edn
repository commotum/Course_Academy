(-\\frac{1}{4})+1)(-\\frac{1}{4}-1) \\\\  & \\,+B(2(-\\frac{1}{4})-3)(-\\frac{1}{4}-1) \\\\  & \\,+C(2(-\\frac{1}{4})-3)(4(-\\frac{1}{4})+1) \\\\ -\\frac{35}{4} & =\\frac{35}{8}B \\\\ B & =-2.\\end{aligned}\n$$\n\nFor $x=1$, we get\n\n$$\n\\begin{aligned}11(1)-6 & =A(4(1)+1)(1-1)+B(2(1)-3)(1-1)+C(2(1)-3)(4(1)+1) \\\\ 5 & =-5C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{11x-6}{(2x-3)(4x+1)(x-1)}=\\frac{3}{2x-3}-\\frac{2}{4x+1}-\\frac{1}{x-1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351008/field-1" "q-351008/field-2" "q-351008/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df"] :knowledge-point/questions ["q-351008"] :db/ensure [:knowledge-point/validate]}]
