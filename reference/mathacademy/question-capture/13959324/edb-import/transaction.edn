[{:db/id "q-10955/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "d35241f7-ff4e-5a5c-a70a-4814b8a2cf65" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-10955/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "720624f1-f5f2-52ce-b943-d05472e788df" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-10955/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a5a9c20a-f23a-5323-8e0e-1eb1770845dc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-10955/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "44b036d6-9543-5dc2-aa00-23ddc1e5fa51" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-10955/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-10955/selection" :answer-field/id #uuid "6ade377a-7056-50ca-aa06-b10947c90d74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10955/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-10955/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-10955/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-10955/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-10955/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-10955/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-10955" :question/id #uuid "9a0c48a9-fea3-5370-b735-9bdfb2ee74c7" :question/math-academy-id "q-10955" :question/problem "Given that\n\n$$\n\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x+3)$ gives\n\n$$\nx-15=A(x+3)+B(x-3).\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}(-3)-15 & =A(-3+3)+B(-3-3) \\\\ -18 & =-6B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}3-15 & =A(3+3)+B(3-3) \\\\ -12 & =A(6) \\\\ A & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-2+3=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10955/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd"] :knowledge-point/questions ["q-10955"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10986/selection/4e6164ac514b60cbfb5a44f0889925357f745ecf002b93bfffb987afbf9ac73e" :answer/id #uuid "031a6124-c347-5b7d-a34f-e5ca7325d1ad" :answer/type :answer.type/math :answer/value "-\\frac{7}{(3-x)}-\\frac{5}{(2-x)}+\\frac{1}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-10986/selection/0350d77141490d73146199b654e3150f1de0a5d20e5066961ec6413087cbdaf8" :answer/id #uuid "bb4b1762-21a7-5282-a68a-4d69de3f18ee" :answer/type :answer.type/math :answer/value "\\frac{1}{(3-x)}+\\frac{10}{(2-x)}-\\frac{2}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-10986/selection/f4c8a9e8b2dec81240144b2937efacde3e79f4daa0445b7d2e1332b2ed28b8d1" :answer/id #uuid "fec642a9-9531-5a29-bd82-50bc6b337f95" :answer/type :answer.type/math :answer/value "\\frac{3}{(3-x)}-\\frac{4}{(2-x)}+\\frac{9}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-10986/selection/381bf2e4a316b8dbe4ec5d05281ab8dc52f8594d2c955bc6669142ea1db67c43" :answer/id #uuid "511670c2-df2d-5638-b210-db872c82e269" :answer/type :answer.type/math :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-10986/selection/be323d1b4a1e0138c9057eb2baab0e659350adf725e2477417c7a8179be0f70e" :answer/id #uuid "220078e0-54f3-532f-bf2f-fd7596bc0380" :answer/type :answer.type/math :answer/value "\\frac{5}{(3-x)}+\\frac{1}{(2-x)}-\\frac{6}{(x+1)}" :db/ensure [:answer/validate]} {:db/id "q-10986/selection" :answer-field/id #uuid "0ce1f15e-c964-5494-a4fa-5bce8b146240" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10986/selection/381bf2e4a316b8dbe4ec5d05281ab8dc52f8594d2c955bc6669142ea1db67c43" :answer-field/choices ["q-10986/selection/4e6164ac514b60cbfb5a44f0889925357f745ecf002b93bfffb987afbf9ac73e" "q-10986/selection/0350d77141490d73146199b654e3150f1de0a5d20e5066961ec6413087cbdaf8" "q-10986/selection/f4c8a9e8b2dec81240144b2937efacde3e79f4daa0445b7d2e1332b2ed28b8d1" "q-10986/selection/381bf2e4a316b8dbe4ec5d05281ab8dc52f8594d2c955bc6669142ea1db67c43" "q-10986/selection/be323d1b4a1e0138c9057eb2baab0e659350adf725e2477417c7a8179be0f70e"] :db/ensure [:answer-field/validate]} {:db/id "q-10986" :question/id #uuid "acebe58a-3e7d-5d60-8253-314cb5af28ad" :question/math-academy-id "q-10986" :question/problem "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}22(2)-38 & =A(2-2)(2+1) \\\\  & \\,+B(3-2)(2+1) \\\\  & \\,+C(3-2)(2-2) \\\\ 44-38 & =B(3) \\\\ B & =\\frac{6}{3} \\\\ B & =2.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}22(-1)-38 & =A(2-(-1))(-1+1) \\\\  & \\,+B(3-(-1))(-1+1) \\\\  & \\,+C(3-(-1))(2-(-1)) \\\\ -22-38 & =C(12) \\\\ C & =\\frac{-60}{12} \\\\ C & =-5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{22x-38}{(3-x)(2-x)(x+1)}=-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10986/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df"] :knowledge-point/questions ["q-10986"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51136/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7dd8390e-84ab-5808-8391-f5ade4ab45e3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-51136/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "202facdc-893a-598d-be1a-0c4894f84aa4" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-51136/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "725c8d9f-6c6a-5d49-a499-5bcad923c5ce" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-51136/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "2622f585-2e9c-591c-af9e-1b43930d8928" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-51136/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "d2b84fa5-16d7-522b-b051-8227dcd3f138" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-51136/selection" :answer-field/id #uuid "2bfdca51-5541-53de-a348-034d8615da41" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51136/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-51136/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-51136/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-51136/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-51136/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" "q-51136/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3"] :db/ensure [:answer-field/validate]} {:db/id "q-51136" :question/id #uuid "b6bb9ee3-564c-5320-9703-cb6c49fcd5d9" :question/math-academy-id "q-51136" :question/problem "Given that\n\n$$\n\\frac{-2x-9}{(x+3)x}=\\frac{1}{(x+3)}+\\frac{B}{x},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{-2x-9}{(x+3)x}=\\frac{1}{(x+3)}+\\frac{B}{x}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+3)x$ gives\n\n$$\n-2x-9=x+B(x+3).\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}-2(0)-9 & =0+B(0+3) \\\\ -9 & =3B \\\\ B & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-51136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd"] :knowledge-point/questions ["q-51136"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69751/selection/397f67a3c147076c4aacf27165eb83bf9d96a32361bf199e1a321b4c1f271a06" :answer/id #uuid "caf3373e-14ce-53af-958f-71db5e3cd93e" :answer/type :answer.type/math :answer/value "\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/ensure [:answer/validate]} {:db/id "q-69751/selection/9e410d631f4032cc7fac1499b5084c0261ce9b699d6a4fc1bf22630dc3b7b1ba" :answer/id #uuid "b551016b-e3f4-554b-afb5-1871fb7b2e49" :answer/type :answer.type/math :answer/value "\\frac{4}{(x-3)}+\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/ensure [:answer/validate]} {:db/id "q-69751/selection/d676a217261584ca3df