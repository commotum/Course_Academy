#{[{:db/id #edb/ref 17592186268264 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d35241f7-ff4e-5a5c-a70a-4814b8a2cf65" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186268266} {:answer/id #uuid "44b036d6-9543-5dc2-aa00-23ddc1e5fa51" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268267} {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} {:answer/id #uuid "a5a9c20a-f23a-5323-8e0e-1eb1770845dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186268269} {:answer/id #uuid "720624f1-f5f2-52ce-b943-d05472e788df" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268270}] :answer-field/correct {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} :answer-field/id #uuid "6ade377a-7056-50ca-aa06-b10947c90d74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268265}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a0c48a9-fea3-5370-b735-9bdfb2ee74c7" :question/math-academy-id "q-10955" :question/problem "Given that\n\n$$\n\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x+3)$ gives\n\n$$\nx-15=A(x+3)+B(x-3).\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}(-3)-15 & =A(-3+3)+B(-3-3) \\\\ -18 & =-6B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}3-15 & =A(3+3)+B(3-3) \\\\ -12 & =A(6) \\\\ A & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-2+3=1.\n$$"}] [{:db/id #edb/ref 17592186268271 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb4b1762-21a7-5282-a68a-4d69de3f18ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(3-x)}+\\frac{10}{(2-x)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186268273} {:answer/id #uuid "511670c2-df2d-5638-b210-db872c82e269" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186268274} {:answer/id #uuid "031a6124-c347-5b7d-a34f-e5ca7325d1ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}-\\frac{5}{(2-x)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186268275} {:answer/id #uuid "220078e0-54f3-532f-bf2f-fd7596bc0380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)}+\\frac{1}{(2-x)}-\\frac{6}{(x+1)}" :db/id #edb/ref 17592186268276} {:answer/id #uuid "fec642a9-9531-5a29-bd82-50bc6b337f95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(3-x)}-\\frac{4}{(2-x)}+\\frac{9}{(x+1)}" :db/id #edb/ref 17592186268277}] :answer-field/correct {:answer/id #uuid "511670c2-df2d-5638-b210-db872c82e269" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186268274} :answer-field/id #uuid "0ce1f15e-c964-5494-a4fa-5bce8b146240" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268272}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "acebe58a-3e7d-5d60-8253-314cb5af28ad" :question/math-academy-id "q-10986" :question/problem "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}22(2)-38 & =A(2-2)(2+1) \\\\  & \\,+B(3-2)(2+1) \\\\  & \\,+C(3-2)(2-2) \\\\ 44-38 & =B(3) \\\\ B & =\\frac{6}{3} \\\\ B & =2.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}22(-1)-38 & =A(2-(-1))(-1+1) \\\\  & \\,+B(3-(-1))(-1+1) \\\\  & \\,+C(3-(-1))(2-(-1)) \\\\ -22-38 & =C(12) \\\\ C & =\\frac{-60}{12} \\\\ C & =-5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{22x-38}{(3-x)(2-x)(x+1)}=-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186268278 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22798587-b17d-5e2f-b6c6-cbf355611f3a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268280}] :answer-field/correct {:answer/id #uuid "22798587-b17d-5e2f-b6c6-cbf355611f3a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268280} :answer-field/id #uuid "bdb2af3c-b1ec-5cf2-a877-2ecbdf7ea581" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186268279} {:answer-field/choices [{:answer/id #uuid "2961c9d0-4bc5-584e-bf4a-658a7c96a344" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186268282}] :answer-field/correct {:answer/id #uuid "2961c9d0-4bc5-584e-bf4a-658a7c96a344" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186268282} :answer-field/id #uuid "b6d22f4c-28d3-5d0f-b824-6426ba3f78b0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186268281} {:answer-field/choices [{:answer/id #uuid "1addc2cc-ea62-5e83-906d-14c3a0d91efa" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268284}] :answer-field/correct {:answer/id #uuid "1addc2cc-ea62-5e83-906d-14c3a0d91efa" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268284} :answer-field/id #uuid "ee505cd4-7209-59fe-9b5b-99a42d4921b2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186268283}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8b5a0392-50d0-5e83-a565-fd322e0647d7" :question/math-academy-id "q-351008" :question/problem "Express $\\frac{11x-6}{(2x-3)(4x+1)(x-1)}$ as a sum of partial fractions.\n\n| $\\frac{11x-6}{(2x-3)(4x+1)(x-1)}=\\,$ | {{field-1}} | $-$ | {{field-2}} | $-$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $2x-3$ |  | $4x+1$ |  | $x-1$ |" :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{11x-6}{(2x-3)(4x+1)(x-1)}=\\frac{A}{2x-3}+\\frac{B}{4x+1}+\\frac{C}{x-1}.\n$$\n\nMultiplying both sides by $(2x-3)(4x+1)(x-1)$ gives\n\n$$\n11x-6=A(4x+1)(x-1)+B(2x-3)(x-1)+C(2x-3)(4x+1).\n$$\n\nFor $x=\\frac{3}{2},$ we get\n\n$$\n\\begin{aligned}11(\\frac{3}{2})-6 & =A(4(\\frac{3}{2})+1)(\\frac{3}{2}-1) \\\\  & \\,+B(2(\\frac{3}{2})-3)(\\frac{3}{2}-1) \\\\  & \\,+C(2(\\frac{3}{2})-3)(4(\\frac{3}{2})+1) \\\\ \\frac{21}{2} & =\\frac{7}{2}A \\\\ A & =3.\\end{aligned}\n$$\n\nFor $x=-\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}11(-\\frac{1}{4})-6 & =A(4(-\\frac{1}{4})+1)(-\\frac{1}{4}-1) \\\\  & \\,+B(2(-\\frac{1}{4})-3)(-\\frac{1}{4}-1) \\\\  & \\,+C(2(-\\frac{1}{4})-3)(4(-\\frac{1}{4})+1) \\\\ -\\frac{35}{4} & =\\frac{35}{8}B \\\\ B & =-2.\\end{aligned}\n$$\n\nFor $x=1$, we get\n\n$$\n\\begin{aligned}11(1)-6 & =A(4(1)+1)(1-1)+B(2(1)-3)(1-1)+C(2(1)-3)(4(1)+1) \\\\ 5 & =-5C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{11x-6}{(2x-3)(4x+1)(x-1)}=\\frac{3}{2x-3}-\\frac{2}{4x+1}-\\frac{1}{x-1}.\n$$"}] [{:db/id #edb/ref 17592186268285 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2b84fa5-16d7-522b-b051-8227dcd3f138" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186268287} {:answer/id #uuid "725c8d9f-6c6a-5d49-a499-5bcad923c5ce" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268288} {:answer/id #uuid "2622f585-2e9c-591c-af9e-1b43930d8928" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186268289} {:answer/id #uuid "7dd8390e-84ab-5808-8391-f5ade4ab45e3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268290} {:answer/id #uuid "202facdc-893a-598d-be1a-0c4894f84aa4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186268291}] :answer-field/correct {:answer/id #uuid "202facdc-893a-598d-be1a-0c4894f84aa4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186268291} :answer-field/id #uuid "2bfdca51-5541-53de-a348-034d8615da41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268286}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b6bb9ee3-564c-5320-9703-cb6c49fcd5d9" :question/math-academy-id "q-51136" :question/problem "Given that\n\n$$\n\\frac{-2x-9}{(x+3)x}=\\frac{1}{(x+3)}+\\frac{B}{x},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{-2x-9}{(x+3)x}=\\frac{1}{(x+3)}+\\frac{B}{x}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+3)x$ gives\n\n$$\n-2x-9=x+B(x+3).\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}-2(0)-9 & =0+B(0+3) \\\\ -9 & =3B \\\\ B & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268292 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b30ba91-ae46-5c8a-a706-eadf49473929" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}+\\frac{3}{(x-1)}+\\frac{2}{(x+5)}" :db/id #edb/ref 17592186268294} {:answer/id #uuid "5487de66-7dc7-5034-8054-c95e685f72e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}+\\frac{4}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186268295} {:answer/id #uuid "caf3373e-14ce-53af-958f-71db5e3cd93e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186268296} {:answer/id #uuid "b551016b-e3f4-554b-afb5-1871fb7b2e49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{(x-3)}+\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186268297} {:answer/id #uuid "39114682-6ec7-594e-8ef7-e381555c6285" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{(x-3)}-\\frac{2}{(x-1)}+\\frac{2}{(x+5)}" :db/id #edb/ref 17592186268298}] :answer-field/correct {:answer/id #uuid "caf3373e-14ce-53af-958f-71db5e3cd93e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}" :db/id #edb/ref 17592186268296} :answer-field/id #uuid "22269ea3-ba61-5af1-b9c9-78ad9e0d52ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268293}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e23b9540-6b27-5f85-a262-32ee244fff8d" :question/math-academy-id "q-69751" :question/problem "Express $\\frac{12x+12}{(x-3)(x-1)(x+5)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{12x+12}{(x-3)(x-1)(x+5)} & =\\frac{A}{(x-3)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x-1)(x+5)$ gives\n\n$$\n12x+12=A(x-1)(x+5)+B(x-3)(x+5)+C(x-3)(x-1).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}12(3)+12 & =A(3-1)(3+5) \\\\  & \\,+B(3-3)(3+5) \\\\  & \\,+C(3-3)(3-1) \\\\ 36+12 & =A(2)(8) \\\\ A & =\\frac{48}{16} \\\\ A & =3.\\end{aligned}\n$$\n\nFor $x=1$, we get \n\n$$\n\\begin{aligned}12(1)+12 & =A(1-1)(1+5) \\\\  & \\,+B(1-3)(1+5) \\\\  & \\,+C(1-3)(1-1) \\\\ 12+12 & =B(-2)(6) \\\\ B & =\\frac{24}{-12} \\\\ B & =-2.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}12(-5)+12 & =A(-5-1)(-5+5) \\\\  & \\,+B(-5-3)(-5+5) \\\\  & \\,+C(-5-3)(-5-1) \\\\ -60+12 & =C(-8)(-6) \\\\ C & =\\frac{-48}{48} \\\\ C & =-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{12x+12}{(x-3)(x-1)(x+5)}=\\frac{3}{(x-3)}-\\frac{2}{(x-1)}-\\frac{1}{(x+5)}.\n$$"}]}
