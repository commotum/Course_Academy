c041030163ff" :answer/id #uuid "88151b03-7ccf-573a-a35d-e07a5093522d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-275511/field-4" :answer-field/id #uuid "f34171ca-8f74-5993-8646-ccca02e382c2" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275511/field-4/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-275511/field-4/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-275511" :question/id #uuid "21ffe3f0-4feb-5d70-b487-86ba7a1c1be2" :question/math-academy-id "q-275511" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}x+2y+2z=5 \\\\ 2x+6y+5z=22 \\\\ x-2y-3z=-1\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $1$ | {{field-1}} | $2$ |  |  |  | $x$ |  |  |  | $5$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | {{field-2}} | $6$ | $5$ |  |  |  | $y$ |  | $=$ |  | {{field-3}} |  | . |\n|  |  | $1$ | $-2$ | {{field-4}} |  |  |  | $z$ |  |  |  | $-1$ |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}x+2y+2z=5 \\\\ 2x+6y+5z=22 \\\\ x-2y-3z=-1\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}1 & 2 & 2 \\\\ 2 & 6 & 5 \\\\ 1 & -2 & -3\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}5 \\\\ 22 \\\\ -1\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}1 & 2 & 2 \\\\ 2 & 6 & 5 \\\\ 1 & -2 & -3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}5 \\\\ 22 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275511/field-1" "q-275511/field-2" "q-275511/field-3" "q-275511/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-275511"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316985/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "f05b4508-334e-5647-ac52-1c34d77ffe58" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-316985/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f87dd92a-95f5-5bc1-ac33-1c9ab1aa25c4" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-316985/field-1" :answer-field/id #uuid "cdf780d9-b415-5718-ad58-68c1088122c8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316985/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-316985/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-316985/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-316985/field-2/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "a9437d0b-b101-59cd-a076-a9d6a69a5f90" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-316985/field-2" :answer-field/id #uuid "b22341ac-f523-5fc6-a2fa-17463c32970f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316985/field-2/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer-field/choices ["q-316985/field-2/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3"] :db/ensure [:answer-field/validate]} {:db/id "q-316985/field-3/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "d57c071e-1253-5179-8885-810c499209f5" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-316985/field-3" :answer-field/id #uuid "6617570b-31ce-518c-bb86-beff57a80369" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316985/field-3/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-316985/field-3/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-316985/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f7e9163d-91b5-589a-b7fa-e5bde257012e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-316985/field-4" :answer-field/id #uuid "8012b573-d9b4-5ed7-87ed-5a0cdec76e3a" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316985/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-316985/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-316985" :question/id #uuid "eb147a5b-b254-59ff-ab9f-0e3ee4e488bb" :question/math-academy-id "q-316985" :question/problem "The system of equations\n\n$$\n{\\begin{aligned}3x-2y+4z=6 \\\\ y-9z=-2 \\\\ x-y-8z=1\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n|  |  | $3$ | $-2$ | {{field-1}} |  |  |  | $x$ |  |  |  | $6$ |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  |  | $0$ | $1$ | {{field-2}} |  |  |  | $y$ |  | $=$ |  | $-2$ |  | . |\n|  |  | $1$ | $-1$ | {{field-3}} |  |  |  | $z$ |  |  |  | {{field-4}} |  |  |" :question/worked-solution "First, let's write the system so that $x$, $y$, and $z$ appear in each equation:\n\n$$\n{\\begin{aligned}3x-2y+4z=6 \\\\ 0x+y-9z=-2 \\\\ x-y-8z=1\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & -2 & 4 \\\\ 0 & 1 & -9 \\\\ 1 & -1 & -8\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}6 \\\\ -2 \\\\ 1\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & -2 & 4 \\\\ 0 & 1 & -9 \\\\ 1 & -1 & -8\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}6 \\\\ -2 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316985/field-1" "q-316985/field-2" "q-316985/field-3" "q-316985/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1938c5da-d01a-53b7-a811-9afe1e43d152"] :knowledge-point/questions ["q-316985"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316987/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "bbe1269f-195b-5f62-b6b1-36a8b0482cbd" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-316987/field-1" :answer-field/id #uuid "7f3c74d2-eed2-5ea4-8c96-61cf205dfcb1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316987/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-316987/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-316987/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "f47dfde3-f646-5d17-96be-388014385f99" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-316987/field-2" :answer-field/id #uuid "46e7d0e4-2ac6-5255-b81d-cd160b07ec81" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316987/field-2/a0e0e68f25b8b46aa