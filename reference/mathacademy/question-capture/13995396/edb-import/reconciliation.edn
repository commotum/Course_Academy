& 4 \\\\ -4 & 1 & 5\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}1 \\\\ 8 \\\\ -3\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}1 & 0 & 1 \\\\ 3 & -1 & 4 \\\\ -4 & 1 & 5\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ 8 \\\\ -3\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995396/state.json" "file_sha256" "c74fda06dd1c9a039fcb37be34cac21e575f1f99f41ad1f4f644ada66e6b2ca3"} {"question" "q-316983" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995396/activity-metadata.json" "file_sha256" "4877b59e1a51f5e28beeeccc2b222edc8519c5e2bce559efbb9c245a1e9da451"} {"question" "q-316983" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995396/state.json" "file_sha256" "c74fda06dd1c9a039fcb37be34cac21e575f1f99f41ad1f4f644ada66e6b2ca3"} {"question" "q-316983" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995396/state.json" "file_sha256" "c74fda06dd1c9a039fcb37be34cac21e575f1f99f41ad1f4f644ada66e6b2ca3"} {"question" "q-316983" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13995396/state.json" "file_sha256" "c74fda06dd1c9a039fcb37be34cac21e575f1f99f41ad1f4f644ada66e6b2ca3"} {"question" "q-316