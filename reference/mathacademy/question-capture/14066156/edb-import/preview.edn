\cdot 3}}{(2\\cdot 3)!} \\\\ {a}_{4} & =\\frac{(-1)^{4+1}{2}^{2\\cdot 4-1}{x}^{2\\cdot 4}}{(2\\cdot 4)!}.\\end{aligned}\n$$\n\nWe deduce that the general formula for the $n$th term is\n\n$$\n{a}_{n}=\\frac{(-1)^{n+1}{2}^{2n-1}{x}^{2n}}{(2n)!}\\,.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{sin}^{2}⁡x & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}{2}^{2n-1}{x}^{2n}}{(2n)!}\\,.\\end{aligned}\n$$" 13194139535485 true] [17592186351586 1000 #edb/ref 17592186351587 13194139535485 true] [17592186351586 1000 #edb/ref 17592186351588 13194139535485 true] [17592186351586 1000 #edb/ref 17592186351589 13194139535485 true] [17592186351586 1000 #edb/ref 17592186351590 13194139535485 true] [17592186351586 1000 #edb/ref 17592186351591 13194139535485 true] [17592186351586 1040 #edb/ref 17592186045450 13194139535485 true] [17592186351586 1041 "selection" 13194139535485 true] [17592186351586 1104 #edb/ref 17592186351591 13194139535485 true] [17592186351586 1110 #uuid "8f797caa-8c2e-5acd-a691-7368d5576928" 13194139535485 true] [17592186351587 1034 "{sin}^{2}⁡x={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n-1}{2}^{n-1}{x}^{2n}}{n!}" 13194139535485 true] [17592186351587 1103 #edb/ref 17592186045453 13194139535485 true] [17592186351587 1111 #uuid "09ed168e-6c5d-5070-bf0d-386de2871281" 13194139535485 true] [17592186351588 1034 "{sin}^{2}⁡x={\\sum }_{n=1}^{\\infty }\\frac{{2}^{2n+1}{x}^{2n}}{(2n)!}" 13194139535485 true] [17592186351588 1103 #edb/ref 17592186045453 13194139535485 true] [17592186351588 1111 #uuid "e5feb6fb-2ddc-511d-a8e0-34730c8d5d66" 13194139535485 true] [17592186351589 1034 "{sin}^{2}⁡x={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}{2}^{n-1}{x}^{2n}}{n!}" 13194139535485 true] [17592186351589 1103 #edb/ref 17592186045453 13194139535485 true] [17592186351589 1111 #uuid "d9beb333-726b-5f3f-b696-ebcba0ea127b" 13194139535485 true] [17592186351590 1034 "{sin}^{2}⁡x={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}{x}^{2n}}{(2n)!}" 13194139535485 true] [17592186351590 1103 #edb/ref 17592186045453