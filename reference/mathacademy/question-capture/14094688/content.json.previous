              "type": "math",
              "value": "{y}^{″}-\\frac{{y}^{′}}{{x}^{2}}+\\frac{3y}{{x}^{2}}=\\frac{{e}^{x}}{{x}^{2}}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "{x}^{2}{y}^{″}-{y}^{′}+3y=0",
              "option": "2",
              "source_option": "c"
            },
            {
