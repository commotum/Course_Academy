" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055663/state.json" "file_sha256" "cf1634a225c4c3e644f2084ccc5912363b741709dfc78e7b57d5b6634b41c2d9"} {"question" "q-116296" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055663/activity-metadata.json" "file_sha256" "4b62787f769c79c89ecea6de9ba458f172c4ff5cad3ecb64410e86ddb5e889cb"} {"question" "q-116296" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055663/state.json" "file_sha256" "cf1634a225c4c3e644f2084ccc5912363b741709dfc78e7b57d5b6634b41c2d9"} {"question" "q-116296" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "14"] ["math" "17"] ["math" "28"] ["math" "34"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055663/state.json" "file_sha256" "cf1634a225c4c3e644f2084ccc5912363b741709dfc78e7b57d5b6634b41c2d9"} {"question" "q-116296" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "17"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055663/state.json" "file_sha256" "cf1634a225c4c3e644f2084ccc5912363b741709dfc78e7b57d5b6634b41c2d9"} {"question" "q-85725" "field" nil "attribute" "question/problem" "value" "Using the trapezoidal rule with the partition\n\n$$\n[-1,4]=[-1,0]\\cup [0,3]\\cup [3,4],\n$$\n\napproximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $-1$ | $0$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $0$ | $2$ | $4$ | $5$ |" "category" "ma_capture" "file" "/home/jake/De