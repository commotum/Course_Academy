76fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "q-130525" "field" nil "attribute" "question/problem" "value" "What is the system of equations represented by\n\n$$\n[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]?\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/state.json" "file_sha256" "1cf2d7cff521a3af2b075976fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "q-130525" "field" nil "attribute" "question/worked-solution" "value" "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-4y=-1 \\\\ 0x+y=3\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-4y=-1 \\\\ y=3.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/state.json" "file_sha256" "1cf2d7cff521a3af2b075976fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "q-130525" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/activity-metadata.json" "file_sha256" "da2609ed45aa31cb1d9766990d31695403480cac39b14c0e2dbfd6af4687a711"} {"question" "q-130525" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/state.json" "file_sha256" "1cf2d7cff521a3af2b075976fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "q-130525" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\begin{aligned}{\\begin{aligned}3x-4y=-1 \\\\ x=3\\end{aligned}\\end{aligned}"] ["math" "\\begin{aligned}{\\begin{aligned}3x-4y=-1 \\\\ y=3\\end{aligned}\\end{aligned}"] ["math" "\\begin{aligned}{\\begin{aligned}3x-4y=-3 \\\\ y=1\\end{aligned}\\end{aligned}"] ["math" "\\begin{aligned}{\\begin{aligned}3x-4y=3 \\\\ x=-1\\end{aligned}\\end{aligned}"] ["math" "\\begin{aligned}{\\begin{aligned}3y-4x=-1 \\\\ y=3\\end{aligned}\\end{aligned}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/state.json" "file_sha256" "1cf2d7cff521a3af2b075976fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "q-130525" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\begin{aligned}{\\begin{aligned}3x-4y=-1 \\\\ y=3\\end{aligned}\\end{aligned}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/state.json" "file_sha256" "1cf2d7cff521a3af2b075976fb8fe8e0cb1fa5b3ecaca0d07086eea6a36a616a"} {"question" "e-4505" "field" nil "attribute" "question/problem" "value" "Represent the following system of equations using matrices:\n\n$$\n{\\begin{aligned}2x=5 \\\\ -5x+6y=-8\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4505.json" "file_sha256" "cb485af6a14777b4b75042c5ecb5a74d3ec1ca91a996e7778067a41b3f9eb9db"} {"question" "e-4505" "field" nil "attribute" "question/worked-solution" "value" "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0.$ So, we get\n\n$$\n{\\begin{aligned}2x+0y=5 \\\\ -5x+6y=-8\\end{aligned}\n$$\n\nNow, we can write the system in the form $A\\mathbf{x} = \\mathbf{b},$ where\n\n$$\n[\\begin{aligned}2 & 0 \\\\ -5 & 6\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\n[\\begin{aligned}5 \\\\ -8\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $A\\mathbf{x} = \\mathbf{b}$ becomes\n\n$$\n[\\begin{aligned}2 & 0 \\\\ -5 & 6\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4505.json" "file_sha256" "cb485af6a14777b4b75042c5ecb5a74d3ec1ca91a996e7778067a41b3f9eb9db"} {"question" "e-4506" "field" nil "attribute" "question/problem" "value" "Represent the following system of equations using matrices:\n\n$$\n\\begin{aligned}{\\begin{aligned}-5y=-3x \\\\ 6+x=-2+y\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4506.json" "file_sha256" "09e29b750be86353c8cddb12ea58e7dd22417a827bd95f7b0e09cc30e2d83fd3"} {"question" "e-4506" "field" nil "attribute" "question/worked-solution" "value" "First, we organize the system so that it’s in the correct order:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-5y=0 \\\\ x-y=-8.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $A\\mathbf{x} = \\mathbf{b},$ where\n\n$$\n[\\begin{aligned}3 & -5 \\\\ 1 & -1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\n[\\begin{aligned}0 \\\\ -8\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $A\\mathbf{x} = \\mathbf{b}$ becomes\n\n$$\n[\\begin{aligned}3 & -5 \\\\ 1 & -1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4506.json" "file_sha256" "09e29b750be86353c8cddb12ea58e7dd22417a827bd95f7b0e09cc30e2d83fd3"} {"question" "e-4507" "field" nil "attribute" "question/problem" "value" "What is the system of equations represented by\n\n$$\n[\\begin{aligned}10 & -15 \\\\ 1 & 0\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4507.json" "file_sha256" "6469b766629a6a7254544167d7755db429c3bd7d3d874ebd5ab613f849e785ab"} {"question" "e-4507" "field" nil "attribute" "question/worked-solution" "value" "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}10x-15y=5 \\\\ 1x+0y=-2\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-3y=1 \\\\ x=-2.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13994130/example-4507.json" "file_sha256" "6469b766629a6a7254544167d7755db429c3bd7d3d874ebd5ab613f849e785ab"}] "usage" {"e-4506" [] "q-31876" [] "e-4505" [] "e-4507" []} "basis" 1076 "retractions" [[17592186115652 :question/problem "What is the system of equations represented by\n\n$\\begin{bmatrix}2 & -5 \\\\ 1 & 0\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix} = \\begin{bmatrix}10 \\\\ -7\\end{bmatrix}$?"] [17592186114979 :question/problem "Represent the following system of equations using matrices:\n${2x = 5; - 5x + 6y =-8$"] [17592186114979 :question/worked-solution "First, let's write the system so that both $x$ and $y$ appear in each equation. The variable $y$ does not appear in the first equation, but this just means its coefficient is $0$. So, we get\n\n$$\n{2x + 0y = 5; - 5x + 6y =-8\n$$\n\nNow, we can write the system in the form\n\n$$\nA\\mathbf{x} = \\mathbf{b}\n$$\n\nwhere\n\n$$\n\\begin{bmatrix}2 & 0 \\\\ -5 & 6\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\n\\begin{bmatrix}5 \\\\ -8\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation\n\n$$\nA\\mathbf{x} = \\mathbf{b}\n$$\n\nbecomes\n\n$$\n\\begin{bmatrix}2 & 0 \\\\ -5 & 6\\end{bmatrix}\n$$"] [17592186114980 :question/problem "Represent the following system of equations using matrices:\n${-5y =-3x; 6 + x =-2 + y$"] [17592186114980 :question/worked-solution "First, we organize the system so that it’s in the correct order:\n\n$$\n{3x - 5y = 0; x - y =-8\n$$\n\nNow, we can write the system in the form\n\n$$\nA\\mathbf{x} = \\mathbf{b}\n$$\n\nwhere\n\n$$\n\\begin{bmatrix}3 & -5 \\\\ 1 & -1\\end{bmatrix}\n$$\n\nis the coefficient matrix,\n\n$$\n\\begin{bmatrix}0 \\\\ -8\\end{bmatrix}\n$$\n\nis the column vector of constants, and\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nis the column vector of variables.\n\nSo, the equation\n\n$$\nA\\mathbf{x} = \\mathbf{b}\n$$\n\nbecomes\n\n$$\n\\begin{bmatrix}3 & -5 \\\\ 1 & -1\\end{bmatrix}\n$$"] [17592186114981 :question/problem "What is the system of equations represented by\n$\\begin{bmatrix}10 & -15 \\\\ 1 & 0\\end{bmatrix}$"] [17592186114981 :question/worked-solution "The $2\\times 2$ matrix represents the coefficients of $x$ and $y$, while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n{10x - 15y = 5; 1x + 0y =-2\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n{2x - 3y = 1; x =-2\n$$"]] "immutable_answers" [17592186113313 17592186113314 17592186113315 17592186113316 17592186113317] "immutable_fields" [[17592186113312 :answer-field/correct] [17592186113312 :answer-field/id] [17592186113312 :answer-field/key] [17592186113312 :answer-field/type]] "no_history" []}
