Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d9ee625-e773-554a-b6fd-1b00c950d2f1" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 3^{2x}\\ln (3)" :db/id #edb/ref 17592186090540} {:answer/id #uuid "a2e4f469-6799-5ce4-b565-a59f324b5ec8" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}" :db/id #edb/ref 17592186090541} {:answer/id #uuid "bdacec05-5c20-55b6-8105-e82bd5158002" :answer/type {:db/ident :answer.type/math} :answer/value "2x3^{2x^{2}}" :db/id #edb/ref 17592186090542} {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090543} {:answer/id #uuid "15755bfa-20fa-599b-b783-c67a495db7ea" :answer/type {:db/ident :answer.type/math} :answer/value "x3^{2x}\\ln (3)" :db/id #edb/ref 17592186090544}] :answer-field/correct {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090543} :answer-field/id #uuid "4acd11bc-cb2e-5a8e-a9ee-06ec6470c2d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090539}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8711f34a-9cc5-5a70-9af6-219e0592f067" :question/math-academy-id "q-48565" :question/problem "If $f(x) = 3^{2x^{2}}$, find $f^{\\prime }(x)$." :question/requires-calculator false :question/worked-solution "Use $\\frac{d}{dx}a^{u(x)}=a^{u(x)}\\ln(a)u'(x)$. With $a=3$ and $u=2x^2$,\n$$f'(x)=3^{2x^2}\\ln3\\cdot4x=4x3^{2x^2}\\ln3.$$"}]}
