#{[{:db/id #edb/ref 17592186249759 :knowledge-point/_questions [{:knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7633ff09-2886-5821-8be3-cc8d80f2099d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{3}" :db/id #edb/ref 17592186249761} {:answer/id #uuid "c9a276fd-4186-5034-8793-05c9b082fb70" :answer/type {:db/ident :answer.type/math} :answer/value "-6{e}^{3}" :db/id #edb/ref 17592186249762} {:answer/id #uuid "d18cb2a1-234f-5f46-a4c8-93978429738c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{{e}^{3}}" :db/id #edb/ref 17592186249763} {:answer/id #uuid "39436a86-2e5d-5e32-bdcb-fd476c50c7e2" :answer/type {:db/ident :answer.type/math} :answer/value "6e" :db/id #edb/ref 17592186249764} {:answer/id #uuid "5bdc4471-b9b6-5880-8b98-6a56d357dddc" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186249765}] :answer-field/correct {:answer/id #uuid "5bdc4471-b9b6-5880-8b98-6a56d357dddc" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186249765} :answer-field/id #uuid "26c38642-25c6-5f0e-b9b9-b362d2d7e047" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249760}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "77890d59-346a-5228-9be0-e4044f5213b2" :question/math-academy-id "q-107449" :question/problem "Find the slope of the tangent to the curve $y={e}^{3{x}^{2}-3}$ at the point where $x=-1.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=3{x}^{2}-3.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 6x \\\\  & =6x\\cdot {e}^{u} \\\\  & =6x{e}^{3{x}^{2}-3}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=-1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={6x{e}^{3{x}^{2}-3}|}_{x=-1} \\\\  & =6(-1){e}^{3(-1)^{2}-3} \\\\  & =-6\\cdot {e}^{0} \\\\  & =-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186249766 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a839a69-99d7-50ca-898d-61aaa9dede58" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186249768} {:answer/id #uuid "33af8915-565a-5c31-a67e-aa1708e98ac8" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{9x}" :db/id #edb/ref 17592186249769} {:answer/id #uuid "f9b299f3-5781-5fab-80b5-308803fa0610" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186249770} {:answer/id #uuid "3a4103f2-4041-5402-99cd-cc01c12e737e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\cdot {2}^{9x}" :db/id #edb/ref 17592186249771} {:answer/id #uuid "932121d5-cafb-5907-9d42-068402fbc1fd" :answer/type {:db/ident :answer.type/math} :answer/value "9x" :db/id #edb/ref 17592186249772}] :answer-field/correct {:answer/id #uuid "f9b299f3-5781-5fab-80b5-308803fa0610" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186249770} :answer-field/id #uuid "cb693ac5-28b4-5926-9496-5f682ea47cde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249767}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b477509-136c-5871-af67-2ab0b198668c" :question/math-academy-id "q-1952" :question/problem "Given that $y={2}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={2}^{u},\\,u=9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={2}^{u}\\operatorname{ln}⁡2,\\,\\frac{\\text{d}u}{\\text{d}x}=9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}⁡2\\cdot 9 \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{u} \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{9x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092563 :knowledge-point/_questions [{:knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6867491-f8fd-512e-b8a7-33892766e3a7" :answer/type {:db/ident :answer.type/math} :answer/value "xe^{x^{2}}" :db/id #edb/ref 17592186089927} {:answer/id #uuid "b5e0151e-8cc6-54e0-bceb-1c813a88be48" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}" :db/id #edb/ref 17592186089928} {:answer/id #uuid "3ed97557-c81c-5ca7-b0df-cca96769efcb" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x^{2}}" :db/id #edb/ref 17592186089929} {:answer/id #uuid "41298a3f-e5f6-5a78-8d47-db9077c096ba" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{x^{2}}" :db/id #edb/ref 17592186089930} {:answer/id #uuid "4cddf285-8e2a-558b-8f18-3319cc20b146" :answer/type {:db/ident :answer.type/math} :answer/value "2xe^{x^{2}}" :db/id #edb/ref 17592186089931}] :answer-field/correct {:answer/id #uuid "4cddf285-8e2a-558b-8f18-3319cc20b146" :answer/type {:db/ident :answer.type/math} :answer/value "2xe^{x^{2}}" :db/id #edb/ref 17592186089931} :answer-field/id #uuid "619a666e-3531-5f6b-8160-33e059f71ca1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089926}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0e52fa16-cf3e-5339-95e2-786fe7ef7e5d" :question/math-academy-id "q-1953" :question/problem "Find $f^{\\prime }(x)$ for $f(x) = e^{x^{2}}$." :question/requires-calculator false :question/worked-solution "The outer exponential differentiates to itself, and the inner function $x^2$ has derivative $2x$:\n$$f'(x)=e^{x^2}\\cdot2x=2xe^{x^2}.$$"}] [{:db/id #edb/ref 17592186249773 :knowledge-point/_questions [{:knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d471c6b5-2431-5ed8-b576-4e191ed19ba0" :answer/type {:db/ident :answer.type/math} :answer/value "20x^4e^{4x^5}" :db/id #edb/ref 17592186249775}] :answer-field/correct {:answer/id #uuid "d471c6b5-2431-5ed8-b576-4e191ed19ba0" :answer/type {:db/ident :answer.type/math} :answer/value "20x^4e^{4x^5}" :db/id #edb/ref 17592186249775} :answer-field/id #uuid "1d9c6ce5-8de6-56dd-8bc7-59192c7a2d6c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186249774}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6783757f-0379-51c5-a01c-1def6a588ccb" :question/math-academy-id "q-312451" :question/problem "Given that $f(x)={e}^{4{x}^{5}},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=4{x}^{5}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=20{x}^{4}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (20{x}^{4}) \\\\  & =20{x}^{4}{e}^{u} \\\\  & =20{x}^{4}{e}^{4{x}^{5}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092679 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d9ee625-e773-554a-b6fd-1b00c950d2f1" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 3^{2x}\\ln (3)" :db/id #edb/ref 17592186090540} {:answer/id #uuid "a2e4f469-6799-5ce4-b565-a59f324b5ec8" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}" :db/id #edb/ref 17592186090541} {:answer/id #uuid "bdacec05-5c20-55b6-8105-e82bd5158002" :answer/type {:db/ident :answer.type/math} :answer/value "2x3^{2x^{2}}" :db/id #edb/ref 17592186090542} {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090543} {:answer/id #uuid "15755bfa-20fa-599b-b783-c67a495db7ea" :answer/type {:db/ident :answer.type/math} :answer/value "x3^{2x}\\ln (3)" :db/id #edb/ref 17592186090544}] :answer-field/correct {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090543} :answer-field/id #uuid "4acd11bc-cb2e-5a8e-a9ee-06ec6470c2d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090539}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8711f34a-9cc5-5a70-9af6-219e0592f067" :question/math-academy-id "q-48565" :question/problem "If $f(x) = 3^{2x^{2}}$, find $f^{\\prime }(x)$." :question/requires-calculator false :question/worked-solution "Use $\\frac{d}{dx}a^{u(x)}=a^{u(x)}\\ln(a)u'(x)$. With $a=3$ and $u=2x^2$,\n$$f'(x)=3^{2x^2}\\ln3\\cdot4x=4x3^{2x^2}\\ln3.$$"}]}
