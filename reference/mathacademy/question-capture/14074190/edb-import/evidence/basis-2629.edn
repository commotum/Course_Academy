#{[{:db/id #edb/ref 17592186375482 :knowledge-point/_questions [{:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6" :knowledge-point/title "Identifying Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d0fd996-c57e-5139-a4f4-90ca5c65f5c3" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375484} {:answer/id #uuid "a104965a-e982-5d79-81df-5a485c54f2c4" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375485}] :answer-field/correct {:answer/id #uuid "8d0fd996-c57e-5139-a4f4-90ca5c65f5c3" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375484} :answer-field/id #uuid "c117b3c3-c2d3-5439-811c-aa143241f4fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375483} {:answer-field/choices [{:answer/id #uuid "68e19d30-2771-5e78-92d1-42f0e84dc711" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375487} {:answer/id #uuid "78e1f85e-ad80-5a7c-9fa5-a0cd67b8aab7" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375488}] :answer-field/correct {:answer/id #uuid "78e1f85e-ad80-5a7c-9fa5-a0cd67b8aab7" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375488} :answer-field/id #uuid "8829219e-1bf2-5f9f-930a-f33f21ba659f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375486} {:answer-field/choices [{:answer/id #uuid "2d89d41e-d0de-5fa0-a519-0bbafbf9e73c" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375490} {:answer/id #uuid "8eecc096-b03c-5a44-8e32-37a248a69cb6" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375491}] :answer-field/correct {:answer/id #uuid "8eecc096-b03c-5a44-8e32-37a248a69cb6" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375491} :answer-field/id #uuid "a3566069-abad-563e-a36c-639688c12233" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375489}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8da06f22-6a38-578e-b590-3e2d4a9025f6" :question/math-academy-id "q-338004" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}+3{y}^{′}=x$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}-xy+4x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+3{y}^{′}=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}-xy+4x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-xy=-4x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-4x,$ which is different from zero."}] [{:db/id #edb/ref 17592186375492 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3752d86c-7a3b-5c0e-9a51-0507c31bc467" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186375494} {:answer/id #uuid "8feb8a2a-230c-5cf3-bff7-a3994bb049be" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186375495} {:answer/id #uuid "ba04aeca-04dc-5e8f-9ba3-261b61a26a77" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375496} {:answer/id #uuid "42266fdf-5a26-58dc-89c4-602074a77807" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186375497} {:answer/id #uuid "24d63809-e024-53f3-87cc-61435b10644a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186375498}] :answer-field/correct {:answer/id #uuid "ba04aeca-04dc-5e8f-9ba3-261b61a26a77" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375496} :answer-field/id #uuid "11078401-779e-5895-a7c6-38aec08aefe4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375493}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8f4d7ab-4946-517f-88cd-116b43135b3b" :question/math-academy-id "q-339254" :question/problem "Which of the following systems is an initial value problem?\n\n- $x{y}^{″}-4{y}^{′}+4y=\\operatorname{sin}⁡x+2x,\\,y(-1)=2,\\,{y}^{′}(2)=0$\n- ${x}^{2}{y}^{″}-{y}^{′}+y=8$\n- $x{y}^{″}+{y}^{′}-3y={e}^{x},\\,y(1)=0,\\,{y}^{′}(1)=4$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an initial value problem.  It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=-1$ and $x=2$). This is a **boundary value problem.**\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."}]}
