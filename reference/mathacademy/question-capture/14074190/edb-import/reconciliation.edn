n is\n\n$$\n{y}^{″}-y=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/state.json" "file_sha256" "9e86ec5c87e6cb4ebe25403fa76a012ddaca79b0a6a8fd49950f6b37e798e127"} {"question" "q-93779" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/activity-metadata.json" "file_sha256" "89e828676ccf83c46fe4cccafe80b303ef8c807dbf04f332771e576ba3cef831"} {"question" "q-93779" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/state.json" "file_sha256" "9e86ec5c87e6cb4ebe25403fa76a012ddaca79b0a6a8fd49950f6b37e798e127"} {"question" "q-93779" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{y}^{″}+y=0"] ["math" "{y}^{″}+y=1"] ["math" "{y}^{″}-y=0"] ["math" "{y}^{″}-y=1"] ["math" "{y}^{″}=16"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/state.json" "file_sha256" "9e86ec5c87e6cb4ebe25403fa76a012ddaca79b0a6a8fd49950f6b37e798e127"} {"question" "q-93779" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{y}^{″}-y=0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/state.json" "file_sha256" "9e86ec5c87e6cb4ebe25403fa76a012ddaca79b0a6a8fd49950f6b37e798e127"} {"question" "q-130991" "field" nil "attribute" "question/problem" "value" "For the differential equation ${x}^{2}{y}^{″}-5x{y}^{′}+8y=2x,$ what is the associated homogeneous equation?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14074190/state.json" "file_sha256" "9e86ec5c87e6cb4ebe25403fa76a012dda