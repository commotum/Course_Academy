90d4f7eb685a5b8be01edae0f5e6142ad9515316ea1e"] :db/ensure [:answer-field/validate]} {:db/id "q-120835" :question/id #uuid "b24174ad-9291-5093-8bdb-f1435a702636" :question/math-academy-id "q-120835" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{5}{8}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{5}{8})=38.682{…}^{∘}≈{38.68}^{∘}\\end{aligned}\n$$\n\nSince ${38.68}^{∘}$ lies inside the range, our first solution is ${x}_{1}={38.68}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={38.68}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={38.68}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/12b17e3994be5e45af3aca185b22618dd0ec7288fba18a4131387783323247a0.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{38.68}^{∘} \\\\  & ={141.32}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x={39}^{∘},{141}^{∘}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120835/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80"] :knowledge-point/questions ["q-120835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330663/field-1/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "d8e25b80-a766-5b41-ac4e-ca268bd5bc52" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-330663/field-1" :answer-field/id #uuid "2f42c789-747e-5627-8f20-c8d3b9fd661f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-330663/field-1/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer-field/choices ["q-330663/field-1/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f"] :db/ensure [:answer-field/validate]} {:db/id "q-330663/field-2/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "98312467-7520-5292-991b-64a09c7f986e" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-330663/field-2" :answer-field/id #uuid "2d19ee50-c44d-5ec0-b6bf-4ede4bee3143" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-330663/field-2/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer-field/choices ["q-330663/field-2/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13"] :db/ensure [:answer-field/validate]} {:db/id "q-330663" :question/id #uuid "e93742e6-32b2-5ea2-b7c6-d59a5b4d9938" :question/math-academy-id "q-330663" :question/problem "Expressed in **ascending order** in radians, rounded to one decimal place, the solutions to the equation  $\\operatorname{sin}⁡x=\\frac{5}{8},$ for $0\\le x<2\\pi ,$   are\n\n$x≈$\n{{field-1}}, $\\,x≈$\n{{field-2}}." :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{5}{8})=0.675\\,131…≈0.6751\n$$\n\nSince $0.675\\,1$ lies inside the given domain, our first solution is ${x}_{1}=0.6751.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.6751.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=0.6751.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/cc57a94c1f4f4fa53e35930c053b8f2e3f2be0fee0beb8d1584835a0f134b800.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -0.675\\,1 \\\\  & ≈2.4665\\end{aligned}\n$$\n\nSo, in ascending order, rounded to one decimal place, the solutions are \n\n$$\nx≈0.7,\\,x≈2.5.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-330663/field-1" "q-330663/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80"] :knowledge-point/questions ["q-330663"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332214/field-1/880a0d897c978cd3284f4ecfb10c77792658d8e40b9c8b17803ac3cc531f93ff" :answer/id #uuid "6abb14c8-ee35-5239-84d7-329511240beb" :answer/type :answer.type/math :answer/value "204" :db/ensure [:answer/validate]} {:db/id "q-332214/field-1/d08646c2f50451273289f70234ad37461708726d9b49076c584b9c56e3de2a39" :answer/id #uuid "eccbad77-5cbf-5fdf-a4eb-40f1c2b91683" :answer/type :answer.type/math :answer/value "156" :db/ensure [:answer/validate]} {:db/id "q-332214/field-1" :answer-field/id #uuid "bb3e03da-efec-5b44-bdb4-a37c4c752b80" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332214/field-1/880a0d897c978cd3284f4ecfb10c77792658d8e40b9c8b17803ac3cc531f93ff" :answer-field/choices ["q-332214/field-1/880a0d897c978cd3284f4ecfb10c77792658d8e40b9c8b17803ac3cc531f93ff" "q-332214/field-1/d08646c2f50451273289f70234ad37461708726d9b49076c584b9c56e3de2a39"] :db/ensure [:answer-field/validate]} {:db/id "q-332214/field-2/7173d1770b866d90d9621b10fcad5953abe3f412d50d7a07cd1cafe529cb9acb" :answer/id #uuid "0282ece3-addf-5893-9644-2e7c00306e41" :answer/type :answer.type/math :answer/value "336" :db/ensure [:answer/validate]} {:db/id "q-332214/field-2" :answer-field/id #uuid "47d3e73e-0ead-544c-9943-97d1f6479dac" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332214/field-2/7173d1770b866d90d9621b10fcad5953abe3f412d50d7a07cd1cafe529cb9acb" :answer-field/choices ["q-332214/field-2/7173d1770b866d90d9621b10fcad5953abe3f412d50d7a07cd1cafe529cb9acb"] :db/ensure [:answer-field/validate]} {:db/id "q-332214" :question/id #uuid "cf2df75b-484a-58d6-a8d4-ae002ab4cfbe" :question/math-academy-id "q-332214" :question/problem "Expressed in **ascending order** in degrees, rounded to the nearest integer, the solutions to the equation  $\\operatorname{sin}⁡x=-0.4,$ for ${0}^{∘}\\le x<{360}^{∘},$   are\n\n$x≈$\n{{field-1}}${}^{∘}$, $\\,x≈$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-0.4)=-23.578\\,178{…}^{∘}≈-{23.578}^{∘}\\end{aligned}\n$$\n\nNote that $x=-{23.578}^{∘}$ is not in the domain ${0}^{∘}\\le x<{360}^{∘}.$ To get the first solution that's within the required domain, we need to find an angle that's coterminal with $-{23.578}^{∘}.$ To do this, we simply add ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & =-{23.578}^{∘}+{360}^{∘}={336.422}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={23.578}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={23.578}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/c587e119531c3363816f72e9f2e1acdcc1aba87f278caa658342cbff144b0dad.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{23.578}^{∘} \\\\  & ={203.578}^{∘}\\end{aligned}\n$$\n\nSo, in ascending order, rounded to the nearest integer, the solutions are \n\n$$\nx≈{204}^{∘},\\,x≈{336}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332214/field-1" "q-332214/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80"] :knowledge-point/questions ["q-332214"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331941/field-1/59aed57f41e18b28e62913aef722072df30eb021fdbba674960b6ff4e4b74960" :answer/id #uuid "1429e42c-562f-5917-b25e-ca5008b3353c" :answer/type :answer.type/math :answer/value "4.1" :db/ensure [:answer/validate]} {:db/id "q-331941/field-1" :answer-field/id #uuid "a1caffdd-019e-52f5-92f2-992cff113b33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331941/field-1/59aed57f41e18b28e62913aef722072df30eb021fdbba674960b6ff4e4b74960" :answer-field/choices ["q-331941/field-1/59aed57f41e18b28e62913aef722072df30eb021fdbba674960b6ff4e4b74960"] :db/ensure [:answer-field/validate]} {:db/id "q-331941/field-2/da8567abe30c63b035f5c2058bf52ce89794102e0e5c30fc9632702dbaaf7e8b" :answer/id #uuid "7ff6a2ca-ec61-51fc-8cc5-ef00ae05a333" :answer/type :answer.type/math :answer/value "5.4" :db/ensure [:answer/validate]} {:db/id "q-331941/field-2" :answer-field/id #uuid "db237d7e-87c4-51d1-819e-1a834f2ce9dc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331941/field-2/da8567abe30c63b035f5c2058bf52ce89794102e0e5c30fc9632702dbaaf7e8b" :answer-field/choices ["q-331941/field-2/da8567abe30c63b035f5c2058bf52ce89794102e0e5c30fc9632702dbaaf7e8b"] :db/ensure [:answer-field/validate]} {:db/id "q-331941" :question/id #uuid "9ab73ac6-666a-53fb-9700-080fffc9262a" :question/math-academy-id "q-331941" :question/problem "Expressed in **ascending order** in radians, rounded to one decimal place, the solutions to the equation  $\\operatorname{sin}⁡x=-0.8,$ for $0\\le x<2\\pi ,$   are\n\n$x≈$\n{{field-1}}, $\\,x≈$\n{{field-2}}." :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-0.8)=-0.927\\,295…≈-0.9273\\end{aligned}\n$$\n\nNote that $x=-0.9273$ is not in the domain $0\\le x<2\\pi .$ To get the first solution that's within the required domain, we need to find an angle that's coterminal with $-0.9273.$ To do this, we simply add $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{1} & =-0.9273+2\\pi ≈5.3559\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.9273.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.9273.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/942d3d727557ee280b93b212e856f4a696bcf06438944299fd6596dfb5b147f4.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.9273 \\\\  & ≈4.0689\\end{aligned}\n$$\n\nSo, in ascending order, rounded to one decimal place, the solutions are  \n\n$$\nx≈4.1,\\,x≈5.4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-331941/field-1" "q-331941/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80"] :knowledge-point/questions ["q-331941"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336334/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" :answer/id #uuid "15580266-990f-55dc-b202-bb14b00462f0" :answer/type :answer.type/math :answer/value "37" :db/ensure [:answer/validate]} {:db/id "q-336334/field-1" :answer-field/id #uuid "d17ccb40-9d6b-5335-92a2-1be20755c4e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336334/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" :answer-field/choices ["q-336334/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b"] :db/ensure [:answer-field/validate]} {:db/id "q-336334/field-2/64e7d488e6b519230986587b06a42117b98f02afad38a279034e21e786619a7b" :answer/id #uuid "06db14ed-4f85-53ff-a5eb-6d4e399ecab2" :answer/type :answer.type/math :answer/value "143" :db/ensure [:answer/validate]} {:db/id "q-336334/field-2" :answer-field/id #uuid "0a8ecd3a-d05a-5449-b932-9b5b53d4bb32" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336334/field-2/64e7d488e6b519230986587b06a42117b98f02afad38a279034e21e786619a7b" :answer-field/choices ["q-336334/field-2/64e7d488e6b519230986587b06a42117b98f02afad38a279034e21e786619a7b"] :db/ensure [:answer-field/validate]} {:db/id "q-336334" :question/id #uuid "ec3e1fb9-d781-5f7e-a220-d10cd6e8bc01" :question/math-academy-id "q-336334" :question/problem "Expressed in **ascending order** in degrees, rounded to the nearest integer, the solutions to the equation $5\\operatorname{sin}⁡x-3=0,$ for $-{180}^{∘}<x\\le {180}^{∘},$ are\n\n$x≈$\n{{field-1}}${}^{∘}$, $\\,x≈$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sin}⁡x:$\n\n$$\n\\begin{aligned}5\\operatorname{sin}⁡x-3 & =0 \\\\ 5\\operatorname{sin}⁡x & =3 \\\\ \\operatorname{sin}⁡x & =0.6\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(0.6)=36.869\\,897{…}^{∘}≈{36.870}^{∘}\n$$\n\nSince $36.870$ lies inside the range, our first solution is ${x}_{1}={36.870}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={36.870}^{∘}.$\nSince $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={36.870}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/38b2ec0588022556acd825c6b351d572d52034c6ec5cdeddbdff1dbf7baa11a2.png)\n\nA second solution $X$ lies in the $2$nd quadrant, and we can find it using the reference angle as follows:\n\n$$\nX={180}^{∘}-{\\theta }_{R}={180}^{∘}-{36.870}^{∘}={143.130}^{∘}\n$$\n\nSince this value is already inside the required domain, we keep it as our second solution.\n\nSo, in ascending order, rounded to one decimal place, the solutions are\n\n$$\nx≈{37}^{∘},\\,x≈{143}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336334/field-1" "q-336334/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "28f4d12d-55f3-5551-a993-70590cc67cb9"] :knowledge-point/questions ["q-336334"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8577/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "f18ae463-24cd-526a-9ab2-cf9162993d4e" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-8577/selection/2468d3f08d897d95f4d28b48c13e6034ce1716985d166fd89a0b8119476fe5c8" :answer/id #uuid "693dc3f6-d8a0-57f3-ac6c-29672825f04e" :answer/type :answer.type/math :answer/value "0.2" :db/ensure [:answer/validate]} {:db/id "q-8577/selection/47e062f84c7679179a100f841000c1550fcbc886f881ad4b3253348673d23026" :answer/id #uuid "08dd75db-52fe-5aae-a63d-2a9af77f01d8" :answer/type :answer.type/math :answer/value "0.4" :db/ensure [:answer/validate]} {:db/id "q-8577/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "dfc1e288-aec1-5302-8752-5455123228c0" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-8577/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" :answer/id #uuid "b5f88483-fb58-5083-995b-e2c47fb0d899" :answer/type :answer.type/math :answer/value "0.6" :db/ensure [:answer/validate]} {:db/id "q-8577/selection" :answer-field/id #uuid "c8d0296e-d835-500c-b67b-42fc5db69ee3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8577/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer-field/choices ["q-8577/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" "q-8577/selection/2468d3f08d897d95f4d28b48c13e6034ce1716985d166fd89a0b8119476fe5c8" "q-8577/selection/47e062f84c7679179a100f841000c1550fcbc886f881ad4b3253348673d23026" "q-8577/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" "q-8577/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f"] :db/ensure [:answer-field/validate]} {:db/id "q-8577" :question/id #uuid "94f21909-0674-569b-9e74-b7afb787ec1c" :question/math-academy-id "q-8577" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{sin}⁡x=-\\frac{1}{6}$ for $-\\pi <x\\le \\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to $1$ decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-\\frac{1}{6})=-0.167\\,448…≈-0.167\\,4\\end{aligned}\n$$\n\nSince $-0.167$ lies inside the given domain, our first solution is ${x}_{1}=-0.167\\,4.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.167\\,4.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.167\\,4.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/f6f08d799cd2d2e80494d94cc3b18a61f73227b88b25d79c926d65e161d4ce3a.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.167\\,4 \\\\  & ≈3.309\\,0\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we simply subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{2}=X-2\\pi  & ≈3.309-2\\pi ≈-2.974\\,2\\end{aligned}\n$$\n\n \n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=(-0.167\\,4)\\cdot (-2.974\\,2)≈0.5,\n$$\n\nrounded to $1$ decimal place." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8577/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "28f4d12d-55f3-5551-a993-70590cc67cb9"] :knowledge-point/questions ["q-8577"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274616/field-1/754805006cecee8968b44b3629bbef018dba1df5832809b421fffafec57f1b71" :answer/id #uuid "c46f2a38-ffd0-5e84-a14b-60b184402e1b" :answer/type :answer.type/math :answer/value "-2.4" :db/ensure [:answer/validate]} {:db/id "q-274616/field-1" :answer-field/id #uuid "e8f8375f-b8b3-5341-a2da-1051cdb5b7b5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274616/field-1/754805006cecee8968b44b3629bbef018dba1df5832809b421fffafec57f1b71" :answer-field/choices ["q-274616/field-1/754805006cecee8968b44b3629bbef018dba1df5832809b421fffafec57f1b71"] :db/ensure [:answer-field/validate]} {:db/id "q-274616/field-2/deb5aed8398f29a5975d8ef7b1698f489b03142e5a675a18eb7befbb96daa6c6" :answer/id #uuid "6740a829-3fa0-536f-a658-fabe50839ef2" :answer/type :answer.type/math :answer/value "-0.7" :db/ensure [:answer/validate]} {:db/id "q-274616/field-2" :answer-field/id #uuid "7dd25aa3-1391-563d-be1c-84498d724cf4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274616/field-2/deb5aed8398f29a5975d8ef7b1698f489b03142e5a675a18eb7befbb96daa6c6" :answer-field/choices ["q-274616/field-2/deb5aed8398f29a5975d8ef7b1698f489b03142e5a675a18eb7befbb96daa6c6"] :db/ensure [:answer-field/validate]} {:db/id "q-274616" :question/id #uuid "2b293cb0-dbb6-5ad3-aa5f-1f351c2786fb" :question/math-academy-id "q-274616" :question/problem "Expressed in **ascending order** in radians, rounded to one decimal place, the solutions to the equation $\\operatorname{sin}⁡x=-\\frac{2}{3},$ for $-\\pi <x\\le \\pi ,$  are\n\n$x≈$\n{{field-1}}$,\\,x≈$\n{{field-2}}." :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-\\frac{2}{3})=-0.729\\,727…≈-0.7297\\end{aligned}\n$$\n\nSince $-0.729\\,7$ lies inside the given domain, our first solution is ${x}_{1}=-0.7297.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.7297.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.7297.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/92b256db68d09a07e5072d12cb18470e2c165b6f3c8aa29c6953d9aebb3b024e.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.7297 \\\\  & ≈3.8713\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we simply subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{2}=X-2\\pi  & =3.871\\,3-2\\pi ≈-2.4119\\end{aligned}\n$$\n\n \n\nSo, in ascending order, rounded to one decimal place, the solutions are \n\n$$\nx≈-2.4,\\,x≈-0.7.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274616/field-1" "q-274616/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "28f4d12d-55f3-5551-a993-70590cc67cb9"] :knowledge-point/questions ["q-274616"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274615/field-1/7b07fa4180fe9201f7944b6f4f5341acec086b4c50de2b4f4928478622402d76" :answer/id #uuid "991c0455-d30c-58f1-8874-052de9174b31" :answer/type :answer.type/math :answer/value "-\\frac{5\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-274615/field-1/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a" :answer/id #uuid "ca5ee29f-38f8-500f-baa7-560bc2256f66" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-274615/field-1" :answer-field/id #uuid "24d0a9c7-d834-5952-86e2-fddffe662513" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274615/field-1/7b07fa4180fe9201f7944b6f4f5341acec086b4c50de2b4f4928478622402d76" :answer-field/choices ["q-274615/field-1/7b07fa4180fe9201f7944b6f4f5341acec086b4c50de2b4f4928478622402d76" "q-274615/field-1/09f471dae983db28c0826657524c52e39160889c30208ec0dd3cf10ef9c2407a"] :db/ensure [:answer-field/validate]} {:db/id "q-274615/field-2/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91" :answer/id #uuid "8db78de7-b90a-517e-a43e-31ebd621d680" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-274615/field-2" :answer-field/id #uuid "8ef4750c-7e14-5a4f-a30c-15e82e2884cc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274615/field-2/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91" :answer-field/choices ["q-274615/field-2/d2e5ac5d5dcba192fcba3a9943cd198d6d54ef2b54bcd6689f92dfae1fe7cd91"] :db/ensure [:answer-field/validate]} {:db/id "q-274615" :question/id #uuid "5395407a-550d-531d-be2e-5a1a73b82301" :question/math-academy-id "q-274615" :question/problem "Expressed in **ascending order** in radians, the exact solutions to the equation $\\operatorname{sin}⁡x=-\\frac{1}{2},$ for $-\\pi <x\\le \\pi ,$ are\n\n$x=$\n{{field-1}} $,\\,x=$\n{{field-2}}$.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-\\frac{1}{2})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $-\\frac{\\pi }{6}$ lies inside the required domain, our first solution is ${x}_{1}=-\\frac{\\pi }{6}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/b7b581dc39ba057033703c3549a721679d1d063267e13b65c73a9b9fcd66f1e6.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we simply subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{2}=X-2\\pi  & =\\frac{7\\pi }{6}-2\\pi =-\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSo, in ascending order, the solutions are \n\n$$\nx=-\\frac{5\\pi }{6},\\,x=-\\frac{\\pi }{6}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-274615/field-1" "q-274615/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "28f4d12d-55f3-5551-a993-70590cc67cb9"] :knowledge-point/questions ["q-274615"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17495/selection/2f17ce227e78883df54e075512ee5ba43912d4c366b89b4d4b720a846eb230d9" :answer/id #uuid "6b511b57-00ae-5915-af07-2742e94b915f" :answer/type :answer.type/math :answer/value "x=-{112}^{∘},-{58}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17495/selection/003f3e3a0edc76095c875e249662e4a8a5e75fc36ac841f132feaf1971553a3c" :answer/id #uuid "7f2f7862-ceb2-5d9e-98c4-913ba58db55b" :answer/type :answer.type/math :answer/value "x=-{122}^{∘},-{58}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17495/selection/580e94c2f8d6655af6bc4c9262530f6c98e1ef53358228345192743f8c5f6069" :answer/id #uuid "b93f5ce3-db39-50ee-892f-c72ac540227e" :answer/type :answer.type/math :answer/value "x=-{142}^{∘},-{38}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17495/selection/195a4c5612ce7579a491a5641a55067e3069262fdf1da79a61022178fb4830c5" :answer/id #uuid "04774c03-f698-556f-963c-f1c091a60392" :answer/type :answer.type/math :answer/value "x=-{132}^{∘},-{58}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17495/selection/b3d9e87893ca6d3e44a7a22e7bce6853b44970cb0553d57ca43d8d88526dc999" :answer/id #uuid "efaeb349-441c-5525-93ed-71d8c08768bd" :answer/type :answer.type/math :answer/value "x=-{122}^{∘},-{78}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-17495/selection" :answer-field/id #uuid "65386fb3-866c-5fba-857f-c17ef7d735cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17495/selection/003f3e3a0edc76095c875e249662e4a8a5e75fc36ac841f132feaf1971553a3c" :answer-field/choices ["q-17495/selection/2f17ce227e78883df54e075512ee5ba43912d4c366b89b4d4b720a846eb230d9" "q-17495/selection/003f3e3a0edc76095c875e249662e4a8a5e75fc36ac841f132feaf1971553a3c" "q-17495/selection/580e94c2f8d6655af6bc4c9262530f6c98e1ef53358228345192743f8c5f6069" "q-17495/selection/195a4c5612ce7579a491a5641a55067e3069262fdf1da79a61022178fb4830c5" "q-17495/selection/b3d9e87893ca6d3e44a7a22e7bce6853b44970cb0553d57ca43d8d88526dc999"] :db/ensure [:answer-field/validate]} {:db/id "q-17495" :question/id #uuid "1854b83d-f26f-59a0-b8ab-54decd251347" :question/math-academy-id "q-17495" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=-\\frac{11}{13}$ for $-{180}^{∘}<x\\le {180}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-\\frac{11}{13})=-57.795\\,772{…}^{∘}≈-{57.796}^{∘}\\end{aligned}\n$$\n\nSince $-{57.796}^{∘}$ lies inside the range, our first solution is ${x}_{1}=-{57.796}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={57.796}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={57.796}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951962/assets/f204faa6327d057dbea5de66f2c6ffca0a9982c299d1e4278dbc6514ddf016df.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{57.796}^{∘} \\\\  & ={237.796}^{∘}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we simply subtract ${360}^{∘}:$\n\n$$\n{x}_{2}=X-{360}^{∘}={237.796}^{∘}-{360}^{∘}=-{122.204}^{∘}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x=-{122}^{∘},-{58}^{∘}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17495/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "28f4d12d-55f3-5551-a993-70590cc67cb9"] :knowledge-point/questions ["q-17495"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-8578"] :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSince $-\\frac{\\pi }{2}$ lies inside the required domain, our first solution is ${x}_{1}=-\\frac{\\pi }{2}.$ \n\nAs this is a quadrantal angle, to find the remaining solutions we use our knowledge of the sine function. We know that the sine function has its  minimum values at:\n\n$$\nx=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nSince the domain $-\\pi <x\\le \\pi $ is one period, and we have already found one minimum value in this period, we conclude that $x=-\\frac{\\pi }{2}$ is the only solution." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-336371/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer/id #uuid "b5278254-d9f4-5a7d-af87-3aec813d39e5" :answer/type :answer.type/math :answer/value "270" :db/ensure [:answer/validate]} {:db/id "q-336371/field-1/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "d1ad89c8-de5f-5d3b-9ea7-f90855532f8b" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-336371/field-1" :answer-field/id #uuid "75f6a12e-3c43-5303-9ac6-14fa8ed000d3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336371/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer-field/choices ["q-336371/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" "q-336371/field-1/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412"] :db/ensure [:answer-field/validate]} {:db/id "q-336371" :question/id #uuid "92c7a61a-1b24-5973-8dc6-9a50be918a9d" :question/math-academy-id "q-336371" :question/problem "Solve the equation  $\\operatorname{sin}⁡x=-1$ for ${0}^{∘}\\le x<{360}^{∘}.$ Give your answer in degrees.\n\n$x=$\n{{field-1}}${}^{∘}$" :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-1)=-{90}^{∘}\n$$\n\nSince $-{90}^{∘}$ does not lie inside the required domain, we add one full period of ${360}^{∘}$ to find an equivalent angle in the domain:\n\n$$\n-{90}^{∘}+{360}^{∘}={270}^{∘}\n$$\n\nThus, our first solution in the required domain is ${x}_{1}={270}^{∘}.$ \n\nAs this is a quadrantal angle, to find the remaining solutions we use our knowledge of the sine function. We know that the sine function has its minimum values at\n\n$$\nx={270}^{∘}+{360}^{∘}\\cdot n\n$$\n\nSince the domain ${0}^{∘}\\le x<{360}^{∘}$ is one period, and we have already found one minimum value in this period, we conclude that $x={270}^{∘}$ is the only solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336371/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6fa751e-c9a4-5f02-b858-d841f0e6ce70"] :knowledge-point/questions ["q-336371"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8435/selection/4474a39579e8640865737ab970e0c30d067a600377b903df4b98790832a3d86e" :answer/id #uuid "954460b8-3c52-5727-8186-b7b3d4272d66" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-8435/selection/614ed68495b64af8ec0e7df520ef4d752647d6d96b370efa311048a55189b704" :answer/id #uuid "6a5144bc-ff27-59fe-87e7-6444aa9da30e" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2},\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-8435/selection/c143ca64ec013e5fe4018485f8c456b26425ea6baf2691e509470a46cd90ac4d" :answer/id #uuid "8602cc4d-dd75-5d1a-b6a3-2af6a77e8d40" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-8435/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" :answer/id #uuid "af46b789-b51a-506d-bbb0-9072f5c70cc8" :answer/type :answer.type/math :answer/value "x=\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-8435/selection/a082b7caf9269f94c3522393a4e8823530d1770949c5cedeffb09c8a5896053d" :answer/id #uuid "590b4250-b0ab-567a-aa66-08a67da4eeb0" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{4},\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-8435/selection" :answer-field/id #uuid "45e3f008-b480-54b3-9d1b-16add72a5de4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8435/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" :answer-field/choices ["q-8435/selection/4474a39579e8640865737ab970e0c30d067a600377b903df4b98790832a3d86e" "q-8435/selection/614ed68495b64af8ec0e7df520ef4d752647d6d96b370efa311048a55189b704" "q-8435/selection/c143ca64ec013e5fe4018485f8c456b26425ea6baf2691e509470a46cd90ac4d" "q-8435/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" "q-8435/selection/a082b7caf9269f94c3522393a4e8823530d1770949c5cedeffb09c8a5896053d"] :db/ensure [:answer-field/validate]} {:db/id "q-8435" :question/id #uuid "5dc2b789-e2f1-573b-a8c7-91ecf7b0de81" :question/math-academy-id "q-8435" :question/problem "Find the solutions to the equation $2\\operatorname{sin}⁡x+2=0$ for $0\\le x<2\\pi .$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sin}⁡x:$\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x+2 & =0 \\\\ 2\\operatorname{sin}⁡x & =-2 \\\\ \\operatorname{sin}⁡x & =-1\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}\\end{aligned}\n$$\n\nNote that $x=-\\frac{\\pi }{2}$ is not in the domain $0\\le x<2\\pi .$ To get the first solution that's within the required domain, we need to find an angle that's coterminal with $-\\frac{\\pi }{2}.$ To do this, we simply add $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{1} & =-\\frac{\\pi }{2}+2\\pi =\\frac{3\\pi }{2}\\end{aligned}\n$$\n\n \n\nAs this is a quadrantal angle, to find the remaining solutions we use our knowledge of the sine function. We know that the sine function has its minimum values at:\n\n$$\nx=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nSince the domain $0\\le x<2\\pi $ is one period, and we have already found one minimum value in this period, we conclude that $x=\\frac{3\\pi }{2}$ is the only solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8435/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6fa751e-c9a4-5f02-b858-d841f0e6ce70"] :knowledge-point/questions ["q-8435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336379/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" :answer/id #uuid "bad0e88f-80b3-54da-9cba-48cd36e341d2" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-336379/field-1/0e4e79001619645600fe317a8a7dc3e7c54e40dedca3eec2190744766458f0b4" :answer/id #uuid "0aaefa1c-7b81-5b24-909d-d8be01abf5f6" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-336379/field-1" :answer-field/id #uuid "3b027324-1561-50d1-8084-19ff62b1720c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336379/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" :answer-field/choices ["q-336379/field-1/e7e505d325c3cadeeeaf26a0afda20aaa10bea508f9739931632d1057683cd77" "q-336379/field-1/0e4e79001619645600fe317a8a7dc3e7c54e40dedca3eec2190744766458f0b4"] :db/ensure [:answer-field/validate]} {:db/id "q-336379" :question/id #uuid "cc58faac-ba81-5140-b800-d51ae6619aa6" :question/math-academy-id "q-336379" :question/problem "Find the exact solution to the equation  $3\\operatorname{sin}⁡x-3=0$ for $-\\pi <x\\le \\pi .$ Give your answer in radians.\n\n$x=$\n{{field-1}}" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sin}⁡x:$\n\n$$\n\\begin{aligned}3\\operatorname{sin}⁡x-3 & =0 \\\\ 3\\operatorname{sin}⁡x & =3 \\\\ \\operatorname{sin}⁡x & =1\\end{aligned}\n$$\n\n \n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(1)=\\frac{\\pi }{2}\n$$\n\nSince $\\frac{\\pi }{2}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{2}.$ \n\nAs this is a quadrantal angle, to find the remaining solutions, we use our knowledge of the sine function. We know that the sine function has its maximum values at:\n\n$$\nx=\\frac{\\pi }{2}+2n\\pi \n$$\n\nSince the domain $-\\pi <x\\le \\pi $ is one period, and we have already found one maximum value in this period, we conclude that $x=\\frac{\\pi }{2}$ is the only solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336379/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6fa751e-c9a4-5f02-b858-d841f0e6ce70"] :knowledge-point/questions ["q-336379"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-8576"] :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sin}⁡x:$\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x+2 & =0 \\\\ 2\\operatorname{sin}⁡x & =-2 \\\\ \\operatorname{sin}⁡x & =-1\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSince $-\\frac{\\pi }{2}$ lies inside the required domain, our first solution is ${x}_{1}=-\\frac{\\pi }{2}.$ \n\nAs this is a quadrantal angle, to find the remaining solutions we use our knowledge of the sine function. We know that the sine function has its minimum values at:\n\n$$\nx=-\\frac{\\pi }{2}+2n\\pi \n$$\n\nSince the domain $-\\pi <x\\le \\pi $ is one period, and we have already found one minimum value in this period, we conclude that $x=-\\frac{\\pi }{2}$ is the only solution." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]}]
