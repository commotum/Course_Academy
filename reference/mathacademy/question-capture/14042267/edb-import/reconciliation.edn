\frac{1}{3x-2})\\text{d}x \\\\  & =\\frac{1}{3}[\\int \\text{d}x-\\int \\frac{1}{3x-2}\\,\\text{d}x] \\\\  & =\\frac{1}{3}[x-\\frac{1}{3}\\operatorname{ln}⁡|3x-2|]+C \\\\  & =\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042267/state.json" "file_sha256" "76d9a54e523855792e179a9597805116dd945a177b4ed6b03a30ef36d5996700"} {"question" "q-73391" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042267/activity-metadata.json" "file_sha256" "8d8e91c02ba20fbea134c908e328151703f7c74397295a2b0d8d666d753e26a5"} {"question" "q-73391" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042267/state.json" "file_sha256" "76d9a54e523855792e179a9597805116dd945a177b4ed6b03a30ef36d5996700"} {"question" "q-73391" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3x+9\\operatorname{ln}⁡|3x-2|+C"] ["math" "\\frac{x}{3}+\\frac{1}{3}\\operatorname{ln}⁡|3x-2|+C"] ["math" "\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C"] ["math" "x-9\\operatorname{ln}⁡|3x-2|+C"] ["math" "x-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042267/state.json" "file_sha256" "76d9a54e523855792e179a9597805116dd945a177b4ed6b03a30ef36d5996700"} {"question" "q-73391" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042267/state.json" "file_sha256" "76d9a54e523855