    {
      "question": "e-7663",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "f5ae67bfdc50c18f4bac5c9616b1bde5914d857660d1e473c48118065ca32e28",
      "new_sha256": "cce5f899155be1c9c68d3b31fb3eb6ffe6389f7569b74b62c55c9eb944b0511f",
      "category": "ma_capture",
