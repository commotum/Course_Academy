69c61af99e81a81c9de3b9df3eb"] :db/ensure [:answer-field/validate]} {:db/id "q-115460" :question/id #uuid "5d11be10-3811-5741-8980-d440f63a3049" :question/math-academy-id "q-115460" :question/problem "Solve the inequality ${x}^{2}\\cdot {3}^{7x+2}\\le 2x\\cdot {3}^{7x+3}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {3}^{7x+2} & \\le 2x\\cdot {3}^{7x+3} \\\\ {x}^{2}\\cdot {3}^{7x+2}-2x\\cdot {3}^{7x+3} & \\le 0 \\\\ ({x}^{2}-2x\\cdot 3)\\cdot {3}^{7x+2} & \\le 0 \\\\ ({x}^{2}-6x)\\cdot {3}^{7x+2} & \\le 0 \\\\ x(x-6)\\cdot {3}^{7x+2} & \\le 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${3}^{7x+2}$ and get\n\n$$\nx(x-6)\\le 0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=0$ and $x=6.$ The parabola is below the $x$-axis or touch this axis when $0\\le x\\le 6.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013930/assets/d75b387ac3e54f253eab62d9492b39f2744298e776f663d542b26e3c47f7d6a9.png)\n\nTherefore, the solution is $0\\le x\\le 6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338"] :knowledge-point/questions ["q-115460"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-87772"] :question/problem "Solve the inequality ${3}^{4x}{x}^{2}\\ge {3}^{4x+1}x.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{3}^{4x}{x}^{2} & \\ge {3}^{4x+1}x \\\\ {3}^{4x}{x}^{2}-{3}^{4x+1}x & \\ge 0 \\\\ {3}^{4x}({x}^{2}-3x) & \\ge 0 \\\\ {3}^{4x}x(x-3) & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${3}^{4x}$ and get\n\n$$\nx(x-3)\\ge 0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=0$ and $x=3.$ The parabola is at or above the $x$-axis when $x\\le 0$ or $x\\ge 3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013930/assets/3bfb82543e7c05d0ca0b8f6c6973025400ad1253acbc57214173dbd3e8c37fef.png)\n\nTherefore, the solution is  $x\\le 0$ or $x\\ge 3.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-115450/selection/8c995f65e20f528ab78f6acd1d84377bb7ca6597425ea4ad2cc0376e23de5c80" :answer/id #uuid "26210814-24e8-5605-9cf0-343709fd0678" :answer/type :answer.type/math :answer/value "-4\\le x\\le 4" :db/ensure [:answer/validate]} {:db/id "q-115450/selection/0ffcd15795e34096849b65562b63d39d444e2d6511f2bdba60b68039c64a76f9" :answer/id #uuid "f37478dc-c2a4-59f3-a681-6b20c6f03f09" :answer/type :answer.type/math :answer/value "x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-115450/selection/17eeb7333bbf2b64038014ee8de022c4e97edff66f74eb2fc4efb7230955a182" :answer/id #uuid "5bc406a4-745a-5081-97eb-37e89cb957db" :answer/type :answer.type/text :answer/value "$x\\le -4$ or $x\\ge 4$" :db/ensure [:answer/validate]} {:db/id "q-115450/selection/9b5d95a1f3b0c700970b6b090716b38764f26f4a127aaaebde2d354fd710e12d" :answer/id #uuid "f445bcb0-fdc2-5103-b1e9-d485ce6f2d6b" :answer/type :answer.type/math :answer/value "-2\\le x\\le 2" :db/ensure [:answer/validate]} {:db/id "q-115450/selection/b53bb0b24df3185c46f00d0fee587789db035759ea08279846091614b80a8c75" :answer/id #uuid "5956da79-4dd5-5a86-b4bf-9699724313a8" :answer/type :answer.type/math :answer/value "x\\le -2" :db/ensure [:answer/validate]} {:db/id "q-115450/selection" :answer-field/id #uuid "b192b996-3d51-521d-b86e-6d2523d95a67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115450/selection/17eeb7333bbf2b64038014ee8de022c4e97edff66f74eb2fc4efb7230955a182" :answer-field/choices ["q-115450/selection/8c995f65e20f528ab78f6acd1d84377bb7ca6597425ea4ad2cc0376e23de5c80" "q-115450/selection/0ffcd15795e34096849b65562b63d39d444e2d6511f2bdba60b68039c64a76f9" "q-115450/selection/17eeb7333bbf2b64038014ee8de022c4e97edff66f74eb2fc4efb7230955a182" "q-115450/selection/9b5d95a1f3b0c700970b6b090716b38764f26f4a127aaaebde2d354fd710e12d" "q-115450/selection/b53bb0b24df3185c46f00d0fee587789db035759ea08279846091614b80a8c75"] :db/ensure [:answer-field/validate]} {:db/id "q-115450" :question/id #uuid "5c9c6c77-82d3-5846-97fb-06c132d49ce6" :question/math-academy-id "q-115450" :question/problem "Solve the inequality ${x}^{2}\\cdot {2}^{2x-7}\\ge {2}^{2x-3}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {2}^{2x-7} & \\ge {2}^{2x-3} \\\\ {x}^{2}\\cdot {2}^{2x-7}-{2}^{2x-3} & \\ge 0 \\\\ ({x}^{2}-{2}^{4})\\cdot {2}^{2x-7} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${2}^{2x-7}$ and get\n\n$$\n{x}^{2}-{2}^{4}\\ge 0.\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{2}-{2}^{4} & \\ge 0 \\\\ {x}^{2} & \\ge 16 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{16} \\\\ |x| & \\ge 4\\end{aligned}\n$$\n\nTherefore, the solution to the inequality is $x\\le -4$ or $x\\ge 4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338"] :knowledge-point/questions ["q-115450"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7663"] :question/problem "Solve the inequality $\\dfrac{(x^2-8)^3}{11^x} \\geq 0.$" :question/worked-solution "When we have an inequality involving an exponential function with a positive base, we're allowed to multiply or divide both sides by the exponential function.\n\nMultiplying both sides of the given inequality by $11^x,$ we get\n\n$$\n\\begin{aligned}\\frac{({x}^{2}-8)^{3}}{{11}^{x}} & \\ge 0 \\\\ {11}^{x}\\cdot \\frac{({x}^{2}-8)^{3}}{{11}^{x}} & \\ge {11}^{x}\\cdot 0 \\\\ ({x}^{2}-8)^{3} & \\ge 0.\\end{aligned}\n$$\n\nNow, we can solve the inequality using familiar methods:\n\n$$\n\\begin{aligned}\\sqrt[3]{({x}^{2}-8)^{3}} & \\ge \\sqrt[3]{0} \\\\ {x}^{2}-8 & \\ge 0 \\\\ {x}^{2} & \\ge 8 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{8} \\\\ |x| & \\ge 2\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the solution to the inequality is $x \\leq -2\\sqrt 2$ or $x \\geq 2 \\sqrt 2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7664"] :question/problem "Solve the inequality $x^2e^{x+1}-2e^{x+1} < -xe^{x+1} .$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}{e}^{x+1}-2{e}^{x+1} & <-x{e}^{x+1} \\\\ {x}^{2}{e}^{x+1}+x{e}^{x+1}-2{e}^{x+1} & <0 \\\\ ({x}^{2}+x-2){e}^{x+1} & <0 \\\\ (x+2)(x-1){e}^{x+1} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by $e^{x+1}$ and get\n\n$$\n(x+2)(x-1) <   0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=-2$ and $x=1.$ The parabola is below the $x$-axis when $-2 <   x <   1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013930/assets/2f01104ae0cb9a41c5c5e4b8393e346f7d0e9b2bfd1afa593ee6bdfb0fff39f2.png)\n\nTherefore, the solution is $-2 <   x <   1.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7665"] :question/problem "Solve the inequality $x^5 \\cdot 4^{x} > 4^{x - 15}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{5}\\cdot {4}^{x} & >{4}^{x-15} \\\\ {x}^{5}\\cdot {4}^{x}-{4}^{x-15} & >0 \\\\ ({x}^{5}-{4}^{-15})\\cdot {4}^{x} & >0\\end{aligned}\n$$\n\nNow, we divide both sides by $4^{x}$ and get\n\n$$\nx^5 - 4^{-15} > 0.\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{5} & >{4}^{-15} \\\\ \\sqrt[5]{{x}^{5}} & >\\sqrt[5]{{4}^{-15}} \\\\ x & >{({4}^{-15})}^{1/5} \\\\ x & >{4}^{-3} \\\\ x & >\\frac{1}{64}\\end{aligned}\n$$\n\nTherefore, the solution to the inequality is $x > \\dfrac{1}{64}.$" :db/ensure [:question/validate]}]
