t 4} \\\\  & =\\frac{-5\\pm \\sqrt{10\\,201}}{8} \\\\  & =\\frac{-5\\pm 101}{8}\\end{aligned}\n$$\n\nHence, $N=12$ or $N=-\\frac{106}{8}.$ We disregard the negative solution since $N$ must be positive.\n\nTherefore, our series has $N=12$ terms." 13194139534922 true] [17592186320151 1000 #edb/ref 17592186320152 13194139534922 true] [17592186320151 1000 #edb/ref 17592186320153 13194139534922 true] [17592186320151 1000 #edb/ref 17592186320154 13194139534922 true] [17592186320151 1000 #edb/ref 17592186320155 13194139534922 true] [17592186320151 1000 #edb/ref 17592186320156 13194139534922 true] [17592186320151 1040 #edb/ref 17592186045450 13194139534922 true] [17592186320151 1041 "selection" 13194139534922 true] [17592186320151 1104 #edb/ref 17592186320152 13194139534922 true] [17592186320151 1110 #uuid "87291b6e-04b4-580a-9938-35597db2c6b1" 13194139534922 true] [17592186320152 1034 "12" 13194139534922 true] [17592186320152 1103 #edb/ref 17592186045453 13194139534922 true] [17592186320152 1111 #uuid "b4860165-c4b1-56c7-a519-137a7054b977" 13194139534922 true] [17592186320153 1034 "9" 13194139534922 true] [17592186320153 1103 #edb/ref 17592186045453 13194139534922 true] [17592186320153 1111 #uuid "4ff26050-e2e0-5358-b0e3-6afefed0168d" 13194139534922 true] [17592186320154 1034 "19" 13194139534922 true] [17592186320154 1103 #edb/ref 17592186045453 13194139534922 true] [17592186320154 1111 #uuid "9d991d0d-47e9-50e2-a9a9-d7bdb505ed81" 13194139534922 true] [17592186320155 1034 "14" 13194139534922 true] [17592186320155 1103 #edb/ref 17592186045453 13194139534922 true] [17592186320155 1111 #uuid "104ff121-4e5b-5bab-a530-6f1de8279731" 13194139534922 true] [17592186320156 1034 "18" 13194139534922 true] [17592186320156 1103 #edb/ref 17592186045453 13194139534922 true] [17592186320156 1111 #uuid "7cc8a881-02e8-5297-9838-e9a7e5bb46fe" 13194139534922 true] [17592186320157 1017 #edb/ref 17592186320158 13194139534922 true] [17592186320157 1089 "q-5490" 13194139534922 true] [1759218632015