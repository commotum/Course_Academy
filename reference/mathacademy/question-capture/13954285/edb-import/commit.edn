xt{d}}{\\text{d}x}(C) \\\\  & =-(-3)\\cdot (2x-3)^{-4}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x-3)+0 \\\\  & =3\\cdot (2x-3)^{-4}\\cdot 2 \\\\  & =\\frac{6}{(2x-3)^{4}}\\,✓\\end{aligned}\n$$" 13194139533933 true] [17592186266919 1000 #edb/ref 17592186266920 13194139533933 true] [17592186266919 1000 #edb/ref 17592186266921 13194139533933 true] [17592186266919 1000 #edb/ref 17592186266922 13194139533933 true] [17592186266919 1000 #edb/ref 17592186266923 13194139533933 true] [17592186266919 1000 #edb/ref 17592186266924 13194139533933 true] [17592186266919 1040 #edb/ref 17592186045450 13194139533933 true] [17592186266919 1041 "selection" 13194139533933 true] [17592186266919 1104 #edb/ref 17592186266922 13194139533933 true] [17592186266919 1110 #uuid "67b49cf0-1d85-5436-ab3f-6617d0b013f1" 13194139533933 true] [17592186266920 1034 "\\frac{2}{3(2x-3)^{3}}+C" 13194139533933 true] [17592186266920 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266920 1111 #uuid "a990e253-b3a4-5d59-b6e5-c06d24c3b06a" 13194139533933 true] [17592186266921 1034 "\\frac{1}{3(2x-3)^{3}}+C" 13194139533933 true] [17592186266921 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266921 1111 #uuid "cf405392-15e5-5454-af1a-280b01969c42" 13194139533933 true] [17592186266922 1034 "-\\frac{1}{(2x-3)^{3}}+C" 13194139533933 true] [17592186266922 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266922 1111 #uuid "9b109a4d-c456-5841-b777-442d36055c46" 13194139533933 true] [17592186266923 1034 "-\\frac{3}{(2x-3)^{3}}+C" 13194139533933 true] [17592186266923 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266923 1111 #uuid "9d396a8c-0a15-5ddb-af03-bb2c4cead9ff" 13194139533933 true] [17592186266924 1034 "-\\frac{6}{(2x-3)^{3}}+C" 13194139533933 true] [17592186266924 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266924 1111 #uuid "89ad5c01-b932-56ae-8068-44b86976256a" 13194139533933 true] [17592186266925 1017 #edb/ref 17592186266926 13194139533933 true] [175921862