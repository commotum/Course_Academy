{2}}+C] & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[\\sqrt[5]{{(s+1)}^{2}}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[{(s+1)}^{2/5}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{5}{(s+1)}^{-3/5}\\cdot \\frac{\\text{d}}{\\text{d}s}(s+1)+0 \\\\  & ={(s+1)}^{-3/5}\\cdot 1 \\\\  & =\\frac{1}{\\sqrt[5]{{(s+1)}^{3}}}\\,✓\\end{aligned}\n$$" 13194139533933 true] [17592186266940 1000 #edb/ref 17592186266941 13194139533933 true] [17592186266940 1000 #edb/ref 17592186266942 13194139533933 true] [17592186266940 1000 #edb/ref 17592186266943 13194139533933 true] [17592186266940 1000 #edb/ref 17592186266944 13194139533933 true] [17592186266940 1000 #edb/ref 17592186266945 13194139533933 true] [17592186266940 1040 #edb/ref 17592186045450 13194139533933 true] [17592186266940 1041 "selection" 13194139533933 true] [17592186266940 1104 #edb/ref 17592186266945 13194139533933 true] [17592186266940 1110 #uuid "30357bab-78f2-55e1-8f33-6fcf7e0bb188" 13194139533933 true] [17592186266941 1034 "5\\sqrt[5]{{(s+1)}^{3}}+C" 13194139533933 true] [17592186266941 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266941 1111 #uuid "ff0f7e33-76e7-5e56-978c-f942b65e6a38" 13194139533933 true] [17592186266942 1034 "2\\sqrt[5]{{(s+1)}^{2}}+C" 13194139533933 true] [17592186266942 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266942 1111 #uuid "8f1775d3-358d-5b89-b0d3-396a700f8e42" 13194139533933 true] [17592186266943 1034 "\\sqrt[5]{{(s+1)}^{2}}+C" 13194139533933 true] [17592186266943 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266943 1111 #uuid "8df04daa-221c-5ae1-b949-9dbef49ab348" 13194139533933 true] [17592186266944 1034 "\\frac{1}{2}\\sqrt[5]{{(s+1)}^{3}}+C" 13194139533933 true] [17592186266944 1103 #edb/ref 17592186045453 13194139533933 true] [17592186266944 1111 #uuid "5d83df84-2574-5210-a7f2-2bda41daf14b" 13194139533933 true] [17592186266945 1034 "\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}