+\\frac{1}{3\\sqrt[3]{{x}^{2}}})} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003623/state.json" "file_sha256" "dcc2cc3c0ee7093295e140b6bc889389949e58d35c28142edc07667c67fb0e18"} {"question" "q-314246" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003623/activity-metadata.json" "file_sha256" "285dfc88d1b41ab74575d2f461b238022ea779501eee859121d3b18f9acb4002"} {"question" "q-314246" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003623/state.json" "file_sha256" "dcc2cc3c0ee7093295e140b6bc889389949e58d35c28142edc07667c67fb0e18"} {"question" "q-314246" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003623/state.json" "file_sha256" "dcc2cc3c0ee7093295e140b6bc889389949e58d35c28142edc07667c67fb0e18"}] "usage" {} "basis" 1089 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
