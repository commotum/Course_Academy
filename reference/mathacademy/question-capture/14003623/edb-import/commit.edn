02 true] [17592186286503 1000 #edb/ref 17592186286506 13194139534402 true] [17592186286503 1000 #edb/ref 17592186286507 13194139534402 true] [17592186286503 1000 #edb/ref 17592186286508 13194139534402 true] [17592186286503 1040 #edb/ref 17592186045450 13194139534402 true] [17592186286503 1041 "selection" 13194139534402 true] [17592186286503 1104 #edb/ref 17592186286505 13194139534402 true] [17592186286503 1110 #uuid "88dad7ce-ab8f-53b2-ae30-acd9f22d68bf" 13194139534402 true] [17592186286504 1034 "-\\frac{1}{2}" 13194139534402 true] [17592186286504 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286504 1111 #uuid "ffd25587-a492-5f8f-84f4-e747217aa1ad" 13194139534402 true] [17592186286505 1034 "\\frac{1}{2}" 13194139534402 true] [17592186286505 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286505 1111 #uuid "749265ec-a632-578c-ba48-869c9af399ed" 13194139534402 true] [17592186286506 1034 "2" 13194139534402 true] [17592186286506 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286506 1111 #uuid "a650c7fe-4f48-528b-8b34-de554a108c90" 13194139534402 true] [17592186286507 1034 "1" 13194139534402 true] [17592186286507 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286507 1111 #uuid "3b14a418-103a-5fb6-8f04-63ddc02daabf" 13194139534402 true] [17592186286508 1034 "-1" 13194139534402 true] [17592186286508 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286508 1111 #uuid "ff4783dc-8d72-5371-819c-07486a86cbe3" 13194139534402 true] [17592186286509 1017 #edb/ref 17592186286510 13194139534402 true] [17592186286509 1089 "q-114249" 13194139534402 true] [17592186286509 1091 #edb/ref 17592186045465 13194139534402 true] [17592186286509 1100 "${lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1}=$" 13194139534402 true] [17592186286509 1113 #uuid "0d78ff30-662b-5fb9-981a-44d909d0721b" 13194139534402 true] [17592186286509 1145 "If we plug in $x=-1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1} & ={lim}_{x\\to -1}\\frac{{[(x+2)\\operatorname{ln}⁡(x+2)-x-1]}^{′}}{{[{x}^{2}+2x+1]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{\\operatorname{ln}⁡(x+2)}{2x+2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1} & ={lim}_{x\\to -1}\\frac{\\operatorname{ln}⁡(x+2)}{2x+2} \\\\  & ={lim}_{x\\to -1}\\frac{{[\\operatorname{ln}⁡(x+2)]}^{′}}{{[2x+2]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\frac{1}{x+2})}{2} \\\\  & ={lim}_{x\\to -1}\\frac{1}{2(x+2)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139534402 true] [17592186286510 1000 #edb/ref 17592186286511 13194139534402 true] [17592186286510 1000 #edb/ref 17592186286512 13194139534402 true] [17592186286510 1000 #edb/ref 17592186286513 13194139534402 true] [17592186286510 1000 #edb/ref 17592186286514 13194139534402 true] [17592186286510 1000 #edb/ref 17592186286515 13194139534402 true] [17592186286510 1040 #edb/ref 17592186045450 13194139534402 true] [17592186286510 1041 "selection" 13194139534402 true] [17592186286510 1104 #edb/ref 17592186286511 13194139534402 true] [17592186286510 1110 #uuid "a0a90530-42e9-5508-bcaa-14eff4ccaf5e" 13194139534402 true] [17592186286511 1034 "\\frac{1}{2}" 13194139534402 true] [17592186286511 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286511 1111 #uuid "38f236ca-0647-5109-83ea-2610f579e1bc" 13194139534402 true] [17592186286512 1034 "2" 13194139534402 true] [17592186286512 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286512 1111 #uuid "8b716572-c2cd-567a-8b2b-5d311f0d6a95" 13194139534402 true] [17592186286513 1034 "\\frac{1}{4}" 13194139534402 true] [17592186286513 1103 #edb/ref 17592186045453 13194139534402 true] [17592186286513 1111 #uuid "