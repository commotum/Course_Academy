ned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 \\\\ -4 & -2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-279670/field-1" "q-279670/field-2" "q-279670/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b16f563c-f4be-5883-8734-cbce48de4757"] :knowledge-point/questions ["q-279670"] :db/ensure [:knowledge-point/validate]}]
