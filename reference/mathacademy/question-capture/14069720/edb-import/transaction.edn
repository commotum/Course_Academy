[{:db/id "q-162704/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9a4bd536-d326-53d0-9181-522c07f2b574" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-162704/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "80308505-0f1a-56cd-8727-88e965369287" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-162704/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "841563b4-165e-57ac-9a8b-9d0ee8306d98" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-162704/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2c4340e3-fc0a-5135-8dec-a46aceb62099" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-162704/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "f304d195-06ee-5d6e-97f0-7739f5b8c88f" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-162704/selection" :answer-field/id #uuid "d62a7d35-83ac-5287-ad1d-c3e96a7620ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162704/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-162704/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-162704/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-162704/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-162704/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-162704/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-162704" :question/id #uuid "cb5d95dd-5881-5c3d-8a8b-dca50f145528" :question/math-academy-id "q-162704" :question/problem "The matrix\n\n$$\n[\\begin{aligned}a & 0 \\\\ 0 & b\\end{aligned}]\n$$\n\nrepresents the linear transformation that acts on a vector in ${R}^{2}$ as follows (in the order given):\n\n- It rotates the vector  $\\pi $ radians counterclockwise about the origin, then\n\n- stretches the result by a scale factor of $3$ parallel to the $x$-axis, and finally\n\n- reflects the result about the $x$-axis.\n\nWhat is the value of $a+b?$" :question/worked-solution "Let $P$ be the matrix that represents the rotation, $Q$ be the matrix that represents the stretching, and $R$ be the matrix that represents the reflection. These are given by the following elementary transformation matrices:\n\n$$\nP=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}],\\,Q=[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]\n$$\n\nHence, the combined transformation can be represented by the matrix $RQP:$\n\n$$\n\\begin{aligned}RQP & =[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,\n$a+b=(-3)+1=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-162704/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b16f563c-f4be-5883-8734-cbce48de4757"] :knowledge-point/questions ["q-162704"] :db/ensure [:knowledge-point/validate]} {:db/id "q-277771/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "be1badf8-3fbf-5ee5-85ad-d8ff5956f007" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-277771/field-1" :answer-field/id #uuid "80563b80-9368-5338-89e1-a06abd4e7ef7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277771/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-277771/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-277771/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "52914dd9-cf14-5d85-adf1-a8cead627b31" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-277771/field-2" :answer-field/id #uuid "b4f0d281-0b3f-54ce-943c-89e6602ddeab" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277771/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-277771/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-277771/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "6b28b982-38a2-5a2f-be9d-fea3708dff8b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-277771/field-3" :answer-field/id #uuid "430738f2-eeca-5c0f-9002-518e4b4ca9ce" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277771/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-277771/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-277771" :question/id #uuid "725826a3-b9b8-5074-aec1-af2ef68874e8" :question/math-academy-id "q-277771" :question/problem "Construct the matrix $T$ of the linear transformation $T$ that acts on a vector in ${R}^{2}$ as follows (in the order given):\n\n- It rotates the vector by $\\frac{\\pi }{2}$ radians **clockwise** about the origin, then\n\n- stretches the result by a scale factor of $5$ parallel to the $x$-axis, and finally\n\n- shears the result with a shear factor of $3$ parallel to the $x$-axis.\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $T=\\,\\,$ |  |  |  |  |\n|  |  | {{field-3}} | $0$ |  |" :question/worked-solution "Let $P$ be the matrix that represents the rotation, $Q$ be the matrix that represents the stretching, and $R$ be the matrix that represents the shearing. These are given by the following elementary transformation matrices:\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,Q=[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}]\\,\\,\n$$\n\nHence, the combined transformation can be represented by the matrix $RQP:$\n\n$$\n\\begin{aligned}T & =RQP \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 5 \\\\ -1 & 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-277771/field-1" "q-277771/field-2" "q-277771/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b16f563c-f4be-5883-8734-cbce48de4757"] :knowledge-point/questions ["q-277771"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279666/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "0ac080d3-de17-5a8d-a785-0a50b8e116b8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-279666/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "60c234e5-2325-5c82-bbec-953a48c36cb7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-279666/field-1" :answer-field/id #uuid "03e8bd06-633c-5f4e-8ba2-b45527bcab27" :answer-field/key 