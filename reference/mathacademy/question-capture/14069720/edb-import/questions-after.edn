ligned}][\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 \\\\ -4 & -2\\end{aligned}]\\end{aligned}\n$$"}]}
