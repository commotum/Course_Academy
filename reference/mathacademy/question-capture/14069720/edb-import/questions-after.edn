#{[{:db/id #edb/ref 17592186362823 :knowledge-point/_questions [{:knowledge-point/id #uuid "b16f563c-f4be-5883-8734-cbce48de4757" :knowledge-point/title "Finding a Matrix That Represents a Combination of Three Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a4bd536-d326-53d0-9181-522c07f2b574" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186362825} {:answer/id #uuid "841563b4-165e-57ac-9a8b-9d0ee8306d98" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362826} {:answer/id #uuid "f304d195-06ee-5d6e-97f0-7739f5b8c88f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186362827} {:answer/id #uuid "2c4340e3-fc0a-5135-8dec-a46aceb62099" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186362828} {:answer/id #uuid "80308505-0f1a-56cd-8727-88e965369287" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186362829}] :answer-field/correct {:answer/id #uuid "80308505-0f1a-56cd-8727-88e965369287" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186362829} :answer-field/id #uuid "d62a7d35-83ac-5287-ad1d-c3e96a7620ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362824}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cb5d95dd-5881-5c3d-8a8b-dca50f145528" :question/math-academy-id "q-162704" :question/problem "The matrix\n\n$$\n[\\begin{aligned}a & 0 \\\\ 0 & b\\end{aligned}]\n$$\n\nrepresents the linear transformation that acts on a vector in ${R}^{2}$ as follows (in the order given):\n\n- It rotates the vector  $\\pi $ radians counterclockwise about the origin, then\n\n- stretches the result by a scale factor of $3$ parallel to the $x$-axis, and finally\n\n- reflects the result about the $x$-axis.\n\nWhat is the value of $a+b?$" :question/worked-solution "Let $P$ be the matrix that represents the rotation, $Q$ be the matrix that represents the stretching, and $R$ be the matrix that represents the reflection. These are given by the following elementary transformation matrices:\n\n$$\nP=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}],\\,Q=[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]\n$$\n\nHence, the combined transformation can be represented by the matrix $RQP:$\n\n$$\n\\begin{aligned}RQP & =[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore,\n$a+b=(-3)+1=-2.$"}] [{:db/id #edb/ref 17592186362830 :knowledge-point/_questions [{:knowledge-point/id #uuid "b16f563c-f4be-5883-8734-cbce48de4757" :knowledge-point/title "Finding a Matrix That Represents a Combination of Three Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1badf8-3fbf-5ee5-85ad-d8ff5956f007" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186362832}] :answer-field/correct {:answer/id #uuid "be1badf8-3fbf-5ee5-85ad-d8ff5956f007" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186362832} :answer-field/id #uuid "80563b80-9368-5338-89e1-a06abd4e7ef7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362831} {:answer-field/choices [{:answer/id #uuid "52914dd9-cf14-5d85-adf1-a8cead627b31" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186362834}] :answer-field/correct {:answer/id #uuid "52914dd9-cf14-5d85-adf1-a8cead627b31" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186362834} :answer-field/id #uuid "b4f0d281-0b3f-54ce-943c-89e6602ddeab" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362833} {:answer-field/choices [{:answer/id #uuid "6b28b982-38a2-5a2f-be9d-fea3708dff8b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186362836}] :answer-field/correct {:answer/id #uuid "6b28b982-38a2-5a2f-be9d-fea3708dff8b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186362836} :answer-field/id #uuid "430738f2-eeca-5c0f-9002-518e4b4ca9ce" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362835}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "725826a3-b9b8-5074-aec1-af2ef68874e8" :question/math-academy-id "q-277771" :question/problem "Construct the matrix $T$ of the linear transformation $T$ that acts on a vector in ${R}^{2}$ as follows (in the order given):\n\n- It rotates the vector by $\\frac{\\pi }{2}$ radians **clockwise** about the origin, then\n\n- stretches the result by a scale factor of $5$ parallel to the $x$-axis, and finally\n\n- shears the result with a shear factor of $3$ parallel to the $x$-axis.\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $T=\\,\\,$ |  |  |  |  |\n|  |  | {{field-3}} | $0$ |  |" :question/worked-solution "Let $P$ be the matrix that represents the rotation, $Q$ be the matrix that represents the stretching, and $R$ be the matrix that represents the shearing. These are given by the following elementary transformation matrices:\n\n$$\nP=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,Q=[\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}]\\,\\,\n$$\n\nHence, the combined transformation can be represented by the matrix $RQP:$\n\n$$\n\\begin{aligned}T & =RQP \\\\  & =[\\begin{aligned}1 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 5 \\\\ -1 & 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362837 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad47b548-a298-5cc9-8f69-70fee292db5d" :knowledge-point/title "Finding a Matrix That Represents a Combination of Two Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac080d3-de17-5a8d-a785-0a50b8e116b8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362839} {:answer/id #uuid "60c234e5-2325-5c82-bbec-953a48c36cb7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362840}] :answer-field/correct {:answer/id #uuid "0ac080d3-de17-5a8d-a785-0a50b8e116b8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362839} :answer-field/id #uuid "03e8bd06-633c-5f4e-8ba2-b45527bcab27" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362838} {:answer-field/choices [{:answer/id #uuid "d954e761-b3c8-521a-9dc8-c92eabd2e956" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362842}] :answer-field/correct {:answer/id #uuid "d954e761-b3c8-521a-9dc8-c92eabd2e956" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362842} :answer-field/id #uuid "d673f239-4c7f-51f1-9f3e-3fed0c6ce289" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362841} {:answer-field/choices [{:answer/id #uuid "635ccefa-1b47-58d6-9490-a5de355843ce" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362844}] :answer-field/correct {:answer/id #uuid "635ccefa-1b47-58d6-9490-a5de355843ce" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186362844} :answer-field/id #uuid "43259d9e-d045-5df5-98aa-723004048478" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362843}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aca90990-89cd-5b44-83e4-0e70b92b2ff2" :question/math-academy-id "q-279666" :question/problem "Construct the matrix $T$ of the linear transformation $T$ that acts on a vector in ${R}^{2}$ as follows (in the order given):\n\n- it shears the vector by a shear factor of $\\frac{1}{3}$ parallel to the $x$-axis, and then\n\n- scales the result by a scale factor of $3$ with center of enlargement at the origin.\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $T=\\,\\,$ |  |  |  |  |\n|  |  | $0$ | {{field-3}} |  |" :question/worked-solution "Let $P$ be the matrix that represents the shear, and let $Q$ be the matrix that represents the scaling. These are given by the following elementary transformation matrices:\n\n$$\n\\begin{aligned}P & =[\\begin{aligned}1 & \\frac{1}{3} \\\\ 0 & 1\\end{aligned}] \\\\ Q & =[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the combined transformation can be represented by the matrix $QP:$\n\n$$\n\\begin{aligned}T & =QP \\\\  & =[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}1 & \\frac{1}{3} \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 1 \\\\ 0 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186362845 :knowledge-point/_questions [{:knowledge-point/id #uuid "ad47b548-a298-5cc9-8f69-70fee292db5d" :knowledge-point/title "Finding a Matrix That Represents a Combination of Two Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0c32ff7-3fa