15 true] [17592186283432 1110 #uuid "73d98ef6-8da1-5c53-b2ec-615955e2939f" 13194139534315 true] [17592186283433 1034 "II and III only" 13194139534315 true] [17592186283433 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283433 1111 #uuid "fea5b8c6-a5f8-500c-8d30-16eca2e9eb27" 13194139534315 true] [17592186283434 1034 "I only" 13194139534315 true] [17592186283434 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283434 1111 #uuid "264b9de0-a856-5d1f-95ee-c7b1da5211a7" 13194139534315 true] [17592186283435 1034 "III only" 13194139534315 true] [17592186283435 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283435 1111 #uuid "ec00a9aa-8e7f-5810-92ef-3fcce823f6f5" 13194139534315 true] [17592186283436 1034 "I and II only" 13194139534315 true] [17592186283436 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283436 1111 #uuid "5c25e334-8057-50c8-8011-2f53b901cdac" 13194139534315 true] [17592186283437 1034 "II only" 13194139534315 true] [17592186283437 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283437 1111 #uuid "a73ded5d-8e8e-5108-82f0-126c6d521d75" 13194139534315 true] [17592186283438 1017 #edb/ref 17592186283439 13194139534315 true] [17592186283438 1089 "q-120485" 13194139534315 true] [17592186283438 1091 #edb/ref 17592186045464 13194139534315 true] [17592186283438 1100 "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\n- $\\operatorname{sec}⁡x=7$ $$\n- $\\sqrt{3}\\operatorname{sec}⁡x+2=2\\sqrt{3}\\operatorname{sec}⁡x$ $$\n- $7\\operatorname{sec}⁡x=-5$" 13194139534315 true] [17592186283438 1113 #uuid "a9e6cde4-30d8-5716-a4a4-97a88908653f" 13194139534315 true] [17592186283438 1145 "We first simplify the given equations, and get\n\n- $\\operatorname{sec}⁡x=7$ $$\n- $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$\n- $\\operatorname{sec}⁡x=-\\frac{5}{7}$\n\nNow, recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions." 13194139534315 true] [17592186283439 1000 #edb/ref 17592186283440 13194139534315 true] [17592186283439 1000 #edb/ref 17592186283441 13194139534315 true] [17592186283439 1000 #edb/ref 17592186283442 13194139534315 true] [17592186283439 1000 #edb/ref 17592186283443 13194139534315 true] [17592186283439 1000 #edb/ref 17592186283444 13194139534315 true] [17592186283439 1040 #edb/ref 17592186045450 13194139534315 true] [17592186283439 1041 "selection" 13194139534315 true] [17592186283439 1104 #edb/ref 17592186283442 13194139534315 true] [17592186283439 1110 #uuid "bd54b657-6ba7-5e6e-926a-1c13f9b55764" 13194139534315 true] [17592186283440 1034 "II and III only" 13194139534315 true] [17592186283440 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283440 1111 #uuid "9595ccf2-bd46-546f-b931-e9492dec12b9" 13194139534315 true] [17592186283441 1034 "I only" 13194139534315 true] [17592186283441 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283441 1111 #uuid "bb0dd378-e426-5ece-88c6-835931a99b79" 13194139534315 true] [17592186283442 1034 "III only" 13194139534315 true] [17592186283442 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283442 1111 #uuid "a3a01b8d-11af-530b-aff1-e486d1ce535d" 13194139534315 true] [17592186283443 1034 "I and II only" 13194139534315 true] [17592186283443 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283443 1111 #uuid "440db562-7037-5d4d-859e-86ac94f945d0" 13194139534315 true] [17592186283444 1034 "II only" 13194139534315 true] [17592186283444 1103 #edb/ref 17592186045454 13194139534315 true] [17592186283444 1111 #uuid "2fb7d5ce-6c38-568b-8741-bc109e3512d6" 13194139534315 true] [17592186283445 1017 #edb/ref 17592186283446 13194139534315 true] [17592186283445 1017 #edb/ref 17592186283448 13194139534315 true] [17592186283445 1089 "q-274858" 13194139534315 true] [17592186283445 1091 #edb/ref 17592186045464 13194139534315 true] [17592186283445 1100 "Find, **in ascending order and rounded to one decimal place**, the two solutions to the equation $2\\operatorname{sec}⁡x-3\\sqrt{2}=\\sqrt{2}$ for $0\\le x<2\\pi .$\n\n**In ascending order,** the solutions are $x=$\n{{field-1}}\nand $x=$ \n{{field-2}}." 13194139534315 true] [17592186283445 1113 #uuid "1d8b5708-f9a1-52b7-84fb-a31b5489b79a" 13194139534315 true] [17592186283445 1145 "First, we rearrange the equation and isolate $\\operatorname{sec}⁡x$:\n\n$$\n\\begin{aligned}2\\operatorname{sec}⁡x-3\\sqrt{2} & =\\sqrt{2} \\\\ 2\\operatorname{sec}⁡x & =\\sqrt{2}+3\\sqrt{2} \\\\ 2\\operatorname{sec}⁡x & =4\\sqrt{2} \\\\ \\operatorname{sec}⁡x & =2\\sqrt{2}\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2\\sqrt{2}}.\n$$\n\nThen, we find the principal value of $x,$ rounded to three decimal places:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{1}{2\\sqrt{2}})≈1.209\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}≈1.209.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the $4$th quadrant, and it also has a reference angle ${\\theta }_{R}≈1.209.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989949/assets/2c58ae6d53b409e4fac7c4fb5c4d96b08585b1c2ee8a4f1048f4461026d748af.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & ≈2\\pi -1.209 \\\\  & ≈5.074\\end{aligned}\n$$\n\nTherefore, in ascending order and rounded to one decimal place, the solutions are $x=1.2$ and $x=5.1.$" 13194139534315 true] [17592186283446 1000 #edb/ref 17592186283447 13194139534315 true] [17592186283446 1040 #edb/ref 17592186045449 13194139534315 true] [17592186283446 1041 "field-1" 13194139534315 true] [17592186283446 1104 #edb/ref 17592186283447 13194139534315 true] [17592186283446 1110 #uuid "8bafc52d-86ad-5924-a360-b01de3288548" 13194139534315 true] [17592186283447 1034 "1.2" 13194139534315 true] [17592186283447 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283447 1111 #uuid "e63c770d-eec4-542d-b8bf-70bf303fea49" 13194139534315 true] [17592186283448 1000 #edb/ref 17592186283449 13194139534315 true] [17592186283448 1040 #edb/ref 17592186045449 13194139534315 true] [17592186283448 1041 "field-2" 13194139534315 true] [17592186283448 1104 #edb/ref 17592186283449 13194139534315 true] [17592186283448 1110 #uuid "ab84f765-dc94-59d1-b280-363f8f0521ae" 13194139534315 true] [17592186283449 1034 "5.1" 13194139534315 true] [17592186283449 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283449 1111 #uuid "8875305e-078e-552b-a05d-aea138e7c7bc" 13194139534315 true] [17592186283450 1017 #edb/ref 17592186283451 13194139534315 true] [17592186283450 1017 #edb/ref 17592186283453 13194139534315 true] [17592186283450 1089 "q-325107" 13194139534315 true] [17592186283450 1091 #edb/ref 17592186045463 13194139534315 true] [17592186283450 1100 "Find the **exact** solutions to the equation $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$ for $-2\\pi <x<0.$\n\n**In ascending order,** the solutions are $x=$\n{{field-1}}\nand $x=$\n{{field-2}}." 13194139534315 true] [17592186283450 1113 #uuid "ebd67a4b-f6d9-505f-a725-3907b72f6b02" 13194139534315 true] [17592186283450 1145 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=arccos\\,(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6}\n$$\n\nNote that $x=\\frac{\\pi }{6}$ is not in the domain $-2\\pi <x<0.$ To get a solution within the required domain, we subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{\\pi }{6}-2\\pi =-\\frac{11\\pi }{6}\\end{aligned}\n$$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989949/assets/17803dc8d1d3ca2e31586969797b401d5d0a2d958bd6628387b512974076df7a.png)\n\nA second solution $X$ lies in the fourth quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{11\\pi }{6}\\end{aligned}\n$$\n\nNote that $X=\\frac{11\\pi }{6}$ is not in the domain $-2\\pi <x<0.$ To get a solution within the required domain, we subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{11\\pi }{6}-2\\pi =-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\frac{11\\pi }{6}$ and $x=-\\frac{\\pi }{6}.$" 13194139534315 true] [17592186283451 1000 #edb/ref 17592186283452 13194139534315 true] [17592186283451 1040 #edb/ref 17592186045449 13194139534315 true] [17592186283451 1041 "field-1" 13194139534315 true] [17592186283451 1104 #edb/ref 17592186283452 13194139534315 true] [17592186283451 1110 #uuid "7b3d7ade-b9c3-5446-819c-480371181f33" 13194139534315 true] [17592186283452 1034 "-\\frac{11\\pi}{6}" 13194139534315 true] [17592186283452 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283452 1111 #uuid "33429208-3bc3-5ef0-a178-d1e0245532bf" 13194139534315 true] [17592186283453 1000 #edb/ref 17592186283454 13194139534315 true] [17592186283453 1040 #edb/ref 17592186045449 13194139534315 true] [17592186283453 1041 "field-2" 13194139534315 true] [17592186283453 1104 #edb/ref 17592186283454 13194139534315 true] [17592186283453 1110 #uuid "bc5599ac-f9d9-5c53-a2d7-4a83f2ab2bb8" 13194139534315 true] [17592186283454 1034 "-\\frac{\\pi}{6}" 13194139534315 true] [17592186283454 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283454 1111 #uuid "424e8bb0-0093-57b7-805e-e45886645e19" 13194139534315 true] [17592186283455 1017 #edb/ref 17592186283456 13194139534315 true] [17592186283455 1089 "q-76493" 13194139534315 true] [17592186283455 1091 #edb/ref 17592186045465 13194139534315 true] [17592186283455 1100 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=-\\frac{7}{2}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" 13194139534315 true] [17592186283455 1113 #uuid "21067b43-552c-57fe-bdc4-8f094139d29a" 13194139534315 true] [17592186283455 1145 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=-\\frac{2}{7}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{2}{7})=106.601\\,549{…}^{∘}≈{106.602}^{∘}.\\end{aligned}\n$$\n\nSince ${106.602}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={106.602}^{∘}.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}={73.398}^{∘}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={73.398}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989949/assets/e378560486eca17f870b21743718c9f984f2bd3bf5609601f1cea674e15018e6.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{73.398}^{∘} \\\\  & ={253.398}^{∘}\\end{aligned}\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=106.602\\cdot 253.398≈27\\,013,\n$$\n\nrounded to the nearest integer." 13194139534315 true] [17592186283456 1000 #edb/ref 17592186283457 13194139534315 true] [17592186283456 1000 #edb/ref 17592186283458 13194139534315 true] [17592186283456 1000 #edb/ref 17592186283459 13194139534315 true] [17592186283456 1000 #edb/ref 17592186283460 13194139534315 true] [17592186283456 1000 #edb/ref 17592186283461 13194139534315 true] [17592186283456 1040 #edb/ref 17592186045450 13194139534315 true] [17592186283456 1041 "selection" 13194139534315 true] [17592186283456 1104 #edb/ref 17592186283457 13194139534315 true] [17592186283456 1110 #uuid "ea957e06-e2e6-59af-8dd6-d30a4ff6cca1" 13194139534315 true] [17592186283457 1034 "27\\,013" 13194139534315 true] [17592186283457 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283457 1111 #uuid "f30b2415-c7f3-5638-aebb-394e6faf2d56" 13194139534315 true] [17592186283458 1034 "31\\,805" 13194139534315 true] [17592186283458 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283458 1111 #uuid "71848f58-8d83-59d3-9dfa-6b0428f8963c" 13194139534315 true] [17592186283459 1034 "12\\,156" 13194139534315 true] [17592186283459 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283459 1111 #uuid "325b8fb5-5ea6-51e1-b06e-42eb7bbc1b37" 13194139534315 true] [17592186283460 1034 "21\\,642" 13194139534315 true] [17592186283460 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283460 1111 #uuid "aae87b4f-4922-5fa5-8bf2-22671510849a" 13194139534315 true] [17592186283461 1034 "15\\,681" 13194139534315 true] [17592186283461 1103 #edb/ref 17592186045453 13194139534315 true] [17592186283461 1111 #uuid "1db1b7d6-83e2-5e8d-ac07-73b64857230d" 13194139534315 true]] :edb/tempids {"q-120478" 17592186283431 "q-120478/selection" 17592186283432 "q-120478/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" 17592186283433 "q-120478/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" 17592186283434 "q-120478/selection/6a87b4860f595a380edef797b2cc43b24d4896f