[{:db/id "q-11767/selection/4a0b7ae3b9cd2f9cf9bfb9b6df84cfe39f2b0e766248834edb1822e30d2a3514" :answer/id #uuid "f6c6b385-6262-53cd-b0cd-1339614594ce" :answer/type :answer.type/math :answer/value "{y}^{2}=9x" :db/ensure [:answer/validate]} {:db/id "q-11767/selection/bc159fa037ddd299186fbb2d8f6c509131b7677bdd73e951522e3373f16a83a9" :answer/id #uuid "e0afeb06-eb2c-55c1-a731-fbf163e39787" :answer/type :answer.type/math :answer/value "{y}^{2}=6x" :db/ensure [:answer/validate]} {:db/id "q-11767/selection/f7e2b4506bb6c8f1b5f22b9d8f12146b7c8411c18c9e10eb470616ac3abd122b" :answer/id #uuid "915837fd-2465-5bc4-ae59-dc897eb18047" :answer/type :answer.type/math :answer/value "{y}^{2}=-6x" :db/ensure [:answer/validate]} {:db/id "q-11767/selection/5464b6528434685d90a63424ddd11c4edd590ea7e9ed4845e0656c30ab8dba3b" :answer/id #uuid "162da332-aa1f-514d-911d-329c1bec9a4f" :answer/type :answer.type/math :answer/value "{y}^{2}=-3x" :db/ensure [:answer/validate]} {:db/id "q-11767/selection/fb36af8489e2410bf71426275e6327dc6a5e60ff014bcae0672b2a6d3a369bf1" :answer/id #uuid "2df3aa65-f295-50e6-9f8e-9bf258a81fbe" :answer/type :answer.type/math :answer/value "{y}^{2}=-9x" :db/ensure [:answer/validate]} {:db/id "q-11767/selection" :answer-field/id #uuid "2df90e78-eaad-52d7-8f65-be2a782aab58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11767/selection/fb36af8489e2410bf71426275e6327dc6a5e60ff014bcae0672b2a6d3a369bf1" :answer-field/choices ["q-11767/selection/4a0b7ae3b9cd2f9cf9bfb9b6df84cfe39f2b0e766248834edb1822e30d2a3514" "q-11767/selection/bc159fa037ddd299186fbb2d8f6c509131b7677bdd73e951522e3373f16a83a9" "q-11767/selection/f7e2b4506bb6c8f1b5f22b9d8f12146b7c8411c18c9e10eb470616ac3abd122b" "q-11767/selection/5464b6528434685d90a63424ddd11c4edd590ea7e9ed4845e0656c30ab8dba3b" "q-11767/selection/fb36af8489e2410bf71426275e6327dc6a5e60ff014bcae0672b2a6d3a369bf1"] :db/ensure [:answer-field/validate]} {:db/id "q-11767" :question/id #uuid "4efb81e2-31d7-5984-8b91-b81d7384111a" :question/math-academy-id "q-11767" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-4,-6).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-4,-6),$ we can substitute $x=-4$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-6)^{2} & =4p(-4) \\\\ 36 & =-16p \\\\ p & =-\\frac{9}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{9}{4})x \\\\ {y}^{2} & =-9x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11767/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3"] :knowledge-point/questions ["q-11767"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11772/selection/5464b6528434685d90a63424ddd11c4edd590ea7e9ed4845e0656c30ab8dba3b" :answer/id #uuid "9d568472-481f-54ca-9b7d-15fc01cd1025" :answer/type :answer.type/math :answer/value "{y}^{2}=-3x" :db/ensure [:answer/validate]} {:db/id "q-11772/selection/6d3f6e1903b3a87fac9e98bec17abcebbe387db58352e935f818b8288e84264d" :answer/id #uuid "f1df571b-393c-532b-bf2a-0e654295747a" :answer/type :answer.type/math :answer/value "{y}^{2}=-7x" :db/ensure [:answer/validate]} {:db/id "q-11772/selection/ba42932e3bc72861e93c83d21fbdb17a7001626b8b69ce72d311b3a96411bc7e" :answer/id #uuid "8e08d898-3712-565e-b519-254dbd30f472" :answer/type :answer.type/math :answer/value "{y}^{2}=-5x" :db/ensure [:answer/validate]} {:db/id "q-11772/selection/9a150cbc2d87bcc8386575380f239f8892c7ce6d039aeafcd2cfbde4fcd7ae4b" :answer/id #uuid "ae4a04d3-f737-5f67-a709-217ce6beca1a" :answer/type :answer.type/math :answer/value "{y}^{2}=5x" :db/ensure [:answer/validate]} {:db/id "q-11772/selection/5ece6dafb241596e4c0127e30a1f0e9ed67de00561147ae34bba0692a5b4bea7" :answer/id #uuid "b586c5e3-ef3f-5fed-a09a-a80833331276" :answer/type :answer.type/math :answer/value "{y}^{2}=7x" :db/ensure [:answer/validate]} {:db/id "q-11772/selection" :answer-field/id #uuid "13c83e8b-3fac-5c55-b695-63be4c782c7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11772/selection/6d3f6e1903b3a87fac9e98bec17abcebbe387db58352e935f818b8288e84264d" :answer-field/choices ["q-11772/selection/5464b6528434685d90a63424ddd11c4edd590ea7e9ed4845e0656c30ab8dba3b" "q-11772/selection/6d3f6e1903b3a87fac9e98bec17abcebbe387db58352e935f818b8288e84264d" "q-11772/selection/ba42932e3bc72861e93c83d21fbdb17a7001626b8b69ce72d311b3a96411bc7e" "q-11772/selection/9a150cbc2d87bcc8386575380f239f8892c7ce6d039aeafcd2cfbde4fcd7ae4b" "q-11772/selection/5ece6dafb241596e4c0127e30a1f0e9ed67de00561147ae34bba0692a5b4bea7"] :db/ensure [:answer-field/validate]} {:db/id "q-11772" :question/id #uuid "9f5d2d16-f7ab-5a64-837e-def4991cf53a" :question/math-academy-id "q-11772" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-7,-7).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-7,-7),$ we can substitute $x=-7$ and $y=-7$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-7)^{2} & =4p(-7) \\\\ 49 & =-28p \\\\ p & =-\\frac{7}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{7}{4})x \\\\ {y}^{2} & =-7x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11772/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3"] :knowledge-point/questions ["q-11772"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11807/selection/22da716ea265893162d4b6396169f6dd2f752379b907f51f286112b7eea770db" :answer/id #uuid "b922c2d3-d768-5e43-8ba7-8372b7d2df11" :answer/type :answer.type/math :answer/value "(y-4)^{2}=-\\frac{16}{3}(x-2)" :db/ensure [:answer/validate]} {:db/id "q-11807/selection/e16496de043ee519189e79f2848183c96987a416638b44e27ff1bcb561122f58" :answer/id #uuid "535a72ef-50fb-52d3-ab41-bd3c2fc45b39" :answer/type :answer.type/math :answer/value "(y-2)^{2}=\\frac{8}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-11807/selection/73d2b20c2b3f3a736927ad2534ae128bfaef711928286eb915915ea6b96cc10e" :answer/id #uuid "ec9f01bf-aa36-51b4-9cdf-ffecaf5162b4" :answer/type :answer.type/math :answer/value "(y-2)^{2}=-\\frac{16}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-11807/selection/8a1d70ae79e6f53ab6504261c15d8fe87846beb2884d6dfa622eca3cafe99632" :answer/id #uuid "e0e8ff05-b7ec-5e45-a2d1-669cc182b0e1" :answer/type :answer.type/math :answer/value "(y-2)^{2}=\\frac{16}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-11807/selection/d5caf5cdb16e52087c9584a105d4e7dff9b4bbec7f78bbb0de317ddf1e2850bc" :answer/id #uuid "29ea01b8-0aa6-5d35-a52d-9bcb70fa3273" :answer/type :answer.type/math :answer/value "(y-2)^{2}=-\\frac{8}{3}(x-4)" :db/ensure [:answer/validate]} {:db/id "q-11807/selection" :answer-field/id #uuid "bca9c68d-9188-5543-b70a-8309a1436c55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11807/selection/73d2b20c2b3f3a736927ad2534ae128bfaef711928286eb915915ea6b96cc10e" :answer-field/choices ["q-11807/selection/22da716ea265893162d4b6396169f6dd2f752379b907f51f286112b7eea770db" "q-11807/selection/e16496de043ee519189e79f2848183c96987a416638b44e27ff1bcb561122f58" "q-11807/selection/73d2b20c2b3f3a736927ad2534ae128bfaef711928286eb915915ea6b96cc10e" "q-11807/selection/8a1d70ae79e6f53ab6504261c15d8fe87846beb2884d6dfa622eca3cafe99632" "q-11807/selection/d5caf5cdb16e52087c9584a105d4e7dff9b4bbec7f78bbb0de317ddf1e2850bc"] :db/ensure [:answer-field/validate]} {:db/id "q-11807" :question/id #uuid "414e12b5-a489-588c-a563-174560530b26" :question/math-academy-id "q-11807" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972835/assets/e4b681e9bdf5fa8021ca359e0bf93c27b53a18f0d5e906765a911a72ecfc0159.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(4,2)$ and passes through the point $(-8,10).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(4,2),$ we substitute $h=4$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-8,10),$ so we can substitute $x=-8$ and $y=10$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (10-2)^{2} & =4p(-8-4) \\\\ 64 & =-48p \\\\ p & =-\\frac{4}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (y-2)^{2} & =4(-\\frac{4}{3})(x-4) \\\\ (y-2)^{2} & =-\\frac{16}{3}(x-4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{4}{3}$ is negative." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a"] :knowledge-point/questions ["q-11807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11811/selection/f5e3e1038f5f67851f0fa3c74fb806aad0f7e93946cd2ce97c13c6aa9ff851ba" :answer/id #uuid "6cf93320-bffb-5854-88c9-1f611ce453a5" :answer/type :answer.type/math :answer/value "(y-6)^{2}=-5(x-4)" :db/ensure [:answer/validate]} {:db/id "q-11811/selection/bebb932af433ad9dca2901002c87d1047edb97f1275883d677b2be55b41965ed" :answer/id #uuid "0e05bdfc-5427-5883-b1a1-c0528d15dc1f" :answer/type :answer.type/math :answer/value "(y-4)^{2}=3(x-6)" :db/ensure [:answer/validate]} {:db/id "q-11811/selection/ba84791fd0dec7c9eee531f9422877c0a6c85873d70db2eec7c4c9333f331207" :answer/id #uuid "f7dd7722-90da-5c97-a13a-dfbbd066e68e" :answer/type :answer.type/math :answer/value "(y-4)^{2}=-5(x-6)" :db/ensure [:answer/validate]} {:db/id "q-11811/selection/102460189a36e3c644c52e5cd355ed5e852116dc3a92e9f7f0185531745797c2" :answer/id #uuid "d5bc2757-af02-5fdd-9bc3-bf441e418da1" :answer/type :answer.type/math :answer/value "(y-4)^{2}=5(x-6)" :db/ensure [:answer/validate]} {:db/id "q-11811/selection/e11f4777d307486873ffe375eda423bb4d30f35e3bb1c22c21f58848173945ce" :answer/id #uuid "bea63f44-af12-5db3-9c3f-7cc44ca93e99" :answer/type :answer.type/math :answer/value "(y-4)^{2}=-3(x-6)" :db/ensure [:answer/validate]} {:db/id "q-11811/selection" :answer-field/id #uuid "48ac1084-7cac-57fd-a633-8484341c8cfa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11811/selection/ba84791fd0dec7c9eee531f9422877c0a6c85873d70db2eec7c4c9333f331207" :answer-field/choices ["q-11811/selection/f5e3e1038f5f67851f0fa3c74fb806aad0f7e93946cd2ce97c13c6aa9ff851ba" "q-11811/selection/bebb932af433ad9dca2901002c87d1047edb97f1275883d677b2be55b41965ed" "q-11811/selection/ba84791fd0dec7c9eee531f9422877c0a6c85873d70db2eec7c4c9333f331207" "q-11811/selection/102460189a36e3c644c52e5cd355ed5e852116dc3a92e9f7f0185531745797c2" "q-11811/selection/e11f4777d307486873ffe375eda423bb4d30f35e3bb1c22c21f58848173945ce"] :db/ensure [:answer-field/validate]} {:db/id "q-11811" :question/id #uuid "55ed2b91-76f2-5ba6-93e2-258601e00a25" :question/math-academy-id "q-11811" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972835/assets/ecf128d341a8a568ade4abaa2a59e1083d2c436fdb3d2a0b4b642fb7e85cee63.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(6,4)$ and passes through the point $(1,9).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(6,4),$ we substitute $h=6$ and $k=4$ into the equation above and get\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(1,9),$ so we can substitute $x=1$ and $y=9$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6) \\\\ (9-4)^{2} & =4p(1-6) \\\\ 25 & =-20p \\\\ p & =-\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-4)^{2} & =4p(x-6) \\\\ (y-4)^{2} & =4(-\\frac{5}{4})(x-6) \\\\ (y-4)^{2} & =-5(x-6).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{5}{4}$ is negative." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11811/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a"] :knowledge-point/questions ["q-11811"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115648/selection/21f1e863a7b1e5427fbe6abc8d172c82b8e327029fabf71b1480f0e53e5de7d6" :answer/id #uuid "4c76720f-5fc0-51b7-81e1-07a6b885a8a3" :answer/type :answer.type/math :answer/value "(y+2)^{2}=\\frac{9}{20}x" :db/ensure [:answer/validate]} {:db/id "q-115648/selection/0f0feb9e5e94f7ab01451d68be0c503d4feff458e51d8b6d149491797afbda40" :answer/id #uuid "7b544aef-4b08-566e-b89f-6375a971585d" :answer/type :answer.type/math :answer/value "{y}^{2}=\\frac{9}{5}(x-2)" :db/ensure [:answer/validate]} {:db/id "q-115648/selection/c223b0b47d1225259a8016207968e98907ccf992bb956f88ea7881ddece83d96" :answer/id #uuid "aed3fca7-d8d1-57a1-b538-8ed46c92bfa6" :answer/type :answer.type/math :answer/value "(x+2)^{2}=\\frac{9}{5}y" :db/ensure [:answer/validate]} {:db/id "q-115648/selection/f2486009e203a4eb1d7dcd8c3e0d8431513d0cb6daafcd3fadb7b1985e1265de" :answer/id #uuid "024188a7-1314-5685-a589-3841147df8e6" :answer/type :answer.type/math :answer/value "(y-2)^{2}=\\frac{9}{5}x" :db/ensure [:answer/validate]} {:db/id "q-115648/selection/c328d159182f69c5968a8c272f99db2d48d49a9209963c1b5cd3dfbf18ece332" :answer/id #uuid "b019f271-7470-5ee4-bd93-d25a46cebb3a" :answer/type :answer.type/math :answer/value "(x-2)^{2}=\\frac{9}{20}y" :db/ensure [:answer/validate]} {:db/id "q-115648/selection" :answer-field/id #uuid "f922b8c4-d133-5566-9064-c0537c542bff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115648/selection/f2486009e203a4eb1d7dcd8c3e0d8431513d0cb6daafcd3fadb7b1985e1265de" :answer-field/choices ["q-115648/selection/21f1e863a7b1e5427fbe6abc8d172c82b8e327029fabf71b1480f0e53e5de7d6" "q-115648/selection/0f0feb9e5e94f7ab01451d68be0c503d4feff458e51d8b6d149491797afbda40" "q-115648/selection/c223b0b47d1225259a8016207968e98907ccf992bb956f88ea7881ddece83d96" "q-115648/selection/f2486009e203a4eb1d7dcd8c3e0d8431513d0cb6daafcd3fadb7b1985e1265de" "q-115648/selection/c328d159182f69c5968a8c272f99db2d48d49a9209963c1b5cd3dfbf18ece332"] :db/ensure [:answer-field/validate]} {:db/id "q-115648" :question/id #uuid "0695a7e0-e42c-5754-8590-aebc60ec68a0" :question/math-academy-id "q-115648" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(0,2)$ and passes through the point $(5,5).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(0,2),$ we substitute $h=0$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4px.\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(5,5),$ so we can substitute $x=5$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4px \\\\ (5-2)^{2} & =4p(5) \\\\ 9 & =20p \\\\ p & =\\frac{9}{20}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4px \\\\ (y-2)^{2} & =4(\\frac{9}{20})x \\\\ (y-2)^{2} & =\\frac{9}{5}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115648/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817"] :knowledge-point/questions ["q-115648"] :db/ensure [:knowledge-point/validate]}]
