b7-a392-5a6d-83a8-7c68af379b0f" :answer/type :answer.type/math :answer/value "x\\in [-5,5]" :db/ensure [:answer/validate]} {:db/id "q-72532/selection/10bae6ac41330a2499c6b52fde07c921169f5e41ba35b00fbbef9e055015e61a" :answer/id #uuid "119ca655-dcb8-5466-8136-9c7c1b71ba80" :answer/type :answer.type/math :answer/value "x\\in [5,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-72532/selection/9ef45454044ef7509a0d129d12987df17b1d666efb72f31ed54fef0de2f4baff" :answer/id #uuid "38891ea5-e0f0-5691-b379-b313ca5f42d3" :answer/type :answer.type/math :answer/value "x\\in [-\\sqrt{5},\\sqrt{5}]" :db/ensure [:answer/validate]} {:db/id "q-72532/selection/da16e3176141d97101936fbbb985331ced90349a0903ee4b2f60dff1e867b496" :answer/id #uuid "483b767a-8c56-5d32-bc53-48c65ee5fe30" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-\\sqrt{5}]\\cup [\\sqrt{5},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-72532/selection" :answer-field/id #uuid "016ec693-3dae-5c26-b930-877371311705" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72532/selection/da16e3176141d97101936fbbb985331ced90349a0903ee4b2f60dff1e867b496" :answer-field/choices ["q-72532/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" "q-72532/selection/e28384b6d9aac1c066a52f46da4ec39bac7443c6c9ab9a5c4f299919dda4ef53" "q-72532/selection/10bae6ac41330a2499c6b52fde07c921169f5e41ba35b00fbbef9e055015e61a" "q-72532/selection/9ef45454044ef7509a0d129d12987df17b1d666efb72f31ed54fef0de2f4baff" "q-72532/selection/da16e3176141d97101936fbbb985331ced90349a0903ee4b2f60dff1e867b496"] :db/ensure [:answer-field/validate]} {:db/id "q-72532" :question/id #uuid "a4911f53-4177-5d14-ab99-c38b6cc52a42" :question/math-academy-id "q-72532" :question/problem "Solve the inequality ${x}^{2}\\ge 5$ using the absolute value method." :question/worked-solution "Taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 5 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{5} \\\\ |x| & \\ge \\sqrt{5}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx\\le -\\sqrt{5}\\,\\text{or}\\,x\\ge \\sqrt{5}.\n$$\n\nTherefore the solution is $x\\in (-\\infty ,-\\sqrt{5}]\\cup [\\sqrt{5},\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63205c8e-0e51-523a-8dee-cba7c680b8f8"] :knowledge-point/questions ["q-72532"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70262/selection/5bccef26e9e8b2301d88c81584b9cadbc9fb365858aca5a7f9c362dc3acf6668" :answer/id #uuid "5becf8df-39cf-5b71-b492-1e98417cba31" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2\\sqrt{2})\\cup (2\\sqrt{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-70262/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" :answer/id #uuid "2d1dc283-0c37-5d1e-8080-76c5e6a2842b" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-70262/selection/78539baaec09a5e0ffc8b649c6512e589841d2677eaa2fdb02cd382076953d81" :answer/id #uuid "37f648eb-5e7a-5663-bc6c-fda0fb0ed9ac" :answer/type :answer.type/math :answer/value "x\\in (-2\\sqrt{2},2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-70262/selection/ec924baa48b8abde7e784f1b1c24fc91b4b943e72e0412de2785932955fc53ae" :answer/id #uuid "1ea7ccc8-df91-5da4-976d-c0a04fd338f6" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-70262/selection/965340ad3ba6c63f9dac0d1fba7c6a3d269fd4f6c0649aa22e71f0b507e8cba0" :answer/id #uuid "d8631bbd-29ee-5cc5-91ef-46468188198c" :answer/type :answer.type/math :answer/value "x\\in (2\\sqrt{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-70262/selection" :answer-field/id #uuid "7e2f828a-8b4d-5a82-9512-29f9321cd3aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70262/selection/5bccef26e9e8b2301d88c81584b9cadbc9fb365858aca5a7f9c362dc3acf6668" :answer-field/choices ["q-70262/selection/5bccef26e9e8b2301d88c81584b9cadbc9fb365858aca5a7f9c362dc3acf6668" "q-70262/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" "q-70262/selection/78539baaec09a5e0ffc8b649c6512e589841d2677eaa2fdb02cd382076953d81" "q-70262/selection/ec924baa48b8abde7e784f1b1c24fc91b4b943e72e0412de2785932955fc53ae" "q-70262/selection/965340ad3ba6c63f9dac0d1fba7c6a3d269fd4f6c0649aa22e71f0b507e8cba0"] :db/ensure [:answer-field/validate]} {:db/id "q-70262" :question/id #uuid "06e0a45c-9ce6-5fb7-94b5-7115a9114493" :question/math-academy-id "q-70262" :question/problem "Solve the inequality ${x}^{2}-8>0$ using the absolute value method." :question/worked-solution "Bringing the constant term to the right-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2}-8 & >0 \\\\ {x}^{2} & >8.\\end{aligned}\n$$\n\nThen, taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & >8 \\\\ \\sqrt{{x}^{2}} & >\\sqrt{8} \\\\ |x| & >2\\sqrt{2}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx<-2\\sqrt{2}\\,\\text{or}\\,x>2\\sqrt{2}.\n$$\n\nThe solution is $x\\in (-\\infty ,-2\\sqrt{2})\\cup (2\\sqrt{2},\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70262/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63205c8e-0e51-523a-8dee-cba7c680b8f8"] :knowledge-point/questions ["q-70262"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278108/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "b083df10-288b-5cbc-893a-533780f980ca" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-278108/field-1" :answer-field/id #uuid "7d5a71b7-6d67-58ca-83c2-b0f61544d174" :answer-field/key "