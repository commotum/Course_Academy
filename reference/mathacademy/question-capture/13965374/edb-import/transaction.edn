de374bf83e33a9b8d608df0fc1f3ea44937c1dda33485572067ec60c6e4.png)\n\nTherefore, the solution is $x\\in (-\\infty ,-6)\\cup (6,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70260/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3ec4ab1-ad6f-5c4e-9b80-a1329f2e8f63"] :knowledge-point/questions ["q-70260"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270802/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "25ebbe71-3d24-5b24-9859-ef0bda7f894b" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-270802/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e4430696-ad25-5213-a88a-0e1b1b2f91f7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-270802/field-1" :answer-field/id #uuid "ab47d77f-336c-5794-8d02-ef85a54d6443" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270802/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer-field/choices ["q-270802/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" "q-270802/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-270802/field-2/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "df4e43f8-2628-5ddb-8e8a-29e45ce2f07c" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-270802/field-2" :answer-field/id #uuid "f2613879-f4ee-5259-b662-0134cadbfeab" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270802/field-2/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer-field/choices ["q-270802/field-2/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616"] :db/ensure [:answer-field/validate]} {:db/id "q-270802/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "78f75a87-ff44-573e-b272-b466987046e9" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-270802/field-3" :answer-field/id #uuid "714c8b96-cdf6-5fa0-ba62-751066077fbc" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270802/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-270802/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-270802/field-4/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer/id #uuid "b9a3140d-507b-5c8a-a77b-fa005351315b" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "q-270802/field-4" :answer-field/id #uuid "5753e6f7-5eb7-5289-8126-26f60868ad28" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270802/field-4/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer-field/choices ["q-270802/field-4/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c"] :db/ensure [:answer-field/validate]} {:db/id "q-270802" :question/id #uuid "be492f2f-d082-56fd-b292-3d12cc939d88" :question/math-academy-id "q-270802" :question/problem "Solve the inequality  ${x}^{2}\\ge 100$ using a graphical method.\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$]⋃[$\n{{field-3}}$,$\n{{field-4}}$)$" :question/worked-solution "Bringing all the terms to the left-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 100 \\\\ {x}^{2}-100 & \\ge 0.\\end{aligned}\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-100\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-100 & =0 \\\\ {x}^{2}-{10}^{2} & =0 \\\\ (x-10)(x+10) & =0\\end{aligned}\n$$\n\nSo the roots are $x=\\pm 10.$ \n\nSolving the inequality ${x}^{2}-100\\ge 0$ is equivalent to finding the values of $x$ for which the parabola $y={x}^{2}-100$ is above or intersects the $x$-axis (where $y\\ge 0$).\n\nSince the leading coefficient of the quadratic expression is positive, the parabola opens upward. Therefore, the solution set lies outside the roots (including them), as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/6a6fe4b8f332bd821f27868586685f52d0dbcf326984ad683a27f41d5da473a4.png)\n\nTherefore, the solution is \n\n$$\nx\\in (-\\infty ,-10]\\cup [10,\\infty ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-270802/field-1" "q-270802/field-2" "q-270802/field-3" "q-270802/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3ec4ab1-ad6f-5c4e-9b80-a1329f2e8f63"] :knowledge-point/questions ["q-270802"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115063/selection/0c4838238b1e20c6215d8d33aee67e9bae280383688d63aa36b5bd8c7685558d" :answer/id #uuid "f16217b5-605e-5406-af34-f15abb295e96" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-49]\\cup [49,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115063/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" :answer/id #uuid "18839743-9592-5913-9689-7cff96ef106d" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115063/selection/4631d7927218f900dba39aa00de50aba1fd5115458e06e75d9da5228d09d3abc" :answer/id #uuid "d2ab027c-dfbe-5f87-b278-8ce7fc05f2c8" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-7]\\cap [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115063/selection/f9cd2268598266f0bd65601ebbc258c68427bd6b21609506913ccacdb25a3088" :answer/id #uuid "b5b8fba3-8974-5044-96f0-f8cf971c5295" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-7]\\cup [7,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115063/selection/1bb23d96fd5721d878124a9c5ec715da1a00f948339da11771987f97a1e78e3e" :answer/id #uuid "91dab6b3-f20f-5efc-a0d8-243664cdff03" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-7]" :db/ensure [:answer/validate]} {:db/id "q-115063/selection" :answer-field/id #uuid "54587f8f-5d9e-5958-9121-c73acf1bade7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115063/selection/f9cd2268598266f0bd65601ebbc258c68427bd6b21609506913ccacdb25a3088" :answer-field/choices ["q-115063/selection/0c4838238b1e20c6215d8d33aee67e9bae280383688d63aa36b5bd8c7685558d" "q-115063/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" "q-115063/selection/4631d7927218f900dba39aa00de50aba1fd5115458e06e75d9da5228d09d3abc" "q-115063/selection/f9cd2268598266f0bd65601ebbc258c68427bd6b21609506913ccacdb25a3088" "q-115063/selection/1bb23d96fd5721d878124a9c5ec715da1a00f948339da11771987f97a1e78e3e"] :db/ensure [:answer-field/validate]} {:db/id "q-115063" :question/id #uuid "c9f27888-d6d0-5a5b-b428-4bf6ff1558c7" :question/math-academy-id "q-115063" :question/problem "Solve the inequality  ${x}^{2}\\ge 49$ using a graphical method." :question/worked-solution "Bringing all the terms to the left-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 49 \\\\ {x}^{2}-49 & \\ge 0.\\end{aligned}\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-49\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-49 & =0 \\\\ {x}^{2}-{7}^{2} & =0 \\\\ (x-7)(x+7) & =0\\end{aligned}\n$$\n\nSo the roots are $x=\\pm 7.$ \n\nSolving the inequality ${x}^{2}-49\\ge 0$ is equivalent to finding the values of $x$ for which the parabola $y={x}^{2}-49$ is above the $x$-axis or intersects the $x$-axis (where $y\\ge 0$).\n\nSince the leading coefficient of the quadratic expression is positive, the parabola opens upward. Therefore, the solution set lies outside the roots (including them), as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/5993bb434fca17beb9842d7963c5f560b4d8ef0bacadea4c120160d2ab93d131.png)\n\nTherefore, the solution is $x\\in (-\\infty ,-7]\\cup [7,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115063/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3ec4ab1-ad6f-5c4e-9b80-a1329f2e8f63"] :knowledge-point/questions ["q-115063"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115079/selection/7375dc23a5fb4bb5bb6a2cf0f23133ddd655c49712b3a35581eed88b610460c6" :answer/id #uuid "9a61ac17-d5ff-57a2-9e5b-b7798be8da27" :answer/type :answer.type/math :answer/value "x\\in [-6,6]" :db/ensure [:answer/validate]} {:db/id "q-115079/selection/8a9415bfcd619fe9b96be41cac23b0b5e76604e61e86b858dd7d4cfcc7291d51" :answer/id #uuid "f8c31eca-f856-5dc9-8850-3725a3cfd445" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-6]" :db/ensure [:answer/validate]} {:db/id "q-115079/selection/28e8e6e024dcb57410590783638ee1efdc4e95896465259c2bd9571dfdb0da41" :answer/id #uuid "9fdfafe3-4afc-594c-b88f-b22b9224b450" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-6]\\cup [6,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115079/selection/b14143e51b3b85a70a0b40a3dccfdaaea35904daf03115357a436df87b3d0c7f" :answer/id #uuid "891af825-cc2c-5895-b19a-c3e1c277140c" :answer/type :answer.type/math :answer/value "x\\in [6,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115079/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8" :answer/id #uuid "f985b433-d7c6-52f2-9408-37cc03345099" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115079/selection" :answer-field/id #uuid "346dc631-29dc-5faa-baea-a93fb5ddb550" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115079/selection/28e8e6e024dcb57410590783638ee1efdc4e95896465259c2bd9571dfdb0da41" :answer-field/choices ["q-115079/selection/7375dc23a5fb4bb5bb6a2cf0f23133ddd655c49712b3a35581eed88b610460c6" "q-115079/selection/8a9415bfcd619fe9b96be41cac23b0b5e76604e61e86b858dd7d4cfcc7291d51" "q-115079/selection/28e8e6e024dcb57410590783638ee1efdc4e95896465259c2bd9571dfdb0da41" "q-115079/selection/b14143e51b3b85a70a0b40a3dccfdaaea35904daf03115357a436df87b3d0c7f" "q-115079/selection/04f9566070c5e39d622faed7487676d27debbd366c354177306f677d79163db8"] :db/ensure [:answer-field/validate]} {:db/id "q-115079" :question/id #uuid "9a0ce597-b01b-5e38-ae10-e0ca27e4adf5" :question/math-academy-id "q-115079" :question/problem "Solve the inequality ${x}^{2}\\ge 36$ using the absolute value method." :question/worked-solution "Taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 36 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{36} \\\\ |x| & \\ge 6.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx\\le -6\\,\\text{or}\\,x\\ge 6.\n$$\n\nTherefore the solution is $x\\in (-\\infty ,-6]\\cup [6,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115079/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63205c8e-0e51-523a-8dee-cba7c680b8f8"] :knowledge-point/questions ["q-115079"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270805/field-1/c2223b402abc62f38e0912260502c4886959d43580edcea4b6bfd37e37b0f72b" :answer/id #uuid "e79564f6-d3ee-5e2d-945a-870ae96c1e01" :answer/type :answer.type/math :answer/value "-\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-270805/field-1" :answer-field/id #uuid "75b06e58-a1b5-5be0-9df8-79e7d9948a58" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270805/field-1/c2223b402abc62f38e0912260502c4886959d43580edcea4b6bfd37e37b0f72b" :answer-field/choices ["q-270805/field-1/c2223b402abc62f38e0912260502c488695