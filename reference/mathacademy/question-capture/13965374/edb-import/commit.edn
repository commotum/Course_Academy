6300475 1113 #uuid "06e0a45c-9ce6-5fb7-94b5-7115a9114493" 13194139534639 true] [17592186300475 1145 "Bringing the constant term to the right-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2}-8 & >0 \\\\ {x}^{2} & >8.\\end{aligned}\n$$\n\nThen, taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & >8 \\\\ \\sqrt{{x}^{2}} & >\\sqrt{8} \\\\ |x| & >2\\sqrt{2}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx<-2\\sqrt{2}\\,\\text{or}\\,x>2\\sqrt{2}.\n$$\n\nThe solution is $x\\in (-\\infty ,-2\\sqrt{2})\\cup (2\\sqrt{2},\\infty ).$" 13194139534639 true] [17592186300476 1000 #edb/ref 17592186300477 13194139534639 true] [17592186300476 1000 #edb/ref 17592186300478 13194139534639 true] [17592186300476 1000 #edb/ref 17592186300479 13194139534639 true] [17592186300476 1000 #edb/ref 17592186300480 13194139534639 true] [17592186300476 1000 #edb/ref 17592186300481 13194139534639 true] [17592186300476 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300476 1041 "selection" 13194139534639 true] [17592186300476 1104 #edb/ref 17592186300478 13194139534639 true] [17592186300476 1110 #uuid "7e2f828a-8b4d-5a82-9512-29f9321cd3aa" 13194139534639 true] [17592186300477 1034 "x\\in (-\\infty ,\\infty )" 13194139534639 true] [17592186300477 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300477 1111 #uuid "2d1dc283-0c37-5d1e-8080-76c5e6a2842b" 13194139534639 true] [17592186300478 1034 "x\\in (-\\infty ,-2\\sqrt{2})\\cup (2\\sqrt{2},\\infty )" 13194139534639 true] [17592186300478 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300478 1111 #uuid "5becf8df-39cf-5b71-b492-1e98417cba31" 13194139534639 true] [17592186300479 1034 "x\\in (-2\\sqrt{2},2\\sqrt{2})" 13194139534639 true] [17592186300479 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300479 1111 #uuid "37f648eb-5e7a-5663-bc6c-fda0fb0ed9ac" 13194139534639 true] [17592186300480 1034 "x\\in (2\\sqrt{2},\\infty )" 13194139534639 true] [17592186300480 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300480 1111 #uuid "d8631bbd-29ee-5cc5-91ef-46468188198c" 13194139534639 true] [17592186300481 1034 "x\\in (-\\infty ,-2\\sqrt{2})" 13194139534639 true] [17592186300481 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300481 1111 #uuid "1ea7ccc8-df91-5da4-976d-c0a04fd338f6" 13194139534639 true] [17592186300482 1017 #edb/ref 17592186300483 13194139534639 true] [17592186300482 1089 "q-70275" 13194139534639 true] [17592186300482 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300482 1100 "Solve the inequality ${x}^{2}<-7.$" 13194139534639 true] [17592186300482 1113 #uuid "84c48822-db58-5782-9ad8-c8f639b2189d" 13194139534639 true] [17592186300482 1145 "We can solve this inequality using either of the two methods described below.\n\n**Method 1 - Solving an Absolute Value Inequality**\n\nWe know that the square of *any* real number is greater than or equal to zero. Therefore, it is impossible for the square of a real number to be smaller than $-7.$\n\nSo, the inequality ${x}^{2}<-7$ has no solutions.\n\n**Method 2 - Picturing a Quadratic Curve**\n\nLet's bring all the terms to the left-hand side,\n\n$$\n{x}^{2}+7<0,\n$$\n\nand then plot the parabola $y={x}^{2}+7.$ The desired inequality ($y<0$) is never satisfied, so there are no solutions.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/65e1586fe54b49aec11d04a859c2d88dc95304528facf4b450b46fdf9fc76537.png)" 13194139534639 true] [17592186300483 1000 #edb/ref 17592186300484 13194139534639 true] [17592186300483 1000 #edb/ref 17592186300485 13194139534639 true] [17592186300483 1000 #edb/ref 17592186300486 13194139534639 true] [17592186300483 1000 #edb/ref 17592186300487 13194139534639 true] [17592186300483 1000 #edb/ref 17592186300488 13194139534639 true] [17592186300483 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300483 1041 "selection" 13194139534639 