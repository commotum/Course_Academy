3194139534639 true] [17592186300358 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300358 1111 #uuid "09cca1bb-f762-5045-8305-f51f1b489567" 13194139534639 true] [17592186300359 1034 "x\\in (-3,\\infty )" 13194139534639 true] [17592186300359 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300359 1111 #uuid "0f3cb3fa-a00b-5559-9df7-e3d257d7f3f0" 13194139534639 true] [17592186300360 1034 "x\\in (-\\infty ,-9)\\cup (9,\\infty )" 13194139534639 true] [17592186300360 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300360 1111 #uuid "ff4b53a2-743d-5247-9d7d-8d92f426660c" 13194139534639 true] [17592186300361 1034 "x\\in (-9,9)" 13194139534639 true] [17592186300361 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300361 1111 #uuid "e44c5bed-36c2-5aeb-ae82-4ce6d542ff34" 13194139534639 true] [17592186300362 1034 "x\\in (-3,3)" 13194139534639 true] [17592186300362 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300362 1111 #uuid "a6c36e05-1708-582f-a878-d0a4e38fad1a" 13194139534639 true] [17592186300363 1017 #edb/ref 17592186300364 13194139534639 true] [17592186300363 1089 "q-115079" 13194139534639 true] [17592186300363 1091 #edb/ref 17592186045463 13194139534639 true] [17592186300363 1100 "Solve the inequality ${x}^{2}\\ge 36$ using the absolute value method." 13194139534639 true] [17592186300363 1113 #uuid "9a0ce597-b01b-5e38-ae10-e0ca27e4adf5" 13194139534639 true] [17592186300363 1145 "Taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 36 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{36} \\\\ |x| & \\ge 6.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx\\le -6\\,\\text{or}\\,x\\ge 6.\n$$\n\nTherefore the solution is $x\\in (-\\infty ,-6]\\cup [6,\\infty ).$" 13194139534639 true] [17592186300364 1000 #edb/ref 17592186300365 13194139534639 true] [17592186300364 1000 #edb/ref 17592186300366 13194139534639 true] [17592186300364 1000 #edb/ref 17592186300367 13194139534639 true] [17592186300364 1000 #edb/ref 17592186300368 13194139534639 true] [17592186300364 1000 #edb/ref 17592186300369 13194139534639 true] [17592186300364 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300364 1041 "selection" 13194139534639 true] [17592186300364 1104 #edb/ref 17592186300366 13194139534639 true] [17592186300364 1110 #uuid "346dc631-29dc-5faa-baea-a93fb5ddb550" 13194139534639 true] [17592186300365 1034 "x\\in (-\\infty ,\\infty )" 13194139534639 true] [17592186300365 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300365 1111 #uuid "f985b433-d7c6-52f2-9408-37cc03345099" 13194139534639 true] [17592186300366 1034 "x\\in (-\\infty ,-6]\\cup [6,\\infty )" 13194139534639 true] [17592186300366 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300366 1111 #uuid "9fdfafe3-4afc-594c-b88f-b22b9224b450" 13194139534639 true] [17592186300367 1034 "x\\in [-6,6]" 13194139534639 true] [17592186300367 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300367 1111 #uuid "9a61ac17-d5ff-57a2-9e5b-b7798be8da27" 13194139534639 true] [17592186300368 1034 "x\\in (-\\infty ,-6]" 13194139534639 true] [17592186300368 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300368 1111 #uuid "f8c31eca-f856-5dc9-8850-3725a3cfd445" 13194139534639 true] [17592186300369 1034 "x\\in [6,\\infty )" 13194139534639 true] [17592186300369 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300369 1111 #uuid "891af825-cc2c-5895-b19a-c3e1c277140c" 13194139534639 true] [17592186300370 1017 #edb/ref 17592186300371 13194139534639 true] [17592186300370 1089 "q-115215" 13194139534639 true] [17592186300370 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300370 1100 "Solve  $6{x}^{2}-7<5{x}^{2}+9.$" 13194139534639 true] [17592186300370 1113 #uuid "475ae322-29a9-55a2-881e-aa7f37b2937a" 13194139534639 true] [17592186300370 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}6{x}^{2}-7 & <5{x}^{2}+9 \\\\ 6{x}^{2}-5{x}^{2} & <9+7 \\\\ {x}^{2} & <16\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n*Method 1 - Solving an Absolute Value Equation*\n\nTaking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & <16 \\\\ \\sqrt{{x}^{2}} & <\\sqrt{16} \\\\ |x| & <4.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have $-4<x<4.$\n\nSo, the solution is $\\,x\\in (-4,4).$\n\n*Method 2 - Picturing a Quadratic Curve*\n\nStarting from ${x}^{2}<16$ and moving all terms to the left-hand side, we reach\n\n$$\n{x}^{2}-16<0.\n$$\n\nNow, we consider the corresponding parabola given by $y={x}^{2}-16$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-16 & =0 \\\\ {x}^{2} & =16 \\\\ x & =\\pm \\sqrt{16} \\\\  & =\\pm 4\\end{aligned}\n$$\n\nSo the roots are $x=\\pm 4.$ \n\nSince the leading coefficient of ${x}^{2}-16$ is positive, the parabola opens upward. Therefore, the solution to the given inequality ($y<0$) lies between the roots (but does not include them).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/48ffe19b490220651ddba5095ae192c49df2e36d1b203031784fd8c3f4aaa559.png)\n\nTherefore, the solution is $x\\in (-4,4).$" 13194139534639 true] [17592186300371 1000 #edb/ref 17592186300372 13194139534639 true] [17592186300371 1000 #edb/ref 17592186300373 13194139534639 true] [17592186300371 1000 #edb/ref 17592186300374 13194139534639 true] [17592186300371 1000 #edb/ref 17592186300375 13194139534639 true] [17592186300371 1000 #edb/ref 17592186300376 13194139534639 true] [17592186300371 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300371 1041 "selection" 13194139534639 true] [17592186300371 1104 #edb/ref 17592186300376 13194139534639 true] [17592186300371 1110 #uuid "42952e7d-de53-520d-9523-eaeabb8759ad" 13194139534639 true] [17592186300372 1034 "x\\in (-\\infty ,\\infty )" 13194139534639 true] [17592186300372 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300372 1111 #uuid "311ae9ce-4ed5-59dd-b473-cc9410acda83" 13194139534639 true] [17592186300373 1034 "x\\in (-16,16)" 13194139534639 true] [17592186300373 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300373 1111 #uuid "a29ecac1-7112-5be2-9d99-ae26a97aafb8" 13194139534639 true] [17592186300374 1034 "x\\in (-\\infty ,16)" 13194139534639 true] [17592186300374 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300374 1111 #uuid "cd18623b-3f3a-5423-a5bd-41ebde3698ad" 13194139534639 true] [17592186300375 1034 "x\\in (-\\infty ,-4)\\cup (4,\\infty )" 13194139534639 true] [17592186300375 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300375 1111 #uuid "081e87f0-fe7c-5e6e-9db9-4dd7fe65f958" 13194139534639 true] [17592186300376 1034 "x\\in (-4,4)" 13194139534639 true] [17592186300376 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300376 1111 #uuid "ea1bd7df-2b0d-5cbb-9d58-4e9331afef83" 13194139534639 true] [17592186300377 1017 #edb/ref 17592186300378 13194139534639 true] [17592186300377 1089 "q-115223" 13194139534639 true] [17592186300377 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300377 1100 "Solve  $7{x}^{2}>5{x}^{2}+14.$" 13194139534639 true] [17592186300377 1113 #uuid "97e1931e-9994-5004-b0d4-f8756af91c11" 13194139534639 true] [17592186300377 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}7{x}^{2} & >5{x}^{2}+14 \\\\ 7{x}^{2}-5{x}^{2} & >14 \\\\ 2{x}^{2} & >14 \\\\ {x}^{2} & >7\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n*Method 1 - Solving an Absolute Value Equation*\n\nTaking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & >7 \\\\ \\sqrt{{x}^{2}} & >\\sqrt{7} \\\\ |x| & >\\sqrt{7}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have \n\n$$\nx<-\\sqrt{7}\\,\\text{or}\\,x>\\sqrt{7}.\n$$\n\nSo, the solution is $\\,x\\in (-\\infty ,-\\sqrt{7})\\cup (\\sqrt{7},\\infty ).$\n\n*Method 2 - Picturing a Quadratic Curve*\n\nStarting from ${x}^{2}>7$ and moving all terms to the left-hand side, we reach\n\n$$\n{x}^{2}-7>0.\n$$\n\nNow, we consider the corresponding parabola given by $y={x}^{2}-7$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-7 & =0 \\\\ {x}^{2} & =7 \\\\ x & =\\pm \\sqrt{7}\\end{aligned}\n$$\n\nSo the roots are $x=\\pm \\sqrt{7}.$ \n\nSince the leading coefficient of ${x}^{2}-7$ is positive, the parabola opens upward. Therefore, the solution to the given inequality ($y>0$) lies outside the roots (but does not include them).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/1eba3bc41624ea6fdd11468b53630fd8995541ff01548ec57a36dad271e375f8.png)\n\nTherefore, the solution is $x\\in (-\\infty ,-\\sqrt{7})\\cup (\\sqrt{7},\\infty ).$" 13194139534639 true] [17592186300378 1000 #edb/ref 17592186300379 13194139534639 true] [17592186300378 1000 #edb/ref 17592186300380 13194139534639 true] [17592186300378 1000 #edb/ref 17592186300381 13194139534639 true] [17592186300378 1000 #edb/ref 17592186300382 13194139534639 true] [17592186300378 1000 #edb/ref 17592186300383 13194139534639 true] [17592186300378 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300378 1041 "selection" 13194139534639 true] [17592186300378 1104 #edb/ref 17592186300383 13194139534639 true] [17592186300378 1110 #uuid "6d07a5b0-4012-5230-b96b-112426c9b743" 13194139534639 true] [17592186300379 1034 "x\\in (-\\infty ,-\\sqrt{7})" 13194139534639 true] [17592186300379 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300379 1111 #uuid "e57a7d43-2f39-534f-bd7f-13c95ab05f79" 13194139534639 true] [17592186300380 1034 "x\\in (7,\\infty )" 13194139534639 true] [17592186300380 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300380 1111 #uuid "03663ec4-09d1-54b8-b358-535966fbb62f" 13194139534639 true] [17592186300381 1034 "x\\in (-\\sqrt{7},\\sqrt{7})" 13194139534639 true] [17592186300381 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300381 1111 #uuid "a8653185-3ed3-5760-88d9-fce824d47565" 13194139534639 true] [17592186300382 1034 "x\\in (-\\infty ,-7)\\cup (7,\\infty )" 13194139534639 true] [17592186300382 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300382 1111 #uuid "0c8a6ee1-65fa-5bac-a16d-e197e6c3b25a" 13194139534639 true] [17592186300383 1034 "x\\in (-\\infty ,-\\sqrt{7})\\cup (\\sqrt{7},\\infty )" 13194139534639 true] [17592186300383 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300383 1111 #uuid "11ba6fae-5a62-5e28-8084-06d004ee7f24" 13194139534639 true] [17592186300384 1017 #edb/ref 17592186300385 13194139534639 true] [17592186300384 1089 "q-115236" 13194139534639 true] [17592186300384 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300384 1100 "Solve the inequality ${x}^{2}<-2.$" 13194139534639 true] [17592186300384 1113 #uuid "29a2f589-934b-573a-8ec8-f05d777baa91" 13194139534639 true] [17592186300384 1145 "We can solve this inequality using either of the two methods described below.\n\n**Method 1 - Solving an Absolute Value Inequality**\n\nWe know that the square of *any* real number is greater than or equal to zero. Therefore, it is impossible for the square of a real number to be smaller than $-2.$\n\nSo, the inequality ${x}^{2}<-2$ has no solutions.\n\n**Method 2 - Picturing a Quadratic Curve**\n\nLet's bring all the terms to the left-hand side,\n\n$$\n{x}^{2}+2<0,\n$$\n\nand then plot the parabola $y={x}^{2}+2.$ The desired inequality ($y<0$) is never satisfied, so there are no solutions.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/cd3ced552ef08804a308a47c7e1fbc5be9b045ee6a79203ba5e88f5a38a130ab.png)" 13194139534639 true] [17592186300385 1000 #edb/ref 17592186300386 13194139534639 true] [17592186300385 1000 #edb/ref 17592186300387 13194139534639 true] [17592186300385 1000 #edb/ref 17592186300388 13194139534639 true] [17592186300385 1000 #edb/ref 17592186300389 13194139534639 true] [17592186300385 1000 #edb/ref 17592186300390 13194139534639 true] [17592186300385 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300385 1041 "selection" 13194139534639 true] [17592186300385 1104 #edb/ref 17592186300386 13194139534639 true] [17592186300385 1110 #uuid "ea631044-94a2-5793-99a0-1b03fe28cf22" 13194139534639 true] [17592186300386 1034 "The inequality has no solution" 13194139534639 true] [17592186300386 1103 #edb/ref 17592186045454 13194139534639 true] [17592186300386 1111 #uuid "5a67edf0-7a79-584a-b38e-426fd6581b57" 13194139534639 true] [17592186300387 1034 "-2<x<2" 13194139534639 true] [17592186300387 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300387 1111 #uuid "989cfa8c-e96a-5035-a48d-cd6a2691cd9e" 13194139534639 true] [17592186300388 1034 "x<-\\sqrt{2}" 13194139534639 true] [17592186300388 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300388 1111 #uuid "18079e21-d5dc-5e81-8b31-dfe8253c20e1" 13194139534639 true] [17592186300389 1034 "-\\sqrt{2}<x<\\sqrt{2}" 13194139534639 true] [17592186300389 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300389 1111 #uuid "a858f718-a68b-51cb-a5c7-20df879ede40" 13194139534639 true] [17592186300390 1034 "-2<x<0" 13194139534639 true] [17592186300390 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300390 1111 #uuid "15bf6e12-5e23-5ec4-9868-ff47601be99e" 13194139534639 true] [17592186300391 1017 #edb/ref 17592186300392 13194139534639 true] [17592186300391 1089 "q-115270" 13194139534639 true] [17592186300391 1091 #edb/ref 17592186045464 13194139534639 true] [17592186300391 1100 "Solve the inequality $5{x}^{2}+2x>2x-3.$" 13194139534639 true] [17592186300391 1113 #uuid "e02d19b4-8737-5015-ba59-9847dce35fd4" 13194139534639 true] [17592186300391 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}5{x}^{2}+2x & >2x-3 \\\\ 5{x}^{2}+2x-2x & >2x-3-2x \\\\ 5{x}^{2} & >-3.\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n**Method 1 - Solving an Absolute Value Inequality**\n\nWe know that the square of *any* real number is greater than or equal to zero.\n\nSo, the inequality is true for every real number. Therefore the solution is $x\\in (-\\infty ,\\infty ).$ \n\n**Method 2 - Picturing a Quadratic Curve**\n\nStarting from $5{x}^{2}>-3$ and moving all terms to the left-hand side, we reach\n\n$$\n5{x}^{2}+3>0.\n$$\n\nNow, we consider the corresponding parabola given by $\\,y=5{x}^{2}+3.$ :\n\nSince the leading coefficient of $5{x}^{2}+3$   is positive, the parabola opens upward.  The desired inequality $(y>0)$ is always satisfied. Therefore, the solution set to the given inequality includes all real numbers. That is, $x\\in (-\\infty ,\\infty ).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/60aede2dc3b2823aecd1e808210f96ffe5c6430d09a391fe6f4cf0e88a96e786.png)" 13194139534639 true] [17592186300392 1000 #edb/ref 17592186300393 13194139534639 true] [17592186300392 1000 #edb/ref 17592186300394 13194139534639 true] [17592186300392 1000 #edb/ref 17592186300395 13194139534639 true] [17592186300392 1000 #edb/ref 17592186300396 13194139534639 true] [17592186300392 1000 #edb/ref 17592186300397 13194139534639 true] [17592186300392 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300392 1041 "selection" 13194139534639 true] [17592186300392 1104 #edb/ref 17592186300394 13194139534639 true] [17592186300392 1110 #uuid "32e0345a-740c-5edc-8f49-49e673b2a575" 13194139534639 true] [17592186300393 1034 "x\\in (-\\infty ,3)" 13194139534639 true] [17592186300393 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300393 1111 #uuid "aca1e56d-ee59-5b7a-be35-bccf02ecdf97" 13194139534639 true] [17592186300394 1034 "x\\in (-\\infty ,\\infty )" 13194139534639 true] [17592186300394 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300394 1111 #uuid "3483b3b3-a6fb-5360-8b7e-3db060ba886a" 13194139534639 true] [17592186300395 1034 "x\\in (-3,\\infty )" 13194139534639 true] [17592186300395 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300395 1111 #uuid "37089f06-3f3c-5a91-b62a-8de93e8a3a42" 13194139534639 true] [17592186300396 1034 "x\\in (3,\\infty )" 13194139534639 true] [17592186300396 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300396 1111 #uuid "4d79c1a2-bcc2-5cfe-b0ac-d63f79ee0c35" 13194139534639 true] [17592186300397 1034 "x\\in (-3,3)" 13194139534639 true] [17592186300397 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300397 1111 #uuid "a575248d-4c67-5b5a-83f2-8428b939a6b0" 13194139534639 true] [17592186300398 1017 #edb/ref 17592186300399 13194139534639 true] [17592186300398 1017 #edb/ref 17592186300402 13194139534639 true] [17592186300398 1017 #edb/ref 17592186300404 13194139534639 true] [17592186300398 1017 #edb/ref 17592186300406 13194139534639 true] [17592186300398 1089 "q-270802" 13194139534639 true] [17592186300398 1091 #edb/ref 17592186045463 13194139534639 true] [17592186300398 1100 "Solve the inequality  ${x}^{2}\\ge 100$ using a graphical method.\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$]⋃[$\n{{field-3}}$,$\n{{field-4}}$)$" 13194139534639 true] [17592186300398 1113 #uuid "be492f2f-d082-56fd-b292-3d12cc939d88" 13194139534639 true] [17592186300398 1145 "Bringing all the terms to the left-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 100 \\\\ {x}^{2}-100 & \\ge 0.\\end{aligned}\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-100\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-100 & =0 \\\\ {x}^{2}-{10}^{2} & =0 \\\\ (x-10)(x+10) & =0\\end{aligned}\n$$\n\nSo the roots are $x=\\pm 10.$ \n\nSolving the inequality ${x}^{2}-100\\ge 0$ is equivalent to finding the values of $x$ for which the parabola $y={x}^{2}-100$ is above or intersects the $x$-axis (where $y\\ge 0$).\n\nSince the leading coefficient of the quadratic expression is positive, the parabola opens upward. Therefore, the solution set lies outside the roots (including them), as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/6a6fe4b8f332bd821f27868586685f52d0dbcf326984ad683a27f41d5da473a4.png)\n\nTherefore, the solution is \n\n$$\nx\\in (-\\infty ,-10]\\cup [10,\\infty ).\n$$" 13194139534639 true] [17592186300399 1000 #edb/ref 17592186300400 13194139534639 true] [17592186300399 1000 #edb/ref 17592186300401 13194139534639 true] [17592186300399 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300399 1041 "field-1" 13194139534639 true] [17592186300399 1104 #edb/ref 17592186300401 13194139534639 true] [17592186300399 1110 #uuid "ab47d77f-336c-5794-8d02-ef85a54d6443" 13194139534639 true] [17592186300400 1034 "0" 13194139534639 true] [17592186300400 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300400 1111 #uuid "e4430696-ad25-5213-a88a-0e1b1b2f91f7" 13194139534639 true] [17592186300401 1034 "-\\infty" 13194139534639 true] [17592186300401 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300401 1111 #uuid "25ebbe71-3d24-5b24-9859-ef0bda7f894b" 13194139534639 true] [17592186300402 1000 #edb/ref 17592186300403 13194139534639 true] [17592186300402 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300402 1041 "field-2" 13194139534639 true] [17592186300402 1104 #edb/ref 17592186300403 13194139534639 true] [17592186300402 1110 #uuid "f2613879-f4ee-5259-b662-0134cadbfeab" 13194139534639 true] [17592186300403 1034 "-10" 13194139534639 true] [17592186300403 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300403 1111 #uuid "df4e43f8-2628-5ddb-8e8a-29e45ce2f07c" 13194139534639 true] [17592186300404 1000 #edb/ref 17592186300405 13194139534639 true] [17592186300404 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300404 1041 "field-3" 13194139534639 true] [17592186300404 1104 #edb/ref 17592186300405 13194139534639 true] [17592186300404 1110 #uuid "714c8b96-cdf6-5fa0-ba62-751066077fbc" 13194139534639 true] [17592186300405 1034 "10" 13194139534639 true] [17592186300405 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300405 1111 #uuid "78f75a87-ff44-573e-b272-b466987046e9" 13194139534639 true] [17592186300406 1000 #edb/ref 17592186300407 13194139534639 true] [17592186300406 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300406 1041 "field-4" 13194139534639 true] [17592186300406 1104 #edb/ref 17592186300407 13194139534639 true] [17592186300406 1110 #uuid "5753e6f7-5eb7-5289-8126-26f60868ad28" 13194139534639 true] [17592186300407 1034 "\\infty" 13194139534639 true] [17592186300407 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300407 1111 #uuid "b9a3140d-507b-5c8a-a77b-fa005351315b" 13194139534639 true] [17592186300408 1017 #edb/ref 17592186300409 13194139534639 true] [17592186300408 1017 #edb/ref 17592186300411 13194139534639 true] [17592186300408 1089 "q-270805" 13194139534639 true] [17592186300408 1091 #edb/ref 17592186045463 13194139534639 true] [17592186300408 1100 "Solve the inequality ${x}^{2}<10$ using the absolute value method.\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$)$" 13194139534639 true] [17592186300408 1113 #uuid "f7b91866-13b5-5b87-be28-a7cf28427c3a" 13194139534639 true] [17592186300408 1145 "Taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & <10 \\\\ \\sqrt{{x}^{2}} & <\\sqrt{10} \\\\ |x| & <\\sqrt{10}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\n-\\sqrt{10}<x<\\sqrt{10}.\n$$\n\nTherefore the solution is $x\\in (-\\sqrt{10},\\sqrt{10}).$" 13194139534639 true] [17592186300409 1000 #edb/ref 17592186300410 13194139534639 true] [17592186300409 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300409 1041 "field-1" 13194139534639 true] [17592186300409 1104 #edb/ref 17592186300410 13194139534639 true] [17592186300409 1110 #uuid "75b06e58-a1b5-5be0-9df8-79e7d9948a58" 13194139534639 true] [17592186300410 1034 "-\\sqrt{10}" 13194139534639 true] [17592186300410 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300410 1111 #uuid "e79564f6-d3ee-5e2d-945a-870ae96c1e01" 13194139534639 true] [17592186300411 1000 #edb/ref 17592186300412 13194139534639 true] [17592186300411 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300411 1041 "field-2" 13194139534639 true] [17592186300411 1104 #edb/ref 17592186300412 13194139534639 true] [17592186300411 1110 #uuid "133596ad-1230-5238-a162-8929da58e6d5" 13194139534639 true] [17592186300412 1034 "\\sqrt{10}" 13194139534639 true] [17592186300412 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300412 1111 #uuid "63d0e367-26cb-5b4b-8064-2650ecc10ee9" 13194139534639 true] [17592186300413 1017 #edb/ref 17592186300414 13194139534639 true] [17592186300413 1017 #edb/ref 17592186300417 13194139534639 true] [17592186300413 1089 "q-270994" 13194139534639 true] [17592186300413 1091 #edb/ref 17592186045464 13194139534639 true] [17592186300413 1100 "Solve the inequality $2{x}^{2}-x\\le 3{x}^{2}-x+4.$\n\n$x\\in $\n$($\n{{field-1}}$,$\n{{field-2}}$)$" 13194139534639 true] [17592186300413 1113 #uuid "509bec76-14cd-596b-ae92-50121191e32a" 13194139534639 true] [17592186300413 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}2{x}^{2}-x & \\le 3{x}^{2}-x+4 \\\\ 2{x}^{2}-x+x & \\le 3{x}^{2}-x+4+x \\\\ 2{x}^{2} & \\le 3{x}^{2}+4 \\\\ 2{x}^{2}-3{x}^{2} & \\le 4 \\\\ -{x}^{2} & \\le 4 \\\\ {x}^{2} & \\ge -4\\end{aligned}\n$$\n\nNote that we had to flip the sign of the inequality since we divided by a negative number.\n\nNow, we can use either of the two methods to solve the inequality.\n\n**Method 1 - Solving an Absolute Value Equation**\n\nWe know that the square of *any* real number is greater than or equal to zero.\n\nSo, the inequality is true for every real number. Therefore the solution is $x\\in (-\\infty ,\\infty ).$ \n\n**Method 2 - Picturing a Quadratic Curve**\n\nStarting from $-{x}^{2}\\le 4$ and moving all terms to the left-hand side, we reach\n\n$$\n-{x}^{2}-4\\le 0.\n$$\n\nNow, we consider the corresponding parabola given by $y=-{x}^{2}-4.$\n\nSince the leading coefficient of $-{x}^{2}-4$ is negative, the parabola opens downward (like $⌢$). The desired inequality $(y\\le 0)$ is always satisfied. Therefore, the solution set to the given inequality includes all real numbers. That is, $x\\in (-\\infty ,\\infty ).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/b4b3672503fb5d0a4c7aa500793612c6cf8aed9a24101c3d659c1e80fe051511.png)" 13194139534639 true] [17592186300414 1000 #edb/ref 17592186300415 13194139534639 true] [17592186300414 1000 #edb/ref 17592186300416 13194139534639 true] [17592186300414 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300414 1041 "field-1" 13194139534639 true] [17592186300414 1104 #edb/ref 17592186300416 13194139534639 true] [17592186300414 1110 #uuid "40c1f5a7-aaae-5573-8085-9f399c9f75d3" 13194139534639 true] [17592186300415 1034 "-4" 13194139534639 true] [17592186300415 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300415 1111 #uuid "3dffd679-783d-596d-bbdc-06486be251e5" 13194139534639 true] [17592186300416 1034 "-\\infty" 13194139534639 true] [17592186300416 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300416 1111 #uuid "495acebc-074b-5939-8012-479e1606ba95" 13194139534639 true] [17592186300417 1000 #edb/ref 17592186300418 13194139534639 true] [17592186300417 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300417 1041 "field-2" 13194139534639 true] [17592186300417 1104 #edb/ref 17592186300418 13194139534639 true] [17592186300417 1110 #uuid "5d039344-49db-5a1a-a193-69015a25c9b5" 13194139534639 true] [17592186300418 1034 "\\infty" 13194139534639 true] [17592186300418 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300418 1111 #uuid "44883ef0-bb5f-5ba9-814a-cc8e10a9d684" 13194139534639 true] [17592186300419 1017 #edb/ref 17592186300420 13194139534639 true] [17592186300419 1017 #edb/ref 17592186300422 13194139534639 true] [17592186300419 1017 #edb/ref 17592186300424 13194139534639 true] [17592186300419 1017 #edb/ref 17592186300426 13194139534639 true] [17592186300419 1089 "q-278108" 13194139534639 true] [17592186300419 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300419 1100 "Solve the inequality ${x}^{2}-11\\ge 0$ using the absolute value method.\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$]⋃[$\n{{field-3}}$,$\n{{field-4}}$)$" 13194139534639 true] [17592186300419 1113 #uuid "77633d5b-6138-5a2c-b4e6-32f0304f94a0" 13194139534639 true] [17592186300419 1145 "Bringing the constant term to the right-hand side, we have\n\n$$\n\\begin{aligned}{x}^{2}-11 & \\ge 0 \\\\ {x}^{2} & \\ge 11.\\end{aligned}\n$$\n\nThen, taking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 11 \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{11} \\\\ |x| & \\ge \\sqrt{11}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have\n\n$$\nx\\le -\\sqrt{11}\\,\\text{or}\\,x\\ge \\sqrt{11}.\n$$\n\nTherefore the solution is $x\\in (-\\infty ,-\\sqrt{11}]\\cup [\\sqrt{11},\\infty ).$" 13194139534639 true] [17592186300420 1000 #edb/ref 17592186300421 13194139534639 true] [17592186300420 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300420 1041 "field-1" 13194139534639 true] [17592186300420 1104 #edb/ref 17592186300421 13194139534639 true] [17592186300420 1110 #uuid "7d5a71b7-6d67-58ca-83c2-b0f61544d174" 13194139534639 true] [17592186300421 1034 "-\\infty" 13194139534639 true] [17592186300421 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300421 1111 #uuid "b083df10-288b-5cbc-893a-533780f980ca" 13194139534639 true] [17592186300422 1000 #edb/ref 17592186300423 13194139534639 true] [17592186300422 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300422 1041 "field-2" 13194139534639 true] [17592186300422 1104 #edb/ref 17592186300423 13194139534639 true] [17592186300422 1110 #uuid "3df62407-e5e4-520a-94a2-c06b81192a1a" 13194139534639 true] [17592186300423 1034 "-\\sqrt{11}" 13194139534639 true] [17592186300423 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300423 1111 #uuid "4848f0cd-0f46-5267-8318-421ae2931bf9" 13194139534639 true] [17592186300424 1000 #edb/ref 17592186300425 13194139534639 true] [17592186300424 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300424 1041 "field-3" 13194139534639 true] [17592186300424 1104 #edb/ref 17592186300425 13194139534639 true] [17592186300424 1110 #uuid "489f77c2-c5d3-5095-801b-687b369e58fd" 13194139534639 true] [17592186300425 1034 "\\sqrt{11}" 13194139534639 true] [17592186300425 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300425 1111 #uuid "555d03bf-520d-5106-a611-2b2c3aa056dd" 13194139534639 true] [17592186300426 1000 #edb/ref 17592186300427 13194139534639 true] [17592186300426 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300426 1041 "field-4" 13194139534639 true] [17592186300426 1104 #edb/ref 17592186300427 13194139534639 true] [17592186300426 1110 #uuid "2467816f-434a-5026-a460-a4feccf10649" 13194139534639 true] [17592186300427 1034 "\\infty" 13194139534639 true] [17592186300427 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300427 1111 #uuid "c3e99bb9-f311-55e4-aed7-f96cf21b1ab1" 13194139534639 true] [17592186300428 1017 #edb/ref 17592186300429 13194139534639 true] [17592186300428 1017 #edb/ref 17592186300431 13194139534639 true] [17592186300428 1017 #edb/ref 17592186300433 13194139534639 true] [17592186300428 1017 #edb/ref 17592186300435 13194139534639 true] [17592186300428 1089 "q-278137" 13194139534639 true] [17592186300428 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300428 1100 "Solve $36{x}^{2}>49.$\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$)⋃($\n{{field-3}}$,$\n{{field-4}}$)$" 13194139534639 true] [17592186300428 1113 #uuid "04fd2894-e4fd-541e-8536-3ad70f3181ef" 13194139534639 true] [17592186300428 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}36{x}^{2} & >49 \\\\ {x}^{2} & >\\frac{49}{36}\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n*Method 1 - Solving an Absolute Value Equation*\n\nTaking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & >\\sqrt{\\frac{49}{36}} \\\\ |x| & >\\frac{7}{6}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have \n\n$$\nx<-\\frac{7}{6}\\,\\text{or}\\,x>\\frac{7}{6}.\n$$\n\nSo, the solution is $x\\in (-\\infty ,-\\frac{7}{6})\\cup (\\frac{7}{6},+\\infty ).$\n\n*Method 2 - Picturing a Quadratic Curve*\n\nStarting from ${x}^{2}>\\frac{49}{36}$ and moving all terms to the left-hand side, we reach\n\n$$\n{x}^{2}-\\frac{49}{36}>0.\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-\\frac{49}{36}\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{49}{36} & =0 \\\\ {x}^{2}-{(\\frac{7}{6})}^{2} & =0 \\\\ (x-\\frac{7}{6})(x+\\frac{7}{6}) & =0,\\end{aligned}\n$$\n\nso the roots are  $x=\\pm \\frac{7}{6}.$ \n\nSince the leading coefficient of ${x}^{2}-\\frac{49}{36}$   is positive, the parabola opens upward. Hence, the solution set to the given inequality ($y>0$) lies outside the roots and does not include them:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/14702e7d185d38587cf10642c8a455d9d25a51d2a8eebbf7e0e54a79223ea56e.png)\n\n \n\nTherefore, the solution is \n\n$$\nx\\in (-\\infty ,-\\frac{7}{6})\\cup (\\frac{7}{6},\\infty ).\n$$" 13194139534639 true] [17592186300429 1000 #edb/ref 17592186300430 13194139534639 true] [17592186300429 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300429 1041 "field-1" 13194139534639 true] [17592186300429 1104 #edb/ref 17592186300430 13194139534639 true] [17592186300429 1110 #uuid "67d7d68d-92a8-59c5-9025-0