39 true] [17592186300437 1017 #edb/ref 17592186300443 13194139534639 true] [17592186300437 1017 #edb/ref 17592186300445 13194139534639 true] [17592186300437 1089 "q-278199" 13194139534639 true] [17592186300437 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300437 1100 "Solve $\\frac{{x}^{2}}{6}-2\\ge 1.$\n\n$x\\in ($\n{{field-1}}$,$\n{{field-2}}$]⋃[$\n{{field-3}}$,$\n{{field-4}}$)$" 13194139534639 true] [17592186300437 1113 #uuid "da37f6a6-e2c2-5ef5-99e3-d2a287d64c98" 13194139534639 true] [17592186300437 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}-2 & \\ge 1 \\\\ \\frac{{x}^{2}}{6} & \\ge 1+2 \\\\ \\frac{{x}^{2}}{6} & \\ge 3 \\\\ {x}^{2} & \\ge 18\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n*Method 1 - Solving an Absolute Value Equation*\n\nTaking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & \\ge \\sqrt{18} \\\\ |x| & \\ge 3\\sqrt{2}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have \n\n$$\nx\\le -3\\sqrt{2}\\,\\text{or}\\,x\\ge 3\\sqrt{2}.\n$$\n\nSo, the solution set is $x\\in (-\\infty ,-3\\sqrt{2}]\\cup [3\\sqrt{2},\\infty ).$\n\n*Method 2 - Picturing a Quadratic Curve*\n\nStarting from ${x}^{2}\\ge 18$ and moving all terms to the left-hand side, we reach\n\n$$\n{x}^{2}-18\\ge 0.\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-18\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-18 & =0 \\\\ {x}^{2}-{(\\sqrt{18})}^{2} & =0 \\\\ {x}^{2}-{(3\\sqrt{2})}^{2} & =0 \\\\ (x-3\\sqrt{2})(x+3\\sqrt{2}) & =0,\\end{aligned}\n$$\n\nhence $x=\\pm 3\\sqrt{2}.$\n\nSince the leading coefficient of ${x}^{2}-18$   is positive, the parabola  opens upward.  Therefore, the solution set to the  given inequality ($y\\ge 0$) lies outside the roots (and  includes them):\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/72488926dd64954e2c1070a94625ebc91c1c729d70bbf7c5f098364e651efec5.png)\n\nTherefore, the solution is \n\n$$\nx\\in (-\\infty ,-3\\sqrt{2}]\\cup [3\\sqrt{2},\\infty ).\n$$" 13194139534639 true] [17592186300438 1000 #edb/ref 17592186300439 13194139534639 true] [17592186300438 1000 #edb/ref 17592186300440 13194139534639 true] [17592186300438 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300438 1041 "field-1" 13194139534639 true] [17592186300438 1104 #edb/ref 17592186300440 13194139534639 true] [17592186300438 1110 #uuid "eeef6edd-d744-57a9-8487-7b1dd09aa6ba" 13194139534639 true] [17592186300439 1034 "0" 13194139534639 true] [17592186300439 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300439 1111 #uuid "d71f6382-3c2a-53f9-bdb3-d6c66141279d" 13194139534639 true] [17592186300440 1034 "-\\infty" 13194139534639 true] [17592186300440 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300440 1111 #uuid "5830a69d-fe8a-5b43-ab85-692d78c1f8d4" 13194139534639 true] [17592186300441 1000 #edb/ref 17592186300442 13194139534639 true] [17592186300441 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300441 1041 "field-2" 13194139534639 true] [17592186300441 1104 #edb/ref 17592186300442 13194139534639 true] [17592186300441 1110 #uuid "5e389463-e61d-543b-9178-85764571dab1" 13194139534639 true] [17592186300442 1034 "-3\\sqrt{2}" 13194139534639 true] [17592186300442 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300442 1111 #uuid "4f59d0b3-8467-5b70-a31e-f9a0d616a294" 13194139534639 true] [17592186300443 1000 #edb/ref 17592186300444 13194139534639 true] [17592186300443 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300443 1041 "field-3" 13194139534639 true] [17592186300443 1104 #edb/ref 17592186300444 13194139534639 true] [17592186300443 1110 #uuid "243fff3e-45b1-5ef1-8e30-3778287df5bc" 13194139534639 true] [17592186300444 1034 "3\\sqrt{2}" 13194139534639 true] [17592186300444 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300444 1111 #uuid "bc345ac3-c176-582b-9009-fa176590150b" 13194139534639 true] [17592186300445 1000 #edb/ref 17592186300446 13194139534639 true] [17592186300445 1040 #edb/ref 17592186045449 13194139534639 true] [17592186300445 1041 "field-4" 13194139534639 true] [17592186300445 1104 #edb/ref 17592186300446 13194139534639 true] [17592186300445 1110 #uuid "372905fb-788f-5a74-ba75-bf6df780217b" 13194139534639 true] [17592186300446 1034 "\\infty" 13194139534639 true] [17592186300446 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300446 1111 #uuid "b9ffc771-84db-5e96-9cb3-bfaa4031c63d" 13194139534639 true] [17592186300447 1017 #edb/ref 17592186300448 13194139534639 true] [17592186300447 1089 "q-30827" 13194139534639 true] [17592186300447 1091 #edb/ref 17592186045464 13194139534639 true] [17592186300447 1100 "Solve the inequality $3{x}^{2}+x>x-2.$" 13194139534639 true] [17592186300447 1113 #uuid "96a12746-5071-58cb-bbb8-c09780644799" 13194139534639 true] [17592186300447 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}3{x}^{2}+x & >x-2 \\\\ 3{x}^{2}+x-x & >x-2-x \\\\ 3{x}^{2} & >-2.\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n**Method 1 - Solving an Absolute Value Inequality**\n\nWe know that the square of *any* real number is greater than or equal to zero.\n\nSo, the inequality is true for every real number. Therefore the solution is $x\\in (-\\infty ,\\infty ).$ \n\n**Method 2 - Picturing a Quadratic Curve**\n\nStarting from $3{x}^{2}>-2$ and moving all terms to the left-hand side, we reach\n\n$$\n3{x}^{2}+2>0.\n$$\n\nNow, we consider the corresponding parabola given by $\\,y=3{x}^{2}+2.$ :\n\nSince the leading coefficient of $3{x}^{2}+2$   is positive, the parabola opens upward.  The desired inequality $(y>0)$ is always satisfied. Therefore, the solution set to the given inequality includes all real numbers. That is, $x\\in (-\\infty ,\\infty ).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/39e923bcf71c650441cbe39bd173056a008e5926679271109df479ca76bd8294.png)" 13194139534639 true] [17592186300448 1000 #edb/ref 17592186300449 13194139534639 true] [17592186300448 1000 #edb/ref 17592186300450 13194139534639 true] [17592186300448 1000 #edb/ref 17592186300451 13194139534639 true] [17592186300448 1000 #edb/ref 17592186300452 13194139534639 true] [17592186300448 1000 #edb/ref 17592186300453 13194139534639 true] [17592186300448 1040 #edb/ref 17592186045450 13194139534639 true] [17592186300448 1041 "selection" 13194139534639 true] [17592186300448 1104 #edb/ref 17592186300449 13194139534639 true] [17592186300448 1110 #uuid "4e102a8d-ee24-566b-a7e2-dc0791602f36" 13194139534639 true] [17592186300449 1034 "x\\in (-\\infty ,\\infty )" 13194139534639 true] [17592186300449 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300449 1111 #uuid "fe9acd09-8947-5304-9182-55d7e29ad5fa" 13194139534639 true] [17592186300450 1034 "\\,x\\in (-\\infty ,1)" 13194139534639 true] [17592186300450 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300450 1111 #uuid "c566bcd4-8f52-5aa5-97b7-15d729843538" 13194139534639 true] [17592186300451 1034 "\\,x\\in (-\\infty ,-2)\\cup (2,\\infty )" 13194139534639 true] [17592186300451 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300451 1111 #uuid "62141f36-c0c4-5fda-ade4-aeaa55695ba5" 13194139534639 true] [17592186300452 1034 "\\,x\\in (-1,1)" 13194139534639 true] [17592186300452 1103 #edb/ref 17592186045453 13194139534639 true] [17592186300452 1111 #uuid "b42cfbde-7496-5533-91ac-5810d2d6b47f" 13194139534639 true] [17592186300453 1034 "There is no solution" 13194139534639 true] [17592186300453 1103 #edb/ref 17592186045454 13194139534639 true] [17592186300453 1111 #uuid "dd522ba9-9b55-52db-bd86-28e3521fe30a" 13194139534639 true] [17592186300454 1017 #edb/ref 17592186300455 13194139534639 true] [17592186300454 1089 "q-30851" 13194139534639 true] [17592186300454 1091 #edb/ref 17592186045465 13194139534639 true] [17592186300454 1100 "Solve $5{x}^{2}-16>9.$" 13194139534639 true] [17592186300454 1113 #uuid "911736f1-6339-5260-a100-4387523cb012" 13194139534639 true] [17592186300454 1145 "First, let's simplify the inequality:\n\n$$\n\\begin{aligned}5{x}^{2}-16 & >9 \\\\ 5{x}^{2} & >9+16 \\\\ 5{x}^{2} & >25 \\\\ {x}^{2} & >5\\end{aligned}\n$$\n\nNow, we can use either of two methods to solve the inequality.\n\n*Method 1 - Solving an Absolute Value Equation*\n\nTaking the square root of both sides of the inequality, we get\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}} & >\\sqrt{5} \\\\ |x| & >\\sqrt{5}.\\end{aligned}\n$$\n\nNow, using the definition of absolute value, we must have \n\n$$\nx<-\\sqrt{5}\\,\\text{or}\\,x>\\sqrt{5}.\n$$\n\nSo, the solution is $x\\in (-\\infty ,-\\sqrt{5})\\cup (\\sqrt{5},+\\infty ).$\n\n*Method 2 - Picturing a Quadratic Curve*\n\nStarting from ${x}^{2}>5$ and moving all terms to the left-hand side, we reach\n\n$$\n{x}^{2}-5>0.\n$$\n\nNow, we consider the corresponding parabola given by $\\,y={x}^{2}-5\\,$ and find its roots:\n\n$$\n\\begin{aligned}{x}^{2}-5 & >0 \\\\ {x}^{2}-{(\\sqrt{5})}^{2} & =0 \\\\ (x-\\sqrt{5})(x+\\sqrt{5}) & =0,\\end{aligned}\n$$\n\nhence $x=\\pm \\sqrt{5}.$\n\nSince the leading coefficient of ${x}^{2}-5$   is positive, the parabola  opens upward.  Therefore, the solution set to the  given inequality ($y>0$) lies outside the roots (but does not include them):\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13965374/assets/52b970419b3dbb9498e6b7b05d031195b1e8fae9bdba0428dd72f84f0101095b.png)\n\n \n\nTherefore, the solution is $x\\in (-\\infty ,-\\sqrt{5})\\cup (\\sqrt{5},\\infty ).$" 13194139534639 true] [17592186300455 1000 #edb/ref 17592186300456 13194139534639 true] [17592186300455 1000 #edb/ref 17592186300457 13194139534639 true] [17592186300455 1000 #edb/ref 17592186300458 13194139534639 true] [17592186300455 1000 #edb/ref 17592186300459 13194139534639 true] [17