658/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198"] :db/ensure [:answer-field/validate]} {:db/id "q-117658" :question/id #uuid "01426a8e-7412-5606-9f96-998be83dbedb" :question/math-academy-id "q-117658" :question/problem "Calculate the period of the function $f(x)=\\operatorname{cot}⁡(\\frac{9x+2\\pi }{3})+4.$" :question/worked-solution "Given a function of the form $y=A\\operatorname{cot}⁡(Bx+C)+D,$ the period is $\\frac{\\pi }{B}.$\n\nIn our case, we have that\n\n$$\nf(x)=\\operatorname{cot}⁡(\\frac{9x+2\\pi }{3})+4=\\operatorname{cot}⁡(3x+\\frac{2\\pi }{3})+4.\n$$\n\nTherefore, $B=3,$ and so the period is $\\frac{\\pi }{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-117658/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6506f7e3-4c69-5352-a09d-262adee65e59"] :knowledge-point/questions ["q-117658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81541/selection/0dd6da98400cc89eac36ae79dcd4c4c8e9cf7e1ffcb58b5827820d38e236f99c" :answer/id #uuid "f68b1cd8-6067-5501-8f92-6cee562d84c1" :answer/type :answer.type/math :answer/value "\\frac{13\\pi }{12}" :db/ensure [:answer/validate]} {:db/id "q-81541/selection/9f3c5525e8594cb69619627b8e14363bd3a225d4c6b1fa2067a7b3dd5aab24b5" :answer/id #uuid "b3257ece-7489-56f0-9b5d-291aa3413a81" :answer/type :answer.type/math :answer/value "7\\pi " :db/ensure [:answer/validate]} {:db/id "q-81541/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "3994d247-73bc-5405-81eb-1234ebd380b0" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-81541/selection/0fb978d2b1ce374ae0f1700c585078833e85991af693baf7445a5e2dc6cdf6cc" :answer/id #uuid "c65b5e91-6eee-5d32-bf29-b51a2eb4676c" :answer/type :answer.type/math :answer/value "12\\pi " :db/ensure [:answer/validate]} {:db/id "q-81541/selection/cd8957b3e03d9fbea87893281373eded912abde9aae6462917a9ce8659b8c