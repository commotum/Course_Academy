 with $(3x+\\frac{\\pi }{6}).$ This gives\n\n$$\n3x+\\frac{\\pi }{6}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}3x+\\frac{\\pi }{6} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ 3x & \\ne \\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{6} \\\\ 3x & \\ne \\frac{\\pi }{3}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{3\\cdot 3}+\\frac{n\\pi }{3} \\\\ x & \\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3},$ where $n$ is an integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-41106/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b"] :knowledge-point/questions ["q-41106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-26245/selection/ed779d8fb63d0a0425503eb8f6b37d1e44c1da227fcf4ed80df0c8491b6421db" :answer/id #uuid "0313897b-d082-5b0a-8473-054e34aaa182" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{5}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26245/selection/55f45a84daa016c88f9d7fe6211e622004a391efcd9c497e4b3727906763dec9" :answer/id #uuid "be6ad5dc-720e-5d6b-9b5d-67d1945dcd6d" :answer/type :answer.type/math :answer/value "x\\ne \\frac{5\\pi }{6}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26245/selection/26e497ea71e752e8b2ffe217aa85dd111710a0dda019ce17c07e633a8867d828" :answer/id #uuid "f91fa18f-cc26-5f7f-af1c-81c044da4cfb" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{6}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26245/selection/f3dc2fa4dfc3e9dd9b21f87aded6abdea4b3b955fa60a61eed07d2c95dadaacd" :answer/id #uuid "2180389c-16c2-53b5-844f-614c25473c4d" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{6}+5n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26245/selection/e9ff8160e3f880a764fdc182fd5ee261f64ddb0533559e2c36a9baf11358c63a" :answer/id #uuid "7dfbb267-6c68-53fd-93d4-9a2c6abf6316" :answer/type :answer.type/math :answer/value "x\\ne \\frac{2\\pi }{3}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26245/selection" :answer-field/id #uuid "6647242e-d797-5eb9-9052-6f11d43d49ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-26245/selection/55f45a84daa016c88f9d7fe6211e622004a391efcd9c497e4b3727906763dec9" :answer-field/choices ["q-26245/selection/ed779d8fb63d0a0425503eb8f6b37d1e44c1da227fcf4ed80df0c8491b6421db" "q-26245/selection/55f45a84daa016c88f9d7fe6211e622004a391efcd9c497e4b3727906763dec9" "q-26245/selection/26e497ea71e752e8b2ffe217aa85dd111710a0dda019ce17c07e633a8867d828" "q-26245/selection/f3dc2fa4dfc3e9dd9b21f87aded6abdea4b3b955fa60a61eed07d2c95dadaacd" "q-26245/selection/e9ff8160e3f880a764fdc182fd5ee261f64ddb0533559e2c36a9baf11358c63a"] :db/ensure [:answer-field/validate]} {:db/id "q-26245" :question/id #uuid "c7bb983e-87e4-57d6-84cd-bfae99f753e0" :question/math-academy-id "q-26245" :question/problem "What is the domain of the function $f(x)=3\\operatorname{tan}⁡(x-\\frac{\\pi }{3})-1?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $3\\operatorname{tan}⁡(x-\\frac{\\pi }{3})-1,$ we replace the $x$ on the left-hand side of the above with $(x-\\frac{\\pi }{3}).$ This gives\n\n$$\nx-\\frac{\\pi }{3}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{3} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{2}+n\\pi +\\frac{\\pi }{3} \\\\ x & \\ne \\frac{5\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{5\\pi }{6}+n\\pi ,$ where $n$ is an integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-26245/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b"] :knowledge-point/questions ["q-26245"] :db/ensure [:knowledge-point/validate]} {:db/id "q-26063/selection/2a344dfad6d5762af74df5fa6e6bea67a0fef1e4e0d6957fdc80b403353fc08b" :answer/id #uuid "9b4a323a-189d-5e8e-857e-5656b2bb2133" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{8}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-26063/selection/632078ea860c4a59d10874990c020cb47ab125a7426c6aad140dca40dd73015c" :answer/id #uuid "1f17f0d9-18a6-599b-8bdb-22f4798695b8" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-26063/selection/59199bfc0d208cb29480be1deefe63ed640c7ef86da6c8f71f9da4da33871876" :answer/id #uuid "90725073-791b-5b91-9393-e3fa206d7074" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-26063/selection/db8717a5a775c12141716bff8fc2fa5b2b685890bd948d9ce28164dc31a96214" :answer/id #uuid "b4011db1-95d9-5af6-ae58-1bdde7f1d011" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-26063/selection/85119b326425ecbbd0eb28f7feef67cb699f2478c3e0696071e24737c3c91c65" :answer/id #uuid "19af612d-31ff-58de-a128-6f4d38f95bee" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-26063/selection" :answer-field/id #uuid "3855cdbd-e3f4-5825-87e0-b7c46ca54a6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-26063/selection/632078ea860c4a59d10874990c020cb47ab125a7426c6aad140dca40dd73015c" :answer-field/choices ["q-26063/selection/2a344dfad6d5762af74df5fa6e6bea67a0fef1e4e0d6957fdc80b403353fc08b" "q-26063/selection/632078ea860c4a59d10874990c020cb47ab125a7426c6aad140dca40dd73015c" "q-26063/selection/59199bfc0d208cb29480be1deefe63ed640c7ef86da6c8f71f9da4da33871876" "q-26063/selection/db8717a5a775c12141716bff8fc2fa5b2b685890bd948d9ce28164dc31a96214" "q-26063/selection/85119b326425ecbbd0eb28f7feef67cb699f2478c3e0696071e24737c3c91c65"] :db/ensure [:answer-field/validate]} {:db/id "q-26063" :question/id #uuid "9d6d6740-e5dd-5281-92d1-875d6a4f4564" :question/math-academy-id "q-26063" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(2x)?$  Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{2\\cdot 2}+\\frac{n\\pi }{2} \\\\ x & \\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2},$ where $n$ is an integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-26063/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b"] :knowledge-point/questions ["q-26063"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117708/selection/17ba5dc00ea31df859767063bbffd9a60d49068967b89df3892a8f3bdee21511" :answer/id #uuid "590c090f-f1db-50c4-a7ba-9fb1e893b63b" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{10}+\\frac{n\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-117708/selection/978336735a3a0bfac081c99c2902250424f0d417f0cbed76714e19d6d48ed47c" :answer/id #uuid "8d6142be-1b3a-5b3f-9623-57292bac7905" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{5}+\\frac{n\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-117708/selection/8611e3d093f017cac5aa5e977e26a2d9dd8447839ed97bc0e64ed2332e2770a6" :answer/id #uuid "d2d76b06-2577-59d3-89a