ac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114033" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/activity-metadata.json" "file_sha256" "dbf7756ee853b4dbb832c291311a9f74ffe3d70df412d896f974cff1a0b78c4d"} {"question" "q-114033" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114033" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arctan}⁡(6x)+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(x)+C"] ["math" "\\operatorname{arctan}⁡(\\frac{x}{6})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114033" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114055" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{7}{|x|\\sqrt{7{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114055" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{7}{|x|\\sqrt{7{x}^{2}-1}}\\text{d}x=\\int \\frac{7\\sqrt{7}}{|\\sqrt{7}x|\\sqrt{(\\sqrt{7}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{7}x.$\n\nSo, let's substitute $u=\\sqrt{7}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{7}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{7}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{7}{|x|\\sqrt{7{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{7\\sqrt{7}}{|\\sqrt{7}x|\\sqrt{(\\sqrt{7}x)^{2}-1}}\\,\\text{d}x \\\\  & =7\\sqrt{7}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{7}}\\text{d}u) \\\\  & =7\\sqrt{7}\\cdot \\frac{1}{\\sqrt{7}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =7\\,\\text{arcsec }u+C \\\\  & =7\\,\\text{arcsec}(\\sqrt{7}x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114055" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/activity-metadata.json" "file_sha256" "dbf7756ee853b4dbb832c291311a9f74ffe3d70df412d896f974cff1a0b78c4d"} {"question" "q-114055" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114055" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "7\\,\\text{arcsec}(\\sqrt{7}x)+C"] ["math" "7\\sqrt{7}\\,\\text{arcsec}(x)+C"] ["math" "\\frac{\\sqrt{7}}{7}\\,\\text{arcsec}(x)+C"] ["math" "\\text{arcsec}(7x)+C"] ["math" "\\text{arcsec}(\\sqrt{7}x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114055" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "7\\,\\text{arcsec}(\\sqrt{7}x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114080" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114080" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =8{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{2}{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =8{\\int }_{0}^{\\sqrt{3}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =8\\operatorname{arcsin}⁡u{|}_{0}^{\\sqrt{3}/2} \\\\  & =8(\\operatorname{arcsin}⁡(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =8(\\frac{\\pi }{3}-0) \\\\  & =\\frac{8\\pi }{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/activity-metadata.json" "file_sha256" "dbf7756ee853b4dbb832c291311a9f74ffe3d70df412d896f974cff1a0b78c4d"} {"question" "q-114080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{3\\pi }{8}"] ["math" "\\frac{8\\pi }{3}"] ["math" "\\frac{\\pi }{24}"] ["math" "\\frac{\\pi }{3}"] ["math" "\\frac{\\pi }{8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{8\\pi }{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114084" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114084" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2}{3\\cdot (1+{x}^{2}/3)}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}/3}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{3}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{3}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{1}{1+{u}^{2}}\\cdot (\\sqrt{3}\\,\\text{d}u) \\\\  & =\\frac{2\\sqrt{3}}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{2\\sqrt{3}}{3}\\operatorname{arctan}⁡u{|}_{0}^{\\sqrt{3}/3} \\\\  & =\\frac{2\\sqrt{3}}{3}(\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{2\\sqrt{3}}{3}\\cdot \\frac{\\pi }{6} \\\\  & =\\frac{\\sqrt{3}\\pi }{9}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/activity-metadata.json" "file_sha256" "dbf7756ee853b4dbb832c291311a9f74ffe3d70df412d896f974cff1a0b78c4d"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043472/state.json" "file_sha256" "62cedba17ee9cd27695b48375206eb4673c108f56111dcb6e16396ef995fdc8d"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac