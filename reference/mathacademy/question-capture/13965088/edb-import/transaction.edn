[{:db/id "q-318971/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "52455008-c333-5dd1-92b4-72b4768f2da6" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-318971/field-1" :answer-field/id #uuid "ec7d6cad-97ac-539c-a22f-fd918e59492a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318971/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-318971/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-318971" :question/id #uuid "4153b8de-c0c0-52e9-920b-bb4a1839c543" :question/math-academy-id "q-318971" :question/problem "Suppose $|\\,r\\,|=10$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10cos\\,(\\frac{2\\pi }{3}) \\\\  & =10\\cdot (-\\frac{1}{2}) \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318971/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-318971"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318972/field-1/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer/id #uuid "fa8dbb88-2969-5131-a31e-dd00c5440218" :answer/type :answer.type/math :answer/value "4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-318972/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "352c4fde-cbb7-5dc1-b56c-ef7fa8aecda1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-318972/field