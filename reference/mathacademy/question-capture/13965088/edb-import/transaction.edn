582a4c98e6792e5edb3c1272d991dba7d5c92279"] :db/ensure [:answer-field/validate]} {:db/id "q-101522" :question/id #uuid "84ac2ad8-5a67-548f-ab6a-38acdfe05f91" :question/math-academy-id "q-101522" :question/problem "Suppose $|\\,a\\,|=14$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =14\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =14\\cdot (-\\frac{1}{2}) \\\\  & =-7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101522/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-101522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318975/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-318975/field-1" :answer-field/id #uuid "bc125a59-b82a-537c-bc27-b1603fec35b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318975/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-318975/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-318975" :question/id #uuid "e3cf13f3-399e-5099-a24e-b2d19fcea90e" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,(\\frac{3\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318975/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-318975"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19145/selection/687588ca7b84e0861c8e47cc927d6bd58f25e591daa0443ab63f5087863a7d63" :answer/id #uuid "a33123f7-9a37-569a-ac47-b45bdc9948ae" :answer/type :answer.type/math :answer/value "\\frac{55}{3}" :db/ensure [:answer/validate]} {:db/id "q-19145/selection/21b5586cb9bb6add9b1620730372fbf8e3cc60f9898680d61a22578168ae0761" :answer/id #uuid "1b1cfa43-26e5-5f53-823f-dd723015c0d0" :answer/type :answer.type/math :answer/value "\\frac{33}{15}" :db/ensure [:answer/validate]} {:db/id "q-19145/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b0e91dcf-8bcc-5fa3-a724-79c508b2a046" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-19145/selection/29dbcc992c814d082b14ceeadff429ebc2de9d24c76b74ca026ddc3e5a56e974" :answer/id #uuid "d8005650-709a-5618-9038-107980e97fd2" :answer/type :answer.type/math :answer/value "\\frac{22}{15}" :db/ensure [:answer/validate]} {:db/id "q-19145/selection/f16a27710af34987e5489c4c07d71675d5e9da9d5c533afd40931f036ab3d01f" :answer/id #uuid "dc3e1d8e-5771-5676-9a8e-e37fe8563517" :answer/type :answer.type/math :answer/value "\\frac{33}{5}" :db/ensure [:answer/validate]} {:db/id "q-19145/selection" :answer-field/id #uuid "db014cd0-5131-575e-a1ec-7a1de6de119e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19145/selection/29dbcc992c814d082b14ceeadff429ebc2de9d24c76b74ca026ddc3e5a56e974" :answer-field/choices ["q-19145/selection/687588ca7b84e0861c8e47cc927d6bd58f25e591daa0443ab63f5087863a7d63" "q-19145/selection/21b5586cb9bb6add9b1620730372fbf8e3cc60f9898680d61a22578168ae0761" "q-19145/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-19145/selection/29dbcc992c814d082b14ceeadff429ebc2de9d24c76b74ca026ddc3e5a56e974" "q-19145/selection/f16a27710af34987e5489c4c07d71675d5e9da9d5c533afd40931f036ab3d01f"] :db/ensure [:answer-field/validate]} {:db/id "q-19145" :question/id #uuid "96ea6da2-d916-5a68-8bfe-17fac86b3a02" :question/math-academy-id "q-19145" :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19145/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-19145"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275247/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-275247/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "4131b337-e9ba-5d6d-b70a-05c861298c89" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-275247/field-1" :answer-field/id #uuid "10069dba-1971-5c9d-9263-8c3c42a8b671" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275247/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer-field/choices ["q-275247/field-1/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-275247/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-275247" :question/id #uuid "77ab9492-52e0-5744-9116-93405b825a7c" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275247/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-275247"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318988/field-1/dc60eed5001e43080f3cc480075f0e24ccc731dcf0715a203eff726179df4011" :answer/id #uuid "554cdaaa-237e-5411-8dff-06df05dcd025" :answer/type :answer.type/math :answer/value "\\frac{24}{5}" :db/ensure [:answer/validate]} {:db/id "q-318988/field-1" :answer-field/id #uuid "91aabf1b-4343-5d3c-bb56-75125e11f3c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318988/field-1/dc60eed5001e43080f3cc480075f0e24ccc731dcf0715a203eff726179df4011" :answer-field/choices ["q-318988/field-1/dc60eed5001e43080f3cc480075f0e24ccc731dcf0715a203eff726179df4011"] :db/ensure [:answer-field/validate]} {:db/id "q-318988" :question/id #uuid "e0409876-8b86-5c5a-9497-7f01e774d52d" :question/math-academy-id "q-318988" :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318988/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-318988"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-18374"] :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-275245/field-1/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "474b3189-cf3f-5d51-a122-92b0a2ebb640" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-275245/field-1" :answer-field/id #uuid "c4180bcf-f6c4-5043-9ca8-c4ff41405766" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275245/field-1/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer-field/choices ["q-275245/field-1/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf"] :db/ensure [:answer-field/validate]} {:db/id "q-275245" :question/id #uuid "e64443e5-be37-5c58-ae2f-8f2e2dec3f9d" :question/math-academy-id "q-275245" :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275245/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-275245"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237020/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "9c4ea86e-49b2-5dae-ac88-ed255e4433c1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-237020/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "80bfbb6d-ba3b-5bdd-a02d-1ae06cf59711" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-237020/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "7cf53513-0ddd-5ce6-9665-d7912a74045d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-237020/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b7dcf45c-e009-586f-b65c-1facc9e75160" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-237020/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b44bd834-c0a5-5184-b04e-e4afc52c9a98" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-237020/selection" :answer-field/id #uuid "6c5adf20-55a1-5f51-b5a0-578a0281bfaa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237020/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-237020/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-237020/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-237020/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-237020/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-237020/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-237020" :question/id #uuid "df71fe31-baa2-554b-a6a6-50ffe2fd2b90" :question/math-academy-id "q-237020" :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237020/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237016/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "48f2d81b-3702-5e6f-bc84-6a13176b409e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-237016/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "53478fed-80e4-5b24-a4a3-fff977c9872a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-237016/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-237016/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "118c25ca-ff53-54d8-ab14-2aeeb4551f36" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-237016/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f39e126e-efa6-554f-953c-331edb92410b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-237016/selection" :answer-field/id #uuid "112a0e5a-df0c-52f6-bfd3-c4935b7fa72c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237016/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-237016/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-237016/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-237016/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-237016/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-237016/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-237016" :question/id #uuid "11400851-a7d6-5cf8-83fd-cf451a3727e6" :question/math-academy-id "q-237016" :question/problem "Let $a=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}-2 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237016/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237016"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237018/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "86201421-b548-5870-b969-06be9059c378" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-237018/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "f0716f83-4677-5e0b-b604-171130b5d1fc" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-237018/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "3e2cdaa0-c317-5d32-8856-34a29c004430" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-237018/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "b8f54c30-d3e7-5317-9414-179a256e3799" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-237018/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "70d63407-5b24-5bff-bf3d-428021ab33ba" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-237018/selection" :answer-field/id #uuid "66eef582-270a-5ded-aa58-fed12c53b9aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237018/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-237018/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-237018/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-237018/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-237018/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-237018/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-237018" :question/id #uuid "b926c009-9ad2-534d-a324-b16391c53f68" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237018/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319172/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "22fc90fb-3829-5956-a2a7-75d923810c90" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-319172/field-1" :answer-field/id #uuid "558a1361-25b1-5b99-bf10-559c36ea0447" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319172/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-319172/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-319172" :question/id #uuid "b959aeb7-f6ec-5140-b94f-f7c12566c7b7" :question/math-academy-id "q-319172" :question/problem "Let $p=⟨-2,3,4⟩$ and $q=⟨1,2,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =-2+6+4x \\\\  & =4x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 4x+4 & =0 \\\\ 4x & =-4 \\\\ x & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319172/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-319172"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275256/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-275256/field-1" :answer-field/id #uuid "825cc115-7959-55bc-9a6d-6100726bc4e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275256/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-275256/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-275256" :question/id #uuid "d1067d56-4d83-5281-8c53-6dfcd93ed0f2" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275256/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-275256"] :db/ensure [:knowledge-point/validate]}]
