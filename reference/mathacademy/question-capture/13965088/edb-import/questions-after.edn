#{[{:db/id #edb/ref 17592186105411 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $\\mid \\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}$. Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = | \\, \\mathbf{a} \\, | \\cos   \\theta \\\\  & = 13 \\cos   ( \\frac{2 \\pi}{3} ) \\\\  & = 13 \\cdot  ( - \\frac{1}{2} ) \\\\  & = - \\frac{13}{2} .\\end{array}$$"}] [{:db/id #edb/ref 17592186105412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle$. Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = \\frac{\\mathbf{a} \\cdot  \\mathbf{b}}{| \\, \\mathbf{b} \\, |} \\\\  & = \\frac{{a}_{x} {b}_{x} + {a}_{y} {b}_{y} + {a}_{z} {b}_{z}}{\\sqrt{{b}_{x}^{2} + {b}_{y}^{2} + {b}_{z}^{2}}} \\\\  & = \\frac{3 \\cdot  2 + 3 \\cdot  ( - 7 ) + ( - 1 ) \\cdot  0}{\\sqrt{{2}^{2} + ( - 7 {)}^{2} + {0}^{2}}} \\\\  & = - \\frac{15}{\\sqrt{53}} .\\end{array}$$"}] [{:db/id #edb/ref 17592186105413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let \n\n$$\n\\mathbf{a}=\\left[ \\begin{array}{c}0 \\\\ 0 \\\\ 1\\end{array}\\right]\n$$\n\n and \n\n$$\n\\mathbf{b}=\\left[ \\begin{array}{c}2 \\\\ - 4 \\\\ 0\\end{array}\\right].\n$$\n\n Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = \\frac{\\mathbf{a} \\cdot  \\mathbf{b}}{| \\, \\mathbf{b} \\, |} \\\\  & = \\frac{{a}_{x} {b}_{x} + {a}_{y} {b}_{y} + {c}_{z} {b}_{z}}{\\sqrt{{b}_{x}^{2} + {b}_{y}^{2} + {b}_{z}^{2}}} \\\\  & = \\frac{0 \\cdot  2 + 0 \\cdot  ( - 4 ) + 1 \\cdot  0}{\\sqrt{{2}^{2} + ( - 4 {)}^{2} + {0}^{2}}} \\\\  & = \\frac{0}{\\sqrt{{2}^{2} + ( - 4 {)}^{2} + {0}^{2}}} \\\\  & = 0.\\end{array}$$"}] [{:db/id #edb/ref 17592186275241 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97889bf1-7eea-5cf3-9d70-54021674c0c1" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\sqrt{2}" :db/id #edb/ref 17592186275243} {:answer/id #uuid "4adf3938-237f-5051-b4d7-9c9abc6440f6" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186275244} {:answer/id #uuid "5d194143-151a-5ff6-9773-d8e4c545a556" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186275245} {:answer/id #uuid "d97dc640-06ae-585e-ab69-0280e4b6c6bb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186275246} {:answer/id #uuid "a9d4b8eb-c7df-5cf0-90ab-2ff02a5f7c4f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186275247}] :answer-field/correct {:answer/id #uuid "4adf3938-237f-5051-b4d7-9c9abc6440f6" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186275244} :answer-field/id #uuid "1d2ee831-5c6a-57a5-8a1a-d691fdf5b8c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275242}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "84ac2ad8-5a67-548f-ab6a-38acdfe05f91" :question/math-academy-id "q-101522" :question/problem "Suppose $|\\,a\\,|=14$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =14\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =14\\cdot (-\\frac{1}{2}) \\\\  & =-7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275248 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cd5152-42a3-52e8-88ee-ff307712ff6e" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{6}" :db/id #edb/ref 17592186275250} {:answer/id #uuid "d8d84365-5b5f-5ce7-ace2-0cb2971ab3ec" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt{2}" :db/id #edb/ref 17592186275251} {:answer/id #uuid "65664fa0-9973-51e4-8c4e-1c2f014454eb" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186275252} {:answer/id #uuid "11d98e6a-2ed9-52e7-bf24-2ea278834060" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275253} {:answer/id #uuid "9ca40b46-9134-50b6-b1b1-be0659a0e6da" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186275254}] :answer-field/correct {:answer/id #uuid "65664fa0-9973-51e4-8c4e-1c2f014454eb" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186275252} :answer-field/id #uuid "9b243320-7dea-58bc-b6ed-7a3788d741bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275249}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "59eef4ad-084f-524d-ac76-2d46296d19a5" :question/math-academy-id "q-101523" :question/problem "Suppose $|\\,p\\,|=10\\sqrt{2}$ and the angle between vectors $p$ and $q$ is $\\theta ={45}^{∘}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10\\sqrt{2}\\operatorname{cos}⁡({45}^{∘}) \\\\  & =10\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106023 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "846fec6b-0634-527c-95c2-25754ce33c08" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186102376} {:answer/id #uuid "98084e96-1175-5ccb-9f1b-d2c905265afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2\\sqrt{3}}" :db/id #edb/ref 17592186102377} {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} {:answer/id #uuid "fdd1d530-3fe4-537c-8416-40b990c1ef12" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186102379} {:answer/id #uuid "22d7a360-bc93-5f42-9551-0ca7a207abd2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102380}] :answer-field/correct {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} :answer-field/id #uuid "5a6ff4f7-e72a-5c98-af10-7d1e281c3900" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102375}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1e48bd53-4841-5a1d-adee-85eb3b590727" :question/math-academy-id "q-18374" :question/problem "Let $\\mathbf{p} = \\langle  \\sqrt{2} , 1 , - 1 \\rangle$ and $\\mathbf{q} = \\langle  \\sqrt{8} , - \\sqrt{3} , 1 \\rangle  .$. Find the scalar projection of $p$ onto $q$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275255 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1cfa43-26e5-5f53-823f-dd723015c0d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{15}" :db/id #edb/ref 17592186275257} {:answer/id #uuid "d8005650-709a-5618-9038-107980e97fd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186275258} {:answer/id #uuid "a33123f7-9a37-569a-ac47-b45bdc9948ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186275259} {:answer/id #uuid "b0e91dcf-8bcc-5fa3-a724-79c508b2a046" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275260} {:answer/id #uuid "dc3e1d8e-5771-5676-9a8e-e37fe8563517" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{5}" :db/id #edb/ref 17592186275261}] :answer-field/correct {:answer/id #uuid "d8005650-709a-5618-9038-107980e97fd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186275258} :answer-field/id #uuid "db014cd0-5131-575e-a1ec-7a1de6de119e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275256}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "96ea6da2-d916-5a68-8bfe-17fac86b3a02" :question/math-academy-id "q-19145" :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275262 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118c25ca-ff53-54d8-ab14-2aeeb4551f36" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275264} {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} {:answer/id #uuid "53478fed-80e4-5b24-a4a3-fff977c9872a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275266} {:answer/id #uuid "f39e126e-efa6-554f-953c-331edb92410b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275267} {:answer/id #uuid "48f2d81b-3702-5e6f-bc84-6a13176b409e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275268}] :answer-field/correct {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} :answer-field/id #uuid "112a0e5a-df0c-52f6-bfd3-c4935b7fa72c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275263}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11400851-a7d6-5cf8-83fd-cf451a3727e6" :question/math-academy-id "q-237016" :question/problem "Let $a=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}-2 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275269 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70d63407-5b24-5bff-bf3d-428021ab33ba" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186275271} {:answer/id #uuid "86201421-b548-5870-b969-06be9059c378" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275272} {:answer/id #uuid "f0716f83-4677-5e0b-b604-171130b5d1fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275273} {:answer/id #uuid "3e2cdaa0-c317-5d32-8856-34a29c004430" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275274} {:answer/id #uuid "b8f54c30-d3e7-5317-9414-179a256e3799" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186275275}] :answer-field/correct {:answer/id #uuid "70d63407-5b24-5bff-bf3d-428021ab33ba" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186275271} :answer-field/id #uuid "66eef582-270a-5ded-aa58-fed12c53b9aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275270}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b926c009-9ad2-534d-a324-b16391c53f68" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275276 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c4ea86e-49b2-5dae-ac88-ed255e4433c1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275278} {:answer/id #uuid "b44bd834-c0a5-5184-b04e-e4afc52c9a98" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275279} {:answer/id #uuid "80bfbb6d-ba3b-5bdd-a02d-1ae06cf59711" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186275280} {:answer/id #uuid "7cf53513-0ddd-5ce6-9665-d7912a74045d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275281} {:answer/id #uuid "b7dcf45c-e009-586f-b65c-1facc9e75160" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275282}] :answer-field/correct {:answer/id #uuid "b7dcf45c-e009-586f-b65c-1facc9e75160" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275282} :answer-field/id #uuid "6c5adf20-55a1-5f51-b5a0-578a0281bfaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275277}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "df71fe31-baa2-554b-a6a6-50ffe2fd2b90" :question/math-academy-id "q-237020" :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275283 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "474b3189-cf3f-5d51-a122-92b0a2ebb640" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186275285}] :answer-field/correct {:answer/id #uuid "474b3189-cf3f-5d51-a122-92b0a2ebb640" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186275285} :answer-field/id #uuid "c4180bcf-f6c4-5043-9ca8-c4ff41405766" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275284}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e64443e5-be37-5c58-ae2f-8f2e2dec3f9d" :question/math-academy-id "q-275245" :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275286 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} {:answer/id #uuid "4131b337-e9ba-5d6d-b70a-05c861298c89" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275289}] :answer-field/correct {:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} :answer-field/id #uuid "10069dba-1971-5c9d-9263-8c3c42a8b671" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275287}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "77ab9492-52e0-5744-9116-93405b825a7c" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275290 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292}] :answer-field/correct {:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292} :answer-field/id #uuid "825cc115-7959-55bc-9a6d-6100726bc4e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275291}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d1067d56-4d83-5281-8c53-6dfcd93ed0f2" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275293 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52455008-c333-5dd1-92b4-72b4768f2da6" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186275295}] :answer-field/correct {:answer/id #uuid "52455008-c333-5dd1-92b4-72b4768f2da6" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186275295} :answer-field/id #uuid "ec7d6cad-97ac-539c-a22f-fd918e59492a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275294}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4153b8de-c0c0-52e9-920b-bb4a1839c543" :question/math-academy-id "q-318971" :question/problem "Suppose $|\\,r\\,|=10$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{2\\pi }{3}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =10cos\\,(\\frac{2\\pi }{3}) \\\\  & =10\\cdot (-\\frac{1}{2}) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275296 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352c4fde-cbb7-5dc1-b56c-ef7fa8aecda1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275298} {:answer/id #uuid "fa8dbb88-2969-5131-a31e-dd00c5440218" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186275299}] :answer-field/correct {:answer/id #uuid "fa8dbb88-2969-5131-a31e-dd00c5440218" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186275299} :answer-field/id #uuid "ebd88b4b-478c-5bc3-8773-841760578c00" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275297}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "261c421f-22a8-58a3-95aa-81eaaa395bc1" :question/math-academy-id "q-318972" :question/problem "Suppose $|\\,p\\,|=8$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8cos\\,(\\frac{\\pi }{6}) \\\\  & =8\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =4\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275300 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302}] :answer-field/correct {:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302} :answer-field/id #uuid "bc125a59-b82a-537c-bc27-b1603fec35b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275301}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e3cf13f3-399e-5099-a24e-b2d19fcea90e" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,(\\frac{3\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275303 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "554cdaaa-237e-5411-8dff-06df05dcd025" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186275305}] :answer-field/correct {:answer/id #uuid "554cdaaa-237e-5411-8dff-06df05dcd025" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186275305} :answer-field/id #uuid "91aabf1b-4343-5d3c-bb56-75125e11f3c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275304}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e0409876-8b86-5c5a-9497-7f01e774d52d" :question/math-academy-id "q-318988" :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275306 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22fc90fb-3829-5956-a2a7-75d923810c90" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275308}] :answer-field/correct {:answer/id #uuid "22fc90fb-3829-5956-a2a7-75d923810c90" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275308} :answer-field/id #uuid "558a1361-25b1-5b99-bf10-559c36ea0447" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275307}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b959aeb7-f6ec-5140-b94f-f7c12566c7b7" :question/math-academy-id "q-319172" :question/problem "Let $p=⟨-2,3,4⟩$ and $q=⟨1,2,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =-2+6+4x \\\\  & =4x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 4x+4 & =0 \\\\ 4x & =-4 \\\\ x & =-1.\\end{aligned}\n$$"}]}
