#{[{:db/id #edb/ref 17592186281900 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8c7ab50-5a8b-5bcd-8483-cec8bf6bd3ce" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8d4ba09-aeb4-57ea-9d59-dfa5a08cb4c8" :answer/type {:db/ident :answer.type/math} :answer/value "1.0" :db/id #edb/ref 17592186281902} {:answer/id #uuid "19cae293-67ed-5504-83e8-3498429d4f9d" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186281903}] :answer-field/correct {:answer/id #uuid "c8d4ba09-aeb4-57ea-9d59-dfa5a08cb4c8" :answer/type {:db/ident :answer.type/math} :answer/value "1.0" :db/id #edb/ref 17592186281902} :answer-field/id #uuid "b27a8733-fe30-59bd-895e-988598143499" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281901} {:answer-field/choices [{:answer/id #uuid "a5599670-9303-5755-962b-8cc7bd758d6d" :answer/type {:db/ident :answer.type/math} :answer/value "4.1" :db/id #edb/ref 17592186281905}] :answer-field/correct {:answer/id #uuid "a5599670-9303-5755-962b-8cc7bd758d6d" :answer/type {:db/ident :answer.type/math} :answer/value "4.1" :db/id #edb/ref 17592186281905} :answer-field/id #uuid "02a68d44-70a5-54dc-ba29-6324239f4829" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281904}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9bb80790-0622-5f51-a71a-ae64b246abab" :question/math-academy-id "q-321613" :question/problem "Find the solutions **in radians** to the equation $\\operatorname{tan}⁡x=\\frac{3}{2}$ for $0\\le x<2\\pi .$ Round your answers to **one decimal place**.\n\n**In ascending order,** the solutions are $x=$\n{{field-1}}\nand $x=$ \n{{field-2}}." :question/worked-solution "First, we find the principal value:\n\n$$\nx=arctan\\,(\\frac{3}{2})=0.982\\,793…≈1.0\n$$\n\nSince $1.0$ lies inside the given domain, our first solution is ${x}_{1}=1.0.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n{x}_{2}=\\pi +0.982\\,793…≈4.1.\n$$\n\nSo, in ascending order and rounded to one decimal place, the solutions are $x=1.0$ and $x=4.1.$"}] [{:db/id #edb/ref 17592186281906 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8c7ab50-5a8b-5bcd-8483-cec8bf6bd3ce" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ee3171-c990-58c2-86dd-11454e6dc2db" :answer/type {:db/ident :answer.type/math} :answer/value "158" :db/id #edb/ref 17592186281908}] :answer-field/correct {:answer/id #uuid "24ee3171-c990-58c2-86dd-11454e6dc2db" :answer/type {:db/ident :answer.type/math} :answer/value "158" :db/id #edb/ref 17592186281908} :answer-field/id #uuid "3e8c1560-6406-56dd-a155-a0967f779be8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281907} {:answer-field/choices [{:answer/id #uuid "77824142-036a-565d-b480-ab9c4e8341dd" :answer/type {:db/ident :answer.type/math} :answer/value "338" :db/id #edb/ref 17592186281910}] :answer-field/correct {:answer/id #uuid "77824142-036a-565d-b480-ab9c4e8341dd" :answer/type {:db/ident :answer.type/math} :answer/value "338" :db/id #edb/ref 17592186281910} :answer-field/id #uuid "c205d0dc-c206-56fc-9ba2-b0b446754b53" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281909}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fa1833a4-57a9-5cb0-a032-e3e5800c4fc4" :question/math-academy-id "q-321728" :question/problem "Find the solutions **in degrees** to the equation $5\\operatorname{tan}⁡x+2=0$ for ${0}^{∘}\\le x<{360}^{∘}.$ Round your answers to **the nearest integer**.\n\n**In ascending order,** the solutions are $x=$\n{{field-1}}${}^{∘}$ and $x=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation and isolate $\\operatorname{tan}⁡x:$\n\n$$\n\\begin{aligned}5\\operatorname{tan}⁡x+2 & =0 \\\\ 5\\operatorname{tan}⁡x & =-2 \\\\ \\operatorname{tan}⁡x & =-0.4\\end{aligned}\n$$\n\nNext, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(-0.4)=-21.8014{…}^{∘}≈-{22.80}^{∘}\n$$\n\nSince $-{22.80}^{∘}$ lies outside the domain, it is not a solution.\n\nTo generate solutions in the domain, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n{x}_{1}={180}^{∘}+(-{21.80}^{∘})≈{158.20}^{∘},\n$$\n\nand\n\n$$\n{x}_{2}={360}^{∘}+(-{21.80}^{∘})≈{338.20}^{∘}.\n$$\n\nSo, in ascending order and rounded to the nearest integer, the solutions are $x={158}^{∘}$ and $x={338}^{∘}.$"}] [{:db/id #edb/ref 17592186281911 :knowledge-point/_questions [{:knowledge-point/id #uuid "a71da663-e7a4-5781-973c-5dc7e4deb83f" :knowledge-point/title "Finding the Points of Intersection of a Horizontal Line and a Tangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df2222f8-6824-591a-8cd8-b7bc8bc5d8b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186281913} {:answer/id #uuid "05c2a9d4-9532-576e-9d67-2a2a730b8f04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186281914} {:answer/id #uuid "bc9f62f7-f05c-50e1-b434-181b8e288db4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186281915} {:answer/id #uuid "1d6228ac-7251-51c1-a08a-62e6730fac97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186281916} {:answer/id #uuid "ae462ded-bc71-58a0-a5ab-c9e6daa44990" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186281917}] :answer-field/correct {:answer/id #uuid "ae462ded-bc71-58a0-a5ab-c9e6daa44990" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186281917} :answer-field/id #uuid "fe6e76b5-5bfe-58c6-8028-4c7443f1609e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281912}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5674b166-f728-5c02-8624-680e618d28d9" :question/math-academy-id "q-72833" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981396/assets/aae559883c97bbd19321d9baeb26fe15e47cced5b072e12100c42aa579c9d02d.png)\n\nThe graph above shows the curve $y=\\operatorname{tan}⁡x$ and the line $y=\\frac{\\sqrt{3}}{3}.$ Find, in radians, the $x$-coordinate of the point $A.$" :question/worked-solution "The $y$-values of both functions are the same at the intersection point. Equating the two functions gives:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\sqrt{3}}{3}\n$$\n\n Now, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the required domain, and there is only one point of intersection, we conclude that the $x$-coordinate of the intersection point $A$ is $x=\\frac{\\pi }{6}.$"}] [{:db/id #edb/ref 17592186092825 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebf8592e-1a43-5d65-af3c-9becd79ae8b9" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f725a848-7d1a-552c-9527-300447209eaf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4π^{2}}{9}" :db/id #edb/ref 17592186091416} {:answer/id #uuid "fac14396-ced2-5983-8e7e-db6123724392" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π^{2}}{9}" :db/id #edb/ref 17592186091417} {:answer/id #uuid "00d7984e-0f57-516b-9ec5-375b40eecab8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π^{2}}{36}" :db/id #edb/ref 17592186091418} {:answer/id #uuid "2ebe48c8-c674-56b0-9c7e-697c15bc17a3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5π^{2}}{36}" :db/id #edb/ref 17592186091419} {:answer/id #uuid "772b81b9-9618-519f-a9f4-03ec4b16e29d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2π^{2}}{9}" :db/id #edb/ref 17592186091420}] :answer-field/correct {:answer/id #uuid "772b81b9-9618-519f-a9f4-03ec4b16e29d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2π^{2}}{9}" :db/id #edb/ref 17592186091420} :answer-field/id #uuid "45886171-d177-5bec-a588-ef1960522918" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091415}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e5a350c3-ee0c-5608-9b0f-eb54700775d8" :question/math-academy-id "q-8718" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{tan}⁡x=-\\sqrt{3}$ for $-\\pi <x\\le \\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(-\\sqrt{3})=-\\frac{\\pi }{3}\\end{aligned}\n$$\n\nSince $-\\frac{\\pi }{3}$ lies inside the given domain, our first solution is ${x}_{1}=-\\frac{\\pi }{3}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +{x}_{1}=\\pi -\\frac{\\pi }{3}=\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=-\\frac{2{\\pi }^{2}}{9}.\n$$"}] [{:db/id #edb/ref 17592186281918 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebf8592e-1a43-5d65-af3c-9becd79ae8b9" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1dba3c9-b8e4-54f8-8f67-b029cc48ee8e" :answer/type {:db/ident :answer.type/math} :answer/value "-0.252" :db/id #edb/ref 17592186281920} {:answer/id #uuid "35349218-5f61-53ab-a8d8-05361b8cf6eb" :answer/type {:db/ident :answer.type/math} :answer/value "-3.252" :db/id #edb/ref 17592186281921} {:answer/id #uuid "c78074c7-aee0-57a3-b4cd-2e072cc4349d" :answer/type {:db/ident :answer.type/math} :answer/value "-2.470" :db/id #edb/ref 17592186281922} {:answer/id #uuid "a083aba3-6982-5c96-863b-ed6feca7ad83" :answer/type {:db/ident :answer.type/math} :answer/value "-2.448" :db/id #edb/ref 17592186281923} {:answer/id #uuid "2ac14b7d-6456-5ed5-8599-affa671265f6" :answer/type {:db/ident :answer.type/math} :answer/value "-2.252" :db/id #edb/ref 17592186281924}] :answer-field/correct {:answer/id #uuid "2ac14b7d-6456-5ed5-8599-affa671265f6" :answer/type {:db/ident :answer.type/math} :answer/value "-2.252" :db/id #edb/ref 17592186281924} :answer-field/id #uuid "cb74f0ce-d4d2-56b0-aed4-e2707f19ee51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281919}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "55192e08-2b61-54e3-98fa-563835320c08" :question/math-academy-id "q-8723" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions, in radians, of the equation $\\operatorname{tan}⁡x=-2$ for $-\\pi <x\\le \\pi ,$ what is the value to $3$ decimal places of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(-2)=-1.107\\,148...≈-1.107\\,149\n$$\n\nSince $-1.107\\,149$ lies inside the given domain, our first solution is ${x}_{1}=-1.107\\,149.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n{x}_{2}=\\pi +{x}_{1}=\\pi -1.107\\,148=2.034\\,444.\n$$\n\nSo, the solutions are $x=-1.107\\,149,2.034\\,444.$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}≈-1.107\\,149\\cdot 2.034\\,444≈-2.252\n$$\n\nrounded to $3$ decimal places."}]}
