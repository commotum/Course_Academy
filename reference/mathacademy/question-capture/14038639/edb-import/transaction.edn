74" "q-87895/selection/d98d64036fd8dc54b8a588616eb192bed93b03103d247d318b7ca1d1f679200a" "q-87895/selection/e5cd5ffba5e7b4fcfb619a6424c2edb0c83ed74877fe2ffb05f35871920b98b9" "q-87895/selection/ab694b95a6fefffeefad57ddce8abaf4acbe5005fe4e65fac774393fff50a5fa"] :db/ensure [:answer-field/validate]} {:db/id "q-87895" :question/id #uuid "0fc20f38-94d0-5166-86bf-40d4b3fc2d1d" :question/math-academy-id "q-87895" :question/problem "Solve the inequality $7\\cdot {4}^{1-x}<{3}^{x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}7\\cdot {4}^{1-x} & <{3}^{x} \\\\ \\operatorname{ln}⁡(7\\cdot {4}^{1-x}) & <\\operatorname{ln}⁡({3}^{x}) \\\\ \\operatorname{ln}⁡7+(1-x)\\operatorname{ln}⁡4 & <x\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡7+\\operatorname{ln}⁡4-x\\operatorname{ln}⁡4 & <x\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡4+\\operatorname{ln}⁡7 & <x(\\operatorname{ln}⁡3+\\operatorname{ln}⁡4) \\\\ x & >\\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡3+\\operatorname{ln}⁡4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87895/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-87895"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115213/selection/137497beafd001f29ffe0f26e196108e32d70e336308b32cc08cc9fcf70a8df8" :answer/id #uuid "b111f759-b22e-5ba8-9d3e-c4c7e2db54ad" :answer/type :answer.type/math :answer/value "x\\ge \\frac{2}{\\operatorname{ln}⁡0.62}+5" :db/ensure [:answer/validate]} {:db/id "q-115213/selection/f4bdc919d9db3b8a550bb2bc9f6cdfd61be2304227186f2ab6bef9838b99ec9c" :answer/id #uuid "a42ea145-5028-5e88-b358-c8776904e634" :answer/type :answer.type/math :answer/value "x\\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5" :db/ensure [:answer/validate]} {:db/id "q-115213/selection/761ac9b9a8f1810a1a41deaa66bedfb78f32b3c2ecdc8460a31187ce7230da27" :answer/id #uuid "10d4f5ed-51d2-5afd-8fe9-b520b5157b04" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}+10" :db/ensure [:answer/validate]} {:db/id "q-115213/selection/4a0c591ec6a3b1d5f00de7296cb1a0e5e656b1123beea05e4ef5ec9489318984" :answer/id #uuid "2237587d-f5f6-5509-912b-3ff184ab231c" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡0.62}{10}-2" :db/ensure [:answer/validate]} {:db/id "q-115213/selection/0af058982b744ffdd1cbe7e199e551b8c65740ed0fea579a2868cfb9101bf802" :answer/id #uuid "7331d0ba-08ac-5299-a33c-499d28123dc9" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡0.62}{5}-2" :db/ensure [:answer/validate]} {:db/id "q-115213/selection" :answer-field/id #uuid "688c5b7c-08d4-5e23-9796-c925c89d2a86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115213/selection/f4bdc919d9db3b8a550bb2bc9f6cdfd61be2304227186f2ab6bef9838b99ec9c" :answer-field/choices ["q-115213/selection/137497beafd001f29ffe0f26e196108e32d70e336308b32cc08cc9fcf70a8df8" "q-115213/selection/f4bdc919d9db3b8a550bb2bc9f6cdfd61be2304227186f2ab6bef9838b99ec9c" "q-115213/selection/761ac9b9a8f1810a1a41deaa66bedfb78f32b3c2ecdc8460a31187ce7230da27" "q-115213/selection/4a0c591ec6a3b1d5f00de7296cb1a0e5e656b1123beea05e4ef5ec9489318984" "q-115213/selection/0af058982b744ffdd1cbe7e199e551b8c65740ed0fea579a2868cfb9101bf802"] :db/ensure [:answer-field/validate]} {:db/id "q-115213" :question/id #uuid "72e60e33-0cf4-5b61-932b-ee9607b15523" :question/math-academy-id "q-115213" :question/problem "Solve the inequality $\\frac{1}{4}{(0.62)}^{x+5}\\le 1.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{4}{(0.62)}^{x+5}\\le 1 \\\\ {(0.62)}^{x+5}\\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.62)^{x+5}] & \\le \\operatorname{ln}⁡4 \\\\ (x+5)\\operatorname{ln}⁡0.62 & \\le 2\\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡0.62$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+5 & \\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62} \\\\ x & \\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115213/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4"] :knowledge-point/questions ["q-115213"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115218/selection/cf8ae74d5167b09cdaf9296041bee354326b74c79094f38897ecf51fc89c76d1" :answer/id #uuid "1600482b-e45e-566d-9123-eaeb27a078c3" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1" :db/ensure [:answer/validate]} {:db/id "q-115218/selection/27026ecae92a77ae4db491e36eb8f330992c9b3c46c3c199ac45cb504cf3dc61" :answer/id #uuid "224e7dee-65ec-538f-b474-27016168a28c" :answer/type :answer.type/math :answer/value "x\\ge \\frac{1}{\\operatorname{ln}⁡3}-\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-115218/selection/c3a5ea87474906aa8b67261f6d8670ed4fa1f1d71f6a20145c979e6031d07316" :answer/id #uuid "37dcdc33-ad34-556a-8b49-5ff997df5354" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}+1" :db/ensure [:answer/validate]} {:db/id "q-115218/selection/b7775edad851f938dfadd576ee15aff17739d9524a2adc24ada485c71aac4015" :answer/id #uuid "52f791fd-7014-546f-a7ff-85cbb2999d26" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3}+1" :db/ensure [:answer/validate]} {:db/id "q-115218/selection/6a50ebdd8f565783d69d76a6d5c33afb6d06186c2a2aeb3cc39229ed326e16c0" :answer/id #uuid "5dc77ad9-a092-5184-a3f8-288b8b84694d" :answer/type :answer.type/math :answer/value "x\\le \\frac{1}{\\operatorname{ln}⁡2}+\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-115218/selection" :answer-field/id #uuid "7f4d3b3a-6b1c-5b9a-a578-4be1b179acf9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115218/selection/cf8ae74d5167b09cdaf9296041bee354326b74c79094f38897ecf51fc89c76d1" :answer-field/choices ["q-115218/selection/cf8ae74d5167b09cdaf9296041bee354326b74c79094f38897ecf51fc89c76d1" "q-115218/selection/27026ecae92a77ae4db491e36eb8f330992c9b3c46c3c199ac45cb504cf3dc61" "q-115218/selection/c3a5ea87474906aa8b67261f6d8670ed4fa1f1d71f6a20145c979e6031d07316" "q-115218/selection/b7775edad851f938dfadd576ee15aff17739d9524a2adc24ada485c71aac4015" "q-115218/selection/6a50ebdd8f565783d69d76a6d5c33afb6d06186c2a2aeb3cc39229ed326e16c0"] :db/ensure [:answer-field/validate]} {:db/id "q-115218" :question/id #uuid "a0fce3af-28fc-56d5-995e-462a42799f2d" :question/math-academy-id "q-115218" :question/problem "Solve the inequality $\\frac{1}{3}{(\\frac{1}{2})}^{x+1}\\le \\frac{1}{9}.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{3}{(\\frac{1}{2})}^{x+1} & \\le \\frac{1}{9} \\\\ {(\\frac{1}{2})}^{x+1} & \\le \\frac{1}{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{1}{2})}^{x+1}] & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)\\operatorname{ln}⁡(\\frac{1}{2}) & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) & \\le \\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\ (x+1)(-\\operatorname{ln}⁡2) & \\le -\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nLastly, note that $-\\operatorname{ln}⁡2$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+1 & \\ge \\frac{-\\operatorname{ln}⁡3}{-\\operatorname{ln}⁡2} \\\\ x & \\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4"] :knowledge-point/questions ["q-115218"] :db/ensure [:knowledge-point/validate]}]
