1} & \\le \\frac{1}{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{1}{2})}^{x+1}] & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)\\operatorname{ln}⁡(\\frac{1}{2}) & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) & \\le \\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\ (x+1)(-\\operatorname{ln}⁡2) & \\le -\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nLastly, note that $-\\operatorname{ln}⁡2$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+1 & \\ge \\frac{-\\operatorname{ln}⁡3}{-\\operatorname{ln}⁡2} \\\\ x & \\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1\\end{aligned}\n$$" 13194139534628 true] [17592186299732 1000 #edb/ref 17592186299733 13194139534628 true] [17592186299732 1000 #edb/ref 17592186299734 13194139534628 true] [17592186299732 1000 #edb/ref 17592186299735 13194139534628 true] [17592186299732 1000 #edb/ref 17592186299736 13194139534628 true] [17592186299732 1000 #edb/ref 17592186299737 13194139534628 true] [17592186299732 1040 #edb/ref 17592186045450 13194139534628 true] [17592186299732 1041 "selection" 13194139534628 true] [17592186299732 1104 #edb/ref 17592186299737 13194139534628 true] [17592186299732 1110 #uuid "7f4d3b3a-6b1c-5b9a-a578-4be1b179acf9" 13194139534628 true] [17592186299733 1034 "x\\ge \\frac{1}{\\operatorname{ln}⁡3}-\\operatorname{ln}⁡2" 13194139534628 true] [17592186299733 1103 #edb/ref 17592186045453 13194139534628 true] [17592186299733 1111 #uuid "224e7dee-65ec-538f-b474-27016168a28c" 13194139534628 true] [17592186299734 1034 "x\\le \\frac{1}{\\operatorname{ln}⁡2}+\\operatorname{ln}⁡3" 13194139534628 true] [17592186299734 1103 #edb/ref 17592186045453 13194139534628 true] [17592186299734 1111 #uuid "5dc77ad9-a092-5184-a3f8-288b8b84694d" 13194139534628 true] [17592186299735 1034 "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3}+1" 13194139534628 true] [17592186299735 1103 #edb/ref 17592186045453 13194139534628 true] [17592186299735 1111 #uuid "52f791fd-7014-546f-a7ff-85cbb2999d26" 13194139534628 true] [17592186299736 1034 "x\\le \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}+1" 13194139534628 true] [17592186299736 1103 #edb/ref 17592186045453 13194139534628 true] [17592186299736 1111 #uuid "37dcdc33-ad34-556a-8b49-5ff997df5354" 13194139534628 true] [17592186299737 1034 "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1" 13194139534628 true] [17592186299737 1103 #edb/ref 17592186045453 13194139534628 true] [17592186299737 1111 #uuid "1600482b-e45e-566d-9123-eaeb27a078c3" 13194139534628 true] [17592186299738 1017 #edb/ref 17592186299739 13194139534628 true] [17592186299738 1089 "q-87876" 13194139534628 true] [17592186299738 1091 #edb/ref 17592186045463 13194139534628 true] [17592186299738 1100 "Solve the inequality $-4-{e}^{3x}>2.$" 13194139534628 true] [17592186299738 1113 #uuid "b280d9a7-460b-53f4-950e-5c4db54798ce" 13194139534628 true] [17592186299738 1145 "First, we isolate the exponential term:\n\n$$\n\\begin{aligned}-4-{e}^{3x} & >2 \\\\ -{e}^{3x} & >6 \\\\ {e}^{3x} & <-6.\\end{aligned}\n$$\n\nNext, recall that a positive number raised to any real power is always positive. Since $e>0,$ we have\n\n$$\n{e}^{3x}>0\n$$\n\nfor every real value of $x.$\n\nTherefore, ${e}^{3x}$ cannot be less than $-6.$ Hence, the inequality\n\n$$\n{e}^{3x}<-6\n$$\n\nhas no solutions." 13194139534628 true] [17592186299739 1000 #edb/ref 17592186299740 13194139534628 true] [17592186299739 1000 #edb/ref 17592186299741 13194139534628 true] [17592186299739 1000 #edb/ref 17592186299742 13194139534628 true] [17592186299739 1000 #edb/ref 17592186299743 13194139534628 true] [17592186299739 1000 #edb/ref 17592186299744 13194139534628 true] [17592186299739 1040 #edb/ref 17592186045450 13194139534628 true] [17592186299739 1041 "selection" 13194139534628 true] [1759218