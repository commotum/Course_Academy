#{[{:db/id #edb/ref 17592186299724 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7331d0ba-08ac-5299-a33c-499d28123dc9" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡0.62}{5}-2" :db/id #edb/ref 17592186299726} {:answer/id #uuid "b111f759-b22e-5ba8-9d3e-c4c7e2db54ad" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{2}{\\operatorname{ln}⁡0.62}+5" :db/id #edb/ref 17592186299727} {:answer/id #uuid "2237587d-f5f6-5509-912b-3ff184ab231c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡0.62}{10}-2" :db/id #edb/ref 17592186299728} {:answer/id #uuid "10d4f5ed-51d2-5afd-8fe9-b520b5157b04" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}+10" :db/id #edb/ref 17592186299729} {:answer/id #uuid "a42ea145-5028-5e88-b358-c8776904e634" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5" :db/id #edb/ref 17592186299730}] :answer-field/correct {:answer/id #uuid "a42ea145-5028-5e88-b358-c8776904e634" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5" :db/id #edb/ref 17592186299730} :answer-field/id #uuid "688c5b7c-08d4-5e23-9796-c925c89d2a86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299725}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72e60e33-0cf4-5b61-932b-ee9607b15523" :question/math-academy-id "q-115213" :question/problem "Solve the inequality $\\frac{1}{4}{(0.62)}^{x+5}\\le 1.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{4}{(0.62)}^{x+5}\\le 1 \\\\ {(0.62)}^{x+5}\\le 4.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.62)^{x+5}] & \\le \\operatorname{ln}⁡4 \\\\ (x+5)\\operatorname{ln}⁡0.62 & \\le 2\\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡0.62$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+5 & \\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62} \\\\ x & \\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299731 :knowledge-point/_questions [{:knowledge-point/id #uuid "05f94d64-fdf7-55d8-80fb-3988a47ed2d4" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Between Zero and One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "224e7dee-65ec-538f-b474-27016168a28c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{\\operatorname{ln}⁡3}-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186299733} {:answer/id #uuid "5dc77ad9-a092-5184-a3f8-288b8b84694d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{1}{\\operatorname{ln}⁡2}+\\operatorname{ln}⁡3" :db/id #edb/ref 17592186299734} {:answer/id #uuid "52f791fd-7014-546f-a7ff-85cbb2999d26" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3}+1" :db/id #edb/ref 17592186299735} {:answer/id #uuid "37dcdc33-ad34-556a-8b49-5ff997df5354" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}+1" :db/id #edb/ref 17592186299736} {:answer/id #uuid "1600482b-e45e-566d-9123-eaeb27a078c3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1" :db/id #edb/ref 17592186299737}] :answer-field/correct {:answer/id #uuid "1600482b-e45e-566d-9123-eaeb27a078c3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1" :db/id #edb/ref 17592186299737} :answer-field/id #uuid "7f4d3b3a-6b1c-5b9a-a578-4be1b179acf9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299732}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0fce3af-28fc-56d5-995e-462a42799f2d" :question/math-academy-id "q-115218" :question/problem "Solve the inequality $\\frac{1}{3}{(\\frac{1}{2})}^{x+1}\\le \\frac{1}{9}.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{3}{(\\frac{1}{2})}^{x+1} & \\le \\frac{1}{9} \\\\ {(\\frac{1}{2})}^{x+1} & \\le \\frac{1}{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{1}{2})}^{x+1}] & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)\\operatorname{ln}⁡(\\frac{1}{2}) & \\le \\operatorname{ln}⁡(\\frac{1}{3}) \\\\ (x+1)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) & \\le \\operatorname{ln}⁡1-\\operatorname{ln}⁡3 \\\\ (x+1)(-\\operatorname{ln}⁡2) & \\le -\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\nLastly, note that $-\\operatorname{ln}⁡2$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+1 & \\ge \\frac{-\\operatorname{ln}⁡3}{-\\operatorname{ln}⁡2} \\\\ x & \\ge \\frac{\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2}-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299738 :knowledge-point/_questions [{:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9abe99f-29a4-5135-84b5-69223c630c70" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{1}{4}" :db/id #edb/ref 17592186299740} {:answer/id #uuid "865c367d-c5f9-5ba3-a0e0-02165ea3e330" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186299741} {:answer/id #uuid "245b9e97-1ece-51a7-ba1b-cd37d900f950" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186299742} {:answer/id #uuid "8da35bcd-a111-5805-a598-140ecc9b091d" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{1}{3}" :db/id #edb/ref 17592186299743} {:answer/id #uuid "afcc481c-725c-5d8c-97a0-d125d88fa8ba" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{2}{3}" :db/id #edb/ref 17592186299744}] :answer-field/correct {:answer/id #uuid "245b9e97-1ece-51a7-ba1b-cd37d900f950" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186299742} :answer-field/id #uuid "8ededfd0-4d2c-52f7-892a-e4584b276d75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299739}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b280d9a7-460b-53f4-950e-5c4db54798ce" :question/math-academy-id "q-87876" :question/problem "Solve the inequality $-4-{e}^{3x}>2.$" :question/worked-solution "First, we isolate the exponential term:\n\n$$\n\\begin{aligned}-4-{e}^{3x} & >2 \\\\ -{e}^{3x} & >6 \\\\ {e}^{3x} & <-6.\\end{aligned}\n$$\n\nNext, recall that a positive number raised to any real power is always positive. Since $e>0,$ we have\n\n$$\n{e}^{3x}>0\n$$\n\nfor every real value of $x.$\n\nTherefore, ${e}^{3x}$ cannot be less than $-6.$ Hence, the inequality\n\n$$\n{e}^{3x}<-6\n$$\n\nhas no solutions."}] [{:db/id #edb/ref 17592186299745 :knowledge-point/_questions [{:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aff37d3-2b04-5246-94e0-3cb18b29d63d" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186299747} {:answer/id #uuid "7f3bac30-6f27-5e01-900f-93af7ebb1b3c" :answer/type {:db/ident :answer.type/math} :answer/value "x<1-{log}_{15/4}⁡(9)" :db/id #edb/ref 17592186299748} {:answer/id #uuid "c41bfc32-367b-5f7b-ad16-a7f74b36a678" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186299749} {:answer/id #uuid "98f88f13-96fc-5ebc-94f5-b5fe5a4b853f" :answer/type {:db/ident :answer.type/math} :answer/value "x<1" :db/id #edb/ref 17592186299750} {:answer/id #uuid "b51e59dc-b463-539a-833d-11e02970e132" :answer/type {:db/ident :answer.type/math} :answer/value "x>1" :db/id #edb/ref 17592186299751}] :answer-field/correct {:answer/id #uuid "8aff37d3-2b04-5246-94e0-3cb18b29d63d" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186299747} :answer-field/id #uuid "b7d7ce77-d77b-54f4-865d-0d8e114b1c9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299746}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "da4d4661-f1df-587e-b77b-1ec068db7274" :question/math-academy-id "q-87891" :question/problem "Solve the inequality $3\\cdot {(\\frac{15}{4})}^{1-x}+27>0.$" :question/worked-solution "First, we isolate the exponential term:\n\n$$\n\\begin{aligned}3\\cdot {(\\frac{15}{4})}^{1-x}+27 & >0 \\\\ 3\\cdot {(\\frac{15}{4})}^{1-x} & >-27 \\\\ {(\\frac{15}{4})}^{1-x} & >-9.\\end{aligned}\n$$\n\nNext, recall that a positive number raised to any real power is always positive. Since $\\frac{15}{4}>0,$ we have\n\n$$\n{(\\frac{15}{4})}^{1-x}>0\n$$\n\nfor every real value of $x.$\n\nIn particular, every value of ${(\\frac{15}{4})}^{1-x}$ is greater than $-9.$ Therefore,\n\n$$\n{(\\frac{15}{4})}^{1-x}>-9\n$$\n\nfor all real values of $x.$\n\nHence, the original inequality is satisfied for all real numbers."}] [{:db/id #edb/ref 17592186299752 :knowledge-point/_questions [{:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c93b0e08-8bb6-52d6-aa05-7e53accd7161" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡3+\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186299754} {:answer/id #uuid "93310a34-1267-5c98-ad83-7b1c4c386769" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡6+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186299755} {:answer/id #uuid "9f45e2eb-6f04-5bca-b3a9-dab7cbd53eee" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡3+\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186299756} {:answer/id #uuid "de714532-2126-528b-8d9f-9aa31a015b90" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186299757} {:answer/id #uuid "cac9bc25-35d7-5d4b-9c9e-de114067c0a4" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}" :db/id #edb/ref 17592186299758}] :answer-field/correct {:answer/id #uuid "c93b0e08-8bb6-52d6-aa05-7e53accd7161" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡3+\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186299754} :answer-field/id #uuid "054d98f1-1b62-509e-bcf3-35b6d4d263c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299753}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fc20f38-94d0-5166-86bf-40d4b3fc2d1d" :question/math-academy-id "q-87895" :question/problem "Solve the inequality $7\\cdot {4}^{1-x}<{3}^{x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}7\\cdot {4}^{1-x} & <{3}^{x} \\\\ \\operatorname{ln}⁡(7\\cdot {4}^{1-x}) & <\\operatorname{ln}⁡({3}^{x}) \\\\ \\operatorname{ln}⁡7+(1-x)\\operatorname{ln}⁡4 & <x\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡7+\\operatorname{ln}⁡4-x\\operatorname{ln}⁡4 & <x\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡4+\\operatorname{ln}⁡7 & <x(\\operatorname{ln}⁡3+\\operatorname{ln}⁡4) \\\\ x & >\\frac{\\operatorname{ln}⁡4+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡3+\\operatorname{ln}⁡4}\\end{aligned}\n$$"}]}
