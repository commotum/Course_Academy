              "type": "math",
              "value": "x\\ge \\frac{2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}-5"
            },
            {
              "type": "math",
              "value": "x\\le \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡0.62}+10"
            },
            {
              "type": "math",
