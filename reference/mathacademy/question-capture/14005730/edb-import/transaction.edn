[{:db/id "q-19082/selection/1678922b5f7f71364ab43c16d19c2a4545e02333414ac12f3d51110d1c8021a1" :answer/id #uuid "4ee26eab-596f-53f3-9138-db4ced7a57cb" :answer/type :answer.type/math :answer/value "\\frac{2}{x\\sqrt{{x}^{4}-1}(1+{arcsec}^{2}({x}^{2}))}" :db/ensure [:answer/validate]} {:db/id "q-19082/selection/0d0eb8b3abc02a3f21414bd53bbb0a45d4503cfa48a7a93a0f8c71c62413a4f0" :answer/id #uuid "3c9f937d-5257-5163-a05c-e69c4ff1a7f6" :answer/type :answer.type/math :answer/value "\\frac{2}{x\\sqrt{{x}^{2}+1}(1-arcsec({x}^{2}))}" :db/ensure [:answer/validate]} {:db/id "q-19082/selection/204c23c0ca07f01490efbb5fba4aa20f90bd483093ec2f7caec0e1f0d9fd5869" :answer/id #uuid "e759e0a6-4360-5e80-a65a-f02d079819ca" :answer/type :answer.type/math :answer/value "\\frac{1}{x\\sqrt{{x}^{2}-1}(1+{arcsec}^{2}({x}^{2}))}" :db/ensure [:answer/validate]} {:db/id "q-19082/selection/44d1f53c964ac57d627ac26cffdbcec6945d66d3e2699082ce0e2da7ec55f1f4" :answer/id #uuid "891d5bc5-23b2-528b-bed0-bd45efa448be" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{{x}^{4}-1}(1+{arcsec}^{2}({x}^{2}))}" :db/ensure [:answer/validate]} {:db/id "q-19082/selection/b349adb175376d92bae8a184c36ec15fb52e6c6736de7c0ea8e1617f8e6cf972" :answer/id #uuid "61290247-b292-5d72-b1eb-562f261fe559" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{{x}^{4}-1}(1+arcsec({x}^{2}))}" :db/ensure [:answer/validate]} {:db/id "q-19082/selection" :answer-field/id #uuid "8ca4009f-112b-5efb-bd0e-10a491a7b85e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19082/selection/1678922b5f7f71364ab43c16d19c2a4545e02333414ac12f3d51110d1c8021a1" :answer-field/choices ["q-19082/selection/1678922b5f7f71364ab43c16d19c2a4545e02333414ac12f3d51110d1c8021a1" "q-19082/selection/0d0eb8b3abc02a3f21414bd53bbb0a45d4503cfa48a7a93a0f8c71c62413a4f0" "q-19082/selection/204c23c0ca07f01490efbb5fba4aa20f90bd483093ec2f7caec0e1f0d9fd5869" "q-19082/selection/44d1f53c964ac57d627ac26cffdbcec6945d66d3e2699082ce0e2da7ec55f1f4" "q-19082/selection/b349adb175376d92bae8a184c36ec15fb52e6c6736de7c0ea8e1617f8e6cf972"] :db/ensure [:answer-field/validate]} {:db/id "q-19082" :question/id #uuid "5b105bb2-4648-5649-8f9a-cccd87078318" :question/math-academy-id "q-19082" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=\\operatorname{arctan}⁡(arcsec({x}^{2})).$" :question/worked-solution "The formulae for the derivatives of $arctan$ and $arcsec$ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arctanx) & =\\frac{1}{1+{x}^{2}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(arcsecx) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the chain rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(arcsec({x}^{2}))) \\\\  & =\\frac{1}{1+(arcsec({x}^{2}))^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsec({x}^{2})) \\\\  & =\\frac{1}{1+(arcsec({x}^{2}))^{2}}\\cdot \\frac{1}{|{x}^{2}|\\sqrt{({x}^{2})^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =\\frac{1}{1+(arcsec({x}^{2}))^{2}}\\cdot \\frac{1}{|{x}^{2}|\\sqrt{({x}^{2})^{2}-1}}\\cdot 2x \\\\  & =\\frac{2}{x\\sqrt{{x}^{4}-1}(1+{arcsec}^{2}({x}^{2}))}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-19082/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-19082"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31951/selection/9c73f66826fbbfe7d48c0f6aa6d399c406145ce5224371f48eb5c37b942378fa" :answer/id #uuid "900a49b1-f31b-5c34-84c3-214bc320817b" :answer/type :answer.type/math :answer/value "-\\frac{6}{|6x-1|\\sqrt{9{x}^{2}-3x}}" :db/ensure [:answer/validate]} {:db/id "q-31951/selection/2d8f30628afb5abc018c016d48b77838f5a7ac4fe1af4e1d6fbd42420cada315" :answer/id #uuid "3052b77d-8f58-5636-ba3e-4658c108161b" :answer/type :answer.type/math :answer/value "-\\frac{1}{|6x-1|\\sqrt{3{x}^{2}-x}}" :db/ensure [:answer/validate]} {:db/id "q-31951/selection/23ee3dcc8703c9a8ac564780e2c8c253ce15208ab73e507a96ded060803af877" :answer/id #uuid "53c1ee49-f35d-5bf0-bba5-8335655096f2" :answer/type :answer.type/math :answer/value "\\frac{6}{|6x-1|\\sqrt{3{x}^{2}-x}}" :db/ensure [:answer/validate]} {:db/id "q-31951/selection/dc12ee548cabffad829a7f174d80b22946217b66be2d7d7d130f24826e15242f" :answer/id #uuid "84dee1da-37c9-51eb-9b31-4b8489a125fb" :answer/type :answer.type/math :answer/value "\\frac{1}{|6x-1|\\sqrt{9{x}^{2}-3x}}" :db/ensure [:answer/validate]} {:db/id "q-31951/selection/445f0b9730081de5f6d87d098482acc00f755d6b60b8ea4182e19e26c108260c" :answer/id #uuid "5e5ae948-cc82-5eea-a36d-9abfb87984b7" :answer/type :answer.type/math :answer/value "\\frac{6}{|6x-1|\\sqrt{9{x}^{2}-3x}}" :db/ensure [:answer/validate]} {:db/id "q-31951/selection" :answer-field/id #uuid "8280f4aa-5a6e-5b72-bfd5-c3e14aa0e872" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31951/selection/445f0b9730081de5f6d87d098482acc00f755d6b60b8ea4182e19e26c108260c" :answer-field/choices ["q-31951/selection/9c73f66826fbbfe7d48c0f6aa6d399c406145ce5224371f48eb5c37b942378fa" "q-31951/selection/2d8f30628afb5abc018c016d48b77838f5a7ac4fe1af4e1d6fbd42420cada315" "q-31951/selection/23ee3dcc8703c9a8ac564780e2c8c253ce15208ab73e507a96ded060803af877" "q-31951/selection/dc12ee548cabffad829a7f174d80b22946217b66be2d7d7d130f24826e15242f" "q-31951/selection/445f0b9730081de5f6d87d098482acc00f755d6b60b8ea4182e19e26c108260c"] :db/ensure [:answer-field/validate]} {:db/id "q-31951" :question/id #uuid "2f1bb893-693a-5e47-8b85-ca41d1ece733" :question/math-academy-id "q-31951" :question/problem "Find ${f}^{′}(x)$ if $f(x)=2arcsec(6x-1).$" :question/worked-solution "The formula for the derivative of $arcsec$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arcsecx)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2arcsec(6x-1)) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsec(6x-1)) \\\\  & =2\\cdot \\frac{1}{|6x-1|\\sqrt{(6x-1)^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}(6x-1) \\\\  & =2\\cdot \\frac{1}{|6x-1|\\sqrt{{(6x-1)}^{2}-1}}\\cdot 6 \\\\  & =\\frac{12}{|6x-1|\\sqrt{36{x}^{2}-12x}} \\\\  & =\\frac{12}{|6x-1|\\sqrt{4(9{x}^{2}-3x)}} \\\\  & =\\frac{6}{|6x-1|\\sqrt{9{x}^{2}-3x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31951/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-31951"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341145/field-1/55a6ab3f0c17ea4b3fbaf059cc4a788e7158576522542d447dc49eea6f9fc79c" :answer/id #uuid "cc6af7be-a986-51ee-9979-716f4eb97648" :answer/type :answer.type/math :answer/value "\\frac{1}{2(1+x)}" :db/ensure [:answer/validate]} {:db/id "q-341145/field-1" :answer-field/id #uuid "41f086b9-fc8f-52d6-a5f1-74a709c3e4b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341145/field-1/55a6ab3f0c17ea4b3fbaf059cc4a788e7158576522542d447dc49eea6f9fc79c" :answer-field/choices ["q-341145/field-1/55a6ab3f0c17ea4b3fbaf059cc4a788e7158576522542d447dc49eea6f9fc79c"] :db/ensure [:answer-field/validate]} {:db/id "q-341145" :question/id #uuid "1154e30f-a8e4-5c95-bbfc-9a667bc384d6" :question/math-academy-id "q-341145" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=\\sqrt{x}\\cdot arccot\\,(\\sqrt{x}).$\n\n${f}^{′}(x)=\\frac{arccot(\\sqrt{x})}{2\\sqrt{x}}\\,-$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccot\\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}\\cdot arccot(\\sqrt{x})) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})\\cdot arccot(\\sqrt{x})+\\sqrt{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(arccot\\,(\\sqrt{x})) \\\\  & =\\frac{1}{2\\sqrt{x}}\\cdot arccot(\\sqrt{x})+\\sqrt{x}\\cdot [-\\frac{1}{1+{(\\sqrt{x})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})] \\\\  & =\\frac{arccot(\\sqrt{x})}{2\\sqrt{x}}-\\frac{\\sqrt{x}}{1+x}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =\\frac{arccot(\\sqrt{x})}{2\\sqrt{x}}-\\frac{1}{2(1+x)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-341145/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-341145"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341147/field-1/6680cb91a5d32fab241d491f1f1c6d27de0c590a5f3bc3502bd4965e79d49b5e" :answer/id #uuid "39242b3b-5cb2-5193-a68e-4ceb81dcfc50" :answer/type :answer.type/math :answer/value "\\frac{\\ln(x)}{\\ln(4)(1+x^2)}" :db/ensure [:answer/validate]} {:db/id "q-341147/field-1/4c49116d8817db6a9f304d013216265cbe4f526f57881458936c80d5e020cdee" :answer/id #uuid "118b8f38-c091-5f5e-a66f-6a5d183aa2c2" :answer/type :answer.type/math :answer/value "\\frac{1}{1+x^2}" :db/ensure [:answer/validate]} {:db/id "q-341147/field-1" :answer-field/id #uuid "bddca692-11f6-562f-a893-36412ab654e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341147/field-1/6680cb91a5d32fab241d491f1f1c6d27de0c590a5f3bc3502bd4965e79d49b5e" :answer-field/choices ["q-341147/field-1/6680cb91a5d32fab241d491f1f1c6d27de0c590a5f3bc3502bd4965e79d49b5e" "q-341147/field-1/4c49116d8817db6a9f304d013216265cbe4f526f57881458936c80d5e020cdee"] :db/ensure [:answer-field/validate]} {:db/id "q-341147" :question/id #uuid "8f4fa426-0741-5f44-8bf7-92d3d10ecf3e" :question/math-academy-id "q-341147" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)={log}_{4}⁡x\\cdot arccot\\,x.$\n\n${f}^{′}(x)=\\frac{arccot\\,x}{x\\operatorname{ln}⁡4}\\,-$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccot\\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x\\cdot arccot\\,x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x)\\cdot arccot\\,x+{log}_{4}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(arccot\\,x) \\\\  & =\\frac{1}{x\\operatorname{ln}⁡4}\\cdot arccot\\,x+{log}_{4}⁡x\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & =\\frac{arccot\\,x}{x\\operatorname{ln}⁡4}-\\frac{{log}_{4}⁡x}{1+{x}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341147/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-341147"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341179/field-1/081f535b220371b737492db26b788dcfea91514375e1185d751a912bffd9f1ac" :answer/id #uuid "8becb5f1-a1a5-5935-8b3c-6c1c32c9890b" :answer/type :answer.type/math :answer/value "3^x\\ln(3)" :db/ensure [:answer/validate]} {:db/id "q-341179/field-1" :answer-field/id #uuid "35bb1cf0-2494-5df1-9da3-309b535962be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341179/field-1/081f535b220371b737492db26b788dcfea91514375e1185d751a912bffd9f1ac" :answer-field/choices ["q-341179/field-1/081f535b220371b737492db26b788dcfea91514375e1185d751a912bffd9f1ac"] :db/ensure [:answer-field/validate]} {:db/id "q-341179/field-2/96da9e160054e684e0d532da0b266868b27b2c2aab6e434ea0ecf7717a5c9d96" :answer/id #uuid "159f0f4f-5f4b-5b87-8b68-25024e21f289" :answer/type :answer.type/math :answer/value "\\frac{3^x}{\\sqrt{x^2-1}}" :db/ensure [:answer/validate]} {:db/id "q-341179/field-2" :answer-field/id #uuid "33defe62-425e-546e-b65a-53208bec39e5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341179/field-2/96da9e160054e684e0d532da0b266868b27b2c2aab6e434ea0ecf7717a5c9d96" :answer-field/choices ["q-341179/field-2/96da9e160054e684e0d532da0b266868b27b2c2aab6e434ea0ecf7717a5c9d96"] :db/ensure [:answer-field/validate]} {:db/id "q-341179" :question/id #uuid "d2d893fd-7701-5397-af73-678ba255c33f" :question/math-academy-id "q-341179" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\frac{{3}^{x}}{arccsc\\,x}.$\n\n${f}^{′}(x)=$\n{{field-1}} \n$\\frac{1}{arccsc\\,x}\\,+$\n{{field-2}}\n$\\frac{1}{|x|{(arccsc\\,x)}^{2}}.$" :question/worked-solution "Here, we let $u(x)={3}^{x}$ and $v(x)=arccsc\\,x,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)={3}^{x}\\operatorname{ln}⁡3\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({3}^{x}\\operatorname{ln}⁡3)\\cdot arccsc\\,x-{3}^{x}\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{(arccsc\\,x)}^{2}}. \\\\  & ={3}^{x}\\operatorname{ln}⁡3\\cdot \\frac{arccsc\\,x}{{(arccsc\\,x)}^{2}}+\\frac{{3}^{x}}{{(arccsc\\,x)}^{2}}\\cdot \\frac{1}{|x|\\sqrt{{x}^{2}-1}} \\\\  & ={3}^{x}\\operatorname{ln}⁡3\\,\\frac{1}{arccsc\\,x}+\\frac{{3}^{x}}{\\sqrt{{x}^{2}-1}}\\,\\frac{1}{|x|{(arccsc\\,x)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-341179/field-1" "q-341179/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-341179"] :db/ensure [:knowledge-point/validate]}]
