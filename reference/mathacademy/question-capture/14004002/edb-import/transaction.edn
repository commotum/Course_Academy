[{:db/id [:question/math-academy-id "q-1401"] :question/problem "The vector $u$ has magnitude $6$, the vector $v$ has magnitude $7,$ the angle between $u$ and $v$ is ${134}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =6\\cdot 7\\cdot \\operatorname{sin}⁡{134}^{∘}\\cdot n \\\\  & =42\\cdot (0.719\\,33…)\\cdot n \\\\  & =(30.212\\,27…)\\cdot n \\\\  & ≈30.2n.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-127844/selection/84543ce9858c91d1ad6dc153651f91343c8766679931c1ff839ce9cca6efe5b1" :answer/id #uuid "6520c826-87ce-5a5f-a55e-2067a3edbe17" :answer/type :answer.type/math :answer/value "6n" :db/ensure [:answer/validate]} {:db/id "q-127844/selection/0f16b539cc274a39f0bcf75cbacc77257afde8fccc615a1d910bb0e5197ba36e" :answer/id #uuid "75153839-1e57-515f-9503-2d101932335f" :answer/type :answer.type/math :answer/value "11n" :db/ensure [:answer/validate]} {:db/id "q-127844/selection/a505d90dfdc4b1207298df67b943e55de38eb17a794f5226fcb35d3bddec0e39" :answer/id #uuid "8251ad65-5561-592e-8e71-2b0c112286f8" :answer/type :answer.type/math :answer/value "7n" :db/ensure [:answer/validate]} {:db/id "q-127844/selection/ea52b0c65acd8e991df24ca94b2c46ff909b125ab7124f3f64f2acfdf8a23946" :answer/id #uuid "29e77bbd-c2cb-569f-8e5c-49243becf1d6" :answer/type :answer.type/math :answer/value "5n" :db/ensure [:answer/validate]} {:db/id "q-127844/selection/be1d507e6d5cbf42d8a0a7413381ccf9a0f3c669673500681c13d2b0fed76e0a" :answer/id #uuid "eb3dbd53-5aaf-58a0-b820-015c881186cf" :answer/type :answer.type/math :answer/value "3n" :db/ensure [:answer/validate]} {:db/id "q-127844/selection" :answer-field/id #uuid "82cf066e-1c0b-5c0