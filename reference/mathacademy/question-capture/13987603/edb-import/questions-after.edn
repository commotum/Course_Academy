2}{7}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186286205} {:answer/id #uuid "f536c601-e555-5217-b05a-dfbca9376e0a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡\\frac{x}{7}+C" :db/id #edb/ref 17592186286206} {:answer/id #uuid "7bb3390b-2675-55c8-8505-b0f1f18a6717" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286207} {:answer/id #uuid "3e0800a6-ebfd-5f09-b47a-86ec9d22f7c6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡7x+C" :db/id #edb/ref 17592186286208} {:answer/id #uuid "905395b5-e3bb-59a6-bc5d-b6175903547f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arccos}⁡7x+C" :db/id #edb/ref 17592186286209}] :answer-field/correct {:answer/id #uuid "7bb3390b-2675-55c8-8505-b0f1f18a6717" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286207} :answer-field/id #uuid "08ba71bc-1ba6-5e58-8088-39c7329aaaa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286204}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cae44343-62da-5190-b602-6ed925de0ec9" :question/math-academy-id "q-114042" :question/problem "$\\int \\frac{2}{7{x}^{2}+7}\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{7{x}^{2}+7}\\,\\text{d}x & =\\int \\frac{2}{7({x}^{2}+1)}\\,\\text{d}x \\\\  & =\\frac{2}{7}\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\frac{2}{7}\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286210 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b92bfb74-6765-5a3f-9412-a78ee5f5f066" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186286212} {:answer/id #uuid "345b1d09-a3a6-51ce-98fa-cef8c234ae21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286213} {:answer/id #uuid "5be07d34-4a3a-5899-b7c9-ea1586a5358a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186286214} {:answer/id #uuid "89c0dc99-91b3-52df-bafb-bc4e7f8f4221" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286215} {:answer/id #uuid "c95df50d-4d06-5f14-acdc-b0b2432d17de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286216}] :answer-field/correct {:answer/id #uuid "c95df50d-4d06-5f14-acdc-b0b2432d17de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286216} :answer-field/id #uuid "3e6e50aa-7337-532b-8a35-a248a04e4afc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286211}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1887e813-9ff9-5613-bf31-af72ae2f328c" :question/math-academy-id "q-114156" :question/problem "$\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x & =\\int x\\,\\text{d}x+\\int \\frac{2}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\int x\\,\\text{d}x+2\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286217 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173d7cc2-b423-524a-a6de-e1583929ec97" :answer/type {:db/ident :answer.type/math} :answer/value "-5arcsecx+C" :db/id #edb/ref 17592186286219} {:answer/id #uuid "5116fc4e-c584-53bc-8af8-08cc06b9e901" :answer/type {:db/ident :answer.type/math} :answer/value "5arctanx+C" :db/id #edb/ref 17592186286220} {:answer/id #uuid "644cc2c6-cfd3-5616-84fa-f6b845c582b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5arcsinx+C" :db/id #edb/ref 17592186286221} {:answer/id #uuid "49168116-3b21-5a0e-8423-45397572cbc1" :answer/type {:db/ident :answer.type/math} :answer/value "-arcsec5x+C" :db/id #edb/ref 17592186286222} {:answer/id #uuid "4f08b0e2-f161-567d-99aa-70a8babf7a43" :answer/type {:db/ident :answer.type/math} :answer/value "arctan5x+C" :db/id #edb/ref 17592186286223}] :answer-field/correct {:answer/id #uuid "173d7cc2-b423-524a-a6de-e1583929ec97" :answer/type {:db/ident :answer.type/math} :answer/value "-5arcsecx+C" :db/id #edb/ref 17592186286219} :answer-field/id #uuid "dcbe04f8-1e0e-539c-9942-ca91dcb17858" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286218}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8f4764bb-cec5-5082-b07c-7b2f429296da" :question/math-academy-id "q-114160" :question/problem "$\\int -\\frac{5}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{5}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =-5\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =-5arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286224 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a641d54c-8190-5a55-b69c-c456a78ab073" :answer/type {:db/ident :answer.type/math} :answer/value "arctan12x+C" :db/id #edb/ref 17592186286226} {:answer/id #uuid "226b5c98-d38b-5f84-8b95-011e72c9eefc" :answer/type {:db/ident :answer.type/math} :answer/value "-arcsec12x+C" :db/id #edb/ref 17592186286227} {:answer/id #uuid "24364338-2852-5d47-865e-4b84278e44c3" :answer/type {:db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186286228} {:answer/id #uuid "91d529d5-12c6-5f9e-bdf4-6ff28ef93b22" :answer/type {:db/ident :answer.type/math} :answer/value "12arcsinx+C" :db/id #edb/ref 17592186286229} {:answer/id #uuid "9e25031f-a30f-5bd1-a5e3-2ccbea2fc349" :answer/type {:db/ident :answer.type/math} :answer/value "-12arctanx+C" :db/id #edb/ref 17592186286230}] :answer-field/correct {:answer/id #uuid "24364338-2852-5d47-865e-4b84278e44c3" :answer/type {:db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186286228} :answer-field/id #uuid "dd9dad11-7846-5761-9173-ee96fd1ae253" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286225}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "867e3430-6d73-50ae-9ed7-3b27b53d8282" :question/math-academy-id "q-114162" :question/problem "$\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =-12\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =-12arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286231 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "996c440a-d3cb-5f97-9544-aef55a5feb3d" :answer/type {:db/ident :answer.type/math} :answer/value "3x+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286233} {:answer/id #uuid "3d1707e1-702d-5ec8-9e62-06ae6504b3a4" :answer/type {:db/ident :answer.type/math} :answer/value "5x+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286234} {:answer/id #uuid "603da356-3871-547a-9b0d-c92674d2d4f9" :answer/type {:db/ident :answer.type/math} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286235} {:answer/id #uuid "8a8b7d34-4b6c-5b3c-90fb-523f0fb9451e" :answer/type {:db/ident :answer.type/math} :answer/value "5x-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286236} {:answer/id #uuid "829f9960-22a7-50b0-ab67-fef75b423cab" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286237}] :answer-field/correct {:answer/id #uuid "603da356-3871-547a-9b0d-c92674d2d4f9" :answer/type {:db/ident :answer.type/math} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286235} :answer-field/id #uuid "f63462ba-a3bb-5717-88b3-985b7147563b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286232}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e3e53fc5-fb4f-5b9a-bea6-773144fce85f" :question/math-academy-id "q-114181" :question/problem "$\\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+6}{{x}^{2}+1} & =\\frac{{x}^{2}+1-1+6}{{x}^{2}+1} \\\\  & =\\frac{({x}^{2}+1)+5}{{x}^{2}+1} \\\\  & =\\frac{\\cancel{{x}^{2}+1}}{\\cancel{{x}^{2}+1}}+\\frac{5}{{x}^{2}+1} \\\\  & =1+\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x & =\\int (1+\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =\\int \\text{d}x+\\int \\frac{5}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int \\text{d}x+5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =x+5\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286238 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e75102f-c67d-5b6c-9047-8e675df26e9f" :answer/type {:db/ident :answer.type/math} :answer/value "5x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286240} {:answer/id #uuid "f0efd694-d83f-5afc-8b59-8aab7b46d02c" :answer/type {:db/ident :answer.type/math} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286241} {:answer/id #uuid "a9e952d9-fa67-5aa5-a3a2-6af2498fa246" :answer/type {:db/ident :answer.type/math} :answer/value "x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286242} {:answer/id #uuid "0c293d19-bb0e-5e53-a2a3-8e91a379d6d2" :answer/type {:db/ident :answer.type/math} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286243} {:answer/id #uuid "9c931916-e3ad-52ef-9c42-32f4cefc64bb" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286244}] :answer-fiel