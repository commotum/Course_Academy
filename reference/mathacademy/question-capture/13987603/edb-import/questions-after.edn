torname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (4-\\frac{4}{{x}^{2}+1})\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =4x-4\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064454 :knowledge-point/_questions [{:knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "910ceea0-2132-53dd-8572-be4a025c2ed8" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\arcsin x + C" :db/id #edb/ref 17592186061374} {:answer/id #uuid "b0ef5d6c-237c-5dae-9c5e-c20a1bd00eb7" :answer/type {:db/ident :answer.type/math} :answer/value "5\\arctan x + C" :db/id #edb/ref 17592186061375} {:answer/id #uuid "b6bde417-11fc-5d8a-b67d-836abd8b5d50" :answer/type {:db/ident :answer.type/math} :answer/value "5\\arcsin x + C" :db/id #edb/ref 17592186061376} {:answer/id #uuid "3338fc9e-99f7-5014-990a-b2b09393d0f1" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\arccos x + C" :db/id #edb/ref 17592186061377} {:answer/id #uuid "69ae7f54-51e5-545f-8e35-469b653321cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\arcsin (5x) + C" :db/id #edb/ref 17592186061378}] :answer-field/correct {:answer/id #uuid "910ceea0-2132-53dd-8572-be4a025c2ed8" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\arcsin x + C" :db/id #edb/ref 17592186061374} :answer-field/id #uuid "0aff8308-c54b-51f6-b1ac-ab23ef11c3b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061373}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c1cea40d-e47d-5293-af9b-c5f67df8a555" :question/math-academy-id "q-19090" :question/problem "$\\int \\frac{-5}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{-5}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =-5\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-5\\operatorname{arcsin}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064455 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a1cc74-b2aa-5b89-ab94-085115b0275e" :answer/type {:db/ident :answer.type/math} :answer/value "11\\operatorname{arccsc}(x)+C" :db/id #edb/ref 17592186286253} {:answer/id #uuid "9995a0cb-2002-5c81-b50d-571da374bfa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}(x)+C" :db/id #edb/ref 17592186286254} {:answer/id #uuid "ffaa3f10-ca9f-5571-9469-d9708614dc63" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arccsc}(11x)+C" :db/id #edb/ref 17592186286255} {:answer/id #uuid "44defbfd-197a-50bf-a69e-3766d438237b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsec}(11x)+C" :db/id #edb/ref 17592186286256} {:answer/id #uuid "8ba4efad-24ed-5cf5-af52-c22165fb54ca" :answer/type {:db/ident :answer.type/math} :answer/value "11\\operatorname{arcsec}(x)+C" :db/id #edb/ref 17592186286257}] :answer-field/correct {:answer/id #uuid "8ba4efad-24ed-5cf5-af52-c22165fb54ca" :answer/type {:db/ident :answer.type/math} :answer/value "11\\operatorname{arcsec}(x)+C" :db/id #edb/ref 17592186286257} :answer-field/id #uuid "fa206fb2-b46d-5d7b-bb9a-f67332d92dd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286252}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f5ca0aa8-06db-5c6f-bb07-38d950f613d0" :question/math-academy-id "q-19100" :question/problem "$\\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =11\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =11arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064456 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbfa0867-1b43-5baf-be35-7ad741c87b00" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{arctan}\\,x+C" :db/id #edb/ref 17592186286259} {:answer/id #uuid "1b10c492-700a-5a6a-8925-cd9c75ff3066" :answer/type {:db/ident :answer.type/math} :answer/value "3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286260} {:answer/id #uuid "2ac39c49-7552-58ca-bdb2-c764926ac963" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286261} {:answer/id #uuid "2e80e286-79b0-55b0-8a3b-430b36e58ede" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286262} {:answer/id #uuid "d551847f-21ca-5319-b70c-9efa450bee70" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{arccos}\\,x+C" :db/id #edb/ref 17592186286263}] :answer-field/correct {:answer/id #uuid "1b10c492-700a-5a6a-8925-cd9c75ff3066" :answer/type {:db/ident :answer.type/math} :answer/value "3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286260} :answer-field/id #uuid "ccbcae58-74be-515a-b671-1236919e02f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286258}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2a43a9d4-962c-592e-be6c-4c9a905c5e08" :question/math-academy-id "q-19102" :question/problem "$\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}}{{x}^{2}+1} & =\\frac{3{x}^{2}+3-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)}{{x}^{2}+1}-\\frac{3}{{x}^{2}+1} \\\\  & =\\frac{3\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{3}{{x}^{2}+1} \\\\  & =3-\\frac{3}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (3-\\frac{3}{{x}^{2}+1})\\text{d}x \\\\  & =3\\int \\text{d}x-3\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =3x-3\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286264 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa19635b-1791-5bdd-8ee8-b60fe17e537c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\text{ arcsec }y+C" :db/id #edb/ref 17592186286266} {:answer/id #uuid "8d42efa5-5b4d-5978-85c1-7e4433e449b1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arcsec }y+C" :db/id #edb/ref 17592186286267} {:answer/id #uuid "367f73da-02a5-523e-b266-c479886856c1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arccot }y+C" :db/id #edb/ref 17592186286268} {:answer/id #uuid "7ef005d4-0cd2-5900-9641-d6b54c76cc32" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsin}⁡y+C" :db/id #edb/ref 17592186286269} {:answer/id #uuid "3c5436f4-fddc-5562-a78a-221e61ac4b8b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arccsc }y+C" :db/id #edb/ref 17592186286270}] :answer-field/correct {:answer/id #uuid "8d42efa5-5b4d-5978-85c1-7e4433e449b1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arcsec }y+C" :db/id #edb/ref 17592186286267} :answer-field/id #uuid "0cebe50b-47ea-5961-9ff4-0aa0bb982ffc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286265}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1a1bc09d-617c-574d-9331-3e47b32368d5" :question/math-academy-id "q-2501" :question/problem "$\\int \\frac{2}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y=\\text{arcsec}\\,y.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y & =2\\int \\frac{1}{|y|\\sqrt{{y}^{2}-1}}\\,\\text{d}y \\\\  & =2\\text{ arcsec }y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286271 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fb884e0-dbfc-5a17-85e2-2b9480f7a965" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{arcsec}\\,x-2{x}^{4}+C" :db/id #edb/ref 17592186286273} {:answer/id #uuid "f6261c22-a86f-5f05-b44a-448c5b8d2033" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{arccot}\\,x-{x}^{4}+C" :db/id #edb/ref 17592186286274} {:answer/id #uuid "6506dfcc-12c7-5cfc-a7a8-3d5cab869316" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡x-2{x}^{4}+C" :db/id #edb/ref 17592186286275} {:answer/id #uuid "09c9b678-f7ae-5aa4-b15b-5e2f44dda5ab" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡x-{x}^{4}+C" :db/id #edb/ref 17592186286276} {:answer/id #uuid "59e6059c-8846-557b-852c-c6428673dcc6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡x-{x}^{4}+C" :db/id #edb/ref 17592186286277}] :answer-field/correct {:answer/id #uuid "59e6059c-8846-557b-852c-c6428673dcc6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡x-{x}^{4}+C" :db/id #edb/ref 17592186286277} :answer-field/id #uuid "07502274-afbd-5665-94b8-779f37574316" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286272}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "05651fea-c88e-51be-bcf1-c110593f8d91" :question/math-academy-id "q-49075" :question/problem "If ${f}^{′}(x)=\\frac{2}{{x}^{2}+1}-4{x}^{3},$ then $f(x)=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}f(x)=\\int {f}^{′}(x)\\text{d}x & =\\int (\\frac{2}{{x}^{2}+1}-4{x}^{3})\\,\\text{d}x \\\\  & =\\int \\frac{2}{{x}^{2}+1}\\,\\text{d}x-\\int 4{x}^{3}\\text{d}x \\\\  & =2\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x-4\\int {x}^{3}\\text{d}x \\\\  & =2\\operatorname{arctan}⁡x-4\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2\\operatorname{arctan}⁡x-{x}^{4}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286278 :knowledge-point/_questions [{:knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f15db9ba-7adf-5db2-919c-76343709794b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡x+3x+C" :db/id #edb/ref 17592186286280} {:answer/id #uuid "215bea50-9d81-5d9a-a170-17031caeae69" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{ arcsec }x-4x+C" :db/id #edb/ref 17592186286281} {:answer/id #uuid "cd464968-f774-5c5d-9b77-c17a16eed840" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x-2{x}^{3}+C" :db/id #edb/ref 17592186286282} {:answer/id #uuid "94ee20c8-c68c-5a5d-8d07-48d3975e4900" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡x-2{x}^{3}+C" :db/id #edb/ref 17592186286283} {:answer/id #uuid "a152bf20-9f16-50c2-871b-2dbbfb593732" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ arcsec }x+4{x}^{3}+C" :db/id #edb/ref 17592186286284}] :answer-field/correct {:answer/id #uuid "94ee20c8-c68c-5a5d-8d07-48d3975e4900" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡x-2{x}^{3}+C" :db/id #edb/ref 17592186286283} :answer-field/id #uuid "e21d42d2-1c8f-502e-a982-0e03c1ad85dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286279}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "be10ffc2-beaa-559b-a4b8-663e528184f6" :question/math-academy-id "q-49129" :question/problem "$\\int (\\frac{3}{\\sqrt{1-{x}^{2}}}-6{x}^{2})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\frac{3}{\\sqrt{1-{x}^{2}}}-6{x}^{2})\\text{d}x & =\\int \\frac{3}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x-\\int 6{x}^{2}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x-6\\int {x}^{2}\\,\\text{d}x \\\\  & =3\\operatorname{arcsin}⁡x-6\\cdot \\frac{{x}^{3}}{3}+C \\\\  & =3\\operatorname{arcsin}⁡x-2{x}^{3}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286285 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af7fae58-6294-561d-a665-f618570f6404" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{ arcsec }x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186286287} {:answer/id #uuid "128e32fe-ba95-59f7-9cfb-58eeeec9d290" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arctan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186286288} {:answer/id #uuid "bf820315-92a1-5a21-a65c-3a765b07611e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arctan}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186286289} {:answer/id #uuid "ec372422-2c26-50d1-b398-8186940cbd45" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡x-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186286290} {:answer/id #uuid "a74fdab4-56fb-5543-af70-8cd433285bf6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡x+\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286291}] :answer-field/correct {:answer/id #uuid "128e32fe-ba95-59f7-9cfb-58eeeec9d290" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arctan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186286288} :answer-field/id #uuid "cdb9e041-89bd-5175-aa13-4493668346c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286286}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94b62d6a-f96e-51b7-adf4-6c1946157389" :question/math-academy-id "q-49131" :question/problem "$\\int (\\frac{4}{1+{x}^{2}}-\\operatorname{sin}⁡x)\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\frac{4}{1+{x}^{2}}-\\operatorname{sin}⁡x)\\text{d}x & =\\int \\frac{4}{1+{x}^{2}}\\,\\text{d}x-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =4\\operatorname{arctan}⁡x-(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{arctan}⁡x+\\operatorname{cos}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286292 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbf031ad-6cb8-5154-bfb9-bbf2887dd17d" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arcsin}⁡x-4x+C" :db/id #edb/ref 17592186286294} {:answer/id #uuid "773a7c79-a3c7-5a5a-9ef3-65e3037f6e07" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{ arcsec }x-9x+C" :db/id #edb/ref 17592186286295} {:answer/id #uuid "d7790682-7c3a-5e3f-87de-e3cf50392da7" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arctan}⁡x-9x+C" :db/id #edb/ref 17592186286296} {:answer/id #uuid "d331dfd3-1f93-56fd-a02e-330b037d6634" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arcsin}⁡x+3{x}^{3}+C" :db/id #edb/ref 17592186286297} {:answer/id #uuid "4147de87-227a-5401-8548-6e8121f2280a" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arctan}⁡x-9{x}^{2}+C" :db/id #edb/ref 17592186286298}] :answer-field/correct {:answer/id #uuid "d7790682-7c3a-5e3f-87de-e3cf50392da7" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arctan}⁡x-9x+C" :db/id #edb/ref 17592186286296} :answer-field/id #uuid "243dde64-1287-5907-9c81-43dd4079dd68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286293}] :question/difficulty {:db/id #edb/ref 17