4\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286304} :answer-field/id #uuid "88e055ef-e229-51ab-926f-105a9757a0ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286300}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b634fb24-87ae-5bf4-adab-c3b33a72630f" :question/math-academy-id "q-71759" :question/problem "$\\int (\\operatorname{cos}⁡x-\\frac{4}{\\sqrt{1-{x}^{2}}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{cos}⁡x-\\frac{4}{\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-\\int \\frac{4}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x-4\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-4\\operatorname{arcsin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286306 :knowledge-point/_questions [{:knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed409816-c149-5cd6-a4aa-a75216bf38b8" :answer/type {:db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286308} {:answer/id #uuid "e2973a62-f83a-5f60-88ce-b3ab1a3b0c84" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186286309} {:answer/id #uuid "40bf2217-9be9-5e28-9a30-c7980fe5e2b0" :answer/type {:db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186286310} {:answer/id #uuid "f3b844c1-871d-5f4c-8111-ca7585674a0e" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286311} {:answer/id #uuid "d348ff06-4c1e-5124-ba48-60776632e64d" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286312}] :answer-field/correct {:answer/id #uuid "f3b844c1-871d-5f4c-8111-ca7585674a0e" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286311} :answer-field/id #uuid "862a8d2a-b31e-59e1-abd3-7ceed556e54c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286307}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6f87bad4-c4ec-55ea-bcca-70b23b6d28ef" :question/math-academy-id "q-71761" :question/problem "$\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int 8x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =8\\int x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =4{x}^{2}-\\operatorname{arcsin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286313 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1fa7454-c87e-5ff6-8826-0753399ad487" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sec}⁡x-4\\text{ arcsin }x+C" :db/id #edb/ref 17592186286315} {:answer/id #uuid "48ec4709-e706-5a07-87b8-c5e38d7deff1" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{cos}⁡x+4\\text{ arcsin }x+C" :db/id #edb/ref 17592186286316} {:answer/id #uuid "744713ae-afbc-5541-955f-fac9d3cab9e9" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C" :db/id #edb/ref 17592186286317} {:answer/id #uuid "0ec549d4-6f85-5b34-b069-b354bc498b6c" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{sec}⁡x-4\\text{ arcsec }x+C" :db/id #edb/ref 17592186286318} {:answer/id #uuid "ba8a1f04-3836-52b1-a88a-e61ebf056e8f" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C" :db/id #edb/ref 17592186286319}] :answer-field/correct {:answer/id #uuid "ba8a1f04-3836-52b1-a88a-e61ebf056e8f" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C" :db/id #edb/ref 17592186286319} :answer-field/id #uuid "48431655-7648-5b51-9931-0a61b003388a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286314}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5400e682-a815-556b-b821-6e1c84d732b5" :question/math-academy-id "q-71774" :question/problem "$\\int (5\\operatorname{sin}⁡x+\\frac{4}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int (5\\operatorname{sin}⁡x+\\frac{4}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x & =\\int 5\\operatorname{sin}⁡x\\,\\text{d}x+\\int \\frac{4}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =5\\int \\operatorname{sin}⁡x\\,\\text{d}x+4\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =5(-\\operatorname{cos}⁡x)+4\\text{ arcsec }x+C \\\\  & =-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286320 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9e81eb7-bf3a-517d-af64-d1da3ae6d57a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+2arcsecx+C" :db/id #edb/ref 17592186286322} {:answer/id #uuid "c397fa53-cb24-5dc2-a069-9832669a4288" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286323} {:answer/id #uuid "2567307c-9ce2-5010-b084-aa0a655b06b0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286324} {:answer/id #uuid "d863f590-61bd-59df-ade8-40d9e17ee6a7" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286325} {:answer/id #uuid "4cfee2d8-4cf7-525f-aa6b-7120847a36f3" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286326}] :answer-field/correct {:answer/id #uuid "2567307c-9ce2-5010-b084-aa0a655b06b0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286324} :answer-field/id #uuid "bc2fcc97-3fad-5708-9192-efb02b0b2438" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286321}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0f79a7e7-fd0c-5a15-b868-815d3bd17ec4" :question/math-academy-id "q-71779" :question/problem "$\\int \\frac{2{x}^{3}+2x+1}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{2{x}^{3}+2x+1}{{x}^{2}+1} & =\\frac{2x({x}^{2}+1)+1}{{x}^{2}+1} \\\\  & =\\frac{2x\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}+\\frac{1}{{x}^{2}+1} \\\\  & =2x+\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (2x+\\frac{1}{{x}^{2}+1})\\text{d}x \\\\  & =2\\int x\\text{d}x+\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+\\operatorname{arctan}⁡x+C \\\\  & ={x}^{2}+\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}]}
