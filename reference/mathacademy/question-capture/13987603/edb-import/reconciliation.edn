}-1}}\\,\\text{d}x \\\\  & =5(-\\operatorname{cos}⁡x)+4\\text{ arcsec }x+C \\\\  & =-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71774" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/activity-metadata.json" "file_sha256" "48a51391665cc0adfd013314c9e9b8c776486edab92a9cf0079117e994057170"} {"question" "q-71774" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71774" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C"] ["math" "-5\\operatorname{cos}⁡x+4\\text{ arcsin }x+C"] ["math" "-5\\operatorname{sec}⁡x-4\\text{ arcsin }x+C"] ["math" "5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C"] ["math" "5\\operatorname{sec}⁡x-4\\text{ arcsec }x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71774" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5\\operatorname{cos}⁡x+4\\text{ arcsec }x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114181" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114181" "field" nil "attribute" "question/worked-solution" "value" "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+6}{{x}^{2}+1} & =\\frac{{x}^{2}+1-1+6}{{x}^{2}+1} \\\\  & =\\frac{({x}^{2}+1)+5}{{x}^{2}+1} \\\\  & =\\frac{\\cancel{{x}^{2}+1}}{\\cancel{{x}^{2}+1}}+\\frac{5}{{x}^{2}+1} \\\\  & =1+\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+6}{{x}^{2}+1}\\,\\text{d}x & =\\int (1+\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =\\int \\text{d}x+\\int \\frac{5}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int \\text{d}x+5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =x+5\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114181" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/activity-metadata.json" "file_sha256" "48a51391665cc0adfd013314c9e9b8c776486edab92a9cf0079117e994057170"} {"question" "q-114181" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114181" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2x+3\\operatorname{arctan}⁡x+C"] ["math" "3x+2\\operatorname{arctan}⁡x+C"] ["math" "5x+\\operatorname{arctan}⁡x+C"] ["math" "5x-\\operatorname{arctan}⁡x+C"] ["math" "x+5\\operatorname{arctan}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114181" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x+5\\operatorname{arctan}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114183" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114183" "field" nil "attribute" "question/worked-solution" "value" "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}}{{x}^{2}+1} & =\\frac{5{x}^{2}+5-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)}{{x}^{2}+1}-\\frac{5}{{x}^{2}+1} \\\\  & =\\frac{5\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{5}{{x}^{2}+1} \\\\  & =5-\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (5-\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =5\\int \\text{d}x-5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =5x-5\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114183" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/activity-metadata.json" "file_sha256" "48a51391665cc0adfd013314c9e9b8c776486edab92a9cf0079117e994057170"} {"question" "q-114183" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114183" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2x+3\\operatorname{arctan}⁡x+C"] ["math" "5x+5\\operatorname{arctan}⁡x+C"] ["math" "5x-5\\operatorname{arctan}⁡x+C"] ["math" "x+5\\operatorname{arctan}⁡x+C"] ["math" "x-5\\operatorname{arctan}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-114183" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5x-5\\operatorname{arctan}⁡x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71779" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{2{x}^{3}+2x+1}{{x}^{2}+1}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71779" "field" nil "attribute" "question/worked-solution" "value" "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{2{x}^{3}+2x+1}{{x}^{2}+1} & =\\frac{2x({x}^{2}+1)+1}{{x}^{2}+1} \\\\  & =\\frac{2x\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}+\\frac{1}{{x}^{2}+1} \\\\  & =2x+\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (2x+\\frac{1}{{x}^{2}+1})\\text{d}x \\\\  & =2\\int x\\text{d}x+\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+\\operatorname{arctan}⁡x+C \\\\  & ={x}^{2}+\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71779" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/activity-metadata.json" "file_sha256" "48a51391665cc0adfd013314c9e9b8c776486edab92a9cf0079117e994057170"} {"question" "q-71779" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71779" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{x}^{2}+\\operatorname{arcsin}⁡x+C"] ["math" "2{x}^{2}+\\operatorname{arctan}⁡x+C"] ["math" "{x}^{2}+2\\operatorname{arcsin}⁡x+C"] ["math" "{x}^{2}+2arcsecx+C"] ["math" "{x}^{2}+\\operatorname{arctan}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-71779" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{x}^{2}+\\operatorname{arctan}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-19102" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-19102" "field" nil "attribute" "question/worked-solution" "value" "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}}{{x}^{2}+1} & =\\frac{3{x}^{2}+3-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)}{{x}^{2}+1}-\\frac{3}{{x}^{2}+1} \\\\  & =\\frac{3\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{3}{{x}^{2}+1} \\\\  & =3-\\frac{3}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (3-\\frac{3}{{x}^{2}+1})\\text{d}x \\\\  & =3\\int \\text{d}x-3\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =3x-3\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-19102" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/activity-metadata.json" "file_sha256" "48a51391665cc0adfd013314c9e9b8c776486edab92a9cf0079117e994057170"} {"question" "q-19102" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-19102" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3x-3\\operatorname{arctan}⁡x+C"] ["math" "3\\,\\text{arccos}\\,x+C"] ["math" "3\\,\\text{arctan}\\,x+C"] ["math" "3x+3\\operatorname{arcsin}⁡x+C"] ["math" "3x-3\\operatorname{arctan}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987603/state.json" "file_sha256" "0cee9120ab9a02efd60642be78da29a605eac4575fd23e1846e04340bd3d902d"} {"question" "q-19102" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3x-3\\operatorname{arctan}⁡x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy