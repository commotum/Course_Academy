ligned}\\int (\\frac{4}{1+{x}^{2}}-\\operatorname{sin}⁡x)\\text{d}x & =\\int \\frac{4}{1+{x}^{2}}\\,\\text{d}x-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x-\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =4\\operatorname{arctan}⁡x-(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{arctan}⁡x+\\operatorname{cos}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49131/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311"] :knowledge-point/questions ["q-49131"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114156/selection/e8613697a243b01af2b72378f2625097c1b98239c2d7f09f4b507e38c7235cc6" :answer/id #uuid "c95df50d-4d06-5f14-acdc-b0b2432d17de" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114156/selection/5f45bf29318cfb93043465863916e3fb3bf5508dac19b0df1583659656d3f70f" :answer/id #uuid "345b1d09-a3a6-51ce-98fa-cef8c234ae21" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}-2\\operatorname{arcsin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114156/selection/c579c792edba2ac882b94f30bd0039af6df3aab93c6fff1406b5c20d9ec07075" :answer/id #uuid "89c0dc99-91b3-52df-bafb-bc4e7f8f4221" :answer/type :answer.type/math :answer/value "{x}^{2}\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114156/selection/8c39459c43a6035e62e81d4017cf94a7012446a5670c8c0c307fb696421decd0" :answer/id #uuid "5be07d34-4a3a-5899-b7c9-ea1586a5358a" :answer/type :answer.type/math :answer/value "{x}^{2}\\operatorname{arccos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114156/selection/2dc676654857a0bd4afa4db7d88ae4c57b92c5723a983265e3fb3fbe4449168c" :answer/id #uuid "b92bfb74-6765-5a3f-9412-a78ee5f5f066" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{sec}⁡x+C" :db/ens