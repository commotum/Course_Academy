 :answer/value "A(t) = 2t^{3/2} - t^{2} + 1500" :db/id #edb/ref 17592186061798}] :answer-field/correct {:answer/id #uuid "482d9a7e-3829-5075-8736-0f532405e96d" :answer/type {:db/ident :answer.type/math} :answer/value "A(t) = 2t^{3/2} - t^{2} + 1500" :db/id #edb/ref 17592186061798} :answer-field/id #uuid "8d318cec-38b8-5ede-829d-63b30564b929" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061793}] :question/id #uuid "ef1fb432-e4fe-5f9e-a680-f538f3e2c97f" :question/math-academy-id "q-2370" :question/problem "> A scientific calculator is required to answer this question.\n\nA pumping station adds sand to Sandy Beach at a rate of $3\\sqrt{t}$ cubic yards per hour. The tide removes the sand from the beach at a rate of $2t$ cubic yards per hour. If at time $t = 0$ the beach contains $1500$ cubic yards of sand, write an expression for $A(t)$, the total number of cubic yards of sand on the beach at any time $t > 0$." :question/requires-calculator true}]}
