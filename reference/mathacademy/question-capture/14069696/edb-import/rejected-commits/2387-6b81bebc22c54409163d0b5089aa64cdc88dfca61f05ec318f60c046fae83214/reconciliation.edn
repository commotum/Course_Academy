wer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348652" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\ln(\\pi+1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348652" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348652" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" nil "attribute" "question/problem" "value" "What is the value of $h(t)=[\\begin{aligned}{3}^{t} \\\\ {t}^{2}-1 \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]$ at $t=0?$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $h(0)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" nil "attribute" "question/worked-solution" "value" "To evaluate, we substitute $t=0$ into our function, as follows:\n\n$$\n\\begin{aligned}h(0) & =[\\begin{aligned}{3}^{0} \\\\ {0}^{2}-1 \\\\ \\operatorname{cos}⁡(0)\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/activity-metadata.json" "file_sha256" "22ba756979e15d87c093166efd7aad5dd64e00132dfafc20635ac70f6b165bb1"} {"question" "q-348653" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348653" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348690" "field" nil "attribute" "question/problem" "value" "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\sqrt{{t}^{3}-4},\\,ln\\,(2\\,{e}^{t-2}-1)⟩,$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348690" "field" nil "attribute" "question/worked-solution" "value" "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨cos\\,(\\frac{2\\pi }{2}),\\,\\sqrt{{2}^{3}-4},\\,ln\\,(2\\,{e}^{0}-1)⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/state.json" "file_sha256" "bd788fb6f448baded22810c4867a26897807d5fbfe897330a049f4b58ca147a8"} {"question" "q-348690" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069696/activity-metadata.json" "file_sha256" "22ba7