cation" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/edb-import/verification.json"} {"question" "q-160776" "field" nil "attribute" "question/worked-solution" "value" "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =2{e}^{0}\\,i+\\sqrt{0+4}\\,j+(0-2)^{4}\\,k \\\\  & =2\\,i+2\\,j+16\\,k\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=0$ is the vector $2\\,i+2\\,j+16\\,k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/state.json" "file_sha256" "f945047955e33b6065b36bf5537f6934c9065f79a354f7c7f7118ad50c801644" "basis" 1268 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/edb-import/verification.json"} {"question" "q-160776" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/activity-metadata.json" "file_sha256" "64c68ca974ad10c77d63faf7ee266208d4c766b30c27e9d04d0fc12a5d19bb3a" "basis" 1268 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/edb-import/verification.json"} {"question" "q-160776" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/state.json" "file_sha256" "f945047955e33b6065b36bf5537f6934c9065f79a354f7c7f7118ad50c801644" "basis" 1268 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037455/edb-import/verification.json"} {"question" "q-160776" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\