#{[{:db/id #edb/ref 17592186296755 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dee0141-ee47-5f4c-a7ce-e6959d32d8dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j-16\\,k" :db/id #edb/ref 17592186296757} {:answer/id #uuid "b0f36f45-c831-5c27-8eae-05f459e7303c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+16\\,k" :db/id #edb/ref 17592186296758} {:answer/id #uuid "f1c8e759-c0ce-5274-9338-241596b7ed67" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,j" :db/id #edb/ref 17592186296759} {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} {:answer/id #uuid "a8cdf08b-251f-568b-8ca0-95067dbca6a5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,k" :db/id #edb/ref 17592186296761}] :answer-field/correct {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} :answer-field/id #uuid "dcb1abb0-c585-5d84-9b43-d58fcb8454b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296756}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dbca96e3-97ce-5664-9b73-f99e6dcd22bd" :question/math-academy-id "q-160776" :question/problem "What is the value of $f(t)=2{e}^{t}\\,i+\\sqrt{t+4}\\,j+(t-2)^{4}\\,k$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =2{e}^{0}\\,i+\\sqrt{0+4}\\,j+(0-2)^{4}\\,k \\\\  & =2\\,i+2\\,j+16\\,k\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=0$ is the vector $2\\,i+2\\,j+16\\,k.$"}] [{:db/id #edb/ref 17592186296794 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "951140da-7dc1-5716-8e51-a68ab8450f13" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi+8}" :db/id #edb/ref 17592186296796} {:answer/id #uuid "fba456da-20ee-508f-8a4f-ddf4f05ccd84" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi+9}" :db/id #edb/ref 17592186296797}] :answer-field/correct {:answer/id #uuid "951140da-7dc1-5716-8e51-a68ab8450f13" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi+8}" :db/id #edb/ref 17592186296796} :answer-field/id #uuid "47b44fbc-07d7-5c87-8f19-65a3255a95a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296795} {:answer-field/choices [{:answer/id #uuid "896cab89-1a04-5e51-bb69-56caeb81a879" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\pi+1)" :db/id #edb/ref 17592186296799}] :answer-field/correct {:answer/id #uuid "896cab89-1a04-5e51-bb69-56caeb81a879" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\pi+1)" :db/id #edb/ref 17592186296799} :answer-field/id #uuid "b8189813-d715-5338-9166-defa0dfdf50f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296798} {:answer-field/choices [{:answer/id #uuid "5c523f21-6918-59cb-ab52-cf50b8fbbb88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296801}] :answer-field/correct {:answer/id #uuid "5c523f21-6918-59cb-ab52-cf50b8fbbb88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296801} :answer-field/id #uuid "b09ec14b-9c77-5cc9-8b96-84aed0c92497" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296800}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c543b2c9-9bd9-5400-aeed-00be99158407" :question/math-academy-id "q-348652" :question/problem "What is the value of $g(t)=[\\begin{aligned}\\sqrt{t+8} \\\\ \\operatorname{ln}⁡(t+1) \\\\ 2\\operatorname{sin}⁡t\\end{aligned}]$ at $t=\\pi ?$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $g(\\pi )=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "To evaluate, we substitute $t=\\pi $ into our function, as follows:\n\n$$\n\\begin{aligned}g(\\pi ) & =[\\begin{aligned}\\sqrt{\\pi +8} \\\\ \\operatorname{ln}⁡(\\pi +1) \\\\ 2\\operatorname{sin}⁡(\\pi )\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{\\pi +8} \\\\ \\operatorname{ln}⁡(\\pi +1) \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296802 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "734c3ee4-c63b-5b2d-9d50-556990311461" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296804} {:answer/id #uuid "d14f86ac-dcff-55d2-b3b7-af471d436804" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296805}] :answer-field/correct {:answer/id #uuid "734c3ee4-c63b-5b2d-9d50-556990311461" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296804} :answer-field/id #uuid "278e6af9-b46e-5157-8bf0-7abeb45e27e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296803}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ae45ac93-c493-5bb4-93c6-95e53a04e9aa" :question/math-academy-id "q-348690" :question/problem "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\sqrt{{t}^{3}-4},\\,ln\\,(2\\,{e}^{t-2}-1)⟩,$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨cos\\,(\\frac{2\\pi }{2}),\\,\\sqrt{{2}^{3}-4},\\,ln\\,(2\\,{e}^{0}-1)⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}]}
