\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296755 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dee0141-ee47-5f4c-a7ce-e6959d32d8dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j-16\\,k" :db/id #edb/ref 17592186296757} {:answer/id #uuid "b0f36f45-c831-5c27-8eae-05f459e7303c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+16\\,k" :db/id #edb/ref 17592186296758} {:answer/id #uuid "f1c8e759-c0ce-5274-9338-241596b7ed67" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,j" :db/id #edb/ref 17592186296759} {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} {:answer/id #uuid "a8cdf08b-251f-568b-8ca0-95067dbca6a5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,k" :db/id #edb/ref 17592186296761}] :answer-field/correct {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} :answer-field/id #uuid "dcb1abb0-c585-5d84-9b43-d58fcb8454b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296756}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dbca96e3-97ce-5664-9b73-f99e6dcd22bd" :question/math-academy-id "q-160776" :question/problem "What is the value of $f(t)=2{e}^{t}\\,i+\\sqrt{t+4}\\,j+(t-2)^{4}\\,k$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =2{e}^{0}\\,i+\\sqrt{0+4}\\,j+(0-2)^{4}\\,k \\\\  & =2\\,i+2\\,j+16\\,k\\end{aligned}\n$$\n\nSo, the value of $