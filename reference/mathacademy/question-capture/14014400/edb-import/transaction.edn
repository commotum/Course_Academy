[{:db/id "q-351421/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "f41b1b34-f997-5d61-9acc-0574bcd388cf" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-351421/field-1" :answer-field/id #uuid "9d45bbc9-97c0-5571-9e73-7d150a54b469" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351421/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-351421/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-351421" :question/id #uuid "0bc88c45-b00a-5e19-9c3f-9d3e4f3af636" :question/math-academy-id "q-351421" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6t+2.$ Find the total displacement $d$ of the particle between $t=1$ and $t=2.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=1$ and $t=2.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{2}(6t+2)\\,\\text{dt} \\\\  & =(3{t}^{2}+2t){|}_{1}^{2} \\\\  & =[3(2)^{2}+2(2)]-[3(1)^{2}+2(1)] \\\\  & =[12+4]-[3+2] \\\\  & =11.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351421/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-351421"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351431/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "5f0c57e2-a924-5441-b0e9-63ee697c5134" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-351431/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e5aee0df-8a58-552d-8045-3f53a3f9792d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-351431/field-1" :answer-field/id #uuid "e7388b20-851e-58e2-85f6-179c4c96a52c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351431/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-351431/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-351431/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-351431" :question/id #uuid "b821d35a-eba2-5209-a10b-30b5c53aa6ef" :question/math-academy-id "q-351431" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=\\frac{3}{2}\\sqrt{t-1}.$ Find the total displacement $d$ of the particle between $t=1$ and $t=5.$ Do not round the answer.\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=1$ and $t=5.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{5}(\\frac{3}{2}\\sqrt{t-1})\\,\\text{dt} \\\\  & =(t-1)^{3/2}\\,{|}_{1}^{5} \\\\  & =(5-1)^{3/2}-(1-1)^{3/2} \\\\  & =8-0 \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351431/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-351431"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19494/selection/4ca7e04cb32d17c1971e27f96c827d785e809ee86fbe2e04813f39f29bdc8cde" :answer/id #uuid "a5293353-e707-5799-9b04-10f5c8d371ba" :answer/type :answer.type/math :answer/value "\\frac{25}{3}" :db/ensure [:answer/validate]} {:db/id "q-19494/selection/de229bccb4244d5e56a060fa42bf0f97a5433fcac7dadcb8a31985b64b0d1a87" :answer/id #uuid "810edcee-4228-5be6-ad8c-8ed3ad11d644" :answer/type :answer.type/math :answer/value "-\\frac{26}{3}" :db/ensure [:answer/validate]} {:db/id "q-19494/selection/266f8fc061957f6a8756e2983e0b79d344c2a4f70b57783044e99932e211632d" :answer/id #uuid "60f963c3-cba3-5aa8-a8eb-7aaa60fc9c16" :answer/type :answer.type/math :answer/value "\\frac{27}{5}" :db/ensure [:answer/validate]} {:db/id "q-19494/selection/08a717cd923d82c678b28f27852d7d71c0c9609ff5e443380d20d567f005b4b0" :answer/id #uuid "611264e7-e158-5b06-9f19-145b4c39ebd5" :answer/type :answer.type/math :answer/value "-\\frac{25}{6}" :db/ensure [:answer/validate]} {:db/id "q-19494/selection/348159c05aa3af806578d05799a926b10947a5c2c1148eb2f22911b06a9a0c63" :answer/id #uuid "db895c28-d357-541c-b966-7cebcb85a7ab" :answer/type :answer.type/math :answer/value "-\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-19494/selection" :answer-field/id #uuid "24347589-3e14-56df-ba32-c36cc5aeef99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19494/selection/348159c05aa3af806578d05799a926b10947a5c2c1148eb2f22911b06a9a0c63" :answer-field/choices ["q-19494/selection/4ca7e04cb32d17c1971e27f96c827d785e809ee86fbe2e04813f39f29bdc8cde" "q-19494/selection/de229bccb4244d5e56a060fa42bf0f97a5433fcac7dadcb8a31985b64b0d1a87" "q-19494/selection/266f8fc061957f6a8756e2983e0b79d344c2a4f70b57783044e99932e211632d" "q-19494/selection/08a717cd923d82c678b28f27852d7d71c0c9609ff5e443380d20d567f005b4b0" "q-19494/selection/348159c05aa3af806578d05799a926b10947a5c2c1148eb2f22911b06a9a0c63"] :db/ensure [:answer-field/validate]} {:db/id "q-19494" :question/id #uuid "16ed4b22-8600-5440-b196-0307bbc3ead4" :question/math-academy-id "q-19494" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)={t}^{2}-7t+10.$ What is the total displacement of the particle between $t=2$ and $t=5?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{2}^{5}({t}^{2}-7t+10)\\,\\text{d}t \\\\  & ={(\\frac{1}{3}{t}^{3}-\\frac{7}{2}{t}^{2}+10t)|}_{2}^{5} \\\\  & =[\\frac{1}{3}(5)^{3}-\\frac{7}{2}(5)^{2}+10(5)]-[\\frac{1}{3}(2)^{3}-\\frac{7}{2}(2)^{2}+10(2)] \\\\  & =[\\frac{125}{3}-\\frac{175}{2}+50]-[\\frac{8}{3}-14+20] \\\\  & =\\frac{25}{6}-\\frac{26}{3} \\\\  & =-\\frac{9}{2}.\\end{aligned}\n$$\n\n \n\nSo the total displacement between $t=2$ and $t=5$ is $-\\frac{9}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19494/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-19494"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351430/field-1/01aca80803a35bc194f181862c130866e0d55d5962172cd581aa99aa396cbd00" :answer/id #uuid "f5f22ce7-e843-5b2f-aa76-d8a89bec012d" :answer/type :answer.type/math :answer/value "-95" :db/ensure [:answer/validate]} {:db/id "q-351430/field-1/897ce4c7911f99b265ba23f864c4eaa9aec53942cbd2bbe07376f6b49ce12837" :answer/id #uuid "82e94eae-a41e-526d-9760-a60a7c5b5740" :answer/type :answer.type/math :answer/value "95" :db/ensure [:answer/validate]} {:db/id "q-351430/field-1" :answer-field/id #uuid "b55e316f-3bbb-59bb-987e-a56715861c55" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351430/field-1/01aca80803a35bc194f181862c130866e0d55d5962172cd581aa99aa396cbd00" :answer-field/choices ["q-351430/field-1/01aca80803a35bc194f181862c130866e0d55d5962172cd581aa99aa396cbd00" "q-351430/field-1/897ce4c7911f99b265ba23f864c4eaa9aec53942cbd2bbe07376f6b49ce12837"] :db/ensure [:answer-field/validate]} {:db/id "q-351430" :question/id #uuid "6e25066f-b114-5d4b-8ff9-3e93d1808c46" :question/math-academy-id "q-351430" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=16-9{t}^{2}.$ Find the total displacement $d$ of the particle between $t=3$ and $t=4.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=3$ and $t=4.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{3}^{4}(16-9{t}^{2})\\,\\text{dt} \\\\  & ={(16t-3{t}^{3})|}_{3}^{4} \\\\  & =[16(4)-3(4)^{3}]-[16(3)-3(3)^{3}] \\\\  & =[64-192]-[48-81] \\\\  & =-95.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351430/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-351430"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120986/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" :answer/id #uuid "92a5264e-7d94-5c1d-a759-d572d6b86fb4" :answer/type :answer.type/math :answer/value "130" :db/ensure [:answer/validate]} {:db/id "q-120986/selection/803fd68e60ddd98339c8b9badd89a2f1b38028e5162f89904b8c6ceafd1a13a6" :answer/id #uuid "bfa31d4f-88e5-5fa5-a681-012e44d672fe" :answer/type :answer.type/math :answer/value "129" :db/ensure [:answer/validate]} {:db/id "q-120986/selection/af0f011a5755a82c97cfd0672ee135dd0cae8e8f07f0859802f8d8dfdd28807a" :answer/id #uuid "8ff009f7-6fe4-5510-9b6f-21a8925e221d" :answer/type :answer.type/math :answer/value "131" :db/ensure [:answer/validate]} {:db/id "q-120986/selection/772faee3af740960f7d296ca245df4da797a9e413368076cbaa828915d92739d" :answer/id #uuid "0343c5ae-1864-5196-a573-9139e23d2dcf" :answer/type :answer.type/math :answer/value "128" :db/ensure [:answer/validate]} {:db/id "q-120986/selection/aa56327b5902f25e2f7d95c792ef03ce1de9c18c97e2a74df0ef0eb1b77ad0a2" :answer/id #uuid "142ef266-14ba-56f6-a9bf-0f405ca6d929" :answer/type :answer.type/math :answer/value "127" :db/ensure [:answer/validate]} {:db/id "q-120986/selection" :answer-field/id #uuid "42c84250-2608-5f3a-a98b-b53e6e7aec7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120986/selection/803fd68e60ddd98339c8b9badd89a2f1b38028e5162f89904b8c6ceafd1a13a6" :answer-field/choices ["q-120986/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" "q-120986/selection/803fd68e60ddd98339c8b9badd89a2f1b38028e5162f89904b8c6ceafd1a13a6" "q-120986/selection/af0f011a5755a82c97cfd0672ee135dd0cae8e8f07f0859802f8d8dfdd28807a" "q-120986/selection/772faee3af740960f7d296ca245df4da797a9e413368076cbaa828915d92739d" "q-120986/selection/aa56327b5902f25e2f7d95c792ef03ce1de9c18c97e2a74df0ef0eb1b77ad0a2"] :db/ensure [:answer-field/validate]} {:db/id "q-120986" :question/id #uuid "1db46de8-934a-56e6-8549-c49709f0e59b" :question/math-academy-id "q-120986" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6{t}^{2}+t-\\frac{3}{2}.$ What is the total displacement of the particle between $t=1$ and $t=4?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{4}(6{t}^{2}+t-\\frac{3}{2})\\,\\text{d}t \\\\  & ={(2{t}^{3}+\\frac{1}{2}{t}^{2}-\\frac{3}{2}t)|}_{1}^{4} \\\\  & =[2(4)^{3}+\\frac{1}{2}(4)^{2}-\\frac{3}{2}(4)]-[2(1)^{3}+\\frac{1}{2}(1)^{2}-\\frac{3}{2}(1)] \\\\  & =[128+8-6]-[2+\\frac{1}{2}-\\frac{3}{2}] \\\\  & =130-1 \\\\  & =129.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=4$ is $129.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120986/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-120986"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121007/selection/510b62c0c0c4e1165f0bad010c2ebd41c83efc4563b19ba47bc93bafa05f87d5" :answer/id #uuid "eb5b1566-17c3-58b8-b00f-6cda1cf93271" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}+\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-121007/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "92a786cd-fd48-5d59-bc9a-24358582507e" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-121007/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5332815c-36c3-58d9-991f-722f4ba2c53d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-121007/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "fdb5ec3c-ac4f-533f-81f2-1fdb1ed88d23" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-121007/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3e1036c0-52e5-5d1c-8c38-60f8e5543902" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-121007/selection" :answer-field/id #uuid "cea03fbc-b338-53c9-a25a-30131b5aa091" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121007/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-121007/selection/510b62c0c0c4e1165f0bad010c2ebd41c83efc4563b19ba47bc93bafa05f87d5" "q-121007/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-121007/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-121007/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-121007/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-121007" :question/id #uuid "c1052200-d76a-59c5-989a-4d2d76d89a0b" :question/math-academy-id "q-121007" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{sin}⁡(t-\\frac{\\pi }{3}).$ At time $t=\\frac{\\pi }{3}$ the particle is located at the position $x=\\frac{1}{2}.$ What is the position of the particle at time $t=\\pi ?$" :question/worked-solution "The position of the particle at $t=\\pi $ is equal to its position at $t=\\frac{\\pi }{3}$ plus the total displacement over $t\\in [\\frac{\\pi }{3},\\pi ].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\pi )=x(\\frac{\\pi }{3})+{\\int }_{\\pi /3}^{\\pi }v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\pi ) & =\\frac{1}{2}+{\\int }_{\\pi /3}^{\\pi }\\operatorname{sin}⁡(t-\\frac{\\pi }{3})\\,\\text{d}t \\\\  & =\\frac{1}{2}+{[-\\operatorname{cos}⁡(t-\\frac{\\pi }{3})]}_{\\pi /3}^{\\pi } \\\\  & =\\frac{1}{2}+([-\\operatorname{cos}⁡(\\pi -\\frac{\\pi }{3})]-[-\\operatorname{cos}⁡(\\frac{\\pi }{3}-\\frac{\\pi }{3})]) \\\\  & =\\frac{1}{2}+(-\\operatorname{cos}⁡(\\frac{2\\pi }{3})+\\operatorname{cos}⁡(0)) \\\\  & =\\frac{1}{2}+(-(-\\frac{1}{2})+1) \\\\  & =\\frac{1}{2}+\\frac{1}{2}+1 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\pi $ is $x=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-121007/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-121007"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81506/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "0270f788-1cdb-528c-85e3-c5e8dda56681" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-81506/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "53db8982-8e73-5277-90aa-165c3b52a5d1" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-81506/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "a0ed76bd-8402-55cd-8079-0e89ab2fe6bc" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-81506/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "c3f2dd82-6236-5f56-9bce-6792b0bf2373" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-81506/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "237c114d-eacb-5eb4-8963-fe8655d0f624" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-81506/selection" :answer-field/id #uuid "8c76b68b-b8cf-58ee-b229-494f9f0c8abc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81506/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer-field/choices ["q-81506/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-81506/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" "q-81506/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-81506/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-81506/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-81506" :question/id #uuid "1394edaf-31dd-59b4-a755-2b8323ac548f" :question/math-academy-id "q-81506" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{cos}⁡(t-\\frac{\\pi }{6}).$ At time $t=0$ the particle is located at the position $x=3.$ What is the position of the particle at time $t=\\frac{\\pi }{6}?$" :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{6}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{6}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{6})=x(0)+{\\int }_{0}^{\\pi /6}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{6}) & =\\frac{7}{2}+{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(t-\\frac{\\pi }{6})\\,\\text{d}t \\\\  & =3+{[\\operatorname{sin}⁡(t-\\frac{\\pi }{6})]}_{0}^{\\pi /6} \\\\  & =3+([\\operatorname{sin}⁡(\\frac{\\pi }{6}-\\frac{\\pi }{6})]-[\\operatorname{sin}⁡(0-\\frac{\\pi }{6})]) \\\\  & =3+(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-\\frac{\\pi }{6})) \\\\  & =3+(0-(-\\frac{1}{2})) \\\\  & =3+\\frac{1}{2} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$\n\nSo the position of the particle at $t=\\frac{\\pi }{6}$ is $x=\\frac{7}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81506/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-81506"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121000/selection/f98aef0da1df0df55a2cdcd02104a9aec25f7d71776b26410e456f55e29a167c" :answer/id #uuid "db6b02a4-0d65-5140-b97d-2835c713ce2f" :answer/type :answer.type/math :answer/value "{e}^{2}+{e}^{14}" :db/ensure [:answer/validate]} {:db/id "q-121000/selection/7613fab5c0c245a277533a34ca6c3f8b38edaf41821a416b28e15c0d7af3e105" :answer/id #uuid "cdbe0437-44c0-53c4-ab8c-e387e22a1e97" :answer/type :answer.type/math :answer/value "{e}^{14}-{e}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-121000/selection/b4abc71f09b94b27534ba9df39503cf23800be5eca440e21e77d5c50893abaab" :answer/id #uuid "9267816a-01c3-543b-8f34-03bf72c8177c" :answer/type :answer.type/math :answer/value "{e}^{2}+{e}^{16}" :db/ensure [:answer/validate]} {:db/id "q-121000/selection/c113560fa589d059ed519338652ece3dae4c14d05f4104b1af3a8d059e7d93d3" :answer/id #uuid "74fa6180-72ce-544e-a360-9d65bcf920d0" :answer/type :answer.type/math :answer/value "{e}^{16}-{e}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-121000/selection/9d5e69b2d276fb6bde903a74cbdcabc64564aaaf5ce0ff1673b00dd9232f1eb6" :answer/id #uuid "ddf3911c-cd3c-5139-b3e9-a42a8efaa35d" :answer/type :answer.type/math :answer/value "3{e}^{2}+{e}^{14}" :db/ensure [:answer/validate]} {:db/id "q-121000/selection" :answer-field/id #uuid "d1ee0a4b-fcac-5fe8-9f33-bc672bd54359" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121000/selection/f98aef0da1df0df55a2cdcd02104a9aec25f7d71776b26410e456f55e29a167c" :answer-field/choices ["q-121000/selection/f98aef0da1df0df55a2cdcd02104a9aec25f7d71776b26410e456f55e29a167c" "q-121000/selection/7613fab5c0c245a277533a34ca6c3f8b38edaf41821a416b28e15c0d7af3e105" "q-121000/selection/b4abc71f09b94b27534ba9df39503cf23800be5eca440e21e77d5c50893abaab" "q-121000/selection/c113560fa589d059ed519338652ece3dae4c14d05f4104b1af3a8d059e7d93d3" "q-121000/selection/9d5e69b2d276fb6bde903a74cbdcabc64564aaaf5ce0ff1673b00dd9232f1eb6"] :db/ensure [:answer-field/validate]} {:db/id "q-121000" :question/id #uuid "d7d90ca4-6723-5cb8-bec5-48fa186d8bab" :question/math-academy-id "q-121000" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=3{e}^{3t-1}.$ At time $t=1$ the particle is located at the position $x=2{e}^{2}.$ What is the position of the particle at time $t=5?$" :question/worked-solution "The position of the particle at $t=5$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,5].$ Therefore, we can calculate it as follows:\n\n$$\nx(5)=x(1)+{\\int }_{1}^{5}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(5) & =2{e}^{2}+{\\int }_{1}^{5}3{e}^{3t-1}\\,\\text{d}t \\\\  & =2{e}^{2}+{[{e}^{3t-1}]}_{1}^{5} \\\\  & =2{e}^{2}+({e}^{3(5)-1}-{e}^{3(1)-1}) \\\\  & =2{e}^{2}+({e}^{14}-{e}^{2}) \\\\  & =2{e}^{2}+{e}^{14}-{e}^{2} \\\\  & ={e}^{2}+{e}^{14}.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=5$ is $x={e}^{2}+{e}^{14}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-121000/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-121000"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120998/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645" :answer/id #uuid "32f21e3a-1993-56f1-9adc-31ba974e5450" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120998/selection/22d430f68cf15bd94f5c47dab129d618edbe8215beea6518510e85bf00b7492c" :answer/id #uuid "8b2ba7c0-c86b-5233-bf50-b8c40aafc11b" :answer/type :answer.type/math :answer/value "{e}^{5}" :db/ensure [:answer/validate]} {:db/id "q-120998/selection/6dc5f80b50ae7b9c2e2149661796a1cf045c6ca0deedcfebf3c8af1e19e033e9" :answer/id #uuid "3958d845-9630-5738-a448-0eb61ee51e89" :answer/type :answer.type/math :answer/value "\\frac{{e}^{5}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120998/selection/154548f05388682f5019845134297ab00dadd7f4c3b85ecc988abe8ad62d6e89" :answer/id #uuid "6bd0dc61-87e5-5c07-a8ad-7609bcfb4a04" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}+{e}^{5}}{2}" :db/ensure [:answer/validate]} {:db/id "q-120998/selection/3801b324f109f0cb337bd87a9858609ee6ae3d04a6ac50da63ac75517c13e86d" :answer/id #uuid "97a307c9-ca06-58b0-b859-571f48287258" :answer/type :answer.type/math :answer/value "{e}^{2}+{e}^{5}" :db/ensure [:answer/validate]} {:db/id "q-120998/selection" :answer-field/id #uuid "dceeeff9-88af-5a13-b08e-b51205cce197" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120998/selection/154548f05388682f5019845134297ab00dadd7f4c3b85ecc988abe8ad62d6e89" :answer-field/choices ["q-120998/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645" "q-120998/selection/22d430f68cf15bd94f5c47dab129d618edbe8215beea6518510e85bf00b7492c" "q-120998/selection/6dc5f80b50ae7b9c2e2149661796a1cf045c6ca0deedcfebf3c8af1e19e033e9" "q-120998/selection/154548f05388682f5019845134297ab00dadd7f4c3b85ecc988abe8ad62d6e89" "q-120998/selection/3801b324f109f0cb337bd87a9858609ee6ae3d04a6ac50da63ac75517c13e86d"] :db/ensure [:answer-field/validate]} {:db/id "q-120998" :question/id #uuid "b71dab59-3f02-59fd-8bdb-cc10afd7de9b" :question/math-academy-id "q-120998" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)={e}^{2t+1}.$ At time $t=0.5$ the particle is located at the position $x={e}^{2}.$ What is the position of the particle at time $t=2?$" :question/worked-solution "The position of the particle at $t=2$ is equal to its position at $t=0.5$ plus the total displacement over $t\\in [0.5,2].$ Therefore, we can calculate it as follows:\n\n$$\nx(2)=x(0.5)+{\\int }_{0.5}^{2}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(2) & ={e}^{2}+{\\int }_{0.5}^{2}{e}^{2t+1}\\,\\text{d}t \\\\  & ={e}^{2}+{[\\frac{1}{2}{e}^{2t+1}]}_{0.5}^{2} \\\\  & ={e}^{2}+(\\frac{1}{2}{e}^{2(2)+1}-\\frac{1}{2}{e}^{2(0.5)+1}) \\\\  & ={e}^{2}+(\\frac{1}{2}{e}^{5}-\\frac{1}{2}{e}^{2}) \\\\  & =\\frac{1}{2}{e}^{2}+\\frac{1}{2}{e}^{5} \\\\  & =\\frac{{e}^{2}+{e}^{5}}{2}.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=2$ is $x=\\frac{{e}^{2}+{e}^{5}}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-120998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351444/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1a523402-a02c-58ca-94c8-838c42b88218" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-351444/field-1" :answer-field/id #uuid "80abbd92-009c-502c-86f0-4e5acd35fb54" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351444/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-351444/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-351444" :question/id #uuid "6c22f5c7-8e2f-57c6-9f32-c32dfce8fdb7" :question/math-academy-id "q-351444" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{sec}⁡(t)\\operatorname{tan}⁡(t).$ At time $t=0$ the particle is located at the position $x=3.$ \nFind the position of the particle at time $t=\\frac{\\pi }{3}.$ Do not round the answer.\n\nThe position of the particle at $t=\\frac{\\pi }{3}$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{3}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{3}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{3})=x(0)+{\\int }_{0}^{\\pi /3}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{3}) & =3+{\\int }_{0}^{\\pi /3}\\operatorname{sec}⁡(t)\\operatorname{tan}⁡(t)\\,\\text{d}t \\\\  & =3+{[\\operatorname{sec}⁡(t)]}_{0}^{\\pi /3} \\\\  & =3+\\operatorname{sec}⁡(\\frac{\\pi }{3})-\\operatorname{sec}⁡(0) \\\\  & =3+2-1 \\\\  & =4.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\frac{\\pi }{3}$ is $x=4.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351444/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-351444"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351479/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "223f4a43-6417-5d6b-ba39-d6f634131c7a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-351479/field-1" :answer-field/id #uuid "c97e55e1-83e4-5b1f-87bb-5fca19f7d550" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351479/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-351479/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-351479" :question/id #uuid "d8794558-968e-5ecd-93b4-65457650283b" :question/math-academy-id "q-351479" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/4c50effa85cc82dfc22a65f3792780a99b2876b77de173993b43dead23b0c1d7.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0,$ the particle is located at the position $x=-4.$ What is the position of the particle at time $t=6?$\n\nThe position of the particle at $t=6$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(0)+{\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-4$, and we can compute the integral ${\\int }_{0}^{6}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{6}v(t)\\,\\text{d}t=10.\n$$\n\nTherefore,\n\n$$\nx(6)=-4+10=6.\n$$\n\nSo the position of the particle at $t=6$ is $x=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351479/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-351479"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348321/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "890b7b85-ee59-546f-a0f6-e52a7a51dab7" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-348321/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "83a6f011-1d09-56e7-a775-9ab675b9e15d" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-348321/field-1" :answer-field/id #uuid "07e26a32-524b-516d-b2d3-3acb9bd5f749" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348321/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-348321/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-348321/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-348321" :question/id #uuid "2c89b745-0982-5313-bdde-182c5954d58e" :question/math-academy-id "q-348321" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/e51b807bc238b140215a8a753fcfe778b14735e723dd5cb43b8aab22039a8e8e.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0,$ the particle is located at the position $x=-2.$ What is the position of the particle at time $t=4?$\n\nThe position of the particle at $t=4$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(0)+{\\int }_{0}^{4}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-2$, and we can compute the integral ${\\int }_{0}^{4}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=4.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{4}v(t)\\,\\text{d}t=12.\n$$\n\nTherefore,\n\n$$\nx(4)=-2+12=10.\n$$\n\nSo the position of the particle at $t=4$ is $x=10.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-348321/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-348321"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "8c7a87d3-b68d-5195-83e7-152409780892" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-351502/field-1" :answer-field/id #uuid "7039c3d1-bba1-5467-98bc-f366bc511544" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-351502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-351502" :question/id #uuid "55b41cfa-7d43-5343-98ee-d2393e32d6b8" :question/math-academy-id "q-351502" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/005c8cf386537414fb0504fa26095f54fbeeaa0f88941bef41fffaf75f791ed3.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=2,$ the particle is located at the position $x=8.$ What is the position of the particle at time $t=7?$\n\nThe position of the particle at $t=7$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(2)+{\\int }_{2}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(2)=8$, and we can compute the integral ${\\int }_{2}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=2$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{2}^{7}v(t)\\,\\text{d}t=-3.\n$$\n\nTherefore,\n\n$$\nx(7)=8+(-3)=5.\n$$\n\nSo the position of the particle at $t=7$ is $x=5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351502/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-351502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81509/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "743493e3-075b-53e2-af57-e10c534f77b7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-81509/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "b1a015ad-6d6f-54f6-a0fa-4049989b6947" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81509/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e25f6d64-c605-522c-86f4-c3f86038592a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-81509/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "cd2c0fd5-d417-5242-890a-9ba274bf8aa6" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-81509/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d1ad5343-d3a0-5ef8-8e06-0b5a445ca0e2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-81509/selection" :answer-field/id #uuid "5bc57005-e790-5437-a053-97dc77545aa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81509/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-81509/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-81509/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-81509/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-81509/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-81509/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-81509" :question/id #uuid "5341cef1-205c-5e6a-a5f6-442c5b5b09a7" :question/math-academy-id "q-81509" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/b8e6f6b7ab2081595723002737bcb73bbced52bfea0f8cfeb91b1201adab0160.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0$ the particle is located at the position $x=-2.$ What is the position of the particle at time $t=6?$" :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(0)+{\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-2$, and we can compute the integral ${\\int }_{0}^{6}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{6}v(t)\\,\\text{d}t=9.\n$$\n\nTherefore,\n\n$$\nx(6)=-2+9=7\n$$\n\nSo the position of the particle at $t=6$ is $x=7.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81509/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-81509"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351500/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "94c3dfa6-d744-563e-8870-7a4c45e49b76" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-351500/field-1" :answer-field/id #uuid "5f2154d2-aa53-5a7e-8fd0-63167567795b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351500/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-351500/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-351500" :question/id #uuid "43c09f96-3c8c-5786-ba4e-2b3a4e2251a3" :question/math-academy-id "q-351500" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/4245a22d62605e68022fc2f02358f8f900e5370a02c04c973d0ea359249f62b6.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0,$ the particle is located at the position $x=4.$ What is the position of the particle at time $t=4?$\n\nThe position of the particle at $t=4$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(0)+{\\int }_{0}^{4}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=4$, and we can compute the integral ${\\int }_{0}^{4}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=4.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{4}v(t)\\,\\text{d}t=-1.\n$$\n\nTherefore,\n\n$$\nx(4)=4+(-1)=3.\n$$\n\nSo the position of the particle at $t=4$ is $x=3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351500/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606"] :knowledge-point/questions ["q-351500"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-568"] :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t) = 2t + 3t^2.$ What is the total displacement of the particle between $t=1$ and $t=3?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then, we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{3}(2t+3{t}^{2})\\,\\text{d}t \\\\  & ={({t}^{2}+{t}^{3})|}_{1}^{3} \\\\  & =[{3}^{2}+{3}^{3}]-[{1}^{2}+{1}^{3}] \\\\  & =[9+27]-[1+1] \\\\  & =36-2 \\\\  & =34.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=3$ is $34.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7128"] :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t) = 6t^2 +4t.$ At time $t=2$ the particle is located at the position $x=-20.$ What is the position of the particle at time $t=4?$" :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=2$ plus the total displacement over $t\\in[2,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4) = x(2) + \\int_2^4 v(t)\\,\\textrm{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(4) & =-20+{\\int }_{2}^{4}(6{t}^{2}+4t)\\,\\text{dt} \\\\  & =-20+{[2{t}^{3}+2{t}^{2}]}_{2}^{4} \\\\  & =-20+([2(4)^{3}+2(4)^{2}]-[2(2)^{3}+2(2)^{2}]) \\\\  & =-20+([128+32]-[16+8]) \\\\  & =-20+(160-24) \\\\  & =-20+136 \\\\  & =116.\\end{aligned}\n$$\n\nSo the position of the particle at $t=4$ is $x=116.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7129"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014400/assets/900988cb8ec54abcafc256a34c685829d2f5f00cdca373ad84dfa0ef70cc3957.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=2$ the particle is located at the position $x=-1.$ What is the position of the particle at time $t=8?$" :question/worked-solution "The position of the particle at $t = 8$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,8].$ Therefore, we can calculate it as follows:\n\n$$\nx(8) = x(2)+ \\int_2^8 v(t) \\, \\textrm d t\n$$\n\nWe are told that $x(2)=-1$, and we can compute the integral $\\displaystyle\\int_2^8 v(t) \\, \\textrm dt$ by finding the signed area under the graph from $t=2$ to $t=8.$ Computing the signed area, we get\n\n$$\n\\int_2^8 v(t) \\, \\textrm dt = 6.\n$$\n\nTherefore,\n\n$$\nx(8) = -1+ 6 = 5\n$$\n\nSo the position of the particle at $t=8$ is $x=5.$" :db/ensure [:question/validate]}]
