[{:db/id [:question/math-academy-id "q-1886"] :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+{x}^{-1}) \\\\  & =11(-\\operatorname{sin}⁡x)-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}} \\\\  & =-11\\operatorname{sin}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\sqrt{3}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{3}) & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{(\\sqrt{3})^{2}} \\\\  & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-340597/field-1/22149d37d94b84c35183e96b799d9a285ec552b60a21820db22a993b90fd0aa5" :answer/id #uuid "8e32c7b0-d847-59b5-aff1-affd9a0d520b" :answer/type :answer.type/math :answer/value "\\frac{\\cot(x)}{x}" :db/ensure [:answer/validate]} {:db/id "q-340597/field-1/a2eef97c68bcff9d4b3dca0888f08850b8c6a9f20099bf7ee97f13d961062f77" :answer/id #uuid "6d712dac-64a8-5447-a94c-6b07820135e0" :answer/type :answer.type/math :answer/value "\\cot(x)" :db/ensure [:answer/validate]} {:db/id "q-340597/field-1" :answer-field/id #uuid "83938fdb-db25-5c80-90c2-ddb9b4cf74b4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340597/field-1/22149d37d94b84c35183e96b799d9a285ec552b60a21820db22a993b90fd0aa5" :answer-field/choices ["q-340597/field-1/22149d37d94b84c35183e96b799d9a285ec552b60a21820db22a993b90fd0aa5" "q-340597/field-1/a2eef97c68bcff9d4b3dca0888f08850b8c6a9f20099bf7ee97f13d961062f77"] :db/ensure [:answer-field/validate]} {:db/id "q-340597" :question/id #uuid "82740349-bfa0-5913-911f-c267c09d2564" :question/math-academy-id "q-340597" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}} $-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cot}⁡(x)+\\operatorname{ln}⁡(x)(-{csc}^{2}⁡(x)) \\\\  & =\\frac{\\operatorname{cot}⁡(x)}{x}-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340597/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-340597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340598/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7" :answer/id #uuid "b0bf62fa-4d2d-5aca-ac18-3ea9859c7535" :answer/type :answer.type/math :answer/value "x\\csc(x)^2" :db/ensure [:answer/validate]} {:db/id "q-340598/field-1" :answer-field/id #uuid "8fd3b6a1-d1c7-53a3-a9e7-4f834d43a6bc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340598/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7" :answer-field/choices ["q-340598/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7"] :db/ensure [:answer-field/validate]} {:db/id "q-340598" :question/id #uuid "bd7b9a8e-cad8-598c-9c66-6deb13873f47" :question/math-academy-id "q-340598" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=x\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{cot}⁡(x)\\,-$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}⁡(x)) \\\\  & =1\\operatorname{cot}⁡(x)+x(-{csc}^{2}⁡(x)) \\\\  & =\\operatorname{cot}⁡(x)-x{csc}^{2}⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340598/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-340598"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340608/field-1/5c82e9c5aa3a2a31da6b043d283d51074164dfb8ed10f30a22255e51fc7d4072" :answer/id #uuid "b3c3d35c-0c2b-551c-b96f-25778e8c9421" :answer/type :answer.type/math :answer/value "2\\sec(x)\\tan(x)" :db/ensure [:answer/validate]} {:db/id "q-340608/field-1/e0b8098112246dae04f2e9088130b76f82db8121874225c384f47616b4f70703" :answer/id #uuid "f0a08b44-bcdb-5e13-b8a5-4274a2a9102f" :answer/type :answer.type/math :answer/value "2\\sec(x)" :db/ensure [:answer/validate]} {:db/id "q-340608/field-1" :answer-field/id #uuid "7ec82aab-899c-5455-b5e5-96cde7ab375f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340608/field-1/5c82e9c5aa3a2a31da6b043d283d51074164dfb8ed10f30a22255e51fc7d4072" :answer-field/choices ["q-340608/field-1/5c82e9c5aa3a2a31da6b043d283d51074164dfb8ed10f30a22255e51fc7d4072" "q-340608/field-1/e0b8098112246dae04f2e9088130b76f82db8121874225c384f47616b4f70703"] :db/ensure [:answer-field/validate]} {:db/id "q-340608" :question/id #uuid "cdee49b8-704f-5af8-8d33-74c2683a30d1" :question/math-academy-id "q-340608" :question/problem "Find the derivative of $y=2\\operatorname{sec}⁡(x)-{4}^{x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}\n$-\\,{4}^{x}\\operatorname{ln}⁡4$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(2\\operatorname{sec}⁡(x)-{4}^{x}) \\\\  & =2\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)-{4}^{x}\\operatorname{ln}⁡4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340608/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1"] :knowledge-point/questions ["q-340608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340630/field-1/1953a14819a93a238036f7b8d81005341e9276340d12e52169740e6eb74421b2" :answer/id #uuid "696e1b50-3abb-57df-8b09-4345c20f1859" :answer/type :answer.type/math :answer/value "e^{\\pi}" :db/ensure [:answer/validate]} {:db/id "q-340630/field-1" :answer-field/id #uuid "84381e9c-9747-5461-a96f-85fd6d6ffe41" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340630/field-1/1953a14819a93a238036f7b8d81005341e9276340d12e52169740e6eb74421b2" :answer-field/choices ["q-340630/field-1/1953a14819a93a238036f7b8d81005341e9276340d12e52169740e6eb74421b2"] :db/ensure [:answer-field/validate]} {:db/id "q-340630" :question/id #uuid "e0e8616a-19f7-5eb1-8f4a-f0c15587a103" :question/math-academy-id "q-340630" :question/problem "Find the slope $m$ of $y=h(x)$ at $x=\\pi $ if $h(x)={e}^{x}+3\\operatorname{sec}⁡x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+3\\operatorname{sec}⁡x) \\\\  & ={e}^{x}+3\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nNow, we substitute $x=\\pi $ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={h}^{′}(\\pi ) & ={e}^{\\pi }+3\\operatorname{sec}⁡(\\pi )\\operatorname{tan}⁡(\\pi ) \\\\  & ={e}^{\\pi }+3\\cdot (-1)\\cdot 0 \\\\  & ={e}^{\\pi }\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340630/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8"] :knowledge-point/questions ["q-340630"] :db/ensure [:knowledge-point/validate]}]
