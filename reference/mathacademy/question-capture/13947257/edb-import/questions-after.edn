#{[{:db/id #edb/ref 17592186115445 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e499a37d-96a0-5012-ba77-d25cfcb420dc" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\sin (\\sqrt{3}) + \\sec (\\sqrt{3})\\tan (\\sqrt{3}) + \\frac{1}{3}" :db/id #edb/ref 17592186112114} {:answer/id #uuid "fa27f6a8-d503-5baa-8fbb-e15073d785a9" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\sin (\\sqrt{3}) - \\csc (\\sqrt{3})\\cot (\\sqrt{3}) - 1" :db/id #edb/ref 17592186112115} {:answer/id #uuid "454932e3-9bf7-5b2b-a320-7f1d5d9e22dc" :answer/type {:db/ident :answer.type/math} :answer/value "11\\sin (\\sqrt{3}) - \\sec (\\sqrt{3})\\tan (\\sqrt{3}) - \\frac{1}{3}" :db/id #edb/ref 17592186112116} {:answer/id #uuid "6c2e6e18-9e68-54d8-995a-711f8ab8b999" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\sin (\\sqrt{3}) - \\sec (\\sqrt{3})\\tan (\\sqrt{3}) - \\frac{1}{3}" :db/id #edb/ref 17592186112117} {:answer/id #uuid "7cecdf19-d971-5304-a04b-f4ea8fcf22bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin (\\sqrt{3}) - \\csc (\\sqrt{3})\\cot (\\sqrt{3}) - \\frac{1}{3}" :db/id #edb/ref 17592186112118}] :answer-field/correct {:answer/id #uuid "6c2e6e18-9e68-54d8-995a-711f8ab8b999" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\sin (\\sqrt{3}) - \\sec (\\sqrt{3})\\tan (\\sqrt{3}) - \\frac{1}{3}" :db/id #edb/ref 17592186112117} :answer-field/id #uuid "dcf18747-d547-5053-9576-fffe0ade5642" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112113}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c56fab41-d998-532e-9118-40493f1a0626" :question/math-academy-id "q-1886" :question/problem "Find the slope of $y = f(x)$ at $x = \\sqrt{3}$ if $f(x) = 11\\cos x - \\sec x + \\frac{1}{x}$." :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+{x}^{-1}) \\\\  & =11(-\\operatorname{sin}⁡x)-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}} \\\\  & =-11\\operatorname{sin}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\sqrt{3}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{3}) & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{(\\sqrt{3})^{2}} \\\\  & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253239 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e32c7b0-d847-59b5-aff1-affd9a0d520b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot(x)}{x}" :db/id #edb/ref 17592186253241} {:answer/id #uuid "6d712dac-64a8-5447-a94c-6b07820135e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\cot(x)" :db/id #edb/ref 17592186253242}] :answer-field/correct {:answer/id #uuid "8e32c7b0-d847-59b5-aff1-affd9a0d520b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot(x)}{x}" :db/id #edb/ref 17592186253241} :answer-field/id #uuid "83938fdb-db25-5c80-90c2-ddb9b4cf74b4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253240}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82740349-bfa0-5913-911f-c267c09d2564" :question/math-academy-id "q-340597" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}} $-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cot}⁡(x)+\\operatorname{ln}⁡(x)(-{csc}^{2}⁡(x)) \\\\  & =\\frac{\\operatorname{cot}⁡(x)}{x}-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253243 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0bf62fa-4d2d-5aca-ac18-3ea9859c7535" :answer/type {:db/ident :answer.type/math} :answer/value "x\\csc(x)^2" :db/id #edb/ref 17592186253245}] :answer-field/correct {:answer/id #uuid "b0bf62fa-4d2d-5aca-ac18-3ea9859c7535" :answer/type {:db/ident :answer.type/math} :answer/value "x\\csc(x)^2" :db/id #edb/ref 17592186253245} :answer-field/id #uuid "8fd3b6a1-d1c7-53a3-a9e7-4f834d43a6bc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253244}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bd7b9a8e-cad8-598c-9c66-6deb13873f47" :question/math-academy-id "q-340598" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=x\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{cot}⁡(x)\\,-$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}⁡(x)) \\\\  & =1\\operatorname{cot}⁡(x)+x(-{csc}^{2}⁡(x)) \\\\  & =\\operatorname{cot}⁡(x)-x{csc}^{2}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253246 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3c3d35c-0c2b-551c-b96f-25778e8c9421" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec(x)\\tan(x)" :db/id #edb/ref 17592186253248} {:answer/id #uuid "f0a08b44-bcdb-5e13-b8a5-4274a2a9102f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec(x)" :db/id #edb/ref 17592186253249}] :answer-field/correct {:answer/id #uuid "b3c3d35c-0c2b-551c-b96f-25778e8c9421" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec(x)\\tan(x)" :db/id #edb/ref 17592186253248} :answer-field/id #uuid "7ec82aab-899c-5455-b5e5-96cde7ab375f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253247}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cdee49b8-704f-5af8-8d33-74c2683a30d1" :question/math-academy-id "q-340608" :question/problem "Find the derivative of $y=2\\operatorname{sec}⁡(x)-{4}^{x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}\n$-\\,{4}^{x}\\operatorname{ln}⁡4$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(2\\operatorname{sec}⁡(x)-{4}^{x}) \\\\  & =2\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)-{4}^{x}\\operatorname{ln}⁡4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253250 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "696e1b50-3abb-57df-8b09-4345c20f1859" :answer/type {:db/ident :answer.type/math} :answer/value "e^{\\pi}" :db/id #edb/ref 17592186253252}] :answer-field/correct {:answer/id #uuid "696e1b50-3abb-57df-8b09-4345c20f1859" :answer/type {:db/ident :answer.type/math} :answer/value "e^{\\pi}" :db/id #edb/ref 17592186253252} :answer-field/id #uuid "84381e9c-9747-5461-a96f-85fd6d6ffe41" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e0e8616a-19f7-5eb1-8f4a-f0c15587a103" :question/math-academy-id "q-340630" :question/problem "Find the slope $m$ of $y=h(x)$ at $x=\\pi $ if $h(x)={e}^{x}+3\\operatorname{sec}⁡x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+3\\operatorname{sec}⁡x) \\\\  & ={e}^{x}+3\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nNow, we substitute $x=\\pi $ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={h}^{′}(\\pi ) & ={e}^{\\pi }+3\\operatorname{sec}⁡(\\pi )\\operatorname{tan}⁡(\\pi ) \\\\  & ={e}^{\\pi }+3\\cdot (-1)\\cdot 0 \\\\  & ={e}^{\\pi }\\end{aligned}\n$$"}]}
