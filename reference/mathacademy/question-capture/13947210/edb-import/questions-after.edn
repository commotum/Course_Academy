#{[{:db/id #edb/ref 17592186253113 :knowledge-point/_questions [{:knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9" :knowledge-point/title "Writing the Area Bounded by a Curve as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f37ba1-7389-55d1-bf28-49281e0e8906" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186253115} {:answer/id #uuid "eae215c7-3278-5d4b-8e49-bebe4be46528" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186253116} {:answer/id #uuid "67bde883-eb69-5a08-b447-620c886549d5" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186253117} {:answer/id #uuid "b6323d20-174b-5e5e-8caa-d3eb68eb2af3" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186253118} {:answer/id #uuid "42a33424-33f8-581b-83a4-b211b10c281e" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186253119}] :answer-field/correct {:answer/id #uuid "39f37ba1-7389-55d1-bf28-49281e0e8906" :answer/type {:db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186253115} :answer-field/id #uuid "afb01917-1448-59a3-8eb9-891c0d800e0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253114}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a4e017c-6a5f-5409-9dd7-4b0236299620" :question/math-academy-id "q-113868" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/assets/149fd953075c1d9909e036d4935ccd4f17ad1734d86bba4a70254468cd2035d5.png)\n\nFor the function $f(x)={x}^{2}-2x+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)={x}^{2}-2x+2$ and the $x$-axis, between $x=0$ and $x=3.$\n\nThis can be expressed as the definite integral of $f(x)={x}^{2}-2x+2$ between the lower limit $x=0$ and the upper limit $x=3,$ as follows:\n\n$$\nA={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x\n$$"}] [{:db/id #edb/ref 17592186253120 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf514bb4-ecac-5d78-a01e-f1fa6b00f140" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{3i}{n}" :db/id #edb/ref 17592186253122}] :answer-field/correct {:answer/id #uuid "cf514bb4-ecac-5d78-a01e-f1fa6b00f140" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{3i}{n}" :db/id #edb/ref 17592186253122} :answer-field/id #uuid "82711246-7818-567e-acca-65c5baf0326d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253121}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5ba8ef0d-4afc-57f3-a6e1-978f702b493c" :question/math-academy-id "q-315830" :question/problem "What is ${\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?\n\n*Hint: Write down the missing expression in terms of $i$ and $n.$*\n\n${\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[9($\n{{field-1}}\n$)^{\\,3}\\cdot \\frac{3}{n}]$" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=9{x}^{3},$ the lower bound is $a=1$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-1}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(1+i\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(1+\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[9{(1+\\frac{3i}{n})}^{\\,3}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253123 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d10c97e6-7ea4-5522-8feb-1d49481b5656" :answer/type {:db/ident :answer.type/math} :answer/value "2^x-1" :db/id #edb/ref 17592186253125} {:answer/id #uuid "1fb83b21-9c07-50dc-ae3b-faa6b4be20c0" :answer/type {:db/ident :answer.type/math} :answer/value "2^x+1" :db/id #edb/ref 17592186253126}] :answer-field/correct {:answer/id #uuid "1fb83b21-9c07-50dc-ae3b-faa6b4be20c0" :answer/type {:db/ident :answer.type/math} :answer/value "2^x+1" :db/id #edb/ref 17592186253126} :answer-field/id #uuid "f085c8ab-d5da-55c2-b14f-64548a810098" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253124} {:answer-field/choices [{:answer/id #uuid "aba5708e-7651-5cf7-ad88-1fb8cca73e9f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186253128}] :answer-field/correct {:answer/id #uuid "aba5708e-7651-5cf7-ad88-1fb8cca73e9f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186253128} :answer-field/id #uuid "9749fad5-d5c5-57bf-af31-496187f79966" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253127}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "088d1080-7491-5e6a-87a2-5180d45dc341" :question/math-academy-id "q-346180" :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[({2}^{\\,2+3k/n}+1)\\cdot \\frac{3}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-2}{n}\\,⟹\\,b=5.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{3k}{n}$ and $f({x}_{k})={2}^{\\,{x}_{k}}+1.$\n\nHence,\n\n$$\n{\\int }_{2}^{5}({2}^{x}+1)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[({2}^{\\,2+3k/n}+1)\\cdot \\frac{3}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)={2}^{x}+1\\,\\text{and}\\,b=5.\n$$"}] [{:db/id #edb/ref 17592186253129 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e1bd4e8-308d-5c6c-956b-c26f5db48a9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3i}{n}+1}" :db/id #edb/ref 17592186253131}] :answer-field/correct {:answer/id #uuid "9e1bd4e8-308d-5c6c-956b-c26f5db48a9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3i}{n}+1}" :db/id #edb/ref 17592186253131} :answer-field/id #uuid "1775c1a2-f343-5dea-be06-9959b482b353" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186253130}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf543ae6-1922-5af8-939a-ac9fd71c7458" :question/math-academy-id "q-346217" :question/problem "What is ${\\int }_{0}^{3}\\sqrt{x+1}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?\n\n*Hint: Write down the missing expression in terms of $i$ and $n.$*\n\n${\\int }_{0}^{3}\\sqrt{x+1}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[$\n{{field-1}}\n$\\cdot \\frac{3}{n}]$" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\sqrt{x+1}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\sqrt{x+1},$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\sqrt{x+1}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(0+i\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[\\sqrt{(\\frac{3i}{n})+1}\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[\\,\\sqrt{\\frac{3i}{n}+1}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253132 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b56a3151-5814-59fc-88ba-aebf11366a97" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(4+\\frac{i}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186253134} {:answer/id #uuid "82ebdcaf-b482-57eb-98df-f65933397451" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(4+\\frac{2i}{n})}^{3}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186253135} {:answer/id #uuid "de159c55-43fd-584f-8e60-eaebe4587b4c" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{2i}{n})}^{3}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186253136} {:answer/id #uuid "d6d4e26a-b7e1-51ab-9297-09acc18a83c0" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{4i}{n})}^{3}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186253137} {:answer/id #uuid "0207cb9c-0b84-5359-b682-c32d3ce263ad" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{4i}{n})}^{3}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186253138}] :answer-field/correct {:answer/id #uuid "0207cb9c-0b84-5359-b682-c32d3ce263ad" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{4i}{n})}^{3}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186253138} :answer-field/id #uuid "6432bc15-72ba-5a44-80cc-f4524349aad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253133}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fd742197-ec3d-517e-9c40-387f07be0a49" :question/math-academy-id "q-49188" :question/problem "What is ${\\int }_{2}^{6}{x}^{3}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral,\n\n$$\n{\\int }_{2}^{6}{x}^{3}\\,\\text{d}x\n$$\n\nthe function is $f(x)={x}^{3},$ the lower bound is $a=2,$ and the upper bound is $b=6.$ So, we have\n\n$$\nΔx=\\frac{6-2}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{6}{x}^{3}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+i\\cdot \\frac{4}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(2+\\frac{4i}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{(2+\\frac{4i}{n})}^{3}\\cdot \\frac{4}{n}].\\end{aligned}\n$$"}]}
