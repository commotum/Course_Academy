#{[{:db/id #edb/ref 17592186105516 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/id #uuid "2f380683-0d93-541d-a07d-95a1d889c761" :question/math-academy-id "e-4347" :question/problem "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 5 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 5 \\\\ 2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & 5 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0\\cdot 3-5\\cdot 2)i-(-1\\cdot 3-5\\cdot 1)j+(-1\\cdot 2-0\\cdot 2)k \\\\  & =-10i+8j-2k \\\\  & =⟨-10,8,-2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,-3,2⟩\\cdot ⟨-10,8,-2⟩ \\\\  & =2\\cdot (-10)+(-3)\\cdot 8+2\\cdot (-2) \\\\  & =-48\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105517 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/id #uuid "b5cf98f2-087d-580c-a2f6-c37ad2af4c2c" :question/math-academy-id "e-4348" :question/problem "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle,$ $\\mathbf{b}=\\langle 0,2,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,-1,2 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ -1 & -1\\end{aligned}| \\\\  & =4\\cdot (2\\cdot 2-1\\cdot (-1))-2\\cdot (0\\cdot 2-1\\cdot (-1))+(-1)\\cdot (0\\cdot (-1)-2\\cdot (-1)) \\\\  & =20-2-2 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105518 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/id #uuid "483b758a-9b14-5a72-87e5-70f27a0acf48" :question/math-academy-id "e-4349" :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304191 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90f0afc5-4656-543f-a49f-9eee4180bf76" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186304193} {:answer/id #uuid "0a14adde-3810-5b1e-bd89-e2843f937518" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186304194} {:answer/id #uuid "881870ac-8284-5c7f-8007-136126d0ea05" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186304195} {:answer/id #uuid "edfb4202-cb27-5cc0-bde4-ca941d27f96c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304196} {:answer/id #uuid "2de79a48-14f8-54e0-aa83-af11058a7ab3" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186304197}] :answer-field/correct {:answer/id #uuid "0a14adde-3810-5b1e-bd89-e2843f937518" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186304194} :answer-field/id #uuid "67dcf842-2021-54ce-9858-ddad9d53d962" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304192}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b61d4cca-1715-5a06-b2df-88fdd39e1048" :question/math-academy-id "q-128091" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-1,1,0⟩$ and $b\\times c=⟨6,1,7⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,1,0⟩\\cdot ⟨6,1,7⟩ \\\\  & =(-1)\\cdot 6+1\\cdot 1+0\\cdot 7 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304198 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e118f94d-2048-5a3a-a394-e96c34ce74ec" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186304200} {:answer/id #uuid "2a9a86bd-e4dd-5b70-9c8f-03dcbd187802" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186304201} {:answer/id #uuid "b2d4a3ad-54f8-5c36-a5d9-415ef55329ad" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186304202} {:answer/id #uuid "0ff6e5ef-9b92-5652-ac71-bc6ffbf3e67e" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186304203} {:answer/id #uuid "2e0a864d-7b4e-5687-a4ef-0160a2030963" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186304204}] :answer-field/correct {:answer/id #uuid "2e0a864d-7b4e-5687-a4ef-0160a2030963" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186304204} :answer-field/id #uuid "7430bbde-5a67-51e4-b790-320ba7a6b533" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304199}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b6555f10-a1fa-5bc9-8ada-7a83a75f69ff" :question/math-academy-id "q-128107" :question/problem "Let $a=⟨0,9,3⟩,$ $b=⟨3,2,0⟩$ and $c=⟨-1,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & 9 & 3 \\\\ 3 & 2 & 0 \\\\ -1 & 1 & 1\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}|-9\\cdot |\\begin{aligned}3 & 0 \\\\ -1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}3 & 2 \\\\ -1 & 1\\end{aligned}| \\\\  & =0-9(3\\cdot 1-(-1)\\cdot 0)+3(3\\cdot 1-(-1)\\cdot 2) \\\\  & =0-27+15 \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304205 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "307e26f4-c461-5a01-b0a5-15e3451f1c01" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186304207} {:answer/id #uuid "a8ea9abd-6fa0-5d34-9fb9-9a7441effb4e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186304208} {:answer/id #uuid "96d92675-86aa-56dd-82d7-588f1dfbfa8a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304209} {:answer/id #uuid "f10bf2bf-b0f6-5415-8eee-ab26967034a0" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186304210} {:answer/id #uuid "91afc43d-0f19-593a-920a-d6ab4cfc23fe" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186304211}] :answer-field/correct {:answer/id #uuid "307e26f4-c461-5a01-b0a5-15e3451f1c01" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186304207} :answer-field/id #uuid "e1436432-8ed2-5096-aaba-d7fa49b6fe08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304206}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a361636d-1a95-5368-bca2-c8b79fdc532a" :question/math-academy-id "q-128353" :question/problem "Find $b\\cdot (a\\times c),$ if $b\\times c=⟨2,5,1⟩$ and $a=⟨6,1,-9⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨6,1,-9⟩\\cdot ⟨2,5,1⟩ \\\\  & =6\\cdot 2+1\\cdot 5+(-9)\\cdot 1 \\\\  & =12+5-9 \\\\  & =8.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304212 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a97dd138-70f2-5d39-8ba1-22919ce2fa27" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186304214} {:answer/id #uuid "93887c8c-3dd7-5829-88d6-832b484164cb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186304215} {:answer/id #uuid "c16e8bc2-ebc8-5175-85b1-ab014e408913" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186304216} {:answer/id #uuid "d31af9ee-b637-534f-b2ef-8fc4ae864f4b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186304217} {:answer/id #uuid "1e83007f-d2c6-5839-9037-7656b6766b65" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304218}] :answer-field/correct {:answer/id #uuid "93887c8c-3dd7-5829-88d6-832b484164cb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186304215} :answer-field/id #uuid "0bd0ac1c-3cb4-51e7-aa4a-416abf6f0134" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304213}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3510e83f-4adc-58a8-b3a5-d0db2be677d4" :question/math-academy-id "q-18658" :question/problem "Find $b\\cdot (a\\times c)$, if $4a\\cdot (-b\\times c)=12.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot (-b\\times c) & =12 \\\\ 4\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =12 \\\\ a\\cdot (b\\times c) & =-3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304219 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c89423b4-26aa-522a-be83-1360885c4bd6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304221} {:answer/id #uuid "42c3ae34-7148-58cf-9d02-57efda67c00b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186304222} {:answer/id #uuid "041da844-cbfe-5946-95f5-ca6f67f627c8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186304223} {:answer/id #uuid "442075d9-a403-50f7-b7a0-4c449288a392" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186304224} {:answer/id #uuid "f02ebfae-6f31-53ef-aabb-0407202f3bdf" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186304225}] :answer-field/correct {:answer/id #uuid "c89423b4-26aa-522a-be83-1360885c4bd6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304221} :answer-field/id #uuid "5459f548-e194-5b1c-a8b8-01ff4adf4dac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304220}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0499489a-bd96-5735-9749-10c55bf514d1" :question/math-academy-id "q-20054" :question/problem "Let $a=⟨1,-1,2⟩$, $b=⟨2,0,3⟩$ and $c=⟨2,4,2⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -1 & 2 \\\\ 2 & 0 & 3 \\\\ 2 & 4 & 2\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 3 \\\\ 4 & 2\\end{aligned}|-(-1)\\cdot |\\begin{aligned}2 & 3 \\\\ 2 & 2\\end{aligned}|+2\\cdot |\\begin{aligned}2 & 0 \\\\ 2 & 4\\end{aligned}| \\\\  & =(0\\cdot 2-4\\cdot 3)+(2\\cdot 2-2\\cdot 3)+2(2\\cdot 4-2\\cdot 0) \\\\  & =-12-2+16 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304226 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50658792-0b67-53e7-9bdb-d6e1498799cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186304228} {:answer/id #uuid "8c705504-2cea-5ddc-b08e-6a1bbb835cc2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304229} {:answer/id #uuid "576a5111-d4c2-5668-9925-b9538a10c1d9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186304230} {:answer/id #uuid "c8f1f0d1-3db2-5d07-ae5b-b9c0bbc13997" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304231} {:answer/id #uuid "f766aff7-43ec-5b06-92f4-8605b195de2e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186304232}] :answer-field/correct {:answer/id #uuid "8c705504-2cea-5ddc-b08e-6a1bbb835cc2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186304229} :answer-field/id #uuid "a9c0bec4-04ae-5d8c-abbb-183894124b71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304227}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5391e15f-b363-59a8-afb1-a8c023a79cd5" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106054 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4c646ac-4924-5beb-ab82-3024e1aa470c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0,3⟩" :db/id #edb/ref 17592186304234} {:answer/id #uuid "6dcacbaa-3747-5649-a2ea-8b7d5c799da0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186304235} {:answer/id #uuid "8a948465-ab38-59c7-aabf-d6de85d3c057" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186304236} {:answer/id #uuid "c1b1cbdf-b262-5a6a-a5cb-f588acc687c1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304237} {:answer/id #uuid "3814e6ea-5b3e-5d30-8a99-ce585f078d23" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186304238}] :answer-field/correct {:answer/id #uuid "c1b1cbdf-b262-5a6a-a5cb-f588acc687c1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304237} :answer-field/id #uuid "0a2e049e-6e1c-5365-babf-6b3c0a8fc445" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304233}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0db80f94-e2a5-583e-875d-ce7dd7157cf9" :question/math-academy-id "q-20062" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨2,3,0⟩$ and $a=⟨1,-2,2⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-2,2⟩\\cdot ⟨2,3,0⟩ \\\\  & =1\\cdot 2+(-2)\\cdot 3+2\\cdot 0 \\\\  & =2-6+0 \\\\  & =-4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304239 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "389f693e-9078-5445-84f9-a0f36799d5f7" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186304241}] :answer-field/correct {:answer/id #uuid "389f693e-9078-5445-84f9-a0f36799d5f7" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186304241} :answer-field/id #uuid "f516d5dd-4666-5956-813c-d02cb321c80e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304240}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "10d286f0-6ed4-510a-ac67-f6953032b8fe" :question/math-academy-id "q-275347" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{3},0,-2⟩$ and $b\\times c=⟨-\\sqrt{3},10,-10⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{3},0,-2⟩\\cdot ⟨-\\sqrt{3},10,-10⟩ \\\\  & =(-\\sqrt{3})\\cdot (-\\sqrt{3})+0\\cdot 10+(-2)\\cdot (-10) \\\\  & =3+0+20 \\\\  & =23.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304242 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbeeda96-dbe4-5b72-9f65-cd85629ba459" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304244}] :answer-field/correct {:answer/id #uuid "dbeeda96-dbe4-5b72-9f65-cd85629ba459" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186304244} :answer-field/id #uuid "0995d429-cc7b-57b6-8b79-3a213671fe6a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304243}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "984e3979-5fe3-5ba9-8275-9fcd2e849e10" :question/math-academy-id "q-275348" :question/problem "Given that $a=⟨1,2,3⟩,$ $b=⟨-1,0,-2⟩,$ and $c=⟨0,-2,1⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & -2 \\\\ 0 & -2 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|i-|\\begin{aligned}-1 & -2 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =(0\\cdot 1-(-2)\\cdot (-2))i-((-1)\\cdot 1-0\\cdot (-2))j+((-1)\\cdot (-2)-0\\cdot 0)k \\\\  & =-4i+j+2k \\\\  & =⟨-4,1,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,2,3⟩\\cdot ⟨-4,1,2⟩ \\\\  & =1\\cdot (-4)+2\\cdot 1+3\\cdot 2 \\\\  & =-4+2+6 \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304245 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153294e5-909d-5b07-ae99-571bf9b99f45" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186304247} {:answer/id #uuid "66d41bbc-2a8f-52c4-a72d-23d6c15ad830" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186304248}] :answer-field/correct {:answer/id #uuid "153294e5-909d-5b07-ae99-571bf9b99f45" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186304247} :answer-field/id #uuid "d553ff3d-e763-5af9-a85d-a45810e2fb25" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304246}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "240e2b4d-3d29-500d-9c2c-877f809bd3bf" :question/math-academy-id "q-317303" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{8},\\,4,\\,-3⟩$ and $b\\times c=⟨\\sqrt{8},\\,-1,\\,2⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{8},\\,4,\\,-3⟩\\cdot ⟨\\sqrt{8},\\,-1,\\,2⟩ \\\\  & =(-\\sqrt{8})(\\sqrt{8})+(4)(-1)+(-3)(2) \\\\  & =-8-4-6 \\\\  & =-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304249 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5e229d0-a506-5e03-9071-15585d25d697" :answer/type {:db/ident :answer.type/math} :answer/value "-55" :db/id #edb/ref 17592186304251}] :answer-field/correct {:answer/id #uuid "e5e229d0-a506-5e03-9071-15585d25d697" :answer/type {:db/ident :answer.type/math} :answer/value "-55" :db/id #edb/ref 17592186304251} :answer-field/id #uuid "b3ee681a-c9b9-51fc-b6a6-9e12927c6b8e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304250}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "88193e81-25d5-5df0-a1c5-d28dab59ccb3" :question/math-academy-id "q-317315" :question/problem "Let $a=⟨1,2,3⟩$, $b=⟨4,0,1⟩$ and $c=⟨-2,-1,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 2 & 3 \\\\ 4 & 0 & 1 \\\\ -2 & -1 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 5\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}4 & 1 \\\\ -2 & 5\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & 0 \\\\ -2 & -1\\end{aligned}| \\\\  & =1\\,(0\\cdot 5-1\\cdot (-1))\\,-\\,2\\,(4\\cdot 5-1\\cdot (-2))\\,+\\,3\\,(4\\cdot (-1)-0\\cdot (-2)) \\\\  & =1\\,(1)\\,-\\,2\\,(22)\\,+\\,3\\,(-4) \\\\  & =1-44-12 \\\\  & =-55.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304252 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1295f0c8-5405-5e5f-99c1-5d971d8e8a45" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186304254} {:answer/id #uuid "2334afd9-0be7-54c0-b5f2-0035f77eb0ee" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186304255}] :answer-field/correct {:answer/id #uuid "1295f0c8-5405-5e5f-99c1-5d971d8e8a45" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186304254} :answer-field/id #uuid "abdf043b-d193-5249-a5fe-a761777736d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304253}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c99f8fbd-de15-5333-b100-1f2625b9ef0c" :question/math-academy-id "q-317320" :question/problem "Let $a=⟨1,0,2⟩$, $b=⟨3,1,0⟩$ and $c=⟨4,2,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 0 & 2 \\\\ 3 & 1 & 0 \\\\ 4 & 2 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}3 & 0 \\\\ 4 & 5\\end{aligned}|\\,+\\,2\\cdot |\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}| \\\\  & =1\\,(1\\cdot 5-0\\cdot 2)\\,-\\,0\\,(3\\cdot 5-0\\cdot 4)\\,+\\,2\\,(3\\cdot 2-1\\cdot 4) \\\\  & =1\\,(5)\\,-\\,0\\,(15)\\,+\\,2\\,(2) \\\\  & =5+0+4 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304256 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37dd9177-27bb-5c11-a5af-74fd39fc21a3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186304258}] :answer-field/correct {:answer/id #uuid "37dd9177-27bb-5c11-a5af-74fd39fc21a3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186304258} :answer-field/id #uuid "bd22a88c-c336-5a56-968c-7db26415a16b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304257}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "42c3db24-6dfd-52a2-9331-ea0749a5ae8a" :question/math-academy-id "q-317322" :question/problem "Let $a=⟨2,1,0⟩$, $b=⟨0,3,4⟩$ and $c=⟨5,2,1⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & 1 & 0 \\\\ 0 & 3 & 4 \\\\ 5 & 2 & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}3 & 4 \\\\ 2 & 1\\end{aligned}|\\,-\\,1\\cdot |\\begin{aligned}0 & 4 \\\\ 5 & 1\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}0 & 3 \\\\ 5 & 2\\end{aligned}| \\\\  & =2\\,(3\\cdot 1-4\\cdot 2)\\,-\\,1\\,(0\\cdot 1-4\\cdot 5)\\,+\\,0\\,(0\\cdot 2-3\\cdot 5) \\\\  & =2\\,(-5)\\,-\\,1\\,(-20)\\,+\\,0\\,(-15) \\\\  & =-10+20+0 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304259 :knowledge-point/_questions [{:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7dade22-d1bc-5476-aa3a-80fa146ae3e7" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186304261} {:answer/id #uuid "b3b51c6c-ec85-532c-a3a2-109f6ee9651d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186304262} {:answer/id #uuid "6bcaca84-82ea-527b-8310-d0ba91808967" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186304263} {:answer/id #uuid "fd5f1cc5-b09b-5578-bafd-6097163da847" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186304264} {:answer/id #uuid "f93da9c0-5b52-54a1-8611-0b33b9a26683" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186304265}] :answer-field/correct {:answer/id #uuid "fd5f1cc5-b09b-5578-bafd-6097163da847" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186304264} :answer-field/id #uuid "f0b25707-afd8-58f4-9725-b6da5cc4e591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304260}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d142398a-ca91-5f2e-84b2-8e19bee3bf64" :question/math-academy-id "q-73457" :question/problem "Given that $a=⟨1,-3,2⟩,$ $b=⟨2,-1,-1⟩,$ and $c=⟨3,-3,0⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 2 & -1 & -1 \\\\ 3 & -3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ -3 & 0\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}|j+|\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|k \\\\  & =((-1)\\cdot 0-(-1)\\cdot (-3))i-(2\\cdot 0-(-1)\\cdot 3)j+(2\\cdot (-3)-(-1)\\cdot 3)k \\\\  & =-3i-3j-3k \\\\  & =⟨-3,-3,-3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-3,2⟩\\cdot ⟨-3,-3,-3⟩ \\\\  & =1\\cdot (-3)+(-3)\\cdot (-3)+2\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186304266 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b10548b2-ba23-57c9-8e9f-efb6408540fa" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186304268} {:answer/id #uuid "882fee4d-a313-5036-8aa0-6990f6344c53" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186304269} {:answer/id #uuid "7c36065e-c546-5040-892d-0afeb58e039c" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186304270} {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} {:answer/id #uuid "d27156bd-b73a-55a3-8410-555a0fa4c033" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186304272}] :answer-field/correct {:answer/id #uuid "257852e8-5d5a-5e0d-bf36-26c0bddadb95" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186304271} :answer-field/id #uuid "3bf5f324-5e79-5cde-aeed-51d58a38a052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304267}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b76eac9-1fca-591a-8edf-8b517293adda" :question/math-academy-id "q-73470" :question/problem "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨3,-1,2⟩$ and $a=⟨4,-2,6⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨4,-2,6⟩\\cdot ⟨3,-1,2⟩ \\\\  & =4\\cdot 3+(-2)\\cdot (-1)+6\\cdot 2 \\\\  & =12+2+12 \\\\  & =26.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-26.\\end{aligned}\n$$"}]}
