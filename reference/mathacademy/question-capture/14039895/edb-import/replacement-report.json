      "source": [
        {
          "question": "e-4347",
          "field": null,
          "attribute": "question/problem",
          "value": "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4347.json",
