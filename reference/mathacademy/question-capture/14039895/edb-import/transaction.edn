 \\\\ 3 & -3\\end{aligned}|k \\\\  & =((-1)\\cdot 0-(-1)\\cdot (-3))i-(2\\cdot 0-(-1)\\cdot 3)j+(2\\cdot (-3)-(-1)\\cdot 3)k \\\\  & =-3i-3j-3k \\\\  & =⟨-3,-3,-3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-3,2⟩\\cdot ⟨-3,-3,-3⟩ \\\\  & =1\\cdot (-3)+(-3)\\cdot (-3)+2\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73457/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a"] :knowledge-point/questions ["q-73457"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128091/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "edfb4202-cb27-5cc0-bde4-ca941d27f96c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-128091/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "90f0afc5-4656-543f-a49f-9eee4180bf76" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-128091/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "881870ac-8284-5c7f-8007-136126d0ea05" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-128091/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "2de79a48-14f8-54e0-aa83-af11058a7ab3" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-128091/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "0a14adde-3810-5b1e-bd89-e2843f937518" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-128091/selection" :answer-field/id #uuid "67dcf842-2021-54ce-9858-ddad9d53d962" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128091/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-128091/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-128091/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-128091/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-128091/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-128091/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-128091" :question/id #uuid "b61d4cca-1715-5a06-b2df-88fdd39e1048" :question/math-academy-id "q-128091" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-1,1,0⟩$ and $b\\times c=⟨6,1,7⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,1,0⟩\\cdot ⟨6,1,7⟩ \\\\  & =(-1)\\cdot 6+1\\cdot 1+0\\cdot 7 \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128091/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a"] :knowledge-point/questions ["q-128091"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317303/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "153294e5-909d-5b07-ae99-571bf9b99f45" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-317303/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "66d41bbc-2a8f-52c4-a72d-23d6c15ad830" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-317303/field-1" :answer-field/id #uuid "d553ff3d-e763-5af9-a85d-a45810e2fb25" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317303/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer-field/choices ["q-317303/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" "q-317303/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-317303" :question/id #uuid "240e2b4d-3d29-500d-9c2c-877f809bd3bf" :question/math-academy-id "q-317303" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{8},\\,4,\\,-3⟩$ and $b\\times c=⟨\\sqrt{8},\\,-1,\\,2⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{8},\\,4,\\,-3⟩\\cdot ⟨\\sqrt{8},\\,-1,\\,2⟩ \\\\  & =(-\\sqrt{8})(\\sqrt{8})+(4)(-1)+(-3)(2) \\\\  & =-8-4-6 \\\\  & =-18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317303/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a"] :knowledge-point/questions ["q-317303"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275348/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "dbeeda96-dbe4-5b72-9f65-cd85629ba459" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-275348/field-1" :answer-field/id #uuid "0995d429-cc7b-57b6-8b79-3a213671fe6a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275348/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-275348/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-275348" :question/id #uuid "984e3979-5fe3-5ba9-8275-9fcd2e849e10" :question/math-academy-id "q-275348" :question/problem "Given that $a=⟨1,2,3⟩,$ $b=⟨-1,0,-2⟩,$ and $c=⟨0,-2,1⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & -2 \\\\ 0 & -2 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|i-|\\begin{aligned}-1 & -2 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =(0\\cdot 1-(-2)\\cdot (-2))i-((-1)\\cdot 1-0\\cdot (-2))j+((-1)\\cdot (-2)-0\\cdot 0)k \\\\  & =-4i+j+2k \\\\  & =⟨-4,1,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,2,3⟩\\cdot ⟨-4,1,2⟩ \\\\  & =1\\cdot (-4)+2\\cdot 1+3\\cdot 2 \\\\  & =-4+2+6 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275348/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a"] :knowledge-point/questions ["q-275348"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317315/field-1/7ee6622554f39804e400676996a1a7f900f775eaafda5cb592144ecba3fe5943" :answer/id #uuid "e5e229d0-a506-5e03-9071-15585d25d697" :answer/type :answer.type/math :answer/value "-55" :db/ensure [:answer/validate]} {:db/id "q-317315/field-1" :answer-field/id #uuid "b3ee681a-c9b9-51fc-b6a6-9e12927c6b8e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317315/field-1/7ee6622554f39804e400676996a1a7f900f775eaafda5cb592144ecba3fe5943" :answer-field/choices ["q-317315/field-1/7ee6622554f39804e400676996a1a7f900f775eaafda5cb592144ecba3fe5943"] :db/ensure [:answer-field/validate]} {:db/id "q-317315" :question/id #uuid "88193e81-25d5-5df0-a1c5-d28dab59ccb3" :question/math-academy-id "q-317315" :question/problem "Let $a=⟨1,2,3⟩$, $b=⟨4,0,1⟩$ and $c=⟨-2,-1,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 2 & 3 \\\\ 4 & 0 & 1 \\\\ -2 & -1 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 5\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}4 & 1 \\\\ -2 & 5\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}4 & 0 \\\\ -2 & -1\\end{aligned}| \\\\  & =1\\,(0\\cdot 5-1\\cdot (-1))\\,-\\,2\\,(4\\cdot 5-1\\cdot (-2))\\,+\\,3\\,(4\\cdot (-1)-0\\cdot (-2)) \\\\  & =1\\,(1)\\,-\\,2\\,(22)\\,+\\,3\\,(-4) \\\\  & =1-44-12 \\\\  & =-55.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317315/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68"] :knowledge-point/questions ["q-317315"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20054/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "f02ebfae-6f31-53ef-aabb-0407202f3bdf" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-20054/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "442075d9-a403-50f7-b7a0-4c449288a392" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-20054/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "041da844-cbfe-5946-95f5-ca6f67f627c8" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-20054/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c89423b4-26aa-522a-be83-1360885c4bd6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-20054/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff3