[{:db/id "q-275347/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "389f693e-9078-5445-84f9-a0f36799d5f7" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-275347/field-1" :answer-field/id #uuid "f516d5dd-4666-5956-813c-d02cb321c80e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275347/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer-field/choices ["q-275347/field-1/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e"] :db/ensure [:answer-field/validate]} {:db/id "q-275347" :question/id #uuid "10d286f0-6ed4-510a-ac67-f6953032b8fe" :question/math-academy-id "q-275347" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{3},0,-2⟩$ and $b\\times c=⟨-\\sqrt{3},10,-10⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{3},0,-2⟩\\cdot ⟨-\\sqrt{3},10,-10⟩ \\\\  & =(-\\sqrt{3})\\cdot (-\\sqrt{3})+0\\cdot 10+(-2)\\cdot (-10) \\\\  & =3+0+20 \\\\  & =23.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275347/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a"] :knowledge-point/questions ["q-275347"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73457/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "6bcaca84-82ea-527b-8310-d0ba91808967" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-73457/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fd5f1cc5-b09b-5578-bafd-6097163da847" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-73457/selectio