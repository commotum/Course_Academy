a83a75f69ff" :question/math-academy-id "q-128107" :question/problem "Let $a=⟨0,9,3⟩,$ $b=⟨3,2,0⟩$ and $c=⟨-1,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & 9 & 3 \\\\ 3 & 2 & 0 \\\\ -1 & 1 & 1\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}|-9\\cdot |\\begin{aligned}3 & 0 \\\\ -1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}3 & 2 \\\\ -1 & 1\\end{aligned}| \\\\  & =0-9(3\\cdot 1-(-1)\\cdot 0)+3(3\\cdot 1-(-1)\\cdot 2) \\\\  & =0-27+15 \\\\  & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128107/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68"] :knowledge-point/questions ["q-128107"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317320/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "1295f0c8-5405-5e5f-99c1-5d971d8e8a45" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-317320/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "2334afd9-0be7-54c0-b5f2-0035f77eb0ee" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-317320/field-1" :answer-field/id #uuid "abdf043b-d193-5249-a5fe-a761777736d5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317320/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-317320/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-317320/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-317320" :question/id #uuid "c99f8fbd-de15-5333-b100-1f2625b9ef0c" :question/math-academy-id "q-317320" :question/problem "Let $a=⟨1,0,2⟩$, $b=⟨3,1,0⟩$ and $c=⟨4,2,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & 0 & 2 \\\\ 3 & 1 & 0 \\\\ 4 & 2 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}3 & 0 \\\\ 4 & 5\\end{aligned}|\\,+\\,2\\cdot |\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}| \\\\  & =1\\,(1\\cdot 5-0\\cdot 2)\\,-\\,0\\,(3\\cdot 5-0\\cdot 4)\\,+\\,2\\,(3\\cdot 2-1\\cdot 4) \\\\  & =1\\,(5)\\,-\\,0\\,(15)\\,+\\,2\\,(2) \\\\  & =5+0+4 \\\\  & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317320/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68"] :knowledge-point/questions ["q-317320"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317322/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "37dd9177-27bb-5c11-a5af-74fd39fc21a3" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-317322/field-1" :answer-field/id #uuid "bd22a88c-c336-5a56-968c-7db26415a16b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317322/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-317322/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-317322" :question/id #uuid "42c3db24-6dfd-52a2-9331-ea0749a5ae8a" :question/math-academy-id "q-317322" :question/problem "Let $a=⟨2,1,0⟩$, $b=⟨0,3,4⟩$ and $c=⟨5,2,1⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & 1 & 0 \\\\ 0 & 3 & 4 \\\\ 5 & 2 & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}3 & 4 \\\\ 2 & 1\\end{aligned}|\\,-\\,1\\cdot |\\begin{aligned}0 & 4 \\\\ 5 & 1\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}0 & 3 \\\\ 5 & 2\\end{aligned}| \\\\  & =2\\,(3\\cdot 1-4\\cdot 2)\\,-\\,1\\,(0\\cdot 1-4\\cdot 5)\\,+\\,0\\,(0\\cdot 2-3\\cdot 5) \\\\  & =2\\,(-5)\\,-\\,1\\,(-20)\\,+\\,0\\,(-15) \\\\  & =-10+20+0 \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317322/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68"] :knowledge-point/questions ["q-317322"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186106054 :question/answer-fields 17592186102561] {:db/id "q-20062/selection/ma-v1/3a812008182d2a6261a437909452d7ed1bea824cff5db7cbbc5282fa4c864415/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "8a948465-ab38-59c7-aabf-d6de85d3c057" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-20062/selection/ma-v1/3a812008182d2a6261a437909452d7ed1bea824cff5db7cbbc5282fa4c864415/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "3814e6ea-5b3e-5d30-8a99-ce585f078d23" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-20062/selection/ma-v1/3a812008182d2a6261a437909452d7ed1bea824cff5db7cbbc5282fa4c864415/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c1b1cbdf-b262-5a6a-a5cb-f588acc687c1" :answe