\,(2) \\\\  & =5+0+4 \\\\  & =9.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317320" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-317320" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317320" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317322" "field" nil "attribute" "question/problem" "value" "Let $a=⟨2,1,0⟩$, $b=⟨0,3,4⟩$ and $c=⟨5,2,1⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317322" "field" nil "attribute" "question/worked-solution" "value" "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & 1 & 0 \\\\ 0 & 3 & 4 \\\\ 5 & 2 & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}3 & 4 \\\\ 2 & 1\\end{aligned}|\\,-\\,1\\cdot |\\begin{aligned}0 & 4 \\\\ 5 & 1\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}0 & 3 \\\\ 5 & 2\\end{aligned}| \\\\  & =2\\,(3\\cdot 1-4\\cdot 2)\\,-\\,1\\,(0\\cdot 1-4\\cdot 5)\\,+\\,0\\,(0\\cdot 2-3\\cdot 5) \\\\  & =2\\,(-5)\\,-\\,1\\,(-20)\\,+\\,0\\,(-15) \\\\  & =-10+20+0 \\\\  & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317322" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-317322" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-317322" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20062" "field" nil "attribute" "question/problem" "value" "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨2,3,0⟩$ and $a=⟨1,-2,2⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20062" "field" nil "attribute" "question/worked-solution" "value" "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-2,2⟩\\cdot ⟨2,3,0⟩ \\\\  & =1\\cdot 2+(-2)\\cdot 3+2\\cdot 0 \\\\  & =2-6+0 \\\\  & =-4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20062" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-20062" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20062" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-6"] ["math" "4"] ["math" "6"] ["math" "⟨1,0,3⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20062" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20059" "field" nil "attribute" "question/problem" "value" "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20059" "field" nil "attribute" "question/worked-solution" "value" "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20059" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-20059" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20059" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "2\\sqrt{2}"] ["math" "3\\sqrt{2}"] ["math" "4"] ["math" "\\sqrt{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-20059" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-128353" "field" nil "attribute" "question/problem" "value" "Find $b\\cdot (a\\times c),$ if $b\\times c=⟨2,5,1⟩$ and $a=⟨6,1,-9⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-128353" "field" nil "attribute" "question/worked-solution" "value" "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨6,1,-9⟩\\cdot ⟨2,5,1⟩ \\\\  & =6\\cdot 2+1\\cdot 5+(-9)\\cdot 1 \\\\  & =12+5-9 \\\\  & =8.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=-8.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-128353" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-128353" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-128353" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-6"] ["math" "-8"] ["math" "2"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-128353" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-8"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-18658" "field" nil "attribute" "question/problem" "value" "Find $b\\cdot (a\\times c)$, if $4a\\cdot (-b\\times c)=12.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-18658" "field" nil "attribute" "question/worked-solution" "value" "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot (-b\\times c) & =12 \\\\ 4\\cdot (-1)\\cdot [a\\cdot (b\\times c)] & =12 \\\\ a\\cdot (b\\times c) & =-3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-18658" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-18658" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-18658" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-4"] ["math" "12"] ["math" "3"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-18658" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-73470" "field" nil "attribute" "question/problem" "value" "Find $c\\cdot (b\\times a)$, if $b\\times c=⟨3,-1,2⟩$ and $a=⟨4,-2,6⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-73470" "field" nil "attribute" "question/worked-solution" "value" "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨4,-2,6⟩\\cdot ⟨3,-1,2⟩ \\\\  & =4\\cdot 3+(-2)\\cdot (-1)+6\\cdot 2 \\\\  & =12+2+12 \\\\  & =26.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-26.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-73470" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/activity-metadata.json" "file_sha256" "fae40cd04e4e1c69e8a0e56e457e0e2bc2a1d4d365105fc1daf64e5b26622205"} {"question" "q-73470" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-73470" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-24"] ["math" "-26"] ["math" "-28"] ["math" "24"] ["math" "26"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "q-73470" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-26"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/state.json" "file_sha256" "436608b4e551d4d9f7ccbcbb13f947280b5c70e3e2dea9ab49252754b462ddb2"} {"question" "e-4347" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4347.json" "file_sha256" "d4705456f237f065369fffd00b9c0e532f7ab38c6c7219209b6eb1c0b6db3770"} {"question" "e-4347" "field" nil "attribute" "question/worked-solution" "value" "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 5 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 5 \\\\ 2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & 5 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0\\cdot 3-5\\cdot 2)i-(-1\\cdot 3-5\\cdot 1)j+(-1\\cdot 2-0\\cdot 2)k \\\\  & =-10i+8j-2k \\\\  & =⟨-10,8,-2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,-3,2⟩\\cdot ⟨-10,8,-2⟩ \\\\  & =2\\cdot (-10)+(-3)\\cdot 8+2\\cdot (-2) \\\\  & =-48\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4347.json" "file_sha256" "d4705456f237f065369fffd00b9c0e532f7ab38c6c7219209b6eb1c0b6db3770"} {"question" "e-4348" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle,$ $\\mathbf{b}=\\langle 0,2,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,-1,2 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4348.json" "file_sha256" "922b032e0f89f05a5503894e6de4b750b9c2bb1ae6d144bfcb1284c21d61e247"} {"question" "e-4348" "field" nil "attribute" "question/worked-solution" "value" "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ -1 & -1\\end{aligned}| \\\\  & =4\\cdot (2\\cdot 2-1\\cdot (-1))-2\\cdot (0\\cdot 2-1\\cdot (-1))+(-1)\\cdot (0\\cdot (-1)-2\\cdot (-1)) \\\\  & =20-2-2 \\\\  & =16.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4348.json" "file_sha256" "922b032e0f89f05a5503894e6de4b750b9c2bb1ae6d144bfcb1284c21d61e247"} {"question" "e-4349" "field" nil "attribute" "question/problem" "value" "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4349.json" "file_sha256" "1604454f39a58ed2126a0d96d9da93bc5198700e121d1c5cca06e2b7d004d468"} {"question" "e-4349" "field" nil "attribute" "question/worked-solution" "value" "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039895/example-4349.json" "file_sha256" "1604454f39a58ed2126a0d96d9da93bc5198700e121d1c5cca06e2b7d004d468"}] "usage" {"e-4347" [] "q-20062" [] "e-4348" [] "e-4349" []} "basis" 1386 "retractions" [[17592186106054 :question/problem "Find $\\mathbf{c} \\cdot  ( \\mathbf{b} \\times  \\mathbf{a} )$, if $\\mathbf{b} \\times  \\mathbf{c} = \\langle  2 , 3 , 0 \\rangle$ and $\\mathbf{a} = \\langle  1 , - 2 , 2 \\rangle  .$."] [17592186106054 :question/answer-fields 17592186102561] [17592186105516 :question/problem "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle$, $\\mathbf{b}=\\langle -1,0,5 \\rangle$, and $\\mathbf{c}=\\langle 1,2,3 \\rangle$. Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$."] [17592186105516 :question/worked-solution "First, we find the cross product:\n\n$$\\begin{array}{rl}\\mathbf{b} \\times  \\mathbf{c} & = \\left\\vert \\begin{array}{ccc}\\mathbf{i} & \\mathbf{j} & \\mathbf{k} \\\\ - 1 & 0 & 5 \\\\ 1 & 2 & 3\\end{array}\\right\\vert \\\\  & = \\left\\vert \\begin{array}{cc}0 & 5 \\\\ 2 & 3\\end{array}\\right\\vert \\mathbf{i} - \\left\\vert \\begin{array}{cc}- 1 & 5 \\\\ 1 & 3\\end{array}\\right\\vert \\mathbf{j} + \\left\\vert \\begin{array}{cc}- 1 & 0 \\\\ 1 & 2\\end{array}\\right\\vert \\mathbf{k} \\\\  & = ( 0 \\cdot  3 - 5 \\cdot  2 ) \\mathbf{i} - ( - 1 \\cdot  3 - 5 \\cdot  1 ) \\mathbf{j} + ( - 1 \\cdot  2 - 0 \\cdot  2 ) \\mathbf{k} \\\\  & = - 10 \\mathbf{i} + 8 \\mathbf{j} - 2 \\mathbf{k} \\\\  & = \\langle  - 10 , 8 , - 2 \\rangle\\end{array}$$\n\nNow, we can compute the scalar triple product:\n\n$$\\begin{array}{rl}\\mathbf{a} \\cdot  ( \\mathbf{b} \\times  \\mathbf{c} ) & = \\langle  2 , - 3 , 2 \\rangle  \\cdot  \\langle  - 10 , 8 , - 2 \\rangle \\\\  & = 2 \\cdot  ( - 10 ) + ( - 3 ) \\cdot  8 + 2 \\cdot  ( - 2 ) \\\\  & = - 48\\end{array}$$"] [17592186105517 :question/problem "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle$, $\\mathbf{b}=\\langle 0,2,1 \\rangle$, and $\\mathbf{c}=\\langle -1,-1,2 \\rangle$. Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$."] [17592186105517 :question/worked-solution "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a}$, $\\mathbf{b}$, and $\\mathbf{c}$.\n\nSo, we have\n\n$$\\begin{array}{rl}\\mathbf{a} \\cdot  ( \\mathbf{b} \\times  \\mathbf{c} ) & = \\left\\vert \\begin{array}{ccc}4 & 2 & - 1 \\\\ 0 & 2 & 1 \\\\ - 1 & - 1 & 2\\end{array}\\right\\vert \\\\  & = 4 \\cdot  \\left\\vert \\begin{array}{cc}2 & 1 \\\\ - 1 & 2\\end{array}\\right\\vert - 2 \\cdot  \\left\\vert \\begin{array}{cc}0 & 1 \\\\ - 1 & 2\\end{array}\\right\\vert + ( - 1 ) \\cdot  \\left\\vert \\begin{array}{cc}0 & 2 \\\\ - 1 & - 1\\end{array}\\right\\vert \\\\  & = 4 \\cdot  ( 2 \\cdot  2 - 1 \\cdot  ( - 1 ) ) - 2 \\cdot  ( 0 \\cdot  2 - 1 \\cdot  ( - 1 ) ) + ( - 1 ) \\cdot  ( 0 \\cdot  ( - 1 ) - 2 \\cdot  ( - 1 ) ) \\\\  & = 20 - 2 - 2 \\\\  & = 16.\\end{array}$$"] [17592186105518 :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b})$, if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5$."] [17592186105518 :question/worked-solution "First, we factor out the constants and get\n\n$$\\begin{array}{rl}2 \\mathbf{a} \\cdot  ( \\mathbf{b} \\times  3 \\mathbf{c} ) & = 5 \\\\ 2 \\cdot  [ \\mathbf{a} \\cdot  ( \\mathbf{b} \\times  3 \\mathbf{c} ) ] & = 5 \\\\ 2 \\cdot  3 \\cdot  [ \\mathbf{a} \\cdot  ( \\mathbf{b} \\times  \\mathbf{c} ) ] & = 5 \\\\ \\mathbf{a} \\cdot  ( \\mathbf{b} \\times  \\mathbf{c} ) & = \\frac{5}{6} .\\end{array}$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\\begin{array}{rl}\\mathbf{c} \\cdot  ( \\mathbf{b} \\times  \\mathbf{a} ) & = - \\frac{5}{6} ,\\end{array}$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\\begin{array}{rl}\\mathbf{c} \\cdot  ( \\mathbf{a} \\times  \\mathbf{b} ) & = \\frac{5}{6} .\\end{array}$$"]] "immutable_answers" [17592186102562 17592186102563 17592186102564 17592186102565 17592186102566] "immutable_fields" [[17592186102561 :answer-field/correct] [17592186102561 :answer-field/id] [17592186102561 :answer-field/key] [17592186102561 :answer-field/type]] "no_history" []}
