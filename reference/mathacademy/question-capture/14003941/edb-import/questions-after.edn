#{[{:db/id #edb/ref 17592186286730 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d82834f1-b2b3-5b5d-9cb2-c72398f8e78d" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186286732} {:answer/id #uuid "bcf762d6-2202-5830-ad6c-71c341c76e54" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{4}{3}" :db/id #edb/ref 17592186286733} {:answer/id #uuid "9260dd16-e2e9-5a4b-98f8-6875507d737e" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186286734} {:answer/id #uuid "1df8c7c4-b2bc-5111-9db0-2ca281f6312d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{13}{3}" :db/id #edb/ref 17592186286735} {:answer/id #uuid "be0289d0-a2ee-5f04-bce2-2736b2f135d9" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186286736}] :answer-field/correct {:answer/id #uuid "be0289d0-a2ee-5f04-bce2-2736b2f135d9" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186286736} :answer-field/id #uuid "8b8924d7-56e4-5ee9-9b20-c78a2fd21829" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286731}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "68843262-33a9-52ed-b912-10cbb4823187" :question/math-academy-id "q-102416" :question/problem "Find the root of $f(x)=\\sqrt[7]{3x+13}-1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[7]{3x+13}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[7]{3x+13}-1 & =0 \\\\ \\sqrt[7]{3x+13} & =1 \\\\ (\\sqrt[7]{3x+13})^{7} & ={1}^{7} \\\\ 3x+13 & =1 \\\\ 3x & =-12 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-4.$"}] [{:db/id #edb/ref 17592186286737 :knowledge-point/_questions [{:knowledge-point/id #uuid "d02418c3-4c04-57b8-8f10-18858b1759ab" :knowledge-point/title "Utilizing the Periodicity Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41a4fd97-5dde-5337-9561-6af6e35dc88d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186286739} {:answer/id #uuid "8dbe0cc2-f858-534e-9c81-033367cb24a5" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186286740} {:answer/id #uuid "c16b9f73-fe1c-572a-8399-fd006ea980ab" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186286741} {:answer/id #uuid "e11e9d72-db85-5cc5-bd92-a9fcd8ab87bb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286742} {:answer/id #uuid "a52d1a6f-b6ef-5b5c-8fdf-766eb0c4c4b4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186286743}] :answer-field/correct {:answer/id #uuid "e11e9d72-db85-5cc5-bd92-a9fcd8ab87bb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286742} :answer-field/id #uuid "478da998-206e-5c78-bb68-6ad64d5cf594" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286738}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "defbc702-1139-5d9c-87fa-32f728b9c778" :question/math-academy-id "q-103844" :question/problem "If $\\operatorname{cot}⁡x=7$ for some $x$, then find the value of $\\operatorname{cot}⁡(x+12\\pi ).$" :question/worked-solution "The period of $y=\\operatorname{cot}⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+n\\pi ).\n$$\n\nSubstituting $n=12$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+12\\cdot \\pi )=\\operatorname{cot}⁡(x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cot}⁡x=7,$ then $\\operatorname{cot}⁡(x+12\\pi )=7.$"}] [{:db/id #edb/ref 17592186286744 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68770a7e-d63b-5f10-874b-b26559409c18" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x-5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286746} {:answer/id #uuid "56fc4788-a859-5062-a591-62464c518314" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286747} {:answer/id #uuid "6f2f018b-bb6b-5bcc-ba11-90246778738f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡x+5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286748} {:answer/id #uuid "8de371e5-9005-5518-93e4-c49b488a22d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286749} {:answer/id #uuid "9c42266f-fe71-5f1d-b84b-a573e0b24ca9" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{2}⁡x+5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286750}] :answer-field/correct {:answer/id #uuid "8de371e5-9005-5518-93e4-c49b488a22d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186286749} :answer-field/id #uuid "5a7008b7-c99d-55ce-8a71-0afe36edb009" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286745}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "15699b86-338f-59c4-83fb-6e10110237e9" :question/math-academy-id "q-113928" :question/problem "$\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x-5\\operatorname{cos}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C, \\\\ \\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\operatorname{sec}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x-5\\operatorname{cos}⁡x)\\,\\text{d}x & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x-5\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286751 :knowledge-point/_questions [{:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b420ee8-3260-5491-9bbf-21a1dca1ccf7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186286753} {:answer/id #uuid "d39d9832-7e66-5c0f-9e39-d73e9ef09d89" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ -1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186286754} {:answer/id #uuid "bb0bf02a-01c1-5a96-890f-682c6ad905b8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186286755} {:answer/id #uuid "5eb5e8dc-f4bf-5963-bead-a8efde060b64" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186286756} {:answer/id #uuid "6638675c-6a52-55c7-8e40-f8af51f41fa0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186286757}] :answer-field/correct {:answer/id #uuid "bb0bf02a-01c1-5a96-890f-682c6ad905b8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186286755} :answer-field/id #uuid "7e64235f-95b6-5919-8f3a-64a6b302ceec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286752}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e3b06f4f-c29c-5631-a01c-900ed37788a0" :question/math-academy-id "q-19050" :question/problem "If $a=⟨0,0,0⟩$ and $b=i-j-k$, then $a-2b=$" :question/worked-solution "First, notice that\n\n$$\nb=i-j-k=⟨1,-1,-1⟩.\n$$\n\nTo compute $a-2b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-2b & =⟨0,0,0⟩-2\\cdot ⟨1,-1,-1⟩ \\\\  & =⟨0,0,0⟩-⟨2\\cdot 1,2\\cdot (-1),2\\cdot (-1)⟩ \\\\  & =⟨0,0,0⟩-⟨2,-2,-2⟩ \\\\  & =⟨-2,2,2⟩ \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286758 :knowledge-point/_questions [{:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4e1e31a-2e00-5ba3-a006-e2b5ea9ffba3" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+6x+5" :db/id #edb/ref 17592186286760}] :answer-field/correct {:answer/id #uuid "e4e1e31a-2e00-5ba3-a006-e2b5ea9ffba3" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+6x+5" :db/id #edb/ref 17592186286760} :answer-field/id #uuid "6d992f60-9117-5a87-b061-d8724fad5889" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286759}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "28da7251-9cc7-54a5-aa39-20236fed66b4" :question/math-academy-id "q-313365" :question/problem "Given that $y=\\frac{(x+1)^{2}}{x+3},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| $\\frac{\\text{d}y}{\\text{d}x}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | ${(x+3)}^{2}$ |" :question/worked-solution "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)=x+3.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=1.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{2(x+1)\\cdot (x+3)-(x+1)^{2}\\cdot 1}{(x+3)^{2}} \\\\  & =\\frac{(x+1)[2(x+3)-(x+1)]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)[2x+6-x-1]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)(x+5)}{{(x+3)}^{2}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286761 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4d89820-aab3-5d87-ac0d-a7424ed6288e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286763}] :answer-field/correct {:answer/id #uuid "a4d89820-aab3-5d87-ac0d-a7424ed6288e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286763} :answer-field/id #uuid "65a2238e-89e5-5be6-abed-db37286d1741" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286762} {:answer-field/choices [{:answer/id #uuid "3a410fd4-4df3-5432-a8c8-7e5d6f412c91" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286765}] :answer-field/correct {:answer/id #uuid "3a410fd4-4df3-5432-a8c8-7e5d6f412c91" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186286765} :answer-field/id #uuid "3dff2190-5bd1-5026-94ff-e40883ad328c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286764}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1e0e71e7-33fc-58e2-a941-160f43b9fd36" :question/math-academy-id "q-340945" :question/problem "Find the equation of the normal line to the curve $y=\\frac{8}{{x}^{2}}$ at the point $(2,2).$\n\n$x\\,-$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{8}{{x}^{2}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{8}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(8{x}^{-2}) \\\\  & =-16{x}^{-3} \\\\  & =-\\frac{16}{{x}^{3}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,2):$\n\n$$\nm={f}^{′}(2)=-\\frac{16}{(2)^{3}}=-\\frac{16}{8}=-2\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{-2}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(2) & =\\frac{1}{2}(x-2) \\\\ 2y-4 & =x-2 \\\\ x-2\\cdot y & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286766 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a83f9407-2088-5a71-8f0e-0357e63a6bb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186286768} {:answer/id #uuid "6e89f8b9-cf21-5b64-863e-c37999d30393" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186286769} {:answer/id #uuid "9b0e9730-a9e7-59aa-8f78-c712ca08c6cb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286770} {:answer/id #uuid "2d7850c6-cc45-5edf-8b2f-be252dc69b3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186286771} {:answer/id #uuid "73964d17-5289-56a9-84b0-d5a6b04b6000" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286772}] :answer-field/correct {:answer/id #uuid "6e89f8b9-cf21-5b64-863e-c37999d30393" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186286769} :answer-field/id #uuid "a8f997c0-3b95-5225-939c-8126a18e4648" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286767}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8f2e455-c473-5cda-b12b-f292cf5d0cab" :question/math-academy-id "q-35122" :question/problem "Evaluate ${lim}_{x\\to -\\infty }({x}^{5}+4).$" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }({x}^{5}+4) & ={lim}_{x\\to -\\infty }({x}^{5}) \\\\  & =-\\infty \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286773 :knowledge-point/_questions [{:knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b5d2352-e694-5358-a6b3-759f94050fbb" :answer/type {:db/ident :answer.type/math} :answer/value "112\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286775} {:answer/id #uuid "e0596455-f908-50bf-948d-8ad3dd7b579d" :answer/type {:db/ident :answer.type/math} :answer/value "80\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286776} {:answer/id #uuid "9dcdce7b-9c50-5364-b4e3-0b5075fcaaed" :answer/type {:db/ident :answer.type/math} :answer/value "64\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286777} {:answer/id #uuid "5628a3e1-a542-5208-841e-02b07525beeb" :answer/type {:db/ident :answer.type/math} :answer/value "128\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286778} {:answer/id #uuid "ec87bbc7-2131-5eaf-89b1-682d2c46fc95" :answer/type {:db/ident :answer.type/math} :answer/value "96\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286779}] :answer-field/correct {:answer/id #uuid "ec87bbc7-2131-5eaf-89b1-682d2c46fc95" :answer/type {:db/ident :answer.type/math} :answer/value "96\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186286779} :answer-field/id #uuid "2782b6c1-44f8-575b-b598-fc1156d4cd48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286774}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f6441de6-8de3-5bac-a175-59bb496af580" :question/math-academy-id "q-61906" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003941/assets/586b2c9d3409b68436f16715937b7a4bf0abdf8c1a05c628ccafdc49cf6d641d.png)\n\nWhat is the total surface area of the cube above if it is $4\\,\\text{cm}$ long, $4\\,\\text{cm}$ wide, and $4\\,\\text{cm}$ tall?" :question/worked-solution "First, let's consider the net of our plank.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003941/assets/2c8a118f8f3c3ccba67e25ae09096ef1ec0cf15fc6a5e7f9de68f797b7105c80.png)\n\n$$\n\n$$\n\nFrom the diagram, we have squares only.\n\nThe squares are $4\\,\\text{cm}$ long and $4\\,\\text{cm}$ high. So, the area of one square is:\n\n$$\n\\text{Area of the square}=4\\times 4=16\\,{\\text{cm}}^{2}.\n$$\n\nFinally, the surface area of the cube consists of $6$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =6\\times (\\text{Area of the square}) \\\\  & =6\\times 16 \\\\  & =96\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286780 :knowledge-point/_questions [{:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b155e4e-45c7-59c6-972e-97dc799ee228" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286782} {:answer/id #uuid "2871ee06-2d3b-59bd-9eb7-ab24452e3f77" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186286783} {:answer/id #uuid "d25931ba-37a4-5167-94e9-5dffe181bfac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286784} {:answer/id #uuid "83cec97b-85de-532a-8b6d-96beedfac966" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186286785} {:answer/id #uuid "9fa24811-bf75-5b04-bdd0-cb6d46605fd7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186286786}] :answer-field/correct {:answer/id #uuid "83cec97b-85de-532a-8b6d-96beedfac966" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186286785} :answer-field/id #uuid "54473c29-c285-52dc-908b-1d2881c63711" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286781}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4d2284d9-59bd-591b-a5ed-82b600cb5dc8" :question/math-academy-id "q-88454" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x} & =0 \\\\ ({x}^{2}-25)\\cdot {4}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-25=0\\,\\text{and}\\,{4}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-25=0$ can be factored as\n\n$$\n(x+5)(x-5)=0,\n$$\n\nwhich leads to the solutions $x=-5,5.$\n\n- The equation ${4}^{3x}=0$ has no solutions because ${4}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,5,$ and their product is $(-5)\\cdot 5=-25.$"}] [{:db/id #edb/ref 17592186286787 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee02c223-dd7f-5c5d-b09f-e7bc6bd16b0c" :knowledge-point/title "Calculating the Root of a Transformed Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cc4d310-60c9-5977-939f-8371e8c860b5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286789} {:answer/id #uuid "5947e9d6-2edc-52a9-b6fc-c721fae742e3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286790} {:answer/id #uuid "4298dac3-f178-569d-b697-dc98b1b0c7c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186286791} {:answer/id #uuid "30068cb8-2ff2-5e52-9cd8-ac4fb2fadc87" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286792} {:answer/id #uuid "8543886e-97e0-5c44-a085-74b60a7cb407" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186286793}] :answer-field/correct {:answer/id #uuid "5947e9d6-2edc-52a9-b6fc-c721fae742e3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286790} :answer-field/id #uuid "ca9238ac-e029-5c05-adf1-5c48df5218f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286788}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6d41e47f-7034-5026-87ec-55aebc4de127" :question/math-academy-id "q-92997" :question/problem "Find the root of $f(x)=5(7)^{x}-35.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n5(7)^{x}-35=0\n$$\n\nFirst, we isolate the term with the variable exponent by adding $35$ to both sides:\n\n$$\n\\begin{aligned}5(7)^{x}-35 & =0 \\\\ 5(7)^{x}-\\cancel{35}+\\cancel{35} & =0+35 \\\\ 5(7)^{x} & =35\\end{aligned}\n$$\n\nDividing both sides by $5,$ we get\n\n$$\n\\begin{aligned}5(7)^{x} & =35 \\\\ {7}^{x} & =7.\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(7)$, we equate the exponents. This gives\n\n$$\nx=1.\n$$\n\nTherefore, the root of $f(x)$ is $x=1.$"}]}
