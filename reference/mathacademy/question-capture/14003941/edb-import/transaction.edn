e95d84e34a4f405" "q-19050/selection/c16f7f3e4fb668806294a6a99b33272cce1bb80f34e521b3aef141966167d2cb"] :db/ensure [:answer-field/validate]} {:db/id "q-19050" :question/id #uuid "e3b06f4f-c29c-5631-a01c-900ed37788a0" :question/math-academy-id "q-19050" :question/problem "If $a=⟨0,0,0⟩$ and $b=i-j-k$, then $a-2b=$" :question/worked-solution "First, notice that\n\n$$\nb=i-j-k=⟨1,-1,-1⟩.\n$$\n\nTo compute $a-2b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-2b & =⟨0,0,0⟩-2\\cdot ⟨1,-1,-1⟩ \\\\  & =⟨0,0,0⟩-⟨2\\cdot 1,2\\cdot (-1),2\\cdot (-1)⟩ \\\\  & =⟨0,0,0⟩-⟨2,-2,-2⟩ \\\\  & =⟨-2,2,2⟩ \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-19050/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0"] :knowledge-point/questions ["q-19050"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113928/selection/3476a1c2dd48c19e85567cf274e148accbb7d444c01364929d829e79449ad5d3" :answer/id #uuid "6f2f018b-bb6b-5bcc-ba11-90246778738f" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡x+5\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113928/selection/e8cb9a08add3b601c292c0be3e9064be1b8dd2f7982fc2581ca6edc5828b48ec" :answer/id #uuid "8de371e5-9005-5518-93e4-c49b488a22d4" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113928/selection/0440616fb23750657788df59139149194e6b1a21a3b1daaa04df2dbc705f80b8" :answer/id #uuid "68770a7e-d63b-5f10-874b-b26559409c18" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x-5\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113928/selection/fc23f08efe900ea407f9bc01bd0bc7d13d5ae975a1ed6b5b03b5cb5069e8e53f" :answer/id #uuid "9c42266f-fe71-5f1d-b84b-a573e0b24ca9" :answer/type :answer.type/math :answer/value "{tan}^{2}⁡x+5\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113928/selection/2e0e64ebbf473b8ab706dd5676861db681b542084dee3cb5b8cd322d1e78f923" :answer/id #uuid "56fc4788-a859-5062-a591-62464c518314" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113928/selection" :answer-field/id #uuid "5a7008b7-c99d-55ce-8a71-0afe36edb009" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113928/selection/e8cb9a08add3b601c292c0be3e9064be1b8dd2f7982fc2581ca6edc5828b48ec" :answer-field/choices ["q-113928/selection/3476a1c2dd48c19e85567cf274e148accbb7d444c01364929d829e79449ad5d3" "q-113928/selection/e8cb9a08add3b601c292c0be3e9064be1b8dd2f7982fc2581ca6edc5828b48ec" "q-113928/selection/0440616fb23750657788df59139149194e6b1a21a3b1daaa04df2dbc705f80b8" "q-113928/selection/fc23f08efe900ea407f9bc01bd0bc7d13d5ae975a1ed6b5b03b5cb5069e8e53f" "q-113928/selection/2e0e64ebbf473b8ab706dd5676861db681b542084dee3cb5b8cd322d1e78f923"] :db/ensure [:answer-field/validate]} {:db/id "q-113928" :question/id #uuid "15699b86-338f-59c4-83fb-6e10110237e9" :question/math-academy-id "q-113928" :question/problem "$\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x-5\\operatorname{cos}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x+C, \\\\ \\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\operatorname{sec}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x-5\\operatorname{cos}⁡x)\\,\\text{d}x & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x-5\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f"] :knowledge-point/questions ["q-113928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340945/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a4d89820-aab3-5d87-ac0d-a7424ed6288e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-340945/field-1" :answer-field/id #uuid "65a2238e-89e5-5be6-abed-db37286d1741" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340945/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-340945/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-340945/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "3a410fd4-4df3-5432-a8c8-7e5d6f412c91" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-340945/field-2" :answer-field/id #uuid "3dff2190-5bd1-5026-94ff-e40883ad328c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340945/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-340945/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-340945" :question/id #uuid "1e0e71e7-33fc-58e2-a941-160f43b9fd36" :question/math-academy-id "q-340945" :question/problem "Find the equation of the normal line to the curve $y=\\frac{8}{{x}^{2}}$ at the point $(2,2).$\n\n$x\\,-$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{8}{{x}^{2}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{8}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(8{x}^{-2}) \\\\  & =-16{x}^{-3} \\\\  & =-\\frac{16}{{x}^{3}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,2):$\n\n$$\nm={f}^{′}(2)=-\\frac{16}{(2)^{3}}=-\\frac{16}{8}=-2\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{-2}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(2) & =\\frac{1}{2}(x-2) \\\\ 2y-4 & =x-2 \\\\ x-2\\cdot y & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340945/field-1" "q-340945/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c"] :knowledge-point/questions ["q-340945"] :db/ensure [:knowledge-point/validate]} {:db/id "q-313365/field-1/814b9cba2c25cb684365a5182cde5c3af29628d301dbc2b72b40f6061b6b54d2" :answer/id #uuid "e4e1e31a-2e00-5ba3-a006-e2b5ea9ffba3" :answer/type :answer.type/math :answer/value "x^2+6x+5" :db/ensure [:answer/validate]} {:db/id "q-313365/field-1" :answer-field/id #uuid "6d992f60-9117-5a87-b061-d8724fad5889" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-313365/field-1/814b9cba2c25cb684365a5182cde5c3af29628d301dbc2b72b40f6061b6b54d2" :answer-field/choices ["q-313365/field-1/814b9cba2c25cb684365a5182cde5c3af29628d301dbc2b72b40f6061b6b54d2"] :db/ensure [:answer-field/validate]} {:db/id "q-313365" :question/id #uuid "28da7251-9cc7-54a5-aa39-20236fed66b4" :question/math-academy-id "q-313365" :question/problem "Given that $y=\\frac{(x+1)^{2}}{x+3},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| $\\frac{\\text{d}y}{\\text{d}x}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | ${(x+3)}^{2}$ |" :question/worked-solution "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)=x+3.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=1.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{2(x+1)\\cdot (x+3)-(x+1)^{2}\\cdot 1}{(x+3)^{2}} \\\\  & =\\frac{(x+1)[2(x+3)-(x+1)]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)[2x+6-x-1]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)(x+5)}{{(x+3)}^{2}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-313365/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458"] :knowledge-point/questions ["q-313365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-35122/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "73964d17-5289-56a9-84b0-d5a6b04b6000" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-35122/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "a83f9407-2088-5a71-8f0e-0357e63a6bb9" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-35122/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "6e89f8b9-cf21-5b64-863e-c37999d30393" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-35122/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "2d7850c6-cc45-5edf-8b2f-be252dc69b3b" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-35122/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9b0e9730-a9e7-59aa-8f78-c712ca08c6cb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-35122/selection" :answer-field/id #uuid "a8f997c0-3b95-5225-939c-8126a18e4648" :answer-field/key "se