answer/validate]} {:db/id "q-92997/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "30068cb8-2ff2-5e52-9cd8-ac4fb2fadc87" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-92997/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "6cc4d310-60c9-5977-939f-8371e8c860b5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-92997/selection" :answer-field/id #uuid "ca9238ac-e029-5c05-adf1-5c48df5218f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-92997/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-92997/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" "q-92997/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-92997/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-92997/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-92997/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-92997" :question/id #uuid "6d41e47f-7034-5026-87ec-55aebc4de127" :question/math-academy-id "q-92997" :question/problem "Find the root of $f(x)=5(7)^{x}-35.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n5(7)^{x}-35=0\n$$\n\nFirst, we isolate the term with the variable exponent by adding $35$ to both sides:\n\n$$\n\\begin{aligned}5(7)^{x}-35 & =0 \\\\ 5(7)^{x}-\\cancel{35}+\\cancel{35} & =0+35 \\\\ 5(7)^{x} & =35\\end{aligned}\n$$\n\nDividing both sides by $5,$ we get\n\n$$\n\\begin{aligned}5(7)^{x} & =35 \\\\ {7}^{x} & =7.\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(7)$, we equate the exponents. This gives\n\n$$\nx=1.\n$$\n\nTherefore, the root of $f(x)$ is $x=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-92997/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee02c223-dd7f-5c5d-b09f-e7bc6bd16b0c"] :knowledge-point/questions ["q-92997"] :db/ensure [:knowledge-point/validate]} {:db/id "q-61906/selection/bbb07c0d5bc88ec7713cfed430dfb288f996d932487cc7c9949e92420e1b914b" :answer/id #uuid "9dcdce7b-9c50-5364-b4e3-0b5075fcaaed" :answer/type :answer.type/math :answer/value "64\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61906/selection/e0705e7eb5099dc6f14725733a9ddb703848d21269125121a98071373b9cb557" :answer/id #uuid "ec87bbc7-2131-5eaf-89b1-682d2c46fc95" :answer/type :answer.type/math :answer/value "96\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61906/selection/cf48983d5f6b9ef59d6d3f3e94ea7f30d6511537ce1ff63788f3b63aff927dd0" :answer/id #uuid "5628a3e1-a542-5208-841e-02b07525beeb" :answer/type :answer.type/math :answer/value "128\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61906/selection/5cac20d940c9d77a8c44cb90bd13a9ca5bf4120f566db968ee4198b899cbf89e" :answer/id #uuid "e0596455-f908-50bf-948d-8ad3dd7b579d" :answer/type :answer.type/math :answer/value "80\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61906/selection/0564627041d0d515098612c279a72676d9dfc9f4169df78142f691a2fa6f6202" :answer/id #uuid "8b5d2352-e694-5358-a6b3-759f94050fbb" :answer/type :answer.type/math :answer/value "112\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61906/selection" :answer-field/id #uuid "2782b6c1-44f8-575b-b598-fc1156d4cd48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-61906/selection/e0705e7eb5099dc6f14725733a9ddb703848d21269125121a98071373b9cb557" :answer-field/choices ["q-61906/selection/bbb07c0d5bc88ec7713cfed430dfb288f996d932487cc7c9949e92420e1b914b" "q-61906/selection/e0705e7eb5099dc6f14725733a9ddb703848d21269125121a98071373b9cb557" "q-61906/selection/cf48983d5f6b9ef59d6d3f3e94ea7f30d6511537ce1ff63788f3b63aff927dd0" "q-61906/selection/5cac20d940c9d77a8c44cb90bd13a9ca5bf4120f566db968ee4198b899cbf89e" "q-61906/selection/0564627041d0d515098612c279a72676d9dfc9f4169df78142f691a2fa6f6202"] :db/ensure [:answer-field/validate]} {:db/id "q-61906" :question/id #uuid "f6441de6-8de3-5bac-a175-59bb496af580" :question/math-academy-id "q-61906" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003941/assets/586b2c9d3409b68436f16715937b7a4bf0abdf8c1a05c628ccafdc49cf6d641d.png)\n\nWhat is the total surface area of the cube above if it is $4\\,\\text{cm}$ long, $4\\,\\text{cm}$ wide, and $4\\,\\text{cm}$ tall?" :question/worked-solution "First, let's consider the net of our plank.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003941/assets/2c8a118f8f3c3ccba67e25ae09096ef1ec0cf15fc6a5e7f9de68f797b7105c80.png)\n\n$$\n\n$$\n\nFrom the diagram, we have squares only.\n\nThe squares are $4\\,\\text{cm}$ long and $4\\,\\text{cm}$ high. So, the area of one square is:\n\n$$\n\\text{Area of the square}=4\\times 4=16\\,{\\text{cm}}^{2}.\n$$\n\nFinally, the surface area of the cube consists of $6$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =6\\times (\\text{Area of the square}) \\\\  & =6\\times 16 \\\\  & =96\\,{\\text{cm}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-61906/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270"] :knowledge-point/questions ["q-61906"] :db/ensure [:knowledge-point/validate]} {:db/id "q-88454/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "0b155e4e-45c7-59c6-972e-97dc799ee228" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-88454/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d25931ba-37a4-5167-94e9-5dffe181bfac" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-88454/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "2871ee06-2d3b-59bd-9eb7-ab24452e3f77" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-88454/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" :answer/id #uuid "83cec97b-85de-532a-8b6d-96beedfac966" :answer/type :answer.type/math :answer/value "-25" :db/ensure [:answer/validate]} {:db/id "q-88454/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "9fa24811-bf75-5b04-bdd0-cb6d46605fd7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-88454/selection" :answer-field/id #uuid "54473c29-c285-52dc-908b-1d2881c63711" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-88454/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" :answer-field/choices ["q-88454/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-88454/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-88454/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" "q-88454/selection/e0e0a3ac4fe95f021c8f8aece7092270d36ad30c356733db1e628dc4f0b1d434" "q-88454/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-88454" :question/id #uuid "4d2284d9-59bd-591b-a5ed-82b600cb5dc8" :question/math-academy-id "q-88454" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x} & =0 \\\\ ({x}^{2}-25)\\cdot {4}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-25=0\\,\\text{and}\\,{4}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-25=0$ can be factored as\n\n$$\n(x+5)(x-5)=0,\n$$\n\nwhich leads to the solutions $x=-5,5.$\n\n- The equation ${4}^{3x}=0$ has no solutions because ${4}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,5,$ and their product is $(-5)\\cdot 5=-25.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-88454/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f"] :knowledge-point/questions ["q-88454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102416/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" :answer/id #uuid "9260dd16-e2e9-5a4b-98f8-6875507d737e" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "q-102416/selection/cb1896197a67f182a612a87dbfdf77a8994e499a7df0036f929b0112dee816e0" :answer/id #uuid "be0289d0-a2ee-5f04-bce2-2736b2f135d9" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "q-102416/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" :answer/id #uuid "d82834f1-b2b3-5b5d-9cb2-c72398f8e78d" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "q-102416/selection/244c82d9cc80c28419c5dc32926b80eb9b52caaf888f342ef093256f1875d75e" :answer/id #uuid "bcf762d6-2202-5830-ad6c-71c341c76e54" :answer/type :answer.type/math :answer/value "x=\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-102416/selection/6e16771bb20b794177d51af9cfe82dfaea7ece2998be776a359b78a0464ae90f" :answer/id #uuid "1df8c7c4-b2bc-5111-9db0-2ca281f6312d" :answer/type :answer.type/math :answer/value "x=-\\frac{13}{3}" :db/ensure [:answer/validate]} {:db/id "q-102416/selection" :answer-field/id #uuid "8b8924d7-56e4-5ee9-9b20-c78a2fd21829" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102416/selection/cb1896197a67f182a612a87dbfdf77a8994e499a7df0036f929b0112dee816e0" :answer-field/choices ["q-102416/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" "q-102416/selection/cb1896197a67f182a612a87dbfdf77a8994e499a7df0036f929b0112dee816e0" "q-102416/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" "q-102416/selection/244c82d9cc80c28419c5dc32926b80eb9b52caaf888f342ef093256f1875d75e" "q-102416/selection/6e16771bb20b794177d51af9cfe82dfaea7ece2998be776a359b78a0464ae90f"] :db/ensure [:answer-field/validate]} {:db/id "q-102416" :question/id #uuid "68843262-33a9-52ed-b912-10cbb4823187" :question/math-academy-id "q-102416" :question/problem "Find the root of $f(x)=\\sqrt[7]{3x+13}-1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[7]{3x+13}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[7]{3x+13}-1 & =0 \\\\ \\sqrt[7]{3x+13} & =1 \\\\ (\\sqrt[7]{3x+13})^{7} & ={1}^{7} \\\\ 3x+13 & =1 \\\\ 3x & =-12 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102416/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52"] :knowledge-point/questions ["q-102416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103844/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "8dbe0cc2-f858-534e-9c81-033367cb24a5" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-103844/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "a52d1a6f-b6ef-5b5c-8fdf-766eb0c4c4b4" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-103844/selection/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02" :answer/id #uuid "c16b9f73-fe1c-572a-8399-fd006ea980ab" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "q-103844/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "41a4fd97-5dde-5337-9561-6af6e35dc88d" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-103844/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "e11e9d72-db85-5cc5-bd92-a9fcd8ab87bb" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-103844/selection" :answer-field/id #uuid "478da998-206e-5c78-bb68-6ad64d5cf594" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103844/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-103844/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-103844/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-103844/selection/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02" "q-103844/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-103844/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-103844" :question/id #uuid "defbc702-1139-5d9c-87fa-32f728b9c778" :question/math-academy-id "q-103844" :question/problem "If $\\operatorname{cot}⁡x=7$ for some $x$, then find the value of $\\operatorname{cot}⁡(x+12\\pi ).$" :question/worked-solution "The period of $y=\\operatorname{cot}⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+n\\pi ).\n$$\n\nSubstituting $n=12$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+12\\cdot \\pi )=\\operatorname{cot}⁡(x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cot}⁡x=7,$ then $\\operatorname{cot}⁡(x+12\\pi )=7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103844/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d02418c3-4c04-57b8-8f10-18858b1759ab"] :knowledge-point/questions ["q-103844"] :db/ensure [:knowledge-point/validate]}]
