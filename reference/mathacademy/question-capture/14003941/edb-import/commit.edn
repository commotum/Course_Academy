+C" 13194139534408 true] [17592186286748 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286748 1111 #uuid "6f2f018b-bb6b-5bcc-ba11-90246778738f" 13194139534408 true] [17592186286749 1034 "\\operatorname{sec}⁡x-5\\operatorname{sin}⁡x+C" 13194139534408 true] [17592186286749 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286749 1111 #uuid "8de371e5-9005-5518-93e4-c49b488a22d4" 13194139534408 true] [17592186286750 1034 "{tan}^{2}⁡x+5\\operatorname{sin}⁡x+C" 13194139534408 true] [17592186286750 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286750 1111 #uuid "9c42266f-fe71-5f1d-b84b-a573e0b24ca9" 13194139534408 true] [17592186286751 1017 #edb/ref 17592186286752 13194139534408 true] [17592186286751 1089 "q-19050" 13194139534408 true] [17592186286751 1091 #edb/ref 17592186045464 13194139534408 true] [17592186286751 1100 "If $a=⟨0,0,0⟩$ and $b=i-j-k$, then $a-2b=$" 13194139534408 true] [17592186286751 1113 #uuid "e3b06f4f-c29c-5631-a01c-900ed37788a0" 13194139534408 true] [17592186286751 1145 "First, notice that\n\n$$\nb=i-j-k=⟨1,-1,-1⟩.\n$$\n\nTo compute $a-2b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a-2b & =⟨0,0,0⟩-2\\cdot ⟨1,-1,-1⟩ \\\\  & =⟨0,0,0⟩-⟨2\\cdot 1,2\\cdot (-1),2\\cdot (-1)⟩ \\\\  & =⟨0,0,0⟩-⟨2,-2,-2⟩ \\\\  & =⟨-2,2,2⟩ \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" 13194139534408 true] [17592186286752 1000 #edb/ref 17592186286753 13194139534408 true] [17592186286752 1000 #edb/ref 17592186286754 13194139534408 true] [17592186286752 1000 #edb/ref 17592186286755 13194139534408 true] [17592186286752 1000 #edb/ref 17592186286756 13194139534408 true] [17592186286752 1000 #edb/ref 17592186286757 13194139534408 true] [17592186286752 1040 #edb/ref 17592186045450 13194139534408 true] [17592186286752 1041 "selection" 13194139534408 true] [17592186286752 1104 #edb/ref 17592186286755 13194139534408 true] [17592186286752 1110 #uuid "7e64235f-95b6-5919-8f3a-64a6b302ceec" 13194139534408 true] [17592186286753 1034 "[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]" 13194139534408 true] [17592186286753 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286753 1111 #uuid "4b420ee8-3260-5491-9bbf-21a1dca1ccf7" 13194139534408 true] [17592186286754 1034 "[\\begin{aligned}-1 \\\\ -1 \\\\ -1\\end{aligned}]" 13194139534408 true] [17592186286754 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286754 1111 #uuid "d39d9832-7e66-5c0f-9e39-d73e9ef09d89" 13194139534408 true] [17592186286755 1034 "[\\begin{aligned}-2 \\\\ 2 \\\\ 2\\end{aligned}]" 13194139534408 true] [17592186286755 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286755 1111 #uuid "bb0bf02a-01c1-5a96-890f-682c6ad905b8" 13194139534408 true] [17592186286756 1034 "[\\begin{aligned}2 \\\\ -2 \\\\ -2\\end{aligned}]" 13194139534408 true] [17592186286756 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286756 1111 #uuid "5eb5e8dc-f4bf-5963-bead-a8efde060b64" 13194139534408 true] [17592186286757 1034 "[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]" 13194139534408 true] [17592186286757 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286757 1111 #uuid "6638675c-6a52-55c7-8e40-f8af51f41fa0" 13194139534408 true] [17592186286758 1017 #edb/ref 17592186286759 13194139534408 true] [17592186286758 1089 "q-313365" 13194139534408 true] [17592186286758 1091 #edb/ref 17592186045465 13194139534408 true] [17592186286758 1100 "Given that $y=\\frac{(x+1)^{2}}{x+3},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| $\\frac{\\text{d}y}{\\text{d}x}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | ${(x+3)}^{2}$ |" 13194139534408 true] [17592186286758 1113 #uuid "28da7251-9cc7-54a5-aa39-20236fed66b4" 13194139534408 true] [17592186286758 1145 "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)=x+3.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=1.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{2(x+1)\\cdot (x+3)-(x+1)^{2}\\cdot 1}{(x+3)^{2}} \\\\  & =\\frac{(x+1)[2(x+3)-(x+1)]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)[2x+6-x-1]}{{(x+3)}^{2}} \\\\  & =\\frac{(x+1)(x+5)}{{(x+3)}^{2}}.\\end{aligned}\\end{aligned}\n$$" 13194139534408 true] [17592186286759 1000 #edb/ref 17592186286760 13194139534408 true] [17592186286759 1040 #edb/ref 17592186045449 13194139534408 true] [17592186286759 1041 "field-1" 13194139534408 true] [17592186286759 1104 #edb/ref 17592186286760 13194139534408 true] [17592186286759 1110 #uuid "6d992f60-9117-5a87-b061-d8724fad5889" 13194139534408 true] [17592186286760 1034 "x^2+6x+5" 13194139534408 true] [17592186286760 1103 #edb/ref 17592186045453 13194139534408 true] [17592186286760 1111 #uuid "e4e1e31a-2e00-5ba3-a006-e2b5ea9ffba3" 13194139534408 true] [17592186286761 1017 #edb/ref 17592186286762 13194139534408 true] [17592186286761 1017 #edb/ref 17592186286764 13194139534408 true] [17592186286761 1089 "q-340945" 13194139534408 true] [17592186286761 1091 #edb/ref 17592186045465 13194139534408 true] [17592186286761 1100 "Find the equation of the normal line to the curve $y=\\frac{8}{{x}^{2}}$ at the point $(2,2).$\n\n$x\\,-$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" 13194139534408 true] [17592186286761 1113 #uuid "1e0e71e7-33fc-58e2-a941-160f43b9fd36" 13194139534408 true] [17592186286761 1145 "Let $f(x)=\\frac{8}{{x}^{2}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{8}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(8{x}^{-2}) \\\\  & =-16{x}^{-3} \\\\  & =-\\frac{16}{{x}^{3}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,2):$\n\n$$\nm={f}^{′}(2)=-\\frac{16}{(2)^{3}}=-\\frac{16}{8}=-2\n$$\n\nThe