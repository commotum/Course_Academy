3976 true] [17592186275544 1113 #uuid "cd4931ad-e617-59f5-a72a-e4baf2db2ce0" 13194139533976 true] [17592186275544 1145 "We use the quotient rule with the numerator $u(x)=\\sqrt{\\operatorname{ln}⁡x}$ and the denominator $v(x)=2x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}},\\,{v}^{′}(x)=2.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}})(2x)-(\\sqrt{\\operatorname{ln}⁡x})(2)}{(2x)^{2}} \\\\  & =\\frac{\\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}.\\end{aligned}\\end{aligned}\n$$" 13194139533976 true] [17592186275545 1000 #edb/ref 17592186275546 13194139533976 true] [17592186275545 1000 #edb/ref 17592186275547 13194139533976 true] [17592186275545 1000 #edb/ref 17592186275548 13194139533976 true] [17592186275545 1000 #edb/ref 17592186275549 13194139533976 true] [17592186275545 1000 #edb/ref 17592186275550 13194139533976 true] [17592186275545 1040 #edb/ref 17592186045450 13194139533976 true] [17592186275545 1041 "selection" 13194139533976 true] [17592186275545 1104 #edb/ref 17592186275547 13194139533976 true] [17592186275545 1110 #uuid "5b80aae1-e66f-5843-a79f-8b1de81167a6" 13194139533976 true] [17592186275546 1034 "\\frac{x-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}\\operatorname{ln}⁡x}" 13194139533976 true] [17592186275546 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275546 1111 #uuid "caa1ee96-3948-526c-9bc5-94572e387781" 13194139533976 true] [17592186275547 1034 "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" 13194139533976 true] [17592186275547 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275547 1111 #uuid "02c794ad-ce8f-5fd8-89c2-989654009f85" 13194139533976 true] [17592186275548 1034 "\\frac{\\operatorname{ln}⁡x-2}{\\sqrt{\\operatorname{ln}⁡x}}" 13194139533976 true] [17592186275548 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275548 1111 #uuid "5aa1b17d-589f-59de-81a0-e060f9542e52" 13194139533976 true] [17592186275549 1034 "\\frac{1+2\\sqrt{\\operatorname{ln}⁡x}}{2{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" 13194139533976 true] [17592186275549 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275549 1111 #uuid "9d7663b4-8d1e-5051-9c5e-58f507f7bed3" 13194139533976 true] [17592186275550 1034 "\\frac{1-2\\operatorname{ln}⁡x}{\\sqrt{\\operatorname{ln}⁡x}}" 13194139533976 true] [17592186275550 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275550 1111 #uuid "f965e7fd-dc64-59c5-863e-4484d15d897b" 13194139533976 true] [17592186275551 1017 #edb/ref 17592186275552 13194139533976 true] [17592186275551 1089 "q-313371" 13194139533976 true] [17592186275551 1091 #edb/ref 17592186045464 13194139533976 true] [17592186275551 1100 "Given that $y=\\frac{\\operatorname{ln}⁡x}{{e}^{2x}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| ${y}^{′}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $x{e}^{2x}$ |" 13194139533976 true] [17592186275551 1113 #uuid "54a72b0e-48a0-5849-bec4-04cfc81522e4" 13194139533976 true] [17592186275551 1145 "We use the quotient rule with the numerator $u(x)=\\operatorname{ln}⁡x$ and the denominator $v(x)={e}^{2x}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{x},\\,{v}^{′}(x)=2{e}^{2x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{x})({e}^{2x})-(\\operatorname{ln}⁡x)(2{e}^{2x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}}{x}-2{e}^{2x}\\operatorname{ln}⁡x)}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}-2x{e}^{2x}\\operatorname{ln}⁡x}{x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{{e}^{2x}(1-2x\\operatorname{ln}⁡x)}{x{({e}^{2x})}^{2}} \\\\  & =\\frac{1-2x\\operatorname{ln}⁡x}{x{e}^{2x}}.\\end{aligned}\\end{aligned}\n$$" 13194139533976 true] [17592186275552 1000 #edb/ref 17592186275553 13194139533976 true] [17592186275552 1000 #edb/ref 17592186275554 13194139533976 true] [17592186275552 1040 #edb/ref 17592186045449 13194139533976 true] [17592186275552 1041 "field-1" 13194139533976 true] [17592186275552 1104 #edb/ref 17592186275554 13194139533976 true] [17592186275552 1110 #uuid "e9b7cede-548a-59ec-bb82-27d278d338b1" 13194139533976 true] [17592186275553 1034 "1+2x\\ln(x)" 13194139533976 true] [17592186275553 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275553 1111 #uuid "2e2c2a87-8aa5-54d2-bf79-9f1e66e85423" 13194139533976 true] [17592186275554 1034 "1-2x\\ln(x)" 13194139533976 true] [17592186275554 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275554 1111 #uuid "a413b1ad-ea4f-5227-ab82-6ad6c3235ee6" 13194139533976 true] [17592186275555 1017 #edb/ref 17592186275556 13194139533976 true] [17592186275555 1089 "q-343354" 13194139533976 true] [17592186275555 1091 #edb/ref 17592186045463 13194139533976 true] [17592186275555 1100 "Given that $y=2x{e}^{6x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}} $){e}^{6x}$" 13194139533976 true] [17592186275555 1113 #uuid "83941ac9-43a5-522e-b66d-9567a6ddd76f" 13194139533976 true] [17592186275555 1145 "This question requires the product rule. Let $u(x)=2x$ and $v(x)={e}^{6x}.$ Then\n\n$$\n{u}^{′}(x)=2,\\,{v}^{′}(x)=6{e}^{6x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2)({e}^{6x})+(2x)(6{e}^{6x}) \\\\  & =(12x+2){e}^{6x}.\\end{aligned}\n$$" 13194139533976 true] [17592186275556 1000 #edb/ref 17592186275557 13194139533976 true] [17592186275556 1040 #edb/ref 17592186045449 13194139533976 true] [17592186275556 1041 "field-1" 13194139533976 true] [17592186275556 1104 #edb/ref 17592186275557 13194139533976 true] [17592186275556 1110 #uuid "39b50726-0c36-579d-b937-1ad1f00c46e2" 13194139533976 true] [17592186275557 1034 "2+12x" 13194139533976 true] [17592186275557 1103 #edb/ref 17592186045453 13194139533976 true] [17592186275557 1111 #uuid "45f00601-f07c-5c87-84b6-5c8051d64f94" 13194139533976 true] [17592186275558 1017 #edb/ref 17592186275559 13194139533976 true] [17592186275558 1089 "q-9944" 13194139533976 true] [17592186275558 1091 #edb/ref 17592186045465 13194139533976 true] [17592186275558 1100 "Find the slope of $f(x)={x}^{2}{sin}^{3}⁡x$ at $x=0.$" 13194139533976 true] [17592186275558 1113 #uuid "770b13e6-48d0-510a-8b09-7cd9355ec1ae" 13194139533976 true] [17592186275558 1145 "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nThis question requires the product rule. Let $u(x)={x}^{2}$ and $v(x)={sin}^{3}⁡x.$ Then\n\n$$\n{u}^{′}(x)=2x,\\,{v}^{′}(x)=3{sin}^{2}⁡x\\operatorname{cos}⁡x.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2x)({sin}^{3}⁡x)+({x}^{2})(3{sin}^{2}⁡x\\operatorname{cos}⁡x) \\\\  & =2x{sin}^{3}⁡x+3{x}^{2}{sin}^{2}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, the slope at $x=0$ is\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}f}{\\text{d}x})|}_{x=0} & =2\\cdot 0\\cdot {sin}^{3}⁡(0)+3\\cdot {0}^{2}\\cdot {sin}^{2}⁡(0)\\operatorname{cos}⁡(0) \\\\  & =0.\\end{aligned}\n$$" 13194139533976 true] [17592186275559 1000 #edb/ref 17592186275560 13194139533976 true] [17592186275559 1000 #edb/ref 17592186275561 13194139533976 true] [175921862755