[{:db/id "q-2401/selection/fe4844ecdde4f57120b2a49c380a630b5173b7e8e6c257dff1ba77bd8f4363cf" :answer/id #uuid "d8b092ac-4263-51cf-8408-52da457495f0" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{cos}⁡x+2x\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-2401/selection/25741403b0ff6e6515d28ccd4014e17b997b1bd123997e3be25cf80cc2711bae" :answer/id #uuid "5928b2d1-4cb8-5c66-8411-6aeda1f3b1b9" :answer/type :answer.type/math :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x-8x\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2401/selection/85e1c3ad4fdbb79e1e29a0cfe2165544ea213ec3bde225169bc632bafe7edd68" :answer/id #uuid "f43fd0b0-89e3-5140-9e51-9b58643f6197" :answer/type :answer.type/math :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}-x\\sqrt{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-2401/selection/685eaf719eae20546589121be1dac42a874b0d15e0aa25d81ec01ca6c48b4fe9" :answer/id #uuid "f1f54a29-78aa-51b9-b54a-6b55e0ec780e" :answer/type :answer.type/math :answer/value "\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2401/selection/5be1a8535249af7c1775e4e518c26d8695d51e379b0db442c834b2c627953efe" :answer/id #uuid "50014485-d743-5da4-be3e-980d8c197817" :answer/type :answer.type/math :answer/value "-\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{cos}⁡x}}+8x\\sqrt{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-2401/selection" :answer-field/id #uuid "755d7f67-3732-5607-a906-b63db53a6a0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2401/selection/685eaf719eae20546589121be1dac42a874b0d15e0aa25d81ec01ca6c48b4fe9" :answer-field/choices ["q-2401/selection/fe4844ecdde4f57120b2a49c380a630b5173b7e8e6c257dff1ba77bd8f4363cf" "q-2401/selection/25741403b0ff6e6515d28ccd4014e17b997b1bd123997e3be25cf80cc2711bae" "q-2401/selection/85e1c3ad4fdbb79e1e29a0cfe2165544ea213ec3bde225169bc632bafe7edd68" "q-2401/selection/685eaf719eae20546589121be1dac42a874b0d15e0aa25d81ec01ca6c48b4fe9" "q-2401/selection/5be1a8535249af7c1775e4e518c26d8695d51e379b0db442c834b2c627953efe"] :db/ensure [:answer-field/validate]} {:db/id "q-2401" :question/id #uuid "b6953033-5b86-5efc-a511-cf9d2c38992f" :question/math-academy-id "q-2401" :question/problem "Find ${y}^{′}$ for $y=4{x}^{2}\\sqrt{\\operatorname{sin}⁡x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=4{x}^{2}$ and $v(x)=\\sqrt{\\operatorname{sin}⁡x}.$ Then\n\n$$\n{u}^{′}(x)=8x,\\,{v}^{′}(x)=\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(8x)(\\sqrt{\\operatorname{sin}⁡x})+(4{x}^{2})(\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}) \\\\  & =8x\\sqrt{\\operatorname{sin}⁡x}+\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2401/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3"] :knowledge-point/questions ["q-2401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2403/selection/40040acfe4d3ae75cba161cb9cd77df6a1d257e7e4b4024b42b8529da35d01ba" :answer/id #uuid "5aa1b17d-589f-59de-81a0-e060f9542e52" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡x-2}{\\sqrt{\\operatorname{ln}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2403/selection/b0883a748c8368ac3eec71a649fa7863153c45e86f1deb963858ca396ce50a51" :answer/id #uuid "f965e7fd-dc64-59c5-863e-4484d15d897b" :answer/type :answer.type/math :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{\\sqrt{\\operatorname{ln}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2403/selection/aa189f34a59b69ee42155565d84696c24fc856dcfc8eac7665d0b55e4cf632b8" :answer/id #uuid "9d7663b4-8d1e-5051-9c5e-58f507f7bed3" :answer/type :answer.type/math :answer/value "\\frac{1+2\\sqrt{\\operatorname{ln}⁡x}}{2{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2403/selection/28f35261d041aace55b804a1129c8dbe9d9d60a61a8ffde185269d31a9113697" :answer/id #uuid "02c794ad-ce8f-5fd8-89c2-989654009f85" :answer/type :answer.type/math :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/ensure [:answer/validate]} {:db/id "q-2403/selection/02a86dfaefa53036b5043b627cbe30b60039124176c6cde6baf0f8a9911d151b" :answer/id #uuid "caa1ee96-3948-526c-9bc5-94572e387781" :answer/type :answer.type/math :answer/value "\\frac{x-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}\\operatorname{ln}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-2403/selection" :answer-field/id #uuid "5b80aae1-e66f-5843-a79f-8b1de81167a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2403/selection/28f35261d041aace55b804a1129c8dbe9d9d60a61a8ffde185269d31a9113697" :answer-field/choices ["q-2403/selection/40040acfe4d3ae75cba161cb9cd77df6a1d257e7e4b4024b42b8529da35d01ba" "q-2403/selection/b0883a748c8368ac3eec71a649fa7863153c45e86f1deb963858ca396ce50a51" "q-2403/selection/aa189f34a59b69ee42155565d84696c24fc856dcfc8eac7665d0b55e4cf632b8" "q-2403/selection/28f35261d041aace55b804a1129c8dbe9d9d60a61a8ffde185269d31a9113697" "q-2403/selection/02a86dfaefa53036b5043b627cbe30b60039124176c6cde6baf0f8a9911d151b"] :db/ensure [:answer-field/validate]} {:db/id "q-2403" :question/id #uuid "cd4931ad-e617-59f5-a72a-e4baf2db2ce0" :question/math-academy-id "q-2403" :question/problem "Find ${y}^{′}$ for $y=\\frac{\\sqrt{\\operatorname{ln}⁡x}}{2x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\sqrt{\\operatorname{ln}⁡x}$ and the denominator $v(x)=2x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}},\\,{v}^{′}(x)=2.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}})(2x)-(\\sqrt{\\operatorname{ln}⁡x})(2)}{(2x)^{2}} \\\\  & =\\frac{\\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2403/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458"] :knowledge-point/questions ["q-2403"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9944/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "4626561a-b909-5abf-9ecf-4c750f61ffea" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-9944/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0b12d8ec-f1fc-50f2-b1b8-5bfcc39bc227" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-9944/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4df29c94-bfd0-5c91-9998-369caac37ecd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-9944/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "1031cdb5-5010-5fca-a888-e69a7edc0ec3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-9944/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c000d9b8-a530-5cec-970c-e8dd4b13b782" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-9944/selection" :answer-field/id #uuid "8546e0ab-e369-5971-8452-02964cc67c63" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9944/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-9944/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-9944/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-9944/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-9944/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-9944/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-9944" :question/id #uuid "770b13e6-48d0-510a-8b09-7cd9355ec1ae" :question/math-academy-id "q-9944" :question/problem "Find the slope of $f(x)={x}^{2}{sin}^{3}⁡x$ at $x=0.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nThis question requires the product rule. Let $u(x)={x}^{2}$ and $v(x)={sin}^{3}⁡x.$ Then\n\n$$\n{u}^{′}(x)=2x,\\,{v}^{′}(x)=3{sin}^{2}⁡x\\operatorname{cos}⁡x.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2x)({sin}^{3}⁡x)+({x}^{2})(3{sin}^{2}⁡x\\operatorname{cos}⁡x) \\\\  & =2x{sin}^{3}⁡x+3{x}^{2}{sin}^{2}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, the slope at $x=0$ is\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}f}{\\text{d}x})|}_{x=0} & =2\\cdot 0\\cdot {sin}^{3}⁡(0)+3\\cdot {0}^{2}\\cdot {sin}^{2}⁡(0)\\operatorname{cos}⁡(0) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9944/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3"] :knowledge-point/questions ["q-9944"] :db/ensure [:knowledge-point/validate]} {:db/id "q-313371/field-1/c402eee6a76e8584a036c4e03175ac4f9ecb33a7b53ab97f452c6092a62ebf4b" :answer/id #uuid "a413b1ad-ea4f-5227-ab82-6ad6c3235ee6" :answer/type :answer.type/math :answer/value "1-2x\\ln(x)" :db/ensure [:answer/validate]} {:db/id "q-313371/field-1/b95e3a6ba180df686a365f9c962963dc0d1fbf649f7372ba2167341c846f7f27" :answer/id #uuid "2e2c2a87-8aa5-54d2-bf79-9f1e66e85423" :answer/type :answer.type/math :answer/value "1+2x\\ln(x)" :db/ensure [:answer/validate]} {:db/id "q-313371/field-1" :answer-field/id #uuid "e9b7cede-548a-59ec-bb82-27d278d338b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-313371/field-1/c402eee6a76e8584a036c4e03175ac4f9ecb33a7b53ab97f452c6092a62ebf4b" :answer-field/choices ["q-313371/field-1/c402eee6a76e8584a036c4e03175ac4f9ecb33a7b53ab97f452c6092a62ebf4b" "q-313371/field-1/b95e3a6ba180df686a365f9c962963dc0d1fbf649f7372ba2167341c846f7f27"] :db/ensure [:answer-field/validate]} {:db/id "q-313371" :question/id #uuid "54a72b0e-48a0-5849-bec4-04cfc81522e4" :question/math-academy-id "q-313371" :question/problem "Given that $y=\\frac{\\operatorname{ln}⁡x}{{e}^{2x}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| ${y}^{′}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $x{e}^{2x}$ |" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\operatorname{ln}⁡x$ and the denominator $v(x)={e}^{2x}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{x},\\,{v}^{′}(x)=2{e}^{2x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{x})({e}^{2x})-(\\operatorname{ln}⁡x)(2{e}^{2x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}}{x}-2{e}^{2x}\\operatorname{ln}⁡x)}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}-2x{e}^{2x}\\operatorname{ln}⁡x}{x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{{e}^{2x}(1-2x\\operatorname{ln}⁡x)}{x{({e}^{2x})}^{2}} \\\\  & =\\frac{1-2x\\operatorname{ln}⁡x}{x{e}^{2x}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-313371/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458"] :knowledge-point/questions ["q-313371"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343354/field-1/590c14404bc5f67fee171d81d414a4c3a140db6fd8c442d87dc1cf6d38242bc2" :answer/id #uuid "45f00601-f07c-5c87-84b6-5c8051d64f94" :answer/type :answer.type/math :answer/value "2+12x" :db/ensure [:answer/validate]} {:db/id "q-343354/field-1" :answer-field/id #uuid "39b50726-0c36-579d-b937-1ad1f00c46e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343354/field-1/590c14404bc5f67fee171d81d414a4c3a140db6fd8c442d87dc1cf6d38242bc2" :answer-field/choices ["q-343354/field-1/590c14404bc5f67fee171d81d414a4c3a140db6fd8c442d87dc1cf6d38242bc2"] :db/ensure [:answer-field/validate]} {:db/id "q-343354" :question/id #uuid "83941ac9-43a5-522e-b66d-9567a6ddd76f" :question/math-academy-id "q-343354" :question/problem "Given that $y=2x{e}^{6x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}} $){e}^{6x}$" :question/worked-solution "This question requires the product rule. Let $u(x)=2x$ and $v(x)={e}^{6x}.$ Then\n\n$$\n{u}^{′}(x)=2,\\,{v}^{′}(x)=6{e}^{6x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2)({e}^{6x})+(2x)(6{e}^{6x}) \\\\  & =(12x+2){e}^{6x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343354/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3"] :knowledge-point/questions ["q-343354"] :db/ensure [:knowledge-point/validate]}]
