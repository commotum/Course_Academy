#{[{:db/id #edb/ref 17592186275537 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5928b2d1-4cb8-5c66-8411-6aeda1f3b1b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x-8x\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186275539} {:answer/id #uuid "50014485-d743-5da4-be3e-980d8c197817" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{cos}⁡x}}+8x\\sqrt{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186275540} {:answer/id #uuid "f1f54a29-78aa-51b9-b54a-6b55e0ec780e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186275541} {:answer/id #uuid "f43fd0b0-89e3-5140-9e51-9b58643f6197" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}\\operatorname{sin}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}-x\\sqrt{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186275542} {:answer/id #uuid "d8b092ac-4263-51cf-8408-52da457495f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{cos}⁡x+2x\\operatorname{sin}⁡x}{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186275543}] :answer-field/correct {:answer/id #uuid "f1f54a29-78aa-51b9-b54a-6b55e0ec780e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}" :db/id #edb/ref 17592186275541} :answer-field/id #uuid "755d7f67-3732-5607-a906-b63db53a6a0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275538}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6953033-5b86-5efc-a511-cf9d2c38992f" :question/math-academy-id "q-2401" :question/problem "Find ${y}^{′}$ for $y=4{x}^{2}\\sqrt{\\operatorname{sin}⁡x}.$" :question/worked-solution "This question requires the product rule. Let $u(x)=4{x}^{2}$ and $v(x)=\\sqrt{\\operatorname{sin}⁡x}.$ Then\n\n$$\n{u}^{′}(x)=8x,\\,{v}^{′}(x)=\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(8x)(\\sqrt{\\operatorname{sin}⁡x})+(4{x}^{2})(\\frac{\\operatorname{cos}⁡x}{2\\sqrt{\\operatorname{sin}⁡x}}) \\\\  & =8x\\sqrt{\\operatorname{sin}⁡x}+\\frac{2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{8x\\operatorname{sin}⁡x+2{x}^{2}\\operatorname{cos}⁡x}{\\sqrt{\\operatorname{sin}⁡x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275544 :knowledge-point/_questions [{:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caa1ee96-3948-526c-9bc5-94572e387781" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}\\operatorname{ln}⁡x}" :db/id #edb/ref 17592186275546} {:answer/id #uuid "02c794ad-ce8f-5fd8-89c2-989654009f85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186275547} {:answer/id #uuid "5aa1b17d-589f-59de-81a0-e060f9542e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x-2}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186275548} {:answer/id #uuid "9d7663b4-8d1e-5051-9c5e-58f507f7bed3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{\\operatorname{ln}⁡x}}{2{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186275549} {:answer/id #uuid "f965e7fd-dc64-59c5-863e-4484d15d897b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186275550}] :answer-field/correct {:answer/id #uuid "02c794ad-ce8f-5fd8-89c2-989654009f85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186275547} :answer-field/id #uuid "5b80aae1-e66f-5843-a79f-8b1de81167a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275545}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cd4931ad-e617-59f5-a72a-e4baf2db2ce0" :question/math-academy-id "q-2403" :question/problem "Find ${y}^{′}$ for $y=\\frac{\\sqrt{\\operatorname{ln}⁡x}}{2x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\sqrt{\\operatorname{ln}⁡x}$ and the denominator $v(x)=2x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}},\\,{v}^{′}(x)=2.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}})(2x)-(\\sqrt{\\operatorname{ln}⁡x})(2)}{(2x)^{2}} \\\\  & =\\frac{\\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275551 :knowledge-point/_questions [{:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e2c2a87-8aa5-54d2-bf79-9f1e66e85423" :answer/type {:db/ident :answer.type/math} :answer/value "1+2x\\ln(x)" :db/id #edb/ref 17592186275553} {:answer/id #uuid "a413b1ad-ea4f-5227-ab82-6ad6c3235ee6" :answer/type {:db/ident :answer.type/math} :answer/value "1-2x\\ln(x)" :db/id #edb/ref 17592186275554}] :answer-field/correct {:answer/id #uuid "a413b1ad-ea4f-5227-ab82-6ad6c3235ee6" :answer/type {:db/ident :answer.type/math} :answer/value "1-2x\\ln(x)" :db/id #edb/ref 17592186275554} :answer-field/id #uuid "e9b7cede-548a-59ec-bb82-27d278d338b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275552}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "54a72b0e-48a0-5849-bec4-04cfc81522e4" :question/math-academy-id "q-313371" :question/problem "Given that $y=\\frac{\\operatorname{ln}⁡x}{{e}^{2x}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| ${y}^{′}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $x{e}^{2x}$ |" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\operatorname{ln}⁡x$ and the denominator $v(x)={e}^{2x}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{x},\\,{v}^{′}(x)=2{e}^{2x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{x})({e}^{2x})-(\\operatorname{ln}⁡x)(2{e}^{2x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}}{x}-2{e}^{2x}\\operatorname{ln}⁡x)}{{({e}^{2x})}^{2}} \\\\  & =\\frac{(\\frac{{e}^{2x}-2x{e}^{2x}\\operatorname{ln}⁡x}{x})}{{({e}^{2x})}^{2}} \\\\  & =\\frac{{e}^{2x}(1-2x\\operatorname{ln}⁡x)}{x{({e}^{2x})}^{2}} \\\\  & =\\frac{1-2x\\operatorname{ln}⁡x}{x{e}^{2x}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275555 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45f00601-f07c-5c87-84b6-5c8051d64f94" :answer/type {:db/ident :answer.type/math} :answer/value "2+12x" :db/id #edb/ref 17592186275557}] :answer-field/correct {:answer/id #uuid "45f00601-f07c-5c87-84b6-5c8051d64f94" :answer/type {:db/ident :answer.type/math} :answer/value "2+12x" :db/id #edb/ref 17592186275557} :answer-field/id #uuid "39b50726-0c36-579d-b937-1ad1f00c46e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275556}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "83941ac9-43a5-522e-b66d-9567a6ddd76f" :question/math-academy-id "q-343354" :question/problem "Given that $y=2x{e}^{6x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}} $){e}^{6x}$" :question/worked-solution "This question requires the product rule. Let $u(x)=2x$ and $v(x)={e}^{6x}.$ Then\n\n$$\n{u}^{′}(x)=2,\\,{v}^{′}(x)=6{e}^{6x}.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2)({e}^{6x})+(2x)(6{e}^{6x}) \\\\  & =(12x+2){e}^{6x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275558 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1031cdb5-5010-5fca-a888-e69a7edc0ec3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275560} {:answer/id #uuid "4df29c94-bfd0-5c91-9998-369caac37ecd" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275561} {:answer/id #uuid "c000d9b8-a530-5cec-970c-e8dd4b13b782" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275562} {:answer/id #uuid "4626561a-b909-5abf-9ecf-4c750f61ffea" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275563} {:answer/id #uuid "0b12d8ec-f1fc-50f2-b1b8-5bfcc39bc227" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275564}] :answer-field/correct {:answer/id #uuid "c000d9b8-a530-5cec-970c-e8dd4b13b782" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275562} :answer-field/id #uuid "8546e0ab-e369-5971-8452-02964cc67c63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275559}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "770b13e6-48d0-510a-8b09-7cd9355ec1ae" :question/math-academy-id "q-9944" :question/problem "Find the slope of $f(x)={x}^{2}{sin}^{3}⁡x$ at $x=0.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}f}{\\text{d}x}$ at that point.\n\nThis question requires the product rule. Let $u(x)={x}^{2}$ and $v(x)={sin}^{3}⁡x.$ Then\n\n$$\n{u}^{′}(x)=2x,\\,{v}^{′}(x)=3{sin}^{2}⁡x\\operatorname{cos}⁡x.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2x)({sin}^{3}⁡x)+({x}^{2})(3{sin}^{2}⁡x\\operatorname{cos}⁡x) \\\\  & =2x{sin}^{3}⁡x+3{x}^{2}{sin}^{2}⁡x\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, the slope at $x=0$ is\n\n$$\n\\begin{aligned}{(\\frac{\\text{d}f}{\\text{d}x})|}_{x=0} & =2\\cdot 0\\cdot {sin}^{3}⁡(0)+3\\cdot {0}^{2}\\cdot {sin}^{2}⁡(0)\\operatorname{cos}⁡(0) \\\\  & =0.\\end{aligned}\n$$"}]}
