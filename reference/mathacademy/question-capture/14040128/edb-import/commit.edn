dot 4)j+(2\\cdot 0-2\\cdot 4)k \\\\  & =0i-4j-8k \\\\  & =⟨0,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{ST}\\times \\overset{\\to }{SU}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,STU$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{5}}{2}=2\\sqrt{5}.\n$$" 13194139534719 true] [17592186305368 1000 #edb/ref 17592186305369 13194139534719 true] [17592186305368 1000 #edb/ref 17592186305370 13194139534719 true] [17592186305368 1040 #edb/ref 17592186045449 13194139534719 true] [17592186305368 1041 "field-1" 13194139534719 true] [17592186305368 1104 #edb/ref 17592186305369 13194139534719 true] [17592186305368 1110 #uuid "851d5934-360b-5f83-a502-7978cec33428" 13194139534719 true] [17592186305369 1034 "2\\sqrt{5}" 13194139534719 true] [17592186305369 1103 #edb/ref 17592186045453 13194139534719 true] [17592186305369 1111 #uuid "875f8dcb-5039-5964-ba26-3f56de0ce03a" 13194139534719 true] [17592186305370 1034 "4\\sqrt{5}" 13194139534719 true] [17592186305370 1103 #edb/ref 17592186045453 13194139534719 true] [17592186305370 1111 #uuid "ec7e58ae-973a-546c-83e8-dd818521ee60" 13194139534719 true] [17592186305371 1017 #edb/ref 17592186305372 13194139534719 true] [17592186305371 1089 "q-316556" 13194139534719 true] [17592186305371 1091 #edb/ref 17592186045464 13194139534719 true] [17592186305371 1100 "Calculate the length of the altitude $HK$ of the $△\\,GHI,$ if $G(1,1,1),$ $H(3,2,4),$ $I(2,4,2).$\n\n$HK=${{field-1}}" 13194139534719 true] [17592186305371 1113 #uuid "e65dc510-2fb4-57f3-a150-1a3f75e0f8be" 13194139534719 true] [17592186305371 1145 "Note that the length of the altitude $HK$ can be related to the area of $△\\,GHI$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}HK\\cdot GI\n$$\n\nSo, to find $HK,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{GI} & =i-g \\\\  & =(2i+4j+2k)-(i+j+k) \\\\  & =i+3j+k \\\\  & =⟨1,3,1⟩ \\\\ \\overset{\\to }{GH} & =h-g \\\\  & =(3i+2j+4k)-(i+j+k) \\\\  & =2i+j+3k \\\\  & =⟨2,1,3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{GI}\\times \\overset{\\to }{GH} & =|\\begin{aligned}i & j & k \\\\ 1 & 3 & 1 \\\\ 2 & 1 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 1 & 3\\end{aligned}|i-|\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}1 & 3 \\\\ 2 & 1\\end{aligned}|k \\\\  & =(3\\cdot 3-1\\cdot 1)i-(1\\cdot 3-1\\cdot 2)j+(1\\cdot 1-3\\cdot 2)k \\\\  & =8i-j-5k \\\\  & =⟨8,-1,-5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{GI}$ and $\\overset{\\to }{GH}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{GI}\\times \\overset{\\to }{GH}| \\\\  & =\\sqrt{{8}^{2}+(-1)^{2}+(-5)^{2}} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,GHI$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$\n\nLet's also compute $GI$ since it appears in the formula:\n\n$$\n\\begin{aligned}GI & =|\\overset{\\to }{GI}| \\\\  & =\\sqrt{{1}^{2}+{3}^{2}+{1}^{2}} \\\\  & =\\sqrt{11}.\\end{aligned}\n$$\n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}HK\\cdot GI,$ we get\n\n$$\n\\begin{aligned}\\frac{3\\sqrt{10}}{2} & =\\frac{1}{2}HK\\cdot \\sqrt{11} \\\\ HK & =\\frac{3\\sqrt{10}}{\\sqrt{11}} \\\\ HK & =\\frac{3\\sqrt{110}}{11}.\\end{aligned}\n$$" 13194139534719 true] [17592186305372 1000 #edb/ref 17592186305373 13194139534719 true] [17592186305372 1040 #edb/ref 17592186045449 13194139534719 true] [17592186305372 1041 "field-1" 13194139534719 true] [17592186305372 1104 #edb/ref 17592186305373 13194139534719 true] [17592186305372 1110 