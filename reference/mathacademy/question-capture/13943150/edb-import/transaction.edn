[{:db/id "q-221409/field-1/bd79c0c06aebc779b7361f220b7135833ae30fce981dac621db59a8b51d52f52" :answer/id #uuid "47fb24da-eac7-584f-922f-af403cf0767c" :answer/type :answer.type/math :answer/value "\\frac{17}{2}" :db/ensure [:answer/validate]} {:db/id "q-221409/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "fd419ccb-84e9-57af-98d4-61481a70a1d8" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-221409/field-1" :answer-field/id #uuid "be065250-6086-57cd-9037-955b5aed565c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-221409/field-1/bd79c0c06aebc779b7361f220b7135833ae30fce981dac621db59a8b51d52f52" :answer-field/choices ["q-221409/field-1/bd79c0c06aebc779b7361f220b7135833ae30fce981dac621db59a8b51d52f52" "q-221409/field-1/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012"] :db/ensure [:answer-field/validate]} {:db/id "q-221409/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "c66e796e-fd51-5ace-b895-6f20c30c0a11" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-221409/field-2" :answer-field/id #uuid "754b7345-ea5f-562e-ad6d-985be595c07b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-221409/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-221409/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-221409" :question/id #uuid "4912e69f-9618-5f58-b4c5-65bde959561a" :question/math-academy-id "q-221409" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}-17x+{(\\frac{17}{2})}^{2})+5=(x\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-17x+{(\\frac{17}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{17}{2}x+{(\\frac{17}{2})}^{2} & = \\\\ {(x-\\frac{17}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-17x+{(\\frac{17}{2})}^{2})+5 & = \\\\ {(x-\\frac{17}{2})}^{2}+5 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-221409/field-1" "q-221409/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7"] :knowledge-point/questions ["q-221409"] :db/ensure [:knowledge-point/validate]} {:db/id "q-223562/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "a3424d43-03b6-5d7f-b8da-ada54fe1d67b" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-223562/field-1" :answer-field/id #uuid "193bdaaa-4349-5dbc-9762-cb114ea6f338" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-223562/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-223562/field-1/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-223562/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "ecbb6bc1-e49d-588e-bdee-2598a260cb64" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-223562/field-2" :answer-field/id #uuid "f9078fbf-728c-5ccc-a085-347453042642" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-223562/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-223562/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-223562" :question/id #uuid "b66d464c-bf99-514a-9716-2816cfea2d68" :question/math-academy-id "q-223562" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({u}^{2}-3u+\\frac{9}{4})+5=(u\\,\\,-$\n{{field-1}} $)^{2}+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{u}^{2}-2au+{a}^{2}=(u-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{u}^{2}-3u+\\frac{9}{4} & = \\\\ {u}^{2}-3u+{(\\frac{3}{2})}^{2} & = \\\\ {u}^{2}-2\\cdot \\frac{3}{2}u+{(\\frac{3}{2})}^{2} & = \\\\ {(u-\\frac{3}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({u}^{2}-3u+\\frac{9}{4})+5 & = \\\\ {(u-\\frac{3}{2})}^{2}+5 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-223562/field-1" "q-223562/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7"] :knowledge-point/questions ["q-223562"] :db/ensure [:knowledge-point/validate]} {:db/id "q-223564/field-1/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer/id #uuid "7a7bf52e-a1a7-584b-8695-6c3c39444b5f" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "q-223564/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "04190d2e-b055-5fd3-b148-6a4de28f60b6" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-223564/field-1" :answer-field/id #uuid "12a6411a-0ffa-5f41-a27c-dc58211ea392" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-223564/field-1/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer-field/choices ["q-223564/field-1/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" "q-223564/field-1/4