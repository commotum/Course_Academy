igned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-223560/field-1" "q-223560/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7"] :knowledge-point/questions ["q-223560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140299/selection/29c77962e6afc2d18da7de8fd93240df2010c2c74a3d87be64d03caba0d3bf67" :answer/id #uuid "18882416-a042-54ae-8529-beef8e6001a7" :answer/type :answer.type/math :answer/value "{(x-\\frac{1}{4})}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140299/selection/ca96bae15c48d8029836b96ab675d13e459bcff9740f1d75ee5816ce6f94d9de" :answer/id #uuid "eeb1bb6f-38ad-5343-a0c6-8523e83801d0" :answer/type :answer.type/math :answer/value "{(x-\\frac{1}{2})}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140299/selection/ab7dd49bf34993bc9280958bf87cc0968f3ee9ad5ca4b5513e1d3d47fc035e32" :answer/id #uuid "a3f38c9b-b51f-5c04-9d72-ad56ea649a11" :answer/type :answer.type/math :answer/value "{(x-1)}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140299/selection/c0610ee76efe4421e6305df485c7e5d45627c5de13f426bbe6372d84b9d6c3e5" :answer/id #uuid "86479541-6531-5770-bcaf-b350b86b0891" :answer/type :answer.type/math :answer/value "{(x+\\frac{1}{2})}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140299/selection/9a8b89251e530fe31ad545c5e611bcf9a26a0b34563d6e60a34a79a34f65c936" :answer/id #uuid "5a896dbe-ffc8-5334-9ea1-3cd576c7d6fe" :answer/type :answer.type/math :answer/value "{(x+1)}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140299/selection" :answer-field/id #uuid "0c8de47a-4432-50f0-86fc-6e44df0942a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140299/selection/ca96bae15c48d8029836b96ab675d13e459bcff9740f1d75ee5816ce6f94d9de" :answer-field/choices ["q-140299/selection/29c77962e6afc2d18da7de8fd93240df2010c2c74a3d87be64d03caba0d3bf67" "q-140299/selection/ca96bae15c48d8029836b96ab675d13e459bcff9740f1d75ee5816ce6f94d9de" "q-140299/selection/ab7dd49bf34993bc9280958bf87cc0968f3ee9ad5ca4b5513e1d3d47fc035e32" "q-140299/selection/c0610ee76efe4421e6305df485c7e5d45627c5de13f426bbe6372d84b9d6c3e5" "q-140299/selection/9a8b89251e530fe31ad545c5e611bcf9a26a0b34563d6e60a34a79a34f65c936"] :db/ensure [:answer-field/validate]} {:db/id "q-140299" :question/id #uuid "fedd0dc2-da2b-59c1-ac72-8eb5fe3af97b" :question/math-academy-id "q-140299" :question/problem "Rewrite the expression \n\n$$\n({x}^{2}-x+\\frac{1}{4})-1\n$$\n\nas the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a)^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x+\\frac{1}{4} & = \\\\ {x}^{2}-x+{(\\frac{1}{2})}^{2} & = \\\\ {x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2} & = \\\\ {(x-\\frac{1}{2})}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-x+\\frac{1}{4})-1 & = \\\\ {(x-\\frac{1}{2})}^{2}-1 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140299/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "34299c34-b199-5100-8fb6-c190eb1db2f7"] :knowledge-point/questions ["q-140299"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141540/selection/be56cea5809249e31eac2c23483ce299d056f80426f494064e32f216a4265b2c" :answer/id #uuid "9827886f-ebb0-5fe5-bcb5-b2ca74cafd3e" :answer/type :answer.type/math :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "q-141540/selection/60daf6480c3809fbe355c2d6be473f47b7350fe1c81a0a61d036c21afbf95f3c" :answer/id #uuid "d89edef6-006d-524e-8820-7e349f98a512" :answer/type :answer.type/math :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{121}{4}" :db/ensure [:answer/validate]} {:db/id "q-141540/selection/b64a07ee50eab97dc5ca5f73253cbc2d31280dfa1eda9