1}{2})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}\n$$\n\nFinally, evaluating the last term, we get\n\n$$\n{(x+\\frac{11}{2})}^{2}-\\frac{121}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141540/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2"] :knowledge-point/questions ["q-141540"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141527/selection/a1c97b3d53a13572d40e125cad0361f0db1348564ecc34d5f60b9740213ed28b" :answer/id #uuid "84bee06c-adb2-57dd-8a91-6a4cdbde5fc0" :answer/type :answer.type/math :answer/value "{(y+\\frac{11}{4})}^{2}-\\frac{21}{2}" :db/ensure [:answer/validate]} {:db/id "q-141527/selection/349bd12c6d0310289004b6d21981059f860ac0d4b78f6fdaa4ec1b6a5740d2ce" :answer/id #uuid "2e99af01-e9da-55af-bcb9-ed3939739ffa" :answer/type :answer.type/math :answer/value "{(y+\\frac{11}{2})}^{2}-5" :db/ensure [:answer/validate]} {:db/id "q-141527/selection/23601633f2c5f029dbec68faa45c4b281c9f2e3842c968da0597add1712c8e72" :answer/id #uuid "401105ee-6160-5d76-bbc1-c1f65abb0450" :answer/type :answer.type/math :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{25}{4}" :db/ensure [:answer/validate]} {:db/id "q-141527/selection/6119daa98b03b56fedf639a04f9abeba225ab265012c5b18c34a92551c963a32" :answer/id #uuid "fc4bc4ab-5b42-5785-af1a-073479f8267f" :answer/type :answer.type/math :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/ensure [:answer/validate]} {:db/id "q-141527/selection/16df40fc6806e8155b2ed4c290b49a0ed13d45d7b0e7d714cc7c5f106c699537" :answer/id #uuid "bd5b4b70-a36e-5cec-b9a0-1038ac214334" :answer/type :answer.type/math :answer/value "{(y+\\frac{11}{4})}^{2}-5" :db/ensure [:answer/validate]} {:db/id "q-141527/selection" :answer-field/id #uuid "7097b335-a583-5ff7-be11-72c547cffe2d" :answer-field/key "selection" :answer-field/type :answer-field.type/rad