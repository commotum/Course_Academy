[{:db/id "q-107360/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "9d1a260e-a31b-5401-9a89-2e7d9261b893" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-107360/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "c5aa7d8b-faf1-5256-bf64-f931a0790b86" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-107360/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ddfc82f7-0ca2-5268-bdae-7aa98b4b447d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-107360/selection/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" :answer/id #uuid "05322057-8b0e-56bb-81ec-0970aa594e51" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-107360/selection/2ebc133599183e5fdb5b6248a8ea00bdd0440ff336252ee383591a8699a758ca" :answer/id #uuid "c6f4b802-aef0-57ce-8c54-825536e1090f" :answer/type :answer.type/math :answer/value "-\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-107360/selection" :answer-field/id #uuid "4271b4ea-d411-5043-8d9d-17669ba4688e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107360/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer-field/choices ["q-107360/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" "q-107360/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-107360/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-107360/selection/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" "q-107360/selection/2ebc133599183e5fdb5b6248a8ea00bdd0440ff336252ee383591a8699a758ca"] :db/ensure [:answer-field/validate]} {:db/id "q-107360" :question/id #uuid "d088e2f4-98bd-51ca-b324-ad0066961fab" :question/math-academy-id "q-107360" :question/is-example false :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{1-4x}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=1-4x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-4) \\\\  & =-\\frac{2}{\\sqrt{1-4x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={(-\\frac{2}{\\sqrt{1-4x}})|}_{x=-2} \\\\  & =-\\frac{2}{\\sqrt{1-4(-2)}} \\\\  & =-\\frac{2}{3}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107360/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204"] :knowledge-point/questions ["q-107360"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342680/field-1/0b6ccf5a0f47260ad964b3096e6a9dff29ea5d2b247177894d751fce56514f1d" :answer/id #uuid "2ce307e5-e22e-5d90-96e6-f0348515a033" :answer/type :answer.type/math :answer/value "\\frac{x-3}{\\sqrt{x^2-6x}}" :db/ensure [:answer/validate]} {:db/id "q-342680/field-1/7da1dd298cfcc84d7395b55638b7e0c61f97cb23e78528ed0aa4713f7c17e40a" :answer/id #uuid "84308f97-9abd-5b9d-913b-85c40ca9e5a5" :answer/type :answer.type/math :answer/value "2x-6" :db/ensure [:answer/validate]} {:db/id "q-342680/field-1" :answer-field/id #uuid "3ce5253c-a2dd-5405-ae23-b94286e309cf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342680/field-1/0b6ccf5a0f47260ad964b3096e6a9dff29ea5d2b247177894d751fce56514f1d" :answer-field/choices ["q-342680/field-1/0b6ccf5a0f47260ad964b3096e6a9dff29ea5d2b247177894d751fce56514f1d" "q-342680/field-1/7da1dd298cfcc84d7395b55638b7e0c61f97cb23e78528ed0aa4713f7c17e40a"] :db/ensure [:answer-field/validate]} {:db/id "q-342680" :question/id #uuid "7df4d434-8d33-5d38-aa4e-4d3877f594d6" :question/math-academy-id "q-342680" :question/is-example false :question/problem "Given that $y=\\sqrt{{x}^{2}-6x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u={x}^{2}-6x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot (2x-6) \\\\  & =\\frac{2(x-3)}{2\\sqrt{{x}^{2}-6x}} \\\\  & =\\frac{x-3}{\\sqrt{{x}^{2}-6x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342680/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204"] :knowledge-point/questions ["q-342680"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342764/field-1/d9d7a91966e1b64bd23c32f9b60cf763d4f696870e24ddf536c5645abd5dcac9" :answer/id #uuid "5cc49d45-6162-51f3-8a8e-bd0382d5fa13" :answer/type :answer.type/math :answer/value "-\\frac{5}{2(5x+1)\\sqrt{5x+1}}" :db/ensure [:answer/validate]} {:db/id "q-342764/field-1" :answer-field/id #uuid "ec56b9fd-282c-517f-b467-4c1ed9b89331" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342764/field-1/d9d7a91966e1b64bd23c32f9b60cf763d4f696870e24ddf536c5645abd5dcac9" :answer-field/choices ["q-342764/field-1/d9d7a91966e1b64bd23c32f9b60cf763d4f696870e24ddf536c5645abd5dcac9"] :db/ensure [:answer-field/validate]} {:db/id "q-342764" :question/id #uuid "f410e62b-fbc6-55dc-baa4-c0ee039c46d3" :question/math-academy-id "q-342764" :question/is-example false :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{5x+1}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=5x+1.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 5 \\\\  & =-\\frac{5}{2\\sqrt{{u}^{3}}} \\\\  & =-\\frac{5}{2\\sqrt{(5x+1)^{3}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342764/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204"] :knowledge-point/questions ["q-342764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342875/field-1/f688a964b5dbd99ec2358fe55b289763c3286ac934fbccd225a2017a0fae12b4" :answer/id #uuid "2450036d-1de1-555d-a0a4-2d4d5b43cd86" :answer/type :answer.type/math :answer/value "5x^4-16x^3" :db/ensure [:answer/validate]} {:db/id "q-342875/field-1/db62ac1a4d5c70dc2abd16f1c6d8ed2d91384de96a8b16160b323f8d2534ae45" :answer/id #uuid "c69c435d-ccdc-5192-8a16-746d3a6ba186" :answer/type :answer.type/math :answer/value "5x^4-4x^3" :db/ensure [:answer/validate]} {:db/id "q-342875/field-1" :answer-field/id #uuid "e6f3f48d-e24a-53c3-b195-5cc40828ce93" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342875/field-1/f688a964b5dbd99ec2358fe55b289763c3286ac934fbccd225a2017a0fae12b4" :answer-field/choices ["q-342875/field-1/f688a964b5dbd99ec2358fe55b289763c3286ac934fbccd225a2017a0fae12b4" "q-342875/field-1/db62ac1a4d5c70dc2abd16f1c6d8ed2d91384de96a8b16160b323f8d2534ae45"] :db/ensure [:answer-field/validate]} {:db/id "q-342875" :question/id #uuid "51a9f7ec-b27f-5953-a72f-6724c13f116d" :question/math-academy-id "q-342875" :question/is-example false :question/problem "Given that $f(x)={({x}^{5}-4{x}^{4})}^{2},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2({x}^{5}-4{x}^{4})($\n{{field-1}}\n$)$" :question/worked-solution "Let $g(x)={x}^{5}-4{x}^{4}$ and $f(g(x))=g(x)^{2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{2})^{′}=2g, \\\\ {g}^{′}(x) & =({x}^{5}-4{x}^{4})^{′}=5{x}^{4}-16{x}^{3}.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =2g\\cdot (5{x}^{4}-16{x}^{3}) \\\\  & =2({x}^{5}-4{x}^{4})(\\,5{x}^{4}-16{x}^{3}\\,).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342875/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3"] :knowledge-point/questions ["q-342875"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342883/field-1/c51e807dee2ffb2ce618de7c72f0416034c915f88b64d0b2dc8e480181e3b4e5" :answer/id #uuid "fa2378b3-db88-5ed8-876a-21cfbf638b32" :answer/type :answer.type/math :answer/value "\\frac{5}{2\\sqrt{5x-4}}" :db/ensure [:answer/validate]} {:db/id "q-342883/field-1" :answer-field/id #uuid "f8bbf386-a4ba-5035-934e-9fd750e41732" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342883/field-1/c51e807dee2ffb2ce618de7c72f0416034c915f88b64d0b2dc8e480181e3b4e5" :answer-field/choices ["q-342883/field-1/c51e807dee2ffb2ce618de7c72f0416034c915f88b64d0b2dc8e480181e3b4e5"] :db/ensure [:answer-field/validate]} {:db/id "q-342883" :question/id #uuid "fec3c3e3-95f5-51f8-a1cd-c18f8ec4257f" :question/math-academy-id "q-342883" :question/is-example false :question/problem "Given that $f(x)=\\sqrt{5x-4},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=5x-4$ and $f(g(x))=\\sqrt{g(x)}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & ={(\\sqrt{g})}^{′}=\\frac{1}{2\\sqrt{g}}, \\\\ {g}^{′}(x) & =(5x-4)^{′}=5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =\\frac{1}{2\\sqrt{g}}\\cdot 5 \\\\  & =\\frac{5}{2\\sqrt{5x-4}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342883/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3"] :knowledge-point/questions ["q-342883"] :db/ensure [:knowledge-point/validate]}]
