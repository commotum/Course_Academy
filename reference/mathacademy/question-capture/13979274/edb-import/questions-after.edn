#{[{:db/id #edb/ref 17592186280102 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa39df28-3f8b-553a-9f48-d7f7da421b7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186280104} {:answer/id #uuid "e888084e-700b-515d-a70b-e0794909d8a6" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186280105} {:answer/id #uuid "b56d6e51-8926-5292-a3ea-a06ac5508996" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186280106} {:answer/id #uuid "03c22270-97f2-55a3-945e-e91a620fee86" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280107} {:answer/id #uuid "ebf77704-42ab-57a3-81c6-67ae7a0acc97" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280108}] :answer-field/correct {:answer/id #uuid "b56d6e51-8926-5292-a3ea-a06ac5508996" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186280106} :answer-field/id #uuid "df5d9170-f3ff-51b5-a94a-88c8d7adf1ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280103}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9f201054-0384-5c36-b0e3-d164b311f9a3" :question/math-academy-id "q-101316" :question/problem "${lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1} & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{6}}{{x}^{3}}+\\frac{7{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2{x}^{3}+7-\\frac{9}{{x}^{3}})}{(2-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}+7-0}{2-0} \\\\  & =\\frac{1}{2}{lim}_{x\\to \\infty }(2{x}^{3}+7) \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280109 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aed695e-67c1-5dcd-96ff-6b41b1965a30" :answer/type {:db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186280111} {:answer/id #uuid "72e2d26f-bee9-58f1-92e7-547d7039c083" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186280112} {:answer/id #uuid "2346d9fb-ee46-5705-924b-38fdf3d6a505" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186280113} {:answer/id #uuid "85335e6f-22ab-530e-8b8f-cd732d8e43ea" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186280114} {:answer/id #uuid "b55e61f3-5da5-5388-8d15-1210bb4ff4ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186280115}] :answer-field/correct {:answer/id #uuid "4aed695e-67c1-5dcd-96ff-6b41b1965a30" :answer/type {:db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186280111} :answer-field/id #uuid "bb1d649c-c5ca-508b-a63d-05953e6a21b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280110}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0196030b-ed4f-5daa-90a4-0e2ed9bedb1e" :question/math-academy-id "q-106705" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x>0$ with $f(x)=\\frac{|{x}^{3}-5|}{2-{x}^{3}}?$" :question/worked-solution "For large positive values of $x,$ we have $|{x}^{3}-5|=({x}^{3}-5).$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n{lim}_{x\\to \\infty }\\frac{|{x}^{3}-5|}{2-{x}^{3}}={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}}.\n$$\n\nThe horizontal asymptote for $x>0$ is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-\\frac{{x}^{3}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(1-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-1)} \\\\  & =\\frac{1-0}{0-1} \\\\  & =-1.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=-1.$"}] [{:db/id #edb/ref 17592186280116 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d66a3589-0da5-5f32-ba48-a506c649a6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186280118}] :answer-field/correct {:answer/id #uuid "d66a3589-0da5-5f32-ba48-a506c649a6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186280118} :answer-field/id #uuid "347827f2-cb32-5655-9539-044dcf23f8a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280117}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "143183aa-b87e-56d7-a491-9ddede7028da" :question/math-academy-id "q-302240" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x<0$ with $f(x)=\\frac{|8x-7|}{-5x+2}?$\n\nThe horizontal asymptote is $y=$\n\n{{field-1}}." :question/worked-solution "For large negative values of $x,$ we have $|8x-7|=-(8x-7).$ Consequently, for $x\\to -\\infty ,$ we get\n\n$$\n{lim}_{x\\to -\\infty }\\frac{|8x-7|}{-5x+2}={lim}_{x\\to -\\infty }\\frac{-(8x-7)}{-5x+2}.\n$$\n\nThe horizontal asymptote for $x<0$ is $y={lim}_{x\\to -\\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }f(x) & ={lim}_{x\\to -\\infty }\\frac{-(8x-7)}{-5x+2} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(\\frac{8x}{x}-\\frac{7}{x})}{(\\frac{-5x}{x}+\\frac{2}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\frac{-(8-\\frac{7}{x})}{(-5+\\frac{2}{x})} \\\\  & =\\frac{-(8-0)}{-5+0} \\\\  & =\\frac{8}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=\\frac{8}{5}.$"}] [{:db/id #edb/ref 17592186280119 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68dc4387-36f5-5f07-ac39-499a82476420" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186280121} {:answer/id #uuid "ce25b91e-3d07-5375-b04c-764e52d5df2e" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186280122} {:answer/id #uuid "a1517e92-46c4-5e59-883d-9defce81438f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}" :db/id #edb/ref 17592186280123} {:answer/id #uuid "3f1bb7f6-e0b9-5355-b04a-1305e87389d3" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186280124} {:answer/id #uuid "5a8038b8-3fba-5b48-92aa-941f1c9473dc" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186280125}] :answer-field/correct {:answer/id #uuid "ce25b91e-3d07-5375-b04c-764e52d5df2e" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186280122} :answer-field/id #uuid "e4d0946f-0273-5df9-a9c5-69933b28e4ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280120}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7e620762-9516-52ae-860d-cc352b75f611" :question/math-academy-id "q-35835" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-\\frac{5{x}^{7}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{10{x}^{3}}{{x}^{3}}+\\frac{x}{{x}^{3}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-5{x}^{4}+\\frac{1}{{x}^{3}})}{(10+\\frac{1}{{x}^{2}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{-5{x}^{4}+0}{10+0+0} \\\\  & =-\\frac{1}{2}{lim}_{x\\to \\infty }{x}^{4} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186280126 :knowledge-point/_questions [{:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bc57e8d-0be9-5b7f-86fe-36bb9122143d" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186280128} {:answer/id #uuid "e6b71e4a-024d-5309-a7c5-50eda1f1800b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280129} {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} {:answer/id #uuid "1f0087ba-9d84-549b-84ed-f58e95c4364b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280131} {:answer/id #uuid "89e37013-c1e8-5507-a0f5-d2d0c0a3a256" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280132}] :answer-field/correct {:answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186280130} :answer-field/id #uuid "4b24b360-5353-5ebf-8afe-d3f9dac3298b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280127}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b690b281-73b5-5090-a017-0742982f5d27" :question/math-academy-id "q-78008" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+\\frac{1}{{x}^{2}})}{(2+\\frac{1}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+0)}{(2+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{x}{2} \\\\  & =-\\infty .\\end{aligned}\n$$"}]}
