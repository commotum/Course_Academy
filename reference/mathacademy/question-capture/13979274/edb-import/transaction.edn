2ae-860d-cc352b75f611" :question/math-academy-id "q-35835" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{-5{x}^{7}+1}{10{x}^{3}+x+3} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-\\frac{5{x}^{7}}{{x}^{3}}+\\frac{1}{{x}^{3}})}{(\\frac{10{x}^{3}}{{x}^{3}}+\\frac{x}{{x}^{3}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(-5{x}^{4}+\\frac{1}{{x}^{3}})}{(10+\\frac{1}{{x}^{2}}+\\frac{3}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{-5{x}^{4}+0}{10+0+0} \\\\  & =-\\frac{1}{2}{lim}_{x\\to \\infty }{x}^{4} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35835/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4"] :knowledge-point/questions ["q-35835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78008/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "5bc57e8d-0be9-5b7f-86fe-36bb9122143d" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-78008/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1f0087ba-9d84-549b-84ed-f58e95c4364b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-78008/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "89e37013-c1e8-5507-a0f5-d2d0c0a3a256" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-78008/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "faddf15f-87b1-534f-9527-19e330a8ce06" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-78008/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "e6b71e4a-024d-5309-a7c5-50eda1f1800b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-78008/selection" :answer-field/id #uuid "4b24b360-5353-5ebf-8afe-d3f9dac3298b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78008/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer-field/choices ["q-78008/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-78008/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-78008/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-78008/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" "q-78008/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-78008" :question/id #uuid "b690b281-73b5-5090-a017-0742982f5d27" :question/math-academy-id "q-78008" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+\\frac{1}{{x}^{2}})}{(2+\\frac{1}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+0)}{(2+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{x}{2} \\\\  & =-\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78008/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d"] :knowledge-point/questions ["q-78008"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101316/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "fa39df28-3f8b-553a-9f48-d7f7da421b7a" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-101316/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "b56d6e51-8926-5292-a3ea-a06ac5508996" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-101316/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "e888084e-700b-515d-a70b-e0794909d8a6" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-101316/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ebf77704-42ab-57a3-81c6-67ae7a0acc97" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-101316/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "03c22270-97f2-55a3-945e-e91a620fee86" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-101316/selection" :answer-field/id #uuid "df5d9170-f3ff-51b5-a94a-88c8d7adf1ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101316/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer-field/choices ["q-101316/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-101316/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-101316/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-101316/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-101316/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-101316" :question/id #uuid "9f201054-0384-5c36-b0e3-d164b311f9a3" :question/math-academy-id "q-101316" :question/problem "${lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1} & ={lim}_{x\\to \\infty }\\frac{(\\frac{2{x}^{6}}{{x}^{3}}+\\frac{7{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(2{x}^{3}+7-\\frac{9}{{x}^{3}})}{(2-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{2{x}^{3}+7-0}{2-0} \\\\  & =\\frac{1}{2}{lim}_{x\\to \\infty }(2{x}^{3}+7) \\\\  & =\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101316/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d"] :knowledge-point/questions ["q-101316"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106705/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" :answer/id #uuid "b55e61f3-5da5-5388-8d15-1210bb4ff4ef" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "q-106705/selection/dbaf85835946aefb97564ba0d1ea287b684a4c8821f4256502e349376df74d28" :answer/id #uuid "85335e6f-22ab-530e-8b8f-cd732d8