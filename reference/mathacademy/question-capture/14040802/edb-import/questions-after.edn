d}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-6t)⟩ \\\\  & =⟨6t-8,\\,6t-6⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨6(1)-8,\\,6(1)-6⟩ \\\\  & =⟨-2,\\,0⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309676 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1" :knowledge-point/title "Computing the Acceleration of a Particle at a Given Moment Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e94f355a-0a7c-5a32-b66e-0b295251419a" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186309678}] :answer-field/correct {:answer/id #uuid "e94f355a-0a7c-5a32-b66e-0b295251419a" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186309678} :answer-field/id #uuid "6fa3163d-a841-5a4a-b10a-bf46399e3f96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309677} {:answer-field/choices [{:answer/id #uuid "f681dbdc-c9c5-5a62-abc3-08009cbe1bf9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309680}] :answer-field/correct {:answer/id #uuid "f681dbdc-c9c5-5a62-abc3-08009cbe1bf9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186309680} :answer-field/id #uuid "5d486c79-64a2-5c4f-a5ea-7807d898cb17" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309679}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b9bce891-9ef1-53ff-8dfb-3b034b818faa" :question/math-academy-id "q-351395" :question/problem "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨2{t}^{3}-3{t}^{2}+1,\\,4+{t}^{3}-5{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=2.$ Do not round the answers.\n\n$a(2)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3{t}^{2}+1),\\,\\frac{\\text{d}}{\\text{d}t}(4+{t}^{3}-5{t}^{2})⟩ \\\\  & =⟨6{t}^{2}-6t,\\,3{t}^{2}-10t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-6t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-10t)⟩ \\\\  & =⟨12t-6,\\,6t-10⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨12(2)-6,\\,6(2)-10⟩ \\\\  & =⟨18,\\,2⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309681 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1" :knowledge-point/title "Computing the Acceleration of a Particle at a Given Moment Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8ca7285-ea2a-59c3-9786-6b4565295118" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186309683}] :answer-field/correct {:answer/id #uuid "a8ca7285-ea2a-59c3-9786-6b4565295118" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186309683} :answer-field/id #uuid "adce1de0-09f4-5166-a017-40de219a3693" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309682} {:answer-field/choices [{:answer/id #uuid "b5070a62-3897-50da-a2a3-c9829cf8ca0e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186309685}] :answer-field/correct {:answer/id #uuid "b5070a62-3897-50da-a2a3-c9829cf8ca0e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186309685} :answer-field/id #uuid "63ad7b18-a753-5a43-a654-8e6b12ec1f74" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309684}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bcb884f9-d3e9-5264-9041-49a495f1bdc8" :question/math-academy-id "q-351396" :question/problem "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨{t}^{3}-2{t}^{2}+5,\\,6+{t}^{3}-4{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=3.$ Do not round the answers.\n\n$a(3)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-2{t}^{2}+5),\\,\\frac{\\text{d}}{\\text{d}t}(6+{t}^{3}-4{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-4t,\\,3{t}^{2}-8t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-4t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t)⟩ \\\\  & =⟨6t-4,\\,6t-8⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=3,$ we substitute $t=3$ into the above:\n\n$$\n\\begin{aligned}a(3) & =⟨6(3)-4,\\,6(3)-8⟩ \\\\  & =⟨14,\\,10⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309686 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1" :knowledge-point/title "Computing the Acceleration of a Particle at a Given Moment Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7579ec8e-c23b-5e8e-954f-727f33689202" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186309688} {:answer/id #uuid "3e40f78e-d5d7-5f43-b127-269bbd39ebb8" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt{2}" :db/id #edb/ref 17592186309689}] :answer-field/correct {:answer/id #uuid "3e40f78e-d5d7-5f43-b127-269bbd39ebb8" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt{2}" :db/id #edb/ref 17592186309689} :answer-field/id #uuid "db488ef3-c7b6-5436-b8ee-6d4b05be4b17" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309687}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ea9ca4c4-0c65-56db-9cd7-d20e345623e9" :question/math-academy-id "q-351410" :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨3{t}^{3}-4{t}^{2}+2,\\,2{t}^{3}-{t}^{2}+5⟩.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=1\\,\\text{s}.$ Do not round the answer.\n\nThe magnitude of the acceleration is\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}-4{t}^{2}+2),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-{t}^{2}+5)⟩ \\\\  & =⟨9{t}^{2}-8t,\\,6{t}^{2}-2t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}-8t),\\,\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-2t)⟩ \\\\  & =⟨18t-8,\\,12t-2⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨18(1)-8,\\,12(1)-2⟩ \\\\  & =⟨18-8,\\,12-2⟩ \\\\  & =⟨10,\\,10⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$\n\n$$\n\\begin{aligned}|a(1)| & =|⟨10,\\,10⟩| \\\\  & =\\sqrt{{10}^{2}+{10}^{2}} \\\\  & =\\sqrt{100+100} \\\\  & =\\sqrt{200} \\\\  & =10\\sqrt{2}\\end{aligned}\n$$\n\nSo, the magnitude of the acceleration at time $t=1\\,\\text{s}$ is $10\\sqrt{2}{\\text{ m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186309690 :knowledge-point/_questions [{:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa3ecd6e-cc2c-5040-96c8-11a6c2a50085" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨8,-\\frac{9}{8}{t}^{2}⟩" :db/id #edb/ref 17592186309692} {:answer/id #uuid "8465d661-a908-5b71-916d-65d1a6cec582" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨8t,-\\frac{3}{160}{t}^{5}⟩" :db/id #edb/ref 17592186309693} {:answer/id #uuid "67ea8408-9569-5c77-b3f1-d714ea38948b" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨8t,\\,-\\frac{3}{8}{t}^{3}⟩" :db/id #edb/ref 17592186309694} {:answer/id #uuid "1a195426-d1f9-5a53-a7a4-b637f305ae9d" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨\\frac{4}{3}{t}^{3},-\\frac{3}{160}{t}^{5}⟩" :db/id #edb/ref 17592186309695} {:answer/id #uuid "71e92916-ce8d-5d8d-87e0-dceba206a82c" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨8t,-\\frac{3}{16}{t}^{3}⟩" :db/id #edb/ref 17592186309696}] :answer-field/correct {:answer/id #uuid "67ea8408-9569-5c77-b3f1-d714ea38948b" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=⟨8t,\\,-\\frac{3}{8}{t}^{3}⟩" :db/id #edb/ref 17592186309694} :answer-field/id #uuid "5489bda6-733a-5c8f-b15f-605d0ae36527" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309691}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1c5f639c-8e4f-5266-a543-d56a9c0dc420" :question/math-academy-id "q-6393" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨4{t}^{2},\\,-\\frac{3}{32}{t}^{4}⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{32}{t}^{4})⟩ \\\\  & =⟨8t,\\,-\\frac{3}{8}{t}^{3}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088228 :knowledge-point/_questions [{:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c87ef4-516b-5fd3-946b-8f9c62c98016" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨5, 2t⟩" :db/id #edb/ref 17592186086300} {:answer/id #uuid "9e58aea6-19dc-5488-bc80-93d7632e221f" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨ - 8, 4⟩" :db/id #edb/ref 17592186086301} {:answer/id #uuid "39afe4ac-830b-58c4-b06b-d3fb4983f0bc" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨5t, 2t^{2}⟩" :db/id #edb/ref 17592186086302} {:answer/id #uuid "5f00365e-8d58-5b9f-b448-aa58586fbb31" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨5, 4t⟩" :db/id #edb/ref 17592186086303} {:answer/id #uuid "6586d8bf-7a12-561b-af59-2bdb282646dc" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨5, 2⟩" :db/id #edb/ref 17592186086304}] :answer-field/correct {:answer/id #uuid "5f00365e-8d58-5b9f-b448-aa58586fbb31" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨5, 4t⟩" :db/id #edb/ref 17592186086303} :answer-field/id #uuid "c8eeedcb-7380-5490-8e80-bea8245eee54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086299}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fca59699-e72b-5149-821a-1daf54baaef5" :question/math-academy-id "q-7156" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨5t-8,\\,2{t}^{2}+4⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5t-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+4)⟩ \\\\  & =⟨5,\\,4t⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309697 :knowledge-point/_questions [{:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Position Vector"}] :ques