[{:db/id "q-351106/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "1a95e0f8-3d39-59a5-9c72-b0ebc49395ef" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-351106/field-1" :answer-field/id #uuid "3b0b7bc9-1d77-53ae-ac81-456872b98360" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351106/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-351106/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-351106/field-2/e9373628a8aa028817b563ea764550e3e776e7236efec469622843d0dd4809fb" :answer/id #uuid "698abd49-3d65-5f8c-89ce-e14e9f2f7da8" :answer/type :answer.type/math :answer/value "6t^2" :db/ensure [:answer/validate]} {:db/id "q-351106/field-2" :answer-field/id #uuid "fb5b59be-8248-5187-9914-1c566b5c07bb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351106/field-2/e9373628a8aa028817b563ea764550e3e776e7236efec469622843d0dd4809fb" :answer-field/choices ["q-351106/field-2/e9373628a8aa028817b563ea764550e3e776e7236efec469622843d0dd4809fb"] :db/ensure [:answer-field/validate]} {:db/id "q-351106" :question/id #uuid "d914fdaf-5f44-5351-9a53-8c080fff8094" :question/math-academy-id "q-351106" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨9t-4,\\,2{t}^{3}+5⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9t-4),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+5)⟩ \\\\  & =⟨9,\\,6{t}^{2}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351106/field-1" "q-351106/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-351106"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-7156"] :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨5t-8,\\,2{t}^{2}+4⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5t-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+4)⟩ \\\\  & =⟨5,\\,4t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-351116/field-1/41efcf55c6b23992705af5ee181e7d2a7b8b4f67c7a005ffa5519533e30f701f" :answer/id #uuid "2974d91c-0100-55cd-b6ab-7d141f5084f4" :answer/type :answer.type/math :answer/value "2^t\\ln(2)" :db/ensure [:answer/validate]} {:db/id "q-351116/field-1" :answer-field/id #uuid "37164766-c4cf-59f7-b1b4-3d979594054d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351116/field-1/41efcf55c6b23992705af5ee181e7d2a7b8b4f67c7a005ffa5519533e30f701f" :answer-field/choices ["q-351116/field-1/41efcf55c6b23992705af5ee181e7d2a7b8b4f67c7a005ffa5519533e30f701f"] :db/ensure [:answer-field/validate]} {:db/id "q-351116/field-2/902c78b254c69b675bd192ca252364bddc0616c7d884661351f01d7bc5da3064" :answer/id #uuid "46a81839-4d09-5cd5-8e94-6d6e516beac2" :answer/type :answer.type/math :answer/value "\\frac{2t}{t^2+1}" :db/ensure [:answer/validate]} {:db/id "q-351116/field-2" :answer-field/id #uuid "dbb809df-90a5-50b6-9c7b-c93a541ffe49" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351116/field-2/902c78b254c69b675bd192ca252364bddc0616c7d884661351f01d7bc5da3064" :answer-field/choices ["q-351116/field-2/902c78b254c69b675bd192ca252364bddc0616c7d884661351f01d7bc5da3064"] :db/ensure [:answer-field/validate]} {:db/id "q-351116" :question/id #uuid "32aed3df-fecd-5116-8366-f0c14f8d968a" :question/math-academy-id "q-351116" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨{2}^{t},\\,\\operatorname{ln}⁡({t}^{2}+1)⟩,\\,t>0.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+1))⟩ \\\\  & =⟨{2}^{t}\\operatorname{ln}⁡2,\\,\\frac{2t}{{t}^{2}+1}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351116/field-1" "q-351116/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-351116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351111/field-1/39e2cdcdf3c2e8355f9924af3c7d402b675f9ca92935e57ef42e934dd826a0a4" :answer/id #uuid "62e8efa6-4972-50f9-b498-6c7524dd3c25" :answer/type :answer.type/math :answer/value "3e^{3t}" :db/ensure [:answer/validate]} {:db/id "q-351111/field-1/afee57283268af03e40cbffa1bac272373a222c05d56dfe5be6e7ee02093cf3a" :answer/id #uuid "392a91b4-debd-575a-8ac2-0880734f81ab" :answer/type :answer.type/math :answer/value "e^{3t}" :db/ensure [:answer/validate]} {:db/id "q-351111/field-1" :answer-field/id #uuid "43e493cd-5784-560a-899b-78f9ddc307aa" :answer-field/key "field-1" :answer-field/type :answer-field.type