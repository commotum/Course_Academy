8becfbb098e8f08130cadf7d96bfeb86d"] :db/ensure [:answer-field/validate]} {:db/id "q-6393" :question/id #uuid "1c5f639c-8e4f-5266-a543-d56a9c0dc420" :question/math-academy-id "q-6393" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨4{t}^{2},\\,-\\frac{3}{32}{t}^{4}⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{32}{t}^{4})⟩ \\\\  & =⟨8t,\\,-\\frac{3}{8}{t}^{3}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6393/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-6393"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351167/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "20cd8292-d4c3-58b2-ab94-2e6e7ae19a90" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-351167/field-1" :answer-field/id #uuid "f8ab3c75-8fb1-5d76-9bce-4222c94b8a3d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351167/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-351167/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-351167/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "3fc3a10c-3e7d-5deb-993f-48d3fe1fbc32" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-351167/field-2" :answer-field/id #uuid "44625857-1179-57b4-a112-ca1dc2ffc089" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351167/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-351167/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-351167" :question/id #uuid "6114abe5-977b-5d52-bf38-29f0303c45f9" :question/math-academy-id "q-351167" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨4{t}^{3},\\,-2{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=1.$ Do not round the answers.\n\n$a(1)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(-2{t}^{2})⟩ \\\\  & =⟨12{t}^{2},\\,-4t⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨12(1)^{2},\\,-4(1)⟩ \\\\  & =⟨12,\\,-4⟩ \\\\  & =⟨12,\\,-4⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351167/field-1" "q-351167/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-351167"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121920/selection/296242391a49d147ca4ce8408234239db8eeb2b4a3228fa29366a4b7f2d95a93" :answer/id #uuid "ad3707ab-3aff-547a-bdb9-82b7b3495816" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{4{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121920/selection/22c0e6b000769346b4f7bab14b08a5cab10c5b95c1a2267e953cdbc07538c264" :answer/id #uuid "4de9a797-f1ce-5b26-95ae-b407bc40c871" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2{ln}^{2}⁡2+1}}{4}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121920/selection/be9ae5f9da138d43869e9bb8f40d55e4334f432223f4327f2243eaa3fc45d443" :answer/id #uuid "99a38f52-cf6d-533e-9b66-10b423236b24" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2\\operatorname{ln}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121920/selection/634ce3bed4330d83f0e814c9460146cfe125c3552ef408198f8ced0f696a5b01" :answer/id #uuid "5daab2e7-bcef-5e5a-8ce4-f57ae6e92922" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{4\\operatorname{ln}⁡2+1}}{4}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121920/selection/a7cd42c3e7f0f048b36a53788388e6ea4bc66767f5d9b1c6c35454483c4e123a" :answer/id #uuid "7988b24a-09a9-50a6-a15e-dd284de2b3c8" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121920/selection" :answer-field/id #uuid "7e63b100-734c-59f9-90da-29f98ac4158f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121920/selection/296242391a49d147ca4ce8408234239db8eeb2b4a3228fa29366a4b7f2d95a93" :answer-field/choices ["q-121920/selection/296242391a49d147ca4ce8408234239db8eeb2b4a3228fa29366a4b7f2d95a93" "q-121920/selection/22c0e6b000769346b4f7bab14b08a5cab10c5b95c1a2267e953cdbc07538c264" "q-121920/selection/be9ae5f9da138d43869e9bb8f40d55e4334f432223f4327f2243eaa3fc45d443" "q-121920/selection/634ce3bed4330d83f0e814c9460146cfe125c3552ef408198f8ced0f696a5b01" "q-121920/selection/a7cd42c3e7f0f048b36a53788388e6ea4bc66767f5d9b1c6c35454483c4e123a"] :db/ensure [:answer-field/validate]} {:db/id "q-121920" :question/id #uuid "2b79ce39-e3a6-5781-a9e4-71c93eee0b44" :question/math-academy-id "q-121920" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds is given by\n\n$$\nv=⟨{2}^{t-1},\\frac{1}{{t}^{2}+1}⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t-1}),\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{t}^{2}+1})⟩ \\\\  & =⟨{2}^{t-1}\\operatorname{ln}⁡2,-\\frac{2t}{({t}^{2}+1)^{2}}⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨{2}^{1-1}\\operatorname{ln}⁡2,-\\frac{2(1)}{({1}^{2}+1)^{2}}⟩ \\\\  & =⟨{2}^{0}\\operatorname{ln}⁡2,-\\frac{2}{4}⟩ \\\\  & =⟨\\operatorname{ln}⁡2,-\\frac{1}{2}⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨\\operatorname{ln}⁡2,-\\frac{1}{2}⟩| \\\\  & =\\sqrt{(\\operatorname{ln}⁡2)^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{{ln}^{2}⁡2+\\frac{1}{4}} \\\\  & =\\sqrt{\\frac{4{ln}^{2}⁡2+1}{4}} \\\\  & =\\frac{\\sqrt{4{ln}^{2}⁡2+1}}{2}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121920/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-121920"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121919/selection/1aeaf0971a8601cf4d61ae6255f6501a1dfb8acdfb2ac7759706acd17eb3e17d" :answer/id #uuid "4085bd9e-1247-5666-8815-aac532533d78" :answer/type :answer.type/math :answer/value "a(2)=⟨\\frac{3}{7},-2⟩" :db/ensure [:answer/validate]} {:db/id "q-121919/selection/bfb166c6f2cf6eb81eeaaf121f9f34daf42645af892ddc743464bae0540700fd" :answer/id #uuid "cecbd97b-7628-50d6-95f6-e7c18e8b9b52" :answer/type :answer.type/math :answer/value "a(2)=⟨\\frac{3}{5},-7⟩" :db/ensure [:answer/validate]} {:db/id "q-121919/selection/c6f62812fc10973fc149ec2d5544c350fba01a91e6603ade552a285e636ae474" :answer/id #uuid "07f65406-08e2-5687-9e82-865caec479cb" :answer/type :answer.type/math :answer/value "a(2)=⟨\\operatorname{ln}⁡7,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-121919/selection/e3c61caeec4a8409e4c971918127921f99f3642821b177f500b23b2e06681cf5" :answer/id #uuid "47d791e7-d07f-50cf-9bd9-a2151fcf8d50" :answer/type :answer.type/math :answer/value "a(2)=⟨\\frac{3}{7},-4⟩" :db/ensure [:answer/validate]} {:db/id "q-121919/selection/1af4b96f4d7e153d857cc3bb9092d65daed25e6acfc3f310ed84d94650af4c74" :answer/id #uuid "ff3ff216-38aa-57e4-b23f-625078696242" :answer/type :answer.type/math :answer/value "a(2)=⟨\\operatorname{ln}⁡3,-7⟩" :db/ensure [:answer/validate]} {:db/id "q-121919/selection" :answer-field/id #uuid "c9729a40-615c-546c-828f-575525d28002" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121919/selection/e3c61caeec4a8409e4c971918127921f99f3642821b177f500b23b2e06681cf5" :answer-field/choices ["q-121919/selection/1aeaf0971a8601cf4d61ae6255f6501a1dfb8acdfb2ac7759706acd17eb3e17d" "q-121919/selection/bfb166c6f2cf6eb81eeaaf121f9f34daf42645af892ddc743464bae0540700fd" "q-121919/selection/c6f62812fc10973fc149ec2d5544c350fba01a91e6603ade552a285e636ae474" "q-121919/selection/e3c61caeec4a8409e4c971918127921f99f3642821b177f500b23b2e06681cf5" "q-121919/selection/1af4b96f4d7e153d857cc3bb9092d65daed25e6acfc3f310ed84d94650af4c74"] :db/ensure [:answer-field/validate]} {:db/id "q-121919" :question/id #uuid "485b83d3-77da-50d6-9d88-1eeec6210db1" :question/math-academy-id "q-121919" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨\\operatorname{ln}⁡(3t+1),1-{t}^{2}⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a$ at time $t=2.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(3t+1)),\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})⟩ \\\\  & =⟨\\frac{3}{3t+1},-2t⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨\\frac{3}{3(2)+1},-2(2)⟩ \\\\  & =⟨\\frac{3}{7},-4⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121919/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-121919"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121917/selection/351ea70b0cedc52eb06a8a64d86d842671fc5d57c6fa522851ff5c4ffb136a30" :answer/id #uuid "2577bf1f-28c9-55aa-9795-bd89ae4067d5" :answer/type :answer.type/math :answer/value "\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121917/selection/51ed704b4828923d78ff39f191ec525b3a152e608cf89cadc1928935848ee5f0" :answer/id #uuid "6078f7b3-7f45-5ffc-aefb-f44c7c0a6b69" :answer/type :answer.type/math :answer/value "5\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121917/selection/cf57a45b3385672b4e9e9502eca3484c47a1d6e41aace9f0010b265cdb23180e" :answer/id #uuid "dd80450e-bdaa-5887-9466-525f3710bccc" :answer/type :answer.type/math :answer/value "5\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121917/selection/33abccbb767addf718fd954c8c85066179e2aa0bd7a9add3c72f943b27feb156" :answer/id #uuid "c0c87bb3-4a1e-5eee-8571-dbb4ddb80169" :answer/type :answer.type/math :answer/value "2\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121917/selection/9fd084a95db422a77535a3d9692e713e91aa779be1691d254d7dd8720c4cd092" :answer/id #uuid "85802045-332d-53cd-b049-6981cf1d9eb7" :answer/type :answer.type/math :answer/value "2\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-121917/selection" :answer-field/id #uuid "fcc9b4f8-afc5-5ccc-9705-b13c094ffb66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121917/selection/9fd084a95db422a77535a3d9692e713e91aa779be1691d254d7dd8720c4cd092" :answer-field/choices ["q-121917/selection/351ea70b0cedc52eb06a8a64d86d842671fc5d57c6fa522851ff5c4ffb136a30" "q-121917/selection/51ed704b4828923d78ff39f191ec525b3a152e608cf89cadc1928935848ee5f0" "q-121917/selection/cf57a45b3385672b4e9e9502eca3484c47a1d6e41aace9f0010b265cdb23180e" "q-121917/selection/33abccbb767addf718fd954c8c85066179e2aa0bd7a9add3c72f943b27feb156" "q-121917/selection/9fd084a95db422a77535a3d9692e713e91aa779be1691d254d7dd8720c4cd092"] :db/ensure [:answer-field/validate]} {:db/id "q-121917" :question/id #uuid "accdf36e-4deb-5652-9073-b1834a2b81f8" :question/math-academy-id "q-121917" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds is given by\n\n$$\nv=⟨-2\\sqrt{2}\\operatorname{cos}⁡2t,\\sqrt{2}\\operatorname{sin}⁡2t⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=\\frac{\\pi }{8}.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-2\\sqrt{2}\\operatorname{cos}⁡2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{sin}⁡2t)⟩ \\\\  & =⟨4\\sqrt{2}\\operatorname{sin}⁡2t,2\\sqrt{2}\\operatorname{cos}⁡2t⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=\\frac{\\pi }{8},$ we substitute $t=\\frac{\\pi }{8}$ into the above:\n\n$$\n\\begin{aligned}a(\\frac{\\pi }{8}) & =⟨4\\sqrt{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}),2\\sqrt{2}\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8})⟩ \\\\  & =⟨4\\sqrt{2}\\operatorname{sin}⁡(\\frac{\\pi }{4}),2\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨4\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2},2\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2}⟩ \\\\  & =⟨4,2⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(\\frac{\\pi }{8})|:$ \n\n$$\n\\begin{aligned}|a(\\frac{\\pi }{8})| & =|⟨4,2⟩| \\\\  & =\\sqrt{{4}^{2}+{2}^{2}} \\\\  & =\\sqrt{16+4} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121917/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-121917"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351176/field-1/e59e169232e16e8d4fc95e4d14f7ebab8f0ea66430d2fabd4381548437f83344" :answer/id #uuid "078f4a55-e197-5669-a3b5-12e60c824551" :answer/type :answer.type/math :answer/value "4\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-351176/field-1" :answer-field/id #uuid "60418005-c94f-5ad6-90c0-f55fc85a1e6a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351176/field-1/e59e169232e16e8d4fc95e4d14f7ebab8f0ea66430d2fabd4381548437f83344" :answer-field/choices ["q-351176/field-1/e59e169232e16e8d4fc95e4d14f7ebab8f0ea66430d2fabd4381548437f83344"] :db/ensure [:answer-field/validate]} {:db/id "q-351176" :question/id #uuid "ea008953-1c5b-5269-bd0d-c70f8fe25f40" :question/math-academy-id "q-351176" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds is given by\n\n$$\nv=⟨3{t}^{2}+2t-1,-4t+5⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=1\\,\\text{s}.$ Do not round the answer.\n\nThe magnitude of the acceleration is\n{{field-1}}\n${\\text{m/s}}^{2}.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+2t-1),\\,\\frac{\\text{d}}{\\text{d}t}(-4t+5)⟩ \\\\  & =⟨6t+2,\\,-4⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨6(1)+2,-4⟩ \\\\  & =⟨8,-4⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨8,-4⟩| \\\\  & =\\sqrt{{8}^{2}+(-4)^{2}} \\\\  & =\\sqrt{64+16} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}\\end{aligned}\n$$\n\nSo, the magnitude of the acceleration at time $t=1\\,\\text{s}$ is $4\\sqrt{5}{\\text{ m/s}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351176/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-351176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351377/field-1/7bb5be5e1ba7d0026859db546a106a94a3c0ff4af054ed3e2b6c2b327b414825" :answer/id #uuid "dfa048a9-a209-5850-93f4-8d9828fdb018" :answer/type :answer.type/math :answer/value "6t-8" :db/ensure [:answer/validate]} {:db/id "q-351377/field-1" :answer-field/id #uuid "47fe4d9b-596a-5bff-b6fe-56e1c63319d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351377/field-1/7bb5be5e1ba7d0026859db546a106a94a3c0ff4af054ed3e2b6c2b327b414825" :answer-field/choices ["q-351377/field-1/7bb5be5e1ba7d0026859db546a106a94a3c0ff4af054ed3e2b6c2b327b414825"] :db/ensure [:answer-field/validate]} {:db/id "q-351377/field-2/edff9abb33dd4df7a8e00679758eea12d4fe3bab5e867b7a3d6af33165e89d32" :answer/id #uuid "65a5cb06-33e0-5346-a69b-49c202c1e37b" :answer/type :answer.type/math :answer/value "24t^2-2" :db/ensure [:answer/validate]} {:db/id "q-351377/field-2" :answer-field/id #uuid "59349d6a-dadb-575c-87aa-3c1c11d84554" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351377/field-2/edff9abb33dd4df7a8e00679758eea12d4fe3bab5e867b7a3d6af33165e89d32" :answer-field/choices ["q-351377/field-2/edff9abb33dd4df7a8e00679758eea12d4fe3bab5e867b7a3d6af33165e89d32"] :db/ensure [:answer-field/validate]} {:db/id "q-351377" :question/id #uuid "5acf3591-12db-5ea5-8cfd-578b4845491c" :question/math-academy-id "q-351377" :question/problem "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨{t}^{3}-4{t}^{2},\\,2{t}^{4}-{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}-{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-8t,\\,8{t}^{3}-2t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t),\\,\\frac{\\text{d}}{\\text{d}t}(8{t}^{3}-2t)⟩ \\\\  & =⟨6t-8,\\,24{t}^{2}-2⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351377/field-1" "q-351377/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-351377"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7165/selection/e0eb528d852d3a41161c50301ac5782adfd968ccd1cdbaf2a1403daf901dbb7f" :answer/id #uuid "950d7913-809a-5393-a8b2-ce57e90df499" :answer/type :answer.type/math :answer/value "a=⟨4{t}^{3},\\,6t⟩" :db/ensure [:answer/validate]} {:db/id "q-7165/selection/4f2088ba3358f10023417dff507d3c379efef7d746be0631f0d5dbb5c0affef3" :answer/id #uuid "ca713ca3-8af0-525e-815e-c5b1574ee015" :answer/type :answer.type/math :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/ensure [:answer/validate]} {:db/id "q-7165/selection/b529d3545227086db06ae5a08ec1239c81b6615fed5619a03a588644d6978c51" :answer/id #uuid "d5e25b8b-15f7-5e26-b4cd-3ddc77e1872c" :answer/type :answer.type/math :answer/value "a=⟨{t}^{3},\\,3⟩" :db/ensure [:answer/validate]} {:db/id "q-7165/selection/a526810007ea4cfb2075291f694842d226f8f97b2f633790f5a687c242487fde" :answer/id #uuid "37d1f442-e608-5721-b7d3-4b7d71365872" :answer/type :answer.type/math :answer/value "a=⟨{t}^{4},\\,3t⟩" :db/ensure [:answer/validate]} {:db/id "q-7165/selection/6aba34d4ea4db0c4fea2af8687723607eb80cf09c62b82914f5bf0406bf61037" :answer/id #uuid "65a25159-bec0-5276-aabe-a21c37924630" :answer/type :answer.type/math :answer/value "a=⟨6{t}^{3},\\,4⟩" :db/ensure [:answer/validate]} {:db/id "q-7165/selection" :answer-field/id #uuid "fc06716e-7417-536a-839a-13d02e99eea3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7165/selection/4f2088ba3358f10023417dff507d3c379efef7d746be0631f0d5dbb5c0affef3" :answer-field/choices ["q-7165/selection/e0eb528d852d3a41161c50301ac5782adfd968ccd1cdbaf2a1403daf901dbb7f" "q-7165/selection/4f2088ba3358f10023417dff507d3c379efef7d746be0631f0d5dbb5c0affef3" "q-7165/selection/b529d3545227086db06ae5a08ec1239c81b6615fed5619a03a588644d6978c51" "q-7165/selection/a526810007ea4cfb2075291f694842d226f8f97b2f633790f5a687c242487fde" "q-7165/selection/6aba34d4ea4db0c4fea2af8687723607eb80cf09c62b82914f5bf0406bf61037"] :db/ensure [:answer-field/validate]} {:db/id "q-7165" :question/id #uuid "018374cc-40c9-5d0d-a1b9-641708c13290" :question/math-academy-id "q-7165" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{5}}{5},\\,3{t}^{2}-1⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{5}}{5}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-1)⟩ \\\\  & =⟨{t}^{4},\\,6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}),\\,\\frac{\\text{d}}{\\text{d}t}(6t)⟩ \\\\  & =⟨4{t}^{3},\\,6⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-7165/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-7165"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351383/field-1/bad795e0ad38ba4a7a0033565fb1176d6b107e418bbda1d7b44b643f7098100f" :answer/id #uuid "ad7a68c8-d594-5864-b062-97c1d38643fe" :answer/type :answer.type/math :answer/value "-9\\sin(3t)" :db/ensure [:answer/validate]} {:db/id "q-351383/field-1" :answer-field/id #uuid "e3452a71-bcdd-5c0e-bd81-a08b09523f3b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351383/field-1/bad795e0ad38ba4a7a0033565fb1176d6b107e418bbda1d7b44b643f7098100f" :answer-field/choices ["q-351383/field-1/bad795e0ad38ba4a7a0033565fb1176d6b107e418bbda1d7b44b643f7098100f"] :db/ensure [:answer-field/validate]} {:db/id "q-351383/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85" :answer/id #uuid "e438b533-5029-56bc-b0d9-ed208b74b065" :answer/type :answer.type/math :answer/value "-\\frac{1}{t^2}" :db/ensure [:answer/validate]} {:db/id "q-351383/field-2" :answer-field/id #uuid "b99382ca-354f-578d-ac0f-d048b62edef6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351383/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85" :answer-field/choices ["q-351383/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85"] :db/ensure [:answer-field/validate]} {:db/id "q-351383" :question/id #uuid "4ac73e4e-5042-5045-b159-6593d8be5960" :question/math-academy-id "q-351383" :question/problem "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨\\operatorname{sin}⁡(3t),\\,\\operatorname{ln}⁡t⟩,\\,t>0.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡(3t),\\,\\frac{1}{t}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡(3t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})⟩ \\\\  & =⟨-9\\operatorname{sin}⁡(3t),\\,-\\frac{1}{{t}^{2}}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351383/field-1" "q-351383/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-351383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121926/selection/8e5b7ed714b343aa12e8210c88c8bb18e02e7b6cb04069d56f2449e4cf146879" :answer/id #uuid "1401b533-5bcd-5a5a-96c3-9d1a63744b77" :answer/type :answer.type/math :answer/value "a=⟨2t,4{e}^{2t+5}⟩" :db/ensure [:answer/validate]} {:db/id "q-121926/selection/51263422dc1976a3ff85eec6c33600aa39ab477e677956b1151b4438600286de" :answer/id #uuid "a1bac3c8-2ed6-51cc-9baf-eb221e9d2c4a" :answer/type :answer.type/math :answer/value "a=⟨2t,2{e}^{2t+5}⟩" :db/ensure [:answer/validate]} {:db/id "q-121926/selection/d0a20b28b7e4ec0429234e3e1c2045949322ebdadf257aed1bc669c1ce62236d" :answer/id #uuid "db768bc7-f897-57d0-bb78-a3e5f24c0320" :answer/type :answer.type/math :answer/value "a=⟨2,{e}^{2t+5}⟩" :db/ensure [:answer/validate]} {:db/id "q-121926/selection/d6f55c000827599fb3cbf702e0644805fd34bd4297af9a7523fc29f283d356b6" :answer/id #uuid "f004a71b-65e2-5c3e-b9ce-5a6e7c51c924" :answer/type :answer.type/math :answer/value "a=⟨2,2{e}^{2t+5}⟩" :db/ensure [:answer/validate]} {:db/id "q-121926/selection/959fdf6e1d95548e67efd70c6f56ded3fa80af50e47146c157ff3d40461e3f5f" :answer/id #uuid "64163d55-81f8-5097-9ef7-f745ab03474c" :answer/type :answer.type/math :answer/value "a=⟨2,4{e}^{2t+5}⟩" :db/ensure [:answer/validate]} {:db/id "q-121926/selection" :answer-field/id #uuid "ad6b7c4b-9158-56fa-823b-ec85b2af869d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121926/selection/959fdf6e1d95548e67efd70c6f56ded3fa80af50e47146c157ff3d40461e3f5f" :answer-field/choices ["q-121926/selection/8e5b7ed714b343aa12e8210c88c8bb18e02e7b6cb04069d56f2449e4cf146879" "q-121926/selection/51263422dc1976a3ff85eec6c33600aa39ab477e677956b1151b4438600286de" "q-121926/selection/d0a20b28b7e4ec0429234e3e1c2045949322ebdadf257aed1bc669c1ce62236d" "q-121926/selection/d6f55c000827599fb3cbf702e0644805fd34bd4297af9a7523fc29f283d356b6" "q-121926/selection/959fdf6e1d95548e67efd70c6f56ded3fa80af50e47146c157ff3d40461e3f5f"] :db/ensure [:answer-field/validate]} {:db/id "q-121926" :question/id #uuid "19cf5879-4ba8-59d0-8ef2-68769cbabfb2" :question/math-academy-id "q-121926" :question/problem "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨{t}^{2}-1,{e}^{2t+5}⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1),\\frac{\\text{d}}{\\text{d}t}({e}^{2t+5})⟩ \\\\  & =⟨2t,2{e}^{2t+5}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(2{e}^{2t+5})⟩ \\\\  & =⟨2,4{e}^{2t+5}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121926/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-121926"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351381/field-1/615c369c448cee95ef423137976efdc7e60f57b2431552fcda0db3ce340e38ad" :answer/id #uuid "a52c3c69-d0e1-5d52-bc83-c49503cbba24" :answer/type :answer.type/math :answer/value "24t" :db/ensure [:answer/validate]} {:db/id "q-351381/field-1" :answer-field/id #uuid "8a477dc7-191c-5381-a8f8-1397a3567d93" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351381/field-1/615c369c448cee95ef423137976efdc7e60f57b2431552fcda0db3ce340e38ad" :answer-field/choices ["q-351381/field-1/615c369c448cee95ef423137976efdc7e60f57b2431552fcda0db3ce340e38ad"] :db/ensure [:answer-field/validate]} {:db/id "q-351381/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85" :answer/id #uuid "4b78ba92-0a9f-5bd9-8c0b-dd877b3cf2f4" :answer/type :answer.type/math :answer/value "-\\frac{1}{t^2}" :db/ensure [:answer/validate]} {:db/id "q-351381/field-2" :answer-field/id #uuid "34faaa65-3a84-53e8-a08d-9c15c1d189b3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351381/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85" :answer-field/choices ["q-351381/field-2/dee3148ac6929fdbc01c3c01eb9f5286cbea77feeb4849a4b74e15034d7c5d85"] :db/ensure [:answer-field/validate]} {:db/id "q-351381" :question/id #uuid "9d549734-6afe-524a-b538-81a8cf4b5cf7" :question/math-academy-id "q-351381" :question/problem "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨4{t}^{3}-2t,\\,\\operatorname{ln}⁡(2t)⟩,\\,t>0.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(2t))⟩ \\\\  & =⟨12{t}^{2}-2,\\,\\frac{1}{t}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(12{t}^{2}-2),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})⟩ \\\\  & =⟨24t,\\,-\\frac{1}{{t}^{2}}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351381/field-1" "q-351381/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-351381"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351394/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "69f06bdd-c795-568b-a438-664b573791d9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-351394/field-1" :answer-field/id #uuid "586291d9-309c-5df4-add5-540a8b469fe3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351394/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-351394/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-351394/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f1020152-0d8b-5867-8c46-c09229b722da" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-351394/field-2" :answer-field/id #uuid "a7497266-c447-5923-928b-7e613541a33a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351394/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-351394/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-351394" :question/id #uuid "7662aac6-215f-52ac-a012-6e6b5c337a0c" :question/math-academy-id "q-351394" :question/problem "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨{t}^{3}-4{t}^{2}+2,\\,5+{t}^{3}-3{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=1.$ Do not round the answers.\n\n$a(1)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4{t}^{2}+2),\\,\\frac{\\text{d}}{\\text{d}t}(5+{t}^{3}-3{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-8t,\\,3{t}^{2}-6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-6t)⟩ \\\\  & =⟨6t-8,\\,6t-6⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨6(1)-8,\\,6(1)-6⟩ \\\\  & =⟨-2,\\,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351394/field-1" "q-351394/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-351394"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351410/field-1/45afa4ab8b584699aa7f101f770fb36cd516ebe64e699afe8e28cfb261a20578" :answer/id #uuid "3e40f78e-d5d7-5f43-b127-269bbd39ebb8" :answer/type :answer.type/math :answer/value "10\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-351410/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "7579ec8e-c23b-5e8e-954f-727f33689202" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-351410/field-1" :answer-field/id #uuid "db488ef3-c7b6-5436-b8ee-6d4b05be4b17" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351410/field-1/45afa4ab8b584699aa7f101f770fb36cd516ebe64e699afe8e28cfb261a20578" :answer-field/choices ["q-351410/field-1/45afa4ab8b584699aa7f101f770fb36cd516ebe64e699afe8e28cfb261a20578" "q-351410/field-1/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c"] :db/ensure [:answer-field/validate]} {:db/id "q-351410" :question/id #uuid "ea9ca4c4-0c65-56db-9cd7-d20e345623e9" :question/math-academy-id "q-351410" :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨3{t}^{3}-4{t}^{2}+2,\\,2{t}^{3}-{t}^{2}+5⟩.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=1\\,\\text{s}.$ Do not round the answer.\n\nThe magnitude of the acceleration is\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}-4{t}^{2}+2),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-{t}^{2}+5)⟩ \\\\  & =⟨9{t}^{2}-8t,\\,6{t}^{2}-2t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}-8t),\\,\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-2t)⟩ \\\\  & =⟨18t-8,\\,12t-2⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨18(1)-8,\\,12(1)-2⟩ \\\\  & =⟨18-8,\\,12-2⟩ \\\\  & =⟨10,\\,10⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$\n\n$$\n\\begin{aligned}|a(1)| & =|⟨10,\\,10⟩| \\\\  & =\\sqrt{{10}^{2}+{10}^{2}} \\\\  & =\\sqrt{100+100} \\\\  & =\\sqrt{200} \\\\  & =10\\sqrt{2}\\end{aligned}\n$$\n\nSo, the magnitude of the acceleration at time $t=1\\,\\text{s}$ is $10\\sqrt{2}{\\text{ m/s}}^{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351410/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-351410"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351396/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "a8ca7285-ea2a-59c3-9786-6b4565295118" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-351396/field-1" :answer-field/id #uuid "adce1de0-09f4-5166-a017-40de219a3693" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351396/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-351396/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-351396/field-2/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "b5070a62-3897-50da-a2a3-c9829cf8ca0e" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-351396/field-2" :answer-field/id #uuid "63ad7b18-a753-5a43-a654-8e6b12ec1f74" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351396/field-2/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-351396/field-2/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-351396" :question/id #uuid "bcb884f9-d3e9-5264-9041-49a495f1bdc8" :question/math-academy-id "q-351396" :question/problem "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨{t}^{3}-2{t}^{2}+5,\\,6+{t}^{3}-4{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=3.$ Do not round the answers.\n\n$a(3)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-2{t}^{2}+5),\\,\\frac{\\text{d}}{\\text{d}t}(6+{t}^{3}-4{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-4t,\\,3{t}^{2}-8t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-4t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t)⟩ \\\\  & =⟨6t-4,\\,6t-8⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=3,$ we substitute $t=3$ into the above:\n\n$$\n\\begin{aligned}a(3) & =⟨6(3)-4,\\,6(3)-8⟩ \\\\  & =⟨14,\\,10⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351396/field-1" "q-351396/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-351396"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121932/selection/8a921a6f272fbeaa92006de59cc5e4bed8a29b6d375986b93a340a1e47c494e1" :answer/id #uuid "02df329d-823b-533a-b41e-c19c5d2fcc99" :answer/type :answer.type/math :answer/value "a(1)=⟨-2,-18⟩" :db/ensure [:answer/validate]} {:db/id "q-121932/selection/f1ea182714c4e98d59b585aff5bb8541c01ee9ebf70de13713b2206ae613e8af" :answer/id #uuid "4e4f763b-f133-552b-b218-eec48441674f" :answer/type :answer.type/math :answer/value "a(1)=⟨-4,-18⟩" :db/ensure [:answer/validate]} {:db/id "q-121932/selection/9ad44556ec7b8b3b7e35372f4dc882e66e5c4efd71b99654f9d228bcb807c6d8" :answer/id #uuid "fe1e84bd-ed0e-5b62-8c16-c0c3d283b5a8" :answer/type :answer.type/math :answer/value "a(1)=⟨-8,-12⟩" :db/ensure [:answer/validate]} {:db/id "q-121932/selection/71ba840b240c30cc3652cd106760bcc5ef934b753b6c5cad6225ba0df4853830" :answer/id #uuid "d5caa383-8750-5259-9428-99926ffe1d5d" :answer/type :answer.type/math :answer/value "a(1)=⟨-2,-12⟩" :db/ensure [:answer/validate]} {:db/id "q-121932/selection/01385017e18319ab83348d71a01f55f4e228c477ad2b236a192f8989903729cc" :answer/id #uuid "5494cec3-fb51-5313-8219-063101216e2c" :answer/type :answer.type/math :answer/value "a(1)=⟨-4,-9⟩" :db/ensure [:answer/validate]} {:db/id "q-121932/selection" :answer-field/id #uuid "00d0f0d8-9c43-5c90-9ba3-276829ddff35" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121932/selection/f1ea182714c4e98d59b585aff5bb8541c01ee9ebf70de13713b2206ae613e8af" :answer-field/choices ["q-121932/selection/8a921a6f272fbeaa92006de59cc5e4bed8a29b6d375986b93a340a1e47c494e1" "q-121932/selection/f1ea182714c4e98d59b585aff5bb8541c01ee9ebf70de13713b2206ae613e8af" "q-121932/selection/9ad44556ec7b8b3b7e35372f4dc882e66e5c4efd71b99654f9d228bcb807c6d8" "q-121932/selection/71ba840b240c30cc3652cd106760bcc5ef934b753b6c5cad6225ba0df4853830" "q-121932/selection/01385017e18319ab83348d71a01f55f4e228c477ad2b236a192f8989903729cc"] :db/ensure [:answer-field/validate]} {:db/id "q-121932" :question/id #uuid "052d683a-4534-50ca-9e0f-c6b7dbb2dbeb" :question/math-academy-id "q-121932" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨4-2{t}^{2},1-3{t}^{3}⟩.\n$$\n\nCalculate the acceleration vector $a$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4-2{t}^{2}),\\frac{\\text{d}}{\\text{d}t}(1-3{t}^{3})⟩ \\\\  & =⟨-4t,-9{t}^{2}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-4t),\\frac{\\text{d}}{\\text{d}t}(-9{t}^{2})⟩ \\\\  & =⟨-4,-18t⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨-4,-18(1)⟩ \\\\  & =⟨-4,-18⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121932/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-121932"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351395/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "e94f355a-0a7c-5a32-b66e-0b295251419a" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-351395/field-1" :answer-field/id #uuid "6fa3163d-a841-5a4a-b10a-bf46399e3f96" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351395/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-351395/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666"] :db/ensure [:answer-field/validate]} {:db/id "q-351395/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f681dbdc-c9c5-5a62-abc3-08009cbe1bf9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-351395/field-2" :answer-field/id #uuid "5d486c79-64a2-5c4f-a5ea-7807d898cb17" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351395/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-351395/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-351395" :question/id #uuid "b9bce891-9ef1-53ff-8dfb-3b034b818faa" :question/math-academy-id "q-351395" :question/problem "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨2{t}^{3}-3{t}^{2}+1,\\,4+{t}^{3}-5{t}^{2}⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t=2.$ Do not round the answers.\n\n$a(2)=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3{t}^{2}+1),\\,\\frac{\\text{d}}{\\text{d}t}(4+{t}^{3}-5{t}^{2})⟩ \\\\  & =⟨6{t}^{2}-6t,\\,3{t}^{2}-10t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-6t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-10t)⟩ \\\\  & =⟨12t-6,\\,6t-10⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨12(2)-6,\\,6(2)-10⟩ \\\\  & =⟨18,\\,2⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351395/field-1" "q-351395/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-351395"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-620"] :question/problem "The velocity vector $\\mathbf{v} = \\langle u, v \\rangle$ of a particle $P$ at time $t$ is given by\n\n$$\n\\mathbf{v} = \\langle 12t+t^2, t^3+1\\rangle.\n$$\n\nCalculate the acceleration vector $\\mathbf{a}$." :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(12t+{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}+1)⟩ \\\\  & =⟨12+2t,\\,3{t}^{2}⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7224"] :question/problem "The velocity vector $\\mathbf{v} = \\langle u, v \\rangle,$ measured in $\\textrm{m}/\\textrm s,$ of a particle $P$ at time $t$ seconds, is given by\n\n$$\n\\mathbf{v} = \\langle t^4-t^2, 2t^3\\rangle.\n$$\n\nFind the acceleration vector and the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨4{t}^{3}-2t,\\,6{t}^{2}⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨4(1)^{3}-2(1),6(1)^{2}⟩ \\\\  & =⟨2,6⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|\\mathbf a(1)|\\mathbin{:}$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨2,6⟩| \\\\  & =\\sqrt{{2}^{2}+{6}^{2}} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-621"] :question/problem "The position vector $\\mathbf{r}$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\n\\mathbf{r} = \\langle 4t^2+1, 3t^2-t\\rangle.\n$$\n\nCalculate the acceleration vector $\\mathbf{a}$." :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector. We can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}+1),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-t)⟩ \\\\  & =⟨8t,\\,6t-1⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(8t),\\,\\frac{\\text{d}}{\\text{d}t}(6t-1)⟩ \\\\  & =⟨8,6⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7225"] :question/problem "The position vector $\\mathbf{r},$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\n\\mathbf{r} = \\left\\langle t^{5}-t^2,\\, t^2+6t-3 \\right\\rangle.\n$$\n\nCalculate the acceleration vector and the magnitude of the acceleration of $P$ at time $t=0.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{5}-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}+6t-3)⟩ \\\\  & =⟨5{t}^{4}-2t,\\,2t+6⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5{t}^{4}-2t),\\,\\frac{\\text{d}}{\\text{d}t}(2t+6)⟩ \\\\  & =⟨20{t}^{3}-2,\\,2⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=0,$ we substitute $t=0$ into the above:\n\n$$\n\\begin{aligned}a(0) & =⟨20(0)^{3}-2,\\,2⟩ \\\\  & =⟨-2,\\,2⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|\\mathbf a(0)|\\mathbin{:}$\n\n$$\n\\begin{aligned}|a(0)| & =|⟨-2,\\,2⟩| \\\\  & =\\sqrt{(-2)^{2}+{2}^{2}} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
