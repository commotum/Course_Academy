HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-27832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d"] :knowledge-point/questions ["q-27832"] :db/ensure [:knowledge-point/validate]} {:db/id "q-118756/selection/7c8c868221bc55d44b9c81dba0b5be3a0bd420d52ec108cc53d3e7905ee34154" :answer/id #uuid "f2f4cbee-454b-547d-a740-9b5025a0399e" :answer/type :answer.type/math :answer/value "{22}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-118756/selection/c1288f3d933e9d5af4fdcd98cba60a071a3eac5fd183ed5dbfd18624f83a4ee6" :answer/id #uuid "083a735d-d18e-53fe-bec4-ab43cca7e134" :answer/type :answer.type/math :answer/value "{36}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-118756/selection/9342b0c907fb602c00c73ecf16b05da1e439ae387b93d6fd5bcfe7d47fe1bc14" :answer/id #uuid "4cd25b68-6ded-5fa6-b460-f4817c834768" :answer/type :answer.type/math :answer/value "{28}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-118756/selection/0a0ce648b9ee6d890d8f677ada4f79d453e017d6af29033297518b303d556717" :answer/id #uuid "fdb0f5f8-813f-5246-bddd-c51a1ad3f0c0" :answer/type :answer.type/math :answer/value "{32}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-118756/selection/63a57e449df15fa97e620902347dae141a4b773c20487b8ddcdb453244933c6a" :answer/id #uuid "4f919196-14fb-5533-8213-488c96fbbc0b" :answer/type :answer.type/math :answer/value "{38}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-118756/selection" :answer-field/id #uuid "0e5cf240-2786-53e9-bc2e-1b1b9bcf06c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-118756/selection/0a0ce648b9ee6d890d8f677ada4f79d453e017d6af29033297518b303d556717" :answer-field/choices ["q-118756/selection/7c8c868221bc55d44b9c81dba0b5be3a0bd420d52ec108cc53d3e7905ee34154" "q-118756/s