fb7-775d-5944-8bda-477e395a8a58" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186268473} :answer-field/id #uuid "c9c3fc60-5205-5123-b6b5-26335e1990c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268468}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8d72740e-6072-5046-bfdb-c5667ec877d5" :question/math-academy-id "q-117012" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\n- $(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2})$\n- $(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{3})$\n- $(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2}).$ We note the following:\n\n- The point $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{3},-\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi }{3})$ does lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{5\\pi }{4},-\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{5\\pi }{4}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$"}] [{:db/id #edb/ref 17592186111094 :knowledge-point/_questions [{:knowledge-point/id #uuid "69d6ed5b-1c29-53a7-a37e-817042a02861" :knowledge-point/title "Graphing the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85251810-38ab-5c23-8000-832183eefbba" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1483/Source/Images/q-42117-a-4.png" :db/id #edb/ref 17592186108660} {:answer/id #uuid "abdfb5b0-c85f-5799-b427-6af8ee1ed617" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1483/Source/Images/q-42117-a-5.png" :db/id #edb/ref 17592186108661} {:answer/id #uuid "ccd132f0-d5bb-5367-b1a4-75bd6fb41b8c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1483/Source/Images/q-42117-a-2.png" :db/id #edb/ref 17592186108662} {:answer/id #uuid "2994ee93-1150-5d4d-8ef2-03630d797e86" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1483/Source/Images/q-42117-a-1.png" :db/id #edb/ref 17592186108663} {:answer/id #uuid "5a6f6699-986f-504c-a2d1-370a53a9504d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1483/Source/Images/q-42117-a-3.png" :db/id #edb/ref 17592186108664}] :answer-field/correct {:answer/id #uuid "2994ee93-1150-5d4d-8ef2-03630d797e86" :answer/t