arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{5\\pi }{4}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},\\frac{5\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117012/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363"] :knowledge-point/questions ["q-117012"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65821/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "fed88f98-cb19-5e13-9adc-ef337c274293" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-65821/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "48f72946-ae8f-52c5-9ae3-9f6f8822e2ac" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-65821/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "de98d5a0-a32f-5926-ae00-726b19affc45" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-65821/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "bd396485-e5c9-5fee-9074-3793ec0d79e2" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-65821/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "c72fd68b-fd68-56e7-8af9-bb5c0c0a29b1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-65821/selection" :answer-field/id #uuid "7af8c36f-78c8-5256-88f8-d88ef74d5e96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65821/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-65821/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-65821/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-65821/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-65821/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-65821/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-65821" :question/id #uuid "23074372-05ee-554d-b915-2199d9c252b0" :question/math-academy-id "q-65821" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\n- $(0,-2\\pi )$\n- $(\\frac{1}{2},\\frac{\\pi }{6})$\n- $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(0,-2\\pi ).$ We note the following:\n\n- The point $(-2\\pi ,0)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-2\\pi $ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(0,-2\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(\\frac{1}{2},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{1}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{1}{2},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{2}}{2},-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arcsin}⁡x.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-65821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363"] :knowledge-point/questions ["q-65821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70714/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "16edb07f-f0eb-594d-a358-a7dd750a3b24" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-70714/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "8ae4f08e-3df6-512b-8bf9-d1e86b010994" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-70714/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ba84f6d4-009d-523d-93d9-f03bffd1bd06" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-70714/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "9f9cda64-ead8-5ef2-bd29-60c064c03432" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-70714/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uu