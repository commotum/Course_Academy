/ensure [:knowledge-point/validate]} {:db/id "q-3103/selection/b78cefa051ec62e42babb0396ce415bc1c6b03c29d281d68224ab0312a503d34" :answer/id #uuid "4b7e9c82-f82b-5755-b808-f11b932c66fa" :answer/type :answer.type/math :answer/value "-\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-3103/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "345e0c93-4a93-5669-9aeb-5d935dd5a5fc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-3103/selection/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" :answer/id #uuid "ed05d4e7-4e06-5781-9122-193e43145847" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-3103/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "fc0c7864-2bb2-5aed-803f-8291a1514c55" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-3103/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer/id #uuid "d2e37f8b-9aaf-56f4-b783-2ab6790472e5" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-3103/selection" :answer-field/id #uuid "a7a07baf-edbe-5ecf-9daf-3c33f909bef6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3103/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-3103/selection/b78cefa051ec62e42babb0396ce415bc1c6b03c29d281d68224ab0312a503d34" "q-3103/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-3103/selection/3224ab5f6f5fb64621a714f7654c4df06661a69e7edb8f5993dcef1e46ce3dea" "q-3103/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-3103/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080"] :db/ensure [:answer-field/validate]} {:db/id "q-3103" :question/id #uuid "5f386422-89a2-540e-a337-182ac04c54eb" :question/math-academy-id "q-3103" :question/is-example false :question/problem "If ${5}^{2a-5}=\\frac{1}{{25}^{a+1}}$ then $a=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base.\n\nTo do this, we write $25$ as ${5}^{2},$ and then we rewrite the right-hand side using the power rule of exponents:\n\n$$\n\\begin{aligned}{5}^{2a-5} & =\\frac{1}{{25}^{a+1}} \\\\ {5}^{2a-5} & =\\frac{1}{{({5}^{2})}^{a+1}} \\\\ {5}^{2a-5} & =\\frac{1}{{5}^{2(a+1)}}\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using a negative exponent: \n\n$$\n\\begin{aligned}{5}^{2a-5} & ={5}^{-2(a+1)}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(5)$, we equate the exponents and solve for $a:$\n\n$$\n\\begin{aligned}2a-5 & =-2(a+1) \\\\ 2a-5 & =-2a-2 \\\\ 4a & =3 \\\\ a & =\\frac{3}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-3103/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c6b30e7-fba6-597c-8306-27d707bfc244"] :knowledge-point/questions ["q-3103"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66892/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6dd896a6-352b-5fb2-88ad-7b87affc3b03" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-66892/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "edee569c-45b4-5154-961f-ebb54c2bf03d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-66892/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "2c219d57-e6a2-5ef0-87dd-02823dc2b261" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-66892/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer