sure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4"] :knowledge-point/questions ["q-100468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110544/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "5688c327-8b63-5aa3-8119-8ae6928df5d5" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-110544/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "43d22559-7222-5d9b-9b0c-4af03009b012" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-110544/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "d901fbe5-6bf5-5f32-981b-4e87e9f832f2" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-110544/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "f0a3c79b-a8a3-5eeb-bea5-08027152a777" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-110544/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "57fbc75f-e073-51bf-942c-e908d9fe18fd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-110544/selection" :answer-field/id #uuid "14891877-b2bc-5c1c-8027-8fbab0fad8cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110544/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-110544/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-110544/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-110544/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-110544/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-110544/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-110544" :question/id #uuid "d966e064-63cd-5aba-bf68-b9da2a37e649" :question/math-academy-id "q-110544" :question/is-example false :question/problem "Solve for $y$ where ${81}^{y}={27}^{y+5}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{y}={({3}^{3})}^{y+5}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{4y}={3}^{3(y+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3),$ we equate the exponents and solve for $y:$\n\n$$\n\\begin{aligned}4y & =3(y+5) \\\\ 4y & =3y+15 \\\\ y & =15\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110544/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4"] :knowledge-point/questions ["q-110544"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66889/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "4a46730b-2ff9-54e1-af28-047c4b462c39" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-66889/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b8dd9f5f-900b-588a-822e-88205d9bc7d2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-66889/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "d4169572-86df-5874-9fe7-bbe8bff96b8b" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-66889/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "93a5ab9f-a2ca-5eee-a179-774b358af35f" :answer/type :answer.ty