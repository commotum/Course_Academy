973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a"] :db/ensure [:answer-field/validate]} {:db/id "q-66895" :question/id #uuid "33d91fd5-3e9c-5d1e-9738-6a20264768c8" :question/math-academy-id "q-66895" :question/is-example false :question/problem "If ${81}^{3m}={27}^{m+5}$ then $m=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{3m}={({3}^{3})}^{m+5}\\,\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{12m} & ={3}^{3(m+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $m:$\n\n$$\n\\begin{aligned}12m & =3(m+5) \\\\ 12m & =3m+15 \\\\ 9m & =15 \\\\ m & =\\frac{5}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66895/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4"] :knowledge-point/questions ["q-66895"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100468/selection/aa4e4239377eb61b8bdf37e9f4374abeb3a1fdeaaf409dc6e37519ad01509799" :answer/id #uuid "7f9955be-10c4-5296-8f86-34f2eaccebae" :answer/type :answer.type/math :answer/value "-27" :db/ensure [:answer/validate]} {:db/id "q-100468/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "8e266992-9d47-5927-8455-7c9c0df8558c" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-100468/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer/id #uuid "5d95b726-ef43-51ef-b008-3b7719c80167" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-100468/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "cf481cb9-f177-5f7f-904e-ea442d43fe25" :an