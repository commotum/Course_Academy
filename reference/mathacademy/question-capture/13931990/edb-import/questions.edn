igned}\n$$\n\nNow, since both sides of the equation share the same base $(4)$, we equate the exponents and solve for $b:$\n\n$$\n\\begin{aligned}2b & =3(b+4) \\\\ 2b & =3b+12 \\\\ b & =-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244116 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edee569c-45b4-5154-961f-ebb54c2bf03d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244118} {:answer/id #uuid "85ff9517-b892-5f97-87ce-50099e771db6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244119} {:answer/id #uuid "6dd896a6-352b-5fb2-88ad-7b87affc3b03" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186244120} {:answer/id #uuid "6749fb93-de75-5ade-a38b-19abd7bf29f8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244121} {:answer/id #uuid "2c219d57-e6a2-5ef0-87dd-02823dc2b261" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244122}] :answer-field/correct {:answer/id #uuid "85ff9517-b892-5f97-87ce-50099e771db6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244119} :answer-field/id #uuid "3334e7d7-7036-5d22-9935-ab94b427e4ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244117}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8c1fcc1-4991-57f6-af3b-af0941b664dc" :question/math-academy-id "q-66892" :question/problem "Solve for $q$ where ${25}^{q+1}={125}^{q}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $25={5}^{2}$ and $125={5}^{3},$ as follows:\n\n$$\n{({5}^{2})}^{q+1}={({5}^{3})}^{q}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{5}^{2(q+1)}={5}^{3q}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents and solve for $q:$\n\n$$\n\\begin{aligned}2(q+1) & =3q \\\\ 2q+2 & =3q \\\\ q & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244123 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8587897-49c2-5c74-b197-9243f8f84614" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186244125} {:answer/id #uuid "1f15e671-a89a-5862-ace9-a4f1d3381632" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244126} {:answer/id #uuid "d91315ab-ddf3-5f97-b25a-bd7eab790cac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186244127} {:answer/id #uuid "ae099bc9-ae9e-50e7-b0df-88bc587a9594" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186244128} {:answer/id #uuid "4145f2ff-d72b-5bfb-a6c3-3b7025ac905a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186244129}] :answer-field/correct {:answer/id #uuid "d91315ab-ddf3-5f97-b25a-bd7eab790cac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186244127} :answer-field/id #uuid "236f7d2f-138b-5b8f-b2c3-1ca8bc5f22d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244124}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "33d91fd5-3e9c-5d1e-9738-6a20264768c8" :question/math-academy-id "q-66895" :question/problem "If ${81}^{3m}={27}^{m+5}$ then $m=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{3m}={({3}^{3})}^{m+5}\\,\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{12m} & ={3}^{3(m+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $m:$\n\n$$\n\\begin{aligned}12m & =3(m+5) \\\\ 12m & =3m+15 \\\\ 9m & =15 \\\\ m & =\\frac{5}{3}\\end{aligned}\n$$"}]}
