s follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13963369/assets/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186268872 :knowledge-point/_questions [{:knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c681e20-ca31-591d-9137-94de57e8157c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186268874} {:answer/id #uuid "4699ee7b-9662-5964-a5f4-c6334c9889ae" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268875} {:answer/id #uuid "b5db8eb2-6e7b-570c-b15c-06e29425c217" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268876} {:answer/id #uuid "4387f0d7-f29b-566e-a33e-aeb51831b274" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186268877} {:answer/id #uuid "9da66f98-0355-5dda-b138-75a4fbe2aca0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186268878}] :answer-field/correct {:answer/id #uuid "9da66f98-0355-5dda-b138-75a4fbe2aca0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186268878} :answer-field/id #uuid "b7231b54-3328-5033-bf2f-b3825931829a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268873}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6b8e8196-034c-5c0d-b75d-8445d18467fd" :question/math-academy-id "q-70777" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n\n- $\\frac{\\pi }{3}$\n- $2\\pi $\n- $-\\frac{\\pi }{6}$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13963369/assets/6860bcf04c508b0abe795b9e1699163ac9495818f6427b338ac6bbe17774b2d8.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186268879 :knowledge-point/_questions [{:knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45633401-c606-5d50-a010-796f0c564b46" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186268881} {:answer/id #uuid "5ba2bf9c-9cd9-5770-8151-6068f959446a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268882} {:answer/id #uuid "edf20070-12fe-5d16-b1d7-9541f49c0344" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268883} {:answer/id #uuid "78b98763-bba7-54ce-9695-3b7b02bb135a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186268884} {:answer/id #uuid "c488448b-90b5-5077-a91c-cba6e22d7cbe" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186268885}] :answer-field/correct {:answer/id #uuid "78b98763-bba7-54ce-9695-3b7b02bb135a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186268884} :answer-field/id #uuid "baf2370b-8bac-59ef-9ef1-49dde4e620db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268880}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a7c0619-478c-5331-8f1b-459e32c595e1" :question/math-academy-id "q-70778" :question/problem "Which of the following values lies in the domain of $y=\\ope