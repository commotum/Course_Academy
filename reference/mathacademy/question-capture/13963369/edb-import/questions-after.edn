db/id #edb/ref 17592186268826} {:answer/id #uuid "197153d2-0afe-5a21-9d0b-783631d25db8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186268827} {:answer/id #uuid "422283c5-10c5-53b0-8c47-384b2c7012fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{7}" :db/id #edb/ref 17592186268828} {:answer/id #uuid "81050128-e7e0-52d1-b2cd-c131cd64e391" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186268829}] :answer-field/correct {:answer/id #uuid "de42a7fc-4e91-538f-b4d6-f21327526980" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186268826} :answer-field/id #uuid "cee9e8e9-7610-53c5-8504-2d15caae66ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268824}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b5f818c8-46b4-513c-a5e9-9d2667c4095c" :question/math-academy-id "q-117336" :question/problem "Which of the following values is **not** in the range of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13963369/assets/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The range of the function is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nTherefore, the value $y=\\frac{2\\pi }{3}$ is not in the range of the function."}] [{:db/id #edb/ref 17592186268830 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03a59404-b27c-5964-ba25-9e75a1e95007" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186268832} {:answer/id #uuid "1af021bc-ba81-5212-8e00-8e06543db63b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186268833} {:answer/id #uuid "c908c8e3-8fed-5d51-9a52-edb7a0beb40c" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186268834} {:answer/id #uuid "9dfbf96c-d27c-5c92-b142-d4169db645a0" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186268835} {:answer/id #uuid "94e86b47-c05b-5004-8d2a-68dd5a856125" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268836}] :answer-field/correct {:answer/id #uuid "94e86b47-c05b-5004-8d2a-68dd5a856125" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186268836} :answer-field/id #uuid "acdc22b1-47e7-5a65-9469-46650f645be9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268831}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d42d29a1-7ec6-555e-8ef7-3216eb563375" :question/math-academy-id "q-117369" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\n- $(-1,-\\frac{\\pi }{4})$\n- $(\\sqrt{3},\\frac{\\pi }{3})$\n- $(\\frac{\\pi }{4},1)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(\\frac{\\pi }{4},1).$ We note the following:\n\n- The point $(1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},1)$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186111097 :knowledge-point/_questions [{:knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "949f6b17-bafd-5b17-9f75-591e2b1c9fa1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186108678} {:answer/id #uuid "cb7d3948-6e74-5920-8a3e-5b8d969d0ab4" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186108679} {:answer/id #uuid "1cb03865-91b5-5baf-9cfe-6ca61f337c74" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186108680} {:answer/id #uuid "250c0dee-fc03-5995-96a1-d1a1e1c1ed6d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186108681} {:answer/id #uuid "35e55b97-60aa-5bdd-b962-5f8635408561" :answer/type {:db/ident :ans