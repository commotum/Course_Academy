2}-6x+9}\\,\\text{d}x-5\\int \\frac{1}{x-4}\\,\\text{d}x \\\\  & =5(\\frac{1}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9))-5\\operatorname{ln}⁡|x-4|+K \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9)-5\\operatorname{ln}⁡|x-4|+K\\end{aligned}\n$$" 13194139534902 true] [17592186069318 1091 #edb/ref 17592186045463 13194139534902 true] [17592186069318 1100 "> A calculator is required to answer this question.\n\nEvaluate $∫(2)/((x - 1)(x^{2} + 1))dx$." 13194139534902 false] [17592186069318 1100 "Evaluate $\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x.$" 13194139534902 true] [17592186069318 1145 "The quadratic factor ${x}^{2}+1$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{A}{x-1}+\\frac{Bx+C}{{x}^{2}+1}.\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(x-1)({x}^{2}+1),$ and we get\n\n$$\n2=A({x}^{2}+1)+(Bx+C)(x-1).\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=1,B=-1,$ and $C=-1.$ Therefore,\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1}.\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int (\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1})\\,\\text{d}x \\\\  & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we have\n\n$$\n\\int \\frac{1}{x-1}\\,\\text{d}x=\\operatorname{ln}⁡|x-1|.\n$$\n\nFor the second integral, we use the substitution $u={x}^{2}+1.$ Then $\\text{d}u=2x\\,\\text{d}x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x & =\\int (\\frac{1}{u})\\frac{\\text{d}u}{2} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{x}^{2}+1| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)\\,.\\end{aligned}\n$$\n\nFinally, for the third integral, we use the fact that $\\int \\frac{1}{{x}^{2}+{a}^{2}}\\,\\text{d}x=\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a}),$ which results in\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x=\\operatorname{arctan}⁡x.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K\\end{aligned}\n$$" 13194139534902 true] [17592186318449 1017 #edb/ref 17592186318450 13194139534902 true] [17592186318449 1089 "q-11359" 13194139534902 true] [17592186318449 1091 #edb/ref 17592186045463 13194139534902 true] [17592186318449 1100 "Evaluate $\\int \\frac{{x}^{2}+x+42}{({x}^{2}+9)(x-3)}\\,\\text{d}x.$" 13194139534902 true] [17592186318449 1113 #uuid "4be761bf-2e3f-59dc-aa50-0d26eafc28a0" 13194139534902 true] [17592186318449 1145 "The quadratic factor ${x}^{2}+9$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\frac{{x}^{2}+x+42}{({x}^{2}+9)(x-3)}=\\frac{Ax+B}{{x}^{2}+9}+\\frac{C}{x-3}\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $({x}^{2}+9)(x-3),$ and we get\n\n$$\n{x}^{2}+x+42=(Ax+B)(x-3)+C({x}^{2}+9).\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=-2,B=-5,$ and $C=3.$ Therefore,\n\n$$\n\\frac{{x}^{2}+x+42}{({x}^{2}+9)(x-3)}=-\\frac{2x+5}{{x}^{2}+9}+\\frac{3}{x-3}.\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+x+42}{({x}^{2}+9)(x-3)}\\,\\text{d}x & =\\int (-\\frac{2x+5}{{x}^{2}+9}+\\frac{3}{x-3})\\text{d}x \\\\  & =-\\int \\frac{2x}{{x}^{2}+9}\\text{d}x-5\\int \\frac{1}{{x}^{2}+9}\\text{d}x+3\\int \\frac{1}{x-3}\\,\\text{d}x\\end{aligned