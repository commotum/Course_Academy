              "value": "\\frac{3\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\frac{\\sqrt{5}x}{5})-2\\operatorname{ln}⁡|x+1|+C"
            },
            {
              "type": "math",
              "value": "\\operatorname{ln}⁡({x}^{2}+5)-\\frac{2}{5}\\operatorname{arctan}⁡(\\frac{x}{5})-\\operatorname{ln}⁡|x+1|+C"
            },
            {
