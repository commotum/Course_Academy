#{[{:db/id #edb/ref 17592186265227 :knowledge-point/_questions [{:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c578c4d7-051e-517c-8298-7ea4f24aa53a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{{e}^{y}}-\\frac{3}{x}" :db/id #edb/ref 17592186265229} {:answer/id #uuid "4c80349a-e796-5b49-9136-5d4dcbd73d18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3y}}-\\frac{36}{x}" :db/id #edb/ref 17592186265230} {:answer/id #uuid "a5875d47-4d1e-580f-af0a-ec9de6686a1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{{e}^{y}}+\\frac{3}{{x}^{3}}" :db/id #edb/ref 17592186265231} {:answer/id #uuid "e91fcc8c-08f8-5706-ad03-65f422aa5b71" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{{e}^{y}}-\\frac{3}{x}" :db/id #edb/ref 17592186265232} {:answer/id #uuid "8bf7aa12-8290-5914-98bc-c52907e30ac5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{{e}^{y}}+\\frac{{e}^{y}}{x}" :db/id #edb/ref 17592186265233}] :answer-field/correct {:answer/id #uuid "c578c4d7-051e-517c-8298-7ea4f24aa53a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{{e}^{y}}-\\frac{3}{x}" :db/id #edb/ref 17592186265229} :answer-field/id #uuid "ceb0cdd7-0e15-58c7-ac08-b352259d01c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265228}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9609c42-40f2-5fc7-9701-78545366cca4" :question/math-academy-id "q-108509" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{3}{e}^{y}=9{x}^{4}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{3}{e}^{y}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\begin{aligned}{x}^{3}{e}^{y} & =9{x}^{4} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{3}{e}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(9{x}^{4}) \\\\ [({x}^{3})({e}^{y}\\cdot \\frac{\\text{d}y}{\\text{d}x})+(3{x}^{2})({e}^{y})] & =36{x}^{3} \\\\ {x}^{3}\\,{e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}+3{x}^{2}{e}^{y} & =36{x}^{3}\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{x}^{3}{e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}+3{x}^{2}{e}^{y} & =36{x}^{3} \\\\ {x}^{3}{e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =36{x}^{3}-3{x}^{2}{e}^{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{36{x}^{3}-3{x}^{2}{e}^{y}}{{x}^{3}{e}^{y}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{36}{{e}^{y}}-\\frac{3}{x}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265234 :knowledge-point/_questions [{:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b4e657-8c26-5066-bf51-21b6c156d4e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186265236} {:answer/id #uuid "6fe00fd4-8add-59cd-94c2-7fa56660c778" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186265237}] :answer-field/correct {:answer/id #uuid "13b4e657-8c26-5066-bf51-21b6c156d4e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186265236} :answer-field/id #uuid "8a781991-c5de-5fa5-9637-d5a3704ef0ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265235}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "664421d1-b6cf-5b38-b99d-fead10a1505f" :question/math-academy-id "q-342311" :question/problem "Find the slope $m$ of the tangent at the point $(1,1)$ for the curve $2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3}=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}{y}^{2}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3} & =2 \\\\ \\frac{\\text{d}}{\\text{d}x}(2{y}^{3}+{x}^{2}{y}^{2}-{x}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2) \\\\ \\frac{\\text{d}}{\\text{d}x}(2{y}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{2}{y}^{2})-\\frac{\\text{d}}{\\text{d}x}({x}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2) \\\\ 6{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+[2x{y}^{2}+2{x}^{2}y\\frac{\\text{d}y}{\\text{d}x}]-3{x}^{2} & =0 \\\\ 6{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+2x{y}^{2}+2{x}^{2}y\\frac{\\text{d}y}{\\text{d}x}-3{x}^{2} & =0 \\\\ (6{y}^{2}+2{x}^{2}y)\\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}-2x{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{x}^{2}-2x{y}^{2}}{6{y}^{2}+2{x}^{2}y}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(1,1)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)} \\\\  & ={(\\frac{3{x}^{2}-2x{y}^{2}}{6{y}^{2}+2{x}^{2}y})|}_{(1,1)} \\\\  & =\\frac{3(1)^{2}-2(1)(1)^{2}}{6(1)^{2}+2(1)^{2}(1)} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265238 :knowledge-point/_questions [{:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c" :knowledge-point/title "Determining an Intercept of a Tangent or Normal Line to a Curve Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43b44b4b-1ab8-5550-9503-193b9c0873f7" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186265240}] :answer-field/correct {:answer/id #uuid "43b44b4b-1ab8-5550-9503-193b9c0873f7" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186265240} :answer-field/id #uuid "e91b6226-f88d-5fe8-8113-12f5d3ffe42f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265239} {:answer-field/choices [{:answer/id #uuid "78ef8f5f-dd88-58ac-a699-f1755c634657" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265242}] :answer-field/correct {:answer/id #uuid "78ef8f5f-dd88-58ac-a699-f1755c634657" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265242} :answer-field/id #uuid "6572fad2-9932-5d7a-bd82-4c77995f729d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186265241}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b1e065ed-0e60-5ad9-910a-1be3816757d8" :question/math-academy-id "q-342526" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951578/assets/d997ec4e099fc8be5b34a51bdfd0e9511915c348671d9832ed640f0ec4360602.png)\n\nThe equation $4{x}^{2}+{y}^{2}=15y$ represents an ellipse. The normal line at the point $(3,3)$ on the ellipse intersects the $x$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(3,3).$ Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2} & =15y \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(15y) \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(15y) \\\\ 8x+2y\\frac{\\text{d}y}{\\text{d}x} & =15\\frac{\\text{d}y}{\\text{d}x} \\\\ 2y\\frac{\\text{d}y}{\\text{d}x}-15\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ (2y-15)\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{8x}{2y-15}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(3,3)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(3,\\,3)} \\\\  & ={(-\\frac{8x}{2y-15})|}_{(3,\\,3)} \\\\  & =-\\frac{8\\cdot 3}{2\\cdot 3-15} \\\\  & =-\\frac{24}{(-9)} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(\\frac{8}{3})}=-\\frac{3}{8}.\n$$\n\nWe can write the equation of the normal line at the point $(3,3)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-3 & =-\\frac{3}{8}(x-3) \\\\ y & =-\\frac{3}{8}x+\\frac{9}{8}+3 \\\\ y & =-\\frac{3}{8}x+\\frac{33}{8}\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $x$-axis. At the point $P$ the $y$-coordinate is $0,$ so we set $y=0$ and solve for $x:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{8}x+\\frac{33}{8} \\\\ 0 & =-\\frac{3}{8}x+\\frac{33}{8} \\\\ \\frac{3}{8}x & =\\frac{33}{8} \\\\ x & =11\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(11,\\,0).$"}] [{:db/id #edb/ref 17592186265243 :knowledge-point/_questions [{:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee77a49-29a9-5f05-bfa7-306d178446e8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186265245} {:answer/id #uuid "146a0a90-ccd5-5d05-9d07-a8d9ca20eca3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265246} {:answer/id #uuid "ca5922b5-c066-57dd-bca4-aa594fc29456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186265247} {:answer/id #uuid "99dcaf29-b602-5e67-bbce-361ef8eb81f4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265248} {:answer/id #uuid "81bef90d-82dd-5b5a-9fa4-1cc1aa643420" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186265249}] :answer-field/correct {:answer/id #uuid "8ee77a49-29a9-5f05-bfa7-306d178446e8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186265245} :answer-field/id #uuid "b51ffca5-2317-5ca5-8977-43f8243fb671" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265244}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "51fb5d36-6953-51d7-a02c-c7ac944811b3" :question/math-academy-id "q-53747" :question/problem "Find the slope of the tangent at the point $(2,\\frac{\\pi }{4})$ for the curve $x\\operatorname{sin}⁡(y)=\\sqrt{2}.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{sin}⁡(y)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y)) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{2}) \\\\ x\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(y))+\\operatorname{sin}⁡(y)\\frac{\\text{d}}{\\text{d}x}(x) & =0 \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y) & =0 \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x} & =-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\operatorname{tan}⁡(y)}{x}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(2,\\frac{\\pi }{4})$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(2,\\pi /4)} \\\\  & ={(-\\frac{\\operatorname{tan}⁡(y)}{x})}_{(2,\\pi /4)} \\\\  & =-\\frac{\\operatorname{tan}⁡(\\frac{\\pi }{4})}{2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265250 :knowledge-point/_questions [{:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43a3b8eb-6a62-53f2-909a-cf132963b0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+{y}^{2}}" :db/id #edb/ref 17592186265252} {:answer/id #uuid "69e49371-4bb3-510f-88d2-4658531fd2d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186265253} {:answer/id #uuid "7ec231fd-9cce-5de2-9a9a-bf1ef117371a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+2{y}^{3}}" :db/id #edb/ref 17592186265254} {:answer/id #uuid "559884e7-53de-5458-a6e2-9242e556afb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186265255} {:answer/id #uuid "b54f3c0c-f29d-5c90-8520-5980eb5cd6c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{sin}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186265256}] :answer-field/correct {:answer/id #uuid "559884e7-53de-5458-a6e2-9242e556afb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186265255} :answer-field/id #uuid "df9fe65b-4b2c-5776-805c-35dea9340d86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265251}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f84fff36-2406-5dc5-8004-29d635957982" :question/math-academy-id "q-72213" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{sin}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y)+{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y))+\\frac{\\text{d}}{\\text{d}x}({y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [x(\\operatorname{cos}⁡(y)\\cdot \\frac{\\text{d}y}{\\text{d}x})+\\operatorname{sin}⁡(y)]+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x}(x\\operatorname{cos}⁡(y)+3{y}^{2}) & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}\\end{aligned}\n$$"}]}
