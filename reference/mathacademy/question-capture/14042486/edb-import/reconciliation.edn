3{e}^{3x})\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{3x}\\operatorname{sin}⁡x-3J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{3x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{3x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{3x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(3{e}^{3x})\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3\\int {e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{3x}\\operatorname{cos}⁡x+3I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & ={e}^{3x}\\operatorname{sin}⁡x-3J \\\\ I & ={e}^{3x}\\operatorname{sin}⁡x-3(-{e}^{3x}\\operatorname{cos}⁡x+3I) \\\\ I & ={e}^{3x}\\operatorname{sin}⁡x+3{e}^{3x}\\operatorname{cos}⁡x-9I \\\\ 10I & ={e}^{3x}\\operatorname{sin}⁡x+3{e}^{3x}\\operatorname{cos}⁡x \\\\ I & =\\frac{{e}^{3x}(\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)}{10}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }{e}^{3x}\\operatorname{cos}⁡x\\,\\text{d}x & =(\\frac{{e}^{3x}(\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x)}{10}){|}_{0}^{2\\pi } \\\\  & =\\frac{{e}^{3(2\\pi )}(\\operatorname{sin}⁡(2\\pi )+3\\operatorname{cos}⁡(2\\pi ))}{10}-\\frac{{e}^{3(0)}(\\operatorname{sin}⁡(0)+3\\operatorname{cos}⁡(0))}{10} \\\\  & =\\frac{3{e}^{6\\pi }}{10}-\\frac{3}{10} \\\\  & =\\frac{3}{10}({e}^{6\\pi }-1)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-49967" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/activity-metadata.json" "file_sha256" "1bb557360bbee7325bccf0113aaf885633ba56b2616e357717414460c45b3b7b"} {"question" "q-49967" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-49967" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "10({e}^{6\\pi }-1)"] ["math" "\\frac{1}{10}({e}^{6\\pi }+1)"] ["math" "\\frac{3}{10}({e}^{6\\pi }-1)"] ["math" "{e}^{2\\pi }+1"] ["math" "{e}^{6\\pi }-1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-49967" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{10}({e}^{6\\pi }-1)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-362669" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi }{e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x=\\frac{1}{10}($\n{{field-1}} $)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-362669" "field" nil "attribute" "question/worked-solution" "value" "Let's denote the indefinite integral by  $I=\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =({e}^{-x})(\\frac{1}{3}\\operatorname{sin}⁡(3x))-\\int (\\frac{1}{3}\\operatorname{sin}⁡(3x))(-{e}^{-x})\\,\\text{d}x \\\\  & =\\frac{1}{3}{e}^{-x}\\operatorname{sin}⁡(3x)+\\frac{1}{3}\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{3}{e}^{-x}\\operatorname{sin}⁡(3x)+\\frac{1}{3}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x.\n$$\n\nLet\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x=-\\frac{1}{3}\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nThen\n\n$$\n\\begin{aligned}J & =({e}^{-x})(-\\frac{1}{3}\\operatorname{cos}⁡(3x))-\\int (-\\frac{1}{3}\\operatorname{cos}⁡(3x))(-{e}^{-x})\\,\\text{d}x \\\\  & =-\\frac{1}{3}{e}^{-x}\\operatorname{cos}⁡(3x)-\\frac{1}{3}\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-\\frac{1}{3}{e}^{-x}\\operatorname{cos}⁡(3x)-\\frac{1}{3}I.\\end{aligned}\n$$\n\nSubstituting this into our equation for $I,$ we solve:\n\n$$\n\\begin{aligned}I & =\\frac{1}{3}{e}^{-x}\\operatorname{sin}⁡(3x)+\\frac{1}{3}J \\\\ I & =\\frac{1}{3}{e}^{-x}\\operatorname{sin}⁡(3x)+\\frac{1}{3}(-\\frac{1}{3}{e}^{-x}\\operatorname{cos}⁡(3x)-\\frac{1}{3}I) \\\\ I & =\\frac{1}{3}{e}^{-x}\\operatorname{sin}⁡(3x)-\\frac{1}{9}{e}^{-x}\\operatorname{cos}⁡(3x)-\\frac{1}{9}I \\\\ 10I & ={e}^{-x}(3\\operatorname{sin}⁡(3x)-\\operatorname{cos}⁡(3x)) \\\\ I & =\\frac{{e}^{-x}}{10}(3\\operatorname{sin}⁡(3x)-\\operatorname{cos}⁡(3x)).\\end{aligned}\n$$\n\nFinally, we evaluate the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }{e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x & =(\\frac{{e}^{-x}}{10}(3\\operatorname{sin}⁡(3x)-\\operatorname{cos}⁡(3x))){|}_{0}^{\\pi } \\\\  & =(\\frac{{e}^{-\\pi }}{10}(0-(-1)))-(\\frac{1}{10}(0-1)) \\\\  & =\\frac{{e}^{-\\pi }}{10}+\\frac{1}{10} \\\\  & =\\frac{1}{10}({e}^{-\\pi }+1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-362669" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/activity-metadata.json" "file_sha256" "1bb557360bbee7325bccf0113aaf885633ba56b2616e357717414460c45b3b7b"} {"question" "q-362669" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "q-362669" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "e^{-\\pi}+1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/state.json" "file_sha256" "148f879e50920bbb60c00776e8408455ebe5df66683637a8801cf3ae2f787049"} {"question" "e-497" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int \\dfrac{\\ln^2{x}}{x} \\textrm{d}x$ using integration by parts." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-497.json" "file_sha256" "5dc1c25d4320960d59309c8104335e0b52916f883b2a950ce97e75f8f4ca8f7f"} {"question" "e-497" "field" nil "attribute" "question/worked-solution" "value" "First, we let\n\n$$\nI = \\int \\dfrac{\\ln^2 x}{x} \\, \\textrm{d}x.\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{2}⁡x & \\,⇒\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x} & \\,⇒\\,v=\\int \\frac{1}{x}\\text{d}x=\\operatorname{ln}⁡x\\,.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{2}⁡x}{x}\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{2}⁡x)(\\operatorname{ln}⁡x)-\\int (\\operatorname{ln}⁡x)(\\frac{2\\operatorname{ln}⁡x}{x})\\text{d}x \\\\  & ={ln}^{3}⁡x-2\\int \\frac{{ln}^{2}⁡x}{x}\\,\\text{d}x \\\\  & ={ln}^{3}⁡x-2I.\\end{aligned}\n$$\n\nFinally, we solve for $I,$ remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}I & ={ln}^{3}⁡x-2I \\\\ 3I & ={ln}^{3}⁡x \\\\ I & =\\frac{{ln}^{3}⁡x}{3}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-497.json" "file_sha256" "5dc1c25d4320960d59309c8104335e0b52916f883b2a950ce97e75f8f4ca8f7f"} {"question" "e-498" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int e^{x}\\sin{x} \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-498.json" "file_sha256" "df7a26e47685e6d80c299db4d24ba77015956b5e393af02fcee7405ce26014d8"} {"question" "e-498" "field" nil "attribute" "question/worked-solution" "value" "To use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⇒\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)({e}^{x})\\text{d}x \\\\  & =-{e}^{x}\\operatorname{cos}⁡x+\\int {e}^{x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-{e}^{x}\\operatorname{cos}⁡x+J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos{x}\\,\\textrm{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⇒\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{x}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)({e}^{x})\\text{d}x \\\\  & ={e}^{x}\\operatorname{sin}⁡x-\\int {e}^{x}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & ={e}^{x}\\operatorname{sin}⁡x-I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & =-{e}^{x}\\operatorname{cos}⁡x+J \\\\ I & =-{e}^{x}\\operatorname{cos}⁡x+{e}^{x}\\operatorname{sin}⁡x-I \\\\ 2I & =-{e}^{x}\\operatorname{cos}⁡x+{e}^{x}\\operatorname{sin}⁡x \\\\ I & =\\frac{{e}^{x}}{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-498.json" "file_sha256" "df7a26e47685e6d80c299db4d24ba77015956b5e393af02fcee7405ce26014d8"} {"question" "e-7313" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_0^{\\pi/2} e^x\\sin(2x) \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-7313.json" "file_sha256" "fe4fce9fdbd62fcfb6331190bba21e058902d87b366b0f6fe6169c5475443c29"} {"question" "e-7313" "field" nil "attribute" "question/worked-solution" "value" "Let's denote the indefinite integral by $I = \\displaystyle \\int e^{x}\\sin(2x)\\, \\textrm{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})({e}^{x})\\text{d}x \\\\  & =-\\frac{{e}^{x}\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int {e}^{x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{x}\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos(2x)\\,\\textrm{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{x}(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})({e}^{x})\\text{d}x \\\\  & =\\frac{{e}^{x}\\operatorname{sin}⁡(2x)}{2}-\\frac{1}{2}\\int {e}^{x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{{e}^{x}\\operatorname{sin}⁡(2x)}{2}-\\frac{1}{2}I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I\\mathbin.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & =-\\frac{{e}^{x}\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}J \\\\ I & =-\\frac{{e}^{x}\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}(\\frac{{e}^{x}\\operatorname{sin}⁡(2x)}{2}-\\frac{1}{2}I) \\\\ I & =-\\frac{{e}^{x}\\operatorname{cos}⁡(2x)}{2}+\\frac{{e}^{x}\\operatorname{sin}⁡(2x)}{4}-\\frac{1}{4}I \\\\ \\frac{5}{4}I & =\\frac{{e}^{x}\\operatorname{sin}⁡(2x)-2{e}^{x}\\operatorname{cos}⁡(2x)}{4} \\\\ I & =\\frac{{e}^{x}(\\operatorname{sin}⁡(2x)-2\\operatorname{cos}⁡(2x))}{5}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{e}^{x}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =(\\frac{{e}^{x}(\\operatorname{sin}⁡(2x)-2\\operatorname{cos}⁡(2x))}{5}){|}_{0}^{\\pi /2} \\\\  & =\\frac{{e}^{\\pi /2}(\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})-2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}))}{5}-\\frac{{e}^{0}(\\operatorname{sin}⁡(2\\cdot 0)-2\\operatorname{cos}⁡(2\\cdot 0))}{5} \\\\  & =\\frac{2{e}^{\\pi /2}}{5}+\\frac{2}{5} \\\\  & =\\frac{2}{5}({e}^{\\pi /2}+1)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042486/example-7313.json" "file_sha256" "fe4fce9fdbd62fcfb6331190bba21e058902d87b366b0f6fe6169c5475443c29"}] "usage" {"e-7313" [] "e-497" [] "q-14878" [] "e-498" []} "basis" 1564 "retractions" [[17592186068993 :question/problem "Calculate $\\inte^{-x}\\cos (3x)dx$."] [17592186068504 :question/worked-solution "First, we let\n\n$$\nI = \\int \\dfrac{\\ln^2 x}{x} \\, \\textrm{d}x\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = \\ln^{2} x & ⇒\\frac{du}{dx} = \\frac{2\\ln x}{x}, \\\\ \\frac{dv}{dx} = \\frac{1}{x} & ⇒v = \\int\\frac{1}{x}dx = \\ln x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\int\\frac{\\ln^{2} x}{x}dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (\\ln^{2} x)(\\ln x) - \\int(\\ln x)(\\frac{2\\ln x}{x})dx \\\\\n&= \\ln^{3} x - 2\\int\\frac{\\ln^{2} x}{x}dx \\\\\n&= \\ln^{3} x - 2I\n\\end{aligned}\n$$\n\nFinally, we solve for $I$, remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}\nI &= \\ln^{3} x - 2I \\\\\n3I &= \\ln^{3} x \\\\\nI &= \\frac{\\ln^{3} x}{3} + C\n\\end{aligned}\n$$"] [17592186068505 :question/problem "Calculate $\\displaystyle \\int e^{x}\\sin{x} \\, \\textrm{d}x$."] [17592186068505 :question/worked-solution "To use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\sin x & ⇒v = \\int\\sin xdx =-\\cos x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\inte^{x}\\sin xdx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(-\\cos x) - \\int(-\\cos x)(e^{x})dx \\\\\n&=-e^{x}\\cos x + \\inte^{x}\\cos xdx \\\\\n&=-e^{x}\\cos x + J\n\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos{x}\\,\\textrm{d}x\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\cos x & ⇒v = \\int\\cos xdx = \\sin x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}\nJ &= \\inte^{x}\\cos xdx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(\\sin x) - \\int(\\sin x)(e^{x})dx \\\\\n&= e^{x}\\sin x - \\inte^{x}\\sin xdx \\\\\n&= e^{x}\\sin x - I\n\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I$, we can subsequently solve for $I$. We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}\nI &= -e^{x}\\cos x + J \\\\\nI &= -e^{x}\\cos x + e^{x}\\sin x - I \\\\\n2I &= -e^{x}\\cos x + e^{x}\\sin x \\\\\nI &= \\frac{e^{x}}{2}(\\sin x - \\cos x) + C\n\\end{aligned}\n$$"] [17592186068568 :question/problem "Evaluate $\\displaystyle \\int_0^{\\pi/2} e^x\\sin(2x) \\, \\textrm{d}x$."] [17592186068568 :question/worked-solution "Let's denote the indefinite integral by\n\n$$\nI = \\displaystyle \\int e^{x}\\sin(2x)\\, \\textrm{d}x\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\sin (2x) & ⇒v = \\int\\sin (2x)dx = - (\\cos (2x))/(2)\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\inte^{x}\\sin (2x)dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(- (\\cos (2x))/(2)) - \\int(- (\\cos (2x))/(2))(e^{x})dx \\\\\n&= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}\\inte^{x}\\cos (2x)dx \\\\\n&= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}J\n\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos(2x)\\,\\textrm{d}x\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\cos (2x) & ⇒v = \\int\\cos (2x)dx = (\\sin (2x))/(2)\\end{bmatrix}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}\nJ &= \\inte^{x}\\cos (2x)dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}((\\sin (2x))/(2)) - \\int((\\sin (2x))/(2))(e^{x})dx \\\\\n&= (e^{x}\\sin (2x))/(2) - \\frac{1}{2}\\inte^{x}\\sin (2x)dx \\\\\n&= (e^{x}\\sin (2x))/(2) - \\frac{1}{2}I\n\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I$, we can subsequently solve for $I$:\n\n$$\n\\begin{aligned}\nI &= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}J \\\\\nI &= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}((e^{x}\\sin (2x))/(2) - \\frac{1}{2}I) \\\\\nI &= - (e^{x}\\cos (2x))/(2) + (e^{x}\\sin (2x))/(4) - \\frac{1}{4}I \\\\\n\\frac{5}{4}I &= (e^{x}\\sin (2x) - 2e^{x}\\cos (2x))/(4) \\\\\nI &= (e^{x}(\\sin (2x) - 2\\cos (2x)))/(5)\n\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{π/2}e^{x}\\sin (2x)dx &= \\left.((e^{x}(\\sin (2x) - 2\\cos (2x)))/(5))\\right|_{0}^{π/2} \\\\\n&= (e^{π/2}(\\sin (2 \\cdot \\frac{π}{2}) - 2\\cos (2 \\cdot \\frac{π}{2})))/(5) - (e^{0}(\\sin (2 \\cdot 0) - 2\\cos (2 \\cdot 0)))/(5) \\\\\n&= \\frac{2e^{π/2}}{5} + \\frac{2}{5} \\\\\n&= \\frac{2}{5}(e^{π/2} + 1)\n\\end{aligned}\n$$"]] "immutable_answers" [17592186065753 17592186065754 17592186065755 17592186065756 17592186065757] "immutable_fields" [[17592186065752 :answer-field/correct] [17592186065752 :answer-field/id] [17592186065752 :answer-field/key] [17592186065752 :answer-field/type]] "no_history" []}
