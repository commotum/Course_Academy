}+7z-8)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+7z-8\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z-8\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $8$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}-8\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}-8\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{7}{2})}^{2}-\\frac{81}{4}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-2({z}^{2}+7z-8) & =-2({(z+\\frac{7}{2})}^{2}-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+(-2)\\cdot (-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35079/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590"] :knowledge-point/questions ["q-35079"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140532/selection/2d9e49ee918f31d997c82483d7bd260bd770b47e3d3fd2f16c4c89a4bc9cc6b8" :answer/id #uuid "906c4120-0217-530d-ae6b-6536ad39c76e" :answer/type :answer.type/math :answer/value "-5{(x+4)}^{2}-5" :db/ensure [:answer/validate]} {:db/id "q-140532/selection/57af6d8e792969da0ef63fbc580cd6bfae35e1df9e2524363239181b8c36c8df" :answer/id #uuid "707da9b4-a753-5940-b39d-e6f18010ab67" :answer/type :answer.type/math :answer/value "-5{(x+4)}^{2}+16" :db/ensure [:answer/validate]} {:db/id "q-140532/selection/12eed97cc5150ba32337733f2d2953e0bdb5640aff24000ccc4cb9d69269377a" :answer/id #uuid "f144e0f3-7696-56e9-a1b6-3c677bb60c03" :answer/type :answer.type/math :answer/value "-5{(x+4)}^{2}+20" :db/ensure [:answer/validate]} {:db/id "q-140532/selection/374b5ac367079910417f10dcaf3a47b6507bbe3a2f224243703c4a63b9b0c758" :answer/id #uuid "a4218eca-d68b-52cb-b20b-abc2b1073822" :answer/type :answer.type/math :answer/value "-{(5x+4)}^{2}-4" :db/ensure [:answer/validate]} {:db/id "q-140532/selection/fa00871e69f7f6b6d3bf8f053b1c348720786c980b3153e9a16a1d95d6e98696" :answer/id #uuid "f2670705-3457-5a69-a45a-87afb4b1e63f" :answer/type :answer.type/math :answer/value "-5{(x-4)}^{2}-16" :db/ensure [:answer/validate]} {:db/id "q-140532/selection" :answer-field/id #uuid "4170b0a9-742b-5509-805c-3bd8ceff96b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140532/selection/12eed97cc5150ba32337733f2d2953e0bdb5640aff24000ccc4cb9d69269377a" :answer-field/choices ["q-140532/selection/2d9e49ee918f31d997c82483d7bd260bd770b47e3d3fd2f16c4c89a4bc9cc6b8" "q-140532/selection/57af6d8e792969da0ef63fbc580cd6bfae35e1df9e2524363239181b8c36c8df" "q-140532/selection/12eed97cc5150ba32337733f2d2953e0bdb5640aff24000ccc4cb9d69269377a" "q-140532/selection/374b5ac367079910417f10dcaf3a47b6507bbe3a2f224243703c4a63b9b0c758" "q-140532/selection/fa00871e69f7f6b6d3bf8f053b1c348720786c980b3153e9a16a1d95d6e98696"] :db/ensure [:answer-field/validate]} {:db/id "q-140532" :question/id #uuid "36b3e47b-00dc-53b2-9c7f-dfb0c26561cb" :question/math-academy-id "q-140532" :question/problem "Rewrite $-5{x}^{2}-40x-60$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-5.$ So, we take out a factor of $-5$ from the entire expression:\n\n$$\n-5({x}^{2}+8x+12)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+8x+12\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 4x+12\n$$\n\nThen, we *add* and *then subtract* ${4}^{2},$ writing the constant term $12$ last:\n\n$$\n{{x}^{2}+2\\cdot 4x+{4}^{2}}_{⏟}-{4}^{2}+12\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+4)^{2}-{4}^{2}+12\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x+4)^{2}-4\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-5({x}^{2}+8x+12) & =-5((x+4)^{2}-4) \\\\  & =-5{(x+4)}^{2}+(-5)\\cdot (-4) \\\\  & =-5{(x+4)}^{2}+20\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590"] :knowledge-point/questions ["q-140532"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-140378"] :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-140536/selection/6bc1155bb47aa1419a8daef76ac8e4fee2d2c1022f37b2593ced87437468e6d8" :answer/id #uuid "f80e56da-0b1e-5482-81fc-a46e72cee8b6" :answer/type :answer.type/math :answer/value "-5{(x+\\frac{3}{5})}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-140536/selection/dd1095d9b219b1fc5be31012a73cbc7633d41b913a55d4fdb69276b36e8b6679" :answer/id #uuid "7762298c-9087-5d7a-ba6b-c663a48fb213" :answer/type :answer.type/math :answer/value "-5{(x+\\frac{3}{5})}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-140536/selection/6ada896a29b252a72a79a86d0907d38345918e26b3a9ef9d06ef0acc14d18f5a" :answer/id #uuid "9cc1d206-f51f-5de9-b135-2924bd105e50" :answer/type :answer.type/math :answer/value "-5{(x-\\frac{3}{5})}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-140536/selection/0b76fe5687fe5540cf643b6aadbb555776a2da4d308cd770c2859e430a08ca3f" :answer/id #uuid "d917f23a-61fc-5659-9cef-ce65d4fcec60" :answer/type :answer.type/math :answer/value "-5{(x-\\frac{3}{5})}^{2}-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-140536/selection/cd2f80be90c37d9c28d9bcf0a3f1f784827d5d97c877176fe3c54da72d9fa6fc" :answer/id #uuid "ad744468-7075-5b78-abcc-100ba256f09b" :answer/type :answer.type/math :answer/value "-5{(x+\\frac{3}{5})}^{2}-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-140536/selection" :answer-field/id #uuid "39381930-8011-5c66-ae6b-4e6236c5a3ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140536/selection/dd1095d9b219b1fc5be31012a73cbc7633d41b913a55d4fdb69276b36e8b6679" :answer-field/choices ["q-140536/selection/6bc1155bb47aa1419a8daef76ac8e4fee2d2c1022f37b2593ced87437468e6d8" "q-140536/selection/dd1095d9b219b1fc5be31012a73cbc7633d41b913a55d4fdb69276b36e8b6679" "q-140536/selection/6ada896a29b252a72a79a86d0907d38345918e26b3a9ef9d06ef0acc14d18f5a" "q-140536/selection/0b76fe5687fe5540cf643b6aadbb555776a2da4d308cd770c2859e430a08ca3f" "q-140536/selection/cd2f80be90c37d9c28d9bcf0a3f1f784827d5d97c877176fe3c54da72d9fa6fc"] :db/ensure [:answer-field/validate]} {:db/id "q-140536" :question/id #uuid "94cfd951-eb47-55d8-8db5-3c88796721c2" :question/math-academy-id "q-140536" :question/problem "Rewrite $-5{x}^{2}-6x+\\frac{1}{5}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-5.$ So, we take out a factor of $-5$ from the entire expression:\n\n$$\n-5({x}^{2}+\\frac{6}{5}x-\\frac{1}{25})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+\\frac{6}{5}x-\\frac{1}{25}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor: \n\n$$\n{x}^{2}+2\\cdot \\frac{3}{5}\\cdot x-\\frac{1}{25}\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{5})}^{2},$ writing the constant term $\\frac{1}{25}$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{3}{5}\\cdot x+{(\\frac{3}{5})}^{2}}_{⏟}-{(\\frac{3}{5})}^{2}-\\frac{1}{25}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{3}{5})}^{2}-{(\\frac{3}{5})}^{2}-\\frac{1}{25}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{3}{5})}^{2}-\\frac{2}{5}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-5({x}^{2}+\\frac{6}{5}x-\\frac{1}{25}) & =-5({(x+\\frac{3}{5})}^{2}-\\frac{2}{5}) \\\\  & =-5{(x+\\frac{3}{5})}^{2}+(-5)\\cdot (-\\frac{2}{5}) \\\\  & =-5{(x+\\frac{3}{5})}^{2}+2\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140536/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590"] :knowledge-point/questions ["q-140536"] :db/ensure [:knowledge-point/validate]}]
