#{[{:db/id #edb/ref 17592186091900 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/id #uuid "4a734f55-ceac-587c-a831-fa8bed578a99" :question/is-example true :question/math-academy-id "e-148" :question/problem "Find the slope of the normal line to the curve $y = 2x^3 -x^2$ at the point $(1,1)$." :question/worked-solution "Let\n\n$$\nf(x) = 2x^3-x^2\n$$\n\nFirst, we compute the derivative:\n\n$$\nf'(x) =6x^2 -2x\n$$\n\nThen, we compute the slope of the tangent at the point $(1,1)$:\n\n$$\nm=f'(1) = 6(1)^2 - 2(1) = 4\n$$\n\nTherefore, the slope of the normal line $m'$ is\n\n$$\nm' = -\\dfrac{1}{m} = -\\dfrac 1 4\n$$"}] [{:db/id #edb/ref 17592186091901 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/id #uuid "df59a07a-922c-50b9-8c2c-22ed57ac2bda" :question/is-example true :question/math-academy-id "e-149" :question/problem "Find where the normal line to the curve $f(x) = 2\\sqrt{x} -4x$ at the point $(1,-2)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(2\\sqrt{x} - 4x) \\\\\n&= \\frac{d}{dx}(2x^{1/2} - 4x) \\\\\n&= x^{-1/2} - 4\n\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(1) = (1)^{-1/2} - 4 = -3\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm' = -\\dfrac{1}{m} = \\dfrac 1 3\n$$\n\nThe equation of the normal line is\n\n$$\n\\begin{aligned}\ny - (-2) &= \\frac{1}{3}(x - 1) \\\\\ny + 2 &= \\frac{1}{3}(x - 1) \\\\\ny &= \\frac{1}{3}x - \\frac{1}{3} - 2 \\\\\ny &= \\frac{1}{3}x - \\frac{7}{3}\n\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\n\\frac{1}{3}x - \\frac{7}{3} &= 0 \\\\\n\\frac{1}{3}x &= \\frac{7}{3} \\\\\nx &= 7\n\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(7,0)$."}] [{:db/id #edb/ref 17592186092030 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/id #uuid "e405bf60-d500-55df-90be-a938dc9dfc93" :question/is-example true :question/math-academy-id "e-6080" :question/problem "The equation of the normal line to the curve $y=x^3 - x^2$ at the point $(1,0)$ is given by $y=px+q$ where $p$ and $q$ are constants. Find the values of $p$ and $q$." :question/worked-solution "Let\n\n$$\nf(x)=x^3 - x^2\n$$\n\nFirst, we compute the derivative:\n\n$$\nf^{′}(x) = \\frac{d}{dx}(x^{3} - x^{2}) = 3x^{2} - 2x\n$$\n\nThen, we compute the slope of the tangent at the point $(1, 0){:}$\n\n$$\nm = f^{′}(1) = 3 - 2 = 1\n$$\n\nTherefore, the slope of the normal line $m'$ is\n\n$$\nm'=-\\dfrac{1}{m}=-1\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}\ny - 0 &= - (x - 1) \\\\\ny &= -x + 1\n\\end{aligned}\n$$\n\nTherefore, $p=-1$ and $q=1$."}] [{:db/id #edb/ref 17592186092457 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae589b44-4a4d-5aab-b06e-b155ce97dd52" :answer/type {:db/ident :answer.type/math} :answer/value "(0, \\frac{1}{2})" :db/id #edb/ref 17592186089179} {:answer/id #uuid "c77360b4-5594-5ff2-94e2-529915aa5f14" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 2)" :db/id #edb/ref 17592186089180} {:answer/id #uuid "e175c968-e6fc-5732-8583-17cb60b4c41a" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 3)" :db/id #edb/ref 17592186089181} {:answer/id #uuid "1efadb9e-930f-5f85-9638-cdc930a4d33c" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 1)" :db/id #edb/ref 17592186089182} {:answer/id #uuid "548169f7-a15a-505e-ac9b-b1366d2cb71d" :answer/type {:db/ident :answer.type/math} :answer/value "(0, \\frac{5}{2})" :db/id #edb/ref 17592186089183}] :answer-field/correct {:answer/id #uuid "e175c968-e6fc-5732-8583-17cb60b4c41a" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 3)" :db/id #edb/ref 17592186089181} :answer-field/id #uuid "8cd5ef3b-90b7-58f5-83b5-f471bd111162" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089178}] :question/id #uuid "24c7ef87-44ff-5aaa-8c80-717e24087d16" :question/is-example false :question/math-academy-id "q-11124" :question/problem "Find where the normal line to the curve $f(x) = 2\\sqrt{x}$ at the point $(1, 2)$ intersects the $y$-axis."}]}
