#{[{:db/id #edb/ref 17592186243014 :knowledge-point/_questions [{:knowledge-point/id #uuid "35a19512-4ba7-59c1-ae00-7b8f158264fe" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e07cb84-d0b4-5170-bb6d-8e0aff34a673" :answer/type {:db/ident :answer.type/math} :answer/value "132\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243016} {:answer/id #uuid "3bb38e1a-94a3-5217-aca2-aab60076c4b5" :answer/type {:db/ident :answer.type/math} :answer/value "144\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243017} {:answer/id #uuid "58ef7413-d232-53e3-b05b-cc4e25c64794" :answer/type {:db/ident :answer.type/math} :answer/value "164\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243018} {:answer/id #uuid "858d11dc-8943-5927-9a54-8f1821d56261" :answer/type {:db/ident :answer.type/math} :answer/value "156\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243019} {:answer/id #uuid "cd2f358e-d060-5361-9e36-0857128bf9e8" :answer/type {:db/ident :answer.type/math} :answer/value "148\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243020}] :answer-field/correct {:answer/id #uuid "858d11dc-8943-5927-9a54-8f1821d56261" :answer/type {:db/ident :answer.type/math} :answer/value "156\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186243019} :answer-field/id #uuid "567812c0-b06b-53d3-a732-67726c6b5fb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243015}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8020cab4-3d7d-5a11-9426-5c8de74166ce" :question/math-academy-id "q-119208" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930500/assets/4f2807a0989a3f36376d1ed93d02162ded72200803d28b49caab701176837628.png)\n\nWhat is the total surface area of the rectangular pyramid represented by the net above?" :question/worked-solution "The surface area of our pyramid consists of $1$ square (base) and $4$ triangles (side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =1\\times (\\text{Area of the base})+4\\times (\\text{Area of the side}) \\\\  & =1\\times 36+4\\times 30 \\\\  & =36+120 \\\\  & =156\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186147896 :knowledge-point/_questions [{:knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a372cabe-863d-5655-b130-b77c289b8b45" :answer/type {:db/ident :answer.type/math} :answer/value "25ft^{2}" :db/id #edb/ref 17592186145388} {:answer/id #uuid "fa5b27af-4a59-5e8d-bf88-2cf72f89bfbc" :answer/type {:db/ident :answer.type/math} :answer/value "32ft^{2}" :db/id #edb/ref 17592186145389} {:answer/id #uuid "43de98f0-c6fb-5850-b8b3-142ca5894921" :answer/type {:db/ident :answer.type/math} :answer/value "40ft^{2}" :db/id #edb/ref 17592186145390} {:answer/id #uuid "4d105580-4448-5844-89d9-c1da675148f5" :answer/type {:db/ident :answer.type/math} :answer/value "24ft^{2}" :db/id #edb/ref 17592186145391} {:answer/id #uuid "669394dd-617c-5e43-8e2e-945a929b4660" :answer/type {:db/ident :answer.type/math} :answer/value "36ft^{2}" :db/id #edb/ref 17592186145392}] :answer-field/correct {:answer/id #uuid "fa5b27af-4a59-5e8d-bf88-2cf72f89bfbc" :answer/type {:db/ident :answer.type/math} :answer/value "32ft^{2}" :db/id #edb/ref 17592186145389} :answer-field/id #uuid "7c970f91-3016-5244-9680-fa47b3d9ad8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186145387}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "afc6c730-43c5-56ca-913e-065a04d0dcda" :question/math-academy-id "q-62051" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/2469/Source/Images/q-62051.png)\n\nDave unfolds a cardboard box and gets the net shown above. In the figure, the areas of two of its faces are shown. What is the total surface area of the box?" :question/worked-solution "The net shown corresponds to a rectangular prism. The surface area of our prism consists of $2$ squares (base and top) and $4$ rectangles (side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+4\\times (\\text{Area of the side}) \\\\  & =2\\times 4+4\\times 6 \\\\  & =8+24 \\\\  & =32\\,{\\text{ft}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243021 :knowledge-point/_questions [{:knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eed53d2-4cb0-5293-b007-12540aad1a3c" :answer/type {:db/ident :answer.type/text} :answer/value "$$728$" :db/id #edb/ref 17592186243023} {:answer/id #uuid "d941a6d5-c450-5474-a23a-d9d374030b08" :answer/type {:db/ident :answer.type/text} :answer/value "$$211$" :db/id #edb/ref 17592186243024} {:answer/id #uuid "feec887f-d0eb-56d9-8906-0efc8097c725" :answer/type {:db/ident :answer.type/text} :answer/value "$$782$" :db/id #edb/ref 17592186243025} {:answer/id #uuid "225e1086-5a1b-5246-ac5e-a62929728648" :answer/type {:db/ident :answer.type/text} :answer/value "$$827$" :db/id #edb/ref 17592186243026} {:answer/id #uuid "2dc158a0-96ab-512d-847b-7ca73f08ca86" :answer/type {:db/ident :answer.type/text} :answer/value "$$112$" :db/id #edb/ref 17592186243027}] :answer-field/correct {:answer/id #uuid "8eed53d2-4cb0-5293-b007-12540aad1a3c" :answer/type {:db/ident :answer.type/text} :answer/value "$$728$" :db/id #edb/ref 17592186243023} :answer-field/id #uuid "75904f92-8b53-52a8-9ce0-04342c711241" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243022}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "abe6fddf-a313-54f2-92c6-9b51675460f7" :question/math-academy-id "q-62248" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930500/assets/c241f6afc3978dfc8d1e2a048509a2e6fc7c91b0caf5ac4814a864edc3992d0c.png)\n\nChloe wants to paint a steel box that has the form of a rectangular prism. Two of the polygonal faces are $4\\,\\text{ft}\\times 4\\,\\text{ft}$ squares. If the cost to paint the surface is $$6.50$ per square foot, how much will it cost her in total? Note that Chloe does *not* need to paint the square sides." :question/worked-solution "The net of our prism is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930500/assets/7b84a48933abb96f605476c6d703406227b0fe5301b1457a447cdbb3f58f0937.png)\n\n \n\n$$\n\n$$\n\nEach side face (apart from the square faces) of our solid is a rectangle, where the base is $7\\,\\text{ft}$ and the height is $4\\,\\text{ft}.$ Therefore\n\n$$\n\\text{Area of the rectangle}=7\\times 4=28\\,{\\text{ft}}^{2}.\n$$\n\nNow, the total area of the side surfaces consists of $4$ rectangular faces. \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area of the sides} & =4\\times (\\text{Area of the rectangle}) \\\\  & =4\\times 28 \\\\  & =112\\,{\\text{ft}}^{2}.\\end{aligned}\n$$\n\nFinally, since the cost to paint the surface is $$6.50$ per square foot, the total amount that Chloe will have to pay is\n\n$$\n112\\times 6.50=$728.\n$$"}] [{:db/id #edb/ref 17592186147917 :knowledge-point/_questions [{:knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given Some Lengths"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b72c2893-dc79-5d0c-af44-8e390dc5bf37" :answer/type {:db/ident :answer.type/math} :answer/value "4m^{2}" :db/id #edb/ref 17592186145514} {:answer/id #uuid "bc789964-1f69-55eb-9191-c482bbcea801" :answer/type {:db/ident :answer.type/math} :answer/value "46m^{2}" :db/id #edb/ref 17592186145515} {:answer/id #uuid "1892b670-32c9-55f6-be01-11e797f24bd9" :answer/type {:db/ident :answer.type/math} :answer/value "40m^{2}" :db/id #edb/ref 17592186145516} {:answer/id #uuid "4d985f82-1ee8-5b77-a22f-b66745397ac8" :answer/type {:db/ident :answer.type/math} :answer/value "36m^{2}" :db/id #edb/ref 17592186145517} {:answer/id #uuid "6309f5f5-662d-5e37-8fbd-11c5b3cbfd7b" :answer/type {:db/ident :answer.type/math} :answer/value "9m^{2}" :db/id #edb/ref 17592186145518}] :answer-field/correct {:answer/id #uuid "1892b670-32c9-55f6-be01-11e797f24bd9" :answer/type {:db/ident :answer.type/math} :answer/value "40m^{2}" :db/id #edb/ref 17592186145516} :answer-field/id #uuid "0d492551-a431-5a60-82e0-a324c877337e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186145513}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8ce742b5-57f4-53b1-882f-51d5011e4a65" :question/math-academy-id "q-62256" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/2469/Source/Images/q-62256.png)\n\nAssuming that all side faces have the same height of $9m$, find the total surface area of the square pyramid above using its net." :question/worked-solution "The net of our pyramid is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930500/assets/09eff98ca31b4bb350e2d793dcfa6e6972de25bb3b613c898533068c36fe9a78.png)\n\n$$\n\n$$\n\nFirst, notice that the base of the pyramid is a square with a side equal to $2\\,\\text{m}.$ Hence:\n\n$$\n\\text{Area of the square}=2\\times 2=4\\,{\\text{m}}^{2}.\n$$\n\n \n\nEach side face of our solid is triangle, where the base is $2\\,\\text{m}$ and the height is $9\\,\\text{m}.$ Therefore:\n\n$$\n\\text{Area of the triangle}=\\frac{1}{2}\\times 2\\times 9=9\\,{\\text{m}}^{2}.\n$$\n\nFinally, the surface area of the pyramid consists of $1$ square (base) and $4$ triangles (side faces). \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =(\\text{Area of the square})+4\\times (\\text{Area of the triangle}) \\\\  & =4+4\\times 9 \\\\  & =4+36 \\\\  & =40\\,{\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243028 :knowledge-point/_questions [{:knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa04db1a-e99c-5749-94e6-88155a2e98bd" :answer/type {:db/ident :answer.type/math} :answer/value "302\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243030} {:answer/id #uuid "08a5a31b-a83b-516d-966d-64b1029c4491" :answer/type {:db/ident :answer.type/math} :answer/value "286\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243031} {:answer/id #uuid "003a7090-fd03-5d1d-b08b-fea6622268b4" :answer/type {:db/ident :answer.type/math} :answer/value "274\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243032} {:answer/id #uuid "9affc390-41f3-5c35-a577-4c936322fb7c" :answer/type {:db/ident :answer.type/math} :answer/value "298\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243033} {:answer/id #uuid "cf89489f-8249-5812-962c-2d0f5ea5bd86" :answer/type {:db/ident :answer.type/math} :answer/value "264\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243034}] :answer-field/correct {:answer/id #uuid "9affc390-41f3-5c35-a577-4c936322fb7c" :answer/type {:db/ident :answer.type/math} :answer/value "298\\,{\\text{mm}}^{2}" :db/id #edb/ref 17592186243033} :answer-field/id #uuid "6bfbea19-b364-52b6-a407-de820d1e178f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243029}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e4c5c8b2-a316-5095-80a5-7c0b82a638cd" :question/math-academy-id "q-93339" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930500/assets/a60731e7df54bb8f18f834b818c3e49c79fb30e67f7ed50c40f40aa813689ece.png)\n\nA manufacturer produces an unfair tetrahedral die from a plastic net, shown above. What is the total surface area of the die?" :question/worked-solution "The net shown corresponds to a triangular pyramid. The surface area of our pyramid consists of $1$ base triangle and $3$ side triangles. \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =1\\times (\\text{Area of base})+3\\times (\\text{Area of side}) \\\\  & =1\\times 64+3\\times 78 \\\\  & =64+234 \\\\  & =298\\,{\\text{mm}}^{2}.\\end{aligned}\n$$"}]}
