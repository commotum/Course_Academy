#{[{:db/id #edb/ref 17592186059481 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/id #uuid "2b6e8845-a53d-510c-b44f-1b00271ee507" :question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A)$, if $\\begin{bmatrix}3 & 2 \\\\ 5 & 6\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}3 & 2 \\\\ 5 & 6\\end{vmatrix} \\\\\n&= 3 \\cdot 6 - 2 \\cdot 5 \\\\\n&= 18 - 10 \\\\\n&= 8\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059482 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/id #uuid "b066b73a-c777-550c-9c6e-af8093bf7fab" :question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A)$, if $\\begin{bmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{bmatrix}$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{vmatrix} \\\\\n&= \\sqrt{2} \\cdot \\sqrt{3} - (-2) \\cdot 0 \\\\\n&= \\sqrt{6}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059483 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n${A} = \\left\\lbrack \\matrix {2 & -1 \\ -3 & k} \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k$?" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\ndet(A) &= \\begin{vmatrix}2 & -1 \\\\ -3 & k\\end{vmatrix} \\\\\n&= 2 \\cdot k - (-1) \\cdot (-3) \\\\\n&= 2k - 3\n\\end{aligned}\n$$\n\nSince $\\det(A)=5$, we obtain:\n\n$$\n\\begin{aligned}\ndet(A) &= 5 \\\\\n2k - 3 &= 5 \\\\\n2k &= 8 \\\\\nk &= 4\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264420 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} {:answer/id #uuid "e4894c5e-9c7c-59e7-8403-c8d73cfeb131" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186264423} {:answer/id #uuid "c54b2bf8-0541-5a5f-96cf-e4e5d4a58dcd" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264424} {:answer/id #uuid "2af255c5-4f69-5f75-be7c-41116e8df588" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186264425} {:answer/id #uuid "fcd29854-4108-5324-9166-c6b1c9360708" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186264426}] :answer-field/correct {:answer/id #uuid "b1bd19d9-2d4c-5a5f-8e21-97be4390286c" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186264422} :answer-field/id #uuid "f834a283-9d4f-569a-aa6f-c125d3230257" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264421}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f27dd693-1931-5315-9ec0-4cfe813b59f1" :question/math-academy-id "q-1080" :question/problem "Calculate $\\text{det}(X)$, if\n    $X=[\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =|\\begin{aligned}10 & -3 \\\\ 1 & 4\\end{aligned}| \\\\  & =10\\cdot 4-(-3)\\cdot 1 \\\\  & =40-(-3) \\\\  & =43\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264427 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4418ee3e-0b55-5781-87e6-1583d73c3c2f" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186264429} {:answer/id #uuid "312a927f-d496-5ec9-a88a-d738fa2c60b7" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186264430} {:answer/id #uuid "022aaf36-ce5b-5a79-821e-e36aadc23a4c" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186264431} {:answer/id #uuid "a3d0b8a9-61cf-52a7-9f48-92fb880f3d79" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264432} {:answer/id #uuid "617658eb-d476-5413-88ff-2c6d370e6c37" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186264433}] :answer-field/correct {:answer/id #uuid "312a927f-d496-5ec9-a88a-d738fa2c60b7" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186264430} :answer-field/id #uuid "a2adf059-d80b-5217-8284-54674be3ed95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ada23d9-1d29-5166-a3e2-457c9b4d00d2" :question/math-academy-id "q-11646" :question/problem "Calculate $\\text{det}(L)$, if\n    $L=[\\begin{aligned}4 & 5 \\\\ -2 & 3\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(L) & =|\\begin{aligned}4 & 5 \\\\ -2 & 3\\end{aligned}| \\\\  & =4\\cdot 3-(-2)\\cdot 5 \\\\  & =12-(-10) \\\\  & =22\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264434 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "921e8a9b-c0c6-51d4-b874-fb7e89eb2f5c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264436} {:answer/id #uuid "9949ab44-4f44-526a-b579-47c6d9b6e7e5" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264437} {:answer/id #uuid "ea5ce6f5-236d-5577-afa1-da3c5efab0f0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264438} {:answer/id #uuid "8c6892db-5781-5a6a-8bd1-2287b174b8ce" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264439} {:answer/id #uuid "185c55d3-c326-5aea-9adb-2633dde5da92" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264440}] :answer-field/correct {:answer/id #uuid "921e8a9b-c0c6-51d4-b874-fb7e89eb2f5c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264436} :answer-field/id #uuid "35eb12e0-b2b7-592b-a54d-dc78d1e55930" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264435}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "38dbbfbb-e787-54d9-9e1c-5bb41d877f47" :question/math-academy-id "q-11653" :question/problem "If\n    $M=[\\begin{aligned}2 & w \\\\ 4 & 3\\end{aligned}]$\nand\n$\\text{det}(M)=2$, what is the value of $w?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =|\\begin{aligned}2 & w \\\\ 4 & 3\\end{aligned}| \\\\  & =2\\cdot 3-w\\cdot 4 \\\\  & =6-4w.\\end{aligned}\n$$\n\n    \n\nSince $det(M)=2$, we get:\n\n$$\n\\begin{aligned}det(M) & =2 \\\\ 6-4w & =2 \\\\ -4w & =2-6 \\\\ -4w & =-4 \\\\ w & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264441 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d1e446b-f2a0-565d-a7c1-524f722d0f5f" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186264443} {:answer/id #uuid "0444e9f1-f89f-5924-88ca-eb74f5a76da4" :answer/type {:db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186264444} {:answer/id #uuid "ab71dca6-6e4c-5780-b289-7b13aade87de" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186264445} {:answer/id #uuid "7ff43d3b-88dd-56a0-9b9b-ff75459f0690" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186264446} {:answer/id #uuid "c07cf75f-0eb8-5398-80d3-3040b4be28b6" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186264447}] :answer-field/correct {:answer/id #uuid "7ff43d3b-88dd-56a0-9b9b-ff75459f0690" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186264446} :answer-field/id #uuid "7e337a8c-be22-5dec-82ef-61f7732aa8cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264442}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c213d01-a70b-53c1-88c2-d0075b93bf9e" :question/math-academy-id "q-127578" :question/problem "$|\\begin{aligned}5 & -9 \\\\ -3 & 7\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -9 \\\\ -3 & 7\\end{aligned}| & =5\\cdot 7-(-9)\\cdot (-3) \\\\  & =35-27 \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264448 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d58a81a-a374-5361-a128-b2449498760d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186264450} {:answer/id #uuid "77590f99-5831-5a09-8c3a-7ac6096c7384" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{3}{2}" :db/id #edb/ref 17592186264451} {:answer/id #uuid "a5bfc3fd-9d89-5285-b49b-b6b59fa8c955" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264452} {:answer/id #uuid "b4da88e1-296a-58ff-9987-641751d7d244" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186264453} {:answer/id #uuid "7a8aa1bb-7e7e-5c0b-a277-1a361ffce1f6" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264454}] :answer-field/correct {:answer/id #uuid "a5bfc3fd-9d89-5285-b49b-b6b59fa8c955" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264452} :answer-field/id #uuid "ac21e419-ad99-52f5-aaef-1b357fb0b321" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264449}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8fd10968-7556-56c2-9450-91e6807cec19" :question/math-academy-id "q-127604" :question/problem "If\n    $U=[\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}]$\nand\n$\\text{det}(U)=-1$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =|\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}| \\\\  & =3\\cdot (-k+2)-(-5)\\cdot 2k \\\\  & =7k+6\\end{aligned}\n$$\n\nSince $det(U)=-1$, we get:\n\n$$\n\\begin{aligned}det(U) & =-1 \\\\ 7k+6 & =-1 \\\\ 7k & =-1-6 \\\\ 7k & =-7 \\\\ k & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264455 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b123e9-c64b-5ec8-92be-fae77597bfdf" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186264457} {:answer/id #uuid "b07abc1e-8401-52c3-b742-f5645ab11fde" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186264458} {:answer/id #uuid "d10076c8-a410-5a45-a81e-d6e6f74574f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264459} {:answer/id #uuid "ac6d5e2e-2fd7-51fc-991f-a5c12f612cf0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264460} {:answer/id #uuid "ac39fb97-ff60-54e9-95e7-093e71cdac90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186264461}] :answer-field/correct {:answer/id #uuid "d10076c8-a410-5a45-a81e-d6e6f74574f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264459} :answer-field/id #uuid "db26e4b6-6fc0-57a8-90ed-a0f70166b6ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264456}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "39d1c2d9-3c21-5e66-9ca6-fdd489e649b3" :question/math-academy-id "q-127607" :question/problem "If\n$P=[\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}]$\nand $det(P)=-9$, what is the value of $r?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(P) & =|\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}| \\\\  & =(r-3)\\cdot r-r\\cdot 3 \\\\  & ={r}^{2}-6r\\end{aligned}\n$$\n\nSince $det(P)=-9$, we obtain:\n\n$$\n\\begin{aligned}det(P) & =-9 \\\\ {r}^{2}-6r & =-9 \\\\ {r}^{2}-6r+9 & =0 \\\\ (r-3)^{2} & =0 \\\\ r & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264462 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "328a6596-8ab7-529a-9c1d-74f0fa65df48" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186264464}] :answer-field/correct {:answer/id #uuid "328a6596-8ab7-529a-9c1d-74f0fa65df48" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186264464} :answer-field/id #uuid "9581da08-1663-5be5-9e29-052a073088cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264463}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "36f8cf0a-2a1e-502d-a5af-48f80a2ff5e1" :question/math-academy-id "q-275595" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{aligned}|=$\n {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{aligned}| & =\\sqrt{3}\\cdot \\sqrt{3}-y\\cdot 2 \\\\  & =3-2y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264465 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06305b7b-b3b2-5d7a-8771-f52f72c3ce6f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264467} {:answer/id #uuid "f526d1f9-2ba6-5d44-9d75-186d092137c8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264468}] :answer-field/correct {:answer/id #uuid "f526d1f9-2ba6-5d44-9d75-186d092137c8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264468} :answer-field/id #uuid "fb7e30d8-94fb-59c4-8fdc-8aad00dc1f31" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264466}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5c5e5d66-ec9d-5044-ad73-c77116b673b4" :question/math-academy-id "q-275598" :question/problem "If\n    $C=[\\begin{aligned}1 & k \\\\ 4 & 6\\end{aligned}]$\nand\n$\\text{det}(C)=-14,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =|\\begin{aligned}1 & k \\\\ 4 & 6\\end{aligned}| \\\\  & =1\\cdot 6-k\\cdot 4 \\\\  & =6-4k.\\end{aligned}\n$$\n\nSince $det(C)=-14$, we get\n\n$$\n\\begin{aligned}det(C) & =-14 \\\\ 6-4k & =-14 \\\\ -4k & =-14-6 \\\\ -4k & =-20 \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264469 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b207fc-6102-500d-b8f7-9efc0529f154" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264471} {:answer/id #uuid "03e5b773-3b84-5980-91eb-d0d143a88973" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264472}] :answer-field/correct {:answer/id #uuid "f2b207fc-6102-500d-b8f7-9efc0529f154" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264471} :answer-field/id #uuid "4308871e-50d2-53f5-922e-ff5a2793695f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264470}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "875eb3e3-fc69-5562-b815-beb92eb0cf4d" :question/math-academy-id "q-275601" :question/problem "If\n$A=[\\begin{aligned}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{aligned}]$\nand $det(A)=7,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{aligned}| \\\\  & =(3+p)(5-p)-(4p-{p}^{2})\\cdot 1 \\\\  & =15-3p+5p-{p}^{2}-4p+{p}^{2} \\\\  & =15-2p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =15-2p.\\end{aligned}\n$$\n\nFinally, since $det(A)=7$, we obtain\n\n$$\n\\begin{aligned}det(A) & =7 \\\\ 15-2p & =7 \\\\ -2p & =-8 \\\\ p & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264473 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} {:answer/id #uuid "e0d5ff1f-31c3-570f-893f-adf43e8033de" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186264476}] :answer-field/correct {:answer/id #uuid "9ae0a43f-4a24-5c8c-9751-66e2c3806304" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186264475} :answer-field/id #uuid "12378f4c-0b12-5f63-930c-c04949c67a95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264474}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9d7ffc6-c6c4-5b96-90f8-c539ddd148a6" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$R=[\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}].$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =|\\begin{aligned}8 & -5 \\\\ 3 & 4\\end{aligned}| \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264477 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a95f1e3-9175-5362-b724-f167042f8117" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186264479} {:answer/id #uuid "41bc058a-763b-5c2e-863f-46c228763c87" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264480}] :answer-field/correct {:answer/id #uuid "41bc058a-763b-5c2e-863f-46c228763c87" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264480} :answer-field/id #uuid "eb1a65dc-78cb-5857-b6ed-da91571e6892" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b183b18c-6c90-5e7f-ba5b-79976c12c42f" :question/math-academy-id "q-317336" :question/problem "Calculate $det(S)$ given that\n$S=[\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}].$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2 & 4 \\\\ 1 & 3\\end{aligned}| \\\\  & =(2)(3)-(4)(1) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264481 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f36c7948-18b7-54c5-b13a-279894f0c0fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186264483} {:answer/id #uuid "40851764-fbe7-5355-ad9b-a183ae609e77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{10}" :db/id #edb/ref 17592186264484}] :answer-field/correct {:answer/id #uuid "f36c7948-18b7-54c5-b13a-279894f0c0fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186264483} :answer-field/id #uuid "2059530f-c1cf-5946-90cf-92510df047fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264482}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4303d5e5-45e5-500e-bd51-baaa5d0f753a" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$D=[\\begin{aligned}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{aligned}].$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{aligned}| \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264485 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e6c026d-69de-5c11-9c17-b25db6a4dae9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186264487} {:answer/id #uuid "d84e370e-eea2-507f-bcae-873b705ad5ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{4}" :db/id #edb/ref 17592186264488}] :answer-field/correct {:answer/id #uuid "6e6c026d-69de-5c11-9c17-b25db6a4dae9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186264487} :answer-field/id #uuid "06934394-b222-53f5-bedd-60d183dece90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "155b895e-9dc3-5f28-b61a-a6547f85ab4b" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$E=[\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}].$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =|\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}| \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264489 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "661ed604-fc38-5610-8d0a-75839dfcbaa7" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+10y" :db/id #edb/ref 17592186264491}] :answer-field/correct {:answer/id #uuid "661ed604-fc38-5610-8d0a-75839dfcbaa7" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2+10y" :db/id #edb/ref 17592186264491} :answer-field/id #uuid "570b9551-cc35-5441-ae59-94fd02944893" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ec791774-0f47-524b-8822-8346fd1d9cbb" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$D=[\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}].$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}| \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264492 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6178fdc7-a0d4-57f5-b9ef-d7242fe3ecaf" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186264494} {:answer/id #uuid "99ce2664-4dba-5875-8038-0049cda24d1a" :answer/type {:db/ident :answer.type/math} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186264495} {:answer/id #uuid "303762b6-f365-5eee-a8fe-20356bca1a54" :answer/type {:db/ident :answer.type/math} :answer/value "6ru-3st" :db/id #edb/ref 17592186264496} {:answer/id #uuid "4260c186-5eb8-566d-8374-e6a679c4c4b2" :answer/type {:db/ident :answer.type/math} :answer/value "-6ru+3st" :db/id #edb/ref 17592186264497} {:answer/id #uuid "e719a5fb-6526-5f30-a317-d01cb71caa8d" :answer/type {:db/ident :answer.type/math} :answer/value "6(ru-st)" :db/id #edb/ref 17592186264498}] :answer-field/correct {:answer/id #uuid "6178fdc7-a0d4-57f5-b9ef-d7242fe3ecaf" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186264494} :answer-field/id #uuid "894d93b0-8e49-59b3-84b1-eb8002b43e03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264493}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ac0ab71-3be4-537a-8f54-46f6fce91f2e" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n    $H=[\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =|\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}| \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"}]}
