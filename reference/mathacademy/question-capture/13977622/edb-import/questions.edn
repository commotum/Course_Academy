wer/value "36000" :db/id #edb/ref 17592186113158} {:answer/id #uuid "d3998ecb-9d96-51bb-a80c-b98dba07a111" :answer/type {:db/ident :answer.type/math} :answer/value "18000" :db/id #edb/ref 17592186113159} {:answer/id #uuid "1afc57e2-95e9-5005-8244-a42d7d643df9" :answer/type {:db/ident :answer.type/math} :answer/value "-18000" :db/id #edb/ref 17592186113160} {:answer/id #uuid "64c56874-5776-54fe-a57b-179c6f752f5e" :answer/type {:db/ident :answer.type/math} :answer/value "12000" :db/id #edb/ref 17592186113161}] :answer-field/correct {:answer/id #uuid "d3998ecb-9d96-51bb-a80c-b98dba07a111" :answer/type {:db/ident :answer.type/math} :answer/value "18000" :db/id #edb/ref 17592186113159} :answer-field/id #uuid "4e1aae67-1413-5c52-92c2-e130fc7ee0d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113156}] :question/id #uuid "20eb540b-84ee-5a09-81e9-e0f110dad1d7" :question/math-academy-id "q-29179" :question/problem "> A calculator is required to answer this question.\n\nGiven that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\sec x = 2$ for $-360^{∘} \\le x < 0^{∘}$, what is the numerical value of $x_{1} \\cdot x_{2}$?" :question/requires-calculator true}]}
