[{:db/id "q-6830/selection/10123b1ac1dc98d2d528c84da82e9be2736361abb6cdac898c127f3e9d0f5209" :answer/id #uuid "1ce20d2b-0525-5efb-94e4-e61d5a9b0a1c" :answer/type :answer.type/math :answer/value "y=4{x}^{2}-16,\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-6830/selection/3517a70966607fc4fa66e7224d21df446e5ce936b66f6f84b7af0886ddbe5b3b" :answer/id #uuid "22f0f42c-a010-5832-8b66-a14e02e4928b" :answer/type :answer.type/math :answer/value "y=2{x}^{2}+4,\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-6830/selection/a98f1471da6c8b7b1172cb769c29a992223192c4509d330582a9e371dcf64462" :answer/id #uuid "9a52558f-8f1c-5b00-8ba5-3d37066e9f5b" :answer/type :answer.type/math :answer/value "y=2{x}^{2}+8,\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-6830/selection/a1e86ca71a0558f08d2e889015c144cb38a585421ab7797204c51711b1b3ce7a" :answer/id #uuid "d369897d-2ac4-50d0-9a2b-2c7999cbd262" :answer/type :answer.type/math :answer/value "y=4{x}^{2}+8,\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-6830/selection/35427fac71337c40dca82e8ce7f25055a1ccb4a1a95b0af820b6fce3a8d50b21" :answer/id #uuid "434b7306-a7ea-510b-a7ee-4f88c52c66f5" :answer/type :answer.type/math :answer/value "y=2{x}^{2}-8,\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-6830/selection" :answer-field/id #uuid "e2daac1a-a539-562c-a441-e34cba65c3ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-6830/selection/a98f1471da6c8b7b1172cb769c29a992223192c4509d330582a9e371dcf64462" :answer-field/choices ["q-6830/selection/10123b1ac1dc98d2d528c84da82e9be2736361abb6cdac898c127f3e9d0f5209" "q-6830/selection/3517a70966607fc4fa66e7224d21df446e5ce936b66f6f84b7af0886ddbe5b3b" "q-6830/selection/a98f1471da6c8b7b1172cb769c29a992223192c4509d330582a9e371dcf64462" "q-6830/selection/a1e86ca71a0558f08d2e889015c144cb38a585421ab7797204c51711b1b3ce7a" "q-6830/selection/35427fac71337c40dca82e8ce7f25055a1ccb4a1a95b0af820b6fce3a8d50b21"] :db/ensure [:answer-field/validate]} {:db/id "q-6830" :question/id #uuid "4c02115b-ee53-598f-8c94-ffd8d53a4af5" :question/math-academy-id "q-6830" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\sqrt{{t}^{2}-4},\\,\\,\\,y=2{t}^{2},\\,t\\ge 2.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for ${t}^{2}:$\n\n$$\n\\begin{aligned}x=\\sqrt{{t}^{2}-4}\\,⇒\\,{t}^{2}={x}^{2}+4\\end{aligned}\n$$\n\nNow, substituting ${t}^{2}={x}^{2}+4$ into our expression for $y,$ we get\n\n$$\ny=2({x}^{2}+4)=2{x}^{2}+8\n$$\n\nSo the Cartesian equation of the given curve is $y=2{x}^{2}+8.$\n\nFinally, since $t\\ge 2.$ and $x=\\sqrt{{t}^{2}-4},$ we must have $x\\ge 0.$\n\nSo, the complete Cartesian equation is\n\n$$\ny=2{x}^{2}+8,\\,x\\ge 0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6830/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-6830"] :db/ensure [:knowledge-point/validate]} {:db/id "q-24574/selection/231d208f5e6bf12a92ec8467e53851d15c883f966d169da29973905546c6a617" :answer/id #uuid "7b94afa7-6522-56a9-8927-f7dac1bbe5b9" :answer/type :answer.type/math :answer/value "y=2(\\frac{{x}^{2}}{8}-1)" :db/ensure [:answer/validate]} {:db/id "q-24574/selection/796b0b09d8729175ee0cc2b28dc15b3991e8b64c84f5ac8925f9a1e3adfc533b" :answer/id #uuid "0ed902b0-8898-5dc9-a5da-1ed11561e15c" :answer/type :answer.type/math :answer/value "y=3(\\frac{{x}^{2}}{5}-1)" :db/ensure [:answer/validate]} {:db/id "q-24574/selection/ebfa1eff48dfdc7b8e2a5af6d33a74a754a9f56d5f89848b678185ae3b0869a6" :answer/id #uuid "43d6b6b9-93e2-537d-bf57-ea07b8468064" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{2}}{4}+1" :db/ensure [:answer/validate]} {:db/id "q-24574/selection/b0f4bf50c7019fff2419904c8a87767f03461769b654797a74f7f2893ede66e1" :answer/id #uuid "7fb3e46b-f073-5209-9715-96ae750ab40c" :answer/type :answer.type/math :answer/value "y=1-\\frac{{x}^{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-24574/selection/75d0b59906bb082ab7fb6d5e97007d28439afe72ba71c78af9df6ec202c859fc" :answer/id #uuid "b53b3003-8098-5f2f-93a2-c103ed233318" :answer/type :answer.type/math :answer/value "y=3{x}^{2}+8" :db/ensure [:answer/validate]} {:db/id "q-24574/selection" :answer-field/id #uuid "b21508f7-2e05-50c0-b19d-eab2a3362502" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-24574/selection/231d208f5e6bf12a92ec8467e53851d15c883f966d169da29973905546c6a617" :answer-field/choices ["q-24574/selection/231d208f5e6bf12a92ec8467e53851d15c883f966d169da29973905546c6a617" "q-24574/selection/796b0b09d8729175ee0cc2b28dc15b3991e8b64c84f5ac8925f9a1e3adfc533b" "q-24574/selection/ebfa1eff48dfdc7b8e2a5af6d33a74a754a9f56d5f89848b678185ae3b0869a6" "q-24574/selection/b0f4bf50c7019fff2419904c8a87767f03461769b654797a74f7f2893ede66e1" "q-24574/selection/75d0b59906bb082ab7fb6d5e97007d28439afe72ba71c78af9df6ec202c859fc"] :db/ensure [:answer-field/validate]} {:db/id "q-24574" :question/id #uuid "36736bcd-efb2-5212-8d19-2e9566214f4e" :question/math-academy-id "q-24574" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=4\\operatorname{cos}⁡t,\\,\\,\\,y=2\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=4\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{4} \\\\ y=2\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{2}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=\\frac{x}{4}$ and $\\operatorname{cos}⁡2t=\\frac{y}{2}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{2} & =2{(\\frac{x}{4})}^{2}-1 \\\\ \\frac{y}{2} & =2(\\frac{{x}^{2}}{16})-1 \\\\ \\frac{y}{2} & =\\frac{{x}^{2}}{8}-1 \\\\ y & =2(\\frac{{x}^{2}}{8}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=2(\\frac{{x}^{2}}{8}-1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-24574/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-24574"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102680/selection/3785e068f7cb0afaa580170fdd90ed9b8c5950ff0020a36f1634d36044028322" :answer/id #uuid "4d4ce40a-c8bd-52a9-8ca1-6ba24cc7a091" :answer/type :answer.type/math :answer/value "{x}^{2}+5{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-102680/selection/7474cea94cf029885fa8e1a591653cb6c8bf913d1d7d928c5ebde8fc979b1613" :answer/id #uuid "9e275085-0e4a-5583-b791-c7e2baf6af2b" :answer/type :answer.type/math :answer/value "{x}^{2}+(y+5)^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-102680/selection/5495a9cc475f69ee532d72e40726174e12b6b3f5667b999edd8ff2d5424d3950" :answer/id #uuid "e13fb946-64a9-5a65-a92c-0dd7d3de3fc6" :answer/type :answer.type/math :answer/value "(x+5)^{2}+(y+5)^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-102680/selection/05deed04f57e37360d8f41c7092f853e8f630f920efd9661c6fd043ab6f95c45" :answer/id #uuid "13b6bf5f-de6b-5a75-bf93-405ff7c79895" :answer/type :answer.type/math :answer/value "{x}^{2}+(y-5)^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-102680/selection/561dc7d3dce6462f7b91b669071aedc00a1291678f5bbe21dee83bf3e87010d6" :answer/id #uuid "9aec7d39-e939-5b26-b10f-fad087549190" :answer/type :answer.type/math :answer/value "(x-5)^{2}+{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-102680/selection" :answer-field/id #uuid "180c32c0-795e-5515-966d-d76b773245f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102680/selection/7474cea94cf029885fa8e1a591653cb6c8bf913d1d7d928c5ebde8fc979b1613" :answer-field/choices ["q-102680/selection/3785e068f7cb0afaa580170fdd90ed9b8c5950ff0020a36f1634d36044028322" "q-102680/selection/7474cea94cf029885fa8e1a591653cb6c8bf913d1d7d928c5ebde8fc979b1613" "q-102680/selection/5495a9cc475f69ee532d72e40726174e12b6b3f5667b999edd8ff2d5424d3950" "q-102680/selection/05deed04f57e37360d8f41c7092f853e8f630f920efd9661c6fd043ab6f95c45" "q-102680/selection/561dc7d3dce6462f7b91b669071aedc00a1291678f5bbe21dee83bf3e87010d6"] :db/ensure [:answer-field/validate]} {:db/id "q-102680" :question/id #uuid "41593654-f415-5a2c-93db-d22404043236" :question/math-academy-id "q-102680" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t,\\,\\,\\,y=\\operatorname{cos}⁡t-5,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=x \\\\ y=\\operatorname{cos}⁡t-5\\, & ⇒\\,\\operatorname{cos}⁡t=y+5\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n{x}^{2}+(y+5)^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is ${x}^{2}+(y+5)^{2}=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102680/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-102680"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276284/field-1/74bcc55b7b5704addf15b14d5d9e3fe9f96b52535a24a9455137f27dc230a448" :answer/id #uuid "7e0bedc1-52d5-552e-81e6-98df7a8ff781" :answer/type :answer.type/math :answer/value "\\frac{4x+1}{9x+2}" :db/ensure [:answer/validate]} {:db/id "q-276284/field-1/ebcfb35e7bbadf003bd8896c5ca690e348b415afa296e2a70f564bdc45c51db5" :answer/id #uuid "a320e021-72c0-5a3a-9617-98e85e4d657a" :answer/type :answer.type/math :answer/value "\\frac{4x+1}{9x+3}" :db/ensure [:answer/validate]} {:db/id "q-276284/field-1" :answer-field/id #uuid "cfd2ab57-be77-5f98-8816-290151d70b69" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276284/field-1/74bcc55b7b5704addf15b14d5d9e3fe9f96b52535a24a9455137f27dc230a448" :answer-field/choices ["q-276284/field-1/74bcc55b7b5704addf15b14d5d9e3fe9f96b52535a24a9455137f27dc230a448" "q-276284/field-1/ebcfb35e7bbadf003bd8896c5ca690e348b415afa296e2a70f564bdc45c51db5"] :db/ensure [:answer-field/validate]} {:db/id "q-276284/field-2/9420bd993686febbc7bab9cad06140d93534fa634008fa5d1a005fe09b5d559c" :answer/id #uuid "99eab99a-56a7-5bc4-8e46-c52757fda0f3" :answer/type :answer.type/math :answer/value "-\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-276284/field-2" :answer-field/id #uuid "d0e3dbbf-5944-520f-916c-a305e73a1f18" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276284/field-2/9420bd993686febbc7bab9cad06140d93534fa634008fa5d1a005fe09b5d559c" :answer-field/choices ["q-276284/field-2/9420bd993686febbc7bab9cad06140d93534fa634008fa5d1a005fe09b5d559c"] :db/ensure [:answer-field/validate]} {:db/id "q-276284" :question/id #uuid "309c7d82-5c17-5c66-8c6c-ddd74fbd88e2" :question/math-academy-id "q-276284" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{t-4},\\,\\,\\,y=\\frac{t}{2t+1},\\,t\\ne 4,\\,\\,\\,t\\ne -\\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}$,\\,\\,\\,x\\ne 0.$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{t-4}\\,⇒\\,t=\\frac{4x+1}{x}\n$$\n\nNow, substituting $t=\\frac{4x+1}{x}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{(\\frac{4x+1}{x})}{(2\\cdot \\frac{4x+1}{x}+1)} \\\\ y & =\\frac{(\\frac{4x+1}{x})}{(\\frac{8x+2}{x}+1)} \\\\ y & =\\frac{(\\frac{4x+1}{x})}{(\\frac{9x+2}{x})} \\\\ y & =\\frac{4x+1}{\\cancel{x}}\\cdot \\frac{\\cancel{x}}{9x+2} \\\\ y & =\\frac{4x+1}{9x+2}\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{4x+1}{9x+2}.$\n\nFinally, since $t\\ne -\\frac{1}{2}$ and $x=\\frac{1}{t-4}$ has range $x\\ne 0,$ we must have \n$x\\ne -\\frac{2}{9},\\text{ }0.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{4x+1}{9x+2},\\,x\\ne -\\frac{2}{9},\\,\\,\\,x\\ne 0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-276284/field-1" "q-276284/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-276284"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321314/field-1/221bbe4ca3c527677ad110d6ef50e5ce4fe00d7c166b4fe294520fbdbd936b06" :answer/id #uuid "9058db1a-9c53-57f5-944d-c26c19fe507b" :answer/type :answer.type/math :answer/value "6-\\frac{12}{25}x^2" :db/ensure [:answer/validate]} {:db/id "q-321314/field-1" :answer-field/id #uuid "8ae8d1d6-e209-5b42-8fa4-9c8a3205eef6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321314/field-1/221bbe4ca3c527677ad110d6ef50e5ce4fe00d7c166b4fe294520fbdbd936b06" :answer-field/choices ["q-321314/field-1/221bbe4ca3c527677ad110d6ef50e5ce4fe00d7c166b4fe294520fbdbd936b06"] :db/ensure [:answer-field/validate]} {:db/id "q-321314" :question/id #uuid "04d0e7b2-dd26-589b-9743-7a5468d31ccf" :question/math-academy-id "q-321314" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=5\\operatorname{cos}⁡t,\\,\\,\\,y=-6\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=5\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=\\frac{x}{5} \\\\ y=-6\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=-\\frac{y}{6}.\\end{aligned}\n$$\n\nNow, using the double-angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=\\frac{x}{5}$ and $\\operatorname{cos}⁡2t=-\\frac{y}{6}$ into this formula, we get\n\n$$\n\\begin{aligned}-\\frac{y}{6} & =2{(\\frac{x}{5})}^{2}-1 \\\\ -\\frac{y}{6} & =\\frac{2{x}^{2}}{25}-1 \\\\ y & =-6(\\frac{2{x}^{2}}{25}-1) \\\\ y & =-\\frac{12{x}^{2}}{25}+6.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=-\\frac{12{x}^{2}}{25}+6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-321314/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-321314"] :db/ensure [:knowledge-point/validate]}]
