#{[{:db/id #edb/ref 17592186304684 :knowledge-point/_questions [{:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7d017c2-e3ff-56d9-9334-9ac4fa843657" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}+4{x}^{2}-19x+30" :db/id #edb/ref 17592186304686} {:answer/id #uuid "3c61eea0-6b09-573a-b969-b636455c3741" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}+12{x}^{2}-38x-30" :db/id #edb/ref 17592186304687} {:answer/id #uuid "151c154c-d125-5381-9ace-152bee787a80" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}+12{x}^{2}+47x+60" :db/id #edb/ref 17592186304688} {:answer/id #uuid "e58c95f7-87e5-56a0-956d-88829d4e8f33" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}+12{x}^{2}+19x+60" :db/id #edb/ref 17592186304689} {:answer/id #uuid "1ceb7ee0-935f-5b83-9144-6119f5574980" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}-12{x}^{2}-47x-60" :db/id #edb/ref 17592186304690}] :answer-field/correct {:answer/id #uuid "1ceb7ee0-935f-5b83-9144-6119f5574980" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{3}-12{x}^{2}-47x-60" :db/id #edb/ref 17592186304690} :answer-field/id #uuid "753ec0e2-b325-5183-8e84-914a8d2e5340" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304685}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5046e0c1-2f8b-58f5-a21d-913e91899338" :question/math-academy-id "q-104467" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=-5,$ ${x}_{2}=-4,$ and ${x}_{3}=-3,$ and the coefficient of the cubic term is $-1.$ Find $P(x).$" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=-5,$ ${x}_{1}=-4,$ and ${x}_{3}=-3,$ and the coefficient of the cubic term is $a=-1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =-1(x-(-5))(x-(-4))(x-(-3)) \\\\  & =-(x+5)(x+4)(x+3)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-(x+5)(x+4)(x+3) & =-({x}^{2}+9x+20)(x+3) \\\\  & =-({x}^{3}+3{x}^{2}+9{x}^{2}+27x+20x+60) \\\\  & =-{x}^{3}-12{x}^{2}-47x-60.\\end{aligned}\n$$\n\nTherefore, $P(x)=-{x}^{3}-12{x}^{2}-47x-60.$"}] [{:db/id #edb/ref 17592186349365 :knowledge-point/_questions [{:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03" :knowledge-point/title "Finding a Cubic Polynomial Given One Real Root, Two Complex Roots, and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a452fa5-62a5-5134-98d9-60a2b660c183" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}-15{x}^{2}-27x-135" :db/id #edb/ref 17592186349367} {:answer/id #uuid "a7d63e91-fbea-59ab-8a62-0ec54f31eb0d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+27x+135" :db/id #edb/ref 17592186349368} {:answer/id #uuid "0ea7cbfa-12a4-5282-8081-001e4d5c494a" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+5{x}^{2}+27x-45" :db/id #edb/ref 17592186349369} {:answer/id #uuid "5bc0cd64-fa7a-5451-b312-4274ac904b73" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}-5{x}^{2}-9x+70" :db/id #edb/ref 17592186349370} {:answer/id #uuid "d5b14b46-8de5-58ab-85b8-a53b7786468d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+18x+45" :db/id #edb/ref 17592186349371}] :answer-field/correct {:answer/id #uuid "a7d63e91-fbea-59ab-8a62-0ec54f31eb0d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}+15{x}^{2}+27x+135" :db/id #edb/ref 17592186349368} :answer-field/id #uuid "add77e9f-1fc2-5826-8f5e-485eed64598e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349366}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9170fbba-1982-59c3-8508-b90dfbe3f341" :question/math-academy-id "q-104487" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-5,{x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $3.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-5$ and ${x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =3(x-(-5))(x-3\\text{i})(x-(-3\\text{i})) \\\\  & =3(x+5)(x-3\\text{i})(x+3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+5)(x-3\\text{i})(x+3\\text{i}) & = \\\\ 3(x+5)({x}^{2}-(3\\text{i})^{2}) & = \\\\ 3(x+5)({x}^{2}+9) & = \\\\ 3({x}^{3}+9x+5{x}^{2}+45) & = \\\\ 3{x}^{3}+15{x}^{2}+27x+135 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{3}+15{x}^{2}+27x+135.$"}] [{:db/id #edb/ref 17592186349372 :knowledge-point/_questions [{:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7ac35b6-ca94-5ea0-8476-77701e2673b1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349374}] :answer-field/correct {:answer/id #uuid "f7ac35b6-ca94-5ea0-8476-77701e2673b1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349374} :answer-field/id #uuid "93f53fae-08ec-55d7-bc22-60cad6d1af91" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349373} {:answer-field/choices [{:answer/id #uuid "d234abcf-e8be-509f-87df-85e2280bf138" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186349376}] :answer-field/correct {:answer/id #uuid "d234abcf-e8be-509f-87df-85e2280bf138" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186349376} :answer-field/id #uuid "d343c30b-5b80-5e31-9362-9d13b1da7a48" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349375} {:answer-field/choices [{:answer/id #uuid "9fe962bc-9074-5166-95aa-9aac57d19ad5" :answer/type {:db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186349378}] :answer-field/correct {:answer/id #uuid "9fe962bc-9074-5166-95aa-9aac57d19ad5" :answer/type {:db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186349378} :answer-field/id #uuid "eea84a9f-7c67-55a4-a767-7a950da3df8b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349377} {:answer-field/choices [{:answer/id #uuid "3b0cae8e-cb41-559a-9e32-bd7dab35e1a9" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186349380}] :answer-field/correct {:answer/id #uuid "3b0cae8e-cb41-559a-9e32-bd7dab35e1a9" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186349380} :answer-field/id #uuid "bcc32998-72fa-53a5-aefd-c3ef58f317f6" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349379}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef8fa624-35e8-5857-85ad-f8bc134682e7" :question/math-academy-id "q-275173" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}={x}_{2}=3,{x}_{3}=4,$ and the coefficient of the cubic term is $2.$ Find $P(x).$\n\n$P(x)=$\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,-$\n{{field-4}}" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=3,$ ${x}_{2}=3,$ and ${x}_{3}=4,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-3)(x-3)(x-4)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x-3)(x-3)(x-4) & =2({x}^{2}-6x+9)(x-4) \\\\  & =2({x}^{3}-4{x}^{2}-6{x}^{2}+24x+9x-36) \\\\  & =2({x}^{3}-10{x}^{2}+33x-36) \\\\  & =2{x}^{3}-20{x}^{2}+66x-72.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-20{x}^{2}+66x-72.$"}] [{:db/id #edb/ref 17592186349381 :knowledge-point/_questions [{:knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e09d4ea0-ea16-5134-9f75-9ef0ccfd2276" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186349383} {:answer/id #uuid "d382bb22-1fc7-5299-b26d-dae99accb4d6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349384}] :answer-field/correct {:answer/id #uuid "e09d4ea0-ea16-5134-9f75-9ef0ccfd2276" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186349383} :answer-field/id #uuid "67b3ae0e-24ac-5ad5-b028-05b035374677" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349382} {:answer-field/choices [{:answer/id #uuid "c8f553d9-ddf4-5f85-88f9-b3a2048a40ee" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349386}] :answer-field/correct {:answer/id #uuid "c8f553d9-ddf4-5f85-88f9-b3a2048a40ee" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186349386} :answer-field/id #uuid "5fe193b5-cddc-572c-8003-0a71022d7ceb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349385} {:answer-field/choices [{:answer/id #uuid "59a16685-f194-5eb6-bf89-5f805a024de4" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186349388}] :answer-field/correct {:answer/id #uuid "59a16685-f194-5eb6-bf89-5f805a024de4" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186349388} :answer-field/id #uuid "557cd397-3847-5557-bf1a-6aff77e0a108" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349387} {:answer-field/choices [{:answer/id #uuid "23efe088-dc51-5b62-a7a8-f2cee9f4b713" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186349390}] :answer-field/correct {:answer/id #uuid "23efe088-dc51-5b62-a7a8-f2cee9f4b713" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186349390} :answer-field/id #uuid "5cfc8895-90fa-521c-b1b4-ba6b0db748d0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349389}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "895764df-0dac-5f6c-8455-f03cf4d8e10f" :question/math-academy-id "q-316635" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=5,{x}_{2}={x}_{3}=-2,$ and the coefficient of the cubic term is $-4.$ Find $P(x).$\n\n$P(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "Since our cubic polynomial has roots ${x}_{1}=5$ and ${x}_{2}={x}_{3}=-2,$ and the coefficient of the cubic term is $a=-4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =-4(x-5)(x-(-2))(x-(-2)) \\\\  & =-4(x-5)(x+2)(x+2)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-4(x-5)(x+2)(x+2) & =-4(x-5)({x}^{2}+4x+4) \\\\  & =-4({x}^{3}+4{x}^{2}+4x-5{x}^{2}-20x-20) \\\\  & =-4({x}^{3}-{x}^{2}-16x-20) \\\\  & =-4{x}^{3}+4{x}^{2}+64x+80.\\end{aligned}\n$$\n\nTherefore, $P(x)=-4{x}^{3}+4{x}^{2}+64x+80.$"}] [{:db/id #edb/ref 17592186330960 :knowledge-point/_questions [{:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03" :knowledge-point/title "Finding a Cubic Polynomial Given One Real Root, Two Complex Roots, and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d3d8e8c-7015-514a-83d5-689d89928164" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186330962}] :answer-field/correct {:answer/id #uuid "5d3d8e8c-7015-514a-83d5-689d89928164" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186330962} :answer-field/id #uuid "71eec172-b52c-5418-b4c8-f8193b53a4fa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330961} {:answer-field/choices [{:answer/id #uuid "1907cff1-d30a-5b75-824e-0f4eeed40d3c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186330964}] :answer-field/correct {:answer/id #uuid "1907cff1-d30a-5b75-824e-0f4eeed40d3c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186330964} :answer-field/id #uuid "93924ffb-a290-5db3-a9aa-c4a3471f00b8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330963} {:answer-field/choices [{:answer/id #uuid "4be33203-eb3d-5b59-b741-3172d9bd920c" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186330966}] :answer-field/correct {:answer/id #uuid "4be33203-eb3d-5b59-b741-3172d9bd920c" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186330966} :answer-field/id #uuid "f2d8b4fb-dea8-5833-96e3-217d302463fc" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330965}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d1df841d-233d-5571-b2fe-b548c0a2b431" :question/math-academy-id "q-316725" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14065074/assets/dd92f4b41c95c436027cce015b688df1a982f46913b0ea262f2d30e1e49259d5.png)\n\nThe Argand diagram above shows the roots of the cubic polynomial $f(x).$ Find $f(x)$ given that the coefficient of the cubic term is $-2.$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,-$\n{{field-2}}$x\\,+$\n{{field-3}}" :question/worked-solution "From the diagram, we see that $f(x)$ has roots ${x}_{1}=2$ and ${x}_{2,3}=-1\\pm 3\\text{i}.$ Additionally, we're given that the coefficient of the cubic term is $a=-2.$ Therefore, we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-2(x-2)(x-(-1+3\\text{i}))(x-(-1-3\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-2(x-2)(x-(-1+3\\text{i}))(x-(-1-3\\text{i})) & = \\\\ -2(x-2)({x}^{2}-x(-1-3\\text{i})-x(-1+3\\text{i})+(-1+3\\text{i})(-1-3\\text{i})) & = \\\\ -2(x-2)({x}^{2}+2x+10) & = \\\\ -2({x}^{3}+2{x}^{2}+10x-2{x}^{2}-4x-20) & = \\\\ -2({x}^{3}+6x-20) & = \\\\ -2{x}^{3}-12x+40 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=-2{x}^{3}-12x+40.$"}]}
