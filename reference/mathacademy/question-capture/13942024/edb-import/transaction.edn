name{ln}⁡(9)-3\\operatorname{ln}⁡(2) \\\\ x & =\\frac{8\\operatorname{ln}⁡(9)-3\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(2)+5\\operatorname{ln}⁡(9)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-100472/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-100472"] :db/ensure [:knowledge-point/validate]}]
