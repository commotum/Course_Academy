={8}^{1-6x} \\\\ \\operatorname{ln}⁡({3}^{2x}) & =\\operatorname{ln}⁡({8}^{1-6x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3) & =\\operatorname{ln}⁡(8)-6x\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3)+6x\\operatorname{ln}⁡(8) & =\\operatorname{ln}⁡(8) \\\\ 2x(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8)) & =\\operatorname{ln}⁡(8) \\\\ x & =\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-242923/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-242923"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100471/selection/2a340ea9753c37eacc217effcf73cec8996cc3d90e035a7f55a88a8c949391f8" :answer/id #uuid "4595fedc-25f7-57f2-a34c-c7c330f1d7d3" :answer/type :answer.type/math :answer/value "\\frac{6\\operatorname{ln}⁡(3)+5\\operatorname{ln}⁡(7)}{\\operatorname{ln}⁡(7)-\\operatorname{ln}⁡(3)}" :db/ensure [:answer/validate]} {:db/id "q-100471/selection/85104f145093be27cffaa7e4732dafbc1ce927a4198dec4f19bb457d431160a4" :answer/id #uuid "1eb77a6c-56e4-503c-a9ab-a187512f6a1a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(7)}" :db/ensure [:answer/validate]} {:db/id "q-100471/selection/e15cca1df82f0fcfa2aad37ca93f176d143c5df5f85409a73eeee301c1abf569" :answer/id #uuid "a703d74c-6bd8-5632-9e33-bff6ac948185" :answer/type :answer.type/math :answer/value "\\frac{6\\operatorname{ln}⁡(7)\\operatorname{ln}⁡(3)}{\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(7)}" :db/ensure [:answer/validate]} {:db/id "q-100471/selection/29ab77a9fcbf9e68228d4d069c1f204a60cf6df1226b771ff8c673d4d8e23ecc" :answer/id #uuid "d0407ab3-02ee-5e73-8d86-bbe7c19dd12a" :answer/type :answer.type/math :answer/value "\\frac{6\\operatorname{ln}⁡(7)-5\\operatorname{ln}⁡(3)}{\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(7)}" :db/ensure [:answer/validate]} {:db/id "q-100471/selection/cd3cc0c3572c3ef7345caf523804cdf398cbe1715790e87af13408e1cbb1da0f" :answer/id #uuid "7d3d6897-5649-5960-b6ae-2b6a01ec1396" :answer/type :answer.type/math :answer/value "\\frac{1}{6\\operatorname{ln}⁡(7)-5\\operatorname{ln}⁡(3)}" :db/ensure [:answer/validate]} {:db/id "q-100471/selection" :answer-field/id #uuid "c979e788-3ee6-5ed6-84ca-e4c387d73cb9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-100471/selection/29ab77a9fcbf9e68228d4d069c1f204a60cf6df1226b771ff8c673d4d8e23ecc" :answer-field/choices ["q-100471/selection/2a340ea9753c37eacc217effcf73cec8996cc3d90e035a7f55a88a8c949391f8" "q-100471/selection/85104f145093be27cffaa7e4732dafbc1ce927a4198dec4f19bb457d431160a4" "q-100471/selection/e15cca1df82f0fcfa2aad37ca93f176d143c5df5f85409a73eeee301c1abf569" "q-100471/selection/29ab77a9fcbf9e68228d4d069c1f204a60cf6df1226b771ff8c673d4d8e23ecc" "q-100471/selection/cd3cc0c3572c3ef7345caf523804cdf398cbe1715790e87af13408e1cbb1da0f"] :db/ensure [:answer-field/validate]} {:db/id "q-100471" :question/id #uuid "dcbfd20b-f656-5999-870b-b45683d40339" :question/math-academy-id "q-100471" :question/problem "Find the solution of ${3}^{x+5}={7}^{6-2x}.$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{3}^{x+5} & ={7}^{6-2x} \\\\ \\operatorname{ln}⁡({3}^{x+5}) & =\\operatorname{ln}⁡({7}^{6-2x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives:\n\n$$\n\\begin{aligned}(x+5)\\operatorname{ln}⁡(3) & =(6-2x)\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(x+5)\\operatorname{ln}⁡(3) & =(6-2x)\\operatorname{ln}⁡(7) \\\\ x\\operatorname{ln}⁡(3)+5\\operatorname{ln}⁡(3) & =6\\operatorname{ln}⁡(7)-2x\\operatorname{ln}⁡(7) \\\\ x\\operatorname{ln}⁡(3)+2x\\operatorname{ln}⁡(7) & =6\\operatorname{ln}⁡(7)-5\\operatorname{ln}⁡(3) \\\\ x(\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(7)) & =6\\operatorname{ln}⁡(7)-5\\operatorname{ln}⁡(3) \\\\ x & =\\frac{6\\operatorname{ln}⁡(7)-5\\operatorname{ln}⁡(3)}{\\operatorname{ln}⁡(3)+2\\operatorname{ln}⁡(7)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-100471/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-100471"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100482/selection/efd8b8400daf63ed860dd510117941494d11de884a2e7533ab8d54935fc66c69" :answer/id #uuid "bbfc6fac-cdab-5eb8-85fe-89d2a89c6a26" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(4)+4\\operatorname{ln}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-100482/selection/22e4db60ac63fccc51b1ca3ecad1886f9122444d161a960e3b357f53fbcc8b30" :answer/id #uuid "cf8e4434-1802-5c8e-be31-df2b56fba857" :answer/type :answer.type/math :answer/value "-\\frac{8\\operatorname{ln}⁡(5)+\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(4)+2\\operatorname{ln}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-100482/selection/49295480458e9ffc5990f7f339d40dc7eea45b5f23483ec4b342f8a2566b167f" :answer/id #uuid "2c37f8d7-1d47-5d1d-a8cc-1e51da99f877" :answer/type :answer.type/math :answer/value "\\frac{1}{8\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(4)}" :db/ensure [:answer/validate]} {:db/id "q-100482/selection/c1fca701e930058a0c04338bc56d29ca67e03147d076f14853fa70c2bd703efb" :answer/id #uuid "55f0cc8f-4beb-5dc5-81ef-3d5b824e306e" :answer/type :answer.type/math :answer/value "\\frac{8\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(4)-4\\operatorname{ln}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-100482/selection/f8a002339e9da64e8dd6fe5015c7122feee1b96ce9c8535b8dc6f26432e66129" :answer/id #uuid "c539139d-2c41-58be-b2fc-7910e236a7fc" :answer/type :answer.type/math :answer/value "\\frac{8\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(4)+4\\operatorname{ln}⁡(5)}" :db/ensure [:answer/validate]} {:db/id "q-100482/selection" :answer-field/id #uuid "d2283c37-fc3d-5c24-b59a-65e299a2cd14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-100482/selection/f8a002339e9da64e8dd6fe5015c7122feee1b96ce9c8535b8dc6f26432e66129" :answer-field/choices ["q-100482/selection/efd8b8400daf63ed860dd510117941494d11de884a2e7533ab8d54935fc66c69" "q-100482/selection/22e4db60ac63fccc51b1ca3ecad1886f9122444d161a960e3b357f53fbcc8b30" "q-100482/selection/49295480458e9ffc5990f7f339d40dc7eea45b5f23483ec4b342f8a2566b167f" "q-100482/selection/c1fca701e930058a0c04338bc56d29ca67e03147d076f14853fa70c2bd703efb" "q-100482/selection/f8a002339e9da64e8dd6fe5015c7122feee1b96ce9c8535b8dc6f26432e66129"] :db/ensure [:answer-field/validate]} {:db/id "q-100482" :question/id #uuid "386df23c-8f42-53d4-b137-e274cd1470c7" :question/math-academy-id "q-100482" :question/problem "Find the solution of ${4}^{x+7}={5}^{8-4x}.$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{4}^{x+7} & ={5}^{8-4x} \\\\ \\operatorname{ln}⁡({4}^{x+7}) & =\\operatorname{ln}⁡({5}^{8-4x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives:\n\n$$\n\\begin{aligned}(x+7)\\operatorname{ln}⁡(4) & =(8-4x)\\operatorname{ln}⁡(5)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(x+7)\\operatorname{ln}⁡(4) & =(8-4x)\\operatorname{ln}⁡(5) \\\\ x\\operatorname{ln}⁡(4)+7\\operatorname{ln}⁡(4) & =8\\operatorname{ln}⁡(5)-4x\\operatorname{ln}⁡(5) \\\\ x\\operatorname{ln}⁡(4)+4x\\operatorname{ln}⁡(5) & =8\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(4) \\\\ x(\\operatorname{ln}⁡(4)+4\\operatorname{ln}⁡(5)) & =8\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(4) \\\\ x & =\\frac{8\\operatorname{ln}⁡(5)-7\\operatorname{ln}⁡(4)}{\\operatorname{ln}⁡(4)+4\\operatorname{ln}⁡(5)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-100482/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e"] :knowledge-point/questions ["q-100482"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100472/selection/cbed55f421092df821767a932e1afdf2e756dabad4a1bc9f6253f1fd1905266b" :answer/id #uuid "5b6ee712-c984-505d-808e-d3afdc8368f4" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(2)+5\\operatorname{ln}⁡(9)}" :db/ensure [:answer/validate]} {:db/id "q-100472/selection/d664aad506bfbbd7993a6231056ca95845ac490661e273c330cf4568a24e6a5d" :answer/id #uuid "1c4a6c1a-5b52-51fb-9858-5a4f8e73cbf9" :answer/type :answer.type/math :answer/value "\\frac{8\\operatorname{ln}⁡(9)-\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(2)-3\\operatorname{ln}⁡(9)}" :db/ensure [:answer/validate]} {:db/id "q-100472/selection/070e17253f3ad08597f6e1bb3a9e29c4715c889d18bb311d1634e77c19f3c2e5" :answer/id #uuid "9d94a2bf-774e-5bec-9091-2d8a83f64dcc" :answer/type :answer.type/math :answer/value "\\frac{8\\operatorname{ln}⁡(9)-3\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(2)+5\\operatorname{ln}⁡(9)}" :db/ensure [:answer/validate]} {:db/id "q-100472/selection/d2039d1015840a8c431765163b2f0006ce9f190915a6a5ef9d2fc7220f032c38" :answer/id #uuid "ea307155-4fd8-54bd-8c6f-5c6e48687f3a" :answer/type :answer.type/math :answer/value "\\frac{8\\operatorname{ln}⁡(9)+\\operatorname{ln}⁡(2)}{\\operatorname{ln}⁡(9)-5\\operatorname{ln}⁡(2)}" :db/ensure [:answer/validate]} {:db/id "q-100472/selection/7fa26e3022f1873e9347f895f0e7c45491d3f17b