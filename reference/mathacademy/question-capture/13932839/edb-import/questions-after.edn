))^{2}+(2-(-3))^{2}+(-8-(-3))^{2}] \\\\  & =\\frac{1}{6}[0+16+4+4+25+25] \\\\  & =\\frac{74}{6} \\\\  & =\\frac{37}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245797 :knowledge-point/_questions [{:knowledge-point/id #uuid "7eab4249-544e-56c6-81c0-e6db84033701" :knowledge-point/title "Computing the Variance Given the Number, Sum, and Sum of Squares of the Data Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "664bcbe0-72a0-54f5-a7b9-61ab654fbded" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186245799} {:answer/id #uuid "e1102d5e-1b15-5722-b01b-e54ca95ad5fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{44}{3}" :db/id #edb/ref 17592186245800} {:answer/id #uuid "512397ed-691d-50ee-b8c4-103d47f28e97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{51}{3}" :db/id #edb/ref 17592186245801} {:answer/id #uuid "177fb8b7-581b-5c38-bb0f-c6f75c112a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{3}" :db/id #edb/ref 17592186245802} {:answer/id #uuid "41f41b40-94bd-5a8d-9c68-9c73965dddfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{3}" :db/id #edb/ref 17592186245803}] :answer-field/correct {:answer/id #uuid "177fb8b7-581b-5c38-bb0f-c6f75c112a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35}{3}" :db/id #edb/ref 17592186245802} :answer-field/id #uuid "fadf5811-c1c9-5e96-9ca8-d1c216556f64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245798}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de0bbf5f-f549-5d46-99ea-43143f517a2d" :question/is-example false :question/math-academy-id "q-87603" :question/problem "Compute the variance ${\\sigma }^{2}$ of a data set ${x}_{i}$ consisting of $12$ data points, where \n\n$$\n{\\sum }_{i=1}^{12}{x}_{i}=-60,\\,{\\sum }_{i=1}^{12}{x}_{i}^{2}=440.\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=12$ points in our data set, and we know that ${\\sum }_{i=1}^{12}{x}_{i}=-60,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{12}{\\sum }_{i=1}^{12}{x}_{i} \\\\  & =\\frac{1}{12}\\cdot (-60) \\\\  & =-5.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ We know that ${\\sum }_{i=1}^{12}{x}_{i}^{2}=440,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{12}{\\sum }_{i=1}^{12}{x}_{i}^{2} \\\\  & =\\frac{1}{12}\\cdot 440 \\\\  & =\\frac{440}{12} \\\\  & =\\frac{110}{3}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{110}{3}-{(-5)}^{2} \\\\  & =\\frac{110}{3}-25 \\\\  & =\\frac{110-75}{3} \\\\  & =\\frac{35}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245804 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0040fc1-2134-5eaa-a3e8-6c7a457f75f5" :knowledge-point/title "Computing the Variance of a Data Set Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aef423aa-d4cf-5185-8131-da00d9c76644" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186245806} {:answer/id #uuid "caa70d3e-9100-5d90-ae5d-9a9ed196158c" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186245807} {:answer/id #uuid "bcac49a7-5980-5e58-8f59-09ba13427453" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186245808} {:answer/id #uuid "55d349d8-c6d6-5291-820b-d002c7b0ca45" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186245809} {:answer/id #uuid "5d2768e6-883d-58ae-b92f-4e98ae66afc4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245810}] :answer-field/correct {:answer/id #uuid "55d349d8-c6d6-5291-820b-d002c7b0ca45" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186245809} :answer-field/id #uuid "307598f0-9438-506d-b7a4-410fe10987e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245805}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b59c9228-d1ed-5c8c-bb4e-3d374c95e95e" :question/is-example false :question/math-academy-id "q-87608" :question/problem "What is the variance of the following data set?\n\n$$\n-9,\\,0,\\,2,\\,-7,\\,-6\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (-9+0+2-7-6) \\\\  & =\\frac{1}{5}\\cdot (-20) \\\\  & =-4.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot [(-9)^{2}+{0}^{2}+{2}^{2}+(-7)^{2}+(-6)^{2}] \\\\  & =\\frac{1}{5}\\cdot [81+0+4+49+36] \\\\  & =\\frac{1}{5}\\cdot 170 \\\\  & =34.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =34-{(-4)}^{2} \\\\  & =34-16 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245811 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0040fc1-2134-5eaa-a3e8-6c7a457f75f5" :knowledge-point/title "Computing the Variance of a Data Set Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "392ab0a5-8a6d-5dd3-acbe-48912977e91d" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186245813} {:answer/id #uuid "de475755-78d3-51eb-9d9d-35d900721c4d" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186245814} {:answer/id #uuid "7c218d9c-fa83-56c5-8192-9ed2e4a48037" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186245815} {:answer/id #uuid "719a8ba0-942d-53de-afeb-cf9020cc7dc1" :answer/type {:db/ident :answer.type/math} :answer/value "256" :db/id #edb/ref 17592186245816} {:answer/id #uuid "460a9598-1d71-526c-a1db-feee98fcc1a7" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186245817}] :answer-field/correct {:answer/id #uuid "460a9598-1d71-526c-a1db-feee98fcc1a7" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186245817} :answer-field/id #uuid "149ee3cd-6802-59e5-8287-d1c76d733a09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245812}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4061cb5d-fcad-540e-a760-716773606372" :question/is-example false :question/math-academy-id "q-87610" :question/problem "What is the variance of the following data set?\n\n$$\n-5,\\,-1,\\,0,\\,-8,\\,7,\\,0,\\,9,\\,6\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=8$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{8}\\cdot (-5-1+0-8+7+0+9+6) \\\\  & =\\frac{1}{8}\\cdot 8 \\\\  & =1.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{8}\\cdot [(-5)^{2}+(-1)^{2}+{0}^{2}+(-8)^{2}+{7}^{2}+{0}^{2}+{9}^{2}+{6}^{2}] \\\\  & =\\frac{1}{8}\\cdot [25+1+0+64+49+0+81+36] \\\\  & =\\frac{1}{8}\\cdot 256 \\\\  & =32.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =32-{(1)}^{2} \\\\  & =32-1 \\\\  & =31.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245818 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6403f13-3c56-5747-9edb-51158f6aee65" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{97}{7}}" :db/id #edb/ref 17592186245820} {:answer/id #uuid "6aebbcec-030f-5b67-8f5a-864f4202ace2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186245821} {:answer/id #uuid "40d53c4e-80b3-5f93-b1fe-44be00b87971" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{55}{7}}" :db/id #edb/ref 17592186245822} {:answer/id #uuid "436e60b8-f27b-5a33-927b-ddd25e9dbb77" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{87}{7}}" :db/id #edb/ref 17592186245823} {:answer/id #uuid "7a309274-d688-5812-918b-e31de7d35d65" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{31}{7}}" :db/id #edb/ref 17592186245824}] :answer-field/correct {:answer/id #uuid "6aebbcec-030f-5b67-8f5a-864f4202ace2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186245821} :answer-field/id #uuid "53e74cce-ec78-529f-b9e0-f954d4fa434f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245819}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1f5630b6-d898-5cd0-95d6-84de620c0d81" :question/is-example false :question/math-academy-id "q-87612" :question/problem "What is the standard deviation of the following data set?\n\n$$\n7,\\,3,\\,3,\\,5,\\,1,\\,0,\\,2\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=7$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{7}\\cdot (7+3+3+5+1+0+2) \\\\  & =\\frac{1}{7}\\cdot 21 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{7}\\cdot ({7}^{2}+{3}^{2}+{3}^{2}+{5}^{2}+{1}^{2}+{0}^{2}+{2}^{2}) \\\\  & =\\frac{1}{7}\\cdot (49+9+9+25+1+0+4) \\\\  & =\\frac{97}{7}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{97}{7}-{(3)}^{2} \\\\  & =\\frac{97}{7}-9 \\\\  & =\\frac{97-63}{7} \\\\  & =\\frac{34}{7}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{34}{7}}.\n$$"}] [{:db/id #edb/ref 17592186245825 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9354f757-9558-5710-be71-54b54fede24b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{41}{5}}" :db/id #edb/ref 17592186245827} {:answer/id #uuid "eb0e4148-90fe-5940-9fab-2efc98c6a815" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{37}{5}}" :db/id #edb/ref 17592186245828} {:answer/id #uuid "99b5b8b3-6fb0-5bab-9c5a-69e68b850b43" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{124}{5}}" :db/id #edb/ref 17592186245829} {:answer/id #uuid "8eef4b8e-0904-5b62-9d7e-34edbd0c11ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{48}{5}}" :db/id #edb/ref 17592186245830} {:answer/id #uuid "978bef72-41a7-5b7d-9707-11ed6d01c37b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186245831}] :answer-field/correct {:answer/id #uuid "978bef72-41a7-5b7d-9707-11ed6d01c37b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186245831} :answer-field/id #uuid "33269fb3-5f15-50bd-8e63-58556d492883" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245826}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bf070cf1-a397-5b2f-9008-de124285adfc" :question/is-example false :question/math-academy-id "q-87613" :question/problem "What is the standard deviation of the following data set?\n\n$$\n1,\\,1,\\,5,\\,4,\\,9\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (1+1+5+4+9) \\\\  & =\\frac{1}{5}\\cdot 20 \\\\  & =4.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot ({1}^{2}+{1}^{2}+{5}^{2}+{4}^{2}+{9}^{2}) \\\\  & =\\frac{1}{5}\\cdot (1+1+25+16+81) \\\\  & =\\frac{124}{5}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{124}{5}-{(4)}^{2} \\\\  & =\\frac{124}{5}-16 \\\\  & =\\frac{124-80}{5} \\\\  & =\\frac{44}{5}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{44}{5}}.\n$$"}] [{:db/id #edb/ref 17592186245832 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffdb430-329e-5d51-af0c-7f4ae5a7d15b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{109}{5}}" :db/id #edb/ref 17592186245834} {:answer/id #uuid "adc5d415-7131-52d2-93ee-434904944882" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{5}}{5}" :db/id #edb/ref 17592186245835} {:answer/id #uuid "bfc51cc0-f315-5f70-9e1d-8f12f8527e51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{5}}{5}" :db/id #edb/ref 17592186245836} {:answer/id #uuid "408a5766-e87c-51ad-a7f8-6281d12009e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{66}{5}}" :db/id #edb/ref 17592186245837} {:answer/id #uuid "60806b9e-0d9a-5b73-ae8e-cea6dbb9ed12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{5}}{5}" :db/id #edb/ref 17592186245838}] :answer-field/correct {:answer/id #uuid "bfc51cc0-f315-5f70-9e1d-8f12f8527e51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{5}}{5}" :db/id #edb/ref 17592186245836} :answer-field/id #uuid "e2a8c42d-ae30-54ec-94f9-bb50d4198e00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245833}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f9294266-cc49-5b09-ab07-a7b115d05d2a" :question/is-example false :question/math-academy-id "q-87615" :question/problem "What is the standard deviation of the following data set?\n\n$$\n-7,\\,3,\\,-5,\\,-1,\\,-5\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (-7+3-5-1-5) \\\\  & =\\frac{1}{5}\\cdot (-15) \\\\  & =-3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot [(-7)^{2}+{3}^{2}+(-5)^{2}+(-1)^{2}+(-5)^{2}] \\\\  & =\\frac{1}{5}\\cdot [49+9+25+1+25] \\\\  & =\\frac{109}{5}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{109}{5}-{(-3)}^{2} \\\\  & =\\frac{109}{5}-9 \\\\  & =\\frac{109-45}{5} \\\\  & =\\frac{64}{5}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\begin{aligned}\\sigma  & =\\sqrt{{\\sigma }^{2}} \\\\  & =\\sqrt{\\frac{64}{5}} \\\\  & =\\frac{8}{\\sqrt{5}} \\\\  & =\\frac{8\\sqrt{5}}{5}.\\end{aligned}\n$$"}]}
