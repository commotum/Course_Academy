^{2}}=\\sqrt{\\frac{44}{5}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87613/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753"] :knowledge-point/questions ["q-87613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-166585/selection/7336f16cf9437bd809ce5e09d7dc666eb175d0cf5c31ff077c77f0542ed57f13" :answer/id #uuid "1abb5f15-8c52-5b2c-b7ee-3c17ad5462dd" :answer/type :answer.type/math :answer/value "\\sqrt{13}" :db/ensure [:answer/validate]} {:db/id "q-166585/selection/a6cab3f6dbb33082c107600934275072abdbbd0726744ed78389ef6be6d019f6" :answer/id #uuid "62b96511-4b8c-53be-b569-3be44b7da380" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{31}{5}}" :db/ensure [:answer/validate]} {:db/id "q-166585/selection/f00d8b7a5eeed0dcaa02b7f16c350647a90a461726a760f9ecdf0379dbf8fa63" :answer/id #uuid "37b8b58c-28d6-5f47-9bb5-479d139a3047" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-166585/selection/d4751c0cf142b0ebe9c3be19387262fc13b2fb0ae8d33113491ec8ed33ec3141" :answer/id #uuid "e0a6a367-e882-5e36-8d66-792cb2b30b69" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{46}{5}}" :db/ensure [:answer/validate]} {:db/id "q-166585/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "1d267a77-677c-5074-a988-8dba8e441b0e" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-166585/selection" :answer-field/id #uuid "ad856cf7-9175-504f-852b-e2f333b6ba6c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-166585/selection/d4751c0cf142b0ebe9c3be19387262fc13b2fb0ae8d33113491ec8ed33ec3141" :answer-field/choices ["q-166585/selection/7336f16cf9437bd809ce5e09d7dc666eb175d0cf5c31ff077c77f0542ed57f13" "q-166585/selection/a6cab3f6dbb33082c107600934275072abdbbd0726744ed78389ef6be6d019f6" "