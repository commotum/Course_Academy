 & =-14.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ We know that ${\\sum }_{i=1}^{8}{x}_{i}^{2}=1736,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{8}{\\sum }_{i=1}^{8}{x}_{i}^{2} \\\\  & =\\frac{1}{8}\\cdot 1736 \\\\  & =217.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =217-{(-14)}^{2} \\\\  & =217-196 \\\\  & =21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-263343/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7eab4249-544e-56c6-81c0-e6db84033701"] :knowledge-point/questions ["q-263343"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263301/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "4ffd3ed0-e971-5edb-8457-712a850039d8" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-263301/field-1" :answer-field/id #uuid "b13fe170-c190-5efc-a199-be13be238598" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263301/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer-field/choices ["q-263301/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8"] :db/ensure [:answer-field/validate]} {:db/id "q-263301" :question/id #uuid "c6ac209e-57e0-5a4e-a63e-ea34749b87d1" :question/math-academy-id "q-263301" :question/is-example false :question/problem "Compute the variance ${\\sigma }^{2}$ of a data set ${x}_{i}$ consisting of $8$ data points, where\n\n$$\n{\\sum }_{i=1}^{8}{x}_{i}=64,\\,{\\sum }_{i=1}^{8}{x}_{i}^{2}=768.\n$$\n\n${\\sigma }^{2}=$\n{{field-1}}" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=8$ points in our data set, and we know that ${\\sum }_{i=1}^{8}{x}_{i}=64,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{8}{\\sum }_{i=1}^{8}{x}_{i} \\\\  & =\\frac{1}{8}\\cdot (64) \\\\  & =8.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ We know that ${\\sum }_{i=1}^{8}{x}_{i}^{2}=768,$ so we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{8}{\\sum }_{i=1}^{8}{x}_{i}^{2} \\\\  & =\\frac{1}{8}\\cdot 768 \\\\  & =96.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =96-{(8)}^{2} \\\\  & =96-64 \\\\  & =32.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-263301/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7eab4249-544e-56c6-81c0-e6db84033701"] :knowledge-point/questions ["q-263301"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263447/field-1/281b9df7937adad53cef1402cfcc31a6361b789c47210abf3e8b18b39908145a" :answer/id #uuid "b1d26837-310e-58f0-a029-890e34a7b8af" :answer/type :answer.type/math :answer/value "\\frac{415}{4}" :db/ensure [:answer/validate]} {:db/id "q-263447/field-1" :answer-field/id #uuid "47fdbeaf-5c35-5b80-80f9-04308a3c6ea9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263447/field-1/281b9df7937adad53cef1402cfcc31a6361b789c47210abf3e8b18b39908145a" :answer-field/choices ["q-263447/field-1/281b9df7937adad53cef1402cfcc31a6361b789c47210abf3e8b18b39908145a"] :db/ensure [:answer-field/validate]} {:db/id "q-263447" :question/id #uuid "60280ea3-ddd0-5a95-9e4a-e5f69d56d7f4" :question/math-academy-id "q-263447" :question/is-example false :question/problem "What is the variance of the following data set?\n\n$$\n-12,\\,1,\\,-7,\\,9,\\,7,\\,13,\\,-12,\\,-15\n$$\n\nDo not round your answer.\n\n${\\sigma }^{2}=$\n{{field-1}}" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=8$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{8}\\cdot (-12+1-7+9+7+13-12-15) \\\\  & =\\frac{1}{8}\\cdot (-16) \\\\  & =-2.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{8}\\cdot ((-12)^{2}+{1}^{2}+(-7)^{2}+{9}^{2}+{7}^{2}+{13}^{2}+(-12)^{2}+(-15)^{2}) \\\\  & =\\frac{1}{8}\\cdot (144+1+49+81+49+169+144+225) \\\\  & =\\frac{1}{8}\\cdot 862 \\\\  & =\\frac{862}{8} \\\\  & =\\frac{431}{4}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{431}{4}-{(-2)}^{2} \\\\  & =\\frac{431}{4}-4 \\\\  & =\\frac{431-16}{4} \\\\  & =\\frac{415}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-263447/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0040fc1-2134-5eaa-a3e8-6c7a457f75f5"] :knowledge-point/questions ["q-263447"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263435/field-1/3f494917f676999e1eebb7c0498996a265e06aec5bc45789c27efdf8ff929335" :answer/id #