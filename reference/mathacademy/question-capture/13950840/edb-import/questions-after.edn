#{[{:db/id #edb/ref 17592186087469 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "cb2860c1-8ed6-5c0c-8f43-c1ba75225c02" :knowledge-point/title "Finding the Complex Conjugate of a Complex Number With Positive Imaginary Part"}] :question/id #uuid "87d0e252-58bf-5003-b160-9c92bdc608b2" :question/math-academy-id "e-5247" :question/problem "What is the complex conjugate of $z=3+6\\textrm{i}$?" :question/worked-solution "To find the complex conjugate, we flip the sign of the imaginary part.\n\nIn the given number\n\n$$\nz=3+6\\textrm{i}\n$$\n\nthe imaginary part is $6\\textrm{i}$. Flipping the sign, we get $-6\\textrm{i}$.\n\nTherefore, the complex conjugate is given by\n\n$$\n\\overline{z} = 3-6\\textrm{i}\n$$"}] [{:db/id #edb/ref 17592186087470 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0adde8fd-26c3-52f5-9864-5e96641a8b63" :knowledge-point/title "Finding the Complex Conjugate of a Complex Number With Negative Imaginary Part"}] :question/id #uuid "300b7e27-c9b3-59e2-abf1-aaa46814f80f" :question/math-academy-id "e-5248" :question/problem "What is the complex conjugate of $z=-4-6\\textrm{i}$?" :question/worked-solution "To find the complex conjugate, we flip the sign of the imaginary part.\n\nIn the given number\n\n$$\nz=-4-6\\textrm{i}\n$$\n\nthe imaginary part is $-6\\textrm{i}$. Flipping the sign, we get $6\\textrm{i}$.\n\nTherefore, the complex conjugate is given by\n\n$$\n\\overline{z} = -4+6\\textrm{i}\n$$"}] [{:db/id #edb/ref 17592186087471 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "65535fce-8a5f-58b4-8a13-400d811bbd26" :knowledge-point/title "Finding the Complex Conjugate of an Imaginary Number"}] :question/id #uuid "ff59b172-f67d-524c-9c7b-a1a529b1186d" :question/math-academy-id "e-5249" :question/problem "What is the complex conjugate of $z=7\\textrm{i}$?" :question/worked-solution "To find the complex conjugate, we flip the sign of the imaginary part.\n\nIn the given number\n\n$$\nz=7\\textrm{i}\n$$\n\nthe imaginary part is $7\\textrm{i}$ (there is no real part, just an imaginary part). Flipping the sign, we get $-7\\textrm{i}$.\n\nTherefore, the complex conjugate is given by\n\n$$\n\\overline{z} = -7\\textrm{i}\n$$"}] [{:db/id #edb/ref 17592186087472 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e6efb5f8-86df-5825-9645-9017d942899d" :knowledge-point/title "Finding the Complex Conjugate of a Real Number"}] :question/id #uuid "8dbe5267-9c33-5e1a-9f3d-e12972d57743" :question/math-academy-id "e-5250" :question/problem "What is the complex conjugate of $z=-6$?" :question/worked-solution "The number $z=-6$ is a real number, and the complex conjugate of any real number is just the number itself.\n\nSo here, the complex conjugate is\n\n$$\n\\overline{z} = z = -6\n$$"}] [{:db/id #edb/ref 17592186087974 :knowledge-point/_questions [{:knowledge-point/id #uuid "0adde8fd-26c3-52f5-9864-5e96641a8b63" :knowledge-point/title "Finding the Complex Conjugate of a Complex Number With Negative Imaginary Part"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8d9f852-2b4b-5922-98c9-5853bc35b7bd" :answer/type {:db/ident :answer.type/math} :answer/value "z^(―) = 2 + 3\\textrm{i}" :db/id #edb/ref 17592186084856} {:answer/id #uuid "cd68c165-e23a-58b8-9ae8-6f5201ed6991" :answer/type {:db/ident :answer.type/math} :answer/value "z^(―) =-2 + 3\\textrm{i}" :db/id #edb/ref 17592186084857} {:answer/id #uuid "5b9bcf1b-e157-5a73-8161-a3e8fd40f665" :answer/type {:db/ident :answer.type/math} :answer/value "z^(―) = 2 - 3\\textrm{i}" :db/id #edb/ref 17592186084858} {:answer/id #uuid "5cc4f756-2247-56d9-bcbd-5eea190863fd" :answer/type {:db/ident :answer.type/math} :answer/value "z^(―) =-2 - 3\\textrm{i}" :db/id #edb/ref 17592186084859} {:answer/id #uuid "69c34e5f-d46c-5861-825d-1dd64db363ab" :answer/type {:db/ident :answer.type/math} :answer/value "z^(―) = \\frac{1}{2 - 3\\textrm{i}}" :db/id #edb/ref 17592186084860}] :answer-field/correct {:answer/id #uuid "a8