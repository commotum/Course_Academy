#{[{:db/id #edb/ref 17592186347721 :knowledge-point/_questions [{:knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8" :knowledge-point/title "Integrating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d81a6a-c181-537d-a961-fa8020325bc5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{t+1},\\,-4\\operatorname{cos}⁡(3t)⟩+C" :db/id #edb/ref 17592186347723} {:answer/id #uuid "4aeedef3-75c1-5ba0-b55f-0580f364c910" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{3t},\\,3\\operatorname{sin}⁡(4t)⟩+C" :db/id #edb/ref 17592186347724} {:answer/id #uuid "302d4f57-97ec-54bb-b2e7-cb1539f6f5f4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{t+1},\\,4\\operatorname{cos}⁡(3t)⟩+C" :db/id #edb/ref 17592186347725} {:answer/id #uuid "e3aa1818-e4e7-5c6f-97c0-c202791b7d7a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{t-1},\\,-4\\operatorname{cos}⁡(3t)⟩+C" :db/id #edb/ref 17592186347726} {:answer/id #uuid "643d4235-fe2a-5067-8e7c-c1c81d3bc507" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{t},\\,-4\\operatorname{cos}⁡t⟩+C" :db/id #edb/ref 17592186347727}] :answer-field/correct {:answer/id #uuid "21d81a6a-c181-537d-a961-fa8020325bc5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{t+1},\\,-4\\operatorname{cos}⁡(3t)⟩+C" :db/id #edb/ref 17592186347723} :answer-field/id #uuid "748165c9-e9ef-5229-8cc7-2d5dc972ce8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347722}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ae9740d6-44f0-50b4-8094-5aec220611bd" :question/math-academy-id "q-123435" :question/problem "Find $\\int ⟨{e}^{t+1},\\,12\\operatorname{sin}⁡(3t)⟩\\,\\text{d}t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t+1},\\,12\\operatorname{sin}⁡(3t)⟩\\text{d}t=⟨\\int {e}^{t+1}\\,\\text{d}t,\\,\\int 12\\operatorname{sin}⁡(3t)\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)={e}^{t+1},$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int {e}^{t+1}\\text{d}t={e}^{t+1}+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=12\\operatorname{sin}⁡(3t),$ we calculate its integral using substitution. So, we let $u=3t.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=3\\,⟹\\,\\text{d}t=\\frac{1}{3}\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 12\\operatorname{sin}⁡(3t)\\,\\text{d}t \\\\  & =\\int 12\\operatorname{sin}⁡u\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{12}{3}\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =4(-\\operatorname{cos}⁡u)+{c}_{2} \\\\  & =-4\\operatorname{cos}⁡(3t)+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t+1},\\,12\\operatorname{sin}⁡(3t)⟩\\text{d}t & =⟨{e}^{t+1}+{c}_{1},\\,-4\\operatorname{cos}⁡(3t)+{c}_{2}⟩ \\\\  & =⟨{e}^{t+1},\\,-4\\operatorname{cos}⁡(3t)⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t+1},\\,-4\\operatorname{cos}⁡(3t)⟩+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186347728 :knowledge-point/_questions [{:knowledge-point/id #uuid "53fca396-4ade-5180-9c9b-a73f24f5b5b8" :knowledge-point/title "Integrating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4e371f2-60bb-58cd-a297-df8554ebd10f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4\\operatorname{sin}⁡(t),\\,{e}^{t-1}⟩+C" :db/id #edb/ref 17592186347730} {:answer/id #uuid "afc924f9-d777-5b34-8376-c280a6938f86" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4\\operatorname{cos}⁡(4t),\\,(t-1){e}^{t-1}⟩+C" :db/id #edb/ref 17592186347731} {:answer/id #uuid "5acbc104-ce25-5e12-8606-3bd2bdf673b1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8\\operatorname{cos}⁡(\\frac{t}{4}),\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186347732} {:answer/id #uuid "a97f4408-8e22-58c3-82e8-cb54939afe47" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8\\operatorname{sin}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩+C" :db/id #edb/ref 17592186347733} {:answer/id #uuid "b186173f-82e8-521f-aec7-439a4de5e036" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8\\operatorname{cos}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩+C" :db/id #edb/ref 17592186347734}] :answer-field/correct {:answer/id #uuid "b186173f-82e8-521f-aec7-439a4de5e036" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8\\operatorname{cos}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩+C" :db/id #edb/ref 17592186347734} :answer-field/id #uuid "34631f09-fd89-5a00-996a-25cf1cee1140" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347729}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "53bd3a98-c5a9-50e2-9a0c-9c6d9fc4a3f4" :question/math-academy-id "q-123438" :question/problem "Find $\\int ⟨2\\operatorname{sin}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩\\,\\text{d}t.$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨2\\operatorname{sin}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩\\text{d}t=⟨\\int 2\\operatorname{sin}⁡(\\frac{t}{4})\\,\\text{d}t,\\,\\int {e}^{t-1}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)=2\\operatorname{sin}⁡(\\frac{t}{4}),$ we calculate its integral using substitution. So, we let $u=\\frac{t}{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=\\frac{1}{4}\\,⟹\\,\\text{d}t=4\\,\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t & =\\int 2\\operatorname{sin}⁡(\\frac{t}{4})\\,\\text{d}t \\\\  & =\\int 2\\operatorname{sin}⁡u\\cdot 4\\text{d}u \\\\  & =8\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =8(-\\operatorname{cos}⁡u)+{c}_{1} \\\\  & =-8\\operatorname{cos}⁡(\\frac{t}{4})+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)={e}^{t-1},$ we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t=\\int {e}^{t-1}\\text{d}t={e}^{t-1}+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\int ⟨2\\operatorname{sin}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩\\text{d}t & =⟨-8\\operatorname{cos}⁡(\\frac{t}{4})+{c}_{1},\\,{e}^{t-1}+{c}_{2}⟩ \\\\  & =⟨-8\\operatorname{cos}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-8\\operatorname{cos}⁡(\\frac{t}{4}),\\,{e}^{t-1}⟩+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186347735 :knowledge-point/_questions [{:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f" :knowledge-point/title "Finding the Definite Integral of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4b79f6-2a0e-56e7-a3dc-cf08da2ed808" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\frac{4}{3})" :db/id #edb/ref 17592186347737} {:answer/id #uuid "d3c18101-7b84-5d9f-87ea-61425edb9ffc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186347738}] :answer-field/correct {:answer/id #uuid "ef4b79f6-2a0e-56e7-a3dc-cf08da2ed808" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\frac{4}{3})" :db/id #edb/ref 17592186347737} :answer-field/id #uuid "27743efa-ff2c-511b-8c8f-a70142bb6cbf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186347736} {:answer-field/choices [{:answer/id #uuid "2e371808-48dc-57ca-a575-08e8b286b602" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186347740}] :answer-field/correct {:answer/id #uuid "2e371808-48dc-57ca-a575-08e8b286b602" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186347740} :answer-field/id #uuid "7a03a3b8-178b-5974-9fa8-b8781e810cd6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186347739}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eda8ba15-b3ac-5012-8eb1-39f51ec5e92c" :question/math-academy-id "q-349111" :question/problem "Evaluate the following integral of a vector-valued function. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}⟨\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}⟨\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t & =⟨{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t}\\,\\text{d}t,\\,{\\int }_{0}^{\\pi /3}4\\operatorname{sin}⁡t\\,\\text{d}t⟩\\end{aligned}\n$$\n\nFor the first component, let $u=2+\\operatorname{sec}⁡t$, so $\\text{d}u=\\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t.$ Then\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t}\\,\\text{d}t & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡(2+\\operatorname{sec}⁡t).\\end{aligned}\n$$\n\nFor the second component, we integrate directly:\n\n$$\n\\int 4\\operatorname{sin}⁡t\\,\\text{d}t=-4\\operatorname{cos}⁡t\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}⟨\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t & =⟨\\operatorname{ln}⁡(2+\\operatorname{sec}⁡t){|}_{0}^{\\pi /3},\\,-4\\operatorname{cos}⁡t{|}_{0}^{\\pi /3}⟩ \\\\  & =⟨\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(3),\\,-4\\,(\\frac{1}{2}-1)⟩ \\\\  & =⟨ln\\,(\\frac{4}{3}),\\,2⟩ \\\\  & =⟨ln\\,(\\frac{4}{3}),\\,2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186347741 :knowledge-point/_questions [{:knowledge-point/id #uuid "8dd18a5b-d7a1-5590-ae70-f47ff5b464b1" :knowledge-point/title "Finding the Antiderivative of a Vector-Valued Function That Satisfies a Given Initial Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3162d22b-0690-5157-8a6d-c0205a3b2f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{-t}+3" :db/id #edb/ref 17592186347743}] :answer-field/correct {:answer/id #uuid "3162d22b-0690-5157-8a6d-c0205a3b2f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{-t}+3" :db/id #edb/ref 17592186347743} :answer-field/id #uuid "07d9e588-62c4-59f4-8664-77763004fe06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186347742} {:answer-field/choices [{:answer/id #uuid "7b9df6a5-a988-5c39-bad5-001540f474a2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^3-2t-4" :db/id #edb/ref 17592186347745}] :answer-field/correct {:answer/id #uuid "7b9df6a5-a988-5c39-bad5-001540f474a2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^3-2t-4" :db/id #edb/ref 17592186347745} :answer-field/id #uuid "7af77894-a863-5f95-88d1-caf0b8d43662" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186347744}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2e9e3108-2328-5f57-9874-50475f372469" :question/math-academy-id "q-349375" :question/problem "Find $F(t)$ given that \n\n$$\n{F}^{′}(t)=⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\n$$\n\n and $F(0)=⟨1,\\,-4⟩.$\n\n$F(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\\text{d}t & =⟨\\int 2{e}^{-t}\\,\\text{d}t,\\int 6{t}^{2}-2\\,\\text{d}t⟩ \\\\  & =⟨-2{e}^{-t}+{c}_{1},\\,2{t}^{3}-2t+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $F(0)=⟨1,\\,-4⟩$ gives\n\n$$\n\\begin{aligned}F(0)=⟨-2{e}^{0}+{c}_{1},\\,2(0)^{3}-2(0)+{c}_{2}⟩ & =⟨1,\\,-4⟩ \\\\ ⟨-2+{c}_{1},\\,0+{c}_{2}⟩ & =⟨1,\\,-4⟩.\\end{aligned}\n$$\n\nTherefore, ${c}_{1}=3$ and ${c}_{2}=-4.$ Consequently\n\n$$\nF(t)=⟨-2{e}^{-t}+3,\\,2{t}^{3}-2t-4⟩.\n$$"}] [{:db/id #edb/ref 17592186347746 :knowledge-point/_questions [{:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f" :knowledge-point/title "Finding the Definite Integral of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8a5489d-99b0-5191-8789-eaa98bc8c668" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e-2,\\,\\operatorname{cos}⁡1⟩" :db/id #edb/ref 17592186347748} {:answer/id #uuid "62fa83fd-61ee-5f0d-8a79-c4332a8602f0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2e-2,\\,\\operatorname{sin}⁡1⟩" :db/id #edb/ref 17592186347749} {:answer/id #uuid "dbe3eddf-32d0-5224-af66-2ab3c9a941b8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{2}+1,\\,-\\operatorname{sin}⁡2⟩" :db/id #edb/ref 17592186347750} {:answer/id #uuid "380c2e7a-278c-572f-94dd-fc552d805233" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{2}-e,\\,1⟩" :db/id #edb/ref 17592186347751} {:answer/id #uuid "13161d33-8b65-5de0-9ebf-1be9ddc2ec77" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{e}^{2},\\,\\operatorname{sin}⁡2⟩" :db/id #edb/ref 17592186347752}] :answer-field/correct {:answer/id #uuid "62fa83fd-61ee-5f0d-8a79-c4332a8602f0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2e-2,\\,\\operatorname{sin}⁡1⟩" :db/id #edb/ref 17592186347749} :answer-field/id #uuid "b4c7b944-f73c-53f2-bc9e-eee56988a61a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347747}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ed6c8ff2-9373-55e7-924d-bdb8515b0668" :question/math-academy-id "q-99286" :question/problem "${\\int }_{0}^{1}⟨2{e}^{t},\\,\\operatorname{cos}⁡t⟩\\,\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each componentt separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}⟨2{e}^{t},\\,\\operatorname{cos}⁡t⟩\\,\\text{d}t & =⟨{\\int }_{0}^{1}2{e}^{t}\\,\\text{d}t,{\\int }_{0}^{1}\\operatorname{cos}⁡t\\,\\text{d}t⟩ \\\\  & =⟨(2{e}^{t}){|}_{0}^{1},\\,\\operatorname{sin}⁡t\\,{|}_{0}^{1}⟩ \\\\  & =⟨2{e}^{1}-2{e}^{0},\\,\\operatorname{sin}⁡1-\\operatorname{sin}⁡0⟩ \\\\  & =⟨2e-2,\\,\\operatorname{sin}⁡1⟩\\end{aligned}\n$$"}]}
