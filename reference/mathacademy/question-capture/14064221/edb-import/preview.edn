n}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" 13194139535408 true] [17592186347735 1113 #uuid "eda8ba15-b3ac-5012-8eb1-39f51ec5e92c" 13194139535408 true] [17592186347735 1145 "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}⟨\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t & =⟨{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t}\\,\\text{d}t,\\,{\\int }_{0}^{\\pi /3}4\\operatorname{sin}⁡t\\,\\text{d}t⟩\\end{aligned}\n$$\n\nFor the first component, let $u=2+\\operatorname{sec}⁡t$, so $\\text{d}u=\\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t.$ Then\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t}\\,\\text{d}t & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡(2+\\operatorname{sec}⁡t).\\end{aligned}\n$$\n\nFor the second component, we integrate directly:\n\n$$\n\\int 4\\operatorname{sin}⁡t\\,\\text{d}t=-4\\operatorname{cos}⁡t\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}⟨\\frac{\\operatorname{sec}⁡t\\operatorname{tan}⁡t}{2+\\operatorname{sec}⁡t},\\,4\\operatorname{sin}⁡t⟩\\,\\text{d}t & =⟨\\operatorname{ln}⁡(2+\\operatorname{sec}⁡t){|}_{0}^{\\pi /3},\\,-4\\operatorname{cos}⁡t{|}_{0}^{\\pi /3}⟩ \\\\  & =⟨\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(3),\\,-4\\,(\\frac{1}{2}-1)⟩ \\\\  & =⟨ln\\,(\\frac{4}{3}),\\,2⟩ \\\\  & =⟨ln\\,(\\frac{4}{3}),\\,2⟩.\\end{aligned}\n$$" 13194139535408 true] [17592186347736 1000 #edb/ref 17592186347737 13194139535408 true] [17592186347736 1000 #edb/ref 17592186347738 13194139535408 true] [17592186347736 1040 #edb/ref 17592186045449 13194139535408 true] [17592186347736 1041 "field-1" 13194139535408 true] [17592186347736 1104 #edb/ref 17592186347737 13194139535408 true] [17592186347736 1110 #uuid "27743efa-ff2c-511b-8c8f-a70142bb6cbf" 13194139535408 true] [17592186347737 1034 "\\ln(\\frac{4}{3})" 13194139535408 true] [17592186347737 1103 #edb/ref 17592186045453 13194139535408 true] [17592186347737 1111 #uuid "ef4b79f6-2a0e-56e7-a3dc-cf08da2ed808" 13194139535408 true] [17592186347738 1034 "0" 13194139535408 true] [17592186347738 1103 #edb/ref 17592186045453 13194139535408 true] [17592186347738 1111 #uuid "d3c18101-7b84-5d9f-87ea-61425edb9ffc" 13194139535408 true] [17592186347739 1000 #edb/ref 17592186347740 13194139535408 true] [17592186347739 1040 #edb/ref 17592186045449 13194139535408 true] [17592186347739 1041 "field-2" 13194139535408 true] [17592186347739 1104 #edb/ref 17592186347740 13194139535408 true] [17592186347739 1110 #uuid "7a03a3b8-178b-5974-9fa8-b8781e810cd6" 13194139535408 true] [17592186347740 1034 "2" 13194139535408 true] [17592186347740 1103 #edb/ref 17592186045453 13194139535408 true] [17592186347740 1111 #uuid "2e371808-48dc-57ca-a575-08e8b286b602" 13194139535408 true] [17592186347741 1017 #edb/ref 17592186347742 13194139535408 true] [17592186347741 1017 #edb/ref 17592186347744 13194139535408 true] [17592186347741 1089 "q-349375" 13194139535408 true] [17592186347741 1091 #edb/ref 17592186045465 13194139535408 true] [17592186347741 1100 "Find $F(t)$ given that \n\n$$\n{F}^{′}(t)=⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\n$$\n\n and $F(0)=⟨1,\\,-4⟩.$\n\n$F(t)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" 13194139535408 true] [17592186347741 1113 #uuid "2e9e3108-2328-5f57-9874-50475f372469" 13194139535408 true] [17592186347741 1145 "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨2{e}^{-t}\\,,6{t}^{2}-2⟩\\text{d}t & =⟨\\int 2{e}^{-t}\\,\\text{d}t,\\int 6{t}^{2}-2\\,\\text{d}t⟩ \\\\  & =⟨-2{e}^{-t}+{c}_{1},\\,2{t}^{3}-2t+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $F(0)=⟨1,\\,-4⟩$ gives\n\n$