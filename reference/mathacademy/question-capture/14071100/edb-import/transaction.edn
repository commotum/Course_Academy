4/selection/3675b225254712999e31f65e4ebeda48747689f16ef8e392010fd19e7c4bf428" "q-129124/selection/30d66b60a83727db1b22338bd643140f279877242fb9224c6981d7a1551b1ec3" "q-129124/selection/1e7f2a8c913cb5a196330b5d66238b8c0031fd566321f89d07f895735f6e06c2" "q-129124/selection/ca8a9a35aec93860aaf14f34af9027cf1a2d86abbb15f8896b78488029fc1a8b" "q-129124/selection/301c3b8413756351985f910a80753812c052b6adafb865fd065261547b6f3aed"] :db/ensure [:answer-field/validate]} {:db/id "q-129124" :question/id #uuid "024bf297-45a9-5702-b9d5-89e1b4d12ff9" :question/math-academy-id "q-129124" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}2y=5-x \\\\ 5x-9y+1=0\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y=5 \\\\ 5x-9y=-1\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}1 & 2 \\\\ 5 & -9\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n[\\begin{aligned}1 & 2 & 5 \\\\ 5 & -9 & -1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129124/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f9ccaa5-d69c-584d-946e-0c57b3050160"] :knowledge-point/questions ["q-129124"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129133/selection/b80f83958fc4b22365c2f784eef13ab777f0515a2df9e8691a1cb5b2b6d3b481" :answer/id #uuid "34a7f8eb-12e8-5a80-b8f7-4db58c6b20a9" :answer/type :answer.type/math :answer/value "{\\begin{aligned}-8y+4z=\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=-8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=-6\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129133/selection/30b54dd1a350dac8e252487e33c88babe60df1b59d0c1bc2d7b605327513af10" :answer/id #uuid "46ceb2c7-979b-559e-adf9-c0d0c0f5c8da" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x-8y+4z=-\\frac{7}{4} \\\\ x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129133/selection/a6610cc48cf5ba6e6c8027cd705ccbd2cbd7a7d0bd1ede730a2c56f6b5575bd4" :answer/id #uuid "592d0b7b-cf3b-5756-b325-b03e009fb36e" :answer/type :answer.type/math :answer/value "{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129133/selection/168d0b32249ed1235931fc9fd986b98824ad54edef8bbc3e55e6b7a42651e8bd" :answer/id #uuid "1dd3cf4f-5373-5876-a92d-61fb2ccbba9e" :answer/type :answer.type/math :answer/value "{\\begin{aligned}-8x+4z=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129133/selection/ab93d05e2e7f1a2462892e1723419d61d62530369d9d6f1c5fcc6f4ffc2e8b1e" :answer/id #uuid "4c59102b-f9a1-5f01-b28b-12ef14f72417" :answer/type :answer.type/math :answer/value "{\\begin{aligned}-8x+4y=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}y=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129133/selection" :answer-field/id #uuid "0975bfa4-67ce-58b9-bf58-a85394bbb4ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129133/selection/a6610cc48cf5ba6e6c8027cd705ccbd2cbd7a7d0bd1ede730a2c56f6b5575bd4" :answer-field/choices ["q-129133/selection/b80f83958fc4b22365c2f784eef13ab777f0515a2df9e8691a1cb5b2b6d3b481" "q-129133/selection/30b54dd1a350dac8e252487e33c88babe60df1b59d0c1bc2d7b605327513af10" "q-129133/selection/a6610cc48cf5ba6e6c8027cd705ccbd2cbd7a7d0bd1ede730a2c56f6b5575bd4" "q-129133/selection/168d0b32249ed1235931fc9fd986b98824ad54edef8bbc3e55e6b7a42651e8bd" "q-129133/selection/ab93d05e2e7f1a2462892e1723419d61d62530369d9d6f1c5fcc6f4ffc2e8b1e"] :db/ensure [:answer-field/validate]} {:db/id "q-129133" :question/id #uuid "f0c417e1-432e-591b-889d-c01227fedeb7" :question/math-academy-id "q-129133" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & -8 & 4 & -\\frac{7}{4} \\\\ 0 & 5 & \\frac{2}{3} & 8 \\\\ \\frac{3}{2} & \\frac{1}{3} & 4 & 6\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}0x-8y+4z=-\\frac{7}{4} \\\\ 0x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$\n\nBy simplifying, we obtain \n\n$$\n{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129133/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-129133"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71723/selection/5521cb7b6f2865937f8552ea4df747d6073752dbbdc0c45c5e2a70ae81f923fc" :answer/id #uuid "4c715691-36cf-5322-8441-2c150d0cb089" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+4y-2z=3 \\\\ -x+y-z=1 \\\\ 2x+2y+z=2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71723/selection/3dd8c51e8c82f4927ca26a717d8ff90876a87a59189f65293c7409df8f123ccc" :answer/id #uuid "240c8fb1-a4a8-50aa-930e-ca2010ec45c6" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+2y-4z=3 \\\\ -x+y-z=2 \\\\ 2x+2y+z=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71723/selection/9c375e89b0e36db5caf058ae04ca1f43b6e7d91ecdb260065de66a1ff26d85af" :answer/id #uuid "c1c538b3-109b-5b0d-8e73-06b6a4c7f4c2" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+4y-2z=3 \\\\ x+y+z=2 \\\\ 2x+2y+z=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71723/selection/4745a52bd3df49cc2a98eeeb84567860ea7a8bd5bb18501ccd90071bdac646e4" :answer/id #uuid "f100c9c8-73ff-5dca-b7b0-f1d51076a3b0" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+4y-2z=3 \\\\ -x+y-z=2 \\\\ 2x+2y+z=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71723/selection/3d8cde9ee7f1c74e81dd7c24cf5157bad51079fc403bd5f5e92fdedb76dbe35a" :answer/id #uuid "bc159a21-ae8e-5ecf-b33b-77fa0a953d84" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+4y-2z=3 \\\\ -x+y-z=2 \\\\ 2x+y+2z=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-71723/selection" :answer-field/id #uuid "7a45712c-de57-594b-ae6c-bc03c7e4efb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71723/selection/4745a52bd3df49cc2a98eeeb84567860ea7a8bd5bb18501ccd90071bdac646e4" :answer-field/choices ["q-71723/selection/5521cb7b6f2865937f8552ea4df747d6073752dbbdc0c45c5e2a70ae81f923fc" "q-71723/selection/3dd8c51e8c82f4927ca26a717d8ff90876a87a59189f65293c7409df8f123ccc" "q-71723/selection/9c375e89b0e36db5caf058ae04ca1f43b6e7d91ecdb260065de66a1ff26d85af" "q-71723/selection/4745a52bd3df49cc2a98eeeb84567860ea7a8bd5bb18501ccd90071bdac646e4" "q-71723/selection/3d8cde9ee7f1c74e81dd7c24cf5157bad51079fc403bd5f5e92fdedb76dbe35a"] :db/ensure [:answer-field/validate]} {:db/id "q-71723" :question/id #uuid "3383609b-6f13-5900-9557-d8bf919557fa" :question/math-academy-id "q-71723" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}1 & 4 & -2 & 3 \\\\ -1 & 1 & -1 & 2 \\\\ 2 & 2 & 1 & 1\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}x+4y-2z=3 \\\\ -x+y-z=2 \\\\ 2x+2y+z=1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71723/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-71723"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129129/selection/f729ce677a1f6ae45cd22ad6f62ef454da34584055a1eff5c28a7d10dc4840fa" :answer/id #uuid "e6e777c3-e47d-536d-8a65-5ad5faaefeec" :answer/type :answer.type/math :answer/value "{\\begin{aligned}8y=6 \\\\ 4x+y=-9\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129129/selection/c82f65a0ac0856216ee90ceda27fd1a197b64be9d45258d2cdefa5dce7cb8eda" :answer/id #uuid "a7f319da-d903-5d23-8774-0c7e3247858f" :answer/type :answer.type/math :answer/value "{\\begin{aligned}8y=6 \\\\ x+4y=9\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129129/selection/de5d496c1071f2a3174e6b92afc11b642e5fc1daeaddd4b9df5901fb378b1437" :answer/id #uuid "0eb93432-e0bc-5386-9340-1dc3a6ce49eb" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+8y=6 \\\\ 4x+y=9\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129129/selection/045728036c1393f28ac0232535f9af634798581f4b5ade3ac3c45172b2f669c2" :answer/id #uuid "73bc626e-7188-5397-adc7-fc4305ccc8a9" :answer/type :answer.type/math :answer/value "{\\begin{aligned}8x+y=6 \\\\ 4x+y=-9\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129129/selection/861f5ed43281598a6ba1b34fdff7588fc607180ce6e6321fac75a8ad635d47d0" :answer/id #uuid "db771146-06d1-5a4c-ac91-0b48182b9775" :answer/type :answer.type/math :answer/value "{\\begin{aligned}8y=6 \\\\ x+4y=-9\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-129129/selection" :answer-field/id #uuid "9b46a81a-9bf1-56c8-ace7-e6b532441ca3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129129/selection/f729ce677a1f6ae45cd22ad6f62ef454da34584055a1eff5c28a7d10dc4840fa" :answer-field/choices ["q-129129/selection/f729ce677a1f6ae45cd22ad6f62ef454da34584055a1eff5c28a7d10dc4840fa" "q-129129/selection/c82f65a0ac0856216ee90ceda27fd1a197b64be9d45258d2cdefa5dce7cb8eda" "q-129129/selection/de5d496c1071f2a3174e6b92afc11b642e5fc1daeaddd4b9df5901fb378b1437" "q-129129/selection/045728036c1393f28ac0232535f9af634798581f4b5ade3ac3c45172b2f669c2" "q-129129/selection/861f5ed43281598a6ba1b34fdff7588fc607180ce6e6321fac75a8ad635d47d0"] :db/ensure [:answer-field/validate]} {:db/id "q-129129" :question/id #uuid "10f47672-b02f-5835-a498-94f2d2a69a14" :question/math-academy-id "q-129129" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & 8 & 6 \\\\ 4 & 1 & -9\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and  $y$,  the corresponding system of equations is\n\n$$\n{\\begin{aligned}0x+8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$\n\nBy simplifying, we obtain\n\n$$\n{\\begin{aligned}8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129129/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-129129"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20367/selection/10a757c7bcb762c7899b0e3c1ff878326c930f0fca0a051ea5489eb1adea542e" :answer/id #uuid "e5be995f-b506-5ee9-96d6-d85fe6e3165e" :answer/type :answer.type/math :answer/value "{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x+z=-6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-20367/selection/9a0ef528a0eb4411fb34dd59378839b940ad445b48750745848a1a2e34a32f0b" :answer/id #uuid "76cea8a5-964d-5b05-a59c-72483b85cb21" :answer/type :answer.type/math :answer/value "{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z=6 \\\\ 3x-\\frac{1}{2}y+6z=\\frac{1}{3}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-20367/selection/35674b0a95851d5a5d1d827b236dfc8158b562c5e9b3a205d6e0ce2cb0f6c101" :answer/id #uuid "13b5238c-2a28-5e1f-9806-c1c81333d182" :answer/type :answer.type/math :answer/value "{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x-2z=6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-20367/selection/d941ba9a20db7257326e9a28b042ef9add68adc7958c07f43ffc69806251ee0e" :answer/id #uuid "3440190b-4fe3-5c74-b7da-e8f9627d6fd4" :answer/type :answer.type/math :answer/value "{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z=6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-20367/selection/6735536768c1f9b04a37e5502e034df3831a1976685cc4f452c69a0bb4119622" :answer/id #uuid "6eb4477f-aa7a-5635-a221-0003b71fe051" :answer/type :answer.type/math :answer/value "{\\begin{aligned}4x-y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z=6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-20367/selection" :answer-field/id #uuid "0dfe21fc-9e0b-5eea-b1b9-dbdcf6d1b1af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20367/selection/d941ba9a20db7257326e9a28b042ef9add68adc7958c07f43ffc69806251ee0e" :answer-field/choices ["q-20367/selection/10a757c7bcb762c7899b0e3c1ff878326c930f0fca0a051ea5489eb1adea542e" "q-20367/selection/9a0ef528a0eb4411fb34dd59378839b940ad445b48750745848a1a2e34a32f0b" "q-20367/selection/35674b0a95851d5a5d1d827b236dfc8158b562c5e9b3a205d6e0ce2cb0f6c101" "q-20367/selection/d941ba9a20db7257326e9a28b042ef9add68adc7958c07f43ffc69806251ee0e" "q-20367/selection/6735536768c1f9b04a37e5502e034df3831a1976685cc4f452c69a0bb4119622"] :db/ensure [:answer-field/validate]} {:db/id "q-20367" :question/id #uuid "1700e511-a4e7-5eb1-bf8e-366e57339d0a" :question/math-academy-id "q-20367" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}4 & 1 & 1 & \\frac{1}{2} \\\\ \\frac{1}{4} & 0 & 2 & 6 \\\\ 3 & \\frac{1}{2} & 6 & \\frac{1}{3}\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x-0y+2z=6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}.\\end{aligned}\n$$\n\nBy simplifying, we obtain \n\n$$\n{\\begin{aligned}4x+y+z=\\frac{1}{2} \\\\ \\frac{1}{4}x+2z=6 \\\\ 3x+\\frac{1}{2}y+6z=\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-20367/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-20367"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129137/selection/7e9d45c263a9ccbc254e37778863539bf8af75a6eaa20ece7f2cbfc6e2a5b627" :answer/id #uuid "ca43d977-7e08-5a66-bb2c-b9f4626885fb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129137/selection/c8d42acabfdcb288d7561482c97b388607ecf6bd8e42ffdf8d9fcd509eaa8cf5" :answer/id #uuid "54246d18-6999-5be1-8915-ec1350c5ea32" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 & 3 \\\\ 9 & 1 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129137/selection/d581bd77a6f640ba7b8ea5f860af17759f33c71d65518d074474dd3f348ba8e2" :answer/id #uuid "32c5e5e3-05c8-5568-acbb-3f962fcec938" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129137/selection/8b3a031650c8b1a55a049c2ce7548df325ce6ed7ecf3ecee6f5bfaf9055b3cb1" :answer/id #uuid "5de2dc8e-6e30-5493-806d-c3d67a882bf5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 9 \\\\ 3 & -4 \\\\ 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129137/selection/352823d50892aa6938f7e2db704accaf2e3794acf38fb0ff6e14102dd813d95b" :answer/id #uuid "0758b63b-6214-5eef-9545-65136232fcdd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 3 & 1 \\\\ 9 & 4 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-129137/selection" :answer-field/id #uuid "1292eb1f-7f9d-5922-a28b-7931f45ad07e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129137/selection/7e9d45c263a9ccbc254e37778863539bf8af75a6eaa20ece7f2cbfc6e2a5b627" :answer-field/choices ["q-129137/selection/7e9d45c263a9ccbc254e37778863539bf8af75a6eaa20ece7f2cbfc6e2a5b627" "q-129137/selection/c8d42acabfdcb288d7561482c97b388607ecf6bd8e42ffdf8d9fcd509eaa8cf5" "q-129137/selection/d581bd77a6f640ba7b8ea5f860af17759f33c71d65518d074474dd3f348ba8e2" "q-129137/selection/8b3a031650c8b1a55a049c2ce7548df325ce6ed7ecf3ecee6f5bfaf9055b3cb1" "q-129137/selection/352823d50892aa6938f7e2db704accaf2e3794acf38fb0ff6e14102dd813d95b"] :db/ensure [:answer-field/validate]} {:db/id "q-129137" :question/id #uuid "c4f73212-7eee-56ad-bfa4-e71b699e6af7" :question/math-academy-id "q-129137" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}p+3q=2 \\\\ 9p-4q=1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "Notice that the system is already organized so that the variables are in the order $p,q$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 9 & -4\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129137/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "14d047c8-f032-5ff3-aced-65d40bfeeaad"] :knowledge-point/questions ["q-129137"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71731/selection/4e8215fab54cb07eb409815b9fcb2f1ea73f015fed37db515d7470ce49c9bfb4" :answer/id #uuid "5d532036-d456-5c56-aae9-13a2151d57a1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & -1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71731/selection/269454809c9b3313836862ef5408e5872236a3cecd78176d1420db84e9b8be03" :answer/id #uuid "6b5c18c3-dd2a-53a9-9991-83055d01d4e9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 1 & -1 \\\\ -1 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71731/selection/5c4d4463ade9aa4309ba5a372680477c1d6358f0a4dda5ef9db8b4eeaaf7a448" :answer/id #uuid "aee9e74f-dd97-58b2-a7f6-ab5a9cc1de0b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & 0 \\\\ 1 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71731/selection/8bbd6d83272b79b