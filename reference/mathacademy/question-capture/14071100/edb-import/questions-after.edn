 1 \\\\ 1 & 0 & 1\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186298991 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f9ccaa5-d69c-584d-946e-0c57b3050160" :knowledge-point/title "Finding the Augmented Matrix of a System of Linear Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "609e9eb0-c713-524d-91b8-e6329930232a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -4 & 0 \\\\ -3 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186298993} {:answer/id #uuid "2dde8f4a-6b1c-5197-b3c0-096652f5685a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 & 5 \\\\ 6 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186298994} {:answer/id #uuid "3e8b1ff2-6953-5222-89aa-ea71639b6d12" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -5 & 3 \\\\ 6 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186298995} {:answer/id #uuid "bccba62a-06e3-5777-8e21-c47b88df2c63" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 & 5 \\\\ 6 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186298996} {:answer/id #uuid "85b13f75-d0b6-5512-909f-db07b8e04e35" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 & 5 \\\\ -4 & 1 & -6\\end{aligned}]" :db/id #edb/ref 17592186298997}] :answer-field/correct {:answer/id #uuid "85b13f75-d0b6-5512-909f-db07b8e04e35" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 & 5 \\\\ -4 & 1 & -6\\end{aligned}]" :db/id #edb/ref 17592186298997} :answer-field/id #uuid "991f7a96-c7c6-5249-a02f-1e94a4ef4eee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298992}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "66cf2bed-9200-5455-a5fd-8abe57a055ac" :question/math-academy-id "q-1052" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-5=3y \\\\ 6+y=4x\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-3y=5 \\\\ -4x+y=-6\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}2 & -3 \\\\ -4 & 1\\end{aligned}]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n[\\begin{aligned}2 & -3 & 5 \\\\ -4 & 1 & -6\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186299005 :knowledge-point/_questions [{:knowledge-point/id #uuid "14d047c8-f032-5ff3-aced-65d40bfeeaad" :knowledge-point/title "Finding the Augmented Matrix of a Linear System With Variables Other Than x, y, z"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cce466f8-0de5-56df-889f-435c29bf9ad7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 4 & 3 & 0 \\\\ 0 & 0 & -11 & 12\\end{aligned}]" :db/id #edb/ref 17592186299007} {:answer/id #uuid "908d03b1-361e-52a1-8e95-f0166b76816e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 4 & 3 \\\\ 0 & 0 & -11\\end{aligned}]" :db/id #edb/ref 17592186299008} {:answer/id #uuid "6eea1eaa-159d-5255-ad76-00dc3dd5bd17" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 & -3 & 0 \\\\ 0 & 0 & -11 & 12\\end{aligned}]" :db/id #edb/ref 17592186299009} {:answer/id #uuid "b48da1c6-744c-521d-bf38-f673a5855a2f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]" :db/id #edb/ref 17592186299010} {:answer/id #uuid "aefcd95a-46ab-5f3b-a941-7a6e9ddcfe1e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 & 3 \\\\ 0 & 0 & -11\\end{aligned}]" :db/id #edb/ref 17592186299011}] :answer-field/correct {:answer/id #uuid "b48da1c6-744c-521d-bf38-f673a5855a2f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]" :db/id #edb/ref 17592186299010} :answer-field/id #uuid "542d69ba-6370-5a38-b227-d0546b5360e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299006}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "231bb2d1-1f91-5097-b8e5-bbc8b36a788a" :question/math-academy-id "q-1070" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}2{x}_{2}+4{x}_{1}=3{x}_{3} \\\\ -11{x}_{3}=12\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered ${x}_{1},{x}_{2},{x}_{3}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\n\\begin{aligned}{\\begin{aligned}4{x}_{1}+2{x}_{2}-3{x}_{3}=0 \\\\ 0{x}_{1}+0{x}_{2}-11{x}_{3}=12\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186370781 :knowledge-point/_questions [{:knowledge-point/id #uuid "cb13e9d9-19f0-5f39-b9f8-e6e2f8fac433" :knowledge-point/title "Finding the Coefficient Matrix of a System of Linear Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7111e542-48ae-5d7c-982b-07cd63c75157" :answer/type {:db/ident :answer.type/math} :answer/va