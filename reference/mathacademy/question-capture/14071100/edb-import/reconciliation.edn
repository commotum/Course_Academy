e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71728" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\begin{aligned}x-5y=10 \\\\ -2x-3y=-15\\end{aligned}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-129137" "field" nil "attribute" "question/problem" "value" "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}p+3q=2 \\\\ 9p-4q=1\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-129137" "field" nil "attribute" "question/worked-solution" "value" "Notice that the system is already organized so that the variables are in the order $p,q$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 9 & -4\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-129137" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/activity-metadata.json" "file_sha256" "32086a5dcc39d126933b1e3533d3a1949134bd79a3b9ca47faef090ddd2f7219"} {"question" "q-129137" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-129137" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 & 2 & 3 \\\\ 9 & 1 & -4\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 3 & 1 \\\\ 9 & 4 & 2\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1 \\\\ 0 & 0 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 9 \\\\ 3 & -4 \\\\ 2 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-129137" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 3 & 2 \\\\ 9 & -4 & 1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71731" "field" nil "attribute" "question/problem" "value" "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}{x}_{1}-{x}_{2}=-1 \\\\ {x}_{1}+{x}_{2}=-1\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71731" "field" nil "attribute" "question/worked-solution" "value" "Notice that the system is already organized so that the variables are in the order ${x}_{1},{x}_{2}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & -1 & -1 \\\\ 1 & 1 & -1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71731" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/activity-metadata.json" "file_sha256" "32086a5dcc39d126933b1e3533d3a1949134bd79a3b9ca47faef090ddd2f7219"} {"question" "q-71731" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71731" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 1 & -1 \\\\ -1 & 1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & -1 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 & -1 \\\\ 1 & 1 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 & 0 \\\\ 1 & 1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 \\\\ 1 & 1 \\\\ -1 & -1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71731" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & -1 & -1 \\\\ 1 & 1 & -1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71734" "field" nil "attribute" "question/problem" "value" "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}u-v=-1 \\\\ -u-v=1\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71734" "field" nil "attribute" "question/worked-solution" "value" "Notice that the system is already organized so that the variables are in the order $u,v$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}1 & -1 \\\\ -1 & -1\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71734" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/activity-metadata.json" "file_sha256" "32086a5dcc39d126933b1e3533d3a1949134bd79a3b9ca47faef090ddd2f7219"} {"question" "q-71734" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71734" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 & 1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & 1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 & 1 \\\\ -1 & -1 & -1\\end{aligned}]"] ["math" "[\\begin{aligned}-1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71734" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-1070" "field" nil "attribute" "question/problem" "value" "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}2{x}_{2}+4{x}_{1}=3{x}_{3} \\\\ -11{x}_{3}=12\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-1070" "field" nil "attribute" "question/worked-solution" "value" "First, we organize the system so that the variables are ordered ${x}_{1},{x}_{2},{x}_{3}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\n\\begin{aligned}{\\begin{aligned}4{x}_{1}+2{x}_{2}-3{x}_{3}=0 \\\\ 0{x}_{1}+0{x}_{2}-11{x}_{3}=12\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-1070" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/activity-metadata.json" "file_sha256" "32086a5dcc39d126933b1e3533d3a1949134bd79a3b9ca47faef090ddd2f7219"} {"question" "q-1070" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-1070" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}2 & 4 & 3 & 0 \\\\ 0 & 0 & -11 & 12\\end{aligned}]"] ["math" "[\\begin{aligned}2 & 4 & 3 \\\\ 0 & 0 & -11\\end{aligned}]"] ["math" "[\\begin{aligned}4 & 2 & -3 & 0 \\\\ 0 & 0 & -11 & 12\\end{aligned}]"] ["math" "[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]"] ["math" "[\\begin{aligned}4 & 2 & 3 \\\\ 0 & 0 & -11\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-1070" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}4 & 2 & -3 \\\\ 0 & 0 & -11\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71733" "field" nil "attribute" "question/problem" "value" "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}3{x}_{1}+5{x}_{2}=-5 \\\\ 5{x}_{1}+3{x}_{2}=-3\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71733" "field" nil "attribute" "question/worked-solution" "value" "Notice that the system is already organized so that the variables are in the order ${x}_{1},{x}_{2}$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}3 & 5 \\\\ 5 & 3\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}3 & 5 & -5 \\\\ 5 & 3 & -3\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/state.json" "file_sha256" "054a6c038b390b1facb7135906c6e18cc234c242006d9460d6915ece60d4beab"} {"question" "q-71733" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071100/activity-metadata.json" "file_sha256" "32086a5dcc39d126933b1e3533d3a1949134bd79a3b9ca47faef090ddd2f7219"} {"question" "q-71733" "field" "selection" "at