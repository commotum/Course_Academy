6 1103 #edb/ref 17592186045453 13194139533888 true] [17592186263526 1111 #uuid "20e3e128-40dc-5793-9dbe-e5626fa17f45" 13194139533888 true] [17592186263527 1034 "\\frac{{\\text{mi}}^{2}}{\\text{hour}}" 13194139533888 true] [17592186263527 1103 #edb/ref 17592186045453 13194139533888 true] [17592186263527 1111 #uuid "6360718d-2aac-5792-b587-21b9f9327881" 13194139533888 true] [17592186263528 1034 "\\frac{\\text{mi}}{\\text{hour}}" 13194139533888 true] [17592186263528 1103 #edb/ref 17592186045453 13194139533888 true] [17592186263528 1111 #uuid "a0dfdc70-d2a2-5432-b656-877529c6a529" 13194139533888 true] [17592186263529 1034 "\\frac{\\text{mi}}{{\\text{hour}}^{2}}" 13194139533888 true] [17592186263529 1103 #edb/ref 17592186045453 13194139533888 true] [17592186263529 1111 #uuid "72240d1d-d3f6-540d-af3b-56a891461b42" 13194139533888 true] [17592186263530 1017 #edb/ref 17592186263531 13194139533888 true] [17592186263530 1089 "q-108456" 13194139533888 true] [17592186263530 1091 #edb/ref 17592186045463 13194139533888 true] [17592186263530 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945962/assets/352f3d049bd57a805419a34a7873f37f30c95cb2c7c28f4cac984584ff646c75.png)\n\nThe speed-time graph represents the motion of a bus. Calculate the acceleration of the bus." 13194139533888 true] [17592186263530 1113 #uuid "e4470bd1-0bb6-5c73-9442-14ba18805f64" 13194139533888 true] [17592186263530 1145 "In a speed-time graph, the acceleration is given by the slope of the line.\n\nThe line passes through the points $(0,0)$ and $(4,2),$ so its slope is:\n\n$$\n\\begin{aligned}m & =\\frac{2\\,\\text{m/s}-0\\,\\text{m/s}}{4\\,\\text{s}-0\\,\\text{s}} \\\\  & =\\frac{2\\,\\text{m/s}}{4\\,\\text{s}} \\\\  & =0.5\\,\\frac{\\text{m}}{{\\text{s}}^{2}}\\end{aligned}\n$$\n\nTherefore, the acceleration of the bus is $0.5\\,{\\text{m/s}}^{2}.$" 13194139533888 true] [17592186263531 1000 #edb/ref 17592186263532 13194139533888 true] [17592186263531 1000 #edb/ref 1759218