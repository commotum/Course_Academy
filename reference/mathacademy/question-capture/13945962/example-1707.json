  "html": "<div id=\"step-e1707\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Identifying Acceleration on a Speed-Time Graph</div>       \n                        <div class=\"helpButton\" stepid=\"e1707\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>The speed-time graph shown below represents the motion of a train. At what times is the train decelerating?</p>\n<div id=\"graphic-489b979c5c4f73353276c2242f373149\" class=\"graphic\"><img src=\"/graphics/489b979c5c4f73353276c2242f373149\"></div>\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n      