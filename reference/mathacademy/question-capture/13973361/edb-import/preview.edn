^{2}} \\\\  & =\\sqrt{(3\\sqrt{3})^{2}+{3}^{2}} \\\\  & =\\sqrt{36}=6\\end{aligned}\n$$\n\nSince $z$ lies in the first quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{3}{3\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=6$ and $\\theta =\\frac{\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=6\\,{\\text{e}}^{\\pi \\text{i}/6}.\n$$" 13194139534098 true] [17592186277541 1000 #edb/ref 17592186277542 13194139534098 true] [17592186277541 1000 #edb/ref 17592186277543 13194139534098 true] [17592186277541 1000 #edb/ref 17592186277544 13194139534098 true] [17592186277541 1000 #edb/ref 17592186277545 13194139534098 true] [17592186277541 1000 #edb/ref 17592186277546 13194139534098 true] [17592186277541 1040 #edb/ref 17592186045450 13194139534098 true] [17592186277541 1041 "selection" 13194139534098 true] [17592186277541 1104 #edb/ref 17592186277543 13194139534098 true] [17592186277541 1110 #uuid "50cf09ef-0e6f-52c6-b78e-007866adce47" 13194139534098 true] [17592186277542 1034 "z=6\\,{\\text{e}}^{2\\pi \\text{i}/3}" 13194139534098 true] [17592186277542 1103 #edb/ref 17592186045453 13194139534098 true] [17592186277542 1111 #uuid "1e10bfec-bf27-557d-8f7f-0147c7c4e6fb" 13194139534098 true] [17592186277543 1034 "z=6\\,{\\text{e}}^{\\pi \\text{i}/6}" 13194139534098 true] [17592186277543 1103 #edb/ref 17592186045453 13194139534098 true] [17592186277543 1111 #uuid "8effe772-6ad5-57d9-a5a3-04ecff3b572f" 13194139534098 true] [17592186277544 1034 "z=4\\,{\\text{e}}^{\\pi \\text{i}/3}" 13194139534098 true] [17592186277544 1103 #edb/ref 17592186045453 13194139534098 true] [17592186277544 1111 #uuid "b67f6e9f-5154-506f-a8dd-37d2f906cd47" 13194139534098 true] [17592186277545 1034 "z=4\\,{\\text{e}}^{\\pi \\text{i}/6}" 13194139534098 true] [17592186277545 1103 #edb/