f4c6c645efde95a2b69dcb9acfd2d80ee02aa82f4e1258f3d475669a"] :db/ensure [:answer-field/validate]} {:db/id "q-78485" :question/id #uuid "4491981d-ece3-5014-843e-910429266c33" :question/math-academy-id "q-78485" :question/problem "Which of the following statements is true regarding the series  ${\\sum }_{n=1}^{\\infty }\\frac{2}{3}{(-3)}^{n+1}$ ?" :question/worked-solution "The series starts with $n=1.$ So the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{\\frac{2}{3}{(-3)}^{2+1}}{\\frac{2}{3}{(-3)}^{1+1}} \\\\  & =\\frac{(-3)^{3}}{(-3)^{2}} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78485/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b2ac075-4b9b-52d3-b053-84fe2d1b6545"] :knowledge-point/questions ["q-78485"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40579/selection/1dbd1554ba02f6548c9232e690ce67d1f62dc3caa530c347be9b875890c26585" :answer/id #uuid "8a899d68-5663-59a6-8c0c-0fd81fc4d647" :answer/type :answer.type/text :answer/value "The series is divergent because $|r|\\ge 1$" :db/ensure [:answer/validate]} {:db/id "q-40579/selection/8e6f54ddcfc0e630fa58a891b9ff1e3729035d4d3b91ff492060adb884166582" :answer/id #uuid "116345f6-7b08-56b2-ac90-5963ae1da95e" :answer/type :answer.type/text :answer/value "The series is convergent because $|r|\\ge 1$" :db/ensure [:answer/validate]} {:db/id "q-40579/selection/c598d9cafce5ce2be767a450a80e9f569c1bf1bba1a13572fd98d74e9c59377a" :answer/id #uuid "3882ed75-8528-56aa-9022-c68352e9e90e" :answer/type :answer.type/text :answer/value "The series is divergent because $|r|<1$" :db/ensure [:answer/validate]} {:db/id "q-40579/selection/01d56a7e80e96795ccbf899560e934fe71a6efa5f56939f9f6d5da9d0981f964" :answer/id #uuid "3a8c4a0a-bdc8-54de-8a7e-923192e070db" :answer/type :answer.type/text :answer/value "The series is convergent because $|r|<1$" :db/ensu