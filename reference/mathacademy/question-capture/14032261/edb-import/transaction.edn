atio is\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{4}}{{a}_{3}} \\\\  & =\\frac{\\frac{3}{5}{(\\frac{3}{2})}^{4+1}}{\\frac{3}{5}{(\\frac{3}{2})}^{3+1}} \\\\  & =\\frac{{(\\frac{3}{2})}^{5}}{{(\\frac{3}{2})}^{4}} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-67458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1a00fa7-a425-5b28-941c-bc8027676ebe"] :knowledge-point/questions ["q-67458"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124901/selection/c8023004c4ef014dd45ec8f183c202671545b0ce8b328147859da3f4f33bd45d" :answer/id #uuid "3790dfc7-0b7b-5126-8cdd-32eac099c5f6" :answer/type :answer.type/text :answer/value "The series is divergent because $|r|<1.$" :db/ensure [:answer/validate]} {:db/id "q-124901/selection/b2580ca6b71c6824c839bd7fd87ae287df8086343fbfacc67d938d0c01f1b479" :answer/id #uuid "59c1ded3-6917-52cc-a662-ff2e463df991" :answer/type :answer.type/text :answer/value "The series is convergent because $|r|\\ge 1.$" :db/ensure [:answer/validate]} {:db/id "q-124901/selection/210b2d33f43526a85322824318a48f4d3cb50e93fe71351ab11c39f0c73f954c" :answer/id #uuid "3640d6c4-1970-5f74-b53b-afeb11bce18e" :answer/type :answer.type/text :answer/value "Inconclusive because $|r|=1.$" :db/ensure [:answer/validate]} {:db/id "q-124901/selection/e534fbd071286330a5dccbcf85e401eb638060cb72af386e3aea4b356081987c" :answer/id #uuid "f648ace9-dc1a-5d60-b8c2-d5cc0da66721" :answer/type :answer.type/text :answer/value "The series is divergent because $|r|\\ge 1.$" :db/ensure [:answer/validate]} {:db/id "q-124901/selection/aa5e1d4c8b406bf008742dead7232d7f15fdc60dfbf22980ff54a99e3f28e033" :answer/id #uuid "c1c7e8dd-6e97-5ff6-a92f-77781bd5b8dd" :answer/type :answer.type/text :answer/value "The series is convergent because $|r|<1.$" :db/ensure [:answer/validate]} {:db/id "q-124901/selection" :answer-field/id #uuid "572aa021-4