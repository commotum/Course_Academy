type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269204} {:answer/id #uuid "1d21a93c-28c2-569d-b449-80dac1a9eac4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269205} {:answer/id #uuid "8ec618bb-87c2-5a9b-845d-828cc35fb584" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269206} {:answer/id #uuid "cb915319-53e3-5a1f-b9e3-79d08f0903a8" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269207}] :answer-field/correct {:answer/id #uuid "cb915319-53e3-5a1f-b9e3-79d08f0903a8" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269207} :answer-field/id #uuid "cd69e912-57a3-5a13-9091-ad6ab11b5767" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269202}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e441604c-0eda-535c-9658-1594ecad847c" :question/math-academy-id "q-123703" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1$ for $n>1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1)=-1+{lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{{log}_{2}⁡n}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the numerator is growing much faster than the denominator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{{log}_{2}⁡n}=\\infty .\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }(\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1)=\\infty .\n$$\n\nTherefore, the sequence diverges."}] [{:db/id #edb/ref 17592186269208 :knowledge-point/_questions [{:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004" :knowledge-point/title "Determining the Convergence Sequences Containing Power and Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85310aea-7c71-545d-ae67-ff8b406595cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186269210} {:answer/id #uuid "fba6c2f6-ca67-5229-9783-246316e5a8c1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269211} {:answer/id #uuid "b7e9c920-31a4-56fd-9909-3458a854c736" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269212} {:answer/id #uuid "e402331b-8062-58ed-a635-0c5944cae424" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269213} {:answer/id #uuid "a70d209b-f9f1-52b6-b581-1246b2d089f2" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269214}] :answer-field/correct {:answer/id #uuid "e402331b-8062-58ed-a635-0c5944cae424" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269213} :answer-field/id #uuid "cdd70aae-b710-56ec-8da7-ca1d444dcc04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269209}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a2b13d4e-7d2d-5ecc-a372-30045ced530f" :question/math-academy-id "q-123706" :question/problem "Does the sequence ${a}_{n}=\\frac{{log}_{2}⁡n}{\\sqrt{n}}$ for $n\\ge 1$ converge or diverge? If the sequence converges, what is its limit?" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{\\sqrt{n}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{\\sqrt{n}}=0.\n$$\n\nTherefore, the sequence converges,  and its limit is $0.$"}] [{:db/id #edb/ref 17592186269215 :knowledge-point/_questions [{:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004" :knowledge-point/title "Determining the Convergence Sequences Containing Power and Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "194da577-0e76-5477-9dff-b02c25929468" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269217} {:answer/id #uuid "401a166b-fd90-58c7-9a75-4bb8fc781889" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269218} {:answer/id #uuid "737d1028-ca1d-560b-8662-21eea98c5ef6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269219} {:answer/id #uuid "705e2786-36f2-5dbe-93a8-51eb7a9aa63c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269220} {:answer/id #uuid "b0498184-7136-5d79-a7fa-7ee5dc8c9fcd" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269221}] :answer-field/correct {:answer/id #uuid "705e2786-36f2-5dbe-93a8-51eb7a9aa63c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269220} :answer-field/id #uuid "c05be86d-cad3-5604-9693-35234f2759f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269216}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a376b33-d2ce-5d81-8804-ae92cf43873c" :question/math-academy-id "q-123709" :question/problem "Does the sequence ${a}_{n}=\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}-1$ for $n\\ge 1$ converge or diverge? If the sequence converges, what is its limit?" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}-1)=-1+{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}=0.\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }{a}_{n}=-1+{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}=-1+0=-1.\n$$\n\nTherefore, the sequence converges and its limit is $-1.$"}] [{:db/id #edb/ref 17592186269222 :knowledge-point/_questions [{:knowledge-point/id #uuid "51d50237-f6cf-5c2d-b8d1-335378205a28" :knowledge-point/title "Determining the Convergence of Sequences Containing Exponential Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ab3905e-83d1-5f7d-bdb1-50e9129b7a1d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269224} {:answer/id #uuid "b4f528f8-6fe5-5385-ba51-f81e61d6583b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186269225} {:answer/id #uuid "029edb90-ed5e-599f-ad9d-8bb9fbc3310e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269226} {:answer/id #uuid "1dce8219-8b31-5165-8543-7c2e2371dc6d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269227} {:answer/id #uuid "a64c8c1f-473a-5283-946b-44878f9b94b9" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269228}] :answer-field/correct {:answer/id #uuid "1dce8219-8b31-5165-8543-7c2e2371dc6d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269227} :answer-field/id #uuid "653488c4-c9a1-5a63-9972-0154f1ba42de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269223}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b1baf287-0d07-54ce-ad49-6291a26805a1" :question/math-academy-id "q-123710" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{{log}_{7}⁡n}{{e}^{3n}}-1$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nTo find the limit, we calculate\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{{log}_{7}⁡n}{{e}^{3n}}-1)=-1+{lim}_{n\\to \\infty }\\frac{{log}_{7}⁡n}{{e}^{3n}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{log}_{7}⁡n}{{e}^{3n}}=0.\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }{a}_{n}=-1+{lim}_{n\\to \\infty }\\frac{{log}_{7}⁡n}{{e}^{3n}}=-1+0=-1.\n$$\n\nTherefore, the sequence converges and its limit is $-1.$"}] [{:db/id #edb/ref 17592186269229 :knowledge-point/_questions [{:knowledge-point/id #uuid "51d50237-f6cf-5c2d-b8d1-335378205a28" :knowledge-point/title "Determining the Convergence of Sequences Containing Exponential Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7222fbf2-db17-5df7-be84-84a981a0c2d8" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269231} {:answer/id #uuid "e5b906df-ae17-5f4b-be47-2ca5fd19439c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269232} {:answer/id #uuid "678039b9-6414-5694-9813-67040d7bc506" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269233} {:answer/id #uuid "e5de9a15-ca17-5552-abed-7121a82e4892" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269234} {:answer/id #uuid "ddd49d2d-4983-51a9-af52-39149a5dbdd4" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269235}] :answer-field/correct {:answer/id #uuid "e5de9a15-ca17-5552-abed-7121a82e4892" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269234} :answer-field/id #uuid "066676eb-fd20-518a-9959-3f64b3037a7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269230}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3d938ed1-376a-519c-b7cf-b8eeedfd38aa" :question/math-academy-id "q-123711" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{{log}_{3}⁡n}{{e}^{n/10}}-1$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nTo find the limit, we calculate\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{{log}_{3}⁡n}{{e}^{n/10}}-1)=-1+{lim}_{n\\to \\infty }\\frac{{log}_{3}⁡n}{{e}^{n/10}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{log}_{3}⁡n}{{e}^{n/10}}=0.\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }{a}_{n}=-1+{lim}_{n\\to \\infty }\\frac{{log}_{3}⁡n}{{e}^{n/10}}=-1+0=-1.\n$$\n\nTherefore, the sequence converges and its limit is $-1.$"}] [{:db/id #edb/ref 17592186269236 :knowledge-point/_questions [{:knowledge-point/id #uuid "51d50237-f6cf-5c2d-b8d1-335378205a28" :knowledge-point/title "Determining the Convergence of Sequences Containing Exponential Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc97f74d-8ef0-5f34-8314-69fbd5a0587e" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{n}$ and ${c}_{n}$ only" :db/id #edb/ref 17592186269238} {:answer/id #uuid "6882ec4d-e6a3-5673-a3fc-dc566a38db03" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{n}$ and ${b}_{n}$ only" :db/id #edb/ref 17592186269239} {:answer/id #uuid "d05ef264-1928-5945-8d3b-0ae4fe26f67b" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{n},$ ${b}_{n},$ and ${c}_{n}$" :db/id #edb/ref 17592186269240} {:answer/id #uuid "9ea7811c-9dbf-5f28-bddd-aea3c132b784" :answer/type {:db/ident :answer.type/text} :answer/value "${c}_{n}$ only" :db/id #edb/ref 17592186269241} {:answer/id #uuid "366b7268-91a0-5f88-80b9-1bd37870df37" :answer/type {:db/ident :answer.type/text} :answer/value "${b}_{n}$ and ${c}_{n}$ only" :db/id #edb/ref 17592186269242}] :answer-field/correct {:answer/id #uuid "d05ef264-1928-5945-8d3b-0ae4fe26f67b" :answer/type {:db/ident :answer.type/text} :answer/value "${a}_{n},$ ${b}_{n},$ and ${c}_{n}$" :db/id #edb/ref 17592186269240} :answer-field/id #uuid "b5702c46-86ff-5cf4-b2d9-83ac5596e555" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269237}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b9bf7b26-4c35-5b3c-bd82-2290add25e67" :question/math-academy-id "q-123715" :question/problem "Which of the following sequences, defined for $n\\ge 1,$ converge?\n\n- ${a}_{n}=\\frac{{log}_{2}⁡(3n)}{{e}^{2n}}$\n- ${b}_{n}=\\frac{{log}_{2}⁡n}{\\sqrt{n}}$\n- ${c}_{n}=\\frac{{n}^{2}}{{e}^{n}}$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nTo find the limit of each sequence, we must evaluate them for $n\\to \\infty .$\n\nFor ${a}_{n}=\\frac{{log}_{2}⁡(3n)}{{e}^{2n}},$ both the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}=0.\n$$\n\nFor ${b}_{n}=\\frac{{log}_{2}⁡n}{\\sqrt{n}},$ both the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }{b}_{n}=0.\n$$\n\nFor ${c}_{n}=\\frac{{n}^{2}}{{e}^{n}},$ both the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }{c}_{n}=0.\n$$\n\nSo, the correct answer is \"${a}_{n},$ ${b}_{n},$ and ${c}_{n}.$\""}] [{:db/id #edb/ref 17592186101364 :knowledge-point/_questions [{:knowledge-point/id #uuid "43f839b4-2b0e-5ab5-809a-741747f1016d" :knowledge-point/title "Determining the Convergence of Sequences Containing Power and Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ec650b-c3d8-50e2-8019-b3f5db04dcb4" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186099781} {:answer/id #uuid "d572bdd8-639e-56ee-a240-df640b79094d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186099782} {:answer/id #uuid "f289bf3e-d0d1-5204-a976-1e479fa80121" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186099783} {:answer/id #uuid "1acc63fa-11e8-574d-a249-8b2df347b72e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186099784} {:answer/id #uuid "3e42c4d6-83a6-51cc-88ec-8f7386ab32f8" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186099785}] :answer-field/correct {:answer/id #uuid "3e42c4d6-83a6-51cc-88ec-8f7386ab32f8" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges." :db/id #edb/ref 17592186099785} :answer-field/id #uuid "8e14d885-1c74-5f30-981b-55fa9b0375d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099780}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c887b91e-985b-5a9c-b288-e71bb3c8cdca" :question/math-academy-id "q-49670" :question/problem "Does the sequence $a_{n} = \\frac{e^{n}}{n}$ converge or diverge? If the sequence converges, what is its limit?" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{{e}^{n}}{n}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the numerator is growing much faster than the denominator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{e}^{n}}{n}=\\infty .\n$$\n\nTherefore, the sequence diverges."}] [{:db/id #edb/ref 17592186269243 :knowledge-point/_questions [{:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004" :knowledge-point/title "Determining the Convergence Sequences Containing Power and Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c48c965-7dae-5fa2-ad8e-251e1fe0d0ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186269245} {:answer/id #uuid "68805b5c-b287-5757-ae3d-ddba4aea50ac" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269246} {:answer/id #uuid "2c5641c5-66a0-54ef-8ab8-90fb7362ce23" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269247} {:answer/id #uuid "82e84550-dd28-5a12-966c-f