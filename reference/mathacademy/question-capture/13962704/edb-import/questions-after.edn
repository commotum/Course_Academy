8ecc2b" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269284}] :answer-field/correct {:answer/id #uuid "88ed8993-6c1f-55c9-96d1-d263aa88fb2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269283} :answer-field/id #uuid "6ffefad1-3e1c-53e0-9452-f7f478ab427b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269279}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "89d9f5ad-2749-58ab-bf93-cda856419271" :question/math-academy-id "q-75962" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{4\\operatorname{ln}⁡n}{{e}^{3n}}$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nTo find the limit, we calculate\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{4\\operatorname{ln}⁡n}{{e}^{3n}}.\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{4\\operatorname{ln}⁡n}{{e}^{3n}}=0.\n$$\n\nTherefore, the sequence converges, and its limit is $0.$"}] [{:db/id #edb/ref 17592186269285 :knowledge-point/_questions [{:knowledge-point/id #uuid "51d50237-f6cf-5c2d-b8d1-335378205a28" :knowledge-point/title "Determining the Convergence of Sequences Containing Exponential Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98e2c887-77f6-5379-b383-be2744e43057" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186269287} {:answer/id #uuid "73ad8132-b34b-5289-b7a8-a229384353bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186269288} {:answer/id #uuid "71cad2b9-3984-5d04-bc43-d4893766a39b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269289} {:answer/id #uuid "663baea8-7ee4-5006-b884-5eaec2053143" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269290} {:answer/id #uuid "73672372-939f-5dc2-8c3c-2b86613a09ae" :answer/type {:db/ident :answer.type/text} :answer/value "The sequence diverges" :db/id #edb/ref 17592186269291}] :answer-field/correct {:answer/id #uuid "71cad2b9-3984-5d04-bc43-d4893766a39b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269289} :answer-field/id #uuid "982f9594-18f1-52a5-a89d-e462f5bf162d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186269286}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05439571-7bce-5c15-9bdd-ac1dd235a009" :question/math-academy-id "q-75963" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{\\operatorname{log}⁡(6n)}{3{e}^{n}}+1$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nTo find the limit, we calculate\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{\\operatorname{log}⁡(6n)}{3{e}^{n}}+1)=1+{lim}_{n\\to \\infty }\\frac{\\operatorname{log}⁡(6n)}{3{e}^{n}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{\\operatorname{log}⁡(6n)}{3{e}^{n}}=0.\n$$\n\nHence, \n\n$$\n1+{lim}_{n\\to \\infty }\\frac{\\operatorname{log}⁡(6n)}{3{e}^{n}}=1+0=1.\n$$\n\nTherefore, the sequence converges and its limit is $1.$"}]}
