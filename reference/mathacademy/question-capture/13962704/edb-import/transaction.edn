a8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-49727/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-49727" :question/id #uuid "fcc1e4d4-ddd2-5951-b6fb-9e72e2f7dcbc" :question/math-academy-id "q-49727" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{{log}_{2}⁡n}{n+2}$ for $n\\ge 1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches at infinity,\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{n+2}.\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{{log}_{2}⁡n}{n+2}=0.\n$$\n\nTherefore, the sequence converges,  and its limit is $0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49727/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004"] :knowledge-point/questions ["q-49727"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123709/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "194da577-0e76-5477-9dff-b02c25929468" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-123709/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "705e2786-36f2-5dbe-93a8-51eb7a9aa63c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-123709/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "401a166b-fd90-58c7-9a75-4bb8fc781889" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-123709/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" :answer/id #uuid "b0498184-7136-5d79-a7fa-7ee5dc8c9fcd" :answer/type :answer.type/text :answer/value "The sequence diverges" :db/ensure [:answer/validate]} {:db/id "q-123709/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "737d1028-ca1d-560b-8662-21eea98c5ef6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-123709/selection" :answer-field/id #uuid "c05be86d-cad3-5604-9693-35234f2759f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123709/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-123709/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-123709/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-123709/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-123709/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" "q-123709/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-123709" :question/id #uuid "7a376b33-d2ce-5d81-8804-ae92cf43873c" :question/math-academy-id "q-123709" :question/problem "Does the sequence ${a}_{n}=\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}-1$ for $n\\ge 1$ converge or diverge? If the sequence converges, what is its limit?" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}-1)=-1+{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}=0.\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }{a}_{n}=-1+{lim}_{n\\to \\infty }\\frac{\\operatorname{ln}⁡(5n)}{{n}^{5}}=-1+0=-1.\n$$\n\nTherefore, the sequence converges and its limit is $-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123709/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004"] :knowledge-point/questions ["q-123709"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123703/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "8ec618bb-87c2-5a9b-845d-828cc35fb584" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-123703/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "1d21a93c-28c2-569d-b449-80dac1a9eac4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-123703/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" :answer/id #uuid "cb915319-53e3-5a1f-b9e3-79d08f0903a8" :answer/type :answer.type/text :answer/value "The sequence diverges" :db/ensure [:answer/validate]} {:db/id "q-123703/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "35b63617-a1e9-5a61-8afe-8844acfb76da" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-123703/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4f4c5324-11cf-58fc-b871-da5944a57427" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-123703/selection" :answer-field/id #uuid "cd69e912-57a3-5a13-9091-ad6ab11b5767" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123703/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" :answer-field/choices ["q-123703/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-123703/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-123703/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" "q-123703/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-123703/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-123703" :question/id #uuid "e441604c-0eda-535c-9658-1594ecad847c" :question/math-academy-id "q-123703" :question/problem "What is the limit of the sequence ${a}_{n}=\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1$ for $n>1?$" :question/worked-solution "Recall that for large values of $n,$ we have\n\n$$\nn!≫{e}^{n}≫{n}^{m}≫\\operatorname{ln}⁡(n),\n$$\n\nwhere $≫$ means \"much greater than,\" and $m>0.$\n\nWe calculate the limit of the sequence as $n$ approaches infinity:\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }(\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1)=-1+{lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{{log}_{2}⁡n}\n$$\n\nBoth the numerator and denominator approach infinity as $n\\to \\infty .$ However, the numerator is growing much faster than the denominator, and we conclude that\n\n$$\n{lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{{log}_{2}⁡n}=\\infty .\n$$\n\nHence, \n\n$$\n{lim}_{n\\to \\infty }(\\frac{\\sqrt{n}}{{log}_{2}⁡n}-1)=\\infty .\n$$\n\nTherefore, the sequence diverges." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123703/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37e00ff7-a91e-5b56-9f3a-24e7318cf004"] :knowledge-point/questions ["q-123703"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75952/selection/f5ba9cb7e3373c690e498bc176135d7b1a2093e80dfdec0ef9d7cefcc7228be5" :answer/id #uuid "b1c666a4-b4a4