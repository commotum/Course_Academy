{
  "dom_id": "step-e7421",
  "name": "Example: Simplifying Expressions Using the Properties of Expected Value",
  "problem": "Compute $\\textrm E[X(X-3) + 4]$ if $\\textrm E[X^2] = 4$ and $\\textrm E[X] = 1.$",
  "worked_solution": "Expanding out the product inside the expected value, using the properties of the expected value, and substituting in the given information, we get\n\n$$\n\\begin{aligned}\\text{E}[X(X-3)+4] & =\\text{E}[{X}^{2}-3X+4] \\\\  & =\\text{E}[{X}^{2}]-3\\text{E}[X]+\\text{E}[4] \\\\  & =\\text{E}[{X}^{2}]-3\\text{E}[X]+4 \\\\  & =4-3(1)+4 \\\\  & =5.\\end{aligned}\n$$",
  "calculator_instructions": "",
  "fields": [],
  "result": null,
  "proof_feedback": null,
