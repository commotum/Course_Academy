e16-08f4-51a7-b22c-7dab7b8a703a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186250987} {:answer/id #uuid "53d70ecc-053d-5556-960b-e8c9b905cd7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186250988} {:answer/id #uuid "4453c3e7-4c7d-53b0-8903-8e6ea1dae68b" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186250989} {:answer/id #uuid "911b0063-a626-5cd7-a823-8c906fb6facd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250990}] :answer-field/correct {:answer/id #uuid "911b0063-a626-5cd7-a823-8c906fb6facd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250990} :answer-field/id #uuid "44c29b28-87a5-5684-b499-60b95c929872" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250985}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f80da774-0856-58ab-9260-32b1a2f538ff" :question/math-academy-id "q-47073" :question/problem "${lim}_{x\\to -\\infty }{2}^{3x-8}=$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{2}^{3x-8} & ={lim}_{x\\to -\\infty }{2}^{3x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{({2}^{3})}^{x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{8}^{x}\\cdot (\\frac{1}{256}) \\\\  & =(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={8}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/85319605a7c7b57d4c7ed29b8d409e3169f3331775580b91b70e2be99fef7986.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{8}^{x}=0.\n$$\n\nSo, we conclude that \n\n$$\n(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}=(\\frac{1}{256})\\cdot 0=0\n$$"}] [{:db/id #edb/ref 17592186115792 :knowledge-point/_questions [{:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659" :knowledge-point/title "Evaluating Infinite Limits Using the Laws of Exponents and the Algebra of Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a5a690f-c295-543c-8564-9e503a928a72" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186114124} {:answer/id #uuid "b7827b3e-6eef-5cca-88b2-6f6ea09c9c2e" :answer/type {:db/ident :answer.type/math} :answer/value "DNE" :db/id #edb/ref 17592186114125} {:answer/id #uuid "dd5c4e0c-59be-590d-bfd7-dd5edf663f4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186114126} {:answer/id #uuid "e0305a24-11ff-5c0e-9933-0992e02c6f78" :answer/type {:db/ident :answer.type/math} :answer/value "∞" :db/id #edb/ref 17592186114127} {:answer/id #uuid "45e43b6c-cc20-5f3a-be9d-e26a9e3ecaf6" :answer/type {:db/ident :answer.type/math} :answer/value "- ∞" :db/id #edb/ref 17592186114128} {:answer/id #uuid "a545a93c-a506-5224-a308-b31c75cf0c09" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186250991}] :answer-field/correct {:answer/id #uuid "dd5c4e0c-59be-590d-bfd7-dd5edf663f4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186114126} :answer-field/id #uuid "c0913fff-cbea-5315-8c93-5a1de2156fe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114123}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8749a00a-586e-55ad-83f3-b90c135bdf18" :question/math-academy-id "q-47081" :question/problem "What is $lim_(x → ∞)e^{(-3x + 1)}$?" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{e}^{(-3x+1)} & ={lim}_{x\\to \\infty }{e}^{-3x}\\cdot {e}^{1} \\\\  & ={lim}_{x\\to \\infty }{e}^{-3x}\\cdot e \\\\  & =e\\cdot {lim}_{x\\to \\infty }{e}^{-3x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={e}^{-3x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/c3d9e0bfa0b7514713c01289fc63fde7b0bd0dab525ad50617a9e908fd117060.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }{e}^{-3x}=0.\n$$\n\nTherefore:\n\n$$\ne\\cdot {lim}_{x\\to \\infty }{e}^{-3x}=e\\cdot 0=0\n$$"}] [{:db/id #edb/ref 17592186250992 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae016162-6fee-5bb7-950f-fb7aa1ce4e11" :knowledge-point/title "Evaluating Infinite Limits of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06056a1a-c82d-5a9a-a7d3-fe3650752a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186250994} {:answer/id #uuid "37b882d4-5743-5eb7-88f5-42e026a07f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186250995} {:answer/id #uuid "6ad1ce93-b73d-56ca-ac21-e0ff186b006d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186250996} {:answer/id #uuid "045255a9-7499-5145-923d-7b483d71226e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186250997} {:answer/id #uuid "f1c9fb89-2c61-5534-8f76-3ed9ca135607" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250998}] :answer-field/correct {:answer/id #uuid "f1c9fb89-2c61-5534-8f76-3ed9ca135607" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250998} :answer-field/id #uuid "e33cedd1-640e-504d-b518-aba156b282a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250993}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "703a1973-fa8f-5e81-ac8e-8c5767d78002" :question/math-academy-id "q-54489" :question/problem "${lim}_{x\\to \\infty }{(\\frac{1}{4})}^{x}=$" :question/worked-solution "We recall the graph of $y={(\\frac{1}{4})}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/2a24c00ab4fbb960e93278c340bd4b1368f28e7d521d415a2e7a4868d2f58064.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }{(\\frac{1}{4})}^{x}=0.\n$$"}] [{:db/id #edb/ref 17592186250999 :knowledge-point/_questions [{:knowledge-point/id #uuid "b58de617-785d-5318-9d12-99651e030eb2" :knowledge-point/title "Evaluating Using Direct Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145665d3-c61d-546e-b2ac-b80b2d74c704" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251001} {:answer/id #uuid "d4e2cd67-6981-50a5-8092-60a3cfe6e363" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251002} {:answer/id #uuid "20125743-20cd-5880-b87f-4499df0b35a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251003} {:answer/id #uuid "b978c8df-f569-5e2e-86c2-bd36ae1853c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186251004} {:answer/id #uuid "6e4fff56-c8d2-5785-ad70-7aede08c2f1d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186251005}] :answer-field/correct {:answer/id #uuid "145665d3-c61d-546e-b2ac-b80b2d74c704" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251001} :answer-field/id #uuid "e7f24ad5-f310-5aa2-82b1-e6b69d72a35c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251000}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b66a2bc7-58d6-5c40-a5fd-6a8dcb6c5064" :question/math-academy-id "q-67625" :question/problem "Given that ${lim}_{x\\to 0}\\frac{{4}^{x}-c}{3\\cdot {2}^{x}}=2$, what is the value of constant $c?$" :question/worked-solution "We can evaluate this limit in terms of the constant $c$ using direct substitution, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{4}^{x}-c}{3\\cdot {2}^{x}} & =\\frac{{4}^{0}-c}{3\\cdot {2}^{0}} \\\\  & =\\frac{1-c}{3}\\,.\\end{aligned}\n$$\n\nSince we know that the above limit is equal to $2,$ we can equate the above with $2,$ and then solve for $c:$\n\n$$\n\\begin{aligned}\\frac{1-c}{3} & =2 \\\\ 1-c & =6 \\\\ -c & =6-1 \\\\ c & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186251006 :knowledge-point/_questions [{:knowledge-point/id #uuid "b58de617-785d-5318-9d12-99651e030eb2" :knowledge-point/title "Evaluating Using Direct Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e37bc76-0cc0-5666-8395-fe81dd27e481" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251008} {:answer/id #uuid "92219555-2a42-53ce-9eca-6e708c85505a" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186251009} {:answer/id #uuid "196696fc-f770-5ca0-9195-e7f574856826" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251010} {:answer/id #uuid "1701a980-8bd3-5a67-bfc7-8b1e1f559adb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186251011} {:answer/id #uuid "47057605-8b3e-5847-ab75-7319ab64a96e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186251012}] :answer-field/correct {:answer/id #uuid "1701a980-8bd3-5a67-bfc7-8b1e1f559adb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186251011} :answer-field/id #uuid "1bc83e67-95c5-59e6-8ed5-dc57b3581cb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251007}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e933348-2e7f-5ef0-bc3f-cfcc7ccd9d76" :question/math-academy-id "q-99478" :question/problem "Given that ${lim}_{x\\to 2}\\frac{{6}^{x}-4}{{3}^{x}+c}=4,$ what is the value of constant $c?$" :question/worked-solution "We can evaluate this limit in terms of the constant $c$ using direct substitution, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{{6}^{x}-4}{{3}^{x}+c} & =\\frac{{lim}_{x\\to 2}({6}^{x}-4)}{{lim}_{x\\to 2}({3}^{x}+c)} \\\\  & =\\frac{{6}^{2}-4}{{3}^{2}+c} \\\\  & =\\frac{32}{9+c}\\end{aligned}\n$$\n\nSince we know that the above limit is equal to $4,$ we can equate the above with $4,$ and then solve for $c:$\n\n$$\n\\begin{aligned}\\frac{32}{9+c} & =4 \\\\ 9+c & =8 \\\\ c & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186251013 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae016162-6fee-5bb7-950f-fb7aa1ce4e11" :knowledge-point/title "Evaluating Infinite Limits of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6184d9de-8fb8-5995-bbfa-db8cd80c3d03" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186251015} {:answer/id #uuid "2e63e3ca-691b-50a5-99d0-bd2fa0ac4ad2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186251016} {:answer/id #uuid "fc94fec8-7307-57be-94be-c60c93c5d127" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251017} {:answer/id #uuid "09f6703d-4208-54c4-b859-2ebff2cc3940" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186251018} {:answer/id #uuid "f6ba5e53-839c-5af2-82ca-129e217515ea" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186251019}] :answer-field/correct {:answer/id #uuid "6184d9de-8fb8-5995-bbfa-db8cd80c3d03" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186251015} :answer-field/id #uuid "894dc7b7-a7d8-5fab-8087-21dfc52e7074" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251014}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b993d929-8ea3-5602-a808-45ff67b8fb1d" :question/math-academy-id "q-99505" :question/problem "${lim}_{x\\to -\\infty }{5}^{-x}=$" :question/worked-solution "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{5}^{-x} & ={lim}_{x\\to \\infty }{({5}^{-1})}^{x} \\\\  & ={lim}_{x\\to -\\infty }{(\\frac{1}{5})}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={(\\frac{1}{5})}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/0f9cf17608e32b91f4efbb243702286b484938c015f74f0b59ca906dc24c593a.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{(\\frac{1}{5})}^{x}=\\infty .\n$$"}] [{:db/id #edb/ref 17592186251020 :knowledge-point/_questions [{:knowledge-point/id #uuid "ae016162-6fee-5bb7-950f-fb7aa1ce4e11" :knowledge-point/title "Evaluating Infinite Limits of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e58bd00-d4b3-5998-8e73-f9d05a174913" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186251022} {:answer/id #uuid "9452706c-2fda-5cc8-8170-1cb2b017f46c" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186251023} {:answer/id #uuid "014c37cf-2a32-5a29-8ae8-ebe5dd4e16f0" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186251024} {:answer/id #uuid "1147d273-bca4-53e8-a661-1faed37b16d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186251025} {:answer/id #uuid "d2d93252-eebd-567f-a35a-3eab753ef9bd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251026}] :answer-field/correct {:answer/id #uuid "d2d93252-eebd-567f-a35a-3eab753ef9bd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251026} :answer-field/id #uuid "326a7dae-860c-50cf-aaaf-22f8ee67a392" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251021}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2dc58d25-f7f0-56ee-9ec8-9c911ea031f3" :question/math-academy-id "q-99507" :question/problem "${lim}_{x\\to \\infty }(-9\\cdot {2}^{-x})=$" :question/worked-solution "First, we rewrite the limit using the algebra of limits, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(-9\\cdot {2}^{-x}) & =-9\\cdot {lim}_{x\\to \\infty }({2}^{-1})^{x} \\\\  & =-9\\cdot {lim}_{x\\to \\infty }{(\\frac{1}{2})}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={(\\frac{1}{2})}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/7d3477662fd9a07c6f1543728a1562f4fed62f91350741078a7d568f500d32d0.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }{(\\frac{1}{2})}^{x}=0.\n$$\n\nSo, we conclude that\n\n$$\n-9\\cdot {lim}_{x\\to \\infty }{(\\frac{1}{2})}^{x}=-9\\cdot 0=0.\n$$"}] [{:db/id #edb/ref 17592186251027 :knowledge-point/_questions [{:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659" :knowledge-point/title "Evaluating Infinite Limits Using the Laws of Exponents and the Algebra of Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5d76e6a-7df5-52c7-8e65-d097ae988904" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186251029} {:answer/id #uuid "5fe3e49f-442e-5536-b748-8de93ab540ee" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186251030} {:answer/id #uuid "733c0467-c86a-5e48-bc79-ab96b5b855ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7{e}^{-8}}{3}" :db/id #edb/ref 17592186251031} {:answer/id #uuid "346c349f-392a-5106-9d92-2b1c9cba1cf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186251032} {:answer/id #uuid "fae3da32-923d-5b61-9bb9-87cceb0d6239" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251033}] :answer-field/correct {:answer/id #uuid "fae3da32-923d-5b61-9bb9-87cceb0d6239" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251033} :answer-field/id #uuid "07583f80-c315-5395-83e5-a8f8894a66be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251028}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "dd3c06c9-dbfe-5182-99f9-0df8e9850320" :question/math-academy-id "q-99515" :question/problem "${lim}_{x\\to -\\infty }\\frac{7{e}^{3x-8}}{3}=$" :question/worked-solution "We can use the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{7{e}^{3x-8}}{3} & ={lim}_{x\\to -\\infty }(\\frac{7}{3}\\cdot {e}^{3x}\\cdot {e}^{-8}) \\\\  & =\\frac{7{e}^{-8}}{3}\\cdot {lim}_{x\\to -\\infty }{e}^{3x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={e}^{3x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/df39137953015b819f3143e823f042ac759a8dfb356821ce6f623b40924b0b0c.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore, \n\n$$\n{lim}_{x\\to -\\infty }{e}^{3x}=0.\n$$\n\nWe conclude that\n\n$$\n\\frac{7{e}^{-8}}{3}\\cdot {lim}_{x\\to -\\infty }{e}^{3x}=\\frac{7{e}^{-8}}{3}\\cdot 0=0.\n$$"}]}
