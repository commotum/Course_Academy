erence/mathacademy/question-capture/13943873/assets/bf852abc3bc3e365b652b0d1d9f99f21bb1f431cbe09f106740eee61cecab86e.png)\n\nFrom the graph, we see that the function increases without bound as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }{e}^{3x}=\\infty .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-47070/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659"] :knowledge-point/questions ["q-47070"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47073/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "4453c3e7-4c7d-53b0-8903-8e6ea1dae68b" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-47073/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "2bc8b45f-c082-5425-a4b8-5b1b00351b50" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-47073/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "53d70ecc-053d-5556-960b-e8c9b905cd7d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-47073/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "911b0063-a626-5cd7-a823-8c906fb6facd" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-47073/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "b92f8e16-08f4-51a7-b22c-7dab7b8a703a" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-47073/selection" :answer-field/id #uuid "44c29b28-87a5-5684-b499-60b95c929872" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47073/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-47073/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-47073/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-47073/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-47073/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-47073/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408"] :db/ensure [:answer-field/validate]} {:db/id "q-47073" :question/id #uuid "f80da774-0856-58ab-9260-32b1a2f538ff" :question/math-academy-id "q-47073" :question/problem "${lim}_{x\\to -\\infty }{2}^{3x-8}=$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{2}^{3x-8} & ={lim}_{x\\to -\\infty }{2}^{3x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{({2}^{3})}^{x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{8}^{x}\\cdot (\\frac{1}{256}) \\\\  & =(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={8}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/85319605a7c7b57d4c7ed29b8d409e3169f3331775580b91b70e2be99fef7986.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{8}^{x}=0.\n$$\n\nSo, we conclude that \n\n$$\n(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}=(\\frac{1}{256})\\cdot 0=0\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-47073/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659"] :knowledge-point/questions ["q-47073"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47081/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "a545a93c-a506-5224-a308-b31c75cf0c09" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186114123 :answer-field/choices ["q-47081/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-47081"] :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }{e}^{(-3x+1)} & ={lim}_{x\\to \\infty }{e}^{-3x}\\cdot {e}^{1} \\\\  & ={lim}_{x\\to \\infty }{e}^{-3x}\\cdot e \\\\  & =e\\cdot {lim}_{x\\to \\infty }{e}^{-3x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={e}^{-3x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/c3d9e0bfa0b7514713c01289fc63fde7b0bd0dab525ad50617a9e908fd117060.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ increases. Therefore,\n\n$$\n{lim}_{x\\to \\infty }{e}^{-3x}=0.\n$$\n\nTherefore:\n\n$$\ne\\cdot {lim}_{x\\to \\infty }{e}^{-3x}=e\\cdot 0=0\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-339417/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "9d98f1d6-553f-584d-ac4f-7ba5e172292a" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-339417/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2fba77c8-3557-5881-95d4-d8c0513fe4af" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-339417/field-1" :answer-field/id #uuid "b1c582a4-b176-5b24-8b2a-5acf8646191b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339417/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer-field/choices ["q-339417/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" "q-339417/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-339417" :question/id #uuid "d10630fd-3a94-50f6-b43a-e939590b1c90" :question/math-academy-id "q-339417" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to -\\infty }(-\\frac{1}{2}\\cdot {3}^{2-3x})=$\n{{field-1}}" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-\\frac{1}{2}\\cdot {3}^{2-3x}) & =(-\\frac{1}{2})\\cdot {lim}_{x\\to -\\infty }{3}^{2-3x} \\\\  & =(-\\frac{1}{2})\\cdot {lim}_{x\\to -\\infty }({3}^{2}\\cdot {3}^{-3x}) \\\\  & =(-\\frac{1}{2})\\cdot {3}^{2}\\cdot {lim}_{x\\to -\\infty }{3}^{-3x} \\\\  & =(-\\frac{1}{2})\\cdot 9\\cdot {lim}_{x\\to -\\infty }{({3}^{-3})}^{x} \\\\  & =(-\\frac{9}{2})\\cdot {lim}_{x\\to -\\infty }{(\\frac{1}{{3}^{3}})}^{x} \\\\  & =(-\\frac{9}{2})\\cdot {lim}_{x\\to -\\infty }{(\\frac{1}{27})}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={(\\frac{1}{27})}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/60c4ef99a2617fd076e6350ba68e14311ebc41b9b0f33fcc07b871198dfc103d.png)\n\nFrom the graph, we see that the function increases without bound as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{(\\frac{1}{27})}^{x}=\\infty .\n$$\n\nTherefore, we conclude that\n\n$$\n(-\\frac{9}{2})\\cdot {lim}_{x\\to -\\infty }{(\\frac{1}{27})}^{x}=(-\\frac{9}{2})\\cdot \\infty =-\\infty .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-339417/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659"] :knowledge-point/questions ["q-339417"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99515/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fae3da32-923d-5b61-9bb9-87cceb0d6239" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-99515/selection/9c21844484e032febb7cb2b19df2231cb326bd5972b64ecc9a0496f4ba2559c3" :answer/id #uuid "733c0467-c86a-5e48-bc79-ab96b5b855ec" :answer/type :answer.type/math :answer/value "\\frac{7{e}^{-8}}{3}" :db/ensure [:answer/validate]} {:db/id "q-99515/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "d5d76e6a-7df5-52c7-8e65-d097ae988904" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-99515/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "5fe3e49f-442e-5536-b748-8de93ab540ee" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-99515/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "346c349f-392a-5106-9d92-2b1c9cba1cf0" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-99515/selection" :answer-field/id #uuid "07583f80-c315-5395-83e5-a8f8894a66be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99515/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-99515/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-99515/selection/9c21844484e032febb7cb2b19df2231cb326bd5972b64ecc9a0496f4ba2559c3" "q-99515/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-99515/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" "q-99515/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81"] :db/ensure [:answer-field/validate]} {:db/id "q-99515" :question/id #uuid "dd3c06c9-dbfe-5182-99f9-0df8e9850320" :question/math-academy-id "q-99515" :question/problem "${lim}_{x\\to -\\infty }\\frac{7{e}^{3x-8}}{3}=$" :question/worked-solution "We can use the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{7{e}^{3x-8}}{3} & ={lim}_{x\\to -\\infty }(\\frac{7}{3}\\cdot {e}^{3x}\\cdot {e}^{-8}) \\\\  & =\\frac{7{e}^{-8}}{3}\\cdot {lim}_{x\\to -\\infty }{e}^{3x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={e}^{3x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13943873/assets/df39137953015b819f3143e823f042ac759a8dfb356821ce6f623b40924b0b0c.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore, \n\n$$\n{lim}_{x\\to -\\infty }{e}^{3x}=0.\n$$\n\nWe conclude that\n\n$$\n\\frac{7{e}^{-8}}{3}\\cdot {lim}_{x\\to -\\infty }{e}^{3x}=\\frac{7{e}^{-8}}{3}\\cdot 0=0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-99515/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659"] :knowledge-point/questions ["q-99515"] :db/ensure [:knowledge-point/validate]}]
