899 1000 #edb/ref 17592186287901 13194139534430 true] [17592186287899 1000 #edb/ref 17592186287902 13194139534430 true] [17592186287899 1000 #edb/ref 17592186287903 13194139534430 true] [17592186287899 1000 #edb/ref 17592186287904 13194139534430 true] [17592186287899 1040 #edb/ref 17592186045450 13194139534430 true] [17592186287899 1041 "selection" 13194139534430 true] [17592186287899 1104 #edb/ref 17592186287902 13194139534430 true] [17592186287899 1110 #uuid "e2a85cb6-5cf8-590a-ba94-3f56b960b346" 13194139534430 true] [17592186287900 1034 "33\\,126" 13194139534430 true] [17592186287900 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287900 1111 #uuid "56e18e89-aea2-59f5-a0f0-d5e526fec283" 13194139534430 true] [17592186287901 1034 "44\\,278" 13194139534430 true] [17592186287901 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287901 1111 #uuid "e04267de-99ae-5fee-81f0-8d487adab2a1" 13194139534430 true] [17592186287902 1034 "37\\,563" 13194139534430 true] [17592186287902 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287902 1111 #uuid "901ac479-663f-526a-bda7-0095c518b84f" 13194139534430 true] [17592186287903 1034 "35\\,986" 13194139534430 true] [17592186287903 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287903 1111 #uuid "8a42f3d4-3930-592e-951e-dd0415c135c8" 13194139534430 true] [17592186287904 1034 "43\\,245" 13194139534430 true] [17592186287904 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287904 1111 #uuid "a5552214-ac45-5197-81e7-05d92511937d" 13194139534430 true] [17592186287905 1017 #edb/ref 17592186287906 13194139534430 true] [17592186287905 1017 #edb/ref 17592186287909 13194139534430 true] [17592186287905 1089 "q-274561" 13194139534430 true] [17592186287905 1091 #edb/ref 17592186045463 13194139534430 true] [17592186287905 1100 "Find, **in ascending order and rounded to the nearest integer**, the two solutions to the equation $\\operatorname{cot}⁡x=\\frac{1}{2}$  for ${0}^{∘}\\le x<{360}^{∘}.$\n\n**In ascending order,** the solutions are $x=$ \n{{field-1}}${}^{∘}$ and $x=$ \n{{field-2}}${}^{∘}.$" 13194139534430 true] [17592186287905 1113 #uuid "5ed1c596-9728-51d1-9ce6-4b4e58954fb6" 13194139534430 true] [17592186287905 1145 "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=2.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(2)=(63.434\\,9…)^{∘}≈{63.435}^{∘}\n$$\n\nSince ${63.435}^{∘}$ lies inside the given domain, our first solution, rounded to the nearest integer, is ${x}_{1}={63}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$\nHence,\n\n$$\n{x}_{2}={180}^{∘}+x={180}^{∘}+{63.435}^{∘}≈{243}^{∘},\n$$\n\nrounded to the nearest integer.\n\nTherefore, in ascending order, the solutions are $x={63}^{∘}$ and $x={243}^{∘}.$" 13194139534430 true] [17592186287906 1000 #edb/ref 17592186287907 13194139534430 true] [17592186287906 1000 #edb/ref 17592186287908 13194139534430 true] [17592186287906 1040 #edb/ref 17592186045449 13194139534430 true] [17592186287906 1041 "field-1" 13194139534430 true] [17592186287906 1104 #edb/ref 17592186287908 13194139534430 true] [17592186287906 1110 #uuid "302f74cc-153e-5c40-9456-58665a27d091" 13194139534430 true] [17592186287907 1034 "64" 13194139534430 true] [17592186287907 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287907 1111 #uuid "a5883a09-7c42-552f-b4fe-2e0163e8c270" 13194139534430 true] [17592186287908 1034 "63" 13194139534430 true] [17592186287908 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287908 1111 #uuid "2965aeaf-0e95-59fd-8ebe-ffaff20a8dc0" 13194139534430 true] [17592186287909 1000 #edb/ref 17592186287910 13194139534430 true] [17592186287909 1040 #edb/ref 17592186045449 13194139534430 true] [17592186287909 1041 "field-2" 13194139534430 true] [17592186287909 1104 #edb/ref 17592186287910 13194139534430 true] [17592186287909 1110 #uuid "0b744595-480c-5bf3-b48d-25f42ec751ff" 13194139534430 true] [17592186287910 1034 "243" 13194139534430 true] [17592186287910 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287910 1111 #uuid "ace6c7bf-8a1b-5f25-8196-dd5768c28aa1" 13194139534430 true] [17592186287911 1017 #edb/ref 17592186287912 13194139534430 true] [17592186287911 1017 #edb/ref 17592186287914 13194139534430 true] [17592186287911 1089 "q-330609" 13194139534430 true] [17592186287911 1091 #edb/ref 17592186045465 13194139534430 true] [17592186287911 1100 "Find the two solutions to the equation $\\operatorname{cot}⁡x=\\frac{1}{\\sqrt{3}}$ for $-\\pi <x<\\pi .$\n\n**In ascending order,** the solutions are $x=$ \n{{field-1}}\nand $x=$ \n{{field-2}}." 13194139534430 true] [17592186287911 1113 #uuid "8c031cfa-13ed-5750-8fa4-f8a5e9a5765e" 13194139534430 true] [17592186287911 1145 "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{(\\frac{1}{\\sqrt{3}})}=\\sqrt{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(\\sqrt{3})=\\frac{\\pi }{3}\n$$\n\nSince $\\frac{\\pi }{3}$ lies in the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nTo generate more solutions, we add or subtract integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & =(-2)\\cdot \\pi +x=-\\pi +\\frac{\\pi }{3}=-\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\frac{2\\pi }{3}$ and $x=\\frac{\\pi }{3}.$" 13194139534430 true] [17592186287912 1000 #edb/ref 17592186287913 13194139534430 true] [17592186287912 1040 #edb/ref 17592186045449 13194139534430 true] [17592186287912 1041 "field-1" 13194139534430 true] [17592186287912 1104 #edb/ref 17592186287913 13194139534430 true] [17592186287912 1110 #uuid "ef20d2ee-3068-5877-9e89-41f18a25dfa2" 13194139534430 true] [17592186287913 1034 "-\\frac{2\\pi}{3}" 13194139534430 true] [17592186287913 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287913 1111 #uuid "7bc1e540-8ee5-526e-b476-882f5edfe7a9" 13194139534430 true] [17592186287914 1000 #edb/ref 17592186287915 13194139534430 true] [17592186287914 1040 #edb/ref 17592186045449 13194139534430 true] [17592186287914 1041 "field-2" 13194139534430 true] [17592186287914 1104 #edb/ref 17592186287915 13194139534430 true] [17592186287914 1110 #uuid "f0f8ad7e-daa7-541e-ab4b-ea2292adbab1" 13194139534430 true] [17592186287915 1034 "\\frac{\\pi}{3}" 13194139534430 true] [17592186287915 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287915 1111 #uuid "8ffe61de-9801-53a1-8861-019d7fe8180f" 13194139534430 true] [17592186287916 1017 #edb/ref 17592186287917 13194139534430 true] [17592186287916 1089 "q-80193" 13194139534430 true] [17592186287916 1091 #edb/ref 17592186045463 13194139534430 true] [17592186287916 1100 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $4=4-\\frac{3\\operatorname{cot}⁡x}{2}$ for $-2\\pi <x<0,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139534430 true] [17592186287916 1113 #uuid "7efbc2c8-eaf3-59d3-ac9a-ab6526fedd99" 13194139534430 true] [17592186287916 1145 "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}4 & =4-\\frac{3\\operatorname{cot}⁡x}{2} \\\\ 0 & =-\\frac{3\\operatorname{cot}⁡x}{2} \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & =\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{2}$ lies outside the given domain, it is not a solution.\n\nTo find more solutions, we subtract integer multiples of $\\pi $ as follows:\n\n$$\n\\begin{aligned}{x}_{1} & =-\\pi +x=-\\pi +\\frac{\\pi }{2}=-\\frac{\\pi }{2}, \\\\ {x}_{2} & =-2\\pi +x=-2\\pi +\\frac{\\pi }{2}=-\\frac{3\\pi }{2}.\\end{aligned}\n$$\n\nSo, our solutions are $x=-\\frac{3\\pi }{2},-\\frac{\\pi }{2}.$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=(-\\frac{3\\pi }{2})\\cdot (-\\frac{\\pi }{2})=\\frac{3{\\pi }^{2}}{4}.\n$$" 13194139534430 true] [17592186287917 1000 #edb/ref 17592186287918 13194139534430 true] [17592186287917 1000 #edb/ref 17592186287919 13194139534430 true] [17592186287917 1000 #edb/ref 17592186287920 13194139534430 true] [17592186287917 1000 #edb/ref 17592186287921 13194139534430 true] [17592186287917 1000 #edb/ref 17592186287922 13194139534430 true] [17592186287917 1040 #edb/ref 17592186045450 13194139534430 true] [17592186287917 1041 "selection" 13194139534430 true] [17592186287917 1104 #edb/ref 17592186287919 13194139534430 true] [17592186287917 1110 #uuid "d60cb6f7-f0a2-50ee-b9c1-48b1dcdd1445" 13194139534430 true] [17592186287918 1034 "-\\frac{9{\\pi }^{2}}{4}" 13194139534430 true] [17592186287918 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287918 1111 #uuid "74bbe537-0393-5197-93c9-2d60008d0431" 13194139534430 true] [17592186287919 1034 "\\frac{3{\\pi }^{2}}{4}" 13194139534430 true] [17592186287919 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287919 1111 #uuid "7ad5e99a-ed6f-5906-ac8f-2c9367c35251" 13194139534430 true] [17592186287920 1034 "-\\frac{3{\\pi }^{2}}{4}" 13194139534430 true] [17592186287920 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287920 1111 #uuid "d77aa76e-58c5-547b-8932-62592889bbef" 13194139534430 true] [17592186287921 1034 "\\frac{{\\pi }^{2}}{16}" 13194139534430 true] [17592186287921 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287921 1111 #uuid "e9a94f28-0536-52d2-a217-6dea9d6ce0c1" 13194139534430 true] [17592186287922 1034 "\\frac{{\\pi }^{2}}{4}" 13194139534430 true] [17592186287922 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287922 1111 #uuid "86faa83b-6ba5-5224-9e36-bc20a3994ef4" 13194139534430 true] [17592186287923 1017 #edb/ref 17592186287924 13194139534430 true] [17592186287923 1089 "q-80197" 13194139534430 true] [17592186287923 1091 #edb/ref 17592186045465 13194139534430 true] [17592186287923 1100 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2=2-9\\operatorname{cot}⁡x$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139534430 true] [17592186287923 1113 #uuid "936da1a3-12b9-5773-8bc1-7b9d9679b27f" 13194139534430 true] [17592186287923 1145 "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}2 & =2-9\\operatorname{cot}⁡x \\\\ 0 & =-9\\operatorname{cot}⁡x \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & ={90}^{∘}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}={90}^{∘}.$\n\nTo find more solutions, we subtract integer multiples of ${180}^{∘}$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{180}^{∘} \\\\  & ={90}^{∘}-{180}^{∘} \\\\  & =-{90}^{∘}\\end{aligned}\n$$\n\nSo, our solutions are $x=-{90}^{∘},{90}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n90\\cdot (-90)=-8\\,100.\n$$" 13194139534430 true] [17592186287924 1000 #edb/ref 17592186287925 13194139534430 true] [17592186287924 1000 #edb/ref 17592186287926 13194139534430 true] [17592186287924 1000 #edb/ref 17592186287927 13194139534430 true] [17592186287924 1000 #edb/ref 17592186287928 13194139534430 true] [17592186287924 1000 #edb/ref 17592186287929 13194139534430 true] [17592186287924 1040 #edb/ref 17592186045450 13194139534430 true] [17592186287924 1041 "selection" 13194139534430 true] [17592186287924 1104 #edb/ref 17592186287926 13194139534430 true] [17592186287924 1110 #uuid "25e4367d-682c-5be9-9f1b-28a77c4788e8" 13194139534430 true] [17592186287925 1034 "32\\,400" 13194139534430 true] [17592186287925 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287925 1111 #uuid "ff90101b-5754-5d9f-9563-3d35a247e18e" 13194139534430 true] [17592186287926 1034 "-8\\,100" 13194139534430 true] [17592186287926 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287926 1111 #uuid "067fce08-834f-5ba1-adfc-c279a230df12" 13194139534430 true] [17592186287927 1034 "-16\\,200" 13194139534430 true] [17592186287927 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287927 1111 #uuid "28a509ea-f23e-569a-880d-3d1ae26854fc" 13194139534430 true] [17592186287928 1034 "16\\,200" 13194139534430 true] [17592186287928 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287928 1111 #uuid "fe93438d-d43d-53e7-ad22-025c93d4060e" 13194139534430 true] [17592186287929 1034 "-24\\,300" 13194139534430 true] [17592186287929 1103 #edb/ref 17592186045453 13194139534430 true] [17592186287929 1111 #uuid "f2875082-9372-54e8-b87f-6cb0208b210f" 13194139534430 true]] :edb/tempids {"q-120626" 17592186287898 "q-120626/selection" 17592186287899 "q-120626/selection/55d644f95067506b0501823b95d79065c4902d8fa14dff6b18020d780d7e5e93" 17592186287900 "q-120626/selection/9d50b1d7744585d8cee490eeea5347cac69eea5423f24b662e39575402d6f52b" 17592186287901 "q-120626/selection/bbcf93762385061161c3b66bbc3d8289551fba3fff7c208261ec