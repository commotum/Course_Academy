lection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6cbb2e28-8edf-5a07-bf8a-8dc623c6395c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-70669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "34e43c7e-8758-577d-9140-107f40124a98" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-70669/selection" :answer-field/id #uuid "f64ffa6c-1d9e-5cd4-93bb-384309b9a9aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-70669/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-70669/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-70669/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-70669/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-70669/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-70669" :question/id #uuid "afeaf4fc-dbfe-5597-a62c-d8cecbf34d0e" :question/math-academy-id "q-70669" :question/is-example false :question/problem "Which of the following statements are true regarding the function $y=cot⁡x?$ Assume $n$ is an integer.\n\n- The function has no minimum value. $$\n- $x=-4\\pi $ is in the domain of the function. $$\n- $x=-\\frac{3\\pi }{2}$ is a zero of the function." :question/worked-solution "Let's plot the graph of $y=cot⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934292/assets/8bc549c68a3bc5b7989ac1835e4bb58183066c7797264b8cccd4f3fd2c895056.png)\n\nNow, let's go through each statement.\n\n- Statement I is true. The function has no minimum or maximum value. $$\n\n- Statement II is false. The function is defined for all real numbers except the values $n\\pi $ for any integer $n$, thus it is not defined for $x=-4\\pi .$\n\n- Statement III is true. The zeros of $y=cot⁡x$ occur at $\\frac{\\pi }{2}+n\\pi ,$ for any integer $n.$ Therefore, $x=-\\frac{3\\pi }{2}$ is a zero of the function." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6a18aadb-3e8a-54d7-a5d7-e78208e77675"] :knowledge-point/questions ["q-70669"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42933/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "0f531995-1bc4-5b32-a6e6-e9a6b016b95e" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-42933/selection/e1381ae7c7a92b4aa7f0a2bd7d1adabb4c69d577c3ac304b32f6f859826b96b8" :answer/id #uuid "8ca24f42-91ed-5dc9-bea1-8bddae3e3671" :answer/type :answer.type/text :answer/value "All" :db/ensure [:answer/validate]} {:db/id "q-42933/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "7693f898-6124-5580-a695-c75ffc1d8751" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-42933/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "fcc5cd1f-23a8-5186-a1ad-2f72f56dc41b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-42933/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "f6a6a285-8d9f-5a7b-8e1a-7135661fdbc3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-42933/selection" :answer-field/id #uuid "6affbe6b-8ee4-5b11-afb9-c2624131016d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42933/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9