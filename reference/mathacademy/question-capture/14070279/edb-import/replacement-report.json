        {
          "question": "e-8528",
          "field": null,
          "attribute": "question/problem",
          "value": "The table below gives the values of $\\Phi^{-1}(p)$ for different values of $p,$ where $p = \\Phi(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z \\leq z) = 0.60.$\n\n| $\\quad p \\quad$ | $0.60$ | $0.65$ | $0.70$ | $0.75$ | $0.80$ | $0.85$ | $0.90$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $\\Phi^{-1}(p)$ | $\\,0.2533\\,$ | $\\,0.3853\\,$ | $\\,0.5244\\,$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ |",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070279/example-8528.json",
          "file_sha256": "d009340266a6e3d89cab46b6eb2268722ff571ede0b7e68d8e36978bc660e53b"
        }
