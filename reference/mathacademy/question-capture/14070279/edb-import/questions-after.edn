31d70-1e74-5427-b7e0-f088053f7f24" :answer/type {:db/ident :answer.type/math} :answer/value "0.3853" :db/id #edb/ref 17592186366560} {:answer/id #uuid "8906692e-f6bd-50df-aab5-17e689a06231" :answer/type {:db/ident :answer.type/math} :answer/value "0.1257" :db/id #edb/ref 17592186366561} {:answer/id #uuid "0990af82-b4b1-5fae-8636-d122e5d0e11b" :answer/type {:db/ident :answer.type/math} :answer/value "1.2816" :db/id #edb/ref 17592186366562} {:answer/id #uuid "9f2a8c0d-fcb2-5b11-a0e9-8065dc3b1443" :answer/type {:db/ident :answer.type/math} :answer/value "0.8416" :db/id #edb/ref 17592186366563} {:answer/id #uuid "cb91796d-628d-532d-8be9-cb4f374207a5" :answer/type {:db/ident :answer.type/math} :answer/value "0.1527" :db/id #edb/ref 17592186366564}] :answer-field/correct {:answer/id #uuid "8906692e-f6bd-50df-aab5-17e689a06231" :answer/type {:db/ident :answer.type/math} :answer/value "0.1257" :db/id #edb/ref 17592186366561} :answer-field/id #uuid "bca7b128-73bd-5979-9d1f-62dabc09e6f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366559}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "55aff3a4-f575-5882-9a3e-6f27998d9d2a" :question/math-academy-id "q-96946" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z>z)=0.45.$\n\n| $\\,p\\,$ | $0.55$ | $0.60$ | $0.65$ | $0.70$ | $0.75$ | $0.80$ | $0.85$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.1257\\,$ | $\\,0.2533\\,$ | $\\,0.3853\\,$ | $\\,0.5244\\,$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ |" :question/worked-solution "First, we express the given information in terms of $Φ,$ using the complement:\n\n$$\n\\begin{aligned}P(Z>z) & =0.45 \\\\ 1-P(Z\\le z) & =0.45 \\\\ 1-Φ(z) & =0.45 \\\\ Φ(z) & =1-0.45 \\\\ Φ(z) & =0.55\\end{aligned}\n$$\n\nSo, we are looking for the value of $z$ such that\n\n$$\nz={Φ}^{-1}(0.55).\n$$\n\nWe look for the column in the table that corresponds to $p=0.55,$ and we find that\n\n$$\np=0.55\\,⇒\\,{Φ}^{-1}(p)=0.1257.\n$$\n\nTherefore, we have\n\n$$\nz={Φ}^{-1}(0.55)=0.1257.\n$$"}] [{:db/id #edb/ref 17592186366565 :knowledge-point/_questions [{:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef" :knowledge-point/title "Using a Percentage Points Table and Symmetry To Find the Z-Score for a Given Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9545b5c2-d2e3-558e-a9fc-8ee7c1aa63c8" :answer/type {:db/ident :answer.type/math} :answer/value "0.2533" :db/id #edb/ref 17592186366567} {:answer/id #uuid "477a04db-5193-5af5-80d4-478ffbb31658" :answer/type {:db/ident :answer.type/math} :answer/value "0.5244" :db/id #edb/ref 17592186366568} {:answer/id #uuid "0d9354ba-2d2c-59b4-ab6f-ef00a1c27e13" :answer/type {:db/ident :answer.type/math} :answer/value "1.8016" :db/id #edb/ref 17592186366569} {:answer/id #uuid "a89babfb-df47-5bcb-8511-20b2e0f4a845" :answer/type {:db/ident :answer.type/math} :answer/value "1.2816" :db/id #edb/ref 17592186366570} {:answer/id #uuid "9c5f1d27-ed75-5589-b3ff-d0f6c575c1c7" :answer/type {:db/ident :answer.type/math} :answer/value "0.4522" :db/id #edb/ref 17592186366571}] :answer-field/correct {:answer/id #uuid "477a04db-5193-5af5-80d4-478ffbb31658" :answer/type {:db/ident :answer.type/math} :answer/value "0.5244" :db/id #edb/ref 17592186366568} :answer-field/id #uuid "a441da2e-ed54-5bb4-88de-6330735cda3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366566}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a1b5f23c-078f-5914-87a2-fd761af5ff5d" :question/math-academy-id "q-96948" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z>z)=0.30.$\n\n| $\\,p\\,$ | $0.55$ | $0.60$ | $0.65$ | $0.70$ | $0.75$ | $0.80$ | $0.85$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.1257\\,$ | $\\,0.2533\\,$ | $\\,0.3853\\,$ | $\\,0.5244\\,$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ |" :question/worked-solution "First, we express the given information in terms of $Φ,$ using the complement:\n\n$$\n\\begin{aligned}P(Z>z) & =0.30 \\\\ 1-P(Z\\le z) & =0.30 \\\\ 1-Φ(z) & =0.30 \\\\ Φ(z) & =1-0.30 \\\\ Φ(z) & =0.70\\end{aligned}\n$$\n\nSo, we are looking for the value of $z$ such that\n\n$$\nz={Φ}^{-1}(0.70).\n$$\n\nWe look for the column in the table that corresponds to $p=0.70,$ and we find that\n\n$$\np=0.70\\,⇒\\,{Φ}^{-1}(p)=0.5244.\n$$\n\nTherefore, we have\n\n$$\nz={Φ}^{-1}(0.70)=0.5244.\n$$"}] [{:db/id #edb/ref 17592186366572 :knowledge-point/_questions [{:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef" :knowledge-point/title "Using a Percentage Points Table and Symmetry To Find the Z-Score for a Given Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1097f7f-ea7f-52e8-a321-f75ba8fb1f0f" :answer/type {:db/ident :answer.type/math} :answer/value "-1.9600" :db/id #edb/ref 17592186366574} {:answer/id #uuid "b827469b-cc52-5842-8257-97bcc381df02" :answer/type {:db/ident :answer.type/math} :answer/value "-3.0902" :db/id #edb/ref 17592186366575} {:answer/id #uuid "e8882563-d76d-577b-81eb-6b1a891631d8" :answer/type {:db/ident :answer.type/math} :answer/value "-2.5758" :db/id #edb/ref 17592186366576} {:answer/id #uuid "875be153-86ce-5044-8cab-467ca98dc639" :answer/type {:db/ident :answer.type/math} :answer/value "3.0902" :db/id #edb/ref 17592186366577} {:answer/id #uuid "fc4de279-a7e0-5476-b6e6-b608b3cbd13c" :answer/type {:db/ident :answer.type/math} :answer/value "2.3263" :db/id #edb/ref 17592186366578}] :answer-field/correct {:answer/id #uuid "b827469b-cc52-5842-8257-97bcc381df02" :answer/type {:db/ident :answer.type/math} :answer/value "-3.0902" :db/id #edb/ref 17592186366575} :answer-field/id #uuid "4f081078-f2fd-5438-b46f-05ee694d55a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366573}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a86c37e2-7663-5abc-a0fe-06de755ff8fe" :question/math-academy-id "q-96954" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z\\le z)=0.001.$\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |" :question/worked-solution "From the table, notice that\n\n$$\nP(Z\\le 3.0902)=0.999.\n$$\n\nTherefore, we have\n\n$$\nP(Z\\ge 3.0902)=1-0.999=0.001.\n$$\n\nBy the symmetry of the standard normal distribution, we have\n\n$$\nΦ(-3.0902)=0.001.\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070279/assets/12d4d863466f8a7c1ff72d5c08fed94097ac23d94e04a2976603a3f3a78f6261.png)\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}Φ(-3.0902) & =0.001 \\\\ P(Z\\le -3.0902) & =0.001.\\end{aligned}\n$$\n\nTherefore, the required value of $z$ is $-3.0902.$"}] [{:db/id #edb/ref 17592186366579 :knowledge-point/_questions [{:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef" :knowledge-point/title "Using a Percentage Points Table and Symmetry To Find the Z-Score for a Given Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea5e94bf-266e-5c20-8f24-bd1e8c8c9136" :answer/type {:db/ident :answer.type/math} :answer/value "-1.9600" :db/id #edb/ref 17592186366581} {:answer/id #uuid "76e4db4a-af40-5d42-843e-7d98196dae25" :answer/type {:db/ident :answer.type/math} :answer/value "-2.1701" :db/id #edb/ref 17592186366582} {:answer/id #uuid "a1b1781b-7444-50cf-85e4-988767515f98" :answer/type {:db/ident :answer.type/math} :answer/value "-2.5758" :db/id #edb/ref 17592186366583} {:answer/id #uuid "ce1f82da-ab6b-5ba7-baef-8c506711bc07" :answer/type {:db/ident :answer.type/math} :answer/value "1.8808" :db/id #edb/ref 17592186366584} {:answer/id #uuid "c4dc93a8-4b2b-50ed-9b32-f919e085a482" :answer/type {:db/ident :answer.type/math} :answer/value "1.6449" :db/id #edb/ref 17592186366585}] :answer-field/correct {:answer/id #uuid "ea5e94bf-266e-5c20-8f24-bd1e8c8c9136" :answer/type {:db/ident :answer.type/math} :answer/value "-1.9600" :db/id #edb/ref 17592186366581} :answer-field/id #uuid "f235d5dd-e377-5f0b-9629-5fac0b485f6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366580}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "246a92bf-211a-579b-ba0c-15208a1d5843" :question/math-academy-id "q-96962" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z\\le z)=0.025.$\n\n| $\\,p\\,$ | $0.965$ | $0.970$ | $0.975$ | $0.980$ | $0.985$ | $0.990$ | $0.995$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.8119\\,$ | $\\,1.8808\\,$ | $\\,1.9600\\,$ | $\\,2.0537\\,$ | $\\,2.1701\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ |" :question/worked-solution "From the table, notice that\n\n$$\nP(Z\\le 1.9600)=0.975.\n$$\n\nTherefore, we have\n\n$$\nP(Z\\ge 1.9600)=1-0.975=0.025.\n$$\n\nBy the symmetry of the standard normal distribution, we have\n\n$$\nΦ(-1.9600)=0.025.\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070279/assets/8a3513b66e17745585f5f49ea3cb1b1c7241874159e3cfaca0e5f644d0b7a3c2.png)\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}Φ(-1.9600) & =0.025 \\\\ P(Z\\le -1.9600) & =0.025.\\end{aligned}\n$$\n\nTherefore, the required value of $z$ is $-1.9600.$"}]}
