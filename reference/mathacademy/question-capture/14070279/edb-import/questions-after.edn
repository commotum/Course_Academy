h} :answer/value "0.715" :db/id #edb/ref 17592186366539} {:answer/id #uuid "b7548500-7d51-5b17-bb69-b7ea35897d4f" :answer/type {:db/ident :answer.type/math} :answer/value "0.805" :db/id #edb/ref 17592186366540} {:answer/id #uuid "43dbb094-c9fa-51e2-8878-e69fc6c047d4" :answer/type {:db/ident :answer.type/math} :answer/value "0.815" :db/id #edb/ref 17592186366541} {:answer/id #uuid "d8779b90-a1a2-56c1-bd64-3ba04cc28e0d" :answer/type {:db/ident :answer.type/math} :answer/value "0.710" :db/id #edb/ref 17592186366542} {:answer/id #uuid "d6592998-dbe7-5d27-92b0-7f4cf8870074" :answer/type {:db/ident :answer.type/math} :answer/value "0.605" :db/id #edb/ref 17592186366543}] :answer-field/correct {:answer/id #uuid "b7548500-7d51-5b17-bb69-b7ea35897d4f" :answer/type {:db/ident :answer.type/math} :answer/value "0.805" :db/id #edb/ref 17592186366540} :answer-field/id #uuid "18372daf-2d1e-5039-b18c-56856057cbaf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366538}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "38a9dd9d-a37d-5e1a-ad08-7a30eae2673c" :question/math-academy-id "q-96863" :question/problem "Approximate the value of $z$ such that $P(Z\\le z)=0.7900$ using interval bisection.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.6\\,$ | $\\,0.7257\\,$ | $\\,0.7291\\,$ | $\\,0.7324\\,$ |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ |" :question/worked-solution "First, we find the two numbers in the table that $0.7900$ lies between. These numbers are $0.7881$ and $0.7910.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.7881 & <0.7900<0.7910\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(0.80) & <Φ(z)<Φ(0.81).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{0.80+0.81}{2}=0.805.\n$$"}] [{:db/id #edb/ref 17592186167423 :knowledge-point/_questions [{:knowledge-point/id #uuid "99f2c276-2eb0-5fe9-b46d-6cf30547a96e" :knowledge-point/title "Estimating the Z-Score for a Given Probability Using Interval Bisection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cd8493-039f-5963-acd0-48a8487eb6c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1.065" :db/id #edb/ref 17592186166087} {:answer/id #uuid "3e29c109-4f9f-5d67-a8a4-a80e08df0234" :answer/type {:db/ident :answer.type/math} :answer/value "-0.955" :db/id #edb/ref 17592186166088} {:answer/id #uuid "47a55b41-9102-5941-8890-4bef5118fc3e" :answer/type {:db/ident :answer.type/math} :answer/value "-0.855" :db/id #edb/ref 17592186166089} {:answer/id #uuid "5907d7f8-437e-5ee8-aaf6-ad60460fb9aa" :answer/type {:db/ident :answer.type/math} :answer/value "-1.055" :db/id #edb/ref 17592186166090} {:answer/id #uuid "59599ffe-cd83-5483-9a72-cfb0b1b5a829" :answer/type {:db/ident :answer.type/math} :answer/value "-0.965" :db/id #edb/ref 17592186166091}] :answer-field/correct {:answer/id #uuid "3e29c109-4f9f-5d67-a8a4-a80e08df0234" :answer/type {:db/ident :answer.type/math} :answer/value "-0.955" :db/id #edb/ref 17592186166088} :answer-field/id #uuid "b1403549-c546-5dfa-af76-838ad5ba5559" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166086}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e5650060-a5d4-5dd4-9f6c-28e1faca58f7" :question/math-academy-id "q-96869" :question/problem "Approximate the value of $z$ such that $P(Z\\le z)=0.1700$ using interval bisection.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.0\\,$ | $\\,0.1469\\,$ | $\\,0.1446\\,$ | $\\,0.1423\\,$ |\n| $\\,-0.9\\,$ | $\\,0.1711\\,$ | $\\,0.1685\\,$ | $\\,0.1660\\,$ |\n| $\\,-0.8\\,$ | $\\,0.1977\\,$ | $\\,0.1949\\,$ | $\\,0.1922\\,$ |" :question/requires-calculator true :question/worked-solution "First, we find the two numbers in the table that $0.1700$ lies between. These numbers are $0.1685$ and $0.1711.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.1685 & <0.1700<0.1711\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-0.96) & <Φ(z)<Φ(-0.95).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-0.96+(-0.95)}{2}=-0.955.\n$$"}] [{:db/id #edb/ref 17592186366544 :knowledge-point/_questions [{:knowledge-point/id #uuid "a54afd65-a69e-52dd-84eb-7cf936773678" :knowledge-point/title "Using a Percentage Points Table To Find the Z-Score for a Given Probability"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c70ee596-82a7-55b6-b6e1-fc3fab6962f6" :answer/type {:db/ident :answer.type/math} :answer/value "0.2533" :db/id #edb/ref 17592186366546} {:answer/id #uuid "e41626d8-9b30-5623-a54b-2432bede63ba" :answer/type {:db/ident :answer.type/math} :answer/value "0.5244" :db/id #edb/ref 17592186366547} {:answer/id #uuid "3c5fffeb-0c98-5b5b-b60b-5b6f248f6030" :answer/type {:db/ident :answer.type/math} :answer/value "1.2816" :db/id #edb/ref 17592186366548} {:answer/id #uuid "bb6ee009-8e04-5316-965d-eae31e537fff" :answer/type {:db/ident :answer.type/math} :answer/value "0.8416" :db/id #edb/ref 17592186366549} {:answer/id #uuid "2f9e5773-6e7a-528c-b125-f6aabb02434b" :answer/type {:db/ident :answer.type/math} :answer/value "0.6745" :db/id #edb/ref 17592186366550}] :answer-field/correct {:answer/id #uuid "bb6ee009-8e04-5316-965d-eae31e537fff" :answer/type {:db/ident :answer.type/math} :answer/value "0.8416" :db/id #edb/ref 17592186366549} :answer-field/id #uuid "42dd2798-0f73-5530-8850-f1c6ab46e26f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366545}] :quest