30 \\\\ Φ(z) & =1-0.30 \\\\ Φ(z) & =0.70\\end{aligned}\n$$\n\nSo, we are looking for the value of $z$ such that\n\n$$\nz={Φ}^{-1}(0.70).\n$$\n\nWe look for the column in the table that corresponds to $p=0.70,$ and we find that\n\n$$\np=0.70\\,⇒\\,{Φ}^{-1}(p)=0.5244.\n$$\n\nTherefore, we have\n\n$$\nz={Φ}^{-1}(0.70)=0.5244.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-96948/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef"] :knowledge-point/questions ["q-96948"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96962/selection/460d378fbd4a226154407ee7d26ca3303f0e7bfff427756fc68d54b117c1c06a" :answer/id #uuid "a1b1781b-7444-50cf-85e4-988767515f98" :answer/type :answer.type/math :answer/value "-2.5758" :db/ensure [:answer/validate]} {:db/id "q-96962/selection/a1dd8b1b895c564afb4416c363b3c56b46f6576b512bb802bd4eda8a641e19c0" :answer/id #uuid "c4dc93a8-4b2b-50ed-9b32-f919e085a482" :answer/type :answer.type/math :answer/value "1.6449" :db/ensure [:answer/validate]} {:db/id "q-96962/selection/45e0dc021118751c4bbf28a3fae13721b71134d40523a46617d7554c20c80b96" :answer/id #uuid "76e4db4a-af40-5d42-843e-7d98196dae25" :answer/type :answer.type/math :answer/value "-2.1701" :db/ensure [:answer/validate]} {:db/id "q-96962/selection/4feed522b896f285a4527bdda972fd05dd208787a24a45e7087e0f3c9f57ebbd" :answer/id #uuid "ce1f82da-ab6b-5ba7-baef-8c506711bc07" :answer/type :answer.type/math :answer/value "1.8808" :db/ensure [:answer/validate]} {:db/id "q-96962/selection/1b396188acb2202d7342759b2ffb12dab8434f2a46b5a26ec061bcfd3c7b5b26" :answer/id #uuid "ea5e94bf-266e-5c20-8f24-bd1e8c8c9136" :answer/type :answer.type/math :answer/value "-1.9600" :db/ensure [:answer/validate]} {:db/id "q-96962/selection" :answer-field/id #uuid "f235d5dd-e377-5f0b-9629-5fac0b485f6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96962/selection/1b396188acb2202d7342759b2ffb12dab8434f2a46b5a26ec061bcfd3c7b5b26" :answer-field/choices ["q-96962/selection/460d378fbd4a226154407ee7d26ca3303f0e7bfff427756fc68d54b117c1c06a" "q-96962/selection/a1dd8b1b895c564afb4416c363b3c56b46f6576b512bb802bd4eda8a641e19c0" "q-96962/selection/45e0dc021118751c4bbf28a3fae13721b71134d40523a46617d7554c20c80b96" "q-96962/selection/4feed522b896f285a4527bdda972fd05dd208787a24a45e7087e0f3c9f57ebbd" "q-96962/selection/1b396188acb2202d7342759b2ffb12dab8434f2a46b5a26ec061bcfd3c7b5b26"] :db/ensure [:answer-field/validate]} {:db/id "q-96962" :question/id #uuid "246a92bf-211a-579b-ba0c-15208a1d5843" :question/math-academy-id "q-96962" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z\\le z)=0.025.$\n\n| $\\,p\\,$ | $0.965$ | $0.970$ | $0.975$ | $0.980$ | $0.985$ | $0.990$ | $0.995$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.8119\\,$ | $\\,1.8808\\,$ | $\\,1.9600\\,$ | $\\,2.0537\\,$ | $\\,2.1701\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ |" :question/worked-solution "From the table, notice that\n\n$$\nP(Z\\le 1.9600)=0.975.\n$$\n\nTherefore, we have\n\n$$\nP(Z\\ge 1.9600)=1-0.975=0.025.\n$$\n\nBy the symmetry of the standard normal distribution, we have\n\n$$\nΦ(-1.9600)=0.025.\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14070279/assets/8a3513b66e17745585f5f49ea3cb1b1c7241874159e3cfaca0e5f644d0b7a3c2.png)\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}Φ(-1.9600) & =0.025 \\\\ P(Z\\le -1.9600) & =0.025.\\end{aligned}\n$$\n\nTherefore, the required value of $z$ is $-1.9600.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96962/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef"] :knowledge-point/questions ["q-96962"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96946/selection/63f8d91c0749a19441a707173c26f0295ea37de3bc8eb730fa5656b4d6299a07" :answer/id #uuid "8906692e-f6bd-50df-aab5-17e689a06231" :answer/type :answer.type/math :answer/value "0.1257" :db/ensure [:answer/validate]} {:db/id "q-96946/selection/ce4b0ffd8d15e30b9f87007a4af2441df7e4155517d3fb351c90964ea94df08a" :answer/id #uuid "cb91796d-628d-532d-8be9-cb4f374207a5" :answer/type :answer.type/math :answer/value "0.1527" :db/ensure [:answer/validate]} {:db/id "q-96946/selection/8bc15e9c1b29deedf75741681698116e2134223b212229a58da21d6394654afa" :answer/id #uuid "0990af82-b4b1-5fae-8636-d122e5d0e11b" :answer/type :answer.type/math :answer/value "1.2816" :db/ensure [:answer/validate]} {:db/id "q-96946/selection/2948492d91f287e83f60e4a776efe9e4eeabd045e43ca214592a69b27a92aabf" :answer/id #uuid "7a731d70-1e74-5427-b7e0-f088053f7f24" :answer/type :answer.type/math :answer/value "0.3853" :db/ensure [:answer/validate]} {:db/id "q-96946/selection/9b95625ba91247e58a76504f541de2cfa63b852230008da4f2cc520aa964fd83" :answer/id #uuid "9f2a8c0d-fcb2-5b11-a0e9-8065dc3b1443" :answer/type :answer.type/math :answer/value "0.8416" :db/ensure [:answer/validate]} {:db/id "q-96946/selection" :answer-field/id #uuid "bca7b128-73bd-5979-9d1f-62dabc09e6f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96946/selection/63f8d91c0749a19441a707173c26f0295ea37de3bc8eb730fa5656b4d6299a07" :answer-field/choices ["q-96946/selection/63f8d91c0749a19441a707173c26f0295ea37de3bc8eb730fa5656b4d6299a07" "q-96946/selection/ce4b0ffd8d15e30b9f87007a4af2441df7e4155517d3fb351c90964ea94df08a" "q-96946/selection/8bc15e9c1b29deedf75741681698116e2134223b212229a58da21d6394654afa" "q-96946/selection/2948492d91f287e83f60e4a776efe9e4eeabd045e43ca214592a69b27a92aabf" "q-96946/selection/9b95625ba91247e58a76504f541de2cfa63b852230008da4f2cc520aa964fd83"] :db/ensure [:answer-field/validate]} {:db/id "q-96946" :question/id #uuid "55aff3a4-f575-5882-9a3e-6f27998d9d2a" :question/math-academy-id "q-96946" :question/problem "The table below gives the values of ${Φ}^{-1}(p)$ for different values of $p,$ where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. Find the value of $z$ such that $P(Z>z)=0.45.$\n\n| $\\,p\\,$ | $0.55$ | $0.60$ | $0.65$ | $0.70$ | $0.75$ | $0.80$ | $0.85$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.1257\\,$ | $\\,0.2533\\,$ | $\\,0.3853\\,$ | $\\,0.5244\\,$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ |" :question/worked-solution "First, we express the given information in terms of $Φ,$ using the complement:\n\n$$\n\\begin{aligned}P(Z>z) & =0.45 \\\\ 1-P(Z\\le z) & =0.45 \\\\ 1-Φ(z) & =0.45 \\\\ Φ(z) & =1-0.45 \\\\ Φ(z) & =0.55\\end{aligned}\n$$\n\nSo, we are looking for the value of $z$ such that\n\n$$\nz={Φ}^{-1}(0.55).\n$$\n\nWe look for the column in the table that corresponds to $p=0.55,$ and we find that\n\n$$\np=0.55\\,⇒\\,{Φ}^{-1}(p)=0.1257.\n$$\n\nTherefore, we have\n\n$$\nz={Φ}^{-1}(0.55)=0.1257.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-96946/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8742ad90-1d33-5b56-a83f-8edd7f2f5aef"] :knowledge-point/questions ["q-96946"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164333/selection/8bc15e9c1b29deedf75741681698116e2134223b212229a58da21d6394654afa" :answer/id #uuid "39444dad-fcaa-5499-b889-e665714443a7" :answer/type :answer.type/math :answer/value "1.2816" :db/ensure [:answer/validate]} {:db/id "q-164333/selection/f05add56101cbcc297c8333f59139eeb52c6ccf2377762d8750bd914fcd6116a" :answer/id #uuid "06d9958a-f340-5897-a021-a36f063f9008" :answer/type :answer.type/math :answer/value "-2.3263" :db/ensure [:answer/validate]} {:db/id "q-164333/selection/90120f6767e4efd2e8b334386a283a80d27781b51c76aef79f2cd0ba535668e0" :answer/id #uuid "d381e7bc-2315-5e0e-b25a-