[{:db/id "q-328313/field-1/b81575cf08948c325e1a3cc7d4bb8ed818bc3b343fbfc3e609c4db0dabc2f791" :answer/id #uuid "e12b9615-8b76-5198-9aec-bd4a84e12f76" :answer/type :answer.type/math :answer/value "-0.325" :db/ensure [:answer/validate]} {:db/id "q-328313/field-1/1b8034731fd1f74975e77dffcdaafefd1874e8edaa65acd98af087273b86aec7" :answer/id #uuid "89679406-aa4b-5f06-b387-30555b81492b" :answer/type :answer.type/math :answer/value "0.325" :db/ensure [:answer/validate]} {:db/id "q-328313/field-1" :answer-field/id #uuid "339537be-aceb-5a31-b2a7-892d6dd7394d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328313/field-1/b81575cf08948c325e1a3cc7d4bb8ed818bc3b343fbfc3e609c4db0dabc2f791" :answer-field/choices ["q-328313/field-1/b81575cf08948c325e1a3cc7d4bb8ed818bc3b343fbfc3e609c4db0dabc2f791" "q-328313/field-1/1b8034731fd1f74975e77dffcdaafefd1874e8edaa65acd98af087273b86aec7"] :db/ensure [:answer-field/validate]} {:db/id "q-328313" :question/id #uuid "2cc7a771-75d4-545c-8237-deaeb107f4db" :question/math-academy-id "q-328313" :question/problem "| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.3\\,$ | $\\,0.3745\\,$ | $\\,0.3707\\,$ | $\\,0.3669\\,$ |\n| $\\,-0.2\\,$ | $\\,0.4129\\,$ | $\\,0.4090\\,$ | $\\,0.4052\\,$ |\n| $\\,-0.1\\,$ | $\\,0.4522\\,$ | $\\,0.4483\\,$ | $\\,0.4443\\,$ |\n\nApproximate the value of $z$ such that $P(Z\\le z)=0.3725$ using interval bisection and the above table\n\n$z≈$\n{{field-1}}" :question/worked-solution "First, we find the two numbers in the table that $0.3725$ lies between. These numbers are $0.3707$ and $0.3745.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.3707 & <0.3725<0.3745\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-0.33) & <Φ(z)<Φ(-0.32).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-0.33+(-0.32)}{2}=-0.325.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328313/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99f2c276-2eb0-5fe9-b46d-6cf30547a96e"] :knowledge-point/questions ["q-328313"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164175/selection/0933d22d7f321ea63ddb3bb9d8844e7608a9943fec6b7dda427282d95730e19d" :answer/id #uuid "a969516e-2b4e-590e-8d41-4f928bbfa55c" :answer/type :answer.type/math :answer/value "-1.235" :db/ensure [:answer/validate]} {:db/id "q-164175/selection/850c3e680ec9422b4bd353609f145846c6f894822dae4368bea0903f49dbf4ae" :answer/id #uuid "299c8916-ce94-5aac-bff7-aeebc6465bd7" :answer/type :answer.type/math :answer/value "-1.135" :db/ensure [:answer/validate]} {:db/id "q-164175/selection/c64ac19deb2668d332e8e2fa9ccc013ca6bfb117fd22f315f26b2802c274e597" :answer/id #uuid "03ac4d3c-d194-5aab-8faf-1132496a6212" :answer/type :answer.type/math :answer/value "-1.265" :db/ensure [:answer/validate]} {:db/id "q-164175/selection/37ebdd46709c97f9b432f93d437c4eaa1bc15ca8ca3bce2264b4093581ce5400" :answer/id #uuid "7b3503f6-1b82-5773-8902-218c6e4b3467" :answer/type :answer.type/math :answer/value "-1.245" :db/ensure [:answer/validate]} {:db/id "q-164175/selection/ecb029cb7c3b4464ae24a4d261f8c350a51d926b9948874823ad393fe3643152" :answer/id #uuid "d1ea7916-392e-5d85-bb9e-5bc1e326f557" :answer/type :answer.type/math :answer/value "-1.145" :db/ensure [:answer/validate]} {:db/id "q-164175/selection" :answer-field/id #uuid "9b478aa9-837f-53b9-beaf-fb8d4bb6e9e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164175/selection/37ebdd46709c97f9b432f93d437c4eaa1bc15ca8ca3bce2264b4093581ce5400" :answer-field/choices ["q-164175/selection/0933d22d7f321ea63ddb3bb9d8844e7608a9943fec6b7dda427282d95730e19d" "q-164175/selection/850c3e680ec9422b4bd353609f145846c6f894822dae4368bea0903f49dbf4ae" "q-164175/selection/c64ac19deb2668d332e8e2fa9ccc013ca6bfb117fd22f315f26b2802c274e597" "q-164175/selection/37ebdd46709c97f9b432f93d437c4eaa1bc15ca8ca3bce2264b4093581ce5400" "q-164175/selection/ecb029cb7c3b4464ae24a4d261f8c350a51d926b9948874823ad393fe3643152"] :db/ensure [:answer-field/validate]} {:db/id "q-164175" :question/id #uuid "fcd13a72-8b86-535f-8810-8ff4425a5648" :question/math-academy-id "q-164175" :question/problem "Approximate the value of $z$ such that $P(Z\\le z)=0.1060$ using interval bisection.\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.3\\,$ | $\\,0.0901\\,$ | $\\,0.0885\\,$ | $\\,0.0869\\,$ |\n| $\\,-1.2\\,$ | $\\,0.1075\\,$ | $\\,0.1056\\,$ | $\\,0.1038\\,$ |\n| $\\,-1.1\\,$ | $\\,0.1271\\,$ | $\\,0.1251\\,$ | $\\,0.1230\\,$ |" :question/worked-solution "First, we find the two numbers in the table that $0.1060$ lies between. These numbers are $0.1056$ and $0.1075.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.1056 & <0.1060<0.1075\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(-1.25) & <Φ(z)<Φ(-1.24).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{-1.25+(-1.24)}{2}=-1.245.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164175/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99f2c276-2eb0-5fe9-b46d-6cf30547a96e"] :knowledge-point/questions ["q-164175"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328306/field-1/6c8bcee4a0c21d7bb24502ec8e5814f8986544e2edd035ea53fef316885169e8" :answer/id #uuid "c2bd46cd-9a77-513c-8356-8210f01ffdac" :answer/type :answer.type/math :answer/value "1.625" :db/ensure [:answer/validate]} {:db/id "q-328306/field-1/877d27c589c35d47341800048418f0633f409ad39b8d7445b408ae11ba0259d9" :answer/id #uuid "b1e4d3bb-d3e2-5456-bf38-a8ebbef06833" :answer/type :answer.type/math :answer/value "1.525" :db/ensure [:answer/validate]} {:db/id "q-328306/field-1" :answer-field/id #uuid "f1486ffd-9d97-5863-a027-6ed7bbca62f6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328306/field-1/6c8bcee4a0c21d7bb24502ec8e5814f8986544e2edd035ea53fef316885169e8" :answer-field/choices ["q-328306/field-1/6c8bcee4a0c21d7bb24502ec8e5814f8986544e2edd035ea53fef316885169e8" "q-328306/field-1/877d27c589c35d47341800048418f0633f409ad39b8d7445b408ae11ba0259d9"] :db/ensure [:answer-field/validate]} {:db/id "q-328306" :question/id #uuid "ab06af99-e963-57ee-8889-5cc42add1bf9" :question/math-academy-id "q-328306" :question/problem "| $z$ | $\\,0.01\\,$ | $\\,0.02\\,$ | $\\,0.03\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.5\\,$ | $\\,0.9345\\,$ | $\\,0.9357\\,$ | $\\,0.9370\\,$ |\n| $\\,1.6\\,$ | $\\,0.9463\\,$ | $\\,0.9474\\,$ | $\\,0.9484\\,$ |\n| $\\,1.7\\,$ | $\\,0.9564\\,$ | $\\,0.9573\\,$ | $\\,0.9582\\,$ |\n\nApproximate the value of $z$ such that $P(Z\\le z)=0.9480$ using interval bisection and the above table.\n\n$z≈$\n{{field-1}}" :question/worked-solution "First, we find the two numbers in the table that $0.9480$ lies between. These numbers are $0.9474$ and $0.9484.$ So, we have the following inequality:\n\n$$\n\\begin{aligned}0.9474 & <0.9480<0.9484\\end{aligned}\n$$\n\nWriting the above inequality in terms of $Φ,$ we have\n\n$$\n\\begin{aligned}Φ(1.62) & <Φ(z)<Φ(1.63).\\end{aligned}\n$$\n\nSo, using interval bisection, we can approximate $z$ as\n\n$$\nz≈\\frac{1.62+1.63}{2}=1.625.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328306/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99f2c276-2eb0-5fe9-b46d-6cf30547a96e"] :knowledge-point/questions ["q-328306"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96863/selection/cb273ca84fd6d2d808d6f8628763e0f2a08897de21010f5fdfe0a1ab152fafea" :answer/id #uuid "d8779b90-a1a2-56c1-bd64-3ba04cc28e0d" :answer/type :answer.type/math :answer/value "0.710" :db/ensure [:answer/validate]} {:db/id "q-96863/selection/d77d33161