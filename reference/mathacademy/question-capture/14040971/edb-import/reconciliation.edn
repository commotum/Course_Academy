{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-73659" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/activity-metadata.json" "file_sha256" "a6b9dd97b5feca6bb8daa5aa762c6e122276f1a8b769932d775323ba90d448fa"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{ln}⁡7}{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "\\operatorname{ln}⁡4\\operatorname{ln}⁡|{log}_{7}⁡x|+C"] ["math" "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "\\operatorname{ln}⁡{x}^{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "x\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡({x}^{4})|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-114020" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-114020" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/state.json" "file_sha256" "4bdcec04c9c97a12a16c1e9aa17483de614629a792cd2617e70904dfe1d450ab"} {"question" "q-114020" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040971/activity-metadata.json" "file_sha256" "a6b9dd97b5feca6bb8daa5aa762c6e122276f1a8b769932d775323ba90d448fa"} {"question" "q-114020" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/1404097