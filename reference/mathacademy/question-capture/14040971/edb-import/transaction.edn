[{:db/id "q-13841/selection/4d7f71ccf1d1c0d5d2d684db74164aa2629f603009b3f4d8bff140e685e5fc91" :answer/id #uuid "dc0cb86b-1487-5387-bfb3-d08d26c8bd1f" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-13841/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" :answer/id #uuid "343ffb84-1f03-5f45-a04d-026e1e4c18fe" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-13841/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e2fca332-c83d-51c9-b7c7-9518987b45ee" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-13841/selection/2f3f30a9763db6222fe2895e47cfda47777fa2b71fdb0dadcd325489da7e3ed8" :answer/id #uuid "bb012fcb-41af-5561-8d79-10763e8c68cd" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-13841/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f" :answer/id #uuid "dbac174e-c797-56ba-85de-c69ec0bb39b4" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-13841/selection" :answer-field/id #uuid "bf86d338-fd0a-56c1-b35f-596c3fe60672" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13841/selection/4d7f71ccf1d1c0d5d2d684db74164aa2629f603009b3f4d8bff140e685e5fc91" :answer-field/choices ["q-13841/selection/4d7f71ccf1d1c0d5d2d684db74164aa2629f603009b3f4d8bff140e685e5fc91" "q-13841/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" "q-13841/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-13841/selection/2f3f30a9763db6222fe2895e47cfda47777fa2b71fdb0dadcd325489da7e3ed8" "q-13841/selection/5e542eed8f462585c79e39910b2c34ef465e22c833f24ec3a22005b86e477a3f"] :db/ensure [:answer-field/validate]} {:db/id "q-13841" :question/id #uuid "0a679363-232d-5c04-b893-cdbd8f524a7d" :question/math-academy-id "q-13841" :question/problem "What is the value of ${\\int }_{e/2}^{{e}^{2}/2}\\frac{2}{3x\\operatorname{ln}⁡(2x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | ${e}^{2}/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/2}^{{e}^{2}/2}\\frac{2}{3x\\operatorname{ln}⁡(2x)}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{e/2}^{{e}^{2}/2}\\frac{1}{\\operatorname{ln}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡2-0) \\\\  & =\\frac{2}{3}\\operatorname{ln}⁡2\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-13841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-13841"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49605"] :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$  gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x & =8{\\int }_{{e}^{2}}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =8{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =8\\cdot {\\frac{{u}^{2}}{2}|}_{2}^{4} \\\\  & =4\\cdot {u}^{2}{|}_{2}^{4} \\\\  & =4\\cdot (16-4) \\\\  & =48\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-73653/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "f72a3c11-24c3-561b-a129-b0e453f71d8d" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-73653/selection/e753a76676684ac53d75b3a15c5cde1a0135810f6afcc5ec53fea7d55006bf07" :answer/id #uuid "53d2ca6d-854a-537c-947f-a62b810b5184" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73653/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "b4327b80-2c9f-55f1-9ac9-dd122c8a022b" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-73653/selection/f0d7919093f01666bf86cb3ca835ff1dea4ba9b00e0832a0997714e5b9b14f97" :answer/id #uuid "611dd5b8-7339-5783-8214-a4a1ad37cc20" :answer/type :answer.type/math :answer/value "{ln}^{2}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73653/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" :answer/id #uuid "493c9322-c0bc-5363-b2ea-5b184a5fbf41" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "q-73653/selection" :answer-field/id #uuid "299d34e5-7bc9-51d4-a66a-e7b23b846253" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73653/selection/e753a76676684ac53d75b3a15c5cde1a0135810f6afcc5ec53fea7d55006bf07" :answer-field/choices ["q-73653/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-73653/selection/e753a76676684ac53d75b3a15c5cde1a0135810f6afcc5ec53fea7d55006bf07" "q-73653/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-73653/selection/f0d7919093f01666bf86cb3ca835ff1dea4ba9b00e0832a0997714e5b9b14f97" "q-73653/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90"] :db/ensure [:answer-field/validate]} {:db/id "q-73653" :question/id #uuid "84759818-b43c-5fd3-88c3-53455a0a478f" :question/math-academy-id "q-73653" :question/problem "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-73653"] :db/ensure [:knowledge-point/validate]}]
