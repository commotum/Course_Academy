#{[{:db/id #edb/ref 17592186302152 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c430ce-b4c9-5ad6-92d3-a2313924c0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302154} {:answer/id #uuid "0f3984ae-c6b2-5233-9ae5-32d45bf4dadb" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302155} {:answer/id #uuid "e33122d2-74e0-56a2-8a6b-f7eaa2f44046" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302156} {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} {:answer/id #uuid "3b971759-66f9-5d4a-83c2-d33e420c3e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186302158}] :answer-field/correct {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} :answer-field/id #uuid "0e9fde92-799f-54cb-a163-c8b63400aebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302153}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06296c2e-56ff-57f8-948e-fc4b28498e50" :question/math-academy-id "q-114020" :question/problem "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101444 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} {:answer/id #uuid "d26d1f8b-e0aa-5d92-9ab9-24d9e216087f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x^{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100262} {:answer/id #uuid "fcdc0d7c-75d9-5a6a-8e71-b2ed1b6d870f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 4\\ln \\mid \\log_{7} x \\mid + C" :db/id #edb/ref 17592186100263} {:answer/id #uuid "561a7dca-9374-553b-824c-74d78cf70c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln 7}{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100264} {:answer/id #uuid "62e4e20e-edf2-5d23-8879-c22c3dd0d4a3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln 7\\ln \\mid \\log_{7} (x^{4}) \\mid + C" :db/id #edb/ref 17592186100265}] :answer-field/correct {:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} :answer-field/id #uuid "10d45f02-34c8-55d7-aaa6-ca2883b6ab73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100260}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
