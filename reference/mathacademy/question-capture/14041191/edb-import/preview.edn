}{4!}\\,{(x+\\frac{\\pi }{2})}^{4}+⋯ \\\\  & =-1+\\frac{1}{2}\\,{(x+\\frac{\\pi }{2})}^{2}-\\frac{1}{24}\\,{(x+\\frac{\\pi }{2})}^{4}+⋯.\\end{aligned}\n$$" 13194139534796 true] [17592186310634 1000 #edb/ref 17592186310635 13194139534796 true] [17592186310634 1000 #edb/ref 17592186310636 13194139534796 true] [17592186310634 1040 #edb/ref 17592186045449 13194139534796 true] [17592186310634 1041 "field-1" 13194139534796 true] [17592186310634 1104 #edb/ref 17592186310636 13194139534796 true] [17592186310634 1110 #uuid "1e91e638-9a0f-5257-bdcb-466b2c7df9c5" 13194139534796 true] [17592186310635 1034 "1" 13194139534796 true] [17592186310635 1103 #edb/ref 17592186045453 13194139534796 true] [17592186310635 1111 #uuid "d4d424f9-994f-5e5f-8a16-d0e21575bdd9" 13194139534796 true] [17592186310636 1034 "-1" 13194139534796 true] [17592186310636 1103 #edb/ref 17592186045453 13194139534796 true] [17592186310636 1111 #uuid "bb6ac4dc-fc04-54e5-9bb8-5e2b2fc3524c" 13194139534796 true] [17592186310637 1000 #edb/ref 17592186310638 13194139534796 true] [17592186310637 1040 #edb/ref 17592186045449 13194139534796 true] [17592186310637 1041 "field-2" 13194139534796 true] [17592186310637 1104 #edb/ref 17592186310638 13194139534796 true] [17592186310637 1110 #uuid "83c01ef3-bb1d-5089-893f-524c6e531279" 13194139534796 true] [17592186310638 1034 "\\frac{1}{2}" 13194139534796 true] [17592186310638 1103 #edb/ref 17592186045453 13194139534796 true] [17592186310638 1111 #uuid "d1e6ce05-f3ac-5192-a716-ebfbf206cc8c" 13194139534796 true] [17592186310639 1000 #edb/ref 17592186310640 13194139534796 true] [17592186310639 1040 #edb/ref 17592186045449 13194139534796 true] [17592186310639 1041 "field-3" 13194139534796 true] [17592186310639 1104 #edb/ref 17592186310640 13194139534796 true] [17592186310639 1110 #uuid "e5960653-e1a0-5b43-a7a5-33a593a2293f" 13194139534796 true] [17592186310640 1034 "\\frac{1}{24}" 13194139534796 true] [17592186310640 1103 #edb/ref 17592186045453 13194139534796 true] [17592186310640 1111 #uuid "6bf25ab4-42e5-5454-88ac-5de4f783d11f" 13194139534796 true] [17592186310641 1017 #edb/ref 17592186310642 13194139534796 true] [17592186310641 1089 "q-83201" 13194139534796 true] [17592186310641 1091 #edb/ref 17592186045465 13194139534796 true] [17592186310641 1100 "Use the first three non-zero terms of the Taylor expansion of  $f(x)=\\operatorname{cos}⁡x$ about $x=\\pi $ to approximate the value of $\\operatorname{cos}⁡(\\pi +1).$ Give your answer to $3$ decimal places." 13194139534796 true] [17592186310641 1113 #uuid "70e48cac-b202-5690-92a9-bc78cef33119" 13194139534796 true] [17592186310641 1145 "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=\\pi .$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ f(\\pi ) & =\\operatorname{cos}⁡\\pi =-1 \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{′}(\\pi ) & =-\\operatorname{sin}⁡\\pi =0 \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x \\\\ {f}^{″}(\\pi ) & =-\\operatorname{cos}⁡\\pi =1 \\\\ {f}^{‴}(x) & =\\operatorname{sin}⁡x \\\\ {f}^{‴}(\\pi ) & =\\operatorname{sin}⁡\\pi =0 \\\\ {f}^{(4)}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{(4)}(\\pi ) & =\\operatorname{cos}⁡\\pi =-1.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =-1+\\frac{1}{2!}(x-\\pi )^{2}-\\frac{1}{4!}(x-\\pi )^{4}+⋯ \\\\  & =-1+\\frac{1}{2}(x-\\pi )^{2}-\\frac{1}{24}(x-\\pi )^{4}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=\\pi +1$ into the above to approximate $\\operatorname{cos}⁡(\\pi +1).$ We get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\pi +1) & ≈-1+\\frac{1}{2}(\\pi +1-\\pi )^{2}-\\frac{1}{24}(\\pi +1-\\pi )^{4} \\\\  & =-1+\\frac{1}{2}-\\frac{1}{24} \\\\  & =-0.542,\\end{aligned}\n$$\n\nto $3$ decimal places." 13194139534796 true] [17592186310642 1000 #edb/ref 17592186310643 13194139534796 true] [17592186310642 1000 #edb/ref 17592186310644 13194139534796 true] [175921