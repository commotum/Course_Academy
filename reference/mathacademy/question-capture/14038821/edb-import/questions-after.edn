lue "II and III only" :db/id #edb/ref 17592186301389} {:answer/id #uuid "c1d7876b-3000-53b4-83b1-06b79db32f87" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301390} {:answer/id #uuid "bf9150d1-4e0f-5474-9810-3cfe86e22bcb" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186301391} {:answer/id #uuid "af129f56-ab75-55dc-9bc8-8340f8e61bd2" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186301392} {:answer/id #uuid "03c8307b-92ba-55ca-b11f-c2c5d9fc8742" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186301393}] :answer-field/correct {:answer/id #uuid "03c8307b-92ba-55ca-b11f-c2c5d9fc8742" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186301393} :answer-field/id #uuid "a8d87136-fab6-58e1-9820-55d44eda47a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301388}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1c7e3d76-f32a-56b2-bca3-69969ee50c4e" :question/math-academy-id "q-66006" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n\n- $3\\pi $\n- $-\\frac{\\pi }{6}$\n- $27$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14038821/assets/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"}]}
