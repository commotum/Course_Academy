[{:db/id "q-29953/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "039b90f3-56f7-5935-9183-44582bdb0916" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-29953/selection/91d3493a6fdfbfd2c4184605be70b3da0343f1f6e34cc2dcba5d1de94f4132ee" :answer/id #uuid "1c709d77-31cc-5dcb-9ad0-441b69252423" :answer/type :answer.type/math :answer/value "5pq" :db/ensure [:answer/validate]} {:db/id "q-29953/selection/5e3ec172fdb0b519fe92e60306e3dba386fcd58b9f6c0b42f99970c9235a906f" :answer/id #uuid "5331c7c8-ce1c-53c9-b15a-e288dfa655ff" :answer/type :answer.type/math :answer/value "\\frac{2p}{5q}" :db/ensure [:answer/validate]} {:db/id "q-29953/selection/1f982cec31f799845dc193ca3f20f9840763d28c5913dedda4dcc5551eb654a4" :answer/id #uuid "4cee36f1-e329-5709-9e9c-4b4037d4d54a" :answer/type :answer.type/math :answer/value "\\frac{pq}{10}" :db/ensure [:answer/validate]} {:db/id "q-29953/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6a3b0fdc-60ff-570f-add9-1377dc7d635c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-29953/selection" :answer-field/id #uuid "89e12d28-1d04-5f40-8eba-010e8968d231" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29953/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-29953/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-29953/selection/91d3493a6fdfbfd2c4184605be70b3da0343f1f6e34cc2dcba5d1de94f4132ee" "q-29953/selection/5e3ec172fdb0b519fe92e60306e3dba386fcd58b9f6c0b42f99970c9235a906f" "q-29953/selection/1f982cec31f799845dc193ca3f20f9840763d28c5913dedda4dcc5551eb654a4" "q-29953/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-29953" :question/id #uuid "4305cb9f-6067-5112-8c97-02ae31e17bbe" :question/math-academy-id "q-29953" :question/problem "Given that $\\frac{14{p}^{3}}{3{q}^{3}}=a$ and  $\\frac{7{p}^{3}}{15{q}^{3}}=b,$ what is the value of $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{14{p}^{3}}{3{q}^{3}}÷\\frac{7{p}^{3}}{15{q}^{3}},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{14{p}^{3}}{3{q}^{3}}÷\\frac{7{p}^{3}}{15{q}^{3}} & = \\\\ \\frac{14{p}^{3}}{3{q}^{3}}\\cdot \\frac{15{q}^{3}}{7{p}^{3}} & = \\\\ \\frac{2\\cdot 7{p}^{3}}{3{q}^{3}}\\cdot \\frac{5\\cdot 3{q}^{3}}{7{p}^{3}} & = \\\\ \\frac{2\\cdot \\cancel{7{p}^{3}}}{\\cancel{3{q}^{3}}}\\cdot \\frac{5\\cdot \\cancel{3{q}^{3}}}{\\cancel{7{p}^{3}}} & = \\\\ 2\\cdot 5 & = \\\\ 10\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-29953/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f"] :knowledge-point/questions ["q-29953"] :db/ensure [:knowledge-point/validate]} {:db/id "q-216937/field-1/2e2f90fc1179df2b9c286c6ca6bfa259786f82b9ff7fb856f86ca86dcac25c45" :answer/id #uuid "168fcfde-97c2-537f-9c5c-8d5217483bb4" :answer/type :answer.type/math :answer/value "-4p" :db/ensure [:answer/validate]} {:db/id "q-216937/field-1" :answer-field/id #uuid "bb39ea30-63c6-58a3-a6bc-6778027bdce5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-216937/field-1/2e2f90fc1179df2b9c286c6ca6bfa259786f82b9ff7fb856f86ca86dcac25c45" :answer-field/choices ["q-216937/field-1/2e2f90fc1179df2b9c286c6ca6bfa259786f82b9ff7fb856f86ca86dcac25c45"] :db/ensure [:answer-field/validate]} {:db/id "q-216937/field-2/3f7426cbe9ecba60ce95d620c07f1a7ae1f323f92b4892902585b7f1ebc19635" :answer/id #uuid "60611b3f-ff55-5c5e-8a11-1ab5c3f16a9c" :answer/type :answer.type/math :answer/value "\\frac{9q}{2}" :db/ensure [:answer/validate]} {:db/id "q-216937/field-2" :answer-field/id #uuid "5c5e2fd7-ed0b-5f15-ba68-f6191ae65ceb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-216937/field-2/3f7426cbe9ecba60ce95d620c07f1a7ae1f323f92b4892902585b7f1ebc19635" :answer-field/choices ["q-216937/field-2/3f7426cbe9ecba60ce95d620c07f1a7ae1f323f92b4892902585b7f1ebc19635"] :db/ensure [:answer-field/validate]} {:db/id "q-216937" :question/id #uuid "fb752df6-a291-59ef-a8de-b87fa6d272af" :question/math-academy-id "q-216937" :question/problem "The midpoint of the line segment with endpoints $(4p,2q)$ and $(-12p,7q)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(4p,2q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-12p,7q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{4p+(-12p)}{2},\\frac{2q+7q}{2}) \\\\  & =(\\frac{-8p}{2},\\frac{9q}{2}) \\\\  & =(-4p,\\frac{9q}{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-216937/field-1" "q-216937/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3"] :knowledge-point/questions ["q-216937"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31365/selection/5208dc655cb1ea0db4145462e4ae78c55787032256627bb5cb3b7539af5bad1c" :answer/id #uuid "7bf2f503-8af6-508e-9d50-9c80d05af090" :answer/type :answer.type/math :answer/value "({x}^{2}-2y)^{2}" :db/ensure [:answer/validate]} {:db/id "q-31365/selection/92406bd7298056d22aed9d78c233bdfa57a3c39d9d79a3440acad8e5138cb6df" :answer/id #uuid "0cc2fc60-0da3-5715-9454-ac86f5d46175" :answer/type :answer.type/math :answer/value "(x+2y)(x-2y)" :db/ensure [:answer/validate]} {:db/id "q-31365/selection/b058356baeb98d0900482e7afce87255a39032cc8c7703d5f38a9732fc8d03ff" :answer/id #uuid "c8ec8c79-6ab2-5a0d-bcca-b7c6a6fd499a" :answer/type :answer.type/math :answer/value "({x}^{2}+4y)({x}^{2}-4y)" :db/ensure [:answer/validate]} {:db/id "q-31365/selection/75d726e17d2283559bbecfddc126629503552613d74b262df44c2b92a371d8ca" :answer/id #uuid "87f346bb-1a98-582b-9d80-5ea115923b7c" :answer/type :answer.type/math :answer/value "({x}^{2}-4y)^{2}" :db/ensure [:answer/validate]} {:db/id "q-31365/selection/553162a8f08d15c4f8f676ddd8276bd01534a388870755f1ed5bafda173bc87d" :answer/id #uuid "cc45edde-f92b-5573-a6ab-89be8d2eaabc" :answer/type :answer.type/math :answer/value "({x}^{2}+2y)({x}^{2}-2y)" :db/ensure [:answer/validate]} {:db/id "q-31365/selection" :answer-field/id #uuid "28be224d-dc1b-5408-805c-ef798603c66f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31365/selection/553162a8f08d15c4f8f676ddd8276bd01534a388870755f1ed5bafda173bc87d" :answer-field/choices ["q-31365/selection/5208dc655cb1ea0db4145462e4ae78c55787032256627bb5cb3b7539af5bad1c" "q-31365/selection/92406bd7298056d22aed9d78c233bdfa57a3c39d9d79a3440acad8e5138cb6df" "q-31365/selection/b058356baeb98d0900482e7afce87255a39032cc8c7703d5f38a9732fc8d03ff" "q-31365/selection/75d726e17d2283559bbecfddc126629503552613d74b262df44c2b92a371d8ca" "q-31365/selection/553162a8f08d15c4f8f676ddd8276bd01534a388870755f1ed5bafda173bc87d"] :db/ensure [:answer-field/validate]} {:db/id "q-31365" :question/id #uuid "629a0494-43df-5f32-9168-213f3c97e24c" :question/math-academy-id "q-31365" :question/problem "${x}^{4}-4{y}^{2}=$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{x}^{4}-4{y}^{2}={({x}^{2})}^{2}-(2y)^{2}\n$$\n\nFinally, we factor our expression using the difference of squares formula:\n\n$$\n{({x}^{2})}^{2}-(2y)^{2}=({x}^{2}+2y)({x}^{2}-2y)\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075"] :knowledge-point/questions ["q-31365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-323217/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "dd3d9c7d-cb4c-5fd2-b954-bb1e42338a66" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-323217/field-1" :answer-field/id #uuid "92ed05e9-0ce6-5e57-b518-667a687d25c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-323217/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-323217/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-323217" :question/id #uuid "acbc7541-07ac-50f0-98b9-4b8cdee191f9" :question/math-academy-id "q-323217" :question/problem "According to the rational root theorem, the polynomial $f(x)=5{x}^{4}+5{x}^{2}-7x+5$ has{{field-1}} *potential* rational roots." :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $5,$ and its factors are $\\pm 1$ and $\\pm 5.$\n\n- The leading coefficient is $5,$ and its factors are $\\pm 1$ and $\\pm 5.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{5}, \\\\ \\pm \\frac{5}{1}, & \\pm \\frac{5}{5}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{5}, \\\\ \\pm 5, & \\pm 1.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{5},\\,\\pm 1,\\,\\pm 5.\n$$\n\nThis makes a total of $6$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 3=6.$)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-323217/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a"] :knowledge-point/questions ["q-323217"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319512/field-1/1d24867dd866983ab6ae49d30fd0e15f9ca4aaaea7fb184a5e33fe33b0ffdbd2" :answer/id #uuid "0b80bfad-21f8-5e65-ae12-d79b46b0471c" :answer/type :answer.type/math :answer/value "3.84" :db/ensure [:answer/validate]} {:db/id "q-319512/field-1" :answer-field/id #uuid "63185777-fa38-5b11-878a-9df57455d18e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319512/field-1/1d24867dd866983ab6ae49d30fd0e15f9ca4aaaea7fb184a5e33fe33b0ffdbd2" :answer-field/choices ["q-319512/field-1/1d24867dd866983ab6ae49d30fd0e15f9ca4aaaea7fb184a5e33fe33b0ffdbd2"] :db/ensure [:answer-field/validate]} {:db/id "q-319512" :question/id #uuid "0de4e360-98e4-5070-8d64-5f82a8a005dd" :question/math-academy-id "q-319512" :question/problem "Find, **in radians**, the argument of $z=-6-5\\text{i}.$ Round your final answer to **two decimal places**.\n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$\n\n$\\operatorname{arg}⁡(z)≈$\n{{field-1}}" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951323/assets/93018ffa3e41f787cf32e4fa9735be8f5c6f9da360361434076cbfaecce51259.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Hence $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ \n\nIf $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\alpha =arctan\\,(\\frac{5}{6})=0.694\\,738…\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)=\\pi +0.694\\,738…≈3.84,\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/easy :question/requires-calculator true :question/answer-fields ["q-319512/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a560db4d-e9d3-5d89-b2cd-c886f32db9df"] :knowledge-point/questions ["q-319512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81994/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" :answer/id #uuid "49bf9079-e46f-5056-a5c6-89359d76ce7c" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "q-81994/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" :answer/id #uuid "1a3f9b3b-02b1-5b89-8045-7612b97a2a74" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "q-81994/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "b45aa14a-50d8-56fc-8890-7231982c5bb0" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-81994/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "2bbd7e47-c502-58df-95d2-19ae2b066f60" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "q-81994/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" :answer/id #uuid "ac3ebe34-6fd9-5d2f-ba6c-d13198de013a" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "q-81994/selection" :answer-field/id #uuid "e2e371c0-c55f-5f7d-ab8b-50efd02a36d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81994/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer-field/choices ["q-81994/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" "q-81994/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" "q-81994/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-81994/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" "q-81994/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b"] :db/ensure [:answer-field/validate]} {:db/id "q-81994" :question/id #uuid "501a733e-783e-54e0-b097-e7345edc5e15" :question/math-academy-id "q-81994" :question/problem "Find the equation of the vertical asymptote of the function $f(x)=-3\\operatorname{ln}⁡(4-2x)+6.$" :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{ln}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}4-2x & =0 \\\\ -2x & =-4 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81994/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473"] :knowledge-point/questions ["q-81994"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-148296"] :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{9}{(x-2)^{2}}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{9}{(y-2)^{2}}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{9}{(y-2)^{2}} \\\\ (y-2)^{2} & =\\frac{9}{x} \\\\ \\sqrt{(y-2)^{2}} & =\\sqrt{\\frac{9}{x}} \\\\ |y-2| & =\\frac{3}{\\sqrt{x}} \\\\ y-2 & =\\frac{3}{\\sqrt{x}} \\\\ y & =\\frac{3}{\\sqrt{x}}+2\\end{aligned}\n$$\n\nNote that we used the fact that for $y>2,$ we have\n\n$$\n|y-2|=y-2.\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{3}{\\sqrt{x}}+2.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]}]
