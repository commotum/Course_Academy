[{:db/id "q-15174/selection/6adc291ee7bb1cc8576285c20160d2a33c881576edb977260dc662dab0efcda6" :answer/id #uuid "7352711a-225c-5f90-b63a-dc36a885a0b4" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+2t+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15174/selection/b9c139909868a3d4b752b5a75b5ac5232bbd7bfcdb6447a7eefeb8019de9b92a" :answer/id #uuid "e22e7a8c-23a9-5fd4-87a1-c8b5b2ac2d88" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}t\\sqrt{3{t}^{2}+2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15174/selection/c472159a782af18f1ece5b4fa4430da4e7d47d5d6393b9a6e8bda979d7466cb1" :answer/id #uuid "ea76e21e-2b69-535e-81a9-5e3718e47e23" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+24t+8}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15174/selection/a8b31d1634a327d12d205d04c66213864f5dedc9f286571b9dbe0a8b51d46441" :answer/id #uuid "30f487a7-9c66-5fa1-b725-bf167f8136c9" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15174/selection/850405fce28be121a63a508f203fc6e13ead7312ec57a01ad98494105c577dc0" :answer/id #uuid "e6c4b173-b925-5e7f-bd18-48f10587dd2b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15174/selection" :answer-field/id #uuid "6623aab4-4a58-5efe-bc40-75147a9ee4bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15174/selection/a8b31d1634a327d12d205d04c66213864f5dedc9f286571b9dbe0a8b51d46441" :answer-field/choices ["q-15174/selection/6adc291ee7bb1cc8576285c20160d2a33c881576edb977260dc662dab0efcda6" "q-15174/selection/b9c139909868a3d4b752b5a75b5ac5232bbd7bfcdb6447a7eefeb8019de9b92a" "q-15174/selection/c472159a782af18f1ece5b4fa4430da4e7d47d5d6393b9a6e8bda979d7466cb1" "q-15174/selection/a8b31d1634a327d12d205d04c66213864f5dedc9f286571b9dbe0a8b51d46441" "q-15174/selection/850405fce28be121a63a508f203fc6e13ead7312ec57a01ad98494105c577dc0"] :db/ensure [:answer-field/validate]} {:db/id "q-15174" :question/id #uuid "dddf8a10-d360-5144-aae4-5bd6e2bd6915" :question/math-academy-id "q-15174" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+{t}^{2},\\,y={t}^{3}-{t}^{2}$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})=3{t}^{2}+2t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})=3{t}^{2}-2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(3{t}^{2}+2t)}^{2}+{(3{t}^{2}-2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+12{t}^{3}+4{t}^{2}+9{t}^{4}-12{t}^{3}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{18{t}^{4}+8{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15174/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-15174"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81380/selection/6a67ff8552fd89ec86df26c77087f0cd0c49beec9727a79e53a7228c51c301aa" :answer/id #uuid "548e0348-672c-5cfb-8a29-dd66b6e842d4" :answer/type :answer.type/math :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+3}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81380/selection/33201ae0f62892800c59f2327d8ae24b719a37599ec2e2655c3c5d0941ab1663" :answer/id #uuid "0cfce0b8-c99d-55eb-bc80-6bf244e16ec9" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81380/selection/2ed15eeaf66e6949f6ef680746c4a23fa8bc159f6211bb6f82bcab5821f3e87a" :answer/id #uuid "7c90e94b-8539-5741-bbcd-be9a01a9685d" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+3}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81380/selection/fb931bcc8868df663afdd414878f5f12c48a9fda27ab2758d2fbf80a6018b791" :answer/id #uuid "0c858ecb-48db-5a22-8f2c-1b170ae8b0bc" :answer/type :answer.type/math :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81380/selection/153ced11257ae9490f993400a692d95015853eac6d3311b8322c33af7b065501" :answer/id #uuid "23a35118-6509-5bc9-8adf-3ed9fb4e9a76" :answer/type :answer.type/math :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81380/selection" :answer-field/id #uuid "734449f3-5639-5b38-93cb-6755b2c4403f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81380/selection/153ced11257ae9490f993400a692d95015853eac6d3311b8322c33af7b065501" :answer-field/choices ["q-81380/selection/6a67ff8552fd89ec86df26c77087f0cd0c49beec9727a79e53a7228c51c301aa" "q-81380/selection/33201ae0f62892800c59f2327d8ae24b719a37599ec2e2655c3c5d0941ab1663" "q-81380/selection/2ed15eeaf66e6949f6ef680746c4a23fa8bc159f6211bb6f82bcab5821f3e87a" "q-81380/selection/fb931bcc8868df663afdd414878f5f12c48a9fda27ab2758d2fbf80a6018b791" "q-81380/selection/153ced11257ae9490f993400a692d95015853eac6d3311b8322c33af7b065501"] :db/ensure [:answer-field/validate]} {:db/id "q-81380" :question/id #uuid "a5b96d4c-d45c-5b54-bef3-6984291ba3e9" :question/math-academy-id "q-81380" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/120220c7c1a24c68c1a9282548efcf62c34fd110bd11911799a2a83409f257ab.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+1,\\,y=3t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t)=3.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(3)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+9}\\,\\text{d}t \\\\  & =3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81380/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-81380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85724/selection/66ce48988afcf6fe618c30e0e357f9f1bd71801efc7a61063aafd218814a7148" :answer/id #uuid "ff2e6167-26ed-5811-97fc-6bffcd67b0cd" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{2}+2t-1}\\,\\text{d}t\\," :db/ensure [:answer/validate]} {:db/id "q-85724/selection/f310215a698f8f3f5461a130b61c323673f5be6293d52059a21cd4030ab86ad2" :answer/id #uuid "9d870c2e-1563-5daf-a93b-88eff7810c1f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\," :db/ensure [:answer/validate]} {:db/id "q-85724/selection/3b79fff4c34e013a313ebe694d0b765777f78a3130e84b29c3a847813c1ac43a" :answer/id #uuid "2d2fe723-94d3-5643-93e4-caf3780acf3d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+2{t}^{2}-2t+1}\\,\\text{d}t\\," :db/ensure [:answer/validate]} {:db/id "q-85724/selection/798d556e5474f74eb237b6a768b99861d69961045596ac8e12f3e65687a7d814" :answer/id #uuid "ffe5d51e-55bb-533b-b3b7-efe75a7eea4a" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{{t}^{2}-12t+1}\\,\\text{d}t\\," :db/ensure [:answer/validate]} {:db/id "q-85724/selection/ac1da519b8ccacf1ed755e2052032a437616d530cc989619b865c55aee0bbab5" :answer/id #uuid "7664ae52-3f5a-521d-8a74-79252a7e50a7" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{4}+4{t}^{2}-2t+1}\\,\\text{d}t\\," :db/ensure [:answer/validate]} {:db/id "q-85724/selection" :answer-field/id #uuid "2101958d-70e2-549f-a6c0-bff61355b59c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85724/selection/f310215a698f8f3f5461a130b61c323673f5be6293d52059a21cd4030ab86ad2" :answer-field/choices ["q-85724/selection/66ce48988afcf6fe618c30e0e357f9f1bd71801efc7a61063aafd218814a7148" "q-85724/selection/f310215a698f8f3f5461a130b61c323673f5be6293d52059a21cd4030ab86ad2" "q-85724/selection/3b79fff4c34e013a313ebe694d0b765777f78a3130e84b29c3a847813c1ac43a" "q-85724/selection/798d556e5474f74eb237b6a768b99861d69961045596ac8e12f3e65687a7d814" "q-85724/selection/ac1da519b8ccacf1ed755e2052032a437616d530cc989619b865c55aee0bbab5"] :db/ensure [:answer-field/validate]} {:db/id "q-85724" :question/id #uuid "77ecc403-c204-532a-a0f9-e871a850287a" :question/math-academy-id "q-85724" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-1,\\,y={t}^{2}-t$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)=2t-1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3{t}^{2})^{2}+(2t-1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85724/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-85724"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81377/selection/340c2187a92e86ad069e4f2a38534402b41e7f4dcc5bd12bd7bdc4648327b0ea" :answer/id #uuid "128635bd-e3aa-51de-a4b1-ac8a3bc5a04e" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81377/selection/5ceabdeb229f2e77ca52e0e2eff347c158b249c8c7fa6883c7e80efc61616e3b" :answer/id #uuid "1adb0459-0306-56c4-9603-05ee11cc0723" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{4+4t+{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81377/selection/1cf9788e7ca8f0c7236380ac808fdfb5ce4849eab0a8c00d396b3e87af588169" :answer/id #uuid "5b9ce05e-feb5-5fe3-870a-a219dc000627" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{t+4{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81377/selection/86f6ac08ce67c26b96d097d20086457d558adce76de3857224d48f337e90061d" :answer/id #uuid "0bb7e14b-c95b-5a70-a3cc-a409e14ba364" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{4+t+4{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81377/selection/638ffa9330849ad8abb72987e301f4efe3437ff250bce00bf8e2534aa82d4f93" :answer/id #uuid "dcedce22-bb8c-59a9-9aea-2d9251e58f9d" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4t+4{t}^{2}}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-81377/selection" :answer-field/id #uuid "991f5431-88a0-5a20-97fb-1e3934cbfd5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81377/selection/340c2187a92e86ad069e4f2a38534402b41e7f4dcc5bd12bd7bdc4648327b0ea" :answer-field/choices ["q-81377/selection/340c2187a92e86ad069e4f2a38534402b41e7f4dcc5bd12bd7bdc4648327b0ea" "q-81377/selection/5ceabdeb229f2e77ca52e0e2eff347c158b249c8c7fa6883c7e80efc61616e3b" "q-81377/selection/1cf9788e7ca8f0c7236380ac808fdfb5ce4849eab0a8c00d396b3e87af588169" "q-81377/selection/86f6ac08ce67c26b96d097d20086457d558adce76de3857224d48f337e90061d" "q-81377/selection/638ffa9330849ad8abb72987e301f4efe3437ff250bce00bf8e2534aa82d4f93"] :db/ensure [:answer-field/validate]} {:db/id "q-81377" :question/id #uuid "770bbdf1-cce0-50f8-8d53-5bed9c9a42c1" :question/math-academy-id "q-81377" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t-1,\\,y={t}^{2}+2$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-1)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+2)=2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{{(1)}^{2}+{(2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81377/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-81377"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123005/selection/5278be413b2f211f7e184214e21bcfd56054a7582a99b350e21d15e76f392293" :answer/id #uuid "a4a905ef-8ed2-5605-9650-cbf38461a32e" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123005/selection/f6226bf8cc6d57f2ce90a1854f2230e2d5f1e3c86361323a8090337c808c4fa5" :answer/id #uuid "5ed634ee-1632-5a4a-8456-7fa036259b11" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+49{t}^{4}+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123005/selection/386c0e257d024879971bff7aa7fd20e4381d06674a4d62dcb9ed79bdd1add552" :answer/id #uuid "4c6dc554-1c4e-556a-a7ad-664c6bc05b98" :answer/type :answer.type/math :answer/value "3{\\int }_{-2}^{3}\\sqrt{{t}^{6}+{t}^{4}+{t}^{3}+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123005/selection/6c10979473d84f547245c73b85f95d6fc10065f410d3a5f818a0a5f94fe43fba" :answer/id #uuid "4d5ea01b-c242-590a-857e-08bdd85a4e4c" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{3}\\sqrt{4{t}^{6}+3{t}^{4}+4{t}^{3}+5}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123005/selection/87785edff7069c70de9e17568167519682913a9e4111975f459e410670674d5e" :answer/id #uuid "0d68a61e-75d3-5b2e-b453-af0a1e70ab3c" :answer/type :answer.type/math :answer/value "2{\\int }_{-2}^{3}\\sqrt{8{t}^{6}+9{t}^{4}+20{t}^{3}+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123005/selection" :answer-field/id #uuid "5d670520-2a3f-55b3-b693-44bc251b354a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123005/selection/5278be413b2f211f7e184214e21bcfd56054a7582a99b350e21d15e76f392293" :answer-field/choices ["q-123005/selection/5278be413b2f211f7e184214e21bcfd56054a7582a99b350e21d15e76f392293" "q-123005/selection/f6226bf8cc6d57f2ce90a1854f2230e2d5f1e3c86361323a8090337c808c4fa5" "q-123005/selection/386c0e257d024879971bff7aa7fd20e4381d06674a4d62dcb9ed79bdd1add552" "q-123005/selection/6c10979473d84f547245c73b85f95d6fc10065f410d3a5f818a0a5f94fe43fba" "q-123005/selection/87785edff7069c70de9e17568167519682913a9e4111975f459e410670674d5e"] :db/ensure [:answer-field/validate]} {:db/id "q-123005" :question/id #uuid "043e3604-9f17-5864-b5ec-42841fc42009" :question/math-academy-id "q-123005" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-8,\\,y={t}^{4}+5t$\nfrom $t=-2$ to $t=3$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-8)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+5t)=4{t}^{3}+5\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{{(3{t}^{2})}^{2}+{(4{t}^{3}+5)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{9{t}^{4}+16{t}^{6}+40{t}^{3}+25}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-123005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-21354/selection/5d041c8987ca3895fd2aba6e8c2867bd555fb250b1258f1439ac4ba767e3a077" :answer/id #uuid "b72d03d8-d86a-5b26-b400-5fee85bd9c6f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21354/selection/cc3b9a617ead7d620bdaef2169a712bf7174bd80ef84af8a898ba6b852d1bffa" :answer/id #uuid "874c357f-f834-5902-ac5e-24d20b485ce8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21354/selection/01dd6ccb0cae1bcf9f19897eb23b7bf0eba4589b8de6ac979b55cac559eb582e" :answer/id #uuid "e5d95e76-6da0-59e7-ba2e-e54f6c229bf5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21354/selection/f59e36b83ccb9dba52faacda9be5fc1d8b94d05034778a3ca54edb7ed78b054e" :answer/id #uuid "2d21e6b1-f959-5937-95f2-768406814b64" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21354/selection/3d0a272abfb4864700492adca260d5515edc9e75624980ca0233f330cac08647" :answer/id #uuid "f95a3754-8e7a-5ac7-91b2-3967462239a6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21354/selection" :answer-field/id #uuid "fd5d6221-d149-530f-a681-b77ad15e3700" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-21354/selection/cc3b9a617ead7d620bdaef2169a712bf7174bd80ef84af8a898ba6b852d1bffa" :answer-field/choices ["q-21354/selection/5d041c8987ca3895fd2aba6e8c2867bd555fb250b1258f1439ac4ba767e3a077" "q-21354/selection/cc3b9a617ead7d620bdaef2169a712bf7174bd80ef84af8a898ba6b852d1bffa" "q-21354/selection/01dd6ccb0cae1bcf9f19897eb23b7bf0eba4589b8de6ac979b55cac559eb582e" "q-21354/selection/f59e36b83ccb9dba52faacda9be5fc1d8b94d05034778a3ca54edb7ed78b054e" "q-21354/selection/3d0a272abfb4864700492adca260d5515edc9e75624980ca0233f330cac08647"] :db/ensure [:answer-field/validate]} {:db/id "q-21354" :question/id #uuid "78d28f04-080c-597a-9016-2f2665e007f7" :question/math-academy-id "q-21354" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-21354/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-21354"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15182/selection/45675b4dfd2438b42c61c96fe18bbc20cffb06c66244d6d218bee28847318488" :answer/id #uuid "f885fdf0-e8e7-5e4c-bc02-3f232d69c715" :answer/type :answer.type/math :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15182/selection/ac83c95748fe2a202b442ef1bfe19e6a85fedb2c51f345626c4eff0851c3a8e0" :answer/id #uuid "cb72db74-f288-5aef-a5ef-924e8e872486" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{3{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15182/selection/67cca8c99392058d5a54f4e6880e79c00f408cf712cfc6b2a957270a931920be" :answer/id #uuid "286f9935-2b6d-559d-84af-7ce2a1a320a5" :answer/type :answer.type/math :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{2{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15182/selection/5fee9ead9b19cb8930a2df4ed06e487b2b0c30200d71f3123ed0ced653414034" :answer/id #uuid "82376550-13c1-5610-8119-bb2bc5e40983" :answer/type :answer.type/math :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15182/selection/b567b3d5fe5f431947cb8eb96cb9399c13cc564e23bee70312d5956522bc73c2" :answer/id #uuid "4b387626-b14d-55b0-92d2-19f5553d577a" :answer/type :answer.type/math :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15182/selection" :answer-field/id #uuid "416c7e6f-afb9-58b7-8819-94d6afa28f9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15182/selection/5fee9ead9b19cb8930a2df4ed06e487b2b0c30200d71f3123ed0ced653414034" :answer-field/choices ["q-15182/selection/45675b4dfd2438b42c61c96fe18bbc20cffb06c66244d6d218bee28847318488" "q-15182/selection/ac83c95748fe2a202b442ef1bfe19e6a85fedb2c51f345626c4eff0851c3a8e0" "q-15182/selection/67cca8c99392058d5a54f4e6880e79c00f408cf712cfc6b2a957270a931920be" "q-15182/selection/5fee9ead9b19cb8930a2df4ed06e487b2b0c30200d71f3123ed0ced653414034" "q-15182/selection/b567b3d5fe5f431947cb8eb96cb9399c13cc564e23bee70312d5956522bc73c2"] :db/ensure [:answer-field/validate]} {:db/id "q-15182" :question/id #uuid "243b404d-a4f2-57e8-bc56-d916439edf0e" :question/math-academy-id "q-15182" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/d683c3960705fa32d11826008a9844c51c8e59e38f5158fce7f4e44c31b97ca9.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(3t))=-3\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡(t))=3\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-3\\operatorname{sin}⁡(3t))^{2}+(3\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡(3t)+9{cos}^{2}⁡(t)}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-15182"] :db/ensure [:knowledge-point/validate]} {:db/id "q-21339/selection/8f95bfef86f16e617a8f7c03b3029fe01f85f3e43e50928197148bbd73a77678" :answer/id #uuid "399e6721-a202-5532-b4d2-8072febd6298" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21339/selection/f43b8473d37279e3d14c6ca0e6b9c696571b98d7424051980b38245ed30627d0" :answer/id #uuid "dbe1ff85-e1c9-55a4-ac69-c135a08bf481" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21339/selection/19c52bc158427b32c8278d67698683d4359a5c079bb3fe646a742be388a5d04a" :answer/id #uuid "5920438b-2e3b-541f-ab4e-274254545ac7" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21339/selection/aa662d63a4f1e43889082cb129fc45b3ac83894a79574dde544b0c1bac1b6317" :answer/id #uuid "dc35f953-44cc-5a97-9b01-08b169583ffb" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21339/selection/e38469ec4f7a0973d0f39048ba3e426bf65b85af8bbb6c678407c2dcd0f1165a" :answer/id #uuid "3dd93796-2a27-5af2-9fd1-3d6111d06371" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21339/selection" :answer-field/id #uuid "c5703905-bd65-5e76-8460-7fa1094f93c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-21339/selection/8f95bfef86f16e617a8f7c03b3029fe01f85f3e43e50928197148bbd73a77678" :answer-field/choices ["q-21339/selection/8f95bfef86f16e617a8f7c03b3029fe01f85f3e43e50928197148bbd73a77678" "q-21339/selection/f43b8473d37279e3d14c6ca0e6b9c696571b98d7424051980b38245ed30627d0" "q-21339/selection/19c52bc158427b32c8278d67698683d4359a5c079bb3fe646a742be388a5d04a" "q-21339/selection/aa662d63a4f1e43889082cb129fc45b3ac83894a79574dde544b0c1bac1b6317" "q-21339/selection/e38469ec4f7a0973d0f39048ba3e426bf65b85af8bbb6c678407c2dcd0f1165a"] :db/ensure [:answer-field/validate]} {:db/id "q-21339" :question/id #uuid "eb7dbcac-2317-56a8-ba31-4c6afb0fd698" :question/math-academy-id "q-21339" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=2\\operatorname{sin}⁡(3t)-1,\\,y=2\\operatorname{cos}⁡(2t)+2$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(3t)-1) \\\\  & =2\\operatorname{cos}⁡(3t)\\cdot 3 \\\\  & =6\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-21339/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-21339"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123030/selection/83a66866bdd73d2579acb847d46aca2b366ba71d82bf979d6065176555e96a3b" :answer/id #uuid "d1082dc3-8db8-5413-9f03-5ed42be40922" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123030/selection/cb82208f58430fd1ca4d670b2c8baf0112c7441fa9bca07ba26e760bce9daa9b" :answer/id #uuid "2ffecb6a-2f93-5a53-8042-e998df56cb5b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123030/selection/220e3498d437056c0502e40976d475884623859d4cc6f34872a5d2690559cddd" :answer/id #uuid "b8469ff2-4b08-594f-b14a-113d5edfa378" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123030/selection/d0b4ee066ab553f0fb3b58a74291627129c9fa8c4c9eb0fb45c43a0cc2f777df" :answer/id #uuid "5757d727-5d80-5732-ac89-35e82d0c08ea" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123030/selection/8db4c196731c5b21a2b6e6627b9ed5b0f20a5dce71f3c7667b4c27ffba8d01b0" :answer/id #uuid "c6474247-b26b-52e8-bc5c-50b7671013e7" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{10{sin}^{2}⁡(5t)+12{cos}^{2}⁡(t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123030/selection" :answer-field/id #uuid "1329b6ad-536d-528f-b20e-bd9707ff3ace" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123030/selection/d0b4ee066ab553f0fb3b58a74291627129c9fa8c4c9eb0fb45c43a0cc2f777df" :answer-field/choices ["q-123030/selection/83a66866bdd73d2579acb847d46aca2b366ba71d82bf979d6065176555e96a3b" "q-123030/selection/cb82208f58430fd1ca4d670b2c8baf0112c7441fa9bca07ba26e760bce9daa9b" "q-123030/selection/220e3498d437056c0502e40976d475884623859d4cc6f34872a5d2690559cddd" "q-123030/selection/d0b4ee066ab553f0fb3b58a74291627129c9fa8c4c9eb0fb45c43a0cc2f777df" "q-123030/selection/8db4c196731c5b21a2b6e6627b9ed5b0f20a5dce71f3c7667b4c27ffba8d01b0"] :db/ensure [:answer-field/validate]} {:db/id "q-123030" :question/id #uuid "30eadd5a-469c-54ec-b683-aec3a996fde4" :question/math-academy-id "q-123030" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/8868658c9bc7195f435a0109fce26b8a4fa39324c0a9a39e3fb644c5f02cdc9b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(5t),\\,y=6\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(5t))=-5\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡(t))=6\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-5\\operatorname{sin}⁡(5t))^{2}+(6\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-123030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15163/selection/efbba29f9c626ab75f168fe940cd94ab0e0aa5bfda7d256dd545fa10f04ed1b1" :answer/id #uuid "7e0660ec-241d-5aad-a749-9e7c4de7fea8" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15163/selection/af450c866ba6ac194c254a958c5b8ffac460cff0f9e8324c9556132eaf6efecb" :answer/id #uuid "fcdd2d0b-b020-5b49-96fa-7c239cfb63e3" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+2{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15163/selection/01a36387217c1d3a59a66936939d77da6703679710a5a99681e15d561c2a3d9d" :answer/id #uuid "1b84d74c-bb02-585c-981a-79f8d7ffd229" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15163/selection/85f01b068c841f9ceea3a009480ae9d1ec1ef7128e3497a079cc84ac913fd212" :answer/id #uuid "03ecead9-ba75-5b7e-a445-05e1920e0afd" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{1+8\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15163/selection/1ea2e60f9a8b28201796c4772ab266b0314213a0595e755d2810a6120c364a7f" :answer/id #uuid "cb6dec3c-c4a6-59f8-8457-eac3e00dd532" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-15163/selection" :answer-field/id #uuid "fc3328c5-770b-5bd6-a74a-f2c348ddcd60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15163/selection/efbba29f9c626ab75f168fe940cd94ab0e0aa5bfda7d256dd545fa10f04ed1b1" :answer-field/choices ["q-15163/selection/efbba29f9c626ab75f168fe940cd94ab0e0aa5bfda7d256dd545fa10f04ed1b1" "q-15163/selection/af450c866ba6ac194c254a958c5b8ffac460cff0f9e8324c9556132eaf6efecb" "q-15163/selection/01a36387217c1d3a59a66936939d77da6703679710a5a99681e15d561c2a3d9d" "q-15163/selection/85f01b068c841f9ceea3a009480ae9d1ec1ef7128e3497a079cc84ac913fd212" "q-15163/selection/1ea2e60f9a8b28201796c4772ab266b0314213a0595e755d2810a6120c364a7f"] :db/ensure [:answer-field/validate]} {:db/id "q-15163" :question/id #uuid "a5e32b9b-5f96-5899-88ff-7723fbdb53e7" :question/math-academy-id "q-15163" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t+2\\operatorname{sin}⁡(t),\\,y=1+\\operatorname{cos}⁡(2t)$\nfrom $t=2$ to $t=5$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+2\\operatorname{sin}⁡(t))=1+2\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{(1+2\\operatorname{cos}⁡(t))^{2}+(-2\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15163/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-15163"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10256/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9a458430-505e-51a9-96a9-ffe032c92552" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-10256/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "a16f8a58-4b38-5bd4-9523-9317cb156282" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-10256/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "750d5b53-2633-5cf7-aef4-0f5c4afa2113" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-10256/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "12496322-5196-5217-9902-696f7ed41428" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-10256/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "e651852e-a80d-57bf-b588-adb5465498ab" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-10256/selection" :answer-field/id #uuid "900b3e75-1dde-526a-904c-07a2130445fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10256/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-10256/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-10256/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-10256/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-10256/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-10256/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-10256" :question/id #uuid "d83d6389-9d08-5064-9e29-4779ea6cc6fc" :question/math-academy-id "q-10256" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/da529910e268ea4c124d7c27b085ca1799e255604459c539cc8d5809dda8f95a.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx={sin}^{3}⁡t,\\,y={cos}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({sin}^{3}⁡t)=3{sin}^{2}⁡t\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({cos}^{3}⁡t)=-3{cos}^{2}⁡t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(3{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}+{(-3{cos}^{2}⁡t\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{4}⁡t{cos}^{2}⁡t+9{cos}^{4}⁡t{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =\\frac{3}{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{4}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{4}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{4}(-1-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10256/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-10256"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351505/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "647f336f-652d-536c-a12d-82562d43dd30" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-351505/field-1" :answer-field/id #uuid "a276716f-4ada-57c9-a588-9bca8d5bc1f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351505/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-351505/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-351505" :question/id #uuid "5db1ec2e-c404-5e8a-8537-4e63d5b3ba7e" :question/math-academy-id "q-351505" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/893efa56ec41ef2242a48831ad4f58b23edc791464ccc7dcb4dd104b87843360.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=t-\\frac{{t}^{3}}{3},\\,y={t}^{2},\\,t\\in [0,3].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{{t}^{3}}{3}) \\\\  & =1-{t}^{2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{(1-{t}^{2})^{2}+(2t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{1-2{t}^{2}+{t}^{4}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{1+2{t}^{2}+{t}^{4}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{(1+{t}^{2})^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}(1+{t}^{2})\\,\\text{d}t \\\\  & =(t+\\frac{{t}^{3}}{3})\\,{|}_{0}^{3} \\\\  & =(3+\\frac{27}{3})-0 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351505/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351439/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3d7e69ba-dfb4-54f1-967b-f46bb90aec38" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-351439/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "782a60a8-7501-5dba-b015-682ebcab6500" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-351439/field-1" :answer-field/id #uuid "dd8179b9-1599-5443-89d6-6c9a50d5f03f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351439/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-351439/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-351439/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-351439" :question/id #uuid "11c26dab-b087-5e3e-b280-6de12a9fd881" :question/math-academy-id "q-351439" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/0b9c4ebc430e05ef205e3d8108f2e1649bbc51b1a6b54e8f47b48e7ddad1e9a6.png)\n\nFind the arc length of the curve $L$ defined parametrically as\n\n$$\nx=4{cos}^{3}⁡t,\\,y=4{sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{4}].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{cos}^{3}⁡t) \\\\  & =4\\cdot 3{cos}^{2}⁡t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =-12\\operatorname{sin}⁡t{cos}^{2}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{sin}^{3}⁡t) \\\\  & =4\\cdot 3{sin}^{2}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & =12{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /4}\\sqrt{{(-12\\operatorname{sin}⁡t{cos}^{2}⁡t)}^{2}+{(12{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{4}⁡t+144{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}12|\\operatorname{sin}⁡t\\operatorname{cos}⁡t|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}12\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-3\\operatorname{cos}⁡(2t)\\,{|}_{0}^{\\pi /4} \\\\  & =-3\\operatorname{cos}⁡(\\frac{\\pi }{2})+3\\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351439/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351439"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351474/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "193db4fa-521b-5423-9b5a-a047c541b60c" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-351474/field-1" :answer-field/id #uuid "9415ae20-ebe6-54df-b8ea-70a5aecd7046" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351474/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-351474/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :db/ensure [:answer-field/validate]} {:db/id "q-351474" :question/id #uuid "232b62ea-7d8c-5d44-a709-a25bd20b0e4d" :question/math-academy-id "q-351474" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/cf06561072376949c6df49aec94b45c57b1cd43fbb031ea7b157ea5dfbac877a.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\frac{1}{9}(6t+1)^{3/2},\\,y=\\frac{3}{2}{t}^{2},\\,t\\in [0,1].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{9}(6t+1)^{3/2}) \\\\  & =\\frac{1}{9}\\cdot \\frac{3}{2}(6t+1)^{1/2}\\cdot 6 \\\\  & =(6t+1)^{1/2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{2}{t}^{2}) \\\\  & =3t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{((6t+1)^{1/2})}^{2}+(3t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{6t+1+9{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3t+1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}|3t+1|\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(3t+1)\\,\\text{d}t \\\\  & =(\\frac{3{t}^{2}}{2}+t)\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}+1)-0 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351474/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351474"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-10255"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/ac040bc2c3eb943f947f34602c7c03e90f18e129a0fa7749d8ae60faaab12f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=t-\\operatorname{sin}⁡t,\\,y=1-\\operatorname{cos}⁡t,\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡t)=1-\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-\\operatorname{cos}⁡t)=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{sin}^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ \\operatorname{cos}⁡t & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 1-\\operatorname{cos}⁡t & =2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 2-2\\operatorname{cos}⁡t & =4{sin}^{2}⁡(\\frac{t}{2})\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡(\\frac{t}{2})}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(\\frac{t}{2})\\text{d}t \\\\  & =-2\\cdot 2\\cdot {\\operatorname{cos}⁡(\\frac{t}{2})|}_{0}^{\\pi } \\\\  & =-4(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0) \\\\  & =-4(0-1) \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-602"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/834eff403ac2a6f696e104ec914cac1b951f8a6d989e11c0e9f2576ac9e7f0d8.png)\n\nFind an integral expression for the arc length of the curve defined parametrically as\n\n$$\nx=1-t, \\quad y= \\dfrac{2}{3} t^{3/2}, \\qquad t\\in[0,1].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-t)=-1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}{t}^{3/2})={t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(-1)}^{2}+{({t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{1+t}\\,\\text{d}t.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7130"] :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{tan}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{sec}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-603"] :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=e^t(\\cos{t}+\\sin{t}), \\quad y=e^t(\\cos{t}-\\sin{t}) , \\quad t\\in \\left[0,\\dfrac{\\pi}{4}\\right].\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/15d185178bf8882f837c19361d630c0e537e145ca2337cad4655677255d0348a.png)" :question/worked-solution "Computing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\  & =-2{e}^{t}\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(2{e}^{t}\\operatorname{cos}⁡t)}^{2}+{(-2{e}^{t}\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{4{e}^{2t}({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}2{e}^{t}\\,\\text{d}t \\\\  & =2{e}^{t}{|}_{0}^{\\pi /4} \\\\  & =2({e}^{\\pi /4}-1).\\end{aligned}\n$$" :db/ensure [:question/validate]}]
