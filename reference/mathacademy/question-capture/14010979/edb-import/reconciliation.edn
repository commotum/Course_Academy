d}t}(\\operatorname{cos}⁡(5t))=-5\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡(t))=6\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-5\\operatorname{sin}⁡(5t))^{2}+(6\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-123030" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/activity-metadata.json" "file_sha256" "76f1416cb6770f11d9b437e963585d4132b9f73be015e972b94b9a278e54e487"} {"question" "q-123030" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-123030" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /2}\\sqrt{10{sin}^{2}⁡(5t)+12{cos}^{2}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(t)+36{cos}^{2}⁡(t)}