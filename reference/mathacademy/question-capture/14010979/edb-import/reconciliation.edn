}^{2}-t)=2t-1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3{t}^{2})^{2}+(2t-1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-85724" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/activity-metadata.json" "file_sha256" "76f1416cb6770f11d9b437e963585d4132b9f73be015e972b94b9a278e54e487"} {"question" "q-85724" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-85724" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{0}^{1}\\sqrt{3{t}^{2}+2t-1}\\,\\text{d}t\\,"] ["math" "{\\int }_{0}^{1}\\sqrt{3{t}^{4}+4{t}^{2}-2t+1}\\,\\text{d}t\\,"] ["math" "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+2{t}^{2}-2t+1}\\,\\text{d}t\\,"] ["math" "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\,"] ["math" "{\\int }_{0}^{1}\\sqrt{{t}^{2}-12t+1}\\,\\text{d}t\\,"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-85724" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\,"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-81377" "field" nil "attribute" "question/problem" "value" "Which of the following gives the length of the curve defined by the parametric equations\n$x=t-1,\\,y={t}^{2}+2$\nfrom $t=-1$ to $t=2$ ?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-81377" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-1)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+2)=2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{{(1)}^{2}+{(2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/state.json" "file_sha256" "880b4c305cb48e839fe011b7427b25ba4982ca8d1307913ab8cbf1afbc395e00"} {"question" "q-81377" "field" nil "attribute" "question/diffi