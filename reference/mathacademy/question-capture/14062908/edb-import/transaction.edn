[{:db/id "q-325806/field-1/4770030a5b31b100afafcc5c6f2755c6cf14ec4c3e56fcf7c56d4ace77162137" :answer/id #uuid "f75605a3-ee97-5813-b73a-d2ca30845098" :answer/type :answer.type/math :answer/value "\\sqrt{7}\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-325806/field-1" :answer-field/id #uuid "23bd529c-07eb-5b2c-a903-1f6100fba042" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325806/field-1/4770030a5b31b100afafcc5c6f2755c6cf14ec4c3e56fcf7c56d4ace77162137" :answer-field/choices ["q-325806/field-1/4770030a5b31b100afafcc5c6f2755c6cf14ec4c3e56fcf7c56d4ace77162137"] :db/ensure [:answer-field/validate]} {:db/id "q-325806" :question/id #uuid "7df2b8ac-d3f5-5613-993f-e69a57f54d52" :question/math-academy-id "q-325806" :question/problem "Complete the following parametric equations generating the hyperbola $\\frac{{y}^{2}}{12}-\\frac{{x}^{2}}{7}=1$ in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2}.$\n\n$x=$\n{{field-1}}$,\\,y=2\\sqrt{3}\\operatorname{sec}⁡t$" :question/worked-solution "The parametric equations of a vertical hyperbola centered at the origin with Cartesian equation\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=b\\operatorname{tan}⁡t,\\,y=a\\operatorname{sec}⁡t.\n$$\n\nIn our case, $a=\\sqrt{12}=2\\sqrt{3}$ and $b=\\sqrt{7}.$ Therefore, the parametric equations are\n\n$$\nx=\\sqrt{7}\\operatorname{tan}⁡t,\\,y=2\\sqrt{3}\\operatorname{sec}⁡t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-325806/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6e4940d-fc80-563d-85a2-b83478cce6c5"] :knowledge-point/questions ["q-325806"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106608/selection/16f086669bbc82f1e768784fc4c6da5013685eda4e5010bac483ce508e2d29a9" :answer/id #uuid "db0e8dbb-c5db-54e6-bad5-ce5488bccf5e" :answer/type :answer.type/math :answer/value "x=2\\sq