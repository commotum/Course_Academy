[{:db/id [:question/math-academy-id "q-39047"] :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=1.$ This means that $k=1$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.\n$$\n\nAlso, we are given that the point $(1,2.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1 \\\\ 2.5 & =\\frac{a}{1}+1 \\\\ 1.5 & =\\frac{a}{1} \\\\ a & =1.5.\\end{aligned}\n$$\n\nFinally, $a+k=1+1.5=2.5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-113336/selection/0829dbd1078cfa02cbba88fdaf2cc6ed0609ec6416b52017985899fe46d78dee" :answer/id #uuid "849ca7f1-98c0-55d1-8270-d3605d0495e7" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934099/assets/e4247c7cea75f1b89cd9bb161a96213de3529ce3c17926adf8633ae9483f154b.png" :db/ensure [:answer/validate]} {:db/id "q-113336/selection/40b9c4277cf5498eba6e5dee025be780bd1601c49c7e7c1fd5ad585e2609cf6d" :answer/id #uuid "6d32874f-0a89-56ca-a4ae-c77c6ee5dcc8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934099/assets/c525edcf937bfdc311acd0d7cac778802e1939dc2bd61fd3a5bf58f808712220.png" :db/ensure [:answer/validate]} {:db/id "q-113336/selection/70526f59dab877c11f50f2b7e83b59bc5df0804c0e87dffb477cb7c9844cb0d3" :answer/id #uuid "db012b3b-f292-540d-bbe2-88a8b0dd4766" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934099/assets/7152303066f322a8179b2e37863cea6367290998e31382fa0470a1ab50b4d2ff.png" :db/ensure [:answer/validate]} {:db/id "q-113336/selection/0a309a51956eb74a978fb28a67c94833dd2dd7cc8171babf09d014253fe824cd" :answer/id #uuid "b011507f-5023-56d5-b9d5-a52a12db6b52" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/