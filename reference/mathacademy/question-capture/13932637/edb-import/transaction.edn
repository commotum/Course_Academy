\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160054/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74"] :knowledge-point/questions ["q-160054"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160056/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "79b2667d-7ee5-5945-b424-4b606d6cce03" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-160056/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0bec0fed-039d-5e7e-a0bf-330ade3efe9b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-160056/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8da6c7d9-7de1-599a-aa78-f7fc86161b37" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-160056/selection/ab3343a580c9ecbbb4e27d0c43b67b7d3815a6806a811b62927c9243c7c87034" :answer/id #uuid "e2fe332c-bcb0-5e04-9e28-64c50b2f3ee8" :answer/type :answer.type/math :answer/value "4.5" :db/ensure [:answer/validate]} {:db/id "q-160056/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a345f266-896d-5547-b476-ccd07eea255e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-160056/selection" :answer-field/id #uuid "94da0c88-09cd-5d29-a6cc-e633c3b6f483" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160056/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-160056/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-160056/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-160056/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d2