 the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{7}\\cdot (19+3z) \\\\  & =\\frac{19+3z}{7}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=4,$ we have\n\n$$\n\\begin{aligned}4 & =\\frac{19+3z}{7} \\\\ 28 & =19+3z \\\\ 9 & =3z \\\\ z & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc"] :knowledge-point/questions ["q-86963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160028/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "bc22ff4b-391b-50c4-9f0c-730521dd3d42" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-160028/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" :answer/id #uuid "665c1831-6a27-529e-a70f-897c91b90d7b" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "q-160028/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "ac7704bb-fe04-58da-937e-8660ac6e7130" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-160028/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "b10af80a-7e7e-547d-baaa-2d699eebeff1" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-160028/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "d57f13e2-6d0f-57d5-9efd-881b39406d1b" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-160028/selection" :answer-field/id #uuid "31f7e815-9cf8-510e-9cce-9e6d43e7d1f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160