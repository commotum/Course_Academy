#{[{:db/id #edb/ref 17592186281268 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a268cb6c-4f1f-528c-af25-723efe591bb9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186281270} {:answer/id #uuid "f0d5fd54-1d1f-538d-bcac-907c0ecc5c3d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281271} {:answer/id #uuid "9d982063-5630-571b-8260-e4a7cca67653" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186281272} {:answer/id #uuid "91f77359-9842-506d-a7c6-80b145dc882d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186281273} {:answer/id #uuid "eac5d5df-2e24-5f04-ba99-7afae7db1cde" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281274}] :answer-field/correct {:answer/id #uuid "f0d5fd54-1d1f-538d-bcac-907c0ecc5c3d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281271} :answer-field/id #uuid "1a2824ee-936d-5e13-b863-e43d4c60d600" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281269}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0fbe66e-c44a-5c47-b716-80288ecee20d" :question/math-academy-id "q-113880" :question/problem "What is ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0,$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{3}{n})\\,\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281275 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bbb93ff-2e40-5eb7-b3d9-1f4ab7c36c6e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186281277} {:answer/id #uuid "f45ae609-b293-5ecd-ae13-a629d451a39e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n-1}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186281278} {:answer/id #uuid "42e9ab33-50d1-50a9-abd0-f1d3debe28ef" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186281279} {:answer/id #uuid "a9230727-6510-51ef-b27c-bdd878418744" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n-1}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186281280} {:answer/id #uuid "718135ed-16b7-5a3b-a66d-8cfd4eefd6d0" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186281281}] :answer-field/correct {:answer/id #uuid "0bbb93ff-2e40-5eb7-b3d9-1f4ab7c36c6e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186281277} :answer-field/id #uuid "e63135ba-26da-5c51-b628-417004eebc8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281276}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "20ce8581-cde7-5c3f-af9e-831159aa4bed" :question/math-academy-id "q-113884" :question/problem "What is ${\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x-1},$ the lower bound is $a=1,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+i\\cdot \\frac{4}{n})\\,\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+\\frac{4i}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{1+4i/n-1}\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281282 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5751e645-9c5b-5f44-9766-a2290951eddf" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186281284} {:answer/id #uuid "6c757fd2-aec0-537f-83a5-7b30217bc33d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281285} {:answer/id #uuid "39faeff0-b8b5-5c6d-8019-5ab0e5f531bc" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{3n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281286} {:answer/id #uuid "d4882345-2718-5029-93e5-7db37c5a7888" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186281287} {:answer/id #uuid "c632a734-93fe-5fc3-a711-ca02585abbdf" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186281288}] :answer-field/correct {:answer/id #uuid "6c757fd2-aec0-537f-83a5-7b30217bc33d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186281285} :answer-field/id #uuid "32066e40-8248-5329-a911-ceff541b37c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281283}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" :question/math-academy-id "q-113929" :question/problem "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186281289 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5" :knowledge-point/title "Expressing the Limit of a Left Riemann Sum as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7693a304-eb4e-58ab-a52a-c5c73125a9f9" :answer/type {:db/ident :answer.type/math} :answer/value "5x^3" :db/id #edb/ref 17592186281291}] :answer-field/correct {:answer/id #uuid "7693a304-eb4e-58ab-a52a-c5c73125a9f9" :answer/type {:db/ident :answer.type/math} :answer/value "5x^3" :db/id #edb/ref 17592186281291} :answer-field/id #uuid "db8d4311-559f-5153-87ea-8cc740ab9e87" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281290} {:answer-field/choices [{:answer/id #uuid "eefb9ce1-7f3f-5937-87e0-b612501d7355" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186281293}] :answer-field/correct {:answer/id #uuid "eefb9ce1-7f3f-5937-87e0-b612501d7355" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186281293} :answer-field/id #uuid "7af62e76-c5b3-512b-a30b-16f91d7c07a3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186281292}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d8bb7cca-e93f-5806-a90e-a98e8d340170" :question/math-academy-id "q-346190" :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[5{(2+\\frac{4k}{n})}^{3}\\cdot \\frac{4}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-2}{n}\\,⟹\\,b=6.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{4k}{n}$ and $f({x}_{k})=5{x}_{k}^{3}.$\n\nHence,\n\n$$\n{\\int }_{2}^{6}5{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[5{(2+\\frac{4k}{n})}^{3}\\cdot \\frac{4}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=5{x}^{3}\\,\\text{and}\\,b=6.\n$$"}] [{:db/id #edb/ref 17592186097189 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8114ede2-effd-596b-b39c-99cb8eed7a02" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(4 + \\frac{m}{n}\\right)^{2} \\cdot \\frac{1}{n}\\right]" :db/id #edb/ref 17592186095492} {:answer/id #uuid "dea3c589-8a17-5c66-a646-422f75f60ac8" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(2 + \\frac{2m}{n}\\right)^{2} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095493} {:answer/id #uuid "0b781b1a-d1bf-5b05-a12f-e7207343d2ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(3 + \\frac{2m}{n}\\right)^{2} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095494} {:answer/id #uuid "233359e2-6770-5996-b09e-05397e4eafe0" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(3 + \\frac{m}{n}\\right)^{2} \\cdot \\frac{1}{n}\\right]" :db/id #edb/ref 17592186095495} {:answer/id #uuid "5143b323-45d4-5fdb-ba1c-64950ba9d75b" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(2 + \\frac{m}{n}\\right)^{2} \\cdot \\frac{1}{n}\\right]" :db/id #edb/ref 17592186095496}] :answer-field/correct {:answer/id #uuid "0b781b1a-d1bf-5b05-a12f-e7207343d2ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{m=1}^{n}\\left[\\left(3 + \\frac{2m}{n}\\right)^{2} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095494} :answer-field/id #uuid "987399aa-444f-5a2c-b5b6-9b929c1f83d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095491}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "85f21a5e-5c72-5b71-8626-29d3f6d85433" :question/math-academy-id "q-49193" :question/problem "What is ${\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+1)^{2},$ the lower bound is $a=2$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+m\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+\\frac{2m}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{((2+\\frac{2m}{n})+1)}^{2}\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(3+\\frac{2m}{n})}^{2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}]}
