[{:db/id [:question/math-academy-id "q-49193"] :question/problem "What is ${\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx,\n$$\n\nwhere ${x}_{m}=a+mΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=(x+1)^{2},$ the lower bound is $a=2$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}(x+1)^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}f({x}_{m})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+m\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[f(2+\\frac{2m}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{((2+\\frac{2m}{n})+1)}^{2}\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{m=1}^{n}[{(3+\\frac{2m}{n})}^{2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-113880/selection/5836e7c4a50f51bc6c8f4418ab2080c2b1230c201d0dd686d8560f9c4e4ebb67" :answer/id #uuid "f0d5fd54-1d1f-538d-bcac-907c0ecc5c3d" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113880/selection/ad432f260ae9c673a05dcd408544e51d96cabe58ecb31866c2ef003276f94a5c" :answer/id #uuid "91f77359-9842-506d-a7c6-80b145dc882d" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113880/selection/5bb5f8379a694a16d8917893bb24f053f530c738d7425adae14f5748c6debd85" :answer/id #uuid "9d982063-5630-571b-8260-e4a7cca67653" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113880/selection/b957a9eb78fd5c785986627c300834340d60f68b78506050f80e2efdd62d4f7d" :answer/id #uuid "eac5d5df-2e24-5f04-ba99-7afae7db1cde" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113880/selection/228f777bcabe95139725864dcd012e9818f578dbbe9151d3879a307dc3ae28ea" :answer/id #uuid "a268cb6c-4f1f-528c-af25-723efe591bb9" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{3n}]" :db/ensure [:answer/validate]} {:db/id "q-113880/selection" :answer-field/id #uuid "1a2824ee-936d-5e13-b863-e43d4c60d600" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113880/selection/5836e7c4a50f51bc6c8f4418ab2080c2b1230c201d0dd686d8560f9c4e4ebb67" :answer-field/choices ["q-113880/selection/5836e7c4a50f51bc6c8f4418ab2080c2b1230c201d0dd686d8560f9c4e4ebb67" "q-113880/selection/ad432f260ae9c673a05dcd408544e51d96cabe58ecb31866c2ef003276f94a5c" "q-113880/selection/5bb5f8379a694a16d8917893bb24f053f530c738d7425adae14f5748c6debd85" "q-113880/selection/b957a9eb78fd5c785986627c300834340d60f68b78506050f80e2efdd62d4f7d" "q-113880/selection/228f777bcabe95139725864dcd012e9818f578dbbe9151d3879a307dc3ae28ea"] :db/ensure [:answer-field/validate]} {:db/id "q-113880" :question/id #uuid "a0fbe66e-c44a-5c47-b716-80288ecee20d" :question/math-academy-id "q-113880" :question/problem "What is ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0,$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{3}{n})\\,\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113880/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a"] :knowledge-point/questions ["q-113880"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113884/selection/b4eb3cdb743b0090d30f368ed9bed600f65220a590b29199ba23dfc4a2a5cec1" :answer/id #uuid "a9230727-6510-51ef-b27c-bdd878418744" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n-1}\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113884/selection/5d76068bcfbe72aab881287693385641d9b4825f4d4494796544c4999e6afc80" :answer/id #uuid "42e9ab33-50d1-50a9-abd0-f1d3debe28ef" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113884/selection/f95ebe0f7992e926317eafe7c4ddbe6db5840919304ffd6a4d2ae8205a4609da" :answer/id #uuid "718135ed-16b7-5a3b-a66d-8cfd4eefd6d0" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{5}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113884/selection/4405287a9c777fecf26e89a894fcae83f63ceb491674263cedfa08b643d8c34e" :answer/id #uuid "f45ae609-b293-5ecd-ae13-a629d451a39e" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n-1}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113884/selection/32b35b269c58be6f33a05719ec6ef5f3e2efc161e7b1c4df1290573113299fe3" :answer/id #uuid "0bbb93ff-2e40-5eb7-b3d9-1f4ab7c36c6e" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113884/selection" :answer-field/id #uuid "e63135ba-26da-5c51-b628-417004eebc8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113884/selection/32b35b269c58be6f33a05719ec6ef5f3e2efc161e7b1c4df1290573113299fe3" :answer-field/choices ["q-113884/selection/b4eb3cdb743b0090d30f368ed9bed600f65220a590b29199ba23dfc4a2a5cec1" "q-113884/selection/5d76068bcfbe72aab881287693385641d9b4825f4d4494796544c4999e6afc80" "q-113884/selection/f95ebe0f7992e926317eafe7c4ddbe6db5840919304ffd6a4d2ae8205a4609da" "q-113884/selection/4405287a9c777fecf26e89a894fcae83f63ceb491674263cedfa08b643d8c34e" "q-113884/selection/32b35b269c58be6f33a05719ec6ef5f3e2efc161e7b1c4df1290573113299fe3"] :db/ensure [:answer-field/validate]} {:db/id "q-113884" :question/id #uuid "20ce8581-cde7-5c3f-af9e-831159aa4bed" :question/math-academy-id "q-113884" :question/problem "What is ${\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x-1},$ the lower bound is $a=1,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+i\\cdot \\frac{4}{n})\\,\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+\\frac{4i}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{1+4i/n-1}\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113884/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a"] :knowledge-point/questions ["q-113884"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113929/selection/276bfee6985abe113d1e5106e7228f4be8fea6c9c435444a447dc0a69319b220" :answer/id #uuid "5751e645-9c5b-5f44-9766-a2290951eddf" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{n})\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113929/selection/b19dcd272cc6b752f4d6b085186662d4d2a10c4c1d45a63811d3c895d0b34383" :answer/id #uuid "c632a734-93fe-5fc3-a711-ca02585abbdf" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{3n}]" :db/ensure [:answer/validate]} {:db/id "q-113929/selection/41c661ce8585cf6f1e146b1d735b9929c667e8248847638fee13801c7d5da466" :answer/id #uuid "d4882345-2718-5029-93e5-7db37c5a7888" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113929/selection/29291e8060c79e00f446e4d74f9da7deebe48e4236c753ee72440e1574c84aa5" :answer/id #uuid "6c757fd2-aec0-537f-83a5-7b30217bc33d" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113929/selection/40c5a458bb9d0ab920f0affedb51b9e7cd9fed9ac66cda7cf3876f7ee78471e0" :answer/id #uuid "39faeff0-b8b5-5c6d-8019-5ab0e5f531bc" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{3n})\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113929/selection" :answer-field/id #uuid "32066e40-8248-5329-a911-ceff541b37c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113929/selection/29291e8060c79e00f446e4d74f9da7deebe48e4236c753ee72440e1574c84aa5" :answer-field/choices ["q-113929/selection/276bfee6985abe113d1e5106e7228f4be8fea6c9c435444a447dc0a69319b220" "q-113929/selection/b19dcd272cc6b752f4d6b085186662d4d2a10c4c1d45a63811d3c895d0b34383" "q-113929/selection/41c661ce8585cf6f1e146b1d735b9929c667e8248847638fee13801c7d5da466" "q-113929/selection/29291e8060c79e00f446e4d74f9da7deebe48e4236c753ee72440e1574c84aa5" "q-113929/selection/40c5a458bb9d0ab920f0affedb51b9e7cd9fed9ac66cda7cf3876f7ee78471e0"] :db/ensure [:answer-field/validate]} {:db/id "q-113929" :question/id #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" :question/math-academy-id "q-113929" :question/problem "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113929/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2"] :knowledge-point/questions ["q-113929"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346190/field-1/afceeb56e7a37b9b1594ef9e37263efb5583f0be67ee7aabdc56e448000113d2" :answer/id #uuid "7693a304-eb4e-58ab-a52a-c5c73125a9f9" :answer/type :answer.type/math :answer/value "5x^3" :db/ensure [:answer/validate]} {:db/id "q-346190/field-1" :answer-field/id #uuid "db8d4311-559f-5153-87ea-8cc740ab9e87" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346190/field-1/afceeb56e7a37b9b1594ef9e37263efb5583f0be67ee7aabdc56e448000113d2" :answer-field/choices ["q-346190/field-1/afceeb56e7a37b9b1594ef9e37263efb5583f0be67ee7aabdc56e448000113d2"] :db/ensure [:answer-field/validate]} {:db/id "q-346190/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "eefb9ce1-7f3f-5937-87e0-b612501d7355" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-346190/field-2" :answer-field/id #uuid "7af62e76-c5b3-512b-a30b-16f91d7c07a3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346190/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-346190/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-346190" :question/id #uuid "d8bb7cca-e93f-5806-a90e-a98e8d340170" :question/math-academy-id "q-346190" :question/problem "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[5{(2+\\frac{4k}{n})}^{3}\\cdot \\frac{4}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{4}{n}.$ Therefore, \n\n$$\n\\frac{4}{n}=\\frac{b-2}{n}\\,⟹\\,b=6.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{4k}{n}$ and $f({x}_{k})=5{x}_{k}^{3}.$\n\nHence,\n\n$$\n{\\int }_{2}^{6}5{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[5{(2+\\frac{4k}{n})}^{3}\\cdot \\frac{4}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)=5{x}^{3}\\,\\text{and}\\,b=6.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346190/field-1" "q-346190/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5"] :knowledge-point/questions ["q-346190"] :db/ensure [:knowledge-point/validate]}]
