d1fb2e37fff68cec289.png)\n\nNow, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-10 & =6 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nHence, we need to integrate from $x=-4$ to $x=4.$\n\nTo determine which is the lower function and which is the upper, we draw our vertical arrow.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033713/assets/173d726e4b0ecee37d8b7ca8878f5bc5934a069dc48a2b9d18e28d72f3b04f7e.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y={x}^{2}-10,$ and\n\n- *leaves* through the upper function $y=6.$\n\nTherefore, we can find the area, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{-4}^{4}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\text{d}x \\\\  & ={\\int }_{-4}^{4}[\\,(6)-({x}^{2}-10)\\,]\\,\\text{d}x \\\\  & ={\\int }_{-4}^{4}(16-{x}^{2})\\,\\text{d}x \\\\  & ={(16x-\\frac{1}{3}{x}^{3})|}_{-4}^{4} \\\\  & =[16\\cdot 4-\\frac{1}{3}\\cdot {4}^{3}]-[16\\cdot (-4)-\\frac{1}{3}\\cdot (-4)^{3}] \\\\  & =(64-\\frac{64}{3})-(-64+\\frac{64}{3}) \\\\  & =\\frac{256}{3}\\end{aligned}\n$$" 13194139534547 true] [17592186294142 1000 #edb/ref 17592186294143 13194139534547 true] [17592186294142 1000 #edb/ref 17592186294144 13194139534547 true] [17592186294142 1000 #edb/ref 17592186294145 13194139534547 true] [17592186294142 1000 #edb/ref 17592186294146 13194139534547 true] [17592186294142 1000 #edb/ref 17592186294147 13194139534547 true] [17592186294142 1040 #edb/ref 17592186045450 13194139534547 true] [17592186294142 1041 "selection" 13194139534547 true] [17592186294142 1104 #edb/ref 17592186294146 13194139534547 true] [17592186294142 1110 #uuid "03e42d4f-1366-595e-be2b-243c9be99de4" 13194139534547 true] [17592186294143 1034 "\\frac{64}{3}" 13194139534547 true] [17592186294143 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294143 1111 #uuid "f0b13a58-949d-59bd-b81d-b7146f916083" 13194139534547 true] [17592186294144 1034 "\\frac{32}{3}" 13194139534547 true] [17592186294144 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294144 1111 #uuid "dcfa1c93-7144-5efd-a7f6-dd4226d855db" 13194139534547 true] [17592186294145 1034 "96" 13194139534547 true] [17592186294145 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294145 1111 #uuid "9bb367bd-abc7-594b-ae48-30d1fd779359" 13194139534547 true] [17592186294146 1034 "\\frac{256}{3}" 13194139534547 true] [17592186294146 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294146 1111 #uuid "a076330d-e49e-53cf-a0b7-93b2b2c02acb" 13194139534547 true] [17592186294147 1034 "\\frac{251}{3}" 13194139534547 true] [17592186294147 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294147 1111 #uuid "9e1ea365-e568-5919-b405-f3c90be18740" 13194139534547 true] [17592186294148 1017 #edb/ref 17592186294149 13194139534547 true] [17592186294148 1089 "q-356029" 13194139534547 true] [17592186294148 1091 #edb/ref 17592186045465 13194139534547 true] [17592186294148 1100 "Calculate the area of the finite region bounded by the curves $y={x}^{2}-3$ and $y=1.$\n\n$A=$\n{{field-1}}" 13194139534547 true] [17592186294148 1113 #uuid "dabd07a4-7ceb-5d01-9a56-3f969a97f96a" 13194139534547 true] [17592186294148 1145 "First, let's draw a sketch of the two functions.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033713/assets/664fcc791ec42b4ec40ed3fc7033fa601d646c9900632864122d31fd01a2cf61.png)\n\nNow, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x:$\n\n$$\n\\begin{aligned}{x}^{2}-3 & =1 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nHence, we need to integrate from $x=-2$ to $x=2.$\n\nTo determine which is the lower function and which is the upper, we draw our vertical arrow.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033713/assets/1d10b1994774239767578417bc5f0b74a6a7369005a73fbac859574c9d5d36e0.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y={x}^{2}-3,$ and\n\n- *leaves* through the upper function $y=1.$\n\nTherefore, we can find the area, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{-2}^{2}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\text{d}x \\\\  & ={\\int }_{-2}^{2}[\\,(1)-({x}^{2}-3)\\,]\\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}(4-{x}^{2})\\,\\text{d}x \\\\  & ={(4x-\\frac{1}{3}{x}^{3})|}_{-2}^{2} \\\\  & =[4\\cdot 2-\\frac{1}{3}\\cdot {2}^{3}]-[4\\cdot (-2)-\\frac{1}{3}\\cdot (-2)^{3}] \\\\  & =(8-\\frac{8}{3})-(-8+\\frac{8}{3}) \\\\  & =\\frac{16}{3}-(-\\frac{16}{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" 13194139534547 true] [17592186294149 1000 #edb/ref 17592186294150 13194139534547 true] [17592186294149 1040 #edb/ref 17592186045449 13194139534547 true] [17592186294149 1041 "field-1" 13194139534547 true] [17592186294149 1104 #edb/ref 17592186294150 13194139534547 true] [17592186294149 1110 #uuid "f2245c1f-04cb-53e9-b142-66a2689d6ad3" 13194139534547 true] [17592186294150 1034 "\\frac{32}{3}" 13194139534547 true] [17592186294150 1103 #edb/ref 17592186045453 13194139534547 true] [17592186294150 1111 #uuid "29ee47f7-9e46-528f-bf70-34a3947a8bb0" 13194139534547 true]] :edb/tempids {"q-121517" 17592186294120 "q-121517/selection" 17592186294121 "q-121517/selection/66736252f18499cc2804196f97bcc5d148f56e758bfca4b340e05188d7b7bd18" 17592186294122 "q-121517/selection/68a8df4fdb540ecbc528a243a3e5c984bc43b9f3844c18c4a60e85d673faf5cc" 17592186294123 "q-121517/selection/9b2c5bca9a3bd65a75767f8ed6fd80aaaeca99d50bd1add3c844b23aeea2dfa6" 17592186294124 "q-121517/selection/a9e78eb1cdf90a86a8187ba160bdfe049177f6aea162ecea84a2ac696e15b72c" 17592186294125 "q-121517/selection/e5a2851211f542fd9cfcf106c2f7275665ee6e84243495971caacd862330bd9f" 17592186294126 "q-121566" 17592186294127 "q-121566/selection" 17592186294128 "q-121566/selection/0483ed1fbad303bda6477560ba729ea4