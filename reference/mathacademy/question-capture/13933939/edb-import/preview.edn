-6-6}{0-(-2)} \\\\  & =\\frac{-12}{2} \\\\  & =-6\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (-6)=-1\\,⇒\\,m=\\frac{1}{6}.\n$$\n\nWe know that the line passes through the point $(-6,5).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{1}{6}(x-(-6)) \\\\ y-5 & =\\frac{1}{6}(x+6) \\\\ y-5 & =\\frac{1}{6}x+1 \\\\ y & =\\frac{1}{6}x+6\\end{aligned}\n$$" 13194139533686 true] [17592186246866 1000 #edb/ref 17592186246867 13194139533686 true] [17592186246866 1000 #edb/ref 17592186246868 13194139533686 true] [17592186246866 1000 #edb/ref 17592186246869 13194139533686 true] [17592186246866 1000 #edb/ref 17592186246870 13194139533686 true] [17592186246866 1000 #edb/ref 17592186246871 13194139533686 true] [17592186246866 1040 #edb/ref 17592186045450 13194139533686 true] [17592186246866 1041 "selection" 13194139533686 true] [17592186246866 1104 #edb/ref 17592186246869 13194139533686 true] [17592186246866 1110 #uuid "c506f7ea-f204-5fe9-8d02-39049270a1cc" 13194139533686 true] [17592186246867 1034 "y=-\\frac{1}{6}x+4" 13194139533686 true] [17592186246867 1103 #edb/ref 17592186045453 13194139533686 true] [17592186246867 1111 #uuid "6bec70c9-5e65-5511-8369-e98b7f037611" 13194139533686 true] [17592186246868 1034 "y=3x+6" 13194139533686 true] [17592186246868 1103 #edb/ref 17592186045453 13194139533686 true] [17592186246868 1111 #uuid "1e065ea5-b657-55dd-bf38-765441fce976" 13194139533686 true] [17592186246869 1034 "y=\\frac{1}{6}x+6" 13194139533686 true] [17592186246869 1103 #edb/ref 17592186045453 13194139533686 true] [17592186246869 1111 #uuid "f4046e3e-1549-522e-95c9-1df51a0eb033" 13194139533686 true] [17592186246870 1034 "y=\\frac{1}{6}x-3" 13194139533686 true] [17592186246870 1103 #edb/ref 17592186045453 13194139533686 true] [17592186246870 1111 #uuid "03483045-a4e7-57d8-a807-f45aeba59056" 1319413953