})(x-(-3\\text{i})) \\\\  & =-4(x-6)(x-3\\text{i})(x+3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-4(x-6)(x-3\\text{i})(x+3\\text{i}) & = \\\\ -4(x-6)({x}^{2}-x(-3\\text{i})-x(3\\text{i})+(3\\text{i})(-3\\text{i})) & = \\\\ -4(x-6)({x}^{2}+9) & = \\\\ -4({x}^{3}-6{x}^{2}+9x-54) & = \\\\ -4{x}^{3}+24{x}^{2}-36x+216.\\end{aligned}\n$$\n\nTherefore, $f(x)=-4{x}^{3}+24{x}^{2}-36x+216.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316707/field-1" "q-316707/field-2" "q-316707/field-3" "q-316707/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-316707"] :db/ensure [:knowledge-point/validate]}]
