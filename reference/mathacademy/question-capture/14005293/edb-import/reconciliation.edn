ademy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" nil "attribute" "question/problem" "value" "The cubic polynomial $f(x)$ has roots ${x}_{1}=-2,{x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $3.$ Find $f(x).$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,+$\n{{field-4}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" nil "attribute" "question/worked-solution" "value" "Since $f(x)$ has roots ${x}_{1}=-2$ and ${x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =3(x-(-2))(x-4\\text{i})(x-(-4\\text{i})) \\\\  & =3(x+2)(x-4\\text{i})(x+4\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x+2)(x-4\\text{i})(x+4\\text{i}) & = \\\\ 3(x+2)({x}^{2}-(4\\text{i})^{2}) & = \\\\ 3(x+2)({x}^{2}+16) & = \\\\ 3({x}^{3}+2{x}^{2}+16x+32) & = \\\\ 3{x}^{3}+6{x}^{2}+48x+96 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=3{x}^{3}+6{x}^{2}+48x+96.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/activity-metadata.json" "file_sha256" "9573aca0153e9509d90542c4195918d4d6d289707f325d2389a641af001e733c"} {"question" "q-316646" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "48"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316646" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "96"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" nil "attribute" "question/problem" "value" "The cubic polynomial $f(x)$ has roots ${x}_{1}=6,\\,{x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $-4.$ Find $f(x).$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,-$\n{{field-3}}$x\\,+$\n{{field-4}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" nil "attribute" "question/worked-solution" "value" "Since $f(x)$ has roots ${x}_{1}=6$ and ${x}_{2,3}=\\pm 3\\text{i},$ and the coefficient of the cubic term is $a=-4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-4(x-6)(x-3\\text{i})(x-(-3\\text{i})) \\\\  & =-4(x-6)(x-3\\text{i})(x+3\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-4(x-6)(x-3\\text{i})(x+3\\text{i}) & = \\\\ -4(x-6)({x}^{2}-x(-3\\text{i})-x(3\\text{i})+(3\\text{i})(-3\\text{i})) & = \\\\ -4(x-6)({x}^{2}+9) & = \\\\ -4({x}^{3}-6{x}^{2}+9x-54) & = \\\\ -4{x}^{3}+24{x}^{2}-36x+216.\\end{aligned}\n$$\n\nTherefore, $f(x)=-4{x}^{3}+24{x}^{2}-36x+216.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/activity-metadata.json" "file_sha256" "9573aca0153e9509d90542c4195918d4d6d289707f325d2389a641af001e733c"} {"question" "q-316707" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "24"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005293/state.json" "file_sha256" "ef14331e04c6d28adbb583495b3f14da60285ce4273c93b0531610c105608fed"} {"question" "q-316707" "field" "field-3" "attribute" "answer-fie