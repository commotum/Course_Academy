c{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-\\sqrt{3},\\frac{2\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{2\\pi }{3},-\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{2\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(-\\sqrt{3},\\frac{2\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70788/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3"] :knowledge-point/questions ["q-70788"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117327/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "26ed51df-1be4-5b59-8fa1-5418142ad82b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-117327/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "83c064fc-ab83-5b28-b532-72905ffb236e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-117327/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c7c0f8db-7da9-5c5a-a286-92f63d1763c7" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-117327/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "4339146d-f056-5902-a549-a99aae28d0b1" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-117327/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "438d7893-679e-5704-b62f-32c7d4a5d4c2" :answer/type :answer.type/text :answer/value