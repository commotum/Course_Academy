038b918a792c4a49367b9599ea3bb5b" "q-24069/selection/3e769c302a97e2d5dd45eb10d98f3f3af14f16652220714c822ef13229ef9ecd"] :db/ensure [:answer-field/validate]} {:db/id "q-24069" :question/id #uuid "e7e5b456-31be-5adc-bcb7-b8fe111eed32" :question/math-academy-id "q-24069" :question/problem "If $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ and ${0}^{∘}<\\theta <{90}^{∘}$ then what is the value of $\\operatorname{cos}⁡\\theta ?$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/9d9aa1e6ffac387c53c7a1b35217a51cd17db7242ddedec4ff72c229a73d5291.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{7}.$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{7}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{49}} \\\\  & =\\pm \\sqrt{\\frac{40}{49}} \\\\  & =\\pm \\frac{2\\sqrt{10}}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{cos}⁡\\theta $ is positive in the first quadrant. So, $\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{10}}{7}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-24069/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69"] :knowledge-point/questions ["q-24069"] :db/ensure [:knowledge-point/validate]} {:db/id "q-45875/selection/b4387ad26113f9ec520143504e8e5fea8e20f85b95f23ef594b892912c8dd103" :answer/id #uuid "620b7d59-d337-5de3-ad58-638df86207d1" :answer/type :answer.type/math :answer/value "-\\frac{5\\sqrt{5}}{12}" :db/ensure [:answer/validate]} {:db/id "q-45875/selection/8ac6c6c7d249575df9d3e781b9059f9456dafd4021165f2f55944a5536588d47" :answer/id #uuid "f1dd8e5f-61aa-5df4-8ebb-2ab41b937710" :answer/type :answer.type/math :answer/value "-\\frac{25}{12}" :db/ensure [:answer/validate]} {:db/id "q-45875/selection/8a50ba0de06722c8822f2a06b301d0decf0eabc4f5d12ad8d94af1eeee82191b" :answer/id #uuid "2a3c859f-6933-51c1-bd20-19461ae114af" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{5}}{12}" :db/ensure [:answer/validate]} {:db/id "q-45875/selection/b7d635e6bab0b244d842490ed9df4caae12931d063396903b86b8abf5e7afcdf" :answer/id #uuid "a56d5efc-5ccf-5f34-8513-e254bcf90ce3" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{5}}{12}" :db/ensure [:answer/validate]} {:db/id "q-45875/selection/daa84a7dc218c6021783d9dab7d570ceee3b0b6595b095c0cd07116af3d42743" :answer/id #uuid "541bed6c-d5a5-5d0f-90f9-da5c1f478b56" :answer/type :answer.type/math :answer/value "\\frac{25}{12}" :db/ensure [:answer/validate]} {:db/id "q-45875/selection" :answer-field/id #uuid "37911eeb-03d0-56e2-9a45-bc722d11ff1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-45875/selection/8ac6c6c7d249575df9d3e781b9059f9456dafd4021165f2f55944a5536588d47" :answer-field/choices ["q-45875/selection/b4387ad26113f9ec520143504e8e5fea8e20f85b95f23ef594b892912c8dd103" "q-45875/selection/8ac6c6c7d249575df9d3e781b9059f9456dafd4021165f2f55944a5536588d47" "q-45875/selection/8a50ba0de06722c8822f2a06b301d0decf0eabc4f5d12ad8d94af1eeee82191b" "q-45875/selection/b7d635e6bab0b244d842490ed9df4caae12931d063396903b86b8abf5e7afcdf" "q-45875/selection/daa84a7dc218c6021783d9dab7d570ceee3b0b6595b095c0cd07116af3d42743"] :db/ensure [:answer-field/validate]} {:db/id "q-45875" :question/id #uuid "fa952d8d-3630-5d49-a36f-eb08d27d8910" :question/math-academy-id "q-45875" :question/problem "If $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "As $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ then $\\operatorname{sin}⁡\\theta =\\frac{1}{\\operatorname{csc}⁡\\theta }=\\frac{3}{5}.$\n\nLet's sketch our angle $\\theta $ in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/aaba5af0542d29ef91d4b0e17907a81e32bccc402c48b32c205e7298630b5bc0.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{25}} \\\\  & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{4}{5}.$\n\nFinally, knowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ and $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }$ we have:\n\n- $\\operatorname{cot}⁡\\theta =\\frac{(-\\frac{4}{5})}{(\\frac{3}{5})}=-\\frac{4}{3}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{(\\frac{3}{5})}{(-\\frac{4}{5})}=-\\frac{3}{4}.$\n\nFinally, we have\n\n$\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta =-\\frac{4}{3}-\\frac{3}{4}=-\\frac{25}{12}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-45875/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632"] :knowledge-point/questions ["q-45875"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85646/selection/7862ed346ca7e93d338181a5a95d9af4a71e8a814fcf058487610a04c6556a32" :answer/id #uuid "79ae95b9-7c72-5cfd-9222-3fa1ec2dc50d" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =\\frac{4\\sqrt{2}}{9}" :db/ensure [:answer/validate]} {:db/id "q-85646/selection/537bbabff11c7359b0b7dd29e01bcbb651bb54d99daa52478e8b4afdb229ec20" :answer/id #uuid "ac623ac3-6967-57be-b8b5-a6d40ac9899d" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =-\\frac{2\\sqrt{2}}{7}" :db/ensure [:answer/validate]} {:db/id "q-85646/selection/16c020bd44e55eabf6b1c2d3814d01cb153ceffb6053d1672f92086c4929854d" :answer/id #uuid "b36ccd70-8f5e-52fa-98e3-7c33cf234fdd" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =-\\frac{5\\sqrt{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-85646/selection/e922f40006e28ce0244237781df18440af1d2e507902a710e9a0cba14f29a4af" :answer/id #uuid "cb348247-2f45-5e6e-891f-94d7f4605b20" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =-\\frac{9\\sqrt{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-85646/selection/0ca9757886ba4ea74b636515e983de8cd538c79725317c087eb215da92fb18b6" :answer/id #uuid "d4e0c03b-cd67-5be0-930f-38b8eba48b95" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =\\frac{9\\sqrt{2}}{7}" :db/ensure [:answer/validate]} {:db/id "q-85646/selection" :answer-field/id #uuid "7842503d-cd31-55da-baad-eb8ec6a7f421" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85646/selection/e922f40006e28ce0244237781df18440af1d2e507902a710e9a0cba14f29a4af" :answer-field/choices ["q-85646/selection/7862ed346ca7e93d338181a5a95d9af4a71e8a814fcf058487610a04c6556a32" "q-85646/selection/537bbabff11c7359b0b7dd29e01bcbb651bb54d99daa52478e8b4afdb229ec20" "q-85646/selection/16c020bd44e55eabf6b1c2d3814d01cb153ceffb6053d1672f92086c4929854d" "q-85646/selection/e922f40006e28ce0244237781df18440af1d2e507902a710e9a0cba14f29a4af" "q-85646/selection/0ca9757886ba4ea74b636515e983de8cd538c79725317c087eb215da92fb18b6"] :db/ensure [:answer-field/validate]} {:db/id "q-85646" :question/id #uuid "7610e488-9f30-5416-a6f7-4b910f43ed02" :question/math-academy-id "q-85646" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/dcbdf7c41968a054b4fd2f3e761685d6ea9a5bf1677ec1c15db25464f1d1039d.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $-\\frac{7}{9},$ use the Pythagorean identity to find $\\operatorname{csc}⁡\\theta .$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/38a739ca964d1e9cf343914ed0a66f58363ceb7acfe7c194daf2765c0b4bf4d5.png)\n\nWe're given that $x=-\\frac{7}{9}$ at the point $P.$ Therefore, $\\operatorname{cos}⁡\\theta =-\\frac{7}{9}.$\n\nWe can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =-\\frac{7}{9}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{7}{9})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{49}{81}} \\\\  & =\\pm \\sqrt{\\frac{32}{81}} \\\\  & =\\pm \\frac{4\\sqrt{2}}{9}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $\\operatorname{sin}⁡\\theta $ is negative in the third quadrant. So $\\operatorname{sin}⁡\\theta =-\\frac{4\\sqrt{2}}{9}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(-\\frac{4\\sqrt{2}}{9})}=-\\frac{9}{4\\sqrt{2}}=-\\frac{9\\sqrt{2}}{8}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85646/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55a09362-632a-56c4-b246-903e18fc77ee"] :knowledge-point/questions ["q-85646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124965/selection/60d28bed61ae6695624d238da088900b8d4ae260befe261df64a5e91aa9a8387" :answer/id #uuid "1a82083f-f98e-5cce-b156-d399c04e9fcc" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{3\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124965/selection/e1ab00430afdedcc542ef7bf4b51b2064f5be182231264dcf8815f6682f78f43" :answer/id #uuid "a7a74f5a-ee55-52a6-bd3f-898bcefda788" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-124965/selection/e926c5dbf91d9f12cd60267404b97bdbc993a78b9df32da5cee64cc73c3924f3" :answer/id #uuid "8f8c142b-7970-5a39-a6ca-538985700414" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta =-\\frac{\\sqrt{15}}{15}" :db/ensure [:answer/validate]} {:db/id "q-124965/selection/5041c1a4df20bcdff4b043566e4229c110f95149478da4b03ce99f25f132f049" :answer/id #uuid "8533b05d-9d83-5831-96d2-db44a0893160" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta =\\frac{\\sqrt{15}}{15}" :db/ensure [:answer/validate]} {:db/id "q-124965/selection/b42598c468db1478c8d69fa361e25d79f274b33f1484e1f91dbd5e3bae3cb473" :answer/id #uuid "97976dcc-cb37-5996-a487-12b0edec9650" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡\\theta =\\frac{3\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124965/selection" :answer-field/id #uuid "aad01743-5cc8-5c57-9ff7-92a224f1d59b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124965/selection/e926c5dbf91d9f12cd60267404b97bdbc993a78b9df32da5cee64cc73c3924f3" :answer-field/choices ["q-124965/selection/60d28bed61ae6695624d238da088900b8d4ae260befe261df64a5e91aa9a8387" "q-124965/selection/e1ab00430afdedcc542ef7bf4b51b2064f5be182231264dcf8815f6682f78f43" "q-124965/selection/e926c5dbf91d9f12cd60267404b97bdbc993a78b9df32da5cee64cc73c3924f3" "q-124965/selection/5041c1a4df20bcdff4b043566e4229c110f95149478da4b03ce99f25f132f049" "q-124965/selection/b42598c468db1478c8d69fa361e25d79f274b33f1484e1f91dbd5e3bae3cb473"] :db/ensure [:answer-field/validate]} {:db/id "q-124965" :question/id #uuid "6bb1887b-828c-58c3-9b10-3c0e7dc6d40b" :question/math-academy-id "q-124965" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/cd41c969aee2e7c04c9034106978d8522d6a715733098bfde87abbdb861da7a8.png)\n\nThe diagram above shows the unit circle. Given that $\\operatorname{sin}⁡\\theta =\\frac{1}{4},$ what is the value of $\\operatorname{tan}⁡\\theta ?$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/4942cec8983dd2bddddd0ba2f8f9332b1b82f3999a44adb138b905457d39c633.png)\n\nWe can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{1}{4}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{16}} \\\\  & =\\pm \\sqrt{\\frac{15}{16}} \\\\  & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{\\sqrt{15}}{4}.$\n\nFinally, knowing that $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{(\\frac{1}{4})}{(-\\frac{\\sqrt{15}}{4})}=-\\frac{1}{\\sqrt{15}}=-\\frac{\\sqrt{15}}{15}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124965/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632"] :knowledge-point/questions ["q-124965"] :db/ensure [:knowledge-point/validate]} {:db/id "q-125000/selection/19097d323412f72c46f89d5665e033f1d19a44348f1001e194000058f4ffc944" :answer/id #uuid "8bfd53c5-c758-5f5e-a88b-a8c1cdba0cfe" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =-\\frac{10\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-125000/selection/0a5d9c8517a60fe7719e85ee38b2056041baf13fd696f6642df1216f6712f544" :answer/id #uuid "d1452c68-9d3f-5dc9-a072-c115505e2575" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =\\frac{10\\sqrt{19}}{19}" :db/ensure [:answer/validate]} {:db/id "q-125000/selection/7827c6caa40bf1249528e474f22724d7b972034b87de5fd4422b2629c83db4c5" :answer/id #uuid "5722a1c9-33f5-5a48-b8d6-8c17151c3bb5" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =\\frac{10\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-125000/selection/54a048705ade40ec9927c84618bb8ce889a400c71e26e93a3d99a38010888b0d" :answer/id #uuid "7d1a24a2-a304-5887-bbb6-ee7912794c81" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =-\\frac{10\\sqrt{19}}{19}" :db/ensure [:answer/validate]} {:db/id "q-125000/selection/d69f05e8a5aa6c9e24dbfa4736b35176f9aae7fbad9b578a08679d368b1c2298" :answer/id #uuid "53e3e557-fc58-535c-9dfe-f69c3dcb716a" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡\\theta =10\\sqrt{14}" :db/ensure [:answer/validate]} {:db/id "q-125000/selection" :answer-field/id #uuid "dccaadd9-6ac4-5d88-aae6-d67d2afc2a35" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125000/selection/0a5d9c8517a60fe7719e85ee38b2056041baf13fd696f6642df1216f6712f544" :answer-field/choices ["q-125000/selection/19097d323412f72c46f89d5665e033f1d19a44348f1001e194000058f4ffc944" "q-125000/selection/0a5d9c8517a60fe7719e85ee38b2056041baf13fd696f6642df1216f6712f544" "q-125000/selection/7827c6caa40bf1249528e474f22724d7b972034b87de5fd4422b2629c83db4c5" "q-125000/selection/54a048705ade40ec9927c84618bb8ce889a400c71e26e93a3d99a38010888b0d" "q-125000/selection/d69f05e8a5aa6c9e24dbfa4736b35176f9aae7fbad9b578a08679d368b1c2298"] :db/ensure [:answer-field/validate]} {:db/id "q-125000" :question/id #uuid "4051fa04-8ea2-56f8-9836-0af07938d8b1" :question/math-academy-id "q-125000" :question/problem "If $\\operatorname{cos}⁡\\theta =-\\frac{9}{10}$ and ${90}^{∘}<\\theta <{180}^{∘}$ then what is the value of $\\operatorname{csc}⁡\\theta ?$" :question/worked-solution "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941628/assets/82ad5587912af9d07bf447281bba3eb714bfdfdf38fef529529956912b0a77ec.png)\n\nWe're given that $\\operatorname{cos}⁡\\theta =-\\frac{9}{10}.$ We can use the Pythagorean identity to find $\\operatorname{sin}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡\\theta =-\\frac{9}{10}$ gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{9}{10})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{81}{100}} \\\\  & =\\pm \\sqrt{\\frac{19}{100}} \\\\  & =\\pm \\frac{\\sqrt{19}}{10}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\operatorname{sin}⁡\\theta $ is positive in the second quadrant. So, $\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{19}}{10}.$\n\nFinally, knowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{\\sqrt{19}}{10})}=\\frac{10}{\\sqrt{19}}=\\frac{10\\sqrt{19}}{19}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-125000/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55a09362-632a-56c4-b246-903e18fc77ee"] :knowledge-point/questions ["q-125000"] :db/ensure [:knowledge-point/validate]}]
