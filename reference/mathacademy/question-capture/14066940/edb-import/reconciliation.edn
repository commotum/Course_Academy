/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114322" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi }{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"}] "sources" [{"question" "q-14449" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-14449" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 5x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=5x\\, & ⟹\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 5x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =5x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 5\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-5x\\operatorname{cos}⁡(x)+5\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-5x\\operatorname{cos}⁡(x)+5\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-14449" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/activity-metadata.json" "file_sha256" "855647c2d4e1d10eac8ddd4df7c642441bca1885c00a20f77a73e648c87a4e29"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5x\\operatorname{cos}⁡x+5\\operatorname{sin}⁡x+C"] ["math" "-5x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C"] ["math" "-x\\operatorname{cos}⁡x-\\operatorname{cos}⁡5x+C"] ["math" "5x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C"] ["math" "\\operatorname{cos}⁡5x+x\\operatorname{sin}⁡5x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5x\\operatorname{cos}⁡x+5\\operatorname{sin}⁡x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-49664" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-49664" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(x)\\,\\text{d}x & =x\\operatorname{sin}⁡(x){|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(x){|}_{0}^{\\pi /2}+\\operatorname{cos}⁡(x){|}_{0}^{\\pi /2} \\\\  & =[\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\operatorname{sin}⁡(0)]+[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)] \\\\  & =[\\frac{\\pi }{2}-0]+[0-1] \\\\  & =\\frac{\\pi }{2}-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-49664" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/activity-metadata.json" "file_sha256" "855647c2d4e1d10eac8ddd4df7c642441bca1885c00a20f77a73e648c87a4e29"} {"question" "q-49664" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-49664" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\pi -1"] ["math" "\\frac{\\pi -1}{2}"] ["math" "\\frac{\\pi }{2}-1"] ["math" "\\frac{\\pi }{4}-1"] ["math" "\\pi -1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-49664" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi }{2}-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114312" "field" nil "attribute" "question/problem" "value" "$\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114312" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x\\operatorname{cos}⁡(5x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(5x)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(5x)}{5}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(5x)\\,\\text{d}x & =x\\cdot (\\frac{\\operatorname{sin}⁡(5x)}{5})-\\int (\\frac{\\operatorname{sin}⁡(5x)}{5})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x & =\\frac{x\\operatorname{sin}⁡(5x)}{5}-\\frac{1}{5}\\int \\operatorname{sin}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114312" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/activity-metadata.json" "file_sha256" "855647c2d4e1d10eac8ddd4df7c642441bca1885c00a20f77a73e648c87a4e29"} {"question" "q-114312" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114312" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2\\operatorname{sin}⁡(5x)}{5}-\\frac{x\\operatorname{cos}⁡(5x)}{15}+C"] ["math" "\\frac{\\operatorname{sin}⁡(5x)}{25}+\\frac{x\\operatorname{cos}⁡(5x)}{5}+C"] ["math" "\\frac{x\\operatorname{sin}⁡(5x)}{15}+\\frac{\\operatorname{cos}⁡(5x)}{5}+C"] ["math" "\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C"] ["math" "\\frac{x\\operatorname{sin}⁡(5x)}{5}-\\frac{2\\operatorname{cos}⁡(5x)}{25}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114312" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114322" "field" nil "attribute" "question/problem" "value" "${\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(4x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114322" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(4x) & ⟹\\,v=-\\frac{1}{4}\\operatorname{cos}⁡(4x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡(4x)\\,\\text{d}x & =x\\cdot (-\\frac{1}{4}\\operatorname{cos}⁡(4x))-\\int (-\\frac{1}{4}\\operatorname{cos}⁡(4x))\\cdot 1\\,\\text{d}x \\\\  & =-\\frac{x\\operatorname{cos}⁡(4x)}{4}+\\frac{1}{4}\\int \\operatorname{cos}⁡(4x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(4x)\\,\\text{d}x & ={-\\frac{x\\operatorname{cos}⁡(4x)}{4}|}_{0}^{\\pi }+\\frac{1}{4}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={-\\frac{x\\operatorname{cos}⁡(4x)}{4}|}_{0}^{\\pi }+{\\frac{1}{16}\\operatorname{sin}⁡(4x)|}_{0}^{\\pi } \\\\  & =[-\\frac{\\pi \\operatorname{cos}⁡(4\\pi )}{4}+\\frac{0\\operatorname{cos}⁡(4\\cdot 0)}{4}] \\\\  & +\\frac{1}{16}[\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =(-\\frac{\\pi }{4}+0)+\\frac{1}{16}(0-0) \\\\  & =-\\frac{\\pi }{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114322" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/activity-metadata.json" "file_sha256" "855647c2d4e1d10eac8ddd4df7c642441bca1885c00a20f77a73e648c87a4e29"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{5\\pi }{4}"] ["math" "-\\frac{\\pi }{2}"] ["math" "-\\frac{\\pi }{4}"] ["math" "\\frac{3\\pi }{4}"] ["math" "\\frac{\\pi }{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi }{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114328" "field" nil "attribute" "question/problem" "value" "${\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(3x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114328" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =x\\cdot \\frac{\\operatorname{sin}⁡(3x)}{3}-\\int \\frac{\\operatorname{sin}⁡(3x)}{3}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}x\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\frac{x\\operatorname{sin}⁡(3x)}{3}|}_{0}^{\\pi /2}-{\\int }_{0}^{\\pi /2}\\frac{\\operatorname{sin}⁡(3x)}{3}\\,\\text{d}x \\\\  & ={\\frac{1}{3}x\\operatorname{sin}⁡(3x)|}_{0}^{\\pi /2}+\\frac{1}{9}\\operatorname{cos}⁡(3x){|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{3}[\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})-0\\operatorname{sin}⁡(0)] \\\\  & +\\frac{1}{9}[\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(0)] \\\\  & =\\frac{1}{3}(-\\frac{\\pi }{2}-0)+\\frac{1}{9}(0-1) \\\\  & =-\\frac{\\pi }{6}-\\frac{1}{9}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114328" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/activity-metadata.json" "file_sha256" "855647c2d4e1d10eac8ddd4df7c642441bca1885c00a20f77a73e648c87a4e29"} {"question" "q-114328" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114328" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{\\pi }{3}+\\frac{1}{9}"] ["math" "-\\frac{\\pi }{6}+\\frac{1}{3}"] ["math" "-\\frac{\\pi }{6}-\\frac{1}{9}"] ["math" "\\frac{\\pi }{3}-\\frac{1}{6}"] ["math" "\\frac{\\pi }{6}+\\frac{1}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"} {"question" "q-114328" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi }{6}-\\frac{1}{9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14066940/state.json" "file_sha256" "2b197955876c0ffd0e57064fa8dfe35574bee7c8bab7b1dfb013f03025dc0a80"}] "usage" {"q-114322" [] "q-49664" [] "q-114312" [] "q-14449" []} "basis" 2220 "retractions" [[17592186064793 :question/problem "Evaluate the integral $\\displaystyle \\int_{0}^{\\pi /2}x\\cos (x)dx$."] [17592186064793 :question/worked-solution "Integration by parts with $u=x$, $dv=\\cos x\\,dx$ gives the antiderivative $x\\sin x+\\cos x$. Therefore\n$$\\int_0^{\\pi/2}x\\cos x\\,dx\n=\\left[x\\sin x+\\cos x\\right]_0^{\\pi/2}\n=\\frac\\pi2-1.$$"]] "immutable_answers" [17592186063269 17592186063270 17592186063271 17592186063272 17592186063273 17592186296543 17592186296544 17592186296545 17592186296546 17592186296547 17592186296557 17592186296558 17592186296559 17592186296560 17592186296561 17592186298515 17592186298516 17592186298517 17592186298518 17592186298519] "immutable_fields" [[17592186063268 :answer-field/correct] [17592186063268 :answer-field/id] [17592186063268 :answer-field/key] [17592186063268 :answer-field/type] [17592186296542 :answer-field/correct] [17592186296542 :answer-field/id] [17592186296542 :answer-field/key] [17592186296542 :answer-field/type] [17592186296556 :answer-field/correct] [17592186296556 :answer-field/id] [17592186296556 :answer-field/key] [17592186296556 :answer-field/type] [17592186298514 :answer-field/correct] [17592186298514 :answer-field/id] [17592186298514 :answer-field/key] [17592186298514 :answer-field/type]] "no_history" []}
