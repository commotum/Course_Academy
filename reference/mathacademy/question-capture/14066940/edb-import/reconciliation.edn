5x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-5x\\operatorname{cos}⁡(x)+5\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-5x\\operatorname{cos}⁡(x)+5\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14449" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/edb-import/verification.json"} {"question" "q-14449" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-5x\\operatorname{cos}⁡x+5\\operatorname{sin}⁡x+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "5018c91201e1bff8d42af9bd410b499f0a7ab693d9aeb8d3c0c9f2d1dbc19bf6" "basis" 1264 "