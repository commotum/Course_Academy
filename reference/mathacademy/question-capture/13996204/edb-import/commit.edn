{:edb/committed true :edb/basis-t 1084 :edb/replayed false :edb/tx-hash "f8f513036d7d05b5db4bac9fe2be778e36e63242c2bc6a89c1e6490af515088c" :edb/db-before-t 1083 :edb/db-after-t 1084 :edb/tx-data [[13194139534396 50 #inst "2026-10-07T00:07:00.911Z" 13194139534396 true] [17592186175694 1100 "Evaluate $\\displaystyle  \\int_{0}^{\\pi/2} \\cos x \\,\\textrm{d} x.$" 13194139534396 true] [17592186175694 1100 "Evaluate $\\displaystyle \\int_{0}^{\\pi/2} \\cos x \\,\\textrm{d} x$." 13194139534396 false] [17592186175694 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{π/2}\\cos xdx &= \\left.\\sin x\\right|_{0}^{π/2} \\\\\n&= \\sin (\\frac{π}{2}) - \\sin (0) \\\\\n&= 1 - 0 \\\\\n&= 1\n\\end{aligned}\n$$" 13194139534396 false] [17592186175694 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /2} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$" 13194139534396 true] [17592186175713 1100 "Calculate $\\displaystyle \\int_{0}^5 e^x \\, \\textrm d x$." 13194139534396 false] [17592186175713 1100 "Calculate $\\displaystyle \\int_{0}^5 e^x \\, \\textrm d x.$" 13194139534396 true] [17592186175713 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{5}e^{x}dx &= \\left.e^{x}\\right|_{0}^{5} \\\\\n&= e^{5} - e^{0} \\\\\n&= e^{5} - 1\n\\end{aligned}\n$$" 13194139534396 false] [17592186175713 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}{e}^{x}\\,\\text{d}x & ={e}^{x}{|}_{0}^{5} \\\\  & ={e}^{5}-{e}^{0} \\\\  & ={e}^{5}-1.\\end{aligned}\n$$" 13194139534396 true] [17592186175833 1020 #edb/ref 17592186286152 13194139534396 true] [17592186175833 1020 #edb/ref 175