86286149 1000 #edb/ref 17592186286150 13194139534396 true] [17592186286149 1000 #edb/ref 17592186286151 13194139534396 true] [17592186286149 1040 #edb/ref 17592186045449 13194139534396 true] [17592186286149 1041 "field-1" 13194139534396 true] [17592186286149 1104 #edb/ref 17592186286150 13194139534396 true] [17592186286149 1110 #uuid "3c100b85-e6ea-59a7-a41f-a517b373a19e" 13194139534396 true] [17592186286150 1034 "e^3-1" 13194139534396 true] [17592186286150 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286150 1111 #uuid "657a81ee-9d39-5d98-9fff-5530d9590c3a" 13194139534396 true] [17592186286151 1034 "e^3" 13194139534396 true] [17592186286151 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286151 1111 #uuid "87cf134a-5327-5fc2-b721-c6413b0a4f49" 13194139534396 true] [17592186286152 1017 #edb/ref 17592186286153 13194139534396 true] [17592186286152 1089 "q-346084" 13194139534396 true] [17592186286152 1091 #edb/ref 17592186045465 13194139534396 true] [17592186286152 1100 "Evaluate ${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x=$\n{{field-1}}" 13194139534396 true] [17592186286152 1113 #uuid "b46708ce-c959-5c6b-b751-4f2a8096e20c" 13194139534396 true] [17592186286152 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x{|}_{0}^{\\pi /2} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})-(-\\operatorname{cos}⁡(0)) \\\\  & =0-(-1) \\\\  & =1.\\end{aligned}\n$$" 13194139534396 true] [17592186286153 1000 #edb/ref 17592186286154 13194139534396 true] [17592186286153 1040 #edb/ref 17592186045449 13194139534396 true] [17592186286153 1041 "field-1" 13194139534396 true] [17592186286153 1104 #edb/ref 17592186286154 13194139534396 true] [17592186286153 1110 #uuid "7e8fd80a-f8f5-557e-811e-c290045c4e25" 13194139534396 true] [17592186286154 1034 "1" 13194139534396 true] [17592186286154 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286154 1111 #uuid "d2087e14-ec1c-5ab7-b1cd-6e15334d9b90" 13194139534396 true] [17592186286155 1017 #edb/ref 17592186286156 13194139534396 true] [17592186286155 1089 "q-346090" 13194139534396 true] [17592186286155 1091 #edb/ref 17592186045464 13194139534396 true] [17592186286155 1100 "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" 13194139534396 true] [17592186286155 1113 #uuid "9d77fdfc-1a74-562f-8f4b-f50cea04941a" 13194139534396 true] [17592186286155 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =cot\\,(\\frac{\\pi }{3})-cot\\,(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}-\\sqrt{3} \\\\  & =\\frac{1-3}{\\sqrt{3}} \\\\  & =-\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" 13194139534396 true] [17592186286156 1000 #edb/ref 17592186286157 13194139534396 true] [17592186286156 1000 #edb/ref 17592186286158 13194139534396 true] [17592186286156 1040 #edb/ref 17592186045449 13194139534396 true] [17592186286156 1041 "field-1" 13194139534396 true] [17592186286156 1104 #edb/ref 17592186286157 13194139534396 true] [17592186286156 1110 #uuid "7f514196-4daa-58a4-b95e-292d0d606ed9" 13194139534396 true] [17592186286157 1034 "-\\frac{2}{3}\\sqrt{3}" 13194139534396 true] [17592186286157 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286157 1111 #uuid "d6632a12-4a28-5c4b-9134-4528994505b9" 13194139534396 true] [17592186286158 1034 "0" 13194139534396 true] [17592186286158 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286158 1111 #uuid "fd23cc81-60ae-5e1c-8aa4-58a1b946f7c6" 13194139534396 true] [17592186286159 1017 #edb/ref 17592186286160 13194139534396 true] [17592186286159 1089 "q-346092" 13194139534396 true] [17592186286159 1091 #edb/ref 17592186045464 13194139534396 true] [17592186286159 1100 "Evaluate ${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x=$\n{{field-1}}" 13194139534396 true] [17592186286159 1113 #uuid "256af955-957d-5836-9cba-3960b5fe42ec" 13194139534396 true] [17592186286159 1145 "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x & =-\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =-\\operatorname{sec}⁡(\\frac{\\pi }{4})-(-\\operatorname{sec}⁡(0)) \\\\  & =-\\sqrt{2}+1 \\\\  & =1-\\sqrt{2}.\\end{aligned}\\end{aligned}\n$$" 13194139534396 true] [17592186286160 1000 #edb/ref 17592186286161 13194139534396 true] [17592186286160 1040 #edb/ref 17592186045449 13194139534396 true] [17592186286160 1041 "field-1" 13194139534396 true] [17592186286160 1104 #edb/ref 17592186286161 13194139534396 true] [17592186286160 1110 #uuid "d69b1bb3-fe19-59ca-b9b7-715a1e4ca224" 13194139534396 true] [17592186286161 1034 "1-\\sqrt{2}" 13194139534396 true] [17592186286161 1103 #edb/ref 17592186045453 13194139534396 true] [17592186286161 1111 #uuid "2aa4eb17-a9f1-5cc6-8bf1-43cf48436f48" 13194139534396 true] [17592186286162 1017 #edb/ref 17592186286163 13194139534396 true] [17592186286162 1089 "q-346094" 13194139534396 true] [17592186286162 1091 #edb/ref 17592186045464 13194139534396 true] [17592186286162 1100 "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x=$\n{{field-1}}" 13194139534396 true] [17592186286162 1113 #uuid "80cd47d3-4d96-5b03-a0be-30ceefb893f8" 13194139534396 true] [17592186286