#{[{:db/id #edb/ref 17592186175694 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/id #uuid "ca4299f0-421b-540b-a4f0-fda24dd97bd9" :question/math-academy-id "e-412" :question/problem "Evaluate $\\displaystyle  \\int_{0}^{\\pi/2} \\cos x \\,\\textrm{d} x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /2} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186175713 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/id #uuid "ef9e4398-487e-5b64-9a6d-a54445511965" :question/math-academy-id "e-6168" :question/problem "Calculate $\\displaystyle \\int_{0}^5 e^x \\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}{e}^{x}\\,\\text{d}x & ={e}^{x}{|}_{0}^{5} \\\\  & ={e}^{5}-{e}^{0} \\\\  & ={e}^{5}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286137 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf14ea5-6681-5f1a-860f-3a6f62b78f76" :answer/type {:db/ident :answer.type/math} :answer/value "99\\operatorname{ln}⁡10" :db/id #edb/ref 17592186286139} {:answer/id #uuid "929ecb44-6154-5954-b599-f878ec62be4a" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186286140} {:answer/id #uuid "a5d9e724-6068-5714-bee8-bdd17773dc72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186286141} {:answer/id #uuid "a56c5302-9b86-5f27-8404-5ecba9411a5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{99}{\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186286142} {:answer/id #uuid "75bc528e-2ffb-5118-a99e-08ae0876a7b2" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186286143}] :answer-field/correct {:answer/id #uuid "a56c5302-9b86-5f27-8404-5ecba9411a5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{99}{\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186286142} :answer-field/id #uuid "5d55e9b8-4a5b-59c9-8411-bc870dc55778" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286138}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fc0a675-6db0-593f-9200-fb75ce5e0dff" :question/math-academy-id "q-103652" :question/problem "Calculate ${\\int }_{0}^{2}{10}^{x}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{10}^{x}\\,\\text{d}x & =\\frac{{10}^{x}}{\\operatorname{ln}⁡10}{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}\\cdot {10}^{x}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}({10}^{2}-{10}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}(100-1) \\\\  & =\\frac{99}{\\operatorname{ln}⁡10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286144 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c12f4a92-933c-5e51-8eab-f9732c9349de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{56}{\\ln(8)}" :db/id #edb/ref 17592186286146} {:answer/id #uuid "da6cd305-02dc-598b-a83e-cd7a7e630ced" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186286147}] :answer-field/correct {:answer/id #uuid "c12f4a92-933c-5e51-8eab-f9732c9349de" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{56}{\\ln(8)}" :db/id #edb/ref 17592186286146} :answer-field/id #uuid "59d96c83-bfc9-52cc-b488-49894a70fa09" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286145}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "868a70a6-f950-51f8-810f-ab1e479eda6f" :question/math-academy-id "q-346074" :question/problem "Evaluate ${\\int }_{1}^{2}{8}^{x}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{2}{8}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{8}^{x}\\,\\text{d}x & =\\frac{{8}^{x}}{\\operatorname{ln}⁡8}{|}_{1}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}\\cdot {8}^{x}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}({8}^{2}-{8}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}(64-8) \\\\  & =\\frac{56}{\\operatorname{ln}⁡8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286148 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "657a81ee-9d39-5d98-9fff-5530d9590c3a" :answer/type {:db/ident :answer.type/math} :answer/value "e^3-1" :db/id #edb/ref 17592186286150} {:answer/id #uuid "87cf134a-5327-5fc2-b721-c6413b0a4f49" :answer/type {:db/ident :answer.type/math} :answer/value "e^3" :db/id #edb/ref 17592186286151}] :answer-field/correct {:answer/id #uuid "657a81ee-9d39-5d98-9fff-5530d9590c3a" :answer/type {:db/ident :answer.type/math} :answer/value "e^3-1" :db/id #edb/ref 17592186286150} :answer-field/id #uuid "3c100b85-e6ea-59a7-a41f-a517b373a19e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286149}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ac6fd62a-e9de-5c5a-b78b-6294c8f2a19d" :question/math-academy-id "q-346078" :question/problem "Evaluate ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={e}^{x}\\,{|}_{0}^{3} \\\\  & ={e}^{3}-{e}^{0} \\\\  & ={e}^{3}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286152 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2087e14-ec1c-5ab7-b1cd-6e15334d9b90" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286154}] :answer-field/correct {:answer/id #uuid "d2087e14-ec1c-5ab7-b1cd-6e15334d9b90" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286154} :answer-field/id #uuid "7e8fd80a-f8f5-557e-811e-c290045c4e25" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286153}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b46708ce-c959-5c6b-b751-4f2a8096e20c" :question/math-academy-id "q-346084" :question/problem "Evaluate ${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x{|}_{0}^{\\pi /2} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})-(-\\operatorname{cos}⁡(0)) \\\\  & =0-(-1) \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286155 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6632a12-4a28-5c4b-9134-4528994505b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\sqrt{3}" :db/id #edb/ref 17592186286157} {:answer/id #uuid "fd23cc81-60ae-5e1c-8aa4-58a1b946f7c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286158}] :answer-field/correct {:answer/id #uuid "d6632a12-4a28-5c4b-9134-4528994505b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\sqrt{3}" :db/id #edb/ref 17592186286157} :answer-field/id #uuid "7f514196-4daa-58a4-b95e-292d0d606ed9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286156}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9d77fdfc-1a74-562f-8f4b-f50cea04941a" :question/math-academy-id "q-346090" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =cot\\,(\\frac{\\pi }{3})-cot\\,(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}-\\sqrt{3} \\\\  & =\\frac{1-3}{\\sqrt{3}} \\\\  & =-\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286159 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aa4eb17-a9f1-5cc6-8bf1-43cf48436f48" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186286161}] :answer-field/correct {:answer/id #uuid "2aa4eb17-a9f1-5cc6-8bf1-43cf48436f48" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186286161} :answer-field/id #uuid "d69b1bb3-fe19-59ca-b9b7-715a1e4ca224" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286160}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "256af955-957d-5836-9cba-3960b5fe42ec" :question/math-academy-id "q-346092" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x & =-\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =-\\operatorname{sec}⁡(\\frac{\\pi }{4})-(-\\operatorname{sec}⁡(0)) \\\\  & =-\\sqrt{2}+1 \\\\  & =1-\\sqrt{2}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286162 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8449eeb3-d950-556e-b5d0-a8103def25dd" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186286164}] :answer-field/correct {:answer/id #uuid "8449eeb3-d950-556e-b5d0-a8103def25dd" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186286164} :answer-field/id #uuid "a66e7d57-d06e-505b-a0c6-3a35025a0afe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286163}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "80cd47d3-4d96-5b03-a0be-30ceefb893f8" :question/math-academy-id "q-346094" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =-\\operatorname{csc}⁡(\\frac{\\pi }{3})-(-\\operatorname{csc}⁡(\\frac{\\pi }{6})) \\\\  & =-\\frac{2}{\\sqrt{3}}-(-2) \\\\  & =2-\\frac{2}{\\sqrt{3}} \\\\  & =\\frac{2\\sqrt{3}-2}{\\sqrt{3}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176484 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3965833-c7ff-5318-a7ed-5d3e705179d0" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2} - 1" :db/id #edb/ref 17592186175447} {:answer/id #uuid "ec25e02b-ab7e-5915-89af-72000b1