swer/id #uuid "c7700aca-d3f0-5ca3-b458-3fa437e3f7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3-\\sqrt{3}}{3}" :db/id #edb/ref 17592186286176} {:answer/id #uuid "fcb519ef-8f6c-5305-8316-a95c3c5c58c2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186286177} {:answer/id #uuid "e13c9cf7-4596-56a0-85e9-c1ac60284cfd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+1}{3}" :db/id #edb/ref 17592186286178}] :answer-field/correct {:answer/id #uuid "fcb519ef-8f6c-5305-8316-a95c3c5c58c2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186286177} :answer-field/id #uuid "fe3adc71-a26f-5c0c-9a84-5213e2fa9316" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286173}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "84dc21c9-0637-5723-a2da-12984662a83d" :question/math-academy-id "q-73289" :question/problem "${\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /3}^{3\\pi /4} \\\\  & =\\operatorname{cot}⁡(\\frac{3\\pi }{4})-\\operatorname{cot}⁡(\\frac{\\pi }{3}) \\\\  & =-1-\\frac{\\sqrt{3}}{3} \\\\  & =-\\frac{\\sqrt{3}+3}{3}.\\end{aligned}\\end{aligned}\n$$"}]}
