\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-346090/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fd23cc81-60ae-5e1c-8aa4-58a1b946f7c6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-346090/field-1" :answer-field/id #uuid "7f514196-4daa-58a4-b95e-292d0d606ed9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346090/field-1/489ce34d175ecdf37422f247c45b1444c35f5d9e0a90e286a6d80410e64560c2" :answer-field/choices ["q-346090/field-1/489ce34d175ecdf37422f247c45b1444c35f5d9e0a90e286a6d80410e64560c2" "q-346090/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-346090" :question/id #uuid "9d77fdfc-1a74-562f-8f4b-f50cea04941a" :question/math-academy-id "q-346090" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =cot\\,(\\frac{\\pi }{3})-cot\\,(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{\\sqrt{3}}-\\sqrt{3} \\\\  & =\\frac{1-3}{\\sqrt{3}} \\\\  & =-\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346090/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-346090"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346084/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "d2087e14-ec1c-5ab7-b1cd-6e15334d9b90" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-346084/field-1" :answer-field/id #uuid "7e8fd80a-f8f5-557e-811e-c290045c4e25" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346084/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-346084/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-346084" :question/id #uuid "b46708ce-c959-5c6b-b751-4f2a8096e20c" :question/math-academy-id "q-346084" :question/problem "Evaluate ${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x{|}_{0}^{\\pi /2} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})-(-\\operatorname{cos}⁡(0)) \\\\  & =0-(-1) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346084/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-346084"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73289/selection/433780c6377251d2258165ab6de6cef2fa9717049be2e997c0ec46cfe1f0f3ad" :answer/id #uuid "8336a026-3e2b-5dbb-8bd7-95a222a56e45" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}+3}{3}" :db/ensure [:answer/validate]} {:db/id "q-73289/selection/472fd97ba9b29c125cf17c29f2f26fb5cff4c9c9509a5977e9b3526cee6fb978" :answer/id #uuid "c7700aca-d3f0-5ca3-b458-3fa437e3f7ff" :answer/type :answer.type/math :answer/value "\\frac{3-\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-73289/selection/fd854feb8b097979dc0733c7850d8566445c917d794b9ee684d33e01a63c8023" :answer/id #uuid "e13c9cf7-4596-56a0-85e9-c1ac60284cfd" :answer