nd evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{10}^{x}\\,\\text{d}x & =\\frac{{10}^{x}}{\\operatorname{ln}⁡10}{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}\\cdot {10}^{x}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}({10}^{2}-{10}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}(100-1) \\\\  & =\\frac{99}{\\operatorname{ln}⁡10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103652/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff"] :knowledge-point/questions ["q-103652"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346074/field-1/37645a7f87955223b990bed48810207514a641eada16460aa24f42f430f37958" :answer/id #uuid "c12f4a92-933c-5e51-8eab-f9732c9349de" :answer/type :answer.type/math :answer/value "\\frac{56}{\\ln(8)}" :db/ensure [:answer/validate]} {:db/id "q-346074/field-1/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "da6cd305-02dc-598b-a83e-cd7a7e630ced" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-346074/field-1" :answer-field/id #uuid "59d96c83-bfc9-52cc-b488-49894a70fa09" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346074/field-1/37645a7f87955223b990bed48810207514a641eada16460aa24f42f430f37958" :answer-field/choices ["q-346074/field-1/37645a7f87955223b990bed48810207514a641eada16460aa24f42f430f37958" "q-346074/field-1/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784"] :db/ensure [:answer-field/validate]} {:db/id "q-346074" :question/id #uuid "868a70a6-f950-51f8-810f-ab1e479eda6f" :question/math-academy-id "q-346074" :question/problem "Evaluate ${\\int }_{1}^{2}{8}^{x}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{1}^{2}{8}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{8}^{x}\\,\\text{d}x & =\\frac{{8}^{x}}{\\operatorname{ln}⁡8}{|}_{1}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}\\cdot {8}^{x}\\,{|}_{1}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}({8}^{2}-{8}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡8}(64-8) \\\\  & =\\frac{56}{\\operatorname{ln}⁡8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346074/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff"] :knowledge-point/questions ["q-346074"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73272/selection/e29befcf9c3ff35d805bdcf6f352e0d15a580c0b541d61a1c8a4a4e73994b488" :answer/id #uuid "a1edd770-6391-54ae-bc31-f3ee19431169" :answer/type :answer.type/math :answer/value "1-{e}^{3}" :db/ensure [:answer/validate]} {:db/id "q-73272/selection/773eb9d5e90367c45f27275c2b071e0a85bd9fdceb5240aa8f081daad76aa919" :answer/id #uuid "e2d59bc2-0f2c-5a2b-804e-5bb6e8297905" :answer/type :answer.type/math :answer/value "e-\\frac{1}{{e}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-73272/selection/49b74173a2c706f4a987dd99785fde28416e891ce57df4a04b63a81af876bc37" :answer/id #uuid "aec4824f-9833-56a4-abf5-ced2653c580c" :answer/type :answer.type/math :answer/value "1-\\frac{1}{{e}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-73272/selection/754371094e79d2fceb1a6a6cb54284cb10f16c7b915a097ba0ccf2e87c5662ac" :answer/id #uuid "c2ff5b80-4f17-5ca6-acaa-af19189c34d3" :answer/type :answer.type/math :answer/value "e-{e}^{3}" :db/ensure [:answer/validate]} {:db/id "q-73272/selection/a560e07844eeac857b47d6713e4ccc2c918b0572ab31b51fc5e46921b8f7d5ab" :answer/id #uuid "e02a97c5-f495-5ef2-9e5b-ebea232bd85c" :answer/type :answer.type/math :answer/value "{e}^{3}-1" :db/ensure [:answer/validate]} {:db/id "q-73272/selection" :answer-field/id #uuid "90ee4898-1a42-52cb-a750-fe113481baec" :answer-field/key "selection" :answ