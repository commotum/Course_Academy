ficulty :question.difficulty/hard :question/answer-fields ["q-73289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-73289"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346094/field-1/33173f39d9a49dd642946f8e7cf48126f3f2a74b3d1acc5ea2358d3f499c372c" :answer/id #uuid "8449eeb3-d950-556e-b5d0-a8103def25dd" :answer/type :answer.type/math :answer/value "2-\\frac{2}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "q-346094/field-1" :answer-field/id #uuid "a66e7d57-d06e-505b-a0c6-3a35025a0afe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346094/field-1/33173f39d9a49dd642946f8e7cf48126f3f2a74b3d1acc5ea2358d3f499c372c" :answer-field/choices ["q-346094/field-1/33173f39d9a49dd642946f8e7cf48126f3f2a74b3d1acc5ea2358d3f499c372c"] :db/ensure [:answer-field/validate]} {:db/id "q-346094" :question/id #uuid "80cd47d3-4d96-5b03-a0be-30ceefb893f8" :question/math-academy-id "q-346094" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =-\\operatorname{csc}⁡(\\frac{\\pi }{3})-(-\\operatorname{csc}⁡(\\frac{\\pi }{6})) \\\\  & =-\\frac{2}{\\sqrt{3}}-(-2) \\\\  & =2-\\frac{2}{\\sqrt{3}} \\\\  & =\\frac{2\\sqrt{3}-2}{\\sqrt{3}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346094/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-346094"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346092/field-1/e922075c91d70e81f0c78d62c5fef058ca5dcf1e5e2dc6a82fb5d610516012b2" :answer/id #uuid "2aa4eb17-a9f1-5cc6-8bf1-43cf48436f48" :answer/type :answer.type/math :answer/value "1-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-346092/field-1" :answer-field/id #uuid "d69b1bb3-fe19-59ca-b9b7-715a1e4ca224" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346092/field-1/e922075c91d70e81f0c78d62c5fef058ca5dcf1e5e2dc6a82fb5d610516012b2" :answer-field/choices ["q-346092/field-1/e922075c91d70e81f0c78d62c5fef058ca5dcf1e5e2dc6a82fb5d610516012b2"] :db/ensure [:answer-field/validate]} {:db/id "q-346092" :question/id #uuid "256af955-957d-5836-9cba-3960b5fe42ec" :question/math-academy-id "q-346092" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x & =-\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =-\\operatorname{sec}⁡(\\frac{\\pi }{4})-(-\\operatorname{sec}⁡(0)) \\\\  & =-\\sqrt{2}+1 \\\\  & =1-\\sqrt{2}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-346092/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-346092"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6168"] :question/problem "Calculate $\\displaystyle \\int_{0}^5 e^x \\, \\textrm d x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{5}{e}^{x}\\,\\text{d}x & ={e}^{x}{|}_{0}^{5} \\\\  & ={e}^{5}-{e}^{0} \\\\  & ={e}^{5}-1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-412"] :question/problem "Evaluate $\\displaystyle  \\int_{0}^{\\pi/2} \\cos x \\,\\textrm{d} x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi /2} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0) \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
