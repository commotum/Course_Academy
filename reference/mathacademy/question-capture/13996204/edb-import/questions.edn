#{[{:db/id #edb/ref 17592186175694 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/id #uuid "ca4299f0-421b-540b-a4f0-fda24dd97bd9" :question/math-academy-id "e-412" :question/problem "Evaluate $\\displaystyle \\int_{0}^{\\pi/2} \\cos x \\,\\textrm{d} x$." :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{π/2}\\cos xdx &= \\left.\\sin x\\right|_{0}^{π/2} \\\\\n&= \\sin (\\frac{π}{2}) - \\sin (0) \\\\\n&= 1 - 0 \\\\\n&= 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186175713 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/id #uuid "ef9e4398-487e-5b64-9a6d-a54445511965" :question/math-academy-id "e-6168" :question/problem "Calculate $\\displaystyle \\int_{0}^5 e^x \\, \\textrm d x$." :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\n\\int_{0}^{5}e^{x}dx &= \\left.e^{x}\\right|_{0}^{5} \\\\\n&= e^{5} - e^{0} \\\\\n&= e^{5} - 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176484 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3965833-c7ff-5318-a7ed-5d3e705179d0" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2} - 1" :db/id #edb/ref 17592186175447} {:answer/id #uuid "ec25e02b-ab7e-5915-89af-72000b1166ca" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2}" :db/id #edb/ref 17592186175448} {:answer/id #uuid "5636181d-b9c5-54fc-be2e-f7915aa0cfa3" :answer/type {:db/ident :answer