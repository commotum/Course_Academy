#{[{:db/id #edb/ref 17592186114865 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions"}] :question/id #uuid "5adf056c-d122-54e6-b55f-5e85d39750c4" :question/math-academy-id "e-207" :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\textrm {arccot} x$." :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot} x) = -\\dfrac 1 {1+x^2}\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(2arccotx) \\\\\n&= 2 \\cdot \\frac{d}{dx}(arccotx) \\\\\n&= 2 \\cdot (-\\frac{1}{1 + x^{2}}) \\\\\n&=-\\frac{2}{1 + x^{2}}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114869 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}] :question/id #uuid "99db3f5c-5d6f-5e8e-a31c-a627ddd5c6dc" :question/math-academy-id "e-208" :question/problem "If $f(x) = \\dfrac{\\textrm{arcsec} x}{\\textrm{arccsc} x}$, calculate $f'(x)$." :question/worked-solution "Here, we let\n\n$$\nu(x) = \\textrm{arcsec} x\n$$\n\nand\n\n$$\nv(x) = \\textrm{arccsc} x\n$$\n\n, and apply the quotient rule.\n\nWe use the formulae\n\n$$\nu'(x) = \\dfrac 1 {\\begin{vmatrix}x & \\sqrt {x^2 - 1}} \\quad \\text{and} \\quad v'(x) = -\\dfrac 1 {\\mid x\\end{vmatrix} \\sqrt {x^2 - 1}}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nf^{′}(x) &= (u^{′}(x) \\cdot v(x) - u(x) \\cdot v^{′}(x))/([v(x)]^{2}) \\\\\n&= (\\frac{1}{\\begin{vmatrix}x & \\sqrt{x^{2} - 1}} \\cdot arccscx - arcsecx \\cdot (-\\frac{1}{\\mid x\\end{vmatrix}\\sqrt{x^{2} - 1}}))/(arccsc^{2}x) \\\\\n&= (\\frac{1}{\\mid x\\begin{vmatrix}\\sqrt{x^{2} - 1}})\\frac{arccscx + arcsecx}{arccsc^{2}x} \\\\ = \\frac{arccscx + arcsecx}{\\mid x\\end{vmatrix}\\sqrt{x^{2} - 1}arccsc^{2}x}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114872 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Product Rule"}] :question/id #uuid "fd6239d1-4fec-50b9-8018-f6e185c4e0d0" :question/math-academy-id "e-209" :question/problem "If $f(x) =3 x\\, \\textrm {arccsc}x$, calculate $f'(x)$." :question/worked-solution "The formula for the derivative of $\\textrm{arccsc}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccsc} x) = -\\dfrac 1 {\\mid x \\mid \\sqrt {x^2 - 1}} \\,\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(3xarccscx) \\\\\n&= 3\\frac{d}{dx}(xarccscx) \\\\\n&= 3(x \\cdot \\frac{d}{dx}(arccscx) + arccscx \\cdot \\frac{d}{dx}(x)) \\\\\n&= 3x(-\\frac{1}{\\mid x\\begin{vmatrix}\\sqrt{x^{2} - 1}}) + 3arccscx \\cdot 1 \\\\ =-\\frac{3x}{\\mid x\\end{vmatrix}\\sqrt{x^{2} - 1}} + 3arccscx\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186114874 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Chain Rule"}] :question/id #uuid "38c9e8d8-871f-54b1-a8df-637f54430cc1" :question/math-academy-id "e-210" :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\textrm {arccot} (x^2 + 5)$." :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot} x) = -\\dfrac 1 {1+x^2}\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(2arccot(x^{2} + 5)) \\\\\n&= 2 \\cdot (- (1)/(1 + (x^{2} + 5)^{2})) \\cdot \\frac{d}{dx}(x^{2} + 5) \\\\\n&= - (2)/(1 + (x^{2} + 5)^{2}) \\cdot 2x \\\\\n&= - (4x)/(1 + (x^{2} + 5)^{2}) \\\\\n&=-\\frac{4x}{x^{4} + 10x^{2} + 26}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115658 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81fb3181-a375-50f9-b135-f88ec9ed023d" :answer/type {:db/ident :answer.type/math} :answer/value "- (12x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113349} {:answer/id #uuid "8e1c5933-a0f2-5eb9-8d7e-e39f572f7e32" :answer/type {:db/ident :answer.type/math} :answer/value "(6x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113350} {:answer/id #uuid "9662b8a9-ed16-56fb-9248-bff8e449793f" :answer/type {:db/ident :answer.type/math} :answer/value "(8x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113351} {:answer/id #uuid "a27bd45b-dc88-5851-8b6a-8514851cc390" :answer/type {:db/ident :answer.type/math} :answer/value "(12x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113352} {:answer/id #uuid "fb75b4b0-097a-5b28-a7a5-c0d805348b6b" :answer/type {:db/ident :answer.type/math} :answer/value "- (4x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113353}] :answer-field/correct {:answer/id #uuid "9662b8a9-ed16-56fb-9248-bff8e449793f" :answer/type {:db/ident :answer.type/math} :answer/value "(8x^{3})/(\\mid 8 - x^{4} \\mid \\sqrt{(8 - x^{4})^{2} - 1})" :db/id #edb/ref 17592186113351} :answer-field/id #uuid "24425df8-75e4-5fb6-a1e7-c2922dde3148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113348}] :question/id #uuid "c5f8a50f-d033-5259-86d9-bade982764d7" :question/math-academy-id "q-32000" :question/problem "Calculate $f^{′}(x)$ for $f(x) = 2\\arccsc(8 - x^{4})$."}]}
