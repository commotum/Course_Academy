[{:db/id "q-73437/selection/460beee0f047b8f72b36b6ab37da2f21d194e5a7290b96633325e4b889c20d4b" :answer/id #uuid "564d4e18-cf74-5b1e-9286-64abccaf7bc5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x}}-\\frac{1}{2|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-73437/selection/272b4d254b296016f186b1df28684bbee00cac029f85b99f48f769af8dd496b3" :answer/id #uuid "16f8d824-57e5-5c85-80d6-a5de96566cea" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-73437/selection/0d25d77b5b2896e22135552f537d9d194c102270887b64ecf89e0e3eed6a2852" :answer/id #uuid "3e28fe70-e4e9-5da1-9e9f-d66ecb488025" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{2}{x\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-73437/selection/c8b0677a57e670094f75ffac671536250c38a4f772c2941529ce6b944437ae41" :answer/id #uuid "b302d456-9f7b-5932-878c-7a4fbc440f87" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-73437/selection/50f25ca024df165dd55adf1ac4a02562806f9754f3a6573898f5c7ba5aaf0c8f" :answer/id #uuid "d08ec880-179a-5de9-abb6-5f8e3ead7642" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{1}{2x\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-73437/selection" :answer-field/id #uuid "03712dd9-5a48-5a76-9fae-c5a0f6b64b84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73437/selection/c8b0677a57e670094f75ffac671536250c38a4f772c2941529ce6b944437ae41" :answer-field/choices ["q-73437/selection/460beee0f047b8f72b36b6ab37da2f21d194e5a7290b96633325e4b889c20d4b" "q-73437/selection/272b4d254b296016f186b1df28684bbee00cac029f85b99f48f769af8dd496b3" "q-73437/selection/0d25d77b5b2896e22135552f537d9d194c102270887b64ecf89e0e3eed6a2852" "q-73437/selection/c8b0677a57e670094f75ffac671536250c38a4f772c2941529ce6b944437ae41" "q-73437/selection/50f25ca024df165dd55adf1ac4a02562806f9754f3a6573898f5c7ba5aaf0c8f"] :db/ensure [:answer-field/validate]} {:db/id "q-73437" :question/id #uuid "db5ccbbb-ec3b-5ab8-949d-761587ac2154" :question/math-academy-id "q-73437" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=\\sqrt{x}-2arccscx.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-2arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73437/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6"] :knowledge-point/questions ["q-73437"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341104/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a2a155fc-0343-563e-b60f-9fed602cadb6" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-341104/field-1" :answer-field/id #uuid "7fbed088-7d60-5ba1-a3f4-ecc19433c0ca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341104/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-341104/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-341104" :question/id #uuid "2839017f-d36a-5dd4-be44-dad05c9ac75a" :question/math-academy-id "q-341104" :question/problem "Find the slope $m$ of the tangent line to the curve $y=2x+arccotx$ at $x=0.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccot\\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x+arccotx) \\\\  & =2+(-\\frac{1}{1+{x}^{2}}) \\\\  & =2-\\frac{1}{1+{x}^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=0$ is\n\n$$\n\\begin{aligned}m={y}^{′}(0) & =2-\\frac{1}{1+{0}^{2}} \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341104/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6"] :knowledge-point/questions ["q-341104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-312358/field-1/ff96b72af866e264a0d561c60623918bed36f1f6bb5ef9d634ee4ec3c5225fa8" :answer/id #uuid "4c4cb26f-4faf-5f42-aede-c20ecd6b6285" :answer/type :answer.type/math :answer/value "\\frac{2x-1}{x^2+1}" :db/ensure [:answer/validate]} {:db/id "q-312358/field-1/038913371b777237bae4ca22d09774bc447784fd006fa2cd6d2dc956b722234f" :answer/id #uuid "2ae3fe3f-90e2-5d1f-b49d-f6e0f7f04581" :answer/type :answer.type/math :answer/value "\\frac{2x+1}{x^2+1}" :db/ensure [:answer/validate]} {:db/id "q-312358/field-1" :answer-field/id #uuid "1972dc8c-14ea-555b-9cf8-33d9302563e4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312358/field-1/ff96b72af866e264a0d561c60623918bed36f1f6bb5ef9d634ee4ec3c5225fa8" :answer-field/choices ["q-312358/field-1/ff96b72af866e264a0d561c60623918bed36f1f6bb5ef9d634ee4ec3c5225fa8" "q-312358/field-1/038913371b777237bae4ca22d09774bc447784fd006fa2cd6d2dc956b722234f"] :db/ensure [:answer-field/validate]} {:db/id "q-312358" :question/id #uuid "5464cff0-d612-51e8-ae1f-a287bd88ea84" :question/math-academy-id "q-312358" :question/problem "If $f(x)=\\text{arccot }x+\\operatorname{ln}⁡({x}^{2}+1),$ calculate ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $\\text{arccot}$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x+\\operatorname{ln}⁡({x}^{2}+1)) \\\\  & =-\\frac{1}{1+{x}^{2}}+\\frac{2x}{{x}^{2}+1} \\\\  & =\\frac{2x-1}{{x}^{2}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-312358/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6"] :knowledge-point/questions ["q-312358"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110517/selection/bcbcccb1dea14bd4b3ca07496f540c75678d00f511f704838812403243af881e" :answer/id #uuid "8f5ae844-7c6c-5cbd-a10e-e44fcbada0cc" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{5}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-110517/selection/c52a9d918aba6837a7a7b93dca010a5c9558dee369d4985d86dd55c0449a197d" :answer/id #uuid "f1a32ec2-0680-5b27-89e8-54891804a15d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x}}-\\frac{5}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-110517/selection/26720db02e41c5eef442ac0764fc9c8a49b414e522e8024e743408cbfe5eae89" :answer/id #uuid "38ac6303-4057-50c7-955c-9d29654de747" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{5}{|x|\\sqrt{{x}^{2}+1}}" :db/ensure [:answer/validate]} {:db/id "q-110517/selection/4ebc058f05855d3e563d3411591396dd6de292d83686e001dd5236139fc1a3c4" :answer/id #uuid "5c311ed6-ac18-5d12-9aac-9c128194d849" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}-\\frac{5}{|x|\\sqrt{{x}^{2}+1}}" :db/ensure [:answer/validate]} {:db/id "q-110517/selection/7840674e01a06f9f610f86c1908c8bdaea678fec43f1e1d58d443a3b71e75782" :answer/id #uuid "2a950ffa-dda7-5c9f-ab89-b2def2e02865" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-110517/selection" :answer-field/id #uuid "03666427-8f41-5df3-a2e7-8144cb490431" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110517/selection/c52a9d918aba6837a7a7b93dca010a5c9558dee369d4985d86dd55c0449a197d" :answer-field/choices ["q-110517/selection/bcbcccb1dea14bd4b3ca07496f540c75678d00f511f704838812403243af881e" "q-110517/selection/c52a9d918aba6837a7a7b93dca010a5c9558dee369d4985d86dd55c0449a197d" "q-110517/selection/26720db02e41c5eef442ac0764fc9c8a49b414e522e8024e743408cbfe5eae89" "q-110517/selection/4ebc058f05855d3e563d3411591396dd6de292d83686e001dd5236139fc1a3c4" "q-110517/selection/7840674e01a06f9f610f86c1908c8bdaea678fec43f1e1d58d443a3b71e75782"] :db/ensure [:answer-field/validate]} {:db/id "q-110517" :question/id #uuid "abdda85f-6c0c-52ca-ad4f-c1d33010c7d1" :question/math-academy-id "q-110517" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=2\\sqrt{x}+5arccscx.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x}+5arccscx) \\\\  & =\\frac{1}{\\sqrt{x}}+5\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx) \\\\  & =\\frac{1}{\\sqrt{x}}+5(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{1}{\\sqrt{x}}-\\frac{5}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6"] :knowledge-point/questions ["q-110517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110510/selection/5a80a89cbeccc45ad47f427a34f6ddbb1efd4d96632e37d5a0f85470719ff591" :answer/id #uuid "0903c05c-41d5-5ea5-bc07-c2e58209ba78" :answer/type :answer.type/math :answer/value "\\frac{7}{2\\sqrt{5}}" :db/ensure [:answer/validate]} {:db/id "q-110510/selection/6d355d54e96d2a05fa1b62628e18d5fce9b5f2ef82573cb37d1c99207622c9e9" :answer/id #uuid "ca1458e3-ebaf-5995-9066-283fa8ab4a1d" :answer/type :answer.type/math :answer/value "\\frac{2}{5\\sqrt{7}}" :db/ensure [:answer/validate]} {:db/id "q-110510/selection/9ff40c7522c5d735b166680620f1abd2a39bd87ac02b3a20cffef0127b246cb6" :answer/id #uuid "d2c36791-6a2f-51e7-9939-4c1f16661326" :answer/type :answer.type/math :answer/value "\\frac{2}{7\\sqrt{5}}" :db/ensure [:answer/validate]} {:db/id "q-110510/selection/ad32ddb748b6f749c4cf4212600c490b1b86591d10a94b0c42ddd5013222172f" :answer/id #uuid "4df82702-7f99-5e04-932d-c46d9bf06dbc" :answer/type :answer.type/math :answer/value "\\frac{7}{5\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-110510/selection/ffd1a26fb2a4b1e3cceed0cfaf7f4a1e535cbc0e095a2346905f76ce92fa5e55" :answer/id #uuid "a4975d8b-b25f-5450-b585-2b5d77c1bb2c" :answer/type :answer.type/math :answer/value "\\frac{5}{2\\sqrt{7}}" :db/ensure [:answer/validate]} {:db/id "q-110510/selection" :answer-field/id #uuid "3fab36b2-1a55-5b6c-85ad-d911ac46f1bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110510/selection/5a80a89cbeccc45ad47f427a34f6ddbb1efd4d96632e37d5a0f85470719ff591" :answer-field/choices ["q-110510/selection/5a80a89cbeccc45ad47f427a34f6ddbb1efd4d96632e37d5a0f85470719ff591" "q-110510/selection/6d355d54e96d2a05fa1b62628e18d5fce9b5f2ef82573cb37d1c99207622c9e9" "q-110510/selection/9ff40c7522c5d735b166680620f1abd2a39bd87ac02b3a20cffef0127b246cb6" "q-110510/selection/ad32ddb748b6f749c4cf4212600c490b1b86591d10a94b0c42ddd5013222172f" "q-110510/selection/ffd1a26fb2a4b1e3cceed0cfaf7f4a1e535cbc0e095a2346905f76ce92fa5e55"] :db/ensure [:answer-field/validate]} {:db/id "q-110510" :question/id #uuid "da33d32a-51d8-587d-b45c-abd810d5a74c" :question/math-academy-id "q-110510" :question/problem "Find the slope of the tangent line to the curve $f(x)=-7arccscx$ at $x=\\sqrt{5}.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-7arccscx) \\\\  & =-7\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{7}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line to the curve $y=f(x)$ at $x=\\sqrt{5}$ is\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{5}) & =\\frac{7}{|\\sqrt{5}|\\sqrt{{\\sqrt{5}}^{2}-1}} \\\\  & =\\frac{7}{\\sqrt{5}\\sqrt{5-1}} \\\\  & =\\frac{7}{2\\sqrt{5}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110510/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6"] :knowledge-point/questions ["q-110510"] :db/ensure [:knowledge-point/validate]} {:db/id "q-312364/field-1/37236b39a3459091be89bf28223460d4cf8ddbfd666a85c2c3d8eca75a94f359" :answer/id #uuid "350c092d-4234-56ec-ab00-800ff7788965" :answer/type :answer.type/math :answer/value "\\frac{5}{7\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "q-312364/field-1" :answer-field/id #uuid "d3f74186-85b1-5183-9df9-84e2d580d377" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312364/field-1/37236b39a3459091be89bf28223460d4cf8ddbfd666a85c2c3d8eca75a94f359" :answer-field/choices ["q-312364/field-1/37236b39a3459091be89bf28223460d4cf8ddbfd666a85c2c3d8eca75a94f359"] :db/ensure [:answer-field/validate]} {:db/id "q-312364" :question/id #uuid "e500b98d-716a-56c2-928c-2a1ac540ae13" :question/math-academy-id "q-312364" :question/problem "Calculate the slope $m$ of the tangent line to the curve $f(x)=5arcsec({x}^{2}+3)$ at $x=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arcsec$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arcsec\\,x)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5arcsec({x}^{2}+3)) \\\\  & =5\\cdot \\frac{1}{|{x}^{2}+3|\\sqrt{({x}^{2}+3)^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+3) \\\\  & =5\\cdot \\frac{1}{|{x}^{2}+3|\\sqrt{({x}^{2}+3)^{2}-1}}\\cdot (2x) \\\\  & =\\frac{10x}{|{x}^{2}+3|\\sqrt{({x}^{2}+3)^{2}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=2$ is\n\n$$\n\\begin{aligned}m={f}^{′}(2) & =\\frac{10(2)}{|{2}^{2}+3|\\sqrt{({2}^{2}+3)^{2}-1}} \\\\  & =\\frac{20}{|7|\\sqrt{49-1}} \\\\  & =\\frac{20}{7\\sqrt{48}} \\\\  & =\\frac{20}{7\\cdot 4\\sqrt{3}} \\\\  & =\\frac{5}{7\\sqrt{3}} \\\\  & =\\frac{5\\sqrt{3}}{21}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-312364/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-312364"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32000"] :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=2arccsc(8-{x}^{4}).$" :question/worked-solution "The formula for the derivative of $\\text{arccsc}$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\text{arccsc}\\,x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2arccsc(8-{x}^{4})) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccsc(8-{x}^{4})) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot \\frac{\\text{d}}{\\text{d}x}(8-{x}^{4}) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot (-4{x}^{3}) \\\\  & =\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-341121/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "b4171c1c-bee9-55e1-a978-d1ef0391896b" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-341121/field-1" :answer-field/id #uuid "1b131200-d08a-527d-b1fc-fb96db18a88e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341121/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer-field/choices ["q-341121/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8"] :db/ensure [:answer-field/validate]} {:db/id "q-341121" :question/id #uuid "7baa460e-75bc-5492-9c26-cad5bfa18a98" :question/math-academy-id "q-341121" :question/problem "Calculate the slope $m$ of the tangent line to the curve $f(x)=arccsc(\\sqrt{x})$ at $x=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccsc\\,x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[arccsc(\\sqrt{x})] \\\\  & =-\\frac{1}{|\\sqrt{x}|\\sqrt{{(\\sqrt{x})}^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}) \\\\  & =-\\frac{1}{\\sqrt{x}\\sqrt{x-1}}\\cdot \\frac{1}{2\\sqrt{x}} \\\\  & =-\\frac{1}{2x\\sqrt{x-1}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=2$ is\n\n$$\n\\begin{aligned}m={f}^{′}(2) & =-\\frac{1}{2\\cdot 2\\sqrt{2-1}} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-341121/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-341121"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341115/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "452aa4c2-874a-518e-8282-5ccc17e5e644" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-341115/field-1/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "f8006bc8-61ae-5cff-ad21-3760811f64a1" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-341115/field-1" :answer-field/id #uuid "c2b61ab3-8ba0-55c1-b35b-b8683e368a6f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341115/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-341115/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-341115/field-1/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d"] :db/ensure [:answer-field/validate]} {:db/id "q-341115" :question/id #uuid "cdb30687-9cf3-58a5-bd82-f54a25ec0566" :question/math-academy-id "q-341115" :question/problem "Calculate the slope $m$ of the tangent line to the curve $f(x)=arcsec({e}^{x})$ at $x=\\frac{1}{2}\\operatorname{ln}⁡10.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arcsec$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arcsec\\,x)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[arcsec({e}^{x})] \\\\  & =\\frac{1}{|{e}^{x}|\\sqrt{{({e}^{x})}^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{1}{{e}^{x}\\sqrt{{e}^{2x}-1}}\\cdot {e}^{x} \\\\  & =\\frac{1}{\\sqrt{{e}^{2x}-1}}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve at $x=\\frac{1}{2}\\operatorname{ln}⁡10$ is\n\n$$\n\\begin{aligned}m={f}^{′}(\\frac{1}{2}\\operatorname{ln}⁡10) & =\\frac{1}{\\sqrt{{e}^{2(\\operatorname{ln}⁡(10)/2)}-1}} \\\\  & =\\frac{1}{\\sqrt{{e}^{\\operatorname{ln}⁡10}-1}} \\\\  & =\\frac{1}{\\sqrt{10-1}} \\\\  & =\\frac{1}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-341115/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-341115"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31903/selection/75c4626d97684cf3be3d41a2e54b82d8ff06aeb463f6040fcdb8b17d95ac2a43" :answer/id #uuid "1f949076-9024-5950-b2c4-a5562da7a51f" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{6}}{20}" :db/ensure [:answer/validate]} {:db/id "q-31903/selection/3cbc84dd14272bcfbc4ad6ab50d230e762863838fc70d39c4c4f233813e8fb0f" :answer/id #uuid "2d8e59a2-767f-5ce6-b711-00d93397ddd2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}}{10}" :db/ensure [:answer/validate]} {:db/id "q-31903/selection/9789b7f89188f892c62667cce398372f2f262727505e33a4129f1b2ae0a77212" :answer/id #uuid "3106f6e3-60e8-5a25-8e25-eb6164164c58" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{6}}{10}" :db/ensure [:answer/validate]} {:db/id "q-31903/selection/f0c6b464f5724d272e1ac7ecc073bdfded6dd0de951bfe474a9ef5518c3a2f84" :answer/id #uuid "77eedea7-91cb-5e52-8d4f-6c45c93fd3cc" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{6}}{5}" :db/ensure [:answer/validate]} {:db/id "q-31903/selection/077a4a067a09eb8b6a889e43efe1f22c2f479e7b44143acf30e1113cadd3518f" :answer/id #uuid "c686ec97-5077-5aa6-b0f8-d2b68102ff60" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{6}}{20}" :db/ensure [:answer/validate]} {:db/id "q-31903/selection" :answer-field/id #uuid "1a2ddca2-3b60-567b-aeaf-4e721f1f3668" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31903/selection/75c4626d97684cf3be3d41a2e54b82d8ff06aeb463f6040fcdb8b17d95ac2a43" :answer-field/choices ["q-31903/selection/75c4626d97684cf3be3d41a2e54b82d8ff06aeb463f6040fcdb8b17d95ac2a43" "q-31903/selection/3cbc84dd14272bcfbc4ad6ab50d230e762863838fc70d39c4c4f233813e8fb0f" "q-31903/selection/9789b7f89188f892c62667cce398372f2f262727505e33a4129f1b2ae0a77212" "q-31903/selection/f0c6b464f5724d272e1ac7ecc073bdfded6dd0de951bfe474a9ef5518c3a2f84" "q-31903/selection/077a4a067a09eb8b6a889e43efe1f22c2f479e7b44143acf30e1113cadd3518f"] :db/ensure [:answer-field/validate]} {:db/id "q-31903" :question/id #uuid "d31c3cb9-e04d-585e-b687-400e1b6c482d" :question/math-academy-id "q-31903" :question/problem "Find the slope of the tangent line to the function $y=arcsec({x}^{3}-6x)$ at $x=1.$" :question/worked-solution "The formula for the derivative of $arcsec$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arcsecx)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(arcsec({x}^{3}-6x)) \\\\  & =\\frac{1}{|{x}^{3}-6x|\\sqrt{({x}^{3}-6x)^{2}-1}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3}-6x) \\\\  & =\\frac{1}{|{x}^{3}-6x|\\sqrt{({x}^{3}-6x)^{2}-1}}\\cdot (3{x}^{2}-6) \\\\  & =\\frac{3{x}^{2}-6}{|{x}^{3}-6x|\\sqrt{({x}^{3}-6x)^{2}-1}}\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line to the curve at $x=1$ is\n\n$$\n\\begin{aligned}{y}^{′}(1)\\text{ } & =\\frac{3(1)^{2}-6}{|{1}^{3}-6(1)|\\sqrt{({1}^{3}-6(1))^{2}-1}} \\\\  & =\\frac{-3}{|-5|\\sqrt{(1-6)^{2}-1}} \\\\  & =-\\frac{3}{5\\sqrt{24}} \\\\  & =-\\frac{3}{5\\sqrt{4\\cdot 6}} \\\\  & =-\\frac{3}{5\\cdot \\sqrt{4}\\cdot \\sqrt{6}} \\\\  & =-\\frac{3}{5\\cdot 2\\cdot \\sqrt{6}} \\\\  & =-\\frac{3}{10\\sqrt{6}} \\\\  & =-\\frac{3\\sqrt{6}}{10\\sqrt{6}\\cdot \\sqrt{6}} \\\\  & =-\\frac{3\\sqrt{6}}{60} \\\\  & =-\\frac{\\sqrt{6}}{20}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-31903/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e"] :knowledge-point/questions ["q-31903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341146/field-1/719f2c5221769427df922380ff0b1548be8620916d809a0d9d83f122347dee85" :answer/id #uuid "8a3c17a6-dd98-5816-83d3-9445394840ea" :answer/type :answer.type/math :answer/value "\\frac{e^x}{1+x^2}" :db/ensure [:answer/validate]} {:db/id "q-341146/field-1" :answer-field/id #uuid "7a475c59-8abb-525b-be82-2553aa8cc4af" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341146/field-1/719f2c5221769427df922380ff0b1548be8620916d809a0d9d83f122347dee85" :answer-field/choices ["q-341146/field-1/719f2c5221769427df922380ff0b1548be8620916d809a0d9d83f122347dee85"] :db/ensure [:answer-field/validate]} {:db/id "q-341146" :question/id #uuid "624e21b1-55f1-5ea7-a70e-9b4efbbbc1ee" :question/math-academy-id "q-341146" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)={e}^{x}\\cdot arccot\\,x.$\n\n${f}^{′}(x)={e}^{x}\\,arccot\\,x\\,-$\n{{field-1}}" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccot\\,x)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}\\cdot arccot\\,x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})\\cdot arccot\\,x+{e}^{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(arccot\\,x) \\\\  & ={e}^{x}\\,arccot\\,x+{e}^{x}\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & ={e}^{x}\\,arccot\\,x-\\frac{{e}^{x}}{1+{x}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341146/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-341146"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2484/selection/61a8bef9ed607e8ef023f73a91e6ae60d1a2267497514540fe5d4bd8c98ce99a" :answer/id #uuid "b2068ba1-18b5-534d-bae3-d544e4ebf42f" :answer/type :answer.type/math :answer/value "\\frac{2x}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-2484/selection/3a04eb03d1b04b8d815288437bf8906348a0f16960e0e00bcdc69129acd65e42" :answer/id #uuid "e1e2fe74-45db-5404-bce1-046f80a8c806" :answer/type :answer.type/math :answer/value "\\frac{2arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-2484/selection/0315a160c389d1aa70ca5a6aec454c537142c2a6e93d651418e4e727da5a2a5f" :answer/id #uuid "976b9f42-f485-5d58-9410-f1a023309122" :answer/type :answer.type/math :answer/value "\\frac{2arccscx}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-2484/selection/d26114dfd0ee977857010f5a6c0c2e9fc7967e6509945c1184a84f3b257219f6" :answer/id #uuid "4feb6c98-d473-583a-be48-77b3b134ba8f" :answer/type :answer.type/math :answer/value "\\frac{arccscx+arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-2484/selection/c5b8c3e5cd9f6537609d0eef62d364be1a5156197ea814497a62745550a282b3" :answer/id #uuid "0164d8b3-80ed-5bfa-9397-143c50d659d9" :answer/type :answer.type/math :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "q-2484/selection" :answer-field/id #uuid "3af2a650-8d0d-523b-9b33-32db22adbd9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2484/selection/c5b8c3e5cd9f6537609d0eef62d364be1a5156197ea814497a62745550a282b3" :answer-field/choices ["q-2484/selection/61a8bef9ed607e8ef023f73a91e6ae60d1a2267497514540fe5d4bd8c98ce99a" "q-2484/selection/3a04eb03d1b04b8d815288437bf8906348a0f16960e0e00bcdc69129acd65e42" "q-2484/selection/0315a160c389d1aa70ca5a6aec454c537142c2a6e93d651418e4e727da5a2a5f" "q-2484/selection/d26114dfd0ee977857010f5a6c0c2e9fc7967e6509945c1184a84f3b257219f6" "q-2484/selection/c5b8c3e5cd9f6537609d0eef62d364be1a5156197ea814497a62745550a282b3"] :db/ensure [:answer-field/validate]} {:db/id "q-2484" :question/id #uuid "71e5c02b-fbcb-5a16-a48a-593db81fecae" :question/math-academy-id "q-2484" :question/problem "Find ${f}^{′}(x)$ for $f(x)=arccscx\\cdot arcsecx$" :question/worked-solution "The formulae for the derivatives of $arccsc$ and $arcsec$ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arccscx) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(arcsecx) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the product rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =arcsecx\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx)+arccscx\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsecx) \\\\  & =arcsecx\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})+arccscx\\cdot (\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =-\\frac{arcsecx}{|x|\\sqrt{{x}^{2}-1}}+\\frac{arccscx}{|x|\\sqrt{{x}^{2}-1}} \\\\  & =\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2484/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-2484"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110817/selection/2cfa2b6a3bdf3b70cab7cc91146d988172d0ad9eb23806b052d73431022d9b84" :answer/id #uuid "f7a2fb07-eb33-516a-aa15-63507d82cad6" :answer/type :answer.type/math :answer/value "\\frac{arccot{x}^{3}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1-{x}^{6}}" :db/ensure [:answer/validate]} {:db/id "q-110817/selection/32204f88e062794976d85d88df306aed5245de3b8e004ee4403e534c5a6d01ea" :answer/id #uuid "03aeea1e-4837-5267-a400-99f6b31654d8" :answer/type :answer.type/math :answer/value "\\frac{arccot{x}^{3}}{x}+\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1-{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-110817/selection/1cf26913448f93fafa07d0e96332e298cb3362b7617093e6ebcceffa475e56a3" :answer/id #uuid "de3e58ef-55a7-59b5-9343-35063e020006" :answer/type :answer.type/math :answer/value "\\frac{arccot3{x}^{2}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1+{x}^{6}}" :db/ensure [:answer/validate]} {:db/id "q-110817/selection/9e72bb7f593291bac238065020df47ace1a85cb2e9e24d60a42bc800423fe6f7" :answer/id #uuid "b540f889-ac93-5a5b-b449-8f605a72eec1" :answer/type :answer.type/math :answer/value "\\frac{arccot3{x}^{2}}{x}-\\frac{{x}^{3}\\operatorname{ln}⁡x}{1+{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-110817/selection/2cb88c1d131753d0a2c9eb8423226d7094335a870065fb68390e92e64e498c78" :answer/id #uuid "ca61c379-b42a-556c-808b-767267af91e3" :answer/type :answer.type/math :answer/value "\\frac{arccot{x}^{3}}{x}-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1+{x}^{6}}" :db/ensure [:answer/validate]} {:db/id "q-110817/selection" :answer-field/id #uuid "d340a2fe-05f5-5dcc-b168-8548ccf5d51c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110817/selection/2cb88c1d131753d0a2c9eb8423226d7094335a870065fb68390e92e64e498c78" :answer-field/choices ["q-110817/selection/2cfa2b6a3bdf3b70cab7cc91146d988172d0ad9eb23806b052d73431022d9b84" "q-110817/selection/32204f88e062794976d85d88df306aed5245de3b8e004ee4403e534c5a6d01ea" "q-110817/selection/1cf26913448f93fafa07d0e96332e298cb3362b7617093e6ebcceffa475e56a3" "q-110817/selection/9e72bb7f593291bac238065020df47ace1a85cb2e9e24d60a42bc800423fe6f7" "q-110817/selection/2cb88c1d131753d0a2c9eb8423226d7094335a870065fb68390e92e64e498c78"] :db/ensure [:answer-field/validate]} {:db/id "q-110817" :question/id #uuid "48740a36-951e-5602-94b1-6e787cb30868" :question/math-academy-id "q-110817" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{ln}⁡xarccot{x}^{3}.$" :question/worked-solution "The formula for the derivative of $\\text{arccot}$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccotx)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule, the formula above and the chain rule, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡xarccot{x}^{3}) \\\\  & =\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(arccot{x}^{3})+arccot{x}^{3}\\cdot \\frac{\\text{d}}{\\text{d}x}\\operatorname{ln}⁡x \\\\  & =\\operatorname{ln}⁡x\\cdot (-\\frac{3{x}^{2}}{1+{({x}^{3})}^{2}})+arccot{x}^{3}\\cdot (\\frac{1}{x}) \\\\  & =\\frac{arccot{x}^{3}}{x}-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{1+{x}^{6}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-110817/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-110817"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19065/selection/12f5e36e91db1c2302d9b7c8e0f786bc2e54d3c3eaf9cdf8b64046a43bcc3898" :answer/id #uuid "22a7d29f-2810-5e63-848e-f1c021da56d7" :answer/type :answer.type/math :answer/value "arccotx-\\frac{({x}^{3}+2x)(3{x}^{2}+2)}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-19065/selection/46d9cfbe53e0bcd4101f20de075c09a8cd5be5bf88028699b13a37c0549f9099" :answer/id #uuid "7f2faed0-a97c-5c3b-bd9b-f7bdc660d8bb" :answer/type :answer.type/math :answer/value "(3{x}^{2}+2)arccotx-\\frac{1}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-19065/selection/681a59b3c6030771b37440c9a2510dea05278c19b3ed991cd9ae93de413de0a2" :answer/id #uuid "fdc6737b-83f2-58ab-9a91-d450bc89e653" :answer/type :answer.type/math :answer/value "arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-19065/selection/147d6689ee8678d952d18c7f053e4dcf4de000f1a2da11e08eb985ccf5590eaa" :answer/id #uuid "c8962ad7-df43-520f-a3b2-00bdc031bfc7" :answer/type :answer.type/math :answer/value "(3{x}^{2}+2)-\\frac{1}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-19065/selection/a5aae96a0756ae9119126a4bb851e02f60ea066dba1ebe87149d1d5091d8ed21" :answer/id #uuid "88e434a0-4e93-54b4-9fbf-3125ab73bf9b" :answer/type :answer.type/math :answer/value "(3{x}^{2}+2)arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-19065/selection" :answer-field/id #uuid "58cc4ce9-9df6-510e-879b-627e31a81e02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19065/selection/a5aae96a0756ae9119126a4bb851e02f60ea066dba1ebe87149d1d5091d8ed21" :answer-field/choices ["q-19065/selection/12f5e36e91db1c2302d9b7c8e0f786bc2e54d3c3eaf9cdf8b64046a43bcc3898" "q-19065/selection/46d9cfbe53e0bcd4101f20de075c09a8cd5be5bf88028699b13a37c0549f9099" "q-19065/selection/681a59b3c6030771b37440c9a2510dea05278c19b3ed991cd9ae93de413de0a2" "q-19065/selection/147d6689ee8678d952d18c7f053e4dcf4de000f1a2da11e08eb985ccf5590eaa" "q-19065/selection/a5aae96a0756ae9119126a4bb851e02f60ea066dba1ebe87149d1d5091d8ed21"] :db/ensure [:answer-field/validate]} {:db/id "q-19065" :question/id #uuid "4a183af2-b9c0-56b5-8608-49e8ddb137c3" :question/math-academy-id "q-19065" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=({x}^{3}+2x)arccotx.$" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccotx)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{3}+2x)arccotx) \\\\  & =arccotx\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3}+2x)+({x}^{3}+2x)\\cdot \\frac{\\text{d}}{\\text{d}x}(arccotx) \\\\  & =arccotx\\cdot (3{x}^{2}+2)+({x}^{3}+2x)\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & =(3{x}^{2}+2)arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19065/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-19065"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110791/selection/4f2d70b56d8add19829f9e266e134448419ca993c9a3708a818540b3eb0ebf31" :answer/id #uuid "64e0ec7d-6f3c-51f0-a566-df771f706d49" :answer/type :answer.type/math :answer/value "arccscx\\cdot \\operatorname{cos}⁡x-\\frac{\\operatorname{sin}⁡x}{x\\s