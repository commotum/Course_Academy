4d7325e3ac65202c03597f4c8cd227cb3a0de70594e82c92386e11c8a9f674f"] :db/ensure [:answer-field/validate]} {:db/id "q-110791" :question/id #uuid "f96882ab-e18d-5ec0-92db-ae32aa8216d0" :question/math-academy-id "q-110791" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\operatorname{sin}⁡x\\cdot arccsc{x}^{2}$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arccsc{x}^{2}) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\operatorname{sin}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(arccsc{x}^{2})+arccsc{x}^{2}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{2x}{{x}^{2}\\sqrt{{x}^{4}-1}})+arccsc{x}^{2}\\cdot \\operatorname{cos}⁡x \\\\  & =arccsc{x}^{2}\\cdot \\operatorname{cos}⁡x-\\frac{2\\operatorname{sin}⁡x}{x\\sqrt{{x}^{4}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-110791/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4"] :knowledge-point/questions ["q-110791"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73447/selection/0238724cf86b3dbb75bdffa9cf81e62a58aca198949ca9c924a27efe17425cfc" :answer/id #uuid "8642d0a1-2566-5d24-88b4-bbedd299fb99" :answer/type :answer.type/math :answer/value "-\\frac{1+{x}^{2}arccotx}{1+{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-73447/selection/ac8c8d1c68d2a0d3a3797a3b588d90edc144271d5aa0808977e695ef0efe0919" :answer/id #uuid "16de84a4-86fc-59e1-9c76-d990cd8d9808" :answer/type :answer.type/math :answer/value "\\frac{arccotx}{{x}^{2}(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-73447/selection/7885e78e1de24f4e41d2738b41690604aafdfd5a92e5e52a739b7ebaac446654" :answer/id #uuid "856eb0b7-1898-53ba-8af4-976cc209b7d7" :answer/type :answer.type/math :answer/value "\\frac{(1+x)arccotx}{x(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-73447/selection/5735a776ea52bccebb6523d223916861d258d24fe3f85549b6a313a3bb521122" :answer/id #uuid "59c8c876-3df0-5ae5-8f0f-2934903b1a53" :answer/type :answer.type/math :answer/value "-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-73447/selection/b518875ed45a077b6ebf4cc6a7064bcf58f77f58d0f2a5098311d9efd4f27bb3" :answer/id #uuid "c82dc217-0b90-5c97-9d00-b7d02371e170" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{2}+arccotx}{1+{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-73447/selection" :answer-field/id #uuid "7a388b08-6722-5f90-a867-d244b4e63021" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73447/selection/5735a776ea52bccebb6523d223916861d258d24fe3f85549b6a313a3bb521122" :answer-field/choices ["q-73447/selection/0238724cf86b3dbb75bdffa9cf81e62a58aca198949ca9c924a27efe17425cfc" "q-73447/selection/ac8c8d1c68d2a0d3a3797a3b588d90edc144271d5aa0808977e695ef0efe0919" "q-73447/selection/7885e78e1de24f4e41d2738b41690604aafdfd5a92e5e52a739b7ebaac446654" "q-73447/selection/5735a776ea52bccebb6523d223916861d258d24fe3f85549b6a313a3bb521122" "q-73447/selection/b518875ed45a077b6ebf4cc6a7064bcf58f77f58d0f2a5098311d9efd4f27bb3"] :db/ensure [:answer-field/validate]} {:db/id "q-73447" :question/id #uuid "1330ca8f-a471-5b0b-b8f9-0e720b30433b" :question/math-academy-id "q-73447" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccotx}{x}.$" :question/worked-solution "Here, we let $u(x)=arccotx$ and $v(x)=x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot x-arccotx\\cdot 1}{{x}^{2}} \\\\  & =\\frac{-\\frac{x}{1+{x}^{2}}-arccotx}{{x}^{2}} \\\\  & =-\\frac{(\\frac{x+(1+{x}^{2})arccotx}{1+{x}^{2}})}{{x}^{2}} \\\\  & =-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73447/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-73447"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73448/selection/a7e0bf44ad3eafb1e1f3e35ef18ab4f9105a1715b79432226fe9428a97b23dbe" :answer/id #uuid "c114d124-80ce-52d9-8bc9-2c3bc5d9d371" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}-\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/ensure [:answer/validate]} {:db/id "q-73448/selection/e248908a824f10457c3cf32eb071d38c838c2ee8254bb4a2c582a6479831d1be" :answer/id #uuid "e83104c7-623e-5886-a5cc-1bed3169ad1f" :answer/type :answer.type/math :answer/value "\\frac{3}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/ensure [:answer/validate]} {:db/id "q-73448/selection/aa5eb7558e1a190e27dd1948f2ec4daa9535c8cd54b2a7c0e864fd6825c93617" :answer/id #uuid "b1447c01-6127-53b1-a263-67011d1a8c17" :answer/type :answer.type/math :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-73448/selection/d13967cb090e2058c622cbb7b33315a98e7e0a06863dfaea56d846baa1ad8764" :answer/id #uuid "7539412d-3395-5d5b-8cca-d8405ca607cb" :answer/type :answer.type/math :answer/value "-\\frac{3}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-73448/selection/da83fae2976982862922b773bbcaec71ccfe0875a0fc536b5d1e162462690924" :answer/id #uuid "4c69394d-ba49-5db4-9dcd-c2d8fe49f3b9" :answer/type :answer.type/math :answer/value "-\\frac{{e}^{3x}-1}{|x|\\sqrt{{x}^{2}-1}}+\\frac{3arccscx}{{e}^{3x}({e}^{3x}-1)}" :db/ensure [:answer/validate]} {:db/id "q-73448/selection" :answer-field/id #uuid "dc6284af-6aec-5a92-b699-6042567571b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73448/selection/aa5eb7558e1a190e27dd1948f2ec4daa9535c8cd54b2a7c0e864fd6825c93617" :answer-field/choices ["q-73448/selection/a7e0bf44ad3eafb1e1f3e35ef18ab4f9105a1715b79432226fe9428a97b23dbe" "q-73448/selection/e248908a824f10457c3cf32eb071d38c838c2ee8254bb4a2c582a6479831d1be" "q-73448/selection/aa5eb7558e1a190e27dd1948f2ec4daa9535c8cd54b2a7c0e864fd6825c93617" "q-73448/selection/d13967cb090e2058c622cbb7b33315a98e7e0a06863dfaea56d846baa1ad8764" "q-73448/selection/da83fae2976982862922b773bbcaec71ccfe0875a0fc536b5d1e162462690924"] :db/ensure [:answer-field/validate]} {:db/id "q-73448" :question/id #uuid "1cfa91c9-7c5b-5810-b341-38bc9862e893" :question/math-academy-id "q-73448" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccscx}{{e}^{3x}-1}.$" :question/worked-solution "Here, we let $u(x)=arccscx$ and $v(x)={e}^{3x}-1$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{and}\\,{v}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot ({e}^{3x}-1)-arccscx\\cdot 3{e}^{3x}}{({e}^{3x}-1)^{2}} \\\\  & =-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73448/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-73448"] :db/ensure [:knowledge-point/validate]} {:db/id "q-312391/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer/id #uuid "71f7bfdf-b9fb-531b-80e2-6f90c8d0736f" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "q-312391/field-1" :answer-field/id #uuid "071cc1af-1be6-5239-a884-2264b02d748e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312391/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer-field/choices ["q-312391/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7"] :db/ensure [:answer-field/validate]} {:db/id "q-312391/field-2/3551afa682feff27742e959ecb172200104607a41f4197afefcb2d7db2ed74bb" :answer/id #uuid "b364be9f-8142-5097-a442-61cd5527a795" :answer/type :answer.type/math :answer/value "\\frac{x^2+5}{\\sqrt{x^2-1}}" :db/ensure [:answer/validate]} {:db/id "q-312391/field-2" :answer-field/id #uuid "80ae2a14-216d-5daf-b4f4-ab1a5bcf3093" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312391/field-2/3551afa682feff27742e959ecb172200104607a41f4197afefcb2d7db2ed74bb" :answer-field/choices ["q-312391/field-2/3551afa682feff27742e959ecb172200104607a41f4197afefcb2d7db2ed74bb"] :db/ensure [:answer-field/validate]} {:db/id "q-312391" :question/id #uuid "f287a5e1-90d1-51aa-b84d-a524d5dafda5" :question/math-academy-id "q-312391" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\frac{{x}^{2}+5}{arcsec\\,x}.$\n\n${f}^{′}(x)=$\n{{field-1}} \n$\\frac{1}{arcsec\\,x}\\,-$\n\n{{field-2}} \n$\\frac{1}{|x|{arcsec}^{2}\\,x}$" :question/worked-solution "Here, we let $u(x)={x}^{2}+5$ and $v(x)=arcsec\\,x,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=2x\\,\\text{and}\\,{v}^{′}(x)=\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2x)\\cdot arcsec\\,x-({x}^{2}+5)\\cdot \\frac{1}{|x|\\sqrt{{x}^{2}-1}}}{(arcsec\\,x)^{2}}. \\\\  & =2x\\,\\frac{1}{arcsec\\,x}-\\frac{{x}^{2}+5}{\\sqrt{{x}^{2}-1}}\\,\\frac{1}{|x|{arcsec}^{2}\\,x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-312391/field-1" "q-312391/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-312391"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110834/selection/3b24f9fd4c1bcee8bd804a1814f7352bdd0fd86e81233c18664f0418a976237c" :answer/id #uuid "0c0084b5-3147-50ef-b0a3-680f47ad1a67" :answer/type :answer.type/math :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/ensure [:answer/validate]} {:db/id "q-110834/selection/93836f85c8ca0876261503e7a3a8a0af113230d9d86b796f5df327f9b2e6df66" :answer/id #uuid "95e68409-b254-5dbe-805a-3ac1fdf7dc91" :answer/type :answer.type/math :answer/value "\\frac{4x+2}{arcsecx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/ensure [:answer/validate]} {:db/id "q-110834/selection/831cff46dcfeab9d87df8ac3e051e0e691ba6cddf625341d177d8d5438b318d6" :answer/id #uuid "89120c3b-e6e1-5bd9-b6de-980f0d915541" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+4}{arccscx}-\\frac{2x+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/ensure [:answer/validate]} {:db/id "q-110834/selection/9b07b6e8b677b116e7c7833679e03ae1eb18604c847bd85ba7d188b92d54f9b2" :answer/id #uuid "373bea4e-6466-59f7-a53e-9428c9d23497" :answer/type :answer.type/math :answer/value "\\frac{x+4}{arccscx}-\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/ensure [:answer/validate]} {:db/id "q-110834/selection/72e3e52d3b886b01e43d9bc6721b7a2bf15345c6c7f267bfcf126d06b5d45b0c" :answer/id #uuid "6e8b1548-a5f1-5c1c-9ec3-4ec676db652c" :answer/type :answer.type/math :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/ensure [:answer/validate]} {:db/id "q-110834/selection" :answer-field/id #uuid "e65d2b9e-6021-519a-bae0-a0fcd1cd4f89" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110834/selection/72e3e52d3b886b01e43d9bc6721b7a2bf15345c6c7f267bfcf126d06b5d45b0c" :answer-field/choices ["q-110834/selection/3b24f9fd4c1bcee8bd804a1814f7352bdd0fd86e81233c18664f0418a976237c" "q-110834/selection/93836f85c8ca0876261503e7a3a8a0af113230d9d86b796f5df327f9b2e6df66" "q-110834/selection/831cff46dcfeab9d87df8ac3e051e0e691ba6cddf625341d177d8d5438b318d6" "q-110834/selection/9b07b6e8b677b116e7c7833679e03ae1eb18604c847bd85ba7d188b92d54f9b2" "q-110834/selection/72e3e52d3b886b01e43d9bc6721b7a2bf15345c6c7f267bfcf126d06b5d45b0c"] :db/ensure [:answer-field/validate]} {:db/id "q-110834" :question/id #uuid "10ef82b2-bd9d-5fd0-8d9d-21fd5cdbf4b8" :question/math-academy-id "q-110834" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{{x}^{2}+4x}{arccscx}.$" :question/worked-solution "Here, we let $u(x)={x}^{2}+4x$ and $v(x)=arccscx,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=2x+4\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2x+4)\\cdot arccscx-({x}^{2}+4x)\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{arccsc}^{2}x} \\\\  & =\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-110834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110786/selection/4429db8533bcbfbe51a89d268587a3a755e3b9745054164238a230a96a7b8660" :answer/id #uuid "2d590417-8016-556f-bd37-e1639f9cbd2e" :answer/type :answer.type/math :answer/value "\\frac{2x+3{x}^{2}arccotx}{{x}^{4}(1-{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-110786/selection/02eb752b1fb762ca00a81bf1c7bb90c4beee279c7974eb299b8f1f45c1896204" :answer/id #uuid "123b58ad-f095-5d74-b122-704a178062ea" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{2}-4(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-110786/selection/fce953250ec1185c665b70f1c1c4de343c452fa62a51f5a136e5ea63df5409a8" :answer/id #uuid "940fdeda-24af-51f1-b035-05ccff627e37" :answer/type :answer.type/math :answer/value "-\\frac{2x+3(1+{x}^{2}){x}^{2}arccotx}{{x}^{4}(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-110786/selection/963134781cbd3da61adf30840598a1a2ac9b82b8624609218b937ea0e4943552" :answer/id #uuid "7761399a-a213-5bf0-b5e9-ae6dbf8dd076" :answer/type :answer.type/math :answer/value "-\\frac{x+3(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-110786/selection/665ca292e0b52621a8dbfa902ffa167617d0c5011ac0d8d33fc041f249902f49" :answer/id #uuid "3c4c26bc-e296-581c-ac56-8d2d4826174b" :answer/type :answer.type/math :answer/value "\\frac{x-(1+{x}^{2})arccotx}{{x}^{2}(1-{x}^{2})}" :db/ensure [:answer/validate]} {:db/id "q-110786/selection" :answer-field/id #uuid "3a796016-e711-5066-9c3a-5ddc3c0884e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110786/selection/963134781cbd3da61adf30840598a1a2ac9b82b8624609218b937ea0e4943552" :answer-field/choices ["q-110786/selection/4429db8533bcbfbe51a89d268587a3a755e3b9745054164238a230a96a7b8660" "q-110786/selection/02eb752b1fb762ca00a81bf1c7bb90c4beee279c7974eb299b8f1f45c1896204" "q-110786/selection/fce953250ec1185c665b70f1c1c4de343c452fa62a51f5a136e5ea63df5409a8" "q-110786/selection/963134781cbd3da61adf30840598a1a2ac9b82b8624609218b937ea0e4943552" "q-110786/selection/665ca292e0b52621a8dbfa902ffa167617d0c5011ac0d8d33fc041f249902f49"] :db/ensure [:answer-field/validate]} {:db/id "q-110786" :question/id #uuid "35da99b2-e525-5a87-bbeb-6057eba4054b" :question/math-academy-id "q-110786" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccotx}{{x}^{3}}.$" :question/worked-solution "Here, we let $u(x)=arccotx$ and $v(x)={x}^{3},$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=3{x}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot {x}^{3}-arccotx\\cdot 3{x}^{2}}{({x}^{3})^{2}} \\\\  & =\\frac{-\\frac{{x}^{3}}{1+{x}^{2}}-3{x}^{2}arccotx}{{x}^{6}} \\\\  & =-\\frac{(\\frac{{x}^{3}+3(1+{x}^{2}){x}^{2}arccotx}{1+{x}^{2}})}{{x}^{6}} \\\\  & =-\\frac{{x}^{3}+3(1+{x}^{2}){x}^{2}arccotx}{{x}^{6}(1+{x}^{2})} \\\\  & =-\\frac{x+3(1+{x}^{2})arccotx}{{x}^{4}(1+{x}^{2})}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110786/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1"] :knowledge-point/questions ["q-110786"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-207"] :question/problem "Calculate $\\dfrac {\\textrm{d}y}{\\textrm{d}x}$ if $y = 2 \\,\\textrm {arccot } x.$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }x) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccot }x) \\\\  & =2\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & =-\\frac{2}{1+{x}^{2}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-210"] :question/problem "Find $f'(x)$ if $f(x) =2 \\, \\textrm {arccot } (x^2 + 5).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccot}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccot } x) \t=  -\\dfrac 1 {1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\,\\text{arccot }({x}^{2}+5)) \\\\  & =2\\cdot (-\\frac{1}{1+({x}^{2}+5)^{2}})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5) \\\\  & =-\\frac{2}{1+({x}^{2}+5)^{2}}\\cdot 2x \\\\  & =-\\frac{4x}{1+({x}^{2}+5)^{2}} \\\\  & =-\\frac{4x}{{x}^{4}+10{x}^{2}+26}\\,.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-209"] :question/problem "If $f(x) =3 x\\, \\textrm {arccsc }x,$ calculate $f'(x).$" :question/worked-solution "The formula for the derivative of $\\textrm{arccsc}$ is\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\textrm {arccsc } x) \t=  -\\dfrac 1 {|x| \\sqrt {x^2 - 1}} \\, .\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3x\\,\\text{arccsc }x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x\\,\\text{arccsc }x) \\\\  & =3(x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\text{arccsc }x)+\\text{arccsc }x\\cdot \\frac{\\text{d}}{\\text{d}x}(x)) \\\\  & =3x(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})+3\\,\\text{arccsc }x\\cdot 1 \\\\  & =-\\frac{3x}{|x|\\sqrt{{x}^{2}-1}}+3\\,\\text{arccsc }x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-208"] :question/problem "If $f(x) = \\dfrac{\\textrm{arcsec } x}{\\textrm{arccsc } x},$ calculate $f'(x).$" :question/worked-solution "Here, we let $u(x) = \\textrm{arcsec } x$ and $v(x) = \\textrm{arccsc } x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\nu'(x) =  \\dfrac 1 {|x| \\sqrt {x^2 - 1}}\t\\quad \\text{and} \\quad\tv'(x) = -\\dfrac 1 {|x| \\sqrt {x^2 - 1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot \\text{arccsc }x-\\text{arcsec }x\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{\\text{arccsc }}^{2}x} \\\\  & =(\\frac{1}{|x|\\sqrt{{x}^{2}-1}})\\frac{\\text{arccsc }x+\\text{arcsec }x}{{\\text{arccsc }}^{2}x} \\\\  & =\\frac{\\text{arccsc }x+\\text{arcsec }x}{|x|\\sqrt{{x}^{2}-1}{\\text{ arccsc }}^{2}x}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
