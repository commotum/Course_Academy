ect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(x-\\frac{\\pi }{3})\\ge 1.\n$$\n\nMultiplying the above inequality by $-3$ and adding $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(x-\\frac{\\pi }{3})\\ge 1 \\\\  & -3\\operatorname{csc}⁡(x-\\frac{\\pi }{3})\\le -3 \\\\  & -3\\operatorname{csc}⁡(x-\\frac{\\pi }{3})+2\\le -3+2 \\\\  & -3\\operatorname{csc}⁡(x-\\frac{\\pi }{3})+2\\le -1 \\\\  & f(x)\\le -1.\\end{aligned}\n$$\n\nTherefore, $f(x)=-1$ at its local maximum points." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117803/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce"] :knowledge-point/questions ["q-117803"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81581/selection/79371f6ca280610dbaddc9e4abcb9f3a11f6abc18c6c57ce6c7d08963328d15c" :answer/id #uuid "c2372e9d-787c-512e-9790-894946fb3239" :answer/type :answer.type/math :answer/value "x\\ne {60}^{∘}+n\\cdot {45}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-81581/selection/3bb1aa90c8d4b97157a173b88eae3c9a14c9aba4951dff4a4c1f334e9df366e5" :answer/id #uuid "2566c42e-21ec-5bec-a4ef-cad60fef8105" :answer/type :answer.type/math :answer/value "x\\ne {120}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-81581/selection/dd7871c1c5d4b708d61737f2038528cdcfefff0742be69a6db2df17ac4077955" :answer/id #uuid "bd8be909-3d3c-55e3-9847-166d95fdca34" :answer/type :answer.type/math :answer/value "x\\ne {120}^{∘}+n\\cdot {90}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-81581/selection/e6da843ae338c618f5eb51a4a80e730c45308951e0bf39aaabd216f6ab543530" :answer/id #uuid "119398ef-fba1-5fb7-8287-22b0eedace3c" :answer/type :answer.type/math :answer/value "x\\ne {60}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-81581/selection/0dcad22ddfe80cf9ab6effd825d75a39e6b63c16d01044f31e9f0d2ca73720be" :answer/id #uuid "61917597-19fd-5bad-9f41-4c7f845763bb" :answer/type :answer.type/math :answer/value "x\\ne {60}^{∘}+n\\cdot {90}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-81581/selection" :answer-field/id #uuid "b26d1079-b699-5f7d-a372-1feb63b1b268" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81581/selection/e6da843ae338c618f5eb51a4a80e730c45308951e0bf39aaabd216f6ab543530" :answer-field/choices ["q-81581/selection/79371f6ca280610dbaddc9e4abcb9f3a11f6abc18c6c57ce6c7d08963328d15c" "q-81581/selection/3bb1aa90c8d4b97157a173b88eae3c9a14c9aba4951dff4a4c1f334e9df366e5" "q-81581/selection/dd7871c1c5d4b708d61737f2038528cdcfefff0742be69a6db2df17ac4077955" "q-81581/selection/e6da843ae338c618f5eb51a4a80e730c45308951e0bf39aaabd216f6ab543530" "q-81581/selection/0dcad22ddfe80cf9ab6effd825d75a39e6b63c16d01044f31e9f0d2ca73720be"] :db/ensure [:answer-field/validate]} {:db/id "q-81581" :question/id #uuid "87c5b5b2-9628-59cb-9d0f-2102cae4eb6c" :question/math-academy-id "q-81581" :question/problem "What is the domain of the function $f(x)=\\operatorname{sec}⁡(x+{30}^{∘}),$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{sec}⁡x$ consists of all values where $\\operatorname{cos}⁡x\\ne 0,$ and is given by the expression\n\n$$\nx\\ne {90}^{∘}+n\\cdot {180}^{∘},\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{sec}⁡(x+{30}^{∘}),$ we replace the $x$ on the left-hand side of the above with $(x+{30}^{∘}).$ This gives\n\n$$\nx+{30}^{∘}\\ne {90}^{∘}+n\\cdot {180}^{∘}.\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x+{30}^{∘} & \\ne {90}^{∘}+n\\cdot {180}^{∘} \\\\ x & \\ne {60}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne {60}^{∘}+n\\cdot {180}^{∘},$ where $n$ is an integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81581/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ec59516-4ba6-5e62-b26a-bad36ea4448f"] :knowledge-point/questions ["q-81581"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-65962"] :question/worked-solution "The vertical asymptotes of the function $y=\\operatorname{csc}⁡x$ coincide with the zeros of $y=\\operatorname{sin}⁡x,$ and are given by the expression\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the vertical asymptotes of $\\operatorname{csc}⁡(4x+1)-2,$ we replace the $x$ on the left-hand side of the above with $(4x+1).$ This gives\n\n$$\n4x+1=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}4x+1 & =n\\pi  \\\\ 4x & =-1+n\\pi  \\\\ x & =-\\frac{1}{4}+\\frac{n\\pi }{4}.\\end{aligned}\n$$\n\nWe conclude that the expression giving all the vertical asymptotes is $x=-\\frac{1}{4}+\\frac{n\\pi }{4},$ where $n$ is an integer." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-66076/selection/3bf1d0086e7c96a138d448497c34fa3ddd4be8bfc8c41cf57a4de50ec214178f" :answer/id #uuid "df58192c-cf88-505c-a6f1-1e8cd2251882" :answer/type :answer.type/math :answer/value "x\\ne \\frac{4\\pi }{3}+5n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66076/selection/50653d6b3017e299bad8d6be94706e6d62093b9649c428be8de27797226b4ad4" :answer/id #uuid "b3cee646-2792-5356-a589-a8fcf2541b40" :answer/type :answer.type/math :answer/value "x\\ne \\frac{5\\pi }{6}+5n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66076/selection/bcb631626e056f5fa8585687564c1baa14707cfbd95b245c3de66e9685df5cc5" :answer/id #uuid "927bc6bf-3bf3-564c-a7fc-0f5cb201be73" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{3}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66076/selection/339aed4b3a166c9f2388244753cfdbe44c2f21b67f3914e241fb1476f0a6e41b" :answer/id #uuid "13657036-ac03-5d44-8f1b-28c12365374b" :answer/type :answer.type/math :answer/value "x\\ne \\frac{\\pi }{5}+4n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66076/selection/fab28b5fab32926f42118c47a3760445db4c4a1d796363feec771009e3af7dfc" :answer/id #uuid "0ca87c84-1bc4-546a-aae1-a257330c06ab" :answer/type :answer.type/math :answer/value "x\\ne \\frac{5\\pi }{2}+3n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66076/selection" :answer-field/id #uuid "c3396274-ed51-576a-aca2-bf352be50b21" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66076/selection/50653d6b3017e299bad8d6be94706e6d62093b9649c428be8de27797226b4ad4" :answer-field/choices ["q-66076/selection/3bf1d0086e7c96a138d448497c34fa3ddd4be8bfc8c41cf57a4de50ec214178f" "q-66076/selection/50653d6b3017e299bad8d6be94706e6d62093b9649c428be8de27797226b4ad4" "q-66076/selection/bcb631626e056f5fa8585687564c1baa14707cfbd95b245c3de66e9685df5cc5" "q-66076/selection/339aed4b3a166c9f2388244753cfdbe44c2f21b67f3914e241fb1476f0a6e41b" "q-66076/selection/fab28b5fab32926f42118c47a3760445db4c4a1d796363feec771009e3af7dfc"] :db/ensure [:answer-field/validate]} {:db/id "q-66076" :question/id #uuid "c980f4ec-2efe-53be-925c-7d487c183465" :question/math-academy-id "q-66076" :question/problem "What is the domain of the function $f(x)=\\frac{1}{2}\\operatorname{sec}⁡(\\frac{x}{5}+\\frac{\\pi }{3})-1?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{sec}⁡x$ consists of all values where $\\operatorname{cos}⁡x\\ne 0,$ and is given by the expression\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\frac{1}{2}\\operatorname{sec}⁡(\\frac{x}{5}+\\frac{\\pi }{3})-1,$ we replace the $x$ on the left-hand side of the above with $(\\frac{x}{5}+\\frac{\\pi }{3}).$ This gives\n\n$$\n\\frac{x}{5}+\\frac{\\pi }{3}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{5}+\\frac{\\pi }{3} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ \\frac{x}{5} & \\ne \\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{3} \\\\ \\frac{x}{5} & \\ne \\frac{\\pi }{6}+n\\pi  \\\\ x & \\ne \\frac{5\\pi }{6}+5n\\pi .\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{5\\pi }{6}+5n\\pi ,$ where $n$ is an integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-66076/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ec59516-4ba6-5e62-b26a-bad36ea4448f"] :knowledge-point/questions ["q-66076"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66033/selection/ead9790f7586f980fedd054a7c3d0622278661e7446130513d30e2e892d87cda" :answer/id #uuid "ddca5ab2-faa2-503e-8b87-679f68d0dc3c" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{3}+2n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66033/selection/86a69e1123cd49b8f47badb7db1c5f199c7da044b2e404fe99eab19a706ccc5a" :answer/id #uuid "5769d295-dfbf-5f3d-b9c8-8f68aef678e8" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66033/selection/332545aab042d2d5d4f3b8a9cf6e0a614bdbe3616bf359ebc31bedf0ff998d28" :answer/id #uuid "48738753-ce54-567f-b5fa-51dc18d68607" :answer/type :answer.type/math :answer/value "x=\\frac{2\\pi }{3}+n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66033/selection/ab384d69fb8bb98e6cddcb213218ff5cf589717172943dac9d8ac4e3aaf31bf3" :answer/id #uuid "5879de62-023a-570f-92e0-2c64f5dbbaff" :answer/type :answer.type/math :answer/value "x=2n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66033/selection/8fbda941bff61c7c12cfc255bc48dfccb7f5fdc7dcd5c8c2dc461be9d6120a96" :answer/id #uuid "099abe1e-ec73-5000-b967-b7e2043ab729" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2}+3n\\pi " :db/ensure [:answer/validate]} {:db/id "q-66033/selection" :answer-field/id #uuid "a883533c-b52f-575d-ac56-7edfaed0bd74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66033/selection/ead9790f7586f980fedd054a7c3d0622278661e7446130513d30e2e892d87cda" :answer-field/choices ["q-66033/selection/ead9790f7586f980fedd054a7c3d0622278661e7446130513d30e2e892d87cda" "q-66033/selection/86a69e1123cd49b8f47badb7db1c5f199c7da044b2e404fe99eab19a706ccc5a" "q-66033/selection/332545aab042d2d5d4f3b8a9cf6e0a614bdbe3616bf359ebc31bedf0ff998d28" "q-66033/selection/ab384d69fb8bb98e6cddcb213218ff5cf589717172943dac9d8ac4e3aaf31bf3" "q-66033/selection/8fbda941bff61c7c12cfc255bc48dfccb7f5fdc7dcd5c8c2dc461be9d6120a96"] :db/ensure [:answer-field/validate]} {:db/id "q-66033" :question/id #uuid "d2118398-ce16-51d0-88be-841a3fe7f905" :question/math-academy-id "q-66033" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\frac{1}{2}\\operatorname{sec}⁡(\\frac{x}{2}+\\frac{\\pi }{3})?$ Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{sec}⁡x$ coincide with the zeros of $y=\\operatorname{cos}⁡x,$ and are given by the following expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\frac{1}{2}\\operatorname{sec}⁡(\\frac{x}{2}+\\frac{\\pi }{3}),$ we replace the $x$ on the left-hand side of the above with $(\\frac{x}{2}+\\frac{\\pi }{3}).$ This gives\n\n$$\n\\frac{x}{2}+\\frac{\\pi }{3}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{2}+\\frac{\\pi }{3} & =\\frac{\\pi }{2}+n\\pi  \\\\ \\frac{x}{2} & =\\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{3} \\\\ \\frac{x}{2} & =\\frac{\\pi }{6}+n\\pi  \\\\ x & =\\frac{2\\cdot \\pi }{6}+2n\\pi  \\\\ x & =\\frac{\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nWe conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{3}+2n\\pi ,$ where $n$ is an integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66033/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ec59516-4ba6-5e62-b26a-bad36ea4448f"] :knowledge-point/questions ["q-66033"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117809/selection/f291cfebfc03ae909e3a597cc96d2fe26b9a49cd24f0fe6e99a2ff44481785ff" :answer/id #uuid "78f6a5e2-83b0-5df9-ac99-19f97f077bdb" :answer/type :answer.type/math :answer/value "x={120}^{∘}+n\\cdot {360}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-117809/selection/18357d1448b3664c3ecdb2b7eac617c096ec773d0774100cffdd17f6f1a6e7db" :answer/id #uuid "486f603c-98f8-5186-9e1a-7efb3e3ef667" :answer/type :answer.type/math :answer/value "x={240}^{∘}+n\\cdot {720}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-117809/selection/8a8b33bfd72700e3af3482c7633c363ca91f082be7747b8e0b686d97411ad8f8" :answer/id #uuid "473729c4-c52c-5557-900f-e662dbca0e55" :answer/type :answer.type/math :answer/value "x={240}^{∘}+n\\cdot {180}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-117809/selection/5aca102a85a06d536e1690e6b5f07d6d1214589724c7481082fb3e2ffe907e3c" :answer/id #uuid "e88541bc-44a2-5637-82be-6675bbc63d94" :answer/type :answer.type/math :answer/value "x={720}^{∘}+n\\cdot {360}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-117809/selection/f177eb80c068dcc19301467efaf595f13c383b7fd6e86967fa4c042a1d0d402f" :answer/id #uuid "40eb3c17-66ce-592a-9acf-4534274f1631" :answer/type :answer.type/math :answer/value "x={120}^{∘}+n\\cdot {240}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-117809/selection" :answer-field/id #uuid "3718ea6a-2e20-5820-a57e-24ca0c7cef5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-117809/selection/18357d1448b3664c3ecdb2b7eac617c096ec773d0774100cffdd17f6f1a6e7db" :answer-field/choices ["q-117809/selection/f291cfebfc03ae909e3a597cc96d2fe26b9a49cd24f0fe6e99a2ff44481785ff" "q-117809/selection/18357d1448b3664c3ecdb2b7eac617c096ec773d0774100cffdd17f6f1a6e7db" "q-117809/selection/8a8b33bfd72700e3af3482c7633c363ca91f082be7747b8e0b686d97411ad8f8" "q-117809/selection/5aca102a85a06d536e1690e6b5f07d6d1214589724c7481082fb3e2ffe907e3c" "q-117809/selection/f177eb80c068dcc19301467efaf595f13c383b7fd6e86967fa4c042a1d0d402f"] :db/ensure [:answer-field/validate]} {:db/id "q-117809" :question/id #uuid "b65d149d-e989-5d51-9258-2f05b2ccda04" :question/math-academy-id "q-117809" :question/problem "Which expression gives the vertical asymptotes of the function $f(x)=2\\operatorname{csc}⁡(\\frac{x}{4}-{60}^{∘}),$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The vertical asymptotes of the function $y=\\operatorname{csc}⁡x$ coincide with the zeros of $y=\\operatorname{sin}⁡x,$ and are given by the expression\n\n$$\nx=n\\cdot {180}^{∘},\n$$\n\nwhere $n$ is an integer.\n\nTo find the vertical asymptotes of $2\\operatorname{csc}⁡(\\frac{x}{4}-{60}^{∘}),$ we replace the $x$ on the left-hand side of the above with $(\\frac{x}{4}-{60}^{∘}).$ This gives\n\n$$\n\\frac{x}{4}-{60}^{∘}=n\\cdot {180}^{∘}.\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{4}-{60}^{∘} & =n\\cdot {180}^{∘} \\\\ \\frac{x}{4} & ={60}^{∘}+n\\cdot {180}^{∘} \\\\ x & =4\\cdot {60}^{∘}+4\\cdot n\\cdot {180}^{∘} \\\\ x & ={240}^{∘}+n\\cdot {720}^{∘}.\\end{aligned}\n$$\n\nWe conclude that the expression giving all the vertical asymptotes is $x={240}^{∘}+n\\cdot {720}^{∘},$ where $n$ is an integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-117809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ec59516-4ba6-5e62-b26a-bad36ea4448f"] :knowledge-point/questions ["q-117809"] :db/ensure [:knowledge-point/validate]}]
