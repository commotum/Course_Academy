d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5"] :db/ensure [:answer-field/validate]} {:db/id "q-117752" :question/id #uuid "2126f652-f5c8-5647-ab37-59c31ce6ad00" :question/math-academy-id "q-117752" :question/problem "Calculate the period of the function $y=-5\\operatorname{csc}⁡(\\frac{x}{6}-\\frac{\\pi }{4}).$" :question/worked-solution "Given a function of the form $y=A\\operatorname{csc}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{1}{6}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{1}{6})}=12\\pi .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-117752/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0b19d6e0-8a12-525d-8c80-ac2de8080830"] :knowledge-point/questions ["q-117752"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66028"] :question/worked-solution "Given a function of the form $y=A\\operatorname{sec}⁡(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=3.$ Therefore, the period is $\\frac{2\\pi }{3}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-65950/selection/13b0b1d589383e0e61c165ef36ac27ceb13f4749043804e9c76f8487c468ca3e" :answer/id #uuid "ae487f03-a07b-5905-9e44-5e4d5d8562bb" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-2]\\cup [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-65950/selection/74a968e27a10588b3d0f23cabe32ee02c5688c3566b4dcce9bfec08797389b5a" :answer/id #uuid "eea69c9b-baa4-5535-a1e8-21376467bd9f" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0]\\cup [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-65950/selection/0b5cb8e3f17ac0678019e2a95978cadaab15b57791baa6a89a97d488f676cd1b" :answer/id #uuid "881f85d9-fee7-5602-a809-9bc1580c5a91" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-2]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-65950/selection/574905d829c229098d03f5f80ebf95e94e5265e12cf23bc3928f9359b65d44be" :answer/id #uuid "27bd55e4-8ca9-558d-8509-0ef2f86c01fa" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-65950/selection/14e22820d8508b159400d9ac5d84cae39d63ce5fd09b53996295f94ebbe01792" :answer/id #uuid "47d44d87-5cb5-5ba6-9ed5-4975200cd061" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-1]\\cup [1,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-65950/selection" :answer-field/id #uuid "d15708cb-f416-5c1f-b9f2-986cafd6f9e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65950/selection/74a968e27a10588b3d0f23cabe32ee02c5688c3566b4dcce9bfec08797389b5a" :answer-field/choices ["q-65950/selection/13b0b1d589383e0e61c165ef36ac27ceb13f4749043804e9c76f8487c468ca3e" "q-65950/selection/74a968e27a10588b3d0f23cabe32ee02c5688c3566b4dcce9bfec08797389b5a" "q-65950/selection/0b5cb8e3f17ac0678019e2a95978cadaab15b57791baa6a89a97d488f676cd1b" "q-65950/selection/574905d829c229098d03f5f80ebf95e94e5265e12cf23bc3928f9359b65d44be" "q-65950/selection/14e22820d8508b159400d9ac5d84cae39d63ce5fd09b53996295f94ebbe01792"] :db/ensure [:answer-field/validate]} {:db/id "q-65950" :question/id #uuid "f89eb7d8-8dae-5a04-80fe-012d0776e04c" :question/math-academy-id "q-65950" :question/problem "Find the range of the function $f(x)=\\operatorname{csc}⁡(\\frac{x}{3})+1.$" :question/worked-solution "The range of $\\operatorname{csc}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(\\frac{x}{3})\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{csc}⁡(\\frac{x}{3})\\le -1,\\,\\operatorname{csc}⁡(\\frac{x}{3})\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- If we add $1$ to the first interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(\\frac{x}{3})\\le -1 \\\\  & \\operatorname{csc}⁡(\\frac{x}{3})+1\\le -1+1 \\\\  & \\operatorname{csc}⁡(\\frac{x}{3})+1\\le 0 \\\\  & f(x)\\le 0.\\end{aligned}\n$$\n\n- If we add $1$ to the second interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(\\frac{x}{3})\\ge 1 \\\\  & \\operatorname{csc}⁡(\\frac{x}{3})+1\\ge 1+1 \\\\  & \\operatorname{csc}⁡(\\frac{x}{3})+1\\ge 2 \\\\  & f(x)\\ge 2.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le 0,\\,f(x)\\ge 2.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,0]\\cup [2,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65950/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5"] :knowledge-point/questions ["q-65950"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81567/selection/98a4e89580d4381e79932873a77adb0bcd7641dfddbe40acfb0779189a1d3193" :answer/id #uuid "2e32f494-4fdc-5906-91ec-553df3f49c94" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0]\\cup [4,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81567/selection/9998ce4f4553ed6b918e6961e027a0396eb5782b7ac40e43828ee63a8513796f" :answer/id #uuid "9fc07b5c-dca5-5f79-bee6-87954a61d92a" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-4]\\cup [4,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81567/selection/94173a8132e11c3c27b2e145ea63d53f3a642c986683cfec2db2d764c97036b1" :answer/id #uuid "06a794bb-9873-539d-898e-236ee6541407" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-5]\\cup [-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81567/selection/e9c0093f55fd406fa6f7fd707e3da293cff35f2014805c758623a56d0b657635" :answer/id #uuid "65f02577-f730-50d5-9f14-098f4befc874" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-3]\\cup [5,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81567/selection/113f38bf03a4129df33f24a8a9c15dccea7a818f4380e7c5d4fd5a41c2b10661" :answer/id #uuid "4b8e760f-3a19-587b-8d46-09878bb8dc4a" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,3]\\cup [5,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81567/selection" :answer-field/id #uuid "44a522dc-e64d-5bb9-a000-f89de898ea44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81567/selection/113f38bf03a4129df33f24a8a9c15dccea7a818f4380e7c5d4fd5a41c2b10661" :answer-field/choices ["q-81567/selection/98a4e89580d4381e79932873a77adb0bcd7641dfddbe40acfb0779189a1d3193" "q-81567/selection/9998ce4f4553ed6b918e6961e027a0396eb5782b7ac40e43828ee63a8513796f" "q-81567/selection/94173a8132e11c3c27b2e145ea63d53f3a642c986683cfec2db2d764c97036b1" "q-81567/selection/e9c0093f55fd406fa6f7fd707e3da293cff35f2014805c758623a56d0b657635" "q-81567/selection/113f38bf03a4129df33f24a8a9c15dccea7a818f4380e7c5d4fd5a41c2b10661"] :db/ensure [:answer-field/validate]} {:db/id "q-81567" :question/id #uuid "7e459e49-98cd-5a2d-9766-6943742f02f3" :question/math-academy-id "q-81567" :question/problem "Find the range of the function $f(x)=\\operatorname{sec}⁡(2x-1)+4.$" :question/worked-solution "The range of $\\operatorname{sec}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(2x-1)\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{sec}⁡(2x-1)\\le -1,\\,\\operatorname{sec}⁡(2x-1)\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- If we add $4$ to the first interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\le -1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le -1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\le 3 \\\\  & f(x)\\le 3.\\end{aligned}\n$$\n\n- If we add $4$ to the second interval, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-1)\\ge 1 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 1+4 \\\\  & \\operatorname{sec}⁡(2x-1)+4\\ge 5 \\\\  & f(x)\\ge 5.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le 3,\\,f(x)\\ge 5.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,3]\\cup [5,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81567/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5"] :knowledge-point/questions ["q-81567"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66060/selection/f55ad53c8717ebb5c1e6d10ebc899374c03c329d07c0c17df3030da7b538d35d" :answer/id #uuid "608489c7-f179-5df8-a8d4-c1bdc3027881" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0]\\cup [1,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66060/selection/86e353d8a2924370145925d110b68555cd278e2e3e30b13c47081b43e0759a3c" :answer/id #uuid "75639471-30ca-50c4-9082-8aa60cad0486" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,1]\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66060/selection/0d4847ce82bea367dfdc8688e644091ad0fe2adb118d5511bdf2b4768c982517" :answer/id #uuid "dfa1526e-08e2-561d-a276-087ddc72a611" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0]\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66060/selection/f1fe5a64cb554f6aace89fd001cb36daf2340aab802eeadebaff09786b8ee802" :answer/id #uuid "737900ed-76bb-5be7-878b-10d376082fe4" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-1]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66060/selection/b21bc186ec145ebe092a4b15a12d769e9d6bc173418dc0b798281f8e714a7385" :answer/id #uuid "e1f6db9e-f9aa-5b0a-8674-f8258c65030c" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-8]\\cup [-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66060/selection" :answer-field/id #uuid "23f13610-67a5-51c5-a00f-c884e113da12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66060/selection/86e353d8a2924370145925d110b68555cd278e2e3e30b13c47081b43e0759a3c" :answer-field/choices ["q-66060/selection/f55ad53c8717ebb5c1e6d10ebc899374c03c329d07c0c17df3030da7b538d35d" "q-66060/selection/86e353d8a2924370145925d110b68555cd278e2e3e30b13c47081b43e0759a3c" "q-66060/selection/0d4847ce82bea367dfdc8688e644091ad0fe2adb118d5511bdf2b4768c982517" "q-66060/selection/f1fe5a64cb554f6aace89fd001cb36daf2340aab802eeadebaff09786b8ee802" "q-66060/selection/b21bc186ec145ebe092a4b15a12d769e9d6bc173418dc0b798281f8e714a7385"] :db/ensure [:answer-field/validate]} {:db/id "q-66060" :question/id #uuid "4dd7d3ff-dfe6-52ce-a1f9-ccab1e1260e7" :question/math-academy-id "q-66060" :question/problem "Find the range of the function $f(x)=-\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})+2.$" :question/worked-solution "The range of $\\operatorname{csc}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\le -1,\\,\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- Multiplying the first interval by $-1$ and adding $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\le -1 \\\\  & -\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\ge 1 \\\\  & -\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})+2\\ge 1+2 \\\\  & f(x)\\ge 3.\\end{aligned}\n$$\n\n- Multiplying the second interval by $-1$ and adding $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\ge 1 \\\\  & -\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})\\le -1 \\\\  & -\\operatorname{csc}⁡(2x-\\frac{\\pi }{4})+2\\le -1+2 \\\\  & f(x)\\le 1.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\ge 3,\\,f(x)\\le 1.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,1]\\cup [3,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66060/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5"] :knowledge-point/questions ["q-66060"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81568/selection/b1ca4bcf9aeaf84c32a857fb46327bf46e036fcfcb65ff5a5df44db43d6ac266" :answer/id #uuid "b1ed9330-4382-57e6-b955-2e3623d99227" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-3]\\cup [-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81568/selection/13b0b1d589383e0e61c165ef36ac27ceb13f4749043804e9c76f8487c468ca3e" :answer/id #uuid "e20a9cf1-2dda-5971-b6e8-c2d8b4e48654" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-2]\\cup [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81568/selection/86e353d8a2924370145925d110b68555cd278e2e3e30b13c47081b43e0759a3c" :answer/id #uuid "26a089fb-3b43-5cc9-8e3d-0ea6e14e72eb" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,1]\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81568/selection/f14fd7949bb29b29aec317b69ccd0b910291512574a08c90690e242a253ab5c2" :answer/id #uuid "f1fa8d91-18d1-5359-8512-96df77a26829" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-3]\\cup [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81568/selection/74a968e27a10588b3d0f23cabe32ee02c5688c3566b4dcce9bfec08797389b5a" :answer/id #uuid "a76d3c5a-a8ea-5cba-bf52-b4408e2b56c9" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,0]\\cup [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-81568/selection" :answer-field/id #uuid "11dbf014-d59a-5a90-8707-ed27ad4b9913" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81568/selection/13b0b1d589383e0e61c165ef36ac27ceb13f4749043804e9c76f8487c468ca3e" :answer-field/choices ["q-81568/selection/b1ca4bcf9aeaf84c32a857fb46327bf46e036fcfcb65ff5a5df44db43d6ac266" "q-81568/selection/13b0b1d589383e0e61c165ef36ac27ceb13f4749043804e9c76f8487c468ca3e" "q-81568/selection/86e353d8a2924370145925d110b68555cd278e2e3e30b13c47081b43e0759a3c" "q-81568/selection/f14fd7949bb29b29aec317b69ccd0b910291512574a08c90690e242a253ab5c2" "q-81568/selection/74a968e27a10588b3d0f23cabe32ee02c5688c3566b4dcce9bfec08797389b5a"] :db/ensure [:answer-field/validate]} {:db/id "q-81568" :question/id #uuid "0c8ae358-f972-53bf-a269-c0e71dace0ac" :question/math-academy-id "q-81568" :question/problem "Find the range of the function $f(x)=2\\operatorname{csc}⁡(4x+5).$" :question/worked-solution "The range of $\\operatorname{csc}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{csc}⁡(4x+5)\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{csc}⁡(4x+5)\\le -1,\\,\\operatorname{csc}⁡(4x+5)\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- Multiplying the first interval by $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(4x+5)\\le -1 \\\\  & 2\\operatorname{csc}⁡(4x+5)\\le -2 \\\\  & f(x)\\le -2.\\end{aligned}\n$$\n\n- Multiplying the second interval by $2,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{csc}⁡(4x+5)\\ge 1 \\\\  & 2\\operatorname{csc}⁡(4x+5)\\ge 2 \\\\  & f(x)\\ge 2.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le -2,\\,f(x)\\ge 2.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,-2]\\cup [2,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81568/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5"] :knowledge-point/questions ["q-81568"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66063/selection/bb5b684ad659e04246c084fd83be9a9fdf2d244ed5b602fddec589528e477a6e" :answer/id #uuid "fd485259-91bf-5783-9225-4da3d8d6cedc" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-\\frac{1}{3}]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66063/selection/76bd45ae36ff45648404de4d90ba0bd9f88a3fe3ca4398f740f99ba15adeabee" :answer/id #uuid "4c85e617-e800-53aa-839e-7586310ae6f5" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-1]\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66063/selection/42070c772d63151965310dba061a6896ce9f528c68c4f7531d2d29efb62d24e4" :answer/id #uuid "304abcfe-63c7-5b4f-bf5e-06200c7eae1e" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-\\frac{5}{3}]\\cup [-\\frac{1}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66063/selection/1375ab3877a513e658878790e356b3ae2711775617a2ee632f77c64bd55ec2cf" :answer/id #uuid "892fe9a9-ba39-54a7-b5ae-02901faff713" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-\\frac{5}{3}]\\cup [0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66063/selection/626fc29c82d0315f3f819f92dfa956491caded3c09b16fb722d906699efe36e8" :answer/id #uuid "095f89ec-eaae-59dc-8770-23ad0507c332" :answer/type :answer.type/math :answer/value "f(x)\\in (-\\infty ,-3]\\cup [-\\frac{1}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "q-66063/selection" :answer-field/id #uuid "dbef7a11-4358-51a1-917e-2386a92b5999" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66063/selection/42070c772d63151965310dba061a6896ce9f528c68c4f7531d2d29efb62d24e4" :answer-field/choices ["q-66063/selection/bb5b684ad659e04246c084fd83be9a9fdf2d244ed5b602fddec589528e477a6e" "q-66063/selection/76bd45ae36ff45648404de4d90ba0bd9f88a3fe3ca4398f740f99ba15adeabee" "q-66063/selection/42070c772d63151965310dba061a6896ce9f528c68c4f7531d2d29efb62d24e4" "q-66063/selection/1375ab3877a513e658878790e356b3ae2711775617a2ee632f77c64bd55ec2cf" "q-66063/selection/626fc29c82d0315f3f819f92dfa956491caded3c09b16fb722d906699efe36e8"] :db/ensure [:answer-field/validate]} {:db/id "q-66063" :question/id #uuid "d7579f66-27e1-5013-a0ad-1f18b27d3fbb" :question/math-academy-id "q-66063" :question/problem "Find the range of the function $f(x)=\\frac{2}{3}\\operatorname{sec}⁡(x-\\frac{\\pi }{6})-1.$" :question/worked-solution "The range of $\\operatorname{sec}⁡x$ consists of two intervals:\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty )\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nWe can split this into two inequalities:\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\le -1,\\,\\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\ge 1\n$$\n\nTo find the range of $f(x),$ we consider both intervals separately.\n\n- Multiplying the first interval by $\\frac{2}{3}$ and subtracting $1,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\le -1 \\\\  & \\frac{2}{3}\\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\le -\\frac{2}{3} \\\\  & \\frac{2}{3}\\operatorname{sec}⁡(x-\\frac{\\pi }{6})-1\\le -\\frac{2}{3}-1 \\\\  & f(x)\\le -\\frac{5}{3}.\\end{aligned}\n$$\n\n- Multiplying the second interval by $\\frac{2}{3}$ and subtracting $1,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\ge 1 \\\\  & \\frac{2}{3}\\operatorname{sec}⁡(x-\\frac{\\pi }{6})\\ge \\frac{2}{3} \\\\  & \\frac{2}{3}\\operatorname{sec}⁡(x-\\frac{\\pi }{6})-1\\ge \\frac{2}{3}-1 \\\\  & f(x)\\ge -\\frac{1}{3}.\\end{aligned}\n$$\n\nCombining both inequalities, we get\n\n$$\nf(x)\\le -\\frac{5}{3},\\,f(x)\\ge -\\frac{1}{3}.\n$$\n\nTherefore, we conclude that the range is $f(x)\\in (-\\infty ,-\\frac{5}{3}]\\cup [-\\frac{1}{3},\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66063/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8dbb426-dd34-5686-bde9-3ef9d246b5e5"] :knowledge-point/questions ["q-66063"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117805/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "7b4d0e8e-b30f-5398-aeaa-c00d0578b3dd" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-117805/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "99b9a290-2983-5b27-b6a4-4e7e46e01a62" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-117805/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "68c2f31d-4d70-5f0c-9f5e-457acd7e177a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-117805/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "aa539e41-59db-5122-9766-161cc53ffc8c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-117805/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f0b1222e-3cf8-561c-a758-28433f9f5096" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-117805/selection" :answer-field/id #uuid "d61a4433-272a-55d8-a18d-13c4cb48f55e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-117805/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-117805/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-117805/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-117805/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-117805/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-117805/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-117805" :question/id #uuid "21480c51-aecb-5236-ac1a-89a3c086f12e" :question/math-academy-id "q-117805" :question/problem "What is the value of $f(x)=4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1$ at its local maximum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are local maximums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1.\n$$\n\nMultiplying the above inequality by $4$ and adding $1$, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -1 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})\\le -4 \\\\  & 4\\operatorname{sec}⁡(x-\\frac{\\pi }{4})+1\\le -4+1 \\\\  & f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, $f(x)=-3$ at the local maximum points." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-117805/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce"] :knowledge-point/questions ["q-117805"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117804/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "84604926-e240-57c7-86d1-c86bfc6227b2" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-117804/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "0df1546e-a2ea-55aa-ad85-dae7c47cd365" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-117804/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "900193c8-00b1-577f-8191-1b05b59a9a21" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-117804/selection/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" :answer/id #uuid "42ac9ee6-4177-589d-b0b1-b9f40d904fb9" :answer/type :answer.type/math :answer/value "\\frac{11}{3}" :db/ensure [:answer/validate]} {:db/id "q-117804/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "b201738f-16b6-58df-94c9-16abac023274" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-117804/selection" :answer-field/id #uuid "5c0092d1-461c-55e7-82fa-af22fef96060" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-117804/selection/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" :answer-field/choices ["q-117804/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" "q-117804/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-117804/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-117804/selection/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" "q-117804/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-117804" :question/id #uuid "7364d6e7-5a70-5426-a169-e4770dee5ce3" :question/math-academy-id "q-117804" :question/problem "What is the value of $f(x)=-\\frac{2}{3}\\operatorname{sec}⁡(2x-\\frac{\\pi }{3})+3$ at its local minimum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are **local maximums** of the graph of $y=\\operatorname{sec}⁡x.$ For now, we're interested in the local maximums (not local minimums) of $y=\\operatorname{sec}⁡x$ because we see that $f(x)$ contains a vertical reflection.\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(2x-\\frac{\\pi }{3})\\le -1.\n$$\n\nMultiplying the above inequality by $-\\frac{2}{3}$ and adding $3,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(2x-\\frac{\\pi }{3})\\le -1 \\\\  & -\\frac{2}{3}\\operatorname{sec}⁡(2x-\\frac{\\pi }{3})\\ge \\frac{2}{3} \\\\  & -\\frac{2}{3}\\operatorname{sec}⁡(2x-\\frac{\\pi }{3})+3\\ge \\frac{2}{3}+3 \\\\  & -\\frac{2}{3}\\operatorname{sec}⁡(2x-\\frac{\\pi }{3})+3\\ge \\frac{11}{3} \\\\  & f(x)\\ge \\frac{11}{3}.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\frac{11}{3}$ at its local minimum points." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117804/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce"] :knowledge-point/questions ["q-117804"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-66083"] :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are local maximums of the graph of $y=\\operatorname{sec}⁡x.$ \n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(3x+\\frac{\\pi }{4})\\le -1.\n$$\n\nMultiplying the above inequality by $\\frac{1}{2}$ and adding $2$, we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(3x+\\frac{\\pi }{4})\\le -1 \\\\  & \\frac{1}{2}\\operatorname{sec}⁡(3x+\\frac{\\pi }{4})\\le -\\frac{1}{2} \\\\  & \\frac{1}{2}\\operatorname{sec}⁡(3x+\\frac{\\pi }{4})+2\\le -\\frac{1}{2}+2 \\\\  & f(x)\\le \\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\frac{3}{2}$ at the local maximum points." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-117807/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c02bced5-4d7f-5df5-a149-a3dbd06c5f21" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-117807/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "3a27ccc3-9711-56ed-a843-2604146cd5f8" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-117807/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "f61776da-7307-5e0c-a1ed-eb917e0814fc" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-117807/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "81521e07-f719-5253-8c43-ab5e4db54774" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-117807/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "1a2e4225-d5a5-5e02-a910-08bccbabee8d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-117807/selection" :answer-field/id #uuid "bd32fbe0-689e-5568-9530-7e22ce3b58ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-117807/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-117807/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-117807/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-117807/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-117807/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-117807/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-117807" :question/id #uuid "3c3a3b67-0e55-5588-a98d-f584bbd72fad" :question/math-academy-id "q-117807" :question/problem "What is the value of $f(x)=-3\\operatorname{sec}⁡(3x)-5$ at its local minimum points?" :question/worked-solution "On a negative branch of the graph of $y=\\operatorname{sec}⁡x,$ we have\n\n$$\n\\operatorname{sec}⁡x\\le -1.\n$$\n\nThe points where $\\operatorname{sec}⁡x=-1$ are **local maximums** of the graph of $y=\\operatorname{sec}⁡x.$ For now, we're interested in the local maximums (not local minimums) of $y=\\operatorname{sec}⁡x$ because we see that $f(x)$ contains a vertical reflection.\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n\\operatorname{sec}⁡(3x)\\le -1.\n$$\n\nMultiplying the above inequality by $-3$ and subtracting $5,$ we get\n\n$$\n\\begin{aligned} & \\operatorname{sec}⁡(3x)\\le -1 \\\\  & -3\\operatorname{sec}⁡(3x)\\ge 3 \\\\  & -3\\operatorname{sec}⁡(3x)-5\\ge 3-5 \\\\  & -3\\operatorname{sec}⁡(3x)-5\\ge -2 \\\\  & f(x)\\ge -2.\\end{aligned}\n$$\n\nTherefore, $f(x)=-2$ at its local minimum points." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-117807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5085a30f-a347-5ba8-80fd-102e4e0f37ce"] :knowledge-point/questions ["q-117807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-117803/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "32cdba5c-b325-5730-aa36-a0a14ab12142" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-117803/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "e991c5ea-32e8-561c-a9cb-e737aaea5588" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-117803/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "4e84e179-1b1d-5518-bd22-06a7c322fe3