#{[{:db/id #edb/ref 17592186320850 :knowledge-point/_questions [{:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723" :knowledge-point/title "Calculating the Position Vector of a Particle Moving With Constant Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80be0219-834e-56fc-a8eb-bf2311a6e204" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186320852} {:answer/id #uuid "eaa3662c-d120-5324-bca4-f373db03ff65" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186320853}] :answer-field/correct {:answer/id #uuid "80be0219-834e-56fc-a8eb-bf2311a6e204" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186320852} :answer-field/id #uuid "e7281faf-0adb-5606-bf19-8abe70b581c9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320851} {:answer-field/choices [{:answer/id #uuid "c5520887-5739-5ff9-b622-0fc71b1902f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186320855}] :answer-field/correct {:answer/id #uuid "c5520887-5739-5ff9-b622-0fc71b1902f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186320855} :answer-field/id #uuid "cb23decd-599e-567a-b9d1-b87335369f1a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320854}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "800eb994-8a3d-5bca-85e6-13c645924122" :question/math-academy-id "q-280515" :question/problem "A parcel robot begins at the position ${r}_{0}=(3i+2j)\\,\\text{cm}$ with an initial velocity of $(i-j)\\,\\text{cm/s}$ and a constant acceleration of $(2i+j)\\,{\\text{cm/s}}^{2}.$ Determine the position vector after $3$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{cm}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=3i+2j,\\,u=i-j,\\,a=2i+j.\n$$\n\nTherefore, the position vector of the parcel robot after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(3i+2j)+(i-j)(3)+\\frac{1}{2}(2i+j)(3)^{2} \\\\  & =(3i+2j)+(i-j)(3)+\\frac{1}{2}(18i+9j) \\\\  & =(3i+2j)+(3i-3j)+(9i+4.5j) \\\\  & =(\\,15\\,i+3.5\\,j)\\,\\text{cm}.\\end{aligned}\n$$"}]}
