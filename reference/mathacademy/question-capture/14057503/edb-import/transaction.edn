[{:db/id "q-136420/selection/9b4f20e17d39cb4971dac0a2cb7db4e7397aabd5a73c13e75cd483599a738590" :answer/id #uuid "c765db7a-de6c-5e95-ba4f-af2b9dfa5550" :answer/type :answer.type/math :answer/value "(12i+3j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136420/selection/3ec8e33510d5323b939866ff6b93e4d9a12863ceace73d927279449c8014bc92" :answer/id #uuid "9e271d03-575d-53f7-a911-d28ee31a9ca9" :answer/type :answer.type/math :answer/value "(12i-24j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136420/selection/c5b8c52f9df62804a68b872f61f901d859415ba9ca179ebb5566dc49cf54de4b" :answer/id #uuid "3c56c738-07d8-5b3d-993a-44e6b4faf029" :answer/type :answer.type/math :answer/value "(-3i+14j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136420/selection/6a56a059ab70c61f33f7156a33387f53ec2a50eca844376774ec2cf2413dbde6" :answer/id #uuid "8e2646e7-e672-5a84-8852-c9e0ece6e51d" :answer/type :answer.type/math :answer/value "(-6i-7j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136420/selection/9c506b7723b67389d5cf924936be50fa185f0fadda2babcfcea775fac69f7c7f" :answer/id #uuid "48a9a561-9eeb-5db0-9aed-453da0fabbd1" :answer/type :answer.type/math :answer/value "(8i+9j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136420/selection" :answer-field/id #uuid "5ce05379-5553-53c7-bb01-bb348be4c07a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136420/selection/3ec8e33510d5323b939866ff6b93e4d9a12863ceace73d927279449c8014bc92" :answer-field/choices ["q-136420/selection/9b4f20e17d39cb4971dac0a2cb7db4e7397aabd5a73c13e75cd483599a738590" "q-136420/selection/3ec8e33510d5323b939866ff6b93e4d9a12863ceace73d927279449c8014bc92" "q-136420/selection/c5b8c52f9df62804a68b872f61f901d859415ba9ca179ebb5566dc49cf54de4b" "q-136420/selection/6a56a059ab70c61f33f7156a33387f53ec2a50eca844376774ec2cf2413dbde6" "q-136420/selection/9c506b7723b67389d5cf924936be50fa185f0fadda2babcfcea775fac69f7c7f"] :db/ensure [:answer-field/validate]} {:db/id "q-136420" :question/id #uuid "9805007a-5f1e-509d-9451-dd0fb15d1de2" :question/math-academy-id "q-136420" :question/problem "A particle moves from the origin with an acceleration of $(2i-4j)\\,{\\text{in/s}}^{2}$ and an initial velocity of $(i-2j)\\,\\text{in/s}.$ Find the position vector of the particle after $3$ seconds." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=i-2j,\\,a=2i-4j.\n$$\n\nTherefore, the position vector of the particle after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(i-2j)(3)+\\frac{1}{2}(2i-4j)(3)^{2} \\\\  & =(3i-6j)+9(i-2j) \\\\  & =(3i-6j)+(9i-18j) \\\\  & =(12i-24j)\\,\\text{in}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136420/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-136420"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136442/selection/bb0f847837fe14e52248d2a787888c9da67d017d3fe51ec061ee149a0c6ab232" :answer/id #uuid "3e6d8e48-1a54-5b49-9eab-92684ee75bd7" :answer/type :answer.type/math :answer/value "8\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136442/selection/2f4616da3a2a97825561a6ff230ef06871c8c0895133642ffa30fcbdef4ba6d1" :answer/id #uuid "f763f6bc-176d-59e7-891b-1b97dd76260f" :answer/type :answer.type/math :answer/value "12\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136442/selection/41c700adc5da9d75146d3a5e5f8b71e0f398ad63e29862e4503b9c9b3aca91ba" :answer/id #uuid "78d6b874-05fa-527a-b09e-787ab7f097c8" :answer/type :answer.type/math :answer/value "4\\sqrt{6}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136442/selection/7b0bdd98122675259c7268bea465dd5d36d0a4926d86ab0ccaec3efa00f6fc8f" :answer/id #uuid "3572b64b-bf68-503f-a37d-203121ea9c19" :answer/type :answer.type/math :answer/value "\\sqrt{12}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136442/selection/39870f9852de7fcd1b5ddad1109b6344e5758e221c06a245b0028f68a0214f63" :answer/id #uuid "9254280c-8276-5f2b-98ab-5514d78cbbb2" :answer/type :answer.type/math :answer/value "\\sqrt{14}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "q-136442/selection" :answer-field/id #uuid "00372825-97b1-53b1-b8a2-9610496469a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136442/selection/2f4616da3a2a97825561a6ff230ef06871c8c0895133642ffa30fcbdef4ba6d1" :answer-field/choices ["q-136442/selection/bb0f847837fe14e52248d2a787888c9da67d017d3fe51ec061ee149a0c6ab232" "q-136442/selection/2f4616da3a2a97825561a6ff230ef06871c8c0895133642ffa30fcbdef4ba6d1" "q-136442/selection/41c700adc5da9d75146d3a5e5f8b71e0f398ad63e29862e4503b9c9b3aca91ba" "q-136442/selection/7b0bdd98122675259c7268bea465dd5d36d0a4926d86ab0ccaec3efa00f6fc8f" "q-136442/selection/39870f9852de7fcd1b5ddad1109b6344e5758e221c06a245b0028f68a0214f63"] :db/ensure [:answer-field/validate]} {:db/id "q-136442" :question/id #uuid "de2ee23a-84b8-57f6-8861-b47cf90097b3" :question/math-academy-id "q-136442" :question/problem "A particle moves from the origin with an acceleration of $(-2i+j)\\,{\\text{ft/s}}^{2}$ and an initial velocity of $(4i+j)\\,\\text{ft/s}.$ Find the distance from the particle to the origin after $4$ seconds." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=4i+j,\\,a=-2i+j.\n$$\n\nTherefore, the position vector of the particle after $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(4i+j)(4)+\\frac{1}{2}(-2i+j)(4)^{2} \\\\  & =(16i+4j)+8(-2i+j) \\\\  & =(16i+4j)+(-16i+8j) \\\\  & =12j\\,\\text{ft}.\\end{aligned}\n$$\n\nFinally, the distance from the particle to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|12j| \\\\  & =|12| \\\\  & =12\\,\\text{ft}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-136442/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-136442"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280521/field-1/386aeeb04ed085eaf1fd6e9cd223b07279ff45b8ac8a8c58e228b928da94ffa1" :answer/id #uuid "cc7c3a73-c051-5320-b6d9-d1c742969358" :answer/type :answer.type/math :answer/value "2\\sqrt{29}" :db/ensure [:answer/validate]} {:db/id "q-280521/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "322f90ee-5a4e-5818-a81e-012433718bab" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-280521/field-1" :answer-field/id #uuid "f8d4e799-d540-5a73-9421-bb3f497c6e73" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280521/field-1/386aeeb04ed085eaf1fd6e9cd223b07279ff45b8ac8a8c58e228b928da94ffa1" :answer-field/choices ["q-280521/field-1/386aeeb04ed085eaf1fd6e9cd223b07279ff45b8ac8a8c58e228b928da94ffa1" "q-280521/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-280521" :question/id #uuid "c1e61923-44f8-5da3-a12f-75078d76a376" :question/math-academy-id "q-280521" :question/problem "A delivery drone starts from the point with position vector $(1i+2j)\\,\\text{mi}$ and moves with a constant velocity of $(3i-2j)\\,\\text{mi/h}.$ Determine the distance $(|r|)$ from the drone to the origin after $3$ hours.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{mi}$" :question/worked-solution "If a particle moves with constant velocity $u,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=1i+2j,\\,u=3i-2j.\n$$\n\nTherefore, the position vector of the drone after $t=3\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(1i+2j)+(3i-2j)(3) \\\\  & =(1i+2j)+(9i-6j) \\\\  & =(10i-4j)\\,\\text{mi}.\\end{aligned}\n$$\n\nFinally, the distance from the drone to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|10i-4j| \\\\  & =\\sqrt{{10}^{2}+(-4)^{2}} \\\\  & =\\sqrt{100+16} \\\\  & =\\sqrt{116} \\\\  & =2\\sqrt{29}\\,\\text{mi}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280521/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280521"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280533/field-1/b1128125339400cbc1b52b2f514a4cc16a6339722908d17590b09a54fc6db411" :answer/id #uuid "f32853f3-7831-534b-9a86-e6e5de0b1675" :answer/type :answer.type/math :answer/value "2\\sqrt{26}" :db/ensure [:answer/validate]} {:db/id "q-280533/field-1" :answer-field/id #uuid "d46554d1-c8b7-57c6-8146-1442fe9a4719" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280533/field-1/b1128125339400cbc1b52b2f514a4cc16a6339722908d17590b09a54fc6db411" :answer-field/choices ["q-280533/field-1/b1128125339400cbc1b52b2f514a4cc16a6339722908d17590b09a54fc6db411"] :db/ensure [:answer-field/validate]} {:db/id "q-280533" :question/id #uuid "bcb455c9-26c8-584d-bb4c-1f9bcb5b3690" :question/math-academy-id "q-280533" :question/problem "An object moves from the origin with an acceleration of $(-2i+4j)\\,{\\text{m/s}}^{2}$ and an initial velocity of $(3i+j)\\,\\text{m/s}.$ Find the distance from the object to the origin$(|r|)$ after $2$ seconds.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=3i+j,\\,a=-2i+4j.\n$$\n\nTherefore, the position vector of the object after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(3i+j)(2)+\\frac{1}{2}(-2i+4j)(2)^{2} \\\\  & =(6i+2j)+\\frac{1}{2}(-8i+16j) \\\\  & =(6i+2j)+(-4i+8j) \\\\  & =(2i+10j)\\,\\text{m}.\\end{aligned}\n$$\n\nFinally, the distance from the object to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|2i+10j| \\\\  & =\\sqrt{{2}^{2}+{10}^{2}} \\\\  & =\\sqrt{4+100} \\\\  & =\\sqrt{104} \\\\  & =2\\sqrt{26}\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280533/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280533"] :db/ensure [:knowledge-point/validate]}]
