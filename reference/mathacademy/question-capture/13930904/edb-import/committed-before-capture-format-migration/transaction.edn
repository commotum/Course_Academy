 -\\infty }{x}^{3}.\\end{aligned}\n$$\n\nThe graph $y={x}^{3}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{3}=-\\infty .\n$$\n\nMultiplication by the positive constant $5$ does not affect the limit at infinity. So, we have\n\n$$\n\\begin{aligned} & =5\\cdot {lim}_{x\\to -\\infty }{x}^{3} \\\\  & ={lim}_{x\\to -\\infty }{x}^{3} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(5{x}^{3})=-\\infty .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a5bea806-2913-57f5-ba32-be7aeda5bd15"] :knowledge-point/questions ["q-35194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-300766/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "852eda5a-fccf-5472-a04a-a7347400b59b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-300766/field-1" :answer-field/id #uuid "dc1cfda2-7434-581d-b5b1-6dd349750668" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-300766/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-300766/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-300766" :question/id #uuid "a871e7e7-8cf4-59fa-8019-b14e04249778" :question/math-academy-id "q-300766" :question/is-example false :question/problem "If $p(x)=10{x}^{8}$ and $q(x)=2{x}^{8},$ then\n\n${lim}_{x\\to \\infty }\\frac{p(x)}{q(x)}=$\n{{field-1}}." :question/worked-solution "When we divide the two functions, we get a constant, and the limit of a constant is just the constant itself:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{p(x)}{q(x)} & ={lim}_{x\\to \\infty }\\frac{(10{x}^{8})}{(2{x}^{8})} \\\\  & ={lim}_{x\\to \\infty }5 \\\\  & =5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-300766/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6456693-8845-5f7b-8b0b-2d6802bbf72e"] :knowledge-point/questions ["q-300766"] :db/ensure [:knowledge-point/validate]} {:db/id "q-302056/field-1/bc335f80606fbb319477d8ace8b84b2b4748887a998543f786357e6a5233961b" :answer/id #uuid "195984d0-e524-5533-81eb-04e9a6d348c3" :answer/type :answer.type/math :answer/value "-\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "q-302056/field-1/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" :answer/id #uuid "feeb959e-4ffb-5c20-badf-48dd9b4cb091" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "q-302056/field-1" :answer-field/id #uuid "75bc54b5-f1d1-560b-859d-a9234d95610d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-302056/field-1/bc335f80606fbb319477d8ace8b84b2b4748887a998543f786357e6a5233961b" :answer-field/choices ["q-302056/field-1/bc335f80606fbb319477d8ace8b84b2b4748887a998543f786357e6a5233961b" "q-302056/field-1/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0"] :db/ensure [:answer-field/validate]} {:db/id "q-302056" :question/id #uuid "195543a3-3781-5c30-8836-03060a38637b" :question/math-academy-id "q-302056" :question/is-example false :question/problem "If $p(x)=-5{x}^{2}$ and $q(x)=9{x}^{6},$ then\n\n${lim}_{x\\to -\\infty }\\frac{{x}^{4}\\cdot p(x)}{q(x)}=$\n{{field-1}}." :question/worked-solution "First, let's calculate ${x}^{4}\\cdot p(x):$\n\n$$\n{x}^{4}\\cdot p(x)={x}^{4}\\cdot (-5{x}^{2})=-5{x}^{6}\n$$\n\nWhen we divide the two functions ${x}^{4}\\cdot p(x)$ and $q(x),$ we get a constant, and the limit of a constant is just the constant itself:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{4}\\cdot p(x)}{q(x)} & ={lim}_{x\\to -\\infty }\\frac{-5{x}^{6}}{(9{x}^{6})} \\\\  & ={lim}_{x\\to -\\infty }(-\\frac{5}{9}) \\\\  & =-\\frac{5}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-302056/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6456693-8845-5f7b-8b0b-2d6802bbf72e"] :knowledge-point/questions ["q-302056"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78074/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "f49c1039-5442-5fe2-ae3d-594318f589fe" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-78074/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "511608dc-14a7-580c-bf04-5a6beb6a21a6" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-78074/selection/852df530a82e413447a8b733db5e62e6c70e6d0be8b2e885cd815d17a6fb4ba1" :answer/id #uuid "b6d4bc8d-7cd1-5045-8274-3f2fbb0b38dc" :answer/type :answer.type/math :answer/value "-\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "q-78074/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "d3270d57-cb62-58c0-a7c5-e2f62cb86f17" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-78074/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "8d57f482-9914-5ecf-be66-8fe5cb9f61fb" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-78074/selection" :answer-field/id #uuid "3b9c9714-771c-5836-8b4d-459d9b82279e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78074/selection/852df530a82e413447a8b733db5e62e6c70e6d0be8b2e885cd815d17a6fb4ba1" :answer-field/choices ["q-78074/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-78074/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3b