[{:db/id "q-301609/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer/id #uuid "a3376395-9a94-5b75-9047-79428f921012" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "q-301609/field-1" :answer-field/id #uuid "a5b72fd8-9b2e-5568-b3c9-50fa449c0230" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-301609/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934" :answer-field/choices ["q-301609/field-1/e7bc415b91e8e2558c763c56ce6657ae30e51a7e3c0c90c1d4cd29cdacdf8934"] :db/ensure [:answer-field/validate]} {:db/id "q-301609" :question/id #uuid "501c8fcc-e277-5bee-85b9-ccc180b14c2c" :question/math-academy-id "q-301609" :question/is-example false :question/problem "${lim}_{x\\to \\infty }(ln⁡(0.9)\\cdot {x}^{4})=${{field-1}}" :question/worked-solution "First note that $ln⁡(0.9)<0.$\n\nThe graph $y={x}^{4}$ looks like an upward parabola, so\n\n$$\n{lim}_{x\\to \\infty }{x}^{4}=\\infty .\n$$\n\nHowever, multiplying by the negative coefficient $ln⁡(0.9)$ causes $y=ln⁡(0.9)\\cdot {x}^{4}$ to look more like a downward parabola. This changes the sign of the limit. Therefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(ln⁡(0.9)\\cdot {x}^{4})=-{lim}_{x\\to \\infty }({x}^{4})=-\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-301609/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4974097a-95c9-5835-ba1d-46480efab66b"] :knowledge-point/questions ["q-301609"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99275/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "76ad6d1c-8f7d-5cbe-b53e-9841bd998245" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-99275/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "7aaada08-2f17-57ff-8