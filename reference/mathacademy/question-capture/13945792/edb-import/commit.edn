eters in $18$ minutes." 13194139533802 true] [17592186252318 1000 #edb/ref 17592186252319 13194139533802 true] [17592186252318 1000 #edb/ref 17592186252320 13194139533802 true] [17592186252318 1000 #edb/ref 17592186252321 13194139533802 true] [17592186252318 1000 #edb/ref 17592186252322 13194139533802 true] [17592186252318 1000 #edb/ref 17592186252323 13194139533802 true] [17592186252318 1040 #edb/ref 17592186045450 13194139533802 true] [17592186252318 1041 "selection" 13194139533802 true] [17592186252318 1104 #edb/ref 17592186252323 13194139533802 true] [17592186252318 1110 #uuid "a9934997-3fe8-52f4-910b-65f6945221ea" 13194139533802 true] [17592186252319 1034 "$64$ centimeters" 13194139533802 true] [17592186252319 1103 #edb/ref 17592186045454 13194139533802 true] [17592186252319 1111 #uuid "a4311364-4e2c-573e-995b-18abc39f0f13" 13194139533802 true] [17592186252320 1034 "$72$ centimeters" 13194139533802 true] [17592186252320 1103 #edb/ref 17592186045454 13194139533802 true] [17592186252320 1111 #uuid "82205f40-f4ac-5d28-8a28-36e094cc4bc9" 13194139533802 true] [17592186252321 1034 "$90$ centimeters" 13194139533802 true] [17592186252321 1103 #edb/ref 17592186045454 13194139533802 true] [17592186252321 1111 #uuid "934135c8-6757-5991-ae58-f01df37cf4ef" 13194139533802 true] [17592186252322 1034 "$15$ centimeters" 13194139533802 true] [17592186252322 1103 #edb/ref 17592186045454 13194139533802 true] [17592186252322 1111 #uuid "dcfcd3e1-2486-5bc0-8369-58a1796c3340" 13194139533802 true] [17592186252323 1034 "$81$ centimeters" 13194139533802 true] [17592186252323 1103 #edb/ref 17592186045454 13194139533802 true] [17592186252323 1111 #uuid "cf47b419-d202-5088-976a-10854e3d8be7" 13194139533802 true]] :edb/tempids {"q-134157" 17592186252240 "q-134157/selection" 17592186252241 "q-134157/selection/0db7a712eb7dd94011160b7be3ea4a18110b96f4195dcabd574d0c2d25ad9290" 17592186252242 "q-134157/selection/3ef5cad5bd91e3b4ab5c496ee36b7cccd2b076fe79238c02dd0f5e6207f8fbf0" 17592186252243 "q-