ledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388"] :knowledge-point/questions ["q-134239"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134220/selection/551dcb98920c13590c0ffe3fc80db5b1396b331faed50df4fd77419c4067520f" :answer/id #uuid "15affebb-a5c9-5c5a-84e9-1e8def2986cb" :answer/type :answer.type/text :answer/value "$7$ minutes" :db/ensure [:answer/validate]} {:db/id "q-134220/selection/f603951e98cd93c13d8012d287bc6e5142040bf37af54ed9a72214cc88efc9bc" :answer/id #uuid "cd6ffe05-76fe-5542-921d-7cc3bb02835a" :answer/type :answer.type/text :answer/value "$6.5$ minutes" :db/ensure [:answer/validate]} {:db/id "q-134220/selection/57371beaa639b9ba099779b685b8739ba03364b1939a9dc42e7a38a4831e3c1b" :answer/id #uuid "851ecc83-3796-5091-b6b7-64a51b34a428" :answer/type :answer.type/text :answer/value "$5$ minutes" :db/ensure [:answer/validate]} {:db/id "q-134220/selection/690aa9e7ecabf2e774a2350dd2d026f445a4a2abfa5188cb9671998a3330d612" :answer/id #uuid "b5e92588-3e58-5285-9892-0f16502c6aab" :answer/type :answer.type/text :answer/value "$7.5$ minutes" :db/ensure [:answer/validate]} {:db/id "q-134220/selection/a89238ce5bdc1f8b4ac286d734141252f63c68a8a22fd372c5838774152a4f34" :answer/id #uuid "2f6eb34c-59b9-54c4-b62a-44bd6c7a4f9a" :answer/type :answer.type/text :answer/value "$6$ minutes" :db/ensure [:answer/validate]} {:db/id "q-134220/selection" :answer-field/id #uuid "8329817a-1f44-5b96-b94b-81461b3b15e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-134220/selection/a89238ce5bdc1f8b4ac286d734141252f63c68a8a22fd372c5838774152a4f34" :answer-field/choices ["q-134220/selection/551dcb98920c13590c0ffe3fc80db5b1396b331faed50df4fd77419c4067520f" "q-134220/selection/f603951e98cd93c13d8012d287bc6e5142040bf37af54ed9a72214cc88efc9bc" "q-134220/selection/57371beaa639b9ba099779b685b8739ba03364b1939a9dc42e7a38a4831e3c1b" "q-134220/selection/690aa9e7ecabf2e774a2350dd2d026f445a4a2abfa5188cb9671998a3330d612" "q-134220/selection/a89238ce5bdc1f8b4ac286d734141252f63c68a8a22fd372c5838774152a4f34"] :db/ensure [:answer-field/validate]} {:db/id "q-134220" :question/id #uuid "4d8eca12-8ae4-5d64-8287-abbf85b3fe38" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-134220/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388"] :knowledge-point/questions ["q-134220"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-134000"] :question/worked-solution "The speed is $40$ kilometers per hour. To find the time it took the bike to cover $240$ kilometers, we divide the distance by $40.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{240}{40} \\\\  & =\\frac{240÷10}{40÷10} \\\\  & =\\frac{24}{4} \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the bike was in motion for $6$ hours." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]}]
