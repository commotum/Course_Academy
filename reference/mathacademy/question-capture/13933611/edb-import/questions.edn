#{[{:db/id #edb/ref 17592186096343 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a" :knowledge-point/title "Differentiating a Quotient of Two Polynomials"}] :question/id #uuid "932c9b44-c040-5ae1-84f7-277767c255d4" :question/is-example true :question/math-academy-id "e-3637" :question/problem "Given that $f(x) = \\dfrac{x} {9x^2 + 5x}$, find $f'(x)$." :question/worked-solution "The numerator and denominator are $u(x) = x$ and\n\n$$\nv(x) = 9x^2 + 5x\n$$\n\nrespectively. Their derivatives are given by\n\n$$\n\\begin{aligned}\nu^{′}(x) &= 1, \\\\\nv^{′}(x) &= 18x + 5\n\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned} f'(x) & = \\dfrac {u'(x)\\cdot v(x) - u(x) v'(x)} {[v(x)]^2} \\\\ & = \\dfrac{\\left(9x^2+5x \\right)\\cdot 1 -x\\cdot \\left(18x+5 \\right)}{\\left(9x^2+5x\\right)^2} \\\\ & = \\dfrac{\\left(9x^2+5x-18x^2-5x \\right)}{\\left(9x^2+5x\\right)^2} \\\\ & = -\\dfrac{9x^2}{\\left(9x^2+5x\\right)^2}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096344 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/id #uuid "f804809a-22bf-5ab3-9775-3591d4581797" :question/is-example true :question/math-academy-id "e-3638" :question/problem "If $f(x)=\\dfrac{1+\\sin x}{x}$, find $f'(x)$." :question/worked-solution "In this case, the expression for $f(x)$ is a quotient\n\n$$\n\\dfrac{u(x)}{v(x)}\n$$\n\nwith\n\n$$\nu(x) = 1+\\sin x\n$$\n\nand $v(x) = x$.\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned} f'(x) & = \\dfrac{u'(x)\\cdot v(x) - u(x)\\cdot v'(x)}{[v(x)]^2} \\\\ & = \\dfrac{(1+\\sin x)'\\cdot (x) -(1+\\sin x)\\cdot (x)'}{x^2} \\\\ & = \\dfrac{\\cos x \\cdot x- (1+\\sin x)\\cdot 1}{x^2} \\\\ & = \\dfrac{x \\cos x -\\sin x -1}{x^2} \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096345 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/id #uuid "53d435ea-a20f-5216-8020-f36cdf8b7c36" :question/is-example true :question/math-academy-id "e-3639" :question/problem "Given that $y=\\dfrac{1}{3x+7}$, find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "Let $u=1$ and\n\n$$\nv=3x+7\n$$\n\nThen\n\n$$\n\\begin{aligned}\n\\frac{du}{dx} &= 0and\\frac{dv}{dx} = 3\n\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned} \\dfrac{\\textrm{d}y}{\\textrm{d}x} & = \\dfrac{v\\dfrac{\\textrm{d}u}{\\textrm{d}x}-u\\dfrac{\\textrm{d}v}{\\textrm{d}x}}{v^2} \\\\ & = \\dfrac{\\left(3x+7 \\right) \\cdot 0 -1\\cdot 3}{\\left(3x+7\\right)^2} \\\\ & = -\\dfrac{3}{\\left(3x+7\\right)^2}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096944 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a" :knowledge-point/title "Differentiating a Quotient of Two Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2b527dc-47c3-557e-b54e-50e12575634a" :answer/type {:db/ident :answer.type/math} :answer/value "(8)/(9(4x - 9)^{2})" :db/id #edb/ref 17592186094071} {:answer/id #uuid "b400bdd0-1dd0-585c-976a-bd2989d5754a" :answer/type {:db/ident :answer.type/math} :answer/value "(8)/((4x - 9)^{2})" :db/id #edb/ref 17592186094072} {:answer/id #uuid "08130f14-95e1-5726-aaf5-0f12cfa666b2" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/((4x - 9)^{2})" :db/id #edb/ref 17592186094073} {:answer/id #uuid "1be4ccde-e804-56f3-a8ed-62431afc847f" :answer/type {:db/ident :answer.type/math} :answer/value "- (4)/((4x - 9)^{2})" :db/id #edb/ref 17592186094074} {:answer/id #uuid "5c001c82-1347-5859-93b5-4d8525c6059b" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/((4x - 9)^{2})" :db/id #edb/ref 17592186094075}] :answer-field/correct {:answer/id #uuid "b400bdd0-1dd0-585c-976a-bd2989d5754a" :answer/type {:db/ident :answer.type/math} :answer/value "(8)/((4x - 9)^{2})" :db/id #edb/ref 17592186094072} :answer-field/id #uuid "28d03f72-fff4-5cb4-bf1d-3f8d8057d879" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094070}] :question/id #uuid "d1c28431-540b-52b0-8025-5bd41ef201c1" :question/is-example false :question/math-academy-id "q-11955" :question/problem "Given that $f(x) = \\frac{-2}{4x - 9}$, find $f^{′}(x)$."}]}
