[{:db/id "q-340287/field-1/b753f44036f98af33606c0f6656e2006fa8b8705b88c11cf858a8c8dc364f8bb" :answer/id #uuid "601321da-3a40-5bfa-81e2-b522b0f855f3" :answer/type :answer.type/math :answer/value "-\\frac{1}{(x+1)^2}" :db/ensure [:answer/validate]} {:db/id "q-340287/field-1" :answer-field/id #uuid "e774d3ca-4f14-5eb4-883a-17e689ce4413" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340287/field-1/b753f44036f98af33606c0f6656e2006fa8b8705b88c11cf858a8c8dc364f8bb" :answer-field/choices ["q-340287/field-1/b753f44036f98af33606c0f6656e2006fa8b8705b88c11cf858a8c8dc364f8bb"] :db/ensure [:answer-field/validate]} {:db/id "q-340287" :question/id #uuid "0bcdf15a-4cbd-5e2a-b54c-bb42ecd73867" :question/math-academy-id "q-340287" :question/is-example false :question/problem "Given that $f(x)=\\frac{1}{x+1}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=1$ and $v(x)=x+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =0, \\\\ {v}^{′}(x) & =1.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{0\\cdot (x+1)-1\\cdot 1}{{(x+1)}^{2}} \\\\  & =\\frac{-1}{{(x+1)}^{2}} \\\\  & =-\\frac{1}{{(x+1)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340287/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a"] :knowledge-point/questions ["q-340287"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340298/field-1/e55c1bb263f92a4c165f1fbfe091a6ffa4db3c278b8f84297c2e8a6693a1f9f2" :answer/id #uuid "2e71560a-cc7e-5d82-bc8b-5993bde15a97" :answer/type :answer.type/math :answer/value "\\frac{x^2+2x}{(x+1)^2}" :db/ensure [:answer/validate]} {:db/id "q-340298/field-1/174bf8e0dce5e65ef9c56590b7ca6a6d7dd3099ecc5f7f78d97cf98f54d5f61e" :answer/id #uuid "080dc689-c096-5e77-8c99-239887c9242c" :answer/type :answer.type/math :answer/value "\\frac{2x}{x+1}" :db/ensure [:answer/validate]} {:db/id "q-340298/field-1" :answer-field/id #uuid "720b458f-adf1-54e0-9048-e68146bb3509" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340298/field-1/e55c1bb263f92a4c165f1fbfe091a6ffa4db3c278b8f84297c2e8a6693a1f9f2" :answer-field/choices ["q-340298/field-1/e55c1bb263f92a4c165f1fbfe091a6ffa4db3c278b8f84297c2e8a6693a1f9f2" "q-340298/field-1/174bf8e0dce5e65ef9c56590b7ca6a6d7dd3099ecc5f7f78d97cf98f54d5f61e"] :db/ensure [:answer-field/validate]} {:db/id "q-340298" :question/id #uuid "ae6cc89e-3642-55c0-b50e-0e24c18e5309" :question/math-academy-id "q-340298" :question/is-example false :question/problem "Given that $f(x)=\\frac{{x}^{2}}{x+1}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)={x}^{2}$ and $v(x)=x+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =2x, \\\\ {v}^{′}(x) & =1.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{2x\\cdot (x+1)-{x}^{2}\\cdot 1}{{(x+1)}^{2}} \\\\  & =\\frac{2{x}^{2}+2x-{x}^{2}}{{(x+1)}^{2}} \\\\  & =\\frac{{x}^{2}+2x}{(x+1)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340298/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a"] :knowledge-point/questions ["q-340298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11955/selection/4a63ddfcbb7213432a977d419169e89c1654c182c9257ee8ead8e71227d91141" :answer/id #uuid "19f23363-bfb1-59af-bb57-febf515ba106" :answer/type :answer.type/math :answer/value "-\\frac{4}{{(4x-9)}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186094070 :answer-field/choices ["q-11955/selection/4a63ddfcbb7213432a977d419169e89c1654c182c9257ee8ead8e71227d91141"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-11955"] :question/worked-solution "The numerator and denominator are $u(x)=-2$ and $v(x)=4x-9,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{′}(x) & =0, \\\\ {v}^{′}(x) & =4.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x){v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(0)\\cdot (4x-9)-(-2)\\cdot (4)}{{(4x-9)}^{2}} \\\\  & =\\frac{8}{{(4x-9)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-340303/field-1/bef0365ee83998b09ad3e476f56da0443ace2227597af407c2f6878fd5a206e8" :answer/id #uuid "89254210-8e05-5c05-ae2b-cdca4f61c592" :answer/type :answer.type/math :answer/value "\\frac{1-x^2}{(x^2+1)^2}" :db/ensure [:answer/validate]} {:db/id "q-340303/field-1/c54b95c6f69c699543d5988896529e5554cf17ee74eca05868e3cd49895c2888" :answer/id #uuid "001ae8db-408b-58b4-8d07-c5025e8f84e5" :answer/type :answer.type/math :answer/value "\\frac{1}{x^2+1}" :db/ensure [:answer/validate]} {:db/id "q-340303/field-1" :answer-field/id #uuid "8e7c09fa-adca-5a81-8803-6a3873fc9709" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340303/field-1/bef0365ee83998b09ad3e476f56da0443ace2227597af407c2f6878fd5a206e8" :answer-field/choices ["q-340303/field-1/bef0365ee83998b09ad3e476f56da0443ace2227597af407c2f6878fd5a206e8" "q-340303/field-1/c54b95c6f69c699543d5988896529e5554cf17ee74eca05868e3cd49895c2888"] :db/ensure [:answer-field/validate]} {:db/id "q-340303" :question/id #uuid "64f15d3a-2a84-55ee-80eb-8a4dd1f8317c" :question/math-academy-id "q-340303" :question/is-example false :question/problem "Given that $f(x)=\\frac{x}{{x}^{2}+1},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=x$ and $v(x)={x}^{2}+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =1, \\\\ {v}^{′}(x) & =2x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{1\\cdot ({x}^{2}+1)-x\\cdot (2x)}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{{x}^{2}+1-2{x}^{2}}{({x}^{2}+1)^{2}} \\\\  & =\\frac{1-{x}^{2}}{({x}^{2}+1)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340303/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a"] :knowledge-point/questions ["q-340303"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340297/field-1/1b612db70718561089938339b66aee1d4576480fe15f90f69c93eb76d6785e80" :answer/id #uuid "a9051a2d-03b5-549f-aea7-978baaf6b1c5" :answer/type :answer.type/math :answer/value "\\frac{6}{(1-3x)^2}" :db/ensure [:answer/validate]} {:db/id "q-340297/field-1" :answer-field/id #uuid "a4b5cddb-528f-552c-82be-44035079905f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340297/field-1/1b612db70718561089938339b66aee1d4576480fe15f90f69c93eb76d6785e80" :answer-field/choices ["q-340297/field-1/1b612db70718561089938339b66aee1d4576480fe15f90f69c93eb76d6785e80"] :db/ensure [:answer-field/validate]} {:db/id "q-340297" :question/id #uuid "3f08699e-4c5f-5296-a9b9-ba2c2100c6eb" :question/math-academy-id "q-340297" :question/is-example false :question/problem "Given that $f(x)=\\frac{6x}{1-3x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=6x$ and $v(x)=1-3x,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =6, \\\\ {v}^{′}(x) & =-3.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{6\\cdot (1-3x)-6x\\cdot (-3)}{{(1-3x)}^{2}} \\\\  & =\\frac{6-18x+18x}{{(1-3x)}^{2}} \\\\  & =\\frac{6}{{(1-3x)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340297/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a"] :knowledge-point/questions ["q-340297"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47998/selection/940d1622de8ef93e8f1ef993372082c79fc7fc24e97a0b7eeb6fe3d3757f4d35" :answer/id #uuid "f2360488-1c3d-5736-8e6f-103d14970afc" :answer/type :answer.type/math :answer/value "\\frac{2xcos⁡x-xsin⁡x}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-47998/selection/4f216954bb9d3a2cc51c76ff8d5976fda8389847dfd8ded34a023b144fdc1d8e" :answer/id #uuid "8ae63e1b-8b68-5c03-a6f0-c4212a527ce8" :answer/type :answer.type/math :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-47998/selection/f21ddebe79afc8b733adfc6817fd9fa40a20af453734643d92b2a94c11e335d8" :answer/id #uuid "eb8559b5-7421-5652-9381-d4ac81b25c26" :answer/type :answer.type/math :answer/value "\\frac{xsin⁡x-2cos⁡x}{{x}^{4}}" :db/ensure [:answer/validate]} {:db/id "q-47998/selection/dbc80f251f135d7fe401b4440c83f802481c3a0f17c924e817398ca318afb135" :answer/id #uuid "7908d653-6db4-5ecf-90ae-60d2aa0791c3" :answer/type :answer.type/math :answer/value "\\frac{cos⁡x-2xsin⁡x}{{x}^{4}}" :db/ensure [:answer/validate]} {:db/id "q-47998/selection/ce01a95acb8e482ed16849b869ea3672f5bc633062f22686d607bf6ecd9dab2f" :answer/id #uuid "67458985-f753-505f-b605-28b92746757c" :answer/type :answer.type/math :answer/value "\\frac{xcos⁡x+2sin⁡x}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-47998/selection" :answer-field/id #uuid "6fddd2bb-2483-5641-a797-6e8fb2801285" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47998/selection/4f216954bb9d3a2cc51c76ff8d5976fda8389847dfd8ded34a023b144fdc1d8e" :answer-field/choices ["q-47998/selection/940d1622de8ef93e8f1ef993372082c79fc7fc24e97a0b7eeb6fe3d3757f4d35" "q-47998/selection/4f216954bb9d3a2cc51c76ff8d5976fda8389847dfd8ded34a023b144fdc1d8e" "q-47998/selection/f21ddebe79afc8b733adfc6817fd9fa40a20af453734643d92b2a94c11e335d8" "q-47998/selection/dbc80f251f135d7fe401b4440c83f802481c3a0f17c924e817398ca318afb135" "q-47998/selection/ce01a95acb8e482ed16849b869ea3672f5bc633062f22686d607bf6ecd9dab2f"] :db/ensure [:answer-field/validate]} {:db/id "q-47998" :question/id #uuid "39cf9785-7156-54b5-b18c-4b20a6f8312d" :question/math-academy-id "q-47998" :question/is-example false :question/problem "If $f(x)=\\frac{sin⁡x}{{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)={x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot {x}^{2}-sin⁡x\\cdot ({x}^{2})^{′}}{({x}^{2})^{2}} \\\\  & =\\frac{{x}^{2}cos⁡x-2xsin⁡x}{{x}^{4}} \\\\  & =\\frac{x(xcos⁡x-2sin⁡x)}{{x}^{4}} \\\\  & =\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-47998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-47998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340316/field-1/edabb9555af51da592d186df32ddaa4851849ade10a22cdc9b3f9ad2db70153d" :answer/id #uuid "768adcc3-f732-59bc-bda9-c8863e9b9b80" :answer/type :answer.type/math :answer/value "-\\ln(2)" :db/ensure [:answer/validate]} {:db/id "q-340316/field-1" :answer-field/id #uuid "4382508f-68f9-5023-94d1-233e6dcfa872" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340316/field-1/edabb9555af51da592d186df32ddaa4851849ade10a22cdc9b3f9ad2db70153d" :answer-field/choices ["q-340316/field-1/edabb9555af51da592d186df32ddaa4851849ade10a22cdc9b3f9ad2db70153d"] :db/ensure [:answer-field/validate]} {:db/id "q-340316" :question/id #uuid "afab7cbd-9bae-59cf-85a9-207cce57fc21" :question/math-academy-id "q-340316" :question/is-example false :question/problem "If a curve $C$ is given by $y=\\frac{{2}^{x}}{{x}^{2}-1},$ calculate the slope of the tangent line to the curve at the point where $x=0.$\n\nThe slope at $x=0$ is\n{{field-1}}." :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={2}^{x}$ and $v(x)={x}^{2}-1.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{({2}^{x})}^{′}\\cdot ({x}^{2}-1)-{2}^{x}\\cdot {({x}^{2}-1)}^{′}}{{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{2}^{x}ln⁡2\\cdot ({x}^{2}-1)-{2}^{x}\\cdot 2x}{{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{2}^{x}[({x}^{2}-1)ln⁡2-2x]}{{({x}^{2}-1)}^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=0$ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}\\,(0) & =\\frac{{2}^{0}[({0}^{2}-1)ln⁡2-2(0)]}{{({0}^{2}-1)}^{2}} \\\\  & =\\frac{-ln⁡2}{1} \\\\  & =-ln⁡2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line at $x=0$ is $-ln⁡2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340316/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-340316"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48504/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "28a54537-eb13-57a8-ac16-905896c9ad01" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-48504/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7b0d62ef-9c0a-55bd-87ac-8321d65b7d47" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-48504/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "2fa3c0f7-16b3-5fa1-ae21-982318d3123d" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-48504/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" :answer/id #uuid "e8890613-fa9b-5b43-bdff-e61465917e37" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "q-48504/selection/a7dd68b7f3e97d6127467da82186a4108a35d2bd1ccee4169390308f6afb9f5d" :answer/id #uuid "93357daa-9eb3-5146-8411-a96c6f922e37" :answer/type :answer.type/math :answer/value "\\frac{e}{2}" :db/ensure [:answer/validate]} {:db/id "q-48504/selection" :answer-field/id #uuid "86a15deb-1517-50a4-9dd9-81427a5bf99d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48504/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" :answer-field/choices ["q-48504/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-48504/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-48504/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-48504/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" "q-48504/selection/a7dd68b7f3e97d6127467da82186a4108a35d2bd1ccee4169390308f6afb9f5d"] :db/ensure [:answer-field/validate]} {:db/id "q-48504" :question/id #uuid "aab620f7-092f-5876-b6a6-8f264baccc17" :question/math-academy-id "q-48504" :question/is-example false :question/problem "If a curve $C$ is given by $y=\\frac{{x}^{2}}{ln⁡(x)},$ calculate the slope of the tangent line to the curve at the point where $x=e.$" :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=ln⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot ln⁡x-{x}^{2}\\cdot (ln⁡x)^{′}}{(ln⁡x)^{2}} \\\\  & =\\frac{2x\\cdot ln⁡(x)-{x}^{2}\\cdot (\\frac{1}{x})}{{(ln⁡(x))}^{2}} \\\\  & =\\frac{2x\\cdot ln⁡(x)-x}{{ln}^{2}⁡(x)} \\\\  & =\\frac{x(2ln⁡(x)-1)}{{ln}^{2}⁡(x)}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}{f}^{′}(e) & =\\frac{e(2ln⁡(e)-1)}{{ln}^{2}⁡(e)} \\\\  & =\\frac{e(2-1)}{{1}^{2}} \\\\  & =e.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $e.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48504/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-48504"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340308/field-1/eb95770d55723d8728dcda10501c075f509cde64b0e81f0654176616210c9e62" :answer/id #uuid "76998902-5504-5745-abfe-25d842c80a30" :answer/type :answer.type/math :answer/value "\\frac{x\\sec(x)^2-\\tan(x)}{x^2}" :db/ensure [:answer/validate]} {:db/id "q-340308/field-1" :answer-field/id #uuid "c6f889ba-dc51-5ba8-9916-8b2ae700bc74" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340308/field-1/eb95770d55723d8728dcda10501c075f509cde64b0e81f0654176616210c9e62" :answer-field/choices ["q-340308/field-1/eb95770d55723d8728dcda10501c075f509cde64b0e81f0654176616210c9e62"] :db/ensure [:answer-field/validate]} {:db/id "q-340308" :question/id #uuid "1ce97359-41b2-51ab-b4a2-db452de08f23" :question/math-academy-id "q-340308" :question/is-example false :question/problem "If $f(x)=\\frac{tan⁡x}{x}$,  find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=tan⁡x$ and $v(x)=x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(tan⁡x)^{′}\\cdot x-tan⁡x\\cdot (x)^{′}}{{x}^{2}} \\\\  & =\\frac{{sec}^{2}⁡x\\cdot x-tan⁡x\\cdot 1}{{x}^{2}} \\\\  & =\\frac{x{sec}^{2}⁡x-tan⁡x}{{x}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340308/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-340308"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340309/field-1/eeba9a3cadcd2dbac4aef86a8b29931e856e51e8514e04765db85f9f9c1a363b" :answer/id #uuid "588a6e18-a9a2-5e4e-ab09-adea34a83484" :answer/type :answer.type/math :answer/value "\\frac{\\sin(x)-x\\cos(x)}{\\sin(x)^2}" :db/ensure [:answer/validate]} {:db/id "q-340309/field-1" :answer-field/id #uuid "728a2b30-c023-566d-b973-d9147ac73629" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340309/field-1/eeba9a3cadcd2dbac4aef86a8b29931e856e51e8514e04765db85f9f9c1a363b" :answer-field/choices ["q-340309/field-1/eeba9a3cadcd2dbac4aef86a8b29931e856e51e8514e04765db85f9f9c1a363b"] :db/ensure [:answer-field/validate]} {:db/id "q-340309" :question/id #uuid "9fc10846-a912-5134-aaff-be58e15672f8" :question/math-academy-id "q-340309" :question/is-example false :question/problem "If $f(x)=\\frac{x}{sin⁡x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=x$ and $v(x)=sin⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(x)^{′}\\cdot sin⁡x-x\\cdot (sin⁡x)^{′}}{{(sin⁡x)}^{2}} \\\\  & =\\frac{1\\cdot sin⁡x-x\\cdot cos⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{sin⁡x-xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340309/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354"] :knowledge-point/questions ["q-340309"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340337/field-1/f914106b33a9bb4705b48c676637780078268e8a7b3bc953fb8f860203dfe273" :answer/id #uuid "afe1f179-2405-5330-ad28-9f29d774034b" :answer/type :answer.type/math :answer/value "\\cos(x)+x\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-340337/field-1" :answer-field/id #uuid "e8e5d521-168d-526f-bc55-5f8d602524b5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340337/field-1/f914106b33a9bb4705b48c676637780078268e8a7b3bc953fb8f860203dfe273" :answer-field/choices ["q-340337/field-1/f914106b33a9bb4705b48c676637780078268e8a7b3bc953fb8f860203dfe273"] :db/ensure [:answer-field/validate]} {:db/id "q-340337" :question/id #uuid "43e2e3a5-2c50-5c01-a796-32399b007fa6" :question/math-academy-id "q-340337" :question/is-example false :question/problem "Given that $y=\\frac{x}{cos⁡x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{cos}^{2}⁡x}\\cdot ($\n{{field-1}}\n$).$" :question/worked-solution "Let $u=x$ and $v=cos⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{cos⁡x\\cdot 1-x\\cdot (-sin⁡x)}{{cos}^{2}⁡x} \\\\  & =\\frac{1}{{cos}^{2}⁡x}\\cdot (cos⁡x+xsin⁡x\\,).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340337/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-340337"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11969/selection/07d1813c03b0ef5c9a89c9b919d3549ab72459dedba28bc100d140e27519b5bd" :answer/id #uuid "544d7fd2-d7d4-5086-b631-fc0075a36068" :answer/type :answer.type/math :answer/value "\\frac{4x-9}{{(9-2x)}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-11969/selection/75b3798417bf903e1704cefc7bf4d6e2187ebd80760c049cc377349b4ddc66fd" :answer/id #uuid "0ca29b98-cef7-552e-9c70-a420c89afdcc" :answer/type :answer.type/math :answer/value "-\\frac{4x-9}{{(9-2x)}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-11969/selection/1c455faa39d6eea486ca74f6c829da9a2f631157122d7bfdd65fa840e84c4c23" :answer/id #uuid "d37bcade-6db8-554c-bff8-84992a8cecfc" :answer/type :answer.type/math :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-11969/selection/9d2deabbbd697722f1e47ffa22c560135b411ea4cf2b4dc41505670bcc0009bc" :answer/id #uuid "68b37c79-8edd-52a0-b4c4-33c370ac22f3" :answer/type :answer.type/math :answer/value "-\\frac{2x-9}{{(9-2x)}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-11969/selection/164b3e5849819fee8a431a50c2b8603dc9a8df00aeef8d83a4a585cb26dccc5d" :answer/id #uuid "2ef14ca3-6a32-53cf-aef5-0656754dd075" :answer/type :answer.type/math :answer/value "\\frac{9}{{(9-2x)}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-11969/selection" :answer-field/id #uuid "ca8eecf0-cb60-5559-8d94-2aec89d8659f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11969/selection/1c455faa39d6eea486ca74f6c829da9a2f631157122d7bfdd65fa840e84c4c23" :answer-field/choices ["q-11969/selection/07d1813c03b0ef5c9a89c9b919d3549ab72459dedba28bc100d140e27519b5bd" "q-11969/selection/75b3798417bf903e1704cefc7bf4d6e2187ebd80760c049cc377349b4ddc66fd" "q-11969/selection/1c455faa39d6eea486ca74f6c829da9a2f631157122d7bfdd65fa840e84c4c23" "q-11969/selection/9d2deabbbd697722f1e47ffa22c560135b411ea4cf2b4dc41505670bcc0009bc" "q-11969/selection/164b3e5849819fee8a431a50c2b8603dc9a8df00aeef8d83a4a585cb26dccc5d"] :db/ensure [:answer-field/validate]} {:db/id "q-11969" :question/id #uuid "4c943def-8bb8-53a4-bbd8-db085bf164ee" :question/math-academy-id "q-11969" :question/is-example false :question/problem "Given that $y=\\frac{-x}{9-2x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=-x$ and $v=9-2x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-2.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(9-2x)\\cdot (-1)-(-x)\\cdot (-2)}{{(9-2x)}^{2}} \\\\  & =\\frac{-9+2x-2x}{{(9-2x)}^{2}} \\\\  & =-\\frac{9}{{(9-2x)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11969/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-11969"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340343/field-1/420d4c53cf819d4575b9ee8d0debb1e349402e69a5d93cbd05fb0aa6c9a35578" :answer/id #uuid "637d2285-4874-5e27-ad86-48379b35db1b" :answer/type :answer.type/math :answer/value "1-2\\ln(x)" :db/ensure [:answer/validate]} {:db/id "q-340343/field-1" :answer-field/id #uuid "cd7d34c3-8951-5cd6-b475-ee4fdf33fdbb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340343/field-1/420d4c53cf819d4575b9ee8d0debb1e349402e69a5d93cbd05fb0aa6c9a35578" :answer-field/choices ["q-340343/field-1/420d4c53cf819d4575b9ee8d0debb1e349402e69a5d93cbd05fb0aa6c9a35578"] :db/ensure [:answer-field/validate]} {:db/id "q-340343" :question/id #uuid "8b8638ce-6889-5b10-aea1-264e085666e2" :question/math-academy-id "q-340343" :question/is-example false :question/problem "Given that $y=\\frac{{log}_{3}⁡x}{{x}^{2}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}}\n$)\\cdot \\frac{1}{{x}^{3}ln⁡3}$" :question/worked-solution "Let $u={log}_{3}⁡x=\\frac{ln⁡x}{ln⁡3}$ and $v={x}^{2}.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =\\frac{1}{xln⁡3}\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}\\cdot \\frac{1}{xln⁡3}-\\frac{ln⁡x}{ln⁡3}\\cdot 2x)}{({x}^{2})^{2}} \\\\  & =\\frac{(\\frac{x}{ln⁡3}-\\frac{2xln⁡x}{ln⁡3})}{{x}^{4}} \\\\  & =\\frac{x-2xln⁡x}{{x}^{4}ln⁡3} \\\\  & =\\frac{x(1-2ln⁡x)}{{x}^{4}ln⁡3} \\\\  & =\\frac{1-2ln⁡x}{{x}^{3}ln⁡3} \\\\  & =(\\,1-2ln⁡x\\,)\\cdot \\frac{1}{{x}^{3}ln⁡3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340343/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-340343"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340335/field-1/a7761df8a061916eae326c91327c96a8eb560eb1ebc1f9e8c5615eb231e4b548" :answer/id #uuid "4b6b30aa-fe0e-5907-9d05-5f17605cf904" :answer/type :answer.type/math :answer/value "-\\frac{\\cos(x)}{\\sin(x)^2}" :db/ensure [:answer/validate]} {:db/id "q-340335/field-1/7a90069f5106471ebbf88fd8c9c51efc5ea2fbdd221dd75213a437600ec2fe52" :answer/id #uuid "dfe30e67-9c31-5a51-a83f-61c585e66ee0" :answer/type :answer.type/math :answer/value "\\frac{\\cos(x)}{\\sin(x)^2}" :db/ensure [:answer/validate]} {:db/id "q-340335/field-1" :answer-field/id #uuid "d00bb913-447e-5cd9-bd35-91573e4e5f72" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340335/field-1/a7761df8a061916eae326c91327c96a8eb560eb1ebc1f9e8c5615eb231e4b548" :answer-field/choices ["q-340335/field-1/a7761df8a061916eae326c91327c96a8eb560eb1ebc1f9e8c5615eb231e4b548" "q-340335/field-1/7a90069f5106471ebbf88fd8c9c51efc5ea2fbdd221dd75213a437600ec2fe52"] :db/ensure [:answer-field/validate]} {:db/id "q-340335" :question/id #uuid "1cdddbf1-a23e-50b9-8eb0-6097e93882fd" :question/math-academy-id "q-340335" :question/is-example false :question/problem "Given that $f(x)=\\frac{1-sin⁡x}{sin⁡x},$ find ${f}^{′}(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=1-sin⁡x$ and $v=sin⁡x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{sin⁡x\\cdot (-cos⁡x)-(1-sin⁡x)\\cdot cos⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x(-sin⁡x-1+sin⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x\\cdot (-1)}{{sin}^{2}⁡x} \\\\  & =-\\frac{1}{sin⁡x}\\cdot \\frac{cos⁡x}{sin⁡x} \\\\  & =-csc⁡xcot⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-340335/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-340335"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340341/field-1/63f8f585ec96c7722307fd56dffd0ba8a1f93f7aa49c2bc060ff894355be9a28" :answer/id #uuid "5a379761-86e2-5f1a-97da-17f466878f47" :answer/type :answer.type/math :answer/value "\\frac{\\ln(x)-1}{\\ln(x)^2}" :db/ensure [:answer/validate]} {:db/id "q-340341/field-1" :answer-field/id #uuid "6c781990-7027-54c9-b818-28466abc5ee3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340341/field-1/63f8f585ec96c7722307fd56dffd0ba8a1f93f7aa49c2bc060ff894355be9a28" :answer-field/choices ["q-340341/field-1/63f8f585ec96c7722307fd56dffd0ba8a1f93f7aa49c2bc060ff894355be9a28"] :db/ensure [:answer-field/validate]} {:db/id "q-340341" :question/id #uuid "4c8059f5-503e-549a-9404-bd9ae05e2ff6" :question/math-academy-id "q-340341" :question/is-example false :question/problem "Given that $y=\\frac{x}{ln⁡x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=x$ and $v=ln⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(ln⁡x\\cdot 1-x\\cdot \\frac{1}{x})}{{(ln⁡x)}^{2}} \\\\  & =\\frac{ln⁡x-1}{{(ln⁡x)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340341/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda"] :knowledge-point/questions ["q-340341"] :db/ensure [:knowledge-point/validate]}]
