0e0a5164886873a39e2d4dcf6552c7f89633940a" "q-108655/selection/e36d5cfd310d3d57764b17f4eb5cc1bc9264ee48eab08e4d6e16556a17e27738" "q-108655/selection/52f0531fed1eb7dd78bf36bfc76616be4d08d7eb18d47b286b86bac0ead320e7"] :db/ensure [:answer-field/validate]} {:db/id "q-108655" :question/id #uuid "3d1d6994-906a-5550-a2fb-3c16fb49d6c2" :question/math-academy-id "q-108655" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $7{x}^{3}{y}^{3}+3{y}^{2}=12{x}^{2}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $7{x}^{3}{y}^{3}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}7{x}^{3}{y}^{3}+3{y}^{2} & =12{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3}+3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3})+\\frac{\\text{d}}{\\text{d}x}(3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ [21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}]+6y\\frac{\\text{d}y}{\\text{d}x} & =24x \\\\ 21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x}(21{x}^{3}{y}^{2}+6y) & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-108655/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb"] :knowledge-point/questions ["q-108655"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72262/selection/9a411b28b8dfd8295460970c9ea0c859f596f100b6e23f04008d68dd3df5abea" :answer/id #uuid "2a7daaf2-2a39-530d-95f9-77db4a676275" :answer/type :answer.type/math :answer/value "\\frac{x-y}{x+3{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-72262/selection/6b190a3914cee3906cc77426cf2c8f940dda1d52e3c982a453b776e9c134cd3c" :answer/id #uuid "7616b0c2-2be7-52ff-8af5-ffea197e63e7" :answer/type :answer.type/math :answer/value "\\frac{x+y}{3x-6{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-72262/selection/1e6513987f917c9d4623869d2120bf2b5b628300a45e96c72c5a85dd69b20df4" :answer/id #uuid "8f0ebcb1-c9b1-578e-a637-7963fb5ce363" :answer/type :answer.type/math :answer/value "\\frac{x-2y}{x+12{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-72262/selection/57f78fbf96b73b0f6113de3dd6f47e26a0543025e69b905c3026b866f6c4d426" :answer/id #uuid "0061dc96-072a-57c0-b764-d641af5bc448" :answer/type :answer.type/math :answer/value "\\frac{x-y}{x+6{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-72262/selection/8de9da96dc8124d84ad18374d827943df80034d71090f364a7ecae3aa4e9126b" :answer/id #uuid "b6a2d671-915c-55fa-b29a-2d85c2c3b753" :answer/type :answer.type/math :answer/value "\\frac{x-y}{2x+12{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-72262/selection" :answer-field/id #uuid "9fabf7c7-db80-573b-80c0-2e7ce575fefe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72262/selection/57f78fbf96b73b0f6113de3dd6f47e26a0543025e69b905c3026b866f6c4d426" :answer-field/choices ["q-72262/selection/9a411b28b8dfd8295460970c9ea0c859f596f100b6e23f04008d68dd3df5abea" "q-72262/selection/6b190a3914cee3906cc77426cf2c8f940dda1d52e3c982a453b776e9c134cd3c" "q-72262/selection/1e6513987f917c9d4623869d2120bf2b5b628300a45e96c72c5a85dd69b20df4" "q-72262/selection/57f78fbf96b73b0f6113de3dd6f47e26a0543025e69b905c3026b866f6c4d426" "q-72262/selection/8de9da96dc8124d84ad18374d827943df80034d71090f364a7ecae3aa4e9126b"] :db/ensure [:answer-field/validate]} {:db/id "q-72262" :question/id #uuid "2ea99235-25dc-50d1-8b6b-8640c1a16529" :question/math-academy-id "q-72262" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $2xy+4{y}^{3}={x}^{2}-1.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $2xy$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2xy+4{y}^{3} & ={x}^{2}-1 \\\\ \\frac{\\text{d}}{\\text{d}x}(2xy+4{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-1) \\\\ \\frac{\\text{d}}{\\text{d}x}(2xy)+\\frac{\\text{d}}{\\text{d}x}(4{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-1) \\\\ [2x\\frac{\\text{d}y}{\\text{d}x}+2y]+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x \\\\ 2x\\frac{\\text{d}y}{\\text{d}x}+2y+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}2x\\frac{\\text{d}y}{\\text{d}x}+12{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =2x-2y \\\\ \\frac{\\text{d}y}{\\text{d}x}(2x+12{y}^{2}) & =2x-2y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x-2y}{2x+12{y}^{2}} \\\\  & =\\frac{x-y}{x+6{y}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72262/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb"] :knowledge-point/questions ["q-72262"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108640/selection/af30107332eda38a80866aee25e17907943b0995ef246a654fa08983a90aa744" :answer/id #uuid "a18de979-7ac2-5b79-853d-fe8c240bfebc" :answer/type :answer.type/math :answer/value "\\frac{18{x}^{2}-2x\\operatorname{sin}⁡(y)}{{y}^{3}+{x}^{2}\\operatorname{cos}⁡(y)}" :db/ensure [:answer/validate]} {:db/id "q-108640/selection/e3431e24248a823bfc46cf3a52a3e6c7d0edbc02eb6edd63e9292ca15f7088e1" :answer/id #uuid "df815fea-87ce-5f9c-b91c-06eeab8ef4e1" :answer/type :answer.type/math :answer/value "\\frac{18{x}^{2}-2x\\operatorname{cos}⁡(y)}{{y}^{2}-{x}^{2}\\operatorname{cos}⁡(y)}" :db/ensure [:answer/validate]} {:db/id "q-108640/selection/3968d0cdae81c39f911872b097e625c7523b2d5ea3fda4c4d3bdecea95714531" :answer/id #uuid "108910aa-4b5c-50a8-a9a2-fa326a8f0737" :answer/type :answer.type/math :answer/value "\\frac{18{x}^{2}-2x\\operatorname{cos}⁡(y)}{16{y}^{3}-{x}^{2}\\operatorname{sin}⁡(y)}" :db/ensure [:answer/validate]} {:db/id "q-108640/selection/d91cbdef2d5cefc5789df8ea94eb9fa9032aa13550dd2e15f3b326d87aefd222" :answer/id #uuid "4e825274-6e2d-5d50-b166-beb3f78e6a7a" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}-x\\operatorname{cos}⁡(y)}{{y}^{3}-{x}^{2}\\operatorname{sin}⁡(y)}" :db/ensure [:answer/validate]} {:db/id "q-108640/selection/4ae3afb7282a98aacac5d21500a32b76f17ca87b48b25963569da94a8883555a" :answer/id #uuid "1de795b1-10f4-5433-a992-db5764c61507" :answer/type :answer.type/math :answer/value "\\frac{18x-2x\\operatorname{cos}⁡(y)}{16{y}^{3}+x\\operatorname{sin}⁡(y)}" :db/ensure [:answer/validate]} {:db/id "q-108640/selection" :answer-field/id #uuid "f2517cec-86c9-5d85-b58a-77b704b1eb33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108640/selection/3968d0cdae81c39f911872b097e625c7523b2d5ea3fda4c4d3bdecea95714531" :answer-field/choices ["q-108640/selection/af30107332eda38a80866aee25e17907943b0995ef246a654fa08983a90aa744" "q-108640/selection/e3431e24248a823bfc46cf3a52a3e6c7d0edbc02eb6edd63e9292ca15f7088e1" "q-108640/selection/3968d0cdae81c39f911872b097e625c7523b2d5ea3fda4c4d3bdecea95714531" "q-108640/selection/d91cbdef2d5cefc5789df8ea94eb9fa9032aa13550dd2e15f3b326d87aefd222" "q-108640/selection/4ae3afb7282a98aacac5d21500a32b76f17ca87b48b25963569da94a8883555a"] :db/ensure [:answer-field/validate]} {:db/id "q-108640" :question/id #uuid "bef78af0-8941-5978-8eb2-ce80e83b63d3" :question/math-academy-id "q-108640" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}\\operatorname{cos}⁡(y)+4{y}^{4}=6{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n Note that to differentiate the ${x}^{2}\\operatorname{cos}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}\\operatorname{cos}⁡(y)+4{y}^{4}=6{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{cos}⁡(y)+4{y}^{4}) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}\\operatorname{cos}⁡(y))+\\frac{\\text{d}}{\\text{d}x}(4{y}^{4}) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{3}) \\\\ [{x}^{2}(-\\operatorname{sin}⁡(y)\\cdot \\frac{\\text{d}y}{\\text{d}x})+2x\\operatorname{cos}⁡(y)]+16{y}^{3}\\frac{\\text{d}y}{\\text{d}x} & =18{x}^{2} \\\\ -{x}^{2}\\operatorname{sin}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+2x\\operatorname{cos}⁡(y)+16{y}^{3}\\frac{\\text{d}y}{\\text{d}x} & =18{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}-{x}^{2}\\operatorname{sin}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+16{y}^{3}\\frac{\\text{d}y}{\\text{d}x} & =18{x}^{2}-2x\\operatorname{cos}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x}(16{y}^{3}-{x}^{2}\\operatorname{sin}⁡(y)) & =18{x}^{2}-2x\\operatorname{cos}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{18{x}^{2}-2x\\operatorname{cos}⁡(y)}{16{y}^{3}-{x}^{2}\\operatorname{sin}⁡(y)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-108640/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb"] :knowledge-point/questions ["q-108640"] :db/ensure [:knowledge-point/validate]} {:db/id "q-53745/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ffc56c95-4ba5-5d0f-9ff9-e937f52c3f79" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-53745/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6544c4ee-6b5a-5b70-98fa-27063b586f84" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-53745/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "a226a6d2-1362-5548-9c31-88ddaa628f87" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-53745/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "33c35d4b-b8a6-58fb-946b-60fc3841edc4" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-53745/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "7aa27835-773a-507b-b9a4-b037a51179df" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-53745/selection" :answer-field/id #uuid "13be0153-e06b-582a-8134-73dab919400c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-53745/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-53745/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-53745/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-53745/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-53745/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-53745/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-53745" :question/id #uuid "3c55237e-c942-5772-aab9-53dcc871dac4" :question/math-academy-id "q-53745" :question/problem "Find the slope of the tangent at the point $(1,\\,-1)$ for the curve ${x}^{2}y=-1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}y) & =\\frac{\\text{d}}{\\text{d}x}(-1) \\\\ {x}^{2}\\frac{\\text{d}}{\\text{d}x}(y)+y\\frac{\\text{d}}{\\text{d}x}({x}^{2}) & =0 \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x & =0 \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2xy}{{x}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2y}{x}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(1,\\,-1)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(1,\\,-1)} \\\\  & ={(-\\frac{2y}{x})}_{(1,\\,-1)} \\\\  & =-\\frac{2\\cdot (-1)}{1} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-53745/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372"] :knowledge-point/questions ["q-53745"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108679/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "9d337356-ad34-5553-9601-c3ffb9658add" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-108679/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "706779c4-d1f8-543e-84a8-9c835bea1c28" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-108679/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer/id #uuid "773dcd82-bc62-5c3d-8ed9-cde7368db04e" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-108679/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "7f3203eb-6a81-5954-ac08-00742873ade2" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-108679/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f55382ce-9a87-5ed6-8258-6e2cb0358ceb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-108679/selection" :answer-field/id #uuid "a6465dec-122c-5087-bdfa-b9c22343bb82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108679/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-108679/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-108679/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-108679/selection/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" "q-108679/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" "q-108679/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-108679" :question/id #uuid "cef3e42d-03e3-55a2-998b-078fdab2d8e0" :question/math-academy-id "q-108679" :question/problem "Find the slope of the tangent at the point $(4,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=4.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(4,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(4,\\,4)} \\\\  & =-{\\frac{\\sqrt{y}}{\\sqrt{x}}}_{(4,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{4}} \\\\  & =-\\frac{2}{2} \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-108679/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372"] :knowledge-point/questions ["q-108679"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341915/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "f5e87ee5-0c4a-5cfb-8b64-a340535c826d" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-341915/field-1" :answer-field/id #uuid "b95b92a0-3109-5324-bf41-0b1c873f9cef" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341915/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-341915/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-341915" :question/id #uuid "50d30d9c-6ebb-56fa-a396-2394eb5e50c7" :question/math-academy-id "q-341915" :question/problem "Find the slope $m$ of the tangent at the point $(16,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=6.$\n\n$m=$\n{{field-1}}" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(16,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(16,\\,4)} \\\\  & ={(-\\frac{\\sqrt{y}}{\\sqrt{x}})|}_{(16,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{16}} \\\\  & =-\\frac{2}{4} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341915/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372"] :knowledge-point/questions ["q-341915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108674/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "b7c319cd-6cc3-5fac-ac92-66b129d31df3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-108674/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "ffa1ea18-4820-5015-ab9d-2bba53e46456" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-108674/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "fd30544b-8548-53c9-afad-6fcd64142e69" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-108674/selection/c8cc0193c097b7d38e4091db7b8ea0b55b90f570b6dfeef91f6d5caca670d84e" :answer/id #uuid "64f0d3b6-dbbb-570b-b4fb-c15ce417db89" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{4}" :db/ensure [:answer/validate]} {:db/id "q-108674/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "ad1daaec-b025-54cc-af65-be869f572f27" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-108674/selection" :answer-field/id #uuid "effbd3bf-202d-501e-aa77-3bfc58e9d459" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108674/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer-field/choices ["q-108674/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-108674/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-108674/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-108674/selection/c8cc0193c097b7d38e4091db7b8ea0b55b90f570b6dfeef91f6d5caca670d84e" "q-108674/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629"] :db/ensure [:answer-field/validate]} {:db/id "q-108674" :question/id #uuid "2d523cf1-86db-5d18-b1bf-7afa6c18399b" :question/math-academy-id "q-108674" :question/problem "Find the slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ for the curve $y\\operatorname{cos}⁡(x)=1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $y\\operatorname{cos}⁡(x)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y\\operatorname{cos}⁡(x)) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ y\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))+\\operatorname{cos}⁡x\\frac{\\text{d}}{\\text{d}x}(y) & =0 \\\\ y(-\\operatorname{sin}⁡(x))+\\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(\\pi /3,\\,2)} \\\\  & ={(\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)})}_{(\\pi /3,\\,2)} \\\\  & =\\frac{2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})} \\\\  & =\\frac{2\\cdot (\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-108674/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372"] :knowledge-point/questions ["q-108674"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-53746"] :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $xy$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+xy-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(xy)-\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+x\\frac{\\text{d}y}{\\text{d}x}+y\\frac{\\text{d}}{\\text{d}x}(x)-2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2x+x\\frac{\\text{d}y}{\\text{d}x}+y-2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ (2x+y)+(x-2y)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x+y}{x-2y}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(0,\\,1)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(0,\\,1)} \\\\  & ={(-\\frac{2x+y}{x-2y})}_{(0,\\,1)} \\\\  & =-\\frac{2\\cdot 0+1}{0-2\\cdot 1} \\\\  & =-\\frac{0+1}{0-2} \\\\  & =-\\frac{1}{(-2)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-15130/selection/d1d3d3f9d66d483382b9e1c5c99d776e475f8fddbb4c5539b4a5ac58ea68c679" :answer/id #uuid "8800e18a-cd98-5083-8673-f6a5607cfb51" :answer/type :answer.type/math :answer/value "(-3,\\,0)" :db/ensure [:answer/validate]} {:db/id "q-15130/selection/b76aeb577ea3e142a3a9d4dd5fad008821ea9a9f763ae8f622427298f8e5c33c" :answer/id #uuid "bda95fc9-5266-52ea-bdfa-d379f2232812" :answer/type :answer.type/math :answer/value "(-4,\\,0)" :db/ensure [:answer/validate]} {:db/id "q-15130/selection/e24df726f0ca29bc814d06eeed8b860a6da0ad71cdbe5c654ec2197cd19db75a" :answer/id #uuid "e50f2a66-98b4-5180-b16e-e5cfffed03ad" :answer/type :answer.type/math :answer/value "(-6,\\,0)" :db/ensure [:answer/validate]} {:db/id "q-15130/selection/4ae004cc2b04c1e6a3ac6906df221c52f8f538845f48fea0658c6b062e33737f" :answer/id #uuid "0cc3834a-4af0-57a0-a427-4cd96682d558" :answer/type :answer.type/math :answer/value "(-1,\\,0)" :db/ensure [:answer/validate]} {:db/id "q-15130/selection/c4befa12b7c42701198b5a6e60db6c7ea3c4b3817a1e1a92ff66e6f13e2b1850" :answer/id #uuid "bfd9c231-36a2-5828-ba48-d7381e87a88d" :answer/type :answer.type/math :answer/value "(-2,\\,0)" :db/ensure [:answer/validate]} {:db/id "q-15130/selection" :answer-field/id #uuid "a76785b5-d035-5e65-b1b5-b9b62f5d6b9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15130/selection/b76aeb577ea3e142a3a9d4dd5fad008821ea9a9f763ae8f622427298f8e5c33c" :answer-field/choices ["q-15130/selection/d1d3d3f9d66d483382b9e1c5c99d776e475f8fddbb4c5539b4a5ac58ea68c679" "q-15130/selection/b76aeb577ea3e142a3a9d4dd5fad008821ea9a9f763ae8f622427298f8e5c33c" "q-15130/selection/e24df726f0ca29bc814d06eeed8b860a6da0ad71cdbe5c654ec2197cd19db75a" "q-15130/selection/4ae004cc2b04c1e6a3ac6906df221c52f8f538845f48fea0658c6b062e33737f" "q-15130/selection/c4befa12b7c42701198b5a6e60db6c7ea3c4b3817a1e1a92ff66e6f13e2b1850"] :db/ensure [:answer-field/validate]} {:db/id "q-15130" :question/id #uuid "5d989707-e79c-566c-8ee3-27f263bf177c" :question/math-academy-id "q-15130" :question/problem "The equation of a curve is ${x}^{2}-3{y}^{2}=6.$ The normal line at the point $(-3,\\,1)$ on the curve intersects the $x$-axis at the point $P.$ What are the coordinates of $P?$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(-3,\\,1).$  Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}-3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(6) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})-\\frac{\\text{d}}{\\text{d}x}(3{y}^{2}) & =0 \\\\ 2x-6y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ -6y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-2x}{-6y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{x}{3y}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(-3,\\,1)$ is \n\n \n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(-3,\\,1)} \\\\  & ={(\\frac{x}{3y})}_{(-3,\\,1)} \\\\  & =\\frac{-3}{3\\cdot 1} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is ${m}^{′}=-\\frac{1}{m}=-\\frac{1}{-1}=1.$ We can write the equation of the normal at the point $(-3,\\,1)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{′}(x-{x}_{1}) \\\\ (y-1) & =1(x+3) \\\\ y & =(x+3)+1 \\\\ y & =x+4\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $x$-axis. At the point $P$ the $y$-coordinate is $0,$ so we set $y=0$ and solve for $x:$\n\n$$\n\\begin{aligned}y & =x+4 \\\\ 0 & =x+4 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(-4,\\,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15130/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c"] :knowledge-point/questions ["q-15130"] :db/ensure [:knowledge-point/validate]} {:db/id "q-53750/selection/155df56f1abe58d1a1c77dafa9b9ede0d21968d5147baa9b61d9290a2dfaecf3" :answer/id #uuid "3aef06b2-7005-55ee-b236-587964e2d753" :answer/type :answer.type/math :answer/value "(0,15)" :db/ensure [:answer/validate]} {:db/id "q-53750/selection/5755b62bfb8e3e12998d66d89571ebce7c686bf6f282274c096e7a6600b0e12a" :answer/id #uuid "fb6c25d9-e6a8-5177-a8ef-52a0e44e7424" :answer/type :answer.type/math :answer/value "(0,12)" :db/ensure [:answer/validate]} {:db/id "q-53750/selection/dbc7e0f20bf63f4b17e2e463b39fd4b3464ed409cc4970ebfbf0d1b9561599ac" :answer/id #uuid "e6f6ea62-9cac-500f-b3ba-24923a5dbed5" :answer/type :answer.type/math :answer/value "(0,9)" :db/ensure [:answer/validate]} {:db/id "q-53750/selection/da3a7a81c361ae3d58f3254e16ba533250f2d8c31802c2a4284ddb58dd1bad31" :answer/id #uuid "33b93caf-b4ed-55a2-ad0f-2856277a617a" :answer/type :answer.type/math :answer/value "(0,14)" :db/ensure [:answer/validate]} {:db/id "q-53750/selection/dff7126d2404a3ed635ac9986e760af915be68175730d3e39217b15ca021e378" :answer/id #uuid "c576687f-4099-56aa-b62a-4a59e5d3cbd3" :answer/type :answer.type/math :answer/value "(0,10)" :db/ensure [:answer/validate]} {:db/id "q-53750/selection" :answer-field/id #uuid "3eaac560-d733-5230-9f9d-912c943df198" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-53750/selection/dff7126d2404a3ed635ac9986e760af915be68175730d3e39217b15ca021e378" :answer-field/choices ["q-53750/selection/155df56f1abe58d1a1c77dafa9b9ede0d21968d5147baa9b61d9290a2dfaecf3" "q-53750/selection/5755b62bfb8e3e12998d66d89571ebce7c686bf6f282274c096e7a6600b0e12a" "q-53750/selection/dbc7e0f20bf63f4b17e2e463b39fd4b3464ed409cc4970ebfbf0d1b9561599ac" "q-53750/selection/da3a7a81c361ae3d58f3254e16ba533250f2d8c31802c2a4284ddb58dd1bad31" "q-53750/selection/dff7126d2404a3ed635ac9986e760af915be68175730d3e39217b15ca021e378"] :db/ensure [:answer-field/validate]} {:db/id "q-53750" :question/id #uuid "a005b573-01a6-5ae1-85c6-8a86b21af397" :question/math-academy-id "q-53750" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947863/assets/faa8a8e0521972fa860d474ac079405b6930df6c47fda05808fdf242d6d6922b.png)\n\nThe equation $xy=5$ represents a hyperbola. The tangent line at the point $(1,5)$ on the hyperbola intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$" :question/worked-solution "First of all, we need to find the slope of the tangent line at the point $(1,5).$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(xy) & =\\frac{\\text{d}}{\\text{d}x}(5) \\\\ x\\frac{\\text{d}y}{\\text{d}x}+y & =0 \\\\ x\\frac{\\text{d}y}{\\text{d}x} & =-y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{y}{x}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(1,\\,5)$  is \n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(1,\\,5)} \\\\  & ={(-\\frac{y}{x})}_{(1,\\,5)} \\\\  & =-\\frac{5}{1} \\\\  & =-5.\\end{aligned}\n$$\n\nWe can write the equation of the tangent at the point $(1,\\,5)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & =m(x-{x}_{1}) \\\\ (y-5) & =-5(x-1) \\\\ y & =-5(x-1)+5 \\\\ y & =-5x+10\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-5x+10 \\\\ y & =-5\\cdot 0+10 \\\\ y & =10\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,10).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-53750/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c"] :knowledge-point/questions ["q-53750"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342321/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "8a754b56-bd84-527a-9eb5-627286d3f26a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342321/field-1" :answer-field/id #uuid "56c1c764-e810-5280-b9f5-688edb7a227f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342321/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342321/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342321/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "657ae0bc-0cb8-5764-ac20-e992138af162" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-342321/field-2" :answer-field/id #uuid "9b3b1473-851b-54e1-be56-fe2b4a16efe2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342321/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-342321/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-342321" :question/id #uuid "2bec85f4-6642-5907-9fd0-41128942f8dd" :question/math-academy-id "q-342321" :question/problem "The equation of a curve is ${x}^{2}+xy=6{y}^{2}.$ The normal line at the point $(2,1)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the normal line at the point $(2,1).$ Remember that the slope of the normal line, ${m}^{′},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{′}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\nNote that to differentiate the $xy$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}+xy & =6{y}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}+xy) & =\\frac{\\text{d}}{\\text{d}x}(6{y}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(xy) & =\\frac{\\text{d}}{\\text{d}x}(6{y}^{2}) \\\\ 2x+(y+x\\frac{\\text{d}y}{\\text{d}x}) & =12y\\frac{\\text{d}y}{\\text{d}x} \\\\ 2x+y+x\\frac{\\text{d}y}{\\text{d}x} & =12y\\frac{\\text{d}y}{\\text{d}x} \\\\ x\\frac{\\text{d}y}{\\text{d}x}-12y\\frac{\\text{d}y}{\\text{d}x} & =-2x-y \\\\ (x-12y)\\frac{\\text{d}y}{\\text{d}x} & =-2x-y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-2x-y}{x-12y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(2,1)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(2,\\,1)} \\\\  & ={(\\frac{-2x-y}{x-12y})|}_{(2,\\,1)} \\\\  & =\\frac{-2(2)-1}{2-12(1)} \\\\  & =\\frac{(-5)}{(-10)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(\\frac{1}{2})}=-2.\n$$\n\nWe can write the equation of the normal at the point $(2,1)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-1 & =-2(x-2) \\\\ y-1 & =-2x+4 \\\\ y & =-2x+5\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-2x+5 \\\\ y & =-2(0)+5 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,5).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342321/field-1" "q-342321/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c"] :knowledge-point/questions ["q-342321"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342387/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "1eff946d-93db-5ddb-aae8-ab95cb1ca3a4" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-342387/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ce7de615-96e6-5fbd-93db-49ed1c85552a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-342387/field-1" :answer-field/id #uuid "0e8ac9fd-9daf-5450-be75-eeb47061e84e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342387/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-342387/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-342387/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-342387/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "28020db3-8c15-50b9-bbfd-acdbaafad98f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342387/field-2" :answer-field/id #uuid "6d86ba02-0342-5ec0-91f0-d1af3a6bf947" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342387/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342387/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342387" :question/id #uuid "6bf2822c-2fe8-5e06-b637-67fd4c8ecb6d" :question/math-academy-id "q-342387" :question/problem "The equation of a curve is ${x}^{2}+2y=20.$ The tangent line at the point $(2,8)$ intersects the $x$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the tangent line at the point $(2,8).$ \n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}{x}^{2}+2y & =20 \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}+2y) & =\\frac{\\text{d}}{\\text{d}x}(20) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2y) & =\\frac{\\text{d}}{\\text{d}x}(20) \\\\ 2x+2\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-x.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(2,8)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(2,\\,8)} \\\\  & ={(-x)|}_{(2,\\,8)} \\\\  & =-2.\\end{aligned}\n$$\n\nWe can write the equation of the tangent line at the point $(2,8)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-8 & =-2(x-2) \\\\ y-8 & =-2x+4 \\\\ y & =-2x+12\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $x$-axis. At the point $P$ the $y$-coordinate is $0,$ so we set $y=0$ and solve for $x:$\n\n$$\n\\begin{aligned}0 & =-2x+12 \\\\ 2x & =12 \\\\ x & =6\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(6,\\,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342387/field-1" "q-342387/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c"] :knowledge-point/questions ["q-342387"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342325/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "92e4d264-8bdc-5977-8c28-9c38699fa51e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342325/field-1" :answer-field/id #uuid "4a015aab-f223-537b-93ff-1f1a4ea397e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342325/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342325/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-342325/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c6561f3e-6cd1-5080-b35b-e296de6c487e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-342325/field-2" :answer-field/id #uuid "cf228e6f-299e-5240-b089-37d5e76253c1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342325/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-342325/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-342325" :question/id #uuid "0bfaeba2-34c5-5317-adf8-a3f1eb304fa9" :question/math-academy-id "q-342325" :question/problem "The equation of a curve is $4{x}^{2}+9{y}^{2}=36.$ The tangent line at the point $(0,2)$ intersects the $y$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First of all, we need to find the slope of the tangent line at the point $(0,2).$ \n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+9{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(36) \\\\ \\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(9{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(36) \\\\ 8x+18y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 18y\\frac{\\text{d}y}{\\text{d}x} & =-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{8x}{18y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{9y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(0,2)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(0,\\,2)} \\\\  & ={(-\\frac{4x}{9y})|}_{(0,\\,2)} \\\\  & =-\\frac{4\\cdot 0}{9\\cdot 2} \\\\  & =0.\\end{aligned}\n$$\n\nWe can write the equation of the tangent line at the point $(0,2)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =0(x-0) \\\\ y & =2\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =2\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are\n\n$$\n(0,\\,2).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342325/field-1" "q-342325/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfdb93d1-d550-5939-8a47-99bd1d863a8c"] :knowledge-point/questions ["q-342325"] :db/ensure [:knowledge-point/validate]}]
