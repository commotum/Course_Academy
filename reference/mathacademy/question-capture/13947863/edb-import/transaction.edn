 "q-108367/selection/a84498ffaeca6cd22c370ff2bb0814419d3317bb1b799ec8d333b4c383350634"] :db/ensure [:answer-field/validate]} {:db/id "q-108367" :question/id #uuid "8b9a674f-4b08-56bb-b862-861e9645fdbf" :question/math-academy-id "q-108367" :question/problem "Given that ${y}^{3}+\\operatorname{cos}⁡(y)-2{x}^{2}=5,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{3}+\\operatorname{cos}⁡(y)-2{x}^{2} & =5 \\\\ \\frac{\\text{d}}{\\text{d}x}({y}^{3}+\\operatorname{cos}⁡(y)-2{x}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(5) \\\\ \\frac{\\text{d}}{\\text{d}x}({y}^{3})+\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(y))-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}) & =0 \\\\ 3{y}^{2}(\\frac{\\text{d}y}{\\text{d}x})-\\operatorname{sin}⁡(y)(\\frac{\\text{d}y}{\\text{d}x})-4x & =0\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(3{y}^{2}-\\operatorname{sin}⁡(y)) & =4x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{4x}{3{y}^{2}-\\operatorname{sin}⁡(y)}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-108367/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a"] :knowledge-point/questions ["q-108367"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2289/selection/eafc0024939c077d5615938bd599bc759d1a13f617f2d81e83dec635056d0c02" :answer/id #uuid "4028f038-b715-507c-ba6d-353a19b38de7" :answer/type :answer.type/math :answer/value "\\frac{6x}{{2}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-2289/selection/4e52019049b0ca08462271c822f07f6c5c47a6542acae71f88dc4932bae542be" :answer/id #uuid "17628d73-98f4-5909-9be4-bc45cfd50f32" :answer/type :answer.type/math :answer/value "\