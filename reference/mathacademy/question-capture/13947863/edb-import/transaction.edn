=3{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(y-{2}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}({2}^{y}) & =6x \\\\ (1-\\operatorname{ln}⁡(2){2}^{y})(\\frac{\\text{d}y}{\\text{d}x}) & =6x\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(1-\\operatorname{ln}⁡(2)\\,{2}^{y}) & =6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-2289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a"] :knowledge-point/questions ["q-2289"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2290/selection/712322779a06962d2f65435927935cf5659dcca4bccd009820a64d68f3567e57" :answer/id #uuid "d407e01e-6222-578b-9e62-de7cdb3f20ee" :answer/type :answer.type/math :answer/value "\\frac{3{sec}^{2}⁡(3x)}{2y+1}" :db/ensure [:answer/validate]} {:db/id "q-2290/selection/f114c41d4868f8ab102a85bf5a72e3a01e728256430a767158289f5911bc368f" :answer/id #uuid "7d63c64f-4384-54c3-85ff-160f261a17c6" :answer/type :answer.type/math :answer/value "\\frac{3{cot}^{2}⁡(3x)}{2y+1}" :db/ensure [:answer/validate]} {:db/id "q-2290/selection/bd8f12a3b1dd2ad53aaf8c04be52ddca0f0bf497d066e6bb2b342c937f946b61" :answer/id #uuid "713ee965-7ec0-524f-9b6c-ce09bdf6c151" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{3y+1}" :db/ensure [:answer/validate]} {:db/id "q-2290/selection/73d66e426dc490a89fee4d7aadeb84c46e0b21ab812ed5738e1619125374d131" :answer/id #uuid "33890605-e540-54b0-9ad0-fdb5fc10f532" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{cot}⁡(3x)}{y+1}" :db/ensure [:answer/validate]} {:db/id "q-2290/selection/3820086c1c55ab7e727053e39a62e245e80ff7187fef33f4becb41f97b0538d5" :answer/id #uuid "7bd8fba3-a903-566d-bf59-729f7b7d6d68" :answer/type :answer.type/math :answer/value "\\frac{{sec}^{2}⁡(3x)}{y+1}" :db/ensure [:answer/validate]} {:db/id "q-2290/selection" :answer-field/id #uuid "f8cbd7d0-14ef-5262-a1b4-ed66f9ca2ac0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2290/selection/712322779a06962d2f65435927935cf5659dcca4bccd009820a64d68f3567e57" :answer-field/choices ["q-2290/selection/712322779a06962d2f65435927935cf5659dcca4bccd009820a64d68f3567e57" "q-2290/selection/f114c41d4868f8ab102a85bf5a72e3a01e728256430a767158289f5911bc368f" "q-2290/selection/bd8f12a3b1dd2ad53aaf8c04be52ddca0f0bf497d066e6bb2b342c937f946b61" "q-2290/selection/73d66e426dc490a89fee4d7aadeb84c46e0b21ab812ed5738e1619125374d131" "q-2290/selection/3820086c1c55ab7e727053e39a62e245e80ff7187fef33f4becb41f97b0538d5"] :db/ensure [:answer-field/validate]} {:db/id "q-2290" :question/id #uuid "5a4e18ef-12cd-5ee3-9a6d-cf3778b4e1b6" :question/math-academy-id "q-2290" :question/problem "Given that $\\operatorname{tan}⁡(3x)-{y}^{2}=y,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\operatorname{tan}⁡(3x)-{y}^{2} & =y \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x)-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x))-\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ 3{sec}^{2}⁡(3x)-2y(\\frac{\\text{d}y}{\\text{d}x}) & =(\\frac{\\text{d}y}{\\text{d}x})\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}3{sec}^{2}⁡(3x) & =\\frac{\\text{d}y}{\\text{d}x}(2y+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{sec}^{2}⁡(3x)}{2y+1}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2290/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a"] :knowledge-point/questions ["q-2290"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108506/selection/35dcb78004c3832a034f8c906ac9cc2e2453851019e207786e135af8952acc68" :answer/id #uuid "d920ea29-434a-569e-ad1a-656a8abcf7f7" :answer/type :answer.type/math :answer/value "\\frac{{e}^{y}+2}{1+y{e}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-108506/selection/6754b61cead9219a9d6ed81387ed20a17b90fdae9e5eb4eeb4a26efdcbed6ba7" :answer/id #uuid "8379e541-5679-5efc-ba91-84bca21a5cdf" :answer/type :answer.type/math :answer/value "\\frac{x{e}^{y}-1}{2-{e}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-108506/selection/be01b0f32cb239ad6bf5f809d23514793a67cd7977ce1bcb14906702de399349" :answer/id #uuid "906e80ff-9e64-58d4-942e-b2c11df10b74" :answer/type :answer.type/math :answer/value "\\frac{{e}^{y}+1}{2-{e}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-108506/selection/a17f1b81f394840fb0d5aeddc391563d12b9dfac036561c9a6d35611fa3d9cd0" :answer/id #uuid "7b39c2d7-809d-530a-b5f6-e9d77244a9c5" :answer/type :answer.type/math :answer/value "\\frac{1}{2-{e}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-108506/selection/5e02e666a25c78ec56a4d1359fde5a7e786f7834244487b30672772e4326173a" :answer/id #uuid "08c44cec-9d0f-5424-ae80-2452b84e19de" :answer/type :answer.type/math :answer/value "\\frac{y{e}^{y}+1}{2+{e}^{y}}" :db/ensure [:answer/validate]} {:db/id "q-108506/selection" :answer-field/id #uuid "a631e2a6-38b7-5bf7-ae1f-a7b29525dc2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108506/selection/a17f1b81f394840fb0d5aeddc391563d12b9dfac036561c9a6d35611fa3d9cd0" :answer-field/choices ["q-108506/selection/35dcb78004c3832a034f8c906ac9cc2e2453851019e207786e135af8952acc68" "q-108506/selection/6754b61cead9219a9d6ed81387ed20a17b90fdae9e5eb4