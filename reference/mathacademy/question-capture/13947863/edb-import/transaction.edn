)+3{x}^{2} & =11 \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{log}⁡(y)+3{x}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(11) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{log}⁡(y))+\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) & =0 \\\\ \\frac{1}{y\\operatorname{ln}⁡(10)}(\\frac{\\text{d}y}{\\text{d}x})+6x & =0\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{y\\cdot \\operatorname{ln}⁡(10)}\\frac{\\text{d}y}{\\text{d}x} & =-6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(-6x)(y\\operatorname{ln}⁡(10)) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-6\\operatorname{ln}⁡(10)\\,xy\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-108475/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a"] :knowledge-point/questions ["q-108475"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72260/selection/212473a9d79a072b10bd6c4535271ce4aae74cca1540460587774017c4b85714" :answer/id #uuid "487fbd07-9374-5d31-8d4f-9c4b79c04a22" :answer/type :answer.type/math :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-72260/selection/76c38ac6d39804e7be0ca72a03ad676506202f8e5bdb9936be3ac41452d7f1b5" :answer/id #uuid "ee35deda-25a0-5f19-80ba-68e806e1b457" :answer/type :answer.type/math :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-72260/selection/bea181375e1b36ab1d68d488094ace5fb51db8dec451baa278dfe852aae28d7e" :answer/id #uuid "1ab38bcc-674c-56e3-a491-13f4e44434c3" :answer/type :answer.type/math :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-72260/selection/8ac7c121fdc87e1651f0eb70968c98022e5988bf425f877d72143e6878877dac" :answer/id #uuid "bb3a113c-fbcb-59eb-bf43-f6588bdd998c" :answer/type :answer.type/math :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-72260/selection/48d0f8ba62520380a86a7fd42f21b7b22b3e2194d8988ee5085706fe307530b8" :answer/id #uuid "fc4c43c9-66b3-5c14-b539-20164e1a9b11" :answer/type :answer.type/math :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/ensure [:answer/validate]} {:db/id "q-72260/selection" :answer-field/id #uuid "c55b6534-9500-51da-a551-b8c385830489" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72260/selection/8ac7c121fdc87e1651f0eb70968c98022e5988bf425f877d72143e6878877dac" :answer-field/choices ["q-72260/selection/212473a9d79a072b10bd6c4535271ce4aae74cca1540460587774017c4b85714" "q-72260/selection/76c38ac6d39804e7be0ca72a03ad676506202f8e5bdb9936be3ac41452d7f1b5" "q-72260/selection/bea181375e1b36ab1d68d488094ace5fb51db8dec451baa278dfe852aae28d7e" "q-72260/selection/8ac7c121fdc87e1651f0eb70968c98022e5988bf425f877d72143e6878877dac" "q-72260/selection/48d0f8ba62520380a86a7fd42f21b7b22b3e2194d8988ee5085706fe307530b8"] :db/ensure [:answer-field/validate]} {:db/id "q-72260" :question/id #uuid "ef2b8cc4-5338-5352-affe-2a503c21ffcb" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72260/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb"] :knowledge-point/questions ["q-72260"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72263/selection/642d6c047bef7d637480490d6ba31f05a7d542a307322b2eb9ecf27819aadc4e" :answer/id #uuid "bba7eb30-7209-5123-84be-2422af603ec0" :answer/type :answer.type/math :answer/value "\\frac{8x-6{x}^{2}y}{2{x}^{3}+4y}" :db/ensure [:answer/validate]} {:db/id "q-72263/selection/b970b3b1a932d1a1156931c3cf1e9db245ddc142f3d83b633b70078dac0dd800" :answer/id #uuid "43bfd979-89de-51e7-ac92-56495cbc5e77" :answer/type :answer.type/math :answer/value "\\frac{8x+6xy}{2{x}^{3}-4y}" :db/ensure [:answer/validate]} {:db/id "q-72263/selection/289bc455181b3516fd8f8a809cdc3fc45e2743e9540725880b9c7864a82a337e" :answer/id #uuid "e65ebdc4-2a86-584f-85c1-4995985a95d0" :answer/type :answer.type/math :answer/value "\\frac{8x-3xy}{2{x}^{3}+4y}" :db/ensure [:answer/validate]} {:db/id "q-72263/selection/6eda41bf2d926437964f8a283e7f83c0f28c805eb1deb6bd2da5dbd3c54b41cf" :answer/id #uuid "7af4bfe9-0967-5e82-ac64-b159e7aa8b30" :answer/type :answer.type/math :answer/value "\\frac{8x-6xy}{2{x}^{2}+4y}" :db/ensure [:answer/validate]} {:db/id "q-72263/selection/beead2d473ba814869d390dccad1d0276e8aabc446fd2990f7d135cfd135ba90" :answer/id #uuid "200d7963-fe78-54ad-95a2-f1545164af7e" :answer/type :answer.type/math :answer/value "\\frac{x-6xy}{2{x}^{3}+4y}" :db/ensure [:answer/validate]} {:db/id "q-72263/selection" :answer-field/id #uuid "42102d9d-5ac6-5acb-81f2-aecc531eeeb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72263/selection/642d6c047bef7d637480490d6ba31f05a7d542a307322b2eb9ecf27819aadc4e" :answer-field/choices ["q-72263/selection/642d6c047bef7d637480490d6ba31f05a7d542a307322b2eb9ecf27819aadc4e" "q-72263/selection/b970b3b1a932d1a1156931c3cf1e9db245ddc142f3d83b633b70078dac0dd800" "q-72263/selection/289bc455181b3516fd8f8a809cdc3fc45e2743e9540725880b9c7864a82a337e" "q-72263/selection/6eda41bf2d926437964f8a283e7f83c0f28c805eb1deb6bd2da5dbd3c54b41cf" "q-72263/selection/beead2d473ba814869d390dccad1d0276e8aabc446fd2990f7d135cfd135ba90"] :db/ensure [:answer-field/validate]} {:db/id "q-72263" :question/id #uuid "a4275802-53c8-5e1e-8981-df33206ad101" :question/math-academy-id "q-72263" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $2{x}^{3}y+2{y}^{2}=4{x}^{2}+6.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $2{x}^{3}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}2{x}^{3}y+2{y}^{2} & =4{x}^{2}+6 \\\\ \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}y+2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+6) \\\\ \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}y)+\\frac{\\text{d}}{\\text{d}x}(2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+6) \\\\ [2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 6{x}^{2}]+4y\\frac{\\text{d}y}{\\text{d}x} & =8x \\\\ 2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+6{x}^{2}y+4y\\frac{\\text{d}y}{\\text{d}x} & =8x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}2{x}^{3}\\frac{\\text{d}y}{\\text{d}x}+4y\\frac{\\text{d}y}{\\text{d}x} & =8x-6{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x}(2{x}^{3}+4y) & =8x-6{x}^{2}y \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-6{x}^{2}y}{2{x}^{3}+4y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "619