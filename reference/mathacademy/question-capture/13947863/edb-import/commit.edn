y}{\\text{d}x} & =-8x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{8x}{18y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{9y}.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(0,2)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(0,\\,2)} \\\\  & ={(-\\frac{4x}{9y})|}_{(0,\\,2)} \\\\  & =-\\frac{4\\cdot 0}{9\\cdot 2} \\\\  & =0.\\end{aligned}\n$$\n\nWe can write the equation of the tangent line at the point $(0,2)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =0(x-0) \\\\ y & =2\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =2\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are\n\n$$\n(0,\\,2).\n$$" 13194139533856 true] [17592186255865 1000 #edb/ref 17592186255866 13194139533856 true] [17592186255865 1040 #edb/ref 17592186045449 13194139533856 true] [17592186255865 1041 "field-1" 13194139533856 true] [17592186255865 1104 #edb/ref 17592186255866 13194139533856 true] [17592186255865 1110 #uuid "4a015aab-f223-537b-93ff-1f1a4ea397e1" 13194139533856 true] [17592186255866 1034 "0" 13194139533856 true] [17592186255866 1103 #edb/ref 17592186045453 13194139533856 true] [17592186255866 1111 #uuid "92e4d264-8bdc-5977-8c28-9c38699fa51e" 13194139533856 true] [17592186255867 1000 #edb/ref 17592186255868 13194139533856 true] [17592186255867 1040 #edb/ref 17592186045449 13194139533856 true] [17592186255867 1041 "field-2" 13194139533856 true] [17592186255867 1104 #edb/ref 17592186255868 13194139533856 true] [17592186255867 1110 #uuid "cf228e6f-299e-5240-b089-37d5e76253c1" 13194139533856 true] [17592186255868 1034 "2" 13194139533856 true] [17592186255868 1103 #edb/ref 17592186045453 13194139533856 true] [17592186255868 1111 #uuid "c6561f3e-6cd1-5080-b35b-e296de6c487e" 13194139533856 true] [17592186255869 1017 #edb/ref 17592186255870 13194139533856 true] [17592186255869 1017 #edb/ref 17592186255873 13194139533856 true] [17592186255869 1089 "q-342387" 13194139533856 true] [17592186255869 1091 #edb/ref 17592186045465 13194139533856 true] [17592186255869 1100 "The equation of a curve is ${x}^{2}+2y=20.$ The tangent line at the point $(2,8)$ intersects the $x$-axis at the point $P.$ What are the coordinates of $P?$\n\nThe coordinates of $P$ are $($\n{{field-1}}$,$\n{{field-2}}$).$" 13194139533856 true] [17592186255869 1113 #uuid "6bf2822c-2fe8-5e06-b637-67fd4c8ecb6d" 13194139533856 true] [17592186255869 1145 "First of all, we need to find the slope of the tangent line at the point $(2,8).$ \n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}{x}^{2}+2y & =20 \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}+2y) & =\\frac{\\text{d}}{\\text{d}x}(20) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2y) & =\\frac{\\text{d}}{\\text{d}x}(20) \\\\ 2x+2\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-x.\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(2,8)$ is \n\n$$\n\\begin{aligned}m & ={\\frac{\\text{d}y}{\\text{d}x}|}_{(2,\\,8)} \\\\  & ={(-x)|}_{(2,\\,8)} \\\\  & =-2.\\end{aligned}\n$$\n\nWe can write the equation of the tangent line at the point $(2,8)$ as follows:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-8 & =-2(x-2) \\\\ y-8 & =-2x+4 \\\\ y & =-2x+12\\end{aligned}\n$$\n\nNow, we just need to find where this tangent line intersects the $x$-axis. At the point $P$ the $y$-coordinate is $0,$ so we set $y=0$ and solve for $x:$\n\n$$\n\\begin{aligned}0 & =-2x+12 \\\\ 2x & =12 \\\\ x & =6\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(6,\\,0).$" 13194139533856 true] [17592186255870 1000 #edb/ref 17592186255871 13194139533856 true] [17592186255870 1000 #edb/ref 17592186255872 13194139533856 true] 