t{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(\\pi /3,\\,2)} \\\\  & ={(\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)})}_{(\\pi /3,\\,2)} \\\\  & =\\frac{2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})} \\\\  & =\\frac{2\\cdot (\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$" 13194139533856 true] [17592186255822 1000 #edb/ref 17592186255823 13194139533856 true] [17592186255822 1000 #edb/ref 17592186255824 13194139533856 true] [17592186255822 1000 #edb/ref 17592186255825 13194139533856 true] [17592186255822 1000 #edb/ref 17592186255826 13194139533856 true] [17592186255822 1000 #edb/ref 17592186255827 13194139533856 true] [17592186255822 1040 #edb/ref 17592186045450 13194139533856 true] [17592186255822 1041 "selection" 13194139533856 true] [17592186255822 1104 #edb/ref 17592186255823 13194139533856 true] [17592186255822 1110 #uuid "effbd3bf-202d-501e-aa77-3bfc58e9d459" 13194139533856 true] [17592186255823 1034 "2\\sqrt{3}" 13194139533856 true] [17592186255823 1103 #edb/ref 17592186045453 13194139533856 true] [17592186255823 1111 #uuid "ad1daaec-b025-54cc-af65-be869f572f27" 13194139533856 true] [17592186255824 1034 "\\frac{2}{3}" 13194139533856 true] [17592186255824 1103 #edb/ref 17592186045453 13194139533856 true] [17592186255824 1111 #uuid "ffa1ea18-4820-5015-ab9d-2bba53e46456" 13194139533856 true] [17592186255825 1034 "6" 13194139533856 true] [17592186255825 1103 #edb/ref 17592186045453 13194139533856 true] [17592186255825 1111 #uuid "fd30544b-8548-53c9-afad-6fcd64142e69" 13194139533856 true] [17592186255826 1034 "\\frac{\\sqrt{3}}{4}" 13194139533856 true] [1759218