}⁡(5\\theta )+\\text{i}\\operatorname{sin}⁡(5\\theta )]}^{-6}.\n$$\n\nDe Moivre's Theorem states that\n\n$$\n{[\\operatorname{cos}⁡(\\phi )+\\text{i}\\operatorname{sin}⁡(\\phi )]}^{n}=\\operatorname{cos}⁡(n\\phi )+\\text{i}\\operatorname{sin}⁡(n\\phi ).\n$$\n\nIn our expression, we have $n=-6$ and $\\phi =5\\theta .$ Substituting in these values, we get\n\n$$\n\\begin{aligned}\\frac{1}{{[\\operatorname{cos}⁡(5\\theta )+\\text{i}\\operatorname{sin}⁡(5\\theta )]}^{6}} & ={[\\operatorname{cos}⁡(5\\theta )+\\text{i}\\operatorname{sin}⁡(5\\theta )]}^{-6} \\\\  & =\\operatorname{cos}⁡(-30\\theta )+\\text{i}\\operatorname{sin}⁡(-30\\theta ).\\end{aligned}\n$$\n\nFinally, using the fact that $\\operatorname{cos}⁡(-\\phi )=\\operatorname{cos}⁡(\\phi )$ and $\\operatorname{sin}⁡(-\\phi )=-\\operatorname{sin}⁡(\\phi )$ for any input $\\phi ,$ we have\n\n$$\n\\operatorname{cos}⁡(-30\\theta )+\\text{i}\\operatorname{sin}⁡(-30\\theta )=\\operatorname{cos}⁡(30\\theta )-\\text{i}\\operatorname{sin}⁡(30\\theta ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055661/state.json" "file_sha256" "e0b664fdfc17c5a0fb0cc22c02ac3b466d1e7a3a6eb1dd000f6857931357ba7d"} {"question" "q-71457" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055661/activity-metadata.json" "file_sha256" "e2392448160f40f4b2950be85e254ffe26679a0f9efd98c33f481c3aa954de7e"} {"question" "q-71457" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14055661/state.json" "file_sha256" "e0b664fdfc17c5a0fb0cc22c02ac3b466d1e7a3a6eb1dd000f6857931357ba7d"} {"question" "q-71457" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{cos}⁡(15\\theta )+2\\t