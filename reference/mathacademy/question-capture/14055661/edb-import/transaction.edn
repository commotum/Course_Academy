f-5fb3-b0ed-5a275a534e02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104345/selection/92f29f52da12d3c389780f60a3a7a5aa1aaa40e50e1891870be6f6df9bd393ae" :answer-field/choices ["q-104345/selection/0578fdfc2f9b1de5a319a1e701d05ada7f6e07cd39bbf6a074fd1ef97516bca8" "q-104345/selection/92f29f52da12d3c389780f60a3a7a5aa1aaa40e50e1891870be6f6df9bd393ae" "q-104345/selection/d3534e229bc72944517b87a731cee53c6a3ca55b539e462afa3bb4ee09b668b8" "q-104345/selection/263c7bc7c3dd68f57f947b0ee0cb37ab0c785dfa83deb311940eb9717a18a0a4" "q-104345/selection/7633ad33daa3fd4148876b5a59a7123bc5dbd7610a7c124e782af3c189278c4e"] :db/ensure [:answer-field/validate]} {:db/id "q-104345" :question/id #uuid "42a7dd26-7fe8-5846-9cc9-1ba1e31fe32e" :question/math-academy-id "q-104345" :question/problem "Simplify the expression $\\frac{2}{{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{12}}.$" :question/worked-solution "First, note that\n\n$$\n\\frac{1}{{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{12}}={[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{-12}.\n$$\n\nDe Moivre's Theorem states that\n\n$$\n{[\\operatorname{cos}⁡(\\phi )+\\text{i}\\operatorname{sin}⁡(\\phi )]}^{n}=\\operatorname{cos}⁡(n\\phi )+\\text{i}\\operatorname{sin}⁡(n\\phi ).\n$$\n\nIn our expression, we have $n=-12$ and $\\phi =\\theta .$ Substituting in these values, we get\n\n$$\n\\begin{aligned}\\frac{2}{{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{12}} & =2{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{-12} \\\\  & =2[\\operatorname{cos}⁡(-12\\theta )+\\text{i}\\operatorname{sin}⁡(-12\\theta )].\\end{aligned}\n$$\n\nFinally, using the fact that $\\operatorname{cos}⁡(-\\phi )=\\operatorname{cos}⁡(\\phi )$ and $\\operatorname{sin}⁡(-\\phi )=-\\operatorname{sin}⁡(\\phi )$ for any input $\\phi ,$ we have\n\n$$\n2[\\operatorname{cos}⁡(-12\\theta )+\\text{i}\\operatorname{sin}⁡(-12\\theta )]=2[\\operatorname{cos}⁡(12\\theta )-\\text{i}\\operatorname{sin}⁡(12\\theta )].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104345/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ed5facf-f654-5890-974f-bbdcd9641515"] :knowledge-point/questions ["q-104345"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104343/selection/763cc2b4f8c204877f48d17f2d87811097514ee11b7ec8d107fe0000c73d8c01" :answer/id #uuid "e1b62da0-c9d0-5068-ae1f-6c3f5404d834" :answer/type :answer.type/math :answer/value "30[\\operatorname{cos}⁡(3\\theta )-\\text{i}\\operatorname{sin}⁡(3\\theta )]" :db/ensure [:answer/validate]} {:db/id "q-104343/selection/0510bb0b390b0dc0bf265bc1fc0b062f75233803f618762dc4e89c4bac20b8ec" :answer/id #uuid "bb36adf6-4486-57b2-914d-d3ba9356fbdb" :answer/type :answer.type/math :answer/value "6[\\operatorname{cos}⁡(15\\theta )-\\text{i}\\operatorname{sin}⁡(15\\theta )]" :db/ensure [:answer/validate]} {:db/id "q-104343/selection/e6617823aab88f1dc4f219c095f1620b17a1c80e39598a7c066906272f0ea249" :answer/id #uuid "f2a664c0-1a25-504c-875d-cd9218a0d0f3" :answer/type :answer.type/math :answer/value "\\frac{6}{5}[\\operatorname{cos}⁡(3\\theta )-\\text{i}\\operatorname{sin}⁡(3\\theta )]" :db/ensure [:answer/validate]} {:db/id "q-104343/selection/ec0fc8b4a1c94c38cb434d94303c86fae88e0a70612a708b30d7e825b4e95452" :answer/id #uuid "e30ac6e0-6e0d-5d5a-aa21-963d4c43fbcd" :answer/type :answer.type/math :answer/value "2[\\operatorname{cos}⁡(\\frac{\\theta }{5})-\\text{i}\\operatorname{sin}⁡(\\frac{\\theta }{5})]" :db/ensure [:answer/validate]} {:db/id "q-104343/selection/81ec20044d031f53cf1d901d8273629147c3e83ec4b3caed6cf42382f7fa3c92" :answer/id #uuid "c8f1d326-dc24-506a-8d86-6dc7cc6c2859" :answer/type :answer.type/math :answer/value "6[\\operatorname{cos}⁡(\\frac{3\\theta }{5})-\\text{i}\\operatorname{sin}⁡(\\frac{3\\theta }{5})]" :db/ensure [:answer/validate]} {:db/id "q-104343/selecti