sin}⁡\\theta ]}^{12}}.$" :question/worked-solution "First, note that\n\n$$\n\\frac{1}{{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{12}}={[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{-12}.\n$$\n\nDe Moivre's Theorem states that\n\n$$\n{[\\operatorname{cos}⁡(\\phi )+\\text{i}\\operatorname{sin}⁡(\\phi )]}^{n}=\\operatorname{cos}⁡(n\\phi )+\\text{i}\\operatorname{sin}⁡(n\\phi ).\n$$\n\nIn our expression, we have $n=-12$ and $\\phi =\\theta .$ Substituting in these values, we get\n\n$$\n\\begin{aligned}\\frac{2}{{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{12}} & =2{[\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ]}^{-12} \\\\  & =2[\\operatorname{cos}⁡(-12\\theta )+\\text{i}\\operatorname{sin}⁡(-12\\theta )].\\end{aligned}\n$$\n\nFinally, using the fact that $\\operatorname{cos}⁡(-\\phi )=\\operatorname{cos}⁡(\\phi )$ and $\\operatorname{sin}⁡(-\\phi )=-\\operatorname{sin}⁡(\\phi )$ for any input $\\phi ,$ we have\n\n$$\n2[\\operatorname{cos}⁡(-12\\theta )+\\text{i}\\operatorname{sin}⁡(-12\\theta )]=2[\\operatorname{cos}⁡(12\\theta )-\\text{i}\\operatorname{sin}⁡(12\\theta )].\n$$"}] [{:db/id #edb/ref 17592186333308 :knowledge-point/_questions [{:knowledge-point/id #uuid "5055bd50-a6aa-547d-9ce3-573d79ac2e91" :knowledge-point/title "Applying De Moivre's Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f2be1fd-304c-562c-bdeb-5502a064be50" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{\\theta }{10})+\\text{i}\\operatorname{sin}⁡(\\frac{\\theta }{10})" :db/id #edb/ref 17592186333310} {:answer/id #uuid "ef18ac32-37b6-546a-ad79-7ba2cef6afc3" :answer/type {:db/ident :answer.type/math} :answer/value "10(\\operatorname{cos}⁡\\theta -\\text{i}\\operatorname{sin}⁡\\theta )" :db/id #edb/ref 17592186333311} {:answer/id #uuid "6c817756-f443-547b-b5b6-9d8afd73b1e6" :answer/type {:db/ident :answer.type/math} :answer/