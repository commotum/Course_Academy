 }{10}) \\\\  & =\\operatorname{cos}⁡(\\frac{2\\theta }{5})+\\text{i}\\operatorname{sin}⁡(\\frac{2\\theta }{5}).\\end{aligned}\n$$" 13194139535139 true] [17592186091987 1100 "Simplify the expression $\\dfrac{1}{\\left[ \\cos (2\\theta) -\\textrm{i}\\sin (2\\theta) \\right]^4}.$" 13194139535139 true] [17592186091987 1100 "Simplify the expression $\\dfrac{1}{\\left[\\cos (2\\theta) -\\textrm{i}\\sin (2\\theta) \\right]^4}$." 13194139535139 false] [17592186091987 1145 "First, note that\n\n$$\n\\begin{aligned}\n(1)/([\\cos (2θ) - \\textrm{i}\\sin (2θ)]^{4}) &= [\\cos (2θ) - \\textrm{i}\\sin (2θ)]^{-4}\n\\end{aligned}\n$$\n\nFor expressions involving subtraction, De Moivre's theorem states that\n\n$$\n\\left[ \\cos (\\varphi) - \\textrm{i}\\sin(\\varphi) \\right]^n = \\cos(n\\varphi) - \\textrm{i}\\sin{(n\\varphi)}\n$$\n\nIn our expression, we have $n=-4$ and\n\n$$\n\\varphi=2\\theta\n$$\n\nSubstituting in these values, we get\n\n$$\n\\begin{aligned}\n[\\cos (2θ) - \\textrm{i}\\sin (2θ)]^{-4} &= \\cos (-4 \\cdot 2θ) - \\textrm{i}\\sin (-4 \\cdot 2θ) \\\\\n&= \\cos (-8θ) - \\textrm{i}\\sin (-8θ)\n\\end{aligned}\n$$\n\nFinally, using the fact that\n\n$$\n\\cos(-\\varphi) = \\cos (\\varphi)\n$$\n\nand\n\n$$\n\\sin(-\\varphi) = -\\sin(\\varphi)\n$$\n\nfor any input $\\varphi$, we have\n\n$$\n\\begin{aligned}\n\\cos (-8θ) - \\textrm{i}\\sin (-8θ) &= \\cos (8θ) - [- \\textrm{i}\\sin (8θ)] \\\\\n&= \\cos (8θ) + \\textrm{i}\\sin (8θ)\n\\end{aligned}\n$$" 13194139535139 false] [17592186091987 1145 "First, note that\n\n$$\n\\begin{aligned}\\frac{1}{{[\\operatorname{cos}⁡(2\\theta )-\\text{i}\\operatorname{sin}⁡(2\\theta )]}^{4}} & ={[\\operatorname{cos}⁡(2\\theta )-\\text{i}\\operatorname{sin}⁡(2\\theta )]}^{-4}.\\end{aligned}\n$$\n\nFor expressions involving subtraction, De Moivre's theorem states that\n\n$$\n\\left[ \\cos (\\varphi) - \\textrm{i}\\sin(\\varphi) \\right]^n = \\cos(n\\varphi) - \\textrm{i}\\sin{(n\\varphi)}.\n$$\n\nIn our expression, we have $n=-4$ and $\\varphi=2