)^{2}-25]+4[(y-2)^{2}-4]+25 & =0 \\\\ (x+5)^{2}-25+4(y-2)^{2}-16+25 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x+5)^{2}-25+4(y-2)^{2}-16+25 & =0 \\\\ (x+5)^{2}+4(y-2)^{2} & =25-25+16 \\\\ (x+5)^{2}+4(y-2)^{2} & =16 \\\\ \\frac{(x+5)^{2}}{16}+\\frac{(y-2)^{2}}{4} & =1 \\\\ \\frac{(x+5)^{2}}{{4}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nSince $4>2,$ the length of the major axis is $2\\cdot 4=8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16565/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632"] :knowledge-point/questions ["q-16565"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16562/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "a701f455-c658-5b65-a935-93105e26b3a7" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-16562/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "a4eae282-0591-5525-8197-52562abbbb5d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-16562/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "018bd471-551c-5e34-a84f-d0fa0c823a96" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-16562/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "35f9846e-de5c-557d-b7ac-3b795ac6d314" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-16562/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f0dbee47-80f2-5bf5-adbc-53b21d492acd" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-16562/selection" :answer-field/id #uuid "bf8eb0cc-df85-57cb-b4f1-9171470e0eb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16562/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-16562/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-16562/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-16562/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-16562/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-16562/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-16562" :question/id #uuid "15072ac4-f75c-57bd-98e4-31b68da7b4f5" :question/math-academy-id "q-16562" :question/problem "Consider the ellipse whose equation is $4{x}^{2}+9{y}^{2}–48x+72y+144=0.$ Which of the following statements are true?\n\n- Its center is $(6,-4)$\n- The length of the major axis is $6$\n- The length of the minor axis is $4$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+9{y}^{2}–48x+72y+144 & =0 \\\\ (4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-48x)+(9{y}^{2}+72y)+144 & =0 \\\\ 4[{x}^{2}-12x]+9[{y}^{2}+8y]+144 & =0 \\\\ 4[(x-6)^{2}-{6}^{2}]+9[(y+4)^{2}-{4}^{2}]+144 & =0 \\\\ 4[(x-6)^{2}-36]+9[(y+4)^{2}-16]+144 & =0 \\\\ 4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-6)^{2}-144+9(y+4)^{2}-144+144 & =0 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =-144+144+144 \\\\ 4(x-6)^{2}+9(y+4)^{2} & =144 \\\\ \\frac{(x-6)^{2}}{36}+\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{(x-6)^{2}}{{6}^{2}}+\\frac{(y+4)^{2}}{{4}^{2}} & =1\\end{aligned}\n$$\n\nSince $6>4,$ the length of the major axis is $2\\cdot 6=12,$ the length of the minor axis is $2\\cdot 4=8,$ and the ellipse is centered at $(6,-4).$\n\nTherefore, statement I is true, statements II and III are false." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16562/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632"] :knowledge-point/questions ["q-16562"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16561/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "2164137e-eb8f-5f40-9613-df4b68b4f673" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-16561/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "d80af9f1-2cae-5892-a22c-6c69d539acfa" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-16561/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7fb7c1f4-ef63-5eec-ac52-8f95f410bb28" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-16561/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9dba6e70-b115-59d5-a502-b5291257179b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-16561/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9b080a0f-cc70-56a6-b093-dd9a885dd45c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-16561/selection" :answer-field/id #uuid "ec355938-3070-590c-910b-61d40a6cbe69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16561/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-16561/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-16561/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-16561/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-16561/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-16561/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-16561" :question/id #uuid "02554ab2-20a4-5fc6-a60f-c215a86f29de" :question/math-academy-id "q-16561" :question/problem "Determine the length of the minor axis of the ellipse whose equation is  $25{x}^{2}+4{y}^{2}+100x–40y+100=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+4{y}^{2}+100x–40y+100 & =0 \\\\ (25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}+100x)+(4{y}^{2}-40y)+100 & =0 \\\\ 25[{x}^{2}+4x]+4[{y}^{2}-10y]+100 & =0 \\\\ 25[(x+2)^{2}-{2}^{2}]+4[(y-5)^{2}-{5}^{2}]+100 & =0 \\\\ 25[(x+2)^{2}-4]+4[(y-5)^{2}-25]+100 & =0 \\\\ 25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x+2)^{2}-100+4(y-5)^{2}-100+100 & =0 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =-100+100+100 \\\\ 25(x+2)^{2}+4(y-5)^{2} & =100 \\\\ \\frac{(x+2)^{2}}{4}+\\frac{(y-5)^{2}}{25} & =1 \\\\ \\frac{(x+2)^{2}}{{2}^{2}}+\\frac{(y-5)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>2,$ the length of the minor axis is $2\\cdot 2=4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16561/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632"] :knowledge-point/questions ["q-16561"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16639/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "3833e520-ea00-54c1-99c9-25ca5599a465" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-16639/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c817e8cc-025a-54d7-a621-4ac44d2e900c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-16639/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "6635f610-6d71-5d3f-8151-6a08d542e2a4" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-16639/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "b043cc3d-ad3b-5619-bdae-7daf1a21d573" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-16639/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d9a44228-ea6b-588f-975f-63761feef529" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-16639/selection" :answer-field/id #uuid "bd92c1f9-fae6-5883-9cc2-7db74b6263de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16639/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-16639/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-16639/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-16639/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-16639/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-16639/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-16639" :question/id #uuid "d4b34d91-162d-5e99-b8ce-279507301e30" :question/math-academy-id "q-16639" :question/problem "Consider the ellipse whose equation is $3{x}^{2}+{y}^{2}-9=0.$ Which of the following statements are true?\n\n- Its center is $(0,0)$\n- The length of the major axis is $3$\n- The length of the minor axis is $2\\sqrt{3}$" :question/worked-solution "We rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}3{x}^{2}+{y}^{2}-9 & =0 \\\\ 3{x}^{2}+{y}^{2} & =9 \\\\ \\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{9} & =1 \\\\ \\frac{(x-0)^{2}}{(\\sqrt{3})^{2}}+\\frac{(y-0)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $3>\\sqrt{3},$ the length of the major axis is $2\\cdot 3=6,$ the length of the minor axis is $2\\cdot \\sqrt{3}=2\\sqrt{3},$ and the ellipse is centered at $(0,0).$\n\nTherefore, statements I and III are true, statement II is false." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16639/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632"] :knowledge-point/questions ["q-16639"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5216"] :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $25x^2 + 9y^2 - 100x - 18y = 116.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}25{x}^{2}+9{y}^{2}-100x-18y & =116 \\\\ (25{x}^{2}-100x)+(9{y}^{2}-18y) & =116\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(25{x}^{2}-100x)+(9{y}^{2}-18y) & =116 \\\\ 25[{x}^{2}-4x]+9[{y}^{2}-2y] & =116 \\\\ 25[(x-2)^{2}-4]+9[(y-1)^{2}-1] & =116 \\\\ 25(x-2)^{2}-100+9(y-1)^{2}-9 & =116\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}25(x-2)^{2}-100+9(y-1)^{2}-9 & =116 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =116+100+9 \\\\ 25(x-2)^{2}+9(y-1)^{2} & =225 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y-1)^{2}}{25} & =1 \\\\ \\frac{(x-2)^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nSince $5 > 3,$ the length of the major axis is $2\\cdot 5 =10,$ the length of the minor axis is $2\\cdot 3 =6,$ and the ellipse is centered at $({2},{1}).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5217"] :question/problem "Find the center and the lengths of the major and minor axes of the ellipse whose equation is $x^2 + 4y^2 - 6x + 24y + 41 = 0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-6x+24y+41 & =0 \\\\ ({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0\\end{aligned}\n$$\n\nNow, we complete the square for the both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-6x)+(4{y}^{2}+24y)+41 & =0 \\\\ ({x}^{2}-6x)+4[{y}^{2}+6y]+41 & =0 \\\\ (x-3)^{2}-9+4[(y+3)^{2}-9]+41 & =0 \\\\ (x-3)^{2}-9+4(y+3)^{2}-36+41 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-3)^{2}-9+4(y+3)^{2}-36+41 & =0 \\\\ (x-3)^{2}+4(y+3)^{2} & =9+36-41 \\\\ (x-3)^{2}+4(y+3)^{2} & =4 \\\\ \\frac{(x-3)^{2}}{4}+\\frac{(y+3)^{2}}{1} & =1 \\\\ \\frac{(x-3)^{2}}{{2}^{2}}+\\frac{(y+3)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2 > 1,$ the length of the major axis is $2\\cdot 2 =4,$ the length of the minor axis is $2\\cdot 1 =2,$ and the ellipse is centered at $({3},{-3}).$" :db/ensure [:question/validate]}]
