N})" :db/id #edb/ref 17592186328503} {:answer/id #uuid "0cb02b9d-f4e3-5c18-88ad-913f00ee80aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}({3}^{N}-1)" :db/id #edb/ref 17592186328504} {:answer/id #uuid "a648f2f0-b1f2-5c02-bb73-6ae1794f40b4" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{N}-1" :db/id #edb/ref 17592186328505} {:answer/id #uuid "78826e7e-7d7a-5c50-947a-956c50a501c4" :answer/type {:db/ident :answer.type/math} :answer/value "1-{3}^{N}" :db/id #edb/ref 17592186328506}] :answer-field/correct {:answer/id #uuid "a648f2f0-b1f2-5c02-bb73-6ae1794f40b4" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{N}-1" :db/id #edb/ref 17592186328505} :answer-field/id #uuid "55818665-a290-5fa8-9d23-d2bb40536c8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328501}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "74d8b68e-f058-5ad3-a158-8ee4dd68bb22" :question/math-academy-id "q-67267" :question/problem "What is the sum of the first $N$ terms of a geometric series $2+6+18+⋯?$" :question/worked-solution "First, we determine the common ratio $r$ for this geometric series:\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{2}}{{a}_{1}} \\\\  & =\\frac{6}{2} \\\\  & =3\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=2$ and $r=3.$ Therefore, we have:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{2(1-{3}^{N})}{1-3} \\\\  & =-\\frac{2}{2}(1-{3}^{N}) \\\\  & ={3}^{N}-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186328507 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd32a853-e0ec-5d56-bd6b-1c2e0e3249f8" :knowledge-point/title "Finding the Formula for the Sum of a Geometric Series Given an Arbitrary Term and the Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42b3686d-458d-5404-a45b-871b43e23512" :answer/type {:db/ident :answer.type/math} :answer/value "2({5}^{N}-1)" :db/id #edb/ref 17592186328509} {:answer/id #uuid "892a9f3a-feea-5ad1-b9e5-c102a6a43dbc" :answer/type {:db/ident :answer.type/math} :answer/value "4({5}^{N}-3)" :db/id #edb/ref 17592186328510} {:answer/id #uuid "07507ac3-c7ae-51c9-ac08-82526fcd0636" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{N}-1" :db/id #edb/ref 17592186328511} {:answer/id #uuid "78f4677b-eac8-53d8-9eeb-694ad7b605ac" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{N}-4" :db/id #edb/ref 17592186328512} {:answer/id #uuid "c6dc3f7f-e5f5-5214-bf72-d30fd3a3e69a" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{N}-3" :db/id #edb/ref 17592186328513}] :answer-field/correct {:answer/id #uuid "07507ac3-c7ae-51c9-ac08-82526fcd0636" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{N}-1" :db/id #edb/ref 17592186328511} :answer-field/id #uuid "419d6715-2096-56b4-aa89-51ee0efa0d11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328508}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "93687295-6e75-5f67-87ce-645c96b96031" :question/math-academy-id "q-73422" :question/problem "What is the sum of the first $N$ terms of a geometric series if the $5$th term is $2\\,500$ and the common ratio is $5?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine ${a}_{1}:$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 2\\,500 & ={a}_{1}\\cdot {5}^{(5-1)} \\\\ 2\\,500 & ={a}_{1}\\cdot {5}^{4} \\\\ 2\\,500 & =625{a}_{1} \\\\ {a}_{1} & =4\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=4$ and $r=5.$ Substituting our values into the formula for ${S}_{N}$ gives:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{4(1-{5}^{N})}{1-5} \\\\  & =\\frac{4}{(-4)}(1-{5}^{N}) \\\\  & =-(1-{5}^{N}) \\\\  & ={5}^{N}-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186328514 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd32a853-e0ec-5d56-bd6b-1c2e0e3249f8" :knowledge-point/title "Finding the Formula for the Sum of a Geometric Series Given an Arbitrary Term and the Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5a0b5e-0fac-5756-a491-78ab1fd514e3" :answer/type {:db/ident :answer.type/math} :answer/value "2({5}^{N}-1)" :db/id #edb/ref 17592186328516} {:answer/id #uuid "b639e022-fba9-5e5b-b06f-127572a60b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}({5}^{N}-1)" :db/id #edb/ref 17592186328517} {:answer/id #uuid "012bc0a3-1194-5309-9bf3-5b4a4670da7c" :answer/type {:db/ident :answer.type/math} :answer/value "4({5}^{N}-1)" :db/id #edb/ref 17592186328518} {:answer/id #uuid "cb424dc4-7f5c-5a42-8f16-8b81efd7b733" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{N}-1" :db/id #edb/ref 17592186328519} {:answer/id #uuid "fb319cfa-3b3c-5853-aca8-5d72a5152b6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({5}^{N}-1)" :db/id #edb/ref 17592186328520}] :answer-field/correct {:answer/id #uuid "fb319cfa-3b3c-5853-aca8-5d72a5152b6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({5}^{N}-1)" :db/id #edb/ref 17592186328520} :answer-field/id #uuid "9a3a5197-bb3c-53e5-bd3e-da867ed77bc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328515}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8aafe212-9325-519e-bb56-b1316fc7afa7" :question/math-academy-id "q-73423" :question/problem "What is the sum of the first $N$ terms of a geometric series if the $4$th term is $250$ and the common ratio is $5?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine ${a}_{1}:$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 250 & ={a}_{1}\\cdot {5}^{(4-1)} \\\\ 250 & ={a}_{1}\\cdot {5}^{3} \\\\ 250 & =125{a}_{1} \\\\ {a}_{1} & =\\frac{250}{125} \\\\ {a}_{1} & =2\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=2$ and $r=5.$ Substituting our values into the formula for ${S}_{N}$ gives:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{2(1-{5}^{N})}{1-5} \\\\  & =\\frac{2}{(-4)}(1-{5}^{N}) \\\\  & =-\\frac{1}{2}(1-{5}^{N}) \\\\  & =\\frac{1}{2}({5}^{N}-1)\\end{aligned}\n$$"}]}
