[{:db/id "q-276993/field-1/c3e2328e1803e7a42979b5d9a5137b2a39d4bd7c3e16f8efac2c58ed01ea3dfa" :answer/id #uuid "9ebaea0f-9d95-5a80-889d-dfb04816738d" :answer/type :answer.type/math :answer/value "3(6^N-1)" :db/ensure [:answer/validate]} {:db/id "q-276993/field-1" :answer-field/id #uuid "cf0f97c8-81c5-51fd-b0a2-c3bcec9b75c0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276993/field-1/c3e2328e1803e7a42979b5d9a5137b2a39d4bd7c3e16f8efac2c58ed01ea3dfa" :answer-field/choices ["q-276993/field-1/c3e2328e1803e7a42979b5d9a5137b2a39d4bd7c3e16f8efac2c58ed01ea3dfa"] :db/ensure [:answer-field/validate]} {:db/id "q-276993" :question/id #uuid "3d35ba27-9946-5131-9463-0bd7e5dff14c" :question/math-academy-id "q-276993" :question/problem "What is the sum of the first $N$ terms of a geometric series if the first term is $15$ and the common ratio is $6?$ Express your answer as a function of $N,$ making sure you use a capital letter $(N,$ not $n).$\n\n${S}_{N}=$\n{{field-1}}" :question/worked-solution "The sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=15$ and $r=6.$ Therefore, we have\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{15(1-{6}^{N})}{1-6} \\\\  & =-\\frac{15}{5}(1-{6}^{N}) \\\\  & =3({6}^{N}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-276993/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "97802ae1-4976-5fdf-bbe1-bcd001d5e53a"] :knowledge-point/questions ["q-276993"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5259/selection/14c61621c6856b7b1a362e23dcca207ed7629553d142327a0a5e268e45a9b1a4" :answer/id #uuid "e1da1c7b-a845-5120-8f25-a1337d02489c" :answer/type :answer.type/math :answer/value "\\frac{15}{2}(1-{3}^{N})" :db/ensure [:answer/validate]} {:db/id "q-5259/selection/dc3130116933cd43b820af81a9695d621ae4ced048b364c347edb60177c0