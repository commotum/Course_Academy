e [:answer/validate]} {:db/id "q-73422/selection/08ad2793efc7ac8f4a5fdbf7a542d61fee27547b32f6cc3d558908d72ce03215" :answer/id #uuid "42b3686d-458d-5404-a45b-871b43e23512" :answer/type :answer.type/math :answer/value "2({5}^{N}-1)" :db/ensure [:answer/validate]} {:db/id "q-73422/selection/6695e57f23d992befb9a89c0c2385902c395af208d9fa50d24a11a8dc8b29288" :answer/id #uuid "07507ac3-c7ae-51c9-ac08-82526fcd0636" :answer/type :answer.type/math :answer/value "{5}^{N}-1" :db/ensure [:answer/validate]} {:db/id "q-73422/selection/5ad6e5e546021c4b863858de93de3c6038b7ae7bb8b362c25f491cb2d78c3659" :answer/id #uuid "892a9f3a-feea-5ad1-b9e5-c102a6a43dbc" :answer/type :answer.type/math :answer/value "4({5}^{N}-3)" :db/ensure [:answer/validate]} {:db/id "q-73422/selection/75af5ac62155b51e02e5bed60341132a78834a6275eab24541e7f2de4513e663" :answer/id #uuid "78f4677b-eac8-53d8-9eeb-694ad7b605ac" :answer/type :answer.type/math :answer/value "{5}^{N}-4" :db/ensure [:answer/validate]} {:db/id "q-73422/selection" :answer-field/id #uuid "419d6715-2096-56b4-aa89-51ee0efa0d11" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73422/selection/6695e57f23d992befb9a89c0c2385902c395af208d9fa50d24a11a8dc8b29288" :answer-field/choices ["q-73422/selection/bdc9ea2f6b5c7160a1b9671670567ae7ac5d8961c90031f9b27cec932cc7194e" "q-73422/selection/08ad2793efc7ac8f4a5fdbf7a542d61fee27547b32f6cc3d558908d72ce03215" "q-73422/selection/6695e57f23d992befb9a89c0c2385902c395af208d9fa50d24a11a8dc8b29288" "q-73422/selection/5ad6e5e546021c4b863858de93de3c6038b7ae7bb8b362c25f491cb2d78c3659" "q-73422/selection/75af5ac62155b51e02e5bed60341132a78834a6275eab24541e7f2de4513e663"] :db/ensure [:answer-field/validate]} {:db/id "q-73422" :question/id #uuid "93687295-6e75-5f67-87ce-645c96b96031" :question/math-academy-id "q-73422" :question/problem "What is the sum of the first $N$ terms of a geometric series if the $5$th term is $2\\,500$ and the common ratio is $5?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine ${a}_{1}:$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 2\\,500 & ={a}_{1}\\cdot {5}^{(5-1)} \\\\ 2\\,500 & ={a}_{1}\\cdot {5}^{4} \\\\ 2\\,500 & =625{a}_{1} \\\\ {a}_{1} & =4\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=4$ and $r=5.$ Substituting our values into the formula for ${S}_{N}$ gives:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{4(1-{5}^{N})}{1-5} \\\\  & =\\frac{4}{(-4)}(1-{5}^{N}) \\\\  & =-(1-{5}^{N}) \\\\  & ={5}^{N}-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73422/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd32a853-e0ec-5d56-bd6b-1c2e0e3249f8"] :knowledge-point/questions ["q-73422"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73423/selection/6695e57f23d992befb9a89c0c2385902c395af208d9fa50d24a11a8dc8b29288" :answer/id #uuid "cb424dc4-7f5c-5a42-8f16-8b81efd7b733" :answer/type :answer.type/math :answer/value "{5}^{N}-1" :db/ensure [:answer/validate]} {:db/id "q-73423/selection/ce83974e25f22184faf643eea79ae2a4eb53bf5c1ffc94c601e7d6b297dbbb6d" :answer/id #uuid "fb319cfa-3b3c-5853-aca8-5d72a5152b6b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({5}^{N}-1)" :db/ensure [:answer/validate]} {:db/id "q-73423/selection/08ad2793efc7ac8f4a5fdbf7a542d61fee27547b32f6cc3d558908d72ce03215" :answer/id #uuid "3b5a0b5e-0fac-5756-a491-78ab1fd514e3" :answer/type :answer.type/math :answer/value "2({5}^{N}-1)" :db/ensure [:answer/validate]} {:db/id "q-73423/selection/5cb59f0ee417f16ba1f081b7e802138c8d9c6308092ef47768d1d5f763f186e1" :answer/id #uuid "012bc0a3-1194-5309-9bf3-5b4a4670da7c" :answer/type :answer.type/math :answer/value "4({5}^{N}-1)" :db/ensure [:answer/validate]} {:db/id "q-73423/selection/2143c09d9f35cea31046ef8833aa3ff1108c2e5f461e0feb921755fa2d2d0f07" :answer/id #uuid "b639e022-fba9-5e5b-b06f-127572a60b3c" :answer/type :answer.type/math :answer/value "\\frac{1}{4}({5}^{N}-1)" :db/ensure [:answer/validate]} {:db/id "q-73423/selection" :answer-field/id #uuid "9a3a5197-bb3c-53e5-bd3e-da867ed77bc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73423/selection/ce83974e25f22184faf643eea79ae2a4eb53bf5c1ffc94c601e7d6b297dbbb6d" :answer-field/choices ["q-73423/selection/6695e57f23d992befb9a89c0c2385902c395af208d9fa50d24a11a8dc8b29288" "q-73423/selection/ce83974e25f22184faf643eea79ae2a4eb53bf5c1ffc94c601e7d6b297dbbb6d" "q-73423/selection/08ad2793efc7ac8f4a5fdbf7a542d61fee27547b32f6cc3d558908d72ce03215" "q-73423/selection/5cb59f0ee417f16ba1f081b7e802138c8d9c6308092ef47768d1d5f763f186e1" "q-73423/selection/2143c09d9f35cea31046ef8833aa3ff1108c2e5f461e0feb921755fa2d2d0f07"] :db/ensure [:answer-field/validate]} {:db/id "q-73423" :question/id #uuid "8aafe212-9325-519e-bb56-b1316fc7afa7" :question/math-academy-id "q-73423" :question/problem "What is the sum of the first $N$ terms of a geometric series if the $4$th term is $250$ and the common ratio is $5?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine ${a}_{1}:$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 250 & ={a}_{1}\\cdot {5}^{(4-1)} \\\\ 250 & ={a}_{1}\\cdot {5}^{3} \\\\ 250 & =125{a}_{1} \\\\ {a}_{1} & =\\frac{250}{125} \\\\ {a}_{1} & =2\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=2$ and $r=5.$ Substituting our values into the formula for ${S}_{N}$ gives:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{2(1-{5}^{N})}{1-5} \\\\  & =\\frac{2}{(-4)}(1-{5}^{N}) \\\\  & =-\\frac{1}{2}(1-{5}^{N}) \\\\  & =\\frac{1}{2}({5}^{N}-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd32a853-e0ec-5d56-bd6b-1c2e0e3249f8"] :knowledge-point/questions ["q-73423"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4190"] :question/problem "What is the sum of the first $N$ terms of a geometric series if the first term is $-3$ and the common ratio is $2?$" :question/worked-solution "The sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\nS_N =\\dfrac{a_1(1-r^N)}{1-r}.\n$$\n\nIn this case, $a_1= -3$ and $r = 2.$ Therefore, we have\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{-3(1-{2}^{N})}{1-2} \\\\  & =\\frac{(-3)}{(-1)}(1-{2}^{N}) \\\\  & =3(1-{2}^{N}).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4191"] :question/problem "What is the sum of the first $N$ terms of the geometric series $2+8+32+\\cdots \\: ?$" :question/worked-solution "First, we determine the common ratio $r$ for this geometric series:\n\n$$\n\\begin{aligned}r & =\\frac{{a}_{2}}{{a}_{1}} \\\\  & =\\frac{8}{2} \\\\  & =4\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\nS_N = \\dfrac{a_1 (1-r^N) }{1-r}.\n$$\n\nIn this case, $a_1=2$ and $r=4.$ Substituting these values into the formula for $S_N$ gives the following:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{{a}_{1}(1-{r}^{N})}{1-r} \\\\  & =\\frac{2(1-{4}^{N})}{1-4} \\\\  & =\\frac{2(1-{4}^{N})}{(-3)} \\\\  & =-\\frac{2}{3}(1-{4}^{N}) \\\\  & =\\frac{2}{3}({4}^{N}-1)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4192"] :question/problem "What is the sum of the first $N$ terms of a geometric series if the $3$rd term is $18$ and the common ratio is $3?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine $a_1\\mathbin{:}$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 18 & ={a}_{1}\\cdot {3}^{(3-1)} \\\\ 18 & =9{a}_{1} \\\\ {a}_{1} & =2\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\nS_N = \\dfrac{a_1 (1-r^N) }{1-r}\t.\n$$\n\nIn this case, $a_1=2$ and $r=3.$ Substituting our values into the formula for $S_N$ gives\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{2(1-{3}^{N})}{1-3} \\\\  & =-\\frac{2}{2}(1-{3}^{N}) \\\\  & ={3}^{N}-1.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
