[{:db/id "q-1845/selection/ef80fb20b42f7ebe3c0bd7f7874abc2e5ccf42a4382de9d6ca908772ff43d96a" :answer/id #uuid "d964db5b-1ba8-5841-86f5-0fa71278113c" :answer/type :answer.type/math :answer/value "\\frac{2}{3\\sqrt[3]{{x}^{2}}}-5" :db/ensure [:answer/validate]} {:db/id "q-1845/selection/9a7de0bfd01a55daabff9d256f98cd38c37e10f54246de88d95649ea5ff04f3c" :answer/id #uuid "81dc6353-3d9e-5c88-901b-455046600fa4" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt[3]{x}}{3}-5" :db/ensure [:answer/validate]} {:db/id "q-1845/selection/6606a3bf2f29cf92d30798b07e93acb78532fe3848729f01af7ecaff854d9dcb" :answer/id #uuid "15e91277-f7e1-5d90-aa52-18fe129a3b5c" :answer/type :answer.type/math :answer/value "\\frac{2}{3\\sqrt[3]{x}}-5" :db/ensure [:answer/validate]} {:db/id "q-1845/selection/0fbb9e13a97da2451bdbe0a707418dd3d47eb5d1e5f1bef0605690c2762b884f" :answer/id #uuid "1eadb6e6-3f69-51ac-8bba-b03267e3dd15" :answer/type :answer.type/math :answer/value "\\frac{1}{3\\sqrt[3]{x}}-5" :db/ensure [:answer/validate]} {:db/id "q-1845/selection/2dc1f1e7603866a7b11f7555d53bd45b1c75ebd885baa139e353dccc512bfb8c" :answer/id #uuid "1403688f-f2b0-5888-9ae9-ea44a543ae4a" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt[3]{{x}^{2}}}{3}-5" :db/ensure [:answer/validate]} {:db/id "q-1845/selection" :answer-field/id #uuid "4cc0aa9b-352a-562f-ba6a-92d96a09c36e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1845/selection/6606a3bf2f29cf92d30798b07e93acb78532fe3848729f01af7ecaff854d9dcb" :answer-field/choices ["q-1845/selection/ef80fb20b42f7ebe3c0bd7f7874abc2e5ccf42a4382de9d6ca908772ff43d96a" "q-1845/selection/9a7de0bfd01a55daabff9d256f98cd38c37e10f54246de88d95649ea5ff04f3c" "q-1845/selection/6606a3bf2f29cf92d30798b07e93acb78532fe3848729f01af7ecaff854d9dcb" "q-1845/selection/0fbb9e13a97da2451bdbe0a707418dd3d47eb5d1e5f1bef0605690c2762b884f" "q-1845/selection/2dc1f1e7603866a7b11f7555d53bd45b1c75ebd885baa139e353dccc512bfb8c"] :db/ensure [:answer-field/validate]} {:db/id "q-1845" :question/id #uuid "1c2ccf62-2b83-5d0b-8d8f-47d193d15c4a" :question/math-academy-id "q-1845" :question/is-example false :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\sqrt[3]{{x}^{2}}-5x.$" :question/worked-solution "Here, we convert the radical into a rational exponent, and we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[3]{{x}^{2}}-5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2/3})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2/3})-5\\cdot \\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{2}{3}{x}^{(\\frac{2}{3}-1)}-5\\cdot 1 \\\\  & =\\frac{2}{3}{x}^{-1/3}-5 \\\\  & =\\frac{2}{3\\sqrt[3]{x}}-5\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-1845/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3"] :knowledge-point/questions ["q-1845"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1856"] :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-10291"] :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+\\frac{1}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3{x}^{(3-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =3{x}^{2}-2{x}^{-3}-1 \\\\  & =3{x}^{2}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-102192/selection/564915b8333c41b90425dd8950c9e7717d0b3f212639190c9a31062b6f114b33" :answer/id #uuid "99d16958-a5a3-503c-81cb-1965f5293d5d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/ensure [:answer/validate]} {:db/id "q-102192/selection/b034b6f153acf1e7c2bce5cfdc7cd97a009a2a3a612506836ebc0d428a19db2a" :answer/id #uuid "83ebd53f-0d0c-5b21-aa44-bf773a901b8e" :answer/type :answer.type/math :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/ensure [:answer/validate]} {:db/id "q-102192/selection/9fa080a0c0a28d083128894e10e1a1b0f3e4c121c9d49373c2bbd1fe9452f8e1" :answer/id #uuid "bc0e86e3-8b7a-5e60-8e33-e1742b0ce5a2" :answer/type :answer.type/math :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-102192/selection/5ef77d60d3d9d35c1d1e2a96ac5cf736b7309b47a58f91599d43c564139906ee" :answer/id #uuid "512f6bb7-ee78-5501-a269-b4dbd9f897e4" :answer/type :answer.type/math :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/ensure [:answer/validate]} {:db/id "q-102192/selection/85f5d3260b145b77a139a7eecc4ea623c632f832a571c25ec7badce45cdf93ff" :answer/id #uuid "99681777-7362-5d34-9fc8-5dd187b7dcb6" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-102192/selection" :answer-field/id #uuid "a64c0361-ce30-53f6-bc3e-3a68cc4b6bd9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102192/selection/b034b6f153acf1e7c2bce5cfdc7cd97a009a2a3a612506836ebc0d428a19db2a" :answer-field/choices ["q-102192/selection/564915b8333c41b90425dd8950c9e7717d0b3f212639190c9a31062b6f114b33" "q-102192/selection/b034b6f153acf1e7c2bce5cfdc7cd97a009a2a3a612506836ebc0d428a19db2a" "q-102192/selection/9fa080a0c0a28d083128894e10e1a1b0f3e4c121c9d49373c2bbd1fe9452f8e1" "q-102192/selection/5ef77d60d3d9d35c1d1e2a96ac5cf736b7309b47a58f91599d43c564139906ee" "q-102192/selection/85f5d3260b145b77a139a7eecc4ea623c632f832a571c25ec7badce45cdf93ff"] :db/ensure [:answer-field/validate]} {:db/id "q-102192" :question/id #uuid "64cbbece-20d6-57d9-997e-c59586265d30" :question/math-academy-id "q-102192" :question/is-example false :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot (-\\frac{3}{2}){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-102192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62"] :knowledge-point/questions ["q-102192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339462/field-1/66794dd3675b99c1a1e8e74f5c51bd41b6cc429ed6e8331cdd21c18e0acefc42" :answer/id #uuid "b3a016d6-84c2-55ca-b2c6-681eb5289763" :answer/type :answer.type/math :answer/value "5x^4+\\frac{4}{3}x^{1/3}" :db/ensure [:answer/validate]} {:db/id "q-339462/field-1" :answer-field/id #uuid "9fe88472-387a-53d7-b754-0ff32c499c1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339462/field-1/66794dd3675b99c1a1e8e74f5c51bd41b6cc429ed6e8331cdd21c18e0acefc42" :answer-field/choices ["q-339462/field-1/66794dd3675b99c1a1e8e74f5c51bd41b6cc429ed6e8331cdd21c18e0acefc42"] :db/ensure [:answer-field/validate]} {:db/id "q-339462" :question/id #uuid "470af339-2271-568e-8d52-fd70ed7a1ab6" :question/math-academy-id "q-339462" :question/is-example false :question/problem "Find ${f}^{′}(x)$ for $f(x)={x}^{5}+\\sqrt[3]{{x}^{4}}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The function $f(x)$  is the sum of two power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+\\sqrt[3]{{x}^{4}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{4/3}) \\\\  & =5{x}^{(5-1)}+\\frac{4}{3}{x}^{(4/3-1)} \\\\  & =5{x}^{4}+\\frac{4}{3}{x}^{1/3} \\\\  & =5{x}^{4}+\\frac{4}{3}\\sqrt[3]{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339462/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a"] :knowledge-point/questions ["q-339462"] :db/ensure [:knowledge-point/validate]}]
