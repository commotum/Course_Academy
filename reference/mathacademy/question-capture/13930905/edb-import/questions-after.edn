#{[{:db/id #edb/ref 17592186243340 :knowledge-point/_questions [{:knowledge-point/id #uuid "852449ca-b4df-5142-9540-bb503d5b7b62" :knowledge-point/title "Differentiating a Negative Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99d16958-a5a3-503c-81cb-1965f5293d5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/id #edb/ref 17592186243342} {:answer/id #uuid "512f6bb7-ee78-5501-a269-b4dbd9f897e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186243343} {:answer/id #uuid "99681777-7362-5d34-9fc8-5dd187b7dcb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}" :db/id #edb/ref 17592186243344} {:answer/id #uuid "bc0e86e3-8b7a-5e60-8e33-e1742b0ce5a2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186243345} {:answer/id #uuid "83ebd53f-0d0c-5b21-aa44-bf773a901b8e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186243346}] :answer-field/correct {:answer/id #uuid "83ebd53f-0d0c-5b21-aa44-bf773a901b8e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186243346} :answer-field/id #uuid "a64c0361-ce30-53f6-bc3e-3a68cc4b6bd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243341}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "64cbbece-20d6-57d9-997e-c59586265d30" :question/is-example false :question/math-academy-id "q-102192" :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot (-\\frac{3}{2}){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059889 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4601f65-56ce-554f-8302-77992fd08d7b" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{2} - \\frac{2}{x^{3}} + 1" :db/id #edb/ref 17592186056055} {:answer/id #uuid "0fa4eabf-c161-53fe-aca4-8c661905e9bc" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{2} - \\frac{2}{x^{3}} - 1" :db/id #edb/ref 17592186056056} {:answer/id #uuid "1aa9cdc7-0adf-5629-8727-64304c151f06" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{2} + \\frac{2}{x^{3}} - 1" :db/id #edb/ref 17592186056057} {:answer/id #uuid "59ded8f7-6906-5ec7-ac82-d3a593600270" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{3} - \\frac{2}{x^{3}} - 1" :db/id #edb/ref 17592186056058} {:answer/id #uuid "6f367620-8956-551d-ba36-8fc4f9ff1499" :answer/type {:db/ident :answer.type/math} :answer/value "6x^{2} - \\frac{2}{x^{3}} - 1" :db/id #edb/ref 17592186056059}] :answer-field/correct {:answer/id #uuid "0fa4eabf-c161-53fe-aca4-8c661905e9bc" :answer/type {:db/ident :answer.type/math} :answer/value "3x^{2} - \\frac{2}{x^{3}} - 1" :db/id #edb/ref 17592186056056} :answer-field/id #uuid "e25d7ca4-18ff-5be7-b973-c5ae2832b263" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056054}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "723e7a54-cfc4-55b5-8c13-7066946d5c44" :question/is-example false :question/math-academy-id "q-10291" :question/problem "Find $f^{′}(x)$ for $f(x) = x^{3} + \\frac{1}{x^{2}} - x$." :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+\\frac{1}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3{x}^{(3-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =3{x}^{2}-2{x}^{-3}-1 \\\\  & =3{x}^{2}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243347 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eadb6e6-3f69-51ac-8bba-b03267e3dd15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt[3]{x}}-5" :db/id #edb/ref 17592186243349} {:answer/id #uuid "1403688f-f2b0-5888-9ae9-ea44a543ae4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{{x}^{2}}}{3}-5" :db/id #edb/ref 17592186243350} {:answer/id #uuid "15e91277-f7e1-5d90-aa52-18fe129a3b5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\sqrt[3]{x}}-5" :db/id #edb/ref 17592186243351} {:answer/id #uuid "81dc6353-3d9e-5c88-901b-455046600fa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{x}}{3}-5" :db/id #edb/ref 17592186243352} {:answer/id #uuid "d964db5b-1ba8-5841-86f5-0fa71278113c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\sqrt[3]{{x}^{2}}}-5" :db/id #edb/ref 17592186243353}] :answer-field/correct {:answer/id #uuid "15e91277-f7e1-5d90-aa52-18fe129a3b5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\sqrt[3]{x}}-5" :db/id #edb/ref 17592186243351} :answer-field/id #uuid "4cc0aa9b-352a-562f-ba6a-92d96a09c36e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243348}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1c2ccf62-2b83-5d0b-8d8f-47d193d15c4a" :question/is-example false :question/math-academy-id "q-1845" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\sqrt[3]{{x}^{2}}-5x.$" :question/worked-solution "Here, we convert the radical into a rational exponent, and we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[3]{{x}^{2}}-5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2/3})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2/3})-5\\cdot \\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{2}{3}{x}^{(\\frac{2}{3}-1)}-5\\cdot 1 \\\\  & =\\frac{2}{3}{x}^{-1/3}-5 \\\\  & =\\frac{2}{3\\sqrt[3]{x}}-5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060095 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8e49a0c-9575-5bd0-af4e-6463495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89fc9be9-7140-54af-88c1-ea459f5feabf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{3}} - \\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186057392} {:answer/id #uuid "8c93ed67-10eb-5ff1-becb-5a11f35b75ae" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{3}} - \\frac{9}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186057393} {:answer/id #uuid "c224f4ed-e9d7-5e4d-8d28-8dbd9437585e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{3}} - \\frac{9x^{1/4}}{4}" :db/id #edb/ref 17592186057394} {:answer/id #uuid "d5afe202-85aa-5b5b-b359-13c6c5e8baab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{2}} - 9x^{3}" :db/id #edb/ref 17592186057395} {:answer/id #uuid "38cc043c-c904-5177-a827-e68b557dcb0e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{3}} + \\frac{9x^{-1/4}}{4}" :db/id #edb/ref 17592186057396}] :answer-field/correct {:answer/id #uuid "89fc9be9-7140-54af-88c1-ea459f5feabf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{3}} - \\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186057392} :answer-field/id #uuid "1b8e1a0a-6582-5a81-aeac-cc488876f956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057391}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "76292ca7-955e-5da2-801e-cf1602a2e16d" :question/is-example false :question/math-academy-id "q-1856" :question/problem "Calculate $\\frac{dy}{dx}$ for $y = \\frac{2}{x^{2}} - 3x^{3/4}$." :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243354 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3a016d6-84c2-55ca-b2c6-681eb5289763" :answer/type {:db/ident :answer.type/math} :answer/value "5x^4+\\frac{4}{3}x^{1/3}" :db/id #edb/ref 17592186243356}] :answer-field/correct {:answer/id #uuid "b3a016d6-84c2-55ca-b2c6-681eb5289763" :answer/type {:db/ident :answer.type/math} :answer/value "5x^4+\\frac{4}{3}x^{1/3}" :db/id #edb/ref 17592186243356} :answer-field/id #uuid "9fe88472-387a-53d7-b754-0ff32c499c1c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186243355}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "470af339-2271-568e-8d52-fd70ed7a1ab6" :question/is-example false :question/math-academy-id "q-339462" :question/problem "Find ${f}^{′}(x)$ for $f(x)={x}^{5}+\\sqrt[3]{{x}^{4}}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The function $f(x)$  is the sum of two power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+\\sqrt[3]{{x}^{4}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{4/3}) \\\\  & =5{x}^{(5-1)}+\\frac{4}{3}{x}^{(4/3-1)} \\\\  & =5{x}^{4}+\\frac{4}{3}{x}^{1/3} \\\\  & =5{x}^{4}+\\frac{4}{3}\\sqrt[3]{x}.\\end{aligned}\n$$"}]}
