^{2}⁡x({sec}^{2}⁡x-{tan}^{2}⁡x)+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x\\cdot 1+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x+1}\\end{aligned}\n$$\n\nFinally, we can use $(1),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{{tan}^{2}⁡x+1} & =\\frac{1}{{sec}^{2}⁡x} \\\\  & ={(\\frac{1}{\\operatorname{sec}⁡x})}^{2} \\\\  & ={cos}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1}={cos}^{2}⁡x.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8"] :knowledge-point/questions ["q-120807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120667/selection/edb0ac007884289ce23f3fae57ec27526ff98fc4ec3e93d8e6a90df2f1357269" :answer/id #uuid "d528e988-94d4-503a-8a85-0778dfd22712" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡x-1" :db/ensure [:answer/validate]} {:db/id "q-120667/selection/e8ea7160322676d6646a90b732b017a6c491dfab31a46056a1cd22810ba857b2" :answer/id #uuid "1bbfc53f-c97f-5831-a9fb-e8b16871725d" :answer/type :answer.type/math :answer/value "1-\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-120667/selection/9ab48649008bac28ee0df62c64cc3060c4fde298bac9feaef461ab0fe2acf074" :answer/id #uuid "fc2976f6-7e0e-53cf-a636-74b5b3746675" :answer/type :answer.type/math :answer/value "2\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-120667/selection/65155ed23bf7a682aaeaf75d6c377dc91771579080a86fd383e90ddd6118c1ec" :answer/id #uuid "ac8a12e0-b2ce-5467-b8ef-e089b52f02b4" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-120667/selection/db9261ba32573026e20e956859fd3fd30df5c6128b4cec01786d82be9470be4a" :answer/id #uuid "c91aef0e-9e07-5889-b264-09e4c1ce89e2" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-120667/selection" :answer-field/id #uuid "e65a0305-9619-57b3-b126-4a8a86027b26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120667/selection/65155ed23bf7a682aaeaf75d6c377dc91771579080a86fd383e90ddd6118c1ec" :answer-field/choices ["q-120667/selection/edb0ac007884289ce23f3fae57ec27526ff98fc4ec3e93d8e6a90df2f1357269" "q-120667/selection/e8ea7160322676d6646a90b732b017a6c491dfab31a46056a1cd22810ba857b2" "q-120667/selection/9ab48649008bac28ee0df62c64cc3060c4fde298bac9feaef461ab0fe2acf074" "q-120667/selection/65155ed23bf7a682aaeaf75d6c377dc91771579080a86fd383e90ddd6118c1ec" "q-120667/selection/db9261ba32573026e20e956859fd3fd30df5c6128b4cec01786d82be9470be4a"] :db/ensure [:answer-field/validate]} {:db/id "q-120667" :question/id #uuid "92a99f57-2296-5ef9-bfb2-645e5be59829" :question/math-academy-id "q-120667" :question/problem "Which of the following is equivalent to $\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1}?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(1),$ as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1} & =\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-({tan}^{2}⁡x+1)} \\\\  & =\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{sec}^{2}⁡x}\\end{aligned}\n$$\n\nFinally, we can further simplify our expression, as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{sec}^{2}⁡x} & =\\frac{{sec}^{2}⁡x}{{sec}^{2}⁡x({sec}^{2}⁡x-1)} \\\\  & =\\frac{\\cancel{{sec}^{2}⁡x}}{\\cancel{{sec}^{2}⁡x}({sec}^{2}⁡x-1)} \\\\  & =\\frac{1}{{sec}^{2}⁡x-1} \\\\  & =\\frac{1}{(1+{tan}^{2}⁡x)-1} \\\\  & =\\frac{1}{{tan}^{2}⁡x} \\\\  & ={(\\frac{1}{\\operatorname{tan}⁡x})}^{2} \\\\  & ={cot}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{sec}^{2}⁡x}{{sec}^{4}⁡x-{tan}^{2}⁡x-1}={cot}^{2}⁡x.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120667/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8"] :knowledge-point/questions ["q-120667"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120666/selection/d80fca90810a7d7edd794a7279ba92c13439dd7dbd0be6189093b1e02f818471" :answer/id #uuid "143756e1-2d1c-5415-8d60-ce7e51a468e4" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡\\theta +2" :db/ensure [:answer/validate]} {:db/id "q-120666/selection/04ca86571b6d4473ec2d14252b799d04f4df62ad3e2d5fccd0215bea02ebbd8a" :answer/id #uuid "aa75f0f7-9024-57fb-b774-3daae61d1657" :answer/type :answer.type/math :answer/value "-{sec}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-120666/selection/ec5058c1fc535dfcef8a2bf5b570fcb482aac941ba22108fe04bc2e6c6d4b7b7" :answer/id #uuid "c278de93-309a-580c-bf6e-c58771d04fae" :answer/type :answer.type/math :answer/value "{sec}^{2}⁡\\theta -2" :db/ensure [:answer/validate]} {:db/id "q-120666/selection/6cc445e05e1bfd47df2232290f3b26ce27802a52f37fd7b15141160ddd8dea13" :answer/id #uuid "8b346724-4fc0-5285-880c-cd0e1c774f4a" :answer/type :answer.type/math :answer/value "1-\\operatorname{sec}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-120666/selection/0e12f908604aabb2d8221c3da3bd6ad1a1bd3ffa2437d35681391b8808a68398" :answer/id #uuid "00523e45-1eb6-594c-b159-e3ed07485eaf" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-120666/selection" :answer-field/id #uuid "e6175e4b-9b4b-5387-8288-ff45b0975c81" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120666/selection/ec5058c1fc535dfcef8a2bf5b570fcb482aac941ba22108fe04bc2e6c6d4b7b7" :answer-field/choices ["q-120666/selection/d80fca90810a7d7edd794a7279ba92c13439dd7dbd0be6189093b1e02f818471" "q-120666/selection/04ca86571b6d4473ec2d14252b799d04f4df62ad3e2d5fccd0215bea02ebbd8a" "q-120666/selection/ec5058c1fc535dfcef8a2bf5b570fcb482aac941ba22108fe04bc2e6c6d4b7b7" "q-120666/selection/6cc445e05e1bfd47df2232290f3b26ce27802a52f37fd7b15141160ddd8dea13" "q-120666/selection/0e12f908604aabb2d8221c3da3bd6ad1a1bd3ffa2437d35681391b8808a68398"] :db/ensure [:answer-field/validate]} {:db/id "q-120666" :question/id #uuid "4d22fb34-9950-5741-aa15-32ef6c45e5c6" :question/math-academy-id "q-120666" :question/problem "Which of the following is equivalent to $\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta }?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta } & =\\frac{{tan}^{4}⁡\\theta -({sec}^{2}⁡\\theta -1)}{{tan}^{2}⁡\\theta } \\\\  & =\\frac{{tan}^{4}⁡\\theta -{tan}^{2}⁡\\theta }{{tan}^{2}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we can further simplify our expression and use again $(2)$, as follows:\n\n$$\n\\begin{aligned}\\frac{{tan}^{4}⁡\\theta -{tan}^{2}⁡\\theta }{{tan}^{2}⁡\\theta } & =\\frac{{tan}^{2}⁡\\theta ({tan}^{2}⁡\\theta -1)}{{tan}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{tan}^{2}⁡\\theta }({tan}^{2}⁡\\theta -1)}{\\cancel{{tan}^{2}⁡\\theta }} \\\\  & ={tan}^{2}⁡\\theta -1 \\\\  & =({sec}^{2}⁡\\theta -1)-1 \\\\  & ={sec}^{2}⁡\\theta -2\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta }={sec}^{2}⁡\\theta -2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120666/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8"] :knowledge-po