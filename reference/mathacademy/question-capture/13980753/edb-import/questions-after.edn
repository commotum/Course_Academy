/13980753/assets/caa67175ab6237629bfb168e98f4399103e03ce603004aed8f23d2d14b01d7a8.png" :db/id #edb/ref 17592186281210} :answer-field/id #uuid "bd28f424-a219-5c2f-81fc-07a49801f798" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281206}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fcbb935c-0e69-53bf-8029-fbd172319da8" :question/math-academy-id "q-104036" :question/problem "Select the function that has a discontinuity at $x=-2.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a jump exactly at $x=-2$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980753/assets/05ad378968e143e83dab8d50608e6db7ccaf97f5e1a8f2ee83d2f893e3d820c3.png)\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186281212 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ccba1ce-df30-5537-9903-3539c59244a1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186281214} {:answer/id #uuid "4f4c715d-922e-5f15-a7c5-7d8861065287" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186281215} {:answer/id #uuid "d9318cab-6240-5247-92be-6dbae81f6d7c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281216} {:answer/id #uuid "060f2bab-5815-509c-87b6-cca9bc209c9a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186281217} {:answer/id #uuid "d7ada344-5734-567e-8b91-6b033af9fcfa" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281218}] :answer-field/correct {:answer/id #uuid "0ccba1ce-df30-5537-9903-3539c59244a1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186281214} :answer-field/id #uuid "32321e97-b95f-52de-bf4b-99684620297d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281213}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "af1da89e-6dd1-5d6d-99dd-762b173b6a23" :question/math-academy-id "q-104124" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980753/assets/bdcfa35fb04028cbff32992b41214c878443d3815b676a0cf046f5a99bd771bd.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is **not** defined at $x=-2$\n- ${lim}_{x\\to \\,-2}f(x)=f(-2)$\n- $f(x)$ is continuous at $x=-2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. Indeed, $f(x)$ is defined at $x=-2$ and $f(-2)=5.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{2}^{-}}f(x) & =5, \\\\ {lim}_{x\\to \\,-{2}^{+}}f(x) & =5.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,-2}f(x)=5=f(-2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=-2.$"}] [{:db/id #edb/ref 17592186281219 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c5e13a8-bedb-550c-b1e6-d42a04636ba7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186281221} {:answer/id #uuid "d0211631-c43d-5c39-9af5-32714e3b79fe" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186281222} {:answer/id #uuid "75b34151-a605-554a-90dc-34445553f367" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281223} {:answer/id #uuid "43ec9045-664a-5087-908c-b8ecfed1728a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186281224} {:answer/id #uuid "e4c4edd6-1a26-574e-b1f5-eb64173b1e71" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186281225}] :answer-field/correct {:answer/id #uuid "d0211631-c43d-5c39-9af5-32714e3b79fe" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186281222} :answer-field/id #uuid "dfefd75d-07e6-504b-bb74-0ac875813837" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281220}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9a5d50fd-2105-50c1-b271-583fe4966ec5" :question/math-academy-id "q-48040" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980753/assets/59c02273515e87fcebb8eb1785dc2cf0c6490feda4fc9644df43b8849921eec5.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=-1$\n- ${lim}_{x\\to \\,-1}f(x)$ exists\n- $f(x)$ is continuous at $x=-1$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. The function $f(x)$ is defined at $x=-1$ and we have $f(-1)=1.$\n\n- Statement II is false. We get \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{1}^{-}}f(x) & =2, \\\\ {lim}_{x\\to \\,-{1}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, both left-hand side and right-hand side limits exist but they are not the same. Therefore, ${lim}_{x\\to \\,-1}f(x)$ does not exist.\n\n- Statement III is false. The function contains a break exactly at $x=-1$ and it's impossible to draw its graph without taking our pencil off of the paper."}] [{:db/id #edb/ref 17592186069289 :knowledge-point/_questions [{:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa17146-c6c7-5f57-99cb-8b4f88241e1c" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 2$ and $x = 0$" :db/id #edb/ref 17592186067266} {:answer/id #uuid "f56223ce-52c2-5805-b123-5b321403e168" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186067267} {:answer/id #uuid "fe31fb35-056a-5723-b579-c5fcb9207404" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186067268} {:answer/id #uuid "0f09c3a6-6f34-51bf-9fbc-ff068943f2ad" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-2$ and $x = 0$" :db/id #edb/ref 17592186067269} {:answer/id #uuid "4ff820fc-2a81-54bf-9357-bc56abc716af" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 2" :db/id #edb/ref 17592186067270}] :answer-field/correct {:answer/id #uuid "0f09c3a6-6f34-51bf-9fbc-ff068943f2ad" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-2$ and $x = 0$" :db/id #edb/ref 17592186067269} :answer-field/id #uuid "79a76400-df25-5acb-8a89-5231f72c68bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067265}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ea8e67f7-a331-5a5a-8338-679b56a16346" :question/math-academy-id "q-48080" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980753/assets/374abcb470bfde0688def89290c8c1d639bf025afde150ccb9dd848c1fcc9a0f.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-2$ and $x=0$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-2$ and $x=0.$"}] [{:db/id #edb/ref 17592186281226 :knowledge-point/_questions [{:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91153512-cc48-5d37-bd38-b2e9e9a281d1" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186281228} {:answer/id #uuid "0d0f2583-9b59-5da9-b54d-1b663a571f98" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186281229} {:answer/id #uuid "ce306621-d6f8-5102-86d6-206fc70fe17b" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186281230} {:answer/id #uuid "b0860d22-ccb0-51ef-94f5-2a6c1dc93bff" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186281231} {:answer/id #uuid "41802a34-2f4f-586f-959c-44a51f853fb5" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=0$" :db/id #edb/ref 17592186281232}] :answer-field/correct {:answer/id #uuid "91153512-cc48-5d37-bd38-b2e9e9a281d1" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186281228} :answer-field/id #uuid "06492b5e-292d-55de-94e3-eed67f0b3b2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281227}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e1be977e-f400-57c2-8b54-c7545b58f2e9" :question/math-academy-id "q-48087" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980753/assets/2f53373ebbb7e812471001388ba88122afbde3