 \\sqrt{5} & \\sqrt{6} & \\sqrt{2} \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{aligned}],\\,C=[\\begin{aligned}-1 & 3 & 1 \\\\ -4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993704/state.json" "file_sha256" "70a8f7526f69a86b8b2e165d85be18374cc9cd6830af982ad41ddca69349071b"} {"question" "q-130269" "field" nil "attribute" "question/worked-solution" "value" "We can apply the distributive law\n\n$$\nBA+BC=B(A+C).\n$$\n\nSo, we calculate $A+C$ first:\n\n$$\n\\begin{aligned}A+C & =[\\begin{aligned}1 & -3 & -1 \\\\ 4 & -2 & 3 \\\\ -5 & 1 & 2\\end{aligned}]+[\\begin{aligned}-1 & 3 & 1 \\\\ -4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}BA+BC & =B(A+C) \\\\  & =[\\begin{aligned}8 & \\sqrt{3} & \\sqrt{7} \\\\ \\sqrt{5} & \\sqrt{6} & \\sqrt{2} \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{aligned}][\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993704/state.json" "file_sha256" "70a8f7526f69a86b8b2e165d85be18374cc9cd6830af982ad41ddca69349071b"} {"question" "q-130269" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993704/activity-metadata.json" "file_sha256" "442e8807297dc2494084b95676f504ca51d5b48601a0223f31f0024d65b046fe"} {"question" "q-130269" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993704/state.json" "file_sha256" "70a8f7526