aligned}],\\,C=[\\begin{aligned}1 & -2 & \\sqrt{6} \\\\ 0 & 1 & -1 \\\\ 2 & 0 & 3\\end{aligned}].\n$$\n\n|  |  | $0$ | $0$ | $0$ |  |\n| --- | --- | --- | --- | --- | --- |\n| $AC+BC=\\,\\,$ |  | {{field-1}} | $0$ | $0$ |  |\n|  |  | $3$ | {{field-2}} | {{field-3}} |  |" :question/worked-solution "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}2 & -1 & 5 \\\\ 4 & 0 & -2 \\\\ 1 & 3 & -4\\end{aligned}]+[\\begin{aligned}-2 & 1 & -5 \\\\ -4 & 0 & 2 \\\\ 2 & -3 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 3 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 3 & 0 & 0\\end{aligned}][\\begin{aligned}1 & -2 & \\sqrt{6} \\\\ 0 & 1 & -1 \\\\ 2 & 0 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 3 & -6 & 3\\sqrt{6}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319886/field-1" "q-319886/field-2" "q-319886/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea"] :knowledge-point/questions ["q-319886"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42259/selection/912f65179c34955b8bea0c1ea901ae7af350eb086792425dc59378bed4c038e1" :answer/id #uuid "ce4ba81a-30af-5f74-8a3a-41bbba49b9f3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -2 \\\\ 15 & -7 \\\\ 9 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42259/selection/fb44e07dbac5565a6f8c6d7b4376c653bebe309d618b85becc1c5cd6292e1ebe" :answer/id #uuid "6afb5fc9-7206-5106-8439-2fdb34add402" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42259/selection/d4200cd959d08c19c94a4e09bab5523013ef66bfdf12fba4dd2ce64573aee847" :answer/id #uuid "632f1952-6cb