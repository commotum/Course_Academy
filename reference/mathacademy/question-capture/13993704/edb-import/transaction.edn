\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42259/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a"] :knowledge-point/questions ["q-42259"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42001/selection/b6e2b4f031f2728e22c5bdeb23508f2ff2d96ef18bcb75b3fcd3da657429a838" :answer/id #uuid "881f57bb-479b-5b8e-8d7f-0c549e81b862" :answer/type :answer.type/math :answer/value "[\\begin{aligned}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42001/selection/f866f5392569117b766abfd16deaccde33bf82ab38fb5120d21e4d3e19e6cfef" :answer/id #uuid "087bc156-bdfb-592d-896a-4cca3f807665" :answer/type :answer.type/math :answer/value "-144" :db/ensure [:answer/validate]} {:db/id "q-42001/selection/16106c3d33b36871163750aaa0e5d72099a3f927756e68fce3be4d640f7f6256" :answer/id #uuid "678b2272-7810-5f56-a6ac-c62a10f854fd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 & 18 & 9 \\\\ 21 & 7 & -42 \\\\ 8 & 2 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42001/selection/476f0ebd28d2a012d47a6722d2dc7c9798e6bfd5f81b0d56b823aec61d9357e8" :answer/id #uuid "158cb1d4-a4f8-5487-99e1-767acc3a676f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42001/selection/85fea23eccffda15f4e80304f3874528b67acdba847ba3be77870cd35718d4a7" :answer/id #uuid "761fb85b-7392-51f2-a63e-085c9a729140" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-18 \\\\ 42 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42001/selection" :answer-field/id #uuid "e140af37-5d21-52b2-9992-47ed85fb2f2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42001/selection/476f0ebd28d2a012d47a6722d2dc7c9798e6bfd5f81b0d56b823aec61d9357e8" :answer-field/choices ["q-42001/selection/b6e2b4f031f2728e22c5bdeb23508f2ff2d96ef18bcb75b3fcd3da657429a838" "q-42001/selection/f866f5392569117b766abfd16deaccde33bf82ab38fb5120d21e4d3e19e6cfef" "q-42001/selection/16106c3d33b36871163750aaa0e5d72099a3f927756e68fce3be4d640f7f6256" "q-42001/selection/476f0ebd28d2a012d47a6722d2dc7c9798e6bfd5f81b0d56b823aec61d9357e8" "q-42001/selection/85fea23eccffda15f4e80304f3874528b67acdba847ba3be77870cd35718d4a7"] :db/ensure [:answer-field/validate]} {:db/id "q-42001" :question/id #uuid "638edf80-8d70-51f1-a06b-07cfe064f004" :question/math-academy-id "q-42001" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ -4\\end{aligned}],\\,C=[\\begin{aligned}-2 & 0 & 1\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}9 \\\\ -21 \\\\ -4\\end{aligned}]\\cdot [\\begin{aligned}-2 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42001/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a"] :knowledge-point/questions ["q-42001"] :db/ensure [:knowledge-point/validate]} {:db/id "q-41981/selection/8434b13432a11804b2a9de7475dacec2ca8a24aade11115c16d8cacde7dbb9a3" :answer/id #uuid "258bfa2d-a48c-5056-8ae9-76b8d70f3893" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41981/selection/5f031bc386cf5f155c98bdae49825741a2b9a03b80e06760e74f7e4c6569d75e" :answer/id #uuid "c190782d-1973-5aaa-8f88-3e28701c95ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & -3 \\\\ 4 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41981/selection/bcda56530289447f74d54d2cf27728163756b1798133e72544698ac76f72e54f" :answer/id #uuid "54bbf7dd-9203-553e-adea-251bf86bde4e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 5 \\\\ 1 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41981/selection/1f9a6c59cec0317666fc3299578ca357f65f3545c14cac84fa6a0973fb09ba93" :answer/id #uuid "1cbcf2da-e996-5a8b-860a-aafce6954cde" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-41981/selection/438be2452a6469acf6a997bec88b7f44e76233d95809ee98bf61a610e76646d6" :answer/id #u