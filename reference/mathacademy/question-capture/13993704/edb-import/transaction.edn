nd{aligned}]\\cdot [\\begin{aligned}4 & -3 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-41981/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a"] :knowledge-point/questions ["q-41981"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320021/field-1/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "c4f8f3f2-f2e9-5d09-a854-78edc7b7baa4" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-320021/field-1" :answer-field/id #uuid "1b570fa3-72c2-5f55-81d6-ae0bb06bbf80" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320021/field-1/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer-field/choices ["q-320021/field-1/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a"] :db/ensure [:answer-field/validate]} {:db/id "q-320021/field-2/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "2104c358-58e3-5f20-a163-71281139f15f" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-320021/field-2" :answer-field/id #uuid "4b46c9a9-afd0-56ba-be3b-1cfb4e741c5e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320021/field-2/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer-field/choices ["q-320021/field-2/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f"] :db/ensure [:answer-field/validate]} {:db/id "q-320021/field-3/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer/id #uuid "d9f715ba-feac-55d0-99f0-0e365b187cae" :answer/type :answer.type/math :answer/value "-60" :db/ensure [:answer/validate]} {:db/id "q-320021/field-3" :answer-field/id #uuid "f709ce3d-b369-563e-a497-8cf0e17d7488" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320021/field-3/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer-field/choices ["q-320021/field-3/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454"] :db/ensure [:answer-field/validate]} {:db/id "q-320021" :question/id #uuid "2f9ab189-3c3f-545e-b1e3-3d9c6e402fbc" :question/math-academy-id "q-320021" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}6 & -2\\end{aligned}],\\,B=[\\begin{aligned}-1 \\\\ 3\\end{aligned}],\\,C=[\\begin{aligned}2 & -4 & 5\\end{aligned}].\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} |  |\n| --- | --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}6 & -2\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}6\\cdot (-1)+(-2)\\cdot 3\\end{aligned}] \\\\  & =[\\begin{aligned}-6-6\\end{aligned}] \\\\  & =[\\begin{aligned}-12\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $(AB)$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)\\,C \\\\  & =[\\begin{aligned}-12\\end{aligned}]\\cdot [\\begin{aligned}2 & -4 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}-24 & 48 & -60\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-320021/field-1" "q-320021/field-2" "q-320021/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a"] :knowledge-point/questions ["q-320021"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42002/selection/17fada85584d6810ac51f378291c80cb14b6b069d58621ea509357057ff651ff" :answer/id #uuid "25e42f31-ce99-56b3-a1be-a057ca8ca9fe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-12 \\\\ 24 \\\\ 36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42002/selection/92b6c1ed52e8fb8f081d10b0ac8756ad8221d18b4b0249ecde4d0479222d2665" :answer/id #uuid "bb4746b8-8929-5ea4-ba22-0392651e3c18" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 & 30 & 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42002/selection/72fa68307421ef7b3a285e867a026e20fc8311c3d75e5d0ed68f28c7f04e2b87" :answer/id #uuid "ee0ed742-e1f6-5663-99d9-1c72bc05efc5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-18 \\\\ 30 \\\\ 36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42002/selection/86250abc9363cd9f47aae8739112a559a3467b82e349d856dad5f457e1cb3940" :answer/id #uuid "3f1300f1-da6c-54d4-9bf5-43b4a440058b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42002/selection/709160133fa3e56f6a06478b59cd8f69df5a0418eea3c1060918b4973a2c3066" :answer/id #uuid "d625c701-2a09-57dc-80a3-3c8a8cdac641" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 \\\\ -12 \\\\ 24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-42002/selection" :answer-field/id #uuid "b2b9f858-7dcf-5f42-8200-6e0474bc0024" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42002/selection/17fada85584d6810ac51f378291c80cb14b6b069d58621ea509357057ff651ff" :answer-field/choices ["q-42002/selection/17fada85584d6810ac51f378291c80cb14b6b069d58621ea509357057ff651ff" "q-42002/selection/92b6c1ed52e8fb8f081d10b0ac8756ad8221d18b4b0249ecde4d0479222d2665" "q-42002/selection/72fa68307421ef7b3a285e867a026e20fc8311c3d75e5d0ed68f28c7f04e2b87" "q-42002/selection/86250abc9363cd9f47aae8739112a559a3467b82e349d856dad5f457e1cb3940" "q-42002/selection/709160133fa3e56f6a06478b59cd8f69df5a0418eea3c1060918b4973a2c3066"] :db/ensure [:answer-field/validate]} {:db/id "q-42002" :question/id #uuid "1320ce80-071b-5207-9487-c1aca0bbdba8" :question/math-academy-id "q-42002" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}-2 \\\\ 4 \\\\ 6\\end{aligned}],\\,B=[\\begin{aligned}2 & -2\\end{aligned}],\\,C=[\\begin{aligned}3 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 1$ matrix, $B$ is a $1\\times 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}2 & -2\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}6\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}-2 \\\\ 4 \\\\ 6\\end{aligned}]\\cdot [\\begin{aligned}6\\end{aligned}] \\\\  & =[\\begin{aligned}-12 \\\\ 24 \\\\ 36\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42002/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a"] :knowledge-point/questions ["q-42002"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75664/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "b0d8c0eb-c319-51a4-a17e-f56d510bc0ca" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-75664/selection/431472f1dab61ef54de031c09a96f