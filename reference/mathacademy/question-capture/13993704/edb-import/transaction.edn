& 0 & 4 \\\\ 0 & -4 & 0 \\\\ 4 & 0 & 4\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319922/field-1" "q-319922/field-2" "q-319922/field-3" "q-319922/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea"] :knowledge-point/questions ["q-319922"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75635/selection/51d93b32a266e01e1e0060a3ac5b421c321d6262da723658b110de696ad98100" :answer/id #uuid "0ca157dc-147d-540e-9749-22b509872430" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75635/selection/c07bc736a011ea5ba72069be49212cc91b96182d44bc55a2be7c1030e5a3e57f" :answer/id #uuid "077f2322-1f5c-5980-b3ab-e7385960d58c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 & 2 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75635/selection/e40778d09900babaff33948bb2af4b0e41c815c72b6db753b3c251151e7c2622" :answer/id #uuid "aa169583-c312-5ca4-af40-927d15f44ccb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 & -2 \\\\ 0 & -1 & 0 \\\\ -2 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75635/selection/4672409ed94c04eea0dea003268f44fab69f3bb3eef24e454639cb2d22de802e" :answer/id #uuid "7e805fb9-aa02-5856-8112-843cde035385" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75635/selection/3b3656c0f500a2124b5760cc8985717a016b5850b49b73e8c2f161888baf348a" :answer/id #uuid "58a051e9-615d-5a50-a282-bff34c7c16e7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 0 & 4 \\\\ 0 & 2 & 0 \\\\ 4 & 0 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75635/selection" :answer-field/id #uuid "29de7b83-7106-5dcb-94e1-ef84c75d8