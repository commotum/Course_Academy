ion/baf1465a83ab7a99159b6b0d3d697fa0dd043bebba36f4ad5327c1a5097711eb" "q-142390/selection/0b29fc10847b183a050d6ec901d3b8da4123300e9a6ebf32cc14f4724fe3fb7f"] :db/ensure [:answer-field/validate]} {:db/id "q-142390" :question/id #uuid "9bba3045-3b2b-590f-bed1-ad9f6f458f1c" :question/math-academy-id "q-142390" :question/problem "Which of the following is equivalent to \n${\\int }_{-1}^{5}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}}?$" :question/worked-solution "This is an improper integral of the second kind because the function under the integral is unbounded as we approach the *upper* integration limit from any point that lies in the interval $x\\in (-1,5):$\n\n$$\nf(x)=\\frac{1}{\\sqrt{25-{x}^{2}}}\\to \\infty \\,\\text{as}\\,x\\to {5}^{-}\n$$\n\nWe can attempt to evaluate this integral by integrating $f(x)$ over the interval $x\\in [-1,b]$ and taking the limit as $b\\to {5}^{-}:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{5}\\frac{1}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & ={lim}_{b\\to {5}^{-}}({\\int }_{-1}^{b}\\frac{1}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-142390/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a83d52a4-6f69-5607-8753-e96c13bd7209"] :knowledge-point/questions ["q-142390"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142389/selection/f0ad4aed150a207f8c6e9a36a082e4a4277dc96178aa696cd112df1309a8b86c" :answer/id #uuid "a43817c5-4c5b-50eb-95dd-c9c21753d221" :answer/type :answer.type/math :answer/value "{lim}_{a\\to {4}^{+}}({\\int }_{1}^{a}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/ensure [:answer/validate]} {:db/id "q-142389/selection/1f780f8bd2cd27fe05fd39e904a28e14d2ed222b0362df33d7ffa0becc87beab" :answer/id #uuid "c3da3169-5260-58f9-83dc-ad6f2abe447a" :answer/type :answer.type/math :answer/value "{lim}_{a\\to {1}^{+}}({\\int }_{a}^{4}\\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x)" :db/ensure [:answer/validate]} {:db/id "q-142389/sel