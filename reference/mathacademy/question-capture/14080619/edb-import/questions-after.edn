1}{5}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386114 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2bec2b-1295-561b-88bd-c350975daa7a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{5}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/id #edb/ref 17592186386116} {:answer/id #uuid "e5c2a2a3-f14a-5e45-a22b-9a63e207be57" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186386117} {:answer/id #uuid "063ab8b7-d4dd-5e4a-893d-3e9a78283611" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=3{R}_{2},\\,{R}_{1}:={R}_{1}+5{R}_{2}" :db/id #edb/ref 17592186386118} {:answer/id #uuid "cacd7b05-3c6b-5e6d-ab18-1916bc907620" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186386119} {:answer/id #uuid "e62a602d-46e8-5f7d-92b4-d9d9daac470e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186386120}] :answer-field/correct {:answer/id #uuid "e5c2a2a3-f14a-5e45-a22b-9a63e207be57" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186386117} :answer-field/id #uuid "c20189b7-04e0-57b7-9592-81dfb42ed8e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386115}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0ac0783b-5b73-5c8c-959b-6029e5d56c68" :question/math-academy-id "q-31872" :question/problem "The inverse of the matrix $J$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[J\\,|\\,I] & =[\\begin{aligned}2 & -5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $J$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $J$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[J\\,|\\,I] & =[\\begin{aligned}2 & -5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] & {R}_{1} & :={R}_{1}+\\frac{5}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}.\n$$\n\nThe matrix ${J}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{J}^{-1}=[\\begin{aligned}\\frac{1}{2} & \\frac{5}{6} \\\\ 0 & \\frac{1}{3}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386121 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa4cb16-32bc-5407-9cba-6ec88a3e6469" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1},\\,{R}_{1}:={R}_{1}+4{R}_{2}" :db/id #edb/ref 17592186386123} {:answer/id #uuid "50e88431-682f-57ff-8120-e35bc2a9a66b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{3}{4}{R}_{2}" :db/id #edb/ref 17592186386124} {:answer/id #uuid "4c847502-8514-5d10-9dcd-ee929fb97fb4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{1},\\,{R}_{1}:={R}_{1}+(-3){R}_{2}" :db/id #edb/ref 17592186386125} {:answer/id #uuid "7fb8073e-8de1-5ef6-9e33-e8ba6f5563c1" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186386126} {:answer/id #uuid "d79f0963-0d1a-5d70-9ac1-20722c6f883b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}" :db/id #edb/ref 17592186386127}] :answer-field/correct {:answer/id #uuid "d79f0963-0d1a-5d70-9ac1-20722c6f883b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}" :db/id #edb/ref 17592186386127} :answer-field/id #uuid "93d5f24f-9961-5171-9187-5181cc9626d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386122}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d8e64088-2308-5369-8285-5d893b0dfcdf" :question/math-academy-id "q-31945" :question/problem "The inverse of the matrix $K$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[K\\,|\\,I] & =[\\begin{aligned}-3 & 4 & 1 & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3} & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & -2 & 3\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 4 \\\\ 0 & 1 & -2 & 3\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $K$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $K$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[K\\,|\\,I] & =[\\begin{aligned}-3 & 4 & 1 & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3} & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & -2 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+\\frac{4}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 4 \\\\ 0 & 1 & -2 & 3\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=-\\frac{1}{3}{R}_{1},\\,{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=3{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}.\n$$\n\nThe matrix ${K}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{K}^{-1}=[\\begin{aligned}-3 & 4 \\\\ -2 & 3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186115763 :knowledge-point/_questions [{:knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9285085c-ea68-5798-a388-d4d579f6640a" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186113950} {:answer/id #uuid "c9e6ccef-cb3a-59d2-968d-afa56f9e1b38" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186113951} {:answer/id #uuid "d7eac3f1-c40c-5f81-885a-d59ee16580ee" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186113952} {:answer/id #uuid "4c044149-6c33-5cb3-9c87-6a6f36e8846a" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186113953} {:answer/id #uuid "4dc0426c-9e05-5c6a-9ffb-1fac6dc087fb" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186113954}] :answer-field/correct {:answer/id #uuid "d7eac3f1-c40c-5f81-885a-d59ee16580ee" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186113952} :answer-field/id #uuid "f2a82c2f-fee8-5718-a374-dde9723fde05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113949}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "90c835e0-83aa-519b-9995-715569dd5d93" :question/math-academy-id "q-43000" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{1}:=\\frac{1}{2}{R}_{1}?$\n\n$$\nA=[\\begin{aligned}1 & 2 \\\\ 2 & 2\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 2 \\\\ 2 & 2\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 \\\\ 2 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}0 & 2 \\\\ 2 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 2 \\\\ 0 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 \\\\ 0 & 2\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186316114 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5272bedb-f5cb-5248-a6e2-8c4780c44589" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{4}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/id #edb/ref 17592186316116} {:answer/id #uuid "794a79e9-007b-53ea-b9e4-21cbacc01099" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=2{R}_{2},\\,{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186316117} {:answer/id #uuid "466f40a1-7d60-5832-81fb-9e44a5ac70a0" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{3}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-3){R}_{2}" :db/id #edb/ref 17592186316118} {:answer/id #uuid "789231b1-663a-52b6-8809-47c43cd39d1a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:={R}_{2}+(-1){R}_{1}" :db/id #edb/ref 17592186316119} {:answer/id #uuid "d3f7ca12-9fc7-5ffe-a773-210c53108e6d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-1){R}_{2}" :db/id #edb/ref 17592186316120}] :answer-field/correct {:answer/id #uuid "d3f7ca12-9fc7-5ffe-a773-210c53108e6d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-1){R}_{2}" :db/id #edb/ref 17592186316120} :answer-field/id #uuid "d27219ca-d5bc-5fb9-8469-6189d630c06d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316115}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5980ce24-2fb8-5a08-94d5-9900cc4fdcd1" :question/math-academy-id "q-43004" :question/problem "The inverse of the matrix $V$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[V\\,|\\,I\\,] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 2 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -\\frac{1}{2} \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $V$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $V$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[V\\,|\\,I\\,] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 2 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -\\frac{1}{2} \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-1){R}_{2}.\n$$\n\nThe matrix ${V}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{V}^{-1}=[\\begin{aligned}1 & -\\frac{1}{2} \\\\ 0 & \\frac{1}{2}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386128 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a4b135f-df0d-5443-bb93-796f32c380c6" :knowledge-point/title "Identifying the Inverse of a 2x2 Matrix Calculated Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be9af6a-3f9a-5c67-b6ff-3627dba68379" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}3 & 2 \\\\ 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186386130} {:answer/id #uuid "0791b589-95a8-5d4a-b5a4-9922672dc9bf" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}-3 & 4 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386131} {:answer/id #uuid "35e6c3b0-cd4f-5a87-98e6-bb73f72ab5dc" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}2 & 6 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186386132} {:answer/id #uuid "3d06e262-0bf4-5196-ac14-a98b3bdb608e" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}1 & -1 \\\\ 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186386133} {:answer/id #uuid "17d4bafd-e317-52cd-a72c-8b0630a380b4" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}-3 & 4 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386134}] :answer-field/correct {:answer/id #uuid "17d4bafd-e317-52cd-a72c-8b0630a380b4" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{-1}=[\\begin{aligned}-3 & 4 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386134} :answer-field/id #uuid "f5120172-51b3-5e24-99fa-5de7583e860b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386129}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f414baf2-ff37-5d6f-8c93-b84870e3eb0d" :question/math-academy-id "q-43005" :question/problem "The inverse of the $2\\times 2$ matrix $Q$ is found using row operations, as shown below. Complete the process, and determine ${Q}^{-1}.$\n\n$$\n\\begin{aligned}[Q\\,|\\,I\\,] & =[\\begin{aligned}1 & 4 & 1 & 0 \\\\ 1 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\,4 & \\,1 & 0 \\\\ 0 & \\,-1 & \\,-1 & 1\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 1 & 0 \\\\ 0 & 1 & 1 & -1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $Q$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $Q$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[Q\\,|\\,I\\,] & =[\\begin{aligned}1 & 4 & 1 & 0 \\\\ 1 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\,4 & \\,1 & 0 \\\\ 0 & \\,-1 & \\,-1 & 1\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & 1 & 0 \\\\ 0 & 1 & 1 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 4 \\\\ 0 & 1 & 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nThe matrix ${Q}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{Q}^{-1}=[\\begin{aligned}-3 & 4 \\\\ 1 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186115764 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3543849d-340b-5be2-b0c7-2c42ea36e3a5" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-2)R_{1}, R_{1}:=R_{1} + (-1)R_{2}" :db/id #edb/ref 17592186113956} {:answer/id #uuid "5fb51950-3a14-5282-9aad-b325f327977e" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-1)R_{2}, R_{1}:=-2R_{2}" :db/id #edb/ref 17592186113957} {:answer/id #uuid "67149602-15e9-5144-9501-a4ef41b82042" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}:=R_{1} + (-2)R_{2}, R_{2}:=R_{2} + R_{1}" :db/id #edb/ref 17592186113958} {:answer/id #uuid "7d75c51c-8986-5d37-8f89-ee47ba2bb289" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-1)R_{2}, R_{1}:=R_{2} + R_{2}" :db/id #edb/ref 17592186113959} {:answer/id #uuid "7da931fa-98bd-5e8b-86ee-332fe29b5256" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}:=R_{1} + (-2)R_{2}, R_{2}:=-R_{2}" :db/id #edb/ref 17592186113960}] :answer-field/correct {:answer/id #uuid "3543849d-340b-5be2-b0c7-2c42ea36e3a5" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-2)R_{1}, R_{1}:=R_{1} + (-1)R_{2}" :db/id #edb/ref 17592186113956} :answer-field/id #uuid "a7f6638d-d1d5-5a2a-a2a5-d0bd8079afa3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113955}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "feb69023-a1fc-5fd4-a2b2-e338bb248f04" :question/math-academy-id "q-43006" :question/problem "The inverse of the matrix $A$ is found using the row operations as shown below. What are the corresponding row operations?\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & -2 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 & -1 \\\\ 0 & 1 & -2 & 1\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I\\,] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & -2 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 3 & -1 \\\\ 0 & 1 & -2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{1},\\,{R}_{1}:={R}_{1}+(-1){R}_{2}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}3 & -1 \\\\ -2 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186316121 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdd50191-b935-53c1-b729-05293a954016" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{1}+\\frac{1}{2}{R}_{2},\\,{R}_{1}:=-\\frac{2}{3}{R}_{2}" :db/id #edb/ref 17592186316123} {:answer/id #uuid "ee539306-dc16-5c6a-ac64-c80f90300a7c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=-\\frac{2}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+(-\\frac{1}{2}){R}_{2}" :db/id #edb/ref 17592186316124} {:answer/id #uuid "f36e00ee-0bd4-52b0-ac41-d5b0c68c8ebb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{2}{3}{R}_{1},\\,{R}_{2}:={R}_{2}+(-\\frac{1}{2}){R}_{1}" :db/id #edb/ref 17592186316125} {:answer/id #uuid "0bc52ad0-43a8-5d07-a2e3-026c0d7bb13e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=-\\frac{3}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-\\frac{1}{4}){R}_{2}" :db/id #edb/ref 17592186316126} {:answer/id #uuid "c11f12e8-e827-59dd-bc86-d2966f0728ac" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=-2{R}_{2},\\,{R}_{1}:={R}_{1}+(-2){R}_{2}" :db/id #edb/ref 17592186316127}] :answer-field/correct {:answer/id #uuid "ee539306-dc16-5c6a-ac64-c80f90300a7c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=-\\frac{2}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+(-\\frac{1}{2}){R}_{2}" :db/id #edb/ref 17592186316124} :answer-field/id #uuid "feeb800c-51ce-52bf-9086-c68c25f4bdc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316122}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "08503628-ebe1-533e-ab77-0800c6924f29" :question/math-academy-id "q-75448" :question/problem "The inverse of the matrix $Y$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[Y\\,|\\,I\\,] & =[\\begin{aligned}2 & 1 & 1 & 0 \\\\ -1 & -2 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ -1 & -2 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ 0 & -\\frac{3}{2} & \\frac{1}{2} & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{2}{3}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{2}{3} & \\frac{1}{3} \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $Y$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $Y$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[Y\\,|\\,I\\,] & =[\\begin{aligned}2 & 1 & 1 & 0 \\\\ -1 & -2 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ -1 & -2 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ 0 & -\\frac{3}{2} & \\frac{1}{2} & 1\\end{aligned}] & {R}_{2} & :=-\\frac{2}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & \\frac{1}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{2}{3}\\end{aligned}] & {R}_{1} & :={R}_{1}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{2}{3} & \\frac{1}{3} \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{2}:=-\\frac{2}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+(-\\frac{1}{2}){R}_{2}.\n$$\n\nThe matrix ${Y}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{Y}^{-1}=[\\begin{aligned}\\frac{2}{3} & \\frac{1}{3} \\\\ -\\frac{1}{3} & -\\frac{2}{3}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386135 :knowledge-point/_questions [{:knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64bb514d-0b9c-5f55-ba8d-8d2903e57f36" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186386137} {:answer/id #uuid "cb84f85f-2ab3-5d03-b96d-35da5df9dea5" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186386138} {:answer/id #uuid "ced2c4c3-f009-5aeb-af3b-e7c1e0bd4ccb" :answer/type {:db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186386139} {:answer/id #uuid "d302cad3-81ec-554b-b797-91cce10d6872" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186386140} {:answer/id #uuid "8644fc6d-a846-5da5-b463-aec67c8941d7" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186386141}] :answer-field/correct {:answer/id #uuid "ced2c4c3-f009-5aeb-af3b-e7c1e0bd4ccb" :answer/type {:db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186386139} :answer-field/id #uuid "a681057a-d2f6-5de8-b5c7-c51163b89190" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386136}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c1c2183f-2c3e-5666-b1a3-ed31682996f4" :question/math-academy-id "q-75496" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:={R}_{1}+(-2){R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-3){R}_{1}?$\n\n$$\nA=[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}],\\,B=[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}],\\,C=[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 4 & 13\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186386142 :knowledge-point/_questions [{:knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836c90b7-51cd-5592-9519-01f54ae64162" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186386144} {:answer/id #uuid "389d481b-4ca4-5de0-a180-cc213a1ea9fe" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186386145} {:answer/id #uuid "fbd179bf-3f0c-5ccd-bc4d-4e7719b6f74a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186386146} {:answer/id #uuid "5188b779-752e-59af-adb7-07e88b20e763" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186386147} {:answer/id #uuid "be38fea0-7670-55d4-be38-274ce30e0aaa" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186386148}] :answer-field/correct {:answer/id #uuid "5188b779-752e-59af-adb7-07e88b20e763" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186386147} :answer-field/id #uuid "0d9fe597-107a-5f49-b661-72b66ad155a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386143}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "709b5298-f419-5383-8936-25139c2a4a09" :question/math-academy-id "q-75503" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-3){R}_{1}?$\n\n$$\nA=[\\begin{aligned}6 & 1 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}-3 & 1 \\\\ 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}3 & 1 \\\\ 1 & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 6 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}-3 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}3 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$C$ only\"."}]}
