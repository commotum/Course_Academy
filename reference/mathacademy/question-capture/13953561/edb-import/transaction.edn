15502/selection/0359413c0e79f2c150458cf66fae7be58ccc8b0f29db409f76e133aaf1cb32a2"] :db/ensure [:answer-field/validate]} {:db/id "q-115502" :question/id #uuid "937d704e-62e1-5a63-bbea-5651cad7c9e5" :question/math-academy-id "q-115502" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953561/assets/c6b336b55e48a68dcad83efc4a8acd7659225b8f8e29faf8ea176c2cead29901.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,1).$ Substituting these into the general standard equation, we get\n\n$$\n(x-2)^{2}=4p(y-1).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-4,-2),$ so we can substitute $x=-4$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (-4-2)^{2} & =4p(-2-1) \\\\ 36 & =-12p \\\\ p & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (x-2)^{2} & =4(-3)(y-1) \\\\ (x-2)^{2} & =-12(y-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6"] :knowledge-point/questions ["q-115502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115500/selection/0502d2e042c82b67a2d7772e2d340a166b91c2a55cf86ddcba33ebc22a3f3c50" :answer/id #uuid "809f1619-f4e7-54ab-b843-b8e97daddc2b" :answer/type :answer.type/math :answer/value "(x-4)^{2}=\\frac{9}{16}y" :db/ensure [:answer/validate]} {:db/id "q-115500/selection/36a7448efe42f40a5a4c2db330bf2cdfbb9f58fa3aab2cc8683467a799e69f34" :answer/id #uuid "fc48066d-1956-593c-9fd2-1cfd566e9b50" :answer/type :answer.type/math :answer/value "(x-4)^{2}=\\frac{9}{4}y" :db/ensure [:answer/validate]} {:db/id "q-115500/selection/7c1f7d4973be62959dd33d83345734c09e8fcd2f74eae93e5c50dc58345a5c3f" :answer/id #uuid "f9cb6175-01c7-5464-8a04-fee3f1f21585" :answer/type :answer.type/math :answer/value "(x-4)^{2}=9y" :db/ensure [:answer/validate]} {:db/id "q-115500/selection/9b5290967d62e47ae429bb0aa8fe1770295292d765833cbc07ef6f593fc0bf43" :answer/id #uuid "676ef7ca-5c4e-51ce-b0b1-3941477a891f" :answer/type :answer.type/math :answer/value "(x-4)^{2}=\\frac{9}{4}(y-1)" :db/ensure [:answer/validate]} {:db/id "q-115500/selection/115fb2c49e2ebf90ec7e2ecf800ee0625eb227ea792fd2b5ea1ae42953db1f98" :answer/id #uuid "9b5d8b61-1506-5240-a544-b80b834e687a" :answer/type :answer.type/math :answer/value "(x-4)^{2}=4y" :db/ensure [:answer/validate]} {:db/id "q-115500/selection" :answer-field/id #uuid "a1542fa1-2577-538b-9e22-2c6387a913dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115500/selection/36a7448efe42f40a5a4c2db330bf2cdfbb9f58fa3aab2cc8683467a799e69f34" :answer-field/choices ["q-115500/selection/0502d2e042c82b67a2d7772e2d340a166b91c2a55cf86ddcba33ebc22a3f3c50" "q-115500/selection/36a7448efe42f40a5a4c2db330bf2cdfbb9f58fa3aab2cc8683467a799e69f34" "q-115500/selection/7c1f7d4973be62959dd33d83345734c09e8fcd2f74eae93e5c50dc58345a5c3f" "q-115500/selection/9b5290967d62e47ae429bb0aa8fe1770295292d765833cbc07ef6f593fc0bf43" "q-115500/selection/115fb2c49e2ebf90ec7e2ecf800ee0625eb227ea792fd2b5ea1ae42953db1f98"] :db/ensure [:answer-field/validate]} {:db/id "q-115500" :question/id #uuid "6d56f05c-64ef-5ac1-bc49-3c55d8d294be" :question/math-academy-id "q-115500" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953561/assets/e26f3115e64d22d336c164fca762a1654ce515019f425f5b0b772276ca88f727.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(4,0).$ Substituting these into the general standard equation, we get\n\n$$\n(x-4)^{2}=4py.\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(1,4),$ so we can substitute $x=1$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (1-4)^{2} & =4p(4) \\\\ 9 & =16p \\\\ p & =\\frac{9}{16}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (x-4)^{2} & =4(\\frac{9}{16})y \\\\ (x-4)^{2} & =\\frac{9}{4}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115500/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6"] :knowledge-point/questions ["q-115500"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115509/selection/8af021aa6f7ac1546229925bbe9a98be7b5b082e9e9c53aa29afa821c6c865e4" :answer/id #uuid "4dd91976-05bb-5e0d-ac65-8e431ef525cd" :answer/type :answer.type/math :answer/value "(x-1)^{2}=\\frac{4}{5}(y+3)" :db/ensure [:answer/validate]} {:db/id "q-115509/selection/e795b0a44a158dbd35f4ae77020d9320946aca48644e3c6297fb5dac4a8e2122" :answer/id #uuid "a3822f1c-ab06-5fcc-82e8-3c95ca604ae1" :answer/type :answer.type/math :answer/value "(x+1)^{2}=\\frac{1}{5}(y-3)" :db/ensure [:answer/validate]} {:db/id "q-115509/selection/3f871ee6ca867b60d3e0966d3a24d134caf8460f62f66c65774e18ccd30f744c" :answer/id #uuid "7579e360-adab-571e-a192-6bde16a58b76" :answer/type :answer.type/math :answer/value "(x-1)^{2}=\\frac{1}{2}(y+3)" :db/ensure [:answer/validate]} {:db/id "q-115509/selection/86378076ce908bef4d0f2994cbdc4383c124d3a6531e7ef75e34781deba40379" :answer/id #uuid "c10646da-ad94-5fd6-beea-c3a493653a6a" :answer/type :answer.type/math :answer/value "(x-1)^{2}=5(y+3)" :db/ensure [:answer/validate]} {:db/id "q-115509/selection/89582cf6e9b31eaf7ff3c3d2899e926bf96ad03c65ded5ebae8e274bde2fcbc6" :answer/id #uuid "02b6110d-f957-54b1-9813-613e3460134c" :answer/type :answer.type/math :answer/value "(x-1)^{2}=\\frac{1}{5}(y+3)" :db/ensure [:answer/validate]} {:db/id "q-115509/selection" :answer-field/id #uuid "9c33ae47-a099-595a-94ef-bf98016f8619" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115509/selection/8af021aa6f7ac1546229925bbe9a98be7b5b082e9e9c53aa29afa821c6c865e4" :answer-field/choices ["q-115509/selection/8af021aa6f7ac1546229925bbe9a98be7b5b082e9e9c53aa29afa821c6c865e4" "q-115509/selection/e795b0a44a158dbd35f4ae77020d9320946aca48644e3c6297fb5dac4a8e2122" "q-115509/selection/3f871ee6ca867b60d3e0966d3a24d134caf8460f62f66c65774e18ccd30f744c" "q-115509/selection/86378076ce908bef4d0f2994cbdc4383c124d3a6531e7ef75e34781deba40379" "q-115509/selection/89582cf6e9b31eaf7ff3c3d2899e926bf96ad03c65ded5ebae8e274bde2fcbc6"] :db/ensure [:answer-field/validate]} {:db/id "q-115509" :question/id #uuid "813942f5-d8d5-574a-a4f8-125c265b93a3" :question/math-academy-id "q-115509" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(1,-3)$ and which passes through the point $(-1,2).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(1,-3).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-(-3)) \\\\ (x-1)^{2} & =4p(y+3).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-1,2),$ so we can substitute $x=-1$ and $y=2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y+3) \\\\ (-1-1)^{2} & =4p(2+3) \\\\ 4 & =20p \\\\ p & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y+3) \\\\ (x-1)^{2} & =4(\\frac{1}{5})(y+3) \\\\ (x-1)^{2} & =\\frac{4}{5}(y+3).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115509/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968"] :knowledge-point/questions ["q-115509"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115513/selection/85a1a9af3c7173255ecb14228ce662514537548c14b9f469c1471150db699b36" :answer/id #uuid "c4f632af-384a-5deb-b568-a1149842d03b" :answer/type :answer.type/math :answer/value "(x-4)^{2}=-9y" :db/ensure [:answer/validate]} {:db/id "q-115513/selection/158813d52bd04047d2f0b324b0e89d9c39be4d905d42eae4252c6b4d2bc4b508" :answer/id #uuid "637aa00c-7820-5986-bc25-d0f1c1c60ffa" :answer/type :answer.type/math :answer/value "(x+4)^{2}=-\\frac{9}{16}y" :db/ensure [:answer/validate]} {:db/id "q-115513/selection/0c439fc417d2caf468ede3ca8996fb6096e32be55358376b50cfea11a48ec235" :answer/id #uuid "fb41fbf9-fb94-555b-a4f0-b34bf3bed3a9" :answer/type :answer.type/math :answer/value "(x-4)^{2}=-\\frac{9}{4}y" :db/ensure [:answer/validate]} {:db/id "q-115513/selection/b96680f03ff355e9362683f618104904a1f924850c5e759c4a56a80b44250e2d" :answer/id #uuid "b7030742-c2c3-5173-af94-f70f5b2194c2" :answer/type :answer.type/math :answer/value "(x-4)^{2}=-y" :db/ensure [:answer/validate]} {:db/id "q-115513/selection/dee77e135b34a3012ad357551c79b4be07395bd28ce7f080b9d832e5fde09f3e" :answer/id #uuid "f7ab0699-725d-5f76-9383-44ba4ce46847" :answer/type :answer.type/math :answer/value "{x}^{2}=-4(y-4)" :db/ensure [:answer/validate]} {:db/id "q-115513/selection" :answer-field/id #uuid "16cdad93-3d3f-57e2-9a21-93652eb9eac8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115513/selection/0c439fc417d2caf468ede3ca8996fb6096e32be55358376b50cfea11a48ec235" :answer-field/choices ["q-115513/selection/85a1a9af3c7173255ecb14228ce662514537548c14b9f469c1471150db699b36" "q-115513/selection/158813d52bd04047d2f0b324b0e89d9c39be4d905d42eae4252c6b4d2bc4b508" "q-115513/selection/0c439fc417d2caf468ede3ca8996fb6096e32be55358376b50cfea11a48ec235" "q-115513/selection/b96680f03ff355e9362683f618104904a1f924850c5e759c4a56a80b44250e2d" "q-115513/selection/dee77e135b34a3012ad357551c79b4be07395bd28ce7f080b9d832e5fde09f3e"] :db/ensure [:answer-field/validate]} {:db/id "q-115513" :question/id #uuid "6528ccf4-be62-5d95-9493-971f52ddc9ee" :question/math-academy-id "q-115513" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(4,0)$ and which passes through the point $(1,-4).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(4,0).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-4)^{2} & =4py.\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(1,-4),$ so we can substitute $x=1$ and $y=-4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (1-4)^{2} & =4p(-4) \\\\ 9 & =-16p \\\\ p & =-\\frac{9}{16}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-4)^{2} & =4py \\\\ (x-4)^{2} & =4(-\\frac{9}{16})y \\\\ (x-4)^{2} & =-\\frac{9}{4}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115513/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968"] :knowledge-point/questions ["q-115513"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-11831"] :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(3,0).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y-0) \\\\ (x-3)^{2} & =4py.\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-4,7),$ so we can substitute $x=-4$ and $y=7$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4py \\\\ (-4-3)^{2} & =4p(7) \\\\ 49 & =28p \\\\ p & =\\frac{7}{4}\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-3)^{2} & =4py \\\\ (x-3)^{2} & =4(\\frac{7}{4})y \\\\ (x-3)^{2} & =7y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-11833/selection/95cef9a3cd6a927a4d880ba4ef55fe59a2a23edba05c1ec099230c980024ac2b" :answer/id #uuid "2018be6b-4234-5633-b75a-6918b6dfe93e" :answer/type :answer.type/math :answer/value "(x+1)^{2}=-7(y+1)" :db/ensure [:answer/validate]} {:db/id "q-11833/selection/6464ab5c6e0781de02473a0fd462ddeebb4b60fd54cbf50e6fd52acd1ef75c3d" :answer/id #uuid "c03a9a2b-767b-5f43-9517-494f82a6e0b8" :answer/type :answer.type/math :answer/value "(x-1)^{2}=7(y-1)" :db/ensure [:answer/validate]} {:db/id "q-11833/selection/a9874b4bde25c04bb66802b769545e217212433abf39142598e00341d79481f0" :answer/id #uuid "fb681254-8e38-5f7b-91d2-9717492bb5bd" :answer/type :answer.type/math :answer/value "(x-1)^{2}=3(y-1)" :db/ensure [:answer/validate]} {:db/id "q-11833/selection/8b49f9917b7ad12c771bf8d985699569232484c7c7abe512df1c9bb703e1926f" :answer/id #uuid "7ccaa4a8-e4e1-5348-85f8-6229d6f6f70c" :answer/type :answer.type/math :answer/value "(x-1)^{2}=-7(y-1)" :db/ensure [:answer/validate]} {:db/id "q-11833/selection/3a314b15178bb34e780e25b2141e0f719e4bc5ce08e47ced99c776efaf344c47" :answer/id #uuid "609eb2cf-b356-5ac6-8bc9-d6d4aee1ef47" :answer/type :answer.type/math :answer/value "(x-1)^{2}=-3(y-1)" :db/ensure [:answer/validate]} {:db/id "q-11833/selection" :answer-field/id #uuid "2c878c30-8162-52d3-a874-55d3ed22eb9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11833/selection/8b49f9917b7ad12c771bf8d985699569232484c7c7abe512df1c9bb703e1926f" :answer-field/choices ["q-11833/selection/95cef9a3cd6a927a4d880ba4ef55fe59a2a23edba05c1ec099230c980024ac2b" "q-11833/selection/6464ab5c6e0781de02473a0fd462ddeebb4b60fd54cbf50e6fd52acd1ef75c3d" "q-11833/selection/a9874b4bde25c04bb66802b769545e217212433abf39142598e00341d79481f0" "q-11833/selection/8b49f9917b7ad12c771bf8d985699569232484c7c7abe512df1c9bb703e1926f" "q-11833/selection/3a314b15178bb34e780e25b2141e0f719e4bc5ce08e47ced99c776efaf344c47"] :db/ensure [:answer-field/validate]} {:db/id "q-11833" :question/id #uuid "32b923bd-666e-5667-b946-48b197182bfe" :question/math-academy-id "q-11833" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(1,1)$ and which passes through the point $(-6,-6).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(1,1).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(-6,-6),$ so we can substitute $x=-6$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (-6-1)^{2} & =4p(-6-1) \\\\ 49 & =-28p \\\\ p & =-\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-1)^{2} & =4p(y-1) \\\\ (x-1)^{2} & =4(-\\frac{7}{4})(y-1) \\\\ (x-1)^{2} & =-7(y-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11833/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968"] :knowledge-point/questions ["q-11833"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115506/selection/704ff0cd9b10653ac73b3650b8cf3f78c461d3cb9120fd9145e4803ddfd3060c" :answer/id #uuid "fbf43513-9bd0-5686-b55b-0ff1287de324" :answer/type :answer.type/math :answer/value "(x+1)^{2}=\\frac{1}{28}(y+5)" :db/ensure [:answer/validate]} {:db/id "q-115506/selection/325bb434b0d788a6d3d6c465076397ff874373dde93dcdad9699f9ae9463f1d0" :answer/id #uuid "c385a7ce-f971-566a-8301-9f8c64441141" :answer/type :answer.type/math :answer/value "(x+5)^{2}=3(y+1)" :db/ensure [:answer/validate]} {:db/id "q-115506/selection/6bfdbf6cb9e449b23d4836e85f1e648260e62b2d1d3656e02a8b9dd3abe36e6c" :answer/id #uuid "4a03f5af-a439-518b-a185-b726f300f22b" :answer/type :answer.type/math :answer/value "(x-1)^{2}=\\frac{3}{4}(y-5)" :db/ensure [:answer/validate]} {:db/id "q-115506/selection/2490e927bb43f544f59f16616cd75543a0b4e48a718eb20c8311099cdd72deb2" :answer/id #uuid "5d5e5e32-ef6c-50ba-a566-989968bbd42a" :answer/type :answer.type/math :answer/value "(x+1)^{2}=3(y+5)" :db/ensure [:answer/validate]} {:db/id "q-115506/selection/ccaf2ea8b74bb6611dbfc3006e4a2a4ac7145bc0c23b238e765505636b617d9e" :answer/id #uuid "5fff1346-1826-52a9-9779-84248e9702c1" :answer/type :answer.type/math :answer/value "(x+1)^{2}=\\frac{4}{28}(y+5)" :db/ensure [:answer/validate]} {:db/id "q-115506/selection" :answer-field/id #uuid "e5d4a420-f7be-5b78-b182-15152b620b4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115506/selection/2490e927bb43f544f59f16616cd75543a0b4e48a718eb20c8311099cdd72deb2" :answer-field/choices ["q-115506/selection/704ff0cd9b10653ac73b3650b8cf3f78c461d3cb9120fd9145e4803ddfd3060c" "q-115506/selection/325bb434b0d788a6d3d6c465076397ff874373dde93dcdad9699f9ae9463f1d0" "q-115506/selection/6bfdbf6cb9e449b23d4836e85f1e648260e62b2d1d3656e02a8b9dd3abe36e6c" "q-115506/selection/2490e927bb43f544f59f16616cd75543a0b4e48a718eb20c8311099cdd72deb2" "q-115506/selection/ccaf2ea8b74bb6611dbfc3006e4a2a4ac7145bc0c23b238e765505636b617d9e"] :db/ensure [:answer-field/validate]} {:db/id "q-115506" :question/id #uuid "85066d46-803d-56c3-bb8d-ae8f69048626" :question/math-academy-id "q-115506" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(-1,-5)$ and which passes through the point $(2,-2).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(-1,-5).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-(-1))^{2} & =4p(y-(-5)) \\\\ (x+1)^{2} & =4p(y+5).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(2,-2),$ so we can substitute $x=2$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y+5) \\\\ (2+1)^{2} & =4p(-2+5) \\\\ 9 & =12p \\\\ p & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x+1)^{2} & =4p(y+5) \\\\ (x+1)^{2} & =4(\\frac{3}{4})(y+5) \\\\ (x+1)^{2} & =3(y+5).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115506/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968"] :knowledge-point/questions ["q-115506"] :db/ensure [:knowledge-point/validate]}]
