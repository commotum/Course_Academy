oint/questions ["q-115435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115432/selection/7a35be791bf0edec1186bc37a1baffbcfb47911c6487d7c1c870d96ec786ab49" :answer/id #uuid "686428a3-f0cd-5673-8075-592202cb5ae1" :answer/type :answer.type/math :answer/value "{x}^{2}=4y" :db/ensure [:answer/validate]} {:db/id "q-115432/selection/79fd892af1489443a15bafabf1e94b8a8398f718f602129d18ebf0bfe445ca8e" :answer/id #uuid "728bb18e-8de9-5eb5-ae95-9c708f7b67d7" :answer/type :answer.type/math :answer/value "{x}^{2}=\\frac{1}{4}y" :db/ensure [:answer/validate]} {:db/id "q-115432/selection/b73c47d4951226b80a54488eab52e7320eb30b7936ac27682f3727aec331136f" :answer/id #uuid "c7ae281d-c232-51a2-9e5e-e7cb425ace03" :answer/type :answer.type/math :answer/value "{x}^{2}=-y" :db/ensure [:answer/validate]} {:db/id "q-115432/selection/7898f63e835cca1c7568934d44537b2ee7fa34d9002c54f4b9b0f47fc91f1831" :answer/id #uuid "99f9bbd2-cf8d-5e89-9ccd-953346f2b165" :answer/type :answer.type/math :answer/value "{x}^{2}=16y" :db/ensure [:answer/validate]} {:db/id "q-115432/selection/2d28f7475b6d9c613da2b98bb64da04459d879d07f6b7479be54a026e9fd1c43" :answer/id #uuid "47ca1c1e-e834-5998-91a4-10d42cf3ef55" :answer/type :answer.type/math :answer/value "{x}^{2}=y" :db/ensure [:answer/validate]} {:db/id "q-115432/selection" :answer-field/id #uuid "c2e94856-8e65-5e4c-a8d9-1083a6e7a5bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115432/selection/7a35be791bf0edec1186bc37a1baffbcfb47911c6487d7c1c870d96ec786ab49" :answer-field/choices ["q-115432/selection/7a35be791bf0edec1186bc37a1baffbcfb47911c6487d7c1c870d96ec786ab49" "q-115432/selection/79fd892af1489443a15bafabf1e94b8a8398f718f602129d18ebf0bfe445ca8e" "q-115432/selection/b73c47d4951226b80a54488eab52e7320eb30b7936ac27682f3727aec331136f" "q-115432/selection/7898f63e835cca1c7568934d44537b2ee7fa34d9002c54f4b9b0f47fc91f1831" "q-115432/selection/2d28f7475b6d9c613da2b98bb64da04459d879d07f6b7479be54a026e9fd1c43"] :db/ensure [:answer-field/validate]} {:db/id "q-115432" :question/id #uuid "71cb5f41-13a9-5133-a665-cd67b9feb099" :question/math-academy-id "q-115432" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(2,1).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(2,1),$ so we can substitute $x=2$ and $y=1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {2}^{2} & =4p(1) \\\\ 4 & =4p \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(1)y \\\\ {x}^{2} & =4y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115432/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2"] :knowledge-point/questions ["q-115432"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11782/selection/09dfa139565e3603a9f31d8f65aeab0ea89c5d8596eabadba3f26c1fa8f2d13a" :answer/id #uuid "80532d30-77f7-5897-9ce1-c6bd231ae768" :answer/type :answer.type/math :answer/value "{x}^{2}=\\frac{8}{3}y" :db/ensure [:answer/validate]} {:db/id "q-11782/selection/13a70f0a5769f26c6226622199e543a5208806b43c0ba226086c914e42e59b7e" :answer/id #uuid "c3f5d939-fbf4-5b60-aca3-257a491c93b0" :answer/type :answer.type/math :answer/value "{x}^{2}=-\\frac{8}{3}y" :db/ensure [:answer/validate]} {:db/id "q-11782/selection/9399dfb0c1d454b99d1b3a2965433f39937830d6b844c1d3b37db94cdb0521ad" :answer/id #uuid "ce5666b8-cda1-5513-8c1b-1f33b5c0719d" :answer/type :answer.type/math :answer/value "{x}^{2}=\\frac{4}{3}y" :db/ensure [:answer/validate]} {:db/id "q-11782/selection/ea9c768342fd024318b7402f91041b3e22e29ccc5aac75166dcd70678f861daf" :answer/id #uuid "33628d70-537d-561a-99e4-84d44b8d5c1d" :answer/type :answer.type/math :answer/value "{x}^{2}=-\\frac{2}{3}y" :db/ensure [:answer/validate]} {:db/id "q-11782/selection/0f0602be3d112b2beb3583cc679ece9cd0e5f3ae64bf94f55d97d746d982319e" :answer/id #uuid "ef5d3168-f1c4-5830-ac31-732220c7ad71" :answer/type :answer.type/math :answer/value "{x}^{2}=-\\frac{4}{3}y" :db/ensure [:answer/validate]} {:db/id "q-11782/selection" :answer-field/id #uuid "c9580cf6-ac04-5e39-a226-e5d4a535039d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11782/selection/13a70f0a5769f26c6226622199e543a5208806b43c0ba226086c914e42e59b7e" :answer-field/choices ["q-11782/selection/09dfa139565e3603a9f31d8f65aeab0ea89c5d8596eabadba3f26c1fa8f2d13a" "q-11782/selection/13a70f0a5769f26c6226622199e543a5208806b43c0ba226086c914e42e59b7e" "q-11782/selection/9399dfb0c1d454b99d1b3a2965433f39937830d6b844c1d3b37db94cdb0521ad" "q-11782/selection/ea9c768342fd024318b7402f91041b3e22e29ccc5aac75166dcd70678f861daf" "q-11782/selection/0f0602be3d112b2beb3583cc679ece9cd0e5f3ae64bf94f55d97d746d982319e"] :db/ensure [:answer-field/validate]} {:db/id "q-11782" :question/id #uuid "47a891f7-672e-5107-a414-bee92cb2f663" :question/math-academy-id "q-11782" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(4,-6).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(4,-6),$ so we can substitute $x=4$ and $y=-6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {4}^{2} & =4p(-6) \\\\ 16 & =-24p \\\\ p & =-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{2}{3})y \\\\ {x}^{2} & =-\\frac{8}{3}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11782/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2"] :knowledge-point/questions ["q-11782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11792/selection/bb63415823a3bf672bb5b3eeddd6f00d923d4395e2e267b21ff530b7b088a5b0" :answer/id #uuid "0b716a93-4acf-5130-9b69-a91f6e609567" :answer/type :answer.type/math :answer/value "{x}^{2}=5y" :db/ensure [:answer/validate]} {:db/id "q-11792/selection/2d28f7475b6d9c613da2b98bb64da04459d879d07f6b7479be54a026e9fd1c43" :answer/id #uuid "e1fb6eab-a26e-5794-a3d0-b90227d6e6f3" :answer/type :answer.type/math :answer/value "{x}^{2}=y" :db/ensure [:answer/validate]} {:db/id "q-11792/selection/9ccbc54c8a7c99aa32e755ee248a776c14d3fbbeb5548827e9593addab202de3" :answer/id #uuid "693d6b56-8fb2-5bb3-b1f8-15fc4ec38686" :answer/type :answer.type/math :answer/value "{x}^{2}=3y" :db/ensure [:answer/validate]} {:db/id "q-11792/selection/00efa1cd86414df9a3ec3b6c62479031aeceb850f45b923621b5517e10309808" :answer/id #uuid "f0cf56ca-2f98-58c3-8a40-d8047062c61d" :answer/type :answer.type/math :answer/value "{x}^{2}=-3y" :db/ensure [:answer/validate]} {:db/id "q-11792/selection/368b661f4d19f80bb512500c891cbc6ac5141db308d2af2f466ec2ac53f8886b" :answer/id #uuid "4394461f-da87-5470-9e98-7e1eb7b19c8c" :answer/type :answer.type/math :answer/value "{x}^{2}=-5y" :db/ensure [:answer/validate]} {:db/id "q-11792/selection" :answer-field/id #uuid "7a71da3b-5265-5443-bc9f-9bdddee6a94e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11792/selection/bb63415823a3bf672bb5b3eeddd6f00d923d4395e2e267b21ff530b7b088a5b0" :answer-field/choices ["q-11792/selection/bb63415823a3bf672bb5b3eeddd6f00d923d4395e2e267b21ff530b7b088a5b0" "q-11792/selection/2d28f7475b6d9c613da2b98bb64da04459d879d07f6b7479be54a026e9fd1c43" "q-11792/selection/9ccbc54c8a7c99aa32e755ee248a776c14d3fbbeb5548827e9593addab202de3" "q-11792/selection/00efa1cd86414df9a3ec3b6c62479031aeceb850f45b923621b5517e10309808" "q-11792/selection/368b661f4d19f80bb512500c891cbc6ac5141db308d2af2f466ec2ac53f8886b"] :db/ensure [:answer-field/validate]} {:db/id "q-11792" :question/id #uuid "638d02b8-a51f-5cc2-a74b-5fb529f64615" :question/math-academy-id "q-11792" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-5,5).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-5,5),$ so we can substitute $x=-5$ and $y=5$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-5)^{2} & =4p(5) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{5}{4})y \\\\ {x}^{2} & =5y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11792/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2"] :knowledge-point/questions ["q-11792"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-11788"] :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(8,12),$ so we can substitute $x=8$ and $y=12$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {8}^{2} & =4p(12) \\\\ 64 & =48p \\\\ p & =\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{4}{3})y \\\\ {x}^{2} & =\\frac{16}{3}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-11821"] :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(-4,4).$ Substituting these into the general standard equation, we get\n\n$$\n(x+4)^{2}=4p(y-4).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(0,-4),$ so we can substitute $x=0$ and $y=-4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x+4)^{2} & =4p(y-4) \\\\ {4}^{2} & =4p(-4-4) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x+4)^{2} & =4p(y-4) \\\\ (x+4)^{2} & =4(-\\frac{1}{2})(y-4) \\\\ (x+4)^{2} & =-2(y-4).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-115451/selection/7971eb12ac4c754549e2e53dfbb6125961ca86d470781cfec27454ad63f0e012" :answer/id #uuid "898831f4-09ed-5bbe-a7f1-be49ad568777" :answer/type :answer.type/math :answer/value "(x-2)^{2}=4(y-1)" :db/ensure [:answer/validate]} {:db/id "q-115451/selection/0825aa2bd1a8967bb07bf70bc25cb560332e1a36106953b460da8f66ae3f647a" :answer/id #uuid "69727341-5395-5439-876e-81c9187b0654" :answer/type :answer.type/math :answer/value "(x+2)^{2}=\\frac{1}{2}(y+1)" :db/ensure [:answer/validate]} {:db/id "q-115451/selection/f3165821aca0c07c4201e35ecb420e38d43d79df5b3f8ce0705c25df7e6725fe" :answer/id #uuid "a352c2c6-b919-561c-a9da-99b051b6cfac" :answer/type :answer.type/math :answer/value "(x+2)^{2}=(y-1)" :db/ensure [:answer/validate]} {:db/id "q-115451/selection/c94b60022a7d2d42e22ebf65b521d84ca33d40a9cd8f798de4e6aa129e148510" :answer/id #uuid "91f187db-7f2c-5f24-94cd-1ac4b2f78ed0" :answer/type :answer.type/math :answer/value "(x-2)^{2}=\\frac{1}{2}(y-1)" :db/ensure [:answer/validate]} {:db/id "q-115451/selection/670fa3a933d4a630eb6fa64b5490fbbaa1796c5612cc11f10582c68732e3a85e" :answer/id #uuid "d8394802-2c1c-5dd2-8e17-8223ce180722" :answer/type :answer.type/math :answer/value "(x-2)^{2}=2(y-1)" :db/ensure [:answer/validate]} {:db/id "q-115451/selection" :answer-field/id #uuid "70fe7882-011f-57aa-af16-b57c2078fc13" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115451/selection/670fa3a933d4a630eb6fa64b5490fbbaa1796c5612cc11f10582c68732e3a85e" :answer-field/choices ["q-115451/selection/7971eb12ac4c754549e2e53dfbb6125961ca86d470781cfec27454ad63f0e012" "q-115451/selection/0825aa2bd1a8967bb07bf70bc25cb560332e1a36106953b460da8f66ae3f647a" "q-115451/selection/f3165821aca0c07c4201e35ecb420e38d43d79df5b3f8ce0705c25df7e6725fe" "q-115451/selection/c94b60022a7d2d42e22ebf65b521d84ca33d40a9cd8f798de4e6aa129e148510" "q-115451/selection/670fa3a933d4a630eb6fa64b5490fbbaa1796c5612cc11f10582c68732e3a85e"] :db/ensure [:answer-field/validate]} {:db/id "q-115451" :question/id #uuid "999f624c-8ca7-5be0-b050-cb183cb66954" :question/math-academy-id "q-115451" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953561/assets/970db64a0ddd325993323511ad4ae754ce64f64d591877bfa0ac908874e2393f.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(2,1).$ Substituting these into the general standard equation, we get\n\n$$\n(x-2)^{2}=4p(y-1).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,3),$ so we can substitute $x=4$ and $y=3$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (4-2)^{2} & =4p(3-1) \\\\ 4 & =8p \\\\ p & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y-1) \\\\ (x-2)^{2} & =4(\\frac{1}{2})(y-1) \\\\ (x-2)^{2} & =2(y-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6"] :knowledge-point/questions ["q-115451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11839/selection/8436fd950a63362d73b81b6963555af564e7bc8cf4b5cf81f898e3960a9163ce" :answer/id #uuid "02e6d837-77f5-5adf-adab-6b278893a260" :answer/type :answer.type/math :answer/value "(x-4)^{2}=-5y" :db/ensure [:answer/validate]} {:db/id "q-11839/selection/6abddf19c326226716fe4a39032a155deb5e4375161d1de8c803fc6f72159bc8" :answer/id #uuid "b52bf1e4-5961-5cf5-a528-ac08a59197ae" :answer/type :answer.type/math :answer/value "(x-4)^{2}=3y" :db/ensure [:answer/validate]} {:db/id "q-11839/selection/17ae37459575a99f8faf6d73f0a0654a105f80aceca16003bef72046c3a9c3fd" :answer/id #uuid "2603a8d6-eb3e-524a-b6ae-2ec60dbc7779" :answer/type :answer.type/math :answer/value "(x-4)^{2}=-3y" :db/ensure [:answer/validate]} {:db/id "q-11839/selection/3e38ca301135730b31c527cc13aaebf177eb565ee25b751dc7e47b9a96ad978c" :answer/id #uuid "8a36ac9b-46ae-518f-be4e-0c6a70fda25b" :answer/type :answer.type/math :answer/value "{x}^{2}=-5(y-4)" :db/ensure [:answer/validate]} {:db/id "q-11839/selection/2c33cdb9279ed1cceae416980ccbcebd85dcce51d09943bdb5f67b31703ca13a" :answer/id #uuid "9d0a1f2e-870c-5bed-bef6-605de135515a" :answer/type :answer.type/math :answer/value "(x-4)^{2}=5y" :db/ensure [:answer/validate]} {:db/id "q-11839/selection" :answer-field/id #uuid "acbe6722-d902-59d5-bc30-2fefe97331d5" :answer-