ype/math} :answer/value "(x + 4)^{2} = 2(y - 4)" :db/id #edb/ref 17592186093979}] :answer-field/correct {:answer/id #uuid "dd36c1e4-86ea-5eb2-9044-78158f64d3d8" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 4)^{2} =-2(y - 4)" :db/id #edb/ref 17592186093976} :answer-field/id #uuid "7d536e2a-4809-5333-8c8e-9f0d86e346cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093974}] :question/id #uuid "4a4d2719-1759-5386-919c-06942962bca0" :question/math-academy-id "q-11821" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1125/Source/Images/q-11821.png)\n\nWhat is the equation of the parabola shown above?"}] [{:db/id #edb/ref 17592186096930 :knowledge-point/_questions [{:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed27cbc8-2581-5751-83fb-f71d9985b2fd" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} =-7y" :db/id #edb/ref 17592186093987} {:answer/id #uuid "0db3ea8c-46fe-5ecc-81ec-7bc89cf2ad54" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} = 3y" :db/id #edb/ref 17592186093988} {:answer/id #uuid "1480bf6b-13a9-505b-99e5-e7dbbd47eb87" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} =-3y" :db/id #edb/ref 17592186093989} {:answer/id #uuid "4a0a8001-db77-52a8-8498-58baff88c345" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} = 7y" :db/id #edb/ref 17592186093990} {:answer/id #uuid "7efc445c-33e6-5ee4-bea9-d521e776ad0f" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} = 7(y - 3)" :db/id #edb/ref 17592186093991}] :answer-field/correct {:answer/id #uuid "4a0a8001-db77-52a8-8498-58baff88c345" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} = 7y" :db/id #edb/ref 175921860