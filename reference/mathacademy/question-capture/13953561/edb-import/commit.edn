33925 true] [17592186266187 1034 "{x}^{2}=\\frac{1}{4}y" 13194139533925 true] [17592186266187 1103 #edb/ref 17592186045453 13194139533925 true] [17592186266187 1111 #uuid "728bb18e-8de9-5eb5-ae95-9c708f7b67d7" 13194139533925 true] [17592186266188 1034 "{x}^{2}=4y" 13194139533925 true] [17592186266188 1103 #edb/ref 17592186045453 13194139533925 true] [17592186266188 1111 #uuid "686428a3-f0cd-5673-8075-592202cb5ae1" 13194139533925 true] [17592186266189 1034 "{x}^{2}=-y" 13194139533925 true] [17592186266189 1103 #edb/ref 17592186045453 13194139533925 true] [17592186266189 1111 #uuid "c7ae281d-c232-51a2-9e5e-e7cb425ace03" 13194139533925 true] [17592186266190 1017 #edb/ref 17592186266191 13194139533925 true] [17592186266190 1089 "q-115435" 13194139533925 true] [17592186266190 1091 #edb/ref 17592186045465 13194139533925 true] [17592186266190 1100 "Find the equation of the downward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-1,-1).$" 13194139533925 true] [17592186266190 1113 #uuid "33949929-48a3-573a-95fa-dbf4e9614d41" 13194139533925 true] [17592186266190 1145 "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-1,-1),$ so we can substitute $x=-1$ and $y=-1$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-1)^{2} & =4p(-1) \\\\ 1 & =-4p \\\\ p & =-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{1}{4})y \\\\ {x}^{2} & =-y.\\end{aligned}\n$$" 13194139533925 true] [17592186266191 1000 #edb/ref 17592186266192 13194139533925 true] [17592186266191 1000 #edb/ref 17592186266193 13194139533925 true] [17592186266191 1000 #edb/ref 17592186266194 13194139533925 true] [17592186266191 1000 #edb/ref 17592186266195 131941395339