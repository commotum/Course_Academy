/assets/ba82c6b68026b0f4339c1e4fa01c4b1aa1b7aee74b74176f81bba1c0e1de259f.png)\n\nConsider the diagram above, where $\\overset{\\to }{OR}=r,$ $\\overset{\\to }{OS}=s$ and $V$ divides $\\overset{―}{RS}$ in the ratio $RV:VS=6:5.$ Find $\\overset{\\to }{OV}.$" 13194139535651 true] [17592186359317 1113 #uuid "c822bdd5-b239-5109-a43e-980b6e32d798" 13194139535651 true] [17592186359317 1145 "From the diagram, we see that\n\n$$\n\\overset{\\to }{OV}=\\overset{\\to }{OR}+\\overset{\\to }{RV}.\n$$\n\nWe're told that $\\overset{\\to }{OR}=r,$ so we just need to work out $\\overset{\\to }{RV}.$\n\nFirst, from $△ORS,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\overset{\\to }{RO}+\\overset{\\to }{OS} \\\\  & =-\\overset{\\to }{OR}+\\overset{\\to }{OS} \\\\  & =-r+s \\\\  & =s-r.\\end{aligned}\n$$\n\nSince $RV:VS=6:5,$ we have\n\n$$\n\\overset{\\to }{RV}=\\frac{6}{11}\\overset{\\to }{RS}=\\frac{6}{11}(s-r).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OV} & =\\overset{\\to }{OR}+\\overset{\\to }{RV} \\\\  & =r+\\frac{6}{11}(s-r) \\\\  & =\\frac{5}{11}r+\\frac{6}{11}s.\\end{aligned}\n$$" 13194139535651 true] [17592186359318 1000 #edb/ref 17592186359319 13194139535651 true] [17592186359318 1000 #edb/ref 17592186359320 13194139535651 true] [17592186359318 1000 #edb/ref 17592186359321 13194139535651 true] [17592186359318 1000 #edb/ref 17592186359322 13194139535651 true] [17592186359318 1000 #edb/ref 17592186359323 13194139535651 true] [17592186359318 1040 #edb/ref 17592186045450 13194139535651 true] [17592186359318 1041 "selection" 13194139535651 true] [17592186359318 1104 #edb/ref 17592186359322 13194139535651 true] [17592186359318 1110 #uuid "ac26a9a3-0579-5660-a6f5-89767bdedcae" 13194139535651 true] [17592186359319 1034 "\\overset{\\to }{OV}=\\frac{5}{6}r+\\frac{1}{6}s" 13194139535651 true] [17592186359319 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359319 1111 #uuid "b0dca618-d80d-52a6-906f-74aa4b9fbda0" 13194139535651 true] [17592186359320 1034 "\\overset{\\to }{OV}=\\frac{6}{11}r+\\frac{5}{11}s" 13194139535651 true] [17592186359320 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359320 1111 #uuid "f32865da-d1db-55cb-b5a1-224864b96bc7" 13194139535651 true] [17592186359321 1034 "\\overset{\\to }{OV}=r+\\frac{5}{6}s" 13194139535651 true] [17592186359321 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359321 1111 #uuid "b84a4cfa-d29c-56c0-82d6-46f04fcabce1" 13194139535651 true] [17592186359322 1034 "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" 13194139535651 true] [17592186359322 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359322 1111 #uuid "0445ced9-725c-53d8-8045-c4170dad542a" 13194139535651 true] [17592186359323 1034 "\\overset{\\to }{OV}=\\frac{1}{11}r+s" 13194139535651 true] [17592186359323 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359323 1111 #uuid "581474e8-b023-5ee4-9dd4-6a1b95149d48" 13194139535651 true] [17592186359324 1017 #edb/ref 17592186359325 13194139535651 true] [17592186359324 1017 #edb/ref 17592186359327 13194139535651 true] [17592186359324 1089 "q-322577" 13194139535651 true] [17592186359324 1091 #edb/ref 17592186045465 13194139535651 true] [17592186359324 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069110/assets/de33644bcad663e67dc19c687dc0ef959310a50ddb83203031e66b951700510b.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v,$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=9:8.$ Express $\\overset{\\to }{OW}$ via the vectors $u$ and $v.$\n\n$\\,\\overset{\\to }{OW}=$\n{{field-1}}\n$u+$\n{{field-2}}\n$v$" 13194139535651 true] [17592186359324 1113 #uuid "31c5dcf7-a95c-5a0d-988e-4a401492f1e5" 13194139535651 true] [17592186359324 1145 "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=9:8,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{9}{17}\\overset{\\to }{UV}=\\frac{9}{17}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{9}{17}(v-u) \\\\  & =\\frac{8}{17}u+\\frac{9}{17}v.\\end{aligned}\n$$" 13194139535651 true] [17592186359325 1000 #edb/ref 17592186359326 13194139535651 true] [17592186359325 1040 #edb/ref 17592186045449 13194139535651 true] [17592186359325 1041 "field-1" 13194139535651 true] [17592186359325 1104 #edb/ref 17592186359326 13194139535651 true] [17592186359325 1110 #uuid "fb4368da-49aa-53a7-bdff-de6cab55dfa3" 13194139535651 true] [17592186359326 1034 "\\frac{8}{17}" 13194139535651 true] [17592186359326 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359326 1111 #uuid "88425eae-da1e-5874-8f7f-5814599109b1" 13194139535651 true] [17592186359327 1000 #edb/ref 17592186359328 13194139535651 true] [17592186359327 1040 #edb/ref 17592186045449 13194139535651 true] [17592186359327 1041 "field-2" 13194139535651 true] [17592186359327 1104 #edb/ref 17592186359328 13194139535651 true] [17592186359327 1110 #uuid "2658f1c6-32fa-5c81-bd3e-c4ca5b4b9f96" 13194139535651 true] [17592186359328 1034 "\\frac{9}{17}" 13194139535651 true] [17592186359328 1103 #edb/ref 17592186045453 13194139535651 true] [17592186359328 1111 #uuid "93b212bf-e43c-5f8b-986d-a351f1f28af6" 13194139535651 true] [17592186359329 1017 #edb/ref 17592186359330 13194139535651 true] [17592186359329 1017 #edb/ref 17592186359333 13194139535651 true] [17592186359329 1089 "q-327078" 13194139535651 true] [17592186359329 1091 #edb/ref 17592186045465 13194139535651 true] [17592186359329 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/1406911