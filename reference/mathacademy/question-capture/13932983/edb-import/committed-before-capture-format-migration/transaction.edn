positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $-1\\cdot 1=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110801/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f"] :knowledge-point/questions ["q-110801"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "961e6726-5191-5f1a-8d0d-1d671db69d43" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-100781/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "18daf0ca-4ee6-5d4b-b63c-65208884314c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-100781/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "bd1a4993-dda4-5588-b641-a74428e632d8" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-100781/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "f09f79e4-3e57-5fd4-84af-4611b82ef216" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-100781/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "f20317ce-07fb-5614-80e2-3d13f049f478" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-100781/selection" :answer-field/id #uuid "f2ea8463-2c79-549a-9af5-ec171a72f770" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-100781/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-100781/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-100781/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-100781/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-100781/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-100781/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-100781" :question/id #uuid "1a64546d-9996-5249-99f1-1b63f1609794" :question/math-academy-id "q-100781" :question/is-example false :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {7}^{x-3}-8x\\cdot {7}^{x-3}+12\\cdot {7}^{x-3}=0?$" :question/worked-solution "First, we factor the equation:\n\n  \n\n$$\n\\begin{aligned}{x}^{2}\\cdot {7}^{x-3}-8x\\cdot {7}^{x-3}+12\\cdot {7}^{x-3} & =0 \\\\ ({x}^{2}-8x+12){7}^{x-3} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-8x+12=0\\,\\text{and}\\,{7}^{x-3}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-8x+12=0$ can be factored as\n\n$$\n(x-2)(x-6)=0,\n$$\n\nwhich leads to the solutions $x=2,6.$\n\n- The equation ${7}^{x-3}=0$ has no solutions because ${7}^{x-3}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=2,6,$ and their product is $2\\cdot 6=12.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-100781/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f"] :knowledge-point/questions ["q-100781"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110803/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "11582582-b868-5600-b934-1e283edb59fb" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-110803/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "27e8451c-1243-5154-9e7a-055552f56dc9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-110803/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b6a21f36-16e3-52e9-974b-2de73e107af9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-110803/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "dbf6bf92-13ab-5e7f-9993-96e57e80945c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-110803/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "faa24f8d-6337-545d-80eb-aea5aa8a3714" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-110803/selection" :answer-field/id #uuid "82d32a93-92a0-595f-bf19-f646be42095b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110803/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-110803/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-110803/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-110803/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-110803/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-110803/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-110803" :question/id #uuid "1ddd6b32-1ad1-5a92-b6ca-5f243dfcc079" :question/math-academy-id "q-110803" :question/is-example false :question/problem "What is the product of solutions of the equation ${x}^{2}{10}^{2-x}={10}^{2-x}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}{10}^{2-x} & ={10}^{2-x} \\\\ {x}^{2}{10}^{2-x}-{10}^{2-x} & =0 \\\\ ({x}^{2}-1){10}^{2-x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-1=0\\,\\text{and}\\,{10}^{2-x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-1=0$ can be factored as\n\n$$\n(x+1)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-1,1.$\n\n- The equation ${10}^{2-x}=0$ has no solutions because ${10}^{2-x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $(-1)\\cdot 1=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110803/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f"] :knowledge-point/questions ["q-110803"] :db/ensure [:knowledge-point/validate]} {:db/id "q-264791/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "7e7d94f3-1075-5869-95c1-9ce80ef36b54" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-264791/field-1" :answer-field/id #uuid "e0f18529-5cd7-553b-aacd-e34689dff23f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-264791/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-264791/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-264791/field-2/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "4cecc6f4-7165-5cb6-b454-7e2b47cd401e" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-264791/field-2" :answer-field/id #uuid "b86430fc-cfe9-597b-b302-7cfa4b7b9da6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-264791/field-2/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer-field/choices ["q-264791/field-2/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf"] :db/ensure [:answer-field/validate]} {:db/id "q-264791" :question/id #uuid "13d3136f-c8ce-5240-a0b0-d1a910aed9ed" :question/math-academy-id "q-264791" :question/is-example false :question/problem "In **ascending order,** the solutions of the equation $3{x}^{2}\\cdot {7}^{x}+6\\cdot {7}^{x}=-11x\\cdot {7}^{x}$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}3{x}^{2}\\cdot {7}^{x}+6\\cdot {7}^{x} & =-11x\\cdot {7}^{x} \\\\ 3{x}^{2}\\cdot {7}^{x}+11x\\cdot {7}^{x}+6\\cdot {7}^{x}+ & =0 \\\\ (3{x}^{2}+11x+6)\\cdot {7}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n3{x}^{2}+11x+6=0\\,\\text{and}\\,{7}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $3{x}^{2}+11x+6=0$ can be factored as\n\n$$\n(3x+2)(x+3)=0,\n$$\n\nwhich leads to the solutions $x=-3,-\\frac{2}{3}.$\n\n- The equation ${7}^{x}=0$ has no solutions because ${7}^{x}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-3\\,\\text{and}\\,x=-\\frac{2}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-264791/field-1" "q-264791/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f"] :knowledge-point/questions ["q-264791"] :db/ensure [:knowledge-point/validate]} {:db/id "q-100797/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" :answer/id #uuid "f59981e6-be96-5245-b249-cc717dfb8d64" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-100797/selection/19d5466e84349f416e7f242f3eae0e8ce9f2558634cf0796beb62f8e60f5ea80" :answer/id #uuid "f9e95178-6e18-5d98-8efd-f6786a592aad" :answer/type :answer.type/math :answer/value "-\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-100797/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "acf61566-d03a-56c7-b1d4-c2f535e1926e" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-100797/selection/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" :answer/id #uuid "cc906f49-034b-5e7a-80f6-67ad1b8bfa88" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-100797/selection/3de79bddf6f841c5881cdae443d3aaa683eb5842e99646c5b7e2837e89382703" :answer/id #uuid "78b14b2b-787a-5568-a394-dbf37a8b3007" :answer/type :answer.type/math :answer/value "-\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-100797/selection" :answer-field/id #uuid "86058a2e-6e8a-5810-9dea-27bd7414930b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-100797/selection/19d5466e84349f416e7f242f3eae0e8ce9f2558634cf0796beb62f8e60f5ea80" :answer-field/choices ["q-100797/selection/71b1db0b2a675655ec27a2d2ceef2e86712a68eb78548232215378e0a354fb4c" "q-100797/selection/19d5466e84349f416e7f242f3eae0e8ce9f2558634cf0796beb62f8e60f5ea80" "q-100797/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-100797/selection/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" "q-100797/selection/3de79bddf6f841c5881cdae443d3aaa683eb5842e99646c5b7e2837e89382703"] :db/ensure [:answer-field/validate]} {:db/id "q-100797" :question/id #uuid "59fd1c88-e64b-571b-8fd9-be9c8ef64bf9" :question/math-academy-id "q-100797" :question/is-example false :question/problem "What is the product of solutions of the equation $5{x}^{2}\\cdot {8}^{x}=13x\\cdot {8}^{x}+6\\cdot {8}^{x}?$" :question/worked-solution "First, we factor the equation:\n\n  \n\n$$\n\\begin{aligned}5{x}^{2}\\cdot {8}^{x} & =13x\\cdot {8}^{x}+6\\cdot {8}^{x} \\\\ 5{x}^{2}\\cdot {8}^{x}-13x\\cdot {8}^{x}-6\\cdot {8}^{x} & =0 \\\\ (5{x}^{2}-13x-6)\\cdot {8}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n5{x}^{2}-13x-6=0\\,\\text{and}\\,{8}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $5{x}^{2}-13x-6=0$ can be factored as\n\n$$\n(5x+2)(x-3)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{2}{5},3.$\n\n- The equation ${8}^{x}=0$ has no solutions because ${8}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{2}{5},3,$ and their product is $(-\\frac{2}{5})\\cdot 3=-\\frac{6}{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-100797/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f"] :knowledge-point/questions ["q-100797"] :db/ensure [:knowledge-point/validate]} {:db/id "q-88473/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ddcdab85-f46b-5348-aad7-99379677a0ae" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-88473/selection/f7e51073a8044d706f62a310ce4d8f162b2fb8c60dce078b4b3b822d9f8ed6fa" :answer/id #uuid "2af8eaf1-3f7f-51fe-a959-646eb69f6fa0" :answer/type :answer.type/math :answer/value "\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "q-88473/selection/b78cefa051ec62e42babb0396ce415bc1c6b03c29d281d68224ab0312a503d34" :answer/id #uuid "6808e8ab-586b-52a9-9981-1999d75728be" :answer/type :answer.type/math :answer/value "-\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-88473/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "53c402cf-39e1-59cc-92f9-e4939083a715" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-88473/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf" :answer/id #uuid "c30a685e-2771-5345-8bfc-27e401cd0703" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-88473/selection" :answer-field/id #uuid "62ee4f50-f24d-5033-ab7d-06034a781711" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-88473/selection/b78cefa051ec62e42babb0396ce415bc1c6b03c29d281d68224ab0312a503d34" :answer-field/choices ["q-88473/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-88473/selection/f7e51073a8044d706f62a310ce4d8f162b2fb8c60dce078b4b3b822d9f8ed6fa" "q-88473/selection/b78cefa051ec62e42babb0396ce415bc1c6b03c29d281d68224ab0312a503d34" "q-88473/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-88473/selection/3a619fab2616dab0463f9c76cb72cd9f101e45e62111356a5b0b111e062a8dcf"] :db/ensure [:answer-field/validate]} {:db/id "q-88473" :question/id #uuid "9858ac9c-7073-5859-82e7-56fc2e1a0034" :question/math-academy-id "q-88473" :question/is-example false :question/problem "What is the product of solutions of the equation $4x\\cdot {6}^{x-2}=7\\cdot {6}^{x-2}-3{x}^{2}\\cdot {6}^{x-2}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4x\\cdot {6}^{x-2} & =7\\cdot {6}^{x-2}-3{x}^{2}\\cdot {6}^{x-2} \\\\ 3{x}^{2}\\cdot {6}^{x-2}+4x\\cdot {6}^{x-2}-7\\cdot {6}^{x-2} & =0 \\\\ (3{x}^{2}+4x-7)\\cdot {6}^{x-2} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n3{x}^{2}+4x-7=0\\,\\text{and}\\,{6}^{x-2}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $3{x}^{2}+4x-7=0$ can be factored as\n\n$$\n(3x+7)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{7}{3},1.$\n\n- The equation ${6}^{x-2}=0$ has no solutions because ${6}^{x-2}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{7}{3},1,$ and their product is $(-\\frac{7}{3})\\cdot 1=-\\frac{7}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-88473/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f"] :knowledge-point/questions ["q-88473"] :db/ensure [:knowledge-point/validate]} {:db/id "q-264787/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "eeb470f8-c23f-5e9f-b1ef-2340eab1cff0" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-264787/field-1" :answer-field/id #uuid "85f876b2-0ede-5183-9fe5-01bc45cc87fe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-264787/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-264787/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-264787/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "313d52fc-3afe-56b8-9ab9-104383e7c25e" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-264787/field-2" :answer-field/id #uuid "ab436e00-c814-5e79-8032-71eedf646119" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-264787/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-264787/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-264787" :question/id #uuid "5558ef32-69af-5d52-86fc-4fc49c1c3c53" :question/math-academy-id "q-264787" :question/is-example false :question/problem "In **ascending order,** the solutions of the equation $4{x}^{2}\\cdot {5}^{x-4}=144\\cdot {5}^{x-4}$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}4{x}^{2}\\cdot {5}^{x-4} & =144\\cdot {5}^{x-4} \\\\ 4{x}^{2}\\cdot {5}^{x-4}-144\\cdot {5}^{x-4} & =0 \\\\ (4{x}^{2}-144)\\cdot {5}^{x-4} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n4{x}^{2}-144=0\\,\\text{and}\\,{5}^{x-4}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $4{x}^{2}-144=0$ can be factored as\n\n$$\n\\begin{aligned}4({x}^{2}-36) & =0 \\\\ 4(x+6)(x-6) & =0,\\end{aligned}\n$$\n\nwhich leads to the solutions $x=-6,6.$\n\n- The equation $4=0$ is not a possible solution because it's a false statement.\n\n- The equation ${5}^{x-4}=0$ has no solutions because ${5}^{x-4}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-6\\,\\text{and}\\,x=6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-264787/field-1" "q-264787/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f"] :knowledge-point/questions ["q-264787"] :db/ensure [:knowledge-point/validate]}]
