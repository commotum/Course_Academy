3428 1104 #edb/ref 17592186243429 13194139533639 true] [17592186243428 1110 #uuid "7b0b30b2-a33a-573f-ab4e-249638505b81" 13194139533639 true] [17592186243429 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/6adc189f0d16cf60044553c13d79297c04f4fbfb2806a9bde6971b203822f17a.png" 13194139533639 true] [17592186243429 1103 #edb/ref 17592186045452 13194139533639 true] [17592186243429 1111 #uuid "130b240e-e849-5264-9d37-f2db7059c1cc" 13194139533639 true] [17592186243430 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/749d466c80d05d054b8d661b6c3405c92f904df65ca7c3442746d19f73394834.png" 13194139533639 true] [17592186243430 1103 #edb/ref 17592186045452 13194139533639 true] [17592186243430 1111 #uuid "192ea508-b7c4-5d93-a334-f5060ffdeafe" 13194139533639 true] [17592186243431 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/53d2977f07e132aa0e3c3608e8fef82f2d058fb1a99aa828ae8b317b8de6844a.png" 13194139533639 true] [17592186243431 1103 #edb/ref 17592186045452 13194139533639 true] [17592186243431 1111 #uuid "75db1385-dd3c-5856-b311-b70a2f0d9c08" 13194139533639 true] [17592186243432 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/4441bcb0d11698cff76c8e74c7c34a8109523a581eb5810c388e9f17c09e8176.png" 13194139533639 true] [17592186243432 1103 #edb/ref 17592186045452 13194139533639 true] [17592186243432 1111 #uuid "f2ea120e-8c3b-5af4-915b-321f84aec15d" 13194139533639 true] [17592186243433 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/6212d04b1004e0110d7aff817f03bab0b98f74dd5e334fe6607475ed13fe3fb0.png" 13194139533639 true] [17592186243433 1103 #edb/ref 17592186045452 13194139533639 true] [17592186243433 1111 #uuid "0c7502c9-b2f0-510b-a317-dc36f9057624" 13194139533639 true] [17592186243434 1017 #edb/ref 17592186243435 13194139533639 true] [17592186243434 1089 "q-31435" 13194139533639 true] [17592186243434 1091 #edb/ref 17592186045465 13194139533639 true] [17592186243434 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/016286e82482af83783f0eef6361591861b564643d4d9f010f2b82999fcaad27.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}+c.$ Find the value of $k-c.$" 13194139533639 true] [17592186243434 1113 #uuid "e11eb136-331c-59a1-bd47-5813f0e994df" 13194139533639 true] [17592186243434 1138 false 13194139533639 true] [17592186243434 1145 "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-4.$ Hence, $c=-4.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-2),$ so we substitute $x=0$ and $y=-2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{3})}^{x}+c & =y \\\\ k{(\\frac{1}{3})}^{x}-4 & =y \\\\ k{(\\frac{1}{3})}^{0}-4 & =-2 \\\\ k-4 & =-2 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=2-(-4)=6.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{3})}^{x}-4.$" 13194139533639 true] [17592186243435 1000 #edb/ref 17592186243436 13194139533639 true] [17592186243435 1000 #edb/ref 17592186243437 13194139533639 true] [17592186243435 1000 #edb/ref 17592186243438 13194139533639 true] [17592186243435 1000 #edb/ref 17592186243439 13194139533639 true] [17592186243435 1000 #edb/ref 17592186243440 13194139533639 true] [17592186243435 1040 #edb/ref 17592186045450 13194139533639 true] [17592186243435 1041 "selection" 13194139533639 true] [17592186243435 1104 #edb/ref 17592186243438 13194139533639 true] [17592186243435 1110 #uuid "476b40d2-fac8-57a3-a5b1-24c906856425" 13194139533639 true] [17592186243436 1034 "-5" 13194139533639 true] [17592186243436 1103 #edb/ref 17592186045453 13194139533639 true] [17592186243436 1111 #uuid "c02a727f-56bb-5ad0-beda-3be135f65bfc" 13194139533639 true] [