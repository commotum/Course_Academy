ecec20c86babce60bad95c67565e1227204c6e8a.png" :db/id #edb/ref 17592186243387} {:answer/id #uuid "56c094fc-87f6-5f75-900a-fcacf70759c2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/2192d5153baf0170024880585d956aec347caedc0f8ac1aeda56e9a225675863.png" :db/id #edb/ref 17592186243388} {:answer/id #uuid "af596da4-a6e8-5ba5-b9f2-46ef6d693134" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/61f2ea4ec54f64832bfc55bbb97e9ae57c96f710fa9ee09d8ccdc68d0357e798.png" :db/id #edb/ref 17592186243389} {:answer/id #uuid "76c114a3-95e5-543f-8c8c-55dc719f7809" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/1c6d66581178dc2e49c2b8b2b133224a7863efd416f10ac179e9fa7911880618.png" :db/id #edb/ref 17592186243390} {:answer/id #uuid "0c788c23-82b6-5747-be94-15fa27b605c5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/1fa60a8c5fb3fe49fd53c4ebcb89e0e430bb942146a7a0356ce2378d37c6b701.png" :db/id #edb/ref 17592186243391}] :answer-field/correct {:answer/id #uuid "56c094fc-87f6-5f75-900a-fcacf70759c2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/2192d5153baf0170024880585d956aec347caedc0f8ac1aeda56e9a225675863.png" :db/id #edb/ref 17592186243388} :answer-field/id #uuid "abcc4224-7f48-59e5-9c41-8a9e92b4fc99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243386}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2042b218-c119-51f1-8dc2-bb79477b816c" :question/is-example false :question/math-academy-id "q-27539" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{5})}^{x}+2?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{5})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/27e33d04bccb0136877dce919662aa5f78bb8315e6b2931461419fc8bc1664bd.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{5})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/d98570b1dc97924ccb9af8a252769f0873387b029dcd5f95be8be57942f2fb7a.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{5})}^{x}+2.$ To do this, we shift the above graph $2$ units up. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/2192d5153baf0170024880585d956aec347caedc0f8ac1aeda56e9a225675863.png)"}] [{:db/id #edb/ref 17592186243392 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04789e8c-530e-5f99-b339-2ab1ca589248" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/c64e79b7c0069aaf7d4393a6879612f58f48103247b1ba7efef3531dc3986b93.png" :db/id #edb/ref 17592186243394} {:answer/id #uuid "48fc0542-8d96-5c3f-ac4d-62f93d7c91e7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186243395} {:answer/id #uuid "779a0d56-e7b7-5908-ac3d-e6b3981554d3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/571e2268e6b7f41e80b71c8764d321c298fe58232e5b4c5a84ce309fa0dd3530.png" :db/id #edb/ref 17592186243396} {:answer/id #uuid "a0d71e5a-4fb7-5a97-a732-e8a1fecd8ab3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/3d7af2718ba7c30956218a00da51e77db950183bd2a85dbe74107e493fd5f03b.png" :db/id #edb/ref 17592186243397} {:answer/id #uuid "8496a3b4-ffda-51b1-aa50-e5b36497c0a8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/f63e49a2e8f4a0702841eb132093bf6f69b8405af25719ea8f5abbf2bd691122.png" :db/id #edb/ref 17592186243398}] :answer-field/correct {:answer/id #uuid "48fc0542-8d96-5c3f-ac4d-62f93d7c91e7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186243395} :answer-field/id #uuid "363733a3-a02c-57b5-8f6d-d37f0d351e5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243393}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ab17c05b-3a04-5ac4-9de0-6246c2badd83" :question/is-example false :question/math-academy-id "q-27540" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{4})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/e648e3a5f0c844d6596d4848629c3e6749647228116bcc5da6fce250895141d5.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/378016bbd17371e3dfee1e80934e76b1357139d405cb320ac5befa252da82b28.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,-\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png)"}] [{:db/id #edb/ref 17592186243399 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08bb92f0-da51-5e87-bc92-2c99a54e786b" :answer/type {:db/ident :answer.type/math} :answer/value "2.75" :db/id #edb/ref 17592186243401} {:answer/id #uuid "18e25cc2-6ead-5cfc-90e0-f04a30550817" :answer/type {:db/ident :answer.type/math} :answer/value "1.25" :db/id #edb/ref 17592186243402} {:answer/id #uuid "ff0222fb-2c06-5e14-942e-057278763256" :answer/type {:db/ident :answer.type/math} :answer/value "-1.75" :db/id #edb/ref 17592186243403} {:answer/id #uuid "5e1fb1ca-d7f4-5dfb-ace3-3b8c42de22d2" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186243404} {:answer/id #uuid "aa54ecc3-f2c7-58cc-808b-84b5360cdbc0" :answer/type {:db/ident :answer.type/math} :answer/value "-2.25" :db/id #edb/ref 17592186243405}] :answer-field/correct {:answer/id #uuid "aa54ecc3-f2c7-58cc-808b-84b5360cdbc0" :answer/type {:db/ident :answer.type/math} :answer/value "-2.25" :db/id #edb/ref 17592186243405} :answer-field/id #uuid "c10c5ee8-b03c-5652-96d4-546245ae0083" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243400}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8f13e5d3-ff2f-52ec-88f0-51b21c8f112c" :question/is-example false :question/math-academy-id "q-27542" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931416/assets/2a76eaba665b5d7c777ca794ca213bbdc55dfb46b94b49c71679e2c20910add7.png)\n\nThe graph above shows the curve $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=2.5.$ Hence, $c=2.5.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2.75),$ so we substitute $x=0$ and $y=2.75$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}+2.5 & =y \\\\ k{(\\frac{1}{2})}^{0}+2.5 & =2.75 \\\\ k+2.5 & =2.75 \\\\ k & =0.25.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=0.25-2.5=-2.25.\n$$\n\nThe equation of the curve is $y=0.25{(\\frac{1}{2})}^{x}+2.5.$"}] [{:db/id #edb/ref 17592186069121 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9268a5ae-033b-5992-a66a-11f66af2fc35" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186066270} {:answer/id #uuid "c1a9fbcc-0624-5ff1-a2ed-474f1e25a036" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186066271} {:answer/id #uuid "079715f2-f084-57f5-b3cb-15dc200dc705" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186066272} {:answer/id #uuid "0c0e0335-4b5a-5b44-b046-1659f7695b9b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186066273} {:answer/id #uuid "6ee7838e-10f9-5a20-b761-67688c82ea0a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186066274}] :answer-field/correct {:answer/id #uuid "c1a9fbcc-0624-5ff1-a2ed-474f1e25a036" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186066271} :answer-field/id #uuid "b1db1026-fdc5-5fbe-925d-8592f244f5d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066269}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "29d59c32-2de3-52b4-a443-c1163844c843" :question/is-example false :question/math-academy-id "q-27544" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/456/Source/Images/q-27544.png)\n\nThe graph above shows $y = k(\\frac{1}{6})^{x} + c$. Find the value of $k - c$." :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{6})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4,$ hence $c=4.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,6),$ so we substitute $x=0$ and $y=6$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{6})}^{x}+c & =y \\\\ k{(\\frac{1}{6})}^{x}+4 & =y \\\\ k{(\\frac{1}{6})}^{0}+4 & =6 \\\\ k+4 & =6 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore, \n\n$$\nk-c=2-4=-2.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{6})}^{x}+4.$"}] [{:db/id #edb/ref 17592186243406 :knowledge-point/_questions [{:knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted E