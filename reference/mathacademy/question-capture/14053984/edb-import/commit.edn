in [-\\pi ,-\\frac{\\pi }{2})\\cup (\\frac{\\pi }{2},\\pi ].\n$$" 13194139535105 true] [17592186331498 1000 #edb/ref 17592186331499 13194139535105 true] [17592186331498 1000 #edb/ref 17592186331500 13194139535105 true] [17592186331498 1000 #edb/ref 17592186331501 13194139535105 true] [17592186331498 1000 #edb/ref 17592186331502 13194139535105 true] [17592186331498 1000 #edb/ref 17592186331503 13194139535105 true] [17592186331498 1040 #edb/ref 17592186045450 13194139535105 true] [17592186331498 1041 "selection" 13194139535105 true] [17592186331498 1104 #edb/ref 17592186331502 13194139535105 true] [17592186331498 1110 #uuid "c9dfa021-a27c-5bbf-ad11-0eaca5b95334" 13194139535105 true] [17592186331499 1034 "t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})" 13194139535105 true] [17592186331499 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331499 1111 #uuid "9d974207-11f7-5c26-ae8b-7c3ae8870574" 13194139535105 true] [17592186331500 1034 "t\\in (-\\frac{\\pi }{4},\\frac{\\pi }{4})" 13194139535105 true] [17592186331500 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331500 1111 #uuid "8c0145f8-1c7b-57bc-bf7f-57887b782f47" 13194139535105 true] [17592186331501 1034 "t\\in [-\\pi ,0],\\,t\\ne -\\frac{\\pi }{2}" 13194139535105 true] [17592186331501 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331501 1111 #uuid "beda32a1-86fb-50fd-aea7-31a07b6249b7" 13194139535105 true] [17592186331502 1034 "t\\in [-\\pi ,-\\frac{\\pi }{2})\\cup (\\frac{\\pi }{2},\\pi ]" 13194139535105 true] [17592186331502 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331502 1111 #uuid "2ec629d0-52d3-505a-bcb9-b65cb5d919f4" 13194139535105 true] [17592186331503 1034 "t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),\\,t\\ne 0" 13194139535105 true] [17592186331503 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331503 1111 #uuid "6cfc2058-4cd0-5506-8a29-93e54a1eb58b" 13194139535105 true] [17592186331504 1017 #edb/ref 17592186331505 13194139535105 true] [17592186331