d-98e3bbc10be6" 13194139535105 true] [17592186331439 1034 "2\\sec(t)" 13194139535105 true] [17592186331439 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331439 1111 #uuid "a4c4efd4-8696-5898-a4b3-798bdcb218e2" 13194139535105 true] [17592186331440 1017 #edb/ref 17592186331441 13194139535105 true] [17592186331440 1089 "q-325901" 13194139535105 true] [17592186331440 1091 #edb/ref 17592186045465 13194139535105 true] [17592186331440 1100 "Complete the following parametric equations generating the hyperbola $2{x}^{2}-8{y}^{2}=16$ in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2}.$\n\n$x=2\\sqrt{2}\\operatorname{sec}⁡t,\\,$\n$y=$\n{{field-1}}" 13194139535105 true] [17592186331440 1113 #uuid "c609c76a-8513-596f-b37c-531435907db7" 13194139535105 true] [17592186331440 1145 "The parametric equations of a horizontal hyperbola with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t.\n$$\n\nFirst, we rewrite the equation of our hyperbola in standard form, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-8{y}^{2} & =16 \\\\ \\frac{2{x}^{2}}{16}-\\frac{8{y}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{8}-\\frac{{y}^{2}}{2} & =1\\end{aligned}\n$$\n\nSo, in our case, we have $a=\\sqrt{8}=2\\sqrt{2}$ and $b=\\sqrt{2}.$ Therefore, the parametric equations are\n\n$$\nx=2\\sqrt{2}\\operatorname{sec}⁡t,\\,y=\\sqrt{2}\\operatorname{tan}⁡t.\n$$" 13194139535105 true] [17592186331441 1000 #edb/ref 17592186331442 13194139535105 true] [17592186331441 1040 #edb/ref 17592186045449 13194139535105 true] [17592186331441 1041 "field-1" 13194139535105 true] [17592186331441 1104 #edb/ref 17592186331442 13194139535105 true] [17592186331441 1110 #uuid "39482ac3-275e-5c64-9ecd-bfd6084b5347" 13194139535105 true] [17592186331442 1034 "\\sqrt{2}\\tan(t)" 13194139535105 true] [17592186331442 1103 #edb/ref 17592186045453 13194139535105 true] [17592186331442 1111 #uuid "7c3c6d74-b01d-5edf-b002-4b32b47fe7b4" 13194139535105 true] [17592186331443 1017 #edb/ref 17592186331444 13194139535105 true] [17592186331443 1017 #edb/ref 17592186331447 13194139535105 true] [17592186331443 1089 "q-325916" 13194139535105 true] [17592186331443 1091 #edb/ref 17592186045463 13194139535105 true] [17592186331443 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14053984/assets/4561dbe8b730fa83f3044f7ab92bb5b2232e99b587269dbb31ffa463fd6ab348.png)\n\nComplete the following parametric equations generating the hyperbola above in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2},$ given that its asymptotes are $y=\\pm 3x.$\n\n$x=$\n{{field-1}}\n$\\operatorname{sec}⁡t,\\,y=$\n{{field-2}}" 13194139535105 true] [17592186331443 1113 #uuid "74e4d48e-d6f1-5008-97f3-88b68b096ca7" 13194139535105 true] [17592186331443 1145 "The parametric equations of a horizontal hyperbola centered at the origin with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t,\n$$\n\nwhere $a$ and $b$ are positive constants.\n\nThe vertices of the hyperbola occur at $(\\pm a,0).$ From the graph, we have that $(1,0)$ is a vertex of the hyperbola, so $a=1.$\n\nThe asymptotes of a horizontal hyperbola are $y=\\pm \\frac{b}{a}x.$ In our case, the asymptotes are $y=\\pm 3x,$ and so we have\n\n$$\n\\begin{aligned}\\frac{b}{a} & =3 \\\\ \\frac{b}{1} & =3 \\\\ b & =3.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the hyperbola are\n\n$$\nx=1\\operatorname{sec}⁡t,\\,y=3\\operatorname{tan}⁡t.\n$$" 13194139535105 true] [17592186331444 1000 #edb/ref 17592186331445 13194139535105 true] [17592186331444 1000 #edb/ref 17592186331446 13194139535105 true] [17592186331444 1040 #edb/ref 17592186045449 13194139535105 true] [17592186331444 1041 "field-1" 13194139535105 true] [17592186331444 1104 #edb/