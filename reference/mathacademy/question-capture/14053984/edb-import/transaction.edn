896"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325901/field-1/9bac4561cdf853769bc4badf2ce2c6fdee06afb4ffeabf259ddeb341d9b7d739" :answer/id #uuid "7c3c6d74-b01d-5edf-b002-4b32b47fe7b4" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-325901/field-1" :answer-field/id #uuid "39482ac3-275e-5c64-9ecd-bfd6084b5347" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325901/field-1/9bac4561cdf853769bc4badf2ce2c6fdee06afb4ffeabf259ddeb341d9b7d739" :answer-field/choices ["q-325901/field-1/9bac4561cdf853769bc4badf2ce2c6fdee06afb4ffeabf259ddeb341d9b7d739"] :db/ensure [:answer-field/validate]} {:db/id "q-325901" :question/id #uuid "c609c76a-8513-596f-b37c-531435907db7" :question/math-academy-id "q-325901" :question/problem "Complete the following parametric equations generating the hyperbola $2{x}^{2}-8{y}^{2}=16$ in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2}.$\n\n$x=2\\sqrt{2}\\operatorname{sec}⁡t,\\,$\n$y=$\n{{field-1}}" :question/worked-solution "The parametric equations of a horizontal hyperbola with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t.\n$$\n\nFirst, we rewrite the equation of our hyperbola in standard form, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-8{y}^{2} & =16 \\\\ \\frac{2{x}^{2}}{16}-\\frac{8{y}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{8}-\\frac{{y}^{2}}{2} & =1\\end{aligned}\n$$\n\nSo, in our case, we have $a=\\sqrt{8}=2\\sqrt{2}$ and $b=\\sqrt{2}.$ Therefore, the parametric equations are\n\n$$\nx=2\\sqrt{2}\\operatorname{sec}⁡t,\\,y=\\sqrt{2}\\operatorname{tan}⁡t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325901/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2669e657-da47-5e22-9ac5-7a69f3b0a55f"] :knowledge-point