⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{8}+1 & =\\frac{{x}^{2}}{25} \\\\ \\frac{{x}^{2}}{25}-\\frac{{y}^{2}}{8} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-325936/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d6ebe1f1-40fe-5226-8aed-b321f2e1e58b"] :knowledge-point/questions ["q-325936"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106522/selection/b06d6e3a5f1bbd84e88e3ec2506c82a77cdeb44e8600e544487046653a787dfa" :answer/id #uuid "dc0bab88-fbaa-5b0c-ab00-ae659f5ba695" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{16}=1" :db/ensure [:answer/validate]} {:db/id "q-106522/selection/e0752bc5b385fb958085581d3d90725273d9f47984d7c8319951f30bbcb7780e" :answer/id #uuid "400c700e-61ee-5fd9-8dcd-94bbe6c6dff7" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{\\sqrt{3}}-\\frac{{x}^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-106522/selection/6162ad3e067f88effd9de6d5a0726d9d46c2bdac11bb202e6af3a7b2402c232b" :answer/id #uuid "37338cf5-43ef-5a88-9aaa-ef87b102e514" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{16}=1" :db/ensure [:answer/validate]} {:db/id "q-106522/selection/03a5a20cf0bd3914300e918909a0dfab1d21a3ade96a02f7f8320977387530d6" :answer/id #uuid "b45ea980-dd72-50a4-9c54-757af2cbc3eb" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{\\sqrt{3}}-\\frac{{y}^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-106522/selection/9e558f77d6206e621e9d8b5994c3be4393bcd6aabc6378558245e5ed8a0afa51" :answer/id #uuid "a3eda697-bd17-509e-a542-897de33720bb" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-106522/selection" :answer-field/id #uuid "560064db-80ec-5712-b706-53edcb4fdb4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radi