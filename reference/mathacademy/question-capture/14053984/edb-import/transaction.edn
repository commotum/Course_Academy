idate]} {:db/id [:knowledge-point/id #uuid "d6ebe1f1-40fe-5226-8aed-b321f2e1e58b"] :knowledge-point/questions ["q-106522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106527/selection/c906bfbce86f90dcab9f9af6d01bce6678ae5a1be05e48ce97e35c4f32b1db56" :answer/id #uuid "33639763-4461-572a-9af6-cdc1c81a16f4" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{18}-\\frac{{y}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-106527/selection/ed88bd1456b2cd487e48544c90f72a25fa58b47e7d530bd2fe8552f2ea60a087" :answer/id #uuid "a59e4288-447a-5b62-8bad-e3c7b88f126f" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-106527/selection/e584eda2adde9867fbd90a1639c55e39eba03e22be4a2977324b38f2a889d249" :answer/id #uuid "a375ba33-56ae-5c6a-a380-792e5d9307e0" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-106527/selection/fc25c3ed151beda19c46eb44fd5d04e7b876d85cd42311e73fe5bb69a6874ba3" :answer/id #uuid "53348bd7-b394-5515-8130-6324c1c9ac6c" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{18}-\\frac{{x}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-106527/selection/40229ced4675b0109aa420866111e8da4c60798bc2c930c9bfbf6a9f9536ab6d" :answer/id #uuid "a7420e16-5924-53f3-b61c-97b9fa39437f" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-106527/selection" :answer-field/id #uuid "bc4ac55b-74bb-5316-90a4-762217d978c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106527/selection/c906bfbce86f90dcab9f9af6d01bce6678ae5a1be05e48ce97e35c4f32b1db56" :answer-field/choices ["q-106527/selection/c906bfbce86f90dcab9f9af6d01bce6678ae5a1be05e48ce97e35c4f32b1db56" "q-106527/selection/ed88bd1456b2cd487e48544c90f72a25fa58b47e7d530bd2fe8552f2ea60a087" "q-106527/selection/e584eda2adde9867fbd90a1639c55e39eba03e22be4a2977324b38f2a889d249" "q-106527/selection/fc25c3ed151beda19c46eb44fd5d04e7b876d85cd42311e73fe5bb69a6874ba3" "q-106527/selection/40229ced4675b0109aa420866111e8da4c60798bc2c930c9bfbf6a9f9536ab6d"] :db/ensure [:answer-field/validate]} {:db/id "q-106527" :question/id #uuid "9c1e05d1-cdc3-5f99-b424-96705dd43abe" :question/math-academy-id "q-106527" :question/problem "Find the Cartesian equation of the hyperbola $x=3\\sqrt{2}\\operatorname{sec}⁡t,\\,y=\\sqrt{3}\\operatorname{tan}⁡t.$" :question/worked-solution "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =3\\sqrt{2}\\operatorname{sec}⁡t \\\\ \\frac{x}{3\\sqrt{2}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(3\\sqrt{2})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{18} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =\\sqrt{3}\\operatorname{tan}⁡t \\\\ \\frac{y}{\\sqrt{3}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{(\\sqrt{3})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{3} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{3}+1 & =\\frac{{x}^{2}}{18} \\\\ \\frac{{x}^{2}}{18}-\\frac{{y}^{2}}{3} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106527/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d6ebe1f1-40fe-5226-8aed-b321f2e1e58b"] :knowledge-point/questions ["q-106527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325980/field-1/0e4e79001619645600fe317a8a7dc3e7c54e40dedca3eec2190744766458f0b4" :answer/id #uuid "563e7681-eafd-59b2-b