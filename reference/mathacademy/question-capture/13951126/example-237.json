{
  "dom_id": "step-e237",
  "name": "Example: Comparing an Exponential Function and a Polynomial Function",
  "problem": "Evaluate $\\displaystyle \\lim_{x\\to \\infty}\\dfrac{x^{100}}{e^x}.$",
  "worked_solution": "Both the numerator and denominator approach $\\infty$ as $x\\to\\infty.$ However, since $e^x \\gg x^{100}$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n\\lim_{x\\to \\infty}\\dfrac{x^{100}}{e^x} = 0.\n$$",
  "calculator_instructions": "",
  "fields": [],
  "result": null,
