er/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-106727/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "5bbc3fac-462e-53e5-bc42-690178e0f962" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-106727/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "c9b9fa0b-7bfa-5b5e-9f79-0f9ffb646013" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-106727/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "8786c66b-b3b1-5519-a8d3-d8db791f5dac" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-106727/selection" :answer-field/id #uuid "5568bc8a-7817-59ed-b9ab-725e9f63dcca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106727/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-106727/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-106727/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-106727/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-106727/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-106727/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-106727" :question/id #uuid "155d15d7-40bc-53f2-86e9-8d181bcceeed" :question/math-academy-id "q-106727" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-3\\operatorname{sin}⁡x|\\le 3.\n$$\n\nHowever, the denominator ${x}^{2}-2$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951126/assets/9fade66030e2e416f92138d787999d3ca3a7dd4788ad39cf29dd07ff944038da.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106727/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074"] :knowledge-point/questions ["q-106727"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106831/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "21604138-62a6-5027-9b5d-e8cc899b1b96" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-106831/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "6f410760-538b-569b-895f-896d22c26650" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-106831/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "a2259eae-d38a-5221-bce0-6cbc589b751b" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-106831/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f09a64ab-0639-5e78-8ad2-938a124bd2f3" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-106831/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "53a3466e-112c-537a-acf