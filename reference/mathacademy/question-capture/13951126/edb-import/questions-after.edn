#{[{:db/id #edb/ref 17592186078139 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5414e634-9b33-5dac-9686-4e570efbc7e6" :knowledge-point/title "Comparing an Exponential Function and a Polynomial Function"}] :question/id #uuid "ce4b3604-5402-5cff-9ff4-fa73b6af3885" :question/math-academy-id "e-237" :question/problem "Evaluate $\\displaystyle \\lim_{x\\to \\infty}\\dfrac{x^{100}}{e^x}$." :question/worked-solution "Both the numerator and denominator approach $\\infty$ as $x\\to\\infty$. However, since $e^x \\gg x^{100}$ for large values of $x$, the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n\\lim_{x\\to \\infty}\\dfrac{x^{100}}{e^x} = 0\n$$"}] [{:db/id #edb/ref 17592186078140 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/id #uuid "811da414-bf42-50dd-9521-3174fbfc8340" :question/math-academy-id "e-238" :question/problem "Evaluate $\\displaystyle \\lim_{x\\to \\infty}\\dfrac{x}{\\ln{x}}$." :question/worked-solution "Both the numerator and denominator approach $\\infty$ as $x\\to\\infty$. However, since $x \\gg \\ln{x}$ for large values of $x$, the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n\\lim_{x\\to \\infty}\\dfrac{x}{\\ln{x}} = \\infty\n$$"}] [{:db/id #edb/ref 17592186078141 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93" :knowledge-point/title "Comparing an Exponential Function and a Logarithmic Function"}] :question/id #uuid "39e8332d-2c2f-5f03-b97d-6be35b31db85" :question/math-academy-id "e-239" :question/problem "Evaluate $\\displaystyle \\lim_{x\\to \\infty}\\dfrac{e^{2x}}{\\ln{x}}$." :question/worked-solution "Both the numerator and denominator approach $\\infty$ as $x\\to\\infty$. However, since $e^{2x} \\gg \\ln{x}$ for large values of $x$, the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n\\lim_{x\\to \\infty}\\dfrac{e^{2x}}{\\ln{x}} = \\infty\n$$"}] [{:db/id #edb/ref 17592186078142 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/id #uuid "f33d2107-befc-53cf-b835-c9adb731b707" :question/math-academy-id "e-241" :question/problem "Evaluate $\\displaystyle \\lim_{x\\to \\infty}\\dfrac{\\cos x}{x^2+1}$." :question/worked-solution "The numerator here is a bounded, oscillating function with\n\n$$\n\\mid \\cos x \\mid \\leq 1\n$$\n\nHowever, the denominator $x^2+1$ grows without bound as $x\\to\\infty$. So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n\\lim_{x\\to \\infty}\\dfrac{\\cos x}{x^2+1} = 0\n$$\n\nWe can see this from the graph of\n\n$$\ny=\\dfrac{\\cos x}{x^2+1}\n$$\n\nshown below:\n\n![](/home/jake/Developer/MA/DATA/Lessons/607/Source/Images/2887328aab485652d020545444662790.png)"}] [{:db/id #edb/ref 17592186264917 :knowledge-point/_questions [{:knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74408159-a566-5df0-8024-dd783fc58ab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186264919} {:answer/id #uuid "7c69945a-70a3-50b5-bfec-1845445bd9a9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264920} {:answer/id #uuid "5174367b-a8d6-5dc5-bc2f-f2099d86b149" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186264921} {:answer/id #uuid "1864f4b4-b09d-54ad-b16e-933087c22479" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264922} {:answer/id #uuid "11434555-83f4-529d-8eee-a53d1ca75965" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186264923}] :answer-field/correct {:answer/id #uuid "1864f4b4-b09d-54ad-b16e-933087c22479" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264922} :answer-field/id #uuid "9c36f11c-e7f2-5e77-b445-8cf2c33b571f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264918}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ebf9b8cd-b3bc-545f-b305-7789d1160b35" :question/math-academy-id "q-106718" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x}{(x-2)^{3}}.$" :question/worked-solution "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since $(x-2)^{3}≫\\operatorname{ln}⁡x$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x}{(x-2)^{3}}=0.\n$$"}] [{:db/id #edb/ref 17592186264924 :knowledge-point/_questions [{:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9b9fa0b-7bfa-5b5e-9f79-0f9ffb646013" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186264926} {:answer/id #uuid "093f3cf3-a079-57a7-8c18-f79d43422e45" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264927} {:answer/id #uuid "8786c66b-b3b1-5519-a8d3-d8db791f5dac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186264928} {:answer/id #uuid "5bbc3fac-462e-53e5-bc42-690178e0f962" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186264929} {:answer/id #uuid "ace054b6-c442-59cd-951d-9d7a7e6f421e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264930}] :answer-field/correct {:answer/id #uuid "ace054b6-c442-59cd-951d-9d7a7e6f421e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264930} :answer-field/id #uuid "5568bc8a-7817-59ed-b9ab-725e9f63dcca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264925}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "155d15d7-40bc-53f2-86e9-8d181bcceeed" :question/math-academy-id "q-106727" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-3\\operatorname{sin}⁡x|\\le 3.\n$$\n\nHowever, the denominator ${x}^{2}-2$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13951126/assets/9fade66030e2e416f92138d787999d3ca3a7dd4788ad39cf29dd07ff944038da.png)"}] [{:db/id #edb/ref 17592186264931 :knowledge-point/_questions [{:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f48425e-5b15-5653-9fe9-be4d75263127" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty "