#{[{:db/id #edb/ref 17592186267135 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eacf1e8c-b214-58e0-936d-7bb5bb3351ef" :answer/type {:db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186267137} {:answer/id #uuid "10c6353e-0e74-5476-8dd3-f5e1d2d68637" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186267138} {:answer/id #uuid "4e4e6a36-b556-59a0-b2d6-e276895bd7ba" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186267139} {:answer/id #uuid "0d0c7c91-a277-5590-95e2-be40c847eda4" :answer/type {:db/ident :answer.type/math} :answer/value "(6,2)" :db/id #edb/ref 17592186267140} {:answer/id #uuid "6ceaf4cf-d785-5810-b319-89d88e1683f9" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186267141}] :answer-field/correct {:answer/id #uuid "6ceaf4cf-d785-5810-b319-89d88e1683f9" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,5)" :db/id #edb/ref 17592186267141} :answer-field/id #uuid "2cc81187-eeb9-53bf-862d-aa72f284dcc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267136}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fc3e7d2f-c4c6-5347-9564-94778a43e2b5" :question/math-academy-id "q-116100" :question/problem "What is the center of the hyperbola $\\frac{(y-5)^{2}}{36}-\\frac{(x+1)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-5)^{2}}{{6}^{2}}-\\frac{(x-(-1))^{2}}{{2}^{2}}=1\n$$\n\nIn this case, we have $h=-1$ and $k=5.$\n\nTherefore, the center of the hyperbola is $(-1,5).$"}] [{:db/id #edb/ref 17592186267142 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be08db7b-05e3-5537-8968-8f794219a493" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4)" :db/id #edb/ref 17592186267144} {:answer/id #uuid "a1b2705f-c08e-54ac-81d8-d20bef31bb92" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186267145} {:answer/id #uuid "372ed86a-17ee-5e1f-aba8-c92f163fe628" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186267146} {:answer/id #uuid "685a4859-17e5-5c3d-a199-cbbe6f1a12ac" :answer/type {:db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186267147} {:answer/id #uuid "ecd90ab1-7c5f-52da-87b0-4cebde4d8500" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186267148}] :answer-field/correct {:answer/id #uuid "372ed86a-17ee-5e1f-aba8-c92f163fe628" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-6)" :db/id #edb/ref 17592186267146} :answer-field/id #uuid "da37de31-9a67-5942-83f5-18a5aa8ffe4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a406b7e1-fcbb-588b-8110-b352d39705a5" :question/math-academy-id "q-116110" :question/problem "What is the center of the hyperbola \n$6{x}^{2}-4{y}^{2}+48x-48y=72?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}+48x-48y & =72 \\\\ 6{x}^{2}+48x-4{y}^{2}-48y & =72 \\\\ 6[{x}^{2}+8x]-4[{y}^{2}+12y] & =72 \\\\ 6[(x+4)^{2}-16]-4[(y+6)^{2}-36] & =72 \\\\ 6(x+4)^{2}-96-4(y+6)^{2}+144 & =72 \\\\ 6(x+4)^{2}-4(y+6)^{2} & =24 \\\\ \\frac{(x+4)^{2}}{4}-\\frac{(y+6)^{2}}{6} & =1 \\\\ \\frac{(x-(-4))^{2}}{{2}^{2}}-\\frac{(y-(-6))^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-4,-6).$"}] [{:db/id #edb/ref 17592186267149 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1789ddd2-63ce-5552-af26-c814ec646ed8" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186267151} {:answer/id #uuid "f05ad2ef-3409-5fda-aea0-7bfbfd58866a" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186267152} {:answer/id #uuid "727eaf3e-e97d-5835-8e68-19faa7b4303e" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186267153} {:answer/id #uuid "51122adb-3316-5207-b7ef-ce24c3dcdd28" :answer/type {:db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186267154} {:answer/id #uuid "7eeaa181-5db1-5387-870c-35545189a0aa" :answer/type {:db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186267155}] :answer-field/correct {:answer/id #uuid "727eaf3e-e97d-5835-8e68-19faa7b4303e" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186267153} :answer-field/id #uuid "86a573af-28de-564d-bbce-e4f73ffdfdc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267150}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "954e8179-80da-5750-a69a-2da4b70ee4e9" :question/math-academy-id "q-116116" :question/problem "What is the center of the hyperbola $6{y}^{2}-4{x}^{2}-60y+8x=-122?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}6{y}^{2}-4{x}^{2}-60y+8x & =-122 \\\\ 6{y}^{2}-60y-4{x}^{2}+8x & =-122 \\\\ 6[{y}^{2}-10y]-4[{x}^{2}-2x] & =-122 \\\\ 6[(y-5)^{2}-25]-4[(x-1)^{2}-1] & =-122 \\\\ 6(y-5)^{2}-150-4(x-1)^{2}+4 & =-122 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =-122+150-4 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =24 \\\\ \\frac{(y-5)^{2}}{4}-\\frac{(x-1)^{2}}{6} & =1 \\\\ \\frac{(y-5)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(1,5).$"}] [{:db/id #edb/ref 17592186267156 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f819b6df-f1a1-5abc-b712-cb855bd02898" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186267158}] :answer-field/correct {:answer/id #uuid "f819b6df-f1a1-5abc-b712-cb855bd02898" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186267158} :answer-field/id #uuid "b6d5b839-c9ef-5186-9ab4-af16c15ad620" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267157} {:answer-field/choices [{:answer/id #uuid "4482a321-d5fd-5ba5-bbf4-4e5e3262cbe5" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186267160}] :answer-field/correct {:answer/id #uuid "4482a321-d5fd-5ba5-bbf4-4e5e3262cbe5" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186267160} :answer-field/id #uuid "ce603fb2-3abf-532d-8f77-3bb235cf46f1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267159}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6f86732d-fb37-5966-b7ad-6f354577e19d" :question/math-academy-id "q-328298" :question/problem "The center of the hyperbola $\\frac{(y-9)^{2}}{25}-\\frac{(x-14)^{2}}{36}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-9)^{2}}{{5}^{2}}-\\frac{(x-14)^{2}}{{6}^{2}}=1\n$$\n\nIn this case, we have $h=14$ and $k=9.$\n\nTherefore, the center of the hyperbola is $(\\,14,9\\,).$"}] [{:db/id #edb/ref 17592186267161 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e9e5a4c-416b-5028-b5b6-646a1c5818e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267163}] :answer-field/correct {:answer/id #uuid "2e9e5a4c-416b-5028-b5b6-646a1c5818e8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267163} :answer-field/id #uuid "f9925787-6d8a-5911-8406-4e9495b5d59b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267162} {:answer-field/choices [{:answer/id #uuid "d89b1c66-572c-5a70-9d80-844b5bb2dca9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186267165}] :answer-field/correct {:answer/id #uuid "d89b1c66-572c-5a70-9d80-844b5bb2dca9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186267165} :answer-field/id #uuid "7551e459-0c93-5df6-9ec2-28e1338d4aa6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267164}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9a628b2c-cc72-58f9-98ac-cd7dac37c2cc" :question/math-academy-id "q-328401" :question/problem "The center of the hyperbola $16{y}^{2}-25{x}^{2}+96y=256$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}16{y}^{2}-25{x}^{2}+96y & =256 \\\\ 16{y}^{2}+96y\\,-\\,25{x}^{2} & =256 \\\\ 16[{y}^{2}+6y]\\,-\\,25{x}^{2} & =256 \\\\ 16[(y+3)^{2}-9]\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-144\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-25{x}^{2} & =256+144 \\\\ 16(y+3)^{2}-25{x}^{2} & =400 \\\\ \\frac{(y+3)^{2}}{25}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{(y-(-3))^{2}}{25}-\\frac{{x}^{2}}{16} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,0,-3\\,).$"}]}
