-94778a43e2b5" :question/math-academy-id "q-116100" :question/problem "What is the center of the hyperbola $\\frac{(y-5)^{2}}{36}-\\frac{(x+1)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-5)^{2}}{{6}^{2}}-\\frac{(x-(-1))^{2}}{{2}^{2}}=1\n$$\n\nIn this case, we have $h=-1$ and $k=5.$\n\nTherefore, the center of the hyperbola is $(-1,5).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-116100/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9"] :knowledge-point/questions ["q-116100"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116110/selection/778c353184dc2f90b9c60c504f37ad8f6d048fa9753af8c9158889f74a47bc06" :answer/id #uuid "372ed86a-17ee-5e1f-aba8-c92f163fe628" :answer/type :answer.type/math :answer/value "(-4,-6)" :db/ensure [:answer/validate]} {:db/id "q-116110/selection/036aea2a22728e00f002a3663dc7c52238513c28652c42149da20e1d2f70e918" :answer/id #uuid "be08db7b-05e3-5537-8968-8f794219a493" :answer/type :answer.type/math :answer/value "(-6,-4)" :db/ensure [:answer/validate]} {:db/id "q-116110/selection/d64fb1d86ad534b738c55c0cdd7711503752307f7a8376f7004b159563e09c3f" :answer/id #uuid "ecd90ab1-7c5f-52da-87b0-4cebde4d8500" :answer/type :answer.type/math :answer/value "(-4,2)" :db/ensure [:answer/validate]} {:db/id "q-116110/selection/87afcf1f52d3c7a155a8fed03dd6141198cb280e8a8412a016fff34fc30d942f" :answer/id #uuid "685a4859-17e5-5c3d-a199-cbbe6f1a12ac" :answer/type :answer.type/math :answer/value "(4,6)" :db/ensure [:answer/validate]} {:db/id "q-116110/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81" :answer/id #uuid "a1b2705f-c08e-54ac-81d8-d20bef31bb92" :answer/type :answer.type/math :answer/value "(6,-4)" :db/ensure [:answer/validate]} {:db/id "q-116110/selection" :answer-field/id #uuid "da37de31-9a67-5942-83f5-18a5aa8ffe4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116110/selection/778c353184dc2f90b9c60c504f37ad8f6d048fa9753af8c9158889f74a47bc06" :answer-field/choices ["q-116110/selection/778c353184dc2f90b9c60c504f37ad8f6d048fa9753af8c9158889f74a47bc06" "q-116110/selection/036aea2a22728e00f002a3663dc7c52238513c28652c42149da20e1d2f70e918" "q-116110/selection/d64fb1d86ad534b738c55c0cdd7711503752307f7a8376f7004b159563e09c3f" "q-116110/selection/87afcf1f52d3c7a155a8fed03dd6141198cb280e8a8412a016fff34fc30d942f" "q-116110/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81"] :db/ensure [:answer-field/validate]} {:db/id "q-116110" :question/id #uuid "a406b7e1-fcbb-588b-8110-b352d39705a5" :question/math-academy-id "q-116110" :question/problem "What is the center of the hyperbola \n$6{x}^{2}-4{y}^{2}+48x-48y=72?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}+48x-48y & =72 \\\\ 6{x}^{2}+48x-4{y}^{2}-48y & =72 \\\\ 6[{x}^{2}+8x]-4[{y}^{2}+12y] & =72 \\\\ 6[(x+4)^{2}-16]-4[(y+6)^{2}-36] & =72 \\\\ 6(x+4)^{2}-96-4(y+6)^{2}+144 & =72 \\\\ 6(x+4)^{2}-4(y+6)^{2} & =24 \\\\ \\frac{(x+4)^{2}}{4}-\\frac{(y+6)^{2}}{6} & =1 \\\\ \\frac{(x-(-4))^{2}}{{2}^{2}}-\\frac{(y-(-6))^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-4,-6).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-116110/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951"] :knowledge-point/questions ["q-116110"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116116/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81" :answer/id #uuid "1789ddd2-63ce-5552-af26-c814ec646ed8" :answer/type :answer.type/math :answer/value "(6,-4)" :db/ensure [:answer/validate]} {:db/id "q-116116/selection/8e581b09527373b2c046d3c04ffa0d440c27569eeb5d9ffd3f615d6875c22ec0" :answer/id #uuid "7eeaa181-5db1-5387-870c-35545189a0aa" :answer/type :answer.type/math :answer/value "(5,1)" :db/ensure [:answer/validate]} {:db/id "q-116116/selection/87afcf1f52d3c7a155a8fed03dd6141198cb280e8a8412a016fff34fc30d942f" :answer/id #uuid "51122adb-3316-5207-b7ef-ce24c3dcdd28" :answer/type :answer.type/math :answer/value "(4,6)" :db/ensure [:answer/validate]} {:db/id "q-116116/selection/7209a43b6c2b5cd8e9c292ea9df705bd6ad91c4f5f412791404f866b94343db5" :answer/id #uuid "f05ad2ef-3409-5fda-aea0-7bfbfd58866a" :answer/type :answer.type/math :answer/value "(-5,-1)" :db/ensure [:answer/validate]} {:db/id "q-116116/selection/7a63746fb154abad8b03f812bbe07834b58e3ebbe52640c382bc0d9cd40b4132" :answer/id #uuid "727eaf3e-e97d-5835-8e68-19faa7b4303e" :answer/type :answer.type/math :answer/value "(1,5)" :db/ensure [:answer/validate]} {:db/id "q-116116/selection" :answer-field/id #uuid "86a573af-28de-564d-bbce-e4f73ffdfdc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116116/selection/7a63746fb154abad8b03f812bbe07834b58e3ebbe52640c382bc0d9cd40b4132" :answer-field/choices ["q-116116/selection/401841f7536576d236fbc5fc31b0e2dc5ff496d71830d571a3cabd2a4af6de81" "q-116116/selection/8e581b09527373b2c046d3c04ffa0d440c27569eeb5d9ffd3f615d6875c22ec0" "q-116116/selection/87afcf1f52d3c7a155a8fed03dd6141198cb280e8a8412a016fff34fc30d942f" "q-116116/selection/7209a43b6c2b5cd8e9c292ea9df705bd6ad91c4f5f412791404f866b94343db5" "q-116116/selection/7a63746fb154abad8b03f812bbe07834b58e3ebbe52640c382bc0d9cd40b4132"] :db/ensure [:answer-field/validate]} {:db/id "q-116116" :question/id #uuid "954e8179-80da-5750-a69a-2da4b70ee4e9" :question/math-academy-id "q-116116" :question/problem "What is the center of the hyperbola $6{y}^{2}-4{x}^{2}-60y+8x=-122?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}6{y}^{2}-4{x}^{2}-60y+8x & =-122 \\\\ 6{y}^{2}-60y-4{x}^{2}+8x & =-122 \\\\ 6[{y}^{2}-10y]-4[{x}^{2}-2x] & =-122 \\\\ 6[(y-5)^{2}-25]-4[(x-1)^{2}-1] & =-122 \\\\ 6(y-5)^{2}-150-4(x-1)^{2}+4 & =-122 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =-122+150-4 \\\\ 6(y-5)^{2}-4(x-1)^{2} & =24 \\\\ \\frac{(y-5)^{2}}{4}-\\frac{(x-1)^{2}}{6} & =1 \\\\ \\frac{(y-5)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(1,5).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116116/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af"] :knowledge-point/questions ["q-116116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328298/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "f819b6df-f1a1-5abc-b712-cb855bd02898" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-328298/field-1" :answer-field/id #uuid "b6d5b839-c9ef-5186-9ab4-af16c15ad620" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328298/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-328298/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-328298/field-2/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "4482a321-d5fd-5ba5-bbf4-4e5e3262cbe5" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-328298/field-2" :answer-field/id #uuid "ce603fb2-3abf-532d-8f77-3bb235cf46f1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328298/field-2/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-328298/field-2/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-328298" :question/id #uuid "6f86732d-fb37-5966-b7ad-6f354577e19d" :question/math-academy-id "q-328298" :question/problem "The center of the hyperbola $\\frac{(y-9)^{2}}{25}-\\frac{(x-14)^{2}}{36}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-9)^{2}}{{5}^{2}}-\\frac{(x-14)^{2}}{{6}^{2}}=1\n$$\n\nIn this case, we have $h=14$ and $k=9.$\n\nTherefore, the center of the hyperbola is $(\\,14,9\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328298/field-1" "q-328298/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9"] :knowledge-point/questions ["q-328298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328401/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2e9e5a4c-416b-5028-b5b6-646a1c5818e8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328401/field-1" :answer-field/id #uuid "f9925787-6d8a-5911-8406-4e9495b5d59b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328401/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328401/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328401/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "d89b1c66-572c-5a70-9d80-844b5bb2dca9" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-328401/field-2" :answer-field/id #uuid "7551e459-0c93-5df6-9ec2-28e1338d4aa6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328401/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-328401/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-328401" :question/id #uuid "9a628b2c-cc72-58f9-98ac-cd7dac37c2cc" :question/math-academy-id "q-328401" :question/problem "The center of the hyperbola $16{y}^{2}-25{x}^{2}+96y=256$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}16{y}^{2}-25{x}^{2}+96y & =256 \\\\ 16{y}^{2}+96y\\,-\\,25{x}^{2} & =256 \\\\ 16[{y}^{2}+6y]\\,-\\,25{x}^{2} & =256 \\\\ 16[(y+3)^{2}-9]\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-144\\,-\\,25{x}^{2} & =256 \\\\ 16(y+3)^{2}-25{x}^{2} & =256+144 \\\\ 16(y+3)^{2}-25{x}^{2} & =400 \\\\ \\frac{(y+3)^{2}}{25}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{(y-(-3))^{2}}{25}-\\frac{{x}^{2}}{16} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,0,-3\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328401/field-1" "q-328401/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af"] :knowledge-point/questions ["q-328401"] :db/ensure [:knowledge-point/validate]}]
