#{[{:db/id #edb/ref 17592186298091 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c6dabfd-9272-5b92-8b93-6ffc7a94f8f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{24}^{∘}" :db/id #edb/ref 17592186298093} {:answer/id #uuid "049d84c3-5dcd-51a6-a89d-941c6562271d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡{48}^{∘}" :db/id #edb/ref 17592186298094} {:answer/id #uuid "6d406fed-1761-56b4-96e4-a7031536d84c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡{48}^{∘}" :db/id #edb/ref 17592186298095} {:answer/id #uuid "62113e5f-6e48-5729-83fd-962eab093710" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡{24}^{∘}" :db/id #edb/ref 17592186298096} {:answer/id #uuid "fb006d59-2de8-558a-b0c3-d07648440291" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{24}^{∘}" :db/id #edb/ref 17592186298097}] :answer-field/correct {:answer/id #uuid "7c6dabfd-9272-5b92-8b93-6ffc7a94f8f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{24}^{∘}" :db/id #edb/ref 17592186298093} :answer-field/id #uuid "f59a9310-1cc1-5e1c-95eb-129665fa94a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298092}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6936b757-bb9a-5d9f-83d7-ff21b4bd2dc1" :question/math-academy-id "q-65612" :question/problem "$\\frac{\\operatorname{sin}⁡{48}^{∘}}{2\\operatorname{cos}⁡{24}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={24}^{∘}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot {24}^{∘})=2\\operatorname{sin}⁡{24}^{∘}\\operatorname{cos}⁡{24}^{∘}\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡{48}^{∘}=2\\operatorname{sin}⁡{24}^{∘}\\operatorname{cos}⁡{24}^{∘}.\n$$\n\nDividing both sides by $2\\operatorname{cos}⁡{24}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{48}^{∘}}{2\\operatorname{cos}⁡{24}^{∘}} & =\\frac{2\\operatorname{sin}⁡{24}^{∘}\\operatorname{cos}⁡{24}^{∘}}{2\\operatorname{cos}⁡{24}^{∘}} \\\\  & =\\frac{\\cancel{2}\\operatorname{sin}⁡{24}^{∘}\\cancel{\\operatorname{cos}⁡{24}^{∘}}}{\\cancel{2}\\cancel{\\operatorname{cos}⁡{24}^{∘}}} \\\\  & =\\operatorname{sin}⁡{24}^{∘}.\\end{aligned}\n$$"}]}
