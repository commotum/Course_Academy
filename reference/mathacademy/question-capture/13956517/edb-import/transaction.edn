n/392d47a4d15f50a0390bdb079def6c564ee841f3b832b2f4576be4c48630564a" "q-72449/selection/eee9a5a89048b8bedfdb6dac7f70be09ed1525f3431653c498e28f939d8598a3"] :db/ensure [:answer-field/validate]} {:db/id "q-72449" :question/id #uuid "10424ddf-9d5d-5bfc-9c80-d27d0ba4ff7c" :question/math-academy-id "q-72449" :question/problem "Calculate $\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x & =\\int \\frac{1}{2x+1}\\,\\text{d}x+\\int \\frac{1}{2x-1}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+1|+\\frac{1}{2}\\operatorname{ln}⁡|2x-1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|(2x+1)(2x-1)|+\\frac{1}{2}\\text{ }\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72449/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef"] :knowledge-point/questions ["q-72449"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113532/selection/ec42298c18b43ab9bebb9f4d848b5763c4805f6fef8f2295d0152594b3999b28" :answer/id #uuid "7dcd43f5-90f8-5cf2-b91c-9db978047590" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{|2x+3|}{K})" :db/ensure [:answer/validate]} {:db/id "q-113532/selection/0f006ea0c73603dbdf670f8b26ac85ee4f698ced4f390cafa7b1d929192cd60a" :answer/id #uuid "09b19c3b-372f-5e2c-a21d-c0137bd3de2e" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\operatorname{ln}⁡(K|2x+3|)" :db/ensure [:answer/validate]} {:db/id "q-113532/selection/da91ce48c10df283586618e21cac6f081c883d84543d64528c983610b14c2922" :answer/id #uuid "dc97a120-fa31-5d36-9cbc-219c3b3ee8ce" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|)" :db/ensure [:answer/validate]} {:db/id "q-113532/selection/f7aa43d2b0b9e607712eab51bb0d7db533d14882a76543e046a981c40205b6f1" :answer/id #uuid "e41b7475-5c74-51d9-a169-f36b31ab242b" :answer/type :answer.type/math :answer/value "\\frac{K}{2}\\operatorname{ln}⁡(|2x+3|)" :db/ensure [:answer/validate]} {:db/id "q-113532/selection/d8e96540a2f090e1790acf86b3a500f41f7ab6f863739a1c65807a7c9d3fe25e" :answer/id #uuid "ed508d23-9cf2-587a-a345-c2c1c3eb9971" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|2x+3|)" :db/ensure [:answer/validate]} {:db/id "q-113532/selection" :answer-field/id #uuid "5cf56cba-5ee6-55f4-9300-c6bb3106f1df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113532/selection/da91ce48c10df283586618e21cac6f081c883d84543d64528c983610b14c2922" :answer-field/choices ["q-113532/selection/ec42298c18b43ab9bebb9f4d848b5763c4805f6fef8f2295d0152594b3999b28" "q-113532/selection/0f006ea0c73603dbdf670f8b26ac85ee4f698ced4f390cafa7b1d929192cd60a" "q-113532/selection/da91ce48c10df283586618e21cac6f081c883d84543d64528c983610b14c2922" "q-113532/selection/f7aa43d2b0b9e607712eab51bb0d7db533d14882a76543e046a981c40205b6f1" "q-113532/selection/d8e96540a2f090e1790acf86b3a500f41f7ab6f863739a1c65807a7c9d3fe25e"] :db/ensure [:answer-field/validate]} {:db/id "q-113532" :question/id #uuid "88da6b06-825c-5185-a63b-2e45c9655fa3" :question/math-academy-id "q-113532" :question/problem "Calculate $\\int \\frac{1}{2x+3}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=2x+3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{2x+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+C & =\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡|2x+3|+\\operatorname{ln}⁡K) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{2x+3}\\,\\text{d}x=\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d"] :knowledge-point/questions ["q-113532"] :db/ensure [:knowledge-point/validate]}]
