49479d" "q-49522/selection/53f52952f88900e06fa3e55a0348e3109176f86ab40996bc9296550462f87952"] :db/ensure [:answer-field/validate]} {:db/id "q-49522" :question/id #uuid "8ec8edfd-26cb-55fe-a035-4092a8a78069" :question/math-academy-id "q-49522" :question/problem "Calculate $\\int (\\frac{1}{1+5x}+\\frac{1}{1-5x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{1+5x}+\\frac{1}{1-5x})\\,\\text{d}x & =\\int \\frac{1}{1+5x}\\,\\text{d}x+\\int \\frac{1}{1-5x}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|1+5x|-\\frac{1}{5}\\operatorname{ln}⁡|1-5x|+C \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|\\frac{1+5x}{1-5x}|+\\frac{1}{5}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49522/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef"] :knowledge-point/questions ["q-49522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72445/selection/b37f2f579328f96387b66276ef772d9cf20c184b7b71f1e6e9d53b04581bdd8d" :answer/id #uuid "16ca95ec-320e-55ab-8295-8ae3618200b0" :answer/type :answer.type/math :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/ensure [:answer/validate]} {:db/id "q-72445/selection/5cf942e0722c5c5522d86e61435f23e163b1a12b6cf4114096537f3760194f99" :answer/id #uuid "618c0707-f0f5-54dc-a2bf-7a8903eeb9e9" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/ensure [:answer/validate]} {:db/id "q-72445/selection/1095d9070b85eccbc4e4ef2e8af3b18bf8766e188c1d741d1878f85a257f2a56" :answer/id #uuid "406671b6-b149-568b-a099-d67a86a99ef5" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/ensure [:answer/validate]} {:db/id "q-72445/selection/c340767827f25099b8ae066bbcadc8feda93b07567c312731b219df6120f60de" :answer/id #uuid "4de4d4b2-c211-5a24-8b67-7897d7cf3071" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/ensure [:answer/validate]} {:db/id "q-72445/selection/244b483bc3ef4fc721622f8359cdf887f53c97a32ad0b89429ed5d9d49bde90c" :answer/id #uuid "75329d55-9388-5b98-a041-2f2328c4ab5f" :answer/type :answer.type/math :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/ensure [:answer/validate]} {:db/id "q-72445/selection" :answer-field/id #uuid "881e5dfe-b8a5-5881-bde8-84d66ae2a827" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72445/selection/c340767827f25099b8ae066bbcadc8feda93b07567c312731b219df6120f60de" :answer-field/choices ["q-72445/selection/b37f2f579328f96387b66276ef772d9cf20c184b7b71f1e6e9d53b04581bdd8d" "q-72445/selection/5cf942e0722c5c5522d86e61435f23e163b1a12b6cf4114096537f3760194f99" "q-72445/selection/1095d9070b85eccbc4e4ef2e8af3b18bf8766e188c1d741d1878f85a257f2a56" "q-72445/selection/c340767827f25099b8ae066bbcadc8feda93b07567c312731b219df6120f60de" "q-72445/selection/244b483bc3ef4fc721622f8359cdf887f53c97a32ad0b89429ed5d9d49bde90c"] :db/ensure [:answer-field/validate]} {:db/id "q-72445" :question/id #uuid "db44b3e9-980b-5c78-b413-b34b20f0c732" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72445/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d"] :knowledge-point/questions ["q-72445"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72448/selection/00f2ae577fbfb9a92458ede619010aef4c4f93017d8f44572b298cb5d5caaf87" :answer/id #uuid "c2dd1b17-4e99-5111-af56-c5faae32efab" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/ensure [:answer/validate]} {:db/id "q-72448/selection/d85c50e0f14eefd3b20f9e508b8f7f2c5c8a3270a04cda593b66ec4d8015d764" :answer/id #uuid "240248e6-5be6-519a-aaa3-0eba2cfad4d2" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/ensure [:answer/validate]} {:db/id "q-72448/selection/a116d7742ed9e51e0362c49dc8e2289ad07cdb2f10f2b07c1a57ad8c812a7683" :answer/id #uuid "de5be837-8b4e-5832-9522-5488b5cb50e8" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡(K|(4x-5)(1-4x)|)" :db/ensure [:answer/validate]} {:db/id "q-72448/selection/f9255ea341e994b20be1bbe58482abe2b2b05a57afb2e6ef06762f72806e094f" :answer/id #uuid "95667f1a-8df4-5c16-9eb2-70d18048a2b0" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/ensure [:answer/validate]} {:db/id "q-72448/selection/c8f8171b3c039c3725d77367dabedc12f37dbf