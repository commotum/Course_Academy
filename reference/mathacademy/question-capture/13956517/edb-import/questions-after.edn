#{[{:db/id #edb/ref 17592186267389 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b19c3b-372f-5e2c-a21d-c0137bd3de2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡(K|2x+3|)" :db/id #edb/ref 17592186267391} {:answer/id #uuid "ed508d23-9cf2-587a-a345-c2c1c3eb9971" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|2x+3|)" :db/id #edb/ref 17592186267392} {:answer/id #uuid "dc97a120-fa31-5d36-9cbc-219c3b3ee8ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|)" :db/id #edb/ref 17592186267393} {:answer/id #uuid "7dcd43f5-90f8-5cf2-b91c-9db978047590" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{|2x+3|}{K})" :db/id #edb/ref 17592186267394} {:answer/id #uuid "e41b7475-5c74-51d9-a169-f36b31ab242b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{K}{2}\\operatorname{ln}⁡(|2x+3|)" :db/id #edb/ref 17592186267395}] :answer-field/correct {:answer/id #uuid "dc97a120-fa31-5d36-9cbc-219c3b3ee8ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|)" :db/id #edb/ref 17592186267393} :answer-field/id #uuid "5cf56cba-5ee6-55f4-9300-c6bb3106f1df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267390}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "88da6b06-825c-5185-a63b-2e45c9655fa3" :question/math-academy-id "q-113532" :question/problem "Calculate $\\int \\frac{1}{2x+3}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=2x+3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{2x+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+C & =\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡|2x+3|+\\operatorname{ln}⁡K) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{2x+3}\\,\\text{d}x=\\frac{1}{2}\\operatorname{ln}⁡(K|2x+3|).\n$$"}] [{:db/id #edb/ref 17592186267396 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f21cf9d6-1be8-5656-926b-69cec007f16c" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)" :db/id #edb/ref 17592186267398} {:answer/id #uuid "cc0ad17a-8205-52b2-b29e-b9b7d1717004" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(K|(1+5x)(1-5x)|)" :db/id #edb/ref 17592186267399} {:answer/id #uuid "45824ba1-c126-51d9-a7d9-b90e1ff74f4e" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)" :db/id #edb/ref 17592186267400} {:answer/id #uuid "7a164872-39a8-538e-869e-26db47d71a5e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)" :db/id #edb/ref 17592186267401} {:answer/id #uuid "7aa930c2-5e03-5ae7-a893-d5d7bb9fd6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)" :db/id #edb/ref 17592186267402}] :answer-field/correct {:answer/id #uuid "7aa930c2-5e03-5ae7-a893-d5d7bb9fd6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)" :db/id #edb/ref 17592186267402} :answer-field/id #uuid "30014f3f-ab97-5337-bf9f-6b66e368af18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267397}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8ec8edfd-26cb-55fe-a035-4092a8a78069" :question/math-academy-id "q-49522" :question/problem "Calculate $\\int (\\frac{1}{1+5x}+\\frac{1}{1-5x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{1+5x}+\\frac{1}{1-5x})\\,\\text{d}x & =\\int \\frac{1}{1+5x}\\,\\text{d}x+\\int \\frac{1}{1-5x}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|1+5x|-\\frac{1}{5}\\operatorname{ln}⁡|1-5x|+C \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡|\\frac{1+5x}{1-5x}|+\\frac{1}{5}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡(K|\\frac{1+5x}{1-5x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186267403 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406671b6-b149-568b-a099-d67a86a99ef5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267405} {:answer/id #uuid "75329d55-9388-5b98-a041-2f2328c4ab5f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267406} {:answer/id #uuid "618c0707-f0f5-54dc-a2bf-7a8903eeb9e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267407} {:answer/id #uuid "16ca95ec-320e-55ab-8295-8ae3618200b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267408} {:answer/id #uuid "4de4d4b2-c211-5a24-8b67-7897d7cf3071" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267409}] :answer-field/correct {:answer/id #uuid "4de4d4b2-c211-5a24-8b67-7897d7cf3071" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186267409} :answer-field/id #uuid "881e5dfe-b8a5-5881-bde8-84d66ae2a827" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267404}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "db44b3e9-980b-5c78-b413-b34b20f0c732" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$"}] [{:db/id #edb/ref 17592186267410 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2dd1b17-4e99-5111-af56-c5faae32efab" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/id #edb/ref 17592186267412} {:answer/id #uuid "de5be837-8b4e-5832-9522-5488b5cb50e8" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡(K|(4x-5)(1-4x)|)" :db/id #edb/ref 17592186267413} {:answer/id #uuid "210db7db-d498-5957-9b1e-c0601974294d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|(4x-5)(1-4x)|)" :db/id #edb/ref 17592186267414} {:answer/id #uuid "240248e6-5be6-519a-aaa3-0eba2cfad4d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/id #edb/ref 17592186267415} {:answer/id #uuid "95667f1a-8df4-5c16-9eb2-70d18048a2b0" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/id #edb/ref 17592186267416}] :answer-field/correct {:answer/id #uuid "240248e6-5be6-519a-aaa3-0eba2cfad4d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)" :db/id #edb/ref 17592186267415} :answer-field/id #uuid "80460c40-9ac7-5655-8ccc-139d13023e26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267411}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d174ca52-a351-5f94-a4de-eaefe96583ab" :question/math-academy-id "q-72448" :question/problem "Calculate $\\int (\\frac{1}{4x-5}+\\frac{1}{1-4x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{4x-5}+\\frac{1}{1-4x})\\,\\text{d}x & =\\int \\frac{1}{4x-5}\\,\\text{d}x+\\int \\frac{1}{1-4x}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡|4x-5|-\\frac{1}{4}\\operatorname{ln}⁡|1-4x|+C \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡|\\frac{4x-5}{1-4x}|+\\frac{1}{4}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{4x-5}{1-4x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186267417 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be282fc-f6ef-5f42-8363-a3d2aaeee3f2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186267419} {:answer/id #uuid "4bd162e4-8a01-535f-a29c-c5c2b9f5650d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186267420} {:answer/id #uuid "939e365e-a21c-5abe-afe9-479df4760051" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186267421} {:answer/id #uuid "79b848b9-93e3-5861-8908-01e49ec05ac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186267422} {:answer/id #uuid "5cea5505-e10a-5801-a59f-72b3458b2e96" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186267423}] :answer-field/correct {:answer/id #uuid "79b848b9-93e3-5861-8908-01e49ec05ac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186267422} :answer-field/id #uuid "26aacf4d-eded-5ced-92e0-4da16b55e6fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267418}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "10424ddf-9d5d-5bfc-9c80-d27d0ba4ff7c" :question/math-academy-id "q-72449" :question/problem "Calculate $\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x & =\\int \\frac{1}{2x+1}\\,\\text{d}x+\\int \\frac{1}{2x-1}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+1|+\\frac{1}{2}\\operatorname{ln}⁡|2x-1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|(2x+1)(2x-1)|+\\frac{1}{2}\\text{ }\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}]}
