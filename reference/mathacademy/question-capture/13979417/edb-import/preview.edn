34163 true] [17592186279751 1145 "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$" 13194139534163 true] [17592186279752 1000 #edb/ref 17592186279753 13194139534163 true] [17592186279752 1000 #edb/ref 17592186279754 13194139534163 true] [17592186279752 1000 #edb/ref 17592186279755 13194139534163 true] [17592186279752 1000 #edb/ref 17592186279756 13194139534163 true] [17592186279752 1000 #edb/ref 17592186279757 13194139534163 true] [17592186279752 1040 #edb/ref 17592186045450 13194139534163 true] [17592186279752 1041 "selection" 13194139534163 true] [17592186279752 1104 #edb/ref 17592186279753 13194139534163 true] [17592186279752 1110 #uuid "9f9c18ff-ecd5-5bbc-b0ea-962b9111ae44" 13194139534163 true] [17592186279753 1034 "t=0" 13194139534163 true] [17592186279753 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279753 1111 #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" 13194139534163 true] [17592186279754 1034 "t=9" 13194139534163 true] [17592186279754 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279754 1111 #uuid "65e2035c-7c48-5f63-ab3d-9359709749a0" 13194139534163 true] [17592186279755 1034 "k=\\pm 7" 13194139534163 true] [17592186279755 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279755 1111 #uuid "71b0eb63-47df-5ab2-95ff-bd6dc1b84ae1" 13194139534163 true] [17592186279756 1034 "t=4" 13194139534163 true] [17592186279756 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279756 1111 #uuid "7f736c4c-0089-59de-a3dc-c6938c5587b7" 13194139534163 true] [17592186279757 1034 "k=\\pm 10" 13194139534163 true] [17592186279757 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279757 1111 #uuid "04ee3fe8-3f9f-52df-8f7b-4eb7f210589f" 13194139534163 true] [17592186279758 1017 #edb/ref 17592186279759 13194139534163 true] [17592186279758 1089 "q-316785" 13194139534163 true] [17592186279758 1091 #edb/ref 17592186045463 13194139534163 true] [17592186279758 1100 "If $B=[\\begin{aligned}4 & -2 \\\\ 7x-3 & x+8\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" 13194139534163 true] [17592186279758 1113 #uuid "599e6518-7831-546e-ad61-22c40a2e7884" 13194139534163 true] [17592186279758 1145 "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (x+8)-(-2)\\cdot (7x-3) \\\\  & =4x+32+14x-6 \\\\  & =18x+26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}18x+26 & =0 \\\\ 18x & =-26 \\\\ x & =-\\frac{13}{9}\\end{aligned}\n$$" 13194139534163 true] [17592186279759 1000 #edb/ref 17592186279760 13194139534163 true] [17592186279759 1040 #edb/ref 17592186045449 13194139534163 true] [17592186279759 1041 "field-1" 13194139534163 true] [17592186279759 1104 #edb/ref 17592186279760 13194139534163 true] [17592186279759 1110 #uuid "483657b9-cb49-5829-89f3-68b01de7b58d" 13194139534163 true] [17592186279760 1034 "-\\frac{13}{9}" 13194139534163 true] [17592186279760 1103 #edb/ref 17592186045453 13194139534163 true] [17592186279760 1111 #uuid "923c2091-dc21-5866-8cac-137235680d94" 13194139534163 true] [17592186279761 1017 #edb/ref 17592186279762 13194139534163 true] [17592186279761 1089 "q-71934" 13194139534163 true] [17592186279761 1091 #edb/ref 17592186045463 13194139534163 true] [17592186279761 1100 "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" 13194139534163 true] [17592186279761 1113 #uuid "7d719636-2650-52a5-a453-2a2dc5859fac" 13194139534163 true] [17592186279761 1145 "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse." 13194139534163 true] [17592186279762 1000 #edb/ref 17592186279763 13194139534163 true] [17592186279762 1000 #edb/ref 17592186279764 13194139534163 true] [17592186279762 1000 #edb/ref 17592186279765 13194139534163 true] [17592186279762 1000 #edb/ref 17592186279766 13194139534163 true] [17592186279762 1000 #edb/ref 17592186279767 13194139534163 true] [17592186279762 1040 #edb/ref 17592186045450 13194139534163 true] [17592186279762 1041 "selection" 13194139534163 true] [17592186279762 1104 #edb/ref 17592186279766 13194139534163 true] [17592186279762 1110 #uuid "4147700b-537e-5ff3-ae62-abe8362e4d45" 13194139534163 true] [17592186279763 1034 "$T$ only" 13194139534163 true] [17592186279763 1103 #edb/ref 17592186045454 13194139534163 true] [17592186279763 1111 #uuid "3e828c40-5af3-5275-a151-b4a86d05ae24" 13194139534163 true] [17592186279764 1034 "$R$ and $T$ only" 13194139534163 true] [17592186279764 1103 #edb/ref 17592186045454 13194139534163 true] [17592186279764 1111 #uuid "26d9357a-fee8-58d9-81a4-e28e74153883" 13194139534163 true] [17592186279765 1034 "$S$ only" 13194139534163 true] [17592186279765 1103 #edb/ref 17592186045454 13194139534163 true] [17592186279765 1111 #uuid "0282c561-94e2-5116-ad0e-1161283efe30" 13194139534163 true] [17592186279766 1034 "$R$ and $S$ only" 13194139534163 true] [17592186279766 1103 #edb/ref 17592186045454 13194139534163 true] [17592186279766 1111 #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" 13194139534163 true] [17592186279767 1034 "$R$ only" 13194139534163 true] [17592186279767 1103 #edb/ref 17592186045454 1319413953