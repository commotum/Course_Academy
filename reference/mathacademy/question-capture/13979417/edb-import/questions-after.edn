#{[{:db/id #edb/ref 17592186279737 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42922570-2de3-53ca-b704-55aa639db9d9" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186279739} {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} {:answer/id #uuid "aec41eb0-803e-533d-b77f-d9c8ceaf2c5b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186279741} {:answer/id #uuid "cbc9bb08-60d3-50c8-b1cc-956c5c17465b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186279742} {:answer/id #uuid "bbd0ce3f-efa7-5d5c-94e0-4e9e72e19eeb" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186279743}] :answer-field/correct {:answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186279740} :answer-field/id #uuid "432ab73b-dcda-5589-8ece-932442e46212" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279738}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],\\,B=[\\begin{aligned}-3 & 15 \\\\ 1 & 5\\end{aligned}],\\,C=[\\begin{aligned}7 & 4 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse."}] [{:db/id #edb/ref 17592186279744 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2097893d-e27b-5088-a3ed-421ee6ec5219" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 9" :db/id #edb/ref 17592186279746} {:answer/id #uuid "4bb9e464-d410-579c-a428-3adccb6afec1" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 1" :db/id #edb/ref 17592186279747} {:answer/id #uuid "e96b7b63-cff0-5378-9fe7-e52fbda223db" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 3" :db/id #edb/ref 17592186279748} {:answer/id #uuid "978772b8-1a37-5242-bd09-f70b84e2b127" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 4" :db/id #edb/ref 17592186279749} {:answer/id #uuid "ba42abfe-2e26-5648-ab4d-f8da066222af" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186279750}] :answer-field/correct {:answer/id #uuid "2097893d-e27b-5088-a3ed-421ee6ec5219" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 9" :db/id #edb/ref 17592186279746} :answer-field/id #uuid "0f91f7a0-8e6d-5a77-96bb-4cb0d3b11fc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279745}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "68bc43d6-8520-513c-8b67-753d2e32cd33" :question/math-academy-id "q-127900" :question/problem "If $A=[\\begin{aligned}k & 3 \\\\ 27 & k\\end{aligned}]$ is a singular matrix, calculate the value(s) of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =k\\cdot k-27\\cdot 3 \\\\  & ={k}^{2}-81.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}{k}^{2}-81 & =0 \\\\ {k}^{2} & =81 \\\\ k & =\\pm 9\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=\\pm 9.$"}] [{:db/id #edb/ref 17592186279751 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} {:answer/id #uuid "65e2035c-7c48-5f63-ab3d-9359709749a0" :answer/type {:db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186279754} {:answer/id #uuid "71b0eb63-47df-5ab2-95ff-bd6dc1b84ae1" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186279755} {:answer/id #uuid "7f736c4c-0089-59de-a3dc-c6938c5587b7" :answer/type {:db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186279756} {:answer/id #uuid "04ee3fe8-3f9f-52df-8f7b-4eb7f210589f" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186279757}] :answer-field/correct {:answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186279753} :answer-field/id #uuid "9f9c18ff-ecd5-5bbc-b0ea-962b9111ae44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279752}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "acbeeb79-18dc-516f-93ba-82ddf3fe8247" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186279758 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "923c2091-dc21-5866-8cac-137235680d94" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{9}" :db/id #edb/ref 17592186279760}] :answer-field/correct {:answer/id #uuid "923c2091-dc21-5866-8cac-137235680d94" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{9}" :db/id #edb/ref 17592186279760} :answer-field/id #uuid "483657b9-cb49-5829-89f3-68b01de7b58d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279759}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "599e6518-7831-546e-ad61-22c40a2e7884" :question/math-academy-id "q-316785" :question/problem "If $B=[\\begin{aligned}4 & -2 \\\\ 7x-3 & x+8\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (x+8)-(-2)\\cdot (7x-3) \\\\  & =4x+32+14x-6 \\\\  & =18x+26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}18x+26 & =0 \\\\ 18x & =-26 \\\\ x & =-\\frac{13}{9}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279761 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e828c40-5af3-5275-a151-b4a86d05ae24" :answer/type {:db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186279763} {:answer/id #uuid "26d9357a-fee8-58d9-81a4-e28e74153883" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186279764} {:answer/id #uuid "0282c561-94e2-5116-ad0e-1161283efe30" :answer/type {:db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186279765} {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} {:answer/id #uuid "13f86d40-79de-5f73-af23-79138bb48962" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186279767}] :answer-field/correct {:answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186279766} :answer-field/id #uuid "4147700b-537e-5ff3-ae62-abe8362e4d45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279762}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7d719636-2650-52a5-a453-2a2dc5859fac" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."}]}
