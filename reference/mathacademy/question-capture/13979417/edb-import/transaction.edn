[{:db/id "q-71934/selection/5572e02e27f0cbc239ccd93fb0f30c843c05a3432e80728a1f2acd6bf56149c0" :answer/id #uuid "0282c561-94e2-5116-ad0e-1161283efe30" :answer/type :answer.type/text :answer/value "$S$ only" :db/ensure [:answer/validate]} {:db/id "q-71934/selection/7cb66002ef0e4e067fcef0990f7e6ba64bc71a98fe75cca083e387f3baef331d" :answer/id #uuid "b4e6ea5c-6625-58f7-bd40-7417279456c2" :answer/type :answer.type/text :answer/value "$R$ and $S$ only" :db/ensure [:answer/validate]} {:db/id "q-71934/selection/346d483309bfcd9732937fad9940baefc0c967995a6e2c531752eb4386e0f5c8" :answer/id #uuid "26d9357a-fee8-58d9-81a4-e28e74153883" :answer/type :answer.type/text :answer/value "$R$ and $T$ only" :db/ensure [:answer/validate]} {:db/id "q-71934/selection/27ead39b22315899a97d19d41807fad901038aea957324f0c89ba36f126544db" :answer/id #uuid "3e828c40-5af3-5275-a151-b4a86d05ae24" :answer/type :answer.type/text :answer/value "$T$ only" :db/ensure [:answer/validate]} {:db/id "q-71934/selection/820282211c30a20e021a66f68b7464203ed7fe571ec86a81ae83e0d42d754f2c" :answer/id #uuid "13f86d40-79de-5f73-af23-79138bb48962" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "q-71934/selection" :answer-field/id #uuid "4147700b-537e-5ff3-ae62-abe8362e4d45" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71934/selection/7cb66002ef0e4e067fcef0990f7e6ba64bc71a98fe75cca083e387f3baef331d" :answer-field/choices ["q-71934/selection/5572e02e27f0cbc239ccd93fb0f30c843c05a3432e80728a1f2acd6bf56149c0" "q-71934/selection/7cb66002ef0e4e067fcef0990f7e6ba64bc71a98fe75cca083e387f3baef331d" "q-71934/selection/346d483309bfcd9732937fad9940baefc0c967995a6e2c531752eb4386e0f5c8" "q-71934/selection/27ead39b22315899a97d19d41807fad901038aea957324f0c89ba36f126544db" "q-71934/selection/820282211c30a20e021a66f68b7464203ed7fe571ec86a81ae83e0d42d754f2c"] :db/ensure [:answer-field/validate]} {:db/id "q-71934" :question/id #uuid "7d719636-2650-52a5-a453-2a2dc5859fac" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71934/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381"] :knowledge-point/questions ["q-71934"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127826/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer/id #uuid "7cf08954-fd67-52e6-bd7a-76c18a37a27b" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "q-127826/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "bbd0ce3f-efa7-5d5c-94e0-4e9e72e19eeb" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "q-127826/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" :answer/id #uuid "aec41eb0-803e-533d-b77f-d9c8ceaf2c5b" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-127826/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" :answer/id #uuid "cbc9bb08-60d3-50c8-b1cc-956c5c17465b" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "q-127826/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "42922570-2de3-53ca-b704-55aa639db9d9" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-127826/selection" :answer-field/id #uuid "432ab73b-dcda-5589-8ece-932442e46212" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127826/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" :answer-field/choices ["q-127826/selection/685c02320dbe687345f93d820499dea4c0c82808b910e8a0e5841f77aa82209d" "q-127826/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" "q-127826/selection/9ed3305a02906a861616af6ff886306c4a2a74885d99f506419451b33c7c9d2d" "q-127826/selection/b967c3002b3f913c5b31990d1f8159d3e1e979aa07e2842a8b67bfff1a2fd3f2" "q-127826/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab"] :db/ensure [:answer-field/validate]} {:db/id "q-127826" :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],\\,B=[\\begin{aligned}-3 & 15 \\\\ 1 & 5\\end{aligned}],\\,C=[\\begin{aligned}7 & 4 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127826/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381"] :knowledge-point/questions ["q-127826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127900/selection/1a1a74d545560830901e63352d4f96e34e805fb646b9e73d2c1245da62d8e51a" :answer/id #uuid "2097893d-e27b-5088-a3ed-421ee6ec5219" :answer/type :answer.type/math :answer/value "k=\\pm 9" :db/ensure [:answer/validate]} {:db/id "q-127900/selection/5650a4035bb14480162eac9e090fe6f685e842243470102ef91c734d190dd50c" :answer/id #uuid "e96b7b63-cff0-5378-9fe7-e52fbda223db" :answer/type :answer.type/math :answer/value "k=\\pm 3" :db/ensure [:answer/validate]} {:db/id "q-127900/selection/2ea0db6fefa0e079120738ee013c8482358830b8375fea96496bb42c6a3030f6" :answer/id #uuid "4bb9e464-d410-579c-a428-3adccb6afec1" :answer/type :answer.type/math :answer/value "k=\\pm 1" :db/ensure [:answer/validate]} {:db/id "q-127900/selection/f9a36dc20554097250ff0324e179977bb892219ae9b27b5c2ca8864aac6c0450" :answer/id #uuid "ba42abfe-2e26-5648-ab4d-f8da066222af" :answer/type :answer.type/math :answer/value "k=0" :db/ensure [:answer/validate]} {:db/id "q-127900/selection/bee065134b3f461e8988f05cb918f116de1aaca2ac48b0e9ac854243e0042160" :answer/id #uuid "978772b8-1a37-5242-bd09-f70b84e2b127" :answer/type :answer.type/math :answer/value "k=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-127900/selection" :answer-field/id #uuid "0f91f7a0-8e6d-5a77-96bb-4cb0d3b11fc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127900/selection/1a1a74d545560830901e63352d4f96e34e805fb646b9e73d2c1245da62d8e51a" :answer-field/choices ["q-127900/selection/1a1a74d545560830901e63352d4f96e34e805fb646b9e73d2c1245da62d8e51a" "q-127900/selection/5650a4035bb14480162eac9e090fe6f685e842243470102ef91c734d190dd50c" "q-127900/selection/2ea0db6fefa0e079120738ee013c8482358830b8375fea96496bb42c6a3030f6" "q-127900/selection/f9a36dc20554097250ff0324e179977bb892219ae9b27b5c2ca8864aac6c0450" "q-127900/selection/bee065134b3f461e8988f05cb918f116de1aaca2ac48b0e9ac854243e0042160"] :db/ensure [:answer-field/validate]} {:db/id "q-127900" :question/id #uuid "68bc43d6-8520-513c-8b67-753d2e32cd33" :question/math-academy-id "q-127900" :question/problem "If $A=[\\begin{aligned}k & 3 \\\\ 27 & k\\end{aligned}]$ is a singular matrix, calculate the value(s) of $k.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =k\\cdot k-27\\cdot 3 \\\\  & ={k}^{2}-81.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}{k}^{2}-81 & =0 \\\\ {k}^{2} & =81 \\\\ k & =\\pm 9\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=\\pm 9.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127900/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-127900"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127903/selection/8b5a8474a9b9934bc051275be5cb046d57f79f1810a453d2a6924c7b768a1f5e" :answer/id #uuid "7f736c4c-0089-59de-a3dc-c6938c5587b7" :answer/type :answer.type/math :answer/value "t=4" :db/ensure [:answer/validate]} {:db/id "q-127903/selection/b7681799fad0648817111fd8c962b450926ed0b3e8065683d4baa5f31f5953f1" :answer/id #uuid "04ee3fe8-3f9f-52df-8f7b-4eb7f210589f" :answer/type :answer.type/math :answer/value "k=\\pm 10" :db/ensure [:answer/validate]} {:db/id "q-127903/selection/3c5e157e7f6663f1890b2b106ba57efe2f273c47b96853b2504b92d6602e697b" :answer/id #uuid "65e2035c-7c48-5f63-ab3d-9359709749a0" :answer/type :answer.type/math :answer/value "t=9" :db/ensure [:answer/validate]} {:db/id "q-127903/selection/4de22ed8a19ed1b508bdadba179c3d5a008d6e664f5a25941302c5fdf651d9c7" :answer/id #uuid "71b0eb63-47df-5ab2-95ff-bd6dc1b84ae1" :answer/type :answer.type/math :answer/value "k=\\pm 7" :db/ensure [:answer/validate]} {:db/id "q-127903/selection/2a7c1a99e9e23adaa901d3875aa3d18803784074d59c1f3334ed37864b04f786" :answer/id #uuid "73b09fe9-123a-5bd9-9a49-9c4bf0d7981e" :answer/type :answer.type/math :answer/value "t=0" :db/ensure [:answer/validate]} {:db/id "q-127903/selection" :answer-field/id #uuid "9f9c18ff-ecd5-5bbc-b0ea-962b9111ae44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127903/selection/2a7c1a99e9e23adaa901d3875aa3d18803784074d59c1f3334ed37864b04f786" :answer-field/choices ["q-127903/selection/8b5a8474a9b9934bc051275be5cb046d57f79f1810a453d2a6924c7b768a1f5e" "q-127903/selection/b7681799fad0648817111fd8c962b450926ed0b3e8065683d4baa5f31f5953f1" "q-127903/selection/3c5e157e7f6663f1890b2b106ba57efe2f273c47b96853b2504b92d6602e697b" "q-127903/selection/4de22ed8a19ed1b508bdadba179c3d5a008d6e664f5a25941302c5fdf651d9c7" "q-127903/selection/2a7c1a99e9e23adaa901d3875aa3d18803784074d59c1f3334ed37864b04f786"] :db/ensure [:answer-field/validate]} {:db/id "q-127903" :question/id #uuid "acbeeb79-18dc-516f-93ba-82ddf3fe8247" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127903/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-127903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316785/field-1/1560b83fb81ec56d33e778f9ce02369aa8cd8b2f5c4d35b04c7204ba513e0f76" :answer/id #uuid "923c2091-dc21-5866-8cac-137235680d94" :answer/type :answer.type/math :answer/value "-\\frac{13}{9}" :db/ensure [:answer/validate]} {:db/id "q-316785/field-1" :answer-field/id #uuid "483657b9-cb49-5829-89f3-68b01de7b58d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316785/field-1/1560b83fb81ec56d33e778f9ce02369aa8cd8b2f5c4d35b04c7204ba513e0f76" :answer-field/choices ["q-316785/field-1/1560b83fb81ec56d33e778f9ce02369aa8cd8b2f5c4d35b04c7204ba513e0f76"] :db/ensure [:answer-field/validate]} {:db/id "q-316785" :question/id #uuid "599e6518-7831-546e-ad61-22c40a2e7884" :question/math-academy-id "q-316785" :question/problem "If $B=[\\begin{aligned}4 & -2 \\\\ 7x-3 & x+8\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =4\\cdot (x+8)-(-2)\\cdot (7x-3) \\\\  & =4x+32+14x-6 \\\\  & =18x+26.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}18x+26 & =0 \\\\ 18x & =-26 \\\\ x & =-\\frac{13}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316785/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01"] :knowledge-point/questions ["q-316785"] :db/ensure [:knowledge-point/validate]}]
