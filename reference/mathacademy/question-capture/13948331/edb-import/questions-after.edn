rac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256377 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eed8df1-8720-5f2d-b940-647809fc6bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256379} {:answer/id #uuid "bb0cd2d5-cda8-505f-b806-6ad9951f145b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186256380} {:answer/id #uuid "51690a25-3f40-5bd1-bbb9-b60e21ebc510" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186256381} {:answer/id #uuid "54ad9bd9-cbdc-585c-943c-e7e7169b2628" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256382} {:answer/id #uuid "d80310c8-8911-5612-851c-8b8f568cb343" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186256383}] :answer-field/correct {:answer/id #uuid "bb0cd2d5-cda8-505f-b806-6ad9951f145b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186256380} :answer-field/id #uuid "0a0257ef-1450-5751-bb66-67b92021d549" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256378}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "04854523-8767-5a26-82dc-08686086cd8a" :question/math-academy-id "q-141381" :question/problem "$\\operatorname{cos}⁡(x+\\frac{3\\pi }{4})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{3\\pi }{4}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{4})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256384 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "731833d6-a975-5579-b520-e3da36e7da47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186256386} {:answer/id #uuid "a0fbc445-eb40-565c-a62f-97f894572ff9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256387} {:answer/id #uuid "0b2bb180-b077-566c-90ad-45547ce15f38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256388} {:answer/id #uuid "a1bc5dfd-3e9d-5944-9a46-f02199239f26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186256389} {:answer/id #uuid "34316314-f6d3-597b-a5f2-2ded862c73cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256390}] :answer-field/correct {:answer/id #uuid "a0fbc445-eb40-565c-a62f-97f894572ff9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186256387} :answer-field/id #uuid "115eb85a-c661-5df5-8657-b155114e81e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256385}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5fa489db-9798-5982-92be-7a838d125b75" :question/math-academy-id "q-141386" :question/problem "$\\operatorname{cos}⁡(x-\\frac{\\pi }{3})=$" :question/worked-solution "First, we recall  the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256391 :knowledge-point/_questions [{:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77b5b91f-540b-5385-adb7-3de782c31eaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256393} {:answer/id #uuid "80adb60f-82d5-553d-bbd5-dc52a44e554d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+2}{4}" :db/id #edb/ref 17592186256394} {:answer/id #uuid "a2e89894-60ab-5f09-a49c-4b69f4eec8fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186256395} {:answer/id #uuid "bee23330-73ff-565e-b064-e04fdf43cce3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-6}{2}" :db/id #edb/ref 17592186256396} {:answer/id #uuid "0f77a9d3-521f-5357-b45d-1002240c9d6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{2}" :db/id #edb/ref 17592186256397}] :answer-field/correct {:answer/id #uuid "a2e89894-60ab-5f09-a49c-4b69f4eec8fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186256395} :answer-field/id #uuid "80ac7aaa-fcc8-5f5b-bf2f-7e41ef0ae458" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256392}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "883a94e3-ff3c-509c-a7eb-72619b0d1237" :question/math-academy-id "q-1727" :question/problem "Find the exact value of $\\operatorname{cos}⁡(-{105}^{∘}).$\n\n*Hint: Use the fact that $-{105}^{∘}={45}^{∘}-{150}^{∘}.$*" :question/worked-solution "Recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for cosine with $x={45}^{∘}$ and $y={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-{105}^{∘}) & =\\operatorname{cos}⁡({45}^{∘}-{150}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘}\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡{45}^{∘}\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot (-\\frac{\\sqrt{3}}{2})+\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{-\\sqrt{6}+\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256398 :knowledge-point/_questions [{:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "599e10f9-ce4c-544c-b76b-d75bec6af0fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256400}] :answer-field/correct {:answer/id #uuid "599e10f9-ce4c-544c-b76b-d75bec6af0fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186256400} :answer-field/id #uuid "49c3d33d-e25f-597f-b069-8f6a3857ab20" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256399}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b49f2f99-e0d0-5a2d-b430-1a592dd1bf0a" :question/math-academy-id "q-274484" :question/problem "Using the fact that $-\\frac{11\\pi }{12}=\\frac{\\pi }{3}-\\frac{5\\pi }{4},$\ncalculate the **exact** value of $\\operatorname{cos}⁡(-\\frac{11\\pi }{12}).$\n\n$\\operatorname{cos}⁡(-\\frac{11\\pi }{12})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x=\\frac{\\pi }{3}$ and $y=\\frac{5\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-\\frac{11\\pi }{12}) & =\\operatorname{cos}⁡(\\frac{\\pi }{3}-\\frac{5\\pi }{4}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{cos}⁡(\\frac{5\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\  & =\\frac{1}{2}\\cdot (-\\frac{\\sqrt{2}}{2})+\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256401 :knowledge-point/_questions [{:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1fff6af-2be1-5922-bc16-62776f2e8fa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186256403}] :answer-field/correct {:answer/id #uuid "d1fff6af-2be1-5922-bc16-62776f2e8fa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186256403} :answer-field/id #uuid "80cc9f7c-7286-5b76-9de1-768436a9d074" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256402}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6df95506-f101-5b3e-9f39-6e0257a8d8c2" :question/math-academy-id "q-332499" :question/problem "Using the fact that $-{210}^{∘}={30}^{∘}-{240}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}⁡(-{210}^{∘}).$\n\n$\\operatorname{cos}⁡(-{210}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={30}^{∘}$ and $y={240}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-{210}^{∘}) & =\\operatorname{cos}⁡({30}^{∘}-{240}^{∘}) \\\\  & =\\operatorname{cos}⁡({30}^{∘})\\operatorname{cos}⁡({240}^{∘})+\\operatorname{sin}⁡({30}^{∘})\\operatorname{sin}⁡({240}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{1}{2})+\\frac{1}{2}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\sqrt{3}}{4}-\\frac{\\sqrt{3}}{4} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256404 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66f32c59-361c-5aca-b76a-0cd4c7daea2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256406}] :answer-field/correct {:answer/id #uuid "66f32c59-361c-5aca-b76a-0cd4c7daea2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256406} :answer-field/id #uuid "196f98b6-ce97-5e51-ad7a-ef6ed035e7ed" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256405} {:answer-field/choices [{:answer/id #uuid "3a5dcc16-b849-5840-85f6-64a554c7564c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256408}] :answer-field/correct {:answer/id #uuid "3a5dcc16-b849-5840-85f6-64a554c7564c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256408} :answer-field/id #uuid "fa498345-7ff9-5c80-8385-dba296d4ccda" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256407}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "500bcd2c-0a68-5a7b-8ba9-9e5667b759c5" :question/math-academy-id "q-332505" :question/problem "Express $\\operatorname{cos}⁡(x+{225}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+{225}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,-$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={225}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{225}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{225}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{225}^{∘} \\\\  & =\\operatorname{cos}⁡x(-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256409 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0202b596-a615-52f8-a1d8-543133ff773c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256411}] :answer-field/correct {:answer/id #uuid "0202b596-a615-52f8-a1d8-543133ff773c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256411} :answer-field/id #uuid "8ff1eb11-3d87-5bce-a113-73c70a906759" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256410} {:answer-field/choices [{:answer/id #uuid "466dbf97-94b9-57f1-83bc-94a082fdf5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256413}] :answer-field/correct {:answer/id #uuid "466dbf97-94b9-57f1-83bc-94a082fdf5bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256413} :answer-field/id #uuid "d1712556-bbb6-5103-b546-f27e8a2c5b78" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256412}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee8fb7bd-44a1-528f-a777-12e81df76a3e" :question/math-academy-id "q-332508" :question/problem "Express $\\operatorname{cos}⁡(x+{315}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+{315}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={315}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{315}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{315}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{315}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{2}}{2}-\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256414 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f72cd5-ebc9-5e11-a668-44e594138b5f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256416}] :answer-field/correct {:answer/id #uuid "26f72cd5-ebc9-5e11-a668-44e594138b5f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256416} :answer-field/id #uuid "c7fa0364-c704-5fbb-aaf1-b5b1eb6a470c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256415} {:answer-field/choices [{:answer/id #uuid "775fed43-0d1f-58af-ac98-e136c8430e4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256418}] :answer-field/correct {:answer/id #uuid "775fed43-0d1f-58af-ac98-e136c8430e4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256418} :answer-field/id #uuid "0e4ee1dd-ffd5-5243-ae6a-2606017aa72b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256417}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d38168a9-8906-567e-8792-cdf787abc219" :question/math-academy-id "q-332516" :question/problem "Express $\\operatorname{cos}⁡(x-{315}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-{315}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={315}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{315}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{315}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{315}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{2}}{2}+\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256419 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43746484-8a35-5599-8e19-c6bd957bede2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186256421}] :answer-field/correct {:answer/id #uuid "43746484-8a35-5599-8e19-c6bd957bede2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 1