gned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332526/field-1" "q-332526/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-332526"] :db/ensure [:knowledge-point/validate]}]
