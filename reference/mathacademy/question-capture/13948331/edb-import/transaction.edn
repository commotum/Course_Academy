f1bb063092a0"] :db/ensure [:answer-field/validate]} {:db/id "q-141360" :question/id #uuid "545f61c1-c114-5ca2-a4bd-862a953a500b" :question/math-academy-id "q-141360" :question/problem "Find the exact value of $\\operatorname{cos}⁡(-\\frac{\\pi }{12}).$\n\n*Hint: Use the fact that $-\\frac{\\pi }{12}=\\frac{\\pi }{4}-\\frac{\\pi }{3}.$*" :question/worked-solution "Recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the difference formula for cosine with $x=\\frac{\\pi }{4}$ and $y=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-\\frac{\\pi }{12}) & =\\operatorname{cos}⁡(\\frac{\\pi }{4}-\\frac{\\pi }{3}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2}+\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141360/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85"] :knowledge-point/questions ["q-141360"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1727/selection/3f6367fc299fb5367595380ccbf6a0d4e9a14f20bc38da6b4cf6ec31dc1d70a0" :answer/id #uuid "bee23330-73ff-565e-b064-e04fdf43cce3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}-6}{2}" :db/ensure [:answer/validate]} {:db/id "q-1727/selection/15e9061aa00ad853716397cbd9cd2fdd8070cfac1c90e5ac328f51e9c7876edb" :answer/id #uuid "77b5b91f-540b-5385-adb7-3de782c31eaa" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-1727/selection/23f5a56fac51b39fe25a18aa6ed058e2bca5fd95745689081fc23d4070e49a59" :answer/id #uuid "a2e89894-60ab-5f09-a49c