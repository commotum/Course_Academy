361d8455a2557f82bb7ee" :answer/id #uuid "599e10f9-ce4c-544c-b76b-d75bec6af0fc" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-274484/field-1" :answer-field/id #uuid "49c3d33d-e25f-597f-b069-8f6a3857ab20" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274484/field-1/38be064f9f77171be9ddc874138e7b6cfa7976ad8e6361d8455a2557f82bb7ee" :answer-field/choices ["q-274484/field-1/38be064f9f77171be9ddc874138e7b6cfa7976ad8e6361d8455a2557f82bb7ee"] :db/ensure [:answer-field/validate]} {:db/id "q-274484" :question/id #uuid "b49f2f99-e0d0-5a2d-b430-1a592dd1bf0a" :question/math-academy-id "q-274484" :question/problem "Using the fact that $-\\frac{11\\pi }{12}=\\frac{\\pi }{3}-\\frac{5\\pi }{4},$\ncalculate the **exact** value of $\\operatorname{cos}⁡(-\\frac{11\\pi }{12}).$\n\n$\\operatorname{cos}⁡(-\\frac{11\\pi }{12})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x=\\frac{\\pi }{3}$ and $y=\\frac{5\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-\\frac{11\\pi }{12}) & =\\operatorname{cos}⁡(\\frac{\\pi }{3}-\\frac{5\\pi }{4}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{cos}⁡(\\frac{5\\pi }{4})+\\operatorname{sin}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\  & =\\frac{1}{2}\\cdot (-\\frac{\\sqrt{2}}{2})+\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274484/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85"] :knowledge-point/questions ["q-274484"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332505/field-1/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "66f32c59-361c-5aca-b76a-0cd4c7daea2b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332505/field-1" :answer-field/id #uuid "196f98b6-ce97-5e51-ad7a-ef6ed035e7ed" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332505/field-1/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer-field/choices ["q-332505/field-1/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9"] :db/ensure [:answer-field/validate]} {:db/id "q-332505/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "3a5dcc16-b849-5840-85f6-64a554c7564c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332505/field-2" :answer-field/id #uuid "fa498345-7ff9-5c80-8385-dba296d4ccda" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332505/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer-field/choices ["q-332505/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9"] :db/ensure [:answer-field/validate]} {:db/id "q-332505" :question/id #uuid "500bcd2c-0a68-5a7b-8ba9-9e5667b759c5" :question/math-academy-id "q-332505" :question/problem "Express $\\operatorname{cos}⁡(x+{225}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+{225}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,-$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={225}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{225}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{225}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{225}^{∘} \\\\  & =\\operatorname{cos}⁡x(-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x(-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x-\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332505/field-1" "q-332505/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-332505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119482/selection/a052b8e158eadd0009859dc2d86a92f7eb71f343c5fd1a64859952d95181e217" :answer/id #uuid "69dba4d0-0e08-5c54-a838-6916ad595074" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-119482/selection/c1891e8d9bc04e72a85dc00414581be24697cb313ab0046a2a4ab2a72480dd45" :answer/id #uuid "4802329c-97d3-58b0-92fb-16c383bc8e50" :answer/type :answer.type/math :answer/value "\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119482/selection/e5a0d9661018c85207ed28d9d07957f14119513a9b55a42757b9c6907d796b1d" :answer/id #uuid "32da348e-790a-5334-8bdf-03d780af6158" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-119482/selection/9b9441bd8ca17246b54874e49f7ad4f0b5918065d0b673a0e2e330a7f17cdb2e" :answer/id #uuid "3043578b-6548-5304-b79b-1ba5a0116001" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-119482/selection/5cf55c041245f5ba1f37cc50c5d94833146dc3899116eaa0043611fc5cb399c2" :answer/id #uuid "b677d3c4-e2ba-5a7f-aa4c-a85c0d6ad4b2" :answer/type :answer.ty