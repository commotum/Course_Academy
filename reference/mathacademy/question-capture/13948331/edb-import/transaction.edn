∘}-{150}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘}\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡{45}^{∘}\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot (-\\frac{\\sqrt{3}}{2})+\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\  & =\\frac{-\\sqrt{6}+\\sqrt{2}}{4} \\\\  & =\\frac{\\sqrt{2}-\\sqrt{6}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-1727/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85"] :knowledge-point/questions ["q-1727"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332499/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "d1fff6af-2be1-5922-bc16-62776f2e8fa7" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332499/field-1" :answer-field/id #uuid "80cc9f7c-7286-5b76-9de1-768436a9d074" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332499/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer-field/choices ["q-332499/field-1/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744"] :db/ensure [:answer-field/validate]} {:db/id "q-332499" :question/id #uuid "6df95506-f101-5b3e-9f39-6e0257a8d8c2" :question/math-academy-id "q-332499" :question/problem "Using the fact that $-{210}^{∘}={30}^{∘}-{240}^{∘},$\ncalculate the **exact** value of $\\operatorname{cos}⁡(-{210}^{∘}).$\n\n$\\operatorname{cos}⁡(-{210}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x-y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={30}^{∘}$ and $y={240}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(-{210}^{∘}) & =\\operatorname{cos}⁡({30}^{∘}-{240}^{∘}) \\\\  & =\\operatorname{cos}⁡({30}^{∘})\\operatorname{cos}⁡({240}^{∘})+\\operatorname{sin}⁡({30}^{∘})\\operatorname{sin}⁡({240}^{∘}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot (-\\frac{1}{2})+\\frac{1}{2}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\sqrt{3}}{4}-\\frac{\\sqrt{3}}{4} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332499/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85"] :knowledge-point/questions ["q-332499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119479/selection/94e91399ff5f195018eccc1de7f5c4fc4394006eaece2522546b4536b610457d" :answer/id #uuid "d9c2dc06-5cdb-51b6-b96f-4e13af65fa1a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}-\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119479/selection/23f5a56fac51b39fe25a18aa6ed058e2bca5fd95745689081fc23d4070e49a59" :answer/id #uuid "f5a50aa1-263e-5cb1-aeea-9c6a0ad51b82" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119479/selection/38be064f9f77171be9ddc874138e7b6cfa7976ad8e6361d8455a2557f82bb7ee" :answer/id #uuid "3df53452-210c-5aa3-bc09-733aabec648d" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119479/selection/6aa9f2d2cfa11773cb871caaf7f7dc40a77dd322c0bb39704080f560da8cff27" :answer/id #uuid "2a0b6e72-b3b1-5ba7-a8b3-5358a0fb52f0" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}+\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119479/selection/15e9061aa00ad853716397cbd9cd2fdd8070cfac1c90e5ac328f51e9c7876edb" :answer/id #uuid "9e9b4c7e-2c5a-5970-bc30-fba6be72da6c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/ensure [:answer/validate]} {:db/id "q-119479/selection" :answer-field/id #uuid "3661e593-362f-552c-80aa-