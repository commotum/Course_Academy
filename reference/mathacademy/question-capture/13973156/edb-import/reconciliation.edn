d-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/state.json" "file_sha256" "9a63c36db3fe086c0aeb460a1385588ae791834d3f29d78f1e533cdbef8a7a18"} {"question" "q-327851" "field" nil "attribute" "question/worked-solution" "value" "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $\\sqrt{4t}+1\\ge 1$ for all $t\\ge 0.$ Consequently, the range of $x$ is\n\n$$\nx\\ge 1.\n$$\n\n- To find the range of $y,$ note that $\\sqrt{t}+2\\ge 2$ for all $t\\ge 0.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/state.json" "file_sha256" "9a63c36db3fe086c0aeb460a1385588ae791834d3f29d78f1e533cdbef8a7a18"} {"question" "q-327851" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/activity-metadata.json" "file_sha256" "b831a1b72106ea95d4e79ccbaf8f78b64c9b28342b22f65be5511b4eb3a1a38d"} {"question" "q-327851" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/state.json" "file_sha256" "9a63c36db3fe086c0aeb460a1385588ae791834d3f29d78f1e533cdbef8a7a18"} {"question" "q-327851" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\ge"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/state.json" "file_sha256" "9a63c36db3fe086c0aeb460a1385588ae791834d3f29d78f1e533cdbef8a7a18"} {"question" "q-327851" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_