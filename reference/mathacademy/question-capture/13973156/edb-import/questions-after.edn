#{[{:db/id #edb/ref 17592186275658 :knowledge-point/_questions [{:knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efe3651-520d-5470-bd30-82285ca8df52" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\le x\\le 0,\\,-3\\le y\\le -1" :db/id #edb/ref 17592186275660} {:answer/id #uuid "4225080f-f339-5b6d-9f17-95c386185b32" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x\\le 1,\\,1\\le y\\le 3" :db/id #edb/ref 17592186275661} {:answer/id #uuid "236ce462-6b1e-594b-9a2b-c48888cc132d" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x\\le 1,\\,-3\\le y\\le -1" :db/id #edb/ref 17592186275662} {:answer/id #uuid "85dd432d-2b85-50fa-a03c-e3549ff229b3" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,-2\\le y\\le 2" :db/id #edb/ref 17592186275663} {:answer/id #uuid "5986db54-acb9-514a-af17-5e48d8a6f92e" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,1\\le y\\le 3" :db/id #edb/ref 17592186275664}] :answer-field/correct {:answer/id #uuid "5986db54-acb9-514a-af17-5e48d8a6f92e" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,1\\le y\\le 3" :db/id #edb/ref 17592186275664} :answer-field/id #uuid "a4ee01a6-098b-5d46-91df-c9131ccd83f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275659}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "42535d46-cb00-5afc-82ab-e62c0ea06521" :question/math-academy-id "q-123773" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ 1 & \\text{ }\\ge -\\operatorname{cos}⁡\\theta \\text{ }\\ge -1 \\\\ -1 & \\le -\\operatorname{cos}⁡\\theta \\le 1 \\\\ 1-1 & \\le 1-\\operatorname{cos}⁡\\theta \\le 1+1 \\\\ 0 & \\le x\\le 2.\\end{aligned}\n$$\n\nSo, we can conclude that $0\\le x\\le 2.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1+2 & \\le \\operatorname{sin}⁡\\theta +2\\le 1+2 \\\\ 1 & \\le y\\le 3.\\end{aligned}\n$$\n\nSo, we can conclude that $1\\le y\\le 3.$\n\nTherefore, the ranges are $0\\le x\\le 2$ and $1\\le y\\le 3.$"}] [{:db/id #edb/ref 17592186275665 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e41b6bf4-607a-5d66-aa75-2020429244be" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/assets/d4843922097889cdaab70fef53186ebb1066a880226d45c1e088205a7b9d264a.png" :db/id #edb/ref 17592186275667} {:answer/id #uuid "a13ee62f-392a-56df-bc13-4ad4126b4c80" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/assets/1d74a9400fa933f02f8a13536342c27fb6f39d04d55c5c6a25633265e3284f97.png" :db/id #edb/ref 17592186275668} {:answer/id #uuid "2657164e-431f-5472-a1ab-e51225b997f4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13973156/assets