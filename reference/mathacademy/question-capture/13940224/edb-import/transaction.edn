} {:db/id "q-66667" :question/id #uuid "602f7422-ebb4-54e2-af4d-0eceba33a911" :question/math-academy-id "q-66667" :question/is-example false :question/problem "If $\\operatorname{csc}⁡x=\\sqrt{2},$ then what is $5\\operatorname{csc}⁡(x+10\\pi )-1?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 5\\cdot \\pi )=\\operatorname{csc}⁡(x+10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=\\sqrt{2},$ then $\\operatorname{csc}⁡(x+10\\pi )=\\sqrt{2}.$\n\nFinally, then\n\n$$\n5\\operatorname{csc}⁡(x+10\\pi )-1=5\\sqrt{2}-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66667/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37434c3e-2269-5b08-94c5-7516df7879b2"] :knowledge-point/questions ["q-66667"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66605/selection/53b39014ac4431c8f4984a09e676faddb9a02c5d4b1e112d857ba6fbf1e740eb" :answer/id #uuid "76d49221-e9d1-5cb9-98a3-f6a54547313f" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}+\\pi " :db/ensure [:answer/validate]} {:db/id "q-66605/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "de4ac27f-0fed-5de9-a878-bc7928150233" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-66605/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e9ea8d4e-9d91-5678-bd26-0a23821d4a1f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-66605/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "66feec1b-fea7-5ad1-aee0-015c82d19d1d" :answer/type :answer.type/math :