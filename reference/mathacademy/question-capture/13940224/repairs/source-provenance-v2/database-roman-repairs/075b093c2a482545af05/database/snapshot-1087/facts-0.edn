#{[17592186045463 #edb/ref 10 :activity.type/lesson #edb/ref 17592186045416] [17592186045487 #edb/ref 10 :question.difficulty/moderate #edb/ref 17592186045416] [17592186045493 #edb/ref 10 :answer-field.type/radio #edb/ref 17592186045416] [17592186045499 #edb/ref 10 :answer.type/text #edb/ref 17592186045416] [17592186048666 #edb/ref 1027 #edb/ref 17592186048941 #edb/ref 17592186045417] [17592186048666 #edb/ref 1027 #edb/ref 17592186049056 #edb/ref 17592186045417] [17592186048666 #edb/ref 1027 #edb/ref 17592186049936 #edb/ref 17592186045417] [17592186048666 #edb/ref 1027 #edb/ref 17592186050035 #edb/ref 17592186045417] [17592186048666 #edb/ref 1028 #edb/ref 17592186100819 #edb/ref 17592186045417] [17592186048666 #edb/ref 1028 #edb/ref 17592186100820 #edb/ref 17592186045417] [17592186048666 #edb/ref 1028 #edb/ref 17592186100821 #edb/ref 17592186045417] [17592186048666 #edb/ref 1028 #edb/ref 17592186100822 #edb/ref 17592186045417] [17592186048666 #edb/ref 1031 "General Solutions of Elementary Trigonometric Equations" #edb/ref 17592186045417] [17592186048666 #edb/ref 1033 1258 #edb/ref 17592186045417] [17592186048666 #edb/ref 1035 #uuid "b35faa98-a789-50da-a860-eef410538855" #edb/ref 17592186045417] [17592186049075 #edb/ref 1027 #edb/ref 17592186048487 #edb/ref 17592186045417] [17592186049075 #edb/ref 1027 #edb/ref 17592186048533 #edb/ref 17592186045417] [17592186049075 #edb/ref 1027 #edb/ref 17592186049220 #edb/ref 17592186045417] [17592186049075 #edb/ref 1027 #edb/ref 17592186049991 #edb/ref 17592186045417] [17592186049075 #edb/ref 1027 #edb/ref 17592186050359 #edb/ref 17592186045417] [17592186049075 #edb/ref 1028 #edb/ref 17592186115169 #edb/ref 17592186045417] [17592186049075 #edb/ref 1028 #edb/ref 17592186115170 #edb/ref 17592186045417] [17592186049075 #edb/ref 1028 #edb/ref 17592186115171 #edb/ref 17592186045417] [17592186049075 #edb/ref 1028 #edb/ref 17592186115172 #edb/ref 17592186045417] [17592186049075 #edb/ref 1031 "Graphing Secant and Cosecant" #edb/ref 17592