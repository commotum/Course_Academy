#{[{:db/id #edb/ref 17592186366677 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afcd0c4a-83d2-5752-ae51-e865413f5934" :answer/type {:db/ident :answer.type/math} :answer/value "{r},{t}" :db/id #edb/ref 17592186366679} {:answer/id #uuid "cec42cfe-6eae-589b-a99f-3ef70776533b" :answer/type {:db/ident :answer.type/math} :answer/value "∅,{r,t}" :db/id #edb/ref 17592186366680} {:answer/id #uuid "376440eb-7d5f-5251-a663-e5d5a4ce50cc" :answer/type {:db/ident :answer.type/math} :answer/value "{r},{t},{r,t}" :db/id #edb/ref 17592186366681} {:answer/id #uuid "94674723-4ab3-52de-85dc-511572ad4dde" :answer/type {:db/ident :answer.type/math} :answer/value "∅,{r},{t},{r,t}" :db/id #edb/ref 17592186366682} {:answer/id #uuid "03112bdb-2e89-56ab-beef-902da9572cb6" :answer/type {:db/ident :answer.type/math} :answer/value "{r,t}" :db/id #edb/ref 17592186366683}] :answer-field/correct {:answer/id #uuid "94674723-4ab3-52de-85dc-511572ad4dde" :answer/type {:db/ident :answer.type/math} :answer/value "∅,{r},{t},{r,t}" :db/id #edb/ref 17592186366682} :answer-field/id #uuid "b48d7cc0-deda-54c4-a5a3-ddc79936f9e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366678}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "17cce24b-1209-590f-8569-68896def4649" :question/math-academy-id "q-104924" :question/problem "Find all of the subsets of $S={r,t}.$" :question/worked-solution "To find every subset of $S,$ we list out every combination of elements within $S.$\n\nWe can use the following diagram to visualize the process:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/assets/022399e6a7a5e1f79b58e856aa8e9e5e9f3561e8e4bcb5b80a95237d30d06002.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{r},{t},{r,t}.\n$$"}] [{:db/id #edb/ref 17592186366684 :knowledge-point/_questions [{:knowledge-point/id #uuid "495f3da0-849a-589d-ac88-26d6825445e4" :knowledge-point/title "Identifying True Statements About Subsets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2e22a02-b744-5948-8be1-8718ed9ade7d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186366686} {:answer/id #uuid "58576262-6947-542b-ae10-b68d549cff64" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186366687} {:answer/id #uuid "5f21bb08-5a57-58bd-954b-dd9682883434" :answer/type {:db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186366688} {:answer/id #uuid "172622cd-f422-5c25-9ce1-1c3c4507c66c" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186366689} {:answer/id #uuid "36c89114-7b26-5ecd-825e-c7d06dd1d63b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186366690}] :answer-field/correct {:answer/id #uuid "58576262-6947-542b-ae10-b68d549cff64" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186366687} :answer-field/id #uuid "03816318-2156-51fb-a9d6-f71971bcf414" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366685}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6d87f299-b49e-50b2-9b8e-197c261ee00f" :question/math-academy-id "q-105065" :question/problem "Which of the following statements are true for the sets $A={x\\in Z∣x\\le 5}$ and $B={x\\in Z∣-7\\le x<3}?$\n\n- $A⊆B$\n- $B⊆A$\n- $B⊈A$\n- $A⊇B$" :question/worked-solution "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $x\\le 5.$ So, we have\n\n$$\nA={…,-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $-7\\le x<3.$ So, we have\n\n$$\nB={-7,-6,-5,-4,-3,-2,-1,0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false.  For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II and IV only\"."}] [{:db/id #edb/ref 17592186366691 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4bea7f3-823b-5a2e-b495-47442814f85c" :answer/type {:db/ident :answer.type/math} :answer/value "Z⊆Z" :db/id #edb/ref 17592186366693} {:answer/id #uuid "d9920768-e99e-5c22-8b0c-0bfd7108317e" :answer/type {:db/ident :answer.type/math} :answer/value "{Z}^{+}⊆Z" :db/id #edb/ref 17592186366694} {:answer/id #uuid "0478eeb5-74b2-5ac3-977d-4d9b667a50dd" :answer/type {:db/ident :answer.type/math} :answer/value "{Z}^{-}⊆Z" :db/id #edb/ref 17592186366695} {:answer/id #uuid "1db94549-6799-5eaa-927f-0f288543862b" :answer/type {:db/ident :answer.type/math} :answer/value "N⊆Z" :db/id #edb/ref 17592186366696} {:answer/id #uuid "1599f606-1325-5108-8444-b3d33f666c2d" :answer/type {:db/ident :answer.type/math} :answer/value "Z⊆{Z}^{+}" :db/id #edb/ref 17592186366697}] :answer-field/correct {:answer/id #uuid "1599f606-1325-5108-8444-b3d33f666c2d" :answer/type {:db/ident :answer.type/math} :answer/value "Z⊆{Z}^{+}" :db/id #edb/ref 17592186366697} :answer-field/id #uuid "ebdd904d-b3f1-598e-b1b2-5fd708840195" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366692}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "274e241e-a0c2-5612-a090-edf98e09aacd" :question/math-academy-id "q-1209" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $Z⊆{Z}^{+}$ is not true. This statement is not true because not every integer is a positive integer. For example, we have $-1\\in Z$ but $-1\\notin {Z}^{+}.$"}]}
