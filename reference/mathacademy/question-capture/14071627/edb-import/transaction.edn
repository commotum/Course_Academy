dd4a5743310d6fd1905d4edda48f257684"] :db/ensure [:answer-field/validate]} {:db/id "q-1191" :question/id #uuid "407d7cc7-5026-5701-afb9-deb48319160f" :question/math-academy-id "q-1191" :question/problem "Find all of the subsets of $A={x,y,z}.$" :question/worked-solution "To find every subset of $A,$ we list out every combination of elements within $A.$\n\nWe can use the following diagram to visualize the process:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/assets/1d7c11586a8fff5f63d46d936fd32c7b5fbfc33a406ddf268bfdd934fe787cdf.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{x},{y},{z},{x,y},{x,z},{y,z},{x,y,z}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-1191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb"] :knowledge-point/questions ["q-1191"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80808/selection/892806bd00832c0811af2b01d31ffc9ba0f79ed61a2eaf38018d6c6edca0999f" :answer/id #uuid "afb75e09-e921-54a9-af65-9ef5cd5a4ed9" :answer/type :answer.type/math :answer/value "∅,{\\alpha },{\\beta },{\\gamma },{\\alpha ,\\beta },{\\alpha ,\\gamma },{\\beta ,\\gamma },{\\alpha ,\\beta ,\\gamma }" :db/ensure [:answer/validate]} {:db/id "q-80808/selection/b628279c2e97385c783772e9d813fc9260c467dae31ba37b515eaacf2fe210df" :answer/id #uuid "fd9e6ac1-fb02-5635-b9e3-f830328c8485" :answer/type :answer.type/math :answer/value "{\\alpha },{\\beta },{\\gamma }" :db/ensure [:answer/validate]} {:db/id "q-80808/selection/3736147367b13ed4b1bf386b884a3647865c499a7c26ad383757ca56e9849c7b" :answer/id #uuid "ec1654b3-07f9-5637-97a4-44aea15f402a" :answer/type :answer.type/math :answer/value "∅,{\\alpha },{\\beta },{\\gamma }" :db/ensure [:answer/validate]} {:db/id "q-80808/selection/f0fdd5b556e36fa414b04e1eda6b01c327ebddfa471e31321f88b7d7c0547bde" :answer/id #uuid "