74c39e6f7" 13194139535885 true] [17592186372562 1034 "Q⊆R" 13194139535885 true] [17592186372562 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372562 1111 #uuid "07e403f2-50ae-5018-9532-20b87d3ce2a4" 13194139535885 true] [17592186372563 1034 "{Z}^{+}⊆Z" 13194139535885 true] [17592186372563 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372563 1111 #uuid "111a0775-0e63-5119-9c08-061621c5a088" 13194139535885 true] [17592186372564 1034 "Z⊆R" 13194139535885 true] [17592186372564 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372564 1111 #uuid "e97d5216-d55b-51c2-bf5a-fbe432e1a433" 13194139535885 true] [17592186372565 1034 "C⊆Z" 13194139535885 true] [17592186372565 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372565 1111 #uuid "de302136-7644-5210-8f01-fd136225d27c" 13194139535885 true] [17592186372566 1017 #edb/ref 17592186372567 13194139535885 true] [17592186372566 1089 "q-1212" 13194139535885 true] [17592186372566 1091 #edb/ref 17592186045463 13194139535885 true] [17592186372566 1100 "Which of the following statements are true for the sets $A={x\\in N∣-1\\le x+1\\le 3}$ and $B={x\\in Z∣{x}^{2}\\le -2}?$\n\n- $A⊆B$\n- $A⊈B$\n- $B⊆A$\n- $A⊇B$" 13194139535885 true] [17592186372566 1113 #uuid "e4922535-c18b-5ded-bfaa-a163a44445c9" 13194139535885 true] [17592186372566 1145 "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $-1\\le x+1\\le 3,$ that is to say, $-2\\le x\\le 2.$ So, we have\n\n$$\nA={1,2}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality ${x}^{2}\\le -2.$ So, we have\n\n$$\nB=∅.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $0\\in A$ but $0\\notin B.$\n\n- $B⊆A$ is true. The empty set is a subset of every set.\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II, III, and IV only.\"" 13194139535885 true] [17592186372567 1000 #edb/ref 17592186372568 13194139535885 true] [17592186372567 1000 #edb/ref 17592186372569 13194139535885 true] [17592186372567 1000 #edb/ref 17592186372570 13194139535885 true] [17592186372567 1000 #edb/ref 17592186372571 13194139535885 true] [17592186372567 1000 #edb/ref 17592186372572 13194139535885 true] [17592186372567 1040 #edb/ref 17592186045450 13194139535885 true] [17592186372567 1041 "selection" 13194139535885 true] [17592186372567 1104 #edb/ref 17592186372572 13194139535885 true] [17592186372567 1110 #uuid "c5cd6c9e-f9af-52c6-b07a-250d38363d9a" 13194139535885 true] [17592186372568 1034 "I and IV only" 13194139535885 true] [17592186372568 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372568 1111 #uuid "2346196b-3122-5e48-bad9-803abaca2c14" 13194139535885 true] [17592186372569 1034 "I and III only" 13194139535885 true] [17592186372569 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372569 1111 #uuid "db3dca2c-cc00-5fac-9ef0-b9e22ae6f708" 13194139535885 true] [17592186372570 1034 "I, III, and IV only" 13194139535885 true] [17592186372570 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372570 1111 #uuid "adfccc75-c1ca-5044-9513-ea6e9a4769eb" 13194139535885 true] [17592186372571 1034 "III and IV only" 13194139535885 true] [17592186372571 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372571 1111 #uuid "b5db533c-a1e2-51fa-9364-58492fcba2d2" 13194139535885 true] [17592186372572 1034 "II, III, and IV only" 13194139535885 true] [17592186372572 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372572 1111 #uuid "ecd6fd09-b6ed-59ce-a4b8-ffcb5d35b050" 13194139535885 true] [17592186372573 1017 #edb/ref 17592186372574 13194139535885 true] [17592186372573 1089 "q-37264" 13194139535885 true] [17592186372573 1091 #edb/ref 17592186045465 13194139535885 true] [17592186372573 1100 "Which of the following sets is a subset of $A={4n+1∣n\\in {0,1,2,3}}?$" 13194139535885 true] [17592186372573 1113 #uuid "6e7e42d7-6551-5aff-864e-31e3a04edb71" 13194139535885 true] [17592186372573 1145 "First, we must find the elements of the set $A.$ Substituting the values $n\\in {0,1,2,3}$ into the formula $4n+1,$ we get the following elements:\n\n$$\n\\begin{aligned}n=0 & \\,⇒\\,4(0)+1=1 \\\\ n=1 & \\,⇒\\,4(1)+1=5 \\\\ n=2 & \\,⇒\\,4(2)+1=9 \\\\ n=3 & \\,⇒\\,4(3)+1=13\\end{aligned}\n$$\n\nSo, we have\n\n$$\nA={1,5,9,13}.\n$$\n\nNow, a subset of $A$ is a set whose elements are also elements of the set $A.$\n\nIn our case, $B={1,5,13}$ is a subset of $A.$\n\nIn the rest of the options, the set $B$ has elements that are not in $A,$ meaning that it is not a subset of $A.$" 13194139535885 true] [17592186372574 1000 #edb/ref 17592186372575 13194139535885 true] [17592186372574 1000 #edb/ref 17592186372576 13194139535885 true] [17592186372574 1000 #edb/ref 17592186372577 13194139535885 true] [17592186372574 1000 #edb/ref 17592186372578 13194139535885 true] [17592186372574 1000 #edb/ref 17592186372579 13194139535885 true] [17592186372574 1040 #edb/ref 17592186045450 13194139535885 true] [17592186372574 1041 "selection" 13194139535885 true] [17592186372574 1104 #edb/ref 17592186372577 13194139535885 true] [17592186372574 1110 #uuid "e0683d8a-6088-5187-ace9-67a4b3c3cfd3" 13194139535885 true] [17592186372575 1034 "B={0,1,2,3}" 13194139535885 true] [17592186372575 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372575 1111 #uuid "90a1cee1-a065-5c9c-9bac-c5306f1287eb" 13194139535885 true] [17592186372576 1034 "B={1,2,9,12}" 13194139535885 true] [17592186372576 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372576 1111 #uuid "ff0e4130-3d14-5139-b27d-406e8b1e1c03" 13194139535885 true] [17592186372577 1034 "B={1,5,13}" 13194139535885 true] [17592186372577 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372577 1111 #uuid "87684fc7-b279-5b9a-be80-4d81fe052fe3" 13194139535885 true] [17592186372578 1034 "B={0,1,5,9,13}" 13194139535885 true] [17592186372578 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372578 1111 #uuid "84851410-2993-5377-9236-081977f3a3b7" 13194139535885 true] [17592186372579 1034 "B={1,5,9,13,17}" 13194139535885 true] [17592186372579 1103 #edb/ref 17592186045453 13194139535885 true] [17592186372579 1111 #uuid "0fb89e48-f667-564c-b3d3-2aeab4ea2dfd" 13194139535885 true] [17592186372580 1017 #edb/ref 17592186372581 13194139535885 true] [17592186372580 1089 "q-37266" 13194139535885 true] [17592186372580 1091 #edb/ref 17592186045464 13194139535885 true] [17592186372580 1100 "Which of the following sets is a subset of $A={3,6,9,12,15,18,21,…}?$\n\n- $B={3n:n\\in N,1\\le n\\le 4}$\n- $C={6n:n\\in N,1\\le n\\le 3}$\n- $D={2n:n\\in N,1\\le n\\le 4}$" 13194139535885 true] [17592186372580 1113 #uuid "fb98e8f1-5ed6-502a-b031-26657626ffd8" 13194139535885 true] [17592186372580 1145 "First, we must find the elements of the sets $B,C$ and $D.$\n\n- We find the elements of the set $B$ substituting the values $n\\in {1,2,3,4}$ into the formula $3n,$ and we get the following elements:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,3(1)=3 \\\\ n=2 & \\,⇒\\,3(2)=6 \\\\ n=3 & \\,⇒\\,3(3)=9 \\\\ n=4 & \\,⇒\\,3(4)=12\\end{aligned}\n$$\n\nSo we have, $B={3,6,9,12}.$\n\n- On the other hand, the elements of the set $C$ can be found substituting the values $n\\in {1,2,3}$ into the formula $6n,$ and we get the following:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,6(1)=6 \\\\ n=2 & \\,⇒\\,6(2)=12 \\\\ n=3 & \\,⇒\\,6(3)=18\\end{aligned}\n$$\n\nTherefore, $C={6,12,18}.$\n\n- Finally, the elements of the set $D$ can be found substituting the values $n\\in {1,2,3,4}$ into the formula $2n,$ and we get:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,2(1)=2 \\\\ n=2 & \\,⇒\\,2(2)=4 \\\\ n=3 & \\,⇒\\,2(3)=6 \\\\ n=4 & \\,⇒\\,2(4)=8\\end{aligned}\n$$\n\nSo we have, $D={2,4,6,8}.$\n\nNow, a set is a subset of $A$ if all of its elements are also elements of $A.$ With that in mind, let's inspect each option.\n\n- $B={3,6,9,12}$ is a subset of $A.\\,✓$\n\n- $C={6,12,18}$ is a subset of $A.\\,✓$\n\n- $D={2,4,6,8}$ is *not* a subset of $A$ because it contains the element $2\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"I and II only\"." 13194139535885 true] [17592186372581 1000 #edb/ref 17592186372582 13194139535885 true] [17592186372581 1000 #edb/ref 17592186372583 13194139535885 true] [17592186372581 1000 #edb/ref 17592186372584 13194139535885 true] [17592186372581 1000 #edb/ref 17592186372585 13194139535885 true] [17592186372581 1000 #edb/ref 17592186372586 13194139535885 true] [17592186372581 1040 #edb/ref 17592186045450 13194139535885 true] [17592186372581 1041 "selection" 13194139535885 true] [17592186372581 1104 #edb/ref 17592186372585 13194139535885 true] [17592186372581 1110 #uuid "a88c1383-2eeb-507a-a204-683c877bbf7c" 13194139535885 true] [17592186372582 1034 "I and III only" 13194139535885 true] [17592186372582 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372582 1111 #uuid "85632a57-e55d-5287-bf45-c249e78e95fd" 13194139535885 true] [17592186372583 1034 "I only" 13194139535885 true] [17592186372583 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372583 1111 #uuid "cd3a8c3a-e696-5f0c-b5e6-9b1175806bfe" 13194139535885 true] [17592186372584 1034 "III only" 13194139535885 true] [17592186372584 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372584 1111 #uuid "26aac073-2784-58ce-b700-7e1c19837fa3" 13194139535885 true] [17592186372585 1034 "I and II only" 13194139535885 true] [17592186372585 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372585 1111 #uuid "ef591ac2-93a9-56e6-b3fd-00d41596e791" 13194139535885 true] [17592186372586 1034 "II only" 13194139535885 true] [17592186372586 1103 #edb/ref 17592186045454 13194139535885 true] [17592186372586 1111 #uuid "befdbb84-b438-57ae-a9e0-f82275e43739" 13194139535885 true] [17592186372587 1017 #edb/ref 17592186372588 13194139535885 true] [17592186372587 1089 "q-80808" 13194139535885 true] [