t $B$ has elements that are not in $A,$ meaning that it is not a subset of $A.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-37265" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/activity-metadata.json" "file_sha256" "5d3e201778a4c3fe75f10c5cc7b701c5453a3e60021b05eb3f9f7bced8a7aad2" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-37265" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-37265" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "B={-1,0,1,2,4,6}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-37265" "field" "selection" "attr