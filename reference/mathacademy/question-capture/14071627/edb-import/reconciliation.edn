 get\n\n$$\n∅,{r},{t},{r,t}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104924" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-104924" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104924" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{r,t}"] ["math" "{r},{t}"] ["math" "{r},{t},{r,t}"] ["math" "∅,{r,t}"] ["math" "∅,{r},{t},{r,t}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104924" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "∅,{r},{t},{r,t}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1191" "field" nil "attribute" "question/problem" "value" "Find all of the subsets of $A={x,y,z}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1191" "field" nil 