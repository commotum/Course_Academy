3edb30e4482af5"} {"question" "q-104925" "field" nil "attribute" "question/worked-solution" "value" "To find every subset of $A,$ we list out every combination of elements within $A.$ \n\nWe can use the following diagram to visualize the process:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/assets/bb31e2bd632f39706b2785ce6cab764673997fe77b8a9417f7dc213cdff4b7a7.png)\n\nNote that we must include the empty set, since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{0},{1},{0,1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104925" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-104925" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104925" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{-1},{0,1}"] ["math" "{0},{-1},{1},{-1,1}"] ["math" "{0},{1},{-1,0}"] ["math" "∅,{0},{1},{0,1}"] ["math" "∅,{1},{1,2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-104925" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "∅,{0},{1},{0,1}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80829" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of ${R}^{-}$ (the set of negative real numbers)?\n\n- ${Z}_{0}^{-}$ (the set of non-positive integers)\n- $N$\n- ${Q}^{-}$  (the set of negative rational numbers)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80829" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Z}_{0}^{-}$ is *not* a subset of ${R}^{-}.$ For example, $0\\in {Z}_{0}^{-}$ but $0\\notin {R}^{-}.$\n\n- $N$ is not  a subset of ${R}^{-}.$ For example, $1\\in N$ but $1\\notin {R}^{-}.$\n\n- ${Q}^{-}$ is a subset of ${R}^{-}.$ Indeed, every negative rational number is also a negative real number.\n\nTherefore, the correct answer is \"III only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80829" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-80829" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80829" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80829" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1208" "field" nil "attribute" "question/problem" "value" "Which statement is **not** true?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1208" "field" nil "attribute" "question/worked-solution" "value" "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $C⊆Z$ is not true. This statement is not true because not every complex is an integer number. For example, we have $2\\text{i}\\in C$ but $2\\text{i}\\notin Z.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1208" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-1208" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1208" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "C⊆Z"] ["math" "Q⊆R"] ["math" "R⊆R"] ["math" "Z⊆R"] ["math" "{Z}^{+}⊆Z"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1208" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "C⊆Z"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-506" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of $R?$\n\n- ${Q}^{+}$ (the set of positive rationals)\n- ${Z}^{-}$ (the set of negative integers)\n- $N$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-506" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}^{+}$ is  a subset of $R.$ Every positive rational number is a real number.\n\n- ${Z}^{-}$ is a subset of $R.$ Every negative integer number is a real number.\n\n- $N$ a subset of $R.$ Every natural number is a real number.\n\nTherefore, the correct answer is \"I, II, and III\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-506" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-506" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-506" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-506" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I, II, and III"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105033" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of ${Q}_{0}^{-}$ (the set of non-positive rational numbers)?\n\n- $Z$\n- ${Z}^{-}$ (the set of negative integers)\n- $N$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105033" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $Z$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in Z$ but $1\\notin {Q}_{0}^{-}.$\n\n- ${Z}^{-}$ is  a subset of ${Q}_{0}^{-}.$ Every negative integer is a non-positive rational number.\n\n- $N$ is *not* a subset of ${Q}_{0}^{-}.$ For example, $1\\in N$ but $1\\notin {Q}_{0}^{-}.$\n\nTherefore, the correct answer is \"II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105033" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-105033" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105033" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "III only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105033" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1209" "field" nil "attribute" "question/problem" "value" "Which statement is **not** true?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1209" "field" nil "attribute" "question/worked-solution" "value" "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $Z⊆{Z}^{+}$ is not true. This statement is not true because not every integer is a positive integer. For example, we have $-1\\in Z$ but $-1\\notin {Z}^{+}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1209" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-1209" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1209" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "N⊆Z"] ["math" "Z⊆Z"] ["math" "Z⊆{Z}^{+}"] ["math" "{Z}^{+}⊆Z"] ["math" "{Z}^{-}⊆Z"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1209" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "Z⊆{Z}^{+}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80837" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in {Z}^{+}∣x\\le 3}$ and $B={x\\in Z∣0\\le x<3}?$\n\n- $A⊆B$\n- $B⊈A$\n- $∅⊈B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80837" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all positive integers that satisfy the inequality $x\\le 3.$ So, we have \n\n$$\nA={1,2,3}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $0\\le x<3.$ So, we have\n\n$$\nB={0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false. For example, $3\\in A$ but $3\\notin B.$\n\n- $B⊈A$ is true. For example, $0\\in B$ but $0\\notin A.$\n\n- $∅⊈B$ is false. The null set $∅={}$ is a subset of *every* set.\n\nTherefore, the correct answer is \"II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80837" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-80837" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80837" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80837" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1210" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in Z:-2\\le x<6}$ and $B={x\\in N:x+1<6}?$\n\n- $∅⊆B$\n- $B⊆A$\n- $A⊈B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1210" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all integer numbers greater than or equal to $-2$ but less than $6.$ So,\n\n$$\nA={-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers that satisfy the inequality $x+1<6.$ So,\n\n$$\nB={1,2,3,4}.\n$$\n\nNow, let's inspect the given statements.\n\n- $∅⊆B$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊈B$ is true. For example, $-1\\in A$ but $-1\\notin B.$\n\nTherefore, the correct answer is \"I, II, and III\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1210" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-1210" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1210" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1210" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I, II, and III"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1212" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in N∣-1\\le x+1\\le 3}$ and $B={x\\in Z∣{x}^{2}\\le -2}?$\n\n- $A⊆B$\n- $A⊈B$\n- $B⊆A$\n- $A⊇B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1212" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $-1\\le x+1\\le 3,$ that is to say, $-2\\le x\\le 2.$ So, we have\n\n$$\nA={1,2}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality ${x}^{2}\\le -2.$ So, we have\n\n$$\nB=∅.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $0\\in A$ but $0\\notin B.$\n\n- $B⊆A$ is true. The empty set is a subset of every set.\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II, III, and IV only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1212" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-1212" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1212" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I and IV only"] ["text" "I, III, and IV only"] ["text" "II, III, and IV only"] ["text" "III and IV only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-1212" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II, III, and IV only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80832" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in N:1\\le x<6}$ and $B={x\\in N:3x<9}?$\n\n- $A⊆B$\n- $B⊆A$\n- $A⊈B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80832" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all natural numbers greater than or equal to $1$ but less than $6.$ So,\n\n$$\nA={1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers which satisfy the inequality $3x<9.$ So,\n\n$$\nB={1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\nTherefore, the correct answer is \"II and III only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80832" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-80832" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80832" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-80832" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105065" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in Z∣x\\le 5}$ and $B={x\\in Z∣-7\\le x<3}?$\n\n- $A⊆B$\n- $B⊆A$\n- $B⊈A$\n- $A⊇B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105065" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the integer numbers that satisfy the inequality $x\\le 5.$ So, we have\n\n$$\nA={…,-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $-7\\le x<3.$ So, we have\n\n$$\nB={-7,-6,-5,-4,-3,-2,-1,0,1,2}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A⊆B$ is false.  For example, $5\\in A$ but $5\\notin B.$\n\n- $B⊆A$ is true, while $B⊈A$ is false. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"II and IV only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105065" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/activity-metadata.json" "file_sha256" "17b1b6a1bda16aa16216243c0938dd635ee848fa836b32d73e92f5ffaa4f5889"} {"question" "q-105065" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105065" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "II and IV only"] ["text" "II only"] ["text" "III and IV only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "q-105065" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and IV only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/state.json" "file_sha256" "6dda760ab79edc564fb0dab909b0f1b7ad2f41550167811b2c3edb30e4482af5"} {"question" "e-13195" "field" nil "attribute" "question/problem" "value" "Which of the following sets is a subset of $S=\\{n \\in \\mathbb{Z}: {-3} \\leq 2n+1 \\leq 7 \\}?$\n\n- $\\{ -2, 0, 4 \\}$\n\n- $\\{ 0, 3 \\}$\n\n- $\\{ -3, 1, 3 \\}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13195.json" "file_sha256" "05385b280d27cb6420103c6573836afd5742b9d09c3c84c9a241552f373cdef7"} {"question" "e-13195" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the set $S.$ Solving the given inequality, we have\n\n$$\n\\begin{aligned}-3\\le 2n+1 & \\le 7 \\\\ -4\\le 2n & \\le 6 \\\\ -2\\le n & \\le 3.\\end{aligned}\n$$\n\nSo, $S$ contains all integers between $-2$ and $3$ (including $-2$ and $3$):\n\n$$\nS = \\{ -2, -1, 0, 1, 2, 3 \\}\n$$\n\nA set is a subset of $S$ if all its elements are elements of $S.$ With that in mind, let's inspect each option.\n\n- $\\{ -2,0,4 \\}$ is *not* a subset of $S$ because it contains the element $4 \\notin S. \\quad \\color{red}\\times$\n\n- $\\{ 0,3 \\}$ is a subset of $S. \\quad \\color{green}\\checkmark$\n\n- $\\{ -3,1,3 \\}$ is *not* a subset of $S$ because it contains the element $-3 \\notin S. \\quad \\color{red}\\times$\n\nTherefore, the correct answer is \"II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13195.json" "file_sha256" "05385b280d27cb6420103c6573836afd5742b9d09c3c84c9a241552f373cdef7"} {"question" "e-13196" "field" nil "attribute" "question/problem" "value" "Find all of the subsets of $A = \\{ a, b, c \\}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13196.json" "file_sha256" "f74092b3e2827e64b45f89f1582e3a46d5a6227daa1c9880dc4abea0bc86ccab"} {"question" "e-13196" "field" nil "attribute" "question/worked-solution" "value" "To find every subset of $A,$ we list out every combination of elements within $A.$ \n\nWe can use the following diagram to visualize the process:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/assets/8323a4292a4f06d66d456bfce1906cbc7e9933a3fac41dd5fb643e13d25f6a6e.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n\\emptyset, \\{a\\}, \\{b\\}, \\{c\\}, \\{a, b\\}, \\{a, c\\}, \\{b, c\\}, \\{a, b, c\\}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13196.json" "file_sha256" "f74092b3e2827e64b45f89f1582e3a46d5a6227daa1c9880dc4abea0bc86ccab"} {"question" "e-13197" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of $\\mathbb{Z}_0^+$ (the set of non-negative integers)?\n\n- $\\mathbb{Z}$\n\n- $\\mathbb{Z}^-$ (the set of negative integers)\n\n- $\\mathbb{N}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13197.json" "file_sha256" "881e75a6e22f82f1c617efdcb0a48f483542a4b3e7048543d9c0e47831c119a3"} {"question" "e-13197" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $\\mathbb{Z}$ is *not* a subset of $\\mathbb{Z}_0^+.$ For example, $-1 \\in \\mathbb{Z}$ but $-1 \\notin \\mathbb{Z}_0^+.$\n\n- $\\mathbb{Z}^-$ is *not* a subset of $\\mathbb{Z}_0^+.$ For example, $-1 \\in \\mathbb{Z}^-$ but $-1 \\notin \\mathbb{Z}_0^+.$\n\n- $\\mathbb{N}$ is a subset of $\\mathbb{Z}_0^+.$ Every natural number is a positive integer.\n\nTherefore, the correct answer is \"III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13197.json" "file_sha256" "881e75a6e22f82f1c617efdcb0a48f483542a4b3e7048543d9c0e47831c119a3"} {"question" "e-13198" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A =\\{ n \\in \\mathbb{N} \\mid 2n \\geq 10 \\}$ and $B= \\{ n\\in \\mathbb{Z} \\mid n+2 \\geq 5 \\}?$\n\n- $A\\subseteq B$\n\n- $B\\subseteq A$\n\n- $B\\nsubseteq A$\n\n- $B\\supseteq A$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13198.json" "file_sha256" "a2c5b09c5e7b1dfddb90477c2020daac7818e035416160ff32a5719c2cb395f4"} {"question" "e-13198" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $2n\\geq 10,$ that is, $n\\geq 5.$ So, we have\n\n$$\nA= \\{5,6,7,8,9,\\ldots \\}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n+2\\geq 5,$ that is, $n\\geq 3.$ So, we have\n\n$$\nB= \\{3,4,5,6,7,\\ldots\\}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A\\subseteq B$ is true. Every element of $A$ is an element of the set $B.$\n\n- $B\\subseteq A$ is false, while $B\\nsubseteq A$ is true. For example, $3 \\in B$ but $3 \\notin A.$\n\n- $B\\supseteq A$ is equivalent to $A \\subseteq B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071627/example-13198.json" "file_sha256" "a2c5b09c5e7b1dfddb90477c2020daac7818e035416160ff32a5719c2cb395f4"}] "usage" {"q-104924" [] "q-121