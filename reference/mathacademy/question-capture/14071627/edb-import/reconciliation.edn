cademy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of $R?$\n\n- ${Q}^{+}$ (the set of positive rationals)\n- ${Z}^{-}$ (the set of negative integers)\n- $N$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Q}^{+}$ is  a subset of $R.$ Every positive rational number is a real number.\n\n- ${Z}^{-}$ is a subset of $R.$ Every negative integer number is a real number.\n\n- $N$ a subset of $R.$ Every natural number is a real number.\n\nTherefore, the correct answer is \"I, II, and III\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/activity-metadata.json" "file_sha256" "5d3e201778a4c3fe75f10c5cc7b701c5453a3e60021b05eb3f9f7bced8a7aad2" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I, II, and III"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-506" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I, II, and III"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A={x\\in Z:-2\\le x<6}$ and $B={x\\in N:x+1<6}?$\n\n- $∅⊆B$\n- $B⊆A$\n- $A⊈B$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all integer numbers greater than or equal to $-2$ but less than $6.$ So,\n\n$$\nA={-2,-1,0,1,2,3,4,5}.\n$$\n\n- On the other hand, the elements of the set $B$ are natural numbers that satisfy the inequality $x+1<6.$ So,\n\n$$\nB={1,2,3,4}.\n$$\n\nNow, let's inspect the given statements.\n\n- $∅⊆B$ is true. The null set $∅={}$ is a subset of *every* set.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊈B$ is true. For example, $-1\\in A$ but $-1\\notin B.$\n\nTherefore, the correct answer is \"I, II, and III\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/activity-metadata.json" "file_sha256" "5d3e201778a4c3fe75f10c5cc7b701c5453a3e60021b05eb3f9f7bced8a7aad2" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I, II, and III"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1210" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I, II, and III"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/state.json" "file_sha256" "61983787d7b1521c296f31aa85175694e88bdf4ea9509ab958cd7c8192c8fb51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13195" "field" nil "attribute" "question/problem" "value" "Which of the following sets is a subset of $S=\\{n \\in \\mathbb{Z}: {-3} \\leq 2n+1 \\leq 7 \\}?$\n\n- $\\{ -2, 0, 4 \\}$\n\n- $\\{ 0, 3 \\}$\n\n- $\\{ -3, 1, 3 \\}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13195.json" "file_sha256" "d5effa67a56ffb61b8387daad4b064c72d149fbf05ce843292449da3c8ec6b51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13195" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the set $S.$ Solving the given inequality, we have\n\n$$\n\\begin{aligned}-3\\le 2n+1 & \\le 7 \\\\ -4\\le 2n & \\le 6 \\\\ -2\\le n & \\le 3.\\end{aligned}\n$$\n\nSo, $S$ contains all integers between $-2$ and $3$ (including $-2$ and $3$):\n\n$$\nS = \\{ -2, -1, 0, 1, 2, 3 \\}\n$$\n\nA set is a subset of $S$ if all its elements are elements of $S.$ With that in mind, let's inspect each option.\n\n- $\\{ -2,0,4 \\}$ is *not* a subset of $S$ because it contains the element $4 \\notin S. \\quad \\color{red}\\times$\n\n- $\\{ 0,3 \\}$ is a subset of $S. \\quad \\color{green}\\checkmark$\n\n- $\\{ -3,1,3 \\}$ is *not* a subset of $S$ because it contains the element $-3 \\notin S. \\quad \\color{red}\\times$\n\nTherefore, the correct answer is \"II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13195.json" "file_sha256" "d5effa67a56ffb61b8387daad4b064c72d149fbf05ce843292449da3c8ec6b51" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13196" "field" nil "attribute" "question/problem" "value" "Find all of the subsets of $A = \\{ a, b, c \\}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13196.json" "file_sha256" "ee5a5afde26d4b315e2aec6bb17c4fb7d8e2722c68154d6b6df98973ca09e863" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13196" "field" nil "attribute" "question/worked-solution" "value" "To find every subset of $A,$ we list out every combination of elements within $A.$ \n\nWe can use the following diagram to visualize the process:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/assets/8323a4292a4f06d66d456bfce1906cbc7e9933a3fac41dd5fb643e13d25f6a6e.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n\\emptyset, \\{a\\}, \\{b\\}, \\{c\\}, \\{a, b\\}, \\{a, c\\}, \\{b, c\\}, \\{a, b, c\\}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13196.json" "file_sha256" "ee5a5afde26d4b315e2aec6bb17c4fb7d8e2722c68154d6b6df98973ca09e863" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13197" "field" nil "attribute" "question/problem" "value" "Which of the following are subsets of $\\mathbb{Z}_0^+$ (the set of non-negative integers)?\n\n- $\\mathbb{Z}$\n\n- $\\mathbb{Z}^-$ (the set of negative integers)\n\n- $\\mathbb{N}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13197.json" "file_sha256" "1277e1c05159978d62bf19f6c79ee1651938343006476b89096acbc1ed45c60d" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13197" "field" nil "attribute" "question/worked-solution" "value" "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- $\\mathbb{Z}$ is *not* a subset of $\\mathbb{Z}_0^+.$ For example, $-1 \\in \\mathbb{Z}$ but $-1 \\notin \\mathbb{Z}_0^+.$\n\n- $\\mathbb{Z}^-$ is *not* a subset of $\\mathbb{Z}_0^+.$ For example, $-1 \\in \\mathbb{Z}^-$ but $-1 \\notin \\mathbb{Z}_0^+.$\n\n- $\\mathbb{N}$ is a subset of $\\mathbb{Z}_0^+.$ Every natural number is a positive integer.\n\nTherefore, the correct answer is \"III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13197.json" "file_sha256" "1277e1c05159978d62bf19f6c79ee1651938343006476b89096acbc1ed45c60d" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13198" "field" nil "attribute" "question/problem" "value" "Which of the following statements are true for the sets $A =\\{ n \\in \\mathbb{N} \\mid 2n \\geq 10 \\}$ and $B= \\{ n\\in \\mathbb{Z} \\mid n+2 \\geq 5 \\}?$\n\n- $A\\subseteq B$\n\n- $B\\subseteq A$\n\n- $B\\nsubseteq A$\n\n- $B\\supseteq A$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13198.json" "file_sha256" "09746a22cff45b7b282519faf40ab5bf836b468c2f05d072431b0bdf8c713388" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "e-13198" "field" nil "attribute" "question/worked-solution" "value" "First, we must find the elements of the sets $A$ and $B.$\n\n- The elements of the set $A$ are all the natural numbers that satisfy the inequality $2n\\geq 10,$ that is, $n\\geq 5.$ So, we have\n\n$$\nA= \\{5,6,7,8,9,\\ldots \\}.\n$$\n\n- On the other hand, the elements of the set $B$ are all integers that satisfy the inequality $n+2\\geq 5,$ that is, $n\\geq 3.$ So, we have\n\n$$\nB= \\{3,4,5,6,7,\\ldots\\}.\n$$\n\nNow, let's inspect the given statements.\n\n- $A\\subseteq B$ is true. Every element of $A$ is an element of the set $B.$\n\n- $B\\subseteq A$ is false, while $B\\nsubseteq A$ is true. For example, $3 \\in B$ but $3 \\notin A.$\n\n- $B\\supseteq A$ is equivalent to $A \\subseteq B,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/example-13198.json" "file_sha256" "09746a22cff45b7b282519faf40ab5bf836b468c2f05d072431b0bdf8c713388" "basis" 1332 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038640/edb-import/verification.json"} {"question" "q-1209" "field" nil "attribute" "question/problem" "value" "Which statement is **not** true?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/state.json" "file_sha256" "79c423d5f5eb0233a5f008b1bbab00c39c8a481cf9eb95912a1cfa9d6af2fb0c" "basis" 2485 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/edb-import/verification.json"} {"question" "q-1209" "field" nil "attribute" "question/worked-solution" "value" "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $Z⊆{Z}^{+}$ is not true. This statement is not true because not every integer is a positive integer. For example, we have $-1\\in Z$ but $-1\\notin {Z}^{+}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/state.json" "file_sha256" "79c423d5f5eb0233a5f008b1bbab00c39c8a481cf9eb95912a1cfa9d6af2fb0c" "basis" 2485 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/edb-import/verification.json"} {"question" "q-1209" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070456/activity-metadata.json" "file_sha256" "d0667bfe035df587e2