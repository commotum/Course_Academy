2}{a}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3a}{a}+\\frac{2}{a} & = \\\\ \\frac{3a+2}{a}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79545/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-79545"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113218/selection/a3297728238cebab8b8cf0db89fb44e25bb2297c05ea60798e7d9d7d23623012" :answer/id #uuid "7ba1db1b-b2b9-5340-85f9-b32869d8488d" :answer/type :answer.type/math :answer/value "\\frac{t+6}{t}" :db/ensure [:answer/validate]} {:db/id "q-113218/selection/11f08d5897afe39b2d2b7487a65d8970d2361cc05e3867955ff3483496e1f2cb" :answer/id #uuid "7bd42029-86e9-5df4-bd11-fc3ad18b0666" :answer/type :answer.type/math :answer/value "\\frac{2(t+3)}{t}" :db/ensure [:answer/validate]} {:db/id "q-113218/selection/6629807fd769823d38aa1e19cd5ba6c958b155b690534a6c75dc0364b78447c4" :answer/id #uuid "b061212c-5960-58ac-9238-4768f36e4838" :answer/type :answer.type/math :answer/value "\\frac{2(t-3)}{t}" :db/ensure [:answer/validate]} {:db/id "q-113218/selection/1393709bd6266bcdd1d948c09be58d5c35fa9372a987b3aadb784e58cee5815f" :answer/id #uuid "890a9e80-ec7d-5b2c-bb08-48a660464ad9" :answer/type :answer.type/math :answer/value "\\frac{t+3}{t}" :db/ensure [:answer/validate]} {:db/id "q-113218/selection/fa98eefbfb7757f608edba38a43eba4f0907c51dff91d130583fb7a59fe2a12d" :answer/id #uuid "c005bac0-0581-500e-888d-03e79a4eef6b" :answer/type :answer.type/math :answer/value "\\frac{t-6}{t}" :db/ensure [:answer/validate]} {:db/id "q-113218/selection" :answer-field/id #uuid "cbca82b0-6dc7-5c5f-ae3e-dd50fd1e2c82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113218/selection/11f08d5897afe39b2d2b7487a65d8970d2361cc05e3867955ff3483496e1f2cb" :answer-field/choices ["q-113218/selection/a3297728238cebab8b8cf0db89fb44e25bb2297c05ea60798e7d9d7d23623012" "q-113218/selection/11f08d5897afe39b2d2b7487a65d8970d2361cc05e3867955ff3483496e1f2cb" "q-113218/selection/6629807fd769823d38aa1e19cd5ba6c958b155b690534a6c75dc0364b78447c4" "q-113218/selection/1393709bd6266bcdd1d948c09be58d5c35fa9372a987b3aadb784e58cee5815f" "q-113218/selection/fa98eefbfb7757f608edba38a43eba4f0907c51dff91d130583fb7a59fe2a12d"] :db/ensure [:answer-field/validate]} {:db/id "q-113218" :question/id #uuid "c9a9a65a-403c-5185-b342-71bb7896bc55" :question/math-academy-id "q-113218" :question/problem "$2-\\frac{(-6)}{t}=$" :question/worked-solution "Using the fact that $2=\\frac{2}{1},$ we can write the expression as\n\n$$\n\\frac{2}{1}-\\frac{(-6)}{t}=.\n$$\n\n \n\nIn order to subtract the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $t$ by multiplying the top and bottom of the first fraction by $t:$\n\n$$\n\\begin{aligned}\\frac{2}{1}-\\frac{(-6)}{t} & = \\\\ \\frac{t}{t}\\cdot \\frac{2}{1}-\\frac{(-6)}{t} & = \\\\ \\frac{2t}{t}-\\frac{(-6)}{t}\\end{aligned}\n$$\n\nFinally, we subtract the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{2t}{t}-\\frac{(-6)}{t} & = \\\\ \\frac{2t-(-6)}{t} & = \\\\ \\frac{2t+6}{t} & = \\\\ \\frac{2(t+3)}{t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064"] :knowledge-point/questions ["q-113218"] :db/ensure [:knowledge-point/validate]}]
