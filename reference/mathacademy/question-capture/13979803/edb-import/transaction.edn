[{:db/id [:question/math-academy-id "q-5144"] :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4x-6y=3.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-6y & =3 \\\\ ({x}^{2}+4x)+({y}^{2}-6y) & =3 \\\\ ({x}^{2}+2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot 3y+{3}^{2}) & =3+{2}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 2x+4)+({y}^{2}-2\\cdot 3y+9) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-(-2))^{2}+(y-3)^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-2,3)$ and its radius is $4.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-5195"] :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3y & =0 \\\\ {x}^{2}+({y}^{2}-3y) & =0 \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & ={(\\frac{3}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{3}{2})$ and its radius is $\\frac{3}{2}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-15304/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d2662da6-5d6e-5a02-b150-85e096bf4b28" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-15304/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "9c028b1c-7e53-5c49-82ef-8e91de58963b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-15304/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "35286e4f-caa5-5993-ab8c-efae8957c64e" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-15304/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5739e008-718a-58ef-883a-a7d5f3ab0c34" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-15304/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b576d278-1dff-5f74-a3d6-aae3ad80c2bd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-15304/selection" :answer-field/id #uuid "1e158480-e3c5-5b1a-abac-ad5cf8bdd2ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15304/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-15304/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-15304/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-15304/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-15304/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-15304/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-15304" :question/id #uuid "f65516b8-bb1f-5087-99f2-636aa3137c2b" :question/math-academy-id "q-15304" :question/problem "A circle in the Cartesian plane is given by the equation $8x+{x}^{2}-2y=64-{y}^{2}.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+{x}^{2}-2y & =64-{y}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}-2y) & =64 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =64+{4}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y-1)^{2} & ={9}^{2} \\\\ (x-(-4))^{2}+(y-1)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-4,b=1$ and $r=9,$ and\n\n$$\na+b+r=-4+1+9=6.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15304/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15304"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76369/selection/aa8c7a8ead9d5244e70da1177f447f3e58f614980f4baca3786fc51b0e588918" :answer/id #uuid "0bf4f6a8-750d-5b85-b51e-c42c4d19bbed" :answer/type :answer.type/text :answer/value "center: $(2,\\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76369/selection/c519f5c46e41e8b9b52d816029a2a6c9eb0d231d27fcc44976780f9e7327aa5f" :answer/id #uuid "e41410c9-780d-57f1-8375-95a1c4f15f09" :answer/type :answer.type/text :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76369/selection/ca65cd9b0d11c8ca263031a25dbdedcc71f05432885e002b32abd1cf0c2c87f8" :answer/id #uuid "809bb278-fcd0-5c2d-a7af-ed5bfbab9123" :answer/type :answer.type/text :answer/value "center: $(-\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76369/selection/e4fdc5fce587ec6c84df10d045904c8c9f2c0d83fa6fe8f6e50f26302683eb7d" :answer/id #uuid "601d553b-93d4-571e-ac52-69bb151590e4" :answer/type :answer.type/text :answer/value "center: $(-\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76369/selection/6618efd56fdf7f7d5faba6a5e89fbe1941e5a758aa172712ff9f496e59f7d2f0" :answer/id #uuid "311f8c72-774f-5f89-9a99-beedc9df420e" :answer/type :answer.type/text :answer/value "center: $(\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76369/selection" :answer-field/id #uuid "f4b70656-0a53-59cc-b22d-e9002336746b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76369/selection/c519f5c46e41e8b9b52d816029a2a6c9eb0d231d27fcc44976780f9e7327aa5f" :answer-field/choices ["q-76369/selection/aa8c7a8ead9d5244e70da1177f447f3e58f614980f4baca3786fc51b0e588918" "q-76369/selection/c519f5c46e41e8b9b52d816029a2a6c9eb0d231d27fcc44976780f9e7327aa5f" "q-76369/selection/ca65cd9b0d11c8ca263031a25dbdedcc71f05432885e002b32abd1cf0c2c87f8" "q-76369/selection/e4fdc5fce587ec6c84df10d045904c8c9f2c0d83fa6fe8f6e50f26302683eb7d" "q-76369/selection/6618efd56fdf7f7d5faba6a5e89fbe1941e5a758aa172712ff9f496e59f7d2f0"] :db/ensure [:answer-field/validate]} {:db/id "q-76369" :question/id #uuid "492fef68-ac54-52b5-a47e-c1c26464381a" :question/math-academy-id "q-76369" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}-x+{y}^{2}-4y=-2.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-x+{y}^{2}-4y & =-2 \\\\ ({x}^{2}-x)+({y}^{2}-4y) & =-2 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-2+{(\\frac{1}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{9}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & =\\frac{9}{4} \\\\ {(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},2)$ and its radius is $\\frac{3}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-76369/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-76369"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76370/selection/962d0826da5a0828a53d1498f47838ff13537ef15acc21bd2a970853fad84ced" :answer/id #uuid "cffcd1ae-2d86-5a08-ad2a-443aa4271d00" :answer/type :answer.type/text :answer/value "center: $(\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76370/selection/c6a7c81c183dd2bc8ca255abd6146078ad17046fbeaab9a8d46b10fedc876765" :answer/id #uuid "c921b065-97bf-5cfe-9720-0ad602f0952e" :answer/type :answer.type/text :answer/value "center: $(-\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76370/selection/31a8775b240dd70c8301c72663373f36b2925080f08595ed9003985a0a6aa9ba" :answer/id #uuid "cb9130c4-82f1-5be0-b2bd-77fb2a2a6eee" :answer/type :answer.type/text :answer/value "center: $(-\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76370/selection/03b89999a8349c9d1b2cbe6b8d6466e16e627558fe368781ae90860b14ed9339" :answer/id #uuid "a1234273-2900-592e-873e-25e4459494d8" :answer/type :answer.type/text :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76370/selection/37cd7bd37d5ee41c8ee3066668b1b1f0b256ec882a05709cbe1824c45181be3c" :answer/id #uuid "3e6a7d19-828b-58e6-9eea-6c15ee3c62de" :answer/type :answer.type/text :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-76370/selection" :answer-field/id #uuid "428aac5c-0a7c-5723-9778-0f3b9be47d9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76370/selection/03b89999a8349c9d1b2cbe6b8d6466e16e627558fe368781ae90860b14ed9339" :answer-field/choices ["q-76370/selection/962d0826da5a0828a53d1498f47838ff13537ef15acc21bd2a970853fad84ced" "q-76370/selection/c6a7c81c183dd2bc8ca255abd6146078ad17046fbeaab9a8d46b10fedc876765" "q-76370/selection/31a8775b240dd70c8301c72663373f36b2925080f08595ed9003985a0a6aa9ba" "q-76370/selection/03b89999a8349c9d1b2cbe6b8d6466e16e627558fe368781ae90860b14ed9339" "q-76370/selection/37cd7bd37d5ee41c8ee3066668b1b1f0b256ec882a05709cbe1824c45181be3c"] :db/ensure [:answer-field/validate]} {:db/id "q-76370" :question/id #uuid "f34675ee-522c-557d-823a-993c91a76a0d" :question/math-academy-id "q-76370" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+3x+{y}^{2}-y=-\\frac{9}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+3x+{y}^{2}-y & =-\\frac{9}{4} \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =-\\frac{9}{4} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =-\\frac{9}{4}+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{1}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{1}{2}$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76370/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-76370"] :db/ensure [:knowledge-point/validate]}]
