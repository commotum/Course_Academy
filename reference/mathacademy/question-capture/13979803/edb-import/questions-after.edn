#{[{:db/id #edb/ref 17592186280081 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35286e4f-caa5-5993-ab8c-efae8957c64e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186280083} {:answer/id #uuid "b576d278-1dff-5f74-a3d6-aae3ad80c2bd" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280084} {:answer/id #uuid "9c028b1c-7e53-5c49-82ef-8e91de58963b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280085} {:answer/id #uuid "d2662da6-5d6e-5a02-b150-85e096bf4b28" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280086} {:answer/id #uuid "5739e008-718a-58ef-883a-a7d5f3ab0c34" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186280087}] :answer-field/correct {:answer/id #uuid "9c028b1c-7e53-5c49-82ef-8e91de58963b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280085} :answer-field/id #uuid "1e158480-e3c5-5b1a-abac-ad5cf8bdd2ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280082}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f65516b8-bb1f-5087-99f2-636aa3137c2b" :question/math-academy-id "q-15304" :question/problem "A circle in the Cartesian plane is given by the equation $8x+{x}^{2}-2y=64-{y}^{2}.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}8x+{x}^{2}-2y & =64-{y}^{2} \\\\ ({x}^{2}+8x)+({y}^{2}-2y) & =64 \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =64+{4}^{2}+{1}^{2} \\\\ ({x}^{2}+2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot y+{1}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+4)^{2}+(y-1)^{2} & ={9}^{2} \\\\ (x-(-4))^{2}+(y-1)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-4,b=1$ and $r=9,$ and\n\n$$\na+b+r=-4+1+9=6.\n$$"}] [{:db/id #edb/ref 17592186078979 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ffeffb-ef59-54f5-be3f-a2062b83999e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186077086} {:answer/id #uuid "a8e22452-4b20-5bf4-9090-9c4baa1361ca" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186077087} {:answer/id #uuid "c8f09b0a-5fff-5884-866a-7cd7c2b038b1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186077088} {:answer/id #uuid "d6f5be55-2167-551f-a536-04e193c35eb9" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2, 3)$, radius: $4$" :db/id #edb/ref 17592186077089} {:answer/id #uuid "00169a7a-33bd-5ce6-8aa9-6f23a52c4730" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186077090}] :answer-field/correct {:answer/id #uuid "d6f5be55-2167-551f-a536-04e193c35eb9" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2, 3)$, radius: $4$" :db/id #edb/ref 17592186077089} :answer-field/id #uuid "b0de6a19-461b-5d8f-8397-c1cfef2f142b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077085}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd6c82b9-14ab-538d-aa0f-037306546c3d" :question/math-academy-id "q-5144" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4x-6y=3.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-6y & =3 \\\\ ({x}^{2}+4x)+({y}^{2}-6y) & =3 \\\\ ({x}^{2}+2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot 3y+{3}^{2}) & =3+{2}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 2x+4)+({y}^{2}-2\\cdot 3y+9) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-(-2))^{2}+(y-3)^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-2,3)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186078984 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb132994-f531-5eaf-8fc7-bf8dc2310898" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0, \\frac{3}{2})$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186077116} {:answer/id #uuid "fab767cb-f90c-5a0a-a8a1-873c76e762d1" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0, \\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186077117} {:answer/id #uuid "fb7e6176-a5fe-5289-8539-cb5d4dc8a559" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0, \\frac{9}{4})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186077118} {:answer/id #uuid "135a0a72-daec-5833-a4e9-2433cdb6d604" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0, \\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186077119} {:answer/id #uuid "51493782-eab4-5361-b87d-c9c9968cb298" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0,-\\frac{3}{2})$, radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186077120}] :answer-field/correct {:answer/id #uuid "135a0a72-daec-5833-a4e9-2433cdb6d604" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(0, \\frac{3}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186077119} :answer-field/id #uuid "0e9b7bb3-210b-52bd-be07-12ceace16d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077115}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "369014bc-22e5-503d-91de-63ec87d81ac8" :question/math-academy-id "q-5195" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3y & =0 \\\\ {x}^{2}+({y}^{2}-3y) & =0 \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{3}{2}y+{(\\frac{3}{2})}^{2}) & ={(\\frac{3}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2} \\\\ (x-0)^{2}+{(y-\\frac{3}{2})}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{3}{2})$ and its radius is $\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186280088 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311f8c72-774f-5f89-9a99-beedc9df420e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280090} {:answer/id #uuid "0bf4f6a8-750d-5b85-b51e-c42c4d19bbed" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,\\frac{1}{2})$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280091} {:answer/id #uuid "e41410c9-780d-57f1-8375-95a1c4f15f09" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280092} {:answer/id #uuid "809bb278-fcd0-5c2d-a7af-ed5bfbab9123" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280093} {:answer/id #uuid "601d553b-93d4-571e-ac52-69bb151590e4" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},-2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280094}] :answer-field/correct {:answer/id #uuid "e41410c9-780d-57f1-8375-95a1c4f15f09" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280092} :answer-field/id #uuid "f4b70656-0a53-59cc-b22d-e9002336746b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280089}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "492fef68-ac54-52b5-a47e-c1c26464381a" :question/math-academy-id "q-76369" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}-x+{y}^{2}-4y=-2.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-x+{y}^{2}-4y & =-2 \\\\ ({x}^{2}-x)+({y}^{2}-4y) & =-2 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-2+{(\\frac{1}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{9}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & =\\frac{9}{4} \\\\ {(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},2)$ and its radius is $\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186280095 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1234273-2900-592e-873e-25e4459494d8" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186280097} {:answer/id #uuid "cb9130c4-82f1-5be0-b2bd-77fb2a2a6eee" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280098} {:answer/id #uuid "3e6a7d19-828b-58e6-9eea-6c15ee3c62de" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186280099} {:answer/id #uuid "cffcd1ae-2d86-5a08-ad2a-443aa4271d00" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{1}{2},\\frac{3}{2}),$ radius: $\\frac{3}{2}$" :db/id #edb/ref 17592186280100} {:answer/id #uuid "c921b065-97bf-5cfe-9720-0ad602f0952e" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},-\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186280101}] :answer-field/correct {:answer/id #uuid "a1234273-2900-592e-873e-25e4459494d8" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2}),$ radius: $\\frac{1}{2}$" :db/id #edb/ref 17592186280097} :answer-field/id #uuid "428aac5c-0a7c-5723-9778-0f3b9be47d9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280096}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f34675ee-522c-557d-823a-993c91a76a0d" :question/math-academy-id "q-76370" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+3x+{y}^{2}-y=-\\frac{9}{4}.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+3x+{y}^{2}-y & =-\\frac{9}{4} \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =-\\frac{9}{4} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =-\\frac{9}{4}+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{1}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{1}{2}$"}]}
