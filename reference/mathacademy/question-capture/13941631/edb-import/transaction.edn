emy-id "q-84722" :question/problem "Evaluate ${}_{8}{C}_{8}.$" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=8$ and $r=8,$ we get\n\n$$\n\\begin{aligned}{}_{8}{C}_{8} & =\\frac{8!}{(8-8)!\\,8!} \\\\  & =\\frac{8!}{0!\\,8!} \\\\  & =\\frac{\\cancel{8!}}{1\\cdot \\cancel{8!}} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-84722/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "320acdc4-d3ca-5bc8-85de-cea9cc2fa9c3"] :knowledge-point/questions ["q-84722"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122496/selection/4846a359246033f27f5b63df51f98e7323198672abe43768909c9601651802c0" :answer/id #uuid "403a9e2b-7c1a-570e-9a2d-506219f4705f" :answer/type :answer.type/math :answer/value "239\\,500\\,800" :db/ensure [:answer/validate]} {:db/id "q-122496/selection/02ddd28ecf7c540455939ca8b659cf26377dff4fb2cfce0f35f284a540feeaac" :answer/id #uuid "e20facd9-f9a1-56d9-8d3e-6b4a4b05da91" :answer/type :answer.type/math :answer/value "132" :db/ensure [:answer/validate]} {:db/id "q-122496/selection/fb9543263a9223701b044b4df1253dbf56223b34eb1fa1274a3f985cff2b06f3" :answer/id #uuid "1ab91722-d581-55a6-8343-3f2245934608" :answer/type :answer.type/math :answer/value "3\\,628\\,800" :db/ensure [:answer/validate]} {:db/id "q-122496/selection/6458a3c2125824487b96b0b3333df27a6ac187a10c4509584ffd99fe685be8b4" :answer/id #uuid "e83155e8-36c3-5e5b-a978-e12eda40d741" :answer/type :answer.type/math :answer/value "7\\,257\\,600" :db/ensure [:answer/validate]} {:db/id "q-122496/selection/728ecd05f971a253a3c26dbe75d9e0a7cfee71804ca75ebb83455b35d611b45b" :answer/id #uuid "678ea8ed-c502-57cf-bfa6-980c19173474" :answer/type :answer.type/math :answer/value "66" :db/ensure [:answer/validate]} {:db/id "q-122496/selection" :answer-field/id #uuid "56f3d1df-8d9b-5836-860