}x \\\\  & ={\\int }_{0}^{2}\\sqrt{1+4{x}^{2}{e}^{-{x}^{2}/2}}\\,\\text{d}x.\\end{aligned}\n$$" 13194139534459 true] [17592186289368 1000 #edb/ref 17592186289369 13194139534459 true] [17592186289368 1000 #edb/ref 17592186289370 13194139534459 true] [17592186289368 1000 #edb/ref 17592186289371 13194139534459 true] [17592186289368 1000 #edb/ref 17592186289372 13194139534459 true] [17592186289368 1000 #edb/ref 17592186289373 13194139534459 true] [17592186289368 1040 #edb/ref 17592186045450 13194139534459 true] [17592186289368 1041 "selection" 13194139534459 true] [17592186289368 1104 #edb/ref 17592186289369 13194139534459 true] [17592186289368 1110 #uuid "01c8dc1d-a7d1-5f5d-b2d8-5a99fecec513" 13194139534459 true] [17592186289369 1034 "{\\int }_{0}^{2}\\sqrt{1+4{x}^{2}{e}^{-{x}^{2}/2}}\\,\\text{d}x" 13194139534459 true] [17592186289369 1103 #edb/ref 17592186045453 13194139534459 true] [17592186289369 1111 #uuid "14180a72-795d-5d8c-8111-279d202e86e4" 13194139534459 true] [17592186289370 1034 "{\\int }_{0}^{2}\\sqrt{1+2{x}^{2}{e}^{-{x}^{2}/2}}\\,\\text{d}x" 13194139534459 true] [17592186289370 1103 #edb/ref 17592186045453 13194139534459 true] [17592186289370 1111 #uuid "d0707116-ef74-5197-963c-8c375cacd1cc" 13194139534459 true] [17592186289371 1034 "{\\int }_{0}^{2}\\sqrt{1+x{e}^{-{x}^{2}/2}}\\,\\text{d}x" 13194139534459 true] [17592186289371 1103 #edb/ref 17592186045453 13194139534459 true] [17592186289371 1111 #uuid "08b6f25a-e9e9-59bd-9947-9ff12f815bb4" 13194139534459 true] [17592186289372 1034 "{\\int }_{0}^{2}\\sqrt{1+{x}^{2}{e}^{-{x}^{2}/4}}\\,\\text{d}x" 13194139534459 true] [17592186289372 1103 #edb/ref 17592186045453 13194139534459 true] [17592186289372 1111 #uuid "e8eb275b-2f62-5869-988c-ba551a60558a" 13194139534459 true] [17592186289373 1034 "{\\int }_{0}^{2}\\sqrt{1+4x{e}^{-{x}^{2}/4}}\\,\\text{d}x" 13194139534459 true] [17592186289373 1103 #edb/ref 17592186045453 13194139534459 true] [17592186289373 1111 #uuid "5056685c-72c9-521e-8e1a-d9f478a23a69" 1319413953