edge-point/validate]} {:db/id "q-141101/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d988ef17-7cd0-57cf-bedd-df476651cd7d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-141101/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "fa54bca0-f61d-569d-ac43-3edfc933e221" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-141101/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "e1ac4cf4-18c9-5e56-afe3-a201adc55a3b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-141101/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "78d10572-47e8-5f06-9377-4158762acd1d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-141101/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "72671062-989c-5748-ae57-796cb7b8a96e" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-141101/selection" :answer-field/id #uuid "1b2aa5b5-7356-59c9-b5dc-04c7139ccd54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141101/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-141101/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-141101/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-141101/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-141101/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-141101/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25"] :db/ensure [:answer-field/validate]} {:db/id "q-141101" :question/id #uuid "a3cfc1fb-f2ea-5d4f-9851-aafa6955258e" :question/math-academy-id "q-141101" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{5y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\n- $y={x}^{5}$\n- $y={x}^{10}$\n- $y=5{x}^{4}$" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y={x}^{5},$ we get $\\frac{\\text{d}y}{\\text{d}x}=5{x}^{4}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 5{x}^{4} & \\overset{?}{=}\\frac{5({x}^{5})}{x} \\\\ 5{x}^{4} & =5{x}^{4}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y={x}^{5}$ *is* a solution to our differential equation.\n\n- Differentiating $y={x}^{10},$ we get $\\frac{\\text{d}y}{\\text{d}x}=10{x}^{9}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 10{x}^{9} & \\overset{?}{=}\\frac{5({x}^{10})}{x} \\\\ 10{x}^{9} & \\overset{?}{=}5{x}^{9} \\\\ 5{x}^{9} & \\ne 0.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={x}^{10}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=5{x}^{4},$ we get $\\frac{\\text{d}y}{\\text{d}x}=20{x}^{3}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 20{x}^{3} & \\overset{?}{=}\\frac{5(5{x}^{4})}{x} \\\\ 20{x}^{3} & \\overset{?}{=}25{x}^{3} \\\\ 0 & \\ne 5{x}^{3}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=5{x}^{4}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141101/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc"] :knowledge-point/questions ["q-141101"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162307/selection/5a93add74a19a3527113ea0550e0118c39758b808f1637ebf8a1eb8df077b3be" :answer/id #uuid "08902678-e446-5bfc-979e-0e67ceed382f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png" :db/ensure [:answer/validate]} {:db/id "q-162307/selection/ce1eada4b5ba75746ff6249d3e147d9a9d64ec603482e87804ba56ccf8a2cb40" :answer/id #uuid "aca2f55b-5067-5a3c-a5f3-01f5eab41df6" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/58013857f5024f78c322059e5ffdbf10943b0479722202c972a51ccda4be3525.png" :db/ensure [:answer/validate]} {:db/id "q-162307/selection/309638e89582d9451922a285815edd063e52fad1c680a14be89bfc831b636c74" :answer/id #uuid "108ca23f-21ab-545a-a5eb-0f90dc8fdfb5" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/70c37a408e7c4b8dd9b949735ee5e5a8112bceee0f2b879d26052d664b90d46b.png" :db/ensure [:answer/validate]} {:db/id "q-162307/selection/49bb9809236d2163880beef981a02b803777187a4074129c841d322a2924442a" :answer/id #uuid "5cdea4c6-0f79-5c70-95dd-1c2489528fd4" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" :db/ensure [:answer/validate]} {:db/id "q-162307/selection/49b243dd70b484ba33148aaf33d28d0d01c06bf88ad3ecc164ddfad636f0b231" :answer/id #uuid "ec711c95-b456-5d24-98cd-7e1da1bc660b" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/3a93f28c1b40170c2fede87cdeb5893cdd07e0a3a7c898a760ecdfb2f156b3c8.png" :db/ensure [:answer/validate]} {:db/id "q-162307/selection" :answer-field/id #uuid "d3a4f1ec-d4d7-5693-b349-28ddaf05559d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162307/selection/49bb9809236d2163880beef981a02b803777187a4074129c841d322a2924442a" :answer-field/choices ["q-162307/selection/5a93add74a19a3527113ea0550e0118c39758b808f1637ebf8a1eb8df077b3be" "q-162307/selection/ce1eada4b5ba75746ff6249d3e147d9a9d64ec603482e87804ba56ccf8a2cb40" "q-162307/selection/309638e89582d9451922a285815edd063e52fad1c680a14be89bfc831b636c74" "q-162307/selection/49bb9809236d2163880beef981a02b803777187a4074129c841d322a2924442a" "q-162307/selection/49b243dd70b484ba33148aaf33d28d0d01c06bf88ad3ecc164ddfad636f0b231"] :db/ensure [:answer-field/validate]} {:db/id "q-162307" :question/id #uuid "b1b3a339-5cbb-547a-ab0a-fcc002181195" :question/math-academy-id "q-162307" :question/problem "Which of the following diagrams shows all the $5$th roots of unity?" :question/worked-solution "Geometrically, the $5$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular pentagon (regular $5$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-162307/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441"] :knowledge-point/questions ["q-162307"] :db/ensure [:knowledge-point/validate]}]
