#{[{:db/id #edb/ref 17592186332558 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "478d2baa-dfdb-5f7c-a968-32c9a381c1fe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186332560} {:answer/id #uuid "3333da21-a267-50fd-983d-00e50c8d5023" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186332561} {:answer/id #uuid "644de2b3-6ce8-5b18-a2e4-a066efcf714d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186332562} {:answer/id #uuid "c8667878-e56e-5cb6-a96e-d410319c78cc" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186332563} {:answer/id #uuid "cefdca8f-3077-51dd-81ef-397321227aa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186332564}] :answer-field/correct {:answer/id #uuid "478d2baa-dfdb-5f7c-a968-32c9a381c1fe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186332560} :answer-field/id #uuid "bac6883d-4ab0-5dbd-ab9a-f112e4fbc14f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332559}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "26d3b422-7b5a-59f6-92d8-0b2ae0c592e0" :question/math-academy-id "q-114251" :question/problem "${lim}_{x\\to -1}\\frac{{x}^{2}+2x+1}{({x}^{2}-4)^{2}-12x-21}=$" :question/worked-solution "If we plug in $x=-1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}+2x+1}{({x}^{2}-4)^{2}-12x-21} & ={lim}_{x\\to -1}\\frac{{[{x}^{2}+2x+1]}^{′}}{{[({x}^{2}-4)^{2}-12x-21]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{2x+2}{4x({x}^{2}-4)-12} \\\\  & ={lim}_{x\\to -1}\\frac{x+1}{2x({x}^{2}-4)-6}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{{x}^{2}+2x+1}{({x}^{2}-4)^{2}-12x-21} & ={lim}_{x\\to -1}\\frac{x+1}{2x({x}^{2}-4)-6} \\\\  & ={lim}_{x\\to -1}\\frac{{[x+1]}^{′}}{{[2x({x}^{2}-4)-6]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{1}{6{x}^{2}-8} \\\\  & =\\frac{1}{6(-1)^{2}-8} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332565 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea88eb7e-e746-5dd9-b94a-76c604fba47a" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 0" :db/id #edb/ref 17592186332567} {:answer/id #uuid "b0db4239-64cb-5a18-90b4-cda5ea98a83b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186332568} {:answer/id #uuid "a454308d-8289-5655-9cc0-497565c7d239" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -4" :db/id #edb/ref 17592186332569} {:answer/id #uuid "adb4e4e4-430a-57fb-93fd-707fbbe1e353" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 1" :db/id #edb/ref 17592186332570} {:answer/id #uuid "5626e6f4-2621-5391-a65b-da14e54a1bd7" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -2" :db/id #edb/ref 17592186332571}] :answer-field/correct {:answer/id #uuid "b0db4239-64cb-5a18-90b4-cda5ea98a83b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186332568} :answer-field/id #uuid "aea9a852-7ff5-51b2-a3a7-935d454d9e09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332566}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9d55a1a3-c458-5974-bbe0-b736b81d43df" :question/math-academy-id "q-123765" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-4t,\\,\\,\\,y={t}^{2}-1,\\,t\\le 0,\n$$\n\nwhat is the range of $x?$" :question/worked-solution "To find the range of $x,$ note that $x=1-4t\\ge 1$ for all $t\\le 0.$ \n\nConsequently, the range of $x$ is $x\\ge 1.$"}] [{:db/id #edb/ref 17592186332572 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e529cc70-407c-58e6-8d72-98df69c51ed0" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186332574} {:answer/id #uuid "3f4bc631-772a-5623-aeea-3baa1881ddd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186332575} {:answer/id #uuid "cd19d113-9bdf-54fb-9de8-b7c25d11c33b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186332576} {:answer/id #uuid "e3a1db8f-8d05-5677-b494-1c75207587c1" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186332577} {:answer/id #uuid "9778c2d8-4e24-566a-959f-c9946b50f0e4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186332578}] :answer-field/correct {:answer/id #uuid "cd19d113-9bdf-54fb-9de8-b7c25d11c33b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186332576} :answer-field/id #uuid "acffd64e-aa01-595f-a2a3-489a6b759b61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332573}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d10f730-d88e-5867-be87-5a616a4cee43" :question/math-academy-id "q-130620" :question/problem "Find the possible values of the constant $x$ given that the matrix $[\\begin{aligned}3 & 5 & 8 \\\\ 1 & 1 & 2 \\\\ x & -1 & -x\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $x:$ \n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 5 & 8 \\\\ 1 & 1 & 2 \\\\ x & -1 & -x\\end{aligned}| & =3|\\begin{aligned}1 & 2 \\\\ -1 & -x\\end{aligned}|-5|\\begin{aligned}1 & 2 \\\\ x & -x\\end{aligned}|+8|\\begin{aligned}1 & 1 \\\\ x & -1\\end{aligned}| \\\\  & =3(-x+2)-5(-x-2x)+8(-1-x) \\\\  & =-3x+6+15x-8-8x \\\\  & =4x-2\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}4x-2 & =0 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186332579 :knowledge-point/_questions [{:knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa54bca0-f61d-569d-ac43-3edfc933e221" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186332581} {:answer/id #uuid "78d10572-47e8-5f06-9377-4158762acd1d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186332582} {:answer/id #uuid "e1ac4cf4-18c9-5e56-afe3-a201adc55a3b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186332583} {:answer/id #uuid "72671062-989c-5748-ae57-796cb7b8a96e" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186332584} {:answer/id #uuid "d988ef17-7cd0-57cf-bedd-df476651cd7d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186332585}] :answer-field/correct {:answer/id #uuid "78d10572-47e8-5f06-9377-4158762acd1d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186332582} :answer-field/id #uuid "1b2aa5b5-7356-59c9-b5dc-04c7139ccd54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332580}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a3cfc1fb-f2ea-5d4f-9851-aafa6955258e" :question/math-academy-id "q-141101" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{5y}{x},\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\n- $y={x}^{5}$\n- $y={x}^{10}$\n- $y=5{x}^{4}$" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y={x}^{5},$ we get $\\frac{\\text{d}y}{\\text{d}x}=5{x}^{4}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 5{x}^{4} & \\overset{?}{=}\\frac{5({x}^{5})}{x} \\\\ 5{x}^{4} & =5{x}^{4}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y={x}^{5}$ *is* a solution to our differential equation.\n\n- Differentiating $y={x}^{10},$ we get $\\frac{\\text{d}y}{\\text{d}x}=10{x}^{9}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 10{x}^{9} & \\overset{?}{=}\\frac{5({x}^{10})}{x} \\\\ 10{x}^{9} & \\overset{?}{=}5{x}^{9} \\\\ 5{x}^{9} & \\ne 0.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={x}^{10}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=5{x}^{4},$ we get $\\frac{\\text{d}y}{\\text{d}x}=20{x}^{3}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{5y}{x} \\\\ 20{x}^{3} & \\overset{?}{=}\\frac{5(5{x}^{4})}{x} \\\\ 20{x}^{3} & \\overset{?}{=}25{x}^{3} \\\\ 0 & \\ne 5{x}^{3}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=5{x}^{4}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186332586 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108ca23f-21ab-545a-a5eb-0f90dc8fdfb5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/70c37a408e7c4b8dd9b949735ee5e5a8112bceee0f2b879d26052d664b90d46b.png" :db/id #edb/ref 17592186332588} {:answer/id #uuid "ec711c95-b456-5d24-98cd-7e1da1bc660b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/3a93f28c1b40170c2fede87cdeb5893cdd07e0a3a7c898a760ecdfb2f156b3c8.png" :db/id #edb/ref 17592186332589} {:answer/id #uuid "5cdea4c6-0f79-5c70-95dd-1c2489528fd4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" :db/id #edb/ref 17592186332590} {:answer/id #uuid "08902678-e446-5bfc-979e-0e67ceed382f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png" :db/id #edb/ref 17592186332591} {:answer/id #uuid "aca2f55b-5067-5a3c-a5f3-01f5eab41df6" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/58013857f5024f78c322059e5ffdbf10943b0479722202c972a51ccda4be3525.png" :db/id #edb/ref 17592186332592}] :answer-field/correct {:answer/id #uuid "5cdea4c6-0f79-5c70-95dd-1c2489528fd4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" :db/id #edb/ref 17592186332590} :answer-field/id #uuid "d3a4f1ec-d4d7-5693-b349-28ddaf05559d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332587}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b1b3a339-5cbb-547a-ab0a-fcc002181195" :question/math-academy-id "q-162307" :question/problem "Which of the following diagrams shows all the $5$th roots of unity?" :question/worked-solution "Geometrically, the $5$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular pentagon (regular $5$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14054574/assets/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png)"}] [{:db/id #edb/ref 17592186060042 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91da50a3-cf98-5022-b962-9974321b81a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x}{2}" :db/id #edb/ref 17592186056972} {:answer/id #uuid "aaf3d286-965c-5a7c-91ea-6409626d3fe1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\sin x}{2}" :db/id #edb/ref 17592186056973} {:answer/id #uuid "2c093518-58a5-5707-b576-8b78d1b0a6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\sin x - 2\\cos x}{3}" :db/id #edb/ref 17592186056974} {:answer/id #uuid "47fe5dd0-7407-525e-8ca7-202609ab107b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\cos x - \\sin x}{\\sqrt{3}}" :db/id #edb/ref 17592186056975} {:answer/id #uuid "63f53ba8-f837-5e9e-b1a7-c9d320f987d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x - \\sin x}{2}" :db/id #edb/ref 17592186056976}] :answer-field/correct {:answer/id #uuid "63f53ba8-f837-5e9e-b1a7-c9d320f987d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x - \\sin x}{2}" :db/id #edb/ref 17592186056976} :answer-field/id #uuid "604c9be9-9a5c-513c-8832-b1bc9ef20f19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056971}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eadd3799-febb-5229-ba9a-9634531ce84d" :question/math-academy-id "q-1778" :question/problem "$\\operatorname{sin}⁡(x+{120}^{∘})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v={120}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+{120}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{120}^{∘}+\\operatorname{cos}⁡x\\operatorname{sin}⁡{120}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306529 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb6d4d7c-611c-5856-b908-bba404390130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{29}{5}" :db/id #edb/ref 17592186306531} {:answer/id #uuid "1e8a47eb-8cf0-50a8-9725-56c5f083ddf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{5}" :db/id #edb/ref 17592186306532} {:answer/id #uuid "d95743f7-829c-5e9b-89d9-7df6f46dc79d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186306533} {:answer/id #uuid "511015a1-8cb1-50c6-a054-0e37a6f3e7d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{10}" :db/id #edb/ref 17592186306534} {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535}] :answer-field/correct {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535} :answer-field/id #uuid "1ff4d9a8-f001-57b6-a079-27b34a6bd2da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306530}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12160eb7-66fc-562b-9de3-7b07d5dea29e" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"}]}
