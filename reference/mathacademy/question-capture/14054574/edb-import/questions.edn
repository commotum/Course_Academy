#{[{:db/id #edb/ref 17592186060042 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91da50a3-cf98-5022-b962-9974321b81a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x}{2}" :db/id #edb/ref 17592186056972} {:answer/id #uuid "aaf3d286-965c-5a7c-91ea-6409626d3fe1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\sin x}{2}" :db/id #edb/ref 17592186056973} {:answer/id #uuid "2c093518-58a5-5707-b576-8b78d1b0a6c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\sin x - 2\\cos x}{3}" :db/id #edb/ref 17592186056974} {:answer/id #uuid "47fe5dd0-7407-525e-8ca7-202609ab107b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\cos x - \\sin x}{\\sqrt{3}}" :db/id #edb/ref 17592186056975} {:answer/id #uuid "63f53ba8-f837-5e9e-b1a7-c9d320f987d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x - \\sin x}{2}" :db/id #edb/ref 17592186056976}] :answer-field/correct {:answer/id #uuid "63f53ba8-f837-5e9e-b1a7-c9d320f987d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\cos x - \\sin x}{2}" :db/id #edb/ref 17592186056976} :answer-field/id #uuid "604c9be9-9a5c-513c-8832-b1bc9ef20f19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056971}] :question/id #uuid "eadd3799-febb-5229-ba9a-9634531ce84d" :question/math-academy-id "q-1778" :question/problem "What is $\\sin (x + 120^{∘})$?"}] [{:db/id #edb/ref 17592186306529 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb6d4d7c-611c-5856-b908-bba404390130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{29}{5}" :db/id #edb/ref 17592186306531} {:answer/id #uuid "1e8a47eb-8cf0-50a8-9725-56c5f083ddf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{5}" :db/id #edb/ref 17592186306532} {:answer/id #uuid "d95743f7-829c-5e9b-89d9-7df6f46dc79d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186306533} {:answer/id #uuid "511015a1-8cb1-50c6-a054-0e37a6f3e7d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{10}" :db/id #edb/ref 17592186306534} {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535}] :answer-field/correct {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535} :answer-field/id #uuid "1ff4d9a8-f001-57b6-a079-27b34a6bd2da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306530}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12160eb7-66fc-562b-9de3-7b07d5dea29e" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"}]}
