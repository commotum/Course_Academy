ed}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1405" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/activity-metadata.json" "file_sha256" "41fc45be10d253903f4a5ba30969c2f07263528c23e0fe7e1b3b153fe814c217"} {"question" "q-1405" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1405" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-18,19,-61⟩"] ["math" "⟨-28,-19,-61⟩"] ["math" "⟨-28,19,-19⟩"] ["math" "⟨18,19,61⟩"] ["math" "⟨28,-19,-19⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1405" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-18,19,-61⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1392" "field" nil "attribute" "question/problem" "value" "Let $a=2i-3j+5k$ and $b=-i+4j+3k.$ Determine $a\\times b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1392" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & -3 & 5 \\\\ -1 & 4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & 5 \\\\ 4 & 3\\end{aligned}|i-|\\begin{aligned}2 & 5 \\\\ -1 & 3\\end{aligned}|j+|\\begin{aligned}2 & -3 \\\\ -1 & 4\\end{aligned}|k \\\\  & =(-3\\cdot 3-5\\cdot 4)i-(2\\cdot 3-5\\cdot (-1))j+(2\\cdot 4-(-3)\\cdot (-1))k \\\\  & =(-9-20)i-(6-(-5))j+(8-3)k \\\\  & =-29i-11j+5k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1392" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/activity-metadata.json" "file_sha256" "41fc45be10d253903f4a5ba30969c2f07263528c23e0fe7e1b3b153fe814c217"} {"question" "q-1392" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1392" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-11i+11j+5k"] ["math" "-29i+j-5k"] ["math" "-29i-11j+5k"] ["math" "-29i-j+11k"] ["math" "11i-j+5k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1392" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-29i-11j+5k"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/q