 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -7 & 2\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -7 & 0\\end{aligned}|k \\\\  & =((-4)\\cdot 2-1\\cdot 0)i-(3\\cdot 2-1\\cdot (-7))j+(3\\cdot 0-(-4)\\cdot (-7))k \\\\  & =-8i-13j-28k \\\\  & =⟨-8,-13,-28⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/example-4341.json" "file_sha256" "5b668d7430ddd4c028760aa614195673a81303fedb7034b9cb195a85b17410e3" "basis" 1386 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/edb-import/verification.json"} {"question" "e-4343" "field" nil "attribute" "question/problem" "value" "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle,$ $\\mathbf{b}=\\langle 0,1,x \\rangle,$ and $|\\,\\mathbf{a} \\times \\mathbf{b}\\,| = \\sqrt{19}.$ Find $x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/example-4343.json" "file_sha256" "5b1ad67bf4163862d73eb7ca033ee82505799922d4112761bee1e65679443669" "basis" 1386 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/edb-import/verification.json"} {"question" "e-4343" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & 1 & 2x \\\\ 0 & 1 & x\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2x \\\\ 1 & x\\end{aligned}|i-|\\begin{aligned}3 & 2x \\\\ 0 & x\\end{aligned}|j+|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|k \\\\  & =-xi-3xj+3k \\\\  & =⟨-x,-3x,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-x)^{2}+(-3x)^{2}+{3}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned} & |\\,a\\times b\\,|=\\sqrt{19} \\\\  & \\sqrt{10{x}^{2}+9}=\\sqrt{19} \\\\  & 10{x}^{2}+9=19 \\\\  & 10{x}^{2}=10 \\\\  & {x}^{2}=1\\end{aligned}\n$$\n\nTherefore, the solutions are $x= \\pm 1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/example-4343.json" "file_sha256" "5b1ad67bf4163862d73eb7ca033ee82505799922d4112761bee1e65679443669" "basis" 1386 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14039806/edb-import/verification.json"}] "sources" [{"question" "q-1409" "field" nil "attribute" "question/problem" "value" "Let $a=⟨-3,5,9⟩$ and $b=⟨2,8,-4⟩.$ Find $a\\times b.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1409" "field" nil "attribute" "question/worked-solution" "value" "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 5 & 9 \\\\ 2 & 8 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}5 & 9 \\\\ 8 & -4\\end{aligned}|i-|\\begin{aligned}-3 & 9 \\\\ 2 & -4\\end{aligned}|j+|\\begin{aligned}-3 & 5 \\\\ 2 & 8\\end{aligned}|k \\\\  & =(5\\cdot (-4)-9\\cdot 8)i-((-3)\\cdot (-4)-9\\cdot 2)j+((-3)\\cdot 8-5\\cdot 2)k \\\\  & =(-20-72)i-(12-18)j+(-24-10)k \\\\  & =-92i+6j-34k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/state.json" "file_sha256" "b825a880e0e1d736e658c43725177f229e73a63bea6543a4de20979979f69828"} {"question" "q-1409" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277/activity-metadata.json" "file_sha256" "41fc45be10d253903f4a5ba30969c2f07263528c23e0fe7e1