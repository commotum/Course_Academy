\\cdot 5)i-(1\\cdot 3-2\\cdot 3)j+(1\\cdot 5-2\\cdot 0)k \\\\  & =(0-15)i-(3-6)j+(5-0)k \\\\  & =⟨-15,3,5⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19779/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-19779"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281977/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "62a1d2ea-4689-59bc-90dc-13d6d3b0f036" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-281977/field-1" :answer-field/id #uuid "714ecb69-2242-5a62-a2dd-e0c62459d9d0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281977/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-281977/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-281977/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3499a533-1f1a-5f85-b65d-cdbd4fbf4ae0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-281977/field-2" :answer-field/id #uuid "d3d7fa9d-7890-5d84-9a7d-29012cad761f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281977/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-281977/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-281977/field-3/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "0692546a-0c1d-54a4-8df4-1c427a28b486" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-281977/field-3" :answer-field/id #uuid "a2708ea4-ba98-5180-a886-9e3fb4dd53ed" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281977/field-3/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-281977/field-3/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97"] :db/ensure [:answer-field/validate]} {:db/id "q-281977" :question/id #uuid "218e8213-0786-589f-9101-a628c7485d08" :question/math-academy-id "q-281977" :question/problem "Let $u=⟨\\frac{2}{3},0,1⟩$ and $v=⟨1,2,-3⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ \\frac{2}{3} & 0 & 1 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & -3\\end{aligned}|i-|\\begin{aligned}\\frac{2}{3} & 1 \\\\ 1 & -3\\end{aligned}|j+|\\begin{aligned}\\frac{2}{3} & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =((0)(-3)-(1)(2))i-((\\frac{2}{3})(-3)-(1)(1))j+((\\frac{2}{3})(2)-(0)(1))k \\\\  & =(0-2)i-(-2-1)j+(\\frac{4}{3})k \\\\  & =-2i+3j+(\\frac{4}{3})k \\\\  & =⟨-2,3,\\frac{4}{3}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-281977/field-1" "q-281977/field-2" "q-281977/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-281977"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19785/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" :answer/id #uuid "07e4a400-7efe-58db-bb86-a9f0506852ed" :answer/type :answer.type/math :answer/value "x=\\pm 4" :db/ensure [:answer/validate]} {:db/id "q-19785/selection/cc05c0bd30758bd68c60a0a01b573ba3de4bc4b36df15f8d17c4b8db388d8d75" :answer/id #uuid "3faf4237-6786-52d7-9205-e0fd4294b6e5" :answer/type :answer.type/math :answer/value "x=-5,-4" :db/ensure [:answer/validate]} {:db/id "q-19785/selection/66ac7e991443eb09f9ff8c47112fa85324a0a692e47a97fe13bfde03f50b6bf8" :answer/id #uuid "3330120f-0c0d-5b50-8d19-4b55bd943eee" :answer/type :answer.type/math :answer/value "x=4,5" :db/ensure [:answer/validate]} {:db/id "q-19785/selection/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" :answer/id #uuid "f5dcc2af-7c42-5941-ad40-c859d47a1c48" :answer/type :answer.type/math :answer/value "x=-5" :db/ensure [:answer/validate]} {:db/id "q-19785/selection/0ee9ad77b56a0535d6153bfd8b2cc53c4932beef33dfb9416cfadcc84babf459" :answer/id #uuid "527a9067-66e0-5541-8a31-09be2917738c" :answer/type :answer.type/math :answer/value "x=\\pm 5" :db/ensure [:answer/validate]} {:db/id "q-19785/selection" :answer-field/id #uuid "62f7e535-c409-5713-83d1-e12bd82fe322" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19785/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" :answer-field/choices ["q-19785/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" "q-19785/selection/cc05c0bd30758bd68c60a0a01b573ba3de4bc4b36df15f8d17c4b8db388d8d75" "q-19785/selection/66ac7e991443eb09f9ff8c47112fa85324a0a692e47a97fe13bfde03f50b6bf8" "q-19785/selection/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" "q-19785/selection/0ee9ad77b56a0535d6153bfd8b2cc53c4932beef33dfb9416cfadcc84babf459"] :db/ensure [:answer-field/validate]} {:db/id "q-19785" :question/id #uuid "4e49fd82-b772-500c-ae05-d9a02fdf2670" :question/math-academy-id "q-19785" :question/problem "Let $a=⟨x,2,3⟩$, $b=⟨2x,5,2⟩$ and $|\\,a\\times b\\,|=\\sqrt{393}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 2 & 3 \\\\ 2x & 5 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|i-|\\begin{aligned}x & 3 \\\\ 2x & 2\\end{aligned}|j+|\\begin{aligned}x & 2 \\\\ 2x & 5\\end{aligned}|k \\\\  & =(4-15)i-(2x-6x)j+(5x-4x)k \\\\  & =⟨-11,4x,x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-11)^{2}+(4x)^{2}+{x}^{2}} \\\\  & =\\sqrt{121+16{x}^{2}+{x}^{2}} \\\\  & =\\sqrt{17{x}^{2}+121}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{393} \\\\ \\sqrt{17{x}^{2}+121} & =\\sqrt{393} \\\\ 17{x}^{2}+121 & =393 \\\\ 17{x}^{2} & =272 \\\\ {x}^{2} & =16.\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19785/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-19785"] :db/ensure [:knowledge-point/validate]} {:db/id "q-282261/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870" :answer/id #uuid "e6f989d7-af00-5d2f-a005-da257cbe76b4" :answer/type :answer.type/math :answer/value "-\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-282261/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "62a45098-3021-5e55-b988-085ae375d93e" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-282261/field-1" :answer-field/id #uuid "256ebc4c-7f6c-5393-be95-9e64d9415fb7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282261/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870" :answer-field/choices ["q-282261/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870" "q-282261/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-282261/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "22afe76c-d28e-5871-be02-a348baebd7b9" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-282261/field-2" :answer-field/id #uuid "e881a6e8-a1d8-5d3d-81c9-8a43bf4cb1cb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-282261/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer-field/choices ["q-282261/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59"] :db/ensure [:answer-field/validate]} {:db/id "q-282261" :question/id #uuid "69cd45e2-ef00-59cc-9c12-4889a1ef7992" :question/math-academy-id "q-282261" :question/problem "Let $a=⟨x,0,1⟩,$ $b=⟨-x,2,0⟩$ and $|\\,a\\times b\\,|=\\sqrt{29}.$ Then, in **ascending order**, the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 0 & 1 \\\\ -x & 2 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}|i-|\\begin{aligned}x & 1 \\\\ -x & 0\\end{aligned}|j+|\\begin{aligned}x & 0 \\\\ -x & 2\\end{aligned}|k \\\\  & =(0-2)i-(0+x)j+(2x+0)k \\\\  & =⟨-2,-x,2x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-2)^{2}+(-x)^{2}+(2x)^{2}} \\\\  & =\\sqrt{4+{x}^{2}+4{x}^{2}} \\\\  & =\\sqrt{5{x}^{2}+4}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{29} \\\\ \\sqrt{5{x}^{2}+4} & =\\sqrt{29} \\\\ 5{x}^{2}+4 & =29 \\\\ 5{x}^{2} & =25 \\\\ {x}^{2} & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\sqrt{5},$ $x=\\sqrt{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-282261/field-1" "q-282261/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-282261"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278839/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "7b2e1274-8ce1-5f89-86a6-68c8a3a535ed" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-278839/field-1" :answer-field/id #uuid "519f7793-f8c7-5470-b79e-2c47491b4f63" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278839/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-278839/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-278839" :question/id #uuid "d0d4f1f4-092c-54ed-bec7-e3d695b165da" :question/math-academy-id "q-278839" :question/problem "Let $a=⟨x,2,1⟩,$ $b=⟨2,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{20}.$ Find $x.$\n\n$\\,x=$\n{{field-1}}" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ x & 2 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}x & 1 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}x & 2 \\\\ 2 & 0\\end{aligned}|k \\\\  & =(2-0)i-(x-2)j+(0-4)k \\\\  & =⟨2,2-x,-4⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{2}^{2}+(2-x)^{2}+(-4)^{2}} \\\\  & =\\sqrt{4+4-4x+{x}^{2}+16} \\\\  & =\\sqrt{{x}^{2}-4x+24}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{20} \\\\ \\sqrt{{x}^{2}-4x+24} & =\\sqrt{20} \\\\ {x}^{2}-4x+24 & =20 \\\\ {x}^{2}-4x+4 & =0 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the solution is $x=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-278839/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-278839"] :db/ensure [:knowledge-point/validate]}]
