begin{aligned}i & j & k \\\\ -3 & 10 & 4 \\\\ 4 & 7 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}10 & 4 \\\\ 7 & 1\\end{aligned}|i-|\\begin{aligned}-3 & 4 \\\\ 4 & 1\\end{aligned}|j+|\\begin{aligned}-3 & 10 \\\\ 4 & 7\\end{aligned}|k \\\\  & =(10\\cdot 1-4\\cdot 7)i-((-3)\\cdot 1-4\\cdot 4)j+((-3)\\cdot 7-10\\cdot 4)k \\\\  & =(10-28)i-(-3-16)j+(-21-40)k \\\\  & =-18i+19j-61k \\\\  & =⟨-18,19,-61⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1405/selection/ma-v1/065445a7b8fef72fc1a5d20cd8c7b65bb1c6bb26b012b11a6002d9ddcb98c4e4"] :db/ensure [:question/validate]} {:db/id "q-1392/selection/50097f4f4fbf07ab9a3e4cc8c1f6905706a539306ac9c9ecca2c3215bde59b95" :answer/id #uuid "27c215c9-fe3c-5325-938d-c796e57eb634" :answer/type :answer.type/math :answer/value "-29i+j-5k" :db/ensure [:answer/validate]} {:db/id "q-1392/selection/8e1266484e6393088174a6929e2c4944ba58e4653102bf785c3f8d11871857cd" :answer/id #uuid "061e74b8-3931-5289-87d9-9776b30ee217" :answer/type :answer.type/math :answer/value "-11i+11j+5k" :db/ensure [:answer/validate]} {:db/id "q-1392/selection/cccdd5510834427aa6cf3ed56bef0dabfcf3f0114fb6f67d63e01ea7c394d42b" :answer/id #uuid "dae7e813-707b-5c06-9e78-0d1480ffe79d" :answer/type :answer.type/math :answer/value "-29i-11j+5k" :db/ensure [:answer/validate]} {:db/id "q-1392/selection/4b9784c0b0ab19285f26b80bd0932b4994d712aaa1c9db8cb60dc9f618d060d8" :answer/id #uuid "57953a7d-6ff5-5463-82b3-660a7987ac8e" :answer/type :answer.type/math :answer/value "11i-j+5k" :db/ensure [:answer/validate]} {:db/id "q-1392/selection/f5c56eba4cf4754b20e8eee73d076e07d2d06e4ad543fba8376ff651b22ad487" :answer/id #uuid "b1169631-86bb-5015-9196-dae826e69684" :answer/type :answer.type/math :answer/value "-29i-j+11k" :db/ensure [:answer/validate]} {:db/id "q-1392/selection" :answer-field/id #uuid "3ef9ec5b-393d-5964-a2c0-18d16c79f679" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1392/select