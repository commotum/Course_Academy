d}|\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120330 :knowledge-point/_questions [{:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13649c1e-6e49-511d-8a0f-cebfd6146cfb" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|" :db/id #edb/ref 17592186309817} {:answer/id #uuid "e8dc526b-83bd-5293-8dcf-406816f93090" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309818} {:answer/id #uuid "8d330f12-fb20-5794-948a-27f29a9c9542" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309819} {:answer/id #uuid "2b2d198c-b6eb-51de-9190-3065c892a238" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309820} {:answer/id #uuid "4950aca5-9056-5a7d-9ce0-450207aedc04" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309821}] :answer-field/correct {:answer/id #uuid "2b2d198c-b6eb-51de-9190-3065c892a238" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186309820} :answer-field/id #uuid "03ec3dd9-1674-51a9-bff6-a23ae4bd1a51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186309816}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b5116353-6062-5b65-a3e1-05950bfbb7b0" :question/math-academy-id "q-36221" :question/problem "$|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 & -3 \\\\ 3 & 6 & -4 & 1 \\\\ 0 & -5 & -5 & 0 \\\\ -1 & 1 & 5 & 2\\end{aligned}| & =0\\cdot {C}_{31}+(-5)\\cdot {C}_{32}+(-5)\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =(-5)\\cdot (-1)^{3+2}|\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|+(-5)\\cdot (-1)^{3+3}\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}3 & 2 & -3 \\\\ 3 & -4 & 1 \\\\ -1 & 5 & 2\\end{aligned}|-5\\cdot |\\begin{aligned}3 & 1 & -3 \\\\ 3 & 6 & 1 \\\\ -1 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120351 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8008cdf5-2e0b-59d2-b581-2578fc0886e0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118582} {:answer/id #uuid "a96b4d68-da37-5fb1-9ec3-30e7eb64add4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118583} {:answer/id #uuid "e88d6f32-cd05-5d9d-90a2-27f611ba8577" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186118584} {:answer/id #uuid "ec2cb425-cbcb-5457-88de-eb204a164629" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186118585} {:answer/id #uuid "2573458a-044a-5685-813c-edae467237cb" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186118586}] :answer-field/correct {:answer/id #uuid "a96b4d68-da37-5fb1-9ec3-30e7eb64add4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186118583} :answer-field/id #uuid "5327bc26-56ef-50c6-8800-0c8e8669eceb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118581}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "00bb680c-6e72-5c8f-931f-0ff9d17c1cfb" :question/math-academy-id "q-42095" :question/problem "Calculate\n$|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|.$" :question/worked-solution "The $3$rd row of the matrix contains two zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}| & =2\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+1\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|+1\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}|-|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the first $3\\times 3$ determinant by applying a Laplace expansion along the $3$rd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ -4 & -2 & 1 \\\\ 1 & 2 & 0\\end{aligned}| & =1\\cdot {C}_{31}+2\\cdot {C}_{32}+0\\cdot {C}_{33} \\\\  & =1\\cdot (-1)^{3+1}\\cdot |\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|+2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}|-2|\\begin{aligned}2 & -1 \\\\ -4 & 1\\end{aligned}| \\\\  & =(1-2)-2(2-4) \\\\  & =-1+4 \\\\  & =3\\end{aligned}\n$$\n\nNow, computing the second $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 2 & 1 \\\\ 0 & -4 & -2 \\\\ -3 & 1 & 2\\end{aligned}| & =0\\cdot {C}_{21}+(-4)\\cdot {C}_{22}+(-2)\\cdot {C}_{23} \\\\  & =(-4)\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+(-2)\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4|\\begin{aligned}1 & 1 \\\\ -3 & 2\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ -3 & 1\\end{aligned}| \\\\  & =-4(2+3)+2(1+6) \\\\  & =-20+14 \\\\  & =-6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 2 & 1 & -1 \\\\ 0 & -4 & -2 & 1 \\\\ 2 & 0 & 0 & 1 \\\\ -3 & 1 & 2 & 0\\end{aligned}|=2\\cdot 3-(-6)=12.\n$$"}] [{:db/id #edb/ref 17592186386294 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cf0eb7-d6e9-50f1-93a0-a79d424730f4" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & 5 & -2 \\\\ -4 & 3 & 1 \\\\ -1 & 2 & -1\\end{aligned}|" :db/id #edb/ref 17592186386296} {:answer/id #uuid "f12cbe05-fd9d-5e6b-b4ae-0ec3666a80e1" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}1 & 5 & -2 \\\\ -4 & 3 & 1 \\\\ -1 & 2 & -1\\end{aligned}|" :db/id #edb/ref 17592186386297} {:answer/id #uuid "dae30ebb-0d51-58bf-977d-a7cb2ef3e838" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & 5 & -2 \\\\ 