1733adfe1" "q-77481/selection/4c175488dc36afd24c288fefae6d3cff232a1226128681f3b4a6aae49e17a932" "q-77481/selection/7a3393fa08d8da45cf5723d235b19bf5d5e07fe2f090ff86adbb6aa41e234829" "q-77481/selection/5f443fb2d89aab5ae7c386f72cff975bccf721a2fc50745075c7d966a4b3c0c6"] :db/ensure [:answer-field/validate]} {:db/id "q-77481" :question/id #uuid "cfa05fc0-6063-57b8-9b97-f3cee2bfee26" :question/math-academy-id "q-77481" :question/problem "$|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & -1 & 3 & 1 \\\\ -2 & 4 & -2 & 2 \\\\ 0 & 3 & 0 & 0 \\\\ 1 & -3 & -4 & 3\\end{aligned}| & =0\\cdot {C}_{31}+3\\cdot {C}_{32}+0\\cdot {C}_{33}+0\\cdot {C}_{34} \\\\  & =3\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}| \\\\  & =-3\\cdot |\\begin{aligned}2 & 3 & 1 \\\\ -2 & -2 & 2 \\\\ 1 & -4 & 3\\end{aligned}|.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77481/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f"] :knowledge-point/questions ["q-77481"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69952/selection/e83b4932222e98116f6392707e76a747776e188056dff33db9efe20ddf8bf912" :answer/id #uuid "cc31072f-a8d1-533d-9d2c-ba890e513f9c" :answer/type :answer.type/math :answer/value "2\\cdot |\\begin{aligned}-1 & 1 & 2 \\\\ -3 & 6 & 1 \\\\ -4 & 1 & 8\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-69952/selection/a258964c8cc165217315507056ba04ab665a0ac63d68e9d6e5ef3f111899e068" :answer/id #uuid "cadc980e-dff7-5d6f-bdf1-070da55beff4" :answer/type :answer.type/math :answer/value "-|\\begin{aligned}-1 & 1 & 2 \\\\ -3 & 6 & 1 \\\\ -4 & 1 & 8\\end{aligned}|" :db/ens