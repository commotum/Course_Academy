] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77506" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" nil "attribute" "question/problem" "value" "$|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}|=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" nil "attribute" "question/worked-solution" "value" "Using a cofactor expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}| & =\\sqrt{3}\\cdot {C}_{13}+0\\cdot {C}_{23}+0\\cdot {C}_{33}+\\sqrt{5}\\cdot {C}_{43} \\\\  & =\\sqrt{3}\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot (-1)^{4+3}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}| \\\\  & =\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/activity-metadata.json" "file_sha256" "7adbcc7d52bf654d087d6f7659d0f66e0953a7b1d71173c43b6e23d57ef5d320" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & -1 \\\\ 5 & \\sqrt{5} & 1\\end{aligned}|"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2\\cdot |\\begin{aligned}2 & \\sqrt{3} & -1 \\\\ -1 & 0 & 1 \\\\ 1 & 0 & -1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & \\sqrt{3} \\\\ -1 & -1 & 0 \\\\ -2 & 1 & 0\\end{aligned}|"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77501" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "|\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-5182" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-5182.json" "file_sha256" "135bfffe33dda4b28df0be5f9eab19093feabcb547ef11cb13bd54efb6a2902b" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-5182" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}| & =(-6)\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+1\\cdot {C}_{44} \\\\  & =(-6)\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+1\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}| \\\\  & =6\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+|\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-5182.json" "file_sha256" "135bfffe33dda4b28df0be5f9eab19093feabcb547ef11cb13bd54efb6a2902b" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-4418" "field" nil "attribute" "question/problem" "value" "Calculate\n$\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4418.json" "file_sha256" "9de4bd1eb91b83dce25f6303dde58aaa5c28379bccc0171fc46d946818156917" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-4418" "field" nil "attribute" "question/worked-solution" "value" "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}| & =0\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+(-1)\\cdot {C}_{44} \\\\  & =(-1)\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| & =1\\cdot |\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 0 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|+|\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}| \\\\  & =(3-8)+(0-0) \\\\  & =-5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4418.json" "file_sha256" "9de4bd1eb91b83dce25f6303dde58aaa5c28379bccc0171fc46d946818156917" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-4419" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4419.json" "file_sha256" "a599703f4517b0dbb35c786809bc84ccdbfc997e7e50650ea9c11657bccafd60" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "e-4419" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}| & =0\\cdot {C}_{12}+3\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =3\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/example-4419.json" "file_sha256" "a599703f4517b0dbb35c786809bc84ccdbfc997e7e50650ea9c11657bccafd60" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-77487" "field" nil "attribute" "question/problem" "value" "Compute the following determinant using a cofactor expansion along the $1$st row:\n\n$$\n|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}|.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/state.json" "file_sha256" "6d64c0a2d6e483e55ccd0d95eda03049be6575221bf4b95cfc4c41eb64d5ef29" "basis" 1716 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/edb-import/verification.json"} {"question" "q-77487" "field" nil "attribute" "question/worked-solution" "value" "Using cofactor expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}| & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+(-1)\\cdot {C}_{14} \\\\  & =1\\cdot (-1)^{1+1}\\cdot |\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}|+(-1)\\cdot (-1)^{1+4}\\cdot |\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & -0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}|+|\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}| & =1\\cdot {C}_{21}+5\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}1 & -1 \\\\ 0 & -3\\end{aligned}|+5\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & -3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 \\\\ 0 & -3\\end{aligned}|+5|\\begin{aligned}2 & -1 \\\\ -4 & -3\\end{aligned}| \\\\  & =-(-3-0)+5(-6-4) \\\\  & =3-50 \\\\  & =-47\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{aligned}| & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+5\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}|+5\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}2 & 2 \\\\ 2 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}|-5|\\begin{aligned}2 & 2 \\\\ 2 & -4\\end{aligned}| \\\\  & =(0-2)-5(-8-4) \\\\  & =-2+60 \\\\  & =58\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}|=-47+58=11.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/state.json" "file_sha256" "6d64c0a2d6e483e55ccd0d95eda03049be6575221bf4b95cfc4c41eb64d5ef29" "basis" 1716 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/edb-import/verification.json"} {"question" "q-77487" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/activity-metadata.json" "file_sha256" "6630ead363435c06aba0bc20398941c8f11be072358418b2a2f03a1ec15b01a2" "basis" 1716 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/edb-import/verification.json"} {"question" "q-77487" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/state.json" "file_sha256" "6d64c0a2d6e483e55ccd0d95eda03049be6575221bf4b95cfc4c41eb64d5ef29" "basis" 1716 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/edb-import/verification.json"} {"question" "q-77487" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-12"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/state.json" "file_sha256" "6d64c0a2d6e483e55ccd0d95eda03049be6575221bf4b95cfc4c41eb64d5ef29" "basis" 1716 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/edb-import/verification.json"} {"question" "q-77487" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-52"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14049356/state.json" "file_sha256" "6d64c0a2d