ong the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 & 0 \\\\ 1 & 3 & -3 & 1 \\\\ 1 & -1 & 2 & 3 \\\\ 0 & -2 & 1 & 0\\end{aligned}| & =0\\cdot {C}_{41}+(-2)\\cdot {C}_{42}+1\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =(-2)\\cdot (-1)^{4+2}\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|+1\\cdot (-1)^{4+3}\\cdot |\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}2 & -1 & 0 \\\\ 1 & -3 & 1 \\\\ 1 & 2 & 3\\end{aligned}|-|\\begin{aligned}2 & 1 & 0 \\\\ 1 & 3 & 1 \\\\ 1 & -1 & 3\\end{aligned}|\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-130030" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/activity-metadata.json" "file_sha256" "7adbcc7d52bf654d087d6f7659d0f66e0953a7b1d71173c43b6e23d57ef5d320" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {"question" "q-130030" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/state.json" "file_sha256" "65c7445f65130fe4c828044f5045b651566096bf51c03481ccccb54865a65ef6" "basis" 1470 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040832/edb-import/verification.json"} {