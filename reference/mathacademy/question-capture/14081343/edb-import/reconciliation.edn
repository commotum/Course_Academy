 & -1 & -1\\end{aligned}|"] ["math" "4\\cdot |\\begin{aligned}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{aligned}|"] ["math" "|\\begin{aligned}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{aligned}|"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77806" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2\\cdot |\\begin{aligned}5 & -7 & 3 \\\\ 9 & 6 & -1 \\\\ 8 & -1 & -1\\end{aligned}|"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77506" "field" nil "attribute" "question/problem" "value" "$|\\begin{aligned}4 & 0 & 9 & 8 \\\\ 2 & 0.5 & 0 & 4 \\\\ 0 & 0.2 & -1 & 3 \\\\ -3 & 0 & 12 & 4\\end{aligned}|=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77506" "field" nil "attribute" "question/worked-solution" "value" "Using a cofactor expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 0 & 9 & 8 \\\\ 2 & 0.5 & 0 & 4 \\\\ 0 & 0.2 & -1 & 3 \\\\ -3 & 0 & 12 & 4\\end{aligned}| & =0\\cdot {C}_{12}+0.5\\cdot {C}_{22}+0.2\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =0.5\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|+0.2\\cdot (-1)^{3+2}\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}| \\\\  & =0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77506" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/activity-metadata.json" "file_sha256" "e8e69abdd07ca8eda110c9aa413b623ca26ba5c516ac870e6814d079e7528257"} {"question" "q-77506" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77506" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ 0 & -1 & 3\\end{aligned}|"] ["math" "0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|"] ["math" "0.3\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|"] ["math" "0.3\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|+0.3\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|"] ["math" "0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77506" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.5\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 0 & -1 & 3 \\\\ -3 & 12 & 4\\end{aligned}|-0.2\\cdot |\\begin{aligned}4 & 9 & 8 \\\\ 2 & 0 & 4 \\\\ -3 & 12 & 4\\end{aligned}|"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "e-5182" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/502b9464378fb5030a72918f45938184f120773e4639f3f50f071ca82fc307ce.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-5182.json" "file_sha256" "6d37e6606de40955fff799de2a2c0c1dda1389178a3c88de6aac764c28c39b8a"} {"question" "e-5182" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}| & =(-6)\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+1\\cdot {C}_{44} \\\\  & =(-6)\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+1\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}| \\\\  & =6\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+|\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/a1c11cfd7d1cacae0881118776eb6b38dea7b92c4f542e8158e31bbfa59274ec.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-5182.json" "file_sha256" "6d37e6606de40955fff799de2a2c0c1dda1389178a3c88de6aac764c28c39b8a"} {"question" "e-4418" "field" nil "attribute" "question/problem" "value" "Calculate\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/15738eec7022be44c90577b931f2e8aa8446a8fc3f911260fcf468ae6ddd2d57.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-4418.json" "file_sha256" "8dd5c5b401cd58bbae8e3e6d46d197ff7424a12c60ab094dde01b27d814c2a9d"} {"question" "e-4418" "field" nil "attribute" "question/worked-solution" "value" "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}| & =0\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+(-1)\\cdot {C}_{44} \\\\  & =(-1)\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| & =1\\cdot |\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 0 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|+|\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}| \\\\  & =(3-8)+(0-0) \\\\  & =-5\\end{aligned}\n$$\n\nTherefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/ce96c053abb756977f717e7130257af39307e5f663596042ddcb5b14b0153cb8.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-4418.json" "file_sha256" "8dd5c5b401cd58bbae8e3e6d46d197ff7424a12c60ab094dde01b27d814c2a9d"} {"question" "e-4419" "field" nil "attribute" "question/problem" "value" "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/82b151cbc7d19f4afa375763d0ca8eb281d76e11f2d775c068e97dbf3d40cae4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-4419.json" "file_sha256" "3f4e937a8b9bfac40a226813ae062f512b399fa6904bf05eff73bf209708cf02"} {"question" "e-4419" "field" nil "attribute" "question/worked-solution" "value" "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}| & =0\\cdot {C}_{12}+3\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =3\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/assets/efb849ac6e240be4d0a6aac3e7f9405158b8b1bb996956b7346c02b5bee751b1.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/example-4419.json" "file_sha256" "3f4e937a8b9bfac40a226813ae062f512b399fa6904bf05eff73bf209708cf02"}] "usage" {"q-69950" [] "q-130030" [] "q-42095" [] "e-4418" [] "e-4419" [] "e-5182" [] "q-70108" [] "q-77501" [] "q-77506" [] "q-77487" [] "q-36221" []} "basis" 2840 "retractions" [[17592186119584 :question/problem "Using a cofactor expansion along the $4$th row, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$"] [17592186119584 :question/worked-solution "Using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}| & =(-6)\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+1\\cdot {C}_{44} \\\\  & =(-6)\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+1\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}| \\\\  & =6\\cdot |\\begin{aligned}2 & -2 & -1 \\\\ -2 & 7 & 9 \\\\ 1 & -2 & 3\\end{aligned}|+|\\begin{aligned}10 & 2 & -2 \\\\ 1 & -2 & 7 \\\\ -2 & 1 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}10 & 2 & -2 & -1 \\\\ 1 & -2 & 7 & 9 \\\\ -2 & 1 & -2 & 3 \\\\ -6 & 0 & 0 & 1\\end{aligned}\n$$"] [17592186119514 :question/problem "Calculate\n$\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}$"] [17592186119514 :question/worked-solution "The $4$th row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}| & =0\\cdot {C}_{41}+0\\cdot {C}_{42}+0\\cdot {C}_{43}+(-1)\\cdot {C}_{44} \\\\  & =(-1)\\cdot (-1)^{4+4}\\cdot |\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, computing the $3 \\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 0 \\\\ 0 & 1 & -4 \\\\ 0 & -2 & 3\\end{aligned}| & =1\\cdot |\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 1 \\\\ 0 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -4 \\\\ -2 & 3\\end{aligned}|+|\\begin{aligned}0 & -4 \\\\ 0 & 3\\end{aligned}| \\\\  & =(3-8)+(0-0) \\\\  & =-5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & -1 & 0 & 2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & -2 & 3 & 1 \\\\ 0 & 0 & 0 & -1\\end{aligned}\n$$"] [17592186119515 :question/problem "Using a cofactor expansion along the $2$nd column, write the following determinant as a combination of $3 \\times 3$ determinants:\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$"] [17592186119515 :question/worked-solution "Using a Laplace expansion along the $2$nd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}| & =0\\cdot {C}_{12}+3\\cdot {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =3\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}1 & -3 & -2 \\\\ 1 & 8 & 9 \\\\ 2 & 3 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & 0 & -3 & -2 \\\\ 2 & 3 & -1 & 5 \\\\ 1 & 0 & 8 & 9 \\\\ 2 & 0 & 3 & -1\\end{aligned}\n$$"]] "immutable_answers" [17592186118582 17592186118583 17592186118584 17592186118585 17592186118586 17592186309811 17592186309812 17592186309813 17592186309814 17592186309815 17592186309817 17592186309818 17592186309819 17592186309820 17592186309821 17592186309824 17592186309825 17592186309826 17592186309827 17592186309828 17592186309838 17592186309839 17592186309840 17592186309841 17592186309842 17592186309873 17592186309874 17592186309875 17592186309876 17592186309877 17592186309880 17592186309881 17592186309882 