d}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{aligned}| & =-2\\cdot {C}_{41}+5\\cdot {C}_{42}+0\\cdot {C}_{43}+0\\cdot {C}_{44} \\\\  & =-2\\cdot (-1)^{4+1}\\cdot |\\begin{aligned}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{aligned}|+5\\cdot (-1)^{4+2}\\cdot |\\begin{aligned}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{aligned}|+5\\cdot |\\begin{aligned}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{aligned}|.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}-1 & 1 & 0 \\\\ -2 & -1 & -1 \\\\ 2 & -7 & 4\\end{aligned}| & =(-1)\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =(-1)\\cdot (-1)^{1+1}\\cdot |\\begin{aligned}-1 & -1 \\\\ -7 & 4\\end{aligned}|+1\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}-2 & -1 \\\\ 2 & 4\\end{aligned}| \\\\  & =-|\\begin{aligned}-1 & -1 \\\\ -7 & 4\\end{aligned}|-|\\begin{aligned}-2 & -1 \\\\ 2 & 4\\end{aligned}| \\\\  & =-(-4-7)-(-8+2) \\\\  & =11+6 \\\\  & =17\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $1$st row, we obtain: \n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 1 & 0 \\\\ 0 & -1 & -1 \\\\ 0 & -7 & 4\\end{aligned}| & =1\\cdot {C}_{11}+1\\cdot {C}_{12}+0\\cdot {C}_{13} \\\\  & =1\\cdot (-1)^{1+1}\\cdot |\\begin{aligned}-1 & -1 \\\\ -7 & 4\\end{aligned}|+1\\cdot (-1)^{1+2}\\cdot |\\begin{aligned}0 & -1 \\\\ 0 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ -7 & 4\\end{aligned}|-|\\begin{aligned}0 & -1 \\\\ 0 & 4\\end{aligned}| \\\\  & =(-4-7)-(0+0) \\\\  & =-11-0 \\\\  & =-11\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n|\\begin{aligned}1 & -1 & 1 & 0 \\\\ 0 & -2 & -1 & -1 \\\\ 0 & 2 & -7 & 4 \\\\ -2 & 5 & 0 & 0\\end{aligned}|=2(17)+5(-11)=-21.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77802" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/activity-metadata.json" "file_sha256" "e8e69abdd07ca8eda110c9aa413b623ca26ba5c516ac870e6814d079e7528257"} {"question" "q-77802" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77802" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-16"] ["math" "-21"] ["math" "15"] ["math" "18"] ["math" "20"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-77802" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-21"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-42104" "field" nil "attribute" "question/problem" "value" "$|\\begin{aligned}2 & -1 & 4 & 0 \\\\ 3 & 1 & 2 & 2 \\\\ -1 & 2 & 3 & 0 \\\\ -3 & -2 & 5 & -1\\end{aligned}|=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14081343/state.json" "file_sha256" "28510feacc81d77c214a31a7af6b8f46abb77cd97a0c7ce2c9b714fa6198ffb1"} {"question" "q-42104" "field" nil "attribute" "question/worked-solution" "value" "Usin