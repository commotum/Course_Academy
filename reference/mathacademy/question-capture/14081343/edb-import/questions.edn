 3\\end{aligned}| & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}| \\\\  & =3+2 \\\\  & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n|\\begin{aligned}0 & 0 & 3 & 0 \\\\ 1 & 2 & 1 & -1 \\\\ 0 & 1 & 2 & 0 \\\\ 2 & -1 & 0 & 3\\end{aligned}|=3\\cdot 5=15.\n$$"}] [{:db/id #edb/ref 17592186327608 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1637e23-6566-5e45-af4c-b27333f882d1" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56f22b1b-56ec-56cf-a95e-5764d1146eea" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186327610} {:answer/id #uuid "6d7816e1-4437-5c8a-8e4f-c1ac979ada06" :answer/type {:db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186327611} {:answer/id #uuid "3ecc7125-e905-5796-abd2-9afb369f573a" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186327612} {:answer/id #uuid "abc9b6ec-4646-5be6-bd8a-6994a148b4dc" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186327613} {:answer/id #uuid "5a7fa3eb-3f42-57a7-8880-dcf490a09f01" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186327614}] :answer-field/correct {:answer/id #uuid "56f22b1b-56ec-56cf-a95e-5764d1146eea" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186327610} :answer-field/id #uuid "a0be2271-17db-5bcd-b673-c40529ab18db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327609}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "34815fa8-ef8e-5e0c-9946-fa850b2969e8" :question/math-academy-id "q-77487" :question/problem "Compute the following determinant using a cofactor expansion along the $1$st row:\n\n$$\n|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}|.\n$$" :question/worked-solution "Using cofactor expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}| & =1\\cdot {C}_{11}+0\\cdot {C}_{12}+0\\cdot {C}_{13}+(-1)\\cdot {C}_{14} \\\\  & =1\\cdot (-1)^{1+1}\\cdot |\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}|+(-1)\\cdot (-1)^{1+4}\\cdot |\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & -0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}|+|\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nComputing the first $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain:\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -1 \\\\ 1 & 5 & 0 \\\\ -4 & 0 & -3\\end{aligned}| & =1\\cdot {C}_{21}+5\\cdot {C}_{22}+0\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+1}\\cdot |\\begin{aligned}1 & -1 \\\\ 0 & -3\\end{aligned}|+5\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}2 & -1 \\\\ -4 & -3\\end{aligned}| \\\\  & =-|\\begin{aligned}1 & -1 \\\\ 0 & -3\\end{aligned}|+5|\\begin{aligned}2 & -1 \\\\ -4 & -3\\end{aligned}| \\\\  & =-(-3-0)+5(-6-4) \\\\  & =3-50 \\\\  & =-47\\end{aligned}\n$$\n\nNow, computing the second  $3\\times 3$ determinant by applying a Laplace expansion along the $2$nd row, we obtain: \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 2 & 1 \\\\ 0 & 1 & 5 \\\\ 2 & -4 & 0\\end{aligned}| & =0\\cdot {C}_{21}+1\\cdot {C}_{22}+5\\cdot {C}_{23} \\\\  & =1\\cdot (-1)^{2+2}\\cdot |\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}|+5\\cdot (-1)^{2+3}\\cdot |\\begin{aligned}2 & 2 \\\\ 2 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}|-5|\\begin{aligned}2 & 2 \\\\ 2 & -4\\end{aligned}| \\\\  & =(0-2)-5(-8-4) \\\\  & =-2+60 \\\\  & =58\\end{aligned}\n$$\n\n  \n\nTherefore,\n\n$$\n|\\begin{aligned}1 & 0 & 0 & -1 \\\\ 2 & 2 & 1 & -1 \\\\ 0 & 1 & 5 & 0 \\\\ 2 & -4 & 0 & -3\\end{aligned}|=-47+58=11.\n$$"}] [{:db/id #edb/ref 17592186309871 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053ce7a7-e30d-5fc9-838b-2e9e0898f2a0" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}2 & \\sqrt{3} & -1 \\\\ -1 & 0 & 1 \\\\ 1 & 0 & -1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186309873} {:answer/id #uuid "294f0a9c-7038-57e2-8764-ffc9d9a19df6" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186309874} {:answer/id #uuid "c4f051ba-97df-5697-9e45-45b3137ebdd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186309875} {:answer/id #uuid "f83d9a05-a308-5783-9f85-e867b9f87606" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & \\sqrt{3} \\\\ -1 & -1 & 0 \\\\ -2 & 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186309876} {:answer/id #uuid "24b833f3-1a50-5a60-9f6c-d9dcf0f861fe" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & -1 \\\\ 5 