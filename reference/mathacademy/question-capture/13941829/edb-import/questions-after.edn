#{[{:db/id #edb/ref 17592186250222 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e5ffae-43fd-5c80-8727-b694451434f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186250224} {:answer/id #uuid "76746881-edec-59f2-8647-624e9234b4bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186250225} {:answer/id #uuid "a9ec88d3-6607-5609-99bc-087423649d0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186250226} {:answer/id #uuid "907f9f5d-a0d9-5821-95ac-0ca8bc6916f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186250227} {:answer/id #uuid "b4a5bc42-fa40-5853-973e-a26670caec4f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250228}] :answer-field/correct {:answer/id #uuid "76746881-edec-59f2-8647-624e9234b4bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186250225} :answer-field/id #uuid "dd8c7224-6d03-51f6-8c21-7d3b7b8e4a46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250223}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "121d554e-5f4e-5371-8473-8b1847a35280" :question/math-academy-id "q-170351" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/bc0e258229c74a97d61919440090dd7b2f0f4a200af987477d2be8818910a88b.png)\n\nThe graph above shows $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=\\frac{1}{4},$ hence $c=\\frac{1}{4}.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,\\frac{3}{2}),$ so we substitute $x=0$ and $y=\\frac{3}{2}$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}+\\frac{1}{4} & =y \\\\ k{(\\frac{1}{2})}^{0}+\\frac{1}{4} & =\\frac{3}{2} \\\\ k+\\frac{1}{4} & =\\frac{3}{2} \\\\ k & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, \n\n$$\nk-c=\\frac{5}{4}-\\frac{1}{4}=1.\n$$\n\nThe equation of the curve is $y=\\frac{5}{4}{(\\frac{1}{2})}^{x}+\\frac{1}{4}.$"}] [{:db/id #edb/ref 17592186250229 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fac3896d-f3de-5c24-831e-150d19394c3e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186250231} {:answer/id #uuid "bee5d350-83ec-534c-a02f-b5d164b1a4a7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186250232} {:answer/id #uuid "3b98021f-5a58-5f20-b630-e0729aa3d601" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186250233} {:answer/id #uuid "35d1f09b-1c9e-5e36-b296-de63f713d9f0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186250234} {:answer/id #uuid "a4bf0065-2457-5f16-a7c3-64bb6402a8c8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186250235}] :answer-field/correct {:answer/id #uuid "fac3896d-f3de-5c24-831e-150d19394c3e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186250231} :answer-field/id #uuid "53442caa-8c5d-55f9-b853-57829590043c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250230}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186250236 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f306987-6696-533b-b78a-4e63886f0de4" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186250238} {:answer/id #uuid "a0a058d7-541c-5f7b-a506-af05186b5260" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-3" :db/id #edb/ref 17592186250239} {:answer/id #uuid "eec4beb7-141b-5617-9064-3bc33efd3adb" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186250240} {:answer/id #uuid "3ef4a19b-ddf0-55b5-8588-0e3a8aa51db9" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+3" :db/id #edb/ref 17592186250241} {:answer/id #uuid "cb5bb668-dfbb-51bd-96ac-f25fe018415a" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186250242}] :answer-field/correct {:answer/id #uuid "4f306987-6696-533b-b78a-4e63886f0de4" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186250238} :answer-field/id #uuid "f9f2c4b9-dbf8-5496-8004-87a9d459ae75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d28d182e-64fa-5ae5-be71-7e9fd891464e" :question/math-academy-id "q-7124" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/1a54cae748796775b76ade4d9060d4eafe6bb84fd45ce725bd516a7db2681ba9.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"}] [{:db/id #edb/ref 17592186250243 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6e2ea6-df80-59e3-8e3e-b93a048ed0fc" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186250245} {:answer/id #uuid "e720d673-c364-505b-9d25-cf44259e7a02" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+1" :db/id #edb/ref 17592186250246} {:answer/id #uuid "062aad1a-b711-5f65-98be-b053214ea6ec" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-1" :db/id #edb/ref 17592186250247} {:answer/id #uuid "1e8f7924-46f3-5a94-9bea-568a094abdf6" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186250248} {:answer/id #uuid "390abee5-e2d7-5692-bfd9-d66d0db2d0a5" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186250249}] :answer-field/correct {:answer/id #uuid "062aad1a-b711-5f65-98be-b053214ea6ec" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-1" :db/id #edb/ref 17592186250247} :answer-field/id #uuid "5d6a9339-5fb1-5d51-886c-fc0016c383c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250244}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b636558e-97c4-5989-88e7-e6ef740059f9" :question/math-academy-id "q-7255" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/df745423b3c91cddbfeb4a6414b17d69ee075ed2d02908f1e97aaecdbbf74679.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-1.$ Therefore, $c=-1.$"}] [{:db/id #edb/ref 17592186250250 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f52c9bc-532a-5dfb-83b3-32d8080e998a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186250252} {:answer/id #uuid "984e5e7c-0703-5c7e-90ce-8bd42ddedd8c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186250253} {:answer/id #uuid "d6fdcc9c-ea41-5ffe-b910-f0f2ad4b2393" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186250254} {:answer/id #uuid "fa12f1ad-c232-531e-9ced-e67ec2ccc37e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250255} {:answer/id #uuid "3ab06f8f-7e41-5ffa-b015-1370cc8c8216" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186250256}] :answer-field/correct {:answer/id #uuid "fa12f1ad-c232-531e-9ced-e67ec2ccc37e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250255} :answer-field/id #uuid "1f6cfc28-d5dc-5fc5-b52d-5fa3f05f787e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250251}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "87942db4-38db-57bf-9c17-cbe92961b339" :question/math-academy-id "q-99724" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13941829/assets/cdce64bf5d02850bbedc2b89af3b2e7447b733831c09d1955e4a9ee97e82d556.png)\n\nThe graph above shows $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=2.$ Hence, $c=2.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,4),$ so we substitute $x=0$ and $y=4$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}+2 & =y \\\\ k{(\\frac{1}{2})}^{0}+2 & =4 \\\\ k+2 & =4 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=2-2=0.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{2})}^{x}+2.$"}]}
