1d7d8c" "q-134043/selection/6a18921c3d16d3ff68e693105960bcdd0b6435824d1c074c46733ab726a0dad7" "q-134043/selection/aeeaca22dfbe610adbcd3995797dd9b344e4f5f98b8ae590ec0e53b55731500b" "q-134043/selection/8a5c7e5c264a10ed2105d3dd5b715247552a6ff4f4b3d257bed6b9817d6c6a68" "q-134043/selection/e608e2496f4a507c9c993c2e9574ff2a2a736ab1eee79b8ab0235c2e7722e97d"] :db/ensure [:answer-field/validate]} {:db/id "q-134043" :question/id #uuid "e4f6e01b-626f-53ed-978c-7963fec3e86f" :question/math-academy-id "q-134043" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/80d08441967f6c1a4026fe9ca0d2bdfdde8fac57a2ae0a7b8d6b34889f3469bd.png)\n\nThe scatter plot above shows the relationship between hours of study per week and the overall percentage obtained by students in a math class. What was the overall percentage obtained by the student who studied, on average,  $7$ hours each week?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/39e7370f9cf517a7a139fecf71561041a9b1470150e0fa333d3fff679f77882d.png)\n\n    \n\nTo determine the overall percentage obtained by the student who studied $7$ hours each week, we locate $7$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(7,85).$ Therefore, the student who studied $7$ hours each week obtained an overall percentage of $85%.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-134043/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b"] :knowledge-point/questions ["q-134043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134087/selection/8a5c7e5c264a10ed2105d3dd5b715247552a6ff4f4b3d257bed6b9817d6c6a68" :answer/id #uuid "86246c32-7325-5f1c-8b00-4aca62f9b80b" :answer/type :answer.type/math :answer/value