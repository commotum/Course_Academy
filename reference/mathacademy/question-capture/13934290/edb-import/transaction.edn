 draw the dependent variable (points scored per game) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-133969/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6"] :knowledge-point/questions ["q-133969"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134014/selection/b38655fa1b4a64604ebb01cdff528a0b367401d56b09c82d93565853774f6550" :answer/id #uuid "2f7ce9e8-c7bb-5b23-b7a4-75fe293bd058" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/135eafa5842b7def7177292f8651834aafb8b4ab446afb676976f3fa50850e5d.png" :db/ensure [:answer/validate]} {:db/id "q-134014/selection/9143ca2cf6543b744b57796367652f8a7db7cf74461b04a3c04a217df8f1e419" :answer/id #uuid "045b0675-8f51-52e9-aee2-9494d0fc48bb" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/7a4c2df9783ec9ec0494a39f6c2b6388eba41d4f4e63f5bd2202100d3393c37b.png" :db/ensure [:answer/validate]} {:db/id "q-134014/selection/ee85af2a248d35e4918a81842f0a24538c64f3143c0c2e90c617d514c234f3a0" :answer/id #uuid "28cc36b2-dda0-544b-82c5-34ba30fa9e54" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/b6f47af2bd4de79badb63c94174d0424d5130f9862d23694412c8daef85fbaf6.png" :db/ensure [:answer/validate]} {:db/id "q-134014/selection/c450fe7a86b77657abbcbe28a45cd35a3d6715c4f2faed6d925033a1acbf36bc" :answer/id #uuid "91ae722a-ec30-53ea-9044-9b6431ba0c4d" :answer/type :answer.type/image