lowing scatter plot.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/cc45b5a8b031e01ad71b93c3e809693c2590c691adb98a2872b47c24839c05f7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-133963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6"] :knowledge-point/questions ["q-133963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-133969/selection/41f2b552eb6b9dcdbeee0d9e75be28caa6c89e69f52aa81c597dd8be75d96551" :answer/id #uuid "b8d350d6-b4c4-5fba-ad23-09ccfb58082e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/726a22a7d72af2ba9a7b9c9568cc1723557ee8c0af4dd38a3dd9bacca4f72769.png" :db/ensure [:answer/validate]} {:db/id "q-133969/selection/b702af5aa27a83b4c34e5a4ac67aadf12722954b2b67f3f981d7016b500ef409" :answer/id #uuid "b39fdbc2-18ec-597b-b8f8-61c6332beb26" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/81364754556cfeed2c4a2b74d2c745c054491e7f0a9e1d2512fffe6dc4569e5d.png" :db/ensure [:answer/validate]} {:db/id "q-133969/selection/afb62808298ea4af77e803225f9c9493cbf5ee9cda947a35c89133a1fe48922a" :answer/id #uuid "ea2e0fa7-e574-56c0-886c-20f56e09891c" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/ensure [:answer/validate]} {:db/id "q-133969/selection/c93b44c228349ef5add65f4ef266b577a782d20133992c89aeb62e6c732d252f" :answer/id #uuid "8c669c4e-892c-5605-983a-952a356d3f2e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/ef920634ab0391c8b13566e8575ee66839bcaf38dd6e4d87bfa336035ab10166.png" :db