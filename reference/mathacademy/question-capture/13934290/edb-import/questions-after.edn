e/mathacademy/question-capture/13934290/assets/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)"}] [{:db/id #edb/ref 17592186247511 :knowledge-point/_questions [{:knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045b0675-8f51-52e9-aee2-9494d0fc48bb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/7a4c2df9783ec9ec0494a39f6c2b6388eba41d4f4e63f5bd2202100d3393c37b.png" :db/id #edb/ref 17592186247513} {:answer/id #uuid "2f7ce9e8-c7bb-5b23-b7a4-75fe293bd058" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/135eafa5842b7def7177292f8651834aafb8b4ab446afb676976f3fa50850e5d.png" :db/id #edb/ref 17592186247514} {:answer/id #uuid "91ae722a-ec30-53ea-9044-9b6431ba0c4d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/ed732c8b49be57346126c835fe5d597b6c6981a65312a01fd1cc102bad68ded2.png" :db/id #edb/ref 17592186247515} {:answer/id #uuid "54a00d23-30c4-55a7-b687-74fdd324880f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/d75e0923974f47a5453e460f70b1d246b88a4fd36e0e02854a7799c9923f96b8.png" :db/id #edb/ref 17592186247516} {:answer/id #uuid "28cc36b2-dda0-544b-82c5-34ba30fa9e54" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934290/assets/b6f47af2bd4de79badb63c94174d0424d5130f9862d23694412c8daef85fbaf6.png" :db/id #edb/ref 17592186247517}] :answer-field/correct {:answer/id #uuid "2f7ce9e8-c7bb-5b23-b7a4-75fe293bd058" :answer/type {