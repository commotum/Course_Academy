#{[{:db/id #edb/ref 17592186247843 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7317d27-3d93-595d-8f28-146fa49b12d5" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186247845} {:answer/id #uuid "ab3af85a-2768-5e88-bb74-188a42d11da7" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186247846} {:answer/id #uuid "298bb281-c375-5099-bf88-6221d25ac234" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186247847} {:answer/id #uuid "3e94897a-21e9-5512-b080-3db17cf609fe" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186247848} {:answer/id #uuid "406b337b-1549-5c55-8d5d-c16fa266cda8" :answer/type {:db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186247849}] :answer-field/correct {:answer/id #uuid "298bb281-c375-5099-bf88-6221d25ac234" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186247847} :answer-field/id #uuid "685358a9-d3bf-5289-85ee-2ac05c868cad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247844}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1835930f-889b-54c0-aecf-1b5ac78ea7cf" :question/is-example false :question/math-academy-id "q-122216" :question/problem "Evaluate $P(6,3).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(6,3)$ means the same thing as ${}_{6}{P}_{3}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(6,3) & =\\frac{6!}{(6-3)!} \\\\  & =\\frac{6!}{3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =6\\cdot 5\\cdot 4 \\\\  & =120.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247850 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e53a832-5f75-50fe-beac-1f6f28986495" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186247852} {:answer/id #uuid "b424222a-3e17-59b0-8746-603f36f07960" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186247853} {:answer/id #uuid "a8d6baf0-ba51-5335-b53f-4dd9d23c2610" :answer/type {:db/ident :answer.type/math} :answer/value "362\\,880" :db/id #edb/ref 17592186247854} {:answer/id #uuid "51b974a2-27e8-5f7f-bdf6-82d396be3b42" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,814\\,400" :db/id #edb/ref 17592186247855} {:answer/id #uuid "57ae9b23-de24-5205-9942-c18e9dc039c8" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,628\\,800" :db/id #edb/ref 17592186247856}] :answer-field/correct {:answer/id #uuid "57ae9b23-de24-5205-9942-c18e9dc039c8" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,628\\,800" :db/id #edb/ref 17592186247856} :answer-field/id #uuid "7b21a53e-f52d-5827-893f-b2ced7ba025d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247851}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b2c2ddf3-e2a0-5f8a-a136-1bc2016728fa" :question/is-example false :question/math-academy-id "q-122224" :question/problem "$P(10,9)=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(10,9)$ means the same thing as ${}_{10}{P}_{9}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(10,9) & =\\frac{10!}{(10-9)!} \\\\  & =\\frac{10!}{1!} \\\\  & =10\\cdot 9\\cdot 8\\cdot 7\\cdot 6\\cdot 5\\cdot 4\\cdot 3\\cdot 2\\cdot 1 \\\\  & =3\\,628\\,800.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247857 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd5239c-f70f-59cb-81c7-b20a82cac077" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,920" :db/id #edb/ref 17592186247859} {:answer/id #uuid "52d5b905-46c1-5365-8d39-3ec33bc29bb9" :answer/type {:db/ident :answer.type/math} :answer/value "990" :db/id #edb/ref 17592186247860} {:answer/id #uuid "6953f119-85f0-5bb0-b6ba-6c52bd4002ca" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,331" :db/id #edb/ref 17592186247861} {:answer/id #uuid "9e92f199-063e-550b-ae17-7b812f745e62" :answer/type {:db/ident :answer.type/math} :answer/value "99" :db/id #edb/ref 17592186247862} {:answer/id #uuid "eb87b9f5-6598-58fc-bd15-48bd334c74ed" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186247863}] :answer-field/correct {:answer/id #uuid "52d5b905-46c1-5365-8d39-3ec33bc29bb9" :answer/type {:db/ident :answer.type/math} :answer/value "990" :db/id #edb/ref 17592186247860} :answer-field/id #uuid "d9bd0049-0e17-526c-9218-631155904f29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247858}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4d432002-9223-58aa-9ee3-f362a5c407eb" :question/is-example false :question/math-academy-id "q-122477" :question/problem "How many $3$-letter words (legitimate or made-up) can be made using the letters of the word DOCUMENTARY, where each letter cannot appear in the word more than once?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $11$ different letters in the word DOCUMENTARY, so $n=11.$ We want to select $3$ of those letters to make-up a $3$-letter word, so we have $r=3.$\n\nTherefore, the number of different made-up words is\n\n$$\n\\begin{aligned}{}_{11}{P}_{3} & =\\frac{11!}{(11-3)!} \\\\  & =\\frac{11!}{8!} \\\\  & =\\frac{11\\cdot 10\\cdot 9\\cdot \\cancel{8!}}{\\cancel{8!}} \\\\  & =11\\cdot 10\\cdot 9 \\\\  & =990.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247864 :knowledge-point/_questions [{:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0749f2c7-e18f-5293-9518-2026a0ad6794" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186247866} {:answer/id #uuid "9dbad050-f869-590e-8e58-c31752a97765" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186247867} {:answer/id #uuid "ae52a63e-6644-5e4c-88f3-f3f635e97052" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186247868} {:answer/id #uuid "5ed422be-76c1-53d0-a8ba-cbbe0c4e3fac" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186247869} {:answer/id #uuid "c556deb9-5d1c-5360-a997-1d50e972b516" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186247870}] :answer-field/correct {:answer/id #uuid "9dbad050-f869-590e-8e58-c31752a97765" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186247867} :answer-field/id #uuid "2dd98a53-3108-5dda-843a-58439d9a414f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247865}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd18f01f-3465-5ee5-ab1c-02f5b61ab820" :question/is-example false :question/math-academy-id "q-84980" :question/problem "How many made-up $3$-letter words can be made using only $5$ vowels, where each vowel cannot appear in the word more than once?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $5$ vowels, so $n=5.$ We want to select $3$ of those vowels to make-up a $3$-letter word, so we have $r=3.$ \n\nTherefore, the number of different made-up words is \n\n$$\n\\begin{aligned}{}_{5}{P}_{3} & =\\frac{5!}{(5-3)!} \\\\  & =\\frac{5!}{2!} \\\\  & =\\frac{5\\cdot 4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =5\\cdot 4\\cdot 3 \\\\  & =60.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247871 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5242bbb8-44fc-568e-8ae8-a18d39d935d0" :answer/type {:db/ident :answer.type/math} :answer/value "57\\,120" :db/id #edb/ref 17592186247873} {:answer/id #uuid "e4f14495-f832-59b1-8aeb-2ef8046ca381" :answer/type {:db/ident :answer.type/math} :answer/value "92\\,845" :db/id #edb/ref 17592186247874} {:answer/id #uuid "e4a1c459-0312-589c-8494-1d5f96a3b282" :answer/type {:db/ident :answer.type/math} :answer/value "358\\,800" :db/id #edb/ref 17592186247875} {:answer/id #uuid "e27f2898-adc1-5414-9ce1-cfe6371bb496" :answer/type {:db/ident :answer.type/math} :answer/value "303\\,600" :db/id #edb/ref 17592186247876} {:answer/id #uuid "4a2ae9dd-b223-5fb2-8c0e-62da77ed80d8" :answer/type {:db/ident :answer.type/math} :answer/value "143\\,640" :db/id #edb/ref 17592186247877}] :answer-field/correct {:answer/id #uuid "4a2ae9dd-b223-5fb2-8c0e-62da77ed80d8" :answer/type {:db/ident :answer.type/math} :answer/value "143\\,640" :db/id #edb/ref 17592186247877} :answer-field/id #uuid "42ca2a1f-6a85-5f29-88e4-c2c40e22b88b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247872}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e9ac24cf-80cd-55e7-b755-f13eb4a7da38" :question/is-example false :question/math-academy-id "q-84987" :question/problem "How many made-up $4$-letter words can be made using $21$ consonants, where each consonant cannot appear in the word more than once?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $21$ consonants, so $n=21.$ We want to select $4$ of those consonants to make-up a $4$-letter word, so we have $r=4.$\n\nTherefore, the number of different made-up words is\n\n$$\n\\begin{aligned}{}_{21}{P}_{4} & =\\frac{21!}{(21-4)!} \\\\  & =\\frac{21!}{17!} \\\\  & =\\frac{21\\cdot 20\\cdot 19\\cdot 18\\cdot \\cancel{17!}}{\\cancel{17!}} \\\\  & =21\\cdot 20\\cdot 19\\cdot 18 \\\\  & =143\\,640.\\end{aligned}\n$$"}]}
