9533629 true] [17592186242802 1089 "q-48902" 13194139533629 true] [17592186242802 1091 #edb/ref 17592186045463 13194139533629 true] [17592186242802 1100 "The growth rate, $G(t)$, of the number of bacteria in a culture can be modeled by the function $G(t)=100\\cdot {2}^{0.5t}$, where $t$ is the time, in hours, since a sample of bacteria was placed in a Petri dish.  What will be the growth rate of the bacteria after $6$ hours?" 13194139533629 true] [17592186242802 1113 #uuid "6272ab92-0dde-5f83-9c42-f6a326bcfe0f" 13194139533629 true] [17592186242802 1138 false 13194139533629 true] [17592186242802 1145 "The function $G(t)$ models the growth rate for the bacteria $t$ hours since the sample was put in the Petri dish.\n\nThus, the growth rate of the bacteria culture after $6$ hours is\n\n$$\n\\begin{aligned}G(6) & =100\\cdot {2}^{0.5(6)} \\\\  & =100\\cdot {2}^{3} \\\\  & =100\\cdot 8 \\\\  & =800.\\end{aligned}\n$$\n\nTherefore, the growth rate of the bacteria is $800$ bacteria per hour." 13194139533629 true] [17592186242803 1000 #edb/ref 17592186242804 13194139533629 true] [17592186242803 1000 #edb/ref 17592186242805 13194139533629 true] [17592186242803 1000 #edb/ref 17592186242806 13194139533629 true] [17592186242803 1000 #edb/ref 17592186242807 13194139533629 true] [17592186242803 1000 #edb/ref 17592186242808 13194139533629 true] [17592186242803 1040 #edb/ref 17592186045450 13194139533629 true] [17592186242803 1041 "selection" 13194139533629 true] [17592186242803 1104 #edb/ref 17592186242806 13194139533629 true] [17592186242803 1110 #uuid "c12405c7-ee47-521c-8a72-67068921111a" 13194139533629 true] [17592186242804 1034 "$900$ bacteria per hour" 13194139533629 true] [17592186242804 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242804 1111 #uuid "ca05b618-dfad-58d4-9bc2-1b78bb710962" 13194139533629 true] [17592186242805 1034 "$100\\cdot {2}^{6}$ bacteria per hour" 13194139533629 true] [17592186242805 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242805 1111 #uuid "1726b60e-7c2c-5476-aa9d-984c054238f8" 13194139533629 true] [17592186242806 1034 "$800$ bacteria per hour" 13194139533629 true] [17592186242806 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242806 1111 #uuid "a0a9f4ef-9794-517f-8c21-aa32ce7b081e" 13194139533629 true] [17592186242807 1034 "$600$ bacteria per hour" 13194139533629 true] [17592186242807 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242807 1111 #uuid "cf1edb86-7e8a-50db-a8fa-ab13152e467a" 13194139533629 true] [17592186242808 1034 "$700$ bacteria per hour" 13194139533629 true] [17592186242808 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242808 1111 #uuid "b1a9a7e6-4158-5aaf-b9f5-c4947d0d168e" 13194139533629 true] [17592186242809 1017 #edb/ref 17592186242810 13194139533629 true] [17592186242809 1089 "q-48914" 13194139533629 true] [17592186242809 1091 #edb/ref 17592186045465 13194139533629 true] [17592186242809 1100 "The birth rate of a herd of elephants in a region in Africa is modeled by the function  $B(t)=500\\cdot {2}^{0.125t}$ while the rate of death is modeled by $D(t)=400\\cdot {3}^{0.125t}.$ In both cases, $t$ represents the number of years since $1990.$  \n\nWhat was the rate of change of the elephant population in that region in $1998?$" 13194139533629 true] [17592186242809 1113 #uuid "6be9d85b-4bff-5550-ab8a-64c0eeb04a36" 13194139533629 true] [17592186242809 1138 false 13194139533629 true] [17592186242809 1145 "The  rate of change in the number of elephants  $t$ years since $1990$ is equal to the difference between the two given rates, that is\n\n$$\nB(t)-D(t).\n$$\n\nAs $1998$ is $8$ years after $1990$, we have $t=8.$  Hence, the  rate of change in the elephant population in that region in $1998$ was \n\n$$\n\\begin{aligned}B(8)-D(8) & =500\\cdot {2}^{0.125(8)}-400\\cdot {3}^{0.125(8)} \\\\  & =500\\cdot 2-400\\cdot 3 \\\\  & =-200.\\end{aligned}\n$$\n\nTherefore, the rate of change in the elephant population was $-200$ elephants per year." 13194139533629 true] [17592186242810 1000 #edb/ref 17592186242811 13194139533629 true] [17592186242810 1000 #edb/ref 17592186242812 13194139533629 true] [17592186242810 1000 #edb/ref 17592186242813 13194139533629 true] [17592186242810 1000 #edb/ref 17592186242814 13194139533629 true] [17592186242810 1000 #edb/ref 17592186242815 13194139533629 true] [17592186242810 1040 #edb/ref 17592186045450 13194139533629 true] [17592186242810 1041 "selection" 13194139533629 true] [17592186242810 1104 #edb/ref 17592186242812 13194139533629 true] [17592186242810 1110 #uuid "8b8f2670-bb28-57ed-ad70-3f689e6286f6" 13194139533629 true] [17592186242811 1034 "$-94$ elephants per year" 13194139533629 true] [17592186242811 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242811 1111 #uuid "72f2967a-5ca3-5036-ba65-edb807d3f829" 13194139533629 true] [17592186242812 1034 "$-200$ elephants per year" 13194139533629 true] [17592186242812 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242812 1111 #uuid "83708dce-bca1-51e5-a9b6-ac5e6d385956" 13194139533629 true] [17592186242813 1034 "$240$ elephants per year" 13194139533629 true] [17592186242813 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242813 1111 #uuid "b76ed14c-7b5a-5f9a-bcba-df8e22c676f4" 13194139533629 true] [17592186242814 1034 "$-220$ elephants per year" 13194139533629 true] [17592186242814 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242814 1111 #uuid "8476f099-5a13-502e-9148-09ec33c52a9b" 13194139533629 true] [17592186242815 1034 "$420$ elephants per year" 13194139533629 true] [17592186242815 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242815 1111 #uuid "2bd12e8c-9149-52e2-8de7-d0b9163998fc" 13194139533629 true] [17592186242816 1017 #edb/ref 17592186242817 13194139533629 true] [17592186242816 1089 "q-72092" 13194139533629 true] [17592186242816 1091 #edb/ref 17592186045463 13194139533629 true] [17592186242816 1100 "A bank exchanges $D$ dollars for $E(D)$ euros. What are the units of $\\frac{\\text{d}E}{\\text{d}D}?$" 13194139533629 true] [17592186242816 1113 #uuid "b7bd1f02-4969-5a75-a910-139f379407d5" 13194139533629 true] [17592186242816 1138 false 13194139533629 true] [17592186242816 1145 "We have that the currency $E(D)$ is measured in euros and the currency $D$ is measured in dollars. \n\n$$\n\\begin{aligned}E(D): & \\text{euros} \\\\ D: & \\text{dollars}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}E}{\\text{d}D}$ measures a change in $E(D)$ over a change in $D.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}E}{\\text{d}D}: & \\frac{\\text{euros}}{\\text{dollars}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}E}{\\text{d}D}$ is measured in \"euros per dollar\"." 13194139533629 true] [17592186242817 1000 #edb/ref 17592186242818 13194139533629 true] [17592186242817 1000 #edb/ref 17592186242819 13194139533629 true] [17592186242817 1000 #edb/ref 17592186242820 13194139533629 true] [17592186242817 1000 #edb/ref 17592186242821 13194139533629 true] [17592186242817 1000 #edb/ref 17592186242822 13194139533629 true] [17592186242817 1040 #edb/ref 17592186045450 13194139533629 true] [17592186242817 1041 "selection" 13194139533629 true] [17592186242817 1104 #edb/ref 17592186242821 13194139533629 true] [17592186242817 1110 #uuid "4f2a632e-2c45-574c-90be-a380f5f91b61" 13194139533629 true] [17592186242818 1034 "euros" 13194139533629 true] [17592186242818 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242818 1111 #uuid "3eac346a-a06a-5869-88e7-54f432a6c94e" 13194139533629 true] [17592186242819 1034 "dollars per euro squared" 13194139533629 true] [17592186242819 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242819 1111 #uuid "d5ff81dd-4296-5cb2-bcfc-97e955b6b296" 13194139533629 true] [17592186242820 1034 "dollars per euro" 13194139533629 true] [17592186242820 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242820 1111 #uuid "e545fdcb-87b0-5f1f-9c7c-372e91a7fa6f" 13194139533629 true] [17592186242821 1034 "euros per dollar" 13194139533629 true] [17592186242821 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242821 1111 #uuid "ead2afeb-061f-5c0a-951b-914b3b52d9a3" 13194139533629 true] [17592186242822 1034 "dollars" 13194139533629 true] [17592186242822 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242822 1111 #uuid "664eec34-c3d0-58a2-a38f-239a0945eed3" 13194139533629 true] [17592186242823 1017 #edb/ref 17592186242824 13194139533629 true] [17592186242823 1089 "q-72099" 13194139533629 true] [17592186242823 1091 #edb/ref 17592186045464 13194139533629 true] [17592186242823 1100 "Consider a sphere such that its volume $V$ can vary. What is the best interpretation of ${r}^{′}(V)$ if $r$ is the length of the radius of the sphere?" 13194139533629 true] [17592186242823 1113 #uuid "fdf680e3-0d0f-525f-8e37-64c868afcaa6" 13194139533629 true] [17592186242823 1138 false 13194139533629 true] [17592186242823 1145 "The function $r(V)$ gives the length of the radius of a sphere with volume $V.$ So,\n\n$$\n{r}^{′}(V)=\\frac{\\text{d}r}{\\text{d}V}=\\frac{\\text{Change in }r}{\\text{Change in }V}.\n$$\n\nTherefore, ${r}^{′}(V)$ is the rate at which the radius changes as the volume changes." 13194139533629 true] [17592186242824 1000 #edb/ref 17592186242825 13194139533629 true] [17592186242824 1000 #edb/ref 17592186242826 13194139533629 true] [17592186242824 1000 #edb/ref 17592186242827 13194139533629 true] [17592186242824 1000 #edb/ref 17592186242828 13194139533629 true] [17592186242824 1000 #edb/ref 17592186242829 13194139533629 true] [17592186242824 1040 #edb/ref 17592186045450 13194139533629 true] [17592186242824 1041 "selection" 13194139533629 true] [17592186242824 1104 #edb/ref 17592186242825 13194139533629 true] [17592186242824 1110 #uuid "e4e574c1-2c4b-595a-9385-86a71ea2e758" 13194139533629 true] [17592186242825 1034 "The rate at which the radius changes as the volume changes" 13194139533629 true] [17592186242825 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242825 1111 #uuid "93be0bc2-fbb6-54d3-969a-0f2b07723d3b" 13194139533629 true] [17592186242826 1034 "The rate at which the volume changes as the radius changes" 13194139533629 true] [17592186242826 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242826 1111 #uuid "d77745c4-ef36-5a80-9b4b-fd8d3c554f25" 13194139533629 true] [17592186242827 1034 "The rate at which the surface area changes as the radius changes" 13194139533629 true] [17592186242827 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242827 1111 #uuid "8c6d0b96-336f-5547-97a1-b57ff18b6a43" 13194139533629 true] [17592186242828 1034 "The rate at which the volume changes as the surface area changes" 13194139533629 true] [17592186242828 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242828 1111 #uuid "d9f50b01-806b-50fe-ba97-84e4e143d524" 13194139533629 true] [17592186242829 1034 "The rate at which the radius changes as the surface area changes" 13194139533629 true] [17592186242829 1103 #edb/ref 17592186045454 13194139533629 true] [17592186242829 1111 #uuid "f01c4c53-b36d-5c55-bc5d-400848923046" 13194139533629 true] [17592186242830 1017 #edb/ref 17592186242831 13194139533629 true] [17592186242830 1089 "q-72104" 13194139533629 true] [17592186242830 1091 #edb/ref 17592186045465 13194139533629 true] [17592186242830 1100 "Consider a regular pentagon such that the length $s$ of each side varies. What is the best interpretation of ${P}^{′}(s)$ if $P$ is the perimeter of the pentagon?" 13194139533629 true] [17592186242830 1113 #uuid "a33f008b-7cdb-5e9d-9988-28f511990924" 13194139533629 true] [17592186242830 1138 false 13194139533629 true] [17592186242830 1145 "The function $P(s)$ gives the perimeter of a pentagon with side $s.$ So,\n\n$$\n{P}^{′}(s)=\\frac{\\text{d}P}{\\text{d}s}=\\frac{\\text{Change in }P}{\\text{Change in }s}.\n$$\n\nTherefore, ${P}^{′}(s)$ is the rate at which the perimeter changes as each side changes." 13