tion"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81"] :knowledge-point/questions ["q-48688"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48709/selection/9ddad8ddb89b412281151969e38a86be2d67fb01a5ff7d3c72eb84e9ec8d76df" :answer/id #uuid "b68b01f1-43c1-56be-b56c-d0b60bca9c31" :answer/type :answer.type/text :answer/value "$10$ hours after launching, the number of visitors decreased by a total of $1\\,500$ visitors" :db/ensure [:answer/validate]} {:db/id "q-48709/selection/77a38c3e39488db7b86596ab8fa345887097f137f0d4736f5c2eec238a92db62" :answer/id #uuid "55e03b7f-4414-54d0-b71c-6553b529d974" :answer/type :answer.type/text :answer/value "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour" :db/ensure [:answer/validate]} {:db/id "q-48709/selection/898136390a0c268ef5cb48d89ccdbe4cb3b9565fac40018226f02b02f2a8275f" :answer/id #uuid "841b99eb-cf15-582c-97da-9e223d2c538a" :answer/type :answer.type/text :answer/value "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour" :db/ensure [:answer/validate]} {:db/id "q-48709/selection/4510c0a2995a4f0ee95fc952d244834fa64883023de4c860a51a880970253971" :answer/id #uuid "79e31126-c64b-55ab-8486-1ba7ff2737ff" :answer/type :answer.type/text :answer/value "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors" :db/ensure [:answer/validate]} {:db/id "q-48709/selection/a9992791cc059f858c068de45edb32d23031ec1704fe62ff1825a226a4e4de93" :answer/id #uuid "65abbacb-17ed-501e-9abb-0ad41fce9186" :answer/type :answer.type/text :answer/value "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour" :db/ensure [:answer/validate]} {:db/id "q-48709/selection" :answer-field/id #uuid "fc44fb7a-ed51-5c60-bb1c-b037823cb5f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48709/selection/77a38c3e39488db7b86596ab8fa345887097f137f0d4736f5c2eec238a92db62" :answer-field/choices ["q-48709/selection/9ddad8ddb89b412281151969e38a86be2d67fb01a5ff7d3c72eb84e9ec8d76df" "q-48709/selection/77a38c3e39488db7b86596ab8fa345887097f137f0d4736f5c2eec238a92db62" "q-48709/selection/898136390a0c268ef5cb48d89ccdbe4cb3b9565fac40018226f02b02f2a8275f" "q-48709/selection/4510c0a2995a4f0ee95fc952d244834fa64883023de4c860a51a880970253971" "q-48709/selection/a9992791cc059f858c068de45edb32d23031ec1704fe62ff1825a226a4e4de93"] :db/ensure [:answer-field/validate]} {:db/id "q-48709" :question/id #uuid "ae6a6d2c-9c8c-5d28-9747-f12d076513b4" :question/math-academy-id "q-48709" :question/is-example false :question/problem "The function $V(t)$ models the number of visitors, in thousands, to a new website, $t$ hours after the website's launch. What is the best interpretation of the statement below?\n\n$\\,$ *The slope of the tangent line to the graph of $V(t)$ at $t=10$ is equal to $1.5.$*" :question/worked-solution "The slope of the line tangent to the graph of $V(t)$ at $t=10$ gives the derivative of $V(t)$ at $t=10.$ So, we have that\n\n$$\n{V}^{′}(10)=1.5.\n$$\n\nWe can interpret the above statement as\n\n$\\,$ *$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour.*" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48709/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2451a654-2255-5867-871d-54340dfeff81"] :knowledge-point/questions ["q-48709"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48691/selection/5b21e39d112cefa063c3cfaf4be0622d66de3d1e86c8b7b3be87209933999e02" :answer/id #uuid "0573ab4c-9065-5fe3-8572-e749666f737e" :answer/type :answer.type/text :answer/value "When the price of lemonade equals $50$ cents, the amount sold increases at a rate of $4$ liters per dollar" :db/ensure [:answer/validate]} {:db/id "q-48691/selection/96a66a