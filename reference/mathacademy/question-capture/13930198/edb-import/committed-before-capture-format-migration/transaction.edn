[:answer/validate]} {:db/id "q-112381/selection/b0305721f1adb5101e07ecb227987d79f860dac46f7a037525781a9c74509618" :answer/id #uuid "3c645474-0ee1-5e40-8a2c-045be0f0c6de" :answer/type :answer.type/text :answer/value "$0.311$ muons per microsecond" :db/ensure [:answer/validate]} {:db/id "q-112381/selection/611278f3c8725c39def6980b9c030c06667cf03ac4e474f83d135f53fd7e202b" :answer/id #uuid "8b6fc2a1-6cb1-5bad-972f-1a7cef7b6c0c" :answer/type :answer.type/text :answer/value "$0.346$ muons per microsecond" :db/ensure [:answer/validate]} {:db/id "q-112381/selection/06d64e6899a5203c5428f4e38dbfe2ae5e68c60c7f957c76d54007952c086c87" :answer/id #uuid "b6815bf6-c5f8-51a8-92c1-d4a939c88360" :answer/type :answer.type/text :answer/value "$0.736$ muons per microsecond" :db/ensure [:answer/validate]} {:db/id "q-112381/selection" :answer-field/id #uuid "2f3adfba-33de-50ae-a048-a75334486e54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112381/selection/06d64e6899a5203c5428f4e38dbfe2ae5e68c60c7f957c76d54007952c086c87" :answer-field/choices ["q-112381/selection/fafa54af0cf70fc3c2db1deceb7f55fa6f5ad674ad6921057a2e2819ac709036" "q-112381/selection/e90a289a97d62e42848651b1aaac72e2c67878eee0d002a68fc76ff88be426f1" "q-112381/selection/b0305721f1adb5101e07ecb227987d79f860dac46f7a037525781a9c74509618" "q-112381/selection/611278f3c8725c39def6980b9c030c06667cf03ac4e474f83d135f53fd7e202b" "q-112381/selection/06d64e6899a5203c5428f4e38dbfe2ae5e68c60c7f957c76d54007952c086c87"] :db/ensure [:answer-field/validate]} {:db/id "q-112381" :question/id #uuid "7487c467-8c5c-52ae-b53d-e72eead10381" :question/math-academy-id "q-112381" :question/is-example false :question/problem "The decay rate $M$ of muons in a beam traveling at high speed can be modeled by the function $M(t)=2\\cdot {e}^{-2t},$ where $t$ is the time, in microseconds, since observations started. What will be the decay rate of the muons after $0.5$ microseconds? Round your answer to three decimal places." :question/worked-solution "The function $M(t)$ models the decay rate for the particles $t$ microseconds since observations started.\n\nThus, the decay rate of the muons after $0.5$ microseconds is\n\n$$\n\\begin{aligned}M(0.5) & =2\\cdot {e}^{-2(0.5)} \\\\  & =2\\cdot {e}^{-1} \\\\  & ≈0.736.\\end{aligned}\n$$\n\nTherefore, the decay rate of the particles is $0.736$ muons per microsecond." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112381/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-112381"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112383/selection/6746351a4b164f59b98807af62afb5153f0015652e0d41302adc777420e6a5a2" :answer/id #uuid "80d0727c-d697-51f6-a221-b671f6b60ee5" :answer/type :answer.type/text :answer/value "$4$ percent per hour" :db/ensure [:answer/validate]} {:db/id "q-112383/selection/d2e6cb616f4a55e741a0a6b37a066f75659c1e47a285ea944fbcbf394c346071" :answer/id #uuid "46578e61-27e6-5678-b460-e7ff8dab9fb0" :answer/type :answer.type/text :answer/value "$40$ percent per hour" :db/ensure [:answer/validate]} {:db/id "q-112383/selection/c1fd8dfe8965e74187a151a32a453adc226c1d7ca268fc20461c89065db4c809" :answer/id #uuid "2a4d5967-cac6-5cb1-b155-8ef99342a97d" :answer/type :answer.type/text :answer/value "$10$ percent per hour" :db/ensure [:answer/validate]} {:db/id "q-112383/selection/8be9da2c9fab2b9818034623f1068cae131b5d3a1cc5169c6c863585995ef814" :answer/id #uuid "8f227591-2d70-5edc-b3a8-8d4e41fd1ba0" :answer/type :answer.type/text :answer/value "$2$ percent per hour" :db/ensure [:answer/validate]} {:db/id "q-112383/selection/94f60439aa1679e1fe915074f623015afdc090d0992299ee374d329d5d43f7a2" :answer/id #uuid "78ed3e20-2e42-5b65-9e73-dd33c8efb962" :answer/type :answer.type/text :answer/value "$20$ percent per hour" :db/ensure [:answer/validate]} {:db/id "q-112383/selection" :answer-field/id #uuid "224f580d-b61d-5dc1-9b8b-cea24b724140" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112383/selection/94f60439aa1679e1fe915074f623015afdc090d0992299ee374d329d5d43f7a2" :answer-field/choices ["q-112383/selection/6746351a4b164f59b98807af62afb5153f0015652e0d41302adc777420e6a5a2" "q-112383/selection/d2e6cb616f4a55e741a0a6b37a066f75659c1e47a285ea944fbcbf394c346071" "q-112383/selection/c1fd8dfe8965e74187a151a32a453adc226c1d7ca268fc20461c89065db4c809" "q-112383/selection/8be9da2c9fab2b9818034623f1068cae131b5d3a1cc5169c6c863585995ef814" "q-112383/selection/94f60439aa1679e1fe915074f623015afdc090d0992299ee374d329d5d43f7a2"] :db/ensure [:answer-field/validate]} {:db/id "q-112383" :question/id #uuid "7a8ec250-15a4-5b84-beef-886aee8058ea" :question/math-academy-id "q-112383" :question/is-example false :question/problem "After charging the battery of a PC, the percentage of charge decreases at a rate of $c(t)=100\\cdot {5}^{-0.2t}$ percent per hour, where $t$ is the time, in hours, since the battery had completed its charge. What will be the rate of decrease after $5$ hours?" :question/worked-solution "Since we want to determine the rate of decrease in the amount of charge after $5$ hours, we have $t=5.$\n\nThus, the rate of decrease of the amount of charge after $5$ hours will be\n\n$$\n\\begin{aligned}c(5) & =100\\cdot {5}^{-0.2(5)} \\\\  & =100\\cdot {5}^{-1} \\\\  & =\\frac{100}{5} \\\\  & =20.\\end{aligned}\n$$\n\nTherefore, the rate of decrease will be $20$ percent per hour." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112383/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-112383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48902/selection/26ec609bb8e5c31190eede393f18904ef7c5c51edd73e9fd4b8c998cc2247ebd" :answer/id #uuid "ca05b618-dfad-58d4-9bc2-1b78bb710962" :answer/type :answer.type/text :answer/value "$900$ bacteria per hour" :db/ensure [:answer/validate]} {:db/id "q-48902/selection/2e78cade1e848f5dd2e30cfa9a9fbd3c18319af198c051bf709a898b0d22e936" :answer/id #uuid "1726b60e-7c2c-5476-aa9d-984c054238f8" :answer/type :answer.type/text :answer/value "$100\\cdot {2}^{6}$ bacteria per hour" :db/ensure [:answer/validate]} {:db/id "q-48902/selection/eaf0542dae2f74f5d5429b14667174d272a7d92d952ec32c7a9fa6f1b9354d41" :answer/id #uuid "b1a9a7e6-4158-5aaf-b9f5-c4947d0d168e" :answer/type :answer.type/text :answer/value "$700$ bacteria per hour" :db/ensure [:answer/validate]} {:db/id "q-48902/selection/be865e3914e545ef5379e1e1c71c20b4e4d26c1a2a2cacd84f946ebdbbb94d8e" :answer/id #uuid "a0a9f4ef-9794-517f-8c21-aa32ce7b081e" :answer/type :answer.type/text :answer/value "$800$ bacteria per hour" :db/ensure [:answer/validate]} {:db/id "q-48902/selection/cff455d45864d26931f8905b0e5d4d8634cb0773f104543a30dea3961b8e9e36" :answer/id #uuid "cf1edb86-7e8a-50db-a8fa-ab13152e467a" :answer/type :answer.type/text :answer/value "$600$ bacteria per hour" :db/ensure [:answer/validate]} {:db/id "q-48902/selection" :answer-field/id #uuid "c12405c7-ee47-521c-8a72-67068921111a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48902/selection/be865e3914e545ef5379e1e1c71c20b4e4d26c1a2a2cacd84f946ebdbbb94d8e" :answer-field/choices ["q-48902/selection/26ec609bb8e5c31190eede393f18904ef7c5c51edd73e9fd4b8c998cc2247ebd" "q-48902/selection/2e78cade1e848f5dd2e30cfa9a9fbd3c18319af198c051bf709a898b0d22e936" "q-48902/selection/eaf0542dae2f74f5d5429b14667174d272a7d92d952ec32c7a9fa6f1b9354d41" "q-48902/selection/be865e3914e545ef5379e1e1c71c20b4e4d26c1a2a2cacd84f946ebdbbb94d8e" "q-48902/selection/cff455d45864d26931f8905b0e5d4d8634cb0773f104543a30dea3961b8e9e36"] :db/ensure [:answer-field/validate]} {:db/id "q-48902" :question/id #uuid "6272ab92-0dde-5f83-9c42-f6a326bcfe0f" :question/math-academy-id "q-48902" :question/is-example false :question/problem "The growth rate, $G(t)$, of the number of bacteria in a culture can be modeled by the function $G(t)=100\\cdot {2}^{0.5t}$, where $t$ is the time, in hours, since a sample of bacteria was placed in a Petri dish.  What will be the growth rate of the bacteria after $6$ hours?" :question/worked-solution "The function $G(t)$ models the growth rate for the bacteria $t$ hours since the sample was put in the Petri dish.\n\nThus, the growth rate of the bacteria culture after $6$ hours is\n\n$$\n\\begin{aligned}G(6) & =100\\cdot {2}^{0.5(6)} \\\\  & =100\\cdot {2}^{3} \\\\  & =100\\cdot 8 \\\\  & =800.\\end{aligned}\n$$\n\nTherefore, the growth rate of the bacteria is $800$ bacteria per hour." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-48902/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-48902"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48914/selection/033a9efbe2e2d30cf24c448094fae8462c0935776f5ecbc1a8b423c0477bf10a" :answer/id #uuid "72f2967a-5ca3-5036-ba65-edb807d3f829" :answer/type :answer.type/text :answer/value "$-94$ elephants per year" :db/ensure [:answer/validate]} {:db/id "q-48914/selection/9adb6c5b8451b663123b3cedc415c15cabcd72f36f0e875600cc6cbf8a07149a" :answer/id #uuid "8476f099-5a13-502e-9148-09ec33c52a9b" :answer/type :answer.type/text :answer/value "$-220$ elephants per year" :db/ensure [:answer/validate]} {:db/id "q-48914/selection/452d8c7940f7082cac4d5bb8e89cec27c1bac2f969533f810962e716903bbf1b" :answer/id #uuid "83708dce-bca1-51e5-a9b6-ac5e6d385956" :answer/type :answer.type/text :answer/value "$-200$ elephants per year" :db/ensure [:answer/validate]} {:db/id "q-48914/selection/cd059fe51c9406d1e5dbc1170158ca13fef844457279acbff5128558239437f6" :answer/id #uuid "2bd12e8c-9149-52e2-8de7-d0b9163998fc" :answer/type :answer.type/text :answer/value "$420$ elephants per year" :db/ensure [:answer/validate]} {:db/id "q-48914/selection/9024944517a68eb8d645b01730d61c500ba20b57f9f205577d843acdccb4a7e1" :answer/id #uuid "b76ed14c-7b5a-5f9a-bcba-df8e22c676f4" :answer/type :answer.type/text :answer/value "$240$ elephants per year" :db/ensure [:answer/validate]} {:db/id "q-48914/selection" :answer-field/id #uuid "8b8f2670-bb28-57ed-ad70-3f689e6286f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48914/selection/452d8c7940f7082cac4d5bb8e89cec27c1bac2f969533f810962e716903bbf1b" :answer-field/choices ["q-48914/selection/033a9efbe2e2d30cf24c448094fae8462c0935776f5ecbc1a8b423c0477bf10a" "q-48914/selection/9adb6c5b8451b663123b3cedc415c15cabcd72f36f0e875600cc6cbf8a07149a" "q-48914/selection/452d8c7940f7082cac4d5bb8e89cec27c1bac2f969533f810962e716903bbf1b" "q-48914/selection/cd059fe51c9406d1e5dbc1170158ca13fef844457279acbff5128558239437f6" "q-48914/selection/9024944517a68eb8d645b01730d61c500ba20b57f9f205577d843acdccb4a7e1"] :db/ensure [:answer-field/validate]} {:db/id "q-48914" :question/id #uuid "6be9d85b-4bff-5550-ab8a-64c0eeb04a36" :question/math-academy-id "q-48914" :question/is-example false :question/problem "The birth rate of a herd of elephants in a region in Africa is modeled by the function  $B(t)=500\\cdot {2}^{0.125t}$ while the rate of death is modeled by $D(t)=400\\cdot {3}^{0.125t}.$ In both cases, $t$ represents the number of years since $1990.$  \n\nWhat was the rate of change of the elephant population in that region in $1998?$" :question/worked-solution "The  rate of change in the number of elephants  $t$ years since $1990$ is equal to the difference between the two given rates, that is\n\n$$\nB(t)-D(t).\n$$\n\nAs $1998$ is $8$ years after $1990$, we have $t=8.$  Hence, the  rate of change in the elephant population in that region in $1998$ was \n\n$$\n\\begin{aligned}B(8)-D(8) & =500\\cdot {2}^{0.125(8)}-400\\cdot {3}^{0.125(8)} \\\\  & =500\\cdot 2-400\\cdot 3 \\\\  & =-200.\\end{aligned}\n$$\n\nTherefore, the rate of change in the elephant population was $-200$ elephants per year." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48914/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-48914"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112507/selection/3fbb6fb674cb90bfcd4edca74ce590c5992c0e522331297549680ff6b0dd51ee" :answer/id #uuid "b768dec3-61b6-50d3-91c6-fba939ea8138" :answer/type :answer.type/text :answer/value "$120$ cars per day" :db/ensure [:answer/validate]} {:db/id "q-112507/selection/4d424bad59527360c14a5434640f87b6bb503840c3f525ba3a8ed39bd3b898e3" :answer/id #uuid "a16de123-27ad-566c-a3a7-01bdace48009" :answer/type :answer.type/text :answer/value "$140$ cars per day" :db/ensure [:answer/validate]} {:db/id "q-112507/selection/f41f6e2cd559774ed26a53c2634d6f1973a3d6b906a410ecb5c06d441ae1c944" :answer/id #uuid "c0698e01-e0db-5fec-9808-bbb3e13dd709" :answer/type :answer.type/text :answer/value "$162$ cars per day" :db/ensure [:answer/validate]} {:db/id "q-112507/selection/840d17be8b5feeb844297f65bf0ef6cc43fa80ca342c9298cd009cb919243f24" :answer/id #uuid "ee17553b-b1d7-54b4-b1dc-91f74258533f" :answer/type :answer.type/text :answer/value "$100$ cars per day" :db/ensure [:answer/validate]} {:db/id "q-112507/selection/e71a53c41477ff4b8545d2fd127b09035e922a4d5b639118a2c1eff9f2a99f29" :answer/id #uuid "0b3b2933-f9b2-5c2a-b258-cc5c785025b4" :answer/type :answer.type/text :answer/value "$125$ cars per day" :db/ensure [:answer/validate]} {:db/id "q-112507/selection" :answer-field/id #uuid "c06d622e-3b87-5d36-b691-d6ace7cf4eec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112507/selection/3fbb6fb674cb90bfcd4edca74ce590c5992c0e522331297549680ff6b0dd51ee" :answer-field/choices ["q-112507/selection/3fbb6fb674cb90bfcd4edca74ce590c5992c0e522331297549680ff6b0dd51ee" "q-112507/selection/4d424bad59527360c14a5434640f87b6bb503840c3f525ba3a8ed39bd3b898e3" "q-112507/selection/f41f6e2cd559774ed26a53c2634d6f1973a3d6b906a410ecb5c06d441ae1c944" "q-112507/selection/840d17be8b5feeb844297f65bf0ef6cc43fa80ca342c9298cd009cb919243f24" "q-112507/selection/e71a53c41477ff4b8545d2fd127b09035e922a4d5b639118a2c1eff9f2a99f29"] :db/ensure [:answer-field/validate]} {:db/id "q-112507" :question/id #uuid "ac818ad1-0395-53d8-9d76-66c7ed2e0c01" :question/math-academy-id "q-112507" :question/is-example false :question/problem "The rate $O$ of the orders a car factory receives can be modeled as $O(t)=100t{e}^{-0.1t}$ cars per day. The rate at which cars are completed can be modeled as $C(t)=50+10sin⁡(\\frac{2\\pi }{7}t)$ cars per day. In both cases, $t$ is the time, in days, since the launch of the new model. \n\nWhat is the rate of change in the number of cars under construction $28$ days after the model's launch? Assume that an ordered car goes into construction as soon as the factory receives its order. Round your answer to the nearest integer." :question/worked-solution "The rate of change of the number of cars under construction at time $t$ is equal to the order rate minus the completion rate, that is,\n\n$$\nO(t)-C(t).\n$$\n\nSubstituting $t=28,$ the rate of change in the number of cars under construction after $28$ days is\n\n$$\n\\begin{aligned}O(t)-C(t) & =100(28){e}^{-0.1(28)}-(50+10sin⁡(\\frac{2\\pi }{7}(28))) \\\\  & =100(28){e}^{-2.8}-50-10sin⁡(8\\pi ) \\\\  & =100(28){e}^{-2.8}-50 \\\\  & ≈120.\\end{aligned}\n$$\n\nTherefore, the rate of change in the number of cars in construction after $28$ days is $120$ cars per day." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112507/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000"] :knowledge-point/questions ["q-112507"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-72004"] :question/worked-solution "The function $N(t)$ gives the number of bacteria inside the dish after $t$ hours. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of bacteria is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $N(t)$ and $r(t)$ is ${N}^{′}(t)=r(t).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-112518/selection/736db422fed0ce953362ffc62d37b2763bee974119a950e308d9d2ca9fc49dcb" :answer/id #uuid "f99d5b65-75fc-5ec7-b3d7-d6f13be924c6" :answer/type :answer.type/math :answer/value "P(t)={r}^{′}(t)" :db/ensure [:answer/validate]} {:db/id "q-112518/selection/dc7ecd591afb0cf04577dcbb6206dff9dabb958d0de7546d93e2235eaa900b16" :answer/id #uuid "0280d6a3-b467-54c9-8024-31fec04a6152" :answer/type :answer.type/math :answer/value "P(t)={r}^{2}(t)" :db/ensure [:answer/validate]} {:db/id "q-112518/selection/e792e23f43724877d2a23bd3ea56dfc1ed1f20527afe922fcafb0271c64ddf6d" :answer/id #uuid "f0a7e8a3-2047-5cab-9a10-bf91c19b648f" :answer/type :answer.type/math :answer/value "{P}^{′}(t)=\\frac{1}{r(t)}" :db/ensure [:answer/validate]} {:db/id "q-112518/selection/5887ce46709cc32ce97b8768cdead750b97f70b2635fd66b4a45a9a987176e26" :answer/id #uuid "6e749ba7-2a95-53a1-beb1-c7ab58544a41" :answer/type :answer.type/math :answer/value "{P}^{′}(t)=r(t)" :db/ensure [:answer/validate]} {:db/id "q-112518/selection/ed0439737f8d6e41220ee04b3b02e419593203223334370dc659f10c5ee8594f" :answer/id #uuid "51b71153-c97e-54d7-bf25-9e57d03cf4ae" :answer/type :answer.type/math :answer/value "{P}^{′}(t)=1-r(t)" :db/ensure [:answer/validate]} {:db/id "q-112518/selection" :answer-field/id #uuid "82476130-1441-5ecb-9866-4e1520954c05" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112518/selection/5887ce46709cc32ce97b8768cdead750b97f70b2635fd66b4a45a9a987176e26" :answer-field/choices ["q-112518/selection/736db422fed0ce953362ffc62d37b2763bee974119a950e308d9d2ca9fc49dcb" "q-112518/selection/dc7ecd591afb0cf04577dcbb6206dff9dabb958d0de7546d93e2235eaa900b16" "q-112518/selection/e792e23f43724877d2a23bd3ea56dfc1ed1f20527afe922fcafb0271c64ddf6d" "q-112518/selection/5887ce46709cc32ce97b8768cdead750b97f70b2635fd66b4a45a9a987176e26" "q-112518/selection/ed0439737f8d6e41220ee04b3b02e419593203223334370dc659f10c5ee8594f"] :db/ensure [:answer-field/validate]} {:db/id "q-112518" :question/id #uuid "64fb28a9-2489-5d93-bbf0-bc7405527cc4" :question/math-academy-id "q-112518" :question/is-example false :question/problem "Liam, a farmer, is monitoring the construction of a fence by recording the following two numbers for different values of $t,$ where $t$ is the time, in hours, since he started his observations:\n\n- $P(t)$ - the number of panels in the fence.\n\n- $r(t)$ - the rate at which the number of panels in the fence increases.\n\nWhat is the relationship between $P(t)$ and $r(t)?$" :question/worked-solution "The function $P(t)$ gives the number of panels in the fence after $t$ hours. Then,\n\n$$\n{P}^{′}(t)=\\frac{\\text{d}P(t)}{\\text{d}t}=\\frac{\\text{Change in }P}{\\text{Change in }t}.\n$$\n\nThus, ${P}^{′}(t)$ gives the rate at which the number of panels increases at time $t$, which is the same as $r(t).$ Therefore, the relationship between $P(t)$ and $r(t)$ is ${P}^{′}(t)=r(t).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112518/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782"] :knowledge-point/questions ["q-112518"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72105/selection/890f4500fedd2d130da6e20c94820c523e374053bbb32d2efb9b5ec1b7419c2b" :answer/id #uuid "6bf74d08-0212-5e39-86b0-ec2bd8ad9960" :answer/type :answer.type/math :answer/value "{A}^{′}(t)=-r(t)" :db/ensure [:answer/validate]} {:db/id "q-72105/selection/aa8be076d5b7218f60b63077ddb99264c81faf0cf9671e344447eb2eb3bcbee5" :answer/id #uuid "3a5d70de-bd2d-5bd4-a865-b9309f43cf90" :answer/type :answer.type/math :answer/value "A(t)={r}^{′}(t)" :db/ensure [:answer/validate]} {:db/id "q-72105/selection/8761f12bf7139e5a06324b5abfd2c2284775284c6c277a6360895c517354cce0" :answer/id #uuid "d12164b8-9d2c-5d1a-ab61-631749bf75f4" :answer/type :answer.type/math :answer/value "A(t)=r(t)" :db/ensure [:answer/validate]} {:db/id "q-72105/selection/1d781a4e3ef2354b43f0bd90dd2edc5167363e7bbbffab4949cc51c65b83c8e8" :answer/id #uuid "b46f0f24-6d9e-549f-8848-f1663eacb939" :answer/type :answer.type/math :answer/value "A(t)=-{r}^{′}(t)" :db/ensure [:answer/validate]} {:db/id "q-72105/selection/baf66e18a95f5c3cafb1d6d9c2de81705d1852d0fed4f98fc8e72379b6bb9671" :answer/id #uuid "82809fdc-c24c-50c4-8813-dae75288d836" :answer/type :answer.type/math :answer/value "{A}^{′}(t)=r(t)" :db/ensure [:answer/validate]} {:db/id "q-72105/selection" :answer-field/id #uuid "4e91599e-df61-5bb8-93c0-39c95a687c88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72105/selection/baf66e18a95f5c3cafb1d6d9c2de81705d1852d0fed4f98fc8e72379b6bb9671" :answer-field/choices ["q-72105/selection/890f4500fedd2d130da6e20c94820c523e374053bbb32d2efb9b5ec1b7419c2b" "q-72105/selection/aa8be076d5b7218f60b63077ddb99264c81faf0cf9671e344447eb2eb3bcbee5" "q-72105/selection/8761f12bf7139e5a06324b5abfd2c2284775284c6c277a6360895c517354cce0" "q-72105/selection/1d781a4e3ef2354b43f0bd90dd2edc5167363e7bbbffab4949cc51c65b83c8e8" "q-72105/selection/baf66e18a95f5c3cafb1d6d9c2de81705d1852d0fed4f98fc8e72379b6bb9671"] :db/ensure [:answer-field/validate]} {:db/id "q-72105" :question/id #uuid "506715ad-75a6-5e80-881e-9c5f31214250" :question/math-academy-id "q-72105" :question/is-example false :question/problem "Douglas, a pilot, is flying a plane. The plane's control systems record two measurements for different values of $t,$ where $t$ is the time, in minutes, since take off. The two measurements are:\n\n- $A(t)$ - the altitude (height) of the plane\n\n- $r(t)$ the rate at which the altitude is increasing\n\nWhat is the relationship between $A(t)$ and $r(t)?$" :question/worked-solution "The function $A(t)$ gives the altitude of the plane after $t$ hours. Then,\n\n$$\n{A}^{′}(t)=\\frac{\\text{d}A(t)}{\\text{d}t}=\\frac{\\text{Change in }A}{\\text{Change in }t}.\n$$\n\nThus, ${A}^{′}(t)$ gives the rate at which the altitude is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $A(t)$ and $r(t)$ is ${A}^{′}(t)=r(t).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782"] :knowledge-point/questions ["q-72105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112522/selection/49d0331855d9e02da1968f0c75a27db1d15778a81dc40f7a2a9eeae49c6e46a9" :answer/id #uuid "c089b227-d3c4-5ac7-9391-50815157d2b7" :answer/type :answer.type/math :answer/value "N(t)=-O(t)-C(t)" :db/ensure [:answer/validate]} {:db/id "q-112522/selection/1f1e88e82147b669d28f6639cccb2cba0da76639062ca8fed1e2d0b8db94e86e" :answer/id #uuid "413b05fa-e342-53be-a5f8-83ea32577a9c" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=O(t)+C(t)" :db/ensure [:answer/validate]} {:db/id "q-112522/selection/ccda0787b809a0b27dd4f72c8f653964b86ce33e2adacaad0b21edbc4175f993" :answer/id #uuid "8c6cc255-9124-546e-b72f-4b07c8de0ac4" :answer/type :answer.type/math :answer/value "N(t)=O(t)-C(t)" :db/ensure [:answer/validate]} {:db/id "q-112522/selection/e4e3b78a6ef7fb365796a7536551c754754f29fee09da408b2a91fb41e1c4195" :answer/id #uuid "43dc12eb-2b95-5cba-b1ee-29e83088f68d" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=O(t)-C(t)" :db/ensure [:answer/validate]} {:db/id "q-112522/selection/c9cb198df88f7dbb0baf47c4d433ddc35fcbff2da0240d01182df89cf26cbd9d" :answer/id #uuid "7f8d77fd-2943-5937-912b-45ff4b1cdf58" :answer/type :answer.type/math :answer/value "N(t)=O(t)+C(t)" :db/ensure [:answer/validate]} {:db/id "q-112522/selection" :answer-field/id #uuid "acd7df3c-2bce-5ea3-88dc-2ed2ccb3ceef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112522/selection/e4e3b78a6ef7fb365796a7536551c754754f29fee09da408b2a91fb41e1c4195" :answer-field/choices ["q-112522/selection/49d0331855d9e02da1968f0c75a27db1d15778a81dc40f7a2a9eeae49c6e46a9" "q-112522/selection/1f1e88e82147b669d28f6639cccb2cba0da76639062ca8fed1e2d0b8db94e86e" "q-112522/selection/ccda0787b809a0b27dd4f72c8f653964b86ce33e2adacaad0b21edbc4175f993" "q-112522/selection/e4e3b78a6ef7fb365796a7536551c754754f29fee09da408b2a91fb41e1c4195" "q-112522/selection/c9cb198df88f7dbb0baf47c4d433ddc35fcbff2da0240d01182df89cf26cbd9d"] :db/ensure [:answer-field/validate]} {:db/id "q-112522" :question/id #uuid "73f18b8c-1751-5485-a092-111f7e091ec9" :question/math-academy-id "q-112522" :question/is-example false :question/problem "Oliver, the owner of a platform for chess players, uses the following three functions to model the daily number of users of the platform $t$ days after it was launched.\n\n- $N(t)$ - the number of users with an account\n\n- $O(t)$ - the rate at which new users open an account\n\n- $C(t)$ - the rate at which users cancel their account\n\nWhat is the relationship between the three functions above?" :question/worked-solution "The function $N(t)$ gives the number of users $t$ days after the platform is set up. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of users with an account changes $t$ days after opening.\n\nIn addition, we can compute the rate of change of the number of users at time $t$ by finding the difference between the open and cancel rates at time $t.$ That is,\n\n$$\n{N}^{′}(t)=O(t)-C(t).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112522/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782"] :knowledge-point/questions ["q-112522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112519/selection/f4e5a7fd4a8ec42c7fc97cf824293f16d6dc1d38aae8305147ae7de3b55c34a5" :answer/id #uuid "bd387453-1f0c-5d5b-9d55-26a3241283eb" :answer/type :answer.type/math :answer/value "N(t)=E(t)+L(t)" :db/ensure [:answer/validate]} {:db/id "q-112519/selection/fcf9ec9658ead9943c24075710c6cb52619a068411aa502e35653adc4931a13e" :answer/id #uuid "f4659473-5e7a-5d28-8400-3d980239e437" :answer/type :answer.type/math :answer/value "N(t)=E(t)-L(t)" :db/ensure [:answer/validate]} {:db/id "q-112519/selection/85534ba35bd93aa5111fbdae2eae6dbd7f78e0aa12f70dca62a1a9fdafff1379" :answer/id #uuid "b072e35d-02a9-578c-8c7c-e555852d3444" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)\\cdot L(t)" :db/ensure [:answer/validate]} {:db/id "q-112519/selection/2ad9eac0e7be610185a8cfc79e4463252d5a5b697e6dd3ca85df0faa4a9f5036" :answer/id #uuid "296f76fd-6319-56a4-aa83-ebed27df183c" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)+L(t)" :db/ensure [:answer/validate]} {:db/id "q-112519/selection/27cef8ede4e9a7e29d72e585012b26142ed30f5a54f43fc94787cbcc569ed248" :answer/id #uuid "0fd5d23b-7fd4-55e2-ab62-ded476aa5010" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)-L(t)" :db/ensure [:answer/validate]} {:db/id "q-112519/selection" :answer-field/id #uuid "69c35e22-e8c0-507c-8873-0d6151eb8169" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112519/selection/27cef8ede4e9a7e29d72e585012b26142ed30f5a54f43fc94787cbcc569ed248" :answer-field/choices ["q-112519/selection/f4e5a7fd4a8ec42c7fc97cf824293f16d6dc1d38aae8305147ae7de3b55c34a5" "q-112519/selection/fcf9ec9658ead9943c24075710c6cb52619a068411aa502e35653adc4931a13e" "q-112519/selection/85534ba35bd93aa5111fbdae2eae6dbd7f78e0aa12f70dca62a1a9fdafff1379" "q-112519/selection/2ad9eac0e7be610185a8cfc79e4463252d5a5b697e6dd3ca85df0faa4a9f5036" "q-112519/selection/27cef8ede4e9a7e29d72e585012b26142ed30f5a54f43fc94787cbcc569ed248"] :db/ensure [:answer-field/validate]} {:db/id "q-112519" :question/id #uuid "d7e1b45c-7d22-59a8-850d-03ed8a91f836" :question/math-academy-id "q-112519" :question/is-example false :question/problem "To measure the number of children visiting a playground, Noah uses the following three functions that model the hourly number of visitors to the playground $t$ hours after the playground is opened to the public.\n\n- $N(t)$ - the number of children inside the playground\n\n- $E(t)$ - the rate at which children enter the playground\n\n- $L(t)$ - the rate at which children leave the playground\n\nWhat is the relationship between the functions above?" :question/worked-solution "The function $N(t)$ gives the number of children inside the park $t$ minutes after opening. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of children inside the playground changes $t$ hours after opening.\n\nIn addition, we can compute the rate of change of the number of children inside the playground at time $t$ by finding the difference between the entry and exit rates at time $t.$ That is,\n\n$$\n{N}^{′}(t)=E(t)-L(t).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-112519/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782"] :knowledge-point/questions ["q-112519"] :db/ensure [:knowledge-point/validate]}]
