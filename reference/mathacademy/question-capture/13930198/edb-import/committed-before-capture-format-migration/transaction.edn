db/ensure [:answer-field/validate]} {:db/id "q-48685" :question/id #uuid "f8e8aeb3-9cec-5be3-983b-384590e62269" :question/math-academy-id "q-48685" :question/is-example false :question/problem "Consider a cube such that the length of each side $s$ varies. What is the best interpretation of ${V}^{′}(s)$ if $V$ is the volume of the cube?" :question/worked-solution "The function $V(s)$ gives the volume of a cube with side $s.$ So,\n\n$$\n{V}^{′}(s)=\\frac{\\text{d}V}{\\text{d}s}=\\frac{\\text{Change in }V}{\\text{Change in }s}.\n$$\n\nTherefore, ${V}^{′}(s)$ is the rate at which the volume changes as each side changes." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48685/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2"] :knowledge-point/questions ["q-48685"] :db/ensure [:knowledge-point/validate]} {:db/id "q-48688/selection/208ad016672e2b98e69b086aad5c46e3878f0e5cd398896245eab95d4a76e6c7" :answer/id #uuid "4de00de0-f6a6-5f5b-ad2f-9b0b63a1f867" :answer/type :answer.type/text :answer/value "$30$ seconds after the start of the journey, the distance traveled decreased at a rate of $10$ meters per second" :db/ensure [:answer/validate]} {:db/id "q-48688/selection/16ac811c32af835f4aa208ad5089c49b0256db158f310ce9527c6c67bf3f51a4" :answer/id #uuid "d493ce6b-b21b-5ba7-b4fc-4ba82cf9431f" :answer/type :answer.type/text :answer/value "The distance traveled increased at a constant rate of $3$ meters per second" :db/ensure [:answer/validate]} {:db/id "q-48688/selection/b0dc706320a895499a5cba0f3e55bdd44f80def4cdeb4465e07bc5976f713f06" :answer/id #uuid "71c660ad-dfa1-5767-a540-17834059be40" :answer/type :answer.type/text :answer/value "The distance traveled increased by $10$ meters during the first $30$ seconds" :db/ensure [:answer/validate]} {:db/id "q-48688/selection/2b4e7e8b73362cd5246a23dbcbd03be98f774e87deaad74af809a64614a912c2" :answer/id #uuid "ff9c7f5a-594e-59e3-9a9b-ee8e7804b