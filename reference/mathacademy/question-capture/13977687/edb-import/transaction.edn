7f6e99ce78d4454c80ab5f86a5beac40ad41013689d717e5707b4f346890/b39c125bf4c08f1a012fe9b2899ae81e762be167a5cc8bc4cfad7d2a72377635" "q-32595/selection/ma-v1/6d9c7f6e99ce78d4454c80ab5f86a5beac40ad41013689d717e5707b4f346890/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" "q-32595/selection/ma-v1/6d9c7f6e99ce78d4454c80ab5f86a5beac40ad41013689d717e5707b4f346890/04a84983d576665bfbfb320a6e35cbd365c3da4019dc70c3aa860fa57ab80c1f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-32595"] :question/problem "If $x=2\\sqrt{y}-\\frac{3}{\\sqrt{y}},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,9).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2\\sqrt{y}-\\frac{3}{\\sqrt{y}}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-3\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{\\sqrt{y}}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1/2}) \\\\  & =2\\cdot \\frac{1}{2}{y}^{-1/2}-3\\cdot (-\\frac{1}{2}{y}^{-3/2}) \\\\  & ={y}^{-1/2}+\\frac{3}{2}{y}^{-3/2} \\\\  & =\\frac{1}{\\sqrt{y}}+\\frac{3}{2\\sqrt{{y}^{3}}} \\\\  & =\\frac{1}{\\sqrt{y}}+\\frac{3}{2y\\sqrt{y}} \\\\  & =\\frac{2y+3}{2y\\sqrt{y}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{2y\\sqrt{y}}{2y+3}.\n$$\n\nFinally, substituting the point $(5,9),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,9)} & =\\frac{2(9)\\sqrt{9}}{2(9)+3}=\\frac{18}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32595/selection/ma-v1/6d9c7f6e99ce78d4454c80ab5f86a5beac40ad41013689d717e5707b4f346890"] :db/ensure [:question/validate]} {:db/id "q-341636/field-1/4c2a15e309d4bebe78069fe7d7563da2f15cec6ed6e122c62aeda8fb8e70d2c8" :answer/id #uuid "5a567409-0509-531d-9d9e-e5a94596563b" :answer/type :answer.type/math :answer/value "\\frac{1}{28}" :db/ensure [:answer/validate]} {:db/id "q-341636/field-1" :answer-field/id #uuid "0c11e239-c3af-5db3-a5b7-e9d39cb32a4b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341636/field-1/4c2a15e309d4bebe78069fe7d7563da2f15cec6ed6e122c62aeda8fb8e70d2c8" :answer-field/choices ["q-341636/field-1/4c2a15e309d4bebe78069fe7d7563da2f15cec6ed6e122c62aeda8fb8e70d2c8"] :db/ensure [:answer-field/validate]} {:db/id "q-341636" :question/id #uuid "1ddc71d8-aab5-5e88-9690-82c0e13ce162" :question/math-academy-id "q-341636" :question/problem "If $x=2{y}^{3}+{y}^{2},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(20,2).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{3}+{y}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{3})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =2(3{y}^{2})+2y \\\\  & =6{y}^{2}+2y\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{6{y}^{2}+2y}.\n$$\n\nFinally, substituting the point $(20,2),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(20,2)} & =\\frac{1}{6({2}^{2})+2(2)}=\\frac{1}{28}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341636/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-341636"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170190/selection/7c95f861ed53ea6aed8a339818745c49d93402da7feef4b9726b6f47cfaf74c2" :answer/id #uuid "f209abb2-cb22-58c2-a498-92e507cfd39e" :answer/type :answer.type/math