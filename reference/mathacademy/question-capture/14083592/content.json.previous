              "type": "math",
              "value": "\\frac{x+3}{7}=\\frac{y-2}{-9},\\,z=0"
            },
            {
              "type": "math",
              "value": "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11"
            },
            {
              "type": "math",
              "value": "\\frac{x-7}{-3}=z-11,\\,y=-9"
            },
            {
              "type": "math",
              "value": "\\frac{x-7}{-3}=\\frac{y+9}{2}=z-11"
            },
            {
              "type": "math",
              "value": "\\frac{x+7}{-3}=\\frac{y-9}{2},\\,z=-11"
            }
          ],
          "correct_value": "\\frac{x-7}{-3}=\\frac{y+9}{2},\\,z=11",
          "choices_complete": true,
          "correct_origin": "ma_successful_grade"
