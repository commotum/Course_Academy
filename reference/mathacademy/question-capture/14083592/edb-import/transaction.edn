tion/6212291d4065f582b5d19478e7e67d5d27c82c9b292fd8295ab2b8cf4e98ed8d" "q-33002/selection/52431ee537d432e1c2bcaaaf0ebbc9eca241ed9777eb11b48797ce27096b35fa" "q-33002/selection/1e706d46cc518137d1d18ac4f5b9119f3e0e735170609381bbe215e54e6946c6" "q-33002/selection/42679adca3157077d26f88c719c0076ec3195a045251bf2aabee0e891585c300" "q-33002/selection/274fdf7052189d8fa4ad454d0e87332c58a038f65778da1424bd3592551d71c7"] :db/ensure [:answer-field/validate]} {:db/id "q-33002" :question/id #uuid "6a7e46e0-4874-5c66-be65-068470819e10" :question/math-academy-id "q-33002" :question/problem "Consider the straight line with the canonical equation $\\frac{x-3}{5}=\\frac{y-1}{1}=\\frac{z+7}{-5}.$ Find the vector equation of the line." :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-3}{5}=\\frac{y-1}{1}=\\frac{z-(-7)}{-5},\n$$\n\nwe find that our line passes through the point $P(3,1,-7)$ and is parallel to $v=⟨5,1,-5⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}3 \\\\ 1 \\\\ -7\\end{aligned}]+t[\\begin{aligned}5 \\\\ 1 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33002/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85"] :knowledge-point/questions ["q-33002"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127078/selection/421ba3cf61c86c7d854403490925f53920cd3c015c12342698571d9a74aca2fd" :answer/id #uuid "0c11d256-9bba-5167-8b9f-06ba0594c678" :answer/type :answer.type/text :answer/value "None of the listed" 