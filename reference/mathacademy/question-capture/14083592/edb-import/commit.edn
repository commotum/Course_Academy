11t\\end{aligned}\n$$" 13194139536191 true] [17592186388093 1000 #edb/ref 17592186388094 13194139536191 true] [17592186388093 1000 #edb/ref 17592186388095 13194139536191 true] [17592186388093 1000 #edb/ref 17592186388096 13194139536191 true] [17592186388093 1000 #edb/ref 17592186388097 13194139536191 true] [17592186388093 1000 #edb/ref 17592186388098 13194139536191 true] [17592186388093 1040 #edb/ref 17592186045450 13194139536191 true] [17592186388093 1041 "selection" 13194139536191 true] [17592186388093 1104 #edb/ref 17592186388098 13194139536191 true] [17592186388093 1110 #uuid "a5c3b35b-4a76-54dc-a105-d752f09117c4" 13194139536191 true] [17592186388094 1034 "None of the listed" 13194139536191 true] [17592186388094 1103 #edb/ref 17592186045454 13194139536191 true] [17592186388094 1111 #uuid "0c11d256-9bba-5167-8b9f-06ba0594c678" 13194139536191 true] [17592186388095 1034 "{\\begin{aligned}x=10+7t \\\\ y=8+4t \\\\ z=-1+11t\\end{aligned}" 13194139536191 true] [17592186388095 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388095 1111 #uuid "8b67c1a6-d894-50e4-88c9-80f330806137" 13194139536191 true] [17592186388096 1034 "{\\begin{aligned}x=10+7t \\\\ y=-4-8t \\\\ z=-1-11t\\end{aligned}" 13194139536191 true] [17592186388096 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388096 1111 #uuid "061f1e5d-8b91-5aa6-8acd-1589eec39bfc" 13194139536191 true] [17592186388097 1034 "{\\begin{aligned}x=10+7t \\\\ y=-7-8t \\\\ z=-1+t\\end{aligned}" 13194139536191 true] [17592186388097 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388097 1111 #uuid "96507ee2-fc85-577c-b07f-abc6c00f766a" 13194139536191 true] [17592186388098 1034 "{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}" 13194139536191 true] [17592186388098 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388098 1111 #uuid "eaa37017-47c9-5416-a396-dc01398c85bb" 13194139536191 true] [17592186388099 1017 #edb/ref 17592186388100 13194139536191 true] [17592186388099 1089 "q-127405" 13194139536191 true] [17592186388099 1091 #edb/ref 17592186045463 13194139536191 true] [17592186388099 1100 "Consider the straight line with the parametric equations\n\n$$\n{\\begin{aligned}x=2-6t \\\\ y=1+3t \\\\ z=-5+2t\\end{aligned}\n$$\n\n \nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." 13194139536191 true] [17592186388099 1113 #uuid "60027f0f-2705-55d1-a629-b924e3a07c06" 13194139536191 true] [17592186388099 1145 "First, let's find the corresponding vector equation as follows:\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2-6t \\\\ 1+3t \\\\ -5+2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ -5\\end{aligned}]+[\\begin{aligned}-6t \\\\ 3t \\\\ 2t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}2 \\\\ 1 \\\\ -5\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 3 \\\\ 2\\end{aligned}] \\\\ r & =[\\begin{aligned}2 \\\\ 1 \\\\ -5\\end{aligned}]+t[\\begin{aligned}-6 \\\\ 3 \\\\ 2\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nThis implies that the straight line passes through the point $P(2,1,-5)$ and is parallel to the vector $v=⟨-6,3,2⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z-(-5)}{2}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z+5}{2}.\n$$" 13194139536191 true] [17592186388100 1000 #edb/ref 17592186388101 13194139536191 true] [17592186388100 1000 #edb/ref 17592186388102 13194139536191 true] [17592186388100 1000 #edb/ref 17592186388103 13194139536191 true] [17592186388100 1000 #edb/ref 17592186388104 13194139536191 true] [17592186388100 1000 #edb/ref 17592186388105 13194139536191 true] [17592186388100 1040 #edb/ref 17592186045450 13194139536191 true] [17592186388100 1041 "selection" 13194139536191 true] [17592186388100 1104 #edb/ref 17592186388105 13194139536191 true] [17592186388100 1110 #uuid "ed095a53-9e46-565f-8300-a51fe81037fc" 13194139536191 true] [17592186388101 1034 "\\frac{x+6}{2}=\\frac{y-3}{1}=\\frac{z-2}{5}" 13194139536191 true] [17592186388101 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388101 1111 #uuid "7f2a53d4-da7f-5c51-bcb3-b5010b14fcfb" 13194139536191 true] [17592186388102 1034 "\\frac{x+2}{-6}=\\frac{y-1}{3}=\\frac{z-5}{2}" 13194139536191 true] [17592186388102 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388102 1111 #uuid "bc978f72-8a6b-5b3c-81cc-2332f1fc5336" 13194139536191 true] [17592186388103 1034 "\\frac{x+6}{-2}=\\frac{y-3}{1}=\\frac{z+2}{5}" 13194139536191 true] [17592186388103 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388103 1111 #uuid "caf2213b-8990-5f57-be89-4a114b928416" 13194139536191 true] [17592186388104 1034 "\\frac{x-2}{-2}=\\frac{y-1}{3}=\\frac{z+5}{6}" 13194139536191 true] [17592186388104 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388104 1111 #uuid "5b38264f-ecf1-5a42-8f45-af5115520f9f" 13194139536191 true] [17592186388105 1034 "\\frac{x-2}{-6}=\\frac{y-1}{3}=\\frac{z+5}{2}" 13194139536191 true] [17592186388105 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388105 1111 #uuid "ed911f19-4550-5391-823e-ea0256a45a7b" 13194139536191 true] [17592186388106 1017 #edb/ref 17592186388107 13194139536191 true] [17592186388106 1089 "q-127461" 13194139536191 true] [17592186388106 1091 #edb/ref 17592186045465 13194139536191 true] [17592186388106 1100 "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 1 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" 13194139536191 true] [17592186388106 1113 #uuid "ee1c5089-3856-5f69-9d8f-cf952b30e484" 13194139536191 true] [17592186388106 1145 "Using the usual formula, we get\n\n$$\n\\frac{x-3}{-5}=\\frac{y-0}{1}=\\frac{z-(-2)}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1}=\\frac{z+2}{0},\n$$\n\nwhich is problematic because $\\frac{z+2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=-2:$\n\n$$\nr=[\\begin{aligned}3-5t \\\\ t \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z+2}{0}$ part and instead write $z=-2,$ as follows:\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2\n$$" 13194139536191 true] [17592186388107 1000 #edb/ref 17592186388108 13194139536191 true] [17592186388107 1000 #edb/ref 17592186388109 13194139536191 true] [17592186388107 1000 #edb/ref 17592186388110 13194139536191 true] [17592186388107 1000 #edb/ref 17592186388111 13194139536191 true] [17592186388107 1000 #edb/ref 17592186388112 13194139536191 true] [17592186388107 1040 #edb/ref 17592186045450 13194139536191 true] [17592186388107 1041 "selection" 13194139536191 true] [17592186388107 1104 #edb/ref 17592186388110 13194139536191 true] [17592186388107 1110 #uuid "03ace7f6-72b8-5235-9985-6e4949cbed7b" 13194139536191 true] [17592186388108 1034 "\\frac{x+3}{-5}=\\frac{y}{1},\\,z=2" 13194139536191 true] [17592186388108 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388108 1111 #uuid "241f7184-cd1c-5da9-8386-f0e2288172c7" 13194139536191 true] [17592186388109 1034 "\\frac{x-5}{-3}=\\frac{y}{1},\\,z=-2" 13194139536191 true] [17592186388109 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388109 1111 #uuid "1ae647c9-2750-50b8-94dc-37a5dfdd88c5" 13194139536191 true] [17592186388110 1034 "\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2" 13194139536191 true] [17592186388110 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388110 1111 #uuid "34b48131-54c7-5b7e-8fd7-6719c523d2cf" 13194139536191 true] [17592186388111 1034 "\\frac{x-3}{5}=\\frac{y}{2},\\,z=2" 13194139536191 true] [17592186388111 1103 #edb/ref 17592186045453 13194139536191 true] [17592186388111 111