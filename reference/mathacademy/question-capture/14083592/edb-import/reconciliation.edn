capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127397" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x+2}{2}=\\frac{y-3}{-5}=\\frac{z-3}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/state.json" "file_sha256" "1c4576c2fb38c2b66c8cbe2a8cadc680e0a866b52d487a20a08bcf659fd85cb4" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" nil "attribute" "question/problem" "value" "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}-3 \\\\ 2 \\\\ 1\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/state.json" "file_sha256" "1c4576c2fb38c2b66c8cbe2a8cadc680e0a866b52d487a20a08bcf659fd85cb4" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" nil "attribute" "question/worked-solution" "value" "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{3}=\\frac{y-2}{0}=\\frac{z-1}{-2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{3}=\\frac{y-2}{0}=\\frac{z-1}{-2},\n$$\n\nwhich is problematic because $\\frac{y-2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=2:$\n\n$$\nr=[\\begin{aligned}-3+3t \\\\ 2 \\\\ 1-2t\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-2}{0}$ part and instead write $y=2,$ as follows:\n\n$$\n\\frac{x+3}{3}=\\frac{z-1}{-2},\\,y=2\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/state.json" "file_sha256" "1c4576c2fb38c2b66c8cbe2a8cadc680e0a866b52d487a20a08bcf659fd85cb4" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/activity-metadata.json" "file_sha256" "080ba4d1769da3809cbf2ab4e44f58784d7dd89caeba612e18774fa2b95f178e" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/state.json" "file_sha256" "1c4576c2fb38c2b66c8cbe2a8cadc680e0a866b52d487a20a08bcf659fd85cb4" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{x+3}{-3}=\\frac{z-1}{2},\\,y=2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/state.json" "file_sha256" "1c4576c2fb38c2b66c8cbe2a8cadc680e0a866b52d487a20a08bcf659fd85cb4" "basis" 1561 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14042625/edb-import/verification.json"} {"question" "q-127412" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\