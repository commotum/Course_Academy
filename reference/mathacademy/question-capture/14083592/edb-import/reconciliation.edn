6" "511b2fb557b8eb12ca669cf6b53992f7eb13b53e06b7c0fb3fd9d8a7807fc703" "basis" 2007 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062714/edb-import/verification.json"} {"question" "q-127527" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{x-2}{2}=\\frac{y-1}{-4},\\,z=-3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062714/state.json" "file_sha256" "511b2fb557b8eb12ca669cf6b53992f7eb13b53e06b7c0fb3fd9d8a7807fc703" "basis" 2007 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062714/edb-import/verification.json"} {"question" "q-127527" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062714/state.json" "file_sha256" "511b2fb557b8eb12ca669cf6b53992f7eb13b53e06b7c0fb3fd9d8a7807fc703" "basis" 2007 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062714/edb-import/verification.json"}] "sources" [{"question" "q-33002" "field" nil "attribute" "question/problem" "value" "Consider the straight line with the canonical equation $\\frac{x-3}{5}=\\frac{y-1}{1}=\\frac{z+7}{-5}.$ Find the vector equation of the line." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083592/state.json" "file_sha256" "79b531f4a33a8e6ecdac0b273aeb259d8b4cc6381e4caa988d49014db4c079a0"} {"question" "q-33002" "field" nil "attribute" "question/worked-solution" "value" "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-3}{5}=\\frac{y-1}{1}=\\frac{z-(-7)}{-5},\n$$\n\nwe find that our line passes through the point $P(3,1,-7)$ and is parallel to $v=⟨5,1,-5⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}3 \\\\ 1 \\\\ -7\\end{aligned}]+t[\\begin{aligned}5 \\\\ 1 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083592/state.json" "file_sha256" "79b531f4a33a8e6ecdac0b273aeb259d8b4cc6381e4caa988d49014db4c079a0"} {"question" "q-33002" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083592/activity-metadata.json" "file_sha256" "f459ebae02c303ffbdaf1e7e6d5d50f6fa0548822275602509ac63b3920a721f"} {"question" "q-33002" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14083592/state.json" "file_sha256" "79b531f4a33a8e6ecdac0b273aeb259d8b4cc6381e4caa988d49014db4c079a0"} {"question" "q-33002" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "r=[\\begin{aligned}-3 \\\\ -1 \\\\ 7\\end{aligned}]+t[\\begin{aligned}5 \\\\ 1 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}3 \\\\ 1 \\\\ -7\\end{aligned}]+t[\\begin{aligned}5 \\\\ 1 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=[\\begin{aligned}5 \\\\ 1 \\\\ -5\\end{aligned}]+t[\\begin{aligned}3 \\\\ 1 \\\\ 7\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"] ["math" "r=t[\\begin{aligned}3 \\\\ 1 \\\\ 7\\end{aligned}],\\,t\\in (-\\i