tion.difficulty/moderate :question/answer-fields ["q-123764/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef"] :knowledge-point/questions ["q-123764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123777/selection/f4ee6e3cdf77dbdeb833a75ba2acb23d997d3e858df80813d2fc7a8b5d7ecb10" :answer/id #uuid "895d47db-90cc-5be0-a671-2fdb140d464f" :answer/type :answer.type/math :answer/value "2\\le x\\le 4,\\,-1\\le y\\le 1" :db/ensure [:answer/validate]} {:db/id "q-123777/selection/5d0e19ade98a0cf3b24d2f2e57392968b0a7b575686db69a533077fbe648e725" :answer/id #uuid "d9b98c5f-8469-566f-9ea2-4426632978e3" :answer/type :answer.type/math :answer/value "-3\\le x\\le 3,\\,-1\\le y\\le 1" :db/ensure [:answer/validate]} {:db/id "q-123777/selection/8ed56c6a7812c1f29da3494f036b4fc8b3b4ba76f14f1f945df4bc0cecf9c98d" :answer/id #uuid "6278b842-ccbf-525b-bc19-04550f2f051b" :answer/type :answer.type/math :answer/value "-3\\le x\\le 3,\\,-2\\le y\\le 0" :db/ensure [:answer/validate]} {:db/id "q-123777/selection/b16e75737794564009ecfc24abe42c04a2d089d805abafe86827ff9b2f5b0684" :answer/id #uuid "f1228a3e-4e83-5713-85fb-13a21482535a" :answer/type :answer.type/math :answer/value "-4\\le x\\le -2,\\,0\\le y\\le 2" :db/ensure [:answer/validate]} {:db/id "q-123777/selection/cb2d8574470c5ba043da41d527cc45b60f1855baf9c28039ed128f3d84fe2397" :answer/id #uuid "d3da6420-8e20-5e63-ac4f-2a3a6caeb3e0" :answer/type :answer.type/math :answer/value "2\\le x\\le 4,\\,-2\\le y\\le 0" :db/ensure [:answer/validate]} {:db/id "q-123777/selection" :answer-field/id #uuid "0b5d3436-22c7-5198-9784-1b23b171f2e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123777/selection/cb2d8574470c5ba043da41d527cc45b60f1855baf9c28039ed128f3d84fe2397" :answer-field/choices ["q-123777/selection/f4ee6e3cdf77dbdeb833a75ba2acb23d997d3e858df80813d2fc7a8b5d7ecb10" "q-123777/selection/5d0e19ade98a0cf3b24d2f2e57392968b0a7b575686db69a533077fbe648e725" "q-123777/selection/8ed56c6a7812c1f29da3494f036b4fc8b3b4ba76f14f1f945df4bc0cecf9c98d" "q-123777/selection/b16e75737794564009ecfc24abe42c04a2d089d805abafe86827ff9b2f5b0684" "q-123777/selection/cb2d8574470c5ba043da41d527cc45b60f1855baf9c28039ed128f3d84fe2397"] :db/ensure [:answer-field/validate]} {:db/id "q-123777" :question/id #uuid "ca098227-f86d-5737-baa1-08d1e5712e68" :question/math-academy-id "q-123777" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta -1,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -1+3 & \\le \\operatorname{cos}⁡\\theta +3\\le 1+3 \\\\ 2 & \\le x\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $2\\le x\\le 4.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1-1 & \\le \\operatorname{sin}⁡\\theta -1\\le 1-1 \\\\ -2 & \\le y\\le 0.\\end{aligned}\n$$\n\nSo, we can conclude that $-2\\le y\\le 0.$\n\nTherefore, the ranges are $2\\le x\\le 4$ and $-2\\le y\\le 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123777/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35"] :knowledge-point/questions ["q-123777"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327871/field-1/35f5572ccca3a8c38d3ca06e2a92b51065f48e45d29833e19f4eb153cae096fc" :answer/id #uuid "5af4362a-25ff-5202-8196-7d003d1504b1" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}" :db/ensure [:answer/va