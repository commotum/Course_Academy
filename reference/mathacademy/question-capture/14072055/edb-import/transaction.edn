e79a588995a9845a23c2bb66963a5c" "q-20533/selection/882d22df5dc0b4481387e02e481c143d4488f26b2ed59f64c448365c0c9e90ee" "q-20533/selection/13d2d18523c9ec1cf9748cf8aecddea136351dff0f07a6edf37d33d2707477bc" "q-20533/selection/6b9478a787c8f89aec29151c92c7fc0ed3d877971a1822a619bbc21e5396f15d"] :db/ensure [:answer-field/validate]} {:db/id "q-20533" :question/id #uuid "f8debf20-bfaf-5a47-b96d-4adce3d312bb" :question/math-academy-id "q-20533" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+2z=0 \\\\  & y+2z=0 \\\\  & x+y+3z=1\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 1 & 1 & 3 & 1\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 1 & 1 & 3 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20533/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827"] :knowledge-point/questions ["q-20533"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20539/selection/b41a2aac679d22149e05f8b5155346637fb8abe135c6cb76095562e31bc22ca4" :answer/id #uuid "bf946d7e-2314-5cbb-82be-974b93c1f91a" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20539/selection/0f0a17f4c34023f6355f2b648ec9eb6db2f56de18ffa88dad437a4109d4e842a" :answer/id #uuid "11399a01-b35a-5641-b37b-c3d969a5abd2" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20539/selection/2d1351399ea0fc5f5ef501a0031387b82104249db3ea6662b78a317db52a1afc" :answer/id #uuid "3b5e9194-5c6f-565b-b7be-541cf9c8b342" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20539/selection/6372f8d8b8b66b54a08126a463f07ebaf0b5a7a3a4f13c7e32e450451b1b5fe3" :answer/id #uuid "344942a2-a52d-5f61-a683-427bc12b2e04" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20539/selection/23ac43d0fbe4fb638324d3b6be567ae94fa6983b04fe7944f90f873d6ecf7c7a" :answer/id #uuid "b3f93267-dc2c-54c2-8cc7-0f2c835ad818" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-20539/selection" :answer-field/id #uuid "aaf96bbd-80c0-5d06-882c-0625937ad172" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20539/selection/23ac43d0fbe4fb638324d3b6be567ae94fa6983b04fe7944f90f873d6ecf7c7a" :answer-field/choices ["q-20539/selection/b41a2aac679d22149e05f8b5155346637fb8abe135c6cb76095562e31bc22ca4" "q-20539/selection/0f0a17f4c34023f6355f2b648ec9eb6db2f56de18ffa88dad437a4109d4e842a" "q-20539/selection/2d1351399ea0fc5f5ef501a0031387b82104249db3ea6662b78a317db52a1afc" "q-20539/selection/6372f8d8b8b66b54a08126a463f07ebaf0b5a7a3a4f13c7e32e450451b1b5fe3" "q-20539/selection/23ac43d0fbe4fb638324d3b6be567ae94fa6983b04fe7944f90f873d6ecf7c7a"] :db/ensure [:answer-field/validate]} {:db/id "q-20539" :question/id #uuid "4b0ab2ea-5bc8-5361-b6e4-ca31cdf1350a" :question/math-academy-id "q-20539" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 4 & 12 & 17 & -26\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20539/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827"] :knowledge-point/questions ["q-20539"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20263/selection/215726b2d15b418be16a3027b620b1fef9ad878dc1696aa4e5419ba67f606289" :answer/id #uuid "819dcbf3-244b-56f3-bac9-c3460d9a6b07" :answer/type :answer.type/text :answer/value "$x=1,y=6$ and $z=-1$" :db/ensure [:answer/validate]} {:db/id "q-20263/selection/bb11df7be1bb7dd0b8ba95f8e2c88d3c838af9884f98bb6c404b95f2284b9129" :answer/id #uuid "58f54120-1c2e-507f-983f-67c68f6007e5" :answer/type :answer.type/text :answer/value "$x=1,y=5$ and $z=0$" :db/ensure [:answer/validate]} {:db/id "q-20263/selection/53a72ab091559ed30ac5b68c0cfa7a6479b93c9f18aacfe485e704db5c489d5d" :answer/id #uuid "ff6ffb27-91bf-5103-93ac-3c2f05784d25" :answer/type :answer.type/text :answer/value "$x=1,y=2$ and $z=3$" :db/ensure [:answer/validate]} {:db/id "q-20263/selection/26c27e7822134be9276f05d4a52e3cd19be7d80397c9d4f70b72a4b1f1a4c76c" :answer/id #uuid "333ab59b-93f1-5fba-9c9b-4b5d12fb6180" :answer/type :answer.type/text :answer/value "$x=1,y=8$ and $z=-3$" :db/ensure [:answer/validate]} {:db/id "q-20263/selection/8211e5c77ff31a66f405f3f53f31f11a81ca80d9d03c16624d6f99255fba88ff" :answer/id #uuid "4cf448e5-07e9-53c1-aa13-a28d056b96a2" :answer/type :answer.type/text :answer/value "$x=1,y=4$ and $z=1$" :db/ensure [:answer/validate]} {:db/id "q-20263/selection" :answer-field/id #uuid "12ccae99-0e09-5930-8e41-6f2ecc09369d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20263/selection/53a72ab091559ed30ac5b68c0cfa7a6479b93c9f18aacfe485e704db5c489d5d" :answer-field/choices ["q-20263/selection/215726b2d15b418be16a3027b620b1fef9ad878dc1696aa4e5419ba67f606289" "q-20263/selection/bb11df7be1bb7dd0b8ba95f8e2c88d3c838af9884f98bb6c404b95f2284b9129" "q-20263/selection/53a72ab091559ed30ac5b68c0cfa7a6479b93c9f18aacfe485e704db5c489d5d" "q-20263/selection/26c27e7822134be9276f05d4a52e3cd19be7d80397c9d4f70b72a4b1f1a4c76c" "q-20263/selection/8211e5c77ff31a66f405f3f53f31f11a81ca80d9d03c16624d6f99255fba88ff"] :db/ensure [:answer-field/validate]} {:db/id "q-20263" :question/id #uuid "5bd93618-ca8f-501f-8ec1-14f3febe4ba6" :question/math-academy-id "q-20263" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+z=6 \\\\  & y+z=5 \\\\  & 2x+3y+2z=14\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and hence solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & 1 & 1 & 5 \\\\ 2 & 3 & 2 & 14\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & 1 & 1 & 5 \\\\ 2 & 3 & 2 & 14\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 1 & 0 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & -1 & -3\\end{aligned}] & {R}_{3} & :=-{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & 1 & 1 & 5 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n{\\begin{aligned} & x+y+z=6 \\\\  & y+z=5 \\\\  & z=3,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $z=3$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\ny+(3)=5\\,⟹\\,y=5-3=2.\n$$\n\nFinally, substituting both $y=2$ and $z=3$ into the first equation, we get\n\n$$\nx+(2)+(3)=6\\,⟹\\,x=6-5=1.\n$$\n\nTherefore, the solution is $x=1,y=2$ and $z=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827"] :knowledge-point/questions ["q-20263"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130926/selection/031e8fcb5150fd9bc61caadcd5f2101e2a548a6b8df6574fa8c3fdd267e89ed2" :answer/id #uuid "3ebf0657-4d78-56b5-bc74-4d6bc0c5e774" :answer/type :answer.type/math :answer/value "⟨5,6,4⟩" :db/ensure [:answer/validate]} {:db/id "q-130926/selection/ad06512a3ce90be9ff4cdfacdbd08376f610ea50c75826a9e36ac853cd596bfa" :answer/id #uuid "a34f2682-c1ea-5c34-9310-eb89c305ab31" :answer/type :answer.type/math :answer/value "⟨-1,2,2⟩" :db/ensure [:answer/validate]} {:db/id "q-130926/selection/22289909d6d742cb9f1585f229bd6ce80912405a401fdcc20bd03520008502dc" :answer/id #uuid "4d0fbf33-cdc4-5298-bc6b-877279fbd179" :answer/type :answer.type/math :answer/value "⟨5,14,8⟩" :db/ensure [:answer/validate]} {:db/id "q-130926/selection/0f1320f78128549f4905ef605ad7039d8a295186f736496665fdc9aca347fb44" :answer/id #uuid "5e44dfbf-d02b-5a54-9aa0-a085019bdd61" :answer/type :answer.type/math :answer/value "⟨17,6,8⟩" :db/ensure [:answer/validate]} {:db/id "q-130926/selection/175194186c0224ba4316a37847a0fb53b8602ae6f8a74fd1dd367ecbf4fda4bb" :answer/id #uuid "11707825-b7d1-526d-a0ca-83315a9b9953" :answer/type :answer.type/math :answer/value "⟨17,14,8⟩" :db/ensure [:answer/validate]} {:db/id "q-130926/selection" :answer-field/id #uuid "1cdfc3bd-fdca-5559-ad69-5b8738763495" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130926/selection/175194186c0224ba4316a37847a0fb53b8602ae6f8a74fd1dd367ecbf4fda4bb" :answer-field/choices ["q-130926/selection/031e8fcb5150fd9bc61caadcd5f2101e2a548a6b8df6574fa8c3fdd267e89ed2" "q-130926/selection/ad06512a3ce90be9ff4cdfacdbd08376f610ea50c75826a9e36ac853cd596bfa" "q-130926/selection/22289909d6d742cb9f1585f229bd6ce80912405a401fdcc20bd03520008502dc" "q-130926/selection/0f1320f78128549f4905ef605ad7039d8a295186f736496665fdc9aca347fb44" "q-130926/selection/175194186c0224ba4316a37847a0fb53b8602ae6f8a74fd1dd367ecbf4fda4bb"] :db/ensure [:answer-field/validate]} {:db/id "q-130926" :question/id #uuid "431a8c5f-b48a-570a-b528-7d3773d13396" :question/math-academy-id "q-130926" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -6 & 3 & -9 \\\\ -2 & 5 & -4 & 4 \\\\ 0 & 3 & -5 & 2\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -6 & 3 & -9 \\\\ -2 & 5 & -4 & 4 \\\\ 0 & 3 & -5 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -3 \\\\ -2 & 5 & -4 & 4 \\\\ 0 & 3 & -5 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -3 \\\\ 0 & 1 & -2 & -2 \\\\ 0 & 3 & -5 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -3 \\\\ 0 & 1 & -2 & -2 \\\\ 0 & 0 & 1 & 8\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n{\\begin{aligned} & x-2y+z=-3 \\\\  & y-2z=-2 \\\\  & z=8,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $z=8$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\ny-2(8)=-2\\,⟹\\,y=-2+16=14.\n$$\n\nFinally, substituting both $y=14$ and $z=8$ into the first equation, we get\n\n$$\nx-2(14)+(8)=-3\\,⟹\\,x=17.\n$$\n\nTherefore, the solution is $x=17,y=14$, and $z=8.$ Or, in vector form, $⟨17,14,8⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130926/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827"] :knowledge-point/questions ["q-130926"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130928/selection/36027a8b0f6bd8a92b938b149a885cf28bdf6281edf58352e4b659b0a1a255cf" :answer/id #uuid "1a6e9369-3da4-5641-a4c0-d99cd4fac697" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -1 & 4 & -2 \\\\ 0 & 1 & 14 & -7 \\\\ 0 & 0 & 1 & \\frac{3}{7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130928/selection/99b9a646209c44ae3a5b20759b8f5c13e4edc629f191d0e449f51c5c749058d0" :answer/id #uuid "54858800-49a2-5458-87db-995e511b467e" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 1 & 3 & 2 \\\\ 0 & 0 & 1 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130928/selection/04cfaba7e8f7a36ecf0556781c368996f8e6747d22ae137babade7a7b9d82746" :answer/id #uuid "84826572-6121-5e20-abb0-c418ae03d84c" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 1 & -\\frac{3}{7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130928/selection/c8913f39841763bf9b54d78bcb1b0271d1571ce854ded32bdbbcfc24b02b0e45" :answer/id #uuid "91dd7ea8-b7de-5ce9-b1de-3791eb3ced3e" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130928/selection/7d78a0bdeca6156512f518e0b9c53564c970e01d02b5816025015692980e42f1" :answer/id #uuid "ea994afe-e536-5771-836e-e1cf5147e33f" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -1 & -4 & 2 \\\\ 0 & 1 & -2 & -3 \\\\ 0 & 0 & 1 & -\\frac{3}{7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-130928/selection" :answer-field/id #uuid "59ced7c4-89a1-5c1d-b82e-60536562e135" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130928/selection/04cfaba7e8f7a36ecf0556781c368996f8e6747d22ae137babade7a7b9d82746" :answer-field/choices ["q-130928/selection/36027a8b0f6bd8a92b938b149a885cf28bdf6281edf58352e4b659b0a1a255cf" "q-130928/selection/99b9a646209c44ae3a5b20759b8f5c13e4edc629f191d0e449f51c5c749058d0" "q-130928/selection/04cfaba7e8f7a36ecf0556781c368996f8e6747d22ae137babade7a7b9d82746" "q-130928/selection/c8913f39841763bf9b54d78bcb1b0271d1571ce854ded32bdbbcfc24b02b0e45" "q-130928/selection/7d78a0bdeca6156512f518e0b9c53564c970e01d02b5816025015692980e42f1"] :db/ensure [:answer-field/validate]} {:db/id "q-130928" :question/id #uuid "59d8291a-54d6-53ae-b0c1-56a672117493" :question/math-academy-id "q-130928" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}4 & -4 & -12 & 8 \\\\ -1 & 1 & 10 & -5 \\\\ 0 & 3 & -9 & -6\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}4 & -4 & -12 & 8 \\\\ -1 & 1 & 10 & -5 \\\\ 0 & 3 & -9 & -6\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ -1 & 1 & 10 & -5 \\\\ 0 & 3 & -9 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 0 & 7 & -3 \\\\ 0 & 3 & -9 & -6\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 0 & 7 & -3 \\\\ 0 & 3 & -9 & -6\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 3 & -9 & -6 \\\\ 0 & 0 & 7 & -3\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we multiply the $2$nd row by $\\frac{1}{3}$ and the $3$rd row by $\\frac{1}{7}$ to get\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 3 & -9 & -6 \\\\ 0 & 0 & 7 & -3\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 7 & -3\\end{aligned}] & {R}_{3} & :=\\frac{1}{7}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 \\\\ 0 & 1 & -3 & -2 \\\\ 0 & 0 & 1 & -\\frac{3}{7}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197"] :knowledge-point/questions ["q-130928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73588/selection/e15e11270c7f348dbcec8f87fc21d17c2c05a067126c83384329e63474dafd55" :answer/id #uuid "6c195b8c-e4f3-57a4-abc0-a09a3e393d19" :answer/type :answer.type/math :answer/value "⟨2,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-73588/selection/a418531968a3b2b8f2ef108f4a1117a38949908cf5185da334fbc84761523bca" :answer/id #uuid "cf25bdf3-6542-5902-8fee-06fb1e09ae82" :answer/type :answer.type/math :answer/value "⟨52,21,-11⟩" :db/ensure [:answer/validate]} {:db/id "q-73588/selection/bbf630313fe27fba643d45e4d4c5c5f38cd2329f2c5a6f10bdd3b7b01955865b" :answer/id #uuid "b7436d5e-ec50-5709-bc99-8be3c8388500" :answer/type :answer.type/math :answer/value "⟨-2,-3,1⟩" :db/ensure [:answer/validate]} {:db/id "q-73588/selection/0448f499b4ce22210e6804a48159e0ba24f492fa4789a9f8c012c4a3fa861040" :answer/id #uuid "b48e0c1c-325f-52cd-ac4a-b25020518dfa" :answer/type :answer.type/math :answer/value "⟨-58,-23,11⟩" :db/ensure [:answer/validate]} {:db/id "q-73588/selection/6c1c6788997282a6a0807a1ffd55263845e62e7f6b797f6016997893d30cd74d" :answer/id #uuid "97f22f48-ddb6-51f9-9703-e661ea10f060" :answer/type :answer.type/math :answer/value "⟨-3,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-73588/selection" :answer-field/id #uuid "eca320e6-dbd6-531e-9ffd-17421d507126" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73588/selection/0448f499b4ce22210e6804a48159e0ba24f492fa4789a9f8c012c4a3fa861040" :answer-field/choices ["q-73588/selection/e15e11270c7f348dbcec8f87fc21d17c2c05a067126c83384329e63474dafd55" "q-73588/selection/a418531968a3b2b8f2ef108f4a1117a38949908cf5185da334fbc84761523bca" "q-73588/selection/bbf630313fe27fba643d45e4d4c5c5f38cd2329f2c5a6f10bdd3b7b01955865b" "q-73588/selection/0448f499b4ce22210e6804a48159e0ba24f492fa4789a9f8c012c4a3fa861040" "q-73588/selection/6c1c6788997282a6a0807a1ffd55263845e62e7f6b797f6016997893d30cd74d"] :db/ensure [:answer-field/validate]} {:db/id "q-73588" :question/id #uuid "2a8b2c9f-398c-5dbe-9647-f240ec1722c3" :question/math-academy-id "q-73588" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}-2 & 2 & -6 & 4 \\\\ 5 & -5 & 16 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-2 & 2 & -6 & 4 \\\\ 5 & -5 & 16 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :=-\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 3 & -2 \\\\ 5 & -5 & 16 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 3 & -2 \\\\ 0 & 0 & 1 & 11 \\\\ 0 & 1 & 2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -1 & 3 & -2 \\\\ 0 & 0 & 1 & 11 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 3 & -2 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 0 & 1 & 11\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n{\\begin{aligned}x-y+3z=-2 \\\\ y+2z=-1 \\\\ z=11,\\end{aligned}\n$$\n\nand we can apply back substitution. The third equation $z=11$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\n\\begin{aligned}y+2(11)=-1\\,⟹\\,y=-23.\\end{aligned}\n$$\n\nNow, substituting $y=-23$ and $z=11$ into the first equation, we get\n\n$$\n\\begin{aligned}x-(-23)+3(11)=-2\\,⟹\\,x=-58.\\end{aligned}\n$$\n\nThus, the solution is $x=-58$, $y=-23$, and $z=11.$ Or, in vector form, $⟨-58,-23,11⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73588/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197"] :knowledge-point/questions ["q-73588"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73592/selection/47095c8c32f851773dcf01a15aca1f02fe861b91a526638c7ad240ecc356cffb" :answer/id #uuid "5d1a9344-4774-54e2-baac-6bdfa344bf1e" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73592/selection/15a4b5986aa0d3e880045c51e0b07d027cbc8243b60e1d8832295404204b0e77" :answer/id #uuid "b82a4316-8170-5595-9fee-5ae32b156a1b" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73592/selection/4240cfdb770ddbb4d554a0b2dbe7e1089419af0d2549e8ce12c799ae80cd3880" :answer/id #uuid "33dc155f-6682-5a1f-8e71-3176597d12d0" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73592/selection/47c4d1e20f22c900581487d7382fe2821f7f7ad9ab533b17bf17b29e560ff28f" :answer/id #uuid "b4260d06-8943-5ddb-b6ef-c5b2eac2aa80" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -4 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73592/selection/ceb0c17fd70477c7d45874dea3fcde4c7212dc9f2b13351b9a7ec8b47de74886" :answer/id #uuid "be73c87c-691d-5498-a59c-2991ff6f1c30" :answer/type :answer.type/math :answer/value "M∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -2 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-73592/selection" :answer-field/id #uuid "be25a1a3-304d-585b-b387-dfe618b092f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73592/selection/4240cfdb770ddbb4d554a0b2dbe7e1089419af0d2549e8ce12c799ae80cd3880" :answer-field/choices ["q-73592/selection/47095c8c32f851773dcf01a15aca1f02fe861b91a526638c7ad240ecc356cffb" "q-73592/selection/15a4b5986aa0d3e880045c51e0b07d027cbc8243b60e1d8832295404204b0e77" "q-73592/selection/4240cfdb770ddbb4d554a0b2dbe7e1089419af0d2549e8ce12c799ae80cd3880" "q-73592/selection/47c4d1e20f22c900581487d7382fe2821f7f7ad9ab533b17bf17b29e560ff28f" "q-73592/selection/ceb0c17fd70477c7d45874dea3fcde4c7212dc9f2b13351b9a7ec8b47de74886"] :db/ensure [:answer-field/validate]} {:db/id "q-73592" :question/id #uuid "2d0c5e25-563c-570e-8ef3-6aa05d25d8e6" :question/math-academy-id "q-73592" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 3x-6y+3z=-6 \\\\  & 2x-4y+3z=-1 \\\\  & 2y-4z=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & -6 & 3 & -6 \\\\ 2 & -4 & 3 & -1 \\\\ 0 & 2 & -4 & 2\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -6 & 3 & -6 \\\\ 2 & -4 & 3 & -1 \\\\ 0 & 2 & -4 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 2 & -4 & 3 & -1 \\\\ 0 & 2 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 2 & -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 2 & -4 & 2\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 2 & -4 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we multiply the $2$nd row by $\\frac{1}{2}$ to get\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 2 & -4 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -2 \\\\ 0 & 1 & -2 & 1 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73592/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197"] :knowledge-point/questions ["q-73592"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4701"] :question/problem "Consider the system of linear equations\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072055/assets/49df59f984403cbbc994361c96313eca4d0875a7030dd997c90f1e393e23b69c.png)\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -1 & 1 & 1 \\\\ 0 & 1 & 1 & -2 \\\\ -1 & 2 & 1 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & 1 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 1 & 2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & 1 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072055/assets/dded05f0961034de6808d8f91f64afe8c367cec3c11fafdb26946090fa9c0891.png)\n\nand we can apply back substitution. The final equation $z=2$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\n\\begin{aligned}y+(2)=-2\\,⟹\\,y=-4.\\end{aligned}\n$$\n\nFinally, substituting both $y=-4$ and $z=2$ into the first equation, we get\n\n$$\n\\begin{aligned}x-(-4)+(2)=1\\,⟹\\,x=-5.\\end{aligned}\n$$\n\nTherefore, the solution is $x=-5,$ $y=-4,$ and $z=2.$ Or, in vector form, $\\langle -5,-4,2 \\rangle.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4702"] :question/problem "Consider the system of linear equations\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072055/assets/0c3483f97994da22dc0c739f9c3a26f87e070d28b684e63955a1129d00f9c755.png)\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072055/assets/9f1beb75e17aabdbeb5d814ae7ce3018f2ea89c36211070d40060d57445ca936.png)\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 1 & -2 \\\\ 1 & 1 & 2 & -1 \\\\ 1 & 2 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 1 \\\\ 1 & 2 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get $a_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 3\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072055/assets/84de3f5eddf0a05d4f2d69aebd1537feb23a228fba3e1af31678dd4bdb1b59df.png)\n\nand we can apply back substitution. The third equation $z=1$ tells us the value of $z,$ and the second equation $y=3$ tells us the value of $y.$ Substituting these values into the first equation, we get\n\n$$\n\\begin{aligned}x+(3)+(1)=-2\\,⟹\\,x=-6.\\end{aligned}\n$$\n\nTherefore, the solution is $x=-6,$ $y=3,$ and $z=1.$ Or, in vector form, $\\langle -6,3,1 \\rangle.$" :db/ensure [:question/validate]}]
