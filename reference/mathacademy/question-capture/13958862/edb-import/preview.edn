qrt{16} \\\\ x & =3\\pm 4 \\\\ x & =-1,7\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(-1,0)$ and $(7,0).$" 13194139533947 true] [17592186267882 1000 #edb/ref 17592186267883 13194139533947 true] [17592186267882 1000 #edb/ref 17592186267884 13194139533947 true] [17592186267882 1000 #edb/ref 17592186267885 13194139533947 true] [17592186267882 1000 #edb/ref 17592186267886 13194139533947 true] [17592186267882 1000 #edb/ref 17592186267887 13194139533947 true] [17592186267882 1040 #edb/ref 17592186045450 13194139533947 true] [17592186267882 1041 "selection" 13194139533947 true] [17592186267882 1104 #edb/ref 17592186267885 13194139533947 true] [17592186267882 1110 #uuid "8b3ca1a7-a59a-52f0-8e90-2a7cb91cb05e" 13194139533947 true] [17592186267883 1034 "(\\pm 3,0)" 13194139533947 true] [17592186267883 1103 #edb/ref 17592186045453 13194139533947 true] [17592186267883 1111 #uuid "ad101bbd-2947-5f49-aece-d36f4d805851" 13194139533947 true] [17592186267884 1034 "(\\pm 4,0)" 13194139533947 true] [17592186267884 1103 #edb/ref 17592186045453 13194139533947 true] [17592186267884 1111 #uuid "c4eb3833-664e-5674-95bb-5ad675bd5959" 13194139533947 true] [17592186267885 1034 "$(-1,0)$ and $(7,0)$" 13194139533947 true] [17592186267885 1103 #edb/ref 17592186045454 13194139533947 true] [17592186267885 1111 #uuid "3f01f6b0-8922-5a07-9fde-22aa4b0105b5" 13194139533947 true] [17592186267886 1034 "$(-3,0)$ and $(4,0)$" 13194139533947 true] [17592186267886 1103 #edb/ref 17592186045454 13194139533947 true] [17592186267886 1111 #uuid "0221d733-e017-502e-a01a-2b1025b7e60f" 13194139533947 true] [17592186267887 1034 "$(-2,0)$ and $(3,0)$" 13194139533947 true] [17592186267887 1103 #edb/ref 17592186045454 13194139533947 true] [17592186267887 1111 #uuid "fc414fcd-71aa-5c5a-868f-9550b1919c90" 13194139533947 true] [17592186267888 1017 #edb/ref 17592186267889 13194139533947 true] [17592186267888 1017 #edb/ref 17592186267892 13194139533947 true] [17592186267888 1017 #edb/ref 175921862