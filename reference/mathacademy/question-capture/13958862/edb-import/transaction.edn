-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}2{x}^{2}+4{y}^{2}-10x-32y+54 & =0 \\\\ 2(0)^{2}+4{y}^{2}-10\\cdot 0-32y+54 & =0 \\\\ 4{y}^{2}-32y+54 & =0 \\\\ 4[{y}^{2}-8y]+54 & =0 \\\\ 4[(y-4)^{2}-16]+54 & =0 \\\\ 4(y-4)^{2}-64+54 & =0 \\\\ 4(y-4)^{2}-10 & =0 \\\\ 4(y-4)^{2} & =10 \\\\ (y-4)^{2} & =\\frac{10}{4} \\\\ y-4 & =\\pm \\frac{\\sqrt{10}}{2} \\\\ y & =4\\pm \\frac{\\sqrt{10}}{2}\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,4+\\frac{\\sqrt{10}}{2})\\,\\text{and}\\,B(0,4-\\frac{\\sqrt{10}}{2}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274502/field-1" "q-274502/field-2" "q-274502/field-3" "q-274502/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-274502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7646/selection/8652cb327e236f9316736106734892f08b1202f1cde02d0836576821bfbca00b" :answer/id #uuid "10fbd1f8-7244-5028-83ae-6da5b8c5a027" :answer/type :answer.type/math :answer/value "(0,-1\\pm \\sqrt{6})" :db/ensure [:answer/validate]} {:db/id "q-7646/selection/8953dfd0a94cab245d638f99aee16a5ddbb74e567a75be0d9d2978fec5239cf2" :answer/id #uuid "faeb1c77-5f1d-51d0-aed8-42087d66ba06" :answer/type :answer.type/math :answer/value "(0,-1\\pm 2\\sqrt{6})" :db/ensure [:answer/validate]} {:db/id "q-7646/selection/14fc90e06d113e77eb3686a2b30e81f2381fa7db9b8728bcbd7e8c9edd9c7540" :answer/id #uuid "235ebc67-3dfb-5e18-a47e-a8223b200be7" :answer/type :answer.type/math :answer/value "(0,-1\\pm \\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-7646/selection/f08f9b0b53902d578e89765ebbd573ee72a309ecb6c4ea1e968111147bb6ff5d" :answer/id #uuid "48917d9d-b33e-5175-ba20-e651cb283f87" :answer/type :answer.type/math :answer/value "(0,1\\pm \\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-7646/selection/41eddb442be39cdb30c17f1cb80ee29814ec413addfd5882a5f49b15e6ae1bc2" :answer/id #uuid "2cfb7b14-a2f8-57ce-a947-f087f795603a" :answer/type :answer.type/math :answer/value "(0,1\\pm \\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-7646/selection" :answer-field/id #uuid "39ade906-0907-5f4a-b34d-44d77fb2bdee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7646/selection/8652cb327e236f9316736106734892f08b1202f1cde02d0836576821bfbca00b" :answer-field/choices ["q-7646/selection/8652cb327e236f9316736106734892f08b1202f1cde02d0836576821bfbca00b" "q-7646/selection/8953dfd0a94cab245d638f99aee16a5ddbb74e567a75be0d9d2978fec5239cf2" "q-7646/selection/14fc90e06d113e77eb3686a2b30e81f2381fa7db9b8728bcbd7e8c9edd9c7540" "q-7646/selection/f08f9b0b53902d578e89765ebbd573ee72a309ecb6c4ea1e968111147bb6ff5d" "q-7646/selection/41eddb442be39cdb30c17f1cb80ee29814ec413addfd5882a5f49b15e6ae1bc2"] :db/ensure [:answer-field/validate]} {:db/id "q-7646" :question/id #uuid "d4ad8b92-e3b5-5a56-bfac-e69e0f571229" :question/math-academy-id "q-7646" :question/problem "Determine the points where the ellipse ${x}^{2}+2{y}^{2}-4x+4y=10$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+2{y}^{2}-4x+4y & =10 \\\\ (0)^{2}+2{y}^{2}-4(0)+4y & =10 \\\\ 2{y}^{2}+4y & =10 \\\\ {y}^{2}+2y & =5 \\\\ (y+1)^{2}-{1}^{2} & =5 \\\\ (y+1)^{2} & =5+1 \\\\ (y+1)^{2} & =6 \\\\ y+1 & =\\pm \\sqrt{6} \\\\ y & =-1\\pm \\sqrt{6}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at $(0,-1-\\sqrt{6})$ and $(0,-1+\\sqrt{6}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7646/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-7646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327146/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ce037c27-1191-59ab-91c7-ce7d84ebb5c8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-327146/field-1" :answer-field/id #uuid "f7e89b1e-0fa0-5146-819c-88d513ab13c2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327146/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-327146/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-327146/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "5b790113-deef-5aab-be8b-e1d9d281a34d" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-327146/field-2" :answer-field/id #uuid "782fc26c-27bb-5025-9bdd-006f8586f5cb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327146/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-327146/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :db/ensure [:answer-field/validate]} {:db/id "q-327146" :question/id #uuid "167fbd42-673a-5411-ba0f-804405134964" :question/math-academy-id "q-327146" :question/problem "Calculate the point where the ellipse $4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4}=0$ intercepts the $y$-axis.\n\nThe $y$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4} & =0 \\\\ 4(0)^{2}+{y}^{2}-8(0)-5y+\\frac{25}{4} & =0 \\\\ {y}^{2}-5y+\\frac{25}{4} & =0 \\\\ {(y-\\frac{5}{2})}^{2} & =0 \\\\ y-\\frac{5}{2} & =0 \\\\ y & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\frac{5}{2}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/assets/0a1303644a54b07f874df4f6694d84384e634403bc4efe8ee5086d922bc6f25e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-327146/field-1" "q-327146/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-327146"] :db/ensure [:knowledge-point/validate]}]
