4310a8d3d501adce03ec11400c71bd48568e8b65296cfbdd089a1a"] :db/ensure [:answer-field/validate]} {:db/id "q-274483/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a7698812-d39d-5e8b-a8a7-2d56f3b2fd6b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-274483/field-4" :answer-field/id #uuid "7ff994ce-6c68-5b05-9487-1719f2ac08dd" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274483/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-274483/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-274483" :question/id #uuid "9aa6c2dc-573d-5d58-b8d8-b009d90b1d9d" :question/math-academy-id "q-274483" :question/problem "From **left to right**, the ellipse $25{x}^{2}+14{y}^{2}-50x-11y=29$ intercepts the $x$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,$\n{{field-2}}$)\\,$\n\nand \n\n$\\,B($\n{{field-3}}$,$\n{{field-4}}\n$)$" :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}25{x}^{2}+14{y}^{2}-50x-11y & =29 \\\\ 25{x}^{2}+14(0)^{2}-50x-11(0) & =29 \\\\ 25{x}^{2}-50x & =29 \\\\ {x}^{2}-2x & =\\frac{29}{25} \\\\ (x-1)^{2}-{1}^{2} & =\\frac{29}{25} \\\\ (x-1)^{2} & =\\frac{29}{25}+1 \\\\ (x-1)^{2} & =\\frac{29}{25}+\\frac{25}{25} \\\\ (x-1)^{2} & =\\frac{54}{25} \\\\ x-1 & =\\pm \\frac{3\\sqrt{6}}{5} \\\\ x & =1\\pm \\frac{3\\sqrt{6}}{5}\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are\n\n$$\nA(1-\\frac{3\\sqrt{6}}{5},0)\\,\\text{and}\\,B(1+\\frac{3\\sqrt{6}}{5},0).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274483/field-1" "q-274483/field-2" "q-274483/field-3" "q-274483/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-274483"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326043/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "eb4755f7-1c48-50c6-b029-095b15fea548" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-326043/field-1" :answer-field/id #uuid "4542b178-f501-5ff4-9a1b-6bc1493eb5ac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326043/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-326043/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-326043/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7f153456-9f55-5a0c-b65b-e4d7863b0237" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326043/field-2" :answer-field/id #uuid "0e660fa3-1d44-5dd8-85e8-417da42ca5e4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326043/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-326043/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-326043" :question/id #uuid "fdd1251d-a8ec-542d-984d-1d545114b93f" :question/math-academy-id "q-326043" :question/problem "Calculate the point where the ellipse  $9{x}^{2}+8{y}^{2}+18x+32y+9=0$ intercepts the $x$-axis.\n\nThe $x$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}9{x}^{2}+8{y}^{2}+18x+32y+9 & =0 \\\\ 9{x}^{2}+8\\cdot {0}^{2}+18x+32\\cdot 0+9 & =0 \\\\ 9{x}^{2}+18x+9 & =0 \\\\ 9\\,[{x}^{2}+2x]+9 & =0 \\\\ 9[(x+1)^{2}-1]+9 & =0 \\\\ 9(x+1)^{2}-9+9 & =0 \\\\ 9(x+1)^{2} & =0 \\\\ x+1 & =0 \\\\ x & =-1\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at  $(-1,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326043/field-1" "q-326043/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-326043"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72914/selection/48c7147501ffa680d093e2e36182b842ed1028dbbbb7cf0bdf8cdc8b33723f29" :answer/id #uuid "4c01566b-b810-5053-86db-734c63ece004" :answer/type :answer.type/math :answer/value "(-2\\pm \\sqrt{3},0)" :db/ensure [:answer/validate]} {:db/id "q-72914/selection/ba1b6931d252bd6ad3d981dda2961a354b5f20b73d1e92201b84bb245e1b0bf9" :answer/id #uuid "8aa028fc-f755-56af-8dd4-05d189f371f9" :answer/type :answer.type/math :answer/value "(5,0)" :db/ensure [:answer/validate]} {:db/id "q-72914/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" :answer/id #uuid "48c2c761-77e4-540e-b74a-7c7343e36a22" :answer/type :answer.type/text :answer/value "There is no $x$-intercept" :db/ensure [:answer/validate]} {:db/id "q-72914/selection/3072ae932252c425595fe08e370d8bd1b0b3ba020209ed24b2b8af7f3583364c" :answer/id #uuid "2e85a367-2302-57e9-962b-f328530e6515" :answer/type :answer.type/math :answer/value "(2\\pm \\sqrt{3},0)" :db/ensure [:answer/validate]} {:db/id "q-72914/selection/a6960019101512d208a029b83798fdf49713d1d1569e74a9d563eb4db7f91eaf" :answer/id #uuid "e967b97f-698b-5bc0-9412-c86232ffb994" :answer/type :answer.type/math :answer/value "(-3\\pm \\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-72914/selection" :answer-field/id #uuid "3c7a00b5-b64e-53d2-