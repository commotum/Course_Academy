/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "962dd733-4b99-5f4e-a2d6-7748e34715c4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-274493/field-1" :answer-field/id #uuid "0d01f169-3f21-50a1-9925-faa3b203818f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274493/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-274493/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-274493/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3fd066ff-756a-5c80-b604-3622a23bdc28" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-274493/field-2" :answer-field/id #uuid "5bfc2aae-ea10-5a5f-a4ba-439e30119335" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274493/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-274493/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-274493/field-3/f4de0037797ba5b31e6e6620711f912bdbab284aecc27557c9a4bf177fed4374" :answer/id #uuid "a080165c-efbb-5271-af0f-1278c6c2a7d4" :answer/type :answer.type/math :answer/value "1-\\frac{2}{3}\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-274493/field-3" :answer-field/id #uuid "71c11fd5-f6f5-52a7-bf86-f55919992d76" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274493/field-3/f4de0037797ba5b31e6e6620711f912bdbab284aecc27557c9a4bf177fed4374" :answer-field/choices ["q-274493/field-3/f4de0037797ba5b31e6e6620711f912bdbab284aecc27557c9a4bf177fed4374"] :db/ensure [:answer-field/validate]} {:db/id "q-274493" :question/id #uuid "a2f660de-a80f-5e8f-b868-1fdd7f337e63" :question/math-academy-id "q-274493" :question/problem "From **top to bottom**, the ellipse $\\frac{(x+5)^{2}}{45}+\\frac{(y-1)^{2}}{2}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,1+\\frac{2\\sqrt{2}}{3})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+5)^{2}}{45}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{(0+5)^{2}}{45}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{5}{9}+\\frac{(y-1)^{2}}{2} & =1 \\\\ 10+9(y-1)^{2} & =18 \\\\ 9(y-1)^{2} & =8 \\\\ (y-1)^{2} & =\\frac{8}{9} \\\\ y-1 & =\\pm \\sqrt{\\frac{8}{9}} \\\\ y-1 & =\\pm \\frac{2\\sqrt{2}}{3} \\\\ y & =1\\pm \\frac{2\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,1+\\frac{2\\sqrt{2}}{3})\\,\\text{and}\\,B(0,1-\\frac{2\\sqrt{2}}{3}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274493/field-1" "q-274493/field-2" "q-274493/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-274493"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7642/selection/a510e7625565e656b8bbfca9678d23bfd2412f306921b20ca415039888c1c956" :answer/id #uuid "dc74d103-594e-517b-8295-a0061c50775f" :answer/type :answer.type/math :answer/value "(0,2\\pm \\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-7642/selection/825093370d6eb58a72729ae1f54be6299a8cf9d5740a5aa26a18a7e8ff8fb37b" :answer/id #uuid "0bd0dfcf-ad93-590a-9cca-0e34fb78336c" :answer/type :answer.type/math :answer/value "(0,2\\pm \\frac{3\\sqrt{2}}{2})" :db/ensure [:answer/validate]} {:db/id "q-7642/selection/1a17b9e9d7004f4d786d9a5da66f817143f0b28dd7db8ea6ff96476720375939" :answer/id #uuid "61d1225e-81da-5037-9615-ce0a0e92252e" :answer/type :answer.type/math :answer/value "(0,-2\\pm \\frac{4\\sqrt{3}}{3})" :db/ensure [:answer/validate]} {:db/id "q-7642/selection/5a36b5bc57cddbe4b6bfc38ae00f1feda5a5bc9f8370396b505a39ae6bcbadb7" :answer/id #uuid "87168c3d-f413-52fa-9f87-4a2e35d03807" :answer/type :answer.type/math :answer/value "(0,1\\pm \\frac{4\\sqrt{3}}{3})" :db/ensure [:answer/validate]} {:db/id "q-7642/selection/94857924cda1499b7110022bbedcd8205ec9b73113c758d39b0cb4dee7cf1f6f" :answer/id #uuid "181fd3e2-cb26-5aa7-89c0-aadb5f9d3911" :answer/type :answer.type/math :answer/value "(0,-2\\pm 2\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-7642/selection" :answer-field/id #uuid "13363be8-675e-56d7-a6bb-da6923c5bea5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7642/selection/1a17b9e9d7004f4d786d9a5da66f817143f0b28dd7db8ea6ff96476720375939" :answer-field/choices ["q-7642/selection/a510e7625565e656b8bbfca9678d23bfd2412f306921b20ca415039888c1c956" "q-7642/selection/825093370d6eb58a72729ae1f54be6299a8cf9d5740a5aa26a18a7e8ff8fb37b" "q-7642/selection/1a17b9e9d7004f4d786d9a5da66f817143f0b28dd7db8ea6ff96476720375939" "q-7642/selection/5a36b5bc57cddbe4b6bfc38ae00f1feda5a5bc9f8370396b505a39ae6bcbadb7" "q-7642/selection/94857924cda1499b7110022bbedcd8205ec9b73113c758d39b0cb4dee7cf1f6f"] :db/ensure [:answer-field/validate]} {:db/id "q-7642" :question/id #uuid "c9bca935-b9bf-540f-a535-f5de3e3b987f" :question/math-academy-id "q-7642" :question/problem "Calculate the points where the ellipse \n$\\frac{(x-1)^{2}}{9}+\\frac{(y+2)^{2}}{6}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{9}+\\frac{(y+2)^{2}}{6} & =1 \\\\ \\frac{(0-1)^{2}}{9}+\\frac{(y+2)^{2}}{6} & =1 \\\\ \\frac{1}{9}+\\frac{(y+2)^{2}}{6} & =1 \\\\ 4+6(y+2)^{2} & =36 \\\\ 6(y+2)^{2} & =32 \\\\ 3(y+2)^{2} & =16 \\\\ (y+2)^{2} & =\\frac{16}{3} \\\\ y+2 & =\\pm \\frac{4}{\\sqrt{3}} \\\\ y & =-2\\pm \\frac{4\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,-2-\\frac{4\\sqrt{3}}{3})$ and $(0,-2+\\frac{4\\sqrt{3}}{3}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7642/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-7642"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326289/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "bb300948-7c44-5978-8673-8e6445dbdd69" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326289/field-1" :answer-field/id #uuid "5763ef00-c15b-522c-aca2-e17c909edca9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326289/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-326289/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-326289/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d50caa28-cdf3-52d0-b59d-799c36b1cfd9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326289/field-2" :answer-field/id #uuid "9d04626d-f77e-590f-9a73-c86657f38796" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326289/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-326289/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-326289/field-3/4384df8a35d1d64c0cd41eafeb424c3ef7d9035c9d38540cde5cc6bec5399c0d" :answer/id #uuid "69f0d2b8-3113-5479-96e0-e15c830241d0" :answer/type :answer.type/math :answer/value "2-\\frac{3}{2}\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-326289/field-3" :answer-field/id #uuid "070fb05e-c8a0-52ed-88e4-ace1bbf1403c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326289/field-3/4384df8a35d1d64c0cd41eafeb424c3ef7d9035c9d38540cde5cc6bec5399c0d" :answer-field/choices ["q-326289/field-3/4384df8a35d1d64c0cd41eafeb424c3ef7d9035c9d38540cde5cc6bec5399c0d"] :db/ensure [:answer-field/validate]} {:db/id "q-326289" :question/id #uuid "a0c5d322-3f98-5330-8cc0-62528a79d8ec" :question/math-academy-id "q-326289" :question/problem "From **top to bottom**, the ellipse $\\frac{(x+3)^{2}}{12}+\\frac{(y-2)^{2}}{27}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,2+\\frac{3\\sqrt{3}}{2})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{12}+\\frac{(y-2)^{2}}{27} & =1 \\\\ \\frac{(0+3)^{2}}{12}+\\frac{(y-2)^{2}}{27} & =1 \\\\ \\frac{9}{12}+\\frac{(y-2)^{2}}{27} & =1 \\\\ \\frac{3}{4}+\\frac{(y-2)^{2}}{27} & =1 \\\\ 108\\,(\\frac{3}{4}+\\frac{(y-2)^{2}}{27}) & =108 \\\\ 81+4(y-2)^{2} & =108 \\\\ 4(y-2)^{2} & =27 \\\\ (y-2)^{2} & =\\frac{27}{4} \\\\ y-2 & =\\pm \\frac{3\\sqrt{3}}{2} \\\\ y & =2\\pm \\frac{3\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,2+\\frac{3\\sqrt{3}}{2})\\,\\text{and}\\,B(0,2-\\frac{3\\sqrt{3}}{2}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-326289/field-1" "q-326289/field-2" "q-326289/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-326289"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-16682"] :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{4}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(0-3)^{2}}{4}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{9}{4}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(y-2)^{2}}{9} & =1-\\frac{9}{4} \\\\ \\frac{(y-2)^{2}}{9} & =-\\frac{5}{4}.\\end{aligned}\n$$\n\nSince $\\frac{(y-2)^{2}}{9}\\ge 0$, there is no $y$ such that $\\frac{(y-2)^{2}}{9}=-\\frac{5}{4}.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/assets/e2d4eadef6206fee8006028477c30337e2019000c33ed971f1f048294ef72615.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-72916/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer/id #uuid "2a8ad05a-cb1d-5a82-af21-018426bd25b4" :answer/type :answer.type/text :answer/value "There is no $y$-intercept" :db/ensure [:answer/validate]} {:db/id "q-72916/selection/faed72c6ef0fe2eb6fe249cfffe46953b42c608ab9b498dcbd2808fe5ce980af" :answer/id #uuid "7e9fdc68-3ba2-58df-9753-5db6609794a5" :answer/type :answer.type/text :answer/value "$(0,5)$ and $(0,7)$" :db/ensure [:answer/validate]} {:db/id "q-72916/selection/92ceb4efdc0cd986fcf6d914c334e6bc24d60c60afe74f5d1910588d4d342e77" :answer/id #uuid "b881880a-dae5-5c77-8021-84f8c031320d" :answer/type :answer.type/math :answer/value "(0,5)" :db/ensure [:answer/validate]} {:db/id "q-72916/selection/b539633da4212b1ded282771a350103276ad3d3ae271ed706bbb52b25b8e034e" :answer/id #uuid "be61798b-49b4-591c-96ce-8f465bc3c712" :answer/type :answer.type/text :answer/value "$(0,-5)$ and $(0,7)$" :db/ensure [:answer/validate]} {:db/id "q-72916/selection/47e419858b341a250894f08c0031dd8e8d2b1807ea720e392e476720f681dca5" :answer/id #uuid "3c027250-4f3b-5fdc-b5e8-70d2b1f7a088" :answer/type :answer.type/text :answer/value "$(0,1)$ and $(0,6)$" :db/ensure [:answer/validate]} {:db/id "q-72916/selection" :answer-field/id #uuid "6e4ca2bd-5a70-57f0-b905-7c54ca55528c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72916/selection/faed72c6ef0fe2eb6fe249cfffe46953b42c608ab9b498dcbd2808fe5ce980af" :answer-field/choices ["q-72916/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" "q-72916/selection/faed72c6ef0fe2eb6fe249cfffe46953b42c608ab9b498dcbd2808fe5ce980af" "q-72916/selection/92ceb4efdc0cd986fcf6d914c334e6bc24d60c60afe74f5d1910588d4d342e77" "q-72916/selection/b539633da4212b1ded282771a350103276ad3d3ae271ed706bbb52b25b8e034e" "q-72916/selection/47e419858b341a250894f08c0031dd8e8d2b1807ea720e392e476720f681dca5"] :db/ensure [:answer-field/validate]} {:db/id "q-72916" :question/id #uuid "04a7df76-fdad-5064-a73d-c8fa2bdb8720" :question/math-academy-id "q-72916" :question/problem "Determine the points where the ellipse ${x}^{2}+{y}^{2}-2x-12y+35=0$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-2x-12y+35 & =0 \\\\ {0}^{2}+{y}^{2}-2(0)-12y+35 & =0 \\\\ {y}^{2}-12y+35 & =0 \\\\ (y-6)^{2}-36+35 & =0 \\\\ (y-6)^{2} & =1 \\\\ y-6 & =\\pm 1 \\\\ y & =6\\pm 1 \\\\ y & =5,\\,7\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at $(0,5)$ and $(0,7).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72916/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-72916"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327148/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6ea08dd6-6a69-50f6-a4c6-a49715cace38" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-327148/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7a5bbf6c-e006-5462-96c2-01a04a7d3215" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-327148/field-1" :answer-field/id #uuid "0b420753-4fe9-5574-8fbd-9c1fec598750" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327148/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-327148/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-327148/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-327148/field-2/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "7903531c-ae30-505e-a66f-7a39f8247464" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-327148/field-2" :answer-field/id #uuid "1b796882-9ebf-5199-84e3-4840db2fe99e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-327148/field-2/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-327148/field-2/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-327148" :question/id #uuid "2c3360fd-5dbf-5830-b141-90394d4fbf4d" :question/math-academy-id "q-327148" :question/problem "Calculate the point where the ellipse $3{x}^{2}+{y}^{2}-12x+y+\\frac{1}{4}=0$ intercepts the $y$-axis.\n\nThe $y$-intercept is $($\n{{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}3{x}^{2}+{y}^{2}-12x+y+\\frac{1}{4} & =0 \\\\ 3(0)^{2}+{y}^{2}-12(0)+y+\\frac{1}{4} & =0 \\\\ {y}^{2}+y+\\frac{1}{4} & =0 \\\\ {(y+\\frac{1}{2})}^{2} & =0 \\\\ y+\\frac{1}{2} & =0 \\\\ y & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,-\\frac{1}{2}\\,).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/assets/94a5bd2df6ae6177e62b66a0a978a358d73fed255e425337812887c81b9d2d10.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-327148/field-1" "q-327148/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-327148"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274502/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "030c1d50-b0c4-540b-b069-c27f8d8ba509" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-274502/field-1" :answer-field/id #uuid "55d3a3e0-64e0-5c6f-9933-31ed75050903" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274502/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-274502/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-274502/field-2/16de07eaae11d40a49bacf0420b0168855d5723f6d7bcd072f74c1de5e68e97a" :answer/id #uuid "2fb58b5d-2122-500e-a810-9489dfb9887f" :answer/type :answer.type/math :answer/value "4+\\frac{1}{2}\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-274502/field-2" :answer-field/id #uuid "dd7af845-2aff-51a0-a3f1-a1945da83997" :answer-field/key "field-2" :answer-field/type :answer-field.ty