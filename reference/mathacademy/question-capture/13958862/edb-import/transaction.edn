ection/26b096bce36c63f274eed2844a7d3b09612ebc01a12309c05b9eb1ada685d00e" :answer/id #uuid "6ced310b-9b2e-548d-bbf9-0e02d29676a9" :answer/type :answer.type/math :answer/value "(\\pm 2,0)" :db/ensure [:answer/validate]} {:db/id "q-9459/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" :answer/id #uuid "c796be52-994c-50a8-b09f-20c40faa8b67" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "q-9459/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" :answer/id #uuid "cbec2441-5de7-517e-805e-fc67fa20e287" :answer/type :answer.type/text :answer/value "There is no $x$-intercept" :db/ensure [:answer/validate]} {:db/id "q-9459/selection/f3b15f9080639a787097d8b780ade7100103852ae38e37130300d2afcd5c2f1d" :answer/id #uuid "92186fa4-8322-5140-929f-04e1a15c6500" :answer/type :answer.type/math :answer/value "(-3,0)" :db/ensure [:answer/validate]} {:db/id "q-9459/selection" :answer-field/id #uuid "b6343e8f-c120-515d-85fa-280967d37a99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9459/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" :answer-field/choices ["q-9459/selection/ed63d48d82acb9f420f517e546e18ee53ac269c10cb34faeac60d635cfd2dbb5" "q-9459/selection/26b096bce36c63f274eed2844a7d3b09612ebc01a12309c05b9eb1ada685d00e" "q-9459/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" "q-9459/selection/3bd45debee7b0d8601f1f10f0ea3890d1173d903090c37b4d5442f224a5ae970" "q-9459/selection/f3b15f9080639a787097d8b780ade7100103852ae38e37130300d2afcd5c2f1d"] :db/ensure [:answer-field/validate]} {:db/id "q-9459" :question/id #uuid "351fc780-ed79-58f1-9956-c43cfd213368" :question/math-academy-id "q-9459" :question/problem "Calculate the points where the ellipse $2{x}^{2}+{y}^{2}-20x+6y+51=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}2{x}^{2}+{y}^{2}-20x+6y+51 & =0 \\\\ 2{x}^{2}+{0}^{2}-20x+6\\cdot 0+51 & =0 \\\\ 2{x}^{2}-20x+51 & =0 \\\\ 2[{x}^{2}-10x]+51 & =0 \\\\ 2[(x-5)^{2}-25]+51 & =0 \\\\ 2(x-5)^{2}-50+51 & =0 \\\\ 2(x-5)^{2}+1 & =0 \\\\ 2(x-5)^{2} & =-1.\\end{aligned}\n$$\n\nSince $2(x-5)^{2}\\ge 0$, there is no $x$ such that $2(x-5)^{2}=-1.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9459/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-9459"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7644/selection/a32d68d3c18ab3ad9c3e89feddd7905742ecc61ee38e2abcd40e04a42e8093e5" :answer/id #uuid "2265f0eb-4545-5546-b55c-b52caa26f4e0" :answer/type :answer.type/math :answer/value "(0,\\pm 6)" :db/ensure [:answer/validate]} {:db/id "q-7644/selection/4bc8f47874351dad0bf704d35e02c67a2f98a6be49c7acf232f37c3117e6e7bc" :answer/id #uuid "8aebb2bb-2250-5b1f-a2f7-f64e96e8412f" :answer/type :answer.type/text :answer/value "$(0,0)$ and $(0,6)$" :db/ensure [:answer/validate]} {:db/id "q-7644/selection/629032895e7605a24a4afd3b568def84344a64cb3574ce45730653a0d305d70b" :answer/id #uuid "214916ca-85f8-5e87-a27f-4f22cb2437f1" :answer/type :answer.type/text :answer/value "$(0,-6)$ and $(0,0)$" :db/ensure [:answer/validate]} {:db/id "q-7644/selection/312ea466adb292063ea5a2765cf2b4103e29241e352f1ec42d33c9e41681b0cc" :answer/id #uuid "e36fa9dc-63d5-50aa-ace6-d98ac90fac29" :answer/type :answer.type/text :answer/value "$(0,3)$ and $(0,6)$" :db/ensure [:answer/validate]} {:db/id "q-7644/selection/33bc0462919d6e5a6e0723636b0950692f62da2c66c3ad7d192107d51b511c74" :answer/id #uuid "ded12638-7501-598e-bde6-e1eb1eb5844