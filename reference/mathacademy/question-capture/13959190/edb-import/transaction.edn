58be9222e424c6bcbe97503784e7ed1449f0338004a9c47bd20461a63f03" "q-15691/selection/5ba13f2e2ce31ef1db9f2aedfd12436fc89528809fe9bc5fbab0ac27e8fd57bd" "q-15691/selection/edfa52a18ab67b962fef8f676171c28872d6e81aefbe1bd63c8dc2453d9e20a0"] :db/ensure [:answer-field/validate]} {:db/id "q-15691" :question/id #uuid "29d9da5c-80e6-50a1-9b76-879967d6afda" :question/math-academy-id "q-15691" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/4466cdfbce1903942ae6aa857cec8e831f0e7f819f2e6771086919918d8f4110.png)\n\nFind the $y$-intercepts of the circle $(x-3)^{2}+(y-1)^{2}=16,$ shown above." :question/worked-solution "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(x-3)^{2}+(y-1)^{2} & =16 \\\\ (0-3)^{2}+(y-1)^{2} & =16 \\\\ 9+(y-1)^{2} & =16 \\\\ (y-1)^{2} & =7 \\\\ y-1 & =\\pm \\sqrt{7} \\\\ y & =1\\pm \\sqrt{7}.\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts occur at the points $(0,1-\\sqrt{7})$ and $(0,1+\\sqrt{7}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15691/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e"] :knowledge-point/questions ["q-15691"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8794/selection/aca3fb0d9ddb49350c290ac929c3cc1d4fe3619668acb3d7b8d6d89671359f83" :answer/id #uuid "862590b2-6239-5f26-9af2-bae9d320d21c" :answer/type :answer.type/math :answer/value "(0,3)" :db/ensure [:answer/validate]} {:db/id "q-8794/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" :answer/id #uuid "7abc7073-007f-5014-b1e6-9f429626ca83" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "q-8794/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" :answer/id #uuid "363723c5-f847-5c72-ab88-ef9b79c6a5b5" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "q-8794/selection/6044746d81a998f29c58985dbf134c104c838c50c710fbac3b136834478dc847" :answer/id #uuid "346a216a-762a-5172-ba82-1bc90c0b8aa6" :answer/type :answer.type/math :answer/value "(0,-1)" :db/ensure [:answer/validate]} {:db/id "q-8794/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" :answer/id #uuid "8b29add4-9643-5235-9826-dc3fc1865863" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "q-8794/selection" :answer-field/id #uuid "a01b237d-38aa-5f23-95fe-7b9c76f4309f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8794/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" :answer-field/choices ["q-8794/selection/aca3fb0d9ddb49350c290ac929c3cc1d4fe3619668acb3d7b8d6d89671359f83" "q-8794/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" "q-8794/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" "q-8794/selection/6044746d81a998f29c58985dbf134c104c838c50c710fbac3b136834478dc847" "q-8794/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f"] :db/ensure [:answer-field/validate]} {:db/id "q-8794" :question/id #uuid "5cbb3827-affd-5557-9bcc-dc99637fb97d" :question/math-academy-id "q-8794" :question/problem "Calculate the $y$-intercept of the circle ${x}^{2}+{y}^{2}+4x-2y+1=0.$" :question/worked-solution "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve the resulting equation for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-2y+1 & =0 \\\\ {0}^{2}+{y}^{2}+4\\cdot 0-2y+1 & =0 \\\\ {y}^{2}-2y+1 & =0 \\\\ (y-1)^{2} & =0 \\\\ y-1 & =0 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, $y$-intercept occurs at the point $(0,1),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/87766af5840b6b3729fa200d383e18c5f7926d9000633f99b481e8b4a6922732.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8794/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e"] :knowledge-point/questions ["q-8794"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7541/selection/6266812729f006929cce7dcb97f415e8da4a1c6b95b716eeba0c736e07fe023a" :answer/id #uuid "2c457160-b00f-54f1-ade5-bbdd8d4ed1c1" :answer/type :answer.type/text :answer/value "$(0,-64)$ and $(0,64)$" :db/ensure [:answer/validate]} {:db/id "q-7541/selection/4e0f4881bece39348471c11cf6e6984982ff829239d82509dbbed3e7dfd4e130" :answer/id #uuid "f55a9efb-ade0-54c8-97a8-a5a2a84e90e5" :answer/type :answer.type/text :answer/value "$(0,-\\sqrt{3})$ and $(0,\\sqrt{3})$" :db/ensure [:answer/validate]} {:db/id "q-7541/selection/8e8551266b0c2ea9f272392847eb34be87889c193de8588fe7634b04410e416a" :answer/id #uuid "070db0b8-ee36-59b2-9d7f-3aa08f4b409a" :answer/type :answer.type/text :answer/value "$(0,-4)$ and $(0,4)$" :db/ensure [:answer/validate]} {:db/id "q-7541/selection/2060a897db4807e4ff18bf172bb7df41ae342190cc0bee684b5ffa3826baee1d" :answer/id #uuid "781d0282-5d88-5f76-925f-eaaf0598d46e" :answer/type :answer.type/text :answer/value "$(0,-2\\sqrt{2})$ and $(0,2\\sqrt{2})$" :db/ensure [:answer/validate]} {:db/id "q-7541/selection/2c8e34cab4c1ede8456d4b3d7b64e9750c5393e4afb3650b5e12f9ae397ee920" :answer/id #uuid "2f7fdbd6-2e40-5aa7-a80b-7ef24ee8fed3" :answer/type :answer.type/text :answer/value "$(0,-8)$ and $(0,8)$" :db/ensure [:answer/validate]} {:db/id "q-7541/selection" :answer-field/id #uuid "220d46e7-78a0-5757-b155-742f09840087" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7541/selection/2c8e34cab4c1ede8456d4b3d7b64e9750c5393e4afb3650b5e12f9ae397ee920" :answer-field/choices ["q-7541/selection/6266812729f006929cce7dcb97f415e8da4a1c6b95b716eeba0c736e07fe023a" "q-7541/selection/4e0f4881bece39348471c11cf6e6984982ff829239d82509dbbed3e7dfd4e130" "q-7541/selection/8e8551266b0c2ea9f272392847eb34be87889c193de8588fe7634b04410e416a" "q-7541/selection/2060a897db4807e4ff18bf172bb7df41ae342190cc0bee684b5ffa3826baee1d" "q-7541/selection/2c8e34cab4c1ede8456d4b3d7b64e9750c5393e4afb3650b5e12f9ae397ee920"] :db/ensure [:answer-field/validate]} {:db/id "q-7541" :question/id #uuid "b2b39999-a8e4-57a7-ab96-4715ec5c76ca" :question/math-academy-id "q-7541" :question/problem "Find the $y$-intercepts of the circle ${x}^{2}+{y}^{2}=64.$" :question/worked-solution "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =64 \\\\ {0}^{2}+{y}^{2} & =64 \\\\ {y}^{2} & =64 \\\\ y & =\\pm \\sqrt{64} \\\\ y & =\\pm 8\\end{aligned}\n$$\n\nTherefore, $y$-intercepts occur at the points $(0,-8)$ and $(0,8),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/90fc285151a5f549992e3c40ba6cff89532398808d6194fdf7922108b73646ef.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7541/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e"] :knowledge-point/questions ["q-7541"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160272/selection/c7d7f5865a04f287adfbc7ccac92458329d02c053e1fa27cc0df187ff8f49c48" :answer/id #uuid "4a515f53-0ed3-5dca-8ffe-a6fda60873fe" :answer/type :answer.type/math :answer/value "(0,-4)" :db/ensure [:answer/validate]} {:db/id "q-160272/selection/954bd43fb4028cba9be5777429bd326de5fcd18e613d2a5294639c8537e87abb" :answer/id #uuid "1349e6f0-2289-55e4-93ec-b2ad8f16b6f0" :answer/type :answer.type/text :answer/value "$(0,-1)$ and $(0,1)$" :db/ensure [:answer/validate]} {:db/id "q-160272/selection/f6abd47f0a9efd05e00047c85cca8b635675ee971f398250c5220e7c31e050b7" :answer/id #uuid "61a3cfe9-fbfb-501a-9c5c-6eac1308683f" :answer/type :answer.type/text :answer/value "$(0,-7)$ and $(0,-1)$" :db/ensure [:answer/validate]} {:db/id "q-160272/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" :answer/id #uuid "af74ac86-06fd-5d63-a4e4-45c8bfb8357d" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "q-160272/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63" :answer/id #uuid "7a540a32-1f0e-5244-9c2f-533e28055674" :answer/type :answer.type/text :answer/value "The circle has no $y$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-160272/selection" :answer-field/id #uuid "ca2a37aa-af08-58f9-aa50-893dda7203bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160272/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63" :answer-field/choices ["q-160272/selection/c7d7f5865a04f287adfbc7ccac92458329d02c053e1fa27cc0df187ff8f49c48" "q-160272/selection/954bd43fb4028cba9be5777429bd326de5fcd18e613d2a5294639c8537e87abb" "q-160272/selection/f6abd47f0a9efd05e00047c85cca8b635675ee971f398250c5220e7c31e050b7" "q-160272/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" "q-160272/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63"] :db/ensure [:answer-field/validate]} {:db/id "q-160272" :question/id #uuid "26d19767-6cb6-5671-822b-38e5862a3bbc" :question/math-academy-id "q-160272" :question/problem "Calculate the $y$-intercepts of the circle $(x-4)^{2}+(y+4)^{2}=9.$" :question/worked-solution "When the circle intercepts the $y$-axis, we must have $x=0.$\n\nSo, we need to substitute $x=0$ into the equation of the circle and solve the resulting equation for $y$, if possible:\n\n$$\n\\begin{aligned}(x-4)^{2}+(y+4)^{2} & =9 \\\\ (0-4)^{2}+(y+4)^{2} & =9 \\\\ 16+(y+4)^{2} & =9 \\\\ (y+4)^{2} & =-7.\\end{aligned}\n$$\n\nSince $(y+4)^{2}\\ge 0$ for all values of $y,$ there is no $y$ such that $(y+4)^{2}=-7.$ Therefore, the circle does not intercept the $y$-axis at any point, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/2442ca38770f2f82e2e9c536632e8474adb75e04504a4273987989bb3d81b282.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-160272/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6"] :knowledge-point/questions ["q-160272"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-8801"] :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-2)^{2} & =3 \\\\ (x+3)^{2}+(0-2)^{2} & =3 \\\\ (x+3)^{2}+4 & =3 \\\\ (x+3)^{2} & =-1.\\end{aligned}\n$$\n\nSince $(x+3)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x+3)^{2}=-1.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/cb8a943a6f6cfd49e47c193f5379e06fd166cd17087c890233b42a7e1e7d2b89.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-160286/selection/37ee186ccc603c7053a2f501fb8a99e93b20d907c402f82df4d4febe1209fab9" :answer/id #uuid "617357b4-289b-538c-b217-0c0ded8e0779" :answer/type :answer.type/text :answer/value "$(-5,0)$ and $(12,0)$" :db/ensure [:answer/validate]} {:db/id "q-160286/selection/566c033cc670f2eeb576d333926890b0dcdb71cae9a92ce2d64ad76e8173074e" :answer/id #uuid "8d97a31f-4600-5899-8782-618d32a0bde2" :answer/type :answer.type/math :answer/value "(4,0)" :db/ensure [:answer/validate]} {:db/id "q-160286/selection/def87218b171f462c59d9a54ea7ed5333fbb4092a64fa29a5ff568451524fc48" :answer/id #uuid "431c93d4-6b45-5cc5-9206-0dd6e6594267" :answer/type :answer.type/text :answer/value "$(-6,0)$ and $(-2,0)$" :db/ensure [:answer/validate]} {:db/id "q-160286/selection/e03b06bf248cd662e61b3dea2ac75da56aa7449dc8bb6e4b62f259b0801107e1" :answer/id #uuid "296a331e-81c0-521f-b671-4e6e84d7ccc5" :answer/type :answer.type/math :answer/value "(-4,0)" :db/ensure [:answer/validate]} {:db/id "q-160286/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5" :answer/id #uuid "c2f25041-4a4a-51d2-990a-8422d912e219" :answer/type :answer.type/text :answer/value "The circle has no $x$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-160286/selection" :answer-field/id #uuid "8a2d023b-07b4-58b0-a1cf-3b4676decdb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160286/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5" :answer-field/choices ["q-160286/selection/37ee186ccc603c7053a2f501fb8a99e93b20d907c402f82df4d4febe1209fab9" "q-160286/selection/566c033cc670f2eeb576d333926890b0dcdb71cae9a92ce2d64ad76e8173074e" "q-160286/selection/def87218b171f462c59d9a54ea7ed5333fbb4092a64fa29a5ff568451524fc48" "q-160286/selection/e03b06bf248cd662e61b3dea2ac75da56aa7449dc8bb6e4b62f259b0801107e1" "q-160286/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5"] :db/ensure [:answer-field/validate]} {:db/id "q-160286" :question/id #uuid "75748ec5-c482-5439-91c2-00c020d6415b" :question/math-academy-id "q-160286" :question/problem "Calculate the $x$-intercepts of the circle ${x}^{2}+{y}^{2}+8x-6y+21=0$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+8x-6y+21 & =0 \\\\ {x}^{2}+{0}^{2}+8x-6\\cdot 0+21 & =0 \\\\ {x}^{2}+8x+21 & =0\\end{aligned}\n$$\n\nWe can solve this equation by completing the square, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+8x+16+21 & =0+16 \\\\ (x+4)^{2}+21 & =16 \\\\ (x+4)^{2} & =-5\\end{aligned}\n$$\n\nSince $(x+4)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x+4)^{2}=-5.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/53b8e33665ee3ba0b36d04c9d82715b18505c501db535ecf4a40c48c81814584.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160286/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6"] :knowledge-point/questions ["q-160286"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79044/selection/e9fe7b820804e8e890f362e9ca182a9cfd69ef3f8bd27b6056c1cb62213eaa12" :answer/id #uuid "d51b8305-968a-5af3-9adc-481a1ac8010c" :answer/type :answer.type/math :answer/value "(\\sqrt{11},0)" :db/ensure [:answer/validate]} {:db/id "q-79044/selection/91d27013c76788268e2e33b95f23b5af7cdbb49f9e629538a767340569105ede" :answer/id #uuid "ac011ff3-3ebb-5e07-bc82-18c3da00bc3e" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "q-79044/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5" :answer/id #uuid "3c77d996-98a0-53e9-8d8e-30d0603083f4" :answer/type :answer.type/text :answer/value "The circle has no $x$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-79044/selection/936aeac92b0dc4a5dea79fbc416a69fb046848e5b2368253ba9c680cc33a5c2f" :answer/id #uuid "ca2d8884-19b3-5616-a2b6-3540fb01f857" :answer/type :answer.type/text :answer/value "$(1-\\sqrt{11},0)$ and $(1+\\sqrt{11},0)$" :db/ensure [:answer/validate]} {:db/id "q-79044/selection/cf900056dd5bfa9132bb680f9e14ff2a02c6dc4341c680adb3258c5c68d537aa" :answer/id #uuid "4ff30ae4-14c3-5268-a6fa-8fc0b9d3f34e" :answer/type :answer.type/text :answer/value "$(2,0)$ and $(5,0)$" :db/ensure [:answer/validate]} {:db/id "q-79044/selection" :answer-field/id #uuid "8d45a237-1e48-5551-a790-007c77780796" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79044/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5" :answer-field/choices ["q-79044/selection/e9fe7b820804e8e890f362e9ca182a9cfd69ef3f8bd27b6056c1cb62213eaa12" "q-79044/selection/91d27013c76788268e2e33b95f23b5af7cdbb49f9e629538a767340569105ede" "q-79044/selection/88ef21015a183bb6aa0a1b96ce9abd7299e4995f8ad1b9ff0331caa5dbce45a5" "q-79044/selection/936aeac92b0dc4a5dea79fbc416a69fb046848e5b2368253ba9c680cc33a5c2f" "q-79044/selection/cf900056dd5bfa9132bb680f9e14ff2a02c6dc4341c680adb3258c5c68d537aa"] :db/ensure [:answer-field/validate]} {:db/id "q-79044" :question/id #uuid "f43a31ca-f582-5ca4-a303-c0af1e9c11d4" :question/math-academy-id "q-79044" :question/problem "Calculate the $x$-intercepts of the circle ${x}^{2}+{y}^{2}-2x+6y+12=0$" :question/worked-solution "We must have $y=0$ at the $x$-intercepts.  \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve the resulting equation for $x,$ if possible:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-2x+6y+12 & =0 \\\\ {x}^{2}+{0}^{2}-2x+6\\cdot 0+12 & =0 \\\\ {x}^{2}-2x+12 & =0\\end{aligned}\n$$\n\nWe can solve this equation by completing the square, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1+12 & =0+1 \\\\ (x-1)^{2}+12 & =1 \\\\ (x-1)^{2} & =-11\\end{aligned}\n$$\n\nSince $(x-1)^{2}\\ge 0$ for all values of $x,$ there is no $x$ such that $(x-1)^{2}=-11.$ Therefore, circle has no $x$-intercepts, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/ea1410ea792ac5fb09316bc6d417c2ba46f84c050491b1e351f360eac50deb6c.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79044/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6"] :knowledge-point/questions ["q-79044"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160275/selection/15e624d4be6e8a48442b103de7e4fe367f9631e7450e52865149f62139c6f693" :answer/id #uuid "f80d2f64-e788-5621-b7da-23c2453a1f04" :answer/type :answer.type/text :answer/value "$(0,-\\frac{1}{2})$ and $(0,\\frac{1}{2})$" :db/ensure [:answer/validate]} {:db/id "q-160275/selection/69a1d82660280a0a02928ae449b9b211a3f287b5d1c551b82627e063cc00e5d4" :answer/id #uuid "0cac8261-80b4-5649-bf1c-1e69a56d7d3c" :answer/type :answer.type/math :answer/value "(0,-\\frac{3}{4})" :db/ensure [:answer/validate]} {:db/id "q-160275/selection/66cd7f77eebf623c7803295f487415716a006a1ce7a5b59ddf71f62f79653880" :answer/id #uuid "1e0ec51b-3660-51a8-8a40-4363ad19d3e0" :answer/type :answer.type/text :answer/value "$(0,-\\frac{1}{4})$ and $(0,\\frac{3}{4})$" :db/ensure [:answer/validate]} {:db/id "q-160275/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" :answer/id #uuid "fef2a79c-2a6d-5510-964f-0c0548484a19" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "q-160275/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63" :answer/id #uuid "68c8d89a-acbc-5908-ac1e-e86036864292" :answer/type :answer.type/text :answer/value "The circle has no $y$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-160275/selection" :answer-field/id #uuid "7067af39-0c6e-514e-aa79-74762099ea15" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160275/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63" :answer-field/choices ["q-160275/selection/15e624d4be6e8a48442b103de7e4fe367f9631e7450e52865149f62139c6f693" "q-160275/selection/69a1d82660280a0a02928ae449b9b211a3f287b5d1c551b82627e063cc00e5d4" "q-160275/selection/66cd7f77eebf623c7803295f487415716a006a1ce7a5b59ddf71f62f79653880" "q-160275/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" "q-160275/selection/bc0c1ebd1737ab53576ac8dc074534448f463e2934a8f8ef82e1fc2cc839ae63"] :db/ensure [:answer-field/validate]} {:db/id "q-160275" :question/id #uuid "8baf38e5-4cac-5611-8d4f-60ea7baafdea" :question/math-academy-id "q-160275" :question/problem "Calculate the $y$-intercepts of the circle $(x+1)^{2}+(y+2)^{2}=\\frac{3}{4}.$" :question/worked-solution "When the circle intercepts the $y$-axis, we must have $x=0.$\n\nSo, we need to substitute $x=0$ into the equation of the circle and solve the resulting equation for $y$, if possible:\n\n$$\n\\begin{aligned}(x+1)^{2}+(y+2)^{2} & =\\frac{3}{4} \\\\ (0+1)^{2}+(y+2)^{2} & =\\frac{3}{4} \\\\ 1+(y+2)^{2} & =\\frac{3}{4} \\\\ (y+2)^{2} & =-\\frac{1}{4}.\\end{aligned}\n$$\n\nSince $(y+2)^{2}\\ge 0$ for all values of $y,$ there is no $y$ such that $(y+2)^{2}=-\\frac{1}{4}.$ Therefore, the circle does not intercept the $y$-axis at any point, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/86f198b30096cf3106186ee2595b61c21be000e8e6223c5b42ee453ba1b9fe4a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-160275/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6"] :knowledge-point/questions ["q-160275"] :db/ensure [:knowledge-point/validate]}]
