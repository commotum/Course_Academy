]} {:db/id "q-15681" :question/id #uuid "128b9cef-763e-5aac-a6f0-9eae06355cd4" :question/math-academy-id "q-15681" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/13b9598c77cd522d0d3aeee4f5abd2390822431aa49ed787b73a110113ab821c.png)\n\nFind the $x$-intercepts of the circle $(x+4)^{2}+{y}^{2}=25,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x+4)^{2}+{y}^{2} & =25 \\\\ (x+4)^{2}+{0}^{2} & =25 \\\\ (x+4)^{2} & =25 \\\\ x+4 & =\\pm \\sqrt{25} \\\\ x+4 & =\\pm 5 \\\\ x & =-4\\pm 5\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-9,0)$ and $(1,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15681/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c"] :knowledge-point/questions ["q-15681"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8789/selection/496c165989db454d121366a46cfb48dce9e9c3f27f3cccb0533de3e223068095" :answer/id #uuid "bc0983d8-128f-523d-bfd9-3455323a0dbf" :answer/type :answer.type/text :answer/value "$(4-\\sqrt{5},0)$ and $(4+\\sqrt{5},0)$" :db/ensure [:answer/validate]} {:db/id "q-8789/selection/c1cb369804a179c54b8467eb909724e179dae3b53403f59d7dd693355221182d" :answer/id #uuid "6f8a5b6c-828e-53e3-9366-d9212d783028" :answer/type :answer.type/text :answer/value "$(5-\\sqrt{6},0)$ and $(4+\\sqrt{5},0)$" :db/ensure [:answer/validate]} {:db/id "q-8789/selection/21e50c99be8225c172cbe8b057cf2c841d95184bb96e553889c261bb47df1b8f" :answer/id #uuid "9eddda51-7da5-559b-98c9-47dbe5c56854" :answer/type :answer.type/text :answer/value "$(1.5,0)$ and $(6.5,0)$" :db/ensure [:answer/validate]} {:db/id "q-8789/selection/764d18086f2264dd8ab126158fad7937fbdd9e53d695115a181d2e2557442bb6" :answer/id #uuid "55280699-f27d-5e7f-b8cb-8