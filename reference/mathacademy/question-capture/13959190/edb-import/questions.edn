#{[{:db/id #edb/ref 17592186087401 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/id #uuid "a66e0264-85ff-5ded-af5d-dc17a9278226" :question/math-academy-id "e-3231" :question/problem "Find the $x$-intercepts of the circle $(x + 3)^2 + (y - 2)^2 = 4$." :question/worked-solution "We must have $y = 0$ at the $x$-intercepts.\n\nSo, we need to substitute $y = 0$ into the equation of the circle and solve for $x$, as follows:\n\n$$\n\\begin{aligned}\n(x + 3)^{2} + (y - 2)^{2} &= 4 \\\\\n(x + 3)^{2} + (0 - 2)^{2} &= 4 \\\\\n(x + 3)^{2} + 4 &= 4 \\\\\n(x + 3)^{2} &= 0 \\\\\nx + 3 &= 0 \\\\\nx &= -3\n\\end{aligned}\n$$\n\nTherefore, the $x$-intercept occurs at the point $(-3,0)$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/844/Source/Images/7b22a1d5c4a7451aec2ac41c916b9eed.png)"}] [{:db/id #edb/ref 17592186087402 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6" :knowledge-point/title "Identifying When a Circle Does Not Intersect an Axis"}] :question/id #uuid "905861f1-14b5-59f8-980e-6bd962740620" :question/math-academy-id "e-3232" :question/problem "Calculate the $y$-intercepts of the circle $(x - 3)^2 + (y - 1)^2 = 4$." :question/worked-solution "We must have $x = 0$ at the $y$-intercepts.\n\nSo, we need to substitute $x = 0$ into the equation of the circle and solve the resulting equation for $y$, if possible:\n\n$$\n\\begin{aligned}\n(x - 3)^{2} + (y - 1)^{2} &= 4 \\\\\n(0 - 3)^{2} + (y - 1)^{2} &= 4 \\\\\n9 + (y - 1)^{2} &= 4 \\\\\n(y - 1)^{2} &= -5\n\\end{aligned}\n$$\n\nSince\n\n$$\n(y-1)^2 \\geq 0\n$$\n\nfor all values of $y$, there is no $y$ such that\n\n$$\n(y-1)^2 = -5\n$$\n\nTherefore, the circle has no $y$-intercepts, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/844/Source/Images/95fe7135f0f55209cacb7cc2b7b423fa.png)"}] [{:db/id #edb/ref 17592186087403 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e" :knowledge-point/title "Calculating the Intersection of a Circle With the Y-Axis"}] :question/id #uuid "31c41251-e19b-5933-b5f5-6cee31f7f633" :question/math-academy-id "e-3233" :question/problem "Find the $y$-intercepts of the circle $x^2+y^2+2x-2y= 8$, shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/844/Source/Images/0ca0fbe99c8a02c276d3fd0a1905e8ae.png)" :question/worked-solution "We must have $x = 0$ at the $y$-intercepts.\n\nSo, we need to substitute $x = 0$ into the equation of the circle and solve for $y$, as follows:\n\n$$\n\\begin{aligned}\nx^{2} + y^{2} + 2x - 2y &= 8 \\\\\n(0)^{2} + y^{2} + 2(0) - 2y &= 8 \\\\\ny^{2} - 2y &= 8\n\\end{aligned}\n$$\n\nWe can solve this equation by completing the square, as follows:\n\n$$\n\\begin{aligned}\ny^{2} - 2y + 1 &= 8 + 1 \\\\\n(y - 1)^{2} &= 9 \\\\\ny - 1 &= ± 3 \\\\\ny &= 1 ± 3\n\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts occur at $(0,-2)$ and $(0,4)$."}] [{:db/id #edb/ref 17592186088385 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9faf6d8-0c06-5bf4-bc41-6d68d3d414c6" :knowledge-point/title "Identifying When a Circle Does Not Intersect an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f34793f4-d1bc-55ef-ae53-5c1f899e1dca" :answer/type {:db/ident :answer.type/text} :answer/value "The circle has no $x$-intercepts" :db/id #edb/ref 17592186087241} {:answer/id #uuid "2cf2c342-a2a1-504b-9f09-bce2765f6388" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4, 0)$ and $(-2, 0)$" :db/id #edb/ref 17592186087242} {:answer/id #uuid "3bb476fe-3ff9-5dd8-a59a-816f32f1cc85" :answer/type {:db/ident :answer.type/math} :answer/value "(-3, 0)" :db/id #edb/ref 17592186087243} {:answer/id #uuid "4e729635-4669-5cc0-a772-4b13036834c7" :answer/type {:db/ident :answer.type/math} :answer/value "(3, 0)" :db/id #edb/ref 17592186087244} {:answer/id #uuid "526883e8-3397-542b-8212-e2dc7e759528" :answer/type {:db/ident :answer.type/text} :answer/value "$(4, 0)$ and $(2, 0)$" :db/id #edb/ref 17592186087245}] :answer-field/correct {:answer/id #uuid "f34793f4-d1bc-55ef-ae53-5c1f899e1dca" :answer/type {:db/ident :answer.type/text} :answer/value "The circle has no $x$-intercepts" :db/id #edb/ref 17592186087241} :answer-field/id #uuid "b85c01aa-1d3f-537a-9d1a-63a72a7d7810" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087240}] :question/id #uuid "fb231c9b-8ce3-5939-ba7a-76e32364f988" :question/math-academy-id "q-8801" :question/problem "Calculate the $x$-intercepts of the circle $(x + 3)^{2} + (y - 2)^{2} = 3$"}]}
