6 13194139533945 true] [17592186267771 1040 #edb/ref 17592186045450 13194139533945 true] [17592186267771 1041 "selection" 13194139533945 true] [17592186267771 1104 #edb/ref 17592186267775 13194139533945 true] [17592186267771 1110 #uuid "b1ba8ed2-95db-56f3-a55d-b7f0d8bdec6a" 13194139533945 true] [17592186267772 1034 "$(5-\\sqrt{6},0)$ and $(5+\\sqrt{3},0)$" 13194139533945 true] [17592186267772 1103 #edb/ref 17592186045454 13194139533945 true] [17592186267772 1111 #uuid "756f46d3-5b70-5001-bccc-09df1ee2b662" 13194139533945 true] [17592186267773 1034 "$(1.5,0)$ and $(6.5,0)$" 13194139533945 true] [17592186267773 1103 #edb/ref 17592186045454 13194139533945 true] [17592186267773 1111 #uuid "9eddda51-7da5-559b-98c9-47dbe5c56854" 13194139533945 true] [17592186267774 1034 "$(4-\\sqrt{5},0)$ and $(4+\\sqrt{5},0)$" 13194139533945 true] [17592186267774 1103 #edb/ref 17592186045454 13194139533945 true] [17592186267774 1111 #uuid "bc0983d8-128f-523d-bfd9-3455323a0dbf" 13194139533945 true] [17592186267775 1034 "$(4-\\sqrt{6},0)$ and $(4+\\sqrt{6},0)$" 13194139533945 true] [17592186267775 1103 #edb/ref 17592186045454 13194139533945 true] [17592186267775 1111 #uuid "55280699-f27d-5e7f-b8cb-82f2b53f6041" 13194139533945 true] [17592186267776 1034 "$(5-\\sqrt{6},0)$ and $(4+\\sqrt{5},0)$" 13194139533945 true] [17592186267776 1103 #edb/ref 17592186045454 13194139533945 true] [17592186267776 1111 #uuid "6f8a5b6c-828e-53e3-9366-d9212d783028" 13194139533945 true] [17592186267777 1017 #edb/ref 17592186267778 13194139533945 true] [17592186267777 1089 "q-8794" 13194139533945 true] [17592186267777 1091 #edb/ref 17592186045465 13194139533945 true] [17592186267777 1100 "Calculate the $y$-intercept of the circle ${x}^{2}+{y}^{2}+4x-2y+1=0.$" 13194139533945 true] [17592186267777 1113 #uuid "5cbb3827-affd-5557-9bcc-dc99637fb97d" 13194139533945 true] [17592186267777 1145 "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve the resulting equation for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-2y+1 & =0 \\\\ {0}^{2}+{y}^{2}+4\\cdot 0-2y+1 & =0 \\\\ {y}^{2}-2y+1 & =0 \\\\ (y-1)^{2} & =0 \\\\ y-1 & =0 \\\\ y & =1\\end{aligned}\n$$\n\nTherefore, $y$-intercept occurs at the point $(0,1),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959190/assets/87766af5840b6b3729fa200d383e18c5f7926d9000633f99b481e8b4a6922732.png)" 13194139533945 true] [17592186267778 1000 #edb/ref 17592186267779 13194139533945 true] [17592186267778 1000 #edb/ref 17592186267780 13194139533945 true] [17592186267778 1000 #edb/ref 17592186267781 13194139533945 true] [17592186267778 1000 #edb/ref 17592186267782 13194139533945 true] [17592186267778 1000 #edb/ref 17592186267783 13194139533945 true] [17592186267778 1040 #edb/ref 17592186045450 13194139533945 true] [17592186267778 1041 "selection" 13194139533945 true] [17592186267778 1104 #edb/ref 17592186267779 13194139533945 true] [17592186267778 1110 #uuid "a01b237d-38aa-5f23-95fe-7b9c76f4309f" 13194139533945 true] [17592186267779 1034 "(0,1)" 13194139533945 true] [17592186267779 1103 #edb/ref 17592186045453 13194139533945 true] [17592186267779 1111 #uuid "8b29add4-9643-5235-9826-dc3fc1865863" 13194139533945 true] [17592186267780 1034 "(0,-1)" 13194139533945 true] [17592186267780 1103 #edb/ref 17592186045453 13194139533945 true] [17592186267780 1111 #uuid "346a216a-762a-5172-ba82-1bc90c0b8aa6" 13194139533945 true] [17592186267781 1034 "(0,2)" 13194139533945 true] [17592186267781 1103 #edb/ref 17592186045453 13194139533945 true] [17592186267781 1111 #uuid "7abc7073-007f-5014-b1e6-9f429626ca83" 13194139533945 true] [17592186267782 1034 "(0,3)" 13194139533945 true] [17592186267782 1103 #edb/ref 17592186045453 13194139533945 true] [17592186267782 1111 #uuid "862590b2-6239-5f26-9af2-bae9d320d21c" 13194139533945 true] [17592186267783 1034 "(0,-2)" 13194139533945 true] [17592186267783 1103 #edb/ref 17592186045453 131941395