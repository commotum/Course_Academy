swer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186264042} {:answer/id #uuid "2f1b5d97-5ec1-5e85-8737-9bb8cce1ff84" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264043}] :answer-field/correct {:answer/id #uuid "2f1b5d97-5ec1-5e85-8737-9bb8cce1ff84" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264043} :answer-field/id #uuid "a6e09799-9bc2-5272-8ef8-f213975da0e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264041} {:answer-field/choices [{:answer/id #uuid "bc23788e-9f57-5b22-9ce4-48ed37fd0879" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264045}] :answer-field/correct {:answer/id #uuid "bc23788e-9f57-5b22-9ce4-48ed37fd0879" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264045} :answer-field/id #uuid "b8b10d3f-c340-5ef9-83bc-4d70b28d2be9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264044}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e8ba7aa2-c477-5d4b-a6c3-8f56b95fb6f7" :question/math-academy-id "q-328391" :question/problem "The center of the hyperbola $9{y}^{2}-{x}^{2}+54y+10x=-20$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-{x}^{2}+54y+10x & =-20 \\\\ 9{y}^{2}+54y-{x}^{2}+10x & =-20 \\\\ 9[{y}^{2}+6y]-[{x}^{2}-10x] & =-20 \\\\ 9[(y+3)^{2}-9]-[(x-5)^{2}-25] & =-20 \\\\ 9(y+3)^{2}-81-(x-5)^{2}+25 & =-20 \\\\ 9(y+3)^{2}-(x-5)^{2} & =-20+81-25 \\\\ 9(y+3)^{2}-(x-5)^{2} & =36 \\\\ \\frac{(y+3)^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1 \\\\ \\frac{(y-(-3))^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,-3\\,).$"}] [{:db/id #edb/ref 17592186264046 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b883e4f-40f4-5477-a59c-507110d58207" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264048}] :answer-field/correct {:answer/id #uuid "7b883e4f-40f4-5477-a59c-507110d58207" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264048} :answer-field/id #uuid "fe779c7f-2523-50c7-93c9-2b04be90f886" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264047} {:answer-field/choices [{:answer/id #uuid "c1fc9138-91d5-59c6-9dc3-708b62ae9036" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264050}] :answer-field/correct {:answer/id #uuid "c1fc9138-91d5-59c6-9dc3-708b62ae9036" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264050} :answer-field/id #uuid "f3f3a879-6370-5c22-a604-b08081154ad1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264049}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aa53e21b-f9a9-54c9-a82e-86616efd16dc" :question/math-academy-id "q-328439" :question/problem "The center of the hyperbola $16{x}^{2}-9{y}^{2}-54y=-63$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-9{y}^{2}-54y & =-63 \\\\ 16{x}^{2}-[\\,9{y}^{2}+54y\\,] & =-63 \\\\ 16{x}^{2}-[\\,9({y}^{2}+6y)\\,] & =-63 \\\\ 16{x}^{2}-[\\,9((y+3)^{2}-9)\\,] & =-63 \\\\ 16{x}^{2}-9(y+3)^{2}+81 & =-63 \\\\ 16{x}^{2}-9(y+3)^{2} & =-63-81 \\\\ 16{x}^{2}-9(y+3)^{2} & =-144 \\\\ \\frac{(y+3)^{2}}{{4}^{2}}-\\frac{{x}^{2}}{{3}^{2}} & =1 \\\\ \\frac{(y-(-3))^{2}}{{4}^{2}}-\\frac{{x}^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,0,-3\\,).$"}] [{:db/id #edb/ref 17592186264051 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0de7b26-d307-5f57-b951-026e0dddb2c3" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186264053} {:answer/id #uuid "3c81bd44-0772-5a96-b2ae-0781d48192a2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186264054} {:answer/id #uuid "5d4eba68-3465-5bac-a47a-b9896e37ef4b" :answer/type {:db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186264055} {:answer/id #uuid "56eab84c-e3fa-5567-8de6-7320db752127" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,4)" :db/id #edb/ref 17592186264056} {:answer/id #uuid "17666822-18a3-5d01-bc8b-d1accb8ebc18" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-5)" :db/id #edb/ref 17592186264057}] :answer-field/correct {:answer/id #uuid "3c81bd44-0772-5a96-b2ae-0781d48192a2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186264054} :answer-field/id #uuid "9395b02c-54a3-5088-94a3-7cbee74d68b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264052}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "78e77b18-55d5-5af6-9cdd-0206c1c2bcbf" :question/math-academy-id "q-78356" :question/problem "What is the center of the hyperbola $\\frac{(x-5)^{2}}{25}-\\frac{(y+2)^{2}}{8}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-5)^{2}}{25}-\\frac{(y-(-2))^{2}}{8}=1\n$$\n\nIn this case, $h=5$ and $k=-2.$\n\nTherefore, the center of the hyperbola is $(5,-2).$"}] [{:db/id #edb/ref 17592186264058 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497cdc95-c50d-5298-baba-6d1ae1802e59" :answer/type {:db/ident :answer.type/math} :answer/value "(6,9)" :db/id #edb/ref 17592186264060} {:answer/id #uuid "0c9aa5c6-04aa-5dc6-a6f3-34b0fd557dc3" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186264061} {:answer/id #uuid "478c00d4-b26e-5865-a66d-153e3da485c1" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186264062} {:answer/id #uuid "46662acd-00cb-5cdc-8797-d45261ea0904" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186264063} {:answer/id #uuid "3b179b00-2c55-5cb5-acb2-7fe6996cfe22" :answer/type {:db/ident :answer.type/math} :answer/value "(3,6)" :db/id #edb/ref 17592186264064}] :answer-field/correct {:answer/id #uuid "478c00d4-b26e-5865-a66d-153e3da485c1" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186264062} :answer-field/id #uuid "a9e4b4ad-d430-5d15-9844-b414a6cf495a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264059}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0757e929-9428-56e6-9794-2fa909206184" :question/math-academy-id "q-78379" :question/problem "What is the center of the hyperbola \n$-3{x}^{2}+2{y}^{2}+12x-12y=12?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-3{x}^{2}+2{y}^{2}+12x-12y & =12 \\\\ 2{y}^{2}-12y-3{x}^{2}+12x & =12 \\\\ 2[{y}^{2}-6y]-3[{x}^{2}-4x] & =12 \\\\ 2[(y-3)^{2}-9]-3[(x-2)^{2}-4] & =12 \\\\ 2(y-3)^{2}-18-3(x-2)^{2}+12 & =12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =12+18-12 \\\\ 2(y-3)^{2}-3(x-2)^{2} & =18 \\\\ \\frac{(y-3)^{2}}{9}-\\frac{(x-2)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center is $(2,3).$"}] [{:db/id #edb/ref 17592186264065 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e157b772-ba84-50df-baba-164296320193" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186264067} {:answer/id #uuid "1ab443f0-106f-50b8-809a-4a4f0acb65fe" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186264068} {:answer/id #uuid "06ca6a2e-4455-5322-8752-4cfea94c0157" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186264069} {:answer/id #uuid "a688d7fa-c6ce-5c93-9778-8e520508e6a9" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186264070} {:answer/id #uuid "23438b5f-9721-5273-94c5-d8a247c141c4" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186264071}] :answer-field/correct {:answer/id #uuid "06ca6a2e-4455-5322-8752-4cfea94c0157" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186264069} :answer-field/id #uuid "7b9f66f0-12f1-5ace-a8f3-d476e4f05cf1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264066}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "45f8a767-fd63-5ed1-aa77-8691f5b484a8" :question/math-academy-id "q-78860" :question/problem "What is the center of the hyperbola $\\frac{{x}^{2}}{2}-\\frac{(y-3)^{2}}{3}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-0)^{2}}{2}-\\frac{(y-3)^{2}}{3}=1\n$$\n\nIn this case, $h=0$ and $k=3.$\n\nTherefore, the center of the hyperbola is $(0,3).$"}] [{:db/id #edb/ref 17592186264072 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a61e30ca-5d7f-5a75-a2a1-9a7d3fb78bbb" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186264074} {:answer/id #uuid "9f1377b0-b2cd-5848-b294-ffc6b3b40972" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186264075} {:answer/id #uuid "0ca48556-b350-5041-b320-020291c6f348" :answer/type {:db/ident :answer.type/math} :answer/value "(4,3)" :db/id #edb/ref 17592186264076} {:answer/id #uuid "5dc4e9c4-23e1-57a0-b975-e4c0a728edd2" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186264077} {:answer/id #uuid "f7bb4939-294f-5618-a36d-8418456096a0" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186264078}] :answer-field/correct {:answer/id #uuid "5dc4e9c4-23e1-57a0-b975-e4c0a728edd2" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186264077} :answer-field/id #uuid "77978dd7-71b0-5ba8-973d-45ec3ba7b353" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264073}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4c87b48a-fbce-5db9-8479-e71f620c1acc" :question/math-academy-id "q-78870" :question/problem "What is the center of the hyperbola \n$3{x}^{2}-4{y}^{2}-12x+24y=36?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-4{y}^{2}-12x+24y & =36 \\\\ 3{x}^{2}-12x-4{y}^{2}+24y & =36 \\\\ 3[{x}^{2}-4x]-4[{y}^{2}-6y] & =36 \\\\ 3[(x-2)^{2}-4]-4[(y-3)^{2}-9] & =36 \\\\ 3(x-2)^{2}-12-4(y-3)^{2}+36 & =36 \\\\ 3(x-2)^{2}-4(y-3)^{2} & =12 \\\\ \\frac{(x-2)^{2}}{4}-\\frac{(y-3)^{2}}{3} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(2,3).$"}] [{:db/id #edb/ref 17592186264079 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfcad828-4b5b-59a2-9f16-46d3dec22251" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186264081} {:answer/id #uuid "246abdb3-c14e-5df5-b45b-4d68be2c2b14" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186264082} {:answer/id #uuid "f13cfd65-5ba2-54ba-92dd-1a5112bd83a1" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186264083} {:answer/id #uuid "2801931e-76c7-5661-bdce-5a2590f75215" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186264084} {:answer/id #uuid "6a088f27-0020-5d1f-9a2b-2fb98c8c0a5e" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-5)" :db/id #edb/ref 17592186264085}] :answer-field/correct {:answer/id #uuid "bfcad828-4b5b-59a2-9f16-46d3dec22251" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id #edb/ref 17592186264081} :answer-field/id #uuid "a11f14ff-cd4d-5c12-8354-3b0ce9dfc15d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264080}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3babff1-65de-5c70-a4ed-af37ba689a9c" :question/math-academy-id "q-78871" :question/problem "What is the center of the hyperbola \n$2{x}^{2}-{y}^{2}-20x-2y=-47?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-{y}^{2}-20x-2y & =-47 \\\\ 2{x}^{2}-20x-{y}^{2}-2y & =-47 \\\\ 2[{x}^{2}-10x]-[{y}^{2}+2y] & =-47 \\\\ 2[(x-5)^{2}-25]-[(y+1)^{2}-1] & =-47 \\\\ 2(x-5)^{2}-50-(y+1)^{2}+1 & =-47 \\\\ 2(x-5)^{2}-(y+1)^{2} & =-47+50-1 \\\\ 2(x-5)^{2}-(y+1)^{2} & =2 \\\\ (x-5)^{2}-\\frac{(y+1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(5,-1).$"}] [{:db/id #edb/ref 17592186264086 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56eaa4e0-a898-5a3c-bb0e-307051eeae94" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186264088} {:answer/id #uuid "96d61439-9fa8-596a-9502-aa6e49aa4802" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-2)" :db/id #edb/ref 17592186264089} {:answer/id #uuid "32a33116-deba-5c6b-8759-8a739b3333da" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186264090} {:answer/id #uuid "0a915644-b642-557c-bbf0-2d7c1e140b21" :answer/type {:db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186264091} {:answer/id #uuid "b99d3119-aa71-5aca-8424-477c5a80ea2b" :answer/type {:db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186264092}] :answer-field/correct {:answer/id #uuid "32a33116-deba-5c6b-8759-8a739b3333da" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186264090} :answer-field/id #uuid "9fc1f230-6bbf-5865-abf1-244f173cb12e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b3a73f52-d375-5a52-988c-76cc2b23b55a" :question/math-academy-id "q-78877" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}-8x+2y=13?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}-8x+2y & =13 \\\\ {y}^{2}+2y-2{x}^{2}-8x & =13 \\\\ {y}^{2}+2y-2[{x}^{2}+4x] & =13 \\\\ (y+1)^{2}-1-2[(x+2)^{2}-4] & =13 \\\\ (y+1)^{2}-1-2(x+2)^{2}+8 & =13 \\\\ (y+1)^{2}-2(x+2)^{2} & =13+1-8 \\\\ (y+1)^{2}-2(x+2)^{2} & =6 \\\\ \\frac{(y+1)^{2}}{6}-\\frac{(x+2)^{2}}{3} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-2,-1).$"}]}
