 form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-{y}^{2}-20x-2y & =-47 \\\\ 2{x}^{2}-20x-{y}^{2}-2y & =-47 \\\\ 2[{x}^{2}-10x]-[{y}^{2}+2y] & =-47 \\\\ 2[(x-5)^{2}-25]-[(y+1)^{2}-1] & =-47 \\\\ 2(x-5)^{2}-50-(y+1)^{2}+1 & =-47 \\\\ 2(x-5)^{2}-(y+1)^{2} & =-47+50-1 \\\\ 2(x-5)^{2}-(y+1)^{2} & =2 \\\\ (x-5)^{2}-\\frac{(y+1)^{2}}{2} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(5,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78871/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951"] :knowledge-point/questions ["q-78871"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78870/selection/a45b3d817136e66dedc99befbbdb23cc00480a3166e8ebd3be46752fa9cd57d5" :answer/id #uuid "5dc4e9c4-23e1-57a0-b975-e4c0a728edd2" :answer/type :answer.type/math :answer/value "(2,3)" :db/ensure [:answer/validate]} {:db/id "q-78870/selection/a217012f5a27b7915ceffd419057c4616817727e56168e68517d35ec9e175893" :answer/id #uuid "0ca48556-b350-5041-b320-020291c6f348" :answer/type :answer.type/math :answer/value "(4,3)" :db/ensure [:answer/validate]} {:db/id "q-78870/selection/625f40a59af0f5938119dbedf38d07692ba9d02d04e5cf360117ecca1c5ee729" :answer/id #uuid "a61e30ca-5d7f-5a75-a2a1-9a7d3fb78bbb" :answer/type :answer.type/math :answer/value "(-3,2)" :db/ensure [:answer/validate]} {:db/id "q-78870/selection/6e8d353a8a5dc51a4e32f114b42e5f84c440535e0c2eb2babb272216706a7979" :answer/id #uuid "9f1377b0-b2cd-5848-b294-ffc6b3b40972" :answer/type :answer.type/math :answer/value "(4,-3)" :db/ensure [:answer/validate]} {:db/id "q-78870/selection/cc3b771d69c249b43b6611d0bc746155921a411fbf43e84f275766a62a6727d8" :answer/id #uuid "f7bb4939-294f-5618-a36d-8418456096a0" :answer/type :answer.type/math :answer/value "(-2,-3)" :db/ensure [:answer/validate]} {:db/id "q-78870/selection" :answer-field/id #uuid "77978dd7-71b0-5ba8-973d-45ec3ba7b353" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78870/selection/a45b3d817136e66dedc99befbbdb23cc00480a3166e8ebd3be46752fa9cd57d5" :answer-field/choices ["q-78870/selection/a45b3d817136e66dedc99befbbdb23cc00480a3166e8ebd3be46752fa9cd57d5" "q-78870/selection/a217012f5a27b7915ceffd419057c4616817727e56168e68517d35ec9e175893" "q-78870/selection/625f40a59af0f5938119dbedf38d07692ba9d02d04e5cf360117ecca1c5ee729" "q-78870/selection/6e8d353a8a5dc51a4e32f114b42e5f84c440535e0c2eb2babb272216706a7979" "q-78870/selection/cc3b771d69c249b43b6611d0bc746155921a411fbf43e84f275766a62a6727d8"] :db/ensure [:answer-field/validate]} {:db/id "q-78870" :question/id #uuid "4c87b48a-fbce-5db9-8479-e71f620c1acc" :question/math-academy-id "q-78870" :question/problem "What is the center of the hyperbola \n$3{x}^{2}-4{y}^{2}-12x+24y=36?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-4{y}^{2}-12x+24y & =36 \\\\ 3{x}^{2}-12x-4{y}^{2}+24y & =36 \\\\ 3[{x}^{2}-4x]-4[{y}^{2}-6y] & =36 \\\\ 3[(x-2)^{2}-4]-4[(y-3)^{2}-9] & =36 \\\\ 3(x-2)^{2}-12-4(y-3)^{2}+36 & =36 \\\\ 3(x-2)^{2}-4(y-3)^{2} & =12 \\\\ \\frac{(x-2)^{2}}{4}-\\frac{(y-3)^{2}}{3} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(2,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78870/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951"] :knowledge-point/questions ["q-78870"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-16382"] :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-5{y}^{2}+2x+10y & =9 \\\\ {x}^{2}+2x-5{y}^{2}+10y & =9 \\\\ (x+1)^{2}-1-5[{y}^{2}-2y] & =9 \\\\ (x+1)^{2}-1-5[(y-1)^{2}-1] & =9 \\\\ (x+1)^{2}-1-5(y-1)^{2}+5 & =9 \\\\ (x+1)^{2}-5(y-1)^{2} & =9+1-5 \\\\ (x+1)^{2}-5(y-1)^{2} & =5 \\\\ \\frac{(x+1)^{2}}{5}-(y-1)^{2} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-1,1).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-78877/selection/4243e6462c01a0f8c7929e248821c0cb16d103501f063bc34b2e3fe7fa55bb10" :answer/id #uuid "0a915644-b642-557c-bbf0-2d7c1e140b21" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "q-78877/selection/229ce6942dd850542a26df738effd137b961ede15c15df6b063f58a3d57aca11" :answer/id #uuid "96d61439-9fa8-596a-9502-aa6e49aa4802" :answer/type :answer.type/math :answer/value "(-1,-2)" :db/ensure [:answer/validate]} {:db/id "q-78877/selection/0af8632f8d775c0447fbe2b8d1621b1c19cbb186090770a99ba5bb47342490c7" :answer/id #uuid "56eaa4e0-a898-5a3c-bb0e-307051eeae94" :answer/type :answer.type/math :answer/value "(3,-2)" :db/ensure [:answer/validate]} {:db/id "q-78877/selection/e73aa922030024cfbd6ec7d56544b6ec3ea62ba5b9daa177261b64205e381b1a" :answer/id #uuid "b99d3119-aa71-5aca-8424-477c5a80ea2b" :answer/type :answer.type/math :answer/value "(2,1)" :db/ensure [:answer/validate]} {:db/id "q-78877/selection/301772469cdcfaf57f8f58be63997eb4eba52678eeb14a2b2c2e3c41772aa6f3" :answer/id #uuid "32a33116-deba-5c6b-8759-8a739b3333da" :answer/type :answer.type/math :answer/value "(-2,-1)" :db/ensure [:answer/validate]} {:db/id "q-78877/selection" :answer-field/id #uuid "9fc1f230-6bbf-5865-abf1-244f173cb12e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78877/selection/301772469cdcfaf57f8f58be63997eb4eba52678eeb14a2b2c2e3c41772aa6f3" :answer-field/choices ["q-78877/selection/4243e6462c01a0f8c7929e248821c0cb16d103501f063bc34b2e3fe7fa55bb10" "q-78877/selection/229ce6942dd850542a26df738effd137b961ede15c15df6b063f58a3d57aca11" "q-78877/selection/0af8632f8d775c0447fbe2b8d1621b1c19cbb186090770a99ba5bb47342490c7" "q-78877/selection/e73aa922030024cfbd6ec7d56544b6ec3ea62ba5b9daa177261b64205e381b1a" "q-78877/selection/301772469cdcfaf57f8f58be63997eb4eba52678eeb14a2b2c2e3c41772aa6f3"] :db/ensure [:answer-field/validate]} {:db/id "q-78877" :question/id #uuid "b3a73f52-d375-5a52-988c-76cc2b23b55a" :question/math-academy-id "q-78877" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}-8x+2y=13?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}-8x+2y & =13 \\\\ {y}^{2}+2y-2{x}^{2}-8x & =13 \\\\ {y}^{2}+2y-2[{x}^{2}+4x] & =13 \\\\ (y+1)^{2}-1-2[(x+2)^{2}-4] & =13 \\\\ (y+1)^{2}-1-2(x+2)^{2}+8 & =13 \\\\ (y+1)^{2}-2(x+2)^{2} & =13+1-8 \\\\ (y+1)^{2}-2(x+2)^{2} & =6 \\\\ \\frac{(y+1)^{2}}{6}-\\frac{(x+2)^{2}}{3} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-2,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78877/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af"] :knowledge-point/questions ["q-78877"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328391/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "2f1b5d97-5ec1-5e85-8737-9bb8cce1ff84" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-328391/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "756e0370-8177-5ed0-85d5-fc0430203c8e" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-328391/field-1" :answer-field/id #uuid "a6e09799-9bc2-5272-8ef8-f213975da0e6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328391/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-328391/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-328391/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-328391/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "bc23788e-9f57-5b22-9ce4-48ed37fd0879" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-328391/field-2" :answer-field/id #uuid "b8b10d3f-c340-5ef9-83bc-4d70b28d2be9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328391/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-328391/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-328391" :question/id #uuid "e8ba7aa2-c477-5d4b-a6c3-8f56b95fb6f7" :question/math-academy-id "q-328391" :question/problem "The center of the hyperbola $9{y}^{2}-{x}^{2}+54y+10x=-20$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-{x}^{2}+54y+10x & =-20 \\\\ 9{y}^{2}+54y-{x}^{2}+10x & =-20 \\\\ 9[{y}^{2}+6y]-[{x}^{2}-10x] & =-20 \\\\ 9[(y+3)^{2}-9]-[(x-5)^{2}-25] & =-20 \\\\ 9(y+3)^{2}-81-(x-5)^{2}+25 & =-20 \\\\ 9(y+3)^{2}-(x-5)^{2} & =-20+81-25 \\\\ 9(y+3)^{2}-(x-5)^{2} & =36 \\\\ \\frac{(y+3)^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1 \\\\ \\frac{(y-(-3))^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,-3\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-328391/field-1" "q-328391/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af"] :knowledge-point/questions ["q-328391"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116123/selection/265033e705ddbe9f1f30f47188b03a2b28b2a12a3ed7f75cd554e6baee2550bc" :answer/id #uuid "9054894d-5f1a-5e91-9cff-3dadd34846ed" :answer/type :answer.type/math :answer/value "(1,-2)" :db/ensure [:answer/validate]} {:db/id "q-116123/selection/7f0fa63eeef82f9dace00952afe3e13f6ee454cf5f73277bf465d894f063e1bd" :answer/id #uuid "8ce28573-42fb-5f9b-a18c-f1f1d050efac" :answer/type :answer.type/math :answer/value "(-1,-5)" :db/ensure [:answer/validate]} {:db/id "q-116123/selection/90a9f3a76d85c95a52e9e38a0e9fc320cdb8f8e04530afc3986e6ade7dd6c2fe" :answer/id #uuid "e83f19d2-1663-5270-b92e-93c9233d9e07" :answer/type :answer.type/math :answer/value "(2,-1)" :db/ensure [:answer/validate]} {:db/id "q-116123/selection/7209a43b6c2b5cd8e9c292ea9df705bd6ad91c4f5f412791404f866b94343db5" :answer/id #uuid "533a5df7-b90d-5ab8-96fd-c3ca91be082b" :answer/type :answer.type/math :answer/value "(-5,-1)" :db/ensure [:answer/validate]} {:db/id "q-116123/selection/7a63746fb154abad8b03f812bbe07834b58e3ebbe52640c382bc0d9cd40b4132" :answer/id #uuid "05b72c06-5622-5552-90a7-a22c449df3ab" :answer/type :answer.type/math :answer/value "(1,5)" :db/ensure [:answer/validate]} {:db/id "q-116123/selection" :answer-field/id #uuid "356800a5-d904-5bd8-bf87-24af72734ba1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116123/selection/7209a43b6c2b5cd8e9c292ea9df705bd6ad91c4f5f412791404f866b94343db5" :answer-field/choices ["q-116123/selection/265033e705ddbe9f1f30f47188b03a2b28b2a12a3ed7f75cd554e6baee2550bc" "q-116123/selection/7f0fa63eeef82f9dace00952afe3e13f6ee454cf5f73277bf465d894f063e1bd" "q-116123/selection/90a9f3a76d85c95a52e9e38a0e9fc320cdb8f8e04530afc3986e6ade7dd6c2fe" "q-116123/selection/7209a43b6c2b5cd8e9c292ea9df705bd6ad91c4f5f412791404f866b94343db5" "q-116123/selection/7a63746fb154abad8b03f812bbe07834b58e3ebbe52640c382bc0d9cd40b4132"] :db/ensure [:answer-field/validate]} {:db/id "q-116123" :question/id #uuid "3313b3b6-8b62-544d-8c3b-37c934a212ce" :question/math-academy-id "q-116123" :question/problem "What is the center of the hyperbola \n$-{x}^{2}+2{y}^{2}-10x+4y=31?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}+2{y}^{2}-10x+4y & =31 \\\\ 2{y}^{2}+4y-{x}^{2}-10x & =31 \\\\ 2[{y}^{2}+2y]-[{x}^{2}+10x] & =31 \\\\ 2[(y+1)^{2}-1]-[(x+5)^{2}-25] & =31 \\\\ 2(y+1)^{2}-2-(x+5)^{2}+25 & =31 \\\\ 2(y+1)^{2}-(x+5)^{2} & =31+2-25 \\\\ 2(y+1)^{2}-(x+5)^{2} & =8 \\\\ \\frac{(y+1)^{2}}{4}-\\frac{(x+5)^{2}}{8} & =1 \\\\ \\frac{(y-(-1))^{2}}{{2}^{2}}-\\frac{(x-(-5))^{2}}{(\\sqrt{8})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-5,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-116123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af"] :knowledge-point/questions ["q-116123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78379/selection/a45b3d817136e66dedc99befbbdb23cc00480a3166e8ebd3be46752fa9cd57d5" :answer/id #uuid "478c00d4-b26e-5865-a66d-153e3da485c1" :answer/type :answer.type/math :answer/value "(2,3)" :db/ensure [:answer/va