}1 & 5 \\\\ 3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}4+2-1 & -1+3-5 \\\\ 0+(-2)-3 & 5+4-(-1)\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -3 \\\\ -5 & 10\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278654 :knowledge-point/_questions [{:knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9871b9-2475-5a6a-9599-37d3e0533f47" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278656} {:answer/id #uuid "a3597660-99dc-507a-926f-5ef3cdb38d1b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186278657}] :answer-field/correct {:answer/id #uuid "a3597660-99dc-507a-926f-5ef3cdb38d1b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186278657} :answer-field/id #uuid "753070b6-c444-5a96-8861-7a6505f4f4f5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278655} {:answer-field/choices [{:answer/id #uuid "997ea32e-89a4-55b6-ba41-a7ca065a6855" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186278659}] :answer-field/correct {:answer/id #uuid "997ea32e-89a4-55b6-ba41-a7ca065a6855" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186278659} :answer-field/id #uuid "3655b57e-0874-571a-93d4-3aa4a7edfbf9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278658} {:answer-field/choices [{:answer/id #uuid "41bb62eb-ec44-5264-9463-182cd6c842d7" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186278661}] :answer-field/correct {:answer/id #uuid "41bb62eb-ec44-5264-9463-182cd6c842d7" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186278661} :answer-field