8671}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "01026a8c-65bc-5d45-9d8c-0deefdbaee84" :question/math-academy-id "q-279527" :question/problem "Calculate $A-(B-C)$, where\n\n$$\nA=[\\begin{aligned}4 & -2 \\\\ 7 & 1\\end{aligned}],\\,B=[\\begin{aligned}3 & 5 \\\\ 0 & -4\\end{aligned}],\\,C=[\\begin{aligned}1 & 2 \\\\ 6 & 3\\end{aligned}].\n$$\n\n| $A-(B-C)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Performing the operations on each corresponding entry, we get\n\n$$\n\\begin{aligned}A-(B-C) & =[\\begin{aligned}4 & -2 \\\\ 7 & 1\\end{aligned}]-([\\begin{aligned}3 & 5 \\\\ 0 & -4\\end{aligned}]-[\\begin{aligned}1 & 2 \\\\ 6 & 3\\end{aligned}]) \\\\  & =[\\begin{aligned}4 & -2 \\\\ 7 & 1\\end{aligned}]-[\\begin{aligned}3-1 & 5-2 \\\\ 0-6 & -4-3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -2 \\\\ 7 & 1\\end{aligned}]-[\\begin{aligned}2 & 3 \\\\ -6 & -7\\end{aligned}] \\\\  & =[\\begin{aligned}4-2 & -2-3 \\\\ 7-(-6) & 1-(-7)\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -5 \\\\ 13 & 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278673 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29c4585a-8a8b-5c32-941f-4387e2973f48" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186278675} {:answer/id #uuid "ac8f18c8-7612-5fe0-8afc-42ed73c1f017" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186278676}] :answer-field/correct {:answer/id #uuid "ac8f18c8-7612-5fe0-8afc-42ed73c1f017" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186278676} :answer-field/id #uuid "259ff673-f664-5949-8a53-3d1d806e630d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278674} {:answer-field/choices [{:answer/id #uuid "57f765bc-19c1-5ae3-b6c7-bc9717abcaf9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186278678}] :answer-field/correct {:answer/id #uuid "57f765bc-19c1-5ae3-b6c7-bc9717abcaf9" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186278678} :answer-field/id #uuid "afc8be63-7050-5e90-9864-462027608e3f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278677} {:answer-field/choices [{:answer/id #uuid "d1eb7991-ae0d-5392-9017-e13c0cce6db1" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186278680}] :answer-field/correct {:answer/id #uuid "d1eb7991-ae0d-5392-9017-e13c0cce6db1" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186278680} :answer-field/id #uuid "6c219893-9c61-56c9-85b8-b764cbf21eee" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278679} {:answer-field/choices [{:answer/id #uuid "90b3e1ad-52c8-5a0d-87c3-b436755c887f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186278682}] :answer-field/correct {:answer/id #uuid "90b3e1ad-52c8-5a0d-87c3-b436755c887f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186278682} :answer-field/id #uuid "fe7a0990-1c7c-54c0-8461-746a1404f5b5" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278681}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4d2e1598-c4dd-5f3a-a368-7c7edb1c64a4" :question/math-academy-id "q-279581" :question/problem "Find $A+B-(C+B)$, if\n\n$$\nA=[\\begin{aligned}2 & -5 \\\\ 7 & 0\\end{aligned}],\\,B=[\\begin{aligned}-1 & 4 \\\\ 3 & 6\\end{aligned}],\\,C=[\\begin{aligned}8 & -2 \\\\ -4 & 1\\end{aligned}].\n$$\n\n| $A+B-(C+B)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}A+B-(C+B) & =A+B-C-B \\\\  & =A+\\cancel{B}-C-\\cancel{B} \\\\  & =A-C\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}A-C & =[\\begin{aligned}2 & -5 \\\\ 7 & 0\\end{aligned}]-[\\begin{aligned}8 & -2 \\\\ -4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2-8 & -5-(-2) \\\\ 7-(-4) & 0-1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -3 \\\\ 11 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278683 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73706697-7b24-51bc-85bd-37f7e72a802d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 3 & 7 \\\\ 4 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186278685} {:answer/id #uuid "47cd6c13-9918-5823-8f2e-73ec2d2e9399" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 5 & -7 \\\\ -4 & 6 & 3\\end{aligned}]" :db/id #edb/ref 17592186278686} {:answer/id #uuid "d61b84a7-a91a-51ef-95b2-ec020e52c6e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -6 & 1 \\\\ 3 & 5 & -7\\end{aligned}]" :db/id #edb/ref 17592186278687} {:answer/id #uuid "29e9e51f-5359-5c5d-b83e-b5449fbc72b3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 3 & -7 \\\\ -6 & -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186278688} {:answer/id #uuid "ba60de57-ef96-5cc3-b068-7e4756a0cea6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186278689}] :answer-field/correct {:answer/id #uuid "ba60de57-ef96-5cc3-b068-7e4756a0cea6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186278689} :answer-field/id #uuid "7dfe8aec-d98b-5ed5-bca6-ece0d5bbb5ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278684}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1c51659b-71e9-51d7-a0ff-e2acebcebf92" :question/math-academy-id "q-69623" :question/problem "Find $G+H-(H+F)$, if\n\n$$\nF=[\\begin{aligned}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{aligned}],\\,G=[\\begin{aligned}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{aligned}],\\,H=[\\begin{aligned}1 & 3 & -2 \\\\ 5 & -1 & 4\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}G+H-(H+F) & =G+H-H-F \\\\  & =G+\\cancel{H}-\\cancel{H}-F \\\\  & =G-F\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}G-F & =[\\begin{aligned}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{aligned}]-[\\begin{aligned}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5-2 & 4-(-1) & -5-2 \\\\ 1-3 & -2-4 & 2-1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278690 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "127be633-b7e2-5414-afdd-22f55986ed1b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 10 \\\\ -4 & -13 \\\\ 4 & 2\\end{aligned}]" :db/id #edb/ref 17592186278692} {:answer/id #uuid "ba59f741-1df9-5533-93bf-cdb96f3a69fc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{aligned}]" :db/id #edb/ref 17592186278693} {:answer/id #uuid "fab5e6c5-417d-577e-91fe-53d073b65756" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{aligned}]" :db/id #edb/ref 17592186278694} {:answer/id #uuid "d101325e-d38d-5689-8416-538cb8155345" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -4 \\\\ 8 & -10 \\\\ -4 & -3\\end{aligned}]" :db/id #edb/ref 17592186278695} {:answer/id #uuid "eb83ac47-7c22-5c33-9801-272f1cedecec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 10 \\\\ 2 & 4 \\\\ -4 & -13\\end{aligned}]" :db/id #edb/ref 17592186278696}] :answer-field/correct {:answer/id #uuid "ba59f741-1df9-5533-93bf-cdb96f3a69fc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{aligned}]" :db/id #edb/ref 17592186278693} :answer-field/id #uuid "2ec3755f-f459-5560-86a7-0e8e6d92e2f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278691}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "76efd267-bc31-578d-b91c-d1a020df4159" :question/math-academy-id "q-69627" :question/problem "Find $C+V-(N+C)$, if\n\n$$\nC=[\\begin{aligned}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{aligned}],\\,V=[\\begin{aligned}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{aligned}],\\,N=[\\begin{aligned}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}C+V-(N+C) & =C+V-N-C \\\\  & =\\cancel{C}+V-N-\\cancel{C} \\\\  & =V-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}V-N & =[\\begin{aligned}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{aligned}]-[\\begin{aligned}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5-1 & 3-(-7) \\\\ 6-2 & -4-(-6) \\\\ -1-3 & -8-5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278697 :knowledge-point/_questions [{:knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f836871b-5972-514b-b231-d68eaff3f255" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -8 \\\\ 8 & 1 \\\\ 4 & -6\\end{aligned}]" :db/id #edb/ref 17592186278699} {:answer/id #uuid "8dae796e-9b08-5994-90fd-6f10a082bf74" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -8 \\\\ 8 & 17 \\\\ -4 & 0\\end{aligned}]" :db/id #edb/ref 17592186278700} {:answer/id #uuid "91eb382d-80ce-5ef2-96d3-b3cfff601245" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ -8 & 1 \\\\ -4 & 0\\end{aligned}]" :db/id #edb/ref 17592186278701} {:answer/id #uuid "4f4f2c63-3dad-5799-88dd-f561862a23bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ -8 & 1 \\\\ 4 & -6\\end{aligned}]" :db/id #edb/ref 17592186278702} {:answer/id #uuid "c00e19d0-c1e1-5788-8dce-f749a69fb432" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 2 \\\\ 8 & 17 \\\\ 4 & 6\\end{aligned}]" :db/id #edb/ref 17592186278703}] :answer-field/correct {:answer/id #uuid "f836871b-5972-514b-b231-d68eaff3f255" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -8 \\\\ 8 & 1 \\\\ 4 & -6\\end{aligned}]" :db/id #edb/ref 17592186278699} :answer-field/id #uuid "e907f1be-28b3-5f6e-bcc2-cdb0d945a6a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278698}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "74d116df-41aa-5b49-9dd8-a2babbc42438" :question/math-academy-id "q-69636" :question/problem "Calculate $R+S+T$, where\n\n$$\nR=[\\begin{aligned}-3 & -3 \\\\ -4 & 2 \\\\ -1 & -5\\end{aligned}],\\,S=[\\begin{aligned}7 & -5 \\\\ 12 & -8 \\\\ 5 & -3\\end{aligned}],\\,T=[\\begin{aligned}3 & 0 \\\\ 0 & 7 \\\\ 0 & 2\\end{aligned}].\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}R+S+T & =[\\begin{aligned}-3 & -3 \\\\ -4 & 2 \\\\ -1 & -5\\end{aligned}]+[\\begin{aligned}7 & -5 \\\\ 12 & -8 \\\\ 5 & -3\\end{aligned}]+[\\begin{aligned}3 & 0 \\\\ 0 & 7 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-3+7+3 & -3+(-5)+0 \\\\ -4+12+0 & 2+(-8)+7 \\\\ -1+5+0 & -5+(-3)+2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -8 \\\\ 8 & 1 \\\\ 4 & -6\\end{aligned}]\\end{aligned}\n$$"}]}
