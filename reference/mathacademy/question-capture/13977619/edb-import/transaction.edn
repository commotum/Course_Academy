58269e334766b0e7b7f4aa81b95c0" "q-69636/selection/a023d7888ac59e57535ae1cd3b4aff5593023961c0797e6500a1ef8475e53b08" "q-69636/selection/3f793658ae557e58b47148b285eacb7e10039fd7d4d57cf75575c65916321d04"] :db/ensure [:answer-field/validate]} {:db/id "q-69636" :question/id #uuid "74d116df-41aa-5b49-9dd8-a2babbc42438" :question/math-academy-id "q-69636" :question/problem "Calculate $R+S+T$, where\n\n$$\nR=[\\begin{aligned}-3 & -3 \\\\ -4 & 2 \\\\ -1 & -5\\end{aligned}],\\,S=[\\begin{aligned}7 & -5 \\\\ 12 & -8 \\\\ 5 & -3\\end{aligned}],\\,T=[\\begin{aligned}3 & 0 \\\\ 0 & 7 \\\\ 0 & 2\\end{aligned}].\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}R+S+T & =[\\begin{aligned}-3 & -3 \\\\ -4 & 2 \\\\ -1 & -5\\end{aligned}]+[\\begin{aligned}7 & -5 \\\\ 12 & -8 \\\\ 5 & -3\\end{aligned}]+[\\begin{aligned}3 & 0 \\\\ 0 & 7 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-3+7+3 & -3+(-5)+0 \\\\ -4+12+0 & 2+(-8)+7 \\\\ -1+5+0 & -5+(-3)+2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -8 \\\\ 8 & 1 \\\\ 4 & -6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69636/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b"] :knowledge-point/questions ["q-69636"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69623/selection/997a8a07dc38ba0246209021bc014e441210c9a9341974f2c0c997fd0650f40e" :answer/id #uuid "29e9e51f-5359-5c5d-b83e-b5449fbc72b3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 3 & -7 \\\\ -6 & -2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69623/selection/350d048a499b513a3b5721a90ac679d74f3ecc241f58ed6aa78ca0e958333968" :answer/id #uuid "47cd6c13-9918-5823-8f2e-73ec2d2e9399" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 5 & -7 \\\\ -4 & 6 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69623/selection/06335050f8952a07c0e40d14195312ca2dbfce7998f778b82657425ce01eff97" :answer/id #uuid "73706697-7b24-51bc-85bd-37f7e72a802d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 3 & 7 \\\\ 4 & -2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69623/selection/3eec9235a917cd49cd65f5a64fa9df9902d303e9471b5d2903b372e0448e4327" :answer/id #uuid "d61b84a7-a91a-51ef-95b2-ec020e52c6e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & -6 & 1 \\\\ 3 & 5 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69623/selection/d55fb82792388a721db7990ab15c3add5337f1ebb8916504397404b170f6950b" :answer/id #uuid "ba60de57-ef96-5cc3-b068-7e4756a0cea6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69623/selection" :answer-field/id #uuid "7dfe8aec-d98b-5ed5-bca6-ece0d5bbb5ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69623/selection/d55fb82792388a721db7990ab15c3add5337f1ebb8916504397404b170f6950b" :answer-field/choices ["q-69623/selection/997a8a07dc38ba0246209021bc014e441210c9a9341974f2c0c997fd0650f40e" "q-69623/selection/350d048a499b513a3b5721a90ac679d74f3ecc241f58ed6aa78ca0e958333968" "q-69623/selection/06335050f8952a07c0e40d14195312ca2dbfce7998f778b82657425ce01eff97" "q-69623/selection/3eec9235a917cd49cd65f5a64fa9df9902d303e9471b5d2903b372e0448e4327" "q-69623/selection/d55fb82792388a721db7990ab15c3add5337f1ebb8916504397404b170f6950b"] :db/ensure [:answer-field/validate]} {:db/id "q-69623" :question/id #uuid "1c51659b-71e9-51d7-a0ff-e2acebcebf92" :question/math-academy-id "q-69623" :question/problem "Find $G+H-(H+F)$, if\n\n$$\nF=[\\begin{aligned}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{aligned}],\\,G=[\\begin{aligned}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{aligned}],\\,H=[\\begin{aligned}1 & 3 & -2 \\\\ 5 & -1 & 4\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}G+H-(H+F) & =G+H-H-F \\\\  & =G+\\cancel{H}-\\cancel{H}-F \\\\  & =G-F\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}G-F & =[\\begin{aligned}5 & 4 & -5 \\\\ 1 & -2 & 2\\end{aligned}]-[\\begin{aligned}2 & -1 & 2 \\\\ 3 & 4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5-2 & 4-(-1) & -5-2 \\\\ 1-3 & -2-4 & 2-1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 & -7 \\\\ -2 & -6 & 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69623/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0"] :knowledge-point/questions ["q-69623"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-13536"] :question/problem "Find $(A+B)-C-(B-C)$, if\n\n$$\nA=[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}],\\,C=[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-69627/selection/7c5abcf888cb134e5b0c614e0ff4ae3156da7865c81ee94aa76c412e8ec4bee7" :answer/id #uuid "fab5e6c5-417d-577e-91fe-53d073b65756" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69627/selection/1791539d7283bd4c65a8967f3e092f63c8be073064fbbb2755e31ded0c3313b8" :answer/id #uuid "ba59f741-1df9-5533-93bf-cdb96f3a69fc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69627/selection/10c377e267e8fcf31db1fcddf7d864e36e3c57ae9c8b6c483a3972367e57ebb7" :answer/id #uuid "127be633-b7e2-5414-afdd-22f55986ed1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 10 \\\\ -4 & -13 \\\\ 4 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69627/selection/85dd58388cb298410bedf48bc85df03a6d8922d658b1da689b75f5aef53d688b" :answer/id #uuid "d101325e-d38d-5689-8416-538cb8155345" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & -4 \\\\ 8 & -10 \\\\ -4 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69627/selection/d92d1d46bec4392990f73f399202461f3a91e381d1d4a3888cbaeef1c9b0c658" :answer/id #uuid "eb83ac47-7c22-5c33-9801-272f1cedecec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 10 \\\\ 2 & 4 \\\\ -4 & -13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-69627/selection" :answer-field/id #uuid "2ec3755f-f459-5560-86a7-0e8e6d92e2f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69627/selection/1791539d7283bd4c65a8967f3e092f63c8be073064fbbb2755e31ded0c3313b8" :answer-field/choices ["q-69627/selection/7c5abcf888cb134e5b0c614e0ff4ae3156da7865c81ee94aa76c412e8ec4bee7" "q-69627/selection/1791539d7283bd4c65a8967f3e092f63c8be073064fbbb2755e31ded0c3313b8" "q-69627/selection/10c377e267e8fcf31db1fcddf7d864e36e3c57ae9c8b6c483a3972367e57ebb7" "q-69627/selection/85dd58388cb298410bedf48bc85df03a6d8922d658b1da689b75f5aef53d688b" "q-69627/selection/d92d1d46bec4392990f73f399202461f3a91e381d1d4a3888cbaeef1c9b0c658"] :db/ensure [:answer-field/validate]} {:db/id "q-69627" :question/id #uuid "76efd267-bc31-578d-b91c-d1a020df4159" :question/math-academy-id "q-69627" :question/problem "Find $C+V-(N+C)$, if\n\n$$\nC=[\\begin{aligned}10 & -1 \\\\ 3 & 25 \\\\ -57 & -23\\end{aligned}],\\,V=[\\begin{aligned}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{aligned}],\\,N=[\\begin{aligned}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}C+V-(N+C) & =C+V-N-C \\\\  & =\\cancel{C}+V-N-\\cancel{C} \\\\  & =V-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}V-N & =[\\begin{aligned}5 & 3 \\\\ 6 & -4 \\\\ -1 & -8\\end{aligned}]-[\\begin{aligned}1 & -7 \\\\ 2 & -6 \\\\ 3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5-1 & 3-(-7) \\\\ 6-2 & -4-(-6) \\\\ -1-3 & -8-5\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 10 \\\\ 4 & 2 \\\\ -4 & -13\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-69627/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0"] :knowledge-point/questions ["q-69627"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279581/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "ac8f18c8-7612-5fe0-8afc-42ed73c1f017" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-279581/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "29c4585a-8a8b-5c32-941f-4387e2973f48" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-279581/field-1" :answer-field/id #uuid "259ff673-f664-5949-8a53-3d1d806e630d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279581/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-279581/field-1/f853eeffac47c628af4a2b7e7b0ecd02