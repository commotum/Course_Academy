2c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-279581" :question/id #uuid "4d2e1598-c4dd-5f3a-a368-7c7edb1c64a4" :question/math-academy-id "q-279581" :question/problem "Find $A+B-(C+B)$, if\n\n$$\nA=[\\begin{aligned}2 & -5 \\\\ 7 & 0\\end{aligned}],\\,B=[\\begin{aligned}-1 & 4 \\\\ 3 & 6\\end{aligned}],\\,C=[\\begin{aligned}8 & -2 \\\\ -4 & 1\\end{aligned}].\n$$\n\n| $A+B-(C+B)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}A+B-(C+B) & =A+B-C-B \\\\  & =A+\\cancel{B}-C-\\cancel{B} \\\\  & =A-C\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}A-C & =[\\begin{aligned}2 & -5 \\\\ 7 & 0\\end{aligned}]-[\\begin{aligned}8 & -2 \\\\ -4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2-8 & -5-(-2) \\\\ 7-(-4) & 0-1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -3 \\\\ 11 & -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279581/field-1" "q-279581/field-2" "q-279581/field-3" "q-279581/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0"] :knowledge-point/questions ["q-279581"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13543/selection/bfd9117362d687e5a3b016881128e4812912ef4839e29bac2203c14ce2a831d3" :answer/id #uuid "01197bfc-397e-5d8a-814c-f0c13b8935ad" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 2 \\\\ 2 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-13543/selection/baea752a1ac325840dae504103f7b1183584b56b85e3d268f344c94d5c7f4dc7" :answer/id #uuid "6e5682f3-5d91-5a1c-8375-5bed7cf02971" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 1 \\\\ 3 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-13543/selection/aa27d447b20fbf742332c2eb4506441c449f7e7789b035cc60a5821b0c66c79b" :answer/id #uuid "15c71df8-67c0-52a9-b264-ece777f7e016" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 2 \\\\ 3 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-13543/selection/65d2f664dd76883d51e7be615c7c92a2748870027c12f26d0bf70db7e7bfe9a1" :answer/id #uuid "b4d37ae6-592b-5ba1-abeb-5285256fae98" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 2 \\\\ 3 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-13543/selection/e1fb26e452a369667ce790a385b839fb3573c22678ef882b4f31662d46fe430b" :answer/id #uuid "53a33146-e31b-5da9-831b-dc967160a799" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 2 \\\\ 3 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-13543/selection" :answer-field/id #uuid "0016826a-ee2a-5b66-adb2-92ceeca908a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13543/selection/e1fb26e452a369667ce790a385b839fb3573c22678ef882b4f31662d46fe430b" :answer-field/choices ["q-13543/selection/bfd9117362d687e5a3b016881128e4812912ef4839e29bac2203c14ce2a831d3" "q-13543/selection/baea752a1ac325840dae504103f7b1183584b56b85e3d268f344c94d5c7f4dc7" "q-13543/selection/aa27d447b20fbf742332c2eb4506441c449f7e7789b035cc60a5821b0c66c79b" "q-13543/selection/65d2f664dd76883d51e7be615c7c92a2748870027c12f26d0bf70db7e7bfe9a1" "q-13543/selection/e1fb26e452a369667ce790a385b839fb3573c22678ef882b4f31662d46fe430b"] :db/ensure [:answer-field/validate]} {:db/id "q-13543" :question/id #uuid "86a3b4fd-ea74-58ac-945b-0f03af506f5a" :question/math-academy-id "q-13543" :question/problem "Find $M+O-(N+M)$, if\n\n$$\nM=[\\begin{aligned}5 & 5 \\\\ 0 & 1\\end{aligned}],\\,N=[\\begin{aligned}1 & 4 \\\\ 2 & -1\\end{aligned}],\\,O=[\\begin{aligned}8 & 6 \\\\ 5 & 3\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}M+O-(N+M) & =M+O-N-M \\\\  & =\\cancel{M}+O-N-\\cancel{M} \\\\  & =O-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}O-N & =[\\begin{aligned}8 & 6 \\\\ 5 & 3\\end{aligned}]-[\\begin{aligned}1 & 4 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}8-1 & 6-4 \\\\ 5-2 & 3-(-1)\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 2 \\\\ 3 & 4\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13543/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0"] :knowledge-point/questions ["q-13543"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4378"] :question/problem "Calculate $A-(B-C),$ where\n\n$$\n[\\begin{aligned}-1 & 0 \\\\ 2 & -2\\end{aligned}]\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}A-(B-C) & =[\\begin{aligned}-1 & 0 \\\\ 2 & -2\\end{aligned}]-([\\begin{aligned}-1 & -1 \\\\ 2 & 0\\end{aligned}]-[\\begin{aligned}0 & -5 \\\\ 1 & 1\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 & 0 \\\\ 2 & -2\\end{aligned}]-[\\begin{aligned}-1-0 & -1-(-5) \\\\ 2-1 & 0-1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 \\\\ 2 & -2\\end{aligned}]-[\\begin{aligned}-1 & 4 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1-(-1) & 0-4 \\\\ 2-1 & -2-(-1)\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -4 \\\\ 1 & -1\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4379"] :question/problem "Find $A+C-(B+A),$ if\n\n$$\n[\\begin{aligned}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{aligned}]\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses: \n\n$$\n\\begin{aligned}A+C-(B+A) & =A+C-B-A \\\\  & =\\cancel{A}+C-B-\\cancel{A} \\\\  & =C-B\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}C-B & =[\\begin{aligned}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{aligned}]-[\\begin{aligned}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3-3 & -1-(-1) \\\\ 1-2 & 2-0 \\\\ -6-(-4) & 1-1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]}]
