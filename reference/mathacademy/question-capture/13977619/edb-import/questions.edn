#{[{:db/id #edb/ref 17592186100599 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"}] :question/id #uuid "0928c2fa-a772-5d39-a638-1b1d0e71be2f" :question/math-academy-id "e-4378" :question/problem "Calculate $A-(B-C)$, where\n\n$\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}\nA - (B - C) &= \\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix} - (\\begin{bmatrix}-1 & -1 \\\\ 2 & 0\\end{bmatrix} - \\begin{bmatrix}0 & -5 \\\\ 1 & 1\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix} - \\begin{bmatrix}-1 - 0 & -1 - (-5) \\\\ 2 - 1 & 0 - 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix} - \\begin{bmatrix}-1 & 4 \\\\ 1 & -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-1 - (-1) & 0 - 4 \\\\ 2 - 1 & -2 - (-1)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 & -4 \\\\ 1 & -1\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100600 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/id #uuid "1b15db42-aba2-575c-a01e-b715450329fd" :question/math-academy-id "e-4379" :question/problem "Find $A+C-(B+A)$, if\n\n$\\begin{bmatrix}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{bmatrix}$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}\nA + C - (B + A) &= A + C - B - A \\\\\n&= A + C - B - A \\\\\n&= C - B\n\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}\nC - B &= \\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix} - \\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}3 - 3 & -1 - (-1) \\\\ 1 - 2 & 2 - 0 \\\\ -6 - (-4) & 1 - 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101044 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d0d5b8b-4428-5073-8c81-ebd4d03f5e11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186098035} {:answer/id #uuid "04d70404-4b26-53f0-9c5c-5e44fe5b9647" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098036} {:answer/id #uuid "39e8426c-e203-5fdf-a93f-111238c8159f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098037} {:answer/id #uuid "71f20d62-7872-5e37-97e9-a23e08aef59f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 7 \\\\ 7 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098038} {:answer/id #uuid "75cc67b5-2545-59dc-9edf-f9e64c9bb09e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186098039}] :answer-field/correct {:answer/id #uuid "04d70404-4b26-53f0-9c5c-5e44fe5b9647" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098036} :answer-field/id #uuid "11b67b69-785c-5ae0-bd01-ea693dbbfc6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098034}] :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A + B) - C - (B - C)$, if\n\n$A = \\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}, B = \\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}, C = \\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}$."}]}
