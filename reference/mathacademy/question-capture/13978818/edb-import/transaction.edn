[{:db/id "q-77237/selection/af9cac3c642890e4ade80a25a98cdb94a4a1ae1f5d58f2dad3094efc77d6a8d9" :answer/id #uuid "a101926a-c5f5-555b-a6b2-8b9a5ec0d2d6" :answer/type :answer.type/math :answer/value "7\\,200" :db/ensure [:answer/validate]} {:db/id "q-77237/selection/c1f85aa69ce032d76e69ca647503a48173408d7ac026b6a63e42ae92dd33fe6f" :answer/id #uuid "831f6d5c-8ca2-59da-a1e8-6299be3d14c3" :answer/type :answer.type/math :answer/value "72\\,000" :db/ensure [:answer/validate]} {:db/id "q-77237/selection/f6d6966af8f6cb7bd0de4bbf0ac8675b83f55cc89f8616d9a2178946ea2d4c75" :answer/id #uuid "5e28c42e-2442-5c52-8160-2ae0e7b9f5e2" :answer/type :answer.type/math :answer/value "3\\,600" :db/ensure [:answer/validate]} {:db/id "q-77237/selection/ee38d41860bf4acf8e22202aac49e343bc1784b70af419966459a77ba4ae705d" :answer/id #uuid "298f201a-369d-5511-96d2-c27e046cb02c" :answer/type :answer.type/math :answer/value "28\\,800" :db/ensure [:answer/validate]} {:db/id "q-77237/selection/3814eb0030cf756f27cb4604948884c854fbddd390c839fe49e49dd145e1509a" :answer/id #uuid "7a22b6eb-4444-5405-9c3b-bc01854115c5" :answer/type :answer.type/math :answer/value "36\\,000" :db/ensure [:answer/validate]} {:db/id "q-77237/selection" :answer-field/id #uuid "5877d332-4979-56f1-bc48-464e8bf007ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77237/selection/c1f85aa69ce032d76e69ca647503a48173408d7ac026b6a63e42ae92dd33fe6f" :answer-field/choices ["q-77237/selection/af9cac3c642890e4ade80a25a98cdb94a4a1ae1f5d58f2dad3094efc77d6a8d9" "q-77237/selection/c1f85aa69ce032d76e69ca647503a48173408d7ac026b6a63e42ae92dd33fe6f" "q-77237/selection/f6d6966af8f6cb7bd0de4bbf0ac8675b83f55cc89f8616d9a2178946ea2d4c75" "q-77237/selection/ee38d41860bf4acf8e22202aac49e343bc1784b70af419966459a77ba4ae705d" "q-77237/selection/3814eb0030cf756f27cb4604948884c854fbddd390c839fe49e49dd145e1509a"] :db/ensure [:answer-field/validate]} {:db/id "q-77237" :question/id #uuid "d0b200fd-e410-539f-8042-3ce1e0c06de0" :question/math-academy-id "q-77237" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-\\frac{2\\sqrt{3}}{3}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{3}{2\\sqrt{3}}=-\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value of $x.$ \n\n$$\nx=\\text{arcsin}(-\\frac{\\sqrt{3}}{2})=-{60}^{∘}.\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}.$\n\n$$\n{x}_{1}=x+{360}^{∘}=-{60}^{∘}+{360}^{∘}={300}^{∘}.\n$$\n\nSo, our first solution is ${x}_{1}={300}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/5fe064cdc2d97e3db894801f6f31a4679881efcf83564e24a1ea2559c15d2085.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{60}^{∘} \\\\  & ={240}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x={300}^{∘},{240}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=300\\cdot 240=72\\,000.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77237/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0"] :knowledge-point/questions ["q-77237"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120532/selection/3814eb0030cf756f27cb4604948884c854fbddd390c839fe49e49dd145e1509a" :answer/id #uuid "3c5a0304-7194-5525-a129-47be14ae37e3" :answer/type :answer.type/math :answer/value "36\\,000" :db/ensure [:answer/validate]} {:db/id "q-120532/selection/ff497df650bf94fafcc6873af7d0104f8d5bb6ff89b5f46371b7510501d19717" :answer/id #uuid "dfe72dde-42f0-5bfe-a31f-0ba1f6c65179" :answer/type :answer.type/math :answer/value "63\\,000" :db/ensure [:answer/validate]} {:db/id "q-120532/selection/91459c87a3bab0a7b2251e5ae208d268b7a5d360a875e8886b179d2d4ae13e85" :answer/id #uuid "33d77868-e8c1-58a1-9259-9bc6737049d8" :answer/type :answer.type/math :answer/value "79\\,200" :db/ensure [:answer/validate]} {:db/id "q-120532/selection/844fe800e4acbe6db1d20f876fba73a2a7acaf32a78bd96b74aa1260f735e680" :answer/id #uuid "25969fa2-cecd-54a3-a850-4328b6f754a3" :answer/type :answer.type/math :answer/value "49\\,500" :db/ensure [:answer/validate]} {:db/id "q-120532/selection/81c43343e0b259db3a088f61a9e8baefa402598deadca62cddfb2bb2113cc979" :answer/id #uuid "b2807c2b-f91e-5f64-b532-9c12036b488c" :answer/type :answer.type/math :answer/value "69\\,300" :db/ensure [:answer/validate]} {:db/id "q-120532/selection" :answer-field/id #uuid "ec5e2113-8d5c-5ce5-973f-2c3eaf6348ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120532/selection/81c43343e0b259db3a088f61a9e8baefa402598deadca62cddfb2bb2113cc979" :answer-field/choices ["q-120532/selection/3814eb0030cf756f27cb4604948884c854fbddd390c839fe49e49dd145e1509a" "q-120532/selection/ff497df650bf94fafcc6873af7d0104f8d5bb6ff89b5f46371b7510501d19717" "q-120532/selection/91459c87a3bab0a7b2251e5ae208d268b7a5d360a875e8886b179d2d4ae13e85" "q-120532/selection/844fe800e4acbe6db1d20f876fba73a2a7acaf32a78bd96b74aa1260f735e680" "q-120532/selection/81c43343e0b259db3a088f61a9e8baefa402598deadca62cddfb2bb2113cc979"] :db/ensure [:answer-field/validate]} {:db/id "q-120532" :question/id #uuid "398ff4f2-a514-55ba-ad0a-235934ea5e85" :question/math-academy-id "q-120532" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x+3=-1-\\operatorname{csc}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x+3 & =-1-\\operatorname{csc}⁡x \\\\ 2\\operatorname{csc}⁡x & =-4 \\\\ \\operatorname{csc}⁡x & =-2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{2}.\n$$\n\nNow, we find the principal value: \n\n$$\nx=\\text{arcsin}(-\\frac{1}{2})=-{30}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}.$ \n\n$$\n{x}_{1}=x+{360}^{∘}=-{30}^{∘}+{360}^{∘}={330}^{∘}.\n$$\n\nSo,  our first solution is ${x}_{1}={330}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/b3c523e882baf0b3a105e10131091e40de686b4c1483f46e7bdc235e30743a6d.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x={210}^{∘},{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=210\\cdot 330=69\\,300.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120532/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0"] :knowledge-point/questions ["q-120532"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338555/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer/id #uuid "c7f966f9-45cd-5a77-b4cd-91e84bc6aca4" :answer/type :answer.type/math :answer/value "270" :db/ensure [:answer/validate]} {:db/id "q-338555/field-1" :answer-field/id #uuid "b44fc94a-42bf-5197-9d7c-60c60fb0735d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338555/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7" :answer-field/choices ["q-338555/field-1/1ad763bfa28dd8bf929699f6c31cff536336c19979c6baa533b7a886875a37b7"] :db/ensure [:answer-field/validate]} {:db/id "q-338555" :question/id #uuid "8d26dfe6-88ff-57de-a343-32dc37e76e53" :question/math-academy-id "q-338555" :question/problem "The solution to the equation $4\\operatorname{csc}⁡x=3\\operatorname{csc}⁡x-1$ for ${0}^{∘}\\le x<{360}^{∘}$ is $x=${{field-1}}${}^{∘}.$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}4\\operatorname{csc}⁡x & =3\\operatorname{csc}⁡x-1 \\\\ \\operatorname{csc}⁡x & =-1\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-1.\n$$\n\nNow, we find the principal value of $x:$\n\n$$\nx=\\operatorname{arcsin}⁡(-1)=-{90}^{∘}\n$$\n\nNote that $x=-{90}^{∘}$ is not in the given domain. To get a value inside the range, we add ${360}^{∘}:$\n\n$$\n{x}_{1}=-{90}^{∘}+{360}^{∘}={270}^{∘}\n$$\n\nAs this is a quadrantal angle, to find the remaining solutions, we use our knowledge of the sine function. We know that the sine function has its minimum values at\n\n$$\nx={270}^{∘}+n\\cdot {360}^{∘}.\n$$\n\nSince the domain $0\\le x<{360}^{∘}$ is one period, and we have already found one minimum value in this period, we conclude that \n$x={270}^{∘}$\nis the only solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-338555/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0"] :knowledge-point/questions ["q-338555"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-29004"] :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{2\\sqrt{3}}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\text{arcsin}(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the  first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/4cbf970747a9eddbcffe6fd3ba46d13c43e5f17ca56e52747c797229dbc74d48.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=\\frac{2{\\pi }^{2}}{9}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-29005/selection/9b17d597434bd52bf50c139d02d61f6e65bcaea57b6ee194d4ba2467418b42e2" :answer/id #uuid "1480a0f7-d97a-5032-8992-692577d21ad0" :answer/type :answer.type/math :answer/value "x=0,\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-29005/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" :answer/id #uuid "9369b6eb-72d9-5fa0-bf9f-fad0259775d0" :answer/type :answer.type/math :answer/value "x=\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-29005/selection/c143ca64ec013e5fe4018485f8c456b26425ea6baf2691e509470a46cd90ac4d" :answer/id #uuid "27425536-f289-5713-98f8-aaf20515e3be" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-29005/selection/ae512c9d52817a6ae2b3d63d941c09747da0474fd012c6ff7cd374644b3be7ae" :answer/id #uuid "c8122be3-6fbe-5935-aba7-f60667c1cbdc" :answer/type :answer.type/text :answer/value "The equation has no solution." :db/ensure [:answer/validate]} {:db/id "q-29005/selection/614ed68495b64af8ec0e7df520ef4d752647d6d96b370efa311048a55189b704" :answer/id #uuid "9c881436-a68c-5062-839b-e7a9bab29991" :answer/type :answer.type/math :answer/value "x=\\frac{\\pi }{2},\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-29005/selection" :answer-field/id #uuid "7ba48b2e-8ca6-52b7-8ccb-eb47d3ec634f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29005/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" :answer-field/choices ["q-29005/selection/9b17d597434bd52bf50c139d02d61f6e65bcaea57b6ee194d4ba2467418b42e2" "q-29005/selection/7d1f9ddbb3287280aa99ab89266dfb4e6d88e7ffbdac61d74583de34bd5c6d8f" "q-29005/selection/c143ca64ec013e5fe4018485f8c456b26425ea6baf2691e509470a46cd90ac4d" "q-29005/selection/ae512c9d52817a6ae2b3d63d941c09747da0474fd012c6ff7cd374644b3be7ae" "q-29005/selection/614ed68495b64af8ec0e7df520ef4d752647d6d96b370efa311048a55189b704"] :db/ensure [:answer-field/validate]} {:db/id "q-29005" :question/id #uuid "3cae031a-1582-5f4f-9d3f-2d2de0fa261a" :question/math-academy-id "q-29005" :question/problem "Solve the equation $\\operatorname{csc}⁡x=-1$ for $0\\le x<2\\pi .$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-1.\n$$\n\nNow, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-1)=-\\frac{\\pi }{2}\n$$\n\nNote that $x=-\\frac{\\pi }{2}$ is not in the range $0\\le x<2\\pi .$ To get the first solution that's within the required range, we need to find an angle that's coterminal with $-\\frac{\\pi }{2}.$ To do this, we simply add $2\\pi :$\n\n$$\n{x}_{1}=-\\frac{\\pi }{2}+2\\pi =\\frac{3\\pi }{2}\n$$\n\nAs this is a quadrantal angle, to find the remaining solutions we use our knowledge of the sine function. We know that the sine function has its minimum values at:\n\n$$\nx=\\frac{3\\pi }{2}+2n\\pi \n$$\n\nSince the domain $0\\le x<2\\pi $ is one period, and we have already found one minimum value in this period, we conclude that $x=\\frac{3\\pi }{2}$ is the only solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-29005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0"] :knowledge-point/questions ["q-29005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338585/field-1/3942f16ea0cda30a10155643e1fd7ed7bc74a4622f011c2e5329c012b288c293" :answer/id #uuid "73842a9f-f874-58d4-8f18-d5f11b53dcf8" :answer/type :answer.type/math :answer/value "228.6" :db/ensure [:answer/validate]} {:db/id "q-338585/field-1" :answer-field/id #uuid "300a53e6-339d-52dd-84d5-dc4bd842d2cd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338585/field-1/3942f16ea0cda30a10155643e1fd7ed7bc74a4622f011c2e5329c012b288c293" :answer-field/choices ["q-338585/field-1/3942f16ea0cda30a10155643e1fd7ed7bc74a4622f011c2e5329c012b288c293"] :db/ensure [:answer-field/validate]} {:db/id "q-338585/field-2/006339309dd37458e5e30cf7e8f735db86750ae1050524fc269b5aaee0509828" :answer/id #uuid "f3bda4f3-c595-519d-aea4-102cb88ef461" :answer/type :answer.type/math :answer/value "311.4" :db/ensure [:answer/validate]} {:db/id "q-338585/field-2" :answer-field/id #uuid "77a9b002-abf2-5298-b074-0e8e8275d974" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338585/field-2/006339309dd37458e5e30cf7e8f735db86750ae1050524fc269b5aaee0509828" :answer-field/choices ["q-338585/field-2/006339309dd37458e5e30cf7e8f735db86750ae1050524fc269b5aaee0509828"] :db/ensure [:answer-field/validate]} {:db/id "q-338585" :question/id #uuid "a5e3d515-8b72-5526-99c7-72edabca118c" :question/math-academy-id "q-338585" :question/problem "Expressed in **ascending order** in degrees, rounded to one decimal place, the solutions to the equation  $\\operatorname{csc}⁡x=-\\frac{4}{3},$ for ${0}^{∘}\\le x<{360}^{∘},$   are\n\n$x≈$\n{{field-1}}${}^{∘},\\,x≈$\n{{field-2}}${}^{∘}.$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{3}{4}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{3}{4})={(-48.590\\,377…)}^{∘}≈-{48.5904}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}:$\n\n$$\n{x}_{1}=-{48.5904}^{∘}+{360}^{∘}={311.4096}^{∘}\n$$\n\nSo,  our first solution is ${x}_{1}={311.4096}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={48.5904}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={48.5904}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/d319d2ea403460a3b4d86c837a560fd5188476c425399145bb911e1414b0a6f5.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{48.5904}^{∘} \\\\  & ≈{228.5904}^{∘}\\end{aligned}\n$$\n\nSo, in ascending order, rounded to one decimal place, the solutions are \n\n$$\nx≈{228.6}^{∘},\\,x≈{311.4}^{∘}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338585/field-1" "q-338585/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26"] :knowledge-point/questions ["q-338585"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338580/field-1/9b6783aca2d6ef79b1d01f4b45f9cad932ac916cf5326206da9f4d74693258e8" :answer/id #uuid "e20ff0a3-9ace-5eaf-8c45-95dfce4b0ee2" :answer/type :answer.type/math :answer/value "3.9" :db/ensure [:answer/validate]} {:db/id "q-338580/field-1/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "0d9e944b-869b-5b71-82fb-2897a29c1cca" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-338580/field-1" :answer-field/id #uuid "e72cc9c9-d4cb-5e4d-befa-697e8d50dc70" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338580/field-1/9b6783aca2d6ef79b1d01f4b45f9cad932ac916cf5326206da9f4d74693258e8" :answer-field/choices ["q-338580/field-1/9b6783aca2d6ef79b1d01f4b45f9cad932ac916cf5326206da9f4d74693258e8" "q-338580/field-1/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f"] :db/ensure [:answer-field/validate]} {:db/id "q-338580/field-2/5d82d3405d35cad3389a01eccd9c1e95c5305a27c9d9c2505cc5ae44484e4a24" :answer/id #uuid "eeeb7501-102c-54f6-8a7e-156073d8d75d" :answer/type :answer.type/math :answer/value "5.6" :db/ensure [:answer/validate]} {:db/id "q-338580/field-2" :answer-field/id #uuid "14267a2d-e62a-54ef-a9c6-1d156b23a8c2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338580/field-2/5d82d3405d35cad3389a01eccd9c1e95c5305a27c9d9c2505cc5ae44484e4a24" :answer-field/choices ["q-338580/field-2/5d82d3405d35cad3389a01eccd9c1e95c5305a27c9d9c2505cc5ae44484e4a24"] :db/ensure [:answer-field/validate]} {:db/id "q-338580" :question/id #uuid "8a2b1492-c6d3-5f3d-bb3b-9d9a623b6acc" :question/math-academy-id "q-338580" :question/problem "Expressed in **ascending order** in radians, rounded to one decimal place, the solutions to the equation  $\\operatorname{csc}⁡x=-\\frac{3}{2},$ for $0\\le x<2\\pi ,$   are\n\n$x≈$\n{{field-1}}, $\\,x≈$\n{{field-2}}." :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{2}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{2}{3})=-0.729\\,727…≈-0.7297\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add $2\\pi :$ \n\n$$\n{x}_{1}=-0.7297+2\\pi ≈5.5535\n$$\n\nSo,  our first solution is ${x}_{1}=5.5535.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.7297.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.7297.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/48d92d2bf48234d7c7aad44936cdefd97f02804383cb7ced2f838661a8c4922a.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.7297 \\\\  & ≈3.8713\\end{aligned}\n$$\n\nSo, in ascending order, rounded to one decimal place, the solutions are \n\n$$\nx≈3.9,\\,x≈5.6.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338580/field-1" "q-338580/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26"] :knowledge-point/questions ["q-338580"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77696/selection/bf404232fcde917f9ddc2adf5061d3a9eac7f7e4c6452062dfe290392ff6022c" :answer/id #uuid "c4d91f75-0b4c-5514-9204-16510c0d0b8f" :answer/type :answer.type/math :answer/value "3.6" :db/ensure [:answer/validate]} {:db/id "q-77696/selection/2e2ff2eb37c09b47209163d0bc9d4e5e36728f2ee9f273fdbe0427b71746f6d5" :answer/id #uuid "c3e8272b-3509-57f8-8a53-50e620aea84a" :answer/type :answer.type/math :answer/value "6.1" :db/ensure [:answer/validate]} {:db/id "q-77696/selection/97828a893f8456aaa0bfd14f200e730bf860a02c30653e1ce58dd1a1d13af5fd" :answer/id #uuid "430fa6fc-a6bb-5ab2-9504-4f53e09d5e22" :answer/type :answer.type/math :answer/value "13.7" :db/ensure [:answer/validate]} {:db/id "q-77696/selection/180da3ab0c61fbb11a73d9b9fa564788c0f64208fab2a29633c752442a313aa8" :answer/id #uuid "c6183709-c39e-5190-b277-625c6c00e905" :answer/type :answer.type/math :answer/value "20.9" :db/ensure [:answer/validate]} {:db/id "q-77696/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer/id #uuid "459e21d7-ccb5-5984-b064-ecac46b1352a" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "q-77696/selection" :answer-field/id #uuid "c9610016-3c0c-55df-93a2-7ec9505c828d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77696/selection/180da3ab0c61fbb11a73d9b9fa564788c0f64208fab2a29633c752442a313aa8" :answer-field/choices ["q-77696/selection/bf404232fcde917f9ddc2adf5061d3a9eac7f7e4c6452062dfe290392ff6022c" "q-77696/selection/2e2ff2eb37c09b47209163d0bc9d4e5e36728f2ee9f273fdbe0427b71746f6d5" "q-77696/selection/97828a893f8456aaa0bfd14f200e730bf860a02c30653e1ce58dd1a1d13af5fd" "q-77696/selection/180da3ab0c61fbb11a73d9b9fa564788c0f64208fab2a29633c752442a313aa8" "q-77696/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11"] :db/ensure [:answer-field/validate]} {:db/id "q-77696" :question/id #uuid "f73f66be-93bf-520a-aa38-bdb1e982d68c" :question/math-academy-id "q-77696" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-\\frac{12}{5}$ for $0\\le x<2\\pi ,$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{5}{12}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{5}{12})=-0.429\\,775…≈-0.429\\,8\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add $2\\pi .$\n\n$$\n{x}_{1}=-0.429\\,8+2\\pi =5.853\\,385…≈5.853\\,4\n$$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.429\\,8.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.429\\,8.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/912225edc2b860674da7531597fc905a1a9c821eda705dbdcfafdce32385839b.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.429\\,8 \\\\  & ≈3.571\\,4\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈5.853\\,4\\cdot 3.571\\,4=20.9\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77696/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26"] :knowledge-point/questions ["q-77696"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120556/selection/849d46d786a0c4720b1caa97edc6f2bc38a8171568e5a3bd0b94e5706c4bf481" :answer/id #uuid "939205b0-cdb4-575e-a30d-72c4215299ce" :answer/type :answer.type/math :answer/value "21.6" :db/ensure [:answer/validate]} {:db/id "q-120556/selection/976d5b3aca6fc8109f8e23fe2b1654daa65a645f457c96c4b316c45889c0ce13" :answer/id #uuid "62683a0b-13b1-59b2-8356-25b1efd659f9" :answer/type :answer.type/math :answer/value "18.3" :db/ensure [:answer/validate]} {:db/id "q-120556/selection/a6add6a35d1f5fcd97259ced8402e7cea968e164cc4c7518999a732820c3b72e" :answer/id #uuid "3985500c-9e11-51ee-9c8b-bd8c00d4a049" :answer/type :answer.type/math :answer/value "20.2" :db/ensure [:answer/validate]} {:db/id "q-120556/selection/2bb5fb1da0c949309eac241a91a6c1da31f3a86b00624af13e3fe048edfe0d0c" :answer/id #uuid "f97446ce-d7a0-5019-87a2-a3cda326591f" :answer/type :answer.type/math :answer/value "22.4" :db/ensure [:answer/validate]} {:db/id "q-120556/selection/87581c2952e2ad841b4852bb3b1d643ef289ccd5d4a39528bd949df19573f1b1" :answer/id #uuid "071c8305-49c2-5cd7-9062-e560c6ff4655" :answer/type :answer.type/math :answer/value "19.5" :db/ensure [:answer/validate]} {:db/id "q-120556/selection" :answer-field/id #uuid "638fdfe1-ca1a-5e37-b17d-257a5f637851" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120556/selection/a6add6a35d1f5fcd97259ced8402e7cea968e164cc4c7518999a732820c3b72e" :answer-field/choices ["q-120556/selection/849d46d786a0c4720b1caa97edc6f2bc38a8171568e5a3bd0b94e5706c4bf481" "q-120556/selection/976d5b3aca6fc8109f8e23fe2b1654daa65a645f457c96c4b316c45889c0ce13" "q-120556/selection/a6add6a35d1f5fcd97259ced8402e7cea968e164cc4c7518999a732820c3b72e" "q-120556/selection/2bb5fb1da0c949309eac241a91a6c1da31f3a86b00624af13e3fe048edfe0d0c" "q-120556/selection/87581c2952e2ad841b4852bb3b1d643ef289ccd5d4a39528bd949df19573f1b1"] :db/ensure [:answer-field/validate]} {:db/id "q-120556" :question/id #uuid "f8fc5c1a-e529-586d-9f72-2ece2b66d941" :question/math-academy-id "q-120556" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-6$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{6}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{1}{6})=-0.167\\,448…≈-0.167\\,4\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add $2\\pi .$\n\n$$\n{x}_{1}=-0.167\\,4+2\\pi =6.115\\,785…≈6.115\\,8\n$$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.167\\,4.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.167\\,4.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/f6f08d799cd2d2e80494d94cc3b18a61f73227b88b25d79c926d65e161d4ce3a.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.167\\,4 \\\\  & ≈3.309\\,0\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=6.115\\,8\\cdot 3.309\\,0=20.2\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120556/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26"] :knowledge-point/questions ["q-120556"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120548/selection/7388f1687543cc0a91a9a492275f3683551d8b8dfd4ebfa51ac1f6fe5349cd26" :answer/id #uuid "c03e0684-fba1-5c53-86f7-7f0aa050e355" :answer/type :answer.type/math :answer/value "4\\,123" :db/ensure [:answer/validate]} {:db/id "q-120548/selection/cad30fee830e09a71877d787178e9dda6bc848451031667916f5fb6ce8854ef0" :answer/id #uuid "64a4bb88-8783-50fc-a2d8-cc92c1ad54b2" :answer/type :answer.type/math :answer/value "2\\,986" :db/ensure [:answer/validate]} {:db/id "q-120548/selection/360debc8f68509b2ed1b32d86034fa4cbca8d98695ad24916ac0548857aa8a6b" :answer/id #uuid "637e6460-09ef-5b37-9654-df17f955196b" :answer/type :answer.type/math :answer/value "3\\,126" :db/ensure [:answer/validate]} {:db/id "q-120548/selection/83e1a3ae19e07283bee9a0f108da86e3e10d05423496be1194559db3851d75fd" :answer/id #uuid "53f3e17f-02e0-5b1f-91b8-288f545c4759" :answer/type :answer.type/math :answer/value "3\\,874" :db/ensure [:answer/validate]} {:db/id "q-120548/selection/74f3b5fe5c6b64d967f8b951fefd8359e05a2a7db42cf7e985cf3d80c51908ca" :answer/id #uuid "2b360785-daba-52b1-a5f0-af225d10b1d8" :answer/type :answer.type/math :answer/value "3\\,567" :db/ensure [:answer/validate]} {:db/id "q-120548/selection" :answer-field/id #uuid "e9cac8f9-fd86-57e0-928e-c9ad5247fd2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120548/selection/360debc8f68509b2ed1b32d86034fa4cbca8d98695ad24916ac0548857aa8a6b" :answer-field/choices ["q-120548/selection/7388f1687543cc0a91a9a492275f3683551d8b8dfd4ebfa51ac1f6fe5349cd26" "q-120548/selection/cad30fee830e09a71877d787178e9dda6bc848451031667916f5fb6ce8854ef0" "q-120548/selection/360debc8f68509b2ed1b32d86034fa4cbca8d98695ad24916ac0548857aa8a6b" "q-120548/selection/83e1a3ae19e07283bee9a0f108da86e3e10d05423496be1194559db3851d75fd" "q-120548/selection/74f3b5fe5c6b64d967f8b951fefd8359e05a2a7db42cf7e985cf3d80c51908ca"] :db/ensure [:answer-field/validate]} {:db/id "q-120548" :question/id #uuid "18be9176-e656-5c15-8525-f141dd098c00" :question/math-academy-id "q-120548" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=3$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{3}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{1}{3})=(19.471\\,2…)^{∘}≈{19.471}^{∘}\n$$\n\nSince ${19.471}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={19.471}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={19.471}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={19.471}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/05f0e5d6558c90bf467284d6b0ef17e7cfb546873bcf978e3d0cd8872c1f4436.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{19.471}^{∘} \\\\  & ={160.529}^{∘}\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈19.471\\cdot 160.529=3\\,126\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-120548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26"] :knowledge-point/questions ["q-120548"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77788/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" :answer/id #uuid "b95fbe09-9a68-5c30-bc2f-e1cdf360022b" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-77788/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" :answer/id #uuid "59a5b8cb-fc23-53b0-8cf9-c1bb5c69842e" :answer/type :answer.type/math :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-77788/selection/1a4ee89f0618612cc5673272ad35e8d4625ee9ed24d34bd6027e2e3a826aae92" :answer/id #uuid "c249a4a5-081c-5ac7-a92d-b36b54b3bfb9" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-77788/selection/83f419a198a4272ff136d76a7818384354f74655b230bbd8dd8902843f19147a" :answer/id #uuid "858ed564-dd1c-5ce4-8fe2-5d6999e268d2" :answer/type :answer.type/math :answer/value "\\frac{3{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-77788/selection/9816b001c878549759686732913aed2bf8240aede588f8b3825b7da75ceb494a" :answer/id #uuid "a6526f94-d281-5dfa-8464-42abddd47d58" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{16}" :db/ensure [:answer/validate]} {:db/id "q-77788/selection" :answer-field/id #uuid "a750051f-2bf7-52ee-8dce-11d90f3717eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77788/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" :answer-field/choices ["q-77788/selection/338fd6744eb7ca9587a541b0bb0183ee8b61d9b20649c5de8a38a7eb04c075d9" "q-77788/selection/ff8e59b6a3bd95b580597792451429a20cf15bf51f97b511bc727f34ceee724b" "q-77788/selection/1a4ee89f0618612cc5673272ad35e8d4625ee9ed24d34bd6027e2e3a826aae92" "q-77788/selection/83f419a198a4272ff136d76a7818384354f74655b230bbd8dd8902843f19147a" "q-77788/selection/9816b001c878549759686732913aed2bf8240aede588f8b3825b7da75ceb494a"] :db/ensure [:answer-field/validate]} {:db/id "q-77788" :question/id #uuid "e7210f68-14b9-5e34-90cb-71a89287c414" :question/math-academy-id "q-77788" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\sqrt{2}$ for $-\\pi \\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{\\sqrt{2}}=\\frac{\\sqrt{2}}{2}.\n$$\n\nFirst, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}.\n$$\n\nSince $\\frac{\\pi }{4}$ lies in the required domain, the first solution is ${x}_{1}=\\frac{\\pi }{4}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{4}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{4}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/a45a91dfd90e1fe477d562486d641e4932722ca62645c3eb4024c4f851c964d3.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{\\pi }{4},\\frac{3\\pi }{4}.$\n\nFinally,\n\n$$\n\\frac{\\pi }{4}\\cdot \\frac{3\\pi }{4}=\\frac{3{\\pi }^{2}}{16}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77788/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c"] :knowledge-point/questions ["q-77788"] :db/ensure [:knowledge-point/validate]} {:db/id "q-29938/selection/b0268ffab97bb8fb45c260106dab456aa5c59a1a3724c3711e908fb5105be6b7" :answer/id #uuid "548182d5-ba6c-55ee-b3c0-64aab91113c0" :answer/type :answer.type/math :answer/value "4\\,746" :db/ensure [:answer/validate]} {:db/id "q-29938/selection/524c6e0f946ce3994a022ac951e768a72c1813cf14016487cd5276decc7f3b62" :answer/id #uuid "7c4dbf3a-7cd9-5861-8948-d0d35f1e1b12" :answer/type :answer.type/math :answer/value "7\\,641" :db/ensure [:answer/validate]} {:db/id "q-29938/selection/d0795dccb83c33dee9f6c40fc5861981194d922d39108f0d1718f2db6c872d68" :answer/id #uuid "e818ea6a-f98e-5fcf-803e-021b7befa35f" :answer/type :answer.type/math :answer/value "1\\,764" :db/ensure [:answer/validate]} {:db/id "q-29938/selection/3eb7e86a5301d81e22123b1f8828df783a8aa2579e4ae66cbac8a2a4a641d5de" :answer/id #uuid "b45c8c7d-4811-5711-a0d2-20dd6d93dd82" :answer/type :answer.type/math :answer/value "4\\,176" :db/ensure [:answer/validate]} {:db/id "q-29938/selection/a0228fd582809fc506469c07c6d83c7757563ccc7b4eb0eebff8794ce0778fc9" :answer/id #uuid "8045ce5e-17fd-56e4-b1f9-e2376449840c" :answer/type :answer.type/math :answer/value "6\\,741" :db/ensure [:answer/validate]} {:db/id "q-29938/selection" :answer-field/id #uuid "b30c3735-b621-50ba-bed0-8145d65b9808" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29938/selection/a0228fd582809fc506469c07c6d83c7757563ccc7b4eb0eebff8794ce0778fc9" :answer-field/choices ["q-29938/selection/b0268ffab97bb8fb45c260106dab456aa5c59a1a3724c3711e908fb5105be6b7" "q-29938/selection/524c6e0f946ce3994a022ac951e768a72c1813cf14016487cd5276decc7f3b62" "q-29938/selection/d0795dccb83c33dee9f6c40fc5861981194d922d39108f0d1718f2db6c872d68" "q-29938/selection/3eb7e86a5301d81e22123b1f8828df783a8aa2579e4ae66cbac8a2a4a641d5de" "q-29938/selection/a0228fd582809fc506469c07c6d83c7757563ccc7b4eb0eebff8794ce0778fc9"] :db/ensure [:answer-field/validate]} {:db/id "q-29938" :question/id #uuid "fa37b599-4ad5-59f0-a1aa-7677947192cf" :question/math-academy-id "q-29938" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{5}{4}$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{4}{5}.\n$$\n\nNow, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{4}{5})=(53.130\\,1…)^{∘}≈{53.130}^{∘}\n$$\n\nSince ${53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={53.130}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={53.130}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={53.130}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/605af77803fb027c09833b50801fe4b8e6a42a2b623af94a732d0f2f222f9f4a.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{53.130}^{∘} \\\\  & ={126.870}^{∘}\\end{aligned}\n$$\n\nTherefore, the solutions are $x={53.130}^{∘},{126.870}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈53.130\\cdot 126.870≈6\\,741.\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-29938/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c"] :knowledge-point/questions ["q-29938"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338802/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "2c8fbdd8-e78c-518d-afa5-aa853f072eab" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-338802/field-1" :answer-field/id #uuid "aa2cb7f7-5055-5535-8601-c96d1e8b9c6f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338802/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-338802/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-338802/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "46a8baa8-4cc2-5e27-b16c-87a8c07c03c5" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-338802/field-2" :answer-field/id #uuid "b3543a7d-a957-5f9d-acef-f17cab9b7a72" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338802/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer-field/choices ["q-338802/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649"] :db/ensure [:answer-field/validate]} {:db/id "q-338802" :question/id #uuid "22a6864e-ab1d-5bbc-9659-d70aedb84665" :question/math-academy-id "q-338802" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x-2\\sqrt{3},$ for $-{180}^{∘}\\le x<{180}^{∘},$ are\n\n$x=$\n{{field-1}}${}^{∘},\\,x=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we rearrange the given equation and isolate $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x & =4\\operatorname{csc}⁡x-2\\sqrt{3} \\\\ -3\\operatorname{csc}⁡x & =-2\\sqrt{3} \\\\ \\operatorname{csc}⁡x & =\\frac{2\\sqrt{3}}{3}\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nThen, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{\\sqrt{3}}{2})={60}^{∘}\n$$\n\nSince ${60}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={60}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/fd0cf34edebb21a059d60bb3588b27df2da4c86de0bdca044c0e702d9e239d7b.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{60}^{∘} \\\\  & ={120}^{∘}\\end{aligned}\n$$\n\nSo, the solutions to the equation, in ascending order, are \n\n$$\nx={60}^{∘},\\,x={120}^{∘}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-338802/field-1" "q-338802/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c"] :knowledge-point/questions ["q-338802"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274989/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "397b6836-1954-5965-a677-7c863d978740" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-274989/field-1/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454" :answer/id #uuid "2ade87a4-b691-5e0d-ac43-408b4b408416" :answer/type :answer.type/math :answer/value "-60" :db/ensure [:answer/validate]} {:db/id "q-274989/field-1" :answer-field/id #uuid "6d9cf82c-d1a6-523c-8154-a37bbaaf4fd9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274989/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer-field/choices ["q-274989/field-1/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-274989/field-1/ebfc0e0786b9e08f32fe2539ae50e791a60b7c4613bb2a0820cefbd3ea742454"] :db/ensure [:answer-field/validate]} {:db/id "q-274989/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "3ff364d7-4c5a-5647-b344-b7b2bb3ae3fa" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-274989/field-2" :answer-field/id #uuid "d064a5ca-3ff4-5952-80d6-7a2dbbc0af00" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274989/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer-field/choices ["q-274989/field-2/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649"] :db/ensure [:answer-field/validate]} {:db/id "q-274989" :question/id #uuid "d39e49e4-b84f-572a-acf5-51f22a351154" :question/math-academy-id "q-274989" :question/problem "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{csc}⁡x=\\frac{\\sqrt{12}}{3},$ for $-{180}^{∘}\\le x<{180}^{∘},$  are\n\n$x=$\n{{field-1}}${}^{∘},\\,x=$\n{{field-2}}${}^{∘}.$" :question/worked-solution "First, we simplify the given equation:\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x & =\\frac{\\sqrt{12}}{3} \\\\ \\operatorname{csc}⁡x & =\\frac{\\sqrt{4\\cdot 3}}{3} \\\\ \\operatorname{csc}⁡x & =\\frac{2\\sqrt{3}}{3}\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}.\n$$\n\nThen, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{3}{2\\sqrt{3}})={60}^{∘}\n$$\n\nSince ${60}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={60}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/4cb8f27f6c108091d233ec0f2a2dbb3439c7df93747917e6a50db770642e76f8.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{60}^{∘} \\\\  & ={120}^{∘}\\end{aligned}\n$$\n\nSo, the solutions to the equation, in ascending order, are \n\n$$\nx={60}^{∘},\\,x={120}^{∘}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-274989/field-1" "q-274989/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c"] :knowledge-point/questions ["q-274989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338798/field-1/e52b829daa8bd68fe53c085738a0d4fbb4032f675657f14b3e43001213161d96" :answer/id #uuid "ee01796e-e398-5fdd-9f22-40dc37629b69" :answer/type :answer.type/math :answer/value "-\\frac{3\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-338798/field-1" :answer-field/id #uuid "6725808f-d1c3-525a-8896-7b59c87abd21" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338798/field-1/e52b829daa8bd68fe53c085738a0d4fbb4032f675657f14b3e43001213161d96" :answer-field/choices ["q-338798/field-1/e52b829daa8bd68fe53c085738a0d4fbb4032f675657f14b3e43001213161d96"] :db/ensure [:answer-field/validate]} {:db/id "q-338798/field-2/1dee3a8b4e2e69484264522b7c3f6207b09ecde7ad469649dd240ad6a8e6346d" :answer/id #uuid "5da2b12d-8aca-54bf-b633-9f6f38393b3d" :answer/type :answer.type/math :answer/value "-\\frac{\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-338798/field-2" :answer-field/id #uuid "08e1d500-fbff-5052-9390-7c55d955ba5d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338798/field-2/1dee3a8b4e2e69484264522b7c3f6207b09ecde7ad469649dd240ad6a8e6346d" :answer-field/choices ["q-338798/field-2/1dee3a8b4e2e69484264522b7c3f6207b09ecde7ad469649dd240ad6a8e6346d"] :db/ensure [:answer-field/validate]} {:db/id "q-338798" :question/id #uuid "f5ce8b78-f898-5b03-a908-0659afcbaed8" :question/math-academy-id "q-338798" :question/problem "Expressed in **ascending order** in radians, the solutions to the equation $\\operatorname{csc}⁡x=-\\sqrt{2}$ for $-2\\pi \\le x<0,$ are\n\n$x=$\n{{field-1}}$,\\,x=$\n{{field-2}}." :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{\\sqrt{2}}=-\\frac{\\sqrt{2}}{2}.\n$$\n\nFirst, we have to find the principal value:\n\n$$\nx=\\text{arcsin}(-\\frac{\\sqrt{2}}{2})=-\\frac{\\pi }{4}\n$$\n\nSince $-\\frac{\\pi }{4}$ lies inside the given domain, our first solution is ${x}_{1}=-\\frac{\\pi }{4}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{4}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{4}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978818/assets/012f0986293e2a4318dc68633a4ac0e91732d74300496427aaaa6635b417efe4.png)\n\nSince the second solution lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}x & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}\\end{aligned}\n$$\n\nNote that $x=\\frac{5\\pi }{4}$ is not in the required domain $-2\\pi \\le x\\le 0.$ To get a solution that is inside the required domain, we subtract $2\\pi :$\n\n$$\n{x}_{2}=\\frac{5\\pi }{4}-2\\pi =-\\frac{3\\pi }{4}\n$$\n\nSo, in ascending order,  the solutions are \n\n$$\nx=-\\frac{3\\pi }{4},\\,x=-\\frac{\\pi }{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338798/field-1" "q-338798/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c"] :knowledge-point/questions ["q-338798"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-29095"] :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\n- $\\operatorname{csc}⁡x=10$\n- $\\operatorname{csc}⁡x=\\frac{1}{2}$\n- $\\operatorname{csc}⁡x=-1$" :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation II has no solutions." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-29477/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "5fa3b248-3339-5fab-bf52-9be6145a2935" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-29477/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "ec0bcb49-f163-5901-b70b-680a378b78e2" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-29477/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b4def338-5cb8-5748-8e8a-88b72b4cb8ab" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-29477/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "8d3121e9-eca3-5f06-87f2-5c24c8ad9426" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-29477/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "6b35c0be-a515-5d19-983a-c34cf3c89ca3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-29477/selection" :answer-field/id #uuid "f3128a90-e778-58fc-9819-2f2948ac4e3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-29477/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-29477/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-29477/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-29477/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-29477/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee01227