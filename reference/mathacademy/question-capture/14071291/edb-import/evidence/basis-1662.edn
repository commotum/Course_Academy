#{[{:db/id #edb/ref 17592186151883 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/id #uuid "203ff7a1-64cf-5564-8e7c-7ff9f652911a" :question/math-academy-id "e-6559" :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/518a42d25cd993f4bca2498bd9e91a466c7f0c4d71e109b6ab95c9717d34e9e0.png) find $\\,\\overline{\\mathbf{x}}.$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}-2+5\\text{i} \\\\ 5-9\\text{i} \\\\ -7+8\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-2+5\\text{i}} \\\\ \\overset{―}{5-9\\text{i}} \\\\ \\overset{―}{-7+8\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-2-5\\text{i} \\\\ 5+9\\text{i} \\\\ -7-8\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186151884 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/id #uuid "a2c8f19f-6c69-5891-847e-b6ef26f657bf" :question/math-academy-id "e-6560" :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/19d1bb5ad60407748a9c624dee20931c3c70a4bbc3727c4172cfb40384ab6a72.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/f7539ad7301462681681e738b905633b7aa73ca65b5512063e32fa22bcdc0d09.png) are the real and imaginary parts of the vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/a7976c73a0aeb9f286a281c193b3a00b38e8bc0fa36a30e985fe1e8f80d7796b.png) what is the value of $ab+cd?$" :question/worked-solution "For the given vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/4d6fc79d41790b29a966f7a3303329ab1b778856991ad5b3b85ee3965fce2e33.png) we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}-3+7\\text{i} \\\\ 5-2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-3 \\\\ 5\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -2\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $a=-3, b=5, c=7$ and $d=-2,$ which implies that\n\n$$\nab+cd=(-3) \\cdot 5 + 7 \\cdot (-2) = -29.\n$$"}] [{:db/id #edb/ref 17592186151943 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/id #uuid "5ec4fe6e-b357-5721-86d0-298df3fd33cf" :question/math-academy-id "e-7345" :question/problem "Find $\\textrm{Im}(k)$ given that \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/c51689b9c3a6e7c0e16e5121c725d9400b377ceab8f955bba851c2686991365b.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/1dbce6fee97471e3eb80d3ad5791f70311d6304f7a4d75fac77160e5ad9bee09.png)" :question/worked-solution "Since $\\overline{k\\mathbf{v}} = \\overline{k} \\, \\overline{\\mathbf{v}},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}4\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n4\\textrm{i}\\,\\overline{k}  = 8\\textrm{i}-12\n\\qquad\\Longrightarrow\\qquad\n\\overline{k}=\\dfrac{8\\textrm{i}-12}{4\\textrm i} = 2+3\\textrm{i}.\n$$\n\n \n\nTherefore, $k=\\overline{2+3\\textrm{i}}=2-3\\textrm{i}.$\n\nFinally, $\\textrm{Im}(k)=-3.$"}] [{:db/id #edb/ref 17592186323970 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0ca16cc-a1de-51ab-9634-ebce60d2e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186323972} {:answer/id #uuid "28bd076f-0625-5b80-ab0a-437a83339ff6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186323973} {:answer/id #uuid "4a806def-a6f9-5438-889c-444cc519b01f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186323974} {:answer/id #uuid "4c472f45-4815-5427-ba1f-d20ee4856748" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186323975} {:answer/id #uuid "f09e9b58-9de6-5320-89b8-a58bfdb47824" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186323976}] :answer-field/correct {:answer/id #uuid "b0ca16cc-a1de-51ab-9634-ebce60d2e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186323972} :answer-field/id #uuid "e742b114-6117-55eb-9b3c-8211bdb1474e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323971}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "240d967e-b792-5dc9-9e88-43ab9a9df5cf" :question/math-academy-id "q-130894" :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{4} \\\\ \\overset{―}{-5-\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4 \\\\ -5+\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =[\\begin{aligned}4\\overset{―}{k} \\\\ (-5+\\text{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}4\\overset{―}{k}=-20+28\\text{i} \\\\ (-5+\\text{i})\\overset{―}{k}=18-40\\text{i}.\\end{aligned}\n$$\n\nFrom the first equation, we get\n\n$$\n\\overset{―}{k}=-5+7\\text{i}\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(-5+\\text{i})(-5+7\\text{i})=18-40\\text{i}\n$$\n\nTherefore, $k=\\overset{―}{-5+7\\text{i}}=-5-7\\text{i}.$\n\nFinally, $\\text{Re}(k)=-5.$"}] [{:db/id #edb/ref 17592186323984 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b1ccfe2-5149-5296-910c-5891c834dd3b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9+6\\text{i} \\\\ -9+3\\text{i} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186323986} {:answer/id #uuid "d271ec7b-25d5-5634-bff1-4522194bc878" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6+9\\text{i} \\\\ 3+9\\text{i} \\\\ -3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186323987} {:answer/id #uuid "5abca682-36e9-5d81-8a32-03a5f7696bde" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6-9\\text{i} \\\\ 3-9\\text{i} \\\\ -3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186323988} {:answer/id #uuid "1e9beca8-bf24-5244-bcf2-3ec9628f3732" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186323989} {:answer/id #uuid "129a1cd3-fad5-5439-b92d-52344ec5d010" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9-6\\text{i} \\\\ -9-3\\text{i} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186323990}] :answer-field/correct {:answer/id #uuid "1e9beca8-bf24-5244-bcf2-3ec9628f3732" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186323989} :answer-field/id #uuid "1870f9d5-45c2-5c0d-a137-99da3eea5f76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323985}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4302a7c6-021d-538a-9010-38418efea819" :question/math-academy-id "q-76039" :question/problem "If $\\,x=[\\begin{aligned}9-6\\text{i} \\\\ 9-3\\text{i} \\\\ -3\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}9-6\\text{i} \\\\ 9-3\\text{i} \\\\ -3\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{9-6\\text{i}} \\\\ \\overset{―}{9-3\\text{i}} \\\\ \\overset{―}{-3}\\end{aligned}] \\\\  & =[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324005 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769fa1f0-18ef-5745-b581-b6c5ef87f96e" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186324007} {:answer/id #uuid "5dccf669-8a3a-5558-868e-2b40664de9af" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186324008} {:answer/id #uuid "6053698d-8243-519a-8f3c-d808e1ca53bb" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186324009} {:answer/id #uuid "b036cad6-7fa9-5e8c-a60e-655163058e53" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186324010} {:answer/id #uuid "ac8100ae-84c5-5cb6-a6be-7ee1211f533a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324011}] :answer-field/correct {:answer/id #uuid "769fa1f0-18ef-5745-b581-b6c5ef87f96e" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186324007} :answer-field/id #uuid "4a779bd3-d1ed-58eb-a93f-5a49dc8a1259" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324006}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ad2cea9f-a00a-5c0d-a433-c537f681daa5" :question/math-academy-id "q-76050" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}]\\,$ then what is the value of $ad+bc?$" :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-6 \\\\ 1\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -6\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=-6,b=1,c=7$ and $d=-6$, which implies that \n\n$$\nad+bc=(-6)\\cdot (-6)+1\\cdot 7=43.\n$$"}] [{:db/id #edb/ref 17592186324012 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5c1175-0187-5912-a73e-8b46a8020481" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186324014} {:answer/id #uuid "4d37e24a-f51a-56c6-9092-2924efc519c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}-3 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186324015} {:answer/id #uuid "565da8ea-27f3-5852-b173-f818ef9a63da" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186324016} {:answer/id #uuid "3b263f2c-f425-573c-ac2b-fe8de506a655" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}0 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186324017} {:answer/id #uuid "053f7fb9-452e-54c3-b67e-e4fd365fec26" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}0 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186324018}] :answer-field/correct {:answer/id #uuid "565da8ea-27f3-5852-b173-f818ef9a63da" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Re}(v)=[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186324016} :answer-field/id #uuid "6ad9f026-ec6e-5767-9b9b-781ec5896d7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324013}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bd989159-f241-5c29-ab2d-cd4e84930302" :question/math-academy-id "q-76053" :question/problem "Find the real part of the vector $v=[\\begin{aligned}3 \\\\ 7\\text{i}-4\\end{aligned}].$" :question/worked-solution "For the given vector $\\,v=[\\begin{aligned}3 \\\\ 7\\text{i}-4\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}3 \\\\ 7\\text{i}-4\\end{aligned}] \\\\  & =[\\begin{aligned}3+0\\text{i} \\\\ -4+7\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 \\\\ -4\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}\\,{{[\\begin{aligned}0 \\\\ 7\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324026 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6ffb90f-6e0a-5d23-b993-e0008ad07f7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324028} {:answer/id #uuid "3d4abbaa-fa95-5684-b7c0-35bc90a7f929" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324029} {:answer/id #uuid "5a9941ca-b1d5-5e16-b82d-709b3f7c86fe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186324030} {:answer/id #uuid "4035a6f8-9c2f-52f7-92be-24aa8a1aeef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324031} {:answer/id #uuid "c16f20c3-5a73-528b-a8de-c3bc3