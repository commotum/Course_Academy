#{[{:db/id #edb/ref 17592186151883 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/id #uuid "203ff7a1-64cf-5564-8e7c-7ff9f652911a" :question/math-academy-id "e-6559" :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/518a42d25cd993f4bca2498bd9e91a466c7f0c4d71e109b6ab95c9717d34e9e0.png) find $\\,\\overline{\\mathbf{x}}.$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}-2+5\\text{i} \\\\ 5-9\\text{i} \\\\ -7+8\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-2+5\\text{i}} \\\\ \\overset{―}{5-9\\text{i}} \\\\ \\overset{―}{-7+8\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-2-5\\text{i} \\\\ 5+9\\text{i} \\\\ -7-8\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186151884 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/id #uuid "a2c8f19f-6c69-5891-847e-b6ef26f657bf" :question/math-academy-id "e-6560" :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/e482e62cbd229d5d7d86010ab39fea9c56ba4b1dc7bd0553cbfbb6a2fbfc8398.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/f4542dad2dfcb51cd14caff63d99064d8a8e98772a58d4ab4022d2b572a1aad9.png) are the real and imaginary parts of the vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/8e644a1eabc085ec8e7087e07d0e5860ebf1808a63747d4f9196e08b08dd72ce.png) what is the value of $ab+cd?$" :question/worked-solution "For the given vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/1751b58c55d6a2d44458a084d8beb31862afb4746645f10cfa04198a583f509e.png) we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}-3+7\\text{i} \\\\ 5-2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-3 \\\\ 5\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -2\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $a=-3, b=5, c=7$ and $d=-2,$ which implies that\n\n$$\nab+cd=(-3) \\cdot 5 + 7 \\cdot (-2) = -29.\n$$"}] [{:db/id #edb/ref 17592186151943 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/id #uuid "5ec4fe6e-b357-5721-86d0-298df3fd33cf" :question/math-academy-id "e-7345" :question/problem "Find $\\textrm{Im}(k)$ given that \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/8c8e19d20f1b580e66eeb558341b4544d2785eb27ab602db7a221a6d9d80eefc.png)\nand\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/assets/2d9551b937b1e8be3c56db51ca26943e1436e07acebc1bfb0f89c16e5e7dcafc.png)" :question/worked-solution "Since $\\overline{k\\mathbf{v}} = \\overline{k} \\, \\overline{\\mathbf{v}},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}4\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n4\\textrm{i}\\,\\overline{k}  = 8\\textrm{i}-12\n\\qquad\\Longrightarrow\\qquad\n\\overline{k}=\\dfrac{8\\textrm{i}-12}{4\\textrm i} = 2+3\\textrm{i}.\n$$\n\n \n\nTherefore, $k=\\overline{2+3\\textrm{i}}=2-3\\textrm{i}.$\n\nFinally, $\\textrm{Im}(k)=-3.$"}] [{:db/id #edb/ref 17592186377270 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6841c593-38c3-5f4c-8f79-4e06bd4cfc2d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377272} {:answer/id #uuid "7dc02cfd-5153-5264-aec5-17b13d9641f3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377273} {:answer/id #uuid "9859b16d-7042-579f-971c-12430e154443" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186377274} {:answer/id #uuid "b3ac440c-2037-530f-805d-1aa13f399b55" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186377275} {:answer/id #uuid "a5ddf777-6ee9-55f6-babf-3d35b6f803c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377276}] :answer-field/correct {:answer/id #uuid "7dc02cfd-5153-5264-aec5-17b13d9641f3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377273} :answer-field/id #uuid "cd2b84a4-3b38-5635-a585-e8ac75ef75fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377271}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "860642d1-34a3-57fd-84b2-fc1c22ba4ce1" :question/math-academy-id "q-130890" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}]\\,$ then what is the value of $ac+bd?$" :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}1-3\\text{i} \\\\ -1-5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 \\\\ -1\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}{{[\\begin{aligned}-3 \\\\ -5\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=1,b=-1,c=-3$ and $d=-5$, which implies that \n\n$$\nac+bd=1\\cdot (-3)+(-1)\\cdot (-5)=2.\n$$"}] [{:db/id #edb/ref 17592186323970 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0ca16cc-a1de-51ab-9634-ebce60d2e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186323972} {:answer/id #uuid "28bd076f-0625-5b80-ab0a-437a83339ff6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186323973} {:answer/id #uuid "4a806def-a6f9-5438-889c-444cc519b01f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186323974} {:answer/id #uuid "4c472f45-4815-5427-ba1f-d20ee4856748" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186323975} {:answer/id #uuid "f09e9b58-9de6-5320-89b8-a58bfdb47824" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186323976}] :answer-field/correct {:answer/id #uuid "b0ca16cc-a1de-51ab-9634-ebce60d2e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186323972} :answer-field/id #uuid "e742b114-6117-55eb-9b3c-8211bdb1474e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323971}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "240d967e-b792-5dc9-9e88-43ab9a9df5cf" :question/math-academy-id "q-130894" :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}4 \\\\ -5-\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{4} \\\\ \\overset{―}{-5-\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4 \\\\ -5+\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}-20+28\\text{i} \\\\ 18-40\\text{i}\\end{aligned}] & =[\\begin{aligned}4\\overset{―}{k} \\\\ (-5+\\text{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}4\\overset{―}{k}=-20+28\\text{i} \\\\ (-5+\\text{i})\\overset{―}{k}=18-40\\text{i}.\\end{aligned}\n$$\n\nFrom the first equation, we get\n\n$$\n\\overset{―}{k}=-5+7\\text{i}\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(-5+\\text{i})(-5+7\\text{i})=18-40\\text{i}\n$$\n\nTherefore, $k=\\overset{―}{-5+7\\text{i}}=-5-7\\text{i}.$\n\nFinally, $\\text{Re}(k)=-5.$"}] [{:db/id #edb/ref 17592186377277 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfec780f-4856-5d74-a848-15508cd0a9fa" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186377279} {:answer/id #uuid "689269ce-ac06-5d72-b8fe-e8dd3220d27a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186377280} {:answer/id #uuid "100f1c41-2127-50a6-bd9c-dcc98761f12a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186377281} {:answer/id #uuid "5890b806-ef55-5308-b68d-22706d47c0e4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377282} {:answer/id #uuid "6e92b0cd-0de6-565a-8581-0d97fe697545" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186377283}] :answer-field/correct {:answer/id #uuid "5890b806-ef55-5308-b68d-22706d47c0e4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377282} :answer-field/id #uuid "3eb0cf22-7b42-5f5d-8a9c-6c74a39411e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377278}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a57c4fb0-dda2-54f7-aaee-9bbe5d3dacba" :question/math-academy-id "q-130896" :question/problem "Find $\\text{Im}(k)$ given that \n$v=[\\begin{aligned}0 \\\\ 2\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}0 \\\\ 6-4\\text{i}\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}0 \\\\ 6-4\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}0 \\\\ 2\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}0 \\\\ 6-4\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{0} \\\\ \\overset{―}{2\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 6-4\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}0 \\\\ -2\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 6-4\\text{i}\\end{aligned}] & =[\\begin{aligned}0 \\\\ -2\\text{i}\\,\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n-2\\text{i}\\,\\overset{―}{k}=6-4\\text{i}\\,⟹\\,\\overset{―}{k}=\\frac{6-4\\text{i}}{-2\\text{i}}=2+3\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{2+3\\text{i}}=2-3\\text{i}.$\n\nFinally, $\\text{Im}(k)=-3.$"}] [{:db/id #edb/ref 17592186152514 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a174515e-78e3-5573-a554-3dce48b5dd9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 + 3\\textrm{i} \\\\ 1 - \\textrm{i} \\\\ 3 - 5\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149995} {:answer/id #uuid "be75b0cf-ab03-5672-b671-2237d2c276f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 - \\textrm{i} \\\\ 3 + 2\\textrm{i} \\\\ 2 + 4\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149996} {:answer/id #uuid "ecc2ead7-7a5a-58ff-9e07-8ec2968e93d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 - 2\\textrm{i} \\\\ 1 + \\textrm{i} \\\\ 5 + 3\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149997} {:answer/id #uuid "17bdad4c-495f-5d68-bb05-38dc88538080" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 - 2\\textrm{i} \\\\ 1 - \\textrm{i} \\\\ 5 - 3\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149998} {:answer/id #uuid "75a0af5f-51c2-57a0-8a45-ee8e6bc94501" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 + 2\\textrm{i} \\\\ -1 + \\textrm{i} \\\\ -5 + 3\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149999}] :answer-field/correct {:answer/id #uuid "ecc2ead7-7a5a-58ff-9e07-8ec2968e93d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 - 2\\textrm{i} \\\\ 1 + \\textrm{i} \\\\ 5 + 3\\textrm{i}\\end{bmatrix}" :db/id #edb/ref 17592186149997} :answer-field/id #uuid "3008e358-e8b1-566d-876d-a946000dd4c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149994}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "019e7591-719d-591c-b80d-59dac2747689" :question/math-academy-id "q-38389" :question/problem "If $\\,x=[\\begin{aligned}3+2\\text{i} \\\\ 1-\\text{i} \\\\ 5-3\\text{i}\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}3+2\\text{i} \\\\ 1-\\text{i} \\\\ 5-3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{3+2\\text{i}} \\\\ \\overset{―}{1-\\text{i}} \\\\ \\overset{―}{5-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}3-2\\text{i} \\\\ 1+\\text{i} \\\\ 5+3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323984 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b1ccfe2-5149-5296-910c-5891c834dd3b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9+6\\text{i} \\\\ -9+3\\text{i} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186323986} {:answer/id #uuid "d271ec7b-25d5-5634-bff1-4522194bc878" :answer/type {:db/ident :answer.type/math} :answer/value "[\