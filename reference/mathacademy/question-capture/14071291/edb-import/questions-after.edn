:question/problem "If $\\,x=[\\begin{aligned}6 \\\\ 1-10\\text{i} \\\\ -7-3\\text{i}\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}6 \\\\ 1-10\\text{i} \\\\ -7-3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{6} \\\\ \\overset{―}{1-10\\text{i}} \\\\ \\overset{―}{-7-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 1+10\\text{i} \\\\ -7+3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377291 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f5ce59f-dd82-52e3-a969-551c95cffba4" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186377293} {:answer/id #uuid "9a596594-1797-5c88-bee2-7e43c1f291f1" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186377294} {:answer/id #uuid "3d87b205-1fc0-59ab-9c2f-49e4635e4af8" :answer/type {:db/ident :answer.type/math} :answer/value "-43" :db/id #edb/ref 17592186377295} {:answer/id #uuid "18b98275-da3c-5f62-8827-02b9ef6778f1" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186377296} {:answer/id #uuid "0f0eb018-0b0a-52cf-b689-8f92e32d1510" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186377297}] :answer-field/correct {:answer/id #uuid "9a596594-1797-5c88-bee2-7e43c1f291f1" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186377294} :answer-field/id #uuid "8128ef10-e8fa-53d6-acf9-7681724fc054" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377292}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1ee0c1db-79e5-5986-984a-43c2dda828c4" :question/math-academy-id "q-76048" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}8+\\text{i} \\\\ -5+3\\text{i}\\end{aligned}]\\,$ then what is the value of $ac-bd?$" :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}3-5\\text{i} \\\\ 6-3\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}8+\\text{i} \\\\ -5+3\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}8 \\\\ -5\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}1 \\\\ 3\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=8,b=-5,c=1$ and $d=3$, which implies that \n\n$$\nac-bd=8\\cdot 1-(-5)\\cdot 3=23.\n$$"}] [{:db/id #edb/ref 17592186324005 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769fa1f0-18ef-5745-b581-b6c5ef87f96e" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186324007} {:answer/id #uuid "5dccf669-8a3a-5558-868e-2b40664de9af" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186324008} {:answer/id #uuid "6053698d-8243-519a-8f3c-d808e1ca53bb" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186324009} {:answer/id #uuid "b036cad6-7fa9-5e8c-a60e-655163058e53" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186324010} {:answer/id #uuid "ac8100ae-84c5-5cb6-a6be-7ee1211f533a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324011}] :answer-field/correct {:answer/id #uuid "769fa1f0-18ef-5745-b581-b6c5ef87f96e" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186324007} :answer-field/id #uuid "4a779bd3-d1ed-58eb-a93f-5a49dc8a1259" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324006}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ad2cea9f-a00a-5c0d-a433-c537f681daa5" :question/math-academy-id "q-76050" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a \\\\ b\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}c \\\\ d\\end{aligned}]\\,$ are the real and imaginary parts of the vector $\\,x=[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}]\\,$ then what is the value of $ad+bc?$" :question/worked-solution "For the given vector $\\,x=[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-6 \\\\ 1\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -6\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=-6,b=1,c=7$ and $d=-6$, which implies that \n\n$$\nad+bc=(-6)\\cdot (-6)+1\\cdot 7=43.\n$$"}] [{:db/id #edb/ref 17592186377298 :knowledge-point/_questions [{:knowledge-point/id #uuid "689f9f44-4776-56a7-915f-d0dab0755002" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d261ef51-c185-5b37-9486-b4f58ec3dbba" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}4 \\\\ 5\\end{aligned}]\\," :db/id #edb/ref 17592186377300} {:answer/id #uuid "9693749f-9f2e-55b4-852a-4f5cdedc1ae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}4 \\\\ -8\\end{aligned}]\\," :db/id #edb/ref 17592186377301} {:answer/id #uuid "718c3f8b-1856-5953-9dd0-10b43b25cf6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}4 \\\\ -3\\end{aligned}]\\," :db/id #edb/ref 17592186377302} {:answer/id #uuid "891b7296-5bfd-5426-a2dd-aa2b76966065" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]\\," :db/id #edb/ref 17592186377303} {:answer/id #uuid "ef3d2ab7-ccad-5da6-81fe-6ae06aca24b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}5 \\\\ -8\\end{aligned}]\\," :db/id #edb/ref 17592186377304}] :answer-field/correct {:answer/id #uuid "9693749f-9f2e-55b4-852a-4f5cdedc1ae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\,\\text{Im}(u)=[\\begin{aligned}4 \\\\ -8\\end{aligned}]\\," :db/id #edb/ref 17592186377301} :answer-field/id #uuid "74d43244-7646-5c35-8d5b-ff2c6d42ff7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377299}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a446fc13-1f8b-53d5-93d7-8e7615d6a3f0" :question/math-academy-id "q-76052" :question/problem "Find the imaginary part of the vector $u=[\\begin{aligned}4\\text{i}+5 \\\\ -8\\text{i}+7\\end{aligned}].$" :question/worked-solution "For the given vector $\\,u=[\\begin{aligned}4\\text{i}+5 \\\\ -8\\text{i}+7\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}u & =[\\begin{aligned}4\\text{i}+5 \\\\ -8\\text{i}+7\\end{aligned}] \\\\  & =[\\begin{aligned}5+4\\text{i} \\\\ 7-8\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}5 \\\\ 7\\end{aligned}]}_{⏟}}_{\\text{Re}(u)}+\\text{i}\\,{{[\\begin{aligned}4 \\\\ -8\\end{aligned}]}_{⏟}}_{\\text{Im}(u)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324012 :knowledge-point/_questions [{:knowled