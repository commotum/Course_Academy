\\begin{aligned}3 \\\\ 7\\text{i}-4\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}v & =[\\begin{aligned}3 \\\\ 7\\text{i}-4\\end{aligned}] \\\\  & =[\\begin{aligned}3+0\\text{i} \\\\ -4+7\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}3 \\\\ -4\\end{aligned}]}_{⏟}}_{\\text{Re}(v)}+\\text{i}\\,{{[\\begin{aligned}0 \\\\ 7\\end{aligned}]}_{⏟}}_{\\text{Im}(v)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377305 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f23bcfc2-fe73-5d0d-a05b-57ba2cc7d7fa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ -2-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377307} {:answer/id #uuid "7367f02c-d998-5077-8e5e-f04587406914" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ 2-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377308} {:answer/id #uuid "ad4a0f49-6708-59f6-bade-2eb31e1d7a6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3-8\\text{i} \\\\ 2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377309} {:answer/id #uuid "73662fa5-bc60-56f5-a95e-37a8cc5aba84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ 2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377310} {:answer/id #uuid "715f64bf-4b37-5097-9f61-0ba0106ffec9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377311}] :answer-field/correct {:answer/id #uuid "715f64bf-4b37-5097-9f61-0ba0106ffec9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377311} :answer-field/id #uuid "6ee5c16e-8117-53b0-bdcf-b41eda2f201d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377306}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "711300c3-0b93-5c10-812e-3a69e9246478" :question/math-academy-id "q-77547" :question/problem "Given the vectors ${x}_{1}=[\\begin{aligned}3-8\\text{i} \\\\ -4+2\\text{i}\\end{aligned}]$ and ${x}_{2}=[\\begin{aligned}-6\\text{i} \\\\ 1+2\\text{i}\\end{aligned}]$, then ${x}_{1}+\\text{i}\\cdot {\\overset{―}{x}}_{2}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{2} & =\\overset{―}{[\\begin{aligned}-6\\text{i} \\\\ 1+2\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-6\\text{i}} \\\\ \\overset{―}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}6\\text{i} \\\\ 1-2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {\\overset{―}{x}}_{2} & =\\text{i}\\cdot [\\begin{aligned}6\\text{i} \\\\ 1-2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}6{\\text{i}}^{2} \\\\ \\text{i}-2{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ 2+\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{x}_{1}+\\text{i}\\cdot {\\overset{―}{x}}_{2} & =[\\begin{aligned}3-8\\text{i} \\\\ -4+2\\text{i}\\end{aligned}]+[\\begin{aligned}-6 \\\\ 2+\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377312 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b91d11-0d53-502b-bc03-38d73c750b02" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-7\\text{i} \\\\ 2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377314} {:answer/id #uuid "103edf38-ed80-52c8-87e2-1df5f1477d58" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\text{i} \\\\ 2-7\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377315} {:answer/id #uuid "7c80591e-f301-5ceb-a9da-5f41b8ed6727" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 2-\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377316} {:answer/id #uuid "dc5eaa95-14c6-5d3f-8e1b-b7e6851f3489" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2\\text{i} \\\\ 2+7\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377317} {:answer/id #uuid "e5054c3b-bcb6-5a01-a1fb-737f8a092e28" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} \\\\ -2-7\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377318}] :answer-field/correct {:answer/id #uuid "103edf38-ed80-52c8-87e2-1df5f1477d58" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\text{i} \\\\ 2-7\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186377315} :answer-field/id #uuid "d867a469-8c8c-5a43-af2b-04c0fd6c7c91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377313}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b26e3f5c-af40-5720-ba3b-89c348d8d236" :question/math-academy-id "q-77548" :question/problem "Given the vectors ${x}_{1}=[\\begin{aligned}4+3\\text{i} \\\\ -1+3\\text{i}\\end{aligned}]$ and ${x}_{2}=[\\begin{aligned}5+4\\text{i} \\\\ -4-3\\text{i}\\end{aligned}]$, then ${\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1} & =\\overset{―}{[\\begin{aligned}4+3\\text{i} \\\\ -1+3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{4+3\\text{i}} \\\\ \\overset{―}{-1+3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}4-3\\text{i} \\\\ -1-3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {x}_{2} & =\\text{i}\\cdot [\\begin{aligned}5+4\\text{i} \\\\ -4-3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}5\\text{i}+4{\\text{i}}^{2} \\\\ -4\\text{i}-3{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-4+5\\text{i} \\\\ 3-4\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2} & =[\\begin{aligned}4-3\\text{i} \\\\ -1-3\\text{i}\\end{aligned}]+[\\begin{aligned}-4+5\\text{i} \\\\ 3-4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\text{i} \\\\ 2-7\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186377319 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b49a73b-6768-5433-abc2-7c6bf28f2d11" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186377321} {:answer/id #uuid "b6bfd972-4db6-5ed0-8334-306f6705d263" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186377322} {:answer/id #uuid "8a922ad4-5639-52cc-a0fb-b4a722c6f57c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186377323} {:answer/id #uuid "821e7eab-7b0f-5d12-a635-623465881225" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377324} {:answer/id #uuid "d3819713-488b-515f-86f9-3c2b341abe76" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186377325}] :answer-field/correct {:answer/id #uuid "821e7eab-7b0f-5d12-a635-623465881225" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186377324} :answer-field/id #uuid "7970321f-5f1f-59dc-b9a3-7f7e1588c07d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377320}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "84ab4458-1d33-57f6-a0cd-34942a74290b" :question/math-academy-id "q-81919" :question/problem "Find $\\text{Im}(k)$ given that \n$v=[\\begin{aligned}0 \\\\ -3\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}0 \\\\ -3\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{0} \\\\ \\overset{―}{-3\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}0 \\\\ 3\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =[\\begin{aligned}0 \\\\ 3\\text{i}\\,\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n3\\text{i}\\,\\overset{―}{k}=3\\text{i}-9\\,⟹\\,\\overset{―}{k}=\\frac{3\\text{i}-9}{3\\text{i}}=1+3\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{1+3\\text{i}}=1-3\\text{i}.$\n\nFinally, $\\text{Im}(k)=-3.$"}] [{:db/id #edb/ref 17592186324026 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6ffb90f-6e0a-5d23-b993-e0008ad07f7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186324028} {:answer/id #uuid "3d4abbaa-fa95-5684-b7c0-35bc90a7f929" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186324029} {:answer/id #uuid "5a9941ca-b1d5-5e16-b82d-709b3f7c86fe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186324030} {:answer/id #uuid "4035a6f8-9c2f-52f7-92be-24aa8a1aeef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324031} {:answer/id #uuid "c16f20c3-5a73-528b-a8de-c3bc30d66782" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186324032}] :answer-field/correct {:answer/id #uuid "4035a6f8-9c2f-52f7-92be-24aa8a1aeef2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186324031} :answer-field/id #uuid "5d029c77-2d78-5c95-bf94-f4ea7057e0f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "095c99b8-e6ef-5b03-87e7-b89e96b42b60" :question/math-academy-id "q-82034" :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}-4+8\\text{i} \\\\ 4\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4+8\\text{i} \\\\ 4\\end{aligned}]} \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4+8\\text{i}} \\\\ \\overset{―}{4}\\end{aligned}] \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}-4-8\\text{i} \\\\ 4\\end{aligned}] \\\\ [\\begin{aligned}20 \\\\ -4+8\\text{i}\\end{aligned}] & =[\\begin{aligned}(-4-8\\text{i})\\overset{―}{k} \\\\ 4\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}(-4-8\\text{i})\\overset{―}{k}=20 \\\\ 4\\overset{―}{k}=-4+8\\text{i}.\\end{aligned}\n$$\n\nFrom the second equation, we get \n\n$$\n\\overset{―}{k}=-1+2\\text{i}.\n$$\n\nSubstituting this into the first equation, we obtain the true statement\n\n$$\n(-4-8\\text{i})(-1+2\\text{i})=20.\n$$\n\nTherefore, $k=\\overset{―}{-1+2\\text{i}}=-1-2\\text{i}.$\n\nFinally, $\\text{Re}(k)=-1.$"}] [{:db/id #edb/ref 17592186152761 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a" :knowledge-point/title "Finding the Real or Imaginary Part of a Scalar Given the Conjugate of a Scaled Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a088fbca-0710-5819-88dd-98283ae60a9c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186151477} {:answer/id #uuid "e220cce8-ff3b-535d-a4bc-289040f45540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186151478} {:answer/id #uuid "f7960307-2c18-5273-bcae-5630ad63c200" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186151479} {:answer/id #uuid "f856370b-7ceb-5ed0-9d24-4b7bf638db46" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186151480} {:answer/id #uuid "589dacc8-c0f3-5583-8c6f-62ed70edfda8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186151481}] :answer-field/correct {:answer/id #uuid "e220cce8-ff3b-535d-a4bc-289040f45540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186151478} :answer-field/id #uuid "bba6286d-49e3-5cca-afcc-cd9f96d92e0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151476}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "715fab71-dc69-5ef1-9d6f-8b3227fd9c29" :question/math-academy-id "q-82041" :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}-5 \\\\ 2+4\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-5 \\\\ 2+4\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-5} \\\\ \\overset{―}{2+4\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}-5 \\\\ 2-4\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =[\\begin{aligned}-5\\overset{―}{k} \\\\ (2-4\\text{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}-5\\overset{―}{k}=-5-10\\text{i} \\\\ (2-4\\text{i})\\overset{―}{k}=10.\\end{aligned}\n$$\n\nFrom the first equation, we get \n\n$$\n\\overset{―}{k}=1+2\\text{i}.\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(2-4\\text{i})(1+2\\text{i})=10.\n$$\n\nTherefore, $k=\\overset{―}{1+2\\text{i}}=1-2\\text{i}.$\n\nFinally, $\\text{Re}(k)=1.$"}]}
