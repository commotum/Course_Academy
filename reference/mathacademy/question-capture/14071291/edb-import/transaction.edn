f651f4ddec0c00f57faebf" "q-77548/selection/9d5b9eebb893557da5025ad1f21723196867503c6c78bccc109e17c933c57362"] :db/ensure [:answer-field/validate]} {:db/id "q-77548" :question/id #uuid "b26e3f5c-af40-5720-ba3b-89c348d8d236" :question/math-academy-id "q-77548" :question/problem "Given the vectors ${x}_{1}=[\\begin{aligned}4+3\\text{i} \\\\ -1+3\\text{i}\\end{aligned}]$ and ${x}_{2}=[\\begin{aligned}5+4\\text{i} \\\\ -4-3\\text{i}\\end{aligned}]$, then ${\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1} & =\\overset{―}{[\\begin{aligned}4+3\\text{i} \\\\ -1+3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{4+3\\text{i}} \\\\ \\overset{―}{-1+3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}4-3\\text{i} \\\\ -1-3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {x}_{2} & =\\text{i}\\cdot [\\begin{aligned}5+4\\text{i} \\\\ -4-3\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}5\\text{i}+4{\\text{i}}^{2} \\\\ -4\\text{i}-3{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-4+5\\text{i} \\\\ 3-4\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{1}+\\text{i}\\cdot {x}_{2} & =[\\begin{aligned}4-3\\text{i} \\\\ -1-3\\text{i}\\end{aligned}]+[\\begin{aligned}-4+5\\text{i} \\\\ 3-4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\text{i} \\\\ 2-7\\text{i}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e"] :knowledge-point/questions ["q-77548"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76043/selection/bd7a55e83bd199dc83925f3a4b43148a44159ae9cfdb65dabaa52