\\text{i}-9\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{0} \\\\ \\overset{―}{-3\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}0 \\\\ 3\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 3\\text{i}-9\\end{aligned}] & =[\\begin{aligned}0 \\\\ 3\\text{i}\\,\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n3\\text{i}\\,\\overset{―}{k}=3\\text{i}-9\\,⟹\\,\\overset{―}{k}=\\frac{3\\text{i}-9}{3\\text{i}}=1+3\\text{i}.\n$$\n\n \n\nTherefore, $k=\\overset{―}{1+3\\text{i}}=1-3\\text{i}.$\n\nFinally, $\\text{Im}(k)=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81919/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eaed693-68df-5da8-942d-408d6871358a"] :knowledge-point/questions ["q-81919"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-82041"] :question/problem "Find $\\text{Re}(k)$ given that\n$v=[\\begin{aligned}-5 \\\\ 2+4\\text{i}\\end{aligned}]$\nand\n$\\overset{―}{kv}=[\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}].$" :question/worked-solution "Since $\\overset{―}{kv}=\\overset{―}{k}\\,\\overset{―}{v},$ we get the following equation:\n\n$$\n\\begin{aligned}\\overset{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-5 \\\\ 2+4\\text{i}\\end{aligned}]} \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-5} \\\\ \\overset{―}{2+4\\text{i}}\\end{aligned}] \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}-5 \\\\ 2-4\\text{i}\\end{aligned}] \\\\ [\\begin{aligned}-5-10\\text{i} \\\\ 10\\end{aligned}] & =[\\begin{aligned}-5\\overset{―}{k} \\\\ (2-4\\text{i})\\overset{―}{k}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain the system\n\n$$\n{\\begin{aligned}-5\\overset{―}{k}=-5-10\\text{i} \\\\ (2-4\\text{i})\\overset{―}{k}=10.\\end{aligned}\n$$\n\nFrom the first equation, we get \n\n$$\n\\overset{―}{k}=1+2\\text{i}.\n$$\n\nSubstituting this into the second equation, we obtain the true statement\n\n$$\n(2-4\\text{i})(1+2\\text{i})=10.\n$$\n\nTherefore, $k=\\overset{―}{1+2\\text{i}}=1-2\\text{i}.$\n\nFinally, $\\text{Re}(k)=1.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-130896/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "100f1c41-2127-50a6-bd9c-dcc98761f12a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-130896/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "5890b806-ef55-5308-b68d-22706d47c0e4" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-130896/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "6e92b0cd-0de6-565a-8581-0d97fe697545" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-130896/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "689269ce-ac06-5d72-b8fe-e8dd3220d27a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-130896/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "bfec780f-4856-5d74-a848-15508cd0a9fa" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-130896/selection" :answer-field/id #uuid "3eb0cf22-7b42-5f5d-8a9c-6c74a39411e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130896/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-130896/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc20