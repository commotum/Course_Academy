{―}{kv} & =\\overset{―}{k}\\,\\overset{―}{v} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,\\overset{―}{[\\begin{aligned}-4\\text{i} \\\\ 0\\end{aligned}]} \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}\\overset{―}{-4\\text{i}} \\\\ \\overset{―}{0}\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =\\overset{―}{k}\\,[\\begin{aligned}4\\text{i} \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}8\\text{i}-12 \\\\ 0\\end{aligned}] & =[\\begin{aligned}4\\text{i}\\,\\overset{―}{k} \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we obtain that \n\n$$\n4\\textrm{i}\\,\\overline{k}  = 8\\textrm{i}-12\n\\qquad\\Longrightarrow\\qquad\n\\overline{k}=\\dfrac{8\\textrm{i}-12}{4\\textrm i} = 2+3\\textrm{i}.\n$$\n\n \n\nTherefore, $k=\\overline{2+3\\textrm{i}}=2-3\\textrm{i}.$\n\nFinally, $\\textrm{Im}(k)=-3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071291/example-7345.json" "file_sha256" "265630a4b4200f3e7328e86051b0dd1e4d2ccbb9a9cfa824a8624bc65c5c236e"}] "usage" {"q-130894" [] "e-6560" [] "q-76050" [] "q-82041" [] "q-76039" [] "q-82034" [] "e-6559" [] "q-76053" [] "e-7345" [] "q-38389" []} "basis" 2656 "retractions" [[17592186152514 :question/problem "If $x = \\begin{bmatrix}3 + 2\\textrm{i} \\\\ 1 - \\textrm{i} \\\\ 5 - 3\\textrm{i}\\end{bmatrix}$ then $x^(―) =$"] [17592186152761 :question/problem "Find $Re(k)$ given that\n\n$v = \\begin{bmatrix}-5 \\\\ 2 + 4\\textrm{i}\\end{bmatrix}$\nand\n$kv^(―) = \\begin{bmatrix}-5 - 10\\textrm{i} \\\\ 10\\end{bmatrix}$."] [17592186151883 :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/assets/518a42d25cd993f4bca2498bd9e91a466c7f0c4d71e109b6ab95c9717d34e9e0.png) find $\\,\\overline{\\mathbf{x}}.$"] [17592186151884 :question/problem "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/q