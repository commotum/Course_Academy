b-import/verification.json"} {"question" "q-76050" "field" nil "attribute" "question/worked-solution" "value" "For the given vector $\\,x=[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}]\\,$ we have that\n\n$$\n\\begin{aligned}x & =[\\begin{aligned}-6+7\\text{i} \\\\ 1-6\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}-6 \\\\ 1\\end{aligned}]}_{⏟}}_{\\text{Re}(x)}+\\text{i}\\,{{[\\begin{aligned}7 \\\\ -6\\end{aligned}]}_{⏟}}_{\\text{Im}(x)}.\\end{aligned}\n$$\n\nTherefore $\\,a=-6,b=1,c=7$ and $d=-6$, which implies that \n\n$$\nad+bc=(-6)\\cdot (-6)+1\\cdot 7=43.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/state.json" "file_sha256" "ce7c440583574e8cdd8fe5a25fea233315a6bf1cc81722a696d3f04e80f9a1fc" "basis" 1662 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/edb-import/verification.json"} {"question" "q-76050" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/activity-metadata.json" "file_sha256" "f4b86640334b0f49f7977fb59639aabb6d7aff9789dae17642a4e607e693d252" "basis" 1662 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/edb-import/verification.json"} {"question" "q-76050" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/state.json" "file_sha256" "ce7c440583574e8cdd8fe5a25fea233315a6bf1cc81722a696d3f04e80f9a1fc" "basis" 1662 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14041865/edb-import/verification.json"} {"question" "q-76050" "field" "select