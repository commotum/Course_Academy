#{[{:db/id #edb/ref 17592186308833 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "713fc33d-83da-590f-9f68-03deb34d7745" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{12}" :db/id #edb/ref 17592186308835} {:answer/id #uuid "896cd95c-a469-50db-a939-47330ea46144" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{12}" :db/id #edb/ref 17592186308836} {:answer/id #uuid "44143780-c8cd-55cd-9fe2-f289fdbbbfa5" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{6}" :db/id #edb/ref 17592186308837} {:answer/id #uuid "c69d2fdb-8d95-5e19-9150-433c74826146" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{12}" :db/id #edb/ref 17592186308838} {:answer/id #uuid "5a10463e-18ff-55ca-a408-e678a6c87bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{12}" :db/id #edb/ref 17592186308839}] :answer-field/correct {:answer/id #uuid "5a10463e-18ff-55ca-a408-e678a6c87bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{12}" :db/id #edb/ref 17592186308839} :answer-field/id #uuid "c8deeb3c-b80e-5f4d-baab-4e4a74ff10dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308834}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "49164e78-91b8-549a-8993-e1fab20375b4" :question/math-academy-id "q-87125" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/c010f583fc33ee3c5335c16c0aaf1c20c2e5cf82d49fe7cf14e8e5661bf202fc.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{7\\pi }{12}=\\frac{5\\pi }{12}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{5\\pi }{12}.$"}]}
