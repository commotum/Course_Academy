#{[{:db/id #edb/ref 17592186338944 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9627a6e-c790-5025-b101-12ea1591e8fd" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{6}{2})" :db/id #edb/ref 17592186338946} {:answer/id #uuid "74876d33-40ef-5630-9a88-6a3381c99893" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{1})" :db/id #edb/ref 17592186338947} {:answer/id #uuid "e89eeffb-1442-5ad9-8c7e-466d35845290" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/id #edb/ref 17592186338948} {:answer/id #uuid "131f526d-0f02-57ba-9efd-0f15ea3a3905" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{1})" :db/id #edb/ref 17592186338949} {:answer/id #uuid "d94e3891-28c7-5c24-b058-d0e91d5957a9" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{3})" :db/id #edb/ref 17592186338950}] :answer-field/correct {:answer/id #uuid "d94e3891-28c7-5c24-b058-d0e91d5957a9" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{3})" :db/id #edb/ref 17592186338950} :answer-field/id #uuid "7a65eb51-3516-5f48-b5a6-84c50f962faf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338945}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "31c261c0-c13d-56df-97d3-69bf96671591" :question/math-academy-id "q-113607" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{3})=(\\genfrac{}{}{0pt}{}{5}{2})+[]\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{6}{3}),$ we need to find the number that is located in row $6$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{6}{3})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & (\\genfrac{}{}{0pt}{}{6}{0}) &  & (\\genfrac{}{}{0pt}{}{6}{1}) &  & (\\genfrac{}{}{0pt}{}{6}{2}) &  & (\\genfrac{}{}{0pt}{}{6}{3}) &  & (\\genfrac{}{}{0pt}{}{6}{4}) &  & (\\genfrac{}{}{0pt}{}{6}{5}) &  & (\\genfrac{}{}{0pt}{}{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{6}{3})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{3})=(\\genfrac{}{}{0pt}{}{5}{2})+(\\genfrac{}{}{0pt}{}{5}{3})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{5}{3}).$"}] [{:db/id #edb/ref 17592186338951 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7c390cf-4cd1-50f5-800b-879fea95f549" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-1$ or $x>4$" :db/id #edb/ref 17592186338953} {:answer/id #uuid "8c61ba4a-50b5-5548-a6bb-235cc6daf555" :answer/type {:db/ident :answer.type/math} :answer/value "-4<x<-1" :db/id #edb/ref 17592186338954} {:answer/id #uuid "e1f7479f-7f79-5184-bc71-130f64f3e07b" :answer/type {:db/ident :answer.type/math} :answer/value "-1<x<4" :db/id #edb/ref 17592186338955} {:answer/id #uuid "45e14bd3-d5b4-5f08-87a1-f70494cd1f3b" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-4$ or $x>1$" :db/id #edb/ref 17592186338956} {:answer/id #uuid "d7374576-071a-5fa1-8521-87a67d55ea2f" :answer/type {:db/ident :answer.type/math} :answer/value "x>0" :db/id #edb/ref 17592186338957}] :answer-field/correct {:answer/id #uuid "e7c390cf-4cd1-50f5-800b-879fea95f549" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-1$ or $x>4$" :db/id #edb/ref 17592186338953} :answer-field/id #uuid "d8ff6265-a9a6-5700-a27d-6a1a7e781291" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338952}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "73608df6-a2a9-5efe-b3f4-d968a8f235fb" :question/math-academy-id "q-115274" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/402ae2f9f3d1e0ce970a18b68332400d261962e40ebde9acdc179727e94f32ac.png)\n\nGiven the graph above, solve the inequality  $(x+1)(x-4)>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(x+1)(x-4)>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=(x+1)(x-4)\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/98537a1ab5afd590c47a2605d6d0bc8858f51e838033cc61a38845b3e8c87a53.png)\n\nSo, the solution to the inequality is $x<-1$ or $x>4.$"}] [{:db/id #edb/ref 17592186307348 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a60886ab-a9e4-5c51-8ce4-015666d95c02" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png" :db/id #edb/ref 17592186307350} {:answer/id #uuid "dd857f6a-0056-526a-8bd7-e08cb1377977" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/8f43f19bbe4213ba2f9d5bc51f52b747e1c7840a27607207f0ca56021c1914d5.png" :db/id #edb/ref 17592186307351} {:answer/id #uuid "bdd696d9-06d4-5a69-bb5e-d38cd9f6d604" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/0f0589a467b3d35947a6f501ff00d5296e05ae7e375800659986038db55c7577.png" :db/id #edb/ref 17592186307352} {:answer/id #uuid "7a38e9d6-28b6-54a1-8f99-6a0757341358" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/378a24a8553ac7092b85f715394bf632b5e87aaf45c58ce3ff7ae66310b28f65.png" :db/id #edb/ref 17592186307353} {:answer/id #uuid "7a8d6760-24d7-594e-af6e-1901cfb5b927" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/95fbb1a2298ebc809303d6c57a8440483cdd65748b090ea0b45d25ebad93bb80.png" :db/id #edb/ref 17592186307354}] :answer-field/correct {:answer/id #uuid "a60886ab-a9e4-5c51-8ce4-015666d95c02" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png" :db/id #edb/ref 17592186307350} :answer-field/id #uuid "d3aee704-3c44-51a1-b1a0-55744186f527" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307349}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "babac56b-1bc2-59da-833f-f3070de287aa" :question/math-academy-id "q-147603" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/0cec723bf4e6886ca0715e9e02c658a7ee0e1f24555ea3946f95aa2b12b863be.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 & 2 \\\\ 2 & 2 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,2)$, $(-2,2),$ $(2,-2).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png)"}] [{:db/id #edb/ref 17592186338958 :knowledge-point/_questions [{:knowledge-point/id #uuid "045722b6-b558-522b-86e1-322c64e2848f" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41956e2e-8d3a-56ed-b519-8d3967b79417" :answer/type {:db/ident :answer.type/math} :answer/value "12\\sqrt{3}" :db/id #edb/ref 17592186338960}] :answer-field/correct {:answer/id #uuid "41956e2e-8d3a-56ed-b519-8d3967b79417" :answer/type {:db/ident :answer.type/math} :answer/value "12\\sqrt{3}" :db/id #edb/ref 17592186338960} :answer-field/id #uuid "dfe93357-b04f-50e0-bc40-5cc2c2c4bcb4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338959}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "56ee2d50-7525-539b-8670-a399c4adf79c" :question/math-academy-id "q-302331" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=3$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}} & =\\frac{{3}^{2}-9}{\\sqrt{3}-\\sqrt{3}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}} & ={lim}_{x\\to 3}\\frac{({x}^{2}-9)(\\sqrt{x}+\\sqrt{3})}{(\\sqrt{x}-\\sqrt{3})(\\sqrt{x}+\\sqrt{3})} \\\\  & ={lim}_{x\\to 3}\\frac{(x-3)(x+3)(\\sqrt{x}+\\sqrt{3})}{(\\sqrt{x})^{2}-(\\sqrt{3})^{2}} \\\\  & ={lim}_{x\\to 3}\\frac{(x-3)(x+3)(\\sqrt{x}+\\sqrt{3})}{x-3} \\\\  & ={lim}_{x\\to 3}\\frac{\\cancel{(x-3)}(x+3)(\\sqrt{x}+\\sqrt{3})}{\\cancel{x-3}} \\\\  & ={lim}_{x\\to 3}(x+3)(\\sqrt{x}+\\sqrt{3}) \\\\  & =(3+3)(\\sqrt{3}+\\sqrt{3}) \\\\  & =6(2\\sqrt{3}) \\\\  & =12\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338961 :knowledge-point/_questions [{:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8840ae0-7cbf-521d-b355-e1b29f10030a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{x-2}" :db/id #edb/ref 17592186338963} {:answer/id #uuid "03109a29-2a80-586b-b64f-c5695518e8a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{x+2}" :db/id #edb/ref 17592186338964}] :answer-field/correct {:answer/id #uuid "c8840ae0-7cbf-521d-b355-e1b29f10030a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{x-2}" :db/id #edb/ref 17592186338963} :answer-field/id #uuid "745fea25-6d62-5921-9c24-a67f3114aeab" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338962} {:answer-field/choices [{:answer/id #uuid "25a7fd8d-e163-50ff-851f-0ac51b5dbaee" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186338966}] :answer-field/correct {:answer/id #uuid "25a7fd8d-e163-50ff-851f-0ac51b5dbaee" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186338966} :answer-field/id #uuid "c98a97b5-6183-5310-9855-2bb3c4c205aa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338965}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "032b7386-bebf-584d-aa51-c55bac49aec8" :question/math-academy-id "q-321410" :question/problem "Consider the curve defined parametrically as\n\n$$\nx=-3t+2,\\,\\,\\,y=-\\frac{1}{t},\\,t\\ne 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=-3t+2\\,⇒\\,t=\\frac{2-x}{3}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{2-x}{3}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{(\\frac{2-x}{3})} \\\\ y & =\\frac{3}{x-2}\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{3}{x-2}.$\n\nFinally, since $t\\ne 0$ and $x=-3t+2$ , we must have $x\\ne 2.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{3}{x-2},\\,x\\ne 2.\n$$"}] [{:db/id #edb/ref 17592186338967 :knowledge-point/_questions [{:knowledge-point/id #uuid "b492068c-2bd2-5611-baab-780959d24c3d" :knowledge-point/title "Calculating the Derivative of an Inverse Function Using a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d80e3c-2f4b-54fa-bc59-8271c54ea8b8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186338969}] :answer-field/correct {:answer/id #uuid "08d80e3c-2f4b-54fa-bc59-8271c54ea8b8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186338969} :answer-field/id #uuid "b80233ac-f41c-57d6-b390-29647f4da7e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186338968}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "97e97885-5364-548d-a866-b48f29ce6c12" :question/math-academy-id "q-342591" :question/problem "Find $({f}^{-1})^{′}(-2)$ given the following table of values of functions $f(x)$ and ${f}^{′}(x)$ at some points.\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ |\n| --- | --- | --- |\n| $5$ | $-2$ | $-3$ |\n| $0$ | $1$ | $7$ |\n\n$({f}^{-1})^{′}(-2)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=-2,$ we have\n\n$$\n({f}^{-1})^{′}(-2)=\\frac{1}{{f}^{′}({f}^{-1}(-2))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(-2)=5$ and ${f}^{′}(5)=-3.$ Therefore,\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(-2) & =\\frac{1}{{f}^{′}({f}^{-1}(-2))} \\\\  & =\\frac{1}{{f}^{′}(5)} \\\\  & =\\frac{1}{(-3)} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338970 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0033bc47-e537-5394-8f40-841d466de5d7" :answer/type {:db/ident :answer.type/text} :answer/value "$x=3$ and $x=5$" :db/id #edb/ref 17592186338972} {:answer/id #uuid "2ecbea32-ea9d-5a56-b13f-bde8e585ba41" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$" :db/id #edb/ref 17592186338973} {:answer/id #uuid "1e18b132-a788-5718-a65a-02fd187ee966" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$ and $x=4$" :db/id #edb/ref 17592186338974} {:answer/id #uuid "84767ecd-933a-5540-b2f5-a5e0d11c176f" :answer/type {:db/ident :answer.type/text} :answer/value "$x=4$ only" :db/id #edb/ref 17592186338975} {:answer/id #uuid "71fcf031-cf94-59f8-874a-5a745b2953aa" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=4$" :db/id #edb/ref 17592186338976}] :answer-field/correct {:answer/id #uuid "71fcf031-cf94-59f8-874a-5a745b2953aa" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=4$" :db/id #edb/ref 17592186338976} :answer-field/id #uuid "594f89de-b0ea-5b81-84f5-a93099ab18f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338971}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cfc1f38a-b4e3-5848-bc27-d254a3cdbd67" :question/math-academy-id "q-47911" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/bb8959927fc561f9fc6e021b690c43f4ab57b169aa1526390e02c8d48386bfe3.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively. \n\nIn the given graph, we can see that \n\n- at $x=2$ the tangent to the graph is horizontal, so we have ${f}^{′}(0)=0,$ while\n\n- at $x=4$ there is a sharp corner, so ${f}^{′}(4)$ doesn't exist\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/60f26a8aa758ae20b2b56325d822379d407276ffd6987f56a1e7934a6406c4d2.png)\n\n \n\nTherefore, there are two critical points, and their $x$-coordinates are $x=2$ and $x=4.$"}] [{:db/id #edb/ref 17592186338977 :knowledge-point/_questions [{:knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220df84e-67c2-58aa-b797-090807b18afb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186338979} {:answer/id #uuid "b5542d14-dcdf-564d-897b-10378ad37a1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{32}" :db/id #edb/ref 17592186338980} {:answer/id #uuid "8b229a58-2050-51cc-bf07-afba7ceef4d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186338981} {:answer/id #uuid "9dbc1e75-7e1e-5bda-94ac-210323be8178" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{16}" :db/id #edb/ref 17592186338982} {:answer/id #uuid "6d66c22e-26c8-556e-9aaa-2f626618e473" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{32}" :db/id #edb/ref 17592186338983}] :answer-field/correct {:answer/id #uuid "b5542d14-dcdf-564d-897b-10378ad37a1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{32}" :db/id #edb/ref 17592186338980} :answer-field/id #uuid "7b772302-6f9f-5cb9-b920-a2693f43f64f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338978}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "49bb0d44-38eb-57b0-b09a-35f77b00b9ca" :question/math-academy-id "q-49221" :question/problem "Evaluate ${\\int }_{-4}^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={\\int }_{-4}^{-1}{x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}{|}_{-4}^{-1} \\\\  & =\\frac{{x}^{-2}}{(-2)}{|}_{-4}^{-1} \\\\  & =-\\frac{1}{2{x}^{2}}{|}_{-4}^{-1} \\\\  & =-\\frac{1}{2}(\\frac{1}{(-1)^{2}}-\\frac{1}{(-4)^{2}}) \\\\  & =-\\frac{1}{2}(1-\\frac{1}{16}) \\\\  & =-\\frac{15}{32}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186308833 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "713fc33d-83da-590f-9f68-03deb34d7745" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{12}" :db/id #edb/ref 17592186308835} {:answer/id #uuid "896cd95c-a469-50db-a939-47330ea46144" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{12}" :db/id #edb/ref 17592186308836} {:answer/id #uuid "44143780-c8cd-55cd-9fe2-f289fdbbbfa5" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{6}" :db/id #edb/ref 17592186308837} {:answer/id #uuid "c69d2fdb-8d95-5e19-9150-433c74826146" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{12}" :db/id #edb/ref 17592186308838} {:answer/id #uuid "5a10463e-18ff-55ca-a408-e678a6c87bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{12}" :db/id #edb/ref 17592186308839}] :answer-field/correct {:answer/id #uuid "5a10463e-18ff-55ca-a408-e678a6c87bc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{12}" :db/id #edb/ref 17592186308839} :answer-field/id #uuid "c8deeb3c-b80e-5f4d-baab-4e4a74ff10dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308834}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "49164e78-91b8-549a-8993-e1fab20375b4" :question/math-academy-id "q-87125" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c010f583fc33ee3c5335c16c0aaf1c20c2e5cf82d49fe7cf14e8e5661bf202fc.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{7\\pi }{12}=\\frac{5\\pi }{12}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{5\\pi }{12}.$"}]}
