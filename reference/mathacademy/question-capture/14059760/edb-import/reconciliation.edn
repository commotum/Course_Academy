gned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 & 2 \\\\ 2 & 2 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,2)$, $(-2,2),$ $(2,-2).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-147603" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-147603" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-147603" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/0f0589a467b3d35947a6f501ff00d5296e05ae7e375800659986038db55c7577.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/378a24a8553ac7092b85f715394bf632b5e87aaf45c58ce3ff7ae66310b28f65.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/8f43f19bbe4213ba2f9d5bc51f52b747e1c7840a27607207f0ca56021c1914d5.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/95fbb1a2298ebc809303d6c57a8440483cdd65748b090ea0b45d25ebad93bb80.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-147603" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" nil "attribute" "question/problem" "value" "Consider the curve defined parametrically as\n\n$$\nx=-3t+2,\\,\\,\\,y=-\\frac{1}{t},\\,t\\ne 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" nil "attribute" "question/worked-solution" "value" "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=-3t+2\\,⇒\\,t=\\frac{2-x}{3}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{2-x}{3}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{(\\frac{2-x}{3})} \\\\ y & =\\frac{3}{x-2}\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{3}{x-2}.$\n\nFinally, since $t\\ne 0$ and $x=-3t+2$ , we must have $x\\ne 2.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{3}{x-2},\\,x\\ne 2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-321410" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{x-2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-321410" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-113607" "field" nil "attribute" "question/problem" "value" "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{3})=(\\genfrac{}{}{0pt}{}{5}{2})+[]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-113607" "field" nil "attribute" "question/worked-solution" "value" "To find $(\\genfrac{}{}{0pt}{}{6}{3}),$ we need to find the number that is located in row $6$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{6}{3})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & (\\genfrac{}{}{0pt}{}{6}{0}) &  & (\\genfrac{}{}{0pt}{}{6}{1}) &  & (\\genfrac{}{}{0pt}{}{6}{2}) &  & (\\genfrac{}{}{0pt}{}{6}{3}) &  & (\\genfrac{}{}{0pt}{}{6}{4}) &  & (\\genfrac{}{}{0pt}{}{6}{5}) &  & (\\genfrac{}{}{0pt}{}{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{6}{3})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{3})=(\\genfrac{}{}{0pt}{}{5}{2})+(\\genfrac{}{}{0pt}{}{5}{3})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{5}{3}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-113607" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-113607" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-113607" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(\\genfrac{}{}{0pt}{}{4}{1})"] ["math" "(\\genfrac{}{}{0pt}{}{4}{2})"] ["math" "(\\genfrac{}{}{0pt}{}{5}{1})"] ["math" "(\\genfrac{}{}{0pt}{}{5}{3})"] ["math" "(\\genfrac{}{}{0pt}{}{6}{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-113607" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\genfrac{}{}{0pt}{}{5}{3})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-49221" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{-4}^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-49221" "field" nil "attribute" "question/worked-solution" "value" "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={\\int }_{-4}^{-1}{x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}{|}_{-4}^{-1} \\\\  & =\\frac{{x}^{-2}}{(-2)}{|}_{-4}^{-1} \\\\  & =-\\frac{1}{2{x}^{2}}{|}_{-4}^{-1} \\\\  & =-\\frac{1}{2}(\\frac{1}{(-1)^{2}}-\\frac{1}{(-4)^{2}}) \\\\  & =-\\frac{1}{2}(1-\\frac{1}{16}) \\\\  & =-\\frac{15}{32}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-49221" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-49221" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-49221" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{15}{32}"] ["math" "-\\frac{1}{2}"] ["math" "-\\frac{7}{16}"] ["math" "\\frac{15}{32}"] ["math" "\\frac{1}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-49221" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{15}{32}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-342591" "field" nil "attribute" "question/problem" "value" "Find $({f}^{-1})^{′}(-2)$ given the following table of values of functions $f(x)$ and ${f}^{′}(x)$ at some points.\n\n| **$x$** | $f(x)$ | ${f}^{′}(x)$ |\n| --- | --- | --- |\n| $5$ | $-2$ | $-3$ |\n| $0$ | $1$ | $7$ |\n\n$({f}^{-1})^{′}(-2)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-342591" "field" nil "attribute" "question/worked-solution" "value" "The formula for the derivative of the inverse is\n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nSubstituting $x=-2,$ we have\n\n$$\n({f}^{-1})^{′}(-2)=\\frac{1}{{f}^{′}({f}^{-1}(-2))}.\n$$\n\nFrom the table, we obtain ${f}^{-1}(-2)=5$ and ${f}^{′}(5)=-3.$ Therefore,\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(-2) & =\\frac{1}{{f}^{′}({f}^{-1}(-2))} \\\\  & =\\frac{1}{{f}^{′}(5)} \\\\  & =\\frac{1}{(-3)} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-342591" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-342591" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-342591" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-87125" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/c010f583fc33ee3c5335c16c0aaf1c20c2e5cf82d49fe7cf14e8e5661bf202fc.png)\n\nWhat is the polar equation of the ray shown above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-87125" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{7\\pi }{12}=\\frac{5\\pi }{12}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{5\\pi }{12}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-87125" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-87125" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-87125" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\theta =\\frac{19\\pi }{12}"] ["math" "\\theta =\\frac{5\\pi }{12}"] ["math" "\\theta =\\frac{5\\pi }{6}"] ["math" "\\theta =\\frac{7\\pi }{12}"] ["math" "\\theta =\\frac{\\pi }{12}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-87125" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\theta =\\frac{5\\pi }{12}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-302331" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-302331" "field" nil "attribute" "question/worked-solution" "value" "If we attempt to evaluate the limit by simply evaluating the function at $x=3$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}} & =\\frac{{3}^{2}-9}{\\sqrt{3}-\\sqrt{3}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 3}\\frac{{x}^{2}-9}{\\sqrt{x}-\\sqrt{3}} & ={lim}_{x\\to 3}\\frac{({x}^{2}-9)(\\sqrt{x}+\\sqrt{3})}{(\\sqrt{x}-\\sqrt{3})(\\sqrt{x}+\\sqrt{3})} \\\\  & ={lim}_{x\\to 3}\\frac{(x-3)(x+3)(\\sqrt{x}+\\sqrt{3})}{(\\sqrt{x})^{2}-(\\sqrt{3})^{2}} \\\\  & ={lim}_{x\\to 3}\\frac{(x-3)(x+3)(\\sqrt{x}+\\sqrt{3})}{x-3} \\\\  & ={lim}_{x\\to 3}\\frac{\\cancel{(x-3)}(x+3)(\\sqrt{x}+\\sqrt{3})}{\\cancel{x-3}} \\\\  & ={lim}_{x\\to 3}(x+3)(\\sqrt{x}+\\sqrt{3}) \\\\  & =(3+3)(\\sqrt{3}+\\sqrt{3}) \\\\  & =6(2\\sqrt{3}) \\\\  & =12\\sqrt{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-302331" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-302331" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-302331" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "12\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-47911" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/bb8959927fc561f9fc6e021b690c43f4ab57b169aa1526390e02c8d48386bfe3.png)\n\nThe graph of $y=f(x)$ is plotted above. What are the $x$-coordinates of the critical points?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-47911" "field" nil "attribute" "question/worked-solution" "value" "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively. \n\nIn the given graph, we can see that \n\n- at $x=2$ the tangent to the graph is horizontal, so we have ${f}^{′}(0)=0,$ while\n\n- at $x=4$ there is a sharp corner, so ${f}^{′}(4)$ doesn't exist\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/60f26a8aa758ae20b2b56325d822379d407276ffd6987f56a1e7934a6406c4d2.png)\n\n \n\nTherefore, there are two critical points, and their $x$-coordinates are $x=2$ and $x=4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-47911" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-47911" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-47911" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$x=1$ and $x=4$"] ["text" "$x=2$ and $x=4$"] ["text" "$x=2$ and $x=6$"] ["text" "$x=3$ and $x=5$"] ["text" "$x=4$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-47911" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$x=2$ and $x=4$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-115274" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/402ae2f9f3d1e0ce970a18b68332400d261962e40ebde9acdc179727e94f32ac.png)\n\nGiven the graph above, solve the inequality  $(x+1)(x-4)>0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-115274" "field" nil "attribute" "question/worked-solution" "value" "Notice that our inequality\n\n$$\n(x+1)(x-4)>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=(x+1)(x-4)\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/assets/98537a1ab5afd590c47a2605d6d0bc8858f51e838033cc61a38845b3e8c87a53.png)\n\nSo, the solution to the inequality is $x<-1$ or $x>4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-115274" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/activity-metadata.json" "file_sha256" "4139fb77948a4594646624b951664843e728bee2cdcb1958222bcd88b1bde15b"} {"question" "q-115274" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-115274" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1<x<4"] ["math" "-4<x<-1"] ["math" "x>0"] ["text" "$x<-1$ or $x>4$"] ["text" "$x<-4$ or $x>1$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"} {"question" "q-115274" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$x<-1$ or $x>4$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059760/state.json" "file_sha256" "41b600519408ff8d570aa73b2a1e31948d240d893a8f882a13520740732c5da6"}] "usage" {"q-147603" [] "q-87125" []} "basis" 1920 "retractions" [[17592186307348 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/0cec723bf4e6886ca0715e9e02c658a7ee0e1f24555ea3946f95aa2b12b863be.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$"] [17592186307348 :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -2 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}0 & 1 & 1 \\\\ 1 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 & 2 \\\\ 2 & 2 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,2)$, $(-2,2),$ $(2,-2).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040372/assets/c688b1ee540e732329e597fb97a0595f619dbc4ff0aad86b6a01f1bdb51ae66b.png)"] [17592186308833 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/c010f583fc33ee3c5335c16c0aaf1c20c2e5cf82d49fe7cf14e8e5661bf202fc.png)\n\nWhat is the polar equation of the ray shown above?"]] "immutable_answers" [17592186307350 17592186307351 17592186307352 17592186307353 17592186307354 17592186308835 17592186308836 17592186308837 17592186308838 17592186308839] "immutable_fields" [[17592186307349 :answer-field/correct] [175