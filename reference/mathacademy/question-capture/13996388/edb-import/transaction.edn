28{k}^{2}}{3}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-135995/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-135995"] :db/ensure [:knowledge-point/validate]} {:db/id "q-234003/field-1/022d69fdee17a24b8b27020b0b266a400456c18502c7fd462660b53b6baa811c" :answer/id #uuid "27573e0e-6e53-5726-8891-06c584c392c8" :answer/type :answer.type/math :answer/value "1-3a+\\frac{27}{8}a^2" :db/ensure [:answer/validate]} {:db/id "q-234003/field-1" :answer-field/id #uuid "6f417d0e-3186-518e-9649-10b0c534e16f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-234003/field-1/022d69fdee17a24b8b27020b0b266a400456c18502c7fd462660b53b6baa811c" :answer-field/choices ["q-234003/field-1/022d69fdee17a24b8b27020b0b266a400456c18502c7fd462660b53b6baa811c"] :db/ensure [:answer-field/validate]} {:db/id "q-234003" :question/id #uuid "8d73145d-3a16-52e0-9f35-097cb5edf926" :question/math-academy-id "q-234003" :question/problem "Find, in ascending powers of $a,$ the **first three terms** of the binomial expansion of ${(1-\\frac{3a}{4})}^{4}.$\n\n${(1-\\frac{3a}{4})}^{4}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{3a}{4}$ and $n=4$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{3a}{4})}^{4} & =1+4\\cdot (-\\frac{3a}{4})+\\frac{4(4-1)}{2!}\\cdot {(-\\frac{3a}{4})}^{2}+⋯ \\\\  & =1-3a+\\frac{4\\cdot 3}{2}\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+6\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+\\frac{27}{8}{a}^{2}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-234003/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-234003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251116/field-1/147a8cdce9af924e9ca96d4abd5c07e823d0f186887213d60f16b769bbd8eabc" :answer/id #uuid "7150c715-1d64-57ee-bf37-88421a635897" :answer/type :answer.type/math :answer/value "\\frac{5}{256}" :db/ensure [:answer/validate]} {:db/id "q-251116/field-1" :answer-field/id #uuid "e29eef8d-c7bb-5a37-8683-2efa7498c259" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251116/field-1/147a8cdce9af924e9ca96d4abd5c07e823d0f186887213d60f16b769bbd8eabc" :answer-field/choices ["q-251116/field-1/147a8cdce9af924e9ca96d4abd5c07e823d0f186887213d60f16b769bbd8eabc"] :db/ensure [:answer-field/validate]} {:db/id "q-251116" :question/id #uuid "872f723a-424a-5c2d-83c9-f643fea0331d" :question/math-academy-id "q-251116" :question/problem "The coefficient of ${k}^{4}$ in the expansion of ${(1-\\frac{k}{4})}^{5}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{k}{4}$ and $n$ with $5$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{5(5-1)(5-2)(5-3)}{4!}\\cdot {(-\\frac{k}{4})}^{4} & =\\frac{5\\cdot 4\\cdot 3\\cdot 2}{24}\\cdot {(-\\frac{1}{4})}^{4}\\cdot {k}^{4} \\\\  & =5\\cdot \\frac{1}{256}{k}^{4} \\\\  & =\\frac{5}{256}{k}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${k}^{4}$ is $\\frac{5}{256}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-251116/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca"] :knowledge-point/questions ["q-251116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251111/field-1/218c3df4b065a0d4fec07e716faba5b74ea016e45460492273ea01f4a8a6de9c" :answer/id #uuid "500bc08f-f97c-5454-9de2-d05be1548c3c" :answer/type :answer.type/math :answer/value "-1140" :db/ensure [:answer/validate]} {:db/id "q-251111/field-1/baa9cd4320ef216ab16f80f7341e4eaacd396bfae147d6dcea379076da2ec885" :answer/id #uuid "76b3fea5-176a-59da-949f-f64eab9dfde7" :answer/type :answer.type/math :answer/value "1140" :db/ensure [:answer/validate]} {:db/id "q-251111/field-1" :answer-field/id #uuid "fc442b06-5a16-5132-ad96-213798075055" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251111/field-1/218c3df4b065a0d4fec07e716faba5b74ea016e45460492273ea01f4a8a6de9c" :answer-field/choices ["q-251111/field-1/218c3df4b065a0d4fec07e716faba5b74ea016e45460492273ea01f4a8a6de9c" "q-251111/field-1/baa9cd4320ef216ab16f80f7341e4eaacd396bfae147d6dcea379076da2ec885"] :db/ensure [:answer-field/validate]} {:db/id "q-251111" :question/id #uuid "86249e5b-0dd0-572e-a64d-e7f34382a1aa" :question/math-academy-id "q-251111" :question/problem "The coefficient of ${u}^{3}$ in the expansion of ${(1-u)}^{20}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-u$ and $n$ with $20$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{20(20-1)(20-2)}{3!}\\cdot (-u)^{3} & =\\frac{20\\cdot 19\\cdot 18}{6}\\cdot (-u)^{3} \\\\  & =1140\\cdot (-{u}^{3}) \\\\  & =-1140{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${u}^{3}$ is $-1140.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-251111/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca"] :knowledge-point/questions ["q-251111"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136020/selection/996b3bf2ac1d086ab99a2993d4e2963c350df2485a96b21f25839638028cd262" :answe