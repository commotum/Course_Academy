ac{4{b}^{2}}{49}+⋯ \\\\  & =1+\\frac{18}{7}b+\\frac{144}{49}{b}^{2}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-250994/field-1" "q-250994/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7"] :knowledge-point/questions ["q-250994"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12965/selection/ad486f2c2090dcdefb14d1dda1190770f6aca288e595fb8e8a2ba086b20b2c84" :answer/id #uuid "9501ff05-67da-59b9-adf6-0ace129d5b44" :answer/type :answer.type/math :answer/value "1+9a+9{a}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-12965/selection/72f47e0037ba8169f3cc7330543d3437b7ef4371776d3a4ae6f7d82b2c68d0f7" :answer/id #uuid "092b24c3-50db-506c-8289-5aa79c66716c" :answer/type :answer.type/math :answer/value "1+9a+36{a}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-12965/selection/7578089d7f2fc2fe9e42fe25a66a9cc65bd623a46d8b1974ec81790120a30bd2" :answer/id #uuid "9c4cc4f0-133a-5dbb-92e9-9e6aa099913e" :answer/type :answer.type/math :answer/value "1+9a+24{a}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-12965/selection/d8c3fae6c969115d13e4e6d3a39f33bf74981fc0d2c3b2332eeff8f08b08065b" :answer/id #uuid "8764833e-2903-56ab-b8fc-dffe118d8352" :answer/type :answer.type/math :answer/value "1+9a+18{a}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-12965/selection/d43f13bbb104615a19f48a4b54fd9085de7277f14931238a8af7d5918a879b12" :answer/id #uuid "c5b0d67a-267f-5b21-b7e1-e8ff80b9fa0d" :answer/type :answer.type/math :answer/value "1+9a+12{a}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-12965/selection" :answer-field/id #uuid "1c962b49-161c-53ac-8476-35c52562315d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12965/selection/72f47e0037ba8169f3cc7330543d3437b7ef4371776d3a4ae6f7d82b2c68d0f7" :answer-field/choices ["q-12965/selection/ad486f2c2090dcdefb14d1dda1190770f6aca288e595fb8e8a2ba086b20b2c84" "q-12965/selection/72f47e0037ba8169f3cc7330543d3437b7ef4371776d3a4ae6f7d82b2c68d0f7" "q-12965/selection/7578089d7f2fc2fe9e42fe25a66a9cc65bd623a46d8b1974ec81790120a30bd2" "q-12965/selection/d8c3fae6c969115d13e4e6d3a39f33bf74981fc0d2c3b2332eeff8f08b08065b" "q-12965/selection/d43f13bbb104615a19f48a4b54fd9085de7277f14931238a8af7d5918a879b12"] :db/ensure [:answer-field/validate]} {:db/id "q-12965" :question/id #uuid "3257c944-23d0-5959-8383-cf9908cd0467" :question/math-academy-id "q-12965" :question/problem "$(1+a)^{9}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=a$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+a)}^{9} & =1+9\\cdot a+\\frac{9(9-1)}{2!}\\cdot {a}^{2}+⋯ \\\\  & =1+9a+\\frac{9\\cdot 8}{2}\\cdot {a}^{2}+⋯ \\\\  & =1+9a+36{a}^{2}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12965/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7"] :knowledge-point/questions ["q-12965"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135988/selection/6f569d52d3c1ea3ebbf16160c04909d3a93f85ea4ab94723cddb2c4dc2e2ea5e" :answer/id #uuid "de1b122d-df47-51a7-b56a-36eba0fd853f" :answer/type :answer.type/math :answer/value "1-40z+600{z}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135988/selection/7fe25a5a6e3af882f8aaccc8ca8fd8cb047cdff6aeda536d6fbd511691c52a24" :answer/id #uuid "cc159c25-3659-5ac2-bdcd-243e84591220" :answer/type :answer.type/math :answer/value "1-40z+760{z}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135988/selection/d2af5a82dc324454f86c21ab97fdc8394c616b9552f0b2aca76cd308ec80dc55" :answer/id #uuid "7e6ac714-c8cf-50d3-9179-c7a18010c894" :answer/type :answer.type/math :answer/value "1+40z+800{z}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135988/selection/8cdd1d1e8808031d1f96366da10