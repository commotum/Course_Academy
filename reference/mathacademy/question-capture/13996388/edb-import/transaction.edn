wer-field/id #uuid "05dca83a-543f-5508-8b5e-1ab7e878becb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251019/field-1/2610e5b96ba5fae223473822d25f14901e6f20801a2045de8e11cbfa496cd426" :answer-field/choices ["q-251019/field-1/2610e5b96ba5fae223473822d25f14901e6f20801a2045de8e11cbfa496cd426"] :db/ensure [:answer-field/validate]} {:db/id "q-251019" :question/id #uuid "86dd54e3-3afe-59d7-a94f-bb8b2bdfa6d3" :question/math-academy-id "q-251019" :question/problem "Find, in ascending powers of $b,$ the **first three terms** in the binomial expansion of ${(1-5b)}^{10}.$\n\n$(1-5b)^{10}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-5b$ and $n=10$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-5b)}^{10} & =1+10\\cdot (-5b)+\\frac{10(10-1)}{2!}\\cdot (-5b)^{2}+⋯ \\\\  & =1-50b+\\frac{10\\cdot 9}{2}\\cdot 25{b}^{2}+⋯ \\\\  & =1-50b+45\\cdot 25{b}^{2}+⋯ \\\\  & =1-50b+1\\,125{b}^{2}+⋯\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-251019/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-251019"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251018/field-1/f43c26bc161fb759fc14d8c36edd4a66b306732d811659ecea3999dd970395c3" :answer/id #uuid "082af789-8926-53fc-a19a-480e42736eea" :answer/type :answer.type/math :answer/value "1-18a+144a^2" :db/ensure [:answer/validate]} {:db/id "q-251018/field-1/9c52becbd7b283a811cfb0e0a45a714ce9942a0b4742ad67893cffde8dd139bf" :answer/id #uuid "ba3c90f1-5498-5dd7-b8d6-87a5fa86d24f" :answer/type :answer.type/math :answer/value "1-18a-144a^2" :db/ensure [:answer/validate]} {:db/id "q-251018/field-1" :answer-field/id #uuid "71cceb8f-0502-5c0c-87d5-420a0ed197ce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251018/field-1/f43c26bc161fb759fc14d8c36edd4a66b306732d811659ecea3999dd970395c3" :answer-field/choices ["q-251018/field-1/f43c26bc161fb759fc14d8c36edd4a66b306732d811659ecea3999dd970395c3" "q-251018/field-1/9c52becbd7b283a811cfb0e0a45a714ce9942a0b4742ad67893cffde8dd139bf"] :db/ensure [:answer-field/validate]} {:db/id "q-251018" :question/id #uuid "0671f502-afb8-598b-b89e-9fffc6bc907a" :question/math-academy-id "q-251018" :question/problem "Find, in ascending powers of $a,$ the **first three terms** in the binomial expansion of ${(1-2a)}^{9}.$\n\n$(1-2a)^{9}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-2a$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-2a)}^{9} & =1+9\\cdot (-2a)+\\frac{9(9-1)}{2!}\\cdot (-2a)^{2}+⋯ \\\\  & =1-18a+\\frac{9\\cdot 8}{2}\\cdot 4{a}^{2}+⋯ \\\\  & =1-18a+36\\cdot 4{a}^{2}+⋯ \\\\  & =1-18a+144{a}^{2}+⋯\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-251018/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-251018"] :db/ensure [:knowledge-point/validate]} {:db/id "q-251048/field-1/92387711c0c0692edd27a17ec95e689e4e352e60a7cb7066f29b06fae7dbd298" :answer/id #uuid "cfe59a89-564a-5bf2-822b-3d1c12f1fb73" :answer/type :answer.type/math :answer/value "1-\\frac{8}{5}k+\\frac{28}{25}k^2" :db/ensure [:answer/validate]} {:db/id "q-251048/field-1" :answer-field/id #uuid "e13443e3-52ea-5156-9537-37a38f70de46" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-251048/field-1/92387711c0c0692edd27a17ec95e689e4e352e60a7cb7066f29b06fae7dbd298" :answer-field/choices ["q-251048/field-1/92387711c0c0692edd27a17ec95e689e4e352e60a7cb7066f29b06fae7dbd298"] :db/ensure [:answer-field/validate]} {:db/id "q-251048" :question/id #uuid "f53ae958-dc5d-53e1-8da2-f5eeb62b47a0" :question/math-academy-id "q-251048" :question/problem "Find, in ascending powers of $k,$ the **first three terms** of the binomial expansion of ${(1-\\frac{k}{5})}^{8}.$\n\n${(1-\\frac{k}{5})}^{8}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{k}{5}$ and $n=8$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{k}{5})}^{8} & =1+8\\cdot (-\\frac{k}{5})+\\frac{8(8-1)}{2!}\\cdot {(-\\frac{k}{5})}^{2}+⋯ \\\\  & =1-\\frac{8k}{5}+\\frac{8\\cdot 7}{2}\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8k}{5}+28\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-251048/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359"] :knowledge-point/questions ["q-251048"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135995/selection/00a0c3287c2eef12562622ad6baa4460043e7f5fcb9e21fd6a4ba609c37060f1" :answer/id #uuid "95d26995-f28d-519c-97ae-544eb8c8481f" :answer/type :answer.type/math :answer/value "1-\\frac{14k}{3}+30{k}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135995/selection/7229e1915b20bed7fb518f95ae3b5bd0be952dde435df92d703ad5c1a5a1087c" :answer/id #uuid "a81472ef-52df-5e96-8ea4-f70230562c48" :answer/type :answer.type/math :answer/value "1-\\frac{14k}{3}+\\frac{25{k}^{2}}{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-135995/selection/c9cf2eecc5c2997694ad5f545adc43d4c4292755a81508dc9b9288a6b0397ba9" :answer/id #uuid "a62ccc3f-6724-5ae1-820d-6a755a472bf6" :answer/type :answer.type/math :answer/value "1-\\frac{14k}{3}+9{k}^{2}+⋯" :db/ensure [:answer/validat