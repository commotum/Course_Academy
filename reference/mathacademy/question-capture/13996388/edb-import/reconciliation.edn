\cdot 7}{2}\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8k}{5}+28\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}+⋯.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251048" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/activity-metadata.json" "file_sha256" "15b5d744c87949518883e82d013a9ee012335dbd2cd03ee547125b1a9a71443f"} {"question" "q-251048" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251048" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1-\\frac{8}{5}k+\\frac{28}{25}k^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-135995" "field" nil "attribute" "question/problem" "value" "${(1-\\frac{2k}{3})}^{7}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-135995" "field" nil "attribute" "question/worked-solution" "value" "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{2k}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{2k}{3})}^{7} & =1+7\\cdot (-\\frac{2k}{3})+\\frac{7(7-1)}{2!}\\cdot {(-\\frac{2k}{3})}^{2}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{7\\cdot 6}{2}\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+21\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-135995" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/activity-metadata.json" "file_sha256" "15b5d744c87949518883e82d013a9ee012335dbd2cd03ee547125b1a9a71443f"} {"question" "q-135995" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-135995" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1-\\frac{14k}{3}+30{k}^{2}+⋯"] ["math" "1-\\frac{14k}{3}+9{k}^{2}+⋯"] ["math" "1-\\frac{14k}{3}+\\frac{25{k}^{2}}{3}+⋯"] ["math" "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯"] ["math" "1-\\frac{14k}{3}+\\frac{29{k}^{2}}{3}+⋯"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-135995" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-234003" "field" nil "attribute" "question/problem" "value" "Find, in ascending powers of $a,$ the **first three terms** of the binomial expansion of ${(1-\\frac{3a}{4})}^{4}.$\n\n${(1-\\frac{3a}{4})}^{4}=$\n{{field-1}}$\\,+\\,⋯$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-234003" "field" nil "attribute" "question/worked-solution" "value" "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{3a}{4}$ and $n=4$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{3a}{4})}^{4} & =1+4\\cdot (-\\frac{3a}{4})+\\frac{4(4-1)}{2!}\\cdot {(-\\frac{3a}{4})}^{2}+⋯ \\\\  & =1-3a+\\frac{4\\cdot 3}{2}\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+6\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+\\frac{27}{8}{a}^{2}+⋯.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-234003" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/activity-metadata.json" "file_sha256" "15b5d744c87949518883e82d013a9ee012335dbd2cd03ee547125b1a9a71443f"} {"question" "q-234003" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-234003" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1-3a+\\frac{27}{8}a^2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251116" "field" nil "attribute" "question/problem" "value" "The coefficient of ${k}^{4}$ in the expansion of ${(1-\\frac{k}{4})}^{5}$ is{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251116" "field" nil "attribute" "question/worked-solution" "value" "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{k}{4}$ and $n$ with $5$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{5(5-1)(5-2)(5-3)}{4!}\\cdot {(-\\frac{k}{4})}^{4} & =\\frac{5\\cdot 4\\cdot 3\\cdot 2}{24}\\cdot {(-\\frac{1}{4})}^{4}\\cdot {k}^{4} \\\\  & =5\\cdot \\frac{1}{256}{k}^{4} \\\\  & =\\frac{5}{256}{k}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${k}^{4}$ is $\\frac{5}{256}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251116" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/activity-metadata.json" "file_sha256" "15b5d744c87949518883e82d013a9ee012335dbd2cd03ee547125b1a9a71443f"} {"question" "q-251116" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251116" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{256}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251111" "field" nil "attribute" "question/problem" "value" "The coefficient of ${u}^{3}$ in the expansion of ${(1-u)}^{20}$ is{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251111" "field" nil "attribute" "question/worked-solution" "value" "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-u$ and $n$ with $20$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{20(20-1)(20-2)}{3!}\\cdot (-u)^{3} & =\\frac{20\\cdot 19\\cdot 18}{6}\\cdot (-u)^{3} \\\\  & =1140\\cdot (-{u}^{3}) \\\\  & =-1140{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${u}^{3}$ is $-1140.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/state.json" "file_sha256" "95d39e4ebb7a80d83f9880ffa1429b76076f21dd88c405b457781d201175b0c7"} {"question" "q-251111" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996388/activity-meta