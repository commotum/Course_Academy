fields [{:answer-field/choices [{:answer/id #uuid "38016097-466a-5256-b8d9-509aee7aafc0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{91}{4}" :db/id #edb/ref 17592186285023} {:answer/id #uuid "b875ba8e-8697-5908-bf13-3a6d7bce083e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{91}{4}" :db/id #edb/ref 17592186285024} {:answer/id #uuid "77090f8a-790b-525f-86dc-2d3fa464dbc4" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186285025} {:answer/id #uuid "cf1a1f33-5594-5316-ab0e-997516dc751a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{91}{2}" :db/id #edb/ref 17592186285026} {:answer/id #uuid "44cd0edb-ea68-5221-92f1-bc023303e93f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186285027}] :answer-field/correct {:answer/id #uuid "44cd0edb-ea68-5221-92f1-bc023303e93f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186285027} :answer-field/id #uuid "8ead65e7-da07-5368-8ef3-37f1c5106652" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285022}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b6ce46c0-0ea2-5270-bc3b-4d0ef451e70d" :question/math-academy-id "q-136014" :question/problem "The coefficient of ${a}^{3}$ in the expansion of ${(1-\\frac{a}{2})}^{14}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-\\frac{a}{2}$ and $n$ with $14$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{14(14-1)(14-2)}{3!}\\cdot {(-\\frac{a}{2})}^{3} & =\\frac{14\\cdot 13\\cdot 12}{6}\\cdot (-\\frac{1}{{2}^{3}})\\cdot {a}^{3} \\\\  & =364\\cdot (-\\frac{1}{8}){a}^{3} \\\\  & =-\\frac{91}{2}{a}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${a}^{3}$ is $-\\frac{91}{2}.$"}] [{:db/id #edb/ref 17592186285028 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0545a15-c70c-58a7-8596-f1004f4b244e" :answer/type {:db/ident :answer.type/math} :answer/value "-560" :db/id #edb/ref 17592186285030} {:answer/id #uuid "43422616-b14d-5171-b390-dbadf3d327cc" :answer/type {:db/ident :answer.type/math} :answer/value "-672" :db/id #edb/ref 17592186285031} {:answer/id #uuid "22a5c4d1-fbd4-558f-8497-fac08961acb8" :answer/type {:db/ident :answer.type/math} :answer/value "280" :db/id #edb/ref 17592186285032} {:answer/id #uuid "c789aa6e-7a2d-5bf7-b75d-5fbd03b2f15c" :answer/type {:db/ident :answer.type/math} :answer/value "672" :db/id #edb/ref 17592186285033} {:answer/id #uuid "e2a74cfc-f6d9-553b-848f-d664313bf3e5" :answer/type {:db/ident :answer.type/math} :answer/value "560" :db/id #edb/ref 17592186285034}] :answer-field/correct {:answer/id #uuid "e2a74cfc-f6d9-553b-848f-d664313bf3e5" :answer/type {:db/ident :answer.type/math} :answer/value "560" :db/id #edb/ref 17592186285034} :answer-field/id #uuid "10ee2291-451b-546c-b24f-358bb08f6f4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285029}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aaa0b5ab-d551-5546-b097-13e043c8ff9d" :question/math-academy-id "q-136020" :question/problem "The coefficient of ${z}^{4}$ in the expansion of ${(1-2z)}^{7}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-2z$ and $n$ with $7$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{7(7-1)(7-2)(7-3)}{4!}\\cdot (-2z)^{4} & =\\frac{7\\cdot 6\\cdot 5\\cdot 4}{24}\\cdot (-2)^{4}\\cdot {z}^{4} \\\\  & =35\\cdot 16{z}^{4} \\\\  & =560{z}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${z}^{4}$ is $560.$"}] [{:db/id #edb/ref 17592186285035 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27573e0e-6e53-5726-8891-06c584c392c8" :answer/type {:db/ident :answer.type/math} :answer/value "1-3a+\\frac{27}{8}a^2" :db/id #edb/ref 17592186285037}] :answer-field/correct {:answer/id #uuid "27573e0e-6e53-5726-8891-06c584c392c8" :answer/type {:db/ident :answer.type/math} :answer/value "1-3a+\\frac{27}{8}a^2" :db/id #edb/ref 17592186285037} :answer-field/id #uuid "6f417d0e-3186-518e-9649-10b0c534e16f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8d73145d-3a16-52e0-9f35-097cb5edf926" :question/math-academy-id "q-234003" :question/problem "Find, in ascending powers of $a,$ the **first three terms** of the binomial expansion of ${(1-\\frac{3a}{4})}^{4}.$\n\n${(1-\\frac{3a}{4})}^{4}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{3a}{4}$ and $n=4$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{3a}{4})}^{4} & =1+4\\cdot (-\\frac{3a}{4})+\\frac{4(4-1)}{2!}\\cdot {(-\\frac{3a}{4})}^{2}+⋯ \\\\  & =1-3a+\\frac{4\\cdot 3}{2}\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+6\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+\\frac{27}{8}{a}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285038 :knowledge-point/_questions [{:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4da2013e-041f-55e4-b91d-c06871bd33e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186285040}] :answer-field/correct {:answer/id #uuid "4da2013e-041f-55e4-b91d-c06871bd33e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186285040} :answer-field/id #uuid "dc182b44-8806-5b15-9c47-78060885411f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285039} {:answer-field/choices [{:answer/id #uuid "bcd94f45-76d3-5a66-9648-0880de534896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{144}{49}" :db/id #edb/ref 17592186285042}] :answer-field/correct {:answer/id #uuid "bcd94f45-76d3-5a66-9648-0880de534896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{144}{49}" :db/id #edb/ref 17592186285042} :answer-field/id #uuid "b48eb9be-e175-5bb8-8fab-4b039c7e184a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285041}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "965cfd30-26f5-52f9-be4a-a291b39402a9" :question/math-academy-id "q-250994" :question/problem "${(1+\\frac{2b}{7})}^{9}=$$\\,1\\,+$\n{{field-1}}$b\\,+$\n{{field-2}}${b}^{2}+⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=\\frac{2b}{7}$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+\\frac{2b}{7})}^{9} & =1+9\\cdot \\frac{2b}{7}+\\frac{9(9-1)}{2!}\\cdot {(\\frac{2b}{7})}^{2}+⋯ \\\\  & =1+\\frac{18b}{7}+\\frac{9\\cdot 8}{2}\\cdot \\frac{4{b}^{2}}{49}+⋯ \\\\  & =1+\\frac{18b}{7}+36\\cdot \\frac{4{b}^{2}}{49}+⋯ \\\\  & =1+\\frac{18}{7}b+\\frac{144}{49}{b}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285043 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba3c90f1-5498-5dd7-b8d6-87a5fa86d24f" :answer/type {:db/ident :answer.type/math} :answer/value "1-18a-144a^2" :db/id #edb/ref 17592186285045} {:answer/id #uuid "082af789-8926-53fc-a19a-480e42736eea" :answer/type {:db/ident :answer.type/math} :answer/value "1-18a+144a^2" :db/id #edb/ref 17592186285046}] :answer-field/correct {:answer/id #uuid "082af789-8926-53fc-a19a-480e42736eea" :answer/type {:db/ident :answer.type/math} :answer/value "1-18a+144a^2" :db/id #edb/ref 17592186285046} :answer-field/id #uuid "71cceb8f-0502-5c0c-87d5-420a0ed197ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285044}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0671f502-afb8-598b-b89e-9fffc6bc907a" :question/math-academy-id "q-251018" :question/problem "Find, in ascending powers of $a,$ the **first three terms** in the binomial expansion of ${(1-2a)}^{9}.$\n\n$(1-2a)^{9}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-2a$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-2a)}^{9} & =1+9\\cdot (-2a)+\\frac{9(9-1)}{2!}\\cdot (-2a)^{2}+⋯ \\\\  & =1-18a+\\frac{9\\cdot 8}{2}\\cdot 4{a}^{2}+⋯ \\\\  & =1-18a+36\\cdot 4{a}^{2}+⋯ \\\\  & =1-18a+144{a}^{2}+⋯\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285047 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5939b43-798f-58d9-a1aa-0a3e31debb0f" :answer/type {:db/ident :answer.type/math} :answer/value "1-50b+1125b^2" :db/id #edb/ref 17592186285049}] :answer-field/correct {:answer/id #uuid "d5939b43-798f-58d9-a1aa-0a3e31debb0f" :answer/type {:db/ident :answer.type/math} :answer/value "1-50b+1125b^2" :db/id #edb/ref 17592186285049} :answer-field/id #uuid "05dca83a-543f-5508-8b5e-1ab7e878becb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285048}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "86dd54e3-3afe-59d7-a94f-bb8b2bdfa6d3" :question/math-academy-id "q-251019" :question/problem "Find, in ascending powers of $b,$ the **first three terms** in the binomial expansion of ${(1-5b)}^{10}.$\n\n$(1-5b)^{10}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-5b$ and $n=10$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-5b)}^{10} & =1+10\\cdot (-5b)+\\frac{10(10-1)}{2!}\\cdot (-5b)^{2}+⋯ \\\\  & =1-50b+\\frac{10\\cdot 9}{2}\\cdot 25{b}^{2}+⋯ \\\\  & =1-50b+45\\cdot 25{b}^{2}+⋯ \\\\  & =1-50b+1\\,125{b}^{2}+⋯\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285050 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfe59a89-564a-5bf2-822b-3d1c12f1fb73" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8}{5}k+\\frac{28}{25}k^2" :db/id #edb/ref 17592186285052}] :answer-field/correct {:answer/id #uuid "cfe59a89-564a-5bf2-822b-3d1c12f1fb73" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{8}{5}k+\\frac{28}{25}k^2" :db/id #edb/ref 17592186285052} :answer-field/id #uuid "e13443e3-52ea-5156-9537-37a38f70de46" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285051}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f53ae958-dc5d-53e1-8da2-f5eeb62b47a0" :question/math-academy-id "q-251048" :question/problem "Find, in ascending powers of $k,$ the **first three terms** of the binomial expansion of ${(1-\\frac{k}{5})}^{8}.$\n\n${(1-\\frac{k}{5})}^{8}=$\n{{field-1}}$\\,+\\,⋯$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{k}{5}$ and $n=8$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{k}{5})}^{8} & =1+8\\cdot (-\\frac{k}{5})+\\frac{8(8-1)}{2!}\\cdot {(-\\frac{k}{5})}^{2}+⋯ \\\\  & =1-\\frac{8k}{5}+\\frac{8\\cdot 7}{2}\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8k}{5}+28\\cdot \\frac{{k}^{2}}{25}+⋯ \\\\  & =1-\\frac{8}{5}k+\\frac{28}{25}{k}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186285053 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "500bc08f-f97c-5454-9de2-d05be1548c3c" :answer/type {:db/ident :answer.type/math} :answer/value "-1140" :db/id #edb/ref 17592186285055} {:answer/id #uuid "76b3fea5-176a-59da-949f-f64eab9dfde7" :answer/type {:db/ident :answer.type/math} :answer/value "1140" :db/id #edb/ref 17592186285056}] :answer-field/correct {:answer/id #uuid "500bc08f-f97c-5454-9de2-d05be1548c3c" :answer/type {:db/ident :answer.type/math} :answer/value "-1140" :db/id #edb/ref 17592186285055} :answer-field/id #uuid "fc442b06-5a16-5132-ad96-213798075055" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285054}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "86249e5b-0dd0-572e-a64d-e7f34382a1aa" :question/math-academy-id "q-251111" :question/problem "The coefficient of ${u}^{3}$ in the expansion of ${(1-u)}^{20}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-u$ and $n$ with $20$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{20(20-1)(20-2)}{3!}\\cdot (-u)^{3} & =\\frac{20\\cdot 19\\cdot 18}{6}\\cdot (-u)^{3} \\\\  & =1140\\cdot (-{u}^{3}) \\\\  & =-1140{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${u}^{3}$ is $-1140.$"}] [{:db/id #edb/ref 17592186285057 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7150c715-1d64-57ee-bf37-88421a635897" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{256}" :db/id #edb/ref 17592186285059}] :answer-field/correct {:answer/id #uuid "7150c715-1d64-57ee-bf37-88421a635897" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{256}" :db/id #edb/ref 17592186285059} :answer-field/id #uuid "e29eef8d-c7bb-5a37-8683-2efa7498c259" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285058}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "872f723a-424a-5c2d-83c9-f643fea0331d" :question/math-academy-id "q-251116" :question/problem "The coefficient of ${k}^{4}$ in the expansion of ${(1-\\frac{k}{4})}^{5}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $-\\frac{k}{4}$ and $n$ with $5$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{5(5-1)(5-2)(5-3)}{4!}\\cdot {(-\\frac{k}{4})}^{4} & =\\frac{5\\cdot 4\\cdot 3\\cdot 2}{24}\\cdot {(-\\frac{1}{4})}^{4}\\cdot {k}^{4} \\\\  & =5\\cdot \\frac{1}{256}{k}^{4} \\\\  & =\\frac{5}{256}{k}^{4}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${k}^{4}$ is $\\frac{5}{256}.$"}] [{:db/id #edb/ref 17592186285060 :knowledge-point/_questions [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b3da48-9d0a-5324-8a79-e74b5aea5fbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{80}{27}" :db/id #edb/ref 17592186285062}] :answer-field/correct {:answer/id #uuid "32b3da48-9d0a-5324-8a79-e74b5aea5fbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{80}{27}" :db/id #edb/ref 17592186285062} :answer-field/id #uuid "52a6a249-284d-5b4f-8208-f8521ad70a82" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186285061}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e65bc0d6-6e4f-55e0-8d41-4057609a4e22" :question/math-academy-id "q-251119" :question/problem "The coefficient of ${u}^{4}$ in the expansion of ${(1+\\frac{2u}{3})}^{6}$ is{{field-1}}." :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{4}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)(n-3)}{4!}{x}^{4}.\n$$\n\nReplacing $x$ with $\\frac{2u}{3}$ and $n$ with $6$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{6(6-1)(6-2)(6-3)}{4!}\\cdot {(\\frac{2u}{3})}^{4} & =\\frac{6\\cdot 5\\cdot 4\\cdot 3}{24}\\cdot {(\\frac{2}{3})}^{4}\\cdot {u}^{4} \\\\  & =15\\cdot \\frac{16}{81}{u}^{3} \\\\  & =\\frac{80}{27}{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${u}^{4}$ is $\\frac{80}{27}.$"}]}
