#{[{:db/id #edb/ref 17592186184011 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/id #uuid "a4f624b3-da2f-5b89-affb-374bcf2f5a75" :question/math-academy-id "e-5155" :question/problem "Find the first $3$ terms in ascending powers of $a$ of the binomial expansion of $(1+3a)^5.$" :question/worked-solution "The first $3$ terms of the binomial expansion for ${(1 + x)^n}$ are given by\n\n$$\n{(1 + x)^n} = 1 + nx + \\frac{{n(n - 1)}}{{2!}}{x^2}  +  \\cdots .\n$$\n\nBy substituting $x=3a$ and $n=5$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+3a)}^{5} & =1+5(3a)+\\frac{5(5-1)}{2!}{(3a)}^{2}+⋯ \\\\  & =1+5(3a)+\\frac{5(4)}{2}(9{a}^{2})+⋯ \\\\  & =1+15a+90{a}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184047 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/id #uuid "0094b7a6-a55e-57aa-9ee0-7c5fcd803c82" :question/math-academy-id "e-9778" :question/problem "Determine the coefficient of $r^3$ in the expansion of $\\left( 1 - 3r \\right)^{10}.$" :question/worked-solution "The binomial expansion for $(1 + x)^n$ is given by\n\n$$\n(1 + x)^n = 1 + nx + \\frac{n(n - 1)}{2!} x^2 + \\cdots .\n$$\n\nIn particular, the $x^3$ term is given by\n\n$$\n\\dfrac{n(n-1)(n-2)}{3!} x^3.\n$$\n\nReplacing $x$ with $-3r$ and $n$ with $10$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{10(10-1)(10-2)}{3!}(-3r)^{3} & =\\frac{10(9)(8)}{6}\\cdot (-3)^{3}\\cdot {r}^{3} \\\\  & =\\frac{10(9)(8)}{6}\\cdot (-27){r}^{3} \\\\  & =-3\\,240{r}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of $r^3$ is $-3\\,240.$"}] [{:db/id #edb/ref 17592186184048 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/id #uuid "ca98d9bd-337e-5982-9609-e3d0f4601575" :question/math-academy-id "e-9779" :question/problem "Find the first $3$ terms in ascending powers of $m$ of the binomial expansion of $\\left(1 - \\dfrac{4m}{3}\\right)^7.$" :question/worked-solution "The first $3$ terms of the binomial expansion for ${(1 + x)^n}$ are given by\n\n$$\n{(1 + x)}^n = 1 + nx + \\frac{{n(n - 1)}}{{2!}}{x^2}  +  \\cdots .\n$$\n\nBy substituting $x=-\\dfrac{4m}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{4m}{3})}^{7} & =1+7(-\\frac{4m}{3})+\\frac{7(7-1)}{2!}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}{(-\\frac{4m}{3})}^{2}+⋯ \\\\  & =1+7(-\\frac{4m}{3})+\\frac{7(6)}{2}(\\frac{16{m}^{2}}{9})+⋯ \\\\  & =1-\\frac{28m}{3}+\\frac{112{m}^{2}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284993 :knowledge-point/_questions [{:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "878ea10e-65f7-5a80-a0ea-78736994a082" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{2c}{3}+\\frac{5{c}^{2}}{3}+⋯" :db/id #edb/ref 17592186284995} {:answer/id #uuid "caba3445-2233-5e0c-bdce-bfc05225b775" :answer/type {:db/ident :answer.type/math} :answer/value "1+2c+\\frac{5{c}^{2}}{3}+⋯" :db/id #edb/ref 17592186284996} {:answer/id #uuid "0c66d605-0141-5c91-9123-fabce5df3daf" :answer/type {:db/ident :answer.type/math} :answer/value "1+2c+5{c}^{2}+⋯" :db/id #edb/ref 17592186284997} {:answer/id #uuid "a71feef3-ec05-5c91-94cc-48b072a6dbf1" :answer/type {:db/ident :answer.type/math} :answer/value "1+2c+\\frac{5{c}^{2}}{9}+⋯" :db/id #edb/ref 17592186284998} {:answer/id #uuid "b5bae0ce-1bda-5fca-ba45-e4dddd5ec1a9" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{2c}{3}+\\frac{15{c}^{2}}{2}+⋯" :db/id #edb/ref 17592186284999}] :answer-field/correct {:answer/id #uuid "caba3445-2233-5e0c-bdce-bfc05225b775" :answer/type {:db/ident :answer.type/math} :answer/value "1+2c+\\frac{5{c}^{2}}{3}+⋯" :db/id #edb/ref 17592186284996} :answer-field/id #uuid "33a94359-0b2d-5da9-bf23-481b603c4e60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284994}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fd539843-d96d-5001-848a-3e960f32bb36" :question/math-academy-id "q-113628" :question/problem "${(1+\\frac{c}{3})}^{6}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=\\frac{c}{3}$ and $n=6$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+\\frac{c}{3})}^{6} & =1+6\\cdot \\frac{c}{3}+\\frac{6(6-1)}{2!}\\cdot {(\\frac{c}{3})}^{2}+⋯ \\\\  & =1+2c+\\frac{6\\cdot 5}{2}\\cdot \\frac{{c}^{2}}{9}+⋯ \\\\  & =1+2c+15\\cdot \\frac{{c}^{2}}{9}+⋯ \\\\  & =1+2c+\\frac{5{c}^{2}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184404 :knowledge-point/_questions [{:knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b343456c-53fd-5137-9b29-b5eebc08903f" :answer/type {:db/ident :answer.type/math} :answer/value "1 + 42t + 360t^{2} + ⋯" :db/id #edb/ref 17592186180874} {:answer/id #uuid "f688c68f-c857-5ded-a9ae-ba16d1a7472e" :answer/type {:db/ident :answer.type/math} :answer/value "1 + 42t + 728t^{2} + ⋯" :db/id #edb/ref 17592186180875} {:answer/id #uuid "188ddf88-762f-5e11-9652-a7607b831ed8" :answer/type {:db/ident :answer.type/math} :answer/value "1 + 42t + 724t^{2} + ⋯" :db/id #edb/ref 17592186180876} {:answer/id #uuid "222d32e7-a19c-5799-aa79-f281320d4313" :answer/type {:db/ident :answer.type/math} :answer/value "1 + 42t + 756t^{2} + ⋯" :db/id #edb/ref 17592186180877} {:answer/i