d "8068016d-0d73-5b90-9eee-b92959adb107" :answer/type :answer.type/math :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/ensure [:answer/validate]} {:db/id "q-113893/selection/d045542b3ef11bb0817ce9c708e8e183dddf5272230538bc1b2548a38ffb8883" :answer/id #uuid "39a68e7b-a403-55fe-a988-8e4e98d4cbd2" :answer/type :answer.type/math :answer/value "{(\\frac{1}{8})}^{x}ln⁡8+C" :db/ensure [:answer/validate]} {:db/id "q-113893/selection/14c1492bb3e88fbb7437328fbee2ffaa1c69841328360ca152b4b15a9ba0391d" :answer/id #uuid "148bceba-c687-57d2-aacc-c2ae8f4d989c" :answer/type :answer.type/math :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/ensure [:answer/validate]} {:db/id "q-113893/selection/9dc6978d6c734db5a2fb45f12689c3df3d3c0c54ec722a4cc46ec63181dc6350" :answer/id #uuid "f58b275a-d023-5a74-893e-ea89a81f898b" :answer/type :answer.type/math :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/ensure [:answer/validate]} {:db/id "q-113893/selection/69c6e5f6909d57174d1e8f8cce3f718df71a01e8439af71014a742662a76297f" :answer/id #uuid "c94ad68c-8eb1-57c4-a069-a20abbe36242" :answer/type :answer.type/math :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/ensure [:answer/validate]} {:db/id "q-113893/selection" :answer-field/id #uuid "cdf84eb9-4a68-57c1-a9e0-f2ac1fb031e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113893/selection/9dc6978d6c734db5a2fb45f12689c3df3d3c0c54ec722a4cc46ec63181dc6350" :answer-field/choices ["q-113893/selection/e3b9f153c2b21d9ee7217034db1468c30cdd8efda1f9528bf26bcfab18f032f0" "q-113893/selection/d045542b3ef11bb0817ce9c708e8e183dddf5272230538bc1b2548a38ffb8883" "q-113893/selection/14c1492bb3e88fbb7437328fbee2ffaa1c69841328360ca152b4b15a9ba0391d" "q-113893/selection/9dc6978d6c734db5a2fb45f12689c3df3d3c0c54ec722a4cc46ec63181dc6350" "q-113893/selection/69c6e5f6909d57174d1e8f8cce3f718df71a01e8439af71014a742662a76297f"] :db/ensure [:answer-field/validate]} {:db/id "q-113893" :question/id #uuid "7f24b5d5-2f90-541f-adbe-286158995594" :question/math-academy-id "q-113893" :question/is-example false :question/problem "Calculate $\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡(\\frac{1}{8}) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C=-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113893/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401"] :knowledge-point/questions ["q-113893"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2277/selection/de0d80d4fe89fef866411bcf47d9984f8be8feff8c75eae1e4c1ecc75f32f79c" :answer/id #uuid "724c0c0b-1cca-5085-bc2c-dd8e7e9500f4" :answer/type :answer.type/math :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/ensure [:answer/validate]} {:db/id "q-2277/selection/7e27b7333fde6b51dba2d9280a48d2bfc0734b90f8751b2124c19619547243ec" :answer/id #uuid "06e86260-e700-5ffe-a310-11765141fa62" :answer/type :answer.type/math :answer/value "5{e}^{x}+\\frac{x}{ln⁡2}+C" :db/ensure [:answer/validate]} {:db/id "q-2277/selection/965de479c8a56ecfe70e51430974b05edbbbe8112f0c7ad905dea13b704867c0" :answer/id #uuid "c21738c2-f332-5496-8f95-e685e930b8b6" :answer/type :answer.type/math :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡2}+C" :db/ensure [:answer/validate]} {:db/id "q-2277/selection/ea16d4d57fb29b99d68cf3801e9b96d2c15009f6cde8a5814c4b1a081f9eee1a" :answer/id #uuid "3ea23b3a-527d-56bd-b689-8649f57e5ed4" :answer/type :