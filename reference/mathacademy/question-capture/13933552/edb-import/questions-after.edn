#{[{:db/id #edb/ref 17592186063966 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/is-example true :question/math-academy-id "e-377" :question/problem "Calculate $\\displaystyle \\int 6e^x \\textrm d x$." :question/worked-solution "Factoring out the constant $6$ and taking the integral, we get\n\n$$\n\\begin{aligned} \\int 6e^x \\textrm d x =6 \\int e^x \\, \\textrm d x =6e^x +C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063967 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/is-example true :question/math-academy-id "e-380" :question/problem "Calculate $\\displaystyle \\int -6(7^x) \\, \\textrm d x$." :question/worked-solution "First, we factor out the constant $-6$. Then, we integrate the exponential function, and get\n\n$$\n\\begin{aligned} \\int (-6)7^x \\, \\textrm d x &= -6\\int 7^x\\,\\textrm{d}x \\\\ &=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063968 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/is-example true :question/math-academy-id "e-381" :question/problem "Calculate $\\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x$." :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned} \\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x &= \\displaystyle 5\\int 9^x \\, \\textrm{d}x+ 3 \\displaystyle \\int e^x \\, \\textrm{d}x \\\\ &= 5\\cdot \\dfrac{9^x}{\\ln 9} + 3 e^x +C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246417 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc2d1615-8154-5f48-8cdf-341d86d731f6" :answer/type {:db/ident :answer.type/math} :answer/value "-4{e}^{x}+C" :db/id #edb/ref 17592186246419} {:answer/id #uuid "9bea627f-8f71-53f9-b4b4-0092f597081f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{e}^{x}}+C" :db/id #edb/ref 17592186246420} {:answer/id #uuid "0a2d9427-759d-51fb-9ad9-79553b26a340" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{x}+C" :db/id #edb/ref 17592186246421} {:answer/id #uuid "f3e6a43d-e674-5f52-a432-9c47f1360eaa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{4}+C" :db/id #edb/ref 17592186246422} {:answer/id #uuid "ce3bff12-dd4d-5de5-b596-3f76d879eb20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{4}+C" :db/id #edb/ref 17592186246423}] :answer-field/correct {:answer/id #uuid "bc2d1615-8154-5f48-8cdf-341d86d731f6" :answer/type {:db/ident :answer.type/math} :answer/value "-4{e}^{x}+C" :db/id #edb/ref 17592186246419} :answer-field/id #uuid "8129e58b-948a-5222-af6b-8693c7a4ab0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246418}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0bdce3ec-7fb8-59e0-b767-7c3ceaeb462c" :question/is-example false :question/math-academy-id "q-113853" :question/problem "$\\int -4{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-4$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -4{e}^{x}\\,\\text{d}x & =-4\\int {e}^{x}\\,\\text{d}x \\\\  & =-4{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246424 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3de7d6e2-307a-5806-9e8a-fb3e1a5a1c87" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186246426} {:answer/id #uuid "edf00469-be51-58f5-8796-4b0dc298b14d" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186246427} {:answer/id #uuid "404dd6f2-3d36-57e2-b7ea-2f6a2dcd78d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186246428} {:answer/id #uuid "c79c5b4b-a40e-5452-a2b8-aae98c52811e" :answer/type {:db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186246429} {:answer/id #uuid "68c05ddb-ae43-5ef0-8b55-1a0699e26899" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186246430}] :answer-field/correct {:answer/id #uuid "68c05ddb-ae43-5ef0-8b55-1a0699e26899" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186246430} :answer-field/id #uuid "0bed6b85-3bc6-55b8-9244-3c8fbc3d3091" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246425}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4ef1eedc-5e61-5860-a54b-bea3a444f49b" :question/is-example false :question/math-academy-id "q-113887" :question/problem "Calculate $\\int {5}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246431 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ff66ed6-f3c0-54b3-9c48-eb0c784a9fc8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186246433} {:answer/id #uuid "2eb9a92f-ef32-5914-962f-49f1818a7048" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡2}{9ln⁡x}+C" :db/id #edb/ref 17592186246434} {:answer/id #uuid "4d34893e-fb70-5f58-ad89-32fed491ff0b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot {9}^{x}+C" :db/id #edb/ref 17592186246435} {:answer/id #uuid "d1086e50-70be-5e25-b094-68822b755216" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{9}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246436} {:answer/id #uuid "f3fc9292-30eb-5704-9fe9-1ea73f4c8afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡9}{{9}^{x}}+C" :db/id #edb/ref 17592186246437}] :answer-field/correct {:answer/id #uuid "2ff66ed6-f3c0-54b3-9c48-eb0c784a9fc8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186246433} :answer-field/id #uuid "84515e33-d9b9-56e1-9ba5-277e1676df4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246432}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ddc87ceb-2d1a-505d-b2a4-ba43abf57d08" :question/is-example false :question/math-academy-id "q-113890" :question/problem "$\\int 2\\cdot {9}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $2.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 2\\cdot {9}^{x}\\,\\text{d}x & =2\\int {9}^{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{9}^{x}}{ln⁡9}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246438 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148bceba-c687-57d2-aacc-c2ae8f4d989c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186246440} {:answer/id #uuid "c94ad68c-8eb1-57c4-a069-a20abbe36242" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186246441} {:answer/id #uuid "f58b275a-d023-5a74-893e-ea89a81f898b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186246442} {:answer/id #uuid "39a68e7b-a403-55fe-a988-8e4e98d4cbd2" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{1}{8})}^{x}ln⁡8+C" :db/id #edb/ref 17592186246443} {:answer/id #uuid "8068016d-0d73-5b90-9eee-b92959adb107" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186246444}] :answer-field/correct {:answer/id #uuid "f58b275a-d023-5a74-893e-ea89a81f898b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186246442} :answer-field/id #uuid "cdf84eb9-4a68-57c1-a9e0-f2ac1fb031e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246439}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7f24b5d5-2f90-541f-adbe-286158995594" :question/is-example false :question/math-academy-id "q-113893" :question/problem "Calculate $\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡(\\frac{1}{8}) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C=-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246445 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e86260-e700-5ffe-a310-11765141fa62" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{x}{ln⁡2}+C" :db/id #edb/ref 17592186246447} {:answer/id #uuid "c21738c2-f332-5496-8f95-e685e930b8b6" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246448} {:answer/id #uuid "724c0c0b-1cca-5085-bc2c-dd8e7e9500f4" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246449} {:answer/id #uuid "29dd5691-ef60-5a05-a2eb-47f9cd351e29" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{x}+{2}^{x}ln⁡2+C" :db/id #edb/ref 17592186246450} {:answer/id #uuid "3ea23b3a-527d-56bd-b689-8649f57e5ed4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246451}] :answer-field/correct {:answer/id #uuid "724c0c0b-1cca-5085-bc2c-dd8e7e9500f4" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246449} :answer-field/id #uuid "3fa9fdca-a8a3-59c1-858b-0a7c07e580bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246446}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f6472140-527a-5b7e-abfb-be364297447d" :question/is-example false :question/math-academy-id "q-2277" :question/problem "$\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064647 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b20ca656-8422-5096-b3b8-c1b260c4bb2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{x} + C" :db/id #edb/ref 17592186062394} {:answer/id #uuid "c44dbfab-960c-5858-8af5-292bb23dbaae" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-2x} + C" :db/id #edb/ref 17592186062395} {:answer/id #uuid "37d67954-f061-531d-8c42-e34fbbbbf713" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{e^{x}}{2} + C" :db/id #edb/ref 17592186062396} {:answer/id #uuid "5e794e93-d642-5f57-bbb7-648fa2352a50" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{\\ln x} + C" :db/id #edb/ref 17592186062397} {:answer/id #uuid "7c7fb0fd-ff1c-5ed1-a194-1756b0d42f33" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{e^{x}} + C" :db/id #edb/ref 17592186062398}] :answer-field/correct {:answer/id #uuid "b20ca656-8422-5096-b3b8-c1b260c4bb2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{x} + C" :db/id #edb/ref 17592186062394} :answer-field/id #uuid "6541ce0e-de82-519d-8463-6090d793d920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062393}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/is-example false :question/math-academy-id "q-31245" :question/problem "What is $\\displaystyle \\int - 2e^{x}dx$?" :question/worked-solution "Factoring out the constant $-2$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -2{e}^{x}\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246452 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09039b22-0c14-5833-ba27-e85a84f51dc0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{3}^{ln⁡x}}{ln⁡2}+C" :db/id #edb/ref 17592186246454} {:answer/id #uuid "82f0379c-79bf-5fa1-bdf4-918ff3e1e67d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{3}^{2x}}{ln⁡3}+C" :db/id #edb/ref 17592186246455} {:answer/id #uuid "3c019851-47aa-5fa3-9b2e-68e98da131d0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246456} {:answer/id #uuid "a65d3530-c7b8-5864-bbd3-d3c4ef9fea46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{ln⁡x}+C" :db/id #edb/ref 17592186246457} {:answer/id #uuid "31e6f831-67d5-5f2f-a806-ba1d997cc714" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡2}+C" :db/id #edb/ref 17592186246458}] :answer-field/correct {:answer/id #uuid "3c019851-47aa-5fa3-9b2e-68e98da131d0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186246456} :answer-field/id #uuid "b3d01da7-4df6-5c78-a5e9-75781d640341" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246453}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b45c4c97-b6e6-5bab-b860-dae1ad596e4f" :question/is-example false :question/math-academy-id "q-31249" :question/problem "$\\int 3\\cdot {2}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $3.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 3\\cdot {2}^{x}\\,\\text{d}x & =3\\int {2}^{x}\\,\\text{d}x \\\\  & =3\\cdot \\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246459 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "792fb43a-b337-5d2f-9b20-78198dfd3010" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186246461} {:answer/id #uuid "f63e41ec-692f-598a-9349-6f92209c55e1" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{3x}-\\frac{{3}^{2x}}{ln⁡x}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186246462} {:answer/id #uuid "850bd681-63e5-5acd-aecc-75520b5fa6d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡2}+\\frac{{x}^{2}}{2}-3{e}^{x}+C" :db/id #edb/ref 17592186246463} {:answer/id #uuid "c4f1e995-d87a-54f1-b21c-5b04fc49144a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{3}^{x}}{ln⁡2}+\\frac{{x}^{2}}{3}+C" :db/id #edb/ref 17592186246464} {:answer/id #uuid "47726474-4ac8-5a8f-b7e4-7fe3531d3e0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+{x}^{2}+{e}^{x}+C" :db/id #edb/ref 17592186246465}] :answer-field/correct {:answer/id #uuid "792fb43a-b337-5d2f-9b20-78198dfd3010" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186246461} :answer-field/id #uuid "89efced3-fd20-5514-baa8-e2df18554e49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246460}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8ce6b0f6-7269-5973-ab2d-0733bedefe61" :question/is-example false :question/math-academy-id "q-31252" :question/problem "$\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x & =2\\int {e}^{x}\\,\\text{d}x-\\int {3}^{x}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246466 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28897a1d-370b-59c8-a167-6f25fc95e177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{3x}}{ln⁡x}+2{e}^{2x}+{x}^{2}+C" :db/id #edb/ref 17592186246468} {:answer/id #uuid "c1a28c7f-6847-5971-903f-01962e204eb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3x}}{ln⁡5}+2{e}^{x}+x+C" :db/id #edb/ref 17592186246469} {:answer/id #uuid "2b961914-8d23-539f-bf8e-5bae01b0df22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡|x|}-{e}^{2x}+x+C" :db/id #edb/ref 17592186246470} {:answer/id #uuid "f7abe682-0458-5a30-b825-85851d6e0d66" :answer/type {:db/ident :answer.type/math} :answer/value "2\\frac{{e}^{5x}}{ln⁡5}-{e}^{x}+2x+C" :db/id #edb/ref 17592186246471} {:answer/id #uuid "678083e6-b575-5c5a-aabb-c77707c1b96c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}-2{e}^{x}+2x+C" :db/id #edb/ref 17592186246472}] :answer-field/correct {:answer/id #uuid "678083e6-b575-5c5a-aabb-c77707c1b96c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}-2{e}^{x}+2x+C" :db/id #edb/ref 17592186246472} :answer-field/id #uuid "d1663bc1-d63a-55af-a6a3-0bbb83c35886" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246467}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8de3e2ae-7cea-5b82-a378-310233f5930f" :question/is-example false :question/math-academy-id "q-31254" :question/problem "$\\int ({5}^{x}-2{e}^{x}+2)\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int ({5}^{x}-2{e}^{x}+2)\\,\\text{d}x & =\\int {5}^{x}\\,\\text{d}x-2\\int {e}^{x}\\,\\text{d}x+\\int 2\\,\\text{d}x \\\\  & =\\frac{{5}^{x}}{ln⁡5}-2{e}^{x}+2x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246473 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac4e678b-7ad2-5cc2-90b4-5f9b42caaf6b" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-2x}+\\frac{{4}^{x}}{ln⁡|x|}+4ln⁡|x|+C" :db/id #edb/ref 17592186246475} {:answer/id #uuid "2e0747ce-cb0c-5ef4-9615-c7a06a1ed528" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{{e}^{x}}+\\frac{{2}^{x}}{ln⁡4}+3ln⁡|x|+C" :db/id #edb/ref 17592186246476} {:answer/id #uuid "cfb3bf72-dcfd-5ae4-964c-840619892b2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+ln⁡|x|+C" :db/id #edb/ref 17592186246477} {:answer/id #uuid "65eedd8a-8d41-5364-a6ed-413692dc0fdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{2}+\\frac{x}{ln⁡4}+3ln⁡|x|+C" :db/id #edb/ref 17592186246478} {:answer/id #uuid "22e90793-8104-5bfc-925d-8bc099caf572" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}+\\frac{{4}^{4x}}{ln⁡2}+2ln⁡|x|+C" :db/id #edb/ref 17592186246479}] :answer-field/correct {:answer/id #uuid "cfb3bf72-dcfd-5ae4-964c-840619892b2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+ln⁡|x|+C" :db/id #edb/ref 17592186246477} :answer-field/id #uuid "d66ddee5-0995-5825-ab63-22143841bd54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246474}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d8a023ba-b7a7-542e-a32d-4d1ac48ecf79" :question/is-example false :question/math-academy-id "q-31256" :question/problem "$\\int (-2{e}^{x}+{4}^{x}+\\frac{1}{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (-2{e}^{x}+{4}^{x}+\\frac{1}{x})\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x+\\int {4}^{x}\\,\\text{d}x+\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+\\frac{{4}^{x}}{ln⁡4}+ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246480 :knowledge-point/_questions [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0eec562-d0e8-593f-a544-b31083a8806a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}-{e}^{5x}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186246482} {:answer/id #uuid "80180ac4-118a-5c27-9f41-f2d5a830938e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{5}^{x}}{ln⁡5}-{e}^{x}+\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186246483} {:answer/id #uuid "7eb86ce0-4ceb-5226-bb71-400e7613cb97" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot \\frac{{5}^{x}}{ln⁡5}+{e}^{x}+\\frac{{x}^{3}}{2}+C" :db/id #edb/ref 17592186246484} {:answer/id #uuid "603b7247-23c4-5001-921a-6b83dbe65db1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{x}{ln⁡5}+{e}^{x}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186246485} {:answer/id #uuid "4f49c07a-3aa9-5cf9-ab89-fe241212c985" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{5}^{x}}{ln⁡|x|}-2{e}^{x}+\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186246486}] :answer-field/correct {:answer/id #uuid "80180ac4-118a-5c27-9f41-f2d5a830938e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{5}^{x}}{ln⁡5}-{e}^{x}+\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186246483} :answer-field/id #uuid "f32b19fd-e935-5e8d-84dc-1a873f1d8762" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246481}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5c6660a7-8e51-5c94-9e2f-0151e9c91413" :question/is-example false :question/math-academy-id "q-31260" :question/problem "$\\int (2\\cdot {5}^{x}-{e}^{x}+{x}^{3})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2\\cdot {5}^{x}-{e}^{x}+{x}^{3})\\,\\text{d}x & =2\\int {5}^{x}\\,\\text{d}x-\\int {e}^{x}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{5}^{x}}{ln⁡5}-{e}^{x}+\\frac{{x}^{4}}{4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064848 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f6eaa4-11dc-5433-a31f-d077d7d13258" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3^{x}}{\\ln 3} + C" :db/id #edb/ref 17592186063599} {:answer/id #uuid "a4080a32-0697-50b0-bb46-277c358a2fcc" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x} + C" :db/id #edb/ref 17592186063600} {:answer/id #uuid "de194075-b96e-5a2e-b7b2-f875bbb96d95" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x}\\ln 3 + C" :db/id #edb/ref 17592186063601} {:answer/id #uuid "5f2a9bab-6c1d-58f2-9ecf-2627fdf55980" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln x}{\\ln 3} + C" :db/id #edb/ref 17592186063602} {:answer/id #uuid "6fbe578b-bd49-53b9-aff4-fe54519c9038" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (3^{x}) + C" :db/id #edb/ref 17592186063603}] :answer-field/correct {:answer/id #uuid "88f6eaa4-11dc-5433-a31f-d077d7d13258" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3^{x}}{\\ln 3} + C" :db/id #edb/ref 17592186063599} :answer-field/id #uuid "40fab28f-ab8d-5eff-856e-c928e7e3f0ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063598}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "709a586a-cd76-5969-9f50-4116711ad7ab" :question/is-example false :question/math-academy-id "q-66139" :question/problem "Calculate $\\displaystyle \\int3^{x}dx$." :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {3}^{x}\\,\\text{d}x & =\\frac{{3}^{x}}{ln⁡3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246487 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4c28544-aa40-54c4-8594-684ff296f128" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186246489} {:answer/id #uuid "c50cb1ea-56e9-5985-87a0-9b9c33f77375" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186246490} {:answer/id #uuid "52ec6074-fc6e-5fcb-9acd-f6e3836a5384" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186246491} {:answer/id #uuid "840df1c0-116c-55bc-896e-dd91c9e9c67c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{