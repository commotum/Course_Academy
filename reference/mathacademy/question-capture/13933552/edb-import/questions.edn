#{[{:db/id #edb/ref 17592186063966 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/is-example true :question/math-academy-id "e-377" :question/problem "Calculate $\\displaystyle \\int 6e^x \\textrm d x$." :question/worked-solution "Factoring out the constant $6$ and taking the integral, we get\n\n$$\n\\begin{aligned} \\int 6e^x \\textrm d x =6 \\int e^x \\, \\textrm d x =6e^x +C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063967 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/is-example true :question/math-academy-id "e-380" :question/problem "Calculate $\\displaystyle \\int -6(7^x) \\, \\textrm d x$." :question/worked-solution "First, we factor out the constant $-6$. Then, we integrate the exponential function, and get\n\n$$\n\\begin{aligned} \\int (-6)7^x \\, \\textrm d x &= -6\\int 7^x\\,\\textrm{d}x \\\\ &=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063968 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/is-example true :question/math-academy-id "e-381" :question/problem "Calculate $\\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x$." :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned} \\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x &= \\displaystyle 5\\int 9^x \\, \\textrm{d}x+ 3 \\displaystyle \\int e^x \\, \\textrm{d}x \\\\ &= 5\\cdot \\dfrac{9^x}{\\ln 9} + 3 e^x +C. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064647 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b20ca656-8422-5096-b3b8-c1b260c4bb2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{x} + C" :db/id #edb/ref 17592186062394} {:answer/id #uuid "c44dbfab-960c-5858-8af5-292bb23dbaae" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-2x} + C" :db/id #edb/ref 17592186062395} {:answer/id #uuid "37d67954-f061-531d-8c42-e34fbbbbf713" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{e^{x}}{2} + C" :db/id #edb/ref 17592186062396} {:answer/id #uuid "5e794e93-d642-5f57-bbb7-648fa2352a50" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{\\ln x} + C" :db/id #edb/ref 17592186062397} {:answer/id #uuid "7c7fb0fd-ff1c-5ed1-a194-1756b0d42f33" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{e^{x}} + C" :db/id #edb/ref 17592186062398}] :answer-field/correct {:answer/id #uuid "b20ca656-8422-5096-b3b8-c1b260c4bb2f" :answer/type {:db/ident :answer.type/math} :answer/value "-2e^{x} + C" :db/id #edb/ref 17592186062394} :answer-field/id #uuid "6541ce0e-de82-519d-8463-6090d793d920" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062393}] :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/is-example false :question/math-academy-id "q-31245" :question/problem "What is $\\displaystyle \\int - 2e^{x}dx$?"}] [{:db/id #edb/ref 17592186064848 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f6eaa4-11dc-5433-a31f-d077d7d13258" :answer/type {:db/ident :answer.type/mat