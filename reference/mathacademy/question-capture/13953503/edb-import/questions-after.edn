in}^{2}⁡{15}^{∘} & =\\operatorname{cos}⁡(2\\cdot {15}^{∘}) \\\\  & =\\operatorname{cos}⁡{30}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266295 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d32d0a3-8d0b-5b3d-a759-22c55dd92673" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186266297} {:answer/id #uuid "c0f251fd-6c5c-5fe6-816e-269275cc2b2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186266298} {:answer/id #uuid "33bde40e-0670-513a-a9a1-2b28338740ce" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266299} {:answer/id #uuid "52b83c64-a141-5c73-b2b8-e5b389c86d0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186266300} {:answer/id #uuid "24c8ab40-b275-5d7a-9946-2c11ee28d45c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266301}] :answer-field/correct {:answer/id #uuid "33bde40e-0670-513a-a9a1-2b28338740ce" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266299} :answer-field/id #uuid "92f0fd71-e120-5c5a-9906-332fd6ca5812" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a48f9f2-c671-594d-b9d6-9a4622e13e31" :question/math-academy-id "q-120369" :question/problem "Find the exact value of $1-2{sin}^{2}⁡({75}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡({75}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {75}^{∘}) \\\\  & =\\operatorname{cos}⁡{150}^{∘} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266302 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cea964b-7c43-5282-bd68-8059398cb620" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266304}] :answer-field/correct {:answer/id #uuid "6cea964b-7c43-5282-bd68-8059398cb620" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186266304} :answer-field/id #uuid "8efdf1f1-b048-56ed-9750-68262ca3705d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266303}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f31d3f05-5ba5-5c12-9d43-e5237cc11367" :question/math-academy-id "q-332139" :question/problem "Find the **exact** value of the expression below.\n\n${cos}^{2}\\,(\\frac{5\\pi }{12})-{sin}^{2}\\,(\\frac{5\\pi }{12})=$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{5\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}\\,(\\frac{5\\pi }{12})-{sin}^{2}\\,(\\frac{5\\pi }{12}) & =cos\\,(2\\cdot \\frac{5\\pi }{12}) \\\\  & =cos\\,(\\frac{5\\pi }{6}) \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266305 :knowledge-point/_questions [{:knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92e97f9f-d3a8-5820-9737-fe74cda49173" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266307}] :answer-field/correct {:answer/id #uuid "92e97f9f-d3a8-5820-9737-fe74cda49173" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266307} :answer-field/id #uuid "35cad5cc-3e40-55af-9fbd-56ee1889a1c5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266306}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "224973b3-4d0f-5f60-b8d7-c480ae784416" :question/math-academy-id "q-332151" :question/problem "Find the **exact** value of the expression below.\n\n${cos}^{4}\\,(\\frac{\\pi }{4})-2{cos}^{2}\\,(\\frac{\\pi }{4}){sin}^{2}\\,(\\frac{\\pi }{4})+{sin}^{4}\\,(\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "First, notice that our expression is a perfect square that can be rewritten as follows:\n\n$$\n\\begin{aligned}{cos}^{4}\\,(\\frac{\\pi }{4})-2{cos}^{2}\\,(\\frac{\\pi }{4}){sin}^{2}\\,(\\frac{\\pi }{4})+{sin}^{4}\\,(\\frac{\\pi }{4}) & ={({cos}^{2}\\,(\\frac{\\pi }{4})-{sin}^{2}\\,(\\frac{\\pi }{4}))}^{2}\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{4}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}\\,(\\frac{\\pi }{4})-{sin}^{2}\\,(\\frac{\\pi }{4}) & =cos\\,(2\\cdot \\frac{\\pi }{4}) \\\\  & =cos\\,(\\frac{\\pi }{2}) \\\\  & =0.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{({cos}^{2}\\,(\\frac{\\pi }{4})-{sin}^{2}\\,(\\frac{\\pi }{4}))}^{2} & ={0}^{2}=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266308 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e998d5-b71a-5b7a-83f9-c951b357c51a" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{44}^{∘}" :db/id #edb/ref 17592186266310} {:answer/id #uuid "cb7355d7-d4ac-596c-b658-aa7ab1696b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186266311} {:answer/id #uuid "a77c5fd7-c7a8-5284-b81b-43b64e7dba57" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{44}^{∘}" :db/id #edb/ref 17592186266312} {:answer/id #uuid "50788728-3e22-5641-a6d8-e147c1cebff2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{22}^{∘}\\operatorname{cos}⁡{22}^{∘}" :db/id #edb/ref 17592186266313} {:answer/id #uuid "7637427d-5809-525a-991c-8dd31755c894" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{25}^{∘}\\operatorname{cos}⁡{25}^{∘}" :db/id #edb/ref 17592186266314}] :answer-field/correct {:answer/id #uuid "cb7355d7-d4ac-596c-b658-aa7ab1696b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186266311} :answer-field/id #uuid "cc446ca9-dc6d-520f-97f6-9657373b913d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266309}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "69a7ca9e-fd71-55ad-91ce-07744b83a69e" :question/math-academy-id "q-7692" :question/problem "Express $2{cos}^{2}⁡{22}^{∘}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={22}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡{22}^{∘}-1 & =\\operatorname{cos}⁡2\\cdot {22}^{∘} \\\\  & =\\operatorname{cos}⁡{44}^{∘}.\\end{aligned}\n$$"}]}
