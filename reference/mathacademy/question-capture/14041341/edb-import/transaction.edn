817bb352244da668b738e65" "q-10069/selection/fee54cc14039e72bfa1d8d0fecf3ed6b59722f21c7de7ef5cf44920db540fe9a"] :db/ensure [:answer-field/validate]} {:db/id "q-10069" :question/id #uuid "a7a92fcb-b207-5eef-a9b6-b755cd426c22" :question/math-academy-id "q-10069" :question/problem "Find the first four non-zero terms of the Maclaurin expansion of $\\frac{1}{1-{x}^{3}}.$" :question/worked-solution "The standard Maclaurin expansion for $\\frac{1}{1-x}$ is\n\n$$\n\\begin{aligned}\\frac{1}{1-x} & =1+x+{x}^{2}+{x}^{3}+⋯\\,.\\end{aligned}\n$$\n\nReplacing $x$ with ${x}^{3}$ in the above expansion and simplifying gives\n\n$$\n\\begin{aligned}\\frac{1}{1-{x}^{3}} & =1+({x}^{3})+{({x}^{3})}^{2}+{({x}^{3})}^{3}+⋯ \\\\  & =1+{x}^{3}+{x}^{6}+{x}^{9}+⋯\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10069/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdd566f7-15e2-59d9-bf6a-1fa3598399b9"] :knowledge-point/questions ["q-10069"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8171/selection/421bbe170a0fb5de09635f395d85172c2bc43aaed79665f5ddebf06dea24ff39" :answer/id #uuid "40ef16ab-0b11-5fc9-8278-d2993d8f3fd6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\sqrt{x}=1-\\frac{x}{2}+\\frac{{x}^{2}}{24}-\\frac{{x}^{3}}{720}+⋯" :db/ensure [:answer/validate]} {:db/id "q-8171/selection/a267f681ea3e25bc1c229d7d998ccaff363d54add248c28588366b341cce36d3" :answer/id #uuid "0bc6d749-c962-5344-a632-8fedc4dc796d" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\sqrt{x}=1+\\frac{x}{2}+\\frac{{x}^{2}}{24}+\\frac{{x}^{3}}{720}+⋯" :db/ensure [:answer/validate]} {:db/id "q-8171/selection/48e20ea1c390437bd959d26be7e92cc6d778cb8eb02bb8d7a0e66b8111176859" :answer/id #uuid "b51d8da8-a222-5b71-998c-27c41b3f6e3b" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\sqrt{x}=1-\\frac{x}{2}+\\frac{{x}^{2}}{12}-\\frac{{x}^{3}}{240}+⋯" :db/ensure [:answer/validate]} {:db/id "q