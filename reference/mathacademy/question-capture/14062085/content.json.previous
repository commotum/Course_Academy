  "questions": [
    {
      "math_academy_id": "q-80725",
      "knowledge_point_id": "3105e8eb-010f-542b-9e40-12fda6ea00e7",
      "knowledge_point": "Finding the Standard Matrix of a Stretch Transformation Given a Vector and its Image",
      "problem": "A linear transformation $T$ represents a stretch along the $x$-axis or $y$-axis. Given that $v=[\\begin{aligned}2 \\\\ -6\\end{aligned}]$ and $T(v)=[\\begin{aligned}2 \\\\ -2\\end{aligned}],$ what is the standard matrix of $T?$",
      "worked_solution": "First, we are told that $T$ represents a stretch along the $x$-axis or $y$-axis.\n\nComparing the $x$- and $y$-components of $v$ and $T(v),$ we note the following:\n\n- the $x$-components of $v$ and $T(v)$ are the same, while\n\n- the $y$-component of $T(v)$ is $\\frac{1}{3}$ times the $y$-component of $v.$\n\nSo, we conclude that $T$ represents a stretch of scale factor $\\frac{1}{3}$ in the $y$-direction.\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}].\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "type": "math",
              "value": "[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}]"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}1 & 0 \\\\ 0 & 3\\end{aligned}]"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & 1\\end{aligned}]"
            }
          ],
          "correct_value": "[\\begin{aligned}1 & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}]",
          "choices_complete": true,
          "correct_origin": "ma_successful_grade"
        }
      ],
