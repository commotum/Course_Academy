.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105024} {:answer/id #uuid "b33af94e-420f-5cfd-b0af-f118b8697055" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186105025} {:answer/id #uuid "bf6bae65-78c2-5856-9f0b-163e1c048ff6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105026} {:answer/id #uuid "fd0d689b-1c5e-51c2-88cc-ac6b5d900a1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186105027} {:answer/id #uuid "2aff7b31-5277-574c-afb7-f649464edb91" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105028}] :answer-field/correct {:answer/id #uuid "bf6bae65-78c2-5856-9f0b-163e1c048ff6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105026} :answer-field/id #uuid "637d172d-46f4-5b21-8f12-e315dda47530" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105023}] :question/id #uuid "85f5eecb-79b7-5107-8347-e7d15fcb457b" :question/math-academy-id "q-80726" :question/problem "A linear transformation $T$ represents a stretch along the $x$-axis or $y$-axis. Given that $v = \\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$ and $T(v) = \\begin{bmatrix}6 \\\\ -2\\end{bmatrix}$, what is the standard matrix of $T$?"}] [{:db/id #edb/ref 17592186106420 :knowledge-point/_questions [{:knowledge-point/id #uuid "c36ce626-1562-51f8-b3fd-d7dc7ce8659c" :knowledge-point/title "Identifying a Shear or Stretch Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b497ef-4e78-56c7-b466-bab4193e14bc" :answer/type {:db/ident :answer.type/te