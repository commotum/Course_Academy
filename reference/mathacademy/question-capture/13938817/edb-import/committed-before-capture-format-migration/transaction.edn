[{:db/id "q-23378/selection/20b67aa64797e65140c5255343e95b86316a4ed9bffd1d0ff258d26023434217" :answer/id #uuid "104395e9-bd32-520c-b5d8-66522f7c9d31" :answer/type :answer.type/math :answer/value "y=5x+1" :db/ensure [:answer/validate]} {:db/id "q-23378/selection/4393bdb2095e9efa1a6e7ffa3b6dc700e2346088e49169ee99fe683ae5f4839e" :answer/id #uuid "47deefea-56a7-5d71-a601-396a33834728" :answer/type :answer.type/math :answer/value "y=\\frac{5}{2}x+3" :db/ensure [:answer/validate]} {:db/id "q-23378/selection/cb5ba3087d8d4cc464b42a80411fd4c8624da9f55256c0ce455355680f1e986a" :answer/id #uuid "4c83a0b0-8eb4-57b7-a811-9be32bd14e78" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}x-2" :db/ensure [:answer/validate]} {:db/id "q-23378/selection/1837625e191d83a45696aca9c2f3920ae69204af4a72905b74349bc2beb7428a" :answer/id #uuid "fb197ae3-2554-5663-98ec-d95f0ef9cf59" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{5}x-6" :db/ensure [:answer/validate]} {:db/id "q-23378/selection/2841060917a4572f18c62f1f2b76a262d1f2fbed8df830032a3f238bd08fb32a" :answer/id #uuid "0c6f6d0f-1dce-57c2-94e9-d8c74309b1cb" :answer/type :answer.type/math :answer/value "y=-5x-5" :db/ensure [:answer/validate]} {:db/id "q-23378/selection" :answer-field/id #uuid "348882ca-3d6a-5800-be28-1bdd49d1ec74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-23378/selection/1837625e191d83a45696aca9c2f3920ae69204af4a72905b74349bc2beb7428a" :answer-field/choices ["q-23378/selection/20b67aa64797e65140c5255343e95b86316a4ed9bffd1d0ff258d26023434217" "q-23378/selection/4393bdb2095e9efa1a6e7ffa3b6dc700e2346088e49169ee99fe683ae5f4839e" "q-23378/selection/cb5ba3087d8d4cc464b42a80411fd4c8624da9f55256c0ce455355680f1e986a" "q-23378/selection/1837625e191d83a45696aca9c2f3920ae69204af4a72905b74349bc2beb7428a" "q-23378/selection/2841060917a4572f18c62f1f2b76a262d1f2fbed8df830032a3f238bd08fb32a"] :db/ensure [:answer-field/validate]} {:db/id "q-23378" :question/id #uuid "5e5c5991-22ca-5c45-9c80-3f1c166c4c5e" :question/math-academy-id "q-23378" :question/is-example false :question/problem "Which of the following lines is perpendicular to $5x-y=7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $5x-y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}5x-y & =7 \\\\ -y & =-5x+7 \\\\ y & =5x-7\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $5.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{5}x-6$ has a slope of $-\\frac{1}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n5\\cdot (-\\frac{1}{5})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{5}x-6$ is perpendicular to the given line." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-23378/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d"] :knowledge-point/questions ["q-23378"] :db/ensure [:knowledge-point/validate]} {:db/id "q-28338/selection/4a8e2ec20585fabf846d696f931623204f028a3fd36c5b41b7057d3d699f8c91" :answer/id #uuid "cb84ce85-3e0b-5c4e-bf82-7d21458e846a" :answer/type :answer.type/math :answer/value "y=-\\frac{5}{2}x+\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "q-28338/selection/2ba0d0e19d5d36bc90277dae7b49989107c8537de30e84aeac32eb2a228f21d3" :answer/id #uuid "44eb7e96-675a-5e84-bd27-c6f366e16099" :answer/type :answer.type/math :answer/value "y=\\frac{2}{5}x-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-28338/selection/12cbe8cd10b77f8ec83c3dd0980dc8de27746e725eb66d02a12531cfece7de5c" :answer/id #uuid "7692d39b-6e2c-5006-a356-a468edaf0e29" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}x+\\frac{16}{5}" :db/ensure [:answer/validate]} {:db/id "q-28338/selection/ba601885c6bd7e7744dde366dd5b857c409a5e57d0d56395682f707f5c89c163" :answer/id #uuid "39fa7c6a-8e17-51e1-a071-ba922d1cfe47" :answer/type :answer.type/math :answer/value "y=\\frac{5}{2}x-4" :db/ensure [:answer/validate]} {:db/id "q-28338/selection/39b1c6bbace5b0b0535db4ee0ac870fb5a48ded3cfa84b784df20f039c0a12fe" :answer/id #uuid "c069330f-cec0-549b-96c4-8ae52a145061" :answer/type :answer.type/math :answer/value "y=-\\frac{2}{5}x+4" :db/ensure [:answer/validate]} {:db/id "q-28338/selection" :answer-field/id #uuid "74127ef1-65c1-5636-8d63-5380c9277829" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-28338/selection/ba601885c6bd7e7744dde366dd5b857c409a5e57d0d56395682f707f5c89c163" :answer-field/choices ["q-28338/selection/4a8e2ec20585fabf846d696f931623204f028a3fd36c5b41b7057d3d699f8c91" "q-28338/selection/2ba0d0e19d5d36bc90277dae7b49989107c8537de30e84aeac32eb2a228f21d3" "q-28338/selection/12cbe8cd10b77f8ec83c3dd0980dc8de27746e725eb66d02a12531cfece7de5c" "q-28338/selection/ba601885c6bd7e7744dde366dd5b857c409a5e57d0d56395682f707f5c89c163" "q-28338/selection/39b1c6bbace5b0b0535db4ee0ac870fb5a48ded3cfa84b784df20f039c0a12fe"] :db/ensure [:answer-field/validate]} {:db/id "q-28338" :question/id #uuid "416f69f7-f0c9-5347-820e-f65417067948" :question/math-academy-id "q-28338" :question/is-example false :question/problem "Which of the following lines is perpendicular to $4x+10y=20?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $4x+10y=20,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x+10y & =20 \\\\ 10y & =-4x+20 \\\\ y & =-\\frac{4}{10}x+\\frac{20}{10} \\\\ y & =-\\frac{2}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{2}{5}.$\n\nLooking at the answer choices, the line $y=\\frac{5}{2}x-4$ has a slope of $\\frac{5}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{2}{5})\\cdot \\frac{5}{2}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{5}{2}x-4$ is perpendicular to the given line." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-28338/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d"] :knowledge-point/questions ["q-28338"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110139/selection/f5d98a631ee48ed70accf24f8b6cebcd32363395da4e87feeaf883d85b9bc131" :answer/id #uuid "109a639d-5e3b-5cce-9c8d-d52a9bde8791" :answer/type :answer.type/math :answer/value "y=-2" :db/ensure [:answer/validate]} {:db/id "q-110139/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" :answer/id #uuid "073607aa-afba-52a6-8a14-a38936e24cd2" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "q-110139/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" :answer/id #uuid "5da72cd1-7d87-5238-9d17-b976c2e690cf" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "q-110139/selection/763a7c0b26f15df25c2db2d8ac42125e806c2e4b56e4f070b4566eba7e05dfff" :answer/id #uuid "1fb06c44-61f8-554a-b3ce-d936b9ca16c2" :answer/type :answer.type/math :answer/value "y=-3" :db/ensure [:answer/validate]} {:db/id "q-110139/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" :answer/id #uuid "ccb2bc96-5190-5dca-bf14-b231262046dc" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "q-110139/selection" :answer-field/id #uuid "1a8b5cec-a9ad-5c1a-831f-8ed990e5ba82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110139/selection/763a7c0b26f15df25c2db2d8ac42125e806c2e4b56e4f070b4566eba7e05dfff" :answer-field/choices ["q-110139/selection/f5d98a631ee48ed70accf24f8b6cebcd32363395da4e87feeaf883d85b9bc131" "q-110139/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" "q-110139/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" "q-110139/selection/763a7c0b26f15df25c2db2d8ac42125e806c2e4b56e4f070b4566eba7e05dfff" "q-110139/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b"] :db/ensure [:answer-field/validate]} {:db/id "q-110139" :question/id #uuid "dda0082e-1a67-5132-baf3-4657026b2294" :question/math-academy-id "q-110139" :question/is-example false :question/problem "Find the equation of the line that is perpendicular to $x=-1$ and passes through the point $(-2,-3).$" :question/worked-solution "Since the line $x=-1$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(-2,-3),$ which has a $y$-coordinate of $-3.$ So, the perpendicular line is $y=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110139/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065"] :knowledge-point/questions ["q-110139"] :db/ensure [:knowledge-point/validate]} {:db/id "q-215942/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0a02461e-5b95-5d8e-acde-915806813e8d" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-215942/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0d952d48-fcc2-5df5-8571-e5f4eece4465" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-215942/field-1" :answer-field/id #uuid "9c60144b-fd74-523f-a736-9b850a3a9483" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-215942/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-215942/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-215942/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-215942" :question/id #uuid "a0db3a7c-dcad-567a-a447-ae16f102a4f0" :question/math-academy-id "q-215942" :question/is-example false :question/problem "The lines $y=7x-2$ and $kx-14y=7$ are perpendicular. What is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\n- The first line is in slope-intercept form, and the slope is the $x$-coefficient. So the slope of the line $y=7x-2$ is $7.$\n\n- To find the slope of $kx-14y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}kx-14y & =7 \\\\ 14y & =kx-7 \\\\ y & =\\frac{k}{14}x-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the slope of the line $kx-14y=7$ is $\\frac{k}{14}.$\n\nMultiplying the slopes together, we have\n\n$$\n7\\cdot (\\frac{k}{14})=-1\\,⟹\\,k=-2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-215942/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b"] :knowledge-point/questions ["q-215942"] :db/ensure [:knowledge-point/validate]} {:db/id "q-215944/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "5100e8d7-acb8-5055-bd05-6c09f40ddf3f" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-215944/field-1" :answer-field/id #uuid "347c33ae-0e99-5f5d-8b04-920adc5cefd4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-215944/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer-field/choices ["q-215944/field-1/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8"] :db/ensure [:answer-field/validate]} {:db/id "q-215944" :question/id #uuid "91882045-b011-58c7-bd7c-d2cb4bd977bd" :question/math-academy-id "q-215944" :question/is-example false :question/problem "The lines $10x+5y=3$ and $2kx+y=2$ are perpendicular. What is the value of $k?$\n\n$k=$\n{{field-1}}" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of $10x+5y=3,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}10x+5y & =3 \\\\ 5y & =-10x+3 \\\\ y & =-2x+\\frac{3}{5}\\end{aligned}\n$$\n\nTo find the slope of $2kx+y=2,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}2kx+y & =2 \\\\ y & =-2kx+2\\end{aligned}\n$$\n\nTherefore:\n\n- The slope of the line $10x+5y=3$ is $-2.$\n\n- The slope of the line $2kx+y=2$ is $-2k.$\n\nMultiplying the slopes together, we have\n\n$$\n(-2)\\cdot (-2k)=-1\\,⟹\\,k=-\\frac{1}{4}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-215944/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b"] :knowledge-point/questions ["q-215944"] :db/ensure [:knowledge-point/validate]}]
