ate.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-162312" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/activity-metadata.json" "file_sha256" "7d5e176c1965e6036719caa783a0abccebf7775082213f63da199413b30a0882"} {"question" "q-162312" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-162312" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/0596dd32f7ce636cdaaaca82403c735dfe7c98aa04b491b4ec32e79fe0e91715.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/1984fa9bbbb1f33cfade89c69c4c840bbb1a8e5e7cdaf3fb2e967eabaad6fe95.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/922b0c9dea5f16e49b5c362644e03b5779fa0dd5142cd475a653286ccabb2647.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/be6ffed586679262e1145ceea6c5fdca5c8368b8fa14e5bc6188d6cd98712248.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-162312" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216704" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/91f4aac82208a2801652c9112f58518e1abc89ed4313601a60f7c183b7757f70.png)\n\nFind the $10$th root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216704" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{10}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/10}={e}^{k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/d0fc6866d4bb06ec6cbf20bb719faf722ec3c1efe3fba03e413f51dc1c827e71.png)\n\n \n\nSo, the required root corresponds to $k=8.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{8}={e}^{(8)\\pi \\text{i}/5}={e}^{8\\pi \\text{i}/5}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216704" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/activity-metadata.json" "file_sha256" "7d5e176c1965e6036719caa783a0abccebf7775082213f63da199413b30a0882"} {"question" "q-216704" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216704" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{17\\pi \\text{i}/10}"] ["math" "{e}^{19\\pi \\text{i}/10}"] ["math" "{e}^{7\\pi \\text{i}/5}"] ["math" "{e}^{8\\pi \\text{i}/5}"] ["math" "{e}^{9\\pi \\text{i}/5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216704" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{8\\pi \\text{i}/5}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216707" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/ff773f71725cdd3c81f3100623f3b4cc86f3096a3d7f59d14b6943ffa5f11a2b.png)\n\nFind the $8$th root of unity highlighted in the diagram above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216707" "field" nil "attribute" "question/worked-solution" "value" "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{8}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/8}={e}^{k\\pi \\text{i}/4}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/9bbdc0b5be31f5c54fdf3390ec62d2130f528d2807305167f94a5612e39d67de.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/4}={e}^{5\\pi \\text{i}/4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216707" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/activity-metadata.json" "file_sha256" "7d5e176c1965e6036719caa783a0abccebf7775082213f63da199413b30a0882"} {"question" "q-216707" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216707" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{11\\pi \\text{i}/8}"] ["math" "{e}^{3\\pi \\text{i}/2}"] ["math" "{e}^{5\\pi \\text{i}/4}"] ["math" "{e}^{7\\pi \\text{i}/4}"] ["math" "{e}^{9\\pi \\text{i}/8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"} {"question" "q-216707" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{5\\pi \\text{i}/4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/state.json" "file_sha256" "b6a6c81c309733e2fd171e536d0333de2fe7e99174c0db69fe79c7509a9e2466"}] "usage" {"q-155461" []} "basis" 1619 "retractions" [] "immutable_answers" [17592186168842 17592186168843 17592186168844 17592186168845 17592186168846] "immutable_fields" [[17592186168841 :answer-field/correct] [17592186168841 :answer-field/id] [17592186168841 :answer-field/key] [17592186168841 :answer-field/type]] "no_history" []}
