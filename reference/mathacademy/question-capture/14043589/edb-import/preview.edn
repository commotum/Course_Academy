bbb1f33cfade89c69c4c840bbb1a8e5e7cdaf3fb2e967eabaad6fe95.png" 13194139534932 true] [17592186320693 1103 #edb/ref 17592186045452 13194139534932 true] [17592186320693 1111 #uuid "cb87697a-d943-5d76-9d92-33fc5a5fb97a" 13194139534932 true] [17592186320694 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png" 13194139534932 true] [17592186320694 1103 #edb/ref 17592186045452 13194139534932 true] [17592186320694 1111 #uuid "0287ca94-edd5-5a01-8d23-b6659ed9284a" 13194139534932 true] [17592186320695 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/be6ffed586679262e1145ceea6c5fdca5c8368b8fa14e5bc6188d6cd98712248.png" 13194139534932 true] [17592186320695 1103 #edb/ref 17592186045452 13194139534932 true] [17592186320695 1111 #uuid "35340113-0305-530b-8510-9bafd507e52c" 13194139534932 true] [17592186320696 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/922b0c9dea5f16e49b5c362644e03b5779fa0dd5142cd475a653286ccabb2647.png" 13194139534932 true] [17592186320696 1103 #edb/ref 17592186045452 13194139534932 true] [17592186320696 1111 #uuid "592374a7-5803-5afb-81b3-0ea4e2aa3162" 13194139534932 true] [17592186320697 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/0596dd32f7ce636cdaaaca82403c735dfe7c98aa04b491b4ec32e79fe0e91715.png" 13194139534932 true] [17592186320697 1103 #edb/ref 17592186045452 13194139534932 true] [17592186320697 1111 #uuid "8ddbf3b4-daf2-59e6-88db-4033e34fc353" 13194139534932 true] [17592186320698 1017 #edb/ref 17592186320699 13194139534932 true] [17592186320698 1089 "q-216704" 13194139534932 true] [17592186320698 1091 #edb/ref 17592186045463 13194139534932 true] [17592186320698 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/91f4aac82208a2801652c9112f58518e1abc89ed4313601a60f7c183b7757f70.png)\n\nFind the $10$th root of unity highlighted in the diagram above." 13194139534932 true] [17592186320698 1113 #uuid "de9e4794-9949-5bd8-a5a2-86c3e001a9e0" 13194139534932 true] [17592186320698 1145 "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{10}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/10}={e}^{k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/d0fc6866d4bb06ec6cbf20bb719faf722ec3c1efe3fba03e413f51dc1c827e71.png)\n\n \n\nSo, the required root corresponds to $k=8.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{8}={e}^{(8)\\pi \\text{i}/5}={e}^{8\\pi \\text{i}/5}\\end{aligned}\n$$" 13194139534932 true] [17592186320699 1000 #edb/ref 17592186320700 13194139534932 true] [17592186320699 1000 #edb/ref 17592186320701 13194139534932 true] [17592186320699 1000 #edb/ref 17592186320702 13194139534932 true] [17592186320699 1000 #edb/ref 17592186320703 13194139534932 true] [17592186320699 1000 #edb/ref 17592186320704 13194139534932 true] [17592186320699 1040 #edb/ref 17592186045450 13194139534932 true] [17592186320699 1041 "selection" 13194139534932 true] [17592186320699 1104 #edb/ref 17592186320704 13194139534932 true] [17592186320699 1110 #uuid "4ca4645d-60ef-5e38-ae37-86fceb858037" 13194139534932 true] [17592186320700 1034 "{e}^{17\\pi \\text{i}/10}" 13194139534932 true] [17592186320700 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320700 1111 #uuid "9621325e-7faa-5f3c-9a6a-fad13ac7dde1" 13194139534932 true] [17592186320701 1034 "{e}^{9\\pi \\text{i}/5}" 13194139534932 true] [17592186320701 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320701 1111 #uuid "429f01e4-125a-5f71-848a-abec0f55f3f6" 13194139534932 true] [17592186320702 1034 "{e}^{7\\pi \\text{i}/5}" 13194139534932 true] [17592186320702 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320702 1111 #uuid "a6c07ca2-389e-56db-a33b-e9898ce72278" 13194139534932 true] [17592186320703 1034 "{e}^{19\\pi \\text{i}/10}" 13194139534932 true] [17592186320703 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320703 1111 #uuid "bf66e0bc-98aa-5ec9-b672-3f1a64f477cd" 13194139534932 true] [17592186320704 1034 "{e}^{8\\pi \\text{i}/5}" 13194139534932 true] [17592186320704 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320704 1111 #uuid "a5f24781-6f00-579f-87b9-786e331e2cec" 13194139534932 true] [17592186320705 1017 #edb/ref 17592186320706 13194139534932 true] [17592186320705 1089 "q-216707" 13194139534932 true] [17592186320705 1091 #edb/ref 17592186045463 13194139534932 true] [17592186320705 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/ff773f71725cdd3c81f3100623f3b4cc86f3096a3d7f59d14b6943ffa5f11a2b.png)\n\nFind the $8$th root of unity highlighted in the diagram above." 13194139534932 true] [17592186320705 1113 #uuid "9a0045e8-554f-57ed-bbbe-c66196c7f29e" 13194139534932 true] [17592186320705 1145 "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{8}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/8}={e}^{k\\pi \\text{i}/4}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/9bbdc0b5be31f5c54fdf3390ec62d2130f528d2807305167f94a5612e39d67de.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/4}={e}^{5\\pi \\text{i}/4}\\end{aligned}\n$$" 13194139534932 true] [17592186320706 1000 #edb/ref 17592186320707 13194139534932 true] [17592186320706 1000 #edb/ref 17592186320708 13194139534932 true] [17592186320706 1000 #edb/ref 17592186320709 13194139534932 true] [17592186320706 1000 #edb/ref 17592186320710 13194139534932 true] [17592186320706 1000 #edb/ref 17592186320711 13194139534932 true] [17592186320706 1040 #edb/ref 17592186045450 13194139534932 true] [17592186320706 1041 "selection" 13194139534932 true] [17592186320706 1104 #edb/ref 17592186320711 13194139534932 true] [17592186320706 1110 #uuid "3e6cb4cd-8c38-592a-afb1-fa8dfb9fc820" 13194139534932 true] [17592186320707 1034 "{e}^{9\\pi \\text{i}/8}" 13194139534932 true] [17592186320707 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320707 1111 #uuid "f794303d-27cd-5f1c-9e7e-08394cec8b5c" 13194139534932 true] [17592186320708 1034 "{e}^{3\\pi \\text{i}/2}" 13194139534932 true] [17592186320708 1103 #edb/ref 17592186045453 13194139534932 true] [17592186320708 1111 #uuid "e8d34052-d163-53de-8e59-070ae652aba5" 13194139534932 true] [17592186320709 1034 "{e}^{7\\pi \\text{i}/4}" 13194139534932 true] [17592186320709 1103