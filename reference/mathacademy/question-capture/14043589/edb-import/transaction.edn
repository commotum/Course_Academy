f685c4599054fa3f9f804ad9dfb05aac771516e4c" :answer/id #uuid "592374a7-5803-5afb-81b3-0ea4e2aa3162" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/922b0c9dea5f16e49b5c362644e03b5779fa0dd5142cd475a653286ccabb2647.png" :db/ensure [:answer/validate]} {:db/id "q-162312/selection" :answer-field/id #uuid "fb161d84-260c-5f3c-bba5-67c32a9efce6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162312/selection/2e7eb81a54b1fad41a984090030ba923f45187dd5f4d0e99a3be046fd5545574" :answer-field/choices ["q-162312/selection/2e7eb81a54b1fad41a984090030ba923f45187dd5f4d0e99a3be046fd5545574" "q-162312/selection/e35f281bbc5c75778c1288d73d764339dc6842befb728fc424cbb43ecff3b2c1" "q-162312/selection/2cac5ce840937695112b3b303f62e4951e2ee2bab561c195ddc9ba501b187ce2" "q-162312/selection/454edd0d64e07f2b372fe2840c071ad850eb0492272c55644062a0a9ba3d972c" "q-162312/selection/a76b50b8bc31ee5844cc858f685c4599054fa3f9f804ad9dfb05aac771516e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-162312" :question/id #uuid "22c9ee87-969e-5e6d-aac8-6ae444a9bfb9" :question/math-academy-id "q-162312" :question/problem "Which of the following diagrams shows all the $10$th roots of unity?" :question/worked-solution "Geometrically, the $10$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular decagon (regular $10$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-162312/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441"] :knowledge-point/questions ["q-162312"] :db/ensure [:knowledge-point/validate]} {:db/id "q-216704/selection/c9d95163716502b509b429459f55de7496cb02482d7897b2013bf37466d2661b" :answer/id #uuid "bf66e0bc-98aa-5ec9-b672-3f1a64f477cd" :answer/type :answer.type/math :answer/value "{e}^{19\\pi \\text{i}/10}" :db/ensure [:answer/validate]} {:db/id "q-216704/selection/533e62c18c046027c9653ef0a1481aff824ef7db302977d68ac03a2f7e6fc7fe" :answer/id #uuid "9621325e-7faa-5f3c-9a6a-fad13ac7dde1" :answer/type :answer.type/math :answer/value "{e}^{17\\pi \\text{i}/10}" :db/ensure [:answer/validate]} {:db/id "q-216704/selection/5f66dc3438559196d5b84ad97839121513b7811350067beaf2c39cf24f382e42" :answer/id #uuid "429f01e4-125a-5f71-848a-abec0f55f3f6" :answer/type :answer.type/math :answer/value "{e}^{9\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-216704/selection/d131cb2ce87227b6259617e0bea9890c0cb72ff3744c623cbcea1c2ce37e979c" :answer/id #uuid "a5f24781-6f00-579f-87b9-786e331e2cec" :answer/type :answer.type/math :answer/value "{e}^{8\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-216704/selection/a43dc9aca229417f1d861970796ff0ddfc198abd5f556a686e1a180c79c207b1" :answer/id #uuid "a6c07ca2-389e-56db-a33b-e9898ce72278" :answer/type :answer.type/math :answer/value "{e}^{7\\pi \\text{i}/5}" :db/ensure [:answer/validate]} {:db/id "q-216704/selection" :answer-field/id #uuid "4ca4645d-60ef-5e38-ae37-86fceb858037" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-216704/selection/d131cb2ce87227b6259617e0bea9890c0cb72ff3744c623cbcea1c2ce37e979c" :answer-field/choices ["q-216704/selection/c9d95163716502b509b429459f55de7496cb02482d7897b2013bf37466d2661b" "q-216704/selection/533e62c18c046027c9653ef0a1481aff824ef7db302977d68ac03a2f7e6fc7fe" "q-216704/selection/5f66dc3438559196d5b84ad97839121513b7811350067beaf2c39cf24f382e42" "q-216704/selection/d131cb2ce87227b6259617e0bea9890c0cb72ff3744c623cbcea1c2ce37e979c" "q-216704/selection/a43dc9aca229417f1d861970796ff0ddfc198abd5f556a686e1a180c79c207b1"] :db/ensure [:answer-field/validate]} {:db/id "q-216704" :question/id #uuid "de9e4794-9949-5bd8-a5a2-86c3e001a9e0" :question/math-academy-id "q-216704" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/91f4aac82208a2801652c9112f58518e1abc89ed4313601a60f7c183b7757f70.png)\n\nFind the $10$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{10}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/10}={e}^{k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/d0fc6866d4bb06ec6cbf20bb719faf722ec3c1efe3fba03e413f51dc1c827e71.png)\n\n \n\nSo, the required root corresponds to $k=8.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{8}={e}^{(8)\\pi \\text{i}/5}={e}^{8\\pi \\text{i}/5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-216704/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c"] :knowledge-point/questions ["q-216704"] :db/ensure [:knowledge-point/validate]} {:db/id "q-216707/selection/7367fab516955dd54af96711b41966c7736bf9707441b9f86dfcf5cc403621f9" :answer/id #uuid "d656e453-9176-569c-a2b4-09025ce3b81b" :answer/type :answer.type/math :answer/value "{e}^{7\\pi \\text{i}/4}" :db/ensure [:answer/validate]} {:db/id "q-216707/selection/8b467f01a51816c0658f96908cfbd0f1c5f87ac31267447557c60ac7ceaf4c4c" :answer/id #uuid "48719fef-d1c2-575c-9d75-97edb0504a48" :answer/type :answer.type/math :answer/value "{e}^{11\\pi \\text{i}/8}" :db/ensure [:answer/validate]} {:db/id "q-216707/selection/d8e1d49cc9e77a07eb7f20e14967bee39d4cee1d70b41acc66bdbf9f61866c1a" :answer/id #uuid "61c3ec69-a7c3-55ea-8d09-d3f9c846e47f" :answer/type :answer.type/math :answer/value "{e}^{5\\pi \\text{i}/4}" :db/ensure [:answer/validate]} {:db/id "q-216707/selection/5a4bf34638d1176ebc8dfcd7519153b34488e1cd25adc365463fe238e7295c8d" :answer/id #uuid "e8d34052-d163-53de-8e59-070ae652aba5" :answer/type :answer.type/math :answer/value "{e}^{3\\pi \\text{i}/2}" :db/ensure [:answer/validate]} {:db/id "q-216707/selection/17ea7fcb516e8446b35123ac1e562e545df786f303cd688e47ad7a0c048e7cd3" :answer/id #uuid "f794303d-27cd-5f1c-9e7e-08394cec8b5c" :answer/type :answer.type/math :answer/value "{e}^{9\\pi \\text{i}/8}" :db/ensure [:answer/validate]} {:db/id "q-216707/selection" :answer-field/id #uuid "3e6cb4cd-8c38-592a-afb1-fa8dfb9fc820" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-216707/selection/d8e1d49cc9e77a07eb7f20e14967bee39d4cee1d70b41acc66bdbf9f61866c1a" :answer-field/choices ["q-216707/selection/7367fab516955dd54af96711b41966c7736bf9707441b9f86dfcf5cc403621f9" "q-216707/selection/8b467f01a51816c0658f96908cfbd0f1c5f87ac31267447557c60ac7ceaf4c4c" "q-216707/selection/d8e1d49cc9e77a07eb7f20e14967bee39d4cee1d70b41acc66bdbf9f61866c1a" "q-216707/selection/5a4bf34638d1176ebc8dfcd7519153b34488e1cd25adc365463fe238e7295c8d" "q-216707/selection/17ea7fcb516e8446b35123ac1e562e545df786f303cd688e47ad7a0c048e7cd3"] :db/ensure [:answer-field/validate]} {:db/id "q-216707" :question/id #uuid "9a0045e8-554f-57ed-bbbe-c66196c7f29e" :question/math-academy-id "q-216707" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/ff773f71725cdd3c81f3100623f3b4cc86f3096a3d7f59d14b6943ffa5f11a2b.png)\n\nFind the $8$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{8}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/8}={e}^{k\\pi \\text{i}/4}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/9bbdc0b5be31f5c54fdf3390ec62d2130f528d2807305167f94a5612e39d67de.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/4}={e}^{5\\pi \\text{i}/4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-216707/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c"] :knowledge-point/questions ["q-216707"] :db/ensure [:knowledge-point/validate]}]
