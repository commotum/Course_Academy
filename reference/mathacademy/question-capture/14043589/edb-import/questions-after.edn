943-5d76-9d92-33fc5a5fb97a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/1984fa9bbbb1f33cfade89c69c4c840bbb1a8e5e7cdaf3fb2e967eabaad6fe95.png" :db/id #edb/ref 17592186320693} {:answer/id #uuid "0287ca94-edd5-5a01-8d23-b6659ed9284a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png" :db/id #edb/ref 17592186320694} {:answer/id #uuid "35340113-0305-530b-8510-9bafd507e52c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/be6ffed586679262e1145ceea6c5fdca5c8368b8fa14e5bc6188d6cd98712248.png" :db/id #edb/ref 17592186320695} {:answer/id #uuid "592374a7-5803-5afb-81b3-0ea4e2aa3162" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/922b0c9dea5f16e49b5c362644e03b5779fa0dd5142cd475a653286ccabb2647.png" :db/id #edb/ref 17592186320696} {:answer/id #uuid "8ddbf3b4-daf2-59e6-88db-4033e34fc353" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/0596dd32f7ce636cdaaaca82403c735dfe7c98aa04b491b4ec32e79fe0e91715.png" :db/id #edb/ref 17592186320697}] :answer-field/correct {:answer/id #uuid "0287ca94-edd5-5a01-8d23-b6659ed9284a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png" :db/id #edb/ref 17592186320694} :answer-field/id #uuid "fb161d84-260c-5f3c-bba5-67c32a9efce6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320692}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "22c9ee87-969e-5e6d-aac8-6ae444a9bfb9" :question/math-academy-id "q-162312" :question/problem "Which of the following diagrams shows all the $10$th roots of unity?" :question/worked-solution "Geometrically, the $10$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular decagon (regular $10$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png)"}] [{:db/id #edb/ref 17592186320698 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9621325e-7faa-5f3c-9a6a-fad13ac7dde1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{17\\pi \\text{i}/10}" :db/id #edb/ref 17592186320700} {:answer/id #uuid "429f01e4-125a-5f71-848a-abec0f55f3f6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9\\pi \\text{i}/5}" :db/id #edb/ref 17592186320701} {:answer/id #uuid "a6c07ca2-389e-56db-a33b-e9898ce72278" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{7\\pi \\text{i}/5}" :db/id #edb/ref 17592186320702} {:answer/id #uuid "bf66e0bc-98aa-5ec9-b672-3f1a64f477cd" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{19\\pi \\text{i}/10}" :db/id #edb/ref 17592186320703} {:answer/id #uuid "a5f24781-6f00-579f-87b9-786e331e2cec" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{8\\pi \\text{i}/5}" :db/id #edb/ref 17592186320704}] :answer-field/correct {:answer/id #uuid "a5f24781-6f00-579f-87b9-786e331e2cec" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{8\\pi \\text{i}/5}" :db/id #edb/ref 17592186320704} :answer-field/id #uuid "4ca4645d-60ef-5e38-ae37-86fceb858037" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320699}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "de9e4794-9949-5bd8-a5a2-86c3e001a9e0" :question/math-academy-id "q-216704" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/91f4aac82208a2801652c9112f58518e1abc89ed4313601a60f7c183b7757f70.png)\n\nFind the $10$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{10}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/10}={e}^{k\\pi \\text{i}/5}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/d0fc6866d4bb06ec6cbf20bb719faf722ec3c1efe3fba03e413f51dc1c827e71.png)\n\n \n\nSo, the required root corresponds to $k=8.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{8}={e}^{(8)\\pi \\text{i}/5}={e}^{8\\pi \\text{i}/5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320705 :knowledge-point/_questions [{:knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f794303d-27cd-5f1c-9e7e-08394cec8b5c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9\\pi \\text{i}/8}" :db/id #edb/ref 17592186320707} {:answer/id #uuid "e8d34052-d163-53de-8e59-070ae652aba5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/2}" :db/id #edb/ref 17592186320708} {:answer/id #uuid "d656e453-9176-569c-a2b4-09025ce3b81b" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186320709} {:answer/id #uuid "48719fef-d1c2-575c-9d75-97edb0504a48" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/8}" :db/id #edb/ref 17592186320710} {:answer/id #uuid "61c3ec69-a7c3-55ea-8d09-d3f9c846e47f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186320711}] :answer-field/correct {:answer/id #uuid "61c3ec69-a7c3-55ea-8d09-d3f9c846e47f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186320711} :answer-field/id #uuid "3e6cb4cd-8c38-592a-afb1-fa8dfb9fc820" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320706}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9a0045e8-554f-57ed-bbbe-c66196c7f29e" :question/math-academy-id "q-216707" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/ff773f71725cdd3c81f3100623f3b4cc86f3096a3d7f59d14b6943ffa5f11a2b.png)\n\nFind the $8$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{8}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/8}={e}^{k\\pi \\text{i}/4}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14043589/assets/9bbdc0b5be31f5c54fdf3390ec62d2130f528d2807305167f94a5612e39d67de.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/4}={e}^{5\\pi \\text{i}/4}\\end{aligned}\n$$"}]}
