/mathacademy/question-capture/14007409/assets/c2d437d87e38ef73849987c358bc00fd589535c5045b193cdfa54ecc9601f37e.png" :db/id #edb/ref 17592186288160} :answer-field/id #uuid "a3bafeb8-1f56-5835-beb3-f6b0d0b5591f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288158}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e46ce850-a38a-5466-abbe-3315ac65e081" :question/math-academy-id "q-167626" :question/problem "Which of the following is the graph of $y={7}^{x+2}-3?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- First, we plot the curve $y={7}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007409/assets/4b2274f6e19ea02b6ebee1d9ac590c8186722be946f1d390ae4d27b2898d883e.png)\n\n- To plot $y={7}^{x+2},$ we shift the graph of $y={7}^{x}$ horizontally by $2$ units to the left. The $y$-intercept moves from $(0,1)$ to $(-2,1)$ but the horizontal asymptote stays at $y=0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007409/assets/d900437ffd3ba0da1c6c25cbcff892e76929abe839fc8a49abea555c8163714f.png)\n\n- To plot the graph $y={7}^{x+2}-3,$ we shift the graph of $y={7}^{x+2}$ vertically by $3$ units down. The point $(-2,1)$ moves to $(-2,-2)$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007409/assets/3c8f16780a5d9e3b655b9c7706fc664e9ef944d728d070c9cca886ac05b34504.png)"}] [{:db/id #edb/ref 17592186217365 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82118ef1-5b29-501b-a6db-0e98eaf75aee" :answer/type {:db/ident :answer.type/image} :answer/val