#{[{:db/id #edb/ref 17592186262854 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec31137e-54bd-5fae-a80a-ec5cc7564743" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186262856} {:answer/id #uuid "5ab819f1-b137-5387-ba0e-b180c9c1d7ae" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=22,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186262857} {:answer/id #uuid "a5d13c9a-48d1-53f6-9cae-598b61d7a27a" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186262858} {:answer/id #uuid "793b92be-55a7-56d9-b512-1e28798469d1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=22,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186262859} {:answer/id #uuid "6f1c338d-65fc-5d38-a8df-44f75f4fd14b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186262860}] :answer-field/correct {:answer/id #uuid "ec31137e-54bd-5fae-a80a-ec5cc7564743" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186262856} :answer-field/id #uuid "835d29e0-8e70-5cbf-a186-51ba6e696c1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262855}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed379096-4def-51e1-8cd6-e568b470e309" :question/math-academy-id "q-113245" :question/problem "The equation ${x}^{2}-6x+34=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x+34 & =0 \\\\ {x}^{2}-6x & =-34\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x & =-34 \\\\ {x}^{2}-2\\cdot 3x+{3}^{2}-{3}^{2} & =-34 \\\\ (x-3)^{2}-9 & =-34 \\\\ (x-3)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-3,\\,q=-25,$ and $p+q=-28.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-25 \\\\ x-3 & =\\pm \\sqrt{-25} \\\\ x-3 & =\\pm 5\\,\\text{i} \\\\ x & =3\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+5\\,\\text{i}$ and $x=3-5\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186088023 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4" :knowledge-point/title "Rearranging and Solving a Quadratic Equation With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36625a48-a327-51e3-910c-fac75f123cfa" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186232570}] :answer-field/correct {:answer/id #uuid "36625a48-a327-51e3-910c-fac75f123cfa" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186232570} :answer-field/id #uuid "a75a02b0-ed86-5d0e-8052-8b6330909217" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085100} {:answer-field/choices [{:answer/id #uuid "958fd4cd-016f-52ed-8d58-fea14da30a8d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186232569}] :answer-field/correct {:answer/id #uuid "958fd4cd-016f-52ed-8d58-fea14da30a8d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186232569} :answer-field/id #uuid "b8ddb37b-6461-56bb-bc6b-6f47084ee93a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085101}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d52817ea-9afc-583e-9e67-80c53cee058f" :question/math-academy-id "q-218478" :question/problem "Solve the equation $x^{2} - 2x =-50$.$x =$\n{{field-1}}\n$±$\n{{field-2}} $\\textrm{i}$" :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n{x}^{2}-2x+50=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=1,\\,b=-2,$ and $c=50.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(50)}}{2(1)} \\\\  & =\\frac{2\\pm \\sqrt{4-200}}{2} \\\\  & =\\frac{2\\pm \\sqrt{-196}}{2} \\\\  & =\\frac{2\\pm 14\\,\\text{i}}{2} \\\\  & =1\\pm 7\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+7\\,\\text{i}$ and $x=1-7\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186262861 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4" :knowledge-point/title "Rearranging and Solving a Quadratic Equation With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031f7ca8-2c26-5581-9afb-9ed0673e965b" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5\\pm \\text{i}" :db/id #edb/ref 17592186262863} {:answer/id #uuid "2e3c1544-edac-5f01-8d3d-334bac5836d8" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186262864} {:answer/id #uuid "227669a1-3c8b-53a7-8c68-6a4383916d25" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\pm \\text{i}" :db/id #edb/ref 17592186262865} {:answer/id #uuid "14bb8066-da90-5659-827f-2c9a387abc6e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186262866} {:answer/id #uuid "5cf78ee5-0c7a-5ec3-88d6-6fb6fee978e0" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186262867}] :answer-field/correct {:answer/id #uuid "14bb8066-da90-5659-827f-2c9a387abc6e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186262866} :answer-field/id #uuid "d9f76d11-1783-5e91-ab47-b68a7c26c998" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262862}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "73389b95-3445-5532-a631-3954ade47917" :question/math-academy-id "q-66279" :question/problem "Solve the equation $\\,{x}^{2}+5=-2x.$" :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n{x}^{2}+2x+5=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=1,\\,b=2,$ and $c=5.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-2\\pm \\sqrt{{2}^{2}-4(1)(5)}}{2(1)} \\\\  & =\\frac{-2\\pm \\sqrt{4-20}}{2} \\\\  & =\\frac{-2\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{-2\\pm 4\\,\\text{i}}{2} \\\\  & =-1\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-1+2\\,\\text{i}$ and $x=-1-2\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186262868 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abcca7a5-ad85-5c0a-a260-ff19bd9ad4e4" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-108,\\,x=10\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186262870} {:answer/id #uuid "7ea322bd-0b73-5606-8256-43216ddc26d4" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-108,\\,x=-8\\pm 10\\,\\text{i}" :db/id #edb/ref 17592186262871} {:answer/id #uuid "ef877427-20e1-5da3-8f68-7602e66b9e88" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-92,\\,x=-8\\pm 10\\,\\text{i}" :db/id #edb/ref 17592186262872} {:answer/id #uuid "d04c5f56-6884-54db-b2d5-48253abb7029" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-92,\\,x=10\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186262873} {:answer/id #uuid "c82e3d79-83fb-5dc0-a4d6-69fe641c382a" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-92,\\,x=-8\\pm 8\\,\\text{i}" :db/id #edb/ref 17592186262874}] :answer-field/correct {:answer/id #uuid "ef877427-20e1-5da3-8f68-7602e66b9e88" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-92,\\,x=-8\\pm 10\\,\\text{i}" :db/id #edb/ref 17592186262872} :answer-field/id #uuid "107fc32d-7a9a-5596-b677-da1106e9c1fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262869}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f70143e0-3f9c-51d2-946d-0c2579968816" :question/math-academy-id "q-66435" :question/problem "The equation ${x}^{2}+16x+164=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+16x+164 & =0 \\\\ {x}^{2}+16x & =-164\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+16x & =-164 \\\\ {x}^{2}+2\\cdot 8x+{8}^{2}-{8}^{2} & =-164 \\\\ (x+8)^{2}-64 & =-164 \\\\ (x+8)^{2} & =-100\\end{aligned}\n$$\n\nTherefore, $p=8,\\,q=-100,$ and $p+q=-92.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x+8)^{2} & =-100 \\\\ x+8 & =\\pm \\sqrt{-100} \\\\ x+8 & =\\pm 10\\,\\text{i} \\\\ x & =-8\\pm 10\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-8+10\\,\\text{i}$ and $x=-8-10\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186262875 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8d6de65-4859-5f83-89f1-dba6646abbd6" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186262877} {:answer/id #uuid "4e329fcf-7d2c-5c43-83e2-757be955a47d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2\\pm 7\\,\\text{i}" :db/id #edb/ref 17592186262878} {:answer/id #uuid "44778d4c-5910-5968-a817-c753aee3d315" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\pm 7\\,\\text{i}" :db/id #edb/ref 17592186262879} {:answer/id #uuid "f42a2d13-7b45-5781-9afb-e2e8ebdb884a" :answer/type {:db/ident :answer.type/math} :answer/value "x=4\\pm 7\\,\\text{i}" :db/id #edb/ref 17592186262880} {:answer/id #uuid "d79c00dd-0063-5d69-b2c8-c0198ba16625" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2\\pm 2\\,\\text{i}" :db/id #edb/ref 17592186262881}] :answer-field/correct {:answer/id #uuid "44778d4c-5910-5968-a817-c753aee3d315" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\pm 7\\,\\text{i}" :db/id #edb/ref 17592186262879} :answer-field/id #uuid "d5c4c9e3-6cca-59a0-a8c9-93fef2194a06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262876}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fdebaefd-71be-50d5-afa2-969c275d27ab" :question/math-academy-id "q-66791" :question/problem "What are the solutions of the equation $(x-2)^{2}=-49?$" :question/worked-solution "The left-hand side is a perfect square. Therefore, we can solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =-49 \\\\ x-2 & =\\pm \\sqrt{-49} \\\\ x-2 & =\\pm 7\\,\\text{i} \\\\ x & =2\\pm 7\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=2+7\\,\\text{i}$ and $x=2-7\\,\\text{i}.$"}]}
