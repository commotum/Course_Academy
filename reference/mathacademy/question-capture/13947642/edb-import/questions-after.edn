#{[{:db/id #edb/ref 17592186255465 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "409dd20c-e965-5aa4-a712-23f93cb4842f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186255467} {:answer/id #uuid "39d11392-10cc-5842-b99d-ba3d5f4f5a46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186255468} {:answer/id #uuid "de68dc4b-0403-5b70-8961-15a16b431527" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186255469} {:answer/id #uuid "afd1017c-05e7-5cbd-b176-ba57bfa386af" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186255470} {:answer/id #uuid "74a9884f-84b6-50b4-82b3-48a2480ee94d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186255471}] :answer-field/correct {:answer/id #uuid "409dd20c-e965-5aa4-a712-23f93cb4842f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186255467} :answer-field/id #uuid "b6fff307-631f-55d5-a0e6-3b03181d3b16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255466}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b304054-fb49-563f-ad11-de767d89d89b" :question/math-academy-id "q-288817" :question/problem "Consider the quadratic equation\n\n$$\n5{x}^{2}+24x+15=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=5,\\,b=24,\\,c=15.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{15}{5}=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255472 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c70e1173-a89f-5d18-9a13-ca9b6dfa78c9" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,395" :db/id #edb/ref 17592186255474} {:answer/id #uuid "20046d4e-5836-5fae-b719-fd9691d34151" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186255475} {:answer/id #uuid "390abde6-1d1e-547d-b8bf-eb4b212eba66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186255476} {:answer/id #uuid "e612dcc1-a5a7-5eb7-97a8-cd782c2c87ea" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186255477} {:answer/id #uuid "52718b2c-82f8-5ba5-9b8a-5d80011ed86c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186255478}] :answer-field/correct {:answer/id #uuid "e612dcc1-a5a7-5eb7-97a8-cd782c2c87ea" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186255477} :answer-field/id #uuid "11eda378-9d35-5206-8052-158756b70caf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255473}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186255479 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f42f8152-f037-57bd-9198-0033616e91d6" :answer/type {:db/ident :answer.type/math} :answer/value "5x^2-40x-60" :db/id #edb/ref 17592186255481}] :answer-field/correct {:answer/id #uuid "f42f8152-f037-57bd-9198-0033616e91d6" :answer/type {:db/ident :answer.type/math} :answer/value "5x^2-40x-60" :db/id #edb/ref 17592186255481} :answer-field/id #uuid "63a66eea-a4ee-51f5-aef8-71917a950acb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186255480}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f19f761f-113c-5a3e-a541-96b268d77a65" :question/math-academy-id "q-288829" :question/problem "The quadratic coefficient of a particular quadratic equation equals $5.$ The sum of the solutions equals $8,$ and the product of the solutions equals $-12.$ Find the equation.\n\nThe equation is\n{{field-1}}  \n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $5.$ Therefore, we have\n\n$$\na=5.\n$$\n\n- We're told that the sum of the roots equals $8.$ Therefore, we have\n\n$$\n\\begin{aligned}8 & =-\\frac{b}{a} \\\\ 8 & =-\\frac{b}{5} \\\\ -40 & =b \\\\ b & =-40.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $-12.$ Therefore, we have\n\n$$\n\\begin{aligned}-12 & =\\frac{c}{a} \\\\ -12 & =\\frac{c}{5} \\\\ -60 & =c \\\\ c & =-60.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=5,\\,b=-40,\\,c=-60\n$$\n\nand the equation is\n\n$$\n5{x}^{2}-40x-60=0.\n$$"}] [{:db/id #edb/ref 17592186255482 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a391b3-9624-5674-b6f2-0f092c94c644" :answer/type {:db/ident :answer.type/math} :answer/value "6x^2+30x-42" :db/id #edb/ref 17592186255484} {:answer/id #uuid "7d644c43-4a47-5527-91ba-c5b4d8dd2539" :answer/type {:db/ident :answer.type/math} :answer/value "6x^2-30x-42" :db/id #edb/ref 17592186255485}] :answer-field/correct {:answer/id #uuid "68a391b3-9624-5674-b6f2-0f092c94c644" :answer/type {:db/ident :answer.type/math} :answer/value "6x^2+30x-42" :db/id #edb/ref 17592186255484} :answer-field/id #uuid "63fa0792-d53e-54a2-bc52-75f6888dd2ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186255483}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "383bb39e-8419-59c8-b054-4e4ff33cd3cb" :question/math-academy-id "q-288830" :question/problem "The quadratic coefficient of a particular quadratic equation equals $6.$ The sum of the solutions equals $-5,$ and the product of the solutions equals $-7.$ Find the equation.\n\nThe equation is\n{{field-1}}  \n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $6.$ Therefore, we have\n\n$$\na=6.\n$$\n\n- We're told that the sum of the roots equals $-5.$ Therefore, we have\n\n$$\n\\begin{aligned}-5 & =-\\frac{b}{a} \\\\ -5 & =-\\frac{b}{6} \\\\ 30 & =b \\\\ b & =30.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $-7.$ Therefore, we have\n\n$$\n\\begin{aligned}-7 & =\\frac{c}{a} \\\\ -7 & =\\frac{c}{6} \\\\ -42 & =c \\\\ c & =-42.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=6,\\,b=30,\\,c=-42\n$$\n\nand the equation is\n\n$$\n6{x}^{2}+30x-42=0.\n$$"}] [{:db/id #edb/ref 17592186255486 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87e54de7-a16b-521a-bac4-29849153cca5" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+8x+20" :db/id #edb/ref 17592186255488}] :answer-field/correct {:answer/id #uuid "87e54de7-a16b-521a-bac4-29849153cca5" :answer/type {:db/ident :answer.type/math} :answer/value "x^2+8x+20" :db/id #edb/ref 17592186255488} :answer-field/id #uuid "b6b59641-f342-5a49-a30a-58aecb8dc116" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186255487}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "788ba504-16c1-5c01-835a-cdf05791424c" :question/math-academy-id "q-288851" :question/problem "The quadratic coefficient of a particular quadratic equation equals $1.$ The sum of the solutions equals $-8,$ and the product of the solutions equals $20.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $1.$ Therefore, we have\n\n$$\na=1.\n$$\n\n- We're told that the sum of the roots equals $-8.$ Therefore, we have\n\n$$\n\\begin{aligned}-8 & =-\\frac{b}{a} \\\\ -8 & =-\\frac{b}{1} \\\\ 8 & =b \\\\ b & =8.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $20.$ Therefore, we have\n\n$$\n\\begin{aligned}20 & =\\frac{c}{a} \\\\ 20 & =\\frac{c}{1} \\\\ c & =20.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=1,\\,b=8,\\,c=20\n$$\n\nand the equation is\n\n$$\n{x}^{2}+8x+20=0.\n$$"}]}
