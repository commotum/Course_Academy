 "020409f2-54c7-50d1-ada6-43bb7ac177bf" :answer/type {:db/ident :answer.type/math} :answer/value "(y+4{)}^{2}-3" :db/id #edb/ref 17592186242512} {:answer/id #uuid "d9fefd5a-c18f-586b-a156-2e8fb94f5f78" :answer/type {:db/ident :answer.type/math} :answer/value "(y-6{)}^{2}-3" :db/id #edb/ref 17592186242513}] :answer-field/correct {:answer/id #uuid "52b367c0-807c-5341-813b-0685dfd75ec9" :answer/type {:db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186242511} :answer-field/id #uuid "a709e6f9-cc72-5a96-acb1-2ca3ec18b120" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242508}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20593a27-71f8-5108-90d4-e7c938d6e45e" :question/is-example false :question/math-academy-id "q-141513" :question/problem "Rewrite the expression $({y}^{2}+12y+{6}^{2})-3$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}+2ay+{a}^{2}=(y+a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}+12y+{6}^{2} & = \\\\ {y}^{2}+2\\cdot 6y+{6}^{2} & = \\\\ (y+6{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}+12y+{6}^{2})-3 & = \\\\ (y+6{)}^{2}-3 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242514 :knowledge-point/_questions [{:knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0435c05e-0d6a-51ab-982c-6703bd59c2eb" :answer/type {:db/ident :answer.type/math} :answer/value "p=6,\\,q=8" :db/id #edb/ref 17592186242516} {:answer/id #uuid "7eef407c-652d-5624-a373-34fed6ea27f1" :answer/type {:db/ident :answer.type/math} :answer/value "p=3,\\,q=-5" :db/id #edb/ref 17592186242517} {:answer/id #uuid "4208d807-412e-5ff1-8384-2aa85c4a62f9" :answer/type {:db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186242518} {:answer/id #uuid "f9a26d34-0c08-54a7-99ef-f47524fcf0ff" :answer/type {:db/ident :answer.type/math} :answer/value "p=6,\\,q=7" :db/id #edb/ref 17592186242519} {:answer/id #uuid "d6d34865-298a-5bef-85e1-b6c534c5a762" :answer/type {:db/ident :answer.type/math} :answer/value "p=3,\\,q=-4" :db/id #edb/ref 17592186242520}] :answer-field/correct {:answer/id #uuid "4208d807-412e-5ff1-8384-2aa85c4a62f9" :answer/type {:db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186242518} :answer-field/id #uuid "ade12590-674f-54bc-af50-2cedd6d18d0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186242515}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" :question/is-example false :question/math-academy-id "q-141539" :question/problem "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$"}] [{:db/id #edb/ref 17592186242521 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2050124-e5a3-54e0-a24d