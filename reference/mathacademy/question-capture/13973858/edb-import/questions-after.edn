#{[{:db/id #edb/ref 17592186088034 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab9ade8d-2886-5b46-8470-a47de981d256" :answer/type {:db/ident :answer.type/math} :answer/value "21m/s^{2}" :db/id #edb/ref 17592186085149} {:answer/id #uuid "b1839605-f6dd-5e07-aebe-592c8042574a" :answer/type {:db/ident :answer.type/math} :answer/value "12m/s^{2}" :db/id #edb/ref 17592186085150} {:answer/id #uuid "c1e45771-d64c-5b8b-ae1d-94ac3f4d9089" :answer/type {:db/ident :answer.type/math} :answer/value "18m/s^{2}" :db/id #edb/ref 17592186085151} {:answer/id #uuid "d70b7348-beb6-5315-8bd2-ad39c6503a23" :answer/type {:db/ident :answer.type/math} :answer/value "14m/s^{2}" :db/id #edb/ref 17592186085152} {:answer/id #uuid "2c46a440-f979-5811-882e-de99b009963e" :answer/type {:db/ident :answer.type/math} :answer/value "24m/s^{2}" :db/id #edb/ref 17592186085153}] :answer-field/correct {:answer/id #uuid "c1e45771-d64c-5b8b-ae1d-94ac3f4d9089" :answer/type {:db/ident :answer.type/math} :answer/value "18m/s^{2}" :db/id #edb/ref 17592186085151} :answer-field/id #uuid "1d039e2c-ee95-54a4-b86e-bdc13a6be52e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085148}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e4551db6-cbed-5a0b-aa5c-4809ad316023" :question/math-academy-id "q-2351" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=2{t}^{3}-3{t}^{2}+2t$, where $t$ is measured in seconds.  Find the particle's acceleration at $t=2$ seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3{t}^{2}+2t) \\\\  & =6{t}^{2}-6t+2\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-6t+2) \\\\  & =12t-6\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=2$, we substitute this into the above:\n\n$$\n\\begin{aligned}a(2) & =12(2)-6 \\\\  & =24-6 \\\\  & =18\\,{\\text{m/s}}^{2}\\end{aligned}\n$$\n\nTherefore, the acceleration when $t=2$ seconds is $18\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186277547 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a1e7756-6302-5083-b4d2-426d7cc4ec74" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277549}] :answer-field/correct {:answer/id #uuid "9a1e7756-6302-5083-b4d2-426d7cc4ec74" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277549} :answer-field/id #uuid "e8350234-5877-51a6-9b51-e83ed572de17" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186277548}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87f98f5f-15df-53f7-978f-c2984e68b9a9" :question/math-academy-id "q-336423" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ is given by $v(t)=2{t}^{4}-3{t}^{2}+t,$ where $t$ is measured in seconds. Calculate the acceleration of the particle at $t=1$ second.\n\n$a(1)=$\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}-3{t}^{2}+t) \\\\  & =8{t}^{3}-6t+1\\end{aligned}\n$$\n\nTo calculate the acceleration when $t=1$ second, we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =8(1)^{3}-6(1)+1 \\\\  & =8-6+1 \\\\  & =3\\,{\\text{m/s}}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277550 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1ef4041-9150-5c6d-bc09-55dd8fa6da63" :answer/type {:db/ident :answer.type/math} :answer/value "6-2t" :db/id #edb/ref 17592186277552}] :answer-field/correct {:answer/id #uuid "b1ef4041-9150-5c6d-bc09-55dd8fa6da63" :answer/type {:db/ident :answer.type/math} :answer/value "6-2t" :db/id #edb/ref 17592186277552} :answer-field/id #uuid "5f0a3411-ea46-5781-9606-644868e6a7e7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186277551}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a3a2898-11c1-5cbc-bf20-323ffecc5307" :question/math-academy-id "q-336452" :question/problem "The displacement $s$ of a particle moving in a straight line is given by $s(t)=5+3{t}^{2}-\\frac{1}{3}{t}^{3}.$ Find the particle's acceleration at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(5+3{t}^{2}-\\frac{1}{3}{t}^{3}) \\\\  & =6t-{t}^{2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6t-{t}^{2}) \\\\  & =6-2t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277553 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b1b6bcd-a039-5c6c-ab0a-fa86a245c524" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=12(t+1)" :db/id #edb/ref 17592186277555} {:answer/id #uuid "e7f00cb2-4d83-543b-baee-f1781e4a6b7f" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=6t(t+2)" :db/id #edb/ref 17592186277556} {:answer/id #uuid "5d053519-cb38-560f-a3a4-5ff22e1f4721" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=12(t-1)" :db/id #edb/ref 17592186277557} {:answer/id #uuid "ccd6b8c2-1cc5-5268-8371-b7c34faa5f25" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=12(2-t)" :db/id #edb/ref 17592186277558} {:answer/id #uuid "0c4b969b-8ba8-5b0f-a532-2f759efdb626" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=6t(t-2)" :db/id #edb/ref 17592186277559}] :answer-field/correct {:answer/id #uuid "5d053519-cb38-560f-a3a4-5ff22e1f4721" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=12(t-1)" :db/id #edb/ref 17592186277557} :answer-field/id #uuid "7bd0e28b-1380-5c37-9e0f-dbbcfcf0cc6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277554}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4257f36f-ebcb-50cf-868c-20d50443f5c8" :question/math-academy-id "q-7101" :question/problem "The displacement $s$ of a particle moving in a straight line is given by $s(t)=3-6{t}^{2}+2{t}^{3}.$ Find the particle's acceleration at time $t.$" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3-6{t}^{2}+2{t}^{3}) \\\\  & =-12t+6{t}^{2}\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-12t+6{t}^{2}) \\\\  & =-12+12t \\\\  & =12(t-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277560 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89c81694-fc92-5ba0-a707-87b71f50584c" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186277562} {:answer/id #uuid "263bec50-6319-53dd-a5fc-1db90683cc61" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1-\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186277563} {:answer/id #uuid "ff91976c-3c28-54b9-8bfa-416252d57670" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186277564} {:answer/id #uuid "946bef80-0239-5d74-bc6c-928becb047f6" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=t+\\frac{1}{t}" :db/id #edb/ref 17592186277565} {:answer/id #uuid "e1446271-c19a-57b5-b95b-c2298df6995d" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=t-\\frac{1}{t}" :db/id #edb/ref 17592186277566}] :answer-field/correct {:answer/id #uuid "89c81694-fc92-5ba0-a707-87b71f50584c" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186277562} :answer-field/id #uuid "069577bb-d5ec-5048-95bc-e7d17c304e9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277561}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2e5248e4-d160-51d4-9bba-1d38c3c5aabb" :question/math-academy-id "q-7186" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=\\frac{{t}^{2}-1}{t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}-1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-{t}^{-1}) \\\\  & =1-(-{t}^{-2}) \\\\  & =1+\\frac{1}{{t}^{2}}\\end{aligned}\n$$"}]}
