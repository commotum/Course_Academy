#{[{:db/id #edb/ref 17592186283031 :knowledge-point/_questions [{:knowledge-point/id #uuid "97786302-e865-5581-b08e-8da7c6b7a01b" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cc9b57c-0b6f-54e4-a702-1966cf3b0d46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186283033} {:answer/id #uuid "0257dd7b-de95-54f3-b086-bcfed0769fab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186283034}] :answer-field/correct {:answer/id #uuid "0257dd7b-de95-54f3-b086-bcfed0769fab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186283034} :answer-field/id #uuid "436a48dc-3eba-53e9-84be-c5a8731051ca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283032}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b299b143-acb8-5d63-8591-a6ec0fe6803e" :question/math-academy-id "q-328248" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{tan}⁡(6x-\\frac{\\pi }{4})=1\n$$\n\n  \n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +\\frac{n\\pi }{6},\n$$\n\n \nwhere $n$ is any integer. Find a possible value of $a$ in the range $[0,\\frac{1}{6}).$\n\n$a=$\n{{field-1}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}6x-\\frac{\\pi }{4} & =\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nSolving the above equation for $x,$ we get\n\n$$\n\\begin{aligned}6x & =\\frac{\\pi }{4}+\\frac{\\pi }{4}+n\\pi  \\\\ 6x & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{6}.\\end{aligned}\n$$\n\nTherefore, we have that $a=\\frac{1}{12}.$"}] [{:db/id #edb/ref 17592186283035 :knowledge-point/_questions [{:knowledge-point/id #uuid "97786302-e865-5581-b08e-8da7c6b7a01b" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4e4be6a-a579-5f2e-8b6a-aff3fd75df14" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186283037}] :answer-field/correct {:answer/id #uuid "d4e4be6a-a579-5f2e-8b6a-aff3fd75df14" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186283037} :answer-field/id #uuid "28d9372b-0053-501f-9710-6dd82f8b2f6b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283036}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c1397388-67bb-5325-b8c4-b686c09932f6" :question/math-academy-id "q-328419" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{tan}⁡(5x+{75}^{∘})=-1\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx={a}^{∘}+n\\cdot {36}^{∘},\n$$\n\n \nwhere $n$ is any integer. Find a possible value $a$ in the range $[{0}^{∘},{36}^{∘}).$\n\n$a=$\n{{field-1}}${}^{∘}$" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}5x+{75}^{∘} & ={135}^{∘}+n\\cdot {180}^{∘}.\\end{aligned}\n$$\n\nSolving the above equation for $x,$ we get\n\n$$\n\\begin{aligned}5x & ={135}^{∘}-{75}^{∘}+n\\cdot {180}^{∘} \\\\ 5x & ={60}^{∘}+n\\cdot {180}^{∘} \\\\ x & ={12}^{∘}+n\\cdot {36}^{∘}.\\end{aligned}\n$$\n\nTherefore, we have that $a=12.$"}] [{:db/id #edb/ref 17592186283038 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3248fd2a-e5c5-5731-83bc-a2eff1642e84" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186283040} {:answer/id #uuid "8c196d50-6ca9-5ca8-9d68-a6acc86ce048" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186283041}] :answer-field/correct {:answer/id #uuid "8c196d50-6ca9-5ca8-9d68-a6acc86ce048" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186283041} :answer-field/id #uuid "1bc83404-e359-5f03-9cbf-f1e093c4fb78" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283039}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ec1114d9-7c4c-50b8-8bb4-6777fec618d4" :question/math-academy-id "q-329515" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{csc}⁡(6x+{12}^{∘})=\\frac{2}{\\sqrt{3}}\n$$\n\n  \n\nThe general solution of this equation is\n\n$$\nx={8}^{∘}+{60}^{∘}\\cdot n,\\,x=a+{60}^{∘}\\cdot n,\n$$\n\nwhere $n$ is any integer. Find a possible value of $a$ in the range $[{0}^{∘},{60}^{∘}).$\n\n$a=$\n{{field-1}}${}^{∘}$" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡(6x+{12}^{∘})=\\frac{\\sqrt{3}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n6x+{12}^{∘}={60}^{∘}+{360}^{∘}\\cdot n,\\,6x+{12}^{∘}={120}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}6x & ={60}^{∘}-{12}^{∘}+{360}^{∘}\\cdot n, & \\,6x & ={120}^{∘}-{12}^{∘}+{360}^{∘}\\cdot n \\\\ 6x & ={48}^{∘}+{360}^{∘}\\cdot n, & \\,6x & ={108}^{∘}+{360}^{∘}\\cdot n \\\\ x & ={8}^{∘}+{60}^{∘}\\cdot n, & \\,x & ={18}^{∘}+{60}^{∘}\\cdot n.\\end{aligned}\n$$\n\nTherefore, we have that $a={18}^{∘}.$"}] [{:db/id #edb/ref 17592186283042 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d8bd760-e319-5892-bb5f-0cfda059f7cf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{6}" :db/id #edb/ref 17592186283044}] :answer-field/correct {:answer/id #uuid "6d8bd760-e319-5892-bb5f-0cfda059f7cf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{6}" :db/id #edb/ref 17592186283044} :answer-field/id #uuid "60744530-e730-5e56-9993-dd86f780c4d3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283043}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d8b0b2b8-5438-546e-b2de-f2346b0e6954" :question/math-academy-id "q-329544" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{csc}⁡(\\frac{x}{2}+\\frac{\\pi }{4})=-\\frac{2}{\\sqrt{3}}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +4\\pi n,\\,x=-\\frac{7\\pi }{6}+4\\pi n,\n$$\n\nwhere $n$ is any integer. Find a possible value of $a$ in the range $(-4,0].$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡(\\frac{x}{2}+\\frac{\\pi }{4})=-\\frac{\\sqrt{3}}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n\\frac{x}{2}+\\frac{\\pi }{4}=-\\frac{2\\pi }{3}+2\\pi n,\\,\\frac{x}{2}+\\frac{\\pi }{4}=-\\frac{\\pi }{3}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{2} & =-\\frac{2\\pi }{3}-\\frac{\\pi }{4}+2\\pi n, & \\, & \\frac{x}{2}=-\\frac{\\pi }{3}-\\frac{\\pi }{4}+2\\pi n \\\\ \\frac{x}{2} & =-\\frac{11\\pi }{12}+2\\pi n, & \\, & \\frac{x}{2}=-\\frac{7\\pi }{12}+2\\pi n \\\\ x & =-\\frac{11\\pi }{6}+4\\pi n, & \\, & x=-\\frac{7\\pi }{6}+4\\pi n.\\end{aligned}\n$$\n\nSo, we have that $a=-\\frac{11}{6}.$"}] [{:db/id #edb/ref 17592186283045 :knowledge-point/_questions [{:knowledge-point/id #uuid "a180dc90-c6b9-577e-9eef-ed60ecafe4e5" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4693ddc-c59e-5542-8b49-730f23cf3cbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186283047}] :answer-field/correct {:answer/id #uuid "c4693ddc-c59e-5542-8b49-730f23cf3cbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186283047} :answer-field/id #uuid "32e5d7e6-5d93-558b-806f-d420d8d035b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283046}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "36c312ea-940e-595d-abc0-62ff35142c5a" :question/math-academy-id "q-331964" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cos}⁡(\\frac{3x}{2})=\\frac{\\sqrt{2}}{2}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=\\frac{\\pi }{6}+\\frac{4\\pi n}{3},\\,x=a\\pi +\\frac{4\\pi n}{3},\n$$\n\nwhere $n$ is any integer. Find a possible value of $a$ in the interval $[0,\\frac{4}{3}).$\n\n$a=$\n{{field-1}}" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{3x}{2} & =\\frac{\\pi }{4}+2\\pi n, & \\, & \\, & \\frac{3x}{2} & =\\frac{7\\pi }{4}+2\\pi n.\\end{aligned}\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}\\frac{3x}{2} & =\\frac{\\pi }{4}+2\\pi n & \\, & \\, & \\frac{3x}{2} & =\\frac{7\\pi }{4}+2\\pi n \\\\ x & =\\frac{\\pi }{6}+\\frac{4\\pi n}{3} & \\, & \\, & x & =\\frac{7\\pi }{6}+\\frac{4\\pi n}{3}\\end{aligned}\n$$\n\nTherefore, we have that $a=\\frac{7}{6}.$"}]}
