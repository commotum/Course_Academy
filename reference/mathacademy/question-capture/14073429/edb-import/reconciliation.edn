ure" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/activity-metadata.json" "file_sha256" "9042a3bb57b43217cf1bb0cf5cc16f1106958207637db566b7d3aa09aea4bef8" "basis" 1343 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/edb-import/verification.json"} {"question" "q-16196" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "ec9150058e1d0d66afb3809401644156d5239c7298e4d287d0a47f4f3ddf4705" "basis" 1343 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/edb-import/verification.json"} {"question" "q-16196" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/2733af9666ca54ca578eea56a5f05d5d8245df01f7aa1312e70610ae8a7beee7.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "ec9150058e1d0d66afb3809401644156d5239c7298e4d287d0a47f4f3ddf4705" "basis" 1343 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/edb-import/verification.json"} {"question" "q-16196" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/assets/9e5fb2564eb1f5adb380d70e1a86925fa377f10cc653d98d73ba64bfb03de197.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14038739/state.json" "file_sha256" "ec9150058e1d0d66afb3809401644156d5239c7298e4