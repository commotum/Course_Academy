a_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/state.json" "file_sha256" "e77c2eccdad30bf6f75e700e47e2a32105d11e04ad02fe7ef27fc400bbcf2762"} {"question" "q-276749" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/activity-metadata.json" "file_sha256" "872feb33a983cfba5d631e562226ad4131bcaa8306eeb901dd5477b03941598e"} {"question" "q-276749" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/state.json" "file_sha256" "e77c2eccdad30bf6f75e700e47e2a32105d11e04ad02fe7ef27fc400bbcf2762"} {"question" "q-276749" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/state.json" "file_sha256" "e77c2eccdad30bf6f75e700e47e2a32105d11e04ad02fe7ef27fc400bbcf2762"} {"question" "q-276749" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/state.json" "file_sha256" "e77c2eccdad30bf6f75e700e47e2a32105d11e04ad02fe7ef27fc400bbcf2762"} {"question" "q-276749" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math ">"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/state.json" "file_sha256" "e77c2eccdad30bf6f75e700e47e2a32105d11e04ad02fe7ef27fc400bbcf2762"} {"question" "q-276749" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathaca