#{[{:db/id #edb/ref 17592186318261 :knowledge-point/_questions [{:knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15217680-0e3b-5f25-b939-51cd7a3e7376" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{3}{5}" :db/id #edb/ref 17592186318263} {:answer/id #uuid "5e2f3268-eae6-5985-baeb-2101fd1ca776" :answer/type {:db/ident :answer.type/math} :answer/value "0<x<\\frac{3}{5}" :db/id #edb/ref 17592186318264} {:answer/id #uuid "2edcb5fe-c1b1-5b7f-bda4-cd201ccc1a58" :answer/type {:db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186318265} {:answer/id #uuid "47b6d571-2077-5ad7-85ad-a4c9a4cf8e3f" :answer/type {:db/ident :answer.type/math} :answer/value "-1<x<3" :db/id #edb/ref 17592186318266} {:answer/id #uuid "35985cf0-b331-57c6-8d13-626e9606b934" :answer/type {:db/ident :answer.type/math} :answer/value "x<\\frac{5}{8}" :db/id #edb/ref 17592186318267}] :answer-field/correct {:answer/id #uuid "2edcb5fe-c1b1-5b7f-bda4-cd201ccc1a58" :answer/type {:db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186318265} :answer-field/id #uuid "dc722f40-6d95-5047-9f03-4578e39a3c42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318262}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "52cacea0-27c9-5e00-91cd-135a61a94851" :question/math-academy-id "q-115431" :question/problem "Solve the inequality $3x\\cdot {5}^{x+6}-{5}^{x+6}<8\\cdot {5}^{x+6}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}3x\\cdot {5}^{x+6}-{5}^{x+6} & <8\\cdot {5}^{x+6} \\\\ 3x\\cdot {5}^{x+6}-{5}^{x+6}-8\\cdot {5}^{x+6} & <0 \\\\ (3x-1-8){5}^{x+6} & <0 \\\\ (3x-9){5}^{x+6} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${5}^{x+6}$ and solve the resulting inequality using familiar techniques:\n\n$$\n\\begin{aligned}3x-9 & <0 \\\\ 3x & <9 \\\\ x & <3\\end{aligned}\n$$\n\nThe solution to the inequality above is $x<3.$"}] [{:db/id #edb/ref 17592186318268 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with Different Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d074725-e5d2-56de-a72e-5f6f2d06c191" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186318270}] :answer-field/correct {:answer/id #uuid "6d074725-e5d2-56de-a72e-5f6f2d06c191" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186318270} :answer-field/id #uuid "eec897bc-67b7-5b8e-bfca-ce067a39f540" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318269} {:answer-field/choices [{:answer/id #uuid "00631d59-46c3-5009-b394-b36eb4bb57ad" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186318272}] :answer-field/correct {:answer/id #uuid "00631d59-46c3-5009-b394-b36eb4bb57ad" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186318272} :answer-field/id #uuid "e352c3cf-02a8-547d-9a3b-754494635773" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318271} {:answer-field/choices [{:answer/id #uuid "e96a3677-f67c-5905-b1c6-f17d09c11c49" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186318274}] :answer-field/correct {:answer/id #uuid "e96a3677-f67c-5905-b1c6-f17d09c11c49" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186318274} :answer-field/id #uuid "b1581a0a-a9f1-5b38-9b54-e72664da6d3e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318273}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "28f74f22-8fc6-59db-9658-598ba37ab135" :question/math-academy-id "q-276749" :question/problem "Solve the inequality ${3}^{4-5x}x<{3}^{2-5x}{x}^{2}.$\n\n$x<${{field-1}}\n$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{3}^{4-5x}x & <{3}^{2-5x}{x}^{2} \\\\ {3}^{4-5x}x-{3}^{2-5x}{x}^{2} & <0 \\\\ ({3}^{2}x-{x}^{2})\\cdot {3}^{2-5x} & <0 \\\\ (9x-{x}^{2})\\cdot {3}^{2-5x} & <0 \\\\ x(9-x)\\cdot {3}^{2-5x} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${3}^{2-5x}$ and get\n\n$$\nx(9-x)<0.\n$$\n\nThis represents a downwards parabola whose roots are at $x=0$ and $x=9.$ The parabola is below the $x$-axis when  $x<0$ or $x>9.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/assets/1c9e8e25c57c88476bedceea237fe78eb2a28d48008493f8609ac31d9aeda30b.png)\n\nTherefore, the solution is $x<0$ or $x>9.$"}] [{:db/id #edb/ref 17592186318275 :knowledge-point/_questions [{:knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd042c4-ab79-54c6-b7a8-d8e51f98c278" :answer/type {:db/ident :answer.type/math} :answer/value "-4<x<-2" :db/id #edb/ref 17592186318277} {:answer/id #uuid "aad22b45-088d-5148-84bd-90760359938e" :answer/type {:db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186318278} {:answer/id #uuid "3a24eaa7-5aaa-5739-842a-2c4dac18296d" :answer/type {:db/ident :answer.type/math} :answer/value "x>-2" :db/id #edb/ref 17592186318279} {:answer/id #uuid "03885f87-877f-5604-a966-faaf81160388" :answer/type {:db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186318280} {:answer/id #uuid "68d7d535-0c48-5710-846f-317abf4bbbc6" :answer/type {:db/ident :answer.type/math} :answer/value "-3<x<3" :db/id #edb/ref 17592186318281}] :answer-field/correct {:answer/id #uuid "1cd042c4-ab79-54c6-b7a8-d8e51f98c278" :answer/type {:db/ident :answer.type/math} :answer/value "-4<x<-2" :db/id #edb/ref 17592186318277} :answer-field/id #uuid "4c940778-cee3-5b2e-9a91-969637eaa5a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318276}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "98bc6183-b869-515c-afa2-be3eafd4bc40" :question/math-academy-id "q-88228" :question/problem "Solve the inequality ${x}^{2}{e}^{2x-1}<-8{e}^{2x-1}-6x{e}^{2x-1}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}{e}^{2x-1}<-8{e}^{2x-1}-6x{e}^{2x-1} \\\\ {x}^{2}{e}^{2x-1}+6x{e}^{2x-1}+8{e}^{2x-1} & <0 \\\\ ({x}^{2}+6x+8){e}^{2x-1} & <0 \\\\ (x+4)(x+2){e}^{2x-1} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${e}^{2x-1}$ and get\n\n$$\n(x+4)(x+2)<0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=-4$ and $x=-2.$ The parabola is below the $x$-axis when $-4<x<-2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/assets/15a31e60a938b604b96ade5e6868c658a2e2f0a53fe2a5f53a032093155e8aee.png)\n\nTherefore, the solution is $-4<x<-2.$"}] [{:db/id #edb/ref 17592186318282 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with Different Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52bf2af2-50f5-5633-9cc8-0442960ce7fc" :answer/type {:db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186318284} {:answer/id #uuid "ddd8ce6d-0b3e-51dc-a32f-72c29072cea7" :answer/type {:db/ident :answer.type/text} :answer/value "no solution" :db/id #edb/ref 17592186318285} {:answer/id #uuid "4fc00217-8905-5d76-a520-fc6c59de63c9" :answer/type {:db/ident :answer.type/math} :answer/value "x<3" :db/id #edb/ref 17592186318286} {:answer/id #uuid "1a71b500-83ea-5977-b57d-86024359c845" :answer/type {:db/ident :answer.type/math} :answer/value "0<x<3" :db/id #edb/ref 17592186318287} {:answer/id #uuid "9a4a4636-5aa0-5d13-b158-44fc279cb3fa" :answer/type {:db/ident :answer.type/text} :answer/value "$x<0$ or $x>3$" :db/id #edb/ref 17592186318288}] :answer-field/correct {:answer/id #uuid "1a71b500-83ea-5977-b57d-86024359c845" :answer/type {:db/ident :answer.type/math} :answer/value "0<x<3" :db/id #edb/ref 17592186318287} :answer-field/id #uuid "0f42cf13-0389-58de-916e-9c1b3250ea09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318283}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ed991497-b192-5940-a46e-e63354ca49c5" :question/math-academy-id "q-88300" :question/problem "Solve the inequality $-{3}^{6x+1}x<-{3}^{6x}{x}^{2}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}-{3}^{6x+1}x & <-{3}^{6x}{x}^{2} \\\\ {3}^{6x}{x}^{2}-{3}^{6x+1}x & <0 \\\\ {3}^{6x}({x}^{2}-3x) & <0 \\\\ {3}^{6x}x(x-3) & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${3}^{6x}$ and get\n\n$$\nx(x-3)<0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=0$ and $x=3.$ The parabola is below the $x$-axis when $0<x<3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14042952/assets/8582e3a512cc29618a3e2db9dda4478481167eefcf0a2fbdfb7d33e5786ba62e.png)\n\nTherefore, the solution is  $0<x<3.$"}] [{:db/id #edb/ref 17592186318289 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with Different Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9893f7cd-a7bb-5ed7-8ab4-72f91a04ee72" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le -\\frac{1}{5}$ or $x\\ge \\frac{1}{5}$" :db/id #edb/ref 17592186318291} {:answer/id #uuid "b88c7cb7-0ddd-520d-ac83-f1f663d89fc9" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -\\frac{1}{5}" :db/id #edb/ref 17592186318292} {:answer/id #uuid "ce6a6aef-d1d5-55a8-b6a7-1997b3ac2899" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{1}{5}" :db/id #edb/ref 17592186318293} {:answer/id #uuid "b3523f25-3f14-57c4-9b02-3ac9f114e6aa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\le x\\le \\frac{1}{5}" :db/id #edb/ref 17592186318294} {:answer/id #uuid "c0422e37-d08a-5343-93b3-7006317556eb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{5}" :db/id #edb/ref 17592186318295}] :answer-field/correct {:answer/id #uuid "c0422e37-d08a-5343-93b3-7006317556eb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{5}" :db/id #edb/ref 17592186318295} :answer-field/id #uuid "1a57c158-c098-586a-a14c-b9153af018e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318290}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c67c1d46-c93a-5c2e-8f02-6054697fe56d" :question/math-academy-id "q-88311" :question/problem "Solve the inequality ${x}^{3}\\cdot {5}^{7x}\\ge {5}^{7x-3}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{3}\\cdot {5}^{7x} & \\ge {5}^{7x-3} \\\\ {x}^{3}\\cdot {5}^{7x}-{5}^{7x-3} & \\ge 0 \\\\ ({x}^{3}-{5}^{-3})\\cdot {5}^{7x} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${5}^{7x}$ and get\n\n$$\n{x}^{3}-{5}^{-3}\\ge 0.\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{3} & \\ge {5}^{-3} \\\\ \\sqrt[3]{{x}^{3}} & \\ge \\sqrt[3]{{5}^{-3}} \\\\ x & \\ge {({5}^{-3})}^{1/3} \\\\ x & \\ge {5}^{-1} \\\\ x & \\ge \\frac{1}{5}\\end{aligned}\n$$\n\nTherefore, the solution to the inequality is $x\\ge \\frac{1}{5}.$"}]}
