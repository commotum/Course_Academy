Y}=\\frac{5}{7}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OZ} & =\\overset{\\to }{OX}+\\overset{\\to }{XZ} \\\\  & =a+\\frac{5}{7}(b-a) \\\\  & =\\frac{2}{7}a+\\frac{5}{7}b.\\end{aligned}\n$$" 13194139533660 true] [17592186244933 1000 #edb/ref 17592186244934 13194139533660 true] [17592186244933 1000 #edb/ref 17592186244935 13194139533660 true] [17592186244933 1000 #edb/ref 17592186244936 13194139533660 true] [17592186244933 1000 #edb/ref 17592186244937 13194139533660 true] [17592186244933 1000 #edb/ref 17592186244938 13194139533660 true] [17592186244933 1040 #edb/ref 17592186045450 13194139533660 true] [17592186244933 1041 "selection" 13194139533660 true] [17592186244933 1104 #edb/ref 17592186244936 13194139533660 true] [17592186244933 1110 #uuid "58e5eb14-3d14-576f-b79c-1bb39c5d049f" 13194139533660 true] [17592186244934 1034 "\\overset{\\to }{OZ}=\\frac{2}{7}a-\\frac{5}{7}b" 13194139533660 true] [17592186244934 1103 #edb/ref 17592186045453 13194139533660 true] [17592186244934 1111 #uuid "0251127a-7ee5-5a6d-b6b0-b1c20e899942" 13194139533660 true] [17592186244935 1034 "\\overset{\\to }{OZ}=\\frac{1}{7}a-\\frac{6}{7}b" 13194139533660 true] [17592186244935 1103 #edb/ref 17592186045453 13194139533660 true] [17592186244935 1111 #uuid "24758abb-8e23-5ffe-b52f-a7b68823a3fc" 13194139533660 true] [17592186244936 1034 "\\overset{\\to }{OZ}=\\frac{2}{7}a+\\frac{5}{7}b" 13194139533660 true] [17592186244936 1103 #edb/ref 17592186045453 13194139533660 true] [17592186244936 1111 #uuid "5c8bd66a-b36e-596f-b076-c272477c69c9" 13194139533660 true] [17592186244937 1034 "\\overset{\\to }{OZ}=\\frac{1}{7}a+\\frac{6}{7}b" 13194139533660 true] [17592186244937 1103 #edb/ref 17592186045453 13194139533660 true] [17592186244937 1111 #uuid "faeca566-2f36-5590-9219-6ddc52cd6229" 13194139533660 true] [17592186244938 1034 "\\overset{\\to }{OZ}=\\frac{2}{7}a+\\frac{6}{7}b" 13194139533660 true] [17592186244938 1103 #edb/ref 17592186045453 13194139533660 true] [17592186244938 11