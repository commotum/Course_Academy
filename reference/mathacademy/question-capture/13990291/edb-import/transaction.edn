 :answer-field/id #uuid "c08a4fa2-4c67-54fd-9892-27e06dc7c661" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281563/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-281563/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-281563/field-5/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "158a495c-3632-5933-9a31-aab449c83309" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-281563/field-5" :answer-field/id #uuid "503c95c3-63e8-5634-a1ac-225f221b0779" :answer-field/key "field-5" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281563/field-5/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-281563/field-5/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-281563/field-6/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "3e34cf3e-0d3a-5ce7-a22b-9ad5df424ed9" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-281563/field-6" :answer-field/id #uuid "268526c2-d2de-5b5f-8557-5ef14bd6e622" :answer-field/key "field-6" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281563/field-6/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-281563/field-6/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-281563" :question/id #uuid "660e0dc3-93d5-5874-a070-09fa7416e38b" :question/math-academy-id "q-281563" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & -4 \\\\ 2 & 3\\end{aligned}].\n$$\n\nA triangle $XYZ$ has vertices at $X(2,0),\\,Y(-4,2),$ and $Z(4,0).$ What are the coordinates of the corresponding vertices of  $△{X}^{′}{Y}^{′}{Z}^{′}$, the image of $△XYZ$ under the action of $T?$\n\n${X}^{′}($ \n{{field-1}}, \n{{field-2}}\n$),\\,$  $\\,{Y}^{′}($ \n{{field-3}}, \n{{field-4}}\n$),\\,$ $\\,{Z}^{′}($ \n{{field-5}}, \n{{field-6}}\n$)$" :question/worked-solution "To find the image of $△XYZ$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $XYZ:$\n\n$$\nX=[\\begin{aligned}2 & -4 & 4 \\\\ 0 & 2 & 0\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -4 \\\\ 2 & 3\\end{aligned}]\\cdot [\\begin{aligned}2 & -4 & 4 \\\\ 0 & 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -12 & 4 \\\\ 4 & -2 & 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{X}^{′}{Y}^{′}{Z}^{′}$ are ${X}^{′}(2,4),$\n${Y}^{′}(-12,-2),$ ${Z}^{′}(4,8).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-281563/field-1" "q-281563/field-2" "q-281563/field-3" "q-281563/field-4" "q-281563/field-5" "q-281563/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2"] :knowledge-point/questions ["q-281563"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6682"] :question/problem "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}2 & 3 \\\\ 1 & -1\\end{aligned}]\n$$\n\nThe line segment $\\overline{AB}$ is shown below. Find $\\overline{A'B'},$ the image of $\\overline{AB}$ under the action of $\\mathbf T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/2e22400d15abc81150d6d18de591549e81a46bd16ab9e95f10f86bae2125b490.png)" :question/worked-solution "To find the image of $\\overline{AB}$ under the action of $\\mathbf T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overline{AB}\\mathbin{:}$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 3 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 3 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are $A'(1,3)$ and $B'(1,-2),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/472f8e712f7d695d5ab3593dafbcc0309feb1a6ac80e9e29c4893dc651d20cf7.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5447"] :question/problem "Consider the linear transformation $\\mathbf T$ with matrix representation $T,$ given by\n\n$$\n[\\begin{aligned}1 & -1 \\\\ 0 & -2\\end{aligned}]\n$$\n\nThe triangle $\\triangle ABC$ is shown below. Find $\\triangle A'B'C',$ the image of $\\triangle ABC$ under the action of $\\mathbf T.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/4986bd2dab6b455c0d5e41909377c433d761bf7270364d3e2596e6db7f23981b.png)" :question/worked-solution "To find the image of $T$ under the action of $\\mathbf T,$ we first create a matrix $X$ containing all of the vertices of $\\triangle ABC\\mathbin{:}$\n\n$$\n[\\begin{aligned}-1 & 0 & 2 \\\\ 2 & 0 & 1\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $\\mathbf T$ by calculating the matrix product $TX\\mathbin{:}$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -1 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}-1 & 0 & 2 \\\\ 2 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 0 & 1 \\\\ -4 & 0 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $\\triangle A'B'C'$ are $(-3,-4), (0,0), (1,-2),$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/e8a14ffbaab4597a2a4a7c9a6bad61dabbc4970fc22c3ed2eb28b2594a670938.png)" :db/ensure [:question/validate]}]
