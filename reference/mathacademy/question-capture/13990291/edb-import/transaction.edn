0"] :db/ensure [:answer-field/validate]} {:db/id "q-281541/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "e300546a-b3a9-5328-900d-35daebc6283d" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-281541/field-3" :answer-field/id #uuid "4250aa27-770a-59a5-af77-28e44a405418" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281541/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-281541/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-281541/field-4/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "8716484a-def2-5aad-88c9-6e1ad98f3304" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-281541/field-4" :answer-field/id #uuid "d05d1f78-0e9a-5806-9f31-e7262a625dbb" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281541/field-4/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-281541/field-4/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49"] :db/ensure [:answer-field/validate]} {:db/id "q-281541" :question/id #uuid "d99c7e0a-a02d-5d45-a6e5-6a400ff91985" :question/math-academy-id "q-281541" :question/problem "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{EF}$ has endpoints at $E(1,1)$ and $F(2,3).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{E}^{′}{F}^{′}}$, the image of $\\overset{―}{EF}$ under the action of $T?$\n\n${E}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{F}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{EF}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{EF}:$\n\n$$\nX=[\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}5 & 0 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 10 \\\\ 5 & 15\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${E}^{′}(5,5)$ and ${F}^{′}(10,15).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-281541/field-1" "q-281541/field-2" "q-281541/field-3" "q-281541/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570"] :knowledge-point/questions ["q-281541"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77709/selection/f0152b0bda1e4e8eb943f6a434c4512989dcc71552cc4acb84b86555f9e51b13" :answer/id #uuid "4ce09fef-e69d-5f31-bbe3-cf0c90799be4" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/26d4f8e966818e27a0858da0aa8757cf71ebbd1ef0e0544a2b8a126810252def.png" :db/ensure [:answer/validate]} {:db/id "q-77709/selection/61ceafcd0b04efc33ad7d197e393c964ee302dd9b32852498c1bd77016a37c1b" :answer/id #uuid "d92617cf-f17a-583c-bfc8-1a5d816e5889" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/dbb1063de834b81ffc00839234d5f8e782daa5f14d78b0a5f2d06265d48be07f.png" :db/ensure [:answer/validate]} {:db/id "q-77709/selection/d9055c4101267c7c00666db958d66d6758acb0f1f4c68371086bd1e487536737" :answer/id #uuid "5cec5545-919b-5b4d-ab6d-8af13dd70b8d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13990291/assets/be396df84