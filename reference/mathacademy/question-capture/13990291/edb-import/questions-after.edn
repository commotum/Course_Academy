$\n\nTherefore, the coordinates of the respective endpoints of the image are ${Y}^{′}(4,-4)$ and ${Z}^{′}(0,3).$"}] [{:db/id #edb/ref 17592186283492 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c65cbb20-03de-5881-acd6-1313c469fc34" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283494}] :answer-field/correct {:answer/id #uuid "c65cbb20-03de-5881-acd6-1313c469fc34" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283494} :answer-field/id #uuid "9a4d95ab-22f3-5c79-af99-b4dc4ba71335" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283493} {:answer-field/choices [{:answer/id #uuid "6b3b2b07-63f7-532b-99c8-4e8168f221c3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283496}] :answer-field/correct {:answer/id #uuid "6b3b2b07-63f7-532b-99c8-4e8168f221c3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283496} :answer-field/id #uuid "eae8d299-a43a-5e4c-bb84-5b91ad1669e9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283495} {:answer-field/choices [{:answer/id #uuid "a2cf9d89-8dc7-5652-be62-52166fbc43df" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186283498}] :answer-field/correct {:answer/id #uuid "a2cf9d89-8dc7-5652-be62-52166fbc43df" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186283498} :answer-field/id #uuid "b8eb6a6f-f2c9-57b8-8b65-cf1306ed9161" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283497} {:answer-field/choices [{:answer/id #uuid "f5419