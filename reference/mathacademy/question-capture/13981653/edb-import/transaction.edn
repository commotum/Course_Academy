fbfe1f42c7b42480aef2b59a41bd497b98428a4dfc1519f9ca1e3e" "q-87908/selection/4ae8208d4de254fad0c2078fb30ffec80a559cdaadf1eb2b8de76584d480de8a" "q-87908/selection/da515f07eba1a4a7f9feaf8e629d91385dd9b483893b6fd9b5bdfa75112b13f3"] :db/ensure [:answer-field/validate]} {:db/id "q-87908" :question/id #uuid "40d4bda5-69c1-5c56-8e06-e9265d3522f6" :question/math-academy-id "q-87908" :question/problem "Solve the inequality $5\\cdot {2}^{x}<{3}^{2-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}5\\cdot {2}^{x} & <{3}^{2-x} \\\\ \\operatorname{ln}⁡(5\\cdot {2}^{x}) & <\\operatorname{ln}⁡({3}^{2-x}) \\\\ \\operatorname{ln}⁡5+\\operatorname{ln}⁡({2}^{x}) & <\\operatorname{ln}⁡({3}^{2-x}) \\\\ \\operatorname{ln}⁡5+x\\operatorname{ln}⁡2 & <(2-x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡5+x\\operatorname{ln}⁡2 & <2\\operatorname{ln}⁡3-x\\operatorname{ln}⁡3 \\\\ x\\operatorname{ln}⁡2+x\\operatorname{ln}⁡3 & <2\\operatorname{ln}⁡3-\\operatorname{ln}⁡5 \\\\ x(\\operatorname{ln}⁡2+\\operatorname{ln}⁡3) & <2\\operatorname{ln}⁡3-\\operatorname{ln}⁡5 \\\\ x & <\\frac{2\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2+\\operatorname{ln}⁡3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87908/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-87908"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115250/selection/b369c5a468c80115ed50ac60320e4ef5ec2eaef32477c5e2e058e66744b4e7e2" :answer/id #uuid "eb2a63ed-a882-52e7-aa8a-6e2b33dd9486" :answer/type :answer.type/math :answer/value "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "q-115250/selection/e3d9f1124d8e71945ef38d7582eb98d54139db09f67d517c81480367462f4238" :answer/id #uuid "5ed8e0aa-7313-5487-bac9-d9ab578e6fb8" :answer/type :answer.type/math :answer/value "x<2\\operatorname{ln}⁡5-3" :db/ensure [:answer/validate]} {:db/id "q-115250/selection/386af433285ee5535861c231ddeaa9d05a8576a65f12060e191805071fb39dbf" :answer/id #uuid "7bb88958-b780-539d-b197-f48c81ba1417" :answer/type :answer.type/math :answer/value "x>2\\operatorname{ln}⁡5-3" :db/ensure [:answer/validate]} {:db/id "q-115250/selection/5adefb26ab2743a1bc44d0ed2a2f3f9f9f2cd5c99e8d64fb548059c41858802e" :answer/id #uuid "5c4e3aa0-abe9-5342-a2be-5a14389ded1d" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}{2\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-115250/selection/30956d9afe8b30246069740c22bcd6174c041f5d624a69f81bfc651adb88994d" :answer/id #uuid "5ffae442-b149-5e65-af75-d60e565e419e" :answer/type :answer.type/math :answer/value "x<5\\operatorname{ln}⁡2+3" :db/ensure [:answer/validate]} {:db/id "q-115250/selection" :answer-field/id #uuid "95526973-c5d1-5eb0-99aa-839a08d4d898" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115250/selection/b369c5a468c80115ed50ac60320e4ef5ec2eaef32477c5e2e058e66744b4e7e2" :answer-field/choices ["q-115250/selection/b369c5a468c80115ed50ac60320e4ef5ec2eaef32477c5e2e058e66744b4e7e2" "q-115250/selection/e3d9f1124d8e71945ef38d7582eb98d54139db09f67d517c81480367462f4238" "q-115250/selection/386af433285ee5535861c231ddeaa9d05a8576a65f12060e191805071fb39dbf" "q-115250/selection/5adefb26ab2743a1bc44d0ed2a2f3f9f9f2cd5c99e8d64fb548059c41858802e" "q-115250/selection/30956d9afe8b30246069740c22bcd6174c041f5d624a69f81bfc651adb88994d"] :db/ensure [:answer-field/validate]} {:db/id "q-115250" :question/id #uuid "46f93566-72fe-564d-b0b7-ec11d50de229" :question/math-academy-id "q-115250" :question/problem "Solve the inequality ${5}^{x-1}<{(\\frac{1}{2})}^{2-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following: \n\n$$\n\\begin{aligned}{5}^{x-1} & <{(\\frac{1}{2})}^{2-x} \\\\ \\operatorname{ln}⁡({5}^{x-1}) & <\\operatorname{ln}⁡[{(\\frac{1}{2})}^{2-x}] \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(0-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(x-2)\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-\\operatorname{ln}⁡5 & <x\\operatorname{ln}⁡2-2\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-x\\operatorname{ln}⁡2 & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x(\\operatorname{ln}⁡5-\\operatorname{ln}⁡2) & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x & <\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115250/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-115250"] :db/ensure [:knowledge-point/validate]} {:db/id "q-365326/selection/48f949bc12fc27d017504f2903dcbf5bd0add79ce09e56a73810975121230de9" :answer/id #uuid "b46366c1-5d12-533b-8af9-b76ae66085f3" :answer/type :answer.type/math :answer/value "x>\\frac{3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}{2\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-365326/selection/7af86fe5f16c36f7f68b369f99544e83265549378ebba2e7dc6b60dc80853b01" :answer/id #uuid "a3e67c13-1127-5d57-883e-d4ebcb4afc3a" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-365326/selection/76c7c86c9344aba51fa40a76a24c6c9b54c014ee7eb8a6baf717ee045e5cbd1c" :answer/id #uuid "a4f6ddce-8b06-5403-9913-49c89bcb251c" :answer/type :answer.type/math :answer/value "x<\\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3+\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-365326/selection/429f6babe11e4317459016b6b42abd2bc4ab17006c2c80a767dc3d8c22eca569" :answer/id #uuid "14c86740-0847-5b12-91fe-76036ea3f978" :answer/type :answer.type/math :answer/value "x<\\frac{\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-365326/selection/38abf19b6b7d0664654fbfa051b5cf36ab0af82faad4773fbd1fc57810e969a9" :answer/id #uuid "90913424-565e-5da9-bd57-a11fdd7c7d49" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3+\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-365326/selection" :answer-field/id #uuid "216bc7a5-eba3-5593-adf4-e104f5f0d58f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-365326/selection/7af86fe5f16c36f7f68b369f99544e83265549378ebba2e7dc6b60dc80853b01" :answer-field/choices ["q-365326/selection/48f949bc12fc27d017504f2903dcbf5bd0add79ce09e56a73810975121230de9" "q-365326/selection/7af86fe5f16c36f7f68b369f99544e83265549378ebba2e7dc6b60dc80853b01" "q-365326/selection/76c7c86c9344aba51fa40a76a24c6c9b54c014ee7eb8a6baf717ee045e5cbd1c" "q-365326/selection/429f6babe11e4317459016b6b42abd2bc4ab17006c2c80a767dc3d8c22eca569" "q-365326/selection/38abf19b6b7d0664654fbfa051b5cf36ab0af82faad4773fbd1fc57810e969a9"] :db/ensure [:answer-field/validate]} {:db/id "q-365326" :question/id #uuid "db98e2be-d4e2-5d82-8a5f-f833ad907bed" :question/math-academy-id "q-365326" :question/problem "Solve the inequality $3{(\\frac{1}{5})}^{x-2}>{3}^{2-3x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following: \n\n$$\n\\begin{aligned}3{(\\frac{1}{5})}^{x-2} & >{3}^{2-3x} \\\\ \\operatorname{ln}⁡[3{(\\frac{1}{5})}^{x-2}] & >\\operatorname{ln}⁡({3}^{2-3x}) \\\\ \\operatorname{ln}⁡3+\\operatorname{ln}⁡[{(\\frac{1}{5})}^{x-2}] & >\\operatorname{ln}⁡({3}^{2-3x}) \\\\ \\operatorname{ln}⁡3+(x-2)\\operatorname{ln}⁡(\\frac{1}{5}) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(x-2)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡5) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(x-2)(0-\\operatorname{ln}⁡5) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(2-x)\\operatorname{ln}⁡5 & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-x\\operatorname{ln}⁡5 & >2\\operatorname{ln}⁡3-3x\\operatorname{ln}⁡3 \\\\ 3x\\operatorname{ln}⁡3-x\\operatorname{ln}⁡5 & >2\\operatorname{ln}⁡3-\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5 \\\\ x(3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5) & >\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5 \\\\ x & >\\frac{\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-365326/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-365326"] :db/ensure [:knowledge-point/validate]} {:db/id "q-365323/selection/a98171af0fb5e636cd8450019e49f890d14062a6075b5495059c5823254f105b" :answer/id #uuid "67cac48b-8c71-5763-b914-eb64c911cfee" :answer/type :answer.type/math :answer/value "x\\ge \\frac{2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5+2\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-365323/selection/ae4ae18f747023a070b442b10bee6a39e116c8b89ce95d33c6559ecb91af2206" :answer/id #uuid "5b34a53f-358e-5a70-a28e-6565ed5751bb" :answer/type :answer.type/math :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-365323/selection/6f03010dd685d332a45d6ca8a1f1fe18dada00a69a032439c091b5f4b1120c5a" :answer/id #uuid "f3ac57a6-e60d-5218-8794-04417dec905e" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{\\operatorname{ln}⁡5+2\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-365323/selection/8e42238d24af6a435877b12becebefe04a95fc06737b7308906154a89cacd958" :answer/id #uuid "5eb8a6ae-50ec-5fd0-ae5a-fcd2a175dd9d" :answer/type :answer.type/math :answer/value "x\\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-365323/selection/df44f818f608f3940dff7f3f223c315c021df773a2b8124e883c14cb37ec5e6f" :answer/id #uuid "d61f7be1-563e-5776-a6bb-c21238a8bc31" :answer/type :answer.type/math :answer/value "x\\le \\frac{2\\operatorname{ln}⁡5+\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/ensure [:answer/validate]} {:db/id "q-365323/selection" :answer-field/id #uuid "73e9ac04-cbcb-5c74-b132-98f3daa7a52b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-365323/selection/8e42238d24af6a435877b12becebefe04a95fc06737b7308906154a89cacd958" :answer-field/choices ["q-365323/selection/a98171af0fb5e636cd8450019e49f890d14062a6075b5495059c5823254f105b" "q-365323/selection/ae4ae18f747023a070b442b10bee6a39e116c8b89ce95d33c6559ecb91af2206" "q-365323/selection/6f03010dd685d332a45d6ca8a1f1fe18dada00a69a032439c091b5f4b1120c5a" "q-365323/selection/8e42238d24af6a435877b12becebefe04a95fc06737b7308906154a89cacd958" "q-365323/selection/df44f818f608f3940dff7f3f223c315c021df773a2b8124e883c14cb37ec5e6f"] :db/ensure [:answer-field/validate]} {:db/id "q-365323" :question/id #uuid "d9916c25-ee44-597a-a249-18ef40c09255" :question/math-academy-id "q-365323" :question/problem "Solve the inequality ${4}^{1-2x}\\le 3\\cdot {5}^{2-3x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}{4}^{1-2x} & \\le 3\\cdot {5}^{2-3x} \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3\\cdot {5}^{2-3x}) \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3)+\\operatorname{ln}⁡({5}^{2-3x}) \\\\ (1-2x)\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+(2-3x)\\operatorname{ln}⁡5 \\\\ \\operatorname{ln}⁡4-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-3x\\operatorname{ln}⁡5 \\\\ 3x\\operatorname{ln}⁡5-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x(3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4) & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x & \\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-365323/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-365323"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115248/selection/95c1abe653edad0e06a2e27ea4b789b53ce67f52bbc8987dd4b1eac0b0e5dcc5" :answer/id #uuid "626ad8ab-087f-5619-ac82-1e6b8014ed00" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡7}{\\operatorname{ln}⁡7+\\operatorname{ln}⁡5}" :db/ensure [:answer/validate]} {:db/id "q-115248/selection/7148a987e4799eb0136d60ef99f563ac33bdac1ed500289f11a8dee88568551f" :answer/id #uuid "2986a2a6-1141-51b5-9c60-5909ec42811e" :answer/type :answer.type/math :answer/value "x>-\\frac{7}{5}" :db/ensure [:answer/validate]} {:db/id "q-115248/selection/f732f4544501b8ba810246c739639a4b2d125c54ebc6a377dfef5588274d0da7" :answer/id #uuid "850b94c3-1d43-5571-852b-a4b1fb129952" :answer/type :answer.type/math :answer/value "x>\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "q-115248/selection/ab6601e135f14bbbd924ab0cfdcba9afc4be5fe499298df0ed5648e44f48838e" :answer/id #uuid "1c2891c1-a9c3-58c8-85bf-4d857f2d35cf" :answer/type :answer.type/math :answer/value "x>\\operatorname{ln}⁡7-\\operatorname{ln}⁡5" :db/ensure [:answer/validate]} {:db/id "q-115248/selection/4b1feab0410b89f585dfce74ca89a45debcdc4c6b1f86c49ec1f0823f568f9f5" :answer/id #uuid "b674cc54-7a52-594f-aeb7-7c11ef13910b" :answer/type :answer.type/math :answer/value "x>\\frac{\\operatorname{ln}⁡5+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡7}" :db/ensure [:answer/validate]} {:db/id "q-115248/selection" :answer-field/id #uuid "c1203ce1-d167-5ef4-9ac8-8ec756aa5a3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115248/selection/4b1feab0410b89f585dfce74ca89a45debcdc4c6b1f86c49ec1f0823f568f9f5" :answer-field/choices ["q-115248/selection/95c1abe653edad0e06a2e27ea4b789b53ce67f52bbc8987dd4b1eac0b0e5dcc5" "q-115248/selection/7148a987e4799eb0136d60ef99f563ac33bdac1ed500289f11a8dee88568551f" "q-115248/selection/f732f4544501b8ba810246c739639a4b2d125c54ebc6a377dfef5588274d0da7" "q-115248/selection/ab6601e135f14bbbd924ab0cfdcba9afc4be5fe499298df0ed5648e44f48838e" "q-115248/selection/4b1feab0410b89f585dfce74ca89a45debcdc4c6b1f86c49ec1f0823f568f9f5"] :db/ensure [:answer-field/validate]} {:db/id "q-115248" :question/id #uuid "7904da67-2a80-5fe6-93ea-370ad7d9b2da" :question/math-academy-id "q-115248" :question/problem "Solve the inequality ${7}^{x+1}>{5}^{x-1}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}{7}^{x+1} & >{5}^{x-1} \\\\ \\operatorname{ln}⁡({7}^{x+1}) & >\\operatorname{ln}⁡({5}^{x-1}) \\\\ (x+1)\\operatorname{ln}⁡7 & >(x-1)\\operatorname{ln}⁡5 \\\\ x\\operatorname{ln}⁡7+\\operatorname{ln}⁡7 & >x\\operatorname{ln}⁡5-\\operatorname{ln}⁡5 \\\\ x\\operatorname{ln}⁡7-x\\operatorname{ln}⁡5 & >-\\operatorname{ln}⁡5-\\operatorname{ln}⁡7 \\\\ x(\\operatorname{ln}⁡7-\\operatorname{ln}⁡5) & >-\\operatorname{ln}⁡5-\\operatorname{ln}⁡7 \\\\ x & >-\\frac{\\operatorname{ln}⁡5+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡7-\\operatorname{ln}⁡5} \\\\ x & >\\frac{\\operatorname{ln}⁡5+\\operatorname{ln}⁡7}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡7}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-115248/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a"] :knowledge-point/questions ["q-115248"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7657"] :question/problem "Solve the inequality $4e^x - 5 >  0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}4{e}^{x}-5 & >0 \\\\ 4{e}^{x} & >5 \\\\ {e}^{x} & >\\frac{5}{4}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & >\\operatorname{ln}⁡(\\frac{5}{4}) \\\\ x & >\\operatorname{ln}⁡5-\\operatorname{ln}⁡4.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7703"] :question/problem "Solve the inequality $5 \\cdot \\left( \\dfrac{3}{4} \\right)^x + 2 \\geq 12.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}5\\cdot {(\\frac{3}{4})}^{x}+2 & \\ge 12 \\\\ 5\\cdot {(\\frac{3}{4})}^{x} & \\ge 10 \\\\ {(\\frac{3}{4})}^{x} & \\ge 2.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{3}{4})}^{x}] & \\ge \\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡(\\frac{3}{4}) & \\ge \\operatorname{ln}⁡2 \\\\ x(\\operatorname{ln}⁡3-\\operatorname{ln}⁡4) & \\ge \\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nLastly, note that $\\ln 3 - \\ln 4$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\le \\frac{\\operatorname{ln}⁡2}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡4}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7704"] :question/problem "Solve the inequality $4 \\cdot 3^{8-x} + 12 > 0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}4\\cdot {3}^{8-x}+12 & >0 \\\\ 4\\cdot {3}^{8-x} & >-12 \\\\ {3}^{8-x} & >-3.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n3^{8-x} > 0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality $3^{8-x} > -3$ is satisfied for all real values of $x.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7660"] :question/problem "Solve the inequality $3 \\cdot 5^x <   7^{3-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}3\\cdot {5}^{x} & <{7}^{3-x} \\\\ \\operatorname{ln}⁡(3\\cdot {5}^{x}) & <\\operatorname{ln}⁡({7}^{3-x}) \\\\ \\operatorname{ln}⁡3+\\operatorname{ln}⁡({5}^{x}) & <\\operatorname{ln}⁡({7}^{3-x}) \\\\ \\operatorname{ln}⁡3+x\\operatorname{ln}⁡5 & <(3-x)\\operatorname{ln}⁡7 \\\\ \\operatorname{ln}⁡3+x\\operatorname{ln}⁡5 & <3\\operatorname{ln}⁡7-x\\operatorname{ln}⁡7 \\\\ x\\operatorname{ln}⁡5+x\\operatorname{ln}⁡7 & <3\\operatorname{ln}⁡7-\\operatorname{ln}⁡3 \\\\ x(\\operatorname{ln}⁡5+\\operatorname{ln}⁡7) & <3\\operatorname{ln}⁡7-\\operatorname{ln}⁡3 \\\\ x & <\\frac{3\\operatorname{ln}⁡7-\\operatorname{ln}⁡3}{\\operatorname{ln}⁡5+\\operatorname{ln}⁡7}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
