579b4dde886a" "q-115231/selection/12cf5bf844cf95b95e80f529266ac6af4ed60a8ea790e2b44db6283719be635c"] :db/ensure [:answer-field/validate]} {:db/id "q-115231" :question/id #uuid "ad267c36-a064-5e17-8942-0415d6eebd12" :question/math-academy-id "q-115231" :question/problem "Solve the inequality $\\frac{3}{2}(0.43)^{4x+5}+4>-2.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{3}{2}(0.43)^{4x+5}+4 & >-2 \\\\ \\frac{3}{2}(0.43)^{4x+5} & >-6 \\\\ (0.43)^{4x+5} & >-4.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n(0.43)^{4x+5}>0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality $(0.43)^{4x+5}>-4$ is satisfied for all real values of $x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115231/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa"] :knowledge-point/questions ["q-115231"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87874/selection/7f2f5e33733465a5df7298bdd1d55f56782a2f98890342ebb03462c739eccbbb" :answer/id #uuid "e50992ad-a7ea-5b22-9289-c1f38493f8a8" :answer/type :answer.type/math :answer/value "x<\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-87874/selection/11940548ca2165ae91276457d954d82095b693a2d5f6456839aadd81036b9454" :answer/id #uuid "cc522e96-0680-5b25-9401-2424de5b3f0b" :answer/type :answer.type/math :answer/value "x<\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-87874/selection/52f8bfd00f6b3deb0e93232df027641f8c16cee0e37ff5f896dd75bd009234e2" :answer/id #uuid "9a2c2635-1d57-5d0d-a439-fa518ff831ba" :answer/type :answer.type/text :answer/value "no solutions" :db/ensure [:answer/validate]} {:db/id "q-87874/selection/12cf5bf844cf95b95e80f529266ac6af4ed60a8ea790e2b44db6283719be635c" :answer/id #uuid "79e0c68f-8a4a-52ea-8966-a053026fe909" :answer/type :answer.type/text :answer/value "all real numbers" :db/ensure [:answer/valid