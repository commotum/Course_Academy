653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-87828" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/activity-metadata.json" "file_sha256" "89563438f069c3d0799b97e55e1becd211614e03a08255bf9c12aa841769557a"} {"question" "q-87828" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-87828" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x<\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡4+\\operatorname{ln}⁡9}"] ["math" "x<\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡4-\\operatorname{ln}⁡9}"] ["math" "x>\\frac{\\operatorname{ln}⁡4-\\operatorname{ln}⁡9}{\\operatorname{ln}⁡5}"] ["math" "x>\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡4+\\operatorname{ln}⁡9}"] ["math" "x>\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡4-\\operatorname{ln}⁡9}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-87828" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x>\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡4-\\operatorname{ln}⁡9}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-115222" "field" nil "attribute" "question/problem" "value" "Solve the inequality ${(\\frac{3}{4})}^{x+6}+1\\ge 2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-115222" "field" nil "attribute" "question/worked-solution" "value" "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}{(\\frac{3}{4})}^{x+6}+1 & \\ge 2 \\\\ {(\\frac{3}{4})}^{x+6} & \\ge 1.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{3}{4})}^{x+6}] & \\ge \\operatorname{ln}⁡1 \\\\ (x+6)\\operatorname{ln}⁡(\\frac{3}{4}) & \\ge 0 \\\\ (x+6)(\\operatorname{ln}⁡3-\\operatorname{ln}⁡4) & \\ge 0 \\\\ (x+6)(\\operatorname{ln}⁡3-2\\operatorname{ln}⁡2) & \\ge 0.\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡3-2\\operatorname{ln}⁡2$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}(x+6) & \\le \\frac{0}{\\operatorname{ln}⁡3-2\\operatorname{ln}⁡2} \\\\ x+6 & \\le 0 \\\\ x & \\le -6\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {"question" "q-115222" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/activity-metadata.json" "file_sha256" "89563438f069c3d0799b97e55e1becd211614e03a08255bf9c12aa841769557a"} {"question" "q-115222" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981653/state.json" "file_sha256" "42c5ec637e5c38e12c083ae2e0aff7169f12acf2a2b83d141410aefb43ad3295"} {