[{:db/id "q-15476/selection/a2111b3f127f1a14209ae79e4d444bb2909513b488958e93f14e05cba00c9bd5" :answer/id #uuid "c094964d-8bc6-578a-abb2-2d6f06619c36" :answer/type :answer.type/math :answer/value "-2\\sqrt{\\frac{3}{2}}" :db/ensure [:answer/validate]} {:db/id "q-15476/selection/3a4d5588ae72b0a890c48cc35ada704b080c73b693b5fbded002ff42caa469b8" :answer/id #uuid "4c844c76-0acd-573d-9045-2a338e5228c8" :answer/type :answer.type/math :answer/value "-8\\sqrt{\\frac{2}{3}}" :db/ensure [:answer/validate]} {:db/id "q-15476/selection/0110b9d292c07d31e3532c29680d32716248e2f1827efea09f39680e25d995a4" :answer/id #uuid "659156af-3182-5003-9f1d-d78fc42cd2c0" :answer/type :answer.type/math :answer/value "-2\\sqrt{\\frac{2}{3}}" :db/ensure [:answer/validate]} {:db/id "q-15476/selection/5df9f2d1d96f4fd52fa1c06605f062da925844c282dbd0d4711b834221fbb616" :answer/id #uuid "f1309958-7222-52e0-a771-61974716618d" :answer/type :answer.type/math :answer/value "-4\\sqrt{\\frac{3}{2}}" :db/ensure [:answer/validate]} {:db/id "q-15476/selection/8f55bd04f60e7eff1cc07c76d542eb98350e401a96f53e0cf1bfc26bec9661be" :answer/id #uuid "e0b8f231-fa4a-5d15-9c3e-38717a793052" :answer/type :answer.type/math :answer/value "-\\,\\frac{1}{\\sqrt{6}}" :db/ensure [:answer/validate]} {:db/id "q-15476/selection" :answer-field/id #uuid "20fac6dc-1a76-5c25-8248-d059f90b59ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15476/selection/3a4d5588ae72b0a890c48cc35ada704b080c73b693b5fbded002ff42caa469b8" :answer-field/choices ["q-15476/selection/a2111b3f127f1a14209ae79e4d444bb2909513b488958e93f14e05cba00c9bd5" "q-15476/selection/3a4d5588ae72b0a890c48cc35ada704b080c73b693b5fbded002ff42caa469b8" "q-15476/selection/0110b9d292c07d31e3532c29680d32716248e2f1827efea09f39680e25d995a4" "q-15476/selection/5df9f2d1d96f4fd52fa1c06605f062da925844c282dbd0d4711b834221fbb616" "q-15476/selection/8f55bd04f60e7eff1cc07c76d542eb98350e401a96f53e0cf1bfc26bec9661be"] :db/ensure [:answer-field/validate]} {:db/id "q-15476" :question/id #uuid "50241cd2-9723-5f47-977c-3f9124aa6642" :question/math-academy-id "q-15476" :question/problem "For the parametric curve \n\n$$\nx=\\sqrt{\\operatorname{sin}⁡({e}^{t})},\\,y=\\operatorname{cot}⁡({e}^{t}),\\,-\\infty <t<1,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\operatorname{ln}⁡(\\frac{\\pi }{6}).$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}\\cdot \\operatorname{cos}⁡({e}^{t})\\cdot {e}^{t} \\\\  & =\\frac{{e}^{t}\\operatorname{cos}⁡({e}^{t})}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}, \\\\ {y}^{′}(t) & =-{e}^{t}{csc}^{2}⁡({e}^{t}).\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-{e}^{t}{csc}^{2}⁡({e}^{t})}{(\\frac{{e}^{t}\\operatorname{cos}⁡({e}^{t})}{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}})} \\\\  & =-\\,\\frac{2\\sqrt{\\operatorname{sin}⁡({e}^{t})}}{{sin}^{2}⁡({e}^{t})\\operatorname{cos}⁡({e}^{t})} \\\\  & =-\\,\\frac{2}{{sin}^{3/2}⁡({e}^{t})\\operatorname{cos}⁡({e}^{t})}\\,.\\end{aligned}\n$$\n\nTherefore, when $t=\\operatorname{ln}⁡(\\frac{\\pi }{6}),$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{2}{{sin}^{3/2}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})} \\\\  & =-\\,\\frac{2}{{(\\frac{1}{2})}^{3/2}(\\frac{\\sqrt{3}}{2})} \\\\  & =-2\\cdot {2}^{3/2}\\,\\frac{2}{\\sqrt{3}} \\\\  & =-8\\sqrt{\\frac{2}{3}}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-15476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20849/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "7e7e4fe1-46bd-5dad-b699-417ef0a2ea13" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-20849/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d54c0499-b0ef-5a2b-8378-d1522272bb93" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-20849/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "6cd0e137-83b2-5205-9995-4a83fb0d5dd7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-20849/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "57812470-3cc7-5249-8672-0d103956e75a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-20849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "575d2812-c6b8-5b68-9b11-f8428e8e529d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-20849/selection" :answer-field/id #uuid "8c228ca3-85e2-5d62-b25f-e0c1b4e6cc5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-20849/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-20849/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-20849/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-20849/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-20849/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-20849" :question/id #uuid "45b1f64f-9248-57a2-a310-050eb4c80ee5" :question/math-academy-id "q-20849" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13952905/assets/c9371d5e2bb921b4f5e58423bbce492f2b555122ee42bd861040b57d01070353.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2(t+1),\\,y=4{t}^{2},\\,-1\\le t<1,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=0.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2,\\,{y}^{′}(t)=8t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{8t}{2}=4t.\n$$\n\nAt the point where $t=0$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =4(0) \\\\  & =0\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20849/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-20849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102941/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "5c3f26a8-fa3e-534b-b9cf-32f410307134" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-102941/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3297b0fe-c6e1-5ec8-be8b-ae86ef7e13f0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-102941/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "9f60769a-c474-5df2-a5f0-a4e6c2ae1222" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-102941/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "30289461-46e9-5ef9-8b11-55a2e8867812" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-102941/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "bca337de-3e7d-5a8e-a510-694b8a2d39d6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-102941/selection" :answer-field/id #uuid "27799bf1-bca5-58da-b466-826a0456181a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102941/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer-field/choices ["q-102941/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-102941/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-102941/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-102941/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-102941/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9"] :db/ensure [:answer-field/validate]} {:db/id "q-102941" :question/id #uuid "3bd401ff-d3f2-5dd6-97bc-c215e66b66ce" :question/math-academy-id "q-102941" :question/problem "For the parametric curve \n\n$$\nx=4\\operatorname{sin}⁡t,\\,y=\\frac{4}{\\pi }{t}^{2},\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=\\frac{8}{\\pi }t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(\\frac{8}{\\pi }t)}{4\\operatorname{cos}⁡t} \\\\  & =\\frac{2t\\operatorname{sec}⁡t}{\\pi }.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{4},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2(\\frac{\\pi }{4})\\operatorname{sec}⁡(\\frac{\\pi }{4})}{\\pi } \\\\  & =\\frac{(\\frac{\\pi }{2}\\cdot \\sqrt{2})}{\\pi } \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102941/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-102941"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353343/field-1/b2607aa59b56e12969dd03fdf0de12afaf64b769f67265853858b1ae9ad4a163" :answer/id #uuid "f8f0df1c-59f8-5fb3-a90f-3edf0fa39022" :answer/type :answer.type/math :answer/value "\\frac{6}{e^4}" :db/ensure [:answer/validate]} {:db/id "q-353343/field-1/028adb64bf021f5bf891165c8ba41a36f7115530f5f63b9a7dfb0c10193bf0a5" :answer/id #uuid "0301290b-bcce-5d32-8604-51a6d022297d" :answer/type :answer.type/math :answer/value "\\frac{12}{e^4}" :db/ensure [:answer/validate]} {:db/id "q-353343/field-1" :answer-field/id #uuid "7346ccf4-5169-5a07-b874-fcda4e0c4881" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353343/field-1/b2607aa59b56e12969dd03fdf0de12afaf64b769f67265853858b1ae9ad4a163" :answer-field/choices ["q-353343/field-1/b2607aa59b56e12969dd03fdf0de12afaf64b769f67265853858b1ae9ad4a163" "q-353343/field-1/028adb64bf021f5bf891165c8ba41a36f7115530f5f63b9a7dfb0c10193bf0a5"] :db/ensure [:answer-field/validate]} {:db/id "q-353343" :question/id #uuid "b68b9a46-be92-51b0-8b2e-0647767a83a8" :question/math-academy-id "q-353343" :question/problem "For the parametric curve \n\n$$\nx={e}^{2t},\\,y=3{t}^{2},\\,-\\infty <t<\\infty ,\n$$\n\nfind the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=2.$\n\n$\\frac{dy}{dx}{|}_{t\\,=\\,2}=$ \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{e}^{2t},\\,{y}^{′}(t)=6t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{6t}{2{e}^{2t}}=\\frac{3t}{{e}^{2t}}.\n$$\n\nAt the point where $t=2$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx}{|}_{t\\,=\\,2} & =\\frac{3\\cdot 2}{{e}^{4}} \\\\  & =\\frac{6}{{e}^{4}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-353343/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-353343"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353344/field-1/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer/id #uuid "a88b6e0c-2500-50b4-b748-a567f7b9f607" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-353344/field-1" :answer-field/id #uuid "daf0cdb7-46d3-569b-8751-7339d88e553e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353344/field-1/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer-field/choices ["q-353344/field-1/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01"] :db/ensure [:answer-field/validate]} {:db/id "q-353344" :question/id #uuid "7a573e8e-cc66-5b83-9ec6-f3af3369f0e2" :question/math-academy-id "q-353344" :question/problem "For the parametric curve \n\n$$\nx=5t-3,\\,y={t}^{4}+2t,\\,-\\infty <t<\\infty ,\n$$\n\nfind the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$\n\n$\\frac{dy}{dx}{|}_{t\\,=\\,1}=$ \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=5,\\,{y}^{′}(t)=4{t}^{3}+2.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{4{t}^{3}+2}{5}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx}{|}_{t\\,=\\,1} & =\\frac{4(1)^{3}+2}{5} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-353344/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-353344"] :db/ensure [:knowledge-point/validate]}]
