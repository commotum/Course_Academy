TA/Lessons/788/Source/Images/q-139241-a-1.png" :db/id #edb/ref 17592186079987} :answer-field/id #uuid "4efb1c77-89b0-579d-93be-6922aa6e1ddc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186079982}] :question/id #uuid "94b29ebf-6423-546d-bb74-f42fcde7c3c7" :question/math-academy-id "q-139241" :question/problem "Which of the following data sets **might** be normally distributed?"}] [{:db/id #edb/ref 17592186083885 :knowledge-point/_questions [{:knowledge-point/id #uuid "179e0482-8d67-5e28-af2d-0d3aa7f0b770" :knowledge-point/title "Calculating a Probability Given a Normal Distribution Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a2bc962-cdca-53cd-9730-9ea833adcbdb" :answer/type {:db/ident :answer.type/math} :answer/value "0.68" :db/id #edb/ref 17592186082677} {:answer/id #uuid "e7d97763-78f9-554c-8086-427218bb6396" :answer/type {:db/ident :answer.type/math} :answer/value "0.72" :db/id #edb/ref 17592186082678} {:answer/id #uuid "f3ceb49a-d361-5cb7-ab9a-43472af18c60" :answer/type {:db/ident :answer.type/math} :answer/value "0.64" :db/id #edb/ref 17592186082679} {:answer/id #uuid "1a7909b7-6c45-5d2d-a287-12e7b8b5dc5e" :answer/type {:db/ident :answer.type/math} :answer/value "0.60" :db/id #edb/ref 17592186082680} {:answer/id #uuid "7c6cc95c-ac30-5c5b-a632-9f0145159dbd" :answer/type {:db/ident :answer.type/math} :answer/value "0.76" :db/id #edb/ref 17592186082681}] :answer-field/correct {:answer/id #uuid "1a7909b7-6c45-5d2d-a287-12e7b8b5dc5e" :answer/type {:db/ident :answer.type/math} :answer/value "0.60" :db/id #edb/ref 17592186082680} :answer-field/id #uuid "7bb36a8d-ee93-5e42-8618-28085408225b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082676}] :question/id #uuid "3e88079f-9971-5299-9bff-1378eeb1d1dc" :question/math-academy-id "q-94695" :question/problem "> A calculator is required to answer this question.\n\nThe heights (in meters) of the trees in a particular park are normally distributed with a mean of $9m$ and a standard deviation of $4m$. Assuming that the heights of the trees in the park are normally distributed, what is the probability that a randomly selected tree is less than $10m$ tall? Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $z$ | $0.04$ | $0.05$ | $0.06$ |\n| --- | ---: | ---: | ---: |\n| $0.1$ | $0.5557$ | $0.5596$ | $0.5636$ |\n| $0.2$ | $0.5948$ | $0.5987$ | $0.6026$ |\n| $0.3$ | $0.6331$ | $0.6368$ | $0.6406$ |" :question/requires-calculator true}]}
