    {
      "question": "e-7298",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "6e4ca99d9d5c3a266a8fefcae1d99f6bd2cd8e3d93acd9b8955ac339b85fe38c",
      "new_sha256": "f9973c8ef1f8ee299ab1237d26e0b2814eb511f2a3fdb64fdef1a9835c4a6c4f",
      "category": "ma_capture",
