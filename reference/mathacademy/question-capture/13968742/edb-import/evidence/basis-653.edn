#{[{:db/id #edb/ref 17592186259313 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27eb7645-5010-5dcf-be5f-f3f7f7f5073a" :answer/type {:db/ident :answer.type/math} :answer/value "− (312)/(2)" :db/id #edb/ref 17592186271672} {:answer/id #uuid "7077cc7a-6536-5fe2-aedb-058301dabe4d" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186271673} {:answer/id #uuid "4f6c9a88-aabf-56fd-8ba4-865e7043e552" :answer/type {:db/ident :answer.type/math} :answer/value "22464" :db/id #edb/ref 17592186271674} {:answer/id #uuid "d6174fe1-c1c4-5c4c-83bc-ac5bc6a549f7" :answer/type {:db/ident :answer.type/math} :answer/value "− 22464" :db/id #edb/ref 17592186271675} {:answer/id #uuid "2c1131e2-71a6-5846-b9da-769b2d824d8a" :answer/type {:db/ident :answer.type/math} :answer/value "(22464)/(312)" :db/id #edb/ref 17592186271676}] :answer-field/correct {:answer/id #uuid "7077cc7a-6536-5fe2-aedb-058301dabe4d" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186271673} :answer-field/id #uuid "81782276-444b-5c10-aaee-12d111135a7c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274612}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ccac1a80-68f8-53f5-b849-c8a540e70082" :question/math-academy-id "q-288826" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+68x-1\\,041=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=68,\\,c=-1\\,041.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-1\\,041)}{1}=-1\\,041.\\end{aligned}\n$$"}]}
