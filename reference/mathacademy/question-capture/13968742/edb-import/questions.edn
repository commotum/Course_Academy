#{[{:db/id #edb/ref 17592186083553 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d627e43-b793-5a87-bc9a-ce6cb203c9f5" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2 - 12x - 15" :db/id #edb/ref 17592186232687}] :answer-field/correct {:answer/id #uuid "0d627e43-b793-5a87-bc9a-ce6cb203c9f5" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2 - 12x - 15" :db/id #edb/ref 17592186232687} :answer-field/id #uuid "36818d4d-7348-5e15-9d9a-7db94bd07fd6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186080704}] :question/id #uuid "69d79d7f-e14a-514d-84f9-33d07fec4a3c" :question/math-academy-id "q-288103" :question/problem "The quadratic coefficient of a particular quadratic equation equals $3$. The sum of the solutions equals $4$, and the product of the solutions equals $-5$. Find the equation.The equation is\n{{field-1}}\n$= 0$.\n\n---\n\n<a id=\"deriving-vietas-formulas\"></a>"}] [{:db/id #edb/ref 17592186083556 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a002ef7b-1807-597e-90cd-be1fbcf6f2bc" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186080718} {:answer/id #uuid "c825ba6c-4186-56a2-9e19-26288c6c9c8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186080719} {:answer/id #uuid "10364085-735c-5070-969b-e4851112e96d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{9}" :db/id #edb/ref 17592186080720} {:answer/id #uuid "46261e0a-e4c2-5a53-b145-a912a27bdcad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{9}" :db/id #edb/ref 17592186080721} {:answer/id #uuid "7e8e8a3f-65e0-55db-aec4-33f9cd0efa65" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186080722}] :answer-field/correct {:answer/id #uuid "a002ef7b-1807-597e-90cd-be1fbcf6f2bc" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186080718} :answer-field/id #uuid "d4a3762b-ddc8-5a1f-ad77-75252238e3eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080717}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2145d449-33d6-569e-b25a-b8ddea914c99" :question/math-academy-id "q-288815" :question/problem "Consider the quadratic equation\n\n$9x^{2} + 7x - 27 = 0$.\n**Without** solving the equation, determine the product of its solutions."}] [{:db/id #edb/ref 17592186259313 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27eb7645-5010-5dcf-be5f-f3f7f7f5073a" :answer/type {:db/ident :answer.type/math} :answer/value "− (312)/(2)" :db/id #edb/ref 17592186271672} {:answer/id #uuid "7077cc7a-6536-5fe2-aedb-058301dabe4d" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186271673} {:answer/id #uuid "4f6c9a88-aabf-56fd-8ba4-865e7043e552" :answer/type {:db/ident :answer.type/math} :answer/value "22464" :db/id #edb/ref 17592186271674} {:answer/id #uuid "d6174fe1-c1c4-5c4c-83bc-ac5bc6a549f7" :answer/type {:db/ident :answer.type/math} :answer/value "− 22464" :db/id #edb/ref 17592186271675} {:answer/id #uuid "2c1131e2-71a6-5846-b9da-769b2d824d8a" :answer/type {:db/ident :answer.type/math} :answer/value "(22464)/(312)" :db/id #edb/ref 17592186271676}] :answer-field/correct {:answer/id #uuid "7077cc7a-6536-5fe2-aedb-058301dabe4d" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186271673} :answer-field/id #uuid "81782276-444b-5c10-aaee-12d111135a7c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274612}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ccac1a80-68f8-53f5-b849-c8a540e70082" :question/math-academy-id "q-288826" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+68x-1\\,041=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=68,\\,c=-1\\,041.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-1\\,041)}{1}=-1\\,041.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083558 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27bd4fc5-abc9-5bad-aad9-a622a10cd840" :answer/type {:db/ident :answer.type/math} :answer/value "x^2 - 7x + 12" :db/id #edb/ref 17592186232688}] :answer-field/correct {:answer/id #uuid "27bd4fc5-abc9-5bad-aad9-a622a10cd840" :answer/type {:db/ident :answer.type/math} :answer/value "x^2 - 7x + 12" :db/id #edb/ref 17592186232688} :answer-field/id #uuid "e536e678-e75f-521e-957c-7018ce3866e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186080729}] :question/id #uuid "e033634a-5ad2-523d-9809-7041a9291402" :question/math-academy-id "q-288848" :question/problem "The quadratic coefficient of a particular quadratic equation equals $1$. The sum of the solutions equals $7$, and the product of the solutions equals $12$. Find the equation.The equation is\n{{field-1}}\n$= 0$."}]}
