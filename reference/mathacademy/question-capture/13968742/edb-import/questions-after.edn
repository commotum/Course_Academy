#{[{:db/id #edb/ref 17592186083553 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d627e43-b793-5a87-bc9a-ce6cb203c9f5" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2 - 12x - 15" :db/id #edb/ref 17592186232687}] :answer-field/correct {:answer/id #uuid "0d627e43-b793-5a87-bc9a-ce6cb203c9f5" :answer/type {:db/ident :answer.type/math} :answer/value "3x^2 - 12x - 15" :db/id #edb/ref 17592186232687} :answer-field/id #uuid "36818d4d-7348-5e15-9d9a-7db94bd07fd6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186080704}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "69d79d7f-e14a-514d-84f9-33d07fec4a3c" :question/math-academy-id "q-288103" :question/problem "The quadratic coefficient of a particular quadratic equation equals $3.$ The sum of the solutions equals $4,$ and the product of the solutions equals $-5.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $3.$ Therefore, we have\n\n$$\na=3.\n$$\n\n- We're told that the sum of the roots equals $4.$ Therefore, we have\n\n$$\n\\begin{aligned}4 & =-\\frac{b}{a} \\\\ 4 & =-\\frac{b}{3} \\\\ -12 & =b \\\\ b & =-12.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $-5.$ Therefore, we have\n\n$$\n\\begin{aligned}-5 & =\\frac{c}{a} \\\\ -5 & =\\frac{c}{3} \\\\ -15 & =c \\\\ c & =-15.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=3,\\,b=-12,\\,c=-15\n$$\n\nand the equation is\n\n$$\n3{x}^{2}-12x-15=0.\n$$"}] [{:db/id #edb/ref 17592186083556 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a002ef7b-1807-597e-90cd-be1fbcf6f2bc" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186080718} {:answer/id #uuid "c825ba6c-4186-56a2-9e19-26288c6c9c8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186080719} {:answer/id #uuid "10364085-735c-5070-969b-e4851112e96d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{9}" :db/id #edb/ref 17592186080720} {:answer/id #uuid "46261e0a-e4c2-5a53-b145-a912a27bdcad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{9}" :db/id #edb/ref 17592186080721} {:answer/id #uuid "7e8e8a3f-65e0-55db-aec4-33f9cd0efa65" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186080722}] :answer-field/correct {:answer/id #uuid "a002ef7b-1807-597e-90cd-be1fbcf6f2bc" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186080718} :answer-field/id #uuid "d4a3762b-ddc8-5a1f-ad77-75252238e3eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080717}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2145d449-33d6-569e-b25a-b8ddea914c99" :question/math-academy-id "q-288815" :question/problem "Consider the quadratic equation\n\n$$\n9{x}^{2}+7x-27=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=9,\\,b=7,\\,c=-27.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-27)}{9}=-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259313 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bd40164-3cea-57ff-bf91-53a8ed0e8af8" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186277335} {:answer/id #uuid "4d882fa1-7951-570e-a6b1-81d699d9c470" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\cdot 1\\,041" :db/id #edb/ref 17592186277336} {:answer/id #uuid "84ec2da1-0525-5634-b342-342f070906ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-1\\,041}{68}" :db/id #edb/ref 17592186277337} {:answer/id #uuid "545396ac-8dfe-5b08-b1e7-2705842a8a55" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,041" :db/id #edb/ref 17592186277338} {:answer/id #uuid "cef7fc8d-1539-5957-ab2d-874f1ae06e6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{68}{2}" :db/id #edb/ref 17592186277339}] :answer-field/correct {:answer/id #uuid "7bd40164-3cea-57ff-bf91-53a8ed0e8af8" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\,041" :db/id #edb/ref 17592186277335} :answer-field/id #uuid "31807062-01e3-53c0-ad59-144335cfcb6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277334}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ccac1a80-68f8-53f5-b849-c8a540e70082" :question/math-academy-id "q-288826" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+68x-1\\,041=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=68,\\,c=-1\\,041.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-1\\,041)}{1}=-1\\,041.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186277340 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "606d13c4-b4ee-5567-839d-9c2cbdfc938e" :answer/type {:db/ident :answer.type/math} :answer/value "4x^2-36x+40" :db/id #edb/ref 17592186277342} {:answer/id #uuid "e6576356-a247-54de-8a03-04e963ab908d" :answer/type {:db/ident :answer.type/math} :answer/value "4x^2+36x+40" :db/id #edb/ref 17592186277343}] :answer-field/correct {:answer/id #uuid "e6576356-a247-54de-8a03-04e963ab908d" :answer/type {:db/ident :answer.type/math} :answer/value "4x^2+36x+40" :db/id #edb/ref 17592186277343} :answer-field/id #uuid "7eb1caab-a383-5912-84c4-e09bac0bd974" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186277341}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "76b12fa5-6503-51c0-83e1-68af7b86682a" :question/math-academy-id "q-288828" :question/problem "The quadratic coefficient of a particular quadratic equation equals $4.$ The sum of the solutions equals $-9,$ and the product of the solutions equals $10.$ Find the equation.\n\nThe equation is\n{{field-1}}  \n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $4.$ Therefore, we have\n\n$$\na=4.\n$$\n\n- We're told that the sum of the roots equals $-9.$ Therefore, we have\n\n$$\n\\begin{aligned}-9 & =-\\frac{b}{a} \\\\ -9 & =-\\frac{b}{4} \\\\ 36 & =b \\\\ b & =36.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $10.$ Therefore, we have\n\n$$\n\\begin{aligned}10 & =\\frac{c}{a} \\\\ 10 & =\\frac{c}{4} \\\\ 40 & =c \\\\ c & =40.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=4,\\,b=36,\\,c=40\n$$\n\nand the equation is\n\n$$\n4{x}^{2}+36x+40=0.\n$$"}] [{:db/id #edb/ref 17592186083558 :knowledge-point/_questions [{:knowledge-point/id #uuid "18c41022-916d-5d5c-89e6-ebfdc56f8fe3" :knowledge-point/title "Constructing a Quadratic Equation With a Given Sum and Product of Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27bd4fc5-abc9-5bad-aad9-a622a10cd840" :answer/type {:db/ident :answer.type/math} :answer/value "x^2 - 7x + 12" :db/id #edb/ref 17592186232688}] :answer-field/correct {:answer/id #uuid "27bd4fc5-abc9-5bad-aad9-a622a10cd840" :answer/type {:db/ident :answer.type/math} :answer/value "x^2 - 7x + 12" :db/id #edb/ref 17592186232688} :answer-field/id #uuid "e536e678-e75f-521e-957c-7018ce3866e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186080729}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e033634a-5ad2-523d-9809-7041a9291402" :question/math-academy-id "q-288848" :question/problem "The quadratic coefficient of a particular quadratic equation equals $1.$ The sum of the solutions equals $7,$ and the product of the solutions equals $12.$ Find the equation.\n\nThe equation is\n{{field-1}}\n$=0.$" :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nNow, let's use the given information to determine the values of $a,b,$ and $c$ in this case:\n\n- We're told that the quadratic coefficient equals $1.$ Therefore, we have\n\n$$\na=1.\n$$\n\n- We're told that the sum of the roots equals $7.$ Therefore, we have\n\n$$\n\\begin{aligned}7 & =-\\frac{b}{a} \\\\ 7 & =-\\frac{b}{1} \\\\ -7 & =b \\\\ b & =-7.\\end{aligned}\n$$\n\n- We're told that the product of the roots equals $12.$ Therefore, we have\n\n$$\n\\begin{aligned}12 & =\\frac{c}{a} \\\\ 12 & =\\frac{c}{1} \\\\ c & =12.\\end{aligned}\n$$\n\nTherefore, our equation has coefficients\n\n$$\na=1,\\,b=-7,\\,c=12\n$$\n\nand the equation is\n\n$$\n{x}^{2}-7x+12=0.\n$$"}]}
