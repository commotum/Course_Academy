4139533959 true] [17592186268935 1100 "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}3 \\\\ -1\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}-2 \\\\ 5\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" 13194139533959 true] [17592186268935 1113 #uuid "274e3fef-d560-53be-a236-cc5dab5cc853" 13194139533959 true] [17592186268935 1145 "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & -2 \\\\ -1 & 5\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & -2 \\\\ -1 & 5\\end{aligned}| \\\\  & =3\\cdot 5-(-2)\\cdot (-1) \\\\  & =15-2 \\\\  & =13\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,13\\,|=13\n$$" 13194139533959 true] [17592186268936 1000 #edb/ref 17592186268937 13194139533959 true] [17592186268936 1040 #edb/ref 17592186045449 13194139533959 true] [17592186268936 1041 "field-1" 13194139533959 true] [17592186268936 1104 #edb/ref 17592186268937 13194139533959 true] [17592186268936 1110 #uuid "04afbf7d-4faa-596d-aa8f-7adff8c73e30" 13194139533959 true] [17592186268937 1034 "13" 13194139533959 true] [17592186268937 1103 #edb/ref 17592186045453 13194139533959 true] [17592186268937 1111 #uuid "a11aae4e-eb2a-53b9-b729-aa97885f2131" 13194139533959 true] [17592186268938 1017 #edb/ref 17592186268939 13194139533959 true] [17592186268938 1089 "q-320404" 13194139533959 true] [17592186268938 1091 #edb/ref 17592186045465 13194139533959 true] [17592186268938 1100 "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}-1 \\\\ 7\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ -2\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" 13194139533959 true] [17592186268938 1113 #uuid "f54067a6-f53a-5656-9593-311f98e72e1a" 13194139533959 true] [17592186268938 1145 "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-1 & 5 \\\\ 7 & -2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-1 & 5 \\\\ 7 & -2\\end{aligned}| \\\\  & =(-1)\\cdot (-2)-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-33\\,|=33\n$$" 13194139533959 true] [17592186268939 1000 #edb/ref 17592186268940 13194139533959 true] [17592186268939 1040 #edb/ref 17592186045449 13194139533959 true] [17592186268939 1041 "field-1" 13194139533959 true] [17592186268939 1104 #edb/ref 17592186268940 13194139533959 true] [17592186268939 1110 #uuid "efff2605-94f6-5a4e-88c1-f83e42ea0768" 13194139533959 true] [17592186268940 1034 "33" 13194139533959 true] [17592186268940 1103 #edb/ref 17592186045453 13194139533959 true] [17592186268940 1111 #uuid "c45b96d2-b645-5a9c-aa26-0c336a305d6d" 13194139533959 true] [17592186268941 1017 #edb/ref 17592186268942 13194139533959 true] [17592186268941 1089 "q-320414" 13194139533959 true] [17592186268941 1091 #edb/ref 17592186045463 13194139533959 true] [17592186268941 1100 "Determine the area $A$ of the parallelogram spanned by $\\text{u}=⟨5,-3⟩$ and $\\text{v}=⟨-2,-4⟩.$\n\n$\\,\\,A=$ {{field-1}}" 13194139533959 true] [17592186268941 1113 #uuid "9b66f910-5a64-5418-84e8-a9c1f64a8580" 13194139533959 true] [17592186268941 1145 "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}5 & -2 \\\\ -3 & -4\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}5 & -2 \\\\ -3 & -4\\end{aligned}| \\\\  & =5\\cdot (-4)-(-2)\\cdot (-3) \\\\  & =-20-6 \\\\  & =-26\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-26\\,|=26\n$$" 13194139533959 true] [17592186268942 1000 #edb/ref 17592186268943 13194139533959 true] [17592186268942 1040 #edb/ref 17592186045449 13194139533959 true] [17592186268942 1041 "field-1" 13194139533959 true] [17592186268942 1104 #edb/ref 17592186268943 13194139533959 true] [17592186268942 1110 #uuid "0be4675c-ec1c-5914-a675-19ea56bb7d63" 13194139533959 true] [17592186268943 1034 "26" 13194139533959 true] [17592186268943 1103 #edb/ref 17592186045453 13194139533959 true] [17592186268943 1111 #uuid "a1febe55-9388-5935-be82-8638fbfc1303" 13194139533959 true] [17592186268944 1017 #edb/ref 17592186268945 13194139533959 true] [17592186268944 1089 "q-320557" 13194139533959 true] [17592186268944 1091 #edb/ref 17592186045465 13194139533959 true] [17592186268944 1100 "Given that the area spanned between the vectors $\\text{u}=[\\begin{aligned}2\\sqrt{2} \\\\ 3\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}a \\\\ 6\\end{aligned}]$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" 13194139533959 true] [17592186268944 1113 #uuid "f2a974ab-e642-5854-9835-4feb37d0563f" 13194139533959 true] [17592186268944 1145 "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}2\\sqrt{2} & a \\\\ 3 & 6\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}2\\sqrt{2} & a \\\\ 3 & 6\\end{aligned}| \\\\  & =(2\\sqrt{2})\\cdot 6-a\\cdot 3 \\\\  & =12\\sqrt{2}-3a\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}12\\sqrt{2}-3a & =0 \\\\ -3a & =-12\\sqrt{2} \\\\ a & =4\\sqrt{2}.\\end{aligned}\n$$" 13194139533959 true] [17592186268945 1000 #edb/ref 17592186268946 13194139533959 true] [17592186268945 1000 #edb/ref 17592186268947 13194139533959 true] [17592186268945 1040 #edb/ref 17592186045449 13194139533959 true] [17592186268945 1041 "field-1" 13194139533959 true] [17592186268945 1104 #edb/ref 17592186268946 13194139533959 true] [17592186268945 1110 #uuid "08592ac8-726f-534c-84c0-