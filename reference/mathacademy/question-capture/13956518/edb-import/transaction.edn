[{:db/id "q-320404/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer/id #uuid "c45b96d2-b645-5a9c-aa26-0c336a305d6d" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "q-320404/field-1" :answer-field/id #uuid "efff2605-94f6-5a4e-88c1-f83e42ea0768" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320404/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer-field/choices ["q-320404/field-1/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9"] :db/ensure [:answer-field/validate]} {:db/id "q-320404" :question/id #uuid "f54067a6-f53a-5656-9593-311f98e72e1a" :question/math-academy-id "q-320404" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}-1 \\\\ 7\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ -2\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-1 & 5 \\\\ 7 & -2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-1 & 5 \\\\ 7 & -2\\end{aligned}| \\\\  & =(-1)\\cdot (-2)-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-33\\,|=33\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320404/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408"] :knowledge-point/questions ["q-320404"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13944/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "13f5cda8-bdfc-5d85-838a-66fa58675f96" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-13944