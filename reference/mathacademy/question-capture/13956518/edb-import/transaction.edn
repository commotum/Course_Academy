(M) & =|\\begin{aligned}\\sqrt{2} & 2 \\\\ 1 & \\sqrt{2}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}-2\\cdot 1 \\\\  & =2-2 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102756/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166"] :knowledge-point/questions ["q-102756"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69943/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b690d5b6-7ccb-53dc-9b90-fb6c02ddf6a2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-69943/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "90306f28-f1d2-5622-bfd0-6d6380e61ef3" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-69943/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "094d5851-7aa6-53e8-8ba4-a2529411785d" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-69943/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6f3bf6a7-3708-5c18-9721-6fe778af5c99" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-69943/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "0484dbf2-9846-5ef3-9c44-acdd5378063f" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-69943/selection" :answer-field/id #uuid "8a4802a3-06aa-5a6f-8b8d-5043fc04882b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69943/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choice