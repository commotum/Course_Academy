\frac{\\pi }{2})] \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348719" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/activity-metadata.json" "file_sha256" "4630758fe7518876b4078da53f63d140afc115ff54e30376f6c8b26fc3d8c081"} {"question" "q-348719" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348719" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348727" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/assets/0817984c94a989cc5d0801c829e9c0479c7afb30223450faea46ec486b4494c6.png)\n\nFind the area $A$ of the region in the $xy$-plane that is bounded by the curve $y=-5{cos}^{2}\\,(\\frac{x}{2})+5{sin}^{2}\\,(\\frac{x}{2})+4x+7,$ the $x$-axis and the lines $x=-\\frac{\\pi }{2}$ and $x=0,$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348727" "field" nil "attribute" "question/worked-solution" "value" "The area of the region is given by\n\n$$\nA={\\int }_{-\\pi /2}^{0}(-5{cos}^{2}\\,(\\frac{x}{2})+5{sin}^{2}\\,(\\frac{x}{2})+4x+7)\\,\\text{d}x.\n$$\n\nTo calculate this integral, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2x={cos}^{2}⁡x-{sin}^{2}⁡x\n$$\n\nWe can rewrite the above formula as\n\n$$\n-5\\operatorname{cos}⁡x=-5{cos}^{2}\\,(\\frac{x}{2})+5{sin}^{2}\\,(\\frac{x}{2}).\n$$\n\nHence, the area of the region is\n\n$$\n\\begin{aligned}A & ={\\int }_{-\\pi /2}^{0}(-5{cos}^{2}\\,(\\frac{x}{2})+5{sin}^{2}\\,(\\frac{x}{2})+4x+7)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi /2}^{0}(-5\\operatorname{cos}⁡x+4x+7)\\,\\text{d}x \\\\  & =(-5\\operatorname{sin}⁡x+2{x}^{2}+7x)\\,{|}_{-\\pi /2}^{0} \\\\  & =[-5\\operatorname{sin}⁡0+2(0)^{2}+7\\cdot 0]-[-5\\operatorname{sin}⁡(-\\frac{\\pi }{2})+2{(-\\frac{\\pi }{2})}^{2}+7(-\\frac{\\pi }{2})] \\\\  & =0-[5+\\frac{{\\pi }^{2}}{2}-\\frac{7\\pi }{2}] \\\\  & =-5-\\frac{{\\pi }^{2}}{2}+\\frac{7\\pi }{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348727" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/activity-metadata.json" "file_sha256" "4630758fe7518876b4078da53f63d140afc115ff54e30376f6c8b26fc3d8c081"} {"question" "q-348727" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-348727" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{7\\pi}{2}-\\frac{\\pi^2}{2}-5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-114688" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{0}^{\\pi /4}({sin}^{2}⁡4x-{cos}^{2}⁡4x)\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-114688" "field" nil "attribute" "question/worked-solution" "value" "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =4x,$ we get\n\n$$\n\\operatorname{cos}⁡8x={cos}^{2}⁡4x-{sin}^{2}⁡4x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}({sin}^{2}⁡4x-{cos}^{2}⁡4x)\\text{d}x & =-{\\int }_{0}^{\\pi /4}({cos}^{2}⁡4x-{sin}^{2}⁡4x)\\text{d}x \\\\  & =-{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡8x\\,\\text{d}x \\\\  & =-\\frac{1}{8}\\operatorname{sin}⁡8x\\,{|}_{0}^{\\pi /4} \\\\  & =-\\frac{1}{8}[\\operatorname{sin}⁡(8\\cdot \\frac{\\pi }{4})-\\operatorname{sin}⁡(8\\cdot 0)] \\\\  & =-\\frac{1}{8}[\\operatorname{sin}⁡2\\pi -\\operatorname{sin}⁡0] \\\\  & =-\\frac{1}{8}(0-0) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/state.json" "file_sha256" "f0cb13d088b022db56deb1f0839d4c465912f56d5e2acf5c345df70dcd9ae9bb"} {"question" "q-114688" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008673/activity-metadata.json" "file_sha256" "4630758fe7518876b4078da53f63d140afc115ff54