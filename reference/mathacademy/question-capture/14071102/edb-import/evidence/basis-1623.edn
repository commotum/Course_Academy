#{[{:db/id #edb/ref 17592186320866 :knowledge-point/_questions [{:knowledge-point/id #uuid "bc50a680-dbf8-5d45-a8c3-72c3c15243f6" :knowledge-point/title "Identifying First-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee48ef50-7901-5968-8c6e-3ce826fd0abf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-{x}^{3}y=\\frac{x}{1+y}" :db/id #edb/ref 17592186320868} {:answer/id #uuid "56a4decd-d69f-5134-a279-4ab7bfe6d830" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{\\text{d}y}{\\text{d}x})}^{2}+{x}^{2}y=\\operatorname{sin}⁡x" :db/id #edb/ref 17592186320869} {:answer/id #uuid "b27cb28d-67df-56bb-b535-e57e5c99630d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(xy)=x-1" :db/id #edb/ref 17592186320870} {:answer/id #uuid "3858e614-0306-5bff-bc1c-7bc4762692d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-3(\\operatorname{ln}⁡x)y=\\frac{1}{x}" :db/id #edb/ref 17592186320871} {:answer/id #uuid "d0219253-1153-52cd-bc9a-45727be4ddec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}-xy={x}^{3}" :db/id #edb/ref 17592186320872}] :answer-field/correct {:answer/id #uuid "3858e614-0306-5bff-bc1c-7bc4762692d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}-3(\\operatorname{ln}⁡x)y=\\frac{1}{x}" :db/id #edb/ref 17592186320871} :answer-field/id #uuid "23eb2ba6-4d1b-5c75-adbb-ad24e70a7072" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320867}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "16833ba9-454a-5aa5-8648-06e8c0ad9832" :question/math-academy-id "q-103551" :question/problem "Which of the following is a first-order linear ordinary differential equation?" :question/worked-solution "To determine which of the following differential equations is a first-order linear ordinary differential equation, we attempt to write each option in the standard form.\n\nA first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nNote that the option\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3(\\operatorname{ln}⁡x)y=\\frac{1}{x}\n$$\n\nis already is written in standard form with  $P(x)=-3\\operatorname{ln}⁡x$ and $Q(x)=\\frac{1}{x}.$ Since the equation is written in standard form, we conclude that it is a first-order linear ODE.\n\nAll of the other equations cannot be written in the standard form, and therefore they are not first-order linear ODEs."}]}
