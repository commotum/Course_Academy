 & 0 & 4 & -6\\end{aligned}].$\n\n| $4F-\\frac{1}{2}G=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} |  |\n| --- | --- | --- | --- | --- | --- | --- |" :question/worked-solution "We multiply each entry of $F$ by $4$ and each entry of $G$ by $\\frac{1}{2},$ and then subtract the resulting matrices, as follows:\n\n$$\n\\begin{aligned}4F-\\frac{1}{2}G & =4[\\begin{aligned}4 & -1 & 0 & 2\\end{aligned}]-\\frac{1}{2}[\\begin{aligned}2 & 0 & 4 & -6\\end{aligned}] \\\\  & =[\\begin{aligned}4\\cdot 4 & 4\\cdot (-1) & 4\\cdot 0 & 4\\cdot 2\\end{aligned}]-[\\begin{aligned}\\frac{1}{2}\\cdot 2 & \\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot (-6)\\end{aligned}] \\\\  & =[\\begin{aligned}16 & -4 & 0 & 8\\end{aligned}]-[\\begin{aligned}1 & 0 & 2 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}16-1 & -4-0 & 0-2 & 8-(-3)\\end{aligned}] \\\\  & =[\\begin{aligned}15 & -4 & -2 & 11\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276595 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2ca681d-bde3-5944-a3c7-e4aad94aca18" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276597}] :answer-field/correct {:answer/id #uuid "c2ca681d-bde3-5944-a3c7-e4aad94aca18" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276597} :answer-field/id #uuid "394ae0d1-880e-5909-bdb3-571cf96b2d44" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276596} {:answer-field/choices [{:answer/id #uuid "413692e8-ef77-5b5f-aefd-cbe234cbebd3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276599}] :answer-field/correct {:answer/id #uuid "413692e8-ef77-5b5f-aefd-cbe234cbebd3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276599} :answer-field/id #uuid "c8445eb0-4f07-569a-8be7-50d137ad14cc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276598} {:answer-field/choices [{:answer/id #uuid "e4d95303-62b4-5032-bdb9-a7e667d3aaab" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276601}] :answer-field/correct {:answer/id #uuid "e4d95303-62b4-5032-bdb9-a7e667d3aaab" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276601} :answer-field/id #uuid "ff8609d3-4da8-5ca5-bf91-386374d61428" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276600} {:answer-field/choices [{:answer/id #uuid "7f6ee2ba-b55e-5d80-b6cd-2f05b7e6e957" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186276603}] :answer-field/correct {:answer/id #uuid "7f6ee2ba-b55e-5d80-b6cd-2f05b7e6e957" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186276603} :answer-field/id #uuid "257642ca-fff8-5703-9afa-c499cb1d88f8" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276602}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "fe098a6b-49f6-50de-bb47-3334b8da3ed2" :question/math-academy-id "q-320671" :question/problem "Calculate $\\frac{2}{3}M+2N$, where\n$M=[\\begin{aligned}6 & 0 & 15 \\\\ -12 & 6 & 0\\end{aligned}]$\nand\n$N=[\\begin{aligned}3 & -1 & 0 \\\\ -2 & \\frac{1}{2} & -1\\end{aligned}].$\n\n| $\\frac{2}{3}M+2N=\\,\\,$ |  | {{field-1}} | $-2$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- |\n|  | $-12$ | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We multiply each entry of $M$ by $\\frac{2}{3}$ and each entry of $N$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}\\frac{2}{3}M+2N & =\\frac{2}{3}[\\begin{aligned}6 & 0 & 15 \\\\ -12 & 6 & 0\\end{aligned}]+2[\\begin{aligned}3 & -1 & 0 \\\\ -2 & \\frac{1}{2} & -1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{3}\\cdot 6 & \\frac{2}{3}\\cdot 0 & \\frac{2}{3}\\cdot 15 \\\\ \\frac{2}{3}\\cdot (-12) & \\frac{2}{3}\\cdot 6 & \\frac{2}{3}\\cdot 0\\end{aligned}]+[\\begin{aligned}2\\cdot 3 & 2\\cdot (-1) & 2\\cdot 0 \\\\ 2\\cdot (-2) & 2\\cdot \\frac{1}{2} & 2\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 0 & 10 \\\\ -8 & 4 & 0\\end{aligned}]+[\\begin{aligned}6 & -2 & 0 \\\\ -4 & 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4+6 & 0-2 & 10+0 \\\\ -8-4 & 4+1 & 0-2\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -2 & 10 \\\\ -12 & 5 & -2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276604 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba43e0e5-cc62-569c-9de5-af74153de1e5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 15 & 6 \\\\ 2 & 14 & 11\\end{aligned}]" :db/id #edb/ref 17592186276606} {:answer/id #uuid "78f5c1e8-0100-5d0f-a2f6-a39b8ddc3684" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186276607} {:answer/id #uuid "d3860be9-7706-5ad0-94f6-9533b76939af" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 14 \\\\ 2 & 11 & 15\\end{aligned}]" :db/id #edb/ref 17592186276608} {:answer/id #uuid "c7e566e6-6256-5142-9f11-9992539d74ea" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 & 5 \\\\ 2 & 11 & 10\\end{aligned}]" :db/id #edb/ref 17592186276609} {:answer/id #uuid "abccf42a-2c96-5978-b121-76bb461f3e88" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 & 15 \\\\ -2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186276610}] :answer-field/correct {:answer/id #uuid "78f5c1e8-0100-5d0f-a2f6-a39b8ddc3684" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186276607} :answer-field/id #uuid "7c3b5e71-70a0-5e20-9331-3e9a5aed5902" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276605}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6a24360c-add3-5cc0-aec3-f47a46ccf0fe" :question/math-academy-id "q-69642" :question/problem "Calculate $\\frac{1}{3}G+2H$, where\n$G=[\\begin{aligned}3 & 6 & 15 \\\\ -12 & 9 & 6\\end{aligned}]$\nand\n$H=[\\begin{aligned}1 & 2 & 5 \\\\ 3 & 4 & 6\\end{aligned}].$" :question/worked-solution "We multiply each entry of $G$ by $\\frac{1}{3}$ and each entry of $H$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}G+2H & =\\frac{1}{3}[\\begin{aligned}3 & 6 & 15 \\\\ -12 & 9 & 6\\end{aligned}]+2[\\begin{aligned}1 & 2 & 5 \\\\ 3 & 4 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3}\\cdot 3 & \\frac{1}{3}\\cdot 6 & \\frac{1}{3}\\cdot 15 \\\\ \\frac{1}{3}\\cdot (-12) & \\frac{1}{3}\\cdot 9 & \\frac{1}{3}\\cdot 6\\end{aligned}]+[\\begin{aligned}2\\cdot 1 & 2\\cdot 2 & 2\\cdot 5 \\\\ 2\\cdot 3 & 2\\cdot 4 & 2\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 & 5 \\\\ -4 & 3 & 2\\end{aligned}]+[\\begin{aligned}2 & 4 & 10 \\\\ 6 & 8 & 12\\end{aligned}] \\\\  & =[\\begin{aligned}1+2 & 2+4 & 5+10 \\\\ -4+6 & 3+8 & 2+12\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276611 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90f0eb6d-e9cd-5129-9346-01895e7a3296" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186276613} {:answer/id #uuid "348ab7aa-8252-5c27-bf2d-872871e59117" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186276614} {:answer/id #uuid "5747643e-d378-5f18-92a2-2ac79293308d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186276615} {:answer/id #uuid "009c9ba8-354b-5ed8-8f7e-6e0fc8e0bf12" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186276616} {:answer/id #uuid "6da45597-6474-5cb2-8df3-1f20502d1d88" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186276617}] :answer-field/correct {:answer/id #uuid "90f0eb6d-e9cd-5129-9346-01895e7a3296" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186276613} :answer-field/id #uuid "775699ea-f9ef-52a8-bd61-5668455a8089" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276612}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ae3a2204-8f9d-563a-bd2e-12f068c1657e" :question/math-academy-id "q-69670" :question/problem "If $kS=[\\begin{aligned}63 & -28 \\\\ 0 & -56\\end{aligned}]$,\nwhere $S=[\\begin{aligned}-9 & 4 \\\\ 0 & 8\\end{aligned}]$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kS,$ we multiply each entry of $S$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kS & =k[\\begin{aligned}-9 & 4 \\\\ 0 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}-9k & 4k \\\\ 0 & 8k\\end{aligned}]\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kS$ in the problem statement:\n\n$$\n[\\begin{aligned}-9k & 4k \\\\ 0 & 8k\\end{aligned}]=[\\begin{aligned}63 & -28 \\\\ 0 & -56\\end{aligned}]\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $-9k$ and $63.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-9k & =63 \\\\ k & =-7.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186276618 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4cc58a6-ebb8-544d-93a1-de6cbd5b180e" :knowledge-point/title "Multiplying a Matrix by a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36759e4e-8ecc-500f-a64f-ad5c55ad3a17" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -15 \\\\ 6 & 3\\end{aligned}]" :db/id #edb/ref 17592186276620} {:answer/id #uuid "b712ae50-087a-5088-8035-83a0dd344612" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -5 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186276621} {:answer/id #uuid "c2dbef2c-4d3c-53fd-82e4-b55deca8fd69" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -15 \\\\ -6 & 3\\end{aligned}]" :db/id #edb/ref 17592186276622} {:answer/id #uuid "4564bfaf-08ea-51ed-b9e3-1d0f32a8d4bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -15 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186276623} {:answer/id #uuid "b192e9f6-7e78-540f-b6f7-da33d1058cfa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -15 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186276624}] :answer-field/correct {:answer/id #uuid "b192e9f6-7e78-540f-b6f7-da33d1058cfa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & -15 \\\\ -6 & 1\\end{aligned}]" :db/id #edb/ref 17592186276624} :answer-field/id #uuid "13cfe17e-b37f-5630-9873-3ea90d524341" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276619}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7ca2b341-0046-5b87-806c-c651fbf810f5" :question/math-academy-id "q-980" :question/problem "$3[\\begin{aligned}4 & -5 \\\\ -2 & \\frac{1}{3}\\end{aligned}]=$" :question/worked-solution "We multiply each entry of the matrix by $3$, as follows:\n\n$$\n\\begin{aligned}3[\\begin{aligned}4 & -5 \\\\ -2 & \\frac{1}{3}\\end{aligned}] & =[\\begin{aligned}3\\cdot 4 & 3\\cdot (-5) \\\\ 3\\cdot (-2) & 3\\cdot \\frac{1}{3}\\end{aligned}] \\\\  & =[\\begin{aligned}12 & -15 \\\\ -6 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060380 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a929322d-38ac-5c3b-9892-953474fb323f" :answer/type {:db/ident :answer.type/math} :answer/value "k = 6" :db/id #edb/ref 17592186059264} {:answer/id #uuid "c27d8d2f-ac22-5133-ba31-77573492c9b6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 4" :db/id #edb/ref 17592186059265} {:answer/id #uuid "362e8327-2ba5-5ede-a954-c35c493e8aa4" :answer/type {:db/ident :answer.type/math} :answer/value "k = 5" :db/id #edb/ref 17592186059266} {:answer/id #uuid "43cdba9f-f44b-5174-a439-8b27921aea09" :answer/type {:db/ident :answer.type/math} :answer/value "k = 3" :db/id #edb/ref 17592186059267} {:answer/id #uuid "66bdc008-3b58-5b49-8309-d02e8d0741d6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 7" :db/id #edb/ref 17592186059268}] :answer-field/correct {:answer/id #uuid "66bdc008-3b58-5b49-8309-d02e8d0741d6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 7" :db/id #edb/ref 17592186059268} :answer-field/id #uuid "5dc5417f-2c5b-5ed8-9c28-ef6bda87bbf7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059263}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "00d4f637-689d-5f49-8309-b4f927af6909" :question/math-academy-id "q-981" :question/problem "If $kA=[\\begin{aligned}-7 & -21 & 56\\end{aligned}]$,\nwhere $A=[\\begin{aligned}-1 & -3 & 8\\end{aligned}]$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot [\\begin{aligned}-1 & -3 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}-k & -3k & 8k\\end{aligned}]\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n[\\begin{aligned}-k & -3k & 8k\\end{aligned}]=[\\begin{aligned}-7 & -21 & 56\\end{aligned}]\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the leftmost elements, $-k$ and $-7.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-k & =-7 \\\\ k & =7.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}]}
