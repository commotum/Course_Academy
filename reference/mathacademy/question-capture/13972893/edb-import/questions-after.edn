2-7bda-5224-92f5-afbdd2791e3d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186276574} :answer-field/id #uuid "820d6dba-a46e-57ba-8f34-e09850ad92e5" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276573}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8fa3370c-7891-5b8f-bc84-db97ff9a43cf" :question/math-academy-id "q-320082" :question/problem "Calculate $2C$, where\n$C=[\\begin{aligned}1 & 2 \\\\ -2 & 4\\end{aligned}].$\n\n| $2C=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We multiply each entry of $C$ by $2,$ as follows:\n\n$$\n\\begin{aligned}2C & =2[\\begin{aligned}1 & 2 \\\\ -2 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot 1 & 2\\cdot 2 \\\\ 2\\cdot (-2) & 2\\cdot 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 4 \\\\ -4 & 8\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276575 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4fd96a-0e3c-5f19-89f1-f1b3e16609f2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276577}] :answer-field/correct {:answer/id #uuid "0e4fd96a-0e3c-5f19-89f1-f1b3e16609f2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186276577} :answer-field/id #uuid "124e750c-fc80-5c65-9529-062470340fba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276576}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94e22586-a5f1-51cf-a995-d1ab4b7574bb" :question/math-academy-id "q-320536" :question/problem "If $kB=[\\begin{aligned}33 & 36 \\\\ -12 & -24\\end{aligned}]$,\nwhere $B=[\\begin{aligned}11 & 12 \\\\ -4 & -8\\end{aligned}]$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kB,$ we multiply each entry of $B$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kB & =k[\\begin{aligned}11 & 12 \\\\ 4 & -8\\end{aligned}] \\\\  & =[\\begin{aligned}11k & 12k \\\\ 4k & -8k\\end{aligned}]\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kB$ in the problem statement:\n\n$$\n[\\begin{aligned}11k & 12k \\\\ -4k & -8k\\end{aligned}]=[\\begin{aligned}33 & 36 \\\\ -12 & -24\\end{aligned}]\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the bottom-left elements, $-4k$ and $-12.$ Equating these elements, we get\n\n$$\n\\begin{aligned}-4k & =-12 \\\\ k & =3.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186276578 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e43c4a14-158c-5d27-8a98-64dbe7b6dfe9" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186276580} {:answer/id #uuid "79c53211-74c4-520f-ab7b-d2bbf828c1bd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276581}] :answer-field/correct {:answer/id #uuid "79c53211-74c4-520f-ab7b-d2bbf828c1bd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276581} :answer-field/id #uuid "a3a5f0f2-78b5-5053-be79-2b1e4f9e432c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276579}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "64e8cec8-3f94-5936-a2d8-918776984710" :question/math-academy-id "q-320551" :question/problem "If $kW=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 20 & -15 \\\\ 10 & -10 & 25\\end{aligned}]$,\nwhere $W=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & -3 \\\\ 2 & -2 & 5\\end{aligned}]$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kW,$ we multiply each entry of $W$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kW & =k[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & -3 \\\\ 2 & -2 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}k & 0 & 0 \\\\ 0 & 4k & -3k \\\\ 2k & -2k & 5k\\end{aligned}]\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kW$ in the problem statement:\n\n$$\n[\\begin{aligned}k & 0 & 0 \\\\ 0 & 4k & -3k \\\\ 2k & -2k & 5k\\end{aligned}]=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 20 & -15 \\\\ 10 & -10 & 25\\end{aligned}]\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the  leftmost elements of the third row, $2k$ and $10.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =10 \\\\ k & =5.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186276582 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf70b764-f1cc-5036-988e-205dae3f6187" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276584}] :answer-field/correct {:answer/id #uuid "cf70b764-f1cc-5036-988e-205dae3f6187" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276584} :answer-field/id #uuid "2d2e2ee7-91fc-5f58-a431-acf2515afc9a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276583}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9273625d-d244-58a2-a3ee-603115c187f7" :question/math-academy-id "q-320563" :question/problem "If $kB=[\\begin{aligned}8 & -4 & 2\\end{aligned}]$,\nwhere $B=[\\begin{aligned}24 & -12 & 6\\end{aligned}]$\nand $k$ is a scalar, calculate the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "To express $kB,$ we multiply each entry of $B$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kB & =k[\\begin{aligned}24 & -12 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}24k & -12k & 6k\\end{aligned}]\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kB$ in the problem statement:\n\n$$\n[\\begin{aligned}24k & -12k & 6k\\end{aligned}]=[\\begin{aligned}8 & -4 & 2\\end{aligned}]\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the rightmost elements, $6k$ and $2.$ Equating these elements, we get\n\n$$\n\\begin{aligned}6k & =2 \\\\ k & =\\frac{1}{3}.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186276585 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070b32f7-817a-5f68-a897-9bfdbd81bb7c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186276587} {:answer/id #uuid "2bfaa54a-b629-5b75-a32f-7dde545ba804" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186276588}] :answer-field/correct {:answer/id #uuid "070b32f7-817a-5f68-a897-9bfdbd81bb7c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186276587} :answer-field/id #uuid "eb943ed1-9780-51ad-adf5-a864c282a589" :answer-field/key