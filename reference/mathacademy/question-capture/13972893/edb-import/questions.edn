#{[{:db/id #edb/ref 17592186059473 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4cc58a6-ebb8-544d-93a1-de6cbd5b180e" :knowledge-point/title "Multiplying a Matrix by a Scalar"}] :question/id #uuid "4391bd7a-560e-5b59-bf5c-b68ff235c05e" :question/math-academy-id "e-4380" :question/problem "Calculate $-2A$, if\n$A=\\left\\lbrack \\matrix {2 & -1 \\ 4 & 7} \\right\\rbrack$." :question/worked-solution "We multiply each entry of $A$ by $-2$, as follows:\n\n$$\n\\begin{aligned}\n-2A &= -2\\begin{bmatrix}2 & -1 \\\\ 4 & 7\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-2 \\cdot 2 & -2 \\cdot (-1) \\\\ -2 \\cdot 4 & -2 \\cdot 7\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-4 & 2 \\\\ -8 & -14\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059474 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/id #uuid "69ac9cdd-b27b-5b90-be25-02252df54e9e" :question/math-academy-id "e-4381" :question/problem "If $k {A} = \\left\\lbrack \\matrix {1 & 3 & 4 \\ 6 & 0 & -2} \\right\\rbrack$,\nwhere ${A} = \\left\\lbrack \\matrix {2 & 6 & 8 \\ 12 & 0 & -4} \\right\\rbrack$\nand $k$ is a scalar, calculate the value of $k$." :question/worked-solution "To express $kA$, we multiply each entry of $A$ by $k$, as follows:\n\n$$\n\\begin{aligned}\nkA &= k \\cdot \\begin{bmatrix}2 & 6 & 8 \\\\ 12 & 0 & -4\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2k & 6k & 8k \\\\ 12k & 0 & -4k\\end{bmatrix}\n\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\left\\lbrack \\matrix {2k & 6k & 8k \\ 12k & 0 & -4k} \\right\\rbrack = \\left\\lbrack \\matrix {1 & 3 & 4 \\ 6 & 0 & -2} \\right\\rbrack\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $2k$ and $1$. Equating these elements, we get\n\n$$\n\\begin{aligned}\n2k &= 1 \\\\\nk &= \\frac{1}{2}\n\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."}] [{:db/id #edb/ref 17592186059475 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/id #uuid "1828e8ba-504d-5b20-b5fa-82005c7588f6" :question/math-academy-id "e-4382" :question/problem "Calculate $2 {A} + \\dfrac{1}{2} {B}$, where\n$\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}$ and ${B}= \\left\\lbrack \\matrix {0 & 2 \\ 4 & 2} \\right\\rbrack$." :question/worked-solution "We multiply each entry of $A$ by $2$ and each entry of $B$ by\n\n$$\n\\dfrac{1}{2}\n$$\n\nand then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}\n2A + \\frac{1}{2}B &= 2\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix} + \\frac{1}{2}\\begin{bmatrix}0 & 2 \\\\ 4 & 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 \\cdot 1 & 2 \\cdot 5 \\\\ 2 \\cdot 1 & 2 \\cdot 2\\end{bmatrix} + \\begin{bmatrix}\\frac{1}{2} \\cdot 0 & \\frac{1}{2} \\cdot 2 \\\\ \\frac{1}{2} \\cdot 4 & \\frac{1}{2} \\cdot 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 & 10 \\\\ 2 & 4\\end{bmatrix} + \\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 + 0 & 10 + 1 \\\\ 2 + 2 & 4 + 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 & 11 \\\\ 4 & 5\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060380 :knowledge-point/_questions [{:knowledge-point/id #uuid "2da3580a-6a1a-5e38-bcab-bd35f1ea5a6e" :knowledge-point/title "Calculating the Value of a Scalar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a929322d-38ac-5c3b-9892-953474fb323f" :answer/type {:db/ident :answer.type/math} :answer/value "k = 6" :db/id #edb/ref 17592186059264} {:answer/id #uuid "c27d8d2f-ac22-5133-ba31-77573492c9b6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 4" :db/id #edb/ref 17592186059265} {:answer/id #uuid "362e8327-2ba5-5ede-a954-c35c493e8aa4" :answer/type {:db/ident :answer.type/math} :answer/value "k = 5" :db/id #edb/ref 17592186059266} {:answer/id #uuid "43cdba9f-f44b-5174-a439-8b27921aea09" :answer/type {:db/ident :answer.type/math} :answer/value "k = 3" :db/id #edb/ref 17592186059267} {:answer/id #uuid "66bdc008-3b58-5b49-8309-d02e8d0741d6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 7" :db/id #edb/ref 17592186059268}] :answer-field/correct {:answer/id #uuid "66bdc008-3b58-5b49-8309-d02e8d0741d6" :answer/type {:db/ident :answer.type/math} :answer/value "k = 7" :db/id #edb/ref 17592186059268} :answer-field/id #uuid "5dc5417f-2c5b-5ed8-9c28-ef6bda87bbf7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059263}] :question/id #uuid "00d4f637-689d-5f49-8309-b4f927af6909" :question/math-academy-id "q-981" :question/problem "If $kA = \\begin{bmatrix}-7 & -21 & 56\\end{bmatrix}$,\n\nwhere $A = \\begin{bmatrix}-1 & -3 & 8\\end{bmatrix}$\nand $k$ is a scalar, calculate the value of $k$."}]}
