#{[{:db/id #edb/ref 17592186279103 :knowledge-point/_questions [{:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7ab3a66-8e27-51ce-a616-e80c82fc8e6c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279105} {:answer/id #uuid "f28a718a-4ee3-57c9-94d8-3347b452b284" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279106} {:answer/id #uuid "78c0f311-167d-5bb9-bfc4-c5763263481a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279107} {:answer/id #uuid "7d9767ca-e60c-5758-a1cd-6719440a9101" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186279108} {:answer/id #uuid "80696cf4-8acb-515d-a7f2-7d4ffcb3ef49" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186279109}] :answer-field/correct {:answer/id #uuid "f28a718a-4ee3-57c9-94d8-3347b452b284" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279106} :answer-field/id #uuid "942e7e44-d688-53e6-a3f6-4fcaecb18c0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279104}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7865cd6e-ceef-559e-ad51-f022571355c8" :question/math-academy-id "q-13953" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}2 \\\\ 4\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}2 & 2 \\\\ 1 & 4\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}2 & 2 \\\\ 1 & 4\\end{aligned}| \\\\  & =2\\cdot 4-2\\cdot 1 \\\\  & =6\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,6\\,|=6\n$$"}] [{:db/id #edb/ref 17592186279110 :knowledge-point/_questions [{:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5401c01-9b40-5421-97da-b5d4e2ef05d1" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186279112}] :answer-field/correct {:answer/id #uuid "b5401c01-9b40-5421-97da-b5d4e2ef05d1" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186279112} :answer-field/id #uuid "8bd562a1-de76-57bf-8a2a-0fff1c9df0c4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279111}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5b426326-b653-592b-bbad-842bee9a0bbe" :question/math-academy-id "q-320392" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979011/assets/6881c7b52de83103dcfc483ec25455781a4d399653e2369d28f6924327f8ee56.png)\n\nDetermine the area $A$ of the parallelogram in the figure.\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨-3,2⟩,\\,\\text{v}=⟨1,3⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-3 & 1 \\\\ 2 & 3\\end{aligned}| \\\\  & =(-3)\\cdot 3-1\\cdot 2 \\\\  & =-9-2 \\\\  & =-11\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-11|=11\n$$"}] [{:db/id #edb/ref 17592186279113 :knowledge-point/_questions [{:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e542d75-809e-5364-be9a-26a2da8cac97" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186279115} {:answer/id #uuid "da7c3e53-ea11-5924-9681-c7c3af69e697" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186279116}] :answer-field/correct {:answer/id #uuid "da7c3e53-ea11-5924-9681-c7c3af69e697" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186279116} :answer-field/id #uuid "d3cd4ea3-2e9a-5c48-9e8a-2b1b46dba0e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279114}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6a665495-2aa5-5e3c-af99-7d30a1a81b07" :question/math-academy-id "q-320401" :question/problem "Determine the area $A$ of the parallelogram spanned by $\\text{u}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ 4\\end{aligned}].$\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-2 & 5 \\\\ 3 & 4\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-2 & 5 \\\\ 3 & 4\\end{aligned}| \\\\  & =(-2)\\cdot 4-5\\cdot 3 \\\\  & =-8-15 \\\\  & =-23\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,-23\\,|=23\n$$"}] [{:db/id #edb/ref 17592186279117 :knowledge-point/_questions [{:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6eb67d7-299b-5f9f-a3d8-3596447fb4ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186279119}] :answer-field/correct {:answer/id #uuid "c6eb67d7-299b-5f9f-a3d8-3596447fb4ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{7}" :db/id #edb/ref 17592186279119} :answer-field/id #uuid "0001203e-7ac4-51ba-958e-a15e910eb722" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279118}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ec8978a8-907e-5a48-8bc8-078b7ba83da1" :question/math-academy-id "q-320553" :question/problem "Given that the area spanned between the vectors $\\text{u}=⟨-\\frac{4}{3},7⟩$ and $\\text{v}=⟨a,-9⟩$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-\\frac{4}{3} & a \\\\ 7 & -9\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-\\frac{4}{3} & a \\\\ 7 & -9\\end{aligned}| \\\\  & =(-\\frac{4}{3})\\cdot (-9)-a\\cdot 7 \\\\  & =12-7a\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}12-7a & =0 \\\\ 7a & =12 \\\\ a & =\\frac{12}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279120 :knowledge-point/_questions [{:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "342a9db8-ede7-53d2-b513-4656595af4b5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279122} {:answer/id #uuid "52468d88-cd6f-5527-8669-ca5436796e4f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186279123} {:answer/id #uuid "2edf24c0-1d73-55e0-b837-d69547f8b263" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279124} {:answer/id #uuid "ffdf18dc-6e95-5eaa-b6b7-80bf11333fb3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186279125} {:answer/id #uuid "a653eba0-aa58-53fe-8498-6bf12f7186ae" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186279126}] :answer-field/correct {:answer/id #uuid "ffdf18dc-6e95-5eaa-b6b7-80bf11333fb3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186279125} :answer-field/id #uuid "b3d6ff9f-7e5b-51a0-ad6c-b7afee4b198e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279121}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9865b6cc-3075-5d80-85fc-ad172585191d" :question/math-academy-id "q-69945" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=⟨-1,-2⟩$ and $\\text{v}=⟨3,6⟩.$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}-1 & 3 \\\\ -2 & 6\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}-1 & 3 \\\\ -2 & 6\\end{aligned}| \\\\  & =(-1)\\cdot 6-3\\cdot (-2) \\\\  & =-6+6 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}]}
