i})(3-\\text{i})) & = \\\\ -(x+2)({x}^{2}-6x+10) & = \\\\ -({x}^{3}-6{x}^{2}+10x+2{x}^{2}-12x+20) & = \\\\ -{x}^{3}+4{x}^{2}+2x-20 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=-{x}^{3}+4{x}^{2}+2x-20.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104489/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-104489"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316652/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "7408c08e-caee-5dbd-ba6c-af9b034a4b1e" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-316652/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "34156666-9e7e-54ac-8582-f70fcdf44c58" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-316652/field-1" :answer-field/id #uuid "363f97bb-2fd3-5c2e-a900-6d6e2513e2f2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316652/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-316652/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-316652/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-316652/field-2/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "1ac11729-ece9-584c-aa57-f0fe6eafb376" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-316652/field-2" :answer-field/id #uuid "0b6bf546-57f1-59fd-8e63-c771792fb493" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316652/field-2/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer-field/choices ["q-316652/field-2/a4c8bdda186d0d425e9963bf