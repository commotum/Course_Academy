2\\text{i}))(x-(1-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}6(x-3)(x-(1+2\\text{i}))(x-(1-2\\text{i})) & = \\\\ 6(x-3)({x}^{2}-x(1+2\\text{i})-x(1-2\\text{i})+(1+2\\text{i})(1-2\\text{i})) & = \\\\ 6(x-3)({x}^{2}-2x+5) & = \\\\ 6({x}^{3}-5{x}^{2}+11x-15) & = \\\\ 6{x}^{3}-30{x}^{2}+66x-90.\\end{aligned}\n$$\n\nTherefore, $f(x)=6{x}^{3}-30{x}^{2}+66x-90.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316652/field-1" "q-316652/field-2" "q-316652/field-3" "q-316652/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-316652"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107541/selection/64e6e7715988387cf0e6608ab2def4583c65898f402116324f6793e704c5719b" :answer/id #uuid "e9685cdd-d84f-5498-8601-1fa2914d71a9" :answer/type :answer.type/math :answer/value "2{x}^{3}+{x}^{2}+16x+32" :db/ensure [:answer/validate]} {:db/id "q-107541/selection/bb8af38b0aa207a2ca9928367ca0e5392d48b1462b0bdd5e88130d6f76db5072" :answer/id #uuid "6ba8dd3d-6f6b-546e-86bc-ac69fd19628d" :answer/type :answer.type/math :answer/value "2{x}^{3}-2{x}^{2}+32x-32" :db/ensure [:answer/validate]} {:db/id "q-107541/selection/2ef66992197d0ca0608f55d7934abc2aee22a6e6fe7c0e8bbd014488b731a0bc" :answer/id #uuid "b9a9a5b1-efcf-5fcc-a86f-7e5bc83cc6b6" :answer/type :answer.type/math :answer/value "{x}^{3}+{x}^{2}+16x+16" :db/ensure [:answer/validate]} {:db/id "q-107541/selection/4cb263f7662e8a03864134f63f13cb447b5420ca3c87c740b2c47a85df123c56" :answer/id #uuid "4de6c775-96bb-5d4b-83dd-c4c76dc02a6d" :answer/type :answer.type/math :answer/value "2{x}^{3}+2{x}^{2}+32x+32" :db/ensure [:answer/validate]} {:db/id "q-107541/selection/22e845aa519ad087b2faa97e4c59b48532564567500d616e2b8d56bce565e5cf" :answer/id #uuid "3abb6aa4-e557-5e95-bfb5-0a6523993a2a" :answer/type :answer.type/math :answer/value "{x}^{3}-{x}^{2}+16x-16" :db/ensure [:answer/validate]} {:db/id "q-107541/selection" :answer-field/id #uuid "7024d7e6-599e-5348-8599-2341fcd3bba7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107541/selection/4cb263f7662e8a03864134f63f13cb447b5420ca3c87c740b2c47a85df123c56" :answer-field/choices ["q-107541/selection/64e6e7715988387cf0e6608ab2def4583c65898f402116324f6793e704c5719b" "q-107541/selection/bb8af38b0aa207a2ca9928367ca0e5392d48b1462b0bdd5e88130d6f76db5072" "q-107541/selection/2ef66992197d0ca0608f55d7934abc2aee22a6e6fe7c0e8bbd014488b731a0bc" "q-107541/selection/4cb263f7662e8a03864134f63f13cb447b5420ca3c87c740b2c47a85df123c56" "q-107541/selection/22e845aa519ad087b2faa97e4c59b48532564567500d616e2b8d56bce565e5cf"] :db/ensure [:answer-field/validate]} {:db/id "q-107541" :question/id #uuid "35e8d73b-cad1-5357-8f7d-d049b5fbd1f8" :question/math-academy-id "q-107541" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=-1,{x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $2.$ Find $f(x).$" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=-1$ and ${x}_{2,3}=\\pm 4\\text{i},$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =2(x-(-1))(x-4\\text{i})(x-(-4\\text{i})) \\\\  & =2(x+1)(x-4\\text{i})(x+4\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(x+1)(x-4\\text{i})(x+4\\text{i}) & = \\\\ 2(x+1)({x}^{2}-(4\\text{i})^{2}) & = \\\\ 2(x+1)({x}^{2}+16) & = \\\\ 2({x}^{3}+{x}^{2}+16x+16) & = \\\\ 2{x}^{3}+2{x}^{2}+32x+32 & .\\end{aligned}\n$$\n\nTherefore, $f(x)=2{x}^{3}+2{x}^{2}+32x+32.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107541/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03"] :knowledge-point/questions ["q-107541"] :db/ensure [:knowledge-point/validate]}