#{[{:db/id #edb/ref 17592186291593 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4ca2415-9cc0-55d6-a117-9433092650cf" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186291595} {:answer/id #uuid "b8bba62d-fe77-5d81-bcef-93aa7bb31ccd" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given statements are true" :db/id #edb/ref 17592186291596} {:answer/id #uuid "298fd41d-0b67-5dd7-a7f4-b00d36ea9393" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186291597} {:answer/id #uuid "80942402-97be-50b4-81e8-4df0f85fbddf" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186291598} {:answer/id #uuid "e9a9e36b-c45e-5d89-95dc-ea4a477b71b8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186291599}] :answer-field/correct {:answer/id #uuid "e9a9e36b-c45e-5d89-95dc-ea4a477b71b8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186291599} :answer-field/id #uuid "c93f4e79-80f7-52a5-9175-9f28ad8128d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291594}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\n- $det(F)=-7$\n- $F$ is **not** a singular matrix\n- $det(F)=-2$\n\n$$\nF=[\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|-8|\\begin{aligned}-1 & 1 \\\\ 5 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186291600 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f75060d-2e3e-5e90-9815-cb9194a8788a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186291602} {:answer/id #uuid "fb0d6a44-8436-5525-8cb9-406699916693" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186291603} {:answer/id #uuid "68b24bc2-38bc-5cf1-a568-635bf94c79e0" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186291604} {:answer/id #uuid "7c0e1d50-c0da-51ed-9ef3-211ca52408f1" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186291605} {:answer/id #uuid "c134ccc7-ce69-567f-94f5-e833ae2ba4be" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291606}] :answer-field/correct {:answer/id #uuid "68b24bc2-38bc-5cf1-a568-635bf94c79e0" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186291604} :answer-field/id #uuid "7400cdc3-34b8-5532-bf3f-8e25d803e6d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291601}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e0915dbf-e532-5db3-bdaa-4adfc7076ccf" :question/math-academy-id "q-128502" :question/problem "Given that \n$C=[\\begin{aligned}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{aligned}]$ \nand $det(C)=28,$ find the value of $q.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $q:$\n\n$$\n\\begin{aligned}\\text{det}(C) & =|\\begin{aligned}2 & 3 & 1 \\\\ -1 & q & 5 \\\\ 0 & -5 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}q & 5 \\\\ -5 & 1\\end{aligned}|-3|\\begin{aligned}-1 & 5 \\\\ 0 & 1\\end{aligned}|+1|\\begin{aligned}-1 & q \\\\ 0 & -5\\end{aligned}| \\\\  & =2\\cdot (q+25)-3\\cdot (-1)+5 \\\\  & =2q+58\\end{aligned}\n$$\n\nSince the determinant of the matrix is $28,$ we have:\n\n$$\n\\begin{aligned}2q+58 & =28 \\\\ 2q & =-30 \\\\ q & =-15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291607 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d0cb28e-4fc8-5013-94cf-ff5147e66641" :answer/type {:db/ident :answer.type/text} :answer/value "$-2$ and $3$ only" :db/id #edb/ref 17592186291609} {:answer/id #uuid "31ed3d39-28ce-5447-8827-dde43b2a8108" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $6$ only" :db/id #edb/ref 17592186291610} {:answer/id #uuid "d58f196e-d677-589c-a2c1-6f3365a23a8d" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $7$ only" :db/id #edb/ref 17592186291611} {:answer/id #uuid "81cfc9c1-3416-5a42-8690-032d7c913f56" :answer/type {:db/ident :answer.type/text} :answer/value "$3$  only" :db/id #edb/ref 17592186291612} {:answer/id #uuid "5b771a52-6452-59ae-8bf1-004cc6984d54" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $-5$ only" :db/id #edb/ref 17592186291613}] :answer-field/correct {:answer/id #uuid "d58f196e-d677-589c-a2c1-6f3365a23a8d" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $7$ only" :db/id #edb/ref 17592186291611} :answer-field/id #uuid "0e5f0f38-246f-5927-9460-4b2aff199937" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291608}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d07c9ad8-9277-516a-802b-f65168b9d077" :question/math-academy-id "q-130575" :question/problem "Given that the determinant of\n$[\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}]$\nis $-48$, find all the possible values of $z.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $z:$\n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & 5 \\\\ 2 & 3 & z \\\\ z & -1 & 1\\end{aligned}| & =2|\\begin{aligned}3 & z \\\\ -1 & 1\\end{aligned}|-1|\\begin{aligned}2 & z \\\\ z & 1\\end{aligned}|+5|\\begin{aligned}2 & 3 \\\\ z & -1\\end{aligned}| \\\\  & =2(3+z)-(2-{z}^{2})+5(-2-3z) \\\\  & =6+2z-2+{z}^{2}-10-15z \\\\  & ={z}^{2}-13z-6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $-48,$ we have:\n\n$$\n\\begin{aligned}{z}^{2}-13z-6 & =-48 \\\\ {z}^{2}-13z+42 & =0 \\\\ z & =\\frac{-(-13)\\pm \\sqrt{{13}^{2}-4\\cdot 1\\cdot 42}}{2\\cdot 1} \\\\  & =\\frac{13\\pm \\sqrt{1}}{2} \\\\  & =\\frac{13\\pm 1}{2} \\\\  & =6,7\\end{aligned}\n$$\n\nTherefore, the solutions are $z=6$ and $z=7.$"}] [{:db/id #edb/ref 17592186060374 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9ec0187-15e5-5f69-af94-c45c92371333" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186059228} {:answer/id #uuid "dfa0cf87-23c6-5a0c-8188-84553b022047" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186059229} {:answer/id #uuid "e604c3ce-f964-5c48-99b9-c0614453f374" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186059230} {:answer/id #uuid "ee1ba3ce-7ae4-5290-9830-eca849f7c61e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186059231} {:answer/id #uuid "7a67e148-4e8e-5dff-b2fb-f441b48fdbb2" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186059232}] :answer-field/correct {:answer/id #uuid "b9ec0187-15e5-5f69-af94-c45c92371333" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186059228} :answer-field/id #uuid "7c52985b-0120-5909-aab9-2b753bfe9dfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059227}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $[\\begin{aligned}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{aligned}| & =2|\\begin{aligned}3 & k \\\\ 0 & 1\\end{aligned}|-1|\\begin{aligned}2k+1 & k \\\\ 1 & 1\\end{aligned}|-4|\\begin{aligned}2k+1 & 3 \\\\ 1 & 0\\end{aligned}| \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"}] [{:db/id #edb/ref 17592186060381 :knowledge-point/_questions [{:knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925f58ea-7012-53dc-80f4-9fb77516328b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186059270} {:answer/id #uuid "eabd78e4-02aa-5a26-9e74-b33ff7398276" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186059271} {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} {:answer/id #uuid "3a48b213-3fc9-5909-b0f8-e252cc9152fc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186059273} {:answer/id #uuid "58560319-7a4b-576a-bded-606ccbf3bc6e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186059274}] :answer-field/correct {:answer/id #uuid "fae3c952-6454-528c-ae70-9a57815ff1ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186059272} :answer-field/id #uuid "25221b48-60ba-5400-b499-5bb9876737c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186059269}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\n- $det(F)=0$\n- $F$ is a singular matrix\n- $det(F)=-2$\n\n$$\nF=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 5 \\\\ 7 & 8\\end{aligned}|-1|\\begin{aligned}3 & 5 \\\\ 6 & 8\\end{aligned}|+2|\\begin{aligned}3 & 4 \\\\ 6 & 7\\end{aligned}| \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."}]}
