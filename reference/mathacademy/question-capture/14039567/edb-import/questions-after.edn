#{[{:db/id #edb/ref 17592186303129 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b34c298e-5082-53ae-bbcc-9abd9d3deebd" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186303131} {:answer/id #uuid "0fd39f9b-7cd6-5cbd-a639-497db45e5e5f" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186303132} {:answer/id #uuid "d89c0caa-656e-59de-873e-5402af7b4273" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186303133} {:answer/id #uuid "81f1adcc-62d5-51f4-80b1-cd547bd48eca" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186303134} {:answer/id #uuid "df90ad81-7c50-537c-9708-3715bba0d2e7" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\infty ,-1)$ and  $(1,\\infty )$" :db/id #edb/ref 17592186303135}] :answer-field/correct {:answer/id #uuid "b34c298e-5082-53ae-bbcc-9abd9d3deebd" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186303131} :answer-field/id #uuid "197f6263-c641-5680-8632-5bff24d869ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303130}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "cd8f4bb2-7373-5980-915b-81559c92c88f" :question/math-academy-id "q-114060" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/assets/c528a8bdbb9bc6dd1a9895109fdc6818b70787c5024c78e06e2d2ec3997777d6.png)\n\nThe graph above shows $y={f}^{″}(x).$ Find the intervals on which the function $f(x)$ is concave up." :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the intervals  $(-1,0)$ and  $(0,1).$  Therefore, the function $f(x)$ is concave up on the intervals  $(-1,0)$ and  $(0,1).$"}] [{:db/id #edb/ref 17592186303136 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eec5bffe-f37b-542a-b883-24981acf56b0" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(2,3)$" :db/id #edb/ref 17592186303138} {:answer/id #uuid "830cf24c-0dfa-5396-817d-7d783a1a481a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ only" :db/id #edb/ref 17592186303139} {:answer/id #uuid "7495b2c2-665b-517b-a60b-9c61ed3ea1be" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(1,2)$" :db/id #edb/ref 17592186303140} {:answer/id #uuid "c14260ea-f10e-52ce-bcc9-bed40a408717" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,3)$ only" :db/id #edb/ref 17592186303141} {:answer/id #uuid "426ba1bd-081f-552d-a1fe-5c1a630db5c3" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ only" :db/id #edb/ref 17592186303142}] :answer-field/correct {:answer/id #uuid "426ba1bd-081f-552d-a1fe-5c1a630db5c3" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ only" :db/id #edb/ref 17592186303142} :answer-field/id #uuid "d2a4d10c-c21d-558f-b943-31033714e15e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303137}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0161bc1-4160-5449-a401-29481660be7d" :question/math-academy-id "q-114063" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/assets/9ac6bf6978169aaa3a29c570234cdbf26f37b6e91488d8e27c63255b8cbb3ba6.png)\n\nThe graph above shows $y={f}^{″}(x),$ where the function $f(x)$ is defined on $[0,3].$ Find the intervals on which the function $f(x)$ is concave down." :question/worked-solution "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)<0$ on the interval  $(1,2)$ only. Therefore, the function $f(x)$ is concave down on the interval $(1,2)$ only."}] [{:db/id #edb/ref 17592186303143 :knowledge-point/_questions [{:knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8541dc-ddb3-5ff0-93eb-1a08c0d63907" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303145} {:answer/id #uuid "b3fc6cc2-0d44-55c0-a67b-40a19e3e8268" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186303146} {:answer/id #uuid "288f30aa-b0f9-57e9-a1b4-394b0093e7de" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303147} {:answer/id #uuid "8187c10e-60f5-50a0-aef4-77358c06f650" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303148} {:answer/id #uuid "a1b1be4f-07e2-5ad8-8ca9-60397cec6e75" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186303149}] :answer-field/correct {:answer/id #uuid "b3fc6cc2-0d44-55c0-a67b-40a19e3e8268" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186303146} :answer-field/id #uuid "81dd3269-5b25-5a0a-b569-8ad866dc06e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303144}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "190520f8-9dd8-5a57-996e-9e323ff2fbe7" :question/math-academy-id "q-114273" :question/problem "Consider the function $f(x)={x}^{2}(5-2\\operatorname{ln}⁡x),$ defined on $x\\in (0,\\infty ).$ Which of the following statements are true?\n\n- $f(x)$ is concave up on $(0,e)$\n- $f(x)$ is concave down on $(0,e)$\n- $f(x)$ is concave down on $(e,\\infty )$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2x(5-2\\operatorname{ln}⁡x)-{x}^{2}\\cdot \\frac{2}{x} \\\\  & =2x(5-2\\operatorname{ln}⁡x)-2x \\\\  & =2x(4-2\\operatorname{ln}⁡x) \\\\ {f}^{″}(x) & =2(4-2\\operatorname{ln}⁡x)-2x\\cdot \\frac{2}{x} \\\\  & =8-4\\operatorname{ln}⁡x-4 \\\\  & =4(1-\\operatorname{ln}⁡x).\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}4(1-\\operatorname{ln}⁡x) & >0 \\\\ \\operatorname{ln}⁡x & <1 \\\\ x & <e.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is concave up on  $(0,e).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $4(1-\\operatorname{ln}⁡x)<0,$ which has the solution $(e,\\infty ).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186303150 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56dee1ba-5db2-59fe-98cd-630a61f37239" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186303152}] :answer-field/correct {:answer/id #uuid "56dee1ba-5db2-59fe-98cd-630a61f37239" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186303152} :answer-field/id #uuid "47b9b341-fd9d-5477-82ec-50a7afee04aa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303151} {:answer-field/choices [{:answer/id #uuid "2e24f9b0-96c2-5d87-b824-91db1840ed10" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303154}] :answer-field/correct {:answer/id #uuid "2e24f9b0-96c2-5d87-b824-91db1840ed10" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303154} :answer-field/id #uuid "013ea9f9-f4e6-575f-879c-8e6613dd51f6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186303153}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8b73c45f-5f0d-5b2f-a471-18a4d14cf315" :question/math-academy-id "q-344765" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/assets/56265e4a47a878233f27b1e265158dc766aa410144dfe95a20ce7f672b797802.png)\n\nThe function $f(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ intersects the $x$-axis at the points $x=-4$ and $x=1,$ as shown above. Find the interval on which the function $f(x)$ is concave up.\n\n$f(x)$ is concave up on the interval\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFrom the plotted graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(-4,1).$\n\nTherefore, the function $f(x)$ is concave up on the interval $(\\,-4,1\\,).$"}] [{:db/id #edb/ref 17592186303155 :knowledge-point/_questions [{:knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bdb5fbc-d8d8-508b-a81b-e58c4e5c3185" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303157} {:answer/id #uuid "3190e8ef-1a91-5d56-8172-676959ecf5ad" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303158} {:answer/id #uuid "a597ab46-b4fe-56c0-8bd8-a22088dd5474" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186303159} {:answer/id #uuid "1b6b87ca-5c95-5b6e-ac81-adb346366952" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186303160} {:answer/id #uuid "00c522ea-b536-579c-96e8-6988188dc464" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186303161}] :answer-field/correct {:answer/id #uuid "3190e8ef-1a91-5d56-8172-676959ecf5ad" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186303158} :answer-field/id #uuid "23372881-aa72-55f4-a6aa-aa4456e28bb5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303156}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "61c5d722-ecbd-5ec6-af6e-19c6056c6975" :question/math-academy-id "q-79047" :question/problem "Consider the function $f(x)=2+3x-{e}^{-x}.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(-\\infty ,\\infty )$\n- $f(x)$ is concave up on $(0,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,0)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3+{e}^{-x} \\\\ {f}^{″}(x) & =-{e}^{-x}\\end{aligned}\n$$\n\nSince ${e}^{-x}>0$ for every real value of $x,$ it follows that $-{e}^{-x}<0$ for every real value of $x.$ Therefore, ${f}^{″}(x)$ is never positive, so there are no intervals where $f(x)$ is concave up.\n\nSince ${f}^{″}(x)<0$ for every real value of $x,$ the function is concave down on $(-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"I only.\""}]}
