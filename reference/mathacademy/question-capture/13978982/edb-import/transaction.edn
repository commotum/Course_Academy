3a2f4" :answer/type :answer.type/math :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-170593/selection/6229a05514ea404341855fb9fb792747774f7c7cecd11f70984b964b866406f2" :answer/id #uuid "4ba07c5d-8f98-5465-9e59-74764fa399b0" :answer/type :answer.type/math :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-170593/selection/ba98d4fe75973796c2449437968c5189212809a46d42b197611f65c531ea985d" :answer/id #uuid "a46266a8-da36-583b-aef7-b97cc27f1aa1" :answer/type :answer.type/math :answer/value "y={(\\frac{13}{6})}^{x}+\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-170593/selection/85ed6eb34cf43fab4521015f2d729b8157869f8cf8467ec124d2541d6449b771" :answer/id #uuid "817f8320-b41b-548d-8f19-7b9cefd81cdd" :answer/type :answer.type/math :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-170593/selection/8b8b1257b5ceb5b744f8cff79eab2f4fa65ab9663d099a72d1c0dcc3019f92f0" :answer/id #uuid "4b779fdd-dacc-5b89-9823-db77638e93d9" :answer/type :answer.type/math :answer/value "y={(\\frac{13}{6})}^{x}+\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-170593/selection" :answer-field/id #uuid "54121805-0fcb-5ba5-84b7-7c5ecb6f3679" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170593/selection/68fdd3c5d0a9734a2ea2083814025486c771c34f9588eb387dd853a1bf542849" :answer-field/choices ["q-170593/selection/68fdd3c5d0a9734a2ea2083814025486c771c34f9588eb387dd853a1bf542849" "q-170593/selection/6229a05514ea404341855fb9fb792747774f7c7cecd11f70984b964b866406f2" "q-170593/selection/ba98d4fe75973796c2449437968c5189212809a46d42b197611f65c531ea985d" "q-170593/selection/85ed6eb34cf43fab4521015f2d729b8157869f8cf8467ec124d2541d6449b771" "q-170593/selection/8b8b1257b5ceb5b744f8cff79eab2f4fa65ab9663d099a72d1c0dcc3019f92f0"] :db/ensure [:answer-field/validate]} {:db/id "q-170593" :question/id #uuid "4441553d-da09-5372-be95-e3b73397a93b" :question/math-academy-id "q-170593" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/319245f467f8512e0fd1d420364a3a88774eda3c9c17c03d4cba6b073c86ad9e.png)\n\nThe graph above shows the curve $y={(\\frac{13}{6})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{13}{6})}^{x}$ is $y=0.$ The vertical translation $y={(\\frac{13}{6})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-\\frac{3}{2}.$ Therefore, $c=-\\frac{3}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170593/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90"] :knowledge-point/questions ["q-170593"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49190"] :question/problem "What is ${\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=3\\sqrt{x},$ the lower bound is $a=2,$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+j\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+\\frac{2j}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[3\\sqrt{2+\\frac{2j}{n}}\\cdot \\frac{2}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-38610/selection/fd335bc964cc6b46161f1094ef84d0599927c7c74ca5b68bd5f4ec1d90d13b6d" :answer/id #uuid "b2cea74e-d868-56c1-9a51-f2e2c7d50846" :answer/type :answer.type/math :answer/value "B" :db/ensure [:answer/validate]} {:db/id "q-38610/selection/885fe3edc6c725c68011b8798fb3574601671add7a0b04b375127f9789468b9f" :answer/id #uuid "6a53b1b5-e1c4-5462-9c63-4c79e6f7b529" :answer/type :answer.type/math :answer/value "D" :db/ensure [:answer/validate]} {:db/id "q-38610/selection/e6f60db675b7962d47c6a3c701c8e8ae2aa9b7675f85c7dcd302ebf4b8244298" :answer/id #uuid "ae5f35c5-a3f9-5894-a706-851046f38709" :answer/type :answer.type/text :answer/value "None of the given options is correct" :db/ensure [:answer/validate]} {:db/id "q-38610/selection/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "84fa52d7-3769-5c8f-8fc9-bfc10b7660d5" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-38610/selection/7f0f2478ce521aa4000523fe155bfe972c7a8cc195da49dd5eb0249ef8194675" :answer/id #uuid "a32648d9-1a03-5f53-a6ea-46c6cf2a8154" :answer/type :answer.type/math :answer/value "A" :db/ensure [:answer/validate]} {:db/id "q-38610/selection" :answer-field/id #uuid "f189ffb8-38d9-5093-b6d9-aa0fb7d5c491" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-38610/selection/e6f60db675b7962d47c6a3c701c8e8ae2aa9b7675f85c7dcd302ebf4b8244298" :answer-field/choices ["q-38610/selection/fd335bc964cc6b46161f1094ef84d0599927c7c74ca5b68bd5f4ec1d90d13b6d" "q-38610/selection/885fe3edc6c725c68011b8798fb3574601671add7a0b04b375127f9789468b9f" "q-38610/selection/e6f60db675b7962d47c6a3c701c8e8ae2aa9b7675f85c7dcd302ebf4b8244298" "q-38610/selection/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" "q-38610/selection/7f0f2478ce521aa4000523fe155bfe972c7a8cc195da49dd5eb0249ef8194675"] :db/ensure [:answer-field/validate]} {:db/id "q-38610" :question/id #uuid "2caf7fca-45d7-567f-9ccb-591256e26fc0" :question/math-academy-id "q-38610" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/7c7a636ec47a5daaa64a9464dd428d74eae0feb6369756e741e863aef56048f7.png)\n\nWhich of the diagrams above can be the graph of the polynomial $y=-3{x}^{4}+{x}^{3}-4{x}^{2}+4x?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)=-3{x}^{4}+{x}^{3}-4{x}^{2}+4x\n$$\n\nThe degree $(n=4)$ is even and the leading coefficient $({a}_{4}=-3)$ is negative. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty .$\n\nNone of the graphs satisfy these conditions." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-38610/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a"] :knowledge-point/questions ["q-38610"] :db/ensure [:knowledge-point/validate]}]
