#{[{:db/id #edb/ref 17592186279395 :knowledge-point/_questions [{:knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f62c62f2-f8fa-5e49-8c23-99b3f1aeac51" :answer/type {:db/ident :answer.type/text} :answer/value "The rate at which the major axis changes as the minor axis changes" :db/id #edb/ref 17592186279397} {:answer/id #uuid "c08805e6-1136-57ee-acbb-1fd8923ea685" :answer/type {:db/ident :answer.type/text} :answer/value "The major axis of an ellipse with area S" :db/id #edb/ref 17592186279398} {:answer/id #uuid "f574a895-e26d-5f01-aaf0-c76a3f6c0a3a" :answer/type {:db/ident :answer.type/text} :answer/value "The area of an ellipse with major axis $a$" :db/id #edb/ref 17592186279399} {:answer/id #uuid "c375f04e-2638-5d1e-af8e-e243076948f8" :answer/type {:db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as the major axis changes" :db/id #edb/ref 17592186279400} {:answer/id #uuid "62dd8bfc-4e63-5be9-abbd-1ca48ab30785" :answer/type {:db/ident :answer.type/text} :answer/value "The rate at which the area changes as the major axis changes" :db/id #edb/ref 17592186279401}] :answer-field/correct {:answer/id #uuid "62dd8bfc-4e63-5be9-abbd-1ca48ab30785" :answer/type {:db/ident :answer.type/text} :answer/value "The rate at which the area changes as the major axis changes" :db/id #edb/ref 17592186279401} :answer-field/id #uuid "172ec8c9-c6fe-505a-aa6a-3c80be1bf22e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279396}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "17829a12-d8a2-500a-8faf-3df160b9f2ac" :question/math-academy-id "q-112063" :question/problem "Consider an ellipse such that its major axis $a$ can vary while its minor axis is fixed. What is the best interpretation of ${S}^{′}(a)$ if $S$ is the area enclosed by the ellipse?" :question/worked-solution "The function $S(a)$ gives the area of the ellipse with major axis $a.$ So,\n\n$$\n{S}^{′}(a)=\\frac{\\text{d}S}{\\text{d}a}=\\frac{\\text{Change in }S}{\\text{Change in }a}.\n$$\n\nTherefore, ${S}^{′}(a)$ is the rate at which the area changes as the major axis changes."}] [{:db/id #edb/ref 17592186279402 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80f9a2c4-ac98-5267-90b0-5c84f634a74b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186279404} {:answer/id #uuid "558dff4f-a12b-5f7f-a225-5bad49cfcb1d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=4+\\sqrt{34}" :db/id #edb/ref 17592186279405} {:answer/id #uuid "a5500bcf-c7c3-5206-91f0-09dd77f547c6" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=35,\\,a=-4-\\sqrt{34}" :db/id #edb/ref 17592186279406} {:answer/id #uuid "54e29105-bd7b-5261-a1ef-7615fbb055a1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-38,\\,a=-4\\pm \\sqrt{35}" :db/id #edb/ref 17592186279407} {:answer/id #uuid "e8a46fc1-1750-5ffa-988a-d5755e009b22" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-35,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186279408}] :answer-field/correct {:answer/id #uuid "80f9a2c4-ac98-5267-90b0-5c84f634a74b" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=38,\\,a=-4\\pm \\sqrt{34}" :db/id #edb/ref 17592186279404} :answer-field/id #uuid "b844afc2-b829-5d87-b161-5cbbd847b061" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279403}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "614f3d78-9dad-57cb-a541-b612d5595aca" :question/math-academy-id "q-12980" :question/problem "The equation ${a}^{2}+8a=18$ can be written in the form $(a+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =18 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =18 \\\\ {a}^{2}+2\\cdot a\\cdot 4+{4}^{2}-{4}^{2} & =18 \\\\ (a+4)^{2}-{4}^{2} & =18\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4)^{2}-{4}^{2} & =18 \\\\ (a+4)^{2}-16 & =18 \\\\ (a+4)^{2} & =34\\end{aligned}\n$$\n\nSo, $p=4,q=34,$ and $p+q=38.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4)^{2} & =34 \\\\ \\sqrt{(a+4)^{2}} & =\\sqrt{34} \\\\ |a+4| & =\\sqrt{34} \\\\ a+4 & =\\pm \\sqrt{34} \\\\ a & =-4\\pm \\sqrt{34}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279409 :knowledge-point/_questions [{:knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba07c5d-8f98-5465-9e59-74764fa399b0" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{2}{3}" :db/id #edb/ref 17592186279411} {:answer/id #uuid "a5723b39-7d72-5932-b15a-4b2403e3a2f4" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{3}{2}" :db/id #edb/ref 17592186279412} {:answer/id #uuid "817f8320-b41b-548d-8f19-7b9cefd81cdd" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{1}{2}" :db/id #edb/ref 17592186279413} {:answer/id #uuid "4b779fdd-dacc-5b89-9823-db77638e93d9" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}+\\frac{1}{3}" :db/id #edb/ref 17592186279414} {:answer/id #uuid "a46266a8-da36-583b-aef7-b97cc27f1aa1" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}+\\frac{5}{6}" :db/id #edb/ref 17592186279415}] :answer-field/correct {:answer/id #uuid "a5723b39-7d72-5932-b15a-4b2403e3a2f4" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{13}{6})}^{x}-\\frac{3}{2}" :db/id #edb/ref 17592186279412} :answer-field/id #uuid "54121805-0fcb-5ba5-84b7-7c5ecb6f3679" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279410}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4441553d-da09-5372-be95-e3b73397a93b" :question/math-academy-id "q-170593" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/319245f467f8512e0fd1d420364a3a88774eda3c9c17c03d4cba6b073c86ad9e.png)\n\nThe graph above shows the curve $y={(\\frac{13}{6})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{13}{6})}^{x}$ is $y=0.$ The vertical translation $y={(\\frac{13}{6})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-\\frac{3}{2}.$ Therefore, $c=-\\frac{3}{2}.$"}] [{:db/id #edb/ref 17592186060108 :knowledge-point/_questions [{:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0" :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dd75dd2-a3d1-5b87-be4a-7ecbce36d15d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 8, 10, 10⟩" :db/id #edb/ref 17592186057470} {:answer/id #uuid "1b736d64-7975-5853-ac8c-a3472638f0cf" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2, 10, 10⟩" :db/id #edb/ref 17592186057471} {:answer/id #uuid "1d3922a2-cbb5-540a-bdfd-3830bb73cff4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2, 10, 2⟩" :db/id #edb/ref 17592186057472} {:answer/id #uuid "43c2ac83-9ac7-5439-837e-c4df9c1bf608" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2, 8, 2⟩" :db/id #edb/ref 17592186057473} {:answer/id #uuid "497b5a43-e65c-5104-b0d2-ff70fa2a7a7f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8, 8, 10⟩" :db/id #edb/ref 17592186057474}] :answer-field/correct {:answer/id #uuid "1b736d64-7975-5853-ac8c-a3472638f0cf" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2, 10, 10⟩" :db/id #edb/ref 17592186057471} :answer-field/id #uuid "959d4364-17bc-59dc-91c4-2b03b1ef0fc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057469}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "411ca293-2e6e-5037-9315-b271adf00d7e" :question/math-academy-id "q-19122" :question/problem "Let $a=⟨-1,3,2⟩$ and $b=⟨5,1,4⟩.$ Find $3a+b.$" :question/worked-solution "To compute $3a+b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a+b & =3\\cdot ⟨-1,3,2⟩+⟨5,1,4⟩ \\\\  & =⟨-3,9,6⟩+⟨5,1,4⟩ \\\\  & =⟨2,10,10⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279416 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca2e8fe1-b567-518a-afc6-3168329e721c" :answer/type {:db/ident :answer.type/math} :answer/value "(3,8)" :db/id #edb/ref 17592186279418} {:answer/id #uuid "c6ae1596-526e-508d-93b5-68553167d632" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186279419} {:answer/id #uuid "f59f2465-d3d0-5eb3-b992-ce8b3ed21929" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186279420} {:answer/id #uuid "089092dc-a832-5d38-9cdf-4903a4a3d120" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186279421} {:answer/id #uuid "e4aa431e-69b3-5481-bb8b-f574ad755cd8" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,8)" :db/id #edb/ref 17592186279422}] :answer-field/correct {:answer/id #uuid "e4aa431e-69b3-5481-bb8b-f574ad755cd8" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,8)" :db/id #edb/ref 17592186279422} :answer-field/id #uuid "b5fd171c-13e2-5c92-8a60-5a006bd259bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279417}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "75c8a190-b092-5b03-8511-92274bf3e6ef" :question/math-academy-id "q-211467" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/d8d23cf36bc9fb526c0e6d041b72e6b378638f662b67aae63531c66b4a8cd6c5.png)\n\nThe diagram above shows the local minimum and maximum of the function $y=f(x).$ What is the local maximum of $y=-f(x+2)+4?$" :question/worked-solution "Notice that the graph of $y=-f(x+2)+4$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $2$ units to the left, then\n\n- flipping it across the $x$-axis, and finally\n\n- translating it by $4$ units up.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the local **minimum** of $y=f(x)$ to the local **maximum** of $y=-f(x+2)+4.$ So, we need to find the image of $(1,-4),$ the local minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=-f(x+2)+4,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(1,-4).$\n\n- Then, we translate the graph by $2$ units to the left and get the graph of $y=f(x+2).$ After this transformation, the point $(1,-4)$ will be mapped to the point\n\n$$\n(1-2,-4)=(-1,-4).\n$$\n\n- Next, we flip the result across the $x$-axis and get the graph of $y=-f(x+2).$ After this transformation, the point $(-1,-4)$ will be mapped to the point\n\n$$\n(-1,-1\\cdot (-4))=(-1,4).\n$$\n\n- Finally, we translate the result by $4$ units up and get the graph of $y=-f(x+2)+4.$ After this transformation, the point $(-1,4)$ will be mapped to the point\n\n$$\n(-1,4+4)=(-1,8).\n$$\n\nTherefore, the local maximum of $y=-f(x+2)+4$ is $(-1,8).$"}] [{:db/id #edb/ref 17592186279423 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84fa52d7-3769-5c8f-8fc9-bfc10b7660d5" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186279425} {:answer/id #uuid "a32648d9-1a03-5f53-a6ea-46c6cf2a8154" :answer/type {:db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186279426} {:answer/id #uuid "6a53b1b5-e1c4-5462-9c63-4c79e6f7b529" :answer/type {:db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186279427} {:answer/id #uuid "ae5f35c5-a3f9-5894-a706-851046f38709" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186279428} {:answer/id #uuid "b2cea74e-d868-56c1-9a51-f2e2c7d50846" :answer/type {:db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186279429}] :answer-field/correct {:answer/id #uuid "ae5f35c5-a3f9-5894-a706-851046f38709" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186279428} :answer-field/id #uuid "f189ffb8-38d9-5093-b6d9-aa0fb7d5c491" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279424}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2caf7fca-45d7-567f-9ccb-591256e26fc0" :question/math-academy-id "q-38610" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/7c7a636ec47a5daaa64a9464dd428d74eae0feb6369756e741e863aef56048f7.png)\n\nWhich of the diagrams above can be the graph of the polynomial $y=-3{x}^{4}+{x}^{3}-4{x}^{2}+4x?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)=-3{x}^{4}+{x}^{3}-4{x}^{2}+4x\n$$\n\nThe degree $(n=4)$ is even and the leading coefficient $({a}_{4}=-3)$ is negative. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty .$\n\nNone of the graphs satisfy these conditions."}] [{:db/id #edb/ref 17592186279430 :knowledge-point/_questions [{:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69662929-1402-57dc-b4fe-bf6a0518be72" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/455cdbecad3ae0949462ee4c75a0dd9d4a199d3a2ac5f1546ced23dfda28d0ec.png" :db/id #edb/ref 17592186279432} {:answer/id #uuid "cfffd7e0-3304-55a8-b54c-e74eb7682ac4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/d9185fb471c9806d490133c6ea5a54ef69878f89ca0e0be66008ec3626bfe346.png" :db/id #edb/ref 17592186279433} {:answer/id #uuid "b625778a-5b09-55e5-9aa8-2e3fad33714b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/a9d867bd48a75348b681cea07bb5e1783c9e90e7c4b16e5cda1b6ad377658653.png" :db/id #edb/ref 17592186279434} {:answer/id #uuid "719dbd73-689c-5d20-996a-68b94d953711" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/d366ad5839b79b71bb16f7d00b98232623a58f980da77065767782348e8b7286.png" :db/id #edb/ref 17592186279435} {:answer/id #uuid "89107aca-6c90-5321-b053-1d734993b8af" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/5cebe6d18711ccc3b766388cdd45e6c876be31339fdb5b8fea0fed47cfef9388.png" :db/id #edb/ref 17592186279436}] :answer-field/correct {:answer/id #uuid "69662929-1402-57dc-b4fe-bf6a0518be72" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/455cdbecad3ae0949462ee4c75a0dd9d4a199d3a2ac5f1546ced23dfda28d0ec.png" :db/id #edb/ref 17592186279432} :answer-field/id #uuid "0214fca8-ffc1-5d18-bf2b-c14e1513dc9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279431}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "adbe85fe-aeef-503e-98e3-884dd5647b26" :question/math-academy-id "q-48074" :question/problem "Select the function that has a discontinuity at $x=1.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a vertical asymptote exactly at $x=1$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186097188 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97a67442-6da8-5289-8b70-6863c40e7349" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{2 + \\frac{3j}{n}} \\cdot \\frac{3}{n}\\right]" :db/id #edb/ref 17592186095486} {:answer/id #uuid "b0963f9d-4e60-5b13-809d-6b9cde451586" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{\\frac{j}{n}} \\cdot \\frac{1}{n}\\right]" :db/id #edb/ref 17592186095487} {:answer/id #uuid "c2314656-5705-53f9-a666-30e4415b3d18" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{\\frac{4j}{n}} \\cdot \\frac{4}{n}\\right]" :db/id #edb/ref 17592186095488} {:answer/id #uuid "ff89b638-0615-5632-a4a1-1f0ca2f81821" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{2 + \\frac{2j}{n}} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095489} {:answer/id #uuid "7ad6f3a2-f19b-5c4a-ada6-bb0f5452d370" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{2 + \\frac{4j}{n}} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095490}] :answer-field/correct {:answer/id #uuid "ff89b638-0615-5632-a4a1-1f0ca2f81821" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\lim_{n\\to\\infty}\\sum_{j=0}^{n-1}\\left[3\\sqrt{2 + \\frac{2j}{n}} \\cdot \\frac{2}{n}\\right]" :db/id #edb/ref 17592186095489} :answer-field/id #uuid "5dffe338-6c47-55ba-946c-790fd94e0c65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095485}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9edba8fa-85df-5a13-ac73-844331e577d2" :question/math-academy-id "q-49190" :question/problem "What is ${\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=3\\sqrt{x},$ the lower bound is $a=2,$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-2}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}3\\sqrt{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+j\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(2+\\frac{2j}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[3\\sqrt{2+\\frac{2j}{n}}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279437 :knowledge-point/_questions [{:knowledge-point/id #uuid "4640f978-9caa-5960-bec4-f153a1b4cc5d" :knowledge-point/title "Graphing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7cf9b79-fca6-5e96-808f-18c9eb14106e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/08925ef549329dc44ae8dc1711f101d6a2ffbbfa2c4fa225a6d21dccc458bb00.png" :db/id #edb/ref 17592186279439} {:answer/id #uuid "1f5ef09a-7921-55e5-8d51-670d80a3dbc0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/9c7701cbc6cdca05f3feed2c006837f5d057196b4617d1b5bb507b85ada04a68.png" :db/id #edb/ref 17592186279440} {:answer/id #uuid "18823835-a736-57ec-8dbc-bf9467d9b227" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/259f3b708829f6a814bc4937b44349b91e55ec5b4fb0f73d39b4c993287dabbd.png" :db/id #edb/ref 17592186279441} {:answer/id #uuid "5d1d42ee-8f2f-5503-8cd6-8fb2d38da05b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/a64e70fd5a6680fbf2ccb3236e64cbc51a014e9eecf6596d418e5a18a34fdfe6.png" :db/id #edb/ref 17592186279442} {:answer/id #uuid "7d4fd306-6e7e-596c-9480-76c4c005b8b1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/626fbb611d42800337f0b512cdb0e221e64808ec22e0b434c3bf3c1e6d9386cc.png" :db/id #edb/ref 17592186279443}] :answer-field/correct {:answer/id #uuid "e7cf9b79-fca6-5e96-808f-18c9eb14106e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/08925ef549329dc44ae8dc1711f101d6a2ffbbfa2c4fa225a6d21dccc458bb00.png" :db/id #edb/ref 17592186279439} :answer-field/id #uuid "0ee32811-81a6-5aef-87b9-d7856aa2c078" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279438}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aa63e32d-3bfc-528d-89ad-f9a58016f61a" :question/math-academy-id "q-98013" :question/problem "Which of the following is the graph of $y=\\frac{5}{2x}-2?$" :question/worked-solution "To plot $y=\\frac{5}{2x}-2,$ we apply the following steps:\n\n- Take the curve $y=\\frac{1}{x}.$\n\n- Then, stretch the result by a scale factor of $\\frac{5}{2}$ parallel to the $y$-axis to get the graph of $y=\\frac{5}{2x}.$\n\n- Translate it by $2$ units down to get the graph of $y=\\frac{5}{2x}-2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978982/assets/08925ef549329dc44ae8dc1711f101d6a2ffbbfa2c4fa225a6d21dccc458bb00.png)"}]}
