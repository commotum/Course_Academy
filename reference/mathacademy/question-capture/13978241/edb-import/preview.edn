{3}{2}(0-3)^{2} \\\\ 13 & =-3A+1+\\frac{27}{2} \\\\ 3A & =\\frac{3}{2} \\\\ A & =\\frac{1}{2}.\\end{aligned}\n$$\n\n  \n\nHence,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =\\frac{1}{2}\\cdot 1\\cdot \\frac{3}{2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" 13194139534145 true] [17592186278615 1000 #edb/ref 17592186278616 13194139534145 true] [17592186278615 1000 #edb/ref 17592186278617 13194139534145 true] [17592186278615 1000 #edb/ref 17592186278618 13194139534145 true] [17592186278615 1000 #edb/ref 17592186278619 13194139534145 true] [17592186278615 1000 #edb/ref 17592186278620 13194139534145 true] [17592186278615 1040 #edb/ref 17592186045450 13194139534145 true] [17592186278615 1041 "selection" 13194139534145 true] [17592186278615 1104 #edb/ref 17592186278619 13194139534145 true] [17592186278615 1110 #uuid "4d8ddaff-70b0-5395-8564-ff7a0a01fba0" 13194139534145 true] [17592186278616 1034 "\\frac{5}{9}" 13194139534145 true] [17592186278616 1103 #edb/ref 17592186045453 13194139534145 true] [17592186278616 1111 #uuid "0f2970d6-836e-5ea1-9e01-9e48b91ed4ea" 13194139534145 true] [17592186278617 1034 "\\frac{8}{3}" 13194139534145 true] [17592186278617 1103 #edb/ref 17592186045453 13194139534145 true] [17592186278617 1111 #uuid "abf53400-564f-58ab-9fa8-78cae31ae683" 13194139534145 true] [17592186278618 1034 "\\frac{7}{8}" 13194139534145 true] [17592186278618 1103 #edb/ref 17592186045453 13194139534145 true] [17592186278618 1111 #uuid "21a32b9a-8a94-5188-9ae1-42e1141909a7" 13194139534145 true] [17592186278619 1034 "\\frac{3}{4}" 13194139534145 true] [17592186278619 1103 #edb/ref 17592186045453 13194139534145 true] [17592186278619 1111 #uuid "e7ed92e9-e701-56e7-9332-f39625723b52" 13194139534145 true] [17592186278620 1034 "4" 13194139534145 true] [17592186278620 1103 #edb/ref 17592186045453 13194139534145 true] [17592186278620 1111 #uuid "1a3a2ef2-b214-5de4-98ac-48571d6c21b7" 13194139534145 true] [17592186278621 1017 #edb/ref 17592186278622 13194139534145 true] [17592186278621 