#{[{:db/id #edb/ref 17592186278600 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c" :knowledge-point/title "Calculating a Missing Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3c6cef-4821-5cde-a961-8f5d9962b093" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186278602}] :answer-field/correct {:answer/id #uuid "0f3c6cef-4821-5cde-a961-8f5d9962b093" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186278602} :answer-field/id #uuid "a1e24f06-4bc6-5b20-b7c6-e6284c15ccd1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278601}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "18a12b9a-7461-50bc-9f57-ae1e9fe1caba" :question/math-academy-id "q-351184" :question/problem "Express $\\frac{3x+2}{(x-7)^{2}}$ as a sum of partial fractions.\n\n|  | $\\frac{3x+2}{(x-7)^{2}}\\,=\\,\\frac{3}{(x-7)}\\,\\,+$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $(x-7)^{2}$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{3x+2}{(x-7)^{2}}=\\frac{3}{(x-7)}+\\frac{B}{(x-7)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-7)^{2}$ gives\n\n$$\n\\begin{aligned}3x+2 & =3(x-7)+B.\\end{aligned}\n$$\n\nLetting $x=7$ gives\n\n$$\n\\begin{aligned}3(7)+2 & =3(7-7)+B \\\\ 21+2 & =0+B \\\\ B & =23.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{3x+2}{(x-7)^{2}}=\\frac{3}{(x-7)}+\\frac{23}{(x-7)^{2}}.\n$$"}] [{:db/id #edb/ref 17592186278603 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d522275-494c-5eeb-9b9e-fe49700be388" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186278605} {:answer/id #uuid "671d99d5-de75-5cae-bcee-0b72274ee321" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186278606}] :answer-field/correct {:answer/id #uuid "5d522275-494c-5eeb-9b9e-fe49700be388" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186278605} :answer-field/id #uuid "408f8cfe-2b15-5d01-8d6d-ba2600657767" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278604} {:answer-field/choices [{:answer/id #uuid "681e2b5e-f798-5d04-9a53-424d4af5c996" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186278608}] :answer-field/correct {:answer/id #uuid "681e2b5e-f798-5d04-9a53-424d4af5c996" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186278608} :answer-field/id #uuid "d05e245c-743f-5a84-9c2d-de86fa184375" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278607}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cb7d6056-9e6c-5b8f-bb60-53303e862d5b" :question/math-academy-id "q-351199" :question/problem "Express $\\frac{6x-11}{(x-4)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{6x-11}{(x-4)^{2}}=$ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x-4$ |  | $(x-4)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\frac{6x-11}{(x-4)^{2}}=\\frac{A}{x-4}+\\frac{B}{(x-4)^{2}}.\n$$\n\nMultiplying both sides of the given equality by $(x-4)^{2}$ gives\n\n$$\n\\begin{aligned}6x-11 & =A(x-4)+B.\\end{aligned}\n$$\n\nLetting $x=4$  gives\n\n$$\n\\begin{aligned}6(4)-11 & =A(4-4)+B \\\\ 13 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}6(0)-11 & =A(0-4)+13 \\\\ -11 & =-4A+13 \\\\ -4A & =-24 \\\\ A & =6.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{6x-11}{(x-4)^{2}}=\\frac{6}{x-4}+\\frac{13}{(x-4)^{2}}.\n$$"}] [{:db/id #edb/ref 17592186278609 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44d2907e-b074-52e6-9bca-04362b6a7901" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278611}] :answer-field/correct {:answer/id #uuid "44d2907e-b074-52e6-9bca-04362b6a7901" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278611} :answer-field/id #uuid "07585a10-e010-5834-9410-b8ab0f307bf7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278610} {:answer-field/choices [{:answer/id #uuid "3a09c793-f6bb-593e-87d1-a2ed83b98e76" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186278613}] :answer-field/correct {:answer/id #uuid "3a09c793-f6bb-593e-87d1-a2ed83b98e76" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186278613} :answer-field/id #uuid "22b72410-be33-5ef6-b427-0007a014a680" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278612}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "11ffbcce-e7ba-5417-9376-ee3a8c9be870" :question/math-academy-id "q-351200" :question/problem "Express $\\frac{2x-9}{(x-3)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{2x-9}{(x-3)^{2}}=$ | {{field-1}} | $-$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x-3$ |  | $(x-3)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\frac{2x-9}{(x-3)^{2}}=\\frac{A}{x-3}+\\frac{B}{(x-3)^{2}}.\n$$\n\nMultiplying both sides of the given equality by $(x-3)^{2}$ gives\n\n$$\n\\begin{aligned}2x-9 & =A(x-3)+B.\\end{aligned}\n$$\n\nLetting $x=3$  gives\n\n$$\n\\begin{aligned}2(3)-9 & =A(3-3)+B \\\\ -3 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}2(0)-9 & =A(0-3)-3 \\\\ -9 & =-3A-3 \\\\ -3A & =-6 \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\frac{2x-9}{(x-3)^{2}}=\\frac{2}{x-3}-\\frac{3}{(x-3)^{2}}.\n$$"}] [{:db/id #edb/ref 17592186278614 :knowledge-point/_questions [{:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2970d6-836e-5ea1-9e01-9e48b91ed4ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186278616} {:answer/id #uuid "abf53400-564f-58ab-9fa8-78cae31ae683" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186278617} {:answer/id #uuid "21a32b9a-8a94-5188-9ae1-42e1141909a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186278618} {:answer/id #uuid "e7ed92e9-e701-56e7-9332-f39625723b52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186278619} {:answer/id #uuid "1a3a2ef2-b214-5de4-98ac-48571d6c21b7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186278620}] :answer-field/correct {:answer/id #uuid "e7ed92e9-e701-56e7-9332-f39625723b52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186278619} :answer-field/id #uuid "4d8ddaff-70b0-5395-8564-ff7a0a01fba0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278615}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cc6cc1c8-0a75-5675-928b-07439b81a637" :question/math-academy-id "q-49602" :question/problem "Given that \n\n$$\n\\frac{2{x}^{2}-9x+13}{(x-3)^{2}(x+1)}=\\frac{A}{(x-3)}+\\frac{B}{(x-3)^{2}}+\\frac{C}{(x+1)},\n$$\n\nwhere $A$, $B$, and $C$ are real constants, determine the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-3)^{2}(x+1)$ gives\n\n$$\n\\begin{aligned}2{x}^{2}-9x+13 & =A(x-3)(x+1)+B(x+1)+C(x-3)^{2}.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}2(-1)^{2}-9(-1)+13 & =A(-1-3)(-1+1)+B(-1+1)+C(-1-3)^{2} \\\\ 2+9+13 & =16C \\\\ 24 & =16C \\\\ C & =\\frac{3}{2}.\\end{aligned}\n$$\n\nLetting $x=3$  gives\n\n$$\n\\begin{aligned}2(3)^{2}-9(3)+13 & =A(3-3)(3+1)+B(3+1)+C(3-3)^{2} \\\\ 18-27+13 & =4B \\\\ 4 & =4B \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, letting $x=0$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}2(0)^{2}-9(0)+13 & =A(0-3)(0+1)+1(0+1)+\\frac{3}{2}(0-3)^{2} \\\\ 13 & =-3A+1+\\frac{27}{2} \\\\ 3A & =\\frac{3}{2} \\\\ A & =\\frac{1}{2}.\\end{aligned}\n$$\n\n  \n\nHence,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =\\frac{1}{2}\\cdot 1\\cdot \\frac{3}{2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278621 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f32ff73-3603-5db4-a22f-26e80c16d88b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186278623} {:answer/id #uuid "4578d40d-8b20-5e04-a8df-d977421b8445" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186278624} {:answer/id #uuid "663d6b92-55e5-52fa-8543-14af5432aa29" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186278625} {:answer/id #uuid "b85110a2-b0e3-5352-a39f-82fc9dd1e904" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186278626} {:answer/id #uuid "8a269ffa-9c75-50cf-b650-c67db9cc85a6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278627}] :answer-field/correct {:answer/id #uuid "8a269ffa-9c75-50cf-b650-c67db9cc85a6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186278627} :answer-field/id #uuid "779b4278-fd5a-58a6-82e8-edb8d9bdd814" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278622}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7fb682cd-5e99-5c85-88c9-5b57fef181a8" :question/math-academy-id "q-73385" :question/problem "Given that \n\n$$\n\\frac{4x-1}{(x-3)^{3}}=\\frac{A}{x-3}+\\frac{B}{(x-3)^{2}}+\\frac{C}{(x-3)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-3)^{3}$ gives\n\n$$\n\\begin{aligned}4x-1 & =A(x-3)^{2}+B(x-3)+C.\\end{aligned}\n$$\n\nLetting $x=3$  gives\n\n$$\n\\begin{aligned}4(3)-1 & =A(3-3)^{2}+B(3-3)+C \\\\ 11 & =A(0)+B(0)+C \\\\ C & =11.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(0)-1 & =A(0-3)^{2}+B(0-3)+11 \\\\ -1 & =9A-3B+11 \\\\ 0 & =9A-3B+12 \\\\ 0 & =3A-B+4 \\\\ B & =3A+4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=2$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(2)-1 & =A(2-3)^{2}+B(2-3)+11 \\\\ 7 & =A-B+11 \\\\ 0 & =A-B+4 \\\\ B & =4+A.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}3A+4 & =4+A \\\\ 2A & =0 \\\\ A & =0.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =4+0=4\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =0\\cdot 4\\cdot 11=0.\\end{aligned}\n$$"}]}
