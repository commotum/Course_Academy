7 true] [17592186252667 1000 #edb/ref 17592186252670 13194139533807 true] [17592186252667 1000 #edb/ref 17592186252671 13194139533807 true] [17592186252667 1000 #edb/ref 17592186252672 13194139533807 true] [17592186252667 1040 #edb/ref 17592186045450 13194139533807 true] [17592186252667 1041 "selection" 13194139533807 true] [17592186252667 1104 #edb/ref 17592186252670 13194139533807 true] [17592186252667 1110 #uuid "17e32d48-05f2-5c8b-b27d-682fc71fd79c" 13194139533807 true] [17592186252668 1034 "a=0.5,\\,b=-1.4" 13194139533807 true] [17592186252668 1103 #edb/ref 17592186045453 13194139533807 true] [17592186252668 1111 #uuid "0a565977-2287-518b-8c2d-94568532dbf4" 13194139533807 true] [17592186252669 1034 "a=1.5,\\,b=2.4" 13194139533807 true] [17592186252669 1103 #edb/ref 17592186045453 13194139533807 true] [17592186252669 1111 #uuid "175c6f1a-479f-5dde-9299-74ec7dfd10e3" 13194139533807 true] [17592186252670 1034 "a=1.2,\\,b=1.4" 13194139533807 true] [17592186252670 1103 #edb/ref 17592186045453 13194139533807 true] [17592186252670 1111 #uuid "be36a7c0-12c8-5acd-8f3f-1bb2aeacacb6" 13194139533807 true] [17592186252671 1034 "a=-1.2,\\,b=0.4" 13194139533807 true] [17592186252671 1103 #edb/ref 17592186045453 13194139533807 true] [17592186252671 1111 #uuid "f7d33353-f1b6-5902-b2a5-3199f6f564a8" 13194139533807 true] [17592186252672 1034 "a=0.2,\\,b=1.7" 13194139533807 true] [17592186252672 1103 #edb/ref 17592186045453 13194139533807 true] [17592186252672 1111 #uuid "517f2e68-a29f-5543-bc82-64db583b6526" 13194139533807 true] [17592186252673 1017 #edb/ref 17592186252674 13194139533807 true] [17592186252673 1089 "q-18702" 13194139533807 true] [17592186252673 1091 #edb/ref 17592186045465 13194139533807 true] [17592186252673 1100 "Let $(x,y)$ be the solution of the following system. What is the value of $x-y?$\n\n$$\n{\\begin{aligned}2.3x+4.6y=69 \\\\ 10x-20y=100\\end{aligned}\n$$" 13194139533807 true] [17592186252673 1113 #uuid "f271da85-4c2f-5548-b34e-bfcbc915419e" 131941395338