d713b6974e66608.png" :db/id #edb/ref 17592186377623} :answer-field/id #uuid "e7bc1c81-08a7-5866-b655-e5a6a758afc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377618}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "781c20e7-0cf2-5b84-94ac-d0ecc8cce115" :question/math-academy-id "q-184506" :question/problem "Let $I=[0,2]⊂R$ and ${X}_{i}={i}\\times [-i,i].$ Which of the following represents ${⋃}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the union of a family of indexed sets consists of those elements that belong to *at least one* set:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for at least one}\\,\\,k\\in I}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=1,$ we have \n\n$$\n{X}_{1}={1}\\times [-1,1]={(1,k)\\,:\\,k\\in [-1,1]}.\n$$\n\nThis represents a vertical line segment from the point $(1,-1)$ to the point $(1,1)$ in the coordinate plane, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/f26fa8a525806370f5505ad097ead2b289192bb3a6eb3e341eb7c2f91a03531f.png)\n\nIn general,\n\n$$\n{X}_{i}={i}\\times [-i,i]={(i,k)\\,:\\,k\\in [-i,i]}\n$$\n\nis the vertical line segment from the point $(i,-i)$ to the point $(i,i).$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/bfeafe4c3b800b33b4f8550de02c2eb908effb5c28ef59b40f8c5e2bcad38ac4.png)\n\nAs $i$ runs over $I,$ these line segments sweep the following triangle that represents the union ${⋃}_{i\\in I}{X}_{i}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/4d860b60ab9e139b26c9f6e1d330188d5e752a51624a2374ad713b6974e66608.png)"}] [{:db/id #edb/ref 17592186308037 :knowledge-point/_questions [{:knowledge-point/id #uuid "5793f07d-e0de-5707-a5e1-32d657244e0b" :knowledge-point/title "Visualizing Intersections of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb34c5ca-e1ec-5bff-a6c1-dfefe7196dd0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png" :db/id #edb/ref 17592186308039} {:answer/id #uuid "70ed1b78-a8f8-52f9-8f84-6fb39ffab773" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/5e474959f4172f2a3dc7d104a5b7e27a8eece4fc1f13421fefdfdfc2e139c139.png" :db/id #edb/ref 17592186308040} {:answer/id #uuid "9ef4002b-12fd-55a6-b140-4b4496a21f07" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/37de777f63941a62b003a4c600a40df648b3d39ce3c1dfc753c6f406fe230330.png" :db/id #edb/ref 17592186308041} {:answer/id #uuid "6a36a47b-91e8-52db-859a-472192176ea0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/efb6d92ea0dc70fa0cbd9d82ea838b41a4eaab6ee2fc32c6fada9258a4154680.png" :db/id #edb/ref 17592186308042} {:answer/id #uuid "f4968d13-0264-5929-ab6c-6780d8208be3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/47ee12b24246473a45e057d4da6dac5190a4eab23e18bb37bef494bf07627daa.png" :db/id #edb/ref 17592186308043}] :answer-field/correct {:answer/id #uuid "cb34c5ca-e1ec-5bff-a6c1-dfefe7196dd0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040430/assets/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png" :db/id #edb/ref 17592186308039} :answer-field/id #uuid "aa70e261-3b80-5b2f-ac47-ee8c6eb9adeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308038}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2f711893-9075-516f-888f-e39a0f91809d" :question/math-academy-id "q-184507" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[0,2]\\times [-i,0].$ Which of the following represents ${⋂}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the intersection of a family of indexed sets consists of those elements that belong to *all* the sets:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for all}\\,\\,k\\in I}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[0,2]\\times [-0.5,0]={(a,b)\\,:\\,a\\in [0,2],b\\in [-0.5,0]}.\n$$\n\nThis represents a rectangle whose vertices are at $(0,0),$ $(2,0),$ $(2,-0.5),$ and $(0,-0.5)$ in the coordinate plane, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/5837864bfcc40e680cf62b43c0e3d145ba05b1f25e1ccae2f4788902d030d927.png)\n\nIn general,\n\n$$\n{X}_{i}=[0,2]\\times [-i,0]={(a,b)\\,:\\,a\\in [0,2],b\\in [-i,0]}\n$$\n\nis the rectangle whose vertices are at $(0,0),$ $(2,0),$ $(2,-i),$ and $(0,-i).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/f0c20436f03db4b0003d087827cefbd76506af423da3f0a3042082b5afeb4b58.png)\n\nThe intersection of all these rectangles is the line segment $[0,2]\\times {0}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/236d10f31265b400036e1ddeafa122991bcae1ea878af8b300003fb11acfa85b.png)"}] [{:db/id #edb/ref 17592186377624 :knowledge-point/_questions [{:knowledge-point/id #uuid "5793f07d-e0de-5707-a5e1-32d657244e0b" :knowledge-point/title "Visualizing Intersections of Uncountable Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c433a444-dab5-5cba-a2b4-737de2569c74" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/4fdd8fc71b47304bb87e2d70a229bc0a545f85f0fe268d79036884421ed3765e.png" :db/id #edb/ref 17592186377626} {:answer/id #uuid "d6e0847d-48c2-52b2-9c3f-79d2f7455a98" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/456350246eb5d24142f2b53258bb20fa0c74ad377e90d23ce340b8883d8b418a.png" :db/id #edb/ref 17592186377627} {:answer/id #uuid "255d80c7-a9f6-50b6-9724-e36f4500666b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/e59f8125b6d08911872b10d054a1511c1a24b5a1d97640fd9651f44e50dcdb13.png" :db/id #edb/ref 17592186377628} {:answer/id #uuid "e8f006ad-7444-50df-a096-3fe0147bb8c3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/7956b4104095d675121cea6842ffcaada60730e9963e2884738d3b2961f7e2e6.png" :db/id #edb/ref 17592186377629} {:answer/id #uuid "a7a78818-1aab-5eb7-89a7-b41e6e9e95be" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/17a176a0e7cb254483d93741cd2c1e3db581005f479928ac36809e55bc970c07.png" :db/id #edb/ref 17592186377630}] :answer-field/correct {:answer/id #uuid "c433a444-dab5-5cba-a2b4-737de2569c74" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/4fdd8fc71b47304bb87e2d70a229bc0a545f85f0fe268d79036884421ed3765e.png" :db/id #edb/ref 17592186377626} :answer-field/id #uuid "d1a6bcdb-a9a8-5352-a137-8b9882c90d08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377625}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aaaa0132-50ce-55c2-8cb3-cf438d123c79" :question/math-academy-id "q-184508" :question/problem "Let $I=[0,1]⊂R$ and ${X}_{i}=[-2i,2i]\\times [-i,i].$ Which of the following represents ${⋂}_{i\\in I}{X}_{i}?$" :question/worked-solution "Recall that the intersection of a family of indexed sets consists of those elements that belong to *all* the sets:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\,:\\,x\\in {A}_{k}\\,\\,\\text{for all}\\,\\,k\\in I}\n$$\n\nLet's now write down one of our indexed sets. For example, if $i=0.5,$ we have \n\n$$\n{X}_{0.5}=[-1,1]\\times [-0.5,0.5]={(a,b)\\,:\\,a\\in [-1,1],b\\in [-0.5,0.5]}.\n$$\n\nThis represents a rectangle whose vertices are at $(-1,-0.5),$ $(-1,0.5),$ $(1,0.5),$ and $(1,-0.5)$ in the coordinate plane, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/0a3f27ff85f8a5b56e912f33976846b36fc90d35a87201c146c5345f4e31ba46.png)\n\nIn general,\n\n$$\n{X}_{i}=[-2i,2i]\\times [-i,i]={(a,b)\\,:\\,a\\in [-2i,2i],b\\in [-i,i]}\n$$\n\nis the rectangle whose vertices are at $(-2i,-i),$ $(-2i,i),$ $(2i,i),$ and $(2i,-i).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/d32279c2279fe234accaae96e5abc86a122adf60dc930c5e299b2f0c2db0028e.png)\n\nThe intersection of all these rectangles is the point $(0,0):$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/4fdd8fc71b47304bb87e2d70a229bc0a545f85f0fe268d79036884421ed3765e.png)"}]}
