#{[{:db/id #edb/ref 17592186280237 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27" :knowledge-point/title "Calculating the Slope of the Tangent to a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580202dd-3fea-5679-af87-c2bc9c132183" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186280239} {:answer/id #uuid "92d654cf-26ee-54fa-9c1e-ef823f34bec3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186280240} {:answer/id #uuid "e7c57dc7-1f1a-5a6e-b1a2-16b6f0e563df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186280241} {:answer/id #uuid "53825d27-7c1f-5288-b7f6-b208c4a85b1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280242} {:answer/id #uuid "8f9373b0-73fa-5a8e-8ec4-b45683795d8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186280243}] :answer-field/correct {:answer/id #uuid "580202dd-3fea-5679-af87-c2bc9c132183" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186280239} :answer-field/id #uuid "f4ab19c6-acbb-5c20-a748-33e4d8506737" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280238}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7624a235-ab14-553b-803a-f56f725749db" :question/math-academy-id "q-102940" :question/problem "For the parametric curve \n\n$$\nx=2{t}^{2}+3,\\,y=3{t}^{5}+{t}^{3},\\,0\\le t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=4t,\\,{y}^{′}(t)=3{t}^{2}(5{t}^{2}+1).\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{3{t}^{2}(5{t}^{2}+1)}{4t}=\\frac{3t(5{t}^{2}+1)}{4}.\\end{aligned}\n$$\n\nTherefore, when $t=1,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{3(1)(5(1)^{2}+1)}{4} \\\\  & =\\frac{18}{4} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280244 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27" :knowledge-point/title "Calculating the Slope of the Tangent to a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ce6b55c-f51e-5a76-9782-ae5e346fb42e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280246} {:answer/id #uuid "b29d8346-6d37-530f-8757-381236111818" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,\\frac{1}{2}" :db/id #edb/ref 17592186280247} {:answer/id #uuid "517d6982-f305-577e-87cc-be4e0e966542" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186280248} {:answer/id #uuid "0d60e1b7-d80e-5ec8-b197-8f8e3e7976c7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,\\sqrt{3}" :db/id #edb/ref 17592186280249} {:answer/id #uuid "1324b2b8-e238-5bff-8f34-2b102dd2d6eb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186280250}] :answer-field/correct {:answer/id #uuid "1324b2b8-e238-5bff-8f34-2b102dd2d6eb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186280250} :answer-field/id #uuid "bc35beed-7ff2-518c-977d-441db5683bef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280245}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a30e060e-8fbc-5c7c-b8b0-45023960607a" :question/math-academy-id "q-15457" :question/problem "For the parametric curve \n\n$$\nx=\\operatorname{sin}⁡(2t),\\,y={cos}^{2}⁡(t),\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{6}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡(2t),\\,{y}^{′}(t)=-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t=-\\operatorname{sin}⁡(2t).\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{-\\operatorname{sin}⁡(2t)}{2\\operatorname{cos}⁡(2t)} \\\\  & =-\\frac{1}{2}\\operatorname{tan}⁡(2t).\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{6},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{1}{2}\\,\\operatorname{tan}⁡(\\frac{2\\pi }{6}) \\\\  & =-\\,\\frac{1}{2}\\,\\operatorname{tan}⁡(\\frac{\\pi }{3}) \\\\  & =-\\,\\frac{\\sqrt{3}}{2}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280251 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27" :knowledge-point/title "Calculating the Slope of the Tangent to a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7392b79-be64-50f2-83be-35fc7f0a24bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186280253} {:answer/id #uuid "57a0dad2-5f05-5730-82a8-3433df852bf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186280254} {:answer/id #uuid "916b006c-543c-5c12-9315-ed7021903064" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186280255} {:answer/id #uuid "7b7b6f22-1628-5746-aeff-15d4bf0f2d84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186280256} {:answer/id #uuid "73ac7292-924c-5976-9a55-cb32e87c3d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186280257}] :answer-field/correct {:answer/id #uuid "916b006c-543c-5c12-9315-ed7021903064" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186280255} :answer-field/id #uuid "c5a81521-a24f-5dd0-87f2-f8493118e35e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280252}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7f9e0331-ffe6-5489-b436-faf1f0bea590" :question/math-academy-id "q-15469" :question/problem "For the parametric curve \n\n$$\nx=2{t}^{3}+1,\\,y={t}^{4}+2{t}^{2},\\,0\\le t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=6{t}^{2},\\,{y}^{′}(t)=4t({t}^{2}+1).\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{4t({t}^{2}+1)}{6{t}^{2}} \\\\  & =\\frac{2({t}^{2}+1)}{3t}.\\end{aligned}\n$$\n\nTherefore, when $t=1,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2((1)^{2}+1)}{3\\cdot 1} \\\\  & =\\frac{4}{3}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280258 :knowledge-point/_questions [{:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499b0218-ae69-579d-9205-ae2ed67fa112" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186280260} {:answer/id #uuid "5e3ed63d-fc55-5d63-857c-b186e66f8b7b" :answer/type {:db/ident :answer.type/math} :answer/value "-2e" :db/id #edb/ref 17592186280261}] :answer-field/correct {:answer/id #uuid "5e3ed63d-fc55-5d63-857c-b186e66f8b7b" :answer/type {:db/ident :answer.type/math} :answer/value "-2e" :db/id #edb/ref 17592186280261} :answer-field/id #uuid "13484f49-5055-5f6f-abda-84c97c7d98f7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280259}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bcc9886b-9868-59ad-af40-79950852f43a" :question/math-academy-id "q-353340" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979831/assets/e0b1dc90950ba127e90fce400bc7ed1b6e8dd8e710ff880ab5949521b02a258a.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=4{e}^{-t},\\,y={t}^{2}+6t,\\,0\\le t<\\infty ,\n$$\n\nfind the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$ Do not round the answer.\n\n$\\frac{dy}{dx}{|}_{t\\,=\\,1}=$  \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-4{e}^{-t},\\,{y}^{′}(t)=2t+6.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2t+6}{(-4{e}^{-t})}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx}{|}_{t\\,=\\,1} & =\\frac{2(1)+6}{(-4{e}^{-1})} \\\\  & =\\frac{8e}{(-4)} \\\\  & =-2e.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280262 :knowledge-point/_questions [{:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1b35709-7ba5-5d24-a5b7-0c00dd296e7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}e^{-2t}" :db/id #edb/ref 17592186280264}] :answer-field/correct {:answer/id #uuid "c1b35709-7ba5-5d24-a5b7-0c00dd296e7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}e^{-2t}" :db/id #edb/ref 17592186280264} :answer-field/id #uuid "b5333d5a-78d9-5430-ba42-aef3ddd114ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280263}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cee6bcbe-4838-5f33-9194-61f49470e510" :question/math-academy-id "q-353347" :question/problem "For the parametric curve \n\n$$\nx={e}^{3t},\\,y=2{e}^{t},\\,-\\infty <t<\\infty ,\n$$\n\ncalculate $\\frac{dy}{dx}$ as a function of $t.$\n\n$\\frac{dy}{dx}=$  \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=3{e}^{3t},\\,{y}^{′}(t)=2{e}^{t}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2{e}^{t}}{3{e}^{3t}}=\\frac{2}{3}{e}^{-2t}.\n$$"}]}
