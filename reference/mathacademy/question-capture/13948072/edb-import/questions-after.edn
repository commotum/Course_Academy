\\\  & =-\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186263949 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20712bd1-ce82-5fa3-a8f5-064418caddcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263951} {:answer/id #uuid "d3041811-5377-54cf-aa35-401f351b822a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263952} {:answer/id #uuid "d8140726-31b9-5010-8ce8-a6fbda0f3cfb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263953} {:answer/id #uuid "c1fc3292-6b00-50a5-bf24-55cbcdc9f7ac" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263954} {:answer/id #uuid "11744255-bc19-58e5-93e2-2a2962b8834f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263955}] :answer-field/correct {:answer/id #uuid "d3041811-5377-54cf-aa35-401f351b822a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186263952} :answer-field/id #uuid "bb910921-13f2-5e87-846b-9ed409c10565" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263950}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d8e15d67-0bf8-5826-ab6f-21142ae7304c" :question/math-academy-id "q-49453" :question/problem "Calculate $\\int \\frac{3}{x+4}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x+4}\\,\\text{d}x & =3\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡|x+4|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186263956 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff60ba8d-96f8-5329-827b-4667532ac035" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186263958} {:answer/id #uuid "e4b78b73-0f64-5286-a6db-45a852c7c5eb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186263959} {:answer/id #uuid "9a590b93-d252-5253-a8bb-c3c8bd0c9259" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186263960} {:answer/id #uuid "8ebc119a-f57a-5157-bc2a-0b60305cca58" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186263961} {:answer/id #uuid "2f9d8e7f-125a-5431-8116-1652a023aa0e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186263962}] :answer-field/correct {:answer/id #uuid "8ebc119a-f57a-5157-bc2a-0b60305cca58" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186263961} :answer-field/id #uuid "0d8319af-916b-571f-8b8e-4f1292508bfb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263957}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7401a93d-d215-50f1-b152-9a8bc62bddec" :question/math-academy-id "q-49454" :question/problem "Calculate $\\int \\frac{1}{x+3}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x+3|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186263963 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1114788-e89f-5089-9a61-46c57f7d69b0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(3+2x)(3-2x)|)" :db/id #edb/ref 17592186263965} {:answer/id #uuid "317cdb68-1ebd-510f-9e80-71a08857b5ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)" :db/id #edb/ref 17592186263966} {:answer/id #uuid "6b0d1e4a-3071-5f62-8250-272da6a09705" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)" :db/id #edb/ref 17592186263967} {:answer/id #uuid "802178bd-2178-5d0c-bdf6-70088fa39eb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(3+2x)(3-2x)|)" :db/id #edb/ref 17592186263968} {:answer/id #uuid "20b4b31d-ae73-55e7-988e-da95de04ebb2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)" :db/id #edb/ref 17592186263969}] :answer-field/correct {:answer/id #uuid "317cdb68-1ebd-510f-9e80-71a08857b5ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)" :db/id #edb/ref 17592186263966} :answer-field/id #uuid "3d163982-cc38-5ca5-a694-0069c3c99631" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263964}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "60a91add-0903-56f4-935c-48de4ab0b154" :question/math-academy-id "q-49520" :question/problem "Calculate $\\int (\\frac{1}{3+2x}+\\frac{1}{3-2x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{3+2x}+\\frac{1}{3-2x})\\,\\text{d}x & =\\int \\frac{1}{3+2x}\\,\\text{d}x+\\int \\frac{1}{3-2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|3+2x|-\\frac{1}{2}\\operatorname{ln}⁡|3-2x|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|\\frac{3+2x}{3-2x}|+\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186064789 :knowledge-point/_questions [{:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba259281-257f-54f2-9ebd-235d0cb66c38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\ln (K \\mid (2 + 4x)(2 - 4x) \\mid)" :db/id #edb/ref 17592186063245} {:answer/id #uuid "cf8e5cbe-fa70-5931-8356-41ba1621d123" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\ln (K \\mid \\frac{2 + 4x}{2 - 4x} \\mid)" :db/id #edb/ref 17592186063246} {:answer/id #uuid "e56eec3e-6d90-5279-a5df-3bafcbbbd7fe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\ln (K \\mid \\frac{2 + 4x}{2 - 4x} \\mid)" :db/id #edb/ref 17592186063247} {:answer/id #uuid "f8d5211b-af9e-5b7b-8f1f-61e758a489bb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln (K \\mid \\frac{2 + 4x}{2 - 4x} \\mid)" :db/id #edb/ref 17592186063248} {:answer/id #uuid "ff606254-903e-5f32-bb04-57a169b59635" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\ln (K \\mid (2 + 4x)(2 - 4x) \\mid)" :db/id #edb/ref 17592186063249}] :answer-field/correct {:answer/id #uuid "cf8e5cbe-fa70-5931-8356-41ba1621d123" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\ln (K \\mid \\frac{2 + 4x}{2 - 4x} \\mid)" :db/id #edb/ref 17592186063246} :answer-field/id #uuid "11245a17-a422-5189-95c0-2d8bae5322d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063244}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "839e83ca-5b4f-5953-9460-4e14411c5b1d" :question/math-academy-id "q-49524" :question/problem "Calculate $\\displaystyle \\int(\\frac{1}{2 + 4x} + \\frac{1}{2 - 4x})dx$." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2+4x}+\\frac{1}{2-4x})\\,\\text{d}x & =\\int \\frac{1}{2+4x}\\,\\text{d}x+\\int \\frac{1}{2-4x}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡|2+4x|-\\frac{1}{4}\\operatorname{ln}⁡|2-4x|+C \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡|\\frac{2+4x}{2-4x}|+\\frac{1}{4}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{2+4x}{2-4x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186263970 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3570c3c-195b-50b4-9be1-59595d9bc36c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263972} {:answer/id #uuid "9e6c39c9-9a7d-574e-b1a7-ef2cc695a324" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263973} {:answer/id #uuid "884765da-44b3-5e35-b124-74a5434d058c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263974} {:answer/id #uuid "2ccaa398-d0eb-5449-8fa2-22418c65a405" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263975} {:answer/id #uuid "bbb0e343-32d4-5fa1-9f28-39811e10ca3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263976}] :answer-field/correct {:answer/id #uuid "9e6c39c9-9a7d-574e-b1a7-ef2cc695a324" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186263973} :answer-field/id #uuid "4e1ccc23-99eb-55f9-bc95-8ad5450e4e06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263971}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eeef24b2-b947-590d-85bd-cdc2cbb91d09" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"}]}
