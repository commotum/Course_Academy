6ef66f59b406ad15"] :db/ensure [:answer-field/validate]} {:db/id "q-49452" :question/id #uuid "caf49955-282a-52e4-908b-2efd5cbba777" :question/math-academy-id "q-49452" :question/problem "$\\int \\frac{1}{2-3x}\\,\\text{d}x=$" :question/worked-solution "First, let $u=2-3x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,\\text{d}x=-\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u$, solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{2-3x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{3}\\,\\text{d}u) \\\\  & =-\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049"] :knowledge-point/questions ["q-49452"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-15707"] :question/worked-solution "First, let $u=x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x+1}\\,\\text{d}x & =2\\int \\frac{1}{x+1}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|x+1|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-49450/selection/921f2d7ba2a753f4f1cbac0f37ed6d00a670203c0f99c717aa738c3c83af2020" :answer/id #uuid "93038219-08eb-52fe-9233-c5ea46522482" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|x|+C" :db/ensure [:answer/validate]} {:db/id "q-49450/sel