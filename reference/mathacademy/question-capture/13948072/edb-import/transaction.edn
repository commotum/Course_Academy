" "q-49520/selection/ee3547e05c9972c8e662d472c0eae9ea7307be022b58ad95dae083ea92978c26"] :db/ensure [:answer-field/validate]} {:db/id "q-49520" :question/id #uuid "60a91add-0903-56f4-935c-48de4ab0b154" :question/math-academy-id "q-49520" :question/problem "Calculate $\\int (\\frac{1}{3+2x}+\\frac{1}{3-2x})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{3+2x}+\\frac{1}{3-2x})\\,\\text{d}x & =\\int \\frac{1}{3+2x}\\,\\text{d}x+\\int \\frac{1}{3-2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|3+2x|-\\frac{1}{2}\\operatorname{ln}⁡|3-2x|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|\\frac{3+2x}{3-2x}|+\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3+2x}{3-2x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49520/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef"] :knowledge-point/questions ["q-49520"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49360/selection/ab02d0332538593293d2d8516f096f75118ad734b51a48bc8895966676efac34" :answer/id #uuid "ed250bf7-f145-57a8-85b0-47e36b038faf" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/ensure [:answer/validate]} {:db/id "q-49360/selection/4c47186173586ab7294c00d0550e64740a66414b1f352aa818fe88f74ae7d557" :answer/id #uuid "0c8955d0-de70-5005-a156-5b8d02b925e8" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|\\frac{1+x}{1-x}|)" :db/ensure [:answer/validate]} {:db/id "q-49360/selection/33d791572ce2bf2f856a143cccda426d38d7666331cbcfea54268c83633b0041" :answer/id #uuid "2f2eafdf-b77a-507f-a90d-e3b8070c3dd0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|\\frac{