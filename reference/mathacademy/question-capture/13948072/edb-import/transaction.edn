ect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x-1}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x-1|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049"] :knowledge-point/questions ["q-49450"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72446/selection/42154eb089811a806734892454d880adefaa7b70da218154897311d351c4fefa" :answer/id #uuid "9e6c39c9-9a7d-574e-b1a7-ef2cc695a324" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/ensure [:answer/validate]} {:db/id "q-72446/selection/da94747f708dc6488cd2052ced19459b779fc13401af9c0e8738431b5c70bd5b" :answer/id #uuid "2ccaa398-d0eb-5449-8fa2-22418c65a405" :answer/type :answer.type/math :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/ensure [:answer/validate]} {:db/id "q-72446/selection/f4e4446ee43ce0ed419bdf50ad2b5dc6f79068406d108e9399a4dc3b59ad31dc" :answer/id #uuid "bbb0e343-32d4-5fa1-9f28-39811e10ca3e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/ensure [:answer/validate]} {:db/id "q-72446/selection/413dc55c96878820fd8b5949149a85ad44636bb3c7138966c62e680fa32aae63" :answer/id #uuid "a3570c3c-195b-50b4-9be1-59595d9bc36c" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/ensure [:answer/validate]} {:db/id "q-72446/selection/74765a9345a16fdfa4ef2b973bbd79f3226b7075124168110cd05011a1add2e1" :answer/id #uuid "884765da-44b3-5e35-b124-74a5434d058c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/ensure [:answer/validate]} {:db/id "q-72446/selection" :answer-field/id #uuid "4e1ccc23-99eb-55f9-bc95-8ad5450e4e06" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72446/selection/42154eb089811a806734892454d880adefaa7b70da218154897311d351c4fefa" :answer-field/choices ["q-72446/selection/42154eb089811a806734892454d880adefaa7b70da218154897311d351c4fefa" "q-72446/selection/da94747f708dc6488cd2052ced19459b779fc13401af9c0e8738431b5c70bd5b" "q-72446/selection/f4e4446ee43ce0ed419bdf50ad2b5dc6f79068406d108e9399a4dc3b59ad31dc" "q-72446/selection/413dc55c96878820fd8b5949149a85ad44636bb3c7138966c62e680fa32aae63" "q-72446/selection/74765a9345a16fdfa4ef2b973bbd79f3226b7075124168110cd05011a1add2e1"] :db/ensure [:answer-field/validate]} {:db/id "q-72446" :question/id #uuid "eeef24b2-b947-590d-85bd-cdc2cbb91d09" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72446/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d"] :knowledge-point/questions ["q-72446"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113538/selection/a6cf71de6197eea240c1d8ebd681dd6794cf4086fcfaaac82dbbe5684d8154d3" :answer/id #uuid "b63aaaed-f8c7-5922-8061-ed1694f4d3d0" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)" :db/ensure [:answer/validate]} {:db/id "q-113538/selection/947c797a4011951521bb0ea13a0b27aba3f4f25e0bd6d3266e4261357bf3ed82" :answer/id #uuid "695aaa94-6f83-5edc-96ca-ab870d0db9ba" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡(K|1-4x|)" :db/ensure [:answer/validate]} {:db/id "q-113538/selection/6cd159b66c6896856ab92b51ce9d10edd13c86a3baa880c20644df98801994bf" :answer/id #uuid "afaca415-f89f-5dc7-9748-e70c1adf5470" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}\\operatorname{ln}⁡(K|1-4x|)" :db/ensure [:answer/validate]} {:db/id "q-113538/selection/b4519cd180be2c8927ca8ab022dc2a9894eceb73148326bd683473682492af68" :answer/id #uuid "0c8fc029-848c-55e8-9e45-eee733e043d2" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)" :db/ensure [:answer/validate]} {:db/id "q-113538/selection/12f7004144981859019f2a82c868b43e5c74f44a6420fe91edc3069ad27b7cca" :answer/id #uuid "8b5f49ae-cdae-5bb9-8611-2370f3e8645f" :answer/type :answer.type/math :answer/value "\\frac{3}{8}\\operatorname{ln}⁡(\\frac{K}{|1-4x|})" :db/ensure [:answer/validate]} {:db/id "q-113538/selection" :answer-field/id #uuid "1fb8989a-9843-54b5-b784-e3d5f647de17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113538/selection/b4519cd180be2