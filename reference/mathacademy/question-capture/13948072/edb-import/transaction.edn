ed-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{x+3}+\\frac{1}{x-3})\\,\\text{d}x & =\\int \\frac{1}{x+3}\\,\\text{d}x+\\int \\frac{1}{x-3}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x+3|+\\operatorname{ln}⁡|x-3|+C \\\\  & =\\operatorname{ln}⁡|(x+3)(x-3)|+\\operatorname{ln}⁡K \\\\  & =\\operatorname{ln}⁡(K|(x+3)(x-3)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113544/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef"] :knowledge-point/questions ["q-113544"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113540/selection/b01f22c3a95848f89f2b36484d2c0b57da09ca0b94f79e93bc2f046da230a9ef" :answer/id #uuid "3079fd7b-f36d-5e2a-bfe4-4bf229a24c4c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/ensure [:answer/validate]} {:db/id "q-113540/selection/38837b549e41aff3a266f6188b693e55ab48f3c23088f2fc87672993ced67eff" :answer/id #uuid "1ac17f0e-436a-51f5-8b4e-ec9c08a4b51c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/ensure [:answer/validate]} {:db/id "q-113540/selection/cb070b0e57f43be6654d72feed27f16e2ebae3c3a238254f2007783fcbb4de34" :answer/id #uuid "a2e7c119-2538-520d-85bb-19ce0176502a" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/ensure [:answer/validate]} {:db/id "q-113540/selection/2ff996dd99a8bcf839cbdad84a01654ee9e4acdc4447ca4ec667e9aa7e2a8af1" :answer/id #uuid "91d73ed6-208d-5511-8f35-9d2f3479f0be" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/ensure [:answer/validate]} {:db/id "q-113540/selection/ecace42264a900565587ca8c96c50e808c8cc720c016398e23ad4bd1ed239d23" :answer/id #uuid "dd0f1b08-8841-5fe1-bc