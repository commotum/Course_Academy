|).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113538/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d"] :knowledge-point/questions ["q-113538"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30368/selection/d4923dceedb7bd9ec004c3611a4fb49837d0390695f6ecdb08687f62fc548f87" :answer/id #uuid "d09a5cad-97ad-5539-a545-7c6dde319ecf" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/ensure [:answer/validate]} {:db/id "q-30368/selection/89bf62d1ec4a6c87457f600ad31af8ca823d7f870ad02712a4ca436fd4c285d1" :answer/id #uuid "5610758c-288f-5760-8dee-bd20623fa045" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/ensure [:answer/validate]} {:db/id "q-30368/selection/246488308507629c5015caf5571264598b40203cd74dbf45ce49cd55379dfcfa" :answer/id #uuid "3b240a31-bbe0-50be-9398-ac1c24be5b38" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/ensure [:answer/validate]} {:db/id "q-30368/selection/b5f4e86ef33a3e2322cdbe9105dd255e443917f7cf1230b7d94c5f9e4fd8a325" :answer/id #uuid "0055d834-757f-59e3-a7dc-cfeb671ea6b3" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/ensure [:answer/validate]} {:db/id "q-30368/selection/ee37eaa7e0cefb24bbaa26cc7a1ce1ead52045294a528bf69eaa45dccb3d4c8e" :answer/id #uuid "7389b19a-807b-55d1-bd05-4165f1a27d8c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/ensure [:answer/validate]} {:db/id "q-30368/selection" :answer-field/id #uuid "616a6c30-5826-5ad3-bfb7-4e020555b25d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30368/selection/89bf62d1ec4a6c87457f600ad31af8ca823d7f870ad02712a4ca436fd4c285d1" :answer-field/choices ["q-30368/selection/d4923dceedb7bd9ec004c3611a4fb49837d0390695f6ecdb08687f62fc548f87" "q-30368/selection/89bf62d1ec4a6c87457f600ad31af8ca823d7f870ad02712a4ca436fd4c285d1" "q-30368/selection/246488308507629c5015caf5571264598b40203cd74dbf45ce49cd55379dfcfa" "q-30368/selection/b5f4e86ef33a3e2322cdbe9105dd255e443917f7cf1230b7d94c5f9e4fd8a325" "q-30368/selection/ee37eaa7e0cefb24bbaa26cc7a1ce1ead52045294a528bf69eaa45dccb3d4c8e"] :db/ensure [:answer-field/validate]} {:db/id "q-30368" :question/id #uuid "99292ea7-f528-52cb-8492-bc9d8ca80636" :question/math-academy-id "q-30368" :question/problem "Calculate $\\int \\frac{1}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x+4}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30368/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d"] :knowledge-point/questions ["q-30368"] :db/ensure [:knowledge-point/validate]} {: