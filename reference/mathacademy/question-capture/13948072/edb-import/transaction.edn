 :db/ensure [:answer-field/validate]} {:db/id "q-49454" :question/id #uuid "7401a93d-d215-50f1-b152-9a8bc62bddec" :question/math-academy-id "q-49454" :question/problem "Calculate $\\int \\frac{1}{x+3}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x+3|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49454/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049"] :knowledge-point/questions ["q-49454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49453/selection/5cd94a1ab4162db8d3ac1067f684eb87818efc5d4ba8266e804d36fe30f49b3b" :answer/id #uuid "d8140726-31b9-5010-8ce8-a6fbda0f3cfb" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/ensure [:answer/validate]} {:db/id "q-49453/selection/a47c711bb0adbb09de806e38ecb67622842aa5f2be8fedcd0f16197e4e63c812" :answer/id #uuid "11744255-bc19-58e5-93e2-2a2962b8834f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/ensure [:answer/validate]} {:db/id "q-49453/selection/77f637f64ef93c89b03d2b16338b13737437d610433086bf85486581673652c3" :answer/id #uuid "c1fc3292-6b00-50a5-bf24-55cbcdc9f7ac" :answer/type :answer.type/math :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/ensure [:answer/validate]} {:db/id "q-49453/selection/5ae3b02309ea8507deea480efa2a3e75f0b37040051ebfc2376bf4fad8893189" :answer/id #uuid "d3041811-5377-54cf-aa35-401f351b822a" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/ensure [:answer/validate]} {:db/id "q-49453/selection/2aff177baa9eb47dbef6b6e64f0a3a790e0a0036f00f44bd485c9d9ec29c4e8f" :answer/id #uuid "20712bd1-ce82-5fa3-a8f5-064418caddcc" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/ensure [:answer/validate]} {:db/id "q-49453/selection" :answer-field/id #uuid "bb910921-13f2-5e87-846b-9ed409c10565" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49453/selection/5ae3b02309ea8507deea480efa2a3e75f0b37040051ebfc2376bf4fad8893189" :answer-field/choices ["q-49453/selection/5cd94a1ab4162db8d3ac1067f684eb87818efc5d4ba8266e804d36fe30f49b3b" "q-49453/selection/a47c711bb0adbb09de806e38ecb67622842aa5f2be8fedcd0f16197e4e63c812" "q-49453/selection/77f637f64ef93c89b03d2b16338b13737437d610433086bf85486581673652c3" "q-49453/selection/5ae3b02309ea8507deea480efa2a3e75f0b37040051ebfc2376bf4fad8893189" "q-49453/selection/2aff177baa9eb47dbef6b6e64f0a3a790e0a0036f00f44bd485c9d9ec29c4e8f"] :db/ensure [:answer-field/validate]} {:db/id "q-49453" :question/id #uuid "d8e15d67-0bf8-5826-ab6f-21142ae7304c" :question/math-academy-id "q-49453" :question/problem "Calculate $\\int \\frac{3}{x+4}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x+4}\\,\\text{d}x & =3\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡|x+4|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49453/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049"] :knowledge-point/questions ["q-49453"] :db/ensure [:knowledge-point/validate]} {:db/