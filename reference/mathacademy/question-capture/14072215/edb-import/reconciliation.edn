n}⁡2x \\\\  & =x\\operatorname{sin}⁡2x\\cdot (-8\\operatorname{cos}⁡2x)+3\\operatorname{sin}⁡2x \\\\  & =\\operatorname{sin}⁡2x(3-8x\\operatorname{cos}⁡2x)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072215/state.json" "file_sha256" "fe7396a35486c8db5583b39d1bee3cf7377ecd3e0331949a4bfe951fb5c016f7"} {"question" "q-338254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072215/activity-metadata.json" "file_sha256" "0848faaf54cde4afb10b4dd127b1b307ee9977bf2e5fceb231dff9d47dae5545"} {"question" "q-338254" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072215/state.json" "file_sha256" "fe7396a35486c8db5583b39d1bee3cf7377ecd3e0331949a4bfe951fb5c016f7"} {"question" "q-338254" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3\\operatorname{sin}⁡2x"] ["math" "\\operatorname{sin}⁡2x(3+8x\\operatorname{cos}⁡2x)"] ["math" "\\operatorname{sin}⁡2x(3-8x\\operatorname{cos}⁡2x)"] ["math" "\\operatorname{sin}⁡2x(6-8x\\operatorname{cos}⁡2x)"] ["math" "\\operatorname{sin}⁡2x(8x\\operatorname{cos}⁡2x-3)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072215/state.json" "file_sha256" "fe7396a35486c8db5583b39d1bee3cf7377ecd3e0331949a4bfe951fb5c016f7"} {"question" "q-338254" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{sin}⁡2x(3-8x\\operatorname{cos}⁡2x)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072215/state.json" "file_sha256" "fe7396a35486c8db5583b39d1bee3cf7377ecd3e0331949a4bfe951fb5c016f7"} 