\\\\  & =2\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}({e}^{-x}+2)-3\\frac{\\text{d}}{\\text{d}x}({e}^{-x}+2) \\\\  & =2\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(-{e}^{-x})-3\\cdot (-{e}^{-x}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{-x})+3{e}^{-x} \\\\  & =-2{e}^{-x}+3{e}^{-x} \\\\  & ={e}^{-x}\\end{aligned}\n$$" 13194139535938 true] [17592186375315 1000 #edb/ref 17592186375316 13194139535938 true] [17592186375315 1000 #edb/ref 17592186375317 13194139535938 true] [17592186375315 1000 #edb/ref 17592186375318 13194139535938 true] [17592186375315 1000 #edb/ref 17592186375319 13194139535938 true] [17592186375315 1000 #edb/ref 17592186375320 13194139535938 true] [17592186375315 1040 #edb/ref 17592186045450 13194139535938 true] [17592186375315 1041 "selection" 13194139535938 true] [17592186375315 1104 #edb/ref 17592186375320 13194139535938 true] [17592186375315 1110 #uuid "b022f572-42ec-551a-a14e-c7a590c3bd77" 13194139535938 true] [17592186375316 1034 "-5{e}^{-x}" 13194139535938 true] [17592186375316 1103 #edb/ref 17592186045453 13194139535938 true] [17592186375316 1111 #uuid "51cb1566-700c-52dc-90b8-9dcdf0b15afe" 13194139535938 true] [17592186375317 1034 "2" 13194139535938 true] [17592186375317 1103 #edb/ref 17592186045453 13194139535938 true] [17592186375317 1111 #uuid "88902212-2250-544c-915e-ca37c1e5bb31" 13194139535938 true] [17592186375318 1034 "5{e}^{-x}" 13194139535938 true] [17592186375318 1103 #edb/ref 17592186045453 13194139535938 true] [17592186375318 1111 #uuid "1570845c-a664-5c62-b105-7c6703d36d43" 13194139535938 true] [17592186375319 1034 "-3{e}^{-x}" 13194139535938 true] [17592186375319 1103 #edb/ref 17592186045453 13194139535938 true] [17592186375319 1111 #uuid "c2ff9f13-8a36-5f56-9f83-aba9af9b158a" 13194139535938 true] [17592186375320 1034 "{e}^{-x}" 13194139535938 true] [17592186375320 1103 #edb/ref 17592186045453 13194139535938 true] [17592186375320 1111 #uuid "775fc221-4df7-5a71-b639-95e2da31b4dc" 13194139535938 true] [17592186375321 1017 #edb/ref 1