gned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337831/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec3823db-6df8-502a-a050-b5aa169d2e9d"] :knowledge-point/questions ["q-337831"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130245/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "88902212-2250-544c-915e-ca37c1e5bb31" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-130245/selection/c975509865ebe917a276e7d586e7e6792b21fdfdb264ac448a7ca14faf6d2041" :answer/id #uuid "775fc221-4df7-5a71-b639-95e2da31b4dc" :answer/type :answer.type/math :answer/value "{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-130245/selection/18a248da7d4f46c6024f3beca37cc9d45193b1f6621334328f064572ce66bdcd" :answer/id #uuid "51cb1566-700c-52dc-90b8-9dcdf0b15afe" :answer/type :answer.type/math :answer/value "-5{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-130245/selection/abd2dacb73d824a863255020c6c2c85fc701d1879708f1303182e2280d8056d1" :answer/id #uuid "1570845c-a664-5c62-b105-7c6703d36d43" :answer/type :answer.type/math :answer/value "5{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-130245/selection/afcfac15090447423308dda5073bce32608923f6a0b6abc409dcb32f03c3b2d0" :answer/id #uuid "c2ff9f13-8a36-5f56-9f83-aba9af9b158a" :answer/type :answer.type/math :answer/value "-3{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-130245/selection" :answer-field/id #uuid "b022f572-42ec-551a-a14e-c7a590c3bd77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130245/selection/c975509865ebe917a276e7d586e7e6792b21fdfdb264ac448a7ca14faf6d2041" :answer-field/choices ["q-130245/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-130245/selection/c975509865ebe917a276e7d586e7e6792b21fdfdb264ac448a7ca14faf6d2041" "q-130245/selection/18a248da7d4f46c6024f3beca37cc9d45193b1f6621334328f064572ce66bdcd" "q-130245/selection/abd2dacb73d824a863255020c6c2c85fc701d1879708f1303182e2280d8056d1" "q-130245/selection/afcfac15090447423308dda5073bce32608923f6a0b6abc409dcb32f03c3b2d0"] :db/ensure [:answer-field/validate]} {:db/id "q-130245" :question/id #uuid "b28ba552-0720-523c-a07f-ee0dc4920daa" :question/math-academy-id "q-130245" :question/problem "Given that $D=2\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}-3\\frac{\\text{d}}{\\text{d}x},$ what is $D(y)$ for $y={e}^{-x}+2?$" :question/worked-solution "The given operator is a third-order differential operator of the form\n\n$$\nD(y)={a}_{3}\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{a}_{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{a}_{1}\\frac{\\text{d}y}{\\text{d}x}+{a}_{0}y\n$$\n\nwith constant coefficients  ${a}_{3}=2,{a}_{2}=0,{a}_{1}=-3,$ and ${a}_{0}=0.$ \n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y:$\n\n$$\n\\begin{aligned}D(y) & =D({e}^{-x}+2) \\\\  & =(2\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}-3\\frac{\\text{d}}{\\text{d}x})({e}^{-x}+2) \\\\  & =2\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}({e}^{-x}+2)-3\\frac{\\text{d}}{\\text{d}x}({e}^{-x}+2) \\\\  & =2\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(-{e}^{-x})-3\\cdot (-{e}^{-x}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{-x})+3{e}^{-x} \\\\  & =-2{e}^{-x}+3{e}^{-x} \\\\  & ={e}^{-x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130245/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec3823db-6df8-502a-a050-b5aa169d2e9d"] :knowledge-point/questions ["q-130245"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337843/selection/3d018a301d339e70777845847ab296a6db8c0114361d2b4f73f0d44294d60c7f" :answer/id #uuid "10962b55-a22f-5722-a86e-b12a18067958" :answer/type :answer.type/math :answer/value "\\frac{2}{{x}^{2}}+\\frac{5}{x}" :db/ensure [:answer/validate]} {:db/id "q-337843/selection/727d9d617811aeaa7a007ee25f7f4348f1639efbbdb82a310ee88e2bd4b84c10" :answer/id #uuid "50f3008b-81ea-5fa2-9660-7c95f2cffa54" :answer/type :answer.type/math :answer/value "\\frac{2}{{x}^{2}}-\\frac{5}{x}" :db/ensure [:answer/validate]} {:db/id "q-337843/selection/9256344f3ebdd2842b96d52c6d5d18069154973de1f469726811ac51ee053b45" :answer/id #uuid "d64bd750-7126-5a11-870b-adf87d8d8488" :answer/type :answer.type/math :answer/value "-\\frac{5}{x}" :db/ensure [:answer/validate]} {:db/id "q-337843/selection/0e9ad8896b7f5791967b8c2923c7b926b47613f8015540fc686f693cad5339b4" :answer/id #uuid "1c3c11fd-07c1-5251-a07e-1be4bb3ce249" :answer/type :answer.type/math :answer/value "\\frac{2}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-337843/selection/d45ffff2abd11ea76e8ee0e79337856dafbb0ac50eb3612d4263a3f146245f64" :answer/id #uuid "d3dbb1bd-6a1f-5b5f-b9fc-400e54c3228c" :answer/type :answer.type/math :answer/value "-\\frac{2}{{x}^{2}}-\\frac{5}{x}" :db/ensure [:answer/validate]} {:db/id "q-337843/selection" :answer-field/id #uuid "c78f2d8b-5cbc-51a4-b2ef-c819e6b55f47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-337843/selection/727d9d617811aeaa7a007ee25f7f4348f1639efbbdb82a310ee88e2bd4b84c10" :answer-field/choices ["q-337843/selection/3d018a301d339e70777845847ab296a6db8c0114361d2b4f73f0d44294d60c7f" "q-337843/selection/727d9d617811aeaa7a007ee25f7f4348f1639efbbdb82a310ee88e2bd4b84c10" "q-337843/selection/9256344f3ebdd2842b96d52c6d5d18069154973de1f469726811ac51ee053b45" "q-337843/selection/0e9ad8896b7f5791967b8c2923c7b926b47613f8015540fc686f693cad5339b4" "q-337843/selection/d45ffff2abd11ea76e8ee0e79337856dafbb0ac50eb3612d4263a3f146245f64"] :db/ensure [:answer-field/validate]} {:db/id "q-337843" :question/id #uuid "4e179d6c-08e2-5aee-afa9-4910eabac925" :question/math-academy-id "q-337843" :question/problem "Given that $D=x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+2x\\frac{\\text{d}}{\\text{d}x}-3,$ what is $D(y)$ for $y=\\frac{1}{x}?$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}=x,{f}_{1}=2x,$ and ${f}_{0}=-3.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y$:\n\n$$\n\\begin{aligned}D(y) & =D(\\frac{1}{x}) \\\\  & =(x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+2x\\frac{\\text{d}}{\\text{d}x}-3)\\frac{1}{x} \\\\  & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\frac{1}{x})+2x\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})-3\\cdot \\frac{1}{x} \\\\  & =x\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})+2x(-\\frac{1}{{x}^{2}})-\\frac{3}{x} \\\\  & =x\\cdot \\frac{2}{{x}^{3}}-\\frac{2}{x}-\\frac{3}{x} \\\\  & =\\frac{2}{{x}^{2}}-\\frac{5}{x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337843/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ff7f935-dcec-5b4c-ba1d-e0b4c9e197a4"] :knowledge-point/questions ["q-337843"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-65037"] :question/problem "Given that $D=x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+2\\frac{\\text{d}}{\\text{d}x},$ what is $D(y)$ for $y=\\operatorname{ln}⁡x?$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}=x,{f}_{1}=2,$ and ${f}_{0}=0.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y$:\n\n$$\n\\begin{aligned}D(y) & =D(\\operatorname{ln}⁡x) \\\\  & =(x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+2\\frac{\\text{d}}{\\text{d}x})\\operatorname{ln}⁡x \\\\  & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\operatorname{ln}⁡x)+2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x) \\\\  & =x\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})+\\frac{2}{x} \\\\  & =x\\cdot (-\\frac{1}{{x}^{2}})+\\frac{2}{x} \\\\  & =-\\frac{1}{x}+\\frac{2}{x} \\\\  & =\\frac{1}{x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-130082/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "8ab6474e-210d-553d-86c3-ae6ef1de9062" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-130082/selection/d9571e89d0504e1e2cf2b622aa85e4b9404697061234af459495e2b40a0c2074" :answer/id #uuid "ce8c0141-11a9-5c36-8ad5-c4912b447626" :answer/type :answer.type/math :answer/value "4x-2" :db/ensure [:answer/validate]} {:db/id "q-130082/selection/eb941993c12de92cf2de354bb5e8224ce83fb9350fc9526828b4473e449796f5" :answer/id #uuid "f435919c-886a-5ebf-9a0f-ce1e9c538e55" :answer/type :answer.type/math :answer/value "x+2" :db/ensure [:answer/validate]} {:db/id "q-130082/selection/b00357bbc456f0924a74351e97751af3be7691ec837e17f1b683e5a99f44bd60" :answer/id #uuid "c7cf81f4-8be0-5733-93bd-f0ee2352a580" :answer/type :answer.type/math :answer/value "x+4" :db/ensure [:answer/validate]} {:db/id "q-130082/selection/61dd582464f025653293ef4e0f5b4d4bb22c6f166cdde2aeded7b1ba7a8c38f9" :answer/id #uuid "2952d5cd-c942-5002-9d74-31df17954f4b" :answer/type :answer.type/math :answer/value "4x" :db/ensure [:answer/validate]} {:db/id "q-130082/selection" :answer-field/id #uuid "5838ff18-dac6-5a7e-ae4c-a12d2862eec6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130082/selection/d9571e89d0504e1e2cf2b622aa85e4b9404697061234af459495e2b40a0c2074" :answer-field/choices ["q-130082/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-130082/selection/d9571e89d0504e1e2cf2b622aa85e4b9404697061234af459495e2b40a0c2074" "q-130082/selection/eb941993c12de92cf2de354bb5e8224ce83fb9350fc9526828b4473e449796f5" "q-130082/selection/b00357bbc456f0924a74351e97751af3be7691ec837e17f1b683e5a99f44bd60" "q-130082/selection/61dd582464f025653293ef4e0f5b4d4bb22c6f166cdde2aeded7b1ba7a8c38f9"] :db/ensure [:answer-field/validate]} {:db/id "q-130082" :question/id #uuid "8616e65f-08e1-5256-9739-a39cfbef8685" :question/math-academy-id "q-130082" :question/problem "Given that $D=x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+\\frac{\\text{d}}{\\text{d}x},$ what is $D(y)$ for $y={x}^{2}-2x?$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}=x,{f}_{1}=1,$ and ${f}_{0}=0.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y$:\n\n$$\n\\begin{aligned}D(y) & =D({x}^{2}-2x) \\\\  & =(x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+\\frac{\\text{d}}{\\text{d}x})({x}^{2}-2x) \\\\  & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}({x}^{2}-2x)+\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2x) \\\\  & =x\\frac{\\text{d}}{\\text{d}x}(2x-2)+(2x-2) \\\\  & =2x+2x-2 \\\\  & =4x-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130082/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ff7f935-dcec-5b4c-ba1d-e0b4c9e197a4"] :knowledge-point/questions ["q-130082"] :db/ensure [:knowledge-point/validate]} {:db/id "q-91045/selection/a15cea945abed243b200a84e72912bb5371f070ca5bbdcae3b25778ed2083592" :answer/id #uuid "04e9bfc1-bc8c-5f52-8cf4-f98b0461fd59" :answer/type :answer.type/math :answer/value "48{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-91045/selection/8e646e4064adeb2f71fee52b566228dc1ca8f10f9e848148ebd7b0b72c49b796" :answer/id #uuid "f4d080cc-bf02-561f-9de6-ab2cdd8bc2b5" :answer/type :answer.type/math :answer/value "4{x}^{4}+16{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-91045/selection/7382f8d9e70f4cc1b08d0e713ee6de30322c3971be9fd16d74c1b3806c97eea8" :answer/id #uuid "45261384