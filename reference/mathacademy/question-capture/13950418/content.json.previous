              "type": "math",
              "value": "\\frac{({x}^{2}-1)^{5}}{10}+C"
            },
            {
              "type": "math",
              "value": "\\frac{({x}^{2}-1)^{3}}{6}+C"
            }
          ],
          "correct_value": "\\frac{({x}^{2}-1)^{4}}{8}+C"
        }
