 follows:\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\cdot x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡({x}^{2}+1)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8"] :knowledge-point/questions ["q-49451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113720/selection/4c5b6bbee65e8ad43257651f4ebf5449c5131f97211811dde4cea939a73ef294" :answer/id #uuid "998d5f85-f282-553c-a200-6d8bfa5d6a03" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|{x}^{5}-x|+C" :db/ensure [:answer/validate]} {:db/id "q-113720/selection/049f674181420331f7e833e3de76e60b1cd5fcbede9c21af832cdf9c390cd097" :answer/id #uuid "6a4a3527-1d72-5fdb-a089-532fdbe5f208" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{5{x}^{4}-1}{{x}^{5}-x}|+C" :db/ensure [:answer/validate]} {:db/id "q-113720/selection/6595a68c53bab09b3981255e73128bba9c63c0db125ad4e56aab3df3b134e63d" :answer/id #uuid "b32f9438-22b3-5339-88b6-18cb9d83c5c2" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{5}-x}{5{x}^{4}-1}|+C" :db/ensure [:answer/validate]} {:db/id "q-113720/selection/21d3ba9755d175eac74baec64a0d9fd5456ab4e9d0817e50816f6d028f7c0e04" :answer/id #uuid "ccdc77e5-27ce-593d-a63b-7e6fc23fdbc7" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{5}-x|}{5{x}^{4}-1}+C" :db/ensure [:answer/validate]} {:db/id "q-113720/selection/bbc737163e5ac90537b28d10f3300e93dabbe918e036400fe55f958ad36e0063" :answer/id #uuid "20135f12-15e9-586a-8225-14aa067ac4d8" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|5{x}^{4}-1|+C" :db/ensure [:answer/validate]} {:db/id "q-113720/selection"