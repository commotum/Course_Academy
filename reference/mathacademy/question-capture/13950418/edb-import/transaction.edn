10}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{{u}^{10}}\\,\\text{d}u \\\\  & =\\frac{1}{2}(-\\frac{1}{9{u}^{9}})+C \\\\  & =-\\frac{1}{18{u}^{9}}+C \\\\  & =-\\frac{1}{18({x}^{2}+5)^{9}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-12502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49561/selection/c501f2fca2c87cd70f2e21b8ab1c9ffad28749308d6c60bb840c3b78344feff4" :answer/id #uuid "a0496da4-d645-5a6e-a387-bbb9d3b36352" :answer/type :answer.type/math :answer/value "\\frac{1}{4{(1-{y}^{4})}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-49561/selection/98320493e0b58a7520ce86a43421515ea7c9da99a446765671d24e8847cfc873" :answer/id #uuid "a814a59c-e9fb-5a0f-a5cc-200cbb3e1bac" :answer/type :answer.type/math :answer/value "\\frac{1}{2{(1-{y}^{4})}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-49561/selection/40cd5c425e9b100c126f1c285a5eeeabd03eb973f3f22c84124b3706deb9bf8c" :answer/id #uuid "c78ff37c-aef3-5777-afa8-53dafa9a462e" :answer/type :answer.type/math :answer/value "\\frac{1}{{(1-{y}^{4})}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-49561/selection/e533877c921a78f4193cd53aa6c8413d572a5056b6ccaf2feee3c920d9354094" :answer/id #uuid "7c0888f0-cff3-5c5b-8b49-7986993b0f6c" :answer/type :answer.type/math :answer/value "{(1-{y}^{4})}^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-49561/selection/9c51fd3636051835d57ea323961f4877507689c93e6af5241e21b46ce4be17f9" :answer/id #uuid "0b9bdd40-a299-52dd-8b07-46c2c564cb06" :answer/type :answer.type/math :answer/value "\\frac{1}{{(1-{y}^{4})}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-49561/selection" :answer-field/id #uuid "1615c92b-d49b-5b8a-afc2-d6c55636a2cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49561/selection/c501f2fca2c87cd70f2e21b8ab1c9ffad28749308d6c60bb840c3b78344feff4" :answer-field/choices ["q-49561/selection/c501f2fca2c87cd70f2e21b8ab1c9ffad28749308d6c60bb840c3b78344feff4" "q-49561/selection/98320493e0b58a7520ce86a43421515ea7c9da99a446765671d24e8847cfc873" "q-49561/selection/40cd5c425e9b100c126f1c285a5eeeabd03eb973f3f22c84124b3706deb9bf8c" "q-49561/selection/e533877c921a78f4193cd53aa6c8413d572a5056b6ccaf2feee3c920d9354094" "q-49561/selection/9c51fd3636051835d57ea323961f4877507689c93e6af5241e21b46ce4be17f9"] :db/ensure [:answer-field/validate]} {:db/id "q-49561" :question/id #uuid "86e72cd0-ebd6-5db7-8190-d10775b72433" :question/math-academy-id "q-49561" :question/problem "Calculate $\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y.$" :question/worked-solution "Let $u=1-{y}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=-4{y}^{3}\\,⟹\\,(-\\frac{1}{4})\\text{d}u={y}^{3}\\,\\text{d}y,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(1-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(1-{y}^{4})}^{4}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49561/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-49561"] :db/ensure [:knowledge-point/validate]}]
