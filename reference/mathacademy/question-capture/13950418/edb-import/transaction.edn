)^{5}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-113726"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49560/selection/9b7d1557b625896c3f6b735cb24dc29f7bd8b69719fd2fc1d89fadba0bffc487" :answer/id #uuid "77188cee-e3b5-5f5b-b1c9-f54dc9cff659" :answer/type :answer.type/math :answer/value "\\sqrt{{s}^{4}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49560/selection/230bc6dc0fa3b65c0329fff087f78f85b9f01b4aeb8d99ae0f31c7f2d785e7ab" :answer/id #uuid "b523a0b8-86e1-51da-9fa2-6970bc432d71" :answer/type :answer.type/math :answer/value "4\\sqrt{{s}^{5}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49560/selection/8dce1e3f459a056c3ce92bae0e4262fd51df610712a231a3153d11e95a35df80" :answer/id #uuid "71f35d7b-b832-5e72-93fb-ecbe6b49192e" :answer/type :answer.type/math :answer/value "2\\sqrt{{s}^{4}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49560/selection/67574dea2a2e61b9664087df3b4d42dd164464dee1da54fe51655e047b3b5f1f" :answer/id #uuid "750d4206-03ee-5401-a79f-a044a3b50dbe" :answer/type :answer.type/math :answer/value "5\\sqrt{{s}^{5}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49560/selection/3bef05e4460b5a557583a3453f1d95304ead20777d5963fd6335d68077f16d71" :answer/id #uuid "1819c394-7905-5d47-99c9-7fc6ef63b133" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\sqrt{{s}^{5}+1}+C" :db/ensure [:answer/validate]} {:db/id "q-49560/selection" :answer-field/id #uuid "73179b5d-3579-5b12-bbc5-2671bf6fd332" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49560/selection/230bc6dc0fa3b65c0329fff087f78f85b9f01b4aeb8d99ae0f31c7f2d785e7ab" :answer-field/choices ["q-49560/selection/9b7d1557b625896c3f6b735cb24dc29f7bd8b69719fd2fc1d89fadba0bffc487" "q-49560/selection/230bc6dc0fa3b65c0329fff087f78f85b9f01b4aeb8d99ae0f31c7f2d785e7ab" "q-49560/selection/8dce1e3f459a056c3ce92bae0e4262fd51df610712a231a3153d11e95a35df80" "q-49560/selection/67574dea2a2e61b9664087df3b4d42dd164464dee1da54fe51655e047b3b5f1f" "q-49560/selection/3bef05e4460b5a557583a3453f1d95304ead20777d5963fd6335d68077f16d71"] :db/ensure [:answer-field/validate]} {:db/id "q-49560" :question/id #uuid "93ddd703-9a56-506d-ae6d-354420a2f0dc" :question/math-academy-id "q-49560" :question/problem "Calculate $\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s.$" :question/worked-solution "Let $u={s}^{5}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}s}=5{s}^{4}\\,⟹\\,\\frac{1}{5}\\text{d}u={s}^{4}\\,\\text{d}s,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s & =10\\int \\frac{1}{\\sqrt{{s}^{5}+1}}\\cdot {s}^{4}\\,\\text{d}s \\\\  & =10\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{10}{5}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\cdot (2\\sqrt{u})+C \\\\  & =4\\sqrt{u}+C \\\\  & =4\\sqrt{{s}^{5}+1}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49560/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd"] :knowledge-point/questions ["q-49560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12502/selection/46a4479d807a141a30df31067d11b1f461e54e7d98c9faa4195d2402071a993f" :answer/id #uuid "63a2ab67-bdf0-57a9-aadf-e0154d71ca00" :answer/type :answer.type/math :answer/value "-\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/ensure [:answer/validate]} {:db/id "q-12502/selection/d62216a71938d04831d79db6c77df1b6dd1444e95840a253a649ecfec07a6d75" :answer/id #uuid "7ec85394-246d-5e4b-b15e-aea0de43c21e" :answer/type :answer.type/math :answer/value "\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/ensure [:answer/validate]} {:db/id "q-12502/selection/2cadfe1b40d438bcbb73b9cb9555a98597555709345d8a15f8fd17453a37ffc