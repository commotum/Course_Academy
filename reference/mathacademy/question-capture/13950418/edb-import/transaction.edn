{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72605/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8"] :knowledge-point/questions ["q-72605"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12501/selection/3c482754bd81ba97e8c5cbe5985b7368f2866e016bc9dcc102139c4b37a008c8" :answer/id #uuid "8ccc4d6a-3d3d-504f-8286-5e348d57768e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|{x}^{3}+10|+C" :db/ensure [:answer/validate]} {:db/id "q-12501/selection/a30f132a41c76af382a401eede4d6951214511ed15c6b096b8bbe5939d4653a7" :answer/id #uuid "95a1f104-5c7a-5e99-9483-61937af1eb88" :answer/type :answer.type/math :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{3}+10|+C" :db/ensure [:answer/validate]} {:db/id "q-12501/selection/dab27f9997d5b1994f60ce6c492214493a8bc54895bbf46f7da6d30082c54103" :answer/id #uuid "4361b0d4-3f7d-5f6a-a035-98670cd9c102" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|{x}^{3}+10|+C" :db/ensure [:answer/validate]} {:db/id "q-12501/selection/06b5fec16fe734ed46e819b8405802db605db62e8a2cbfae3342306e160c57f6" :answer/id #uuid "63167b53-3612-5995-b208-03463b8bf29d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|{x}^{3}+10|+C" :db/ensure [:answer/validate]} {:db/id "q-12501/selection/0b31a07d168