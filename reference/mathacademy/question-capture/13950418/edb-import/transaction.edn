[{:db/id "q-2390/selection/00c4ba8bdaaa9e474da26f1a1f7690dc064345bb85f41af6b6417126a4debacc" :answer/id #uuid "280e0e5e-0e49-5ea2-b984-f7928b867fda" :answer/type :answer.type/math :answer/value "-\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-2390/selection/b81118e0e86e9e0d11b25ac12663b514573ce422d2f0a05c4b959b19c43b109e" :answer/id #uuid "eda11acd-0019-5a21-989b-8fdf3e45b037" :answer/type :answer.type/math :answer/value "3(5{x}^{2}-4)^{2/3}+C" :db/ensure [:answer/validate]} {:db/id "q-2390/selection/520bcd8e29db1032d57948c6af308ab83afc99e80c45c5ebafd900f050ebe3f0" :answer/id #uuid "a4982a02-d6b6-59b0-9b6b-f3fcdc158918" :answer/type :answer.type/math :answer/value "-\\frac{3(5{x}^{2}-4)^{3/2}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-2390/selection/782e8bdab0ee2252a2fe31856ea5176804de8a5bbbb3bcc350c41a26f76af089" :answer/id #uuid "207a978f-d4e6-5dfb-9c36-9b1120e969a1" :answer/type :answer.type/math :answer/value "\\frac{3(5{x}^{2}-4)^{2/3}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-2390/selection/2b8ac4eea5a5e0836ed6edb23c84ea7664506e8a9dfa4794150a80e246630061" :answer/id #uuid "611be68e-9abf-5206-bcaa-377d8324a3f5" :answer/type :answer.type/math :answer/value "\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-2390/selection" :answer-field/id #uuid "b873f10d-13ab-587a-ad58-0f88b18d76c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2390/selection/2b8ac4eea5a5e0836ed6edb23c84ea7664506e8a9dfa4794150a80e246630061" :answer-field/choices ["q-2390/selection/00c4ba8bdaaa9e474da26f1a1f7690dc064345bb85f41af6b6417126a4debacc" "q-2390/selection/b81118e0e86e9e0d11b25ac12663b514573ce422d2f0a05c4b959b19c43b109e" "q-2390/selection/520bcd8e29db1032d57948c6af308ab83afc99e80c45c5ebafd900f050ebe3f0" "q-2390/selection/782e8bdab0ee2252a2fe31856ea5176804de8a5bbbb3bcc350c41a26f76af089" "q-2390/selection/2b8ac4eea5a5e0836ed6edb23c84ea7664506e8a9dfa4794150a80e246630061"] :db/ensure [:answer-field/validate]} {:db/id "q-2390" :question/id #uuid "9ba1168b-5db7-54a6-97ae-e4395967e964" :question/math-academy-id "q-2390" :question/problem "Calculate $\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x.$" :question/worked-solution "We note that $10x$ is the derivative of the quantity in the square root. So we make a substitution\n\n$$\nu=5{x}^{2}-4.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =10x\\,⟹\\,\\text{d}u=10x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x & =\\int \\sqrt{5{x}^{2}-4}\\,10x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{u}^{3/2}}{3}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=5{x}^{2}-4$ back in the expression. So the final result is\n\n$$\n\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x=\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2390/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035"] :knowledge-point/questions ["q-2390"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72382/selection/67fbf1d32da5f3fbe7cd8c67c88887906f61802724beec916441754051d9b911" :answer/id #uuid "68cf00ed-3464-5aeb-824b-7b913b822ffc" :answer/type :answer.type/math :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-72382/selection/b79b6b0e39de9f1d8af5a156f74b52c7548d0992fa16884c15d0ec4b9be632f6" :answer/id #uuid "abbf30c0-dcb1-5dff-ba80-afcb9ee6885e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-72382/selection/50b4ae27958c1ca122315a275d3a0483b52b16ec96ad6fbaa6e39a607cbb26e9" :answer/id #uuid "6661a59f-94ed-52bf-887a-89a0a49d43ef" :answer/type :answer.type/math :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-72382/selection/eaf156ba747e90d65a4fb55b14fdee1420c910599ef3ba22b917ee702333775f" :answer/id #uuid "0a947d2a-ea68-59ca-834d-c63035e89758" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-72382/selection/afb133a09133d1caa85c541c0de4cd6d10d7ab70927dd9c6eb75d8bd91e6acda" :answer/id #uuid "b09749f0-c48a-50a6-b88f-100179685cba" :answer/type :answer.type/math :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72382/selection" :answer-field/id #uuid "cae0e4fa-dc80-5a73-a061-ea5fa25d8511" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72382/selection/50b4ae27958c1ca122315a275d3a0483b52b16ec96ad6fbaa6e39a607cbb26e9" :answer-field/choices ["q-72382/selection/67fbf1d32da5f3fbe7cd8c67c88887906f61802724beec916441754051d9b911" "q-72382/selection/b79b6b0e39de9f1d8af5a156f74b52c7548d0992fa16884c15d0ec4b9be632f6" "q-72382/selection/50b4ae27958c1ca122315a275d3a0483b52b16ec96ad6fbaa6e39a607cbb26e9" "q-72382/selection/eaf156ba747e90d65a4fb55b14fdee1420c910599ef3ba22b917ee702333775f" "q-72382/selection/afb133a09133d1caa85c541c0de4cd6d10d7ab70927dd9c6eb75d8bd91e6acda"] :db/ensure [:answer-field/validate]} {:db/id "q-72382" :question/id #uuid "75e393fd-4391-50dc-8f83-4d49f1b94388" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72382/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035"] :knowledge-point/questions ["q-72382"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-2189"] :question/worked-solution "We note that $3{x}^{2}$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{3}+4.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2}\\,⟹\\,\\text{d}u=3{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}({x}^{3}+4)^{5}\\,\\text{d}x & =\\int ({x}^{3}+4)^{5}\\,3{x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{5}\\,\\text{d}u=\\frac{{u}^{6}}{6}+C\n$$\n\nLastly, we substitute $u={x}^{3}+4$ back in the expression. So the final result is\n\n$$\n\\int 3{x}^{2}({x}^{3}+4)^{5}\\,\\text{d}x=\\frac{({x}^{3}+4)^{6}}{6}+C.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-2195/selection/f63b5e4a136288f9552e853c95c2a6b7e19cfcea83a8576342210213dcb20e6f" :answer/id #uuid "44c787ab-fb5b-58e9-9fb5-b4635a4d9d69" :answer/type :answer.type/math :answer/value "-\\frac{2x({x}^{2}+1)^{12}}{12}+C" :db/ensure [:answer/validate]} {:db/id "q-2195/selection/afacf45db632142e7584d802cae52064dd2af6feabf6571961cfd1800cab6ba3" :answer/id #uuid "c381ea81-5ae6-5edd-ace4-037c3279c389" :answer/type :answer.type/math :answer/value "-\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/ensure [:answer/validate]} {:db/id 17592186066078 :answer-field/choices ["q-2195/selection/f63b5e4a136288f9552e853c95c2a6b7e19cfcea83a8576342210213dcb20e6f" "q-2195/selection/afacf45db632142e7584d802cae52064dd2af6feabf6571961cfd1800cab6ba3"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-2195"] :question/worked-solution "We note that $2x$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{2}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x & =\\int ({x}^{2}+1)^{12}\\,2x\\,\\text{d}x \\\\  & =\\int {u}^{12}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{12}\\,\\text{d}u=\\frac{{u}^{13}}{13}+C\n$$\n\nLastly, we substitute $u={x}^{2}+1$ back in the expression. So the final result is\n\n$$\n\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=\\frac{({x}^{2}+1)^{13}}{13}+C.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-113581/selection/827a3da3a4c8cfbb1828ba5ce0dec02868a7e24065699769c02adc12fcf04c10" :answer/id #uuid "608cfc35-08e9-5f50-9fb8-84b52bb7b43b" :answer/type :answer.type/math :answer/value "\\frac{2(2{x}^{6}-3)^{3/2}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113581/selection/ac13bd7162b17e11dcb185a3cefee1418e8c752e9a547796b8e86aff0c542cf6" :answer/id #uuid "036c8bb9-5992-5e57-9db7-5ca37ccf0e06" :answer/type :answer.type/math :answer/value "-\\frac{1}{2\\sqrt{2{x}^{6}-3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113581/selection/50adfb5b565b916910a2519c47b64e6dd92a93c7b38e658e765d622f3427a9b1" :answer/id #uuid "900cc2c2-bbf4-54e3-bfc2-2fc1d6cbbd2b" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\sqrt{2{x}^{6}-3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113581/selection/121a17a7d74bf93bb08f10b912f871fb4615eeae1c8f9eb4dfaf6234a612bb4c" :answer/id #uuid "fd7c2fd9-ea0f-5a8f-9fb5-e122e38ff68f" :answer/type :answer.type/math :answer/value "\\frac{3(2{x}^{6}-3)^{3/2}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113581/selection/6336be1a787e0a5b8ec40bdd48d0f7620858118516b2bbaae6f01eb5eacb3711" :answer/id #uuid "f767c3da-f088-5bc0-a73e-1f12c4c79085" :answer/type :answer.type/math :answer/value "\\frac{(2{x}^{6}-3)^{3/2}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113581/selection" :answer-field/id #uuid "a7c19526-15af-5871-a26d-ee6b7ca831e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113581/selection/827a3da3a4c8cfbb1828ba5ce0dec02868a7e24065699769c02adc12fcf04c10" :answer-field/choices ["q-113581/selection/827a3da3a4c8cfbb1828ba5ce0dec02868a7e24065699769c02adc12fcf04c10" "q-113581/selection/ac13bd7162b17e11dcb185a3cefee1418e8c752e9a547796b8e86aff0c542cf6" "q-113581/selection/50adfb5b565b916910a2519c47b64e6dd92a93c7b38e658e765d622f3427a9b1" "q-113581/selection/121a17a7d74bf93bb08f10b912f871fb4615eeae1c8f9eb4dfaf6234a612bb4c" "q-113581/selection/6336be1a787e0a5b8ec40bdd48d0f7620858118516b2bbaae6f01eb5eacb3711"] :db/ensure [:answer-field/validate]} {:db/id "q-113581" :question/id #uuid "1c6c7d03-b111-5ba6-842b-e6a7699ac04f" :question/math-academy-id "q-113581" :question/problem "Calculate $\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x.$" :question/worked-solution "We note that $12{x}^{5}$ is the derivative of the quantity in the square root. So we make a substitution\n\n$$\nu=2{x}^{6}-3.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =12{x}^{5}\\,⟹\\,\\text{d}u=12{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x & =\\int \\sqrt{2{x}^{6}-3}\\cdot 12{x}^{5}\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{u}^{3/2}}{3}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=2{x}^{6}-3$ back in the expression. So the final result is\n\n$$\n\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x=\\frac{2(2{x}^{6}-3)^{3/2}}{3}+C.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113581/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035"] :knowledge-point/questions ["q-113581"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2388/selection/a993a937dcb5b8f49780f1b4b97479308e51d6d3aa88b0e01a6d89c9135c4744" :answer/id #uuid "20505da6-4432-5d9d-9939-3ad83f1ee3b1" :answer/type :answer.type/math :answer/value "8({x}^{2}-1)^{4}+C" :db/ensure [:answer/validate]} {:db/id "q-2388/selection/9d66cdd18e620c944db11798b56fc95c977d965bcf7393c187e85b6103f79104" :answer/id #uuid "a64c02db-4d8d-5cad-a4f4-2a18eef07f05" :answer/type :answer.type/math :answer/value "3({x}^{2}-1)^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-2388/selection/2e1d43baf3c5f4bf7b13248e5447fa60a9c6e15644127bbc9c4b6b5e52c43c4e" :answer/id #uuid "d79b30d4-232d-5b8e-bcdd-799ff0c1d81e" :answer/type :answer.type/math :answer/value "\\frac{({x}^{2}-1)^{4}}{8}+C" :db/ensure [:answer/validate]} {:db/id "q-2388/selection/acf8c88aa976eaae81e2c1b0f64b4a6a663b46de9f7b4aa2a60e5bfaa1272fba" :answer/id #uuid "ecf4e36c-9740-5ecd-8ec1-9682d015413b" :answer/type :answer.type/math :answer/value "\\frac{({x}^{2}-1)^{5}}{10}+C" :db/ensure [:answer/validate]} {:db/id "q-2388/selection/413466c9b31da1dcac796500d81a315753e42aba1ee03896a816eadcc88ee1a3" :answer/id #uuid "634ba87f-6d30-5278-b812-f88773b06f90" :answer/type :answer.type/math :answer/value "\\frac{({x}^{2}-1)^{3}}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-2388/selection" :answer-field/id #uuid "82696e52-c5fc-5dab-968f-522fc72627cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2388/selection/2e1d43baf3c5f4bf7b13248e5447fa60a9c6e15644127bbc9c4b6b5e52c43c4e" :answer-field/choices ["q-2388/selection/a993a937dcb5b8f49780f1b4b97479308e51d6d3aa88b0e01a6d89c9135c4744" "q-2388/selection/9d66cdd18e620c944db11798b56fc95c977d965bcf7393c187e85b6103f79104" "q-2388/selection/2e1d43baf3c5f4bf7b13248e5447fa60a9c6e15644127bbc9c4b6b5e52c43c4e" "q-2388/selection/acf8c88aa976eaae81e2c1b0f64b4a6a663b46de9f7b4aa2a60e5bfaa1272fba" "q-2388/selection/413466c9b31da1dcac796500d81a315753e42aba1ee03896a816eadcc88ee1a3"] :db/ensure [:answer-field/validate]} {:db/id "q-2388" :question/id #uuid "a45879ab-cfd1-5e43-9240-07874b933287" :question/math-academy-id "q-2388" :question/problem "Calculate $\\int x({x}^{2}-1)^{3}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $({x}^{2}-1).$ But the derivative is $2x,$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu={x}^{2}-1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x({x}^{2}-1)^{3}\\,\\text{d}x & =\\int ({x}^{2}-1)^{3}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{3}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{3}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{3}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{4}}{4}+C \\\\  & =\\frac{1}{8}{u}^{4}+C \\\\  & =\\frac{1}{8}({x}^{2}-1)^{4}+C \\\\  & =\\frac{({x}^{2}-1)^{4}}{8}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2388/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-2388"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72467/selection/fd3eb354fada49531dc10a176d3df314e1ae418a9f12184dd85c752ed1795ca1" :answer/id #uuid "8c9b925b-2874-5e8c-9e38-3cf3b4b156d6" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72467/selection/c1e157e954986732d8c84badf9a49e2c1b3048138415c8b58977f9f4d073ca0c" :answer/id #uuid "728a30c6-53ef-511a-9a23-6662da446741" :answer/type :answer.type/math :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72467/selection/a407f2d2d820c7c5349ec8cdb0a98c918aad68a203a8cefb98ad751302ae22e6" :answer/id #uuid "19cef8e9-cfdb-5d12-8dff-90a2cb74f658" :answer/type :answer.type/math :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72467/selection/62d472a6d053fc29845559190a7e84ded0bca2721e7673f6de365969fb018080" :answer/id #uuid "b110da93-620a-57a2-8c08-271e709122f3" :answer/type :answer.type/math :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72467/selection/62f195bebf49688ebbce646ffeef856a637386afa5d82f0a886d4707c41c3efb" :answer/id #uuid "54ee440f-cd22-5ddc-a7c5-a1e576213592" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-72467/selection" :answer-field/id #uuid "a331e9b7-2dc3-5a72-81f3-9bf3ed251959" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72467/selection/fd3eb354fada49531dc10a176d3df314e1ae418a9f12184dd85c752ed1795ca1" :answer-field/choices ["q-72467/selection/fd3eb354fada49531dc10a176d3df314e1ae418a9f12184dd85c752ed1795ca1" "q-72467/selection/c1e157e954986732d8c84badf9a49e2c1b3048138415c8b58977f9f4d073ca0c" "q-72467/selection/a407f2d2d820c7c5349ec8cdb0a98c918aad68a203a8cefb98ad751302ae22e6" "q-72467/selection/62d472a6d053fc29845559190a7e84ded0bca2721e7673f6de365969fb018080" "q-72467/selection/62f195bebf49688ebbce646ffeef856a637386afa5d82f0a886d4707c41c3efb"] :db/ensure [:answer-field/validate]} {:db/id "q-72467" :question/id #uuid "bf7f5f7a-6ce4-547a-a4d6-8bd8a66765fa" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-72467"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72386/selection/5e6c01040053fb763adeba9ec44c17f0ee03c14285106a2d2cf20c841303e7c8" :answer/id #uuid "0401dab2-8a86-5e52-b0c5-9c9ee8bbe390" :answer/type :answer.type/math :answer/value "\\frac{1}{32}{(1+{x}^{8})}^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72386/selection/c8f2dec9671dbdb9e1a738f1ee04f8d75596aacbe5cdb99a7e0123a525a7e6e9" :answer/id #uuid "508bed82-4382-59df-8e26-d422a62d6b86" :answer/type :answer.type/math :answer/value "7{(1+{x}^{8})}^{7}+C" :db/ensure [:answer/validate]} {:db/id "q-72386/selection/80ce5dfd48b1faa5749a85378e16966dc58a6208fab533a8fc761dd90c0e9efd" :answer/id #uuid "b8ee78ce-e405-5882-a00b-1f8d5f8f97ac" :answer/type :answer.type/math :answer/value "\\frac{1}{8}{(1+{x}^{8})}^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72386/selection/0d07068e65f4f7459e056136ba9319d511a27f4aea606b43b654e33743cdacae" :answer/id #uuid "b39419d9-ca01-5dce-bb20-0a0f40a67d95" :answer/type :answer.type/math :answer/value "8{(1+{x}^{8})}^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72386/selection/75a139f6312d3f6bcfdd562438bc7f7278910eaa2c69dd6e120953f7531a09b2" :answer/id #uuid "5a65358a-86f6-5c00-aa93-69ec8a6f899e" :answer/type :answer.type/math :answer/value "\\frac{1}{56}{(1+{x}^{8})}^{7}+C" :db/ensure [:answer/validate]} {:db/id "q-72386/selection" :answer-field/id #uuid "4ff26cfe-7457-5934-9d06-b9cb9b3ec05d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72386/selection/5e6c01040053fb763adeba9ec44c17f0ee03c14285106a2d2cf20c841303e7c8" :answer-field/choices ["q-72386/selection/5e6c01040053fb763adeba9ec44c17f0ee03c14285106a2d2cf20c841303e7c8" "q-72386/selection/c8f2dec9671dbdb9e1a738f1ee04f8d75596aacbe5cdb99a7e0123a525a7e6e9" "q-72386/selection/80ce5dfd48b1faa5749a85378e16966dc58a6208fab533a8fc761dd90c0e9efd" "q-72386/selection/0d07068e65f4f7459e056136ba9319d511a27f4aea606b43b654e33743cdacae" "q-72386/selection/75a139f6312d3f6bcfdd562438bc7f7278910eaa2c69dd6e120953f7531a09b2"] :db/ensure [:answer-field/validate]} {:db/id "q-72386" :question/id #uuid "9dab5184-0037-54fc-af6a-63bdd095c6d9" :question/math-academy-id "q-72386" :question/problem "$\\int 2{x}^{7}{(1+{x}^{8})}^{7}\\,\\text{d}x=$" :question/worked-solution "In this case, the $2{x}^{7}$ that's outside the parentheses isn't quite the derivative of $(1+{x}^{8}).$ But the derivative is $8{x}^{7},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=1+{x}^{8}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =8{x}^{7}\\,⟹\\,\\frac{1}{8}\\text{d}u={x}^{7}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{7}{(1+{x}^{8})}^{7}\\,\\text{d}x & =\\int 2{(1+{x}^{8})}^{7}\\cdot {x}^{7}\\,\\text{d}x \\\\  & =\\int 2{u}^{7}\\cdot \\frac{1}{8}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{7}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{7}\\,\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =\\frac{1}{32}{u}^{8}+C \\\\  & =\\frac{1}{32}{(1+{x}^{8})}^{8}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72386/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-72386"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-12496"] :question/worked-solution "In this case, the ${x}^{3}$ that's outside the parentheses isn't quite the derivative of $({x}^{4}+11).$ But the derivative is $4{x}^{3},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu={x}^{4}+11.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={x}^{3}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{3}{({x}^{4}+11)}^{9}\\,\\text{d}x & =\\int ({x}^{4}+11)^{9}\\cdot {x}^{3}\\,\\text{d}x \\\\  & =\\int {u}^{9}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{10}}{10}+C \\\\  & =\\frac{1}{40}{u}^{10}+C \\\\  & =\\frac{1}{40}({x}^{4}+11)^{10}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-72385/selection/60988419bafd155536cf6173550c6522ddc71e3cc6f011a567708964fa34a52f" :answer/id #uuid "b27c0095-576b-5eea-8907-358bade2fbfe" :answer/type :answer.type/math :answer/value "\\frac{1}{5}(2{x}^{3}+1)^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-72385/selection/002b3a9faf0cd805587e8a0a1a2487a074520c9c69f4ad76dc072b320e7d9e39" :answer/id #uuid "98c9e2ed-0185-57e8-b953-15603b82710f" :answer/type :answer.type/math :answer/value "\\frac{1}{10}(2{x}^{3}+1)^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-72385/selection/e20ffc184bca94a15be5a5b39bc9f2c5d7880cd7b8281b11fa7f2d9db2c59a76" :answer/id #uuid "887e047f-9bb3-5e3b-8bc1-0377bf0b0e2b" :answer/type :answer.type/math :answer/value "\\frac{1}{6}(2{x}^{3}+1)^{6}+C" :db/ensure [:answer/validate]} {:db/id "q-72385/selection/99b20c291a45f503f03e2b742ec2adb2ae5dd6423439934a2420e5b0f4168e45" :answer/id #uuid "d7fa3bc2-2c63-51c8-8c75-3a61f01749ba" :answer/type :answer.type/math :answer/value "\\frac{1}{36}(2{x}^{3}+1)^{6}+C" :db/ensure [:answer/validate]} {:db/id "q-72385/selection/fc26c19eda1a4b29916ff374f4a38b21a860a76a3e8d80a2e5ededc8c25a90c6" :answer/id #uuid "0495a348-2b97-509f-8ea4-b03467d61f3a" :answer/type :answer.type/math :answer/value "10(2{x}^{3}+1)^{5}+C" :db/ensure [:answer/validate]} {:db/id "q-72385/selection" :answer-field/id #uuid "824b80fe-fbdf-515e-9ec6-62c647e8cb12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72385/selection/99b20c291a45f503f03e2b742ec2adb2ae5dd6423439934a2420e5b0f4168e45" :answer-field/choices ["q-72385/selection/60988419bafd155536cf6173550c6522ddc71e3cc6f011a567708964fa34a52f" "q-72385/selection/002b3a9faf0cd805587e8a0a1a2487a074520c9c69f4ad76dc072b320e7d9e39" "q-72385/selection/e20ffc184bca94a15be5a5b39bc9f2c5d7880cd7b8281b11fa7f2d9db2c59a76" "q-72385/selection/99b20c291a45f503f03e2b742ec2adb2ae5dd6423439934a2420e5b0f4168e45" "q-72385/selection/fc26c19eda1a4b29916ff374f4a38b21a860a76a3e8d80a2e5ededc8c25a90c6"] :db/ensure [:answer-field/validate]} {:db/id "q-72385" :question/id #uuid "9eacc087-6f5d-506c-a5c1-601015ea4d5f" :question/math-academy-id "q-72385" :question/problem "$\\int {x}^{2}{(2{x}^{3}+1)}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the ${x}^{2}$ that's outside the parentheses isn't quite the derivative of $(2{x}^{3}+1).$ But the derivative is $6{x}^{2},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=2{x}^{3}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{2}\\,⟹\\,\\frac{1}{6}\\text{d}u={x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{2}{(2{x}^{3}+1)}^{5}\\,\\text{d}x & =\\int (2{x}^{3}+1)^{5}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{6}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{6}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{36}{u}^{6}+C \\\\  & =\\frac{1}{36}(2{x}^{3}+1)^{6}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72385/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac"] :knowledge-point/questions ["q-72385"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113719/selection/7d603d57ac7d5ea6ff99c840ac003c599941e541ed6343c460dffbb617e5d175" :answer/id #uuid "931bf058-ea99-580f-b705-db9b79255f4d" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|1+x-{x}^{4}|+C" :db/ensure [:answer/validate]} {:db/id "q-113719/selection/03b6302e9bf15161b6e8e7e1596cf19c38c9be4c13f8d5f14c2261280d1f9083" :answer/id #uuid "3f3e2f6c-1f81-5dae-918f-f20332f4fdce" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{1+x-{x}^{4}}{1-4{x}^{3}}|+C" :db/ensure [:answer/validate]} {:db/id "q-113719/selection/1b3f05ba0a669074d3615c67b540c8877f80655a99934e3dae0570258b10e19b" :answer/id #uuid "612f7c3b-f809-5e06-8606-8a6e2bbc1f85" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡|1+x-{x}^{4}|}{1-4{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113719/selection/12036e72d890daaf053444592578716cc3a8d4bc219b2b27f8ab96989346e7fc" :answer/id #uuid "77c4f64f-4dcf-5ecc-b7f2-5bdd694efc96" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|1-4{x}^{3}|+C" :db/ensure [:answer/validate]} {:db/id "q-113719/selection/f6d9cb9d21821fb9990fad7186165783a4dc3667086a42de67d79d4f6b20f163" :answer/id #uuid "401049fa-e789-5e01-abd6-3c330881b585" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|\\frac{1-4{x}^{3}}{1+x-{x}^{4}}|+C" :db/ensure [:answer/validate]} {:db/id "q-113719/selection" :answer-field/id #uuid "7ccbc545-c5d9-5796-8468-508dea968569" :answer-field/key "selection" :answer-field/type :answer-field.type/radio 