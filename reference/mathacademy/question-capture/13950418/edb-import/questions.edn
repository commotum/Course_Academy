culate $\\displaystyle \\int3x^{2}(x^{3} + 4)^{5}dx$."}] [{:db/id #edb/ref 17592186069066 :knowledge-point/_questions [{:knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e737833-6a16-5255-9705-12d82cc3c809" :answer/type {:db/ident :answer.type/math} :answer/value "(2x(x^{2} + 1)^{13})/(13) + C" :db/id #edb/ref 17592186066079} {:answer/id #uuid "28d71338-95c7-5e57-a222-276066aa72d7" :answer/type {:db/ident :answer.type/math} :answer/value "- (2x(x^{2} + 1)^{12})/(12) + C" :db/id #edb/ref 17592186066080} {:answer/id #uuid "34d41f63-1530-586e-88bc-d63d42c6aeea" :answer/type {:db/ident :answer.type/math} :answer/value "((x^{2} + 1)^{13})/(13) + C" :db/id #edb/ref 17592186066081} {:answer/id #uuid "492e43c2-d010-59fe-9783-808db0b184f8" :answer/type {:db/ident :answer.type/math} :answer/value "((x^{2} + 1)^{12})/(12) + C" :db/id #edb/ref 17592186066082} {:answer/id #uuid "63a79d8c-99f9-5689-b4f8-404fdd8c8802" :answer/type {:db/ident :answer.type/math} :answer/value "- (2x(x^{2} + 1)^{13})/(13) + C" :db/id #edb/ref 17592186066083}] :answer-field/correct {:answer/id #uuid "34d41f63-1530-586e-88bc-d63d42c6aeea" :answer/type {:db/ident :answer.type/math} :answer/value "((x^{2} + 1)^{13})/(13) + C" :db/id #edb/ref 17592186066081} :answer-field/id #uuid "1ba031b8-c494-513c-8d67-d2fa4f12632f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066078}] :question/id #uuid "c4b49482-74ae-5d27-81da-2160ac3cb246" :question/math-academy-id "q-2195" :question/problem "What is $\\displaystyle \\int2x(x^{2} + 1)^{12}dx$?"}]}
