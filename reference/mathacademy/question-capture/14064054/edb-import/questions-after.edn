#{[{:db/id #edb/ref 17592186349296 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52c78070-3a7e-52fa-95cb-712b749aa21f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186349298} {:answer/id #uuid "a301ec8c-bf6b-5c14-9f67-9a616b6f6135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186349299} {:answer/id #uuid "5cfff7ee-5653-54e1-9d64-a27f7e4bfa05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186349300} {:answer/id #uuid "93751f4d-3d21-5cc9-bf2a-b1f1a2772bcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186349301} {:answer/id #uuid "6bdf0f46-e510-57fb-9196-c84f08486ee6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186349302}] :answer-field/correct {:answer/id #uuid "a301ec8c-bf6b-5c14-9f67-9a616b6f6135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186349299} :answer-field/id #uuid "8648fee5-2807-506e-9132-b7540548afdc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349297}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5fe77a5c-4312-5b94-9b61-405a56afc897" :question/math-academy-id "q-179539" :question/problem "Given that $P(A)=\\frac{1}{2},$ $P(B)=\\frac{2}{5},$ and $P(A\\cup B)=\\frac{7}{10},$ find $P(A\\cup {B}^{′}).$" :question/worked-solution "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{7}{10} & =\\frac{1}{2}+\\frac{2}{5}-P(A\\cap B) \\\\ P(A\\cap B) & =\\frac{1}{2}+\\frac{2}{5}-\\frac{7}{10} \\\\ P(A\\cap B) & =\\frac{1}{5}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region $A\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14064054/assets/5ecc7dae3e6b6e57ccd4a7b8907cb4dd20b0ece400a5768b747f3cb3da788e4b.png)\n\nFinally, we have\n\n$$\nP(A\\cup {B}^{′})=\\frac{3}{10}+\\frac{1}{5}+\\frac{3}{10}=\\frac{4}{5}.\n$$"}] [{:db/id #edb/ref 17592186349303 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a088d687-f56b-5771-86ee-ba5215245646" :answer/type {:db/ident :answer.type/math} :answer/value "0.65" :db/id #edb/ref 17592186349305}] :answer-field/correct {:answer/id #uuid "a088d687-f56b-5771-86ee-ba5215245646" :answer/type {:db/ident :answer.type/math} :answer/value "0.65" :db/id #edb/ref 17592186349305} :answer-field/id #uuid "53855a49-5e83-52e8-a0e4-3c60ff6a5cd8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349304}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "afce1321-9dc1-5a34-b2c6-72efabe0368c" :question/math-academy-id "q-264403" :question/problem "Given that $P(A)=0.25,$ $P(B)=0.45,$ and $P(A\\cup B)=0.6,$ find $P(A\\cup {B}^{′}).$\n\n$P(A\\cup {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.6 & =0.25+0.45-P(A\\cap B) \\\\ P(A\\cap B) & =0.25+0.45-0.6 \\\\  & =0.1\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region $A\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14064054/assets/f8fb716593a35fc1f85ab524dc78bf0fa0cd03dc16b0c5ca92a9b2836e6e7c5b.png)\n\nFinally, we have\n\n$$\nP(A\\cup {B}^{′})=0.15+0.1+0.4=0.65.\n$$"}] [{:db/id #edb/ref 17592186349306 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346a03b2-edfe-57d2-aece-c0791f822b6e" :answer/type {:db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186349308} {:answer/id #uuid "43ba118a-6d5e-5035-ae23-fb3680b5ae34" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186349309}] :answer-field/correct {:answer/id #uuid "43ba118a-6d5e-5035-ae23-fb3680b5ae34" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186349309} :answer-field/id #uuid "e3d64430-ebc6-5724-be8e-77d588adbd85" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349307}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c1421b79-b763-507f-bc9d-72470c20c64a" :question/math-academy-id "q-264416" :question/problem "Given that $P(B)=0.45,$ $P(A\\cap B)=0.2,$ and $P(A\\cup B)=0.75,$ find $P({A}^{′}).$\n\n$P({A}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.75 & =P(A)+0.45-0.2 \\\\ P(A) & =0.75+0.2-0.45 \\\\  & =0.5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}^{′}) & =1-P(A) \\\\  & =1-0.5 \\\\  & =0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186349310 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8128fbed-1512-5c5c-a0b0-b281928ce934" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186349312}] :answer-field/correct {:answer/id #uuid "8128fbed-1512-5c5c-a0b0-b281928ce934" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186349312} :answer-field/id #uuid "78a12c31-13a3-5cb7-9c7d-1c91bc8cee33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349311}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fea666e2-5052-54f2-889f-1e9563ba7916" :question/math-academy-id "q-264424" :question/problem "Given that $P(B)=\\frac{4}{15},$ $P(A\\cap B)=\\frac{1}{15},$ and $P(A\\cup B)=\\frac{4}{5},$ find $P({A}^{′}).$\n\n$P({A}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{4}{5} & =P(A)+\\frac{4}{15}-\\frac{1}{15} \\\\ P(A) & =\\frac{4}{5}+\\frac{1}{15}-\\frac{4}{15} \\\\  & =\\frac{3}{5}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}^{′}) & =1-P(A) \\\\  & =1-\\frac{3}{5} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186349313 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "975c147b-230b-5de4-9147-1fae2e1c2bee" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186349315} {:answer/id #uuid "5c2b88c5-ec29-5fcb-8eac-005baf602a19" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186349316} {:answer/id #uuid "90fb192a-bc92-55ed-bf3c-af4e642a7a61" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186349317} {:answer/id #uuid "b10c2d84-a696-523d-becb-16f99e6c1656" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186349318} {:answer/id #uuid "1c1ab77a-370c-5949-bd3c-e25bbdac5fd1" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186349319}] :answer-field/correct {:answer/id #uuid "90fb192a-bc92-55ed-bf3c-af4e642a7a61" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186349317} :answer-field/id #uuid "ee719a31-a594-548f-a8ff-a20b253ef531" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349314}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "00c1523d-9863-50ec-80df-9eb6aeec0d90" :question/math-academy-id "q-87262" :question/problem "Given that $P(A)=0.5,$ $P(A\\cap B)=0.4,$ and $P(A\\cup B)=0.8,$ find $P({B}^{′}).$" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.8 & =0.5+P(B)-0.4 \\\\ P(B) & =0.8+0.4-0.5 \\\\ P(B) & =0.7\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-0.7 \\\\  & =0.3.\\end{aligned}\n$$"}]}
