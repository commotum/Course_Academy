[{:db/id "q-4630/selection/9c89a4aa852178dc04c6f5c32f9a83c4ed84255ff56f7cb714d69b18a6653597" :answer/id #uuid "5495de14-a447-55dd-87d6-cc6708ee40c9" :answer/type :answer.type/math :answer/value "x=-1,\\,x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-4630/selection/d2f31f4d56a14fc49eb3ecaa093fde943a0f070ed79fd2befe297508e545b824" :answer/id #uuid "d860eb09-c882-5a35-8bb8-6f104ab1f17e" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-4630/selection/5e6e0d1898cea34becc12ffda77bc0b2de4857eaf7738814c845757f66811aa1" :answer/id #uuid "0b94819d-3eb7-5e8b-bcc2-6f3e7b326da1" :answer/type :answer.type/math :answer/value "x=-3,\\,x=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-4630/selection/1f0c3957a100d0d7c1a480777a356ff980feecd1f9cb3d0b9cedf81bebc5d071" :answer/id #uuid "ff960184-cde7-5164-8b96-04baa11d6b06" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2},\\,x=1" :db/ensure [:answer/validate]} {:db/id "q-4630/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "923b89ec-5094-5b83-8a84-1b6c36541985" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-4630/selection" :answer-field/id #uuid "d91d0606-c2ac-5733-8d67-c9b1eaea9069" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-4630/selection/d2f31f4d56a14fc49eb3ecaa093fde943a0f070ed79fd2befe297508e545b824" :answer-field/choices ["q-4630/selection/9c89a4aa852178dc04c6f5c32f9a83c4ed84255ff56f7cb714d69b18a6653597" "q-4630/selection/d2f31f4d56a14fc49eb3ecaa093fde943a0f070ed79fd2befe297508e545b824" "q-4630/selection/5e6e0d1898cea34becc12ffda77bc0b2de4857eaf7738814c845757f66811aa1" "q-4630/selection/1f0c3957a100d0d7c1a480777a356ff980feecd1f9cb3d0b9cedf81bebc5d071" "q-4630/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f"] :db/ensure [:answer-field/validate]} {:db/id "q-4630" :question/id #uuid "7eabb1cc-388e-58ab-a506-5be08d869744" :question/math-academy-id "q-4630" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{2}+2x-3}{2{x}^{2}-x-1}.$" :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+2x-3}{2{x}^{2}-x-1} & =\\frac{(x-1)(x+3)}{(2x+1)(x-1)} \\\\  & =\\frac{\\cancel{(x-1)}(x+3)}{(2x+1)\\cancel{(x-1)}} \\\\  & =\\frac{x+3}{2x+1}.\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\n2x+1=0\\,⟹\\,x=-\\frac{1}{2}.\n$$\n\nSo the *only* vertical asymptote is at $x=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-4630/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463"] :knowledge-point/questions ["q-4630"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37070"] :question/problem "Find the vertical asymptotes of $f(x)=\\frac{4{x}^{2}-3x}{8x-6}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{4{x}^{2}-3x}{8x-6} & =\\frac{x(4x-3)}{2(4x-3)}=\\frac{x}{2}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=\\frac{3}{4}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987351/assets/3e6ebc8eaec86276442b13fde934234fdaf9c4a457398bb1b792c6910350e44c.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-73029/selection/8c6354d90e227629a67f4372dda384fb0ba7cb7da92322b1ebe9fea2d33469d1" :answer/id #uuid "cd9b5bc9-a132-543f-bc09-4f0b97076cb2" :answer/type :answer.type/text :answer/value "$x=-6$, $x=3$" :db/ensure [:answer/validate]} {:db/id "q-73029/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" :answer/id #uuid "1e31c918-96a0-58cb-a562-c6630cdae6a2" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "q-73029/selection/264ed6922279f92bdc90c36a26ea47de8f6c6ab903ed9e63c8b8bb51a5a9d4f6" :answer/id #uuid "b58a571e-febe-5c28-ad42-3733cddb28db" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "q-73029/selection/b2902ec1de522646ab349078a3167c2727061725215891a0be50573ccc005673" :answer/id #uuid "e788baba-bfb5-5a25-a9de-0326600cc34e" :answer/type :answer.type/text :answer/value "$x=-3$, $x=6$" :db/ensure [:answer/validate]} {:db/id "q-73029/selection/4507af753e94c6f82db929d331e6749b5de730f7a1cfa515ef7e9eae88a0fbc8" :answer/id #uuid "6a13f398-0e30-5764-92e6-1709e66d7ad2" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "q-73029/selection" :answer-field/id #uuid "0b60a928-3f7b-5f55-b8e6-817717e01424" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73029/selection/b2902ec1de522646ab349078a3167c2727061725215891a0be50573ccc005673" :answer-field/choices ["q-73029/selection/8c6354d90e227629a67f4372dda384fb0ba7cb7da92322b1ebe9fea2d33469d1" "q-73029/selection/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" "q-73029/selection/264ed6922279f92bdc90c36a26ea47de8f6c6ab903ed9e63c8b8bb51a5a9d4f6" "q-73029/selection/b2902ec1de522646ab349078a3167c2727061725215891a0be50573ccc005673" "q-73029/selection/4507af753e94c6f82db929d331e6749b5de730f7a1cfa515ef7e9eae88a0fbc8"] :db/ensure [:answer-field/validate]} {:db/id "q-73029" :question/id #uuid "866875d0-d558-5de5-a3c8-64626804b8ba" :question/math-academy-id "q-73029" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x+3}-\\frac{1}{x-6}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x+3}-\\frac{1}{x-6} & =\\frac{x-6-(x+3)}{(x+3)(x-6)}=-\\frac{9}{(x+3)(x-6)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x+3)(x-6)=0\\,⟹\\,x=-3\\,,\\,x=6.\n$$\n\nTherefore, the vertical asymptotes are at $x=-3$ and $x=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73029/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-73029"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73031/selection/e91e4ee355e4fc67c7baaee3247403a2092d94a407710b4b09054de0e1592b37" :answer/id #uuid "320a6e02-b219-5135-a100-cd6b41178d10" :answer/type :answer.type/text :answer/value "$x=1$, $x=-1$" :db/ensure [:answer/validate]} {:db/id "q-73031/selection/02c2ac9730c208f517b45425f4e43eb110953149e4da3e6c03d6ca5b06cd40f6" :answer/id #uuid "44549f77-4f66-5233-8fde-59c356997070" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "q-73031/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "3549cd14-f9a4-57d5-9829-de4e0b4dff08" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-73031/selection/4808419a1fbb01223a5f04fde6b640f52c3842f8a3cf6c9de908fa827a338c3c" :answer/id #uuid "c55d50ff-4e23-50ac-8576-5e0fb93de752" :answer/type :answer.type/text :answer/value "$x=\\frac{1}{2}$, $x=1$" :db/ensure [:answer/validate]} {:db/id "q-73031/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "f941c0f6-a303-5ff7-b88b-4efcb4b21f82" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "q-73031/selection" :answer-field/id #uuid "c5d44702-f80f-527f-8082-b4d5515b6a3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73031/selection/e91e4ee355e4fc67c7baaee3247403a2092d94a407710b4b09054de0e1592b37" :answer-field/choices ["q-73031/selection/e91e4ee355e4fc67c7baaee3247403a2092d94a407710b4b09054de0e1592b37" "q-73031/selection/02c2ac9730c208f517b45425f4e43eb110953149e4da3e6c03d6ca5b06cd40f6" "q-73031/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-73031/selection/4808419a1fbb01223a5f04fde6b640f52c3842f8a3cf6c9de908fa827a338c3c" "q-73031/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950"] :db/ensure [:answer-field/validate]} {:db/id "q-73031" :question/id #uuid "70dea798-f51a-5943-b982-89e197a7bc77" :question/math-academy-id "q-73031" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-1}+\\frac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-1}+\\frac{1}{x+1} & =\\frac{x+1+(x-1)}{(x-1)(x+1)}=\\frac{2x}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-1)(x+1)=0\\,⟹\\,x=1\\,,\\,x=-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=1$ and $x=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73031/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-73031"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107028/selection/218285a1e1b592ff3dab3c92937bb724e621ba420e1c14d2d89b87a246a56313" :answer/id #uuid "a5243f75-fbc3-56f0-afc7-5139aaa8a5e9" :answer/type :answer.type/text :answer/value "$x=0$, $x=4$" :db/ensure [:answer/validate]} {:db/id "q-107028/selection/e3d185ba607fbc150952922a59e94440acae83dedc8f350e51812feeda0abfea" :answer/id #uuid "f9de4aa8-9bc4-52a6-9755-3d0f17e6e3e7" :answer/type :answer.type/text :answer/value "$x=0$, $x=3$" :db/ensure [:answer/validate]} {:db/id "q-107028/selection/264ed6922279f92bdc90c36a