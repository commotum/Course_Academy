te is at $x=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107028/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463"] :knowledge-point/questions ["q-107028"] :db/ensure [:knowledge-point/validate]}]
