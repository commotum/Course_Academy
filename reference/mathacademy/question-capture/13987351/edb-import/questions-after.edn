#{[{:db/id #edb/ref 17592186283927 :knowledge-point/_questions [{:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463" :knowledge-point/title "Determining Vertical Asymptotes of Rational Functions by Factoring the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5243f75-fbc3-56f0-afc7-5139aaa8a5e9" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$, $x=4$" :db/id #edb/ref 17592186283929} {:answer/id #uuid "8a5b9a41-65b9-5367-ad9c-6d66393dff80" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186283930} {:answer/id #uuid "e2984acc-d8c8-5543-a72c-acb45746e5d5" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186283931} {:answer/id #uuid "2457603d-e191-53b7-adfd-3405462093b2" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186283932} {:answer/id #uuid "f9de4aa8-9bc4-52a6-9755-3d0f17e6e3e7" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$, $x=3$" :db/id #edb/ref 17592186283933}] :answer-field/correct {:answer/id #uuid "2457603d-e191-53b7-adfd-3405462093b2" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186283932} :answer-field/id #uuid "9b32fa74-de1e-5cb0-b480-8bb23cc82da9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283928}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d9af6b9-98f5-5715-92c9-adf8a60f68c2" :question/math-academy-id "q-107028" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{4x-12}{3{x}^{2}-9x}.$" :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{4x-12}{3{x}^{2}-9x} & =\\frac{4(x-3)}{3x(x-3)} \\\\  & =\\frac{4\\cancel{(x-3)}}{3x\\cancel{(x-3)}} \\\\  & =\\frac{4}{3x}\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\n3x=0\\,⟹\\,x=0\n$$\n\nSo the *only* vertical asymptote is at $x=0.$"}] [{:db/id #edb/ref 17592186120337 :knowledge-point/_questions [{:knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c0b4717-812f-5761-9342-ba95462ebf43" :answer/type {:db/ident :answer.type/math} :answer/value "x = 6" :db/id #edb/ref 17592186118498} {:answer/id #uuid "8c3a3de5-fae8-5fca-8cf1-341daf87c406" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{3}{8}" :db/id #edb/ref 17592186118499} {:answer/id #uuid "11901bbe-5e64-5ffe-8939-3924d5cd2741" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{3}{4}" :db/id #edb/ref 17592186118500} {:answer/id #uuid "4793c4c8-3f8c-5e50-a3aa-bd00f37b3859" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{3}{2}" :db/id #edb/ref 17592186118501} {:answer/id #uuid "7d781957-0197-5998-b649-4a4d3b275704" :answer/type {:db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186118502}] :answer-field/correct {:answer/id #uuid "7d781957-0197-5998-b649-4a4d3b275704" :answer/type {:db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186118502} :answer-field/id #uuid "205349a2-9ef8-59eb-b0e3-5977ed3b8a45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118497}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07860f00-c712-5f63-bfe2-a24e46e0db46" :question/math-academy-id "q-37070" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{4{x}^{2}-3x}{8x-6}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{4{x}^{2}-3x}{8x-6} & =\\frac{x(4x-3)}{2(4x-3)}=\\frac{x}{2}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=\\frac{3}{4}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13987351/assets/3e6ebc8eaec86276442b13fde934234fdaf9c4a457398bb1b792c6910350e44c.png)"}] [{:db/id #edb/ref 17592186283934 :knowledge-point/_questions [{:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463" :knowledge-point/title "Determining Vertical Asymptotes of Rational Functions by Factoring the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "923b89ec-5094-5b83-8a84-1b6c36541985" :answer/type {:db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186283936} {:answer/id #uuid "ff960184-cde7-5164-8b96-04baa11d6b06" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2},\\,x=1" :db/id #edb/ref 17592186283937} {:answer/id #uuid "0b94819d-3eb7-5e8b-bcc2-6f3e7b326da1" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3,\\,x=-\\frac{1}{2}" :db/id #edb/ref 17592186283938} {:answer/id #uuid "5495de14-a447-55dd-87d6-cc6708ee40c9" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1,\\,x=\\frac{1}{2}" :db/id #edb/ref 17592186283939} {:answer/id #uuid "d860eb09-c882-5a35-8bb8-6f104ab1f17e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}" :db/id #edb/ref 17592186283940}] :answer-field/correct {:answer/id #uuid "d860eb09-c882-5a35-8bb8-6f104ab1f17e" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}" :db/id #edb/ref 17592186283940} :answer-field/id #uuid "d91d0606-c2ac-5733-8d67-c9b1eaea9069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283935}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7eabb1cc-388e-58ab-a506-5be08d869744" :question/math-academy-id "q-4630" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{2}+2x-3}{2{x}^{2}-x-1}.$" :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+2x-3}{2{x}^{2}-x-1} & =\\frac{(x-1)(x+3)}{(2x+1)(x-1)} \\\\  & =\\frac{\\cancel{(x-1)}(x+3)}{(2x+1)\\cancel{(x-1)}} \\\\  & =\\frac{x+3}{2x+1}.\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\n2x+1=0\\,⟹\\,x=-\\frac{1}{2}.\n$$\n\nSo the *only* vertical asymptote is at $x=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186283941 :knowledge-point/_questions [{:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b58a571e-febe-5c28-ad42-3733cddb28db" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186283943} {:answer/id #uuid "1e31c918-96a0-58cb-a562-c6630cdae6a2" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186283944} {:answer/id #uuid "6a13f398-0e30-5764-92e6-1709e66d7ad2" :answer/type {:db/ident :answer.type/math} :answer/value "x=6" :db/id #edb/ref 17592186283945} {:answer/id #uuid "cd9b5bc9-a132-543f-bc09-4f0b97076cb2" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6$, $x=3$" :db/id #edb/ref 17592186283946} {:answer/id #uuid "e788baba-bfb5-5a25-a9de-0326600cc34e" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-3$, $x=6$" :db/id #edb/ref 17592186283947}] :answer-field/correct {:answer/id #uuid "e788baba-bfb5-5a25-a9de-0326600cc34e" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-3$, $x=6$" :db/id #edb/ref 17592186283947} :answer-field/id #uuid "0b60a928-3f7b-5f55-b8e6-817717e01424" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283942}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "866875d0-d558-5de5-a3c8-64626804b8ba" :question/math-academy-id "q-73029" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x+3}-\\frac{1}{x-6}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x+3}-\\frac{1}{x-6} & =\\frac{x-6-(x+3)}{(x+3)(x-6)}=-\\frac{9}{(x+3)(x-6)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x+3)(x-6)=0\\,⟹\\,x=-3\\,,\\,x=6.\n$$\n\nTherefore, the vertical asymptotes are at $x=-3$ and $x=6.$"}] [{:db/id #edb/ref 17592186283948 :knowledge-point/_questions [{:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44549f77-4f66-5233-8fde-59c356997070" :answer/type {:db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186283950} {:answer/id #uuid "c55d50ff-4e23-50ac-8576-5e0fb93de752" :answer/type {:db/ident :answer.type/text} :answer/value "$x=\\frac{1}{2}$, $x=1$" :db/id #edb/ref 17592186283951} {:answer/id #uuid "3549cd14-f9a4-57d5-9829-de4e0b4dff08" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186283952} {:answer/id #uuid "f941c0f6-a303-5ff7-b88b-4efcb4b21f82" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186283953} {:answer/id #uuid "320a6e02-b219-5135-a100-cd6b41178d10" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186283954}] :answer-field/correct {:answer/id #uuid "320a6e02-b219-5135-a100-cd6b41178d10" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186283954} :answer-field/id #uuid "c5d44702-f80f-527f-8082-b4d5515b6a3d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283949}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "70dea798-f51a-5943-b982-89e197a7bc77" :question/math-academy-id "q-73031" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-1}+\\frac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-1}+\\frac{1}{x+1} & =\\frac{x+1+(x-1)}{(x-1)(x+1)}=\\frac{2x}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-1)(x+1)=0\\,⟹\\,x=1\\,,\\,x=-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=1$ and $x=-1.$"}]}
