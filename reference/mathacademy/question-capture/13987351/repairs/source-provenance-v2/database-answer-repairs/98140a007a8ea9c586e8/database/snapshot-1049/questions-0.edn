#{[{:db/id #edb/ref 17592186341899 :knowledge-point/_questions [{:db/id #edb/ref 17592186119957 :knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a883e7-4d2a-532d-9bbd-dce6962edcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186339890} {:answer/id #uuid "5a4e1d9b-7c6a-5c7d-b288-86ddd171b3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186339949} {:answer/id #uuid "89cc96ba-2754-55f6-8b86-473c4e42f001" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{1}{2}$, $x=1$" :db/id #edb/ref 17592186340358} {:answer/id #uuid "8f1ac77d-4b8a-5f0e-932d-f01c276b93ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186340415} {:answer/id #uuid "a9c87c4a-a6d6-5db3-8002-3e4994f240d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186340674}] :answer-field/correct {:answer/id #uuid "52a883e7-4d2a-532d-9bbd-dce6962edcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186339890} :answer-field/id #uuid "929e3387-fa4c-54fe-ab80-91ba52610238" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341637}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d13dc12b-246a-57c9-9dc3-693e68fcfaf7" :question/math-academy-id "q-73031" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-1}+\\frac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-1}+\\frac{1}{x+1} & =\\frac{x+1+(x-1)}{(x-1)(x+1)}=\\frac{2x}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-1)(x+1)=0\\,⟹\\,x=1\\,,\\,x=-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=1$ and $x=-1.$"}]}
