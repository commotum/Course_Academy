#{[{:activity/first-step {:db/id #edb/ref 17592186120929} :activity/id #uuid "9c55bfa3-aadc-5e0f-bea4-8915a95c985b" :activity/scope {:db/id #edb/ref 17592186048163 :topic/id #uuid "84a1f6d3-985c-55c9-a161-9d6f23cb6401" :topic/math-academy-id 1815} :activity/steps [{:db/id #edb/ref 17592186120929 :step/content {:db/id #edb/ref 17592186121014 :tutorial/content "To determine the vertical asymptotes of a rational function, we first cancel any common factors in the numerator and denominator. Then, we set the denominator equal to zero and solve for $x$.\n\nFor example, let's try to find the vertical asymptotes of the rational function $y=\\dfrac{2}{x-5}.$ \n\nNow, there are no common factors in the numerator and denominator, and so we set the denominator equal to zero:\n\n$$\n\\begin{aligned}0 & =x-5 \\\\ x & =5\\end{aligned}\n$$\n\nTherefore, there is a vertical asymptote at $x=5.$\n\nThis matches up  with what we see in the graph of the function:\n\n![](images/e9/e9d2c264e323eb86b4e56fef563387989f66fb016a3e1c98db1f35776e3b5cb5.png)" :tutorial/id #uuid "22321890-d586-5e6c-bff9-b2a6b3388ae0" :tutorial/math-academy-id 264 :tutorial/title "Introduction"} :step/id #uuid "b0251d11-c37d-5bc9-839f-3b319b92b170" :step/math-academy-id 486583 :step/next {:db/id #edb/ref 17592186120930}} {:db/id #edb/ref 17592186120930 :step/content {:db/id #edb/ref 17592186119954 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119695 :question/id #uuid "d462c4fb-c784-5dc3-adc1-1cd562c6a55e" :question/math-academy-id "e-84"} :knowledge-point/id #uuid "744b0e69-71f9-5ca0-a200-8968a9ec192e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049074}] :knowledge-point/questions [{:db/id #edb/ref 17592186120479} {:db/id #edb/ref 17592186120480} {:db/id #edb/ref 17592186314886} {:db/id #edb/ref 17592186314889} {:db/id #edb/ref 17592186314890} {:db/id #edb/ref 17592186329834} {:db/id #edb/ref 17592186329835}] :knowledge-point/title "Determining Vertical Asymptotes of a Rational Funct