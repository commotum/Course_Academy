#{[{:db/id #edb/ref 17592186247012 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063c2d9f-cafb-5814-b86b-b2df1f77be60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5g-3}{2-h}" :db/id #edb/ref 17592186247014} {:answer/id #uuid "05103891-f1c0-5e43-b21f-cfcad99e8e9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186247015} {:answer/id #uuid "486dcd34-91c1-5c94-9581-c6240f920d57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2g}{g(2-h)}" :db/id #edb/ref 17592186247016} {:answer/id #uuid "3f3b28e7-9818-5e32-9ea9-e96947c7fd59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{g-8}{g(2-h)}" :db/id #edb/ref 17592186247017} {:answer/id #uuid "91805dae-6ee5-5c5e-92a2-11a11645573e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2g}{2-h}" :db/id #edb/ref 17592186247018}] :answer-field/correct {:answer/id #uuid "05103891-f1c0-5e43-b21f-cfcad99e8e9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186247015} :answer-field/id #uuid "9797a54a-5271-5c10-90e3-f81693bae428" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247013}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a972fb26-dd70-56b1-a8a0-8546890c476e" :question/is-example false :question/math-academy-id "q-113303" :question/problem "Simplify $\\frac{5}{2-h}-\\frac{3}{g(2-h)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $g(2-h)$ if we multiply the top and bottom of the first fraction by $g:$\n\n$$\n\\begin{aligned}\\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{g}{g}\\cdot \\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g}{g(2-h)}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g-3}{g(2-h)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247019 :knowledge-point/_questions [{:knowledge-point/id #uuid "94cbd132-72fc-5645-bca3-9c81b6ac3845" :knowledge-point/title "Applying the Rule of Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bc2d236-48a2-53b2-8871-f873f03741b0" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186247021} {:answer/id #uuid "b2c4e520-8b00-51fd-b292-7d83ec8587a0" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186247022} {:answer/id #uuid "d6c14c16-7a63-51e6-92c5-62b52440ab17" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186247023} {:answer/id #uuid "751d5ec7-b18d-55c1-89f3-66f11a9b81d0" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186247024} {:answer/id #uuid "0084ba1e-e56e-508c-8087-c6dadb250e3d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186247025}] :answer-field/correct {:answer/id #uuid "751d5ec7-b18d-55c1-89f3-66f11a9b81d0" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186247024} :answer-field/id #uuid "d501712c-d6c1-5660-bf9f-306a8839a4c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247020}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d3f0647c-4317-5989-96f8-e7764602d90f" :question/is-example false :question/math-academy-id "q-122083" :question/problem "A theme park has $5$ roller coasters, $7$ flat rides, and $3$ dark rides. How many choices are there to select a single attraction?" :question/worked-solution "In order to find the total number of choices, we can use the **rule of sum**:\n\n$$\n5+7+3=15\n$$\n\nTherefore, there are $15$ choices of attractions."}] [{:db/id #edb/ref 17592186247026 :knowledge-point/_questions [{:knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3" :knowledge-point/title "Finding the Midpoint of a Segment With Variable Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dc1c29a-ef88-5654-b329-b97e4b7908b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3p}{2}" :db/id #edb/ref 17592186247028}] :answer-field/correct {:answer/id #uuid "9dc1c29a-ef88-5654-b329-b97e4b7908b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3p}{2}" :db/id #edb/ref 17592186247028} :answer-field/id #uuid "e0933f28-6068-5bb4-8f8f-241b500b0afa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247027} {:answer-field/choices [{:answer/id #uuid "5c806573-c998-52a7-8f19-a10c1beaedba" :answer/type {:db/ident :answer.type/math} :answer/value "4q" :db/id #edb/ref 17592186247030}] :answer-field/correct {:answer/id #uuid "5c806573-c998-52a7-8f19-a10c1beaedba" :answer/type {:db/ident :answer.type/math} :answer/value "4q" :db/id #edb/ref 17592186247030} :answer-field/id #uuid "60efe028-c518-59e5-9fa7-2183f70d36a2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247029}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f6f39073-db07-5fce-998a-bd96e9d29d41" :question/is-example false :question/math-academy-id "q-216936" :question/problem "The midpoint of the line segment with endpoints $(-9p,3q)$ and $(6p,5q)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-9p,3q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(6p,5q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-9p+6p}{2},\\frac{3q+5q}{2}) \\\\  & =(\\frac{-3p}{2},\\frac{8q}{2}) \\\\  & =(-\\frac{3p}{2},4q)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247031 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4" :knowledge-point/title "Rearranging and Solving a Quadratic Equation With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bde85d58-b17d-50a4-b7a8-2129fd3b7303" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186247033}] :answer-field/correct {:answer/id #uuid "bde85d58-b17d-50a4-b7a8-2129fd3b7303" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186247033} :answer-field/id #uuid "31b4992a-0dcc-50b4-a802-4696981ed736" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247032} {:answer-field/choices [{:answer/id #uuid "e8c28d9f-49f6-577a-9236-a526af428bf3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186247035}] :answer-field/correct {:answer/id #uuid "e8c28d9f-49f6-577a-9236-a526af428bf3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186247035} :answer-field/id #uuid "a4b41d8c-17c9-51b1-8680-1a93416ea230" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247034}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0a8f88f4-fdb0-54c4-b806-363e999f0b6c" :question/is-example false :question/math-academy-id "q-250552" :question/problem "Solve the equation $12x={x}^{2}+61.$\n\n$x=$\n{{field-1}}\n$\\pm $\n{{field-2}}$\\text{i}$" :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n-{x}^{2}+12x-61=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-1,\\,b=12,$ and $c=-61.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-12\\pm \\sqrt{(12)^{2}-4(-1)(-61)}}{2(-1)} \\\\  & =\\frac{-12\\pm \\sqrt{144-244}}{(-2)} \\\\  & =\\frac{-12\\pm \\sqrt{-100}}{(-2)} \\\\  & =\\frac{-12\\pm 10\\,\\text{i}}{(-2)} \\\\  & =6\\pm 5\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=6+5\\,\\text{i}$ and $x=6-5\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186247036 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Synthetic Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef290df9-2242-528b-a664-cf7c14f3dfda" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247038}] :answer-field/correct {:answer/id #uuid "ef290df9-2242-528b-a664-cf7c14f3dfda" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247038} :answer-field/id #uuid "546684cb-fc82-5ec8-97b7-93c2a7ca26eb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247037}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1be43615-7dc6-54e4-af72-5f8d6df002b4" :question/is-example false :question/math-academy-id "q-276812" :question/problem "The multiplicity of the root $x=5$ in the polynomial $p(x)={x}^{3}-8{x}^{2}+5x+50$ is{{field-1}}." :question/worked-solution "Since $x=5$ is a root of $p(x),$ the factor theorem tells us that $(x-5)$ is a factor of $p(x).$\n\nBecause $(x-5)$ is a factor of $p(x),$ we know that $(x-5)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x-5)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $5$ | $1$ | $-8$ | $5$ | $-50$ |\n|  | $↓$ | $5$ | $-15$ | $-50$ |\n|  | $1$ | $-3$ | $-10$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x-5}={x}^{2}-3x-10,\n$$\n\nwhich means that\n\n$$\np(x)=(x-5)({x}^{2}-3x-10).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x-5)(x+2)(x-5) \\\\  & =(x+2)(x-5)^{2}.\\end{aligned}\n$$\n\nThe factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186247039 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341fc212-577f-517c-ab67-33306cb3aaf5" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{3})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186247041} {:answer/id #uuid "80f4201d-4065-59f1-9bd0-41571ebb393e" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{5}+{y}^{2})(x-{y}^{4})" :db/id #edb/ref 17592186247042} {:answer/id #uuid "cdd5badd-26f4-5523-bca8-a89e9cc599ce" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186247043} {:answer/id #uuid "e1a01589-03f7-5932-b774-b1244389f78b" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186247044} {:answer/id #uuid "418fafd4-e752-5ef6-842c-30a70989723c" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{2})({x}^{3}-{y}^{2})" :db/id #edb/ref 17592186247045}] :answer-field/correct {:answer/id #uuid "e1a01589-03f7-5932-b774-b1244389f78b" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186247044} :answer-field/id #uuid "b69a976c-9940-59c0-8642-67f7dda41156" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247040}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0f67de55-0ba8-558f-bedc-a963f536e5fb" :question/is-example false :question/math-academy-id "q-31991" :question/problem "Factor ${x}^{4}-{y}^{6}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{x}^{4}-{y}^{6}={({x}^{2})}^{2}-{({y}^{3})}^{2}\n$$\n\nFinally, we factor our expression using the difference of squares formula:\n\n$$\n{({x}^{2})}^{2}-{({y}^{3})}^{2}=({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})\n$$"}] [{:db/id #edb/ref 17592186247046 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88326016-cd2e-579f-9501-d10ba9e2a358" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186247048} {:answer/id #uuid "c549f1cd-e0a8-54d1-b362-a4b719321b8a" :answer/type {:db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186247049} {:answer/id #uuid "63ba62af-408d-5eb2-b367-4a240c2c02c5" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186247050} {:answer/id #uuid "d2d23948-07e6-593d-b21a-96e1d46aa63e" :answer/type {:db/ident :answer.type/text} :answer/value "Between quadrants II and III" :db/id #edb/ref 17592186247051} {:answer/id #uuid "fbf15958-9625-5bfc-8f86-12089defabd4" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186247052}] :answer-field/correct {:answer/id #uuid "88326016-cd2e-579f-9501-d10ba9e2a358" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186247048} :answer-field/id #uuid "c052030b-74d9-58a8-8736-8b235dad2028" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247047}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6cc83dd4-931c-5537-b469-11f079199b4d" :question/is-example false :question/math-academy-id "q-64677" :question/problem "The angle $\\theta =-{210}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{210}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{210}^{∘}+{360}^{∘}={150}^{∘}\\,✓$\n\nSo the angle ${150}^{∘}$ is coterminal with $-{210}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933898/assets/788edaa48306f8370f9780cdeda956a85c34b76bd6ec5a028d9d38d425cbc5b9.png)\n\nWe see that ${150}^{∘}$ lies in quadrant II. Therefore, $-{210}^{∘}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186247053 :knowledge-point/_questions [{:knowledge-point/id #uuid "10100e89-21d6-53c5-a7de-f14fd73ce4b7" :knowledge-point/title "Combining Different Rules to Compute a Limit Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e13b19e-6447-5793-a9d7-811cbd1772e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{19}}{2}" :db/id #edb/ref 17592186247055} {:answer/id #uuid "1643c346-9326-5da5-9021-eb40088317ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{19}}{2}" :db/id #edb/ref 17592186247056} {:answer/id #uuid "7416cd0f-45b3-541c-9bcf-4a8187e34e4e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247057} {:answer/id #uuid "dd1c17d3-aa66-5374-954d-a0b6f827ea2a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186247058} {:answer/id #uuid "121fb221-0a02-50ab-8f8b-671a0c28c0c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186247059}] :answer-field/correct {:answer/id #uuid "7416cd0f-45b3-541c-9bcf-4a8187e34e4e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247057} :answer-field/id #uuid "5517b3de-1aa8-5abb-9744-83167954beb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247054}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c978569-5523-50ca-8c37-1ccfd41ba3f3" :question/is-example false :question/math-academy-id "q-67703" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933898/assets/0b0074bb582011695cec9807beab1623c6aab894e0c6abeb1bf3068be6ed3543.png)\n\nFind ${lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2}$ for the function $f(x)$ plotted above." :question/worked-solution "From the graph, we get that ${lim}_{x\\to \\,3}f(x)=9.$ \n\nApplying the root rule, we get\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2} & =\\frac{1}{2}\\sqrt{{lim}_{x\\to \\,3}(25-f(x))} \\\\  & =\\frac{1}{2}\\sqrt{25-9} \\\\  & =\\frac{\\sqrt{16}}{2} \\\\  & =\\frac{4}{2} \\\\  & =2\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247060 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30581ac3-3680-576a-98db-60203c870b03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186247062} {:answer/id #uuid "ad6c4101-dd25-582a-bd72-a3d8acd124d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186247063} {:answer/id #uuid "c26af037-0bda-5ae8-a3aa-492c7619fd75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186247064} {:answer/id #uuid "6ae9745d-5caf-5f4a-93ba-4d8b757f18ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186247065} {:answer/id #uuid "9cc6ef1b-2a5f-57e5-9a4c-d4007394811f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186247066}] :answer-field/correct {:answer/id #uuid "6ae9745d-5caf-5f4a-93ba-4d8b757f18ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186247065} :answer-field/id #uuid "673f9ab4-a8f8-5b9f-8a05-361085e479c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247061}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05a783ea-e3c4-593d-8e79-0266310508b2" :question/is-example false :question/math-academy-id "q-86327" :question/problem "$cos⁡(\\frac{\\pi }{4})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933898/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{4}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $cos⁡(\\frac{\\pi }{4})=\\frac{\\sqrt{2}}{2}.$"}]}
