-91c1-5c94-9581-c6240f920d57" :answer/type :answer.type/math :answer/value "\\frac{2g}{g(2-h)}" :db/ensure [:answer/validate]} {:db/id "q-113303/selection/20b2b709f84af7ce5de079e2abb728e6592e3df1a809c1b8e8f1a2e5f3bdf7f6" :answer/id #uuid "063c2d9f-cafb-5814-b86b-b2df1f77be60" :answer/type :answer.type/math :answer/value "\\frac{5g-3}{2-h}" :db/ensure [:answer/validate]} {:db/id "q-113303/selection/86dd31e21d2b80f2bdf27e6e9f712b8f5345834654dcea62ed2e823a507fc7ed" :answer/id #uuid "3f3b28e7-9818-5e32-9ea9-e96947c7fd59" :answer/type :answer.type/math :answer/value "\\frac{g-8}{g(2-h)}" :db/ensure [:answer/validate]} {:db/id "q-113303/selection/b8ef32109d01a4c4696d0a6c5fc69848581ff979b00b7b01d904404de8d3da53" :answer/id #uuid "91805dae-6ee5-5c5e-92a2-11a11645573e" :answer/type :answer.type/math :answer/value "\\frac{2g}{2-h}" :db/ensure [:answer/validate]} {:db/id "q-113303/selection/5f4cc3dab6389916dd80eb4cb5522a1f4a16dcb04aee87cae482d1c4a3c06dba" :answer/id #uuid "05103891-f1c0-5e43-b21f-cfcad99e8e9a" :answer/type :answer.type/math :answer/value "\\frac{5g-3}{g(2-h)}" :db/ensure [:answer/validate]} {:db/id "q-113303/selection" :answer-field/id #uuid "9797a54a-5271-5c10-90e3-f81693bae428" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113303/selection/5f4cc3dab6389916dd80eb4cb5522a1f4a16dcb04aee87cae482d1c4a3c06dba" :answer-field/choices ["q-113303/selection/7a84127097e0c186ffd391ef6fbd006f3adee64b7f5eb35d7041efbf83298de6" "q-113303/selection/20b2b709f84af7ce5de079e2abb728e6592e3df1a809c1b8e8f1a2e5f3bdf7f6" "q-113303/selection/86dd31e21d2b80f2bdf27e6e9f712b8f5345834654dcea62ed2e823a507fc7ed" "q-113303/selection/b8ef32109d01a4c4696d0a6c5fc69848581ff979b00b7b01d904404de8d3da53" "q-113303/selection/5f4cc3dab6389916dd80eb4cb5522a1f4a16dcb04aee87cae482d1c4a3c06dba"] :db/ensure [:answer-field/validate]} {:db/id "q-113303" :question/id #uuid "a972fb26-dd70-56b1-a8a0-8546890c476e" :question/math-academy-id "q-113303" :question/is-example false :question/problem "Simplify $\\frac{5}{2-h}-\\frac{3}{g(2-h)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $g(2-h)$ if we multiply the top and bottom of the first fraction by $g:$\n\n$$\n\\begin{aligned}\\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{g}{g}\\cdot \\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g}{g(2-h)}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g-3}{g(2-h)} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113303/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc"] :knowledge-point/questions ["q-113303"] :db/ensure [:knowledge-point/validate]} {:db/id "q-216936/field-1/b1c35961273421f7d7eb6fcb508b6f937e2c4f6ca0c42443b84610e2b51ebc70" :answer/id #uuid "9dc1c29a-ef88-5654-b329-b97e4b7908b5" :answer/type :answer.type/math :answer/value "-\\frac{3p}{2}" :db/ensure [:answer/validate]} {:db/id "q-216936/field-1" :answer-field/id #uuid "e0933f28-6068-5bb4-8f8f-241b500b0afa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-216936/field-1/b1c35961273421f7d7eb6fcb508b6f937e2c4f6ca0c42443b84610e2b51ebc70" :answer-field/choices ["q-216936/field-1/b1c35961273421f7d7eb6fcb508b6f937e2c4f6ca0c42443b84610e2b51ebc70"] :db/ensure [:answer-field/validate]} {:db/id "q-216936/field-2/aa78f8b2c0e38122d5bd18c4dadf95ccd9bccb29388875fbcef5b1ebdda4a055" :answer/id #uuid "5c806573-c998-52a7-8f19-a10c1beaedba" :answer/type :answer.type/math :answer/value "4q" :db/ensure [:answer/validate]} {:db/id "q-216936/field-2" :answer-field/id #uuid "60efe028-c518-59e5-9fa7-2183f70d36a2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-216936/field-2/aa78f8b2c0e38122d5bd18c4dadf95ccd9bccb29388875fbcef5b1ebdda4a055" :answer-field/choices ["q-216936/field-2/aa78f8b2c0e38122d5bd18c4dadf95ccd9bccb29388875fbcef5b1ebdda4a055"] :db/ensure [:answer-field/validate]} {:db/id "q-216936" :question/id #uuid "f6f39073-db07-5fce-998a-bd96e9d29d41" :question/math-academy-id "q-216936" :question/is-example false :question/problem "The midpoint of the line segment with endpoints $(-9p,3q)$ and $(6p,5q)$\n is$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-9p,3q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(6p,5q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-9p+6p}{2},\\frac{3q+5q}{2}) \\\\  & =(\\frac{-3p}{2},\\frac{8q}{2}) \\\\  & =(-\\frac{3p}{2},4q)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-216936/field-1" "q-216936/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "58e2e40e-209b-5bc7-98df-11841c2bbcc3"] :knowledge-point/questions ["q-216936"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31991/selection/ade102b8de5450ee70afbf22aa5b2653afd464f39f641c9a29604da2d0ddd8e9" :answer/id #uuid "418fafd4-e752-5ef6-842c-30a70989723c" :answer/type :answer.type/math :answer/value "({x}^{3}+{y}^{2})({x}^{3}-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "q-31991/selection/8632515c16272f064b54b53b03b7f0792cb55d6d3fe3cffb0b10c05bac3d88c6" :answer/id #uuid "80f4201d-4065-59f1-9bd0-41571ebb393e" :answer/type :answer.type/math :answer/value "({x}^{5}+{y}^{2})(x-{y}^{4})" :db/ensure [:answer/validate]} {:db/id "q-31991/selection/aaecfa1116b5125b36dc7189d43b1a64bfa987c53d0bdbac8e3d0d724697ecf8" :answer/id #uuid "e1a01589-03f7-5932-b774-b1244389f78b" :answer/type :answer.type/math :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/ensure [:answer/validate]} {:db/id "q-31991/selection/5379ceff831fdb5cc737a1acac6c19d7c6961d09acde24cea597bbd9bd7ecad8" :answer/id #uuid "341fc212-577f-517c-ab67-33306cb3aaf5" :answer/type :answer.type/math :answer/value "({x}^{3}+{y}^{3})({x}^{2}-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "q-31991/selection/9da0a6929780d7487944dd789f4deeee9ff92e51dcb5a41fb362776506d81c58" :answer/id #uuid "cdd5badd-26f4-5523-bca8-a89e9cc599ce" :answer/type :answer.type/math :answer/value "({x}^{2}+{y}^{2})({x}^{2}-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "q-31991/selection" :answer-field/id #uuid "b69a976c-9940-59c0-8642-67f7dda41156" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31991/selection/aaecfa1116b5125b36dc7189d43b1a64bfa987c53d0bdbac8e3d0d724697ecf8" :answer-field/choices ["q-31991/selection/ade102b8de5450ee70afbf22aa5b2653afd464f39f641c9a29604da2d0ddd8e9" "q-31991/selection/8632515c16272f064b54b53b03b7f0792cb55d6d3fe3cffb0b10c05bac3d88c6" "q-31991/selection/aaecfa1116b5125b36dc7189d43b1a64bfa987c53d0bdbac8e3d0d724697ecf8" "q-31991/selection/5379ceff831fdb5cc737a1acac6c19d7c6961d09acde24cea597bbd9bd7ecad8" "q-31991/selection/9da0a6929780d7487944dd789f4deeee9ff92e51dcb5a41fb362776506d81c58"] :db/ensure [:answer-field/validate]} {:db/id "q-31991" :question/id #uuid "0f67de55-0ba8-558f-bedc-a963f536e5fb" :question/math-academy-id "q-31991" :question/is-example false :question/problem "Factor ${x}^{4}-{y}^{6}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{x}^{4}-{y}^{6}={({x}^{2})}^{2}-{({y}^{3})}^{2}\n$$\n\nFinally, we factor our expression using the difference of squares formula:\n\n$$\n{({x}^{2})}^{2}-{({y}^{3})}^{2}=({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31991/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075"] :knowledge-point/questions ["q-31991"] :db/ensure [:knowledge-point/validate]} {:db/id "q-250552/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "bde85d58-b17d-50a4-b7a8-2129fd3b7303" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-250552/field-1" :answer-field/id #uuid "31b4992a-0dcc-50b4-a802-4696981ed736" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250552/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-250552/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-250552/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e8c28d9f-49f6-577a-9236-a526af428bf3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-250552/field-2" :answer-field/id #uuid "a4b41d8c-17c9-51b1-8680-1a93416ea230" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-250552/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-250552/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-250552" :question/id #uuid "0a8f88f4-fdb0-54c4-b806-363e999f0b6c" :question/math-academy-id "q-250552" :question/is-example false :question/problem "Solve the equation $12x={x}^{2}+61.$\n\n$x=$\n{{field-1}}\n$\\pm $\n{{field-2}}$\\text{i}$" :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n-{x}^{2}+12x-61=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-1,\\,b=12,$ and $c=-61.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-12\\pm \\sqrt{(12)^{2}-4(-1)(-61)}}{2(-1)} \\\\  & =\\frac{-12\\pm \\sqrt{144-244}}{(-2)} \\\\  & =\\frac{-12\\pm \\sqrt{-100}}{(-2)} \\\\  & =\\frac{-12\\pm 10\\,\\text{i}}{(-2)} \\\\  & =6\\pm 5\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=6+5\\,\\text{i}$ and $x=6-5\\,\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-250552/field-1" "q-250552/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef8dec7d-5154-59ee-aee8-9f068eb6b8f4"] :knowledge-point/questions ["q-250552"] :db/ensure [:knowledge-point/validate]}]
