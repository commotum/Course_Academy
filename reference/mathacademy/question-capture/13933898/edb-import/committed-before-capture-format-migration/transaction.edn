ction/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" :answer/id #uuid "fbf15958-9625-5bfc-8f86-12089defabd4" :answer/type :answer.type/text :answer/value "I" :db/ensure [:answer/validate]} {:db/id "q-64677/selection/cad070e5505a4117987910fbb6a5b1c2cd8fd809933cb8aa2c675d22a4b3a3a9" :answer/id #uuid "d2d23948-07e6-593d-b21a-96e1d46aa63e" :answer/type :answer.type/text :answer/value "Between quadrants II and III" :db/ensure [:answer/validate]} {:db/id "q-64677/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" :answer/id #uuid "c549f1cd-e0a8-54d1-b362-a4b719321b8a" :answer/type :answer.type/text :answer/value "III" :db/ensure [:answer/validate]} {:db/id "q-64677/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7" :answer/id #uuid "88326016-cd2e-579f-9501-d10ba9e2a358" :answer/type :answer.type/text :answer/value "II" :db/ensure [:answer/validate]} {:db/id "q-64677/selection" :answer-field/id #uuid "c052030b-74d9-58a8-8736-8b235dad2028" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64677/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7" :answer-field/choices ["q-64677/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" "q-64677/selection/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" "q-64677/selection/cad070e5505a4117987910fbb6a5b1c2cd8fd809933cb8aa2c675d22a4b3a3a9" "q-64677/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" "q-64677/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7"] :db/ensure [:answer-field/validate]} {:db/id "q-64677" :question/id #uuid "6cc83dd4-931c-5537-b469-11f079199b4d" :question/math-academy-id "q-64677" :question/is-example false :question/problem "The angle $\\theta =-{210}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{210}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{210}^{∘}+{360}^{∘}={150}^{∘}\\,✓$\n\nSo the angle ${150}^{∘}$ is coterminal with $-{210}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933898/assets/788edaa48306f8370f9780cdeda956a85c34b76bd6ec5a028d9d38d425cbc5b9.png)\n\nWe see that ${150}^{∘}$ lies in quadrant II. Therefore, $-{210}^{∘}$ also lies in this quadrant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64677/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee"] :knowledge-point/questions ["q-64677"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86327/selection/2ba67ff54273661460eaa0e3e45c1c4442f0b6f49f7edadb98be753769c4c9a1" :answer/id #uuid "30581ac3-3680-576a-98db-60203c870b03" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-86327/selection/c0604a86cfd857bc489253f78a41d2e71ce7c6f6c7bd728e03e271ea75d6c980" :answer/id #uuid "c26af037-0bda-5ae8-a3aa-492c7619fd75" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-86327/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "6ae9745d-5caf-5f4a-93ba-4d8b757f18ad" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-86327/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "9cc6ef1b-2a5f-57e5-9a4c-d4007394811f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-86327/selection/8a135ace4937b1ffa2c52fbce040999428005f5395e9d793e225144a0384a1ba" :answer/id #uuid "ad6c4101-dd25-582a-bd72-a