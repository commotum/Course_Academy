=4+\\text{i}$ and ${y}_{2}=4-\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})(y-{y}_{2}) & =2(y-(4+\\text{i}))(y-(4-\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(y-(4+\\text{i}))(y-(4-\\text{i})) & =2({y}^{2}-(4+\\text{i})y-(4-\\text{i})y+(4+\\text{i})(4-\\text{i})) \\\\  & =2({y}^{2}-(4+\\text{i}+4-\\text{i})y+({4}^{2}-{\\text{i}}^{2})) \\\\  & =2({y}^{2}-8y+(16+1)) \\\\  & =2{y}^{2}-16y+34.\\end{aligned}\n$$\n\nTherefore, $f(y)=2{y}^{2}-16y+34.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-46643/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4"] :knowledge-point/questions ["q-46643"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46670/selection/ead255934f7ea6369c80c21388e5e9b70807b856490361c7412f22426af3ea4d" :answer/id #uuid "d1d26f0c-9ed5-571c-9ccb-2c77d604a666" :answer/type :answer.type/math :answer/value "v-(-6+3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46670/selection/bede2d43e5806287f609f9061a0122f7330728357c550d11984404021638e1ea" :answer/id #uuid "bc3e76f7-aa5e-5ba9-b0a9-8fdcd4753b62" :answer/type :answer.type/math :answer/value "v-(6+2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46670/selection/8a6449d10c38dd66ae8d93821781a82052cb489fa474c807774f768fcd9c9b1f" :answer/id #uuid "c7f8a2ac-f699-5021-8617-9d93ad04b0c8" :answer/type :answer.type/math :answer/value "v-(6-3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46670/selection/b61bef3b6b72356d7581348b3847038824f4f9d77b37292803efcfbb16a23047" :answer/id #uuid "b1d898cb-d72a-58b7-8074-51dedad34dde" :answer/type :answer.type/math :answer/value "v-(2-6\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46670/selection/70aff4d88e368f3e690df6c13970ba260d8f1746701a6c350c09059409cb5eb3" :answer/id #uuid "fad84a9f-7290-5d5f-971f-3e5e1e0b7a16" :answer/type :answer.type/math :answer/value "v-(3-6\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46670/selection" :answer-field/id #uuid "9b0861cd-13d3-5f77-84e3-b00c97a3ed3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46670/selection/8a6449d10c38dd66ae8d93821781a82052cb489fa474c807774f768fcd9c9b1f" :answer-field/choices ["q-46670/selection/ead255934f7ea6369c80c21388e5e9b70807b856490361c7412f22426af3ea4d" "q-46670/selection/bede2d43e5806287f609f9061a0122f7330728357c550d11984404021638e1ea" "q-46670/selection/8a6449d10c38dd66ae8d93821781a82052cb489fa474c807774f768fcd9c9b1f" "q-46670/selection/b61bef3b6b72356d7581348b3847038824f4f9d77b37292803efcfbb16a23047" "q-46670/selection/70aff4d88e368f3e690df6c13970ba260d8f1746701a6c350c09059409cb5eb3"] :db/ensure [:answer-field/validate]} {:db/id "q-46670" :question/id #uuid "3374f4ce-1952-5ad1-8bea-6193ae4858d5" :question/math-academy-id "q-46670" :question/problem "Which of the following is a factor of $-{v}^{2}+12v-45?$" :question/worked-solution "First, we let $f(v)=-{v}^{2}+12v-45.$\n\nNext, we solve $f(v)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(v) & =0 \\\\ -{v}^{2}+12v-45 & =0 \\\\ {v}^{2}-12v+45 & =0 \\\\ ({v}^{2}-2\\cdot 6\\cdot v+{6}^{2})-{6}^{2}+45 & =0 \\\\ (v-6)^{2}-36+45 & =0 \\\\ (v-6)^{2}+9 & =0 \\\\ (v-6)^{2} & =-9 \\\\ (v-6)^{2} & =9{\\text{i}}^{2} \\\\ (v-6)^{2} & =(3\\text{i})^{2} \\\\ v-6 & =\\pm 3\\text{i} \\\\ v & =6\\pm 3\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${v}_{1}=6+3\\text{i}$ and ${v}_{2}=6-3\\text{i},$ and the coefficient of the quadratic term is $a=-1,$ the expression $-{v}^{2}+12v-45$ can be written as\n\n$$\n\\begin{aligned}-{v}^{2}+12v-45 & =a(v-{v}_{1})(v-{v}_{2}) \\\\  & =-(v-(6+3\\text{i}))(v-(6-3\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $v-(6-3\\text{i})$ is a factor of $-{v}^{2}+12v-45.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-46670/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-46670"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107523/selection/170001c2e911f864e41de7f690fdc6323fb6302ed72a84bf9a1bf98575e63d7d" :answer/id #uuid "4835ca44-f161-5b50-9ee7-8517e7df6f16" :answer/type :answer.type/math :answer/value "u-(3+2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107523/selection/93f918c1c0d9d8655e161854bb1353c22e5c73bdfdd9fa1f50724f03de9d1c2f" :answer/id #uuid "b3587d37-f7d2-5b1e-8197-d38b0f0bd639" :answer/type :answer.type/math :answer/value "u-(1-2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107523/selection/26254e574636374bb4862339b40bae80e6795a30d9d4f1943b678842458d5c9a" :answer/id #uuid "87a50535-3164-557c-aa2f-a283a606d3da" :answer/type :answer.type/math :answer/value "u-(1+4\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107523/selection/1df23c9102c50230c310b5db086d633714b732e69e080f5436f2b0df7d71b24f" :answer/id #uuid "8c348a10-98f0-5faa-9663-6e7c79d4d88e" :answer/type :answer.type/math :answer/value "u-(-1-2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107523/selection/266ef4b858d8ede07352ca00b2f312a606a9a91c6d3ff61ea827b459090f8550" :answer/id #uuid "7431a4cb-02fa-527e-b3af-ada42c76de1f" :answer/type :answer.type/math :answer/value "u-(2+\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107523/selection" :answer-field/id #uuid "f8c2880a-2437-59fa-ab3d-2a81bcf544f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107523/selection/93f918c1c0d9d8655e161854bb1353c22e5c73bdfdd9fa1f50724f03de9d1c2f" :answer-field/choices ["q-107523/selection/170001c2e911f864e41de7f690fdc6323fb6302ed72a84bf9a1bf98575e63d7d" "q-107523/selection/93f918c1c0d9d8655e161854bb1353c22e5c73bdfdd9fa1f50724f03de9d1c2f" "q-107523/selection/26254e574636374bb4862339b40bae80e6795a30d9d4f1943b678842458d5c9a" "q-107523/selection/1df23c9102c50230c310b5db086d633714b732e69e080f5436f2b0df7d71b24f" "q-107523/selection/266ef4b858d8ede07352ca00b2f312a606a9a91c6d3ff61ea827b459090f8550"] :db/ensure [:answer-field/validate]} {:db/id "q-107523" :question/id #uuid "54ac6bbc-3ef6-59e6-9f7d-2343e7a4c075" :question/math-academy-id "q-107523" :question/problem "Which of the following is a factor of ${u}^{2}-2u+5?$" :question/worked-solution "First, we let $f(u)={u}^{2}-2u+5.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+5 & =0 \\\\ ({u}^{2}-2\\cdot u+{1}^{2})-{1}^{2}+5 & =0 \\\\ (u-1)^{2}+4 & =0 \\\\ (u-1)^{2} & =-4 \\\\ (u-1)^{2} & =4{\\text{i}}^{2} \\\\ (u-1)^{2} & =(2\\text{i})^{2} \\\\ u-1 & =\\pm 2\\text{i} \\\\ u & =1\\pm 2\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=1+2\\text{i}$ and ${u}_{2}=1-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-2u+5$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+5 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+2\\text{i}))(u-(1-2\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(1-2\\text{i})$ is a factor of ${u}^{2}-2u+5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107523/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-107523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46672/selection/833d30607609b18c7a171d4ed9bcbc08ba574acabad01a9c27c0bfebe0666f33" :answer/id #uuid "104a8a1d-914f-5fec-a54c-1b42dd75a6a3" :answer/type :answer.type/math :answer/value "3(x-(1-4\\text{i}))^{2}" :db/ensure [:answer/validate]} {:db/id "q-46672/selection/e98393d1de0488228c0b10fa43865d20f51452d9c6c38d91e6d1642c344a248c" :answer/id #uuid "0f8aadcf-1d49-56f0-8793-46fc6c7b171e" :answer/type :answer.type/math :answer/value "(x-(2+3\\text{i}))^{2}" :db/ensure [:answer/validate]} {:db/id "q-46672/selection/0adc83dafcae718745ee569a680aafda61b0bf531ff37baec71273dbab95bdef" :answer/id #uuid "b5f3f1fb-b085-59ab-8672-5ce1df5683b2" :answer/type :answer.type/math :answer/value "3(x-(2+3\\text{i}))(x-(2-3\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46672/selection/34e56608e66ab46fb276751db78c106654268abff8beedb4d58bf0ef1a4069b0" :answer/id #uuid "ef55662c-fef4-5517-bcf5-adc6cb4a82e5" :answer/type :answer.type/math :answer/value "3(x-(1+4\\text{i}))(x-(1-4\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46672/selection/c3de5e2eccf75c28f4c409f9191e1b9f2648cdf445d6e99718b9204fe2b68ea4" :answer/id #uuid "0d564a8f-0bad-5830-9e33-207ab0e9a989" :answer/type :answer.type/math :answer/value "(x-(2+4\\text{i}))(x-(2-4\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46672/selection" :answer-field/id #uuid "4dbd820d-7173-55ae-845d-fb82e878812d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46672/selection/34e56608e66ab46fb276751db78c106654268abff8beedb4d58bf0ef1a4069b0" :answer-field/choices ["q-46672/selection/833d30607609b18c7a171d4ed9bcbc08ba574acabad01a9c27c0bfebe0666f33" "q-46672/selection/e98393d1de0488228c0b10fa43865d20f51452d9c6c38d91e6d1642c344a248c" "q-46672/selection/0adc83dafcae718745ee569a680aafda61b0bf531ff37baec71273dbab95bdef" "q-46672/selection/34e56608e66ab46fb276751db78c106654268abff8beedb4d58bf0ef1a4069b0" "q-46672/selection/c3de5e2eccf75c28f4c409f9191e1b9f2648cdf445d6e99718b9204fe2b68ea4"] :db/ensure [:answer-field/validate]} {:db/id "q-46672" :question/id #uuid "01b29fe9-9e4f-5dce-9d74-0d46f38589ca" :question/math-academy-id "q-46672" :question/problem "Factor $3{x}^{2}-6x+51.$" :question/worked-solution "First, we let $f(x)=3{x}^{2}-6x+51.$\n\nNext, we solve $f(x)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ 3{x}^{2}-6x+51 & =0 \\\\ {x}^{2}-2x+17 & =0 \\\\ ({x}^{2}-2\\cdot 1\\cdot x+{1}^{2})-{1}^{2}+17 & =0 \\\\ (x-1)^{2}-1+17 & =0 \\\\ (x-1)^{2}+16 & =0 \\\\ (x-1)^{2} & =-16 \\\\ (x-1)^{2} & =16{\\text{i}}^{2} \\\\ (x-1)^{2} & =(4\\text{i})^{2} \\\\ x-1 & =\\pm 4\\text{i} \\\\ x & =1\\pm 4\\text{i}\\end{aligned}\n$$\n\nNow, since our quadratic equation has roots ${x}_{1}=1+4\\text{i}$ and ${x}_{2}=1-4\\text{i},$ and the coefficient of the quadratic term is $a=3,$ the expression $3{x}^{2}-6x+51$ can be written as\n\n$$\n\\begin{aligned}3{x}^{2}-6x+51 & =a(x-{x}_{1})(x-{x}_{2}) \\\\  & =3(x-(1+4\\text{i}))(x-(1-4\\text{i})).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-46672/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-46672"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107697/selection/dc0215fc20cfa48d0d9c246fd7a269080d9bba07a71648b34e939d117de343d6" :answer/id #uuid "c41e3ad7-f79c-5cdc-98bb-34231a074db7" :answer/type :answer.type/math :answer/value "z-(3-4\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107697/selection/71af21e9f1b34b8dedf08c965cc790c865c2e3f8f5d1677c254091a5d3e8afcb" :answer/id #uuid "93326644-a9d0-528c-b9bd-403724c83c65" :answer/type :answer.type/math :answer/value "z-(4-3\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107697/selection/dd3d02be33475d028b97ba44ad2a48499efe017702f3972b3fd8254a5e9f6bcb" :answer/id #uuid "a5890693-f8ae-55e3-88ab-ac6fb4664e81" :answer/type :answer.type/math :answer/value "z-(2-\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107697/selection/a375d9ac490c6e9b5dac747bd83302f97a2c39d1704f47e60a3fb1e8f2b7309f" :answer/id #uuid "f5ac2d53-6247-548f-bef7-64fa1597a103" :answer/type :answer.type/math :answer/value "z-(1-2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107697/selection/6569bfaf9a76031126ccc851b5862f00acdee278129590961f63e52ca26a8981" :answer/id #uuid "2aa0bb31-c2a9-5c48-abc1-add25d189cbc" :answer/type :answer.type/math :answer/value "z-(7-2\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-107697/selection" :answer-field/id #uuid "215810b0-7b45-5570-84cf-4a000433f309" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107697/selection/71af21e9f1b34b8dedf08c965cc790c865c2e3f8f5d1677c254091a5d3e8afcb" :answer-field/choices ["q-107697/selection/dc0215fc20cfa48d0d9c246fd7a269080d9bba07a71648b34e939d117de343d6" "q-107697/selection/71af21e9f1b34b8dedf08c965cc790c865c2e3f8f5d1677c254091a5d3e8afcb" "q-107697/selection/dd3d02be33475d028b97ba44ad2a48499efe017702f3972b3fd8254a5e9f6bcb" "q-107697/selection/a375d9ac490c6e9b5dac747bd83302f97a2c39d1704f47e60a3fb1e8f2b7309f" "q-107697/selection/6569bfaf9a76031126ccc851b5862f00acdee278129590961f63e52ca26a8981"] :db/ensure [:answer-field/validate]} {:db/id "q-107697" :question/id #uuid "eb1c77ee-2f79-5f32-b270-cdcc5ae525de" :question/math-academy-id "q-107697" :question/problem "Which of the following is a factor of $3{z}^{2}-24z+75?$" :question/worked-solution "First, we let $f(z)=3{z}^{2}-24z+75.$\n\nNext, we solve $f(z)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(z) & =0 \\\\ 3{z}^{2}-24z+75 & =0 \\\\ {z}^{2}-8z+25 & =0 \\\\ ({z}^{2}-2\\cdot 4\\cdot z+{4}^{2})-{4}^{2}+25 & =0 \\\\ (z-4)^{2}-16+25 & =0 \\\\ (z-4)^{2}+9 & =0 \\\\ (z-4)^{2} & =-9 \\\\ (z-4)^{2} & =9{\\text{i}}^{2} \\\\ (z-4)^{2} & =(3\\text{i})^{2} \\\\ z-4 & =\\pm 3\\text{i} \\\\ z & =4\\pm 3\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${z}_{1}=4+3\\text{i}$ and ${z}_{2}=4-3\\text{i},$ and the coefficient of the quadratic term is $a=3,$ the expression $3{z}^{2}-24z+75$ can be written as\n\n$$\n\\begin{aligned}3{z}^{2}-24z+75 & =a(z-{z}_{1})(z-{z}_{2}) \\\\  & =3(z-(4+3\\text{i}))(z-(4-3\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $z-(4-3\\text{i})$ is a factor of $3{z}^{2}-24z+75.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107697/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-107697"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46451/selection/1da87fb309eb4f3ad17864061e6503834c74d3c25143ff274bd4f18fc84d482e" :answer/id #uuid "336bb7eb-a0a9-5f75-a472-668e4f091cd7" :answer/type :answer.type/math :answer/value "(x-(1+2\\text{i}))(x-(1-2\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46451/selection/ef168aa9be16080f28540d29f12db51f84d9f37331629c937c8a04feac0e97b4" :answer/id #uuid "4fa62155-2320-5503-bb5b-05933f4c2c07" :answer/type :answer.type/math :answer/value "(x-(1-\\text{i}))^{2}" :db/ensure [:answer/validate]} {:db/id "q-46451/selection/c55a95e4d04c633bd75e8161a7149bdaa43012014d1b2bf8e7f26c99bc24f9fe" :answer/id #uuid "f7caa5a0-9fb9-544d-a54a-d424d61a0a65" :answer/type :answer.type/math :answer/value "(x-(2+\\text{i}))(x-(2-\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46451/selection/8c1514df7e3f9f424df78a6319cc65a3f162627d3bab39eceff79aceace45037" :answer/id #uuid "ca3ff40b-3f47-5087-b7d3-5b0eff9368fa" :answer/type :answer.type/math :answer/value "(x-(1+\\text{i}))^{2}" :db/ensure [:answer/validate]} {:db/id "q-46451/selection/c58437e6bd41cbd57c08ecae89e98f832723d995f1485ecbb878dfc0afe2bc5b" :answer/id #uuid "ab387316-d524-50fb-be1a-f59c07d27adc" :answer/type :answer.type/math :answer/value "(x-(1+\\text{i}))(x-(1-\\text{i}))" :db/ensure [:answer/validate]} {:db/id "q-46451/selection" :answer-field/id #uuid "71596157-6620-5f49-b7f0-3a38727b166d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46451/selection/c58437e6bd41cbd57c08ecae89e98f832723d995f1485ecbb878dfc0afe2bc5b" :answer-field/choices ["q-46451/selection/1da87fb309eb4f3ad17864061e6503834c74d3c25143ff274bd4f18fc84d482e" "q-46451/selection/ef168aa9be16080f28540d29f12db51f84d9f37331629c937c8a04feac0e97b4" "q-46451/selection/c55a95e4d04c633bd75e8161a7149bdaa43012014d1b2bf8e7f26c99bc24f9fe" "q-46451/selection/8c1514df7e3f9f424df78a6319cc65a3f162627d3bab39eceff79aceace45037" "q-46451/selection/c58437e6bd41cbd57c08ecae89e98f832723d995f1485ecbb878dfc0afe2bc5b"] :db/ensure [:answer-field/validate]} {:db/id "q-46451" :question/id #uuid "a03cbc43-a73d-597f-8992-1a873a7a2e15" :question/math-academy-id "q-46451" :question/problem "Factor ${x}^{2}-2x+2.$" :question/worked-solution "First, we let $f(x)={x}^{2}-2x+2.$\n\nNext, we solve $f(x)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ {x}^{2}-2x+2 & =0 \\\\ ({x}^{2}-2\\cdot 1\\cdot x+{1}^{2})-{1}^{2}+2 & =0 \\\\ (x-1)^{2}-1+2 & =0 \\\\ (x-1)^{2}+1 & =0 \\\\ (x-1)^{2} & =-1 \\\\ (x-1)^{2} & ={\\text{i}}^{2} \\\\ x-1 & =\\pm \\text{i} \\\\ x & =1\\pm \\text{i}\\end{aligned}\n$$\n\nNow, since our quadratic equation has roots ${x}_{1}=1+\\text{i}$ and ${x}_{2}=1-\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${x}^{2}-2x+2$ can be written as\n\n$$\n\\begin{aligned}{x}^{2}-2x+2 & =a(x-{x}_{1})(x-{x}_{2}) \\\\  & =(x-(1+\\text{i}))(x-(1-\\text{i})).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-46451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-46451"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5887"] :question/problem "The quadratic polynomial $P(x)$ has roots $x_1=2, x_2=5,$ and the coefficient of the quadratic term is $3.$ Find $P(x).$" :question/worked-solution "Since our quadratic polynomial has roots ${\\color{black}x_1=2}$ and ${\\color{black}x_2=5},$ and the coefficient of the quadratic term is ${\\color{black}a=3},$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2}) & =3(x-2)(x-5) \\\\  & =3(x-2)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3(x-2)(x-5) & =3({x}^{2}-7x+10) \\\\  & =3{x}^{2}-21x+30.\\end{aligned}\n$$\n\nTherefore, $P(x) = 3x^2-21x+30.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5788"] :question/problem "The quadratic polynomial $P(x)$ has the double root $x_1=x_2=5,$ and the coefficient of the quadratic term is $a=1.$ Find $P(x).$" :question/worked-solution "Since our quadratic polynomial has the double root ${\\color{black}x_1=x_2=5},$ and the coefficient of the quadratic term is ${\\color{black}a=1},$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})^{2} & =1\\cdot {(x-5)}^{2} \\\\  & ={(x-5)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}{(x-5)}^{2} & ={x}^{2}-10x+25.\\end{aligned}\n$$\n\nTherefore, $P(x) = x^2 - 10x+25.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5789"] :question/problem "The quadratic polynomial $f(z)$ with real coefficients has roots $z_1=3+\\textrm{i}$ and $z_2=3-\\textrm{i},$ and the coefficient of the quadratic term is $2.$ Find $f(z).$" :question/worked-solution "Since our quadratic polynomial has roots ${\\color{black}z_1=3+\\textrm{i}}$ and ${\\color{black}z_2=3-\\textrm{i}},$ and the coefficient of the quadratic term is ${\\color{black}a=2},$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =2(z-(3+\\text{i}))(z-(3-\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(z-(3+\\text{i}))(z-(3-\\text{i})) & =2({z}^{2}-(3+\\text{i})z-(3-\\text{i})z+(3+\\text{i})(3-\\text{i})) \\\\  & =2({z}^{2}-(3+\\text{i}+3-\\text{i})z+({3}^{2}-{\\text{i}}^{2})) \\\\  & =2({z}^{2}-6z+(9+1)) \\\\  & =2({z}^{2}-6z+10) \\\\  & =2{z}^{2}-12z+20.\\end{aligned}\n$$\n\nTherefore, $f(z) = 2z^2-12z+20.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5791"] :question/problem "Factor $u^2-2u+10.$" :question/worked-solution "First, we let $f(u) = u^2-2u+10.$\n\nNext, we solve $f(u) = 0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+10 & =0 \\\\ ({u}^{2}-2u+{1}^{2})-{1}^{2}+10 & =0 \\\\ (u-1)^{2}-1+10 & =0 \\\\ (u-1)^{2}+9 & =0 \\\\ (u-1)^{2} & =-9 \\\\ (u-1)^{2} & =9{\\text{i}}^{2} \\\\ (u-1)^{2} & =(3\\text{i})^{2} \\\\ u-1 & =\\pm 3\\text{i} \\\\ u & =1\\pm 3\\text{i}\\end{aligned}\n$$\n\nNow, since our quadratic equation has roots $u_1=1+ 3\\textrm{i}$ and $u_2=1- 3\\textrm{i},$ and the coefficient of the quadratic term is $a=1,$ the expression $u^2-2u+10$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+10 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+3\\text{i}))(u-(1-3\\text{i})).\\end{aligned}\n$$" :db/ensure [:question/validate]}]
