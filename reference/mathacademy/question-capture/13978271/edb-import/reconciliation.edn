{1})^{2} & =(-9){(x-3)}^{2} \\\\  & =-9(x-3)^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-9(x-3)^{2} & =-9({x}^{2}-6x+9) \\\\  & =-9{x}^{2}+54x-81.\\end{aligned}\n$$\n\nTherefore, $P(x)=-9{x}^{2}+54x-81.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-282084" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282084" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-9x^2+54x-81"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46590" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=-5,$ and the coefficient of the quadratic term is $a=-2.$ Find $P(y).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46590" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=-5,$ and the coefficient of the quadratic term is $a=-2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =(-2){(y-(-5))}^{2} \\\\  & =(-2){(y+5)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(-2){(y+5)}^{2} & =(-2)({y}^{2}+10y+25) \\\\  & =-2{y}^{2}-20y-50.\\end{aligned}\n$$\n\nTherefore, $P(y)=-2{y}^{2}-20y-50.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46590" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46590" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46590" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{y}^{2}+10y-50"] ["math" "-2{y}^{2}+20y+50"] ["math" "-2{y}^{2}+20y-50"] ["math" "-2{y}^{2}-10y+50"] ["math" "-2{y}^{2}-20y-50"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46590" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2{y}^{2}-20y-50"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282122" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $P(x)$ has the double root ${x}_{1}={x}_{2}=-4,$ and the coefficient of the quadratic term is $a=16.$ Find $P(x).$\n\n$P(x)=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282122" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has the double root ${x}_{1}={x}_{2}=-4,$ and the coefficient of the quadratic term is $a=16,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})^{2} & =16{(x-(-4))}^{2} \\\\  & =16(x+4)^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}16(x+4)^{2} & =16({x}^{2}+8x+16) \\\\  & =16{x}^{2}+128x+256.\\end{aligned}\n$$\n\nTherefore, $P(x)=16{x}^{2}+128x+256.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282122" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-282122" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-282122" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "16x^2+128x+256"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46594" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $f(z)$ has real coefficients, has roots ${z}_{1}=2\\text{i}$ and ${z}_{2}=-2\\text{i},$ and the coefficient of the quadratic term is $1.$ Find $f(z).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46594" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has roots ${z}_{1}=2\\text{i}$ and ${z}_{2}=-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =(1)(z-2\\text{i})(z-(-2\\text{i})) \\\\  & =(z-2\\text{i})(z+2\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(z-2\\text{i})(z+2\\text{i}) & ={z}^{2}-(2\\text{i})^{2} \\\\  & ={z}^{2}-4{\\text{i}}^{2} \\\\  & ={z}^{2}+4.\\end{aligned}\n$$\n\nTherefore, $f(z)={z}^{2}+4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46594" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46594" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46594" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{z}^{2}+1"] ["math" "{z}^{2}+2"] ["math" "{z}^{2}+4"] ["math" "{z}^{2}-2"] ["math" "{z}^{2}-4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46594" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{z}^{2}+4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-28185" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $f(x)$ has real coefficients, has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $1.$ Find $f(x).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-28185" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2}) & =(1)(x-6\\text{i})(x-(-6\\text{i})) \\\\  & =(x-6\\text{i})(x+6\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-6\\text{i})(x+6\\text{i}) & ={x}^{2}-(6\\text{i})^{2} \\\\  & ={x}^{2}-36{\\text{i}}^{2} \\\\  & ={x}^{2}+36.\\end{aligned}\n$$\n\nTherefore, $f(x)={x}^{2}+36.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-28185" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-28185" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-28185" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{x}^{2}+36"] ["math" "{x}^{2}+6"] ["math" "{x}^{2}+6x"] ["math" "{x}^{2}-16"] ["math" "{x}^{2}-36"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-28185" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{x}^{2}+36"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46596" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $f(z)$ has real coefficients, has roots ${z}_{1}=4\\text{i}$ and ${z}_{2}=-4\\text{i},$ and the coefficient of the quadratic term is $-1.$ Find $f(z).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46596" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has roots ${z}_{1}=4\\text{i}$ and ${z}_{2}=-4\\text{i},$ and the coefficient of the quadratic term is $a=-1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =(-1)(z-4\\text{i})(z-(-4\\text{i})) \\\\  & =-(z-4\\text{i})(z+4\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-(z-4\\text{i})(z+4\\text{i}) & =-({z}^{2}-(4\\text{i})^{2}) \\\\  & =-({z}^{2}-16{\\text{i}}^{2}) \\\\  & =-({z}^{2}+16) \\\\  & =-{z}^{2}-16.\\end{aligned}\n$$\n\nTherefore, $f(z)=-{z}^{2}-16.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46596" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46596" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46596" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-{z}^{2}+16"] ["math" "-{z}^{2}+4"] ["math" "-{z}^{2}-16"] ["math" "-{z}^{2}-4"] ["math" "-{z}^{2}-8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46596" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-{z}^{2}-16"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46664" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $f(z)$ has real coefficients, has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $-2.$ Find $f(z).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46664" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $a=-2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i})) & =(-2)({z}^{2}-(3+2\\text{i})z-(3-2\\text{i})z+(3+2\\text{i})(3-2\\text{i})) \\\\  & =(-2)({z}^{2}-(3+2\\text{i}+3-2\\text{i})z+({3}^{2}-{2}^{2}{\\text{i}}^{2})) \\\\  & =(-2)({z}^{2}-6z+(9+4)) \\\\  & =-2{z}^{2}+12z-26.\\end{aligned}\n$$\n\nTherefore, $f(z)=-2{z}^{2}+12z-26.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46664" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46664" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46664" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{z}^{2}+12z-26"] ["math" "-2{z}^{2}+12z-5"] ["math" "-2{z}^{2}+6z-13"] ["math" "2{z}^{2}-12z-13"] ["math" "2{z}^{2}-6z+9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46664" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2{z}^{2}+12z-26"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46643" "field" nil "attribute" "question/problem" "value" "The quadratic polynomial $f(y)$ has real coefficients, has roots ${y}_{1}=4+\\text{i}$ and ${y}_{2}=4-\\text{i},$ and the coefficient of the quadratic term is $2.$ Find $f(y).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46643" "field" nil "attribute" "question/worked-solution" "value" "Since our quadratic polynomial has roots ${y}_{1}=4+\\text{i}$ and ${y}_{2}=4-\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})(y-{y}_{2}) & =2(y-(4+\\text{i}))(y-(4-\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(y-(4+\\text{i}))(y-(4-\\text{i})) & =2({y}^{2}-(4+\\text{i})y-(4-\\text{i})y+(4+\\text{i})(4-\\text{i})) \\\\  & =2({y}^{2}-(4+\\text{i}+4-\\text{i})y+({4}^{2}-{\\text{i}}^{2})) \\\\  & =2({y}^{2}-8y+(16+1)) \\\\  & =2{y}^{2}-16y+34.\\end{aligned}\n$$\n\nTherefore, $f(y)=2{y}^{2}-16y+34.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46643" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46643" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46643" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{y}^{2}+16y-34"] ["math" "2{y}^{2}+8y-17"] ["math" "2{y}^{2}-12y+16"] ["math" "2{y}^{2}-16y+34"] ["math" "2{y}^{2}-8y+17"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46643" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2{y}^{2}-16y+34"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46670" "field" nil "attribute" "question/problem" "value" "Which of the following is a factor of $-{v}^{2}+12v-45?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46670" "field" nil "attribute" "question/worked-solution" "value" "First, we let $f(v)=-{v}^{2}+12v-45.$\n\nNext, we solve $f(v)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(v) & =0 \\\\ -{v}^{2}+12v-45 & =0 \\\\ {v}^{2}-12v+45 & =0 \\\\ ({v}^{2}-2\\cdot 6\\cdot v+{6}^{2})-{6}^{2}+45 & =0 \\\\ (v-6)^{2}-36+45 & =0 \\\\ (v-6)^{2}+9 & =0 \\\\ (v-6)^{2} & =-9 \\\\ (v-6)^{2} & =9{\\text{i}}^{2} \\\\ (v-6)^{2} & =(3\\text{i})^{2} \\\\ v-6 & =\\pm 3\\text{i} \\\\ v & =6\\pm 3\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${v}_{1}=6+3\\text{i}$ and ${v}_{2}=6-3\\text{i},$ and the coefficient of the quadratic term is $a=-1,$ the expression $-{v}^{2}+12v-45$ can be written as\n\n$$\n\\begin{aligned}-{v}^{2}+12v-45 & =a(v-{v}_{1})(v-{v}_{2}) \\\\  & =-(v-(6+3\\text{i}))(v-(6-3\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $v-(6-3\\text{i})$ is a factor of $-{v}^{2}+12v-45.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46670" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46670" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46670" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v-(-6+3\\text{i})"] ["math" "v-(2-6\\text{i})"] ["math" "v-(3-6\\text{i})"] ["math" "v-(6+2\\text{i})"] ["math" "v-(6-3\\text{i})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46670" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v-(6-3\\text{i})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-107523" "field" nil "attribute" "question/problem" "value" "Which of the following is a factor of ${u}^{2}-2u+5?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-107523" "field" nil "attribute" "question/worked-solution" "value" "First, we let $f(u)={u}^{2}-2u+5.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+5 & =0 \\\\ ({u}^{2}-2\\cdot u+{1}^{2})-{1}^{2}+5 & =0 \\\\ (u-1)^{2}+4 & =0 \\\\ (u-1)^{2} & =-4 \\\\ (u-1)^{2} & =4{\\text{i}}^{2} \\\\ (u-1)^{2} & =(2\\text{i})^{2} \\\\ u-1 & =\\pm 2\\text{i} \\\\ u & =1\\pm 2\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=1+2\\text{i}$ and ${u}_{2}=1-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-2u+5$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+5 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+2\\text{i}))(u-(1-2\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(1-2\\text{i})$ is a factor of ${u}^{2}-2u+5.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-107523" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-107523" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-107523" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "u-(-1-2\\text{i})"] ["math" "u-(1+4\\text{i})"] ["math" "u-(1-2\\text{i})"] ["math" "u-(2+\\text{i})"] ["math" "u-(3+2\\text{i})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-107523" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "u-(1-2\\text{i})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46672" "field" nil "attribute" "question/problem" "value" "Factor $3{x}^{2}-6x+51.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46672" "field" nil "attribute" "question/worked-solution" "value" "First, we let $f(x)=3{x}^{2}-6x+51.$\n\nNext, we solve $f(x)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(x) & =0 \\\\ 3{x}^{2}-6x+51 & =0 \\\\ {x}^{2}-2x+17 & =0 \\\\ ({x}^{2}-2\\cdot 1\\cdot x+{1}^{2})-{1}^{2}+17 & =0 \\\\ (x-1)^{2}-1+17 & =0 \\\\ (x-1)^{2}+16 & =0 \\\\ (x-1)^{2} & =-16 \\\\ (x-1)^{2} & =16{\\text{i}}^{2} \\\\ (x-1)^{2} & =(4\\text{i})^{2} \\\\ x-1 & =\\pm 4\\text{i} \\\\ x & =1\\pm 4\\text{i}\\end{aligned}\n$$\n\nNow, since our quadratic equation has roots ${x}_{1}=1+4\\text{i}$ and ${x}_{2}=1-4\\text{i},$ and the coefficient of the quadratic term is $a=3,$ the expression $3{x}^{2}-6x+51$ can be written as\n\n$$\n\\begin{aligned}3{x}^{2}-6x+51 & =a(x-{x}_{1})(x-{x}_{2}) \\\\  & =3(x-(1+4\\text{i}))(x-(1-4\\text{i})).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46672" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/activity-metadata.json" "file_sha256" "b5249e85559078f26c03fd1d18978af91e5b5d3949241672908e5669e9f03810"} {"question" "q-46672" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978271/state.json" "file_sha256" "e99e67c90250f5f2eb3368f47def0dcb4fd2f55f79e091252616f4107a2cf5cd"} {"question" "q-46672" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(x-(2+3\\text{i}))^{2}"] ["ma