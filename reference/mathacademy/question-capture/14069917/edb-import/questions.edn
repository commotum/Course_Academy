h} :answer/value "0.256" :db/id #edb/ref 17592186156093}] :answer-field/correct {:answer/id #uuid "f9217b0f-36e7-576b-baa5-3dc11ddb933d" :answer/type {:db/ident :answer.type/math} :answer/value "0.386" :db/id #edb/ref 17592186156091} :answer-field/id #uuid "fccc9093-1723-56de-9a19-0f51d081ae25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186156088}] :question/id #uuid "e514b918-4398-5659-aea4-5302218a0592" :question/math-academy-id "q-85276" :question/problem "> A scientific calculator is required to answer this question.\n\nA writer is editing the first draft of a book. On average, each sentence has a $15%$ chance of having a typo. What is the probability of finding the next typo within the first $3$ sentences since the previous typo? Round your answer to $3$ decimal places." :question/requires-calculator true}] [{:db/id #edb/ref 17592186157808 :knowledge-point/_questions [{:knowledge-point/id #uuid "42f47d95-9f20-5488-98c4-cb80278a7cf3" :knowledge-point/title "Computing the Probability of a Geometric Random Variable on an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a36d8650-e079-5e5a-874d-98ff47bf4417" :answer/type {:db/ident :answer.type/math} :answer/value "0.773" :db/id #edb/ref 17592186156101} {:answer/id #uuid "e440efb7-68f8-567a-8676-78254840c1a3" :answer/type {:db/ident :answer.type/math} :answer/value "0.857" :db/id #edb/ref 17592186156102} {:answer/id #uuid "f620ba04-4529-5649-97f7-39801c298d15" :answer/type {:db/ident :answer.type/math} :answer/value "0.702" :db/id #edb/ref 17592186156103} {:answer/id #uuid "f7ff8a63-c6a9-5563-afbf-8117a334bd74" :answer/type {:db/ident :answer.type/math} :answer/value "0.751" :db/id #edb/ref 17592186156104} {:answer/id #uuid "351d47e7-e2d4-537d-a08a-7c368af4ac4a" :answer/type {:db/ident :answer.type/math} :answer/value "0.825" :db/id #edb/ref 17592186156105}] :answer-field/correct {:answer/id #uuid "e440efb7-68f8-