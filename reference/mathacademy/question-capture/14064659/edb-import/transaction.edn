[{:db/id "q-83187/selection/f760f88eeb4f5ffb96e2ee426ae58025436b7b935135fca2c06c2dc07a3351da" :answer/id #uuid "1fc33040-bc15-5feb-98e8-2e5b2f664b87" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{3}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{60}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83187/selection/ab70296ff518486051e802ac26180fa223a03fdf5c774d7093243ab0243fe66f" :answer/id #uuid "7908f2c6-b8ed-5e82-9996-3037a375175b" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{6}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{120}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83187/selection/5e3d35e2797c41f57e317f254d816c5543109af6c149fd10ea8de125aa0f26e5" :answer/id #uuid "250ceca8-2e7d-5403-bafb-76dc688f0cca" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{12}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{240}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83187/selection/f271c8ebaff5bea363792bc0ec67bb712ef632e381c2754c8e48d50a6ce66ba1" :answer/id #uuid "de477efe-d1e0-5a9d-8681-8ca9667d11f9" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{18}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{240}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83187/selection/243463417543a5c1687c95f0240738303479f1b8c9de9435700daf67331de3bb" :answer/id #uuid "74146c92-49ee-51db-963a-8f1483f0f15b" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{9}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{27}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83187/selection" :answer-field/id #uuid "d1beacd1-2256-5a17-8ccd-084c6881cd33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83187/selection/ab70296ff518486051e802ac26180fa223a03fdf5c774d7093243ab0243fe66f" :answer-field/choices ["q-83187/selection/f760f88eeb4f5ffb96e2ee426ae58025436b7b935135fca2c06c2dc07a3351da" "q-83187/selection/ab70296ff518486051e802ac26180fa223a03fdf5c774d7093243ab0243fe66f" "q-83187/selection/5e3d35e2797c41f57e317f254d816c5543109af6c149fd10ea8de125aa0f26e5" "q-83187/selection/f271c8ebaff5bea363792bc0ec67bb712ef632e381c2754c8e48d50a6ce66ba1" "q-83187/selection/243463417543a5c1687c95f0240738303479f1b8c9de9435700daf67331de3bb"] :db/ensure [:answer-field/validate]} {:db/id "q-83187" :question/id #uuid "16609029-055a-5cb8-ad13-f4db9797bcc6" :question/math-academy-id "q-83187" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{cos}⁡x$ centered about the point $x=\\frac{\\pi }{2}.$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{cos}⁡x$ and $a=\\frac{\\pi }{2}.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ f(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1 \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x \\\\ {f}^{″}(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{‴}(x) & =\\operatorname{sin}⁡x \\\\ {f}^{‴}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})=1 \\\\ {f}^{(4)}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{(4)}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{(5)}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{(5)}(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0+(-1)(x-\\frac{\\pi }{2})+\\frac{0}{2!}{(x-\\frac{\\pi }{2})}^{2} \\\\  & +\\frac{1}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{0}{4!}{(x-\\frac{\\pi }{2})}^{4}+\\frac{(-1)}{5!}{(x-\\frac{\\pi }{2})}^{5}+⋯ \\\\  & =-(x-\\frac{\\pi }{2})+\\frac{1}{6}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{120}{(x-\\frac{\\pi }{2})}^{5}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83187/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-83187"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126844/selection/c171cc2af30e98532c72a9b9bb9259bbafa7115070533ec07f6e10c71f7002bc" :answer/id #uuid "8d93082b-b7e1-5ccf-aafb-0b72e6794a8f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126844/selection/a23c3e231b6dbe47b42b39ba23b63edbb642eed231aeb4faa785e794b884533e" :answer/id #uuid "2404ea30-00a0-576d-a412-fcea9bc3d5a7" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{4}(x-2)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126844/selection/dc2ca9b2661cf4f56684318a465f5faeb9d871ad02746daf18a36237b4420eb7" :answer/id #uuid "51a922fa-288a-5183-8d2d-19d08fdd8402" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+(x-2)-\\frac{1}{3}(x-2)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126844/selection/d01f6fab86631ceb6f9b9fc6098cc48e6fb888c29ca67581bc7b9abd4566dc2e" :answer/id #uuid "84dd86fc-de64-5bfd-ad39-87b650c6e1e0" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-(x-2)+\\frac{1}{4}(x-2)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126844/selection/9956bc00263ed67c629e82e77397cea242ca58ad6c2679fdc4429609570c6022" :answer/id #uuid "eac5d35c-583c-5cd8-80d9-abb98ef110be" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-\\frac{1}{2}(x-2)^{2}+\\frac{1}{8}(x-2)^{4}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126844/selection" :answer-field/id #uuid "448fe74e-d1f7-583c-bc40-6390ba9bdee6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126844/selection/c171cc2af30e98532c72a9b9bb9259bbafa7115070533ec07f6e10c71f7002bc" :answer-field/choices ["q-126844/selection/c171cc2af30e98532c72a9b9bb9259bbafa7115070533ec07f6e10c71f7002bc" "q-126844/selection/a23c3e231b6dbe47b42b39ba23b63edbb642eed231aeb4faa785e794b884533e" "q-126844/selection/dc2ca9b2661cf4f56684318a465f5faeb9d871ad02746daf18a36237b4420eb7" "q-126844/selection/d01f6fab86631ceb6f9b9fc6098cc48e6fb888c29ca67581bc7b9abd4566dc2e" "q-126844/selection/9956bc00263ed67c629e82e77397cea242ca58ad6c2679fdc4429609570c6022"] :db/ensure [:answer-field/validate]} {:db/id "q-126844" :question/id #uuid "7b7eb3fc-d271-5f71-a892-30b0a27230ca" :question/math-academy-id "q-126844" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{ln}⁡(3x)$ about the point $x=2.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{ln}⁡(3x)$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(3x) \\\\ f(2) & =\\operatorname{ln}⁡(3\\cdot 2)=\\operatorname{ln}⁡6 \\\\ {f}^{′}(x) & =\\frac{1}{x} \\\\ {f}^{′}(2) & =\\frac{1}{2} \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{″}(2) & =-\\frac{1}{{2}^{2}}=-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(3x) & =\\operatorname{ln}⁡6+(\\frac{1}{2})(x-2)+\\frac{1}{2!}(-\\frac{1}{4})(x-2)^{2}+⋯ \\\\  & =\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126844/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-126844"] :db/ensure [:knowledge-point/validate]} {:db/id "q-347614/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "22820e9b-bd84-5f3e-abd7-cef8a3172d72" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-347614/field-1" :answer-field/id #uuid "87d877f6-cc92-51aa-b000-1e8f90032716" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347614/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-347614/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-347614/field-2/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "053eedb6-f960-5ac1-a65e-f3e7fa4d8a26" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-347614/field-2" :answer-field/id #uuid "f6703ed6-a312-5b8d-a9ba-9137ef9c355e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347614/field-2/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-347614/field-2/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-347614/field-3/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer/id #uuid "4115bc0f-5931-5264-865d-c2905db85b2f" :answer/type :answer.type/math :answer/value "\\frac{3}{16}" :db/ensure [:answer/validate]} {:db/id "q-347614/field-3" :answer-field/id #uuid "e9661ce6-503c-5b08-9ae7-3ca36a929843" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347614/field-3/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer-field/choices ["q-347614/field-3/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0"] :db/ensure [:answer-field/validate]} {:db/id "q-347614" :question/id #uuid "5ffe3b19-ff41-5d63-a19d-8b0f648f4bbc" :question/math-academy-id "q-347614" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\frac{1}{{x}^{2}}$ about the point $x=2.$\n\n$\\frac{1}{{x}^{2}}=${{field-1}}\n$-\\,$\n{{field-2}}\n$(x-2)\\,+\\,$\n{{field-3}}\n$(x-2)^{2}-⋯$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{{x}^{2}}$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}}={x}^{-2} \\\\ f(2) & ={2}^{-2}=\\frac{1}{4} \\\\ {f}^{′}(x) & =-\\frac{2}{{x}^{3}}=-2{x}^{-3} \\\\ {f}^{′}(2) & =-2(2)^{-3}=-\\frac{1}{4} \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{4}}=6{x}^{-4} \\\\ {f}^{″}(2) & =6(2)^{-4}=\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{2}} & =\\frac{1}{4}+(-\\frac{1}{4})(x-2)+\\frac{(\\frac{3}{8})}{2!}(x-2)^{2}+\\frac{(-\\frac{3}{4})}{3!}(x-2)^{3}+⋯ \\\\  & =\\frac{1}{4}-\\frac{1}{4}(x-2)+\\frac{3}{16}(x-2)^{2}-⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-347614/field-1" "q-347614/field-2" "q-347614/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-347614"] :db/ensure [:knowledge-point/validate]} {:db/id "q-354043/field-1/b3d3056b68a69913556ab2c6edf2df849c810f94ad8b95e45f51affe418b1ab0" :answer/id #uuid "5674f98c-dcd1-5e56-bf7c-123332fdb737" :answer/type :answer.type/math :answer/value "-1.4" :db/ensure [:answer/validate]} {:db/id "q-354043/field-1" :answer-field/id #uuid "7bf922a0-486f-57ea-bc50-3ce1f4895987" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-354043/field-1/b3d3056b68a69913556ab2c6edf2df849c810f94ad8b95e45f51affe418b1ab0" :answer-field/choices ["q-354043/field-1/b3d3056b68a69913556ab2c6edf2df849c810f94ad8b95e45f51affe418b1ab0"] :db/ensure [:answer-field/validate]} {:db/id "q-354043" :question/id #uuid "4e83ae35-68ee-5980-9c6a-1add762ce26e" :question/math-academy-id "q-354043" :question/problem "Use the first two non-zero terms of the Taylor expansion of $\\operatorname{cot}⁡x$ about $x=\\frac{3\\pi }{4}$ to approximate the value of $cot\\,(\\frac{3\\pi }{4}+0.2).$ Do not round the answer.\n\n$cot\\,(\\frac{3\\pi }{4}+0.2)≈$\n{{field-1}}" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)=\\operatorname{cot}⁡x$ and $a=\\frac{3\\pi }{4}.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cot}⁡x \\\\ f\\,(\\frac{3\\pi }{4}) & =cot\\,(\\frac{3\\pi }{4})=-1 \\\\ {f}^{′}(x) & =-{csc}^{2}⁡x \\\\ {f}^{′}\\,(\\frac{3\\pi }{4}) & =-{csc}^{2}\\,(\\frac{3\\pi }{4})=-2.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡x & =-1+(-2)(x-\\frac{3\\pi }{4})+⋯ \\\\  & =-1-2(x-\\frac{3\\pi }{4})+⋯.\\end{aligned}\n$$\n\nWe substitute $x=\\frac{3\\pi }{4}+0.2$ into the above to approximate $cot\\,(\\frac{3\\pi }{4}+0.2).$ We get\n\n$$\n\\begin{aligned}cot\\,(\\frac{3\\pi }{4}+0.2) & ≈-1-2(\\frac{3\\pi }{4}+0.2-\\frac{3\\pi }{4}) \\\\  & =-1-2(0.2) \\\\  & =-1-\\frac{2}{5} \\\\  & =-\\frac{7}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-354043/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3"] :knowledge-point/questions ["q-354043"] :db/ensure [:knowledge-point/validate]}]
