#{[{:db/id #edb/ref 17592186349320 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eac5d35c-583c-5cd8-80d9-abb98ef110be" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-\\frac{1}{2}(x-2)^{2}+\\frac{1}{8}(x-2)^{4}+⋯" :db/id #edb/ref 17592186349322} {:answer/id #uuid "2404ea30-00a0-576d-a412-fcea9bc3d5a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{4}(x-2)^{2}+⋯" :db/id #edb/ref 17592186349323} {:answer/id #uuid "8d93082b-b7e1-5ccf-aafb-0b72e6794a8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯" :db/id #edb/ref 17592186349324} {:answer/id #uuid "84dd86fc-de64-5bfd-ad39-87b650c6e1e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-(x-2)+\\frac{1}{4}(x-2)^{2}+⋯" :db/id #edb/ref 17592186349325} {:answer/id #uuid "51a922fa-288a-5183-8d2d-19d08fdd8402" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+(x-2)-\\frac{1}{3}(x-2)^{2}+⋯" :db/id #edb/ref 17592186349326}] :answer-field/correct {:answer/id #uuid "8d93082b-b7e1-5ccf-aafb-0b72e6794a8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯" :db/id #edb/ref 17592186349324} :answer-field/id #uuid "448fe74e-d1f7-583c-bc40-6390ba9bdee6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349321}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7b7eb3fc-d271-5f71-a892-30b0a27230ca" :question/math-academy-id "q-126844" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{ln}⁡(3x)$ about the point $x=2.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{ln}⁡(3x)$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(3x) \\\\ f(2) & =\\operatorname{ln}⁡(3\\cdot 2)=\\operatorname{ln}⁡6 \\\\ {f}^{′}(x) & =\\frac{1}{x} \\\\ {f}^{′}(2) & =\\frac{1}{2} \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{″}(2) & =-\\frac{1}{{2}^{2}}=-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(3x) & =\\operatorname{ln}⁡6+(\\frac{1}{2})(x-2)+\\frac{1}{2!}(-\\frac{1}{4})(x-2)^{2}+⋯ \\\\  & =\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186349327 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22820e9b-bd84-5f3e-abd7-cef8a3172d72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186349329}] :answer-field/correct {:answer/id #uuid "22820e9b-bd84-5f3e-abd7-cef8a3172d72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186349329} :answer-field/id #uuid "87d877f6-cc92-51aa-b000-1e8f90032716" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349328} {:answer-field/choices [{:answer/id #uuid "053eedb6-f960-5ac1-a65e-f3e7fa4d8a26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186349331}] :answer-field/correct {:answer/id #uuid "053eedb6-f960-5ac1-a65e-f3e7fa4d8a26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186349331} :answer-field/id #uuid "f6703ed6-a312-5b8d-a9ba-9137ef9c355e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349330} {:answer-field/choices [{:answer/id #uuid "4115bc0f-5931-5264-865d-c2905db85b2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186349333}] :answer-field/correct {:answer/id #uuid "4115bc0f-5931-5264-865d-c2905db85b2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186349333} :answer-field/id #uuid "e9661ce6-503c-5b08-9ae7-3ca36a929843" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349332}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5ffe3b19-ff41-5d63-a19d-8b0f648f4bbc" :question/math-academy-id "q-347614" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\frac{1}{{x}^{2}}$ about the point $x=2.$\n\n$\\frac{1}{{x}^{2}}=${{field-1}}\n$-\\,$\n{{field-2}}\n$(x-2)\\,+\\,$\n{{field-3}}\n$(x-2)^{2}-⋯$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{{x}^{2}}$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{2}}={x}^{-2} \\\\ f(2) & ={2}^{-2}=\\frac{1}{4} \\\\ {f}^{′}(x) & =-\\frac{2}{{x}^{3}}=-2{x}^{-3} \\\\ {f}^{′}(2) & =-2(2)^{-3}=-\\frac{1}{4} \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{4}}=6{x}^{-4} \\\\ {f}^{″}(2) & =6(2)^{-4}=\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{2}} & =\\frac{1}{4}+(-\\frac{1}{4})(x-2)+\\frac{(\\frac{3}{8})}{2!}(x-2)^{2}+\\frac{(-\\frac{3}{4})}{3!}(x-2)^{3}+⋯ \\\\  & =\\frac{1}{4}-\\frac{1}{4}(x-2)+\\frac{3}{16}(x-2)^{2}-⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186349334 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5674f98c-dcd1-5e56-bf7c-123332fdb737" :answer/type {:db/ident :answer.type/math} :answer/value "-1.4" :db/id #edb/ref 17592186349336}] :answer-field/correct {:answer/id #uuid "5674f98c-dcd1-5e56-bf7c-123332fdb737" :answer/type {:db/ident :answer.type/math} :answer/value "-1.4" :db/id #edb/ref 17592186349336} :answer-field/id #uuid "7bf922a0-486f-57ea-bc50-3ce1f4895987" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349335}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4e83ae35-68ee-5980-9c6a-1add762ce26e" :question/math-academy-id "q-354043" :question/problem "Use the first two non-zero terms of the Taylor expansion of $\\operatorname{cot}⁡x$ about $x=\\frac{3\\pi }{4}$ to approximate the value of $cot\\,(\\frac{3\\pi }{4}+0.2).$ Do not round the answer.\n\n$cot\\,(\\frac{3\\pi }{4}+0.2)≈$\n{{field-1}}" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)=\\operatorname{cot}⁡x$ and $a=\\frac{3\\pi }{4}.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cot}⁡x \\\\ f\\,(\\frac{3\\pi }{4}) & =cot\\,(\\frac{3\\pi }{4})=-1 \\\\ {f}^{′}(x) & =-{csc}^{2}⁡x \\\\ {f}^{′}\\,(\\frac{3\\pi }{4}) & =-{csc}^{2}\\,(\\frac{3\\pi }{4})=-2.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡x & =-1+(-2)(x-\\frac{3\\pi }{4})+⋯ \\\\  & =-1-2(x-\\frac{3\\pi }{4})+⋯.\\end{aligned}\n$$\n\nWe substitute $x=\\frac{3\\pi }{4}+0.2$ into the above to approximate $cot\\,(\\frac{3\\pi }{4}+0.2).$ We get\n\n$$\n\\begin{aligned}cot\\,(\\frac{3\\pi }{4}+0.2) & ≈-1-2(\\frac{3\\pi }{4}+0.2-\\frac{3\\pi }{4}) \\\\  & =-1-2(0.2) \\\\  & =-1-\\frac{2}{5} \\\\  & =-\\frac{7}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186349337 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74146c92-49ee-51db-963a-8f1483f0f15b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{9}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{27}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349339} {:answer/id #uuid "250ceca8-2e7d-5403-bafb-76dc688f0cca" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{12}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{240}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349340} {:answer/id #uuid "7908f2c6-b8ed-5e82-9996-3037a375175b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{6}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{120}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349341} {:answer/id #uuid "de477efe-d1e0-5a9d-8681-8ca9667d11f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{18}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{240}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349342} {:answer/id #uuid "1fc33040-bc15-5feb-98e8-2e5b2f664b87" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{3}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{60}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349343}] :answer-field/correct {:answer/id #uuid "7908f2c6-b8ed-5e82-9996-3037a375175b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x=-(x-\\frac{\\pi }{2})+\\frac{1}{6}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{120}{(x-\\frac{\\pi }{2})}^{5}+⋯" :db/id #edb/ref 17592186349341} :answer-field/id #uuid "d1beacd1-2256-5a17-8ccd-084c6881cd33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349338}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "16609029-055a-5cb8-ad13-f4db9797bcc6" :question/math-academy-id "q-83187" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{cos}⁡x$ centered about the point $x=\\frac{\\pi }{2}.$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{cos}⁡x$ and $a=\\frac{\\pi }{2}.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ f(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1 \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x \\\\ {f}^{″}(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{‴}(x) & =\\operatorname{sin}⁡x \\\\ {f}^{‴}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})=1 \\\\ {f}^{(4)}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{(4)}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ {f}^{(5)}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{(5)}(\\frac{\\pi }{2}) & =-\\operatorname{sin}⁡(\\frac{\\pi }{2})=-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0+(-1)(x-\\frac{\\pi }{2})+\\frac{0}{2!}{(x-\\frac{\\pi }{2})}^{2} \\\\  & +\\frac{1}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{0}{4!}{(x-\\frac{\\pi }{2})}^{4}+\\frac{(-1)}{5!}{(x-\\frac{\\pi }{2})}^{5}+⋯ \\\\  & =-(x-\\frac{\\pi }{2})+\\frac{1}{6}{(x-\\frac{\\pi }{2})}^{3}-\\frac{1}{120}{(x-\\frac{\\pi }{2})}^{5}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184826 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dcad847-55c5-54c9-978e-aab990d0c5ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16112" :db/id #edb/ref 17592186183846} {:answer/id #uuid "f1e420be-7458-5309-8fa6-53d19346dcfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16512" :db/id #edb/ref 17592186183847} {:answer/id #uuid "226bcbbc-cfb5-56a0-801f-07bdeefada77" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16197" :db/id #edb/ref 17592186183848} {:answer/id #uuid "343b2896-72d4-5135-9e03-fd07955dee6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16204" :db/id #edb/ref 17592186183849} {:answer/id #uuid "70bd5fc4-279e-5b7a-a253-acc7b5e9554c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16439" :db/id #edb/ref 17592186183850}] :answer-field/correct {:answer/id #uuid "343b2896-72d4-5135-9e03-fd07955dee6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10} \\approx 3.16204" :db/id #edb/ref 17592186183849} :answer-field/id #uuid "5dc495eb-3490-5a68-b1d6-e8a03d5ba5b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183845}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fa3dd46a-8d87-5019-a6c8-488757b3b77c" :question/math-academy-id "q-9608" :question/problem "Use the first three terms of the Taylor expansion for $f(x)=\\sqrt{x}$ about $x=9$ to approximate the value of $\\sqrt{10}.$ Give your answer to $5$ decimal places." :question/requires-calculator true :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=9.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/2} \\\\ f(9) & =3 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(9) & =\\frac{1}{6} \\\\ {f}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(9) & =-\\frac{1}{108}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =3+\\frac{1}{6}(x-9)+\\frac{1}{2!}(-\\frac{1}{108})(x-9)^{2}+⋯ \\\\  & =3+\\frac{1}{6}(x-9)-\\frac{1}{216}(x-9)^{2}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=10$ into the above to approximate $\\sqrt{10}.$ We get\n\n$$\n\\begin{aligned}\\sqrt{10} & ≈3+\\frac{1}{6}(10-9)-\\frac{1}{216}(10-9)^{2} \\\\  & =3+\\frac{1}{6}-\\frac{1}{216} \\\\  & =3.162\\,04,\\end{aligned}\n$$\n\nto five decimal places."}]}
