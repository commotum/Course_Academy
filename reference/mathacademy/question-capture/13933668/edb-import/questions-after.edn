#{[{:db/id #edb/ref 17592186246508 :knowledge-point/_questions [{:knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7f507ba-dbe0-5142-b4ff-7f369148875f" :answer/type {:db/ident :answer.type/math} :answer/value "60\\,480" :db/id #edb/ref 17592186246510} {:answer/id #uuid "1fb4d7eb-d7d1-5831-8ffa-48d536458e11" :answer/type {:db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186246511} {:answer/id #uuid "21df0986-cc9c-5e88-aaaa-552b3ad956ac" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186246512} {:answer/id #uuid "9138c366-eaf8-59d2-ba0f-f74d47ed896d" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,728" :db/id #edb/ref 17592186246513} {:answer/id #uuid "1371c80b-44d8-5dee-af8d-2b6076c63f42" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186246514}] :answer-field/correct {:answer/id #uuid "1fb4d7eb-d7d1-5831-8ffa-48d536458e11" :answer/type {:db/ident :answer.type/math} :answer/value "220" :db/id #edb/ref 17592186246511} :answer-field/id #uuid "8c848416-fa4b-5d60-837d-6c17b0c8b178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246509}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a1efbaef-38db-5b41-a2a3-7010a9c32c11" :question/is-example false :question/math-academy-id "q-122560" :question/problem "Claire has a bag of candies with $12$ assorted flavors. In how many ways can Claire pick $3$ flavors of candies?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $12$ flavors, so $n=12.$ We want to select $3$ of those flavors, so we have $r=3.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{12}{C}_{3} & =\\frac{12!}{(12-3)!\\,3!} \\\\  & =\\frac{12!}{9!3!} \\\\  & =\\frac{12\\cdot 11\\cdot 10\\cdot \\cancel{9!}}{\\cancel{9!}3!} \\\\  & =\\frac{12\\cdot 11\\cdot 10}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{1\\,320}{6} \\\\  & =220.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246515 :knowledge-point/_questions [{:knowledge-point/id #uuid "d22726fc-8e6b-5e22-80c8-fbc2aa245217" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8320cd8-1189-519f-bdae-4fad34e05f6e" :answer/type {:db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186246517} {:answer/id #uuid "ba31d0ec-cffb-5a55-9d7a-df3a6c23f6bc" :answer/type {:db/ident :answer.type/math} :answer/value "{100}^{5}" :db/id #edb/ref 17592186246518} {:answer/id #uuid "e8a318bf-d8f3-5090-a136-c3673db7ff97" :answer/type {:db/ident :answer.type/math} :answer/value "75\\,287\\,520" :db/id #edb/ref 17592186246519} {:answer/id #uuid "5703ad61-c051-505c-b4ad-8a7117a98363" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,034\\,502\\,400" :db/id #edb/ref 17592186246520} {:answer/id #uuid "9e0ea386-5e0f-59dc-8d67-e8a59be407e9" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186246521}] :answer-field/correct {:answer/id #uuid "e8a318bf-d8f3-5090-a136-c3673db7ff97" :answer/type {:db/ident :answer.type/math} :answer/value "75\\,287\\,520" :db/id #edb/ref 17592186246519} :answer-field/id #uuid "d23bb508-6c11-5d10-a042-339fc62e53fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246516}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f2c342ac-2557-5d89-81e6-2e3e4896aa52" :question/is-example false :question/math-academy-id "q-122566" :question/problem "While Tom was in an elevator within a 100-floor building, it stopped on $5$ different floors. If the order of the floors where the elevator stopped is unimportant, in how many different ways could the elevator stop?" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $100$ floors, so $n=100.$ We want to select $5$ of those floors for the elevator to stop, so we have $r=5.$\n\nTherefore, the number of choices is\n\n$$\n\\begin{aligned}{}_{100}{C}_{5} & =\\frac{100!}{(100-5)!\\,5!} \\\\  & =\\frac{100!}{95!5!} \\\\  & =\\frac{100\\cdot 99\\cdot 98\\cdot 97\\cdot 96\\cdot \\cancel{95!}}{\\cancel{95!}5!} \\\\  & =\\frac{100\\cdot 99\\cdot 98\\cdot 97\\cdot 96}{5\\cdot 4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{9\\,034\\,502\\,400}{120} \\\\  & =75\\,287\\,520.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246522 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fec85f-2eb9-5d0c-b916-0abe0dd0eb9f" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186246524} {:answer/id #uuid "4a611e1e-2470-5845-8d28-03775473805a" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186246525} {:answer/id #uuid "82726db1-7e42-55c0-8d04-28d7b658e739" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186246526} {:answer/id #uuid "09b69f6f-956e-5dac-a0d4-d207ae72c7a2" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,365" :db/id #edb/ref 17592186246527} {:answer/id #uuid "d62f972e-72d8-513b-8ecc-85b6ab5b15d0" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186246528}] :answer-field/correct {:answer/id #uuid "d62f972e-72d8-513b-8ecc-85b6ab5b15d0" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186246528} :answer-field/id #uuid "b947784c-1e15-5820-820e-4773781d5376" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246523}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ce7e0906-9a00-587e-b207-526545d6b60e" :question/is-example false :question/math-academy-id "q-5693" :question/problem "Evaluate $(\\begin{aligned}15 \\\\ 2\\end{aligned}).$" :question/worked-solution "First, note that $(\\frac{15}{2})$ means the same thing as ${}_{15}{C}_{2}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=15$ and $r=2,$ we get\n\n$$\n\\begin{aligned}{}_{15}{C}_{2}\\text{ } & =\\frac{15!}{(15-2)!2!} \\\\  & =\\frac{15!}{13!\\cdot 2!} \\\\  & =\\frac{15\\cdot 14\\cdot \\cancel{13!}}{\\cancel{13!}\\cdot 2!} \\\\  & =105.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246529 :knowledge-point/_questions [{:knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8aac0d-53ca-529f-b8a2-7bcaa3be8880" :answer/type {:db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186246531} {:answer/id #uuid "6623e6b9-5baa-5de3-968d-2bc3b2bdb618" :answer/type {:db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186246532} {:answer/id #uuid "ee182fd6-3bab-51af-8a43-5cb3892d5ee0" :answer/type {:db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186246533} {:answer/id #uuid "79556fcb-a415-5d6a-8369-796fe8fd9dca" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186246534} {:answer/id #uuid "5240f10b-bf21-5a45-b446-71199a852991" :answer/type {:db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186246535}] :answer-field/correct {:answer/id #uuid "ee182fd6-3bab-51af-8a43-5cb3892d5ee0" :answer/type {:db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186246533} :answer-field/id #uuid "addabf11-05a5-5771-b57c-2340e9a3b490" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246530}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e9749e3b-540b-5b96-af63-11e9c05dfa1a" :question/is-example false :question/math-academy-id "q-84959" :question/problem "Sara has a box of $9$ colored pencils. In how many ways can Sara pick a set of $4$ different pencils from the box?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ pencils in the box, so $n=9.$ We want to select $4$ of those pencils, so we have $r=4.$\n\nTherefore, the number of different potential sets of four pencils is\n\n$$\n\\begin{aligned}{}_{9}{C}_{4} & =\\frac{9!}{(9-4)!\\,4!} \\\\  & =\\frac{9!}{5!4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{3\\,024}{24} \\\\  & =126.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186246536 :knowledge-point/_questions [{:knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f78f54f-26ea-5197-ab42-f400bef5cdd5" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186246538} {:answer/id #uuid "57dda641-157c-5859-976b-3084560d9589" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186246539} {:answer/id #uuid "0ec67c81-1de6-5583-b8c0-874db8812b22" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186246540} {:answer/id #uuid "c6462dcc-e97a-5897-b06c-8fb92df273a9" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186246541} {:answer/id #uuid "6ce980f1-d400-5f4d-a800-724313b1822d" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186246542}] :answer-field/correct {:answer/id #uuid "2f78f54f-26ea-5197-ab42-f400bef5cdd5" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186246538} :answer-field/id #uuid "eb5aad70-ff14-5267-ba93-06ef81065813" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246537}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9f3faf48-bee3-5ed5-b2ba-466d849b745b" :question/is-example false :question/math-academy-id "q-84961" :question/problem "In a high school, eight players enter trials for the soccer team. In how many ways can the coach select four players to add to the team?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $8$ players, so $n=8.$ We want to select $4$ of those players for the team, so we have $r=4.$\n\nTherefore, the number of different selections of four players is\n\n$$\n\\begin{aligned}{}_{8}{C}_{4} & =\\frac{8!}{(8-4)!\\,4!} \\\\  & =\\frac{8!}{4!4!} \\\\  & =\\frac{8\\cdot 7\\cdot 6\\cdot 5\\cdot \\cancel{4!}}{4!\\cancel{4!}} \\\\  & =\\frac{1\\,680}{24} \\\\  & =70.\\end{aligned}\n$$"}]}
