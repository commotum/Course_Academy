[{:db/id "q-336130/field-1/7660a5f11d07f1baf16126db8272a4d380075cb25f4dec6341f0272bdbec23bd" :answer/id #uuid "99d34f4a-bbd8-509f-9a72-e3b04bb8027b" :answer/type :answer.type/math :answer/value "\\frac{\\tan(t)}{t}+\\ln(t)\\sec(t)^2" :db/ensure [:answer/validate]} {:db/id "q-336130/field-1" :answer-field/id #uuid "708ea12b-0e21-57ea-b806-0e13d14b7b10" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336130/field-1/7660a5f11d07f1baf16126db8272a4d380075cb25f4dec6341f0272bdbec23bd" :answer-field/choices ["q-336130/field-1/7660a5f11d07f1baf16126db8272a4d380075cb25f4dec6341f0272bdbec23bd"] :db/ensure [:answer-field/validate]} {:db/id "q-336130" :question/id #uuid "cd8f7479-077c-508d-a664-44b2b72fb2f9" :question/math-academy-id "q-336130" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}.$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}) \\\\  & =\\frac{(\\operatorname{cot}⁡t\\cdot \\frac{1}{t}-\\operatorname{ln}⁡t(-{csc}^{2}⁡t))}{{cot}^{2}⁡t} \\\\  & =\\frac{(\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t})}{{cot}^{2}⁡t} \\\\  & =\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t{cot}^{2}⁡t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336130/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692"] :knowledge-point/questions ["q-336130"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336118/field-1/9e375b112a19340dcc91e312faf0daf995bf6a473147843b6addc56f40d3dec4" :answer/id #uuid "7563f088-ce9c-5602-a578-efa708f20430" :answer/type :answer.type/math :answer/value "4t^3+2t" :db/ensure [:answer/validate]} {:db/id "q-336118/field-1/6871e769818c05b68f019899a4058c0c335c06fe97d9d37613c3cf7fb0f7595f" :answer/id #uuid "02fc99d6-36e4-5c37-89c0-240dffd86519" :answer/type :answer.type/math :answer/value "4t^3+2t-5" :db/ensure [:answer/validate]} {:db/id "q-336118/field-1" :answer-field/id #uuid "cebd426d-8ac0-5400-91c3-fced67a70c3d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336118/field-1/9e375b112a19340dcc91e312faf0daf995bf6a473147843b6addc56f40d3dec4" :answer-field/choices ["q-336118/field-1/9e375b112a19340dcc91e312faf0daf995bf6a473147843b6addc56f40d3dec4" "q-336118/field-1/6871e769818c05b68f019899a4058c0c335c06fe97d9d37613c3cf7fb0f7595f"] :db/ensure [:answer-field/validate]} {:db/id "q-336118" :question/id #uuid "675c4437-a734-5c3a-8788-37c35e556fb0" :question/math-academy-id "q-336118" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)={t}^{4}+{t}^{2}-5.$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+{t}^{2}-5) \\\\  & =4{t}^{3}+2t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336118/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692"] :knowledge-point/questions ["q-336118"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336133/field-1/7674d5cd4ddf22aa56f4e5a8ffb5d5a15d4096c8f1a1c64768b4ebb772c7b164" :answer/id #uuid "c263f9ce-cd03-59df-bcd2-771cc9c8287f" :answer/type :answer.type/math :answer/value "-2\\sin(t^3+e^t)(3t^2+e^t)" :db/ensure [:answer/validate]} {:db/id "q-336133/field-1" :answer-field/id #uuid "74bfd1d6-5f96-5d18-8531-de3da9ae3502" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336133/field-1/7674d5cd4ddf22aa56f4e5a8ffb5d5a15d4096c8f1a1c64768b4ebb772c7b164" :answer-field/choices ["q-336133/field-1/7674d5cd4ddf22aa56f4e5a8ffb5d5a15d4096c8f1a1c64768b4ebb772c7b164"] :db/ensure [:answer-field/validate]} {:db/id "q-336133" :question/id #uuid "60a198ac-b1c9-54f7-a3fb-f515e6a48f1f" :question/math-academy-id "q-336133" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=2\\operatorname{cos}⁡({t}^{3}+{e}^{t}).$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡({t}^{3}+{e}^{t})) \\\\  & =-2\\operatorname{sin}⁡({t}^{3}+{e}^{t})\\cdot (3{t}^{2}+{e}^{t}) \\\\  & =-2(3{t}^{2}+{e}^{t})\\operatorname{sin}⁡({t}^{3}+{e}^{t})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336133/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692"] :knowledge-point/questions ["q-336133"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109000/selection/9614839aaf8d53eb6226bb197278541429fb316b196b7f853f16405425fd09f1" :answer/id #uuid "9c0d8192-8fdd-5951-a1c3-d22b594495f7" :answer/type :answer.type/math :answer/value "v(t)=\\frac{2{t}^{2}}{{t}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-109000/selection/39029e4b7279f1ddeb546dee4d10e96a5e4a95cefe9b0de2c989a43e89a41759" :answer/id #uuid "cbef576f-18ab-5df6-b67c-0bd5fbed9d68" :answer/type :answer.type/math :answer/value "v(t)=\\frac{t+1}{({t}^{2}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-109000/selection/7d99180e0ba76baf36aaf54ab32d42b79932294450b71e1bd317ef1a60756068" :answer/id #uuid "74105eb1-6719-5692-b030-0de556488eef" :answer/type :answer.type/math :answer/value "v(t)=\\frac{t+2}{{t}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-109000/selection/e4a873c0a4846f495138c59f1045bbe74920239a83b8afbad4e89f29ef71521f" :answer/id #uuid "8fe9e447-e6e5-51b6-a840-115fc82aaa71" :answer/type :answer.type/math :answer/value "v(t)=\\frac{2}{{t}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-109000/selection/c6d2461b27c6140e4d1c4b6985afbf7d97b87e0f2d138fc7760b9ec0b035ab28" :answer/id #uuid "fbe5721b-c14a-5d5a-a1e3-d9d9f581a131" :answer/type :answer.type/math :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-109000/selection" :answer-field/id #uuid "c8e4804a-5949-5e21-9e58-ad59abe87b14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-109000/selection/c6d2461b27c6140e4d1c4b6985afbf7d97b87e0f2d138fc7760b9ec0b035ab28" :answer-field/choices ["q-109000/selection/9614839aaf8d53eb6226bb197278541429fb316b196b7f853f16405425fd09f1" "q-109000/selection/39029e4b7279f1ddeb546dee4d10e96a5e4a95cefe9b0de2c989a43e89a41759" "q-109000/selection/7d99180e0ba76baf36aaf54ab32d42b79932294450b71e1bd317ef1a60756068" "q-109000/selection/e4a873c0a4846f495138c59f1045bbe74920239a83b8afbad4e89f29ef71521f" "q-109000/selection/c6d2461b27c6140e4d1c4b6985afbf7d97b87e0f2d138fc7760b9ec0b035ab28"] :db/ensure [:answer-field/validate]} {:db/id "q-109000" :question/id #uuid "68190923-09f1-522b-b256-54bea9ce1f9c" :question/math-academy-id "q-109000" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{{t}^{2}}{{t}^{2}+1}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{{t}^{2}+1}) \\\\  & =\\frac{2t({t}^{2}+1)-{t}^{2}(2t)}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2{t}^{3}+2t-2{t}^{3}}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2t}{({t}^{2}+1)^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-109000/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692"] :knowledge-point/questions ["q-109000"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73134/selection/1323b3805ae1930ec4d667da8e9a381c26dc6c6e92a06347656a58977d58e46e" :answer/id #uuid "adc5a346-d0ee-569b-898d-52eb3d7aca3e" :answer/type :answer.type/math :answer/value "v(t)=3{t}^{3}+2{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-73134/selection/6826e5e2b7854408d3e2f00ce86ac609cd0e7eca85070fc88b616c5f3fe75630" :answer/id #uuid "f6d6a151-6732-5eeb-b18f-1ed2a29cc561" :answer/type :answer.type/math :answer/value "v(t)=6{t}^{2}+2{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-73134/selection/03fb7e1147f0a8fd6ee1f656ab389253fc481adcb42167188db247dc70b070bb" :answer/id #uuid "201f3584-19f6-5a6d-96e9-e74e5ee08b7a" :answer/type :answer.type/math :answer/value "v(t)=6{t}^{3}+2{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-73134/selection/5dc3a7598de46d816646ce25de4e1c9c57df7315d423d2e7b599cf864ee42268" :answer/id #uuid "bdaba8d4-14c3-54c6-9f8d-d982a9269523" :answer/type :answer.type/math :answer/value "v(t)=2{t}^{2}+2{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-73134/selection/d241d56ebba7137fe0817ce486c72989400f8ef4fc020abb33d67b29fbcecb1b" :answer/id #uuid "48de6168-aaa2-59ca-81ea-04fbed14fe9c" :answer/type :answer.type/math :answer/value "v(t)=3{t}^{2}+{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-73134/selection" :answer-field/id #uuid "b5316fcf-a6c9-5b91-b8f4-97519e63d5bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73134/selection/6826e5e2b7854408d3e2f00ce86ac609cd0e7eca85070fc88b616c5f3fe75630" :answer-field/choices ["q-73134/selection/1323b3805ae1930ec4d667da8e9a381c26dc6c6e92a06347656a58977d58e46e" "q-73134/selection/6826e5e2b7854408d3e2f00ce86ac609cd0e7eca85070fc8