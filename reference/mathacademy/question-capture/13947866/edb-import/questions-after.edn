#{[{:db/id #edb/ref 17592186063927 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/id #uuid "8c2dba74-7d6e-5074-947e-907464ee59c9" :question/math-academy-id "e-211" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t) = 3t^2 +3t +1$. Calculate the velocity at time $t$." :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}\nv(t) &= \\frac{dx}{dt} \\\\\n&= \\frac{d}{dt}(3t^{2} + 3t + 1) \\\\\n&= 6t + 3\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186063928 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/id #uuid "ede4e9d4-ae2e-5448-9e2d-3f6e93761d8b" :question/math-academy-id "e-212" :question/problem "The position $x$, measured in meters, of a particle at time $t$ is given by $x(t) = 6t^4 -3t^2 +t$, where $t$ is the time in seconds. Calculate the velocity at time $t=1$." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}\nv(t) &= \\frac{dx}{dt} \\\\\n&= \\frac{d}{dt}(6t^{4} - 3t^{2} + t) \\\\\n&= 24t^{3} - 6t + 1\n\\end{aligned}\n$$\n\nTo calculate the velocity at $t=1$, we substitute $t=1$ into the velocity function above:\n\n$$\n\\begin{aligned}\nv(1) &= 24(1)^{3} - 6(1) + 1 \\\\\n&= 24 - 6 + 1 \\\\\n&= 19\n\\end{aligned}\n$$\n\nTherefore, the velocity of the particle is $19\\,\\textrm{m/s}$."}] [{:db/id #edb/ref 17592186063929 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/id #uuid "36167a6f-27ba-503a-a1a8-8485f021d167" :question/math-academy-id "e-214" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by\n$s(t) = t^2 - 36t,\\quad t\\geq 0$.\nCalculate the speed of the particle when $t=1\\,\\textrm{s}$." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}\nv(t) &= \\frac{ds}{dt} \\\\\n&= \\frac{d}{dt}(t^{2} - 36t) \\\\\n&= 2t - 36\n\\end{aligned}\n$$\n\nWhen $t=1$, the velocity is\n\n$$\nv(1) = 2(1) - 36 = -34\n$$\n\nTherefore, the speed is\n\n$$\n\\mid {-34} \\mid = 34\\, \\textrm{m/s}\n$$"}] [{:db/id #edb/ref 17592186264093 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbef576f-18ab-5df6-b67c-0bd5fbed9d68" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+1}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186264095} {:answer/id #uuid "74105eb1-6719-5692-b030-0de556488eef" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+2}{{t}^{2}+1}" :db/id #edb/ref 17592186264096} {:answer/id #uuid "9c0d8192-8fdd-5951-a1c3-d22b594495f7" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2{t}^{2}}{{t}^{2}+1}" :db/id #edb/ref 17592186264097} {:answer/id #uuid "fbe5721b-c14a-5d5a-a1e3-d9d9f581a131" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186264098} {:answer/id #uuid "8fe9e447-e6e5-51b6-a840-115fc82aaa71" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2}{{t}^{2}+1}" :db/id #edb/ref 17592186264099}] :answer-field/correct {:answer/id #uuid "fbe5721b-c14a-5d5a-a1e3-d9d9f581a131" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186264098} :answer-field/id #uuid "c8e4804a-5949-5e21-9e58-ad59abe87b14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264094}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "68190923-09f1-522b-b256-54bea9ce1f9c" :question/math-academy-id "q-109000" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{{t}^{2}}{{t}^{2}+1}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{{t}^{2}+1}) \\\\  & =\\frac{2t({t}^{2}+1)-{t}^{2}(2t)}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2{t}^{3}+2t-2{t}^{3}}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2t}{({t}^{2}+1)^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264100 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdd6723b-2976-54e8-ae1d-8ff9bbaca195" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{miles/h}" :db/id #edb/ref 17592186264102} {:answer/id #uuid "17390346-4487-530a-bc57-de1feaddd428" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186264103} {:answer/id #uuid "c72cc472-d884-5510-be50-be573d789ca5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186264104} {:answer/id #uuid "516642fa-c839-5acb-9120-b0f3689b69fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\,\\text{miles/h}" :db/id #edb/ref 17592186264105} {:answer/id #uuid "335bf88d-0c9c-5da8-83c5-99e5c9c7cbea" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,\\text{miles/h}" :db/id #edb/ref 17592186264106}] :answer-field/correct {:answer/id #uuid "17390346-4487-530a-bc57-de1feaddd428" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186264103} :answer-field/id #uuid "74f92c50-9db9-5edf-b81f-7ca1784d0f70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264101}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d585be43-c802-5898-9f5b-2c2fe6d06f55" :question/math-academy-id "q-109012" :question/problem "The position $s(t)$ of a particle (in miles) at time $t$ hours is given by \n\n$$\ns(t)=\\frac{3}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=3\\,\\text{h}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{t}) \\\\  & =-\\frac{3}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=3,$ the velocity is\n\n$$\nv(3)=-\\frac{3}{{3}^{2}}=-\\frac{1}{3}.\n$$\n\nTherefore, the speed is $|-\\frac{1}{3}|=\\frac{1}{3}\\,\\text{miles/h}.$"}] [{:db/id #edb/ref 17592186264107 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a52fb262-7349-59a2-ad74-e56a58d9231f" :answer/type {:db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186264109} {:answer/id #uuid "22a01630-ef6b-5fbd-abbf-37a45fd3ab65" :answer/type {:db/ident :answer.type/math} :answer/value "v=4.94" :db/id #edb/ref 17592186264110} {:answer/id #uuid "bded6327-3fbd-505c-914f-a16326201bd4" :answer/type {:db/ident :answer.type/math} :answer/value "v=10.03" :db/id #edb/ref 17592186264111} {:answer/id #uuid "08283db2-254a-57ea-a618-34ee9702cc7c" :answer/type {:db/ident :answer.type/math} :answer/value "v=9.24" :db/id #edb/ref 17592186264112} {:answer/id #uuid "44b22279-6dcb-59bf-a7ba-3358315d793c" :answer/type {:db/ident :answer.type/math} :answer/value "v=8.36" :db/id #edb/ref 17592186264113}] :answer-field/correct {:answer/id #uuid "a52fb262-7349-59a2-ad74-e56a58d9231f" :answer/type {:db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186264109} :answer-field/id #uuid "30760418-7658-59ba-9f92-a5679d8b1f45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264108}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "59ea1544-758d-5928-bf3f-4995dd8b61f1" :question/math-academy-id "q-19299" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=4{e}^{-t}+3{t}^{2}-2t+1,\\,t\\ge 0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to $2$ decimal places." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{-t}+3{t}^{2}-2t+1) \\\\  & =-4{e}^{-t}+6t-2\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =-4{e}^{-2}+6\\cdot 2-2 \\\\  & =-4{e}^{-2}+10 \\\\  & =9.458\\,658… \\\\  & ≈9.46\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264114 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d3f607-046a-5af8-be50-0a6370ebbbce" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264116}] :answer-field/correct {:answer/id #uuid "d3d3f607-046a-5af8-be50-0a6370ebbbce" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264116} :answer-field/id #uuid "68d81add-6401-51a8-8b81-5b150b5d0b4c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264115}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "af7ae399-6485-5d28-ab37-1f5218476981" :question/math-academy-id "q-316032" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by the equation $s(t)=2{t}^{4}-3t+5$, where $t\\ge 0$ is measured in seconds. At how many seconds is the particle's velocity equal to $509\\,\\text{m/s}?$\n\n$t=$\n{{field-1}}\n$\\text{s}$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}-3t+5) \\\\  & =8{t}^{3}-3\\end{aligned}\n$$\n\nSince we want to know when the velocity is $509\\,\\text{m/s}$, we substitute $v(t)=509$ into the equation above and solve for $t:$\n\n$$\n\\begin{aligned}509 & =8{t}^{3}-3 \\\\ 512 & =8{t}^{3} \\\\ {t}^{3} & =\\frac{512}{8} \\\\ {t}^{3} & =64 \\\\ t & =4\\end{aligned}\n$$\n\nTherefore, the velocity of the particle is $509\\,\\text{m/s}$ when $t=4\\,\\text{s}.$"}] [{:db/id #edb/ref 17592186264117 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3688dadf-170e-530e-8642-0b0c5c2cde4c" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186264119}] :answer-field/correct {:answer/id #uuid "3688dadf-170e-530e-8642-0b0c5c2cde4c" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186264119} :answer-field/id #uuid "e6e6e912-713f-5f89-a785-223805dd4752" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264118}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cadef097-386b-5352-9bf6-68f695d9a1ba" :question/math-academy-id "q-316062" :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ minutes is given by \n\n$$\ns(t)=3{t}^{6}-2{t}^{4}-8{t}^{2}-7t,\\,t\\ge 0.\n$$\n\nCalculate the speed of the particle when $t=1\\,\\text{min}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{cm/min}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{6}-2{t}^{4}-8{t}^{2}-7t) \\\\  & =18{t}^{5}-8{t}^{3}-16t-7\\end{aligned}\n$$\n\nWhen $t=1,$ the velocity is\n\n$$\n\\begin{aligned}v(1) & =18(1)^{5}-8(1)^{3}-16(1)-7 \\\\  & =18-8-16-7 \\\\  & =-13.\\end{aligned}\n$$\n\nTherefore, the speed is $|-13|=13\\,\\text{cm/min}.$"}] [{:db/id #edb/ref 17592186264120 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02fc99d6-36e4-5c37-89c0-240dffd86519" :answer/type {:db/ident :answer.type/math} :answer/value "4t^3+2t-5" :db/id #edb/ref 17592186264122} {:answer/id #uuid "7563f088-ce9c-5602-a578-efa708f20430" :answer/type {:db/ident :answer.type/math} :answer/value "4t^3+2t" :db/id #edb/ref 17592186264123}] :answer-field/correct {:answer/id #uuid "7563f088-ce9c-5602-a578-efa708f20430" :answer/type {:db/ident :answer.type/math} :answer/value "4t^3+2t" :db/id #edb/ref 17592186264123} :answer-field/id #uuid "cebd426d-8ac0-5400-91c3-fced67a70c3d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264121}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "675c4437-a734-5c3a-8788-37c35e556fb0" :question/math-academy-id "q-336118" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)={t}^{4}+{t}^{2}-5.$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+{t}^{2}-5) \\\\  & =4{t}^{3}+2t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264124 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99d34f4a-bbd8-509f-9a72-e3b04bb8027b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\tan(t)}{t}+\\ln(t)\\sec(t)^2" :db/id #edb/ref 17592186264126}] :answer-field/correct {:answer/id #uuid "99d34f4a-bbd8-509f-9a72-e3b04bb8027b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\tan(t)}{t}+\\ln(t)\\sec(t)^2" :db/id #edb/ref 17592186264126} :answer-field/id #uuid "708ea12b-0e21-57ea-b806-0e13d14b7b10" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cd8f7479-077c-508d-a664-44b2b72fb2f9" :question/math-academy-id "q-336130" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}.$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\operatorname{ln}⁡t}{\\operatorname{cot}⁡t}) \\\\  & =\\frac{(\\operatorname{cot}⁡t\\cdot \\frac{1}{t}-\\operatorname{ln}⁡t(-{csc}^{2}⁡t))}{{cot}^{2}⁡t} \\\\  & =\\frac{(\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t})}{{cot}^{2}⁡t} \\\\  & =\\frac{\\operatorname{cot}⁡t+t\\operatorname{ln}⁡t{csc}^{2}⁡t}{t{cot}^{2}⁡t}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264127 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c263f9ce-cd03-59df-bcd2-771cc9c8287f" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin(t^3+e^t)(3t^2+e^t)" :db/id #edb/ref 17592186264129}] :answer-field/correct {:answer/id #uuid "c263f9ce-cd03-59df-bcd2-771cc9c8287f" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin(t^3+e^t)(3t^2+e^t)" :db/id #edb/ref 17592186264129} :answer-field/id #uuid "74bfd1d6-5f96-5d18-8531-de3da9ae3502" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264128}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "60a198ac-b1c9-54f7-a3fb-f515e6a48f1f" :question/math-academy-id "q-336133" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=2\\operatorname{cos}⁡({t}^{3}+{e}^{t}).$ Calculate the velocity at time $t.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡({t}^{3}+{e}^{t})) \\\\  & =-2\\operatorname{sin}⁡({t}^{3}+{e}^{t})\\cdot (3{t}^{2}+{e}^{t}) \\\\  & =-2(3{t}^{2}+{e}^{t})\\operatorname{sin}⁡({t}^{3}+{e}^{t})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264130 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94bd6fda-9ce8-5416-a112-bf610ec7c40e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186264132}] :answer-field/correct {:answer/id #uuid "94bd6fda-9ce8-5416-a112-bf610ec7c40e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186264132} :answer-field/id #uuid "0eba9b1a-d770-56ed-bbfb-7ba9e61b7fce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264131}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "27791598-f71f-584c-a797-b3aabea9949a" :question/math-academy-id "q-336142" :question/problem "The position $x$ of a particle at time $t$ is given by \n\n$$\nx(t)={t}^{2}-24\\sqrt[3]{t},\\,t\\ge 0.\n$$\n\nCalculate the velocity at time $t=8.$\n\n$v(8)=$\n{{field-1}}" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-24\\sqrt[3]{t}) \\\\  & =2t-24\\cdot \\frac{1}{3{(\\sqrt[3]{t})}^{2}} \\\\  & =2t-\\frac{8}{{(\\sqrt[3]{t})}^{2}}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=8,$ we substitute $t=8$ into the velocity function above:\n\n$$\n\\begin{aligned}v(8) & =2(8)-\\frac{8}{{(\\sqrt[3]{8})}^{2}} \\\\  & =16-2 \\\\  & =14\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264133 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c80122c4-8bac-5417-8536-b22ccc9a0c3d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264135} {:answer/id #uuid "17425342-593a-56f8-93f3-f392ea2b0883" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264136}] :answer-field/correct {:answer/id #uuid "c80122c4-8bac-5417-8536-b22ccc9a0c3d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264135} :answer-field/id #uuid "2fd8bd22-1114-585f-936f-88b3f7bbaddc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264134} {:answer-field/choices [{:answer/id #uuid "3471abda-64e9-5f71-b054-85331592ce95" :answer/type {:db/ident :answer.type/math} :answer/value "9\\ln(3)" :db/id #edb/ref 17592186264138}] :answer-field/correct {:answer/id #uuid "3471abda-64e9-5f71-b054-85331592ce95" :answer/type {:db/ident :answer.type/math} :answer/value "9\\ln(3)" :db/id #edb/ref 17592186264138} :answer-field/id #uuid "060f8d6c-0eb3-5f37-a967-1dea8ee34a03" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264137}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7080eac4-3fa8-5049-bbb4-7c6a19b7e3b2" :question/math-academy-id "q-336164" :question/problem "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)={3}^{3t+1}$, where $t$ is the time, measured in seconds. Find the position ${s}_{0}$ and velocity ${v}_{0}$ of the particle at the initial moment of time $t=0\\,\\text{s}.$\n\n${s}_{0}=$\n{{field-1}}$\\text{m}\\,\\text{and}\\,$\n\n${v}_{0}=$\n{{field-2}}$\\text{m/s}$" :question/worked-solution "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)={3}^{3t+1}:$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & ={3}^{3(0)+1} \\\\  & =3\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({3}^{3t+1}) \\\\  & =3\\cdot {3}^{3t+1}\\operatorname{ln}⁡3 \\\\  & ={3}^{3t+2}\\operatorname{ln}⁡3\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & ={3}^{3(0)+2}\\operatorname{ln}⁡3 \\\\  & =9\\operatorname{ln}⁡3\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264139 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b486aff-d76a-5d91-8065-a12e977148b4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264141}] :answer-field/correct {:answer/id #uuid "0b486aff-d76a-5d91-8065-a12e977148b4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264141} :answer-field/id #uuid "afad9354-c849-52c2-a675-1479eb3835f9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264140}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "59089536-93bb-5aa0-adf3-fe2e1f5b2781" :question/math-academy-id "q-336174" :question/problem "The position $s(t)$ of a particle (in feet) at time $t$ minutes is given by \n\n$$\ns(t)=\\frac{2}{{t}^{2}},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=1\\,\\text{min}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{ft/min}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{{t}^{2}}) \\\\  & =-\\frac{4}{{t}^{3}}\\end{aligned}\n$$\n\nWhen $t=1,$ the velocity is\n\n$$\n\\begin{aligned}v(1) & =-\\frac{4}{{1}^{3}} \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the speed is $|-4|=4\\,\\text{ft/min}.$"}] [{:db/id #edb/ref 17592186264142 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ef93873-1c75-556e-927b-db158eddd8e9" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186264144} {:answer/id #uuid "2815aabf-2a7d-5318-86ea-f6ad5f62348c" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186264145}] :answer-field/correct {:answer/id #uuid "2815aabf-2a7d-5318-86ea-f6ad5f62348c" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186264145} :answer-field/id #uuid "a4995d30-41d9-5642-8cc0-c66b233eb511" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264143}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4a79c169-ce2a-5452-85f2-e8bf7b0b618c" :question/math-academy-id "q-336179" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)=6\\operatorname{ln}⁡t-3{t}^{2},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$\n\nThe speed of the particle is \n{{field-1}}$\\text{m/s}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{ln}⁡t-3{t}^{2}) \\\\  & =\\frac{6}{t}-6t\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\n\\begin{aligned}v(2) & =\\frac{6}{2}-6(2) \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the speed is $|-9|=9\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186264146 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f7a0b1-57c1-504c-b552-46cd17455ea8" :answer/type {:db/ident :answer.type/math} :answer/value "2.47" :db/id #edb/ref 17592186264148}] :answer-field/correct {:answer/id #uuid "13f7a0b1-57c1-504c-b552-46cd17455ea8" :answer/type {:db/ident :answer.type/math} :answer/value "2.47" :db/id #edb/ref 17592186264148} :answer-field/id #uuid "1d1b1fc7-103b-534f-b174-c938159c03b0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264147}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d180e225-c221-5fcc-927f-4690f3c81980" :question/math-academy-id "q-336192" :question/problem "The position $s(t)$ of a particle (in meters) at time $t$ seconds is given by \n\n$$\ns(t)={t}^{2}\\operatorname{cos}⁡t,\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=\\frac{\\pi }{2}\\,\\text{s}.$ Round your answer to 2 decimal places.\n\nThe speed of the particle is approximately\n{{field-1}}$\\text{m/s}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}\\operatorname{cos}⁡t) \\\\  & =2t\\operatorname{cos}⁡t-{t}^{2}\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nWhen $t=\\frac{\\pi }{2},$ the velocity is\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{2}) & =2\\cdot \\frac{\\pi }{2}\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2})-{(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =-\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the speed is $|-\\frac{{\\pi }^{2}}{4}|=\\frac{{\\pi }^{2}}{4}≈2.47\\,\\text{m/s}$ to 2 decimal places."}] [{:db/id #edb/ref 17592186264149 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aae6976b-c7cb-59d9-9da5-0b21a0b04a2b" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=4.5\\,\\text{m},\\,{v}_{0}=2.5\\,\\text{m/s}" :db/id #edb/ref 17592186264151} {:answer/id #uuid "aca909dc-cf39-5ec5-989a-efcc5fa4807b" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=1\\,\\text{m},\\,{v}_{0}=6\\,\\text{m/s}" :db/id #edb/ref 17592186264152} {:answer/id #uuid "3a85dc44-bfaf-573f-9ca5-dc1bed7a404e" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=4.5\\,\\text{m},\\,{v}_{0}=2\\,\\text{m/s}" :db/id #edb/ref 17592186264153} {:answer/id #uuid "150cf5ca-cb1d-50aa-bca3-7b46cefc606c" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=1\\,\\text{m},\\,{v}_{0}=2.5\\,\\text{m/s}" :db/id #edb/ref 17592186264154} {:answer/id #uuid "5812579f-0557-5dcc-b268-088a007bb112" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=3\\,\\text{m},\\,{v}_{0}=6\\,\\text{m/s}" :db/id #edb/ref 17592186264155}] :answer-field/correct {:answer/id #uuid "aca909dc-cf39-5ec5-989a-efcc5fa4807b" :answer/type {:db/ident :answer.type/math} :answer/value "{s}_{0}=1\\,\\text{m},\\,{v}_{0}=6\\,\\text{m/s}" :db/id #edb/ref 17592186264152} :answer-field/id #uuid "722a5ef6-5a5d-5306-a4d6-dd16bc6e2b5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264150}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ae77e72-b12e-5e34-a452-174b8e1e2c84" :question/math-academy-id "q-48904" :question/problem "The displacement $s$ (in meters) relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by the equation $s(t)=(2t+1)^{3}$, where $t$ is the time, measured in seconds. Find the position and velocity of the particle at the initial moment of time $t=0\\,\\text{s}.$" :question/worked-solution "To calculate the initial position, we substitute $t=0$ it into the equation $s(t)=(2t+1)^{3}:$\n\n$$\n\\begin{aligned}{s}_{0} & =s(0) \\\\  & =(2\\cdot 0+1)^{3} \\\\  & ={1}^{3} \\\\  & =1\\,\\text{m}\\end{aligned}\n$$\n\nNow, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((2t+1)^{3}) \\\\  & =6(2t+1)^{2}\\end{aligned}\n$$\n\nTo calculate the velocity at $t=0\\,\\text{s},$ we substitute $t=0$ into the velocity function above:\n\n$$\n\\begin{aligned}{v}_{0} & =v(0) \\\\  & =6(2\\cdot 0+1)^{2} \\\\  & =6(1)^{2} \\\\  & =6\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264156 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f3584-19f6-5a6d-96e9-e74e5ee08b7a" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=6{t}^{3}+2{e}^{t}" :db/id #edb/ref 17592186264158} {:answer/id #uuid "adc5a346-d0ee-569b-898d-52eb3d7aca3e" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=3{t}^{3}+2{e}^{t}" :db/id #edb/ref 17592186264159} {:answer/id #uuid "bdaba8d4-14c3-54c6-9f8d-d982a9269523" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=2{t}^{2}+2{e}^{2t}" :db/id #edb/ref 17592186264160} {:answer/id #uuid "f6d6a151-6732-5eeb-b18f-1ed2a29cc561" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=6{t}^{2}+2{e}^{2t}" :db/id #edb/ref 17592186264161} {:answer/id #uuid "48de6168-aaa2-59ca-81ea-04fbed14fe9c" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=3{t}^{2}+{e}^{2t}" :db/id #edb/ref 17592186264162}] :answer-field/correct {:answer/id #uuid "f6d6a151-6732-5eeb-b18f-1ed2a29cc561" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=6{t}^{2}+2{e}^{2t}" :db/id #edb/ref 17592186264161} :answer-field/id #uuid "b5316fcf-a6c9-5b91-b8f4-97519e63d5bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264157}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ed3d1b3a-1caa-59ca-b3c4-d618526baeae" :question/math-academy-id "q-73134" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=2{t}^{3}+{e}^{2t}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+{e}^{2t}) \\\\  & =6{t}^{2}+2{e}^{2t}\\end{aligned}\n$$"}]}
