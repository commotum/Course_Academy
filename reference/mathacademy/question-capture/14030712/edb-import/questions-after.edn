#{[{:db/id #edb/ref 17592186292880 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d1c68e0-68eb-5081-9c66-fc3ddc954bae" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186292882} {:answer/id #uuid "4fbd8cba-cc01-5414-b847-3eec898d0eff" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-2)" :db/id #edb/ref 17592186292883} {:answer/id #uuid "ed185ce7-cd35-56db-a1d6-92a4ad33842d" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-4)" :db/id #edb/ref 17592186292884} {:answer/id #uuid "a5184608-16c7-545e-ae6d-5862e3b02272" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,5)" :db/id #edb/ref 17592186292885} {:answer/id #uuid "9165b35e-f43d-569d-a9bb-db96015a3180" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186292886}] :answer-field/correct {:answer/id #uuid "a5184608-16c7-545e-ae6d-5862e3b02272" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,5)" :db/id #edb/ref 17592186292885} :answer-field/id #uuid "bfd7f366-e06b-5881-a5d1-ab70e232f752" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292881}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59d79587-4235-51d5-b256-de9d0719abf9" :question/math-academy-id "q-10418" :question/problem "What is the center of the hyperbola ${x}^{2}-5{y}^{2}+8x+50y=129?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-5{y}^{2}+8x+50y & =129 \\\\ {x}^{2}+8x-5{y}^{2}+50y & =129 \\\\ {x}^{2}+8x-5[{y}^{2}-10y] & =129 \\\\ (x+4)^{2}-16-5[(y-5)^{2}-25] & =129 \\\\ (x+4)^{2}-16-5(y-5)^{2}+125 & =129 \\\\ (x+4)^{2}-5(y-5)^{2} & =129+16-125 \\\\ (x+4)^{2}-5(y-5)^{2} & =20 \\\\ \\frac{(x+4)^{2}}{20}-\\frac{(y-5)^{2}}{4} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-4,5).$"}] [{:db/id #edb/ref 17592186292887 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54764fac-8641-5f20-8ebb-b615929b0c5e" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-3)" :db/id #edb/ref 17592186292889} {:answer/id #uuid "76f91a20-40ad-5d3b-aa41-cc6a321d6732" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-1)" :db/id #edb/ref 17592186292890} {:answer/id #uuid "6ac86740-16ee-5898-b7ef-01c49df2c681" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5)" :db/id #edb/ref 17592186292891} {:answer/id #uuid "7ef3f7fc-1289-5033-8aab-675b0e67cc43" :answer/type {:db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186292892} {:answer/id #uuid "7ac61097-76fa-504a-a530-665f32c07d93" :answer/type {:db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186292893}] :answer-field/correct {:answer/id #uuid "7ac61097-76fa-504a-a530-665f32c07d93" :answer/type {:db/ident :answer.type/math} :answer/value "(5,1)" :db/id #edb/ref 17592186292893} :answer-field/id #uuid "432ee9b5-9abb-56da-993a-d3c716742f36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292888}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "610b6c0a-314d-5d0b-a93b-4022acad3e0f" :question/math-academy-id "q-116113" :question/problem "What is the center of the hyperbola \n$4{x}^{2}-3{y}^{2}-40x+6y=-85?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}4{x}^{2}-3{y}^{2}-40x+6y & =-85 \\\\ 4{x}^{2}-40x-3{y}^{2}+6y & =-85 \\\\ 4[{x}^{2}-10x]-3[{y}^{2}-2y] & =-85 \\\\ 4[(x-5)^{2}-25]-3[(y-1)^{2}-1] & =-85 \\\\ 4(x-5)^{2}-100-3(y-1)^{2}+3 & =-85 \\\\ 4(x-5)^{2}-3(y-1)^{2} & =12 \\\\ \\frac{(x-5)^{2}}{3}-\\frac{(y-1)^{2}}{4} & =1 \\\\ \\frac{(x-5)^{2}}{(\\sqrt{3})^{2}}-\\frac{(y-1)^{2}}{{2}^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(5,1).$"}] [{:db/id #edb/ref 17592186292894 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed4fb367-1a3b-53ca-bb96-044ead1ef6cb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186292896} {:answer/id #uuid "73b0a139-0d9f-5ea9-8f58-953f53638df6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186292897}] :answer-field/correct {:answer/id #uuid "ed4fb367-1a3b-53ca-bb96-044ead1ef6cb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186292896} :answer-field/id #uuid "2262b843-6256-5ded-b498-e4c29780e91b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292895} {:answer-field/choices [{:answer/id #uuid "d5d89bbc-75b7-5604-b37e-97a587769b96" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292899}] :answer-field/correct {:answer/id #uuid "d5d89bbc-75b7-5604-b37e-97a587769b96" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292899} :answer-field/id #uuid "3d68512a-a9af-5bb4-b5f9-542d2a2e8fcd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292898}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9eed80f5-d45f-5a64-bffb-51a629ba4b7f" :question/math-academy-id "q-274640" :question/problem "The center of the hyperbola $9{y}^{2}-4{x}^{2}-36y+8x=4$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-4{x}^{2}-36y+8x & =4 \\\\ 9{y}^{2}-36y-4{x}^{2}+8x & =4 \\\\ 9[{y}^{2}-4y]-4[{x}^{2}-2x] & =4 \\\\ 9[(y-2)^{2}-4]-4[(x-1)^{2}-1] & =4 \\\\ 9(y-2)^{2}-36-4(x-1)^{2}+4 & =4 \\\\ 9(y-2)^{2}-4(x-1)^{2} & =4+36-4 \\\\ 9(y-2)^{2}-4(x-1)^{2} & =36 \\\\ \\frac{(y-2)^{2}}{4}-\\frac{(x-1)^{2}}{9} & =1 \\\\ \\frac{(y-2)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,2\\,).$"}] [{:db/id #edb/ref 17592186292900 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8328a37-837b-5c78-8ad6-1ccb44c7b86c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186292902}] :answer-field/correct {:answer/id #uuid "a8328a37-837b-5c78-8ad6-1ccb44c7b86c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186292902} :answer-field/id #uuid "17106630-b05c-5222-886f-88b96dde7f23" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292901} {:answer-field/choices [{:answer/id #uuid "09ffd12b-b5c0-5d57-84c7-c1a648a1ef33" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186292904}] :answer-field/correct {:answer/id #uuid "09ffd12b-b5c0-5d57-84c7-c1a648a1ef33" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186292904} :answer-field/id #uuid "77403b5d-1d0e-5bfc-ba96-5fe72a8010e3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292903}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "57c8250e-40fd-51ca-8080-031a88dc2b94" :question/math-academy-id "q-328394" :question/problem "The center of the hyperbola $9{y}^{2}-{x}^{2}+36y+10x=25$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-{x}^{2}+36y+10x & =25 \\\\ 9{y}^{2}+36y-{x}^{2}+10x & =25 \\\\ 9[{y}^{2}+4y]-[{x}^{2}-10x] & =25 \\\\ 9[(y+2)^{2}-4]-[(x-5)^{2}-25] & =25 \\\\ 9(y+2)^{2}-36-(x-5)^{2}+25 & =25 \\\\ 9(y+2)^{2}-(x-5)^{2} & =25+36-25 \\\\ 9(y+2)^{2}-(x-5)^{2} & =36 \\\\ \\frac{(y+2)^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1 \\\\ \\frac{(y-(-2))^{2}}{4}-\\frac{(x-5)^{2}}{36} & =1\\end{aligned}\n$$\n\nHence, the center is $(\\,5,-2\\,).$"}] [{:db/id #edb/ref 17592186292905 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7318ed52-b5d6-52a1-a771-333d18578307" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-4)" :db/id #edb/ref 17592186292907} {:answer/id #uuid "ae6df21f-943c-5bda-a647-56b849766d9f" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,9)" :db/id #edb/ref 17592186292908} {:answer/id #uuid "3e9e4df3-52af-5a57-9f44-011e417573b4" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-7)" :db/id #edb/ref 17592186292909} {:answer/id #uuid "6364d58e-2fd4-5f1f-877f-5b3230936160" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186292910} {:answer/id #uuid "82ea2dc5-4aed-5797-8435-8c74b31f1e50" :answer/type {:db/ident :answer.type/math} :answer/value "(9,1)" :db/id #edb/ref 17592186292911}] :answer-field/correct {:answer/id #uuid "6364d58e-2fd4-5f1f-877f-5b3230936160" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186292910} :answer-field/id #uuid "6f6b5fcd-1080-5de0-9c6e-99bbcb2f126d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292906}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b2096e13-b432-5188-9b2a-286612b8e650" :question/math-academy-id "q-78868" :question/problem "What is the center of the hyperbola $\\frac{(y-7)^{2}}{9}-(x+4)^{2}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-7)^{2}}{9}-\\frac{(x-(-4))^{2}}{1}=1\n$$\n\nIn this case, we have $h=-4$ and $k=7.$\n\nTherefore, the center of the hyperbola is $(-4,7).$"}]}
