\\\\ -5 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=9 \\\\ 3{x}_{1}+2{x}_{2}=-5 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 9 \\\\ 3 & 2 & -5 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 0 & 3 & k-18\\end{aligned}] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 3 & k-18\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & k-6\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74594/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fac58a79-2d3f-5ad3-b1ab-c5ce279c4ebe"] :knowledge-point/questions ["q-74594"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74559/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "f2d07f82-aa57-5839-b9f9-bb9beb4eb283" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-74559/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "b347c3da-126c-5853-a807-33d1065d5a81" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-74559/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "1fc62adf-ea57-50f8-bde5-452d410c45ab" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-74559/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "75443c33-1d46-5a70-8ae4-166b19dad67b" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-74559/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "ba43cb17-3d34-5331-bd1f-dde4cc5b51af" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-74559/selection" :answer-field/id #uuid "75b3faf2-ab55-5bd0-9acb-5add477557c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74559/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-74559/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-74559/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-74559/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-74559/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-74559/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-74559" :question/id #uuid "ada2a237-9557-5ce5-94c7-1c1c977d6e0d" :question/math-academy-id "q-74559" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -4 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 9 \\\\ 10\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -8 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -4 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 9 \\\\ 10\\end{aligned}] & =[\\begin{aligned}3 \\\\ -8 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=3 \\\\ -4{x}_{1}+9{x}_{2}=-8 \\\\ -2{x}_{1}+10{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 3 \\\\ -4 & 9 & -8 \\\\ -2 & 10 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ -2 & 10 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 6 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-6{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & k-18\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-18.$ Therefore, the system has a solution only if\n\n$$\n0=k-18\\,⇒\\,k=18.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74559/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fac58a79-2d3f-5ad3-b1ab-c5ce279c4ebe"] :knowledge-point/questions ["q-74559"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-74560"] :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ -2 \\\\ -6\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}9 \\\\ 7 \\\\ 18\\end{aligned}],\\,b=[\\begin{aligned}-12 \\\\ -10 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}-3 \\\\ -2 \\\\ -6\\end{aligned}]+{x}_{2}[\\begin{aligned}9 \\\\ 7 \\\\ 18\\end{aligned}] & =[\\begin{aligned}-12 \\\\ -10 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-3{x}_{1}+9{x}_{2}=-12 \\\\ -2{x}_{1}+7{x}_{2}=-10 \\\\ -6{x}_{1}+18{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-3 & 9 & -12 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & k+24\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+24.$ Therefore, the system has a solution only if\n\n$$\n0=k+24\\,⇒\\,k=-24.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-74597/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "b6d9979d-3c30-5ff7-bbec-2e6a3890b26b" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-74597/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d31a218e-3e10-5e7a-988e-687eaa85fdd5" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-74597/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9c648914-378c-5059-9aab-c274cc294271" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74597/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "294f2ada-1f7b-5719-bc0a-8d2176df0146" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-74597/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "277f8286-98ce-55e1-8e73-9c94a006b9cf" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74597/selection" :answer-field/id #uuid "e621b626-d1c0-573c-8075-7e9dbf7d6013" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74597/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-74597/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-74597/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-74597/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-74597/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-74597/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-74597" :question/id #uuid "904c48e4-0b9c-5c7e-bf91-b07b77859fe9" :question/math-academy-id "q-74597" :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}5{x}_{1}+{x}_{2}=-3 \\\\ {x}_{1}-{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & 1 & -3 \\\\ 1 & -1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 5 & 1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{2} & :=\\frac{1}{6}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k+4\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+4.$ Therefore, the system has a solution only if\n\n$$\n0=k+4\\,⇒\\,k=-4.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fac58a79-2d3f-5ad3-b1ab-c5ce279c4ebe"] :knowledge-point/questions ["q-74597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105253/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7646de9a-cf05-56f0-aed4-a48a532e6dea" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-105253/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4ed90633-8e5a-5726-821a-bfd0ae6ce04f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-105253/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "97efbbd0-bccd-5f58-afc6-ffc659d046f8" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-105253/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "4d952097-5fa9-566a-9550-bb82251b7981" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-105253/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "8a5ef1cf-0d8b-5af1-9139-8f8599e89357" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105253/selection" :answer-field/id #uuid "a7297fef-03d0-5b08-a3fb-1b74d7b959e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105253/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-105253/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-105253/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-105253/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-105253/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-105253/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-105253" :question/id #uuid "72980dd9-a084-58f4-8392-6327a30e9f96" :question/math-academy-id "q-105253" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨-1,3,2⟩$, $c=⟨2,-1,-1⟩$, and  $u=⟨5,-5,-4⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}5 \\\\ -5 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+2t=5 \\\\ 3s-t=-5 \\\\ 2s-t=-4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 2 & 5 \\\\ 3 & -1 & -5 \\\\ 2 & -1 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 2 & 5 \\\\ 0 & 5 & 10 \\\\ 2 & -1 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 2 & 5 \\\\ 0 & 5 & 10 \\\\ 0 & 3 & 6\\end{aligned}] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 2 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 3 & 6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 2 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+2t=5 \\\\ t=2 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=2.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+2t & =5 \\\\ -s+2(2) & =5 \\\\ -s+4 & =5 \\\\ s & =-1.\\end{aligned}\n$$\n\nSince we found a solution $s=-1,\\,t=2,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-b+2c.\n$$\n\nFinally, $s\\cdot t=(-1)\\cdot 2=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105253/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be"] :knowledge-point/questions ["q-105253"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105248/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" :answer/id #uuid "4a601237-e469-5910-b78e-92d971d65588" :answer/type :answer.type/text :answer/value "$u$ does not lie on $Π$" :db/ensure [:answer/validate]} {:db/id "q-105248/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "16ab4253-48bf-583d-b015-b97f6da4eaec" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-105248/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "35ffd69d-f9fe-59c5-959c-8a79eb4306fb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-105248/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "31c0df89-339a-5ed8-a572-3354dd2c34ac" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-105248/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "0c69efb4-3276-5df3-9679-903de10ad9c6" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-105248/selection" :answer-field/id #uuid "d7f6592d-4257-5e06-90ae-710df775cbea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105248/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" :answer-field/choices ["q-105248/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" "q-105248/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" "q-105248/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-105248/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-105248/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-105248" :question/id #uuid "da64bb93-914e-5229-bb6d-b7d97e6fa1bb" :question/math-academy-id "q-105248" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨1,-4,2⟩$, $c=⟨3,-10,2⟩$, and  $u=⟨-2,5,0⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -4 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -10 \\\\ 2\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 5 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s+3t=-2 \\\\ -4s-10t=5 \\\\ 2s+2t=0\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 3 & -2 \\\\ -4 & -10 & 5 \\\\ 2 & 2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 0 & -4 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=-2,$ which has no solution.\n\nSo, there are no values of $s$ and $t$ such that \n\n$$\n\\begin{aligned}sb+tc=u.\\end{aligned}\n$$\n\nTherefore, we conclude that $u$ does *not* lie on the plane $Π.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105248/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be"] :knowledge-point/questions ["q-105248"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74598/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "4bd3d188-2cc1-584d-a483-28aa2c599d10" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-74598/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" :answer/id #uuid "949c7d37-ae91-5770-8114-649fa6ee66e0" :answer/type :answer.type/text :answer/value "$u$ does not lie on $Π$" :db/ensure [:answer/validate]} {:db/id "q-74598/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "4ca74f6d-7460-5497-b4e9-8f716497e891" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-74598/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7c32844e-2918-5110-b1f8-b802f26e43ce" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-74598/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "af2c40ca-62ce-55af-a8b5-9e60396e4812" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-74598/selection" :answer-field/id #uuid "a168f6d1-ae31-5105-9fe9-23b6b9cd78b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74598/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-74598/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-74598/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" "q-74598/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-74598/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-74598/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-74598" :question/id #uuid "9a339e4e-decb-5668-80f9-2bcd81514c71" :question/math-academy-id "q-74598" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,2,3⟩$, $c=⟨3,-7,-9⟩$, and  $u=⟨2,-3,-6⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -7 \\\\ -9\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ -6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+3t=2 \\\\ 2s-7t=-3 \\\\ 3s-9t=-6\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 3 & 2 \\\\ 2 & -7 & -3 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+3t=2 \\\\ -t=1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-t=1\\,⟹\\,t=-1.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+3t & =2 \\\\ -s+3(-1) & =2 \\\\ -s & =5 \\\\ s & =-5.\\end{aligned}\n$$\n\nSince we found a solution $s=-5,\\,t=-1,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-5b-c.\n$$\n\nFinally, $s\\cdot t=(-5)\\cdot (-1)=5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74598/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be"] :knowledge-point/questions ["q-74598"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105261/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "475fffa5-0d8e-54ee-a8dd-c638c63c2fdd" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-105261/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "bb04a159-dc05-53fd-bd0e-f8f70b269f5f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-105261/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "9d857f2f-77a9-588d-a0a9-08e2017c4867" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-105261/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c334db72-a81e-541a-9f28-0a829301718f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-105261/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d2a06f1c-1838-562b-915d-f343b96cc0a1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-105261/selection" :answer-field/id #uuid "33923fde-d387-569f-8da2-cb09517cf247" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105261/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-105261/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-105261/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-105261/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-105261/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-105261/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-105261" :question/id #uuid "dc42dd0f-fa8b-5044-b147-6f3f5acbed6c" :question/math-academy-id "q-105261" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,-1,3⟩$, $c=⟨-2,4,-3⟩$, and  $u=⟨3,-7,3⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -1 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ -3\\end{aligned}] & =[\\begin{aligned}3 \\\\ -7 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s-2t=3 \\\\ -s+4t=-7 \\\\ 3s-3t=3\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 3 \\\\ -1 & 4 & -7 \\\\ 3 & -3 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 2 & -4 \\\\ 3 & -3 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 2 & -4 \\\\ 0 & 3 & -6\\end{aligned}] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 3 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s-2t=3 \\\\ t=-2 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-2.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-2t & =3 \\\\ s-2(-2) & =3 \\\\ s+4 & =3 \\\\ s & =-1.\\end{aligned}\n$$\n\nSince we found a solution $s=-1,\\,t=-2,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-b-2c.\n$$\n\nFinally, $s\\cdot t=(-1)\\cdot (-2)=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105261/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be"] :knowledge-point/questions ["q-105261"] :db/ensure [:knowledge-point/validate]} {:db/id "q-34212/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" :answer/id #uuid "f96780df-6bdb-5efc-b5dc-101e8b1dbf85" :answer/type :answer.type/text :answer/value "$u$ does not lie on $Π$" :db/ensure [:answer/validate]} {:db/id "q-34212/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2d53c036-45b5-5d93-a198-e3f117255518" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-34212/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "4aabfd74-7929-521a-9ddb-a541df71ced9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-34212/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "6a787ffe-4733-5e57-8780-118497baaba9" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-34212/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "ae24bfe2-518d-56e6-a395-177d2a46f8f3" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-34212/selection" :answer-field/id #uuid "f5113eef-6d87-5250-8552-90c8a6e833b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-34212/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-34212/selection/f635503ab95ed49bf0985a5138c100a3e9b6736b3a3e9d92d62e38e3545ad295" "q-34212/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-34212/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-34212/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-34212/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-34212" :question/id #uuid "57be7a53-3b34-5fc3-96ea-f6d1b5131a58" :question/math-academy-id "q-34212" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc,$ $t,s\\in R$, where  $b=⟨1,7,-3⟩$, $c=⟨-8,10,-4⟩$, and  $u=⟨6,9,-4⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ 7 \\\\ -3\\end{aligned}]+t[\\begin{aligned}-8 \\\\ 10 \\\\ -4\\end{aligned}] & =[\\begin{aligned}6 \\\\ 9 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s-8t=6 \\\\ 7s+10t=9 \\\\ -3s-4t=-4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -8 & 6 \\\\ 7 & 10 & 9 \\\\ -3 & -4 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ -3 & -4 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ 0 & -28 & 14\\end{aligned}] & {R}_{2} & :=\\frac{1}{66}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & -28 & 14\\end{aligned}] & {R}_{3} & :={R}_{3}+28{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s-8t=6 \\\\ t=-\\frac{1}{2} \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-\\frac{1}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-8t & =6 \\\\ s-8(-\\frac{1}{2}) & =6 \\\\ s+4 & =6 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=-\\frac{1}{2},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b-\\frac{1}{2}c.\n$$\n\nFinally, $s\\cdot t=2\\cdot (-\\frac{1}{2})=-1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-34212/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be"] :knowledge-point/questions ["q-34212"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4795"] :question/problem "Determine if $\\mathbf{b}$ lies in $\\textrm{Span}\\{ \\mathbf{a_1}, \\mathbf{a_2} \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082953/assets/df4f126da2ab3a0661bcb7dc18bb1e5eae8cd48d5c5a1464ea580ccc439195d6.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6218"] :question/problem "Find the values of $k$ such that the vector $\\mathbf{b}$ lies in $\\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ where\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14082953/assets/399d7fed8338969b654454d30f2ee661edbd52b3a61d065f33972be21996e188.png)" :db/ensure [:question/validate]}]
