[{:db/id "q-3431/selection/76a7e23fde57b45c14c8ff543fd7f5ab7ec9399ec74c58825ef8abdf1f77e6e1" :answer/id #uuid "6878f65e-f2fd-5544-a060-ca16811e6d2c" :answer/type :answer.type/math :answer/value "p=-1,\\,z=-1\\pm \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-3431/selection/f22ab13f3ae044c77fed38e6256c18913042aae2663ab5c7f95b4ca19cecab47" :answer/id #uuid "1cf0b4dd-ab43-5a5d-8dd8-59374ec6dbbb" :answer/type :answer.type/math :answer/value "p=1,\\,z=1\\pm \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-3431/selection/b3573afa4b84d94192011ec0e0ecb2500baac79b6fd01573a152c806c5dac709" :answer/id #uuid "c5a08141-29d3-510c-a194-682f6ba3056e" :answer/type :answer.type/math :answer/value "p=1,\\,z=-1\\pm \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-3431/selection/04265aa42200d2a8af454bada2a40a25085f6266e00cc5e6a5420cd2cf30c200" :answer/id #uuid "d3c0352c-1868-5c1c-b425-3853fb4e8ffd" :answer/type :answer.type/math :answer/value "p=-6,\\,z=-1\\pm \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-3431/selection/918721c606c4b230428ce54eddae6b27d3627e70fdafeff813ed5b66eb62a760" :answer/id #uuid "0cce48ca-62a3-5be4-bb58-e70ec1cc15cc" :answer/type :answer.type/math :answer/value "p=1,\\,z=1\\pm \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-3431/selection" :answer-field/id #uuid "7ffa9472-acd2-55a9-883f-f178097bdc75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-3431/selection/b3573afa4b84d94192011ec0e0ecb2500baac79b6fd01573a152c806c5dac709" :answer-field/choices ["q-3431/selection/76a7e23fde57b45c14c8ff543fd7f5ab7ec9399ec74c58825ef8abdf1f77e6e1" "q-3431/selection/f22ab13f3ae044c77fed38e6256c18913042aae2663ab5c7f95b4ca19cecab47" "q-3431/selection/b3573afa4b84d94192011ec0e0ecb2500baac79b6fd01573a152c806c5dac709" "q-3431/selection/04265aa42200d2a8af454bada2a40a25085f6266e00cc5e6a5420cd2cf30c200" "q-3431/selection/918721c606c4b230428ce54eddae6b27d3627e70fdafeff813ed5b66eb62a760"] :db/ensure [:answer-field/validate]} {:db/id "q-3431" :question/id #uuid "74bd8e3a-a67b-574b-924d-9b4365f760ed" :question/math-academy-id "q-3431" :question/problem "The equation $2{z}^{2}+4z=10$  can be written in the form $(z+p)^{2}+q=0.$ Find $p,$ and solve the equation." :question/worked-solution "First, we divide out by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}2{z}^{2}+4z & =10 \\\\ 2({z}^{2}+2z) & =10 \\\\ {z}^{2}+2z & =5 \\\\ {z}^{2}+2\\cdot 1\\cdot z & =5 \\\\ {z}^{2}+2\\cdot 1\\cdot z+{1}^{2}-{1}^{2} & =5 \\\\ {(z+1)}^{2}-{1}^{2} & =5\\end{aligned}\n$$\n\n \n\nThen, we write the equation in the required form:\n\n$$\n\\begin{aligned}{(z+1)}^{2}-{1}^{2} & =5 \\\\ {(z+1)}^{2}-1 & =5 \\\\ {(z+1)}^{2}-6 & =0\\end{aligned}\n$$\n\n \n\nHence, $p=1$ and $q=-6.$ \n\nNow, let's solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(z+1)^{2}-6 & =0 \\\\ (z+1)^{2} & =6 \\\\ \\sqrt{(z+1)^{2}} & =\\sqrt{6} \\\\ |z+1| & =\\sqrt{6} \\\\ z+1 & =\\pm \\sqrt{6} \\\\ z & =-1\\pm \\sqrt{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-3431/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f"] :knowledge-point/questions ["q-3431"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86415/selection/44e0c9b08665dd855fbf9cdbc85ed3508790d661cfaf5fdcfa830fb34f7e2181" :answer/id #uuid "a905c2a5-b340-595b-b17e-ff29d9123205" :answer/type :answer.type/text :answer/value "$q=15,\\,w=-\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/ensure [:answer/validate]} {:db/id "q-86415/selection/db5721194d4f1c1fadb0fcb342c31b7ee5c8b71966f9b762143d7bdbae8457e8" :answer/id #uuid "700c3a74-8d88-5f57-aa8f-3d89ac539faa" :answer/type :answer.type/text :answer/value "$q=15,\\,w=\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/ensure [:answer/validate]} {:db/id "q-86415/selection/03dbaba3c7438fd9f77f8b686e31e96a0d881ff062dc422389c7fbd9038f78b9" :answer/id #uuid "fca80544-35ba-5e55-b254-adfa666685c9" :answer/type :answer.type/text :answer/value "$q=25,\\,w=\\frac{5}{2}$ and $w=\\frac{15}{2}$" :db/ensure [:answer/validate]} {:db/id "q-86415/selection/eb502cca3f72399b923281368104a0b2d17f7c009ce7defac6c4ed3c2d418890" :answer/id #uuid "e8c9b527-9629-5cee-85ac-2d7533bce7c2" :answer/type :answer.type/text :answer/value "$q=25,\\,w=\\frac{\\sqrt{5}}{2}$ and $w=15$" :db/ensure [:answer/validate]} {:db/id "q-86415/selection/ae8fac5318ead0983d5d2f4ed4ba74d064cd88dd70f405f57df5080c749da3da" :answer/id #uuid "faec4bb9-d593-53c5-a78f-61bcc1c988e1" :answer/type :answer.type/text :answer/value "$q=25,\\,w=5$ and $w=\\frac{11}{2}$" :db/ensure [:answer/validate]} {:db/id "q-86415/selection" :answer-field/id #uuid "88ad550e-5aa5-582a-8acc-cd4b26d7afdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86415/selection/03dbaba3c7438fd9f77f8b686e31e96a0d881ff062dc422389c7fbd9038f78b9" :answer-field/choices ["q-86415/selection/44e0c9b08665dd855fbf9cdbc85ed3508790d661cfaf5fdcfa830fb34f7e2181" "q-86415/selection/db5721194d4f1c1fadb0fcb342c31b7ee5c8b71966f9b762143d7bdbae8457e8" "q-86415/selection/03dbaba3c7438fd9f77f8b686e31e96a0d881ff062dc422389c7fbd9038f78b9" "q-86415/selection/eb502cca3f72399b923281368104a0b2d17f7c009ce7defac6c4ed3c2d418890" "q-86415/selection/ae8fac5318ead0983d5d2f4ed4ba74d064cd88dd70f405f57df5080c749da3da"] :db/ensure [:answer-field/validate]} {:db/id "q-86415" :question/id #uuid "211d779e-92bf-5786-beb2-56b9bec0ebf9" :question/math-academy-id "q-86415" :question/problem "The equation $-4{w}^{2}+40w-75=0$ can be written in the form $4(w+p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1$:\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{w}^{2}+40w-75) & =(-1)\\cdot 0 \\\\ 4{w}^{2}-40w+75 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{w}^{2}-40w+75 & =0 \\\\ 4{w}^{2}-40w & =-75 \\\\ 4({w}^{2}-10w) & =-75 \\\\ 4[{w}^{2}-2\\cdot 5w+{5}^{2}-{5}^{2}] & =-75 \\\\ 4[{(w-5)}^{2}-25] & =-75\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(w-5)}^{2}-4\\cdot 25 & =-75 \\\\ 4{(w-5)}^{2}-100 & =-75 \\\\ 4{(w-5)}^{2} & =-75+100 \\\\ 4{(w-5)}^{2} & =25\\end{aligned}\n$$\n\nTherefore, $q=25.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(w-5)}^{2} & =25 \\\\ {(w-5)}^{2} & =\\frac{25}{4} \\\\ \\sqrt{{(w-5)}^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |w-5| & =\\frac{5}{2} \\\\ w-5 & =\\pm \\frac{5}{2} \\\\ w & =5\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}w & =5+\\frac{5}{2}=\\frac{15}{2} \\\\ w & =5-\\frac{5}{2}=\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $w=\\frac{5}{2}$ and $w=\\frac{15}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-86415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112605/selection/da03b4790c50fa6c3c73b2a87d6f772f9ebe6bb5a786211a681d07622962c630" :answer/id #uuid "c069a518-0e37-56dc-91d3-1ee95e64df16" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{3},\\,t=-1$ and $t=\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112605/selection/4e4793573707a2522aeb3baf90a13a9f090d78e391f0cdf726fd17003a5fba4f" :answer/id #uuid "31d02854-adc8-5e41-87f7-91468b371dc2" :answer/type :answer.type/text :answer/value "$p=\\frac{5}{12},\\,t=\\frac{1}{3}$ and $t=\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112605/selection/b1d7fcb6bde22fa4ac0ecfc6fdc99f406c97a9c5fb2c1aef9f5adeb736c348a5" :answer/id #uuid "3e562226-050c-5015-a114-3fe3afa8ce6b" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{12},\\,t=-\\frac{1}{3}$ and $t=2$" :db/ensure [:answer/validate]} {:db/id "q-112605/selection/d1bb973df52e51c1a8ccfd8845fa6b320748bfc1f5cbe0355771545381be83be" :answer/id #uuid "e8b09f9a-ddef-583e-8d6e-ff84f09e10d8" :answer/type :answer.type/text :answer/value "$p=\\frac{5}{12},\\,t=-\\frac{1}{2}$ and $t=-\\frac{1}{3}$" :db/ensure [:answer/validate]} {:db/id "q-112605/selection/4a5454f55e366d3a41491fad6d66967717b8327069a0689dd0ad6bf367e5c7c8" :answer/id #uuid "493cb774-b25e-50f8-b41f-b3c76836bff3" :answer/type :answer.type/text :answer/value "$p=\\frac{1}{3},\\,t=\\frac{1}{2}$ and $t=1$" :db/ensure [:answer/validate]} {:db/id "q-112605/selection" :answer-field/id #uuid "0968de50-163c-5c9d-b148-50de0c694b64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112605/selection/4e4793573707a2522aeb3baf90a13a9f090d78e391f0cdf726fd17003a5fba4f" :answer-field/choices ["q-112605/selection/da03b4790c50fa6c3c73b2a87d6f772f9ebe6bb5a786211a681d07622962c630" "q-112605/selection/4e4793573707a2522aeb3baf90a13a9f090d78e391f0cdf726fd17003a5fba4f" "q-112605/selection/b1d7fcb6bde22fa4ac0ecfc6fdc99f406c97a9c5fb2c1aef9f5adeb736c348a5" "q-112605/selection/d1bb973df52e51c1a8ccfd8845fa6b320748bfc1f5cbe0355771545381be83be" "q-112605/selection/4a5454f55e366d3a41491fad6d66967717b8327069a0689dd0ad6bf367e5c7c8"] :db/ensure [:answer-field/validate]} {:db/id "q-112605" :question/id #uuid "688e38cc-4ccf-5ec7-be78-915098c07c29" :question/math-academy-id "q-112605" :question/problem "The equation $-6{t}^{2}+5t-1=0$ can be written in the form $6(t-p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1:$\n\n$$\n\\begin{aligned}(-1)\\cdot (-6{t}^{2}+5t-1) & =(-1)\\cdot 0 \\\\ 6{t}^{2}-5t+1 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}6{t}^{2}-5t+1 & =0 \\\\ 6{t}^{2}-5t & =-1 \\\\ 6({t}^{2}-\\frac{5}{6}t) & =-1 \\\\ 6[{t}^{2}-2\\cdot \\frac{5}{12}t+{(\\frac{5}{12})}^{2}-{(\\frac{5}{12})}^{2}] & =-1 \\\\ 6[{(t-\\frac{5}{12})}^{2}-\\frac{25}{144}] & =-1\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}6{(t-\\frac{5}{12})}^{2}-6\\cdot \\frac{25}{144} & =-1 \\\\ 6{(t-\\frac{5}{12})}^{2}-\\frac{25}{24} & =-1 \\\\ 6{(t-\\frac{5}{12})}^{2} & =-1+\\frac{25}{24} \\\\ 6{(t-\\frac{5}{12})}^{2} & =\\frac{1}{24}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{5}{12}.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}6{(t-\\frac{5}{12})}^{2} & =\\frac{1}{24} \\\\ {(t-\\frac{5}{12})}^{2} & =\\frac{1}{144} \\\\ \\sqrt{{(t-\\frac{5}{12})}^{2}} & =\\sqrt{\\frac{1}{144}} \\\\ |t-\\frac{5}{12}| & =\\frac{1}{12} \\\\ t-\\frac{5}{12} & =\\pm \\frac{1}{12} \\\\ t & =\\frac{5}{12}\\pm \\frac{1}{12}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}t & =\\frac{5}{12}-\\frac{1}{12}=\\frac{4}{12}=\\frac{1}{3} \\\\ t & =\\frac{5}{12}+\\frac{1}{12}=\\frac{6}{12}=\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the solutions are $t=\\frac{1}{3}$ and $t=\\frac{1}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-112605/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-112605"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112612/selection/55a8ad73b432f2fa07cd5654e151496f548c200b4bbd54569ab86886e5b27b76" :answer/id #uuid "4bc38603-af41-5943-9e0a-6fb6cd35f86a" :answer/type :answer.type/text :answer/value "$p=2,\\,z=\\frac{1}{2}$ and $z=-\\frac{5}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112612/selection/85d86858f25efd510a8ec6fd272ad0151f88c6aa14907c44113720baf29188e7" :answer/id #uuid "e15b678e-7f40-5ce5-a4aa-ce8d23a61f16" :answer/type :answer.type/text :answer/value "$p=9,\\,z=-\\frac{1}{2}$ and $z=\\frac{9}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112612/selection/07fbe77cbd8855f64d503d20a8af83c6d60d7592a55dc58bf639cdfbbd76e50b" :answer/id #uuid "4123ddf6-626b-5a44-941d-f210606cad5f" :answer/type :answer.type/text :answer/value "$p=2,\\,z=-\\frac{3}{2}$ and $z=2$" :db/ensure [:answer/validate]} {:db/id "q-112612/selection/dfa5b78ebbc25d8648700ba8bde90e70c5674e0d82cc0619d481c9f0506a52a8" :answer/id #uuid "5feba206-b336-5449-85cb-b068936a9410" :answer/type :answer.type/text :answer/value "$p=2,\\,z=-\\frac{7}{2}$ and $z=-\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112612/selection/69d3029dd745dec9caf0a724d1127ddfa7c7d51edf9911ee955d718a3a47f671" :answer/id #uuid "d214f6eb-0cf1-5474-a5d1-13d543079fbb" :answer/type :answer.type/text :answer/value "$p=9,\\,z=-\\frac{1}{2}$ and $z=\\frac{3}{2}$" :db/ensure [:answer/validate]} {:db/id "q-112612/selection" :answer-field/id #uuid "249ccaa4-bc1f-51f4-bcf7-aac6975f42bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112612/selection/dfa5b78ebbc25d8648700ba8bde90e70c5674e0d82cc0619d481c9f0506a52a8" :answer-field/choices ["q-112612/selection/55a8ad73b432f2fa07cd5654e151496f548c200b4bbd54569ab86886e5b27b76" "q-112612/selection/85d86858f25efd510a8ec6fd272ad0151f88c6aa14907c44113720baf29188e7" "q-112612/selection/07fbe77cbd8855f64d503d20a8af83c6d60d7592a55dc58bf639cdfbbd76e50b" "q-112612/selection/dfa5b78ebbc25d8648700ba8bde90e70c5674e0d82cc0619d481c9f0506a52a8" "q-112612/selection/69d3029dd745dec9caf0a724d1127ddfa7c7d51edf9911ee955d718a3a47f671"] :db/ensure [:answer-field/validate]} {:db/id "q-112612" :question/id #uuid "b0945056-0521-55d9-80fa-5db83ff53407" :question/math-academy-id "q-112612" :question/problem "The equation $-4{z}^{2}-16z-7=0$ can be written in the form $4(z+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1:$\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{z}^{2}-16z-7) & =(-1)\\cdot 0 \\\\ 4{z}^{2}+16z+7 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{z}^{2}+16z+7 & =0 \\\\ 4{z}^{2}+16z & =-7 \\\\ 4({z}^{2}+4z) & =-7 \\\\ 4[{z}^{2}+2\\cdot 2\\cdot z+{(2)}^{2}-{(2)}^{2}] & =-7 \\\\ 4[{(z+2)}^{2}-4] & =-7\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(z+2)}^{2}-4\\cdot 4 & =-7 \\\\ 4{(z+2)}^{2}-16 & =-7 \\\\ 4{(z+2)}^{2} & =-7+16 \\\\ 4{(z+2)}^{2} & =9\\end{aligned}\n$$\n\nTherefore, $p=2.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(z+2)}^{2} & =9 \\\\ {(z+2)}^{2} & =\\frac{9}{4} \\\\ \\sqrt{{(z+2)}^{2}} & =\\sqrt{\\frac{9}{4}} \\\\ |z+2| & =\\frac{3}{2} \\\\ z+2 & =\\pm \\frac{3}{2} \\\\ z & =-2\\pm \\frac{3}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}z & =-2-\\frac{3}{2}=-\\frac{7}{2} \\\\ z & =-2+\\frac{3}{2}=-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the solutions are $z=-\\frac{7}{2}$ and $z=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-112612/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33"] :knowledge-point/questions ["q-112612"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141627/selection/373e33571fbbac3a7afb4c98c4979763c7b703adfb180f45e8138d93788a806f" :answer/id #uuid "a5327ab0-394a-5838-ad3d-0e853e88d150" :answer/type :answer.type/text :answer/value "$q=6,\\,$ $z=-1,\\,5$" :db/ensure [:answer/validate]} {:db/id "q-141627/selection/3d6dbbe321a44ee225ef40f24507fda8c58beb41c3fd0cefe6383d758e4ecd39" :answer/id #uuid "becb00e6-4435-5a4e-9421-799f3d729713" :answer/type :answer.type/text :answer/value "$q=9,\\,$ $z=-1,\\,5$" :db/ensure [:answer/validate]} {:db/id "q-141627/selection/c071686c8e319412eb186428d89beb1fc24c0d0b824cd2e4ca510313f0c4bc1c" :answer/id #uuid "d23d3a1a-7abc-52fe-91bd-d46cb953f947" :answer/type :answer.type/text :answer/value "$q=9,\\,$ $z=2,\\,3$" :db/ensure [:answer/validate]} {:db/id "q-141627/selection/6448475249b18876593513f84e7016838203695f76be4abe6fdb7560c7fb783c" :answer/id #uuid "c475a3a7-3124-5e00-adcf-f126228398be" :answer/type :answer.type/text :answer/value "$q=5,\\,$ $z=2,\\,3$" :db/ensure [:answer/validate]} {:db/id "q-141627/selection/eea5dc6511b7ddbb869944a131e0a9259ecda75dd6cfe59c79cf5478803448a7" :answer/id #uuid "069b71b1-0358-5fe7-9697-48312bef4c9e" :answer/type :answer.type/text :answer/value "$q=5,\\,$ $z=-1,\\,5$" :db/ensure [:answer/validate]} {:db/id "q-141627/selection" :answer-field/id #uuid "c277acd0-20e5-538d-8a15-e62b73befdc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141627/selection/3d6dbbe321a44ee225ef40f24507fda8c58beb41c3fd0cefe6383d758e4ecd39" :answer-field/choices ["q-141627/selection/373e33571fbbac3a7afb4c98c4979763c7b703adfb180f45e8138d93788a806f" "q-141627/selection/3d6dbbe321a44ee225ef40f24507fda8c58beb41c3fd0cefe6383d758e4ecd39" "q-141627/selection/c071686c8e319412eb186428d89beb1fc24c0d0b824cd2e4ca510313f0c4bc1c" "q-141627/selection/6448475249b18876593513f84e7016838203695f76be4abe6fdb7560c7fb783c" "q-141627/selection/eea5dc6511b7ddbb869944a131e0a9259ecda75dd6cfe59c79cf5478803448a7"] :db/ensure [:answer-field/validate]} {:db/id "q-141627" :question/id #uuid "2779e37c-82bb-5252-8304-35569aa4b2f9" :question/math-academy-id "q-141627" :question/problem "The equation $3{z}^{2}-15=12z$ can be written in the form $(z-p)^{2}=q.$ Find $q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, divide it by the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}3{z}^{2}-15 & =12z \\\\ 3{z}^{2}-12z & =15 \\\\ 3({z}^{2}-4z) & =15 \\\\ {z}^{2}-4z & =5 \\\\ {z}^{2}-2\\cdot 2\\cdot z & =5 \\\\ {z}^{2}-2\\cdot 2\\cdot z+{2}^{2}-{2}^{2} & =5 \\\\ {(z-2)}^{2}-{2}^{2} & =3\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}{(z-2)}^{2}-{2}^{2} & =5 \\\\ {(z-2)}^{2}-4 & =5 \\\\ {(z-2)}^{2} & =9\\end{aligned}\n$$\n\nSo, $p=2$ and $q=9.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}\\sqrt{{(z-2)}^{2}} & =\\sqrt{9} \\\\ |z-2| & =3 \\\\ z-2 & =\\pm 3 \\\\ z & =2\\pm 3 \\\\ z & =-1,\\,5\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141627/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f"] :knowledge-point/questions ["q-141627"] :db/ensure [:knowledge-point/validate]}]
