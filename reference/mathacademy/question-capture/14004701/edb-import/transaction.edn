[{:db/id "q-120733/selection/9a6d1d9639f1277189a0f8456ab620cd6d5b68c15bf3670ebff06a00aa6e1f9b" :answer/id #uuid "5fa2d796-988a-5969-bfcb-45026acb9122" :answer/type :answer.type/math :answer/value "⟨5,-11,2⟩" :db/ensure [:answer/validate]} {:db/id "q-120733/selection/b76a9817d47e85ae7fdd20d446a3a2c6fb7ebe60c951b6a960ac3a7567cdb1cf" :answer/id #uuid "dd840db7-c351-5954-bac9-cd7da7fffd95" :answer/type :answer.type/math :answer/value "⟨2,-6,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-120733/selection/d4566978f3aa66c2e1c7ac3fd209afba0bcd2e67294e75537a7588b2e0a3007f" :answer/id #uuid "0b101fbd-232d-5239-ad56-303bd5239347" :answer/type :answer.type/math :answer/value "⟨5,-12,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-120733/selection/5e18281971f843ff6731bcea01e94787192164ff1b69e8fb8aaa43114e5649bb" :answer/id #uuid "a48217c1-80f5-5b37-b8bd-b4d0b1b2fdb0" :answer/type :answer.type/math :answer/value "⟨3,-6,0⟩" :db/ensure [:answer/validate]} {:db/id "q-120733/selection/3d7576c6d6e856e03dca72f5e8452869f16a1625f795a4c78a5d9d86c764d396" :answer/id #uuid "97df4ca6-3f77-57ec-83a8-053ba7dc8769" :answer/type :answer.type/math :answer/value "⟨3,-5,2⟩" :db/ensure [:answer/validate]} {:db/id "q-120733/selection" :answer-field/id #uuid "b2129908-e8fc-5fa2-896e-13950725f919" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120733/selection/d4566978f3aa66c2e1c7ac3fd209afba0bcd2e67294e75537a7588b2e0a3007f" :answer-field/choices ["q-120733/selection/9a6d1d9639f1277189a0f8456ab620cd6d5b68c15bf3670ebff06a00aa6e1f9b" "q-120733/selection/b76a9817d47e85ae7fdd20d446a3a2c6fb7ebe60c951b6a960ac3a7567cdb1cf" "q-120733/selection/d4566978f3aa66c2e1c7ac3fd209afba0bcd2e67294e75537a7588b2e0a3007f" "q-120733/selection/5e18281971f843ff6731bcea01e94787192164ff1b69e8fb8aaa43114e5649bb" "q-120733/selection/3d7576c6d6e856e03dca72f5e8452869f16a1625f795a4c78a5d9d86c764d396"] :db/ensure [:answer-field/validate]} {:db/id "q-120733" :question/id #uuid "37edf627-e377-59ee-8553-a795c51e889f" :question/math-academy-id "q-120733" :question/problem "Let $a=⟨1,-2,0⟩$ and $b=⟨1,-3,-2⟩.$ Find $3a+2b.$" :question/worked-solution "To compute $3a+2b,$ we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a+2b & =3\\cdot ⟨1,-2,0⟩+2\\cdot ⟨1,-3,-2⟩ \\\\  & =⟨3,-6,0⟩+⟨2,-6,-4⟩ \\\\  & =⟨5,-12,-4⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120733/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b41a801d-eba6-5deb-8e5e-375f398b85b0"] :knowledge-point/questions ["q-120733"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113930/selection/52d76234e7b37cc904273b74b839d6780ffd43616a0ebe35763b2e33a244e875" :answer/id #uuid "dd48664d-d1a9-5f09-9d91-a82bbf3798f5" :answer/type :answer.type/math :answer/value "-3\\operatorname{tan}⁡x+7\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113930/selection/ede6a58370543a0460919990632166d6a76a78237a48087554d3b3f7bb755f9f" :answer/id #uuid "26b29c86-e7c4-586d-af2d-320f75e272d9" :answer/type :answer.type/math :answer/value "3\\operatorname{sec}⁡x+7\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113930/selection/332466668f1c4b9cbd75e5540db29b502238ed93baee2d633c5036e8d2f13812" :answer/id #uuid "f6c09a31-c639-5d1b-9297-65142d039d20" :answer/type :answer.type/math :answer/value "-3\\operatorname{sec}⁡x-7\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113930/selection/577f7102a9cef814f6457f17b9a6507691441222e0b8c5e131cd089ec9fea73f" :answer/id #uuid "c3e1179d-e34e-5b5d-8d5c-1b78ec75e92c" :answer/type :answer.type/math :answer/value "3\\operatorname{sec}⁡x-7\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113930/selection/04d1fb92c152897a0623cf6ba63d4f8a7c216a8aa518d9c698aed5aa3e4d6b89" :answer/id #uuid "18bc89ef-0f20-546c-84bc-17d810a50c8b" :answer/type :answer.type/math :answer/value "10{sec}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-113930/selection" :answer-field/id #uuid "73b21915-4309-58a2-83cf-9cc16a98ba0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113930/selection/577f7102a9cef814f6457f17b9a6507691441222e0b8c5e131cd089ec9fea73f" :answer-field/choices ["q-113930/selection/52d76234e7b37cc904273b74b839d6780ffd43616a0ebe35763b2e33a244e875" "q-113930/selection/ede6a58370543a0460919990632166d6a76a78237a48087554d3b3f7bb755f9f" "q-113930/selection/332466668f1c4b9cbd75e5540db29b502238ed93baee2d633c5036e8d2f13812" "q-113930/selection/577f7102a9cef814f6457f17b9a6507691441222e0b8c5e131cd089ec9fea73f" "q-113930/selection/04d1fb92c152897a0623cf6ba63d4f8a7c216a8aa518d9c698aed5aa3e4d6b89"] :db/ensure [:answer-field/validate]} {:db/id "q-113930" :question/id #uuid "50fceeb6-a7d6-58ef-a20c-c22efdfa93b4" :question/math-academy-id "q-113930" :question/problem "$\\int (3\\operatorname{sec}⁡x\\operatorname{tan}⁡x+7\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & =\\operatorname{sec}⁡x+C, \\\\ \\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3\\operatorname{sec}⁡x\\operatorname{tan}⁡x+7\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =3\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x+7\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x+7(-\\operatorname{csc}⁡x)+C \\\\  & =3\\operatorname{sec}⁡x-7\\operatorname{csc}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113930/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f"] :knowledge-point/questions ["q-113930"] :db/ensure [:knowledge-point/validate]} {:db/id "q-344143/field-1/61c7e7030f4ffa7038562793ae8e0efaf52d01fbcc102210dce4720fce785c81" :answer/id #uuid "25c3e58c-2442-5d56-99fb-c0b3cad501c9" :answer/type :answer.type/math :answer/value "6x^2-12x-1" :db/ensure [:answer/validate]} {:db/id "q-344143/field-1" :answer-field/id #uuid "41241f81-f0c3-5c9a-bad2-be42855e0d3a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-344143/field-1/61c7e7030f4ffa7038562793ae8e0efaf52d01fbcc102210dce4720fce785c81" :answer-field/choices ["q-344143/field-1/61c7e7030f4ffa7038562793ae8e0efaf52d01fbcc102210dce4720fce785c81"] :db/ensure [:answer-field/validate]} {:db/id "q-344143" :question/id #uuid "dd90d514-01b1-5378-a6f1-668663ee7966" :question/math-academy-id "q-344143" :question/problem "Find ${y}^{′}$ for $y=\\frac{{e}^{3{x}^{2}}}{x-2}.$\n\n| ${y}^{′}$ | $=$ | $(${{field-1}}$){e}^{3{x}^{2}}$ |\n| --- | --- | --- |\n|  |  | $(x-2)^{2}$ |" :question/worked-solution "We use the quotient rule with the numerator $u(x)={e}^{3{x}^{2}}$ and the denominator $v(x)=x-2.$\n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=6x{e}^{3{x}^{2}},\\,{v}^{′}(x)=1.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(6x{e}^{3{x}^{2}})(x-2)-({e}^{3{x}^{2}})(1)}{(x-2)^{2}} \\\\  & =\\frac{{e}^{3{x}^{2}}(6x(x-2)-1)}{(x-2)^{2}} \\\\  & =\\frac{(6{x}^{2}-12x-1){e}^{3{x}^{2}}}{(x-2)^{2}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-344143/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458"] :knowledge-point/questions ["q-344143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337034/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer/id #uuid "570adc82-cd21-5619-aec3-f919a02d9043" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "q-337034/field-1" :answer-field/id #uuid "1bf0396c-0208-5828-adaf-759d684902b9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-337034/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c" :answer-field/choices ["q-337034/field-1/b67476ffce451bf9cc94e82f22f7f4f4b23075d2e02b9ea63c2ad56fd611692c"] :db/ensure [:answer-field/validate]} {:db/id "q-337034" :question/id #uuid "fcf79804-1447-5e6a-9876-af943cc16ecc" :question/math-academy-id "q-337034" :question/problem "${lim}_{x\\to \\infty }(4{x}^{5}-7{x}^{3}+2x-9)=${{field-1}}" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(4{x}^{5}-7{x}^{3}+2x-9) & ={lim}_{x\\to \\infty }(4{x}^{5}) \\\\  & =4\\cdot {lim}_{x\\to \\infty }({x}^{5}) \\\\  & =\\infty \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337034/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4"] :knowledge-point/questions ["q-337034"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66676/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "636f3eeb-2b0b-500f-8432-760af752b21c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-66676/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "dafc643f-7417-520f-89e4-4500e39a39f8" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-66676/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" :answer/id #uuid "89a01df1-80da-5ab6-8171-5c94c697e1f9" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "q-66676/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d8ad6221-1e09-5c3d-84c6-0b0af2260bb2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-66676/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "bf967d73-3dcc-56f3-8343-4913d42fe212" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-66676/selection" :answer-field/id #uuid "18efa94c-87e6-5902-bf77-ba23f32281be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66676/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" :answer-field/choices ["q-66676/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-66676/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-66676/selection/0b6c8217aebc12683768e726b28497bd54d864909b2046c4906e8d4aea523e2b" "q-66676/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-66676/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-66676" :question/id #uuid "ef1dce47-33c1-5d2d-9b57-51a7492e8364" :question/math-academy-id "q-66676" :question/problem "Find the root of $y=3{e}^{x+1}+1.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n3{e}^{x+1}+1=0\n$$\n\nFirst, we isolate the term with the variable exponent by subtracting $1$ from both sides:\n\n$$\n\\begin{aligned}3{e}^{x+1}+1 & =0 \\\\ 3{e}^{x+1}+\\cancel{1}-\\cancel{1} & =0-1 \\\\ 3{e}^{x+1} & =-1\\end{aligned}\n$$\n\nDividing both sides of the last equation by $3,$ we get the following:\n\n$$\n\\begin{aligned}3{e}^{x+1} & =-1 \\\\ {e}^{x+1} & =-\\frac{1}{3}\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no roots." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66676/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ee02c223-dd7f-5c5d-b09f-e7bc6bd16b0c"] :knowledge-point/questions ["q-66676"] :db/ensure [:knowledge-point/validate]} {:db/id "q-61900/selection/4bbc9c6e499629b3785ee743c5d3fb94d156fe56fea29759f5bd6296990dd0a2" :answer/id #uuid "cb96bd79-8a0e-511a-9846-d6aff345451f" :answer/type :answer.type/math :answer/value "42\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61900/selection/ad3757a9b529881fd7a56c2284b7ce0532f89ba08787c674045f9664ee5ab311" :answer/id #uuid "d775e4da-bff3-5244-b679-627a622bc381" :answer/type :answer.type/math :answer/value "46\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61900/selection/c1fe5ac39a97696e8defb419754ab0b0c5116ed9b2a8fc649fd18f3a21a52c17" :answer/id #uuid "e95ab778-0380-58d1-b06d-3d510d9e66ca" :answer/type :answer.type/math :answer/value "48\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61900/selection/d46f4b95c8378fdd3b5663afcdd29e85f1be68a43e1057c9dc121241be314be1" :answer/id #uuid "00eb5f51-a676-5747-9833-0c9819c41c5e" :answer/type :answer.type/math :answer/value "36\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61900/selection/0428463fc5712f4311f7ff14705e5ce94007f7d62a67afd48ee41c599185697f" :answer/id #uuid "e5836484-db81-5bac-9204-7f129f355db2" :answer/type :answer.type/math :answer/value "54\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-61900/selection" :answer-field/id #uuid "c63731f0-38d7-5d5c-92d3-e426c953e29f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-61900/selection/4bbc9c6e499629b3785ee743c5d3fb94d156fe56fea29759f5bd6296990dd0a2" :answer-field/choices ["q-61900/selection/4bbc9c6e499629b3785ee743c5d3fb94d156fe56fea29759f5bd6296990dd0a2" "q-61900/selection/ad3757a9b529881fd7a56c2284b7ce0532f89ba08787c674045f9664ee5ab311" "q-61900/selection/c1fe5ac39a97696e8defb419754ab0b0c5116ed9b2a8fc649fd18f3a21a52c17" "q-61900/selection/d46f4b95c8378fdd3b5663afcdd29e85f1be68a43e1057c9dc121241be314be1" "q-61900/selection/0428463fc5712f4311f7ff14705e5ce94007f7d62a67afd48ee41c599185697f"] :db/ensure [:answer-field/validate]} {:db/id "q-61900" :question/id #uuid "1a826bad-db18-5714-a7b1-b24aaab55937" :question/math-academy-id "q-61900" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004701/assets/93a2ddce7e46f9855f0dd9ea499ae2762cb4538f844ecf7bed7d15d1669b0815.png)\n\nWhat is the total surface area of the rectangular prism above if it is $2\\,\\text{cm}$ long, $3\\,\\text{cm}$ wide, and $3\\,\\text{cm}$ tall?" :question/worked-solution "First, let's consider the net of our plank.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14004701/assets/66836a9004af1cc947cbcd70d99f696dd41eaca76214ca4f45a4e8434a7ec7f2.png)\n\n$$\n\n$$\n\nFrom the diagram, we have squares and rectangles.\n\nThe rectangles are $2\\,\\text{cm}$ long and $3\\,\\text{cm}$ high. So, the area of one rectangle is:\n\n$$\n\\text{Area of the rectangle}=2\\times 3=6\\,{\\text{cm}}^{2}.\n$$\n\nThe squares has the side equal to $3\\,\\text{cm}.$ Hence, the area of one square is:\n\n$$\n\\text{Area of the square}=3\\times 3=9\\,{\\text{cm}}^{2}.\n$$\n\nFinally, the surface area of the rectangular prism consists of $4$ rectangles and $2$ squares. \n\nTherefore, we get:\n\n$$\n\\begin{aligned}\\text{Surface area} & =4\\times (\\text{Area of the rectangle})+2\\times (\\text{Area of the square}) \\\\  & =4\\times 6+2\\times 9 \\\\  & =24+18 \\\\  & =42\\,{\\text{cm}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-61900/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "947eb2bb-0443-5740-9d45-847c70877270"] :knowledge-point/questions ["q-61900"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-237947"] :question/problem "In **ascending order,** the solutions of the equation ${x}^{2}\\cdot {4}^{x+1}+5x\\cdot {4}^{x+1}+6\\cdot {4}^{x+1}=0$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {4}^{x+1}+5x\\cdot {4}^{x+1}+6\\cdot {4}^{x+1} & =0 \\\\ ({x}^{2}+5x+6){4}^{x+1} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}+5x+6=0\\,\\text{and}\\,{4}^{x+1}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}+5x+6=0$ can be factored as\n\n$$\n(x+2)(x+3)=0,\n$$\n\nwhich leads to the solutions $x=-3,-2.$\n\n- The equation ${4}^{x+1}=0$ has no solutions because ${4}^{x+1}$ is positive for every real number $x.$\n\nTherefore, in ascending order, the original equation has the solutions \n\n$$\nx=-3\\,\\text{and}\\,x=-2.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-277246/field-1/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "b1fde28e-0c4d-5810-8db2-57c2fe530376" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-277246/field-1" :answer-field/id #uuid "1ec32963-41d1-5fbe-bf53-d129c1b4ac67" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-277246/field-1/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer-field/choices ["q-277246/field-1/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a"] :db/ensure [:answer-field/validate]} {:db/id "q-277246" :question/id #uuid "da4fbcaf-98e0-53a1-a049-ba27867c451c" :question/math-academy-id "q-277246" :question/problem "Find the root of $f(x)=-\\sqrt[9]{9-12x}-1.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n-\\sqrt[9]{9-12x}-1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-\\sqrt[9]{9-12x}-1 & =0 \\\\ -\\sqrt[9]{9-12x} & =1 \\\\ \\sqrt[9]{9-12x} & =-1 \\\\ (\\sqrt[9]{9-12x})^{9} & =(-1)^{9} \\\\ 9-12x & =-1 \\\\ -12x & =-10 \\\\ x & =\\frac{5}{6}\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{5}{6}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-277246/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52"] :knowledge-point/questions ["q-277246"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66671/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fe92af08-2da0-5fa9-bc36-bf0721ac11c0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-66671/selection/35ed9501ec5b62a7ed24d688fe6b06d37e655a56b304b49f7153e4cd1c78da7d" :answer/id #uuid "f56fa06e-af58-527d-b32a-c8ebc427bc3f" :answer/type :answer.type/math :answer/value "9+\\pi " :db/ensure [:answer/validate]} {:db/id "q-66671/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "bd8b5bf9-ef50-58e8-8080-81534695604c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-66671/selection/9ad252d1cf97c62503cbf027080ba4652b4415fd09900a11efb1074c3dfb0187" :answer/id #uuid "e5b1af55-eab5-50e5-bf60-679e8cd5fa37" :answer/type :answer.type/math :answer/value "3+\\pi " :db/ensure [:answer/validate]} {:db/id "q-66671/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "f80c714a-c38a-5989-a5bf-63d942710910" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-66671/selection" :answer-field/id #uuid "e05bafa3-54d6-563a-80c1-82e725c5db78" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66671/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-66671/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-66671/selection/35ed9501ec5b62a7ed24d688fe6b06d37e655a56b304b49f7153e4cd1c78da7d" "q-66671/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-66671/selection/9ad252d1cf97c62503cbf027080ba4652b4415fd09900a11efb1074c3dfb0187" "q-66671/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-66671" :question/id #uuid "0e64915a-a625-5406-a66c-f53248a7caab" :question/math-academy-id "q-66671" :question/problem "If $\\operatorname{cot}⁡x=-3$ for some $x$, then find the value of $\\operatorname{cot}⁡(x+9\\pi ).$" :question/worked-solution "The period of $y=\\operatorname{cot}⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+n\\pi ).\n$$\n\nSubstituting $n=9$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{cot}⁡x=\\operatorname{cot}⁡(x+9\\cdot \\pi )=\\operatorname{cot}⁡(x+9\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{cot}⁡x=-3,$ then $\\operatorname{cot}⁡(x+9\\pi )=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66671/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d02418c3-4c04-57b8-8f10-18858b1759ab"] :knowledge-point/questions ["q-66671"] :db/ensure [:knowledge-point/validate]}]
