my/reference/mathacademy/question-capture/13980294/assets/25575625f271ba827f15b6310c12ea86b4fbf624b4c5da52190404286fe5e531.png" :db/id #edb/ref 17592186280799}] :answer-field/correct {:answer/id #uuid "bc0db97a-0775-5778-9a70-c3a43a290fd1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/eadf7386a731c02931fc79d16d28d788c53917aa363100b32b4b2e9ec68db123.png" :db/id #edb/ref 17592186280797} :answer-field/id #uuid "b273c222-967a-50f1-800a-491189485fbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280794}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2f249a61-8c85-5ef5-a495-1d4fb62cb452" :question/math-academy-id "q-120632" :question/problem "Which of the following is the graph of the polar curve  $\\theta =\\frac{23\\pi }{18}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{23\\pi }{18}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{23\\pi }{18}$ with the positive $x$-axis. \n\nTherefore, the angle it makes with the negative $x$-axis is  \n\n$$\n\\frac{23\\pi }{18}-\\pi =\\frac{5\\pi }{18}.\n$$\n\n \n\nThe correct answer is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/eadf7386a731c02931fc79d16d28d788c53917aa363100b32b4b2e9ec68db123.png)"}] [{:db/id #edb/ref 17592186280800 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00fb5412-233f-5712-a315-0c5016c354a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{6}" :db/id #edb/ref 17592186280802} {:answer/id #uuid "5e17e4e1-b4ff-56de-8d61-067087af4f9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{3}" :db/id #edb/ref 17592186280803} {:answer/id #uuid "9cdcf54f-e548-53be-8964-a075d8774028" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{6}" :db/id #edb/ref 17592186280804} {:answer/id #uuid "29899a5b-7237-56ad-8bec-a5a677459ba3" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186280805} {:answer/id #uuid "cb438ce7-c7ad-5de8-abe2-e9f56cb1a6c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{4}" :db/id #edb/ref 17592186280806}] :answer-field/correct {:answer/id #uuid "5e17e4e1-b4ff-56de-8d61-067087af4f9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{3}" :db/id #edb/ref 17592186280803} :answer-field/id #uuid "dd2fa70d-2416-504b-abd6-23055b4c74f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280801}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "50583a09-5a93-5b8a-bebd-ee8cfe605b2d" :question/math-academy-id "q-120701" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/410822e9d39446151be39bc84028ef969e08eb967ece74f6c7e9fa0808ad3b76.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-1,\\sqrt{3})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{\\sqrt{3}}{-1}| \\\\  & =\\operatorname{arctan}⁡\\sqrt{3} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the second quadrant. So, we find the angle in the second quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{2\\pi }{3}.\n$$"}] [{:db/id #edb/ref 17592186280807 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4a9587b-fa91-5292-a96b-f80bf9789dde" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280809} {:answer/id #uuid "99e1d811-8523-5255-ad4a-b028f537c724" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{8}" :db/id #edb/ref 17592186280810} {:answer/id #uuid "7f837582-90ea-54d5-bb5f-e181ca108653" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186280811} {:answer/id #uuid "52996fad-1927-5d3c-b070-7df98d5e358a" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186280812} {:answer/id #uuid "de5d5a98-7d7e-5372-8e99-88622978bff1" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{4}" :db/id #edb/ref 17592186280813}] :answer-field/correct {:answer/id #uuid "7f837582-90ea-54d5-bb5f-e181ca108653" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186280811} :answer-field/id #uuid "e887ac5d-62b1-56a8-a06c-71363969b797" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280808}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5e8feed1-1dea-5a0a-b06f-1293cc678bb5" :question/math-academy-id "q-120704" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/03814c00b9e29f8a05507616ed08e3fe3daa484336e461012dc6c80799efc9e0.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-\\sqrt{6},-\\sqrt{2})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{2}}{-\\sqrt{6}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$"}] [{:db/id #edb/ref 17592186280814 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7de0eea9-da96-555b-b749-c50cb2fcbcff" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{3}{4})" :db/id #edb/ref 17592186280816} {:answer/id #uuid "f9841f9b-accc-5d14-ac7e-14a3742278ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{5}{4})" :db/id #edb/ref 17592186280817} {:answer/id #uuid "000550d8-3b59-511b-b499-ef21bac49e27" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{9}{5})" :db/id #edb/ref 17592186280818} {:answer/id #uuid "89f2846e-afa4-54fb-b867-2ff324338012" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{4}{5})" :db/id #edb/ref 17592186280819} {:answer/id #uuid "0afd22ba-fecd-524c-8abe-ab39da3cf052" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{3}{5})" :db/id #edb/ref 17592186280820}] :answer-field/correct {:answer/id #uuid "f9841f9b-accc-5d14-ac7e-14a3742278ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\operatorname{arctan}⁡(\\frac{5}{4})" :db/id #edb/ref 17592186280817} :answer-field/id #uuid "7c16c937-9c8b-56db-a67c-8939e9d5cf20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280815}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a0636bdf-59d0-5218-8933-aa8fbf2cda43" :question/math-academy-id "q-120708" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/c3d93c8d7d04af6783ef9149e15b5c1a59d1abb2744459004619a5ea2ef029e7.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(4,5)$, find the polar equation of the ray." :question/worked-solution "The angles that the ray makes with the positive $x$-axis is\n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{5}{4}).\\end{aligned}\n$$\n\nTherefore, since the ray lies in the first quadrant, its polar equation is\n\n$$\n\\theta =\\operatorname{arctan}⁡(\\frac{5}{4}).\n$$"}] [{:db/id #edb/ref 17592186280821 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef23603-c69c-5c86-98b6-b3b474af5491" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{8},\\sqrt{8})" :db/id #edb/ref 17592186280823} {:answer/id #uuid "dddceb47-73bc-5ca7-88c0-10c2ed345a53" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4)" :db/id #edb/ref 17592186280824} {:answer/id #uuid "ea6afa2b-1c19-5610-bf4f-dd49940d15ef" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186280825} {:answer/id #uuid "62f948f7-e73c-544d-b013-254d21436b25" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{2})" :db/id #edb/ref 17592186280826} {:answer/id #uuid "17c23022-ed3c-5fa5-8696-39c257e3770e" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186280827}] :answer-field/correct {:answer/id #uuid "ea6afa2b-1c19-5610-bf4f-dd49940d15ef" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186280825} :answer-field/id #uuid "f689beee-95f5-5e54-825c-bc99ee9e2ca1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280822}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bdcb6220-04a6-55a4-8393-0775393a9612" :question/math-academy-id "q-120730" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/84b17449880281367f50da89c39a7bcb1348c3a589aec74d9dec24eadb614ce7.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{3\\pi }{4}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{3\\pi }{4}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =8\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\sqrt{2} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =8\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{2},4\\sqrt{2}).$"}] [{:db/id #edb/ref 17592186280828 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4650445f-fe67-5c51-9c97-951a7acb0bc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{26\\pi }{15}" :db/id #edb/ref 17592186280830} {:answer/id #uuid "5a2ac67e-7b7e-5108-a0c2-4421dcf0e882" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{15}" :db/id #edb/ref 17592186280831} {:answer/id #uuid "e38a772b-0f31-5524-aca3-b31e22edfc74" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{15}" :db/id #edb/ref 17592186280832} {:answer/id #uuid "bba5ee2e-5aa4-51b6-9ef9-21e29b1837eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{15}" :db/id #edb/ref 17592186280833} {:answer/id #uuid "8539c6fb-0486-5bc7-a6b1-fb6f88e1f3a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{15}" :db/id #edb/ref 17592186280834}] :answer-field/correct {:answer/id #uuid "bba5ee2e-5aa4-51b6-9ef9-21e29b1837eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{15}" :db/id #edb/ref 17592186280833} :answer-field/id #uuid "4b075980-b8ae-55d6-b30c-765aa3eba0ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280829}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a5a952bc-ebaf-5525-bf7b-5b10a4e51c46" :question/math-academy-id "q-17151" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/4a908a59498e1bccef0601ce813ef0a4fa2b7e965c944c9951b13a9f50256459.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{4\\pi }{15}=\\frac{19\\pi }{15}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{19\\pi }{15}.$"}] [{:db/id #edb/ref 17592186280835 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b0474ae-7533-5c8c-a1ae-b05573bbdfec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi}{5}" :db/id #edb/ref 17592186280837}] :answer-field/correct {:answer/id #uuid "3b0474ae-7533-5c8c-a1ae-b05573bbdfec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi}{5}" :db/id #edb/ref 17592186280837} :answer-field/id #uuid "d40b4a64-ba9f-5ee5-b5a7-92e8c2734afb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280836}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31aee3cc-1ed0-5537-b1d6-50bdf3f13e6f" :question/math-academy-id "q-274764" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/9baa57482196e6c521c48464b9f0e07de0e97952263cff1671d38fecec751083.png)\n\nFind the polar equation of the ray shown above. Assume that the polar angle is in the range $[0,2\\pi ).$\n\nThe polar equation is $\\theta =$\n{{field-1}}." :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{\\pi }{5}=\\frac{4\\pi }{5}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{4\\pi }{5}.$"}]