795704183ed2212.png)"}] [{:db/id #edb/ref 17592186280866 :knowledge-point/_questions [{:knowledge-point/id #uuid "407616a9-e448-5652-9882-a1edf19600f8" :knowledge-point/title "Identifying a Radial Line Given Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8746f7b-d9f6-50da-8b4a-dc7b5c5f8d3f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/4b49a1e2a26660898ba645c3a7db43543fc1c88ae14aaa58bd93904ded731691.png" :db/id #edb/ref 17592186280868} {:answer/id #uuid "4ad78729-3ed0-5891-a13d-db92a3a41bcb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/845121f81ff0dbe29a073319fbdeeab86e1c8b145471e8d3ec655d49d05d86cd.png" :db/id #edb/ref 17592186280869} {:answer/id #uuid "eef12ed0-bf8f-5a9c-8bf0-d7b3c3df5539" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/ae4e3ed9c9e3947297eb9bf18310518d19206277c38dc9019c1e008e4ab16774.png" :db/id #edb/ref 17592186280870} {:answer/id #uuid "bc502a28-6d49-578d-a9b6-ab1defbdb227" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/a27a9c48e5012fb45887788ee919f00fec13d5c22ead31c4b0cf7bfee43faf1f.png" :db/id #edb/ref 17592186280871} {:answer/id #uuid "5a2dd873-11b5-563d-9c54-5eef266e8173" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/f2eab2143bcafa89f6ff71d35b07d83beea9f71a6e0b43e653022bf9afa5b4eb.png" :db/id #edb/ref 17592186280872}] :answer-field/correct {:answer/id #uuid "4ad78729-3ed0-5891-a13d-db92a3a41bcb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/845121f81ff0dbe29a073319fbdeeab86e1c8b145471e8d3ec655d49d05d86cd.png" :db/id #edb/ref 17592186280869} :answer-field/id #uuid "b3dbe57a-b46e-5d14-acbb-afb026695317" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280867}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ec46beaa-3ae8-52b3-996d-d5d6f0dcf65c" :question/math-academy-id "q-40830" :question/problem "Which of the following is the graph of the polar curve  $\\theta =\\frac{11\\pi }{15}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{11\\pi }{15}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{11\\pi }{15}$ with the positive $x$-axis. \n\nTherefore, the angle it makes with the negative $x$-axis is \n\n$$\n\\pi -\\frac{11\\pi }{15}=\\frac{4\\pi }{15}.\n$$\n\n \n\nThe correct answer is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/845121f81ff0dbe29a073319fbdeeab86e1c8b145471e8d3ec655d49d05d86cd.png)"}] [{:db/id #edb/ref 17592186134265 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "981ba4e7-33c9-5a7e-948f-f50fe4763a70" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{2})" :db/id #edb/ref 17592186132033} {:answer/id #uuid "b0585a0b-e1b5-5899-b51c-f2f6767c418d" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4\\sqrt{2})" :db/id #edb/ref 17592186132034} {:answer/id #uuid "dc9ee54c-fd00-5bee-aef8-d5893a35e049" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4\\sqrt{3})" :db/id #edb/ref 17592186132035} {:answer/id #uuid "41cfaaff-ed0d-596d-9958-df2dc78501d7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4)" :db/id #edb/ref 17592186132036} {:answer/id #uuid "60bff2cb-e1e3-5f42-9044-9ada3c2ae98e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{3})" :db/id #edb/ref 17592186132037}] :answer-field/correct {:answer/id #uuid "41cfaaff-ed0d-596d-9958-df2dc78501d7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4)" :db/id #edb/ref 17592186132036} :answer-field/id #uuid "738df0fd-bac8-51c6-8dab-997fca6c0b3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132032}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c864f9-8a06-59dd-91e8-789300497ddc" :question/math-academy-id "q-41263" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (\\frac{1}{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"}] [{:db/id #edb/ref 17592186280873 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30059b98-be76-5e64-84f4-a067ffe27dfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{5}" :db/id #edb/ref 17592186280875} {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} {:answer/id #uuid "384e4b95-c305-541c-a02b-424fc165840e" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{5}" :db/id #edb/ref 17592186280877} {:answer/id #uuid "a11f951f-5431-55f2-92d0-7af42db47456" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{9\\pi }{5}" :db/id #edb/ref 17592186280878} {:answer/id #uuid "5c00750c-0622-51d2-a383-32bcbb57dcd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{5}" :db/id #edb/ref 17592186280879}] :answer-field/correct {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} :answer-field/id #uuid "d2c9dca2-e33d-5552-bbc3-b76df3e4caf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280874}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94fcca01-7833-5698-8331-09ba86372399" :question/math-academy-id "q-8616" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/e76766c18330d476af9253ecb2d08540df06146a9ac2fdc6bfbe6f8157201f6b.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{\\pi }{5}=\\frac{6\\pi }{5}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{6\\pi }{5}.$"}] [{:db/id #edb/ref 17592186280880 :knowledge-poin