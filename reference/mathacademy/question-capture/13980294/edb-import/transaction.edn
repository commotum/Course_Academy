5a87b0b2a6bc9f54c725e519a3574e96c1b384492fb9a91a4e10" :answer/id #uuid "99e1d811-8523-5255-ad4a-b028f537c724" :answer/type :answer.type/math :answer/value "\\theta =\\frac{5\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "q-120704/selection/306fbd40a6d16ba38b58e6d5b3d8da18aa7ac4f432c85a3741badafa685cf9d5" :answer/id #uuid "c4a9587b-fa91-5292-a96b-f80bf9789dde" :answer/type :answer.type/math :answer/value "\\theta =\\frac{6\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-120704/selection/9d4d1c66e82dbe006fc485d871e23727a78e849470fa0546d1e250098f1ba0f7" :answer/id #uuid "7f837582-90ea-54d5-bb5f-e181ca108653" :answer/type :answer.type/math :answer/value "\\theta =\\frac{7\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-120704/selection/e8333d521331a537ffa1342cb69c44a3fc695d9336fd3c013730049880b2aca3" :answer/id #uuid "de5d5a98-7d7e-5372-8e99-88622978bff1" :answer/type :answer.type/math :answer/value "\\theta =\\frac{5\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-120704/selection" :answer-field/id #uuid "e887ac5d-62b1-56a8-a06c-71363969b797" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120704/selection/9d4d1c66e82dbe006fc485d871e23727a78e849470fa0546d1e250098f1ba0f7" :answer-field/choices ["q-120704/selection/c3f1b2278971eee7a6c21dfe4d389816019b5ed3a9949fb44d8116125acd5842" "q-120704/selection/602d5261bd8f5a87b0b2a6bc9f54c725e519a3574e96c1b384492fb9a91a4e10" "q-120704/selection/306fbd40a6d16ba38b58e6d5b3d8da18aa7ac4f432c85a3741badafa685cf9d5" "q-120704/selection/9d4d1c66e82dbe006fc485d871e23727a78e849470fa0546d1e250098f1ba0f7" "q-120704/selection/e8333d521331a537ffa1342cb69c44a3fc695d9336fd3c013730049880b2aca3"] :db/ensure [:answer-field/validate]} {:db/id "q-120704" :question/id #uuid "5e8feed1-1dea-5a0a-b06f-1293cc678bb5" :question/math-academy-id "q-120704" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/03814c00b9e29f8a05507616ed08e3fe3daa484336e461012dc6c80799efc9e0.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-\\sqrt{6},-\\sqrt{2})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{2}}{-\\sqrt{6}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120704/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585"] :knowledge-point/questions ["q-120704"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321877/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203" :answer/id #uuid "550770a1-1f93-53ab-8833-3c49fd2a29e1" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-321877/field-1" :answer-field/id #uuid "6414612c-9167-5a29-bbaf-de093e1dda00" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321877/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203" :answer-field/choices ["q-321877/field-1/608b697f811192589eec3729e28e5d056be7cd5127af1a846d717a33508ae203"] :db/ensure [:answer-field/validate]} {:db/id "q-321877" :question/id #uuid "b07a8a3a-8c36-558d-a7ff-2f767c894ca2" :question/math-academy-id "q-321877" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/369954f7abfabce27d112287ed232ce9a3a7e75ce993bba6300203777442f8fc.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(2,2),$ find the polar equation of the ray. Assume that the polar angle is in the range $[0,2\\pi ).$\n\n$\\theta =$\n{{field-1}}." :question/worked-solution "The angles that the ray makes with the positive $x$-axis is \n\n$$\n\\begin{aligned}\\theta  & =\\theta =arctan\\,(\\frac{y}{x}) \\\\  & =arctan\\,(\\frac{2}{2}) \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, since the ray lies in the first quadrant, its polar equation is\n\n$$\n\\theta =\\frac{\\pi }{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-321877/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585"] :knowledge-point/questions ["q-321877"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321889/field-1/d569d64e1b94dabdc9f89c1070c848c6c96526a20f320d6b4971ae3a32604bcf" :answer/id #uuid "4a8046e0-eb6f-5bef-bcda-247cd7ca6dcb" :answer/type :answer.type/math :answer/value "\\frac{2\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-321889/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08" :answer/id #uuid "b619982c-f5e8-5cdb-8531-e80114c7a4db" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-321889/field-1" :answer-field/id #uuid "2aaed982-f05e-512a-b61d-1f879d3dc05a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321889/field-1/d569d64e1b94dabdc9f89c1070c848c6c96526a20f320d6b4971ae3a32604bcf" :answer-field/choices ["q-321889/field-1/d569d64e1b94dabdc9f89c1070c848c6c96526a20f320d6b4971ae3a32604bcf" "q-321889/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08"] :db/ensure [:answer-field/validate]} {:db/id "q-321889" :question/id #uuid "c0b99479-a2a8-50dc-ae3c-121887072818" :question/math-academy-id "q-321889" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/e64215da53594d7e7bc24f8df953aa84f0648cd3ab58d0a8b8005be653c28902.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-3,3\\sqrt{3}),$ find the polar equation of the ray. Assume that the polar angle is in the range $[0,2\\pi ).$\n\n$\\theta =$ \n {{field-1}}." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{3\\sqrt{3}}{(-3)}| \\\\  & =\\operatorname{arctan}⁡(\\sqrt{3}) \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the second quadrant. So, we find the angle in the second quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{2\\pi }{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321889/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585"] :knowledge-point/questions ["q-321889"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120701/selection/004b40e9dbf8f036600a30e235f0e875769fd38731126675bdaffac624ba888c" :answer/id #uuid "00fb5412-233f-5712-a315-0c5016c354a2" :answer/type :answer.type/math :answer/value "\\theta =\\frac{11\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-120701/selection/7e2b48383d5d1cc80a4b40001f958af2e676fec2cb1400c3d40af53d8105a997" :answer/id #uuid "9cdcf54f-e548-53be-8964-a075d8774028" :answer/type :answer.type/math :answer/value "\\theta =\\frac{5\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-120701/selection/e11120e62f1aa183245e121f00e47ebd77ea4b6960481d9b3f83755d0f8ce826" :answer/id #uuid "cb438ce7-c7ad-5de8-abe2-e9f56cb1a6c8" :answer/type :answer.type/math :answer/value "\\theta =\\frac{7\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-120701/selection/c3f1b2278971eee7a6c21dfe4d389816019b5ed3a9949fb44d8116125acd5842" :answer/id #uuid "29899a5b-7237-56ad-8bec-a5a677459ba3" :answer/type :answer.type/math :answer/value "\\theta =\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-120701/selection/085377617428ca5593e1c4521bc89fb219cb72bde070d1b7a71c3ae7e00e1c0b" :answer/id #uuid "5e17e4e1-b4ff-56de-8d61-067087af4f9c" :answer/type :answer.type/math :answer/value "\\theta =\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-120701/selection" :answer-field/id #uuid "dd2fa70d-2416-504b-abd6-23055b4c74f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120701/selection/085377617428ca5593e1c4521bc89fb219cb72bde070d1b7a71c3ae7e00e1c0b" :answer-field/choices ["q-120701/selection/004b40e9dbf8f036600a30e235f0e875769fd38731126675bdaffac624ba888c" "q-120701/selection/7e2b48383d5d1cc80a4b40001f958af2e676fec2cb1400c3d40af53d8105a997" "q-120701/selection/e11120e62f1aa183245e121f00e47ebd77ea4b6960481d9b3f83755d0f8ce826" "q-120701/selection/c3f1b2278971eee7a6c21dfe4d389816019b5ed3a9949fb44d8116125acd5842" "q-120701/selection/085377617428ca5593e1c4521bc89fb219cb72bde070d1b7a71c3ae7e00e1c0b"] :db/ensure [:answer-field/validate]} {:db/id "q-120701" :question/id #uuid "50583a09-5a93-5b8a-bebd-ee8cfe605b2d" :question/math-academy-id "q-120701" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/410822e9d39446151be39bc84028ef969e08eb967ece74f6c7e9fa0808ad3b76.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-1,\\sqrt{3})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{\\sqrt{3}}{-1}| \\\\  & =\\operatorname{arctan}⁡\\sqrt{3} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the second quadrant. So, we find the angle in the second quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{2\\pi }{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120701/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585"] :knowledge-point/questions ["q-120701"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321970/field-1/a91a7621b6107eac2d4abe9f7b94fcb9f22fed7fe2c98ae77388edc11c18a78a" :answer/id #uuid "14d5b3af-afa4-5db2-9471-7809994c7946" :answer/type :answer.type/math :answer/value "-\\frac{9\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-321970/field-1" :answer-field/id #uuid "2726ac69-dc5e-55b0-8fd5-b45373a8ddfb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321970/field-1/a91a7621b6107eac2d4abe9f7b94fcb9f22fed7fe2c98ae77388edc11c18a78a" :answer-field/choices ["q-321970/field-1/a91a7621b6107eac2d4abe9f7b94fcb9f22fed7fe2c98ae77388edc11c18a78a"] :db/ensure [:answer-field/validate]} {:db/id "q-321970/field-2/b534fc82a381e66f3167ba57cb5e7d08d88e9dce97f3edf10738b1c11b15a695" :answer/id #uuid "c8c60cf1-f82c-5f52-9a5a-01cb41bbe52c" :answer/type :answer.type/math :answer/value "\\frac{9\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-321970/field-2" :answer-field/id #uuid "cdd8fce3-5111-54f6-8829-36c2c9106cb0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321970/field-2/b534fc82a381e66f3167ba57cb5e7d08d88e9dce97f3edf10738b1c11b15a695" :answer-field/choices ["q-321970/field-2/b534fc82a381e66f3167ba57cb5e7d08d88e9dce97f3edf10738b1c11b15a695"] :db/ensure [:answer-field/validate]} {:db/id "q-321970" :question/id #uuid "fe0dfb5a-6d65-5994-a697-3c4fd1cac5cc" :question/math-academy-id "q-321970" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/5e29d99fc6ae3a848bfe59ab9e77595ab9ca2a605d0d03139e8599adf15e6fd9.png)\n\nThe polar curve $r=9$ and the ray $\\theta =\\frac{3\\pi }{4}$ intersect at the point $P,$ as shown above. The Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(9,\\frac{3\\pi }{4}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =9cos\\,(\\frac{3\\pi }{4}) \\\\  & =9\\cdot -\\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{9\\sqrt{2}}{2} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =9sin\\,(\\frac{3\\pi }{4}) \\\\  & =9\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{9\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{9\\sqrt{2}}{2},\\frac{9\\sqrt{2}}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321970/field-1" "q-321970/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e"] :knowledge-point/questions ["q-321970"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-41263"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (\\frac{1}{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-87139/selection/04248b7974473e2c80e17480bd56dc2d70674364dcdc1fd2672ae7784415daf6" :answer/id #uuid "94c04524-f586-5840-aca7-1e94e4e2f476" :answer/type :answer.type/math :answer/value "(-3\\sqrt{2},3\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-87139/selection/bf142c9b8ee84f5876f21be0454fe0a22b11bc51e2878dcb340c051296ab9a31" :answer/id #uuid "1a41196c-4d3b-58e9-a563-55f2e4cedc34" :answer/type :answer.type/math :answer/value "(3,-3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-87139/selection/51f292bdc14e6a0ab7db1a9758ae8ac5d973ec52c589b06bc561d60326339d90" :answer/id #uuid "224bcd89-5caa-5691-ba4b-2f4d6fcc70fd" :answer/type :answer.type/math :answer/value "(-3,-3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-87139/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" :answer/id #uuid "167202a1-76a6-5739-962c-6f02e75b82c0" :answer/type :answer.type/math :answer/value "(-3,3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-87139/selection/d635d4ebdb02d13ab5613f569a772ef4d04bde0fe33cbad1f78527c64cef71e0" :answer/id #uuid "b069363a-92f8-593b-9e3b-c08620bad3a7" :answer/type :answer.type/math :answer/value "(-3\\sqrt{3},3)" :db/ensure [:answer/validate]} {:db/id "q-87139/selection" :answer-field/id #uuid "b2decc71-3062-55f2-a60e-3571d178a7b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87139/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" :answer-field/choices ["q-87139/selection/04248b7974473e2c80e17480bd56dc2d70674364dcdc1fd2672ae7784415daf6" "q-87139/selection/bf142c9b8ee84f5876f21be0454fe0a22b11bc51e2878dcb340c051296ab9a31" "q-87139/selection/51f292bdc14e6a0ab7db1a9758ae8ac5d973ec52c589b06bc561d60326339d90" "q-87139/selection/8c3f8c21f70ae79b2bb61f85c1a3f3ed3c53b35cb0a2427d85573a589f114f4e" "q-87139/selection/d635d4ebdb02d13ab5613f569a772ef4d04bde0fe33cbad1f78527c64cef71e0"] :db/ensure [:answer-field/validate]} {:db/id "q-87139" :question/id #uuid "f9cc0f30-0e30-5e6d-ac7f-35bd27e7673c" :question/math-academy-id "q-87139" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/386a4b395d45276284606b0f079be16881af717ba7e791ab62d8df34743f0269.png)\n\nThe polar curve $r=6$ and the ray $\\theta =\\frac{2\\pi }{3}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(6,\\frac{2\\pi }{3}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3 \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-3,3\\sqrt{3}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87139/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc8d4944-9005-5712-ad8