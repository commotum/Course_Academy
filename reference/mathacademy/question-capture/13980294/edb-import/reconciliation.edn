t{2}}{2} \\\\  & =\\frac{9\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{9\\sqrt{2}}{2},\\frac{9\\sqrt{2}}{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/state.json" "file_sha256" "7573a241f0f104e940ddce4d0579fd4fa7f67cc52e49589d7bd65b1ad94ba99b"} {"question" "q-321970" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/activity-metadata.json" "file_sha256" "8245313d6a1a9363cc6b5889ea8e012c290586419323a4fbba4aa5e1cfd1f2de"} {"question" "q-321970" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/state.json" "file_sha256" "7573a241f0f104e940ddce4d0579fd4fa7f67cc52e49589d7bd65b1ad94ba99b"} {"question" "q-321970" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9\\sqrt{2}}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/state.json" "file_sha256" "7573a241f0f104e940ddce4d0579fd4fa7f67cc52e49589d7bd65b1ad94ba99b"} {"question" "q-321970" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/state.json" "file_sha256" "7573a241f0f104e940ddce4d0579fd4fa7f67cc52e49589d7bd65b1ad94ba99b"} {"question" "q-321970" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9\\sqrt{2}}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/state.json" "file_sha256" "7573a241f0f104e940ddce4d0579fd4fa7f67cc52e4