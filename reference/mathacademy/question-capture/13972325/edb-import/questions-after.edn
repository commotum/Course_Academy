#{[{:db/id #edb/ref 17592186275502 :knowledge-point/_questions [{:knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f074cf0-d381-52e4-90e9-d74cab79631e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186275504} {:answer/id #uuid "e5017409-f15c-5adb-8dd5-6c9a61279f0f" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186275505} {:answer/id #uuid "85354926-9425-5e53-b0a4-57f3c8ba1349" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186275506} {:answer/id #uuid "a8f6f587-a29f-536d-9290-c2e2639e5c4e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186275507} {:answer/id #uuid "d4206203-dd0a-51cb-9924-bc39b08707e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x+1" :db/id #edb/ref 17592186275508}] :answer-field/correct {:answer/id #uuid "85354926-9425-5e53-b0a4-57f3c8ba1349" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186275506} :answer-field/id #uuid "472d14d4-cccd-5c9c-8215-4835717cbb8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275503}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e1901497-5f36-5821-ad5c-6868c23d402d" :question/math-academy-id "q-119863" :question/problem "$\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x{sin}^{2}⁡x}=$" :question/worked-solution "First, we rewrite the numerator using $1-{cos}^{2}⁡x={sin}^{2}⁡x:$\n\n$$\n\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x{sin}^{2}⁡x}=\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x{sin}^{2}⁡x}\n$$\n\nNext, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x{sin}^{2}⁡x} & =\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x\\cdot {sin}^{2}⁡x} \\\\  & =\\frac{\\cancel{{sin}^{2}⁡x}}{\\operatorname{cos}⁡x\\cdot \\cancel{{sin}^{2}⁡x}} \\\\  & =\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x{sin}^{2}⁡x}=\\operatorname{sec}⁡x.\n$$"}] [{:db/id #edb/ref 17592186275509 :knowledge-point/_questions [{:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdcf00ca-3e65-5f6c-a19e-0572d77c23aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186275511} {:answer/id #uuid "3b243a0d-648a-58a9-99a6-9b8d5daba53c" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275512} {:answer/id #uuid "02d8711d-8d33-5737-ba9c-9cf97ef8c905" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186275513} {:answer/id #uuid "2546ab50-f46d-56ce-91af-19222b11aeba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275514} {:answer/id #uuid "023a19a5-1840-5ad0-a53d-a5d796e6bb76" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275515}] :answer-field/correct {:answer/id #uuid "2546ab50-f46d-56ce-91af-19222b11aeba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275514} :answer-field/id #uuid "a3eb7488-b75e-5426-81d9-a1c990220bea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275510}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "414f60cd-2190-52c9-a257-e6caaf96811e" :question/math-academy-id "q-119867" :question/problem "Simplify $\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}-\\operatorname{sin}⁡x$" :question/worked-solution "First, we rewrite the numerator of the first term using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}-\\operatorname{sin}⁡x=\\frac{1-{sin}^{2}⁡x}{1-\\operatorname{sin}⁡x}-\\operatorname{sin}⁡x\n$$\n\nNext, we factor the numerator of the first term as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡x}{1-\\operatorname{sin}⁡x}-\\operatorname{sin}⁡x & =\\frac{(1-\\operatorname{sin}⁡x)(1+\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x}-\\operatorname{sin}⁡x \\\\  & =\\frac{\\cancel{(1-\\operatorname{sin}⁡x)}(1+\\operatorname{sin}⁡x)}{\\cancel{1-\\operatorname{sin}⁡x}}-\\operatorname{sin}⁡x \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1}-\\operatorname{sin}⁡x \\\\  & =1+\\operatorname{sin}⁡x-\\operatorname{sin}⁡x \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275516 :knowledge-point/_questions [{:knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9360363d-517d-58d7-8777-7d3a0ce4358b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186275518} {:answer/id #uuid "9388ad1b-ecc3-52f9-b7bd-b65e265412e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275519} {:answer/id #uuid "3578b703-b87e-50ab-8769-fb3da46f5b2d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275520} {:answer/id #uuid "51a5b95d-f66f-595c-a9b5-eb88de385392" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275521} {:answer/id #uuid "f2175d00-241d-5bcc-8c2c-c0ea39e73723" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275522}] :answer-field/correct {:answer/id #uuid "9388ad1b-ecc3-52f9-b7bd-b65e265412e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275519} :answer-field/id #uuid "16a60b5c-2f1d-52ea-95bd-c17067be0748" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275517}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b3e2d9-9fd7-5939-a2f6-14e8a414a984" :question/math-academy-id "q-23799" :question/problem "$\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nNext, we rewrite the numerator using $1-{sin}^{2}⁡\\theta ={cos}^{2}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta {cos}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }}{2\\operatorname{sin}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nThen, we rewrite $\\operatorname{tan}⁡\\theta $ using its definition and simplify further:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡\\theta }}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\cancel{\\operatorname{sin}⁡\\theta }} \\\\  & =\\frac{1}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2} \\\\  & =\\frac{1}{\\cancel{\\operatorname{cos}⁡\\theta }}\\cdot \\frac{\\cancel{\\operatorname{cos}⁡\\theta }}{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186275523 :knowledge-point/_questions [{:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f0e58ff-5474-5224-94e3-4abd401f7c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186275525} {:answer/id #uuid "cdae2963-3f49-5581-8d07-496462e34261" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275526} {:answer/id #uuid "19bb7ca2-8721-569a-85c9-30faad1d7076" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275527} {:answer/id #uuid "45278438-d5a7-504c-9a31-4c8cf5453455" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275528} {:answer/id #uuid "ec66259c-8018-5545-a8f1-c5caecf8bb93" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275529}] :answer-field/correct {:answer/id #uuid "19bb7ca2-8721-569a-85c9-30faad1d7076" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275527} :answer-field/id #uuid "b247076c-c1ac-5479-a608-edf44d31b8da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275524}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "34fb018a-fb92-5d81-97f5-ac350e3ba4c9" :question/math-academy-id "q-65230" :question/problem "Simplify the expression $\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x+1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{cos}^{2}⁡x={sin}^{2}⁡x.$\n\n$$\n\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x+1}=\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x+1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡x}{\\operatorname{cos}⁡x+1} & =\\frac{(1+\\operatorname{cos}⁡x)(1-\\operatorname{cos}⁡x)}{\\operatorname{cos}⁡x+1} \\\\  & =\\frac{\\cancel{(1+\\operatorname{cos}⁡x)}(1-\\operatorname{cos}⁡x)}{\\cancel{\\operatorname{cos}⁡x+1}} \\\\  & =\\frac{1-\\operatorname{cos}⁡x}{1} \\\\  & =1-\\operatorname{cos}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275530 :knowledge-point/_questions [{:knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edc7a7c1-01cb-58a1-8443-be46583ee0b7" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275532} {:answer/id #uuid "7f4ef61b-bc65-5764-9680-29afdfd7b0f9" :answer/type {:db/ident :answer.type/math} :answer/value "1+{sin}^{2}⁡x" :db/id #edb/ref 17592186275533} {:answer/id #uuid "3a2e9d96-d438-5f60-9852-f57fe414d806" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275534} {:answer/id #uuid "838dc6cf-5826-5187-941c-585adf151e80" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275535} {:answer/id #uuid "52097a03-b42c-5e34-baad-3dcdce9487b1" :answer/type {:db/ident :answer.type/math} :answer/value "-2{sin}^{2}⁡x" :db/id #edb/ref 17592186275536}] :answer-field/correct {:answer/id #uuid "3a2e9d96-d438-5f60-9852-f57fe414d806" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275534} :answer-field/id #uuid "c40e6960-11fd-5203-a167-d776fb9727ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275531}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "05f2c004-05bf-58a5-a39c-419549c9f5dc" :question/math-academy-id "q-65231" :question/problem "If $\\frac{1-\\operatorname{sin}⁡x}{{cos}^{2}⁡x}=\\frac{1}{f(x)},$ then $f(x)=$" :question/worked-solution "First, we rewrite the denominator using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{1-\\operatorname{sin}⁡x}{{cos}^{2}⁡x}=\\frac{1-\\operatorname{sin}⁡x}{1-{sin}^{2}⁡x}\n$$\n\nNext, we factor the denominator as difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-\\operatorname{sin}⁡x}{1-{sin}^{2}⁡x} & =\\frac{1-\\operatorname{sin}⁡x}{(1-\\operatorname{sin}⁡x)(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{\\cancel{1-\\operatorname{sin}⁡x}}{\\cancel{(1-\\operatorname{sin}⁡x)}(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{1}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nTherefore, $f(x)=1+\\operatorname{sin}⁡x.$"}]}
