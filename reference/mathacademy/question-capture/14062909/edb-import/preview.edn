\text{d}y}{\\text{d}x} & =-\\frac{4(x-3)}{9y}\\end{aligned}\n$$" 13194139535338 true] [17592186344473 1000 #edb/ref 17592186344474 13194139535338 true] [17592186344473 1000 #edb/ref 17592186344475 13194139535338 true] [17592186344473 1000 #edb/ref 17592186344476 13194139535338 true] [17592186344473 1000 #edb/ref 17592186344477 13194139535338 true] [17592186344473 1000 #edb/ref 17592186344478 13194139535338 true] [17592186344473 1040 #edb/ref 17592186045450 13194139535338 true] [17592186344473 1041 "selection" 13194139535338 true] [17592186344473 1104 #edb/ref 17592186344475 13194139535338 true] [17592186344473 1110 #uuid "b983e182-647e-5d29-b7d3-d8698920c28f" 13194139535338 true] [17592186344474 1034 "\\frac{2(x-3)}{3y}" 13194139535338 true] [17592186344474 1103 #edb/ref 17592186045453 13194139535338 true] [17592186344474 1111 #uuid "665f1313-3d2e-5cee-87ee-d5ba94bc57ec" 13194139535338 true] [17592186344475 1034 "-\\frac{4(x-3)}{9y}" 13194139535338 true] [17592186344475 1103 #edb/ref 17592186045453 13194139535338 true] [17592186344475 1111 #uuid "ae3772bf-6806-527b-a9af-4abca19338f7" 13194139535338 true] [17592186344476 1034 "-\\frac{4(y-3)}{9x}" 13194139535338 true] [17592186344476 1103 #edb/ref 17592186045453 13194139535338 true] [17592186344476 1111 #uuid "798265db-ae30-5a90-88cb-5a0dc1981d75" 13194139535338 true] [17592186344477 1034 "-\\frac{3y}{2(x-3)}" 13194139535338 true] [17592186344477 1103 #edb/ref 17592186045453 13194139535338 true] [17592186344477 1111 #uuid "1a348b22-7ab4-5172-970d-494351019936" 13194139535338 true] [17592186344478 1034 "\\frac{9x}{4(y-3)}" 13194139535338 true] [17592186344478 1103 #edb/ref 17592186045453 13194139535338 true] [17592186344478 1111 #uuid "a8b16115-bff3-5f6f-a0c5-7bbb4bc73e1b" 13194139535338 true] [17592186344479 1017 #edb/ref 17592186344480 13194139535338 true] [17592186344479 1089 "q-312780" 13194139535338 true] [17592186344479 1091 #edb/ref 17592186045465 13194139535338 true] [17592186344479 1100 "![](/home/jake/Develo