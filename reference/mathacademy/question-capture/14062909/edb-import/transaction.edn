6e69eb3e22b" :question/math-academy-id "q-127493" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/f24d078ca0dc57ebd12778b7862683b0289e9c0d4c664639bd210dcc1f7c6d1b.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at the origin and has a radius of $4,$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=16.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(16) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127493/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1331279e-1a5f-5f6f-9104-0c88e1f9f6d0"] :knowledge-point/questions ["q-127493"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127497/selection/39b71b81caa85dc2e34f9b17cfd78457e70e5fd50d23d10f7eef4f0d8dbe69dc" :answer/id #uuid "e98a27c2-fe1a-5c99-8192-a42813ca62c2" :answer/type :answer.type/math :answer/value "-(x+1)y" :db/ensure [:answer/validate]} {:db/id "q-127497/selection/521e0b2f88dc14ce28247e2035916d40fd7d9156f41658b8d131212679dd359f" :answer/id #uuid "d01b4e02-8bc2-50f5-8a2f-d8ba9f925df3" :answer/type :answer.type/math :answer/value "\\frac{1-x}{y}" :db/ensure [:answer/validate]} {:db/id "q-127497/selection/44fac0a300699f47eaf42224d9bf54a73081cd9eac995355dd4bdf75676bbc9a" :answer/id #uuid "f68d9db6-a081-523e-abc1-8a38c58b966a" :answer/type :answer.type/math :answer/value "-\\frac{x+1}{y}" :db/ensure [:answer/validate]} {:db/id "q-127497/selection/572c73870ced7837dd84495ccc2da75d252c1316cf8026944c830af9dabd374e" :answer/id #uuid "47205664-36e4-5beb-85c8-6dc57fbad80c" :answer/type :answer.type/math :answer/value "\\frac{x+1}{y}" :db/ensure [:answer/validate]} {:db/id "q-127497/selection/2efe3258761af36e6e532dbde6b01fe3ab9e77f29a347db03f197d313c4de417" :answer/id #uuid "47097999-98b6-5670-8195-340436682d72" :answer/type :answer.type/math :answer/value "(1-x)y" :db/ensure [:answer/validate]} {:db/id "q-127497/selection" :answer-field/id #uuid "eeea34fc-8fe7-598f-b1a6-465bcec53034" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127497/selection/521e0b2f88dc14ce28247e2035916d40fd7d9156f41658b8d131212679dd359f" :answer-field/choices ["q-127497/selection/39b71b81caa85dc2e34f9b17cfd78457e70e5fd50d23d10f7eef4f0d8dbe69dc" "q-127497/selection/521e0b2f88dc14ce28247e2035916d40fd7d9156f41658b8d131212679dd359f" "q-127497/selection/44fac0a300699f47eaf42224d9bf54a73081cd9eac995355dd4bdf75676bbc9a" "q-127497/selection/572c73870ced7837dd84495ccc2da75d252c1316cf8026944c830af9dabd374e" "q-127497/selection/2efe3258761af36e6e532dbde6b01fe3ab9e77f29a347db03f197d313c4de417"] :db/ensure [:answer-field/validate]} {:db/id "q-127497" :question/id #uuid "5d6ad7e4-7acd-5527-83e9-b8c007bd5d06" :question/math-academy-id "q-127497" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/a3ca092dc7c0668ac465d4832b91a2b831af057ff22e357b4e7105bfb454ea18.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(1,0)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-1)^{2}+(y-0)^{2}={2}^{2}\\,⟹\\,(x-1)^{2}+{y}^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x-1)^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x-1)^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2(x-1)+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2(x-1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1-x}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127497/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1331279e-1a5f-5f6f-9104-0c88e1f9f6d0"] :knowledge-point/questions ["q-127497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127511/selection/f00dfe5f5af04310962dd91c5be13353115e7d95a977b24440a5ed3e54255a56" :answer/id #uuid "db115e32-ef0d-5005-a32d-6c76a6d74aa9" :answer/type :answer.type/math :answer/value "\\frac{y}{4x}" :db/ensure [:answer/validate]} {:db/id "q-127511/selection/8c12c359940f1cf23b63039a4d1141b32c2d9de22fa2109d9526fa4f2e714593" :answer/id #uuid "58dff48e-4a47-5d9a-afd3-6347781c5e51" :answer/type :answer.type/math :answer/value "\\frac{x}{4y}" :db/ensure [:answer/validate]} {:db/id "q-127511/selection/1d49b6fbe3e37f40526628bc8d2aaeb2114ba84835c00db6af55c9246ab34de2" :answer/id #uuid "3ff31bf6-d036-5225-9c74-7c7d2f5d7583" :answer/type :answer.type/math :answer/value "-\\frac{y}{2x}" :db/ensure [:answer/validate]} {:db/id "q-127511/selection/130c36ed8c67d974dbb8f380f852c44124d620822c447793d8c3e5d76fa4aea6" :answer/id #uuid "f2d1eeee-b88b-5404-a208-8c755d6bbb83" :answer/type :answer.type/math :answer/value "-\\frac{2x}{y}" :db/ensure [:answer/validate]} {:db/id "q-127511/selection/e514c00c585ad4c7bf84103a3b3cd22f942db32836ae5a8f5e8649755b133f20" :answer/id #uuid "145f6ecf-44af-569a-a98c-4122f8bd30eb" :answer/type :answer.type/math :answer/value "-\\frac{4x}{y}" :db/ensure [:answer/validate]} {:db/id "q-127511/selection" :answer-field/id #uuid "86480513-0d44-532c-a1de-77938bf94631" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127511/selection/e514c00c585ad4c7bf84103a3b3cd22f942db32836ae5a8f5e8649755b133f20" :answer-field/choices ["q-127511/selection/f00dfe5f5af04310962dd91c5be13353115e7d95a977b24440a5ed3e54255a56" "q-127511/selection/8c12c359940f1cf23b63039a4d1141b32c2d9de22fa2109d9526fa4f2e714593" "q-127511/selection/1d49b6fbe3e37f40526628bc8d2aaeb2114ba84835c00db6af55c9246ab34de2" "q-127511/selection/130c36ed8c67d974dbb8f380f852c44124d620822c447793d8c3e5d76fa4aea6" "q-127511/selection/e514c00c585ad4c7bf84103a3b3cd22f942db32836ae5a8f5e8649755b133f20"] :db/ensure [:answer-field/validate]} {:db/id "q-127511" :question/id #uuid "54ca6e99-2d40-50f1-ab5d-d366e33a931c" :question/math-academy-id "q-127511" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/c0295c7cdc1abc16273efda842a0aa7a892ece2f5dda5e29f7baab25320b23ec.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $1$ and $2,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1\\,⟹\\,{x}^{2}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ 2x+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127511/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127511"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127513/selection/cd5f8e3ea22b51d8630eaa13528e7aae4838946bd99691f2b3e20e1a87bf4ae9" :answer/id #uuid "1e3f94bb-82fa-5461-a7bc-aca0d5c3d007" :answer/type :answer.type/math :answer/value "-\\frac{5y}{2x}" :db/ensure [:answer/validate]} {:db/id "q-127513/selection/8e12ad1c1264fb7796ceb722bd40b29cefd75aaf2d2f773699f45051f59e8ad8" :answer/id #uuid "5cc9ad94-483f-5b98-b11b-095698178da7" :answer/type :answer.type/math :answer/value "\\frac{5x}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127513/selection/58899e17b42426fad806bf9140b4b6f00b70aa480d8124da29e7f890a669cf1f" :answer/id #uuid "a7e60346-4568-55b7-a5cc-f94ec75f2635" :answer/type :answer.type/math :answer/value "\\frac{25y}{4x}" :db/ensure [:answer/validate]} {:db/id "q-127513/selection/65c34a2c6b3bcf6bbd9181ff1350050b28520e056b8e8317f0a2415411735603" :answer/id #uuid "f47d2eb6-75c2-590c-9cb3-8deda81c6565" :answer/type :answer.type/math :answer/value "-\\frac{5x}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127513/selection/b1e85770988bdd4550b08a9b9b0ded923a8947f75d8ce6b63c8d289d3970e3bc" :answer/id #uuid "07d854e1-c60f-5174-989e-53094c48656e" :answer/type :answer.type/math :answer/value "-\\frac{25x}{4y}" :db/ensure [:answer/validate]} {:db/id "q-127513/selection" :answer-field/id #uuid "1ee84cdf-55a4-5fde-9bdb-bb1dfed88b9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127513/selection/b1e85770988bdd4550b08a9b9b0ded923a8947f75d8ce6b63c8d289d3970e3bc" :answer-field/choices ["q-127513/selection/cd5f8e3ea22b51d8630eaa13528e7aae4838946bd99691f2b3e20e1a87bf4ae9" "q-127513/selection/8e12ad1c1264fb7796ceb722bd40b29cefd75aaf2d2f773699f45051f59e8ad8" "q-127513/selection/58899e17b42426fad806bf9140b4b6f00b70aa480d8124da29e7f890a669cf1f" "q-127513/selection/65c34a2c6b3bcf6bbd9181ff1350050b28520e056b8e8317f0a2415411735603" "q-127513/selection/b1e85770988bdd4550b08a9b9b0ded923a8947f75d8ce6b63c8d289d3970e3bc"] :db/ensure [:answer-field/validate]} {:db/id "q-127513" :question/id #uuid "58f5d542-39f0-5cac-afa1-00eeca4dd963" :question/math-academy-id "q-127513" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/f8effaf21270245ed6f8df63d2e430483756f47537b1c7325e88acc5286544db.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $2$ and $5,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{5}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{25}) & =0 \\\\ \\frac{2x}{4}+\\frac{2y}{25}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2y}{25}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{25x}{4y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127513/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127513"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127514/selection/1b7ce38acafa9928cd7ef2b520747c9947e80e159cd48f31c49be9761ec455c6" :answer/id #uuid "c558ba65-aeb1-57de-8c3d-b32bf211126f" :answer/type :answer.type/math :answer/value "-\\frac{9y}{x}" :db/ensure [:answer/validate]} {:db/id "q-127514/selection/3040d7044da495921e7861fa8ed8579ed8ffe7114dfad64e0e1f2d754cf836f2" :answer/id #uuid "04f15475-5162-5e64-a228-2c3254368ed0" :answer/type :answer.type/math :answer/value "-\\frac{x}{9y}" :db/ensure [:answer/validate]} {:db/id "q-127514/selection/9202a6291a6f49f8e9c0b6013fbff4aa2c4003696bee4c313888c53cd002bffe" :answer/id #uuid "fee356ad-1580-5ba0-8d25-e9aab8bc18d8" :answer/type :answer.type/math :answer/value "-\\frac{9x}{y}" :db/ensure [:answer/validate]} {:db/id "q-127514/selection/ac6520d2d8ff0030a341a58f08100fa8bb0151cd2d0f65c7f920b9df7ae27bca" :answer/id #uuid "611cea9b-7480-5f59-9b8d-69f8551048e1" :answer/type :answer.type/math :answer/value "-\\frac{3y}{x}" :db/ensure [:answer/validate]} {:db/id "q-127514/selection/10026a192999f8047390eeae061d70d30d0f748b8ecee24141a4c0c4126a7f0b" :answer/id #uuid "9790fbca-a081-5427-978a-36f24620a867" :answer/type :answer.type/math :answer/value "-\\frac{x}{3y}" :db/ensure [:answer/validate]} {:db/id "q-127514/selection" :answer-field/id #uuid "c86e583c-232f-56ce-868c-d6efb5f81db7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127514/selection/3040d7044da495921e7861fa8ed8579ed8ffe7114dfad64e0e1f2d754cf836f2" :answer-field/choices ["q-127514/selection/1b7ce38acafa9928cd7ef2b520747c9947e80e159cd48f31c49be9761ec455c6" "q-127514/selection/3040d7044da495921e7861fa8ed8579ed8ffe7114dfad64e0e1f2d754cf836f2" "q-127514/selection/9202a6291a6f49f8e9c0b6013fbff4aa2c4003696bee4c313888c53cd002bffe" "q-127514/selection/ac6520d2d8ff0030a341a58f08100fa8bb0151cd2d0f65c7f920b9df7ae27bca" "q-127514/selection/10026a192999f8047390eeae061d70d30d0f748b8ecee24141a4c0c4126a7f0b"] :db/ensure [:answer-field/validate]} {:db/id "q-127514" :question/id #uuid "0ce6382e-085b-5d98-89eb-3fb7ac90eace" :question/math-academy-id "q-127514" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/547b79b566d2914db4a63997cd5fc9f02dd1517b8dcd5e53cde8c07ac5ca05a2.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $3$ and $1,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{9}+{y}^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{9}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{9})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ \\frac{2x}{9}+2y\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x}{9} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{9y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127514/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127514"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127526/selection/d8e980b56f355031e1c03ec3669bf86a7c210c7aa297863445420a77ac30c032" :answer/id #uuid "a8b16115-bff3-5f6f-a0c5-7bbb4bc73e1b" :answer/type :answer.type/math :answer/value "\\frac{9x}{4(y-3)}" :db/ensure [:answer/validate]} {:db/id "q-127526/selection/740cbee6963b84de8c8d7c8160e99a0666774ebd4bb003c8a537b8388ac7360e" :answer/id #uuid "ae3772bf-6806-527b-a9af-4abca19338f7" :answer/type :answer.type/math :answer/value "-\\frac{4(x-3)}{9y}" :db/ensure [:answer/validate]} {:db/id "q-127526/selection/268234e3a194db6bece5323e5653a538ca9602c8c5caa0fed871cffb7fef21b1" :answer/id #uuid "665f1313-3d2e-5cee-87ee-d5ba94bc57ec" :answer/type :answer.type/math :answer/value "\\frac{2(x-3)}{3y}" :db/ensure [:answer/validate]} {:db/id "q-127526/selection/c01f689976ba67d79e1245c8cb5471af3bfd66a44abff9dede2fbc7385c77656" :answer/id #uuid "1a348b22-7ab4-5172-970d-494351019936" :answer/type :answer.type/math :answer/value "-\\frac{3y}{2(x-3)}" :db/ensure [:answer/validate]} {:db/id "q-127526/selection/982454596d95806082c32115459d4e4c763e26bba0e17b0473ad86bcb6515a52" :answer/id #uuid "798265db-ae30-5a90-88cb-5a0dc1981d75" :answer/type :answer.type/math :answer/value "-\\frac{4(y-3)}{9x}" :db/ensure [:answer/validate]} {:db/id "q-127526/selection" :answer-field/id #uuid "b983e182-647e-5d29-b7d3-d8698920c28f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127526/selection/740cbee6963b84de8c8d7c8160e99a0666774ebd4bb003c8a537b8388ac7360e" :answer-field/choices ["q-127526/selection/d8e980b56f355031e1c03ec3669bf86a7c210c7aa297863445420a77ac30c032" "q-127526/selection/740cbee6963b84de8c8d7c8160e99a0666774ebd4bb003c8a537b8388ac7360e" "q-127526/selection/268234e3a194db6bece5323e5653a538ca9602c8c5caa0fed871cffb7fef21b1" "q-127526/selection/c01f689976ba67d79e1245c8cb5471af3bfd66a44abff9dede2fbc7385c77656" "q-127526/selection/982454596d95806082c32115459d4e4c763e26bba0e17b0473ad86bcb6515a52"] :db/ensure [:answer-field/validate]} {:db/id "q-127526" :question/id #uuid "1560c805-819c-53d3-a13d-4bf1ec1c493c" :question/math-academy-id "q-127526" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/e4c39b409f6049a4fdead506c329d232820876c37ede9540adfeade2d7c1b9dc.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at $(3,0)$ and has semiaxes $3$ and $2,$ its equation is given by\n\n$$\n\\frac{(x-3)^{2}}{{3}^{2}}+\\frac{(y-0)^{2}}{{2}^{2}}=1\\,⟹\\,\\frac{(x-3)^{2}}{9}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x-3)^{2}}{9}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x-3)^{2}}{9})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ \\frac{2(x-3)}{9}+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2(x-3)}{9} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4(x-3)}{9y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127526/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127526"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127512/selection/36ea5fa4f66f03cc4ead6716347cfa88f592576290faa44cc42d3f16463492ae" :answer/id #uuid "7c56a228-50dc-5d98-8843-7ac127ebb564" :answer/type :answer.type/math :answer/value "-\\frac{9y}{25x}" :db/ensure [:answer/validate]} {:db/id "q-127512/selection/fc5c6ff7f798027be2f2c9db6cc46a26a31927244646f0f5f61cdf2ee0da7c89" :answer/id #uuid "39b6ba78-6d82-5e48-b0b6-e28dbe5fa4ff" :answer/type :answer.type/math :answer/value "-\\frac{3x}{5y}" :db/ensure [:answer/validate]} {:db/id "q-127512/selection/08a97d56a9bbf1bce9f60bb6cfd5f74e773d129d1eb8823a4d6b610226fea6e6" :answer/id #uuid "b729a707-05d6-58d1-85ec-da9d68ed80ad" :answer/type :answer.type/math :answer/value "\\frac{25y}{9x}" :db/ensure [:answer/validate]} {:db/id "q-127512/selection/3d675e9fe4d2f3f557f7a985cef382191835bd1a50a74d1f1531c9fd82f65415" :answer/id #uuid "ab9ceb74-c983-513b-89cb-3a0e146f4ba8" :answer/type :answer.type/math :answer/value "\\frac{5y}{3x}" :db/ensure [:answer/validate]} {:db/id "q-127512/selection/06f14081adfb1218d36d12d7d66b6cdfad4b59653eaead2a1aa58099045c284b" :answer/id #uuid "2bf2eb4d-a9a6-51be-9e7b-251ac2e1e6ed" :answer/type :answer.type/math :answer/value "-\\frac{9x}{25y}" :db/ensure [:answer/validate]} {:db/id "q-127512/selection" :answer-field/id #uuid "7c37885e-4d3c-5bf9-949b-bcbf010fc8e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127512/selection/06f14081adfb1218d36d12d7d66b6cdfad4b59653eaead2a1aa58099045c284b" :answer-field/choices ["q-127512/selection/36ea5fa4f66f03cc4ead6716347cfa88f592576290faa44cc42d3f16463492ae" "q-127512/selection/fc5c6ff7f798027be2f2c9db6cc46a26a31927244646f0f5f61cdf2ee0da7c89" "q-127512/selection/08a97d56a9bbf1bce9f60bb6cfd5f74e773d129d1eb8823a4d6b610226fea6e6" "q-127512/selection/3d675e9fe4d2f3f557f7a985cef382191835bd1a50a74d1f1531c9fd82f65415" "q-127512/selection/06f14081adfb1218d36d12d7d66b6cdfad4b59653eaead2a1aa58099045c284b"] :db/ensure [:answer-field/validate]} {:db/id "q-127512" :question/id #uuid "5af86b8f-c0e9-5ee9-8670-c65d273b6ede" :question/math-academy-id "q-127512" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/43e8ed1ee117ccd10f0e3aa03fc8db8ec1db6c076689e9072e1e22e048dfc279.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $5$ and $3,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{3}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{25})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{9}) & =0 \\\\ \\frac{2x}{25}+\\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x}{25} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{25y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127512/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e118393-2388-5add-b516-e565abe1e36a"] :knowledge-point/questions ["q-127512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-312780/field-1/2756efc73d38d11e6870963a800525e8c05e388c37b95f63e0bae574f2be08d9" :answer/id #uuid "68d7507c-f55c-5954-ac65-0cf703224c08" :answer/type :answer.type/math :answer/value "\\frac{49}{10y}" :db/ensure [:answer/validate]} {:db/id "q-312780/field-1" :answer-field/id #uuid "749c93a5-d3b1-5006-bf44-90d33b709217" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312780/field-1/2756efc73d38d11e6870963a800525e8c05e388c37b95f63e0bae574f2be08d9" :answer-field/choices ["q-312780/field-1/2756efc73d38d11e6870963a800525e8c05e388c37b95f63e0bae574f2be08d9"] :db/ensure [:answer-field/validate]} {:db/id "q-312780" :question/id #uuid "c2b3af54-e038-57d8-a207-5e5ccf9719d8" :question/math-academy-id "q-312780" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/b269001ff5a3a1a1d86125157ee2f5b77d89ebcf0041f8d403dbc931b796c5e8.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(5,7).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=5$ and $y=7$ into the equation above, we get\n\n$$\n\\begin{aligned}(7)^{2} & =4p(5) \\\\ 49 & =20p \\\\ p & =\\frac{49}{20}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{49}{5}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{49}{5}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{49}{5} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{49}{10y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-312780/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-312780"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342215/field-1/3d9ff2e6233f2aeb9f3e60a4d8c756407ee07b760bdca66d76901b7c908d78ae" :answer/id #uuid "760f2f3d-830d-5146-aa04-9bd806fc2dd0" :answer/type :answer.type/math :answer/value "-\\frac{1}{6y}" :db/ensure [:answer/validate]} {:db/id "q-342215/field-1/1555cd1a22e75331f4c9086cee545609b46f16a0b02c2ca187abae740f69feb6" :answer/id #uuid "b7d34b16-60c1-51af-9fe1-468101c90595" :answer/type :answer.type/math :answer/value "\\frac{1}{6y}" :db/ensure [:answer/validate]} {:db/id "q-342215/field-1" :answer-field/id #uuid "9d3e96e6-c7ae-587c-ac24-448fb703e9e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342215/field-1/3d9ff2e6233f2aeb9f3e60a4d8c756407ee07b760bdca66d76901b7c908d78ae" :answer-field/choices ["q-342215/field-1/3d9ff2e6233f2aeb9f3e60a4d8c756407ee07b760bdca66d76901b7c908d78ae" "q-342215/field-1/1555cd1a22e75331f4c9086cee545609b46f16a0b02c2ca187abae740f69feb6"] :db/ensure [:answer-field/validate]} {:db/id "q-342215" :question/id #uuid "dc1c970f-aca1-5725-85b7-89d4b93cb963" :question/math-academy-id "q-342215" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/c403f11093b76facafbecb72bcc413640ac67fe6ed73d6b64374230f39e29aba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-3,-1).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-3$ and $y=-1$ into the equation above, we get\n\n$$\n\\begin{aligned}(-1)^{2} & =4p(-3) \\\\ 1 & =-12p \\\\ p & =-\\frac{1}{12}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-\\frac{1}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{6y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342215/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-342215"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127515/selection/bea7d3eed16960e568d1baa543a4204b898cb1032d10c2587e52123bb86f6e6c" :answer/id #uuid "06e327f2-4296-5c9c-9184-d6aa1f3cd505" :answer/type :answer.type/math :answer/value "-\\frac{1}{y}" :db/ensure [:answer/validate]} {:db/id "q-127515/selection/9667e95168c281fa0e27c19d13e0a671cc072e5f64601051128959cd106bc37b" :answer/id #uuid "e67d125f-f728-5d89-af9e-0c6b8bf97a05" :answer/type :answer.type/math :answer/value "\\frac{1}{2y}" :db/ensure [:answer/validate]} {:db/id "q-127515/selection/42b18b4bfcc20a237fc869c5f819e26f68291e29538fdea9c0b07aa1292ef625" :answer/id #uuid "5ddc44c9-4abe-55d8-a64e-28ed5e5f40a6" :answer/type :answer.type/math :answer/value "\\frac{2}{y}" :db/ensure [:answer/validate]} {:db/id "q-127515/selection/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" :answer/id #uuid "4a33399f-b4d5-5f6b-91dc-15f5d9c56441" :answer/type :answer.type/math :answer/value "\\frac{4}{y}" :db/ensure [:answer/validate]} {:db/id "q-127515/selection/f6684b45a352276f7e17cf36c22fb7343364ae1d091274bee0b93b89dc5cf94b" :answer/id #uuid "60e8abb3-d012-53bc-b238-57ef1a7b0fb1" :answer/type :answer.type/math :answer/value "-\\frac{2}{y}" :db/ensure [:answer/validate]} {:db/id "q-127515/selection" :answer-field/id #uuid "2b8c0afa-2f73-51dd-b12f-075a7560de71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127515/selection/f6684b45a352276f7e17cf36c22fb7343364ae1d091274bee0b93b89dc5cf94b" :answer-field/choices ["q-127515/selection/bea7d3eed16960e568d1baa543a4204b898cb1032d10c2587e52123bb86f6e6c" "q-127515/selection/9667e95168c281fa0e27c19d13e0a671cc072e5f64601051128959cd106bc37b" "q-127515/selection/42b18b4bfcc20a237fc869c5f819e26f68291e29538fdea9c0b07aa1292ef625" "q-127515/selection/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" "q-127515/selection/f6684b45a352276f7e17cf36c22fb7343364ae1d091274bee0b93b89dc5cf94b"] :db/ensure [:answer-field/validate]} {:db/id "q-127515" :question/id #uuid "04522178-100e-570d-8bab-ad0415e9727a" :question/math-academy-id "q-127515" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/5eedb15e515993bdc8a2ee37ab4c7c0e0225b9d2118d5d60e8593de5ea56f199.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-1,2).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-1$ and $y=2$ into the equation above, we get\n\n$$\n\\begin{aligned}(2)^{2} & =4p(-1) \\\\ 4 & =-4p \\\\ p & =-1.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-4x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-4x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-4 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-127515/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-127515"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342354/field-1/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" :answer/id #uuid "f8c34001-0779-582f-a2a0-b18d4e8681a2" :answer/type :answer.type/math :answer/value "\\frac{4}{y}" :db/ensure [:answer/validate]} {:db/id "q-342354/field-1/671e424c2b38705294a7f4f83430664c854caf612e1e90cce0b857bd0db37b36" :answer/id #uuid "009d0a8e-0c8c-57f7-be89-961c854405ec" :answer/type :answer.type/math :answer/value "-\\frac{4}{y}" :db/ensure [:answer/validate]} {:db/id "q-342354/field-1" :answer-field/id #uuid "f2daf528-e450-5fbf-9dfc-7993564ab098" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342354/field-1/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" :answer-field/choices ["q-342354/field-1/047a9074824b05a79a627427003d4f26ac2bf7b0c6cd07f678ec4bbdbfe9a2ba" "q-342354/field-1/671e424c2b38705294a7f4f83430664c854caf612e1e90cce0b857bd0db37b36"] :db/ensure [:answer-field/validate]} {:db/id "q-342354" :question/id #uuid "248059b8-c797-518d-848e-0b4117c22754" :question/math-academy-id "q-342354" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/85d75e0f3a9f2a30282d1f1754b0c46da49e8f73ff2a858c856ba5492eb21cca.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(8,-8).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=8$ and $y=-8$ into the equation above, we get\n\n$$\n\\begin{aligned}(-8)^{2} & =4p(8) \\\\ 64 & =32p \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=8x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(8x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =8 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{4}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342354/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-342354"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342218/field-1/2d9109defeee2c59ca6907176249e27219ca030bf6f1fb231bcc27481f1ab14c" :answer/id #uuid "74f93b34-cd84-502a-8305-9077d001f0bc" :answer/type :answer.type/math :answer/value "-\\frac{3}{y}" :db/ensure [:answer/validate]} {:db/id "q-342218/field-1" :answer-field/id #uuid "f2dccab9-ea02-5dfe-8085-82f012907ae9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342218/field-1/2d9109defeee2c59ca6907176249e27219ca030bf6f1fb231bcc27481f1ab14c" :answer-field/choices ["q-342218/field-1/2d9109defeee2c59ca6907176249e27219ca030bf6f1fb231bcc27481f1ab14c"] :db/ensure [:answer-field/validate]} {:db/id "q-342218" :question/id #uuid "8dbbe6ed-99af-53ff-93a0-b57eb15687b8" :question/math-academy-id "q-342218" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/7367cb4ae1feb4e18b98b712687ceb4a1db67f8c9e4965af3ffd1253a827f346.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above. Express the answer in terms of the variable $y.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-6,6).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-6$ and $y=6$ into the equation above, we get\n\n$$\n\\begin{aligned}{6}^{2} & =4p(-6) \\\\ 36 & =-24p \\\\ p & =-\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-6x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-6x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-6 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{3}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342218/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53a1649d-4279-5b7c-839c-728f333b2c3f"] :knowledge-point/questions ["q-342218"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-9577"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/0f4f0de23892a6f76642f8c7e5d3a6112a8ffa2d9f50000cd974f293a7d8b3b6.png)\n\nFind $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(0,-1)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-0)^2 + (y - (-1))^2 = 2^2 \\qquad\\Longrightarrow\\qquad\nx^2 + (y+1)^2 = 4.\n$$\n\nNow, to calculate $\\dfrac{\\textrm d y}{\\textrm d x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+(y+1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}((y+1)^{2}) & =0 \\\\ 2x+2(y+1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+1)\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y+1}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9578"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/d3895bafe045f7e460887aee41bf390fdda753fed87eaab14f4a29ddb792267c.png)\n\nFind $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $2$ and $4,$ its equation is given by\n\n$$\n\\dfrac{x^2}{2^2} + \\dfrac{y^2}{4^2} = 1 \\qquad \\Longrightarrow \\qquad \\dfrac{x^2}{4} + \\dfrac{y^2}{16} = 1.\n$$\n\nNow, to calculate $\\dfrac{\\textrm d y}{\\textrm d x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{16}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{16}) & =0 \\\\ \\frac{2x}{4}+\\frac{2y}{16}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{x}{2}+\\frac{y}{8}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{8}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{y}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9579"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062909/assets/a92eae1ab0af29ea895b570c95199ece1e292c09953ebb2dabbb7c6e2d422d6c.png)\n\nFind $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ for the right-opening parabola shown above." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(3,-2).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\ny^2 = 4px.\n$$\n\nSubstituting $x = 3$ and $y = -2$ into the equation above, we get\n\n$$\n\\begin{aligned}(-2)^{2} & =4p(3) \\\\ 4 & =12p \\\\ p & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\ny^2 = \\dfrac{4}{3}x.\n$$\n\nFinally, to calculate $\\dfrac{\\textrm d y}{\\textrm d x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3y}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
