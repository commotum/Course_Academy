4"] :db/ensure [:answer-field/validate]} {:db/id "q-65503" :question/id #uuid "6cb594c3-3365-529d-9cde-7617838b232d" :question/math-academy-id "q-65503" :question/problem "$\\operatorname{cos}⁡(x-{90}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={90}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{90}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{90}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{90}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (0)+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65503/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-65503"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141365/selection/3f3eece24ce270aba315a30bf2d4d1b875eb4aed796472673228e2d6779747d4" :answer/id #uuid "c7914185-cc84-5e50-8812-a99170e98d03" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141365/selection/89cd8d0fa26ea597d17c64a8530d2912e4843f5af8f927753ed148c96aca1e78" :answer/id #uuid "61984bc7-d2b2-5dc6-9d1d-a3ec2c3a9227" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141365/selection/4b098d8883ebf2ba53c3601846fe278f4795f8ac00c0d681adaeae0c20d765d8" :answer/id #uuid "a2334464-fd36-56a3-bd22-ca906462446b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141365/selection/dbbeeaf36f4a2402a1b3dd50938bdb4729909707