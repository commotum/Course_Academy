eratorname{cos}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-141365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141383/selection/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" :answer/id #uuid "654446fe-535c-5304-8ce2-438f790edbe9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141383/selection/89cd8d0fa26ea597d17c64a8530d2912e4843f5af8f927753ed148c96aca1e78" :answer/id #uuid "ae95a922-ac6d-54d6-a9c4-3ce642e3f15e" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141383/selection/6758eada5f5af88abd13c4aad6b76b3afce37cf890037c3fd8776986fba83eee" :answer/id #uuid "87bab1f3-b772-5a9f-a474-5c872e86fa86" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141383/selection/e55d1b1a54d6da6af22b6cd5985f2c34a2a23d72a077ac60f4f706c2621e260c" :answer/id #uuid "a7be25af-3734-5b12-a4b9-27b466d469e1" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141383/selection/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58" :answer/id #uuid "36214886-920b-5b96-abf0-c0b34e915a53" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141383/selection" :answer-field/id #uuid "31bd9d3c-5eb8-5a32-9048-368b365d345b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141383/selection/e55d1b1a54d6da6af22b6cd5985f2c34a2a23d72a077ac60f4f706c2621e260c" :answer-field/choices ["q-141383/selection/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" "q-141383/selection/89cd8d0fa26ea597d17c64a8530d2912e4843f5af8f927753ed148c96aca1e78" "q-141383/selection/6758eada5f5af88abd13c4aad6b76b3afce37cf890037c3fd8776986fba83eee" "q-141383/selection/e55d1b1a54d6da6af22b6cd5985f2c34a2a23d72a077ac60f4f706c2621e260c" "q-141383/selection/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58"] :db/ensure [:answer-field/validate]} {:db/id "q-141383" :question/id #uuid "08d748f6-2240-5964-831b-b957a9a3d8e7" :question/math-academy-id "q-141383" :question/problem "$\\operatorname{cos}⁡(x+\\frac{5\\pi }{6})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{5\\pi }{6},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{5\\pi }{6}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{5\\pi }{6})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})-\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}-\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-141383/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-141383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332522/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e59abbdf-2604-50fd-a19f-14773bca14fc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332522/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "2462f076-20f6-59dc-a108-3b1c0905ea8d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-332522/field-1" :answer-field/id #uuid "49c8e2e8-e323-551e-a09f-8ccacbc65087" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332522/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332522/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-332522/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-332522/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0a9a854c-06de-5f3f-abbc-9e0c5fdcb1e7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-332522/field-2" :answer-field/id #uuid "0d9e197e-e45f-53e6-86bd-257dda9a8376" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332522/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-332522/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-332522" :question/id #uuid "4aa53877-bd67-5441-ad85-cf035bef8332" :question/math-academy-id "q-332522" :question/problem "Express $\\operatorname{cos}⁡(x+\\frac{3\\pi }{2})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x+\\frac{3\\pi }{2})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{3\\pi }{2}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{3\\pi }{2}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =\\operatorname{cos}⁡x\\cdot 0-\\operatorname{sin}⁡x\\cdot (-1) \\\\  & =1\\,\\operatorname{sin}⁡x+0\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332522/field-1" "q-332522/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-332522"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332529/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "0bc914ab-00ad-5fe1-98d8-b4212b5fd4b1" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332529/field-1" :answer-field/id #uuid "6736d1e7-38e1-55e6-af77-5908d6176b0f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332529/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-332529/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-332529/field-2/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "c0b4831a-88b4-51e1-b6e3-6058eb4c2f3f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332529/field-2" :answer-field/id #uuid "fac2ee23-b0b5-5deb-b2d3-3e20f1e81e49" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332529/field-2/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-332529/field-2/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8"] :db/ensure [:answer-field/validate]} {:db/id "q-332529" :question/id #uuid "3d923c08-db81-501b-9794-d9a0b6432d2d" :question/math-academy-id "q-332529" :question/problem "Express $\\operatorname{cos}⁡(x-\\frac{11\\pi }{6})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-\\frac{11\\pi }{6})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{11\\pi }{6}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{11\\pi }{6}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{11\\pi }{6})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332529/field-1" "q-332529/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-332529"] :db/ensure [:knowledge-point/validate]}]
