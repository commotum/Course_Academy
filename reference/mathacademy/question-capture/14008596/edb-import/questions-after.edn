:db/id #edb/ref 17592186288627 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc914ab-00ad-5fe1-98d8-b4212b5fd4b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288629}] :answer-field/correct {:answer/id #uuid "0bc914ab-00ad-5fe1-98d8-b4212b5fd4b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288629} :answer-field/id #uuid "6736d1e7-38e1-55e6-af77-5908d6176b0f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288628} {:answer-field/choices [{:answer/id #uuid "c0b4831a-88b4-51e1-b6e3-6058eb4c2f3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288631}] :answer-field/correct {:answer/id #uuid "c0b4831a-88b4-51e1-b6e3-6058eb4c2f3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288631} :answer-field/id #uuid "fac2ee23-b0b5-5deb-b2d3-3e20f1e81e49" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288630}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3d923c08-db81-501b-9794-d9a0b6432d2d" :question/math-academy-id "q-332529" :question/problem "Express $\\operatorname{cos}⁡(x-\\frac{11\\pi }{6})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-\\frac{11\\pi }{6})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{11\\pi }{6}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{11\\pi }{6}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{11\\pi }{6})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288632 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb62c43-dc43-5842-beda-21b2d722c156" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186288634} {:answer/id #uuid "fe36b421-a319-5fa5-a373-6295b4c7a2ef" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186288635} {:answer/id #uuid "78d96845-2da9-5272-804c-d231dd688e4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186288636} {:answer/id #uuid "0a859a28-9f2c-59bf-ab63-e68d707a5b9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186288637} {:answer/id #uuid "5011128c-82c5-5e98-88b8-143491a39361" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186288638}] :answer-field/correct {:answer/id #uuid "1fb62c43-dc43-5842-beda-21b2d722c156" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186288634} :answer-field/id #uuid "233a8e4e-85e1-5b38-a4ea-ef2fa29581b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288633}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6cb594c3-3365-529d-9cde-7617838b232d" :question/math-academy-id "q-65503" :question/problem "$\\operatorname{cos}⁡(x-{90}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={90}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{90}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{90}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{90}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (0)+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$"}]}
