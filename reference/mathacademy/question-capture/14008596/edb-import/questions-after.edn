#{[{:db/id #edb/ref 17592186288607 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7914185-cc84-5e50-8812-a99170e98d03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186288609} {:answer/id #uuid "a2334464-fd36-56a3-bd22-ca906462446b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288610} {:answer/id #uuid "61984bc7-d2b2-5dc6-9d1d-a3ec2c3a9227" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288611} {:answer/id #uuid "4ca5b847-118b-5aea-869c-f3d27a0fcca3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186288612} {:answer/id #uuid "c04e2c32-3c9c-5260-be3c-17c8ace1168a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288613}] :answer-field/correct {:answer/id #uuid "c04e2c32-3c9c-5260-be3c-17c8ace1168a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288613} :answer-field/id #uuid "ce461871-a26b-54e8-b212-ca8f7aa8d705" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288608}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72b8a20e-154a-59c0-a7cc-153fdebf5074" :question/math-academy-id "q-141365" :question/problem "$\\operatorname{cos}⁡(x+{60}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{60}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{60}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}-\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288614 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87bab1f3-b772-5a9f-a474-5c872e86fa86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186288616} {:answer/id #uuid "ae95a922-ac6d-54d6-a9c4-3ce642e3f15e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288617} {:answer/id #uuid "36214886-920b-5b96-abf0-c0b34e915a53" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186288618} {:answer/id #uuid "a7be25af-3734-5b12-a4b9-27b466d469e1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288619} {:answer/id #uuid "654446fe-535c-5304-8ce2-438f790edbe9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186288620}] :answer-field/correct {:answer/id #uuid "a7be25af-3734-5b12-a4b9-27b466d469e1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186288619} :answer-field/id #uuid "31bd9d3c-5eb8-5a32-9048-368b365d345b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288615}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "08d748f6-2240-5964-831b-b957a9a3d8e7" :question/math-academy-id "q-141383" :question/problem "$\\operatorname{cos}⁡(x+\\frac{5\\pi }{6})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{5\\pi }{6},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{5\\pi }{6}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{5\\pi }{6})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})-\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}-\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288621 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e59abbdf-2604-50fd-a19f-14773bca14fc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288623} {:answer/id #uuid "2462f076-20f6-59dc-a108-3b1c0905ea8d" :answer/type {:db/ident :answer.type/math} 