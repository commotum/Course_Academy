[{:db/id "q-17126/selection/6188e97c53f4072de18e0bbf7b3e33671bdd6ef9941150dffec15c87510b2c0c" :answer/id #uuid "6419849d-9567-5e8f-9a24-a788e06a32f3" :answer/type :answer.type/math :answer/value "(-\\sqrt{2},-\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-17126/selection/c6550a67127240eb829908755ea784e080f647c2d13005ffb46f9f96b82711fc" :answer/id #uuid "053c9591-70d2-57cb-a889-32d19103a09d" :answer/type :answer.type/math :answer/value "(\\sqrt{2},-\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-17126/selection/f6e71d08fdd6a4a53096c5e24213d34175773babfc8a6c85ba08ea3888f4eb9b" :answer/id #uuid "30d7b0d9-62db-5b0f-988d-99dc0aafe237" :answer/type :answer.type/math :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-17126/selection/975582d74cef3ada4331136ffd92e63587b435e2ed95e0548f8a484cc2eacb4e" :answer/id #uuid "55882473-ac9a-5cb9-abd0-e12a36b62250" :answer/type :answer.type/math :answer/value "(\\sqrt{2},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-17126/selection/8c3d2391a90f91076120f39cbcd2e68521fc3fd0022bbbd2ac6a8711c25eba0a" :answer/id #uuid "9be7ec19-ca85-578f-8a31-42786e169dff" :answer/type :answer.type/math :answer/value "(\\sqrt{2},-\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-17126/selection" :answer-field/id #uuid "f03daf4c-ff3a-5076-b503-8de3b9e4b435" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17126/selection/c6550a67127240eb829908755ea784e080f647c2d13005ffb46f9f96b82711fc" :answer-field/choices ["q-17126/selection/6188e97c53f4072de18e0bbf7b3e33671bdd6ef9941150dffec15c87510b2c0c" "q-17126/selection/c6550a67127240eb829908755ea784e080f647c2d13005ffb46f9f96b82711fc" "q-17126/selection/f6e71d08fdd6a4a53096c5e24213d34175773babfc8a6c85ba08ea3888f4eb9b" "q-17126/selection/975582d74cef3ada4331136ffd92e63587b435e2ed95e0548f8a484cc2eacb4e" "q-17126/selection/8c3d2391a90f91076120f39cbcd2e68521fc3fd0022bbbd2ac6a8711c25eba0a"] :db/ensure [:answer-field/validate]} {:db/id "q-17126" :question/id #uuid "c3e9fb1b-d84f-5083-bf39-0ed60cacadd0" :question/math-academy-id "q-17126" :question/problem "Given that the distance from a point $P$ to the origin is $2,$ and that $P$ makes an angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=2,\\,\\theta =\\frac{7\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =2\\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\ x & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\ x & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =2\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\ y & =2(-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(\\sqrt{2},-\\sqrt{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17126/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-17126"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17128/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" :answer/id #uuid "e9af544b-466b-58e9-a32d-a60c65ebd92a" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "q-17128/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" :answer/id #uuid "cdef4042-cff9-5f68-95fb-b34786a01c9c" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "q-17128/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c187