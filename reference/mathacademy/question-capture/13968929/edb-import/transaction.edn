⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =2\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =2(-1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(0,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-17128/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb"] :knowledge-point/questions ["q-17128"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40804/selection/e1f284869d77c15524620381166ade409b5199887e784d235996f6bc6c56dad3" :answer/id #uuid "502df52b-0228-556e-8abf-fc900e50c851" :answer/type :answer.type/math :answer/value "(-\\sqrt{5},\\sqrt{5})" :db/ensure [:answer/validate]} {:db/id "q-40804/selection/3b02abedf59ecd0c17768c70c503fab176e10b3ba5e46b3d6e6c2b09a38070b7" :answer/id #uuid "aae262cc-5056-59b4-b6e1-ab8ae0dce2bc" :answer/type :answer.type/math :answer/value "(-5\\sqrt{3},-5)" :db/ensure [:answer/validate]} {:db/id "q-40804/selection/11ad6fa686c7a4cdf5676c4b308d293440a7139b3079401598c822043e9ef6e0" :answer/id #uuid "a980a14f-459e-537f-a11c-99b093b3b3e7" :answer/type :answer.type/math :answer/value "(-\\sqrt{5},-3\\sqrt{5})" :db/ensure [:answer/validate]} {:db/id "q-40804/selection/3ea3fd2ef3abf89d892aec9fddf5649bb61a9f2ab821765e1f7ece9905f75bbb" :answer/id #uuid "2962a42e-9c54-5089-bfd7-049df8d04250" :answer/type :answer.type/math :answer/value "(-5,-5\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-40804/selection/69e708f82d7d5d74e08f90168e6440fc8e70975120bddb04810f3cd120d19a92" :answer/id #uuid "b6f0cf9e-4673-5859-925a-6f7696abb8b4" :answer/type :answer.type/math :answer/value "(-\\sqrt{5},\\sqrt{15})" :db/ensure [:answer/validate]} {:db/id "q-40804/selection" :answer-field/id #uuid "6e9b9746-ed79-5873-ae10-e6ef08710927" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40804/selection/3ea3fd2ef3abf89d892aec9fddf5649bb61a9f2ab821765e1f7ece9905f75bbb" :answer-field/choices ["q-40804/selection/e1f284869d77c15524620381166ade409b5199887e784d235996f6bc6c56dad3" "q-40804/selection/3b02abedf59ecd0c17768c70c503fab176e10b3ba5e46b3d6e6c2b09a38070b7" "q-40804/selection/11ad6fa686c7a4cdf5676c4b308d293440a7139b3079401598c822043e9ef6e0" "q-40804/selection/3ea3fd2ef3abf89d892aec9fddf5649bb61a9f2ab821765e1f7ece9905f75bbb" "q-40804/selection/69e708f82d7d5d74e08f90168e6440fc8e70975120bddb04810f3cd120d19a92"] :db/ensure [:answer-field/validate]} {:db/id "q-40804" :question/id #uuid "4ec897fc-4ba3-5ac8-96c6-00d8646f2622" :question/math-academy-id "q-40804" :question/problem "The point $A$ has polar coordinates $(r,\\frac{3\\pi }{4})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{4\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{5},\\sqrt{5}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(\\sqrt{5})^{2}+(\\sqrt{5})^{2}} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{10})^{2},\\frac{4\\pi }{3})=(10,\\frac{4\\pi }{3}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{1}{2}) \\\\  & =-5\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =10\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{\\sqrt{3}}{2}) \\\\  & =-5\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-5,-5\\sqrt{3}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40804/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb"] :knowledge-point/questions ["q-40804"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120598/selection/d99fb1ac758abdd4ca256fe154e8fa94640d8b8ba40b7a33898dda66f574828b" :answer/id #uuid "25054c41-b8ad-5fd1-91c5-2dbe61b91e90" :answer/type :answer.type/math :answer/value "(2,\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-120598/selection/1d77d86dae2ed61625b4af15a6dd7a32243e0b9026ac7b1e9c222245e5eff213" :answer/id #uuid "ecede080-4c7e-50bc-bde9-67966e01760d" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "q-120598/selection/020afe65abcbd214ce790da9b908e21b333d6a24716bc482d003e5b59a07e1cd" :answer/id #uuid "bd3bdcff-cafd-5c81-9906-5fa096f213fd" :answer/type :answer.type/math :answer/value "(2,2)" :db/ensure [:answer/validate]} {:db/id "q-120598/selection/975582d74cef3ada4331136ffd92e63587b435e2ed95e0548f8a484cc2eacb4e" :answer/id #uuid "b65bed6c-449e-5eda-b62e-d9f0f915a7ee" :answer/type :answer.type/math :answer/value "(\\sqrt{2},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-120598/selection/acdaf0046c8b6f58f06022d1a2971387cf1ab2649e9d42b2664aac47e60eb994" :answer/id #uuid "748ab3ce-ba90-5c75-9eba-5e0dfc1c4227" :answer/type :answer.type/math :answer/value "(\\sqrt{2},2)" :db/ensure [:answer/validate]} {:db/id "q-120598/selection" :answer-field/id #uuid "e93a35a2-dee9-5eb3-8be4-766470363a67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120598/selection/975582d74cef3ada4331136ffd92e63587b435e2ed95e0548f8a484cc2eacb4e" :answer-field/choices ["q-120598/selection/d99fb1ac758abdd4ca256fe154e8fa94640d8b8ba40b7a33898dda66f574828b" "q-120598/selection/1d77d86dae2ed61625b4af15a6dd7a32243e0b9026ac7b1e9c222245e5eff213" "q-120598/selection/020afe65abcbd214ce790da9b908e21b333d6a24716bc482d003e5b59a07e1cd" "q-120598/selection/975582d74cef3ada4331136ffd92e63587b435e2ed95e0548f8a484cc2eacb4e" "q-120598/selection/acdaf0046c8b6f58f06022d1a2971387cf1ab2649e9d42b2664aac47e60eb994"] :db/ensure [:answer-field/validate]} {:db/id "q-120598" :question/id #uuid "1b42d321-a6dc-55db-8590-3f5b61b3f660" :question/math-academy-id "q-120598" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13968929/assets/475bda1ee758774ec9b07ec12a0ed92e56c4b571fd39f6e1ecca439278106ea6.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(2,{240}^{∘})$ and $m∠AOB={195}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(2,{240}^{∘}),$ we must have $r=2.$ Also, since the points $A$ and $B$ both lie on a circle of radius $2,$ the $r$-coordinate of $B$ must also be $2.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${240}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={240}^{∘}-{195}^{∘}={45}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(2,{45}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡({45}^{∘}) \\\\  & =2(\\frac{\\sqrt{2}}{2}) \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡({45}^{∘}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\sqrt{2},\\sqrt{2}).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-120598/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529"] :knowledge-point/questions ["q-120598"] :db/ensure [:knowledge-point/validate]} {:db/id "q-276807/field-1/9ae3acedc683bfb90d61cdf5f61cbcf2fa0579645531f0baa28741247ed2f79c" :answer/id #uuid "5b33ecd2-5729-5a5a-8169-3cfb91b5d454" :answer/type :answer.type/math :answer/value "-4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-276807/field-1" :answer-field/id #uuid "83c9261d-ccd7-5cdc-a6a8-909f279e1fc7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276807/field-1/9ae3acedc683bfb90d61cdf5f61cbcf2fa0579645531f0baa28741247ed2f79c" :answer-field/choices ["q-276807/field-1/9ae3acedc683bfb90d61cdf5f61cbcf2fa0579645531f0baa28741247ed2f79c"] :db/ensure [:answer-field/validate]} {:db/id "q-276807/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "46242961-b667-5d61-8860-6d07deada67a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-276807/field-2" :answer-field/id #uuid "93afe242-8f69-50d6-8f5a-1b5d3fc06931" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-276807/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-276807/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-276807" :question/id #uuid "918774b9-5070-53eb-909c-a82fbf0008b2" :question/math-academy-id "q-276807" :question/problem "The point $A$ has polar coordinates $(r,\\frac{\\pi }{6})$ and the point $B$ has polar coordinates $(2r,\\frac{7\\pi }{6}).$ Determine the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(2\\sqrt{3},2).$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(2\\sqrt{3})}^{2}+(2)^{2}} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n(2\\cdot 4,\\frac{7\\pi }{6})=(8,\\frac{7\\pi }{6}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =8(-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =8(-\\frac{1}{2}) \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-4\\sqrt{3},-4).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-276807/field-1" "q-276807/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb"] :knowledge-point/questions ["q-276807"] :db/ensure [:knowledge-point/validate]}]
