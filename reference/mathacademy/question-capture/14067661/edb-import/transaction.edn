assets/a8bcad7d4e90c6fdde99189026764d2b07a0709b8450252250c4fa133f5ceec0.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85673/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2960d2d6-7354-5f2a-80cc-8d514465455f"] :knowledge-point/questions ["q-85673"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85683/selection/b8bd84af1036b8906872c637e81385d2a6d8eeb49d09c1a5c3daecceb7caebac" :answer/id #uuid "d5a03eb5-bab1-5ccb-8e8d-0960a17af8d5" :answer/type :answer.type/math :answer/value "\\frac{35}{2}" :db/ensure [:answer/validate]} {:db/id "q-85683/selection/739adb08fce63c689cb03e270b8af2988607c3e1da7bbff8d5151160d544f6e4" :answer/id #uuid "e6ab4d9e-d2cb-585d-bc14-d013c043fc97" :answer/type :answer.type/math :answer/value "\\frac{75}{4}" :db/ensure [:answer/validate]} {:db/id "q-85683/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "75df8197-27d6-507e-9dd8-604c1896963f" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-85683/selection/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" :answer/id #uuid "b74dcd95-83bc-5359-826c-1fbbe98d74f2" :answer/type :answer.type/math :answer/value "\\frac{39}{2}" :db/ensure [:answer/validate]} {:db/id "q-85683/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "93852cd4-58a9-58b3-bc31-4716f12863c8" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-85683/selection" :answer-field/id #uuid "719956ff-3787-51e9-8a15-e4cd9eb2e858" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85683/selection/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" :answer-field/choices ["q-85683/selection/b8bd84af1036b8906872c637e81385d2a6d8eeb49d09c1a5c3daecceb7caebac" "q-85683/selection/739adb08fce63c689cb03e270b8af2988607c3e1da7bbff8d5151160d544f6e4" "q-85683/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-85683/selection/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" "q-85683/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c"] :db/ensure [:answer-field/validate]} {:db/id "q-85683" :question/id #uuid "9177065a-e07c-56ec-9cd6-608f8a33a326" :question/math-academy-id "q-85683" :question/problem "Using the trapezoidal rule with the partition\n\n$$\n[-1,2]=[-1,0]\\cup [0,2],\n$$\n\napproximate the area under the curve of the function $y=\\frac{10}{1+{x}^{2}}.$" :question/worked-solution "Let $f(x)=\\frac{10}{1+{x}^{2}}.$ Let's plot this function:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14067661/assets/c4c9aa8e615747199462e0597f4cb7be82031efdb5b2f6585e3fb9c0b652ee78.png)\n\nWe've drawn some trapezoids to help calculate our trapezoidal rule sum. By calculating the area of each trapezoid, we obtain the following approximation for our area $A:$\n\n$$\nA≈\\overset{1\\text{st trapezoid}}{\\overset{⏞}{[\\,\\frac{\\overset{\\text{bases}}{\\overset{⏞}{f(-1)+f(0)}}}{2}\\,\\cdot \\,{{Δ{x}_{1}}_{⏟}}_{\\text{height}}\\,]}}+\\overset{2\\text{nd trapezoid}}{\\overset{⏞}{[\\,\\frac{\\overset{\\text{bases}}{\\overset{⏞}{f(0)+f(2)}}}{2}\\,\\cdot \\,{{Δ{x}_{2}}_{⏟}}_{\\text{height}}\\,]}}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{5+10}{2}\\cdot (0-(-1))+\\frac{10+2}{2}\\cdot (2-0) \\\\  & =\\frac{15}{2}\\cdot 1+\\frac{12}{2}\\cdot 2 \\\\  & =\\frac{15}{2}+12 \\\\  & =\\frac{39}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85683/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bec73486-156f-5124-97b4-58f65ea8430d"] :knowledge-point/questions ["q-85683"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116621/selection/54002a0b1d22e75bf9fd9a8045aa20d4b30b445425aecaad44ea4ed81c0dc609" :answer/id #uuid "12561444-5c40-5e0e-a78a-6be8584ceecd" :answer/type :answer.type/math :answer/value "890" :db/ensure [:answer/validate]} {:db/id "q-116621/selection/466b4954d4c37ffe075567cfb46196f9651b24cbe2d34845594a1ec72d0d0485" :answer/id #uuid "7af771c3-4e6c-526b-aec4-2b21a13cea87" :answer/type :answer.type/math :answer/value "770" :db/ensure [:answer/validate]} {:db/id "q-116621/selection/277e858946cc5b4e84989da8e1d4a0ab1d893659106f0c55067d3e327cd34f5f" :answer/id #uuid "5b7af875-8f86-5068-981f-28022f2d00fd" :answer/type :answer.type/math :answer/value "1\\,020" :db/ensure [:answer/validate]} {:db/id "q-116621/selection/5ec97a33ff93b3fffd7c719b7365017924e2515982560b800b8af800d1f509b1" :answer/id #uuid "eb866571-56be-54d8-a406-9209672bc5b7" :answer/type :answer.type/math :answer/value "980" :db/ensure [:answer/validate]} {:db/id "q-116621/selection/bf9a21fe4dc212a46e36120707112677355d58d140bf05555ecb2406d2818099" :answer/id #uuid "1c4dc78f-49c1-5da3-b01c-9aa3b6e02ce9" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "q-116621/selection" :answer-field/id #uuid "6d211b4e-ff2a-53ac-9910-c22000b388af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116621/selection/5ec97a33ff93b3fffd7c719b7365017924e2515982560b800b8af800d1f509b1" :answer-field/choices ["q-116621/selection/54002a0b1d22e75bf9fd9a8045aa20d4b30b445425aecaad44ea4ed81c0dc609" "q-116621/selection/466b4954d4c37ffe075567cfb46196f9651b24cbe2d34845594a1ec72d0d0485" "q-116621/selection/277e858946cc5b4e84989da8e1d4a0ab1d893659106f0c55067d3e327cd34f5f" "q-116621/selection/5ec97a33ff93b3fffd7c719b7365017924e2515982560b800b8af800d1f509b1" "q-116621/selection/bf9a21fe4dc212a46e36120707112677355d58d140bf05555ecb2406d2818099"] :db/ensure [:answer-field/validate]} {:db/id "q-116621" :question/id #uuid "28a6dc88-cc83-5e2f-ad4d-41299804d15f" :question/math-academy-id "q-116621" :question/problem "The following table shows the number of customers per minute, $c(t),$ that arrive at a shop counter over a period of $120$ minutes.\n\n| $t\\,(\\text{minutes})$ | $0$ | $30$ | $80$ | $120$ |\n| --- | --- | --- | --- | --- |\n| $c(t)\\,(\\text{customers/minute})$ | $10$ | $8$ | $6$ | $12$ |\n\nUse the trapezoidal rule with the partition\n\n$$\n[0,30]\\cup [30,80]\\cup [80,120],\n$$\n\nto approximate the total number of customers served in two hours." :question/worked-solution "In this context, we have $3$ trapezoids, and the area $A$ under the curve $y=c(t)$ represents the total number of customers served in $2$ hours.\n\nUsing the trapezoidal rule, we estimate the area as follows:\n\n$$\nA≈\\frac{c(0)+c(30)}{2}\\cdot Δ{t}_{1}+\\frac{c(30)+c(80)}{2}\\cdot Δ{t}_{2}+\\frac{c(80)+c(120)}{2}\\cdot Δ{t}_{3}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{10+8}{2}\\cdot (30-0)+\\frac{8+6}{2}\\cdot (80-30)+\\frac{6+12}{2}\\cdot (120-80) \\\\  & =9\\cdot 30+7\\cdot 50+9\\cdot 40 \\\\  & =980\\,.\\end{aligned}\n$$\n\nTherefore, the total number of customers serve approximately is $980$ in $2$ hours." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116621/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "903cd6d7-18f2-5b53-a8e9-9aaef5589549"] :knowledge-point/questions ["q-116621"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315743/field-1/5953107b10c3d17af8e34574ed0d666967f163f7dd5b513e8249f2ca34d5e03e" :answer/id #uuid "ea913ff8-58a5-5fda-9f60-639c6f082d73" :answer/type :answer.type/math :answer/value "1750" :db/ensure [:answer/validate]} {:db/id "q-315743/field-1" :answer-field/id #uuid "8c78c5ae-39ac-51c4-8f3c-ea9c526a3b28" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315743/field-1/5953107b10c3d17af8e34574ed0d666967f163f7dd5b513e8249f2ca34d5e03e" :answer-field/choices ["q-315743/field-1/5953107b10c3d17af8e34574ed0d666967f163f7dd5b513e8249f2ca34d5e03e"] :db/ensure [:answer-field/validate]} {:db/id "q-315743" :question/id #uuid "5ea5af74-d9e6-5ec0-a5a9-05bf839b14a5" :question/math-academy-id "q-315743" :question/problem "The following table shows the inflow rate of water, $q(t),$ in $\\text{L/min},$ into a storage tank over a period of $90$ minutes.\n\n| $t\\,(\\text{minutes})$ | $0$ | $20$ | $60$ | $90$ |\n| --- | --- | --- | --- | --- |\n| $q(t)\\,(\\text{L/min})$ | $15$ | $25$ | $20$ | $10$ |\n\nUse the trapezoidal rule with the partition\n\n$$\n[0,20]\\cup [20,60]\\cup [60,90],\n$$\n\nto approximate the total volume of water that flowed into the tank in $90$ minutes.\n\nThe total volume is {{field-1}} liters." :question/worked-solution "In this context, we have $3$ trapezoids, and the area $A$ under the curve $y=q(t)$ represents the total volume of water that flowed into the tank in $90$ minutes.\n\nUsing the trapezoidal rule, we estimate the area as follows:\n\n$$\nA≈\\frac{q(0)+q(20)}{2}\\cdot Δ{t}_{1}+\\frac{q(20)+q(60)}{2}\\cdot Δ{t}_{2}+\\frac{q(60)+q(90)}{2}\\cdot Δ{t}_{3}\n$$\n\nSubstituting the appropriate numbers into the above expression gives\n\n$$\n\\begin{aligned}A & ≈\\frac{15+25}{2}\\cdot (20-0)+\\frac{25+20}{2}\\cdot (60-20)+\\frac{20+10}{2}\\cdot (90-60) \\\\  & =20\\cdot 20+22.5\\cdot 40+15\\cdot 30 \\\\  & =400+900+450 \\\\  & =1750.\\end{aligned}\n$$\n\nTherefore, the total volume of water that flowed into the tank is $1750$ liters." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-315743/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "903cd6d7-18f2-5b53-a8e9-9aaef5589549"] :knowledge-point/questions ["q-315743"] :db/ensure [:knowledge-point/validate]}]
