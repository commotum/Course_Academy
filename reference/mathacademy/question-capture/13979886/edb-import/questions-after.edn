#{[{:db/id #edb/ref 17592186280377 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0e7297-97b3-5115-9d04-901b647c186b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280379} {:answer/id #uuid "904a8cd1-b7a6-59ce-8f79-1795c5284cc9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280380} {:answer/id #uuid "12597c75-5342-5a73-a627-ff8fcb056f58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186280381} {:answer/id #uuid "cf8ac476-5685-5562-8265-d89057a10a35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186280382} {:answer/id #uuid "3c4618d2-1fac-5571-8a19-c5a5ec6c11c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186280383}] :answer-field/correct {:answer/id #uuid "cf8ac476-5685-5562-8265-d89057a10a35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186280382} :answer-field/id #uuid "5d49d673-bffc-5898-a6c7-c0ed8ec63cf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280378}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d744db45-c011-5308-9fea-620febc22042" :question/math-academy-id "q-141286" :question/problem "$\\operatorname{sin}⁡(x-\\frac{3\\pi }{4})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{4})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280384 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c556a219-7476-5554-afaf-c3f3f854f199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280386} {:answer/id #uuid "5deb9fe7-caea-55ea-a4e2-a22cefae0519" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280387} {:answer/id #uuid "33b36dde-d151-531a-8ebd-1c5c555c68f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186280388} {:answer/id #uuid "5a6c1dcb-b25c-5376-a39a-ab157ad1e804" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186280389} {:answer/id #uuid "d5457779-0061-5a82-9224-482ecba24e2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280390}] :answer-field/correct {:answer/id #uuid "5deb9fe7-caea-55ea-a4e2-a22cefae0519" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186280387} :answer-field/id #uuid "9568bb40-a23a-5ae2-8c90-7968ca2f8be8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280385}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "05621fe8-38e7-5123-8fc8-afb174ccf305" :question/math-academy-id "q-142026" :question/problem "$\\operatorname{sin}⁡(x+\\frac{7\\pi }{6})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{7\\pi }{6},$ we get \n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{7\\pi }{6}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{7\\pi }{6})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{-\\sqrt{3}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{-1}{2}) \\\\  & =\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280391 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae20ce2-694e-5bba-a05f-356eb4ac082c" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos(x)" :db/id #edb/ref 17592186280393}] :answer-field/correct {:answer/id #uuid "1ae20ce2-694e-5bba-a05f-356eb4ac082c" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos(x)" :db/id #edb/ref 17592186280393} :answer-field/id #uuid "5bdf9991-0d54-541f-ae70-4bc39e2e1123" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280392}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ccc5e48-13ba-566a-8551-38d534360fd4" :question/math-academy-id "q-274570" :question/problem "Express $\\operatorname{sin}⁡(x-{270}^{∘})$ in terms of $\\operatorname{sin}⁡x$ or $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{270}^{∘})=$\n{{field-1}}" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={270}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{270}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{270}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{270}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (0)-\\operatorname{cos}⁡x\\cdot (-1) \\\\  & =\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280394 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "475a81dd-5dfa-5c28-9688-ebaa11ae5f47" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186280396} {:answer/id #uuid "c574eea4-7ac9-5c4a-ac18-cbea5fbd544e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186280397}] :answer-field/correct {:answer/id #uuid "475a81dd-5dfa-5c28-9688-ebaa11ae5f47" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186280396} :answer-field/id #uuid "f7883e5d-c264-57dc-a266-253b4365ac3a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280395} {:answer-field/choices [{:answer/id #uuid "41fc3637-df15-51d9-88cb-d214400c781b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186280399}] :answer-field/correct {:answer/id #uuid "41fc3637-df15-51d9-88cb-d214400c781b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186280399} :answer-field/id #uuid "6a6e6939-91c9-58e1-8a95-0095d6ca9809" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280398}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5822a78c-60b1-5039-aac8-bfd9e6f7929a" :question/math-academy-id "q-329275" :question/problem "Express $\\operatorname{sin}⁡(x-\\frac{5\\pi }{4})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-\\frac{5\\pi }{4})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{5\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{5\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{5\\pi }{4})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}+\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186280400 :knowledge-point/_questions [{:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685e18fc-4944-5e2c-941c-76d4c58ec476" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280402}] :answer-field/correct {:answer/id #uuid "685e18fc-4944-5e2c-941c-76d4c58ec476" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186280402} :answer-field/id #uuid "50b1eadc-a034-5534-a37f-6b36fe8f64ae" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280401} {:answer-field/choices [{:answer/id #uuid "648e55c2-d285-5e7f-a420-79511eaeee59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186280404}] :answer-field/correct {:answer/id #uuid "648e55c2-d285-5e7f-a420-79511eaeee59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186280404} :answer-field/id #uuid "f192b1ff-e6dc-51ac-ba90-d39f87178d44" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186280403}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a72241ef-f59f-5f4c-9f44-65db70c98cfd" :question/math-academy-id "q-332178" :question/problem "Express $\\operatorname{sin}⁡(x-{300}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{300}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={300}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{300}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{300}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{300}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{1}{2})-\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}]}
