+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332178/field-1" "q-332178/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4"] :knowledge-point/questions ["q-332178"] :db/ensure [:knowledge-point/validate]}]
