472673228e2d6779747d4" "q-141286/selection/d6187f76c7170bbd222b52fb66f1715de193943502ea03b462b3dca00220a152" "q-141286/selection/06c129a163c97006369bb0806e7b9e704714ecf801adbcbb3dc7754660f94847"] :db/ensure [:answer-field/validate]} {:db/id "q-141286" :question/id #uuid "d744db45-c011-5308-9fea-620febc22042" :question/math-academy-id "q-141286" :question/problem "$\\operatorname{sin}⁡(x-\\frac{3\\pi }{4})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{4})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-141286/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de"] :knowledge-point/questions ["q-141286"] :db/ensure [:knowledge-point/validate]} {:db/id "q-142026/selection/27caf57cffa9ecbe0f8f3fc4a54af7fc14996112136bc8a5ee67f1b6c263cdac" :answer/id #uuid "c556a219-7476-5554-afaf-c3f3f854f199" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-142026/selection/43bc8e95a2b3c03a3eab78aa6f0b3530740d15488957e9095ae4c5e23a9abf43" :answer/id #uuid "5deb9fe7-caea-55ea-a4e2-a22cefae0519" :answer/ty