eld/validate]} {:db/id "q-15877" :question/id #uuid "e87aa4fa-e3c4-5171-8b04-e41871a6eb96" :question/math-academy-id "q-15877" :question/problem "${\\int }_{5}^{8}\\frac{-4}{x-4}\\,\\text{d}x=$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =x-4 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =1 \\\\ \\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=x-4.$\n\n$$\n\\begin{aligned}x & 5 & 8 \\\\ u & 1 & 4\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{5}^{8}\\frac{-4}{(x-4)}\\,\\text{d}x={\\int }_{1}^{4}\\frac{-4}{u}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{-4}{u}\\,\\text{d}u & =-4{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =-4\\operatorname{ln}⁡(u){|}_{1}^{4} \\\\  & =-4(\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(1)) \\\\  & =-4\\operatorname{ln}⁡({2}^{2}) \\\\  & =-4\\cdot 2\\operatorname{ln}⁡(2) \\\\  & =-8\\operatorname{ln}⁡(2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15877/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074"] :knowledge-point/questions ["q-15877"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49622/selection/182f0f9407d9f28b8cf54cac32cb940fcc725d384d0743f8cafed99d09df6be3" :answer/id #uuid "77cb28dc-f058-5163-b9bc-08d0e68eed78" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(3\\sqrt{3}+1)" :db/ensure [:answer/validate]} {:db/id "q-49622/selection/0674b53ca9ee3340b9340eca1c701a2ba03f2917a116bee4560e0737c4d3c20e" :answer/id #uuid "3bcb485f-2afd-5331-9622-d064c001cd56" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\sqrt{7}-1)" :db/ensure [:answer/validate]} {:db/id "q-49622/selection/f60a8ad336a9f9ca0754513d240108b9dd2006a9e013d4e05ebd915f22cd1b14" :answer/id #uuid "c81df30a-dbff-54ac-82fb-bc74b0a72e44" :answer/type :answer.type/math :answer/value "\\frac{1}{12}(3\\sqrt{3}-1)" :db/ensure [:answer/validate]} {:db/id "q-49622/selection/8c84812f6040f461a7cc69ab45e0f3b8fc43328ec989e2a67ac634e3c5990566" :answer/id #uuid "bc43b040-ebaf-5560-b3f2-ce118c10c909" :answer/type :answer.type/math :answer/value "\\frac{1}{12}(3\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-49622/selection/b4c73af6e642560e8ceeb63b1b4f17dd4ec62255e79735cb2c84c0574ee87fbf" :answer/id #uuid "3432fd4b-0bf9-5589-8584-f55daf67a1ee" :answer/type :answer.type/math :answer/value "\\frac{1}{6}(3\\sqrt{3}-1)" :db/ensure [:answer/validate]} {:db/id "q-49622/selection" :answer-field/id #uuid "f6e53489-8557-565c-8dd0-ba5dba7f7f7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49622/selection/f60a8ad336a9f9ca0754513d240108b9dd2006a9e013d4e05ebd915f22cd1b14" :answer-field/choices ["q-49622/selection/182f0f9407d9f28b8cf54cac32cb940fcc725d384d0743f8cafed99d09df6be3" "q-49622/selection/0674b53ca9ee3340b9340eca1c701a2ba03f2917a116bee4560e0737c4d3c20e" "q-49622/selection/f60a8ad336a9f9ca0754513d240108b9dd2006a9e013d4e05ebd915f22cd1b14" "q-49622/selection/8c84812f6040f461a7cc69ab45e0f3b8fc43328ec989e2a67ac634e3c5990566" "q-49622/selection/b4c73af6e642560e8ceeb63b1b4f17dd4ec62255e79735cb2c84c0574ee87fbf"] :db/ensure [:answer-field/validate]} {:db/id "q-49622" :question/id #uuid "5a0e8010-c0be-584f-b09e-fe647c95bf26" :question/math-academy-id "q-49622" :question/problem "Evaluate the definite integral ${\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =8x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =8 \\\\ \\text{d}u & =8\\,\\text{d}x \\\\ \\frac{1}{8}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=8x+1.$\n\n$$\n\\begin{aligned}x & 0 & \\frac{1}{4} \\\\ u & 1 & 3\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/4}\\sqrt{8x+1}\\,\\text{d}x={\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\sqrt{u}\\,\\cdot \\frac{1}{8}\\,\\text{d}u & =\\frac{1}{8}{\\int }_{1}^{3}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{8}\\cdot {\\frac{2}{3}{u}^{3/2}|}_{1}^{3} \\\\  & =\\frac{1}{8}\\cdot \\frac{2}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{1}{12}({({3}^{3})}^{1/2}-1) \\\\  & =\\frac{1}{12}(3\\sqrt{3}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49622/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded"] :knowledge-point/questions ["q-49622"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336745/field-1/fc784510a164dd3113bdd38f632fe8af4368e44a0a10d18eee9933846cca60cd" :answer/id #uuid "adcd2a81-5496-5403-b12c-471e5467173e" :answer/type :answer.type/math :answer/value "6-3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-336745/field-1" :answer-field/id #uuid "e309f435-2599-5d57-9713-757d69a6e450" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336745/field-1/fc784510a164dd3113bdd38f632fe8af4368e44a0a10d18eee9933846cca60cd" :answer-field/choices ["q-336745/field-1/fc784510a164dd3113bdd38f632fe8af4368e44a0a10d18eee9933846cca60cd"] :db/ensure [:answer-field/validate]} {:db/id "q-336745" :question/id #uuid "dd8a44b9-5e96-56e9-a9db-1c7e08ebe9bd" :question/math-academy-id "q-336745" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{1}\\frac{6x}{\\sqrt{{({x}^{2}+1)}^{3}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{2}+1.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 1 & 2\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\frac{6x}{\\sqrt{{({x}^{2}+1)}^{3}}}\\,\\text{d}x={\\int }_{1}^{2}\\frac{3}{\\sqrt{{u}^{3}}}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}3{u}^{-3/2}\\,\\text{d}u & ={-\\frac{6}{\\sqrt{u}}|}_{1}^{2} \\\\  & =-\\frac{6}{\\sqrt{2}}+\\frac{6}{\\sqrt{1}} \\\\  & =6-\\frac{6}{\\sqrt{2}} \\\\  & =6-3\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336745/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074"] :knowledge-point/questions ["q-336745"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336783/field-1/34219f229a95b374101226ed6e8380124ab0bbcf04f479caa9d1b203ca15969e" :answer/id #uuid "f0344e34-f649-51d1-87fd-83dd085d43a1" :answer/type :answer.type/math :answer/value "\\frac{13}{3}" :db/ensure [:answer/validate]} {:db/id "q-336783/field-1/5521c093c4d60c23d630a99bc791ac7318f4615e164361df756510ffc0408a97" :answer/id #uuid "fb6e7614-a171-51b8-b343-31de72340a2c" :answer/type :answer.type/math :answer/value "\\frac{14}{3}" :db/ensure [:answer/validate]} {:db/id "q-336783/field-1" :answer-field/id #uuid "c24ebd82-cd16-56ab-ba94-bb1e551614d1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336783/field-1/34219f229a95b374101226ed6e8380124ab0bbcf04f479caa9d1b203ca15969e" :answer-field/choices ["q-336783/field-1/34219f229a95b374101226ed6e8380124ab0bbcf04f479caa9d1b203ca15969e" "q-336783/field-1/5521c093c4d60c23d630a99bc791ac7318f4615e164361df756510ffc0408a97"] :db/ensure [:answer-field/validate]} {:db/id "q-336783" :question/id #uuid "79a02123-0558-59bb-940e-35961aa42c04" :question/math-academy-id "q-336783" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =9x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =9 \\\\ \\text{d}u & =9\\,\\text{d}x \\\\ \\frac{1}{9}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=9x+2.$\n\n$$\n\\begin{aligned}x & 0 & \\frac{1}{3} \\\\ u & 2 & 5\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x={\\int }_{2}^{5}{u}^{2}\\cdot \\frac{1}{9}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/3}{(9x+2)}^{2}\\,\\text{d}x & ={\\int }_{2}^{5}{u}^{2}\\cdot \\frac{1}{9}\\text{d}u \\\\  & =\\frac{1}{9}{\\int }_{2}^{5}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{9}\\cdot {\\frac{1}{3}{u}^{3}|}_{2}^{5} \\\\  & =\\frac{1}{9}\\cdot \\frac{1}{3}({5}^{3}-{2}^{3}) \\\\  & =\\frac{1}{27}(125-8) \\\\  & =\\frac{13}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336783/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded"] :knowledge-point/questions ["q-336783"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336804/field-1/136b22b31b53ca9a2526d855ba5b7e64040f9e3c0b2716cff2935a7ec0a334db" :answer/id #uuid "e58e98b7-da57-5817-aa3a-b4592b933728" :answer/type :answer.type/math :answer/value "\\frac{52}{3}" :db/ensure [:answer/validate]} {:db/id "q-336804/field-1" :answer-field/id #uuid "7f1b2e73-a5da-595e-a0b8-7173d9753500" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336804/field-1/136b22b31b53ca9a2526d855ba5b7e64040f9e3c0b2716cff2935a7ec0a334db" :answer-field/choices ["q-336804/field-1/136b22b31b53ca9a2526d855ba5b7e64040f9e3c0b2716cff2935a7ec0a334db"] :db/ensure [:answer-field/validate]} {:db/id "q-336804" :question/id #uuid "6a36f9e2-22eb-5841-808a-7a7af27f1105" :question/math-academy-id "q-336804" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{2\\sqrt{2}}2x\\sqrt{{x}^{2}+1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{2}+1.$\n\n$$\n\\begin{aligned}x & 0 & 2\\sqrt{2} \\\\ u & 1 & 9\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2\\sqrt{2}}\\sqrt{{x}^{2}+1}\\cdot 2x\\,\\text{d}x={\\int }_{1}^{9}\\sqrt{u}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}\\sqrt{u}\\,\\text{d}u & ={\\int }_{1}^{9}{u}^{1/2}\\,\\text{d}u \\\\  & ={\\frac{2}{3}{u}^{3/2}|}_{1}^{9} \\\\  & =\\frac{2}{3}({9}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{2}{3}(({3}^{2})^{3/2}-1) \\\\  & =\\frac{2}{3}({3}^{3}-1) \\\\  & =\\frac{52}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336804/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded"] :knowledge-point/questions ["q-336804"] :db/ensure [:knowledge-point/validate]}]
