[{:db/id "q-1091/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "43bdc5a8-22ba-5f2e-a766-68682e19ca5a" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-1091/selection/906fb68e52f34c93aaa89471be2f2ff4994dc9adb32c934377257fa64a54e307" :answer/id #uuid "75258219-ad34-596f-8f9b-bf0ecc86b17a" :answer/type :answer.type/math :answer/value "-33" :db/ensure [:answer/validate]} {:db/id "q-1091/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" :answer/id #uuid "d57ec0fd-73b2-541b-aaee-acd985d2e80d" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "q-1091/selection/9d2b9cb7ce400b35641967e3943fa7da5fe42e792a77a83ad812afd8c6806fe6" :answer/id #uuid "7db46d9f-07ec-5b9c-aab2-0501c0dcff7a" :answer/type :answer.type/math :answer/value "77" :db/ensure [:answer/validate]} {:db/id "q-1091/selection/71ec7720d7077a8c88c1c4a9c53a3f81078793450c23aec02efcc43f1fc689b6" :answer/id #uuid "8968474e-b2c4-5336-b54f-d4492f49718d" :answer/type :answer.type/math :answer/value "82" :db/ensure [:answer/validate]} {:db/id "q-1091/selection" :answer-field/id #uuid "059c44d3-1284-50ec-8ef0-7cbb4b697e49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1091/selection/906fb68e52f34c93aaa89471be2f2ff4994dc9adb32c934377257fa64a54e307" :answer-field/choices ["q-1091/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-1091/selection/906fb68e52f34c93aaa89471be2f2ff4994dc9adb32c934377257fa64a54e307" "q-1091/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" "q-1091/selection/9d2b9cb7ce400b35641967e3943fa7da5fe42e792a77a83ad812afd8c6806fe6" "q-1091/selection/71ec7720d7077a8c88c1c4a9c53a3f81078793450c23aec02efcc43f1fc689b6"] :db/ensure [:answer-field/validate]} {:db/id "q-1091" :question/id #uuid "384e9c4f-c4b4-5e71-ae10-7eb74dbf658f" :question/math-academy-id "q-1091" :question/problem "Calculate the minor of the entry ${x}_{21}$ in the matrix\n$X=[\\begin{aligned}9 & -3 & 0 \\\\ -2 & 8 & 6 \\\\ -1 & 0 & 11\\end{aligned}].$" :question/worked-solution "The minor of ${x}_{21}=-2$ (second row, first column) is the determinant of the remaining entries when the column and row containing $-2$ are removed: \n\n$$\nX=[\\begin{aligned}∗ & -3 & 0 \\\\ -2 & ∗ & ∗ \\\\ ∗ & 0 & 11\\end{aligned}]\n$$\n\nSo, the minor of ${x}_{21}=-2$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}-3 & 0 \\\\ 0 & 11\\end{aligned}] & =|\\begin{aligned}-3 & 0 \\\\ 0 & 11\\end{aligned}| \\\\  & =-3\\cdot 11-0\\cdot 0 \\\\  & =-33-0 \\\\  & =-33.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1091/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975"] :knowledge-point/questions ["q-1091"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1094"] :question/problem "Calculate the minor of the entry ${y}_{13}$ in the matrix\n$Y=[\\begin{aligned}15 & 8 & 9 \\\\ 7 & 1 & 2 \\\\ 0 & -1 & 2\\end{aligned}].$" :question/worked-solution "The minor of ${y}_{13}=9$ (first row, third column) is the determinant of the remaining entries when the column and row containing $9$ are removed: \n\n$$\nY=[\\begin{aligned}∗ & ∗ & 9 \\\\ 7 & 1 & ∗ \\\\ 0 & -1 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${y}_{13}=9$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}] & =|\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}| \\\\  & =7\\cdot (-1)-1\\cdot 0 \\\\  & =-7-0 \\\\  & =-7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-319106/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "73f9fae1-9c2e-5e81-a3d7-c8fe5f4ac7d3" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-319106/field-1" :answer-field/id #uuid "d2d0ea86-350c-5743-8fab-8a377cf62fc2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319106/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-319106/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-319106" :question/id #uuid "e60ec994-1d90-5465-85f2-357671b7e5dc" :question/math-academy-id "q-319106" :question/problem "For the matrix\n$A=[\\begin{aligned}2 & -4 & 3 \\\\ 5 & 1 & -1 \\\\ 0 & 6 & 2\\end{aligned}].$\nfind the minor ${M}_{23}$ of the entry ${a}_{23}.$\n\n${M}_{23}=${{field-1}}" :question/worked-solution "The minor of ${a}_{23}=-1$ (second row, third column) is the determinant of the remaining entries when the column and row containing $-1$ are removed: \n\n$$\nA=[\\begin{aligned}2 & -4 & ∗ \\\\ ∗ & ∗ & -1 \\\\ 0 & 6 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{23}=-1$ is\n\n$$\n\\begin{aligned}{M}_{23} & =\\text{det}[\\begin{aligned}2 & -4 \\\\ 0 & 6\\end{aligned}] \\\\  & =|\\begin{aligned}2 & -4 \\\\ 0 & 6\\end{aligned}| \\\\  & =2\\cdot 6-(-4)\\cdot 0 \\\\  & =12-0 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319106/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975"] :knowledge-point/questions ["q-319106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319125/field-1/b30860afe6c7a79dcf72992de54b5f6f0f58c85d3b99c0dc4880ba235ca80fa9" :answer/id #uuid "9dbe1a7c-52d5-506f-9469-989a7eaf0ac3" :answer/type :answer.type/math :answer/value "18-5v" :db/ensure [:answer/validate]} {:db/id "q-319125/field-1" :answer-field/id #uuid "a303f33b-9d1c-5ec2-91eb-2a947fc57823" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319125/field-1/b30860afe6c7a79dcf72992de54b5f6f0f58c85d3b99c0dc4880ba235ca80fa9" :answer-field/choices ["q-319125/field-1/b30860afe6c7a79dcf72992de54b5f6f0f58c85d3b99c0dc4880ba235ca80fa9"] :db/ensure [:answer-field/validate]} {:db/id "q-319125" :question/id #uuid "e9297b12-4763-50c3-a7bc-58c53ecfccef" :question/math-academy-id "q-319125" :question/problem "For the matrix\n$F=[\\begin{aligned}8 & 1 & -2 \\\\ 3 & v & 4 \\\\ 5 & 6 & 7\\end{aligned}],$\nfind the minor ${M}_{13}$ of the element ${f}_{13}.$\n\n${M}_{13}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${f}_{13},$ we remove the first row and third column: \n\n$$\nF=[\\begin{aligned}∗ & ∗ & -2 \\\\ 3 & v & ∗ \\\\ 5 & 6 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${f}_{13}$ is\n\n$$\n\\begin{aligned}{M}_{13} & =det[\\begin{aligned}3 & v \\\\ 5 & 6\\end{aligned}] \\\\  & =|\\begin{aligned}3 & v \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-v\\cdot 5 \\\\  & =18-5v\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319125/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-319125"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319164/field-1/482d657a489affc75f708409a0ee54189b1cec4613daf7fa035b202ee82679a9" :answer/id #uuid "3c77b2b0-20af-5f2d-b84f-2bee18c5c5bc" :answer/type :answer.type/math :answer/value "4y-x" :db/ensure [:answer/validate]} {:db/id "q-319164/field-1/9e167fbfc8abc2518ded4a34b134d2252a14c2b1ca6a5d335d7c3f2a947cf343" :answer/id #uuid "aadd0c69-f4b8-5ad5-97d8-2b540c1e48fa" :answer/type :answer.type/math :answer/value "4y+x" :db/ensure [:answer/validate]} {:db/id "q-319164/field-1" :answer-field/id #uuid "94ec2f97-cd2f-555a-b852-96d2f97bfdb5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319164/field-1/482d657a489affc75f708409a0ee54189b1cec4613daf7fa035b202ee82679a9" :answer-field/choices ["q-319164/field-1/482d657a489affc75f708409a0ee54189b1cec4613daf7fa035b202ee82679a9" "q-319164/field-1/9e167fbfc8abc2518ded4a34b134d2252a14c2b1ca6a5d335d7c3f2a947cf343"] :db/ensure [:answer-field/validate]} {:db/id "q-319164" :question/id #uuid "fa3292b2-32b7-58df-a405-f87de0264923" :question/math-academy-id "q-319164" :question/problem "For the matrix\n$P=[\\begin{aligned}2 & x & 3 \\\\ y & 5 & 4 \\\\ 1 & 2y & x\\end{aligned}],$\nfind the minor ${M}_{23}$ of the element ${p}_{23}.$\n\n${M}_{23}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${p}_{23},$ we remove the second row and third column:\n\n$$\nP=[\\begin{aligned}2 & x & ∗ \\\\ ∗ & ∗ & 4 \\\\ 1 & 2y & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{23}$ is\n\n$$\n\\begin{aligned}{M}_{23} & =det[\\begin{aligned}2 & x \\\\ 1 & 2y\\end{aligned}] \\\\  & =|\\begin{aligned}2 & x \\\\ 1 & 2y\\end{aligned}| \\\\  & =2\\cdot (2y)-x\\cdot 1 \\\\  & =4y-x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319164/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-319164"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319176/field-1/aa08371a43f26eec2bc20b384f9a0c70942186ee73c1fedb70f8f9e92443ddc9" :answer/id #uuid "a8194fd0-b68c-5644-ad28-4499cc9e54ae" :answer/type :answer.type/math :answer/value "k-3ij" :db/ensure [:answer/validate]} {:db/id "q-319176/field-1" :answer-field/id #uuid "db8af351-3fa8-55c7-a01c-2ef1b95545c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319176/field-1/aa08371a43f26eec2bc20b384f9a0c70942186ee73c1fedb70f8f9e92443ddc9" :answer-field/choices ["q-319176/field-1/aa08371a43f26eec2bc20b384f9a0c70942186ee73c1fedb70f8f9e92443ddc9"] :db/ensure [:answer-field/validate]} {:db/id "q-319176" :question/id #uuid "63ec7428-40f3-5f00-b1c7-32207652ae58" :question/math-academy-id "q-319176" :question/problem "For the matrix\n$V=[\\begin{aligned}j & 1 & 3i \\\\ 2 & k & 5 \\\\ 4 & j & k\\end{aligned}],$\nfind the minor ${M}_{21}$ of the element ${v}_{21}.$\n\n${M}_{21}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${v}_{21},$ we remove the second row and first column:\n\n$$\nV=[\\begin{aligned}∗ & 1 & 3i \\\\ 2 & ∗ & ∗ \\\\ ∗ & j & k\\end{aligned}]\n$$\n\nSo, the minor of ${v}_{21}$ is\n\n$$\n\\begin{aligned}{M}_{21} & =det[\\begin{aligned}1 & 3i \\\\ j & k\\end{aligned}] \\\\  & =|\\begin{aligned}1 & 3i \\\\ j & k\\end{aligned}| \\\\  & =1\\cdot k-(3i)\\cdot j \\\\  & =k-3ij.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319176/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-319176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319162/field-1/8a63633850375cb52262cddb5fab3a4c7736608edef9d07d6e9c13000506d722" :answer/id #uuid "d40a72da-b7b8-5330-94c0-31d3b183bec6" :answer/type :answer.type/math :answer/value "14p-6q" :db/ensure [:answer/validate]} {:db/id "q-319162/field-1" :answer-field/id #uuid "37970983-645c-584f-9a04-6a7671510134" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319162/field-1/8a63633850375cb52262cddb5fab3a4c7736608edef9d07d6e9c13000506d722" :answer-field/choices ["q-319162/field-1/8a63633850375cb52262cddb5fab3a4c7736608edef9d07d6e9c13000506d722"] :db/ensure [:answer-field/validate]} {:db/id "q-319162" :question/id #uuid "0d11b757-3f40-5d56-a17c-9cdee90e5ff3" :question/math-academy-id "q-319162" :question/problem "For the matrix\n$B=[\\begin{aligned}2p & q & 3 \\\\ 1 & 4p & 5 \\\\ 6 & 7 & 2q\\end{aligned}],$\nfind the minor ${M}_{23}$ of the element ${b}_{23}.$\n\n${M}_{23}=${{field-1}}" :question/worked-solution "To evaluate the minor of ${b}_{23},$ we remove the second row and third column:\n\n$$\nB=[\\begin{aligned}2p & q & ∗ \\\\ ∗ & ∗ & 5 \\\\ 6 & 7 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${b}_{23}$ is\n\n$$\n\\begin{aligned}{M}_{23} & =det[\\begin{aligned}2p & q \\\\ 6 & 7\\end{aligned}] \\\\  & =|\\begin{aligned}2p & q \\\\ 6 & 7\\end{aligned}| \\\\  & =(2p)\\cdot 7-q\\cdot 6 \\\\  & =14p-6q.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319162/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-319162"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-18246"] :question/problem "Given that the minor of ${p}_{23}$ is ${t}^{2}+12$, find all the possible values of $t$ in the matrix\n\n$$\nP=[\\begin{aligned}t & -8 & 3 \\\\ -7 & 4 & 4 \\\\ -1 & 9 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we remove the second row and third column:\n\n$$\nP=[\\begin{aligned}t & -8 & ∗ \\\\ ∗ & ∗ & 4 \\\\ -1 & 9 & ∗\\end{aligned}]\n$$\n\nThe minor of ${p}_{23}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}t & -8 \\\\ -1 & 9\\end{aligned}] & =|\\begin{aligned}t & -8 \\\\ -1 & 9\\end{aligned}| \\\\  & =t\\cdot 9-(-8)\\cdot (-1) \\\\  & =9t-8.\\end{aligned}\n$$\n\nWe're told that the minor of ${p}_{23}$ is ${t}^{2}+12$, so we must have:\n\n$$\n\\begin{aligned}9t-8 & ={t}^{2}+12 \\\\ {t}^{2}-9t+20 & =0 \\\\ (t-5)(t-4) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $t=4$ and $t=5.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-128082/selection/ae1e1c661c6a411a24fbaa971c6155d961e92ce14b2c9c0d5d7be2734d028b70" :answer/id #uuid "2ba23472-c1c7-5ac7-aeb1-219a1500eed9" :answer/type :answer.type/math :answer/value "t=\\frac{19}{3}" :db/ensure [:answer/validate]} {:db/id "q-128082/selection/73f69635a6f4cdfec311662f51351a88bb96f67e758b2346a97e20efdff877bb" :answer/id #uuid "a1af3526-161d-54dd-b94e-f9338ef39a6a" :answer/type :answer.type/math :answer/value "t=17" :db/ensure [:answer/validate]} {:db/id "q-128082/selection/a6aea6eda5ece54b6cfef0431fb45f6a97d880c62c3e4ca20a7d830c6ede2b25" :answer/id #uuid "b74986d1-8b90-5461-899a-8f0c669bb5c8" :answer/type :answer.type/math :answer/value "t=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-128082/selection/52726137176a928ea93768df3748531c7a2b85f6b7c605331a17fd5666590349" :answer/id #uuid "484161fc-5efa-5aac-a03c-cd6ab2ab4c53" :answer/type :answer.type/math :answer/value "t=23" :db/ensure [:answer/validate]} {:db/id "q-128082/selection/6b78f222a290c082a54fc8b4910bb8282e83b4b7f53f06b8b1a6ccce9636f849" :answer/id #uuid "fd9f2560-0558-5199-9f06-ef22d5c01a90" :answer/type :answer.type/math :answer/value "t=\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-128082/selection" :answer-field/id #uuid "6a6b4e57-94f1-5cd1-bb04-e4409b3403e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128082/selection/a6aea6eda5ece54b6cfef0431fb45f6a97d880c62c3e4ca20a7d830c6ede2b25" :answer-field/choices ["q-128082/selection/ae1e1c661c6a411a24fbaa971c6155d961e92ce14b2c9c0d5d7be2734d028b70" "q-128082/selection/73f69635a6f4cdfec311662f51351a88bb96f67e758b2346a97e20efdff877bb" "q-128082/selection/a6aea6eda5ece54b6cfef0431fb45f6a97d880c62c3e4ca20a7d830c6ede2b25" "q-128082/selection/52726137176a928ea93768df3748531c7a2b85f6b7c605331a17fd5666590349" "q-128082/selection/6b78f222a290c082a54fc8b4910bb8282e83b4b7f53f06b8b1a6ccce9636f849"] :db/ensure [:answer-field/validate]} {:db/id "q-128082" :question/id #uuid "f60c5f2a-2917-5bd9-92a0-889883057b41" :question/math-academy-id "q-128082" :question/problem "Given that the minor of ${p}_{11}$ is $4$, find all the possible values of $t$ in the matrix\n\n$$\nP=[\\begin{aligned}-5t & 18 & 6t \\\\ -3 & 9 & 5 \\\\ 19t & 1 & 3t\\end{aligned}].\n$$" :question/worked-solution "First, we remove the first row and first column:\n\n$$\nP=[\\begin{aligned}5t & ∗ & ∗ \\\\ ∗ & 9 & 5 \\\\ ∗ & 1 & 3t\\end{aligned}]\n$$\n\nThe minor of ${p}_{11}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}9 & 5 \\\\ 1 & 3t\\end{aligned}] & =|\\begin{aligned}9 & 5 \\\\ 1 & 3t\\end{aligned}| \\\\  & =9\\cdot 3t-5\\cdot 1 \\\\  & =27t-5.\\end{aligned}\n$$\n\nWe're told that the minor of ${p}_{11}$ is $4$, so we must have:\n\n$$\n\\begin{aligned}27t-5 & =4 \\\\ 27t & =9 \\\\ t & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solution is $t=\\frac{1}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128082/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-128082"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18244/selection/cee63c8e854995277c168c7e5ec5f3f9b6683a4444ff424b1ffa6e4dd2f32f75" :answer/id #uuid "5f05b373-abf1-5c62-9afe-5876ce72aeea" :answer/type :answer.type/text :answer/value "$k=10$ and $k=-3$ only" :db/ensure [:answer/validate]} {:db/id "q-18244/selection/c79533576a74b099dadeed53bcaec96cdeb0d00e6f9c8e23ca184aa8aeb8baf9" :answer/id #uuid "cd75ca69-bf5f-52ee-8ad4-22e72a3b52cd" :answer/type :answer.type/text :answer/value "$k=0$ and $k=-1$ only" :db/ensure [:answer/validate]} {:db/id "q-18244/selection/514666fffc412357f7bc476582dc71f069955781929125f84a0021b9f8319ace" :answer/id #uuid "01b4cf74-7b06-527d-9033-9d3adb061672" :answer/type :answer.type/text :answer/value "$k=1$ only" :db/ensure [:answer/validate]} {:db/id "q-18244/selection/15d96a69aa0cf3e875cc98da5baaf4fae80c4f490d4c47539074b3a667b6cbbf" :answer/id #uuid "a2d12ff9-eb40-5443-a3dc-8faabe23cadc" :answer/type :answer.type/text :answer/value "$k=-1$ and $k=-2$ only" :db/ensure [:answer/validate]} {:db/id "q-18244/selection/b6885de1352a50b0e677752087c707aeed0b9a235a1c0d05a54512f126fcd97e" :answer/id #uuid "c8332cbb-5348-562a-8f57-2d24aabdd548" :answer/type :answer.type/text :answer/value "$k=-2$ only" :db/ensure [:answer/validate]} {:db/id "q-18244/selection" :answer-field/id #uuid "f0f8e6b0-e235-5052-8512-16a443b8d5b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18244/selection/15d96a69aa0cf3e875cc98da5baaf4fae80c4f490d4c47539074b3a667b6cbbf" :answer-field/choices ["q-18244/selection/cee63c8e854995277c168c7e5ec5f3f9b6683a4444ff424b1ffa6e4dd2f32f75" "q-18244/selection/c79533576a74b099dadeed53bcaec96cdeb0d00e6f9c8e23ca184aa8aeb8baf9" "q-18244/selection/514666fffc412357f7bc476582dc71f069955781929125f84a0021b9f8319ace" "q-18244/selection/15d96a69aa0cf3e875cc98da5baaf4fae80c4f490d4c47539074b3a667b6cbbf" "q-18244/selection/b6885de1352a50b0e677752087c707aeed0b9a235a1c0d05a54512f126fcd97e"] :db/ensure [:answer-field/validate]} {:db/id "q-18244" :question/id #uuid "5a62d5fa-3b38-507f-b4fe-dfd19836563a" :question/math-academy-id "q-18244" :question/problem "Given that the minor of ${a}_{22}$ is $-70$, find all the possible values of $k$ in the matrix\n\n$$\nA=[\\begin{aligned}2k & -8 & 6 \\\\ 0 & 5 & -7 \\\\ 11 & 9 & k+3\\end{aligned}].\n$$" :question/worked-solution "First, we remove the second row and second column:\n\n$$\nA=[\\begin{aligned}2k & ∗ & 6 \\\\ ∗ & 5 & ∗ \\\\ 11 & ∗ & k+3\\end{aligned}]\n$$\n\nThe minor of ${a}_{22}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}2k & 6 \\\\ 11 & k+3\\end{aligned}] & =|\\begin{aligned}2k & 6 \\\\ 11 & k+3\\end{aligned}| \\\\  & =2k\\cdot (k+3)-11\\cdot 6 \\\\  & =2{k}^{2}+6k-66.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{22}$ is $-70$, so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+6k-66 & =-70 \\\\ 2{k}^{2}+6k+4 & =0 \\\\ {k}^{2}+3k+2 & =0 \\\\ (k+1)(k+2) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-18244/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-18244"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18243/selection/920677cbfac63708b9d0f5860df0931e973296d91a8b5e43ac6fb251513d3b94" :answer/id #uuid "bef5c8a2-98d6-573d-83b8-87bc45e7e052" :answer/type :answer.type/text :answer/value "$x=-9$ only" :db/ensure [:answer/validate]} {:db/id "q-18243/selection/9b0f514f575ac649191344611a527b76372da9bf94fe452209f7ec5d478db880" :answer/id #uuid "f934791f-3547-571b-8185-1caed86e09d1" :answer/type :answer.type/text :answer/value "$x=-9$ and $x=9$ only" :db/ensure [:answer/validate]} {:db/id "q-18243/selection/0b71ed31b54db2f2e7ec707b0a04499a5069d7189b0811622a9ab373f5143838" :answer/id #uuid "9d671cbc-a741-5b99-908b-3f3bdb42c8ef" :answer/type :answer.type/text :answer/value "$x=6$ only" :db/ensure [:answer/validate]} {:db/id "q-18243/selection/1ec5e6b6fa0e2a952c0543ef9b15eab2acd619bfc6363426322beee20fde07dd" :answer/id #uuid "979d73ec-6409-59f0-9fa2-6e16c2bdf06e" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=3$ only" :db/ensure [:answer/validate]} {:db/id "q-18243/selection/6ecc08a56b39b0c7f4a22cd394d32888fc0ad3f496ca7dfa8af0d1002bbdca0e" :answer/id #uuid "7cf4a7f0-1295-53cf-9ded-45037759598a" :answer/type :answer.type/text :answer/value "$x=9$ only" :db/ensure [:answer/validate]} {:db/id "q-18243/selection" :answer-field/id #uuid "aea8a39a-de0e-56d9-80ad-c3e3e4bc2a23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18243/selection/1ec5e6b6fa0e2a952c0543ef9b15eab2acd619bfc6363426322beee20fde07dd" :answer-field/choices ["q-18243/selection/920677cbfac63708b9d0f5860df0931e973296d91a8b5e43ac6fb251513d3b94" "q-18243/selection/9b0f514f575ac649191344611a527b76372da9bf94fe452209f7ec5d478db880" "q-18243/selection/0b71ed31b54db2f2e7ec707b0a04499a5069d7189b0811622a9ab373f5143838" "q-18243/selection/1ec5e6b6fa0e2a952c0543ef9b15eab2acd619bfc6363426322beee20fde07dd" "q-18243/selection/6ecc08a56b39b0c7f4a22cd394d32888fc0ad3f496ca7dfa8af0d1002bbdca0e"] :db/ensure [:answer-field/validate]} {:db/id "q-18243" :question/id #uuid "279f1542-6c2c-5bb8-ac83-070b364b0b4a" :question/math-academy-id "q-18243" :question/problem "Given that the minor of ${b}_{33}$ is $3$, find all the possible values of $x$ in the matrix\n\n$$\nB=[\\begin{aligned}6 & -{x}^{2} & -10 \\\\ -5 & 8 & 1 \\\\ 2 & 5 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we remove the third row and third column:\n\n$$\nB=[\\begin{aligned}6 & -{x}^{2} & ∗ \\\\ -5 & 8 & ∗ \\\\ ∗ & ∗ & 0\\end{aligned}]\n$$\n\nThe minor of ${b}_{33}$ is\n\n \n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}6 & -{x}^{2} \\\\ -5 & 8\\end{aligned}] & =|\\begin{aligned}6 & -{x}^{2} \\\\ -5 & 8\\end{aligned}| \\\\  & =6\\cdot 8-(-5)\\cdot (-{x}^{2}) \\\\  & =48-5{x}^{2}.\\end{aligned}\n$$\n\nWe're told that the minor of ${b}_{33}$ is $3$, so we must have:\n\n$$\n\\begin{aligned}48-5{x}^{2} & =3 \\\\ 45-5{x}^{2} & =0 \\\\ 9-{x}^{2} & =0 \\\\ (3-x)(3+x) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-3$ and $x=3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-18243/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-18243"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319138/field-1/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" :answer/id #uuid "882762a0-fb8e-5395-b5b1-db4ee57d4e65" :answer/type :answer.type/math :answer/value "\\frac{11}{3}" :db/ensure [:answer/validate]} {:db/id "q-319138/field-1" :answer-field/id #uuid "f38d6ca7-c179-5353-b5d3-318ea01dff33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319138/field-1/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d" :answer-field/choices ["q-319138/field-1/8677255573c89f51bbda2655bf0990b3a6ef52dd073a8086551da4668a68282d"] :db/ensure [:answer-field/validate]} {:db/id "q-319138" :question/id #uuid "919741b7-a82a-50e9-bac6-3f58f8c3cf00" :question/math-academy-id "q-319138" :question/problem "$$\nA=[\\begin{aligned}x & 2 & 3 \\\\ 4 & 5 & 6 \\\\ 7 & 8 & 9\\end{aligned}].\n$$\n\nGiven that the minor of ${a}_{32}$ is $10$, find the value of $x$ in the matrix above.\n\n$x=$\n {{field-1}}" :question/worked-solution "To evaluate the minor of ${a}_{32},$ we remove the third row and second column: \n\n$$\nA=[\\begin{aligned}x & ∗ & 3 \\\\ 4 & ∗ & 6 \\\\ ∗ & 8 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{32}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}x & 3 \\\\ 4 & 6\\end{aligned}] & =x\\cdot 6-3\\cdot 4 \\\\  & =6x-12.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{32}$ is $10$, so we get\n\n$$\n\\begin{aligned}6x-12 & =10 \\\\ 6x & =22 \\\\ x & =\\frac{11}{3}.\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{11}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319138/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-319138"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4439"] :question/problem "Calculate the minor of the entry $b_{21}$ in the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/8e664813c6467d5bb06a8eb1e1d68778d3142479939624a7a46674f593d786b9.png)" :question/worked-solution "The minor of $b_{21} = 3$ (second row, first column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/a69955fcba387ef3c65f1c1529c2007d8d70f82d95738af9b995999a21198730.png)\n\nSo, the minor of $b_{21}=3$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}] & =|\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}| \\\\  & =1\\cdot 2-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4440"] :question/problem "What is the minor of $c_{22}$ in the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/1449dfd139653f75de7be2e27e86f0c9d2d8a5a17e25ae184b892f489ffbb71e.png)" :question/worked-solution "First, we remove the second row and second column: \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/09bd73c7e51abcad8efa354317519a2687601b3ccdbfea0ac2b6222f75b3397e.png)\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}] & =|\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}| \\\\  & =7x\\cdot 5-(-3y)\\cdot (-y) \\\\  & =35x-3{y}^{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4441"] :question/problem "Given that the minor of $a_{23}$ is $5,$ find all the possible values of $k$ in the matrix\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/1d37ba9039f24a96be2d148c9f30c8a10ca30c9745ad8a28df23de5a42f6dcab.png)" :question/worked-solution "First, we remove the second row and third column:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14075201/assets/80f9b95139f7b571c7752ee1feec4c9d3df8456223581736ae019344a6f9a080.png)\n\nThe minor of $a_{23}$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}] & =|\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}| \\\\  & =k\\cdot 2k-3\\cdot (-1) \\\\  & =2{k}^{2}+3.\\end{aligned}\n$$\n\nWe're told that the minor of $a_{23}$ is $5,$ so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+3 & =5 \\\\ 2{k}^{2} & =2 \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=1.$" :db/ensure [:question/validate]}]
