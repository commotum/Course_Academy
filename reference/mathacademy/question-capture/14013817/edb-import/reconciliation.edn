2}-4(x-1)^{2} & =4 \\\\ \\frac{(y-3)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,3\\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "87ee84d0a5501ad951f06e8bddc3d8b800223a98b303b42b3e246d287a60ebb7"} {"question" "q-328397" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/activity-metadata.json" "file_sha256" "08283654b18d4f3db96e73000f824a9f15e18318a753ff27764d0667804ac18d"} {"question" "q-328397" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "87ee84d0a5501ad951f06e8bddc3d8b800223a98b303b42b3e246d287a60ebb7"} {"question" "q-328397" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "87ee84d0a5501ad951f06e8bddc3d8b800223a98b303b42b3e246d287a60ebb7"} {"question" "q-328397" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "87ee84d0a5501ad951f06e8bddc3d8b800223a98b303b42b3e246d287a60ebb7"} {"question" "q-328397" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "87ee84d0a5501ad951f06e8bddc3d8b800223a98b303b42b3e246d287a60ebb7"}] "usage" {} "basis"