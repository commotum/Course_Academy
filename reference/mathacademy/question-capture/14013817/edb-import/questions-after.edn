#{[{:db/id #edb/ref 17592186291452 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b96b734-9778-5f3a-9406-b441eed1a2ff" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-8)" :db/id #edb/ref 17592186291454} {:answer/id #uuid "f7243bdd-da61-53d8-9fdf-6550a9a4956d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186291455} {:answer/id #uuid "22500518-dbc9-5d10-b1e7-af4132b358f7" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291456} {:answer/id #uuid "5fb9c3fb-4a4d-55dc-91e8-03112b783e23" :answer/type {:db/ident :answer.type/math} :answer/value "(8,1)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "536aca86-44fe-5155-ac2f-77cba43e221e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186291458}] :answer-field/correct {:answer/id #uuid "536aca86-44fe-5155-ac2f-77cba43e221e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186291458} :answer-field/id #uuid "81d07959-e956-51ce-aa74-bb12d49d2b2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291453}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "722699b4-1a0d-5686-9e7d-fcb338d56349" :question/math-academy-id "q-116107" :question/problem "What is the center of the hyperbola \n${x}^{2}-8{y}^{2}+6x+48y=71?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-8{y}^{2}+6x+48y & =71 \\\\ {x}^{2}+6x-8{y}^{2}+48y & =71 \\\\ [{x}^{2}+6x]-8[{y}^{2}-6y] & =71 \\\\ [(x+3)^{2}-9]-8[(y-3)^{2}-9] & =71 \\\\ (x+3)^{2}-9-8(y-3)^{2}+72 & =71 \\\\ (x+3)^{2}-8(y-3)^{2} & =8 \\\\ \\frac{(x+3)^{2}}{8}-(y-3)^{2} & =1 \\\\ \\frac{(x-(-3))^{2}}{(\\sqrt{8})^{2}}-\\frac{(y-3)^{2}}{{1}^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-3,3).$"}] [{:db/id #edb/ref 17592186291459 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92e10102-652a-56cb-a323-851ea8386c36" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186291461} {:answer/id #uuid "c7d46d12-c266-57bf-8dd4-0b9c17ef2acc" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186291462} {:answer/id #uuid "aebf3980-7bf1-51bd-97cf-eb2ce5416ceb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186291463} {:answer/id #uuid "21452f5d-7465-5a0b-9826-bd1db4e27c8d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186291464} {:answer/id #uuid "4e1d26ba-c1e0-5946-a87c-815dd13da346" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186291465}] :answer-field/correct {:answer/id #uuid "92e10102-652a-56cb-a323-851ea8386c36" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186291461} :answer-field/id #uuid "5897fe61-a0af-5a77-8b7d-4905ee537069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291460}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3974ad26-6b81-5dc3-9e33-03508cd607dc" :question/math-academy-id "q-16380" :question/problem "What is the center of the hyperbola \n$-10{x}^{2}+9{y}^{2}+20x+36y=64?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-10{x}^{2}+9{y}^{2}+20x+36y & =64 \\\\ 9{y}^{2}+36y-10{x}^{2}+20x & =64 \\\\ 9[{y}^{2}+4y]-10[{x}^{2}-2x] & =64 \\\\ 9[(y+2)^{2}-4]-10[(x-1)^{2}-1] & =64 \\\\ 9(y+2)^{2}-36-10(x-1)^{2}+10 & =64 \\\\ 9(y+2)^{2}-10(x-1)^{2} & =64+36-10 \\\\ 9(y+2)^{2}-10(x-1)^{2} & =90 \\\\ \\frac{(y+2)^{2}}{10}-\\frac{(x-1)^{2}}{9} & =1.\\end{aligned}\n$$\n\nHence, the center is $(1,-2).$"}] [{:db/id #edb/ref 17592186291466 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3805535e-20d1-5b0f-a87a-59230dc2ab82" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291468}] :answer-field/correct {:answer/id #uuid "3805535e-20d1-5b0f-a87a-59230dc2ab82" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291468} :answer-field/id #uuid "3b1120b4-9d49-53bf-a90e-027c5e8cdbd0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291467} {:answer-field/choices [{:answer/id #uuid "6d9f8978-a95b-5f65-b3d4-b13bcc577067" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291470}] :answer-field/correct {:answer/id #uuid "6d9f8978-a95b-5f65-b3d4-b13bcc577067" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186291470} :answer-field/id #uuid "062c8a91-1a3a-5ba1-968c-748e80b75a73" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291469}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0e89209f-ad51-5ffe-a563-1b87dbd6c49a" :question/math-academy-id "q-328280" :question/problem "The center of the hyperbola $\\frac{(y+3)^{2}}{25}-\\frac{(x-4)^{2}}{9}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-3))^{2}}{{5}^{2}}-\\frac{(x-4)^{2}}{{3}^{2}}=1\n$$\n\nIn this case, we have $h=4$ and $k=-3.$\n\nTherefore, the center of the hyperbola is $(\\,4,-3\\,).$"}] [{:db/id #edb/ref 17592186291471 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c86939-8c99-5a56-8ffe-383a1b611c26" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291473} {:answer/id #uuid "f5884a66-2e21-5b66-bcf5-af8f60d4b733" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291474}] :answer-field/correct {:answer/id #uuid "72c86939-8c99-5a56-8ffe-383a1b611c26" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291473} :answer-field/id #uuid "bc4a7150-b28b-5f86-bf16-b80258a5f170" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291472} {:answer-field/choices [{:answer/id #uuid "baf47612-0907-5263-95fe-e164d900bd4f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291476}] :answer-field/correct {:answer/id #uuid "baf47612-0907-5263-95fe-e164d900bd4f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291476} :answer-field/id #uuid "3fd4b86e-2a1b-5c6a-86a9-1e03505a534b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291475}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "de9dda81-a345-5236-acbb-5d210b78c08c" :question/math-academy-id "q-328358" :question/problem "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+2y=7$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+2y & =7 \\\\ 4({x}^{2}-2x)-({y}^{2}-2y) & =7 \\\\ 4[(x-1)^{2}-1]-[(y-1)^{2}-1] & =7 \\\\ 4(x-1)^{2}-4-(y-1)^{2}+1 & =7 \\\\ 4(x-1)^{2}-(y-1)^{2} & =7+4-1 \\\\ 4(x-1)^{2}-(y-1)^{2} & =10 \\\\ \\frac{(x-1)^{2}}{5/2}-\\frac{(y-1)^{2}}{10} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,1\\,).$"}] [{:db/id #edb/ref 17592186291477 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a2f497b-694a-5d44-934d-cce2783e09eb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291479}] :answer-field/correct {:answer/id #uuid "7a2f497b-694a-5d44-934d-cce2783e09eb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291479} :answer-field/id #uuid "45f0cbb2-9694-542a-8eaf-1d44ab5f4e1a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291478} {:answer-field/choices [{:answer/id #uuid "fcbfaef9-39c5-5eef-9e64-2d5edfdf650d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291481}] :answer-field/correct {:answer/id #uuid "fcbfaef9-39c5-5eef-9e64-2d5edfdf650d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291481} :answer-field/id #uuid "8728b411-40b5-5a14-89c7-41c3ddc3bb3d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291480}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8ed78d8d-b23a-5497-95ca-a50ccc4f0bdb" :question/math-academy-id "q-328397" :question/problem "The center of the hyperbola ${y}^{2}-4{x}^{2}-6y+8x=-1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-4{x}^{2}-6y+8x & =-1 \\\\ {y}^{2}-6y-4{x}^{2}+8x & =-1 \\\\ [{y}^{2}-6y]-4[{x}^{2}-2x] & =-1 \\\\ [(y-3)^{2}-9]-4[(x-1)^{2}-1] & =-1 \\\\ (y-3)^{2}-9-4(x-1)^{2}+4 & =-1 \\\\ (y-3)^{2}-4(x-1)^{2} & =-1+9-4 \\\\ (y-3)^{2}-4(x-1)^{2} & =4 \\\\ \\frac{(y-3)^{2}}{{2}^{2}}-\\frac{(x-1)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,3\\,).$"}]}
