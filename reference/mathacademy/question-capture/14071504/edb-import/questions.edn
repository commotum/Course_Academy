017} {:answer/id #uuid "6e8fee0d-1383-5240-80a2-48b9c7b3831a" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186296018} {:answer/id #uuid "faccb8df-3601-5631-9e54-3e0457372e87" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c}" :db/id #edb/ref 17592186296019}] :answer-field/correct {:answer/id #uuid "6e8fee0d-1383-5240-80a2-48b9c7b3831a" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186296018} :answer-field/id #uuid "1d58d9ae-d235-5db6-8a73-ab07cae3dc86" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296014}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ffcf60cf-7bfd-53f1-a544-3178bf8a52a6" :question/math-academy-id "q-86587" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/02dabe7099c201f717885a05842e0cb8543bd01cccf0d6c52147f674cde15dce.png)\n\nLet $U={a,b,c,20,40}$ be the universal set and let $R={b,20,40}.$ What is the complement of $R?$" :question/worked-solution "The complement of $R,$ denoted $\\overset{―}{R},$ consists of all the elements in $U$ that are not in $R.$ To represent $\\overset{―}{R},$ we will shade in all the area of $U$ that is *outside* of $R,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/79900f22c35570b35cf10664768ecf4460a7953ddf7f91dac1893b3ce81339bf.png)\n\nThe elements in the shaded area are $a$ and $c.$ These are the elements of $U$ that are not in $R.$ Therefore, the complement of $R$ is\n\n$$\n\\overset{―}{R}={a,c}.\n$$"}]}
