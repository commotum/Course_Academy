#{[{:db/id #edb/ref 17592186157023 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/id #uuid "7bd73f85-c4d5-57c4-a3ba-094d93c105cc" :question/math-academy-id "e-7163" :question/problem "Let $U = \\{ a, b, c, d, e, f, g \\}$ be the universal set and let $B = \\{ b, d, f \\}.$ What is $\\overline{B}?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/25f40492b0466495519d6ff94859d0cef4c206e291d31eba2a980732b497af31.png)" :question/worked-solution "The complement of $B,$ denoted $\\overline B,$ consists of all the elements in $U$ that are not in $B.$ To represent $\\overline B,$ we will shade in all the area of $U$ that is *outside* of $B,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/daad235ef63e127e99bf3eec7b7bbe75fe6adb969f5b54ebb5a3fb010773b680.png)\n\nThe elements in the shaded area are $a,$ $c,$ $e,$ and $g.$ These are the elements of $U$ that are not in $B.$ Therefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{ a,c,e,g \\}.\n$$"}] [{:db/id #edb/ref 17592186157024 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/id #uuid "1c497253-5007-52a4-9f93-838d4b4699b0" :question/math-academy-id "e-7164" :question/problem "Let $U = \\{ a, b, c, d, e, f, g \\}$ be the universal set and let $A = \\{ b, c, d, f, g \\}.$ What is $\\overline{A}?$" :question/worked-solution "The complement of $A,$ denoted $\\overline{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe only elements of $U$ that are not in $A$ are $a$ and $e.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overline{A} = \\{ a, e \\}.\n$$"}] [{:db/id #edb/ref 17592186157025 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/id #uuid "2647b940-84c6-5b52-9c99-6a4ee5ebb669" :question/math-academy-id "e-7165" :question/problem "Let $U = \\{ 1, 2, 3, \\ldots, 30 \\}$ be the universal set and let $B = \\{ 5, 6, 7, \\ldots, 28 \\}.$ What is $\\overline{B}?$" :question/worked-solution "The complement of $B,$ denoted $\\overline{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe universal set $U$ consists of the integers $1$ through $30,$ while the set $B$ consists of the integers $5$ through $28.$\n\nSo, the only elements of $U$ that are not in $B$ are $1,$ $2,$ $3,$ $4,$ $29,$ and $30.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overline{B} = \\{ 1,2,3,4,29,30 \\}.\n$$"}] [{:db/id #edb/ref 17592186295929 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fce5f31-8089-5caa-9ce1-c393c4484c6d" :answer/type {:db/ident :answer.type/math} :answer/value "{10,101}" :db/id #edb/ref 17592186295931} {:answer/id #uuid "25014af9-259f-5994-b9d2-ce9c4245c07f" :answer/type {:db/ident :answer.type/math} :answer/value "{1,10,11,101}" :db/id #edb/ref 17592186295932} {:answer/id #uuid "8f103d80-d258-5f99-881d-e530ce727bc1" :answer/type {:db/ident :answer.type/math} :answer/value "{10,11,101}" :db/id #edb/ref 17592186295933} {:answer/id #uuid "d882dbec-267e-5c4d-b31d-24977dfdc9f9" :answer/type {:db/ident :answer.type/math} :answer/value "{10,11}" :db/id #edb/ref 17592186295934} {:answer/id #uuid "e7ca1e86-e1ce-5a32-accd-32e021c6194c" :answer/type {:db/ident :answer.type/math} :answer/value "{1,11}" :db/id #edb/ref 17592186295935}] :answer-field/correct {:answer/id #uuid "0fce5f31-8089-5caa-9ce1-c393c4484c6d" :answer/type {:db/ident :answer.type/math} :answer/value "{10,101}" :db/id #edb/ref 17592186295931} :answer-field/id #uuid "5f543f21-942c-5804-86ee-e45a70a572aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295930}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "83585c1d-effc-5213-a273-fdec159dd36c" :question/math-academy-id "q-102248" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/277debf60ec84e4693e5a699a9c2eda6af6248e8f1a53e005dae79f70b536722.png)\n\nLet $U={1,10,11,101}$ be the universal set and let $Y={1,11}.$ What is $\\overset{―}{Y}?$" :question/worked-solution "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of all the elements in $U$ that are not in $Y.$ To represent $\\overset{―}{Y},$ we will shade in all the area of $U$ that is *outside* of $Y,$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035973/assets/25b1388466c800664b7d438eabf58cafd365174ca877abff8cd0465e2b23e7cb.png)\n\nThe elements in the shaded area are $10,$ and $101.$ These are the elements of $U$ that are not in $Y.$ Therefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}={10,101}.\n$$"}] [{:db/id #edb/ref 17592186295957 :knowledge-point/_questions [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "187cba77-f857-5469-b455-5f6a6691232d" :answer/type {:db/ident :answer.type/math} :answer/value "{l,m,n…,z}" :db/id #edb/ref 17592186295959} {:answer/id #uuid "c26bc20f-a72b-5992-a3c6-8f4857574ac8" :answer/type {:db/ident :answer.type/math} :answer/value "{m,n,o…,z}" :db/id #edb/ref 17592186295960} {:answer/id #uuid "4f224627-7277-5745-84a3-0aa30bd95e89" :answer/type {:db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186295961} {:answer/id #uuid "c5a55504-c71b-58a3-a833-7bf431445e73" :answer/type {:db/ident :answer.type/math} :answer/value "{i,j,k,…,z}" :db/id #edb/ref 17592186295962} {:answer/id #uuid "672d52a6-0470-57f7-87f2-b17d8586b6df" :answer/type {:db/ident :answer.type/math} :answer/value "{j,k,l…,z}" :db/id #edb/ref 17592186295963}] :answer-field/correct {:answer/id #uuid "4f224627-7277-5745-84a3-0aa30bd95e89" :answer/type {:db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186295961} :answer-field/id #uuid "bf5cbd0f-271d-5b9e-9396-5e93c5853b31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295958}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "00d20e46-5a15-5da8-864f-78bbef842ab5" :question/math-academy-id "q-105188" :question/problem "Let $U={a,b,c,…,z}$ be the universal set and $Y={a,b,c,…,j}$, then $\\overset{―}{Y}=$" :question/worked-solution "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}={k,l,m,…,z}.\n$$"}] [{:db/id #edb/ref 17592186157501 :knowledge-point/_questions [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "948de04a-23c3-556d-91cd-1e9a35ca06dd" :answer/type {:db/ident :answer.type/math} :answer/value "{-20,-19,-18, …, 20}" :d