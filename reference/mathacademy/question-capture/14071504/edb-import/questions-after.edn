d #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "187cba77-f857-5469-b455-5f6a6691232d" :answer/type {:db/ident :answer.type/math} :answer/value "{l,m,n…,z}" :db/id #edb/ref 17592186295959} {:answer/id #uuid "c26bc20f-a72b-5992-a3c6-8f4857574ac8" :answer/type {:db/ident :answer.type/math} :answer/value "{m,n,o…,z}" :db/id #edb/ref 17592186295960} {:answer/id #uuid "4f224627-7277-5745-84a3-0aa30bd95e89" :answer/type {:db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186295961} {:answer/id #uuid "c5a55504-c71b-58a3-a833-7bf431445e73" :answer/type {:db/ident :answer.type/math} :answer/value "{i,j,k,…,z}" :db/id #edb/ref 17592186295962} {:answer/id #uuid "672d52a6-0470-57f7-87f2-b17d8586b6df" :answer/type {:db/ident :answer.type/math} :answer/value "{j,k,l…,z}" :db/id #edb/ref 17592186295963}] :answer-field/correct {:answer/id #uuid "4f224627-7277-5745-84a3-0aa30bd95e89" :answer/type {:db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186295961} :answer-field/id #uuid "bf5cbd0f-271d-5b9e-9396-5e93c5853b31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295958}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "00d20e46-5a15-5da8-864f-78bbef842ab5" :question/math-academy-id "q-105188" :question/problem "Let $U={a,b,c,…,z}$ be the universal set and $Y={a,b,c,…,j}$, then $\\overset{―}{Y}=$" :question/worked-solution "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}={k,l,m,…,z}.\n$$"}] [{:db/id #edb/ref 17592186157501 :knowledge-point/_questions [{:knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "948de04a-23c3-556d-91cd-1e9a35ca06dd" :answer/type {:db/ident :answer.type/math} :answer/value "{-20,-19,-18, …, 20}" :db/id #edb/ref 17592186153582} {:answer/id #uuid "c9711e35-397e-5aec-a9e9-8785bec59e76" :answer/type {:db/ident :answer.type/math} :answer/value "{-20,-19,-18, …, 1}" :db/id #edb/ref 17592186153583} {:answer/id #uuid "f18da8dd-3992-56e0-8efa-0ebadd087d3a" :answer/type {:db/ident :answer.type/math} :answer/value "{1, 2, 3, …, 20}" :db/id #edb/ref 17592186153584} {:answer/id #uuid "14d731a1-049d-5e8f-8796-8c42455e06f6" :answer/type {:db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186153585} {:answer/id #uuid "2da70ff8-5987-50d5-92c0-8b5be441cafe" :answer/type {:db/ident :answer.type/math} :answer/value "{-20,-19,-18, …, 0}" :db/id #edb/ref 17592186153586}] :answer-field/correct {:answer/id #uuid "2da70ff8-5987-50d5-92c0-8b5be441cafe" :answer/type {:db/ident :answer.type/math} :answer/value "{-20,-19,-18, …, 0}" :db/id #edb/ref 17592186153586} :answer-field/id #uuid "8a9ccb41-0209-5f92-82ab-ec58a17c83f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186153581}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6edbc226-e8ce-5ce6-8300-f01de78e36a8" :question/math-academy-id "q-1233" :question/problem "If $U={-20,-19,-18,…,20}$ is the universal set and $A={1,2,3,…,20},$ then $\\overset{―}{A}=$" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe universal set $U$ consists of the integers $-20$ through $20,$ while he set $A$ consists of the integers $1$ through $28.$\n\nSo, the only elements of $U$ that are not in $A$ are the integers $-20$ through $0.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}={-20,-19,-18,…,0}.\n$$"}] [{:db/id #edb/ref 17592186371923 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe10eba8-0282-5d63-a183-5ec382a30f37" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,...,8}" :db/id #edb/ref 17592186371925} {:answer/id #uuid "7a00e38c-7f41-5455-ad31-b93dda649afc" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,...,9}" :db/id #edb/ref 17592186371926} {:answer/id #uuid "c0b89cb4-4843-5101-9699-b0cbf6897178" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,3,...,8}" :db/id #edb/ref 17592186371927} {:answer/id #uuid "5a91afc6-3c5e-530f-982a-baaf19c90822" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,...,7}" :db/id #edb/ref 17592186371928} {:answer/id #uuid "f554ca77-5e5f-5625-8f70-93c9739facb2" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,3,...,9}" :db/id #edb/ref 17592186371929}] :answer-field/correct {:answer/id #uuid "fe10eba8-0282-5d63-a183-5ec382a30f37" :answer/type {:db/ident :answer.type/math} :answer/value "{0,1,2,...,8}" :db/id #edb/ref 17592186371925} :answer-field/id #uuid "bfed3a66-128a-54f4-b8c7-1abc26db8316" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371924}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1f38405c-44f4-571d-87f8-1674000b10bd" :question/math-academy-id "q-1234" :question/problem "If $U={0,1,2,...,10}$ is the universal set and $X={9,1