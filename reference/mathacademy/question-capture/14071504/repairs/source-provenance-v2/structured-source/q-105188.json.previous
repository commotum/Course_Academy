      "extractor_sha256": "1591183da328a4140792793d2cc113fd535ab5f25bc7f284ceb1b6f251efad18",
      "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071504/repairs/source-provenance-v2/structured-source/source/ce5e5b963c9b898ba0264d441f696d03913a024683b89487666e7862f310132a.html",
