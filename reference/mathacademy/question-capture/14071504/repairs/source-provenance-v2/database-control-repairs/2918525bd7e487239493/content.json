    {
      "math_academy_id": "q-105188",
      "knowledge_point_id": "49251196-c06b-5718-82e6-5ed9450301af",
      "knowledge_point": "Finding the Complement of a Set Given Using Ellipsis Notation",
      "problem": "Let $U=\\{a,b,c,…,z\\}$ be the universal set and $Y=\\{a,b,c,…,j\\}$, then $\\overset{―}{Y}=$",
      "worked_solution": "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}=\\{k,l,m,…,z\\}.\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
              "value": "\\{i,j,k,…,z\\}",
              "option": "0",
