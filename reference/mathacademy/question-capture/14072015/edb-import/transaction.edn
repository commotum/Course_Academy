678b5e48f" :answer/id #uuid "cfa315e7-36aa-5fba-a0fc-8b9128a71a47" :answer/type :answer.type/math :answer/value "f:x↦x+{x}^{2}+{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-96816/selection/d58980a95d27abe14f9a6fa728f56697565f3a97da3064df6c79ab1d4d32cbf0" :answer/id #uuid "04c50caa-ba6f-58ca-9a26-dfc61ecbdf9d" :answer/type :answer.type/math :answer/value "f:{x}^{2}↦x+{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-96816/selection/78d2f7fc1d29b7a79bf82f194ed3a7d64b342fa46cf04997ac33af6cc2cb9fbd" :answer/id #uuid "07b8d031-bde1-5f8a-ac6f-3ec0c84d2208" :answer/type :answer.type/math :answer/value "f:x↦{x}^{2}+{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-96816/selection/4c1aaba66b942030d7ecebdd84191956afec1e01cbb122d39bb049744e5a92a1" :answer/id #uuid "3bed6a85-c187-5bca-b960-e9e8ed87766f" :answer/type :answer.type/math :answer/value "f:{x}^{3}↦x+{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-96816/selection" :answer-field/id #uuid "ba629e85-7029-58c1-aac1-f3d456d18841" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96816/selection/cd26fdfb800885313b92ed216af12a4a8db7dc21268c95e63648466678b5e48f" :answer-field/choices ["q-96816/selection/0a9b541acb6c1300fbc2da941404beaaffd0cd4b362c7c8456d9435ac177c3ae" "q-96816/selection/cd26fdfb800885313b92ed216af12a4a8db7dc21268c95e63648466678b5e48f" "q-96816/selection/d58980a95d27abe14f9a6fa728f56697565f3a97da3064df6c79ab1d4d32cbf0" "q-96816/selection/78d2f7fc1d29b7a79bf82f194ed3a7d64b342fa46cf04997ac33af6cc2cb9fbd" "q-96816/selection/4c1aaba66b942030d7ecebdd84191956afec1e01cbb122d39bb049744e5a92a1"] :db/ensure [:answer-field/validate]} {:db/id "q-96816" :question/id #uuid "01c86862-f4a3-58bf-8255-79f5d1f9512c" :question/math-academy-id "q-96816" :question/problem "Which of the following is equivalent to $f(x)=x+{x}^{2}+{x}^{3}?$" :question/worked-solution "The notation $f(x)=x+{x}^{2}+{x}^{3}$ means that the function $f$ maps the element $x$ in the domain to $x+{x}^{2}+{x}^{3}$ in the codomain. This can also be written as\n\n$$\nf:x↦x+{x}^{2}+{x}^{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96816/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7e61a3c8-45b0-532e-a54f-4597ad01a6f0"] :knowledge-point/questions ["q-96816"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96123"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072015/assets/dcee145044fe79dc7f4d07c3c4c1248df358cd8eda7a173cd8d4641f13404122.png)\n\nConsider the function $f:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $f$ is ${0,1,2,3}$\n- The codomain of $f$ is ${0,-1}$\n- The range of $f$ is ${0,-1}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nThe range of $f$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $f$ is $X={0,1,2,3},$\n\n- the codomain of $f$ is $Y={0,-1,-2},$\n\n- the range of $f$ is ${0,-1},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and III are true, while statement II is false.\n\nTherefore, the correct answer \"I and III only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-96830"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072015/assets/740d578e554cd61bc733079c32c063d41ab4d9dcc775d36f7080ee8e5aa5a622.png)\n\nConsider the function $f:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $f$ is ${5,10,15}$\n- The codomain of $f$ is ${5,10,12,13,14,15}$\n- The range of $f$ is ${12,13,14}$" :db/ensure [:question/validate]} {:db/id "q-96827/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "dd6ea778-d400-509a-91f4-ed171e042a86" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96827/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "7a1d4a2b-ee99-504c-8114-13305864828a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96827/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "662e0edd-56c7-549c-8379-ad9669e240c1" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-96827/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ad40abca-6846-5938-b799-0bbf03518ee9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-96827/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "47f5a603-1986-5d76-b123-8d2388728f1f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-96827/selection" :answer-field/id #uuid "aa9237ba-b760-5f3e-bb87-c1bc16efcd55" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96827/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-96827/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96827/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-96827/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-96827/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96827/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-96827" :question/id #uuid "71e2df2a-cbb7-5d26-a5cc-c8404fa61cf3" :question/math-academy-id "q-96827" :question/problem "Which of the following is the correct interpretation of $g:[0,2]\\to {0,2}?$\n\n- The domain of $g$ is ${0,2}$\n- The codomain of $g$ is ${0,2}$\n- The range of $g$ is $[0,2]$" :question/worked-solution "The notation \n\n$$\ng:[0,2]\\to {0,2}\n$$\n\nmeans that the function $g$ maps the set $[0,2]$ to the set ${0,2}.$ In this case,\n\n- the domain of $g$ is $[0,2],$ and\n\n- the codomain of $g$ is ${0,2}.$ Note that this is *not* necessarily the range.\n\nAs a result, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96827/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7"] :knowledge-point/questions ["q-96827"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96825/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "38347345-6371-5e58-ad33-8d4e6a442cde" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96825/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "4d46e7c0-5023-54bb-b211-ea0dde0aa2bb" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-96825/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "7f5dcf91-0d46-5e02-af5b-0167dd04d39a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-96825/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "abdaa1ae-6b29-5d5d-829e-d7ab82b1047b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-96825/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9691382a-fa78-5519-9685-838dcf1e17ea" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96825/selection" :answer-field/id #uuid "98418a32-a0d1-545f-b28b-dfce60f2738c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96825/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-96825/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96825/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-96825/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-96825/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-96825/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-96825" :question/id #uuid "dc81d8b4-d5eb-5faf-b386-bb3384193df0" :question/math-academy-id "q-96825" :question/problem "Which of the following is the correct interpretation of $f:[-1,1]\\to R?$\n\n- The domain of $f$ is $[-1,1]$\n- The codomain of $f$ is $[-1,1]$\n- The range of $f$ is $R$" :question/worked-solution "The notation \n\n$$\nf:[-1,1]\\to R\n$$\n\nmeans that the function $f$ maps the set $[-1,1]$ to the set $R.$ In this case,\n\n- the domain of $f$ is $[-1,1],$ and\n\n- the codomain of $f$ is $R.$ Note that this is *not* necessarily the range.\n\nAs a result, statements II and III are false, while statement I is true.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96825/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7"] :knowledge-point/questions ["q-96825"] :db/ensure [:knowledge-point/validate]}]
