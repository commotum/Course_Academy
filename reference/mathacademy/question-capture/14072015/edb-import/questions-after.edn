id #edb/ref 17592186374353 :knowledge-point/_questions [{:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "662e0edd-56c7-549c-8379-ad9669e240c1" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186374355} {:answer/id #uuid "dd6ea778-d400-509a-91f4-ed171e042a86" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186374356} {:answer/id #uuid "47f5a603-1986-5d76-b123-8d2388728f1f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374357} {:answer/id #uuid "ad40abca-6846-5938-b799-0bbf03518ee9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186374358} {:answer/id #uuid "7a1d4a2b-ee99-504c-8114-13305864828a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186374359}] :answer-field/correct {:answer/id #uuid "7a1d4a2b-ee99-504c-8114-13305864828a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186374359} :answer-field/id #uuid "aa9237ba-b760-5f3e-bb87-c1bc16efcd55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374354}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71e2df2a-cbb7-5d26-a5cc-c8404fa61cf3" :question/math-academy-id "q-96827" :question/problem "Which of the following is the correct interpretation of $g:[0,2]\\to {0,2}?$\n\n- The domain of $g$ is ${0,2}$\n- The codomain of $g$ is ${0,2}$\n- The range of $g$ is $[0,2]$" :question/worked-solution "The notation \n\n$$\ng:[0,2]\\to {0,2}\n$$\n\nmeans that the function $g$ maps the set $[0,2]$ to the set ${0,2}.$ In this case,\n\n- the domain of $g$ is $[0,2],$ and\n\n- the codomain of $g$ is ${0,2}.$ Note that this is *not* necessarily the range.\n\nAs a result, statements I and III are false, while statement II is true.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186302388 :knowledge-point/_questions [{:knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5745fd5-8156-56df-8d7d-864885bcf31e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186302390} {:answer/id #uuid "67cce654-8dbb-5904-8096-a76ec86d18f5" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186302391} {:answer/id #uuid "abc487d4-a22b-5459-92d4-8e71c11b2324" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186302392} {:answer/id #uuid "b9082e9a-b3f1-5566-b3d6-24aee8e1e532" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186302393} {:answer/id #uuid "ff77b335-132b-5e90-b3f0-b5543bf86e9e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186302394}] :answer-field/correct {:answer/id #uuid "abc487d4-a22b-5459-92d4-8e71c11b2324" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186302392} :answer-field/id #uuid "fc0440e9-4afb-5747-80b5-d169f37831ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302389}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ece4cad-7baa-5180-acf5-d91ffd5ed6b7" :question/math-academy-id "q-96830" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072015/assets/740d578e554cd61bc733079c32c063d41ab4d9dcc775d36f7080ee8e5aa5a622.png)\n\nConsider the function $f:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\n- The domain of $f$ is ${5,10,15}$\n- The codomain of $f$ is ${5,10,12,13,14,15}$\n- The range of $f$ is ${12,13,14}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nThe range of $f$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $f$ is $X={5,10,15},$\n\n- the codomain of $f$ is $Y={12,13,14},$\n\n- the range of $f$ is ${12,13},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements II and III are false, while statement I is true.\n\nTherefore, the correct answer \"I only.\""}]}
