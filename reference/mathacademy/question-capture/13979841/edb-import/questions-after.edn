int/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7d58c9f-5547-5e87-83d7-bcb22cc27d68" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186286083} {:answer/id #uuid "924e3beb-e4f9-5da9-b440-8784c81aee73" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286084}] :answer-field/correct {:answer/id #uuid "924e3beb-e4f9-5da9-b440-8784c81aee73" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286084} :answer-field/id #uuid "c5919e0e-d638-575e-98ce-1c31f200de8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286082} {:answer-field/choices [{:answer/id #uuid "7831dacb-1d20-5f63-b784-832c438faf42" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286086}] :answer-field/correct {:answer/id #uuid "7831dacb-1d20-5f63-b784-832c438faf42" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286086} :answer-field/id #uuid "85696513-245b-50a2-8892-872c198cbb94" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286085}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1a17a7c2-c2c8-5f5a-9477-a77839020510" :question/math-academy-id "q-318172" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{h},$ the velocity of the particle is $-8i\\,\\text{km/h},$ and when $t=6\\,\\text{h},$ the velocity of the particle is $(4i-18j)\\,\\text{km/h}.$ Calculate the acceleration of the particle.\n\n$a=($\n{{field-1}}$\\,i$\n$-$\n{{field-2}}$\\,j\\,)\\,{\\text{km/h}}^{2}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-8i,\\,v=4i-18j,\\,t=6,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 4i-18j & =-8i+a(6) \\\\ 12i-18j & =6a \\\\ a & =\\frac{1}{6}(12i-18j) \\\\  & =(2\\,i-3\\,j)\\,{\\text{km/h}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286087 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76535a56-6401-5ad8-93ed-9d203580d65f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286089}] :answer-field/correct {:answer/id #uuid "76535a56-6401-5ad8-93ed-9d203580d65f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286089} :answer-field/id #uuid "6c030dff-f8db-5f94-9330-67fb65652da0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286088} {:answer-field/choices [{:answer/id #uuid "5e701220-783a-5611-a3e8-9f10dcaa332c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286091}] :answer-field/correct {:answer/id #uuid "5e701220-783a-5611-a3e8-9f10dcaa332c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286091} :answer-field/id #uuid "46a2f013-7965-54ff-80cc-0660085bea20" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ce4362b-48cf-5213-922d-66954e5bf19f" :question/math-academy-id "q-318173" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{h},$ the velocity of the particle is $(3i-8j)\\,\\text{km/h},$ and when $t=4\\,\\text{h},$ the velocity of the particle is $(15i+8j)\\,\\text{km/h}.$ Calculate the acceleration of the particle.\n\n$a=($\n{{field-1}}$\\,i$\n$+$\n{{field-2}}$\\,j\\,)\\,{\\text{km/h}}^{2}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=3i-8j,\\,v=15i+8j,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 15i+8j & =(3i-8j)+a(4) \\\\ 12i+16j & =4a \\\\ a & =\\frac{1}{4}(12i+16j) \\\\  & =(3\\,i+4\\,j)\\,{\\text{km/h}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286092 :knowledge-point/_questions [{:knowledge-point/id #uuid "0118bf72-c730-59f1-b722-85ed779f96c7" :knowledge-point/title "Calculating the Speed of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6ef9b5c-3049-57a5-bd2b-1c128bf0eeb4" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186286094}] :answer-field/correct {:answer/id #uuid "b6ef9b5c-3049-57a5-bd2b-1c128bf0eeb4" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186286094} :answer-field/id #uuid "a6bbad6a-aebf-560b-b188-17d0b61aa187" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286093}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "14bcbffc-5502-5fa8-9ef9-3cc15ca2f5ea" :question/math-academy-id "q-318182" :question/problem "A particle moves with a constant velocity of $u=-20i\\,\\text{ft/s}.$ Find the speed of the particle.\n\n$|u|=$\n{{field-1}}$\\,\\text{ft/s}$" :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|-20i| \\\\  & =|-20| \\\\  & =20\\end{aligned}\n$$\n\nfeet per second."}] [{:db/id #edb/ref 17592186286095 :knowledge-point/_questions [{:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6ca288b-5160-5a26-b5e9-9665e6d1f494" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286097} {:answer/id #uuid "78c0c60e-f0c8-50a9-bb8d-3d5ecbaa9ded" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186286098}] :answer-field/correct {:answer/id #uuid "f6ca288b-5160-5a26-b5e9-9665e6d1f494" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286097} :answer-field/id #uuid "983664d1-9e36-5f55-a115-a1521d043f3b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286096}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1bac0310-73e1-5fea-b5fd-9b69fa26b99c" :question/math-academy-id "q-318188" :question/problem "A particle moves with a constant acceleration of $(-2i+j)\\,{\\text{km/h}}^{2}.$ The velocity of the particle is $(6i-8j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ Find the time when the velocity of the particle equals $(-8i-j)\\,\\text{km/h}.$\n\n$t=$\n{{field-1}}$\\,\\text{h}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=6i-8j,\\,v=-8i-j,\\,a=-2i+j,\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -8i-j & =(6i-8j)+(-2i+j)t \\\\ -14i+7j & =(-2i+j)t \\\\ -14i+7j & =-2ti+tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}-14=-2t \\\\ 7=t\\end{aligned}\\,⟹\\,t=7\\,\\text{h}.\n$$"}] [{:db/id #edb/ref 17592186286099 :knowledge-point/_questions [{:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee23a1e-4f36-597b-8041-8543a1b486d6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186286101}] :answer-field/correct {:answer/id #uuid "eee23a1e-4f36-597b-8041-8543a1b486d6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186286101} :answer-field/id #uuid "b8f67d76-96bc-5a74-b9d4-885bf0ba243e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286100}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0269d6a7-d0f6-5d8f-b0af-4ecc5ef0533c" :question/math-academy-id "q-319168" :question/problem "A particle moves with a constant acceleration of $(2i+3j)\\,{\\text{ft/s}}^{2}.$ The velocity of the particle is $(-6i-5j)\\,\\text{ft/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(10i+19j)\\,\\text{ft/s}.$\n\n$t=$\n{{field-1}}$\\,\\text{s}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-6i-5j,\\,v=10i+19j,\\,a=2i+3j,\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 10i+19j & =-6i-5j+(2i+3j)t \\\\ 16i+24j & =(2i+3j)t \\\\ 16i+24j & =2ti+3tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}16=2t \\\\ 24=3t\\end{aligned}\\,⟹\\,t=8\\,\\text{s}.\n$$"}]}
