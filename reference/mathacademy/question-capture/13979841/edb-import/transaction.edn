-18j,\\,t=6,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 4i-18j & =-8i+a(6) \\\\ 12i-18j & =6a \\\\ a & =\\frac{1}{6}(12i-18j) \\\\  & =(2\\,i-3\\,j)\\,{\\text{km/h}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318172/field-1" "q-318172/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7"] :knowledge-point/questions ["q-318172"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136365/selection/0568b9018772a931f81eb99e31f7ab49fcfaf456f087a3d6a504775f4da103e9" :answer/id #uuid "e25feade-2661-524f-ac24-30e9dbde89dc" :answer/type :answer.type/math :answer/value "(2i+3j)\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-136365/selection/5eb17b4c725c12b7b30792004ca0771013d552e18d14aef5abf2339a8d9f0897" :answer/id #uuid "95cbb249-cfe6-5beb-9445-b74c3ebafa39" :answer/type :answer.type/math :answer/value "(i+3j)\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-136365/selection/18c9a0bbf66ddc372c1cca868a14eecaa59ebd09a032e0bc2024788810c7b98e" :answer/id #uuid "b55538a5-958e-5cb9-95b1-dc04b61fba5b" :answer/type :answer.type/math :answer/value "-3j\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-136365/selection/f60249b2841fb4b3fa0bf43443be132830a000f74a3d67b894cc5a52f59359df" :answer/id #uuid "fa05ba84-cb8e-5fef-b61b-b817a9b3aa6e" :answer/type :answer.type/math :answer/value "(-3i+j)\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-136365/selection/a40d062793a049ebd63e46b1fdd6a352480383c5c1c472fdc18e854b541b7638" :answer/id #uuid "a67db531-45c1-5334-97dd-f6b889f4a2c1" :answer/type :answer.type/math :answer/value "6i\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-136365/selection" :answer-field/id #uuid "f3ac62b9-a8cd-50dd-b41f-5b469fc02c26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136365/selection/5eb17b4c725c12b7b30792004ca0771013d552e18d14aef5abf2339a8d9f0897" :answer-field/choices ["q-136365/selection/0568b9018772a931f81eb99e31f7ab49fcfaf456f087a3d6a504775f4da103e9" "q-136365/selection/5eb17b4c725c12b7b30792004ca0771013d552e18d14aef5abf2339a8d9f0897" "q-136365/selection/18c9a0bbf66ddc372c1cca868a14eecaa59ebd09a032e0bc2024788810c7b98e" "q-136365/selection/f60249b2841fb4b3fa0bf43443be132830a000f74a3d67b894cc5a52f59359df" "q-136365/selection/a40d062793a049ebd63e46b1fdd6a352480383c5c1c472fdc18e854b541b7638"] :db/ensure [:answer-field/validate]} {:db/id "q-136365" :question/id #uuid "3a260087-aef9-52a3-8b76-b4f416b4f142" :question/math-academy-id "q-136365" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(i-6j)\\,\\text{m/s},$ and when $t=3\\,\\text{s},$ the velocity of the particle is $(4i+3j)\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=i-6j,\\,v=4i+3j,\\,t=3,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 4i+3j & =(i-6j)+a(3) \\\\ 3i+9j & =3a \\\\ a & =\\frac{1}{3}(3i+9j) \\\\  & =(i+3j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7"] :knowledge-point/questions ["q-136365"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-136289"] :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-317176/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "480753c5-0d0d-51c0-ba24-0967d975d9d5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317176/field-1" :answer-field/id #uuid "41a53f06-9530-5e4c-932f-df8d83e29d25" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317176/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317176/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317176/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a5dc76c5-7c08-524e-ac92-045277e888c5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-317176/field-2" :answer-field/id #uuid "f43ecdae-9c55-5ad1-888d-320d8787776c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317176/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-317176/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-317176" :question/id #uuid "c160132d-20d0-59f1-aea1-6e3f6c75bcba" :question/math-academy-id "q-317176" :question/problem "A particle moves with constant acceleration. The velocity of the particle equals $(-4i+9j)\\,\\text{ft/s}$ both when $t=0\\,\\text{s}$ and $t=7\\,\\text{s}.$ What is the acceleration of the particle?\n\n$a=($\n{{field-1}}$\\,i$\n$+$\n{{field-2}}$\\,j\\,)\\,{\\text{ft/s}}^{2}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-4i+9j,\\,v=-4i+9j,\\,t=7\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -4i+9j & =(-4i+9j)+a(7) \\\\ 0 & =7a \\\\ a & =(0\\,i+0\\,j)\\,{\\text{ft/s}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317176/field-1" "q-317176/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7"] :knowledge-point/questions ["q-317176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319168/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "eee23a1e-4f36-597b-8041-8543a1b486d6" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-319168/field-1" :answer-field/id #uuid "b8f67d76-96bc-5a74-b9d4-885bf0ba243e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319168/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-319168/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-319168" :question/id #uuid "0269d6a7-d0f6-5d8f-b0af-4ecc5ef0533c" :question/math-academy-id "q-319168" :question/problem "A particle moves with a constant acceleration of $(2i+3j)\\,{\\text{ft/s}}^{2}.$ The velocity of the particle is $(-6i-5j)\\,\\text{ft/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(10i+19j)\\,\\text{ft/s}.$\n\n$t=$\n{{field-1}}$\\,\\text{s}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-6i-5j,\\,v=10i+19j,\\,a=2i+3j,\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 10i+19j & =-6i-5j+(2i+3j)t \\\\ 16i+24j & =(2i+3j)t \\\\ 16i+24j & =2ti+3tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}16=2t \\\\ 24=3t\\end{aligned}\\,⟹\\,t=8\\,\\text{s}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319168/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5"] :knowledge-point/questions ["q-319168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318188/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "f6ca288b-5160-5a26-b5e9-9665e6d1f494" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-318188/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "78c0c60e-f0c8-50a9-bb8d-3d5ecbaa9ded" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-318188/field-1" :answer-field/id #uuid "983664d1-9e36-5f55-a115-a1521d043f3b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318188/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-318188/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-318188/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-318188" :question/id #uuid "1bac0310-73e1-5fea-b5fd-9b69fa26b99c" :question/math-academy-id "q-318188" :question/problem "A particle moves with a constant acceleration of $(-2i+j)\\,{\\text{km/h}}^{2}.$ The velocity of the particle is $(6i-8j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ Find the time when the velocity of the particle equals $(-8i-j)\\,\\text{km/h}.$\n\n$t=$\n{{field-1}}$\\,\\text{h}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=6i-8j,\\,v=-8i-j,\\,a=-2i+j,\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -8i-j & =(6i-8j)+(-2i+j)t \\\\ -14i+7j & =(-2i+j)t \\\\ -14i+7j & =-2ti+tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}-14=-2t \\\\ 7=t\\end{aligned}\\,⟹\\,t=7\\,\\text{h}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318188/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5"] :knowledge-point/questions ["q-318188"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136407/selection/ba771dd41a37fcd1cabd147925488b8d4a7729bdbd79040a1a290ed8e3379a45" :answer/id #uuid "8fcb2589-33cd-5a36-af75-219ed665fb41" :answer/type :answer.type/math :answer/value "t=5\\,\\text{s}" :db/ensure [:answer/validate]} {:db/id "q-136407/selection/d5def0cf746ec332768f9da3bbd3918000db01e741698aca0cf711527ac7cb72" :answer/id #uuid "7037984d-72d7-5b3c-b6f1-d6f745d389bf" :answer/type :answer.type/math :answer/value "t=2\\,\\text{s}" :db/ensure [:answer/validate]} {:db/id "q-136407/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "d76df32d-5e0d-5b6d-b68a-700bb3ac68e3" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-136407/selection/0ef8964ec0a97853c9de78640006c9267484858b6037a9251f0953a6b60d7cbd" :answer/id #uuid "2d27c544-66e5-543e-b587-bf4cf42e2ebc" :answer/type :answer.type/math :answer/value "t=3\\,\\text{s}" :db/ensure [:answer/validate]} {:db/id "q-136407/selection/59669f0e160d1b7287db5f906150a03c8439dd8a048442ac0161f40ab8883616" :answer/id #uuid "677740a7-2bce-58e7-932d-82c5794e7e76" :answer/type :answer.type/math :answer/value "t=1\\,\\text{s}" :db/ensure [:answer/validate]} {:db/id "q-136407/selection" :answer-field/id #uuid "08a68bf3-f888-5eea-b6bf-d5a97bd6d5e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136407/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer-field/choices ["q-136407/selection/ba771dd41a37fcd1cabd147925488b8d4a7729bdbd79040a1a290ed8e3379a45" "q-136407/selection/d5def0cf746ec332768f9da3bbd3918000db01e741698aca0cf711527ac7cb72" "q-136407/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" "q-136407/selection/0ef8964ec0a97853c9de78640006c9267484858b6037a9251f0953a6b60d7cbd" "q-136407/selection/59669f0e160d1b7287db5f906150a03c8439dd8a048442ac0161f40ab8883616"] :db/ensure [:answer-field/validate]} {:db/id "q-136407" :question/id #uuid "8c92bf72-1a37-50b1-9e0c-abea59db65f8" :question/math-academy-id "q-136407" :question/problem "A particle moves with a constant acceleration of $(-i+7j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(2i-5j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(3i+2j)\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=-i+7j,\\,u=2i-5j,\\,v=3i+2j\n$$\n\ninto the equation above, we can attempt to solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 3i+2j & =(2i-5j)+(-i+7j)t \\\\ i+7j & =(-i+7j)t \\\\ i+7j & =-ti+7tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}1=-t \\\\ 7=7t\\end{aligned}\n$$\n\nwhich has no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-136407/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5"] :knowledge-point/questions ["q-136407"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-136291"] :question/problem "A particle moves with a constant acceleration of $(3i+2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(-7i-6j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $2i\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}9=3t \\\\ 6=2t\\end{aligned}\\,⟹\\,t=3\\,\\text{s}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-136293"] :question/problem "A particle moves with a constant acceleration of $(i-2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(2i-5j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(3i-j)\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=i-2j,\\,u=2i-5j,\\,v=3i-j\n$$\n\ninto the equation above, we can attempt to solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 3i-j & =(2i-5j)+(i-2j)t \\\\ i+4j & =(i-2j)t \\\\ i+4j & =ti-2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}1=t \\\\ 4=-2t\\end{aligned}\n$$\n\nwhich has no solution." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9816"] :question/problem "A particle moves with a constant velocity of $\\mathbf{u}=(5\\mathbf{i} +2\\mathbf{j}) \\,\\textrm{km/h}.$ Find the speed of the particle." :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|5i+2j| \\\\  & =\\sqrt{{5}^{2}+{2}^{2}} \\\\  & =\\sqrt{25+4} \\\\  & =\\sqrt{29}\\end{aligned}\n$$\n\nkilometers per hour." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9818"] :question/problem "The velocity of a particle is $(\\mathbf{i} -4\\mathbf{j}) \\, \\textrm{m/s}$ when $t=0\\,\\textrm{s}.$ If the particle moves with a constant acceleration of $(2\\mathbf{i}+\\mathbf{j}) \\, \\textrm{m/s}^2,$ find the velocity of the particle when $t=5 \\, \\textrm{s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\n\\mathbf{v} = \\mathbf{u} + \\mathbf{a}t,\n$$\n\nwhere $\\mathbf{u}$ is the initial velocity, and $\\mathbf{a}$ is the acceleration of the particle.\n\nHere, we have\n\n$$\n\\mathbf u = \\mathbf{i} -4\\mathbf{j}, \\qquad \\mathbf a = 2\\mathbf{i}+\\mathbf{j} .\n$$\n\nTherefore, after $t = 5 \\, \\textrm{s},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(i-4j)+(2i+j)(5) \\\\  & =(i-4j)+(10i+5j) \\\\  & =(11i+j)\\,\\text{m/s}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9817"] :question/problem "A particle moves with constant acceleration. When $t=0 \\, \\textrm{h},$ the velocity of the particle is $4\\mathbf{i}  \\, \\textrm{km/h},$ and when $t=3\\, \\textrm{h},$ the velocity of the particle is $(7\\mathbf{i}+15\\mathbf{j})  \\, \\textrm{km/h}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\n\\mathbf{v} = \\mathbf{u} + \\mathbf{a}t,\n$$\n\nwhere $\\mathbf{u}$ is the initial velocity, and $\\mathbf{a}$ is the acceleration of the particle.\n\nSubstituting \n\n$$\n\\mathbf{u} = 4\\mathbf{i}, \\qquad\n\\mathbf{v} = 7\\mathbf{i}+15\\mathbf{j}, \\qquad\nt =3\n$$\n\ninto the equation above, we can solve for $\\mathbf{a}$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 7i+15j & =4i+a(3) \\\\ 3i+15j & =3a \\\\ a & =\\frac{1}{3}(3i+15j) \\\\ a & =(i+5j)\\,{\\text{km/h}}^{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9819"] :question/problem "A particle moves with a constant acceleration of $(\\mathbf{i} + 2\\mathbf{j}) \\, \\textrm{km/h}^2.$ The velocity of the particle is $(-\\mathbf{i} - \\mathbf{j}) \\, \\textrm{km/h}$ when $t=0\\,\\textrm{h}.$ Find the time when the velocity of the particle equals $(3\\mathbf{i}+7\\mathbf{j})  \\, \\textrm{km/h}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\n\\mathbf{v} = \\mathbf{u} + \\mathbf{a}t,\n$$\n\nwhere $\\mathbf{u}$ is the initial velocity, and $\\mathbf{a}$ is the acceleration of the particle.\n\nSubstituting \n\n$$\n\\mathbf{a} = \\mathbf{i} + 2\\mathbf{j}, \\qquad\n\\mathbf{u} = -\\mathbf{i} -\\mathbf{j}, \\qquad\n\\mathbf{v} = 3\\mathbf{i}+7\\mathbf{j}\n$$\n\ninto the equation above, we can solve for $t$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 3i+7j & =(-i-j)+(i+2j)t \\\\ 4i+8j & =(i+2j)t \\\\ 4i+8j & =ti+2tj\\end{aligned}\n$$\n\nEquating the $\\mathbf i$ and $\\mathbf j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}4=t \\\\ 8=2t\\end{aligned}\n$$" :db/ensure [:question/validate]}]
