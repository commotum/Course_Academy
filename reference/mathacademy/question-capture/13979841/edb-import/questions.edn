equals $2im/s$."}] [{:db/id #edb/ref 17592186129417 :knowledge-point/_questions [{:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea74266-5bac-53cd-b03b-84bdff94703d" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186126309} {:answer/id #uuid "ea5b82cb-f095-59bb-a0b0-67a7f9b378c3" :answer/type {:db/ident :answer.type/math} :answer/value "t = 1s" :db/id #edb/ref 17592186126310} {:answer/id #uuid "2ac0543b-c37c-567f-b5e7-61503aea764b" :answer/type {:db/ident :answer.type/math} :answer/value "t = 3s" :db/id #edb/ref 17592186126311} {:answer/id #uuid "3bd52aef-a51f-551c-bf22-1e49ca7e6e66" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2s" :db/id #edb/ref 17592186126312} {:answer/id #uuid "43a4a3fa-a111-56e5-a3f3-1e0c2ee7489b" :answer/type {:db/ident :answer.type/math} :answer/value "t = 4s" :db/id #edb/ref 17592186126313}] :answer-field/correct {:answer/id #uuid "9ea74266-5bac-53cd-b03b-84bdff94703d" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186126309} :answer-field/id #uuid "5a952c76-2582-54e4-bf1a-64099c8e9ac8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126308}] :question/id #uuid "cf5bf00a-e492-5d4d-9f8a-0af5a0102f4d" :question/math-academy-id "q-136293" :question/problem "A particle moves with a constant acceleration of $(i - 2j)m/s^{2}$. The velocity of the particle is $(2i - 5j)m/s$ when $t = 0s$. Find the time when the velocity of the particle equals $(3i - j)m/s$."}]}
