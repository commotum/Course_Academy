#{[{:db/id #edb/ref 17592186283547 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f2a2ff-032e-55cf-994e-158f00cc4675" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}^{2}-28y-98" :db/id #edb/ref 17592186283549} {:answer/id #uuid "8dc24f79-3457-5d26-b64c-1bd059e1b603" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-14y+49" :db/id #edb/ref 17592186283550} {:answer/id #uuid "12bc52a2-ac07-5871-a65a-ad8ed51c6451" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}^{2}+21y-7" :db/id #edb/ref 17592186283551} {:answer/id #uuid "c3104e83-aae6-5312-af9a-2d023fa95c81" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}^{2}+21y+7" :db/id #edb/ref 17592186283552} {:answer/id #uuid "83cdde23-a9ec-513f-a326-849c6e4118a2" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}^{2}+28y-98" :db/id #edb/ref 17592186283553}] :answer-field/correct {:answer/id #uuid "83cdde23-a9ec-513f-a326-849c6e4118a2" :answer/type {:db/ident :answer.type/math} :answer/value "-2{y}^{2}+28y-98" :db/id #edb/ref 17592186283553} :answer-field/id #uuid "6949e69a-ddb4-5e89-81d6-0e1361085be3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283548}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "251a0d15-d400-5863-a45e-48418b31fbf9" :question/math-academy-id "q-107519" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=7,$ and the coefficient of the quadratic term is $a=-2.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=7,$ and the coefficient of the quadratic term is $a=-2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =(-2){(y-7)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(-2){(y-7)}^{2} & =(-2)({y}^{2}-14y+49) \\\\  & =-2{y}^{2}+28y-98.\\end{aligned}\n$$\n\nTherefore, $P(y)=-2{y}^{2}+28y-98.$"}] [{:db/id #edb/ref 17592186283554 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d13abf36-6279-5f10-9364-c9263073b372" :answer/type {:db/ident :answer.type/math} :answer/value "(y-(2+3\\text{i}))(y-(2-3\\text{i}))" :db/id #edb/ref 17592186283556} {:answer/id #uuid "6e55e4c0-4cb2-5c6d-af8b-15ba49b941bd" :answer/type {:db/ident :answer.type/math} :answer/value "2(y-(2+3\\text{i}))(y-(2-3\\text{i}))" :db/id #edb/ref 17592186283557} {:answer/id #uuid "6392ad34-87de-5037-8eff-f93cd57e2275" :answer/type {:db/ident :answer.type/math} :answer/value "2(y-(1+3\\text{i}))(y-(1-3\\text{i}))" :db/id #edb/ref 17592186283558} {:answer/id #uuid "f359569e-3de1-51a8-8beb-732c0fd896d7" :answer/type {:db/ident :answer.type/math} :answer/value "(y-(1+3\\text{i}))(y-(1-3\\text{i}))" :db/id #edb/ref 17592186283559} {:answer/id #uuid "624a5063-a5dd-557f-86f8-b0904b2d9bbf" :answer/type {:db/ident :answer.type/math} :answer/value "2(y-(2+\\text{i}))(y-(2-\\text{i}))" :db/id #edb/ref 17592186283560}] :answer-field/correct {:answer/id #uuid "6e55e4c0-4cb2-5c6d-af8b-15ba49b941bd" :answer/type {:db/ident :answer.type/math} :answer/value "2(y-(2+3\\text{i}))(y-(2-3\\text{i}))" :db/id #edb/ref 17592186283557} :answer-field/id #uuid "3f9a4def-79fc-56b9-a709-e1e9a9793b19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283555}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "34184e66-1d20-589f-98d3-e6700006273c" :question/math-academy-id "q-46452" :question/problem "Factor $2{y}^{2}-8y+26.$" :question/worked-solution "First, we let $f(y)=2{y}^{2}-8y+26.$\n\nNext, we solve $f(y)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ 2{y}^{2}-8y+26 & =0 \\\\ {y}^{2}-4y+13 & =0 \\\\ ({y}^{2}-2\\cdot 2\\cdot y+{2}^{2})-{2}^{2}+13 & =0 \\\\ (y-2)^{2}-4+13 & =0 \\\\ (y-2)^{2}+9 & =0 \\\\ (y-2)^{2} & =-9 \\\\ (y-2)^{2} & =9{\\text{i}}^{2} \\\\ (y-2)^{2} & ={(3\\text{i})}^{2} \\\\ y-2 & =\\pm 3\\text{i} \\\\ y & =2\\pm 3\\text{i}\\end{aligned}\n$$\n\nNow, since our quadratic equation has roots ${y}_{1}=2+3\\text{i}$ and ${y}_{2}=2-3\\text{i},$ and the coefficient of the quadratic term is $a=2,$ the expression $2{y}^{2}-8y+26$ can be written as\n\n$$\n\\begin{aligned}2{y}^{2}-8y+26 & =a(y-{y}_{1})(y-{y}_{2}) \\\\  & =2(y-(2+3\\text{i}))(y-(2-3\\text{i})).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283561 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ad7dde-8db0-5afb-9f99-61bb479a2dd9" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+27" :db/id #edb/ref 17592186283563} {:answer/id #uuid "afaee32b-8ff0-53f1-9262-24b38997e006" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-18y-27" :db/id #edb/ref 17592186283564} {:answer/id #uuid "42632239-8018-56ee-907e-78d2d1fe1b1f" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-9y-27" :db/id #edb/ref 17592186283565} {:answer/id #uuid "1c4fb670-5118-5c11-9a3b-73af922ef8ac" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186283566} {:answer/id #uuid "6ade4beb-68f9-5374-9c02-810b957b08db" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-9y+27" :db/id #edb/ref 17592186283567}] :answer-field/correct {:answer/id #uuid "1c4fb670-5118-5c11-9a3b-73af922ef8ac" :answer/type {:db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186283566} :answer-field/id #uuid "f74d1c05-d8a9-5a2d-811c-febb1ad6cb72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283562}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "18d53b8b-4f6d-534c-9744-bb5236603b18" :question/math-academy-id "q-46588" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =3{(y-3)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3{(y-3)}^{2} & =3({y}^{2}-6y+9) \\\\  & =3{y}^{2}-18y+27.\\end{aligned}\n$$\n\nTherefore, $P(y)=3{y}^{2}-18y+27.$"}] [{:db/id #edb/ref 17592186283568 :knowledge-point/_questions [{:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72740904-b7e4-5235-90bf-c1349124d852" :answer/type {:db/ident :answer.type/math} :answer/value "u-(1-4\\text{i})" :db/id #edb/ref 17592186283570} {:answer/id #uuid "67fd16aa-0801-532e-9f9b-427d3210306f" :answer/type {:db/ident :answer.type/math} :answer/value "u-(-2-6\\text{i})" :db/id #edb/ref 17592186283571} {:answer/id #uuid "abd4deea-095a-571d-bbfb-d90fc18b28db" :answer/type {:db/ident :answer.type/math} :answer/value "u-(3-4\\text{i})" :db/id #edb/ref 17592186283572} {:answer/id #uuid "a942ade8-acc0-5f2b-90b3-eaa7ea4a90ea" :answer/type {:db/ident :answer.type/math} :answer/value "u-(2-6\\text{i})" :db/id #edb/ref 17592186283573} {:answer/id #uuid "973f6954-dc4a-53c5-a4bc-6059846cd542" :answer/type {:db/ident :answer.type/math} :answer/value "u+(1+4\\text{i})" :db/id #edb/ref 17592186283574}] :answer-field/correct {:answer/id #uuid "a942ade8-acc0-5f2b-90b3-eaa7ea4a90ea" :answer/type {:db/ident :answer.type/math} :answer/value "u-(2-6\\text{i})" :db/id #edb/ref 17592186283573} :answer-field/id #uuid "a678b094-63b7-53be-b9fb-b9d46527f020" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283569}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cc2e6627-c76f-5b42-ba0e-7e3f345cefbd" :question/math-academy-id "q-46657" :question/problem "Which of the following is a factor of ${u}^{2}-4u+40?$" :question/worked-solution "First, we let $f(u)={u}^{2}-4u+40.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-4u+40 & =0 \\\\ ({u}^{2}-2\\cdot 2\\cdot u+{2}^{2})-{2}^{2}+40 & =0 \\\\ (u-2)^{2}-4+40 & =0 \\\\ (u-2)^{2}+36 & =0 \\\\ (u-2)^{2} & =-36 \\\\ (u-2)^{2} & =36{\\text{i}}^{2} \\\\ (u-2)^{2} & =(6\\text{i})^{2} \\\\ u-2 & =\\pm 6\\text{i} \\\\ u & =2\\pm 6\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=2+6\\text{i}$ and ${u}_{2}=2-6\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-4u+40$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-4u+40 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(2+6\\text{i}))(u-(2-6\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(2-6\\text{i})$ is a factor of ${u}^{2}-4u+40.$"}] [{:db/id #edb/ref 17592186283575 :knowledge-point/_questions [{:knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a76d1eff-832f-53c0-81ab-a3e5dca329ba" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186283577} {:answer/id #uuid "d79ae51b-9fe9-5cb3-95f4-378d4d53ae83" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}+6v+25" :db/id #edb/ref 17592186283578} {:answer/id #uuid "f8c0854c-a5a8-580e-81bc-97ad7d63f4f8" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}+8v-14" :db/id #edb/ref 17592186283579} {:answer/id #uuid "d1ee7c4f-3b87-5e0f-849a-cb3c81cad90c" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}-16v-14" :db/id #edb/ref 17592186283580} {:answer/id #uuid "26610e12-cd17-547f-9746-fad3c30a669b" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}-6v+50" :db/id #edb/ref 17592186283581}] :answer-field/correct {:answer/id #uuid "a76d1eff-832f-53c0-81ab-a3e5dca329ba" :answer/type {:db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186283577} :answer-field/id #uuid "3f4390f7-86ba-51b5-a3a1-72b7af3f8784" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283576}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b39aa3d6-40fa-5b31-9981-0e48c9722e25" :question/math-academy-id "q-46669" :question/problem "The quadratic polynomial $f(v)$ has real coefficients, has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $2.$ Find $f(v).$" :question/worked-solution "Since our quadratic polynomial has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(v-{v}_{1})(v-{v}_{2}) & =2(v-(3+4\\text{i}))(v-(3-4\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(v-(3+4\\text{i}))(v-(3-4\\text{i})) & =2({v}^{2}-(3+4\\text{i})v-(3-4\\text{i})v+(3+4\\text{i})(3-4\\text{i})) \\\\  & =2({v}^{2}-(3+4\\text{i}+3-4\\text{i})v+({3}^{2}-{4}^{2}{\\text{i}}^{2})) \\\\  & =2({v}^{2}-6v+(9+16)) \\\\  & =2{v}^{2}-12v+50.\\end{aligned}\n$$\n\nTherefore, $f(v)=2{v}^{2}-12v+50.$"}]}
