}^{2}-18y+27.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-46588/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba"] :knowledge-point/questions ["q-46588"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46657/selection/06fe9e2072073143bc5596a335a9cc8fe373f3f314e48ac739a8bc3f2143a95d" :answer/id #uuid "72740904-b7e4-5235-90bf-c1349124d852" :answer/type :answer.type/math :answer/value "u-(1-4\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46657/selection/90b885657b34d05d3db3583150d1a66dfbd4412dbe292e97d9d4d3f15ea71e35" :answer/id #uuid "abd4deea-095a-571d-bbfb-d90fc18b28db" :answer/type :answer.type/math :answer/value "u-(3-4\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46657/selection/9a72383176185bd81f824c5c1b490e56275d5f02b4e961805caf29811fdf52ff" :answer/id #uuid "a942ade8-acc0-5f2b-90b3-eaa7ea4a90ea" :answer/type :answer.type/math :answer/value "u-(2-6\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46657/selection/a1ed2ada3765907325c93da22dd0f5e8c653242f4eda4ec2679081cb2468b180" :answer/id #uuid "973f6954-dc4a-53c5-a4bc-6059846cd542" :answer/type :answer.type/math :answer/value "u+(1+4\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46657/selection/1d2ef0c1985f18238707312e11151c7475fe5c5a43c9816f047f7131495c7d5b" :answer/id #uuid "67fd16aa-0801-532e-9f9b-427d3210306f" :answer/type :answer.type/math :answer/value "u-(-2-6\\text{i})" :db/ensure [:answer/validate]} {:db/id "q-46657/selection" :answer-field/id #uuid "a678b094-63b7-53be-b9fb-b9d46527f020" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-46657/selection/9a72383176185bd81f824c5c1b490e56275d5f02b4e961805caf29811fdf52ff" :answer-field/choices ["q-46657/selection/06fe9e2072073143bc5596a335a9cc8fe373f3f314e48ac739a8bc3f2143a95d" "q-46657/selection/90b885657b34d05d3db3583150d1a66dfbd4412dbe292e97d9d4d3f15ea71e35" "q-46657/selection/9a72383176185bd81f824c5c1b490e56275d5f02b4e961805caf29811fdf52ff" "q-46657/selection/a1ed2ada3765907325c93da22dd0f5e8c653242f4eda4ec2679081cb2468b180" "q-46657/selection/1d2ef0c1985f18238707312e11151c7475fe5c5a43c9816f047f7131495c7d5b"] :db/ensure [:answer-field/validate]} {:db/id "q-46657" :question/id #uuid "cc2e6627-c76f-5b42-ba0e-7e3f345cefbd" :question/math-academy-id "q-46657" :question/problem "Which of the following is a factor of ${u}^{2}-4u+40?$" :question/worked-solution "First, we let $f(u)={u}^{2}-4u+40.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-4u+40 & =0 \\\\ ({u}^{2}-2\\cdot 2\\cdot u+{2}^{2})-{2}^{2}+40 & =0 \\\\ (u-2)^{2}-4+40 & =0 \\\\ (u-2)^{2}+36 & =0 \\\\ (u-2)^{2} & =-36 \\\\ (u-2)^{2} & =36{\\text{i}}^{2} \\\\ (u-2)^{2} & =(6\\text{i})^{2} \\\\ u-2 & =\\pm 6\\text{i} \\\\ u & =2\\pm 6\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=2+6\\text{i}$ and ${u}_{2}=2-6\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-4u+40$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-4u+40 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(2+6\\text{i}))(u-(2-6\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(2-6\\text{i})$ is a factor of ${u}^{2}-4u+40.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-46657/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be"] :knowledge-point/questions ["q-46657"] :db/ensure [:knowledge-point/validate]} {:db/id "q-46669/selection/b25f5514e3ec30049d4898cf3a71ff43d3cef5c11ce0ea7fb3b8d5e83d50ab63" :answer/id #uuid "d1ee7c4f-3b87-5e0f-849a-cb3c81cad90c" :answer/type :answer.type/math :answer/value "2{v}^{2}-16v-14" :db/ensure [:answer/validate]} {:db/id "q-46669/selection/3918c3f104a2477d5e38a93e010049cd568ee1fd5727102b96425453b00f5a37" :answer/id #uuid "d79ae51b-9fe9-5cb3-95f4-37