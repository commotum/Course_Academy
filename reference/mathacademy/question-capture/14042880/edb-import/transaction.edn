[{:db/id "q-78965/selection/bdd74abb517f9a54070309e3c0cc9451f4c659ea6063e48b0595700dff5171c0" :answer/id #uuid "f2625f94-892c-587f-a10b-8e53903abb87" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-78965/selection/f8806da2eb03b6b8dc45a86bdc9464b9236ae930fc58a844fcee05bec40d9ca1" :answer/id #uuid "bb0ddfc0-301b-567a-bc99-ceeeef0d223f" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(2x)-1}{x\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-78965/selection/b696c7d253a518b047d10de9eb2236e33f3cb4c6d684c5f383bffdbbfda8dcff" :answer/id #uuid "8b5c387e-ca59-526a-a6bd-5f717de0f97e" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{x\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-78965/selection/20ee2095ba0909f6e3d1dc4dd61632e05f26cde1757c58f428c48f025331fb7e" :answer/id #uuid "70c568a5-a3e4-5e3c-8389-21b2fda1d663" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(2x)+1}{{x}^{2}\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-78965/selection/a90bf83e83f43b1ce6178086e991bb5a538e9e6d8e02092272c9df109acdd138" :answer/id #uuid "1c99aafa-224f-5d81-9236-71a11ae98eb8" :answer/type :answer.type/math :answer/value "\\frac{1-\\operatorname{ln}⁡(2x)}{x\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-78965/selection" :answer-field/id #uuid "4fd5921f-d948-5b6b-8545-0d3414bc7aee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78965/selection/b696c7d253a518b047d10de9eb2236e33f3cb4c6d684c5f383bffdbbfda8dcff" :answer-field/choices ["q-78965/selection/bdd74abb517f9a54070309e3c0cc9451f4c659ea6063e48b0595700dff5171c0" "q-78965/selection/f8806da2eb03b6b8dc45a86bdc9464b9236ae930fc58a844fcee05bec40d9ca1" "q-78965/selection/b696c7d253a518b047d10de9eb2236e33f3cb4c6d684c5f383bffdbbfda8dcff" "q-78965/selection/20ee2095ba0909f6e3d1dc4dd61632e05f26cde1757c58f428c48f025331fb7e" "q-78965/selection/a90bf83e83f43b1ce6178086e991bb5a538e9e6d8e02092272c9df109acdd138"] :db/ensure [:answer-field/validate]} {:db/id "q-78965" :question/id #uuid "93bebc99-8c33-52a3-9bef-f35a82e22b74" :question/math-academy-id "q-78965" :question/problem "Calculate $\\int \\frac{{log}_{3}⁡(2x)}{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=\\frac{1}{{x}^{2}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{2}}\\,\\text{d}x=-\\frac{1}{x}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡(2x)}{{x}^{2}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡(2x)\\cdot (-\\frac{1}{x})-\\int (-\\frac{1}{x})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡(2x)}{x}-\\frac{1}{\\operatorname{ln}⁡3}\\int -\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡(2x)}{x}-\\frac{1}{x\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{x\\operatorname{ln}⁡3}-\\frac{1}{x\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)+1}{x\\operatorname{ln}⁡3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78965/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-78965"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114551/selection/717c54f714547f98ca38476f806ecd635ea0f09b69dbe58e16524e6f8f3132ae" :answer/id #uuid "eb79688f-ee33-5f49-8ac1-