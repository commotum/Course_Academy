#{[{:db/id #edb/ref 17592186318111 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb79688f-ee33-5f49-8ac1-7eb3e0b1cc72" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}(\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186318113} {:answer/id #uuid "cee6859f-3075-5abb-9813-2204d2d1b0e4" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}(2\\operatorname{ln}⁡x-3)+C" :db/id #edb/ref 17592186318114} {:answer/id #uuid "3a2325ec-8150-5038-8831-7fc994c26f8c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}(\\operatorname{ln}⁡x-2)+C" :db/id #edb/ref 17592186318115} {:answer/id #uuid "5b60c146-5a68-553c-a3fc-e59e2983cc02" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}(3\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318116} {:answer/id #uuid "a4c3e805-8948-5a80-95a5-d87fc8d60775" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}(\\operatorname{ln}⁡x-3)+C" :db/id #edb/ref 17592186318117}] :answer-field/correct {:answer/id #uuid "5b60c146-5a68-553c-a3fc-e59e2983cc02" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}(3\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318116} :answer-field/id #uuid "0f2e6afa-447b-5746-839f-0cbcf2bdb4d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318112}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ce56e920-7128-5cb4-b00f-1f6fa4cc6241" :question/math-academy-id "q-114551" :question/problem "Calculate $\\int 9{x}^{2}\\operatorname{ln}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=9{x}^{2}\\, & ⟹\\,v=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}\\operatorname{ln}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(3{x}^{3})-\\int \\frac{3{x}^{3}}{x}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡(x)-3\\int {x}^{2}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C \\\\  & ={x}^{3}(3\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186318118 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da149197-5612-5ca8-86b3-1fbf4db3a40d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(3\\operatorname{ln}⁡x+2)+C" :db/id #edb/ref 17592186318120} {:answer/id #uuid "ceb697b9-60f8-51d7-956a-a84be5e2ce52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318121} {:answer/id #uuid "f3b46d47-7665-5ce9-8b96-c7e983fb2070" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318122} {:answer/id #uuid "22e85555-3427-500f-b410-7a40d06d8667" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318123} {:answer/id #uuid "cd0015d3-2093-54f3-b9da-d1c42552e62b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(4\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186318124}] :answer-field/correct {:answer/id #uuid "22e85555-3427-500f-b410-7a40d06d8667" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186318123} :answer-field/id #uuid "7acf4f14-2c9b-549e-a3ae-d4bcdf126fe0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318119}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "adb6bd6a-5fe4-5f2f-adca-597f6bc19475" :question/math-academy-id "q-114552" :question/problem "Calculate $\\int 2x{log}_{5}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=2x\\, & ⟹\\,v=\\int 2x\\,\\text{d}x={x}^{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2x{log}_{5}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(x)({x}^{2})-\\int ({x}^{2})(\\frac{1}{x\\operatorname{ln}⁡5})\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\int x\\,\\text{d}x \\\\  & ={x}^{2}{log}_{5}⁡(x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}-\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{2}}{2\\operatorname{ln}⁡5}(2\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$"}] [{:db/id #edb/ref 17592186318125 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93259961-a3ca-5ac8-87a2-71a7cea6a409" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2-1}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318127} {:answer/id #uuid "79a270bb-026c-5fe4-8af0-61cccf57f146" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2+1}{2\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318128} {:answer/id #uuid "8fca01a6-7b81-5aa9-a3e9-3e2ce16715ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318129} {:answer/id #uuid "9a7c4d64-f006-52ef-80d3-66b329b15866" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡2-1}{2\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318130} {:answer/id #uuid "3c843b91-1290-5408-a9bc-054db86fb1c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡2+1}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318131}] :answer-field/correct {:answer/id #uuid "9a7c4d64-f006-52ef-80d3-66b329b15866" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡2-1}{2\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186318130} :answer-field/id #uuid "f70f5b49-8ff0-5b61-a329-4e6974022274" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318126}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "375fc98e-274f-5569-b040-d905f2154dcf" :question/math-academy-id "q-114679" :question/problem "Evaluate ${\\int }_{1/2}^{1}{log}_{3}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1/2}^{1}{log}_{3}⁡(2x)\\text{d}x={\\int }_{1/2}^{1}\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡3}\\,\\text{d}x=\\frac{1}{\\operatorname{ln}⁡3}{\\int }_{1/2}^{1}\\operatorname{ln}⁡(2x)\\cdot 1\\cdot \\text{d}x.\n$$\n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{1}{log}_{3}⁡(2x)\\,\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡3}{\\int }_{1/2}^{1}\\operatorname{ln}⁡(2x)\\cdot 1\\cdot \\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}{\\int }_{1/2}^{1}u{v}^{′}\\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[uv{|}_{1/2}^{1}-{\\int }_{1/2}^{1}v{u}^{′}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[x\\operatorname{ln}⁡(2x){|}_{1/2}^{1}-{\\int }_{1/2}^{1}x(\\frac{1}{x})\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[1\\cdot \\operatorname{ln}⁡(2\\cdot 1)-\\frac{1}{2}\\operatorname{ln}⁡(2\\cdot \\frac{1}{2})-{\\int }_{1/2}^{1}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[\\operatorname{ln}⁡2-\\frac{1}{2}\\operatorname{ln}⁡1-x{|}_{1/2}^{1}\\,] \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[\\operatorname{ln}⁡2-0-(1-\\frac{1}{2})] \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}[\\operatorname{ln}⁡2-\\frac{1}{2}] \\\\  & =\\frac{2\\operatorname{ln}⁡2-1}{2\\operatorname{ln}⁡3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318132 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99d72006-1147-54ef-a872-623eea25df94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10\\ln(5)}" :db/id #edb/ref 17592186318134}] :answer-field/correct {:answer/id #uuid "99d72006-1147-54ef-a872-623eea25df94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10\\ln(5)}" :db/id #edb/ref 17592186318134} :answer-field/id #uuid "0fef215c-0706-5dad-8f91-d116ebf774f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318133}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "27ff2eec-0dfe-5760-9612-9836e8485b37" :question/math-academy-id "q-350976" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/10}^{e/10}{log}_{5}⁡(10x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1/10}^{e/10}{log}_{5}⁡(10x)\\,\\text{d}x={\\int }_{1/10}^{e/10}{log}_{5}⁡(10x)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(10x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡(5)} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/10}^{e/10}{log}_{5}⁡(10x)\\,\\text{d}x & ={\\int }_{1/10}^{e/10}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1/10}^{e/10}-{\\int }_{1/10}^{e/10}v{u}^{′}\\text{d}x \\\\  & ={log}_{5}⁡(10x)\\,(x){|}_{1/10}^{e/10}-{\\int }_{1/10}^{e/10}x(\\frac{1}{x\\operatorname{ln}⁡(5)})\\,\\text{d}x \\\\  & =[{log}_{5}⁡(10\\cdot \\frac{e}{10})\\,(\\frac{e}{10})-{log}_{5}⁡(10\\cdot \\frac{1}{10})\\,(\\frac{1}{10})]-\\frac{1}{\\operatorname{ln}⁡(5)}{\\int }_{1/10}^{e/10}\\text{d}x \\\\  & =\\frac{e}{10}{log}_{5}⁡(e)-\\frac{1}{10}{log}_{5}⁡(1)-\\frac{1}{\\operatorname{ln}⁡(5)}x{|}_{1/10}^{e/10} \\\\  & =\\frac{e}{10}\\cdot \\frac{1}{\\operatorname{ln}⁡(5)}-\\frac{1}{\\operatorname{ln}⁡(5)}(\\frac{e}{10}-\\frac{1}{10}) \\\\  & =\\frac{1}{10\\operatorname{ln}⁡(5)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186318135 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70c568a5-a3e4-5e3c-8389-21b2fda1d663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(2x)+1}{{x}^{2}\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318137} {:answer/id #uuid "1c99aafa-224f-5d81-9236-71a11ae98eb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-\\operatorname{ln}⁡(2x)}{x\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318138} {:answer/id #uuid "8b5c387e-ca59-526a-a6bd-5f717de0f97e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{x\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318139} {:answer/id #uuid "f2625f94-892c-587f-a10b-8e53903abb87" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318140} {:answer/id #uuid "bb0ddfc0-301b-567a-bc99-ceeeef0d223f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(2x)-1}{x\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318141}] :answer-field/correct {:answer/id #uuid "8b5c387e-ca59-526a-a6bd-5f717de0f97e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{x\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186318139} :answer-field/id #uuid "4fd5921f-d948-5b6b-8545-0d3414bc7aee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318136}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "93bebc99-8c33-52a3-9bef-f35a82e22b74" :question/math-academy-id "q-78965" :question/problem "Calculate $\\int \\frac{{log}_{3}⁡(2x)}{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=\\frac{1}{{x}^{2}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{2}}\\,\\text{d}x=-\\frac{1}{x}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡(2x)}{{x}^{2}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡(2x)\\cdot (-\\frac{1}{x})-\\int (-\\frac{1}{x})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡(2x)}{x}-\\frac{1}{\\operatorname{ln}⁡3}\\int -\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡(2x)}{x}-\\frac{1}{x\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{x\\operatorname{ln}⁡3}-\\frac{1}{x\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)+1}{x\\operatorname{ln}⁡3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$"}]}
