#{[{:db/id #edb/ref 17592186311782 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dec4d8a-eb47-5a0e-8bc6-79e5c68ce845" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{10}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311784} {:answer/id #uuid "6a00b159-494d-57f0-b2df-848c702a6c33" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311785} {:answer/id #uuid "4d7ebea2-6028-56f1-94f6-58c564514eb1" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-3 & -1 \\\\ -4 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311786} {:answer/id #uuid "9ebd9aa1-0838-5623-8e6e-5cb815f79024" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311787} {:answer/id #uuid "a24530fd-1240-5b73-957a-7bf1c97a3970" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{10}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311788}] :answer-field/correct {:answer/id #uuid "6a00b159-494d-57f0-b2df-848c702a6c33" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311785} :answer-field/id #uuid "86ed1587-7f70-5901-935f-5fea3708eadb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311783}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "380e10d6-e728-562d-9721-3838f62a9783" :question/math-academy-id "q-102808" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-3=y \\\\ 3y=4x+2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-y=3 \\\\ -4x+3y=2.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -4 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -1 \\\\ -4 & 3\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 3-(-4)\\cdot (-1)}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}3 & 1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}3 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311789 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a23924dd-cf30-52fc-b067-7a9dfc58b515" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186311791} {:answer/id #uuid "c4ba87ec-e1f4-5208-b832-c64fecbe5e45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186311792}] :answer-field/correct {:answer/id #uuid "a23924dd-cf30-52fc-b067-7a9dfc58b515" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186311791} :answer-field/id #uuid "74985b79-99bb-584c-a522-f97c90ab03e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311790} {:answer-field/choices [{:answer/id #uuid "97ed901b-a6f8-551d-8594-b080ef99a2fc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311794}] :answer-field/correct {:answer/id #uuid "97ed901b-a6f8-551d-8594-b080ef99a2fc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311794} :answer-field/id #uuid "d720bc03-f3d7-59a9-8d45-046322368859" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311793} {:answer-field/choices [{:answer/id #uuid "c09e83c1-ca66-59b3-97a6-8b5d7c78ab0b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311796}] :answer-field/correct {:answer/id #uuid "c09e83c1-ca66-59b3-97a6-8b5d7c78ab0b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311796} :answer-field/id #uuid "8f65ecc1-00c7-5a6c-8464-bd186c299b63" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311795}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7174a34a-7912-56f7-9a7a-e80574460128" :question/math-academy-id "q-320806" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}-2x+3y=5 \\\\ 4x+y=11\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-3$ |  |\n| --- | --- | --- | --- |\n|  | $-4$ | {{field-3}} |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $11$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-3$ |  |  |  |\n|  | $-4$ | {{field-3}} |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $11$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}-2 & 3 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ 11\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}-2 & 3 \\\\ 4 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-2)\\cdot 1-4\\cdot 3}[\\begin{aligned}1 & -3 \\\\ -4 & -2\\end{aligned}] \\\\  & =-\\frac{1}{14}[\\begin{aligned}1 & -3 \\\\ -4 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{14}[\\begin{aligned}1 & -3 \\\\ -4 & -2\\end{aligned}][\\begin{aligned}5 \\\\ 11\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311797 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b69ac83f-0fe7-5de6-ae09-774ffc93be92" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186311799}] :answer-field/correct {:answer/id #uuid "b69ac83f-0fe7-5de6-ae09-774ffc93be92" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186311799} :answer-field/id #uuid "93962f49-2332-57a5-bff3-ea2b3cb5b169" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311798} {:answer-field/choices [{:answer/id #uuid "1aea10e8-7b2e-597f-8caa-9898a705b2d1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311801}] :answer-field/correct {:answer/id #uuid "1aea10e8-7b2e-597f-8caa-9898a705b2d1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311801} :answer-field/id #uuid "adb5d11e-fe50-551b-85f2-cf7ca9e59ae2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311800} {:answer-field/choices [{:answer/id #uuid "a3738ad2-254c-51f2-bac1-4a926f1ea273" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311803}] :answer-field/correct {:answer/id #uuid "a3738ad2-254c-51f2-bac1-4a926f1ea273" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311803} :answer-field/id #uuid "acb9124e-56c0-5068-a34f-6032aab2ca3c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311802}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6783007e-1f5e-5332-be6d-e39947617e57" :question/math-academy-id "q-320847" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ 4x=6-y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-2$ |  |\n| --- | --- | --- | --- |\n|  | $-4$ | {{field-3}} |  | |  |  |  | |  | $-1$ |  |\n| --- | --- | --- |\n|  | $6$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-2$ |  |  |  |\n|  | $-4$ | {{field-3}} |  |  |  |\n|  | $-1$ |  |  |  |  |\n|  | $6$ |  |  |  |  |" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ 4x+y=6.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 2 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 6\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & 2 \\\\ 4 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 1-4\\cdot 2}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}] \\\\  & =-\\frac{1}{7}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{7}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311804 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef8351b-b7c0-56ce-8896-04c9de714e9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186311806}] :answer-field/correct {:answer/id #uuid "1ef8351b-b7c0-56ce-8896-04c9de714e9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{13}" :db/id #edb/ref 17592186311806} :answer-field/id #uuid "4a0752da-4404-5c4b-ae3a-687f49db8bb6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311805} {:answer-field/choices [{:answer/id #uuid "39b4f766-4a01-5582-a9fb-59b6ebee58c9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311808}] :answer-field/correct {:answer/id #uuid "39b4f766-4a01-5582-a9fb-59b6ebee58c9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186311808} :answer-field/id #uuid "2a05cf06-46b3-5b36-a34a-76484ba317e2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311807} {:answer-field/choices [{:answer/id #uuid "0bca49bc-48c4-5d62-9b05-2365f095a552" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186311810}] :answer-field/correct {:answer/id #uuid "0bca49bc-48c4-5d62-9b05-2365f095a552" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186311810} :answer-field/id #uuid "3bbdd4e3-1fe4-5a52-ba95-95c6c76ddd71" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311809}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5037554e-827b-5077-aae9-a05ccc0e3b02" :question/math-academy-id "q-321441" :question/problem "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}3x+2y=4 \\\\ 5x-y=-6\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $-1$ | {{field-2}} |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $3$ |  | |  |  |  | |  | $4$ |  |\n| --- | --- | --- |\n|  | $-6$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $-1$ | {{field-2}} |  |  |  |\n|  | {{field-3}} | $3$ |  |  |  |\n|  | $4$ |  |  |  |  |\n|  | $-6$ |  |  |  |  |" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -6\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot (-1)-5\\cdot 2}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}] \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{13}[\\begin{aligned}-1 & -2 \\\\ -5 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311811 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f57512-fab5-5581-8f42-0dd10e1f2c80" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311813} {:answer/id #uuid "4e89bbbf-21a4-5e14-8d55-32ad48d7d8fb" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & 1 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311814} {:answer/id #uuid "90af8c35-1090-58d1-9d50-e581d7b600f4" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186311815} {:answer/id #uuid "eec0083a-1955-54e8-a26c-955ae7e4e64f" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311816} {:answer/id #uuid "669aec03-1b73-5cfa-b04c-038b10b5d7d4" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186311817}] :answer-field/correct {:answer/id #uuid "17f57512-fab5-5581-8f42-0dd10e1f2c80" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186311813} :answer-field/id #uuid "bcb9503e-a87d-5cff-9ea9-1cf33d2a4045" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311812}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "68e213ba-56c3-52ad-a2ef-a544dacede35" :question/math-academy-id "q-72733" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=y+1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-y=1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}]}
