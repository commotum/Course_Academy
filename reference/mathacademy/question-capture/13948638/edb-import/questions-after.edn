/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186263702} :answer-field/id #uuid "31b92fa8-1c9d-53dc-b5e8-47f6c7dde786" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263701} {:answer-field/choices [{:answer/id #uuid "17c7558a-bff4-5dcb-aac2-efafbfbf58c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263704}] :answer-field/correct {:answer/id #uuid "17c7558a-bff4-5dcb-aac2-efafbfbf58c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263704} :answer-field/id #uuid "12c2326f-63bf-599c-9eae-0a324f814bbe" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263703} {:answer-field/choices [{:answer/id #uuid "ab39e984-d2b2-570a-bba9-ea8a60acff68" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263706}] :answer-field/correct {:answer/id #uuid "ab39e984-d2b2-570a-bba9-ea8a60acff68" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263706} :answer-field/id #uuid "5e2a57b0-5438-5064-9948-9582890f0f80" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263705}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "650a1759-ce40-5619-a3a2-2fcff9d9f46b" :question/math-academy-id "q-276257" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=5-4t,\\,y=t+1,\\,t\\ge -1.\n$$\n\nDetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $x=5-4t\\le 9$ for all $t\\ge -1.$ Consequently, the range of $x$ is\n\n$$\nx\\le 9.\n$$\n\n- To find the range of $y,$ note that $y=t+1\\ge 0$ for all $t\\ge -1.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 0.\n$$"}] [{:db/id #edb/ref 17592186263707 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1a526b0-6ceb-553c-ae95-84b0ce05871c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263709}] :answer-field/correct {:answer/id #uuid "d1a526b0-6ceb-553c-ae95-84b0ce05871c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186263709} :answer-field/id #uuid "eb0064fb-c987-5cb6-88d1-98c208ae2570" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263708} {:answer-field/choices [{:answer/id #uuid "6720d6ed-a4b4-559b-acce-c6d66e5cf707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186263711}] :answer-field/correct {:answer/id #uuid "6720d6ed-a4b4-559b-acce-c6d66e5cf707" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186263711} :answer-field/id #uuid "83cf9500-d3a8-5900-a83e-e42277cd333a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263710} {:answer-field/choices [{:answer/id #uuid "0b138873-6644-5893-8633-49c3e42ea4cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186263713}] :answer-field/correct {:answer/id #uuid "0b138873-6644-5893-8633-49c3e42ea4cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186263713} :answer-field/id #uuid "a8af02ca-12c5-5bcf-bb12-b6ea86475d9a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263712}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "04af7c3e-29ba-55d1-9de5-2657b1fa8459" :question/math-academy-id "q-326242" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\frac{3}{2}t+1,\\,y=-\\frac{5}{4}t+2,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $1$ | $\\frac{5}{2}$ | $4$ | {{field-2}} | $7$ |\n| $y$ | {{field-3}} | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" :question/worked-solution "- To find the value of $x(-1),$ we substitute $t=-1$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(-1)=\\frac{3}{2}(-1)+1=-\\frac{3}{2}+\\frac{2}{2}=-\\frac{1}{2}.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=-\\frac{5}{4}t+2.$ This gives\n\n$$\ny(-1)=-\\frac{5}{4}(-1)+2=\\frac{5}{4}+\\frac{8}{4}=\\frac{13}{4}.\n$$\n\n- To find the value of $x(3),$ we substitute $t=3$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(2)=\\frac{3}{2}(3)+1=\\frac{9}{2}+\\frac{2}{2}=\\frac{11}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-\\frac{1}{2}$ | $1$ | $\\frac{5}{2}$ | $4$ | $\\frac{11}{2}$ | $7$ |\n| $y$ | $\\frac{13}{4}$ | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |"}] [{:db/id #edb/ref 17592186263714 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c4babc-f016-555f-95f6-24e4320c9d0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263716} {:answer/id #uuid "6a948c48-01de-58fa-9dfb-933a17d01e40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263717}] :answer-field/correct {:answer/id #uuid "d2c4babc-f016-555f-95f6-24e4320c9d0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263716} :answer-field/id #uuid "46013532-a405-5c62-85be-c220efe3cf22" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263715} {:answer-field/choices [{:answer/id #uuid "638a3879-8b9e-5686-bedb-77f7c8732fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263719}] :answer-field/correct {:answer/id #uuid "638a3879-8b9e-5686-bedb-77f7c8732fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263719} :answer-field/id #uuid "9d2a0c3c-2012-5456-aa8a-b3f41c4c8eec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263718} {:answer-field/choices [{:answer/id #uuid "cae88c29-ef32-5409-8407-90990777ecb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263721}] :answer-field/correct {:answer/id #uuid "cae88c29-ef32-5409-8407-90990777ecb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263721} :answer-field/id #uuid "99ba54f9-b6f6-56e6-b8f8-f4a7db344f85" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263720}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4cc20620-c2d3-5cb5-adf6-4d97890f6861" :question/math-academy-id "q-326256" :question/problem "Consider the curve with parametric equations\n\n$$\nx=cos\\,(\\frac{\\pi t}{2}),\\,y=tan\\,(\\frac{\\pi t}{3}),\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | {{field-1}} | $0$ | {{field-2}} | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | {{field-3}} | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |" :question/worked-solution "- To find the value of $x(0),$ we substitute $t=0$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(0)=cos\\,(\\frac{\\pi (0)}{2})=\\operatorname{cos}⁡(0)=1.\n$$\n\n- To find the value of $y(1),$ we substitute $t=1$ into $y=tan\\,(\\frac{\\pi t}{3}).$ This gives\n\n$$\ny(1)=tan\\,(\\frac{\\pi (1)}{3})=tan\\,(\\frac{\\pi }{3})=\\sqrt{3}.\n$$\n\n- To find the value of $x(2),$ we substitute $t=2$ into $x=cos\\,(\\frac{\\pi t}{2}).$ This gives\n\n$$\nx(2)=cos\\,(\\frac{\\pi (2)}{2})=\\operatorname{cos}⁡(\\pi )=-1.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $1$ | $0$ | $-1$ | $0$ | $1$ |\n| $y$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ | $-\\sqrt{3}$ | $0$ | $\\sqrt{3}$ |"}] [{:db/id #edb/ref 17592186263722 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3884756a-df02-5318-9b3c-925019a369b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\leq" :db/id #edb/ref 17592186263724} {:answer/id #uuid "9c6ab4b9-5689-5f59-9227-267e04e21eb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263725}] :answer-field/correct {:answer/id #uuid "3884756a-df02-5318-9b3c-925019a369b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\leq" :db/id #edb/ref 17592186263724} :answer-field/id #uuid "27a16d12-09a9-583e-a2b9-c45a209b5c3c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263723} {:answer-field/choices [{:answer/id #uuid "22166b68-e592-57a5-978e-031903713298" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263727}] :answer-field/correct {:answer/id #uuid "22166b68-e592-57a5-978e-031903713298" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186263727} :answer-field/id #uuid "9d30c6a6-789d-5fb6-b7c5-867777a5bb9f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263726} {:answer-field/choices [{:answer/id #uuid "c6741198-8ee1-56fe-9a53-bdb6ff81bd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263729}] :answer-field/correct {:answer/id #uuid "c6741198-8ee1-56fe-9a53-bdb6ff81bd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263729} :answer-field/id #uuid "256da788-2f5a-5637-acfa-1cf02b4b4733" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263728} {:answer-field/choices [{:answer/id #uuid "65af1af6-3901-53d5-8b09-73ab3bd60a84" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263731}] :answer-field/correct {:answer/id #uuid "65af1af6-3901-53d5-8b09-73ab3bd60a84" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186263731} :answer-field/id #uuid "5d4322d8-bd21-52ab-a08e-1cfd709b822c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263730}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bee5cdd3-77c8-59d0-a7b7-799533d9bfae" :question/math-academy-id "q-326259" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2t-7,\\,y=3-t,\\,t\\le 4.\n$$\n\nDetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $x=2t-7\\le 1$ for all $t\\le 4.$ Consequently, the range of $x$ is\n\n$$\nx\\le 1.\n$$\n\n- To find the range of $y,$ note that $y=3-t\\ge -1$ for all $t\\le 4.$ Consequently, the range of $y$ is\n\n$$\ny\\ge -1.\n$$"}] [{:db/id #edb/ref 17592186263732 :knowledge-point/_questions [{:knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a214fa4-411a-5089-a292-840a2c7f57f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\leq" :db/id #edb/ref 17592186263734} {:answer/id #uuid "8c61ef48-0185-5262-be2b-e8b45d2a040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263735}] :answer-field/correct {:answer/id #uuid "8c61ef48-0185-5262-be2b-e8b45d2a040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263735} :answer-field/id #uuid "4c6091f5-8534-5e13-a093-7b7411a34aeb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263733} {:answer-field/choices [{:answer/id #uuid "94d75044-3115-5ee2-8809-6540fb4c85b3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263737}] :answer-field/correct {:answer/id #uuid "94d75044-3115-5ee2-8809-6540fb4c85b3" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263737} :answer-field/id #uuid "716d47e9-2344-5b5b-aea5-e64d8fd0ae5f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263736} {:answer-field/choices [{:answer/id #uuid "c2a05504-6038-5410-881d-24cdfafdca72" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263739}] :answer-field/correct {:answer/id #uuid "c2a05504-6038-5410-881d-24cdfafdca72" :answer/type {:db/ident :answer.type/math} :answer/value "\\geq" :db/id #edb/ref 17592186263739} :answer-field/id #uuid "02956170-4454-51ee-83f3-5eca5b96acf8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263738} {:answer-field/choices [{:answer/id #uuid "70c57606-7131-5407-9091-2c1a01aa3807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263741}] :answer-field/correct {:answer/id #uuid "70c57606-7131-5407-9091-2c1a01aa3807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263741} :answer-field/id #uuid "b985bfe9-a2d2-5c05-a3c7-8ec8a354bd9c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186263740}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30b04f17-aee8-5e9e-9e8e-8855a22f81b8" :question/math-academy-id "q-326305" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=2{t}^{2}-4t,\\,y=(t-1)^{2}+2,\\,t\\in (-\\infty ,\\infty ),\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ we can start by completing the square, as follows:\n\n$$\n\\begin{aligned}x & =2{t}^{2}-4t \\\\  & =2({t}^{2}-2t) \\\\  & =2({t}^{2}-2t+1)-2 \\\\  & =2(t-1)^{2}-2\\end{aligned}\n$$\n\nSince $2(t-1)^{2}-2\\ge -2,$ we conclude that the range of $x$ is\n\n$$\nx\\ge -2.\n$$\n\n- To find the range of $y,$ notice that $(t-1)^{2}+2\\ge 2.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 2.\n$$"}] [{:db/id #edb/ref 17592186263742 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e28290f-04bd-5b21-a4da-acfcbfe0c586" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263744} {:answer/id #uuid "4dd08c63-9faa-58ca-98f5-47c32a6e9895" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186263745} {:answer/id #uuid "1fac5e84-4bd3-590f-9218-3fb02402753f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186263746} {:answer/id #uuid "a8280a04-e85c-5743-891f-abfd37c14739" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186263747} {:answer/id #uuid "ab116900-23b9-5ab3-9a99-64314e877b58" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186263748}] :answer-field/correct {:answer/id #uuid "a8280a04-e85c-5743-891f-abfd37c14739" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186263747} :answer-field/id #uuid "e55943b5-2e2f-5c6f-90d2-7ece1f243a23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263743}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "43acae2f-c357-56e4-b21a-0bf699c0c709" :question/math-academy-id "q-6742" :question/problem "For the parametric curve\n\n$$\nx=t+1,\\,\\,\\,y={t}^{2}-6,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ | $c$ |\n| $y$ | $a$ | $-2$ | $-5$ | $b$ | $-5$ | $-2$ | $3$ |\n\n$$\n\n$$\n\nFind the value of $a-b-c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-3$ into $y={t}^{2}-6.$ This gives\n\n$$\na=(-3)^{2}-6=9-6=3.\n$$\n\n- To find the value of $b,$ we substitute $t=0$ into $y={t}^{2}-6.$ This gives\n\n$$\nb={0}^{2}-6=0-6=-6.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $x=t+1.$ This gives\n\n$$\nc=3+1=4.\n$$\n\nFinally, we have\n\n$$\na-b-c=3-(-6)-4=5.\n$$"}] [{:db/id #edb/ref 17592186088212 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/title "Filling a Table of Values for a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88abdcab-2d16-5df6-a394-86cb23753c8e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186086204} {:answer/id #uuid "9e4ba1e6-15fd-50c1-80e3-830ee7f16eeb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186086205} {:answer/id #uuid "a96cb040-c0c5-562e-99ff-a33f78af489d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186086206} {:answer/id #uuid "69eb0c9c-575e-5911-badd-39d4243b48d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186086207} {:answer/id #uuid "7d40b66e-4d25-5499-bb8e-5292bd261d23" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186086208}] :answer-field/correct {:answer/id #uuid "88abdcab-2d16-5df6-a394-86cb23753c8e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186086204} :answer-field/id #uuid "a4ebc9cd-106a-5712-97de-c815929e4649" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2efd117e-aa4e-5314-8b1b-8bd86f2a35c1" :question/math-academy-id "q-6834" :question/problem "For the parametric curve\n$x = t^{2} - 4, y = \\frac{5}{2} - \\frac{t}{2},-1 \\le t \\le 5$,\nconsider the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n| $x$ | $\\textcolor{blue}{a}$ | $-4$ | $-3$ | $0$ | $5$ | $12$ | $21$ |\n| $y$ | $3$ | $\\frac{5}{2}$ | $\\textcolor{blue}{b}$ | $\\frac{3}{2}$ | $1$ | $\\frac{1}{2}$ | $\\textcolor{blue}{c}$ |\n\nFind the value of $a - b + c$." :question/worked-solution "- To find the value of $a,$ we substitute $t=-1$ into $x={t}^{2}-4.$ This gives\n\n$$\na=(-1)^{2}-4=1-4=-3.\n$$\n\n- To find the value of $b,$ we substitute $t=1$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nb=\\frac{5}{2}-\\frac{1}{2}=\\frac{4}{2}=2.\n$$\n\n- To find the value of $c,$ we substitute $t=5$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nc=\\frac{5}{2}-\\frac{5}{2}=0.\n$$\n\nFinally, we have\n\n$$\na-b+c=-3-2+0=-5.\n$$"}]}
