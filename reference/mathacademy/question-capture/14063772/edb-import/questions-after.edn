#{[{:db/id #edb/ref 17592186346633 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02704357-d1ba-5c57-a0cd-dbc02e66834a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186346635} {:answer/id #uuid "b7a21051-369e-586e-b427-e4044d179a9f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186346636} {:answer/id #uuid "c360cb14-778e-56b7-84bf-80bbac8ba868" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm x" :db/id #edb/ref 17592186346637} {:answer/id #uuid "e774533f-4408-554e-b611-6b0d65543b38" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 3x" :db/id #edb/ref 17592186346638} {:answer/id #uuid "6c7b50aa-cb6c-5b92-a8ab-0a305f92b6dc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{3}x" :db/id #edb/ref 17592186346639}] :answer-field/correct {:answer/id #uuid "e774533f-4408-554e-b611-6b0d65543b38" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 3x" :db/id #edb/ref 17592186346638} :answer-field/id #uuid "a29831a1-e7e3-5246-82d0-04c451b30b78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346634}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07129d8d-82e3-5b90-a321-b803049449ab" :question/math-academy-id "q-10435" :question/problem "Find the asymptotes of the hyperbola ${y}^{2}-9{x}^{2}=9.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $9$ and then simplify, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-9{x}^{2} & =9 \\\\ \\frac{{y}^{2}}{9}-\\frac{9{x}^{2}}{9} & =\\frac{9}{9} \\\\ \\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{1} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{9}=3$ and $b=\\sqrt{1}=1.$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{1}x \\\\  & =\\pm 3x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186346640 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41b5000c-3a32-5a7a-948e-a6adcbaa2bb8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186346642} {:answer/id #uuid "2b8b4799-d6e4-525b-a2fe-98047ff8f252" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{2}}{4}x" :db/id #edb/ref 17592186346643} {:answer/id #uuid "827d403e-fbe3-5cf2-a1bf-b7a9ec6c6b6f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5\\sqrt{2}}{4}x" :db/id #edb/ref 17592186346644} {:answer/id #uuid "9d34daf7-31f4-5f2b-875d-9b14a7bdd3dd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2\\sqrt{2}}{5}x" :db/id #edb/ref 17592186346645} {:answer/id #uuid "f068acd0-8d97-5074-8084-a73677d3944a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{5}}{2}x" :db/id #edb/ref 17592186346646}] :answer-field/correct {:answer/id #uuid "827d403e-fbe3-5cf2-a1bf-b7a9ec6c6b6f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5\\sqrt{2}}{4}x" :db/id #edb/ref 17592186346644} :answer-field/id #uuid "4535624b-82bd-59b4-a02e-d4aa1c4064b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346641}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8d94134c-ec88-57a5-9623-464fd1bd46e5" :question/math-academy-id "q-116564" :question/problem "Find the asymptotes of the hyperbola $8{y}^{2}-25{x}^{2}=200.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $200$ and then simplify, as follows:\n\n$$\n\\begin{aligned}8{y}^{2}-25{x}^{2} & =200 \\\\ \\frac{8{y}^{2}}{200}-\\frac{25{x}^{2}}{200} & =\\frac{200}{200} \\\\ \\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{8} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{25}=5,$ and $b=\\sqrt{8}=2\\sqrt{2}.$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{5}{2\\sqrt{2}}x=\\pm \\frac{5\\sqrt{2}}{4}x.$"}] [{:db/id #edb/ref 17592186346647 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e65f487e-30a3-5263-82d0-be81937ec7f3" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186346649}] :answer-field/correct {:answer/id #uuid "e65f487e-30a3-5263-82d0-be81937ec7f3" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186346649} :answer-field/id #uuid "527ef2fa-5ff3-5a5a-aec0-1c59faf66b53" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346648}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "689e411b-a569-5195-905c-b64c88774ee0" :question/math-academy-id "q-316928" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{100}-\\frac{{x}^{2}}{25}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{100}=10,\\,b=\\sqrt{25}=5.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{10}{5}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186346650 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11abc2fd-ba50-5529-811e-e22dec03034d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186346652} {:answer/id #uuid "186ee738-7783-5bfd-b906-f39f2687548c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186346653} {:answer/id #uuid "9e3f6e7e-268f-5d10-913d-0c85e00f2d42" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 8x" :db/id #edb/ref 17592186346654} {:answer/id #uuid "724204bd-f49d-5c09-bf7d-9ab9a309d295" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186346655} {:answer/id #uuid "585e85c7-f5c5-549d-930a-108cf0e19221" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186346656}] :answer-field/correct {:answer/id #uuid "724204bd-f49d-5c09-bf7d-9ab9a309d295" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186346655} :answer-field/id #uuid "4a4b92c5-290c-52db-9ca9-d46986bb5130" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "649c6af8-efb9-5066-82d7-b9fe88bc6cab" :question/math-academy-id "q-84082" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{64}-\\frac{{x}^{2}}{4}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{64}=8,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{8}{2}x \\\\  & =\\pm 4x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088372 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84e5a98d-84cd-52e8-8516-83623696c4f3" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{\\sqrt{2}}{3}x" :db/id #edb/ref 17592186087163} {:answer/id #uuid "12aef87e-8113-5eb7-93a0-94024d16c3e2" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{2}{3}x" :db/id #edb/ref 17592186087164} {:answer/id #uuid "519e5873-883f-581e-a05f-a40539f56401" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{3\\sqrt{2}}{2}x" :db/id #edb/ref 17592186087165} {:answer/id #uuid "7baf0bd3-d3d4-55d1-8363-ef7ce5e85af0" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{\\sqrt{2}}{9}x" :db/id #edb/ref 17592186087166} {:answer/id #uuid "7c174769-2455-5ac2-ac0e-fbf5546bc1f4" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{3}{2}x" :db/id #edb/ref 17592186087167}] :answer-field/correct {:answer/id #uuid "84e5a98d-84cd-52e8-8516-83623696c4f3" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{\\sqrt{2}}{3}x" :db/id #edb/ref 17592186087163} :answer-field/id #uuid "8eb9012d-1383-5a96-8ccd-25d071329120" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087162}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6658220e-f73f-5d40-a209-e0b69dd74204" :question/math-academy-id "q-84084" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{18}-\\frac{{x}^{2}}{81}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{18}=3\\sqrt{2},\\,b=\\sqrt{81}=9.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{3\\sqrt{2}}{9}x \\\\  & =\\pm \\frac{\\sqrt{2}}{3}x.\\end{aligned}\n$$"}]}
