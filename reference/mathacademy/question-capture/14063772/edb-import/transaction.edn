/id [:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98"] :knowledge-point/questions ["q-84082"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-84084"] :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{18}-\\frac{{x}^{2}}{81}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{18}=3\\sqrt{2},\\,b=\\sqrt{81}=9.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{3\\sqrt{2}}{9}x \\\\  & =\\pm \\frac{\\sqrt{2}}{3}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-116564/selection/707e9e1a6955983cd796b7e6fc1f062a9786b4036440c7d99a9585fff0606cd8" :answer/id #uuid "827d403e-fbe3-5cf2-a1bf-b7a9ec6c6b6f" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{5\\sqrt{2}}{4}x" :db/ensure [:answer/validate]} {:db/id "q-116564/selection/241d7f4e546f231146c45879647fbc0d9ba1003e4f509d0800db9e8a54ece31e" :answer/id #uuid "41b5000c-3a32-5a7a-948e-a6adcbaa2bb8" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{5}{4}x" :db/ensure [:answer/validate]} {:db/id "q-116564/selection/4a5fe9badac9ebb49f3c88f4955701b3d4f96ca4a04304c5f990f58816d8aeba" :answer/id #uuid "2b8b4799-d6e4-525b-a2fe-98047ff8f252" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{\\sqrt{2}}{4}x" :db/ensure [:answer/validate]} {:db/id "q-116564/selection/ad415bfd804061f3183b6e41e0d87de996fe44df193c095098923c30f1c09798" :answer/id #uuid "f068acd0-8d97-5074-8084-a73677d3944a" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{\\sqrt{5}}{2}x" :db/ensure [:answer/validate]} {:db/id "q-116564/selection/84ebed82b4b70cd632e2f3639860f616a2bbd7f29607ee619a5b16f0f244d2e6" :answer/id #uuid "9d34daf7-31f4-5f2b-875d-9b14a7bdd3dd" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{2\\sqrt{2}}{5}x" :db/ensure [:answer/validate]} {:db/id "q-116564/selection" :answer-field/id #uuid "4535624b-82bd-59b4-a02e-d4aa1c4064b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116564/selection/707e9e1a6955983cd796b7e6fc1f062a9786b4036440c7d99a9585fff0606cd8" :answer-field/choices ["q-116564/selection/707e9e1a6955983cd796b7e6fc1f062a9786b4036440c7d99a9585fff0606cd8" "q-116564/selection/241d7f4e546f231146c45879647fbc0d9ba1003e4f509d0800db9e8a54ece31e" "q-116564/selection/4a5fe9badac9ebb49f3c88f4955701b3d4f96ca4a04304c5f990f58816d8aeba" "q-116564/selection/ad415bfd804061f3183b6e41e0d87de996fe44df193c095098923c30f1c09798" "q-116564/selection/84ebed82b4b70cd632e2f3639860f616a2bbd7f29607ee619a5b16f0f244d2e6"] :db/ensure [:answer-field/validate]} {:db/id "q-116564" :question/id #uuid "8d94134c-ec88-57a5-9623-464fd1bd46e5" :question/math-academy-id "q-116564" :question/problem "Find the asymptotes of the hyperbola $8{y}^{2}-25{x}^{2}=200.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $200$ and then simplify, as follows:\n\n$$\n\\begin{aligned}8{y}^{2}-25{x}^{2} & =200 \\\\ \\frac{8{y}^{2}}{200}-\\frac{25{x}^{2}}{200} & =\\frac{200}{200} \\\\ \\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{8} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{25}=5,$ and $b=\\sqrt{8}=2\\sqrt{2}.$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{5}{2\\sqrt{2}}x=\\pm \\frac{5\\sqrt{2}}{4}x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-116564/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-116564"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316928/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer/id #uuid "e65f487e-30a3-5263-82d0-be81937ec7f3" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "q-316928/field-1" :answer-field/id #uuid "527ef2fa-5ff3-5a5a-aec0-1c59faf66b53" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316928/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer-field/choices ["q-316928/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7"] :db/ensure [:answer-field/validate]} {:db/id "q-316928" :question/id #uuid "689e411b-a569-5195-905c-b64c88774ee0" :question/math-academy-id "q-316928" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{100}-\\frac{{x}^{2}}{25}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{100}=10,\\,b=\\sqrt{25}=5.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{10}{5}x \\\\  & =\\pm 2x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316928/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98"] :knowledge-point/questions ["q-316928"] :db/ensure [:knowledge-point/validate]}]
