33939 true] [17592186267366 1034 "The center is $(1,-6)$ and radius is $4$" 13194139533939 true] [17592186267366 1103 #edb/ref 17592186045454 13194139533939 true] [17592186267366 1111 #uuid "37772e1e-449b-5f40-8fc2-9dc933ac701a" 13194139533939 true] [17592186267367 1034 "The center is $(1,6)$ and radius is $16$" 13194139533939 true] [17592186267367 1103 #edb/ref 17592186045454 13194139533939 true] [17592186267367 1111 #uuid "17030d37-5ed6-51a4-9256-9056340277c5" 13194139533939 true] [17592186267368 1017 #edb/ref 17592186267369 13194139533939 true] [17592186267368 1089 "q-70990" 13194139533939 true] [17592186267368 1091 #edb/ref 17592186045464 13194139533939 true] [17592186267368 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13957423/assets/a6a21dbf4785a270a0ae03066df1f92df73974532f9a75aa8e470cef42ea5e14.png)\n\nThe line segment $\\overset{―}{XY}$ is a diameter of a circle. Given that $X$ and $Y$ have coordinates $(-3,2)$ and $(3,4)$, respectively, what is the equation of the circle?" 13194139533939 true] [17592186267368 1113 #uuid "c99b7afd-31f9-5af8-976b-21fb25609620" 13194139533939 true] [17592186267368 1145 "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is  \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nUsing the distance formula to compute the distance between the points $X(-3,2)$ and $Y(3,4),$ we find that the length of the diameter is \n\n$$\n\\begin{aligned}XY & =\\sqrt{{(-3-3)}^{2}+{(2-4)}^{2}} \\\\  & =\\sqrt{(-6)^{2}+(-2)^{2}} \\\\  & =\\sqrt{40} \\\\  & =\\sqrt{4\\cdot 10} \\\\  & =2\\sqrt{10}.\\end{aligned}\n$$\n\nSo the radius of the circle is \n\n$$\nr=\\frac{2\\sqrt{10}}{2}=\\sqrt{10}.\n$$\n\nSince the center of a circle is the midpoint of the diameter, to find the center we use the midpoint formula as follows:\n\n$$\n(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2})=(\\frac{-3+3}{2},\\frac{2+4}{2})=(0,3)\n$$\n\nSo our circle has radius $r=\\sqrt{10}$ and center $(a,b)=(0,3),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-0)^{2}+(y-3)^{2} & ={(\\sqrt{10})}^{2} \\\\ {x}^{2}+(y-3)^{2} & =10\\end{aligned}\n$$" 13194139533939 true] [17592186267369 1000 #edb/ref 17592186267370 13194139533939 true] [17592186267369 1000 #edb/ref 17592186267371 13194139533939 true] [17592186267369 1000 #edb/ref 17592186267372 13194139533939 true] [17592186267369 1000 #edb/ref 17592186267373 13194139533939 true] [17592186267369 1000 #edb/ref 17592186267374 13194139533939 true] [17592186267369 1040 #edb/ref 17592186045450 13194139533939 true] [17592186267369 1041 "selection" 13194139533939 true] [17592186267369 1104 #edb/ref 17592186267373 13194139533939 true] [17592186267369 1110 #uuid "5ee6d001-e7ee-541c-b4e5-c4f24fac8f3e" 13194139533939 true] [17592186267370 1034 "(x+3)^{2}+{y}^{2}=10" 13194139533939 true] [17592186267370 1103 #edb/ref 17592186045453 13194139533939 true] [17592186267370 1111 #uuid "2d0d8b85-bb54-5f0e-b297-98a11b7dbf9b" 13194139533939 true] [17592186267371 1034 "{x}^{2}+(y+3)^{2}=10" 13194139533939 true] [17592186267371 1103 #edb/ref 17592186045453 13194139533939 true] [17592186267371 1111 #uuid "e435049d-803b-54cf-b8f9-36a9b57a2363" 13194139533939 true] [17592186267372 1034 "(x-3)^{2}-{y}^{2}=10" 13194139533939 true] [17592186267372 1103 #edb/ref 17592186045453 13194139533939 true] [17592186267372 1111 #uuid "964ef544-bc54-5091-8cb3-1a3cc1fb840b" 13194139533939 true] [17592186267373 1034 "{x}^{2}+(y-3)^{2}=10" 13194139533939 true] [17592186267373 1103 #edb/ref 17592186045453 13194139533939 true] [17592186267373 1111 #uuid "ae12dcfe-493b-55c9-b9d8-a8ef002f9622" 13194139533939 true] [17592186267374 1034 "(x-3)^{2}+{y}^{2}=10" 13194139533939 true] [17592186267374 1103 #edb/ref 17592186045453 13194139533939 true] [17592186267374 1111 #uuid "e0960862-2dcf-5b14-a911-35b39022ddbe" 13194139533939 true] [17592186267375 1017 #edb/ref 17592186267376 13194139533939 true] [17592186267