nd radius is $\\sqrt{6}$" :db/id #edb/ref 17592186086465} :answer-field/id #uuid "18cfc50e-9205-5a7e-b71b-f2d96ea1b76e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086461}] :question/id #uuid "c280c3e5-8a01-5bfb-b585-89deed38b8eb" :question/math-academy-id "q-7521" :question/problem "What is the center and radius of the circle with equation $(x - 2)^{2} + (y - 3)^{2} = 6$?"}]}
