}^{2}+9}\\,\\text{d}x=0\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345627/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7a2c6bf6-41f2-5f8d-8799-5664ba941dc8"] :knowledge-point/questions ["q-345627"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114008/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b" :answer/id #uuid "979f4478-fd2a-5cb3-bce4-df32b0447852" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-114008/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9f44682d-3b09-580b-ac7f-2e642fbda5dc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-114008/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "1bdaa589-a2f5-5c00-80e3-20c6a500bb33" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-114008/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "43bb0a94-6cf8-554a-9ceb-7bf406f39e06" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-114008/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "5a8cf248-c947-5987-84a2-86c3becfc679" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-114008/selection" :answer-field/id #uuid "10cf95ca-25fc-5901-b95e-f8385f6e9dca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114008/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-114008/selection/2aef90071200a7bc65baa2d03f49803233ca7b2dc16865265136281ee914878b" "q-114008/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-114008/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-114008/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-114008/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8"] :db/ensure [:answer-field/validate]} {:db/id "q-114008" :question/id #uuid "cedc774f-90a1-5b65-8fac-e1951a216be1" :question/math-academy-id "q-114008" :question/problem "Calculate ${\\int }_{-1}^{-1}\\frac{x}{1+{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{-1}^{-1}\\frac{x}{1+{x}^{2}}\\,\\text{d}x=0\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114008/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7a2c6bf6-41f2-5f8d-8799-5664ba941dc8"] :knowledge-point/questions ["q-114008"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49244"] :question/problem "Given that ${\\int }_{5}^{2}\\,f(x)\\,\\text{d}x=-4$, calculate\n${\\int }_{2}^{5}(2f(x)+3)\\,\\text{d}x.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}\\,f(x)\\,\\text{d}x=-{\\int }_{5}^{2}\\,f(x)\\,\\text{d}x=4\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}(2f(x)+3)\\,\\text{d}x & =2{\\int }_{2}^{5}f(x)\\,\\text{d}x+3{\\int }_{2}^{5}\\,\\text{d}x \\\\  & =2(4)+3\\cdot x\\,{|}_{2}^{5} \\\\  & =8+3(5-2) \\\\  & =8+3\\cdot 3 \\\\  & =17.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-346051/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "c4f2682f-d8fe-540f-b2cc-bd5707f362bc" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-346051/field-1/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02" :answer/id #uuid "e69df18e-b95f-585c-a50b-3ac706dbb4bc" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "q-346051/field-1" :answer-field/id #uuid "06ece43e-61c9-59cc-98ed-5ab9945b8915" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346051/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-346051/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-346051/field-1/59cabed12271767d3647412725d382bc72464274dc4ac46b4e7903c969156a02"] :db/ensure [:answer-field/validate]} {:db/id "q-346051" :question/id #uuid "2d72efcd-4dfe-5261-8d75-86d82c839657" :question/math-academy-id "q-346051" :question/problem "Given that ${\\int }_{6}^{1}\\,f(x)\\,\\text{d}x=-7,$ calculate \n${\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x.$\n\n${\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}\\,f(x)\\,\\text{d}x=-{\\int }_{6}^{1}\\,f(x)\\,\\text{d}x=7\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x & =2{\\int }_{1}^{6}f(x)\\,\\text{d}x\\,-\\,{\\int }_{1}^{6}\\,\\text{d}x \\\\  & =2(7)\\,-\\,x\\,{|}_{1}^{6} \\\\  & =14\\,-\\,(6-1) \\\\  & =14\\,-\\,5 \\\\  & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346051/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ff2f1a9d-2b0e-5a18-98d5-4f49f6f1527b"] :knowledge-point/questions ["q-346051"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114015/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "078d1099-9af1-5149-ab4f-dcfcfbbf8132" :answer/type :answer.type/math :answer/value