b2" 13194139534418 true] [17592186287239 1034 "0" 13194139534418 true] [17592186287239 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287239 1111 #uuid "6c5effa2-0f66-5088-910a-cc207c28c2bf" 13194139534418 true] [17592186287240 1017 #edb/ref 17592186287241 13194139534418 true] [17592186287240 1089 "q-346051" 13194139534418 true] [17592186287240 1091 #edb/ref 17592186045463 13194139534418 true] [17592186287240 1100 "Given that ${\\int }_{6}^{1}\\,f(x)\\,\\text{d}x=-7,$ calculate \n${\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x.$\n\n${\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x=$\n{{field-1}}" 13194139534418 true] [17592186287240 1113 #uuid "2d72efcd-4dfe-5261-8d75-86d82c839657" 13194139534418 true] [17592186287240 1145 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}\\,f(x)\\,\\text{d}x=-{\\int }_{6}^{1}\\,f(x)\\,\\text{d}x=7\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}(2f(x)-1)\\,\\text{d}x & =2{\\int }_{1}^{6}f(x)\\,\\text{d}x\\,-\\,{\\int }_{1}^{6}\\,\\text{d}x \\\\  & =2(7)\\,-\\,x\\,{|}_{1}^{6} \\\\  & =14\\,-\\,(6-1) \\\\  & =14\\,-\\,5 \\\\  & =9.\\end{aligned}\n$$" 13194139534418 true] [17592186287241 1000 #edb/ref 17592186287242 13194139534418 true] [17592186287241 1000 #edb/ref 17592186287243 13194139534418 true] [17592186287241 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287241 1041 "field-1" 13194139534418 true] [17592186287241 1104 #edb/ref 17592186287242 13194139534418 true] [17592186287241 1110 #uuid "06ece43e-61c9-59cc-98ed-5ab9945b8915" 13194139534418 true] [17592186287242 1034 "9" 13194139534418 true] [17592186287242 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287242 1111 #uuid "c4f2682f-d8fe-540f-b2cc-bd5707f362bc" 13194139534418 true] [17592186287243 1034 "19" 13194139534418 true] [17592186287243 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287243 1111 #uuid "e69df18e-b95f-585c-a50b-3ac706dbb4bc" 13194139534418 true] [17592186287244 1017 #edb/ref 17592186287245 13194139534418 true] [17592186287244 1089 "q-346057" 13194139534418 true] [17592186287244 1091 #edb/ref 17592186045463 13194139534418 true] [17592186287244 1100 "Given that ${\\int }_{4}^{1}\\,f(x)\\,\\text{d}x=-3,$ calculate ${\\int }_{1}^{4}(2f(x)+x)\\,\\text{d}x.$\n\n${\\int }_{1}^{4}(2f(x)+x)\\,\\text{d}x=$\n{{field-1}}" 13194139534418 true] [17592186287244 1113 #uuid "246ea688-360e-5196-a83d-e47bea5b22da" 13194139534418 true] [17592186287244 1145 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\,f(x)\\,\\text{d}x=-{\\int }_{4}^{1}\\,f(x)\\,\\text{d}x=3\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(2f(x)+x)\\,\\text{d}x & =2{\\int }_{1}^{4}f(x)\\,\\text{d}x\\,+\\,{\\int }_{1}^{4}x\\,\\text{d}x \\\\  & =2(3)\\,+\\,\\frac{{x}^{2}}{2}\\,{|}_{1}^{4} \\\\  & =6\\,+\\,\\frac{16-1}{2} \\\\  & =6\\,+\\,\\frac{15}{2} \\\\  & =\\frac{27}{2}.\\end{aligned}\n$$" 13194139534418 true] [17592186287245 1000 #edb/ref 17592186287246 13194139534418 true] [17592186287245 1000 #edb/ref 17592186287247 13194139534418 true] [17592186287245 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287245 1041 "field-1" 13194139534418 true] [17592186287245 1104 #edb/ref 17592186287246 13194139534418 true] [17592186287245 1110 #uuid "ad9497f7-a6bd-57c1-aaf5-1c8b8e0f4b4a" 13194139534418 true] [17592186287246 1034 "\\frac{27}{2}" 13194139534418 true] [17592186287246 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287246 1111 #uuid "e15b143b-eafb-5b87-a8dc-4a16ec1aa25e" 13194139534418 true] [17592186287247 1034 "9" 13194139534418 true] [17592186287247 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287247 1111 #uuid "6cf86f9e-790d-5745-857c-1df6f91fc584" 13194139534418 true] [17592186287248 1017 #edb/ref 17592186287249 13194139534418 true] [17592186287248 1089 "q-346188" 13194139534418 true] [17592186287248 1091 #edb/ref 17592186045463 13194139534418 true] [17592186287248 1100 "Given that ${\\int }_{1}^{3}f(x)\\,\\text{d}x=2$ and ${\\int }_{3}^{6}f(x)\\,\\text{d}x=-5$ then what is ${\\int }_{1}^{6}(2f(x)+4)\\,\\text{d}x?$\n\n${\\int }_{1}^{6}(2f(x)+4)\\,\\text{d}x=$ \n{{field-1}}" 13194139534418 true] [17592186287248 1113 #uuid "eec642e8-aa00-5555-b355-9ec662ad96f2" 13194139534418 true] [17592186287248 1145 "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x={\\int }_{1}^{6}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information gives\n\n$$\n2+(-5)={\\int }_{1}^{6}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{1}^{6}f(x)\\,\\text{d}x=-3.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{6}(2f(x)+4)\\,\\text{d}x & =2{\\int }_{1}^{6}f(x)\\,\\text{d}x+4{\\int }_{1}^{6}\\,\\text{d}x \\\\  & =2(-3)+4\\cdot x\\,{|}_{1}^{6} \\\\  & =-6+4(6-1) \\\\  & =-6+20 \\\\  & =14\\end{aligned}\n$$" 13194139534418 true] [17592186287249 1000 #edb/ref 17592186287250 13194139534418 true] [17592186287249 1000 #edb/ref 17592186287251 13194139534418 true] [17592186287249 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287249 1041 "field-1" 13194139534418 true] [17592186287249 1104 #edb/ref 17592186287251 13194139534418 true] [17592186287249 1110 #uuid "9d118722-2245-5229-9b6b-01a2481dbf7d" 13194139534418 true] [17592186287250 1034 "26" 13194139534418 true] [17592186287250 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287250 1111 #uuid "937e73e5-8f69-5b1f-8089-87434d2a8fdc" 13194139534418 true] [17592186287251 1034 "14" 13194139534418 true] [17592186287251 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287251 1111 #uuid "cb791b1c-a9ea-52b6-8898-f468d6f30bbe" 13194139534418 true] [17592186287252 1017 #edb/ref 17592186287253 13194139534418 true] [17592186287252 1089 "q-346189" 13194139534418 true] [17592186287252 1091 #edb/ref 17592186045463 13194139534418 true] [17592186287252 1100 "Given that ${\\int }_{0}^{4}f(x)\\,\\text{d}x=7$ and ${\\int }_{4}^{8}f(x)\\,\\text{d}x=1$ then what is ${\\int }_{0}^{8}(3+f(x))\\,\\text{d}x?$\n\n${\\int }_{0}^{8}(3+f(x))\\,\\text{d}x=$\n{{field-1}}" 13194139534418 true] [17592186287252 1113 #uuid "365f9a98-2f82-5cd8-98a6-e5a67719486f" 13194139534418 true] [17592186287252 1145 "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}f(x)\\,\\text{d}x+{\\int }_{4}^{8}f(x)\\,\\text{d}x={\\int }_{0}^{8}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information gives\n\n$$\n\\begin{aligned}7+1={\\int }_{0}^{8}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{0}^{8}f(x)\\,\\text{d}x=8.\\end{aligned}\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}(3+f(x))\\,\\text{d}x & =3{\\int }_{0}^{8}\\,\\text{d}x+{\\int }_{0}^{8}f(x)\\,\\text{d}x \\\\  & =3\\cdot x\\,{|}_{0}^{8}+8 \\\\  & =3(8-0)+8 \\\\  & =24+8 \\\\  & =32\\end{aligned}\n$$" 13194139534418 true] [17592186287253 1000 #edb/ref 17592186287254 13194139534418 true] [17592186287253 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287253 1041 "field-1" 13194139534418 true] [17592186287253 1104 #edb/ref 17592186287254 13194139534418 true] [17592186287253 1110 #uuid "65179503-8e8e-558f-82ed-4dd001000cfc" 13194139534418 true] [17592186287254 1034 "32" 13194139534418 true] [17592186287254 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287254 1111 #uuid "dee722b9-9bc9-5851-b8be-fbdcd71df4e5" 13194139534418 true] [17592186287255 1017 #edb/ref 17592186287256 13194139534418 true] [17592186287255 1089 "q-346225" 13194139534418 true] [17592186287255 1091 #edb/ref 17592186045464 13194139534418 true] [17592186287255 1100 "Let $f$ and $g$ be continuous functions such that ${\\int }_{0}^{8}f(x)\\,\\text{d}x=9,\\,\\,{\\int }_{0}^{8}\\frac{1}{2}\\,g(x)\\,\\text{d}x=-4,$ and ${\\int }_{3}^{8}(3f(x)+g(x))\\,\\text{d}x=10.$ What is the value of ${\\int }_{0}^{3}(3f(x)+g(x))\\,\\text{d}x?$\n\n${\\int }_{0}^{3}(3f(x)+g(x))\\,\\text{d}x=$\n{{field-1}}" 13194139534418 true] [17592186287255 1113 #uuid "18cab19d-8f67-5d6e-9e84-4c7aa4d64f7c" 13194139534418 true] [17592186287255 1145 "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}\\frac{1}{2}\\,g(x)\\,\\text{d}x & =-4 \\\\ \\frac{1}{2}{\\int }_{0}^{8}g(x)\\,\\text{d}x & =-4 \\\\ {\\int }_{0}^{8}g(x)\\,\\text{d}x & =-8\\end{aligned}\n$$\n\nUsing the adjacent intervals rule and substituting known values, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}(3f(x)+g(x))\\,\\text{d}x & ={\\int }_{0}^{3}(3f(x)+g(x))\\,\\text{d}x+{\\int }_{3}^{8}(3f(x)+g(x))\\,\\text{d}x.\\end{aligned}\n$$\n\nBy the sum rule for definite integrals,\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}(3f(x)+g(x))\\,\\text{d}x & =3{\\int }_{0}^{8}f(x)\\,\\text{d}x+{\\int }_{0}^{8}g(x)\\,\\text{d}x \\\\  & =3(9)+(-8) \\\\  & =19.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}(3f(x)+g(x))\\,\\text{d}x & =19-{\\int }_{3}^{8}(3f(x)+g(x))\\,\\text{d}x \\\\  & =19-10 \\\\  & =9.\\end{aligned}\n$$" 13194139534418 true] [17592186287256 1000 #edb/ref 17592186287257 13194139534418 true] [17592186287256 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287256 1041 "field-1" 13194139534418 true] [17592186287256 1104 #edb/ref 17592186287257 13194139534418 true] [17592186287256 1110 #uuid "08ddec81-4b31-587c-8e65-9645ef73232a" 13194139534418 true] [17592186287257 1034 "9" 13194139534418 true] [17592186287257 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287257 1111 #uuid "fa12a659-9565-53af-b941-8827250b633b" 13194139534418 true] [17592186287258 1017 #edb/ref 17592186287259 13194139534418 true] [17592186287258 1089 "q-346226" 13194139534418 true] [17592186287258 1091 #edb/ref 17592186045464 13194139534418 true] [17592186287258 1100 "Let $f$ and $g$ be continuous functions such that ${\\int }_{-3}^{3}f(x)\\,\\text{d}x=-4,\\,\\,{\\int }_{-3}^{3}\\frac{2}{3}\\,g(x)\\,\\text{d}x=6,$ and ${\\int }_{-1}^{3}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x=-20.$ What is the value of ${\\int }_{-3}^{-1}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x?$\n\n${\\int }_{-3}^{-1}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x=$\n{{field-1}}" 13194139534418 true] [17592186287258 1113 #uuid "e93e9065-9494-5342-89db-24beca909847" 13194139534418 true] [17592186287258 1145 "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{3}\\frac{2}{3}\\,g(x)\\,\\text{d}x & =6 \\\\ \\frac{2}{3}{\\int }_{-3}^{3}g(x)\\,\\text{d}x & =6 \\\\ {\\int }_{-3}^{3}g(x)\\,\\text{d}x & =9\\end{aligned}\n$$\n\nUsing the adjacent intervals rule and substituting known values, we get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{3}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x & ={\\int }_{-3}^{-1}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x \\\\  & \\,\\,\\,+{\\int }_{-1}^{3}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x.\\end{aligned}\n$$\n\nBy the sum rule for definite integrals,\n\n$$\n\\begin{aligned}{\\int }_{-3}^{3}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x & =\\frac{5}{2}{\\int }_{-3}^{3}f(x)\\,\\text{d}x-4{\\int }_{-3}^{3}g(x)\\,\\text{d}x \\\\  & =\\frac{5}{2}(-4)-4(9) \\\\  & =-46.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x & =-46-{\\int }_{-1}^{3}(\\frac{5}{2}f(x)-4g(x))\\,\\text{d}x \\\\  & =-46-(-20) \\\\  & =-26.\\end{aligned}\n$$" 13194139534418 true] [17592186287259 1000 #edb/ref 17592186287260 13194139534418 true] [17592186287259 1040 #edb/ref 17592186045449 13194139534418 true] [17592186287259 1041 "field-1" 13194139534418 true] [17592186287259 1104 #edb/ref 17592186287260 13194139534418 true] [17592186287259 1110 #uuid "54f606cc-6eec-50d2-90c6-fce418e55397" 13194139534418 true] [17592186287260 1034 "-26" 13194139534418 true] [17592186287260 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287260 1111 #uuid "ea337439-3768-513f-830f-a6043d4f5289" 13194139534418 true] [17592186287261 1017 #edb/ref 17592186287262 13194139534418 true] [17592186287261 1089 "q-4790" 13194139534418 true] [17592186287261 1091 #edb/ref 17592186045465 13194139534418 true] [17592186287261 1100 "Suppose that $f(x)$ is a function such that ${\\int }_{3}^{0}\\frac{1}{3}f(x)\\,\\text{d}x=-1$ and ${\\int }_{3}^{5}f(x)\\,\\text{d}x=6.$ What is the value of ${\\int }_{0}^{5}f(x)\\,\\text{d}x?$" 13194139534418 true] [17592186287261 1113 #uuid "b49ad214-b312-5d79-8063-a03e0ca82e97" 13194139534418 true] [17592186287261 1145 "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{3}^{0}\\frac{1}{3}\\,f(x)\\,\\text{d}x & =-1 \\\\ \\frac{1}{3}{\\int }_{3}^{0}\\,f(x)\\,\\text{d}x & =-1 \\\\ -\\frac{1}{3}{\\int }_{0}^{3}f(x)\\,\\text{d}x & =-1 \\\\ {\\int }_{0}^{3}f(x)\\,\\text{d}x & =3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get \n\n$$\n\\begin{aligned}{\\int }_{0}^{5}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{5}f(x)\\,\\text{d}x \\\\  & =3+6 \\\\  & =9.\\end{aligned}\n$$" 13194139534418 true] [17592186287262 1000 #edb/ref 17592186287263 13194139534418 true] [17592186287262 1000 #edb/ref 17592186287264 13194139534418 true] [17592186287262 1000 #edb/ref 17592186287265 13194139534418 true] [17592186287262 1000 #edb/ref 17592186287266 13194139534418 true] [17592186287262 1000 #edb/ref 17592186287267 13194139534418 true] [17592186287262 1040 #edb/ref 17592186045450 13194139534418 true] [17592186287262 1041 "selection" 13194139534418 true] [17592186287262 1104 #edb/ref 17592186287263 13194139534418 true] [17592186287262 1110 #uuid "ff98cde1-3450-5181-83f4-c8aa84e70126" 13194139534418 true] [17592186287263 1034 "9" 13194139534418 true] [17592186287263 1103 #edb/ref 17592186045453 13194139534418 true] [17592186287263 1111 #uuid "7b11126c-e054-57bd-9dbc-db1779838a71" 13194139534418 true] [17592186287264 1034 "3" 13194139534