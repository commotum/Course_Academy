on/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-278128"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278129/field-1/8176176719144764d2f15c5f99bef3e2c1fcb6f579218d8792ed82b1cdc532d4" :answer/id #uuid "2e76f4a1-ad4d-5464-bf30-c6ced4cf5fb5" :answer/type :answer.type/math :answer/value "5-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-278129/field-1" :answer-field/id #uuid "aca8e4f9-d78a-515a-b839-7516c4beb3e3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278129/field-1/8176176719144764d2f15c5f99bef3e2c1fcb6f579218d8792ed82b1cdc532d4" :answer-field/choices ["q-278129/field-1/8176176719144764d2f15c5f99bef3e2c1fcb6f579218d8792ed82b1cdc532d4"] :db/ensure [:answer-field/validate]} {:db/id "q-278129/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "7183a1f0-96b3-5873-926b-2980be4850d8" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278129/field-2" :answer-field/id #uuid "85be76ff-0ac7-5f6a-a69f-3739fcdd8c07" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278129/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer-field/choices ["q-278129/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea"] :db/ensure [:answer-field/validate]} {:db/id "q-278129/field-3/6eb084ad90ab80916bda4a9f74ffdf0240dd7c084313f9bc9838389cec8b77ae" :answer/id #uuid "b508f182-a9db-55e3-a898-d2145f511bf1" :answer/type :answer.type/math :answer/value "5+\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-278129/field-3" :answer-field/id #uuid "29a8395e-485d-5b3f-96e4-145fd84646bf" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278129/field-3/6eb084ad90ab80916bda4a9f74ffdf0240dd7c084313f9bc9838389cec8b77ae" :answer-field/choices ["q-278129/field-3/6eb084ad90ab80916bda4a9f74ffdf0240dd7c084313f9bc9838389cec8b77ae"] :db/ensure [:answer-field/validate]} {:db/id "q-278129" :question/id #uuid "70c47212-e259-5395-a1df-846ad8231d3a" :question/math-academy-id "q-278129" :question/problem "Find the exact solution of the inequality $3(x-5)^{4}-4\\ge 23.$\n\n$x\\le ${{field-1}}\n$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "Isolating the quartic-degree term, we find\n\n$$\n\\begin{aligned}3(x-5)^{4}-4 & \\ge 23 \\\\ 3(x-5)^{4} & \\ge 27 \\\\ (x-5)^{4} & \\ge 9.\\end{aligned}\n$$\n\nNow, we take the fourth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[4]{(x-5)^{4}} & \\ge \\sqrt[4]{9} \\\\ |x-5| & \\ge \\sqrt[4]{9}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\nx-5\\ge \\sqrt[4]{9}\\,\\text{or}\\,x-5\\le -\\sqrt[4]{9}\n$$\n\nWe can solve each inequality using the usual methods.\n\n$$\n\\begin{aligned}x-5 & \\ge \\sqrt[4]{9} &  &  & x-5 & \\le -\\sqrt[4]{9} \\\\ x & \\ge \\sqrt[4]{9}+5 &  &  & x & \\le -\\sqrt[4]{9}+5\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\nx\\le -\\sqrt[4]{9}+5\\,\\text{or}\\,x\\ge \\sqrt[4]{9}+5.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-278129/field-1" "q-278129/field-2" "q-278129/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-278129"] :db/ensure [:knowledge-point/validate]}]
