/id #uuid "141c0111-95b5-509e-8f36-83af1691c419" :question/math-academy-id "q-87450" :question/problem "Solve $3(7-4x)^{2}+5<-25.$" :question/worked-solution "Isolating the quadratic term, we get\n\n$$\n\\begin{aligned}3(7-4x)^{2}+5 & <-25 \\\\ 3(7-4x)^{2} & <-30 \\\\ (7-4x)^{2} & <-10\\end{aligned}\n$$\n\nHowever, $(7-4x)^{2}\\ge 0$ for all values of $x$ because the power $(2)$ is even.\n\nTherefore, there is no solution to the given inequality." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-87450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e2463ef2-c276-53cb-a1a1-8601789574d3"] :knowledge-point/questions ["q-87450"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87837/selection/ae65ebca35f6b826f8ce9cb8021000111710f50e63f1ee918a1467206dbead1c" :answer/id #uuid "09a63f88-52ae-54ad-8cc6-ccbacaf00a13" :answer/type :answer.type/math :answer/value "x\\le 7-\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-87837/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer/id #uuid "d18f0790-7080-52b2-8e45-08f0e178bb3a" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id "q-87837/selection/3c3bb4f33d677bd46ec5f4f1650b3a43f0b9cbcf19065eaf1dbf5ea5bd4e1201" :answer/id #uuid "e03d3922-73a3-54ff-87b4-42c46565b817" :answer/type :answer.type/math :answer/value "x\\le -7-\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-87837/selection/98bafb703e8881681adce0bc8183cfd2e95c4591cd3a7132eb4a51d89a40e205" :answer/id #uuid "5471b39d-fd0a-54b0-bee5-34ccdb5bc59b" :answer/type :answer.type/text :answer/value "All real numbers" :db/ensure [:answer/validate]} {:db/id "q-87837/selection/1d9d18551ae1b90761512e583db9c276ea7ab74c6e2563c5a1b2b4b999397aae" :answer/id #uuid "b056cf0d-b443-5eae-a090-488f74283a08" :answer/type :answer.type/math :answer/value "x\\le 2\\sqrt{2}-3" :db/ensure [:answer/validate]} {:db/id "q-87837/selection" :answer-field/id #uuid "0f4fbda1-d267-5ff5-bbaa-e3aaa4bdb668" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87837/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" :answer-field/choices ["q-87837/selection/ae65ebca35f6b826f8ce9cb8021000111710f50e63f1ee918a1467206dbead1c" "q-87837/selection/6d6811ceb4fb69a54ce1b24e6804e5f0148bafa1b76b847b06436eb966d36b67" "q-87837/selection/3c3bb4f33d677bd46ec5f4f1650b3a43f0b9cbcf19065eaf1dbf5ea5bd4e1201" "q-87837/selection/98bafb703e8881681adce0bc8183cfd2e95c4591cd3a7132eb4a51d89a40e205" "q-87837/selection/1d9d18551ae1b90761512e583db9c276ea7ab74c6e2563c5a1b2b4b999397aae"] :db/ensure [:answer-field/validate]} {:db/id "q-87837" :question/id #uuid "aa6ffbb3-3515-5f68-8cab-408046f79305" :question/math-academy-id "q-87837" :question/problem "Solve $2(x+7)^{2}+4\\le -6.$" :question/worked-solution "Isolating the quadratic term, we get\n\n$$\n\\begin{aligned}2(x+7)^{2}+4 & \\le -6 \\\\ 2(x+7)^{2} & \\le -10 \\\\ (x+7)^{2} & \\le -5.\\end{aligned}\n$$\n\nHowever, $(x+7)^{2}\\ge 0$ for all values of $x$ because the power $(2)$ is even.\n\nTherefore, there is no solution to the given inequality." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87837/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e2463ef2-c276-53cb-a1a1-8601789574d3"] :knowledge-point/questions ["q-87837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-87920/selection/175ad253758f6b3f9392d5f654de0b644ebf90895783185529947cb8f7fd2d0d" :answer/id #uuid "5ab8b2e3-3126-59d5-82c7-ed1a4f9618f4" :answer/type :answer.type/math :answer/value "x\\le 2-\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-87920/selection/ca69005043f0fd03dd6ae6584c79d1728d2cf24fa1e5c6d3e4611ea0a0319535" :answer/id #uuid "f489def1-f69a-5d8e-94b4-249daffca6e4" :answer/type :answer.type/math :answer/value "-4-\\sqrt[6]{2}\\le x\\le -4+\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-87920/selection/aea8ab98d0da13daa030cbe1b0bb27b7e2d10270f85c65c4c4162b08b16194cf" :answer/id #uuid "dfef66ab-58a3-5768-9560-670150089ed4" :answer/type :answer.type/text :answer/value "$x\\le -\\sqrt[6]{2}\\,$ or $\\,x\\ge \\sqrt[6]{2}$" :db/ensure [:answer/validate]} {:db/id "q-87920/selection/891c350b878072649646a07cc6d14f3409331bdd45651cf28d842169224d8961" :answer/id #uuid "710883e0-057f-5a52-9117-9e27857af6ec" :answer/type :answer.type/math :answer/value "x\\ge \\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "q-87920/selection/2a93dddfa9c66b1a17f39e7c788d0e398fce638b4266c56518ad0d077cab08d6" :answer/id #uuid "7a8c0a54-4ae1-5e42-9d67-d989e96da0ca" :answer/type :answer.type/text :answer/value "$x\\le 2-\\sqrt[6]{2}\\,$ or $\\,x\\ge 2+\\sqrt[6]{2}$" :db/ensure [:answer/validate]} {:db/id "q-87920/selection" :answer-field/id #uuid "2ee2ada0-24b4-59fa-8068-e2362427df6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87920/selection/2a93dddfa9c66b1a17f39e7c788d0e398fce638b4266c56518ad0d077cab08d6" :answer-field/choices ["q-87920/selection/175ad253758f6b3f9392d5f654de0b644ebf90895783185529947cb8f7fd2d0d" "q-87920/selection/ca69005043f0fd03dd6ae6584c79d1728d2cf24fa1e5c6d3e4611ea0a0319535" "q-87920/selection/aea8ab98d0da13daa030cbe1b0bb27b7e2d10270f85c65c4c4162b08b16194cf" "q-87920/selection/891c350b878072649646a07cc6d14f3409331bdd45651cf28d842169224d8961" "q-87920/selection/2a93dddfa9c66b1a17f39e7c788d0e398fce638b4266c56518ad0d077cab08d6"] :db/ensure [:answer-field/validate]} {:db/id "q-87920" :question/id #uuid "f9ba6f1d-0ad5-5db4-9517-f6b441c8d7ce" :question/math-academy-id "q-87920" :question/problem "Solve the inequality $2(x-2)^{6}-1\\ge 3.$" :question/worked-solution "Isolating the sixth-degree term, we find\n\n$$\n\\begin{aligned}2(x-2)^{6}-1 & \\ge 3 \\\\ 2(x-2)^{6} & \\ge 4 \\\\ (x-2)^{6} & \\ge 2.\\end{aligned}\n$$\n\nNow, we take the sixth root of both sides and get\n\n$$\n\\begin{aligned}\\sqrt[6]{(x-2)^{6}} & \\ge \\sqrt[6]{2} \\\\ |x-2| & \\ge \\sqrt[6]{2}.\\end{aligned}\n$$\n\nThis corresponds to the following compound inequality:\n\n$$\nx-2\\le -\\sqrt[6]{2}\\,\\text{or}\\,x-2\\ge \\sqrt[6]{2}\n$$\n\nSo, the solution is\n\n$$\nx\\le 2-\\sqrt[6]{2}\\,\\text{or}\\,x\\ge 2+\\sqrt[6]{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-87920/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2107f945-7cfa-5abd-a6c1-bf15d5039e6f"] :knowledge-point/questions ["q-87920"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278128/field-1/4b3fbac9147059d8b52a0a09e159113fef16143f543d409a3043eef8f8794efd" :answer/id #uuid "7864dbbc-b959-5f7b-8139-0b4a094b4d38" :answer/type :answer.type/math :answer/value "6-\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "q-278128/field-1/2078d9b693e74e47956393e9430abc459cba6838bceb17c230554d1488e0382e" :answer/id #uuid "0cf2b34b-5e8a-50c4-a5eb-2c063db191a7" :answer/type :answer.type/math :answer/value "6-\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "q-278128/field-1" :answer-field/id #uuid "e10dbd63-027a-547b-8e29-d57eaf432494" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278128/field-1/4b3fbac9147059d8b52a0a09e159113fef16143f543d409a3043eef8f8794efd" :answer-field/choices ["q-278128/field-1/4b3fbac9147059d8b52a0a09e159113fef16143f543d409a3043eef8f8794efd" "q-278128/field-1/2078d9b693e74e47956393e9430abc459cba6838bceb17c230554d1488e0382e"] :db/ensure [:answer-field/validate]} {:db/id "q-278128/field-2/b785f042bcb1e3ac9f1c15e72aea8c54b522212617bb84e48c5ba505bb17b3ea" :answer/id #uuid "57ca85ec-7ca0-590d-81f6-aeca955fba34" :answer/type :answer.type/math :answer/value "\\ge" :db/ensure [:answer/validate]} {:db/id "q-278128/field-2" :answer-field/id #uuid "bf3f1df1-5877-570b-a156-16256403eb3f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278128/field-2/b785f042b