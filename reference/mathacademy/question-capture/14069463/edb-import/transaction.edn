9b6b98884913c41c600790323138d4b3814d6e954b7fe1384ff38" :answer/id #uuid "4218977a-5760-5e34-85f7-1be6c434d037" :answer/type :answer.type/math :answer/value "0.247" :db/ensure [:answer/validate]} {:db/id "q-279626/field-1" :answer-field/id #uuid "b50c249b-0237-5d75-ac45-d7a6951e7c72" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279626/field-1/596b35ddb629b6b98884913c41c600790323138d4b3814d6e954b7fe1384ff38" :answer-field/choices ["q-279626/field-1/596b35ddb629b6b98884913c41c600790323138d4b3814d6e954b7fe1384ff38"] :db/ensure [:answer-field/validate]} {:db/id "q-279626" :question/id #uuid "fbec0407-a14f-535d-94e9-5622f793f938" :question/math-academy-id "q-279626" :question/problem "If $X∼B(7,0.3),$ then, **rounded to $3$ decimal places**, $P(X=1)≈${{field-1}}." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x}){(0.3)}^{x}{(0.7)}^{7-x}.\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}P(X=1) & =f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{1}){(0.3)}^{1}{(0.7)}^{7-1} \\\\  & =7{(0.3)}^{1}{(0.7)}^{6} \\\\  & ≈0.247\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279626/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37fde5f8-b1e8-5903-b875-94b4403cb282"] :knowledge-point/questions ["q-279626"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129971/selection/f22f32a843d143bb4c44bcfa07d056ce3340f6bd19eeb5c9fac562ce194ff2e1" :answer/id #uuid "c5fe4d64-e876-53a8-a0a4-c18010d17887" :answer/type :answer.type/math :answer/value "\\frac{1}{81}" :db/ensure [:answer/validate]} {:db/id "q-129971/selection/21