})}^{0}{(\\frac{1}{2})}^{7}+7{(\\frac{1}{2})}^{1}{(\\frac{1}{2})}^{6}+21{(\\frac{1}{2})}^{2}{(\\frac{1}{2})}^{5} \\\\  & ≈0.227\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & ≈1-0.227 \\\\  & =0.773\\end{aligned}\n$$\n\nrounded to $3$ decimal places." 13194139535687 true] [17592186361184 1000 #edb/ref 17592186361185 13194139535687 true] [17592186361184 1040 #edb/ref 17592186045449 13194139535687 true] [17592186361184 1041 "field-1" 13194139535687 true] [17592186361184 1104 #edb/ref 17592186361185 13194139535687 true] [17592186361184 1110 #uuid "4ae5b5b4-4842-5b3e-8b4e-83d1e9f5e302" 13194139535687 true] [17592186361185 1034 "0.773" 13194139535687 true] [17592186361185 1103 #edb/ref 17592186045453 13194139535687 true] [17592186361185 1111 #uuid "3f9d7644-b5be-5a7b-960b-ad7de7aba74a" 13194139535687 true] [17592186361186 1017 #edb/ref 17592186361187 13194139535687 true] [17592186361186 1089 "q-279981" 13194139535687 true] [17592186361186 1091 #edb/ref 17592186045464 13194139535687 true] [17592186361186 1100 "If $X∼B(6,0.9),$ then, **rounded to $3$ decimal places**, $P(X<5)≈${{field-1}}." 13194139535687 true] [17592186361186 1113 #uuid "0b9ecd4f-c145-54ba-94bf-6399b3176fae" 13194139535687 true] [17592186361186 1145 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.9),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.9)^{x}(0.1)^{6-x}.\n$$\n\nComputing $P(X<5)$ will require us to compute $f(x)$ at $x=0,1,2,3,4.$ However, if we compute the complement $P(X\\ge 5)$ instead, then we will only have to compute $f(x)$ at $x=5,6,$ which will result in a much faster computation.\n\nComputing $P(X\\ge 5),$ we get\n\n$$\n\\begin{aligned}P(X\\ge 5) &