b/ident :answer.type/math} :answer/value "0.3177" :db/id #edb/ref 17592186361212} {:answer/id #uuid "027a5083-fd74-53ae-9d9e-2a78754c0abf" :answer/type {:db/ident :answer.type/math} :answer/value "0.3294" :db/id #edb/ref 17592186361213} {:answer/id #uuid "e0f85b42-268f-5e4c-9a23-fe161328b9ae" :answer/type {:db/ident :answer.type/math} :answer/value "0.2706" :db/id #edb/ref 17592186361214} {:answer/id #uuid "a8b3e9ab-363f-56e1-a939-b03a300481fa" :answer/type {:db/ident :answer.type/math} :answer/value "0.3529" :db/id #edb/ref 17592186361215} {:answer/id #uuid "7801a453-d1b4-5e4f-9438-50a9031e0212" :answer/type {:db/ident :answer.type/math} :answer/value "0.2471" :db/id #edb/ref 17592186361216}] :answer-field/correct {:answer/id #uuid "c3b9e15d-7d9a-51da-9c60-e71df1713e20" :answer/type {:db/ident :answer.type/math} :answer/value "0.3177" :db/id #edb/ref 17592186361212} :answer-field/id #uuid "ab358911-558d-595f-b7ff-069f8a792f40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361211}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "09097867-e4a3-5872-b054-ac19c6e0968e" :question/math-academy-id "q-97469" :question/problem "Given that $X∼B(7,0.7),$ compute $P(X=5).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.7),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.7)^{x}(0.3)^{7-x}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}P(X=5) & =f(5) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{5})(0.7)^{5}(0.3)^{7-5} \\\\  & =21(0.7)^{5}(0.3)^{2} \\\\  & ≈0.3177\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186361217 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af842a20-ebb2-5fdd-8720-1f126adee9f1" :answer/type {:db/ident :answer.type/math} :answer/value "0.227" :db/id #edb/ref 17592186361219} {:answer/id #uuid "d1b72df0-f121-5c1f-b6ae-e1185972a0f9" :answer/type {:db/ident :answer.type/math} :answer/value "0.189" :db/id #edb/ref 17592186361220} {:answer/id #uuid "71ebf976-0cad-5e85-b510-fb3f662d1332" :answer/type {:db/ident :answer.type/math} :answer/value "0.216" :db/id #edb/ref 17592186361221} {:answer/id #uuid "b91fa5a2-ef29-5a68-b9a5-9e1deb4463e3" :answer/type {:db/ident :answer.type/math} :answer/value "0.273" :db/id #edb/ref 17592186361222} {:answer/id #uuid "bb84c7e5-f5e4-5cab-98d4-101aad6aa369" :answer/type {:db/ident :answer.type/math} :answer/value "0.154" :db/id #edb/ref 17592186361223}] :answer-field/correct {:answer/id #uuid "71ebf976-0cad-5e85-b510-fb3f662d1332" :answer/type {:db/ident :answer.type/math} :answer/value "0.216" :db/id #edb/ref 17592186361221} :answer-field/id #uuid "aaa042bb-7e24-580b-a788-279d54808311" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361218}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f656f5f8-5266-5801-8598-ae2960a27fa8" :question/math-academy-id "q-97503" :question/problem "Given that $X∼B(3,0.3),$ compute $P(X\\ge 2).$" :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(3,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{3}{x})(0.3)^{x}(0.7)^{3-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =P(X\\in {2,3}) \\\\  & =f(2)+f(3) \\\\  & =(\\genfrac{}{}{0pt}{}{3}{2})(0.3)^{2}(0.7)^{3-2}+(\\genfrac{}{}{0pt}{}{3}{3})(0.3)^{3}(0.7)^{3-3} \\\\  & =3(0.3)^{2}(0.7)+1(0.3)^{3}(0.7)^{0} \\\\  & =0.216.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361224 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a03ad88-dc53-582c-b2ed-1aeb0ee2d0f5" :knowledge-point/title "Computing a Binomial Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bbdaf8a-40f2-5b1f-bb43-3438e2d2243e" :answer/type {:db/ident :answer.type/math} :answer/value "0.0030" :db/id #edb/ref 17592186361226} {:answer/id #uuid "6a2c3ef0-3fa5-5a21-84c1-ed2e36556119" :answer/type {:db/ident :answer.type/math} :answer/value "0.0084" :db/id #edb/ref 17592186361227} {:answer/id #uuid "1c95acd7-d2ca-5c0c-85db-239033158d7d" :answer/type {:db/ident :answer.type/math} :answer/value "0.0016" :db/id #edb/ref 17592186361228} {:answer/id #uuid "84ab08db-6d25-5bb8-a6be-bd204ee0b9f8" :answer/type {:db/ident :answer.type/math} :answer/value "0.0170" :db/id #edb/ref 17592186361229} {:answer/id #uuid "c23645cc-882a-530c-bede-9492db96d563" :answer/type {:db/ident :answer.type/math} :answer/value "0.0154" :db/id #edb/ref 17592186361230}] :answer-field/correct {:answer/id #uuid "1c95acd7-d2ca-5c0c-85db-239033158d7d" :answer/type {:db/ident :answer.type/math} :answer/value "0.0016" :db/id #edb/ref 17592186361228} :answer-field/id #uuid "b3c6da1e-6e3c-5f4d-b79d-30b2e8618215" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361225}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b5c6c61-2175-57d2-98ea-dd59d2915c7c" :question/math-academy-id "q-97510" :question/problem "Given that $X∼B(6,0.2),$ compute $P(X>4).$" :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.2),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.2)^{x}(0.8)^{6-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(X\\in {5,6}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{5})(0.2)^{5}(0.8)^{6-5}+(\\genfrac{}{}{0pt}{}{6}{6})(0.2)^{6}(0.8)^{6-6} \\\\  & =6(0.2)^{5}(0.8)+1(0.2)^{6}(0.8)^{0} \\\\  & =0.0016.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361231 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b38550-6984-5c18-afba-d5ef1e4142ab" :answer/type {:db/ident :answer.type/math} :answer/value "0.1376" :db/id #edb/ref 17592186361233} {:answer/id #uuid "0249f93f-3ae5-5560-a2c7-ca865ea72bb8" :answer/type {:db/ident :answer.type/math} :answer/value "0.1480" :db/id #edb/ref 17592186361234} {:answer/id #uuid "caea3a73-9878-5286-9296-5fb702167bce" :answer/type {:db/ident :answer.type/math} :answer/value "0.1560" :db/id #edb/ref 17592186361235} {:answer/id #uuid "da8a30e0-674f-5a6b-be1c-7daad5c1b703" :answer/type {:db/ident :answer.type/math} :answer/value "0.1927" :db/id #edb/ref 17592186361236} {:answer/id #uuid "6ef1f418-4644-5a7c-b4a0-fa8c5423f692" :answer/type {:db/ident :answer.type/math} :answer/value "0.0892" :db/id #edb/ref 17592186361237}] :answer-field/correct {:answer/id #uuid "da8a30e0-674f-5a6b-be1c-7daad5c1b703" :answer/type {:db/ident :answer.type/math} :answer/value "0.1927" :db/id #edb/ref 17592186361236} :answer-field/id #uuid "8c3d77f0-7998-5456-9d63-28021ea72744" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361232}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ddfb0f45-b8af-524a-84d2-a0a444691b42" :question/math-academy-id "q-97511" :question/problem "Given $X∼B(8,0.2),$ compute $P(2<X<5).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(8,0.2),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{8}{x})(0.2)^{x}(0.8)^{8-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(2<X<5) & =P(X\\in {3,4}) \\\\  & =f(3)+f(4) \\\\  & =(\\genfrac{}{}{0pt}{}{8}{3})(0.2)^{3}(0.8)^{8-3}+(\\genfrac{}{}{0pt}{}{8}{4})(0.2)^{4}(0.8)^{8-4} \\\\  & =56(0.2)^{3}(0.8)^{5}+70(0.2)^{4}(0.8)^{4} \\\\  & ≈0.1927\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186167448 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7207ec0-e4e9-579c-ae49-42bc9f8c0a76" :answer/type {:db/ident :answer.type/math} :answer/value "0.1319" :db/id #edb/ref 17592186166237} {:answer/id #uuid "ae7bd368-7d18-5d7b-8c6f-c1f10a0ebdb7" :answer/type {:db/ident :answer.type/math} :answer/value "0.0784" :db/id #edb/ref 17592186166238} {:answer/id #uuid "b210e016-9c27-5578-ba81-b1ee8b441137" :answer/type {:db/ident :answer.type/math} :answer/value "0.0988" :db/id #edb/ref 17592186166239} {:answer/id #uuid "d53b957f-3815-555b-a010-c47c40d99255" :answer/type {:db/ident :answer.type/math} :answer/value "0.1523" :db/id #edb/ref 17592186166240} {:answer/id #uuid "0418cfb6-28fa-5383-a119-33982472f0dd" :answer/type {:db/ident :answer.type/math} :answer/value "0.1015" :db/id #edb/ref 17592186166241}] :answer-field/correct {:answer/id #uuid "b210e016-9c27-5578-ba81-b1ee8b441137" :answer/type {:db/ident :answer.type/math} :answer/value "0.0988" :db/id #edb/ref 17592186166239} :answer-field/id #uuid "363a9733-65c4-5ba5-bfe6-61557fb9fc19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166236}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "40d3dc98-bb09-5316-943f-68aa25c6d60a" :question/math-academy-id "q-97516" :question/problem "Given $X∼B(6,0.2),$ compute $P(3\\le X\\le 5).$ Round your final answer to $4$ decimal places." :question/requires-calculator true :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.2),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.2)^{x}(0.8)^{6-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3\\le X\\le 5) & =P(X\\in {3,4,5}) \\\\  & =f(3)+f(4)+f(5) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{3})(0.2)^{3}(0.8)^{6-3}+(\\genfrac{}{}{0pt}{}{6}{4})(0.2)^{4}(0.8)^{6-4}+(\\genfrac{}{}{0pt}{}{6}{5})(0.2)^{5}(0.8)^{6-5} \\\\  & =20(0.2)^{3}(0.8)^{3}+15(0.2)^{4}(0.8)^{2}+6(0.2)^{5}(0.8) \\\\  & ≈0.0988\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186361238 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f98ff81-db37-590b-8910-58928af97f44" :knowledge-point/title "Computing a Probability Over a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4ddc0f0-18ee-5c54-9fed-58526e5513a1" :answer/type {:db/ident :answer.type/math} :answer/value "0.3783" :db/id #edb/ref 17592186361240} {:answer/id #uuid "cbd877e5-7438-52b6-bd3c-a6a18a96881b" :answer/type {:db/ident :answer.type/math} :answer/value "0.4960" :db/id #edb/ref 17592186361241} {:answer/id #uuid "3234ee43-c2ad-5bcd-9f7f-e98b14b18be3" :answer/type {:db/ident :answer.type/math} :answer/value "0.4520" :db/id #edb/ref 17592186361242} {:answer/id #uuid "ddd561ef-5914-5479-ad1c-3dd31cec0a37" :answer/type {:db/ident :answer.type/math} :answer/value "0.3254" :db/id #edb/ref 17592186361243} {:answer/id #uuid "aae0a55a-aacd-5b17-8448-dcdfd9defcfb" :answer/type {:db/ident :answer.type/math} :answer/value "0.4280" :db/id #edb/ref 17592186361244}] :answer-field/correct {:answer/id #uuid "cbd877e5-7438-52b6-bd3c-a6a18a96881b" :answer/type {:db/ident :answer.type/math} :answer/value "0.4960" :db/id #edb/ref 17592186361241} :answer-field/id #uuid "76287ec9-04e3-51b5-ad31-0c438a64ec25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361239}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f819a50-9929-519d-9a3a-6f262e5676fa" :question/math-academy-id "q-97519" :question/problem "Given $X∼B(7,0.9),$ compute $P(5\\le X\\le 6).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.9),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.9)^{x}(0.1)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(5\\le X\\le 6) & =P(X\\in {5,6}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{5})(0.9)^{5}(0.1)^{7-5}+(\\genfrac{}{}{0pt}{}{7}{6})(0.9)^{6}(0.1)^{7-6} \\\\  & =21(0.9)^{5}(0.1)^{2}+7(0.9)^{6}(0.1) \\\\  & ≈0.4960\\end{aligned}\n$$\n\nto $4$ decimal places."}] [{:db/id #edb/ref 17592186361245 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4844e17-9365-5a6f-a5f4-b9fa83fd81e1" :knowledge-point/title "Computing a Probability Over an Interval Using the Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce812fc0-8a8e-56f3-944a-ce3a2ccee787" :answer/type {:db/ident :answer.type/math} :answer/value "0.9375" :db/id #edb/ref 17592186361247} {:answer/id #uuid "937c1936-005c-5008-bb84-ad0e6c918c90" :answer/type {:db/ident :answer.type/math} :answer/value "0.9625" :db/id #edb/ref 17592186361248} {:answer/id #uuid "77b39674-f9f5-520b-bca1-022215c8abf1" :answer/type {:db/ident :answer.type/math} :answer/value "0.9078" :db/id #edb/ref 17592186361249} {:answer/id #uuid "48bc76ca-d585-5051-93c4-95db3e5175e3" :answer/type {:db/ident :answer.type/math} :answer/value "0.9547" :db/id #edb/ref 17592186361250} {:answer/id #uuid "ab9dd68b-0374-5a25-8888-688422ce46a0" :answer/type {:db/ident :answer.type/math} :answer/value "0.9922" :db/id #edb/ref 17592186361251}] :answer-field/correct {:answer/id #uuid "ab9dd68b-0374-5a25-8888-688422ce46a0" :answer/type {:db/ident :answer.type/math} :answer/value "0.9922" :db/id #edb/ref 17592186361251} :answer-field/id #uuid "087a2584-3eb2-50ad-a798-03a456251af1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361246}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ab34ec08-5c79-5227-9a54-244f98a3f56b" :question/math-academy-id "q-97521" :question/problem "Given that $X∼B(7,0.5),$ compute $P(X\\le 6).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.5),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.5)^{x}(0.5)^{7-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in {7}) \\\\  & =f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{7})(0.5)^{7}(0.5)^{7-7} \\\\  & =(0.5)^{7} \\\\  & ≈0.0078\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.0078 \\\\  & =0.9922\\end{aligned}\n$$\n\nrounded to $4$ decimal places."}]}
