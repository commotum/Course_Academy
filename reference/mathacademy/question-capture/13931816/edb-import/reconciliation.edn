/verification.json"}] "sources" [{"question" "q-141537" "field" nil "attribute" "question/problem" "value" "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141537" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5{)}^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5{)}^{2}-9.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141537" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/activity-metadata.json" "file_sha256" "3e2580e130e3316029db96b76a6dfc8a419f7b6adb869cfc483893db3d8a4e12"} {"question" "q-141537" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141537" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(x+10{)}^{2}-5"] ["math" "(x+5{)}^{2}+10"] ["math" "(x+5{)}^{2}+12"] ["math" "(x+5{)}^{2}-7"] ["math" "(x+5{)}^{2}-9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141537" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(x+5{)}^{2}-9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141548" "field" nil "attribute" "question/problem" "value" "Complete the square on the quadratic expression ${y}^{2}+14y+45.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141548" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot 7y+45\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${7}^{2},$ writing the constant term $45$ last:\n\n$$\n{{y}^{2}+2\\cdot 7y+{7}^{2}}_{⏟}-\\,{7}^{2}+45\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y+7{)}^{2}-{7}^{2}+45\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y+7{)}^{2}-4.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/state.json" "file_sha256" "927e24c36de12d5d49faeb08b3fd06aec2b9c2c141da2409514d8598e99d9ded"} {"question" "q-141548" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931816/activity-metadata.json" "file_sha256" "3e2580e130e3316029db96b76a6dfc8a419f7b6adb869cfc483893db3d8a4e