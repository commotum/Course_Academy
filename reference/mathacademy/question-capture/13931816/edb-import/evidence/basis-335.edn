#{[{:db/id #edb/ref 17592186243943 :knowledge-point/_questions [{:knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f123c0-0f3c-5e6e-94d4-316f582388ba" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+12" :db/id #edb/ref 17592186243945} {:answer/id #uuid "67d9db96-79fb-567e-b219-4ec80d3c7361" :answer/type {:db/ident :answer.type/math} :answer/value "(x+10{)}^{2}-5" :db/id #edb/ref 17592186243946} {:answer/id #uuid "71aef8b9-47c4-5d04-967d-9e0f1277df72" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-7" :db/id #edb/ref 17592186243947} {:answer/id #uuid "4eecb7d4-b13a-5ddf-8c35-924b9802b237" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186243948} {:answer/id #uuid "45f66e4e-097f-5e39-8f78-4ed75b923979" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+10" :db/id #edb/ref 17592186243949}] :answer-field/correct {:answer/id #uuid "4eecb7d4-b13a-5ddf-8c35-924b9802b237" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186243948} :answer-field/id #uuid "9286fb67-ba2b-5c5b-94fd-141558ee2200" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243944}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ba0cfb4d-b95f-53bb-bb85-4ea4d8bd37c4" :question/is-example false :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5{)}^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5{)}^{2}-9.\n$$"}] [{:db/id #edb/ref 17592186243950 :knowledge-point/_questions [{:knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6273f3ea-6c25-5318-8dd5-dd0dbcfea598" :answer/type {:db/ident :answer.type/math} :answer/value "(y+7{)}^{2}+8" :db/id #edb/ref 17592186243952} {:answer/id #uuid "d27e9383-c0a3-5a04-96bc-1652cf341228" :answer/type {:db/ident :answer.type/math} :answer/value "(y+14{)}^{2}-3" :db/id #edb/ref 17592186243953} {:answer/id #uuid "f0ea9da7-e30e-5564-b1bd-8e95d6c4d81c" :answer/type {:db/ident :answer.type/math} :answer/value "(y+7{)}^{2}+4" :db/id #edb/ref 17592186243954} {:answer/id #uuid "38979c67-6fae-57b4-b8c4-b837b0a5fea5" :answer/type {:db/ident :answer.type/math} :answer/value "(y+7{)}^{2}-4" :db/id #edb/ref 17592186243955} {:answer/id #uuid "93cd80f2-6d5e-53a5-9e9d-8dff371b24ec" :answer/type {:db/ident :answer.type/math} :answer/value "(y+14{)}^{2}-7" :db/id #edb/ref 17592186243956}] :answer-field/correct {:answer/id #uuid "38979c67-6fae-57b4-b8c4-b837b0a5fea5" :answer/type {:db/ident :answer.type/math} :answer/value "(y+7{)}^{2}-4" :db/id #edb/ref 17592186243955} :answer-field/id #uuid "64e1610b-06dc-54de-961a-e0a5da572576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243951}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6466d94a-3ecb-5389-a7c1-d07dbd24137f" :question/is-example false :question/math-academy-id "q-141548" :question/problem "Complete the square on the quadratic expression ${y}^{2}+14y+45.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot 7y+45\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${7}^{2},$ writing the constant term $45$ last:\n\n$$\n{{y}^{2}+2\\cdot 7y+{7}^{2}}_{⏟}-\\,{7}^{2}+45\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y+7{)}^{2}-{7}^{2}+45\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y+7{)}^{2}-4.\n$$"}] [{:db/id #edb/ref 17592186243957 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77620eca-ae88-50dd-9b37-cafb3461cdbb" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2{)}^{2}-4" :db/id #edb/ref 17592186243959} {:answer/id #uuid "0b5617e8-0462-52f7-8a41-b282bbf335dd" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+3" :db/id #edb/ref 17592186243960} {:answer/id #uuid "a1b9e4f7-0e60-53fd-992c-06a82b74cd66" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186243961} {:answer/id #uuid "612169d2-4291-5b66-9257-edcb83ebe0b7" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+5" :db/id #edb/ref 17592186243962} {:answer/id #uuid "01bfeb2e-cb54-5c39-a1ee-596fb7660376" :answer/type {:db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+1" :db/id #edb/ref 17592186243963}] :answer-field/correct {:answer/id #uuid "a1b9e4f7-0e60-53fd-992c-06a82b74cd66" :answer/type {:db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186243961} :answer-field/id #uuid "2c21a689-ac10-5859-bfb7-5acb2b423be5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243958}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26365c57-2b9e-5740-9cc2-6b6c0a4f5d77" :question/is-example false :question/math-academy-id "q-141612" :question/problem "Complete the square on the quadratic expression ${y}^{2}-4y+10.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 2y+10\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${2}^{2},$ writing the constant term $10$ last:\n\n$$\n{{y}^{2}-2\\cdot 2y+{2}^{2}}_{⏟}-\\,{2}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-2{)}^{2}-{2}^{2}+10\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-2{)}^{2}+6.\n$$"}] [{:db/id #edb/ref 17592186243964 :knowledge-point/_questions [{:knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7120ee9e-6161-5b50-833f-95ed8c761ff9" :answer/type {:db/ident :answer.type/math} :answer/value "x-4" :db/id #edb/ref 17592186243966}] :answer-field/correct {:answer/id #uuid "7120ee9e-6161-5b50-833f-95ed8c761ff9" :answer/type {:db/ident :answer.type/math} :answer/value "x-4" :db/id #edb/ref 17592186243966} :answer-field/id #uuid "a24459a0-9d04-5b69-9e54-163c9dd8e320" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186243965} {:answer-field/choices [{:answer/id #uuid "0a027bc2-5783-5794-a2b5-759cc27f74fa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186243968}] :answer-field/correct {:answer/id #uuid "0a027bc2-5783-5794-a2b5-759cc27f74fa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186243968} :answer-field/id #uuid "b23ac193-102a-5a4f-aa9f-d4ee1c56d332" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186243967}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b4e54afd-2abe-5a88-9ee5-e6a69b0457db" :question/is-example false :question/math-academy-id "q-235868" :question/problem "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}-8x+16)+5=(${{field-1}}${)}^{2}\\,+$\n{{field-2}}" :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-8x+16 & = \\\\ {x}^{2}-2\\cdot 4x+{4}^{2} & = \\\\ (x-4{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-8x+16)+5 & = \\\\ (x-4{)}^{2}+5 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186243969 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b868bb8d-6c3c-51cf-9698-cf3a7a2b66d1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186243971}] :answer-field/correct {:answer/id #uuid "b868bb8d-6c3c-51cf-9698-cf3a7a2b66d1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186243971} :answer-field/id #uuid "9becf198-6dc5-5b25-a7ce-56ad390e4099" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186243970} {:answer-field/choices [{:answer/id #uuid "37b2f258-6637-50b4-a215-a239625f81d6" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186243973}] :answer-field/correct {:answer/id #uuid "37b2f258-6637-50b4-a215-a239625f81d6" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186243973} :answer-field/id #uuid "9b642f8e-a43d-5b26-834b-489394c49391" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186243972}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cf9fb661-19c7-51e6-ac0f-2fa500a29101" :question/is-example false :question/math-academy-id "q-250517" :question/problem "If the expression ${x}^{2}-10x$ is written as $(x-p{)}^{2}+q$, then what are the values of $p$ and $q?$\n\n$p=$\n{{field-1}},\n$\\,q=$\n{{field-2}}" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 5x+0\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $0$ last:\n\n$$\n{{x}^{2}-2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+0\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-5{)}^{2}-{5}^{2}+0\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x-5{)}^{2}-25\n$$\n\nTherefore, $p=5$ and $q=-25.$"}]}
