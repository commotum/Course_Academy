igin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{81}=9.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{9}{4}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316959/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0"] :knowledge-point/questions ["q-316959"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116551/selection/b31cecd316b6911ea5bd89055bbcc24f3ec86cd0a194a857d1c1b4737b8bb606" :answer/id #uuid "4e75f933-f9b1-5fa5-a31b-b9760fc9dfe2" :answer/type :answer.type/math :answer/value "y=\\pm 4x" :db/ensure [:answer/validate]} {:db/id "q-116551/selection/dfa22627faed2431b36a36658ca504deb4aaeec75903f8094d9adeeada073a19" :answer/id #uuid "5d2ba3c5-00a3-5eb4-857f-af544e73a629" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{\\sqrt{6}}{6}x" :db/ensure [:answer/validate]} {:db/id "q-116551/selection/c94c7e51cb6d69ceaff458169e7f9d7a19a52b2f52709b8d98309d414a16bdad" :answer/id #uuid "cd889eb4-9b00-5f9a-99af-b1ed6e908dc8" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{1}{4}x" :db/ensure [:answer/validate]} {:db/id "q-116551/selection/14eccf8a242f0d8f0178f9b363c4d696262f7524f235db4f37f2e8d2f72a7291" :answer/id #uuid "a996ac98-695e-5b66-a3e5-422f14627b85" :answer/type :answer.type/math :answer/value "y=\\pm 2x" :db/ensure [:answer/validate]} {:db/id "q-116551/selection/456331d6bb324a86c6366cc6322928c90711ff2a82e9426366dd2cb9ceda61dc" :answer/id #uuid "26ab6cc3-af21-5b70-9db5-c763d32abf0e" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{1}{2}x" :db/ensure [:answer/validate]} {:db/id "q-116551/selection" :answer-field/id #uuid "6c61aeab-e3a6-5be0-9545-69b8e92984cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116551/selection/14eccf8a242f0d8f017