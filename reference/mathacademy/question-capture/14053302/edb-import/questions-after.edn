estions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b9fee9c-774a-58e9-a85a-c4a4a072c923" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 9x" :db/id #edb/ref 17592186330605} {:answer/id #uuid "ae509c9c-eea8-52c4-a40b-b24bb6862267" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{2}}{3}x" :db/id #edb/ref 17592186330606} {:answer/id #uuid "7fae46d4-e12e-5ca1-98d6-4cca1ffcd1f0" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 3x" :db/id #edb/ref 17592186330607} {:answer/id #uuid "d1eda4e6-8c72-55db-8c57-ddf5db12c024" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{9}x" :db/id #edb/ref 17592186330608} {:answer/id #uuid "a6ed1d1a-7c6f-5eff-9f7d-82eba046ace4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{3}x" :db/id #edb/ref 17592186330609}] :answer-field/correct {:answer/id #uuid "7fae46d4-e12e-5ca1-98d6-4cca1ffcd1f0" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 3x" :db/id #edb/ref 17592186330607} :answer-field/id #uuid "25833d02-8533-57ac-9ada-e8b9c591961d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330604}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "29f2e5ed-5638-5a21-8d8c-29f74f6d22cf" :question/math-academy-id "q-116557" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{18}-\\frac{{x}^{2}}{2}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{18}=3\\sqrt{2},\\,b=\\sqrt{2}.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{3\\sqrt{2}}{\\sqrt{2}}x \\\\  & =\\pm 3x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330610 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9197927a-abf7-5c6f-b424-9f41eb181170" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}x" :db/id #edb/ref 17592186330612}] :answer-field/correct {:answer/id #uuid "9197927a-abf7-5c6f-b424-9f41eb181170" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}x" :db/id #edb/ref 17592186330612} :answer-field/id #uuid "c85402c4-8fe9-56b3-8f7e-0d117b8088f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330611}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f4cac527-4113-5c18-a45a-55b52b11acd6" :question/math-academy-id "q-316342" :question/problem "The asymptotes of the hyperbola $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{49}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{4}=2,\\,b=\\sqrt{49}=7.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{7}{2}x \\\\  & =\\pm \\frac{7}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330613 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc821cd4-56ef-589b-b902-a2913bf2522e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{7}x" :db/id #edb/ref 17592186330615} {:answer/id #uuid "ed6d8529-3039-5dcf-b049-623bd4e7fd82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}x" :db/id #edb/ref 17592186330616}] :answer-field/correct {:answer/id #uuid "bc821cd4-56ef-589b-b902-a2913bf2522e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{7}x" :db/id #edb/ref 17592186330615} :answer-field/id #uuid "1f916b28-a2b2-5d1f-8da1-0944caa29a1a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330614}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "22207d4a-7170-5907-84c8-3410385aa793" :question/math-academy-id "q-316483" :question/problem "The asymptotes of the hyperbola $\\frac{{x}^{2}}{49}-\\frac{{y}^{2}}{12}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{49}=7,\\,b=\\sqrt{12}=2\\sqrt{3}.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{2\\sqrt{3}}{7}x.$"}] [{:db/id #edb/ref 17592186330617 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0f6c46f-22e8-504e-b9a7-ab4dea215239" :answer/type {:db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186330619}] :answer-field/correct {:answer/id #uuid "b0f6c46f-22e8-504e-b9a7-ab4dea215239" :answer/type {:db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186330619} :answer-field/id #uuid "4a149a58-d22d-5f16-86ff-badb73cd6a04" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330618}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "076f696e-37aa-598d-9e8d-acdf3e7b026a" :question/math-academy-id "q-316506" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{36}-\\frac{{x}^{2}}{4}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{36}=6,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{6}{2}x \\\\  & =\\pm 3x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330620 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b79ec82a-19e5-5c35-9748-8b3e3d2fdce9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}x" :db/id #edb/ref 17592186330622}] :answer-field/correct {:answer/id #uuid "b79ec82a-19e5-5c35-9748-8b3e3d2fdce9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}x" :db/id #edb/ref 17592186330622} :answer-field/id #uuid "c023e27d-0697-5e56-9631-a075d0105484" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330621}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a9dee5e2-9b78-5b62-a5a4-664e0882321f" :question/math-academy-id "q-316934" :question/problem "The asymptotes of the hyperbola $8{x}^{2}-50{y}^{2}=400$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $400$ and then simplify, as follows:\n\n$$\n\\begin{aligned}8{x}^{2}-50{y}^{2} & =400 \\\\ \\frac{8{x}^{2}}{400}-\\frac{50{y}^{2}}{400} & =\\frac{400}{400} \\\\ \\frac{{x}^{2}}{50}-\\frac{{y}^{2}}{8} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{50}$ and $b=\\sqrt{8}.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{8}}{\\sqrt{50}}x \\\\  & =\\pm \\frac{2\\sqrt{2}}{5\\sqrt{2}}x \\\\  & =\\pm \\frac{2}{5}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330623 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90de5a26-0670-5116-be4a-52b88948bb8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}x" :db/id #edb/ref 17592186330625}] :answer-field/correct {:answer/id #uuid "90de5a26-0670-5116-be4a-52b88948bb8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}x" :db/id #edb/ref 17592186330625} :answer-field/id #uuid "6f2957b4-c382-5ad4-a03d-5f08a1cf016b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330624}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "04d57fc4-cc71-576b-b6ac-65013f6fe99e" :question/math-academy-id "q-316942" :question/problem "The asymptotes of the hyperbola ${x}^{2}-2{y}^{2}=8$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $8$ and then simplify, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-2{y}^{2} & =8 \\\\ \\frac{{x}^{2}}{8}-\\frac{2{y}^{2}}{8} & =\\frac{8}{8} \\\\ \\frac{{x}^{2}}{8}-\\frac{{y}^{2}}{4} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{8}$ and $b=\\sqrt{4}=2.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{2}{\\sqrt{8}}x \\\\  & =\\pm \\frac{2}{2\\sqrt{2}}x \\\\  & =\\pm \\frac{1}{\\sqrt{2}}x \\\\  & =\\pm \\frac{\\sqrt{2}}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330626 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12587323-86ba-53a2-aeb9-0efebf9e5157" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}x" :db/id #edb/ref 17592186330628}] :answer-field/correct {:answer/id #uuid "12587323-86ba-53a2-aeb9-0efebf9e5157" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}x" :db/id #edb/ref 17592186330628} :answer-field/id #uuid "363032fb-906f-5c68-9cc2-dffcbf3dc8e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330627}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f90bf5d6-79ca-551e-9f5b-1ad1529fdef5" :question/math-academy-id "q-316959" :question/problem "The asymptotes of the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{81}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{81}=9.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{9}{4}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330629 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a51d73b-58c9-57fc-b200-825915834004" :answer/type {:db/ident :answer.type/math} :answer/value "5x" :db/id #edb/ref 17592186330631} {:answer/id #uuid "93af386e-8735-5b32-b2f5-ef2606875efc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}x" :db/id #edb/ref 17592186330632}] :answer-field/correct {:answer/id #uuid "93af386e-8735-5b32-b2f5-ef2606875efc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}x" :db/id #edb/ref 17592186330632} :answer-field/id #uuid "9fb2cbfa-9dbb-59dc-836f-e963cbae97d3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330630}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5965a1ab-365c-593b-8311-3ccd4428a7fb" :question/math-academy-id "q-316963" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{100}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{4}=2,\\,b=\\sqrt{100}=10.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{2}{10}x \\\\  & =\\pm \\frac{1}{5}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330633 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635}] :answer-field/correct {:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635} :answer-field/id #uuid "22250f67-3925-51fe-97c6-335c7eee5241" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330634}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f68d254f-bdd5-5c65-9cd4-cfe81ad88b23" :question/math-academy-id "q-316965" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{36}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{36}=6.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{4}{6}x \\\\  & =\\pm \\frac{2}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330636 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6a5746a-33a6-572e-8537-f35a0fe291fc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{4}x" :db/id #edb/ref 17592186330638} {:answer/id #uuid "5aecc861-2c55-5a18-9f4f-bb13b58d5de1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186330639} {:answer/id #uuid "691de324-2dbb-5042-aecf-654108b4514e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{2}x" :db/id #edb/ref 17592186330640} {:answer/id #uuid "116e4da2-3657-55f5-9113-12d1bf0a9439" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186330641} {:answer/id #uuid "f6f47ac3-c62e-5468-a2b4-64fcd86123ea" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186330642}] :answer-field/correct {:answer/id #uuid "116e4da2-3657-55f5-9113-12d1bf0a9439" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186330641} :answer-field/id #uuid "2a03dbb9-7255-55d7-a825-a78a34648f7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330637}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f2159ba5-4937-5e1b-95b6-5511a83203aa" :question/math-academy-id "q-7973" :question/problem "Calculate the asymptotes of the hyperbola $25{x}^{2}-4{y}^{2}=100.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $100$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-4{y}^{2} & =100 \\\\ \\frac{25{x}^{2}}{100}-\\frac{4{y}^{2}}{100} & =\\frac{100}{100} \\\\ \\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{4}=2,$ and $b=\\sqrt{25}=5.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{5}{2}x.$"}] [{:db/id #edb/ref 17592186330643 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51e077dd-de0c-5b47-87d2-109fe8974023" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186330645} {:answer/id #uuid "7eb55387-fd0b-5750-ae9e-5e83e8811bb8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{5}x" :db/id #edb/ref 17592186330646} {:answer/id #uuid "8fa4402e-7edb-50be-a242-304c11e8456d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186330647} {:answer/id #uuid "28ea1c25-d9d6-50cf-b252-2efb120d000d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186330648} {:answer/id #uuid "a6ef0a70-c2dc-598d-90e2-476419bc2fd6" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{8}x" :db/id #edb/ref 17592186330649}] :answer-field/correct {:answer/id #uuid "51e077dd-de0c-5b47-87d2-109fe8974023" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186330645} :answer-field/id #uuid "7cc80fba-216c-5094-9c66-4f0f64d3d0fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330644}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2f6002f1-8240-53b8-b0d9-a0d60eeea0ad" :question/math-academy-id "q-7975" :question/problem "Find the asymptotes of the hyperbola $25{x}^{2}-16{y}^{2}=400.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $400$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-16{y}^{2} & =400 \\\\ \\frac{25{x}^{2}}{400}-\\frac{16{y}^{2}}{400} & =\\frac{400}{400} \\\\ \\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{16}=4,$ and $b=\\sqrt{25}=5.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{5}{4}x.$"}] [{:db/id #edb/ref 17592186330650 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2d83ce9-b436-5e97-84c2-1da6cfcb9872" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330652} {:answer/id #uuid "528cd1e8-f76c-5c70-9e68-402f1922f6d3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330653} {:answer/id #uuid "80dd4a89-fe29-5eae-bed4-da4339d07b9f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm x" :db/id #edb/ref 17592186330654} {:answer/id #uuid "50bc15a8-8c0b-5f5a-8ce6-7919569a238a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330655} {:answer/id #uuid "41fba7c4-3b0e-5396-9685-9aaa92da4b16" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330656}] :answer-field/correct {:answer/id #uuid "c2d83ce9-b436-5e97-84c2-1da6cfcb9872" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330652} :answer-field/id #uuid "589fa5fd-012f-58ac-8d65-a8bf7273e297" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "281750f4-143d-5774-af34-51dfba3c9462" :question/math-academy-id "q-8063" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{16}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{4}=2,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{4}{2}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}]}
