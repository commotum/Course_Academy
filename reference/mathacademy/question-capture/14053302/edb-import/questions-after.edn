#{[{:db/id #edb/ref 17592186087485 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/id #uuid "f81dc1a8-36bf-5918-b702-2d37000a0457" :question/math-academy-id "e-5356" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{y^2}{9} - \\dfrac{x^2}{16} = 1$." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\dfrac{y^2}{a^2} - \\dfrac{x^2}{b^2} = 1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{a}{b} x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{9} = 3, \\qquad b=\\sqrt{16} = 4.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y = \\pm \\dfrac{3}{4}x.$"}] [{:db/id #edb/ref 17592186087486 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/id #uuid "87c1fed0-66fa-5b7d-b79d-80e96074321e" :question/math-academy-id "e-5357" :question/problem "Calculate the asymptotes of the hyperbola $25 x ^ 2 - 9 y ^ 2 = 225$." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $225$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-9{y}^{2} & =225 \\\\ \\frac{25{x}^{2}}{225}-\\frac{9{y}^{2}}{225} & =\\frac{225}{225} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt 9 = 3,$ and $b=\\sqrt{25} = 5.$ \n\nTherefore, the asymptotes are $y=\\pm \\dfrac{5}{3}x.$"}] [{:db/id #edb/ref 17592186087566 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/id #uuid "4d9f0ed4-18fd-54bd-8dcc-dd7753cd4963" :question/math-academy-id "e-7426" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{x^2}{36} - \\dfrac{y^2}{9} = 1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{36} = 6, \\qquad b=\\sqrt9 =3.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{6}x \\\\  & =\\pm \\frac{1}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330582 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "550331cc-78ee-5514-9274-998b66893dee" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330584} {:answer/id #uuid "d1bce329-c888-5229-a373-c51aa08e4e3d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{8}x" :db/id #edb/ref 17592186330585} {:answer/id #uuid "f271a036-4f2d-5c54-8bcc-f1540a6244de" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330586} {:answer/id #uuid "71886ca9-99f9-5a5a-9062-78a6d1ab45e0" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330587} {:answer/id #uuid "5e0109ca-28f6-596d-8b38-36d919d5bb63" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330588}] :answer-field/correct {:answer/id #uuid "f271a036-4f2d-5c54-8bcc-f1540a6244de" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330586} :answer-field/id #uuid "25ada346-f878-597f-a7e8-81bb9c6c900a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330583}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9fcb18e8-910f-5b7c-98a3-6b4f318059b7" :question/math-academy-id "q-10431" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{16}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{4}=2,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{2}{4}x \\\\  & =\\pm \\frac{1}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330589 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66be9136-af9b-5c92-8d7d-a1c31594ce60" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186330591} {:answer/id #uuid "a093cfa3-3391-523f-8397-48dabe257ec4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{5}x" :db/id #edb/ref 17592186330592} {:answer/id #uuid "0b9f139d-6461-5109-ba48-24b4ca43bb7e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186330593} {:answer/id #uuid "ea75e433-8e4f-5263-afc8-72acf344a876" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{5}x" :db/id #edb/ref 17592186330594} {:answer/id #uuid "c9952422-7a05-50ae-8d48-1ebbf7e208dc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186330595}] :answer-field/correct {:answer/id #uuid "c9952422-7a05-50ae-8d48-1ebbf7e208dc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186330595} :answer-field/id #uuid "9b8450b2-1550-553a-a5ee-c1fef0345278" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330590}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c2298c2d-1cc7-5059-b3d0-866163071a02" :question/math-academy-id "q-10438" :question/problem "Find the asymptotes of the hyperbola $25{y}^{2}-4{x}^{2}=100.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $100$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{y}^{2}-4{x}^{2} & =100 \\\\ \\frac{25{y}^{2}}{100}-\\frac{4{x}^{2}}{100} & =\\frac{100}{100} \\\\ \\frac{{y}^{2}}{4}-\\frac{{x}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{4}=2$ and $b=\\sqrt{25}=5.$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{2}{5}x.$"}] [{:db/id #edb/ref 17592186330596 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a996ac98-695e-5b66-a3e5-422f146