35 \\\\  & =0.35\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/eba791c99c1b4706275f353ca221cdad5e535b508e57346e28fa18a372a080ee.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap {B}^{′})=0.45.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264071" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264071" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264071" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.45"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-120380" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=0.5,$ $P(B)=0.3,$ and $P(A\\cup B)=0.7,$ find $P({A}^{′}\\cup B).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-120380" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.7 & =0.5+0.3-P(A\\cap B) \\\\ P(A\\cap B) & =0.5+0.3-0.7 \\\\ P(A\\cap B) & =0.1\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/14e573701578699d9c0fa5c0aa8f97d2c20fc916e867d0c89d3fe1256feccf69.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=0.1+0.2+0.3=0.6.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-120380" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-120380" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-120380" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.3"] ["math" "0.4"] ["math" "0.5"] ["math" "0.6"] ["math" "0.7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-120380" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-178681" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=0.4,$ $P(B)=0.3,$ and $P(A\\cap B)=0.1,$ find $P({A}^{′}\\cup B).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-178681" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =0.4+0.3-0.1 \\\\  & =0.6\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/e3fecd795207853d1a17a3e23c0d2872a59fde1c0561b8e357aae4a1705ca651.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=0.1+0.2+0.4=0.7.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-178681" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-178681" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-178681" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.5"] ["math" "0.6"] ["math" "0.7"] ["math" "0.8"] ["math" "0.9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-178681" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.7"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264077" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=\\frac{1}{4},$ $P(B)=\\frac{1}{6},$ and $P(A\\cap B)=\\frac{1}{12},$ find $P({A}^{′}\\cup B).$ Do not round your answer.\n\n$P({A}^{′}\\cup B)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264077" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =\\frac{1}{4}+\\frac{1}{6}-\\frac{1}{12} \\\\  & =\\frac{3}{12}+\\frac{2}{12}-\\frac{1}{12} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/0c8d9572472da406cf84f5657d0ea47d0d1ba76592c98d4e6f442ecb9ef03dec.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=\\frac{1}{12}+\\frac{1}{12}+\\frac{2}{3}=\\frac{5}{6}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264077" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264077" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264077" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{6}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264413" "field" nil "attribute" "question/problem" "value" "Given that $P(B)=\\frac{2}{5},$ $P(A\\cap B)=\\frac{1}{3},$ and $P(A\\cup B)=\\frac{5}{6},$ find $P({A}^{′}\\cup {B}^{′}).$ Do not round your answer.\n\n$P({A}^{′}\\cup {B}^{′})=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264413" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{5}{6} & =P(A)+\\frac{2}{5}-\\frac{1}{3} \\\\ P(A) & =\\frac{5}{6}+\\frac{1}{3}-\\frac{2}{5} \\\\  & =\\frac{25}{30}+\\frac{10}{30}-\\frac{12}{30} \\\\  & =\\frac{23}{30}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/4b5f335b449e5f07de1d9ac1590245e71f6825b2dc13fe4ba046985aac95465a.png)\n\nFinally, we have\n\n$$\n\\begin{aligned}P({A}^{′}\\cup {B}^{′}) & =\\frac{13}{30}+\\frac{1}{15}+\\frac{1}{6} \\\\  & =\\frac{13}{30}+\\frac{2}{30}+\\frac{5}{30} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264413" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264413" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264413" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264409" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=0.6,$ $P(B)=0.5,$ and $P(A\\cup B)=0.8,$ find $P({A}^{′}\\cup {B}^{′}).$\n\n$P({A}^{′}\\cup {B}^{′})=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264409" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.8 & =0.6+0.5-P(A\\cap B) \\\\ P(A\\cap B) & =0.6+0.5-0.8 \\\\  & =0.3\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/7ed0c9bf5b752eeffcd869d1b511d9ff65ca7cbbc6f5d85a38012b5ba57460d0.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup {B}^{′})=0.3+0.2+0.2=0.7.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264409" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264409" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264409" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264419" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=0.6,$ $P(A\\cap B)=0.25,$ and $P(A\\cup B)=0.95,$ find $P({B}^{′}).$\n\n$P({B}^{′})=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264419" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.95 & =0.6+P(B)-0.25 \\\\ P(B) & =0.95+0.25-0.6 \\\\  & =0.6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-0.6 \\\\  & =0.4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264419" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264419" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264419" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264415" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=0.35,$ $P(A\\cap B)=0.15,$ and $P(A\\cup B)=0.9,$ find $P({B}^{′}).$\n\n$P({B}^{′})=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264415" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.9 & =0.35+P(B)-0.15 \\\\ P(B) & =0.9+0.15-0.35 \\\\  & =0.7\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-0.7 \\\\  & =0.3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264415" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264415" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264415" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-179528" "field" nil "attribute" "question/problem" "value" "Given that $P(B)=0.7,$ $P(A\\cap B)=0.3,$ and $P(A\\cup B)=0.9,$ find $P({A}^{′}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-179528" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.9 & =P(A)+0.7-0.3 \\\\ P(A) & =0.9+0.3-0.7 \\\\ P(A) & =0.5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}^{′}) & =1-P(A) \\\\  & =1-0.5 \\\\  & =0.5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-179528" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-179528" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-179528" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.1"] ["math" "0.4"] ["math" "0.5"] ["math" "0.6"] ["math" "0.8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-179528" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264425" "field" nil "attribute" "question/problem" "value" "Given that $P(A)=\\frac{1}{3},$ $P(A\\cap B)=\\frac{1}{7},$ and $P(A\\cup B)=\\frac{8}{9},$ find $P({B}^{′}).$ Do not round your answer.\n\n$P({B}^{′})=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264425" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{8}{9} & =\\frac{1}{3}+P(B)-\\frac{1}{7} \\\\ P(B) & =\\frac{8}{9}+\\frac{1}{7}-\\frac{1}{3} \\\\  & =\\frac{44}{63}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-\\frac{44}{63} \\\\  & =\\frac{19}{63}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264425" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/activity-metadata.json" "file_sha256" "4a414690e6e50037ea09c3d4dc9545c576a8c81540fafb44a526ed48adab5928"} {"question" "q-264425" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/state.json" "file_sha256" "e68717936bd031d5cfb04580bbe25be74a3e32a5bf1d18a9520f1fe92863851a"} {"question" "q-264425" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{19}{63}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/matha