ac{9}{20}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/b39a37400a7831f642cd6fe1d71db3c518fd348531a09ebc9d601586ed44afa5.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap B)=\\frac{3}{10}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-179490/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509"] :knowledge-point/questions ["q-179490"] :db/ensure [:knowledge-point/validate]} {:db/id "q-264071/field-1/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2" :answer/id #uuid "ba440c8b-88f6-53c2-b6e8-a350d11c1f07" :answer/type :answer.type/math :answer/value "0.45" :db/ensure [:answer/validate]} {:db/id "q-264071/field-1" :answer-field/id #uuid "9cebe3c3-751b-5032-a512-8f20e1605657" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-264071/field-1/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2" :answer-field/choices ["q-264071/field-1/bd0c5293c05dbcd56341c67931e9e0ae46e20e1d0de3da140e1b2dcd87ea42e2"] :db/ensure [:answer-field/validate]} {:db/id "q-264071" :question/id #uuid "0377c870-d9a8-59c3-896d-da450e18532c" :question/math-academy-id "q-264071" :question/problem "Given that $P(A)=0.35,$ $P(A\\cap B)=0.15,$ and $P(A\\cup B)=0.55,$ find $P({A}^{′}\\cap {B}^{′}).$\n\n$P({A}^{′}\\cap {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.55 & =0.35+P(B)-0.15 \\\\ P(B) & =0.55+0.15-0.35 \\\\  & =0.35\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/eba791c99c1b4706275f353ca221cdad5e535b508e57346e28fa18a372a080ee.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap {B}^{′})=0.45.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-264071/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509"] :knowledge-point/questions ["q-264071"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120380/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" :answer/id #uuid "85108317-0e0c-5754-8d3f-c1cf28245c8b" :answer/type :answer.type/math :answer/value "0.6" :db/ensure [:answer/validate]} {:db/id "q-120380/selection/47e062f84c7679179a100f841000c1550fcbc886f881ad4b3253348673d23026" :answer/id #uuid "e3a2198d-a0de-5f61-8913-352aaceaafdc" :answer/type :answer.type/math :answer/value "0.4" :db/ensure [:answer/validate]} {:db/id "q-120380/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "c7a7080f-6088-5dee-bb0f-e3ec4a1c7f51" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-120380/selection/57f1df4deeb63ac8b169c1392105cc1ec886c4a882da47e1d3a4a61ab32f1e2a" :answer/id #uuid "4acc3406-4d3c-517f-a6a9-ca1de5d7a8db" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "q-120380/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "835d9ea6-5037-52bf-8833-7e880a957f5c" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-120380/selection" :answer-field/id #uuid "1656c7a3-54a8-5ab1-8ab7-3fa4753b5a74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120380/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" :answer-field/choices ["q-120380/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" "q-120380/selection/47e062f84c7679179a100f841000c1550fcbc886f881ad4b3253348673d23026" "q-120380/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" "q-120380/selection/57f1df4deeb63ac8b169c1392105cc1ec886c4a882da47e1d3a4a61ab32f1e2a" "q-120380/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c"] :db/ensure [:answer-field/validate]} {:db/id "q-120380" :question/id #uuid "7e0fa3a1-48dc-5589-ad80-81b37d1c3742" :question/math-academy-id "q-120380" :question/problem "Given that $P(A)=0.5,$ $P(B)=0.3,$ and $P(A\\cup B)=0.7,$ find $P({A}^{′}\\cup B).$" :question/worked-solution "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.7 & =0.5+0.3-P(A\\cap B) \\\\ P(A\\cap B) & =0.5+0.3-0.7 \\\\ P(A\\cap B) & =0.1\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/14e573701578699d9c0fa5c0aa8f97d2c20fc916e867d0c89d3fe1256feccf69.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=0.1+0.2+0.3=0.6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-120380/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1"] :knowledge-point/questions ["q-120380"] :db/ensure [:knowledge-point/validate]} {:db/id "q-178681/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "7d0801c9-297b-5bf2-859a-4a9dadaa3251" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-178681/selection/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "a28b4b29-7b16-55b1-9658-122b0103a806" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-178681/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" :answer/id #uuid "303b816f-884c-579e-9726-7d5c8