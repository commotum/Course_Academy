+0.3=0.6.\n$$"}] [{:db/id #edb/ref 17592186311562 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "303b816f-884c-579e-9726-7d5c85ca6b7a" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186311564} {:answer/id #uuid "a28b4b29-7b16-55b1-9658-122b0103a806" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186311565} {:answer/id #uuid "2e8b2700-e01f-531e-a2ff-c84d068d7b27" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186311566} {:answer/id #uuid "7d0801c9-297b-5bf2-859a-4a9dadaa3251" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186311567} {:answer/id #uuid "f09bd6c9-4ae6-5a49-aa64-19b0b8e95c30" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186311568}] :answer-field/correct {:answer/id #uuid "a28b4b29-7b16-55b1-9658-122b0103a806" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186311565} :answer-field/id #uuid "07c30adf-7a65-52bb-ad05-421ab2128d13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311563}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "23d76757-31a5-5e79-8232-9c67b743d844" :question/math-academy-id "q-178681" :question/problem "Given that $P(A)=0.4,$ $P(B)=0.3,$ and $P(A\\cap B)=0.1,$ find $P({A}^{′}\\cup B).$" :question/worked-solution "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =0.4+0.3-0.1 \\\\  & =0.6\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/e3fecd795207853d1a17a3e23c0d2872a59fde1c0561b8e357aae4a1705ca651.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=0.1+0.2+0.4=0.7.\n$$"}] [{:db/id #edb/ref 17592186311569 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/title "Finding the Probability of an Intersection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a6822f-9f8c-5d83-a31b-e4599a156269" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186311571} {:answer/id #uuid "69131d78-28bb-52b3-992c-f0d804aecdc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186311572} {:answer/id #uuid "b57baa79-cf7e-5d82-b51d-823066d5139e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{20}" :db/id #edb/ref 17592186311573} {:answer/id #uuid "935baa6f-d65d-5250-8672-f7db0acde8e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186311574} {:answer/id #uuid "d57e292f-f2cf-51f0-8fe0-8b34bb6cd387" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186311575}] :answer-field/correct {:answer/id #uuid "66a6822f-9f8c-5d83-a31b-e4599a156269" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186311571} :answer-field/id #uuid "937c9f75-5260-587a-95cb-ea744419953a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311570}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c86a8c9f-5fc6-5cbc-8065-7fd46d79ac54" :question/math-academy-id "q-179490" :question/problem "Given that $P(B)=\\frac{11}{20},$ $P(A\\cap B)=\\frac{1}{4},$ and $P(A\\cup B)=\\frac{3}{4},$ find $P({A}^{′}\\cap B).$" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{3}{4} & =P(A)+\\frac{11}{20}-\\frac{1}{4} \\\\ P(A) & =\\frac{3}{4}-\\frac{11}{20}+\\frac{1}{4} \\\\ P(A) & =\\frac{15}{20}-\\frac{11}{20}+\\frac{5}{20} \\\\ P(A) & =\\frac{9}{20}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/b39a37400a7831f642cd6fe1d71db3c518fd348531a09ebc9d601586ed44afa5.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap B)=\\frac{3}{10}.\n$$"}] [{:db/id #edb/ref 17592186311576 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140dfabc-7daf-5653-bcf3-f21ca835a86d" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186311578} {:answer/id #uuid "96ff8959-b005-5b48-b41b-11ea13bcd772" :answer/type {:db/ident :answer.type/math} :answer/value "0.1" :db/id #edb/ref 17592186311579} {:answer/id #uuid "ec216eb9-efcf-5730-9954-2ddd73274bba" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186311580} {:answer/id #uuid "29bfca27-96cf-5eb9-90a4-7e30166a3407" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186311581} {:answer/id #uuid "667c86f2-b962-5193-9d39-077487e14b00" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186311582}] :answer-field/correct {:answer/id #uuid "667c86f2-b962-5193-9d39-077487e14b00" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186311582} :answer-field/id #uuid "cead592a-00a2-5162-8515-d80c33cd881b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311577}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ac701741-50dd-53b0-a6f5-96fdac1ca3b2" :question/math-academy-id "q-179528" :question/problem "Given that $P(B)=0.7,$ $P(A\\cap B)=0.3,$ and $P(A\\cup B)=0.9,$ find $P({A}^{′}).$" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.9 & =P(A)+0.7-0.3 \\\\ P(A) & =0.9+0.3-0.7 \\\\ P(A) & =0.5\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}^{′}) & =1-P(A) \\\\  & =1-0.5 \\\\  & =0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311583 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255224e6-4df9-520e-8b5f-d278dcf56e23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186311585} {:answer/id #uuid "6442d7c0-65dc-5ffe-952a-1e463ae32f9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186311586} {:answer/id #uuid "1bdd93ae-ac8a-589f-ba4b-edad509eb65a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186311587} {:answer/id #uuid "f97da505-8504-5d77-96a8-531410768d07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186311588} {:answer/id #uuid "668c6302-609b-5f22-9317-349f1d79253c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186311589}] :answer-field/correct {:answer/id #uuid "255224e6-4df9-520e-8b5f-d278dcf56e23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186311585} :answer-field/id #uuid "2fe3cee9-ac6e-5a14-b6bb-996390fb54a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311584}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7fd4115d-263b-5a50-bff1-4f2f0d0e78fd" :question/math-academy-id "q-179529" :question/problem "Given that $P(B)=\\frac{1}{2},$ $P(A\\cap B)=\\frac{1}{4},$ and $P(A\\cup B)=\\frac{2}{3},$ find $P({A}^{′}).$" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{2}{3} & =P(A)+\\frac{1}{2}-\\frac{1}{4} \\\\ P(A) & =\\frac{2}{3}+\\frac{1}{4}-\\frac{1}{2} \\\\ P(A) & =\\frac{5}{12}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({A}^{′}) & =1-P(A) \\\\  & =1-\\frac{5}{12} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311590 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/title "Finding the Probability of an Intersection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1b3223-b448-5c34-9323-bd2b65a5fa39" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186311592} {:answer/id #uuid "81afc2f4-56df-506e-8329-2374625bd646" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186311593}] :answer-field/correct {:answer/id #uuid "be1b3223-b448-5c34-9323-bd2b65a5fa39" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186311592} :answer-field/id #uuid "01103f63-9be8-54ef-8e43-2b205aadc8a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311591}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d990def2-5c94-5781-92af-135dc93e6c88" :question/math-academy-id "q-246758" :question/problem "Given that $P(A)=0.4,$ $P(B)=0.5,$ and $P(A\\cap B)=0.2,$ find $P(A\\cap {B}^{′}).$\n\n$P(A\\cap {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =0.4+0.5-0.2 \\\\  & =0.7\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region $A\\cap {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/52a7c0ed9285d2699087f0ef817257eacebfabd5cfb2117167730a66b94da3e6.png)\n\nFinally, we have\n\n$$\nP(A\\cap {B}^{′})=0.2.\n$$"}] [{:db/id #edb/ref 17592186311594 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/title "Finding the Probability of an Intersection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac559ad-7085-52d9-980d-c1c526fe945f" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186311596}] :answer-field/correct {:answer/id #uuid "2ac559ad-7085-52d9-980d-c1c526fe945f" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186311596} :answer-field/id #uuid "206ffe09-0bf2-52fa-9f10-25e3482f34a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311595}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "30fb49ab-a6e3-5a66-bbff-a23fc2c189c6" :question/math-academy-id "q-263853" :question/problem "Given that $P(A)=0.5,$ $P(A\\cap B)=0.2,$ and $P(A\\cup B)=0.85,$ find $P({A}^{′}\\cap B).$\n\n$P({A}^{′}\\cap B)=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.85 & =0.5+P(B)-0.2 \\\\ P(B) & =0.85-0.5+0.2 \\\\ P(B) & =0.55\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/43267ee39b162c12235739ea84e9be539015ea28627caf14828b5fb5cc9fcd7b.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap B)=0.35.\n$$"}] [{:db/id #edb/ref 17592186311597 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/title "Finding the Probability of an Intersection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae77203-a0ad-55e8-9054-ac869a2e9a5c" :answer/type {:db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186311599}] :answer-field/correct {:answer/id #uuid "4ae77203-a0ad-55e8-9054-ac869a2e9a5c" :answer/type {:db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186311599} :answer-field/id #uuid "373132ad-b7d9-52b7-aa65-9a416ea1ab51" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311598}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4a48f10a-8277-5a69-9c95-d081c4dbbdb9" :question/math-academy-id "q-263855" :question/problem "Given that $P(A)=0.55,$ $P(B)=0.35,$ and $P(A\\cap B)=0.15,$ find $P({A}^{′}\\cap {B}^{′}).$\n\n$P({A}^{′}\\cap {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =0.55+0.35-0.15 \\\\  & =0.75\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/e71239d41a4317c2c7c7015ee2947266075864cec768161fdc4874e8b48f5056.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap {B}^{′})=0.25.\n$$"}] [{:db/id #edb/ref 17592186311600 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d5731e2-34fa-5e27-84be-324dc958b509" :knowledge-point/title "Finding the Probability of an Intersection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba440c8b-88f6-53c2-b6e8-a350d11c1f07" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186311602}] :answer-field/correct {:answer/id #uuid "ba440c8b-88f6-53c2-b6e8-a350d11c1f07" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186311602} :answer-field/id #uuid "9cebe3c3-751b-5032-a512-8f20e1605657" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311601}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0377c870-d9a8-59c3-896d-da450e18532c" :question/math-academy-id "q-264071" :question/problem "Given that $P(A)=0.35,$ $P(A\\cap B)=0.15,$ and $P(A\\cup B)=0.55,$ find $P({A}^{′}\\cap {B}^{′}).$\n\n$P({A}^{′}\\cap {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.55 & =0.35+P(B)-0.15 \\\\ P(B) & =0.55+0.15-0.35 \\\\  & =0.35\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cap {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/eba791c99c1b4706275f353ca221cdad5e535b508e57346e28fa18a372a080ee.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cap {B}^{′})=0.45.\n$$"}] [{:db/id #edb/ref 17592186198867 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c560de1-2886-5b21-af25-6aebde350ba3" :answer/type {:db/ident :answer.type/math} :answer/value "5/6" :db/id #edb/ref 17592186232871}] :answer-field/correct {:answer/id #uuid "4c560de1-2886-5b21-af25-6aebde350ba3" :answer/type {:db/ident :answer.type/math} :answer/value "5/6" :db/id #edb/ref 17592186232871} :answer-field/id #uuid "ed03e86e-a552-53a0-a7bb-30d435e23e8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186197447}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "212a5751-375f-5d72-9845-bcdb67ca953a" :question/math-academy-id "q-264077" :question/problem "Given that $P(A)=\\frac{1}{4},$ $P(B)=\\frac{1}{6},$ and $P(A\\cap B)=\\frac{1}{12},$ find $P({A}^{′}\\cup B).$ Do not round your answer.\n\n$P({A}^{′}\\cup B)=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A\\cup B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\  & =\\frac{1}{4}+\\frac{1}{6}-\\frac{1}{12} \\\\  & =\\frac{3}{12}+\\frac{2}{12}-\\frac{1}{12} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup B.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/0c8d9572472da406cf84f5657d0ea47d0d1ba76592c98d4e6f442ecb9ef03dec.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup B)=\\frac{1}{12}+\\frac{1}{12}+\\frac{2}{3}=\\frac{5}{6}.\n$$"}] [{:db/id #edb/ref 17592186311603 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "942b06da-a9f1-55b1-9c64-62c9c20ea447" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186311605}] :answer-field/correct {:answer/id #uuid "942b06da-a9f1-55b1-9c64-62c9c20ea447" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186311605} :answer-field/id #uuid "de503ca4-d638-54fa-a418-7fa4026034fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311604}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c97475b3-cbd6-51db-9270-19307459760f" :question/math-academy-id "q-264409" :question/problem "Given that $P(A)=0.6,$ $P(B)=0.5,$ and $P(A\\cup B)=0.8,$ find $P({A}^{′}\\cup {B}^{′}).$\n\n$P({A}^{′}\\cup {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.8 & =0.6+0.5-P(A\\cap B) \\\\ P(A\\cap B) & =0.6+0.5-0.8 \\\\  & =0.3\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/7ed0c9bf5b752eeffcd869d1b511d9ff65ca7cbbc6f5d85a38012b5ba57460d0.png)\n\nFinally, we have\n\n$$\nP({A}^{′}\\cup {B}^{′})=0.3+0.2+0.2=0.7.\n$$"}] [{:db/id #edb/ref 17592186311606 :knowledge-point/_questions [{:knowledge-point/id #uuid "053ab8bb-73ba-54b1-b195-05d4e12c56f1" :knowledge-point/title "Finding the Probability of a Union"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a347f503-e59c-596b-a7c3-13ce21105897" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186311608} {:answer/id #uuid "8a647118-d024-5177-a8ec-298eb2d02e89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186311609}] :answer-field/correct {:answer/id #uuid "a347f503-e59c-596b-a7c3-13ce21105897" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186311608} :answer-field/id #uuid "c9e27fdb-5393-5bc6-b382-45d17479f361" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311607}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0c42571e-fe28-594c-ae53-f8b3f913ae73" :question/math-academy-id "q-264413" :question/problem "Given that $P(B)=\\frac{2}{5},$ $P(A\\cap B)=\\frac{1}{3},$ and $P(A\\cup B)=\\frac{5}{6},$ find $P({A}^{′}\\cup {B}^{′}).$ Do not round your answer.\n\n$P({A}^{′}\\cup {B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(A)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{5}{6} & =P(A)+\\frac{2}{5}-\\frac{1}{3} \\\\ P(A) & =\\frac{5}{6}+\\frac{1}{3}-\\frac{2}{5} \\\\  & =\\frac{25}{30}+\\frac{10}{30}-\\frac{12}{30} \\\\  & =\\frac{23}{30}\\end{aligned}\n$$\n\nThen, we construct the corresponding Venn diagram and shade the region ${A}^{′}\\cup {B}^{′}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041480/assets/4b5f335b449e5f07de1d9ac1590245e71f6825b2dc13fe4ba046985aac95465a.png)\n\nFinally, we have\n\n$$\n\\begin{aligned}P({A}^{′}\\cup {B}^{′}) & =\\frac{13}{30}+\\frac{1}{15}+\\frac{1}{6} \\\\  & =\\frac{13}{30}+\\frac{2}{30}+\\frac{5}{30} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311610 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b16c18a4-c591-5800-8b60-5fbe6680ead6" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186311612} {:answer/id #uuid "d1c040bc-c7a3-50b1-b43d-db040a876690" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186311613}] :answer-field/correct {:answer/id #uuid "d1c040bc-c7a3-50b1-b43d-db040a876690" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186311613} :answer-field/id #uuid "e433324a-9117-5f51-b34d-b07e9aab9098" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311611}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "de355132-c934-56e3-9f81-8d3f91957eb2" :question/math-academy-id "q-264415" :question/problem "Given that $P(A)=0.35,$ $P(A\\cap B)=0.15,$ and $P(A\\cup B)=0.9,$ find $P({B}^{′}).$\n\n$P({B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.9 & =0.35+P(B)-0.15 \\\\ P(B) & =0.9+0.15-0.35 \\\\  & =0.7\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-0.7 \\\\  & =0.3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311614 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ee4b295-d4d7-5db5-80e6-a155eebdf795" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186311616}] :answer-field/correct {:answer/id #uuid "6ee4b295-d4d7-5db5-80e6-a155eebdf795" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186311616} :answer-field/id #uuid "33c077e8-c1f3-5bda-871e-018b31575129" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311615}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0dc08ae8-67ca-5c40-90cc-3c486588dfde" :question/math-academy-id "q-264419" :question/problem "Given that $P(A)=0.6,$ $P(A\\cap B)=0.25,$ and $P(A\\cup B)=0.95,$ find $P({B}^{′}).$\n\n$P({B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.95 & =0.6+P(B)-0.25 \\\\ P(B) & =0.95+0.25-0.6 \\\\  & =0.6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-0.6 \\\\  & =0.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311617 :knowledge-point/_questions [{:knowledge-point/id #uuid "44603ff6-f9c7-5a02-83c1-0e803444bd25" :knowledge-point/title "Finding the Probability of a Complement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841313af-bf32-53b9-946a-def406998832" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{63}" :db/id #edb/ref 17592186311619} {:answer/id #uuid "a3187a80-7e7e-57c8-90e7-7c6b22d5ec69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{44}{63}" :db/id #edb/ref 17592186311620}] :answer-field/correct {:answer/id #uuid "841313af-bf32-53b9-946a-def406998832" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{63}" :db/id #edb/ref 17592186311619} :answer-field/id #uuid "63d6fb2c-f075-5a52-8679-30a886388c3d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311618}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "35262bb8-e0ee-5d22-a309-9c8333f109bc" :question/math-academy-id "q-264425" :question/problem "Given that $P(A)=\\frac{1}{3},$ $P(A\\cap B)=\\frac{1}{7},$ and $P(A\\cup B)=\\frac{8}{9},$ find $P({B}^{′}).$ Do not round your answer.\n\n$P({B}^{′})=$\n{{field-1}}" :question/worked-solution "First, we calculate $P(B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ \\frac{8}{9} & =\\frac{1}{3}+P(B)-\\frac{1}{7} \\\\ P(B) & =\\frac{8}{9}+\\frac{1}{7}-\\frac{1}{3} \\\\  & =\\frac{44}{63}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P({B}^{′}) & =1-P(B) \\\\  & =1-\\frac{44}{63} \\\\  & =\\frac{19}{63}.\\end{aligned}\n$$"}]}
