db/ensure [:answer/validate]} {:db/id "q-113824/selection/3a531297a7db7491f069250593e17f864d945407d230eb298cbf6b0eb7668294" :answer/id #uuid "b79330e2-2190-5dde-807b-d4dd36d62d9e" :answer/type :answer.type/math :answer/value "\\frac{{g}^{2}}{3h}" :db/ensure [:answer/validate]} {:db/id "q-113824/selection/974d5b9bc3f8d7ae53a07da54c5a521c15d3e9dcb0d21bc1be770a8ad0d480df" :answer/id #uuid "a2aa00d6-1cf0-511d-b817-de62406915cf" :answer/type :answer.type/math :answer/value "\\frac{3{h}^{2}}{g}" :db/ensure [:answer/validate]} {:db/id "q-113824/selection/e014bd528a864980e228c625a321541e04514ed573b09d5d1e431a244740143e" :answer/id #uuid "dd121968-abe1-58d1-baf3-51275f7e9f2b" :answer/type :answer.type/math :answer/value "\\frac{3g}{{h}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-113824/selection" :answer-field/id #uuid "ecc0b8cc-ff19-5dab-aa5c-9928ba09585b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113824/selection/19591b0ada871c70b0595c9156c5b9d43f08387c228bff74de61a7679601f274" :answer-field/choices ["q-113824/selection/cf546545421ffa21e2409ff0abc645913f2d76e953fd108528d7fb5b58605440" "q-113824/selection/19591b0ada871c70b0595c9156c5b9d43f08387c228bff74de61a7679601f274" "q-113824/selection/3a531297a7db7491f069250593e17f864d945407d230eb298cbf6b0eb7668294" "q-113824/selection/974d5b9bc3f8d7ae53a07da54c5a521c15d3e9dcb0d21bc1be770a8ad0d480df" "q-113824/selection/e014bd528a864980e228c625a321541e04514ed573b09d5d1e431a244740143e"] :db/ensure [:answer-field/validate]} {:db/id "q-113824" :question/id #uuid "6a48aa76-c7fd-50b2-ab17-7f90486ab6d7" :question/math-academy-id "q-113824" :question/problem "Given that $\\frac{4{g}^{2}}{7{h}^{3}}=a$ and $\\frac{12g}{7h}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{4{g}^{2}}{7{h}^{3}}÷\\frac{12g}{7h},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4{g}^{2}}{7{h}^{3}}÷\\frac{12g}{7h} & = \\\\ \\frac{4{g}^{2}}{7{h}^{3}}\\cdot \\frac{7h}{12g} & = \\\\ \\frac{4g\\cdot g}{7h\\cdot {h}^{2}}\\cdot \\frac{7h}{3\\cdot 4g} & = \\\\ \\frac{\\cancel{4g}\\cdot g}{\\cancel{7h}\\cdot {h}^{2}}\\cdot \\frac{\\cancel{7h}}{3\\cdot \\cancel{4g}} & = \\\\ \\frac{g}{3{h}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113824/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f"] :knowledge-point/questions ["q-113824"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98132/selection/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" :answer/id #uuid "ae31f3d8-4162-53e1-8733-8424d19cc1c9" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-98132/selection/4d31c9cc5368f8cb8fa2d5661886836ed8f2cebf6125f1b80fa1f903bde9bebe" :answer/id #uuid "b7a189a5-88ca-5c2b-9207-5a320fe84315" :answer/type :answer.type/math :answer/value "6\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-98132/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "fe2fe3cf-242a-5a9b-8374-54de458e4a52" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-98132/selection/f1fc99d76de679b25d7bc8a032d05611ddde6c3060e9504759d4c7dadb0e382d" :answer/id #uuid "f8d1ba45-805a-5b16-aa41-a4bb49678f68" :answer/type :answer.type/math :answer/value "8\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-98132/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "7e1b56a4-e52e-5580-a7cb-203a11983782" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-98132/selection" :answer-field/id #uuid "2149e681-c6ca-582b-9627-bc70ee3e5460" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98132/selection/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" :answer-field/choices ["q-98132/selection/219833e72de92bafe4f4f5813822a337104a6b771fd9bf741ddcca8750ecab9e" "q-98132/selection/4d31c9cc5368f8cb8fa2d5661886836ed8f2cebf6125f1b80fa1f903bde9bebe" "q-98132/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-98132/selection/f1fc99d76de679b25d7bc8a032d05611ddde6c3060e9504759d4c7dadb0e382d" "q-98132/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-98132" :question/id #uuid "4ce617aa-5397-5565-9c42-e78f189d502a" :question/math-academy-id "q-98132" :question/problem "What is the distance between the points $A(-5,2,9)$ and $B(-1,-2,9)?$" :question/worked-solution "The distance $d$ between two points $A({x}_{1},{y}_{1},{z}_{1})$ and $B({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nIn this case, we have $A{{(-5,2,9)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and $B{{(-1,-2,9)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Therefore,\n\n$$\n\\begin{aligned}d & =\\sqrt{(-1-(-5))^{2}+(-2-2)^{2}+(9-9)^{2}} \\\\  & =\\sqrt{{4}^{2}+(-4)^{2}+{0}^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =\\sqrt{32} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98132/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3ee7d83-2897-53ea-aa8f-05d52cb1f9e7"] :knowledge-point/questions ["q-98132"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-69271"] :question/problem "Factor the expression ${p}^{4}-1.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{p}^{4}-1={({p}^{2})}^{2}-{1}^{2}\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n{({p}^{2})}^{2}-{1}^{2}=({p}^{2}+1)({p}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}({p}^{2}+1)({p}^{2}-1) & =({p}^{2}+1)({p}^{2}-{1}^{2}) \\\\  & =({p}^{2}+1)(p+1)(p-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} [:db/retract 17592186259310 :question/answer-fields 17592186274611] {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0efafccd-3dbf-5c2d-a483-35b87103e117" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/e4267992b1782365f5817e630b24491092dc1c1da024bac79325760c40e35e4f" :answer/id #uuid "f9a7cf08-da54-5f93-915f-037a866067b9" :answer/type :answer.type/math :answer/value "\\frac{5}{7}" :db/ensure [:answer/validate]} {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "2c1e3f06-2e8a-5995-a897-4290e1b746d0" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/774940da4ab3b26727b8db6c1c90fb931ece0a7759ec47b6581e5af495721ce1" :answer/id #uuid "970c727b-5391-5e23-8e4f-b5762579af66" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" :answer/id #uuid "0fbed6fe-e67e-519e-8d16-d23e07b37b0b" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc" :answer-field/id #uuid "b3d1e849-3022-5eb8-93a3-6a5fe5ac7a52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/e4267992b1782365f5817e630b24491092dc1c1da024bac79325760c40e35e4f" "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/774940da4ab3b26727b8db6c1c90fb931ece0a7759ec47b6581e5af495721ce1" "q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-288814"] :question/answer-fields ["q-288814/selection/ma-v1/21b95ec01cf7195d0b98c41e36362d5eb41bab57fc27f7451cd3ac6a0ebd79cc"] :db/ensure [:question/validate]} {:db/id "q-112964/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "fcf4139c-b2ca-5302-89d4-ab02d05b733f" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-112964/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "bea7083f-5aaa-5edd-9dee-9e0640acf362" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-112964/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "29d1479d-8b8d-5bbb-bb1d-3e4a244cb137" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-112964/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "3e82a6db-a670-5b09-bb4d-afd3cb9f40be" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-112964/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "90efd263-4e21-5a4c-be10-bd1febf0ea78" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-112964/selection" :answer-field/id #uuid "76db370d-a620-5984-a449-0cfdc8dc982b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112964/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer-field/choices ["q-112964/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-112964/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" "q-112964/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-112964/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-112964/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8"] :db/ensure [:answer-field/validate]} {:db/id "q-112964" :question/id #uuid "eb95820b-48e7-589b-b453-db9d5d27848d" :question/math-academy-id "q-112964" :question/problem "For the polynomial $f(x)=20{x}^{5}-7{x}^{4}+x-4,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-4,$ and its factors are $\\pm 1,$ $\\pm 2$ and $\\pm 4.$\n\n- The leading coefficient is $20,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 4,$ $\\pm 5,$ $\\pm 10$ and $\\pm 20.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{4}, & \\pm \\frac{2}{5}, & \\pm \\frac{2}{10}, & \\pm \\frac{2}{20}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{4}, & \\pm \\frac{4}{5}, & \\pm \\frac{4}{10}, & \\pm \\frac{4}{20}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to the lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm 4, & \\pm 2, & \\pm 1, & \\pm \\frac{4}{5}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}.\\end{aligned}\n$$\n\nNotice that several potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{20},\\,\\pm \\frac{1}{10},\\,\\pm \\frac{1}{5},\\,\\pm \\frac{1}{4},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{4}{5},\\,\\pm 1,\\,\\pm 2,\\,\\pm 4.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-112964/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a"] :knowledge-point/questions ["q-112964"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74715/selection/574a0eb281ccd20e1a125f3745c318e1ba066fe07ff29c4f037f0f1b349e2dde" :answer/id #uuid "0370af9b-2364-5f2d-b604-099c3aaed1c0" :answer/type :answer.type/math :answer/value "3.37" :db/ensure [:answer/validate]} {:db/id "q-74715/selection/394cdcfd69105d3c3619cb0b90823608a40b680e352e0fe68258c1cd49fa8999" :answer/id #uuid "da385ac4-15bb-5baa-ad0d-ef1ed56a3a29" :answer/type :answer.type/math :answer/value "3.53" :db/ensure [:answer/validate]} {:db/id "q-74715/selection/d37d0a5e89e00fd20fa742f4082a02148583b83e78adddc07d54bffdff6e0a35" :answer/id #uuid "693715a4-a3d0-5def-85bd-e613ba22256a" :answer/type :answer.type/math :answer/value "3.73" :db/ensure [:answer/validate]} {:db/id "q-74715/selection/ed8b2427f2aba209e8044fbfcceb9e558aa69226712b19f419ffa9fcafd30109" :answer/id #uuid "d562c841-bb3b-5e85-a962-7eef2551a082" :answer/type :answer.type/math :answer/value "7.33" :db/ensure [:answer/validate]} {:db/id "q-74715/selection/e45559e25347e2d098fca34bb02a274249610c0fa158df9af2a8d59b4f4356ab" :answer/id #uuid "a82e2052-e69d-510f-8cb9-c2f1dda72994" :answer/type :answer.type/math :answer/value "3.35" :db/ensure [:answer/validate]} {:db/id "q-74715/selection" :answer-field/id #uuid "af3e69f7-bad0-529a-b47f-8633cbb54286" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74715/selection/d37d0a5e89e00fd20fa742f4082a02148583b83e78adddc07d54bffdff6e0a35" :answer-field/choices ["q-74715/selection/574a0eb281ccd20e1a125f3745c318e1ba066fe07ff29c4f037f0f1b349e2dde" "q-74715/selection/394cdcfd69105d3c3619cb0b90823608a40b680e352e0fe68258c1cd49fa8999" "q-74715/selection/d37d0a5e89e00fd20fa742f4082a02148583b83e78adddc07d54bffdff6e0a35" "q-74715/selection/ed8b2427f2aba209e8044fbfcceb9e558aa69226712b19f419ffa9fcafd30109" "q-74715/selection/e45559e25347e2d098fca34bb02a274249610c0fa158df9af2a8d59b4f4356ab"] :db/ensure [:answer-field/validate]} {:db/id "q-74715" :question/id #uuid "12a7aa4e-d3f3-5b8b-8e46-e7bcc341c503" :question/math-academy-id "q-74715" :question/problem "Find, in radians to two decimal places, the argument of $z=-3-2\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964743/assets/0c6548a95b2a81c7dcde33ead78ee0be8d5cee936edc1e2a98c2d59d259404b7.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =\\operatorname{arctan}⁡(\\frac{2}{3})≈0.588\\,00.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi +0.588\\,00≈3.73\n$$\n\nto two decimal places." :question/difficulty :question.difficulty/easy :question/requires-calculator true :question/answer-fields ["q-74715/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a560db4d-e9d3-5d89-b2cd-c886f32db9df"] :knowledge-point/questions ["q-74715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66428/selection/7a1639953afd962b86800fefdf289dd7621826446b3dc3c93bb7644a38a0ed42" :answer/id #uuid "785de841-e30d-5554-ae18-9a5bcd989d09" :answer/type :answer.type/math :answer/value "x=-2\\pm 8\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-66428/selection/5b473d1c885bd8b1135dd6412424ef44ae456e57db375a8f3ca332f919cdb401" :answer/id #uuid "457e804b-10aa-59ee-88ad-3a839f73934f" :answer/type :answer.type/math :answer/value "x=-1\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-66428/selection/5b922373b76bba9c817249626d5da34beb1705db95cfcffabcff40b40a05b64c" :answer/id #uuid "feaefaee-d395-5bc6-920a-c159d21b355e" :answer/type :answer.type/math :answer/value "x=-2\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-66428/selection/a88f9cd000f4578c6a03ead2d6f5f3aa0a269af086fc57756a76098ff8f7845f" :answer/id #uuid "f7dbe447-f2c7-5e0d-bdb3-f03c81cfa689" :answer/type :answer.type/math :answer/value "x=-1\\pm \\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-66428/selection/72a7633971ea893422f61798f9aba6adfe74c2c7327ab774b3df138c67277001" :answer/id #uuid "f33946c4-048f-5adf-8e5e-b5aa8bc2392c" :answer/type :answer.type/math :answer/value "x=-1\\pm 8\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-66428/selection" :answer-field/id #uuid "a3c23881-8e59-5522-abe3-28fec3edc201" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-66428/selection/5b473d1c885bd8b1135dd6412424ef44ae456e57db375a8f3ca332f919cdb401" :answer-field/choices ["q-66428/selection/7a1639953afd962b86800fefdf289dd7621826446b3dc3c93bb7644a38a0ed42" "q-66428/selection/5b473d1c885bd8b1135dd6412424ef44ae456e57db375a8f3ca332f919cdb401" "q-66428/selection/5b922373b76bba9c817249626d5da34beb1705db95cfcffabcff40b40a05b64c" "q-66428/selection/a88f9cd000f4578c6a03ead2d6f5f3aa0a269af086fc57756a76098ff8f7845f" "q-66428/selection/72a7633971ea893422f61798f9aba6adfe74c2c7327ab774b3df138c67277001"] :db/ensure [:answer-field/validate]} {:db/id "q-66428" :question/id #uuid "79f12e46-deae-53cd-89d3-2dfcd47a8848" :question/math-academy-id "q-66428" :question/problem "Solve  the equation $\\,-{x}^{2}-2x-17=0.$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-1,b=-2,$ and $c=-17.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(-1)(-17)}}{2(-1)} \\\\  & =\\frac{2\\pm \\sqrt{4-68}}{-2} \\\\  & =\\frac{2\\pm \\sqrt{-64}}{-2} \\\\  & =\\frac{2\\pm 8\\,\\text{i}}{-2} \\\\  & =-1\\pm 4\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-1+4\\,\\text{i}$ and $x=-1-4\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-66428/selection"] :db/ensure [:question/validate]} 