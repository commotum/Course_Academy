#{[{:db/id #edb/ref 17592186259310 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdb0793b-d847-5764-84fc-bdb1a1b26f33" :answer/type {:db/ident :answer.type/math} :answer/value "− (312)/(2)" :db/id #edb/ref 17592186271667} {:answer/id #uuid "f388da2d-63c2-5f3f-95d9-28a91321e8ef" :answer/type {:db/ident :answer.type/math} :answer/value "22464" :db/id #edb/ref 17592186271668} {:answer/id #uuid "1626f062-cbbb-556b-b4d3-f1e14e961738" :answer/type {:db/ident :answer.type/math} :answer/value "− 22464" :db/id #edb/ref 17592186271669} {:answer/id #uuid "81bc3538-9cd1-5096-a87f-0d4eb7c41a29" :answer/type {:db/ident :answer.type/math} :answer/value "(22464)/(312)" :db/id #edb/ref 17592186271670} {:answer/id #uuid "6b5ec5d8-9692-5cd4-ba97-97c881413d0e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186271671}] :answer-field/correct {:answer/id #uuid "6b5ec5d8-9692-5cd4-ba97-97c881413d0e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186271671} :answer-field/id #uuid "443ae15f-dead-5c30-a4b1-6908e84b2b5f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274611}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "939510b6-5bc7-5d08-b915-1376d3819fba" :question/math-academy-id "q-288814" :question/problem "Consider the quadratic equation\n\n$$\n7{x}^{2}-5x-14=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=7,\\,b=-5,\\,c=-14.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-14)}{7}=-2.\\end{aligned}\n$$"}]}
