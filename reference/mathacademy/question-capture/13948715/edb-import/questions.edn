#{[{:db/id #edb/ref 17592186092451 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8587ed8c-1752-5e1c-9a24-e75badf3bb9e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{26}{15}, 0)" :db/id #edb/ref 17592186089143} {:answer/id #uuid "a666337f-5e05-5bb3-a18b-c4d930549c19" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{13}{14}, 0)" :db/id #edb/ref 17592186089144} {:answer/id #uuid "0e1abed5-e9af-503d-8e4e-90c01e8d23d5" :answer/type {:db/ident :answer.type/math} :answer/value "(-52, 0)" :db/id #edb/ref 17592186089145} {:answer/id #uuid "1b7709fc-cb60-597e-a98c-c7f7f78ea016" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{15}{26}, 0)" :db/id #edb/ref 17592186089146} {:answer/id #uuid "7d323c8e-0015-5ace-84b3-c182d5673bed" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{6}{5}, 0)" :db/id #edb/ref 17592186089147}] :answer-field/correct {:answer/id #uuid "8587ed8c-1752-5e1c-9a24-e75badf3bb9e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{26}{15}, 0)" :db/id #edb/ref 17592186089143} :answer-field/id #uuid "56edbb31-c0ea-56e3-b7fd-c481084f2889" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089142}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9bc53eba-4d4e-5f8c-8a22-7a4a98405447" :question/math-academy-id "q-10752" :question/problem "Find where the tangent to the curve $y = 5x^{2} - 7$ at the point $(3, 38)$ intersects the $x$-axis." :question/requires-calculator false :question/worked-solution "Differentiate to get $y'=10x$, so the slope at $x=3$ is $30$. The tangent through $(3,38)$ is\n$$y-38=30(x-3),\\qquad y=30x-52.$$\nAt the $x$-axis, $y=0$, so $x=52/30=26/15$. The intersection is $(26/15,0)$."}]}
