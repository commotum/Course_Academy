0835/selection/a656390754c02195ca904358c8f29dcfeb6affa5b4f7b5fa20c42ee6e509ee4b"] :db/ensure [:answer-field/validate]} {:db/id "q-10835" :question/id #uuid "9edf2d1b-4027-5a64-957a-9a30359911d7" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10835/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172"] :knowledge-point/questions ["q-10835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10844/selection/0b92dae460f1ee79cf259b9feb7b517664cfca968a51050d085a90c7ab55c394" :answer/id #uuid "526f3a87-94b7-5ee7-b295-58f5f7e1da06" :answer/type :answer.type/math :answer/value "y=7x-26" :db/ensure [:answer/validate]} {:db/id "q-10844/selection/5452a5ff29e65dbf766c14094cfe008786d16eda7353700a4b609d7a85ee1e6a" :answer/id #uuid "e6da76a2-219e-54e8-b6be-64741924390c" :answer/type :answer.type/math :answer/value "y=12x-24" :db/ensure [:answer/validate]} {:db/id "q-10844/selection/43faac9425ea9217ffc29a1aea737c6b538648ca94295155ebbc67cba24bc00b" :answer/id #uuid "4d6498cf-ae4c-5ae7-b8b2-997d1269225d" :answer/type :answer.type/math :answer/value "y=17x-24" :db/ensure [:answer/validate]} {:db/id "q-10844/selection/9a8a52423b63a32ccc2289bfaee553568cc544013df216ea84ebcabcacb224e6" :answer/id #uuid "48a32f3c-1bfa-5aab-803f-8c5