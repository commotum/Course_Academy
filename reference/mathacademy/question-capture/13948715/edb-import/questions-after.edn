#{[{:db/id #edb/ref 17592186092451 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8587ed8c-1752-5e1c-9a24-e75badf3bb9e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{26}{15}, 0)" :db/id #edb/ref 17592186089143} {:answer/id #uuid "a666337f-5e05-5bb3-a18b-c4d930549c19" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{13}{14}, 0)" :db/id #edb/ref 17592186089144} {:answer/id #uuid "0e1abed5-e9af-503d-8e4e-90c01e8d23d5" :answer/type {:db/ident :answer.type/math} :answer/value "(-52, 0)" :db/id #edb/ref 17592186089145} {:answer/id #uuid "1b7709fc-cb60-597e-a98c-c7f7f78ea016" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{15}{26}, 0)" :db/id #edb/ref 17592186089146} {:answer/id #uuid "7d323c8e-0015-5ace-84b3-c182d5673bed" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{6}{5}, 0)" :db/id #edb/ref 17592186089147}] :answer-field/correct {:answer/id #uuid "8587ed8c-1752-5e1c-9a24-e75badf3bb9e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{26}{15}, 0)" :db/id #edb/ref 17592186089143} :answer-field/id #uuid "56edbb31-c0ea-56e3-b7fd-c481084f2889" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089142}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9bc53eba-4d4e-5f8c-8a22-7a4a98405447" :question/math-academy-id "q-10752" :question/problem "Find where the tangent to the curve $y = 5x^{2} - 7$ at the point $(3, 38)$ intersects the $x$-axis." :question/requires-calculator false :question/worked-solution "Differentiate to get $y'=10x$, so the slope at $x=3$ is $30$. The tangent through $(3,38)$ is\n$$y-38=30(x-3),\\qquad y=30x-52.$$\nAt the $x$-axis, $y=0$, so $x=52/30=26/15$. The intersection is $(26/15,0)$."}] [{:db/id #edb/ref 17592186262535 :knowledge-point/_questions [{:knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a339b011-a42a-59bf-860b-1c286e5c9790" :answer/type {:db/ident :answer.type/math} :answer/value "(28,0)" :db/id #edb/ref 17592186262537} {:answer/id #uuid "ce2f2032-468b-5029-b572-e4405772ab5b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-30)" :db/id #edb/ref 17592186262538} {:answer/id #uuid "ae681b50-f2b7-531b-bd71-2e12d775f070" :answer/type {:db/ident :answer.type/math} :answer/value "(0,28)" :db/id #edb/ref 17592186262539} {:answer/id #uuid "485bf178-da2c-5f97-8130-acb83206aa0e" :answer/type {:db/ident :answer.type/math} :answer/value "(30,0)" :db/id #edb/ref 17592186262540} {:answer/id #uuid "a13a08d9-fb2e-5f8d-b2e8-41dcc27977cf" :answer/type {:db/ident :answer.type/math} :answer/value "(28,-30)" :db/id #edb/ref 17592186262541}] :answer-field/correct {:answer/id #uuid "ce2f2032-468b-5029-b572-e4405772ab5b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-30)" :db/id #edb/ref 17592186262538} :answer-field/id #uuid "fa1c4286-d0cc-5939-8b55-2b3276929aa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262536}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "98d3cf40-2059-5af6-a1da-8f71c594f15b" :question/math-academy-id "q-10753" :question/problem "Find where the tangent to the curve $f(x)=7{x}^{2}-2$ at the point $(2,26)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=7{x}^{2}-2.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(7{x}^{2}-2)=14x\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(2)=14(2)=28.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(26) & =28(x-2) \\\\ y & =28x-56+26 \\\\ y & =28x-30.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =28(0)-30 \\\\ y & =-30\\end{aligned}\n$$\n\nTherefore, the intersection point is $(0,-30).$"}] [{:db/id #edb/ref 17592186262542 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "394920f6-d965-5922-8454-006cbeb3041c" :answer/type {:db/ident :answer.type/math} :answer/value "y=16x-12" :db/id #edb/ref 17592186262544} {:answer/id #uuid "87b93850-cfad-5f9c-8584-93458c2c61c7" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-13" :db/id #edb/ref 17592186262545} {:answer/id #uuid "c5122c2a-2b86-561e-ad93-cf215ce30c31" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186262546} {:answer/id #uuid "2bf27c8b-5ff7-5e66-9da7-961ed7eface3" :answer/type {:db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186262547} {:answer/id #uuid "d69422f5-9416-5d65-842b-eae77c4e6f21" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186262548}] :answer-field/correct {:answer/id #uuid "2bf27c8b-5ff7-5e66-9da7-961ed7eface3" :answer/type {:db/ident :answer.type/math} :answer/value "y=16x-8" :db/id #edb/ref 17592186262547} :answer-field/id #uuid "4d3758df-a107-5daf-b520-80e29624c6e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262543}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9edf2d1b-4027-5a64-957a-9a30359911d7" :question/math-academy-id "q-10835" :question/problem "Find the equation of the tangent to the curve  $y=2{x}^{2}+8x$ at the point $(2,24).$" :question/worked-solution "Let $f(x)=2{x}^{2}+8x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+8x)=4x+8.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(2)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(2)=4(2)+8=16\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=16$ and the coordinates of our point $(2,24),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(24) & =16(x-2) \\\\ y & =16x-32+24 \\\\ y & =16x-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262549 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "526f3a87-94b7-5ee7-b295-58f5f7e1da06" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x-26" :db/id #edb/ref 17592186262551} {:answer/id #uuid "4d6498cf-ae4c-5ae7-b8b2-997d1269225d" :answer/type {:db/ident :answer.type/math} :answer/value "y=17x-24" :db/id #edb/ref 17592186262552} {:answer/id #uuid "6632bea2-5123-5b64-bfc8-98b437b26197" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x-18" :db/id #edb/ref 17592186262553} {:answer/id #uuid "e6da76a2-219e-54e8-b6be-64741924390c" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-24" :db/id #edb/ref 17592186262554} {:answer/id #uuid "48a32f3c-1bfa-5aab-803f-8c5ae8b01e84" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x+24" :db/id #edb/ref 17592186262555}] :answer-field/correct {:answer/id #uuid "6632bea2-5123-5b64-bfc8-98b437b26197" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x-18" :db/id #edb/ref 17592186262553} :answer-field/id #uuid "65eb844a-9599-5ec3-a757-921ba1a30370" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "98d18f04-3f28-584e-b429-079c6669115d" :question/math-academy-id "q-10844" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}-5x$ at the point $(3,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}-5x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}-5x)=4x-5.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(3)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(3)=4(3)-5=7.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=7$ and the coordinates of our point $(3,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =7(x-3) \\\\ y & =7x-21+3 \\\\ y & =7x-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262556 :knowledge-point/_questions [{:knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2a8dd34-72b7-5c3b-969a-89bea87274b8" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-11" :db/id #edb/ref 17592186262558} {:answer/id #uuid "0b8956cf-c88e-56ed-a3d9-20d18dcac830" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x+4" :db/id #edb/ref 17592186262559} {:answer/id #uuid "8e529215-1a31-5531-98f7-1769a77d07a7" :answer/type {:db/ident :answer.type/math} :answer/value "y=12x-9" :db/id #edb/ref 17592186262560} {:answer/id #uuid "8708d802-a364-5d46-aa3b-9d3f737299d4" :answer/type {:db/ident :answer.type/math} :answer/value "y=10x-11" :db/id #edb/ref 17592186262561} {:answer/id #uuid "d9f2ea98-5ff2-5dd7-8151-a3f6efc7108a" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186262562}] :answer-field/correct {:answer/id #uuid "d9f2ea98-5ff2-5dd7-8151-a3f6efc7108a" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186262562} :answer-field/id #uuid "b8d5d686-deb2-5b5e-be46-b8743c6ceb4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262557}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a166a05-7173-5331-bcfb-a93815ddbfe1" :question/math-academy-id "q-2333" :question/problem "Find the equation of the tangent to the curve $y=2\\sqrt{{x}^{7}}-{x}^{2}$ at the point $(1,1).$" :question/worked-solution "Let $f(x)=2\\sqrt{{x}^{7}}-{x}^{2}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{{x}^{7}}-{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7/2}-{x}^{2}) \\\\  & =7{x}^{5/2}-2x.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=7(1)^{5/2}-2(1)=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x-1) \\\\ y & =5x-5+1 \\\\ y & =5x-4.\\end{aligned}\n$$"}]}
