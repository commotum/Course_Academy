28 true] [17592186306025 1113 #uuid "ff8d19fb-9958-559c-b38d-0e233103bf0e" 13194139534728 true] [17592186306025 1145 "Note that the factor $|x-2|+3$ is always positive for all real numbers $x.$\n\nSince $|x-2|+3$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{(|x-2|+3)(4x-1)}{|x-2|+3} & \\le \\frac{0}{\\,|x-2|+3\\,} \\\\ 4x-1 & \\le 0 \\\\ 4x & \\le 1 \\\\ x & \\le \\,\\frac{1}{4}.\\end{aligned}\n$$" 13194139534728 true] [17592186306026 1000 #edb/ref 17592186306027 13194139534728 true] [17592186306026 1000 #edb/ref 17592186306028 13194139534728 true] [17592186306026 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306026 1041 "field-1" 13194139534728 true] [17592186306026 1104 #edb/ref 17592186306028 13194139534728 true] [17592186306026 1110 #uuid "6d482a9d-fd6d-5189-843f-a0c360457eaf" 13194139534728 true] [17592186306027 1034 ">" 13194139534728 true] [17592186306027 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306027 1111 #uuid "45b78a94-488e-5e52-b64a-df7d6096b0ed" 13194139534728 true] [17592186306028 1034 "\\le" 13194139534728 true] [17592186306028 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306028 1111 #uuid "7f465b5b-e566-5f53-8ae8-2877a76465b6" 13194139534728 true] [17592186306029 1000 #edb/ref 17592186306030 13194139534728 true] [17592186306029 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306029 1041 "field-2" 13194139534728 true] [17592186306029 1104 #edb/ref 17592186306030 13194139534728 true] [17592186306029 1110 #uuid "b91fe70b-cbde-52cb-8d7f-5854e39f3f31" 13194139534728 true] [17592186306030 1034 "\\frac{1}{4}" 13194139534728 true] [17592186306030 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306030 1111 #uuid "3c0e2911-ede0-5b6f-81d6-d7719e547121" 13194139534728 true] [17592186306031 1017 #edb/ref 17592186306032 13194139534728 true] [17592186306031 1017 #edb/ref 17592186306034 13194139534728 true] [17592186306031 1089 "q-328558" 13194139534728 true] [17592186306031 1091 #edb/ref 17592186045463 13194139534728 true] [17592186306031 1100 "Solve the inequality\n$(-4{x}^{2}-1)(3x-2)<0.$\n\n$x$\n{{field-1}}{{field-2}}" 13194139534728 true] [17592186306031 1113 #uuid "9291a6f9-9744-5c97-8557-b7b59826bfe6" 13194139534728 true] [17592186306031 1145 "Since $-4{x}^{2}-1$ is always negative, we can divide both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}(-4{x}^{2}-1)(3x-2) & <0 \\\\ \\frac{(-4{x}^{2}-1)(3x-2)}{-4{x}^{2}-1} & >\\frac{0}{-4{x}^{2}-1} \\\\ 3x-2 & >0 \\\\ x & >\\,\\frac{2}{3}.\\end{aligned}\n$$" 13194139534728 true] [17592186306032 1000 #edb/ref 17592186306033 13194139534728 true] [17592186306032 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306032 1041 "field-1" 13194139534728 true] [17592186306032 1104 #edb/ref 17592186306033 13194139534728 true] [17592186306032 1110 #uuid "f4641678-049a-5e74-9dec-103137fb255d" 13194139534728 true] [17592186306033 1034 ">" 13194139534728 true] [17592186306033 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306033 1111 #uuid "d541574c-e024-5502-ab4d-518ad17f0e96" 13194139534728 true] [17592186306034 1000 #edb/ref 17592186306035 13194139534728 true] [17592186306034 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306034 1041 "field-2" 13194139534728 true] [17592186306034 1104 #edb/ref 17592186306035 13194139534728 true] [17592186306034 1110 #uuid "1c04082e-0797-5a71-93d7-e776e38ab99d" 13194139534728 true] [17592186306035 1034 "\\frac{2}{3}" 13194139534728 true] [17592186306035 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306035 1111 #uuid "1d3b65b6-061a-52d1-b809-4ed3b5426e43" 13194139534728 true] [17592186306036 1017 #edb/ref 17592186306037 13194139534728 true] [17592186306036 1017 #edb/ref 17592186306039 13194139534728 true] [17592186306036 1017 #edb/ref 17592186306041 13194139534728 true] [17592186306036 1089 "q-330599" 13194139534728 true] [17592186306036 1091 #edb/ref 17592186045464 13194139534728 true] [17592186306036 1100 "Solve the inequality\n\n$$\n(\\sqrt{x+1}-3)(x-2)\\le 0,\\,x<8.\n$$\n\n{{field-1}}{{field-2}}\n$x<$\n{{field-3}}" 13194139534728 true] [17592186306036 1113 #uuid "e6f12aaa-b39f-53cc-afad-2e7fd99c317f" 13194139534728 true] [17592186306036 1145 "Since $x<8,$ we have that\n\n$$\n\\begin{aligned}x & <8 \\\\ x+1 & <9 \\\\ \\sqrt{x+1} & <3 \\\\ \\sqrt{x+1}-3 & <0.\\end{aligned}\n$$\n\nThis means that $\\sqrt{x+1}-3$ is negative for all the values of $x$ that we are considering $(x<8).$ So, we can divide both sides by $\\sqrt{x+1}-3,$ provided that we flip the sign of the inequality:\n\n$$\n\\begin{aligned}(\\sqrt{x+1}-3)(x-2) & \\le 0 \\\\ \\frac{(\\sqrt{x+1}-3)(x-2)}{\\sqrt{x+1}-3} & \\ge \\frac{0}{\\sqrt{x+1}-3} \\\\ x-2 & \\ge 0 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x\\ge 2$ and $x<8.$ So, the solution to our inequality is\n\n$$\n\\begin{aligned}2\\le x<8\\end{aligned}\n$$" 13194139534728 true] [17592186306037 1000 #edb/ref 17592186306038 13194139534728 true] [17592186306037 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306037 1041 "field-1" 13194139534728 true] [17592186306037 1104 #edb/ref 17592186306038 13194139534728 true] [17592186306037 1110 #uuid "7c3da720-3b96-5a01-8766-ce0db151ea94" 13194139534728 true] [17592186306038 1034 "2" 13194139534728 true] [17592186306038 1103 #edb/ref 17592186045453 13194139534728 true] [17592186306038 1111 #uuid "3e9f10fb-c8e0-5a10-a793-82ffe8524e53" 13194139534728 true] [17592186306039 1000 #edb/ref 17592186306040 13194139534728 true] [17592186306039 1040 #edb/ref 17592186045449 13194139534728 true] [17592186306039 1041 "field-2" 13194139534728 true] [17592186306039 1104 #edb/ref 17592186306040 13194139534728 true] [17592186306039 1110 #uuid "58768405-967a-5370-a875-3dae9f9f2e54" 1319413953472