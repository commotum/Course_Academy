#{[{:db/id #edb/ref 17592186306018 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e4aa85c-345d-5869-9dcd-b2ef128dae3d" :knowledge-point/title "Solving Inequalities Involving Domain Restrictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0151c52f-3de7-57aa-adda-f5b3d761a348" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306020}] :answer-field/correct {:answer/id #uuid "0151c52f-3de7-57aa-adda-f5b3d761a348" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306020} :answer-field/id #uuid "8ee7c517-8d9d-57f6-acf6-52eb7d12e0fe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306019} {:answer-field/choices [{:answer/id #uuid "85a5d738-005b-5350-aaea-dc962ca19600" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186306022}] :answer-field/correct {:answer/id #uuid "85a5d738-005b-5350-aaea-dc962ca19600" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186306022} :answer-field/id #uuid "d57ee9b7-d8b4-56f1-8c09-6a9860eb0c5a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306021} {:answer-field/choices [{:answer/id #uuid "481367a3-d03f-5b03-a944-a3c17da28239" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186306024}] :answer-field/correct {:answer/id #uuid "481367a3-d03f-5b03-a944-a3c17da28239" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186306024} :answer-field/id #uuid "9d49b2b9-6d48-5486-85d5-8e35288c38a0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306023}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0069ac9d-3e88-5d11-ad24-7136a309bdfb" :question/math-academy-id "q-271201" :question/problem "Solve the inequality\n$\\frac{5-2x}{\\operatorname{ln}⁡({x}^{2}-3)}\\ge 0,\\,x>2.$\n\n{{field-1}}{{field-2}}\n$x\\le $\n{{field-3}}" :question/worked-solution "Since $x>2,$ we have that\n\n$$\n\\begin{aligned}x & >2 \\\\ {x}^{2} & >4 \\\\ {x}^{2}-3 & >1.\\end{aligned}\n$$\n\nThis means that $\\operatorname{ln}⁡({x}^{2}-3)$ is positive for all the values of $x$ that we are considering $(x>2).$ So, we can multiply both sides by $\\operatorname{ln}⁡({x}^{2}-3),$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{5-2x}{\\operatorname{ln}⁡({x}^{2}-3)} & \\ge 0 \\\\ (\\operatorname{ln}⁡({x}^{2}-3))\\cdot \\frac{5-2x}{\\operatorname{ln}⁡({x}^{2}-3)} & \\ge (\\operatorname{ln}⁡({x}^{2}-3))\\cdot 0 \\\\ 5-2x & \\ge 0 \\\\ -2x & \\ge -5 \\\\ x & \\le \\frac{5}{2}\\end{aligned}\n$$\n\nNote that we had to flip the sign again of the inequality since we divided by a negative number ($-2$).\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x>2$ and $x\\le \\frac{5}{2}.$ So, the solution to our inequality is $2<x\\le \\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186306025 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef29dc50-df8b-50b7-9533-c670e3c08347" :knowledge-point/title "Solving Inequalities Requiring Division by a Positive Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45b78a94-488e-5e52-b64a-df7d6096b0ed" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186306027} {:answer/id #uuid "7f465b5b-e566-5f53-8ae8-2877a76465b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186306028}] :answer-field/correct {:answer/id #uuid "7f465b5b-e566-5f53-8ae8-2877a76465b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186306028} :answer-field/id #uuid "6d482a9d-fd6d-5189-843f-a0c360457eaf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306026} {:answer-field/choices [{:answer/id #uuid "3c0e2911-ede0-5b6f-81d6-d7719e547121" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186306030}] :answer-field/correct {:answer/id #uuid "3c0e2911-ede0-5b6f-81d6-d7719e547121" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186306030} :answer-field/id #uuid "b91fe70b-cbde-52cb-8d7f-5854e39f3f31" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306029}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ff8d19fb-9958-559c-b38d-0e233103bf0e" :question/math-academy-id "q-328551" :question/problem "Solve the inequality\n$(|x-2|+3)(4x-1)\\le 0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Note that the factor $|x-2|+3$ is always positive for all real numbers $x.$\n\nSince $|x-2|+3$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{(|x-2|+3)(4x-1)}{|x-2|+3} & \\le \\frac{0}{\\,|x-2|+3\\,} \\\\ 4x-1 & \\le 0 \\\\ 4x & \\le 1 \\\\ x & \\le \\,\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306031 :knowledge-point/_questions [{:knowledge-point/id #uuid "96b438f1-77af-551c-8a45-52a93e5995a8" :knowledge-point/title "Solving Inequalities Requiring Multiplication or Division by a Negative Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d541574c-e024-5502-ab4d-518ad17f0e96" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186306033}] :answer-field/correct {:answer/id #uuid "d541574c-e024-5502-ab4d-518ad17f0e96" :answer/type {:db/ident :answer.type/math} :answer/value ">" :db/id #edb/ref 17592186306033} :answer-field/id #uuid "f4641678-049a-5e74-9dec-103137fb255d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306032} {:answer-field/choices [{:answer/id #uuid "1d3b65b6-061a-52d1-b809-4ed3b5426e43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186306035}] :answer-field/correct {:answer/id #uuid "1d3b65b6-061a-52d1-b809-4ed3b5426e43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186306035} :answer-field/id #uuid "1c04082e-0797-5a71-93d7-e776e38ab99d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306034}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9291a6f9-9744-5c97-8557-b7b59826bfe6" :question/math-academy-id "q-328558" :question/problem "Solve the inequality\n$(-4{x}^{2}-1)(3x-2)<0.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Since $-4{x}^{2}-1$ is always negative, we can divide both sides of the inequality by this quantity, but we have to remember to flip the sign of the inequality. By doing this, we get\n\n$$\n\\begin{aligned}(-4{x}^{2}-1)(3x-2) & <0 \\\\ \\frac{(-4{x}^{2}-1)(3x-2)}{-4{x}^{2}-1} & >\\frac{0}{-4{x}^{2}-1} \\\\ 3x-2 & >0 \\\\ x & >\\,\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306036 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e4aa85c-345d-5869-9dcd-b2ef128dae3d" :knowledge-point/title "Solving Inequalities Involving Domain Restrictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9f10fb-c8e0-5a10-a793-82ffe8524e53" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306038}] :answer-field/correct {:answer/id #uuid "3e9f10fb-c8e0-5a10-a793-82ffe8524e53" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306038} :answer-field/id #uuid "7c3da720-3b96-5a01-8766-ce0db151ea94" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306037} {:answer-field/choices [{:answer/id #uuid "7266c206-683e-5205-ad49-3a2526a6640b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186306040}] :answer-field/correct {:answer/id #uuid "7266c206-683e-5205-ad49-3a2526a6640b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le" :db/id #edb/ref 17592186306040} :answer-field/id #uuid "58768405-967a-5370-a875-3dae9f9f2e54" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306039} {:answer-field/choices [{:answer/id #uuid "5802a1f5-2991-57db-8887-aaf847e9b073" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186306042}] :answer-field/correct {:answer/id #uuid "5802a1f5-2991-57db-8887-aaf847e9b073" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186306042} :answer-field/id #uuid "429942f4-94aa-546f-b1b9-ccec9debf04c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306041}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e6f12aaa-b39f-53cc-afad-2e7fd99c317f" :question/math-academy-id "q-330599" :question/problem "Solve the inequality\n\n$$\n(\\sqrt{x+1}-3)(x-2)\\le 0,\\,x<8.\n$$\n\n{{field-1}}{{field-2}}\n$x<$\n{{field-3}}" :question/worked-solution "Since $x<8,$ we have that\n\n$$\n\\begin{aligned}x & <8 \\\\ x+1 & <9 \\\\ \\sqrt{x+1} & <3 \\\\ \\sqrt{x+1}-3 & <0.\\end{aligned}\n$$\n\nThis means that $\\sqrt{x+1}-3$ is negative for all the values of $x$ that we are considering $(x<8).$ So, we can divide both sides by $\\sqrt{x+1}-3,$ provided that we flip the sign of the inequality:\n\n$$\n\\begin{aligned}(\\sqrt{x+1}-3)(x-2) & \\le 0 \\\\ \\frac{(\\sqrt{x+1}-3)(x-2)}{\\sqrt{x+1}-3} & \\ge \\frac{0}{\\sqrt{x+1}-3} \\\\ x-2 & \\ge 0 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the solution to the inequality will be the numbers that satisfy both $x\\ge 2$ and $x<8.$ So, the solution to our inequality is\n\n$$\n\\begin{aligned}2\\le x<8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306043 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef29dc50-df8b-50b7-9533-c670e3c08347" :knowledge-point/title "Solving Inequalities Requiring Division by a Positive Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c361333-ccd0-56ba-9fdd-ddb2c589e2dc" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -1" :db/id #edb/ref 17592186306045} {:answer/id #uuid "f7e4bad9-eb83-5f87-af60-b2c313c160af" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 0" :db/id #edb/ref 17592186306046} {:answer/id #uuid "d0264f49-305e-5943-9c2c-6968ede3d2c8" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le \\frac{1}{2}" :db/id #edb/ref 17592186306047} {:answer/id #uuid "cfb9faa8-a2c7-5f67-b5de-e3bacdc9626f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186306048} {:answer/id #uuid "7ebb7e04-778f-57c9-9b06-36e24015273d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{3}{2}" :db/id #edb/ref 17592186306049}] :answer-field/correct {:answer/id #uuid "7ebb7e04-778f-57c9-9b06-36e24015273d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge \\frac{3}{2}" :db/id #edb/ref 17592186306049} :answer-field/id #uuid "203d097c-75b3-58af-8aa7-430c0bcd37ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306044}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c9167390-9fd0-59d5-a63c-a90ae412077f" :question/math-academy-id "q-89660" :question/problem "Solve the inequality\n\n$$\n({4}^{x}+{x}^{2})(2x-3)\\ge 0.\n$$" :question/worked-solution "Since ${4}^{x}+{x}^{2}$ is always positive, we can divide both sides of the inequality by this quantity. By doing this, we get\n\n$$\n\\begin{aligned}\\frac{({4}^{x}+{x}^{2})(2x-3)}{{4}^{x}+{x}^{2}} & \\ge \\frac{0}{{4}^{x}+{x}^{2}} \\\\ 2x-3 & \\ge 0 \\\\ 2x & \\ge 3 \\\\ x & \\ge \\frac{3}{2}.\\end{aligned}\n$$"}]}
