{2}}{6x+3}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{2{x}^{3}+{x}^{2}}{6x+3} & =\\frac{{x}^{2}(2x+1)}{3(2x+1)}=\\frac{{x}^{2}}{3}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-\\frac{1}{2}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979852/assets/7ca0a626369d11d7d3cd8e2d99cbfb79eb37c534b86a1df3f43aaeff5fb932e3.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-68151/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648"] :knowledge-point/questions ["q-68151"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107068/selection/cb1896197a67f182a612a87dbfdf77a8994e499a7df0036f929b0112dee816e0" :answer/id #uuid "ae870a6e-3fa5-5a61-9bb8-42d9d952ccbb" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "q-107068/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "b957a2dd-d89d-54fd-9fd9-8d48982962a7" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-107068/selection/47ec7057d25f129f7cf9d631f577fef9a3a63d4860d6439f01bc9438cf87aa73" :answer/id #uuid "454847af-3c11-5d46-95e0-39ff849fe44c" :answer/type :answer.type/math :answer/value "x=-4,0" :db/ensure [:answer/validate]} {:db/id "q-107068/selection/6e4d1b874a7adccba81dcdb0852e9aacd643dd1f4e6a6de2da131d3df44fa746" :answer/id #uuid "17bc5a6b-2555-5470-8d6c-b10ea6a7a4b3" :answer/type :answer.type/math :answer/value "x=0,2" :db/ensure [:answer/validate]} {:db/id "q-107068/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "dc146a87-85e8-5792-a760-ffc79dad269d" :answer/type