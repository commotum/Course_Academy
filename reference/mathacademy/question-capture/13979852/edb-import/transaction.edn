cd4e7da1ce42" :answer/id #uuid "5585a7ca-2dc5-5f58-87ba-bfd458b1c17c" :answer/type :answer.type/math :answer/value "x=\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-107074/selection/2f080de0ef65f6e5dd2806fa211066253fb2f37c1d406be458ab4efcf0eceed2" :answer/id #uuid "2c6214c7-c047-5571-918f-806e66367cbb" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-107074/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "10ed4443-3771-50f6-b284-f540a89ebaa6" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-107074/selection/34a90448fe55c75fb547fdd4c1a03702d531839c7375a5f2c3b41cb67f1a5db9" :answer/id #uuid "1b180fba-b286-597c-848a-ecd7a6c8bb1d" :answer/type :answer.type/text :answer/value "$x=-\\sqrt{2}$ and $x=\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-107074/selection/85ef1bde54771b7212e90f551ac4a3109cb6a6a2afb8bac03b7367c68dc36225" :answer/id #uuid "557ee11b-1196-5a8d-a454-92f0b8a444d5" :answer/type :answer.type/text :answer/value "$x=\\sqrt{3}$ and $x=\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "q-107074/selection" :answer-field/id #uuid "91349b59-7134-5667-a560-f319c0e88525" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107074/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer-field/choices ["q-107074/selection/3bf490a97b4b01d003a4d517d1cd8f80a0e11ffcaac2332bbdf3cd4e7da1ce42" "q-107074/selection/2f080de0ef65f6e5dd2806fa211066253fb2f37c1d406be458ab4efcf0eceed2" "q-107074/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" "q-107074/selection/34a90448fe55c75fb547fdd4c1a03702d531839c7375a5f2c3b41cb67f1a5db9" "q-107074/selection/85ef1bde54771b7212e90f551ac4a3109cb6a6a2afb8bac03b7367c68dc36225"] :db/ensure [:answer-field/validate]} {:db/id "q-107074" :question/id #uuid "248881bd-12e3-5bbe-9742-1e786c69f660" :question/math-academy-id "q-107074" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1} & =\\frac{(2{x}^{2}+1)-({x}^{2}+3)}{({x}^{2}+3)(2{x}^{2}+1)}=\\frac{{x}^{2}-2}{({x}^{2}+3)(2{x}^{2}+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n({x}^{2}+3)(2{x}^{2}+1)=0.\n$$\n\nThis equation has no real solutions, therefore $f(x)$ has no vertical asymptotes." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-107074/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-107074"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339779/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "cade2cb1-3a31-5320-a2d0-529fb4a4001c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-339779/field-1" :answer-field/id #uuid "fc87fae7-f9f2-599a-af68-66769c52ea50" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339779/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-339779/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-339779/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "64095e03-4823-54bd-846a-918e3528bd4d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-339779/field-2" :answer-field/id #uuid "5dbf238b-7e20-5377-9a4e-a28bf608f9ef" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339779/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-339779/field-2/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-339779/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ff913e87-db88-52f6-a3e6-4787bcef2876" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-339779/field-3" :answer-field/id #uuid "38415c84-a7e3-5f5b-9db2-87c7b7fe9325" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339779/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-339779/field-3/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-339779" :question/id #uuid "fedc34c5-d7a5-5801-9c83-0ce6f45aaef0" :question/math-academy-id "q-339779" :question/problem "From **left to right**, the vertical asymptotes of $f(x)=\\frac{x}{{x}^{2}-9}-\\frac{1}{x+5}$ are\n\n$x=$\n{{field-1}},\n$\\,$\n\n$x=$\n{{field-2}},\n$\\,$\n and $\\,x=$\n{{field-3}}." :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{x}{{x}^{2}-9}-\\frac{1}{x+5} & =\\frac{x(x+5)-({x}^{2}-9)}{({x}^{2}-9)(x+5)} \\\\  & =\\frac{{x}^{2}+5x-{x}^{2}+9}{({x}^{2}-9)(x+5)} \\\\  & =\\frac{5x+9}{({x}^{2}-9)(x+5)} \\\\  & =\\frac{5x+9}{(x-3)(x+3)(x+5)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-3)(x+3)(x+5)=0\\,⟹\\,x=-5\\,,\\,x=-3\\,,\\,\\text{and}\\,x=3.\n$$\n\nTherefore, from left to right, the vertical asymptotes are at $x=-5$,  $x=-3,$ and $x=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339779/field-1" "q-339779/field-2" "q-339779/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-339779"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339757/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "de50e952-8725-53a0-8b0d-f0bc581fe47d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-339757/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fe466a23-c6fe-5259-be76-7706806a4b6e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-339757/field-1" :answer-field/id #uuid "e3851eaa-4b73-5340-8c90-12d044fed340" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339757/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-339757/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-339757/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-339757" :question/id #uuid "37ba1c34-45da-5976-b370-8f8ed7d7f89d" :question/math-academy-id "q-339757" :question/problem "The vertical asymptote of $f(x)=\\frac{7}{4x+12}+\\frac{5}{x+3}$ is\n\n$x=$\n{{field-1}}." :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{7}{4x+12}+\\frac{5}{x+3} & =\\frac{7}{4(x+3)}+\\frac{5}{x+3} \\\\  & =\\frac{7+5(4)}{4(x+3)} \\\\  & =\\frac{27}{4(x+3)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n4(x+3)=0\\,⟹\\,x=-3.\n$$\n\nTherefore, the vertical asymptote is at $x=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339757/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-339757"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339763/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "c69b8c7d-78cb-50c6-a3f0-3c7b16369b0e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-339763/field-1" :answer-field/id #uuid "c062f8f2-f8e5-54ab-8ca9-047e3f359d3c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339763/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-339763/field-1/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-339763" :question/id #uuid "a2085814-78d7-55fd-bc67-38e63d4c9599" :question/math-academy-id "q-339763" :question/problem "The vertical asymptote of $f(x)=\\frac{9}{4x-3}-\\frac{3}{8x-6}$ is\n\n$x=$\n{{field-1}}." :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{9}{4x-3}-\\frac{3}{8x-6} & =\\frac{9}{4x-3}-\\frac{3}{2(4x-3)} \\\\  & =\\frac{9(2)-3}{2(4x-3)} \\\\  & =\\frac{15}{2(4x-3)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n2(4x-3)=0\\,⟹\\,x=\\frac{3}{4}.\n$$\n\nTherefore, the vertical asymptote is at $x=\\frac{3}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339763/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-339763"] :db/ensure [:knowledge-point/validate]} {:db/id "q-68177/selection/c8f9958e42e084134d97110cb7df5f315b1526645ac128ed6c70518f3f7a04c5" :answer/id #uuid "ead825aa-02ba-5e59-94e1-b75331cf84e6" :answer/type :answer.type/text :answer/value "$x=-7$ and $x=5$" :db/ensure [:answer/validate]} {:db/id "q-68177/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "f8a11b4b-21ea-5e95-856c-e75c56b18d00" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "q-68177/selection/afa131134e6dd0a87be44e57164644830376da4835d48ca94162ac4a5ea88bea" :answer/id #uuid "792fb9ce-b927-53a3-9466-2593121ec093" :answer/type :answer.type/math :answer/value "x=7" :db/ensure [:answer/validate]} {:db/id "q-68177/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "c8543c43-5dba-5168-86bd-b44902bb247d" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-68177/selection/0e698c3db5ebba81dcee33781e78049d815fcac6f7ac017f2cb79f7b09d5e960" :answer/id #uuid "280c662c-e7a0-5783-a106-4cb469cacfeb" :answer/type :answer.type/text :answer/value "$x=7$ and $x=-5$" :db/ensure [:answer/validate]} {:db/id "q-68177/selection" :answer-field/id #uuid "5483eb3c-d445-54c8-83c3-9f3530808bec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-68177/selection/0e698c3db5ebba81dcee33781e78049d815fcac6f7ac017f2cb79f7b09d5e960" :answer-field/choices ["q-68177/selection/c8f9958e42e084134d97110cb7df5f315b1526645ac128ed6c70518f3f7a04c5" "q-68177/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" "q-68177/selection/afa131134e6dd0a87be44e57164644830376da4835d48ca94162ac4a5ea88bea" "q-68177/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" "q-68177/selection/0e698c3db5ebba81dcee33781e78049d815fcac6f7ac017f2cb79f7b09d5e960"] :db/ensure [:answer-field/validate]} {:db/id "q-68177" :question/id #uuid "b0738580-739a-541e-96ef-d435fb22b7bf" :question/math-academy-id "q-68177" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-7}+\\frac{1}{x+5}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-7}+\\frac{1}{x+5} & =\\frac{x+5+x-7}{(x-7)(x+5)}=\\frac{2x-2}{(x-7)(x+5)}=\\frac{2(x-1)}{(x-7)(x+5)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-7)(x+5)=0\\,⟹\\,x=7\\,,\\,x=-5.\n$$\n\nTherefore, the vertical asymptotes are at $x=7$ and $x=-5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-68177/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-68177"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-84"] :question/problem "Find the vertical asymptotes of $y=f(x)=\\dfrac{1}{x^2-16}.$" :question/worked-solution "Let's simplify the expression by factoring the denominator. We get \n\n$$\n\\begin{aligned}y & =\\frac{1}{{x}^{2}-16} \\\\  & =\\frac{1}{({x}^{2}-{4}^{2})} \\\\  & =\\frac{1}{(x+4)(x-4)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator. So, we find the vertical asymptotes by setting the denominator equal to zero:\n\n$$\n(x+4)(x-4) = 0\\qquad \\Longrightarrow\\qquad x=\\pm 4.\n$$\n\nConsequently, both $x=4$ and $x=-4$ are vertical asymptotes of $y=f(x).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-85"] :question/problem "Find the vertical asymptotes of $y = \\dfrac{x^2+x-6}{x^2-5x+6}.$" :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+x-6}{{x}^{2}-5x+6} & =\\frac{(x-2)(x+3)}{(x-2)(x-3)} \\\\  & =\\frac{\\cancel{(x-2)}(x+3)}{\\cancel{(x-2)}(x-3)} \\\\  & =\\frac{x+3}{x-3}.\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\nx-3 = 0\\qquad \\Longrightarrow\\qquad x=3.\n$$\n\nSo the *only* vertical asymptote is at $x=3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-86"] :question/problem "Find the vertical asymptotes of $y=f(x)=\\dfrac{x^2+x}{2x+2}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}+x}{2x+2} & =\\frac{x(x+1)}{2(x+1)} \\\\  & =\\frac{x\\cancel{(x+1)}}{2\\cancel{(x+1)}} \\\\  & =\\frac{x}{2}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979852/assets/eda5457edafe14fb51fcc75ca75677b199bfc3e0aef8940c66f8aa78cf8cd5c3.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-87"] :question/problem "Find the vertical asymptotes of $y=\\dfrac{1}{x}+\\dfrac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x}+\\frac{1}{x+1} & =\\frac{(x+1)}{x(x+1)}+\\frac{x}{x(x+1)} \\\\  & =\\frac{x+1+x}{x(x+1)} \\\\  & =\\frac{2x+1}{x(x+1)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\nx(x+1) = 0\\qquad \\Longrightarrow\\qquad x=0,-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=0$ and $x=-1.$" :db/ensure [:question/validate]}]
