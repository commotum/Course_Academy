          "question": "e-87",
          "field": null,
          "attribute": "question/problem",
          "value": "Find the vertical asymptotes of $y=\\dfrac{1}{x}+\\dfrac{1}{x+1}.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979852/example-87.json",
