ea-867b1806ef8b" :question/math-academy-id "q-19778" :question/problem "Let $a=⟨2,3,0⟩$ and $b=⟨6,4,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & 3 & 0 \\\\ 6 & 4 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 \\\\ 4 & 0\\end{aligned}|i-|\\begin{aligned}2 & 0 \\\\ 6 & 0\\end{aligned}|j+|\\begin{aligned}2 & 3 \\\\ 6 & 4\\end{aligned}|k \\\\  & =(3\\cdot 0-4\\cdot 0)i-(2\\cdot 0-6\\cdot 0)j+(2\\cdot 4-6\\cdot 3)k \\\\  & =(0)i-(0)j+(8-18)k \\\\  & =⟨0,0,-10⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19778/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-19778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77429/selection/3571186a0e51eed63832bbacfc58887e53b6ba3c0169215e156ceec5db7d0a06" :answer/id #uuid "0da05a4e-aada-5e5e-b9f9-afb08c16cb15" :answer/type :answer.type/math :answer/value "x=-1,4" :db/ensure [:answer/validate]} {:db/id "q-77429/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "d4821e4b-99c7-517d-9746-c9b4d8276f92" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-77429/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" :answer/id #uuid "f3567fca-bf34-579f-8cfb-8b4963a5b388" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "q-77429/selection/5b073700a15034eef9d86418d2beb7a48945becaf327bea65b414b48e0abd8e1" :answer/id #uuid "33a02c3a-6275-5b8b-a31b-c325a3946f5b" :answer/type :answer.type/math :answer/value "x=\\pm 1" :db/ensure [:answer/validate]} {:db/id "q-77429/selection/145c255ad7254d325dd21b7760a9aa39978dc9797aa24c756460dd0d4ec02826" :answer/id #uuid "6330c1a6-6550-51da-87b2-2fdae01c9897" :answer/type :answer.type/math :answer/value "x=-1,\\,2" :db/ensure [:answer/validate]} {:db/id "q-77429/selection" :answer-field/id #uuid "e5b8d869-afc8-5fa7-86fa-be29fa526db1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77429/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" :answer-field/choices ["q-77429/selection/3571186a0e51eed63832bbacfc58887e53b6ba3c0169215e156ceec5db7d0a06" "q-77429/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-77429/selection/0bf5abed43f6f20dd466b36279de8736a04c540ff5306cb048ae22803a7b3f9c" "q-77429/selection/5b073700a15034eef9d86418d2beb7a48945becaf327bea65b414b48e0abd8e1" "q-77429/selection/145c255ad7254d325dd21b7760a9aa39978dc9797aa24c756460dd0d4ec02826"] :db/ensure [:answer-field/validate]} {:db/id "q-77429" :question/id #uuid "c51601a3-913a-5641-87db-8b769ff00fd4" :question/math-academy-id "q-77429" :question/problem "Let $a=⟨2,0,-4⟩,$ $b=⟨-1,1,2x⟩$ and $|\\,a\\times b\\,|=2\\sqrt{5}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & 0 & -4 \\\\ -1 & 1 & 2x\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -4 \\\\ 1 & 2x\\end{aligned}|i-|\\begin{aligned}2 & -4 \\\\ -1 & 2x\\end{aligned}|j+|\\begin{aligned}2 & 0 \\\\ -1 & 1\\end{aligned}|k \\\\  & =(0+4)i-(4x-4)j+(2-0)k \\\\  & =⟨4,-4x+4,2⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{4}^{2}+(-4x+4)^{2}+{2}^{2}} \\\\  & =\\sqrt{16+16{x}^{2}-32x+16+4} \\\\  & =\\sqrt{16{x}^{2}-32x+36}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =2\\sqrt{5} \\\\ \\sqrt{16{x}^{2}-32x+36} & =2\\sqrt{5} \\\\ 16{x}^{2}-32x+36 & =20 \\\\ 16{x}^{2}-32x+16 & =0 \\\\ 16({x}^{2}-2x+1) & =0 \\\\ {x}^{2}-2x+1 & =0 \\\\ (x-1)^{2} & =0 \\\\ x-1 & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77429/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-77429"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275278/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870" :answer/id #uuid "d252d4b7-e3c5-5d10-9db5-a5d9e5cb6dad" :answer/type :answer.type/math :answer/value "-\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-275278/field-1" :answer-field/id #uuid "3f3a7b00-5f09-5d81-a2a5-2ccfa69ab205" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275278/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870" :answer-field/choices ["q-275278/field-1/25a170deff842212ed37326913af9f79324c30fcf28877ae81d5293be7b7c870"] :db/ensure [:answer-field/validate]} {:db/id "q-275278/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "c1f2befa-d3d1-58cd-bc3a-f57d334232d6" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-275278/field-2" :answer-field/id #uuid "62a8bc02-f35b-590b-9bfc-3a1407aadaa8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275278/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer-field/choices ["q-275278/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59"] :db/ensure [:answer-field/validate]} {:db/id "q-275278" :question/id #uuid "30ae796d-1566-5269-8b62-e5bfe200dd1e" :question/math-academy-id "q-275278" :question/problem "Let $a=⟨-2x,3,5⟩,$ $b=⟨2x,0,1⟩$ and $|\\,a\\times b\\,|=\\sqrt{909}.$ Then, in **ascending order**,  the possible values of $x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -2x & 3 & 5 \\\\ 2x & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 5 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}-2x & 5 \\\\ 2x & 1\\end{aligned}|j+|\\begin{aligned}-2x & 3 \\\\ 2x & 0\\end{aligned}|k \\\\  & =(3-0)i-(-2x-10x)j+(0-6x)k \\\\  & =⟨3,12x,-6x⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(12x)^{2}+(-6x)^{2}} \\\\  & =\\sqrt{9+144{x}^{2}+36{x}^{2}} \\\\  & =\\sqrt{180{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{909} \\\\ \\sqrt{180{x}^{2}+9} & =\\sqrt{909} \\\\ 180{x}^{2}+9 & =909 \\\\ 180{x}^{2} & =900 \\\\ {x}^{2} & =5\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $x=-\\sqrt{5},$ $x=\\sqrt{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275278/field-1" "q-275278/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb"] :knowledge-point/questions ["q-275278"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278837/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "dd8c01d4-8934-5b76-aa4a-4ca92bfa443f" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-278837/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "74cff372-b8c3-53fb-b183-8ff31df124dd" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-278837/field-1" :answer-field/id #uuid "2c286aa4-8a01-520d-b539-32bf2e3d0e68" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278837/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-278837/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" "q-278837/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-278837/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "34e75cd0-00d7-58d1-8240-0e73393a4d77" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-278837/field-2" :answer-field/id #uuid "7d02d3b2-0241-5f4a-aa41-079c9caeef18" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278837/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-278837/field-2/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a"] :db/ensure [:answer-field/validate]} {:db/id "q-278837/field-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "f4cb1c1e-5707-59ce-a1b3-459664c5ccc8" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-278837/field-3" :answer-field/id #uuid "2fbb79f0-f6f9-5768-86ce-8f64358b8523" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278837/field-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-278837/field-3/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-278837" :question/id #uuid "72597bd0-6ea5-558c-a1f0-a81918f1fce2" :question/math-academy-id "q-278837" :question/problem "Let $a=5i+2j-3k$ and $b=-2i+j+4k.$ Find $a\\times b.$\n\n$a\\times b=$\n\n{{field-1}}$\\,i\\,-\\,$\n{{field-2}}$\\,j\\,+\\,$\n\n{{field-3}}$\\,k$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 5 & 2 & -3 \\\\ -2 & 1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -3 \\\\ 1 & 4\\end{aligned}|i-|\\begin{aligned}5 & -3 \\\\ -2 & 4\\end{aligned}|j+|\\begin{aligned}5 & 2 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(2\\cdot 4-(-3)\\cdot 1)i-(5\\cdot 4-(-3)\\cdot (-2))j+(5\\cdot 1-2\\cdot (-2))k \\\\  & =(8+3)i-(20-6)j+(5+4)k \\\\  & =11\\,i-14\\,j+9\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278837/field-1" "q-278837/field-2" "q-278837/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-278837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281976/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "c49667c9-549d-5eca-ab04-bcb04e8098bb" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-281976/field-1" :answer-field/id #uuid "3afcad27-b0d3-5f3d-9376-952d3aa55a31" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281976/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-281976/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-281976/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "97b9a6e1-276c-50e5-b37a-56f1bf439924" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-281976/field-2" :answer-field/id #uuid "6d5d9332-d37c-5abb-9a12-67092b826270" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281976/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-281976/field-2/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-281976/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "90562ddb-e9e1-582c-a118-ab6beec08d89" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-281976/field-3" :answer-field/id #uuid "c386f638-7d5d-5f52-a06c-235c458d2441" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281976/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-281976/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-281976" :question/id #uuid "e26b4095-5598-5260-95bb-7de041fee05e" :question/math-academy-id "q-281976" :question/problem "Let $u=⟨\\sqrt{3},2,0⟩$ and $v=⟨1,0,-1⟩.$ Find $u\\times v.$\n\n$u\\times v=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ \\sqrt{3} & 2 & 0 \\\\ 1 & 0 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}|i-|\\begin{aligned}\\sqrt{3} & 0 \\\\ 1 & -1\\end{aligned}|j+|\\begin{aligned}\\sqrt{3} & 2 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(2\\cdot -1-0\\cdot 0)i-(\\sqrt{3}\\cdot -1-0\\cdot 1)j+(\\sqrt{3}\\cdot 0-2\\cdot 1)k \\\\  & =-2i+\\sqrt{3}j-2k \\\\  & =⟨-2,\\sqrt{3},-2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-281976/field-1" "q-281976/field-2" "q-281976/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9"] :knowledge-point/questions ["q-281976"] :db/ensure [:knowledge-point/validate]}]
