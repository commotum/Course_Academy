ds ["q-113611/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25"] :knowledge-point/questions ["q-113611"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113616/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "ca1df091-464c-51e4-afd9-0ffabbda305a" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-113616/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "0aa57d41-4b78-5166-87b8-11c73865e4cb" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-113616/selection/f57108c65956383aeb6d71e60fb708ffaf0faf7bb73fab16fe9735f48e2555b1" :answer/id #uuid "7bc3b734-1d09-568b-9b4c-b4fbdf694a35" :answer/type :answer.type/math :answer/value "168" :db/ensure [:answer/validate]} {:db/id "q-113616/selection/70d6dcc1d7a3673f73733e5af9e1c602560d0fc847c7cd3d691b60b2426d2b60" :answer/id #uuid "86c5e524-39e5-5848-b3ae-9e5ac8eddae1" :answer/type :answer.type/math :answer/value "252" :db/ensure [:answer/validate]} {:db/id "q-113616/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" :answer/id #uuid "a220d89e-1598-58e8-8aa1-6d6769f8ec3d" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "q-113616/selection" :answer-field/id #uuid "5121ff2d-3823-561e-93ea-834dbb820f10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113616/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" :answer-field/choices ["q-113616/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-113616/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" "q-113616/selection/f57108c65956383aeb6d71e60fb708ffaf0faf7bb73fab16fe9735f48e2555b1" "q-113616/selection/70d6dcc1d7a3673f73733e5af9e1c602560d0fc847c7cd3d691b60b2426d2b60" "q-113616/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326"] :db/ensure [:answer-field/validate]} {:db/id "q-113616" :question/id #uuid "fde0c554-f2b9-5c83-8c68-1c6f5f52e0d1" :question/math-academy-id "q-113616" :question/problem "Determine the value of $(\\frac{9}{6}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=9$ and $r=6.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{9}{6}) & =\\frac{9!}{(9-6)!\\cdot 6!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6!}{3!\\cdot 6!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{6\\cdot \\cancel{6!}} \\\\  & =\\frac{9\\cdot 8\\cdot 7}{6} \\\\  & =84.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113616/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-113616"] :db/ensure [:knowledge-point/validate]}]
