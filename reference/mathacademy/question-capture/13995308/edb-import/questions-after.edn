#{[{:db/id #edb/ref 17592186284923 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763d5835-293a-5250-8926-2b2cc1867adc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{1})" :db/id #edb/ref 17592186284925} {:answer/id #uuid "5d7295d9-88a6-5c92-b040-301e940d7e7d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186284926} {:answer/id #uuid "6df17955-e07c-53ef-afc4-0f590455e790" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{3})" :db/id #edb/ref 17592186284927} {:answer/id #uuid "185ff776-3b36-511e-94a8-0c06caa92d38" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{3})" :db/id #edb/ref 17592186284928} {:answer/id #uuid "57a58c1e-7704-5fab-9054-2949065b61c1" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{1})" :db/id #edb/ref 17592186284929}] :answer-field/correct {:answer/id #uuid "763d5835-293a-5250-8926-2b2cc1867adc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{1})" :db/id #edb/ref 17592186284925} :answer-field/id #uuid "d746608f-d1c9-5f00-bebe-de6d08c926e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284924}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ca37ba0c-8a3a-5194-96ea-e828544c2875" :question/math-academy-id "q-113610" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{4}{2})=[]+(\\frac{3}{2})\n$$" :question/worked-solution "To find $(\\frac{4}{2}),$ we need to find the number that is located in row $4$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{4}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{4}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{4}{2})=(\\frac{3}{1})+(\\frac{3}{2})\n$$\n\nTherefore, the missing expression is $(\\frac{3}{1}).$"}] [{:db/id #edb/ref 17592186284930 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a60b26b4-2dcd-5dce-81a2-1047b9efc575" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{6}{5})" :db/id #edb/ref 17592186284932} {:answer/id #uuid "9420d7d7-995a-5587-9424-690adfd4a6ad" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{5})" :db/id #edb/ref 17592186284933} {:answer/id #uuid "a56d991f-fb6d-54a8-b60f-390d11048dcc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186284934} {:answer/id #uuid "d975a7a0-24e7-5766-b197-2f78d8922a33" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{3})" :db/id #edb/ref 17592186284935} {:answer/id #uuid "aa62cb21-c956-5b7b-9c04-2b9d5151c317" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{4})" :db/id #edb/ref 17592186284936}] :answer-field/correct {:answer/id #uuid "a56d991f-fb6d-54a8-b60f-390d11048dcc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186284934} :answer-field/id #uuid "d81e81b6-bc5a-5c7d-8841-255628cd8730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284931}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "63ddcdea-2d07-57cf-ba4a-405233b96f6b" :question/math-academy-id "q-113611" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{6}{4})=[]+(\\frac{5}{4})\n$$" :question/worked-solution "To find $(\\frac{6}{4}),$ we need to find the number that is located in row $6$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{6}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & (\\frac{6}{0}) &  & (\\frac{6}{1}) &  & (\\frac{6}{2}) &  & (\\frac{6}{3}) &  & (\\frac{6}{4}) &  & (\\frac{6}{5}) &  & (\\frac{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{6}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{6}{4})=(\\frac{5}{3})+(\\frac{5}{4})\n$$\n\nTherefore, the missing expression is $(\\frac{5}{3}).$"}] [{:db/id #edb/ref 17592186284937 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86c5e524-39e5-5848-b3ae-9e5ac8eddae1" :answer/type {:db/ident :answer.type/math} :answer/value "252" :db/id #edb/ref 17592186284939} {:answer/id #uuid "a220d89e-1598-58e8-8aa1-6d6769f8ec3d" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186284940} {:answer/id #uuid "0aa57d41-4b78-5166-87b8-11c73865e4cb" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186284941} {:answer/id #uuid "ca1df091-464c-51e4-afd9-0ffabbda305a" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186284942} {:answer/id #uuid "7bc3b734-1d09-568b-9b4c-b4fbdf694a35" :answer/type {:db/ident :answer.type/math} :answer/value "168" :db/id #edb/ref 17592186284943}] :answer-field/correct {:answer/id #uuid "a220d89e-1598-58e8-8aa1-6d6769f8ec3d" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186284940} :answer-field/id #uuid "5121ff2d-3823-561e-93ea-834dbb820f10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284938}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fde0c554-f2b9-5c83-8c68-1c6f5f52e0d1" :question/math-academy-id "q-113616" :question/problem "Determine the value of $(\\frac{9}{6}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=9$ and $r=6.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{9}{6}) & =\\frac{9!}{(9-6)!\\cdot 6!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6!}{3!\\cdot 6!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{6\\cdot \\cancel{6!}} \\\\  & =\\frac{9\\cdot 8\\cdot 7}{6} \\\\  & =84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284944 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4b2b9a-21e3-5eca-9bdb-a04773854332" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{1})" :db/id #edb/ref 17592186284946} {:answer/id #uuid "e4553e9a-3c36-5925-a3b3-4687d1ef182e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186284947} {:answer/id #uuid "273a2cb7-4d89-588f-a0aa-329519769948" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{1})" :db/id #edb/ref 17592186284948} {:answer/id #uuid "f3e7bc35-a5c9-5c34-97ae-2ce3489818e5" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{2})" :db/id #edb/ref 17592186284949} {:answer/id #uuid "2734df18-9c97-5904-b750-efe2cfc0de18" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{4})" :db/id #edb/ref 17592186284950}] :answer-field/correct {:answer/id #uuid "2734df18-9c97-5904-b750-efe2cfc0de18" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{4})" :db/id #edb/ref 17592186284950} :answer-field/id #uuid "06aa1e92-5436-5e16-a30f-554c05f97d42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284945}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8065c595-2459-5ec7-a994-35d5484d61c7" :question/math-academy-id "q-69727" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{5}{4})=(\\frac{4}{3})+[]\n$$" :question/worked-solution "To find $(\\frac{5}{4}),$ we need to find the number that is located in row $5$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{5}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{5}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{5}{4})=(\\frac{4}{3})+(\\frac{4}{4})\n$$\n\nTherefore, the missing expression is $(\\frac{4}{4}).$"}] [{:db/id #edb/ref 17592186284951 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5dd0728-2cda-54b7-bf15-9ebac07ed698" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186284953} {:answer/id #uuid "ec2b6703-84d3-528c-8ad3-3a8dd69a44fc" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186284954} {:answer/id #uuid "e03578b6-dc69-5311-9aec-dfb0cc870029" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186284955} {:answer/id #uuid "ffac70b7-9f1d-51aa-aea3-27647526aa5b" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186284956} {:answer/id #uuid "52ee241a-fbec-5f9f-939c-dc21caea0f71" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186284957}] :answer-field/correct {:answer/id #uuid "52ee241a-fbec-5f9f-939c-dc21caea0f71" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186284957} :answer-field/id #uuid "1c0bc7ce-f4e8-5b8f-8400-10dac4f6d174" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284952}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e84202b0-9543-596a-a3aa-3519e01fe1ef" :question/math-academy-id "q-70313" :question/problem "Determine the value of $(\\frac{7}{4}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=4.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{4}) & =\\frac{7!}{(7-4)!\\cdot 4!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4!}{3!\\cdot 4!} \\\\  & =\\frac{7\\cdot \\cancel{6}\\cdot 5\\cdot \\cancel{4!}}{\\cancel{6}\\cdot \\cancel{4!}} \\\\  & =7\\cdot 5 \\\\  & =35.\\end{aligned}\n$$"}]}
