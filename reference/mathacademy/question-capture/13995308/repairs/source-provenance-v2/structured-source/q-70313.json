      "part": "problem",
      "original_record": "before",
      "value": "Determine the value of $(\\genfrac{}{}{0pt}{}{7}{4}).$",
      "original_html_sha256": "bd9fe45008c8c4b73f7db74033e6567fd30c3147eb419134e4ccbcfeccff7535",
      "extractor_sha256": "af03036879151d6bc1d8a980c3dbf01d042d978e39d96a25bdfe63cd50ef1a10",
