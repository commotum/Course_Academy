a1aba86b0a" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186263782} {:answer/id #uuid "bfce263f-c593-55a5-8a79-4ff443a99709" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186263783}] :answer-field/correct {:answer/id #uuid "8aa751b5-76f2-5495-a30c-c21b2fb6bddf" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186263779} :answer-field/id #uuid "9abb07c3-e224-59a4-b0c8-810b669a7cce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186263778}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8b30b956-8f97-5e5a-bc88-28b6d6148226" :question/math-academy-id "q-125549" :question/problem "Which of the following is a $2\\times 2$ matrix?\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 3 & 3\\end{aligned}],\\,Q=[\\begin{aligned}4 & -2 \\\\ 0 & 0 \\\\ 1 & 3 \\\\ 0 & 5\\end{aligned}],\\,R=[\\begin{aligned}4 & -2 \\\\ -1 & -2\\end{aligned}]\n$$" :question/worked-solution "- The matrix $P$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\n- The matrix $Q$ has $4$ rows and $2$ columns. So, its dimensions are $4\\times 2.$ $\\,\\times $\n\n- The matrix $R$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\nTherefore, only $P$ and $R$ are $2\\times 2$ matrices."}] [{:db/id #edb/ref 17592186263784 :knowledge-point/_questions [{:knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29cbe56a-3fb1-52f1-95da-68a9885d0831" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186263786} {:answer/id #uuid "cffa7924-cd20-5ecb-b325-958375713997" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 1759218