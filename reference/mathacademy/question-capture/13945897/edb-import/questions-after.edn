-5b22-964a-cee3dc52ba57" :answer/type {:db/ident :answer.type/math} :answer/value "40.5" :db/id #edb/ref 17592186252403} :answer-field/id #uuid "fc9885c7-e2bb-5682-abfa-490a68891174" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252398}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b85f6d16-d96a-5f5a-a100-fa71b2cbca9f" :question/math-academy-id "q-87854" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/7ab7df3df1802d469239de4d3fd7ae7660fc449f807290c0e65a6db7d565d233.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C={45}^{∘}$ and $AB=BC,$ we have an isosceles right triangle. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/218d08d1f46e608c5fb7d1c2f5ddd136e601e15514dc829c686b35ff42b15a8f.png)\n\nTherefore, the area of the triangle is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {9}^{2} \\\\  & =\\frac{1}{2}\\cdot 81 \\\\  & =40.5\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252404 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3e51a41-4c4b-5a61-8974-45791a1e48e7" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,{cm}^{2}" :db/id #edb/ref 17592186252406} {:answer/id #uuid "a39e8353-ca43-58a3-8e15-e04448246e00" :answer/type {:db/ident :answer.type/math} :answer/value "30\\,{cm}^{2}" :db/id #edb/ref 17592186252407} {:answer/id #uuid "833ad2c3-b958-5715-a32d-a4caedf050a8" :answer/type {:db/ident :answer.type/math} :answer/value "72\\,{cm}^{2}" :db/id #edb/ref 17592186252408} {:answer/id #uuid "c2e312d6-48e3-5a41-b6f3-b42015d91870" :answer/type {:db/ident :answer.type/math} :answer/value "35\\,{cm}^{2}" :db/id #edb/ref 17592186252409} {:answer/id #uuid "e8eed322-8133-59f7-833c-410cadaadd39" :answer/type {:db/ident :answer.type/math} :answer/value "60\\,{cm}^{2}" :db/id #edb/ref 17592186252410}] :answer-field/correct {:answer/id #uuid "a39e8353-ca43-58a3-8e15-e04448246e00" :answer/type {:db/ident :answer.type/math} :answer/value "30\\,{cm}^{2}" :db/id #edb/ref 17592186252407} :answer-field/id #uuid "9fc57dbe-2506-5f5a-afd9-7b4d15714555" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252405}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7bcc27a5-b987-5302-94f2-988d56293740" :question/math-academy-id "q-87910" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/4c19425664f79df1f46863f59268ebd27e20defce41b21e877926bbcadc9e5c3.png)\n\nConsider the triangles $△ABC$ and $△CDE$ shown above. If the area of $△CDE$ is $42{\\text{ cm}}^{2}$, find the area of $△ABC.$\n\n(Figure not drawn to scale)" :question/worked-solution "Let's consider $△CDE.$ We can see that $\\overset{―}{CD}$ is the height corresponding to the base $\\overset{―}{DE}$ and that $DE=7\\text{ cm}.$ \n\nSince the area of $△CDE$ is $42{\\text{ cm}}^{2},$ we get\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 42 & =\\frac{7\\cdot CD}{2} \\\\ 7CD & =84 \\\\ CD & =12\\text{ cm}.\\end{aligned}\n$$\n\nNow, notice that $\\overset{―}{CD}$ is also the height of $△ABC$ corresponding to the base $\\overset{―}{AB}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/0014faf05eaf15d70f885802e5b820b0c72d42a96f400442f827ed229de8b240.png)\n\nTherefore, we find the area of $△ABC$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{AB\\cdot CD}{2} \\\\  & =\\frac{5\\cdot 12}{2} \\\\  & =30{\\text{ cm}}^{2}\\end{aligned}\n$$"}]}
